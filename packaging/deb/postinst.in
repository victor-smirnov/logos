#!/bin/sh
# logosc-@LOGOS_VERSION_SLOT@ — register the unversioned /usr/bin/logosc selector.
# update-alternatives lets multiple slot-packages (logosc-0.1-pre, logosc-0.2, …)
# coexist; the highest-priority installed slot becomes the default `logosc`.
set -e
if [ "$1" = "configure" ]; then
    update-alternatives --install /usr/bin/logosc logosc \
        /usr/bin/logosc-@LOGOS_VERSION_SLOT@ @LOGOS_ALT_PRIORITY@
fi
#DEBHELPER#
exit 0
