#!/bin/sh
# logosc-@LOGOS_VERSION_SLOT@ — register the unversioned /usr/bin/logosc selector.
# update-alternatives lets multiple slot-packages (logosc-0.1-pre, logosc-0.2, …)
# coexist; the highest-priority installed slot becomes the default `logosc`.
# logos-gdb is a SLAVE of logosc: it tracks the same slot (so `logos-gdb` always
# matches the selected `logosc`) and is removed automatically with the master.
set -e
if [ "$1" = "configure" ]; then
    update-alternatives --install /usr/bin/logosc logosc \
        /usr/bin/logosc-@LOGOS_VERSION_SLOT@ @LOGOS_ALT_PRIORITY@ \
        --slave /usr/bin/logos-gdb logos-gdb \
        /usr/bin/logos-gdb-@LOGOS_VERSION_SLOT@ \
        --slave /usr/bin/lforge lforge \
        /usr/bin/lforge-@LOGOS_VERSION_SLOT@
fi
#DEBHELPER#
exit 0
