  "container_types": [
    {
      "name": "TinyObjectMap",
      "formal_type": "Map<UTinyInt, Object>",
      "type_hash": 98,
      "descriptor": 2,
      "arena_tag_size": 2,
      "description": "Bitmap-indexed sparse map with uint8_t keys (0-51) and ERelativePtr values. 16-byte overhead. O(1) PopCnt-based lookup.",
      "arena_layout": {
        "fields": [
          { "name": "header_", "type": "uint64_t", "offset": 0, "size": 8 },
          { "name": "data_",   "type": "RelativePtr<ERelativePtr[]>", "offset": 8, "size": 8 }
        ],
        "total_size": 16,
        "alignment": 8
      },
      "header_layout": {
        "key_bitmap":  { "bits": "0:51",  "description": "Presence bitmap: bit K set means key K is present. Max 52 keys." },
        "capacity":    { "bits": "52:57", "description": "6 bits. Current allocated capacity of value array." },
        "size":        { "bits": "58:63", "description": "6 bits. Current number of entries." }
      },
      "key_range": { "min": 0, "max": 51 },
      "value_type": "EmbeddingRelativePtr (8 bytes each)",
      "lookup": "pos = PopCnt(header & ((1 << key) - 1)); return data[pos];"
    },
    {
      "name": "ObjectArray",
      "formal_type": "Array<Object> / Vector<ERelativePtr>",
      "type_hash": 100,
      "descriptor": 1,
      "arena_tag_size": 2,
      "description": "Dynamic array of heterogeneous objects. Two physical representations.",
      "vector_layout": {
        "description": "Separate data buffer (Vector<ERelativePtr>). Used for growable arrays.",
        "fields": [
          { "name": "size_",     "type": "uint64_t", "offset": 0,  "size": 8 },
          { "name": "capacity_", "type": "uint64_t", "offset": 8,  "size": 8 },
          { "name": "data_",     "type": "RelativePtr<ERelativePtr[]>", "offset": 16, "size": 8 }
        ],
        "total_size": 24,
        "alignment": 8
      },
      "array_layout": {
        "description": "Inline storage (Array<ERelativePtr>). Flexible array member. Fixed after allocation.",
        "fields": [
          { "name": "size_",     "type": "uint64_t", "offset": 0,  "size": 8 },
          { "name": "capacity_", "type": "uint64_t", "offset": 8,  "size": 8 },
          { "name": "array_[N]", "type": "ERelativePtr[capacity]", "offset": 16, "size": "capacity * 8" }
        ],
        "total_size": "16 + capacity * 8",
        "alignment": 8
      },
      "element_type": "EmbeddingRelativePtr (8 bytes each)"
    },
    {
      "name": "ObjectMap",
      "formal_type": "Map<Varchar, Object>",
      "type_hash": 101,
      "descriptor": 2,
      "arena_tag_size": 2,
      "description": "String-keyed hash map. Keys are RelativePtr<ArenaString>, values are ERelativePtr.",
      "arena_layout": {
        "fields": [
          { "name": "size_",              "type": "uint64_t", "offset": 0,  "size": 8 },
          { "name": "buckets_capacity_",  "type": "uint64_t", "offset": 8,  "size": 8, "description": "log2 of bucket array size" },
          { "name": "buckets_",           "type": "RelativePtr<BucketRelPtr[]>", "offset": 16, "size": 8 }
        ],
        "total_size": 24,
        "alignment": 8
      },
      "bucket_layout": {
        "description": "Each bucket is an untagged arena object.",
        "fields": [
          { "name": "size",     "type": "uint32_t", "offset": 0, "size": 4 },
          { "name": "capacity", "type": "uint32_t", "offset": 4, "size": 4 },
          { "name": "keys[]",   "type": "RelativePtr<ArenaString>[capacity]", "offset": 8, "size": "capacity * 8, padded to value alignment" },
          { "name": "values[]", "type": "ERelativePtr[capacity]", "offset": "8 + padded_keys_size" }
        ]
      },
      "hash_function": "FNV-1a (64-bit)",
      "bucket_index": "hash & ((1 << buckets_capacity_) - 1)"
    },
    {
      "name": "TypedArray<Integer>",
      "formal_type": "Array<Integer>",
      "type_hash": 105,
      "descriptor": 1,
      "arena_tag_size": 2,
      "description": "Homogeneous array of Integer (int32_t) values.",
      "note": "Other typed arrays use computed hash: HashHelper<105, TypeHashV<T>>."
    }
  ],

  "type_identity": {
    "description": "Types are identified by two mechanisms: ShortTypeCode (arena tags, fast dispatch) and UID256 (full SHA-256 hash of normalized C++ type signature, for type registry and cross-implementation identity).",
    "short_type_code": "Used for arena object tags and runtime dispatch. Compact (1-8 bytes).",
    "uid256": "SHA-256 of normalized C++ type declaration string. Used in TypeReflection registry for global type identity.",
    "composite_hash": "For parameterized types, TypeHash is computed via MD5 of the type hash list: HashHelper<base_hash, param_hash_1, ...>."
  },

  "string_constants": {
    "text_format": {
      "raw_string_delimiter": "'",
      "quoted_string_delimiter": "\"",
      "escape_sequences": ["\\b", "\\f", "\\r", "\\n", "\\t", "\\\"", "\\\\"],
      "raw_string_escape": "\\'",
      "integer_suffixes": {
        "_u8": "UTinyInt", "_u16": "USmallInt", "_u32": "UInteger", "u": "UInteger",
        "_u64": "UBigInt", "ull": "UBigInt", "ul": "UBigInt",
        "_s8": "TinyInt", "_s16": "SmallInt", "_s32": "Integer",
        "_s64": "BigInt", "ll": "BigInt"
      },
      "float_suffixes": {
        "f": "Real (float32)",
        "d": "Double (float64)"
      },
      "null_literal": "null",
      "true_literal": "true",
      "false_literal": "false"
    }
  }
}
