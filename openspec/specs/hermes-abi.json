{
  "$schema": "hermes-abi-v1",
  "version": "1.0.0",
  "byte_order": "little-endian",
  "description": "Machine-readable specification of Hermes data types, their binary layout, type codes, and encoding properties. This is the authoritative reference for all Hermes implementations.",

  "encoding_conventions": {

    "short_type_code": {
      "description": "Variable-length type tag stored BEFORE each arena-allocated object. 1-8 bytes.",
      "representation": "uint64_t",
      "fields": {
        "code_len":   { "bits": "0:2",  "description": "Number of additional bytes beyond the first (0-7). full_code_len = code_len + 1." },
        "descriptor": { "bits": "3:7",  "description": "5-bit type-specific flags (e.g., HERMES_OBJECT_ARRAY=1, HERMES_OBJECT_MAP=2)." },
        "type_code":  { "bits": "8:63", "description": "56-bit type hash. For core types, this is a small integer assigned statically." }
      },
      "encoding_note": "Written byte-by-byte BACKWARDS from the object's start address: *(base - c - 1) = val >> (c * 8) for c in [0, full_code_len). Read by inspecting the byte immediately before the object: len = byte & 0x07, then read len+1 bytes total.",
      "null_value": "code_len == 0 AND all other bits zero (full uint64_t == 0)."
    },

    "relative_ptr": {
      "description": "8-byte relative pointer. Stores int64_t offset from the pointer's own address.",
      "size": 8,
      "alignment": 8,
      "null_value": "offset == 0",
      "dereference": "ptr = (uint8_t*)&this + offset"
    },

    "embedding_relative_ptr": {
      "description": "8-byte tagged union: either a relative pointer OR an embedded small value. Used as the value type in ObjectArray and TinyObjectMap.",
      "size": 8,
      "alignment": 8,
      "discriminant": {
        "location": "buffer[7] & 0x01",
        "pointer_mode": 0,
        "value_mode": 1
      },
      "pointer_mode": {
        "description": "56-bit signed relative offset, byte-rotated for storage.",
        "encode": "stored = ((uint64_t)offset >> 8) | ((uint64_t)offset << 56)",
        "decode": "tag = stored >> 56; offset = (int64_t)((stored << 8) | tag)",
        "constraint": "Offset must be even (guaranteed by alignment >= 2), ensuring buffer[7] bit 0 is 0 in pointer mode."
      },
      "value_mode": {
        "description": "Up to 7 bytes of inline data + 1-byte tag.",
        "layout": {
          "buffer[0..6]": "Value data (little-endian, up to 7 bytes, zero-padded)",
          "buffer[7]": "(type_hash << 1) | 0x01"
        },
        "tag_extraction": "buffer[7] >> 1",
        "max_value_size": 7,
        "embeddability_rule": "A DataType DT is embeddable iff: isFixedSize AND sizeof(ViewType) < 8 AND TypeHash < 128"
      }
    },

    "vlen_u64_56": {
      "description": "Variable-length encoding for unsigned integers up to 56 bits. Used for string lengths.",
      "encoding": [
        { "range": "0..248",            "bytes": 1, "format": "value stored directly as single byte" },
        { "range": "249..0xFF",         "bytes": 2, "format": "first byte = 249, second byte = value & 0xFF" },
        { "range": "0x100..0xFFFF",     "bytes": 3, "format": "first byte = 250, next 2 bytes = value (little-endian)" },
        { "range": "0x10000..0xFFFFFF", "bytes": 4, "format": "first byte = 251, next 3 bytes = value (LE)" },
        { "range": "up to 56-bit",      "bytes": "2..8", "format": "first byte = 248 + N (N = 1..7 data bytes), next N bytes = value (LE)" }
      ],
      "decoding": "if first_byte < 249: value = first_byte. else: N = first_byte - 248, read N bytes little-endian."
    }
  },

  "arena_layout": {
    "allocation_types": {
      "GROWABLE_SINGLE_CHUNK": "Single contiguous buffer, doubled on overflow. Used for immutable/compacted documents.",
      "MULTI_CHUNK": "Multiple chunks, new chunk allocated when current is full. Default chunk size 4096. Used for mutable documents."
    },
    "document_header": {
      "description": "Untagged structure at the beginning of the first arena chunk (offset 0).",
      "fields": [
        { "name": "root", "type": "RelativePtr<void>", "size": 8, "description": "Relative pointer to the root object of the document." }
      ],
      "total_size": 8
    },
    "object_allocation": {
      "description": "Objects are bump-allocated with alignment. Type tag occupies bytes BEFORE the object address.",
      "procedure": [
        "1. Compute required tag_size = ShortTypeCode::full_code_len() for the type.",
        "2. Find next address 'addr' aligned to max(alignof(T), 2).",
        "3. Ensure at least tag_size bytes of gap between previous allocation end and 'addr'.",
        "4. Write tag bytes backwards from 'addr'.",
        "5. Construct object at 'addr' via placement new."
      ],
      "minimum_alignment": 2,
      "note": "Alignment gaps absorb tag bytes at zero extra cost for small tags."
    }
  },

