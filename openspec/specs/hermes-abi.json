  "compound_types": [
    {
      "name": "Hermes",
      "type_hash": 98,
      "descriptor": 0,
      "arena_tag_size": 2,
      "description": "Hermes document type. Used when a Hermes container is stored as a value inside Memoria containers (B+Trees). Not arena-allocated as a standalone arena object.",
      "view_type": "HermesCtrView",
      "role": "container-level datatype identifier"
    },
    {
      "name": "Object",
      "type_hash": 99,
      "descriptor": 0,
      "arena_tag_size": 2,
      "description": "Universal tagged value. A polymorphic wrapper resolved at runtime via type tag.",
      "role": "abstract type marker, not directly arena-allocated"
    },
    {
      "name": "Datatype",
      "type_hash": 102,
      "descriptor": 0,
      "arena_tag_size": 2,
      "description": "Type declaration: name + optional type parameters + optional constructor + CxxTypeExtras.",
      "arena_layout": {
        "fields": [
          { "name": "name",   "type": "RelativePtr<ArenaString>",     "offset": 0,  "size": 8 },
          { "name": "params", "type": "RelativePtr<ObjectArrayData>", "offset": 8,  "size": 8, "nullable": true },
          { "name": "ctr",    "type": "RelativePtr<ObjectArrayData>", "offset": 16, "size": 8, "nullable": true },
          { "name": "extras", "type": "CxxTypeExtras",                "offset": 24, "size": 4 }
        ],
        "total_size": 32,
        "alignment": 8
      }
    },
    {
      "name": "TypedValue",
      "type_hash": 103,
      "descriptor": 0,
      "arena_tag_size": 2,
      "description": "A value paired with its Datatype declaration.",
      "arena_layout": {
        "fields": [
          { "name": "datatype",    "type": "RelativePtr<DatatypeData>", "offset": 0, "size": 8 },
          { "name": "constructor", "type": "EmbeddingRelativePtr",      "offset": 8, "size": 8 }
        ],
        "total_size": 16,
        "alignment": 8
      }
    },
    {
      "name": "Parameter",
      "type_hash": 104,
      "descriptor": 0,
