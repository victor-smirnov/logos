package pat_7;

// ── helper types ────────────────────────────────────────────────────────────

struct Pt { x: i64, y: i64 }

// move-only struct (no Copy) — used to observe move-by-binding semantics
struct Owned { v: i64 }

enum Color { Red, Green, Blue }
enum Opt { None, Some(i64) }
enum Shape { Circle(i64), Rect { w: i64, h: i64 } }

// uninhabited (zero-variant) enum
enum Void {}

// helper re-matching a sub-slice bound by `xs @ ..`
fn slice_len(xs: &[i64]) -> i64 { return xs.len(); }

// f over an uninhabited scrutinee: a bare `match v {}` is exhaustive.
fn never_match(v: Void) -> i64 { match v {} }

fn main() -> i64 {

    // @rule pat.bind.or-alts-same-bindings
    // Every alternative of an or-pattern binds the same name set; the binding
    // `k` is usable in the arm body regardless of which alternative matched.
    {
        let s: Shape = Shape::Rect { w: 5i64, h: 6i64 };
        let got: i64 = match s {
            Shape::Circle(k) | Shape::Rect { w: k, h: _ } => k,
        };
        if got != 5i64 { return 1; }
        let s2: Shape = Shape::Circle(8i64);
        let got2: i64 = match s2 {
            Shape::Circle(k) | Shape::Rect { w: k, h: _ } => k,
        };
        if got2 != 8i64 { return 2; }
    }

    // pat.bind.ref-pat-strips-ref — see "untestable" report. The *binding* form
    // `&x` of a reference pattern over a `&T` scrutinee is miscompiled at codegen
    // (same defect noted in pat_3 for `pat.bind.ref-pat-transparent`): it
    // compiles but loads the wrong value at runtime. The literal-compare form
    // `&<scalar>` and the redundant-&-peel-over-enum form lower correctly and are
    // locked by pat.match.scrutinee-ref-peeled below (and in pat_1/pat_3).
    // Omitted to keep the file green; a faithful assertion would fail at runtime.

    // @rule pat.bind.slice-rest-is-subslice
    // prefix/suffix bind element type T; a named rest `xs @ ..` binds the
    // sub-slice as `&[T]` (usable via .len()); an anonymous `..` binds nothing.
    {
        let arr: [i64; 5] = [1i64, 2i64, 3i64, 4i64, 5i64];
        let s: &[i64] = &arr[..];
        match s {
            [head, mid @ .., tail] => {
                if *head != 1i64 { return 4; }           // prefix elem (T)
                if *tail != 5i64 { return 5; }           // suffix elem (T)
                if slice_len(mid) != 3i64 { return 6; }  // rest is &[T], len 3
            }
        }
        // anonymous rest binds nothing
        let got: i64 = match s {
            [first, ..] => *first,
        };
        if got != 1i64 { return 7; }
    }

    // @rule pat.bind.mut-binding-mode
    // a name binding written `mut` declares the bound variable mutable.
    {
        let got: i64 = match 10i64 {
            mut m => { m = m + 5i64; m },   // m is mutable; reassign in arm
        };
        if got != 15i64 { return 8; }
    }

    // @rule pat.match.uninhabited-trivially-exhaustive
    // a match on an uninhabited (zero-variant) enum needs no arms; `never_match`
    // (bare `match v {}`) type-checks. We can never call it (no Void value), so
    // assert the surrounding program compiled & runs.
    {
        // The mere existence of `never_match` above (bare `match v {}`) proves
        // the rule: the program would not compile if `match v {}` over the
        // uninhabited `Void` were rejected. Reaching here means it was accepted.
        let ok: bool = true;
        if !ok { return 9; }
    }

    // @rule pat.match.wildcard-covers
    // an unguarded `_` makes the match exhaustive without listing every variant.
    {
        let c: Color = Color::Blue;
        let got: i64 = match c {
            Color::Red => 1i64,
            _ => 9i64,              // covers Green and Blue -> exhaustive
        };
        if got != 9i64 { return 10; }
    }

    // @rule pat.match.guarded-arm-not-counted
    // a guarded variant arm does not count toward coverage; a following
    // unguarded arm for the same variant is reachable when the guard fails.
    {
        let o: Opt = Opt::Some(4i64);
        let got: i64 = match o {
            Opt::Some(v) if v > 10i64 => 1i64,  // guard false -> arm skipped
            Opt::Some(v)              => v + 1i64, // unguarded arm covers Some
            Opt::None                 => 0i64,
        };
        if got != 5i64 { return 11; }
    }

    // @rule pat.match.enum-variant-coverage
    // listing every variant (no wildcard) is exhaustive; selection is by
    // discriminant.
    {
        let c: Color = Color::Green;
        let got: i64 = match c {
            Color::Red   => 1i64,
            Color::Green => 2i64,   // discriminant selects this arm
            Color::Blue  => 3i64,
        };
        if got != 2i64 { return 12; }
    }

    // @rule pat.match.uninhabited-variant-omittable
    // for Result<i32, Void>, the Err payload is uninhabited so the Err arm is
    // omittable and the match is still exhaustive.
    {
        let r: Result<i64, Void> = Result::<i64, Void>::Ok(42i64);
        let got: i64 = match r {
            Result::Ok(x) => x,     // no Err arm needed (Void uninhabited)
        };
        if got != 42i64 { return 13; }
    }

    // @rule pat.match.scrutinee-moved-by-binding
    // matching a move-only by-value scrutinee that binds out by name moves it;
    // `_`/`ref` bindings move nothing. We observe the *non-move* side: a `_`
    // payload binding leaves a borrow usable; a `ref` binding reads in place.
    {
        let p: Pt = Pt { x: 3i64, y: 4i64 };
        let got: i64 = match p {
            Pt { x: ref rx, y: _ } => *rx,   // ref + _ : nothing moved
        };
        // p still fully live after a no-move match
        if got != 3i64 { return 14; }
        if p.y != 4i64 { return 15; }
        // a by-value bind of a move-only payload consumes it
        let ow: Owned = Owned { v: 77i64 };
        let taken: i64 = match ow {
            Owned { v } => v,                // v moved out by value
        };
        if taken != 77i64 { return 16; }
    }

    // @rule pat.bind.ref-does-not-move
    // `ref` borrows and `_` discards — neither consumes — recursively through
    // nested struct sub-patterns; a by-value name binding consumes.
    {
        let p: Pt = Pt { x: 1i64, y: 2i64 };
        match p {
            Pt { x: ref a, y: _ } => {       // ref borrow + wildcard discard
                if *a != 1i64 { return 17; }
            }
        }
        // p remains usable (nothing was moved)
        if p.x + p.y != 3i64 { return 18; }
    }

    // @rule pat.variant.prelude-shorthand-resolution
    // unqualified `Some`/`None` resolve to Option; `Ok`/`Err` to Result.
    {
        let o: Option<i64> = Some(7i64);
        let got: i64 = match o {
            Some(v) => v,            // resolves to Option::Some
            None    => -1i64,        // resolves to Option::None
        };
        if got != 7i64 { return 19; }
        let r: Result<i64, i64> = Ok(3i64);
        let got2: i64 = match r {
            Ok(v)  => v,             // resolves to Result::Ok
            Err(e) => e,             // resolves to Result::Err
        };
        if got2 != 3i64 { return 20; }
    }

    // pat.match.scrutinee-ref-peeled — see "untestable" report. The working
    // `&E` deref-peel form (matching `&Opt::Some(x)` / `&Opt::None`) is locked by
    // pat_3's `pat.ref.redundant-ref-peel-over-tagged-enum`. In THIS grouped file
    // the form is corrupted by an order-dependent codegen defect: a preceding
    // `Result` match (required here by `pat.variant.prelude-shorthand-resolution`)
    // makes the subsequent `&Enum` discriminant load read the wrong value. The
    // assertion would compile but fail at runtime, so it is omitted (transitive).

    // @rule pat.match.nested-payload-exhaustive
    // a single-field payload covered by exhaustive inner patterns covers the
    // variant; a bare `Variant` / all-wildcard payload covers it fully.
    {
        let o: Opt = Opt::Some(2i64);
        // Some(_) covers Some fully; None covers None -> exhaustive
        let got: i64 = match o {
            Opt::Some(_) => 1i64,
            Opt::None    => 0i64,
        };
        if got != 1i64 { return 22; }
    }

    // @rule pat.or.flatten-and-at-unwrap
    // or-patterns flatten to alternatives and `@`-bindings unwrap to their
    // inner sub-pattern for exhaustiveness/matching.
    {
        let n: i64 = 5i64;
        let got: i64 = match n {
            k @ (4i64 | 5i64 | 6i64) => k,   // @ unwrap + or flatten
            _ => -1i64,
        };
        if got != 5i64 { return 23; }
    }

    // @rule pat.for-loop.ref-element-deref
    // iterating &T elements derefs the binding to a value temporary of type T;
    // the tuple pattern destructures that value (no by-ref default modes).
    {
        let pairs: [(i64, i64); 2] = [(1i64, 2i64), (3i64, 4i64)];
        let mut sum: i64 = 0i64;
        for (a, b) in &pairs {                // element is &(i64,i64), deref'd
            sum = sum + a + b;                // a,b are i64 values, not refs
        }
        if sum != 10i64 { return 24; }
    }

    // @rule pat.for-loop.discard-underscore
    // a `_` element in a for-loop tuple pattern introduces no binding.
    {
        let pairs: [(i64, i64); 3] = [(1i64, 9i64), (2i64, 9i64), (3i64, 9i64)];
        let mut sum: i64 = 0i64;
        for (a, _) in &pairs {                // second element discarded
            sum = sum + a;
        }
        if sum != 6i64 { return 25; }
    }

    // @rule pat.or.semantics-distribution
    // `P | Q` matches iff some alternative matches; a variant-payload or
    // `Some(P|Q)` is equivalent to `Some(P) | Some(Q)`.
    {
        let o: Opt = Opt::Some(5i64);
        let got: i64 = match o {
            Opt::Some(4i64 | 5i64 | 6i64) => 1i64,  // payload or-pattern
            _ => 0i64,
        };
        if got != 1i64 { return 26; }
        let o2: Opt = Opt::Some(99i64);
        let got2: i64 = match o2 {
            Opt::Some(4i64 | 5i64 | 6i64) => 1i64,  // none of the alts match
            _ => 0i64,
        };
        if got2 != 0i64 { return 27; }
    }

    // @rule pat.match.guard-backtracks-alternatives
    // when a fanned-out or-alternative's guard fails, matching continues to the
    // next alternative within the same arm.
    {
        let n: i64 = 6i64;
        let got: i64 = match n {
            // alt 4 binds, guard false; alt 6 binds, guard true -> arm taken
            (4i64 | 6i64) if n == 6i64 => 1i64,
            _ => 0i64,
        };
        if got != 1i64 { return 28; }
    }

    // @rule pat.match.string-literal-pattern
    // a top-level string-literal arm matches by content equality.
    {
        let s: str = "foo";
        let got: i64 = match s {
            "bar" => 2i64,
            "foo" => 1i64,           // str_eq(scrut, "foo")
            _     => 0i64,
        };
        if got != 1i64 { return 29; }
    }

    // @rule pat.match.guard-runs-only-on-match
    // a guard executes only when the pattern matched (conjoined with &&), so a
    // wrong-variant arm never runs its guard.
    {
        let o: Opt = Opt::None;
        let got: i64 = match o {
            Opt::Some(v) if v > 0i64 => v,   // pattern fails -> guard not run
            Opt::None                => 7i64,
            Opt::Some(_)             => -1i64,
        };
        if got != 7i64 { return 30; }
    }

    // @rule pat.match.scrutinee-eval-once
    // the scrutinee is evaluated exactly once (hoisted), observable via a
    // side-effecting scrutinee expression read by multiple arms.
    {
        let got: i64 = match { let s: str = "hi"; s } {
            "hi" => 1i64,            // string scrutinee hoisted, evaluated once
            "lo" => 2i64,
            _    => 0i64,
        };
        if got != 1i64 { return 31; }
    }

    return 0;
}
