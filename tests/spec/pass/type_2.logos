package type_2;

use logos.mem.string;
use logos.mem.boxed;

// ── helper traits / types ───────────────────────────────────────────────────

trait Speak { fn val(&self) -> i64; }
struct Cat { v: i64 }
impl Speak for Cat { fn val(&self) -> i64 { return self.v; } }

struct Wrap<T> { inner: T }
impl<T> Wrap<T> { fn get(&self) -> &T { return &self.inner; } }

// ── pack-length array size: [T; sizeof...(P)] ───────────────────────────────
// `[T; sizeof...(P)]` sizes the array from the variadic pack length; sema lowers
// the size to symbolic "__sizeof_pack:P" and mono substitutes the literal length.
// The param's length is the count of P's types, so all sizeof...(P) elements are
// laid out and addressable.
fn pack_sum<P...>(xs: [i64; sizeof...(P)]) -> i64 { return xs[0] + xs[1] + xs[2]; }

// impl-Trait parameter desugars to a synthetic generic param bounded by the trait
fn via_impl(s: impl Speak) -> i64 { return s.val(); }
// impl Fn(args) -> R form
fn apply_impl(f: impl Fn(i64) -> i64, x: i64) -> i64 { return f(x); }

// fn-pointer-typed parameter (bare function pointer type)
fn run_fp(f: fn(i64) -> i64, x: i64) -> i64 { return f(x); }

// closure-typed parameter
fn run_closure(f: |i64| -> i64, x: i64) -> i64 { return f(x); }

// dyn trait object parameter (fat pointer)
fn via_dyn(s: &dyn Speak) -> i64 { return s.val(); }

// slice-ref parameter (fat pointer: ptr + len)
fn sum_slice(xs: &[i64]) -> i64 {
    let mut acc: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < xs.len() { acc = acc + xs[i]; i = i + 1i64; }
    return acc;
}

// double-reference parameter
fn deref2(x: &&i64) -> i64 { return **x; }

// const for metacall array size
const NSZ: i64 = 3;

fn plus1(x: i64) -> i64 { return x + 1i64; }

// associated-type reference `T::Item` in a return position. A trait with an
// associated type; the impl binds Item = i64. Using `Self::Item` / `T::Item`
// as a type exercises the assoc-type-ref grammar form.
trait Producer {
    type Item;
    fn produce(&self) -> Self::Item;
}
struct IntBox { n: i64 }
impl Producer for IntBox {
    type Item = i64;
    fn produce(&self) -> Self::Item { return self.n; }
}
// free fn whose return type is written as the projected associated type `P::Item`.
fn pull<P: Producer<Item = i64>>(p: &P) -> P::Item { return p.produce(); }

fn main() -> i64 {

    // @rule type.array.size-from-pack
    // `[T; sizeof...(P)]` sizes the array from the pack length; the call below
    // instantiates P with 3 types, so the parameter is a 3-element array and all
    // three elements are addressable (sum of indices 0..2).
    {
        let s: i64 = pack_sum::<i64, i64, i64>([10i64, 20i64, 30i64]);
        if s != 60i64 { return 1; }
    }

    // @rule type.array.size-from-metacall
    // `[T; metacall { ... }]` permits a compile-time metacall block as the array
    // size; here the const NSZ folds to 3.
    {
        let a: [i64; metacall { NSZ }] = [7i64, 8i64, 9i64];
        if a.len() != 3i64 { return 2; }
        if a[2] != 9i64 { return 3; }
    }

    // @rule type.slice.unsized
    // Bare `[T]` (no size) is the unsized slice type; reached via Box<[T]> here.
    // The size-bearing array form `[T; N]` is tried first, so a sized array stays
    // sized — Box<[i64;3]> coerces to the unsized Box<[i64]>.
    {
        let b: Box<[i64]> = box_new::<[i64; 3]>([4i64, 5i64, 6i64]) as Box<[i64]>;
        if b.len() != 3i64 { return 4; }
        if b[0] != 4i64 { return 5; }
    }

    // @rule type.generic.type-arg-kinds
    // A generic type argument may be a type: `Wrap<i64>` resolves its sole type-arg
    // to the concrete element type i64 (the plain-type kind among the kinds the
    // rule enumerates). Lifetime/integer-literal/antiquote kinds are exercised by
    // dedicated tests (see untestable note).
    {
        let w: Wrap<i64> = Wrap { inner: 99i64 };
        if *w.get() != 99i64 { return 6; }
    }

    // @rule type.ref.dotted-path
    // A fully-qualified non-generic type in type position is written
    // `pkg.path.Type` (dotted); the last segment is the type.
    {
        let s: logos.mem.string.String = String::new();
        if s.len() != 0i64 { return 7; }
    }

    // @rule type.generic.instantiation
    // `Name<arg>` instantiates a generic type (optional trailing comma allowed).
    {
        let w: Wrap<i64,> = Wrap { inner: 55i64 };
        if *w.get() != 55i64 { return 8; }
    }

    // @rule type.paren.unwrap
    // `( T )` is a parenthesized type; sema unwraps it to its inner type T.
    {
        let x: (i64) = 42i64;
        if x != 42i64 { return 9; }
    }

    // @rule type.impl-trait.param
    // `impl Trait` and `impl Fn(args) -> R` are accepted in type position; an
    // impl-Trait parameter desugars to a synthetic generic bounded by the trait.
    {
        if via_impl(Cat { v: 13i64 }) != 13i64 { return 10; }
        if apply_impl(plus1, 20i64) != 21i64 { return 11; }
    }

    // @rule type.assoc.projection
    // `T::Item` (here `P::Item` / `Self::Item`) is an associated-type reference;
    // it resolves to the impl's bound assoc type (i64) and is usable in type
    // position (the return type of `pull`).
    {
        let ib: IntBox = IntBox { n: 64i64 };
        if pull::<IntBox>(&ib) != 64i64 { return 13; }
    }

    // @rule type.dyn.trait-object
    // `&dyn Trait` is a trait object (fat pointer: data + vtable); dispatch
    // through it reaches the concrete impl.
    {
        let c: Cat = Cat { v: 71i64 };
        let d: &dyn Speak = &c;
        if via_dyn(d) != 71i64 { return 14; }
        if d.val() != 71i64 { return 15; }
    }

    // @rule type.slice.ref
    // `&[T]` is a slice type (fat pointer: ptr + len).
    {
        let arr: [i64; 3] = [1i64, 2i64, 3i64];
        if sum_slice(&arr) != 6i64 { return 16; }
    }

    // @rule type.ref.borrow
    // `&T` and `&mut T` are safe borrow-checked references; `&&T` is a
    // double-reference (arbitrary depth accepted at type position).
    {
        let v: i64 = 88i64;
        let r: &i64 = &v;
        if *r != 88i64 { return 17; }
        let rr: &&i64 = &r;
        if deref2(rr) != 88i64 { return 18; }
    }

    // @rule type.closure.type
    // `|T| -> R` is a closure type used in parameter annotations.
    {
        let r: i64 = run_closure(|a: i64| -> i64 { return a * 3i64; }, 4i64);
        if r != 12i64 { return 19; }
    }

    // @rule type.fn-ptr.type
    // `fn(T) -> R` is a bare function-pointer type.
    {
        let r: i64 = run_fp(plus1, 100i64);
        if r != 101i64 { return 20; }
    }

    return 0;
}
