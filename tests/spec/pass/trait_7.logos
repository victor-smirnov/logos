package trait_7;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

// ── fmt: Display maps to method `fmt`, dispatched via the fmt_display wrapper ─
struct Tag { v: i64 }
impl Display for Tag {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        return f.write_str("T!");
    }
}

// ── helpers for method-typeargs / static-dispatch / assoc-const ──────────────
trait Producer<C> {
    fn produce<M>(&self, base: C, mult: M) -> M;
}
struct PBox { k: i64 }
impl Producer<i64> for PBox {
    // both the owning-trait param C(=i64, from Self-subst) and the method param
    // M(=i64, inferred from `mult`) must be carried so the call returns mult.
    fn produce<M>(&self, base: i64, mult: M) -> M { return mult; }
}

// ── dyn inherent-first vs vtable ─────────────────────────────────────────────
trait Speak { fn speak(&self) -> i64; }
struct Cat { v: i64 }
impl Speak for Cat { fn speak(&self) -> i64 { return self.v; } }
// inherent impl on `dyn Speak`: must be tried BEFORE vtable dispatch.
impl Speak for dyn Speak { fn speak(&self) -> i64 { return 777i64; } }

// ── dyn return-subst (generic trait param in return type) ────────────────────
trait Carry<T> { fn carry(&self) -> T; }
struct CarI { n: i64 }
impl Carry<i64> for CarI { fn carry(&self) -> i64 { return self.n; } }

// ── tuple impl ───────────────────────────────────────────────────────────────
trait Combine { fn combine(&self) -> i64; }
impl<A, B> Combine for (A, B) { fn combine(&self) -> i64 { return 10i64; } }

// ── static dispatch via type-param bound + assoc const ───────────────────────
trait HasZero {
    const ZERO: i64 = 0i64;
    fn zero_val() -> i64;
}
struct ZA {}
impl HasZero for ZA {
    const ZERO: i64 = 5i64;
    fn zero_val() -> i64 { return 5i64; }
}
fn call_static<T: HasZero>() -> i64 { return T::zero_val(); }
fn read_zero<T: HasZero>() -> i64 { return T::ZERO; }

// supertrait closure for assoc const (impl supplies B explicitly)
trait BaseC { const B: i64; }
trait DerivedC: BaseC { fn d(&self) -> i64; }
struct Dc {}
impl BaseC for Dc { const B: i64 = 10i64; }
impl DerivedC for Dc { fn d(&self) -> i64 { return 1i64; } }
fn read_super_const<T: DerivedC>() -> i64 { return T::B; }

// trait-qualified static self-inference
trait Make { fn make() -> i64; }
struct Mk {}
impl Make for Mk { fn make() -> i64 { return 42i64; } }

// ── assoc-const default projected to impl that omits it ──────────────────────
trait DefC { const D: i64 = 99i64; }
struct DefImpl {}
impl DefC for DefImpl {}   // omits D -> inherits default

// ── Copy auto-derive + conditional copy ──────────────────────────────────────
struct PlainCopy { a: i64, b: i64 }   // all-Copy fields, no Drop -> auto Copy

// ── distinct trait-args coexist (From<i8> vs From<i16>) ──────────────────────
struct Sink { tag: i64 }
trait MyFrom<S> { fn myfrom(s: S) -> Sink; }
impl MyFrom<i8>  for Sink { fn myfrom(s: i8)  -> Sink { return Sink { tag: 1i64 }; } }
impl MyFrom<i16> for Sink { fn myfrom(s: i16) -> Sink { return Sink { tag: 2i64 }; } }

// ── assoc-type GAT + default ─────────────────────────────────────────────────
trait GatT {
    type Item = i32;          // default assoc type
    fn one(&self) -> i32;
}
struct GatImpl {}
impl GatT for GatImpl { fn one(&self) -> i32 { return 1i32; } }  // omits Item -> default i32

// ── default method conditional on param bounds ───────────────────────────────
trait Cond<I> {
    fn base(&self) -> i64;
    fn doubled(&self) -> i64 where I: HasZero { return self.base() * 2i64; }
}
struct CondImpl { x: i64 }
impl Cond<ZA> for CondImpl { fn base(&self) -> i64 { return self.x; } }  // ZA: HasZero -> doubled synthesized

// ── object-safety: where Self: Sized method excluded from vtable ─────────────
trait Obj {
    fn dynok(&self) -> i64;
    fn sized_only() -> i64 where Self: Sized { return 100i64; }  // not in vtable
}
struct ObjImpl { y: i64 }
impl Obj for ObjImpl {
    fn dynok(&self) -> i64 { return self.y; }
    fn sized_only() -> i64 where Self: Sized { return 100i64; }
}

// ── Sized no-op bound ────────────────────────────────────────────────────────
fn need_sized<T: Sized>(x: T) -> i64 where T: Copy { return 1i64; }
struct SzS { v: i64 }
impl Copy for SzS {}

// ── conditional Copy impl ────────────────────────────────────────────────────
struct Wrap<P> { p: P }
impl<P: Copy> Copy for Wrap<P> {}

// ── mangle: trait-qualified disambiguation on collision ──────────────────────
trait TA { fn ping(&self) -> i64; }
trait TB { fn ping(&self) -> i64; }
struct Coll {}
impl TA for Coll { fn ping(&self) -> i64 { return 1i64; } }
impl TB for Coll { fn ping(&self) -> i64 { return 2i64; } }
// each generic bound selects exactly one of the re-keyed colliding methods.
fn via_ta<T: TA>(x: &T) -> i64 { return x.ping(); }
fn via_tb<T: TB>(x: &T) -> i64 { return x.ping(); }

// ── negative impl ────────────────────────────────────────────────────────────
trait NegTr { fn ng(&self) -> i64 { return 0i64; } }
struct NegS { z: i64 }
impl !NegTr for NegS {}

// ── assoc-type eq-clause satisfaction ────────────────────────────────────────
trait Assoc { type Out; fn get(&self) -> i64; }
struct AImpl { n: i64 }
impl Assoc for AImpl { type Out = i64; fn get(&self) -> i64 { return self.n; } }
// bound requires Out == i64; only satisfied if impl's `type Out = i64`.
fn use_eq<T: Assoc<Out = i64>>(t: &T) -> i64 { return t.get(); }

// ── blanket recursive satisfaction ───────────────────────────────────────────
trait Aa { fn aa(&self) -> i64; }
trait Bb { fn bb(&self) -> i64; }
struct Base1 { v: i64 }
impl Aa for Base1 { fn aa(&self) -> i64 { return self.v; } }
// blanket: any T: Aa also gets Bb (chain Aa -> Bb)
impl<T: Aa> Bb for T { fn bb(&self) -> i64 { return self.aa() + 1i64; } }

fn main() -> i64 {

    // @rule trait.method-typeargs.propagate-trait-and-method-params
    // owning-trait param C and method param M both carried; returns mult(=M).
    {
        let p: PBox = PBox { k: 0i64 };
        if p.produce::<i64>(3i64, 9i64) != 9i64 { return 1; }
    }

    // @rule trait.dispatch.dyn-inherent-first
    // inherent `impl Speak for dyn Speak` is tried before vtable -> 777, not v.
    {
        let c: Cat = Cat { v: 5i64 };
        let d: &dyn Speak = &c;
        if d.speak() != 777i64 { return 2; }
    }

    // @rule trait.dispatch.dyn-return-subst
    // return type of dyn method = T substituted from the peeled dyn trait args.
    {
        let c: CarI = CarI { n: 13i64 };
        let d: &dyn Carry<i64> = &c;
        let r: i64 = d.carry();        // would not typecheck if T leaked unsubst
        if r != 13i64 { return 3; }
    }

    // @rule trait.dispatch.tuple-impl
    // user `impl Combine for (i64,i64)` resolves on a tuple receiver.
    {
        let t: (i64, i64) = (4i64, 6i64);
        if t.combine() != 10i64 { return 4; }
    }

    // @rule trait.static-dispatch.via-type-param-bound
    // `T::zero_val()` resolves via T's bound and runs the concrete impl.
    {
        if call_static::<ZA>() != 5i64 { return 5; }
    }

    // @rule trait.static-dispatch.trait-qualified-self-inference
    // `Make::make()` Self inferred from the let-annotation's concrete type.
    {
        let r: i64 = Mk::make();
        if r != 42i64 { return 6; }
    }

    // @rule trait.assoc-const.generic-projection
    // `T::ZERO` on bound type-param projects the per-impl const value.
    {
        if read_zero::<ZA>() != 5i64 { return 7; }
    }

    // @rule trait.assoc-const.supertrait-closure
    // `T::B` where B is declared on supertrait BaseC of bound DerivedC.
    {
        if read_super_const::<Dc>() != 10i64 { return 8; }
    }

    // @rule trait.assoc-const.default-projected-to-impl
    // impl omits D -> inherits the trait default (99).
    {
        if DefImpl::D != 99i64 { return 9; }
    }

    // @rule trait.copy.auto-derive-conditions
    // all-Copy-field, no-Drop struct is Copy: original usable after a copy.
    {
        let a: PlainCopy = PlainCopy { a: 1i64, b: 2i64 };
        let b: PlainCopy = a;          // copy, not move
        if a.a + a.b != 3i64 { return 10; }   // original still readable
        if b.a + b.b != 3i64 { return 11; }
    }

    // @rule trait.impl.distinct-trait-args-coexist
    // From<i8> and From<i16> for Sink are distinct impls, both callable.
    {
        let s1: Sink = Sink::myfrom(1i8);
        let s2: Sink = Sink::myfrom(1i16);
        if s1.tag != 1i64 { return 12; }
        if s2.tag != 2i64 { return 13; }
    }

    // @rule trait.assoc-type.gat-and-default
    // impl omits `type Item` -> default i32; method returns i32 value.
    {
        let g: GatImpl = GatImpl {};
        if g.one() != 1i32 { return 14; }
    }

    // @rule trait.default-method.conditional-on-param-bounds
    // doubled() synthesized because Cond<ZA>'s I=ZA satisfies `I: HasZero`.
    {
        let c: CondImpl = CondImpl { x: 7i64 };
        if c.doubled() != 14i64 { return 15; }
    }

    // @rule trait.object-safety.sized-self-method-excluded
    // `where Self: Sized` method is excluded from vtable -> trait stays object-
    // safe; &dyn Obj dispatch on the non-Sized method works.
    {
        let o: ObjImpl = ObjImpl { y: 8i64 };
        let d: &dyn Obj = &o;
        if d.dynok() != 8i64 { return 16; }
        if ObjImpl::sized_only() != 100i64 { return 17; }  // callable statically
    }

    // @rule trait.builtin.sized-noop
    // `T: Sized` bound is admitted as a no-op; a concrete (size-known) type is
    // accepted and the fn runs.
    {
        let s: SzS = SzS { v: 0i64 };
        if need_sized(s) != 1i64 { return 19; }
    }

    // @rule trait.copy.conditional-copy-impl
    // `impl<P: Copy> Copy for Wrap<P>`: Wrap<i64> is Copy (i64 is Copy), so the
    // original is still usable after a copy.
    {
        let w: Wrap<i64> = Wrap::<i64> { p: 7i64 };
        let w2: Wrap<i64> = w;        // copy because P=i64 is Copy
        if w.p != 7i64 { return 20; } // original readable -> was a copy, not a move
        if w2.p != 7i64 { return 21; }
    }

    // @rule trait.mangle.trait-qualified-on-collision
    // TA and TB both define `ping` on Coll; trait-qualified calls disambiguate
    // to the distinct re-keyed methods.
    {
        let c: Coll = Coll {};
        if via_ta::<Coll>(&c) != 1i64 { return 22; }   // re-keyed Coll__TA__ping
        if via_tb::<Coll>(&c) != 2i64 { return 23; }   // re-keyed Coll__TB__ping
    }

    // @rule trait.impl.negative-impl
    // `impl !NegTr for NegS {}` is a negative impl: it compiles and NegS's own
    // inherent state is unaffected (the trait's default method is NOT provided
    // for NegS via this impl).
    {
        let n: NegS = NegS { z: 5i64 };
        if n.z != 5i64 { return 24; }
    }

    // @rule trait.assoc.eq-clause-satisfaction
    // `Assoc<Out = i64>` bound holds for AImpl only because its `type Out = i64`.
    {
        let a: AImpl = AImpl { n: 8i64 };
        if use_eq::<AImpl>(&a) != 8i64 { return 25; }
    }

    // @rule trait.fmt.trait-method-names
    // `{:x}`/`{:X}`/`{:o}`/`{:b}` placeholders lower to the LowerHex/UpperHex/
    // Octal/Binary trait methods (fmt_lower_hex/.../fmt_binary); the rendered
    // text proves each placeholder reached the right formatting trait method.
    {
        let h: String = format!("{:x}", 255u64);   // LowerHex -> "ff"
        if !h.eq_str("ff") { return 26; }
        let u: String = format!("{:X}", 255u64);   // UpperHex -> "FF"
        if !u.eq_str("FF") { return 27; }
        let o: String = format!("{:o}", 8u64);     // Octal -> "10"
        if !o.eq_str("10") { return 28; }
        let b2: String = format!("{:b}", 10u64);   // Binary -> "1010"
        if !b2.eq_str("1010") { return 29; }
    }

    // @rule trait.fmt.trait-dispatcher-fn
    // `{}` lowers through the fmt_display dispatcher bound to the Display trait
    // (a free-fn wrapper, not a dot-call); a custom `impl Display { fn fmt }`
    // is reached -> output is the impl's text.
    {
        let t: Tag = Tag { v: 0i64 };
        let s: String = format!("{}", t);          // Display::fmt -> "T!"
        if !s.eq_str("T!") { return 30; }
    }

    // @rule trait.blanket.recursive-satisfaction
    // Base1: Aa, and blanket `impl<T: Aa> Bb for T` makes Base1: Bb transitively.
    {
        let b: Base1 = Base1 { v: 30i64 };
        if b.bb() != 31i64 { return 18; }   // aa()+1, reached via blanket chain
    }

    return 0;
}
