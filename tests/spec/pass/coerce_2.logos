package coerce_2;

use logos.mem.boxed;
use logos.mem.string;
use logos.lang.option;

// ── helpers for dyn / vtable coercion rules ────────────────────────────────
trait Speak { fn say(&self) -> i64; }

struct Concrete { x: i64, y: i64 }
impl Speak for Concrete { fn say(&self) -> i64 { return self.x + self.y; } }

// Drop-instrumented types: dropping bumps a counter through a raw ptr.
trait Drop { fn drop(self: &mut Self); }
struct Tracked { c: *mut i64, v: i64 }
impl Speak for Tracked { fn say(&self) -> i64 { return self.v; } }
impl Drop  for Tracked { fn drop(self: &mut Self) { unsafe { *self.c += 1i64; } } }
// Drop-instrumented Concrete variant for the box-coercion dispatch+drop rule.
struct DConcrete { c: *mut i64, x: i64, y: i64 }
impl Speak for DConcrete { fn say(&self) -> i64 { return self.x + self.y; } }
impl Drop  for DConcrete { fn drop(self: &mut Self) { unsafe { *self.c += 1i64; } } }

// Callee taking a &dyn Trait — forces arg unsize-coercion from a concrete &T.
fn via_ref_dyn(d: &dyn Speak) -> i64 { return d.say(); }
// Callee taking an owning Box<dyn Trait> — drop must run concrete glue.
fn via_box_dyn(b: Box<dyn Speak>) -> i64 { return b.say(); }

// Callee taking an aggregate (struct) by value — Logos copies into fresh storage.
fn mutate_copy(mut c: Concrete) -> i64 { c.x = 999i64; return c.x; }

// Aggregate return-by-value: result must outlive this frame.
fn make_pair(a: i64, b: i64) -> (i64, i64) { return (a, b); }
fn make_struct(a: i64, b: i64) -> Concrete { return Concrete { x: a, y: b }; }

// C-style enum (no payload) — returned as integer discriminant.
enum Color { Red, Green, Blue }
fn pick(n: i64) -> Color { if n == 0i64 { return Color::Red; } if n == 1i64 { return Color::Green; } return Color::Blue; }

// Reference-return descriptor rule: &dyn (fat 16B) vs &i64 (thin 8B).
fn ret_ref_dyn(c: &dyn Speak) -> &dyn Speak { return c; }
fn ret_ref_thin(r: &i64) -> &i64 { return r; }

// Array parameter is passed by pointer; reading elements still works.
fn arr_sum(a: [i64; 3]) -> i64 { return a[0i64] + a[1i64] + a[2i64]; }

// Return a slice by value (16-byte {data,len} fat pair).
fn ret_slice(s: str) -> str { return s; }

// Scalar return coerced to declared numeric return type (narrow i64 arg -> i32).
fn ret_narrow(n: i64) -> i32 { return n as i32; }

fn main() -> i64 {
    // @rule coerce.cast.ptr-to-int
    // `&x as *const T as i64` reinterprets the address as an integer of i64's
    // width: the integer equals the raw address, and adding the byte offset of
    // a later field lands on that field's address (deref recovers the value).
    {
        let pair: (i64, i64) = (11i64, 22i64);
        let base: i64 = &pair as *const (i64, i64) as i64;
        let second: i64 = unsafe { *((base + 8i64) as *const i64) };
        if second != 22i64 { return 1; }
    }

    // @rule coerce.unsize.arg-struct-to-dyn-trait
    // A concrete &Concrete argument is implicitly unsize-coerced to the &dyn
    // Speak parameter: a fat {data,vtable} pair whose vtable dispatches say().
    {
        let c: Concrete = Concrete { x: 3i64, y: 4i64 };
        if via_ref_dyn(&c) != 7i64 { return 2; }
    }

    // @rule coerce.unsize.box-dyn-vtable-drops-concrete
    // A concrete Box<Tracked> coerced to Box<dyn Speak> carries Tracked's drop
    // glue in its vtable, so dropping the Box<dyn> runs Tracked::drop (counter
    // bumped exactly once), not an empty no-op.
    {
        let mut cnt: i64 = 0i64;
        let p: *mut i64 = &mut cnt;
        {
            let b: Box<dyn Speak> = box_new(Tracked { c: p, v: 5i64 });
            if b.say() != 5i64 { return 3; }
        }   // b dropped here -> Tracked::drop via vtable[0]
        if cnt != 1i64 { return 4; }
    }

    // @rule coerce.call.aggregate-arg-by-pointer
    // A struct argument passed by value is placed in fresh storage for the
    // callee: the callee mutating its copy does not affect the caller's value.
    {
        let c: Concrete = Concrete { x: 1i64, y: 2i64 };
        let inner: i64 = mutate_copy(c);
        if inner != 999i64 { return 5; }
        if c.x != 1i64 { return 6; }   // caller's copy untouched
    }

    // @rule coerce.return.aggregate-by-value
    // A tuple/struct return is returned by value and outlives the callee frame:
    // both an inline-aggregate tuple and a struct survive and read back intact.
    {
        let p: (i64, i64) = make_pair(7i64, 8i64);
        if p.0 != 7i64 { return 7; }
        if p.1 != 8i64 { return 8; }
        let s: Concrete = make_struct(40i64, 2i64);
        if s.x + s.y != 42i64 { return 9; }
    }

    // @rule coerce.return.c-enum-as-integer
    // A C-style (payload-free) enum is returned as its discriminant integer;
    // each distinct variant round-trips and matches correctly.
    {
        match pick(0i64) { Color::Red => {} Color::Green => { return 10; } Color::Blue => { return 11; } }
        match pick(1i64) { Color::Red => { return 12; } Color::Green => {} Color::Blue => { return 13; } }
        match pick(2i64) { Color::Red => { return 14; } Color::Green => { return 15; } Color::Blue => {} }
    }

    // @rule coerce.return.ref-by-descriptor
    // A reference return uses the reference's RefRepr: &dyn returns the 16-byte
    // fat pair by value (dispatch survives), &i64 returns the 8-byte thin
    // pointer by value (deref recovers the referent).
    {
        let c: Concrete = Concrete { x: 6i64, y: 6i64 };
        let d: &dyn Speak = ret_ref_dyn(&c);
        if d.say() != 12i64 { return 16; }
        let n: i64 = 77i64;
        let r: &i64 = ret_ref_thin(&n);
        if *r != 77i64 { return 17; }
    }

    // @rule coerce.param.array-by-pointer
    // An [T; N] parameter is passed by pointer to the array storage; the callee
    // still indexes every element correctly.
    {
        let a: [i64; 3] = [10i64, 20i64, 30i64];
        if arr_sum(a) != 60i64 { return 18; }
    }

    // @rule coerce.int.widen-by-source-signedness
    // Widening sign-extends a signed source and zero-extends an unsigned source.
    // -1i8 -> i32 = -1 (sign-extended); 0xFFu8 -> u32 = 255 (zero-extended).
    {
        let sv: i8 = -1i8;
        if (sv as i32) != -1i32 { return 19; }
        let uv: u8 = 255u8;
        if (uv as u32) != 255u32 { return 20; }
        if (uv as i32) != 255i32 { return 21; }   // unsigned source still zero-extends
    }

    // @rule coerce.int.truncate-on-narrowing
    // Narrowing truncates to the destination width (low bits kept): 0x1234 as u8
    // keeps 0x34 = 52; 257 as u8 = 1.
    {
        let w: i32 = 0x1234i32;
        if (w as u8) != 52u8 { return 22; }
        if (257i32 as u8) != 1u8 { return 23; }
    }

    // @rule coerce.float.widen-truncate
    // f32 -> f64 extends exactly for representable values; f64 -> f32 truncates.
    {
        let f: f32 = 1.5f32;
        if (f as f64) != 1.5f64 { return 24; }
        let d: f64 = 2.5f64;
        if (d as f32) != 2.5f32 { return 25; }
    }

    // @rule coerce.int.to-float-by-signedness
    // int->float uses unsigned conversion for an unsigned source and signed for a
    // signed source: -2i32 -> -2.0; 250u8 -> 250.0.
    {
        if (-2i32 as f64) != -2.0f64 { return 26; }
        if (250u8 as f64) != 250.0f64 { return 27; }
    }

    // @rule coerce.unsize.box-concrete-to-box-dyn
    // Binding a boxed concrete value to a Box<dyn Speak> target coerces the thin
    // pointer to a fat {data,vtable} pair selecting DConcrete's Speak impl, and
    // the resulting owning Box<dyn> is droppable: dispatch returns x+y and the
    // drop runs DConcrete's drop_in_place via vtable[0] (counter bumped once).
    {
        let mut cnt2: i64 = 0i64;
        let p2: *mut i64 = &mut cnt2;
        {
            let bd: Box<dyn Speak> = box_new(DConcrete { c: p2, x: 8i64, y: 9i64 });
            if bd.say() != 17i64 { return 28; }
        }
        if cnt2 != 1i64 { return 38; }   // owning Box<dyn> drop ran concrete glue
    }

    // @rule coerce.return.slice-by-value
    // A str return is the 16-byte {data,len} fat pair returned by value (no heap
    // copy); both halves survive (len + content).
    {
        let s: str = ret_slice("hello");
        if s.len() != 5i64 { return 30; }
        if s != "hello" { return 31; }
    }

    // @rule coerce.return.numeric-to-ret-type
    // A scalar return is coerced to the declared numeric return type: an i64 arg
    // narrowed to an i32 return keeps the low 32 bits.
    {
        if ret_narrow(70000i64) != 70000i32 { return 32; }
        if ret_narrow(0x1_0000_0001i64) != 1i32 { return 33; }   // narrowed to i32 low bits
    }

    return 0;
}
