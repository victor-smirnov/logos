package item_3;

// item_3 — item collection & lowering rules, locked by execution.
// Rules that are pure collection-internal (doc buffers, #[test] flags,
// symbol mangling, structural flags, type_code/zoned attrs) are not
// observable from a normal `main` run and are reported untestable.

// ── helpers for rules that need top-level items ────────────────────────────

/// outer line doc on a union (parse-accepted; doc buffer is internal).
/** outer block doc too. */
// @rule item.union.collected-as-struct
// A `union NAME { … }` is collected with the same named-field shape as a
// struct and registered as a known type — construct one field, read it back.
union U { i: i64, f: i64 }

// @rule item.union.lowered-as-struct
// A union lowers through the struct path (same field shape) — a second union
// with two distinct fields constructs and round-trips each active field.
union U2 { a: i64, b: i64 }

// @rule item.const.inlined-value
// A `const` stores its initializer as a VALUE inlined at each use site.
const K: i64 = 10i64;

// @rule item.static.global-storage
// A `static` is real global storage keyed by one module-qualified symbol:
// reads of the SAME static from different sites observe the SAME value.
static X: i64 = 5i64;

// @rule item.static.unsafe-access
// A `static mut` is mutable global storage; reads/writes require `unsafe`
// and a write is observed by a later read of the same global.
static mut Y: i64 = 0i64;

// @rule item.cfg.conditional-compilation
// On this (unix) host, a #[cfg(unix)] item is KEPT and a #[cfg(windows)]
// same-named item is DROPPED before lowering (no duplicate-def error).
#[cfg(unix)]
fn platform_val() -> i64 { return 42i64; }
#[cfg(windows)]
fn platform_val() -> i64 { return 999i64; }

// @rule item.cfg.drop-disabled
// A #[cfg(windows)] item is dropped entirely on a unix host: defining its
// same-named sibling under #[cfg(unix)] would be a duplicate if it weren't.
#[cfg(unix)]
fn kept_only() -> i64 { return 7i64; }
#[cfg(windows)]
fn kept_only() -> i64 { return 8i64; }

// @rule item.enum.empty-legal
// An enum with an empty body is legal (uninhabited / marker type) — its mere
// presence in this compiling unit is the assertion; no diagnostic is emitted.
enum Void {}

// @rule item.enum.discriminant-default
// First implicit discriminant = 0, then previous+1; an explicit value resets
// the running counter to value+1.
enum Disc { A, B, C = 10, D }

// tuple struct — first field has no name => positional fields "0","1".
struct TPair(i64, i64);

fn main() -> i64 {

    // @rule item.union.collected-as-struct
    let u: U = U { i: 11i64 };
    if unsafe { u.i } != 11i64 { return 1; }

    // @rule item.union.lowered-as-struct
    let ua: U2 = U2 { a: 21i64 };
    if unsafe { ua.a } != 21i64 { return 2; }
    let ub: U2 = U2 { b: 22i64 };
    if unsafe { ub.b } != 22i64 { return 3; }

    // @rule item.const.inlined-value
    // K inlined at two distinct use sites; both fold to the same value.
    if K != 10i64 { return 4; }
    if K + K != 20i64 { return 5; }

    // @rule item.static.global-storage
    // Two reads of the SAME static name resolve to the SAME global storage.
    let r1: i64 = X;
    let r2: i64 = X;
    if r1 != 5i64 { return 6; }
    if r1 != r2 { return 7; }

    // @rule item.static.unsafe-access
    // static mut: a write under `unsafe` is seen by a later unsafe read.
    unsafe {
        Y = Y + 3i64;
        Y = Y + 4i64;
    }
    if unsafe { Y } != 7i64 { return 8; }

    // @rule item.cfg.conditional-compilation
    // unix arm selected (42), windows arm dropped.
    if platform_val() != 42i64 { return 9; }

    // @rule item.cfg.drop-disabled
    // windows duplicate dropped; unix definition is the live one.
    if kept_only() != 7i64 { return 10; }

    // @rule item.enum.discriminant-default
    if (Disc::A as i64) != 0i64 { return 11; }   // first implicit = 0
    if (Disc::B as i64) != 1i64 { return 12; }   // previous + 1
    if (Disc::C as i64) != 10i64 { return 13; }  // explicit
    if (Disc::D as i64) != 11i64 { return 14; }  // counter reset to value+1

    // @rule item.struct.tuple-struct-fields
    // Positional fields get synthetic names "0","1": member access `.0`/`.1`
    // reuses named-field machinery.
    let tp: TPair = TPair(7i64, 8i64);
    if tp.0 != 7i64 { return 15; }
    if tp.1 != 8i64 { return 16; }

    return 0;
}
