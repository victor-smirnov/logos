// @rule expr.arr-fill.repeat-literal
// A zero-length fill literal is legal, exactly as in Rust: `[v; 0]` is an
// empty array. It used to be REJECTED while the matching type `[T; 0]` was
// accepted — an unregistered divergence that survived only because the type
// position and the expression position had separate code.
package expr_arr_fill_zero;

fn main() -> i32 {
    let a: [i32; 0] = [7i32; 0];
    let s: &[i32] = &a;
    if s.len() != 0i64 { return 1i32; }

    // and the non-empty case still repeats
    let b: [i32; 3] = [7i32; 3];
    if b[0] + b[1] + b[2] != 21i32 { return 2i32; }
    return 0i32;
}
