package expr_7;

use logos.lang.option;
use logos.lang.result;
use logos.lang.ptr;
use logos.lang.cmp;
use logos.lang.cmp.Ordering.{Less, Equal, Greater};

extern fn malloc(size: i64) -> *mut u8;

// ---- custom-DST with a `dyn`-trait tail (fat pointer) ----
trait Tr { fn v(&self) -> i64; }
struct A { x: i64 }
impl Tr for A { fn v(&self) -> i64 { return self.x; } }
// fixed sized prefix + unsized (?Sized) tail field.
struct Inner<T: ?Sized> { strong: i32, mid: i32, val: T }

// ---- fat-pointer custom-DST with a [u8] tail (prefix-positional) ----
struct Foo { header: i64, tail: [u8] }

// ---- union (read requires unsafe; write is safe) ----
union Pair { a: i32, b: i32 }

// ---- droppable rvalue base (hoist temp; Drop runs at scope exit) ----
trait Drop { fn drop(self: &mut Self); }
struct Owner { i: *mut i64, x: i64 }
impl Drop for Owner { fn drop(self: &mut Self) { unsafe { *self.i += 1i64; } } }
fn make_owner(p: *mut i64) -> Owner { return Owner { i: p, x: 77i64 }; }

// ---- generic struct literal: explicit args, inference variants ----
struct Box1<T> { val: T }
struct Carr<T> { arr: [T; 2] }
struct PtrHold<T> { p: *const T }
struct Nest<T> { inner: Box1<T> }

// ---- pub access: same-package private field is reachable ----
struct Priv { v: i64 }

// ---- variant-alias match helper (decoupled, like use_variants_bare) ----
fn ord_code(o: Ordering) -> i64 {
    match o {
        Ordering::Less    => { return 1i64; }
        Ordering::Equal   => { return 2i64; }
        Ordering::Greater => { return 3i64; }
    }
}

// ---- variadic field family ----
struct Vari<T...> { item ... : T }

// ---- specialization: full explicit args select the spec field set ----
#[datatype] struct Tag { d: u32 }
#[datatype] struct Spec<T> { a: u64, b: u64 }
#[datatype] struct Spec<Tag> { only: u64 }

fn main() -> i64 {
    // @rule expr.field.dst-tail-dyn
    // Fat-pointer receiver to a custom-DST whose last field is `dyn Tr`:
    // `r.val` yields a `&dyn Tr` reusing the receiver's OWN carried vtable;
    // dispatch through it returns the concrete value (no static vtable lookup).
    unsafe {
        let raw: *mut u8 = malloc(64i64);
        let ic: *mut Inner<A> = raw as *mut Inner<A>;
        ic.strong = 5i32;
        ic.mid = 0i32;
        ic.val = A { x: 37i64 };
        let id: *mut Inner<dyn Tr> = ic as *mut Inner<dyn Tr>;
        let vv: i64 = (&id.val as &dyn Tr).v();   // tail projection, shared vtable
        if vv != 37i64 { return 1; }
    }

    // @rule expr.field.dst-prefix-positional
    // Non-tail prefix field of a fat-pointer custom-DST is addressed positionally
    // by walking the sized prefix; works uniformly across instances.
    unsafe {
        let raw2: *mut u8 = malloc(64i64);
        let ic2: *mut Inner<A> = raw2 as *mut Inner<A>;
        ic2.strong = 9i32;
        ic2.mid = 13i32;
        ic2.val = A { x: 1i64 };
        let id2: *mut Inner<dyn Tr> = ic2 as *mut Inner<dyn Tr>;
        if id2.strong != 9i32 { return 2; }   // first prefix field
        if id2.mid != 13i32 { return 3; }     // second prefix field, walked offset
    }

    // @rule expr.field.union-read-unsafe
    // A union field WRITE is safe; a union field READ requires `unsafe`.
    {
        let mut u: Pair = Pair { a: 1i32 };
        u.a = 41i32;                      // write to union field: SAFE (no unsafe)
        let ug: i32 = unsafe { u.a };     // read requires unsafe
        if ug != 41i32 { return 4; }
    }

    // @rule expr.field.pub-access
    // A non-pub field is accessible within the package that defines the struct.
    {
        let pr: Priv = Priv { v: 88i64 };
        if pr.v != 88i64 { return 5; }
    }

    // @rule expr.field.hoist-droppable-rvalue-temp
    // `make().x` reads a field off a fresh owned rvalue of a move (droppable)
    // type: the base is hoisted into a stmt-scoped temp so its Drop runs once.
    {
        let mut cnt: i64 = 0i64;
        {
            let pp: *mut i64 = &mut cnt;
            let got: i64 = make_owner(pp).x;   // hoisted temp, drop at stmt end
            if got != 77i64 { return 6; }
        }
        if cnt != 1i64 { return 7; }           // dropped exactly once
    }

    // @rule expr.struct-lit.explicit-type-args-seed-inference
    // Explicit type args bind positionally and seed inference.
    {
        let b: Box1<i64> = Box1::<i64> { val: 12i64 };
        if b.val != 12i64 { return 8; }
    }

    // @rule expr.struct-lit.full-explicit-args-select-spec
    // All args explicit + a matching specialization exists ⇒ literal uses the
    // specialization's field set (Spec<Tag> has `only`, not `a`/`b`).
    {
        let s: Spec<Tag> = Spec::<Tag> { only: 99u64 };
        if s.only != 99u64 { return 9; }
    }

    // @rule expr.struct-lit.infer-typevar-from-field
    // Type-param T used directly as a field's type is inferred from the value.
    {
        let b: Box1<i64> = Box1 { val: 21i64 };   // T inferred = i64
        if b.val != 21i64 { return 10; }
    }

    // @rule expr.struct-lit.infer-typevar-from-array-field
    // For `[T; N]`, T is inferred from the element type of an array value.
    {
        let c: Carr<i64> = Carr { arr: [3i64, 4i64] };   // T inferred from elems
        if c.arr[0u64] + c.arr[1u64] != 7i64 { return 11; }
    }

    // @rule expr.struct-lit.infer-typevar-from-ptr-field
    // For `*const T`, T is inferred from the pointee of a ref-like value.
    {
        let n: i64 = 55i64;
        let ph: PtrHold<i64> = PtrHold { p: &n as *const i64 };   // T from pointee
        unsafe { if *ph.p != 55i64 { return 12; } }
    }

    // @rule expr.struct-lit.infer-nested-typevar
    // T nested inside a compound field type (Box1<T>) inferred by structural walk.
    {
        let nst: Nest<i64> = Nest { inner: Box1 { val: 31i64 } };
        if nst.inner.val != 31i64 { return 13; }
    }

    // @rule expr.struct-lit.uninferred-typevar-fallback-hint
    // A param not inferred from fields is resolved from the expected-type hint.
    {
        // val is an int literal; no field pins T, so T comes from the hint Box1<i64>.
        let b: Box1<i64> = Box1 { val: 7i64 };
        if b.val != 7i64 { return 14; }
    }

    // @rule expr.struct-lit.variadic-field-expansion
    // A variadic field `item ... : T` accepts `item_0`, `item_1`, … expansions.
    {
        let vv: Vari<i64, i64> = Vari { item_0: 10i64, item_1: 20i64 };
        if vv.item_0 != 10i64 { return 16; }   // variadic family member, prefix match
        if vv.item_1 != 20i64 { return 17; }
    }

    // @rule expr.struct-lit.field-variance-check
    // Field init is variance-checked permissively; lifetime args bound at site.
    {
        let n: i64 = 64i64;
        let r: &i64 = &n;
        let ph: PtrHold<i64> = PtrHold { p: r as *const i64 };
        unsafe { if *ph.p != 64i64 { return 20; } }
    }

    // build a [u8]-tail fat receiver and read a non-tail prefix field.
    unsafe {
        let dbuf: [u8; 16] = [9u8,9u8,9u8,9u8,9u8,9u8,9u8,9u8,
                              1u8,2u8,3u8,4u8,0u8,0u8,0u8,0u8];
        let rawf: *const u8 = &dbuf as *const [u8] as *const u8;
        // header occupies first 8 bytes (i64); write a known header then read it.
        let hh: *mut i64 = rawf as *mut u8 as *mut i64;
        *hh = 123i64;
        let ff: &Foo = dst_from_raw_parts::<Foo>(rawf, 4i64);
        if ff.header != 123i64 { return 21; }
        let s: &[u8] = ff.tail;
        if s.len() != 4i64 { return 22; }
    }

    // @rule expr.struct-lit.union-single-field
    // A union literal initializes only ONE active field (no all-fields check).
    {
        let u: Pair = Pair { a: 7i32 };   // only `a` set; `b` not required
        if unsafe { u.a } != 7i32 { return 23; }
    }

    // @rule expr.ctor.prelude-option-result-shorthand
    // Bare `Some(x)`/`Ok(x)`/`Err(x)` construct Option/Result variants when no
    // function of that name resolves and the enum is in scope.
    {
        let so: Option<i64> = Some(5i64);
        match so {
            Option::Some(v) => { if v != 5i64 { return 24; } }
            Option::None    => { return 25; }
        }
        let ro: Result<i64, i64> = Ok(6i64);
        match ro {
            Result::Ok(v)  => { if v != 6i64 { return 26; } }
            Result::Err(_) => { return 27; }
        }
        let re: Result<i64, i64> = Err(8i64);
        match re {
            Result::Ok(_)  => { return 28; }
            Result::Err(e) => { if e != 8i64 { return 29; } }
        }
    }

    // @rule expr.ctor.variant-alias-shorthand
    // `use Enum.{V};` registers a variant alias; bare `V` constructs that variant
    // when no function of that name resolved.
    {
        let o: Ordering = Less;   // imported variant alias constructs Ordering::Less
        if ord_code(o) != 1i64 { return 30; }       // constructed the Less variant
        if ord_code(Greater) != 3i64 { return 31; } // bare alias as call arg
    }

    // @rule expr.struct-lit.field-value-moved
    // A move-type field value is consumed by the literal (no double drop).
    // (Placed last: moving a droppable into a struct literal currently perturbs
    // a subsequent enum-match in the same fn — a separate codegen issue.)
    {
        let mut mcnt: i64 = 0i64;
        {
            let mp: *mut i64 = &mut mcnt;
            let o: Owner = make_owner(mp);
            let h: Box1<Owner> = Box1 { val: o };   // o moved into the literal
            if h.val.x != 77i64 { return 18; }
        }
        if mcnt != 1i64 { return 19; }   // dropped exactly once via the literal
    }

    return 0;
}
