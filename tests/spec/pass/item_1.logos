package item_1;

// Conformance test for the "item" rule group (stem item_1).
// Each rule that has a runtime-observable consequence is asserted below with a
// distinct nonzero return code on violation. Pure-grammar rules (doc-comments,
// attribute/argument shapes, item-kind set, eidos datatype decl) have no
// runtime-observable effect; they are still present in this file so the grammar
// is exercised by compilation, and are reported as untestable in the result.

// ── helper items ────────────────────────────────────────────────────────────

struct Pt { x: i64, y: i64 }

// item.static.runtime-initialized-storage: scalar static, single store.
static RUNTIME_INIT: i64 = 6i64 * 7i64;

// item.static.global-storage-and-mut-safety: static + static mut.
static STABLE: i64 = 314i64;
static mut COUNTER: i64 = 0i64;

// item.static.aggregate-init-by-copy: aggregate static, init by full copy.
static AGG: Pt = Pt { x: 100i64, y: 200i64 };

// item.union.layout-and-unsafe-access: struct-shaped, size = max field.
union U { a: i64, b: i32 }

// item.type-alias.def: plain and generic type aliases.
type Pair = (i64, i64);
type Id<T> = T;

// item.const.def: non-generic const and let module constants.
const FOUR: i64 = 4i64;
let SEVEN: i64 = 7i64;

// item.enum.def: C-style enum with an explicit backing integer type and an
// explicit discriminant value.
enum Code : i64 {
    Lo = 0i64,
    Hi = 99i64,
}

// item.enum.variant-shapes: unit, tuple, struct-shape, and empty-struct-shape.
enum Shape {
    Unit,
    Tup(i64, i64),
    Strct { a: i64, b: i64 },
    Empty {},
}

// item.impl.targets (inherent + trait-for-struct) and item.impl.items
// (assoc const, assoc type, methods) and item.static-fn.def (no self receiver).
trait Speak { fn val(&self) -> i64; }
struct W { n: i64 }
impl Speak for W { fn val(&self) -> i64 { return self.n; } }
impl W {
    const BASE: i64 = 4i64;
    type Item = i64;
    static fn make(x: i64) -> W { return W { n: x }; }
    fn doubled(&self) -> i64 { return self.n * 2i64; }
}

// item.fn.vararg-extern-only + item.extern-block.abi-default-to-children:
// variadic extern fn with C calling convention, spliced from extern "C" block.
extern "C" {
    fn snprintf(buf: *mut u8, n: i64, fmt: *const u8, ...) -> i32;
}

// ── pure-grammar constructs (exercised by parsing; no runtime assertion) ─────

/// item.doc.outer-line / item.doc.comment-attached-to-next-item:
/// consecutive outer line doc-comments accumulate onto the next item.
struct DocLineTarget { v: i64 }

/** item.doc.outer-block:
 *  an outer block doc-comment binds to the next item like a line doc-comment.
 */
struct DocBlockTarget { v: i64 }

// item.annotation.forms / item.annotation.arg-forms: the three attribute shapes
// (#[name(args)], #[name = val], #[name]) and the argument forms.
#[cfg(target = "x86")]
#[align(8)]
#[list([1, 2, 3])]
#[inline]
struct Annotated { v: i64 }

// item.datatype.def: a Writ-fabric datatype declaration.
eidos Eidos1 { x: i64, y: i64 }

fn main() -> i64 {

    // @rule item.static.runtime-initialized-storage
    // A non-extern static holds its declared initializer value by the time main
    // runs (zero-init at link, assigned at startup).
    if RUNTIME_INIT != 42i64 { return 1; }

    // @rule item.static.aggregate-init-by-copy
    // An aggregate static is initialized by copying the full value; every field
    // reads back correctly.
    if AGG.x != 100i64 { return 2; }
    if AGG.y != 200i64 { return 3; }

    // @rule item.static.global-storage-and-mut-safety
    // static mut read/write require unsafe; a static has a stable address, so
    // &STATIC taken twice yields the same pointer identity.
    unsafe {
        COUNTER = 5i64;
        COUNTER = COUNTER + 1i64;
        if COUNTER != 6i64 { return 4; }
    }
    {
        let p1: *const i64 = &STABLE as *const i64;
        let p2: *const i64 = &STABLE as *const i64;
        if p1 != p2 { return 5; }
    }

    // @rule item.union.layout-and-unsafe-access
    // Union size is max-of-fields (i64=8 > i32=4); field access requires unsafe.
    if sizeof::<U>() != 8i64 { return 6; }
    {
        let u: U = U { a: 11i64 };
        unsafe { if u.a != 11i64 { return 7; } }
    }

    // @rule item.type-alias.def
    // Plain and generic type aliases denote their aliased types.
    {
        let p: Pair = (3i64, 4i64);
        if p.1 != 4i64 { return 8; }
        let x: Id<i64> = 9i64;
        if x != 9i64 { return 9; }
    }

    // @rule item.const.def
    // Non-generic const and let module constants carry their initializer value.
    if FOUR != 4i64 { return 10; }
    if SEVEN != 7i64 { return 11; }

    // @rule item.enum.def
    // An enum with an explicit backing type honors its discriminant value.
    if (Code::Hi as i64) != 99i64 { return 12; }
    if (Code::Lo as i64) != 0i64 { return 27; }

    // @rule item.enum.variant-shapes
    // Unit, tuple, and struct-shape variants construct and destructure.
    {
        let s: Shape = Shape::Strct { a: 3i64, b: 4i64 };
        match s {
            Shape::Strct { a, b } => { if a + b != 7i64 { return 13; } }
            _ => { return 14; }
        }
        let t: Shape = Shape::Tup(10i64, 20i64);
        match t {
            Shape::Tup(x, y) => { if x + y != 30i64 { return 15; } }
            _ => { return 16; }
        }
        let unit: Shape = Shape::Unit;
        match unit {
            Shape::Unit => { }
            _ => { return 17; }
        }
    }

    // @rule item.impl.targets
    // Inherent impl and trait-for-struct impl both apply to their target type.
    {
        let w: W = W { n: 8i64 };
        if w.val() != 8i64 { return 18; }       // trait impl method
        if w.doubled() != 16i64 { return 19; }  // inherent impl method
    }

    // @rule item.impl.items
    // Associated const and associated method defined inside an impl resolve.
    if W::BASE != 4i64 { return 20; }

    // @rule item.fn.static-def
    // A static fn (no self receiver) is callable as an associated function.
    {
        let m: W = W::make(21i64);
        if m.doubled() != 42i64 { return 21; }
    }

    // @rule item.fn.vararg-extern-only
    // A variadic extern fn is callable with the C variadic calling convention;
    // snprintf("%d", 42) writes the two bytes "42" and returns 2.
    {
        let mut buf: [u8; 16] = [0u8; 16];
        let fmt: [u8; 3] = [37u8, 100u8, 0u8]; // "%d\0"
        unsafe {
            let written: i32 = snprintf(&mut buf[0] as *mut u8, 16i64,
                                        &fmt[0] as *const u8, 42i32);
            if written != 2i32 { return 22; }
        }
        if buf[0] != 52u8 { return 23; }  // '4'
        if buf[1] != 50u8 { return 24; }  // '2'
    }

    // @rule item.extern-block.abi-default-to-children
    // The extern "C" block above spliced `snprintf` into the module item stream
    // with the block's C ABI; the successful C-convention call confirms it.
    {
        let mut buf2: [u8; 8] = [0u8; 8];
        let fmt2: [u8; 3] = [37u8, 100u8, 0u8];
        unsafe {
            let w2: i32 = snprintf(&mut buf2[0] as *mut u8, 8i64,
                                   &fmt2[0] as *const u8, 7i32);
            if w2 != 1i32 { return 25; }
        }
        if buf2[0] != 55u8 { return 26; }  // '7'
    }

    return 0;
}
