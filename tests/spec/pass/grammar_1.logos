package grammar_1;

// Conformance test for the `grammar_1` rule group. Each rule is locked by
// EXECUTING a program whose observable result only holds if the grammar
// production it describes actually parses and lowers to the stated value.
//
// Most rules in this group are HRPC-IDL grammar productions (`grammar.hrpc.*`):
// they describe how a *.hrpc schema file is parsed by hrpc.peg — a separate
// IDL/schema language, NOT Logos source. A Logos `pass` program that compiles
// and runs cannot exercise the HRPC parser, so those are reported under
// "untestable". The Logos-source rules (Writ literals, `from` contextual
// keyword, `?Sized` relaxed bound, brace block) are locked here.

use logos.lang.writ.container;     // Writ
use logos.lang.writ.anyval;        // WAny
use logos.lang.writ.tmpl;          // capture-driven @{...} -> Rc<Writ>
use logos.lang.writ.static_view;   // WView2 reader
use logos.lang.writ.wstatic;       // WritStatic (capture-free @{...})
use logos.lang.rc;                 // Rc<Writ>

// `?Sized` relaxed bound: a generic accepting an unsized tail. Works for a
// sized type by value-ref and for the unsized `str` behind a reference.
struct Wrap<T: ?Sized> { val: T }
fn first_byte<T: ?Sized>(x: &T) -> *const u8 { return x as *const T as *const u8; }

fn main() -> i64 {

    // ── grammar.writ.scalar-values + grammar.writ.entry-key-kinds +
    //    grammar.writ.capture-placeholders ───────────────────────────────────
    // One captured map literal carries: string-key entries with each scalar
    // writ_val flavour (STRING, INTEGER, '-' INTEGER, FLOAT, true, null) and
    // capture placeholders ($ident and ${expr}). Reading each back through the
    // Writ runtime view confirms each grammar form lowered to its stated value.
    let id: i64 = 42i64;
    let doc: Rc<Writ> = @{
        "name": "widget",
        "n": 7,
        "neg": -3,
        "f": 1.5,
        "flag": true,
        "z": null,
        "cap_id": $id,
        "cap_expr": ${id + 1}
    };
    let h: &Writ = doc.deref();
    let v: WView2 = WView2 { base: 0 as *const u8 };
    let root: WAny = h.root();

    // @rule grammar.writ.scalar-values
    // STRING -> WRIT_STR; INTEGER -> WRIT_INT; '-' INTEGER -> WRIT_NEG_INT;
    // FLOAT -> WRIT_FLOAT; 'true' -> WRIT_BOOL; 'null' -> WRIT_NULL. Each scalar
    // reads back as exactly the value/kind its production assigns.
    {
        let s_name: WAny = v.map_get(root, "name");
        if !s_name.is_string() { return 1; }            // WRIT_STR
        let s_n: WAny = v.map_get(root, "n");
        if v.get_int(s_n) != 7i64 { return 2; }         // WRIT_INT
        let s_neg: WAny = v.map_get(root, "neg");
        if v.get_int(s_neg) != -3i64 { return 3; }      // WRIT_NEG_INT (negative)
        let s_flag: WAny = v.map_get(root, "flag");
        if !v.get_bool(s_flag) { return 4; }            // WRIT_BOOL true
        let s_z: WAny = v.map_get(root, "z");
        if !s_z.is_null() { return 5; }                 // WRIT_NULL
    }

    // @rule grammar.writ.capture-placeholders
    // '$' IDENT captures a named binding; '${' expr '}' captures an arbitrary
    // expression — both appear as runtime values in the parsed document.
    {
        let c_id: WAny = v.map_get(root, "cap_id");
        if v.get_int(c_id) != 42i64 { return 6; }       // $id captured -> 42
        let c_expr: WAny = v.map_get(root, "cap_expr");
        if v.get_int(c_expr) != 43i64 { return 7; }     // ${id+1} captured -> 43
    }

    // @rule grammar.writ.entry-key-kinds
    // A map key may be a quoted string (exercised above for every entry); the
    // entry production parses string-keyed entries and the reader resolves them
    // by key. (A '-' INTEGER / INTEGER key selects the integer-keyed TinyMap
    // flavour, a distinct container — see untestable note.) The presence of a
    // resolvable string-keyed entry confirms the STRING key arm.
    {
        let by_key: WAny = v.map_get(root, "name");
        if by_key.is_null() { return 8; }               // string key resolved
    }

    // ── grammar.writ.nested-at-optional ──────────────────────────────────────
    // A nested writ_map / writ_array inside a writ_val may be bare or '@'-prefixed
    // and the two forms are equivalent. Build two documents — one with a bare
    // nested map, one with an '@'-prefixed nested map — and confirm both nest and
    // read back identically.
    {
        // No captures ⇒ these are static @-literals (WritStatic); read the root
        // through a WView2 anchored at the static blob's base pointer.
        let bare: WritStatic = @{ "inner": { "k": 5 } };
        let atp:  WritStatic = @{ "inner": @{ "k": 5 } };
        let vb: WView2 = WView2 { base: bare.ptr };
        let va: WView2 = WView2 { base: atp.ptr };
        // @rule grammar.writ.nested-at-optional
        let ib: WAny = v.map_get(vb.root(), "inner");
        let ia: WAny = v.map_get(va.root(), "inner");
        if !ib.is_map() { return 9; }
        if !ia.is_map() { return 10; }
        let kb: WAny = v.map_get(ib, "k");
        let ka: WAny = v.map_get(ia, "k");
        if v.get_int(kb) != v.get_int(ka) { return 11; }   // bare == @-prefixed
        if v.get_int(kb) != 5i64 { return 12; }
    }

    // ── grammar.trait.relaxed-bound-sized-only ───────────────────────────────
    // `?Sized` is the only accepted relaxed bound; a `T: ?Sized` generic accepts
    // both a sized type and the unsized `str` behind a reference.
    {
        let n: i64 = 99i64;
        // @rule grammar.trait.relaxed-bound-sized-only
        let pn: *const u8 = first_byte::<i64>(&n);   // sized T
        let s: str = "hi";
        let ps: *const u8 = first_byte::<str>(s);    // unsized T behind &
        if pn == (0 as *const u8) { return 13; }
        if ps == (0 as *const u8) { return 14; }
    }

    // ── grammar.module.from-contextual-keyword ───────────────────────────────
    // `from` is a contextual keyword (only the import-source separator by
    // position): it remains usable as an ordinary identifier, and the `From::from`
    // / `i64::from` method named with that token resolves and runs.
    {
        let from: i64 = 5i64;          // `from` as an ordinary identifier binding
        let widened: i64 = i64::from(3i32);   // the `From::from` method
        // @rule grammar.module.from-contextual-keyword
        if from != 5i64 { return 15; }        // identifier usable
        if widened != 3i64 { return 16; }     // From::from resolved + ran
    }

    // ── grammar.block.brace ──────────────────────────────────────────────────
    // A block is `{ stmt* }`: a brace-delimited sequence of zero+ statements that
    // evaluates as an expression to its trailing value.
    {
        // @rule grammar.block.brace
        let blk: i64 = { let a: i64 = 10i64; let b: i64 = 20i64; a + b };
        if blk != 30i64 { return 17; }
    }

    return 0;
}
