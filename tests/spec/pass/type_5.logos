package type_5;

// Conformance test for the `type_5` rule group (type resolution). Each rule with
// a runtime-observable positive manifestation is locked here by EXECUTING a
// program whose result only holds if the rule is true. Pure error-path /
// turbofish-?Sized / CFG-slot / Writ-static internal rules are reported under
// "untestable" (they have no green-pass observable).

use logos.mem.boxed;
use logos.mem.string;

// ── helper traits / types ───────────────────────────────────────────────────
trait Animal { fn legs(&self) -> i64; }
struct Dog { n: i64 }
impl Animal for Dog { fn legs(&self) -> i64 { return self.n; } }

// `Self` type-param binding inside an impl
struct Holder { v: i64 }
impl Holder { fn get(self: &Self) -> i64 { return self.v; } }

// impl-Trait in param and return position
fn make() -> impl Animal { return Dog { n: 7i64 }; }
fn take(x: impl Animal) -> i64 { return x.legs(); }

// dyn Fn family (resolves to Closure)
fn call_dyn_fn(f: &dyn Fn(i64) -> i64, a: i64) -> i64 { return f(a); }

// dyn Trait + Send + Sync (auto-trait marker bits; dispatch unaffected)
fn via_auto(d: &dyn Animal + Send + Sync) -> i64 { return d.legs(); }

// closure-type literal `|P| -> R` in parameter position
fn run_closure(f: |i64| -> i64, x: i64) -> i64 { return f(x); }

// fn-ptr ABI identity: extern "C", default and extern "Rust"
fn plain(a: i64) -> i64 { return a + 1i64; }
fn use_default(f: fn(i64) -> i64, x: i64) -> i64 { return f(x); }
fn use_rust(f: extern "Rust" fn(i64) -> i64, x: i64) -> i64 { return f(x); }

// const-generic array length (integer literal as const-generic arg)
fn first<const N: usize>(a: [i64; N]) -> i64 { return a[0]; }

// SLICE_TYPE under a reference is a sized fat slice (carries len)
fn slice_len(s: &[i64]) -> i64 { return s.len(); }

fn main() -> i64 {

    // @rule type.ref.double-ref
    // `&&T` resolves to `&(&T)` (lexer collapses `&&`): a double reference derefs
    // twice back to the value.
    {
        let n: i64 = 42i64;
        let r: &i64 = &n;
        let rr: &&i64 = &r;
        if **rr != 42i64 { return 1; }
    }

    // @rule type.slice.sized-vs-unsized
    // A `[T]` written under a reference (SLICE_TYPE) resolves to a sized fat
    // Slice carrying a length, observable via `.len()`.
    {
        let arr: [i64; 5] = [1i64, 2i64, 3i64, 4i64, 5i64];
        if slice_len(&arr) != 5i64 { return 2; }
    }

    // @rule type.paren.transparent
    // `(T)` resolves structurally identical to `T`.
    {
        let p: (i64) = 11i64;
        if p != 11i64 { return 3; }
    }

    // @rule type.tuple.unit-and-elements
    // `()` resolves to the unit type; `(T1,...,Tn)` resolves to a tuple of the
    // element types, accessed positionally.
    {
        let u: () = ();
        let tup: (i64, i64) = (3i64, 4i64);
        if tup.0 + tup.1 != 7i64 { return 4; }
    }

    // @rule type.dyn.fn-family-is-closure
    // `dyn Fn(P) -> R` resolves directly to the Closure type {fn_ptr, env_ptr};
    // a closure stored behind `&dyn Fn` / `Box<dyn Fn>` is directly callable.
    {
        let c = |x: i64| -> i64 { return x * 2i64; };
        if call_dyn_fn(&c, 5i64) != 10i64 { return 5; }
        let bf: Box<dyn Fn(i64) -> i64> = box_new(|x: i64| -> i64 { return x + 100i64; });
        if bf(1i64) != 101i64 { return 6; }
    }

    // @rule type.dyn.auto-trait-and-lifetime-bounds
    // `dyn Trait + Send + Sync` sets marker bits on the trait object but does not
    // change dispatch identity; the concrete impl is still reached.
    {
        let d = Dog { n: 4i64 };
        if via_auto(&d) != 4i64 { return 7; }
    }

    // @rule type.closure-type.params-ret
    // A closure-type literal `|i64| -> i64` resolves to Closure with the listed
    // parameter and return types; a matching closure is callable through it.
    {
        if run_closure(|a: i64| -> i64 { return a + 1i64; }, 10i64) != 11i64 { return 8; }
    }

    // @rule type.fn-ptr.abi-identity
    // `fn(P) -> R` resolves to a single-pointer FnPtr; default ABI and
    // `extern "Rust"` normalize to the same identity, so one value is usable in
    // both. (A foreign `extern "C"` ABI is a *distinct* tagged identity — that
    // negative side is a compile-time rejection, see "untestable".)
    {
        let fd: fn(i64) -> i64 = plain;
        if use_default(fd, 1i64) != 2i64 { return 9; }
        if use_rust(fd, 1i64) != 2i64 { return 10; }
    }

    // @rule type.lit-int.const-generic-arg
    // An integer literal in type position resolves to an IntLit usable as a
    // const-generic argument (turbofish `::<4>`).
    {
        let arr: [i64; 4] = [9i64, 8i64, 7i64, 6i64];
        if first::<4>(arr) != 9i64 { return 12; }
    }

    // @rule type.array.length-forms
    // `[T; N]` length is determined by a literal integer (here `3`) and, in a
    // generic fn, by a symbolic const parameter name `N` bound to the call's
    // const-generic arg.
    {
        let a3: [i64; 3] = [7i64, 8i64, 9i64];
        if a3.len() != 3i64 { return 13; }
        let a2: [i64; 2] = [5i64, 6i64];
        if first::<2>(a2) != 5i64 { return 14; }   // length via symbolic const param N
    }

    // @rule type.impl-trait.param-desugar
    // `impl Trait` in parameter position desugars to a fresh synthetic generic
    // bounded by Trait; in return position it resolves to the ImplTrait type.
    // Both are dispatched to the concrete impl.
    {
        let m = make();                            // impl-Trait return
        if m.legs() != 7i64 { return 15; }
        if take(Dog { n: 9i64 }) != 9i64 { return 16; }   // impl-Trait param
    }

    // @rule type.name.self-typevar
    // `Self` resolves to the current Self type-param binding in scope (the impl's
    // receiver type).
    {
        let h = Holder { v: 5i64 };
        if h.get() != 5i64 { return 17; }
    }

    // @rule type.name.qualified-by-last-segment
    // A fully-qualified type `pkg.path.Type` is resolved by its final segment
    // alone; the package prefix is dropped.
    {
        let s: logos.mem.string.String = String::new();
        if s.len() != 0i64 { return 18; }
    }

    return 0;
}
