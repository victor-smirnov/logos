// @rule metaprog.quote-item.name-antiquot-forms
package metaprog_diag_2_quote_item_name_antiquot_form;

use logos.std.compiler.metaprog;
use logos.mem.collections.vec;
use logos.lang.writ.wstatic;
use logos.lang.writ.anyval;

#[metaprog_handler("gen_bad_name")]
fn gen_bad_name_hook(target_offset: u32) -> () {
    let bad: i32 = 7;
    let blob: QuoteItemBlob = quote_item! {
        struct #(bad) { n: u64 }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}

#[gen_bad_name]
struct Trigger { n: u64 }

fn main() -> i32 { return 0; }
