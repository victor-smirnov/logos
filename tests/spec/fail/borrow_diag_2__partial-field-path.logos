// @rule borrow.move.partial-field-path
package borrow_diag_2_partial_field_path;
use logos.mem.string;
struct Inner { s: String, t: String }
struct Outer { i: Inner }
fn consume(s: String) -> i64 { s.len() as i64 }
fn use_inner(i: Inner) -> i64 { i.t.len() as i64 }
fn main() -> i32 {
    let o = Outer { i: Inner { s: String::from("a"), t: String::from("bb") } };
    let n = consume(o.i.s);
    let w = use_inner(o.i);
    (n + w) as i32
}
