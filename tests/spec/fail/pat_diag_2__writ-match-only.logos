// @rule pat.writ.match-only
package pat_diag_2_writ_match_only;

use logos.lang.writ.anyval;
use logos.lang.writ.pat;
use logos.lang.writ.container;
use logos.lang.rc;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(1024);
    let h: &Writ = rc.deref();
    h.set_root(WAny::from(true));
    if let @true = rc {
        return 1i32;
    }
    return 0i32;
}
