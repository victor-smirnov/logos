// @rule trait.method.multi-trait-ambiguity
package trait_diag_2_multi_trait_method;

trait A {
    fn m(&self) -> i32;
}

trait B {
    fn m(&self) -> i32;
}

struct S {
    x: i32,
}

impl A for S {
    fn m(&self) -> i32 { return self.x; }
}

impl B for S {
    fn m(&self) -> i32 { return self.x + 1i32; }
}

fn main() -> i32 {
    let s = S { x: 1i32 };
    return s.m();
}
