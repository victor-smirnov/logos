// @rule expr.compound-assign.index-mut-dispatch
package expr_diag_6_compound_index_mut_dispatch;

struct Grid { a: i64, b: i64 }

impl Index<i64> for Grid {
    type Output = i64;
    fn index(self: &Grid, i: i64) -> &i64 {
        if i == 0i64 { &self.a } else { &self.b }
    }
}
impl IndexMut<i64> for Grid {
    fn index_mut(self: &mut Grid, i: i64) -> &mut i64 {
        if i == 0i64 { &mut self.a } else { &mut self.b }
    }
}

fn main() -> i32 {
    let mut g = Grid { a: 1i64, b: 2i64 };
    g[0i64] += true;
    return 0i32;
}
