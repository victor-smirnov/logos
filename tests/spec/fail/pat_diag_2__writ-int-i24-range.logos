// @rule pat.writ.int-i24-range
package pat_diag_2_writ_i24;

use logos.lang.writ.anyval;
use logos.lang.writ.pat;
use logos.lang.writ.container;
use logos.lang.rc;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(1024);
    let h: &Writ = rc.deref();
    h.set_root(WAny::from(99 as i56));
    match rc {
        @99999999 => { return 1i32; }
        _ => { return 0i32; }
    }
}
