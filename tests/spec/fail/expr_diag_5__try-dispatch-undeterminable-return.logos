// @rule expr.try.trait-dispatch-from-residual
package expr_diag_5_try_dispatch_undeterminable_return;

use logos.lang.ops;
use logos.lang.try_trait;

struct WrapErr {}
struct Wrap { v: i32 }

impl FromResidual<WrapErr> for Wrap {
    fn from_residual(_r: WrapErr) -> Wrap { return Wrap { v: 0i32 - 1i32 }; }
}

impl Try for Wrap {
    type Output = i32;
    type Residual = WrapErr;
    fn from_output(output: i32) -> Wrap { return Wrap { v: output }; }
    fn branch(self: Wrap) -> ControlFlow<WrapErr, i32> {
        return ControlFlow::Continue(self.v);
    }
}

fn main() -> i32 {
    let f = |w: Wrap| { let _v = w?; };
    return 0i32;
}
