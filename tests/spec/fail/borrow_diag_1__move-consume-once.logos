// @rule borrow.move.consume-once
package borrow_diag_1_move_consume_once;
struct Owned { val: i32 }
impl Drop for Owned { fn drop(self: &mut Owned) { } }
fn consume(o: Owned) -> i32 { return o.val; }
fn main() -> i32 {
    let x = Owned { val: 42i32 };
    let _ = consume(x);
    return consume(x);
}
