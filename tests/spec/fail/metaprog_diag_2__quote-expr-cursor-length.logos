// @rule metaprog.quote-expr.repeat-cursor-length-agree
package metaprog_diag_2_quote_expr_cursor_length;

use logos.std.compiler.metaprog;
use logos.lang.writ.wstatic;

fn build_expr() -> ExprBlob {
    let s: str = "a";
    let id: Ident = Ident::new(s);
    let xs: [Ident; 2] = [id, id];
    let ys: [Ident; 3] = [id, id, id];
    return quote_expr! { #( #xs + #ys ),* };
}

fn main() -> i32 { return 0; }
