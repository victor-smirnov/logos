// SOUNDNESS QUEUE row dst_method_receiver_no_reborrow_admits (tier 2, `admits`). a #[self_describing] DST method call takes no loan of its receiver: a live `&[u8]` view of `ar` survives `ar.resize(..)` (rustc E0502)
// Logos: compiles clean. BIR passes the receiver as `copy ar` — no `&*ar` / `&mut *ar` reborrow, so no loan is issued (try_method_on_dstref).
// rustc: refuses (E0502 on the twin with an elided `&self -> &[u8]`).
// fix hint: owner S8 (C-RES: the receiver adjustment is the method probe's); the S0-S7 gap triage 2026-10-01.
// A #[self_describing] DST method call lowers to a plain Call with a DstRef
// receiver arg — the elision tie + receiver conflict check must still apply:
// a live slot view rejects a &mut-self call (pkd invalidation contract).
package dst_method_receiver_no_reborrow_admits;
use logos.lang.marker;
use logos.lang.slice;

#[self_describing]
pub struct D { x: u32, tail: [u8] }
impl SelfDescribing for D {
    fn dst_len(self: *const D) -> i64 { return 4i64; }
}
impl D {
    pub fn data(self: &D, idx: u32) -> &[u8] {
        let _ = idx;
        let sp: *const D = self as *const D;
        return unsafe { slice_from_raw::<u8>(sp as *const u8, 4) };
    }
    pub fn resize(self: &mut D, n: u32) { self.x = n; }
}
fn poke(ar: &mut D) -> u8 {
    let v: &[u8] = ar.data(1u32);
    ar.resize(64u32);            // ERROR: v is a live view of ar
    return v[0];
}
fn main() -> i32 { return 0i32; }
