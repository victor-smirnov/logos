// SOUNDNESS QUEUE row double_ref_temp_arg_never_dropped (tier 1). THE TEMPORARY UNDER `&&<rvalue>` IS NEVER DROPPED.
//
// `peek(&&D { … })`: lower_unary's `&&` arm (the lexer's AND token rewritten as two borrows) spills the inner
// rvalue with a bare `addr_of_temp`, while the single `&` arm ten lines below routes the same rvalue through
// SemaChecker::materialize_recv_ref and is correct (h33, 1001). Priced as probe `dblrefmrr`, round record.
//
// Found 2026-09-14n-autoreftemp by hand program h39, measured on base b54c1160ae8e4066 43 and on the probed
// binary 15fbccc186107d4b 43 unarmed (identical). Rust: exit 0. Legality by reading; no rustc binary on this box.
// ⚠ THE ORACLE IS A DESTRUCTOR COUNT through a raw `*mut i64`: today 1, exit 1; correct 1001, exit 0.
package double_ref_temp_arg_never_dropped;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn peek(r: &&D) -> i64 { return r.v; }
fn body(p: *mut i64) -> i64 {
    let a: D = D { v: 1i64, c: p };
    let k: i64 = peek(&&D { v: 1000i64, c: p });
    return k - 1000i64 + a.v - 1i64;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = body(p);
    let got: i64 = unsafe { n };
    unsafe { printf("n=%ld r=%ld\n".as_ptr(), got, r); }
    if r != 0i64 { return 2i32; }
    if got != 1001i64 { return 1i32; }
    return 0i32;
}
