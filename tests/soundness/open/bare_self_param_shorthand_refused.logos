// SOUNDNESS QUEUE row bare_self_param_shorthand_refused (tier 3, `refuses`). Found 2026-09-26 while closing
// ord_default_minmax_over_ref_self_refused. `fn take(self) -> i32` / `fn bump(mut self) -> Self` is a syntax error: the
// parameter grammar has the `&self` / `&mut self` shorthand but not Rust's by-value `self` / `mut self` (std spells
// `self: Self` everywhere). rustc: exit 7.
package bare_self_param_shorthand_refused;
struct S { v: i32 }
impl S {
    fn take(self) -> i32 { return self.v; }
    fn bump(mut self) -> S { self.v = self.v + 1; return self; }
}
fn main() -> i32 { let s = S { v: 5 }; return s.bump().bump().take(); }
