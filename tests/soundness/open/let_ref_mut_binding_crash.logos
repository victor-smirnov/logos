// SOUNDNESS QUEUE row let_ref_mut_binding_crash (tier 2, `run 1`). Rust-parity audit 2026-09-26 (medium): `let ref mut a = expr;` failed in mlir_gen (binding never emitted) — tier 3 `refuses` until 2026-09-28.
// Re-observed 2026-09-28 (ADR 0030 S3.4a, one mlir match door): the binding is emitted and reads 42, but the temporary it borrows is NEVER DROPPED — `let` gives it no owner (rustc extends its lifetime to the enclosing block and drops it there). Owner: S3.4b, let / let-else on the match core's temporary-scrutinee hoist.
// FLS: fls_965wt48ooqyw fls_kflqez2mtbit fls_xjw82bujm148
// rustc: rustc --edition 2024 compiles cleanly; running the binary prints 'mid a=42', 'drop 42', 'after block', exit 0. Logos prints no 'drop 42' and exits 1.
package let_ref_mut_binding_crash;
extern fn printf(fmt: *const u8, ...) -> i32;
static mut DROPS: i64 = 0;
struct D { name: i64 }
impl Drop for D {
    fn drop(self: &mut D) {
        unsafe { DROPS += 1; printf("drop %ld\n".as_ptr(), self.name); }
    }
}
fn mk(n: i64) -> D { return D{name:n}; }
fn main() -> i32 {
    {
        let ref mut a = mk(42i64);
        unsafe { printf("mid a=%ld\n".as_ptr(), a.name); }
    }
    unsafe { printf("after block\n".as_ptr()); }
    if unsafe { DROPS } == 1 { 0i32 } else { 1i32 }
}
