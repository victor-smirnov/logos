package method_where_fn_bound_on_impl_param_refused;

struct Run<F> {
    f: F,
}

impl<F> Run<F> {
    fn go(self: &Self) -> i64
    where F: Fn(i64) -> i64
    {
        return (self.f)(2i64);
    }
}

fn main() -> i32 {
    let r = Run { f: |x: i64| x + 7i64 };
    if r.go() != 9i64 { return 1i32; }
    return 0i32;
}
// SOUNDNESS QUEUE row method_where_fn_bound_on_impl_param_refused (tier 3).
// Legal Rust: a method's where clause may bound a parameter of the enclosing impl.
// ⚠ No rustc binary on this box; the legality claim rests on reading the rule.
// TODAY refused: "expression-as-callee: receiver type 'F' is not callable". The SAME bound
// on the impl header (`impl<F: Fn(i64) -> i64> Run<F>`) compiles and runs 9, and a TRAIT
// bound in the same method-level position (`where T: Tr` on `impl<T> W<T>`) runs 5 — so the
// method where clause loses the `Fn` bound of an enclosing parameter. fold_where_bounds'
// "subject resolves in an enclosing scope" arm `continue`s without attaching the bound.
// Measured 2026-09-13f on 4cf0bf5e5e07b0cf (base) and 9e85182a92a2ea50 (landed), same sentence.
