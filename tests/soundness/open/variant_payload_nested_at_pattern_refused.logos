// SOUNDNESS QUEUE row variant_payload_nested_at_pattern_refused (tier 3, refuses). A LEGAL `@` BINDER
// NESTED INSIDE A VARIANT PAYLOAD IS REFUSED AS AN UNSUPPORTED CONSTRUCT.
//
// `match e { E::V(y @ W { .. }) => y.b, … }` — rustc 1.98.1 --edition 2024 compiles and runs it: k=3,
// n=2, exit 0. TODAY three diagnostics, the first being "pattern E::V: nested patterns inside
// enum-variant payloads are not yet supported; bind to a name and match in the body", then a cascade
// ("expected 1 bindings, got 0", "undefined variable 'y'").
// ⚠ THE SAME DOOR REFUSES THE `while let` SPELLING `while let Option::Some(y @ W { .. }) = o` with the
// same first sentence (hand program b05 of the same round), so the row is the DOOR, not this spelling.
// Unmoved by 2026-09-16f-atbind (identical on base and landed): reason 1, the refusal is in sema and
// no binder ever runs. Found 2026-09-16f (hand programs b04 / b05), rowed the same round.
// legality: rustc 1.98.1 twin measured (see rust/b04.rs)
package variant_payload_nested_at_pattern_refused;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
struct W { a: D, b: i64 }
enum E { V(W), Z }
fn g(p: *mut i64) -> i64 {
    let e: E = E::V(W { a: D { v: 2i64, c: p }, b: 3i64 });
    match e {
        E::V(y @ W { .. }) => { return y.b; }
        E::Z => { return 0i64; }
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, rd(p)); }
    if k != 3i64 { return 2i32; }
    if rd(p) != 2i64 { return 1i32; }
    return 0i32;
}
