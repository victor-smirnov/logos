// SOUNDNESS QUEUE row implicit_integer_widening_admitted (tier 4, `admits`). Feature-interaction audit 2026-09-26, cluster implicit-integer-widening-accepted: value-preserving integer widening is applied implicitly at call args, returns and binary operands (coerce.int.implicit-widening; documented, not a blessed divergence)
// Logos: compiles clean, no diagnostics
// rustc: error[E0308]: mismatched types x3 (i32 arg to an i64 param; u8 returned from a u32 fn) and error[E0277]: cannot add `u32` to `u8`
// corpus: tests/interactions/clusters/implicit-integer-widening-accepted/
// fix hint: policy decision first (bless in DIVERGENCES or retire); if retired, sema coercion site coerce.int.implicit-widening must refuse non-identical integer types.
package implicit_integer_widening_admitted;
fn f(x: i64) -> i64 { return x; }
fn g(x: u8) -> u32 { return x; }
fn main() -> i32 {
    let a: i32 = 3;
    let b: i64 = f(a);
    let c: u8 = 4;
    let d = c + g(c);
    if b != 3 { return 3; }
    if d != 8 { return 4; }
    return 0;
}
