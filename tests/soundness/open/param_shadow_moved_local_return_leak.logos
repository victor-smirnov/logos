// SOUNDNESS QUEUE row param_shadow_moved_local_return_leak (tier 1). A PARAMETER SHADOWED BY A LOCAL OF THE SAME NAME IS
// NEVER DESTROYED WHEN THE LOCAL IS MOVED BEFORE AN EXPLICIT `return`.
//
// `fn g(x: D) { let x = D{2}; return eatd(x); }`: moving the local records `x` in moved_vars_ BY NAME; the return's unwind
// asks the PARAMETER frame's `x` the same question (emit_frame_drops' eligible) and skips it. Rust 21, exit 0. TODAY 2 — the
// parameter leaks, exit 1. Found 2026-09-14p-shadowslot by hand program s35 on build b485f2200bf9f5a0 (unarmed); unmoved by
// shslot, CLOSED by its strict extension shslotx (the outer frame's record re-keyed while shadowed, restored at pop_scope).
// Legality by reading; no rustc binary.
package param_shadow_moved_local_return_leak;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn eatd(x: D) -> i64 { return x.v; }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn g(x: D, p: *mut i64) -> i64 {
    let x: D = D { v: 2i64, c: p };
    return eatd(x);
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    if g(D { v: 1i64, c: p }, p) != 2i64 { return 9i32; }
    if rd(p) != 21i64 { return 1i32; }
    return 0i32;
}
