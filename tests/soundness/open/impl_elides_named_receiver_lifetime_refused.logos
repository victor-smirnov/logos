// SOUNDNESS QUEUE row impl_elides_named_receiver_lifetime_refused (tier 3, refuses).
// The other direction of impl_names_elided_receiver_lifetime_refused: the trait
// NAMES the receiver's lifetime and the impl ELIDES it. Legal Rust for the same
// reason — elision expands the impl's `&self` to `&'a self` — and refused here:
//   impl Peek for R: method 'peek' does not match the trait declaration:
//   the receiver is declared '&'a R' and the impl declares '&R'
//
// TWO rows rather than one because the comparator's rule is symmetric in form
// but the two directions travel different halves of `_astrict` (`x.empty()`
// versus `y.empty()`), and a repair that expands elision on only one side would
// close one row and leave the other standing. See the sibling row's header for
// the site and for the alpha-rename control.
//
// FOUND and MEASURED 2026-09-09, both binaries, identical.
package impl_elides_named_receiver_lifetime_refused;

struct R {
    v: i64,
}

trait Peek {
    fn peek<'a>(self: &'a Self) -> &'a i64;
}

impl Peek for R {
    fn peek(self: &R) -> &i64 {
        return &self.v;
    }
}

fn main() -> i32 {
    let r: R = R { v: 42i64 };
    let p: &i64 = r.peek();
    if *p == 42i64 {
        return 0;
    }
    return 1;
}
