// SOUNDNESS QUEUE row aggregate_param_ref_field_borrow_returned_says_dangling_refused (tier 3).
// LEGAL PROGRAM REFUSED: `fn refs<'a>(p: (&'a L, &'a L)) -> Vec<&'a i64>` PUSHES `&p.0.value` AND RETURNS THE VEC.
//
// Legal Rust: `&p.0.value` borrows through `&'a L`, not the local `p`. Legality MEASURED with rustc 1.98.1 (foot of this file). TODAY refused,
// build 0230e503bd682184 43: "cannot return reference to local variable 'r': dangling reference". NOT this round's fact (unmoved under
// every name); found because a2elem made the same false sentence appear on fail fixture
// tests/imported/fail/nll/issue-62007-assign-differing-fields--t22 (its only fail-text change). Members, all refused on base:
// e01 (tuple of `&'a mut L`, `&mut p.0.value`), e07 (plain `return &p.0.value` — "reference to temporary value"), e08 (a
// struct parameter `Two<'a> { a: &'a L, .. }`), e09 (let-bound first). A direct `&'a mut L` / `&'a L` parameter (e02, e03, e05)
// compiles. Found: hand e04, round 2026-09-14l-storeedge.
package aggregate_param_ref_field_borrow_returned_says_dangling_refused;
struct L { value: i64 }
fn refs<'a>(p: (&'a L, &'a L)) -> Vec<&'a i64> {
    let mut r: Vec<&i64> = Vec::<&i64>::new();
    r.push(&p.0.value);
    r.push(&p.1.value);
    return r;
}
fn main() -> i32 {
    let a: L = L { value: 3i64 };
    let b: L = L { value: 4i64 };
    let v: Vec<&i64> = refs((&a, &b));
    return (*v[0u64] + *v[1u64]) as i32 - 7i32;
}
