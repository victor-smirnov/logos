package iterator_enumerate_tuple_item_refused;
use logos.mem.collections.vec;
fn main() -> i32 {
    let mut v: Vec<i32> = Vec::<i32>::new();
    v.push(7i32); v.push(8i32); v.push(9i32);
    let mut idx_sum: i64 = 0i64;
    let mut val_sum: i32 = 0i32;
    for (i, x) in v.iter().enumerate() {
        idx_sum += i;
        val_sum += *x;
    }
    if idx_sum != 3i64 { return 1i32; }
    if val_sum != 24i32 { return 2i32; }
    return 0i32;
}
