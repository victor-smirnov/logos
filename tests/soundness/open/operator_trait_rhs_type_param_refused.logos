// SOUNDNESS QUEUE row operator_trait_rhs_type_param_refused (tier 3, refuses). `impl Add<E> for D` — AN OPERATOR IMPL WHOSE RIGHT
// OPERAND TYPE IS NOT `Self` — IS REFUSED.
//
// Rust's `trait Add<Rhs = Self> { type Output; fn add(self, rhs: Rhs) -> Output; }` admits `impl Add<E> for D` and `impl Add<&D> for D`;
// `a + b` with `a: D, b: E` then calls it. logosc refuses the IMPL: "impl Add for D: method 'add' does not match the trait declaration:
// parameter 1 is declared 'D' and the impl declares 'E'" — stdlib/lang/ops/ops.logos declares `pub trait Add { fn add(self: Self, rhs: Self)
// -> Self; }`, with no Rhs type parameter. No row in docs/DIVERGENCES.md (A1-A17) or docs/spec covers the operator traits' Rhs (searched by
// construct: "Rhs", "operator", "Add<"), so by the standing rule the answer is Rust's. The `&D` spelling is refused with the same sentence
// ("the impl declares '&D'"). Found by hand programs v03 / v13 of round 2026-09-15f-consumeland; measured identical on base 7eb6735b16576c45
// 43 and on that landing. NOTE the dispatch site already reads a different right operand type (SemaChecker::lower_binop looks the impl up by
// {lt, rt}; lower_compound_assign's G160-5 comment handles `*Assign<Rhs>` for ShlAssign) — the refusal is the trait declaration's.
// rustc 1.98.1 --edition 2024 on the twin src/compiler/probes/2026-09-15f-consumeland/rust/v03_hetero_rhs_add.rs: compiles, runs, r=11 n=11.
package operator_trait_rhs_type_param_refused;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct E { v: i64, c: *mut i64 }
impl Drop for E { fn drop(self: &mut E) { unsafe { *self.c = *self.c + self.v; } } }
impl Add<E> for D {
    fn add(self: D, o: E) -> i64 {
        return self.v + o.v;
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut s: i64 = 0i64;
    {
        let a: D = D { v: 1i64, c: p };
        let b: E = E { v: 10i64, c: p };
        s = a + b;
    }
    let got: i64 = unsafe { n };
    unsafe { printf("s=%ld n=%ld\n".as_ptr(), s, got); }
    if s != 11i64 { return 2i32; }
    if got != 11i64 { return 1i32; }
    return 0i32;
}
