package generic_array_lit_typevar_elems_double_drop;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn two<T>(x: T, y: T) -> [T; 2] { return [x, y]; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
