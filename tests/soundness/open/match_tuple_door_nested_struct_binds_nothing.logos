// SOUNDNESS QUEUE row match_tuple_door_nested_struct_binds_nothing (tier 3). A struct
// pattern nested inside a TUPLE pattern — `match sv { (P { x, y }, z) => … }` — is legal
// Rust and TODAY is refused "undefined variable 'x'": the PAT_TUPLE door recurses into a
// WHITELIST of sub-pattern kinds (the same whitelist that 2026-09-09c measured as three
// kinds and 2026-09-09d widened by one, for `@`), and PAT_STRUCT is not in it, so the
// nested pattern binds nothing and the arm body cannot name its binders. The array twin
// `([a, b], c)` is refused with the identical sentence. Found by the pattern lattice,
// cells d_match_struct_in_tuple and d_match_arr_in_tuple. Rust: exit 0.
package match_tuple_door_nested_struct_binds_nothing;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let sv: (P, i64) = (P { x: 3i64, y: 2i64 }, 2i64);
    match sv {
        (P { x, y }, z) => { if x + y + z != 7i64 { return 1i32; } }
    }
    return 0i32;
}
