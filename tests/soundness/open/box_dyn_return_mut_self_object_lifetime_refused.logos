package box_dyn_return_mut_self_object_lifetime_refused;
use logos.mem.boxed;
trait Sh { fn area(&self) -> i64; }
struct Sq(i64);
impl Sh for Sq { fn area(&self) -> i64 { return self.0; } }
struct Gen { i: i64 }
impl Gen {
    fn nx(&mut self) -> Box<dyn Sh> { self.i += 1; return Box::new(Sq(self.i)); }
}
fn main() -> i32 {
    let mut g = Gen { i: 0 };
    let a = g.nx();
    let b = g.nx();
    return (a.area() + b.area() - 3) as i32;
}
