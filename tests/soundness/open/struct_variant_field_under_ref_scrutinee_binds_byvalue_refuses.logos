// OVER-REFUSAL, tier 3 — legal Rust, refused. A STRUCT-SHAPE variant pattern under a by-reference
// scrutinee, `match e { E::V { r } => { return E::V { r: *r }; } … }` with `e: &E<'a>`, must bind
// `r: &&'a i64` (default binding mode `ref`). logosc refuses the re-wrap with
//     E::V arg 0: expected &'s i64, got i64
// i.e. `*r` typed `i64`: the field was bound BY VALUE at its payload type, one reference short,
// and the expected side names the declaration's `'s`. Rust: legal, exit 14.
// Found 2026-09-13b-selfregion-land by a legal-shape battery program (A04, `impl E<'_>` with
// `fn again(&self) -> Self`); this free-fn control reproduces on the base binary
// a5088a6875e092aa, so it is not about `Self`. HYPOTHESIS, not measured: the binding mode may be
// lost where soundness_queue row variant_payload_nested_struct_sub_double_drops locates its own
// loss (the payload synth in `build_pattern_variant_data`). Root NOT read.
// Legality MEASURED with rustc 1.98.1: verdict at the foot of this file.
package struct_variant_field_under_ref_scrutinee_binds_byvalue_refuses;
enum E<'s> { V { r: &'s i64 }, N }
fn again<'a>(e: &E<'a>) -> E<'a> {
    match e {
        E::V { r } => { return E::V { r: *r }; }
        E::N => { return E::N; }
    }
}
fn main() -> i32 {
    let v: i64 = 14i64;
    let e = E::V { r: &v };
    match again(&e) {
        E::V { r } => { return *r as i32; }
        E::N => { return 1i32; }
    }
}
