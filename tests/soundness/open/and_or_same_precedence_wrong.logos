// SOUNDNESS QUEUE row and_or_same_precedence_wrong (tier 1, `run 0`). Rust-parity audit 2026-09-26 (critical): && and || parse at one precedence level (a || b && c groups wrong)
// FLS: fls_hish3qfmawd fls_ruy7e6yccsqk
// Logos: exit=0 -- Logos parses `&&`/`||` at one flat left-associative precedence level, so `true || false && false` groups as `(true || false) && false` = false.
// rustc: exit=1 -- rustc groups `&&` tighter than `||`: `true || (false && false)` = true.
// fix hint: grammar (logos.peg): give && higher precedence than ||.
package and_or_same_precedence_wrong;
unsafe fn main() -> i32 {
    let r: bool = true || false && false;
    if r { return 1; }
    return 0;
}
