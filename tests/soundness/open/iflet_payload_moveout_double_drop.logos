// SOUNDNESS QUEUE row iflet_payload_moveout_double_drop (tier 1). An 'if let
// Some(r) = o' binding whose value is MOVED OUT (passed by value to 'eat') is
// dropped in the callee AND again at the scrutinee's scope exit: the counter reads
// 2 where Rust drops exactly once (exit 1). 'match o { Some(r) => eat(r) }' is
// correct (once), and a binding that is only READ is correct (enum_payload_drop
// (4)) — the if-let lowering does not track the binding as the payload's owner.
// The same root, observed with 'if let Some(mut s)' + 's.v = ...': the drop at
// scope exit sees the UN-mutated payload (the binding is a copy) and the mutated
// copy is never dropped. Found 2026-09-06b (hand c14, t_iflet_*). Rust: exit 0.
package iflet_payload_moveout_double_drop;
struct R { i: *mut i64 }
impl Drop for R { fn drop(self: &mut R) { unsafe { *self.i = *self.i + 1i64; } } }
fn eat(r: R) -> i64 { return 1i64; }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let o: Option<R> = Option::Some(R { i: p });
        if let Option::Some(r) = o { let _k: i64 = eat(r); }
    }
    if c != 1i64 { return 1i32; }
    return 0i32;
}
