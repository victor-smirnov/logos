package guard_closure_moves_ref_mut_binding_admits;
use logos.lang.option;
fn main() -> i32 {
    let mut o: Option<i64> = Option::Some(4i64);
    match o {
        Option::None => { return 0i32; }
        ref mut foo if { let c = || { let bar = foo; let _ = bar.take(); }; c(); false } => { return 1i32; }
