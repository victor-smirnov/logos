// rustc: compiles and runs, exit 0
// fix hint: stdlib: blanket impl<E: Error> From<E> for Box<dyn Error>; the diagnostic also misnames the target as &dyn Error.
package question_op_box_dyn_error_refused; use logos.lang.result; use logos.lang.error; use logos.lang.option; use logos.mem.boxed; use logos.std.fmt; use logos.mem.string;
struct MyError { code: i32 }
impl Display for MyError { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return write!(f, "myerr"); } }
impl Error for MyError { fn source(&self) -> Option<&dyn Error> { return Option::<&dyn Error>::None; } }
fn inner(x: i32) -> Result<i32, MyError> { if x < 0i32 { return Result::<i32, MyError>::Err(MyError{code: x}); } return Result::<i32, MyError>::Ok(x); }
fn outer(x: i32) -> Result<i32, Box<dyn Error>> { let v: i32 = inner(x)?; return Result::<i32, Box<dyn Error>>::Ok(v); }
fn main() -> i32 { match outer(-5i32) { Result::Ok(_) => 1, Result::Err(_) => 0 } }
