// SOUNDNESS QUEUE row enum_user_drop_skips_payload_glue (tier 1). AN ENUM WITH
// A USER `impl Drop` AND AN OWNING PAYLOAD LEAKS THAT PAYLOAD AT EVERY SITE —
// INCLUDING THE PLAIN TOP-LEVEL LOCAL, which is the one site where the struct
// spelling of the same shape is correct.
//
// Measured 2026-09-08 on build 8e5f92705b285d29 43 (and again on the binary of
// this commit). Destructor count for `Noisy`, want 1 each:
//     enum local              got 0
//     enum as a struct field  got 0
//     enum assigned over      got 0
// The struct control `struct P1 { inner: Noisy } + impl Drop` reads 1 as a
// local on the same binary, so this is NOT replace_site_skips_field_drop_glue's
// shape: that row's local case is CORRECT.
//
// The site: the scope-exit path's enum branch is guarded
// `else if (k == K::Enum && drop_fn.empty())` — a user `drop_fn` disables the
// payload recursion BEFORE `top_level` is ever consulted, so an enum with a
// user Drop never walks its payload anywhere.
//
// NOT enum_payload_partial_move_leak: that row is a partial move in a match
// arm. This one has no match and no partial move — the payload is simply never
// reached.
//
// The program takes the count itself and returns 1 when it is wrong, so the
// queue gate's exit-code reader holds it.
package enum_user_drop_skips_payload_glue;
extern fn malloc(n: i64) -> *mut u8;
extern fn printf(f: *const u8, a: i64, b: i64) -> i32;

trait Drop { fn drop(self: Self); }
struct Noisy { n: i64, c: *mut i64 }
impl Drop for Noisy { fn drop(self: Noisy) { unsafe { self.c[0] = self.c[0] + 1i64; } } }

enum E { V(Noisy), N }
impl Drop for E { fn drop(self: E) { } }

unsafe fn main() -> i32 {
    let c: *mut i64 = malloc(8) as *mut i64;
    c[0] = 0i64;
    { let e: E = E::V(Noisy { n: 1i64, c: c }); }
    printf("enum with a user Drop, TOP-LEVEL LOCAL (want 1): %ld\n".as_ptr(), c[0], 0i64);
    if c[0] != 1i64 { return 1i32; }
    return 0i32;
}
