// SOUNDNESS QUEUE row refcell_replace_noncopy_refused (tier 3, `refuses`). Feature-interaction audit 2026-09-26, cluster refcell-replace-noncopy: RefCell::replace/swap move the old value out of a raw pointer, refused once T is not Copy
// Logos: error [fn RefCell$G1$N__replace]: cannot move out of '*g.value', which is behind a raw pointer; cannot move out of 'g.value': its owner implements Drop (E0509)
// rustc: RefCell::replace with a Drop type compiles and runs, exit 0 (reproduced with tests/interactions/clusters/refcell-replace-noncopy/pairs-7_52.rs)
// corpus: tests/interactions/clusters/refcell-replace-noncopy/
// fix hint: stdlib logos.lang.cell RefCell::replace/swap: use mem::replace / ptr::read+ptr::write through the raw pointer instead of a move out of the guard.
package refcell_replace_noncopy_refused;
use logos.lang.cell;
struct N { id: i32 }
impl Drop for N { fn drop(&mut self) { } }
fn main() -> i32 {
    let c = RefCell::new(N { id: 1 });
    let old = c.replace(N { id: 2 });
    if old.id == 1 && c.borrow().id == 2 { return 0i32; }
    return 1i32;
}
