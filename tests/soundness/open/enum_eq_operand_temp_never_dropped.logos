// SOUNDNESS QUEUE row enum_eq_operand_temp_never_dropped (tier 1). A DROPPABLE ENUM TEMPORARY OPERAND OF `==` IS NEVER DROPPED.
//
// `e == E::A(D { … })` routes to the enum's `eq` impl (G150-2 arm, lower_binop), which borrows both operands
// through `take_operand_ref`; its rvalue arm spills with a bare `addr_of_temp`. The same helper serves the TypeVar
// `==` arm and the `String == str` view (a `String::from(..) == "lit"` leaks 34 bytes under valgrind, hand h34).
// The PLACE twin `e == f` is correct (h37, 1001). Priced by probe `torhoist`: closes this program and h34.
// NEVER FIRED over the corpus.
//
// Found 2026-09-14n-autoreftemp by hand program h25, measured on base b54c1160ae8e4066 43 and on the probed
// binary 15fbccc186107d4b 43 unarmed (identical). Rust: exit 0. Legality by reading; no rustc binary on this box.
// ⚠ THE ORACLE IS A DESTRUCTOR COUNT through a raw `*mut i64`: today 1, exit 1; correct 1001, exit 0.
package enum_eq_operand_temp_never_dropped;
use logos.lang.cmp;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
impl Eq for D { fn eq(&self, other: &D) -> bool { return self.v > 0i64 && other.v > 0i64; } }
fn mk(v: i64, c: *mut i64) -> D { return D { v: v, c: c }; }
enum E { A(D), B }
impl Eq for E { fn eq(&self, other: &E) -> bool { return true; } }
fn body(p: *mut i64) -> i64 {
    let e: E = E::A(D { v: 1i64, c: p });
    if !(e == E::A(D { v: 1000i64, c: p })) { return 3i64; }
    return 0i64;
}

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = body(p);
    let got: i64 = unsafe { n };
    unsafe { printf("n=%ld r=%ld\n".as_ptr(), got, r); }
    if r != 0i64 { return 2i32; }
    if got != 1001i64 { return 1i32; }
    return 0i32;
}
