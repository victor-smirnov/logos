// fix hint: closure env / drop elaboration: by-move captures belong to the closure value and drop with it. May share a root with loop_local_move_closure_shares_slot_wrong.
package closure_move_capture_drop_delayed_wrong;
struct D { c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + 1i64; } } }
fn run_once<F: FnOnce() -> i64>(f: F) -> i64 { return f(); }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let d = D { c: p };
    let c = move || -> i64 { let _ = &d; return 42i64; };
    let r = run_once(c);
    if unsafe { n } != 1i64 { return 1i32; }
    return r as i32;
}
