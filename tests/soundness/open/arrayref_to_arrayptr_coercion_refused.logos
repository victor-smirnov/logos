package arrayref_to_arrayptr_coercion_refused;
fn f<'a>(x: &'a [&'a i64; 3]) -> *const [&'a i64; 3] {
    return x;
}
fn main() -> i32 {
    let v: i64 = 1i64;
    let a: [&i64; 3] = [&v, &v, &v];
    let p: *const [&i64; 3] = f(&a);
