// SOUNDNESS QUEUE row localvec_get_refused_by_stdlib_rule (tier 3, `refuses`).
// A LEGAL PROGRAM IS REFUSED WITH A SENTENCE ABOUT A TYPE IT DOES NOT USE.
//
// FOUND 2026-09-10c, the same enumeration. sema_expr.cpp's `lower_method_call`
// enforces the A16/A17 knot — "cannot move a non-Copy element out of `Vec` via
// `get`" — on ANY struct whose bare name is `Vec` and which has one type
// argument whose element is a move type.
//
// This package's `Vec` is its own, its `get` is its own and returns `i64` — it
// never touches the element at all. The compiler refuses the call, and the
// remedy it prints (`.borrow(i)`, `.remove(..)`, `.pop()`) names methods this
// type does not have. An over-refusal is the most expensive direction in this
// queue.
//
// Rust: no relationship between a crate-local `Vec` and `std::vec::Vec`;
// `v.get(0)` resolves to the inherent method and compiles. A16/A17 are
// canonised divergences ABOUT THE STDLIB CONTAINER — extending them coherently
// means the rule applies to `logos.mem.collections.vec.Vec`, not to a bare
// spelling.
//
// OBSERVED (`refuses`): rc 1,
//   error [fn main]: cannot move a non-Copy element out of `Vec` via `get`
//   (element type `Own` is not `Copy`) ...
// FIX = it compiles AND RUNS, exit 0.
package localvec_get_refused_by_stdlib_rule;

pub struct Own { p: *mut u8 }
impl Drop for Own { fn drop(&mut self) { } }

pub struct Vec<T> {
    head: T,
    n: i64,
}

impl<T> Vec<T> {
    fn get(&self, i: i64) -> i64 { return self.n; }
}

fn main() -> i32 {
    let v = Vec { head: Own { p: (0 as *mut u8) }, n: 4i64 };
    let k: i64 = v.get(0i64);
    if k != 4i64 { return 1i32; }
    return 0i32;
}
