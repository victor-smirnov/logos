// SOUNDNESS QUEUE row nested_ref_eq_compares_addresses_run (tier 1).
// WRONG ANSWER AT RUN TIME. `x == y` over `&&i64` (and over `&mut &i64`) compares the two ADDRESSES, so two
// references to two equal values answer false. Rust's `impl PartialEq<&B> for &A where A: PartialEq<B>` compares
// THROUGH every reference layer: 4 == 4, exit 7. The one-layer spelling `&i64 == &i64` already compares values
// (docs/DIVERGENCES.md "Recently caught up": `&T == &T` — now value-equality), so the nested layer is the same rule
// not yet applied, not a divergence. Found by round 2026-09-14f-thrurefland's hand battery (n01 n02) on base
// baa2a38e8b650fb3 43; spec expr.binop.pointer-equality names only the reference-to-primitive case.
// Rust: exit 7.
package nested_ref_eq_compares_addresses_run;
fn main() -> i32 {
    let a: i64 = 4i64;
    let b: i64 = 4i64;
    let ra: &i64 = &a;
    let rb: &i64 = &b;
    let x: &&i64 = &ra;
    let y: &&i64 = &rb;
    if x == y {
        return 7i32;
    }
    return 1i32;
}
