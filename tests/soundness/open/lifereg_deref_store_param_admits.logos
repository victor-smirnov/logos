package lifereg_deref_store_param_admits;
fn f<'a>(x: &'a i64, y: &i64) -> &'a i64 {
  let mut out: &i64 = x;
  { let d: &mut &i64 = &mut out; *d = y; }   // THE DEFECT: admitted, upstream E0621
  return out;
}
fn main() -> i32 { return 0i32; }
