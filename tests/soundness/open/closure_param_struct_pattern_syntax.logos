// SOUNDNESS QUEUE row closure_param_struct_pattern_syntax (tier 3). A struct pattern as a
// CLOSURE PARAMETER — `|P { x, y }: P| -> i64` — is legal Rust and TODAY it is a SYNTAX
// ERROR, "syntax error near 'P'" (rc 4, before sema): the closure-parameter grammar rule
// admits a bare identifier and a tuple pattern and nothing else. The same is true of the
// tuple-struct, array and `@` spellings at that position. ONE ROW for the grammar rule;
// those four spellings are its members. Found by the pattern lattice, cells
// a_closure_struct_sh / a_closure_tstruct / a_closure_arr_fixed / a_closure_at_wild.
// ⚠ CORRECTED 2026-09-06h, MEASURED: this header used to claim "and of ALL of them at the
// function-parameter position". False for the struct spelling — `pat_param` (logos.peg:1724)
// IS an alternative of `param`, so `fn probe(P { x, y }: P)` compiles clean and runs
// correctly today. The fn-param position's own grammar gaps are tuple-struct and `@`
// (cells a_fnparam_tstruct / a_fnparam_at_*); its array spelling PARSES and binds nothing,
// which is the separate row fnparam_array_pattern_binds_nothing.
// Rust: exit 0.
package closure_param_struct_pattern_syntax;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let p: P = P { x: 3i64, y: 4i64 };
    let f = |P { x, y }: P| -> i64 { return x + y; };
    if f(p) != 7i64 { return 1i32; }
    return 0i32;
}
