package trait_impl_header_where_bound_dropped_refused;

trait Tr {
    fn t(self: &Self) -> i64;
}

impl Tr for i64 {
    fn t(self: &Self) -> i64 {
        return *self;
    }
}

trait Sum {
    fn sum(self: &Self) -> i64;
}

struct P<X, Y> {
    x: X,
    y: Y,
}

impl<X, Y> Sum for P<X, Y>
where X: Tr, Y: Tr
{
    fn sum(self: &Self) -> i64 {
        return self.x.t() + self.y.t();
    }
}

fn main() -> i32 {
    let p = P { x: 1i64, y: 2i64 };
    if p.sum() != 3i64 { return 1i32; }
    return 0i32;
}
// SOUNDNESS QUEUE row trait_impl_header_where_bound_dropped_refused (tier 3).
// Legal Rust: a where-clause on a trait impl header bounds the impl's parameters exactly
// as `impl<X: Tr, Y: Tr>` does. TODAY refused: "type parameter 'X' has no trait bound
// providing method 't'" (and the same for 'Y'). Writing the bounds inline
// (`impl<X: Tr, Y: Tr> Sum for P<X, Y>`) compiles. A trait impl reads its params with
// `read_type_params_from(node, IMPL_TYPE_PARAMS)`, which does not call
// `fold_where_bounds` (its own comment says so); collect_impl's own WHERE pass keeps only
// lifetime outlives. Measured 2026-09-13e on build 4cf0bf5e5e07b0cf (unarmed hand L_w10).
