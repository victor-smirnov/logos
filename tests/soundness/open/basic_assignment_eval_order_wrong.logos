// fix hint: mlir_gen assignment lowering: evaluate the RHS first, then the assignee place.
package basic_assignment_eval_order_wrong;
extern fn printf(fmt: *const u8, ...) -> i32;
fn side(tag: i32) -> i32 { unsafe { printf("%d ".as_ptr(), tag); } return tag; }
unsafe fn main() -> i32 {
    let mut arr: [i32; 3] = [0i32, 0i32, 0i32];
    arr[side(1) as usize] = side(2);
    printf("\n".as_ptr());
    return 0i32;
}
