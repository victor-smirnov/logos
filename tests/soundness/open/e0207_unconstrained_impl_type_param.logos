// SOUNDNESS QUEUE row e0207_unconstrained_impl_type_param (tier 2, admits).
// The TYPE half of E0207. `U` is an impl generic parameter constrained by
// neither the trait reference (`Tr` takes no arguments) nor the self type (`S`
// is not generic) nor any predicate, and rustc refuses this ALWAYS —
//   error[E0207]: the type parameter `U` is not constrained by the impl trait,
//   self type, or predicates
// — where for a LIFETIME the same error fires only when an associated type
// names it. logosc compiles it clean.
// MEASURED 2026-09-11, the same round that landed the LIFETIME half at
// src/compiler/sema_decl.cpp::lower_impl_block. That landing is deliberately
// narrow: a census counter at the site, over 9839 .logos files and 6,341,664
// impl-lowering arrivals, read ZERO unconstrained type parameters in the whole
// tree — the known-answer control being this very program, which makes the same
// counter read 2. So the half was declined on a measured population of 0 rather
// than on a reading, and this row is the carrier that keeps it findable.
// PROBES.md 2026-09-11b.
package e0207_unconstrained_impl_type_param;
struct S { n: i64 }
trait Tr { type Item; fn go(self: Self) -> i64; }
impl<U> Tr for S {
    type Item = U;
    fn go(self: Self) -> i64 { return 5i64; }
}
// `main` does NOT call `go`: the unconstrained `U` makes the method generic in a
// parameter no receiver can determine, and a call is refused as "could not infer
// type arguments" — a SECOND defect downstream of this one, which would hide the
// admission behind an unrelated refusal. The claim here is that the IMPL is
// accepted at all.
fn main() -> i32 { return 0i32; }
