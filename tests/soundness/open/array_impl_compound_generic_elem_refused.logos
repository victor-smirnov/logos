// SOUNDNESS QUEUE row array_impl_compound_generic_elem_refused (tier 3, `refuses`).
// `impl<T> Tr for [Option<T>; 2]` is refused ("impl over an array whose element
// is a compound generic type is not supported"). Legal Rust (exit 7). The `$array$`
// impl keys spell a generic element only as a bare parameter (`$array$T$N`), and
// mono's receiver-side binding fills impl slots positionally from the element and
// length; a compound element needs the impl pattern unified with the receiver.
package array_impl_compound_generic_elem_refused;
trait Tr { fn n(&self) -> i64; }
impl<T> Tr for [Option<T>; 2] { fn n(&self) -> i64 { return 7i64; } }
fn main() -> i32 { let a = [Some(1i64), None]; return a.n() as i32; }
