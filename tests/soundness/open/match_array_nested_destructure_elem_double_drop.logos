// SOUNDNESS QUEUE row match_array_nested_destructure_elem_double_drop (tier 1, run 1). AN ARRAY
// PATTERN WHOSE ELEMENT IS DESTRUCTURED (not bound whole) DOUBLE-DESTROYS THE MOVED-OUT FIELD.
//
// `match arr { [W { a: x, b: _ }] => { return x.v; } }` over `[W; 1]`: rustc moves field `a` out of
// element 0, destroys x (1) and then the element's surviving field b (2) — n = 12, exit 0 (twin
// h15_nested_destructure_elem.rs, MEASURED rustc 1.98.1). TODAY n = 112: x is destroyed, then the
// array's scope-exit drop destroys BOTH fields of element 0 again, field a included.
// NOT the per-element fact of round 2026-09-16c-armelem, and deliberately outside it: that round
// marks an element moved only for a PLAIN named binder, because a nested sub-pattern may move only
// PART of its element and a whole-element mark would leak the rest (field b here). Closing this row
// needs a per-FIELD path under the element index (`arr.0.a`), which the drop walk already supports
// but the match-arm door does not yet compute. Measured under that round's landed binary: n = 112,
// unchanged. Found 2026-09-16c-armelem by hand program h15.
package match_array_nested_destructure_elem_double_drop;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct W { a: D, b: D }
fn g(p: *mut i64) -> i64 {
    let arr: [W; 1] = [W { a: D { v: 1i64, c: p }, b: D { v: 2i64, c: p } }];
    match arr {
        [W { a: x, b: _ }] => { return x.v; }
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    let got: i64 = unsafe { n };
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 1i64 { return 2i32; }
    if got != 12i64 { return 1i32; }
    return 0i32;
}
