package vec_push_ifarm_after_loan_last_use_refused;
fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    v.push(1i64);
    v.push(2i64);
    let c: bool = v.len() > 1i64;
    let e: &i64 = &v[1u64];
    if c {
        let x: i64 = *e;
        v.push(x);
    }
    return (v.len() - 3i64) as i32;
}
