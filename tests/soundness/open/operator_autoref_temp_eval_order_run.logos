// SOUNDNESS QUEUE row operator_autoref_temp_eval_order_run (tier 1). AN OPERATOR OPERAND TEMPORARY MUST BE
// CONSTRUCTED IN SOURCE ORDER AND DESTROYED AT THE END OF ITS TEMPORARY SCOPE.
//
// `if !(*pick(&a, s) == mk(2, s))`: a sequence counter appends 1 when `pick` runs, 2 when the temporary is built
// and 6 when it is destroyed. Rust evaluates the left operand first and drops the temporary at the end of the `if`
// condition: 126, exit 0. TODAY 12, exit 1 — the temporary is never destroyed (the defect of row
// operator_autoref_temp_never_dropped).
//
// ⚠ THIS ROW EXISTS TO HOLD A FIX TO RUST'S ORDER. Every crude arm priced in round 2026-09-14n-autoreftemp that
// closes the leak (oprhoist, autorefhoist, oprmrr — the statement-temp hoist that materialize_recv_ref gives a
// receiver) reads 216: `hoist_stmt_temp` prepends `let __rtmp = mk(2)` BEFORE the statement, so the right operand is
// built before the left operand's call runs. The count oracle of the parent row cannot see that; this one can.
// The receiver door is not reordered by the same hoist because a receiver is evaluated first anyway.
//
// Found 2026-09-14n-autoreftemp by hand program h31; base b54c1160ae8e4066 43 reads 12, armed 216. Rust: exit 0.
// Legality by reading; no rustc binary on this box.
package operator_autoref_temp_eval_order_run;
use logos.lang.cmp;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, s: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.s = *self.s * 10i64 + self.v + 4i64; } } }
impl Eq for D { fn eq(&self, other: &D) -> bool { return self.v > 0i64 && other.v > 0i64; } }
fn mk(v: i64, s: *mut i64) -> D {
    unsafe { *s = *s * 10i64 + v; }
    return D { v: v, s: s };
}
fn pick<'a>(d: &'a D, s: *mut i64) -> &'a D {
    unsafe { *s = *s * 10i64 + 1i64; }
    return d;
}
fn main() -> i32 {
    let mut q: i64 = 0i64;
    let s: *mut i64 = &mut q;
    let mut got: i64 = 0i64;
    {
        let a: D = D { v: 3i64, s: s };
        if !(*pick(&a, s) == mk(2i64, s)) { return 3i32; }
        got = unsafe { q };
    }
    unsafe { printf("seq_before_scope_end=%ld\n".as_ptr(), got); }
    if got != 126i64 { return 1i32; }
    return 0i32;
}
