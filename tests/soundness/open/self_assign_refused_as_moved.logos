// SOUNDNESS QUEUE row self_assign_refused_as_moved (tier 3, `refuses`). `x = x;`
// ON A MOVE TYPE IS REFUSED "use of moved variable 'x'".
//
// Legal Rust: the right-hand side is evaluated first (moving out of `x`) and the
// assignment then RE-INITIALISES `x`, so the binding is live again. rustc accepts
// it — clippy's `self_assignment` lint exists precisely because the code compiles.
// The value must still be dropped exactly once.
//
// TODAY the assignment's own RHS read is judged against a move the same statement
// performs: the name is marked moved before the store re-initialises it. The same
// re-initialisation IS handled for a different source (`let mut x = A;
// let k = eat(x); x = B;` compiles and drops both — lattice cell e_reinit_after_move,
// 1001), so the defect is in the ordering of the mark against the write on ONE
// statement, not in the notion of re-initialisation.
//
// ⚠ FOR AN OWNER: this is the one row in the 2026-09-06 ownership batch whose
// Rust verdict was NOT checked against rustc — there is no rustc on this box. The
// evidence for legality is the existence of the clippy lint. If the owner reads it
// the other way, this row retires rather than being bought.
//
// Measured 2026-09-06, lattice cell e_self_assign. Rust: compiles, exit 0.
package self_assign_refused_as_moved;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut r: i64 = 0i64;
    {
        let mut x: D = D { v: 1i64, c: p };
        x = x;
        r = x.v;
    }
    if r != 1i64 { return 2i32; }
    let got: i64 = unsafe { n };
    if got != 1i64 { return 1i32; }
    return 0i32;
}
