// SOUNDNESS QUEUE row assign_tuple_elem_no_drop_old (tier 1). ASSIGNING A TUPLE
// ELEMENT DOES NOT DROP THE VALUE THAT WAS THERE.
//
// Rust: `t.0 = new` drops t.0's old value at the assignment. Expected
// 1 (old t.0) + 1000 (new t.0) + 10 (t.1) = 1011. TODAY the count is 1010.
//
// ROOT: the same one predicate as assign_index_elem_no_drop_old — `field_old_live`
// is computed under `if (pc == la::FIELD_READ)` only, and this place is
// `la::TUPLE_INDEX`. The NAMED-field spelling of the identical shape is correct
// (`w.d = new` drops the old field, lattice cell c_assign_field, 1001), which is
// what says the arm exists and is reached through a fact the code does not carry.
//
// Measured 2026-09-06, lattice cell c_assign_tuple_elem. Rust: exit 0.
package assign_tuple_elem_no_drop_old;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut r: i64 = 0i64;
    {
        let mut t: (D, D) = (D { v: 1i64, c: p }, D { v: 10i64, c: p });
        t.0 = D { v: 1000i64, c: p };
        r = t.0.v;
    }
    if r != 1000i64 { return 2i32; }
    let got: i64 = unsafe { n };
    if got != 1011i64 { return 1i32; }
    return 0i32;
}
