// OVER-REFUSAL, tier 3 — legal Rust, refused. `Self(x)` constructs a tuple struct
// inside its own impl (legal since Rust 1.32). logosc refuses with
//     error [fn T__mk]: call to undefined function 'Self'
// CONTROL: the same body spelled `T(x)` compiles and runs 53.
// Found 2026-09-13a-selfregion enumerating the sites that decide what a name spelled
// `Self` denotes (tools/dlog/self_denote.dl): the struct-literal, enum-literal and
// `Self::V(..)` sites rewrite the spelling; the CALL-callee path has no such arm.
package self_tuple_struct_ctor_refused;
struct T(i64);
impl T {
    fn mk(x: i64) -> Self {
        return Self(x);
    }
}
fn main() -> i32 {
    let t = T::mk(53i64);
    return t.0 as i32;
}
