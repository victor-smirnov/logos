// SOUNDNESS QUEUE row aggregate_literal_temp_place_base_never_dropped_run (tier 1). AN ARRAY OR TUPLE LITERAL USED AS A TEMPORARY
// PLACE BASE IS NEVER DROPPED.
//
// `let k = [D { v: 1 }, D { v: 10 }][1].v;` builds a temporary `[D; 2]`, reads a Copy field through it and must drop the temporary
// at the end of the statement: Rust 11, exit 0. TODAY 0, exit 1 (a leak; with a heap payload the payload is lost). Measured on
// base 7eb6735b16576c45 43, round 2026-09-15f-consumeland, together with shapes of the same SYMPTOM (a shared symptom is not yet a
// shared defect): `[..].len()` receiver 0, `for d in [..]` 0, `&[..]` as a `let r: &[D; 2]` initialiser 0, `{ [..] }[0].v` 0,
// `(D, D).1.v` tuple 0 — Rust 11 each. A STRUCT literal in the same position is dropped (`D { .. }.v` 1, `W { x: a, y: b }.z` 11).
// DOOR UPSTREAM OF THE ARRAY-LITERAL CONSUMPTION MARK: with `a`, `b` locals, `[a, b][1].v` / `[a, b].len()` / `for d in [a, b]` /
// `&[a, b]` / `[a; 1][0].v` read 11 on base only BY CANCELLATION (the locals drop at their own scope exit, the temporary never);
// marking the elements moved at SemaChecker::lower_arr_lit (the fix for return_array_lit_of_moved_locals_double_drop) turns each of
// them into this leak (measured 11 -> 0), so that fix waits on this row. The tuple spelling already reads 0 with locals on base,
// because TUPLE_LIT marks its elements. Site hypothesis, read not measured: the statement temp owner (SemaChecker::autoref_operand /
// materialize_recv_ref / hoist_stmt_temp) is reached for an auto-ref'd receiver or operator operand, not for an IndexRead /
// TupleIndex base, a for-each iterable or an extended `&` of an aggregate literal.
// rustc 1.98.1 --edition 2024 on the twin src/compiler/probes/2026-09-15f-consumeland/rust/aggregate_literal_temp_place_base_never_dropped_run.rs: compiles, runs, n=11.
package aggregate_literal_temp_place_base_never_dropped_run;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut k: i64 = 0i64;
    {
        k = [D { v: 1i64, c: p }, D { v: 10i64, c: p }][1].v;
    }
    let got: i64 = unsafe { n };
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 10i64 { return 2i32; }
    if got != 11i64 { return 1i32; }
    return 0i32;
}
