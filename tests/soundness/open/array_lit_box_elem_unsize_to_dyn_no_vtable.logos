// SOUNDNESS QUEUE row array_lit_box_elem_unsize_to_dyn_no_vtable (tier 3). `let arr: [Box<dyn Tr>; 2] = [b1, b2];` with `b1, b2: Box<D>`
// is refused by the BACKEND: "mlir_gen: internal: no vtable for 'Box$G1$D' as '&dyn Tr' — the fat pointer's vtable half would be left
// uninitialised", compile exit 1 with no `error` line. Legal Rust (each element unsizes Box<D> -> Box<dyn Tr>): 11, exit 0.
// Same sentence family as boxdyn_mutborrow_arg_no_vtable / rcdyn_borrow_arg_no_vtable; a shared root is NOT measured. Found by hand program e09
// of round 2026-09-15e-consume. rustc 1.98.1 --edition 2024 on the twin src/compiler/probes/2026-09-15e-consume/rust/array_lit_box_elem_unsize_to_dyn_no_vtable.rs: compiles, runs, exit 0.
package array_lit_box_elem_unsize_to_dyn_no_vtable;
struct D { v: i64 }
trait Tr { fn get(self: &Self) -> i64; }
impl Tr for D { fn get(self: &D) -> i64 { return self.v; } }
fn main() -> i32 {
    let b1: Box<D> = Box::new(D { v: 1i64 });
    let b2: Box<D> = Box::new(D { v: 10i64 });
    let arr: [Box<dyn Tr>; 2] = [b1, b2];
    if arr[0].get() + arr[1].get() != 11i64 { return 1i32; }
    return 0i32;
}
