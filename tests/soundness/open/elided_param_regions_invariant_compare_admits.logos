// FIX = refused with a region sentence, while r13 (`*mut &'a i64` on both sides) keeps compiling.
package elided_param_regions_invariant_compare_admits;

fn f(x: *mut &i64, y: *mut &i64) -> bool {
    return x == y;
}

fn main() -> i32 {
    return 0i32;
}
