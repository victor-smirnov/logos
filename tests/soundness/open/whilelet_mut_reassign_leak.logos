// SOUNDNESS QUEUE row whilelet_mut_reassign_leak (tier 1). 'while let Some(mut s)
// = v.pop()' then 's = S { .. }': the reassignment drops the popped value (once,
// correct) but the NEW value assigned to 's' is never dropped at the end of the
// iteration — the counter reads 1 where Rust reads 1 + 7 = 8 (exit 1). The same
// shape under 'match' ('E::A(mut s) => { s = ..; }') drops both. Compiles only
// since 2026-09-06b carried the pattern 'mut' (before: refused "assignment to
// immutable variable", the wrong reason). Found 2026-09-06b (hand t_drop_whilelet).
package whilelet_mut_reassign_leak;
use logos.mem.collections.vec;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let mut vs: Vec<S> = Vec::new();
        vs.push(S { v: 1i64, i: p });
        while let Option::Some(mut s) = vs.pop() {
            s = S { v: 2i64, i: p };
            s.v = s.v + 5i64;
        }
    }
    if c != 8i64 { return 1i32; }
    return 0i32;
}
