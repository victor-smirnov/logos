// SOUNDNESS QUEUE row let_ref_bind_temp_never_dropped (tier 1). `let ref y = <rvalue>;` NEVER DROPS THE VALUE.
//
// lower_let's P4-pm-14 arm calls `let ref y = e` sugar for `let y = &e` and lowers it as a bare
// `addr_of_temp`, but the extension arm that gives `let y = &e` its named `__lit_temp_N` owner (C6-cc-04 / T0-4,
// same function) only recognises a UNARY `&` / ADDR_OF_MUT initializer, so the sugar never reaches it. Rust extends
// the value to the end of the block and drops it there; `let y = &D { … }` is correct today (h32, 1001). A
// statement-scope hoist is the WRONG owner here (it would drop before `y` is read). Priced as probe `letrefext`.
//
// Found 2026-09-14n-autoreftemp by hand program h41, measured on base b54c1160ae8e4066 43 and on the probed
// binary 15fbccc186107d4b 43 unarmed (identical). Rust: exit 0. Legality by reading; no rustc binary on this box.
// ⚠ THE ORACLE IS A DESTRUCTOR COUNT through a raw `*mut i64`: today 1, exit 1; correct 1001, exit 0.
package let_ref_bind_temp_never_dropped;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn body(p: *mut i64) -> i64 {
    let a: D = D { v: 1i64, c: p };
    {
        let ref y = D { v: 1000i64, c: p };
        if y.v != 1000i64 { return 3i64; }
    }
    return a.v - 1i64;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = body(p);
    let got: i64 = unsafe { n };
    unsafe { printf("n=%ld r=%ld\n".as_ptr(), got, r); }
    if r != 0i64 { return 2i32; }
    if got != 1001i64 { return 1i32; }
    return 0i32;
}
