// SOUNDNESS QUEUE row rawptr_tuple_eq_no_eq_impl_refused (tier 3).
// LEGAL RUST REFUSED. Raw pointers implement PartialEq/Eq (address equality), so a tuple of them compares: `(p, 1)
// == (p, 1)` is true. logosc refuses "'variadic__eq': type '*mut i64' does not implement trait 'Eq' required by
// parameter 'A'" — `==` on the bare pointers compiles (sema's operator arm), but no trait impl exists for the
// tuple / Option / struct-derive paths to call. Same refusal for `Option<*mut T>` (hand q05's legal twin).
// Found by round 2026-09-14f-thrurefland (hand n06) on base baa2a38e8b650fb3 43. Rust: exit 4.
// MEASURED 2026-09-24, the obvious repair and why it is not one: adding
// `impl<T> Eq for *mut T` / `*const T` to stdlib/lang/cmp hits two further
// defects of GENERIC IMPLS OVER A RAW-POINTER TARGET — `Self` is an "unknown
// type" inside such an impl (`&self`, `other: &Self`), and with the types spelled
// out the impl still never satisfies a `T: Eq` bound (check_type_bounds keys
// Ref targets `$ref_…` and fn pointers `$fnptr$N`, raw pointers not at all).
package rawptr_tuple_eq_no_eq_impl_refused;
fn main() -> i32 {
    let mut v: i64 = 1i64;
    let p: *mut i64 = &mut v as *mut i64;
    let t1: (*mut i64, i64) = (p, 1i64);
    let t2: (*mut i64, i64) = (p, 1i64);
    if t1 == t2 {
        return 4i32;
    }
    return 1i32;
}
