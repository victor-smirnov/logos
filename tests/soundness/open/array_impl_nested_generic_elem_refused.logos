// SOUNDNESS QUEUE row array_impl_nested_generic_elem_refused (tier 3, `refuses`).
// `impl<T> Tr for [Option<Vec<T>>; 2]` is refused. Legal Rust (exit 9). The
// `$array$` impl keys spell a generic element as a bare parameter (`T`) or a head
// over bare parameters (`Option<_>`), derivable from a concrete element; a
// parameter nested below the head needs a key that a concrete `Option<Vec<i64>>`
// can be matched to without knowing which positions the impl left generic —
// i.e. candidate selection by pattern unification, not by a spelled key.
package array_impl_nested_generic_elem_refused;
use logos.mem.collections.vec;
trait Tr { fn n(&self) -> i64; }
impl<T> Tr for [Option<Vec<T>>; 2] { fn n(&self) -> i64 { return 9i64; } }
fn main() -> i32 { let a: [Option<Vec<i64>>; 2] = [None, None]; return a.n() as i32; }
