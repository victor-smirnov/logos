// SOUNDNESS QUEUE row shadow_outer_frame_over_moved_name_refused (tier 3, `refuses`). A MATCH-ARM BINDING NAMED LIKE A MOVED
// OUTER LOCAL IS REFUSED AS "use of moved variable 'x'".
//
// `let x = D{1}; eatd(x); match o { Some(x) => { x.v } }` is legal Rust: the arm introduces a NEW binding. The outer-frame
// twin of shadow_rebind_after_move_refused — moved_vars_ is keyed by the NAME and the arm's define() does not clear it. Same
// refusal for a closure parameter (hand s34) and an inner-block `let` (hand s31, s33). The ABUSE direction the fix must hold:
// the outer binding's moved state must come BACK when the arm pops, or the outer value is destroyed a second time.
// Found 2026-09-14p-shadowslot by hand program s32 on build b485f2200bf9f5a0; compiles and reads 12 (Rust) under shslot,
// shframe, shmoved and shslotx. Legality by reading; no rustc binary. Rust: exit 0.
package shadow_outer_frame_over_moved_name_refused;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn eatd(x: D) -> i64 { return x.v; }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    {
        let x: D = D { v: 1i64, c: p };
        let k: i64 = eatd(x);
        let o: Option<D> = Option::Some(D { v: 2i64, c: p });
        match o {
            Option::Some(x) => { if x.v + k != 3i64 { return 9i32; } },
            Option::None => {}
        }
    }
    if rd(p) != 12i64 { return 1i32; }
    return 0i32;
}
