package vec_box_invariant_in_t_refused;
static G: i64 = 7i64;
fn shorter<'a>(v: &'a Vec<&'static i64>) -> &'a Vec<&'a i64> {
    return v;
}
fn count<'a>(v: &Vec<&'a i64>, r: &'a i64) -> i64 {
    return v.len() + *r;
}
fn main() -> i32 {
    let x: i64 = 1i64;
    let mut v: Vec<&'static i64> = Vec::new();
    v.push(&G);
    let n: i64 = shorter(&v).len() + count(&v, &x);
    return (n - 3i64) as i32;
}
