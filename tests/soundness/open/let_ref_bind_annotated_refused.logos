// SOUNDNESS QUEUE row let_ref_bind_annotated_refused (tier 3). `let ref y: T = <expr>` IS REFUSED: THE ANNOTATION IS READ AS
// THE BINDING'S TYPE.
//
// In Rust the type ascription of `let ref y: i64 = x;` is the type of the matched VALUE and `y: &i64` — legal, exit 0.
// TODAY refused: "let 'y': type mismatch — expected i64, got &i64". lower_let's P4-pm-14 rewrite turns the value into
// `&x` and then checks it against the annotation meant for `x`. Same for an rvalue (`let ref y: D = mk();`: "expected D,
// got &D"). The 2026-09-14o landing's `let ref` extension deliberately takes only the UNANNOTATED form, so this is unmoved.
// Found 2026-09-14o-autoreffund by hand programs c12 and x03. Legality MEASURED with rustc 1.98.1 (foot of this file).
package let_ref_bind_annotated_refused;
fn main() -> i32 {
    let x: i64 = 7i64;
    let ref y: i64 = x;
    let ref z: i64 = 5i64;
    if *y + *z != 12i64 { return 1i32; }
    return 0i32;
}
// rustc 1.98.1 --edition 2024 (round 2026-09-15f-rustcaudit, class CONFIRMED): COMPILES and RUNS exit 0. Twin src/compiler/probes/2026-09-15f-rustcaudit/rust/let_ref_bind_annotated_refused.rs.
