// SOUNDNESS QUEUE row match_ref_array_nested_struct_sub_refused (tier 3, refuses). MATCHING A
// BORROWED ARRAY WITH A NESTED STRUCT SUB-PATTERN IS REFUSED BY AN MLIR VERIFIER ERROR.
//
// `match &arr { [W { a: x, b: _ }] => x.v }` over `[W; 1]` binds x by reference under the default
// binding mode and moves NOTHING. rustc 1.98.1 compiles and runs it: k=1 n=12, exit 0 (twin
// src/compiler/probes/2026-09-16j-arrpath2/ybat/rust/y06.rs, MEASURED). TODAY logosc prints
//     mlir_gen: warning: undefined 'x' in fn 'hb_y06$g__f__pmut_i64'
//     error: 'arith.cmpi' op operand #0 must be signless-integer-like, but got '!llvm.ptr'
//     mlir_gen: module verification failed
// — an INTERNAL verifier failure escaping as the user-visible refusal, with no source location and
// no sentence, so the fix must also produce a real diagnostic (or, correctly, compile and run).
// ⚠ THE SENTENCE IS BYTE-IDENTICAL to row at_binding_array_sub_verifier_error_refused, and this row
// is deliberately NOT merged with it: that row is `y @ [_]` (an At binder over an array), this one is
// a REFERENCE scrutinee with a nested struct sub and no At anywhere. A shared symptom is not a shared
// defect — three consecutive rounds were refuted grouping by symptom. Whether one change moves both
// is a MEASUREMENT neither row may assume.
// Found 2026-09-16j-arrpath2 by hand program y06; UNMOVED by that round's landed arm (measured on
// both binaries, refused identically).
package match_ref_array_nested_struct_sub_refused;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct W { a: D, b: D }
fn g(p: *mut i64) -> i64 {
    let arr: [W; 1] = [W { a: D { v: 1i64, c: p }, b: D { v: 2i64, c: p } }];
    let r: i64 = match &arr {
        [W { a: x, b: _ }] => x.v,
    };
    return r;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    let got: i64 = unsafe { n };
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 1i64 { return 2i32; }
    if got != 12i64 { return 1i32; }
    return 0i32;
}
