// fix hint: drop scopes: the guard expression is its own drop scope; drop temporaries when the guard ends.
package match_guard_temp_drop_timing_wrong;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { name: i64 }
impl Drop for D {
    fn drop(self: &mut D) {
        unsafe { printf("drop %ld\n".as_ptr(), self.name); }
    }
}
