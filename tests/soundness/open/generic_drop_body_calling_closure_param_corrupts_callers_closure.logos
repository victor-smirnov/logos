// SOUNDNESS QUEUE row generic_drop_body_calling_closure_param_corrupts_callers_closure
// (tier 1). A GENERIC `Drop` BODY THAT **CALLS** ITS CLOSURE TYPE PARAMETER
// CORRUPTS A SEPARATE VALUE OF THAT SAME CLOSURE TYPE HELD BY THE CALLER —
// the caller's call SIGSEGVs, and the drop body's own call never executed.
//
// Found 2026-09-08 while repairing `stdlib/mem/manually_drop`'s `DropGuard`,
// which is this shape (it is Rust's `scopeguard`). It is NOT the drop defect
// that repair is about, and the repair does not fix it or cause it.
//
// The discriminator is ONE TOKEN, measured on build 3bd2c3af1c114227 43:
//   * drop body `if self.armed { let g: F = read::<F>(&self.f.value); g(); }`
//     -> the caller's later `f()` SIGSEGVs (rc 139)
//   * the SAME drop body with `g();` deleted (`let g: F = read::<F>(..);`)
//     -> the caller's `f()` runs, count 1, rc 0
// So the presence of a CALL to `F` inside the drop body is the cause. The guard
// is DISARMED in both runs, so the drop body's own `if` never fires — the
// corruption is not the drop body executing, it is the drop body EXISTING.
//
// FIVE CONTROLS, each one variable away, all correct on the same binary:
//   1. no `impl Drop` at all, everything else identical            -> 1, rc 0
//   2. `impl Drop` whose body does NOT mention F                   -> 1, rc 0
//   3. the closure taken out of the field by a plain MOVE, no ptr::read,
//      owner not `Drop`                                            -> 1, rc 0
//   4. `read::<F>` through a NON-generic path (`grab<T>(p) -> T`)  -> 1, rc 0
//   5. the drop receiver written `&mut self` instead of by value   -> STILL SIGSEGVs,
//      so it is not the by-value receiver either.
//
// The program runs the DEFECT arm first and the one-token control second, and
// takes the firing count itself so a LEAK reads low and a DOUBLE FIRE high:
//   want   arm 1, control 1, exit 0
//   today  SIGSEGV in the arm before it can print anything (rc 139)
package generic_drop_body_calling_closure_param_corrupts_callers_closure;
use logos.lang.ptr;
extern fn malloc(n: i64) -> *mut u8;
extern fn printf(f: *const u8, a: i64) -> i32;

#[no_auto_drop]
struct MD<T> { value: T }

// ── THE DEFECT ARM: drop body reads AND CALLS the closure. ─────────────
struct A<F: FnOnce() -> ()> { f: MD<F>, armed: bool }
impl<F: FnOnce() -> ()> Drop for A<F> {
    fn drop(self: A<F>) {
        if self.armed {
            let p: *const F = &self.f.value as *const F;
            let g: F = unsafe { read::<F>(p) };
            g();
        }
    }
}
fn a_new<F: FnOnce() -> ()>(f: F) -> A<F> { return A::<F> { f: MD::<F> { value: f }, armed: true }; }
fn a_out<F: FnOnce() -> ()>(a: A<F>) -> F {
    let mut d: A<F> = a;
    d.armed = false;
    let p: *const F = &d.f.value as *const F;
    return unsafe { read::<F>(p) };
}

// ── THE CONTROL: byte-identical except the drop body does not CALL. ────
struct B<F: FnOnce() -> ()> { f: MD<F>, armed: bool }
impl<F: FnOnce() -> ()> Drop for B<F> {
    fn drop(self: B<F>) {
        if self.armed {
            let p: *const F = &self.f.value as *const F;
            let g: F = unsafe { read::<F>(p) };
        }
    }
}
fn b_new<F: FnOnce() -> ()>(f: F) -> B<F> { return B::<F> { f: MD::<F> { value: f }, armed: true }; }
fn b_out<F: FnOnce() -> ()>(b: B<F>) -> F {
    let mut d: B<F> = b;
    d.armed = false;
    let p: *const F = &d.f.value as *const F;
    return unsafe { read::<F>(p) };
}

static mut FIRED: i64 = 0i64;

unsafe fn main() -> i32 {
    // THE DEFECT ARM — SIGSEGVs at `f()` today.
    FIRED = 0i64;
    {
        let a: A<||->()> = a_new::<||->()>(|| { unsafe { FIRED = FIRED + 1i64; } });
        let f: ||->() = a_out::<||->()>(a);
        printf("arm: before call, firings (want 0): %ld\n".as_ptr(), FIRED);
        f();
    }
    printf("arm: after call, firings (want 1): %ld\n".as_ptr(), FIRED);
    if FIRED != 1i64 { return 1i32; }

    // THE ONE-TOKEN CONTROL — correct today.
    FIRED = 0i64;
    {
        let b: B<||->()> = b_new::<||->()>(|| { unsafe { FIRED = FIRED + 1i64; } });
        let f: ||->() = b_out::<||->()>(b);
        f();
    }
    printf("control: after call, firings (want 1): %ld\n".as_ptr(), FIRED);
    if FIRED != 1i64 { return 2i32; }

    return 0i32;
}
