// SOUNDNESS QUEUE row at_binding_array_sub_verifier_error_refused (tier 3, refuses). A LEGAL
// `name @ [sub]` PATTERN IS REFUSED BY AN MLIR VERIFIER ERROR, NOT A DIAGNOSTIC.
//
// `match arr { y @ [_] => { return 7i64; } }` over `[D; 1]` is legal Rust (rustc 1.98.1: k=7 n=2,
// exit 0). TODAY logosc prints
//     error: 'arith.cmpi' op operand #0 must be signless-integer-like, but got '!llvm.ptr'
// — an INTERNAL verifier failure escaping as the user-visible refusal: the array sub-pattern under
// an `@` binder is compared as a scalar against a pointer. A refusal with no source location and no
// sentence is not a diagnostic, so this is a `refuses` row whose fix must also produce a real message
// (or, correctly, compile and run).
// Found 2026-09-16b-armbind by hand program b09. Unmoved by that round's slicemv / slicemvn arms.
// rustc 1.98.1 --edition 2024 twin: src/compiler/probes/2026-09-16b-armbind/rust/b09.rs (k=7 n=2).
package at_binding_array_sub_verifier_error_refused;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn g(p: *mut i64) -> i64 {
    let arr: [D; 1] = [D { v: 2i64, c: p }];
    match arr {
        y @ [_] => { return 7i64; }
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 7i64 { return 2i32; }
    if got != 2i64 { return 1i32; }
    return 0i32;
}
