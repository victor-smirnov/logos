// SOUNDNESS QUEUE row at_binding_mut_syntax (tier 3). 'mut n @ 1..=5' — a mutable
// @-binding — is legal Rust. TODAY the grammar's at-pattern takes a bare IDENT and
// the program is a syntax error at 'n' (line 7). The payload-position `mut n`
// without '@' parses and is carried since 2026-09-06. Found 2026-09-06b (PROBES.md,
// hand c04). Rust: exit 0.
package at_binding_mut_syntax;
enum E { N(i64), Z }
fn main() -> i32 {
    let e: E = E::N(3i64);
    let mut out: i64 = 0i64;
    match e {
        E::N(mut n @ 1i64..=5i64) => { n = n + 10i64; out = n; },
        E::N(_) => { out = -1i64; },
        E::Z => {}
    }
    if out != 13i64 { return 1i32; }
    return 0i32;
}
