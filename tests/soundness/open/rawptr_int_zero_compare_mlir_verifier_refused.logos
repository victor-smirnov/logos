// SOUNDNESS QUEUE row rawptr_int_zero_compare_mlir_verifier_refused (tier 3).
// A PROGRAM THE LANGUAGE ADMITS DIES IN THE MLIR VERIFIER. Spec clause expr.binop.ptr-null-compare lets a raw
// pointer be compared with the integer literal 0 (a Logos addition; rustc has no such comparison), and sema accepts
// `p == 0` — then codegen emits an `llvm.icmp` over a pointer and an integer: "'llvm.icmp' op requires all operands
// to have the same type". The clause's own logic says this compiles and answers false for a non-null pointer.
// Found by round 2026-09-14f-thrurefland (hands n04 n05, also `*mut &i64`) on base baa2a38e8b650fb3 43.
// Expected under the clause: exit 3.
package rawptr_int_zero_compare_mlir_verifier_refused;
fn main() -> i32 {
    let mut v: i64 = 1i64;
    let p: *mut i64 = &mut v as *mut i64;
    if p == 0 {
        return 1i32;
    }
    return 3i32;
}
