// SOUNDNESS QUEUE row vec_mutref_elem_push_store_rehomed_refused (tier 3).
// LEGAL PROGRAM REFUSED: `Vec<&mut i64>` HOLDING `&mut x` AND `&mut y`, WRITTEN THROUGH, DEAD; THEN `x = x + 1`.
//
// Legal Rust: `v` is dead after the block. Legality by reading, no rustc binary. TODAY refused, build 0230e503bd682184 43: "cannot use 'y'
// while it is mutably borrowed" — the second push's loan on `y` is held by `x` through the A2 edge `v -> x`.
// MEASURED: compiles and runs exit 0 under a2elem and a2skipall; still refused under a2elemshr.
// Found: hand v01, round 2026-09-14l-storeedge.
package vec_mutref_elem_push_store_rehomed_refused;
fn main() -> i32 {
    let mut x: i64 = 1i64;
    let mut y: i64 = 2i64;
    {
        let mut v: Vec<&mut i64> = Vec::new();
        v.push(&mut x);
        v.push(&mut y);
        *v[0u64] = 7i64;
        *v[1u64] = 8i64;
    }
    x = x + 1i64;
    return (x + y) as i32 - 16i32;
}
