// SOUNDNESS QUEUE row concrete_tuple_impl_bound_refused (tier 3, `refuses`). A CONCRETE tuple impl (`impl Mk for (i64, i64)`)
// does not satisfy a bound named only by turbofish: `tags::<(i64, i64)>()` with `fn tags<T: Mk>() -> i64` is
// refused ("type '(i64, i64)' does not implement trait 'Mk' required by parameter 'T'"). With a second impl of the
// trait in the program (`impl Mk for i64`), `build::<(i64, i64)>(7)` — the bound reached through an argument too —
// is refused the same way. rustc 1.98.1 --edition 2024 runs it and prints "14 3". Found by the ADR 0030 S8 row 6
// `T::m()` battery; the bound check is not touched by that work.
// fix hint: the bound check asks the impl registry by the tuple's identity keys (impl_lookup_keys_), as the method
// probe does.
package concrete_tuple_impl_bound_refused;
use logos.std.fmt;
trait Mk { fn mk(v: i64) -> Self; fn tag() -> i64; }
impl Mk for (i64, i64) { fn mk(v: i64) -> (i64, i64) { (v, v) } fn tag() -> i64 { 3 } }
fn build<T: Mk>(v: i64) -> T { T::mk(v) }
fn tags<T: Mk>() -> i64 { T::tag() }
fn main() {
    let c: (i64, i64) = build::<(i64, i64)>(7);
    println!("{} {}", c.0 + c.1, tags::<(i64, i64)>());
}
