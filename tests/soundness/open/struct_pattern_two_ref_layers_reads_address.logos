package struct_pattern_two_ref_layers_reads_address;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let p: P = P { x: 3i64, y: 4i64 };
    let r: &P = &p;
    match r {
        P { x, y } => { if *x + *y != 7i64 { return 2i32; } }
    }
    match & &p {
        P { x, y } => { if *x + *y != 7i64 { return 1i32; } }
    }
    return 0i32;
}
