package vec_index_store_value_borrows_vec_refused;
fn total(v: &[i64]) -> i64 {
    return v[0u64] + v[1u64];
}
fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    v.push(3i64);
    v.push(4i64);
    v[0u64] = total(&v);
    return (v[0u64] - 7i64) as i32;
}
