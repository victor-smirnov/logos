// SOUNDNESS QUEUE row drop_body_conditional_move_double_drops_both_paths
// (tier 1). A BY-VALUE `Drop::drop` BODY THAT MOVES A FIELD OF `self` OUT UNDER
// AN `if` DOUBLE-DROPS THAT FIELD — ON BOTH PATHS, INCLUDING THE ONE WHERE THE
// MOVE NEVER EXECUTES. Two destructor calls on one live value is a double free.
//
// Measured 2026-09-08 on build eaac8e4b73c1fe24 43. The destructor prints its
// own `w`, so both calls are visibly reading the SAME initialised value — this
// is not a garbage read of an unwritten slot:
//
//   G::drop armed=0 / N::drop w=7 / N::drop w=7 / total=14      want 7
//   G::drop armed=1 / N::drop w=7 / N::drop w=7 / total=14      want 7
//
// CONTROLS on the same binary, one token apart each:
//   * the SAME drop body with the move statement deleted (`if self.armed { }`)
//     reads 7 — correct. So the move statement is the cause even on the path
//     that never runs it.
//   * the SAME conditional move in a PLAIN function taking the container by
//     value (`fn eat(g: G) { if g.armed { let q: N = g.f; } }`) reads 7 in BOTH
//     spellings — correct. The frame's moved-path record and #118/#121 drop
//     flags handle it exactly. The discriminator is that the value is the
//     `self` of a `Drop::drop` body, whose fields are released by the CALLER's
//     glue, which has no record of what the body consumed.
//
// NOT drop_body_moving_field_double_drops_local. That row is the UNCONDITIONAL
// move, and a static moved-path record from the drop body closes it. This shape
// is the reason no static record can be the whole answer: on the disarmed path
// the body consumes nothing, so a static skip turns this double free into a
// LEAK rather than fixing it. The ownership state here is not a static fact and
// the carrier for it (#118's drop flag) does not cross the call boundary into
// the caller's field recursion.
//
// This is also the shape the stdlib uses: `stdlib/mem/manually_drop` —
//   impl<F: FnOnce() -> ()> Drop for DropGuard<F> {
//       fn drop(self: DropGuard<F>) { if self.armed { let f = self.f; f(); } }
//   }
// so it is not a synthetic corner.
//
// The program takes the count itself and returns 1 when either spelling is
// wrong; 2/3 if a control moves. Rust: exit 0 (E0509 forbids the move out of
// `&mut self` outright, so the shape cannot arise there at all).
package drop_body_conditional_move_double_drops_both_paths;
extern fn malloc(n: i64) -> *mut u8;
extern fn printf(f: *const u8, a: i64, b: i64) -> i32;

trait Drop { fn drop(self: Self); }
struct N { w: i64, c: *mut i64 }
impl Drop for N { fn drop(self: N) { unsafe { self.c[0] = self.c[0] + self.w; } } }

struct G { armed: bool, f: N }
impl Drop for G { fn drop(self: G) { if self.armed { let q: N = self.f; } } }

// CONTROL: the same conditional move in a plain function, not a drop body.
struct H { armed: bool, f: N }
fn eat(h: H) -> i64 { if h.armed { let q: N = h.f; } return 0i64; }

unsafe fn main() -> i32 {
    let c: *mut i64 = malloc(8) as *mut i64;

    c[0] = 0i64;
    { let g: G = G { armed: false, f: N { w: 7i64, c: c } }; }
    printf("drop body, conditional move, DISARMED (want 7): %ld\n".as_ptr(), c[0], 0i64);
    if c[0] != 7i64 { return 1i32; }

    c[0] = 0i64;
    { let g: G = G { armed: true, f: N { w: 7i64, c: c } }; }
    printf("drop body, conditional move, ARMED (want 7): %ld\n".as_ptr(), c[0], 0i64);
    if c[0] != 7i64 { return 1i32; }

    c[0] = 0i64;
    { let r: i64 = eat(H { armed: false, f: N { w: 7i64, c: c } }); }
    if c[0] != 7i64 { return 2i32; }

    c[0] = 0i64;
    { let r: i64 = eat(H { armed: true, f: N { w: 7i64, c: c } }); }
    if c[0] != 7i64 { return 3i32; }

    return 0i32;
}
