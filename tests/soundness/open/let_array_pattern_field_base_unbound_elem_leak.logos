// SOUNDNESS QUEUE row let_array_pattern_field_base_unbound_elem_leak (tier 1, run 1). A `let` ARRAY
// PATTERN OVER AN ARRAY-TYPED FIELD LEAKS EVERY ELEMENT THE PATTERN DOES NOT BIND.
//
// `let [_, y] = s.arr;` over `struct S { arr: [D; 2], .. }`: rustc destroys y (2) and then the
// unbound element 0 (1) — n = 21, exit 0 (twin x2_let_field_leak.rs, MEASURED rustc 1.98.1).
// TODAY n = 2: element 0 is NEVER destroyed. The whole field is marked moved, so the container's
// scope-exit drop skips the array entirely and the unbound element has no other owner.
// NOT the match-arm fact of round 2026-09-16c-armelem: that round's `armelem` arm marks per ELEMENT
// at the MATCH door only, and this program reads n = 2 under it, unchanged (measured, ARM.tsv).
// Found 2026-09-16c-armelem by hand program x07b.
package let_array_pattern_field_base_unbound_elem_leak;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct S { arr: [D; 2], tag: i64 }
fn g(p: *mut i64) -> i64 {
    let s: S = S { arr: [D { v: 1i64, c: p }, D { v: 2i64, c: p }], tag: 7i64 };
    let [_, y] = s.arr;
    return y.v;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    let got: i64 = unsafe { n };
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 2i64 { return 2i32; }
    if got != 21i64 { return 1i32; }
    return 0i32;
}
