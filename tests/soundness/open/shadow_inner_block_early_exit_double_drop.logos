// SOUNDNESS QUEUE row shadow_inner_block_early_exit_double_drop (tier 1). AN EARLY EXIT FROM AN INNER BLOCK THAT SHADOWS AN
// OUTER LOCAL DESTROYS THE INNER BINDING TWICE AND THE OUTER ONE NEVER.
//
// `let x = D{1}; { let x = D{2}; if b { return x.v; } }`: the return's unwind (collect_all_drops) emits SDrop `x` for the inner
// frame and SDrop `x` for the outer frame. Sema's two frames are right; the drop names its binding by STRING, and mlir-gen
// resolves both through one flat name map (MLIRGenImpl::scope_), where `x` now denotes the inner binding. Sequence counter:
// Rust 21 (inner 2, then outer 1), exit 0. TODAY 22 (measured as an exit code), exit 1. Same on a `break` out of a loop body (hand s22) and a
// parameter shadowed inside an inner block (hand s24).
// NEIGHBOUR of shadow_over_param_double_drop (same fact: a drop's name denotes a later binding at the drop site).
// Found 2026-09-14p-shadowslot by hand program s21 on build b485f2200bf9f5a0 (unarmed); CLOSED under the priced arms
// shslot and shslotmg (the slot carried on SDrop, resolved by mlir-gen), 1 -> 0. Legality by reading; no rustc binary.
package shadow_inner_block_early_exit_double_drop;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn eatd(x: D) -> i64 { return x.v; }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn g(p: *mut i64, b: bool) -> i64 {
    let x: D = D { v: 1i64, c: p };
    {
        let x: D = D { v: 2i64, c: p };
        if b { return x.v; }
    }
    return x.v;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p, true);
    if r != 2i64 { return 9i32; }
    if rd(p) != 21i64 { return 1i32; }
    return 0i32;
}
