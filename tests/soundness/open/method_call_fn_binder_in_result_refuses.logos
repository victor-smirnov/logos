package method_call_fn_binder_in_result_refuses;

struct A<'a> { x: &'a i64 }
struct S { k: i64 }

impl S {
    fn pick<'q>(&self, x: &'q i64) -> A<'q> {
        return A { x: x };
    }
}

fn main() -> i32 {
    let s: S = S { k: 1i64 };
    let v: i64 = 20i64;
    let a: A<'_> = s.pick(&v);
    if *a.x != 20i64 { return 1i32; }
    return 0i32;
}
