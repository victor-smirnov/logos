// SOUNDNESS QUEUE row match_tuple_copy_elem_no_default_mut_ref (tier 3). `match &mut t {
// (a, b) => { *a = *a + 1; } }` over `t: (i64, i64)` is legal Rust — the `&mut` scrutinee
// sets the default binding mode to `ref mut`, so `a: &mut i64` and the write lands in `t`.
// TODAY refused, two sentences: "write through raw pointer requires unsafe context" and
// "deref-write: '=' left side must be a pointer or mutable reference". The PAT_TUPLE door's
// default-binding-mode wrap is gated on `is_move_type(et)` (build_pattern, the
// `default_ref` loop), a carve-out the VARIANT-payload door dropped in logos-core 4.3
// ("a bare TypeVar payload is NO LONGER carved out: it binds `&T` like Rust"), so a COPY
// element under a reference scrutinee still binds by value. The shared-`&` twin
// (`match &t { (a, b) => *a + *b }`) COMPILES AND ANSWERS CORRECTLY, but only because a
// `*` on a by-value binding degenerates to a no-op — it is not evidence the wrap happened.
// DISTINCT from the written-`ref` root closed 2026-09-06h
// (refmut_binding_write_refused_outside_variant): that one is the keyword being dropped,
// this one is the mode never being set. Found 2026-09-06h (hand h17). Rust: exit 0.
package match_tuple_copy_elem_no_default_mut_ref;
fn main() -> i32 {
    let mut t: (i64, i64) = (3i64, 4i64);
    match &mut t {
        (a, b) => { *a = *a + 1i64; if *b != 4i64 { return 2i32; } }
    }
    if t.0 != 4i64 { return 1i32; }
    return 0i32;
}
