// SOUNDNESS QUEUE row let_array_pattern_nested_subpattern_refused (tier 3, refuses). THE `let` ARRAY
// DOOR CANNOT PARSE A NESTED SUB-PATTERN AT ALL — IT REFUSES BEFORE ANY MOVE MARK EXISTS.
//
// `let [W { a: x, b: _ }] = arr;` over `[W; 1]`: rustc 1.98.1 compiles and runs it, k=1 n=12, exit 0
// (twin src/compiler/probes/2026-09-16i-arrpath/rust/x04.rs, MEASURED). TODAY logosc refuses with
//     error: let array pattern: only plain identifier bindings are supported at element 0
//            (got non-PAT_WILD)
// and then a CASCADE — "undefined variable 'x'", "field read: receiver is not a struct (got <error>)".
// The match door handles this shape (round 2026-09-16j-arrpath2 gave it per-leaf move paths); the LET
// door is one step behind, refusing the shape rather than mis-marking it.
// Named as owed by the pricing round 2026-09-16i-arrpath (hand program x04) and NOT opened there;
// opened by 2026-09-16j-arrpath2 with the reason its neighbour table requires — REASON 1, NO CARRIER:
// admitting this shape means BUILDING a nested destructure at the let door (the sub-pattern needs its
// own recursive lowering), which is a different change from computing a path for a binding that
// already exists. That round's arm is measured UNMOVING it on both binaries.
package let_array_pattern_nested_subpattern_refused;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct W { a: D, b: D }
fn g(p: *mut i64) -> i64 {
    let arr: [W; 1] = [W { a: D { v: 1i64, c: p }, b: D { v: 2i64, c: p } }];
    let [W { a: x, b: _ }] = arr;
    return x.v;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    let got: i64 = unsafe { n };
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 1i64 { return 2i32; }
    if got != 12i64 { return 1i32; }
    return 0i32;
}
