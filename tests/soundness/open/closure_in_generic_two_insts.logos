// SOUNDNESS QUEUE row closure_in_generic_two_insts (tier 3). A closure inside a
// generic fn instantiated at two types: legal Rust, TODAY 'redefinition of symbol
// named __closure_0' — the synthetic name is not qualified by the monomorphisation.
// Pre-existing, measured under a control revert (2026-09-03b §9.1).
package closure_in_generic_two_insts;
fn twice<T: Copy>(v: T) -> T {
    let c = |x: &T| -> T { return *x; };
    return c(&v);
}
fn main() -> i32 {
    let a: i64 = twice(3i64);
    let b: i32 = twice(4i32);
    if a != 3i64 { return 1i32; }
    if b != 4i32 { return 2i32; }
    return 0i32;
}
