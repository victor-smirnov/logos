// SOUNDNESS QUEUE row i128_literal_promotion_refused (tier 3, refuses).
// LEGAL RUST REFUSED. `&36893488147419103232i128` is const-promoted in Rust
// ('static). Logos's shared promotion predicate excludes a >64-bit literal
// because the LIR literal accessor is 64-bit (const_promote.hpp: the emitter
// re-derived the high half by sign extension — wrong code), so the borrow is a
// temporary and returning it is refused. Until 2026-09-25 the BIR's private
// copy of the predicate ADMITTED it and the emitter put it in the frame (a
// dangle); unifying the predicate turned that into this refusal. Closing it
// needs a full-width literal accessor. rustc 1.98.1: exit 0.
package i128_literal_promotion_refused;
fn g() -> &'static i128 { return &36893488147419103232i128; }
fn main() -> i32 {
    if *g() != 36893488147419103232i128 { return 1i32; }
    return 0i32;
}
