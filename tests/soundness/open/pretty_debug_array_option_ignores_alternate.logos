// SOUNDNESS QUEUE row pretty_debug_array_option_ignores_alternate (tier 1, `run 1`). Found 2026-09-25 by the discovery battery.
// `{:#?}` of `[1, 2]` and of `Some(5)` prints the one-line form; rustc prints "[\n    1,\n    2,\n]" and "Some(\n    5,\n)".
// A user struct through `debug_struct` honours the alternate flag; the std impls for arrays, slices, Vec, Option do not.
package pretty_debug_array_option_ignores_alternate;
use logos.std.fmt;
use logos.mem.string;
fn main() -> i32 {
    if format!("{:#?}", [1i64, 2i64]) != "[\n    1,\n    2,\n]" { return 1i32; }
    let o: Option<i64> = Some(5i64);
    if format!("{:#?}", o) != "Some(\n    5,\n)" { return 2i32; }
    return 0i32;
}
