// SOUNDNESS QUEUE row at_binding_aggregate_segfaults_run (tier 1, run 139). A `name @ pattern`
// BINDING OVER AN AGGREGATE SCRUTINEE SEGFAULTS.
//
// `match w { y @ W { .. } => { return y.b; } }` over a by-value struct: rustc binds the whole value
// to `y`, reads the field, drops once — k=3 n=2, exit 0. TODAY rc 139.
// The SAME crash at two more spellings, both measured on this binary: the expression-position form
// `let k = match w { y @ W { .. } => y.b };` (139) and the TUPLE form
// `match t { y @ (_, _) => { return y.1; } }` (139). rustc on all three: k=3 n=2.
// NOT the array-pattern move fact of round 2026-09-16b-armbind: slicemv / slicemvn leave all three
// at 139 (measured, ARMRUN.tsv). pattern_moves_out's At arm already returns TRUE, so the scrutinee
// IS marked moved; the defect is downstream of the mark, where the binding is given its storage.
// Found 2026-09-16b-armbind by hand programs b08 / b13 / b14.
// rustc 1.98.1 --edition 2024 twins: src/compiler/probes/2026-09-16b-armbind/rust/b08.rs (k=3 n=2),
// b13.rs (k=3 n=2), b14.rs (k=3 n=2) — all compile and run exit 0.
package at_binding_aggregate_segfaults_run;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
struct W { a: D, b: i64 }
fn g(p: *mut i64) -> i64 {
    let w: W = W { a: D { v: 2i64, c: p }, b: 3i64 };
    match w {
        y @ W { .. } => { return y.b; }
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 3i64 { return 2i32; }
    if got != 2i64 { return 1i32; }
    return 0i32;
}
