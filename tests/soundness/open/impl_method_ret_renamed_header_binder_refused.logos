package impl_method_ret_renamed_header_binder_refused;

trait Get<'a> {
    fn get(self: &Self) -> &'a i64;
}

struct H<'q> {
    r: &'q i64,
}

impl<'z> Get<'z> for H<'z> {
    fn get(self: &Self) -> &'z i64 {
        return self.r;
    }
}

fn main() -> i32 {
    let v = 5i64;
    let h = H { r: &v };
    if *h.get() != 5i64 { return 1i32; }
    return 0i32;
}
// SOUNDNESS QUEUE row impl_method_ret_renamed_header_binder_refused (tier 3).
// Legal Rust: the trait's `'a` is instantiated by the impl's trait reference `Get<'z>`,
// so the trait's `-> &'a i64` IS `-> &'z i64` for this impl. ⚠ No rustc binary on this
// box; the legality claim rests on compare_impl_method as read (the impl signature is
// related to the trait's AFTER substituting the trait's generics with the impl's
// trait-reference args).
// TODAY refused: "impl Get for H: method 'get' does not match the trait declaration: the
// return type is declared '&'a i64' and the impl declares '&'z i64'". Spelling the impl
// binder `'a` compiles and runs. The return-slot comparison in collect_impl compares the
// trait's region NAME with the impl's, never mapping the trait's lifetime params through
// `trait_lt_args`. The same comparison refuses crossed binders
// (`impl<'y,'x> Pick<'y,'x>` returning `&'y` for trait `&'a`). Measured 2026-09-13e on
