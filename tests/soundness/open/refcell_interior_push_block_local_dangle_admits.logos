// SOUNDNESS QUEUE row refcell_interior_push_block_local_dangle_admits (tier 2).
// ILLEGAL PROGRAM ADMITTED: A `&d` OF A BLOCK LOCAL PUSHED INTO A `RefCell<Vec<&i64>>` THROUGH `borrow_mut()`, THE CELL READ AFTER THE BLOCK.
//
// rustc refuses (E0597: `RefCell<Vec<&'b i64>>` is invariant in 'b and the cell is used after `d` dies); legality by reading, no
// rustc binary. TODAY admitted (runs exit 1), build 0230e503bd682184 43. NOT the store-edge fact: unmoved by se_nomut,
// se_nomutelem and a2elemorshr (round 2026-09-14m-storeedge-land) — the interior store is a write through a SHARED `&RefCell`,
// which no alias or holder edge models. Borrow checking is live in an `unsafe fn` (a plain block-local dangle there is refused).
// Found: hand s26, round 2026-09-14m-storeedge-land.
package refcell_interior_push_block_local_dangle_admits;
use logos.lang.cell;
struct H<'a, 'b> { c: &'a RefCell<Vec<&'b i64>> }
impl<'a, 'b> H<'a, 'b> {
    fn set(self: &mut H<'a, 'b>, c: &'a RefCell<Vec<&'b i64>>) { self.c = c; }
}
unsafe fn main() -> i32 {
    let g: RefCell<Vec<&i64>> = RefCell::<Vec<&i64>>::new(Vec::<&i64>::new());
    let cell: RefCell<Vec<&i64>> = RefCell::<Vec<&i64>>::new(Vec::<&i64>::new());
    let mut h: H = H { c: &g };
    h.set(&cell);
    {
        let d: i64 = 2i64;
        let mut gd = h.c.borrow_mut();
        gd.get_mut().push(&d);
    }
    let n: i64 = cell.borrow().get().len() as i64;
    return n as i32;
}
