// SOUNDNESS QUEUE row vec_contains_string_double_drop_wrong (tier 1, `run 134`). Feature-interaction audit 2026-09-26, cluster vec-contains-bitcopy: Vec::contains bit-copies each element out of the raw buffer and drops the copy, so a Vec<String> element is freed twice
// Logos: compiles clean; the binary aborts (exit 134, double free at the Vec's drop after contains dropped the bit-copied element).
// rustc: compiles and runs, exit 0 (contains compares through &T, never moves an element) — reproduced with rustc 1.98.1 --edition 2024 on the twin.
// corpus: tests/interactions/clusters/vec-contains-bitcopy/
// fix hint: stdlib mem/collections/vec.logos contains (vec_contains): compare by reference into the buffer, no by-value element read.
package vec_contains_string_double_drop_wrong;
use logos.mem.string;
use logos.mem.collections.vec;
fn main() -> i32 {
    let names: Vec<String> = vec![String::from("abc")];
    let key = String::from("zzz");
    if names.contains(&key) { return 1; }
    return 0;
}
