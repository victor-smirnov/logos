// SOUNDNESS QUEUE row call_arg_deref_coercion_double_ref (tier 3).
// A LEGAL program refused. Under match ergonomics `t` binds `&&List<i64>` (the
// payload field is already `&List<T>` and the by-ref scrutinee adds a layer),
// and `sum(t)` passes it where `&List<i64>` is wanted. rustc 1.98.1 ACCEPTS
// this — DEREF COERCION applies at an argument position, `&&T` coercing to
// `&T` — and runs it to exit 0. Logos refuses:
//   "call to 'sum' arg 1: expected &List, got &&List".
//
// A DOOR IN SERIES WITH THE 2026-09-16d STRUCT-SHAPE DOOR FIX, ROWED WITH
// REASON 2. Before that landing this program compiled, but only because the
// default binding mode was DEAD at the struct-shaped variant door — `t` bound
// by VALUE out of a borrow, which is the very double-drop defect that landing
// closed. Giving the door its binding mode is what makes the missing coercion
// reachable, so this is not a regression in the rule, it is a second door that
// was hidden behind a broken first one. The repair is at the ARGUMENT
// COERCION site and is independent of pattern binding.
//
// ⚠ FOUND BY AN ARM, NOT BY READING. This program is the original spelling of
// tests/imported/pass/structs-enums/generic-recursive-list-se, which the
// runtime column caught moving cc 0 -> 1. The fixture is repaired at its own
// door (`sum(*t)`) in the same commit; this row holds the spelling rustc
// accepts and Logos does not.
package call_arg_deref_coercion_double_ref;
enum List<'a, T> { Cons { head: T, tail: &'a List<'a, T> }, Nil }
fn sum(l: &List<i64>) -> i64 {
    match l {
        List::Cons { head: h, tail: t } => { return *h + sum(t); }
        List::Nil => { return 0i64; }
    }
}
fn main() -> i32 {
    let n: List<i64> = List::Nil;
    let c3: List<i64> = List::Cons { head: 3i64, tail: &n };
    let c2: List<i64> = List::Cons { head: 2i64, tail: &c3 };
    let c1: List<i64> = List::Cons { head: 1i64, tail: &c2 };
    if sum(&c1) == 6i64 { return 0i32; }
    return 1i32;
}
