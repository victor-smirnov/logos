// SOUNDNESS QUEUE row vec_new_uninferred_push_dropped (tier 3).
// `let mut v = Vec::new(); v.push(4u8);` — the element type is never inferred
// from the first push: mlir_gen reports "the method 'Vec$G1$T__push' had no
// instantiation … COMPILE FAILED" and logosc aborts. Annotating
// `Vec<u8>` compiles and runs. Legal Rust (inference from a later use).
package vec_new_uninferred_push_dropped;
fn main() -> i32 {
    let mut v = Vec::new();
    v.push(4u8);
    return v[0] as i32 - 4i32;
}
