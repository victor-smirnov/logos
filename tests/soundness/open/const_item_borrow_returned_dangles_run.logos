// SOUNDNESS QUEUE row const_item_borrow_returned_dangles_run (tier 1, `run`). `return &K` for a const item
// `K` (`fn f() -> &'static i64`) compiles, and codegen materialises K in f's FRAME (`alloca; store 5;
// ret ptr`) — the reference dangles, and a call that reuses the stack overwrites it. rustc 1.98.1:
// `&K` is a promoted constant in static storage; exit 5. BIR treats the borrow as the promoted
// constant (`_ret = @const`) while mlir does not promote this shape: the emitter is narrower than the
// checker. Found by the gate sample (fail/bc_const_item_return_ref_fail, which pinned the old refusal,
// went silent before 2026-09-30).
package const_item_borrow_returned_dangles_run;
const K: i64 = 5i64;
fn f() -> &'static i64 { return &K; }
fn clobber(a: i64, b: i64, c: i64, d: i64) -> i64 { let x = [a, b, c, d, a + b, c + d, 77, 88]; return x[6] + x[7]; }
fn main() -> i32 { let r: &i64 = f(); let z = clobber(91, 92, 93, 94); if z != 165 { return 9; } return *r as i32; }
