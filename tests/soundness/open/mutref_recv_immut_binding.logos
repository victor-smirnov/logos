// SOUNDNESS QUEUE row mutref_recv_immut_binding (tier 3). An IMMUTABLE local holding
// &mut S may call a &mut self method (legal Rust). TODAY refused: cannot borrow 'sr'
// as mutable: not declared as mut — the AddrOfTemp receiver branch asks the
// declared-mut question with neither the reference exemption nor the pattern mask
// (2026-09-03i §8.1).
package mutref_recv_immut_binding;
struct S { v: i64 }
impl S {
    fn get(&mut self) -> &mut i64 { return &mut self.v; }
}
// method that returns a borrow of self.
fn main() -> i32 {
    let mut s: S = S { v: 1i64 };
    let sr: &mut S = &mut s;
    let r: &mut i64 = sr.get();
    *r = 9i64;
    return 0i32;
}
