// SOUNDNESS QUEUE row copy_named_supertrait_loses_vtable_slot (tier 3, refuses).
// A user's own trait spelled `Copy` used as a SUPERTRAIT is dropped from the
// vtable / upcast set by SPELLING, so `b.dup()` through `Box<dyn Sh>` is
// refused: "trait 'Sh' has no method 'dup'". The byte-identical program with
// the trait renamed `Kopy` compiles AND RUNS (`area=9 dup=30`, rc 0). Legal
// Rust. Root: the four `s.trait_name == "Copy"` supertrait skips
// (sema_collect.cpp vtable walk + check_supertrait_impls x2, sema_decl.cpp's
// emitted list) — each has `TraitBound::canonical_trait` in hand and does not
// read it (censused `copysuper:vtab:<userpkg>::Copy` vs `copysuper:vtab:Copy`).
// The lang item MUST keep being skipped: tests/spec/pass/trait_5 pins
// `trait.def.copy-not-a-supertrait`. PROBES.md 2026-09-10e.
package copy_named_supertrait_loses_vtable_slot;
use logos.mem.boxed;
extern fn printf(fmt: *const u8, ...) -> i32;
trait Copy { fn dup(&self) -> i32; }
trait Sh: Copy { fn area(&self) -> i32; }
struct Sq { s: i32 }
impl Copy for Sq { fn dup(&self) -> i32 { return self.s * 10i32; } }
impl Sh for Sq { fn area(&self) -> i32 { return self.s * self.s; } }
unsafe fn main() -> i32 {
    let b: Box<dyn Sh> = Box::new(Sq { s: 3i32 });
    let a: i32 = b.area();
    let d: i32 = b.dup();
    printf("area=%d dup=%d\n".as_ptr(), a, d);
    return d - 30i32;
}
