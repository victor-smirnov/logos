// SOUNDNESS QUEUE row static_arg_pins_shared_callee_region_refused (tier 3).
// A callee region shared by two parameters is instantiated at the FIRST argument's
// region: a `'static` first argument pins `'a := 'static`, and the second argument —
// a borrow of a local — is then refused "call to 'eqr' arg 2: variance mismatch —
// expected &'static i64, got &i64". Rust picks `'a` = the call's region and both
// arguments coerce. Legal Rust (reading; no rustc binary here). Three spellings of
// the same first argument: a `&'static` parameter, `&STATIC`, and a static's read.
// This is the door in series in front of reading a static's elided region as
// 'static at its declaration (2026-09-13d: that fill refuses r04/r08/r17 here).
package static_arg_pins_shared_callee_region_refused;
static V: i64 = 5i64;
fn eqr<'a>(x: &'a i64, y: &'a i64) -> bool { return *x == *y; }
fn by_param(s: &'static i64) -> i32 {
    let n: i64 = 5i64;
    if eqr(s, &n) { return 0i32; }
    return 1i32;
}
fn main() -> i32 {
    let n: i64 = 5i64;
    if by_param(&V) != 0i32 { return 1i32; }
    if !eqr(&V, &n) { return 2i32; }
    return 0i32;
}
