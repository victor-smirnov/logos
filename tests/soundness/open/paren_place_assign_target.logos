// SOUNDNESS QUEUE row paren_place_assign_target (tier 3). `(*b) = 7` — a
// PARENTHESISED place on the left of `=` — is legal Rust (the assignee
// expression may be parenthesised). TODAY refused "invalid assignment target:
// left side is not an assignable place": lower_place_assign accepts only
// INDEX_READ / FIELD_READ / TUPLE_INDEX / DEREF and does not unwrap a
// PAREN_EXPR. Found 2026-09-08a (hand c22). Rust: exit 0.
package paren_place_assign_target;
fn main() -> i32 {
    let mut b: Box<i64> = Box::new(1i64);
    (*b) = 7i64;
    if *b != 7i64 { return 1i32; }
    return 0i32;
}
