// SOUNDNESS QUEUE row struct_pattern_over_double_ref_reads_slot_run (tier 1). WRONG VALUE AT RUN TIME.
// A `&`-pattern chain that reaches a STRUCT through a reference to a reference reads the fields from the SLOT that holds the inner
// reference, not from the struct: `match pp { &&P { x } => x }` with `pp: &&P` a correct double reference (`let pp: &&P = &r;`).
// PART 1 fn tail `match p { &&P { x } => x }` -> exit 1; PART 2 statement match -> exit 2; PART 3 `if let &&P { x } = pp` -> exit 3;
// PART 4 `match pp { &q => q.x }` -> exit 4 (exit reads the FIRST wrong part). Rust: exit 0. The scalar twin `&&v` over `&&i64` is right
// (scalar_core_scrut loads every layer) and `&&ref q` is right; the enum door peels `via_ref_depth - 1` extra layers
// (MLIRGenImpl::gen_expr_kind(EMatchView)); the RefPat door over an aggregate core (MLIRGenImpl::gen_match's extract_payload and the
// expression door's extract_arm_payload) recurses with the SAME scrutinee value and peels no layer.
// DOORS IN SERIES with addr_of_struct_ref_local_arg_passes_referent_run (round 2026-09-15c-argref): on base the caller's one-short
// `&r` hands this door exactly the value it reads, so pass/pattern_parse_batch_full.logos (`let r = &p; deref2(&r)`) is green BY
// CANCELLATION; argrefland repairs the caller and that fixture reads exit 1 (3 of 3 runs). This door must open first or co-land.
// Measured on build/ 98ca3fa669468808 43, unarmed and under argrefland alike (hands p01 p04 p06 p09). Legality by reading; no rustc binary.
package struct_pattern_over_double_ref_reads_slot_run;
struct P { x: i32 }
fn deref2(p: &&P) -> i32 {
    match p { &&P { x } => x }
}
fn main() -> i32 {
    let p = P { x: 5i32 };
    let r: &P = &p;
    let pp: &&P = &r;
    if deref2(pp) != 5i32 { return 1i32; }
    match pp { &&P { x } => { if x != 5i32 { return 2i32; } } }
    if let &&P { x } = pp {
        if x != 5i32 { return 3i32; }
    }
    match pp { &q => { if q.x != 5i32 { return 4i32; } } }
    return 0i32;
}
