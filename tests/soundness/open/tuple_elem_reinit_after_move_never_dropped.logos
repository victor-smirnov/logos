// SOUNDNESS QUEUE row tuple_elem_reinit_after_move_never_dropped (tier 1). A
// TUPLE ELEMENT RE-INITIALISED AFTER ITS PAYLOAD WAS MOVED OUT IS NEVER DROPPED.
//
// `match a.1 { Some(v) => { a.1 = Some(String::from("…")); v } … }` moves the
// payload out of `a.1` and then stores a NEW owned value there. At scope exit
// `a.1` is still recorded as moved, so the new value's destructor never runs:
// 2 allocs / 1 free, 22 bytes definitely lost, rc 0.
//
// THE STRUCT DOOR IS CORRECT. The identical program over
// `struct S { o: Option<String> }` — `match s.o { Some(v) => { s.o = Some(…); v } }`
// — reads 2 allocs / 2 frees, 0 errors. Two spellings of one operation disagree,
// which is the same shape as C2 (`drop_old` computed for one of four place kinds)
// but a DIFFERENT predicate: C2 is about dropping the OLD value at the store,
// this is about dropping the NEW one at scope exit, and the two doors are
// swapped — the struct door leaks in C2 and is correct here.
//
// ROOT, by property: the re-initialisation does not clear the moved record for a
// TUPLE_INDEX place. `moved_vars_` is keyed by path text and the struct path is
// un-marked where the tuple path is not; `SemaChecker::emit_frame_drops`'s
// `eligible` then returns nullptr for the container.
//
// Found by tests/lattice/valgrind/sweep.sh; corpus member
// tests/imported/pass/match/issue-19367-b170.logos (4 allocs / 3 frees, 12 bytes
// definitely lost, green through run_test.sh — its `.expected` pins only the
// exit code). Rust: exit 0, no leak.
//
// ⚠ THE ORACLE IS A DESTRUCTOR COUNT: 1001 = the moved-out payload AND the
// re-initialised one, 1 = only the moved-out one. Today 1, exit 1; correct
// 1001, exit 0. THE STRUCT CONTROL WITH THE SAME COUNTER READS 1001 TODAY.
package tuple_elem_reinit_after_move_never_dropped;

struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    {
        let mut a: (i64, Option<D>) = (0i64, Some(D { v: 1i64, c: p }));
        let b: D = match a.1 {
            Some(v) => { a.1 = Some(D { v: 1000i64, c: p }); v }
            None => { return 3i32; }
        };
        if b.v != 1i64 { return 4i32; }
    }
    let got: i64 = unsafe { n };
    if got != 1001i64 { return 1i32; }
    return 0i32;
}
