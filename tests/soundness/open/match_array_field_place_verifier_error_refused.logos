// SOUNDNESS QUEUE row match_array_field_place_verifier_error_refused (tier 3, refuses). A MATCH
// WHOSE SCRUTINEE IS AN ARRAY-TYPED FIELD OR TUPLE ELEMENT ESCAPES AN MLIR VERIFIER ERROR AS THE
// USER-VISIBLE REFUSAL.
//
// `match s.arr { [_, y] => { return y.v; } }` over `struct S { arr: [D; 2], .. }`: rustc compiles
// and runs, k=2 n=21 (twin x1_field_scrutinee.rs). TODAY logosc refuses with
//   error: 'llvm.getelementptr' op operand #0 must be LLVM pointer type or LLVM dialect-compatible
//   vector of LLVM pointer type, but got '!llvm.array<2 x struct<...>>'
// — an MLIR VERIFIER message, not a diagnostic. The TUPLE-ELEMENT spelling `match t.0 { [_, y] =>
// ... }` prints the byte-identical error (twin x1b_tuple_elem_scrutinee.rs, rustc k=2 n=21), and
// the same array reached through a LOCAL first (`let a2 = s.arr; match a2 { ... }`) compiles — so
// the fact is the array-typed PLACE BASE at the match door, not the array pattern.
// Found 2026-09-16c-armelem by hand programs h07 / x07d. Legality MEASURED with rustc 1.98.1.
package match_array_field_place_verifier_error_refused;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct S { arr: [D; 2], tag: i64 }
fn g(p: *mut i64) -> i64 {
    let s: S = S { arr: [D { v: 1i64, c: p }, D { v: 2i64, c: p }], tag: 7i64 };
    match s.arr {
        [_, y] => { return y.v; }
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    let got: i64 = unsafe { n };
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 2i64 { return 2i32; }
    if got != 21i64 { return 1i32; }
    return 0i32;
}
