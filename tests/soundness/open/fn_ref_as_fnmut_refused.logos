// SOUNDNESS QUEUE row fn_ref_as_fnmut_refused (tier 3, `refuses`). `&F` with `F: Fn` passed where
// `G: FnMut` is expected (Rust's `impl<F: Fn> FnMut for &F`) is refused by the borrow checker:
// "'f' is written or mutably borrowed behind a `&` reference". Calling an FnMut that is a `&F`
// only reads through the reference. rustc 1.98.1 prints 6 and exits 0.
// Found by the 2026-10-12 bounds-at-call probes.
package fn_ref_as_fnmut_refused;
use logos.std.fmt;
fn once<F: FnOnce() -> i32>(f: F) -> i32 { f() }
fn twice<F: FnMut() -> i32>(mut f: F) -> i32 { f() + once(f) }
fn thrice<F: Fn() -> i32>(f: F) -> i32 { twice(&f) + f() }
fn main() { println!("{}", thrice(|| 2)); }
