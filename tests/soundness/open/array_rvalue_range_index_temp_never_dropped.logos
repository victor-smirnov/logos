// SOUNDNESS QUEUE row array_rvalue_range_index_temp_never_dropped (tier 1). AN ARRAY RVALUE INDEXED BY A RANGE IS NEVER DROPPED.
//
// `mkarr(p)[0..1].len()`: lower_index_read's RANGE arm decays an Array value to `&[T; N]` with a bare
// `addr_of_temp` (src/compiler/sema_expr.cpp), so the array temporary has no owner and neither element is destroyed.
// Priced by probe `idxrangehoist` (statement-temp hoist at this site): closes this program, 0 -> 1001.
//
// Found 2026-09-14n-autoreftemp by hand program h35, measured on base b54c1160ae8e4066 43 and on the probed
// binary 15fbccc186107d4b 43 unarmed (identical). Rust: exit 0. Legality by reading; no rustc binary on this box.
// ⚠ THE ORACLE IS A DESTRUCTOR COUNT through a raw `*mut i64`: today 0, exit 1; correct 1001, exit 0.
package array_rvalue_range_index_temp_never_dropped;
use logos.lang.cmp;
use logos.mem.string;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
impl Eq for D { fn eq(&self, other: &D) -> bool { return self.v > 0i64 && other.v > 0i64; } }
fn mkarr(p: *mut i64) -> [D; 2] { return [D { v: 1i64, c: p }, D { v: 1000i64, c: p }]; }
fn body(p: *mut i64) -> i64 {
    let k: i64 = mkarr(p)[0i64..1i64].len() as i64;
    return k - 1i64;
}

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = body(p);
    let got: i64 = unsafe { n };
    unsafe { printf("n=%ld r=%ld\n".as_ptr(), got, r); }
    if r != 0i64 { return 2i32; }
    if got != 1001i64 { return 1i32; }
    return 0i32;
}
