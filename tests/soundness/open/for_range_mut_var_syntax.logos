// SOUNDNESS QUEUE row for_range_mut_var_syntax (tier 3). 'for mut i in 0..3' is
// legal Rust (a mutable loop binding). TODAY the grammar's range-for header takes a
// bare IDENT and the program is a syntax error at 'mut'. The iterator/array form
// 'for mut x in v' parses (a PAT); only the range form lacks the spelling. Found
// 2026-09-06 (PROBES.md, hand h16). Rust: exit 0.
package for_range_mut_var_syntax;
fn main() -> i32 {
    let mut acc: i64 = 0i64;
    for mut i in 0i64..3i64 {
        i = i + 10i64;
        acc = acc + i;
    }
    if acc != 33i64 { return 1i32; }
    return 0i32;
}
