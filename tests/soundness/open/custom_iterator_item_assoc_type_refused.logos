// rustc: Reproduced verbatim: rustc compiles and runs cleanly, exit code 15 (0+1+2+3+4+5).
// fix hint: stdlib iter.logos: Iterator { type Item; } (already ticketed design-level item Iterator<Item> param -> assoc).
package custom_iterator_item_assoc_type_refused;

struct Counter {
    count: i32,
    max: i32,
}

impl Iterator for Counter {
    type Item = i32;
    fn next(&mut self) -> Option<i32> {
        if self.count < self.max {
            self.count = self.count + 1;
            return Option::Some(self.count);
        }
        return Option::None;
    }
}

fn main() -> i32 {
    let mut c = Counter { count: 0, max: 5 };
    let mut sum = 0;
    for x in c {
        sum = sum + x;
    }
    return sum;
}
