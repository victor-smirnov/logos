// SOUNDNESS QUEUE row slice_copy_elem_no_default_mut_ref (tier 3). `match &mut arr {
// [a, b] => { *a = *a + 1; } }` over `arr: [i64; 2]` is legal Rust — the `&mut` scrutinee
// sets the default binding mode to `ref mut`, so `a: &mut i64` and the write lands in
// `arr`. TODAY refused with the same two sentences as its tuple and struct twins: "write
// through raw pointer requires unsafe context" and "deref-write: '=' left side must be a
// pointer or mutable reference". SAME ROOT, THIRD DOOR: the wrap in bind_pattern_ref's
// SLICE arm is gated on `is_move_type(elem_t)`, so a Copy element under a reference
// scrutinee still binds by value. Found 2026-09-06i by the same census.
// ⚠ HALF A MECHANISM, MEASURED: probe `dbmslc` drops the carve-out and the refusal becomes
// "'llvm.load' op operand #0 must be LLVM pointer type, but got 'i64'" — codegen binds the
// raw element and never reads the binding type. Rust: exit 0.
package slice_copy_elem_no_default_mut_ref;
fn main() -> i32 {
    let mut arr: [i64; 2] = [3i64, 4i64];
    match &mut arr {
        [a, b] => { *a = *a + 1i64; if *b != 4i64 { return 2i32; } }
    }
    if arr[0] != 4i64 { return 1i32; }
    return 0i32;
}
