// SOUNDNESS QUEUE row for_range_var_assign_admit (tier 2). Assigning to a range-for
// loop variable declared without 'mut' is ILLEGAL (rustc E0384). TODAY it compiles
// rc 0 (sema defines the range-for var as mutable, lower_for) AND the write STEERS THE
// LOOP at run time — the named var IS the induction slot (gen_for), so `i = i + 10`
// makes the next test 11 < 3 fail: acc = 10, one iteration (MEASURED 2026-09-09a; the
// 09-06 record's "lost, acc = 3" was wrong). Exits 1 where rustc refuses. Found
// 2026-09-06 (PROBES.md, hand h17).
package for_range_var_assign_admit;
fn main() -> i32 {
    let mut acc: i64 = 0i64;
    for i in 0i64..3i64 {
        i = i + 10i64;
        acc = acc + i;
    }
    if acc != 33i64 { return 1i32; }
    return 0i32;
}
