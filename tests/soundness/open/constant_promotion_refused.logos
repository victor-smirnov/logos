// Logos: logosc rejects with 'error [fn get]: line 4: cannot return reference to temporary value: dangling reference'. The same rejection reproduces verbatim for the FLS-called-out special case &mut [] returned as &mut [i32].
// rustc: rustc 1.98.1 compiles cleanly and the binary runs printing 5 (exit 0): the literal 5 is const-promoted to an anonymous 'static constant per Rust's constant-promotion rule, so the returned reference is not dangling.
// fix hint: borrow check/mlir_gen: promote constant-expression borrows to static storage.
package constant_promotion_refused;

fn get() -> &i32 {
    return &5;
}

fn main() -> i32 {
    let r = get();
