// SOUNDNESS QUEUE row static_array_whole_borrow_reads_garbage (tier 1).
// `&ARR` of a `static ARR: [i64; 3]` indexes garbage: the whole-array borrow
// of a static does not address the global's elements (`ARR[2]` and `&ARR[2]`
// are right, `let s = &ARR; s[2]` and `g(&ARR)` read other memory, and the
// value differs run to run). Legal Rust; rustc exits 0.
package static_array_whole_borrow_reads_garbage;
static ARR: [i64; 3] = [5i64, 2i64, 7i64];
fn third(s: &[i64; 3]) -> i64 {
    return s[2];
}
fn main() -> i32 {
    let s = &ARR;
    if s[0] != 5i64 { return 1i32; }
    if third(&ARR) != 7i64 { return 2i32; }
    return 0i32;
}
