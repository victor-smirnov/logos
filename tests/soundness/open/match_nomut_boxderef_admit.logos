// SOUNDNESS QUEUE row match_nomut_boxderef_admit (tier 2). A match-arm binding
// written WITHOUT 'mut' over a Box payload, then '&mut *bb': ILLEGAL (rustc E0596,
// bb is not declared mutable). TODAY it compiles rc 0: the borrow checker masks the
// binding-mut question for every pattern-bound name (pat_bound, the deref_mut site)
// because the LIR carries no by-value pattern 'mut'. The twin of the CLOSED
// destructure_no_mut_box_deref; the same for 'if let Some(bb)' and a nested
// 'Some(W { b: bb })'. Priced 2026-09-06 (PROBES.md, patmutwhole: refused with the
// right sentence once the bit is carried and the mask retired).
package match_nomut_boxderef_admit;
enum E { A(Box<i64>), B }
fn main() -> i32 {
    let e: E = E::A(Box::new(1i64));
    match e {
        E::A(bb) => { let r: &mut i64 = &mut *bb; *r = 8i64; },
        E::B => {}
    }
    return 0i32;
}
