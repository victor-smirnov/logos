// SOUNDNESS QUEUE row range_pattern_under_ref_scrutinee (tier 3). `match &v { 1..=5 => … }`
// is legal Rust — under a reference scrutinee the default binding mode is by-ref and the
// range pattern matches the POINTEE — and TODAY it is refused "range pattern requires integer
// scrutinee, got '&i64'". Measured independent of the `@`-binding: the program below has no
// `@`, and the `n @ 1..=5` spelling is refused with the identical sentence. Found 2026-09-09d
// (hand g07, control n3). Rust: exit 0.
package range_pattern_under_ref_scrutinee;
fn main() -> i32 {
    let v: i64 = 4i64;
    let mut out: i64 = 0i64;
    match &v {
        1i64..=5i64 => { out = 1i64; }
        _ => { out = -1i64; }
    }
    if out != 1i64 { return 1i32; }
    return 0i32;
}
