// SOUNDNESS QUEUE row mem_swap_is_unsafe_raw_pointer_refused (tier 3, `refuses`). `mem::swap(&mut a, &mut b)`
// is "call to unsafe function 'swap' requires unsafe context": logos.lang.mem declares
// `pub unsafe fn swap<T>(a: *mut T, b: *mut T)` (the ptr::swap signature). rustc 1.98.1: core::mem::swap is
// the SAFE `fn swap<T>(x: &mut T, y: &mut T)`; exit 2. Found by the ADR 0030 C-INF battery (2026-09-30).
package mem_swap_is_unsafe_raw_pointer_refused;
fn main() -> i32 { let mut a = 1i64; let mut b = 2i64; logos.lang.mem::swap(&mut a, &mut b); return a as i32; }
