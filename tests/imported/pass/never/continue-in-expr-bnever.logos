// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/never_type (divergence family, distilled)
// Modifications: synthesized from the never-type divergence feature set —
//   `continue` is a diverging (`!`) expression usable in value position inside
//   a loop body (here as a let-init / match arm), coercing away.
// Tests `continue` used in expression position.
package continue_in_expr_bnever;

fn sum_evens(limit: i32) -> i32 {
    let mut acc: i32 = 0i32;
    let mut i: i32 = 0i32;
    while i < limit {
        let cur: i32 = i;
        i = i + 1i32;
        // odd -> continue (a `!` expr used as the value of `add`)
        let add: i32 = if cur % 2i32 == 0i32 { cur } else { continue };
        acc = acc + add;
    }
    return acc;
}

fn main() -> i32 {
    // evens in 0..6: 0+2+4 = 6
    if sum_evens(6i32) != 6i32 { return 1i32; }
    // evens in 0..5: 0+2+4 = 6
    if sum_evens(5i32) != 6i32 { return 2i32; }
    return 0i32;
}
