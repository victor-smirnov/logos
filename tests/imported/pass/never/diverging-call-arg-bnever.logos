package diverging_call_arg_bnever;

fn id(x: bool) -> bool {
    return x;
}

fn use_return(c: bool) -> bool {
    // `return true` here diverges; using it as an arg to id() must typecheck.
    let r: bool = id(if c { true } else { return false });
    return r;
}

fn main() -> i32 {
    if use_return(true) != true { return 1i32; }
    if use_return(false) != false { return 2i32; }
    return 0i32;
}
