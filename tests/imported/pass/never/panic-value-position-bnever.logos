// Modifications: `let x: ! = panic!(); let y: u32 = x;` adapted — panic() is
//   `-> !` in Logos and is usable in value position, coercing to the expected
//   type. We guard it behind a branch that main never takes so it exits 0.
// Tests `panic("...")` used as a value of an arbitrary type via coercion.
package panic_value_position_bnever;

fn get(c: bool) -> u32 {
    let y: u32 = if c { 42u32 } else { panic("unreachable") };
    return y;
}

fn main() -> i32 {
    if get(true) != 42u32 { return 1i32; }
    return 0i32;
}
