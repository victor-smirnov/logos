// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/never_type (divergence/coercion family, distilled)
// Modifications: synthesized from the never-type coercion feature — an
//   if / else-if / else chain where the trailing `else` diverges (`return`)
//   adopts the type of the value-producing branches. usize/isize -> i64.
// Tests if-expr LUB where the diverging arm coerces to the other arms' type.
package if_else_diverge_chain_bnever;

fn lookup(k: i32) -> i64 {
    let v: i64 = if k == 1i32 {
        100i64
    } else if k == 2i32 {
        200i64
    } else {
        return -1i64
    };
    return v;
}

fn main() -> i32 {
    if lookup(1i32) != 100i64 { return 1i32; }
    if lookup(2i32) != 200i64 { return 2i32; }
    if lookup(9i32) != -1i64 { return 3i32; }
    return 0i32;
}
