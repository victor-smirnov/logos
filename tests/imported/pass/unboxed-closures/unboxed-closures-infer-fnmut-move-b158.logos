// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/unboxed-closures/unboxed-closures-infer-fnmut-move.rs
// Modifications: i32->i64; assert_eq! -> early-return sentinels.
// Tests a `move` FnMut closure (captures `counter` by value, mutates the copy):
//   calling it twice mutates the closure's own copy (returns 2), the outer
//   `counter` stays 0.
package uc_infer_fnmut_move_b158;

fn main() -> i32 {
    let mut counter: i64 = 0i64;
    let v: i64 = {
        let mut tick = move || -> i64 { counter = counter + 1i64; return counter; };
        tick();
        tick()
    };
    if counter != 0i64 { return 1i32; }
    if v != 2i64 { return 2i32; }
    return 0i32;
}
