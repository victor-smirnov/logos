// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/unboxed-closures/unboxed-closures-extern-fn.rs
// Modifications: `extern` ABI marker dropped; isize->i64; the `&F`/`&mut F`
//   receiver forms reshaped to by-value `F` because calling through `&F`/`&mut F`
//   doesn't autoderef-invoke yet (G158-1); assert -> sentinels.
// Tests that a fn item implements the full range of Fn traits — the same `square`
//   fn item satisfies an `F: Fn`, an `F: FnMut`, and an `F: FnOnce` bound.
package uc_extern_fn_b158;

fn square(x: i64) -> i64 { return x * x; }

fn call_it<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 { return f(x); }
fn call_it_mut<F: FnMut(i64) -> i64>(mut f: F, x: i64) -> i64 { return f(x); }
fn call_it_once<F: FnOnce(i64) -> i64>(f: F, x: i64) -> i64 { return f(x); }

fn main() -> i32 {
    let x = call_it(square, 22i64);
    let y = call_it_mut(square, 22i64);
    let z = call_it_once(square, 22i64);
    if x != square(22i64) { return 1i32; }
    if y != square(22i64) { return 2i32; }
    if z != square(22i64) { return 3i32; }
    return 0i32;
}
