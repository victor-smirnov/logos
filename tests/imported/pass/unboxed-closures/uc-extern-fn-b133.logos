package uc_extern_fn_b133;

fn square(x: i64) -> i64 { return x * x; }

fn call_it<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 { return f(x); }
fn call_it_mut<F: FnMut(i64) -> i64>(mut f: F, x: i64) -> i64 { return f(x); }
fn call_it_once<F: FnOnce(i64) -> i64>(f: F, x: i64) -> i64 { return f(x); }

fn main() -> i32 {
    if call_it(square, 22i64) != square(22i64) { return 1i32; }
    if call_it_mut(square, 22i64) != square(22i64) { return 2i32; }
    if call_it_once(square, 22i64) != square(22i64) { return 3i32; }
    return 0i32;
}
