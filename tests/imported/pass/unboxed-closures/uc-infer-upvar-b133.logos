package uc_infer_upvar_b133;

fn f<F: FnMut()>(mut g: F) {
    g();
}

fn main() -> i32 {
    let mut acc: i64 = 0i64;
    f(|| { acc = acc + 7i64; });
    if acc != 7i64 { return 1i32; }
    return 0i32;
}
