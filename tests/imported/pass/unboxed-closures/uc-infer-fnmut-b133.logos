package uc_infer_fnmut_b133;

fn main() -> i32 {
    let mut counter: i64 = 0i64;
    {
        let mut tick = || { counter = counter + 1i64; };
        tick();
        tick();
    }
    if counter != 2i64 { return 1i32; }
    return 0i32;
}
