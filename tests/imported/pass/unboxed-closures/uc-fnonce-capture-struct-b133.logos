// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: distilled from tests/ui/unboxed-closures/unboxed-closures-
// infer-fnonce.rs (the DropMe/mem::drop facet, which needs a borrow-into-Drop,
// is replaced by capturing an owned struct value). Tests a move-closure that
// captures an owned (non-Copy) struct BY VALUE and reads its fields, passed to
// an `F: FnOnce()->i64`-bounded HOF and called once.
package uc_fnonce_capture_struct_b133;

struct Payload { a: i64, b: i64 }

fn run_once<F: FnOnce() -> i64>(f: F) -> i64 { return f(); }

fn main() -> i32 {
    let p: Payload = Payload { a: 30i64, b: 12i64 };
    let total: i64 = run_once(move || -> i64 { return p.a + p.b; });
    if total != 42i64 { return 1i32; }
    return 0i32;
}
