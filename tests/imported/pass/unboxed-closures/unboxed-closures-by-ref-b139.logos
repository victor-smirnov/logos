// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/unboxed-closures/unboxed-closures-by-ref.rs
// Modifications: assert_eq! -> nonzero ret; usize -> u64; the `call_fn(|| ..)`
//   body (which asserted x==0) -> empty body; closures given block bodies;
//   `+=` -> explicit add.
// Tests dispatching closures through the three call-trait bounds `F: Fn()`,
//   `F: FnMut()`, `F: FnOnce()`, where the FnMut/FnOnce closures capture and
//   mutate an environment variable by reference.
package unboxed_closures_by_ref_b139;

fn call_fn<F: Fn()>(f: F) { f() }
fn call_fn_mut<F: FnMut()>(mut f: F) { f() }
fn call_fn_once<F: FnOnce()>(f: F) { f() }

fn main() -> i32 {
    let mut x: u64 = 0u64;
    let y: u64 = 2u64;

    call_fn(|| { });
    call_fn_mut(|| { x = x + y; });
    call_fn_once(|| { x = x + y; });

    if x != y * 2u64 { return 1i32; }
    return 0i32;
}
