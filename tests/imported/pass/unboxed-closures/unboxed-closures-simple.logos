package uc_unboxed_closures_simple;

use logos.lang.ops;

fn main() -> i32 {
    let f = |x: i64, y: i64| -> i64 { return x + y; };
    let z = f(1i64, 2i64);
    if z != 3i64 { return 1; }
    return 0;
}
