package unboxed_closures_generic_b155;

fn call_it<F: FnMut(i32, i32) -> i32>(y: i32, mut f: F) -> i32 {
    return f(2i32, y);
}

fn main() -> i32 {
    let f = |x: i32, y: i32| -> i32 { return x + y; };
    let z = call_it(3i32, f);
    if z != 5i32 { return 1i32; }
    return 0i32;
}
