package fun_call_variants_b146;

fn ho<F>(f: F) -> i64 where F: FnOnce(i64) -> i64 { let n: i64 = f(3i64); return n; }

fn direct(x: i64) -> i64 { return x + 1i64; }

fn main() -> i32 {
    let a: i64 = direct(3i64);
    let b: i64 = ho(direct);
    if a != b { return 1i32; }
    return 0i32;
}
