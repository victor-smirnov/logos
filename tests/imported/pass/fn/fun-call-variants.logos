// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/fn/fun-call-variants.rs
// Modifications: direct-bound form `<F: FnOnce(isize) -> isize>` in
// lieu of `where`. Tests that a plain fn-pointer can be passed
// through the Fn-family bound — same semantics as in Rust. The
// fn-ptr-as-Fn-bound path was closed in a Sprint 5.7 follow-up
// (mono_clone ClosureCall → FnPtrCall dispatch when F resolves to
// FnPtr).
package fun_call_variants;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

fn ho<F: FnOnce(isize) -> isize>(f: F) -> isize {
    return f(3isize);
}

fn direct(x: isize) -> isize { return x + 1isize; }

fn main() -> i32 {
    let a: isize = direct(3isize);
    let b: isize = ho(direct);
    assert_eq!(a, b);
    return 0;
}
