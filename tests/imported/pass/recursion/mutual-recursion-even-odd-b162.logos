// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/recursion/ mutual-recursion shapes (distilled).
// Modifications: isize->i64; assert->if-return sentinels. Two mutually-recursive
//   free fns `is_even`/`is_odd` each calling the other; plus a recursive `fib`.
// Tests mutual recursion between two free fns and self-recursion (fibonacci).
package mutual_recursion_even_odd_b162;

fn is_even(n: i64) -> bool {
    if n == 0i64 { return true; }
    return is_odd(n - 1i64);
}
fn is_odd(n: i64) -> bool {
    if n == 0i64 { return false; }
    return is_even(n - 1i64);
}

fn fib(n: i64) -> i64 {
    if n < 2i64 { return n; }
    return fib(n - 1i64) + fib(n - 2i64);
}

fn main() -> i32 {
    if !is_even(10i64) { return 1i32; }
    if is_even(7i64) { return 2i32; }
    if !is_odd(3i64) { return 3i32; }
    if is_odd(8i64) { return 4i32; }
    if fib(10i64) != 55i64 { return 5i32; }
    return 0i32;
}
