package recursion_factorial_b138;

fn fact(n: i64) -> i64 {
    if n <= 1i64 { return 1i64; }
    return n * fact(n - 1i64);
}

fn main() -> i32 {
    if fact(5i64) != 120i64 { return 1i32; }
    if fact(0i64) != 1i64 { return 2i32; }
    if fact(10i64) != 3628800i64 { return 3i32; }
    return 0i32;
}
