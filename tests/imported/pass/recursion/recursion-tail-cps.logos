// Imported from rust-lang/rust tests/ui/recursion/recursion-tail-cps.rs
// Modifications: isize -> i64; println! dropped; main returns i32.
package recursion_tail_cps_test;

use std.fmt;
use std.lang.text;

fn checktrue(rs: bool) -> bool {
    assert!(rs);
    return true;
}

fn evenk(n: i64, k: fn(bool) -> bool) -> bool {
    if n == 0i64 {
        return k(true);
    } else {
        return oddk(n - 1i64, k);
    }
}

fn oddk(n: i64, k: fn(bool) -> bool) -> bool {
    if n == 0i64 {
        return k(false);
    } else {
        return evenk(n - 1i64, k);
    }
}

fn main() -> i32 {
    let k = checktrue;
    evenk(42i64, k);
    oddk(45i64, k);
    return 0;
}
