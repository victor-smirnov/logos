// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/recursion/ shapes (distilled).
// Modifications: isize->i64; assert->if-return sentinels. A recursive Euclidean GCD
//   and a recursive factorial, both pure self-recursion over i64.
// Tests deep self-recursion (Euclid GCD via `%`) plus recursive factorial.
package gcd_recursive_b163;

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0i64 { return a; }
    return gcd(b, a % b);
}

fn fact(n: i64) -> i64 {
    if n <= 1i64 { return 1i64; }
    return n * fact(n - 1i64);
}

fn main() -> i32 {
    if gcd(48i64, 18i64) != 6i64 { return 1i32; }
    if gcd(17i64, 5i64) != 1i64 { return 2i32; }
    if gcd(100i64, 0i64) != 100i64 { return 3i32; }
    if fact(5i64) != 120i64 { return 4i32; }
    return 0i32;
}
