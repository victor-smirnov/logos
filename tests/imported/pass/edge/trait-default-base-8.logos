package trait_default_base_8;
trait T8 {
    fn val(self: &Self) -> i32;
    fn plus(self: &Self) -> i32 { return self.val() + 8i32; }
}
struct S8 { v: i32 }
impl T8 for S8 { fn val(self: &S8) -> i32 { return self.v; } }
fn main() -> i32 {
    let s: S8 = S8 { v: 0i32 };
    return s.plus() - 8i32;
}
