package trait_default_base_6;
trait T6 {
    fn val(self: &Self) -> i32;
    fn plus(self: &Self) -> i32 { return self.val() + 6i32; }
}
struct S6 { v: i32 }
impl T6 for S6 { fn val(self: &S6) -> i32 { return self.v; } }
fn main() -> i32 {
    let s: S6 = S6 { v: 0i32 };
    return s.plus() - 6i32;
}
