package trait_default_base_10;
trait T10 {
    fn val(self: &Self) -> i32;
    fn plus(self: &Self) -> i32 { return self.val() + 10i32; }
}
struct S10 { v: i32 }
impl T10 for S10 { fn val(self: &S10) -> i32 { return self.v; } }
fn main() -> i32 {
    let s: S10 = S10 { v: 0i32 };
    return s.plus() - 10i32;
}
