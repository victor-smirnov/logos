// GAP: `let r: &dyn Speak = &s;` (let-binding of dyn-trait ref) +
// dispatch via r.val() → segfault. Related to dyn-in-struct gap;
// dyn-trait ref let-init doesn't construct vtable correctly.
package dyn_let_init_gap;
trait Speak { fn val(self: &Self) -> i32; }
struct S { v: i32 }
impl Speak for S { fn val(self: &S) -> i32 { return self.v; } }
fn main() -> i32 { return 0i32; }
