package trait_mut_then_read;
trait Counter {
    fn bump(self: &mut Self);
    fn get(self: &Self) -> i32;
}
struct C { v: i32 }
impl Counter for C {
    fn bump(self: &mut C) { (*self).v = (*self).v + 1i32; }
    fn get(self: &C) -> i32 { return (*self).v; }
}
fn main() -> i32 {
    let mut c: C = C { v: 0i32 };
    c.bump();
    c.bump();
    return c.get() - 2i32;
}
