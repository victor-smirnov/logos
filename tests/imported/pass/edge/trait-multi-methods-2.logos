package trait_multi_methods_2;
trait Many2 { fn a(self: &Self) -> i32; fn b(self: &Self) -> i32; fn c(self: &Self) -> i32; }
struct S2 { v: i32 }
impl Many2 for S2 {
    fn a(self: &S2) -> i32 { return self.v + 1i32; }
    fn b(self: &S2) -> i32 { return self.v + 2i32; }
    fn c(self: &S2) -> i32 { return self.v + 3i32; }
}
fn main() -> i32 {
    let s: S2 = S2 { v: 0i32 };
    return s.a() + s.b() + s.c() - 6i32;
}
