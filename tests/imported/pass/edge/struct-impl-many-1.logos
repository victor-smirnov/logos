package struct_impl_many_1;
struct S1 { v: i32 }
impl S1 {
    fn a(self: &S1) -> i32 { return self.v + 1i32; }
    fn b(self: &S1) -> i32 { return self.v + 1i32 * 2i32; }
    fn c(self: &S1) -> i32 { return self.v + 1i32 * 3i32; }
}
fn main() -> i32 {
    let s: S1 = S1 { v: 0i32 };
    return s.a() + s.b() + s.c() - 6i32;
}
