package trait_default_base_5;
trait T5 {
    fn val(self: &Self) -> i32;
    fn plus(self: &Self) -> i32 { return self.val() + 5i32; }
}
struct S5 { v: i32 }
impl T5 for S5 { fn val(self: &S5) -> i32 { return self.v; } }
fn main() -> i32 {
    let s: S5 = S5 { v: 0i32 };
    return s.plus() - 5i32;
}
