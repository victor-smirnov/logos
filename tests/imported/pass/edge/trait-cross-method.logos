package trait_cross_method;
trait T {
    fn a(self: &Self) -> i32;
    fn b(self: &Self) -> i32;
    fn sum(self: &Self) -> i32 { return self.a() + self.b(); }
}
struct S { v: i32 }
impl T for S {
    fn a(self: &S) -> i32 { return self.v; }
    fn b(self: &S) -> i32 { return self.v * 2i32; }
}
fn main() -> i32 {
    let s: S = S { v: 3i32 };
    return s.sum() - 9i32;
}
