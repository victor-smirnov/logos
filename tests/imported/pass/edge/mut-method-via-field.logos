package mut_method_via_field;
struct Inner { v: i32 }
impl Inner { fn bump(self: &mut Inner) { (*self).v = (*self).v + 1i32; } }
struct Outer { i: Inner }
fn main() -> i32 {
    let mut o: Outer = Outer { i: Inner { v: 0i32 } };
    o.i.bump();
    o.i.bump();
    o.i.bump();
    return o.i.v - 3i32;
}
