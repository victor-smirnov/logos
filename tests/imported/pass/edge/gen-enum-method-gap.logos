// CLOSED 2026-05-13: generic-enum method dispatch (`b.is_some()` for
// `b: Bag<i32>` with `fn is_some(self: &Bag<T>)`) now auto-refs the
// receiver. Fix: sema_expr generic-enum dispatch path forgot the
// formal0-vs-recv ref/ptr auto-addr logic that the primitive/struct
// branches already had — added it (substituted formal type through
// the enum type-arg subst before comparison).
package gen_enum_method_gap;
enum Bag<T> { Some(T), None }
impl<T> Bag<T> {
    fn is_some(self: &Bag<T>) -> bool {
        match self {
            Bag::Some(_) => return true,
            Bag::None    => return false,
        }
    }
}
fn main() -> i32 {
    let b: Bag<i32> = Bag::Some(7i32);
    if b.is_some() { return 0i32; } else { return 1i32; }
}
