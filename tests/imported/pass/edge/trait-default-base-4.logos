package trait_default_base_4;
trait T4 {
    fn val(self: &Self) -> i32;
    fn plus(self: &Self) -> i32 { return self.val() + 4i32; }
}
struct S4 { v: i32 }
impl T4 for S4 { fn val(self: &S4) -> i32 { return self.v; } }
fn main() -> i32 {
    let s: S4 = S4 { v: 0i32 };
    return s.plus() - 4i32;
}
