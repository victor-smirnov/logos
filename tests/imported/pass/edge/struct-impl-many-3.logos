package struct_impl_many_3;
struct S3 { v: i32 }
impl S3 {
    fn a(self: &S3) -> i32 { return self.v + 3i32; }
    fn b(self: &S3) -> i32 { return self.v + 3i32 * 2i32; }
    fn c(self: &S3) -> i32 { return self.v + 3i32 * 3i32; }
}
fn main() -> i32 {
    let s: S3 = S3 { v: 0i32 };
    return s.a() + s.b() + s.c() - 18i32;
}
