package struct_impl_many_4;
struct S4 { v: i32 }
impl S4 {
    fn a(self: &S4) -> i32 { return self.v + 4i32; }
    fn b(self: &S4) -> i32 { return self.v + 4i32 * 2i32; }
    fn c(self: &S4) -> i32 { return self.v + 4i32 * 3i32; }
}
fn main() -> i32 {
    let s: S4 = S4 { v: 0i32 };
    return s.a() + s.b() + s.c() - 24i32;
}
