// Tests Option combinators map / unwrap_or / and_then over i64 payloads.
package option_combinators_b164;

fn half(x: i64) -> Option<i64> {
    if x % 2i64 == 0i64 { return Option::Some(x / 2i64); }
    return Option::None;
}

fn main() -> i32 {
    let a: Option<i64> = Option::Some(10i64);
    if a.map(|v: i64| -> i64 { return v + 1i64; }).unwrap_or(0i64) != 11i64 { return 1i32; }

    let b: Option<i64> = Option::None;
    if b.map(|v: i64| -> i64 { return v + 1i64; }).unwrap_or(99i64) != 99i64 { return 2i32; }

    if a.and_then(half).unwrap_or(-1i64) != 5i64 { return 3i32; }

    let c: Option<i64> = Option::Some(7i64);
    if c.and_then(half).unwrap_or(-1i64) != -1i64 { return 4i32; }
    return 0i32;
}
