//   - bare `Some(...)` / `None` accepted via prelude shorthand (CP-cm-03)
//   - `isize` works in Logos
package test_option;

use std.fmt;
use std.lang.text;
use std.lang.option;

#[test]
fn test_unwrap() {
    assert_eq!(Some(1isize).unwrap(), 1isize);
}

#[test]
#[should_panic]
fn test_unwrap_panic1() {
    let x: Option<isize> = None;
    x.unwrap();
}

#[test]
fn test_unwrap_or() {
    let x: Option<isize> = Some(1isize);
    assert_eq!(x.unwrap_or(2isize), 1isize);

    let y: Option<isize> = None;
    assert_eq!(y.unwrap_or(2isize), 2isize);
}

#[test]
fn test_is_some_is_none() {
    let s: Option<i32> = Some(7i32);
    assert!(s.is_some());
    assert!(!s.is_none());
    let n: Option<i32> = None;
    assert!(!n.is_some());
    assert!(n.is_none());
}

#[test]
fn test_or_typed() {
    // None-receiver T-inference closed 2026-05-14 via hint_enum_type_
    // propagation: bare `None` in a let-annotated `Option<i32>` context
    // now lowers as Option<i32> directly. Upstream `None.or(Some(7))`
    // shape works.
    let combined: Option<i32> = None.or(Some(7i32));
    assert_eq!(combined.unwrap(), 7i32);
}

#[test]
fn test_and() {
    // Faithful upstream `test_and` Some/None matrix.
    let a: Option<i32> = Some(1i32);
    let b: Option<i32> = Some(2i32);
    assert_eq!(a.and(b).unwrap(), 2i32);

    let n: Option<i32> = None;
    assert!(a.and(n).is_none());
    assert!(n.and(a).is_none());
    assert!(n.and(n).is_none());
}

// Faithful port of upstream `test_and_then`. `const fn` keyword in
// Rust is stripped per the project-level Divergence (CP-cm-04 — Logos
// uses metacall for compile-time evaluation, not `const fn`); these
// fns work fine at run-time which is what `assert_eq!` exercises.
fn plus_one(x: isize) -> Option<isize> {
    return Some(x + 1isize);
}

fn no_more(_x: isize) -> Option<isize> {
    return None;
}

#[test]
fn test_and_then() {
    let x: Option<isize> = Some(1isize);
    assert_eq!(x.and_then(plus_one).unwrap(), 2isize);
    assert!(x.and_then(no_more).is_none());

    let y: Option<isize> = None;
    assert!(y.and_then(plus_one).is_none());
    assert!(y.and_then(no_more).is_none());
}

fn two() -> Option<isize> {
    return Some(2isize);
}

fn nothing() -> Option<isize> {
    return None;
}

#[test]
fn test_or_else() {
    let x: Option<isize> = Some(1isize);
    assert_eq!(x.or_else(two).unwrap(), 1isize);
    assert_eq!(x.or_else(nothing).unwrap(), 1isize);

    let y: Option<isize> = None;
    assert_eq!(y.or_else(two).unwrap(), 2isize);
    assert!(y.or_else(nothing).is_none());
}
