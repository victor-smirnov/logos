package test_option;

use std.fmt;
use std.lang.text;
use std.lang.option;

#[test]
fn test_unwrap() {
    assert_eq!(Some(1isize).unwrap(), 1isize);
}

#[test]
#[should_panic]
fn test_unwrap_panic1() {
    let x: Option<isize> = None;
    x.unwrap();
}

#[test]
fn test_unwrap_or() {
    let x: Option<isize> = Some(1isize);
    assert_eq!(x.unwrap_or(2isize), 1isize);

    let y: Option<isize> = None;
    assert_eq!(y.unwrap_or(2isize), 2isize);
}

#[test]
fn test_is_some_is_none() {
    let s: Option<i32> = Some(7i32);
    assert!(s.is_some());
    assert!(!s.is_none());
    let n: Option<i32> = None;
    assert!(!n.is_some());
    assert!(n.is_none());
}

#[test]
fn test_or_typed() {
    // `None.or(Some(x))` doesn't infer T from None — bind None to a typed
    // local first (gap noted in feat_phase4a_option_methods.md).
    let n: Option<i32> = None;
    let some_seven: Option<i32> = Some(7i32);
    let combined: Option<i32> = n.or(some_seven);
    assert_eq!(combined.unwrap(), 7i32);
}
