// Original path: library/coretests/tests/option.rs (test_iter subset)
//
// Modifications:
// - Rust's `for x in opt` syntactic sugar over IntoIterator isn't
//   yet wired in Logos's for-loop lowering (only arrays/slices and
//   types with a direct `.next` method are accepted). Use explicit
//   `.into_iter()` plus a manual loop.
// - `.size_hint()` assertions dropped (no SizeHint surface yet).
// - assert_eq! family imports via std.fmt + std.lang.text.
//
// Stdlib companion: `impl<T> IntoIterator<T> for Option<T>` (with
// `type Iter = OptionIter<T>`) in std/lang/iter/iter.logos. Backing
// struct holds `state: Option<T>`; `.next()` `.take`s and yields.

package test_option_iter;

use std.fmt;
use std.lang.text;
use logos.lang.iter;
use logos.lang.option;

#[test]
fn test_some_iter() {
    let x: Option<i32> = Some(42i32);
    let mut it = x.into_iter();
    match it.next() {
        Option::Some(v) => { assert_eq!(v, 42i32); }
        Option::None    => { assert_eq!(true, false); }
    }
    // Second .next() yields None.
    match it.next() {
        Option::Some(_) => { assert_eq!(true, false); }
        Option::None    => { }
    }
}

#[test]
fn test_none_iter() {
    let x: Option<i32> = None;
    let mut it = x.into_iter();
    match it.next() {
        Option::Some(_) => { assert_eq!(true, false); }
        Option::None    => { }
    }
}

#[test]
fn test_some_iter_back() {
    // DEI: next_back on Some yields the same value, then None.
    let x: Option<i32> = Some(7i32);
    let mut it = x.into_iter();
    match it.next_back() {
        Option::Some(v) => { assert_eq!(v, 7i32); }
        Option::None    => { assert_eq!(true, false); }
    }
    match it.next_back() {
        Option::Some(_) => { assert_eq!(true, false); }
        Option::None    => { }
    }
}
