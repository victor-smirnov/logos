package assoc_const_per_impl_b163;

trait Poly {
    const SIDES: i64;
    fn sides(self: &Self) -> i64;
}

struct Tri {}
struct Quad {}

impl Poly for Tri {
    const SIDES: i64 = 3i64;
    fn sides(self: &Self) -> i64 { return Tri::SIDES; }
}
impl Poly for Quad {
    const SIDES: i64 = 4i64;
    fn sides(self: &Self) -> i64 { return Quad::SIDES; }
}

fn main() -> i32 {
    if Tri::SIDES != 3i64 { return 1i32; }
    if Quad::SIDES != 4i64 { return 2i32; }
    let t: Tri = Tri {};
    let q: Quad = Quad {};
    if t.sides() != 3i64 { return 3i32; }
    if q.sides() != 4i64 { return 4i32; }
    if (Tri::SIDES + Quad::SIDES) != 7i64 { return 5i32; }
    return 0i32;
}
