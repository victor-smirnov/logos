// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7:
//   library/coretests/tests/num/uint_macros.rs (subset, instantiated at u64)
//
// Subset rationale: Logos's u64 surface includes count_ones / count_zeros /
// leading_zeros / trailing_zeros / rotate_{left,right} / swap_bytes / pow /
// max / min / clamp. Surfaces missing in Logos (trailing_ones, leading_ones,
// bit_width, funnel_shift, carryless_mul, extract_bits, deposit_bits,
// reverse_bits) are skipped — they aren't yet implemented in std.lang.ord.
//
// Const-context tests (`assert_eq_const_safe!`) lower to runtime asserts —
// Logos doesn't run const-eval; metacall is the compile-time channel.

package test_coretest_u64;

use std.fmt;
use std.lang.text;
use std.lang.ord;

const A: u64 = 0b0101100u64;
const B: u64 = 0b0100001u64;
const C: u64 = 0b1111001u64;

const _0: u64 = 0u64;
// !0 — Logos has no Not on u64 here; spell it out.
const _1: u64 = 0xFFFFFFFFFFFFFFFFu64;

#[test]
fn test_overflows() {
    // u64::MAX > 0; u64::MIN <= 0 (always true — MIN is 0).
    assert!(_1 > 0u64);
}

#[test]
fn test_count_ones() {
    assert!(A.count_ones() == 3u32);
    assert!(B.count_ones() == 2u32);
    assert!(C.count_ones() == 5u32);
}

#[test]
fn test_count_zeros() {
    assert!(A.count_zeros() == 64u32 - 3u32);
    assert!(B.count_zeros() == 64u32 - 2u32);
    assert!(C.count_zeros() == 64u32 - 5u32);
}

#[test]
fn test_rotate() {
    assert!(A.rotate_left(6u32).rotate_right(2u32).rotate_right(4u32) == A);
    assert!(B.rotate_left(3u32).rotate_left(2u32).rotate_right(5u32) == B);
    assert!(C.rotate_left(6u32).rotate_right(2u32).rotate_right(4u32) == C);

    // Rotating zero / all-ones by anything is identity.
    assert!(_0.rotate_left(7u32)  == _0);
    assert!(_1.rotate_left(7u32)  == _1);
    assert!(_0.rotate_right(7u32) == _0);
    assert!(_1.rotate_right(7u32) == _1);

    // Rotating by 0 — identity.
    assert!(A.rotate_left(0u32) == A);
    assert!(B.rotate_left(0u32) == B);
    assert!(C.rotate_left(0u32) == C);
}

#[test]
fn test_swap_bytes() {
    assert!(A.swap_bytes().swap_bytes() == A);
    assert!(B.swap_bytes().swap_bytes() == B);
    assert!(C.swap_bytes().swap_bytes() == C);
    assert!(_0.swap_bytes() == _0);
    assert!(_1.swap_bytes() == _1);
}

#[test]
fn test_leading_trailing_zeros() {
    assert!(_0.leading_zeros()  == 64u32);
    assert!(_0.trailing_zeros() == 64u32);
    assert!(_1.leading_zeros()  == 0u32);
    assert!(_1.trailing_zeros() == 0u32);

    let x: u64 = 0b0010_1100u64;
    assert!(x.trailing_zeros() == 2u32);

    let y: u64 = 0x8000000000000000u64;
    assert!(y.leading_zeros() == 0u32);
    assert!(y.trailing_zeros() == 63u32);
}

#[test]
fn test_pow() {
    assert!(2u64.pow(0u32)  == 1u64);
    assert!(2u64.pow(1u32)  == 2u64);
    assert!(2u64.pow(10u32) == 1024u64);
    assert!(3u64.pow(4u32)  == 81u64);
    assert!(10u64.pow(6u32) == 1000000u64);
}

#[test]
fn test_max_min_clamp() {
    assert!(3u64.max(7u64) == 7u64);
    assert!(3u64.min(7u64) == 3u64);
    assert!(5u64.clamp(2u64, 8u64) == 5u64);
    assert!(1u64.clamp(2u64, 8u64) == 2u64);
    assert!(9u64.clamp(2u64, 8u64) == 8u64);
}
