// (`n & BITS-1`), explicit k==0 corner case (shifting by BITS is UB).

package test_i32_rotate;

use std.fmt;
use std.lang.text;
use logos.lang.cmp;

#[test]
fn test_rotate_roundtrip() {
    let a: u32 = 0b0101100u32;
    let b: u32 = 0b0100001u32;
    let c: u32 = 0b1111001u32;
    assert_eq!(a.rotate_left(6u32).rotate_right(2u32).rotate_right(4u32), a);
    assert_eq!(b.rotate_left(3u32).rotate_left(2u32).rotate_right(5u32),  b);
    assert_eq!(c.rotate_left(6u32).rotate_right(2u32).rotate_right(4u32), c);
}

#[test]
fn test_rotate_byte_aligned_u32() {
    // 0x12345678 rotated left by 8 = 0x34567812.
    let a: u32 = 0x12345678u32;
    assert_eq!(a.rotate_left(8u32),  0x34567812u32);
    assert_eq!(a.rotate_left(16u32), 0x56781234u32);
    assert_eq!(a.rotate_left(24u32), 0x78123456u32);
    assert_eq!(a.rotate_left(32u32), a);
    assert_eq!(a.rotate_right(4u32), 0x81234567u32);
}

#[test]
fn test_rotate_zero() {
    assert_eq!(0u32.rotate_left(7u32),  0u32);
    assert_eq!(0u32.rotate_right(13u32), 0u32);
    let x: u32 = 0xDEADBEEFu32;
    assert_eq!(x.rotate_left(0u32),  x);
    assert_eq!(x.rotate_right(0u32), x);
}

#[test]
fn test_rotate_overlong() {
    // Rotation by BITS is identity.
    let x: u32 = 0xDEADBEEFu32;
    assert_eq!(x.rotate_left(32u32),  x);
    assert_eq!(x.rotate_right(32u32), x);
    // Rotation by N*BITS+k is rotation by k.
    assert_eq!(x.rotate_left(96u32 + 4u32),  x.rotate_left(4u32));
    assert_eq!(x.rotate_right(96u32 + 4u32), x.rotate_right(4u32));
}

#[test]
fn test_rotate_i32() {
    // i32 .rotate_left preserves bit pattern (delegates to u32 form).
    let a: i32 = 0x12345678i32;
    assert_eq!(a.rotate_left(8u32).rotate_right(8u32), a);
}

#[test]
fn test_rotate_u64() {
    let x: u64 = 0x0123456789ABCDEFu64;
    assert_eq!(x.rotate_left(64u32),  x);
    assert_eq!(x.rotate_right(64u32), x);
    assert_eq!(x.rotate_left(8u32),  0x23456789ABCDEF01u64);
}
