package test_i32_bitcount;

use std.fmt;
use std.lang.text;
use logos.lang.cmp;

#[test]
fn test_count_ones() {
    let a: i32 = 0b0101100i32;        // 3 ones
    let b: i32 = 0b0100001i32;        // 2 ones
    let c: i32 = 0b1111001i32;        // 5 ones
    assert_eq!(a.count_ones(), 3u32);
    assert_eq!(b.count_ones(), 2u32);
    assert_eq!(c.count_ones(), 5u32);
}

#[test]
fn test_count_zeros() {
    let a: i32 = 0b0101100i32;
    let b: i32 = 0b0100001i32;
    let c: i32 = 0b1111001i32;
    assert_eq!(a.count_zeros(), 29u32);   // 32 - 3
    assert_eq!(b.count_zeros(), 30u32);   // 32 - 2
    assert_eq!(c.count_zeros(), 27u32);   // 32 - 5
}

#[test]
fn test_leading_zeros() {
    assert_eq!((0i32).leading_zeros(),  32u32);
    assert_eq!((1i32).leading_zeros(),  31u32);
    assert_eq!((0b1000i32).leading_zeros(), 28u32);
}

#[test]
fn test_trailing_zeros() {
    assert_eq!((0i32).trailing_zeros(), 32u32);
    assert_eq!((1i32).trailing_zeros(),  0u32);
    assert_eq!((8i32).trailing_zeros(),  3u32);
    assert_eq!((0b110000i32).trailing_zeros(), 4u32);
}

#[test]
fn test_i64_bitcount() {
    assert_eq!((0xFFi64).count_ones(),    8u32);
    assert_eq!((0i64).count_ones(),       0u32);
    assert_eq!((0i64).leading_zeros(),    64u32);
    assert_eq!((1i64).leading_zeros(),    63u32);
    assert_eq!((0i64).trailing_zeros(),   64u32);
    assert_eq!((0b10000i64).trailing_zeros(), 4u32);
}
