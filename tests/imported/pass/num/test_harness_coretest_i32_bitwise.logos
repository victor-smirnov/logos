package test_i32_bitwise_overflow;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

#[test]
fn test_overflows() {
    let max_i32: i32 = 2147483647i32;
    let min_i32: i32 = -2147483647i32 - 1i32;
    assert!(max_i32 > 0i32);
    assert!(min_i32 <= 0i32);
    assert_eq!(min_i32 + max_i32 + 1i32, 0i32);
}

#[test]
fn test_bitwise_operators() {
    // assert_eq!(0b1110, 0b1100.bitor(0b1010)) — Logos accepts the
    // `|` / `&` / `^` operators directly on i32.
    assert_eq!(0b1110i32, 0b1100i32 | 0b1010i32);
    assert_eq!(0b1000i32, 0b1100i32 & 0b1010i32);
    assert_eq!(0b0110i32, 0b1100i32 ^ 0b1010i32);
    assert_eq!(0b1110i32, 0b0111i32 << 1i32);
    assert_eq!(0b0111i32, 0b1110i32 >> 1i32);
    // `!x` = `-x - 1` for two's complement signed.
    assert_eq!(-(0b11i32) - 1i32, !(0b11i32));
}
