// Modifications: dropped the `type FooAlias = Foo` alias used for variant
//   construction (`FooAlias::Bar(..)` is unsupported — G160-2); only
//   `Self::Bar(..)` (tuple variant via Self) is supported — `Self::Baz{..}`
//   (struct variant via Self) and `Self::Qux` (unit variant via Self) are NOT
//   (G160-1), so those use the explicit `Foo::Variant` path; assert!/assert_eq!/
//   check_pat! -> match + early-return sentinels; derive(Debug,PartialEq,Eq)
//   dropped; i32 literals suffixed; Option arm kept via plain `Option::Some`.
// Tests value-namespace resolution to an enum variant via `Self::Bar(..)`
//   inside an impl method, plus plain `Enum::Variant` (tuple/struct/unit)
//   construction + match, including a generic `Option::Some`.
package enum_variant_self_and_paths_b160;

enum Foo { Bar(i32), Baz { i: i32 }, Qux }

impl Foo {
    fn bar() -> Foo {
        let x = Self::Bar(3i32);
        return x;
    }
    fn baz() -> Foo {
        // Self::Baz{..} (struct variant via Self) is unsupported (G160-1);
        // use the explicit enum path instead.
        let x = Foo::Baz { i: 42i32 };
        return x;
    }
    fn qux() -> Foo {
        // Self::Qux (unit variant via Self) is unsupported (G160-1);
        // use the explicit enum path instead.
        let x = Foo::Qux;
        return x;
    }
}

fn main() -> i32 {
    let bar = Foo::Bar(1i32);
    match bar {
        Foo::Bar(n) => { if n != 1i32 { return 1i32; } }
        _ => { return 2i32; }
    }

    let baz = Foo::Baz { i: 2i32 };
    match baz {
        Foo::Baz { i } => { if i != 2i32 { return 3i32; } }
        _ => { return 4i32; }
    }

    let qux = Foo::Qux;
    match qux {
        Foo::Qux => {}
        _ => { return 5i32; }
    }

    match Foo::bar() {
        Foo::Bar(n) => { if n != 3i32 { return 6i32; } }
        _ => { return 7i32; }
    }
    match Foo::baz() {
        Foo::Baz { i } => { if i != 42i32 { return 8i32; } }
        _ => { return 9i32; }
    }
    match Foo::qux() {
        Foo::Qux => {}
        _ => { return 10i32; }
    }

    let some = Option::Some(4i32);
    match some {
        Option::Some(n) => { if n != 4i32 { return 11i32; } }
        _ => { return 12i32; }
    }
    return 0i32;
}
