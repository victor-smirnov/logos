// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/impl-trait/impl-fn-hrtb-bounds.rs (idea distilled)
// Modifications: returning `impl Fn` distilled to a concrete fn-ptr returner
//   (impl-Trait return position over closures isn't on the Logos surface yet,
//   see notes). The point — selecting+invoking one of several fns by tag — is
//   preserved.
// Tests selecting a function pointer by an integer tag and invoking it.
package impl_trait_return_closure_b138;

fn inc(x: i32) -> i32 { return x + 1i32; }
fn dec(x: i32) -> i32 { return x - 1i32; }

fn pick(tag: i32) -> fn(i32) -> i32 {
    if tag == 0i32 { return inc; }
    return dec;
}

fn main() -> i32 {
    let f = pick(0i32);
    let g = pick(1i32);
    if f(10i32) != 11i32 { return 1i32; }
    if g(10i32) != 9i32 { return 2i32; }
    return 0i32;
}
