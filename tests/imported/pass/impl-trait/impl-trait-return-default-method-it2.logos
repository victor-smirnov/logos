// Feature: an `-> impl Trait` fn returns a value whose trait has a DEFAULT method;
// the caller invokes the default method (which calls a required method on self) on
// the opaque result — default-method resolution survives the opaque return.
package impl_trait_return_default_method_it2;

trait Greeter {
    fn id(self: &Self) -> i64;
    fn greet(self: &Self) -> i64 { return self.id() + 100i64; }
}

struct G { k: i64 }
impl Greeter for G { fn id(self: &G) -> i64 { return (*self).k; } }

fn mk(k: i64) -> impl Greeter { return G { k: k }; }

fn main() -> i32 {
    let g = mk(5i64);
    if g.greet() == 105i64 { return 0i32; }
    return 1i32;
}
