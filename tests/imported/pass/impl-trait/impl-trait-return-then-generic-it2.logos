// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/impl-trait/where-allowed.rs shape (distilled)
// Feature: the opaque value from an `-> impl Trait` fn is passed (by ref) into a
// generic fn bounded `T: Trait` — the opaque type unifies with the bound at the
// call site (turbofish names the underlying concrete type W).
package impl_trait_return_then_generic_it2;

trait Doubler { fn dd(self: &Self) -> i64; }

struct W { v: i64 }
impl Doubler for W { fn dd(self: &W) -> i64 { return (*self).v * 2i64; } }

fn wrap(n: i64) -> impl Doubler { return W { v: n }; }
fn use_it<T: Doubler>(t: &T) -> i64 { return t.dd(); }

fn main() -> i32 {
    let a = wrap(7i64);
    if use_it::<W>(&a) == 14i64 { return 0i32; }
    return 1i32;
}
