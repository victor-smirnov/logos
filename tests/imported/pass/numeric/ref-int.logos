package ref_int;

use std.fmt;
use std.lang.text;

fn main() -> i32 {
    let x: i32 = 1i32;
    let y: i32 = 1i32;
    let xr: &i32 = &x;
    let yr: &i32 = &y;
    let eq: bool = *xr == *yr;
    assert!(eq);
    return 0;
}
