package type_limit_comparisons_6130;

use std.fmt;
use std.lang.text;

fn main() -> i32 {
    let u: usize = 0usize;
    assert!(u <= 4294967295usize);

    let i: isize = 0isize;
    assert!(i >= -2147483648isize);
    assert!(i <= 2147483647isize);
    return 0;
}
