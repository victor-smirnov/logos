// `const fn foo()` + `const BOO = foo()` const-fn-eval row is dropped (no const
// fn — Divergence); kept the integer-const match arms `FOO`/`BAR`/`_`;
// `assert_eq!`→return-code check; `pub fn main()`→`fn main()->i32`. Exercises
// matching a value against named integer `const`s as patterns.
package co_consts_in_patterns;

const FOO: i64 = 10i64;
const BAR: i64 = 3i64;

fn main() -> i32 {
    let x: i64 = 3i64;
    let y = match x {
        FOO => 1i64,
        BAR => 2i64,
        _ => 3i64,
    };
    if y != 2i64 { return 1; }
    return 0;
}
