// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/consts/const-fields-and-indexing.rs
// Modifications: the `static` items (which read a const's element/field at init time) are
//   dropped — Logos has no `static` (G153-3) and a const initializer must be a literal /
//   simple-arith / metacall, so const STRUCT/array-of-struct literals are also rejected.
//   The portable, faithful core kept here is CONST-ARRAY indexing read at runtime: a
//   `const X: [i64; 4]` indexed by literal subscripts yields the right elements + arith.
//   println!/assert_eq!→return-code; isize→i64.
// Tests: indexing a const fixed-size array `X[2]`, `X[0]+X[3]` produces the expected
//   values (3 and 5).
package const_fields_and_indexing_b154;

const X: [i64; 4] = [1i64, 2i64, 3i64, 4i64];

fn main() -> i32 {
    if X[2] != 3i64 { return 1i32; }
    if X[0] + X[3] != 5i64 { return 2i32; }
    if X[1] != 2i64 { return 3i32; }
    return 0i32;
}
