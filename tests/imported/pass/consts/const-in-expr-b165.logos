// Tests module-level consts in expressions and loop bounds.
package const_in_expr_b165;

const N: i64 = 4i64;
const FACTOR: i64 = 3i64;

fn main() -> i32 {
    let arr: [i64; 4] = [1i64, 2i64, 3i64, 4i64];
    let mut sum: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < N {
        sum = sum + arr[i] * FACTOR;
        i = i + 1i64;
    }
    if sum != 30i64 { return 1i32; }
    if N * FACTOR != 12i64 { return 2i32; }
    return 0i32;
}
