// - assert_eq! family imports via std.fmt + std.lang.text.

package test_iter_enumerate;

use std.fmt;
use std.lang.text;
use std.lang.iter;
use std.lang.option;

#[test]
fn test_iterator_enumerate() {
    // xs[i] == i for i in 0..6, so the pair's idx and val must agree.
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    unsafe {
        let mut it = iter_enumerate::<SliceIter<i32>, i32>(iter_over_slice(&xs), 0i32);
        loop {
            match it.next() {
                Option::None    => { break; }
                Option::Some(p) => {
                    assert_eq!(p.idx as i32, p.val);
                }
            }
        }
    }
}
