package test_iter_skip;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;

#[test]
fn test_iterator_skip() {
    let xs: [i32; 12] = [0i32, 1i32, 2i32, 3i32, 5i32, 13i32, 15i32, 16i32, 17i32, 19i32, 20i32, 30i32];
    let ys: [i32; 7]  = [13i32, 15i32, 16i32, 17i32, 19i32, 20i32, 30i32];
    unsafe {
        let mut it = iter_skip::<CopiedIter<SliceIter<i32>, i32>, i32>(iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&xs)), 5i64, 0i32);
        let mut i: i32 = 0i32;
        loop {
            match it.next() {
                Option::None    => { break; }
                Option::Some(x) => {
                    assert_eq!(x, ys[i]);
                    i = i + 1i32;
                }
            }
        }
        assert_eq!(i, 7i32);
    }
}
