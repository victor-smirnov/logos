// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/iterators/iter-range.rs
// Modifications: isize -> i64; println! dropped, replaced with an exit-code
//   check of the accumulated sum; closure captures `sum` by &mut.
// Tests a higher-order fn taking `F: FnMut(i64)`, invoked in a while loop, with
//   a closure mutating a captured local (sum += x over 0..100 = 4950).
package iter_range_b150;

fn range_<F>(a: i64, b: i64, mut it: F) where F: FnMut(i64) {
    let mut i: i64 = a;
    while i < b { it(i); i += 1; }
}

fn main() -> i64 {
    let mut sum: i64 = 0;
    range_(0, 100, |x| { sum += x; });
    if sum != 4950 { return 1; }
    return 0;
}
