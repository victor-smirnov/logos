package test_iter_take_while;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;

fn lt15(x: i32) -> bool { return x < 15i32; }

#[test]
fn test_iterator_take_while() {
    let xs: [i32; 10] = [0i32, 1i32, 2i32, 3i32, 5i32, 13i32, 15i32, 16i32, 17i32, 19i32];
    let ys: [i32; 6]  = [0i32, 1i32, 2i32, 3i32, 5i32, 13i32];
    unsafe {
        let mut it = iter_take_while::<SliceIter<i32>, i32>(iter_over_slice(&xs), lt15, 0i32);
        let mut i: i32 = 0i32;
        loop {
            match it.next() {
                Option::None    => { break; }
                Option::Some(x) => {
                    assert_eq!(x, ys[i]);
                    i = i + 1i32;
                }
            }
        }
        assert_eq!(i, 6i32);
    }
}
