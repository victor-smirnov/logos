package u04;
trait MyIter { type Item; fn next2(self: &mut Self) -> Option<Self::Item>; }
struct Counter { n: i64, max: i64 }
impl MyIter for Counter {
    type Item = i64;
    fn next2(self: &mut Counter) -> Option<i64> {
        if self.n < self.max { self.n = self.n + 1i64; return Option::Some(self.n); }
        return Option::None;
    }
}
fn main() -> i32 {
    let mut c: Counter = Counter { n: 0i64, max: 3i64 };
