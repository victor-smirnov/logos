package iter_range_b155;

fn range_<F>(a: i64, b: i64, mut it: F) where F: FnMut(i64) {
    let mut i: i64 = a;
    while i < b {
        it(i);
        i = i + 1i64;
    }
}

fn main() -> i32 {
    let mut sum: i64 = 0i64;
    range_(0i64, 100i64, |x: i64| { sum = sum + x; });
    if sum != 4950i64 { return 1i32; }
    return 0i32;
}
