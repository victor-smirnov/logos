package test_iter_range_full;

use std.fmt;
use std.lang.text;
use std.lang.iter;
use std.lang.range;
use std.lang.option;
use std.collections.vec;

#[test]
fn test_range_collect() {
    unsafe {
        let v: Vec<i32> = (0i32..5i32).collect::<Vec<i32>>();
        assert_eq!(v.len, 5i64);
        assert_eq!(v.ptr[0i64], 0i32);
        assert_eq!(v.ptr[1i64], 1i32);
        assert_eq!(v.ptr[2i64], 2i32);
        assert_eq!(v.ptr[3i64], 3i32);
        assert_eq!(v.ptr[4i64], 4i32);
    }
}

#[test]
fn test_range_rev_collect() {
    unsafe {
        let v: Vec<i32> = (0i32..5i32).rev().collect::<Vec<i32>>();
        assert_eq!(v.len, 5i64);
        assert_eq!(v.ptr[0i64], 4i32);
        assert_eq!(v.ptr[1i64], 3i32);
        assert_eq!(v.ptr[2i64], 2i32);
        assert_eq!(v.ptr[3i64], 1i32);
        assert_eq!(v.ptr[4i64], 0i32);
    }
}

#[test]
fn test_range_negative() {
    unsafe {
        let v: Vec<i32> = (-10i32..-1i32).collect::<Vec<i32>>();
        assert_eq!(v.len, 9i64);
        assert_eq!(v.ptr[0i64], -10i32);
        assert_eq!(v.ptr[8i64], -2i32);
    }
}

#[test]
fn test_range_reversed_bounds() {
    // start > end → empty.
    let r1 = 200i32..(-5i32);
    assert_eq!(r1.count(), 0i64);
    let r2 = (200i32..(-5i32)).rev();
    assert_eq!(r2.count(), 0i64);
    let r3 = 200i32..200i32;
    assert_eq!(r3.count(), 0i64);
}

#[test]
fn test_range_sum() {
    // 1..=10 → 55
    let s: i32 = (1i32..11i32).sum::<i32>();
    assert_eq!(s, 55i32);
}

#[test]
fn test_range_exhaustion() {
    let mut r = 10i32..10i32;
    assert_eq!(r.len(), 0i64);
    match r.next() {
        Option::Some(_) => { assert_eq!(true, false); }
        Option::None    => { }
    }
    match r.next_back() {
        Option::Some(_) => { assert_eq!(true, false); }
        Option::None    => { }
    }
}
