#[test]
fn test_iterator_peekable_find() {
    let xs: [i32; 5] = [10i32, 20i32, 30i32, 40i32, 50i32];
    unsafe {
        let mut it = iter_peekable::<SliceIter<i32>, i32>(iter_over_slice(&xs), 0i32);
        match it.find(eq_40) {
            Option::Some(v) => { assert_eq!(v, 40i32); }
            Option::None    => { assert_eq!(true, false); }
        }
    }
}

#[test]
fn test_iterator_filter_nth() {
    let xs: [i32; 9] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32, 6i32, 7i32, 8i32];
    unsafe {
        let mut it = iter_filter::<SliceIter<i32>, i32>(iter_over_slice(&xs), is_even);
        match it.nth(2i64) {
            Option::Some(v) => { assert_eq!(v, 4i32); }
            Option::None    => { assert_eq!(true, false); }
        }
    }
}

#[test]
fn test_iterator_map_count() {
    let xs: [i32; 4] = [1i32, 2i32, 3i32, 4i32];
    unsafe {
        let n: i64 = iter_map(iter_over_slice(&xs), neg).count();
        assert_eq!(n, 4i64);
    }
}

#[test]
fn test_iterator_take_count() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    unsafe {
        let n: i64 = iter_take::<SliceIter<i32>, i32>(iter_over_slice(&xs), 4i64, 0i32).count();
        assert_eq!(n, 4i64);
    }
}

#[test]
fn test_iterator_take_find() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    unsafe {
        let mut it = iter_take::<SliceIter<i32>, i32>(iter_over_slice(&xs), 5i64, 0i32);
        match it.find(eq_4) {
            Option::Some(v) => { assert_eq!(v, 4i32); }
            Option::None    => { assert_eq!(true, false); }
        }
    }
}

#[test]
fn test_iterator_take_while_count() {
    let xs: [i32; 9] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32, 6i32, 7i32, 8i32];
    unsafe {
        let n: i64 = iter_take_while::<SliceIter<i32>, i32>(iter_over_slice(&xs), lt_5, 0i32).count();
        assert_eq!(n, 5i64);
    }
}

#[test]
fn test_iterator_skip_while_count() {
    let xs: [i32; 9] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32, 6i32, 7i32, 8i32];
    unsafe {
        let n: i64 = iter_skip_while::<SliceIter<i32>, i32>(iter_over_slice(&xs), lt_5, 0i32).count();
        assert_eq!(n, 4i64);
    }
}

#[test]
fn test_iterator_step_by_count() {
    // 0..12 stride 3 → 0,3,6,9 → 4 items.
    let xs: [i32; 12] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32, 6i32, 7i32, 8i32, 9i32, 10i32, 11i32];
    unsafe {
        let n: i64 = iter_step_by::<SliceIter<i32>, i32>(iter_over_slice(&xs), 3i64, 0i32).count();
        assert_eq!(n, 4i64);
    }
}

#[test]
fn test_iterator_inspect_count() {
    let xs: [i32; 4] = [10i32, 20i32, 30i32, 40i32];
    unsafe {
        let n: i64 = iter_inspect::<SliceIter<i32>, i32>(iter_over_slice(&xs), noop, 0i32).count();
        assert_eq!(n, 4i64);
    }
}

#[test]
fn test_iterator_zip_count() {
    let xs: [i32; 5] = [0i32, 1i32, 2i32, 4i32, 5i32];
    let ys: [i32; 3] = [10i32, 11i32, 12i32];
    unsafe {
        let n: i64 = iter_zip::<SliceIter<i32>, SliceIter<i32>, i32, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32, 0i32).count();
        // Stops at shorter (length 3).
        assert_eq!(n, 3i64);
    }
}

#[test]
fn test_iterator_zip_last() {
    let xs: [i32; 5] = [0i32, 1i32, 2i32, 4i32, 5i32];
    let ys: [i32; 3] = [10i32, 11i32, 12i32];
    unsafe {
        match iter_zip::<SliceIter<i32>, SliceIter<i32>, i32, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32, 0i32).last() {
            Option::Some(p) => {
                assert_eq!(p.first,  2i32);
                assert_eq!(p.second, 12i32);
            }
            Option::None => { assert_eq!(true, false); }
        }
    }
}
