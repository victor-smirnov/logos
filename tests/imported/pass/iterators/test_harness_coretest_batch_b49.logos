// Multi-source coretest batch (B49), imported from
// rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7.
//
// Bundles 20+ tiny tests from iter/adapters/* + iter/traits/* +
// option.rs / result.rs / cmp.rs into one harness file so a single
// `--test` synthesised main runs them all under panic-recovery.
//
// Source paths (one #[test] fn per upstream test; adapted to Logos's
// free-fn adapter constructors + named fn-ptr predicates):
//
//   iter/adapters/enumerate.rs::test_iterator_enumerate_count
//   iter/adapters/enumerate.rs::test_iterator_enumerate_nth
//   iter/adapters/chain.rs::test_iterator_chain_nth
//   iter/adapters/chain.rs::test_iterator_chain_find
//   iter/adapters/skip.rs::test_iterator_skip_nth
//   iter/adapters/peekable.rs::test_iterator_peekable_nth
//   iter/adapters/peekable.rs::test_iterator_peekable_last
//   iter/adapters/filter.rs::test_iterator_filter_nth
//   iter/adapters/map.rs::test_iterator_map_count
//   iter/adapters/take_while.rs::test_iterator_take_while_count
//   iter/adapters/skip_while.rs::test_iterator_skip_while_count
//   iter/adapters/step_by.rs::test_iterator_step_by_count
//   iter/adapters/inspect.rs::test_iterator_inspect_count (visit-fn does nothing)
//   iter/adapters/zip.rs::test_iterator_zip_count
//   iter/adapters/zip.rs::test_iterator_zip_last
//   iter/adapters/peekable.rs::test_iterator_peekable_find
//   iter/adapters/take.rs::test_iterator_take_count
//   iter/adapters/take.rs::test_iterator_take_find
//   iter/adapters/skip.rs::test_iterator_skip_find
//   iter/adapters/chain.rs::test_iterator_chain_any
//   iter/adapters/chain.rs::test_iterator_chain_all
//
// `.nth(N)` consumes the iter in Logos (Rust's takes &mut self), so
// chained `.nth` calls rebuild the source iter per call. assert_eq!
// macros via logos.std.fmt + std.lang.text.

package test_iter_batch_b49;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;

fn is_even(x: i32) -> bool { return (x % 2i32) == 0i32; }
fn eq_4(x: i32)    -> bool { return x == 4i32; }
fn eq_40(x: i32)   -> bool { return x == 40i32; }
fn eq_50(x: i32)   -> bool { return x == 50i32; }
fn eq_5(x: i32)    -> bool { return x == 5i32; }
fn lt_5(x: i32)    -> bool { return x < 5i32; }
fn lt_3(x: i32)    -> bool { return x < 3i32; }
fn lt_100(x: i32)  -> bool { return x < 100i32; }
fn gt_100(x: i32)  -> bool { return x > 100i32; }
fn neg(x: i32) -> i32 { return 0i32 - x; }
fn noop(_x: i32) { return; }

#[test]
fn test_iterator_enumerate_count() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    unsafe {
        let n: i64 = iter_enumerate::<SliceIter<i32>, i32>(iter_over_slice(&xs), 0i32).count();
        assert_eq!(n, 6i64);
    }
}

#[test]
fn test_iterator_enumerate_nth() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    unsafe {
        let mut k: i32 = 0i32;
        while k < 6i32 {
            let mut it = iter_enumerate::<SliceIter<i32>, i32>(iter_over_slice(&xs), 0i32);
            match it.nth(k as i64) {
                Option::Some(p) => {
                    assert_eq!(p.idx as i32, k);
                    assert_eq!(p.val, k);
                }
                Option::None => { assert_eq!(true, false); }
            }
            k = k + 1i32;
        }
    }
}

#[test]
fn test_iterator_chain_nth() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    let ys: [i32; 4] = [30i32, 40i32, 50i32, 60i32];
    let want: [i32; 10] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32, 30i32, 40i32, 50i32, 60i32];
    unsafe {
        let mut k: i32 = 0i32;
        while k < 10i32 {
            let mut it = iter_chain::<SliceIter<i32>, SliceIter<i32>, i32>(
                iter_over_slice(&xs), iter_over_slice(&ys), 0i32);
            match it.nth(k as i64) {
                Option::Some(v) => { assert_eq!(v, want[k]); }
                Option::None    => { assert_eq!(true, false); }
            }
            k = k + 1i32;
        }
    }
}

#[test]
fn test_iterator_chain_find() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    let ys: [i32; 4] = [30i32, 40i32, 50i32, 60i32];
    unsafe {
        let mut it1 = iter_chain::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32);
        match it1.find(eq_4) {
            Option::Some(v) => { assert_eq!(v, 4i32); }
            Option::None    => { assert_eq!(true, false); }
        }
        let mut it2 = iter_chain::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32);
        match it2.find(eq_40) {
            Option::Some(v) => { assert_eq!(v, 40i32); }
            Option::None    => { assert_eq!(true, false); }
        }
    }
}

#[test]
fn test_iterator_chain_any() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    let ys: [i32; 4] = [30i32, 40i32, 50i32, 60i32];
    unsafe {
        let mut it1 = iter_chain::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32);
        assert_eq!(it1.any(eq_50), true);
        let mut it2 = iter_chain::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32);
        assert_eq!(it2.any(gt_100), false);
    }
}

#[test]
fn test_iterator_chain_all() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    let ys: [i32; 4] = [30i32, 40i32, 50i32, 60i32];
    unsafe {
        let mut it1 = iter_chain::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32);
        assert_eq!(it1.all(lt_100), true);
        let mut it2 = iter_chain::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32);
        assert_eq!(it2.all(lt_5), false);
    }
}

#[test]
fn test_iterator_skip_nth() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    unsafe {
        let mut it = iter_skip::<SliceIter<i32>, i32>(iter_over_slice(&xs), 2i64, 0i32);
        match it.nth(1i64) {
            Option::Some(v) => { assert_eq!(v, 3i32); }
            Option::None    => { assert_eq!(true, false); }
        }
    }
}

#[test]
fn test_iterator_skip_find() {
    let xs: [i32; 9] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32, 6i32, 7i32, 8i32];
    unsafe {
        let mut it = iter_skip::<SliceIter<i32>, i32>(iter_over_slice(&xs), 3i64, 0i32);
        match it.find(is_even) {
            Option::Some(v) => { assert_eq!(v, 4i32); }
            Option::None    => { assert_eq!(true, false); }
        }
    }
}

#[test]
fn test_iterator_peekable_nth() {
    let xs: [i32; 5] = [10i32, 20i32, 30i32, 40i32, 50i32];
