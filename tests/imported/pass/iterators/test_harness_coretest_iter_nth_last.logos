package test_iter_nth_last;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;

#[test]
fn test_iterator_nth() {
    let v: [i32; 5] = [0i32, 1i32, 2i32, 3i32, 4i32];
    unsafe {
        // For each i in 0..5, .nth(i) yields v[i].
        let mut i: i32 = 0i32;
        while i < 5i32 {
            let mut it = iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&v));
            match it.nth(i as i64) {
                Option::Some(x) => { assert_eq!(x, v[i]); }
                Option::None    => { assert_eq!(true, false); }
            }
            i = i + 1i32;
        }
        // .nth(len) past the end is None.
        let mut it_end = iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&v));
        match it_end.nth(5i64) {
            Option::Some(_) => { assert_eq!(true, false); }
            Option::None    => { }
        }
    }
}

#[test]
fn test_iterator_last() {
    let v: [i32; 5] = [0i32, 1i32, 2i32, 3i32, 4i32];
    unsafe {
        // .last on a 5-element source yields the last (4).
        let it = iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&v));
        match it.last() {
            Option::Some(x) => { assert_eq!(x, 4i32); }
            Option::None    => { assert_eq!(true, false); }
        }
        // .last on a 1-element prefix yields the first (0).
        let it1 = iter_take::<CopiedIter<SliceIter<i32>, i32>, i32>(iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&v)), 1i64, 0i32);
        match it1.last() {
            Option::Some(x) => { assert_eq!(x, 0i32); }
            Option::None    => { assert_eq!(true, false); }
        }
    }
}
