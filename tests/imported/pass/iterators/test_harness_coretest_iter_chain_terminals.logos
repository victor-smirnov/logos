package test_iter_chain_terminals;

use std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;

#[test]
fn test_iterator_chain_count() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    let ys: [i32; 4] = [30i32, 40i32, 50i32, 60i32];
    unsafe {
        let n: i64 = iter_chain::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32).count();
        assert_eq!(n, 10i64);
    }
}

#[test]
fn test_iterator_chain_last() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    let ys: [i32; 4] = [30i32, 40i32, 50i32, 60i32];
    unsafe {
        match iter_chain::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32).last() {
            Option::Some(v) => { assert_eq!(v, 60i32); }
            Option::None    => { assert_eq!(true, false); }
        }
    }
}
