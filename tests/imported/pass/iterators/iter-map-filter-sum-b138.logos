// Tests an iterator pipeline over a slice: filter (even) then fold to a sum.
package iter_map_filter_sum_b138;

// #112: the stdlib predicate/comparator surface now BORROWS (Rust shape:
// `filter(&T)`, `find(&T)`, `take_while(&T)`, `min_by(&T,&T)`, `partition(&T)`).
fn is_even(x: &i32) -> bool {
    return (*x % 2i32) == 0i32;
}

fn add(acc: i32, x: i32) -> i32 {
    return acc + x;
}

fn main() -> i32 {
    let v: [i32; 6] = [1i32, 2i32, 3i32, 4i32, 5i32, 6i32];
    let mut total: i32 = 0i32;
    unsafe {
        let it = iter_filter(iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&v)), is_even);
        total = iter_fold(it, 0i32, add);
    }
    if total != 12i32 { return 1i32; }
    return 0i32;
}
