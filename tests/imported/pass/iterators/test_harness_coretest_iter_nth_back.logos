package test_iter_nth_back;

use std.fmt;
use std.lang.text;
use std.lang.iter;
use std.lang.option;

#[test]
fn test_iterator_nth_back_basic() {
    let v: [i32; 5] = [0i32, 1i32, 2i32, 3i32, 4i32];
    unsafe {
        // nth_back(0) yields the last item.
        let mut it = iter_over_slice(&v);
        match it.nth_back(0i64) {
            Option::Some(x) => { assert_eq!(x, 4i32); }
            Option::None    => { assert_eq!(true, false); }
        }
        // nth_back(i) yields v[len-1-i] for i in [0, len).
        let mut i: i32 = 0i32;
        while (i as i64) < 5i64 {
            let mut it_i = iter_over_slice(&v);
            match it_i.nth_back(i as i64) {
                Option::Some(x) => { assert_eq!(x, v[4i32 - i]); }
                Option::None    => { assert_eq!(true, false); }
            }
            i = i + 1i32;
        }
        // nth_back(len) is None (past start).
        let mut it_past = iter_over_slice(&v);
        match it_past.nth_back(5i64) {
            Option::Some(_) => { assert_eq!(true, false); }
            Option::None    => { }
        }
    }
}

#[test]
fn test_iterator_rev_nth_back() {
    // .rev().nth_back(i) yields what .nth(i) would on the original.
    let v: [i32; 5] = [0i32, 1i32, 2i32, 3i32, 4i32];
    unsafe {
        let mut i: i32 = 0i32;
        while (i as i64) < 5i64 {
            let mut it = iter_over_slice(&v).rev();
            match it.nth_back(i as i64) {
                Option::Some(x) => { assert_eq!(x, v[i]); }
                Option::None    => { assert_eq!(true, false); }
            }
            i = i + 1i32;
        }
    }
}
