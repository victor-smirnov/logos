package test_iter_step_by;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;

#[test]
fn test_iterator_step_by_identity() {
    let xs: [i32; 3] = [0i32, 1i32, 2i32];
    unsafe {
        let mut it = iter_step_by::<CopiedIter<SliceIter<i32>, i32>, i32>(iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&xs)), 1i64, 0i32);
        match it.next() {
            Option::Some(v) => { assert_eq!(v, 0i32); }
            Option::None    => { assert_eq!(true, false); }
        }
        match it.next() {
            Option::Some(v) => { assert_eq!(v, 1i32); }
            Option::None    => { assert_eq!(true, false); }
        }
        match it.next() {
            Option::Some(v) => { assert_eq!(v, 2i32); }
            Option::None    => { assert_eq!(true, false); }
        }
        match it.next() {
            Option::Some(_) => { assert_eq!(true, false); }
            Option::None    => { }
        }
    }
}

#[test]
fn test_iterator_step_by_3() {
    // 0..12 with step 3 → 0, 3, 6, 9.
    let xs: [i32; 12] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32, 6i32, 7i32, 8i32, 9i32, 10i32, 11i32];
    let want: [i32; 4] = [0i32, 3i32, 6i32, 9i32];
    unsafe {
        let mut it = iter_step_by::<CopiedIter<SliceIter<i32>, i32>, i32>(iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&xs)), 3i64, 0i32);
        let mut i: i32 = 0i32;
        loop {
            match it.next() {
                Option::None    => { break; }
                Option::Some(x) => {
                    assert_eq!(x, want[i]);
                    i = i + 1i32;
                }
            }
        }
        assert_eq!(i, 4i32);
    }
}
