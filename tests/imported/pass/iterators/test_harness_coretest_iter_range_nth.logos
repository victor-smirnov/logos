// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7:
//   library/coretests/tests/iter/range.rs::test_range_nth, test_range_nth_back.
//
// Exercises Iterator::nth trait-default + DoubleEndedIterator::nth_back
// trait-default on RangeI32 / RangeI64.

package test_coretest_iter_range_nth;

use std.fmt;
use std.lang.text;
use std.lang.iter;
use logos.lang.range;
use logos.lang.option;

#[test]
fn test_range_nth_some() {
    let mut r1: RangeI32 = 10i32..15i32;
    match r1.nth(0i64) {
        Option::Some(v) => { assert_eq!(v, 10i32); }
        Option::None    => { assert!(false); }
    }
    let mut r2: RangeI32 = 10i32..15i32;
    match r2.nth(1i64) {
        Option::Some(v) => { assert_eq!(v, 11i32); }
        Option::None    => { assert!(false); }
    }
    let mut r3: RangeI32 = 10i32..15i32;
    match r3.nth(4i64) {
        Option::Some(v) => { assert_eq!(v, 14i32); }
        Option::None    => { assert!(false); }
    }
}

#[test]
fn test_range_nth_none() {
    let mut r: RangeI32 = 10i32..15i32;
    assert!(r.nth(5i64).is_none());
}

#[test]
fn test_range_nth_consumes() {
    // Faithful upstream chain — nth advances the same iterator.
    let mut r: RangeI32 = 10i32..20i32;
    match r.nth(2i64) {
        Option::Some(v) => { assert_eq!(v, 12i32); }
        Option::None    => { assert!(false); }
    }
    // Next nth(2) skips 13,14 and yields 15.
    match r.nth(2i64) {
        Option::Some(v) => { assert_eq!(v, 15i32); }
        Option::None    => { assert!(false); }
    }
    // r is positioned past 15 — nth(10) overshoots, returns None.
    assert!(r.nth(10i64).is_none());
}

#[test]
fn test_range_nth_back_some() {
    let mut r1: RangeI32 = 10i32..15i32;
    match r1.nth_back(0i64) {
        Option::Some(v) => { assert_eq!(v, 14i32); }
        Option::None    => { assert!(false); }
    }
    let mut r2: RangeI32 = 10i32..15i32;
    match r2.nth_back(1i64) {
        Option::Some(v) => { assert_eq!(v, 13i32); }
        Option::None    => { assert!(false); }
    }
    let mut r3: RangeI32 = 10i32..15i32;
    match r3.nth_back(4i64) {
        Option::Some(v) => { assert_eq!(v, 10i32); }
        Option::None    => { assert!(false); }
    }
}

#[test]
fn test_range_nth_back_none() {
    let mut r: RangeI32 = 10i32..15i32;
    assert!(r.nth_back(5i64).is_none());
}

#[test]
fn test_range_i64_nth() {
    let mut r1: RangeI64 = 100i64..200i64;
    match r1.nth(5i64) {
        Option::Some(v) => { assert_eq!(v, 105i64); }
        Option::None    => { assert!(false); }
    }
    let mut r2: RangeI64 = 100i64..200i64;
    match r2.nth(99i64) {
        Option::Some(v) => { assert_eq!(v, 199i64); }
        Option::None    => { assert!(false); }
    }
    let mut r3: RangeI64 = 100i64..200i64;
    assert!(r3.nth(100i64).is_none());
}
