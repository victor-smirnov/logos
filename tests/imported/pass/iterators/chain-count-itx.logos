// Feature: iter_chain concatenating two slice iterators, terminated by .count().
package chain_count_itx;
use logos.lang.iter;
fn main() -> i32 {
    let xs: [i32; 3] = [1i32, 2i32, 3i32];
    let ys: [i32; 3] = [4i32, 5i32, 6i32];
    unsafe {
        let n: i64 = iter_chain::<CopiedIter<SliceIter<i32>, i32>, CopiedIter<SliceIter<i32>, i32>, i32>(
            iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&xs)), iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&ys)), 0i32).count();
        if n != 6i64 { return 1i32; }
    }
    return 0i32;
}
