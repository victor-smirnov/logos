package test_iter_array;

use std.fmt;
use std.lang.text;
use std.lang.iter;
use std.lang.option;
use std.collections.vec;

#[test]
fn iterator_collect() {
    let arr: [i32; 5] = [0i32, 1i32, 2i32, 5i32, 9i32];
    unsafe {
        let v: Vec<i32> = iter_over_slice(&arr).collect::<Vec<i32>>();
        assert_eq!(v.len, 5i64);
        let mut i: i32 = 0i32;
        while (i as i64) < v.len {
            assert_eq!(v.ptr[i as i64], arr[i]);
            i = i + 1i32;
        }
    }
}

#[test]
fn iterator_rev_collect() {
    let arr: [i32; 5] = [0i32, 1i32, 2i32, 5i32, 9i32];
    let want: [i32; 5] = [9i32, 5i32, 2i32, 1i32, 0i32];
    unsafe {
        let v: Vec<i32> = iter_over_slice(&arr).rev().collect::<Vec<i32>>();
        assert_eq!(v.len, 5i64);
        let mut i: i32 = 0i32;
        while (i as i64) < v.len {
            assert_eq!(v.ptr[i as i64], want[i]);
            i = i + 1i32;
        }
    }
}
