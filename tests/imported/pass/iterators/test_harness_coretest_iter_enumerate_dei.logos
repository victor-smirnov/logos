package test_iter_enumerate_dei;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;

#[test]
fn test_double_ended_enumerate() {
    let xs: [i32; 6] = [1i32, 2i32, 3i32, 4i32, 5i32, 6i32];
    unsafe {
        let mut it = iter_enumerate::<CopiedIter<SliceIter<i32>, i32>, i32>(iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&xs)), 0i32);
        match it.next() {
            Option::Some(p) => { assert_eq!(p.0, 0i64); assert_eq!(p.1, 1i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next() {
            Option::Some(p) => { assert_eq!(p.0, 1i64); assert_eq!(p.1, 2i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next_back() {
            Option::Some(p) => { assert_eq!(p.0, 5i64); assert_eq!(p.1, 6i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next_back() {
            Option::Some(p) => { assert_eq!(p.0, 4i64); assert_eq!(p.1, 5i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next_back() {
            Option::Some(p) => { assert_eq!(p.0, 3i64); assert_eq!(p.1, 4i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next_back() {
            Option::Some(p) => { assert_eq!(p.0, 2i64); assert_eq!(p.1, 3i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next() {
            Option::Some(_) => { assert_eq!(true, false); }
            Option::None    => { }
        }
    }
}
