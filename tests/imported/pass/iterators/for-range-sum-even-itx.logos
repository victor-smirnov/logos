// Distilled from tests/ui/iterators range/sum shapes.
// Feature: for-loop over an exclusive integer range with an in-loop conditional sum.
package for_range_sum_even_itx;
use logos.lang.iter;
fn main() -> i32 {
    let mut s: i64 = 0i64;
    for x in 0i64..10i64 {
        if (x % 2i64) == 0i64 { s = s + x; }
    }
    if s != 20i64 { return 1i32; }
    return 0i32;
}
