package test_iter_map;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;

fn negate(x: i32) -> i32 { return 0i32 - x; }

#[test]
fn test_iterator_map() {
    let xs: [i32; 6] = [1i32, 2i32, 3i32, 4i32, 5i32, 6i32];
    let want: [i32; 6] = [-1i32, -2i32, -3i32, -4i32, -5i32, -6i32];
    unsafe {
        let mut it = iter_map(iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&xs)), negate);
        let mut i: i32 = 0i32;
        loop {
            match it.next() {
                Option::None    => { break; }
                Option::Some(x) => {
                    assert_eq!(x, want[i]);
                    i = i + 1i32;
                }
            }
        }
        assert_eq!(i, 6i32);
    }
}
