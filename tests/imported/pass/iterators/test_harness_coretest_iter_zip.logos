// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: library/coretests/tests/iter/adapters/zip.rs
//   (test_zip_basic — derivative; original test_zip_nth uses
//   `.nth` on `ZipPair` tuple shape which isn't on the surface yet).
//
// Modifications:
// - `xs.iter().zip(&ys)` → `iter_zip::<…>(iter_over_slice(&xs),
//   iter_over_slice(&ys), zt, zu)`. Logos's ZipIter yields a
//   `ZipPair<T, U>` struct, not `(T, U)`; destructure via `.first`
//   / `.second` fields.
// - Stops at the shorter iter (Rust semantics).
// - assert_eq! family imports via std.fmt + std.lang.text.

package test_iter_zip;

use std.fmt;
use std.lang.text;
use std.lang.iter;
use logos.lang.option;

#[test]
fn test_iterator_zip() {
    let xs: [i32; 5] = [0i32, 1i32, 2i32, 4i32, 5i32];
    let ys: [i32; 3] = [10i32, 11i32, 12i32];
    let want_first:  [i32; 3] = [0i32, 1i32, 2i32];
    let want_second: [i32; 3] = [10i32, 11i32, 12i32];
    unsafe {
        let mut it = iter_zip::<SliceIter<i32>, SliceIter<i32>, i32, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32, 0i32);
        let mut i: i32 = 0i32;
        loop {
            match it.next() {
                Option::None    => { break; }
                Option::Some(p) => {
                    assert_eq!(p.first,  want_first[i]);
                    assert_eq!(p.second, want_second[i]);
                    i = i + 1i32;
                }
            }
        }
        // Stops at length 3 (shorter iter).
        assert_eq!(i, 3i32);
    }
}
