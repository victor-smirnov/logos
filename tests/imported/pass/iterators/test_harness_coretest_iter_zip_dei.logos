// align lengths, then pulls next_back from both.

package test_iter_zip_dei;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;

#[test]
fn test_double_ended_zip_balanced() {
    // Both sides 4 elements — no length-align needed.
    let xs: [i32; 4] = [1i32, 2i32, 3i32, 4i32];
    let ys: [i32; 4] = [10i32, 20i32, 30i32, 40i32];
    unsafe {
        let mut it = iter_zip::<CopiedIter<SliceIter<i32>, i32>, CopiedIter<SliceIter<i32>, i32>, i32, i32>(
            iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&xs)), iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&ys)), 0i32, 0i32);
        match it.next_back() {
            Option::Some(p) => { assert_eq!(p.first, 4i32); assert_eq!(p.second, 40i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next() {
            Option::Some(p) => { assert_eq!(p.first, 1i32); assert_eq!(p.second, 10i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next_back() {
            Option::Some(p) => { assert_eq!(p.first, 3i32); assert_eq!(p.second, 30i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next() {
            Option::Some(p) => { assert_eq!(p.first, 2i32); assert_eq!(p.second, 20i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next() {
            Option::Some(_) => { assert_eq!(true, false); }
            Option::None => { }
        }
    }
}

#[test]
fn test_double_ended_zip_left_longer() {
    // Left longer → drops 2 from the back of left before pulling.
    let xs: [i32; 5] = [0i32, 1i32, 2i32, 4i32, 5i32];
    let ys: [i32; 3] = [10i32, 11i32, 12i32];
    unsafe {
        let mut it = iter_zip::<CopiedIter<SliceIter<i32>, i32>, CopiedIter<SliceIter<i32>, i32>, i32, i32>(
            iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&xs)), iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&ys)), 0i32, 0i32);
        // Back yields (2,12), (1,11), (0,10).
        match it.next_back() {
            Option::Some(p) => { assert_eq!(p.first, 2i32); assert_eq!(p.second, 12i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next_back() {
            Option::Some(p) => { assert_eq!(p.first, 1i32); assert_eq!(p.second, 11i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next_back() {
            Option::Some(p) => { assert_eq!(p.first, 0i32); assert_eq!(p.second, 10i32); }
            Option::None => { assert_eq!(true, false); }
        }
        match it.next_back() {
            Option::Some(_) => { assert_eq!(true, false); }
            Option::None => { }
        }
    }
}

#[test]
fn test_zip_len_smoke() {
    let xs: [i32; 5] = [0i32, 1i32, 2i32, 4i32, 5i32];
    let ys: [i32; 3] = [10i32, 11i32, 12i32];
    unsafe {
        let mut it = iter_zip::<CopiedIter<SliceIter<i32>, i32>, CopiedIter<SliceIter<i32>, i32>, i32, i32>(
            iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&xs)), iter_copied::<SliceIter<i32>, i32>(iter_over_slice(&ys)), 0i32, 0i32);
        // Length is min of inner.lens.
        assert_eq!(it.len(), 3i64);
        it.next();
        assert_eq!(it.len(), 2i64);
        it.next_back();
        assert_eq!(it.len(), 1i64);
    }
}
