// Modifications:
// - Rust's `(0..N).step_by(1).take(N).cycle()` infinite-range chain
//   replaced with a tiny `Counter` struct (Logos has no open-range
//   syntax). CycleIter requires `I: Clone`; we hand-roll `impl Clone
//   for Counter` instead of `#[derive_clone]` because the metaprog
//   handler doesn't currently fire under `logosc --test` synthesis
//   (handler dispatch sees the test-runner's synthesised main first;
//   tracking as a follow-up gap).
// - assert_eq! family imports via std.fmt + std.lang.text.

package test_iter_cycle;

use std.fmt;
use std.lang.text;
use std.lang.clone;
use std.lang.iter;
use std.lang.option;

struct Counter { cur: i32, max: i32 }

impl Clone for Counter {
    fn clone(self: Counter) -> Counter {
        return Counter { cur: self.cur, max: self.max };
    }
}

impl Iterator<i32> for Counter {
    fn next(self: &mut Counter) -> Option<i32> {
        if self.cur >= self.max { return Option::None; }
        let v: i32 = self.cur;
        self.cur = self.cur + 1i32;
        return Option::Some(v);
    }
}

// Mirror of Rust's `(0..N).cycle().take(K).fold(0, |a, x| a+x)` shape.
#[test]
fn test_cycle_take_sum_short() {
    let c: Counter = Counter { cur: 0i32, max: 10i32 };
    unsafe {
        let mut it = iter_cycle::<Counter, i32>(c, 0i32);
        // Take 5: 0+1+2+3+4 = 10.
        let mut sum: i32 = 0i32;
        let mut k: i32 = 0i32;
        while k < 5i32 {
            match it.next() {
                Option::Some(v) => { sum = sum + v; }
                Option::None    => { assert_eq!(true, false); }
            }
            k = k + 1i32;
        }
        assert_eq!(sum, 10i32);
    }
}

#[test]
fn test_cycle_take_sum_wrapped() {
    let c: Counter = Counter { cur: 0i32, max: 10i32 };
    unsafe {
        let mut it = iter_cycle::<Counter, i32>(c, 0i32);
        // Take 15: 0..9 then 0..4 → 45 + 10 = 55.
        let mut sum: i32 = 0i32;
        let mut k: i32 = 0i32;
        while k < 15i32 {
            match it.next() {
                Option::Some(v) => { sum = sum + v; }
                Option::None    => { assert_eq!(true, false); }
            }
            k = k + 1i32;
        }
        assert_eq!(sum, 55i32);
    }
}
