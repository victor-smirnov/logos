// Feature: for-loop over a range computing a running product (factorial).
package for_range_product_itx;
use logos.lang.iter;
fn main() -> i32 {
    let mut p: i32 = 1i32;
    for x in 1i32..6i32 { p = p * x; }
    if p != 120i32 { return 1i32; }
    return 0i32;
}
