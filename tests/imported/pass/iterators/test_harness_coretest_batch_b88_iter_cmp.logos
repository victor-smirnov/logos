// Multi-source coretest batch (B88) — iter comparison helpers.
//
// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7.
//
// Source paths:
//   iter/traits/iterator.rs::test_lt — `lt`/`le`/`gt`/`ge` chains
//     on equal-length and lex-different prefixes.
//   iter/traits/iterator.rs::test_cmp_by (variant) — `cmp` chains.
//
// Modifications:
// - Method form `xs.iter().lt(ys.iter())` → free fn
//   `iter_lt::<SliceIter<i32>, SliceIter<i32>, i32>(a, b)`.
// - Empty-slice cases preserved via `iter_take(..., 0)` since
//   `[i32; 0]` literal triggers a warn.
// - assert_eq! family imports via std.fmt + std.lang.text.
//
// Stdlib companions: `iter_cmp` / `iter_lt` / `iter_le` /
// `iter_gt` / `iter_ge` / `iter_ne` free fns in std/lang/iter/iter.logos.

package test_iter_batch_b88_cmp;

use std.fmt;
use std.lang.text;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.cmp;

#[test]
fn test_iter_cmp_equal() {
    let xs: [i32; 3] = [1i32, 2i32, 3i32];
    let ys: [i32; 3] = [1i32, 2i32, 3i32];
    unsafe {
        match iter_cmp::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys)) {
            Ordering::Equal => { }
            _               => { assert_eq!(true, false); }
        }
        assert_eq!(iter_lt::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys)), false);
        assert_eq!(iter_le::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys)), true);
        assert_eq!(iter_gt::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys)), false);
        assert_eq!(iter_ge::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys)), true);
        assert_eq!(iter_ne::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys)), false);
    }
}

#[test]
fn test_iter_cmp_lex_greater() {
    // [1,2,3] vs [1,2,0] — first differing pair: 3 > 0 → Greater.
    let xs: [i32; 3] = [1i32, 2i32, 3i32];
    let ys: [i32; 3] = [1i32, 2i32, 0i32];
    unsafe {
        match iter_cmp::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys)) {
            Ordering::Greater => { }
            _                 => { assert_eq!(true, false); }
        }
        assert_eq!(iter_lt::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys)), false);
        assert_eq!(iter_gt::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys)), true);
    }
}

#[test]
fn test_iter_cmp_lex_less() {
    let xs: [i32; 3] = [1i32, 2i32, 0i32];
    let ys: [i32; 3] = [1i32, 2i32, 3i32];
    unsafe {
        match iter_cmp::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys)) {
            Ordering::Less => { }
            _              => { assert_eq!(true, false); }
        }
    }
}

#[test]
fn test_iter_cmp_length() {
    // Equal prefix, second longer → first < second.
    let xs: [i32; 2] = [1i32, 2i32];
    let ys: [i32; 3] = [1i32, 2i32, 3i32];
    unsafe {
        match iter_cmp::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys)) {
            Ordering::Less => { }
            _              => { assert_eq!(true, false); }
        }
        match iter_cmp::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&ys), iter_over_slice(&xs)) {
            Ordering::Greater => { }
            _                 => { assert_eq!(true, false); }
        }
    }
}

#[test]
fn test_iter_cmp_empty_vs_nonempty() {
    let xs: [i32; 3] = [1i32, 2i32, 3i32];
    unsafe {
        let empty1 = iter_take::<SliceIter<i32>, i32>(iter_over_slice(&xs), 0i64, 0i32);
        let empty2 = iter_take::<SliceIter<i32>, i32>(iter_over_slice(&xs), 0i64, 0i32);
        match iter_cmp::<TakeIter<SliceIter<i32>, i32>, TakeIter<SliceIter<i32>, i32>, i32>(
            empty1, empty2) {
            Ordering::Equal => { }
            _               => { assert_eq!(true, false); }
        }
        let empty3 = iter_take::<SliceIter<i32>, i32>(iter_over_slice(&xs), 0i64, 0i32);
        match iter_cmp::<TakeIter<SliceIter<i32>, i32>, SliceIter<i32>, i32>(
            empty3, iter_over_slice(&xs)) {
            Ordering::Less => { }
            _              => { assert_eq!(true, false); }
        }
    }
}
