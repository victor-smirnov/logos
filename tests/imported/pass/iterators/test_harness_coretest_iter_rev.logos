package test_iter_rev;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;
use logos.mem.collections.vec;

#[test]
fn test_rev() {
    let xs: [i32; 8] = [2i32, 4i32, 6i32, 8i32, 10i32, 12i32, 14i32, 16i32];
    unsafe {
        let mut it = iter_over_slice(&xs);
        it.next();
        it.next();
        let got: Vec<i32> = it.rev().collect::<Vec<i32>>();
        let want: [i32; 6] = [16i32, 14i32, 12i32, 10i32, 8i32, 6i32];
        assert_eq!(got.len, 6i64);
        let mut i: i64 = 0i64;
        while i < got.len {
            assert_eq!(got.ptr[i], want[i as i32]);
            i = i + 1i64;
        }
    }
}

#[test]
fn test_iterator_rev_nth() {
    let v: [i32; 5] = [0i32, 1i32, 2i32, 3i32, 4i32];
    unsafe {
        let mut i: i32 = 0i32;
        while (i as i64) < 5i64 {
            let mut it = iter_over_slice(&v).rev();
            let got = it.nth(i as i64);
            match got {
                Option::Some(x) => { assert_eq!(x, v[4i32 - i]); }
                Option::None    => { assert_eq!(true, false); }
            }
            i = i + 1i32;
        }
        // .nth(len) on a length-5 reversed iter is None.
        let mut it2 = iter_over_slice(&v).rev();
        let past = it2.nth(5i64);
        match past {
            Option::Some(_) => { assert_eq!(true, false); }
            Option::None    => { }
        }
    }
}
