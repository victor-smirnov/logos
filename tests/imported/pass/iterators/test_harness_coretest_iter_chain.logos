// Original path: library/coretests/tests/iter/adapters/chain.rs
//   (test_iterator_chain front-only subset)
//
// Modifications:
// - `xs.iter().chain(&ys)` → free-fn `iter_chain::<…>(iter_over_slice(&xs),
//   iter_over_slice(&ys), zero)` (Logos's chain adapter wants both
//   half iters at construction time and a zero sentinel for codegen).
// - `for &x in it` Rust ref-destructure for-loop replaced with
//   explicit `loop` + match (slice iters yield T by value in Logos).
// - assert_eq! family imports via std.fmt + std.lang.text.

package test_iter_chain;

use std.fmt;
use std.lang.text;
use std.lang.iter;
use std.lang.option;

#[test]
fn test_iterator_chain() {
    let xs: [i32; 6] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32];
    let ys: [i32; 4] = [30i32, 40i32, 50i32, 60i32];
    let expected: [i32; 10] = [0i32, 1i32, 2i32, 3i32, 4i32, 5i32, 30i32, 40i32, 50i32, 60i32];
    unsafe {
        let mut it = iter_chain::<SliceIter<i32>, SliceIter<i32>, i32>(
            iter_over_slice(&xs), iter_over_slice(&ys), 0i32);
        let mut i: i32 = 0i32;
        loop {
            match it.next() {
                Option::None    => { break; }
                Option::Some(x) => {
                    assert_eq!(x, expected[i]);
                    i = i + 1i32;
                }
            }
        }
        assert_eq!(i, 10i32);
    }
}
