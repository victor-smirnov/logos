package test_iter_skip_while;

use std.fmt;
use std.lang.text;
use std.lang.iter;
use std.lang.option;

fn lt15(x: i32) -> bool { return x < 15i32; }

#[test]
fn test_iterator_skip_while() {
    let xs: [i32; 10] = [0i32, 1i32, 2i32, 3i32, 5i32, 13i32, 15i32, 16i32, 17i32, 19i32];
    let ys: [i32; 4]  = [15i32, 16i32, 17i32, 19i32];
    unsafe {
        let mut it = iter_skip_while::<SliceIter<i32>, i32>(iter_over_slice(&xs), lt15, 0i32);
        let mut i: i32 = 0i32;
        loop {
            match it.next() {
                Option::None    => { break; }
                Option::Some(x) => {
                    assert_eq!(x, ys[i]);
                    i = i + 1i32;
                }
            }
        }
        assert_eq!(i, 4i32);
    }
}
