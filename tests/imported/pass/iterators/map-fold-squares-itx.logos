// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Feature: iter_map adapter feeding iter_fold (sum of squares).
package map_fold_squares_itx;
use logos.lang.iter;
fn main() -> i32 {
    let xs: [i32; 4] = [1i32, 2i32, 3i32, 4i32];
    unsafe {
        let it = iter_map::<SliceIter<i32>, i32, i32, |i32| -> i32>(iter_over_slice(&xs), |x: i32| -> i32 { return x * x; });
        let s: i32 = iter_fold::<MapIter<SliceIter<i32>, i32, i32, |i32| -> i32>, i32, i32, |i32, i32| -> i32>(
            it, 0i32, |a: i32, x: i32| -> i32 { return a + x; });
        if s != 30i32 { return 1i32; }
    }
    return 0i32;
}
