//   currently impl DoubleEndedIterator (SL-sl follow-up).
// - assert_eq! family imports via std.fmt + std.lang.text.

package test_iter_take;

use std.fmt;
use std.lang.text;
use logos.lang.iter;
use logos.lang.option;

#[test]
fn test_iterator_take() {
    let xs: [i32; 10] = [0i32, 1i32, 2i32, 3i32, 5i32, 13i32, 15i32, 16i32, 17i32, 19i32];
    let ys: [i32; 5] = [0i32, 1i32, 2i32, 3i32, 5i32];
    unsafe {
        let mut it = iter_take::<SliceIter<i32>, i32>(iter_over_slice(&xs), 5i64, 0i32);
        let mut i: i32 = 0i32;
        loop {
            match it.next() {
                Option::None    => { break; }
                Option::Some(x) => {
                    assert_eq!(x, ys[i]);
                    i = i + 1i32;
                }
            }
        }
        assert_eq!(i, 5i32);
    }
}
