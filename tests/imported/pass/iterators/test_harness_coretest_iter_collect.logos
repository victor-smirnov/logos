package test_iter_collect;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;
use logos.mem.collections.vec;

#[test]
fn test_collect_identity() {
    let xs: [i32; 5] = [10i32, 20i32, 30i32, 40i32, 50i32];
    unsafe {
        let v: Vec<i32> = iter_over_slice(&xs).collect::<Vec<i32>>();
        assert_eq!(v.len, 5i64);
        let mut i: i64 = 0i64;
        while i < v.len {
            assert_eq!(v.ptr[i], xs[i as i32]);
            i = i + 1i64;
        }
    }
}

#[test]
fn test_collect_after_filter() {
    let xs: [i32; 6] = [1i32, 2i32, 3i32, 4i32, 5i32, 6i32];
    unsafe {
        // `iter.filter(|x| x % 2 == 0)` — keep even numbers only.
        let v: Vec<i32> = iter_filter::<SliceIter<i32>, i32>(
            iter_over_slice(&xs),
            |x: i32| -> bool { return (x % 2i32) == 0i32; }
        ).collect::<Vec<i32>>();
        assert_eq!(v.len, 3i64);
        assert_eq!(v.ptr[0i64], 2i32);
        assert_eq!(v.ptr[1i64], 4i32);
        assert_eq!(v.ptr[2i64], 6i32);
    }
}

#[test]
fn test_collect_after_rev() {
    let xs: [i32; 4] = [1i32, 2i32, 3i32, 4i32];
    unsafe {
        let v: Vec<i32> = iter_over_slice(&xs).rev().collect::<Vec<i32>>();
        assert_eq!(v.len, 4i64);
        assert_eq!(v.ptr[0i64], 4i32);
        assert_eq!(v.ptr[1i64], 3i32);
        assert_eq!(v.ptr[2i64], 2i32);
        assert_eq!(v.ptr[3i64], 1i32);
    }
}
