package m_moves_move_3_unique;

struct Triple { x: i64, y: i64, z: i64 }

fn test(x: bool, foo: Triple) -> i64 {
    let bar = foo;
    let mut y: Triple;
    if x { y = bar; } else { y = Triple { x: 4i64, y: 5i64, z: 6i64 }; }
    return y.y;
}

fn main() -> i32 {
    let a = Triple { x: 1i64, y: 2i64, z: 3i64 };
    if test(true, a) != 2i64 { return 1; }
    let b = Triple { x: 1i64, y: 2i64, z: 3i64 };
    if test(false, b) != 5i64 { return 2; }
    return 0;
}
