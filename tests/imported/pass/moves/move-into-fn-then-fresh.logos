// Move into fn arg, then create fresh value with same name in new scope.
package move_into_fn_then_fresh;

struct S { v: i64 }

fn take(s: S) -> i64 { return s.v; }

fn main() -> i32 {
    let s: S = S { v: 3i64 };
    let r1: i64 = take(s);
    let s: S = S { v: 4i64 };       // shadows — fresh binding
    let r2: i64 = take(s);
    return (r1 + r2 - 7i64) as i32;
}
