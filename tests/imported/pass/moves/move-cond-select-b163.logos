package move_cond_select_b163;

struct Triple { a: i64, b: i64, c: i64 }

fn sum(t: Triple) -> i64 { return t.a + t.b + t.c; }

fn pick(flag: bool) -> i64 {
    let x: Triple = Triple { a: 1i64, b: 2i64, c: 3i64 };
    let y: Triple = Triple { a: 10i64, b: 20i64, c: 30i64 };
    let z: Triple = if flag { x } else { y };
    return sum(z);
}

fn main() -> i32 {
    if pick(true) != 6i64 { return 1i32; }
    if pick(false) != 60i64 { return 2i32; }
    return 0i32;
}
