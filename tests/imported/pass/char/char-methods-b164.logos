// Tests char literal comparisons, ordering, and `as u32` codepoint casts.
package char_methods_b164;

fn is_digit(c: char) -> bool {
    return c >= '0' && c <= '9';
}

fn main() -> i32 {
    let a: char = 'a';
    let z: char = 'z';
    if a >= z { return 1i32; }
    if (a as u32) != 97u32 { return 2i32; }
    if (z as u32) != 122u32 { return 3i32; }

    if is_digit('5') != true { return 4i32; }
    if is_digit('x') != false { return 5i32; }

    let nl: char = '\n';
    if (nl as u32) != 10u32 { return 6i32; }
    return 0i32;
}
