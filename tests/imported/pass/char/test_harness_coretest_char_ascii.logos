// Coretest batch — char ASCII-range methods.
//
// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7.
// Original path: library/coretests/tests/char.rs (ASCII-faithful subset).
//
// Modifications:
// - Unicode-property tests dropped: `'ö'.is_lowercase()` /
//   `'ß'.is_lowercase()` / `'Ü'.is_uppercase()` rely on Unicode
//   property tables that Logos's std.lang.char doesn't ship yet
//   (only the ASCII subset is faithful). Where the upstream test
//   exercises both, we keep the ASCII half and mark the rest open.
// - non-ASCII / control-byte codepoints are written `'\u{XXXX}'`, as upstream
//   (`u32 as char` is E0604: only `u8` casts to `char`).
//
// Source `#[test]` fns ported:
//   char.rs::test_is_whitespace
//   char.rs::test_is_lowercase (ASCII subset)
//   char.rs::test_is_uppercase (ASCII subset)
//   char.rs::test_is_alphabetic (via is_ascii_alphabetic)
//   char.rs::test_is_alphanumeric (via is_ascii_alphanumeric)
//   char.rs::test_is_numeric (via is_ascii_digit)
//   char.rs::test_is_control (ASCII subset)
//   char.rs::test_to_ascii_uppercase
//   char.rs::test_to_ascii_lowercase
//   char.rs::test_to_digit
//   char.rs::test_len_utf8

package test_char_ascii;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.char;

#[test]
fn test_is_whitespace() {
    assert!(' '.is_whitespace());
    assert!('\u{2007}'.is_whitespace());
    assert!('\t'.is_whitespace());
    assert!('\n'.is_whitespace());
    assert!(!'a'.is_whitespace());
    assert!(!'_'.is_whitespace());
    assert!(!'\0'.is_whitespace());
}

#[test]
fn test_is_lowercase_ascii() {
    assert!('a'.is_lowercase());
    assert!('z'.is_lowercase());
    assert!(!'P'.is_lowercase());
    assert!(!'A'.is_lowercase());
    assert!(!'0'.is_lowercase());
}

#[test]
fn test_is_uppercase_ascii() {
    assert!(!'h'.is_uppercase());
    assert!(!'a'.is_uppercase());
    assert!('T'.is_uppercase());
    assert!('Z'.is_uppercase());
    assert!(!'0'.is_uppercase());
}

#[test]
fn test_is_alphabetic_ascii() {
    assert!('a'.is_alphabetic());
    assert!('Z'.is_alphabetic());
    assert!(!'0'.is_alphabetic());
    assert!(!' '.is_alphabetic());
    assert!(!'_'.is_alphabetic());
}

#[test]
fn test_is_alphanumeric_ascii() {
    assert!('a'.is_alphanumeric());
    assert!('Z'.is_alphanumeric());
    assert!('0'.is_alphanumeric());
    assert!('9'.is_alphanumeric());
    assert!(!' '.is_alphanumeric());
    assert!(!'-'.is_alphanumeric());
}

#[test]
fn test_is_numeric_ascii() {
    assert!('0'.is_numeric());
    assert!('9'.is_numeric());
    assert!(!'a'.is_numeric());
    assert!(!'/'.is_numeric());
    assert!(!':'.is_numeric());
}

#[test]
fn test_is_control_ascii() {
    assert!('\u{0}'.is_control());
    assert!('\u{3}'.is_control());
    assert!('\u{9}'.is_control());
    assert!('\u{7F}'.is_control());
    assert!(!'\u{20}'.is_control());
    assert!(!'\u{55}'.is_control());
    assert!(!'A'.is_control());
}

#[test]
fn test_to_ascii_uppercase() {
    // assert_eq! requires Display+Debug; cast both sides to u32 since
    // std.lang.char doesn't yet ship those impls.
    assert_eq!('a'.to_ascii_uppercase() as u32, 'A' as u32);
    assert_eq!('z'.to_ascii_uppercase() as u32, 'Z' as u32);
    assert_eq!('A'.to_ascii_uppercase() as u32, 'A' as u32);
    assert_eq!('0'.to_ascii_uppercase() as u32, '0' as u32);
}

#[test]
fn test_to_ascii_lowercase() {
    assert_eq!('A'.to_ascii_lowercase() as u32, 'a' as u32);
    assert_eq!('Z'.to_ascii_lowercase() as u32, 'z' as u32);
    assert_eq!('a'.to_ascii_lowercase() as u32, 'a' as u32);
    assert_eq!('0'.to_ascii_lowercase() as u32, '0' as u32);
}

#[test]
fn test_to_digit() {
    // to_digit returns Option<u32> per Rust shape.
    assert_eq!('0'.to_digit(10u32).unwrap(), 0u32);
    assert_eq!('1'.to_digit(2u32).unwrap(),  1u32);
    assert_eq!('2'.to_digit(3u32).unwrap(),  2u32);
    assert_eq!('9'.to_digit(10u32).unwrap(), 9u32);
    assert_eq!('a'.to_digit(16u32).unwrap(), 10u32);
    assert_eq!('A'.to_digit(16u32).unwrap(), 10u32);
    assert_eq!('b'.to_digit(16u32).unwrap(), 11u32);
    assert_eq!('B'.to_digit(16u32).unwrap(), 11u32);
    assert_eq!('z'.to_digit(36u32).unwrap(), 35u32);
    assert_eq!('Z'.to_digit(36u32).unwrap(), 35u32);
    assert!(' '.to_digit(10u32).is_none());
    assert!('9'.to_digit(9u32).is_none());
}

#[test]
fn test_len_utf8() {
    assert_eq!('A'.len_utf8(),                  1i64);
    assert_eq!('\u{7F}'.len_utf8(),   1i64);
    assert_eq!('\u{80}'.len_utf8(),   2i64);
    assert_eq!('\u{7FF}'.len_utf8(),   2i64);
    assert_eq!('\u{800}'.len_utf8(),   3i64);
    assert_eq!('\u{2007}'.len_utf8(),  3i64);
    assert_eq!('\u{10000}'.len_utf8(), 4i64);
}

#[test]
fn test_is_ascii_hexdigit() {
    assert!('0'.is_ascii_hexdigit());
    assert!('9'.is_ascii_hexdigit());
    assert!('a'.is_ascii_hexdigit());
    assert!('f'.is_ascii_hexdigit());
    assert!('A'.is_ascii_hexdigit());
    assert!('F'.is_ascii_hexdigit());
    assert!(!'g'.is_ascii_hexdigit());
    assert!(!'G'.is_ascii_hexdigit());
    assert!(!' '.is_ascii_hexdigit());
}

#[test]
fn test_is_ascii_punctuation() {
    assert!('!'.is_ascii_punctuation());
    assert!('.'.is_ascii_punctuation());
    assert!(':'.is_ascii_punctuation());
    assert!('@'.is_ascii_punctuation());
    assert!('['.is_ascii_punctuation());
    assert!('{'.is_ascii_punctuation());
    assert!('~'.is_ascii_punctuation());
    assert!(!'a'.is_ascii_punctuation());
    assert!(!'0'.is_ascii_punctuation());
    assert!(!' '.is_ascii_punctuation());
}

#[test]
fn test_is_ascii_graphic() {
    assert!('!'.is_ascii_graphic());
    assert!('a'.is_ascii_graphic());
    assert!('Z'.is_ascii_graphic());
    assert!('9'.is_ascii_graphic());
    assert!('~'.is_ascii_graphic());
    assert!(!' '.is_ascii_graphic());
    assert!(!'\t'.is_ascii_graphic());
    assert!(!'\0'.is_ascii_graphic());
}
