// B76: Co wrapper accepting longer lifetime, used to call shorter-lifetime fn.
// 2026-09-02: the 'static field was fed `&v` of a fn-local (E0597 in rustc);
// the source is now a `static` item so the &'static is genuine.
package variance_co_into_local;

static V: i32 = 5i32;

struct W<T> { x: T }

fn use_short<'a>(w: W<&'a i32>) -> i32 { return *(w.x); }

fn main() -> i32 {
    let w: W<&'static i32> = W { x: &V };  // 'static field — should coerce to 'a
    return use_short(w) - 5i32;
}
