// B76 GAP: bare fn-ptr type at fn-signature position currently bypasses
// variance subtype check at return — Rust rejects shortening of Contra arg
// lifetime in fn(&T). Wrap fn-ptr in a struct field (see
// variance-contra-struct-cant-shorten) and the check fires correctly.
// File kept as gap regression: ensure compile remains accepted until fix lands.
package variance_contra_fnptr_arg_gap;

fn maybe<'short, 'long>(f: fn(&'long i32) -> i32) -> fn(&'short i32) -> i32
    where 'long: 'short
{ return f; }

fn main() -> i32 { return 0i32; }
