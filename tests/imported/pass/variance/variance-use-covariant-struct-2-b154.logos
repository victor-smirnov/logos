package variance_use_covariant_struct_2_b154;

struct SomeStruct<T> { v: T }

fn foo(v: SomeStruct<&i64>) -> SomeStruct<&i64> {
    v
}

fn main() -> i32 {
    let n: i64 = 7i64;
    let s = SomeStruct { v: &n };
    let r = foo(s);
    if *r.v != 7i64 { return 1i32; }
    return 0i32;
}
