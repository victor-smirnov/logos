package variance_use_covariant_struct_2;

struct SomeStruct<T> { v: T }

fn foo<'min, 'max>(v: SomeStruct<&'max i32>) -> SomeStruct<&'min i32>
    where 'max: 'min
{
    return v;
}

fn main() -> i32 { return 0i32; }
