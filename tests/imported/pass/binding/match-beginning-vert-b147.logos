package match_beginning_vert_b147;

enum Foo { A, B, C, D, E }

fn classify(f: Foo) -> i64 {
    match f {
        | Foo::A => 1i64,
        | Foo::B | Foo::C if 1i64 < 2i64 => 2i64,
        | Foo::D => 4i64,
        | _ => 9i64,
    }
}

fn main() -> i32 {
    if classify(Foo::A) != 1i64 { return 1i32; }
    if classify(Foo::B) != 2i64 { return 2i32; }
    if classify(Foo::C) != 2i64 { return 3i32; }
    if classify(Foo::D) != 4i64 { return 4i32; }
    if classify(Foo::E) != 9i64 { return 5i32; }
    return 0i32;
}
