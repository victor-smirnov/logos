package bind_match_value_guard_3291;

use logos.lang.option;

fn foo(x: Option<i64>, b: bool) -> i64 {
    match x {
        None => { return 1i64; },
        Some(v) if b => { return v; },
        Some(_) => { return 0i64; },
    }
}

fn main() -> i32 {
    if foo(Some(22i64), true) != 22i64 { return 1; }
    if foo(Some(22i64), false) != 0i64 { return 2; }
    if foo(None, true) != 1i64 { return 3; }
    if foo(None, false) != 1i64 { return 4; }
    return 0;
}
