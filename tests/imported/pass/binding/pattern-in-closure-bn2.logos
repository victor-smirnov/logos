// struct pattern `|Foo { x: x, y: _y }|`.
package pattern_in_closure_bn2;

struct Foo { x: i64, y: i64 }

fn main() -> i32 {
    let f = |p: (i64, i64)| -> i64 {
        let (x, _) = p;
        return x + 1i64;
    };
    let g = |foo: Foo| -> i64 {
        let Foo { x: x, y: _y } = foo;
        return x + 1i64;
    };
    if f((2i64, 3i64)) != 3i64 { return 1i32; }
    if g(Foo { x: 1i64, y: 2i64 }) != 2i64 { return 2i32; }
    return 0i32;
}
