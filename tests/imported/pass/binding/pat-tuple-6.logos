// Original path: tests/ui/binding/pat-tuple-6.rs
// Modifications: tuple part faithful — `..` rest in tuple patterns
// works (P4-pm-20). The original test also exercises a tuple-struct
// shape `S(u8, u8, u8, u8, u8)` with `..` rest patterns — that
// works for the constructor + index access (B-ts-01) and the
// `..` rest expansion (P4-pm-20) covers it; included as a second
// case.
package b_pat_tuple_6;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

struct S(i32, i32, i32, i32, i32);

fn main() -> i32 {
    let x: (i32, i32, i32, i32, i32) = (1i32, 2i32, 3i32, 4i32, 5i32);
    match x {
        (a, .., b, c) => {
            assert_eq!(a, 1i32);
            assert_eq!(b, 4i32);
            assert_eq!(c, 5i32);
        }
    }
    match x {
        (a, b, c, .., d) => {
            assert_eq!(a, 1i32);
            assert_eq!(b, 2i32);
            assert_eq!(c, 3i32);
            assert_eq!(d, 5i32);
        }
    }
    return 0;
}
