// Imported from rust-lang/rust tests/ui/binding/match-ref-binding-mut.rs
// Modifications: isize → i64; literals suffixed. Tests a `ref mut` field
// binding in a struct pattern, mutating through it.
// ⚠ `match *x` is the UPSTREAM spelling and is restored here. An earlier import
// rewrote it to `match x` ("Logos auto-derefs the reference"); under Rust 2024
// that makes the default binding mode by-reference, where a written `ref mut`
// is an error (spec pat.binding.modifier-requires-move-mode) — i.e. the import
// had edited Rust code AWAY from Rust to reach a shape Rust itself forbids.
package match_ref_binding_mut_test;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

struct Rec {
    f: i64,
}

fn destructure(x: &mut Rec) {
    match *x {
        Rec { f: ref mut f } => { *f += 1i64; }
    }
}

fn main() -> i32 {
    let mut v = Rec { f: 22i64 };
    destructure(&mut v);
    assert_eq!(v.f, 23i64);
    return 0;
}
