package match_ref_binding_in_guard_bn2;

fn main() -> i32 {
    let x: Option<bool> = Option::Some(true);
    match x {
        Option::Some(ref z) if *z => {
            if *z { return 0i32; }
            return 5i32;
        }
        _ => { return 1i32; }
    }
}
