package binding_match_in_macro;

enum Foo { B { b1: i64, bb1: i64 } }

fn main() -> i32 {
    let r = match (Foo::B { b1: 29i64, bb1: 100i64 }) {
        Foo::B { b1: b2, bb1: bb2 } => b2 + bb2,
    };
    if r != 129i64 { return 1i32; }
    return 0i32;
