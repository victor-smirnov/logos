package match_bot;

use std.fmt;
use std.lang.text;
use std.lang.option;

fn main() -> i32 {
    let i: isize = match Option::Some(3isize) {
        Option::None => { return 99; }
        Option::Some(_) => 5isize,
    };
    assert_eq!(i, 5isize);
    return 0;
}
