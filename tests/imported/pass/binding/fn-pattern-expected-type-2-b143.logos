// Modifications: isize→i64; `&[..]`-literal→`&arr` of a fixed `[(i64,i64);3]`; println→sum check.
// The `for &(x, y) in slice` ref-pattern in the loop head is a parse error, so the loop
// binds the element ref `p` and destructures the deref `let (x, y) = *p;` (same effect).
// Tests iterating a borrowed slice of tuples and destructuring each element.
package fn_pattern_expected_type_2_b143;

fn main() -> i32 {
    let arr: [(i64, i64); 3] = [(1i64, 2i64), (3i64, 4i64), (5i64, 6i64)];
    let v: &[(i64, i64)] = &arr;
    let mut sx: i64 = 0i64;
    let mut sy: i64 = 0i64;
    for p in v {
        let (x, y) = *p;
        sx = sx + x;
        sy = sy + y;
    }
    if sx != 9i64 { return 1i32; }
    if sy != 12i64 { return 2i32; }
    return 0i32;
}
