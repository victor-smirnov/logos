package match_range_infer_b145;

fn main() -> i32 {
    match 1i64 {
        1i64 ..= 3i64 => {}
        _ => { return 1i32; }
    }
    match 1u16 {
        1u16 ..= 3u16 => {}
        _ => { return 2i32; }
    }
    match 2u32 {
        1u32 ..= 3u32 => {}
        _ => { return 3i32; }
    }
    return 0i32;
}
