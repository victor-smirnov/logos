// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/binding/ (while-let binding facet, distilled).
// Modifications: a `while let Some(x) = opt { .. }` loop draining an
// Option that is rebuilt each iteration; isize->i64. Tests the
// `while let <pattern> = <expr>` binding form: the payload `x` is bound
// fresh each iteration and the loop ends when the pattern stops matching.
package while_let_option_bn2;

fn main() -> i32 {
    let mut o: Option<i64> = Option::Some(3i64);
    let mut sum: i64 = 0i64;
    while let Option::Some(x) = o {
        sum = sum + x;
        if x <= 1i64 { o = Option::None; } else { o = Option::Some(x - 1i64); }
    }
    if sum != 6i64 { return 1i32; }
    return 0i32;
}
