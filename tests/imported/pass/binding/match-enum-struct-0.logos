package match_enum_struct_0_test;

use logos.lang.panic;

enum E {
    Foo { f: i64 },
    Bar,
}

fn main() -> i32 {
    let e = E::Bar;
    match e {
        E::Foo { f: _f } => { panic("u"); }
        _                => {}
    }
    return 0;
}
