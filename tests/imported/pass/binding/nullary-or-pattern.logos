// regression point and is preserved verbatim.
package b_nullary_or_pattern;

use std.fmt;
use std.lang.text;

enum blah { a, b }

fn or_alt(q: blah) -> isize {
    return match q { blah::a | blah::b => { 42isize } };
}

fn main() -> i32 {
    assert_eq!(or_alt(blah::a), 42isize);
    assert_eq!(or_alt(blah::b), 42isize);
    return 0;
}
