package exhaustive_bool_match_sanity;

use std.fmt;
use std.lang.text;

fn foo(x: bool, y: bool) -> u32 {
    if !x { return 0u32; }
    if !y { return 1u32; }
    return 2u32;
}

fn main() -> i32 {
    assert_eq!(foo(false, true), 0u32);
    assert_eq!(foo(false, false), 0u32);
    assert_eq!(foo(true, false), 1u32);
    assert_eq!(foo(true, true), 2u32);
    return 0;
}
