// Modifications: literal-typed `0` → `0u32`; otherwise original
// shape preserved (tail-position tuple-match — re-enabled after
// P4-pm-03 + P4-pm-10 + P4-pm-11 closures in Sprint 2/5/this session).
package exhaustive_bool_match_sanity;

use std.fmt;
use std.lang.text;

fn foo(x: bool, y: bool) -> u32 {
    match (x, y) {
        (false, _)   => 0u32,
        (_, false)   => 1u32,
        (true, true) => 2u32,
    }
}

fn main() -> i32 {
    assert_eq!(foo(false, true), 0u32);
    assert_eq!(foo(false, false), 0u32);
    assert_eq!(foo(true, false), 1u32);
    assert_eq!(foo(true, true), 2u32);
    return 0;
}
