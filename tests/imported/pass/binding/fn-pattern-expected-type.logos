package b_fn_pattern_expected_type;

use std.fmt;
use std.lang.text;

fn main() -> i32 {
    let f = |t: (isize, isize)| {
        assert_eq!(t.0, 1isize);
        assert_eq!(t.1, 2isize);
    };
    f((1isize, 2isize));
    return 0;
}
