// Imported from rust-lang/rust tests/ui/binding/borrowed-ptr-pattern.rs
// Modifications: i64/char monomorphised helpers (Logos blanket Clone over
// generic `&T` in this `&ref a` shape is not the point; the test is the
// `&ref a` reference-pattern binding); char compared with `==` (no Debug),
// i64 via assert_eq! (logos.std.fmt). Tests the `&ref a` pattern that binds `a`
// as a reference to the referent of a `&T`.
package borrowed_ptr_pattern_test;

use logos.std.fmt;

fn foo_i64(x: &i64) -> i64 {
    match x {
        &ref a => *a
    }
}

fn foo_char(x: &char) -> char {
    match x {
        &ref a => *a
    }
}

fn main() -> i32 {
    assert_eq!(foo_i64(&3i64), 3i64);
    if foo_char(&'a') != 'a' { return 1; }
    return 0;
}
