// Imported from rust-lang/rust tests/ui/binding/inferred-suffix-in-pattern-range.rs
// Modifications: `.to_string()` String results replaced with `str`
// literals (the test only compares them); range pattern types pinned to
// the scrutinee suffix. assert_eq! kept. Tests inclusive range patterns
// selecting the right arm across i32 and u64.
package inferred_suffix_in_pattern_range_test;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    let x = 2i32;
    let x_message = match x {
        0i32..=1i32 => "not many",
        _           => "lots",
    };
    assert_eq!(x_message, "lots");

    let z = 1u64;
    let z_message = match z {
        0u64..=1u64 => "not many",
        _           => "lots",
    };
    assert_eq!(z_message, "not many");
    return 0;
}
