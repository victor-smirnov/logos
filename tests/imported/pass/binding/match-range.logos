package b_match_range;

use std.lang.panic;

fn main() -> i32 {
    match 5usize {
        1usize..=5usize => { }
        _               => { panic("should match range"); }
    }
    match 1usize {
        1usize..5usize  => { }
        _               => { panic("should match range start (exclusive)"); }
    }
    match 5usize {
        6usize..=7usize => { panic("shouldn't match range"); }
        _               => { }
    }
    match 7usize {
        6usize..7usize  => { panic("shouldn't match range end (exclusive)"); }
        _               => { }
    }
    match 5usize {
        1usize          => { panic("should match non-first"); }
        2usize..=6usize => { }
        _               => { panic("math broken"); }
    }
    match 'c' {
        'a'..='c' => { }
        _         => { panic("should match char range"); }
    }
    return 0;
}
