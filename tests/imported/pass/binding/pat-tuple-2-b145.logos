package pat_tuple_2_b145;

struct S { v: u8 }

fn tuple() -> i32 {
    let x = (1i64, 9i64);
    match x {
        (2i64, _) => { return 1i32; }
        (_, _) => { return 0i32; }
    }
}

fn structpat() -> i32 {
    let x = S { v: 1u8 };
    match x {
        S { v: 2u8 } => { return 2i32; }
        S { v: _ } => { return 0i32; }
    }
}

fn main() -> i32 {
    if tuple() != 0i32 { return 10i32; }
    if structpat() != 0i32 { return 11i32; }
    return 0i32;
}
