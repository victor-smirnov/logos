package match_reassign_b145;

fn check_eq(x: i64, y: i64) -> i32 {
    if x != y { return 1i32; }
    return 0i32;
}

fn main() -> i32 {
    let mut x: i64 = 1i64;
    match x {
        y => {
            x = 2i64;
            let _tmp: i64 = 1i64;
            if check_eq(y, 1i64) != 0i32 { return 2i32; }
        }
    }
    if x != 2i64 { return 3i32; }
    return 0i32;
}
