package binding_nested_matchs;

fn foo() -> i32 {
    match Some(5i64) {
        Some(_x) => {
            let mut bar: i64 = 0i64;
            let n: Option<i64> = Option::<i64>::None;
            match n {
                None => { bar = 5i64; }
                _ => { bar = 0i64; }
            }
            if bar != 5i64 { return 1i32; }
            return 0i32;
        }
        None => { return 2i32; }
    }
}

fn main() -> i32 {
    return foo();
}
