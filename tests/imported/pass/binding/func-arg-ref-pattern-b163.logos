package func_arg_ref_pattern_b163;

fn dot(p: &(i64, i64), q: &(i64, i64)) -> i64 {
    let (px, py) = *p;
    return px * q.0 + py * q.1;
}

fn main() -> i32 {
    let a: (i64, i64) = (2i64, 3i64);
    let b: (i64, i64) = (4i64, 5i64);
    if dot(&a, &b) != 23i64 { return 1i32; }
    if dot(&a, &a) != 13i64 { return 2i32; }
    return 0i32;
}
