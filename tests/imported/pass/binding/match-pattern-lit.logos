package b_match_pattern_lit;

use logos.lang.panic;

fn altlit(f: i64) -> i64 {
    match f {
      10i64 => { return 20i64; }
      11i64 => { return 22i64; }
      _     => { panic("the impossible happened"); return 0i64; }
    }
}

fn main() -> i32 {
    if altlit(10i64) != 20i64 { return 1i32; }
    if altlit(11i64) != 22i64 { return 2i32; }
    return 0i32;
}
