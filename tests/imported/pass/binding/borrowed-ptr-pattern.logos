package b_borrowed_ptr_pattern;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

fn foo_i32(x: &i32) -> i32 {
    match x { &ref a => { return *a; } }
}

fn foo_char(x: &char) -> char {
    match x { &ref a => { return *a; } }
}

fn main() -> i32 {
    if foo_i32(&3i32) != 3i32 { return 1; }
    if foo_char(&'a') != 'a'  { return 2; }
    return 0;
}
