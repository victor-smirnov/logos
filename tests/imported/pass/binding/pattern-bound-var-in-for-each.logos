package b_pattern_bound_var_in_for_each;

use logos.lang.option;

fn foo(src: i64) {
    match Option::Some::<i64>(src) {
      Option::Some(src_id) => {
        let mut i: i64 = 0i64;
        while i < 10i64 {
            let yyy = src_id;
            if yyy != 0i64 { return; }
            i = i + 1i64;
        }
      }
      Option::None => { }
    }
}

fn main() -> i32 {
    foo(0i64);
    return 0i32;
}
