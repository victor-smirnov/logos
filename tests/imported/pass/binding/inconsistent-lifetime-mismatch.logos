package b_inconsistent_lifetime_mismatch;

fn foo(s: &[str]) { let _ = s; }

fn good(a: str, b: str) {
    let arr: [str; 2] = [a, b];
    foo(&arr);
}

fn main() -> i32 {
    good("a", "b");
    return 0;
}
