package borrowed_ptr_pattern_option_b160;

use logos.lang.option;

fn select(x: &Option<i64>, y: &Option<i64>) -> i64 {
    match (x, y) {
        (Option::None, Option::None) => { return 0i64; }
        (Option::Some(n), _) => { return *n; }
        (Option::None, Option::Some(m)) => { return *m; }
    }
}

fn main() -> i32 {
    let a: Option<i64> = Option::Some(5i64);
    let b: Option<i64> = Option::None;
    if select(&a, &b) != 5i64 { return 1i32; }
    if select(&b, &a) != 5i64 { return 2i32; }
    if select(&b, &b) != 0i64 { return 3i32; }
    return 0i32;
}
