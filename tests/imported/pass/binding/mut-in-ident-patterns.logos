package binding_mut_in_ident_patterns;

trait Foo {
    fn foo(self: &Self, x: i64) -> i64 {
        let mut xm = x;
        let val = xm;
        xm = 37i64 * xm;
        return val + xm;
    }
}

struct X {}
impl Foo for X {}

fn main() -> i32 {
    let (a, b0) = (23i64, 4i64);
    let mut b = b0;
    if a != 23i64 { return 1i32; }
    if b != 4i64 { return 2i32; }
    b = a + b;
    if b != 27i64 { return 3i32; }

    let xv = X {};
    if xv.foo(2i64) != 76i64 { return 4i32; }

    match 32i64 {
        mut z @ 32i64 => {
            if z != 32i64 { return 5i32; }
            z = 34i64;
            if z != 34i64 { return 6i32; }
        }
        _ => {}
    }
    return 0i32;
}
