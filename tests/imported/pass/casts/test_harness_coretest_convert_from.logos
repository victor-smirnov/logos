// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7:
//   library/coretests/tests/convert.rs (subset)
//
// Validates std.lang.convert From/TryFrom impls for primitives.

package test_coretest_convert_from;

use std.fmt;
use std.lang.text;
use std.lang.option;
use std.lang.result;
use std.lang.convert;

#[test]
fn test_from_i8_to_i64() {
    let x: i64 = i64::from(42i8);
    assert!(x == 42i64);
    let y: i64 = i64::from(-1i8);
    assert!(y == -1i64);
}

#[test]
fn test_from_u8_to_u64() {
    let x: u64 = u64::from(200u8);
    assert!(x == 200u64);
}

#[test]
fn test_from_i32_to_i64() {
    let x: i64 = i64::from(-2147483647i32 - 1i32);
    assert!(x == -2147483648i64);
}

#[test]
fn test_from_bool_to_int() {
    let t: i32 = i32::from(true);
    let f: i32 = i32::from(false);
    assert!(t == 1i32);
    assert!(f == 0i32);
    let tu: u8 = u8::from(true);
    assert!(tu == 1u8);
}

#[test]
fn test_from_char_to_u32() {
    let c: char = 'A';
    let v: u32 = u32::from(c);
    assert!(v == 65u32);
}

#[test]
fn test_try_from_i32_to_i8_ok() {
    match i8::try_from(100i32) {
        Result::Ok(v)  => { assert!(v == 100i8); }
        Result::Err(_) => { assert!(false); }
    }
    match i8::try_from(-100i32) {
        Result::Ok(v)  => { assert!(v == -100i8); }
        Result::Err(_) => { assert!(false); }
    }
}

#[test]
fn test_try_from_i32_to_i8_err() {
    assert!(i8::try_from(200i32).is_err());
    assert!(i8::try_from(-200i32).is_err());
    assert!(i8::try_from(128i32).is_err());
    assert!(i8::try_from(-129i32).is_err());
}

#[test]
fn test_try_from_i32_to_u8() {
    match u8::try_from(200i32) {
        Result::Ok(v)  => { assert!(v == 200u8); }
        Result::Err(_) => { assert!(false); }
    }
    assert!(u8::try_from(256i32).is_err());
    assert!(u8::try_from(-1i32).is_err());
}

#[test]
fn test_try_from_i64_to_i32() {
    match i32::try_from(100i64) {
        Result::Ok(v)  => { assert!(v == 100i32); }
        Result::Err(_) => { assert!(false); }
    }
    assert!(i32::try_from(0x100000000i64).is_err());
    assert!(i32::try_from(-0x100000000i64).is_err());
}

#[test]
fn test_try_from_u32_to_char_ok() {
    match char::try_from(65u32) {
        Result::Ok(c)  => { assert!(c == 'A'); }
        Result::Err(_) => { assert!(false); }
    }
    match char::try_from(0x1F600u32) {
        Result::Ok(_)  => { /* emoji codepoint valid */ }
        Result::Err(_) => { assert!(false); }
    }
}

#[test]
fn test_try_from_u32_to_char_err() {
    // Out of range
    assert!(char::try_from(0x110000u32).is_err());
    // Surrogate range
    assert!(char::try_from(0xD800u32).is_err());
    assert!(char::try_from(0xDFFFu32).is_err());
}

#[test]
fn test_try_from_u64_to_i64() {
    match i64::try_from(100u64) {
        Result::Ok(v)  => { assert!(v == 100i64); }
        Result::Err(_) => { assert!(false); }
    }
    // u64 > i64::MAX should fail.
    let huge: u64 = 0x8000000000000000u64;
    assert!(i64::try_from(huge).is_err());
}
