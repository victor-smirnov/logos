package nested_index_b161;

fn main() -> i32 {
    let n = (1i64, (2i64, 3i64)).1.1;
    if n != 3i64 { return 1i32; }

    let m = (1i64, (2i64, (3i64, 4i64))).1.1.1;
    if m != 4i64 { return 2i32; }
