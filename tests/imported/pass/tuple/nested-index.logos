package tup_nested_index;

fn main() -> i32 {
    let n: i64 = (1i64, (2i64, 3i64)).1.1;
    if n != 3i64 { return 1i32; }
    let n2: i64 = (1i64, (2i64, (3i64, 4i64))).1.1.1;
    if n2 != 4i64 { return 2i32; }
    return 0i32;
}
