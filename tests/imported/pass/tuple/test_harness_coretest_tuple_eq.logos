package test_tuple_eq;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

#[test]
fn test_partial_eq() {
    let small: (i32, i32, i32) = (1i32, 2i32, 3i32);
    let big:   (i32, i32, i32) = (3i32, 2i32, 1i32);
    // ==
    assert_eq!(small == small, true);
    assert_eq!(big   == big,   true);
    // !=
    assert_eq!(small != big,   true);
    assert_eq!(big   != small, true);
    // Sanity: == flips correctly.
    assert_eq!(small == big,   false);
}
