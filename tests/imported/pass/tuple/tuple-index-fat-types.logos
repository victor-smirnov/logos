package m_tuple_index_fat_types;

struct Foo { f0: &[i64] }

fn main() -> i32 {
    let x: &[i64] = &[1i64, 2i64, 3i64];
    let y = (x,);
    if y.0[0] != 1i64 { return 1; }
    if y.0[2] != 3i64 { return 2; }

    let z = Foo { f0: x };
    if z.f0[1] != 2i64 { return 3; }
    return 0;
}
