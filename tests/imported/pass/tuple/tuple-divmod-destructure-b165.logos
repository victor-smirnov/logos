// Tests returning a 2-tuple from a fn and destructuring it with `let (q, r)`.
package tuple_divmod_destructure_b165;

fn divmod(a: i64, b: i64) -> (i64, i64) { return (a / b, a % b); }
fn main() -> i32 {
    let (q, r) = divmod(17i64, 5i64);
    if q != 3i64 { return 1i32; }
    if r != 2i64 { return 2i32; }
    let (q2, r2) = divmod(20i64, 4i64);
    if q2 != 5i64 { return 3i32; }
    if r2 != 0i64 { return 4i32; }
    return 0i32;
}
