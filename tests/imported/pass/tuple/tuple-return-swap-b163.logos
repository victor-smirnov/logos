package tuple_return_swap_b163;

fn minmax(a: i64, b: i64) -> (i64, i64) {
    if a < b { return (a, b); }
    return (b, a);
}

fn swap(a: i64, b: i64) -> (i64, i64) { return (b, a); }

fn main() -> i32 {
    let (lo, hi) = minmax(8i64, 3i64);
    if lo != 3i64 { return 1i32; }
    if hi != 8i64 { return 2i32; }
    let (p, q) = swap(1i64, 2i64);
    if p != 2i64 { return 3i32; }
    if q != 1i64 { return 4i32; }
    return 0i32;
}
