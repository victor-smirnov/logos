// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/generics/generic-fn.rs
// Modifications: `char` literal half not yet ported (the original
// also exercises `'a' as char` which Logos supports — TODO add to a
// future re-port). `Triple` is passed to `id` by value so the original
// `id::<Triple>(p)` would consume `p`; we read `p.z` before the call
// instead. Logos defaults to move semantics for scalar-only structs
// whereas Rust's `#[derive(Copy)]` opts in — this is a deliberate
// Logos-vs-Rust divergence (no implicit Copy).
package generic_fn;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn id<T>(x: T) -> T { return x; }

struct Triple { x: isize, y: isize, z: isize }

fn main() -> i32 {
    let mut x: isize = 62isize;
    let mut y: isize = 63isize;
    let p: Triple = Triple { x: 65isize, y: 66isize, z: 67isize };
    y = id::<isize>(x);
    assert_eq!(x, y);
    let pz: isize = p.z;
    let q: Triple = id::<Triple>(p);
    x = pz;
    y = q.z;
    assert_eq!(x, y);
    return 0;
}
