// Distilled from tests/ui/generics/generic-object.rs + generic-impl shapes.
// Feature: a trait `GetVal<T>` implemented for a GENERIC struct `impl<T: Copy> GetVal<T> for MyBox<T>`,
// dispatched as a method. Box->stack 1-field struct `MyBox<T>{v}` (renamed to avoid the prelude `Box`
// whose `get` is an unsafe raw-ptr accessor); `&self`->self:&MyBox<T>; isize->i64;
// the `as Box<dyn Foo<isize>>` trait-object cast dropped (kept the generic-impl-of-generic-trait
// dispatch via plain method call). assert->return-code; two instantiations.
package generic_trait_impl_for_generic_struct_g2;
trait GetVal<T> { fn get(self: &Self) -> T; }
struct MyBox<T> { v: T }
impl<T: Copy> GetVal<T> for MyBox<T> { fn get(self: &MyBox<T>) -> T { return (*self).v; } }
fn main() -> i32 {
    let a: MyBox<i64> = MyBox { v: 1i64 };
    let b: MyBox<u8> = MyBox { v: 200u8 };
    if a.get() == 1i64 && b.get() == 200u8 { return 0i32; }
    return 1i32;
}
