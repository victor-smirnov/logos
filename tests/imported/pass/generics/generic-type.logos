package generic_type;

use std.fmt;
use std.lang.text;

struct Pair<T> { x: T, y: T }

fn main() -> i32 {
    let x: Pair<isize> = Pair { x: 10isize, y: 12isize };
    assert_eq!(x.x, 10isize);
    assert_eq!(x.y, 12isize);
    return 0;
}
