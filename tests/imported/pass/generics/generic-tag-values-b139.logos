// Tests a single-payload generic enum `Noption<T>` constructed + matched at both
//   a scalar payload (i64) and a struct payload (Pair), reading both fields.
package generic_tag_values_b139;

enum Noption<T> { Some(T) }
struct Pair { x: i64, y: i64 }

fn main() -> i32 {
    let nop: Noption<i64> = Noption::Some(5i64);
    match nop {
        Noption::Some(n) => { if n != 5i64 { return 1i32; } }
    }

    let nop2: Noption<Pair> = Noption::Some(Pair { x: 17i64, y: 42i64 });
    match nop2 {
        Noption::Some(t) => {
            if t.x != 17i64 { return 2i32; }
            if t.y != 42i64 { return 3i32; }
        }
    }
    return 0i32;
}
