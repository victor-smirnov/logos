// Original path: tests/ui/generics/issue-1112.rs
// Generic struct with mixed-width fields (T, u8, bool, u8, u16, u8, u8) passed
// by value through a generic fn; field layout/alignment must survive.
// Modifications: isize->i64; assert_eq! -> sentinels.
package issue_1112_b157;

struct X<T> {
    a: T,
    b: u8,
    c: bool,
    d: u8,
    e: u16,
    f: u8,
    g: u8
}

fn bar<T>(x: X<T>) -> i32 {
    if x.b != 9u8 { return 1i32; }
    if x.c != true { return 2i32; }
    if x.d != 10u8 { return 3i32; }
    if x.e != 11u16 { return 4i32; }
    if x.f != 12u8 { return 5i32; }
    if x.g != 13u8 { return 6i32; }
    return 0i32;
}

fn main() -> i32 {
    let x: X<i64> = X {
        a: 12345678i64,
        b: 9u8,
        c: true,
        d: 10u8,
        e: 11u16,
        f: 12u8,
        g: 13u8
    };
    return bar(x);
}
