package q09;
trait Container { type Item; fn first(self: &Self) -> Self::Item; }
struct IntBox { v: i64 }
impl Container for IntBox { type Item = i64; fn first(self: &IntBox) -> i64 { return self.v; } }
fn get<C: Container<Item = i64>>(c: &C) -> i64 { return c.first(); }
fn main() -> i32 {
    if get(&IntBox { v: 9i64 }) != 9i64 { return 1i32; }
    return 0i32;
}
