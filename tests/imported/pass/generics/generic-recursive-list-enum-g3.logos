package generic_recursive_list_enum_g3;
enum List<T> { Cons(T, *const List<T>), Nil }
fn sum(l: *const List<i64>) -> i64 {
    unsafe {
        match *l {
            List::Cons(h, t) => { return h + sum(t); }
            List::Nil => { return 0i64; }
        }
    }
}
fn main() -> i32 {
    let n3: List<i64> = List::Nil;
    let l3: List<i64> = List::Cons(13i64, &n3 as *const List<i64>);
    let l2: List<i64> = List::Cons(12i64, &l3 as *const List<i64>);
    let l1: List<i64> = List::Cons(10i64, &l2 as *const List<i64>);
    if sum(&l1 as *const List<i64>) == 35i64 { return 0i32; }
    return 1i32;
}
