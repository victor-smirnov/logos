// Feature: a 3-param generic struct where a later field's type uses an EARLIER type
// param nested inside another generic (`Baz<T, U, V>` with U=Helper<T>, V=Opt<U>).
// Distilled to explicit type args (defaults are Rust sugar).
package generic_prev_param_in_field_g3;
struct Helper<T> { v: T }
enum Opt<T> { Sm(T), Nn }
struct Baz<T, U, V> { a: T, b: U, c: V }
fn main() -> i32 {
    let h: Helper<bool> = Helper { v: false };
    let o: Opt<Helper<bool>> = Opt::Sm(Helper { v: true });
    let x: Baz<bool, Helper<bool>, Opt<Helper<bool>>> = Baz { a: true, b: h, c: o };
    if x.a && !x.b.v {
        match x.c { Opt::Sm(hh) => { if hh.v { return 0i32; } return 2i32; } Opt::Nn => { return 3i32; } }
    }
    return 1i32;
}
