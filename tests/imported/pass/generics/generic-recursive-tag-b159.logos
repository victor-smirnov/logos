package generic_recursive_tag_b159;

enum Tag<T> { Cons(T, T), Nil }

fn sum(t: Tag<i64>) -> i64 {
    match t {
        Tag::Cons(a, b) => { return a + b; }
        Tag::Nil => { return 0i64; }
    }
}

fn main() -> i32 {
    let a: Tag<i64> = Tag::Cons::<i64>(10i64, 12i64);
    let n: Tag<i64> = Tag::Nil::<i64>;
    if sum(a) != 22i64 { return 1i32; }
    if sum(n) != 0i64 { return 2i32; }
    return 0i32;
}
