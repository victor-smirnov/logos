package generic_tag_match_b136;

enum Foo<T> { Arm(T) }

fn altfoo<T>(f: Foo<T>) -> bool {
    let mut hit: bool = false;
    match f {
        Foo::Arm(_x) => { hit = true; }
    }
    return hit;
}

fn main() -> i32 {
    if !altfoo::<i64>(Foo::Arm::<i64>(10i64)) { return 1i32; }
    return 0i32;
}
