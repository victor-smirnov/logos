// Tests a generic fn `get_third<T>((T,T,T)) -> T` destructuring a homogeneous 3-tuple
//   with a `let (_, _, x)` pattern and returning the bound element, instantiated at i64
//   and u8.
package generic_tup;

fn get_third<T>(t: (T, T, T)) -> T { let (_, _, x) = t; return x; }

fn main() -> i64 {
    let a: i64 = get_third((1i64, 2i64, 3i64));
    if a != 3 { return 1; }
    let b: u8 = get_third((5u8, 6u8, 7u8));
    if b != 7u8 { return 2; }
    return 0;
}
