package issue_1112;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

struct X<T> {
    a: T,
    b: u8,
    c: bool,
    d: u8,
    e: u16,
    f: u8,
    g: u8,
}

fn bar<T>(x: X<T>) {
    assert_eq!(x.b, 9u8);
    assert_eq!(x.c, true);
    assert_eq!(x.d, 10u8);
    assert_eq!(x.e, 11u16);
    assert_eq!(x.f, 12u8);
    assert_eq!(x.g, 13u8);
}

fn main() -> i32 {
    let x: X<isize> = X {
        a: 12345678isize,
        b: 9u8,
        c: true,
        d: 10u8,
        e: 11u16,
        f: 12u8,
        g: 13u8,
    };
    bar::<isize>(x);
    return 0;
}
