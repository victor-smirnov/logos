package generic_unique_b157;

struct Triple<T> { x: T, y: T, z: T }

fn ident<T>(x: Triple<T>) -> Triple<T> { return x; }

fn main() -> i32 {
    let x: Triple<i64> = ident::<i64>(Triple { x: 1i64, y: 2i64, z: 3i64 });
    if x.y != 2i64 { return 1i32; }
    return 0i32;
}
