// Feature: a generic fn parameterized over a producer `fn()->T` and a consumer
// `fn(T)`, applied with turbofish `apply::<i64>(produce, consume)`. fn-item to
// fn-ptr coercion via let-typed bindings.
package generic_fn_ptr_produce_consume_g3;
fn mk() -> i64 { return 1i64; }
fn chk(a: i64) -> i64 { return a; }
fn apply<T>(produce: fn() -> T, consume: fn(T) -> T) -> T { return consume(produce()); }
fn main() -> i32 {
    let produce: fn() -> i64 = mk;
    let consume: fn(i64) -> i64 = chk;
    if apply::<i64>(produce, consume) == 1i64 { return 0i32; }
    return 1i32;
}
