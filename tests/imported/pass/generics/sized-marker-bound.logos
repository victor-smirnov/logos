// Derived from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// shape of tests/ui/traits/*sized*. Logos has no unsized types yet,
// so `T: Sized` is a no-op bound — accepted at sema, satisfied
// trivially by every concrete type. `?Sized` opt-out form isn't
// expressible (no unsized types to opt out of). M7-mt-03 closed
// 2026-05-11.
package sized_marker_bound;

fn id<T: Sized>(x: T) -> T { return x; }

struct Holder<T: Sized> { v: T }

fn main() -> i32 {
    let h: Holder<i32> = Holder::<i32> { v: 7i32 };
    if id::<i32>(42i32) != 42i32 { return 1; }
    if h.v != 7i32 { return 2; }
    return 0;
}
