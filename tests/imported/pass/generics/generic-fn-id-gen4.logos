package generic_fn_id_gen4;

struct Triple { x: i64, y: i64, z: i64 }

fn id<T>(x: T) -> T { return x; }

fn main() -> i32 {
    let x = 62i64;
    let y = id::<i64>(x);
    if x != y { return 1i32; }

    let a = 'a';
    let b = id::<char>(a);
    if a != b { return 2i32; }

    let p: Triple = Triple { x: 65i64, y: 66i64, z: 67i64 };
    let q: Triple = id::<Triple>(p);
    if q.z != 67i64 { return 3i32; }
    return 0i32;
}
