// Tests a generic struct `Recbox<T> { x: T }` constructed inside a generic fn
//   `reclift<T>(t:T)->Recbox<T>`, instantiated via turbofish at i64.
package generic_exterior_unique_b159;

struct Recbox<T> { x: T }

fn reclift<T>(t: T) -> Recbox<T> {
    return Recbox { x: t };
}

fn main() -> i32 {
    let foo: i64 = 17i64;
    let rbfoo: Recbox<i64> = reclift::<i64>(foo);
    if rbfoo.x != foo { return 1i32; }
    return 0i32;
}
