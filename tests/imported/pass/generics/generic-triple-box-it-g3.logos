// Original path: tests/ui/generics/generic-unique.rs
// Feature: generic free fn taking a generic 3-field struct `Triple<T>` by value
// and returning it (upstream returns Box<Triple<T>>; Box<T>->stack per port rule).
// Turbofish call `box_it::<i64>(...)`. isize->i64.
package generic_triple_box_it_g3;
struct Triple<T> { x: T, y: T, z: T }
fn box_it<T>(x: Triple<T>) -> Triple<T> { return x; }
fn main() -> i32 {
    let x: Triple<i64> = box_it::<i64>(Triple { x: 1i64, y: 2i64, z: 3i64 });
    if x.y == 2i64 { return 0i32; }
    return 1i32;
}
