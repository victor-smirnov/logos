// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/generics/generic-temporary.rs
// Modifications: isize→i64; println! dropped; the `static mut` consumer-side
//   observation (Logos has no `static mut`) replaced by having `apply<T>`
//   return the produced T so the call result is observable; turbofish kept.
// Tests a generic fn `apply<T>(produce: fn()->T, consume: fn(T))` that wires a
// producer fn-pointer's result straight into a consumer fn-pointer, T at i64.
package generic_temporary_b136;

fn mk() -> i64 { return 1i64; }

fn apply<T: Copy>(produce: fn() -> T, consume: fn(T)) -> T {
    let v: T = produce();
    consume(v);
    return v;
}

fn chk(a: i64) {
    // consumer is effect-only; the facet is generic fn-ptr threading
    let _b: i64 = a + 1i64;
}

fn main() -> i32 {
    let produce: fn() -> i64 = mk;
    let consume: fn(i64) = chk;
    let r: i64 = apply::<i64>(produce, consume);
    if r != 1i64 { return 1i32; }
    return 0i32;
}
