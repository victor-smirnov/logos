package g_generic_tup;

fn get_third<T>(t: (T, T, T)) -> T {
    let (_, _, x): (T, T, T) = t;
    return x;
}

fn main() -> i32 {
    if get_third::<i32>((1i32, 2i32, 3i32)) != 3i32 { return 1i32; }
    if get_third::<u8>((5u8, 6u8, 7u8)) != 7u8 { return 2i32; }
    return 0i32;
}
