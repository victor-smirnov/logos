package m_generics_mid_path_type_params;

struct S<T> {
    contents: T,
}

impl<T> S<T> {
    fn new<U>(x: T, _y: U) -> S<T> {
        return S { contents: x };
    }
}

struct S2 {
    contents: i64,
}

impl S2 {
    fn new<U>(x: i64, _y: U) -> S2 {
        return S2 { contents: x };
    }
}

fn main() -> i32 {
    let a = S::<i64>::new(1i64, 1.0f64);
    let b = S2::new(2i64, 1.0f64);
    if a.contents != 1i64 { return 1; }
    if b.contents != 2i64 { return 2; }
    return 0;
}
