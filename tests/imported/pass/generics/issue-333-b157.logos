// Bind a generic fn as a fn-ptr value (`let f = id::<T>;`) inside another
// generic fn, then call it.
// Modifications: int literal suffixed; assert_eq! -> sentinel.
package issue_333_b157;

fn id<T>(x: T) -> T { return x; }

fn quux<T>(x: T) -> T { let f = id::<T>; return f(x); }

fn main() -> i32 {
    if quux(10i64) != 10i64 { return 1i32; }
    return 0i32;
}
