package generic_trait_typearg_as_dyn_g3;
trait Foo<T> { fn get(self: &Self) -> T; }
struct S { x: i64 }
impl Foo<i64> for S { fn get(self: &S) -> i64 { return (*self).x; } }
fn main() -> i32 {
