package generic_default_method_b138;

trait Doubler {
    fn double(self: &Self) -> i32;
}

struct A { n: i32 }
struct B { m: i32 }

impl Doubler for A { fn double(self: &Self) -> i32 { return self.n + self.n; } }
impl Doubler for B { fn double(self: &Self) -> i32 { return self.m * 2i32; } }

fn apply<T: Doubler>(x: &T) -> i32 {
    return x.double();
}

fn main() -> i32 {
    let a: A = A { n: 4i32 };
    let b: B = B { m: 5i32 };
    if apply::<A>(&a) != 8i32 { return 1i32; }
    if apply::<B>(&b) != 10i32 { return 2i32; }
    return 0i32;
}
