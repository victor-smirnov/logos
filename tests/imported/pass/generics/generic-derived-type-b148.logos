package generic_derived_type_b148;

fn g<X>(x: X) -> X { return x; }

struct Pair<T> { a: T, b: T }

fn f<T: Copy>(t: T) -> Pair<T> {
    let x: Pair<T> = Pair { a: t, b: t };
    return g::<Pair<T>>(x);
}

fn main() -> i32 {
    let b = f::<i64>(10i64);
    if b.a != 10i64 { return 1i32; }
    if b.b != 10i64 { return 2i32; }
    return 0i32;
}
