package generic_tag_match;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

enum foo<T> { arm(T) }

fn altfoo<T>(f: foo<T>) {
    let mut hit: bool = false;
    match f {
        foo::arm(_x) => { hit = true; }
    }
    assert!(hit);
}

fn main() -> i32 {
    altfoo::<isize>(foo::arm(10isize));
    return 0;
}
