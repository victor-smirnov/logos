//   literals suffixed; instantiated at i64 and u8.
// Tests a generic fn taking a homogeneous 3-tuple `(T,T,T)`, destructuring it
//   with a let-pattern and returning the third element, at two type args.
package generic_tup_b159;

fn get_third<T>(t: (T, T, T)) -> T {
    let (_, _, x) = t;
    return x;
}

fn main() -> i32 {
    if get_third((1i64, 2i64, 3i64)) != 3i64 { return 1i32; }
    if get_third((5u8, 6u8, 7u8)) != 7u8 { return 2i32; }
    return 0i32;
}
