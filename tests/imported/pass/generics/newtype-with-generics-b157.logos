package newtype_with_generics_b157;

struct MyVal<T>(T);

fn get_inner<T>(wrapper: MyVal<T>) -> T {
    let MyVal(inner) = wrapper;
    return inner;
}

fn main() -> i32 {
    let w: MyVal<i64> = MyVal(7i64);
    if get_inner::<i64>(w) != 7i64 { return 1i32; }
    return 0i32;
}
