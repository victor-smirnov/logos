// not the point — newtype generic destructuring is); isize->i64; #[derive]
// dropped; assert_eq! -> sentinels. The `let MyVal(inner) = wrapper;`
// destructure is done INSIDE the generic accessor fn `get_inner<T>` (where T is
// bound by the call), exercising generic-newtype destructuring; the equivalent
