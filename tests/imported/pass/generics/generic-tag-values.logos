package generic_tag_values;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

enum noption<T> { some(T) }

struct Pair { x: isize, y: isize }

fn main() -> i32 {
    let nop: noption<isize> = noption::some(5isize);
    match nop {
        noption::some(n) => { assert_eq!(n, 5isize); }
    }
    let nop2: noption<Pair> = noption::some(Pair { x: 17isize, y: 42isize });
    match nop2 {
        noption::some(t) => {
            assert_eq!(t.x, 17isize);
            assert_eq!(t.y, 42isize);
        }
    }
    return 0;
}
