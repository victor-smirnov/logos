// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Distilled from tests/ui/generics where-clauses-on-impl + generic-derived-type shapes.
// Feature: an `impl<T> Wrap<T> where T: Clone`-style WHERE-CLAUSE on the impl block (not the method),
// bounding the struct's type param so a method can use the bound's capability. isize->i64;
// `Clone`->`Copy` (the capability used is a by-value copy of a field); `&self`->self:&Wrap<T>;
// assert->return-code.
package impl_where_clause_g2;
struct Wrap<T> { v: T }
impl<T> Wrap<T> where T: Copy {
    fn dup(self: &Wrap<T>) -> T { return (*self).v; }
}
fn main() -> i32 {
    let w: Wrap<i64> = Wrap { v: 21i64 };
    if w.dup() == 21i64 { return 0i32; }
    return 1i32;
}
