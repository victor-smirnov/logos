package default_type_param_concrete_impls_g3;
struct Foo<A> { a: A }
impl Foo<i64> { fn bar_int(self: &Foo<i64>) -> i64 { return (*self).a; } }
impl Foo<bool> { fn bar_bool(self: &Foo<bool>) -> bool { return (*self).a; } }
fn main() -> i32 {
    let fi: Foo<i64> = Foo { a: 7i64 };
    let fb: Foo<bool> = Foo { a: true };
    if fi.bar_int() == 7i64 && fb.bar_bool() { return 0i32; }
    return 1i32;
}
