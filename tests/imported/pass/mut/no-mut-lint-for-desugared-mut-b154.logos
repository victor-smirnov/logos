// Tests: a `for` loop over a range produced by a block expression runs the body.
package no_mut_lint_for_desugared_mut_b154;

use logos.lang.range;

fn main() -> i32 {
    let mut sum: i64 = 0i64;
    let r = { 0i64..3i64 };
    for x in r {
        sum = sum + x;
    }
    if sum != 3i64 { return 1i32; }
    return 0i32;
}
