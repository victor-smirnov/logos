// Imported from rust-lang/rust tests/ui/nll/borrow-use-issue-46875.rs
// Modifications: only the `int()` half (no `vec![]`); preserves
// NLL pattern: shared borrow whose use ends before the reassignment.
package r_nll_int_reassign;

fn int_case() -> i32 {
    let mut x: i32 = 5i32;
    let y = &x;
    let captured = *y;
    x = 7i32;
    if captured != 5i32 { return 1; }
    if x != 7i32 { return 1; }
    return 0;
}

fn main() -> i32 {
    return int_case();
}
