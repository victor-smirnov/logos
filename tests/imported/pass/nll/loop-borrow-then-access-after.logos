// B72: borrow inside loop body is dead after loop; outer access OK.
package loop_borrow_then_access_after;

fn main() -> i32 {
    let mut x: i32 = 0i32;
    let mut i: i32 = 0i32;
    while i < 3i32 {
        let r: &i32 = &x;
        let _v: i32 = *r;
        i = i + 1i32;
    }
    x = 10i32;
    return x - 10i32;
}
