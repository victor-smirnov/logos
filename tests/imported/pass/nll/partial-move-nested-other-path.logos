// B78: nested struct, moving one inner field; sibling path still usable.
package partial_move_nested_other_path;

struct Leaf { v: i64 }
impl Drop for Leaf { fn drop(self: &mut Leaf) { } }

struct Branch { l: Leaf, m: i64 }

fn take(x: Leaf) -> i64 { return x.v; }

fn main() -> i32 {
    let b: Branch = Branch { l: Leaf { v: 1i64 }, m: 9i64 };
    let _x: i64 = take(b.l);
    return (b.m - 9i64) as i32;
}
