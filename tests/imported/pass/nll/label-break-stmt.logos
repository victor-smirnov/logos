// T4b: labeled break from nested loop.
package label_break_stmt;
fn main() -> i32 {
    let mut sum: i32 = 0i32;
    'outer: loop {
        let mut i: i32 = 0i32;
        while i < 5i32 {
            if i == 3i32 { break 'outer; }
            sum = sum + 1i32;
            i = i + 1i32;
        }
    }
    return sum - 3i32;
}
