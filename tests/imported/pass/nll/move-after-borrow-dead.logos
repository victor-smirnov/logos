// Move allowed after borrow's last use.
package move_after_borrow_dead;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { } }
fn take(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let s: S = S { v: 5i64 };
    {
        let _r: &S = &s;
        let _v: i64 = (*_r).v;
    }
    return take(s) as i32 - 5i32;
}
