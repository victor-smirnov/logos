// B82: vec.push(vec[0] + vec[1]) — receiver auto-borrow reserved
// while arg-eval reads same vec via indexing.
package tpb_vec_extend_from_self;
use std.collections.vec;

fn main() -> i32 {
    let mut v: Vec<i32> = vec_new::<i32>();
    v.push(10i32);
    v.push(20i32);
    v.push(v.get(0i64) + v.get(1i64));
    return (v.get(2i64) - 30i32) as i32;
}
