// Loop body has borrow; after loop, fresh borrow OK.
package nll_loop_borrow_each_then_after;
fn main() -> i32 {
    let mut x: i32 = 0i32;
    let mut i: i32 = 0i32;
    while i < 3i32 {
        let r: &i32 = &x;
        let _v: i32 = *r;
        i = i + 1i32;
    }
    let m: &mut i32 = &mut x;
    *m = 9i32;
    return x - 9i32;
}
