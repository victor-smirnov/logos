// B78 GAP: borrowing a moved field (`&o.i` after `take(o.i)`) does NOT
// currently fire — AddrOf path on FieldRead bypasses moved_fields check.
// Pinned as gap-regression; Rust rejects this case.
package partial_move_borrow_after_move_gap;

struct Inner { v: i64 }
impl Drop for Inner { fn drop(self: &mut Inner) { } }

struct Outer { i: Inner, k: i64 }

fn take(i: Inner) -> i64 { return i.v; }

fn main() -> i32 {
    let o: Outer = Outer { i: Inner { v: 5i64 }, k: 7i64 };
    let _a: i64 = take(o.i);
    let r: &Inner = &o.i;
    return ((*r).v - 5i64) as i32;
}
