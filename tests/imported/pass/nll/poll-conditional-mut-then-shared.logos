// B89: conditional mut borrow in then-branch; shared borrow after if
// works because the mut is dead at the merge point.
package poll_conditional_mut_then_shared;

fn main() -> i32 {
    let mut x: i32 = 0i32;
    let cond: bool = true;
    if cond {
        let m: &mut i32 = &mut x;
        *m = 5i32;
    }
    let r: &i32 = &x;
    return *r - 5i32;
}
