// B78: moving fields in disjoint arms — both legal (only one runs).
package partial_move_disjoint_arms;

struct Inner { v: i64 }
impl Drop for Inner { fn drop(self: &mut Inner) { } }

struct Outer { i: Inner, k: i64 }

fn take(i: Inner) -> i64 { return i.v; }

fn main() -> i32 {
    let o: Outer = Outer { i: Inner { v: 5i64 }, k: 7i64 };
    let cond: bool = true;
    if cond {
        let _x: i64 = take(o.i);
    } else {
        let _y: i64 = o.k;
    }
    return 0i32;
}
