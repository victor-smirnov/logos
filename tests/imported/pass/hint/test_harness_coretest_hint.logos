package test_coretest_hint;

use logos.std.fmt;
use logos.lang.hint;

// black_box is an identity function (an optimization barrier). The
// observable contract is that the value is returned unchanged.
#[test]
fn test_black_box_identity() {
    let a: i32 = black_box::<i32>(42i32);
    assert!(a == 42i32);
    let b: i64 = black_box::<i64>(-7i64);
    assert!(b == -7i64);
    let t: bool = black_box::<bool>(true);
    assert!(t);
}

// spin_loop is a callable no-op CPU hint — exercising it must not crash.
#[test]
fn test_spin_loop_callable() {
    let mut i: i32 = 0;
    while i < 4 {
        spin_loop();
        i = i + 1;
    }
    assert!(i == 4);
}
