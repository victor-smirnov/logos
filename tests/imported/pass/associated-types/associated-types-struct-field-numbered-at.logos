package associated_types_struct_field_numbered_at;
trait UnifyKey { type Value; }
struct Node<K: UnifyKey> { f0: K, f1: K::Value }
impl UnifyKey for i64 { type Value = i64; }
fn getval<K: UnifyKey>(node: &Node<K>) -> K::Value { return (*node).f1; }
