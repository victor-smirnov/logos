package assoc_type_projection_b138;

trait Producer {
    type Output;
    fn produce(self: &Self) -> Self::Output;
}

struct Const7 {}

impl Producer for Const7 {
    type Output = i32;
    fn produce(self: &Self) -> i32 {
        return 7i32;
    }
}

fn main() -> i32 {
    let c: Const7 = Const7 {};
    if c.produce() != 7i32 { return 1i32; }
    return 0i32;
}
