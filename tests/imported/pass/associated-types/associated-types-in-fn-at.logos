package associated_types_in_fn_at;
trait Get { type Value; fn get(self: &Self) -> &<Self as Get>::Value; }
struct Struct { x: i64 }
impl Get for Struct { type Value = i64; fn get(self: &Struct) -> &i64 { return &(*self).x; } }
fn grab<T: Get>(x: &T) -> &<T as Get>::Value { return x.get(); }
fn main() -> i32 {
