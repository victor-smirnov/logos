// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/associated-types/issue-23208.rs (the supertrait
// self-projection shape it exercises). Adapted to a run-pass with a concrete
// impl + return-code checks; `pub fn main()`→`fn main()->i32`.
//
// G172-6 (FIXED): a fully-qualified associated-type projection `<Self as Sub>::
// Item` inside a supertrait bound type-arg list — `trait Sub : Super<<Self as
// Sub>::Item>`. The adjacent `<<` lexed as a single shift-left token, so the
// trait-bound generic-arg opener (plain `LT`) failed to match → "syntax error
// near 'trait'". The opener now uses the `LT_TYPE` pseudo-token (which splits
// `<<` into two `<`), matching how `simple_type` already parses `Foo<Bar<T>>`.
// A space (`Super< <Self as Sub>::Item >`) always worked; the no-space form now
// does too.
package at_supertrait_self_projection;

trait Super<X> { fn sup(&self) -> X; }

trait Sub : Super<<Self as Sub>::Item> {
    type Item;
    fn item_id(&self) -> i64;
}

struct W { v: i64 }

impl Super<i64> for W { fn sup(&self) -> i64 { return self.v; } }
impl Sub for W { type Item = i64; fn item_id(&self) -> i64 { return self.v; } }

fn main() -> i32 {
    let w: W = W { v: 4i64 };
    if w.sup() != 4i64 { return 1i32; }
    if w.item_id() != 4i64 { return 2i32; }
    return 0i32;
}
