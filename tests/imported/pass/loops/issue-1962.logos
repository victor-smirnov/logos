package l_issue_1962;

fn main() -> i32 {
    let mut i: i32 = 0i32;
    'a: while true {
        i = i + 1i32;
        if i == 5i32 { break 'a; }
    }
    if i != 5i32 { return 1i32; }
    return 0i32;
}
