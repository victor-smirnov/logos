// Modifications: negative literal pattern written `0 - 1` for the match scrutinee;
// panic! → return-code; `1-1` (no spaces) kept. Tests that `a-b` without surrounding
// spaces lexes as subtraction (not a negative literal) and a literal match arm.
package binary_minus_without_space_b135;

fn main() -> i32 {
    let n = 0i64 - 1i64;
    match n {
        -1 => {},
        _ => { return 1i32; }
    }
    if 1i64-1i64 != 0i64 { return 2i32; }
    return 0i32;
}
