// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/binop/operator-overloading.rs
// Modifications: isize->i64; `#[derive]`/`use std::{cmp,ops}` dropped; impl the
//   ops traits as local traits (Add/Sub/Neg/Not/Index) with `self: Self`/
//   `self: &Self`; assert_eq!/assert! -> early-return sentinels; observe the
//   results by field access rather than PartialEq derive.
// Tests operator overloading via user traits: Add, Sub, Neg, Not, and Index<bool>
//   on a 2-field struct, plus equality checks by field.
package operator_overloading_b159;

struct Point { x: i64, y: i64 }

trait Add { fn add(self: Self, other: Point) -> Point; }
trait Sub { fn sub(self: Self, other: Point) -> Point; }
trait Neg { fn neg(self: Self) -> Point; }
trait Not { fn not(self: Self) -> Point; }
trait IndexB { fn index(self: &Self, x: bool) -> i64; }

impl Add for Point {
    fn add(self: Self, other: Point) -> Point {
        return Point { x: self.x + other.x, y: self.y + other.y };
    }
}
impl Sub for Point {
    fn sub(self: Self, other: Point) -> Point {
        return Point { x: self.x - other.x, y: self.y - other.y };
    }
}
impl Neg for Point {
    fn neg(self: Self) -> Point {
        return Point { x: -self.x, y: -self.y };
    }
}
impl Not for Point {
    fn not(self: Self) -> Point {
        return Point { x: !self.x, y: !self.y };
    }
}
impl IndexB for Point {
    fn index(self: &Self, x: bool) -> i64 {
        if x { return self.x; }
        return self.y;
    }
}

fn main() -> i32 {
    let mut p = Point { x: 10i64, y: 20i64 };
    p = p.add(Point { x: 101i64, y: 102i64 });
    p = p.sub(Point { x: 100i64, y: 100i64 });

    let s = p.add(Point { x: 5i64, y: 5i64 });
    if s.x != 16i64 { return 1i32; }
    if s.y != 27i64 { return 2i32; }

    let n = p.neg();
    if n.x != -11i64 { return 3i32; }
    if n.y != -22i64 { return 4i32; }

    if p.index(true) != 11i64 { return 5i32; }
    if p.index(false) != 22i64 { return 6i32; }

    let q = p.not();
    if q.x != !(p.x) { return 7i32; }
    if q.y != !(p.y) { return 8i32; }

    return 0i32;
}
