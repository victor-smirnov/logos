package binary_minus_without_space;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    match -1i32 {
        -1i32 => {}
        _ => { return 1; }
    }
    assert_eq!(1i32 - 1i32, 0i32);
    return 0;
}
