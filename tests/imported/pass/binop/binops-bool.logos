// mem::transmute + derive(PartialEq) needed).
package binops_bool;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    assert!(!(true < false));
    assert!(!(true <= false));
    assert!(true > false);
    assert!(true >= false);

    assert!(false < true);
    assert!(false <= true);
    assert!(!(false > true));
    assert!(!(false >= true));
    return 0;
}
