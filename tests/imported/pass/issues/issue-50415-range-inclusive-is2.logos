// Feature: an inclusive range `a..=b` iterated to a terminal value (upstream built
// the range via closures returning `s..=t`; distilled to direct iteration summing
// the inclusive endpoints).
package issue_50415_range_inclusive_is2;

fn main() -> i32 {
    let mut s: i64 = 0i64;
    for i in 0i64..=3i64 { s += i; }
    if s == 6i64 { return 0i32; }
    return 1i32;
}
