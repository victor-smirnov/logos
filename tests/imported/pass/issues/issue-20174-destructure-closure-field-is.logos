// Original path: tests/ui/issues/issue-20174.rs
// Feature: a tuple-struct-style wrapper holding a closure (`F: Fn()->T`),
// destructured in a `let` pattern to extract the closure, which is then
// called. Logos: a named-field struct + field-extraction (tuple-struct
// destructure-let binding is a separate surface).
package issue_20174_destructure_closure_field_is;

struct GradFn<F> { f: F }

fn run<F: Fn() -> i64>(g: GradFn<F>) -> i64 {
    let inner = g.f;
    return inner();
}

fn main() -> i32 {
    let g = GradFn { f: || -> i64 { return 2i64; } };
    if run(g) == 2i64 { return 0i32; }
    return 1i32;
}
