package issue_28828_assoc_type_alias_is;

trait Foo {
    type Out;
    fn make(self: &Self) -> Self::Out;
}

struct Unit {}

impl Foo for Unit {
    type Out = bool;
    fn make(self: &Unit) -> bool {
        return true;
    }
}

fn main() -> i32 {
    let u = Unit {};
    let x: bool = u.make();
    if x { return 0i32; }
    return 1i32;
}
