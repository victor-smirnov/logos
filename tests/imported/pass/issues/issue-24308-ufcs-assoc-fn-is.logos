package issue_24308_ufcs_assoc_fn_is;

trait Foo {
    fn method1() -> i64 { return 10i64; }
    fn method2() -> i64;
}

struct Holder {}

impl Foo for Holder {
    fn method2() -> i64 {
        return Holder::method1() + 5i64;
    }
}

fn main() -> i32 {
    if Holder::method2() == 15i64 { return 0i32; }
    return 1i32;
}
