package iss_issue_3895;

enum St {
    BadChar,
    BadSyntax,
}

fn main() -> i32 {
    let r = match St::BadChar {
        _ if true => 0i64,
        _ => 1i64,
    };
    if r != 0i64 { return 1; }
    return 0;
}
