package issue_30081_tuple_pattern_closure_is;

fn apply<F: Fn((i64, i64)) -> i64>(f: F, t: (i64, i64)) -> i64 {
    return f(t);
}

fn main() -> i32 {
    let sum = apply(|(a, b): (i64, i64)| -> i64 { return a + b; }, (3i64, 4i64));
    if sum == 7i64 { return 0i32; }
    return 1i32;
}
