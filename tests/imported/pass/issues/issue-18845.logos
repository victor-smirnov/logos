package iss_issue_18845;

fn test(foo: bool) -> u8 {
    match foo {
        true => 9u8,
        false => 0u8,
    }
}

fn main() -> i32 {
    if test(true) != 9u8 { return 1; }
    if test(false) != 0u8 { return 2; }
    return 0;
}
