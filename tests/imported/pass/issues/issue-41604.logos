package iss_issue_41604;

struct Bz { v: i64 }

impl Bz {
    fn init(&mut self) { self.v = 5i64; }
}

fn main() -> i32 {
    let mut b = [Bz { v: 0i64 }];
    b[1i64 - 1i64].init();
    if b[0i64].v != 5i64 { return 1; }
    return 0;
}
