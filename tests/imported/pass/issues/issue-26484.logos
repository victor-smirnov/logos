// main()->i32`. Exercises passing a closure that captures a local to a generic
// `F: FnOnce(u64) -> bool` function parameter.
package iss_issue_26484;

use logos.lang.ops;

fn helper<F: FnOnce(u64) -> bool>(f: F) -> bool { return f(1u64); }

fn main() -> i32 {
    let cond = 0u64;
    let r = helper(|v: u64| -> bool { return v == cond; });
    if r { return 1; }
    return 0;
}
