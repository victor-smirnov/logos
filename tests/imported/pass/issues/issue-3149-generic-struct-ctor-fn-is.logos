// runnable main here).
// Feature: a generic free fn that constructs a many-field generic struct via
// field-shorthand-style struct literal (`Mat { a: a, b: b, ... }`), returning
// `Mat<T>`. Distilled from the 16-field Matrix4 to a 4-field generic struct.
package issue_3149_generic_struct_ctor_fn_is;

struct Mat<T> { a: T, b: T, c: T, d: T }

fn mk<T>(a: T, b: T, c: T, d: T) -> Mat<T> {
    return Mat { a: a, b: b, c: c, d: d };
}

fn main() -> i32 {
    let m = mk::<i64>(1i64, 2i64, 3i64, 4i64);
    if m.a + m.b + m.c + m.d == 10i64 { return 0i32; }
    return 1i32;
}
