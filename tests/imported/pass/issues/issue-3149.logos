// Original path: tests/ui/issues/issue-3149.rs
// Modifications: the 4x4 `Matrix4<T>` (whose free constructor fn shares the
// struct's name) → a 2x2 `Mat2<T>` with a separately-named `make_mat2`
// constructor (Logos has no struct-name/fn-name overload); empty `pub fn main()`
// → `fn main()->i32` that builds the struct and reads a field. Exercises a
// generic free function constructing and returning a generic struct.
package iss_issue_3149;

struct Mat2<T> { m11: T, m12: T, m21: T, m22: T }

fn make_mat2<T>(a: T, b: T, c: T, d: T) -> Mat2<T> {
    return Mat2 { m11: a, m12: b, m21: c, m22: d };
}

fn main() -> i32 {
    let m = make_mat2(1i64, 2i64, 3i64, 4i64);
    if m.m22 != 4i64 { return 1; }
    return 0;
}
