// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/issues/issue-21922.rs
// Feature: calling an operator-trait method in UFCS form via the type-qualified
// path (`P::add(a, b)`) yields the same result as the `+` operator on the operands.
// (Upstream used `Add::add` over primitive `i32`; Logos has no primitive `Add`
// impl and UFCS dispatches off the receiver type → distilled to a user struct.)
package issue_21922_operator_ufcs_is2;

use logos.lang.ops;

struct P { v: i64 }
impl Add for P { fn add(self: P, rhs: P) -> P { return P { v: self.v + rhs.v }; } }

fn main() -> i32 {
    let a = P { v: 23i64 };
    let b = P { v: 42i64 };
    let viaufcs = P::add(a, b);
    let viaop = P { v: 23i64 } + P { v: 42i64 };
    if viaufcs.v == 65i64 && viaop.v == 65i64 { return 0i32; }
    return 1i32;
}
