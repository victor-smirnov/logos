// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/result/ shapes (distilled).
// Modifications: isize->i64; assert->if-return sentinels; error type is i64
//   sentinel rather than a String/custom error.
// Tests the `?` operator early-returning the Err of a Result<i64,i64> through a
//   helper, and the Ok-propagation path on success.
package result_question_mark_b164;

fn checked_div(a: i64, b: i64) -> Result<i64, i64> {
    if b == 0i64 { return Result::Err(1i64); }
    return Result::Ok(a / b);
}

fn compute(a: i64, b: i64, c: i64) -> Result<i64, i64> {
    let first: i64 = checked_div(a, b)?;
    let second: i64 = checked_div(first, c)?;
    return Result::Ok(second);
}

fn main() -> i32 {
    let ok: Result<i64, i64> = compute(100i64, 5i64, 2i64);
    if ok.unwrap_or(-1i64) != 10i64 { return 1i32; }

    let err: Result<i64, i64> = compute(100i64, 0i64, 2i64);
    if err.unwrap_or(-1i64) != -1i64 { return 2i32; }

    let err2: Result<i64, i64> = compute(100i64, 5i64, 0i64);
    if err2.unwrap_or(-7i64) != -7i64 { return 3i32; }
    return 0i32;
}
