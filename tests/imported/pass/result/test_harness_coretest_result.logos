package test_result;

use std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.result;
use logos.lang.option;
use logos.lang.iter;
use logos.mem.collections.vec;

#[test]
fn test_unwrap_or() {
    let ok: Result<isize, str> = Ok(100isize);
    let err: Result<isize, str> = Err("Err");

    assert_eq!(ok.unwrap_or(50isize), 100isize);
    assert_eq!(err.unwrap_or(50isize), 50isize);
}

#[test]
fn test_is_ok_is_err() {
    let ok: Result<isize, str> = Ok(7isize);
    assert!(ok.is_ok());
    assert!(!ok.is_err());

    let err: Result<isize, str> = Err("nope");
    assert!(!err.is_ok());
    assert!(err.is_err());
}

#[test]
fn test_unwrap_err() {
    // CP-cm-11 closed (2026-05-14): `str == str` now routes to stdlib
    // `str_eq`, so the upstream str form works.
    let err: Result<isize, str> = Err("sadface");
    assert_eq!(err.unwrap_err(), "sadface");
}

#[test]
#[should_panic]
fn test_expect_panic() {
    let err: Result<isize, str> = Err("boom");
    err.expect("expected ok but got err");
}

#[test]
#[should_panic]
fn test_expect_err_panic() {
    let ok: Result<isize, str> = Ok(1isize);
    ok.expect_err("expected err but got ok");
}

#[test]
#[should_panic]
fn test_unwrap_panic() {
    let err: Result<isize, str> = Err("kaboom");
    err.unwrap();
}

// test_and_then / test_or_else deferred: closure body inference doesn't
// propagate the enum result-type up through `fn(T) -> Result<U, E>` —
// even though CP-cm-10 unifies FnPtr formal params, the U inside the
// Result return type still isn't fixed when the body uses
// `let r: Result<isize, str> = ...; r`. Needs deeper closure-return
// inference / turbofish on enum literals to express directly.

// `test_impl_map` / `test_impl_map_err` adapted: Rust uses
// `Ok::<isize, isize>(1).map(|x| x+1) == Ok(2)` which needs Result==Result
// (PartialEq). Adding `impl<T:Eq, E:Eq> Eq for Result<T,E>` triggers the
// multi-tparam-with-bound mono segfault (filed as
// baghunt_trait_default_self_typed_args family). We compare via explicit
// match — same coverage as the upstream test.
#[test]
fn test_impl_map() {
    let ok: Result<i32, i32> = Ok(1i32);
    match ok.map(|x| { x + 1i32 }) {
        Result::Ok(v)  => { assert_eq!(v, 2i32); }
        Result::Err(_) => { assert!(false); }
    }
    let er: Result<i32, i32> = Err(1i32);
    match er.map(|x| { x + 1i32 }) {
        Result::Ok(_)  => { assert!(false); }
        Result::Err(e) => { assert_eq!(e, 1i32); }
    }
}

#[test]
fn test_impl_map_err() {
    let ok: Result<i32, i32> = Ok(1i32);
    match ok.map_err(|x| { x + 1i32 }) {
        Result::Ok(v)  => { assert_eq!(v, 1i32); }
        Result::Err(_) => { assert!(false); }
    }
    let er: Result<i32, i32> = Err(1i32);
    match er.map_err(|x| { x + 1i32 }) {
        Result::Ok(_)  => { assert!(false); }
        Result::Err(e) => { assert_eq!(e, 2i32); }
    }
}

#[test]
fn test_and() {
    // Faithful upstream `test_and` Ok/Err matrix (uses i32 payload to side-
    // step CP-cm-11 corner cases with str equality through unwrap_err).
    let a: Result<i32, i32> = Ok(1i32);
    let b: Result<i32, i32> = Ok(2i32);
    assert_eq!(a.and(b).unwrap(), 2i32);

    let err: Result<i32, i32> = Err(99i32);
    assert!(a.and(err).is_err());
    assert!(err.and(a).is_err());
    assert!(err.and(err).is_err());
}

#[test]
fn test_or() {
    // Upstream `test_or` Ok/Err matrix.
    let a: Result<i32, i32> = Ok(1i32);
    let err: Result<i32, i32> = Err(99i32);
    assert_eq!(a.or(err).unwrap(), 1i32);
    assert_eq!(err.or(a).unwrap(), 1i32);
    assert!(err.or(err).is_err());
}

fn ok_plus_one(x: i32) -> Result<i32, i32> { return Ok(x + 1i32); }
fn err_lift(x: i32)    -> Result<i32, i32> { return Ok(x + 100i32); }

#[test]
fn test_and_then() {
    let a: Result<i32, i32> = Ok(1i32);
    let err: Result<i32, i32> = Err(99i32);
    assert_eq!(a.and_then(ok_plus_one).unwrap(), 2i32);
    assert!(err.and_then(ok_plus_one).is_err());
}

#[test]
fn test_or_else() {
    let a: Result<i32, i32> = Ok(1i32);
    let err: Result<i32, i32> = Err(99i32);
    assert_eq!(a.or_else(err_lift).unwrap(), 1i32);
    assert_eq!(err.or_else(err_lift).unwrap(), 199i32);
}

// Upstream uses `format!("{ok:?}")` (Rust 2021 named-capture). Logos's
// format! follows the positional form `format!("{:?}", ok)`. CP-cm-15
// closed (2026-05-17) lets `impl<T: Debug, E: Debug> Debug for Result<T, E>`
// instantiate cleanly — previously mono cloned the impl for &mut-T cases
// surfaced by stdlib's `.take()` chains and emitted wrong-arity calls.
#[test]
fn test_fmt_default() {
    let ok:  Result<isize, str> = Ok(100isize);
    let err: Result<isize, str> = Err("Err");

    let s1: String = format!("{:?}", ok);
    assert_eq!(s1.as_str(), "Ok(100)");

    let s2: String = format!("{:?}", err);
    assert_eq!(s2.as_str(), "Err(\"Err\")");
}

// Rust's `test_collect` uses `.collect::<Result<Vec<isize>, ()>>()` —
// trait-static dispatch on an enum tparam (CP-cm-16). Logos exposes the
// same logic as a free fn `vec_collect_results(Vec<Result<T, E>>) ->
// Result<Vec<T>, E>` in stdlib/mem/collections/vec. The result is
// inspected via `match` not `r.is_ok()` — is_ok takes self by value
// (CP-cm-17 in catalog) so `r.is_ok()` consumes the Result and the
// follow-up `r.unwrap()` would double-free the Vec payload.
fn ok_three() -> Vec<Result<i32, i32>> {
    let mut v: Vec<Result<i32, i32>> = vec_new::<Result<i32, i32>>();
    v.push(Result::Ok(0i32));
    v.push(Result::Ok(1i32));
    v.push(Result::Ok(2i32));
    return v;
}

fn maybe_three() -> Vec<Result<i32, i32>> {
    // 3rd entry is Err(2) — short-circuit before any later Ok.
    let mut v: Vec<Result<i32, i32>> = vec_new::<Result<i32, i32>>();
    v.push(Result::Ok(0i32));
    v.push(Result::Ok(1i32));
    v.push(Result::Err(2i32));
    return v;
}

#[test]
fn test_collect() {
    // All-Ok → Ok([0, 1, 2])
    let three: Vec<Result<i32, i32>> = ok_three();
    let r1: Result<Vec<i32>, i32> = vec_collect_results(three);
    match r1 {
        Result::Ok(out)  => {
            assert_eq!(out.length(), 3i64);
            assert_eq!(out.get(0i64), 0i32);
            assert_eq!(out.get(1i64), 1i32);
            assert_eq!(out.get(2i64), 2i32);
        }
        Result::Err(_)   => { assert!(false); }
    }

    // Mixed Ok/Err → Err(2) (first Err short-circuits)
    let mix: Vec<Result<i32, i32>> = maybe_three();
    let r2: Result<Vec<i32>, i32> = vec_collect_results(mix);
    match r2 {
        Result::Ok(_)    => { assert!(false); }
        Result::Err(e)   => { assert_eq!(e, 2i32); }
    }

    // Upstream's empty-iter case (`Result<Vec<isize>, ()>` from
    // `(0..0).map(...)`) is omitted — the deferred-with-rationale block
    // covering CP-cm-16 / CP-cm-17 / unit-type history sits above.
}
