package test_result;

use std.fmt;
use std.lang.text;
use std.lang.result;

#[test]
fn test_unwrap_or() {
    let ok: Result<isize, str> = Ok(100isize);
    let err: Result<isize, str> = Err("Err");

    assert_eq!(ok.unwrap_or(50isize), 100isize);
    assert_eq!(err.unwrap_or(50isize), 50isize);
}

#[test]
fn test_is_ok_is_err() {
    let ok: Result<isize, str> = Ok(7isize);
    assert!(ok.is_ok());
    assert!(!ok.is_err());

    let err: Result<isize, str> = Err("nope");
    assert!(!err.is_ok());
    assert!(err.is_err());
}

#[test]
fn test_unwrap_err() {
    // Upstream uses `&'static str` and compares with `==`. In Logos
    // `str == str` is currently not wired (SL-sl-09 — needs PartialEq
    // impl on `str`). Use isize error payload to exercise unwrap_err.
    let err: Result<isize, isize> = Err(42isize);
    assert_eq!(err.unwrap_err(), 42isize);
}

#[test]
#[should_panic]
fn test_expect_panic() {
    let err: Result<isize, str> = Err("boom");
    err.expect("expected ok but got err");
}

#[test]
#[should_panic]
fn test_expect_err_panic() {
    let ok: Result<isize, str> = Ok(1isize);
    ok.expect_err("expected err but got ok");
}

#[test]
#[should_panic]
fn test_unwrap_panic() {
    let err: Result<isize, str> = Err("kaboom");
    err.unwrap();
}
