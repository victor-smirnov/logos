package test_result_map;

use std.fmt;
use std.lang.text;
use std.lang.result;
use std.lang.option;

fn plus_one(x: i32) -> i32 { return x + 1i32; }

#[test]
fn test_impl_map() {
    let ok: Result<i32, i32> = Ok(1i32);
    match ok.map(plus_one) {
        Result::Ok(v)  => { assert_eq!(v, 2i32); }
        Result::Err(_) => { assert_eq!(true, false); }
    }
    let err: Result<i32, i32> = Err(1i32);
    match err.map(plus_one) {
        Result::Ok(_)  => { assert_eq!(true, false); }
        Result::Err(e) => { assert_eq!(e, 1i32); }
    }
}

#[test]
fn test_impl_map_err() {
    let ok: Result<i32, i32> = Ok(1i32);
    match ok.map_err(plus_one) {
        Result::Ok(v)  => { assert_eq!(v, 1i32); }
        Result::Err(_) => { assert_eq!(true, false); }
    }
    let err: Result<i32, i32> = Err(1i32);
    match err.map_err(plus_one) {
        Result::Ok(_)  => { assert_eq!(true, false); }
        Result::Err(e) => { assert_eq!(e, 2i32); }
    }
}
