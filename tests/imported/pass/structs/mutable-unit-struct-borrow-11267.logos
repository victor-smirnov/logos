package m_structs_mutable_unit_struct_borrow;

use logos.lang.option;

struct Empty {}

trait T {
    fn next(&mut self) -> Option<i64>;
}

impl T for Empty {
    fn next(&mut self) -> Option<i64> { return Option::None; }
}

fn do_something_with(a: &mut dyn T) -> i64 {
    match a.next() {
        Option::Some(v) => { return v; },
        Option::None => { return -1i64; },
    }
}

fn main() -> i32 {
    let mut e = Empty {};
    let r = do_something_with(&mut e);
    if r != -1i64 { return 1; }
    return 0;
}
