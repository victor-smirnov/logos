package struct_update_syntax_b138;

struct Point3 { x: i32, y: i32, z: i32 }

fn main() -> i32 {
    let base: Point3 = Point3 { x: 1i32, y: 2i32, z: 3i32 };
    let moved: Point3 = Point3 { x: 10i32, ..base };
    if moved.x != 10i32 { return 1i32; }
    if moved.y != 2i32 { return 2i32; }
    if moved.z != 3i32 { return 3i32; }
    return 0i32;
}
