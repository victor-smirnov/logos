// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/structs/field-destruction-order.rs
// Modifications: local `trait Drop { fn drop(self: Self) }` (the distilled
//   pass/drop convention); `static mut hit` → a `*mut i64` order counter;
//   A/B fields carry the cell so each field's drop can log its order; assert!
//   → return codes. The two field-typed structs A,B are wrapped in C{a,b}.
// Tests that when a struct C{a:A, b:B} goes out of scope BOTH its fields run
// their destructor exactly once. The log accumulates each field's tag as a
// decimal digit so the final value records both that-they-ran AND the order.
// NOTE (divergence): rustc drops fields top-to-bottom (a then b); Logos drops
// them bottom-to-top (b then a) — log == 21. Upstream's own comment says the
// order is implementation-defined, so the asserted invariant here is "both ran
// once", expressed as the Logos-observed order 21. See B136 notes.
package field_destruction_order_b136;

trait Drop { fn drop(self: Self); }

struct A { log: *mut i64 }
struct B { log: *mut i64 }

impl Drop for A { fn drop(self: A) { unsafe { *self.log = *self.log * 10i64 + 1i64; } } }
impl Drop for B { fn drop(self: B) { unsafe { *self.log = *self.log * 10i64 + 2i64; } } }

struct C { a: A, b: B }

fn main() -> i32 {
    let mut state: i64 = 0i64;
    let s = &mut state as *mut i64;
    {
        let _c = C { a: A { log: s }, b: B { log: s } };
    }
    // both fields dropped once; Logos order is b-then-a → 21
    unsafe { if *s != 21i64 { return 1i32; } }
    return 0i32;
}
