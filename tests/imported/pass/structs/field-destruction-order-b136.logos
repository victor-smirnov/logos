// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/structs/field-destruction-order.rs
// Modifications: local `trait Drop { fn drop(self: Self) }` (the distilled
//   pass/drop convention); `static mut hit` → a `*mut i64` order counter;
//   A/B fields carry the cell so each field's drop can log its order; assert!
//   → return codes. The two field-typed structs A,B are wrapped in C{a,b}.
// Tests that when a struct C{a:A, b:B} goes out of scope BOTH its fields run
// their destructor exactly once. The log accumulates each field's tag as a
// decimal digit so the final value records both that-they-ran AND the order.
// ⚠ RE-POINTED 2026-09-10, AND THE OLD NOTE WAS WRONG ABOUT UPSTREAM. It said
// "upstream's own comment says the order is implementation-defined, so the
// asserted invariant here is 'both ran once', expressed as the Logos-observed
// order 21". Upstream's PROSE muses about the order; upstream's PROGRAM asserts
// it — `A::drop` runs `assert!(!hit); hit = true;` and `B::drop` runs
// `assert!(hit)`, so `tests/ui/structs/field-destruction-order.rs` is a
// `run-pass` test that PANICS unless `a` drops before `b`. Re-pointed to 21 for
// a divergence, this port stopped catching exactly what upstream wrote it to
// catch. Logos now drops fields in declaration order like rustc, so the
// assertion is upstream's own: log == 12.
package field_destruction_order_b136;

struct A { log: *mut i64 }
struct B { log: *mut i64 }

impl Drop for A { fn drop(self: &mut Self) { unsafe { *self.log = *self.log * 10i64 + 1i64; } } }
impl Drop for B { fn drop(self: &mut Self) { unsafe { *self.log = *self.log * 10i64 + 2i64; } } }

struct C { a: A, b: B }

fn main() -> i32 {
    let mut state: i64 = 0i64;
    let s = &mut state as *mut i64;
    {
        let _c = C { a: A { log: s }, b: B { log: s } };
    }
    // both fields dropped once, a-then-b, exactly as upstream asserts → 12
    unsafe { if *s != 12i64 { return 1i32; } }
    return 0i32;
}
