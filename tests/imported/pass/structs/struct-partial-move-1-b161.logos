// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/structs/struct-partial-move-1.rs
// Modifications: the partial-move-after-FSU facet reshaped to a plain
//   functional-update over a GENERIC struct (the partial-move root the upstream
//   tests is separate); turbofish `_` placeholder dropped (concrete i64).
// Tests functional struct update `..base` over a GENERIC struct `P<T>` — the
//   spread carries the remaining fields off the base (G161-5, closed
//   2026-05-23; concrete-struct FSU already worked). The generic path was
//   missing the `..base` field-fill entirely ("field 'x' not initialized").
package struct_partial_move_1_b161;

struct P<T> { x: T, y: T }

fn upd<T>(p: P<T>, new_y: T) -> P<T> { return P { y: new_y, ..p }; }

fn main() -> i32 {
    let p = P { x: 10i64, y: 20i64 };
    let r = upd::<i64>(p, 99i64);
    if r.x != 10i64 { return 1i32; }   // carried off base
    if r.y != 99i64 { return 2i32; }   // overridden
    return 0i32;
}
