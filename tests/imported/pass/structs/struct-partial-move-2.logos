package s_struct_partial_move_2;

use logos.lang.ops;

struct Partial { x: i64, y: i64 }

fn f(b1: i64, b2: i64, b3: i64, b4: i64, g: |i64| -> i64) -> (Partial, Partial) {
    let p = Partial { x: b1, y: b2 };
    let q = Partial { x: b3, y: b4 };
    return (Partial { x: g(q.y), ..p }, Partial { y: g(p.x), ..q });
}

fn main() -> i32 {
    let inc = |z: i64| -> i64 { return z + 1i64; };
    let two = f(1i64, 3i64, 5i64, 7i64, inc);
    if two.0.x != 8i64 { return 1; }
    if two.0.y != 3i64 { return 2; }
    if two.1.x != 5i64 { return 3; }
    if two.1.y != 2i64 { return 4; }
    return 0;
}
