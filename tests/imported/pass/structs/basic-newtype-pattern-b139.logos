package basic_newtype_pattern_b139;

struct CounterData { compute: fn(Counter) -> i64, val: i64 }
struct Counter { data: CounterData }

fn compute_value(counter: Counter) -> i64 {
    counter.data.val + 20i64
}

fn main() -> i32 {
    let my_counter = Counter { data: CounterData { compute: compute_value, val: 30i64 } };
    let f = my_counter.data.compute;
    let arg = Counter { data: CounterData { compute: compute_value, val: 30i64 } };
    if f(arg) != 50i64 { return 1i32; }
    return 0i32;
}
