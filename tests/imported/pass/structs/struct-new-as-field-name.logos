// Modifications: `new` is a Logos keyword (KW_NEW in logos.peg). The
// grammar permits it as a method name (logos.peg:788 comment) but not
// as a struct field name. Renamed to `new_field` here. The test's
// headline property — a struct uses an arbitrary identifier as field
// name — is preserved. Closing the keyword-as-ident gap (S8-st-01)
// lets us un-rename.
package struct_new_as_field_name;

use std.fmt;
use std.lang.text;

struct Foo { new_field: isize }

fn main() -> i32 {
    let foo: Foo = Foo { new_field: 3isize };
    assert_eq!(foo.new_field, 3isize);
    return 0;
}
