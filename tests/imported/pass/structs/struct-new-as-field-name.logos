package struct_new_as_field_name;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

struct Foo { new: isize }

fn main() -> i32 {
    let foo: Foo = Foo { new: 3isize };
    assert_eq!(foo.new, 3isize);
    return 0;
}
