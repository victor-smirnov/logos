package s_struct_partial_move_1;

use logos.lang.ops;

struct Partial { x: i64, y: i64 }

fn f(b1: i64, b2: i64, g: |i64| -> i64) -> Partial {
    let p = Partial { x: b1, y: b2 };
    return Partial { y: g(p.y), ..p };
}

fn main() -> i32 {
    let inc = |z: i64| -> i64 { return z + 1i64; };
    let p = f(3i64, 4i64, inc);
    if p.x != 3i64 { return 1; }
    if p.y != 5i64 { return 2; }
    return 0;
}
