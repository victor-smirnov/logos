// Tests a struct-literal construction followed by a full field-binding
//   `let S { x: _a, y: _b } = x;` destructuring pattern.
package module_qualified_destructure_b137;

struct S {
    x: i64,
    y: i64,
}

fn main() -> i32 {
    let v: S = S { x: 1i64, y: 2i64 };
    let S { x: a, y: b } = v;
    if a != 1i64 { return 1i32; }
    if b != 2i64 { return 2i32; }
    return 0i32;
}
