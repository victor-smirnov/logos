package s_newtype_struct_with_dtor;

pub struct Fd(u32);

fn foo(a: u32) { let _ = a; }

impl Drop for Fd {
    fn drop(&mut self) {
        let Fd(s) = *self;
        foo(s);
    }
}

fn main() -> i32 {
    let _f: Fd = Fd(5u32);
    return 0;
}
