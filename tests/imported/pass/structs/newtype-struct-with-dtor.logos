package s_newtype_struct_with_dtor;

pub struct Fd { v: u32 }

fn foo(a: u32) { let _ = a; }

impl Drop for Fd {
    fn drop(&mut self) {
        foo(self.v);
    }
}

fn main() -> i32 {
    let _f: Fd = Fd { v: 5u32 };
    return 0;
}
