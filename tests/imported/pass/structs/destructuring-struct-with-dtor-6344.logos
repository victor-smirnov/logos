package s_dtor_6344;

struct A { x: usize }

impl Drop for A {
    fn drop(&mut self) { }
}

fn main() -> i32 {
    let a: A = A { x: 0usize };
    let A { x } = a;
    if x != 0usize { return 1; }
    return 0;
}
