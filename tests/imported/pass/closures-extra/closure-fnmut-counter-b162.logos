// Tests a mutating FnMut closure passed to a generic `F: FnMut() -> i64` bound
//   and invoked multiple times.
package closure_fnmut_counter_b162;

fn apply_n<F: FnMut() -> i64>(mut f: F, n: i64) -> i64 {
    let mut last: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < n {
        last = f();
        i = i + 1i64;
    }
    return last;
}

fn main() -> i32 {
    let mut count: i64 = 0i64;
    let bump = || -> i64 {
        count = count + 1i64;
        return count;
    };
    let final_val: i64 = apply_n::<|| -> i64>(bump, 5i64);
    if final_val != 5i64 { return 1i32; }
    if count != 5i64 { return 2i32; }
    return 0i32;
}
