package c_coerce_mut_trait_object_8248;

trait A {
    fn dummy(&self) -> i64;
}

struct B {}

impl A for B {
    fn dummy(&self) -> i64 { return 17i64; }
}

fn foo(x: &mut dyn A) -> i64 {
    return x.dummy();
}

fn main() -> i32 {
    let mut b: B = B {};
    let r = foo(&mut b);
    if r != 17i64 { return 1i32; }
    return 0i32;
}
