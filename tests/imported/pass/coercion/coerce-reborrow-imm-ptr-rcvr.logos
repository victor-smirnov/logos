package c_coerce_reborrow_imm_ptr_rcvr;

use std.fmt;
use std.lang.text;

struct SpeechMaker { speeches: usize }

impl SpeechMaker {
    pub fn how_many(&self) -> usize { return self.speeches; }
}

fn foo(speaker: &SpeechMaker) -> usize {
    return speaker.how_many() + 33usize;
}

fn main() -> i32 {
    let lincoln: SpeechMaker = SpeechMaker { speeches: 22usize };
    assert_eq!(foo(&lincoln), 55usize);
    return 0;
}
