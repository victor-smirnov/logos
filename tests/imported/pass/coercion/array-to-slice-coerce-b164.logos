// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/coercion/ shapes (distilled).
// Modifications: isize->i64; assert->if-return sentinels.
// Tests unsized coercion of a fixed array reference `&[i64; N]` to a slice
//   `&[i64]` passed to a function that uses .len() and indexing.
package array_to_slice_coerce_b164;

fn sum_slice(s: &[i64]) -> i64 {
    let mut total: i64 = 0i64;
    let mut i: i64 = 0i64;
    let n: i64 = s.len();
    while i < n {
        total = total + s[i];
        i = i + 1i64;
    }
    return total;
}

fn main() -> i32 {
    let a: [i64; 4] = [10i64, 20i64, 30i64, 40i64];
    if sum_slice(&a) != 100i64 { return 1i32; }

    let b: [i64; 2] = [5i64, 6i64];
    if sum_slice(&b) != 11i64 { return 2i32; }
    return 0i32;
}
