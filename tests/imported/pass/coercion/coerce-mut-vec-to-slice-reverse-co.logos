package coerce_mut_vec_to_slice_reverse_co;
fn reverse(v: &mut Vec<u64>) { (*v).reverse(); }
fn bar(v: &mut Vec<u64>) {
    reverse(v);
    reverse(v);
    reverse(v);
}
fn main() -> i32 {
    let mut the_vec: Vec<u64> = vec_new();
