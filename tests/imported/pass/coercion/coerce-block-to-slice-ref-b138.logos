// Tests coercing `&[i32; 3]` to `&[i32]` and reading the slice length/elements.
package coerce_block_to_slice_ref_b138;

fn sum(s: &[i32]) -> i32 {
    let mut acc: i32 = 0i32;
    let mut i: i64 = 0i64;
    let n: i64 = s.len();
    while i < n {
        acc = acc + s[i];
        i = i + 1i64;
    }
    return acc;
}

fn main() -> i32 {
    let a: [i32; 3] = [1i32, 2i32, 3i32];
    let s: &[i32] = &a;
    if sum(s) != 6i32 { return 1i32; }
    return 0i32;
}
