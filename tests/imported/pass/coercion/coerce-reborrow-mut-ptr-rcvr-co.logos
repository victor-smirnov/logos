package coerce_reborrow_mut_ptr_rcvr_co;
struct SpeechMaker { speeches: u64 }
impl SpeechMaker { fn talk(self: &mut SpeechMaker) { (*self).speeches = (*self).speeches + 1u64; } }
fn give_a_few_speeches(speaker: &mut SpeechMaker) {
    speaker.talk();
    speaker.talk();
    speaker.talk();
}
fn main() -> i32 {
    let mut lincoln: SpeechMaker = SpeechMaker { speeches: 22u64 };
    give_a_few_speeches(&mut lincoln);
    if lincoln.speeches == 25u64 { return 0i32; }
    return 1i32;
}
