// Original path: tests/ui/coercion/coerce-unify-return.rs
// Modifications: `fn()` -> `fn()->i64` (so the wrapped value is observable);
// the `Foo.foo(main)` method-call facet dropped; turbofish on Some dropped.
// Tests that wrapping a fn ITEM in `Some(..)` unifies its type to the expected
// `Option<fn()->i64>` return/binding type, then unwrapping + calling it.
package coerce_unify_return_coe4;

fn target() -> i64 { return 99i64; }

fn main() -> i32 {
    let o: Option<fn() -> i64> = Some(target);
    match o {
        Option::Some(g) => {
            if g() != 99i64 { return 1i32; }
        }
        Option::None => { return 2i32; }
    }
    return 0i32;
}
