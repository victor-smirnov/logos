// A `&mut Struct` argument re-passed to a fn taking `&mut Struct` — implicit reborrow, no move error.
// usize->u64; pub fn main->fn main->i32; assert via final field check.
package coerce_reborrow_mut_ptr_arg_co;
struct SpeechMaker { speeches: u64 }
fn talk(x: &mut SpeechMaker) { (*x).speeches = (*x).speeches + 1u64; }
fn give_a_few_speeches(speaker: &mut SpeechMaker) {
    talk(speaker);
    talk(speaker);
    talk(speaker);
}
fn main() -> i32 {
    let mut lincoln: SpeechMaker = SpeechMaker { speeches: 22u64 };
    give_a_few_speeches(&mut lincoln);
    if lincoln.speeches == 25u64 { return 0i32; }
    return 1i32;
}
