// Original path: tests/ui/coercion/coerce-reborrow-mut-ptr-arg.rs
// Modifications: usize->i64; &self/&mut self n/a; assert -> sentinel.
// Tests reborrow of a `&mut SpeechMaker` argument across multiple calls (no move
//   errors — each `talk(speaker)` reborrows the &mut).
package coerce_reborrow_mut_ptr_arg_b158;

struct SpeechMaker { speeches: i64 }

fn talk(x: &mut SpeechMaker) {
    x.speeches = x.speeches + 1i64;
}

fn give_a_few_speeches(speaker: &mut SpeechMaker) {
    talk(speaker);
    talk(speaker);
    talk(speaker);
}

fn main() -> i32 {
    let mut lincoln = SpeechMaker { speeches: 22i64 };
    give_a_few_speeches(&mut lincoln);
    if lincoln.speeches != 25i64 { return 1i32; }
    return 0i32;
}
