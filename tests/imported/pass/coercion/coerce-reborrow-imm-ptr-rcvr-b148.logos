package coerce_reborrow_imm_ptr_rcvr_b148;

struct SpeechMaker { speeches: u64 }

impl SpeechMaker {
    fn how_many(self: &SpeechMaker) -> u64 { self.speeches }
}

fn foo(speaker: &SpeechMaker) -> u64 {
    speaker.how_many() + 33u64
}

fn main() -> i32 {
    let lincoln = SpeechMaker { speeches: 22u64 };
    if foo(&lincoln) != 55u64 { return 1i32; }
    return 0i32;
}
