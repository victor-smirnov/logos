// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/coercion/basic-ptr-coercions.rs
// Modifications: literal suffixes (`42isize`); otherwise the original
// is faithful — `&<literal>` bound to a `let` lifts the temp into a
// hidden synth-local (C6-cc-04 closed 2026-05-11). All four implicit
// coercions tested: `&mut→&`, `&→*const`, `&mut→*const`, `*mut→*const`
// (B3-bg-05 / C6-cc-05 / C6-cc-06 closed in Sprint 2).
package basic_ptr_coercions;

fn main() -> i32 {
    // &mut -> &
    let x: &mut isize = &mut 42isize;
    let _x: &isize    = x;
    let _x: &isize    = &mut 42isize;

    // & -> *const
    let x: &isize        = &42isize;
    let _x: *const isize = x;
    let _x: *const isize = &42isize;

    // &mut -> *const
    let x: &mut isize    = &mut 42isize;
    let _x: *const isize = x;
    let _x: *const isize = &mut 42isize;

    // *mut -> *const
    let _x: *mut isize   = &mut 42isize;
    let _x: *const isize = x;
    return 0;
}
