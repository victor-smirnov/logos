package m_coerce_bare_fn_zst;

use logos.lang.iter;
use logos.lang.range;

struct Foo {}

fn uint_to_foo(_x: u64) -> Foo {
    return Foo {};
}

fn main() -> i32 {
    let r = (0u64..10u64);
    let _ = r.map(uint_to_foo);
    return 0;
}
