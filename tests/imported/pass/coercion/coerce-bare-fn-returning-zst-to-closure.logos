// Modifications: `struct Foo;` → `struct Foo {}` (Logos zero-field struct);
// usize → i64 (Logos's range literal lowers to `RangeI64`, whose `map`
// declares `MapFn: FnMut(i64) -> …`; the u64 spelling this file carried was
// admitted only because an Fn-family bound's SIGNATURE was never checked —
// #115, closed); the range `(0..10)` carries i64-suffixed bounds. Test point is
// that coercing a bare fn returning a zero-sized type into the closure
// parameter of `Iterator::map` compiles + links cleanly (the original was a
// regression test for an LLVM ERROR). Adapter is lazy, matching Rust where the
// result is never consumed.
package m_coerce_bare_fn_zst;

use logos.lang.iter;
use logos.lang.range;

struct Foo {}

fn uint_to_foo(_x: i64) -> Foo {
    return Foo {};
}

fn main() -> i32 {
    let r = (0i64..10i64);
    let _ = r.map(uint_to_foo);
    return 0;
}
