package m_coerce_unify_return;

use logos.lang.option;

struct Foo {}
impl Foo {
    fn foo<T>(self: Self, x: T) -> Option<T> { return Some(x); }
}

fn dummy() {}

fn main() -> i32 {
    let a: Option<fn()> = Some(dummy);
    let f: Foo = Foo {};
    let b: Option<fn()> = f.foo(dummy);

    match a {
        Option::Some(g) => { g(); }
        Option::None => { return 1; }
    }
    match b {
        Option::Some(g) => { g(); }
        Option::None => { return 2; }
    }
    return 0;
}
