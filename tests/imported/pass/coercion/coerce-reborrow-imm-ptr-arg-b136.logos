//   typeck-only test); pub fn main()→i32.
// Tests that a `&mut i64` argument REBORROWS as a `&i64` when passed to a fn
// expecting a shared reference (`negate_mut(y:&mut i64)` calls `negate(y)`).
package coerce_reborrow_imm_ptr_arg_b136;

fn negate(x: &i64) -> i64 {
    return 0i64 - *x;
}

fn negate_mut(y: &mut i64) -> i64 {
    return negate(y);
}

fn negate_imm(y: &i64) -> i64 {
    return negate(y);
}

fn main() -> i32 {
    let mut a: i64 = 5i64;
    if negate_mut(&mut a) != (0i64 - 5i64) { return 1i32; }
    if negate_imm(&a) != (0i64 - 5i64) { return 2i32; }
    return 0i32;
}
