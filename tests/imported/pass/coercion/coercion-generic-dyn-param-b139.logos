package coercion_generic_dyn_param_b139;

trait Trait<T> {
    fn f(self: &Self, x: T) -> T;
}

struct Struct { x: i64, y: i64 }

impl Trait<i64> for Struct {
    fn f(self: &Struct, x: i64) -> i64 {
        self.x + self.y + x
    }
}

fn main() -> i32 {
    let a = Struct { x: 1i64, y: 2i64 };
    let c: &dyn Trait<i64> = &a;
    if c.f(10i64) != 13i64 { return 1i32; }
    return 0i32;
}
