// Verifies fn-pointer LUB coercion across array elements, if-else arms and
// match arms, then calls one through to confirm it runs.
package m_coerce_many_with_ty_var;

fn foo() {}
fn bar() {}

fn main() -> i32 {
    let arr: [fn(); 2] = [foo, bar];

    let chosen_if: fn() = if false { foo } else { bar };
    let chosen_match: fn() = match false {
        true => foo,
        false => bar,
    };

    arr[0i64]();
    arr[1i64]();
    chosen_if();
    chosen_match();
    return 0;
}
