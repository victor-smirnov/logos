package coercion_generic_dyn_coe4;

trait Trait {
    fn f(self: &Self, x: i64) -> i64;
}

struct Struct {
    x: i64,
    y: i64,
}

impl Trait for Struct {
    fn f(self: &Struct, x: i64) -> i64 {
        return self.x + self.y + x;
    }
}

fn main() -> i32 {
    let a = Struct { x: 1i64, y: 2i64 };
    let c: &dyn Trait = &a;
    if c.f(10i64) != 13i64 { return 1i32; }
    return 0i32;
}
