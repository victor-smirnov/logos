package c_coerce_reborrow_mut_ptr_arg;

struct SpeechMaker { speeches: usize }

fn talk(x: &mut SpeechMaker) { x.speeches = x.speeches + 1usize; }

fn give_a_few_speeches(speaker: &mut SpeechMaker) {
    talk(speaker);
    talk(speaker);
    talk(speaker);
}

fn main() -> i32 {
    let mut lincoln: SpeechMaker = SpeechMaker { speeches: 22usize };
    give_a_few_speeches(&mut lincoln);
    if lincoln.speeches != 25usize { return 1; }
    return 0;
}
