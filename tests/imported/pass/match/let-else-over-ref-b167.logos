// Regression (B167): `let Some(v) = &opt else { … }` — let-else over a
// by-reference enum scrutinee. SLetElse codegen now auto-derefs `&Enum` /
// `&mut Enum` (a Logos enum value is a heap ptr, so `&Enum` is two-level),
// matching the match-expression path. Previously this emitted no code (the
// whole function collapsed to `unreachable`) → SIGSEGV.
package let_else_over_ref_b167;
use logos.lang.option;
fn first(o: &Option<i64>) -> i64 {
    let Option::Some(v) = o else { return -1i64; };
    return *v;
}
fn main() -> i32 {
    let x: Option<i64> = Option::Some(7i64);
    if first(&x) != 7i64 { return 1i32; }
    let y: Option<i64> = Option::None;
    if first(&y) != -1i64 { return 2i32; }
    return 0i32;
}
