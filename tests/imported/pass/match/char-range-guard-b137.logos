// Tests overlapping inclusive char-range match arms with a match GUARD: a
//   guarded `'a'..='b' if false` arm is skipped in favor of the exact `'a'` arm.
package char_range_guard_b137;

fn main() -> i32 {
    let x: char = 'a';
    let y: i64 = match x {
        'a' ..= 'b' if false => 1i64,
        'a' => 2i64,
        'a' ..= 'b' => 3i64,
        _ => 9i64,
    };
    if y != 2i64 { return 1i32; }
    return 0i32;
}
