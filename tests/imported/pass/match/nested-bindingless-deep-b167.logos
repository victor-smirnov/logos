// Regression (B167): deeply-nested BINDINGLESS variant patterns
// (`Some(Some(None))` over `Option<Option<Option<i64>>>`, and deeper) used to
// miscompile — the bindingless nested-guard path didn't ISOLATE the inner
// refutable-variant guards it built, so beyond 2 levels they leaked into the
// enclosing arm and referenced synths bound only inside the guard match,
// giving wrong dispatch. Fixed by isolating those guards into the guard arm's
// VALUE (`match synth { <sub> => <inner_check>, _ => false }`). Independent of
// the K4 BINDING-pattern path (that stays 1-level for now).
package nested_bindingless_deep_b167;
use logos.lang.option;

fn d3(o: Option<Option<Option<i64>>>) -> i64 {
    match o {
        Option::Some(Option::Some(Option::None)) => 10i64,
        Option::Some(Option::Some(Option::Some(_))) => 11i64,
        Option::Some(Option::None) => 20i64,
        Option::None => 30i64,
    }
}
fn d4(o: Option<Option<Option<Option<i64>>>>) -> i64 {
    match o {
        Option::Some(Option::Some(Option::Some(Option::None))) => 100i64,
        Option::Some(Option::Some(Option::None)) => 200i64,
        Option::Some(Option::None) => 300i64,
        Option::None => 400i64,
        _ => 999i64,
    }
}
fn main() -> i32 {
    if d3(Option::Some(Option::Some(Option::None))) != 10i64 { return 1i32; }
    if d3(Option::Some(Option::Some(Option::Some(7i64)))) != 11i64 { return 2i32; }
    if d3(Option::Some(Option::None)) != 20i64 { return 3i32; }
    if d3(Option::None) != 30i64 { return 4i32; }
    if d4(Option::Some(Option::Some(Option::Some(Option::None)))) != 100i64 { return 5i32; }
    if d4(Option::Some(Option::Some(Option::None))) != 200i64 { return 6i32; }
    if d4(Option::Some(Option::None)) != 300i64 { return 7i32; }
    if d4(Option::None) != 400i64 { return 8i32; }
    return 0i32;
}
