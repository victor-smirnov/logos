// Modifications: `&str`→`str`; `assert!`→return-code checks; `pub fn main()`→
// `fn main()->i32`. A faithful run-pass companion to the G172-1 string-literal
// pattern work: matching a `str` parameter against literal arms inside a
// function, with a wildcard fallthrough.
package match_string_fn;

fn compare(x: str, y: str) -> bool {
    match x {
        "foo" => { return y == "foo"; }
        _ => { return y == "bar"; }
    }
}

fn main() -> i32 {
    if !compare("foo", "foo") { return 1i32; }
    if compare("foo", "bar") { return 2i32; }
    if !compare("zzz", "bar") { return 3i32; }
    return 0i32;
}
