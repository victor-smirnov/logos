// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/match/match-large-array.rs
// Modifications: faithful — array-prefix patterns `[1, ..]` now lower
// end-to-end on fixed-size array scrutinees (P4-pm-04 closed
// 2026-05-11), so the original two-`match` body is restored.
package match_large_array;

use std.fmt;
use std.lang.text;

fn main() -> i32 {
    let r: usize = match [0u8; 1024] {
        _ => 42usize,
    };
    assert_eq!(r, 42usize);

    let r2: usize = match [0u8; 1024] {
        [1u8, ..] => 0usize,
        [0u8, ..] => 1usize,
        _         => 2usize,
    };
    assert_eq!(r2, 1usize);
    return 0;
}
