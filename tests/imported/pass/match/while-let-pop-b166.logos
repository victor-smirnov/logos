package v02;
struct Stack { data: [i64; 5], top: i64 }
impl Stack {
    fn pop(self: &mut Self) -> Option<i64> {
        if self.top <= 0i64 { return Option::None; }
        self.top = self.top - 1i64;
        return Option::Some(self.data[self.top]);
    }
}
fn main() -> i32 {
    let mut s: Stack = Stack { data: [10i64,20i64,30i64,0i64,0i64], top: 3i64 };
    let mut sum: i64 = 0i64;
    while let Option::Some(v) = s.pop() { sum = sum + v; }
    if sum != 60i64 { return 1i32; }
    return 0i32;
}
