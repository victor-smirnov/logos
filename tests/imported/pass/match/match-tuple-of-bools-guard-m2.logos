// Original path: distilled from tests/ui/match/guards.rs + tuple-pattern facets
// Facet: match on a TUPLE of two bools with literal tuple patterns plus a
// guarded catch-all — exhaustive 2x2 grid, deterministic arm selection.
package match_tuple_of_bools_guard_m2;

fn classify(a: bool, b: bool) -> i64 {
    match (a, b) {
        (true, true) => { return 3i64; }
        (true, false) if a => { return 2i64; }
        (false, true) => { return 1i64; }
        _ => { return 0i64; }
    }
}

fn main() -> i32 {
    if classify(true, true) != 3i64 { return 1; }
    if classify(true, false) != 2i64 { return 2; }
    if classify(false, true) != 1i64 { return 3; }
    if classify(false, false) != 0i64 { return 4; }
    return 0;
}
