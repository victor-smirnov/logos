package m_guard_pattern_ordering_14865;

use std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.panic;

enum X { Foo(usize), Bar(bool) }

fn main() -> i32 {
    let x: i32 = match X::Foo(42usize) {
        X::Foo(_)  => { 1i32 }
        _ if true  => { 0i32 }
        X::Bar(_)  => { panic("Oh dear"); 0i32 }
    };
    assert_eq!(x, 1i32);

    let y: i32 = match X::Foo(42usize) {
        _ if true  => { 0i32 }
        X::Foo(_)  => { 1i32 }
        X::Bar(_)  => { panic("Oh dear"); 0i32 }
    };
    assert_eq!(y, 0i32);
    return 0;
}
