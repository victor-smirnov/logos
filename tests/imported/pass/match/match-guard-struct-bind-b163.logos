package match_guard_struct_bind_b163;

struct Pt { x: i64, y: i64 }

fn quad(p: Pt) -> i64 {
    match p {
        Pt { x, y } if x > 0i64 && y > 0i64 => { return 1i64; }
        Pt { x, y } if x < 0i64 && y > 0i64 => { return 2i64; }
        Pt { x, y } if x == 0i64 || y == 0i64 => { return 0i64; }
        _ => { return 9i64; }
    }
}

fn main() -> i32 {
    if quad(Pt { x: 1i64, y: 2i64 }) != 1i64 { return 1i32; }
    if quad(Pt { x: -1i64, y: 2i64 }) != 2i64 { return 2i32; }
    if quad(Pt { x: 0i64, y: 5i64 }) != 0i64 { return 3i32; }
    if quad(Pt { x: -1i64, y: -1i64 }) != 9i64 { return 4i32; }
    return 0i32;
}
