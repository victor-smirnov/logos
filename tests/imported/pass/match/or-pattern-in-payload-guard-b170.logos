// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/or-patterns/issue-70413-no-unreachable-pat-and-guard.rs
//   (extracted facet) + guarded nested-payload coverage.
// Regression for two coupled facets:
//   1. A guard reading a binding from a nested-tuple variant payload
//      (`Some((a, b)) if a > N`) — the destructure must run BEFORE the guard
//      (gen_match evaluates the guard in a block preceding the body).
//   2. A multi-alt or-pattern INSIDE a variant payload, with a guard
//      (`Some((a, _) | (_, a)) if a > N`) — or-distribution fans the arm out
//      so the guard re-evaluates per alternative (Rust backtracks alts).
package or_pattern_in_payload_guard_b170;
fn main() -> i32 {
    // Guard reads a nested-tuple payload binding.
    match Some((3i64, 42i64)) {
        Some((a, b)) if a + b > 40i64 => { if a != 3i64 { return 1i32; } }
        _ => { return 2i32; }
    }
    // or-in-payload + guard: first alt (a=3) fails the guard, second (a=42) passes.
    match Some((3i64, 42i64)) {
        Some((a, _) | (_, a)) if a > 10i64 => { if a != 42i64 { return 3i32; } }
        _ => { return 4i32; }
    }
    // or-in-payload + guard where the FIRST alt passes (a=20).
    match Some((20i64, 5i64)) {
        Some((a, _) | (_, a)) if a > 10i64 => { if a != 20i64 { return 5i32; } }
        _ => { return 6i32; }
    }
    // No alternative passes the guard → falls to `_`.
    match Some((1i64, 2i64)) {
        Some((a, _) | (_, a)) if a > 10i64 => { return 7i32; }
        _ => {}
    }
    return 0i32;
}
