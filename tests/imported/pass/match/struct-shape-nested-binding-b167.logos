// Regression (B167): struct-shape enum-variant pattern with a BINDING-carrying
// nested variant on a field — `Msg::Move { x: Some(v), y }`. Routes through
// synth_refutable_inner (arm guard + body let-else) like the tuple-shape path.
// (This works now that payload-less enum-literal field construction is
// type-pinned — the earlier crash was the sibling `{ x: None, y }` value
// construction, not the pattern.)
package struct_shape_nested_binding_b167;
use logos.lang.option;
enum Msg { Move { x: Option<i64>, y: i64 }, Quit }
fn f(m: Msg) -> i64 {
    match m {
        Msg::Move { x: Option::Some(v), y } => v + y,
        Msg::Move { x: Option::None, y } => y,
        Msg::Quit => -1i64,
    }
}
fn main() -> i32 {
    if f(Msg::Move { x: Option::Some(5i64), y: 3i64 }) != 8i64 { return 1i32; }
    if f(Msg::Move { x: Option::None, y: 7i64 }) != 7i64 { return 2i32; }
    if f(Msg::Quit) != -1i64 { return 3i32; }
    return 0i32;
}
