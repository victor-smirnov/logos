// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/match/guards.rs
// Modifications: isize → i64; derive(Copy,Clone) dropped (incidental); the literal arm
//   `10 => { 3 }` is dropped because the preceding `x if x < 11` guard already matches
//   10 (it is dead in the original too); assert_eq! → early-return sentinels.
// Tests: match guards on a scalar (`x if x < N`) and on a struct pattern binding both
//   fields (`Pair { x, y } if x == 10 && y == 20`), with guard fall-through ordering.
package guards_b155;

struct Pair { x: i64, y: i64 }

fn main() -> i32 {
    let a: i64 = match 10i64 {
        x if x < 7i64 => 1i64,
        x if x < 11i64 => 2i64,
        _ => 4i64,
    };
    if a != 2i64 { return 1i32; }

    let b: i64 = match (Pair { x: 10i64, y: 20i64 }) {
        Pair { x: x, y: y } if x < 5i64 && y < 5i64 => 1i64,
        Pair { x: x, y: y } if x == 10i64 && y == 20i64 => 2i64,
        Pair { x: _x, y: _y } => 3i64,
    };
    if b != 2i64 { return 2i32; }

    return 0i32;
}
