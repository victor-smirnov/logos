// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/match/issue-115681.rs
// Modifications: dropped Box (not in Logos's primitive surface);
// `enum Bits { None = 0x00 … }` keeps `None` reserved-ish — Logos
// has no `None` reserved word, but to keep the variant naming
// distinct from the `Option::None` pattern dispatch we use
// `None_v`. The miscompile regression — matching with or-pattern
// across enum variants — is preserved.
package m_issue_115681;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

enum Bits { None_v = 0, Low = 0x40, High = 0x80, Both = 0xC0 }

fn classify(v: u8) -> Bits {
    return match v {
        0x00u8 => { Bits::None_v }
        0x40u8 => { Bits::Low    }
        0x80u8 => { Bits::High   }
        0xC0u8 => { Bits::Both   }
        _      => { Bits::None_v }
    };
}

fn main() -> i32 {
    let value: u8 = 0x40u8;
    let bits:  Bits = classify(value);
    let mut out: u8 = 0u8;
    match bits {
        Bits::None_v | Bits::Low => { out = 1u8; }
        _                        => { }
    }
    assert_eq!(out, 1u8);
    return 0;
}
