package match_guards_b161;

struct Pair { x: i64, y: i64 }

fn main() -> i32 {
    let a: i64 =
        match 10i64 { x if x < 7i64 => { 1i64 } x if x < 11i64 => { 2i64 } 10i64 => { 3i64 } _ => { 4i64 } };
    if a != 2i64 { return 1i32; }

    let b: i64 =
        match (Pair { x: 10i64, y: 20i64 }) {
          x if x.x < 5i64 && x.y < 5i64 => { 1i64 }
          Pair { x: x, y: y } if x == 10i64 && y == 20i64 => { 2i64 }
          Pair { x: _x, y: _y } => { 3i64 }
        };
    if b != 2i64 { return 2i32; }
    return 0i32;
}
