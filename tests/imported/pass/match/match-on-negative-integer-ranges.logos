// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/match/match-on-negative-integer-ranges.rs
// Modifications: original also has an `if let` check — Logos's
// `if let` IS supported (gap P4-pm-05 was wrong, rescinded). For
// brevity we keep only the primary `match` check; the `if let` form
// is exercised by the dedicated `if-let-*` tests instead.
package match_on_negative_integer_ranges;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    let r1: bool = match -50i8 {
        -128i8..=-101i8 => true,
        _ => false,
    };
    assert_eq!(r1, false);
    if let -128i8..=-101i8 = -50i8 {
        return 99;
    }
    return 0;
}
