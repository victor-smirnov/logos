// Tests constructing and matching a generic two-parameter enum
//   `Either<T, U> { Left(T), Right(U) }`.
package either_generic_match_b137;

enum Either<T, U> {
    Left(T),
    Right(U),
}

fn main() -> i32 {
    let e: Either<i64, i64> = Either::Left(17i64);
    let mut hit: i32 = 1i32;
    match e {
        Either::Right(_) => {}
        _ => { hit = 0i32; }
    }
    return hit;
}
