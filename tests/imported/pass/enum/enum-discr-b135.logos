package enum_discr_b135;

enum Animal {
    Cat = 0,
    Dog = 1,
    Horse = 2,
    Snake = 3,
}

enum Hero {
    Batman = -1,
    Superman = -2,
    Ironman = -3,
    Spiderman = -4,
}

fn main() -> i32 {
    let pet: Animal = Animal::Snake;
    let hero: Hero = Hero::Superman;
    if (pet as u64) != 3u64 { return 1i32; }
    if (hero as i64) != (0i64 - 2i64) { return 2i32; }
    return 0i32;
}
