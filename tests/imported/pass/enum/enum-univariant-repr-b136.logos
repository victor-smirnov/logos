// Tests a univariant C-like enum with an explicit discriminant value read
// back via `as i32`, plus an implicit-zero univariant read via `as u16`.
package enum_univariant_repr_b136;

enum Univariant {
    X = 17
}

enum UnivariantWithoutDescr {
    Y
}

fn main() -> i32 {
    if (Univariant::X as i32) != 17i32 { return 1i32; }
    if (UnivariantWithoutDescr::Y as u16) != 0u16 { return 2i32; }
