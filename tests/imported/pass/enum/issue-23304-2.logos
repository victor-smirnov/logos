package e_issue_23304_2;

enum X { A = 42 }
enum Y { A = X::A as isize }

fn main() -> i32 {
    let x: X = X::A;
    let xi: i32 = x as i32;
    if xi != 42i32 { return 1; }
    if Y::A as i32 != 42i32 { return 2; }
    return 0;
}
