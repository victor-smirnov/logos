// Original path: tests/ui/enum/enum-disr-val-pretty.rs
// Modifications: `String::to_string()` argument dropped (Logos doesn't
// box raw &str into String at this site). Negative discriminant
// `imaginary = -1` *is* supported (S8-en-01 rescinded; grammar
// already has `IDENT ASSIGN MINUS INTEGER` alt at variant_def).
package enum_disr_val;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

enum color { red = 1, green, blue, imaginary = -1 }

fn test_color(c: color, val: isize) {
    assert_eq!(c as isize, val);
}

fn main() -> i32 {
    test_color(color::red, 1isize);
    test_color(color::green, 2isize);
    test_color(color::blue, 3isize);
    test_color(color::imaginary, -1isize);
    return 0;
}
