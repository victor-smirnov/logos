package en_generic_either;

enum Either<T, U> { Left(T), Right(U) }

fn main() -> i32 {
    let e: Either<i64, bool> = Either::Left(17i64);
    let r: i64 = match e {
        Either::Left(x) => x,
        _ => 0i64,
    };
    if r != 17i64 { return 1i32; }
    return 0i32;
}
