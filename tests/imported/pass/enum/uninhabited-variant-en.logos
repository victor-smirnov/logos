// Logos can't construct a value of an empty enum to fill a payload here, and
// the test point (constructing one of the *inhabited* variants) is preserved.
// CamelCase variants.
package en_uninhabited_variant;

enum Foo {
    A(i32),
    C(i32),
}

fn main() -> i32 {
    let foo: Foo = Foo::A(0i32);
    let r: i32 = match foo {
        Foo::A(x) => x,
        Foo::C(x) => x + 1i32,
    };
    if r != 0i32 { return 1i32; }
    return 0i32;
}
