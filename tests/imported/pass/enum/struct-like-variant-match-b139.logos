package struct_like_variant_match_b139;

enum Foo {
    Bar { x: i64, y: i64 },
    Baz { x: f64, y: f64 },
}

fn f(p: &Foo) -> i32 {
    match *p {
        Foo::Baz { x: x, y: y } => {
            if x != 1.0f64 { return 1i32; }
            if y != 2.0f64 { return 2i32; }
        }
        Foo::Bar { y: y, x: x } => {
            if x != 1i64 { return 3i32; }
            if y != 2i64 { return 4i32; }
        }
    }
    return 0i32;
}

fn main() -> i32 {
    let x = Foo::Bar { x: 1i64, y: 2i64 };
    let r1 = f(&x);
    if r1 != 0i32 { return r1; }
    let y = Foo::Baz { x: 1.0f64, y: 2.0f64 };
    let r2 = f(&y);
    if r2 != 0i32 { return r2; }
    return 0i32;
}
