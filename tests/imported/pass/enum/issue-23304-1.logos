package e_issue_23304_1;

enum ValueType { DOUBLE = 0, INT32 = 1 }

enum ValueTag {
    INT32 = metacall { 0x1FFF0i64 | 1i64 },
    X     = metacall { 0x1FFF1i64 },
}

enum ValueShiftedTag {
    INT32 = ValueTag::INT32 as u64,
    X     = metacall { 0x1FFF2i64 },
}

