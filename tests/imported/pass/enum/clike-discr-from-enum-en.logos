// Modifications: `#[repr]` dropped; `as isize`->`as i64`; `assert_eq!`->return.
// The discriminant of `Y::A` is initialized from `X::A as i64`. Exercises a
// C-like enum whose discriminant expression references another enum's cast.
package en_clike_discr_from_enum;

enum X { A = 42 }
enum Y { A = 42 }

fn main() -> i32 {
    let x: X = X::A;
    if (x as i64) != 42i64 { return 1i32; }
    if (Y::A as i64) != 42i64 { return 2i32; }
    return 0i32;
}
