// Original path: tests/ui/enum/struct-like-variant-match.rs
// Modifications: `isize`->i64; `println!` dropped; the value read from the
// matched named fields is checked via if-return. Exercises matching a
// struct-like enum variant and binding its named fields.
package en_struct_like_variant_match;

enum Foo {
    Bar { a: i64, b: i64 },
    Baz { c: i64 },
}

fn main() -> i32 {
    let x: Foo = Foo::Bar { a: 2i64, b: 3i64 };
    let r: i64 = match x {
        Foo::Bar { a, b } => a + b,
        Foo::Baz { c } => c,
    };
    if r != 5i64 { return 1i32; }
    return 0i32;
}
