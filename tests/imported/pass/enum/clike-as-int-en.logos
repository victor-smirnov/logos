package en_clike_as_int;

enum E { X = 17, Y, Z = 100 }

fn main() -> i32 {
    if (E::X as i32) != 17i32 { return 1i32; }
    if (E::Y as i32) != 18i32 { return 2i32; }
    if (E::Z as i32) != 100i32 { return 3i32; }
    return 0i32;
}
