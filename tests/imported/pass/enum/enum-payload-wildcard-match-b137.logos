// Tests matching a single-variant enum carrying a `u8` payload with a `_` arm.
package enum_payload_wildcard_match_b137;

enum Foo {
    Inner(u8),
}

fn main() -> i32 {
    let f: Foo = Foo::Inner(1u8);
    let mut hit: i32 = 1i32;
    match f {
        _ => { hit = 0i32; }
    }
    return hit;
}
