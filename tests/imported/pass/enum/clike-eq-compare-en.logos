// comparing two enum values through their `as i32` discriminants.
package en_clike_eq_compare;

enum Either { One, Two }

fn same(a: Either, b: Either) -> bool {
    return (a as i32) == (b as i32);
}

fn main() -> i32 {
    if !same(Either::One, Either::One) { return 1i32; }
    if same(Either::One, Either::Two) { return 2i32; }
    return 0i32;
}
