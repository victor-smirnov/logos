package en_struct_like_variant_construct;

enum Foo {
    Bar { a: i64, b: i64 },
    Baz { c: f64, d: f64 },
}

fn main() -> i32 {
    let _x: Foo = Foo::Bar { a: 2i64, b: 3i64 };
    let _y: Foo = Foo::Baz { c: 1.0f64, d: 2.0f64 };
    return 0i32;
}
