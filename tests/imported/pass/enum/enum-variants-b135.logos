package enum_variants_b135;

enum Animal {
    Dog(String, f64),
    Cat { name: String, weight: f64 },
}

fn main() -> i32 {
    let mut a: Animal = Animal::Dog("Cocoa".to_string(), 37.2f64);
    a = Animal::Cat { name: "Spotty".to_string(), weight: 2.7f64 };
    // permuting the struct-variant fields should work too
    let _c = Animal::Cat { weight: 3.1f64, name: "Spreckles".to_string() };
