package e_enum_disr_val;

enum color { red = 1, green, blue, imaginary = -1 }

fn main() -> i32 {
    if color::red       as isize !=  1isize { return 1; }
    if color::green     as isize !=  2isize { return 2; }
    if color::blue      as isize !=  3isize { return 3; }
    if color::imaginary as isize != -1isize { return 4; }
    return 0;
}
