// Tests a two-type-param generic enum, construction/match at multiple
//   instantiations, and a generic fn over it.
package generic_enum_either_map_b162;

enum Either<L, R> {
    Left(L),
    Right(R),
}

fn left_or<L, R>(e: Either<L, R>, dflt: L) -> L {
    match e {
        Either::Left(l) => { return l; }
        Either::Right(_) => { return dflt; }
    }
}

fn main() -> i32 {
    let a: Either<i64, bool> = Either::Left(7i64);
    if left_or::<i64, bool>(a, 0i64) != 7i64 { return 1i32; }

    let b: Either<i64, bool> = Either::Right(true);
    if left_or::<i64, bool>(b, 99i64) != 99i64 { return 2i32; }

    let c: Either<bool, i64> = Either::Right(123i64);
    match c {
        Either::Right(n) => { if n != 123i64 { return 3i32; } }
        Either::Left(_) => { return 4i32; }
    }
    return 0i32;
}
