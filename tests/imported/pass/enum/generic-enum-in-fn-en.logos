package en_generic_enum_in_fn;

enum E<T> { V(T) }

fn f<T>(x: T) -> bool {
    let _e: E<T> = E::V(x);
    return true;
}

fn main() -> i32 {
    let b: bool = f::<i64>(7i64);
    if !b { return 1i32; }
    return 0i32;
}
