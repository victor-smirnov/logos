// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Distilled from tests/ui/enum/ (generic enum + generic impl method).
// Feature: `impl<T> Opt<T>` with a method matching on `*self` (payload
// ignored). Mirrors Option::is_some without the prelude type. CamelCase
// variants (`Som`/`Non` to avoid clashing with the prelude Option).
package en_generic_enum_method;

enum Opt<T> { Som(T), Non }

impl<T> Opt<T> {
    fn is_some(self: &Opt<T>) -> bool {
        match *self { Opt::Som(_) => true, Opt::Non => false }
    }
}

fn main() -> i32 {
    let o: Opt<i64> = Opt::Som(5i64);
    if !o.is_some() { return 1i32; }
    let n: Opt<i64> = Opt::Non;
    if n.is_some() { return 2i32; }
    return 0i32;
}
