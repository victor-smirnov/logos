// Tests a nested refutable pattern `Num(n @ 1..=5)` binding inside an enum payload.
package enum_range_at_binding_b165;

enum E { Num(i64), Other }
fn f(e: &E) -> i64 {
    match e {
        E::Num(n @ 1i64..=5i64) => { return *n + 100i64; }
        E::Num(n) => { return *n; }
        E::Other => { return 0i64; }
    }
}
fn main() -> i32 {
    if f(&E::Num(3i64)) != 103i64 { return 1i32; }
    if f(&E::Num(9i64)) != 9i64 { return 2i32; }
    if f(&E::Other) != 0i64 { return 3i32; }
    return 0i32;
}
