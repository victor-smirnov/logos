// runtime read of the stored ref.
package return_lifetime_struct_lt;

struct Wrap<'a> { r: &'a i64 }

fn wrap<'a>(x: &'a i64) -> Wrap<'a> { return Wrap { r: x }; }
fn unwrap<'a>(w: &Wrap<'a>) -> i64 { return *w.r; }

fn main() -> i32 {
    let n: i64 = 77i64;
    let w: Wrap = wrap(&n);
    if unwrap(&w) != 77i64 { return 1i32; }
    return 0i32;
}
