// Original path: tests/ui/lifetimes/* the canonical `longest` shape (DISTILLED)
// Both inputs share ONE lifetime `'a` and the output borrows `'a`; the returned
// borrow is chosen by a RUNTIME comparison, so both branches are exercised
// (distinct from regions-multi-lifetime-pick which returns a fixed input).
package longest_same_lifetime_lt;

fn longest<'a>(x: &'a i64, y: &'a i64) -> &'a i64 {
    if *x > *y { return x; } else { return y; }
}

fn main() -> i32 {
    let a: i64 = 7i64;
    let b: i64 = 3i64;
    if *longest(&a, &b) != 7i64 { return 1i32; }
    if *longest(&b, &a) != 7i64 { return 2i32; }
    let c: i64 = 50i64;
    if *longest(&a, &c) != 50i64 { return 3i32; }
    return 0i32;
}
