package m_trait_object_constructor_14821;

trait SomeTrait {
    fn tag(&self) -> i32;
}

struct Meow {}
impl SomeTrait for Meow {
    fn tag(&self) -> i32 { return 7i32; }
}

struct Foo {
    x: &dyn SomeTrait,
    y: &dyn SomeTrait,
}

impl Foo {
    fn new(x: &dyn SomeTrait, y: &dyn SomeTrait) -> Foo {
        return Foo { x: x, y: y };
    }
}

fn main() -> i32 {
    let r = Meow {};
    let s = Meow {};
    let q = Foo::new(&r as &dyn SomeTrait, &s as &dyn SomeTrait);
    if q.x.tag() != 7i32 { return 1; }
    if q.y.tag() != 7i32 { return 2; }
    return 0;
}
