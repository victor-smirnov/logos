// the payload). `match *self`-style explicit deref of the `&Enum` scrutinee.
package enum_ref_variant_match_lt;

enum Ref<'a> { Borrowed(&'a i64), Empty }

fn get<'a>(r: &Ref<'a>) -> i64 {
    match *r {
        Ref::Borrowed(v) => { return *v; }
        Ref::Empty => { return -1i64; }
    }
}

fn main() -> i32 {
    let n: i64 = 99i64;
    let r: Ref = Ref::Borrowed(&n);
    if get(&r) != 99i64 { return 1i32; }
    let e: Ref = Ref::Empty;
    if get(&e) != -1i64 { return 2i32; }
    return 0i32;
}
