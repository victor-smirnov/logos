package control_nested_if_b164;

fn grade(score: i64) -> i64 {
    if score >= 90i64 {
        return 4i64;
    } else if score >= 80i64 {
        return 3i64;
    } else if score >= 70i64 {
        return 2i64;
    } else {
        if score >= 60i64 { return 1i64; }
        return 0i64;
    }
}

fn main() -> i32 {
    if grade(95i64) != 4i64 { return 1i32; }
    if grade(85i64) != 3i64 { return 2i32; }
    if grade(72i64) != 2i64 { return 3i32; }
    if grade(65i64) != 1i64 { return 4i32; }
    if grade(50i64) != 0i64 { return 5i32; }

    // if-expression yielding a value
    let sign: i64 = if -3i64 < 0i64 { -1i64 } else { 1i64 };
    if sign != -1i64 { return 6i32; }
    return 0i32;
}
