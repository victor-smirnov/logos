// Tests an if / else-if / else chain selecting one of four buckets.
package control_else_if_chain_b165;

fn bucket(n: i64) -> i64 {
    if n < 10i64 { return 0i64; }
    else if n < 20i64 { return 1i64; }
    else if n < 30i64 { return 2i64; }
    else { return 3i64; }
}
fn main() -> i32 {
    if bucket(5i64) != 0i64 { return 1i32; }
    if bucket(15i64) != 1i64 { return 2i32; }
    if bucket(25i64) != 2i64 { return 3i32; }
    if bucket(99i64) != 3i64 { return 4i32; }
    return 0i32;
}
