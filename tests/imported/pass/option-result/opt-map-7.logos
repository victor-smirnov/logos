package opt_map_7;
enum Opt<T> { Some(T), None }
fn map(o: Opt<i32>) -> Opt<i32> {
    match o {
        Opt::Some(x) => return Opt::Some(x * 2i32),
        Opt::None    => return Opt::None,
    }
}
fn main() -> i32 {
    let o: Opt<i32> = Opt::Some(7i32);
    let m: Opt<i32> = map(o);
    let r: i32 = match m {
        Opt::Some(x) => x,
        Opt::None    => 0i32,
    };
    return r - 14i32;
}
