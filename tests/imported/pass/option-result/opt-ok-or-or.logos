// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Feature: Option::ok_or / ok_or_else — convert Option to Result.
package opt_ok_or_or;
use logos.lang.option;
use logos.lang.result;
fn main() -> i32 {
    let a: Option<i32> = Option::Some(5i32);
    let r: Result<i32, i32> = a.ok_or(99i32);
    match r { Result::Ok(v) => { if v != 5i32 { return 1i32; } } Result::Err(_) => { return 2i32; } }
    let b: Option<i32> = Option::None;
    let e: Result<i32, i32> = b.ok_or_else(|| -> i32 { return 13i32; });
    match e { Result::Ok(_) => { return 3i32; } Result::Err(c) => { if c != 13i32 { return 4i32; } } }
    return 0i32;
}
