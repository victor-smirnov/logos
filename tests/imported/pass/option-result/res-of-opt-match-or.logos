use logos.lang.option;
use logos.lang.result;
fn lookup(k: i32) -> Result<Option<i32>, i32> {
    if k < 0i32 { return Result::Err(1i32); }
    if k == 0i32 { return Result::Ok(Option::None); }
    return Result::Ok(Option::Some(k * 2i32));
}
