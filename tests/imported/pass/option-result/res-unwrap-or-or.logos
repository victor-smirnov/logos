// Feature: Result::unwrap_or and unwrap_or_else fallbacks.
package res_unwrap_or_or;
use logos.lang.result;
fn main() -> i32 {
    let a: Result<i32, i32> = Result::Err(3i32);
    let v: i32 = a.unwrap_or(0i32);
    if v != 0i32 { return 1i32; }
    let b: Result<i32, i32> = Result::Err(3i32);
