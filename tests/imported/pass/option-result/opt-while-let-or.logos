// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Feature: while-let loop draining a producer that yields Option, ending on None.
package opt_while_let_or;
use logos.lang.option;
fn step(i: i32) -> Option<i32> {
    if i >= 4i32 { return Option::None; }
    return Option::Some(i + 1i32);
}
fn main() -> i32 {
    let mut sum: i32 = 0i32;
    let mut i: i32 = 0i32;
    while let Option::Some(x) = step(i) {
        sum = sum + x;
        i = i + 1i32;
    }
    if sum != 10i32 { return 1i32; }
    return 0i32;
}
