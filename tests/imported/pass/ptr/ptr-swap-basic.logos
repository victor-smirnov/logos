package ptr_swap_basic;

use logos.lang.mem;

fn main() -> i32 {
    let mut x = 3i64;
    let mut y = 7i64;
    swap_ref(&mut x, &mut y);
    if x != 7i64 { return 1; }
    if y != 3i64 { return 2; }
    return 0;
}
