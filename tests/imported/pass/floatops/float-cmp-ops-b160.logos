// Tests f64 arithmetic and the full comparison set (== < <= != >= >).
package float_cmp_ops_b160;

fn main() -> i32 {
    let pi = 3.1415927f64;
    // arithmetic combining mul/add/div
    let v = -pi * (pi + 2.0f64 / pi) - pi * 5.0f64;
    if !(v < 0.0f64) { return 1i32; }
    // comparison set
    if pi == 5.0f64 { return 2i32; }
    if !(pi < 10.0f64) { return 3i32; }
    if pi <= 2.0f64 { return 4i32; }
    if !(pi != 22.0f64) { return 5i32; }
    if pi >= 10.0f64 { return 6i32; }
    if !(pi > 1.0f64) { return 7i32; }
    return 0i32;
}
