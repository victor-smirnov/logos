// Modifications: assert->if-return sentinels; f128->f64; comparisons use an
//   epsilon tolerance to stay exact-free.
// Tests f64 arithmetic (add/sub/mul/div), ordering, negation, and an
//   approximate-equality check via |diff| < eps.
package float_ops_b164;

fn approx(a: f64, b: f64) -> bool {
    let d: f64 = a - b;
    if d < 0.0f64 { return -d < 0.0001f64; }
    return d < 0.0001f64;
}

fn main() -> i32 {
    let x: f64 = 1.5f64;
    let y: f64 = 2.0f64;
    if approx(x + y, 3.5f64) != true { return 1i32; }
    if approx(x * y, 3.0f64) != true { return 2i32; }
    if approx(y - x, 0.5f64) != true { return 3i32; }
    if approx(y / x, 1.3333f64) != true { return 4i32; }

    if x >= y { return 5i32; }
    if -x >= 0.0f64 { return 6i32; }
    return 0i32;
}
