// Tests f64 arithmetic, all six comparison operators, and a branch-based fabs over
//   positive/negative inputs.
package f64_arith_cmp_b163;

fn fabs(x: f64) -> f64 { if x < 0.0f64 { return -x; } return x; }

fn close(a: f64, b: f64) -> bool {
    let d: f64 = fabs(a - b);
    return d < 0.0001f64;
}

fn main() -> i32 {
    if !close(1.5f64 + 2.5f64, 4.0f64) { return 1i32; }
    if !close(10.0f64 / 4.0f64, 2.5f64) { return 2i32; }
    if !(1.0f64 < 2.0f64) { return 3i32; }
    if !(2.0f64 >= 2.0f64) { return 4i32; }
    if 3.0f64 > 3.5f64 { return 5i32; }
    if !close(fabs(-7.25f64), 7.25f64) { return 6i32; }
    return 0i32;
}
