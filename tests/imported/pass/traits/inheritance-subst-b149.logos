package inheritance_subst_b149;
// Faithful port of rustc tests/ui/traits/inheritance/subst.rs.
// Multi-type-param user trait used as a supertrait that binds every
// position to Self (`MyNum : Add<Self, Self>`); the inherited `add`
// method's `&RHS` / `Result` formals must substitute to the dispatch
// type T (G148-2). `assert_eq!(z.val, 8)` → exit code 8.
pub trait Add<RHS, Result> {
    fn add(self: &Self, rhs: &RHS) -> Result;
}

trait MyNum : Add<Self, Self> { }

struct MyInt { val: isize }

impl Add<MyInt, MyInt> for MyInt {
    fn add(self: &Self, other: &MyInt) -> MyInt { return mi(self.val + other.val); }
}

impl MyNum for MyInt {}

fn f<T: MyNum>(x: T, y: T) -> T {
    return x.add(&y);
}

fn mi(v: isize) -> MyInt { return MyInt { val: v }; }

pub fn main() -> i64 {
    let x = mi(3);
    let y = mi(5);
    let z = f(x, y);
    return z.val as i64;
}
