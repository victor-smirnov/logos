// Tests a trait STATIC method `fn new() -> Self` implemented per-type and
//   called through the concrete type path.
package static_method_by_return_type_b140;

trait HasNew {
    fn new() -> Self;
}

struct Foo { tag: i64 }
struct Bar { tag: i64 }

impl HasNew for Foo {
    fn new() -> Foo { return Foo { tag: 1i64 }; }
}

impl HasNew for Bar {
    fn new() -> Bar { return Bar { tag: 2i64 }; }
}

fn main() -> i32 {
    let f: Foo = Foo::new();
    let b: Bar = Bar::new();
    if f.tag != 1i64 { return 1i32; }
    if b.tag != 2i64 { return 2i32; }
    return 0i32;
}
