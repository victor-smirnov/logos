// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Distilled from tests/ui/traits/ generic-method-in-trait patterns.
// Feature: a trait method that is ITSELF generic (`fn pick<U>(self, a: U, b: U) -> U`),
// monomorphised per call-site type, dispatched on a concrete impl.
package generic_trait_method_tr2;

trait Chooser {
    fn pick<U>(self: &Self, a: U, b: U, first: bool) -> U;
}

struct Picker {}

impl Chooser for Picker {
    fn pick<U>(self: &Picker, a: U, b: U, first: bool) -> U {
        if first { return a; }
        return b;
    }
}

fn main() -> i32 {
    let p = Picker {};
    let x: i64 = p.pick::<i64>(10i64, 20i64, true);
    let y: i64 = p.pick::<i64>(10i64, 20i64, false);
    if x == 10i64 && y == 20i64 { return 0i32; }
    return 1i32;
}
