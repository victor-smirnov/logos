// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Distilled from tests/ui/traits/ + tests/ui/binop unary-operator-overloading patterns.
// Feature: implementing the unary `Neg` operator trait for a user struct so that
// `-v` invokes `Neg::neg`. Distinct from the existing binop Add test.
package operator_neg_impl_tr2;

use logos.lang.ops;

struct Point { x: i64, y: i64 }

impl Neg for Point {
    fn neg(self: Point) -> Point {
        return Point { x: -self.x, y: -self.y };
    }
}

fn main() -> i32 {
    let p = Point { x: 3i64, y: -4i64 };
    let q = -p;
    if q.x == -3i64 && q.y == 4i64 { return 0i32; }
    return 1i32;
}
