package default_method_bound_subst;

trait A<Ty> {
    fn g<Up>(self: &Self, x: Ty, y: Up) -> (Ty, Up) { return (x, y); }
}

impl A<i32> for i32 { }

fn f<Ty, Up, V: A<Ty>>(i: V, j: Ty, k: Up) -> (Ty, Up) {
    return i.g(j, k);
}

fn main() -> i32 {
    let r = f(0i32, 1i32, 2i32);
    if r.0 != 1i32 { return 1; }
    if r.1 != 2i32 { return 2; }
    return 0;
}
