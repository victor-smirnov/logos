package ufcs_trait_method_tr2;

trait Speak { fn say(self: &Self) -> i64; }

struct Dog {}
impl Speak for Dog { fn say(self: &Dog) -> i64 { return 5i64; } }

fn main() -> i32 {
    let d = Dog {};
    if Speak::say(&d) == 5i64 { return 0i32; }
    return 1i32;
}
