// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Distilled from tests/ui/traits/default-method/ override patterns.
// Feature: two impls of a trait with a default method — one keeps the default,
// the other OVERRIDES it; both dispatched, verifying the right body runs.
package default_method_overridden_tr2;

trait Greeter { fn greet(self: &Self) -> i64 { return 1i64; } }

struct Default1 {}
struct Custom1 {}

impl Greeter for Default1 {}
impl Greeter for Custom1 { fn greet(self: &Custom1) -> i64 { return 99i64; } }

fn main() -> i32 {
    let d = Default1 {};
    let c = Custom1 {};
    if d.greet() == 1i64 && c.greet() == 99i64 { return 0i32; }
    return 1i32;
}
