package default_method_bound_subst4_tr2;

trait A<T> {
    fn g(self: &Self, x: u64) -> u64 { return x; }
}

impl<T> A<T> for i64 {}

fn f<T, V: A<T>>(i: V, j: u64) -> u64 { return i.g(j); }

fn main() -> i32 {
    if f::<f64, i64>(0i64, 2u64) == 2u64 { return 0i32; }
    return 1i32;
}
