// Tests that a type parameter bounded by `Copy` is implicitly copyable — binding
//   `v` to two locals without moving it.
package copy_trait_implicit_copy_b150;

fn can_copy_copy<T: Copy>(v: T) -> T {
    let _a = v;
    let _b = v;
    return v;
}

fn main() -> i64 {
    if can_copy_copy(7i64) != 7 { return 1; }
    return 0;
}
