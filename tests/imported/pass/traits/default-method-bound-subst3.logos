package default_method_bound_subst3;

trait A {
    fn g<Ty>(self: &Self, x: Ty, y: Ty) -> (Ty, Ty) { return (x, y); }
}

impl A for i64 { }

fn f<Ty, V: A>(i: V, j: Ty, k: Ty) -> (Ty, Ty) {
    return i.g(j, k);
}

fn main() -> i32 {
    let r = f(0i64, 1i64, 2i64);
    if r.0 != 1i64 { return 1; }
