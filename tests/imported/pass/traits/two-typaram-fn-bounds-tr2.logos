// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Distilled from tests/ui/traits/ multi-type-param generic-fn patterns.
// Feature: a generic fn with TWO distinct type params each carrying its own bound
// (`combine<A: Val, B: Val>`), summing two different concrete impls.
package two_typaram_fn_bounds_tr2;

trait Val { fn v(self: &Self) -> i64; }

struct Ten {}
struct Five {}

impl Val for Ten { fn v(self: &Ten) -> i64 { return 10i64; } }
impl Val for Five { fn v(self: &Five) -> i64 { return 5i64; } }

fn combine<A: Val, B: Val>(a: &A, b: &B) -> i64 { return a.v() + b.v(); }

fn main() -> i32 {
    let t = Ten {};
    let f = Five {};
    if combine(&t, &f) == 15i64 { return 0i32; }
    return 1i32;
}
