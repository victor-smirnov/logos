package inheritance_cross_trait_call;

trait Foo { fn f(self: &Self) -> i64; }
trait Bar: Foo { fn g(self: &Self) -> i64; }

struct A { x: i64 }

impl Foo for A { fn f(self: &A) -> i64 { return 10i64; } }

impl Bar for A {
    fn g(self: &A) -> i64 { return self.f(); }
}

fn main() -> i32 {
    let a = A { x: 3i64 };
    if a.g() != 10i64 { return 1; }
    return 0;
}
