package inheritance_call_bound_inherited;

trait Foo { fn f(self: &Self) -> i64; }
trait Bar: Foo { fn g(self: &Self) -> i64; }

struct A { x: i64 }

impl Foo for A { fn f(self: &A) -> i64 { return 10i64; } }
impl Bar for A { fn g(self: &A) -> i64 { return 20i64; } }

fn gg<T: Bar>(a: &T) -> i64 {
    return a.f();
}

fn main() -> i32 {
    let a = A { x: 3i64 };
    if gg(&a) != 10i64 { return 1; }
    return 0;
}
