package bug_7295_b150;

trait Foo<T> {
    fn func1<U>(self: &Self, t: U, w: T) -> i64;

    fn func2<U>(self: &Self, t: U, w: T) -> i64 {
        return self.func1(t, w);
    }
}

struct S {}

impl Foo<i64> for S {
    fn func1<U>(self: &Self, t: U, w: i64) -> i64 { return w; }
}

