// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/traits/copy-trait-implicit-copy.rs
// Modifications: empty main -> fn main()->i32 that actually CALLS the fn (the
//   upstream main is empty; here we instantiate at i64/u32/bool to exercise the
//   auto-copy at multiple Copy types); the original generic `v: T` used a single
//   instantiation. Note: `char` is NOT `Copy` in Logos (see B139 notes), so the
//   instantiations use i64/u32/bool.
// Tests that a type parameter bound by `Copy` is implicitly copyable: two `let`
//   reads of the same `v` do not move it out.
package copy_trait_implicit_copy_b139;

fn can_copy_copy<T: Copy>(v: T) -> i32 {
    let _a = v;
    let _b = v;
    return 0i32;
}

fn main() -> i32 {
    if can_copy_copy(5i64) != 0i32 { return 1i32; }
    if can_copy_copy(7u32) != 0i32 { return 2i32; }
    if can_copy_copy(true) != 0i32 { return 3i32; }
    return 0i32;
}
