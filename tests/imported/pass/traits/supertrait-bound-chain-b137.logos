// Tests a supertrait chain: `NumExt: Eq + Ord`, `FloatExt: NumExt`, with
//   generic fns bounded on each, dispatching the inherited comparison methods.
package supertrait_bound_chain_b137;

trait NumExt: Eq + Ord {}

trait FloatExt: NumExt {}

fn at_least_one<T: NumExt>(a: &T, b: &T) -> bool {
    return a == b;
}

impl NumExt for i64 {}

fn main() -> i32 {
    let x: i64 = 5i64;
    let y: i64 = 5i64;
    if !at_least_one(&x, &y) { return 1i32; }
    return 0i32;
}
