package inheritance_multiple_inheritors;

trait A { fn a(self: &Self) -> i64; }
trait B: A { fn b(self: &Self) -> i64; }
trait C: A { fn c(self: &Self) -> i64; }

struct S { bogus: i64 }

impl A for S { fn a(self: &S) -> i64 { return 10i64; } }
impl B for S { fn b(self: &S) -> i64 { return 20i64; } }
impl C for S { fn c(self: &S) -> i64 { return 30i64; } }

fn f<T: B + C>(x: &T) -> i64 {
    if x.a() != 10i64 { return 1i64; }
    if x.b() != 20i64 { return 2i64; }
    if x.c() != 30i64 { return 3i64; }
    return 0i64;
}

fn main() -> i32 {
    let s = S { bogus: 0i64 };
    if f(&s) != 0i64 { return 1; }
    return 0;
}
