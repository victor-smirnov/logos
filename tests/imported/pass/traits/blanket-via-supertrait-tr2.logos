// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/traits/inheritance/visibility.rs
// Feature: a blanket impl `impl<T: Foo> Quux for T {}` makes the supertrait Foo's
// method reachable on any `T: Quux` bound — even though Quux declares no methods.
// isize->i64; mod removed (single package); assert via dispatch on a `T: Quux` bound.
package blanket_via_supertrait_tr2;

trait Foo { fn f(self: &Self) -> i64; }
impl Foo for i64 { fn f(self: &i64) -> i64 { return 10i64; } }

trait Quux: Foo {}
impl<T: Foo> Quux for T {}

fn f<T: Quux>(x: &T) -> i64 { return x.f(); }

fn main() -> i32 {
    let z: i64 = 0i64;
    if f(&z) == 10i64 { return 0i32; }
    return 1i32;
}
