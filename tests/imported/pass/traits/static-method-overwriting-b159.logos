//   tag values.
// Tests a trait static method `new() -> Self` with two impls, each selected by
//   the let-annotation type (`let f: Foo = HasNew::new();`).
package static_method_overwriting_b159;

trait HasNew { fn new() -> Self; }

struct Foo { tag: i64 }
struct Bar { tag: i64 }

impl HasNew for Foo {
    fn new() -> Foo { return Foo { tag: 1i64 }; }
}
impl HasNew for Bar {
    fn new() -> Bar { return Bar { tag: 2i64 }; }
}

fn main() -> i32 {
    let f: Foo = HasNew::new();
    let b: Bar = HasNew::new();
    if f.tag != 1i64 { return 1i32; }
    if b.tag != 2i64 { return 2i32; }
    return 0i32;
}
