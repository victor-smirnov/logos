package method_generic_default_fwd_b137;

trait Foo<T> {
    fn func1<U>(self: &Self, t: U, w: T) -> T;
    fn func2<U>(self: &Self, t: U, w: T) -> T {
        return self.func1(t, w);
    }
}

struct S {}

impl Foo<i64> for S {
    fn func1<U>(self: &Self, t: U, w: i64) -> i64 {
        return w;
    }
}

fn main() -> i32 {
    let s: S = S {};
    if s.func2(7i32, 99i64) != 99i64 { return 1i32; }
    return 0i32;
}
