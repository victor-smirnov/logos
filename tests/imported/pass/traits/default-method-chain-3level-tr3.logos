// Feature: a 3-level default-method chain — `meow` (required) calls default `scratch`,
// which calls default `purr`; the concrete impl only supplies `meow`.
package default_method_chain_3level_tr3;

trait Cat {
    fn meow(self: &Self) -> bool;
    fn scratch(self: &Self) -> bool { return self.purr(); }
    fn purr(self: &Self) -> bool { return true; }
}

struct K {}
impl Cat for K { fn meow(self: &K) -> bool { return self.scratch(); } }

fn main() -> i32 {
    let k = K {};
    if k.meow() { return 0i32; }
    return 1i32;
}
