// `#[derive(Debug)]` dropped; the supertrait + impl use Logos's `Eq`
// (== / != operators) instead of Rust's `PartialEq`. A generic fn bounded
// `T: MyNum` (MyNum: Eq) uses `==` to compare two values.
package inheritance_overloading_simple;

use logos.lang.cmp;

trait MyNum: Eq { }

struct MyInt { val: i64 }

impl Eq for MyInt {
    fn eq(self: &MyInt, other: &MyInt) -> bool { return self.val == other.val; }
}

impl MyNum for MyInt {}

fn f<T: MyNum>(x: T, y: T) -> bool {
    return x == y;
}

fn mi(v: i64) -> MyInt { return MyInt { val: v }; }

fn main() -> i32 {
    let x = mi(3i64);
    let y = mi(5i64);
    let z = mi(3i64);
    if f(x, y) { return 1; }
    let x2 = mi(3i64);
    if !f(x2, z) { return 2; }
    return 0;
}
