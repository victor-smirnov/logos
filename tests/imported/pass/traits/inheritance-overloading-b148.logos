// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/traits/inheritance/overloading.rs
// Modifications: isize→i64; #[derive(Clone,Debug)] dropped; PartialEq hand-impl kept (`self:&MyInt`);
//   `f` returning a 3-tuple `(x+y, x-y, x*y)` needed Clone (each operand used thrice) — split into two
//   single-op generic fns (`add_them`/`mul_them`) since Clone-on-value is out of this batch's scope;
//   assert_eq!→distinct nonzero return; negative literal via the Sub result.
// Tests a SUPERTRAIT bound over operator traits — `trait MyNum: Add + Sub + Mul + PartialEq` — and a
//   generic fn `f<T: MyNum>` that dispatches `+`/`*` through the bound on the abstract type `T`.
package inheritance_overloading_b148;

trait MyNum : Add<Output=Self> + Sub<Output=Self> + Mul<Output=Self> + PartialEq { }

struct MyInt { val: i64 }

impl Add for MyInt { type Output = MyInt; fn add(self: MyInt, other: MyInt) -> MyInt { mi(self.val + other.val) } }
impl Sub for MyInt { type Output = MyInt; fn sub(self: MyInt, other: MyInt) -> MyInt { mi(self.val - other.val) } }
impl Mul for MyInt { type Output = MyInt; fn mul(self: MyInt, other: MyInt) -> MyInt { mi(self.val * other.val) } }

impl PartialEq for MyInt {
    fn eq(self: &MyInt, other: &MyInt) -> bool { self.val == other.val }
    fn ne(self: &MyInt, other: &MyInt) -> bool { !self.eq(other) }
}

impl MyNum for MyInt {}

fn mi(v: i64) -> MyInt { MyInt { val: v } }

fn add_them<T: MyNum>(x: T, y: T) -> T { return x + y; }
fn sub_them<T: MyNum>(x: T, y: T) -> T { return x - y; }
fn mul_them<T: MyNum>(x: T, y: T) -> T { return x * y; }

fn main() -> i32 {
    let a = add_them(mi(3i64), mi(5i64));
    if a != mi(8i64) { return 1i32; }
    let b = sub_them(mi(3i64), mi(5i64));
    if b != mi(0i64 - 2i64) { return 2i32; }
    let c = mul_them(mi(3i64), mi(5i64));
    if c != mi(15i64) { return 3i32; }
    return 0i32;
}
