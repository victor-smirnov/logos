package issue_6334;

trait A {
    fn a(self: &Self) -> u64;
}

trait B {
    fn b(self: &Self) -> u64;
}

trait C {
    fn combine<T: A + B>(self: &Self, t: &T) -> u64;
}

struct Foo {}

impl A for Foo {
    fn a(self: &Foo) -> u64 { return 1u64; }
}

impl B for Foo {
    fn b(self: &Foo) -> u64 { return 2u64; }
}

struct Bar {}

impl C for Bar {
    fn combine<T: B + A>(self: &Bar, t: &T) -> u64 {
        return (t.a() * 100u64) + t.b();
    }
}

fn use_c<S: C, T: B + A>(s: &S, t: &T) -> u64 {
    return s.combine(t);
}

fn main() -> i32 {
    let foo = Foo {};
    let bar = Bar {};
    let r = use_c(&bar, &foo);
    if r != 102u64 { return 1; }
    return 0;
}
