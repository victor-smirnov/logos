package trait_default_method_on_primitive_b136;

trait Foo {
    fn a(self: &i64) -> i64;
    fn b(self: &i64) -> i64 {
        return self.a() + 2i64;
    }
}

impl Foo for i64 {
    fn a(self: &i64) -> i64 {
        return 3i64;
    }
}

fn main() -> i32 {
    let x: i64 = 3i64;
    if x.b() != 5i64 { return 1i32; }
    return 0i32;
}
