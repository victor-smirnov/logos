package trait_default_method_bound_b138;

trait Greet {
    fn base(self: &Self) -> i32;
    fn doubled(self: &Self) -> i32 {
        return self.base() * 2i32;
    }
}

struct Thing { v: i32 }

impl Greet for Thing {
    fn base(self: &Self) -> i32 {
        return self.v;
    }
}

fn main() -> i32 {
    let t: Thing = Thing { v: 7i32 };
    if t.base() != 7i32 { return 1i32; }
    if t.doubled() != 14i32 { return 2i32; }
    return 0i32;
}
