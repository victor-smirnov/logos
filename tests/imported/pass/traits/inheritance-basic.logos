// Modifications: isize→i64; literals suffixed; `pub fn main()`→`fn main()->i32`;
// `assert_eq!`→return-code checks; receivers `self: &A`. A trait Quux with three
// supertraits; a generic fn bounded on all four dispatches each method.
package inheritance_basic;

trait Foo { fn f(self: &Self) -> i64; }
trait Bar { fn g(self: &Self) -> i64; }
trait Baz { fn h(self: &Self) -> i64; }

trait Quux: Foo + Bar + Baz { }

struct A { x: i64 }

impl Foo for A { fn f(self: &A) -> i64 { return 10i64; } }
impl Bar for A { fn g(self: &A) -> i64 { return 20i64; } }
impl Baz for A { fn h(self: &A) -> i64 { return 30i64; } }
impl Quux for A {}

fn f<T: Quux + Foo + Bar + Baz>(a: &T) -> i64 {
    if a.f() != 10i64 { return 1i64; }
    if a.g() != 20i64 { return 2i64; }
    if a.h() != 30i64 { return 3i64; }
    return 0i64;
}

fn main() -> i32 {
    let a = A { x: 3i64 };
    if f(&a) != 0i64 { return 1; }
    return 0;
}
