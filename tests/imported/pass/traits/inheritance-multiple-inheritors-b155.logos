package inheritance_multiple_inheritors_b155;

trait A { fn a(&self) -> i64; }
trait B: A { fn b(&self) -> i64; }
trait C: A { fn c(&self) -> i64; }

struct S { bogus: i64 }

impl A for S { fn a(&self) -> i64 { return 10i64; } }
impl B for S { fn b(&self) -> i64 { return 20i64; } }
impl C for S { fn c(&self) -> i64 { return 30i64; } }

fn f<T: B + C>(x: &T) -> i64 {
    return x.a() + x.b() + x.c();
}

fn main() -> i32 {
    let s = S { bogus: 0i64 };
    if f(&s) != 60i64 { return 1i32; }
    return 0i32;
}
