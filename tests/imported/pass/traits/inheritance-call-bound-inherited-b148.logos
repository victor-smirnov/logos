// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/traits/inheritance/call-bound-inherited.rs
// Modifications: isize→i64; `&self`→`self: &A`; assert_eq!→distinct nonzero return.
// Tests calling a SUPERTRAIT method through a subtrait bound: `gg<T: Bar>(a: &T)` calls `a.f()`
//   where `f` comes from `Foo` and `Bar: Foo`.
package inheritance_call_bound_inherited_b148;

trait Foo { fn f(self: &Self) -> i64; }
trait Bar : Foo { fn g(self: &Self) -> i64; }

struct A { x: i64 }

impl Foo for A { fn f(self: &A) -> i64 { 10i64 } }
impl Bar for A { fn g(self: &A) -> i64 { 20i64 } }

fn gg<T: Bar>(a: &T) -> i64 {
    a.f()
}

fn main() -> i32 {
    let a = &A { x: 3i64 };
    if gg(a) != 10i64 { return 1i32; }
    return 0i32;
}
