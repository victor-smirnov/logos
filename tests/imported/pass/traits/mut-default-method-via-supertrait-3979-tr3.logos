// Feature: a subtrait default method takes `&mut self` and mutates state through the
// supertrait's getter/setter (`fn translate(&mut self, d) { let x = self.get(); self.set(x+d); }`).
package mut_default_method_via_supertrait_3979_tr3;

trait Positioned {
    fn set_x(self: &mut Self, v: i64);
    fn get_x(self: &Self) -> i64;
}

trait Movable : Positioned {
    fn translate(self: &mut Self, dx: i64) {
        let x = self.get_x();
        self.set_x(x + dx);
    }
}

struct Point { x: i64, y: i64 }
impl Positioned for Point {
    fn set_x(self: &mut Point, v: i64) { (*self).x = v; }
    fn get_x(self: &Point) -> i64 { return (*self).x; }
}
impl Movable for Point {}

fn main() -> i32 {
    let mut p = Point { x: 1i64, y: 2i64 };
    p.translate(3i64);
    if p.get_x() == 4i64 { return 0i32; }
    return 1i32;
}
