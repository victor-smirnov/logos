// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Distilled from tests/ui/traits/ marker-trait patterns (a method-less marker trait
// used purely as a generic bound to gate a generic fn).
// Feature: a marker trait `Marked` with no methods; a generic fn `tag<T: Marked>` only
// accepts types that implement it; another method trait `Val` supplies the payload.
package marker_trait_bound_tr2;

trait Marked {}
trait Val { fn v(self: &Self) -> i64; }

struct Token { n: i64 }

impl Marked for Token {}
impl Val for Token { fn v(self: &Token) -> i64 { return (*self).n; } }

fn tag<T: Marked + Val>(x: &T) -> i64 { return x.v(); }

fn main() -> i32 {
    let t = Token { n: 7i64 };
    if tag(&t) == 7i64 { return 0i32; }
    return 1i32;
}
