package with_bounds_default;

use logos.lang.clone;

trait Getter<T: Clone> {
    fn do_get(self: &Self) -> T;

    fn do_get2(self: &Self) -> (T, T) {
        let x = self.do_get();
        return (x.clone(), x.clone());
    }
}

impl Getter<i64> for i64 {
    fn do_get(self: &i64) -> i64 { return *self; }
}

fn main() -> i32 {
    let r = 3i64.do_get2();
    if r.0 != 3i64 { return 1; }
    if r.1 != 3i64 { return 2; }
    return 0;
}
