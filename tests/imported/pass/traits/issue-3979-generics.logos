package issue_3979_generics;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

trait Positioned<S> {
    fn SetX(self: &mut Self, val: S);
    fn X(self: &Self) -> S;
}

trait Movable<S>: Positioned<S> {
    fn translate(self: &mut Self, dx: S) {
        let x: S = self.X() + dx;
        self.SetX(x);
    }
}

struct Point { x: isize, y: isize }

impl Positioned<isize> for Point {
    fn SetX(self: &mut Point, val: isize) { self.x = val; }
    fn X(self: &Point) -> isize { return self.x; }
}

impl Movable<isize> for Point {}

fn main() -> i32 {
    let mut p: Point = Point { x: 1isize, y: 2isize };
    p.translate(3isize);
    assert_eq!(p.X(), 4isize);
    return 0;
}
