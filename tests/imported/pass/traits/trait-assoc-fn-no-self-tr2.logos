// Original path: tests/ui/traits/anon-static-method.rs (adapted)
// Feature: a trait declares an ASSOCIATED FUNCTION with no `self` receiver
// (`fn make() -> i64`), called via the type-qualified path `S::make()`.
package trait_assoc_fn_no_self_tr2;

trait Factory { fn make() -> i64; }

struct S {}
impl Factory for S { fn make() -> i64 { return 17i64; } }

fn main() -> i32 {
    if S::make() == 17i64 { return 0i32; }
    return 1i32;
}
