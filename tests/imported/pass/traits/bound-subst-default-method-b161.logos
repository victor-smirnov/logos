// Tests a trait DEFAULT method that is itself METHOD-GENERIC over `U` on a
//   trait generic over `T` (`fn g<U>(&self, x: T, y: U) -> (T, U)`), invoked
//   through a generic dispatcher `f<T,U,V: A<T>>` — the default body returns the
//   tuple `(x, y)`.
package bound_subst_default_method_b161;

trait A<T> {
    fn g<U>(self: &Self, x: T, y: U) -> (T, U) { return (x, y); }
}

impl A<i64> for i64 {}

fn f<T, U, V>(i: V, j: T, k: U) -> (T, U) where V: A<T> {
    return i.g(j, k);
}

fn main() -> i32 {
    let r = f::<i64, i64, i64>(0i64, 1i64, 2i64);
    if r.0 != 1i64 { return 1i32; }
    if r.1 != 2i64 { return 2i32; }

    let r2 = f::<i64, i64, i64>(0i64, 1i64, 2i64);
    if r2.0 != 1i64 { return 3i32; }
    if r2.1 != 2i64 { return 4i32; }
    return 0i32;
}
