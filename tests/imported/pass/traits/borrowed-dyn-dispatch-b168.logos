// B168 G168-A: method dispatch on a BORROWED trait object (`&dyn`/`&Box<dyn>` =
// Ref<TraitObject>), both inline and via a let-bound reference. Mirrors Rust
// dispatching through `&v[i]` / a `&dyn` local. (for-each/iterator dispatch over
// Vec<Box<dyn>> is a separate VecIter-dyn bug — use the while+borrow form here.)
package borrowed_dyn_dispatch_b168;
use logos.mem.boxed;
use logos.mem.collections.vec;
trait Sh { fn area(self: &Self) -> i64; }
struct Sq { s: i64 }
impl Sh for Sq { fn area(self: &Sq) -> i64 { return self.s * self.s; } }
fn main() -> i32 {
    let mut v: Vec<Box<dyn Sh>> = vec_new::<Box<dyn Sh>>();
    v.push(box_new(Sq { s: 2i64 }));
    v.push(box_new(Sq { s: 3i64 }));
    // inline: v.borrow(i).area()
    let mut acc: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < v.length() { acc = acc + v.borrow(i).area(); i = i + 1i64; }
    if acc != 13i64 { return 1i32; }
    // let-bound ref-to-dyn
    let rd: &Box<dyn Sh> = v.borrow(0i64);
    if rd.area() != 4i64 { return 2i32; }
    return 0i32;
}
