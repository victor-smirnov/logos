//   used to combine two values.
// Tests a trait method with its own type parameter bound (`fn pair<U: Into...>`
//   simplified to a same-type combine) dispatched on a struct receiver.
package trait_generic_method_b138;

trait Combine {
    fn combine(self: &Self, other: i32) -> i32;
}

struct Adder { base: i32 }

impl Combine for Adder {
    fn combine(self: &Self, other: i32) -> i32 {
        return self.base + other;
    }
}

fn main() -> i32 {
    let a: Adder = Adder { base: 100i32 };
    if a.combine(23i32) != 123i32 { return 1i32; }
    if a.combine(0 - 100i32) != 0i32 { return 2i32; }
    return 0i32;
}
