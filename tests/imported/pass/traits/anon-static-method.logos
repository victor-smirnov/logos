package anon_static_method;

use std.fmt;
use std.lang.text;

struct Foo { x: isize }

impl Foo {
    pub fn new() -> Foo { return Foo { x: 3isize }; }
}

fn main() -> i32 {
    let x: Foo = Foo::new();
    assert_eq!(x.x, 3isize);
    return 0;
}
