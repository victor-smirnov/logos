package anon_static_method;

struct Foo { x: isize }

impl Foo {
    pub static fn new() -> Foo { return Foo { x: 3isize }; }
}

fn main() -> i32 {
    let x: Foo = Foo::new();
    let _ = x.x;
    return 0;
}
