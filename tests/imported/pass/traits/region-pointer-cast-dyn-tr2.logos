// Feature: explicit cast of a reference to a trait object `(&a) as &dyn Foo`,
// then dynamic method dispatch through the trait-object handle.
// isize->i64; println! dropped; assert via dispatch.
package region_pointer_cast_dyn_tr2;

trait Foo { fn f(self: &Self) -> i64; }

struct A { x: i64 }

impl Foo for A { fn f(self: &A) -> i64 { return (*self).x; } }

fn main() -> i32 {
    let a = A { x: 3i64 };
    let b: &dyn Foo = (&a) as &dyn Foo;
    if b.f() == 3i64 { return 0i32; }
    return 1i32;
}
