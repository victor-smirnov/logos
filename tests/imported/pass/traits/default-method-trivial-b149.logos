// Tests a default method (`purr` returns true) reached transitively: the impl's `meow`
//   calls `self.scratch`, which calls the default `self.purr`, all on a primitive `i64`.
package default_method_trivial;

trait Cat {
    fn meow(self: &Self) -> bool;
    fn scratch(self: &Self) -> bool;
    fn purr(self: &Self) -> bool { return true; }
}

impl Cat for i64 {
    fn meow(self: &Self) -> bool { return self.scratch(); }
    fn scratch(self: &Self) -> bool { return self.purr(); }
}

fn main() -> i64 {
    let x: i64 = 5;
    if x.meow() { return 0; }
    return 1;
}
