package trait_default_sum_area_b163;

trait Shape {
    fn area(self: &Self) -> i64;
    fn double_area(self: &Self) -> i64 { return self.area() * 2i64; }
}

struct Square { side: i64 }
struct Rect { w: i64, h: i64 }

impl Shape for Square {
    fn area(self: &Self) -> i64 { return self.side * self.side; }
}
impl Shape for Rect {
    fn area(self: &Self) -> i64 { return self.w * self.h; }
}

fn main() -> i32 {
    let s: Square = Square { side: 3i64 };
    let r: Rect = Rect { w: 2i64, h: 5i64 };
    if s.area() != 9i64 { return 1i32; }
    if s.double_area() != 18i64 { return 2i32; }
    if r.area() != 10i64 { return 3i32; }
    if r.double_area() != 20i64 { return 4i32; }
    return 0i32;
}
