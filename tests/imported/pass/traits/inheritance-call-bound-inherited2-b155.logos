package inheritance_call_bound_inherited2_b155;

trait Foo { fn f(&self) -> i64; }
trait Bar: Foo { fn g(&self) -> i64; }
trait Baz: Bar { fn h(&self) -> i64; }

struct A { x: i64 }

impl Foo for A { fn f(&self) -> i64 { return 10i64; } }
impl Bar for A { fn g(&self) -> i64 { return 20i64; } }
impl Baz for A { fn h(&self) -> i64 { return 30i64; } }

fn gg<T: Baz>(a: &T) -> i64 {
    return a.f();
}

fn main() -> i32 {
    let a = A { x: 3i64 };
    if gg(&a) != 10i64 { return 1i32; }
    return 0i32;
}
