package indirect_supertrait_chain_15155_b147;

trait Base { fn id(self: &Self) -> i64; }
trait Mid: Base {}
trait Top: Mid {}

struct W { v: i64 }

impl Base for W { fn id(self: &W) -> i64 { return self.v; } }
impl Mid for W {}
impl Top for W {}

fn use_top<T: Top>(t: &T) -> i64 { return t.id(); }

fn main() -> i32 {
    let w = W { v: 7i64 };
    if use_top(&w) != 7i64 { return 1i32; }
    return 0i32;
}
