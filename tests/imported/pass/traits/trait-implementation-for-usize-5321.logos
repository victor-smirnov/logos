// Trait impl on a primitive u64, called via method syntax `2u64.yes()`.
package trait_impl_usize_5321;

trait Fooable {
    fn yes(self: Self) -> u64;
}

impl Fooable for u64 {
    fn yes(self: u64) -> u64 {
        let mut count = 0u64;
        let mut i = 0u64;
        while i < self {
            count = count + 1u64;
            i = i + 1u64;
        }
        return count;
    }
}

fn main() -> i32 {
    if 2u64.yes() != 2u64 { return 1; }
    return 0;
}
