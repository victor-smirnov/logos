package trait_generic_dispatch_convert_b165;

trait ToCelsius { fn to_c(self: &Self) -> i64; }
struct Fahrenheit { d: i64 }
struct Kelvin { d: i64 }
impl ToCelsius for Fahrenheit { fn to_c(self: &Fahrenheit) -> i64 { return (self.d - 32i64) * 5i64 / 9i64; } }
impl ToCelsius for Kelvin { fn to_c(self: &Kelvin) -> i64 { return self.d - 273i64; } }
fn report<T: ToCelsius>(t: &T) -> i64 { return t.to_c(); }
