// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Distilled from tests/ui/traits/ Self-returning trait method patterns.
// Feature: a trait method that returns `Self` by value (`fn bump(self) -> Self`),
// monomorphised per impl; chained twice on a concrete struct.
package trait_method_returns_self_tr2;

trait Bump { fn bump(self: Self) -> Self; }

struct Counter { n: i64 }

impl Bump for Counter {
    fn bump(self: Counter) -> Counter { return Counter { n: self.n + 1i64 }; }
}

fn main() -> i32 {
    let c = Counter { n: 0i64 };
    let c2 = c.bump().bump();
    if c2.n == 2i64 { return 0i32; }
    return 1i32;
}
