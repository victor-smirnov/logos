package region_self_ref_impl_trait_rg;
struct Clam<'a> { chowder: &'a i64 }
trait GetChowder<'a> { fn get_chowder(self: &Self) -> &'a i64; }
impl<'a> GetChowder<'a> for Clam<'a> {
    fn get_chowder(self: &Clam<'a>) -> &'a i64 { return (*self).chowder; }
}
fn main() -> i32 {
    let three: i64 = 3i64;
    let clam: Clam = Clam { chowder: &three };
    if *clam.get_chowder() == 3i64 { return 0i32; }
    return 1i32;
}
