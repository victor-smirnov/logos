// B87: rebinding `w` with new same-scope source — fresh dropck obligation.
package dropck_shadow_rebind;
struct W<'a> { r: &'a i32 }
impl<'a> Drop for W<'a> { fn drop(self: &mut W<'a>) { } }
fn main() -> i32 {
    let v: i32 = 5i32;
    let mut w: W = W { r: &v };
    let v2: i32 = 7i32;
    w = W { r: &v2 };
    return 0i32;
}
