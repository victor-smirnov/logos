// Imported from rust-lang/rust tests/ui/regions/regions-borrow-evec-fixed.rs
// Modifications: isize→i64; `[1,2,3,4,5]` is a `[i64; 5]` array literal;
// `foo(&[i64])` takes a slice and indexes element 0.
package r_regions_borrow_evec_fixed;

fn foo(x: &[i64]) -> i64 {
    return x[0];
}

fn main() -> i32 {
    let arr: [i64; 5] = [1i64, 2i64, 3i64, 4i64, 5i64];
    if foo(&arr) != 1i64 { return 1; }
    return 0;
}
