// The two differ in exactly one token: `= baz` there, `= foo` here. Annotating a
// `let` with a fn-pointer type and supplying a fn item whose region structure DOES
// satisfy it must keep compiling — this is the let-init half of the guard against
// the 2026-09-08 FnItem->FnPtr variance fix over-refusing.
// It RUNS: the bound pointer is CALLED, so a fix that admitted the coercion but
// lowered the wrong callee would show as a wrong exit code.
// Original path: tests/ui/regions/regions-fn-subtyping-return-static-fail.rs
// upstream commit: 4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// upstream construct: line 47 — `want_G(foo);` (the supply upstream accepts),
//   moved to the importer's `let`-binding door, as in the fail half.
// Modifications:
//   · unit struct `struct S;` -> `struct S { n: i64 }`
//   · the `type G` alias -> the fn-pointer type written inline
//   · `panic!()` bodies -> real returns
//   · ⚠ THE COERCION SITE IS MOVED (the importer's split — see the fail half)
//   · assert -> exit code: the bound fn pointer is called and guards the return
package regions_fn_subtyping_return_static_fail_c30_let_binding_fnptr_ok;
struct S { n: i64 }
static GS: S = S { n: 30i64 };
fn foo<'a>(x: &'a S) -> &'static S { return &GS; }   // meets both
fn baz<'a>(x: &'a S) -> &'a S { return x; }          // meets F, but not G
fn supply_G() -> i64 {
  let ok: fn(&S) -> &'static S = foo;
  let g: fn(&S) -> &'static S = foo;    // THE TOKEN: `foo`, not `baz`
  let r: &S = g(&GS);
  let s: &S = ok(&GS);
  return r.n + s.n;
}
fn main() -> i32 { return supply_G() as i32 - 60i32; }
