// Tests returning a reference to a struct field `&p.x` from a fn `(p: &Point) ->
//   &i64` and dereferencing it at the call site.
package regions_infer_borrow_scope_b159;

struct Point { x: i64, y: i64 }

fn x_coord(p: &Point) -> &i64 {
    return &p.x;
}

fn main() -> i32 {
    let p = Point { x: 3i64, y: 4i64 };
    let xc = x_coord(&p);
    if *xc != 3i64 { return 1i32; }
    return 0i32;
}
