// B88 GAP (GAT lifetime propagation): `T::Item<'a>` at return position
// where the method body resolves it via `t: &'b T` (yielding Item<'b>)
// should be rejected when 'a is unrelated to 'b. Logos currently accepts
// because GAT lifetime substitution isn't propagated through assoc-type
// resolution — `T::Item<'a>` at type position resolves without inspecting
// the impl's GAT lt-param wiring.
//
// Fix needs trait-resolution surgery to substitute GAT lt-args during
// assoc-type lookups + a follow-up validation at use sites.
package gat_lt_propagation_gap;

trait It {
    type Item<'a>;
    fn get<'a>(self: &'a Self) -> Self::Item<'a>;
}

struct W { v: i32 }
impl It for W {
    type Item<'a> = &'a i32;
    fn get<'a>(self: &'a W) -> &'a i32 { return &(*self).v; }
}

fn bad<'a, 'b, T: It>(t: &'b T) -> T::Item<'a> { return t.get(); }

fn main() -> i32 { return 0i32; }
