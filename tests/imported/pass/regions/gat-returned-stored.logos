// GAT result stored in let-binding.
package gat_returned_stored;
trait It { type Item<'a>; fn get<'a>(self: &'a Self) -> Self::Item<'a>; }
struct W { v: i32 }
impl It for W {
    type Item<'a> = &'a i32;
    fn get<'a>(self: &'a W) -> &'a i32 { return &(*self).v; }
}
fn main() -> i32 {
    let w: W = W { v: 17i32 };
    let r: &i32 = w.get();
    let v: i32 = *r;
    return v - 17i32;
}
