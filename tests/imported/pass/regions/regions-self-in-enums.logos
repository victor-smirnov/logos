package r_regions_self_in_enums;

enum int_wrapper<'a> {
    int_wrapper_ctor(&'a i64),
}

fn main() -> i32 {
    let x: i64 = 3i64;
    let y = int_wrapper::int_wrapper_ctor(&x);
    let mut z: &i64 = &x;
    match y {
        int_wrapper::int_wrapper_ctor(zz) => { z = zz; }
    }
    if *z != 3i64 { return 1; }
    return 0;
}
