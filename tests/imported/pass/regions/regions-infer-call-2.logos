package regions_infer_call_2;

use logos.lang.ops;

fn takes_two(x: &i64, y: &i64) -> i64 { return *x + *y; }

fn with<T, F: FnOnce(&i64) -> T>(f: F) -> T {
    let twenty = 20i64;
    return f(&twenty);
}

fn has_one<'a>(x: &'a i64) -> i64 {
    return with(|y: &i64| -> i64 { return takes_two(x, y); });
}

fn main() -> i32 {
    let two = 2i64;
    if has_one(&two) != 22i64 { return 1; }
    return 0;
}
