package regions_self_in_enums_b159;

enum IntWrapper { Ctor(&i64) }

fn main() -> i32 {
    let x = 3i64;
    let y = IntWrapper::Ctor(&x);
    let mut z: &i64;
    match y {
        IntWrapper::Ctor(zz) => { z = zz; }
    }
    if *z != 3i64 { return 1i32; }
    return 0i32;
}
