// B78: struct's `where 'a: 'b` satisfied by matching `where` on caller.
package where_bound_explicit_on_caller;

struct Pair<'a, 'b> where 'a: 'b { x: &'a i32, y: &'b i32 }

fn build<'a, 'b>(x: &'a i32, y: &'b i32) -> Pair<'a, 'b>
    where 'a: 'b
{ return Pair { x: x, y: y }; }

fn main() -> i32 {
    let a: i32 = 1i32; let b: i32 = 2i32;
    let _p: Pair = build(&a, &b);
    return 0i32;
}
