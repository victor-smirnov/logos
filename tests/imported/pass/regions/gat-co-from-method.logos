package gat_co_from_method;
trait It { type Item<'a>; fn get<'a>(self: &'a Self) -> Self::Item<'a>; }
struct W { v: i32 }
impl It for W {
    type Item<'a> = &'a i32;
    fn get<'a>(self: &'a W) -> &'a i32 { return &(*self).v; }
}
fn use_<'a, T: It>(t: &'a T) -> T::Item<'a> { return t.get(); }
fn main() -> i32 {
    let w: W = W { v: 13i32 };
    return *use_::<W>(&w) - 13i32;
}
