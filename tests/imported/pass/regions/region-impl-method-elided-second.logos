// Impl method with elided lt — works through chains.
package region_impl_method_elided_second;
struct Inner { v: i32 }
struct Outer { i: Inner }
impl Outer { fn inner(self: &Outer) -> &Inner { return &self.i; } }
impl Inner { fn val(self: &Inner) -> &i32 { return &self.v; } }
fn main() -> i32 {
    let o: Outer = Outer { i: Inner { v: 6i32 } };
    return *o.inner().val() - 6i32;
}
