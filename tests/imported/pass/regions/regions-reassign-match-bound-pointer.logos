package r_regions_reassign_match_bound_pointer;

fn foo(x: &isize) {
    let a: isize = 1isize;
    match x {
        mut z => {
            z = &a;
            let _ = z;
        }
    }
}

fn main() -> i32 {
    let v: isize = 1isize;
    foo(&v);
    return 0;
}
