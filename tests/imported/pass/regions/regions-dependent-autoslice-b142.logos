package regions_dependent_autoslice_b142;

fn subslice1<'r>(v: &'r [u64]) -> &'r [u64] { return v; }

fn both<'r>(v: &'r [u64]) -> &'r [u64] {
    return subslice1(subslice1(v));
}

fn main() -> i32 {
    let v: [u64; 3] = [1u64, 2u64, 3u64];
    let s: &[u64] = both(&v);
    if s[0] != 1u64 { return 1i32; }
    return 0i32;
}
