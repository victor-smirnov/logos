package regions_early_bound_used_in_bound_method_b156;

trait GetRef { fn get(self: &Self) -> &i64; }

struct Bx { t: *const i64 }

impl GetRef for Bx {
    fn get(self: &Self) -> &i64 { return unsafe { &*self.t }; }
}

impl Bx {
    fn add<G: GetRef>(self: &Self, g2: G) -> i64 {
        return unsafe { *self.t } + *g2.get();
    }
}

fn main() -> i32 {
    let three: i64 = 3i64;
    let b1: Bx = Bx { t: &three as *const i64 };
    let b2: Bx = Bx { t: &three as *const i64 };
    if b1.add::<Bx>(b2) != 6i64 { return 1i32; }
    return 0i32;
}
