// Imported from rust-lang/rust tests/ui/regions/regions-infer-borrow-scope-view.rs
// Modifications: `vec![]` replaced with `[i64; 3]` array; generic `view<T>`
// kept (T-slice round-trip).
package r_regions_infer_borrow_scope_view;

fn view(x: &[i64]) -> &[i64] { return x; }

fn main() -> i32 {
    let arr: [i64; 3] = [1i64, 2i64, 3i64];
    let x = view(&arr);
    let y = view(x);
    if y[0] != arr[0] { return 1; }
    return 0;
}
