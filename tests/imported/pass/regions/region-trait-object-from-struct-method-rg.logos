// Feature: a fn produces a trait object whose lifetime is tied to an input ref
// (`extension<'e>(&'e E<'e>) -> &dyn M`), where the object wraps a struct built
// from a borrowed-method result. Box<dyn>->&dyn per port rule.
package region_trait_object_from_struct_method_rg;
struct E<'a> { f: &'a u8 }
impl<'a> E<'a> { fn m(self: &E<'a>) -> &'a u8 { return (*self).f; } }
struct P<'c> { g: &'c u8 }
trait M { fn n(self: &Self) -> u8; }
impl<'d> M for P<'d> { fn n(self: &P<'d>) -> u8 { return *(*self).g; } }
fn main() -> i32 {
