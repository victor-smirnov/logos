// Modifications: `vec![]` → `[i64; N]`; same slice-from-array shape.
package r_regions_borrow_evec_uniq;

fn foo(x: &[i64]) -> i64 { return x[0]; }

fn main() -> i32 {
    let p: [i64; 5] = [1i64, 2i64, 3i64, 4i64, 5i64];
    if foo(&p) != 1i64 { return 1; }
    let q: [i64; 5] = [5i64, 4i64, 3i64, 2i64, 1i64];
    if foo(&q) != 5i64 { return 1; }
    return 0;
}
