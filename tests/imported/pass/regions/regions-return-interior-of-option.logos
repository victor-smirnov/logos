package r_regions_return_interior_of_option;

use std.lang.option;

fn get(opt: Option<i64>) -> i64 {
    match opt {
        Option::Some(v) => { return v; }
        Option::None => { return 0i64; }
    }
}

fn main() -> i32 {
    let x: Option<i64> = Option::Some(23i64);
    if get(x) != 23i64 { return 1; }
    return 0;
}
