// Imported from rust-lang/rust tests/ui/regions/regions-link-fn-args.rs
// Modifications: closure usage replaced with direct fn-style identity
// (Logos's closure-capture surface doesn't accept `|&ref ints| ints`);
// preserves the regions-link-fn-args invariant: input &'a T flows to output.
package r_regions_link_fn_args;

fn identity<'a>(v: &'a i64) -> &'a i64 { return v; }

fn main() -> i32 {
    let x: i64 = 1i64;
    let r = identity(&x);
    if *r != 1i64 { return 1; }
    return 0;
}
