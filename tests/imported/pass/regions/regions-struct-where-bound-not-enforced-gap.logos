// B76 GAP: a `where 'a: 'b` clause on a struct declaration is currently
// NOT propagated to construction/use sites — caller can build the struct
// with arbitrary lifetimes. Rust rejects this. Pinned here so the future
// fix moves the file to fail/.
package regions_struct_where_bound_gap;

struct Pair<'a, 'b> where 'a: 'b { x: &'a i32, y: &'b i32 }

fn build<'a, 'b>(x: &'a i32, y: &'b i32) -> Pair<'a, 'b> {
    return Pair { x: x, y: y };
}

fn main() -> i32 { return 0i32; }
