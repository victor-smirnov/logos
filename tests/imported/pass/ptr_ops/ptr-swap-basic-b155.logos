// Tests: mem::swap_ref exchanges the values of two mutable locals.
package ptr_swap_basic_b155;

use logos.lang.mem;

fn main() -> i32 {
    let mut x: i64 = 3i64;
    let mut y: i64 = 7i64;
    swap_ref::<i64>(&mut x, &mut y);
    if x != 7i64 { return 1i32; }
    if y != 3i64 { return 2i32; }
    return 0i32;
}
