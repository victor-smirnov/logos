package nested_loop_break_unit_flw4;

fn f() {
    let _x: () = loop { loop { break; } };
}

fn main() -> i32 {
    // f() is intentionally NOT called (the outer loop is infinite by design,
    // matching upstream where main() has an empty body). This test exercises
    // that `loop { loop { break; } }` type-checks + lowers as a bound value.
    return 0i32;
}
