// Tests a FnMut driver passing a tuple to a closure that destructures it and
//   mutates two by-ref-captured outer counters across iterations.
package foreach_put_structured_b160;

fn pairs<F: FnMut((i64, i64))>(mut it: F) {
    let mut i: i64 = 0i64;
    let mut j: i64 = 0i64;
    while i < 10i64 {
        it((i, j));
        i = i + 1i64;
        j = j + i;
    }
}

fn main() -> i32 {
    let mut i: i64 = 10i64;
    let mut j: i64 = 0i64;
    pairs(|p: (i64, i64)| {
        let (a, b) = p;
        if a + 10i64 != i { i = -1i64; }
        else { i = i + 1i64; }
        j = b;
    });
    if i < 0i64 { return 1i32; }
    if j != 45i64 { return 2i32; }
    return 0i32;
}
