package fl_foreach_simple_outer_slot;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn first_ten<F: FnMut(i64) -> i32>(it: F) {
    let mut local = it;
    let mut i: i64 = 0i64;
    while i < 10i64 {
        local(i);
        i = i + 1i64;
    }
}

fn main() -> i32 {
    let mut sum: i64 = 0i64;
    first_ten(|i: i64| -> i32 { sum = sum + i; return 0i32; });
    if sum != 45i64 { return 1i32; }
    return 0i32;
}
