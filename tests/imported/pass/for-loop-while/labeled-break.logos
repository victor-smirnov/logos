package fl_labeled_break;

fn main() -> i32 {
    'foo: loop {
        loop {
            break 'foo;
        }
    }

    'foobar: while 1i32 + 1i32 == 2i32 {
        loop {
            break 'foobar;
        }
    }
    return 0i32;
}
