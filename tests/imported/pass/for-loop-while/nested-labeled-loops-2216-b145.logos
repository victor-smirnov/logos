package nested_labeled_loops_2216_b145;

fn main() -> i32 {
    let mut x: i64 = 0i64;

    'foo: loop {
        'bar: loop {
            loop {
                if 1i64 == 2i64 {
                    break 'foo;
                } else {
                    break 'bar;
                }
            }
            continue 'foo;
        }
        x = 42i64;
        break;
    }

    if x != 42i64 { return 1i32; }
    return 0i32;
}
