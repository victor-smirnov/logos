// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/for-loop-while/for-destruct.rs
// Modifications: the iterated tuples come from a `Vec<(i64,i64)>`; the loop
// body destructures each element `let (a, b) = *pair` and accumulates;
// `assert_eq!`->return. Exercises destructuring a tuple element inside a
// for-over-&Vec body.
package fl_for_destruct_range_it;

fn main() -> i32 {
    let mut v: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    v.push((1i64, 2i64));
    v.push((3i64, 4i64));
    let mut s: i64 = 0i64;
    for pair in &v {
        let (a, b) = *pair;
        s = s + a + b;
    }
    if s != 10i64 { return 1i32; }
    return 0i32;
}
