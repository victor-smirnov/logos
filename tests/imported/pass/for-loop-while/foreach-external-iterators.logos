package fl_foreach_external_iterators;

use std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use std.collections.vec;

fn main() -> i32 {
    let x: [i64; 100] = [1i64; 100];
    let mut y: i64 = 0i64;
    for i in &x {
        y = y + *i;
    }
    if y != 100i64 { return 1i32; }
    return 0i32;
}
