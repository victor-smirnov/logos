package loop_break_value_b161;

fn main() -> i32 {
    let value = 'outer: loop {
        if 1i64 == 1i64 {
            break 'outer 13i64;
        }
        break 'outer 99i64;
    };
    if value != 13i64 { return 1i32; }

    let plain = loop { break 7i64; };
    if plain != 7i64 { return 2i32; }

    let nested = 'top: loop {
        let inner = loop { break 5i64; };
        break 'top inner + 1i64;
    };
    if nested != 6i64 { return 3i32; }
    return 0i32;
}
