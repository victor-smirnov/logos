package fl_for_loop_into_iterator;

fn main() -> i32 {
    let mut v: Vec<i64> = vec_new::<i64>();
    v.push(1i64);

    for x in &v {
        if *x != 1i64 { return 1i32; }
    }

    let mut w: Vec<i64> = vec_new::<i64>();
    w.push(1i64);
    for x in w {
        if x != 1i64 { return 2i32; }
    }
    return 0i32;
}
