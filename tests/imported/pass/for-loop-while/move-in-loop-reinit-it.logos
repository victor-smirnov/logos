// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/for-loop-while/liveness-move-in-loop.rs
// Modifications: the `Drop` struct + `my_panic` divergence dropped; the test
// point — a value `let`-bound inside the loop, moved into a call, then a fresh
// value bound on the next iteration — is kept. `assert_eq!`->return.
package fl_move_in_loop_reinit_it;

struct S { v: i64 }

fn take(s: S) -> i64 { return s.v; }

fn main() -> i32 {
    let mut total: i64 = 0i64;
    let mut i: i64 = 0i64;
    loop {
        if i >= 3i64 { break; }
        let g: S = S { v: i };
        total = total + take(g);
        i = i + 1i64;
    }
    if total != 3i64 { return 1i32; }
    return 0i32;
}
