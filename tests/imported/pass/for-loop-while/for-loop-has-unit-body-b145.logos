// Tests that a for-loop body whose tail statement is `()` (unit) type-checks
//   and runs over a range.
package for_loop_has_unit_body_b145;

fn main() -> i32 {
    let mut count: i64 = 0i64;
    for _ in 0i64..3i64 {
        count = count + 1i64;
        ()
    }
    if count != 3i64 { return 1i32; }
    return 0i32;
}
