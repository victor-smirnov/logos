// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/for-loop-while/labeled-break.rs
// Modifications: the range `for` arm rewritten as a nested range loop pair
// that `break`s the outer label from the inner loop; the value-carrying
// labeled breaks (a known gap) are not used. Tests `break 'label` (no value)
// crossing from an inner loop to an outer labeled loop.
package fl_labeled_break_inner_it;

fn main() -> i32 {
    let mut count: i64 = 0i64;
    'outer: for i in 0i64..5i64 {
        for j in 0i64..5i64 {
            count = count + 1i64;
            if i == 2i64 { break 'outer; }
        }
    }
    // i=0: 5 iters, i=1: 5 iters, i=2: 1 iter then break => 11
    if count != 11i64 { return 1i32; }
    return 0i32;
}
