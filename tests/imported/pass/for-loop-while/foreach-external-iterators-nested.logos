package fl_foreach_external_iterators_nested;

use std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.mem.collections.vec;

fn main() -> i32 {
    let x: [i64; 100] = [1i64; 100];
    let y: [i64; 100] = [2i64; 100];
    let mut p: i64 = 0i64;
    let mut q: i64 = 0i64;
    for i in &x {
        for j in &y {
            p = p + *j;
        }
        q = q + *i + p;
    }
    if q != 1010100i64 { return 1i32; }
    return 0i32;
}
