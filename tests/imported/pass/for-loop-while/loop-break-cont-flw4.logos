package loop_break_cont_flw4;

fn main() -> i32 {
    let mut i = 0u64;
    loop {
        i += 1u64;
        if i == 10u64 {
            break;
        }
    }
    if i != 10u64 { return 1i32; }

    let mut is_even = false;
    loop {
        if i == 21u64 {
            break;
        }
        is_even = false;
        i += 1u64;
        if i % 2u64 != 0u64 {
            continue;
        }
        is_even = true;
    }
    if is_even { return 2i32; }

    loop {
        if i == 22u64 {
            break;
        }
        is_even = false;
        i += 1u64;
        if i % 2u64 != 0u64 {
            continue;
        }
        is_even = true;
    }
    if !is_even { return 3i32; }
    return 0i32;
}
