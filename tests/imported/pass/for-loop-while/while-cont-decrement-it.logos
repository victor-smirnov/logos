// `while` loop with an explicit `continue` at the tail of the body.
package fl_while_cont_decrement_it;

fn main() -> i32 {
    let mut i: i64 = 5i64;
    let mut count: i64 = 0i64;
    while i > 0i64 {
        if i <= 0i64 { return 1i32; }
        count = count + 1i64;
        i = i - 1i64;
        continue;
    }
    if count != 5i64 { return 2i32; }
    return 0i32;
}
