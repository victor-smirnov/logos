package break_b148;

fn main() -> i32 {
    let mut i = 0i64;
    while i < 20i64 { i += 1i64; if i == 10i64 { break; } }
    if i != 10i64 { return 1i32; }

    loop { i += 1i64; if i == 20i64 { break; } }
    if i != 20i64 { return 2i32; }

    let xs = [1i64, 2i64, 3i64, 4i64, 5i64, 6i64];
