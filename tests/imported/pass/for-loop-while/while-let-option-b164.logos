// Tests `while let Some(x) = next()` driving a loop until None, accumulating.
package while_let_option_b164;

fn step(n: i64) -> Option<i64> {
    if n <= 0i64 { return Option::None; }
    return Option::Some(n);
}

fn main() -> i32 {
    let mut counter: i64 = 5i64;
    let mut sum: i64 = 0i64;
    while let Option::Some(x) = step(counter) {
        sum = sum + x;
        counter = counter - 1i64;
    }
    if sum != 15i64 { return 1i32; }   // 5+4+3+2+1
    if counter != 0i64 { return 2i32; }
    return 0i32;
}
