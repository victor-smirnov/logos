// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/for-loop-while/break.rs
// Modifications: the `for x in &xs { if *x == 3 { break } … }` and
// `vec![…]` branches are dropped — `*x` over a Vec/array iterator
// is the B3-bg-07 iter-yields-T-not-&T design question (separate
// gap), and `vec!` macro isn't wired (separate). Pure `while`/`loop`
// + `break`/`continue` regression preserved verbatim with i32
// typing.
package for_break;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    let mut i: i32 = 0i32;
    while i < 20i32 {
        i = i + 1i32;
        if i == 10i32 { break; }
    }
    assert_eq!(i, 10i32);

    loop {
        i = i + 1i32;
        if i == 20i32 { break; }
    }
    assert_eq!(i, 20i32);

    i = 0i32;
    while i < 10i32 {
        i = i + 1i32;
        if i % 2i32 == 0i32 { continue; }
        assert!(i % 2i32 != 0i32);
    }

    i = 0i32;
    loop {
        i = i + 1i32;
        if i % 2i32 == 0i32 { continue; }
        assert!(i % 2i32 != 0i32);
        if i >= 10i32 { break; }
    }

    return 0;
}
