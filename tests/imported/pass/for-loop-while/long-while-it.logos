// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/for-loop-while/long-while.rs
// Modifications: `isize`->i64; loop bound lowered (10000->1000) to keep the
// test fast; tail `println!` dropped. Exercises a long-running `while` with a
// nested `while` doing accumulation.
package fl_long_while_it;

fn main() -> i32 {
    let mut i: i64 = 0i64;
    while i < 1000i64 {
        i = i + 1i64;
        let mut j: i64 = 0i64;
        while j < i { j = j + 1i64; }
        if j != i { return 1i32; }
    }
    if i != 1000i64 { return 2i32; }
    return 0i32;
}
