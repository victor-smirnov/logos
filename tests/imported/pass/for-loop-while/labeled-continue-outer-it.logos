// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/for-loop-while/label_break_value.rs
// Modifications: distilled to a `continue 'outer` from an inner loop —
// nested range loops where the inner loop, on a condition, continues the
// outer label (skipping the rest of the outer body). `assert_eq!`->return.
package fl_labeled_continue_outer_it;

fn main() -> i32 {
    let mut hits: i64 = 0i64;
    'outer: for i in 0i64..3i64 {
        for j in 0i64..3i64 {
            if j == 1i64 { continue 'outer; }
        }
        hits = hits + i;
    }
    if hits != 0i64 { return 1i32; }
    return 0i32;
}
