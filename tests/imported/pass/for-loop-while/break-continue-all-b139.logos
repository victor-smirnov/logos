// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/for-loop-while/break.rs
// Modifications: assert!/assert_eq! -> nonzero ret; `+=` -> explicit add;
//   the `Vec<isize>` for-loop half rewritten to a fixed array `&[i64;N]` (Vec
//   needs an import; the break/continue control-flow is the point); `for x in
//   &xs` deref `*x`.
// Tests `break` from while/loop/for and `continue` (odd-only) in while/loop.
package break_continue_all_b139;

fn main() -> i32 {
    let mut i: i64 = 0i64;
    while i < 20i64 { i = i + 1i64; if i == 10i64 { break; } }
    if i != 10i64 { return 1i32; }

    loop { i = i + 1i64; if i == 20i64 { break; } }
    if i != 20i64 { return 2i32; }

    let xs: [i64; 6] = [1i64, 2i64, 3i64, 4i64, 5i64, 6i64];
    for x in &xs {
        if *x == 3i64 { break; }
        if *x > 3i64 { return 3i32; }
    }

    i = 0i64;
    while i < 10i64 {
        i = i + 1i64;
        if i % 2i64 == 0i64 { continue; }
        if i % 2i64 == 0i64 { return 4i32; }
    }

    i = 0i64;
    loop {
        i = i + 1i64;
        if i % 2i64 == 0i64 { continue; }
        if i % 2i64 == 0i64 { return 5i32; }
        if i >= 10i64 { break; }
    }

    let ys: [i64; 6] = [1i64, 2i64, 3i64, 4i64, 5i64, 6i64];
    for x in &ys {
        if *x % 2i64 == 0i64 { continue; }
        if *x % 2i64 == 0i64 { return 6i32; }
    }
    return 0i32;
}
