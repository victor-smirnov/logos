// Tests `while let Some(n) = …` draining an Option-based countdown, accumulating.
package while_let_countdown_b165;

fn main() -> i32 {
    let mut cur: Option<i64> = Option::Some(3i64);
    let mut sum: i64 = 0i64;
    while let Option::Some(n) = cur {
        sum = sum + n;
        if n <= 1i64 { cur = Option::None; } else { cur = Option::Some(n - 1i64); }
    }
    if sum != 6i64 { return 1i32; }
    return 0i32;
}
