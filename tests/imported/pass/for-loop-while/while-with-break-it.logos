// Modifications: `isize`->i64; `println!` dropped; the value carried out of
// the loop is checked via if-return. Exercises an early `break` out of a
// `while` body that leaves a mutated local in a known state.
package fl_while_with_break_it;

fn main() -> i32 {
    let mut i: i64 = 90i64;
    while i < 100i64 {
        i = i + 1i64;
        if i == 95i64 {
            let x: i64 = 10i64;
            i = i + x;
            break;
        }
    }
    if i != 105i64 { return 1i32; }
    return 0i32;
}
