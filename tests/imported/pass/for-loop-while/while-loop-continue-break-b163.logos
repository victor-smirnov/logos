// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/for-loop-while/ shapes (distilled).
// Modifications: isize->i64; assert->if-return sentinels. A `while` loop using
//   `continue` to skip odd values and `break` to stop early, accumulating a sum.
// Tests `continue` (skip) and `break` (early exit) control flow inside a `while`
//   loop over a counter.
package while_loop_continue_break_b163;

fn main() -> i32 {
    let mut i: i64 = 0i64;
    let mut sum: i64 = 0i64;
    while i < 100i64 {
        i = i + 1i64;
        if i % 2i64 == 1i64 { continue; }
        if i > 10i64 { break; }
        sum = sum + i;
    }
    // even numbers 2,4,6,8,10 -> 30
    if sum != 30i64 { return 1i32; }
    return 0i32;
}
