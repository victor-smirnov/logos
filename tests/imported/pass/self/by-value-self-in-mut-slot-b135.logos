// Original path: tests/ui/self/by-value-self-in-mut-slot.rs
// Modifications: isize→i64; `mut self` → `mut self: X`; assert_eq! → return-code check.
// Tests a `mut self`-receiver trait method that mutates a field of the (moved) receiver
// and returns it, dispatched through a `Changer` trait impl.
package by_value_self_in_mut_slot_b135;

struct X { a: i64 }

trait Changer {
    fn change(self: X) -> X;
}

impl Changer for X {
    fn change(mut self: X) -> X {
        self.a = 55i64;
        return self;
    }
}

fn main() -> i32 {
    let x = X { a: 32i64 };
    let new_x = x.change();
    if new_x.a != 55i64 { return 1i32; }
    return 0i32;
}
