// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/self/ufcs-explicit-self.rs
// Modifications: `isize`→`i64`; `#[derive(Copy, Clone)]` dropped; the `baz`
// methods (`self: Box<Foo>` / `self: Box<...>`) dropped (no Box receiver); the
// `Box`-wrapped values → plain stack values; because a by-value `self: Foo`
// method consumes the value, each receiver is built fresh per call; 1-char type
// `T`→`X`; `println!` → return-code checks; `pub fn main()`→`fn main()->i32`.
// Exercises explicit-self receiver shapes `self: Foo` (by value) and `self:
// &Foo` (by ref), on a concrete and a generic struct.
package self_ufcs_explicit_self;

struct Foo { f: i64 }

impl Foo {
    fn foo(self: Foo, x: i64) -> i64 { return self.f + x; }
    fn bar(self: &Foo, x: i64) -> i64 { return self.f + x; }
}

struct Bar<X> { f: X }

impl<X> Bar<X> {
    fn foo(self: Bar<X>, x: i64) -> i64 { return x; }
    fn bar(self: &Bar<X>, x: i64) -> i64 { return x; }
}

fn main() -> i32 {
    let foo = Foo { f: 1i64 };
    if foo.bar(2i64) != 3i64 { return 1; }
    let foo2 = Foo { f: 1i64 };
    if foo2.foo(2i64) != 3i64 { return 2; }

    let bar = Bar { f: 1i64 };
    if bar.bar(2i64) != 2i64 { return 3; }
    let bar2: Bar<i64> = Bar { f: 1i64 };
    if bar2.foo(2i64) != 2i64 { return 4; }
    return 0;
}
