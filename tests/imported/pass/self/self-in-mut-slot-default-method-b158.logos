// Tests a trait *default method* taking `mut self: Self` by value that mutates
//   self through another (required) `&mut self` method, then returns self.
package self_in_mut_slot_default_method_b158;

struct X { a: i64 }

trait Changer {
    fn change(mut self: Self) -> Self {
        self.set_to(55i64);
        return self;
    }
    fn set_to(self: &mut Self, a: i64);
}

impl Changer for X {
    fn set_to(self: &mut Self, a: i64) { self.a = a; }
}

fn main() -> i32 {
    let x = X { a: 32i64 };
    let new_x = x.change();
    if new_x.a != 55i64 { return 1i32; }
    return 0i32;
}
