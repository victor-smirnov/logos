package self_objects_owned_object_owned_method;

trait FooTrait { fn foo(&self) -> u64; }

struct BarStruct { x: u64 }

impl FooTrait for BarStruct {
    fn foo(&self) -> u64 { return self.x; }
}

fn call_it(f: &dyn FooTrait) -> u64 { return f.foo(); }

fn main() -> i32 {
    let b = BarStruct { x: 22u64 };
    if call_it(&b) != 22u64 { return 1; }
    return 0;
}
