package self_explicit_self_generic;

struct LM { resize_at: u64, size: u64 }
enum HashMap<K, V> { HashMapV(LM, K, V) }

impl<K, V> HashMap<K, V> {
    fn len(&mut self) -> u64 {
        match *self {
            HashMap::HashMapV(ref l, _, _) => { return l.size; }
        }
    }
}

fn main() -> i32 {
    let mut m: HashMap<i64, i64> = HashMap::HashMapV(LM { resize_at: 32u64, size: 0u64 }, 0i64, 0i64);
    if m.len() != 0u64 { return 1; }
    return 0;
}
