package self_move_self;

struct S { x: i64 }

impl S {
    fn foo(self: S) -> i64 { return self.bar(); }
    fn bar(self: S) -> i64 { return self.x; }
}

fn main() -> i32 {
    let x = S { x: 42i64 };
    if x.foo() != 42i64 { return 1; }
    return 0;
}
