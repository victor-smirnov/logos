package dyn_compatibility_sized_self_return_self_b158;

trait Counter {
    fn make() -> Self where Self: Sized;
    fn tick(self: &mut Self) -> i64;
}

struct CCounter { c: i64 }

impl Counter for CCounter {
    fn make() -> CCounter { return CCounter { c: 0i64 }; }
    fn tick(self: &mut Self) -> i64 { self.c = self.c + 1i64; return self.c; }
}

fn preticked<C: Counter>() -> C {
    let mut c: C = Counter::make();
    tick(&mut c);
    return c;
}

fn tick(c: &mut dyn Counter) { tick_generic(c); }

fn tick_generic<C: ?Sized + Counter>(c: &mut C) {
    c.tick();
    c.tick();
}

fn main() -> i32 {
    let mut c: CCounter = preticked::<CCounter>();
    tick(&mut c);
    if c.tick() != 5i64 { return 1i32; }
    return 0i32;
}
