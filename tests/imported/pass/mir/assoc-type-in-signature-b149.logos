package assoc_type_in_signature;

trait Trait { type Type; }

impl Trait for u8 { type Type = u32; }

fn foo(t: <u8 as Trait>::Type) -> <u8 as Trait>::Type { return t; }

fn main() -> i64 {
    let r: u32 = foo(4u32);
    return (r as i64) - 4;
}
