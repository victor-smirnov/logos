// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/mir/mir_match_arm_guard.rs
// Modifications: tail-expr arms→`return` arms; negatives `0 - n`; assert→ret-guards.
// Tests a match arm with a guard `Some(xyz) if xyz > 100` falling through to a later Some(_) arm.
package mir_match_arm_guard_b143;

fn match_with_guard(x: Option<i8>) -> i8 {
    match x {
        Option::Some(xyz) if xyz > 100i8 => { return 0i8; }
        Option::Some(_) => { return 0i8 - 1i8; }
        Option::None => { return 0i8 - 2i8; }
    }
}

fn main() -> i32 {
    if match_with_guard(Option::Some(111i8)) != 0i8 { return 1i32; }
    if match_with_guard(Option::Some(2i8)) != 0i8 - 1i8 { return 2i32; }
    if match_with_guard(Option::None) != 0i8 - 2i8 { return 3i32; }
    return 0i32;
}
