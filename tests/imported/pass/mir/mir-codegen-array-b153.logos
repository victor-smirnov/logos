// Imported from rust-lang/rust tests/ui/mir/mir_codegen_array.rs
// Modifications: array size shrunk 1024 → 8 (the repeat-init codegen is the
// point, not the size); u64; the `&[..]` slice compare replaced by per-element
// checks (no slice-Eq via logos.std.fmt). Tests `[expr; N]` array repeat
// initialization where the element is computed from a local.
package mir_codegen_array_test;

fn into_inner() -> [u64; 8] {
    let x = 10u64 + 20u64;
    [x; 8]
}

fn main() -> i32 {
    let a = into_inner();
    let mut i: u64 = 0u64;
    while i < 8u64 {
        if a[i] != 30u64 { return 1; }
        i = i + 1u64;
    }
    return 0;
}
