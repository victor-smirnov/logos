// Tests `&[i32; 3]` → `&[i32]` slice coercion in a `let` with an explicit type.
package mir_ascription_coercion_b142;

fn main() -> i32 {
    let x: [i32; 3] = [1i32, 2i32, 3i32];
    let y: &[i32] = &x;
    if y[1] != 2i32 { return 1i32; }
    return 0i32;
}
