package mir_codegen_array_b150;

fn into_inner() -> [u64; 8] {
    let x: u64 = 10 + 20;
    return [x; 8];
}

fn main() -> i64 {
    let a = into_inner();
    let mut i: i64 = 0;
    while i < 8 {
        if a[i as u64] != 30 { return 1; }
        i += 1;
    }
    return 0;
}
