package if_let_converging_enum_ret_b136;

enum SpecialsRes { Res(u64) }

fn e103(opt: Option<u64>) -> SpecialsRes {
    if let Some(r) = opt {
        return SpecialsRes::Res(r);
    } else {
        return SpecialsRes::Res(42u64);
    }
}

fn unwrap_res(r: SpecialsRes) -> u64 {
    match r {
        SpecialsRes::Res(v) => { return v; }
    }
}

fn main() -> i32 {
    if unwrap_res(e103(Some(1u64))) != 1u64 { return 1i32; }
    if unwrap_res(e103(None)) != 42u64 { return 2i32; }
    return 0i32;
}
