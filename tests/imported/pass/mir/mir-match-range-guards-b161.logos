// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/mir/mir_match_test.rs
// Modifications: closures replaced by named fns (Logos accepts match-with-guards
//   in a fn body); inclusive `0..=5` and exclusive `0..5` integer ranges with
//   `if`-guards; bool guards threaded as a param; isize → i64; `assert_eq!` →
//   early-return sentinels.
// Tests MIR match lowering of overlapping inclusive AND exclusive integer range
//   patterns combined with match-arm guards (range-vs-const ordering too).
package mir_match_range_guards_b161;

fn incl_range(x: i64, b: bool) -> i64 {
    match x {
        0i64..=5i64 if b => { return 0i64; }
        5i64..=10i64 if b => { return 1i64; }
        1i64..=4i64 if !b => { return 2i64; }
        _ => { return 3i64; }
    }
}

fn excl_range(x: i64, b: bool) -> i64 {
    match x {
        0i64..5i64 if b => { return 0i64; }
        5i64..10i64 if b => { return 1i64; }
        1i64..4i64 if !b => { return 2i64; }
        _ => { return 3i64; }
    }
}

fn incl_range_vs_const(x: i64, b: bool) -> i64 {
    match x {
        0i64..=5i64 if b => { return 0i64; }
        7i64 => { return 1i64; }
        3i64 => { return 2i64; }
        _ => { return 3i64; }
    }
}

fn main() -> i32 {
    if incl_range(3i64, false) != 2i64 { return 1i32; }
    if incl_range(3i64, true) != 0i64 { return 2i32; }
    if incl_range(5i64, false) != 3i64 { return 3i32; }
    if incl_range(5i64, true) != 0i64 { return 4i32; }

    if excl_range(3i64, false) != 2i64 { return 5i32; }
    if excl_range(3i64, true) != 0i64 { return 6i32; }
    if excl_range(5i64, false) != 3i64 { return 7i32; }
    if excl_range(5i64, true) != 1i64 { return 8i32; }

    if incl_range_vs_const(5i64, false) != 3i64 { return 9i32; }
    if incl_range_vs_const(5i64, true) != 0i64 { return 10i32; }
    if incl_range_vs_const(3i64, false) != 2i64 { return 11i32; }
    if incl_range_vs_const(7i64, false) != 1i64 { return 12i32; }
    return 0i32;
}
