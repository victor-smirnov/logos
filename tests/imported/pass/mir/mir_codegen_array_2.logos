package mir_mir_codegen_array_2;

fn into_inner(x: u64) -> [u64; 1024] {
    return [x; 1024];
}

fn main() -> i32 {
    let result: [u64; 1024] = into_inner(42u64);
    let mut i: i64 = 0i64;
    while i < 1024i64 {
        if result[i] != 42u64 { return 1i32; }
        i = i + 1i64;
    }
    return 0i32;
}
