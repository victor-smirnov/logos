// Imported from rust-lang/rust tests/ui/mir/issue-76803-branches-not-same.rs
// Modifications: derives dropped; the result is checked via a match (no enum
// equality assert). Tests an `encode` match that maps Type::A to Type::B and
// passes everything else through unchanged.
package issue_76803_branches_not_same_test;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

enum Type {
    A,
    B,
}

fn encode(v: Type) -> Type {
    return match v {
        Type::A => Type::B,
        _ => v,
    };
}

fn main() -> i32 {
    let r = encode(Type::A);
    let ok = match r {
        Type::B => true,
        _ => false,
    };
    assert!(ok);
    return 0;
}
