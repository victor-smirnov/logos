// `&[30; 1024]` slice comparison rewritten as element-by-element
// loop since Logos has no slice-equality op.
package mir_mir_codegen_array;

fn into_inner() -> [u64; 1024] {
    let x: u64 = 30u64;
    return [x; 1024];
}

fn main() -> i32 {
    let result: [u64; 1024] = into_inner();
    let mut i: i64 = 0i64;
    while i < 1024i64 {
        if result[i] != 30u64 { return 1i32; }
        i = i + 1i64;
    }
    return 0i32;
}
