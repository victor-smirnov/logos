package mir_codegen_calls_diverging_b144;

fn diverging_fn() -> ! {
    panic("diverging_fn called");
}

fn mir(take_it: bool) -> i64 {
    if take_it {
        diverging_fn();
    }
    return 7i64;
}

fn main() -> i32 {
    if mir(false) != 7i64 { return 1i32; }
    return 0i32;
}
