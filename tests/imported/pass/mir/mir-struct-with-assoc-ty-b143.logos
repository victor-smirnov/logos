package mir_struct_with_assoc_ty_b143;

trait DataBind { type Data; }
struct Global<T> { _p: i32 }
impl<T> DataBind for Global<T> { type Data = T; }

struct Data { offsets: [u32; 2] }

fn create_data() -> Data {
    let mut d: Data = Data { offsets: [1u32, 2u32] };
    d.offsets[0u64] = 3u32;
    return d;
}

fn main() -> i32 {
    let d: Data = create_data();
    if d.offsets[0u64] != 3u32 { return 1i32; }
    if d.offsets[1u64] != 2u32 { return 2i32; }
    return 0i32;
}
