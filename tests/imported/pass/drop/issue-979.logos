package m_drop_issue_979;

trait Drop { fn drop(self: Self); }

struct R {
    b: *mut i64,
}

impl Drop for R {
    fn drop(self: R) {
        unsafe { *self.b = *self.b + 1i64; }
    }
}

fn r(b: *mut i64) -> R {
    return R { b: b };
}

fn main() -> i32 {
    let mut counter: i64 = 0i64;
    let b = &mut counter as *mut i64;
    {
        let _p = r(b);
    }
    unsafe { if *b != 1i64 { return 1; } }
    return 0;
}
