package issue_2735_2_b154;

trait Drop { fn drop(self: Self); }

struct Defer { b: *mut i64 }
impl Drop for Defer { fn drop(self: Defer) { unsafe { *self.b = 1i64; } } }

fn defer(b: *mut i64) -> Defer { return Defer { b: b }; }

fn main() -> i32 {
    let mut dtor_ran: i64 = 0i64;
    let p = &mut dtor_ran as *mut i64;
    {
        let _ = defer(p);
    }
    unsafe { if *p != 1i64 { return 1i32; } }
    return 0i32;
}
