package m_drop_conditional_10734;

trait Drop { fn drop(self: Self); }

struct Foo { c: *mut i64 }

impl Drop for Foo {
    fn drop(self: Foo) { unsafe { *self.c = *self.c + 1i64; } }
}

fn main() -> i32 {
    let mut counter: i64 = 0i64;
    let c = &mut counter as *mut i64;
    unsafe {
        if true {
            let _a = Foo { c: c };
        }
        if *c != 1i64 { return 1; }

        if false {
            return 9;
        } else {
            let _a = Foo { c: c };
        }
        if *c != 2i64 { return 2; }
    }
    return 0;
}
