// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/drop/drop-trait-enum.rs / NRVO move-out shape (distilled)
// Feature: a value RETURNED from a fn is moved out — it is NOT dropped inside the
// producing fn (counter still 0 right after the call), and drops only when the
// caller's binding goes out of scope (counter 1). By-value Drop idiom.
package m_drop_returned_value_not_in_fn;

trait Drop { fn drop(self: Self); }

struct G { c: *mut i64 }
impl Drop for G { fn drop(self: G) { unsafe { *self.c = *self.c + 1i64; } } }

fn make(c: *mut i64) -> G {
    let g = G { c: c };
    return g;
}

fn main() -> i32 {
    let mut counter: i64 = 0i64;
    let c = &mut counter as *mut i64;
    {
        let g = make(c);
        unsafe { if *c != 0i64 { return 2i32; } }
        let _ = g;
    }
    unsafe { if *c == 1i64 { return 0i32; } }
    return 1i32;
}
