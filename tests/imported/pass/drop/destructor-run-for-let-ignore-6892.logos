package m_drop_destructor_run_for_let_ignore;

trait Drop { fn drop(self: Self); }

struct Foo { c: *mut i64 }
struct Bar { c: *mut i64, x: i64 }
struct Baz { c: *mut i64, f0: i64 }

impl Drop for Foo { fn drop(self: Foo) { unsafe { *self.c = *self.c + 1i64; } } }
impl Drop for Bar { fn drop(self: Bar) { unsafe { *self.c = *self.c + 1i64; } } }
impl Drop for Baz { fn drop(self: Baz) { unsafe { *self.c = *self.c + 1i64; } } }

fn main() -> i32 {
    let mut counter: i64 = 0i64;
    let c = &mut counter as *mut i64;
    unsafe {
        if *c != 0i64 { return 1; }

        { let _x = Foo { c: c }; }
        if *c != 1i64 { return 2; }
        { let _x = Bar { c: c, x: 21i64 }; }
        if *c != 2i64 { return 3; }
        { let _x = Baz { c: c, f0: 21i64 }; }
        if *c != 3i64 { return 4; }
        { let _ = Foo { c: c }; }
        if *c != 4i64 { return 7; }
        { let _ = Bar { c: c, x: 21i64 }; }
        if *c != 5i64 { return 8; }
        { let _ = Baz { c: c, f0: 21i64 }; }
        if *c != 6i64 { return 9; }
    }
    return 0;
}
