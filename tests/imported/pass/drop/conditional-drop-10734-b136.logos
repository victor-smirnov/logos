    let c = &mut counter as *mut i64;

    if true {
        let _a = Foo { c: c };
    }
    unsafe { if *c != 1i64 { return 1i32; } }

    if false {
        return 2i32;
    } else {
        let _a = Foo { c: c };
    }
    unsafe { if *c != 2i64 { return 3i32; } }
    return 0i32;
}
