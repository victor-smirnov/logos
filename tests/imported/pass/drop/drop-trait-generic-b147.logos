package drop_trait_generic_b147;

struct S<T> {
    x: T,
}

impl<T> Drop for S<T> {
    fn drop(self: &mut S<T>) {}
}

fn main() -> i32 {
    let _x = S { x: 1i64 };
    return 0i32;
}
