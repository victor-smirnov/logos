// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/drop/drop-trait-enum.rs
// Modifications: the upstream test exercises Drop on an ENUM with payload-carrying
//   variants, observing the order via an mpsc channel across threads. Logos has no
//   mpsc/threads here, so the observable channel is replaced by a `*mut i64` counter
//   and only the single-thread, in-scope drop cases are kept (threads/panic variant
//   dropped). The enum `Drop` impl matches `&Self` and writes the counter; nested
//   SendOnDrop's own Drop is also observed. local distilled-drop `trait Drop`.
// ⚠ RE-PORT CORRECTION 2026-09-08, ONE ARM PATTERN. The `Nested` arm was ported
//   `Foo::Nested(s, c)`, binding the `SendOnDrop` payload BY VALUE. Upstream's
//   arm is `Foo::NestedVariant(_, _, ref f)` — it does NOT bind the payload —
//   and the by-value spelling is E0509 here now (a move out of `self`, which
//   implements `Drop`), as well as being what double-drops the payload once the
//   call site recurses into the fields after the user drop. Restored to `_`,
//   which is upstream's own token: this is a re-port TOWARDS the original.
// ⚠ WHAT IS **NOT** REPAIRED HERE, and is the header's remaining falsehood: the
//   line above claims the impl "matches `&Self`". It does not — the receiver is
//   `fn drop(self: Foo)`, by value, where upstream has `fn drop(&mut self)`.
//   The by-value receiver is canonically illegal, but refusing it is 176 impl
//   sites in 136 files AND the stdlib `Drop` trait's own `fn drop(self: Self)`
//   signature. It is its own round; this fixture is not the place to smuggle it.
// Tests: Drop impl on an enum, dispatched by variant inside the drop body via
//   `match self { ... }`; nested field with its own Drop also runs.
package drop_trait_enum_b154;

struct SendOnDrop { c: *mut i64 }
impl Drop for SendOnDrop { fn drop(self: &mut Self) { unsafe { *self.c = *self.c + 100i64; } } }

enum Foo {
    Simple(*mut i64),
    Nested(SendOnDrop, *mut i64),
}

impl Drop for Foo {
    fn drop(self: &mut Self) {
        match self {
            Foo::Simple(c) => { unsafe { **c = **c + 1i64; } }
            Foo::Nested(_, c) => { unsafe { **c = **c + 1i64; } }   // upstream: `NestedVariant(_, _, ref f)`
        }
    }
}

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let c = &mut n as *mut i64;
    {
        let v = Foo::Simple(c);
    }
    unsafe { if *c != 1i64 { return 1i32; } }

    let mut n2: i64 = 0i64;
    let c2 = &mut n2 as *mut i64;
    {
        let v = Foo::Nested(SendOnDrop { c: c2 }, c2);
    }
    // Foo::drop adds 1, SendOnDrop::drop adds 100
    unsafe { if *c2 != 101i64 { return 2i32; } }
    return 0i32;
}
