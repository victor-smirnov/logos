// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7:
//   library/coretests/tests/convert.rs.
//
// convert.rs has two tests:
//   - `convert`           — const-fn + const-context (`const FOO: i32 = …`)
//                           + Vec; the const-eval form is a Logos divergence
//                           (compile-time evaluation routes through metacall,
//                           not const fns), so only the runtime identity
//                           `i32::from(x) == x` is meaningful — and that is
//                           already covered by the `convert_from` coretest.
//   - `into_as_try_into`  — a user `impl Into<B> for A` plus the blanket
//                           `TryInto`/`TryFrom` derived from it. Ported below
//                           as the user-impl Into dispatch (the part Logos
//                           supports without the blanket).
//
// The From / TryFrom numeric surface is covered by the `convert_from`
// coretest; this file complements it with the Into trait side.
//
// Divergences / skipped (with reason):
//   - const fn / const context — Logos has no const fn (metacall is the
//     compile-time channel); the runtime conversions are tested elsewhere.
//   - From→Into and TryFrom→TryInto BLANKET impls now WORK (landed
//     2026-05-20): stdlib/lang/convert ships `impl<S, T: From<S>> Into<T> for
//     S` and the TryFrom→TryInto analogue, so every From/TryFrom impl yields
//     `.into()` / `.try_into()` automatically — tested below on primitives.
//     The one constraint (Rust-faithful): the destination type must be
//     inferable from the call site (a `let`/return annotation). `match
//     x.try_into() { … }` with the type only annotated inside an arm gives
//     "type annotations needed" — same as Rust. See the fix chain in
//     [[baghunt-mono-blanket-body-output-param]] (sema dispatch+inference +
//     mono blanket-body output-param specialization).

package test_coretest_convert;

use std.fmt;
use logos.lang.panic;
use logos.lang.option;
use logos.lang.result;
use logos.lang.convert;

// Mirrors convert.rs::into_as_try_into — a user-defined `impl Into<B> for A`.
// Logos dispatches `.into()` to the explicit impl (no blanket needed).
struct A {}
struct B { tag: i32 }

impl Into<B> for A {
    fn into(self: A) -> B { return B { tag: 7i32 }; }
}

#[test]
fn test_into_user_impl() {
    let a: A = A {};
    let b: B = a.into();
    assert!(b.tag == 7i32);
}

// Explicit TryInto impl on a user type — Result<Ok> path.
struct Celsius { deg: i32 }
struct Kelvin  { deg: i32 }

impl TryInto<Kelvin> for Celsius {
    fn try_into(self: Celsius) -> Result<Kelvin, ConvertError> {
        if self.deg < -273i32 { return Result::Err(ConvertError {}); }
        return Result::Ok(Kelvin { deg: self.deg + 273i32 });
    }
}

#[test]
fn test_try_into_user_impl_ok() {
    let c: Celsius = Celsius { deg: 0i32 };
    match c.try_into() {
        Result::Ok(k) => { assert!(k.deg == 273i32); }
        Result::Err(_) => { panic("try_into: expected Ok"); }
    }
}

#[test]
fn test_try_into_user_impl_err() {
    let c: Celsius = Celsius { deg: -300i32 };
    match c.try_into() {
        Result::Ok(_)  => { panic("try_into: expected Err (below absolute zero)"); }
        Result::Err(_) => {}
    }
}

// Runtime identity that convert.rs::convert checks under const: i32::from(x) == x.
// (The const-context part is the divergence; the value identity holds.)
#[test]
fn test_from_identity_runtime() {
    let x: i32 = i32::from(42i8);
    assert!(x == 42i32);
}

// `.into()` on primitives via the From→Into blanket (destination inferred from
// the let annotation). Rust: `let x: i64 = 5i32.into();`.
#[test]
fn test_into_primitive_blanket() {
    let x: i64 = (5i32).into();
    assert!(x == 5i64);
    let y: i32 = (7i8).into();
    assert!(y == 7i32);
    let z: u64 = (200u8).into();
    assert!(z == 200u64);
}

// `.try_into()` on primitives via the TryFrom→TryInto blanket. Ok + Err paths.
#[test]
fn test_try_into_primitive_blanket() {
    let ok: Result<i16, ConvertError> = (300i32).try_into();
    match ok {
        Result::Ok(v)  => { assert!(v == 300i16); }
        Result::Err(_) => { panic("try_into 300→i16 should be Ok"); }
    }
    let bad: Result<i8, ConvertError> = (5000i32).try_into();
    match bad {
        Result::Ok(_)  => { panic("try_into 5000→i8 should be Err (out of range)"); }
        Result::Err(_) => {}
    }
}
