// `impl Trait for <primitive>` + coercing `&prim as &dyn Trait` and dispatching.
// The dyn-coercion built the fat handle with an EMPTY vtable type key for a
// primitive pointee (the src_struct was only computed for struct pointees) →
// build_inline_vtable returned null → no vtable stored → SIGSEGV. Now the
// coercion keys the vtable on the primitive's type name (`i64`).
package impl_trait_for_primitive_dyn;
trait Sh { fn v(self: &Self) -> i64; }
impl Sh for i64 { fn v(self: &i64) -> i64 { return *self; } }
impl Sh for bool { fn v(self: &bool) -> i64 { if *self { return 1i64; } return 0i64; } }
fn dispatch(s: &dyn Sh) -> i64 { return s.v(); }
fn main() -> i32 {
    let x: i64 = 42i64;
    if dispatch(&x as &dyn Sh) != 42i64 { return 1i32; }
    let b: bool = true;
    if dispatch(&b as &dyn Sh) != 1i64 { return 2i32; }
    return 0i32;
}
