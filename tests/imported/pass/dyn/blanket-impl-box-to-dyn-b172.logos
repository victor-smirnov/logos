// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/drop/issue-2734.rs
// Modifications: `hax`→`Hax`; `Box::new`→`box_new`; the explicit `as Box<dyn
// Hax+'static>` lifetime bound dropped (Logos has no `+'static` on dyn);
// `T: 'static` bound dropped; `pub fn main()`→`fn main()->i32`. Exercises a
// blanket `impl<A> Hax for A {}` whose instance is moved out of a generic
// `Box<T>` and unsize-coerced to `Box<dyn Hax>` — the blanket method must be
// instantiated for the concrete payload so the trait-object vtable resolves.
package dyn_blanket_box;

trait Hax {
    fn dummy(&self) {}
}
impl<A> Hax for A {}

fn perform_hax<T>(x: Box<T>) -> Box<dyn Hax> {
    return x as Box<dyn Hax>;
}

fn main() -> i32 {
    let _b: Box<dyn Hax> = perform_hax(box_new(42i64));
    return 0i32;
}
