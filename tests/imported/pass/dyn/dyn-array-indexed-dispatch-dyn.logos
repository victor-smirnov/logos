// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/traits/object/vtable-dispatch.rs shape (distilled)
// Feature: a fixed array of `&dyn Trait` handles, indexed and each dispatched
// dynamically (vtable in array element slots). Two distinct impls in the array.
// `for s in &arr` over `&dyn` is a gap (see notes) — indexed access used.
package dyn_array_indexed_dispatch;

trait Shape { fn area(self: &Self) -> i64; }

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }
impl Shape for Sq { fn area(self: &Sq) -> i64 { return (*self).s * (*self).s; } }
impl Shape for Rect { fn area(self: &Rect) -> i64 { return (*self).w * (*self).h; } }

fn main() -> i32 {
    let a = Sq { s: 3i64 };
    let b = Rect { w: 2i64, h: 5i64 };
    let arr: [&dyn Shape; 2] = [&a as &dyn Shape, &b as &dyn Shape];
    let mut total: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < 2i64 {
        total = total + arr[i].area();
        i = i + 1i64;
    }
    if total == 19i64 { return 0i32; }
    return 1i32;
}
