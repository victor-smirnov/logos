// Regression (B166, g6): a homogeneous `[&dyn Trait; N]` array dispatches
// correctly through each element (incl. multi-field structs). Previously the
// element fat pointers weren't built per-element → SIGSEGV; the &Concrete→&dyn
// element coercion (N4) now builds proper {data,vtable} fat pointers.
package dyn_ref_array_dispatch_b166;
trait Sh { fn area(self: &Self) -> i64; }
struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }
impl Sh for Sq { fn area(self: &Sq) -> i64 { return self.s * self.s; } }
impl Sh for Rect { fn area(self: &Rect) -> i64 { return self.w * self.h; } }
fn main() -> i32 {
    let a: Sq = Sq { s: 3i64 };
    let b: Sq = Sq { s: 4i64 };
    let arr: [&dyn Sh; 2] = [&a, &b];
    if arr[0i64].area() + arr[1i64].area() != 25i64 { return 1i32; }
    let r1: Rect = Rect { w: 2i64, h: 5i64 };
    let r2: Rect = Rect { w: 3i64, h: 3i64 };
    let arr2: [&dyn Sh; 2] = [&r1, &r2];
    if arr2[0i64].area() + arr2[1i64].area() != 19i64 { return 2i32; }
    return 0i32;
}
