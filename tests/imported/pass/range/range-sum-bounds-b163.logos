package range_sum_bounds_b163;

fn sum_excl(lo: i64, hi: i64) -> i64 {
    let mut s: i64 = 0i64;
    for i in lo..hi { s = s + i; }
    return s;
}

fn sum_incl(lo: i64, hi: i64) -> i64 {
    let mut s: i64 = 0i64;
    for i in lo..=hi { s = s + i; }
    return s;
}

fn main() -> i32 {
    if sum_excl(1i64, 5i64) != 10i64 { return 1i32; }
    if sum_incl(1i64, 5i64) != 15i64 { return 2i32; }
    if sum_excl(3i64, 3i64) != 0i64 { return 3i32; }
    return 0i32;
}
