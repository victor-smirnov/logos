// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/range/range_inclusive.rs (for-loop core)
// Modifications: assert!/assert_eq! -> nonzero ret; `usize` -> i64; the
//   range-bound-to-a-local (`let range = 0..=10`) and `.step_by` halves dropped
//   (a free range value needs `use std.lang.range`; step_by is an iterator
//   adapter not exercised here). Direct `for i in lo..=hi` / `for i in lo..hi`
//   loop heads kept (these desugar inline and need no import).
// Tests inclusive (`..=`) and exclusive (`..`) range iteration in for-loops.
package range_inclusive_forloop_b139;

fn main() -> i32 {
    let mut count: i64 = 0i64;
    for i in 0i64..=10i64 {
        if i < 0i64 { return 1i32; }
        if i > 10i64 { return 2i32; }
        count = count + i;
    }
    if count != 55i64 { return 3i32; }

    let mut excl: i64 = 0i64;
    for i in 0i64..10i64 {
        if i >= 10i64 { return 4i32; }
        excl = excl + i;
    }
    if excl != 45i64 { return 5i32; }
    return 0i32;
}
