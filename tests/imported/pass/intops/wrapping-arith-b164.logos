// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/numbers-arithmetic/ shapes (distilled).
// Modifications: isize->i64; assert->if-return sentinels; MIN written as -MAX-1.
//   Exercises wrapping behaviour expressed via explicit modular arithmetic on
//   unsigned types (no method, just bitmasking to a byte) plus signed overflow
//   bounds reasoning with MIN/MAX computed from MAX.
// Tests unsigned modular (byte) arithmetic via masking, signed MIN/MAX bounds,
//   and that arithmetic on u8/u32/i32 stays in range.
package wrapping_arith_b164;

fn main() -> i32 {
    let i32_max: i32 = 2147483647i32;
    let i32_min: i32 = -i32_max - 1i32;
    if i32_min != -2147483648i32 { return 1i32; }

    // byte (mod 256) wraparound emulated with masking
    let a: u32 = 250u32;
    let b: u32 = 10u32;
    let sum_byte: u32 = (a + b) & 255u32;
    if sum_byte != 4u32 { return 2i32; }

    let u8_max: u8 = 255u8;
    if u8_max != 255u8 { return 3i32; }

    let x: i64 = 1000i64;
    let y: i64 = -1000i64;
    if x + y != 0i64 { return 4i32; }
    if x * 2i64 != 2000i64 { return 5i32; }
    return 0i32;
}
