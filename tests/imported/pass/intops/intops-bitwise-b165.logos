// Modifications: assert->if-return sentinels; binary literals suffixed u32.
// Tests the bitwise operators &, |, ^, <<, >> on u32.
package intops_bitwise_b165;

fn main() -> i32 {
    let a: u32 = 0b1010u32;
    let b: u32 = 0b0110u32;
    if (a & b) != 0b0010u32 { return 1i32; }
    if (a | b) != 0b1110u32 { return 2i32; }
    if (a ^ b) != 0b1100u32 { return 3i32; }
    if (a << 1u32) != 0b10100u32 { return 4i32; }
    if (a >> 1u32) != 0b0101u32 { return 5i32; }
    return 0i32;
}
