package blocks_without_results_11709_b154;

struct S { x: i64 }

fn not(b: bool) -> bool {
    if b { return !b; } else { return true; }
}

fn side(slot: *mut i64) {
    unsafe { *slot = *slot + 1i64; }
}

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p = &mut n as *mut i64;
    let s: S = S { x: { side(p); 5i64 } };
    if s.x != 5i64 { return 1i32; }
    unsafe { if *p != 1i64 { return 2i32; } }
    if not(true) { return 3i32; }
    if !not(false) { return 4i32; }
    return 0i32;
}
