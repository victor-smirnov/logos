package typeck_method_chain_result_tc;

fn produce<T>(t: T) -> Result<i64, T> { return Result::Ok(22i64); }

fn main() -> i32 {
    let r: Result<i64, bool> = produce(false);
    let x: i64 = match r {
        Result::Ok(v) => v,
        Result::Err(_e) => -1i64,
    };
    if x != 22i64 { return 1; }
    return 0;
}
