package ufcs_type_params_b142;

trait Foo<T> {
    fn get(self: &Self) -> T;
}

impl Foo<i32> for i32 {
    fn get(self: &Self) -> i32 { return *self; }
}

fn main() -> i32 {
    let x: i32 = 1i32;
    let v: i32 = x.get();
    if v != 1i32 { return 1i32; }
    return 0i32;
}
