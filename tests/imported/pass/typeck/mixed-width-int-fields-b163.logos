package mixed_width_int_fields_b163;

struct Mixed { a: i8, b: i16, c: u32, d: i64 }

fn main() -> i32 {
    let m: Mixed = Mixed { a: 5i8, b: 300i16, c: 70000u32, d: 9000000000i64 };
    let aa: i8 = m.a + 2i8;
    let bb: i16 = m.b + 1i16;
    let cc: u32 = m.c + 1u32;
    let dd: i64 = m.d + 1i64;
    if (aa as i64) != 7i64 { return 1i32; }
    if (bb as i64) != 301i64 { return 2i32; }
    if (cc as i64) != 70001i64 { return 3i32; }
    if dd != 9000000001i64 { return 4i32; }
    return 0i32;
}
