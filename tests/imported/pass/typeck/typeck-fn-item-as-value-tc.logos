// Original path: tests/ui/typeck/typeck-fn-to-unsafe-fn-ptr.rs
// Modifications: companion to the existing typeck-fn-to-unsafe-fn-ptr
// import — here a (safe) fn item is bound to a `fn(...)` -typed local and
// passed through it, exercising fn-item → fn-ptr value coercion at a `let`
// without the unsafe axis.
package typeck_fn_item_as_value_tc;

fn square(x: i64) -> i64 { return x * x; }

fn main() -> i32 {
    let f: fn(i64) -> i64 = square;
    let g = f;
    if g(7i64) != 49i64 { return 1; }
    return 0;
}
