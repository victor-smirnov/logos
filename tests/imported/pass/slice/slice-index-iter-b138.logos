package slice_index_iter_b138;

fn main() -> i32 {
    let v: [i32; 5] = [1i32, 2i32, 3i32, 4i32, 5i32];
    if v[0] != 1i32 { return 1i32; }
    if v[4] != 5i32 { return 2i32; }
    let mut total: i32 = 0i32;
    let mut i: i64 = 0i64;
    while i < 5i64 {
        total = total + v[i];
        i = i + 1i64;
    }
    if total != 15i32 { return 3i32; }
    return 0i32;
}
