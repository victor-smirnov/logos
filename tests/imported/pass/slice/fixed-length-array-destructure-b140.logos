// Tests `let [a,b,c,d] = arr` and `let [a,_,_,d] = arr` fixed-array destructure
//   plus a function PARAMETER whose pattern is `[x,y,z]`.
package fixed_length_array_destructure_b140;

fn foo(arr: [i64; 3]) -> (i64, i64, i64) {
    let [x, y, z] = arr;
    return (x, x + y, x + y + z);
}

fn main() -> i32 {
    let r: (i64, i64, i64) = foo([1i64, 2i64, 3i64]);
    if r.0 != 1i64 { return 1i32; }
    if r.1 != 3i64 { return 2i32; }
    if r.2 != 6i64 { return 3i32; }

    let arr: [i64; 4] = [10i64, 20i64, 20i64, 10i64];
    let [a, b, c, d] = arr;
    if a != 10i64 { return 4i32; }
    if b != 20i64 { return 5i32; }
    if c != 20i64 { return 6i32; }
    if d != 10i64 { return 7i32; }

    let [e, _, _, h] = arr;
    if e != 10i64 { return 8i32; }
    if h != 10i64 { return 9i32; }
    return 0i32;
}
