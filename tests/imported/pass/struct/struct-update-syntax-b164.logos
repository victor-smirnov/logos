package struct_update_syntax_b164;

struct Config {
    width: i64,
    height: i64,
    depth: i64,
}

fn with_depth(c: Config, d: i64) -> Config {
    return Config { width: c.width, height: c.height, depth: d };
}

fn main() -> i32 {
    let base: Config = Config { width: 4i64, height: 8i64, depth: 0i64 };
    let derived: Config = with_depth(base, 16i64);
    if derived.width != 4i64 { return 1i32; }
    if derived.height != 8i64 { return 2i32; }
    if derived.depth != 16i64 { return 3i32; }
    return 0i32;
}
