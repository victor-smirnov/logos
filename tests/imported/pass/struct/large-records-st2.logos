package se_large_records;

struct Large { a: i64, b: i64, c: i64, d: i64, e: i64, f: i64,
               g: i64, h: i64, i: i64, j: i64, k: i64, l: i64 }

fn build() -> Large {
    return Large { a: 0i64, b: 1i64, c: 2i64, d: 3i64, e: 4i64, f: 5i64,
                   g: 6i64, h: 7i64, i: 8i64, j: 9i64, k: 10i64, l: 11i64 };
}

fn main() -> i32 {
    let r = build();
    if r.a != 0i64 { return 1i32; }
    if r.f != 5i64 { return 2i32; }
    if r.l != 11i64 { return 3i32; }
    return 0i32;
}
