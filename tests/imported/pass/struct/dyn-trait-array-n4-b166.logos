// Regression for B166 N4 (SIGSEGV): an array of trait objects `[&dyn Tr; N]`.
// Each element source is a concrete `&Concrete`; the array slot is a pointer
// to a fat {data,vtable} value, so each element needs the same unsize coercion
// gen_struct_lit applies to a `&dyn` field. Without it the raw thin `&Concrete`
// was stored and `arr[i].method()` dispatched through a garbage vtable.
// (Heterogeneous concrete element types in one literal need expected-type-hint
// plumbing — a separate follow-up; this covers the homogeneous SIGSEGV fix.)
package dyn_trait_array_n4_b166;

trait Sh { fn area(self: &Self) -> i64; }
struct Sq { s: i64 }
impl Sh for Sq { fn area(self: &Sq) -> i64 { return self.s * self.s; } }

fn main() -> i32 {
    let a: Sq = Sq { s: 3i64 };
    let b: Sq = Sq { s: 4i64 };
    let arr: [&dyn Sh; 2] = [&a, &b];
    if arr[0i64].area() != 9i64 { return 1i32; }
    if arr[1i64].area() != 16i64 { return 2i32; }
    // iterate + dispatch
    let mut total: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < 2i64 { total = total + arr[i].area(); i = i + 1i64; }
    if total != 25i64 { return 3i32; }
    return 0i32;
}
