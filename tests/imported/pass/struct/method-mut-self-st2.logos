// Synthesized for B131 from the structs run-pass family (methods facet): a
// `self:&mut T` method mutating a field across successive calls, plus a
// by-value-self consuming method that reads the final state.
package se_method_mut_self;

struct Counter { n: i64 }

impl Counter {
    fn bump(self: &mut Counter) { self.n = self.n + 1i64; }
    fn add(self: &mut Counter, k: i64) { self.n = self.n + k; }
    fn value(self: Counter) -> i64 { return self.n; }
}

fn main() -> i32 {
    let mut c = Counter { n: 0i64 };
    c.bump();
    c.bump();
    c.add(10i64);
    if c.value() != 12i64 { return 1i32; }
    return 0i32;
}
