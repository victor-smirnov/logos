// Synthesized for B131 from the structs run-pass family (generic-struct +
// methods facet; cf. tests/ui/structs/struct-path-self-2.rs without the
// Default/Add trait machinery).
// A generic struct `Wrap<T>` with inherent methods reading + replacing the
// stored value, exercised on two distinct concrete instantiations.
package se_generic_struct_methods;

struct Wrap<T> { val: T }

// `T: Copy` required: `get(&self) -> T` copies the field out of `&self`;
// a non-Copy T would be a move out of a borrow (E0507).
impl<T: Copy> Wrap<T> {
    fn get(self: &Wrap<T>) -> T { return self.val; }
    fn make(v: T) -> Wrap<T> { return Wrap { val: v }; }
}

fn main() -> i32 {
    let a: Wrap<i64> = Wrap::make(7i64);
    if a.get() != 7i64 { return 1i32; }

    let b: Wrap<bool> = Wrap { val: true };
    if !b.get() { return 2i32; }
    return 0i32;
}
