// trait-resolved in rustc); usize→u64; built explicitly. Exercises a struct
// whose field is ANOTHER struct (`Y { y: X }`), constructed by nested literal
// and destructured by nested field-binding pattern `let Y { y: X { x } } = ..`.
package se_nested_struct;

struct X { x: u64 }
struct Y { y: X }

fn main() -> i32 {
    let outer = Y { y: X { x: 42u64 } };
    let Y { y: X { x } } = outer;
    if x != 42u64 { return 1i32; }
    return 0i32;
}
