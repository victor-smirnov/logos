// return-code check. Exercises a struct whose field is named `new` (a word
// that is method-like elsewhere) used in a literal and a field access.
package se_struct_new_field_name;

struct Foo { new: i64 }

fn main() -> i32 {
    let foo = Foo { new: 3i64 };
    if foo.new != 3i64 { return 1i32; }
    return 0i32;
}
