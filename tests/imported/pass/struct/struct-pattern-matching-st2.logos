// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/structs/struct-pattern-matching.rs
// Modifications: isize→i64; `pub fn main()`→`fn main()->i32`; println! arm
// dropped → field reads checked instead; the wildcard-fields arm `Foo { .. }`
// kept. Exercises matching a struct by full field-binding pattern and by the
// rest-pattern `Foo { .. }`.
package se_struct_pattern_matching;

struct Foo { x: i64, y: i64 }

fn main() -> i32 {
    let a = Foo { x: 1i64, y: 2i64 };
    let mut sx = 0i64;
    let mut sy = 0i64;
    match a {
        Foo { x: x, y: y } => { sx = x; sy = y; }
    }
    if sx != 1i64 { return 1i32; }
    if sy != 2i64 { return 2i32; }

    let mut hit = 0i32;
    match a {
        Foo { .. } => { hit = 1i32; }
    }
    if hit != 1i32 { return 3i32; }
    return 0i32;
}
