package estr_slice_cmp_b161;

use logos.lang.str;

fn main() -> i32 {
    let x: str = "hello";
    let v: str = "hello";
    let z: str = "thing";

    if x[0i64] != ('h' as u8) { return 1i32; }
    if x[4i64] != ('o' as u8) { return 2i32; }

    if !str_eq(v, x) { return 3i32; }
    if str_eq(x, z) { return 4i32; }

    let a: str = "aaaa";
    let b: str = "bbbb";
    let c: str = "cccc";
    let cc: str = "ccccc";

    if !(a < b) { return 5i32; }
    if !(a <= b) { return 6i32; }
    if !(b >= a) { return 7i32; }
    if !(b > a) { return 8i32; }

    if !(a < c) { return 9i32; }
    if !(c > a) { return 10i32; }

    if !(c < cc) { return 11i32; }
    if !(cc > c) { return 12i32; }
    return 0i32;
}
