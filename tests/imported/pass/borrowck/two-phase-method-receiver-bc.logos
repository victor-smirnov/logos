package two_phase_method_receiver_bc;

struct Acc { total: i64 }

impl Acc {
    fn add(self: &mut Acc, v: i64) { (*self).total = (*self).total + v; }
    fn cur(self: &Acc) -> i64 { return (*self).total; }
}

fn main() -> i32 {
    let mut a: Acc = Acc { total: 5i64 };
    // two-phase: `&mut a` for `add` activates only after `a.cur()` is read
    a.add(a.cur());
    if a.total != 10i64 { return 1; }
    return 0;
}
