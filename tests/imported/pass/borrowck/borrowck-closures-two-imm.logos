// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/borrowck/borrowck-closures-two-imm.rs
// Modifications: Logos closures require explicit parameter / return
// types and an explicit `return` (no bare-expression body); Rust's
// trailing-expression `fn` returns become explicit `return`. The
// `&x` inside a closure body case is now supported (B3-bg-04 /
// C5-cl-05 closed 2026-05-11 — closure capture scanner now
// recognises AddrOf expressions), so `b` and `c` are restored.
package borrowck_closures_two_imm;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn a() -> i32 {
    let mut x: i32 = 3i32;
    x = x + 1i32;
    let c1 = || -> i32 { return x * 4i32; };
    let c2 = || -> i32 { return x * 5i32; };
    return c1() * c2() * x;
}

fn get(x: &i32) -> i32 {
    return *x * 4i32;
}

fn b() -> i32 {
    let mut x: i32 = 3i32;
    x = x + 1i32;
    let c1 = || -> i32 { return get(&x); };
    let c2 = || -> i32 { return get(&x); };
    return c1() * c2() * x;
}

fn c() -> i32 {
    let mut x: i32 = 3i32;
    x = x + 1i32;
    let c1 = || -> i32 { return x * 5i32; };
    let c2 = || -> i32 { return get(&x); };
    return c1() * c2() * x;
}

fn main() -> i32 {
    assert_eq!(a(), 1280i32);
    assert_eq!(b(), 1024i32);
    assert_eq!(c(), 1280i32);
    return 0;
}
