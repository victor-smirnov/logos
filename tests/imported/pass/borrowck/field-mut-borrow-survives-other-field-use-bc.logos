// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/borrowck/borrowck-use-mut-borrow-rpass.rs
// Distilled facet: a `&mut` borrow of one field stays live across a
// (copy/move) use of the OTHER field, then is written through. Box→i64.
package field_mut_borrow_survives_bc;

struct A { a: i64, b: i64 }

fn field_copy_after_field_borrow() -> i64 {
    let mut x: A = A { a: 1i64, b: 2i64 };
    let p: &mut i64 = &mut x.b;
    let _c: i64 = x.a;        // use (copy) the other field
    *p = 3i64;
    return *p + _c;
}

fn main() -> i32 {
    if field_copy_after_field_borrow() != 4i64 { return 1; }
    return 0;
}
