package borrowck_borrow_of_mut_base_ptr_safe;

fn foo(t0: &mut isize, t1: &mut isize) {
    let _p: &isize = &*t0;        // freezes *t0
    let t2: &&mut isize = &t0;
    let _q: &isize = &**t2;        // freezes *t0, but that's ok...
    let _r: &isize = &*t0;        // ...could do same thing directly
    let _t1u: &isize = &*t1;
}

fn main() -> i32 {
    let mut a: isize = 1isize;
    let mut b: isize = 2isize;
    foo(&mut a, &mut b);
    return 0;
}
