// arms of an `if/else` — still gets exercised.
package lazy_init;

fn foo(x: isize) -> isize { return x; }

fn main() -> i32 {
    let mut x: isize = 0isize;
    if 1isize > 2isize { x = 12isize; } else { x = 10isize; }
    let _r: isize = foo(x);
    return 0;
}
