// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/borrowck/borrowck-rvalues-mutable.rs
// Modifications: explicit lifetime `<'a>` on `inc` dropped — Logos
// elides it from the signature here (the returned `&mut Counter` ties
// to `&mut self` automatically); rest ports as-is.
package borrowck_rvalues_mutable;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

struct Counter { value: usize }

impl Counter {
    fn new(v: usize) -> Counter { return Counter { value: v }; }

    fn inc(self: &mut Counter) -> &mut Counter {
        self.value = self.value + 1usize;
        return self;
    }

    fn get(self: &Counter) -> usize { return self.value; }

    fn get_and_inc(self: &mut Counter) -> usize {
        let v: usize = self.value;
        self.value = self.value + 1usize;
        return v;
    }
}

fn main() -> i32 {
    let mut c1: Counter = Counter::new(22usize);
    let v: usize = c1.get_and_inc();
    assert_eq!(v, 22usize);

    let mut c2: Counter = Counter::new(22usize);
    let v2: usize = c2.inc().inc().get();
    assert_eq!(v2, 24usize);
    return 0;
}
