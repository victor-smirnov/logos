// Imported from rust-lang/rust tests/ui/borrowck/two-phase-control-flow-split-before-activation.rs
// Modifications: isize → i64; usize-conditional kept; made run-pass by checking
// the chosen mutable borrow. Tests a `&mut` borrow whose target is selected
// across a control-flow split (if/else) before use.
package two_phase_control_flow_split_test;

fn maybe() -> bool { false }

fn main() -> i32 {
    let mut a = 0i64;
    let mut b = 0i64;
    let p = if maybe() {
        &mut a
    } else {
        &mut b
    };
    *p = 5i64;
    if b != 5i64 { return 1; }
    return 0;
}
