// Original path: tests/ui/borrowck/borrowck-mut-vec-as-imm-slice.rs
// Modifications: `&Vec<i64>` → `&[i64]` at want_slice (B3-bg-06 closed
// 2026-05-11 — `&Vec<T>` auto-coerces to `&[T]` at fn-arg position).
// The Rust `for i in v { sum += *i }` loop is now faithful: B3-bg-07
// closed 2026-05-12 — `*x` on a non-pointer value is identity, so the
// Rust spelling compiles unchanged even though Logos's iteration
// model yields `T` directly (not `&T`).
// Vec/slice iter element-value correctness closed 2026-05-13 — was
// masked by broken assert_eq!; root cause was array params lacking
// var_subscript_ entry.
package borrowck_mut_vec_as_imm_slice;

use std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.mem.collections.vec;

fn want_slice(s: &[i64]) -> i64 {
    let mut sum: i64 = 0i64;
    for i in s { sum = sum + *i; }
    return sum;
}

fn has_mut_vec(v: Vec<i64>) -> i64 {
    return want_slice(&v);
}

fn main() -> i32 {
    let v: Vec<i64> = vec_from_arr([1i64, 2i64, 3i64]);
    assert_eq!(has_mut_vec(v), 6i64);
    return 0;
}
