// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/borrowck/borrowck-mut-vec-as-imm-slice.rs
// Modifications: Rust `&[isize]` slice arg becomes `&Vec<i64>` (Logos
// surface doesn't yet have an implicit Vec→slice coercion at fn-arg
// position); `for i in v { sum += *i }` becomes a length-indexed loop
// since Logos's IntoIterator-for-&Vec is wired but `*i` on the loop
// var here requires the borrow checker to track the iterator's borrow,
// which is the cross-traits-borrowck topic for a later batch. The
// test still exercises passing a Vec by `&` to a function that reads
// it without consuming the original.
package borrowck_mut_vec_as_imm_slice;

use std.fmt;
use std.lang.text;
use std.collections.vec;

fn want_slice(v: &Vec<i64>) -> i64 {
    let mut sum: i64 = 0i64;
    let n: i64 = v.length();
    let mut i: i64 = 0i64;
    while i < n {
        sum = sum + v.get(i);
        i = i + 1i64;
    }
    return sum;
}

fn has_mut_vec(v: Vec<i64>) -> i64 {
    return want_slice(&v);
}

fn main() -> i32 {
    let mut v: Vec<i64> = vec_new::<i64>();
    v.push(1i64);
    v.push(2i64);
    v.push(3i64);
    assert_eq!(has_mut_vec(v), 6i64);
    return 0;
}
