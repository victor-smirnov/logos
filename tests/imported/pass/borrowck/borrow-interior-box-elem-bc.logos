// Facet: a heap value held by a local, with a shared reference into its
// interior stored elsewhere and read back. `Box<usize>`/HashMap → a stack
// i64 and a `&i64` interior borrow (the borrow-of-interior facet is the point).
package borrow_interior_box_elem_bc;

struct Holder { ptr: *const i64 }

fn main() -> i32 {
    let x: i64 = 1i64;
    let h: Holder = Holder { ptr: &x };
    unsafe {
        if *(h.ptr) != 1i64 { return 1; }
    }
    return 0;
}
