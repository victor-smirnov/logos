//   - Integer literals carry `i32` suffix where needed for inference.

package test_cmp;

use std.fmt;
use std.lang.text;
use std.lang.cmp;
use std.lang.ord;

#[test]
fn test_int_totalord() {
    assert_eq!(5i32.cmp(&10i32), Ordering::Less);
    assert_eq!(10i32.cmp(&5i32), Ordering::Greater);
    assert_eq!(5i32.cmp(&5i32), Ordering::Equal);
    assert_eq!((-5i32).cmp(&12i32), Ordering::Less);
    assert_eq!(12i32.cmp(&-5i32), Ordering::Greater);
}

#[test]
fn test_bool_totalord() {
    assert_eq!(true.cmp(&false), Ordering::Greater);
    assert_eq!(false.cmp(&true), Ordering::Less);
    assert_eq!(true.cmp(&true), Ordering::Equal);
    assert_eq!(false.cmp(&false), Ordering::Equal);
}

#[test]
fn test_isize_totalord() {
    // Added beyond upstream — verifies Ord on isize too.
    assert_eq!(5isize.cmp(&10isize), Ordering::Less);
    assert_eq!(10isize.cmp(&10isize), Ordering::Equal);
    assert_eq!(100isize.cmp(&10isize), Ordering::Greater);
}

// Adaptation of upstream `test_ord_min_max_by`. Rust's `cmp::min_by`
// takes a `FnOnce(&T, &T) -> Ordering`; Logos's `cmp_min_by` takes
// `fn(T, T) -> Ordering` by value. The compare fn ranks by absolute
// value to verify that `min_by` returns the *original* element, not
// the smaller-absolute one.
fn abs_cmp(x: i32, y: i32) -> Ordering {
    let a: i32 = if x < 0i32 { 0i32 - x } else { x };
    let b: i32 = if y < 0i32 { 0i32 - y } else { y };
    if a < b { return Ordering::Less; }
    if a > b { return Ordering::Greater; }
    return Ordering::Equal;
}

#[test]
fn test_ord_min_max_by() {
    assert_eq!(cmp_min_by(1i32,  -1i32, abs_cmp), 1i32);
    assert_eq!(cmp_min_by(1i32,  -2i32, abs_cmp), 1i32);
    assert_eq!(cmp_min_by(2i32,  -1i32, abs_cmp), -1i32);
    assert_eq!(cmp_max_by(1i32,  -1i32, abs_cmp), -1i32);
    assert_eq!(cmp_max_by(1i32,  -2i32, abs_cmp), -2i32);
    assert_eq!(cmp_max_by(2i32,  -1i32, abs_cmp), 2i32);
}

// Upstream `test_ord_min_max_by_key`. Rust's `|x: &i32| x.abs()`
// becomes a by-value `fn(i32) -> i32` since Logos's `cmp_min_by_key`
// takes its key fn by value.
fn abs_key(x: i32) -> i32 {
    if x < 0i32 { return 0i32 - x; }
    return x;
}

#[test]
fn test_ord_min_max_by_key() {
    assert_eq!(cmp_min_by_key(1i32,  -1i32, abs_key), 1i32);
    assert_eq!(cmp_min_by_key(1i32,  -2i32, abs_key), 1i32);
    assert_eq!(cmp_min_by_key(2i32,  -1i32, abs_key), -1i32);
    assert_eq!(cmp_max_by_key(1i32,  -1i32, abs_key), -1i32);
    assert_eq!(cmp_max_by_key(1i32,  -2i32, abs_key), -2i32);
    assert_eq!(cmp_max_by_key(2i32,  -1i32, abs_key), 2i32);
}

#[test]
fn test_ordering_reverse() {
    assert_eq!(Ordering::Less.reverse(),    Ordering::Greater);
    assert_eq!(Ordering::Equal.reverse(),   Ordering::Equal);
    assert_eq!(Ordering::Greater.reverse(), Ordering::Less);
}

#[test]
fn test_ordering_predicates() {
    // Beyond upstream — coverage for the is_lt / is_le / is_eq / etc. shim.
    assert!(Ordering::Less.is_lt());
    assert!(Ordering::Less.is_le());
    assert!(!Ordering::Less.is_eq());
    assert!(Ordering::Less.is_ne());
    assert!(!Ordering::Less.is_gt());
    assert!(!Ordering::Less.is_ge());

    assert!(!Ordering::Equal.is_lt());
    assert!(Ordering::Equal.is_le());
    assert!(Ordering::Equal.is_eq());
    assert!(!Ordering::Equal.is_ne());
    assert!(!Ordering::Equal.is_gt());
    assert!(Ordering::Equal.is_ge());

    assert!(!Ordering::Greater.is_lt());
    assert!(!Ordering::Greater.is_le());
    assert!(!Ordering::Greater.is_eq());
    assert!(Ordering::Greater.is_ne());
    assert!(Ordering::Greater.is_gt());
    assert!(Ordering::Greater.is_ge());
}
