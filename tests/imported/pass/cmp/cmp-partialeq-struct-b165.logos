package cmp_partialeq_struct_b165;

use logos.lang.cmp;

struct P { x: i64, y: i64 }
impl PartialEq for P {
    fn eq(self: &Self, o: &P) -> bool { return self.x == o.x && self.y == o.y; }
}
fn main() -> i32 {
    let a = P { x: 1i64, y: 2i64 };
    let b = P { x: 1i64, y: 2i64 };
    let c = P { x: 1i64, y: 3i64 };
    if !(a == b) { return 1i32; }
    if a == c { return 2i32; }
    if !(a != c) { return 3i32; }
    return 0i32;
}
