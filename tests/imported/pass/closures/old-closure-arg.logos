package cl_old_closure_arg;

use std.fmt;
use std.lang.text;
use std.lang.option;
use std.collections.vec;

fn main() -> i32 {
    let v: Vec<f64> = vec_from_arr([-1.0f64, 0.0f64, 1.0f64, 2.0f64, 3.0f64]);
    let mut count: i32 = 0i32;
    for i in &v {
        count = count + 1i32;
    }
    if count != 5i32 { return 1i32; }
    return 0i32;
}
