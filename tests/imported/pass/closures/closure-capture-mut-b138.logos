// Tests a closure capturing a mutable local by reference and incrementing it
//   across several calls.
package closure_capture_mut_b138;

fn main() -> i32 {
    let mut count: i32 = 0i32;
    let mut bump = || { count = count + 1i32; };
    bump();
    bump();
    bump();
    if count != 3i32 { return 1i32; }
    return 0i32;
}
