// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/closures/old-closure-iter-2.rs
// Modifications: the nested-iter sum distilled to a single higher-order
// `apply_each<F: FnMut(i64)>` over a small fixed array, with a capturing
// FnMut that compound-assigns into an outer mut accumulator. (Plain `=`
// assignment into a captured upvar is a separate gap; `+=` works.)
package closure_fnmut_accumulate_cl2;

fn apply_each<F: FnMut(i64)>(xs: [i64; 3], mut f: F) {
    let mut i: i64 = 0i64;
    while i < 3i64 { f(xs[i]); i += 1i64; }
}

fn main() -> i32 {
    let xs: [i64; 3] = [10i64, 20i64, 30i64];
    let mut total: i64 = 0i64;
    apply_each(xs, |v: i64| { total += v; });
    if total != 60i64 { return 1; }
    return 0;
}
