package old_closure_arg_call_as;

use std.fmt;
use std.lang.text;

fn asBlock<F: FnOnce() -> usize>(f: F) -> usize {
    return f();
}

fn main() -> i32 {
    let x: usize = asBlock(|| -> usize { return 22usize; });
    assert_eq!(x, 22usize);
    return 0;
}
