// B62: HRTB with Fn-family + multiple args.
package hrtb_fn_family_stress;
fn want<F>(f: F) -> i32 where F: for<'a, 'b> Fn(&'a i32, &'b i32) -> i32 {
    let x: i32 = 7i32; let y: i32 = 3i32;
    return f(&x, &y);
}
fn add(a: &i32, b: &i32) -> i32 { return *a + *b; }
fn main() -> i32 { return want::<fn(&i32, &i32) -> i32>(add) - 10i32; }
