// B91: two different traits impl'd on same type — OK.
package coherence_different_traits;

trait A { fn a(self: &Self) -> i32; }
trait B { fn b(self: &Self) -> i32; }
struct S { _x: i32 }
impl A for S { fn a(self: &S) -> i32 { return 1i32; } }
impl B for S { fn b(self: &S) -> i32 { return 2i32; } }

fn main() -> i32 {
    let s: S = S { _x: 0i32 };
    return s.a() + s.b() - 3i32;
}
