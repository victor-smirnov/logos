// B85: impl-where `'a: 'a` is reflexive — always discharged.
package hrtb_impl_where_reflexive;

trait T<X> { fn t(self: &Self, x: X) -> i32 { return 0i32; } }

struct K { _x: i32 }
impl<'a> T<&'a i32> for K where 'a: 'a {}

fn want<X>() where X: for<'a> T<&'a i32> {}

fn main() -> i32 { want::<K>(); return 0i32; }
