package closure_in_match_arm_cl2;

fn foo(_x: i64) -> i64 { return 0i64; }

fn pick(sel: i32) -> fn(i64) -> i64 {
    let f = match sel {
        0 => foo,
        _ => foo,
    };
    return f;
}

