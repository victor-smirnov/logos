// Imported from rust-lang/rust tests/ui/higher-ranked/trait-bounds/hrtb-type-outlives.rs
// Modifications: `isize` → `i64`, `usize` → `u64`. Exercises B62 +
// B65 + B67: HRTB bound `for<'a> Foo<&'a i64>` satisfied by
// `impl<'a, X> Foo<&'a i64> for SomeStruct<X> where X: 'a`. The
// `X: 'a` type-outlives bound is parsed (B67 where-on-impl) and
// stored on the impl's TypeParam.lifetime_outlives.
package hrtb_type_outlives;

trait Foo<X> { fn foo(self: Self, x: X) -> i32 { return 0i32; } }

fn want_foo<T>() where T: for<'a> Foo<&'a i64> {}

struct SomeStruct<X> { x: X }

impl<'a, X> Foo<&'a i64> for SomeStruct<X> where X: 'a {}

fn main() -> i32 {
    want_foo::<SomeStruct<u64>>();
    return 0i32;
}
