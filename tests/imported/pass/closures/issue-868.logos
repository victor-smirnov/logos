// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/closures/issue-868.rs
// Modifications: trimmed to the parts that don't rely on type
// inference for empty closures. Logos closures need explicit return
// type, so `| | { 10 }` becomes `|| -> i32 { return 10i32; }`.
package issue_868;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

fn f<T, F: FnOnce() -> T>(g: F) -> T {
    return g();
}

fn main() -> i32 {
    let x: i32 = f(|| -> i32 { return 10i32; });
    assert_eq!(x, 10i32);
    return 0;
}
