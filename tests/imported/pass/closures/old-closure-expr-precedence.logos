fn main() -> i32 {
    let num: i32 = 12i32;
    let r1: i32 = if true { 12i32 } else { 12i32 } - num;
    if r1 != 0i32 { return 1i32; }
    let r2: i32 = 12i32 - if true { 12i32 } else { 12i32 };
    if r2 != 0i32 { return 2i32; }
    return 0i32;
