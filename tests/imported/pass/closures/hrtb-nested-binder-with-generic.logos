package hrtb_nested_binder_with_generic;
trait Echo<X> { fn e(self: Self, x: X) -> i32; }
struct G { _x: i32 }
impl<'a, T> Echo<&'a T> for G { fn e(self: G, _x: &'a T) -> i32 { return 0i32; } }
fn run<F>() -> i32 where F: for<'a> Echo<&'a i32> { return 0i32; }
fn main() -> i32 { return run::<G>(); }
