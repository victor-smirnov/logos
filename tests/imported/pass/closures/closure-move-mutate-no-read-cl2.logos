package closure_move_mutate_no_read_cl2;

fn main() -> i32 {
    let x: i64 = 1i64;
    let mut thunk = move || { let mut y: i64 = x; y = 2i64; let _z: i64 = y; };
    thunk();
    if x != 1i64 { return 1; }
    return 0;
}
