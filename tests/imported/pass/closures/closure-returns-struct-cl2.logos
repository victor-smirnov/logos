// Modifications: a closure whose body constructs and returns a struct
// value, with the struct's field read after the call. Tests a closure
// returning an aggregate (not a scalar).
package closure_returns_struct_cl2;

struct Point { x: i64, y: i64 }

fn main() -> i32 {
    let mk = |a: i64, b: i64| -> Point { return Point { x: a, y: b }; };
    let p = mk(3i64, 4i64);
    if p.x + p.y != 7i64 { return 1; }
    return 0;
}
