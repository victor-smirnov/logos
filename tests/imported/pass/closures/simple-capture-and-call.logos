package simple_capture_and_call;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    let x: usize = 1usize;
    let y = || -> usize { return x; };
    let z: usize = y();
    assert_eq!(z, 1usize);
    return 0;
}
