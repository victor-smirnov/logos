package closure_immediate_call_b138;

fn main() -> i32 {
    let base: i32 = 10i32;
    let add = |x: i32| -> i32 { return x + base; };
    if add(5i32) != 15i32 { return 1i32; }

    let dbl = |y: i32| -> i32 { return y * 2i32; };
    if dbl(21i32) != 42i32 { return 2i32; }
    return 0i32;
}
