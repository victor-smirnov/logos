package closure_fnptr_array_cl2;

fn add(a: i32, b: i32) -> i32 { return a + b; }
fn sub(a: i32, b: i32) -> i32 { return a - b; }

fn main() -> i32 {
    let funcs: [fn(i32, i32) -> i32; 2] = [add, sub];
    let r0: i32 = funcs[0i64](5i32, 5i32);
    let r1: i32 = funcs[1i64](5i32, 5i32);
    if r0 != 10i32 { return 1; }
    if r1 != 0i32 { return 2; }
    return 0;
}
