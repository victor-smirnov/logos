// HRTB bound + elided-lt in fn body.
package hrtb_with_elision_elsewhere;
trait Use<X> { fn u(self: &Self, x: X) -> i32 { return 0i32; } }
struct K { _x: i32 }
impl<'a> Use<&'a i32> for K {}
fn run<T>(t: &T) -> i32 where T: for<'a> Use<&'a i32> { return 0i32; }
fn main() -> i32 { let k: K = K { _x: 0i32 }; return run::<K>(&k); }
