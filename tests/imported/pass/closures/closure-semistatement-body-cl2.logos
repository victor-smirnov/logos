package closure_semistatement_body_cl2;

fn main() -> i32 {
    let f = |n: i64| -> i64 {
        let mut acc: i64 = 0i64;
        let mut i: i64 = 0i64;
        while i < n { acc += i; i += 1i64; }
        if acc > 100i64 { return 100i64; }
        return acc;
    };
    if f(5i64) != 10i64 { return 1; }
    return 0;
}
