// Adversarial intersection (B169): a Vec of fn-pointers, indexed and invoked in
// a loop (`fns.get(i)` then call). Exercises generic-container element = fn-ptr +
// invoke-of-accessor-result. Distilled from rust-lang closure/fn-ptr collection idioms.
package vec_of_fn_ptrs_invoke;
use logos.mem.collections.vec;
fn main() -> i32 {
    let mut fns: Vec<fn(i64) -> i64> = vec_new::<fn(i64) -> i64>();
    fns.push(|x: i64| x + 1i64);
    fns.push(|x: i64| x * 3i64);
    let mut acc: i64 = 2i64;
    let mut i: i64 = 0i64;
    while i < fns.length() { let g = fns.get(i); acc = g(acc); i = i + 1i64; }
    if acc != 9i64 { return 1i32; }   // (2+1)*3 = 9
    return 0i32;
}
