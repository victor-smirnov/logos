package closure_capture_two_disjoint_mut_cl2;

fn main() -> i32 {
    let mut a: i64 = 0i64;
    let mut b: i64 = 0i64;
    let mut step = || { a += 1i64; b += 2i64; };
    step(); step(); step();
    if a != 3i64 { return 1; }
    if b != 6i64 { return 2; }
    return 0;
}
