// Modifications: a struct method that accepts a closure `F: Fn(i64)->i64`
// and applies it to a stored field. Tests passing a closure into an
// inherent method (method-level Fn-bound generic param).
package closure_passed_to_method_cl2;

struct Holder { v: i64 }

impl Holder {
    fn map_field<F: Fn(i64) -> i64>(self: &Holder, f: F) -> i64 {
        return f(self.v);
    }
}

fn main() -> i32 {
    let h = Holder { v: 21i64 };
    let r = h.map_field(|x: i64| -> i64 { return x * 2i64; });
    if r != 42i64 { return 1; }
    return 0;
}
