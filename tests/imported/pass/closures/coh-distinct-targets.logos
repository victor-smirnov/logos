package coh_distinct_targets;
trait T { fn x(self: &Self) -> i32; }
struct A { _x: i32 }
struct B { _x: i32 }
impl T for A { fn x(self: &A) -> i32 { return 1i32; } }
impl T for B { fn x(self: &B) -> i32 { return 2i32; } }
fn main() -> i32 {
    let a: A = A { _x: 0i32 };
    let b: B = B { _x: 0i32 };
    return a.x() + b.x() - 3i32;
}
