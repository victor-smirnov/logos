package closure_block_wrapping_fnptr_cl3;

fn force<F>(f: F) -> i64 where F: FnOnce() -> i64 { return f(); }

fn seven() -> i64 { return 7i64; }

fn main() -> i32 {
    if force(seven) != 7i64 { return 1i32; }
    let g = || { force(seven) };
    if g() != 7i64 { return 2i32; }
    return 0i32;
}
