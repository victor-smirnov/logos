// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/issues/issue-28181.rs
// Modifications: `usize`→`i64`; the empty-bodied `f([2])` use → return-code
// checks; `pub fn main()`→`fn main()->i32`. Added a capturing variant to also
// exercise the env-carrying closure path.
//
// G172-9 (FIXED): a closure whose parameter is a fixed-size array `Fn([T; N])`
// indexed in the body (`u[0]`). The closure body's array param previously
// lowered to an LLVM array *aggregate* value, so the body's `u[i]` GEP'd a
// non-pointer (MLIR verify fail). Closures now pass array params by pointer —
// matching the plain-fn ABI (make_fn_type) — and register the element type so
// the GEP strides correctly.
package closures_array_param;

fn bar<F>(f: F) -> i64 where F: Fn([i64; 1]) -> i64 {
    return f([2i64]);
}

fn bar2<F>(f: F) -> i64 where F: Fn([i64; 2]) -> i64 {
    return f([10i64, 20i64]);
}

fn main() -> i32 {
    // Non-capturing closure (fn-ptr path).
    if bar(|u| -> i64 { return u[0]; }) != 2i64 { return 1i32; }
    // Capturing closure (env path).
    let base: i64 = 5i64;
    if bar2(|u| -> i64 { return u[0] + u[1] + base; }) != 35i64 { return 2i32; }
    return 0i32;
}
