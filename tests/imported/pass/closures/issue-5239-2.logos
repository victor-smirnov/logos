// Original path: tests/ui/closures/issue-5239-2.rs
// Modifications: literal suffixes (`10isize`); otherwise faithful —
// `|ref x: isize| { *x }` is admitted (C5-cl-03 closed 2026-05-11)
// and `*x` dereferences the synth ref. Sema rewrites the closure
// param to a synth-named by-value slot + a body-prologue `let x =
// &synth;` so the user code sees `x: &isize`.
package issue_5239_2;

use std.fmt;
use std.lang.text;

fn main() -> i32 {
    let f = |ref x: isize| -> isize { return *x; };
    let foo: isize = 10isize;
    assert_eq!(f(foo), 10isize);
    return 0;
}
