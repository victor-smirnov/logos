// Modifications: a closure whose parameter uses a `ref x` binding pattern, then
// dereferences it `*x` in the body. Tests a by-ref binding pattern in a closure
// parameter position. isize→i64, assert_eq!→return code.
package closure_ref_param_pattern_cl3;

fn main() -> i32 {
    let f = |ref x: i64| { return *x; };
    let foo: i64 = 10i64;
    if f(foo) != 10i64 { return 1i32; }
    return 0i32;
}
