package once_move_out_on_heap;

use logos.std.fmt;

fn foo<F>(blk: F) where F: FnOnce() -> i64 {
    let r = blk();
    assert!(r == 42i64);
}

fn main() -> i32 {
    let x: i64 = 42i64;
    foo(move || -> i64 { return x; });
    return 0;
}
