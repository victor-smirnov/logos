package closure_explicit_param_ret_types_cl3;

fn as_buf<F>(s: i64, f: F) -> i64 where F: FnOnce(i64) -> i64 { return f(s); }

fn main() -> i32 {
    let r = as_buf(7i64, |x: i64| -> i64 { return x + 1i64; });
    if r != 8i64 { return 1i32; }
    return 0i32;
}
