// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/tuple/ (tuple return + destructuring-let).
// Modifications: isize->i64; assert->if-return. Tests a fn returning a
// 2-tuple consumed by a destructuring `let (lo, hi) = f(..)`, exercising
// both branches of the producer.
package tuple_return_destructure_tp2;

fn minmax(a: i64, b: i64) -> (i64, i64) {
    if a < b { return (a, b); }
    return (b, a);
}

fn main() -> i32 {
    let (lo, hi) = minmax(8i64, 3i64);
    if lo != 3i64 { return 1i32; }
    if hi != 8i64 { return 2i32; }
    let (lo2, hi2) = minmax(2i64, 9i64);
    if lo2 != 2i64 { return 3i32; }
    if hi2 != 9i64 { return 4i32; }
    return 0i32;
}
