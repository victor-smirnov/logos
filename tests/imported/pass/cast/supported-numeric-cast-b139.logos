// Modifications: println! -> value asserts (-> nonzero ret); isize/usize ->
//   i64/u64; the raw-pointer casts (`1_usize as *const String`, `f as i8`, ...)
//   dropped (the int<->int<->float numeric grid is the runnable part); literals
