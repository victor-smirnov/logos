package cast_char_int_chains_b160;

fn main() -> i32 {
    let i: i64 = 'Q' as i64;
    if i != 0x51i64 { return 1i32; }
    let u: u32 = i as u32;
    if u != (0x51i64 as u32) { return 2i32; }
    if u != ('Q' as u32) { return 3i32; }
    if (i as u8) != ('Q' as u8) { return 4i32; }
    if (i as u8 as i8) != ('Q' as u8 as i8) { return 5i32; }
    if (0x51u32 as char) != 'Q' { return 6i32; }
    if (0u32) != (false as u32) { return 7i32; }
    return 0i32;
}
