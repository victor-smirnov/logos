// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/cast/cast-does-fallback.rs
// Modifications: numeric literal suffixes (`42u8`, `4u8`, `512i32`)
// added since Logos type-inference is more local than Rust's. Other
// than that, original shape preserved after C6-cc-01 (Sprint 1.6)
// and C6-cc-04 (Sprint 2) closed.
package cast_does_fallback;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    // Test that these type check correctly.
    let _ = (&42u8 >> 4u8) as usize;
    let _ = (&42u8 << 4u8) as usize;

    let cap: i32 = 512i32 * 512i32;
    let _ = cap as u8;
    // Assert `cap` did not get inferred to `u8` and overflowed.
    assert_ne!(cap, 0i32);
    return 0;
}
