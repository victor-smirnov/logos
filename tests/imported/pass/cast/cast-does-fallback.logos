// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/cast/cast-does-fallback.rs
// Modifications: `(&42u8 >> 4) as usize` becomes `(42u8 >> 4) as usize`
// — Logos doesn't yet implement auto-deref of `&u8` to `u8` at a
// shift-op site (tracked as a small surface gap).
package cast_does_fallback;

use std.fmt;
use std.lang.text;

fn main() -> i32 {
    let _ = (42u8 >> 4u8) as usize;
    let _ = (42u8 << 4u8) as usize;

    let cap: i32 = 512i32 * 512i32;
    let _ = cap as u8;
    // Assert `cap` did not get inferred to `u8` and overflowed.
    assert_ne!(cap, 0i32);
    return 0;
}
