// Tests casting a (u8 + u8) sum to char and comparing it to the NUL char.
package u8_to_char_cast_b135;

fn main() -> i32 {
    let c: char = (0u8 + 0u8) as char;
    if c != '\0' { return 1i32; }
    return 0i32;
}
