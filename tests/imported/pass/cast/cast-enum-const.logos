// Modifications: Logos accepts `enum E { V = N }` discriminant
// initialisation with an integer literal; using a top-level `const`
// as the discriminant value is a tracked grammar gap, so the
// discriminant is `5` directly. The test still checks the
// `enum-variant → integer` cast.
package cast_enum_const;

use std.fmt;
use std.lang.text;

enum Stuff { Bar = 5 }

fn main() -> i32 {
    assert_eq!(Stuff::Bar as isize, 5isize);
    return 0;
}
