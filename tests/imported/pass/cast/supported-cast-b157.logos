// Original path: tests/ui/cast/supported-cast.rs
// Numeric `as` casts across the integer/float widths. Upstream just prints each
// cast; here a representative subset is verified by value (round-trip + sign +
// width-narrowing semantics).
// Modifications: isize/usize->i64/u64; pointer casts dropped (raw-ptr-to-int
// printing not the point); println! -> sentinel checks; literals suffixed;
// float literals written with a decimal point (`1.0f32`, not `1f32` — Logos's
// lexer requires the point).
package supported_cast_b157;

fn main() -> i32 {
    if (1i8 as i64) != 1i64 { return 1i32; }
    if (1i8 as u8) != 1u8 { return 2i32; }
    if (1u8 as i32) != 1i32 { return 3i32; }
    if (300i32 as u8) != 44u8 { return 4i32; }      // 300 mod 256
    if (1u16 as u64) != 1u64 { return 5i32; }
    if (1i64 as i8) != 1i8 { return 6i32; }
    if (1.0f32 as i32) != 1i32 { return 7i32; }
    if (1.0f64 as u32) != 1u32 { return 8i32; }
    if (1i32 as f32) != 1.0f32 { return 9i32; }
    if (1u64 as f64) != 1.0f64 { return 10i32; }
    if (true as i32) != 1i32 { return 11i32; }
    if (false as u8) != 0u8 { return 12i32; }
    if (1.9f64 as i32) != 1i32 { return 13i32; }    // truncates toward zero
    return 0i32;
}
