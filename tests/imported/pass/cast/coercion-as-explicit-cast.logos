package m_coercion_as_explicit_cast;

fn main() -> i32 {
    // Numeric
    let _a = 42i32 as i32;
    let _b = 42u8 as u8;

    // & to *const
    let x: &u32 = &42u32;
    let _c = x as *const u32;

    // &mut to *mut
    let mut m: u32 = 42u32;
    let xm: &mut u32 = &mut m;
    let _d = xm as *mut u32;
    return 0;
}
