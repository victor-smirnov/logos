// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/cast/cast.rs
// Modifications: trimmed to the char↔integer + integer-narrowing cases
// — the `0 as u32, false as u32` and the slice-to-raw-ptr `as *const _`
// tail need bool-as-int + `_`-target inference (not exercised here).
package cast_main;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    let i: isize = 'Q' as isize;
    assert_eq!(i, 0x51isize);
    let u: u32 = i as u32;
    assert_eq!(u, 0x51u32);
    assert_eq!(u, 'Q' as u32);
    assert_eq!(i as u8, 'Q' as u8);
    assert_eq!(i as u8 as i8, 'Q' as u8 as i8);
    return 0;
}
