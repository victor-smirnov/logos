// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/autoref-autoderef/deref-chain-method-calls-13264.rs
// Modifications: a two-level Deref chain `Root -> JSRef -> Node` with method
//   calls that autoderef through the chain. Logos `Deref<Target>` trait form;
//   raw `*const Node` indirection dropped (JSRef holds a Node by value); the
//   methods mutate a `*mut i64` counter so the dispatch is observable instead of
//   println!; isize → i64; `&self` → `self: &Self`.
// Tests method calls that autoderef through a user `Deref` chain of depth 2.
package deref_chain_method_calls_b161;

use logos.lang.ops;

struct Node { c: *mut i64 }
impl Node {
    fn ping(self: &Self) { unsafe { *self.c = *self.c + 1i64; } }
}

struct JSRef { node: Node }
impl Deref<Node> for JSRef {
    fn deref(self: &Self) -> &Node { return &self.node; }
}

struct Root { jsref: JSRef }
impl Deref<JSRef> for Root {
    fn deref(self: &Self) -> &JSRef { return &self.jsref; }
}

fn main() -> i32 {
    let mut counter: i64 = 0i64;
    let c = &mut counter as *mut i64;
    let n = Node { c: c };
    let jsref = JSRef { node: n };
    let root = Root { jsref: jsref };
    // root derefs to JSRef, then to Node, then .ping()
    root.ping();
    unsafe { if *c != 1i64 { return 1i32; } }
    return 0i32;
}
