// Tests matching a struct-variant enum value and binding its named field, with a tuple-variant
// arm present (so dispatch must pick the right variant).
package struct_variant_xc_match_b143;

enum E { Variant(i64), StructVariant { arg: i64 } }

fn main() -> i32 {
    let e: E = E::StructVariant { arg: 42i64 };
    let arg: i64 = match e {
        E::Variant(_) => { 0i64 - 1i64 }
        E::StructVariant { arg } => { arg }
    };
    if arg != 42i64 { return 1i32; }
    return 0i32;
}
