// Tests that a `type` alias of a struct can be used as a struct-literal
//   constructor and the value matched/read field-by-field.
package struct_aliases_b139;

struct S { x: i64, y: i64 }
type S2 = S;

fn main() -> i32 {
    let s = S2 { x: 1i64, y: 2i64 };
    match s {
        S { x: x, y: y } => {
            if x != 1i64 { return 1i32; }
            if y != 2i64 { return 2i32; }
        }
    }
    return 0i32;
}
