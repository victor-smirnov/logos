// Tests destructuring a tuple-struct in a `let` (`let Foo(y, z) = x`) and in a `match` arm (`Foo(a, b)`).
package tuple_struct_destructuring_b148;

struct Foo(i64, i64);

fn main() -> i32 {
    let x = Foo(1i64, 2i64);
    let Foo(y, z) = x;
    if y != 1i64 { return 1i32; }
    if z != 2i64 { return 2i32; }

    let w = Foo(1i64, 2i64);
    match w {
        Foo(a, b) => {
            if a != 1i64 { return 3i32; }
            if b != 2i64 { return 4i32; }
        }
    }
    return 0i32;
}
