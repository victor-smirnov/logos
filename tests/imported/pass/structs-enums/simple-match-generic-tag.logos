package se_simple_match_generic_tag;

enum Opt<X> { None, Some(X) }

fn main() -> i32 {
    let x: Opt<i64> = Opt::None;
    match x {
        Opt::None => { return 0; }
        Opt::Some(_) => { return 1; }
    }
}
