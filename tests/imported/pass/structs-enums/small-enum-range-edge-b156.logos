package small_enum_range_edge_b156;

enum Eu { Lu = 0, Hu = 255 }
enum Es { Ls = -128, Hs = 127 }

fn main() -> i32 {
    if (Eu::Hu as u8).wrapping_add(1u8) != (Eu::Lu as u8) { return 1i32; }
    if (Es::Hs as i8).wrapping_add(1i8) != (Es::Ls as i8) { return 2i32; }
    if (Eu::Lu as u8) != 0u8 { return 3i32; }
    if (Eu::Hu as u8) != 255u8 { return 4i32; }
    if (Es::Ls as i8) != -128i8 { return 5i32; }
    if (Es::Hs as i8) != 127i8 { return 6i32; }
    return 0i32;
}
