// Original path: tests/ui/structs-enums/enum-discr.rs
// Modifications: `usize`/`isize` casts→`i64`; `assert_eq!`→return-code checks;
// `pub fn main()`→`fn main()->i32`. Exercises explicit enum discriminants
// (positive and negative) read back via `as i64`.
package se_enum_discr;

enum Animal { Cat = 0, Dog = 1, Horse = 2, Snake = 3 }
enum Hero { Batman = -1, Superman = -2, Ironman = -3, Spiderman = -4 }

fn main() -> i32 {
    let pet = Animal::Snake;
    let hero = Hero::Superman;
    if (pet as i64) != 3i64 { return 1; }
    if (hero as i64) != -2i64 { return 2; }
    return 0;
}
