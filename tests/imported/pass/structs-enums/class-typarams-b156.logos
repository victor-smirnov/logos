package class_typarams_b156;

struct Cat<U> { meows: u64, how_hungry: i64, seed: U }

impl<U> Cat<U> {
    fn speak(self: &mut Self) { self.meows += 1u64; }
    fn meow_count(self: &mut Self) -> u64 { return self.meows; }
}

fn make_cat<U>(in_x: u64, in_y: i64, s: U) -> Cat<U> {
    return Cat { meows: in_x, how_hungry: in_y, seed: s };
}

fn main() -> i32 {
    let mut nyan: Cat<i64> = make_cat::<i64>(52u64, 99i64, 0i64);
    if nyan.how_hungry != 99i64 { return 1i32; }
    nyan.speak();
    if nyan.meow_count() != 53u64 { return 2i32; }
    return 0i32;
}
