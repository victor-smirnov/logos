package numeric_fields_b157;

struct S(u8, u16);

fn main() -> i32 {
    let s: S = S { 1: 10u16, 0: 11u8 };
    match s {
        S(a, b) => {
            if a != 11u8 { return 1i32; }
            if b != 10u16 { return 2i32; }
        }
    }
    return 0i32;
}
