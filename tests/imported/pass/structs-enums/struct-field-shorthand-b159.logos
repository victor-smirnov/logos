// Tests struct-literal field-init shorthand: `Foo { x, y: y, z }` (mixed
//   shorthand + explicit), trailing-comma shorthand `Bar { x, }`, and
//   out-of-order shorthand `Foo { z, y, x }`.
package struct_field_shorthand_b159;

struct Foo { x: i32, y: bool, z: i32 }
struct Bar { x: i32 }

fn main() -> i32 {
    let x = 1i32;
    let y = true;
    let z = 2i32;

    let a = Foo { x, y: y, z };
    if a.x != x { return 1i32; }
    if a.y != y { return 2i32; }
    if a.z != z { return 3i32; }

    let b = Bar { x, };
    if b.x != x { return 4i32; }

    let c = Foo { z, y, x };
    if c.x != x { return 5i32; }
    if c.y != y { return 6i32; }
    if c.z != z { return 7i32; }

    return 0i32;
}
