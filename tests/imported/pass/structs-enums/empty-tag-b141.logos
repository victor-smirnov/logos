package empty_tag_b141;

enum Chan { ChanT }

impl Chan {
    fn eq(self: &Chan, other: &Chan) -> bool {
        return (*self as i64) == (*other as i64);
    }
}

fn wrapper3(i: Chan) -> bool {
    return i.eq(&Chan::ChanT);
}

fn main() -> i32 {
    let wrapped = || { return wrapper3(Chan::ChanT); };
    if !wrapped() { return 1i32; }
    return 0i32;
}
