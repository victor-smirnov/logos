package se_small_enum_range_edge;

enum Eu { Lu = 0, Hu = 255 }
enum Es { Ls = -128, Hs = 127 }

fn main() -> i32 {
    if (Eu::Lu as u8) != 0u8 { return 1i32; }
    if (Eu::Hu as u8) != 255u8 { return 2i32; }
    if (Es::Hs as i8) != 127i8 { return 3i32; }
    if (Es::Ls as i64) != (0i64 - 128i64) { return 4i32; }
    return 0i32;
}
