// Tests struct functional-update syntax `Point { x: .., .. origin }` (one field given, rest from base).
package rec_extend_b148;

struct Point { x: i64, y: i64 }

fn main() -> i32 {
    let origin: Point = Point { x: 0i64, y: 0i64 };
    let right: Point = Point { x: origin.x + 10i64, .. origin };
    let up: Point = Point { y: origin.y + 10i64, .. origin };
    if origin.x != 0i64 { return 1i32; }
    if origin.y != 0i64 { return 2i32; }
    if right.x != 10i64 { return 3i32; }
    if right.y != 0i64 { return 4i32; }
    if up.x != 0i64 { return 5i32; }
    if up.y != 10i64 { return 6i32; }
    return 0i32;
}
