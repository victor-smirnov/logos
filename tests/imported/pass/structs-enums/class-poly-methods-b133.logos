// Modifications: isize/usize->i64/u64; `Vec::new`->`vec_new`; the constructor
// free fn renamed `make_cat` (Logos has no fn/type same-name shadowing); a
// method-level type param `speak<T>` is preserved over the struct type param.
// Tests a generic struct `Cat<U>` with a method-level-generic `speak<T>` and a
// `&mut self` mutator + reader, instantiated at U=i64. (`Vec::len`->`length`.)
package class_poly_methods_b133;

use logos.mem.collections.vec;

struct Cat<U> {
    info: Vec<U>,
    meows: u64,
    how_hungry: i64,
}

impl<U> Cat<U> {
    fn speak<T>(&mut self, stuff: Vec<T>) {
        (*self).meows = (*self).meows + (stuff.length() as u64);
    }
    fn meow_count(&mut self) -> u64 { return (*self).meows; }
}

fn make_cat<U>(in_x: u64, in_y: i64, in_info: Vec<U>) -> Cat<U> {
    return Cat { meows: in_x, how_hungry: in_y, info: in_info };
}

fn main() -> i32 {
    let mut info: Vec<i64> = vec_new::<i64>();
    info.push(9i64);
    let mut nyan: Cat<i64> = make_cat::<i64>(52u64, 99i64, info);
    if nyan.how_hungry != 99i64 { return 1i32; }
    let mut stuff: Vec<i64> = vec_new::<i64>();
    stuff.push(1i64);
    stuff.push(2i64);
    stuff.push(3i64);
    nyan.speak::<i64>(stuff);
    if nyan.meow_count() != 55u64 { return 2i32; }
    return 0i32;
}
