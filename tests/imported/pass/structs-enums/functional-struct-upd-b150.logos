//   updated fields via exit-code checks.
// Tests functional struct-update syntax `Foo { x: 4, .. a }` — overriding one
//   field while inheriting the rest from another struct value.
package functional_struct_upd_b150;

struct Foo {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    let a = Foo { x: 1, y: 2 };
    let c = Foo { x: 4, .. a };
    if c.x != 4 { return 1; }
    if c.y != 2 { return 2; }
    return 0;
}
