// Tests an enum with STRUCT-shaped variants (named fields), constructed and
//   matched with field bindings.
package enum_struct_variant_b164;

enum Event {
    Click { x: i64, y: i64 },
    Scroll { delta: i64 },
    Close,
}

fn handle(e: Event) -> i64 {
    match e {
        Event::Click { x, y } => { return x + y; }
        Event::Scroll { delta } => { return delta * 2i64; }
        Event::Close => { return -1i64; }
    }
}

fn main() -> i32 {
    if handle(Event::Click { x: 3i64, y: 4i64 }) != 7i64 { return 1i32; }
    if handle(Event::Scroll { delta: 5i64 }) != 10i64 { return 2i32; }
    if handle(Event::Close) != -1i64 { return 3i32; }
    return 0i32;
}
