package se_expr_match_struct;

struct Rec { i: i64 }
enum Mood { Happy, Sad }

fn test_rec() -> i32 {
    let rs = match true { true => Rec { i: 100i64 }, false => Rec { i: -1i64 } };
    if rs.i != 100i64 { return 1; }
    return 0;
}

fn test_tag() -> i32 {
    let rs = match true { true => Mood::Happy, false => Mood::Sad };
    if (rs as i64) != (Mood::Happy as i64) { return 1; }
    return 0;
}

fn main() -> i32 {
    let e1 = test_rec();
    if e1 != 0 { return e1; }
    let e2 = test_tag();
    if e2 != 0 { return e2 + 10; }
    return 0;
}
