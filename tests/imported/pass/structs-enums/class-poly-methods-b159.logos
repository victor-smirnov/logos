// Tests a generic struct `Cat<U>` with a method-level-generic method
//   `speak<T>(&mut self, n: u64)` mutating a field, instantiated at i64.
package class_poly_methods_b159;

struct Cat<U> { info: U, meows: u64, how_hungry: i64 }

impl<U> Cat<U> {
    fn speak<T>(self: &mut Self, n: u64) {
        self.meows += n;
    }
    fn meow_count(self: &mut Self) -> u64 { return self.meows; }
}

fn make_cat<U>(in_x: u64, in_y: i64, in_info: U) -> Cat<U> {
    return Cat { meows: in_x, how_hungry: in_y, info: in_info };
}

fn main() -> i32 {
    let mut nyan: Cat<i64> = make_cat::<i64>(52u64, 99i64, 9i64);
    if nyan.how_hungry != 99i64 { return 1i32; }
    nyan.speak::<i64>(3u64);
    if nyan.meow_count() != 55u64 { return 2i32; }
    return 0i32;
}
