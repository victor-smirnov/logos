package borrow_tuple_fields_b135;

fn main() -> i32 {
    let x = (1i64, 2i64);
    let a = &x.0;
    let b = &x.0;
    if *a != 1i64 { return 1i32; }
    if *b != 1i64 { return 2i32; }

    let mut y = (1i64, 2i64);
    {
        let c = &y.0;
        let d = &mut y.1;
        *d = 5i64;
        if *c != 1i64 { return 3i32; }
    }
    if y.0 != 1i64 { return 4i32; }
    if y.1 != 5i64 { return 5i32; }
    return 0i32;
}
