package rec_struct_copy_se4;

struct Rect { x: i64, y: i64, w: i64, h: i64 }

fn f(r: Rect, x: i64, y: i64, w: i64, h: i64) -> bool {
    return r.x == x && r.y == y && r.w == w && r.h == h;
}

fn main() -> i32 {
    let r: Rect = Rect { x: 10i64, y: 20i64, w: 100i64, h: 200i64 };
    if r.x != 10i64 { return 1i32; }
    if r.h != 200i64 { return 2i32; }
    let r2: Rect = Rect { x: 10i64, y: 20i64, w: 100i64, h: 200i64 };
    if r2.x != 10i64 { return 3i32; }
    if !f(r, 10i64, 20i64, 100i64, 200i64) { return 4i32; }
    if !f(r2, 10i64, 20i64, 100i64, 200i64) { return 5i32; }
    return 0i32;
}
