package se_empty_tag;

enum Chan { ChanT }

impl PartialEq for Chan {
    fn eq(self: &Chan, other: &Chan) -> bool {
        return ((*self) as u64) == ((*other) as u64);
    }
    fn ne(self: &Chan, other: &Chan) -> bool { return !(*self).eq(other); }
}

fn wrapper3(i: Chan) -> i32 {
    if i != Chan::ChanT { return 1i32; }
    return 0i32;
}

fn main() -> i32 {
    let wrapped = || { return wrapper3(Chan::ChanT); };
    return wrapped();
}
