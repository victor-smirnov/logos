// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/codegen/issue-16602-2.rs (run-pass analogue)
// Modifications: `pub fn main()`→`fn main()->i32`; literals suffixed; a
// return-code check replaces the implicit no-panic. Exercises whole-struct
// reassignment where the RHS reads the OLD field values:
//   a = A { x: a.y * 2, y: a.x * 2 }
// The struct memcpy rebind in gen_assign must materialise the full RHS struct
// from the old values BEFORE overwriting the slot (companion to G172-5's array
// reassignment case).
package se_struct_reassign;

struct A { x: u32, y: u32 }

fn main() -> i32 {
    let mut a: A = A { x: 1u32, y: 1u32 };
    a = A { x: a.y * 2u32, y: a.x * 2u32 };
    if a.x != 2u32 { return 1i32; }
    if a.y != 2u32 { return 2i32; }
    return 0i32;
}
