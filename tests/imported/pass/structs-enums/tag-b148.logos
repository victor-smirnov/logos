// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/structs-enums/tag.rs
// Modifications: isize→i64; PartialEq hand-impl kept (`self:&colour`, `match *self`); assert!→nonzero return.
// Tests a hand-written PartialEq for an enum with a payload variant and a nullary variant, using
//   nested `match *self`/`match *other`. (`Red(..)` rest → `Red(_, _)`: `..` in a tuple-variant
//   pattern is a known-open parse gap, B147.)
package tag_b148;

enum Colour { Red(i64, i64), Green }

impl PartialEq for Colour {
    fn eq(self: &Colour, other: &Colour) -> bool {
        match *self {
            Colour::Red(a0, b0) => {
                match *other {
                    Colour::Red(a1, b1) => a0 == a1 && b0 == b1,
                    Colour::Green => false,
                }
            }
            Colour::Green => {
                match *other {
                    Colour::Red(_, _) => false,
                    Colour::Green => true,
                }
            }
        }
    }
    fn ne(self: &Colour, other: &Colour) -> bool { !(*self).eq(other) }
}

fn main() -> i32 {
    let x = Colour::Red(1i64, 2i64);
    let y = Colour::Green;
    if x == y { return 1i32; }
    return 0i32;
}
