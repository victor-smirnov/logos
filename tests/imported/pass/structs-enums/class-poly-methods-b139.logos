package class_poly_methods_b139;

struct Cat<U> { val: U, meows: u64, how_hungry: i64 }

impl<U> Cat<U> {
    fn speak<T>(self: &mut Cat<U>, _n: T) where T: Copy {
        self.meows = self.meows + 3u64;
    }
    fn meow_count(self: &mut Cat<U>) -> u64 { self.meows }
}

fn main() -> i32 {
    let mut nyan: Cat<i64> = Cat { val: 9i64, meows: 52u64, how_hungry: 99i64 };
    if nyan.how_hungry != 99i64 { return 1i32; }
    nyan.speak(7i64);
    if nyan.meow_count() != 55u64 { return 2i32; }
    return 0i32;
}
