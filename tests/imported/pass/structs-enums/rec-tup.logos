// Original path: tests/ui/structs-enums/rec-tup.rs
// Modifications: `isize`→`i64`; `#[derive(Copy, Clone)]` dropped; `type rect =
// (Point, Point)` kept as a tuple type alias; `assert_eq!`→return-code checks;
// `pub fn main()`→`fn main()->i32`. To avoid relying on tuple Copy, each fst/snd
// re-extracts from a freshly built tuple. Exercises a tuple of two structs,
// destructured in fns and indexed via `.x`/`.y`.
package se_rec_tup;

struct Point { x: i64, y: i64 }
type Rect = (Point, Point);

fn fst(r: Rect) -> Point { let (a, _) = r; return a; }
fn snd(r: Rect) -> Point { let (_, b) = r; return b; }

fn main() -> i32 {
    let r: Rect = (Point { x: 10i64, y: 20i64 }, Point { x: 11i64, y: 22i64 });
    if fst(r).x != 10i64 { return 1; }
    let r2: Rect = (Point { x: 10i64, y: 20i64 }, Point { x: 11i64, y: 22i64 });
    if fst(r2).y != 20i64 { return 2; }
    let r3: Rect = (Point { x: 10i64, y: 20i64 }, Point { x: 11i64, y: 22i64 });
    if snd(r3).x != 11i64 { return 3; }
    let r4: Rect = (Point { x: 10i64, y: 20i64 }, Point { x: 11i64, y: 22i64 });
    if snd(r4).y != 22i64 { return 4; }
    return 0;
}
