package se_issue_1701;

enum Pat { Tabby, Tortoiseshell, Calico }
enum Breed { Beagle, Rottweiler, Pug }
enum EarKind { Lop, Upright }
enum Animal { Cat(Pat), Dog(Breed), Rabbit(i64, EarKind), Tiger }

fn noise(a: Animal) -> i64 {
    match a {
        Animal::Cat(_) => { return 1i64; }
        Animal::Dog(_) => { return 2i64; }
        Animal::Rabbit(_, _) => { return 0i64; }
        Animal::Tiger => { return 3i64; }
    }
}

fn main() -> i32 {
    if noise(Animal::Cat(Pat::Tabby)) != 1i64 { return 1; }
    if noise(Animal::Dog(Breed::Pug)) != 2i64 { return 2; }
    if noise(Animal::Rabbit(7i64, EarKind::Upright)) != 0i64 { return 3; }
    if noise(Animal::Tiger) != 3i64 { return 4; }
    return 0;
}
