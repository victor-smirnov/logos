// Tests matching an enum struct-shaped variant `StructVariant { arg }` as a
//   match expression, extracting the named field, with a non-matching tuple
//   variant arm.
package struct_variant_match_b160;

enum Enum { Variant(i64), StructVariant { arg: i64 } }

fn main() -> i32 {
    let arg = match (Enum::StructVariant { arg: 42i64 }) {
        Enum::Variant(_) => { -1i64 }
        Enum::StructVariant { arg } => { arg }
    };
    if arg != 42i64 { return 1i32; }
    return 0i32;
}
