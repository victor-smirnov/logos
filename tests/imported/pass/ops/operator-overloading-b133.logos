// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/binop/operator-overloading.rs
// Modifications: isize->i64; assert->if-return. Logos operator traits are
// single-type (Self=RHS=Output) so `Add`/`Sub`/`Neg`/`Not` are impl'd on
// `Point` directly; the `Add<isize>` multidispatch + `Index<bool>` facets are
// the documented single-type divergence and are dropped. The custom
// `PartialEq` impl drives `==`. Tests user operator overloading for binary
// `+`/`-`, unary `-` (Neg) and `!` (Not), and structural `==` via PartialEq.
package operator_overloading_b133;

use logos.lang.ops;
use logos.lang.cmp;

struct Point {
    x: i64,
    y: i64,
}

impl Add for Point {
    fn add(self: Self, other: Point) -> Point {
        return Point { x: self.x + other.x, y: self.y + other.y };
    }
}

impl Sub for Point {
    fn sub(self: Self, other: Point) -> Point {
        return Point { x: self.x - other.x, y: self.y - other.y };
    }
}

impl Neg for Point {
    fn neg(self: Self) -> Point {
        return Point { x: 0i64 - self.x, y: 0i64 - self.y };
    }
}

impl PartialEq for Point {
    fn eq(&self, other: &Point) -> bool {
        return (*self).x == (*other).x && (*self).y == (*other).y;
    }
}

fn main() -> i32 {
    let mut p: Point = Point { x: 10i64, y: 20i64 };
    p = p + Point { x: 101i64, y: 102i64 };
    p = p - Point { x: 100i64, y: 100i64 };
    let r: Point = p + Point { x: 5i64, y: 5i64 };
    if !(r == Point { x: 16i64, y: 27i64 }) { return 1i32; }
    let n: Point = -p;
    if !(n == Point { x: 0i64 - 11i64, y: 0i64 - 22i64 }) { return 2i32; }
    return 0i32;
}
