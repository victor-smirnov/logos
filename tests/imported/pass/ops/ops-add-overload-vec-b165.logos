package ops_add_overload_vec_b165;

use logos.lang.ops;

struct V2 { x: i64, y: i64 }
impl Add<V2> for V2 {
    type Output = V2;
    fn add(self: Self, rhs: V2) -> V2 { return V2 { x: self.x + rhs.x, y: self.y + rhs.y }; }
}
fn main() -> i32 {
    let a = V2 { x: 1i64, y: 2i64 };
    let b = V2 { x: 3i64, y: 4i64 };
