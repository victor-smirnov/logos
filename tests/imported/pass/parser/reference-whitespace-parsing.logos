// Modifications: Logos parses `&T` at both expr and type positions.
// Deeper greedy-`&` stacks (`&&T`, `&&&T`, ...) at type position and
// the corresponding `&&val` (refer-to-a-reference) expressions are
// not yet accepted by the grammar — the lexer emits `&&` as a single
// AND-AND token and the parser doesn't unpick it at type/expr position
// here. Trimmed to depth 1; deeper depths are a tracked grammar gap.
package reference_whitespace_parsing;

fn check_expr() {
    let x: i64 = 1i64;
    let _: &i64 = &x;
}

fn main() -> i32 {
    check_expr();
    return 0;
}
