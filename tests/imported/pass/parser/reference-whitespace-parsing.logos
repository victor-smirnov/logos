// Original path: tests/ui/parser/reference-whitespace-parsing.rs
// Modifications: literals routed through named lets (C6-cc-04 is a
// deliberate divergence — Logos rejects `&<literal>` bound to a
// `let`). Pattern form (`let &x = …`) is exercised separately. The
// type-position depth-N greedy stack (`& & & & T` / `&&&&T`) now
// parses (P3-pg-01 closed 2026-05-11 via `ref_pointee <- ref_type / …`).
package reference_whitespace_parsing;

fn check_expr() {
    let n: usize = 1usize;
    let r1: &usize             = &n;
    let r2: &&usize            = &r1;
    let r3: &&&usize           = &r2;
    let r4: &&&&usize          = &r3;
    let r5: &&&&&usize         = &r4;

    let _: & usize             = r1;
    let _: & & usize           = r2;
    let _: & & & usize         = r3;
    let _: & & & & usize       = r4;
    let _: & & & & & usize     = r5;
}

fn check_ty() {
    let n: usize = 1usize;
    let r1: &usize             = &n;
    let r2: &&usize            = &r1;
    let r3: &&&usize           = &r2;
    let r4: &&&&usize          = &r3;
    let r5: &&&&&usize         = &r4;

    let _: &usize              = r1;
    let _: &&usize             = r2;
    let _: &&&usize            = r3;
    let _: & &&usize           = r3;
    let _: &&&&usize           = r4;
    let _: & &&&usize          = r4;
    let _: &&&&&usize          = r5;
}

fn main() -> i32 {
    check_expr();
    check_ty();
    return 0;
}
