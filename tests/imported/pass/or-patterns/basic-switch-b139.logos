// Tests a top-level or-pattern arm over an enum lowered to a switch.
package basic_switch_b139;

enum Test { Foo, Bar, Baz, Qux }

fn test(x: Test) -> bool {
    match x {
        Test::Bar | Test::Qux => true,
        _ => false
    }
}

fn main() -> i32 {
    if test(Test::Foo) { return 1i32; }
    if !test(Test::Bar) { return 2i32; }
    if test(Test::Baz) { return 3i32; }
    if !test(Test::Qux) { return 4i32; }
    return 0i32;
}
