package or_pattern_shared_binding_b163;

fn bucket(n: i64) -> i64 {
    match n {
        0i64 | 1i64 | 2i64 => { return 100i64; }
        3i64 | 4i64 => { return 200i64; }
        x if x < 0i64 => { return -1i64; }
        _ => { return 300i64; }
    }
}

fn main() -> i32 {
    if bucket(0i64) != 100i64 { return 1i32; }
    if bucket(2i64) != 100i64 { return 2i32; }
    if bucket(4i64) != 200i64 { return 3i32; }
    if bucket(-5i64) != -1i64 { return 4i32; }
    if bucket(99i64) != 300i64 { return 5i32; }
    return 0i32;
}
