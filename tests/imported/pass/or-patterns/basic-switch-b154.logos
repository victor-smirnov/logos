package basic_switch_b154;

use logos.lang.option;

enum Test { Foo, Bar, Baz, Qux }

fn test(x: Option<Test>) -> bool {
    match x {
        Some(Test::Bar | Test::Qux) => true,
        Some(_) => false,
        None => false,
    }
}

fn main() -> i32 {
    if test(Some(Test::Foo)) { return 1i32; }
    if !test(Some(Test::Bar)) { return 2i32; }
    if test(Some(Test::Baz)) { return 3i32; }
    if !test(Some(Test::Qux)) { return 4i32; }
    if test(None) { return 5i32; }
    return 0i32;
}
