package static_function_pointer_b145;

fn f(x: i64) -> i64 { return x; }
fn g(x: i64) -> i64 { return 2i64 * x; }

fn main() -> i32 {
    let bigf: fn(i64) -> i64 = f;
    if bigf(42i64) != 42i64 { return 1i32; }

    let mut bigg: fn(i64) -> i64 = f;
    if bigg(42i64) != 42i64 { return 2i32; }
    bigg = g;
    if bigg(42i64) != 84i64 { return 3i32; }

    return 0i32;
}
