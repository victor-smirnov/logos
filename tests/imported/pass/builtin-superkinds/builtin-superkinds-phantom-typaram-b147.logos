package builtin_superkinds_phantom_typaram_b147;

trait Send2 {}
trait Foo: Send2 {}

struct X<T> { _marker: i64, _t: T }

impl<T: Send2> Send2 for X<T> {}
impl<T: Send2> Foo for X<T> {}

impl Send2 for i64 {}

fn use_foo<F: Foo>(_f: F) {}

fn main() -> i32 {
    let x = X { _marker: 0i64, _t: 5i64 };
    use_foo(x);
    return 0i32;
}
