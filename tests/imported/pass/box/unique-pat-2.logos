package m_box_unique_pat_2;

struct Foo { a: i64, b: u64 }
enum Bar { U(Foo), W(i64) }

fn main() -> i32 {
    let v = match Bar::U(Foo { a: 10i64, b: 40u64 }) {
        Bar::U(f) => { f.a + (f.b as i64) },
        Bar::W(_) => { 66i64 },
    };
    if v != 50i64 { return 1; }
    return 0;
}
