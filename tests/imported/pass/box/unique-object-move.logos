package m_box_unique_object_move;

trait EventLoop {
    fn foo(&self) -> i64 { return 0i64; }
}

struct UvEventLoop { uvio: i64 }

impl EventLoop for UvEventLoop { }

fn main() -> i32 {
    let ev = UvEventLoop { uvio: 0i64 };
    let lp: &dyn EventLoop = &ev;
    let lp2 = lp;
    if lp2.foo() != 0i64 { return 1; }
    return 0;
}
