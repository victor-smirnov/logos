// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/pattern/bindings-after-at/ shapes (distilled).
// Modifications: isize->i64; assert->if-return sentinels. The `name @ subpattern`
//   binding form at TOP level of a match scrutinee: bind the whole value while
//   ALSO matching its structure (integer range pattern). The enum-payload-nested
//   `@`-binding facet (`Msg::Num(n @ 1..=5)`) is DROPPED — nested patterns inside
//   enum-variant payloads are not yet supported (G162-1); covered separately by a
//   body-side range check.
// Tests top-level `@`-bindings: `n @ 1..=5` range capture and a `_`-fallback.
package binding_at_pattern_b162;

fn band(v: i64) -> i64 {
    match v {
        x @ 0i64..=9i64 => { return 1000i64 + x; }
        x @ 10i64..=99i64 => { return 2000i64 + x; }
        x => { return x; }
    }
}

fn main() -> i32 {
    if band(3i64) != 1003i64 { return 1i32; }
    if band(42i64) != 2042i64 { return 2i32; }
    if band(500i64) != 500i64 { return 3i32; }
    return 0i32;
}
