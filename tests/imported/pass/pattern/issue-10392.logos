package issue_10392;

use logos.lang.option;

struct A { foo: isize }
struct B { a: isize, b: isize, c: isize }

fn mka() -> A { return A { foo: 1isize }; }
fn mkb() -> B { return B { a: 1isize, b: 2isize, c: 3isize }; }

fn test() {
    let A { foo, }     = mka();
    let _ = foo;
    let A { foo, }     = mka();
    let _ = foo;
    let B { a, b, c, } = mkb();
    let _ = a;
    let _ = b;
    let _ = c;

    match mka() {
        A { foo: _foo, } => { }
    }

    match Option::Some::<A>(mka()) {
        Option::Some(A { foo: _foo, }) => { }
        Option::None => { }
    }
}

fn main() -> i32 {
    if false { test(); }
    return 0;
}
