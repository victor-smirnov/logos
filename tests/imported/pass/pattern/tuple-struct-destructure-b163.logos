package tuple_struct_destructure_b163;

struct Vec2(i64, i64);

fn len_sq(v: Vec2) -> i64 {
    let Vec2(x, y) = v;
    return x * x + y * y;
}

fn quadrant(v: Vec2) -> i64 {
    match v {
        Vec2(0i64, 0i64) => { return 0i64; }
        Vec2(x, y) => {
            if x > 0i64 && y > 0i64 { return 1i64; }
            return 9i64;
        }
    }
}

fn main() -> i32 {
    if len_sq(Vec2(3i64, 4i64)) != 25i64 { return 1i32; }
    if quadrant(Vec2(0i64, 0i64)) != 0i64 { return 2i32; }
    if quadrant(Vec2(2i64, 5i64)) != 1i64 { return 3i32; }
    if quadrant(Vec2(-1i64, 3i64)) != 9i64 { return 4i32; }
    return 0i32;
}
