package issue_8351_2_b142;

enum E {
    Foo { f: i64, b: bool },
    Bar
}

fn main() -> i32 {
    let e: E = E::Foo { f: 0i64, b: false };
    match e {
        E::Foo { f: 1i64, b: true } => { return 1i32; }
        E::Foo { b: false, f: 0i64 } => {}
        _ => { return 2i32; }
    }
    return 0i32;
}
