// Imported from rust-lang/rust tests/ui/pattern/issue-8351-1.rs
// Modifications: `panic!()` arms replaced with concrete return codes;
// `isize` → `i64`; explicit literal suffixes added. Otherwise faithful
// — exercises P4-pm-01 struct-shape variants + refutable inner literal
// pattern (`E::Foo { f: 1 }`).
package issue_8351_1;

enum E {
    Foo { f: i64 },
    Bar,
}

fn main() -> i32 {
    let e = E::Foo { f: 0i64 };
    match e {
        E::Foo { f: 1i64 } => { return 1; }
        E::Foo { .. } => {}
        E::Bar => { return 2; }
    }
    return 0;
}
