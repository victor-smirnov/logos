// Match guards referencing two bindings from the pattern: `(a, b) if a == b`.
// isize->i64; struct scrutinee -> tuple; assert->return-code.
package guard_two_bindings_pat;
fn f(p: (i64, i64)) -> i64 {
    match p { (a, b) if a == b => 1i64, (a, b) if a < b => 2i64, _ => 3i64 }
}
fn main() -> i32 {
    if f((2i64, 2i64)) == 1i64 && f((1i64, 2i64)) == 2i64 && f((5i64, 1i64)) == 3i64 { return 0i32; }
    return 1i32;
}
