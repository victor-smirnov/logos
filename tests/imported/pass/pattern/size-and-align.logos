package m_size_and_align;

enum Clam<G> {
    A(G, i64),
    B,
}

fn uhoh(v: Clam<i64>) -> i32 {
    match v {
        Clam::A(_t, u) => {
            return 1;
        }
        Clam::B => { return 0; }
    }
}

fn main() -> i32 {
    let r0 = uhoh(Clam::<i64>::B);
    let r1 = uhoh(Clam::<i64>::B);
    let r2 = uhoh(Clam::<i64>::A(42i64, 17i64));
    if r0 != 0i32 { return 10; }
    if r1 != 0i32 { return 11; }
    if r2 != 1i32 { return 12; }
    return 0;
}
