// Match on `Result` binding both Ok and Err payloads. Prelude Result/Ok/Err.
// isize->i64; assert->return-code.
package match_result_pat;
fn f(r: Result<i64, i64>) -> i64 { match r { Ok(v) => v, Err(e) => -e } }
fn main() -> i32 {
    if f(Ok(5i64)) == 5i64 && f(Err(3i64)) == -3i64 { return 0i32; }
    return 1i32;
}
