// Enum struct-variant destructuring: `Shape::Rect { w, h }`. isize->i64; assert->return-code.
package enum_struct_variant_pat;
enum Shape { Circle { r: i64 }, Rect { w: i64, h: i64 } }
fn area(s: Shape) -> i64 {
    match s { Shape::Circle { r } => r * r * 3i64, Shape::Rect { w, h } => w * h }
}
fn main() -> i32 {
    if area(Shape::Rect { w: 3i64, h: 4i64 }) == 12i64 && area(Shape::Circle { r: 2i64 }) == 12i64 {
        return 0i32;
    }
    return 1i32;
}
