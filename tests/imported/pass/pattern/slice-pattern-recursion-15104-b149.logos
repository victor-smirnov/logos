package slice_pattern_recursion_15104_b149;
// Faithful port of rustc tests/ui/pattern/slice-pattern-recursion-15104.rs.
// G149-4: top-level dynamic-slice (`&[T]`) match with a NAMED rest binding
// (`xs @ ..`) recursing on the tail sub-slice. usize→i64; `match *v` → `match v`
// (Logos `&[T]` is the slice value); `ref xs @ ..` → `xs @ ..`.
fn count_members(v: &[i64]) -> i64 {
    match v {
        [] => { return 0; }
        [_] => { return 1; }
        [_, xs @ ..] => { return 1 + count_members(xs); }
    }
}
fn main() -> i64 {
    let a: [i64; 4] = [1, 2, 3, 4];
    if count_members(&a) != 4 { return 1; }
    return 0;
}
