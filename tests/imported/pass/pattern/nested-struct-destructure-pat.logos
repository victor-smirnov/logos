// Nested struct destructuring in a `let`: `let Outer { i: Inner { v }, k } = o`.
// u8->i64; ref-bindings dropped (by-value, irrefutable); assert->return-code.
package nested_struct_destructure_pat;
struct Inner { v: i64 }
struct Outer { i: Inner, k: i64 }
fn main() -> i32 {
    let o: Outer = Outer { i: Inner { v: 5i64 }, k: 2i64 };
    let Outer { i: Inner { v }, k } = o;
    if v + k == 7i64 { return 0i32; }
    return 1i32;
}
