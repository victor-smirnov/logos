// Exclusive-range patterns `0..5`. const-assoc-pattern halves dropped; literals suffixed.
package range_exclusive_pat;
fn f(n: i64) -> i64 { match n { 0i64..5i64 => 1i64, 5i64..10i64 => 2i64, _ => 0i64 } }
fn main() -> i32 {
    if f(3i64) == 1i64 && f(5i64) == 2i64 && f(10i64) == 0i64 { return 0i32; }
    return 1i32;
}
