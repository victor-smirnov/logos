// Tests inclusive-range patterns (`..=`) over integers and chars.
package inc_range_pat_b150;

fn main() -> i64 {
    let ok_i = match 42 { 0 ..= 100 => true, _ => false };
    if !ok_i { return 1; }
    let ok_c = match 'x' { 'a' ..= 'z' => true, _ => false };
    if !ok_c { return 2; }
    return 0;
}
