package pattern_binding_at_b164;

fn classify(n: i64) -> i64 {
    match n {
        0i64 => { return 0i64; }
        x @ 1i64 ..= 9i64 => { return x * 10i64; }
        big => { return big; }
    }
}

fn main() -> i32 {
    if classify(0i64) != 0i64 { return 1i32; }
    if classify(3i64) != 30i64 { return 2i32; }
    if classify(9i64) != 90i64 { return 3i32; }
    if classify(100i64) != 100i64 { return 4i32; }
    return 0i32;
}
