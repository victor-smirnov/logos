// Tests irrefutable wildcard patterns in `if let _ = e {}` and `while let _ = e {}`.
package irrefutable_let_patterns_b160;

fn main() -> i32 {
    if let _ = 5i64 {}

    let mut n = 0i64;
    while let _ = 5i64 {
        n = n + 1i64;
        break;
    }
    if n != 1i64 { return 1i32; }
    return 0i32;
}
