// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/pattern/usefulness/nested-exhaustive-match.rs
// Modifications: isize -> i64; arms return distinct codes so we exercise the
//   match value; Option from prelude.
// Tests exhaustive matching over a struct with a bool, an Option field, and a
//   trailing `..`, distinguishing all four (bool x Some/None) combinations.
package nested_exhaustive_match_b150;

struct Foo { foo: bool, bar: Option<i64>, baz: i64 }

fn classify(f: Foo) -> i64 {
    match f {
        Foo { foo: true, bar: Some(_), .. } => 0,
        Foo { foo: false, bar: None, .. } => 1,
        Foo { foo: true, bar: None, .. } => 2,
        Foo { foo: false, bar: Some(_), .. } => 3,
    }
}

fn main() -> i64 {
    return classify(Foo { foo: true, bar: Some(10), baz: 20 });
}
