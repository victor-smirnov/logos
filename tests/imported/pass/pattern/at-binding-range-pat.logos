// Binding-after-@ over an inclusive-range pattern: `x @ 1..=5`. literals suffixed.
package at_binding_range_pat;
fn f(n: i64) -> i64 { match n { x @ 1i64..=5i64 => x * 2i64, _ => 0i64 } }
fn main() -> i32 {
    if f(3i64) == 6i64 && f(1i64) == 2i64 && f(5i64) == 10i64 && f(9i64) == 0i64 { return 0i32; }
    return 1i32;
}
