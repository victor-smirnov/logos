package struct_variant_literal_field_8351_b140;

enum E {
    Foo { f: i64 },
    Bar,
}

fn main() -> i32 {
    let e: E = E::Foo { f: 0i64 };
    let r: i32 = match e {
        E::Foo { f: f } if f == 1i64 => 1i32,
        E::Foo { .. } => 0i32,
        E::Bar => 2i32,
    };
    return r;
}
