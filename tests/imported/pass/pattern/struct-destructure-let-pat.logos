// Struct destructuring in a `let` with field shorthand: `let P { x, y } = p`.
// isize->i64; trailing-comma form dropped; panic-on-other body elided; assert->return-code.
package struct_destructure_let_pat;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let p: P = P { x: 3i64, y: 4i64 };
    let P { x, y } = p;
    if x + y == 7i64 { return 0i32; }
    return 1i32;
}
