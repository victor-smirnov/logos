// Tests inclusive range patterns `0..=100` (int) and `'a'..='z'` (char) in match.
package inc_range_pat_b137;

fn main() -> i32 {
    let ok_int: bool = match 42i64 {
        0i64 ..= 100i64 => true,
        _ => false,
    };
    if !ok_int { return 1i32; }

    let ok_char: bool = match 'x' {
        'a' ..= 'z' => true,
        _ => false,
    };
    if !ok_char { return 2i32; }
    return 0i32;
}
