package m_const_pattern_str_match_lifetime;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn test(s: str) -> bool {
    let xpat = "12345";
    if s == xpat { return true; }
    return false;
}

fn main() -> i32 {
    assert!(test("12345"));
    return 0;
}
