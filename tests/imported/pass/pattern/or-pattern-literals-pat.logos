// Original path: tests/ui/pattern/issue-27320.rs (or-pattern shape)
// Or-pattern of literals in a single arm: `1 | 2 | 3`. macro_rules wrapper
// dropped (§A — macros via metaprog); the or-pattern feature kept. literals suffixed.
package or_pattern_literals_pat;
fn f(n: i64) -> i64 { match n { 1i64 | 2i64 | 3i64 => 10i64, _ => 0i64 } }
fn main() -> i32 {
    if f(1i64) == 10i64 && f(2i64) == 10i64 && f(3i64) == 10i64 && f(5i64) == 0i64 { return 0i32; }
    return 1i32;
}
