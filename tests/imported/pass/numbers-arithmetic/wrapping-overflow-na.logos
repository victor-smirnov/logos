package wrapping_overflow_na;

use logos.lang.arith;

fn main() -> i32 {
    // i32 MAX + 1 wraps to MIN
    let imax: i32 = 2147483647i32;
    let imin: i32 = -2147483648i32;
    if wrapping_add::<i32>(imax, 1i32) != imin { return 1i32; }
    // i32 MIN - 1 wraps to MAX
    if wrapping_sub::<i32>(imin, 1i32) != imax { return 2i32; }
    // i32 MAX * 2 == -2
    if wrapping_mul::<i32>(imax, 2i32) != -2i32 { return 3i32; }
    // u32 0 - 1 wraps to u32::MAX
    let umax: u32 = 4294967295u32;
    if wrapping_sub::<u32>(0u32, 1u32) != umax { return 4i32; }
    // u32 MAX + 1 wraps to 0
    if wrapping_add::<u32>(umax, 1u32) != 0u32 { return 5i32; }
    // wrapping negation of MIN is MIN (0 - MIN overflows back to MIN)
    if wrapping_sub::<i32>(0i32, imin) != imin { return 6i32; }
    return 0i32;
}
