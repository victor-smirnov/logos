// Imported from rust-lang/rust tests/ui/numbers-arithmetic/isize-base.rs
// Modifications: return_val lifted to module scope (already module-scope in orig).
package isize_base_test;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn return_val() -> isize {
    return 42isize;
}

fn main() -> i32 {
    let a: isize = 42isize;
    let b: isize = 42i64 as isize;
    let c: isize = 42isize;
    let d = 42isize;
    let e = return_val();

    assert_eq!(a, b);
    assert_eq!(a, c);
    assert_eq!(a, d);
    assert_eq!(a, e);
    return 0;
}
