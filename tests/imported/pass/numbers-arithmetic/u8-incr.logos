// Imported from rust-lang/rust tests/ui/numbers-arithmetic/u8-incr.rs
// Modifications: explicit u8 suffixes; main returns i32.
package u8_incr_test;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    let mut x: u8 = 12u8;
    let y: u8 = 12u8;
    x = x + 1u8;
    x = x - 1u8;
    assert_eq!(x, y);
    return 0;
}
