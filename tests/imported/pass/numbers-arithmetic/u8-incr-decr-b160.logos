// Tests u8 increment and decrement converge to the same value (19+7 == 35-9).
package u8_incr_decr_b160;

fn main() -> i32 {
    let mut x: u8 = 19u8;
    let mut y: u8 = 35u8;
    x = x + 7u8;
    y = y - 9u8;
    if x != y { return 1i32; }
    return 0i32;
}
