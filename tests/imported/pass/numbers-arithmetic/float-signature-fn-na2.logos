package float_signature_fn_na2;

fn foo(n: f64) -> f64 { return n + 0.12345f64; }

fn main() -> i32 {
    let n: f64 = 0.1f64;
    let m: f64 = foo(n);
    let diff: f64 = m - 0.22345f64;
    if diff < -0.0001f64 { return 1i32; }
    if diff > 0.0001f64 { return 2i32; }
    return 0i32;
}
