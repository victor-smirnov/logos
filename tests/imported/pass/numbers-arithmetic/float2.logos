// Imported from rust-lang/rust tests/ui/numbers-arithmetic/float2.rs
// Modifications: assert! kept via std.fmt prelude; negative-exponent
// scientific notation (3.2e-10) replaced with decimal expansion;
// bare-mantissa exponent forms (`1e6`) need a decimal point in Logos's
// float lexer, written `1.0e6`.
package float2_test;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    let a = 1.5e6f64;
    let b = 1.5E6f64;
    let c = 1.0e6f64;
    let d = 1.0E6f64;
    let e = 3.0f32;
    let f = 5.9f64;
    let g = 1.0e6f32;
    let h = 1.0e7f64;
    let i = 1.0E7f64;
    let j = 3.1e+9f64;
    let k = 0.00000000032f64;
    assert_eq!(a, b);
    assert!(c < b);
    assert_eq!(c, d);
    assert!(e < g);
    assert!(f < h);
    assert_eq!(g, 1000000.0f32);
    assert_eq!(h, i);
    assert!(j > k);
    assert!(k < a);
    return 0;
}
