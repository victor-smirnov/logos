// Tests left/right shifts across several integer widths and signedness.
package shift_various_types_b138;

fn main() -> i32 {
    if (1u8 << 3u32) != 8u8 { return 1i32; }
    if (255u8 >> 4u32) != 15u8 { return 2i32; }
    if (1i32 << 10u32) != 1024i32 { return 3i32; }
    if (1024i32 >> 5u32) != 32i32 { return 4i32; }
    if (1u64 << 40u32) != 1099511627776u64 { return 5i32; }
    if ((0 - 8i64) >> 1u32) != (0 - 4i64) { return 6i32; }
    return 0i32;
}
