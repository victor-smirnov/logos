// Imported from rust-lang/rust tests/ui/numbers-arithmetic/usize-base.rs
// Modifications: explicit usize suffixes; return_val module-scope.
package usize_base_test;

use std.fmt;
use std.lang.text;

fn return_val() -> usize {
    return 42usize;
}

fn main() -> i32 {
    let a: usize = 42usize;
    let b: usize = 42u64 as usize;
    let c: usize = 42usize;
    let d = 42usize;
    let e = return_val();

    assert_eq!(a, b);
    assert_eq!(a, c);
    assert_eq!(a, d);
    assert_eq!(a, e);
    return 0;
}
