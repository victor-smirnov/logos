package div_mod_b160;

fn main() -> i32 {
    let x: i64 = 15i64;
    let y: i64 = 5i64;
    if x / 5i64 != 3i64 { return 1i32; }
    if x / 4i64 != 3i64 { return 2i32; }
    if x / 3i64 != 5i64 { return 3i32; }
    if x / y != 3i64 { return 4i32; }
    if 15i64 / y != 3i64 { return 5i32; }
    if x % 5i64 != 0i64 { return 6i32; }
    if x % 4i64 != 3i64 { return 7i32; }
    if x % 3i64 != 0i64 { return 8i32; }
    if x % y != 0i64 { return 9i32; }
    if 15i64 % y != 0i64 { return 10i32; }
    return 0i32;
}
