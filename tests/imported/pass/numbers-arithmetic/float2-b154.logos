package float2_b154;

fn main() -> i32 {
    let a: f64 = 1.5e6f64;
    let b: f64 = 1.5E6f64;
    let c: f64 = 1e6f64;
    let d: f64 = 1E6f64;
    let h: f64 = 1.0e7f64;
    let i: f64 = 1.0E7f64;
    let j: f64 = 3.1e+9f64;
    let k: f64 = 3.2e-10f64;
