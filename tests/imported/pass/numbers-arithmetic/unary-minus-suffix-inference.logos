// Imported from rust-lang/rust tests/ui/numbers-arithmetic/unary-minus-suffix-inference.rs
// Modifications: println! replaced with value asserts; isize → i64; each
// literal explicitly suffixed. Tests that unary `-` keeps the annotated
// integer width.
package unary_minus_suffix_inference_test;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    let a_neg: i8 = -1i8;
    assert_eq!(a_neg, -1i8);

    let b_neg: i16 = -1i16;
    assert_eq!(b_neg, -1i16);

    let c_neg: i32 = -1i32;
    assert_eq!(c_neg, -1i32);

    let d_neg: i64 = -1i64;
    assert_eq!(d_neg, -1i64);
    return 0;
}
