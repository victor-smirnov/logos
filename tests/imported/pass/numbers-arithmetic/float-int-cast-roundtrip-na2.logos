package float_int_cast_roundtrip_na2;

fn main() -> i32 {
    let n: f64 = 3.0f64;
    let i: i64 = n as i64;
    if i != 3i64 { return 1i32; }

    let j: i64 = 7i64;
    let f: f64 = j as f64;
    if f != 7.0f64 { return 2i32; }

    // truncation toward zero
    if (3.9f64 as i64) != 3i64 { return 3i32; }
    if (-2.7f64 as i64) != -2i64 { return 4i32; }
    if (0.5f64 as i64) != 0i64 { return 5i32; }
    return 0i32;
}
