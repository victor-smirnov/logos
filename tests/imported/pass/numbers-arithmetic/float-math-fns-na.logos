    // rounding family
    if floor_f64(3.7f64) != 3.0f64 { return 6i32; }
    if ceil_f64(3.2f64) != 4.0f64 { return 7i32; }
    if round_f64(2.5f64) != 3.0f64 { return 8i32; }
    if trunc_f64(3.9f64) != 3.0f64 { return 9i32; }
