    if sqrt_f64(144.0f64) != 12.0f64 { return 10i32; }
    if abs_f64(-2.5f64) != 2.5f64 { return 11i32; }
    if pow_f64(2.0f64, 8.0f64) != 256.0f64 { return 12i32; }
    return 0i32;
