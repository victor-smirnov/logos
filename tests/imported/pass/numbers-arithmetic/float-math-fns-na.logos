// float_math.rs uses unstable `fadd_fast`/etc. intrinsics asserting equality
// with `+`/`-`/`*`/`/`/`%`; the f64.sqrt()/.floor() METHOD form is a known gap,
// so this routes through the named free-fn forms sqrt_f64/floor_f64/...)
package float_math_fns_na;

use logos.lang.math;

fn main() -> i32 {
    let a: f64 = 10.0f64;
    let b: f64 = 5.0f64;
    // basic operators map correctly
    if (a + b) != 15.0f64 { return 1i32; }
    if (a - b) != 5.0f64 { return 2i32; }
    if (a * b) != 50.0f64 { return 3i32; }
    if (a / b) != 2.0f64 { return 4i32; }
