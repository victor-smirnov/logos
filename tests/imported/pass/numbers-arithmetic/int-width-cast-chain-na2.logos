// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/numbers-arithmetic/isize-base.rs + usize-base.rs (cast facet)
// Modifications: the literal-cast facet (`42 as isize`/`42 as usize`) generalized
// into a chain of `as` conversions across integer widths and signedness that all
// preserve a small in-range value. isize/usize→i64/u64. assert_eq!→return codes.
package int_width_cast_chain_na2;

fn main() -> i32 {
    let a: i64 = 300i64;
    let b: i32 = a as i32;
    if b != 300i32 { return 1i32; }

    let c: u32 = b as u32;
    if c != 300u32 { return 2i32; }

    let d: i64 = c as i64;
    if d != 300i64 { return 3i32; }

    let e: u64 = 42u64;
    let g: i32 = e as i32;
    if g != 42i32 { return 4i32; }

    // round-trip through a narrow signed cast keeps a small value
    let h: i32 = 100i32;
    let k: u64 = h as u64;
    if k != 100u64 { return 5i32; }
    return 0i32;
}
