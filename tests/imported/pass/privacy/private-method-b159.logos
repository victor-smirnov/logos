struct Cat { meows: u64, how_hungry: i64 }

impl Cat {
    fn play(self: &mut Self) {
        self.meows += 1u64;
        self.nap();
    }
    fn count(self: &Self) -> u64 { return self.meows; }
}

impl Cat {
