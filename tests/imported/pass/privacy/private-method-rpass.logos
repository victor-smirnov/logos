package pv_private_method_rpass;

struct Cat { meows: u64, how_hungry: i64 }

impl Cat {
    fn play(&mut self) { self.meows = self.meows + 1u64; self.nap(); }
    fn nap(&mut self) { let mut i = 1u64; while i < 10u64 { i = i + 1u64; } }
}

fn main() -> i32 {
    let mut nyan = Cat { meows: 52u64, how_hungry: 99i64 };
    nyan.play();
    if nyan.meows != 53u64 { return 1; }
    return 0;
}
