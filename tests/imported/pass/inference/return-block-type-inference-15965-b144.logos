package return_block_type_inference_15965_b144;

fn inner(cond: bool) -> i64 {
    if cond {
        return { return 3i64; };
    }
    return 7i64;
}

fn main() -> i32 {
    if inner(true) != 3i64 { return 1i32; }
    if inner(false) != 7i64 { return 2i32; }
    return 0i32;
}
