//   uses `return` (sentinel) rather than panic!.
// Tests the `let ... else { <diverging> }` binding form over an Option, where
//   the Some path binds and the None path diverges via return.
package let_else_divergent_b164;

fn first_positive(a: i64, b: i64) -> Option<i64> {
    if a > 0i64 { return Option::Some(a); }
    if b > 0i64 { return Option::Some(b); }
    return Option::None;
}

fn pick(a: i64, b: i64) -> i64 {
    let Option::Some(v) = first_positive(a, b) else {
        return -1i64;
    };
    return v;
}

fn main() -> i32 {
    if pick(3i64, 5i64) != 3i64 { return 1i32; }
    if pick(-2i64, 7i64) != 7i64 { return 2i32; }
    if pick(-1i64, -1i64) != -1i64 { return 3i32; }
    return 0i32;
}
