// Tests let-else binding: refutable `let Some(y) = x else {…}` that succeeds, a
//   wildcard success, a failing `let None = Some(_)` taking the else branch, a
//   failing literal `let 1 = 2 else {…}` in a closure, and an enum-variant bind.
package let_else_bindings_b161;

use logos.lang.option;
use logos.lang.result;

fn none_takes_else() -> bool {
    let None = Some(7i64) else {
        return true;
    };
    return false;
}

fn ok_takes_else() -> bool {
    let Ok(_z) = Err::<i64, i64>(5i64) else {
        return true;
    };
    return false;
}

fn closure_lit_else() -> bool {
    let f = || -> bool {
        let 1i64 = 2i64 else {
            return true;
        };
        return false;
    };
    return f();
}

fn main() -> i32 {
    let x = Some(3i64);
    let Some(y) = x else {
        return 1i32;
    };
    if y != 3i64 { return 2i32; }

    let Some(_) = x else {
        return 3i32;
    };

    if !none_takes_else() { return 4i32; }
    if !ok_takes_else() { return 5i32; }
    if !closure_lit_else() { return 6i32; }
    return 0i32;
}
