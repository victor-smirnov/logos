package le_let_else;

use std.fmt;
use std.lang.text;
use logos.lang.option;

fn main() -> i32 {
    let Option::Some(x) = Option::Some::<i32>(1i32) else {
        return 1;
    };
    assert_eq!(x, 1i32);
    return 0;
}
