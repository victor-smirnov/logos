package le_issue_99975;

use logos.lang.option;

fn return_result() -> Option<i64> {
    return Some(7i64);
}

fn start() -> i64 {
    let Some(content) = return_result() else {
        return -1i64;
    };
    return content;
}

fn other() -> i64 {
    let Some(content) = none_result() else {
        return -1i64;
    };
    return content;
}

fn none_result() -> Option<i64> { return None; }

fn main() -> i32 {
    if start() != 7i64 { return 1; }
    if other() != -1i64 { return 2; }
    return 0;
}
