// Modifications: only the Some-binding half of the test is kept —
// Logos has no Result<T, E> stdlib (one exists for hermes/ctr but
// not in std.lang). Tests `let Option::Some(y) = expr else { … };`
// shape — confirms let-else works as in Rust.
package let_else_basic;

use std.lang.option;
use std.fmt;
use std.lang.text;

fn main() -> i32 {
    let x: Option<i64> = Option::Some(3i64);
    let Option::Some(y) = x else {
        panic("let-else panicked");
        return 1;
    };
    assert_eq!(y, 3i64);
    return 0;
}
