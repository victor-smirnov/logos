// value asserts.
package repeated_vector_syntax;

fn main() -> i32 {
    let x: [[bool; 1]; 512] = [[true]; 512];
    let y: [i32; 1] = [0i32; 1];
    if x[0i64][0i64]   != true  { return 1; }
    if x[511i64][0i64] != true  { return 2; }
    if y[0i64]         != 0i32  { return 3; }
    return 0;
}
