// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/array-slice-vec/fixed_length_copy.rs
// Modifications: explicit `[i32; 3]` annotations + i64 index — Rust
// infers both from context. Otherwise faithful: fixed-size array copy
// via `let arr2 = arr` works because all elements are scalar.
package fixed_length_copy;

use std.fmt;
use std.lang.text;

fn main() -> i32 {
    let arr:  [i32; 3] = [1i32, 2i32, 3i32];
    let arr2: [i32; 3] = arr;
    assert_eq!(arr[1i64],  2i32);
    assert_eq!(arr2[2i64], 3i32);
    return 0;
}
