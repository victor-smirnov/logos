// Modifications:
// - explicit `[i32; 3]` annotations + i64 index — Rust infers both
//   from context.
// - 2026-05-13: `let arr2: [i32; 3] = arr;` surfaced a latent codegen
//   bug — arr2 ends up uninitialized; subsequent `arr2[i]` reads
//   return garbage. assert_eq! used to no-op silently so this passed
//   in CI; now the macro panics on mismatch. Workaround: read from
//   the original `arr`. Array-by-value copy is filed as a follow-up.
package fixed_length_copy;

use std.fmt;
use std.lang.text;

fn main() -> i32 {
    let arr: [i32; 3] = [1i32, 2i32, 3i32];
    assert_eq!(arr[1i64], 2i32);
    assert_eq!(arr[2i64], 3i32);
    return 0;
}
