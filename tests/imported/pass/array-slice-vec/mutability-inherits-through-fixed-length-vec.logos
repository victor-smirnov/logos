package mutability_inherits_through_fixed_length_vec;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn test1() {
    let mut ints: [i64; 32] = [0i64; 32];
    ints[0i64] = ints[0i64] + 1i64;
    assert_eq!(ints[0i64], 1i64);
}

fn test2() {
    let mut ints: [i64; 32] = [0i64; 32];
    let mut i: i64 = 0i64;
    while i < 32i64 { ints[i] = ints[i] + 22i64; i = i + 1i64; }
    let mut j: i64 = 0i64;
    while j < 32i64 { assert_eq!(ints[j], 22i64); j = j + 1i64; }
}

fn main() -> i32 {
    test1();
    test2();
    return 0;
}
