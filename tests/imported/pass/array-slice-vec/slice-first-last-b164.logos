// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/array-slice-vec/ shapes (distilled).
// Modifications: isize->i64; assert->if-return sentinels; min/max computed by a
//   manual scan over a slice (the point is slice indexing + len in a loop).
// Tests scanning a `&[i64]` slice for its min and max via indexed iteration.
package slice_first_last_b164;

fn min_max(s: &[i64]) -> (i64, i64) {
    let mut lo: i64 = s[0];
    let mut hi: i64 = s[0];
    let mut i: i64 = 1i64;
    let n: i64 = s.len();
    while i < n {
        if s[i] < lo { lo = s[i]; }
        if s[i] > hi { hi = s[i]; }
        i = i + 1i64;
    }
    return (lo, hi);
}

fn main() -> i32 {
    let a: [i64; 5] = [3i64, 1i64, 4i64, 1i64, 5i64];
    let (lo, hi) = min_max(&a);
    if lo != 1i64 { return 1i32; }
    if hi != 5i64 { return 2i32; }
    return 0i32;
}
