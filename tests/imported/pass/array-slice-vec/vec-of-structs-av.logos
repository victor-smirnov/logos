package vec_of_structs_av;
struct P { v: i64 }
fn main() -> i32 {
    let mut v = vec_new::<P>();
    v.push(P{v:1i64}); v.push(P{v:2i64}); v.push(P{v:3i64});
    let mut s = 0i64;
    for p in &v { s = s + (*p).v; }
    if s != 6i64 { return 1; }
    return 0;
}
