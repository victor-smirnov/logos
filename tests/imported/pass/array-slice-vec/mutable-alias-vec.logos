package asv_mutable_alias_vec;

use std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.mem.collections.vec;

fn grow(v: &mut Vec<i64>) {
    v.push(1i64);
}

fn main() -> i32 {
    let mut v: Vec<i64> = vec_new::<i64>();
    grow(&mut v);
    grow(&mut v);
    grow(&mut v);
    let len: i64 = v.length();
    if len != 3i64 { return 1i32; }
    return 0i32;
}
