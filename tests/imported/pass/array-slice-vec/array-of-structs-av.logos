package array_of_structs_av;
struct Foo { x: i64 }
fn main() -> i32 {
    let arr: [Foo; 3] = [Foo{x:1i64}, Foo{x:2i64}, Foo{x:3i64}];
    let mut sum = 0i64;
    for f in &arr { sum = sum + (*f).x; }
    if sum != 6i64 { return 1; }
    if arr[2i64].x != 3i64 { return 2; }
    return 0;
}
