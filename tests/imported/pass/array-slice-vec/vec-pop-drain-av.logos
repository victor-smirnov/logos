package vec_pop_drain_av;
fn main() -> i32 {
    let mut v = vec_new::<i64>();
    v.push(1i64); v.push(2i64); v.push(3i64);
    let mut total = 0i64;
    while let Some(x) = v.pop() { total = total + x; }
    if total != 6i64 { return 1; }
    if v.length() != 0i64 { return 2; }
    return 0;
}
