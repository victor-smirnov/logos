package new_style_fixed_length_vec;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

pub const FOO: [isize; 3] = [1isize, 2isize, 3isize];

fn main() -> i32 {
    if FOO[0i64] != 1isize { return 1; }
    if FOO[1i64] != 2isize { return 2; }
    if FOO[2i64] != 3isize { return 3; }
    return 0;
}
