// Modifications: slice syntax &a[lo..hi] not used (dynamic-slice value is KNOWN-OPEN); a [lo,hi) sum helper over a by-value fixed array expresses the same intent.
package array_range_sum_helper_av;
fn range_sum(a: [i64; 5], lo: i64, hi: i64) -> i64 {
    let mut s = 0i64; let mut i = lo;
    while i < hi { s = s + a[i]; i = i + 1i64; }
    return s;
}
fn main() -> i32 {
    let a: [i64; 5] = [1i64, 2i64, 3i64, 4i64, 5i64];
    if range_sum(a, 1i64, 4i64) != 9i64 { return 1; }
    return 0;
}
