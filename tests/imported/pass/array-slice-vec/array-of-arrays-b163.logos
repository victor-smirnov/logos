// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/array-slice-vec/ shapes (distilled).
// Modifications: isize->i64; assert->if-return sentinels. A fixed 2-D array
//   `[[i64; 3]; 2]` indexed by row+col, summed, and mutated in place via the
//   chained two-level indexed WRITE `grid[r][c] = ..` (G163-2 — general
//   place-write; both the two-level READ and WRITE now work).
// Tests nested fixed-array (`[[i64;N];M]`) construction, two-level indexing READ,
//   and chained two-level indexed WRITE in place.
package array_of_arrays_b163;

fn main() -> i32 {
    let mut grid: [[i64; 3]; 2] = [[1i64, 2i64, 3i64], [4i64, 5i64, 6i64]];
    if grid[0][0] != 1i64 { return 1i32; }
    if grid[1][2] != 6i64 { return 2i32; }
    let mut sum: i64 = 0i64;
    let mut r: i64 = 0i64;
    while r < 2i64 {
        let mut c: i64 = 0i64;
        while c < 3i64 {
            sum = sum + grid[r][c];
            c = c + 1i64;
        }
        r = r + 1i64;
    }
    if sum != 21i64 { return 3i32; }
    // chained two-level indexed write in place (G163-2)
    grid[0][1] = 20i64;
    grid[1][2] = 60i64;
    if grid[0][1] != 20i64 { return 4i32; }
    if grid[1][2] != 60i64 { return 5i32; }
    if grid[0][0] != 1i64 { return 6i32; }
    return 0i32;
}
