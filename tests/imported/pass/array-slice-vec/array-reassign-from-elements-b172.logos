// G172-5: reassigning a whole array variable (`t = [t[1]*2, t[0]*2]`) wrote
// only the RHS array POINTER into the first 8 bytes of the slot (gen_assign
// fell through to a scalar StoreOp), leaving the elements stale → `t[i]` read
// the old value. gen_assign now memcpys a whole-array rebind (like struct /
// fat-pointer rebinds).
package array_reassign_from_elements_b172;
fn main() -> i32 {
    let mut t: [i64; 2] = [1i64, 1i64];
    t = [t[1i64] * 2i64, t[0i64] * 2i64];
    if t[0i64] != 2i64 { return 1i32; }
    if t[1i64] != 2i64 { return 2i32; }
    // Plain whole-array reassignment too.
    t = [9i64, 8i64];
    if t[0i64] != 9i64 { return 3i32; }
    if t[1i64] != 8i64 { return 4i32; }
    return 0i32;
}
