// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: library/coretests/tests/mem.rs (subset).
//
// Ported tests:
//   - size_of_basic, size_of_64
//   - align_of_basic, align_of_64
//   - test_swap, test_replace
//
// Modifications vs upstream:
//   - Rust: `size_of::<T>()` (prelude / `core::mem::size_of`); Logos:
//     `sizeof::<T>()` (compiler builtin, same semantics). Same for
//     `align_of` → `align_of` (no rename — Logos kept the underscore).
//   - Rust: `mem::swap(&mut a, &mut b)` (safe, prelude'd); Logos:
//     `mem.swap_ref::<T>(&mut a, &mut b)` — the `_ref` suffix avoids
//     a collision with the existing lower-level unsafe pointer-based
//     `swap<T>(a: *mut T, b: *mut T)` in the same module. Same suffix
//     pattern on `replace_ref` / `take_ref`.
//   - Pointer-width tests scoped to 64-bit only (current build target).
//     Logos doesn't yet have a `target_pointer_width` cfg query, so
//     the 16/32 variants of the upstream tests are dropped rather
//     than guarded.
//   - test_replace mirrors upstream's `Option<String>` shape directly
//     (`mem::replace(&mut Some(s), None)`). The earlier
//     `replace_ref::<Option<X>>` cascade ("expected !llvm.ptr, got i32")
//     was a sema gap — a payload-less `Option::None` arg kept a bare
//     `Option` type so mlir-gen emitted a C-style discriminant; fixed by
//     retyping the literal to the substituted param type. No divergence
//     remains here.

package test_harness_coretest_mem;

use std.fmt;
use logos.lang.option;
use logos.mem.string;
use logos.lang.str;
use logos.lang.panic;
use logos.mem.mem;

#[test]
fn size_of_basic() {
    assert_eq!(sizeof::<u8>(), 1i64);
    assert_eq!(sizeof::<u16>(), 2i64);
    assert_eq!(sizeof::<u32>(), 4i64);
    assert_eq!(sizeof::<u64>(), 8i64);
}

#[test]
fn size_of_64() {
    assert_eq!(sizeof::<usize>(), 8i64);
    assert_eq!(sizeof::<*const usize>(), 8i64);
}

#[test]
fn align_of_basic() {
    assert_eq!(align_of::<u8>(), 1i64);
    assert_eq!(align_of::<u16>(), 2i64);
    assert_eq!(align_of::<u32>(), 4i64);
}

#[test]
fn align_of_64() {
    assert_eq!(align_of::<usize>(), 8i64);
    assert_eq!(align_of::<*const usize>(), 8i64);
}

#[test]
fn test_swap() {
    let mut x: i32 = 31337i32;
    let mut y: i32 = 42i32;
    swap_ref::<i32>(&mut x, &mut y);
    assert_eq!(x, 42i32);
    assert_eq!(y, 31337i32);
}

#[test]
fn test_replace() {
    let mut x: Option<String> = Option::Some(String::from("test"));
    let y = replace_ref::<Option<String>>(&mut x, Option::None);
    // x is now None; y holds the previous Some("test").
    match x { Option::Some(s) => { panic("x should be None"); } Option::None => {} }
    match y { Option::Some(s) => { assert_eq!(s.len(), 4i64); } Option::None => { panic("y should be Some"); } }
}
