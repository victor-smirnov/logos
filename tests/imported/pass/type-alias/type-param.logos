// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/type-alias/type-param.rs
// Modifications: `extern "C" fn` alias dropped (Logos has no extern-fn type
// component); kept the plain `fn(T) -> bool` parametric alias. Smoke test: a
// generic type alias to a function-pointer type must be accepted, and its
// parameter resolved when instantiated.
package m_type_alias_type_param;

type Bar<T> = fn(T) -> bool;

fn is_pos(x: i64) -> bool { return x > 0i64; }

fn main() -> i32 {
    let f: Bar<i64> = is_pos;
    if !f(5i64) { return 1; }
    if f(-5i64) { return 2; }
    return 0;
}
