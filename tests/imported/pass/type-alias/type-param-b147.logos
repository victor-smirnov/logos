package type_param_b147;

type Bar<T> = fn(T) -> bool;

fn is_pos(x: i64) -> bool { return x > 0i64; }

fn main() -> i32 {
    let f: Bar<i64> = is_pos;
    if !f(5i64) { return 1i32; }
    if f(0i64 - 1i64) { return 2i32; }
    return 0i32;
}
