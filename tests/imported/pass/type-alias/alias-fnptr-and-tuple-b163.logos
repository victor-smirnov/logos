package alias_fnptr_and_tuple_b163;

type IntOp = fn(i64) -> i64;
type Pair = (i64, i64);

fn inc(x: i64) -> i64 { return x + 1i64; }
fn dbl(x: i64) -> i64 { return x * 2i64; }

fn main() -> i32 {
    let f: IntOp = inc;
    let g: IntOp = dbl;
    if f(4i64) != 5i64 { return 1i32; }
    if g(4i64) != 8i64 { return 2i32; }
    let p: Pair = (3i64, 9i64);
    let (a, b) = p;
    if a + b != 12i64 { return 3i32; }
    return 0i32;
}
