package type_alias_generic_fn_b162;

use logos.lang.option;

struct Pair {
    a: i64,
    b: i64,
}

type IntOpt = Option<i64>;
type Coords = Pair;

fn first(o: IntOpt) -> i64 {
    match o {
        Option::Some(v) => { return v; }
        Option::None => { return -1i64; }
    }
}

fn main() -> i32 {
    let x: IntOpt = Option::Some(99i64);
    if first(x) != 99i64 { return 1i32; }

    let y: IntOpt = Option::None;
    if first(y) != -1i64 { return 2i32; }

    let p: Coords = Coords { a: 3i64, b: 4i64 };
    if (p.a + p.b) != 7i64 { return 3i32; }
    return 0i32;
}
