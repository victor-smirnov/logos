// Tests a generic type alias over a fn-pointer type: `type Bar<T> = fn(T)->bool`.
package type_param_fnptr_b137;

type Bar<T> = fn(T) -> bool;

fn is_zero(x: i64) -> bool {
    return x == 0i64;
}

fn main() -> i32 {
    let f: Bar<i64> = is_zero;
    if !f(0i64) { return 1i32; }
    if f(5i64) { return 2i32; }
    return 0i32;
}
