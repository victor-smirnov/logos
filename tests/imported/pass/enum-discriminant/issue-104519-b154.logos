package issue_104519_b154;

enum TransportErr { UnknownMethod }

enum OpenResult {
    Ok2(()),
    Err2(()),
    TransportErr2(TransportErr),
}

fn some_match(result: OpenResult) -> u8 {
    match result {
        OpenResult::Ok2(_) => 0u8,
        _ => 1u8,
    }
}

fn main() -> i32 {
    let result = OpenResult::Ok2(());
    if some_match(result) != 0u8 { return 1i32; }
    let e = OpenResult::TransportErr2(TransportErr::UnknownMethod);
    if some_match(e) != 1u8 { return 2i32; }
    return 0i32;
}
