// Tests: an enum Bar with a payload variant A(Foo) carrying ANOTHER enum value, plus
//   two const variants B/C, matches A(_) correctly (regression: niche/discriminant calc
//   over an enum-typed payload + >2 variants).
package issue_90038_b154;

enum Foo { A }

enum Bar {
    A(Foo),
    B,
    C,
}

fn main() -> i32 {
    match Bar::A(Foo::A) {
        Bar::A(_) => { return 0i32; }
        Bar::B => { return 1i32; }
        Bar::C => { return 2i32; }
    }
}
