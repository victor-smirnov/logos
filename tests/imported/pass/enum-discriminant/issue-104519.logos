package ed_issue_104519;

struct Unit { d: i32 }

enum TransportErr {
    UnknownMethod,
}

enum OpenResult {
    Ok(Unit),
    Err(Unit),
    TransportErr(TransportErr),
}

fn some_match(result: OpenResult) -> u8 {
    match result {
        OpenResult::Ok(_) => { return 0u8; },
        _ => { return 1u8; },
    }
}

fn main() -> i32 {
    let result = OpenResult::Ok(Unit { d: 0i32 });
    if some_match(result) != 0u8 { return 1; }
    return 0;
}
