// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/enum-discriminant/ shapes (distilled).
// Modifications: isize->i64; assert->if-return sentinels; `#[repr]` dropped.
// Tests a fieldless enum with EXPLICIT discriminant values read back via `as i64`,
//   and arithmetic on those discriminants.
package enum_discriminant_cast_b164;

enum Color {
    Red = 1i64,
    Green = 2i64,
    Blue = 4i64,
}

fn main() -> i32 {
    if (Color::Red as i64) != 1i64 { return 1i32; }
    if (Color::Green as i64) != 2i64 { return 2i32; }
    if (Color::Blue as i64) != 4i64 { return 3i32; }

    // combine as a bitmask
    let mask: i64 = (Color::Red as i64) | (Color::Blue as i64);
    if mask != 5i64 { return 4i32; }
    return 0i32;
}
