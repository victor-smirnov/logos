package enum_discriminant_issue_51582;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

pub enum Enum : i8 {
    VariantA = 0,
    VariantB = 1,
}

fn make_b() -> Enum { return Enum::VariantB; }

fn main() -> i32 {
    assert_eq!(1i8, make_b() as i8);
    assert_eq!(1u8, make_b() as u8);
    assert_eq!(1i32, make_b() as i32);
    assert_eq!(1u32, make_b() as u32);
    return 0;
}
