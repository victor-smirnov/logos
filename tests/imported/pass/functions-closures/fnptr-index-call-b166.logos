// Regression (B166, g8b): invoking a fn-pointer obtained from an INDEX (or any
// postfix chain) in OPERAND position — `ops[i](x)` inside a binary / `if`
// condition. Previously parsed only as a statement head: the no-struct atom
// (atom_ns, used in operand position) lacked the INVOKE_EXPR postfix, so the
// trailing `(x)` after `ops[i]` was a syntax error.
package fnptr_index_call_b166;
fn inc(x: i64) -> i64 { return x + 1i64; }
fn dbl(x: i64) -> i64 { return x * 2i64; }
fn main() -> i32 {
    // logos-core 1.4: explicit FnPtr element type required when array
    // mixes bare fn-name refs of distinct fn-items (each is FnItem<sym>;
    // they LUB only through a shared FnPtr target, matching Rust).
    let ops: [fn(i64) -> i64; 2] = [inc, dbl];
    if ops[0i64](5i64) != 6i64 { return 1i32; }
    if ops[1i64](5i64) != 10i64 { return 2i32; }
    let r = ops[0i64](20i64) + ops[1i64](3i64);
    if r != 27i64 { return 3i32; }
    return 0i32;
}
