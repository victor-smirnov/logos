// Original path: tests/ui/functions-closures/fn-bare-assign.rs
// Modifications: explicit `fn(isize, &mut bool)` annotation on the
// local `h` (Logos's fn-pointer-from-name inference is partial).
// `v: &mut bool` named-param inside the fn-pointer type stripped —
// Logos's fn-ptr type doesn't carry parameter names.
package fc_fn_bare_assign;

use std.fmt;
use std.lang.text;

fn f(i: isize, called: &mut bool) {
    assert_eq!(i, 10isize);
    *called = true;
}

fn g(f: fn(isize, &mut bool), called: &mut bool) {
    f(10isize, called);
}

fn main() -> i32 {
    let mut called: bool = false;
    let h: fn(isize, &mut bool) = f;
    g(h, &mut called);
    assert_eq!(called, true);
    return 0;
}
