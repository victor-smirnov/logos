// Synthesized for B131 from the functions run-pass family (multiple-parameter
// fn + mixed-type params + passing a struct alongside scalars).
package fc_many_params;

struct Vec3 { x: i64, y: i64, z: i64 }

fn combine(a: i64, b: i64, c: i64, flag: bool, scale: i64) -> i64 {
    if flag { return (a + b + c) * scale; }
    return a + b + c;
}

fn dot(v: Vec3, w: Vec3) -> i64 {
    return v.x * w.x + v.y * w.y + v.z * w.z;
}

fn main() -> i32 {
    if combine(1i64, 2i64, 3i64, true, 10i64) != 60i64 { return 1i32; }
    if combine(1i64, 2i64, 3i64, false, 10i64) != 6i64 { return 2i32; }
    let v = Vec3 { x: 1i64, y: 2i64, z: 3i64 };
    let w = Vec3 { x: 4i64, y: 5i64, z: 6i64 };
    if dot(v, w) != 32i64 { return 3i32; }
    return 0i32;
}
