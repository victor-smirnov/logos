package copy_closure_b161;

fn call<T, F>(f: F) -> T where F: FnOnce() -> T { return f(); }

fn main() -> i32 {
    let a: i64 = 5i64;
    let hello = || -> i64 { return a; };
    if call(hello) != 5i64 { return 1i32; }
    if call(hello) != 5i64 { return 2i32; }
    if call(hello) != 5i64 { return 3i32; }
    return 0i32;
}
