// Original path: tests/ui/functions-closures/fn-item-type-coerce.rs
// Modifications: isize→i64; the type alias `type IntMap = fn(i64)->i64` kept;
// the generic `eq::<IntMap>(foo,bar)` distilled to a generic fn taking two
// values of the aliased fn-pointer type and calling each; `pub fn main()`→
// `fn main()->i32`. Exercises implicit coercion from a fn ITEM to a fn-POINTER
// type (alias) at let-binding and generic-arg positions.
package fc_fn_item_type_coerce;

fn foo(x: i64) -> i64 { return x * 2i64; }
fn bar(x: i64) -> i64 { return x * 4i64; }

type IntMap = fn(i64) -> i64;

fn both(x: IntMap, y: IntMap) -> i64 {
    return x(3i64) + y(3i64);
}

fn main() -> i32 {
    let f: IntMap = foo;
    if f(5i64) != 10i64 { return 1i32; }
    if both(foo, bar) != 18i64 { return 2i32; }
    return 0i32;
}
