package fc_fn_item_type_cast;

fn foo(x: i64) -> i64 { return x * 2i64; }
fn bar(x: i64) -> i64 { return x * 4i64; }

fn main() -> i32 {
    let f: fn(i64) -> i64 = foo;
    let g: fn(i64) -> i64 = if true { foo } else { bar };
    if g(4i64) != 8i64 { return 1i32; }
    if f(4i64) != 8i64 { return 2i32; }
    return 0i32;
}
