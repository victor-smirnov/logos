// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/functions-closures/fn-item-type-coerce.rs
// Modifications: isize → i64. The upstream test only declares the fn-pointer binding
//   and calls a no-op generic `eq::<IntMap>(foo, bar)` to force the coercion at compile
//   time; here both `foo` and `bar` are coerced to the `IntMap` fn-pointer alias and
//   actually invoked so the run observes the coercion (early-return sentinels).
// Tests: implicit coercion from a fn-item type to a fn-pointer type alias `type IntMap
//   = fn(i64) -> i64`, then calling through the fn pointer.
package fn_item_type_coerce_b155;

fn foo(x: i64) -> i64 { return x * 2i64; }
fn bar(x: i64) -> i64 { return x * 4i64; }

type IntMap = fn(i64) -> i64;

fn main() -> i32 {
    let f: IntMap = foo;
    let g: IntMap = bar;
    if f(3i64) != 6i64 { return 1i32; }
    if g(3i64) != 12i64 { return 2i32; }
    return 0i32;
}
