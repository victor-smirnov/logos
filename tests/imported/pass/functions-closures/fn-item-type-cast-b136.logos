package fn_item_type_cast_b136;

fn foo(x: i64) -> i64 { return x * 2i64; }
fn bar(x: i64) -> i64 { return x * 4i64; }

type IntMap = fn(i64) -> i64;

fn main() -> i32 {
    let f0: IntMap = foo as IntMap;
    if f0(4i64) != 8i64 { return 1i32; }

    let f: IntMap = if true { foo as IntMap } else { bar as IntMap };
    if f(4i64) != 8i64 { return 2i32; }
    return 0i32;
}
