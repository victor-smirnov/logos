// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/functions-closures/fn-bare-coerce-to-block.rs (extended)
// Modifications: `F: FnOnce()` bound → a `fn(i64)->i64` pointer param (a bare
// fn item coerces to it); two distinct fn items applied through the same
// higher-order fn, plus an apply-twice composition. `pub fn main()`→`fn main`.
package fc_higher_order_apply;

fn inc(x: i64) -> i64 { return x + 1i64; }
fn dbl(x: i64) -> i64 { return x * 2i64; }

fn apply(f: fn(i64) -> i64, v: i64) -> i64 { return f(v); }

fn apply_twice(f: fn(i64) -> i64, v: i64) -> i64 { return f(f(v)); }

fn main() -> i32 {
    if apply(inc, 5i64) != 6i64 { return 1i32; }
    if apply(dbl, 5i64) != 10i64 { return 2i32; }
    if apply_twice(inc, 5i64) != 7i64 { return 3i32; }
    if apply_twice(dbl, 3i64) != 12i64 { return 4i32; }
    return 0i32;
}
