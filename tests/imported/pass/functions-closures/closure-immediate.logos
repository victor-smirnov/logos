package fc_closure_immediate;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    let c = |a: u8, b: u16, cc: u8| {
        assert_eq!(a, 1u8);
        assert_eq!(b, 2u16);
        assert_eq!(cc, 3u8);
    };
    c(1u8, 2u16, 3u8);
    return 0;
}
