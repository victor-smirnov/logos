package fc_fn_bare_spawn;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

fn spawn<T>(val: T, f: fn(T)) { f(val); }

fn f(i: isize) { assert_eq!(i, 100isize); }

fn main() -> i32 {
    spawn::<isize>(100isize, f);
    return 0;
}
