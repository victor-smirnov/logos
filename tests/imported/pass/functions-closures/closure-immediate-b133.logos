package closure_immediate_b133;

fn main() -> i32 {
    let c = |a: u8, b: u16, d: u8| -> i32 {
        if a != 1u8 { return 1i32; }
        if b != 2u16 { return 2i32; }
        if d != 3u8 { return 3i32; }
        return 0i32;
    };
    return c(1u8, 2u16, 3u8);
}
