// Tests summing a field across an array of structs by indexed access.
package struct_array_field_sum_b165;

struct Item { w: i64 }
fn main() -> i32 {
    let items: [Item; 3] = [Item { w: 1i64 }, Item { w: 2i64 }, Item { w: 3i64 }];
    let mut total: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < 3i64 { total = total + items[i].w; i = i + 1i64; }
    if total != 6i64 { return 1i32; }
    return 0i32;
}
