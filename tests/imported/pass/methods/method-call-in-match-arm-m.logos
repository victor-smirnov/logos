// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Distilled from tests/ui/methods/ method-call result feeding a match scrutinee.
// Feature: a method call's return value is used directly as a match scrutinee, dispatching on the result.
// &self->self:&T; assert via match over the method result.
package method_call_in_match_arm_m;
struct Light { state: i64 }
impl Light { fn read(self: &Light) -> i64 { return (*self).state; } }
fn main() -> i32 {
    let l: Light = Light { state: 2i64 };
    let r: i64 = match l.read() {
        0i64 => 100i64,
        1i64 => 200i64,
        2i64 => 300i64,
        _ => 999i64,
    };
    if r == 300i64 { return 0i32; }
    return 1i32;
}
