// Distilled regression for G158-5 (closed 2026-05-23).
// A `&T` / `&mut T` receiver auto-derefs to a by-value-`self` inherent method
// (`fn m(self: T, ...)`), mirroring Rust's autoderef + the explicit
// `(*recv).m(...)` workaround. Auto-deref is LOWER priority than an exact /
// by-ref match — see tests/imported/pass/traits/inherent-method-order-b147
// (a `&Foo` receiver still picks the trait's `val(self: &Foo)` over the
// inherent `val(self: Foo)`).
package autoderef_ref_recv_byvalue_self_b158;

struct Vec2 { x: f64, y: f64 }
impl Vec2 {
    fn vmul(self: Vec2, k: f64) -> Vec2 { return Vec2 { x: self.x * k, y: self.y * k }; }
}

struct P { a: i64, b: i64 }
impl P {
    fn sum(self: P) -> i64 { return self.a + self.b; }
    fn combine(self: P, o: P) -> i64 { return self.a + o.b; }
}

fn through_ref(lhs: &Vec2) -> Vec2 { return lhs.vmul(2.0f64); }
fn through_ref_p(p: &P) -> i64 { return p.sum(); }
fn through_mut_p(p: &mut P) -> i64 { return p.sum(); }

fn main() -> i32 {
    let v: Vec2 = Vec2 { x: 1.0f64, y: 2.0f64 };
    let r: Vec2 = through_ref(&v);
    if r.x != 2.0f64 { return 1i32; }
    if r.y != 4.0f64 { return 2i32; }

    let p: P = P { a: 3i64, b: 4i64 };
    if through_ref_p(&p) != 7i64 { return 3i32; }
    let mut q: P = P { a: 10i64, b: 20i64 };
    if through_mut_p(&mut q) != 30i64 { return 4i32; }

    // by-value-self method taking another by-value arg, called on a `&P`
    let rp: &P = &p;
    let s: P = P { a: 100i64, b: 200i64 };
    if rp.combine(s) != 203i64 { return 5i32; }
    return 0i32;
}
