// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/methods/method-two-trait-defer-resolution-1.rs
// Modifications: `Vec::new()` → `vec_new::<T>()`; the test exercises
// type-based dispatch (impl-for-Vec<u32> vs impl-for-Vec<i32>) so
// keeping the Vec-receiver shape.
package method_two_trait_defer_resolution_1;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

trait foo {
    fn foo(self: &Self) -> i32;
}

impl foo for Vec<u32> {
    fn foo(self: &Vec<u32>) -> i32 { return 1i32; }
}

impl foo for Vec<i32> {
    fn foo(self: &Vec<i32>) -> i32 { return 2i32; }
}

fn call_foo_uint() -> i32 {
    let mut x: Vec<u32> = vec_new::<u32>();
    let y: i32 = x.foo();
    x.push(0u32);
    return y;
}

fn call_foo_int() -> i32 {
    let mut x: Vec<i32> = vec_new::<i32>();
    let y: i32 = x.foo();
    x.push(0i32);
    return y;
}

fn main() -> i32 {
    assert_eq!(call_foo_uint(), 1i32);
    assert_eq!(call_foo_int(), 2i32);
    return 0;
}
