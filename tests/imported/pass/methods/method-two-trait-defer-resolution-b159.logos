package method_two_trait_defer_resolution_b159;

struct Wrap<T> { v: T }

trait Foo { fn foo(self: &Self) -> i32; }

impl Foo for Wrap<u32> { fn foo(self: &Self) -> i32 { return 1i32; } }
impl Foo for Wrap<i32> { fn foo(self: &Self) -> i32 { return 2i32; } }

fn call_foo_uint() -> i32 {
    let x = Wrap { v: 0u32 };
    return x.foo();
}

fn call_foo_int() -> i32 {
    let x = Wrap { v: 0i32 };
    return x.foo();
}

fn main() -> i32 {
    if call_foo_uint() != 1i32 { return 1i32; }
    if call_foo_int() != 2i32 { return 2i32; }
    return 0i32;
}
