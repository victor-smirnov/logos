// between two trait impls keyed on the Vec's element type (u32 vs i32).
package method_two_trait_defer_mth4;

use logos.mem.collections.vec;

trait MyFoo {
    fn my_foo(self: &Self) -> i32;
}

impl MyFoo for Vec<u32> {
    fn my_foo(self: &Vec<u32>) -> i32 { return 1i32; }
}

impl MyFoo for Vec<i32> {
    fn my_foo(self: &Vec<i32>) -> i32 { return 2i32; }
}

fn call_foo_uint() -> i32 {
    let mut x: Vec<u32> = vec_new::<u32>();
    let y = x.my_foo();
    x.push(0u32);
    return y;
}

fn call_foo_int() -> i32 {
    let mut x: Vec<i32> = vec_new::<i32>();
    let y = x.my_foo();
    x.push(0i32);
    return y;
}

fn main() -> i32 {
    if call_foo_uint() != 1i32 { return 10i32; }
    if call_foo_int() != 2i32 { return 11i32; }
    return 0i32;
}
