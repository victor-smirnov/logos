// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/methods/inherent-methods-same-name.rs
// Modifications: tuple-struct `Foo<T>(T)` → named-field generic struct
//   `Foo<T> { v: T }`; two inherent impls at distinct concrete type-args
//   (`Foo<u64>` and `Foo<i64>`) each define `bar`; `as i32` casts kept; isize/
//   usize → i64/u64; `assert_eq!` → early-return sentinels.
// Tests that a generic type admits MULTIPLE inherent methods of the same name on
//   different concrete type-args, dispatched by the receiver's precise type.
package inherent_methods_same_name_b161;

struct Foo<T> { v: T }

impl Foo<u64> {
    fn bar(self: &Self) -> i64 { return self.v as i64; }
}

impl Foo<i64> {
    fn bar(self: &Self) -> i64 { return 0i64 - self.v; }
}

fn main() -> i32 {
    let foo_u = Foo::<u64> { v: 5u64 };
    if foo_u.bar() != 5i64 { return 1i32; }

    let foo_i = Foo::<i64> { v: 3i64 };
    if foo_i.bar() != -3i64 { return 2i32; }
    return 0i32;
}
