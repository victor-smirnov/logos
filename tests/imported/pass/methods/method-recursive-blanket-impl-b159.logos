package method_recursive_blanket_impl_b159;

trait Foo { fn foo(self: &Self) -> i64; }

struct MyType { v: i64 }

impl Foo for MyType {
    fn foo(self: &Self) -> i64 { return self.v; }
}

impl<T: Foo> Foo for &T {
    fn foo(self: &Self) -> i64 { return (*self).foo(); }
}

fn main() -> i32 {
    let m = MyType { v: 42i64 };
    let r = &m;
    if r.foo() != 42i64 { return 1i32; }
    return 0i32;
}
