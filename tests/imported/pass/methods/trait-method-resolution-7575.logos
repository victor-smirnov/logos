// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/methods/trait-method-resolution-7575.rs
// Modifications: default-bodies inlined into the per-type `impl Bar /
// Foo for isize` blocks. Logos *parses* trait default-bodies and Self
// resolves correctly when an impl-for-primitive has only `self: &Self`
// methods; but combining a static `fn new()` (no self) and a
// `self: &Self` default in the same trait, then implementing the
// trait for a primitive, exposes a second-pass Self-wipe in sema —
// remains open as M7-mt-02. Method name `new` admitted via Sprint 1.1.
package trait_method_resolution_7575;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

trait Foo {
    fn new() -> bool;
    fn dummy(self: &Self);
}

trait Bar {
    fn new(self: &Self) -> bool;
}

impl Bar for isize {
    fn new(self: &isize) -> bool { return true; }
}

impl Foo for isize {
    fn new() -> bool { return false; }
    fn dummy(self: &isize) {}
}

fn main() -> i32 {
    let x: isize = 1isize;
    assert!(x.new());
    return 0;
}
