package trait_method_resolution_7575;

use std.fmt;
use std.lang.text;

trait Foo {
    fn mk_static() -> bool;
    fn dummy(self: &Self);
}

trait Bar {
    fn mk(self: &Self) -> bool;
}

impl Bar for isize {
    fn mk(self: &isize) -> bool { return true; }
}

impl Foo for isize {
    fn mk_static() -> bool { return false; }
    fn dummy(self: &isize) {}
}

fn main() -> i32 {
    let x: isize = 1isize;
    assert!(x.mk());
    return 0;
}
