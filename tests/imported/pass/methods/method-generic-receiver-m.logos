// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Distilled from tests/ui/methods/ generic-receiver method-call patterns.
// Feature: a method on a generic struct `Wrap<T>` returns its field; method resolves with T inferred.
// &self->self:&Wrap<T>; assert via two distinct instantiations.
package method_generic_receiver_m;
struct Wrap<T> { v: T }
impl<T: Copy> Wrap<T> { fn get(self: &Wrap<T>) -> T { return (*self).v; } }
fn main() -> i32 {
    let a: Wrap<i64> = Wrap { v: 7i64 };
    let b: Wrap<u8> = Wrap { v: 9u8 };
    if a.get() == 7i64 && b.get() == 9u8 { return 0i32; }
    return 1i32;
}
