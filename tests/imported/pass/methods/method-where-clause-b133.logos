package method_where_clause_b133;

use logos.lang.option;

trait Foo {
    fn foo(&self) -> i32;
}

impl Foo for Option<u32> {
    fn foo(&self) -> i32 {
        return (*self).unwrap_or(22u32) as i32;
    }
}

fn check_u32(x: Option<u32>) -> i32 {
    let y: Option<u32> = Option::None;
    return x.foo() + y.foo();
}

fn main() -> i32 {
    if check_u32(Option::Some(23u32)) != 45i32 { return 1i32; }
    return 0i32;
}
