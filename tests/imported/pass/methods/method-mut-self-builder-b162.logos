// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/methods/ &mut self builder shapes (distilled).
// Modifications: isize->i64; assert->if-return sentinels. A `&mut self` method
//   mutates fields in place; repeated calls accumulate state; a `&self` reader
//   observes the result. Builder-style in-place mutation.
// Tests `self: &mut Self` methods mutating struct fields in place across multiple
//   calls + a `&self` reader.
package method_mut_self_builder_b162;

struct Accum {
    total: i64,
    count: i64,
}

impl Accum {
    fn new() -> Accum { return Accum { total: 0i64, count: 0i64 }; }
    fn push(self: &mut Self, v: i64) {
        (*self).total = (*self).total + v;
        (*self).count = (*self).count + 1i64;
    }
    fn mean(self: &Self) -> i64 {
        if (*self).count == 0i64 { return 0i64; }
        return (*self).total / (*self).count;
    }
}

fn main() -> i32 {
    let mut a: Accum = Accum::new();
    a.push(10i64);
    a.push(20i64);
    a.push(30i64);
    if a.total != 60i64 { return 1i32; }
    if a.count != 3i64 { return 2i32; }
    if a.mean() != 20i64 { return 3i32; }
    return 0i32;
}
