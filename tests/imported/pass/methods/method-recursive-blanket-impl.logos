package method_recursive_blanket_impl;

trait Foo<Ax> {
    fn foo(self: &Self, a: Ax);
}

impl<Ax, Ty: Foo<Ax>> Foo<Ax> for &Ty {
    fn foo(self: &&Ty, a: Ax) {
        (*self).foo(a);
    }
}

trait Bar {
    fn foo(self: &Self);
}

struct MyType {}

impl Bar for MyType {
    fn foo(self: &MyType) {}
}

fn main() -> i32 {
    let mut m = MyType {};
    (&mut m).foo();
    return 0;
}
