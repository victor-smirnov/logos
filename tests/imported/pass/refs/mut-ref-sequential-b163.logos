package mut_ref_sequential_b163;

fn add_into(p: &mut i64, k: i64) { *p = *p + k; }

fn main() -> i32 {
    let mut x: i64 = 10i64;
    add_into(&mut x, 5i64);
    add_into(&mut x, 7i64);
    if x != 22i64 { return 1i32; }
    let r: &mut i64 = &mut x;
    *r = *r * 2i64;
    if x != 44i64 { return 2i32; }
    return 0i32;
}
