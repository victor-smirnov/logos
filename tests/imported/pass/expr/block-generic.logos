package expr_block_generic;

use std.fmt;
use std.lang.text;

fn test_generic<T>(expected: T, eq: fn(T, T) -> bool) {
    let actual: T = { expected };
    assert!(eq(expected, actual));
}

fn compare_bool(b1: bool, b2: bool) -> bool { return b1 == b2; }

struct Pair { a: isize, b: isize }

fn compare_pair(t1: Pair, t2: Pair) -> bool {
    return t1.a == t2.a && t1.b == t2.b;
}

fn main() -> i32 {
    test_generic::<bool>(true, compare_bool);
    test_generic::<Pair>(Pair { a: 1isize, b: 2isize }, compare_pair);
    return 0;
}
