package if_check_recursion_b137;

fn even(x: u64) -> bool {
    if x < 2u64 {
        return false;
    } else if x == 2u64 {
        return true;
    } else {
        return even(x - 2u64);
    }
}

fn main() -> i32 {
    if !even(2u64) { return 1i32; }
    if !even(8u64) { return 2i32; }
    if even(7u64) { return 3i32; }
    return 0i32;
}
