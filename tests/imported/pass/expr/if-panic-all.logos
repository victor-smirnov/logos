// Original path: tests/ui/expr/if-panic-all.rs
// Modifications: `panic!()` becomes `panic(msg)` (Logos has a free
// fn `panic(str)`, not a macro); a trailing `0i32` follows each
// panic call so the arm's type is i32 (Logos has no `!` /never type
// inference, so divergent expressions don't satisfy a non-void arm).
package expr_if_panic_all;

use std.lang.panic;

fn main() -> i32 {
    let _x: i32 = if true {
        10i32
    } else {
        if true { panic("never"); 0i32 } else { panic("never"); 0i32 }
    };
    return 0;
}
