package expr_block_fn;

use std.fmt;
use logos.mem.string;
use logos.lang.str;

fn ten() -> isize { return 10isize; }

fn test_fn() {
    let rs: fn() -> isize = ten;
    assert_eq!(rs(), 10isize);
}

fn main() -> i32 { test_fn(); return 0; }
