//   bound-to-`let` shape. isize→i64; println!→ret guard.
// Tests an `if/else` used as a value-expression bound to a `let`.
package if_bot_b141;

fn main() -> i32 {
    let cond: bool = false;
    let i: i64 = if cond { 99i64 } else { 5i64 };
    if i != 5i64 { return 2i32; }
    return 0i32;
}
