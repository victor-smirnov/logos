// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/expr/* logical-operator short-circuit facets
// (DISTILLED). `&&` / `||` short-circuit observably: the rhs (a fn with a
// counter side effect) runs only when the lhs does not decide the result.
package short_circuit_ex;

fn side(p: &mut i32, ret: bool) -> bool {
    *p = *p + 1i32;
    return ret;
}

fn main() -> i32 {
    let mut count: i32 = 0i32;
    // false && _ : rhs skipped
    if false && side(&mut count, true) { return 1i32; }
    if count != 0i32 { return 2i32; }
    // true || _ : rhs skipped
    if !(true || side(&mut count, false)) { return 3i32; }
    if count != 0i32 { return 4i32; }
    // true && rhs : rhs runs
    if !(true && side(&mut count, true)) { return 5i32; }
    if count != 1i32 { return 6i32; }
    // false || rhs : rhs runs
    if false || side(&mut count, false) { return 7i32; }
    if count != 2i32 { return 8i32; }
    return 0i32;
}
