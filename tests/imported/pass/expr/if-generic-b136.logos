// Tests an `if cond { a } else { b }` expression used as the VALUE for a
// generic-typed local `let actual: T = if true { expected } else { ne };`
// inside a GENERIC fn, instantiated at two distinct scalar types.
package if_generic_b136;

fn test_generic<T: Copy>(expected: T, not_expected: T, eq: fn(T, T) -> bool) -> bool {
    let actual: T = if true { expected } else { not_expected };
    return eq(expected, actual);
}

fn compare_bool(b1: bool, b2: bool) -> bool { return b1 == b2; }

fn compare_int(a: i64, b: i64) -> bool { return a == b; }

fn main() -> i32 {
    if !test_generic::<bool>(true, false, compare_bool) { return 1i32; }
    if !test_generic::<i64>(7i64, 9i64, compare_int) { return 2i32; }
    return 0i32;
}
