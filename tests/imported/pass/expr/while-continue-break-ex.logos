// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/expr/* loop-control-flow facets (DISTILLED)
// `continue` skipping the rest of a `while` body; `break` exiting a `while true`
// loop early. Sum-of-odds + factorial.
package while_continue_break_ex;

fn main() -> i32 {
    // sum of odd numbers in 1..=10 via continue
    let mut sum: i32 = 0i32;
    let mut i: i32 = 0i32;
    while i < 10i32 {
        i = i + 1i32;
        if i % 2i32 == 0i32 { continue; }
        sum = sum + i;
    }
    if sum != 25i32 { return 1i32; }

    // factorial(5) via break out of `while true`
    let mut prod: i32 = 1i32;
    let mut j: i32 = 1i32;
    while true {
        prod = prod * j;
        if j == 5i32 { break; }
        j = j + 1i32;
    }
    if prod != 120i32 { return 2i32; }
    return 0i32;
}
