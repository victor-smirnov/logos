// Original path: tests/ui/expr/if-generic.rs
// Modifications: `FnOnce(T, T) -> bool` higher-rank closure-trait arg
// becomes a bare `fn(T, T) -> bool` parameter — Logos's Fn-family
// closure-as-trait-object is Sprint 5.8. `Clone` derive dropped —
// `Pair` is auto-Copy (only-scalar-fields rule). Otherwise faithful:
// `if true { expected } else { not_expected }` over a generic T plus
// an `eq` callback.
package expr_if_generic;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn test_generic<T>(expected: T, not_expected: T, eq: fn(T, T) -> bool) {
    let actual: T = if true { expected } else { not_expected };
    assert!(eq(expected, actual));
}

fn compare_bool(b1: bool, b2: bool) -> bool { return b1 == b2; }

struct Pair { a: isize, b: isize }

fn compare_pair(t1: Pair, t2: Pair) -> bool {
    return t1.a == t2.a && t1.b == t2.b;
}

fn main() -> i32 {
    test_generic::<bool>(true, false, compare_bool);
    test_generic::<Pair>(Pair { a: 1isize, b: 2isize },
                         Pair { a: 2isize, b: 3isize },
                         compare_pair);
    return 0;
}
