package if_else_chain_ex;

fn classify(x: i32) -> i32 {
    return if x < 0i32 {
        -1i32
    } else if x == 0i32 {
        0i32
    } else if x < 100i32 {
        1i32
    } else {
        2i32
    };
}

fn main() -> i32 {
    if classify(-5i32) != -1i32 { return 1i32; }
    if classify(0i32) != 0i32 { return 2i32; }
    if classify(42i32) != 1i32 { return 3i32; }
    if classify(1000i32) != 2i32 { return 4i32; }

    // if-expr whose branch is a block with intermediate lets
    let v: i32 = if classify(5i32) == 1i32 {
        let a: i32 = 3i32;
        let b: i32 = 4i32;
        a * b
    } else {
        0i32
    };
    if v != 12i32 { return 5i32; }
    return 0i32;
}
