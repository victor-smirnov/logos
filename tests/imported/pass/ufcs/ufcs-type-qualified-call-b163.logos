package ufcs_type_qualified_call_b163;

struct Counter { n: i64 }

impl Counter {
    fn get(self: &Self) -> i64 { return self.n; }
    fn bump(self: &mut Self) { self.n = self.n + 1i64; }
}

fn main() -> i32 {
    let mut c: Counter = Counter { n: 10i64 };
    Counter::bump(&mut c);
    if Counter::get(&c) != 11i64 { return 1i32; }
    if c.get() != 11i64 { return 2i32; }
    c.bump();
    if Counter::get(&c) != 12i64 { return 3i32; }
    return 0i32;
}
