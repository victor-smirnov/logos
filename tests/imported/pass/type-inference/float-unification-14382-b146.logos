// Tests generic `translate<S: POrd<S>>(S)->Matrix4<S>` with `impl POrd<f32> for f32`.
package float_unification_14382_b146;

struct Matrix4<S> { v: S }
trait POrd<S> { }

fn translate<S: POrd<S>>(s: S) -> Matrix4<S> { Matrix4 { v: s } }

impl POrd<f32> for f32 { }
impl POrd<f64> for f64 { }

fn main() -> i32 {
    let x = 1.0f32;
    let m: Matrix4<f32> = translate(x);
    if m.v != 1.0f32 { return 1i32; }
    return 0i32;
}
