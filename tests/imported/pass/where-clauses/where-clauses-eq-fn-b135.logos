package where_clauses_eq_fn_b135;

fn equal<T>(x: &T, y: &T) -> bool where T: Eq {
    return *x == *y;
}

fn main() -> i32 {
    if equal(&1i64, &2i64) { return 1i32; }
    if !equal(&1i64, &1i64) { return 2i32; }
    return 0i32;
}
