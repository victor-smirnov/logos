// Tests a struct with two lifetime parameters and a region-outlives where
//   clause (`where 'a : 'b`) holding `&i64` references.
package where_clause_region_outlives_b137;

struct A<'a, 'b> where 'a : 'b {
    x: &'a i64,
    y: &'b i64,
}

fn main() -> i32 {
    let x: i64 = 1i64;
    let y: i64 = 2i64;
    let a: A = A { x: &x, y: &y };
    if *a.x != 1i64 { return 1i32; }
    if *a.y != 2i64 { return 2i32; }
    return 0i32;
}
