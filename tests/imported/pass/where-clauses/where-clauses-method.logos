// Modifications: `isize`→`i64`; 1-char type `T`→`X`; `println!` → return-code
// checks; `pub fn main()`→`fn main()->i32`. Exercises a `where X: Eq` clause
// attached to a method of `Foo<X>` (adds a constraint at the method level that
// the struct's `impl<X>` does not require).
package wc_where_clauses_method;

use logos.lang.cmp;

struct Foo<X> { value: X }

impl<X> Foo<X> {
    fn equals(&self, u: &Foo<X>) -> bool where X: Eq { return self.value == u.value; }
}

fn main() -> i32 {
    let x = Foo { value: 1i64 };
    let y = Foo { value: 2i64 };
    if !x.equals(&x) { return 1; }
    if x.equals(&y) { return 2; }
    return 0;
}
