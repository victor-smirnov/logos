package array_wrapper_struct_ctor_b140;

struct ArrayStruct<T, const N: usize> {
    data: [T; N],
}

fn main() -> i32 {
    let s: ArrayStruct<u32, 8> = ArrayStruct { data: [0u32; 8] };
    if s.data[0] != 0u32 { return 1i32; }
    if s.data[7] != 0u32 { return 2i32; }
    return 0i32;
}
