package g10_vec_string;
use logos.mem.collections.vec;
use logos.mem.string;
fn main() -> i32 {
    let mut v: Vec<String> = vec_new::<String>();
    v.push(String::from("hello"));
    v.push(String::from("hi"));
    let a = v.get(0i64);
    let b = v.get(1i64);
    return (a.len() + b.len()) as i32;
}
