package g6_vec_box_dyn_foreach;
use logos.mem.boxed;
use logos.mem.collections.vec;
trait Sh { fn area(self: &Self) -> i64; }
struct Sq { s: i64 }
impl Sh for Sq { fn area(self: &Sq) -> i64 { return self.s*self.s; } }
fn main() -> i32 {
    let mut v: Vec<Box<dyn Sh>> = vec_new::<Box<dyn Sh>>();
    v.push(box_new(Sq { s: 2i64 }));
    v.push(box_new(Sq { s: 3i64 }));
    let mut acc: i64 = 0i64;
    for b in &v { acc = acc + b.area(); }
    if acc != 13i64 { return 1i32; }
    return 0i32;
}
