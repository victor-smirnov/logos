// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/closures/closure-returning-closure (distilled)
// Modifications: i64 suffixes; assert!->if-return; braced closure bodies.
//   Uses Box<dyn Fn..> as the return carrier (Logos has no impl-Trait return per
//   K5/N6; Box<dyn Fn> is the supported return shape).
// Tests closures × trait objects: a function returns a Box<dyn Fn(i64)->i64>
//   capturing a parameter; calling the returned closure adds the captured n.
// GAP (G167-3): a closure LITERAL passed to box_new(...) in return position does
//   not infer its param types from the fn's `Box<dyn Fn(i64)->i64>` return type
//   -> "expected Box<|i64|->i64>, got Box<|<error>|->i64>". Affects capturing AND
//   non-capturing closures. Workaround (verified): bind to a local with an
//   explicit param type first (`let cl = |x: i64| -> i64 {..}; box_new(cl)`).
//   Same root family as G167-2 / G167-1: no closure-param inference from an
//   expected Fn-typed context.
package t03_return_closure;

use logos.mem.boxed;

fn adder(n: i64) -> Box<dyn Fn(i64) -> i64> {
    return box_new(|x| -> i64 { return x + n; });
}

fn main() -> i32 {
    let add5 = adder(5i64);
    let add10 = adder(10i64);
    if add5(1i64) != 6i64 { return 1i32; }
    if add10(1i64) != 11i64 { return 2i32; }
    return 0i32;
}
