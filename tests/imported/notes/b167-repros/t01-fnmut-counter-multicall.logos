// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/closures/closure-expected-type/ (FnMut counter idiom, distilled)
// Modifications: assert!->if-return sentinels; i64 suffixes; bare-body->braced.
// Tests closures × stateful mutation: a `|| { c += 1; c }` FnMut closure that
//   mutates a captured local across MULTIPLE invocations should observe an
//   accumulating value (1,2,3), and the original local should reflect it after.
package t01_fnmut_counter;

fn main() -> i32 {
    let mut c: i64 = 0i64;
    let mut bump = || -> i64 { c = c + 1i64; return c; };
    let a: i64 = bump();
    let b: i64 = bump();
    let d: i64 = bump();
    if a != 1i64 { return 1i32; }
    if b != 2i64 { return 2i32; }
    if d != 3i64 { return 3i32; }
    if c != 3i64 { return 4i32; }
    return 0i32;
}
