// Imported from rust-lang/rust@4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// Original path: tests/ui/unboxed-closures/ (closure-in-struct idiom, distilled)
// Modifications: i64 suffixes; assert!->if-return; braced closure bodies.
// Tests closures × structs: store a closure in a struct field typed as a Fn
//   trait, then call it through the field. Exercises field-stored callable.
// GAP (G167-2): a closure VALUE stored in a generic struct field `F: Fn(..)`
//   cannot be monomorphized — sema produces struct type-arg `|<error>| -> i64`
//   and MLIR-gen fails ("unknown struct 'Holder$G1$|<error>| -> i64'", empty
//   __closure_0 body). A plain `f: fn(i64)->i64` non-generic field works fine
//   (and `(h.f)(5)` calls correctly — contrast B166-N7). The `_` here is only
//   the surface error; with an explicit `Holder<...>` the closure-field mono
//   still fails. Closures only round-trip through fn-ptr-typed fields today.
package t02_closure_in_struct;

struct Holder<F: Fn(i64) -> i64> {
    f: F,
}

fn main() -> i32 {
    let h: Holder<_> = Holder { f: |x| -> i64 { return x + 10i64; } };
    let r: i64 = (h.f)(5i64);
    if r != 15i64 { return 1i32; }
    return 0i32;
}
