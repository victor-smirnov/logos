package dropck_eyepatch_reorder;
struct Dr<'a> { name: i64, r: &'a i64 }
impl<'a> Drop for Dr<'a> { fn drop(&mut self) { let v: i64 = *self.r; } }
fn main() -> i32 {
  let d: Dr;
  let c: i64 = 1i64;
  d = Dr { name: 7i64, r: &c };
  return 0i32;
}
