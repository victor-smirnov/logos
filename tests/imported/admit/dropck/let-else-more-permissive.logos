package let_else_more_permissive;
struct St<'a> { r: &'a i64 }
impl<'a> Drop for St<'a> { fn drop(self: &mut St<'a>) { } }
fn main() -> i32 {
    let zero: i64 = 0i64;
    let mut long1: St = St { r: &zero };
    let short1: i64 = 1i64;
    long1.r = &short1;
    return 0i32;
}
