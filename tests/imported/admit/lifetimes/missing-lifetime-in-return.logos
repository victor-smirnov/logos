package missing_lifetime_in_return;
struct Thing<'a, Q> { x: &'a Q }
fn thing<'a, Q>(x: &Q) -> Thing<'a, Q> { return Thing { x: x }; }
fn main() -> i32 { let u: i64 = 1i64; let t = thing(&u); return 0i32; }
