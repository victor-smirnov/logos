package temporary_lifetime_extension_tuple_ctor;
struct T { n: i64 }
struct X<'a> { r: &'a T }
fn temp() -> T { return T { n: 5i64 }; }
fn mk(r: &T) -> X { return X { r: r }; }
fn main() -> i32 {
    let g = mk(&temp());
    if g.r.n != 5i64 { return 1i32; }
    return 0i32;
}
