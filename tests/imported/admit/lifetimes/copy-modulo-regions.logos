package copy_modulo_regions;

struct Foo<'a> { f: &'a i64 }

impl Copy for Foo<'static> { }

fn mk_foo<'a>(r: &'a i64) -> Foo<'a> { return Foo { f: r }; }

fn foo<'a>(r: &'a i64) -> [Foo<'a>; 4] {
    let x = mk_foo(r);
    return [x; 4];
}

fn main() -> i32 { return 0i32; }
