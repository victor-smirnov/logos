package trait_impl_mismatch_elided_lifetime_issue_65866;
struct Foo;
struct Re<'a> { data: &'a u16 }
trait Bar { fn bar(self: &Self, r: &mut Re); }
impl Bar for Foo { fn bar<'a, 'b>(self: &'a Self, r: &'b mut Re<'a>) { } }
fn main() -> i32 { return 0i32; }
