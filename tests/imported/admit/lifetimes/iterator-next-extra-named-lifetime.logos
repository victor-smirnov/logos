package iterator_next_extra_named_lifetime;
trait Itr { type Item; fn next(self: &mut Self) -> Option<Self::Item>; }
struct RepeatMut<'a, T> { zero: T, one: &'a i64 }
impl<'a, T: 'a> Itr for RepeatMut<'a, T> {
    type Item = &'a mut T;
    fn next(self: &'a mut Self) -> Option<Self::Item> { return Option::Some(&mut self.zero); }
}
fn main() -> i32 { return 0i32; }
