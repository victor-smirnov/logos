// semantic port of rust ui/lifetimes/issue-17728.rs
// core: a trait DEFAULT method whose elided return lifetime comes from &self,
// but which returns something borrowed from another parameter.
package issue_17728;

struct Room { d: i64 }

trait TraversesWorld {
    fn attemptTraverse(self: &Self, room: &Room) -> &Room {
        return room;
    }
}

struct Player { n: i64 }
impl TraversesWorld for Player { }

fn main() -> i32 { return 0i32; }
