// rustc lifetimes/lifetime-errors/trait-method-return-lifetime-mismatch.rs — upstream E0308 mismatched types (lifetime mismatch)
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root lifereg.L1
// RE-PORTED AS-IS 2026-09-08 (stage 6). The old port carried the construct; this
// pass restores upstream's shape exactly — the return type's ELIDED lifetime is
// filled from the receiver, while `R: Resources<'a>` and the `'a` in
// `BufferViewHandle<'a, R>` force the trait's own `'a`, and the two cannot be the
// same region.
// Original path: tests/ui/lifetimes/lifetime-errors/trait-method-return-lifetime-mismatch.rs
// upstream commit: da5114692c9ebe46b869488c5f34f92eb10b98c1
// upstream construct: lines 7-16 —
//     pub trait Buffer<'a, R: Resources<'a>> {
//         fn select(&self) -> BufferViewHandle<R>;
//         //~^ ERROR mismatched types   //~| NOTE lifetime mismatch
//     }
//     pub struct BufferViewHandle<'a, R: 'a+Resources<'a>>(&'a R);
// Modifications:
//   · `pub` dropped (not needed to reach the door)
//   · `Resources<'a>` is an empty marker trait upstream; it carries one method here
//     because Logos has no empty-trait form in this position
//   · tuple struct `BufferViewHandle<'a, R>(&'a R)` -> a named field `r: &'a R`
//   · `R: 'a + Resources<'a>` -> `R: Resources<'a>` (no `T: 'lifetime` outlives
//     bound syntax on a struct parameter here)
//   · assert -> exit code: `fn main() -> i32`
//   The elided return-position lifetime of `select` — the whole subject — is kept.
package trait_method_return_lifetime_mismatch;
trait Resources<'a> { fn n(self: &Self) -> i64; }
struct BufferViewHandle<'a, R: Resources<'a>> { r: &'a R }
trait Buffer<'a, R: Resources<'a>> {
  fn select(self: &Self) -> BufferViewHandle<R>;   // THE DEFECT: admitted, upstream E0308
}
fn main() -> i32 { return 0i32; }
