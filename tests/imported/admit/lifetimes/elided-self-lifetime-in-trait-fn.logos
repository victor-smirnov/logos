// rustc lifetimes/elided-self-lifetime-in-trait-fn.rs — upstream lifetime may not live long enough
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root lifereg.L1
// RE-PORTED AS-IS 2026-09-08 (stage 6). The old port already carried the construct;
// this pass only restores the provenance and the default-method BODY as upstream
// writes it (upstream's `b` has no return value and simply calls `self.a()`).
// Original path: tests/ui/lifetimes/elided-self-lifetime-in-trait-fn.rs
// upstream commit: 4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// upstream construct: lines 2-7 —
//     trait T<'a> {
//         fn a(&'a self) -> &'a bool;
//         fn b(&self) {
//             self.a();
//             //~^ ERROR lifetime may not live long enough
// Modifications:
//   · `&self` / `&'a self` -> the explicit `self: &Self` / `self: &'a Self` form
//     (Logos has no sugared `&self` receiver)
//   · assert -> exit code: `fn main() -> i32`
//   The elided receiver lifetime of `b` and the `'a`-bound receiver of `a` — the
//   whole subject — are kept: `b`'s `&Self` is a fresh region, `a` demands `'a`.
package elided_self_lifetime_in_trait_fn;
trait T2<'a> {
  fn a(self: &'a Self) -> &'a bool;
  fn b(self: &Self) { let r = self.a(); }   // THE DEFECT: admitted, upstream E0521-class
}
fn main() -> i32 { return 0i32; }
