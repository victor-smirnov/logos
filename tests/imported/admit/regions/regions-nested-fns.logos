package regions_nested_fns;
fn nested<'x>(x: &'x i64) -> &'x i64 {
  let y = 3i64;
  let mut ay: &i64 = x;
  let mut f = || { ay = &y; };
  f();
  return ay;
}
fn main() -> i32 { let q = 7i64; let r = nested(&q); if *r != 7i64 { return 1i32; } return 0i32; }
