package regions_ret_borrowed;
fn with<R, F>(f: F) -> R where F: FnOnce(&i64) -> R { return f(&3i64); }
fn return_it<'a>() -> &'a i64 { return with(|o| o); }
fn main() -> i32 { let x: &i64 = return_it(); return *x as i32; }
