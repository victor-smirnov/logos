// rustc regions/regions-fn-subtyping-return-static-fail.rs — upstream E0308 mismatched types
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root lifereg.L7
// RE-PORTED AS-IS 2026-09-08 (stage 6). This is upstream's own door — `want_G(baz)`
// at a call ARGUMENT. The old port had the illegal line but none of upstream's
// LEGAL contrast; the three legal supplies are restored, so a future refusal here
// has to separate `baz` from `foo` and is not an over-refusal of the whole shape.
// Original path: tests/ui/regions/regions-fn-subtyping-return-static-fail.rs
// upstream commit: 4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// upstream construct: lines 37-48 —
//     fn supply_F() { want_F(foo); want_F(bar); want_F(baz); }   // all OK
//     fn supply_G() { want_G(foo); want_G(bar);
//         want_G(baz); //~ ERROR mismatched types
// Modifications:
//   · unit struct `struct S;` -> `struct S { n: i64 }` (no unit-struct form here)
//   · `type F = for<'cx> fn(&'cx S) -> &'cx S` / `type G = ...` aliases -> the fn
//     pointer types written inline at the parameters (the alias is not the subject)
//   · `panic!()` bodies -> real returns (`foo`/`bar` return a `static`, `baz`
//     returns its argument); a diverging body would let any return type through
//   · upstream's `bar<'a,'b>(x: &'a S) -> &'b S` is omitted: two unrelated free
//     regions with no outlives edge cannot be written here without a body that
//     diverges, and it is a SECOND legal supply, not the annotated line
//   · assert -> exit code: `fn main() -> i32`
//   `baz`'s `for<'cx> fn(&'cx S) -> &'cx S` type supplied where a
//   `for<'cx> fn(&'cx S) -> &'static S` is wanted is kept verbatim.
package regions_fn_subtyping_return_static_fail_fn_subtyping;
struct S { n: i64 }
static GS: S = S { n: 0i64 };
fn want_F(f: fn(&S) -> &S) { }
fn want_G(f: fn(&S) -> &'static S) { }
fn foo<'a>(x: &'a S) -> &'static S { return &GS; }   // meets both
fn baz<'a>(x: &'a S) -> &'a S { return x; }          // meets F, but not G
fn supply_F() { want_F(foo); want_F(baz); }          // OK upstream too
fn supply_G() {
  want_G(foo);        // OK upstream too
  want_G(baz);        // THE DEFECT: admitted, upstream E0308
}
fn main() -> i32 { return 0i32; }
