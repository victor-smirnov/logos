package impl_trait_lifetime_conflict_hashmap_keys_sig_only;
struct Keys<K, V> { k: K, v: V }
struct MyMap<K, V> { k: K, v: V }
struct Subject<'a, T, V, R> { p: Option<&'a T>, q: Option<V>, r: Option<R> }
trait MapAssertion<'a, K, V, R> { fn key_set(self: &Self) -> Subject<Keys<K, V>, (), R>; }
impl<'a, K, V, R> MapAssertion<'a, K, V, R> for Subject<'a, MyMap<K, V>, (), R> {
    fn key_set(self: &Self) -> Subject<'static, Keys<K, V>, (), R> { return loop {}; }
}
fn main() -> i32 { return 0i32; }
