package impl_trait_lifetime_conflict_hashmap_keys;
struct Subject<'a, T> { p: &'a T }
trait MapAssertion<'a, K> {
  fn key_set(self: &Self) -> Subject<'a, K>;
}
struct M<'a, K> { p: &'a K }
impl<'a, K> MapAssertion<'a, K> for M<'a, K> {
  fn key_set(self: &Self) -> Subject<'static, K> { return Subject { p: self.p }; }
}
fn main() -> i32 { return 0i32; }
