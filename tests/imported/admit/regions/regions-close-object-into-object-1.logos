package regions_close_object_into_object_1;
trait X { fn m(&self) -> i64; }
struct B<'a> { r: &'a i64 }
impl<'a> X for B<'a> { fn m(&self) -> i64 { return *self.r; } }
fn f(v: Box<i64>) -> Box<dyn X> { return Box::new(B { r: &*v }); }
fn main() -> i32 { let b = f(Box::new(4i64)); if b.m() != 4i64 { return 1i32; } return 0i32; }
