package enum_drop_access;
// nll/enum-drop-access.rs (reshaped: no nested pattern) — E0713 borrow may still
// be in use when destructor runs: the Drop impl can observe the &mut the value holds.
struct DropOpt { r: &mut i64 }
impl Drop for DropOpt { fn drop(self: &mut DropOpt) { *self.r = 9i64; } }
fn drop_enum(opt: DropOpt) -> &mut i64 { return opt.r; }
fn main() -> i32 {
    let mut n: i64 = 1i64;
    let d = DropOpt { r: &mut n };
    let out = drop_enum(d);
    *out = 5i64;
    return 0i32;
}
