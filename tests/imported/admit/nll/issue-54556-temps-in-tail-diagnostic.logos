// rustc nll/issue-54556-temps-in-tail-diagnostic.rs — upstream E0597 does not live long enough
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root nllmoves.D
// RE-PORTED AS-IS 2026-09-07 (stage 5). The previous port had flattened upstream's
// GENERIC tuple struct `D<T>(T)` into two distinct monomorphic structs (`Thing`
// and `D { r: &Thing }`), which loses the property the test is named for: the
// temporary `D(&_thing1)` in TAIL position has the same type constructor as the
// local it borrows, and both have drop glue. Generic tuple structs with a `Drop`
// impl compile here (measured 2026-09-07), so the shape is restored.
// Original path: tests/ui/nll/issue-54556-temps-in-tail-diagnostic.rs
// upstream commit: 4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// upstream construct: line 5 —
//     D(&_thing1).end() //~ ERROR does not live long enough
// Modifications:
//   · upstream's BARE BLOCK inside `main` -> a function body. MEASURED 2026-09-07:
//     a bare block used as a statement whose tail carries a value is a syntax error
//     here (`syntax error near '}'`), and binding that block to a `let` instead
//     drives mlir_gen into an internal error (`& undefined '_thing1'`, rc 141).
//     A function body is the SAME drop-order position — the tail's temporaries are
//     dropped after the body's locals — and it is the position the language has.
//   · `Box::new("thing1")` -> `Box::new(1i64)` (no &str literal into Box here);
//     the payload is scenery, what matters is that it has drop glue
//   · `#[derive(Debug)]` + the `println!` in `Drop::drop` -> an empty drop body
//     and no `Debug` bound; the trait bound is scenery for the borrow question
//   · `fn end(&self)` returns `()` upstream and `i64` here, so the tail has a value
//   · `fn next<U>` is unused by this sub-test and is dropped
//   · assert -> exit code: `fn main() -> i32`
package issue_54556_temps_in_tail_diagnostic;
struct D<T>(T);
impl<T> Drop for D<T> { fn drop(self: &mut D<T>) { } }
impl<T> D<T> { fn end(self: &D<T>) -> i64 { return 0i64; } }
fn scope() -> i64 {
    let mut _thing1: D<Box<i64>> = D(Box::new(1i64));
    D(&_thing1).end()          // THE DEFECT: admitted, upstream E0597
}
fn main() -> i32 { return scope() as i32; }
