// nll/match-guards-partially-borrow.rs (representative 2: bad_indirect_mutation_in_if_guard)
fn bad_indirect(mut y: &bool) {
    match *y {
        true => {}
        false if { y = &true; false } => {}
        _ => {}
    }
}
fn main() -> i32 { let b: bool = false; bad_indirect(&b); return 0i32; }
