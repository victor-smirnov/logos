// Modifications:
//   · i32 -> i64
//   · the closure's parameter and return types are written out (`|y: &i64| -> &i64`);
//     Logos does not infer a closure signature from its call sites. THIS WEAKENS THE
//     PORT and it is recorded rather than hidden: with the types spelled out the two
//     call sites no longer SHARE one inference variable, so the port asks the narrower
//     question "is the returned region checked at all". It is not.
//   · assert -> exit code: `fn main() -> i32`
package issue_48697_t16;
fn foo(x: &i64) -> &i64 {
    let z: i64 = 4i64;
    let f = &|y: &i64| -> &i64 { return y; };
    let k = f(&z);
    return f(x);
}
fn main() -> i32 { return 0i32; }
