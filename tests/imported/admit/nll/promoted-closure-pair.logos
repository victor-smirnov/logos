package promoted_closure_pair;
// nll/promoted-closure-pair.rs — returning a borrow produced by a promoted constant
// holding closures.
fn foo() -> &'static i64 {
    let z: i64 = 0i64;
    let p = (|y: &i64| -> &i64 { return y; },);
    return p.0(&z);
}
fn main() -> i32 { return *foo() as i32; }
