// shelf: admit · root nllmoves.B
// FINDING reduction from tests/ui/nll/maybe-initialized-drop-implicit-fragment-drop.rs
// a borrow held in a struct field is forgotten as soon as that struct is itself
// composed into ANOTHER struct (one extra hop; the un-nested form is refused)
package maybe_initialized_drop_implicit_fragment_drop_f_nested_holder;
struct Wrap { p: &mut i64 }
struct Foo { b: Wrap }
fn main() -> i32 {
    let mut x: i64 = 0i64;
    let w = Wrap { p: &mut x };
    let f = Foo { b: w };
    x = 1i64;
    return *f.b.p as i32;
}
