//   INVARIANT carriers (`*const &mut &'a`, `*mut &'a`, `fn(&'c mut &'a)`).
// 2026-09-08 re-port: STILL ADMITTED, at all three annotated doors.
package type_check_pointer_comparisons;
fn compare_const<'a, 'b>(x: *const &mut &'a i64, y: *const &mut &'b i64) { x == y; }
fn compare_mut<'a, 'b>(x: *mut &'a i64, y: *mut &'b i64) { x == y; }
fn compare_fn_ptr<'a, 'b, 'c>(f: fn(&'c mut &'a i64), g: fn(&'c mut &'b i64)) { f == g; }
fn compare_hr_fn_ptr<'a>(f: fn(&'a i64), g: fn(&i64)) { f == g; }
fn compare_const_fn_ptr<'a>(f: *const fn(&'a i64), g: *const fn(&i64)) { f == g; }
fn main() -> i32 { return 0i32; }
