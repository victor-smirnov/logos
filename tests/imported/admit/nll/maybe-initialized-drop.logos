package maybe_initialized_drop;
struct Wrap { p: &mut i64 }
impl Drop for Wrap { fn drop(self: &mut Wrap) { *self.p = *self.p + 1i64; } }
fn main() -> i32 {
    let mut x: i64 = 0i64;
    let wrap = Wrap { p: &mut x };
    x = 1i64;
    return 0i32;
}
