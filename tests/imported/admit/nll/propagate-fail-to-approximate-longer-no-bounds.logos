// shelf: admit · root nllmoves.A
// Original path: tests/ui/nll/closure-requirements/propagate-fail-to-approximate-longer-no-bounds.rs @ 4b0c9d76a
// Modifications: u32 -> i64; `#![feature(rustc_attrs)]` and `#[rustc_regions]` dropped
//   (compiler-internal debug attributes, not part of the construct); the
//   `-Zverbose-internals` compile flag dropped for the same reason; `fn main() {}` ->
//   `fn main() -> i32 { return 0i32; }`.
//   `std::cell::Cell<T>` is spelled as the corpus's established stand-in — a struct
//   with a `*mut T` field, which is INVARIANT in T exactly as Cell is (same device as
//   tests/imported/fail/variance/variance-cell-is-invariant.logos). The invariance is
//   the whole reason Cell is in the upstream test, and it is preserved.
//   ⚠ WHAT THE PREVIOUS PORT DID: it deleted the closure, the HRTB bound and Cell
//   entirely and wrote `demand_y(a, b, a)` between two plain `&i64` parameters — which
//   is LEGAL Rust (regions may shrink), so the row was standing on a program rustc
//   accepts. The construct restored here is the real one: a closure passed to a bound
//   `for<'x,'y> FnMut(&Cell<&'y &'b i64>, &Cell<&'x i64>, &Cell<&'y i64>)` whose body
//   demands `'x: 'y`, a relation the callee's `'b: 'y` cannot supply.
// 2026-09-08 re-port: STILL ADMITTED, now with the construct actually present.
package propagate_fail_to_approximate_longer_no_bounds;
struct Cell<T> { p: *mut T }
impl<T> Cell<T> { fn get(&self) -> T { unsafe { return *self.p; } } }
fn establish_relationships<'a, 'b, F>(cell_a: &Cell<&'a i64>, cell_b: &Cell<&'b i64>, closure: F)
where F: for<'x, 'y> FnMut(&Cell<&'y &'b i64>, &Cell<&'x i64>, &Cell<&'y i64>)
{ }
fn demand_y<'x, 'y>(cell_x: &Cell<&'x i64>, cell_y: &Cell<&'y i64>, y: &'y i64) { }
fn supply<'a, 'b>(cell_a: Cell<&'a i64>, cell_b: Cell<&'b i64>) {
    establish_relationships(&cell_a, &cell_b,
        |outlives: &Cell<& &i64>, x: &Cell<&i64>, y: &Cell<&i64>| {
            demand_y(x, y, x.get());
        });
}
fn main() -> i32 { return 0i32; }
