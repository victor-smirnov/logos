package projection_no_regions_closure_projection_no_regions_closure;
trait Anything { fn a(self: &Self) -> i64; }
struct Holder<'a> { v: &'a i64 }
impl<'a> Anything for Holder<'a> { fn a(self: &Self) -> i64 { return *self.v; } }
fn with_signature<'a, T, F>(x: T, op: F) -> Holder<'a> where F: Fn(T) -> Holder<'a> {
    return op(x);
}
fn no_region<'a, 'b>(x: &'b i64) -> Holder<'a> {
    return with_signature::<&'b i64, fn(&'b i64) -> Holder<'a>>(x, mk);
}
fn mk<'b, 'a>(y: &'b i64) -> Holder<'a> { return Holder { v: y }; }
fn main() -> i32 { return 0i32; }
