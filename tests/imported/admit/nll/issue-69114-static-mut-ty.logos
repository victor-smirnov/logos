package issue_69114_static_mut_ty;
static FOO: u8 = 42u8;
static mut BAR: &u8 = &FOO;
static mut BAR_ELIDED: &u8 = &FOO;
fn set_bar() {
    let n: u8 = 42u8;
    unsafe { BAR = &n; }
}
fn set_bar_elided() {
    let n: u8 = 42u8;
    unsafe { BAR_ELIDED = &n; }
}
fn main() -> i32 {
    unsafe {
        set_bar();
        set_bar_elided();
        return (*BAR + *BAR_ELIDED) as i32;
    }
}
