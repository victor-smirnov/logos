// rustc nll/issue-69114-static-mut-ty.rs — upstream E0597 `n` does not live long enough
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root nllmoves.R1
// port of rust tests/ui/nll/issue-69114-static-mut-ty.rs
// `BAR` is a `static mut &'static u8`; assigning a borrow of a function local
// to it must be rejected.  rustc: E0597 `n` does not live long enough.
package issue_69114_static_mut_ty;
static FOO: u8 = 42u8;
static mut BAR: &u8 = &FOO;
fn set_bar() {
    let n: u8 = 42u8;
    unsafe { BAR = &n; }
}
fn main() -> i32 {
    set_bar();
    unsafe { return *BAR as i32; }
}
