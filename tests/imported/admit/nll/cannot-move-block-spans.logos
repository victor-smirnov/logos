package cannot_move_block_spans;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) {} }
fn deref(r: &S) -> i64 {
    let x = { *r };
    return x.v;
}
fn main() -> i32 { let s = S { v: 2i64 }; return deref(&s) as i32; }
