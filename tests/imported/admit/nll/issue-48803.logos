package issue_48803;
fn flatten<'a>(x: &'a &'a i64) -> &'a i64 { return *x; }
fn main() -> i32 {
    let mut x: i64 = 1i64;
    let y = &x;
    let z = &y;
    let w = flatten(z);
    x = 2i64;
    let _ = *w;
    return 0i32;
}
