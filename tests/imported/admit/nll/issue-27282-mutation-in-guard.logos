package issue_27282_mutation_in_guard;
fn main() -> i32 {
  let mut o: i64 = 1i64;
  match o {
    ref mut foo => { let a: &mut i64 = foo; let b: &mut i64 = foo; *a = 5i64; *b = 7i64; }
  }
  return 0i32;
}
