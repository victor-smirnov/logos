package do_not_ignore_lifetime_bounds_in_copy;
struct Foo<'a> { v: &'a i64 }
impl Copy for Foo<'static> {}
fn drop_it(f: Foo) -> i64 { return *f.v; }
fn main() -> i32 {
    let s: i64 = 2i64;
    let a = Foo { v: &s };
    let _ = drop_it(a);
    let _ = drop_it(a);
    return 0i32;
}
