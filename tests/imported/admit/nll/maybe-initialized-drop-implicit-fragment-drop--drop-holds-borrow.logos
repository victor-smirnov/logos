package maybe_initialized_drop_implicit_fragment_drop_drop_holds_borrow;
struct Wrap { p: &mut i64 }
impl Drop for Wrap { fn drop(self: &mut Wrap) { *self.p += 1i64; } }
struct Foo { a: i64, b: Wrap }
fn eat(w: Wrap) -> i64 { return 0i64; }
fn main() -> i32 {
    let mut x: i64 = 0i64;
    let wrap = Wrap { p: &mut x };
    let foo = Foo { a: 1i64, b: wrap };
    let _ = eat(foo.b);
    x = 1i64;
    return x as i32;
}
