// Modifications:
//   · `Box<()>` -> `Box<i64>`; Logos has no unit type to put in a Box, and the referent
//     type is not the subject — the escaping `&mut` to a CAPTURE is
//   · assert -> exit code: `fn main() -> i32`
package issue_40510_1;
use logos.mem.boxed;
fn f() {
    let mut x: Box<i64> = Box::new(0i64);
    || { return &mut x; };
}
fn main() -> i32 { return 0i32; }
