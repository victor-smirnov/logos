package issue_52113;
trait Bazinga { fn go(self: &Self) -> i64; }
struct Keep<'a> { v: &'a i64 }
impl<'a> Bazinga for Keep<'a> { fn go(self: &Self) -> i64 { return *self.v; } }
fn produce_err<'a, 'b>(value: &'a i64) -> Keep<'b> {
    return Keep { v: value };
}
fn main() -> i32 { return 0i32; }
