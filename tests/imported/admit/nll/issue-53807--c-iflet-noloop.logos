package issue_53807_c_iflet_noloop;
struct Pay { n: i64 }
impl Drop for Pay { fn drop(self: &mut Pay) {} }
fn main() -> i32 {
    let maybe: Option<Pay> = Option::Some(Pay { n: 1i64 });
    if let Option::Some(a) = maybe { let _ = a.n; }
    if let Option::Some(b) = maybe { let _ = b.n; }
    return 0i32;
}
