// rustc nll/issue-51268.rs — upstream E0502 cannot borrow `self.thing` as mutable because also borrowed as immutable
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root nllmoves.C
// port of nll/issue-51268.rs
package issue_51268;
struct Bar { k: i64 }
impl Bar { fn bar<F>(self: &mut Bar, _f: F) where F: Fn() {} }
struct Foo { thing: Bar, number: u64 }
impl Foo {
    fn foo(self: &mut Foo) {
        self.thing.bar(|| { let _n: u64 = self.number; });  // E0502
    }
}
fn main() -> i32 { let mut f: Foo = Foo { thing: Bar { k: 0i64 }, number: 1u64 }; f.foo(); return 0i32; }
