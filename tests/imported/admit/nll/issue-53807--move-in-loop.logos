// rustc nll/issue-53807.rs — upstream use of moved value
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root nllmoves.NEW-N1
// port of nll/issue-53807.rs: `if let Some(t) = maybe` moves out, inside a loop
package issue_53807_move_in_loop;
struct Pay { n: i64 }
impl Drop for Pay { fn drop(self: &mut Pay) {} }
fn main() -> i32 {
    let maybe: Option<Pay> = Option::Some(Pay { n: 1i64 });
    let mut k: i64 = 0i64;
    loop {
        if let Option::Some(thing) = maybe {   // use of moved value on 2nd iteration
            k = k + thing.n;
        }
        if k > 3i64 { break; }
    }
    return 0i32;
}
