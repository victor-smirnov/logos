package move_deref_coercion;
struct NotCopy { inner: bool }
impl Drop for NotCopy { fn drop(self: &mut NotCopy) {} }
struct Foo { first: NotCopy, second: NotCopy }
impl Deref for Foo {
    type Target = NotCopy;
    fn deref(self: &Foo) -> &NotCopy { return &self.second; }
}
fn use_field(val: Foo) -> i32 {
    let _val = val.first;
    let b = val.inner;
    if b { return 1i32; }
    return 0i32;
}
fn main() -> i32 {
    let f = Foo { first: NotCopy { inner: true }, second: NotCopy { inner: false } };
    return use_field(f);
}
