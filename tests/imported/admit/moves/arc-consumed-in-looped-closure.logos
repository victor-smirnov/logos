package arc_consumed_in_looped_closure;
struct V { x: i64 }
impl Drop for V { fn drop(self: &mut V) {} }
fn consume(v: V) -> i64 { return v.x; }
fn main() -> i32 {
    let v: V = V { x: 1i64 };
    let mut i: i64 = 0i64;
    let mut acc: i64 = 0i64;
    while i < 3i64 {
        let f = || -> i64 { return consume(v); };
        acc = acc + f();
        i = i + 1i64;
    }
    return acc as i32;
}
