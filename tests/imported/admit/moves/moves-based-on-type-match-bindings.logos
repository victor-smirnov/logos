package moves_based_on_type_match_bindings;
// moves/moves-based-on-type-match-bindings.rs — E0382 borrow of partially moved value
struct A { v: i64 }
impl Drop for A { fn drop(self: &mut A) {} }
struct Foo { f: A }
fn touch(a: &Foo) -> i64 { return a.f.v; }
fn main() -> i32 {
    let x = Foo { f: A { v: 1i64 } };
    match x { Foo { f } => { let _ = f.v; } }
    let _ = touch(&x);
    return 0i32;
}
