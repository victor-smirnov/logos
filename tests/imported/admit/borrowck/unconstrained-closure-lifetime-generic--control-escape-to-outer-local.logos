// control for t38: the SAME closure over the SAME dying borrow, stored into a
// plain outer LOCAL instead of a field behind `&mut self`. One difference.
package unconstrained_closure_lifetime_generic_control_escape_to_outer_local;
fn main() -> i32 {
    let b: Box<dyn Fn() -> u64>;
    {
        let f: u64 = 7u64;
        let r: &u64 = &f;
        b = Box::new(|| -> u64 { return *r; });
    }
    return b() as i32;
}
