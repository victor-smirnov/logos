package borrowck_loan_blocks_mut_uniq;
use logos.mem.boxed;
fn borrow<F>(v: &i64, f: F) where F: FnOnce(&i64) { f(v); }
fn main() -> i32 {
    let mut v: Box<i64> = Box::new(3i64);
    borrow(&*v, |w| { v = Box::new(4i64); let _ = *w; });
    return 0i32;
}
