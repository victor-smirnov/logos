package two_phase_multi_mut;
struct Foo { a: i64 }
impl Foo {
    fn method(self: &mut Foo, foo: &mut Foo) -> i64 { return self.a + foo.a; }
}
fn main() -> i32 {
    let mut foo = Foo { a: 1i64 };
    let r = foo.method(&mut foo);
    return r as i32;
}
