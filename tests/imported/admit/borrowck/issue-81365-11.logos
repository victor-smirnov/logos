package issue_81365_11;
struct DerefTarget { target_field: bool }
struct Container { target: DerefTarget, container_field: bool }
impl Deref for Container { type Target = DerefTarget; fn deref(self: &Self) -> &DerefTarget { return &self.target; } }
impl DerefMut for Container { fn deref_mut(self: &mut Self) -> &mut DerefTarget { return &mut self.target; } }
fn use_b(b: &mut bool) { }
fn bad_borrow(s: &mut Container) -> i32 {
    let first: &mut bool = &mut (*s).target_field;
    s.container_field = true;
    use_b(first);
    return 0i32;
}
fn main() -> i32 { let mut c: Container = Container { target: DerefTarget { target_field: false }, container_field: false }; return bad_borrow(&mut c); }
