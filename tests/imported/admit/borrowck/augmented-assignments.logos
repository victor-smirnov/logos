package augmented_assignments;
struct Int { v: i32 }
impl AddAssign for Int { fn add_assign(self: &mut Self, o: Int) { self.v = self.v + o.v; } }
fn main() -> i32 {
    let mut x: Int = Int { v: 1i32 };
    x += x;
    return 0i32;
}
