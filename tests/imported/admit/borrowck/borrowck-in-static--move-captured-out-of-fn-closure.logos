// upstream: borrowck/borrowck-in-static.rs  E0507 cannot move out of `x`, a captured variable in an `Fn` closure
package borrowck_in_static_move_captured_out_of_fn_closure;
struct S { n: i64 }
impl Drop for S { fn drop(self: &mut S) {} }
fn main() -> i32 {
    let x: S = S { n: 1i64 };
    let g = || { let y = x; return y.n; };
    let a = g();
    let b = g();
    return (a + b) as i32 - 2i32;
}
