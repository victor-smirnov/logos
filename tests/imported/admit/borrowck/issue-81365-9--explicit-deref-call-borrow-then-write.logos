package issue_81365_9_explicit_deref_call_borrow_then_write;
use logos.lang.ops;
struct DerefTarget { target_field: bool }
struct Container { target: DerefTarget, container_field: bool }
impl Deref for Container {
    type Target = DerefTarget;
    fn deref(self: &Container) -> &DerefTarget { return &self.target; }
}
impl Container {
    fn bad_borrow(self: &mut Container) -> i32 {
        let first = &Deref::deref(self).target_field;
        self.container_field = true;
        let _ = *first;
        return 0i32;
    }
}
fn main() -> i32 {
    let mut c = Container { target: DerefTarget { target_field: false }, container_field: false };
    return c.bad_borrow();
}
