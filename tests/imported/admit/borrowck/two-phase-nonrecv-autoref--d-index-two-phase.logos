package two_phase_nonrecv_autoref_d_index_two_phase;
fn put(a: &mut [i64; 4], i: i64, v: i64) { a[i] = v; }
fn get(a: &[i64; 4], i: i64) -> i64 { return a[i]; }
fn main() -> i32 {
    let mut a: [i64; 4] = [0i64, 1i64, 2i64, 3i64];
    put(&mut a, 0i64, get(&a, 3i64));
    return 0i32;
}
