// rustc borrowck/mut-borrow-of-mut-ref.rs — upstream E0596
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root bck.A-REFPARAM
// Original path: tests/ui/borrowck/mut-borrow-of-mut-ref.rs @ 4b0c9d76a
// Modifications: i32 -> i64; `#![crate_type = "rlib"]` dropped (no crate attributes,
//   and a `main` is needed to link); `fn main` added.
//   The callee `h(_: &mut i32)` is spelled `h2(_: &mut &mut i64)` HERE ONLY: upstream
//   writes `h(&mut b)` and rustc DEREF-COERCES `&mut &mut i32` down to `&mut i32`.
//   Logos has no such coercion — the as-is line answers a TYPE error, "call to 'h'
//   arg 1: expected &mut i64, got &mut &mut i64", which is a different subject.
//   Giving `h2` the un-coerced type keeps the BORROW SITE `&mut b` letter for letter,
//   which is the construct the test exists for. (Backlog: refmut_refmut_deref_coercion.)
//   `pub fn baz` and `impl Foo for &mut String` are not ported — an inherent impl on a
//   REFERENCE type; that third is upstream's method-call spelling of the same E0596
//   and adds no construct this file does not already carry.
// 2026-09-08 re-port: STILL ADMITTED, at BOTH doors — `h2(&mut b)` in `f` and the
//   doubled `&mut &mut b` in `g`.
package mut_borrow_of_mut_ref;
fn h2(x: &mut &mut i64) { }
fn g(b: &mut i64) {
    h2(&mut b);
}
fn f(b: &mut i64) {
    h2(&mut b);
    g(b);
}
fn main() -> i32 { let mut v: i64 = 0i64; f(&mut v); return 0i32; }
