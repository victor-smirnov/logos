package borrowck_move_out_of_tuple_struct_with_dtor_t13;
struct Inner { a: i64 }
struct S { f: Inner }
impl Drop for S { fn drop(self: &mut S) {} }
fn main() -> i32 {
    let s = S { f: Inner { a: 1i64 } };
    let S { f: inner } = s;
    return inner.a as i32;
}
