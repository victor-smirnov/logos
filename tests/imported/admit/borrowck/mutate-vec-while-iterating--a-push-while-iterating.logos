package mutate_vec_while_iterating_a_push_while_iterating;
fn main() -> i32 {
    let mut values: Vec<i64> = Vec::new();
    values.push(1i64); values.push(2i64);
    for value in &values {
        if *value == 2i64 { values.push(4i64); }
    }
    return 0i32;
}
