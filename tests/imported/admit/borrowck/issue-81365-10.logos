package issue_81365_10;
struct DerefTarget { target_field: bool }
struct Container { target: DerefTarget, container_field: bool }
impl Deref for Container {
    type Target = DerefTarget;
    fn deref(self: &Container) -> &DerefTarget { return &self.target; }
}
impl Container {
    fn bad_borrow(self: &mut Container) {
        let first: &bool = &self.deref().target_field;
        self.container_field = true;
        let _ = *first;
    }
}
fn main() -> i32 { let mut c: Container = Container { target: DerefTarget { target_field: false }, container_field: false }; c.bad_borrow(); return 0i32; }
