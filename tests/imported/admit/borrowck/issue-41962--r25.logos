package issue_41962_r25;
static mut DROPS: i64 = 0i64;
struct V { a: i64 }
impl Drop for V { fn drop(self: &mut V) { unsafe { DROPS = DROPS + 1i64; } } }
enum Opt { Some(V), None }
fn main() -> i32 {
    let maybe = Opt::Some(V { a: 1i64 });
    let mut i: i64 = 0i64;
    let mut sum: i64 = 0i64;
    while i < 3i64 {
        match maybe { Opt::Some(thing) => { sum = sum + thing.a; } Opt::None => {} }
        i = i + 1i64;
    }
    unsafe { return (DROPS * 10i64 + sum) as i32; }
}
