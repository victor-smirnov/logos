// rustc borrowck/borrowck-loan-vec-content.rs — upstream E0499 cannot borrow `v` as mutable
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root bck.B
// RE-PORTED AS-IS 2026-09-07 (stage 5). The previous port had DROPPED the closure
// entirely — it was `let e = &v[0]; v[1] = 4;`, a direct conflicting borrow, which
// is a different mechanism from upstream's "the mutable capture of `v` by a closure
// passed alongside a live shared loan of `v[0]`". The closure is the subject here.
// Original path: tests/ui/borrowck/borrowck-loan-vec-content.rs
// upstream commit: 4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// upstream construct: line 18 —
//     || { //~ ERROR cannot borrow `v` as mutable
// Modifications:
//   · isize -> i64
//   · `vec![1, 2, 3]` -> `Vec::new()` + three `push` calls (no vec! macro here)
//   · `&v[0]` -> `&v[0u64]` (index type)
//   · assert -> exit code: `fn main() -> i32`
//   the FnOnce-bounded generic parameter, the shared loan of `v[0]` passed as the
//   first argument, and the closure that writes `v[1]` are all kept verbatim.
package borrowck_loan_vec_content;
fn takes_imm_elt<F: FnOnce()>(_v: &i64, f: F) { f(); }
fn has_mut_vec_and_does_not_try_to_change_it() {
    let mut v: Vec<i64> = Vec::new();
    v.push(1i64); v.push(2i64); v.push(3i64);
    takes_imm_elt(&v[0u64], || { });
}
fn has_mut_vec_but_tries_to_change_it() {
    let mut v: Vec<i64> = Vec::new();
    v.push(1i64); v.push(2i64); v.push(3i64);
    takes_imm_elt(
        &v[0u64],
        || {                       // THE DEFECT: admitted, upstream E0499
            v[1u64] = 4i64;
        });
}
fn main() -> i32 {
    has_mut_vec_and_does_not_try_to_change_it();
    has_mut_vec_but_tries_to_change_it();
    return 0i32;
}
