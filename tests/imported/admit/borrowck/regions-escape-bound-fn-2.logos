package regions_escape_bound_fn_2;
fn main() -> i32 {
    let mut out: Option<&i64> = Option::None;
    {
        let x: i64 = 3i64;
        let mut c = |y: &i64| { out = Option::Some(y); };
        c(&x);
    }
    match out {
        Option::Some(p) => { return *p as i32; }
        Option::None => { return 1i32; }
    }
}
