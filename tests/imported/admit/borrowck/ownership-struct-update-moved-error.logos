package ownership_struct_update_moved_error;
struct Mine { test: i64, other_val: i64 }
fn make_bar(s: Mine) -> Mine { return Mine { test: 9i64, other_val: s.other_val }; }
fn main() -> i32 {
    let start: Mine = Mine { test: 1i64, other_val: 0i64 };
    let tmp: Mine = make_bar(start);
    let end: Mine = Mine { test: tmp.test, other_val: 1i64 };
    return start.test as i32;
}
