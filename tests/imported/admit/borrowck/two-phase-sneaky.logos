package two_phase_sneaky;
use logos.mem.collections.vec;
fn app(s: &mut i64, k: i64) { *s = *s + k; }
fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    v.push(1i64);
    app(v.borrow_mut(0i64), { v.push(2i64); 5i64 });
    return 0i32;
}
