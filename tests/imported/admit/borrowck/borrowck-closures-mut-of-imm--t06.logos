package borrowck_closures_mut_of_imm_t06;
fn set(x: &mut i64) { *x = 4i64; }
fn a(x: &i64) -> i64 {
    let c1 = || { set(&mut *x); };
    let c2 = || { set(&mut *x); };
    c2(); c1();
    return *x;
}
fn main() -> i32 { let mut n = 1i64; return a(&n) as i32; }
