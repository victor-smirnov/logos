package borrowck_move_out_of_tuple_struct_with_dtor_r13;
extern fn printf(fmt: *const u8, v: i64) -> i32;
static mut DROPS: i64 = 0i64;
struct Inner { a: i64 }
struct S { f: Inner }
impl Drop for S { fn drop(self: &mut S) { unsafe { DROPS = DROPS + 1i64; } } }
fn main() -> i32 {
    let s = S { f: Inner { a: 1i64 } };
    let S { f: inner } = s;
    let x = inner.a;
    unsafe { return (DROPS * 10i64 + x) as i32; }
}
