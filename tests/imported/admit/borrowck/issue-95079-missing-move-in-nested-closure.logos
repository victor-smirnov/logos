package issue_95079_missing_move_in_nested_closure;
// nested closure: the inner closure captures `s`, which the OUTER closure only borrows,
// and the inner closure escapes the outer body. rustc: captured variable cannot escape
// `FnMut` closure body.
fn foo(s: &i64) -> || -> i64 {
    let mut h = || {
        let g = || { return *s; };
        return g;
    };
    return h();
}
fn main() -> i32 { let a: i64 = 3i64; let c = foo(&a); return c() as i32; }
