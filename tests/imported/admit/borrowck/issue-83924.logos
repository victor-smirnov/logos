package issue_83924;
fn main() -> i32 {
    let mut values: Vec<i64> = Vec::<i64>::new();
    values.push(10i64);
    let v: &mut Vec<i64> = &mut values;
    let mut max: i64 = 0i64;
    for n in v { if *n > max { max = *n; } }
    for n in v { max = max + *n; }
    return max as i32;
}
