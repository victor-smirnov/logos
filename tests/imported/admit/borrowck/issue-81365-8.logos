package issue_81365_8;
use logos.lang.ops;
struct DerefTarget { target_field: i64 }
struct Container { target: DerefTarget, container_field: i64 }
impl Deref<DerefTarget> for Container { fn deref(&self) -> &DerefTarget { return &self.target; } }
impl Container {
    fn bad_borrow(&mut self) -> i64 {
        let first = &(*self).target_field;
        self.container_field = 1i64;
        return *first;
    }
}
fn main() -> i32 {
    let mut c = Container { target: DerefTarget { target_field: 7i64 }, container_field: 0i64 };
