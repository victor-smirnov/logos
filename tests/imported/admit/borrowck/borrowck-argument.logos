package borrowck_argument;
struct S { v: i64 }
impl S { fn mutate(self: &mut S) { self.v = 1i64; } }
fn func(arg: S) -> i64 { arg.mutate(); return arg.v; }
fn main() -> i32 { return func(S { v: 0i64 }) as i32; }
