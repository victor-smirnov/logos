package two_phase_nonrecv_autoref_a_fnmut_twice;
fn twice_ten_sm<F: FnMut(i64) -> i64>(f: &mut F) -> i64 {
    return f(f(10i64));
}
fn main() -> i32 { let mut c = |x: i64| { return x + 1i64; }; let _ = twice_ten_sm(&mut c); return 0i32; }
