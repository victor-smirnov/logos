package borrowck_mutate_in_guard;
enum Enum { A(i64), B(bool) }
fn if_guard() -> i64 {
    let mut x = Enum::A(42i64);
    let r = match x {
        Enum::A(_) if { x = Enum::B(false); false } => 1i64,
        Enum::A(p) => p,
        Enum::B(_) => 2i64,
    };
    return r;
}
fn main() -> i32 { return if_guard() as i32; }
