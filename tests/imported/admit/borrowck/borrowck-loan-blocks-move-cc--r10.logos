package borrowck_loan_blocks_move_cc_r10;
use logos.mem.boxed;
fn spawn<F>(f: F) { }
fn use_ref(w: &Box<i64>) { }
fn box_imm() {
    let v: Box<i64> = Box::new(3i64);
    let w: &Box<i64> = &v;
    spawn(move || { let _ = *v; });
    use_ref(w);
}
fn main() -> i32 { return 0i32; }
