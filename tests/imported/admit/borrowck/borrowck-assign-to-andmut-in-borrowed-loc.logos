package borrowck_assign_to_andmut_in_borrowed_loc;
struct S { pointer: &mut i64 }
fn copy_borrowed_ptr(p: &mut S) -> S {
    return S { pointer: &mut *p.pointer };
}
fn main() -> i32 {
    let mut x: i64 = 1i64;
    let mut y = S { pointer: &mut x };
    let z = copy_borrowed_ptr(&mut y);
    *y.pointer = *y.pointer + 1i64;   // E0503: cannot use `*y.pointer`
    *z.pointer = *z.pointer + 1i64;
    return 0i32;
}
