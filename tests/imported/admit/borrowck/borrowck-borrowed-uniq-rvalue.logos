// rustc borrowck/borrowck-borrowed-uniq-rvalue.rs — upstream E0716
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root bck.D
// RE-PORTED AS-IS 2026-09-07 (stage 3). The old port was `let r: &i64 = &mk().v;`
// — a `let` INITIALIZER, the one position where Rust DOES extend a temporary, so
// it was legal and sat in bc_admits_blocked as LEGAL-AS-PORTED. Upstream borrows
// the temporary in METHOD-ARGUMENT position, where Rust does not extend.
// Original path: tests/ui/borrowck/borrowck-borrowed-uniq-rvalue.rs
// upstream commit: 4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// upstream construct: line 8 —
//     buggy_map.insert(42, &*Box::new(1)); //~ ERROR temporary value dropped while borrowed
// Modifications:
//   · `HashMap<usize, &usize>` -> a hand-written `Holder<'a> { p: &'a i64 }` with an
//     `insert(&mut self, k: i64, v: &'a i64)` method. THE STDLIB HashMap CANNOT CARRY
//     THIS PROGRAM: `HashMap::new` is not a callable static and `HashMap::insert` is
//     `unsafe` (measured 2026-09-07). The construct under test is a borrow of a
//     temporary in method-argument position stored into a receiver that outlives the
//     statement — the container is scenery, and it is preserved exactly.
//   · `&*Box::new(1)` is KEPT verbatim (Box::new works here)
//   · usize/isize -> i64
//   · the second, legal half of upstream is kept as an in-fixture control: a borrow of
//     a NAMED box, which is legal. Upstream declares `let tmp: Box<_>;` BEFORE the map
//     and assigns later; Logos has no deferred-init `let` of that shape, so `tmp` is
//     initialised at its declaration — still before the map, so it still outlives it.
//   · assert -> exit code: `fn main() -> i32`
package borrowck_borrowed_uniq_rvalue;
struct Holder<'a> { p: &'a i64 }
impl<'a> Holder<'a> {
    fn insert(self: &mut Holder<'a>, k: i64, v: &'a i64) { self.p = v; }
}
fn main() -> i32 {
    let base: i64 = 0i64;
    let tmp: Box<i64> = Box::new(2i64);          // declared FIRST, as upstream declares it
    let mut buggy_map: Holder = Holder { p: &base };
    buggy_map.insert(42i64, &*Box::new(1i64));   // THE DEFECT: admitted, upstream E0716

    // but it is ok if we use a temporary
    buggy_map.insert(43i64, &*tmp);
    return *buggy_map.p as i32;
}
