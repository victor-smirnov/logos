package borrowck_closures_unique_imm;
struct Foo { x: i64 }
fn main() -> i32 {
    let mut f = Foo { x: 1i64 };
    let this: &mut Foo = &mut f;
    let mut r = || {
        let p: &i64 = &this.x;
        let q: &mut i64 = &mut this.x;   // ERROR: cannot borrow, p is live
        *q = 2i64;
        let _ = *p;
    };
    r();
    return 0i32;
}
