package buffer_reuse_pattern_issue_147694;
fn main() -> i32 {
    let mut buffer: Vec<&i64> = Vec::new();
    let mut i: i64 = 0i64;
    while i < 2i64 {
        let data: i64 = i;
        buffer.push(&data);
        i = i + 1i64;
    }
    let _ = buffer.len();
    return 0i32;
}
