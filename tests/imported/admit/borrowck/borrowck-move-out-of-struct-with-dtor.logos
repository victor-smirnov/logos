// shelf: admit · root bck.E
// upstream: borrowck/borrowck-move-out-of-struct-with-dtor.rs (E0509 cannot move out of a
// type which implements Drop)
package borrowck_move_out_of_struct_with_dtor;
struct Inner { v: i64, s: str }
impl Drop for Inner { fn drop(self: &mut Inner) {} }
struct S { f: Inner }
impl Drop for S { fn drop(self: &mut S) {} }
fn move_in_let() {
    let s = S { f: Inner { v: 1i64, s: "foo" } };
    let g = s.f;
    let _ = g.v;
}
fn main() -> i32 { move_in_let(); return 0i32; }
