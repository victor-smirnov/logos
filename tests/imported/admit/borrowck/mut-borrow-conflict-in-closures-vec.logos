package mut_borrow_conflict_in_closures_vec;
use logos.mem.boxed;
fn main() -> i32 {
    let mut y: i64 = 1i64;
    let mut c: Vec<Box<dyn FnMut()>> = Vec::<Box<dyn FnMut()>>::new();
    c.push(Box::new(|| { y = 0i64; }));
    c.push(Box::new(|| { y = 0i64; }));
    return 0i32;
}
