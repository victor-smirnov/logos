// rustc borrowck/borrowck-borrowed-uniq-rvalue-2.rs — upstream E0716 temporary dropped while borrowed
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root bck.D
// RE-PORTED AS-IS 2026-09-07 (stage 3). The old port was `let d: &String = &mk();`
// — a bare borrow in a `let` INITIALIZER, which Rust extends, and it sat in
// bc_admits_blocked as LEGAL-AS-PORTED. Upstream passes the borrow of the
// temporary THROUGH A FUNCTION CALL whose result carries it in a STRUCT; Rust's
// temporary-lifetime extension does not reach through a call.
// Original path: tests/ui/borrowck/borrowck-borrowed-uniq-rvalue-2.rs
// upstream commit: 4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// upstream construct: line 20 —
//     let x = defer(&vec!["Goodbye", "world!"]); //~ ERROR temporary value dropped while borrowed
// Modifications:
//   · `&'a [&'a str]` payload -> `&'a i64`, and `vec![...]` -> `mk() -> i64`; the
//     slice-of-strs is upstream's way of producing a non-'static temporary, and the
//     lifetime structure (`Defer<'a>` holding a borrow, `defer<'r>(&'r) -> Defer<'r>`,
//     `impl Drop for Defer`) is preserved exactly. The `Drop` impl is load-bearing:
//     it is what makes the dangling borrow observable at scope end.
//   · `println!` inside `drop` -> empty body (no format machinery needed to state
//     the borrow-check claim)
//   · `x.x[0];` -> `return *d.x as i32` (assert -> exit code)
package borrowck_borrowed_uniq_rvalue_2;
struct Defer<'a> { x: &'a i64 }
impl<'a> Drop for Defer<'a> { fn drop(self: &mut Defer<'a>) { } }
fn defer<'r>(x: &'r i64) -> Defer<'r> { return Defer { x: x }; }
fn mk() -> i64 { return 7i64; }
fn main() -> i32 {
    let d = defer(&mk());        // THE DEFECT: admitted, upstream E0716
    return *d.x as i32;
}
