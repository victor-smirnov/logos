package borrowck_multiple_captures;
use logos.mem.string;
fn spawn<F: FnOnce()>(f: F) { f(); }
fn borrow(s: &String) -> i64 { return s.len() as i64; }
fn main() -> i32 {
    let x1: String = String::from("a");
    let p1: &String = &x1;
    spawn(move || { let _d = x1; });   // ERROR: cannot move out of `x1` because it is borrowed
    return borrow(p1) as i32;
}
