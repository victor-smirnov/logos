// CONTROL for t06: the identical `&mut *x` through a `&i64`, written OUTSIDE a
// closure body (one difference: the closure boundary).
package borrowck_closures_mut_of_imm_ctl;
fn set(x: &mut i64) { *x = 4i64; }
fn a(x: &i64) -> i64 {
    set(&mut *x);
    return *x;
}
fn main() -> i32 { let mut n = 1i64; return a(&n) as i32; }
