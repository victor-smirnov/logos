package borrowck_move_from_unsafe_ptr;
struct Own { n: i64 }
impl Drop for Own { fn drop(self: &mut Own) {} }
unsafe fn foo(x: *const Own) -> Own {
    let y = *x;   // E0507: cannot move out of `*x`, behind a raw pointer
    return y;
}
fn main() -> i32 {
    let o = Own { n: 1i64 };
    let p: *const Own = &o;
    let r = unsafe { foo(p) };
    return r.n as i32;
}
