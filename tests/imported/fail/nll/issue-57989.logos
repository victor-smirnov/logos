// port of rust tests/ui/nll/issue-57989.rs
// rustc: E0594 cannot assign to `*x`, which is behind a `&` reference
//        E0506 cannot assign to `*x` because it is borrowed
package issue_57989;
fn f(x: &i64) {
    let g: &&i64 = &x;
    *x = 0i64;
    let h: &&i64 = g;
}
fn main() -> i32 { return 0i32; }
