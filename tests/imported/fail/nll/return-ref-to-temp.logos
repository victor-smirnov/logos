// Returning a reference to a temporary literal — the temp dies at
// end of statement; the returned reference dangles. Previously a
// known gap; closed in B75 by recursing prov_of through AddrOfTemp
// to detect literal / fresh-allocation / call-result inner exprs.
package nll_return_ref_to_temp;

fn make() -> &i32 {
    return &5i32;
}

fn main() -> i32 { return *make(); }
