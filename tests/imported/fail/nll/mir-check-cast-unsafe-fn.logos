package mir_check_cast_unsafe_fn;
// nll/mir_check_cast_unsafe_fn.rs — relating regions across an unsafe-fn-pointer cast
fn idf(x: &u32) -> &u32 { return x; }
fn bar(input: &u32, f: fn(&u32) -> &u32) -> &'static u32 {
    let g: unsafe fn(&u32) -> &u32 = f;
    unsafe { return g(input); }
}
fn main() -> i32 { let n: u32 = 1u32; let _ = bar(&n, idf); return 0i32; }
