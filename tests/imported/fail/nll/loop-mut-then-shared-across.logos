// B72: mut borrow lives across loop; shared borrow inside conflicts.
package loop_mut_then_shared_across;

fn main() -> i32 {
    let mut x: i32 = 0i32;
    let m: &mut i32 = &mut x;
    let mut i: i32 = 0i32;
    while i < 3i32 {
        let s: &i32 = &x;
        let _v: i32 = *s;
        i = i + 1i32;
    }
    *m = 5i32;
    return 0i32;
}
