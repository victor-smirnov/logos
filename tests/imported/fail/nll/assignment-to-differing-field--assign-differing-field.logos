// port of tests/ui/nll/polonius/assignment-to-differing-field.rs
// an assignment to `.1` must not kill the loan on `.0`
package assignment_to_differing_field_assign_differing_field;
struct L { value: i64 }
fn f(a: &mut L, b: &mut L) -> i64 {
    let mut list: (&mut L, &mut L) = (a, b);
    let r: &mut i64 = &mut list.0.value;
    list.1 = list.0;
    return *r;
}
fn main() -> i32 { let mut p = L { value: 1i64 }; let mut q = L { value: 2i64 }; return f(&mut p, &mut q) as i32; }
