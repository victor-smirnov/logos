// rustc nll/issue-62007-assign-differing-fields.rs — upstream E0499/E0500
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root nllmoves.R3
// Original path: tests/ui/nll/issue-62007-assign-differing-fields.rs @ 4b0c9d76a
// Modifications: `vec![]` -> `Vec::<&'a mut T>::new()`; `if let Some(n)` ->
//   `if let Option::Some(n)`; `#![allow(dead_code)]` dropped; `fn main() {}` ->
//   `fn main() -> i32 { return 0i32; }`.
//   `list.1 = n;` is written `list.1 = &mut **n;`: upstream relies on rustc's DEREF
//   COERCION from `&mut Box<List<T>>` down to `&mut List<T>` at the assignment, which
//   Logos does not have (the as-is line answers a TYPE error, "assignment to 'list.1':
//   expected &'a mut List<T>, got &mut Box<List<T>>"). The explicit reborrow is the
//   same assignment to the same place; only the coercion is spelled out.
//   (Backlog: box_deref_coercion_at_assignment.)
//   ⚠ WHAT THE PREVIOUS PORT DID: it had NO tuple, NO field projection and NO
//   assignment at all — a bare `while` loop pushing `&mut a.value` — so the subject of
//   the upstream test (assigning over `list.1` must kill borrows of `list.1` ONLY, and
//   must NOT re-permit `list.0` on the next turn of the loop) was absent.
// 2026-09-08 re-port: STILL ADMITTED, with the tuple, the projection and the
//   field assignment restored.
package issue_62007_assign_differing_fields_c;
struct List<T> { value: T, next: Option<Box<List<T>>> }
fn to_refs<'a, T>(mut list: (&'a mut List<T>, &'a mut List<T>)) -> Vec<&'a mut T> {
    let mut result: Vec<&'a mut T> = Vec::<&'a mut T>::new();
    loop {
        result.push(&mut (list.0).value);
        if let Option::Some(n) = (list.0).next.as_mut() {
            list.1 = &mut **n;
        } else {
            return result;
        }
    }
}
fn main() -> i32 { return 0i32; }
