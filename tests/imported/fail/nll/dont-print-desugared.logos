package dont_print_desugared;
struct S { n: i64 }
fn f(s: &S) -> i64 {
    let r: &mut i64 = &mut s.n;
    *r = 1i64;
    return *r;
}
fn main() -> i32 {
    let v: S = S { n: 0i64 };
    return f(&v) as i32;
}
