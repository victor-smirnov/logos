// rustc nll/closure-borrow-spans.rs — upstream E0502 / E0506 (2 of 7 cases missed)
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: fail · was nllmoves.C, CLOSED 2026-08-31t — a WHOLE-VALUE SHARED
// closure capture was a LIVENESS question only; it now records a shared
// LOAN on the root held by the closure binding, unless the root is MOVED,
// which stays a liveness question and keeps its own verb.
// FINDING (from closure-borrow-spans.rs::borrow_mut_while_borrowed)
// `f` captures `x` by shared reference and is live across the `&mut x`.
// rustc: E0502 cannot borrow `x` as mutable because it is also borrowed as immutable.
package closure_borrow_spans_a;
fn main() -> i32 {
    let mut x: i64 = 0i64;
    let f = || { let n: i64 = x; };
    let y: &mut i64 = &mut x;
    f();
    return *y as i32;
}
