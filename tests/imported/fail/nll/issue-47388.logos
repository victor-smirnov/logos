// port of nll/issue-47388.rs: &(&mut fancy) -> write through a SHARED outer ref
package issue_47388;
struct FancyNum { num: u8 }
fn main() -> i32 {
    let mut fancy: FancyNum = FancyNum { num: 5u8 };
    let inner: &mut FancyNum = &mut fancy;
    let fancy_ref: &&mut FancyNum = &inner;
    fancy_ref.num = 6u8;    // E0594: cannot assign through & reference
    return 0i32;
}
