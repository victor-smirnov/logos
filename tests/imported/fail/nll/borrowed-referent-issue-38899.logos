struct Block { current: &i64, unrelated: &i64 }
fn bump(block: &mut Block) -> i64 {
    let x: &mut &mut Block = &mut block;
    let a: i64 = *x.current;
    let p: &i64 = &*block.current;
    let b: i64 = *x.current;
    return a + b + *p;
}
fn main() -> i32 {
    let u: i64 = 1i64;
    let v: i64 = 2i64;
    let mut blk: Block = Block { current: &u, unrelated: &v };
    return bump(&mut blk) as i32;
}
