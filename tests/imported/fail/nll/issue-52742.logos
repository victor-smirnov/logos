package issue_52742;
struct Foo { x: &i64, y: &i64 }
struct Bar { z: &i64 }
impl Foo { fn take_bar(self: &mut Foo, b: Bar) { self.y = b.z; } }
fn main() -> i32 {
    let a: i64 = 1i64;
    let mut f: Foo = Foo { x: &a, y: &a };
    {
        let tmp: i64 = 99i64;
        let b: Bar = Bar { z: &tmp };
        f.take_bar(b);
    }
    return *f.y as i32;
}
