// B78: moving whole value then accessing a field is invalid.
package partial_move_whole_then_field;

struct Inner { v: i64 }
impl Drop for Inner { fn drop(self: &mut Inner) { } }

struct Outer { i: Inner, k: i64 }

fn take_outer(o: Outer) -> i64 { return o.k; }

fn main() -> i32 {
    let o: Outer = Outer { i: Inner { v: 5i64 }, k: 7i64 };
    let _x: i64 = take_outer(o);
    let _y: i64 = o.k;     // whole struct moved
    return 0i32;
}
