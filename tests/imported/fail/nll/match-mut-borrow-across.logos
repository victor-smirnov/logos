// Mut borrow alive through match; arm tries to shared-borrow.
package match_mut_borrow_across;

fn main() -> i32 {
    let mut x: i32 = 0i32;
    let m: &mut i32 = &mut x;
    let c: i32 = 0i32;
    match c {
        0i32 => { let s: &i32 = &x; let _v: i32 = *s; }
        _    => { }
    }
    *m = 1i32;
    return 0i32;
}
