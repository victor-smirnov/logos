// B94: method-call `&mut self` receiver checks against active field-path
// borrows on the receiver — properly rejected.
package df_method_vs_field_borrow;
struct P { a: i32, b: i32 }
impl P { fn bump(self: &mut P) { (*self).b = (*self).b + 1i32; } }
fn main() -> i32 {
    let mut p: P = P { a: 5i32, b: 0i32 };
    let r: &mut i32 = &mut p.a;
    p.bump();
    *r = 1i32;
    return 0i32;
}
