// B83: same deep path twice — reject.
package df_same_deep_path;
struct L { x: i32 }
struct M { l: L }
struct N { m: M }
fn main() -> i32 {
    let mut n: N = N { m: M { l: L { x: 0i32 } } };
    let r1: &mut i32 = &mut n.m.l.x;
    let r2: &mut i32 = &mut n.m.l.x;
    *r1 = 1i32; *r2 = 2i32;
    return 0i32;
}
