// rustc nll/issue-52663-span-decl-captured-variable.rs — upstream E0507
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: FAIL since 2026-09-07s (was admit · root nllmoves.C). Closed by the
// FnOnce-consumes rule reaching the closure-LITERAL form: a body that moves
// `x.0` out makes this closure `FnOnce`, and `call_once` takes self by value,
// so the second `c()` is a use-after-move. rustc refuses it one step earlier
// (E0507 at the move out of a by-ref capture); both refuse, and admitting it
// ran `D::drop` twice on one tuple element.
package issue_52663_span_decl_captured_variable;
struct D { x: i64 }
impl Drop for D { fn drop(self: &mut Self) { } }
fn main() -> i32 {
  let x: (D, D) = (D { x: 1i64 }, D { x: 2i64 });
  let c = || -> i64 { let m: D = x.0; return m.x; };
  let a: i64 = c();
  let b: i64 = c();
  return 0i32;
}
