package maybe_initialized_drop_with_uninitialized_fragments;
use logos.mem.string;
struct Wrap { p: &mut i64 }
impl Drop for Wrap { fn drop(self: &mut Self) { *self.p = *self.p + 1i64; } }
struct FooS { a: String, b: Wrap }
fn eat_s(s: String) { }
fn eat_w(w: Wrap) { }
fn main() -> i32 {
    let mut x: i64 = 0i64;
    let wrap = Wrap { p: &mut x };
    let foo = FooS { a: String::from("str"), b: wrap };
    eat_s(foo.a);
    eat_w(foo.b);
    x = 1i64;
    return 0i32;
}
