// B61: moving out a (move-typed) field then using the whole struct.
package borrowck_partial_field_move;

struct Inner { v: i64 }
impl Drop for Inner { fn drop(self: &mut Inner) { } }

struct Outer { i: Inner, k: i64 }

fn take(i: Inner) -> i64 { return i.v; }

fn main() -> i32 {
    let o: Outer = Outer { i: Inner { v: 1i64 }, k: 2i64 };
    let _x: i64 = take(o.i);
    let _y: Outer = o;       // use-after-partial-move
    return 0i32;
}
