// MOVED pass -> fail 2026-09-19 (ADR 0028): an explicit `&mut` call argument is not a
// two-phase borrow in Rust (only a method receiver's autoref, an implicit reborrow and a
// compound assignment's borrow are), so using the same place in a later argument is
// refused (rustc E0503). The old checker admitted it through a reservation it gave every
// `&mut` argument; sema now tags each borrow with its BorrowOrigin.
// B82: outer args read struct fields while &mut struct reserved.
package tpb_with_field_args;

struct P { a: i32, b: i32 }

fn writeA(p: &mut P, v: i32) { (*p).a = v; }

fn main() -> i32 {
    let mut p: P = P { a: 0i32, b: 5i32 };
    writeA(&mut p, p.b);
    return p.a - 5i32;
}
