package issue_21232_partial_init_and_use_a_use_uninit_field_assign;
struct S { x: i64, y: i64 }
fn borrow_field(x: &i64) -> i64 { return *x; }
fn main() -> i32 {
    let s: S;
    s.x = 10i64;
    s.y = 20i64;
    let _ = borrow_field(&s.x);
    return 0i32;
}
