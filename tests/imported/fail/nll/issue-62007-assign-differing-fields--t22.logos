package issue_62007_assign_differing_fields_t22;
struct L { value: i64 }
fn to_refs(mut list: (&mut L, &mut L)) -> Vec<&mut i64> {
    let mut result: Vec<&mut i64> = Vec::<&mut i64>::new();
    let mut i: i64 = 0i64;
    while i < 3i64 {
        result.push(&mut list.0.value);
        list.1 = list.0;
        i = i + 1i64;
    }
    return result;
}
fn main() -> i32 { return 0i32; }
