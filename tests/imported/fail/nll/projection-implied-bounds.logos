// was checked nowhere at all.
package projection_implied_bounds;
use logos.lang.cell;
fn invoke2<'a, T, U>(a: &T, b: Cell<&'a Option<U>>) where T: 'a { }
fn generic2<'a, T>(value: T, item: Cell<&'a Option<i64>>) { invoke2::<T,i64>(&value, item); }
fn main() -> i32 { return 0i32; }
