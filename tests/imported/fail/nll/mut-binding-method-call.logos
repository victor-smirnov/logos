// B81: `&mut self` method call on non-mut binding now correctly rejected.
package mut_binding_method_call;

struct Counter { n: i32 }
impl Counter {
    fn bump(self: &mut Counter) -> i32 { (*self).n = (*self).n + 1i32; return (*self).n; }
}

fn main() -> i32 {
    let c: Counter = Counter { n: 0i32 };
    let r: i32 = c.bump();
    return r - 1i32;
}
