package ty_param_fn_body;
// nll/ty-outlives/ty-param-fn-body.rs — `T: 'a` outlives bound on a type parameter
fn outlives<'a, T: 'a>(x: &'a u64, y: T) {}
fn region_static<'a, T>(cell: &'a u64, t: T) { outlives(cell, t); }
fn main() -> i32 { return 0i32; }
