package sugg_mut_for_binding_issue_137486;
// nll/sugg-mut-for-binding-issue-137486.rs — E0716 temporary value dropped while borrowed
struct S { n: i64 }
fn mk() -> S { return S { n: 1i64 }; }
fn main() -> i32 {
    let mut s = S { n: 0i64 };
    let mut ref_s: &mut S = &mut s;
    ref_s = &mut mk();
    return ref_s.n as i32 - 1i32;
}
