package lub_match;
fn opt_str2(maybe: &Option<i64>) -> &'static i64 {
    match maybe {
        Option::Some(s) => { let t: &i64 = s; return t; }
        Option::None => { return &STATIC_ZERO; }
    }
}
static STATIC_ZERO: i64 = 0i64;
fn main() -> i32 { return 0i32; }
