// B78: moving the same field twice is a use-after-move.
package partial_move_same_field_twice;

struct Inner { v: i64 }
impl Drop for Inner { fn drop(self: &mut Inner) { } }

struct Outer { i: Inner, k: i64 }

fn take(i: Inner) -> i64 { return i.v; }

fn main() -> i32 {
    let o: Outer = Outer { i: Inner { v: 5i64 }, k: 7i64 };
    let _a: i64 = take(o.i);
    let _b: i64 = take(o.i);   // moved field used again
    return 0i32;
}
