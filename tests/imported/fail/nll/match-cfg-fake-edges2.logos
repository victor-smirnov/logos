package match_cfg_fake_edges2;
struct P { a: bool, b: bool }
fn drop_r(r: &mut bool) -> i64 { *r = true; return 1i64; }
fn main() -> i32 {
    let mut y: P = P { a: false, b: true };
    let r: &mut bool = &mut y.b;
    let mut k: i64 = 0i64;
    match y {
        P { a: true, b: _ } => { k = drop_r(r); }
        _ => { k = 2i64; }
    }
    return k as i32;
}
