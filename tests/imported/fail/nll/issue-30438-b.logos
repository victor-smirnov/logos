// port of rust tests/ui/nll/issue-30438-b.rs
// the method returns a reference into a value it constructs in its own body.
// rustc: E0515 cannot return reference to temporary value.
package issue_30438_b;
struct Test { s: i64 }
impl Test {
    fn index(self: &Test, i: u64) -> &Test { return &Test { s: self.s }; }
}
fn main() -> i32 {
    let test: Test = Test { s: 7i64 };
    let r: &Test = test.index(0u64);
    return r.s as i32;
}
