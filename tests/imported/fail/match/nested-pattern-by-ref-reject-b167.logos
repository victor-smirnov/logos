// B167: a nested enum-payload BINDING pattern over a by-reference scrutinee
// (`match &enum { Some(Some(v)) }`) is not yet supported — the K4 desugar
// assumes a by-value enum. Must reject cleanly (not emit invalid MLIR).
// Workaround: bind the inner to a name and match it in the body.
package nested_pattern_by_ref_reject_b167;
use logos.lang.option;
fn f(o: &Option<Option<i64>>) -> i64 {
    match o {
        Option::Some(Option::Some(v)) => *v,
        _ => -1i64,
    }
}
fn main() -> i32 { let x: Option<Option<i64>> = Option::None; return f(&x) as i32; }
