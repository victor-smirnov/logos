// rustc regions/regions-adjusted-lvalue-op.rs — upstream E0502 cannot borrow `v` as immutable
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: admit · root lifereg.R2  (root RE-CHECKED 2026-09-08, see below)
// RE-PORTED AS-IS 2026-09-08 (stage 6). This is the INDEX place-op door — upstream
// line 14. The old port already had it; the provenance and the `impl for Data` are
// restored so that the receiver really is an INDEXED element and not the vector.
// Original path: tests/ui/regions/regions-adjusted-lvalue-op.rs
// upstream commit: 4b0c9d76ae7d387229caea55cfa73c280b08b8a7
// upstream construct: line 14 —
//     v[0].oh_no(&v); //~ ERROR cannot borrow `v` as immutable because
// Modifications:
//   · tuple struct `Data(i32)` -> a named field `v: i64`
//   · the trait's DEFAULT body `{ loop {} }` -> a required method with an `impl`
//     body (a diverging default body is not the subject and `loop {}` here would
//     make the program not terminate)
//   · `vec![Data(0)]` -> `Vec::new()` + one `push` (no vec! macro here)
//   · `v[0]` -> `v[0u64]` (index type)
//   · assert -> exit code: `fn main() -> i32`
//   The receiver's implicit `&mut` autoref through an INDEX place op, taken while
//   the argument list mints `&v`, is kept — that is the whole subject.
package regions_adjusted_lvalue_op_t26;
struct Data { v: i64 }
trait OhNo { fn oh_no(self: &mut Self, other: &Vec<Data>) -> i64; }
impl OhNo for Data { fn oh_no(self: &mut Self, other: &Vec<Data>) -> i64 { return self.v; } }
fn main() -> i32 {
  let mut v: Vec<Data> = Vec::new();
  v.push(Data { v: 0i64 });
  v[0u64].oh_no(&v);          // THE DEFECT: admitted, upstream E0502
  return 0i32;
}
