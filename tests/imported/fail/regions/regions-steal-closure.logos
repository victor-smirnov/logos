package regions_steal_closure;
struct ClosureBox<'a> { cl: Box<dyn FnMut()> }
fn box_it<'r>(x: Box<dyn FnMut()>) -> ClosureBox<'r> { return ClosureBox { cl: x }; }
fn main() -> i32 {
  let cb: ClosureBox;
  {
    let mut i: i64 = 3i64;
    cb = box_it(Box::new(|| { i += 1i64; }));
  }
  return 0i32;
}
