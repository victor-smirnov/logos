// upstream construct: line 48 —
//     want_G(baz); //~ ERROR mismatched types
// Modifications:
//   · unit struct `struct S;` -> `struct S { n: i64 }`
//   · the `type G` alias -> the fn-pointer type written inline
//   · `panic!()` bodies -> real returns
//   · ⚠ THE COERCION SITE IS MOVED, deliberately and by the importer's split: the
//     annotated `want_G(baz)` ARGUMENT becomes a `let g: fn(&S) -> &'static S = baz;`
//     INITIALIZER. The sibling port `--fn-subtyping` carries upstream's own site.
//   · assert -> exit code: `fn main() -> i32`
package regions_fn_subtyping_return_static_fail_c30_let_binding_fnptr;
struct S { n: i64 }
static GS: S = S { n: 0i64 };
fn foo<'a>(x: &'a S) -> &'static S { return &GS; }   // meets both
fn baz<'a>(x: &'a S) -> &'a S { return x; }          // meets F, but not G
fn supply_G() {
  let ok: fn(&S) -> &'static S = foo;   // legal: `foo` really does return 'static
  let g: fn(&S) -> &'static S = baz;    // THE DEFECT: upstream E0308 — now REFUSED
}
fn main() -> i32 { return 0i32; }
