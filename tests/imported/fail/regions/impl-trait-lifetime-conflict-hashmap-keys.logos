// rustc regions/impl-trait-lifetime-conflict-hashmap-keys.rs — upstream E0308 mismatched types (impl vs trait sig)
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: fail — REFUSED since 2026-09-02w — NOT for the upstream reason: the impl-vs-trait signature comparator still admits the `Subject<'static, K>` vs `Subject<'a, K>` mismatch (M-SIG, its row is impl-trait-lifetime-conflict-hashmap-keys--sig-only). What is refused is the port's BODY, `self.p: &'a K` flowing into the declared `Subject<'static, K>` — a second defect rustc would also report — once the generic struct-literal path read the literal's lifetime args off its values. Was lifereg.R18.
package impl_trait_lifetime_conflict_hashmap_keys;
struct Subject<'a, T> { p: &'a T }
trait MapAssertion<'a, K> {
  fn key_set(self: &Self) -> Subject<'a, K>;
}
struct M<'a, K> { p: &'a K }
impl<'a, K> MapAssertion<'a, K> for M<'a, K> {
  fn key_set(self: &Self) -> Subject<'static, K> { return Subject { p: self.p }; }
}
fn main() -> i32 { return 0i32; }
