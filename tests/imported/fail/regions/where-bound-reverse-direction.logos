// B78: caller declares `'b: 'a` but struct needs `'a: 'b`.
package where_bound_reverse_direction;

struct Pair<'a, 'b> where 'a: 'b { x: &'a i32, y: &'b i32 }

fn bad<'a, 'b>(x: &'a i32, y: &'b i32) -> Pair<'a, 'b>
    where 'b: 'a
{ return Pair { x: x, y: y }; }

fn main() -> i32 { return 0i32; }
