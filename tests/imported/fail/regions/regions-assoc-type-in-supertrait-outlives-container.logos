// Modifications:
//   · `TheType<'b>`'s field `m: [fn(&'b()); 0]` -> `m: &'b i64` and `WithAssoc`'s
//     `m: [T; 0]` -> `m: T`
//   · `&'b ()` -> `&'b i64`
//   · `let _` -> `let x` (see the sibling files' note on upstream FIXME #54943)
//   · assert -> exit code: `fn main() -> i32`
package regions_assoc_type_in_supertrait_outlives_container;
trait TheTrait { type TheAssocType; }
trait TheSubTrait: TheTrait { }
struct TheType<'b> { m: &'b i64 }
impl<'b> TheTrait for TheType<'b> { type TheAssocType = &'b i64; }
impl<'b> TheSubTrait for TheType<'b> { }
struct WithAssoc<T: TheSubTrait> { m: T }
fn with_assoc<'a, 'b>() {
    let x: &'a WithAssoc<TheType<'b>> = loop { };
}
fn main() -> i32 { return 0i32; }
