package issue_12470;
trait X { fn get_i(self: &Self) -> i64; }
struct B { i: i64 }
impl X for B { fn get_i(self: &B) -> i64 { return self.i; } }
struct A<'a> { p: &'a dyn X }
fn make_a<'a>(p: &'a dyn X) -> A<'a> { return A { p: p }; }
fn make_make_a<'a>() -> A<'a> {
    let b: B = B { i: 1i64 };
    let bb: &B = &b;
    return make_a(bb);
}
fn main() -> i32 { let a: A = make_make_a(); return a.p.get_i() as i32 - 1i32; }
