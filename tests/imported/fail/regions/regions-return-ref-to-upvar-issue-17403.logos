// rustc regions/regions-return-ref-to-upvar-issue-17403.rs — upstream E0521 captured variable cannot escape `FnMut` body
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: fail — CLOSED 2026-08-28 by the AddrOf capture-mutability read.
// ⚠ RIGHT VERDICT, DIFFERENT REASON — the twin of nll/issue-53040, same
// channel: upstream E0521 (captured variable escapes the `FnMut` body); we
// refuse because the mut capture loan on `x` now conflicts with the
// provenance `let p = f()` deposits on the callee's captures.
package regions_return_ref_to_upvar_issue_17403;
fn main() -> i32 {
    let mut x: i64 = 0i64;
    let mut f = || -> &mut i64 { return &mut x; };
    let p: &mut i64 = f();
    let q: &mut i64 = f();
    *p = 1i64; *q = 2i64;
    return 0i32;
}
