// B88: GAT lt-arg in return doesn't match method's resolved lt.
package gat_lt_arg_mismatch;
trait It { type Item<'a>; fn get<'a>(self: &'a Self) -> Self::Item<'a>; }
struct W { v: i32 }
impl It for W {
    type Item<'a> = &'a i32;
    fn get<'a>(self: &'a W) -> &'a i32 { return &(*self).v; }
}
fn bad<'a, 'b, T: It>(t: &'b T) -> T::Item<'a> { return t.get(); }
fn main() -> i32 { return 0i32; }
