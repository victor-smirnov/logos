// rustc regions/regions-name-undeclared.rs — upstream E0261 undeclared lifetime
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: FAIL (was admit) — closed 2026-08-28: `'b` in `m4`'s parameter type is
// declared neither on the fn nor on the `impl<'a>` header. Upstream E0261, same
// reason. ⚠ The sibling `'a` — an IMPL-scope name — must keep compiling, and
// that half is what cost 65 legal programs when the scope was fn-only.
package regions_name_undeclared;
struct Foo<'a> { x: &'a i64 }
impl<'a> Foo<'a> {
    fn m4(self: &Foo<'a>, arg: &'b i64) { }
}
fn main() -> i32 { return 0i32; }
