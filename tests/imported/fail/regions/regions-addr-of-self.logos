package regions_addr_of_self;
struct Dog { cats_chased: i64 }
impl Dog {
  fn chase_cat(&mut self) {
    let p: &'static mut i64 = &mut self.cats_chased;
    *p += 1i64;
  }
}
fn main() -> i32 {
  let mut d: Dog = Dog { cats_chased: 0i64 };
  d.chase_cat();
  if d.cats_chased != 1i64 { return 1i32; }
  return 0i32;
}
