// rustc lifetimes/no_lending_iterators.rs — upstream E0195
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: FAIL (was admit) — closed 2026-08-28: a fn signature's lifetime names
// are now scoped to `fn <'a> + impl <'a> + 'static + '_`, and PARAMETER and
// RETURN types are walked, so `Self::Item` resolving to `&'a i64` names an 'a
// that the impl header does not declare.
// ⚠ HONEST DIVERGENCE: upstream is E0195 (the assoc type's lifetime params do
// not match the trait's). We refuse the same program for the adjacent reason —
// the GAT's `'a` is not in scope in `poke`'s signature — not for E0195 itself.
// The E0195 arity check is still nobody's job.
package no_lending_iterators;
// port of lifetimes/no_lending_iterators.rs — assoc type with lifetime params not in the trait
trait Bar { type Item; fn poke(&mut self, item: Self::Item); }
struct U { v: i64 }
impl Bar for U { type Item<'a> = &'a i64; fn poke(&mut self, item: Self::Item) { self.v += *item; } }
fn main() -> i32 { return 0i32; }
