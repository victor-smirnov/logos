package ex3_both_anon_regions_using_impl_items;
trait Foo { fn foo<'a>(x: &mut Vec<&i64>, y: &i64); }
struct U;
impl Foo for U { fn foo(x: &mut Vec<&i64>, y: &i64) { x.push(y); } }
fn main() -> i32 { return 0i32; }
