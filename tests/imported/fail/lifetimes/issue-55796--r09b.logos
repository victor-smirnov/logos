package issue_55796_r09b;
trait It { fn get(self: &Self) -> i64; }
struct Holder<'a> { r: &'a i64 }
impl<'a> It for Holder<'a> { fn get(self: &Self) -> i64 { return *self.r; } }
struct G { v: i64 }
impl G { fn nb<'a>(self: &'a Self) -> Box<dyn It> { return Box::new(Holder { r: &self.v }); } }
fn smash() -> i64 { let a: i64 = 111i64; let b: i64 = 222i64; return a + b; }
fn main() -> i32 {
  let mut b: Box<dyn It>;
  { let g = G { v: 4242i64 }; b = g.nb(); }
  let j = smash();
  return b.get() as i32;
}
