package suggest_introducing_and_adding_missing_lifetime_param_may_not_live;
fn with_restriction<'b, T: 'b>(x: &'b i64) -> &'b i64 { return x; }
fn no_restriction<T>(x: &i64) -> &i64 {
  return with_restriction::<T>(x);
}
fn main() -> i32 { return 0i32; }
