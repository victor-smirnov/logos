package missing_lifetime_in_assoc_type_3;
// port of lifetimes/missing-lifetime-in-assoc-type-3.rs — bare reference as associated type
struct S { v: i64 }
trait Producer { type Item; fn produce(&self) -> Self::Item; }
impl Producer for S { type Item = &i64; fn produce(&self) -> Self::Item { return &self.v; } }
fn main() -> i32 { let s: S = S { v: 1i64 }; if *s.produce() != 1i64 { return 1i32; } return 0i32; }
