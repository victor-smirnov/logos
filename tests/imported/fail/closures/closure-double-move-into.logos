// Passing a moved struct twice into two closures.
package closure_double_move_into;

struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { } }

fn take(s: S) -> i64 { return s.v; }

fn main() -> i32 {
    let s: S = S { v: 1i64 };
    let _a: i64 = take(s);
    let _b: i64 = take(s);
    return 0i32;
}
