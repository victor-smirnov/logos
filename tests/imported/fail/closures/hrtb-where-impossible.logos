// B85: impl-where between binders → unsatisfiable.
package hrtb_where_impossible;
trait T<X, Y> { fn t(self: &Self, x: X, y: Y) -> i32 { return 0i32; } }
struct K { _x: i32 }
impl<'a, 'b> T<&'a i32, &'b i32> for K where 'a: 'b, 'b: 'a {}
fn want<X>() where X: for<'a, 'b> T<&'a i32, &'b i32> {}
fn main() -> i32 { want::<K>(); return 0i32; }
