// Borrow alive, then try to move-consume the borrowed local.
package closure_borrow_then_move;

struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { } }

fn take(s: S) -> i64 { return s.v; }

fn main() -> i32 {
    let s: S = S { v: 7i64 };
    let r: &S = &s;
    let _v: i64 = take(s);
    let _x: i64 = (*r).v;
    return 0i32;
}
