// B62: 3-arg HRTB; impl pins inner to 'static — rejected.
package hrtb_impl_fixed_region_tri;

trait Tri<A, B, C> { fn t(self: Self, a: A, b: B, c: C) -> i32 { return 0i32; } }

struct K { _x: i32 }
impl Tri<i32, &'static i64, u8> for K {}

fn want<F>() where F: for<'b> Tri<i32, &'b i64, u8> {}

fn main() -> i32 { want::<K>(); return 0i32; }
