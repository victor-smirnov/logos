// T4a: pinned 'static impl rejected by HRTB on non-Fn trait.
package hrtb_non_fn_static_impl;

trait Visitor<X> { fn visit(self: &Self, x: X) -> i32 { return 0i32; } }

struct V { _x: i32 }
impl Visitor<&'static i32> for V {}

fn run<T: for<'a> Visitor<&'a i32>>() {}

fn main() -> i32 { run::<V>(); return 0i32; }
