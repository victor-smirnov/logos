// B91: two impls of the same trait for the same non-generic type rejected.
package coherence_duplicate_impl;

trait T { fn x(self: &Self) -> i32; }
struct S { _x: i32 }
impl T for S { fn x(self: &S) -> i32 { return 1i32; } }
impl T for S { fn x(self: &S) -> i32 { return 2i32; } }

fn main() -> i32 { return 0i32; }
