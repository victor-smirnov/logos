// rustc dropck/dropck_trait_cycle_checked.rs — upstream E0597 does not live long enough
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: fail — REFUSED since 2026-08-27 (drop order inside one frame is REVERSE declaration order, so a Drop-bearing binding declared before its source outlives it)
// semantic port of rust tests/ui/dropck/dropck_trait_cycle_checked.rs
// core: a Drop value holds a borrow of a SIBLING in the SAME scope that is
// destroyed before it (holder declared first => dropped last).
package dropck_trait_cycle_checked;

struct H<'a> { r: &'a i64 }
impl<'a> Drop for H<'a> {
    fn drop(self: &mut Self) { let v = *self.r; if v < 0i64 { return; } }
}

fn main() -> i32 {
    let h: H;
    let x: i64 = 7i64;
    h = H { r: &x };
    return 0i32;
}
