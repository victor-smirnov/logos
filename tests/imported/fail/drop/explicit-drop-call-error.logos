package explicit_drop_call_error;
struct Foo { x: i32 }
impl Drop for Foo { fn drop(self: &mut Foo) {} }
fn main() -> i32 {
    let mut f: Foo = Foo { x: 1i32 };
    Drop::drop(&mut f);
    return 0i32;
}
