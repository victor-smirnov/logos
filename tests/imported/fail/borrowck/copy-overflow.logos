package copy_overflow;
struct S { f: str }
impl Drop for S { fn drop(self: &mut S) {} }
impl S { fn dup(self: &S) -> S { return *self; } }
fn main() -> i32 { let s = S{f:"a"}; let t = s.dup(); let _ = t.f; return 0i32; }
