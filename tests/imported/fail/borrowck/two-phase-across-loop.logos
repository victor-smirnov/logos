package two_phase_across_loop;
struct Foo { x: String }
impl Foo { fn get_string(self: &mut Foo) -> &String { return &self.x; } }
fn main() -> i32 {
    let mut foo: Foo = Foo { x: String::new() };
    let mut strings: Vec<&String> = Vec::new();
    loop {
        strings.push(foo.get_string());
        if strings.len() > 2i64 { break; }
    }
    return 0i32;
}
