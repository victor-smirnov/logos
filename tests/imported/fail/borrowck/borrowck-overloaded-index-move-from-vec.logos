package borrowck_overloaded_index_move_from_vec;
struct S { n: i64 }
impl Drop for S { fn drop(self: &mut S) {} }
fn main() -> i32 {
    let v: [S; 2] = [S{n:1i64}, S{n:2i64}];
    let good = &v[0i64];
    let bad = v[0i64];
    return bad.n as i32;
}
