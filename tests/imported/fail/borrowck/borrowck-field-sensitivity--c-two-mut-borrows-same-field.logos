package borrowck_field_sensitivity_c_two_mut_borrows_same_field;
struct A { a: i64, b: i64 }
fn main() -> i32 {
    let mut x = A { a: 1i64, b: 2i64 };
    let p = &mut x.a;
    let q = &mut x.a;
    return (*p + *q) as i32;
}
