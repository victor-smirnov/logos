package borrowck_pat_reassign_binding;
fn main() -> i32 {
    let mut x: Option<i64> = Option::None;
    match x {
        Option::None => { x = Option::Some(0i64); }
        Option::Some(ref i) => {
            x = Option::Some(*i + 1i64);
            let _ = *i;
        }
    }
    return 0i32;
}
