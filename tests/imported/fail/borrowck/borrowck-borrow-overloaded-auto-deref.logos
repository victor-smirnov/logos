package borrowck_borrow_overloaded_auto_deref;
use logos.lang.rc;
struct Point { x: i64, y: i64 }
fn deref_mut_field1(p: Rc<Point>) {
    let r: &mut i64 = &mut p.y;
    *r = 1i64;
}
fn main() -> i32 {
    let p: Rc<Point> = rc_new(Point { x: 1i64, y: 2i64 });
    deref_mut_field1(p);
    return 0i32;
}
