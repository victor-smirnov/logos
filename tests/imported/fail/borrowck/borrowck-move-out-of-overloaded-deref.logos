package borrowck_move_out_of_overloaded_deref;
struct Own { v: i64 }
impl Drop for Own { fn drop(self: &mut Own) { } }
struct Holder { inner: Own }
impl Deref for Holder { type Target = Own; fn deref(self: &Self) -> &Own { return &self.inner; } }
fn main() -> i32 {
    let h: Holder = Holder { inner: Own { v: 1i64 } };
    let x: Own = *h;
    return x.v as i32;
}
