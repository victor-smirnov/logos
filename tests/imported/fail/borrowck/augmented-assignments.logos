package augmented_assignments;
use logos.mem.boxed;
struct Int { v: Box<i32> }
impl AddAssign for Int { fn add_assign(self: &mut Self, o: Int) { } }
fn main() -> i32 {
    let mut x: Int = Int { v: Box::new(1i32) };
    x += x;
    return 0i32;
}
