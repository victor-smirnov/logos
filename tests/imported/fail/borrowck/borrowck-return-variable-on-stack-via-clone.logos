package borrowck_return_variable_on_stack_via_clone;
fn idc(r: &i64) -> &i64 { return r; }
fn leak(x: i64) -> &i64 {
    return idc(&x);   // E0515: returns value referencing function parameter `x`
}
fn main() -> i32 { return *leak(3i64) as i32; }
