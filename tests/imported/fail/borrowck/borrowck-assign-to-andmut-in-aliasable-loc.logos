package borrowck_assign_to_andmut_in_aliasable_loc;
struct S { pointer: &mut i64 }
fn a(s: &S) -> i32 { *s.pointer = *s.pointer + 1i64; return 0i32; }
fn main() -> i32 { let mut n: i64 = 1i64; let s: S = S { pointer: &mut n }; return a(&s); }
