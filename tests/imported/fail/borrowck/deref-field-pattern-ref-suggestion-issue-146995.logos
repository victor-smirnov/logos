package deref_field_pattern_ref_suggestion_issue_146995;
use logos.mem.string;
struct NonCopy { v: String }
struct Inner { field: NonCopy }
struct Wrap { z: Inner }
impl Deref for Wrap { type Target = Inner; fn deref(self: &Wrap) -> &Inner { return &self.z; } }
fn take(w: Wrap) -> i32 {
    let val: NonCopy = w.field;   // ERROR: cannot move out of dereference of `Wrap`
    return val.v.len() as i32;
}
fn main() -> i32 { return 0i32; }
