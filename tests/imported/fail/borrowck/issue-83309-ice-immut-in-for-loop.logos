package issue_83309_ice_immut_in_for_loop;
struct Q { n: i64 }
struct QI { p: &i64 }
impl Q { fn iter_mut(self: &mut Q) -> QI { return QI { p: &self.n }; } }
fn main() -> i32 {
    let mut q = Q { n: 1i64 };
    let it = q.iter_mut();
    let v: &i64 = it.p;
    *v -= 1i64;
    return 0i32;
}
