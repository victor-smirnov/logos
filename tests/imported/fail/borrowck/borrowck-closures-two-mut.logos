package borrowck_closures_two_mut;
fn to_fn_mut<F>(f: F) -> F where F: FnMut() { return f; }
fn main() -> i32 {
    let mut x: i64 = 3i64;
    let c1 = to_fn_mut(|| { x = 4i64; });
    let c2 = to_fn_mut(|| { x = 5i64; });
    c1();
    c2();
    return x as i32;
}
