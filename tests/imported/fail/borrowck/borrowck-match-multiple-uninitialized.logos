package borrowck_match_multiple_uninitialized;
enum Status { Active, Inactive, Pending }
fn main() -> i32 {
    let message: i64;
    let current: Status = Status::Pending;
    match current {
        Status::Active => { message = 1i64; }
        Status::Inactive => { message = 2i64; }
        Status::Pending => { return message as i32; }
    }
    return 0i32;
}
