package borrowck_issue_2657_2;
use logos.mem.string;
enum Opt { None, Some(String) }
fn main() -> i32 {
    let x = Opt::Some(String::from("hi"));
    match x {
        Opt::Some(ref y) => { let b = *y; return b.len() as i32; }
        Opt::None => { return 1i32; }
    }
}
