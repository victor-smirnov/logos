package borrowck_for_loop_head_linkage;
fn main() -> i32 {
    let mut vector: Vec<i64> = Vec::new();
    vector.push(1i64);
    vector.push(2i64);
    for x in vector.iter() {
        vector.push(0i64);      // E0502: vector is borrowed by the loop head
    }
    return 0i32;
}
