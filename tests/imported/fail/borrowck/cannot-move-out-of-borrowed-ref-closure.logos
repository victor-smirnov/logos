package cannot_move_out_of_borrowed_ref_closure;
struct NC { a: i64 }
impl Drop for NC { fn drop(self: &mut NC) {} }
fn mk<F>(f: F) -> F { return f; }
fn main() -> i32 {
    let v = NC { a: 5i64 };
    let r: &NC = &v;
    let c = mk(|| { let taken: NC = *r; return taken.a; });
    return 0i32;
}
