// shelf: fail — REFUSED since 2026-08-28 (a match used as a VALUE now raises
// the pattern binding's loan on the scrutinee sub-place, held by the enclosing
// `let`'s binding, which has an NLL last use)
package borrowck_anon_fields_struct;
struct Y { f0: i64, f1: i64 }
fn main() -> i32 {
    let mut y: Y = Y { f0: 1i64, f1: 2i64 };
    let a: &mut i64 = match y { Y { f0: ref mut a, f1: _ } => a };
    let b: &mut i64 = match y { Y { f0: ref mut b, f1: _ } => b };
    *a = *a + 1i64;
    *b = *b + 1i64;
    return 0i32;
}
