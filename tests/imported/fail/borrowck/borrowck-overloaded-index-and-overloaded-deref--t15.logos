package borrowck_overloaded_index_and_overloaded_deref_t15;
struct Foo { f: u64 }
struct MyVec { x: Foo }
impl Index<u64> for MyVec { type Output = Foo; fn index(self: &MyVec, i: u64) -> &Foo { return &self.x; } }
fn main() -> i32 {
