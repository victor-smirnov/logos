package borrowck_fn_in_const_a;
struct S { n: i64 }
impl Drop for S { fn drop(self: &mut S) {} }
fn broken(x: &S) -> S {
    return *x;
}
fn main() -> i32 {
    let s = S { n: 3i64 };
    let t = broken(&s);
    return t.n as i32 - 3i32;
}
