package two_phase_reservation_sharing_interference_2;
struct V { n: i64 }
impl V { fn extend(self: &mut V, other: &V) { self.n = self.n + other.n; } }
fn main() -> i32 {
    let mut v = V { n: 1i64 };
    let shared: &V = &v;
    v.extend(shared);
    return 0i32;
}
