package bindings_after_at_or_patterns_slice_patterns_box_patterns;
struct P { s: str }
impl Drop for P { fn drop(self: &mut P) {} }
enum T { Foo(P), Bar }
fn main() -> i32 {
    let x: T = T::Foo(P { s: "a" });
    match x {
        a @ T::Foo(_) => { let _ = a; }
        _ => {}
    }
    let r: &T = &x;
    return 0i32;
}
