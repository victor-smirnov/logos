package borrowck_match_already_borrowed;
enum Foo { A(i64), B }
fn main() -> i32 {
    let mut foo = Foo::B;
    let p: &mut Foo = &mut foo;
    let r: i64 = match foo { Foo::B => 1i64, Foo::A(x) => x };
    let _ = p;
    return r as i32;
}
