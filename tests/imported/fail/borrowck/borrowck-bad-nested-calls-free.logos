package borrowck_bad_nested_calls_free;
use logos.mem.boxed;
fn rewrite(v: &mut Box<i64>) -> i64 { *v = Box::new(22i64); return **v; }
fn add(v: &i64, w: i64) -> i64 { return *v + w; }
fn main() -> i32 {
    let mut a: Box<i64> = Box::new(1i64);
    let r = add(&*a, rewrite(&mut a));
    return r as i32;
}
