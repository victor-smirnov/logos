package ownership_struct_update_moved_error;
use logos.mem.string;
struct Mine { test: String, other_val: i64 }
fn make_bar(s: Mine) -> Mine { return Mine { test: String::from("9"), other_val: s.other_val }; }
fn main() -> i32 {
    let start: Mine = Mine { test: String::from("1"), other_val: 0i64 };
    let tmp: Mine = make_bar(start);
    let end: Mine = Mine { test: tmp.test, other_val: 1i64 };
    return start.test.len() as i32;
}
