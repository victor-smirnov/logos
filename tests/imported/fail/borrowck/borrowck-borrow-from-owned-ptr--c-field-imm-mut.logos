package borrowck_borrow_from_owned_ptr_c_field_imm_mut;
struct Bar { int1: i64, int2: i64 }
struct Foo { bar1: Bar, bar2: Bar }
fn main() -> i32 {
    let mut foo = Foo { bar1: Bar { int1: 1i64, int2: 2i64 }, bar2: Bar { int1: 3i64, int2: 4i64 } };
    let bar1 = &foo.bar1;
    let bar2 = &mut foo.bar1;
    let _ = bar1.int1;
    bar2.int1 = 8i64;
    return 0i32;
}
