package already_borrowed_as_mutable_if_let_133941;
struct Bar { r: &mut i64 }
impl Drop for Bar { fn drop(self: &mut Bar) {} }
struct Foo { n: i64 }
impl Foo {
    fn f(self: &mut Foo) -> Bar { return Bar { r: &mut self.n }; }
    fn g(self: &mut Foo) { self.n = self.n + 1i64; }
}
fn main() -> i32 {
    let mut foo = Foo { n: 0i64 };
    let b = foo.f();
    foo.g();          // E0499: foo already mutably borrowed by `b`
    let _ = *b.r;
    return 0i32;
}
