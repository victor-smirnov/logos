package borrowck_loan_rcvr;
struct Point { x: i64, y: i64 }
impl Point {
    fn blockm<F: Fn()>(self: &Point, f: F) { f(); }
}
fn main() -> i32 {
    let mut p: Point = Point { x: 3i64, y: 4i64 };
    p.blockm(|| { p.x = 10i64; });
    return 0i32;
}
