package clone_span_on_try_operator;
use logos.mem.string;
struct Foo { s: String }
impl Foo { fn eat(self: Self) -> i64 { return self.s.len(); } }
fn main() -> i32 {
    let f = Foo { s: String::from("hi") };
    let r = &f;
    return (*r).eat() as i32;
}
