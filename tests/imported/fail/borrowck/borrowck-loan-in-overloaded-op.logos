package borrowck_loan_in_overloaded_op;
use logos.mem.string;
struct Foo { v: String }
impl Foo { fn dup(self: &Foo) -> Foo { return Foo { v: String::from("d") }; } }
impl Add for Foo { type Output = Foo; fn add(self: Foo, f: Foo) -> Foo { return Foo { v: String::from("s") }; } }
fn main() -> i32 {
    let x: Foo = Foo { v: String::from("3") };
    let y: Foo = { x } + x.dup();   // ERROR: borrow of moved value `x`
    return y.v.len() as i32;
}
