package option_inspect_mutation;
struct S { field: i64 }
fn inspect(s: &S, f: fn(&S)) { f(s); }
fn main() -> i32 {
    let s = S { field: 42i64 };
    inspect(&s, |p: &S| { p.field = p.field * 10i64; });
    return s.field as i32;
}
