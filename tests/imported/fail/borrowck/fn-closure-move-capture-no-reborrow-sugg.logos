// (E0507 cannot move out of `foos`, a captured variable in an `Fn` closure)
package fn_closure_move_capture_no_reborrow_sugg;
struct Foo { s: str }
impl Drop for Foo { fn drop(self: &mut Foo) {} }
fn in_fn<F: Fn()>(f: F) { f(); f(); }
fn main() -> i32 {
    let foo = Foo { s: "a" };
    in_fn(|| { let g = foo; let _ = g.s; });
    return 0i32;
}
