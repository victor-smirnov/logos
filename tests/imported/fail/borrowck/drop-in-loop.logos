// upstream: drop-in-loop.rs E0506 (Drop impl could observe the changed borrow)
package drop_in_loop;
struct WrapperWithDrop { r: &mut bool }
impl Drop for WrapperWithDrop { fn drop(self: &mut WrapperWithDrop) {} }
fn drop_in_loop() {
    let mut base = true;
    let mut wrapper = WrapperWithDrop { r: &mut base };
    loop {
        base = false;    // E0506: base is borrowed by `wrapper`, live across the drop
        wrapper = WrapperWithDrop { r: &mut base };
    }
}
fn main() -> i32 { return 0i32; }
