package borrowck_loan_of_static_data_issue_27616;
use logos.mem.string;
fn evil(s: &mut String) -> i64 {
    let alias: &mut String = s;
    let inner: &String = alias;
    *s = String::from("");
    return inner.len();
}
fn main() -> i32 { let mut s = String::from("hello"); return evil(&mut s) as i32; }
