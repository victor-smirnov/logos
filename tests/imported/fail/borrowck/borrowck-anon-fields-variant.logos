package borrowck_anon_fields_variant;
enum Foo { X, Y(i64, i64) }
fn main() -> i32 {
    let mut y: Foo = Foo::Y(1i64, 2i64);
    let a: &mut i64;
    let b: &mut i64;
    match y { Foo::Y(ref mut p, _) => { a = p; } Foo::X => { return 1i32; } }
    match y { Foo::Y(ref mut q, _) => { b = q; } Foo::X => { return 2i32; } }
    *a = *a + 1i64;   // ERROR: two live &mut into y.0
    *b = *b + 1i64;
    return 0i32;
}
