// upstream: borrowck-lend-flow-match.rs E0506 assign to `x` while `ref r` borrow live
package borrowck_lend_flow_match;
enum Opt { None, Some(i64) }
fn separate_arms() -> i64 {
    let mut x = Opt::None;
    match x {
        Opt::None => { x = Opt::Some(0i64); }
        Opt::Some(ref r) => {
            x = Opt::Some(1i64);   // E0506: x is borrowed by r
            let _ = *r;
        }
    }
    return 0i64;
}
fn main() -> i32 { return separate_arms() as i32; }
