package borrowck_closures_unique;
fn get(x: &i64) -> i64 { return *x; }
fn set(x: &mut i64) -> i64 { *x = 1i64; return *x; }
fn d(x: &mut i64) -> i64 {
    let c1 = || -> i64 { return set(x); };
    let c2 = || -> i64 { return set(x); };
    return c1() + c2();
}
fn main() -> i32 { let mut v = 0i64; return d(&mut v) as i32; }
