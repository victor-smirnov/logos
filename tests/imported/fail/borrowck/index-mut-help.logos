package index_mut_help;
use logos.lang.ops;
struct M { vals: [i64; 4] }
impl Index<i64, i64> for M { fn index(self: &M, k: i64) -> &i64 { return &self.vals[k]; } }
fn main() -> i32 {
    let mut m: M = M { vals: [1i64,2i64,3i64,4i64] };
    m[0i64] = 9i64;
    return m[0i64] as i32;
}
