package rvalue_borrow_scope_error;
struct AddFlags { bits: u64 }
impl Drop for AddFlags { fn drop(self: &mut AddFlags) {} }
fn mk(bits: u64) -> AddFlags { return AddFlags { bits: bits }; }
fn arg(x: &AddFlags) -> &AddFlags { return x; }
fn main() -> i32 {
    let x1: &AddFlags = arg(&mk(1u64));
