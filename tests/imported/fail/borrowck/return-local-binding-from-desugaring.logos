// Semantic port: return a value that references a TEMPORARY produced inside the fn.
package return_local_binding_from_desugaring;
struct Item { n: i64 }
struct Holder { r: &i64 }
fn mk() -> Item { return Item { n: 5i64 }; }
fn group_by() -> Holder {
    let x = mk();
    return Holder { r: &x.n };   // E0515: returns a value referencing local data
}
fn main() -> i32 { let h = group_by(); return *h.r as i32; }
