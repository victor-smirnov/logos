package issue_81365_3;
struct DerefTarget { target_field: bool }
struct Container { target: DerefTarget, container_field: bool }
impl Deref for Container { type Target = DerefTarget; fn deref(self: &Container) -> &DerefTarget { return &self.target; } }
struct Outer { container: Container }
impl Outer {
    fn bad_borrow(self: &mut Outer) {
        let first: &bool = &self.container.target_field;
        self.container.container_field = true;
        let _ = *first;
    }
}
fn main() -> i32 {
    let mut o = Outer { container: Container { target: DerefTarget { target_field: false }, container_field: false } };
    o.bad_borrow();
    return 0i32;
}
