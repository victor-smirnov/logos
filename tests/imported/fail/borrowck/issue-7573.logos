package issue_7573;
use logos.mem.collections.vec;
struct CrateId { n: i64 }
fn list_database<F>(f: F) where F: FnMut(&CrateId) {
    let c = CrateId { n: 1i64 };
    f(&c);
}
fn main() -> i32 {
    let mut lines: Vec<&CrateId> = Vec::new();
    let push_id = |installed: &CrateId| { lines.push(installed); };
    list_database(push_id);
    return lines.len() as i32;
}
