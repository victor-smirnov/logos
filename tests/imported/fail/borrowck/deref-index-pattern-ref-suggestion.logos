package deref_index_pattern_ref_suggestion;
use logos.lang.ops;
use logos.mem.string;
struct NonCopy { v: String }
struct Wrap { inner: [NonCopy; 1] }
impl Deref<[NonCopy; 1]> for Wrap { fn deref(&self) -> &[NonCopy; 1] { return &self.inner; } }
fn main() -> i32 {
    let w = Wrap { inner: [NonCopy { v: String::from("a") }] };
    let val = w[0];
    return val.v.len() as i32;
}
