package borrowck_vec_pattern_tail_element_loan;
fn a() -> &i64 {
    let v: [i64; 4] = [1i64, 2i64, 3i64, 4i64];
    let s: &[i64] = &v;
    let tail: &i64 = match s {
        [_x, rest @ ..] => &rest[0u64],
        _ => &v[0u64],
