package borrowck_auto_mut_ref_to_immut_var;
struct Foo { x: i64 }
impl Foo { fn printme(self: &mut Foo) -> i64 { return self.x; } }
fn main() -> i32 { let x = Foo { x: 3i64 }; return x.printme() as i32; }
