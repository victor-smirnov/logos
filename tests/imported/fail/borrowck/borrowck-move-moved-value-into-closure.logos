// rustc borrowck/borrowck-move-moved-value-into-closure.rs — upstream E0382
// imported batch B167 @ da5114692c9ebe46b869488c5f34f92eb10b98c1 (rust 1.100.0)
// shelf: pin
// ADAPTATION, corrected 2026-10-06 (ADR 0030 S10 row 4): upstream's `move || *t + 1` over
// `t: Box<_>` captures `t` WHOLE (a by-value capture truncates at a deref). The first
// adaptation read the Copy field `t.v`, which rustc captures precisely — no move, no
// E0382 (rustc 1.98.1 accepts it). The closures here use `t` whole, as upstream's do.
package borrowck_move_moved_value_into_closure;
struct B { v: i64 }
impl Drop for B { fn drop(self: &mut B) {} }
fn call_f<F>(f: F) {}
fn main() -> i32 {
    let t = B { v: 3i64 };
    call_f(move || { let u = &t; return u.v + 1i64; });
    call_f(move || { let u = &t; return u.v + 1i64; });
    return 0i32;
}
