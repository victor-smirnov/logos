package borrowck_mut_borrow_of_mut_base_ptr_b;
fn bar(mut t0: &mut i64) {
    let p: &mut i64 = &mut *t0;
    let t2: &mut &mut i64 = &mut t0;
    **t2 = **t2 + 1i64;
    *p = *p + 1i64;
}
fn main() -> i32 { let mut z: i64 = 1i64; bar(&mut z); return 0i32; }
