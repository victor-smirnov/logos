package borrowck_uniq_via_lend_t18;
struct B { v: i64 }
fn borrow(_v: &i64) -> i64 { return *_v; }
fn aliased_mut() -> i64 {
    let mut v = B { v: 3i64 };
    let w: &mut B = &mut v;
    let r = borrow(&v.v);      // E0502: v is mutably borrowed by w
    w.v = 4i64;
    return r;
}
fn main() -> i32 { return aliased_mut() as i32; }
