package borrowck_consume_upcast_box;
trait Foo { fn dummy(self: &Self) -> i64; }
struct A { v: i64 }
impl Foo for A { fn dummy(self: &Self) -> i64 { return self.v; } }
fn consume(b: Box<dyn Foo>) -> i64 { return b.dummy(); }
fn foo(b: Box<dyn Foo>) -> i64 {
    let _x: i64 = consume(b);
    let _y: i64 = consume(b);
    return 0i64;
}
fn main() -> i32 { let b: Box<dyn Foo> = Box::new(A { v: 1i64 }); return foo(b) as i32; }
