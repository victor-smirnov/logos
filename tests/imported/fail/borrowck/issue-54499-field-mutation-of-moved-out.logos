package issue_54499_field_mutation_of_moved_out;
use logos.mem.string;
struct S { v: String }
struct Tpair { a: S, b: i64 }
fn eat(x: Tpair) -> i64 { return x.b; }
fn main() -> i32 {
    let mut u = Tpair { a: S { v: String::from("x") }, b: 0i64 };
    let n = eat(u);
    u.b = 2i64;
    return (n + u.b) as i32;
}
