package use_moved_value_in_match_guard_drop;
struct Own { n: i64 }
impl Drop for Own { fn drop(self: &mut Own) {} }
fn eat(o: Own) -> i64 { return o.n; }
fn main() -> i32 {
    let s = Own { n: 1i64 };
    let r = match 0i64 {
        0i64 if { let _ = eat(s); false } => 5i64,
        _ => eat(s),      // E0382: `s` could have been moved by the guard
    };
    return r as i32;
}
