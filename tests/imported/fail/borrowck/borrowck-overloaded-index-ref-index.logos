package borrowck_overloaded_index_ref_index;
struct Bar { x: i64 }
impl Index<i64> for Bar { type Output = i64; fn index(self: &Self, z: i64) -> &i64 { return &self.x; } }
fn main() -> i32 {
    let mut s: Bar = Bar { x: 1i64 };
    s[2i64] = 20i64;
    return 0i32;
}
