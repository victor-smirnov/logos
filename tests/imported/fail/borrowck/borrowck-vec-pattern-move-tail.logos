package borrowck_vec_pattern_move_tail;
fn main() -> i32 {
    let mut a: [i64; 4] = [1i64, 2i64, 3i64, 4i64];
    let t: &i64 = match a {
        [1i64, 2i64, ref x, _] => { x }
        _ => { return 1i32; }
    };
    a[2i64] = 0i64;
    return *t as i32;
}
