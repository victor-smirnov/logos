package issue_47646;
struct Heap { top: i64 }
impl Heap { fn peek_mut(self: &mut Heap) -> &mut i64 { return &mut self.top; } }
fn main() -> i32 {
    let mut heap: Heap = Heap { top: 1i64 };
    let borrow: &mut i64 = heap.peek_mut();
    match (borrow, 0i64) {
        (b, _) => { let _ = heap.top; let _ = *b; }
    }
    return 0i32;
}
