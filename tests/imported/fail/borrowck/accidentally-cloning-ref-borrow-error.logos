package accidentally_cloning_ref_borrow_error;
struct Str { x: i64 }
fn foo(s: &mut i64) { *s = 1i64; }
fn main() -> i32 {
    let s = Str { x: 0i64 };
    let sr: &Str = &s;
    foo(&mut sr.x);   // ERROR: cannot borrow `sr.x` as mutable, behind a `&` reference
    return 0i32;
}
