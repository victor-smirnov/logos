package borrowck_overloaded_index_autoderef;
use logos.lang.ops;
struct Foo { x: i64, y: i64 }
impl Index<i64, i64> for Foo { fn index(&self, z: i64) -> &i64 { if z == 0i64 { return &self.x; } return &self.y; } }
impl IndexMut<i64, i64> for Foo { fn index_mut(&mut self, z: i64) -> &mut i64 { if z == 0i64 { return &mut self.x; } return &mut self.y; } }
fn main() -> i32 {
    let mut f = Foo { x: 1i64, y: 2i64 };
    let p = &mut f[0i64];
    let q = &mut f[0i64];
    return (*p + *q) as i32;
}
