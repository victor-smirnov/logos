package unboxed_closures_move_upvar_from_non_once_ref_closure;
use logos.mem.string;
fn call<F: Fn()>(f: F) { f(); }
fn main() -> i32 {
    let y: String = String::from("World");
    call(|| { let z: String = y; });   // ERROR: cannot move out of `y`, a captured variable in an `Fn` closure
    return 0i32;
}
