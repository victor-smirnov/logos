// The loan `x = &mut v` is raised at the body's BOTTOM and its holder's last use
// `*x = *x + 1` is at the TOP: textually earlier, LATER IN TIME across the back
// edge. Its admit half is tests/logos/pass/bc_backedge_reassign_holder_admit —
// this file with the `borrow(&v)` line deleted.
package borrowck_lend_flow_loop;
fn borrow(v: &i64) -> i64 { return *v; }
fn main() -> i32 {
    let mut v: i64 = 3i64;
    let mut w: i64 = 4i64;
    let mut x: &mut i64 = &mut w;
    let mut i: i64 = 0i64;
    while i < 3i64 {
        *x = *x + 1i64;
        let _z: i64 = borrow(&v);
        x = &mut v;
        i = i + 1i64;
    }
    return 0i32;
}
