package moved_value_in_closure_suggestion_64559;
struct Own { n: i64 }
impl Drop for Own { fn drop(self: &mut Own) {} }
fn eat(o: Own) -> i64 { return o.n; }
fn main() -> i32 {
    let orig = Own { n: 1i64 };
    let _ = eat(orig);
    let c = || { return eat(orig); };   // E0382: orig moved above
    return c() as i32;
}
