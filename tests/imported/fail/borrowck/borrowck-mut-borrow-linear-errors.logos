package borrowck_mut_borrow_linear_errors;
struct Holder { p: &mut i64 }
fn main() -> i32 {
    let mut x: i64 = 1i64;
    let h1 = Holder { p: &mut x };
    let mut i: i64 = 0i64;
    loop {
        let h2 = Holder { p: &mut x };
        *h2.p = 3i64;
        i += 1i64;
        if i > 3i64 { break; }
    }
    *h1.p = 2i64;
    return 0i32;
}
