package closure_borrow_conflict_11192;
struct Foo { x: i64 }
impl Drop for Foo { fn drop(self: &mut Foo) {} }
fn main() -> i32 {
    let mut ptr: Box<Foo> = Box::new(Foo { x: 0i64 });
    let mut test = |foo: &Foo| { ptr = Box::new(Foo { x: foo.x + 1i64 }); };
    test(&*ptr);
    return 0i32;
}
