package borrowck_union_borrow;
union U { a: i64, b: i64 }
fn main() -> i32 {
    unsafe {
        let mut u = U { b: 0i64 };
        let ra = &u.a;
        let rma = &mut u.a;
        *rma = 1i64;
        return (*ra) as i32;
    }
}
