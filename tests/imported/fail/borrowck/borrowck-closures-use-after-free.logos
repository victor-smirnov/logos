package borrowck_closures_use_after_free;
struct Foo { x: i64 }
impl Drop for Foo { fn drop(self: &mut Foo) {} }
fn main() -> i32 {
    let mut ptr: Foo = Foo { x: 0i64 };
    let mut test = |f: &Foo| { ptr = Foo { x: f.x + 1i64 }; };
    test(&ptr);
    return 0i32;
}
