package borrowck_loan_rcvr_overloaded_op;
struct Point { x: i64, y: i64 }
impl Point { fn times(self: &Point, z: i64) -> i64 { return self.x * self.y * z; } }
fn main() -> i32 {
    let mut p = Point { x: 3i64, y: 4i64 };
    let q = &mut p;
    let a = p.times(3i64);
    q.x += 1i64;
    return a as i32;
}
