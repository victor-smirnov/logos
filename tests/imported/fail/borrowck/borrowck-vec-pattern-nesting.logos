package borrowck_vec_pattern_nesting;
fn main() -> i32 {
    let mut v: [Box<i64>; 3] = [Box::new(1i64), Box::new(2i64), Box::new(3i64)];
    match v {
        [ref _a, _, _] => {
            v[0] = Box::new(4i64);
            let _ = **_a;
        }
    }
    return 0i32;
}
