// upstream: borrowck/borrowck-no-cycle-in-exchange-heap.rs (E0505 cannot move out of `x`
// because it is borrowed by the `ref mut y` match binding)
package borrowck_no_cycle_in_exchange_heap_move_while_refmut_borrowed;
struct NodeD { a: Box<i64> }
enum Cycle { Node(NodeD), Empty }
fn main() -> i32 {
    let x: Box<Cycle> = Box::new(Cycle::Node(NodeD { a: Box::new(1i64) }));
    match *x {
        Cycle::Node(ref mut y) => { y.a = Box::new(2i64); let _ = x; }
        Cycle::Empty => {}
    }
    return 0i32;
}
