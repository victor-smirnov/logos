package move_out_of_slice_1;
struct A { n: i64 }
impl Drop for A { fn drop(self: &mut A) {} }
fn eat(a: A) -> i64 { return a.n; }
fn main() -> i32 {
    let arr: [A; 1] = [A { n: 1i64 }];
    let s: &[A] = &arr;
    let v: A = s[0];
    return eat(v) as i32;
}
