package use_of_moved_value_clone_suggestions;
struct Rcish { v: i64 }
impl Drop for Rcish { fn drop(self: &mut Rcish) {} }
struct Pair { a: Rcish, b: Rcish }
fn duplicate(t: Rcish) -> Pair { return Pair { a: t, b: t }; }
fn main() -> i32 {
    let p = duplicate(Rcish { v: 1i64 });
    return p.a.v as i32;
}
