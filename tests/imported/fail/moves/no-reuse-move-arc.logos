package no_reuse_move_arc;
// moves/no-reuse-move-arc.rs — E0382 use after move into a `move` closure
struct H { v: i64 }
impl Drop for H { fn drop(self: &mut H) {} }
fn main() -> i32 {
    let h = H { v: 4i64 };
    let c = move || -> i64 { return h.v; };
    let _ = h.v;
    let _ = c();
    return 0i32;
}
