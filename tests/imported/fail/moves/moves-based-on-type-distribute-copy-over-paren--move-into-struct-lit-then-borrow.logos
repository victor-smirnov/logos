package moves_based_on_type_distribute_copy_over_paren_move_into_struct_lit_then_borrow;
struct S { n: i64 }
impl Drop for S { fn drop(self: &mut S) {} }
struct Foo { f: S }
fn touch(a: &S) -> i64 { return a.n; }
fn main() -> i32 {
    let x: S = S { n: 1i64 };
    let _y: Foo = Foo { f: x };
    return touch(&x) as i32;
}
