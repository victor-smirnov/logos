package v2;
use logos.mem.boxed;
use logos.mem.collections.vec;
use logos.std.fmt;
use logos.std.io;
use logos.lang.iter;
trait Tag { fn tag(&self) -> i32; }
struct A(i32);
impl Tag for A { fn tag(&self) -> i32 { return self.0; } }
fn main() {
let a = A(1); let d: &dyn Tag = &a; let f = |x: &&dyn Tag| -> i32 { return x.tag(); }; println!("cl {}", f(&d));
}
