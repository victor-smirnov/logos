package tail_temp;
use logos.std.fmt;
struct D { c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + 1i64; } } }
impl D { fn get(self: &D) -> i64 { 5i64 } }
fn g(p: *mut i64) -> i64 { D { c: p }.get() }
fn main() {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r = g(p);
    println!("{} {}", r, unsafe { n });
}
