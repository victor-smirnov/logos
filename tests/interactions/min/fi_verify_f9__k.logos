package k;
use logos.mem.boxed;
trait Shape { fn area(&self) -> i64; }
struct Sq { s: i64 }
impl Shape for Sq { fn area(&self) -> i64 { return self.s * self.s; } }
fn side(s: &dyn Shape) -> i64 { return s.area(); }
fn main() -> i32 {
    let x: Box<dyn Shape> = Box::new(Sq { s: 4 });
    return side(&(*x)) as i32;
}
