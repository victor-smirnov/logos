package u2d;
use logos.std.fmt;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.lang.option;
use logos.lang.result;
use logos.lang.cmp;
use logos.lang.iter;
use logos.mem.boxed;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.clone;
use logos.lang.str;
use logos.lang.mem;
use logos.std.compiler.metaprog;
struct V2<T> { x: T, y: T }
fn f(v: V2<i64>) -> i64 { v.x + v.y }
fn main() { println!("{}", f(V2 { x: 3, y: 4 })); let w: V2<i64> = V2 { x: 5, y: 6 }; println!("{}", w.x); }
