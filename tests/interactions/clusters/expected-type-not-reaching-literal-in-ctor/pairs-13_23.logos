package f14d;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.clone;
use logos.lang.ops;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.collections.btree;
use logos.std.compiler.metaprog;
use logos.lang.default;
use logos.lang.hash;
fn main() {
    let o: Option<i64> = None;
    println!("{}", o.unwrap_or_else(|| 5));
    let v: Vec<i64> = vec![1, 2];
    let w: Vec<i64> = v.iter().map(|x| x + 1).collect();
    let z: Vec<i64> = v.iter().map(|_x| 9).collect();
    println!("{:?} {:?}", w, z);
}
