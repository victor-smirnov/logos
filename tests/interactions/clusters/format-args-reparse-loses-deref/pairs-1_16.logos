package e13;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.clone;
use logos.std.fmt;
trait Counter { fn get(&self) -> i64; }
struct ByOne { n: i64 }
impl Counter for ByOne { fn get(&self) -> i64 { self.n } }
fn look(c: &dyn Counter) -> i64 { c.get() }
fn main() {
    let b: Box<dyn Counter> = Box::new(ByOne { n: 10 });
    println!("{}", look(&*b));
}
