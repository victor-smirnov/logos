package m_dyn_eq;
use logos.std.fmt;
use logos.lang.rc;
use logos.lang.cell;
use logos.mem.boxed;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.ops;
use logos.lang.clone;
use logos.lang.default;
use logos.lang.hash;
use logos.lang.convert;
use logos.mem.fmt;
use logos.std.compiler.metaprog;
trait Shape { fn area(&self) -> i64; }
struct Sq(i64); struct R { w: i64, h: i64 }
impl Shape for Sq { fn area(&self) -> i64 { self.0 * self.0 } }
impl Shape for R { fn area(&self) -> i64 { self.w * self.h } }
impl PartialEq for dyn Shape { fn eq(&self, o: &dyn Shape) -> bool { self.area() == o.area() } }
fn main() { let x: &dyn Shape = &Sq(4); let y: &dyn Shape = &R { w: 8, h: 2 }; let z: &dyn Shape = &Sq(1); println!("{} {} {}", *x == *y, *x == *z, x.eq(y)); }
