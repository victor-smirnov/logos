package m52;
use logos.std.fmt;
use logos.mem.string;
use logos.lang.rc;
struct Buf<const N: i64> { data: [i64; N] }
impl<const N: i64> Buf<N> { fn len(&self) -> i64 { N } }
fn main() {
    let b = Buf { data: [1, 1, 1] };
    println!("{}", b.len());
    let c = [4i64, 5].into_iter().map(|x| x + 1).sum::<i64>();
    println!("{}", c);
}
