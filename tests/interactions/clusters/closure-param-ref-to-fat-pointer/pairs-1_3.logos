package j2;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.clone;
use logos.std.fmt;
trait Area { fn area(&self) -> i64; }
struct Tri; struct Sq2 { k: i64 }
impl Area for Tri { fn area(&self) -> i64 { 30 } }
impl Area for Sq2 { fn area(&self) -> i64 { self.k } }
fn main() {
    let mut shapes: Vec<Box<dyn Area>> = Vec::new();
    shapes.push(Box::new(Tri)); shapes.push(Box::new(Sq2 { k: 16 }));
    let t: i64 = shapes.iter().map(|s| s.area()).sum();
    println!("{}", t);
}
