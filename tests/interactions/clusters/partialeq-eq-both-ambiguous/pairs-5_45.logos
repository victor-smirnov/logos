package f47_derive_partialeq_and_eq;
use logos.lang.mem;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.std.compiler.metaprog;
use logos.lang.ptr;
use logos.lang.cell;
#[derive_partial_eq]
#[derive_eq]
struct Pt { x: i64, y: i64 }
fn main() { println!("{} {}", Pt { x: 1, y: 2 } == Pt { x: 1, y: 2 }, Pt { x: 1, y: 2 } != Pt { x: 1, y: 3 }); }
