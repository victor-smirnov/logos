package m62c;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.rc;
use logos.lang.cell;
use logos.mem.boxed;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.ops;

struct N { id: i32 }
impl Drop for N { fn drop(&mut self) { println!("drop {}", self.id); } }
fn main() {
    let c = RefCell::new(N { id: 1 });
    let old = c.replace(N { id: 2 });
    println!("{} {}", old.id, c.borrow().id);
}
