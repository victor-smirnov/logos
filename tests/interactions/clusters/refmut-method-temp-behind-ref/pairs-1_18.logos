package e8;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.clone;
use logos.std.fmt;
struct C { n: i64 }
impl C { fn bump(&mut self) -> i64 { self.n += 1; self.n } }
fn main() { let mut v: Vec<Box<C>> = Vec::new(); v.push(Box::new(C { n: 0 })); println!("{}", v[0].bump()); }
