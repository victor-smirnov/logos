package m4;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.rc;
use logos.lang.cell;
use logos.mem.boxed;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.ops;
fn main() {
    let s = String::from("ab cd");
    let parts: Vec<&str> = s.split(' ').collect();
    println!("{}", parts.len());
    let n = s.chars().count();
    println!("{}", n);
    let t = s.as_str();
    println!("{}", t.chars().count());
}
