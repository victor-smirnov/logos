package m7x;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.std.fmt;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.collections.hashmap;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.mem;
trait Act { fn act(&mut self) -> i64; }
struct Counter { n: i64 }
impl Act for Counter { fn act(&mut self) -> i64 { self.n += 1; return self.n; } }
fn run() {
    let mut b: Box<dyn Act> = Box::new(Counter { n: 0 });
    let a: &mut Box<dyn Act> = &mut b;
    a.act();
    println!("{}", a.act());
}
fn main() -> i32 { run(); return 0; }
