package m05h;
use logos.std.compiler.metaprog;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.std.fmt;
use logos.std.io;
use logos.lang.cmp;
use logos.lang.rc;
use logos.lang.iter;
use logos.mem.boxed;
use logos.lang.ops;
use logos.lang.mem;
use logos.lang.hash;
use logos.lang.cell;
use logos.lang.ptr;
trait Sh { fn area(&self) -> i64; }
struct Sq(i64);
impl Sh for Sq { fn area(&self) -> i64 { return self.0; } }
struct Gen { i: i64 }
impl Iterator<Box<dyn Sh>> for Gen {
    fn next(&mut self) -> Option<Box<dyn Sh>> { if self.i >= 3 { return None; } self.i += 1; return Some(Box::new(Sq(self.i))); }
}
fn main() {
    let mut g = Gen { i: 0 };
    while let Some(s) = g.next() { println!("{}", s.area()); }
}
