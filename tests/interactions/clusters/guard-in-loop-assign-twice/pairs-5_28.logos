package f28_loop_match_same_variant_rebind;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.std.compiler.metaprog;
use logos.lang.ptr;
enum Ev { Click(i64), Key(char) }
fn main() {
    let evs: Vec<Ev> = vec![Ev::Click(3), Ev::Key('a'), Ev::Click(5)];
    let mut t = 0i64;
    for e in evs.into_iter() { match e { Ev::Click(n) if n > 4 => { t += n; } _ => { t += 1; } } }
    println!("{}", t);
}
