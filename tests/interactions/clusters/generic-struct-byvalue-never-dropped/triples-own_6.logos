package m16l;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.std.fmt;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.collections.hashmap;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.mem;
struct Noisy { name: String } impl Drop for Noisy { fn drop(&mut self) { println!("drop {}", self.name); } } struct P<T> { n: Noisy, v: T } fn run() { let a: P<i64> = P { n: Noisy { name: String::from("inner") }, v: 1 }; drop(a); println!("end"); }
fn main() -> i32 { run(); return 0; }
