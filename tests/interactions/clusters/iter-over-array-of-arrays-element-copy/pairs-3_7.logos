package u19e;
use logos.std.fmt;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.lang.option;
use logos.lang.result;
use logos.lang.cmp;
use logos.lang.iter;
use logos.mem.boxed;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.clone;
use logos.lang.str;
use logos.lang.mem;
use logos.std.compiler.metaprog;
fn bump(r: &mut [i64; 2]) { r[0] += 5; }
fn main() {
    let mut v: Vec<[i64; 2]> = vec![[1, 2], [3, 4]];
    for r in v.iter_mut() { r[1] = 0; }
    println!("{:?}", v);
    for r in v.iter_mut() { bump(r); }
    println!("{:?}", v);
    let mut w: Vec<(i64, i64)> = vec![(1, 2)];
    for t in w.iter_mut() { t.0 += 100; }
    println!("{:?}", w);
}
