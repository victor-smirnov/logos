package m24a;
use logos.std.compiler.metaprog;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.std.fmt;
use logos.std.io;
use logos.lang.cmp;
use logos.lang.rc;
use logos.lang.iter;
use logos.mem.boxed;
use logos.lang.ops;
use logos.lang.mem;
use logos.lang.hash;
use logos.lang.cell;
use logos.lang.ptr;
use logos.lang.num.error;
use logos.lang.num.parse;
fn p(x: &str) -> Result<i64, ParseIntError> { let n: i64 = x.parse()?; return Ok(n + 1); }
fn q(x: &str) -> Result<i64, ParseIntError> { let n = x.parse::<i64>()?; return Ok(n + 1); }
fn fe(v: &Vec<i64>) -> Option<i64> { let f = v.iter().find(|x| **x % 2 == 0)?; return Some(*f + 1); }
fn takes(s: &i64) -> i64 { return *s; }
fn main() {
    println!("{:?} {:?}", q("41"), p("41"));
    let v: Vec<i64> = vec![1, 4];
    println!("{:?}", fe(&v));
    let x = 5i64; let r = &x; let rr = &r;
    println!("{}", takes(rr));
}
