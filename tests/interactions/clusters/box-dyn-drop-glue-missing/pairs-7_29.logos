package m9b;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.rc;
use logos.lang.cell;
use logos.mem.boxed;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.ops;
trait S { fn n(&self) -> i64; }
struct E { v: Vec<i64> }
impl S for E { fn n(&self) -> i64 { self.v.len() as i64 } }
fn main() {
    let mut vs: Vec<Box<dyn S>> = Vec::new();
    vs.push(Box::new(E { v: vec![1, 2, 3] }));
    println!("{}", vs[0].n());
}
