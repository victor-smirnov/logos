package f06;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.clone;
use logos.lang.ops;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.collections.btree;
use logos.std.compiler.metaprog;
use logos.lang.default;
use logos.lang.hash;
#[derive_clone] #[derive_copy] #[derive_partial_eq] #[derive_partial_ord]
struct Pt { x: i32, y: i32 }
fn maxp<T: PartialOrd + Copy>(a: T, b: T) -> T { if a > b { return a; } return b; }
fn main() {
    let m = maxp(Pt { x: 1, y: 5 }, Pt { x: 1, y: 3 });
    println!("{} {}", m.x, m.y);
    println!("{}", maxp(3, 9));
}
