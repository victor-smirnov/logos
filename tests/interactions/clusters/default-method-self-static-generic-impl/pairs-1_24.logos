package u01m;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.clone;
use logos.std.fmt;
trait Named {
    fn tag() -> i64;
    fn full(&self) -> i64 { Self::tag() + 1 }
}
struct Rect<T> { w: T }
impl<T> Named for Rect<T> { fn tag() -> i64 { 9 } }
fn main() {
    let r = Rect { w: 3i32 };
    println!("{} {}", r.full(), r.w);
}
