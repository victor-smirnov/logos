package ah3;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.clone;
use logos.std.fmt;
fn g(n: &Option<i64>) -> i64 { match n { Some(b) => *b, None => 0 } }
fn h(n: &Option<i64>) -> i64 { match n { None => 0, Some(b) => *b } }
fn k(n: &Option<i64>) -> i64 { match *n { None => 0, Some(b) => b } }
fn m(n: &Option<i64>) -> i64 { match n { &None => 0, &Some(b) => b } }
fn main() { let c = Some(7i64); println!("{} {} {} {} {}", g(&c), h(&c), k(&c), m(&c), { let nn: Option<i64> = None; h(&nn) }); }
