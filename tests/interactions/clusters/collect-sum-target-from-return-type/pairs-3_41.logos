package f_sum_tail;
use logos.std.fmt; use logos.mem.collections.vec; use logos.mem.string; use logos.lang.iter; use logos.lang.option; use logos.lang.result; use logos.lang.cmp; use logos.lang.ops; use logos.mem.boxed; use logos.lang.rc; use logos.lang.str; use logos.lang.clone;
fn sum_a(v: Vec<i64>) -> i64 { return v.into_iter().sum(); }
fn sum_b(v: Vec<i64>) -> i64 { let s: i64 = v.into_iter().sum(); s }
fn main() {
    let mut v: Vec<i64> = Vec::new(); v.push(3); v.push(4);
    println!("{}", sum_b(v.clone()));
    println!("{}", sum_a(v));
}
