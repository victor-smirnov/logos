package f24_closure_returns_param_ref;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
fn main() {
    let names: Vec<String> = vec![String::from("bob"), String::from("alice"), String::from("eve")];
    let longest = names.iter().fold(&names[0], |acc: &String, s: &String| -> &String { if s.len() > acc.len() { return s; } return acc; });
    println!("{}", longest);
}
