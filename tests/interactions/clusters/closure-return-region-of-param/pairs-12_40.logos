package m19b;
use logos.std.compiler.metaprog;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.std.fmt;
use logos.std.io;
use logos.lang.cmp;
use logos.lang.rc;
use logos.lang.iter;
use logos.mem.boxed;
use logos.lang.ops;
use logos.lang.mem;
use logos.lang.hash;
use logos.lang.cell;
use logos.lang.ptr;
fn main() {
    let v: Vec<(String, i64)> = vec![(String::from("b"), 2)];
    let a: Vec<&str> = v.iter().map(|(n, _)| n.as_str()).collect();
    let b: Vec<&String> = v.iter().map(|t| &t.0).collect();
    println!("{} {}", a.len(), b.len());
}
