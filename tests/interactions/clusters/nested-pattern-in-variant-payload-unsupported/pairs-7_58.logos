package m43;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.rc;
use logos.lang.cell;
use logos.mem.boxed;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.ops;
fn main() {
    let v: Vec<i64> = vec![1, 2];
    let mut it = v.iter();
    if let Some(&n) = it.next() { println!("{}", n); }
    let o: Option<(i64, i64)> = Some((1, 2));
    if let Some((a, 2)) = o { println!("{}", a); }
}
