package m53;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.rc;
use logos.lang.cell;
use logos.mem.boxed;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.ops;
#[derive_clone]
#[derive_copy]
enum Op { Add, Sub }
const OPS: [Op; 2] = [Op::Add, Op::Sub];
const NS: [i64; 2] = [5, 6];
fn main() {
    for op in OPS.iter() { match op { Op::Add => println!("add"), Op::Sub => println!("sub") } }
    let s: i64 = NS.iter().sum();
    println!("{}", s);
}
