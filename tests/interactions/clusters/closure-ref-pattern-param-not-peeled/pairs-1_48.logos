package ae4;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.clone;
use logos.std.fmt;
fn main() { let v: Vec<i64> = vec![1, 2]; let s: i64 = v.iter().filter(|&x| x % 2 == 0).sum(); let w: Vec<i64> = v.iter().map(|&y| y + 1).filter(|&x| x > 2).collect(); println!("{} {:?}", s, w); }
