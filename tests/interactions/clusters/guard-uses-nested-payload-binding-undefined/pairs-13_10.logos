package f34;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.clone;
use logos.lang.ops;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.collections.btree;
use logos.std.compiler.metaprog;
use logos.lang.default;
use logos.lang.hash;
struct D(&'static str);
enum E { Two(D, D), Empty }
fn peek(e: &E) -> &'static str {
    match e { E::Two(D(a), D(b)) if a.len() > b.len() => a, E::Two(_, D(b)) => b, E::Empty => "empty" }
}
fn main() { println!("{}", peek(&E::Two(D("long"), D("s")))); }
