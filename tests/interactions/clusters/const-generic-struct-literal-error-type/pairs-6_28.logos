use logos.std.compiler.metaprog;
struct B<const N: i64> { d: [i64; N], len: i64 }
impl<const N: i64> B<N> { fn new() -> Self { B { d: [0; N], len: 0 } } }
fn main() { let b: B<3> = B::new(); println!("{}", b.d[2] + b.len as i64); }
