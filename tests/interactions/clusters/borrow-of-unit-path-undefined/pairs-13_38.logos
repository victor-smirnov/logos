package f23;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.clone;
use logos.lang.ops;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.collections.btree;
use logos.std.compiler.metaprog;
use logos.lang.default;
use logos.lang.hash;
struct Bag;
impl Bag { fn v(&self) -> i32 { return 7; } }
fn take(i: usize) -> usize { return i + 1; }
fn by_ref(b: &Bag) -> i32 { return b.v(); }
fn main() {
    let mut s: usize = 0;
    for i in 0usize..3usize { s += take(i); }
    println!("{}", s);
    println!("{}", by_ref(&Bag));
}
