package p16f;
use logos.lang.rc;
use logos.lang.cell;
use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.result;
use logos.mem.boxed;
use logos.lang.cmp;
use logos.lang.ops;
use logos.std.compiler.metaprog;
fn parse(s: &str) -> Option<i64> { s.parse::<i64>().ok() }
fn main() { let parsed = ["12", "x", "30"].iter().map(|s| parse(*s)).collect::<Vec<_>>(); println!("{}", parsed.len()); }
