package f36_derive_partialeq_enum;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.std.compiler.metaprog;
use logos.lang.ptr;
#[derive_partial_eq]
enum Color { Red, Green, Blue }
#[derive_partial_eq]
enum Sh { Dot(i64), Empty }
fn main() {
    println!("{} {}", Color::Green == Color::Red, Color::Blue != Color::Red);
    println!("{} {}", Sh::Dot(1) == Sh::Empty, Sh::Dot(1) == Sh::Dot(2));
}
