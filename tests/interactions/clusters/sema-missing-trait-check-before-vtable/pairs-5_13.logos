package u6r1;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
trait Item { fn weight(&self) -> i64; }
struct A { w: i64 }
struct N { w: i64 }
impl Item for A { fn weight(&self) -> i64 { return self.w; } }
fn main() {
    let mut v: Vec<Box<dyn Item>> = Vec::new();
    v.push(Box::new(A { w: 5 }));
    v.push(Box::new(N { w: 5 }));
    println!("{}", v.len());
}
