package ak3;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.clone;
use logos.std.fmt;
fn pow<T: Mul<Output = T> + Copy>(b: T, e: i64, one: T) -> T { let mut r = one; let mut i = 0i64; while i < e { r = r * b; i += 1; } return r; }
fn main() { println!("{}", pow(2i64, 10, 1i64)); }
