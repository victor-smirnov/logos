package p01l;
use logos.mem.collections.vec; use logos.mem.string; use logos.lang.str; use logos.lang.option; use logos.std.fmt; use logos.lang.result; use logos.lang.cmp; use logos.lang.rc; use logos.lang.iter; use logos.mem.boxed; use logos.lang.cell; use logos.lang.ops; use logos.lang.ptr; use logos.lang.mem; use logos.lang.error; use logos.mem.collections.hashmap; use logos.mem.collections.btree; use logos.mem.collections.set; use logos.mem.collections.deque; use logos.lang.hash;
trait Shape { fn area(&self) -> i64; }
struct Sq { s: i64 }
impl Clone for Sq { fn clone(&self) -> Sq { Sq { s: self.s } } }
impl Shape for Sq { fn area(&self) -> i64 { self.s * self.s } }
fn mk(t: &Sq) -> Box<dyn Shape> { Box::new(t.clone()) }
fn main() {
    let n: i64 = 5;
    let b = mk(&Sq { s: n });
    println!("{}", b.area());
}
