use logos.std.fmt;
fn g(x: &i64) -> i64 { match x { 1..=5 => 1, _ => 2 } }
fn h(t: &(i64, i64)) -> i64 { match t { (0..=9, y) => *y, _ => -1 } }
fn main() { println!("{} {} {} {}", g(&3), g(&9), h(&(4, 8)), h(&(40, 8))); }
