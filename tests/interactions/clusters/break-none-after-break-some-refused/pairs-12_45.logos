package m12c;
use logos.std.compiler.metaprog;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.std.fmt;
use logos.std.io;
use logos.lang.cmp;
use logos.lang.rc;
use logos.lang.iter;
use logos.mem.boxed;
use logos.lang.ops;
use logos.lang.mem;
use logos.lang.hash;
use logos.lang.cell;
use logos.lang.ptr;
fn f(v: &Vec<i64>) -> Option<i64> {
    let r = 'outer: loop {
        for x in v.iter() { if *x > 3 { break 'outer Some(*x); } }
        break None;
    };
    return r;
}
fn g(v: &Vec<i64>) -> Option<i64> {
    let r = loop { if v.len() > 9 { break Some(1); } break None; };
    return r;
}
fn main() { let v: Vec<i64> = vec![1, 5]; println!("{:?} {:?}", f(&v), g(&v)); }
