package ar4;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.clone;
use logos.std.fmt;
fn find(xs: &[i64], t: i64) -> Option<i64> { let mut i = 0i64; let r = loop { if i >= xs.len() as i64 { break None; } if xs[i] == t { break Some(i); } i += 1; }; return r; }
fn main() { println!("{:?} {:?}", find(&[4, 5, 6], 6), find(&[4], 9)); }
