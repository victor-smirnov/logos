package p16m;
use logos.lang.rc;
use logos.lang.cell;
use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.result;
use logos.mem.boxed;
use logos.lang.cmp;
use logos.lang.ops;
use logos.std.compiler.metaprog;
fn main() { let v: Vec<Option<i64>> = vec![Some(12), None, Some(30)]; for p in &v { println!("{:?}", p); } for p in &v { match p { Some(n) => println!("s {}", n), None => println!("none") } } }
