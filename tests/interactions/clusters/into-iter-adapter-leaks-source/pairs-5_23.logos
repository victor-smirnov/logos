package f23_into_iter_adapter_collect_leak;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
fn main() {
    let v: Vec<i64> = vec![1, 2, 3];
    let b: Vec<i64> = v.into_iter().rev().collect();
    println!("{:?}", b);
    let w: Vec<i64> = vec![4, 5];
    let c: Vec<i64> = w.into_iter().map(|x: i64| -> i64 { return x * 2; }).collect();
    println!("{:?}", c);
}
