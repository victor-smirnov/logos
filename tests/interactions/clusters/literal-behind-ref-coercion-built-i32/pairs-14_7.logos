fn f(p: &(i64, i64)) -> i64 { p.0 * 100 + p.1 }
fn g(p: &i64) -> i64 { *p }
fn main() { println!("{} {} {}", f(&(3, 4)), f(&(3i64, 4i64)), g(&5000000000)); let x = &(7, 8); println!("{}", f(x)); }
