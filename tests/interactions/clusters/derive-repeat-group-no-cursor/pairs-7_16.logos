#[derive_clone]
#[derive_copy]
#[derive_partial_eq]
struct M { amt: i64 }
#[derive_clone]
#[derive_copy]
#[derive_partial_eq]
struct N { a: i64, b: i64 }
fn main() { println!("{} {}", M { amt: 1 } == M { amt: 1 }, N { a: 1, b: 2 } == N { a: 1, b: 3 }); }
