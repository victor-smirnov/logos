package m64c;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.rc;
use logos.lang.cell;
use logos.mem.boxed;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.ops;


fn main() {
    let counter = Rc::new(RefCell::new(0));
    let inc = { let c = Rc::clone(&counter); move |k: i32| { *c.borrow_mut() += k; } };
    inc(5); inc(6);
    println!("{}", *counter.borrow());
}
