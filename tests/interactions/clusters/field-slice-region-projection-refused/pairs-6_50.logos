package p01f;
use logos.lang.rc;
use logos.lang.cell;
use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.result;
use logos.mem.boxed;
use logos.lang.cmp;
use logos.lang.ops;
use logos.std.compiler.metaprog;
struct Holder<'a> { items: &'a [i32] }
impl<'a> Holder<'a> {
    fn first(&self) -> &'a i32 { &self.items[0] }
}
fn main() {
    let data = [3, 9];
    let m: &i32;
    {
        let h = Holder { items: &data };
        m = h.first();
    }
    println!("{}", m);
}
