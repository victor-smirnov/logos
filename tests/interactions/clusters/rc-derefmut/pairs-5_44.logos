package f46_rc_mut_deref_assign;
use logos.lang.mem;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.std.compiler.metaprog;
use logos.lang.ptr;
use logos.lang.cell;
struct P { x: i64 }
fn main() {
    let mut r = Rc::new(P { x: 5 });
    let r2 = Rc::clone(&r);
    r.x = 6;
    let mut q = Rc::new(1i64);
    let q2 = q.clone();
    *q = 9;
    println!("{} {} {}", r.x, r2.x, *q2);
}
