package m48;
use logos.std.fmt; use logos.mem.collections.vec; use logos.lang.iter; use logos.mem.string; use logos.lang.option; use logos.lang.result; use logos.lang.ops; use logos.lang.cmp; use logos.lang.str; use logos.mem.boxed;
fn mk() -> String { let mut s = String::new(); s.push_str("hello"); s }
fn mk2() -> String { let s = String::from("world"); s }
fn mkv() -> Vec<i64> { let v: Vec<i64> = Vec::new(); v }
fn main() {
    let a = mk(); println!("{}", a);
    let b = mk2(); println!("{}", b);
    let c = mkv(); println!("{}", c.len());
    let h: String = { let mut b = String::new(); b.push_str("blk"); b }; println!("{}", h);
}
