package r16b;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.std.fmt;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.collections.hashmap;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.mem;
struct Pool<T> { items: Vec<T> }
impl<T> Pool<T> { fn dup(&self) -> Pool<T> { return Pool { items: self.items.clone() }; } }
fn run() { let p: Pool<String> = Pool { items: vec![String::from("a")] }; let q = p.dup(); println!("{}", q.items.len()); }
fn main() -> i32 { run(); return 0; }
