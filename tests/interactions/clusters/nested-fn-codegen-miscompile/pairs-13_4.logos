package f51c;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.clone;
use logos.lang.ops;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.collections.btree;
use logos.std.compiler.metaprog;
use logos.lang.default;
use logos.lang.hash;
use logos.lang.num.error;
use logos.lang.ptr;
fn main() {
    fn h(n: i32) -> i32 { let mut acc = 0; let mut i = 0; while i < n { acc += i; i += 1; } return acc; }
    fn k(s: &[i64]) -> i64 { let mut acc: i64 = 0; for v in s.iter() { acc += *v; } return acc; }
    println!("{} {}", h(5), k(&[1, 2, 3]));
}
