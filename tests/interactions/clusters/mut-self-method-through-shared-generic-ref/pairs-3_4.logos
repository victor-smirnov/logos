package u4s;
use logos.std.fmt;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.lang.option;
use logos.lang.result;
use logos.lang.cmp;
use logos.lang.iter;
use logos.mem.boxed;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.clone;
use logos.lang.str;
use logos.lang.mem;
use logos.std.compiler.metaprog;
struct C { n: i64 }
trait Counter { fn bump2(&mut self); }
impl Counter for C { fn bump2(&mut self) { self.n += 10; } }
fn g<T: Counter>(t: &T) { t.bump2(); }
fn main() { let c = C { n: 1 }; g(&c); println!("{}", c.n); }
