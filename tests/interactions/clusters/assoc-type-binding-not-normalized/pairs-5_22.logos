package f22_assoc_eq_bound_not_normalized;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
trait Shape { type Unit; fn sides(&self) -> Vec<Self::Unit>; }
struct Sq { s: i64 }
impl Shape for Sq { type Unit = i64; fn sides(&self) -> Vec<i64> { let v: Vec<i64> = vec![self.s, self.s + 1]; return v; } }
fn longest<S: Shape<Unit = i64>>(s: &S) -> i64 { let mut m = 0i64; for x in s.sides().iter() { if *x > m { m = *x; } } return m; }
fn main() { println!("{}", longest(&Sq { s: 4 })); }
