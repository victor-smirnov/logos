package m29;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.rc;
use logos.lang.cell;
use logos.mem.boxed;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.ops;
fn main() {
    let k = 4i64;
    let f: Box<dyn Fn(i64) -> i64> = Box::new(move |x| x + k);
    let o: Option<Box<dyn Fn(i64) -> i64>> = Some(Box::new(move |x| x * k));
    println!("{}", f(1));
    if let Some(g) = &o { println!("{}", g(2)); }
}
