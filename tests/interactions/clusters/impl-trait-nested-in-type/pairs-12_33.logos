package m07d;
use logos.std.compiler.metaprog;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.std.fmt;
use logos.std.io;
use logos.lang.cmp;
use logos.lang.rc;
use logos.lang.iter;
use logos.mem.boxed;
use logos.lang.ops;
use logos.lang.mem;
use logos.lang.hash;
use logos.lang.cell;
use logos.lang.ptr;
trait Counter { fn val(&self) -> i64; }
struct C { n: i64 }
impl Counter for C { fn val(&self) -> i64 { return self.n; } }
fn read_boxed(c: Box<impl Counter>) -> i64 { return c.val() + 1; }
fn main() {
    let b = Box::new(C { n: 6 });
    let x = read_boxed(b);
    let y = read_boxed(Box::new(C { n: 5 }));
    println!("{} {}", x, y);
}
