package opteq;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.rc;
use logos.lang.cell;
use logos.mem.boxed;
use logos.lang.iter;
use logos.lang.cmp;
use logos.lang.ops;
#[derive_partial_eq]
#[derive_clone]
#[derive_copy]
enum Sh { A(i32), B { x: i32 } }
fn main() {
    let o: Option<Sh> = Some(Sh::B { x: 2 });
    println!("{}", o == Some(Sh::B { x: 2 }));
    println!("{}", o == Some(Sh::A(2)));
    println!("{}", o != None);
}
