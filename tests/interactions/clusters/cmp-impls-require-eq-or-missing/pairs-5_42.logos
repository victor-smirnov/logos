package f44_vec_partialeq;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.std.compiler.metaprog;
use logos.lang.ptr;
#[derive_partial_eq]
struct Rec { tags: Vec<i64>, n: i64 }
fn main() {
    let a: Vec<i64> = vec![1, 2];
    let b: Vec<i64> = vec![1, 2];
    println!("{}", a == b);
    println!("{}", Rec { tags: a.clone(), n: 1 } == Rec { tags: b.clone(), n: 1 });
}
