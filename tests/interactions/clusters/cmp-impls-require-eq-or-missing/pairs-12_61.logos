package m04j;
use logos.std.compiler.metaprog;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.std.fmt;
use logos.std.io;
use logos.lang.cmp;
use logos.lang.rc;
use logos.lang.iter;
use logos.mem.boxed;
use logos.lang.ops;
use logos.lang.mem;
use logos.lang.hash;
use logos.lang.cell;
use logos.lang.ptr;
struct N { s: String }
enum E { A(String), B }
#[derive_partial_eq]
struct F { x: f64 }
fn main() {
    let v = vec![String::from("a"), String::from("b")];
    let w = vec![N { s: String::from("x") }];
    let u = vec![E::A(String::from("q")), E::B];
    let f = vec![F { x: 1.5 }];
    println!("{} {} {} {}", v.len(), w.len(), u.len(), f.contains(&F { x: 1.5 }));
}
