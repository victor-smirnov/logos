package f29_at_binding_or_pattern_by_ref;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.std.compiler.metaprog;
use logos.lang.ptr;
enum Tok { Op(char), End }
fn f(t: &Tok) -> i64 {
    return match t { Tok::Op(c @ ('+' | '-')) => { if *c == '+' { 1 } else { 2 } } Tok::Op(_) => 3, Tok::End => 0 };
}
fn main() { println!("{} {} {}", f(&Tok::Op('+')), f(&Tok::Op('-')), f(&Tok::Op('/'))); }
