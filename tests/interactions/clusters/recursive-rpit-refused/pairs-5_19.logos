package f19_recursive_impl_trait_return;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
trait Metric { fn m(&self) -> i64; }
impl Metric for i64 { fn m(&self) -> i64 { return *self; } }
fn f(n: i64) -> impl Metric { if n == 0 { return 5i64; } return f(n - 1); }
fn main() { println!("{}", f(3).m()); }
