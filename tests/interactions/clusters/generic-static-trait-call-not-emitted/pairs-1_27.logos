package s4;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.clone;
use logos.std.fmt;
trait Peano { const N: i64; }
struct Z; struct S<P>(P);
impl Peano for Z { const N: i64 = 0; }
impl<P: Peano> Peano for S<P> { const N: i64 = P::N + 1; }
fn n<T: Peano>() -> i64 { return T::N; }
fn main() { let a = n::<S<S<Z>>>(); println!("{}", a); let _ = S(Z); }
