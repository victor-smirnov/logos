package r2;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.clone;
use logos.std.fmt;
trait Store { type Buf; fn sum(b: &Self::Buf) -> i64; }
struct TupStore;
impl Store for TupStore { type Buf = (i64, i64); fn sum(b: &(i64, i64)) -> i64 { return b.0 * 100 + b.1; } }
fn go<S: Store>(b: &S::Buf) -> i64 { return S::sum(b); }
fn main() { let b: (i64, i64) = (2, 5); println!("{}", go::<TupStore>(&b)); }
