package r1;
use logos.std.fmt; use logos.mem.collections.vec; use logos.lang.iter; use logos.mem.string; use logos.lang.option; use logos.lang.result; use logos.lang.ops; use logos.lang.cmp; use logos.lang.str; use logos.mem.boxed;
trait Container { type Item; fn first(&self) -> Self::Item; }
struct S {}
impl Container for S { type Item = String; fn first(&self) -> String { String::new() } }
fn need<C: Container<Item = i64>>(c: &C) -> i64 { 0 }
fn main() { let s = S {}; println!("{}", need(&s)); }
