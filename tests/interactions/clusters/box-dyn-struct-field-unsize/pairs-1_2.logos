package k3;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.set;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.mem.boxed;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.lang.iter;
use logos.lang.rc;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.clone;
use logos.std.fmt;
trait Buf { fn total(&self) -> i64; }
struct Max { m: i64 }
impl Buf for Max { fn total(&self) -> i64 { self.m } }
struct Wrap { inner: Box<dyn Buf> }
fn main() {
    let w = Wrap { inner: Box::new(Max { m: 7 }) };
    println!("{}", w.inner.total());
}
