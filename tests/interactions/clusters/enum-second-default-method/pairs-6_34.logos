package p03v;
use logos.lang.rc;
use logos.lang.cell;
use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.result;
use logos.mem.boxed;
use logos.lang.cmp;
use logos.lang.ops;
use logos.std.compiler.metaprog;
enum E { A(i32) }
trait Tr { fn get(&self) -> i32; fn one(&self) -> i32 { 1 } fn two(&self) -> i32 { self.get() } }
impl Tr for E { fn get(&self) -> i32 { 5 } }
fn main() { let e = E::A(7); println!("{} {}", e.one(), e.two()); }
