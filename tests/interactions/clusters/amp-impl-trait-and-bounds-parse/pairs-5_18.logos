package f18_ref_impl_trait_param;
use logos.std.fmt;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
use logos.mem.boxed;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.set;
use logos.mem.collections.deque;
trait Visit { fn visit(&mut self, v: i64); }
struct S { t: i64 }
impl Visit for S { fn visit(&mut self, v: i64) { self.t += v; } }
fn go(vis: &mut impl Visit) { vis.visit(3); }
fn show(x: &impl Visit) -> i64 { return 1; }
fn main() { let mut s = S { t: 0 }; go(&mut s); println!("{} {}", s.t, show(&s)); }
