// exhaustiveness oracle battery (ADR 0030 S3): match &Color default binding mode, all arms
package ref_enum_exh;
enum Color { R, G, B }

fn run() -> i32 { let c = Color::G; let r: i32 = match &c { Color::R => 1i32, Color::G => 2i32, Color::B => 3i32 }; return r; }

fn main() -> i32 { return run(); }
