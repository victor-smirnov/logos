// exhaustiveness oracle battery (ADR 0030 S3): Option<Color> {Some(R|G),None} (value=Some(B))
package or_nested_payload_nonexh;
enum Color { R, G, B }

fn run() -> i32 { let o: Option<Color> = Option::Some(Color::B); let r: i32 = match o { Option::Some(Color::R | Color::G) => 1i32, Option::None => 3i32 }; return r; }

fn main() -> i32 { return run(); }
