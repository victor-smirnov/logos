// exhaustiveness oracle battery (ADR 0030 S3): (Color,bool) all cells
package tuple_enum_bool_exh;
enum Color { R, G, B }

fn run() -> i32 { let t = (Color::G, false); let r: i32 = match t { (Color::R, _) => 1i32, (Color::G, true) => 2i32, (Color::G, false) => 3i32, (Color::B, _) => 4i32 }; return r; }

fn main() -> i32 { return run(); }
