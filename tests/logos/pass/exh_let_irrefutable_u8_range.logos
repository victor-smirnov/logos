// ADR 0030 S3 (C-PAT) battery catch: logosc REFUSED this shape (or failed it) and rustc runs it (exit 3).
// exhaustiveness oracle battery (ADR 0030 S3): let 0..=255u8 = x; (full-domain range, irrefutable)
package exh_let_irrefutable_u8_range;
fn run() -> i32 { let x: u8 = 7u8; let 0u8..=255u8 = x; return 3i32; }

fn main() -> i32 { return run(); }
