// A source wider than the type dictionary's old capacity (2026-10-05). The
// dictionary was a fixed 256-binding table; past it a binding was dropped and
// reported (`wql!: type-dictionary capacity (256 bindings) exhausted`), since a
// dropped binding would have been typed with the `i64` baseline. The tables grow
// now. `W` declares 300 columns and the last one is a `str`: the query reads it,
// so it compiles only if `c299` is bound with its own type.
//
// exit 0 = the 300th column reads back.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

