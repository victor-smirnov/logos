// The legal twin of match_ergo_ref_variant_payload_under_ref_fail, ONE TOKEN apart: the
// scrutinee is `o`, not `&o`. A by-value scrutinee leaves the default binding mode `move`,
// which is exactly what a WRITTEN `ref` needs (Rust 2024,
// pat.binding.modifier-requires-move-mode). It RUNS: `v` must name the payload slot and
// `*v` must read 3, so the printed line and the exit code both hold the answer.
package match_ergo_ref_variant_payload_deref_pass;
use logos.std.fmt;
fn main() -> i32 {
    let o: Option<i64> = Option::Some(3i64);
    let mut out: i64 = 0i64;
    match o {
        Option::Some(ref v) => { out = *v + 1i64; }
        Option::None => {}
    }
    println!("out={}", out);
    if out != 4i64 { return 1i32; }
    return 0i32;
}
