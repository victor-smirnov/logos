// The legal twin of match_ergo_mut_array_elem_under_ref_fail, ONE TOKEN apart: the
// scrutinee is `arr`, not `&arr`. Default binding mode `move`, so the written `mut` is
// legal. It RUNS and asserts the sum through the mutated copy.
package match_ergo_mut_array_elem_byvalue_pass;
use logos.std.fmt;
fn main() -> i32 {
    let arr: [i64; 2] = [7i64, 8i64];
    let mut out: i64 = 0i64;
    match arr {
        [mut a, b] => { a = a + 1i64; out = a + b; }
    }
    println!("out={}", out);
    if out != 16i64 { return 1i32; }
    return 0i32;
}
