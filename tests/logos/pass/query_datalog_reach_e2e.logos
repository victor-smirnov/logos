// queue-2 I3 — DYNAMIC Datalog: the canonical TRANSITIVE CLOSURE over a
// CYCLIC edge graph (ADR 0012-queue2 §7 rel/fixpoint). The rel program text
// arrives at RUNTIME; Query::compile condenses the dependency graph (the
// SHARED compute_rel_scc) and `run` executes the SEMI-NAÏVE fixpoint as an
// interpreter loop (total/delta watermarks + delta-variant loop variable —
// no IR rewriting, no codegen). Set semantics terminate the CYCLE; compile-
// once / run-TWICE over DIFFERENT graphs asserts re-entrancy.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Edge : code(0x0B10_0000_0000_0001) {
    src: i64 = 0,
    dst: i64 = 1,
}

resource cat = schema_catalog!{ Edge };

fn mk_edge(d: &Writ, s: i64, t: i64) -> WAny {
    let e: Edge = d.make::<Edge>();
    e.src = s;
    e.dst = t;
    let w: i64 = e.m as i64;
    return WAny::ref_to(w as *const u8);
}

fn main() -> i32 {
    let d: Writ = writ_new(8192i64);
    let c: SchemaCatalog = cat();

    // ── compile ONCE ──────────────────────────────────────────────────────
    let q: Query = match Query::compile(
        "rel path(a: i64, b: i64) { from edges e select (e.src, e.dst); from path p join edges e on p.b == e.src select (p.a, e.dst); } from path p where p.a == start select p.b order by p.b",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e) => { return 1i32; }
    };

    // ── graph 1: a CYCLE 1→2→3→1 + a disconnected 5→6 + a DUPLICATE edge ──
    let arr: &mut WArray<WAny> = d.array(8i64);
    arr.push(mk_edge(&d, 1i64, 2i64));
    arr.push(mk_edge(&d, 2i64, 3i64));
    arr.push(mk_edge(&d, 3i64, 1i64));   // closes the cycle — set semantics terminate
    arr.push(mk_edge(&d, 5i64, 6i64));
    arr.push(mk_edge(&d, 2i64, 3i64));   // duplicate — deduped on insert
    let src1: WAny = WAny::ref_to(arr as *const WArray<WAny> as *const u8);

    let mut env: QEnv = QEnv::new();
    env.bind_source("edges", src1);
    env.bind_i64("start", 1i64);
    let r1: QRows = match q.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e2) => { return 2i32; }
    };
    // reach(1) over the cycle = {1, 2, 3}, ordered.
    if r1.row_count() != 3i64 { return 3i32; }
    if r1.get_i64(0i64, 0i64) != 1i64 { return 4i32; }
    if r1.get_i64(1i64, 0i64) != 2i64 { return 5i32; }
    if r1.get_i64(2i64, 0i64) != 3i64 { return 6i32; }
    if !str_eq(r1.col_ty(0i64), "i64") { return 7i32; }

    // reach(5) = {6}; reach(9) = ∅ — same compiled Query, new params.
    env.bind_i64("start", 5i64);
    let r2: QRows = match q.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e3) => { return 8i32; }
    };
    if r2.row_count() != 1i64 { return 9i32; }
    if r2.get_i64(0i64, 0i64) != 6i64 { return 10i32; }
    env.bind_i64("start", 9i64);
    let r3: QRows = match q.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e4) => { return 11i32; }
    };
    if r3.row_count() != 0i64 { return 12i32; }

    // ── run #2: the SAME Query over a DIFFERENT graph (2-cycle 1⇄2) ───────
    let arr2: &mut WArray<WAny> = d.array(4i64);
    arr2.push(mk_edge(&d, 1i64, 2i64));
    arr2.push(mk_edge(&d, 2i64, 1i64));
    let src2: WAny = WAny::ref_to(arr2 as *const WArray<WAny> as *const u8);
    let mut env2: QEnv = QEnv::new();
    env2.bind_source("edges", src2);
    env2.bind_i64("start", 1i64);
    let r4: QRows = match q.run(&env2) {
        Result::Ok(r) => { r }
        Result::Err(_e5) => { return 13i32; }
    };
    if r4.row_count() != 2i64 { return 14i32; }
    if r4.get_i64(0i64, 0i64) != 1i64 { return 15i32; }
    if r4.get_i64(1i64, 0i64) != 2i64 { return 16i32; }

    return 0i32;
}
