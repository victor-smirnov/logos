// writ2 stringify over every value kind (successor of the Writ1
// StringifyCtx test): scalars, strings with escapes, arrays, maps, nesting,
// boxed wide ints, typed arrays/maps.
package writ_stringify;
use logos.lang.writ.hstatic;
use logos.lang.writ.anyval;
use logos.lang.writ.container;
use logos.lang.writ.allocator;
use logos.mem.writ.stringify;
use logos.lang.rc;
use logos.mem.string;
use logos.lang.str;

unsafe fn root_of(hs: &WritStatic) -> HAny {
    let base: *const u8 = hs.ptr;
    let w: i64 = *(base as *const i64);
    if w == 0i64 { return HAny::Ref(0i64 as *const u8); }
    if (w & 1i64) == 1i64 { return HAny::Pod(w as u64); }
    return HAny::Ref((base as i64 + w) as *const u8);
}

unsafe fn check(hs: &WritStatic, expected: str, err: i32) -> i32 {
    let s: String = stringify(root_of(hs));
    if !s.eq_str(expected) { return err; }
    return 42;
}

unsafe fn main() -> i32 {
    let mut rc: i32 = 0;

    let l1: WritStatic = @null;     rc = check(&l1, "null", 1);  if rc != 0 { return rc; }
    let l2: WritStatic = @true;     rc = check(&l2, "true", 2);  if rc != 0 { return rc; }
    let l3: WritStatic = @0;        rc = check(&l3, "0", 3);     if rc != 0 { return rc; }
    let l4: WritStatic = @-8388608; rc = check(&l4, "-8388608", 4); if rc != 0 { return rc; }
    let l5: WritStatic = @"s";      rc = check(&l5, "\"s\"", 5); if rc != 0 { return rc; }
    let l6: WritStatic = @[];       rc = check(&l6, "[]", 6);    if rc != 0 { return rc; }
    let l7: WritStatic = @{};       rc = check(&l7, "{}", 7);    if rc != 0 { return rc; }
    let l8: WritStatic = @[1, [2, [3]]];
    rc = check(&l8, "[1, [2, [3]]]", 8); if rc != 0 { return rc; }
    let l9: WritStatic = @{"a": {"b": 1}};
    rc = check(&l9, "{\"a\": {\"b\": 1}}", 9); if rc != 0 { return rc; }
    let l10: WritStatic = @<I32>[1, 2];
    rc = check(&l10, "<I32> [1, 2]", 10); if rc != 0 { return rc; }
    let l11: WritStatic = @<I64, AnyVal>{5: 50};
    rc = check(&l11, "<I64, AnyVal> {5: 50}", 11); if rc != 0 { return rc; }

    // Boxed wide int renders by value.
    let c: Rc<Writ> = writ_rc(4096);
    let h: &Writ = c.deref();
    let hp: *mut Writ = h as *const Writ as *mut Writ;
    let big: HAny = box_i64(&mut hp.allocator as *mut Allocator, 9000000000i64);
    let bs: String = stringify(big);
    if !bs.eq_str("9000000000") { return 12; }

    return 42;
}
