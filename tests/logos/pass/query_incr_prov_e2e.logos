// query_incr_prov_e2e — SLICE-9 (R4 provenance, BOUNDED to the linear-recursive
// transitive closure). IncrRec::explain(a,c) reconstructs the WITNESS chain (the
// immediate-derivation tree) for a derived path fact and walks it back to base
// edges. Design A: on-demand BFS reconstruction over the CURRENT edge set — no
// stored witness, so DRed-validity is free. Asserts, over four graph classes:
//   (a) each WitStep is a VALID immediate derivation — its edge(src,dst) is a
//       present edge; a base step starts at `a` with supp_fid == -1; a recursive
//       step has a real supporting fact (a,src) (supp_fid ≥ 0); dst == step.c;
//       and consecutive steps compose (step[i].dst == step[i+1].src).
//   (b) the walk REACHES base edges — step[0].is_base, exactly ONE base step.
//   (c) the reconstructed node path is a REAL path in the graph (every step edge
//       present) with endpoints (a,c).
//   (d) explain stays VALID across a DRed retraction + re-derivation.
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema Edge : code(0x0E07_0000_0000_0009) {
    src: i64 = 0,
    dst: i64 = 1,
}
resource cat = schema_catalog!{ Edge };

fn mk_edge(d: &Writ, s: i64, t: i64) -> WAny {
    let e: Edge = d.make::<Edge>();
    e.src = s; e.dst = t;
    return WAny::ref_to((e.m as i64) as *const u8);
}

fn build_src(d: &Writ, hs: &Vec<WAny>, wts: &Vec<i64>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(64i64);
    let n: i64 = hs.len();
    let mut i: i64 = 0i64;
    while i < n {
        if wts.get(i) > 0i64 { arr.push(hs.get(i)); }
        i = i + 1i64;
    }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

fn src_apply(hs: &Vec<WAny>, wts: &mut Vec<i64>, batch: &mut ZBatch, idx: i64, raw: i64) {
    let old: i64 = wts.get(idx);
    let mut neww: i64 = old + raw;
    if neww < 0i64 { neww = 0i64; }
    let eff: i64 = neww - old;
    wts.set(idx, neww);
    if eff != 0i64 { batch.push(hs.get(idx), eff); }
}

// Ground-truth adjacency: is (s,t) a PRESENT edge (weight > 0) of the graph the
// test built? es/et/wts are parallel to the engine's edge multiset.
fn known_edge(es: &Vec<i64>, et: &Vec<i64>, wts: &Vec<i64>, s: i64, t: i64) -> bool {
    let n: i64 = es.len();
    let mut i: i64 = 0i64;
    while i < n {
        if wts.get(i) > 0i64 && es.get(i) == s && et.get(i) == t { return true; }
        i = i + 1i64;
    }
    return false;
}

// Verify an explain() result is a valid, base-reaching, real derivation chain
// for (a,c). Returns 0 on success or a distinct nonzero code on the first fault.
fn check_chain(ex: &Explain, eng: &IncrRec, a: i64, c: i64,
               es: &Vec<i64>, et: &Vec<i64>, wts: &Vec<i64>) -> i64 {
    if !ex.is_present() { return 1i64; }
    let n: i64 = ex.nsteps();
    if n < 1i64 { return 2i64; }
    let mut base_count: i64 = 0i64;
    let mut prev_dst: i64 = a;    // first step must start at `a`
    let mut i: i64 = 0i64;
    while i < n {
        let st: WitStep = ex.step(i);
        // (a)/(c): the step edge is a real, present edge.
        if !known_edge(es, et, wts, st.src, st.dst) { return 10i64; }
        if st.dst != st.c { return 11i64; }
        if st.a != a { return 12i64; }
        // composition: this step's src == the prior step's dst.
        if st.src != prev_dst { return 13i64; }
        if st.is_base {
            base_count = base_count + 1i64;
            if st.supp_fid != -1i64 { return 14i64; }
            if st.src != a { return 15i64; }
        } else {
            if st.supp_fid < 0i64 { return 16i64; }   // supporting fact (a,src) exists
            // supp_fid must actually INDEX the fact (a, src) — re-resolve it in the
            // rel and confirm both columns. Pins the recursive back-pointer so a
            // corrupted supp_fid (wrong or fabricated row) is caught, not vacuous.
            let sf: FactAB = eng.fact_ab(st.supp_fid);
            if sf.a != a       { return 24i64; }
            if sf.b != st.src  { return 25i64; }
        }
        prev_dst = st.dst;
        i = i + 1i64;
    }
    // (b): exactly one base step, and it is the head.
    if base_count != 1i64 { return 17i64; }
    if !ex.step(0i64).is_base { return 18i64; }
    // (c): endpoints — the walk terminates at c.
    if prev_dst != c { return 19i64; }
    return 0i64;
}

fn mk_engine(q: &Query, doc: &Writ, hs: &Vec<WAny>, wts: &Vec<i64>) -> Result<IncrRec, QError> {
    let mut env: QEnv = QEnv::new();
    env.bind_source("edges", build_src(doc, hs, wts));
    return q.incremental_rec(&env);
}

fn main() -> i32 {
    let doc: Writ = writ_new(65536i64);
    let c: SchemaCatalog = cat();
    let q: Query = match Query::compile(
        r#"rel path(a: i64, b: i64) {
             from edges e select (e.src, e.dst);
             from path p join edges e on p.b == e.src select (p.a, e.dst);
           }
           from path p select (p.a, p.b)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };

    // ── T1: chain 0→1→2→3. explain(0,3) ⇒ 0→1→2→3, 3 steps. ──
    let mut hs1: Vec<WAny> = vec_new::<WAny>();
    let mut es1: Vec<i64> = vec_new::<i64>();
    let mut et1: Vec<i64> = vec_new::<i64>();
    let mut w1:  Vec<i64> = vec_new::<i64>();
    hs1.push(mk_edge(&doc, 0i64, 1i64)); es1.push(0i64); et1.push(1i64); w1.push(1i64);
    hs1.push(mk_edge(&doc, 1i64, 2i64)); es1.push(1i64); et1.push(2i64); w1.push(1i64);
    hs1.push(mk_edge(&doc, 2i64, 3i64)); es1.push(2i64); et1.push(3i64); w1.push(1i64);
    let eng1: IncrRec = match mk_engine(&q, &doc, &hs1, &w1) { Result::Ok(e) => { e } Result::Err(_e2) => { return 1i32; } };
    let ex13: Explain = eng1.explain(0i64, 3i64);
    let r13: i64 = check_chain(&ex13, &eng1, 0i64, 3i64, &es1, &et1, &w1);
    if r13 != 0i64 { return (100i64 + r13) as i32; }
    if ex13.nsteps() != 3i64 { return 2i32; }
    // absent fact ⇒ honest present:false.
    let exabs: Explain = eng1.explain(3i64, 0i64);
    if exabs.is_present() { return 3i32; }

    // ── T2: diamond 0→1→3, 0→2→3. explain(0,3) ⇒ ONE canonical 2-step chain. ──
    let mut hs2: Vec<WAny> = vec_new::<WAny>();
    let mut es2: Vec<i64> = vec_new::<i64>();
    let mut et2: Vec<i64> = vec_new::<i64>();
    let mut w2:  Vec<i64> = vec_new::<i64>();
    hs2.push(mk_edge(&doc, 0i64, 1i64)); es2.push(0i64); et2.push(1i64); w2.push(1i64);
    hs2.push(mk_edge(&doc, 1i64, 3i64)); es2.push(1i64); et2.push(3i64); w2.push(1i64);
    hs2.push(mk_edge(&doc, 0i64, 2i64)); es2.push(0i64); et2.push(2i64); w2.push(1i64);
    hs2.push(mk_edge(&doc, 2i64, 3i64)); es2.push(2i64); et2.push(3i64); w2.push(1i64);
    let eng2: IncrRec = match mk_engine(&q, &doc, &hs2, &w2) { Result::Ok(e) => { e } Result::Err(_e3) => { return 4i32; } };
    let ex23: Explain = eng2.explain(0i64, 3i64);
    let r23: i64 = check_chain(&ex23, &eng2, 0i64, 3i64, &es2, &et2, &w2);
    if r23 != 0i64 { return (200i64 + r23) as i32; }
    // single canonical witness — a simple 2-step path, not both branches unrolled.
    if ex23.nsteps() != 2i64 { return 5i32; }

    // ── T3 (d): chain 0→1→2→3; retract edge(1,2); DRed; re-insert. ──
    let mut hs3: Vec<WAny> = vec_new::<WAny>();
    let mut es3: Vec<i64> = vec_new::<i64>();
    let mut et3: Vec<i64> = vec_new::<i64>();
    let mut w3:  Vec<i64> = vec_new::<i64>();
    hs3.push(mk_edge(&doc, 0i64, 1i64)); es3.push(0i64); et3.push(1i64); w3.push(1i64);
    hs3.push(mk_edge(&doc, 1i64, 2i64)); es3.push(1i64); et3.push(2i64); w3.push(1i64);
    hs3.push(mk_edge(&doc, 2i64, 3i64)); es3.push(2i64); et3.push(3i64); w3.push(1i64);
    let mut env3: QEnv = QEnv::new();
    env3.bind_source("edges", build_src(&doc, &hs3, &w3));
    let mut eng3: IncrRec = match q.incremental_rec(&env3) { Result::Ok(e) => { e } Result::Err(_e4) => { return 6i32; } };
    // baseline: (0,3) derivable.
    let pre: Explain = eng3.explain(0i64, 3i64);
    if check_chain(&pre, &eng3, 0i64, 3i64, &es3, &et3, &w3) != 0i64 { return 7i32; }

    // retract edge(1,2) (idx 1) → DRed.
    let mut d1: ZBatch = ZBatch::new();
    src_apply(&hs3, &mut w3, &mut d1, 1i64, -1i64);
    eng3.epoch(&d1);
    // (0,3) no longer derivable ⇒ honest present:false; no dangling witness.
    let gone: Explain = eng3.explain(0i64, 3i64);
    if gone.is_present() { return 8i32; }
    // (0,1) survives via the intact base edge 0→1.
    let e01: Explain = eng3.explain(0i64, 1i64);
    if check_chain(&e01, &eng3, 0i64, 1i64, &es3, &et3, &w3) != 0i64 { return 9i32; }
    if e01.nsteps() != 1i64 { return 20i32; }

    // re-insert edge(1,2) → (0,3) re-derived ⇒ FRESH valid chain.
    let mut d2: ZBatch = ZBatch::new();
    src_apply(&hs3, &mut w3, &mut d2, 1i64, 1i64);
    eng3.epoch(&d2);
    let redo: Explain = eng3.explain(0i64, 3i64);
    let rredo: i64 = check_chain(&redo, &eng3, 0i64, 3i64, &es3, &et3, &w3);
    if rredo != 0i64 { return (300i64 + rredo) as i32; }
    if redo.nsteps() != 3i64 { return 21i32; }

    // ── T4: cycle 0→1→2→0 (termination guard). explain(0,2) ⇒ simple [0,1,2]. ──
    let mut hs4: Vec<WAny> = vec_new::<WAny>();
    let mut es4: Vec<i64> = vec_new::<i64>();
    let mut et4: Vec<i64> = vec_new::<i64>();
    let mut w4:  Vec<i64> = vec_new::<i64>();
    hs4.push(mk_edge(&doc, 0i64, 1i64)); es4.push(0i64); et4.push(1i64); w4.push(1i64);
    hs4.push(mk_edge(&doc, 1i64, 2i64)); es4.push(1i64); et4.push(2i64); w4.push(1i64);
    hs4.push(mk_edge(&doc, 2i64, 0i64)); es4.push(2i64); et4.push(0i64); w4.push(1i64);
    let eng4: IncrRec = match mk_engine(&q, &doc, &hs4, &w4) { Result::Ok(e) => { e } Result::Err(_e5) => { return 22i32; } };
    let ex42: Explain = eng4.explain(0i64, 2i64);
    let r42: i64 = check_chain(&ex42, &eng4, 0i64, 2i64, &es4, &et4, &w4);
    if r42 != 0i64 { return (400i64 + r42) as i32; }
    // simple path 0→1→2 — no revisit despite the cycle back to 0.
    if ex42.nsteps() != 2i64 { return 23i32; }

    return 0i32;
}
