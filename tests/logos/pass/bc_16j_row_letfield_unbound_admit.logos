// hand battery: round 2026-09-16j-arrpath2, program bc_16j_row_letfield_unbound_admit — caught: a `let` array pattern over an array-typed FIELD marked the whole field moved, so every element the pattern did not bind was never destroyed (n=2, rustc 21)
// Was soundness_queue row `let_array_pattern_field_base_unbound_elem_leak`, CLOSED by this round. The row leaving IS the record of the fix: the
// queue gate went RED on this program ("NO LONGER REPRODUCES — want run=1, read run=0"), the row was
// deleted, `# TOTAL` re-derived by direct listing, and the program landed here in the same commit.
// Expected exit and destructor trace MEASURED against a rustc 1.98.1 twin. The COUNT is the oracle:
// n = n*10 + v per D::drop, so a leak reads SHORT and a double destructor reads LONG; rc alone cannot
// tell those apart, and valgrind is blind to both over an i64 counter.
package bc_16j_row_letfield_unbound_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct S { arr: [D; 2], tag: i64 }
fn g(p: *mut i64) -> i64 {
    let s: S = S { arr: [D { v: 1i64, c: p }, D { v: 2i64, c: p }], tag: 7i64 };
    let [_, y] = s.arr;
    return y.v;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    let got: i64 = unsafe { n };
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 2i64 { return 2i32; }
    if got != 21i64 { return 1i32; }
    return 0i32;
}
