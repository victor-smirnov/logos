// SL-sl-08: `impl Trait for (A, B, …)` end-to-end. Generic-blanket form
// keyed by arity (`$tuple$N`); positional substitution at dispatch maps
// type-params to tuple element types.

package impl_for_tuple;

use std.fmt;
use std.lang.text;

impl<A: Debug, B: Debug> Debug for (A, B) {
    fn dbg(self: (A, B), buf: &mut String) {
        buf.push_str("(");
        self.0.dbg(buf);
        buf.push_str(", ");
        self.1.dbg(buf);
        buf.push_str(")");
    }
}

impl<A: Debug, B: Debug, C: Debug> Debug for (A, B, C) {
    fn dbg(self: (A, B, C), buf: &mut String) {
        buf.push_str("(");
        self.0.dbg(buf);
        buf.push_str(", ");
        self.1.dbg(buf);
        buf.push_str(", ");
        self.2.dbg(buf);
        buf.push_str(")");
    }
}

fn main() -> i32 {
    // 2-tuple.
    let t2: (i32, bool) = (1i32, true);
    let mut s2: String = String::new();
    t2.dbg(&mut s2);
    if s2.as_str() != "(1, true)" { return 1i32; }

    // 3-tuple, mixed types.
    let t3: (i32, bool, i64) = (42i32, false, 7i64);
    let mut s3: String = String::new();
    t3.dbg(&mut s3);
    if s3.as_str() != "(42, false, 7)" { return 2i32; }

    return 0i32;
}
