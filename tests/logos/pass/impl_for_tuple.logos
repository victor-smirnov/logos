// SL-sl-08: `impl Trait for (A, B, …)` end-to-end. Generic-blanket form
// keyed by arity (`$tuple$N`); positional substitution at dispatch maps
// type-params to tuple element types.
//
// Post-Session-4: the stdlib `impl<A,B: Debug> Debug for (A,B)`
// in mem.fmt is what this test exercises. Earlier this file declared
// its own per-arity tuple Debug impls — those moved to stdlib in
// Session 2 and the test now just verifies the dispatch path.

package impl_for_tuple;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    // 2-tuple.
    let t2: (i32, bool) = (1i32, true);
    let s2: String = fmt_debug_to_string::<(i32, bool)>(&t2);
    if s2.as_str() != "(1, true)" { return 1i32; }

    // 3-tuple, mixed types.
    let t3: (i32, bool, i64) = (42i32, false, 7i64);
    let s3: String = fmt_debug_to_string::<(i32, bool, i64)>(&t3);
    if s3.as_str() != "(42, false, 7)" { return 2i32; }

    return 0i32;
}
