// RefCell<T> — runtime-checked borrow with Ref/RefMut guards.
package refcell_basic_test;

use logos.lang.cell;
use logos.lang.result;

unsafe fn main() -> i32 {
    let c = RefCell::new(10i32);

    // try_borrow succeeds when unborrowed; guard Drop fires at arm end.
    {
        match c.try_borrow() {
            Result::Ok(g)  => { if *g.get() != 10 { return 1; } }
            Result::Err(_) => { return 2; }
        }
    }

    // borrow_mut → write → drop
    {
        let mut g = c.borrow_mut();
        *g.get_mut() = 42;
    }

    // verify mutation
    {
        let g = c.borrow();
        if *g.get() != 42 { return 3; }
    }

    // replace returns old
    let old = c.replace(99);
    if old != 42 { return 4; }

    // multiple simultaneous shared borrows
    {
        let g1 = c.borrow();
        let g2 = c.borrow();
        if *g1.get() != 99 { return 5; }
        if *g2.get() != 99 { return 6; }
    }

    // borrow_mut blocks while a shared borrow is held.
    {
        let _g = c.borrow();
        match c.try_borrow_mut() {
            Result::Ok(_)  => { return 7; }
            Result::Err(_) => {}
        }
    }

    // swap
    let d = RefCell::new(123);
    c.swap(&d);
    {
        let gc = c.borrow();
        let gd = d.borrow();
        if *gc.get() != 123 { return 8; }
        if *gd.get() != 99 { return 9; }
    }

    let inner = c.into_inner();
    if inner != 123 { return 10; }

    return 42;
}
