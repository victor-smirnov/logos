// S4 conformance: runtime-typed VALUES (key u64, value i64) + snapshot.
// Snapshot must be independent: mutating the original after a snapshot leaves
// the snapshot unchanged.
package memoria_snapshot;
use logos.std.data.memoria.tree;
use logos.std.data.memoria.ordval;
use logos.lang.hermes.anyval;   // H2_U64 / H2_I64
use logos.lang.mem;

fn main() -> i32 {
    unsafe {
        let mut m: OrdMap = ordmap_new(H2_U64, H2_I64);   // u64 keys, i64 values
        let mp: *mut OrdMap = &mut m as *mut OrdMap;
        // insert 0..50 -> value = -(key as i64)
        let mut i: u64 = 0u64;
        while i < 50u64 {
            let k: u64 = i;
            let v: i64 = 0i64 - (i as i64);
            ordmap_insert(mp, &k as *const u64 as *const u8, &v as *const i64 as *const u8);
            i = i + 1u64;
        }
        // value view through vdesc: key 10 -> -10
        let k10: u64 = 10u64;
        let vp: *const u8 = ordmap_get(mp, &k10 as *const u64 as *const u8);
        if *(vp as *const i64) != (0i64 - 10i64) { return 1; }

        // snapshot, then mutate original (overwrite key 10, add key 999)
        let mut snap: OrdMap = ordmap_snapshot(mp as *const OrdMap);
        let sp: *mut OrdMap = &mut snap as *mut OrdMap;
        let nv: i64 = 7777i64;
        ordmap_insert(mp, &k10 as *const u64 as *const u8, &nv as *const i64 as *const u8);
        let k999: u64 = 999u64; let v999: i64 = 1i64;
        ordmap_insert(mp, &k999 as *const u64 as *const u8, &v999 as *const i64 as *const u8);

        // original sees the changes
        if *(ordmap_get(mp, &k10 as *const u64 as *const u8) as *const i64) != 7777i64 { return 2; }
        if ordmap_len(mp as *const OrdMap) != 51u64 { return 3; }
        // snapshot is UNCHANGED
        if *(ordmap_get(sp, &k10 as *const u64 as *const u8) as *const i64) != (0i64 - 10i64) { return 4; }
        if ordmap_len(sp as *const OrdMap) != 50u64 { return 5; }
        if (ordmap_get(sp, &k999 as *const u64 as *const u8) as i64) != 0i64 { return 6; }  // absent in snap

        ordmap_free(sp);
        ordmap_free(mp);
    }
    return 0;
}
