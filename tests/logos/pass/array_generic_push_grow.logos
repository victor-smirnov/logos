// Typed-array growth past capacity (successor of the Writ1 push_grow test):
// the writ2 WArray<T> grows its element buffer in the never-move arena;
// old elements survive the re-buffer (copy, not move).
package array_generic_push_grow;
use logos.lang.writ.container;
use logos.lang.writ.array;
use logos.lang.rc;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(16384);
    let h: &Writ = rc.deref();
    let arr: &mut WArray<i64> = h.tarray::<i64>(2);   // tiny cap: forces grows
    let mut i: i64 = 0;
    while i < 30 {
        arr.push(i);
        i = i + 1;
    }
    if arr.len() != 30i64 { return 1; }
    // Spot-check across the growth boundaries (2 -> 4 -> 8 -> 16 -> 32).
    if arr.get(0) != 0i64 { return 2; }
    if arr.get(1) != 1i64 { return 3; }
    if arr.get(15) != 15i64 { return 4; }
    if arr.get(29) != 29i64 { return 5; }
    return (arr.get(10) + arr.get(20) + arr.get(29) + 1i64) as i32;   // 10+20+29+1 = 60
}
