// queue-2 I2 — Query::compile/run end to end (ADR 0012-queue2 §§3,7): query
// TEXT compiled AT RUNTIME (the reused generated surface parser + the reused
// lower_rquery_to_rexpr / simplify_rexpr_ref queue-1 passes) and executed over
// schema'd Writ sources: scan → filter → project, scalar params, tuple
// projection, and compile-once/run-TWICE re-entrancy over different envs
// (different param value AND a different source array). Distinct exit codes.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;              // WRef<S>
use logos.std.wql.catalog_macro;   // schema_catalog!
use logos.std.query;               // SchemaCatalog / QEnv / Query / QRows
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Emp : code(0x0B01_0000_0000_0001) {
    name: str = 0,
    age:  i64 = 1,
}

impl Emp { pub fn as_any(self: &Emp) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }

resource cat = schema_catalog!{ Emp };

fn mk_emp(d: &Writ, name: str, age: i64) -> WAny {
    let e: Emp = d.make::<Emp>();
    e.name = name;
    e.age = age;
    // launder locally: the WAny targets the TOM in `d`'s arena (as_ref idiom)
    let w: i64 = e.m as i64;
    return WAny::ref_to(w as *const u8);
}

fn main() -> i32 {
    let d: Writ = writ_new(4096i64);
    let arr: &mut WArray<WAny> = d.array(8i64);
    arr.push(mk_emp(&d, "Ann", 45i64));
    arr.push(mk_emp(&d, "Bob", 31i64));
    arr.push(mk_emp(&d, "Cid", 52i64));
    let src: WAny = WAny::ref_to(arr as *const WArray<WAny> as *const u8);

    let c: SchemaCatalog = cat();

    // ── compile once ──────────────────────────────────────────────────────
    let q: Query = match Query::compile("from emps e where e.age >= n select e.name", &c) {
        Result::Ok(v) => { v }
        Result::Err(_e) => { return 1i32; }
    };

    // ── run #1 ────────────────────────────────────────────────────────────
    let mut env: QEnv = QEnv::new();
    env.bind_source("emps", src);
    env.bind_i64("n", 40i64);
    let rows: QRows = match q.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e2) => { return 2i32; }
    };
    if rows.row_count() != 2i64 { return 3i32; }
    if rows.col_count() != 1i64 { return 4i32; }
    if !str_eq(rows.get_str(0i64, 0i64), "Ann") { return 5i32; }
    if !str_eq(rows.get_str(1i64, 0i64), "Cid") { return 6i32; }
    if !str_eq(rows.col_ty(0i64), "str") { return 7i32; }

    // ── run #2: SAME Query, different env (new param + NEW source array) ──
    let arr2: &mut WArray<WAny> = d.array(4i64);
    arr2.push(mk_emp(&d, "Dee", 28i64));
    arr2.push(mk_emp(&d, "Eve", 61i64));
    let src2: WAny = WAny::ref_to(arr2 as *const WArray<WAny> as *const u8);
    let mut env2: QEnv = QEnv::new();
    env2.bind_source("emps", src2);
    env2.bind_i64("n", 25i64);
    let rows2: QRows = match q.run(&env2) {
        Result::Ok(r) => { r }
        Result::Err(_e3) => { return 8i32; }
    };
    if rows2.row_count() != 2i64 { return 9i32; }
    if !str_eq(rows2.get_str(0i64, 0i64), "Dee") { return 10i32; }
    if !str_eq(rows2.get_str(1i64, 0i64), "Eve") { return 11i32; }

    // ── tuple projection + param arithmetic ───────────────────────────────
    let q2: Query = match Query::compile(
        "from emps e where e.age >= n select (e.name, e.age * 2 + n)", &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e4) => { return 12i32; }
    };
    let rows3: QRows = match q2.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e5) => { return 13i32; }
    };
    if rows3.row_count() != 2i64 { return 14i32; }
    if rows3.col_count() != 2i64 { return 15i32; }
    if !str_eq(rows3.get_str(0i64, 0i64), "Ann") { return 16i32; }
    if rows3.get_i64(0i64, 1i64) != 130i64 { return 17i32; }   // 45*2 + 40
    if !str_eq(rows3.get_str(1i64, 0i64), "Cid") { return 18i32; }
    if rows3.get_i64(1i64, 1i64) != 144i64 { return 19i32; }   // 52*2 + 40
    if !str_eq(rows3.col_ty(1i64), "i64") { return 20i32; }

    // ── an EMPTY source runs clean (zero rows, strict check defers) ───────
    let arr3: &mut WArray<WAny> = d.array(2i64);
    let src3: WAny = WAny::ref_to(arr3 as *const WArray<WAny> as *const u8);
    let mut env3: QEnv = QEnv::new();
    env3.bind_source("emps", src3);
    env3.bind_i64("n", 0i64);
    let rows4: QRows = match q.run(&env3) {
        Result::Ok(r) => { r }
        Result::Err(_e6) => { return 21i32; }
    };
    if rows4.row_count() != 0i64 { return 22i32; }

    return 0i32;
}
