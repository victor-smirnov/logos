package pat_range;

fn classify(x: i32) -> i32 {
    match x {
        0..=9   => { return 1; }
        10..=99 => { return 2; }
        _       => { return 3; }
    }
}

fn main() -> i32 {
    let a = classify(5);
    let b = classify(50);
    let c = classify(100);
    // a=1 b=2 c=3 → 1 + 2 + 3 * 13 = 3 + 39 = 42? No.
    // 1 + 2*10 + 3 = 24. Need 42.
    // Let's just return classify(5) + classify(50) + classify(100) + 36 = 42
    return a + b + c + 36;
}
