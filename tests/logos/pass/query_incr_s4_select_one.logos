// query_incr_s4_select_one — S4 v0 fork/merge over a LIVE engine (ADR 0015 §5
// select_one; ADR 0017 P2): assumption-ΔEDB branches on a FactStore feeding a
// standing transitive-closure IncrRec. Law I4 throughout: fork/merge touches
// ONLY the EDB; the IDB re-derives incrementally from ordinary epochs (branch
// apply → rollback → winner re-apply are all just deltas to the engine).
// Asserts:
//   (a) branch "a": assumption edge extends the closure; engine sees it;
//   (b) branch_end rolls the EDB back with inverse ops; engine returns to the
//       trunk closure exactly (±-correct retraction);
//   (c) branch "b": a different assumption; ends; trunk state again;
//   (d) select_one("a"): winner re-applied — engine state ≡ branch-a state;
//   (e) the merge is queryable: winner/losers/commit; the merge commit's
//       parents in the history DAG = [head_a, head_b]; losers released;
//   (f) trunk epochs from before the fork are still readable (P1 gate holds
//       across S4 traffic).
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.std.deem;              // FactHistory (lcm-tier history decorator)
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema Edge : code(0x0E09_0000_0000_0021) {
    src: i64 = 0,
    dst: i64 = 1,
}
resource cat = schema_catalog!{ Edge };

fn mk_edge(dp: *const Writ, s: i64, t: i64) -> WAny {
    let d: &Writ = unsafe { &*dp };
    let e: Edge = d.make::<Edge>();
    e.src = s; e.dst = t;
    return WAny::ref_to((e.m as i64) as *const u8);
}

fn pump(st: &mut FactHistory, eng: &mut IncrRec) {
    let d: ZBatch = st.take_delta();
    eng.epoch(&d);
}

fn main() -> i32 {
    let c: SchemaCatalog = cat();
    let kf: [str; 2] = ["src", "dst"];
    let q: Query = match Query::compile(
        r#"rel path(a: i64, b: i64) {
             from edges e select (e.src, e.dst);
             from path p join edges e on p.b == e.src select (p.a, e.dst);
           }
           from path p select (p.a, p.b)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };

    let mut st: FactHistory = match FactHistory::new(&c, "Edge", &kf[..], 1048576i64) {
        Result::Ok(s)   => { s }
        Result::Err(_e) => { return 91i32; }
    };
    let ap: *const Writ = st.arena_ptr();

    // Trunk: 0→1→2 (closure = 01 02 12 → 3 rows).
    st.insert(mk_edge(ap, 0i64, 1i64));
    st.insert(mk_edge(ap, 1i64, 2i64));

    let mut env: QEnv = QEnv::new();
    env.bind_source("edges", st.build_present());
    let mut eng: IncrRec = match q.incremental_rec(&env)
    { Result::Ok(e) => { e } Result::Err(_e2) => { return 92i32; } };
    let _base: ZBatch = st.take_delta();          // trunk epoch 0
    let trunk_rows: i64 = eng.snapshot().row_count();
    if trunk_rows != 3i64 { return 1i32; }
    let e_trunk: i64 = st.epoch_count() - 1i64;   // remember for (f)

    // (a) branch "a": assume 2→3 (closure gains 23 03 13 → 6 rows).
    st.branch_begin("a");
    st.insert(mk_edge(ap, 2i64, 3i64));
    pump(&mut st, &mut eng);
    let a_rows: i64 = eng.snapshot().row_count();
    if a_rows != 6i64 { return 2i32; }

    // (b) end "a": rollback delta returns the engine to the trunk closure.
    st.branch_end();
    pump(&mut st, &mut eng);
    if eng.snapshot().row_count() != trunk_rows { return 3i32; }
    if st.count() != 2i64 { return 4i32; }

    // (c) branch "b": assume 9→0 (closure gains 90 91 92 → 6 rows), end it.
    st.branch_begin("b");
    st.insert(mk_edge(ap, 9i64, 0i64));
    pump(&mut st, &mut eng);
    if eng.snapshot().row_count() != 6i64 { return 5i32; }
    st.branch_end();
    pump(&mut st, &mut eng);
    if eng.snapshot().row_count() != trunk_rows { return 6i32; }
    if st.branch_count() != 2i64 { return 7i32; }
    let head_a: u64 = st.branch_head(0i64);
    let head_b: u64 = st.branch_head(1i64);

    // (d) select_one("a"): winner re-applied; engine ≡ branch-a state.
    let mc: u64 = st.select_one("a");
    pump(&mut st, &mut eng);
    if eng.snapshot().row_count() != a_rows { return 8i32; }
    if st.count() != 3i64 { return 9i32; }

    // (e) merge queryable + DAG shape + losers released.
    if st.merge_count() != 1i64 { return 20i32; }
    if !str_eq(st.merge_winner(0i64).as_str(), "a") { return 21i32; }
    if st.merge_commit(0i64) != mc { return 22i32; }
    if st.merge_loser_count(0i64) != 1i64 { return 23i32; }
    if !str_eq(st.merge_loser(0i64, 0i64).as_str(), "b") { return 24i32; }
    if st.branch_count() != 0i64 { return 25i32; }
    let ps: Vec<u64> = st.hist_parents_of(mc);
    if ps.len() != 2i64 { return 26i32; }
    if ps.get(0i64) != head_a { return 27i32; }
    if ps.get(1i64) != head_b { return 28i32; }
    if !st.hist_is_released(head_b) { return 29i32; }
    if st.hist_is_released(head_a) { return 30i32; }

    // (f) P1 across S4: the pre-fork trunk epoch is still readable.
    if st.count_at(e_trunk) != 2i64 { return 40i32; }
    // and the post-merge epoch reflects the winner's set.
    if st.count_at(st.epoch_count() - 1i64) != 3i64 { return 41i32; }

    return 0i32;
}
