//
// Module-level const definitions used in expressions.
// EXIT_CODE = 6 * 7 = 42  →  exit code 42.

package const_def;

let FACTOR_A: i32 = 6;
let FACTOR_B: i32 = 7;
let ANSWER: i32 = 42;

fn mul_consts() -> i32 {
    return FACTOR_A * FACTOR_B;
}

unsafe fn main() -> i32 {
    let result: i32 = mul_consts();
    if result == ANSWER {
        return result;
    }
    return 0;
}
