// pmap_store_basic.logos — end-to-end Store + Snapshot flow on
// the CFG-parameterised pmap.
//
// Cycle exercised:
//   1. Open LockingStore (DAG owner, type-erased).
//   2. begin/commit a fresh snapshot with three entries → c0.
//   3. begin from c0, mutate (insert + overwrite) → commit → c1.
//   4. checkout c0 — must still see the original three entries with
//      the original value (c1's mutation is path-copied; c0 unchanged).
//   5. checkout c1 — must see the post-mutation values.
//   6. Begin from c1, remove a key, rollback (no commit). DAG state
//      unchanged; c1's checkout still has the removed key.
//
// CFG threads through every type and free fn — `MyCfg` literal lives
// in the `Snapshot<K,V,CFG>` and `MutSnapshot<K,V,CFG>` type names.

package std_data_persistent_pmap_store_basic;

use std.data.persistent.btree;
use std.data.persistent.view;
use std.data.persistent.mutv;
use std.data.persistent.store;
use std.data.persistent.store;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;

pub struct U64Key { pub x: u64, }
impl Primitive for U64Key { type Prim = u64; }
impl Ord for U64Key {
    fn cmp(&self, other: &Self) -> Ordering {
        if self.x < other.x { return Ordering::Less; }
        if self.x > other.x { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
pub struct U64Val { pub x: u64, }
impl Primitive for U64Val { type Prim = u64; }

pub const MyCfg: HermesStatic = @{ "key": <type:U64Key>, "value": <type:U64Val>, "fanout": 16 };

unsafe fn main() -> i32 {
    let mut st: LockingStore = locking_store_new();
    let stp: *mut LockingStore = &mut st as *mut LockingStore;

    // ── Commit c0: empty → three entries ────────────────────────────
    let mut snap0: MutSnapshot<MyCfg> =
        store_begin::<MyCfg, LockingStore>(stp, NO_COMMIT, locking_store_alloc_snapshot_id(&mut st), &mut st.next_block_id as *mut u64, locking_store_alloc_block_id(&mut st));
    let snap0p: *mut MutSnapshot<MyCfg> =
        &mut snap0 as *mut MutSnapshot<MyCfg>;
    let k1: U64Key = U64Key { x: 10u64 };
    let k2: U64Key = U64Key { x: 20u64 };
    let k3: U64Key = U64Key { x: 30u64 };
    let _ = mut_snapshot_insert::<MyCfg>(snap0p, 10u64, 100u64, &k1 as *const U64Key);
    let _ = mut_snapshot_insert::<MyCfg>(snap0p, 20u64, 200u64, &k2 as *const U64Key);
    let _ = mut_snapshot_insert::<MyCfg>(snap0p, 30u64, 300u64, &k3 as *const U64Key);
    if mut_snapshot_len::<MyCfg>(snap0p as *const MutSnapshot<MyCfg>) != 3u64 { return 1; }
    let c0: i64 = store_commit::<MyCfg, LockingStore>(stp, snap0);

    // ── Commit c1: fork from c0, overwrite k2 with new value ────────
    let mut snap1: MutSnapshot<MyCfg> =
        store_begin::<MyCfg, LockingStore>(stp, c0, locking_store_alloc_snapshot_id(&mut st), &mut st.next_block_id as *mut u64, 0u64);
    let snap1p: *mut MutSnapshot<MyCfg> =
        &mut snap1 as *mut MutSnapshot<MyCfg>;
    let _ = mut_snapshot_insert::<MyCfg>(snap1p, 20u64, 9999u64, &k2 as *const U64Key);
    let c1: i64 = store_commit::<MyCfg, LockingStore>(stp, snap1);

    // ── Checkout c0: must show original values ──────────────────────
    let snap0_ro: Snapshot<MyCfg> =
        store_checkout::<MyCfg, LockingStore>(stp, c0);
    let snap0_rop: *const Snapshot<MyCfg> =
        &snap0_ro as *const Snapshot<MyCfg>;
    if snapshot_len::<MyCfg>(snap0_rop) != 3u64 { return 2; }
    let mut out: u64 = 0u64;
    if !snapshot_get::<MyCfg>(snap0_rop, &k2 as *const U64Key, &mut out as *mut u64) { return 3; }
    if out != 200u64 { return 4; }

    // ── Checkout c1: must show post-mutation value ──────────────────
    let snap1_ro: Snapshot<MyCfg> =
        store_checkout::<MyCfg, LockingStore>(stp, c1);
    let snap1_rop: *const Snapshot<MyCfg> =
        &snap1_ro as *const Snapshot<MyCfg>;
    if snapshot_len::<MyCfg>(snap1_rop) != 3u64 { return 5; }
    if !snapshot_get::<MyCfg>(snap1_rop, &k2 as *const U64Key, &mut out as *mut u64) { return 6; }
    if out != 9999u64 { return 7; }

    // ── Begin → remove → rollback. DAG unchanged; c1 still has k2 ──
    let mut snap2: MutSnapshot<MyCfg> =
        store_begin::<MyCfg, LockingStore>(stp, c1, locking_store_alloc_snapshot_id(&mut st), &mut st.next_block_id as *mut u64, 0u64);
    let snap2p: *mut MutSnapshot<MyCfg> =
        &mut snap2 as *mut MutSnapshot<MyCfg>;
    if !mut_snapshot_remove::<MyCfg>(snap2p, &k2 as *const U64Key) { return 8; }
    if mut_snapshot_len::<MyCfg>(snap2p as *const MutSnapshot<MyCfg>) != 2u64 { return 9; }
    store_rollback::<MyCfg>(snap2);

    // c1 still intact after rollback.
    let snap1b: Snapshot<MyCfg> =
        store_checkout::<MyCfg, LockingStore>(stp, c1);
    let snap1bp: *const Snapshot<MyCfg> =
        &snap1b as *const Snapshot<MyCfg>;
    if snapshot_len::<MyCfg>(snap1bp) != 3u64 { return 10; }
    if !snapshot_contains::<MyCfg>(snap1bp, &k2 as *const U64Key) { return 11; }

    store_close::<MyCfg>(snap0_ro);
    store_close::<MyCfg>(snap1_ro);
    store_close::<MyCfg>(snap1b);
    return 0;
}
