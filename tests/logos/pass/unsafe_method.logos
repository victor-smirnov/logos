package unsafe_method;
// unsafe fn as struct method — must be called from unsafe context
struct Buf { ptr: *mut i32; }

impl Buf {
    unsafe fn read(self: Buf) -> i32 {
        return *self.ptr;
    }
}

extern fn malloc(n: i64) -> *mut u8;
extern fn free(p: *mut u8);
fn alloc(size: i64) -> *mut u8 { unsafe { return malloc(size); } }
fn dealloc(ptr: *mut u8) { unsafe { free(ptr); } }

unsafe fn main() -> i32 {
    let raw: *mut u8 = alloc(4);
    let p: *mut i32 = raw as *mut i32;
    unsafe { *p = 55; }
    let b = Buf { ptr: p };
    let v: i32 = unsafe { b.read(); };
    dealloc(raw);
    return v;
}
