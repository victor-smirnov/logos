// Reverse iteration: iter_rev() positions at the largest key; step_back()
// walks descending. Verifies full reverse order over a multi-level tree
// (fanout 4) and the empty-tree case.
package persistent_iter_rev;

use logos.lcm.deem.data.handle;
use logos.lcm.deem.data.store;
use logos.lcm.deem.data.bt.node;
use logos.lcm.deem.data.bt.cow;
use logos.lcm.deem.data.bt.descent;
use logos.lcm.deem.data.bt.mutate;
use logos.lcm.deem.data.bt.iter;
use logos.lang.fabric;
use logos.lang.writ.wstatic;

pub const StoreCfg: WritStatic = @{ "name":"rev","ctr_id":<type:u64>,"snp_id":<type:u64>,"block_id":<type:u64>, };
pub const MapCfg: WritStatic = @{ "key":<type:u64>,"value":<type:u64>,"fanout":4 };

fn main() -> i32 {
    let mut store = store_open::<StoreCfg>();
    let mut snap = store.fork(GENESIS);
    let mut cr = create_ctr::<MapCfg>(&mut snap, 1u64);

    // empty: iter_rev invalid
    {
        let it0 = cr.iter_rev();
        if it0.valid() { return 1; }
    }

    let mut i = 0u64;
    while i < 12u64 { cr.insert(i, i * 3u64); i = i + 1u64; }

    // reverse walk: expect keys 11,10,...,0
    {
        let mut it = cr.iter_rev();
        let mut expect = 11u64;
        let mut count = 0u64;
        while it.valid() {
            if it.key() != expect { return 10 + expect as i32; }
            if it.val() != expect * 3u64 { return 50 + expect as i32; }
            count = count + 1u64;
            if expect == 0u64 { it.step_back(); break; }
            expect = expect - 1u64;
            it.step_back();
        }
        if count != 12u64 { return 2; }
        if it.valid() { return 3; }   // exhausted past the front
    }
    return 0;
}
