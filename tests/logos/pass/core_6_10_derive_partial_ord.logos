// logos-core §6.10 sub-deliverable 6/8: derive(PartialOrd).
// Logos's PartialOrd is a marker trait (no methods); handler emits
// `impl PartialOrd for S {}` to satisfy the trait bound. With
// `Ord` also derived, `T: PartialOrd` checks succeed via the
// Ord-implies-PartialOrd bound-check fallback in sema.
package core_6_10_derive_partial_ord;

use logos.std.compiler.metaprog;
use logos.lang.cmp;

#[derive_partial_ord]
#[derive_ord]
struct Pair { a: i32, b: i32 }

fn needs_partial_ord<T: PartialOrd>() -> i32 { return 1; }

fn main() -> i32 {
    // Trait bound check: Pair satisfies PartialOrd via the derive.
    let r: i32 = needs_partial_ord::<Pair>();
    if r != 1 { return 1; }
    return 0;
}
