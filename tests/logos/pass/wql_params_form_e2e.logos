// WQL PARAMETERIZED surface e2e — `deem!(<params>){ <query> }` (the trama!
// model, ADR 0012 §6). The parens carry a REAL Logos parameter list re-emitted
// VERBATIM as the generated fn signature:
//   • TWO slice params (`emps: &[Emp]`, `depts: &[Dept]`) are the query
//     SOURCES — `from emps e join depts d …` binds them by param name; row
//     types come from the slice element types (no inline `:[Ty]`, no `with`);
//   • ONE scalar param (`n: i64`) is referenced BARE in the `where` predicate
//     (`e.salary > n * 10`) AND as the `limit` cap (`limit n`) — the same
//     runtime argument drives both.
//
//   →  pub fn top_paid(emps: &[Emp], depts: &[Dept], n: i64) -> Vec<str>
//
// We call the generated fn with different `n` values and assert the EXACT
// projected rows, proving the parameter list → signature → source binding →
// scalar typing path end to end.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

struct Emp  { pub name: str, pub dept: i64, pub salary: i64 }
struct Dept { pub id: i64,   pub budget: i64 }

resource top_paid = deem!(emps: &[Emp], depts: &[Dept], n: i64) {
    from emps e join depts d on e.dept == d.id
    where e.salary > n * 10
    select e.name limit n : str };

fn main() -> i32 {
    let emps: [Emp; 5] = [
        Emp { name: "Ada",  dept: 1i64, salary: 50i64 },
        Emp { name: "Bob",  dept: 1i64, salary: 20i64 },
        Emp { name: "Cleo", dept: 2i64, salary: 70i64 },
        Emp { name: "Dane", dept: 1i64, salary: 90i64 },
        Emp { name: "Eve",  dept: 3i64, salary: 99i64 },   // dept 3 has no match → excluded by the join
    ];
    let depts: [Dept; 2] = [
        Dept { id: 1i64, budget: 200i64 },
        Dept { id: 2i64, budget: 80i64  },
    ];

    // n = 3: salary > 30 keeps Ada(50), Cleo(70), Dane(90) (Bob 20 filtered,
    // Eve unmatched); limit 3 keeps all three, in scan order.
    let r3: Vec<str> = top_paid(&emps[..], &depts[..], 3i64).unwrap();
    if r3.len() != 3i64 { return 1i32; }
    if !str_eq(r3.get(0i64), "Ada")  { return 2i32; }
    if !str_eq(r3.get(1i64), "Cleo") { return 3i32; }
    if !str_eq(r3.get(2i64), "Dane") { return 4i32; }

    // n = 1: salary > 10 keeps Ada/Bob/Cleo/Dane, but limit 1 caps the output
    // at the FIRST match — proves the SAME runtime arg drives where AND limit.
    let r1: Vec<str> = top_paid(&emps[..], &depts[..], 1i64).unwrap();
    if r1.len() != 1i64 { return 5i32; }
    if !str_eq(r1.get(0i64), "Ada") { return 6i32; }

    // n = 8: salary > 80 keeps only Dane (Eve is unmatched); limit 8 is slack.
    let r8: Vec<str> = top_paid(&emps[..], &depts[..], 8i64).unwrap();
    if r8.len() != 1i64 { return 7i32; }
    if !str_eq(r8.get(0i64), "Dane") { return 8i32; }

    // n = 0: salary > 0 keeps everyone matched, but limit 0 → empty.
    let r0: Vec<str> = top_paid(&emps[..], &depts[..], 0i64).unwrap();
    if r0.len() != 0i64 { return 9i32; }

    return 0i32;
}
