package anyval_basic;
// Phase 9: AnyVal — 4-byte polymorphic pointer/value slot.
// Tests the full encode/decode/discriminant API.

use std.hermes.anyval;

unsafe fn main() -> i32 {
    // --- Pointer mode ---
    let av: AnyVal = AnyVal::from_offset(1024 as u32);
    if !av.is_ptr()                         { return 1; }
    if av.is_null()                         { return 2; }
    if av.as_offset() != 1024 as u32        { return 3; }

    // --- Null sentinel (pointer mode, offset 0) ---
    let nul: AnyVal = AnyVal::null_ptr();
    if !nul.is_null()                       { return 4; }
    if !nul.is_ptr()                        { return 5; }

    // --- Value mode: i24 (hash=23) ---
    let vi32: AnyVal = AnyVal::embed_i24(99 as i32);
    if vi32.is_ptr()                        { return 6; }
    if vi32.type_hash() != 23 as u8         { return 7; }
    if vi32.as_i24() != 99                  { return 8; }

    // --- Value mode: u24 (hash=25) — u24::MAX = 16777215 ---
    let vu32: AnyVal = AnyVal::embed_u24(16777215 as u32);
    if vu32.is_ptr()                        { return 9; }
    if vu32.type_hash() != 25 as u8         { return 10; }
    if vu32.as_u24() != 16777215 as u32     { return 11; }

    // --- Value mode: i16 (hash=22) ---
    let vi16: AnyVal = AnyVal::embed_i16(-300 as i16);
    if vi16.is_ptr()                        { return 12; }
    if vi16.type_hash() != 22 as u8         { return 13; }
    if vi16.as_i16() != -300 as i16         { return 14; }

    // --- Value mode: u8 (hash=21) ---
    let vu8: AnyVal = AnyVal::embed_u8(200 as u8);
    if vu8.is_ptr()                         { return 15; }
    if vu8.type_hash() != 21 as u8          { return 16; }
    if vu8.as_u8() != 200 as u8             { return 17; }

    // --- Value mode: i8 (hash=20) ---
    let vi8: AnyVal = AnyVal::embed_i8(-5 as i8);
    if vi8.is_ptr()                         { return 18; }
    if vi8.type_hash() != 20 as u8          { return 19; }
    if vi8.as_i8() != -5 as i8             { return 20; }

    // --- Value mode: bool (hash=37) ---
    let vbool: AnyVal = AnyVal::embed_bool(true);
    if vbool.is_ptr()                       { return 21; }
    if vbool.type_hash() != 37 as u8        { return 22; }
    if !vbool.as_bool()                     { return 23; }

    let vbool_f: AnyVal = AnyVal::embed_bool(false);
    if vbool_f.as_bool()                    { return 24; }

    // --- resolve: pointer mode + real address ---
    let buf: i32 = 0;
    let base: *const u8 = &buf as *const u8;
    let av2: AnyVal = AnyVal::from_offset(0 as u32);
    let resolved: *const u8 = av2.resolve(base);
    if resolved != base                     { return 25; }

    return 42;
}
