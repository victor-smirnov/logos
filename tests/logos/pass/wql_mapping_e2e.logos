// wql_mapping_e2e — the `mapping` language ITEM (ADR 0016): a PURE RULE
// MODULE — a named, typed, reusable vocabulary over a source shape, queried
// THROUGH deem (direct per-rel calls are retired: they conflated definition
// with query, re-materialized dependency rels per call, and made concrete and
// generic mappings different animals). Asserts, all via consuming deems:
//   (a) path-rule relations over a graph param (incl. `**`);
//   (b) CROSS-REL reference (one mapping rel consuming another) through a
//       NON-pub rel;
//   (c) a mapping with a scalar param, bound by name identity;
//   (d) two mappings in one module (no collisions);
//   (e) doc-comments inside the mapping body parse (rel_def_or_doc).
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.mem.writ.parser;        // parse_writ
use logos.lang.str;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.std.wql.wql;
use logos.std.wql.mapping_item;

// ── (a)+(b): the service-config vocabulary ───────────────────────────────────
pub mapping Services(g: &Writ) {
    /// Engines anywhere in the document (`**` descent).
    pub rel engine(owner: i64, name: str) {
        from g ** .engine e select (e.parent, e.vs);
    }
    pub rel port(svc: i64, p: i64) {
        from g .ports [*] q select (q.parent, q.vi);
    }
    // Non-pub rel: an internal of the vocabulary.
    rel big_port(p: i64) {
        from port r where r.p >= 8443 select r.p;
    }
}

// ── (c): scalar param alongside the graph ────────────────────────────────────
mapping Limits(g: &Writ, floor: i64) {
    pub rel over(key: str, v: i64) {
        from g ** x {i64} where x.vi >= floor select (x.key, x.vi);
    }
}

// consuming deems — the ONE way to execute a mapping.
pub deem engines(w: Services) { from engine e select (e.owner, e.name) }
pub deem ports(w: Services) { from port q select (q.svc, q.p) }
pub deem bigs(w: Services) { from big_port b select b.p }
pub deem overs(w: Limits, floor: i64) { from over o select (o.key, o.v) }

fn main() -> i32 {
    let doc: Writ = parse_writ(
        r#"{ db: { engine: "pg", pool: { min: 2, max: 16 } },
             ports: [8080, 8443],
             cache: { engine: "redis" } }"#);
    if doc.root().is_null() { return 90i32; }

    // (a) engines anywhere: pg, redis
    let e: Vec<(i64, str)> = match engines(&doc)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    if e.len() != 2i64 { return 2i32; }
    let e0: (i64, str) = e.get(0i64);
    if !str_eq(e0.1, "pg") { return 3i32; }

    // ports: 8080, 8443
    let p: Vec<(i64, i64)> = match ports(&doc)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 4i32; } };
    if p.len() != 2i64 { return 5i32; }

    // (b) big ports through the NON-pub internal rel: 8443 only
    let b: Vec<i64> = match bigs(&doc)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 6i32; } };
    if b.len() != 1i64 { return 7i32; }
    if b.get(0i64) != 8443i64 { return 8i32; }

    // (c) i64 leaves >= 16: max(16), ports 8080/8443
    let o: Vec<(str, i64)> = match overs(&doc, 16i64)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 9i32; } };
    if o.len() != 3i64 { return 10i32; }

    return 0i32;
}
