// wql_mapping_e2e — the `mapping` language ITEM (ADR 0016 M2b-2; supersedes
// the `mapping!` macro form). A mapping = a NAMED, typed, reusable set of
// domain relations over a source shape — the first concrete rule-module, now
// grammar/Sema-owned: the item and rel SIGNATURES are parsed + validated by
// the compiler (typed columns, contextual `rel` keyword, per-rel `pub`), the
// rel bodies compile through the SAME pipeline as deem! (graph-path sugar,
// `**`/reach injection, recursion, cross-rel refs), and each rel emits a fn
// mangled `<Mapping>__<rel>` so calls resolve as `Services::engine(&doc)`
// through the ordinary static-call path. Asserts:
//   (a) path-rule relations over a graph param (incl. `**`);
//   (b) CROSS-REL reference (one mapping rel consuming another) through a
//       NON-pub rel — callable in-package via Services::big_port;
//   (c) a mapping over TWO params (graph + threshold scalar);
//   (d) two mappings in one module (no symbol collisions);
//   (e) doc-comments inside the mapping body parse (rel_def_or_doc).
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.mem.writ.parser;        // parse_writ
use logos.lang.str;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.std.wql.mapping_item;

// ── (a)+(b): the service-config vocabulary ───────────────────────────────────
pub mapping Services(g: &Writ) {
    /// Engines anywhere in the document (`**` descent).
    pub rel engine(owner: i64, name: str) {
        from g ** .engine e select (e.parent, e.vs);
    }
    pub rel port(svc: i64, p: i64) {
        from g .ports [*] q select (q.parent, q.vi);
    }
    // Non-pub rel: generated fn is non-pub — callable in-package only.
    rel big_port(p: i64) {
        from port r where r.p >= 8443 select r.p;
    }
}

// ── (c): scalar param alongside the graph ────────────────────────────────────
mapping Limits(g: &Writ, floor: i64) {
    pub rel over(key: str, v: i64) {
        from g ** x {i64} where x.vi >= floor select (x.key, x.vi);
    }
}

fn main() -> i32 {
    let doc: Writ = parse_writ(
        r#"{ db: { engine: "pg", pool: { min: 2, max: 16 } },
             ports: [8080, 8443],
             cache: { engine: "redis" } }"#);
    if doc.root().is_null() { return 90i32; }

    // (a) engines anywhere: pg, redis
    let e: Vec<(i64, str)> = match Services::engine(&doc)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    if e.len() != 2i64 { return 2i32; }
    let e0: (i64, str) = e.get(0i64);
    if !str_eq(e0.1, "pg") { return 3i32; }

    // (a) ports
    let p: Vec<(i64, i64)> = match Services::port(&doc)
    { Result::Ok(v) => { v } Result::Err(_e2) => { return 4i32; } };
    if p.len() != 2i64 { return 5i32; }

    // (b) cross-rel through the NON-pub rel: big_port consumes port
    let b: Vec<i64> = match Services::big_port(&doc)
    { Result::Ok(v) => { v } Result::Err(_e3) => { return 6i32; } };
    if b.len() != 1i64 || b.get(0i64) != 8443i64 { return 7i32; }

    // (c) threshold param: i64 leaves ≥ 16 → pool.max 16, ports 8080, 8443
    let o: Vec<(str, i64)> = match Limits::over(&doc, 16i64)
    { Result::Ok(v) => { v } Result::Err(_e4) => { return 8i32; } };
    if o.len() != 3i64 { return 9i32; }

    // (d) both mappings coexist — exercised above by construction
    return 0i32;
}
