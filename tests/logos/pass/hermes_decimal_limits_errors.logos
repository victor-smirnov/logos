// Decimal limit violations return null handles (hermes2): coefficient
// overflow, malformed text, scale ceiling, add overflow.
package hermes_decimal_limits_errors;
use logos.lang.hermes2.container;
use logos.lang.hermes2.anyval;
use logos.lang.hermes2.decimal;
use logos.mem.rc;

unsafe fn main() -> i32 {
    let rc: Rc<Hermes2> = hermes2_rc(8192);
    let h: &Hermes2 = rc.deref();

    // 20+ digits → null (u64 ceiling).
    if !hdec_from_str(h, "12345678901234567890").is_null() { return 1; }
    // Junk → null.
    if !hdec_from_str(h, "1,5").is_null() { return 2; }
    if !hdec_from_str(h, " 1").is_null() { return 3; }
    // Scale > 4095 via direct construction → null.
    if !h.decimal(1u64, 4096u32, false).is_null() { return 4; }
    // Aligned-add overflow → null.
    let wide: HAny = hdec_from_str(h, "9999999999999999999");
    let frac: HAny = hdec_from_str(h, "0.1");
    if !hdec_add(h, wide, frac).is_null() { return 5; }
    // Errors do not poison the container: a good value still works.
    let ok: HAny = hdec_from_str(h, "1.5");
    if ok.is_null() { return 6; }
    if ok.as_decimal().coeff() != 15u64 { return 7; }

    return 0;
}
