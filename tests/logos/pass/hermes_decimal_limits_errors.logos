// Decimal limits/null safety checks.
// Repro cases for:
// 1) parser accepted @Decimal with precision above engine budget
// 2) parser accepted @Decimal with huge precision
// 3) parser accepted @Decimal with huge scale
// 4) ctr.decimal_from_string accepted unsupported precision
// 5) ctr.decimal_from_cstr crashed on null pointer
package hermes_decimal_limits_errors;

use logos.mem.hermes.ctr;
use logos.lang.hermes.anyval;

unsafe fn main() -> i32 {
    // 1) precision above engine budget (1143) must be rejected by parser.
    let mut d1: Hermes = Hermes::new(4096);
    match d1.parse("@Decimal(2000,2)=\"1\"") {
        Result::Ok(())  => { return 1; }
        Result::Err(_)  => {}
    }

    // 2) huge precision must be rejected by parser.
    let mut d2: Hermes = Hermes::new(4096);
    match d2.parse("@Decimal(5000,2)=\"1\"") {
        Result::Ok(())  => { return 2; }
        Result::Err(_)  => {}
    }

    // 3) huge scale must be rejected by parser.
    let mut d3: Hermes = Hermes::new(4096);
    match d3.parse("@Decimal(5000,5000)=\"1\"") {
        Result::Ok(())  => { return 3; }
        Result::Err(_)  => {}
    }

    // 4) API constructor must reject unsupported precision.
    let mut b1: Hermes = Hermes::builder(4096);
    let v_bad: AnyVal = b1.decimal_from(2000 as i32, 2 as i32, "1.00");
    if !v_bad.is_null() { return 4; }

    // 5) Null c-string must not crash and must return null.
    let v_null: AnyVal = b1.decimal_from(10 as i32, 2 as i32, 0 as *const u8);
    if !v_null.is_null() { return 5; }

    return 0;
}
