// Closed squeue array_by_value_into_iter_refused (#719): for over an array is IntoIterator::into_iter of [T; N] (Rust's array impl), the HIR for desugaring; ADR 0030 S10 row 1.
package array_by_value_into_iter_refused;
fn main() -> i32 { let mut s = 0i64; for x in [4i64, 5].into_iter() { s += x; } return s as i32; }
