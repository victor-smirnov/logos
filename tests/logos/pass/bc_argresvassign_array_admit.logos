// PAIR C, pass half — the same array write, one token over, to the sibling that
// is NOT reserved.
package bc_argresvassign_array_admit;
fn take(a: &mut [i64; 2], b: i64) -> i64 { return a[0] + b; }
fn main() -> i32 {
    let mut arr: [i64; 2] = [1i64, 2i64];
    let mut arr2: [i64; 2] = [3i64, 4i64];
    let r: i64 = take(&mut arr, { arr2 = [8i64, 9i64]; 0i64 });
    return (r + arr2[1]) as i32;
}
