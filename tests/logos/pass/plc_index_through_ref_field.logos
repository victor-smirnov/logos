// ADR 0030 S6 (C-PLC): `h.p[i]` with `p: &mut [i64; 3]` loads the field's pointer before indexing (it indexed the field's own 8 bytes: garbage read, lost write, `+=` on garbage).
// rustc 1.98.1 twin exits 18.
package plc_index_through_ref_field;
struct H<'a> { p: &'a mut [i64; 3], k: i64 }
fn main() -> i32 { let mut arr: [i64; 3] = [1, 2, 3]; let h = H { p: &mut arr, k: 0 }; let r = h.p[1]; h.p[2] = 10; h.p[0] += 5; let s = h.p[0] + h.p[2] + r + h.k; return s as i32; }
