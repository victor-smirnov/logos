// `Ord::max` / `min` / `clamp` are default methods (`where Self: Sized`), available on a user type that writes only `cmp`.
// Instantiating them for std's `impl Ord for &i32` exposed three defects, fixed here: that impl's header `&i32` is ONE anonymous impl region shared by every `Self` (each
// occurrence took its own elided region: "expected &'1 i32, got &'2 i32"), every default after the first keeps its
// `Self` (it was left unbound), and an unsized implementor (`impl Ord for str`) gets no `Sized`-only default.
// rustc twin: 42.
package ord_default_max_min_clamp;
use logos.lang.cmp;
struct S { x: i64 }
impl Ord for S {
    fn cmp(&self, other: &S) -> Ordering {
        if self.x < other.x { return Ordering::Less; }
        if self.x > other.x { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
fn main() -> i32 {
    let mut fails = 0;
    if (S { x: 3 }.max(S { x: 8 }).x) != 8 { fails = fails + 1; }
    if (S { x: 3 }.min(S { x: 8 }).x) != 3 { fails = fails + 2; }
    if (S { x: 12 }.clamp(S { x: 0 }, S { x: 10 }).x) != 10 { fails = fails + 4; }
    if (S { x: -5 }.clamp(S { x: 0 }, S { x: 10 }).x) != 0 { fails = fails + 8; }
    if fails != 0 { return fails; }
    return 42;
}
