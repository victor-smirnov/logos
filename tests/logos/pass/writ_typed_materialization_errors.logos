// Typed-container materialization errors -> null (writ2): wrong key kinds,
// non-numeric elements; a valid doc follows fine.
package writ_typed_materialization_errors;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.mem.writ.parser;
use logos.lang.rc;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(8192);
    let h: &Writ = rc.deref();
    if parse(h, "<U64>[1]").is_null() { return 1; }                    // fine
    if !parse(h, "<I32,AnyVal>{\"a\":1}").is_null() { return 2; }      // string key in int map
    if !parse(h, "<I32>[\"x\"]").is_null() { return 3; }               // string element
    if parse(h, "<I32>[1,2]").is_null() { return 4; }                  // recovery
    return 0;
}
