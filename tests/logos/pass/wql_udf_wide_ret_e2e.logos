// WQL — A USER FUNCTION'S RESULT KEEPS ITS DECLARED TYPE (E4.5, 2026-10-02).
//
// `ukey` returns `u64`, so `select ukey(a.v)` is a `Vec<u64>` and `order by ukey(…)`
// orders by the u64 value. Until now the call was normalized with `as i64` at the
// emit site, which reinterprets every value at or above 2^63 — so a u64 (or u128)
// return was REFUSED at the call (fail/wql_udf_wide_int_ret_fail, retired: it
// pinned the refusal of a normalization that no longer exists).
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct A { pub k: i64, pub v: i64 }

pub fn ukey(v: i64) -> u64 { return v as u64; }

pub deem keys(as_: &[A]) { from as_ a select ukey(a.v) }
pub deem by_key(as_: &[A]) { from as_ a select a.k order by ukey(a.v) }

fn main() -> i32 {
    // -1 as u64 is u64::MAX: the largest key, not the smallest.
    let as_: [A; 2] = [ A { k: 1i64, v: -1i64 }, A { k: 2i64, v: 5i64 } ];
    let g: Vec<u64> = keys(&as_[..]).unwrap();
    if g.get(0i64) != 18446744073709551615u64 { return 1i32; }
    if g.get(1i64) != 5u64 { return 2i32; }
    let o: Vec<i64> = by_key(&as_[..]).unwrap();
    if o.get(0i64) != 2i64 { return 3i32; }
    if o.get(1i64) != 1i64 { return 4i32; }
    return 0i32;
}
