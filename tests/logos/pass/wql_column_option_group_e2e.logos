// An `Option<i64>` COLUMN of a slice source groups by its VALUE (#744).
//
// It used to be refused at the source's declaration (fail/wql_column_decl_
// option_col_fail), because before that the EL classed the spelling as the
// integer representative and the group key read the value's first eight bytes
// — the DISCRIMINANT: four rows with three distinct values answered TWO groups
// (one per variant) and nothing was reported. A generic spelling is now a
// NAMED type carried as itself, so the same data must answer THREE groups, as
// the `i64` control column beside it always did.
package test;
use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.result;
use logos.lang.option;

struct S { pub o: Option<i64>, pub c: i64, pub id: i64 }

pub deem qo(ss: &[S]) { from ss s group by s.o aggregate n = count() select n order by n }
pub deem qc(ss: &[S]) { from ss s group by s.c aggregate n = count() select n order by n }

fn main() -> i32 {
    // o: Some(1), Some(2), None, Some(1) — three distinct values; c mirrors it
    let ss: [S; 4] = [ S { o: Option::Some(1i64), c: 1, id: 1 }, S { o: Option::Some(2i64), c: 2, id: 2 },
                       S { o: Option::None, c: 0, id: 3 }, S { o: Option::Some(1i64), c: 1, id: 4 } ];
    let o: Vec<i64> = qo(&ss[..]).unwrap();
    let c: Vec<i64> = qc(&ss[..]).unwrap();
    // counts 1, 1, 2 for both
    if c.len() != 3i64 || c.get(2i64) != 2i64 { return 1i32; }
    if o.len() != 3i64 || o.get(0i64) != 1i64 || o.get(1i64) != 1i64 || o.get(2i64) != 2i64 { return 2i32; }
    return 0i32;
}
