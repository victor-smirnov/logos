package while_nested;
// F06: nested while loops
unsafe fn main() -> i32 {
    let mut sum: i32 = 0;
    let mut i: i32 = 1;
    while i <= 6 {
        let mut j: i32 = 1;
        while j <= i {
            sum = sum + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    // sum = 1+2+3+4+5+6 = 21, 21*2 = 42
    return sum * 2;
}
