// query_incr_factstore_e2e_rec — slice-8 END-TO-END: a standing transitive-
// closure `rel path` driven ENTIRELY by a FactStore's insert/retract, with the
// store PRODUCING each epoch's ZBatch via take_delta (ADR 0013 §6, change-
// capture A). This is the decisive proof of the store→changelog→engine path:
// NO hand-synthesized batch, NO test-side src_apply clamp — the store owns the
// U1 clamp and canonical-handle interning. After every epoch the maintained
// IncrRec snapshot is compared, as a weighted multiset at quiescence, against
// the queue-2 batch least-fixpoint oracle recomputed over store.build_present().
//
// A deterministic in-Logos LCG drives a multi-epoch battery over a small node
// universe (forced cycles + multi-path derivations). Scripted deterministic
// steps GUARANTEE coverage of insert-of-present (no-op), retract-of-absent
// (no-op), re-insert, and cyclic-graph retraction (DRed soundness); the LCG
// adds breadth. Any divergence ⇒ nonzero exit.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.lang.arith;
use logos.mem.collections.vec;

pub schema Edge : code(0x0E09_0000_0000_0001) {
    src: i64 = 0,
    dst: i64 = 1,
}
resource cat = schema_catalog!{ Edge };

// Build the edge in the store's own arena via a raw pointer (keeps the handle
// free of a tracked borrow of the store — see the unit harness).
fn mk_edge(dp: *const Writ, s: i64, t: i64) -> WAny {
    let d: &Writ = unsafe { &*dp };
    let e: Edge = d.make::<Edge>();
    e.src = s; e.dst = t;
    return WAny::ref_to((e.m as i64) as *const u8);
}

// ── Deterministic LCG (Knuth MMIX constants); high bits via >>33 ────────────
struct Lcg { s: u64 }
impl Lcg {
    fn next(self: &mut Lcg) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
}
fn lcg_seed(seed: u64) -> Lcg {
    let mut l: Lcg = Lcg { s: wrapping_add(wrapping_mul(seed, 2862933555777941757u64), 3037000493u64) };
    let _w0: u64 = l.next();
    let _w1: u64 = l.next();
    return l;
}
fn rand_n(l: &mut Lcg, n: i64) -> i64 {
    if n <= 0i64 { return 0i64; }
    return (l.next() % (n as u64)) as i64;
}

fn qrow_eq(a: &QRows, ai: i64, b: &QRows, bi: i64) -> bool {
    let nc: i64 = a.col_count();
    let mut c: i64 = 0i64;
    while c < nc {
        if a.is_null(ai, c) != b.is_null(bi, c) { return false; }
        if a.get_i64(ai, c) != b.get_i64(bi, c) { return false; }
        c = c + 1i64;
    }
    return true;
}
fn multiset_eq(a: &QRows, b: &QRows) -> bool {
    if a.row_count() != b.row_count() { return false; }
    if a.col_count() != b.col_count() { return false; }
    let n: i64 = a.row_count();
    let mut used: Vec<bool> = vec_new::<bool>();
    let mut i: i64 = 0i64;
    while i < n { used.push(false); i = i + 1i64; }
    let mut ai: i64 = 0i64;
    while ai < n {
        let mut found: bool = false;
        let mut bi: i64 = 0i64;
        while bi < n && !found {
            if !used.get(bi) {
                if qrow_eq(a, ai, b, bi) { used.set(bi, true); found = true; }
            }
            bi = bi + 1i64;
        }
        if !found { return false; }
        ai = ai + 1i64;
    }
    return true;
}

// Oracle over the store's CURRENT present set vs the maintained snapshot.
fn cmp(eng: &IncrRec, q: &Query, st: &FactStore, oenv: &mut QEnv) -> bool {
    oenv.bind_source("edges", st.build_present());
    let orc: QRows = match q.run(oenv) { Result::Ok(r) => { r } Result::Err(_e) => { return false; } };
    let snap: QRows = eng.snapshot();
    return multiset_eq(&snap, &orc);
}

fn main() -> i32 {
    let c: SchemaCatalog = cat();
    let kf: [str; 2] = ["src", "dst"];

    let q: Query = match Query::compile(
        r#"rel path(a: i64, b: i64) {
             from edges e select (e.src, e.dst);
             from path p join edges e on p.b == e.src select (p.a, e.dst);
           }
           from path p select (p.a, p.b)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };

    // ── One store, the sole edge SOURCE. Pre-materialize a stable handle POOL of
    // all ordered pairs (i,j), i != j over nodes 0..4 so mk_edge is called once
    // per content; the store interns anyway, but a stable pool keeps canonical
    // raws pinned across epochs. ──
    let mut st: FactStore = match FactStore::new(&c, "Edge", &kf[..], 1048576i64) {
        Result::Ok(s)   => { s }
        Result::Err(_e) => { return 91i32; }
    };
    let ap: *const Writ = st.arena_ptr();

    let n_nodes: i64 = 5i64;
    let mut pool: Vec<WAny> = vec_new::<WAny>();
    let mut a: i64 = 0i64;
    while a < n_nodes {
        let mut b: i64 = 0i64;
        while b < n_nodes {
            if a != b { pool.push(mk_edge(ap, a, b)); }
            b = b + 1i64;
        }
        a = a + 1i64;
    }
    let ne: i64 = pool.len();

    // Base edges = chain 0→1→2→3→4 (inserted into the store → base pend).
    st.insert(pool.get(pool_idx(0i64, 1i64)));
    st.insert(pool.get(pool_idx(1i64, 2i64)));
    st.insert(pool.get(pool_idx(2i64, 3i64)));
    st.insert(pool.get(pool_idx(3i64, 4i64)));

    // Build the engine off the store's CURRENT present set (base +1/element),
    // then DISCARD the base pend so epoch-1 deltas are only post-baseline changes.
    let mut eng_env: QEnv = QEnv::new();
    eng_env.bind_source("edges", st.build_present());
    let mut eng: IncrRec = match q.incremental_rec(&eng_env) { Result::Ok(e) => { e } Result::Err(_e2) => { return 92i32; } };
    let _base: ZBatch = st.take_delta();   // drop the baseline delta

    let mut oenv: QEnv = QEnv::new();
    if !cmp(&eng, &q, &st, &mut oenv) { return 1i32; }

    // ── Scripted deterministic coverage (no LCG) ──
    // (S1) insert-of-PRESENT (0→1 already present): no-op, closure unchanged.
    st.insert(pool.get(pool_idx(0i64, 1i64)));
    pump_rec(&mut st, &mut eng);
    if !cmp(&eng, &q, &st, &mut oenv) { return 2i32; }
    // (S2) retract-of-ABSENT (4→0 never inserted): no-op.
    st.retract(pool.get(pool_idx(4i64, 0i64)));
    pump_rec(&mut st, &mut eng);
    if !cmp(&eng, &q, &st, &mut oenv) { return 3i32; }
    // (S3) close the cycle: insert 4→0 (5-cycle; closure grows to all pairs).
    st.insert(pool.get(pool_idx(4i64, 0i64)));
    pump_rec(&mut st, &mut eng);
    if !cmp(&eng, &q, &st, &mut oenv) { return 4i32; }
    // (S4) cyclic retraction (DRed soundness): break 2→3.
    st.retract(pool.get(pool_idx(2i64, 3i64)));
    pump_rec(&mut st, &mut eng);
    if !cmp(&eng, &q, &st, &mut oenv) { return 5i32; }
    // (S5) re-insert 2→3 (re-growth after retraction).
    st.insert(pool.get(pool_idx(2i64, 3i64)));
    pump_rec(&mut st, &mut eng);
    if !cmp(&eng, &q, &st, &mut oenv) { return 6i32; }
    // (S6) intra-epoch insert-then-retract of the SAME absent content (0→2):
    // net-zero at the store, engine sees +1/−1 coalesced → no change.
    st.insert(pool.get(pool_idx(0i64, 2i64)));
    st.retract(pool.get(pool_idx(0i64, 2i64)));
    pump_rec(&mut st, &mut eng);
    if !cmp(&eng, &q, &st, &mut oenv) { return 7i32; }

    // ── LCG breadth: multi-op epochs of random toggles over the pool. Present
    // edge → retract; absent edge → insert. Each epoch pumped store→engine. ──
    let mut lcg: Lcg = lcg_seed(0xC0FFEEu64);
    // present[] mirror (test-side view of what the store holds) for toggle choice.
    let mut pres: Vec<bool> = vec_new::<bool>();
    let mut z: i64 = 0i64;
    while z < ne { pres.push(false); z = z + 1i64; }
    // seed the mirror from the current scripted state (chain + 4→0, 2→3 present)
    pres.set(pool_idx(0i64, 1i64), true);
    pres.set(pool_idx(1i64, 2i64), true);
    pres.set(pool_idx(2i64, 3i64), true);
    pres.set(pool_idx(3i64, 4i64), true);
    pres.set(pool_idx(4i64, 0i64), true);

    let mut ep: i64 = 0i64;
    while ep < 40i64 {
        let nops: i64 = 1i64 + rand_n(&mut lcg, 3i64);
        let mut o: i64 = 0i64;
        while o < nops {
            let idx: i64 = rand_n(&mut lcg, ne);
            if pres.get(idx) {
                st.retract(pool.get(idx));
                pres.set(idx, false);
            } else {
                st.insert(pool.get(idx));
                pres.set(idx, true);
            }
            o = o + 1i64;
        }
        pump_rec(&mut st, &mut eng);
        if !cmp(&eng, &q, &st, &mut oenv) { return 100i32 + (ep as i32); }
        ep = ep + 1i64;
    }

    return 0i32;
}

// Index into the ordered-pair pool (i,j), i,j ∈ 0..5, i != j (20 edges).
fn pool_idx(i: i64, j: i64) -> i64 {
    let mut k: i64 = 0i64;
    let mut a: i64 = 0i64;
    while a < 5i64 {
        let mut b: i64 = 0i64;
        while b < 5i64 {
            if a != b {
                if a == i && b == j { return k; }
                k = k + 1i64;
            }
            b = b + 1i64;
        }
        a = a + 1i64;
    }
    return -1i64;
}
