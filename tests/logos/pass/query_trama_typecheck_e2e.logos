// queue-2 I1 (+I3 amendments) — the runtime CHECKER, errors as VALUES (ADR
// 0012-queue2 §§3,4): never compile diagnostics — `Tpl::compile` / `render`
// return Result::Err (QError) with the offending name in the message.
//
//   compile-phase (env-independent): builtin arity, comprehension rejection,
//     parse error, literal type conflicts;
//   render-phase (strict, needs the env's declarations): unknown variable,
//     unknown FUNCTION (I3 registry unification — may be a render-env UDF, so
//     compile DEFERS), unknown field (I3 lenient — an erased binding may
//     resolve it, so compile defers), operator/type misuse, `{% for %}` over
//     a non-collection, object interpolation.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.std.wql.catalog_macro;
use logos.std.query;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Emp : code(0x0A03_0000_0000_0001) {
    name: str = 0,
    age:  i64 = 1,
}

impl Emp { pub fn as_any(self: &Emp) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }

resource cat = schema_catalog!{ Emp };

// Expect Tpl::compile(text) to FAIL with `frag` in the message.
fn expect_compile_err(text: str, c: &SchemaCatalog, frag: str) -> bool {
    match Tpl::compile(text, c) {
        Result::Ok(_t) => { return false; }
        Result::Err(e) => { return str_contains(e.message(), frag); }
    }
}

// Expect render over `env` to FAIL with `frag` in the message (compile OK).
fn expect_render_err(text: str, c: &SchemaCatalog, env: &QEnv, frag: str) -> bool {
    match Tpl::compile(text, c) {
        Result::Ok(t) => {
            match t.render(env) {
                Result::Ok(_s) => { return false; }
                Result::Err(e) => { return str_contains(e.message(), frag); }
            }
        }
        Result::Err(_e2) => { return false; }
    }
}

fn main() -> i32 {
    let c: SchemaCatalog = cat();

    // ── compile-phase errors (no env needed) ──────────────────────────────
    if !expect_compile_err("{{ len(e.name, e.name) }}", &c, "wrong number of arguments for 'len'") { return 2i32; }
    if !expect_compile_err("{{ [x for x in xs] }}", &c, "not supported in the dynamic surface") { return 4i32; }
    if !expect_compile_err("{% if e.age %}no endif", &c, "parse error") { return 5i32; }
    if !expect_compile_err("{{ 1 - \"x\" }}", &c, "'-' needs numeric operands") { return 6i32; }

    // ── render-phase errors (strict, per-env) ─────────────────────────────
    let d: Writ = writ_new(1024i64);
    let e1: Emp = d.make::<Emp>();
    e1.name = "Ann";
    e1.age = 45i64;
    let mut env: QEnv = QEnv::new();
    env.bind_node("e", e1.as_any());

    // I3: unknown fn / unknown field DEFER at compile (UDF registry + lenient
    // bindings live on the env) and reject in the STRICT render check.
    if !expect_render_err("{{ frob(1) }}", &c, &env, "unknown function 'frob'") { return 1i32; }
    if !expect_render_err("{{ e.salary }}", &c, &env, "unknown field 'salary'") { return 3i32; }
    if !expect_render_err("{{ nobody }}", &c, &env, "unknown variable 'nobody'") { return 7i32; }
    if !expect_render_err("{{ e.name - 1 }}", &c, &env, "'-' needs numeric operands") { return 8i32; }
    if !expect_render_err("{{ e.name && e.age }}", &c, &env, "needs bool operands") { return 9i32; }
    if !expect_render_err("{{ e.age + e.name }}", &c, &env, "cannot mix a string with a number") { return 10i32; }
    if !expect_render_err("{% for m in e.age %}x{% endfor %}", &c, &env, "'{% for %}' needs a collection") { return 11i32; }
    if !expect_render_err("{{ e }}", &c, &env, "cannot interpolate an object") { return 12i32; }
    if !expect_render_err("{{ e.name == 1 }}", &c, &env, "compares values of different types") { return 13i32; }

    // ── and the happy path still renders ──────────────────────────────────
    match Tpl::compile("{{ e.name }}:{{ e.age }}", &c) {
        Result::Ok(t) => {
            match t.render(&env) {
                Result::Ok(s) => {
                    let sv: str = unsafe { str_from_raw(s.as_ptr(), s.len()) };
                    if !str_eq(sv, "Ann:45") { return 14i32; }
                }
                Result::Err(_e4) => { return 15i32; }
            }
        }
        Result::Err(_e5) => { return 16i32; }
    }

    return 0i32;
}
