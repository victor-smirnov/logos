// Hermes list comprehensions: plain + guarded (hermes2 Rc<Hermes2> builder).
// Scalars coerce implicitly (hermes2_coerce_*); reads via HView2 helpers.
package hermes_list_comp_basic;

use logos.lang.hermes2.comp_builder;
use logos.lang.hermes2.container;
use logos.lang.hermes2.anyval;
use logos.lang.hermes2.static_view;
use logos.mem.rc;

fn main() -> i32 {
    let arr: [i32; 5] = [1, 2, 3, 4, 5];

    // Plain: square each element.
    let doc: Rc<Hermes2> = @[x * x for x in arr];

    // Guarded: even elements, times 10.
    let evens: Rc<Hermes2> = @[x * 10 for x in arr if (x % 2) == 0];

    unsafe {
        let v0: HView2 = HView2 { base: 0 as *const u8 };
        let h: &Hermes2 = doc.deref();
        let root1: HAny = h.root();
        if !root1.is_array() { return 1; }
        if v0.array_len(root1) != 5u64 { return 2; }
        if v0.get_int(v0.array_get(root1, 2u64)) != 9i64 { return 3; }    // 3*3
        if v0.get_int(v0.array_get(root1, 4u64)) != 25i64 { return 4; }   // 5*5

        let eh: &Hermes2 = evens.deref();
        let root2: HAny = eh.root();
        if !root2.is_array() { return 50; }
        if v0.array_len(root2) != 2u64 { return 5; }
        if v0.get_int(v0.array_get(root2, 0u64)) != 20i64 { return 6; }   // 2*10
        if v0.get_int(v0.array_get(root2, 1u64)) != 40i64 { return 7; }   // 4*10
    }
    return 42;
}
