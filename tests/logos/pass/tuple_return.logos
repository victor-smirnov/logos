package tuple_return;
// F20: function returning a tuple
fn minmax(a: i32, b: i32, c: i32) -> (i32, i32) {
    let mut mn: i32 = a;
    let mut mx: i32 = a;
    if b < mn { mn = b; }
    if b > mx { mx = b; }
    if c < mn { mn = c; }
    if c > mx { mx = c; }
    return (mn, mx);
}
fn main() -> i32 {
    let t: (i32, i32) = minmax(15, 3, 30);
    // t.0 = 3 (min), t.1 = 30 (max)
    // 3 + 30 + 9 = 42
    return t.0 + t.1 + 9;
}
