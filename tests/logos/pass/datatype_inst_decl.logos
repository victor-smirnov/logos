package datatype_inst_decl;
// Tests explicit instantiation declaration syntax:
//   #[type_code=N] eidos SomeGeneric<T>;
// This binds a short type_code to a generic instantiation without
// redefining the type.

eidos Pair<T> {
    first:  T,
    second: T,
}

// Explicit instantiation declarations — bind type_codes to concrete instances.
#[type_code = 200]
eidos Pair<i32>;

#[type_code = 201]
eidos Pair<i64>;

fn main() -> i32 {
    // The explicit instantiation declarations above must parse and lower without error.
    // Return 42 to confirm the program ran.
    return 42;
}
