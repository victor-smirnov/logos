// `ordw` — the claim "this value's order wrapped" — is a fact about the value's
// ORIGIN, and this pins the two places that got it wrong in opposite directions.
//
// Background: a u64 reaches the runtime engines as `RtVal::I(i64)`, so every
// value at or above 2^63 reads negative and an ordered comparison ranks it
// below zero. The fix carries the column's signedness to the comparison seam and
// keys through `el_wrap_ord_key`. A carrier has two failure modes, and the
// commit that introduced it had one of each:
//
//   UNDER-CARRY — an aggregate's OUT-NAME. `max(s.u)` over a u64 column returns a
//   row's own value, so it IS a u64; the one carrier in `CBinds` that still bound
//   without the signedness made `order by hi` sort it signed.
//
//   OVER-CARRY, and this one was a REGRESSION — a ternary. The whole integer
//   family shares one type code, so a u64 THEN branch and an i64 ELSE branch
//   compare equal and the THEN branch's `CTy` was returned verbatim. Rows that
//   took the i64 branch were then ordered by the WRAPPED key: a reading that was
//   correct before the carrier existed.
//
// THE RULE both arms assert: a value may claim `ordw` only where its origin is
// known to carry it. An operation that PRESERVES an input passes it on when
// every input agrees; where they disagree the claim is DROPPED, because
// `p ? u64 : i64` has no honest type in a one-integer-code domain — and what
// that type SHOULD be is the untaken unsigned-arithmetic decision, not this
// file's business.
//
// ⚠ GROUP 4 WAS REWRITTEN 2026-08-05 when the claim moved onto the expression
// node and `sx_is_origin` retired. It asserted the RESTRICTION (a computed key
// sorts signed) and now asserts its ABSENCE (a computed key whose operands agree
// sorts unsigned). Groups 3 and 3b did NOT move: they are the over-carry guard,
// and the carrier landing without moving them is the evidence that the claim is
// still dropped where the operands disagree.
//
// exit 0 = min/max out-names sort unsigned, a mixed ternary sorts signed, and an
// unmixed COMPUTED key sorts unsigned.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema R : code(0x0B13_0000_0000_0051) {
    id: i64  = 0,
    g:  i64  = 1,
    u:  u64  = 2,   // the unsigned column: its order WRAPS
    v:  i64  = 3,   // the signed control, same width
    p:  bool = 4,   // ternary selector
}
resource cat = schema_catalog!{ R };

fn mk(d: &Writ, id: i64, g: i64, u: u64, v: i64, p: bool) -> WAny {
    let r: R = d.make::<R>(); r.id = id; r.g = g; r.u = u; r.v = v; r.p = p;
    return WAny::ref_to((r.m as i64) as *const u8);
}

fn ids(qt: str, c: &SchemaCatalog, env: &QEnv) -> Vec<i64> {
    let mut out: Vec<i64> = vec_new::<i64>();
    match Query::compile(qt, c) {
        Result::Ok(q) => {
            match q.run(env) {
                Result::Ok(r) => {
                    let n: i64 = r.row_count();
                    let mut i: i64 = 0i64;
                    while i < n { out.push(r.get_i64(i, 0i64)); i = i + 1i64; }
                }
                Result::Err(_a) => { out.push(-1i64); }
            }
        }
        Result::Err(_b) => { out.push(-2i64); }
    }
    return out;
}
fn eq3(v: &Vec<i64>, a: i64, b: i64, c: i64) -> bool {
    if v.len() != 3i64 { return false; }
    return v.get(0i64) == a && v.get(1i64) == b && v.get(2i64) == c;
}

fn main() -> i32 {
    let c: SchemaCatalog = cat();
    let d: Writ = writ_new(8192i64);
    let rows: &mut WArray<WAny> = d.array(8i64);
    // u: 5, 2^63, 2^64-1 — the three that separate the signed reading from the
    // unsigned one. v: all take the SAME i64 branch of the ternary below, and
    // their signed order is deliberately the REVERSE of u's unsigned order, so a
    // wrapped key applied here cannot pass by coincidence.
    rows.push(mk(&d, 0i64, 0i64, 5u64,                     30i64, false));
    rows.push(mk(&d, 1i64, 1i64, 9223372036854775808u64,   20i64, false));
    rows.push(mk(&d, 2i64, 2i64, 18446744073709551615u64,  10i64, false));
    let src: WAny = WAny::ref_to(rows as *const WArray<WAny> as *const u8);
    let mut e: QEnv = QEnv::new();
    e.bind_source("rs", src);

    // ── 1. the aggregate OUT-NAME carries the column's signedness ──────────
    // One row per group, so `max` is the identity and the only question is the
    // ORDER of the outputs. Unsigned: 5 < 2^63 < 2^64-1, so ids 0,1,2.
    if !eq3(&ids("from rs s group by s.id aggregate hi = max(s.u) select (key, hi) order by hi", &c, &e),
            0i64, 1i64, 2i64) { return 10i32; }
    // min is the same claim through the other fold arm.
    if !eq3(&ids("from rs s group by s.id aggregate lo = min(s.u) select (key, lo) order by lo", &c, &e),
            0i64, 1i64, 2i64) { return 11i32; }

    // ── 2. a plain u64 column still sorts unsigned — the control that says the
    //      carrier is alive at all, so a green group 1 cannot mean "no carrier".
    if !eq3(&ids("from rs s select s.id order by s.u", &c, &e), 0i64, 1i64, 2i64) { return 20i32; }

    // ── 3. a MIXED ternary drops the claim and sorts SIGNED ────────────────
    // Every row has p == false, so every row takes the i64 branch and the key is
    // v: 30, 20, 10 → ascending gives ids 2,1,0. Under the over-carry this
    // answered u's wrapped order, 0,1,2 — the exact inversion.
    if !eq3(&ids("from rs s select s.id order by (s.p ? s.u : s.v)", &c, &e),
            2i64, 1i64, 0i64) { return 30i32; }
    // …and with the branches swapped. ⚠ NOT the same answer, and the difference
    // is the point: `p` is false on every row, so this expression takes the OTHER
    // branch and keys on `u` — but the claim was dropped because the branches
    // disagree, so `u` is read SIGNED. 2^63 is the most negative, 2^64-1 is -1,
    // 5 is positive: ids 1,2,0. Under the over-carry this answered u's UNSIGNED
    // order (0,1,2), so an expectation copied from the line above would have
    // passed for the wrong reason.
    if !eq3(&ids("from rs s select s.id order by (s.p ? s.v : s.u)", &c, &e),
            1i64, 2i64, 0i64) { return 31i32; }

    // ── 4. AT A SORT KEY, AN UNMIXED COMPUTED KEY NOW CLAIMS — the restriction
    //      is RETIRED, and this arm is the rewrite its own former text ordered.
    //
    // What this arm used to say: `ct_join_ordw` says this expression IS a u64
    // (both branches agree), and at an aggregate ARGUMENT the evaluator honoured
    // that — but a sort key has a second requirement the argument does not, that
    // the value be COMPUTED under the same predicate it is ORDERED under. The
    // evaluator carried the unsigned predicate into aggregate arguments ONLY, so
    // a key it computed signed had to be ordered signed. MEASURED at the time,
    // `order by (s.u / 3)` under the unrestricted claim returned a permutation
    // matching neither the wholly-unsigned order nor the wholly-signed one —
    // strictly worse than either. `sx_is_origin` bought that consistency by
    // refusing the claim to any key that was not a field, a name or a parameter,
    // and it carried its own retirement condition: "when the evaluator carries
    // the claim into projections, filters and sort keys together, `sx_is_origin`
    // goes away and this expression sorts 0,1,2 like group 2."
    //
    // THAT HAPPENED. The claim rides on the expression node (`SBin.ordw`), so
    // the key is computed under the predicate it is ordered under at every
    // position, `sx_is_origin` is gone, and the sort key uses `kt.ordw`
    // directly. Both branches are the same u64 column, so this IS u's unsigned
    // order: 5 < 2^63 < 2^64-1 → ids 0,1,2. The arm was rewritten, not relaxed:
    // it asserts the OPPOSITE permutation from the one it used to, and groups
    // 3/3b — where the branches DISAGREE and the claim is dropped — are
    // unchanged, which is what says the retirement did not become an over-carry.
    if !eq3(&ids("from rs s select s.id order by (s.p ? s.u : s.u)", &c, &e),
            0i64, 1i64, 2i64) { return 40i32; }
    // …and the COMPUTED key the old text named as the reason for the
    // restriction. Unsigned quotients by 3: 5/3 = 1, 2^63/3 = 3074457345618258602,
    // (2^64-1)/3 = 6148914691236517205 — ascending, so ids 0,1,2. Signed they are
    // 1, -3074457345618258602 and 0, whose ascending order is 1,2,0; the
    // permutation that matched NEITHER is what the half-carried state produced.
    if !eq3(&ids("from rs s select s.id order by (s.u / 3)", &c, &e),
            0i64, 1i64, 2i64) { return 41i32; }
    // CONTROL over the signed column, same shape, same rows: v/3 = 10, 6, 3 →
    // ascending gives ids 2,1,0, the reverse permutation. A comparator that had
    // stopped reading the key could not pass both lines.
    if !eq3(&ids("from rs s select s.id order by (s.v / 3)", &c, &e),
            2i64, 1i64, 0i64) { return 42i32; }

    return 0i32;
}
