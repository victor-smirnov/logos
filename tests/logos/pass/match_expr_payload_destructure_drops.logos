// Match-expression payload destructure: moved parts drop once, through `&` nothing drops (rustc 1.98.1: 6 1 14 1 300 13).
package match_expr_payload_destructure_drops;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct W { a: D, b: i64 }
enum G { T((D, i64)), S(W), N }
fn main() -> i32 {
    let mut n: i64 = 0i64; let p: *mut i64 = &mut n;
    let g1 = G::T((D { v: 1i64, c: p }, 5i64));
    let r1 = match g1 { G::T((d, k)) => d.v + k, G::S(W { a, b }) => a.v + b, G::N => 0i64 };
    let m1 = unsafe { *p };
    let g2 = G::S(W { a: D { v: 2i64, c: p }, b: 7i64 });
    let r2 = match &g2 { G::T((d, k)) => d.v + *k, G::S(W { a, b }) => a.v * *b, G::N => 0i64 };
    let m2 = unsafe { *p };
    let g3 = G::S(W { a: D { v: 3i64, c: p }, b: 1i64 });
    let r3 = match g3 { G::T((d, _)) => d.v, G::S(W { a, .. }) => a.v * 100i64, G::N => 0i64 };
    let m3 = unsafe { *p };
    unsafe { printf("%lld %lld %lld %lld %lld %lld\n".as_ptr(), r1, m1, r2, m2, r3, m3); }
    return 0i32;
}
