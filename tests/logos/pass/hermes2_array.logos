// Hermes2 — direct &mut HArray<HVal> reference holding inline Pod + a Ref to a TAGGED
// non-array object, with growth (cap 2 → 4 pushes) across tiny 48B segments. The
// Ref survives the re-anchoring grow and dispatches through Hermes2TagSystem.
package test;
use logos.lang.hermes2.container;
use logos.mem.hermes2.tag_system;
use logos.lang.hermes2.anyval;
use logos.lang.hermes2.array;
use logos.lang.ptr;

#[tag_dispatch(Hermes2TagSystem)] trait Sum2 { unsafe fn s(self: *const Self) -> i64; }
#[type_code=161] #[zoned] struct Pair { a: i64, b: i64 }
impl Sum2 for Pair { pub unsafe fn s(self: *const Pair) -> i64 { return self.a + self.b; } }

unsafe fn dispatch(za: HAny) -> i64 {
    let t: &tagged<Hermes2TagSystem> Sum2 = za.resolve();
    return t.s();
}

fn main() -> i32 {
    let h: Hermes2 = hermes2_new(48i64);
    let arr: &mut HArray<HVal> = h.array(2i64);
    arr.push(HAny::from(1i64));
    arr.push(HAny::from(2i64));
    unsafe {
        // a tagged Pair object in the arena (raw) + a Ref element to it
        let hraw: *mut Hermes2 = &h as *const Hermes2 as *mut Hermes2;
        let pobj: *mut u8 = hermes2_alloc_bytes(hraw, 8i64 + 16i64);
        let pair_at: *mut u8 = pobj.byte_add(8i64);
        write_tag(pair_at, type_code_of::<Pair>());
        let p: *mut Pair = pair_at as *mut Pair;  p.a = 30i64;  p.b = 12i64;
        arr.push(HAny::ref_to(pair_at as *const u8));   // forces grow
        arr.push(HAny::from(99i64));

        if arr.len() != 4i64 { return 1; }
        let e0: HAny = arr.get(0i64);
        let e2: HAny = arr.get(2i64);
        let e3: HAny = arr.get(3i64);
        if e0.as_i56() != 1i64 { return 2; }
        if !e2.is_ref() { return 3; }
        if dispatch(e2) != 42i64 { return 4; }
        if e3.as_i56() != 99i64 { return 5; }
    }
    return 0;
}
