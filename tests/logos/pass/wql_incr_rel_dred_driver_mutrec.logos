// THE DRed EPOCH DRIVER AT N = 2 — THE MUTUALLY RECURSIVE RETRACTION WITNESS.
//
// ── THE HOLE THIS CLOSES ───────────────────────────────────────────────────
// `pass/wql_incr_rel_dred_driver.logos` is the driver's only caller and EVERY
// cell in it is N = 1 (a single-member SCC). `__wql_<q>_scc<c>_dred` is emitted
// from per-member loops — `__tt<i>` / `__odv<i>` / `__rmv<i>`, the `3m+2` latch
// slots, and the "only the SELECTED member is folded, the co-members are
// MAINTAINED" rule — and NONE of that had a retraction caller at N >= 2.
// `pass/wql_incr_rel_dred_mutrec_full.logos` drives the four PHASES at N = 2
// but assembles the sequence ITSELF, in the fixture: the argument shapes, the
// `__b0` capture point, the direction `__edb` moves and the latch layout are
// decisions that file makes rather than reads. This one asks the EMITTED
// driver.
//
// ⚠ `odd` AND `even` SHARE A ROW TYPE, so a driver that drove the FIRST member
// where it meant the SELECTED one, or that swapped `__tt0`/`__tt1`, TYPECHECKS
// and answers with the two relations exchanged. That is the shape
// `fail/wql_incr_mutrec_no_retract_even.logos` names, and it is why `check`
// asks each member BY NAME rather than checking the answer alone.
//
// ── THE ORACLE ────────────────────────────────────────────────────────────
// `parity_odd` / `parity_even`: a from-scratch alternating closure over the
// survivor edge set. No delta, no shadow set, no SCC, no phase, no epoch. The
// group answer is checked against `groups_of(parity_odd(...))`, so it does not
// compare the emitter with itself.
//
// ── THE SIX LATCH SLOTS ───────────────────────────────────────────────────
// Three per member. Checked two ways. FIRST, and this is new as of 2026-08-09,
// |OD_m| ABSOLUTELY against `taint_od` — an independent closed form, see its
// definition for why the sums could not give it and why an over-deletion was
// invisible here before. SECOND, the two SUM identities: |OD_m| + |S_m| == |T_m|
// (the member's PREVIOUS total) and |S_m| + |RD_m| == |closure(PRES)_m| (its NEW
// one). The two members' totals differ in size on every graph below, so a triple
// written into the other member's slots fails them.
//
// ── CONTROLS, MEASURED (archives dropped, whole stdlib rebuilt for each) ───
// ⚠ CELLS B, C AND D ARE ASSERTED AGAINST THE ORACLE BUT ARE REACHED BY NO
// CONTROL — they are extra shapes, not separately pinned, and this file says so
// rather than implying a coverage it does not have.
//  • `_od` RESTRICTED TO ITS BASE BODIES (phase 1a's existing-rel⋈DE seed term
//    deleted in `emit_scc_od_fns`: skip every body with a non-empty
//    `body_scc_occs` in the `runs` loop) → **exit 54** — cell A, code 14: the
//    odd member's ABSOLUTE |OD| disagrees with `taint_od`. ⚠ THIS CONTROL USED
//    TO LAND AT **exit 51** (code 11, the odd member's |S| + |RD| against the
//    from-scratch parity closure); the absolute check now catches the same
//    defect strictly EARLIER, which is why the recorded value moved. Re-measured
//    2026-08-09, not carried over. In both cases the driver had run all four
//    phases, both folds and the commit, and returned `Ok` — the catch is on the
//    reported numbers, never on an error path.
//  • MAXIMAL OVER-DELETION — `_od`'s promote ALSO pushes the whole previous
//    total `__rd_<m>` into `__od_<m>`, so OD_m = T_m, |S_m| = 0, and phase 3
//    re-derives the entire relation → **exit 244** — cell F, code 14.
//    ⚠ THIS IS THE CONTROL THE FILE EXISTED WITHOUT. Measured in the SAME build
//    with only the five absolute checks commented out, the fixture is **GREEN**:
//    both sum identities, all four answer checks and the `__edb` witness pass,
//    because the triple moves as (|OD|+k, |S|−k, |RD|+k) and the identities are
//    invariant under exactly that. The answers are CORRECT throughout — DRed
//    that over-deletes and re-derives is still sound, only wasteful — so no
//    oracle on the ANSWER can see it either. Only the absolute |OD| does.
//    ⚠ AND IT NEEDED CELL F TO BITE: aimed at cells A-D alone this same control
//    left the file GREEN, because on A-D the retraction wipes the SCC (OD_m ==
//    T_m already) and there is no room to over-delete. So does a second
//    over-deleting perturbation (running `_odp`'s base bodies over PRES): green
//    on A-D, while reding four sibling fixtures in the same build. Two controls
//    that changed nothing where they were aimed — cell F is the repair.
//  • `DE ⊆ __edb` WEAKENED TO A NO-OP in the driver → **exit 200** — block E:
//    `odd(1,4)` is DERIVED (the odd-length walk 1→2→3→4) and was never an
//    INPUT, `OD ⊆ T` stays true, `_cpt` sees nothing, and the retraction runs
//    to `Ok` over a fact no caller ever inserted. The N = 1 form of the same
//    control is `wql_incr_rel_dred_driver.logos`'s exit 207.
//    ⚠ NOT RE-MEASURED in the 2026-08-09 round, and stated rather than assumed
//    silently: this control does not change any member's OD, so checks 14/15
//    cannot fire on cells A-D ahead of it and block E still returns 200 — but
//    that is an argument, not a measurement, unlike every other number here.
//
// ⚠ NOT A WORD ABOUT COST AND NO CLOCK ANYWHERE — the box is shared.
package test;

use logos.std.wql.wql;
use logos.std.wql.el;
use logos.lang.result;
use logos.mem.collections.vec;

struct E { pub a: i64, pub b: i64 }

pub deem oddq(es: &[E]) {
    rel odd(a: i64, b: i64) {
        from es e select (e.a, e.b);
        from even v join es e on v.b == e.a select (v.a, e.b);
    }
    rel even(a: i64, b: i64) {
        from odd o join es e on o.b == e.a select (o.a, e.b);
    }
    from odd p group by p.a aggregate c = count() select (key, c)
}

fn pair_uniq(p: &mut Vec<(i64, i64)>, a: i64, b: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < p.len() {
        let c: (i64, i64) = p.get(i);
        if c.0 == a && c.1 == b { return false; }
        i = i + 1i64;
    }
    p.push((a, b));
    return true;
}

fn pair_has(p: &Vec<(i64, i64)>, a: i64, b: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < p.len() {
        let c: (i64, i64) = p.get(i);
        if c.0 == a && c.1 == b { return true; }
        i = i + 1i64;
    }
    return false;
}

// ── THE ORACLE: parity closure, from scratch, no delta and no phase.
// odd  = { (a,b) : some walk a→b of ODD length }
// even = { (a,b) : some walk a→b of EVEN length >= 2 }
fn parity_odd(es: &[E]) -> Vec<(i64, i64)> {
    let mut o: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut v: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut i: i64 = 0i64;
    while i < es.len() { pair_uniq(&mut o, es[i].a, es[i].b); i = i + 1i64; }
    let mut grew: bool = true;
    while grew {
        grew = false;
        let mut k: i64 = 0i64;
        while k < o.len() {
            let pr: (i64, i64) = o.get(k);
            let mut j: i64 = 0i64;
            while j < es.len() {
                if pr.1 == es[j].a { if pair_uniq(&mut v, pr.0, es[j].b) { grew = true; } }
                j = j + 1i64;
            }
            k = k + 1i64;
        }
        let mut k2: i64 = 0i64;
        while k2 < v.len() {
            let pr2: (i64, i64) = v.get(k2);
            let mut j2: i64 = 0i64;
            while j2 < es.len() {
                if pr2.1 == es[j2].a { if pair_uniq(&mut o, pr2.0, es[j2].b) { grew = true; } }
                j2 = j2 + 1i64;
            }
            k2 = k2 + 1i64;
        }
    }
    return o;
}

fn parity_even(es: &[E]) -> Vec<(i64, i64)> {
    let mut o: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut v: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut i: i64 = 0i64;
    while i < es.len() { pair_uniq(&mut o, es[i].a, es[i].b); i = i + 1i64; }
    let mut grew: bool = true;
    while grew {
        grew = false;
        let mut k: i64 = 0i64;
        while k < o.len() {
            let pr: (i64, i64) = o.get(k);
            let mut j: i64 = 0i64;
            while j < es.len() {
                if pr.1 == es[j].a { if pair_uniq(&mut v, pr.0, es[j].b) { grew = true; } }
                j = j + 1i64;
            }
            k = k + 1i64;
        }
        let mut k2: i64 = 0i64;
        while k2 < v.len() {
            let pr2: (i64, i64) = v.get(k2);
            let mut j2: i64 = 0i64;
            while j2 < es.len() {
                if pr2.1 == es[j2].a { if pair_uniq(&mut o, pr2.0, es[j2].b) { grew = true; } }
                j2 = j2 + 1i64;
            }
            k2 = k2 + 1i64;
        }
    }
    return v;
}

fn same_set(x: &Vec<(i64, i64)>, y: &Vec<(i64, i64)>) -> bool {
    if x.len() != y.len() { return false; }
    let mut i: i64 = 0i64;
    while i < x.len() {
        let c: (i64, i64) = x.get(i);
        if !pair_has(y, c.0, c.1) { return false; }
        i = i + 1i64;
    }
    let mut j: i64 = 0i64;
    while j < y.len() {
        let c2: (i64, i64) = y.get(j);
        if !pair_has(x, c2.0, c2.1) { return false; }
        j = j + 1i64;
    }
    return true;
}

fn groups_of(cl: &Vec<(i64, i64)>) -> Vec<(i64, i64)> {
    let mut ks: Vec<i64> = vec_new::<i64>();
    let mut cs: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < cl.len() {
        let p: (i64, i64) = cl.get(i);
        let mut f: i64 = -1i64;
        let mut j: i64 = 0i64;
        while j < ks.len() { if ks.get(j) == p.0 { f = j; } j = j + 1i64; }
        if f < 0i64 { ks.push(p.0); cs.push(1i64); }
        else { cs.set(f, cs.get(f) + 1i64); }
        i = i + 1i64;
    }
    let mut o: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut k: i64 = 0i64;
    while k < ks.len() { o.push((ks.get(k), cs.get(k))); k = k + 1i64; }
    return o;
}

fn ed(a: i64, b: i64) -> E { return E { a: a, b: b }; }

fn node_uniq(v: &mut Vec<i64>, x: i64) {
    let mut i: i64 = 0i64;
    while i < v.len() { if v.get(i) == x { return; } i = i + 1i64; }
    v.push(x);
}

fn edge_has(v: &[E], a: i64, b: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < v.len() {
        let e: E = v[i];
        if e.a == a && e.b == b { return true; }
        i = i + 1i64;
    }
    return false;
}

fn survivors(all: &[E], de: &[E]) -> Vec<E> {
    let mut out: Vec<E> = vec_new::<E>();
    let mut i: i64 = 0i64;
    while i < all.len() {
        let e: E = all[i];
        if !edge_has(de, e.a, e.b) { out.push(e); }
        i = i + 1i64;
    }
    return out;
}

// ── THE SECOND ORACLE — |OD_m| ABSOLUTELY, AND WHY THE SUMS COULD NOT GIVE IT.
// The four sum identities below pin (|OD_m|, |S_m|, |RD_m|) with TWO equations
// in THREE unknowns per member, so one degree of freedom survives — and it is
// exactly the over-deletion axis. DRed over-deletes k extra rows in phase 1 and
// phase 3 re-derives them in phase 2/3, moving the triple
//     (|OD|, |S|, |RD|)  →  (|OD|+k, |S|-k, |RD|+k)
// under which BOTH `|OD|+|S| == |T|` and `|S|+|RD| == |closure(PRES)|` are
// INVARIANT, every answer stays correct, and `OD ⊆ T` still holds so `_cpt`
// never refuses. Nothing in this file could see it. An ABSOLUTE |OD_m| against
// an independent closed form is the only sensor for that class, and this is it.
//
// ⚠ THE STANDING CONSTRAINT ON THE METHOD: the interpreter's `dred` refused
// every SCC — its recursive-incremental entry point refused any register set
// with more than one member — so the static
// N-member DRed has never had and can never have a witness from the other tier.
// Its only possible oracle is an independent closed form, and this one shares no
// code, no delta, no shadow set, no seed/propagate split and no fixpoint over a
// REL with the emitter: it is reachability in the product of the graph with the
// two-bit automaton (PARITY, "have I used a deleted edge yet"), the parity cross
// of the form `deem_dred_od_rw_split.logos`'s `automaton_od` uses at N = 1.
//
// WHY IT IS THE SAME SET THE ENGINE COMPUTES — the split-at-the-LAST-deleted-
// edge argument, which is the second closed form and is what makes the automaton
// legitimate rather than merely plausible. `_od` seeds with edb := DE and the
// in-SCC atoms := T, and `_odp` then extends with edb := PRES. So the engine's
// OD_m is exactly {walks of parity m = (arbitrary prefix over ALL) · (one
// deleted edge) · (a suffix of survivors)}. Any walk holding at least one
// deleted edge decomposes that way at its LAST deleted edge, and every walk of
// that form holds one — so "tainted reachability at parity m" and the engine's
// OD_m are the same set. A wrong theorem is discriminated: `closure(ALL) ∖
// closure(PRES)` disagrees on cells A and C below.
fn taint_od(all: &[E], de: &[E], par: i64) -> Vec<(i64, i64)> {
    let mut nodes: Vec<i64> = vec_new::<i64>();
    let mut n0: i64 = 0i64;
    while n0 < all.len() {
        node_uniq(&mut nodes, all[n0].a);
        node_uniq(&mut nodes, all[n0].b);
        n0 = n0 + 1i64;
    }
    let mut od: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut xi: i64 = 0i64;
    while xi < nodes.len() {
        let x: i64 = nodes.get(xi);
        // `reach` holds (node, code) with code = parity*2 + taint. The start
        // state is (x, parity 0, taint 0) and is NOT entered, so a zero-length
        // walk is never over-deleted.
        let mut reach: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
        let mut e0: i64 = 0i64;
        while e0 < all.len() {
            let e: E = all[e0];
            if e.a == x {
                let d: i64 = if edge_has(de, e.a, e.b) { 1i64 } else { 0i64 };
                pair_uniq(&mut reach, e.b, 2i64 + d);
            }
            e0 = e0 + 1i64;
        }
        let mut grew: bool = true;
        while grew {
            grew = false;
            let mut k: i64 = 0i64;
            while k < reach.len() {
                let s: (i64, i64) = reach.get(k);
                let sp: i64 = s.1 / 2i64;
                let st: i64 = s.1 - sp * 2i64;
                let mut j: i64 = 0i64;
                while j < all.len() {
                    let e2: E = all[j];
                    if e2.a == s.0 {
                        let d2: i64 = if edge_has(de, e2.a, e2.b) { 1i64 } else { 0i64 };
                        let np: i64 = 1i64 - sp;
                        let nt: i64 = if st == 1i64 { 1i64 } else { d2 };
                        if pair_uniq(&mut reach, e2.b, np * 2i64 + nt) { grew = true; }
                    }
                    j = j + 1i64;
                }
                k = k + 1i64;
            }
        }
        let mut zi: i64 = 0i64;
        while zi < nodes.len() {
            let z: i64 = nodes.get(zi);
            if pair_has(&reach, z, par * 2i64 + 1i64) { pair_uniq(&mut od, x, z); }
            zi = zi + 1i64;
        }
        xi = xi + 1i64;
    }
    return od;
}

fn odd_copy(h: &OddqIncr) -> Vec<(i64, i64)> {
    let mut o: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut i: i64 = 0i64;
    while i < h.__tot_odd.len() { let p: (i64, i64) = h.__tot_odd.get(i); o.push((p.0, p.1)); i = i + 1i64; }
    return o;
}

fn even_copy(h: &OddqIncr) -> Vec<(i64, i64)> {
    let mut o: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut i: i64 = 0i64;
    while i < h.__tot_even.len() { let p: (i64, i64) = h.__tot_even.get(i); o.push((p.0, p.1)); i = i + 1i64; }
    return o;
}

fn edb_copy(h: &OddqIncr) -> Vec<E> {
    let mut o: Vec<E> = vec_new::<E>();
    let mut i: i64 = 0i64;
    while i < h.__edb.len() { let e: E = h.__edb.get(i); o.push(ed(e.a, e.b)); i = i + 1i64; }
    return o;
}

fn edges_same(x: &[E], y: &[E]) -> bool {
    if x.len() != y.len() { return false; }
    let mut i: i64 = 0i64;
    while i < x.len() { let e: E = x[i]; if !edge_has(y, e.a, e.b) { return false; } i = i + 1i64; }
    let mut j: i64 = 0i64;
    while j < y.len() { let e2: E = y[j]; if !edge_has(x, e2.a, e2.b) { return false; } j = j + 1i64; }
    return true;
}

// ⚠ BOTH MEMBERS ARE CHECKED SEPARATELY. `odd` and `even` share a row type, so
// a driver that drove the FIRST member where it meant the SELECTED one — or
// that swapped `__tt0`/`__tt1` — typechecks and answers with the two relations
// exchanged. Only a check that asks each by name can see that.
fn check(h: &OddqIncr, cur: &[E]) -> i32 {
    let wo: Vec<(i64, i64)> = parity_odd(cur);
    let we: Vec<(i64, i64)> = parity_even(cur);
    let snap: Vec<(i64, i64)> = match oddq_snapshot(h) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; }
    };
    let want: Vec<(i64, i64)> = groups_of(&wo);
    if !same_set(&snap, &want) { return 2i32; }
    let go: Vec<(i64, i64)> = odd_copy(h);
    if !same_set(&go, &wo) { return 3i32; }
    let ge: Vec<(i64, i64)> = even_copy(h);
    if !same_set(&ge, &we) { return 4i32; }
    let acc: Vec<E> = edb_copy(h);
    if !edges_same(acc.as_slice(), cur) { return 5i32; }
    return 0i32;
}

fn ins(h: &mut OddqIncr, cur: &mut Vec<E>, de: &[E]) -> i32 {
    match oddq_epoch(h, de) {
        Result::Ok(_n) => { } Result::Err(_e) => { return 9i32; }
    }
    let mut i: i64 = 0i64;
    while i < de.len() {
        let e: E = de[i];
        if !edge_has(cur.as_slice(), e.a, e.b) { cur.push(ed(e.a, e.b)); }
        i = i + 1i64;
    }
    return check(h, cur.as_slice());
}

fn ret(h: &mut OddqIncr, cur: &mut Vec<E>, de: &[E]) -> i32 {
    // PRE-CALL oracles for BOTH members' latch triples.
    let t_odd: Vec<(i64, i64)> = parity_odd(cur.as_slice());
    let t_even: Vec<(i64, i64)> = parity_even(cur.as_slice());
    let pres: Vec<E> = survivors(cur.as_slice(), de);
    let p_odd: Vec<(i64, i64)> = parity_odd(pres.as_slice());
    let p_even: Vec<(i64, i64)> = parity_even(pres.as_slice());
    // The ABSOLUTE per-member over-delete sets — see `taint_od`. Taken BEFORE
    // the call, over the PREVIOUS accumulated edge set, because `cur` is
    // rewritten to the survivors below.
    let od_odd:  Vec<(i64, i64)> = taint_od(cur.as_slice(), de, 1i64);
    let od_even: Vec<(i64, i64)> = taint_od(cur.as_slice(), de, 0i64);
    match __wql_oddq_scc0_dred(h, de) {
        Result::Ok(_n) => { } Result::Err(_e) => { return 8i32; }
    }
    let nc: Vec<E> = survivors(cur.as_slice(), de);
    cur.clear();
    let mut ci: i64 = 0i64;
    while ci < nc.len() { let e: E = nc.get(ci); cur.push(ed(e.a, e.b)); ci = ci + 1i64; }
    // ⚠ SIX LATCH SLOTS, NOT THREE — three per member. Their SUM identities are
    // the only member-indexed assertion available without an OD oracle:
    //   |OD_m| + |S_m| == |T_m| (the PREVIOUS total of member m)
    //   |S_m|  + |RD_m| == |closure(PRES)_m| (the NEW total of member m)
    // A driver that wrote one member's triple into the other's slots fails
    // these the moment the two members' totals differ in size — which they do
    // on every graph below.
    if h.__lat.len() != 6i64 { return 7i32; }
    if h.__lat.get(2i64) == 0i64 - 1i64 { return 6i32; }
    if h.__lat.get(5i64) == 0i64 - 1i64 { return 16i32; }
    let l0: i64 = h.__lat.get(0i64); let l1: i64 = h.__lat.get(1i64); let l2: i64 = h.__lat.get(2i64);
    let l3: i64 = h.__lat.get(3i64); let l4: i64 = h.__lat.get(4i64); let l5: i64 = h.__lat.get(5i64);
    // ⚠ ABSOLUTE FIRST, SUMS SECOND. The absolute claim is strictly stronger and
    // it is the one the sums cannot make; a tier that disagrees with the closed
    // form should be named as WRONG here, not as merely unbalanced downstream.
    if l0 != od_odd.len()  { return 14i32; }
    if l3 != od_even.len() { return 15i32; }
    if l0 + l1 != t_odd.len()  { return 10i32; }
    if l1 + l2 != p_odd.len()  { return 11i32; }
    if l3 + l4 != t_even.len() { return 12i32; }
    if l4 + l5 != p_even.len() { return 13i32; }
    return check(h, cur.as_slice());
}

fn main() -> i32 {
    // ══ A: A 3-CYCLE. odd and even are both non-empty and DIFFER in size, so a
    // swapped member is visible.
    let mut h: OddqIncr = oddq_incremental();
    let mut c: Vec<E> = vec_new::<E>();
    let mut d: Vec<E> = vec_new::<E>();
    d.push(ed(1i64, 2i64)); d.push(ed(2i64, 3i64)); d.push(ed(3i64, 1i64));
    let r: i32 = ins(&mut h, &mut c, d.as_slice());
    if r != 0i32 { return 20i32 + r; }

    // Retract the closing edge: the cycle opens and BOTH members shrink.
    let mut r1: Vec<E> = vec_new::<E>();
    r1.push(ed(3i64, 1i64));
    let v1: i32 = ret(&mut h, &mut c, r1.as_slice());
    if v1 != 0i32 { return 40i32 + v1; }

    // ⚠ AND NOW INSERT AGAIN — the `__edb` witness across epochs.
    let mut d2: Vec<E> = vec_new::<E>();
    d2.push(ed(3i64, 4i64));
    let v2: i32 = ins(&mut h, &mut c, d2.as_slice());
    if v2 != 0i32 { return 60i32 + v2; }

    // ══ B: RE-CLOSE THE CYCLE, then retract a MID edge (the whole SCC moves).
    let mut d3: Vec<E> = vec_new::<E>();
    d3.push(ed(4i64, 1i64));
    let v3: i32 = ins(&mut h, &mut c, d3.as_slice());
    if v3 != 0i32 { return 80i32 + v3; }
    let mut r2: Vec<E> = vec_new::<E>();
    r2.push(ed(2i64, 3i64));
    let v4: i32 = ret(&mut h, &mut c, r2.as_slice());
    if v4 != 0i32 { return 100i32 + v4; }

    // ══ C: A SECOND HANDLE — a 2-cycle, where `even` contains reflexive pairs
    // the transitive closure fixture cannot produce.
    let mut h2: OddqIncr = oddq_incremental();
    let mut c2: Vec<E> = vec_new::<E>();
    let mut e2: Vec<E> = vec_new::<E>();
    e2.push(ed(1i64, 2i64)); e2.push(ed(2i64, 1i64)); e2.push(ed(2i64, 5i64));
    let v5: i32 = ins(&mut h2, &mut c2, e2.as_slice());
    if v5 != 0i32 { return 120i32 + v5; }
    let mut r3: Vec<E> = vec_new::<E>();
    r3.push(ed(2i64, 1i64));
    let v6: i32 = ret(&mut h2, &mut c2, r3.as_slice());
    if v6 != 0i32 { return 140i32 + v6; }

    // ══ D: TOTAL WIPE of the second handle, both members must empty.
    let mut r4: Vec<E> = vec_new::<E>();
    r4.push(ed(1i64, 2i64)); r4.push(ed(2i64, 5i64));
    let v7: i32 = ret(&mut h2, &mut c2, r4.as_slice());
    if v7 != 0i32 { return 160i32 + v7; }
    if h2.__tot_odd.len()  != 0i64 { return 179i32; }
    if h2.__tot_even.len() != 0i64 { return 178i32; }

    // ══ E: DE ⊆ EDB over a MUTUALLY RECURSIVE SCC — a pair that is DERIVED in
    // `odd` (1→2→3→4 gives odd(1,4)) but was never an INPUT.
    let mut h3: OddqIncr = oddq_incremental();
    let mut c3: Vec<E> = vec_new::<E>();
    let mut e3: Vec<E> = vec_new::<E>();
    e3.push(ed(1i64, 2i64)); e3.push(ed(2i64, 3i64)); e3.push(ed(3i64, 4i64));
    let v8: i32 = ins(&mut h3, &mut c3, e3.as_slice());
    if v8 != 0i32 { return 180i32 + v8; }
    let mut bad: Vec<E> = vec_new::<E>();
    bad.push(ed(1i64, 4i64));
    match __wql_oddq_scc0_dred(&mut h3, bad.as_slice()) {
        Result::Ok(_n) => { return 200i32; }
        Result::Err(e) => {
            match e {
                ElError::RetractAbsent => { }
                _ => { return 201i32; }
            }
        }
    }
    let v9: i32 = check(&h3, c3.as_slice());
    if v9 != 0i32 { return 202i32; }

    // ══ F: A DIAMOND — THE ONLY CELL HERE WHERE `OD` IS A STRICT SUBSET OF `T`,
    // AND THEREFORE THE ONLY ONE ON WHICH AN OVER-DELETION IS REPRESENTABLE AT
    // ALL. ⚠ MEASURED, NOT ASSUMED: on cells A-D every retraction WIPES the SCC
    // (each is a cycle in which every derived row rides the deleted edge on some
    // longer walk of its parity), so `OD_m == T_m` and `|S_m| == 0` hold there
    // by the shape of the graph. Two different over-deleting perturbations of
    // `emit_scc_od_fns` were measured against A-D and BOTH left this file GREEN
    // while reding four sibling fixtures — a control that changes nothing where
    // it was aimed. `OD ⊊ T` is what the absolute check needs to have teeth, and
    // no cell above supplies it.
    //
    // 1→2, 1→3, 2→4, 3→4; retract 2→4.
    //   T_odd  = {12,13,24,34}        T_even = {14}
    //   OD_odd = {24}      (|OD| = 1 < |T| = 4, so |S_odd| = 3)
    //   OD_even= {14}      and `even` RE-DERIVES it over 1→3→4, so |RD_even| = 1
    // This is the DRed re-derivation in its smallest honest form: a row is
    // over-deleted, survives on an independent support, and comes back.
    let mut h4: OddqIncr = oddq_incremental();
    let mut c4: Vec<E> = vec_new::<E>();
    let mut e4: Vec<E> = vec_new::<E>();
    e4.push(ed(1i64, 2i64)); e4.push(ed(1i64, 3i64));
    e4.push(ed(2i64, 4i64)); e4.push(ed(3i64, 4i64));
    let va: i32 = ins(&mut h4, &mut c4, e4.as_slice());
    if va != 0i32 { return 210i32 + va; }
    let mut r5: Vec<E> = vec_new::<E>();
    r5.push(ed(2i64, 4i64));
    let vb: i32 = ret(&mut h4, &mut c4, r5.as_slice());
    if vb != 0i32 { return 230i32 + vb; }
    // HAND CONSTANTS, pinning the closed form the way witness 1 pins witness 2
    // in `deem_dred_od_rw_split.logos`: if `taint_od` and the engine were wrong
    // together, these three numbers would still catch it.
    if h4.__lat.get(0i64) != 1i64 { return 250i32; }   // |OD_odd|
    if h4.__lat.get(1i64) != 3i64 { return 251i32; }   // |S_odd|
    if h4.__lat.get(5i64) != 1i64 { return 252i32; }   // |RD_even| — the re-derive

    return 0i32;
}
