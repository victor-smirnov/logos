// THE ADMIT TWIN that stops the per-path merge from becoming an APPENDING
// merge. ONE field is written twice: `w.a = &inner` then `w.a = &o`. The second
// write REPLACES the first on the SAME path, so `inner` is no longer among w's
// sources and the program is legal.
//
// An appending merge — the obvious "just don't overwrite" repair, and strictly
// worse than the replace it would have replaced — keeps `inner` and refuses
// here. That is the direction a two-field fixture cannot see, so it is pinned
// separately: `fail/bc_dropck_field_two_paths_fail` demands that DIFFERENT
// paths merge, and this one demands that the SAME path does not.
package bc_dropck_field_same_path_rewrite_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
fn pr(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
struct W<'a> { a: &'a i64, b: &'a i64 }
impl<'a> Drop for W<'a> { fn drop(self: &mut Self) { let v: i64 = *self.a; if v < 0i64 { return; } } }
fn main() -> i32 {
    let o: i64 = 5i64;
    // ⚠ `inner` IS DECLARED BEFORE `w` ON PURPOSE, and rustc is why: `W<'a>` has a
    // Drop that reads `self.a`, so dropck requires everything ever stored in `a`
    // to outlive `w` — reassigning `w.a = &o` before `inner` dies does NOT release
    // it, because the requirement is on the REGION `'a`, not on the last value.
    // With `inner` inside the block rustc 1.98.1 refuses with error[E0597] "`inner`
    // does not live long enough" (MEASURED 2026-09-21). Declared here, `w` drops
    // first and `inner` outlives it, and the property this fixture pins — that a
    // rewrite of the SAME path does not append a second region — is unchanged.
    let inner: i64 = 7i64;
    let mut w: W = W { a: &o, b: &o };
    {
        w.a = &inner;
        w.a = &o;
    }
    pr("%ld\n", *w.a + *w.b);
    return 0i32;
}
