package relany;
// any_object_ptr (RelAny) PROOF: a SELF-RELATIVE (Hermes) pointer to a TYPE-
// TAGGED object, dispatching through the EXISTING Hermes1 tag tables unchanged.
// The object lives in a never-move arena with a vlen tag header (write_tag); the
// RelAny field stores `target − &field` (RelOffset descriptor) and materialises
// to *const u8, which the standard `&tagged<TS> Trait` coercion dispatches on.
use logos.lang.ptr;
use logos.mem.hermes.tag_system;
extern fn malloc(size: i64) -> *mut u8;

// ── the any_object_ptr type: self-relative, materialises to *const u8 ──────────
#[rel_ptr] struct RelAny { _o: i64 }

// ── Hermes never-move arena ──────────────────────────────────────────────────
struct Arena { base: *mut u8, used: i64 }
unsafe fn arena_new(cap: i64) -> Arena { return Arena { base: malloc(cap), used: 0i64 }; }
unsafe fn arena_alloc(a: *mut Arena, bytes: i64) -> *mut u8 {
    let aligned: i64 = (a.used + 7i64) / 8i64 * 8i64;
    let p: *mut u8 = a.base.byte_add(aligned);     // never moves
    a.used = aligned + bytes;
    return p;
}
// allocate a tagged object: [1B tag][object], return obj ptr (codes < 223 → 1B).
unsafe fn arena_alloc_tagged(a: *mut Arena, size: i64, code: u64) -> *mut u8 {
    let p: *mut u8 = arena_alloc(a, 8i64 + size);  // 8B header room, keep 8-align
    let obj: *mut u8 = p.byte_add(8i64);
    write_tag(obj, code);                          // writes vlen header ending at obj[-1]
    return obj;
}

// ── two tagged Hermes object types ───────────────────────────────────────────
#[tag_dispatch(DataTypeTagSystem)] trait Checksum { unsafe fn checksum(self: *const Self) -> i32; }
#[type_code=151] #[datatype] struct Point { x: i32, y: i32 }
#[type_code=152] #[datatype] struct Color { r: u8, g: u8, b: u8, a: u8 }
impl Checksum for Point { pub unsafe fn checksum(self: *const Point) -> i32 { return self.x + self.y; } }
impl Checksum for Color { pub unsafe fn checksum(self: *const Color) -> i32 { return self.r as i32 + self.g as i32 + self.b as i32 + self.a as i32; } }

// ── a Hermes container holding a self-relative any_object_ptr (pin: in arena) ──
struct Holder { any: RelAny }

unsafe fn dispatch(o: *const u8) -> i32 {
    let t: &tagged<DataTypeTagSystem> Checksum = o;   // SAME dispatcher, self-resolved obj
    return t.checksum();
}

unsafe fn main() -> i32 {
    let mut ar: Arena = arena_new(4096i64);
    // Holder lives IN the arena (pin); point it at a Point, self-relatively.
    let h: *mut Holder = arena_alloc(&mut ar as *mut Arena, 8i64) as *mut Holder;
    let p_obj: *mut u8 = arena_alloc_tagged(&mut ar as *mut Arena, 8i64, type_code_of::<Point>());
    let p: *mut Point = p_obj as *mut Point;  p.x = 10i32;  p.y = 32i32;
    h.any = p_obj as *const u8;               // lower: store (p_obj − &h.any)

    let o1: *const u8 = h.any;                // materialize: &h.any + off = p_obj
    if dispatch(o1) != 42i32 { return 1i32; } // dispatch via self-relative tagged ptr

    // re-point the SAME field at a Color — dispatch resolves the new type by tag.
    let c_obj: *mut u8 = arena_alloc_tagged(&mut ar as *mut Arena, 4i64, type_code_of::<Color>());
    let c: *mut Color = c_obj as *mut Color;  c.r = 1u8; c.g = 2u8; c.b = 3u8; c.a = 4u8;
    h.any = c_obj as *const u8;
    let o2: *const u8 = h.any;
    if dispatch(o2) != 10i32 { return 2i32; }
    return 0i32;
}
