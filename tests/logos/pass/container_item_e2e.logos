// ADR 0020 wave-0 M4 — the FULL loop in one file: container item → fact doc
// → Canon verdicts → generated scan projection (source trait + materializer +
// impl rel bind) → a STATIC deem query over a live container returns correct
// rows. The backing here is a minimal inline Vec-backed VecCtr honoring the
// wave-0 scan contract (count/get) + push; the real pkd-backed Vector-v0
// lives in conuco/memoria (ctr_vec_deem lforge test). MapCtr is intentionally
// UNDEFINED: an ordered_map decl lowers to its CFG const + CtrClass
// alias only (ADR 0021 Phase 4b) — its backing resolves on no decl-site
// path (pins Map's parse+facts+verdicts+CFG-surface contract).
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lcm.canon.metaclass;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.sync;
use logos.std.wql.wql;
use logos.lcm.canon.container_item;
use logos.mem.collections.vec;

pub struct VecCtr<T> { buf: Vec<T> }

impl<T> VecCtr<T> {
    pub static fn new() -> VecCtr<T> {
        return VecCtr { buf: vec_new::<T>() };
    }
    pub fn count(self: &VecCtr<T>) -> i64 { return self.buf.len(); }
    // Bitwise-copy read (Vec::get's own mechanics) so the backing stays
    // UNBOUNDED — the canonical `container Vector<T> for VecCtr<T>` surface
    // is exercised verbatim; a bounded backing is the conuco fixture's job.
    pub fn get(self: &VecCtr<T>, i: i64) -> T {
        unsafe { return *self.buf.at_const(i); }
    }
    pub fn push(self: &mut VecCtr<T>, v: T) { self.buf.push(v); }
}

pub container Vector<T> { 
    kind vector; 
    entry { elem: T } 
    measure count; 
}

pub container Map<K, V> { 
    kind ordered_map; 
    entry { key: K, val: V } 
    measure count; 
    measure max(key); 
}

// A static deem query bound to the CLASS: the family it compiles against is
// generated for `Vector<u64>`, and the query names neither it nor an element
// type.
pub deem big<V>(v: Vector<V>) {
    from v e where e.val > 10 select (e.pos, e.val)
}

// The SAME family, filtered on the ORDINAL instead of the element. `pos` is a
// declared column of the positional hub rel and the family declares
// `op row.pos ge = __ctr_from_…  exact`, so this one lands by `seek` and the
// filter is retired — while `big` above, filtering on a column no operation
// covers, is a DECLARED scan. Two queries, one container, and the difference is
// visible only in the plan and the emitted call: both return the right rows.
// The access path of both is asserted by tests/logos/ctr_access_path_gate.sh.
pub deem tail<V>(v: Vector<V>) {
    from v e where e.pos >= 2 select (e.pos, e.val)
}

fn main() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();
    let snap: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    let c = create_ctr::<typeof(Vector::<u64>)>(&snap, 1u64);
    c.append(5u64);
    c.append(25u64);
    c.append(7u64);
    c.append(42u64);
    let rows: Vec<(i64, u64)> = match big(&c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    if rows.len() != 2i64 { return 2i32; }
    // Set semantics — assert membership, not order.
    let mut seen25: bool = false;
    let mut seen42: bool = false;
    let mut i: i64 = 0i64;
    while i < rows.len() {
        let r: (i64, u64) = rows.get(i);
        if r.0 == 1i64 && r.1 == 25u64 { seen25 = true; }
        else if r.0 == 3i64 && r.1 == 42u64 { seen42 = true; }
        else { return 3i32; }
        i = i + 1i64;
    }
    if !seen25 { return 4i32; }
    if !seen42 { return 5i32; }

    // The POSITIONAL narrowing over the same container: the suffix from
    // position 2, in position order (a vector HAS one, so order is asserted).
    let t: Vec<(i64, u64)> = match tail(&c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 6i32; } };
    if t.len() != 2i64 { return 7i32; }
    if t.get(0i64).0 != 2i64 || t.get(0i64).1 != 7u64  { return 8i32; }
    if t.get(1i64).0 != 3i64 || t.get(1i64).1 != 42u64 { return 9i32; }
    return 0i32;
}
