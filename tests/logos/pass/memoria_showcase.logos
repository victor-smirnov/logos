// Showcase: PMap<K, V> — the typed, safe, object-oriented ordered map.
// No `unsafe`, no raw pointers at the call site; one compiled B+tree engine
// underneath serves every key/value type.
package memoria_showcase;

use logos.std.data.memoria.pmap;
use logos.lang.option;
use logos.lang.iter;
use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.std.io;

fn line(s: str) { println(s); }

fn main() -> i32 {
    line("== Memoria PMap<K, V> — typed, safe, ordered ==");
    line("");

    // [1] PMap<u64, i64>
    line("[1] PMap<u64, i64>");
    let mut m: PMap<u64, i64> = PMap::<u64, i64>::new();
    m.insert(3u64, 300i64);
    m.insert(1u64, 100i64);
    m.insert(4u64, 400i64);
    m.insert(2u64, 200i64);
    m.insert(5u64, 500i64);
    print("    for (k,v) in m.iter():");
    for (k, v) in m.iter() {
        let s: String = format::<u64, i64>("  {}=>{}", k, v);
        print_string(&s);
    }
    line("");
    match m.get(2u64) {
        Option::Some(v) => { let s: String = format::<i64>("    m.get(2) = Some({})", v); println_string(&s); }
        Option::None    => { line("    m.get(2) = None"); }
    }
    let s1: String = format::<bool, u64>("    m.contains(9)={}  m.len()={}", m.contains(9u64), m.len());
    println_string(&s1);
    m.remove(3u64);
    let s2: String = format::<bool, u64>("    after remove(3): contains(3)={}  len()={}", m.contains(3u64), m.len());
    println_string(&s2);
    line("");

    // [2] SAME compiled engine, different types: PMap<i64, bool>
    line("[2] PMap<i64, bool>  (same engine, no new monomorphization of the B+tree)");
    let mut flags: PMap<i64, bool> = PMap::<i64, bool>::new();
    flags.insert(-1i64, true);
    flags.insert(2i64, false);
    flags.insert(0i64, true);
    print("    entries:");
    for (k, b) in flags.iter() {
        let s: String = format::<i64, bool>("  {}=>{}", k, b);
        print_string(&s);
    }
    line("");
    line("");

    // [3] snapshot independence
    line("[3] snapshot");
    let snap: PMap<u64, i64> = m.snapshot();
    m.insert(9u64, 900i64);
    let s3: String = format::<u64, u64>("    after insert into original: original.len()={}  snapshot.len()={}",
                                        m.len(), snap.len());
    println_string(&s3);
    line("");
    line("== safe typed API; one compiled engine for all K/V ==");
    return 0;
}
