package bc_bindmut_for_range_mut_labeled_nested;
fn main() -> i32 {
    let mut acc: i64 = 0i64;
    'l: for mut i in 0i64..3i64 {
        i = i + 1i64;
        'm: for mut j in 0i64..3i64 {
            j = j + i;
            if j == 3i64 { break 'l; }
            acc = acc + j;
        }
    }
    if acc != 3i64 { return 1i32; }
    return 0i32;
}
