// Writ C6: parallel slices -> typed writ2 map via `as <K,AnyVal>{}`.
// MapSlice values are VALUE-FORM HAny (the writ2 re-design).
package writ_as_map;
use logos.lang.writ.typed_arr;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.mem.writ.stringify;
use logos.lang.rc;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    let keys: [i32; 2] = [1, 2];
    let vals: [HAny; 2] = [HAny::from(10 as i56), HAny::from(20 as i56)];
    let ks: &[i32] = &keys;
    let vs: &[HAny] = &vals;
    let ms: MapSliceI32 = MapSliceI32 { keys: ks, vals: vs };
    let ctr: Rc<Writ> = ms as <I32, AnyVal>{};
    let h: &Writ = ctr.deref();
    let root: HAny = h.root();
    if root.is_null() { return 1; }
    if h2_type_code(root.resolve()) != 3101u64 { return 2; }
    let s: String = stringify(root);
    if !s.eq_str("<I32, AnyVal> {1: 10, 2: 20}") { return 3; }
    return 0;
}
