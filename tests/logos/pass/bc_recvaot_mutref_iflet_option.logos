// 2026-09-05a: an if-let-bound &mut S (pattern binding, no 'mut') calls a &mut self method — legal reborrow.
package bc_recvaot_mutref_iflet_option;
struct S { v: i64 }
impl S {
    fn get(&mut self) -> &mut i64 { return &mut self.v; }
}
fn main() -> i32 {
    let mut s: S = S { v: 1i64 };
    let o: Option<&mut S> = Option::Some(&mut s);
    if let Option::Some(sr) = o {
        let r: &mut i64 = sr.get();
        *r = 3i64;
    }
    if s.v != 3i64 { return 1i32; }
    return 0i32;
}
