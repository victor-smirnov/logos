// Deep fork chain: each child commit adds a new keyrange to the
// inherited container. After 5 levels (C0 → C1 → … → C4), the latest
// commit shows the full union, and an old commit (C2) still reflects
// only the prefix it was built from.
//
//   C0:  [0..20)  *2
//   C1:  + [20..40)  *3   (forked from C0)
//   C2:  + [40..60)  *5   (forked from C1)
//   C3:  + [60..80)  *7   (forked from C2)
//   C4:  + [80..100) *11  (forked from C3)
//
// Validates: stable rc accounting across many fork→commit→drop cycles,
// dir CoW per fork, container CoW per fork, no cross-contamination
// between sibling-by-time forks of one base commit.

package persistent_fork_chain;

use logos.mem.collections.vec;
use logos.lang.mem;
use logos.lang.cmp; use logos.lang.cmp; use logos.lang.fabric;
use logos.lang.hermes.hstatic;

use logos.std.data.persistent.bt.node;
use logos.std.data.persistent.bt.cow;
use logos.std.data.persistent.store;
use logos.std.data.persistent.handle;

pub const StoreCfg: HermesStatic = @{
    "name": "fork-chain", "ctr_id": <type:u64>, "snp_id": <type:u64>, "block_id": <type:u64>,
};
pub const MapCfg: HermesStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 8 };


fn fill_range(cr: &mut ContainerRef<StoreCfg, MapCfg>, lo: u64, hi: u64, mul: u64) {
    let mut i = lo;
    while i < hi {
        cr.insert(i, i * mul);
        i = i + 1u64;
    }
}

fn check_value(cr: &ContainerRef<StoreCfg, MapCfg>, k: u64, want: u64) -> bool {
    let out = match cr.get(k) {
        Option::Some(x) => x,
        Option::None => { return false; }
    };
    return out == want;
}

fn extend(store: &mut Store<StoreCfg>, parent: u64, lo: u64, hi: u64, mul: u64) -> u64 {
    let mut snap = store.fork(parent);
    {
        // GENESIS has no container yet; later commits open the existing one.
        let mut cr = if parent == GENESIS {
            create_pmap::<MapCfg>(&mut snap, 1u64)
        } else {
            open_pmap::<MapCfg>(&mut snap, 1u64).unwrap()
        };
        fill_range(&mut cr, lo, hi, mul);
    }
    return snap.commit();}

fn main() -> i32 {
    let mut store = store_open::<StoreCfg>();

    let c0 = extend(&mut store, GENESIS, 0u64, 20u64, 2u64);
    let c1 = extend(&mut store, c0, 20u64, 40u64, 3u64);
    let c2 = extend(&mut store, c1, 40u64, 60u64, 5u64);
    let c3 = extend(&mut store, c2, 60u64, 80u64, 7u64);
    let c4 = extend(&mut store, c3, 80u64, 100u64, 11u64);

    // C4: full union of all 5 ranges with their respective multipliers.
    {
        let mut snap = store.fork(c4);
        let cr =
            open_pmap::<MapCfg>(&mut snap, 1u64).unwrap();
        if cr.len() != 100u64 { return 20; }
        let multipliers = [2u64, 3u64, 5u64, 7u64, 11u64];
        let mut bucket = 0u64;
        while bucket < 5u64 {
            let lo = bucket * 20u64;
            let hi = lo + 20u64;
            let mul = multipliers[bucket as i64];
            let mut k = lo;
            while k < hi {
                if !check_value(&cr, k, k * mul) { return 21; }
                k = k + 1u64;
            }
            bucket = bucket + 1u64;
        }
    }

    // C2: only [0..60), with C0/C1/C2 multipliers. Must NOT see C3/C4 keys.
    {
        let mut snap = store.fork(c2);
        let cr =
            open_pmap::<MapCfg>(&mut snap, 1u64).unwrap();
        if cr.len() != 60u64 { return 30; }
        let probe_ahead = 75u64;
        if cr.contains(probe_ahead) { return 31; }
        let probe_far = 95u64;
        if cr.contains(probe_far) { return 32; }
        // Spot checks across the three accumulated ranges.
        if !check_value(&cr,  5u64,  5u64 * 2u64) { return 33; }
        if !check_value(&cr, 25u64, 25u64 * 3u64) { return 34; }
        if !check_value(&cr, 55u64, 55u64 * 5u64) { return 35; }
    }

    // C0: only [0..20). Forking from the very first commit must still work.
    {
        let mut snap = store.fork(c0);
        let cr =
            open_pmap::<MapCfg>(&mut snap, 1u64).unwrap();
        if cr.len() != 20u64 { return 40; }
        let probe = 25u64;
        if cr.contains(probe) { return 41; }
        if !check_value(&cr, 10u64, 10u64 * 2u64) { return 42; }
    }

    return 0;
}
