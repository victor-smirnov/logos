// Pattern: codepoint (u32) + Matches/MatchIndices smoke.
package str_pattern_matches;

use logos.lang.str;
use logos.lang.iter;
use logos.lang.option;

fn fail(c: i32) -> i32 { return c; }

fn main() -> i32 {
    // ── u32 codepoint Pattern ──
    // 'l' = 0x6C in "hello" — first occurrence at byte 2.
    let s: str = "hello";
    let l_idx: i64 = (0x6Cu32).find_in(s, 0i64);
    if l_idx != 2i64 { return fail(1); }

    // Codepoint not present.
    let z_idx: i64 = (0x7Au32).find_in(s, 0i64);
    if z_idx != -1i64 { return fail(2); }

    // Multi-byte codepoint: 'é' = U+00E9 in "café" — starts at byte 3.
    let cafe: str = "café";
    let e_idx: i64 = (0x00E9u32).find_in(cafe, 0i64);
    if e_idx != 3i64 { return fail(3); }

    // match_len for codepoint = encoded byte length.
    if (0x6Cu32).match_len()   != 1i64 { return fail(4); }
    if (0x00E9u32).match_len() != 2i64 { return fail(5); }

    // ── Matches iterator with str pattern ──
    // "ab" in "ababab" → 3 matches.
    let mut ms: Matches<str> = str_matches::<str>("ababab", "ab");
    let m1: Option<str> = ms.next(); if !m1.is_some() { return fail(10); }
    let m2: Option<str> = ms.next(); if !m2.is_some() { return fail(11); }
    let m3: Option<str> = ms.next(); if !m3.is_some() { return fail(12); }
    let m4: Option<str> = ms.next(); if m4.is_some() { return fail(13); }

    // Non-overlapping: "aa" in "aaaa" → 2 matches at 0, 2.
    let mut mi: MatchIndices<str> = str_match_indices::<str>("aaaa", "aa");
    let mi1: Option<StrMatchIndex> = mi.next();
    if !mi1.is_some() { return fail(20); }
    let v1: StrMatchIndex = mi1.unwrap();
    if v1.idx != 0i64 { return fail(21); }
    let mi2: Option<StrMatchIndex> = mi.next();
    if !mi2.is_some() { return fail(22); }
    let v2: StrMatchIndex = mi2.unwrap();
    if v2.idx != 2i64 { return fail(23); }
    let mi3: Option<StrMatchIndex> = mi.next();
    if mi3.is_some() { return fail(24); }

    // ── u8 byte Pattern through Matches ──
    let mut mb: Matches<u8> = str_matches::<u8>("a.b.c", 46u8);
    let b1: Option<str> = mb.next(); if !b1.is_some() { return fail(30); }
    let b2: Option<str> = mb.next(); if !b2.is_some() { return fail(31); }
    let b3: Option<str> = mb.next(); if b3.is_some() { return fail(32); }

    return 0;
}
