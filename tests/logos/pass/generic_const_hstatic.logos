// Generic compile-time consts: parametric HermesStatic factories.
//
//   pub const PMapCfg<K, V>: HermesStatic = @{
//       "key":   <type:K>,
//       "value": <type:V>,
//       "fanout": 8
//   };
//
// Two distinct instantiations — `PMapCfg<u64, u64>` and `PMapCfg<u32, u32>` —
// produce two distinct HStaticLit identities (different byte hashes), each
// usable as a const-generic argument. The container directory in pmap
// dispatches them as separate types end-to-end.
package generic_const_hstatic;

use std.data.persistent.handle;
use std.lang.cmp; use std.lang.ord; use std.lang.datatypes;
use std.hermes.view; use std.hermes.anyval;

pub const StoreCfg: HermesStatic = @{ "name": "g", "ctr_id": <type:u64>, "snp_id": <type:u64> };

pub const PMapCfg<K, V>: HermesStatic = @{
    "key":    <type:K>,
    "value":  <type:V>,
    "fanout": 8
};

fn main() -> i32 {
    let mut store: Store<StoreCfg> = store_open::<StoreCfg>();
    let mut snap:  Snap<StoreCfg>  = snap_begin(&mut store);

    let mut c_a: ContainerRef<PMapCfg<u64, u64>> = create_pmap::<PMapCfg<u64, u64>>(&mut snap, 101u64);
    let mut c_b: ContainerRef<PMapCfg<u32, u32>> = create_pmap::<PMapCfg<u32, u32>>(&mut snap, 202u64);

    let k1: u64 = 5u64;
    let _ = c_a.insert(k1, 50u64, &k1 as *const u64);
    let k2: u32 = 7u32;
    let _ = c_b.insert(k2, 77u32, &k2 as *const u32);

    if c_a.len() != 1u64 { return 1; }
    if c_b.len() != 1u64 { return 2; }

    let probe: u64 = 5u64;
    if !c_a.contains(&probe as *const u64) { return 3; }
    let probe_miss: u64 = 99u64;
    if  c_a.contains(&probe_miss as *const u64) { return 4; }

    return 42;
}
