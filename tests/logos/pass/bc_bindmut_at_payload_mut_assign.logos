// `E::N(mut n @ 1..=5)` — a mutable at-binding in a variant payload (was a syntax error).
// Twin: bc_bindmut_at_payload_nomut_assign_fail. From soundness-queue row at_binding_mut_syntax.
package bc_bindmut_at_payload_mut_assign;
enum E { N(i64), Z }
fn main() -> i32 {
    let e: E = E::N(3i64);
    let mut out: i64 = 0i64;
    match e {
        E::N(mut n @ 1i64..=5i64) => { n = n + 10i64; out = n; },
        E::N(_) => { out = -1i64; },
        E::Z => {}
    }
    if out != 13i64 { return 1i32; }
    return 0i32;
}
