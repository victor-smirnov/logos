// query_incr_join_e2e — DIFFERENTIAL harness for the slice-1 incremental DBSP
// engine (ADR 0013 §9). Drives BOTH the queue-2 batch interpreter (the oracle,
// Query::run over freshly-materialized sources) AND the incremental engine
// (Query::incremental + IncrJoin::epoch) in-process, single-threaded, and
// asserts NETTED multiset equality after EACH epoch (§9.1, U3 compare-at-
// quiescence). The multi-epoch sequence is load-bearing (§10.3): a single
// epoch from empty state can pass while an integrate-order bug hides.
//
// Enumerated battery over the §10.3/§10.4 hazards, run for FOUR query variants
// (bag/set × collide/injective projection):
//   matched insert · unmatched insert · delete-of-present · delete-of-absent
//   (eff=0) · projection collision (2 tuples → 1 row → weights add) · a 3-epoch
//   insert-dept / insert-matching-emp / delete-dept sequence (A_int⋈ΔB,
//   ΔA⋈B_int, integrate order) · a same-epoch ΔA-insert + ΔB-delete on one key
//   (the ΔA⋈ΔB cross term + a transient-negative out_int netted at quiescence).
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema Emp : code(0x0C02_0000_0000_0001) {
    name: str = 0,
    dept: i64 = 1,
}
pub schema Dept : code(0x0C02_0000_0000_0002) {
    id:    i64 = 0,
    dname: str = 1,
}

resource cat = schema_catalog!{ Emp, Dept };

fn mk_emp(d: &Writ, name: str, dept: i64) -> WAny {
    let e: Emp = d.make::<Emp>();
    e.name = name;
    e.dept = dept;
    return WAny::ref_to((e.m as i64) as *const u8);
}
fn mk_dept(d: &Writ, id: i64, dname: str) -> WAny {
    let x: Dept = d.make::<Dept>();
    x.id    = id;
    x.dname = dname;
    return WAny::ref_to((x.m as i64) as *const u8);
}

// Effective-delta discipline (U1): raw ±w clamps the source weight to ≥0; the
// ENGINE receives eff = new − old (never drives an arrangement negative), while
// the truth model tracks the clamped weight the oracle rebuilds from.
fn src_apply(hs: &Vec<WAny>, wts: &mut Vec<i64>, batch: &mut ZBatch, idx: i64, raw: i64) {
    let old: i64 = wts.get(idx);
    let mut neww: i64 = old + raw;
    if neww < 0i64 { neww = 0i64; }
    let eff: i64 = neww - old;
    wts.set(idx, neww);
    if eff != 0i64 { batch.push(hs.get(idx), eff); }
}

// Build a fresh Writ source array from the clamped truth (bag multiplicity:
// `weight` duplicate handles per live row) — the oracle's per-epoch input.
fn build_src(d: &Writ, hs: &Vec<WAny>, wts: &Vec<i64>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(128i64);
    let n: i64 = hs.len();
    let mut i: i64 = 0i64;
    while i < n {
        let w: i64 = wts.get(i);
        let mut k: i64 = 0i64;
        while k < w { arr.push(hs.get(i)); k = k + 1i64; }
        i = i + 1i64;
    }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

// Two QRows rows equal cell-for-cell (str/i64/bool columns; test schemas only).
fn qrow_eq(a: &QRows, ai: i64, b: &QRows, bi: i64) -> bool {
    let nc: i64 = a.col_count();
    let mut c: i64 = 0i64;
    while c < nc {
        let ty: str = a.col_ty(c);
        if a.is_null(ai, c) != b.is_null(bi, c) { return false; }
        if str_eq(ty, "str") {
            if !str_eq(a.get_str(ai, c), b.get_str(bi, c)) { return false; }
        } else if str_eq(ty, "i64") {
            if a.get_i64(ai, c) != b.get_i64(bi, c) { return false; }
        } else if str_eq(ty, "bool") {
            if a.get_bool(ai, c) != b.get_bool(bi, c) { return false; }
        } else {
            return false;   // f64/node/dyn not used in the differential queries
        }
        c = c + 1i64;
    }
    return true;
}

// Weighted-MULTISET equality: greedy match each `a` row to an unused `b` row.
fn multiset_eq(a: &QRows, b: &QRows) -> bool {
    if a.row_count() != b.row_count() { return false; }
    if a.col_count() != b.col_count() { return false; }
    let n: i64 = a.row_count();
    let mut used: Vec<bool> = vec_new::<bool>();
    let mut i: i64 = 0i64;
    while i < n { used.push(false); i = i + 1i64; }
    let mut ai: i64 = 0i64;
    while ai < n {
        let mut found: bool = false;
        let mut bi: i64 = 0i64;
        while bi < n && !found {
            if !used.get(bi) {
                if qrow_eq(a, ai, b, bi) { used.set(bi, true); found = true; }
            }
            bi = bi + 1i64;
        }
        if !found { return false; }
        ai = ai + 1i64;
    }
    return true;
}

// Oracle-vs-engine compare at quiescence.
fn cmp(eng: &IncrJoin, q: &Query, doc: &Writ, eh: &Vec<WAny>, ew: &Vec<i64>,
       dh: &Vec<WAny>, dw: &Vec<i64>, oenv: &mut QEnv) -> bool {
    let es: WAny = build_src(doc, eh, ew);
    let ds: WAny = build_src(doc, dh, dw);
    oenv.bind_source("emps", es);
    oenv.bind_source("depts", ds);
    let orc: QRows = match q.run(oenv) { Result::Ok(r) => { r } Result::Err(_e) => { return false; } };
    // Error-returning EL policy: no epoch in this battery does integer arithmetic
    // that overflows, so the engine must never latch a math error.
    if eng.had_error() { return false; }
    let snap: QRows = eng.snapshot();
    return multiset_eq(&snap, &orc);
}

// Run the full 10-epoch battery for one query text; returns the failing epoch
// code (0 = all epochs matched). eh/dh are the stable handle pools.
fn run_variant(qtext: str, c: &SchemaCatalog, doc: &Writ,
               eh: &Vec<WAny>, dh: &Vec<WAny>) -> i32 {
    // fresh truth: base = emps {e0,e1}, depts {d0,d1}
    let mut ew: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < eh.len() { if i < 2i64 { ew.push(1i64); } else { ew.push(0i64); } i = i + 1i64; }
    let mut dw: Vec<i64> = vec_new::<i64>();
    let mut j: i64 = 0i64;
    while j < dh.len() { if j < 2i64 { dw.push(1i64); } else { dw.push(0i64); } j = j + 1i64; }

    let q: Query = match Query::compile(qtext, c) { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };

    // engine env: bound to the BASE sources (read once by incremental()).
    let mut eng_env: QEnv = QEnv::new();
    eng_env.bind_source("emps", build_src(doc, eh, &ew));
    eng_env.bind_source("depts", build_src(doc, dh, &dw));
    let mut eng: IncrJoin = match q.incremental(&eng_env) { Result::Ok(e) => { e } Result::Err(_e2) => { return 91i32; } };

    let mut oenv: QEnv = QEnv::new();
    // base (epoch 0)
    if !cmp(&eng, &q, doc, eh, &ew, dh, &dw, &mut oenv) { return 1i32; }

    // E1: matched insert  (+e2, dept1 matches d0)
    { let mut da: ZBatch = ZBatch::new(); let mut db: ZBatch = ZBatch::new();
      src_apply(eh, &mut ew, &mut da, 2i64, 1i64);
      eng.epoch(&da, &db);
      if !cmp(&eng, &q, doc, eh, &ew, dh, &dw, &mut oenv) { return 2i32; } }
    // E2: unmatched insert (+e3, dept9 — no dept)
    { let mut da: ZBatch = ZBatch::new(); let mut db: ZBatch = ZBatch::new();
      src_apply(eh, &mut ew, &mut da, 3i64, 1i64);
      eng.epoch(&da, &db);
      if !cmp(&eng, &q, doc, eh, &ew, dh, &dw, &mut oenv) { return 3i32; } }
    // E3: delete-of-present matched (-e0, dept1)
    { let mut da: ZBatch = ZBatch::new(); let mut db: ZBatch = ZBatch::new();
      src_apply(eh, &mut ew, &mut da, 0i64, -1i64);
      eng.epoch(&da, &db);
      if !cmp(&eng, &q, doc, eh, &ew, dh, &dw, &mut oenv) { return 4i32; } }
    // E4: delete-of-present unmatched (-e3)
    { let mut da: ZBatch = ZBatch::new(); let mut db: ZBatch = ZBatch::new();
      src_apply(eh, &mut ew, &mut da, 3i64, -1i64);
      eng.epoch(&da, &db);
      if !cmp(&eng, &q, doc, eh, &ew, dh, &dw, &mut oenv) { return 5i32; } }
    // E5: delete-of-ABSENT (e5 never inserted → eff 0, engine must do nothing)
    { let mut da: ZBatch = ZBatch::new(); let mut db: ZBatch = ZBatch::new();
      src_apply(eh, &mut ew, &mut da, 5i64, -1i64);
      eng.epoch(&da, &db);
      if !cmp(&eng, &q, doc, eh, &ew, dh, &dw, &mut oenv) { return 6i32; } }
    // E6: projection collision (+e4, dept1 → dept1 has e2,e4 → "Core" bag w2 / set w1)
    { let mut da: ZBatch = ZBatch::new(); let mut db: ZBatch = ZBatch::new();
      src_apply(eh, &mut ew, &mut da, 4i64, 1i64);
      eng.epoch(&da, &db);
      if !cmp(&eng, &q, doc, eh, &ew, dh, &dw, &mut oenv) { return 7i32; } }
    // E7a: insert a NEW dept (+d2, id3)
    { let mut da: ZBatch = ZBatch::new(); let mut db: ZBatch = ZBatch::new();
      src_apply(dh, &mut dw, &mut db, 2i64, 1i64);
      eng.epoch(&da, &db);
      if !cmp(&eng, &q, doc, eh, &ew, dh, &dw, &mut oenv) { return 8i32; } }
    // E7b: insert an emp matching the new dept (+e5, dept3) — A_int⋈ΔB path
    { let mut da: ZBatch = ZBatch::new(); let mut db: ZBatch = ZBatch::new();
      src_apply(eh, &mut ew, &mut da, 5i64, 1i64);
      eng.epoch(&da, &db);
      if !cmp(&eng, &q, doc, eh, &ew, dh, &dw, &mut oenv) { return 9i32; } }
    // E7c: delete the dept (-d2) — ΔB retract removes the matched output row
    { let mut da: ZBatch = ZBatch::new(); let mut db: ZBatch = ZBatch::new();
      src_apply(dh, &mut dw, &mut db, 2i64, -1i64);
      eng.epoch(&da, &db);
      if !cmp(&eng, &q, doc, eh, &ew, dh, &dw, &mut oenv) { return 10i32; } }
    // E8: SAME-EPOCH ΔA insert + ΔB delete on one key (+e6 dept2, -d1 id2) —
    //     forces the ΔA⋈ΔB cross term and a transient-negative out_int netted
    //     at step 4 (§8.2 integrate-order + U3).
    { let mut da: ZBatch = ZBatch::new(); let mut db: ZBatch = ZBatch::new();
      src_apply(eh, &mut ew, &mut da, 6i64, 1i64);
      src_apply(dh, &mut dw, &mut db, 1i64, -1i64);
      eng.epoch(&da, &db);
      if !cmp(&eng, &q, doc, eh, &ew, dh, &dw, &mut oenv) { return 11i32; } }

    return 0i32;
}

fn main() -> i32 {
    let doc: Writ = writ_new(262144i64);
    // stable handle pools (reused across epochs → pointer identity stable)
    let mut eh: Vec<WAny> = vec_new::<WAny>();
    eh.push(mk_emp(&doc, "Ann", 1i64));   // e0
    eh.push(mk_emp(&doc, "Bob", 2i64));   // e1
    eh.push(mk_emp(&doc, "Cid", 1i64));   // e2
    eh.push(mk_emp(&doc, "Dan", 9i64));   // e3 (unmatched)
    eh.push(mk_emp(&doc, "Eve", 1i64));   // e4 (collision on dept1)
    eh.push(mk_emp(&doc, "Flo", 3i64));   // e5 (matches d2)
    eh.push(mk_emp(&doc, "Gus", 2i64));   // e6 (dept2)
    let mut dh: Vec<WAny> = vec_new::<WAny>();
    dh.push(mk_dept(&doc, 1i64, "Core")); // d0
    dh.push(mk_dept(&doc, 2i64, "Ops"));  // d1
    dh.push(mk_dept(&doc, 3i64, "Lab"));  // d2

    let c: SchemaCatalog = cat();

    // Variant 1: bag mode, COLLIDING projection (select d.dname)
    let r1: i32 = run_variant("from emps e join depts d on e.dept == d.id select d.dname", &c, &doc, &eh, &dh);
    if r1 != 0i32 { return 100i32 + r1; }
    // Variant 2: set mode, colliding projection (select distinct d.dname)
    let r2: i32 = run_variant("from emps e join depts d on e.dept == d.id select distinct d.dname", &c, &doc, &eh, &dh);
    if r2 != 0i32 { return 200i32 + r2; }
    // Variant 3: bag mode, INJECTIVE projection (d.dname, e.name)
    let r3: i32 = run_variant("from emps e join depts d on e.dept == d.id select (d.dname, e.name)", &c, &doc, &eh, &dh);
    if r3 != 0i32 { return 300i32 + r3; }
    // Variant 4: set mode, injective projection
    let r4: i32 = run_variant("from emps e join depts d on e.dept == d.id select distinct (d.dname, e.name)", &c, &doc, &eh, &dh);
    if r4 != 0i32 { return 400i32 + r4; }

    return 0i32;
}
