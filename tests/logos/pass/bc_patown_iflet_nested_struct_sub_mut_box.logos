// `if let Some(W { b: mut bb }) = o` with a Box field: mutated through, dropped once PROBES.md 2026-09-06d: `if let` / `while let` / let-chains lower BY DELEGATION to lower_match (temp hoist, per-arm scrutinee move, arm drops, cond-move merge); the count is a destructor tally through a raw pointer.
package bc_patown_iflet_nested_struct_sub_mut_box;

struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
struct W { b: S, k: i64 }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let o: Option<W> = Option::Some(W { b: S { v: 1i64, i: p }, k: 7i64 });
        if let Option::Some(W { b: mut bb, k: _ }) = o { bb.v = bb.v + 4i64; }
    }
    return c as i32;
}
