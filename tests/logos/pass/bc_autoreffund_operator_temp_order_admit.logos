// CLOSED soundness_queue row operator_autoref_temp_eval_order_run (tier 1), round 2026-09-14o-autoreffund.
// `*pick(&a, s) == mk(2, s)`: a sequence counter appends 1 when pick runs, 2 when the temporary is built, 6 when it is
// destroyed. Rust evaluates the left operand first and drops the temporary at the end of the if condition: 126. Base read 12
// (never destroyed); the crude statement-prepend owner read 216 (built before pick). The landed owner is declared in the temp
// scope and initialised where the operand is evaluated. Exit 0 only on 126.
package bc_autoreffund_operator_temp_order_admit;
use logos.lang.cmp;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, s: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.s = *self.s * 10i64 + self.v + 4i64; } } }
impl Eq for D { fn eq(&self, other: &D) -> bool { return self.v > 0i64 && other.v > 0i64; } }
fn mk(v: i64, s: *mut i64) -> D {
    unsafe { *s = *s * 10i64 + v; }
    return D { v: v, s: s };
}
fn pick<'a>(d: &'a D, s: *mut i64) -> &'a D {
    unsafe { *s = *s * 10i64 + 1i64; }
    return d;
}
fn main() -> i32 {
    let mut q: i64 = 0i64;
    let s: *mut i64 = &mut q;
    let mut got: i64 = 0i64;
    {
        let a: D = D { v: 3i64, s: s };
        if !(*pick(&a, s) == mk(2i64, s)) { return 3i32; }
        got = unsafe { q };
    }
    unsafe { printf("seq_before_scope_end=%ld\n".as_ptr(), got); }
    if got != 126i64 { return 1i32; }
    return 0i32;
}
