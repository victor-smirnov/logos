// Copyright 2026 Victor Smirnov
// Test: floating-point parsing in the Hermes text format parser.
//
// Covers:
//   1. Basic float "1.0"        → Real (hash=30), IEEE-754 bits of 1.0f
//   2. Basic float "3.14"       → Real bits of 3.14f
//   3. Negative float "-0.5"    → Real bits of -0.5f
//   4. Scientific "1.0e1"       → Real bits of 10.0f
//   5. Scientific "2.5e-1"      → Real bits of 0.25f
//   6. Array [1.5, -2.0]        → ObjectArray with two Real slots
//   7. Map {x: 0.0}             → ObjectMap, "x" value is Real 0.0f

package hermes_float_parse;

use hermes.zone;
use hermes.anyval;
use hermes.string;
use hermes.typetag;
use hermes.containers;
use hermes.objectmap;
use hermes.document;
use hermes.parser;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

unsafe fn wb(buf: *mut u8, idx: i64, val: u8) {
    *((buf as i64 + idx) as *mut u8) = val;
}

// Reinterpret f32 bits as u32 for verification.
unsafe fn f32_bits(v: f32) -> u32 {
    let mut tmp: f32 = v;
    let p: *const f32 = &tmp as *const f32;
    let q: *const u32 = p as *const u32;
    return *q;
}

unsafe fn main() -> i32 {
    let ibuf: *mut u8 = malloc(256);

    // ── 1. "1.0" → Real, lo == bits(1.0f) ───────────────────────────────────
    // Input: '1' '.' '0'  = 49 46 48
    wb(ibuf, 0, 49 as u8); wb(ibuf, 1, 46 as u8); wb(ibuf, 2, 48 as u8);
    let mut z1: HermesZone = HermesZone::create(4096);
    if !hermes_parse(ibuf as *const u8, 3, &mut z1) { free(ibuf); return 1; }
    let r1: AnyVal = document_get_root(document_header(z1.base) as *const DocumentHeader);
    // Must be value mode (not pointer)
    if r1.is_ptr()                              { free(ibuf); return 2; }
    // hi must be 0x3D000000 (Real, hash=30)
    if r1.hi != 0x3D000000 as u32              { free(ibuf); return 3; }
    // lo must equal IEEE-754 bits of 1.0f = 0x3F800000
    let want1: u32 = f32_bits(1.0);
    if r1.lo != want1                           { free(ibuf); return 4; }
    z1.destroy();

    // ── 2. "3.14" → Real, lo == bits(3.14f) ─────────────────────────────────
    // Input: '3' '.' '1' '4'  = 51 46 49 52
    wb(ibuf, 0, 51 as u8); wb(ibuf, 1, 46 as u8);
    wb(ibuf, 2, 49 as u8); wb(ibuf, 3, 52 as u8);
    let mut z2: HermesZone = HermesZone::create(4096);
    if !hermes_parse(ibuf as *const u8, 4, &mut z2) { free(ibuf); return 5; }
    let r2: AnyVal = document_get_root(document_header(z2.base) as *const DocumentHeader);
    if r2.hi != 0x3D000000 as u32              { free(ibuf); return 6; }
    let want2: u32 = f32_bits(3.14);
    if r2.lo != want2                          { free(ibuf); return 7; }
    z2.destroy();

    // ── 3. "-0.5" → Real, lo == bits(-0.5f) ─────────────────────────────────
    // Input: '-' '0' '.' '5'  = 45 48 46 53
    wb(ibuf, 0, 45 as u8); wb(ibuf, 1, 48 as u8);
    wb(ibuf, 2, 46 as u8); wb(ibuf, 3, 53 as u8);
    let mut z3: HermesZone = HermesZone::create(4096);
    if !hermes_parse(ibuf as *const u8, 4, &mut z3) { free(ibuf); return 8; }
    let r3: AnyVal = document_get_root(document_header(z3.base) as *const DocumentHeader);
    if r3.hi != 0x3D000000 as u32              { free(ibuf); return 9; }
    let want3: u32 = f32_bits(-0.5);
    if r3.lo != want3                          { free(ibuf); return 10; }
    z3.destroy();

    // ── 4. "1.0e1" → Real, bits(10.0f) ──────────────────────────────────────
    // Input: '1' '.' '0' 'e' '1'  = 49 46 48 101 49
    wb(ibuf, 0, 49 as u8); wb(ibuf, 1, 46 as u8); wb(ibuf, 2, 48 as u8);
    wb(ibuf, 3, 101 as u8); wb(ibuf, 4, 49 as u8);
    let mut z4: HermesZone = HermesZone::create(4096);
    if !hermes_parse(ibuf as *const u8, 5, &mut z4) { free(ibuf); return 11; }
    let r4: AnyVal = document_get_root(document_header(z4.base) as *const DocumentHeader);
    if r4.hi != 0x3D000000 as u32              { free(ibuf); return 12; }
    let want4: u32 = f32_bits(10.0);
    if r4.lo != want4                          { free(ibuf); return 13; }
    z4.destroy();

    // ── 5. "2.5e-1" → Real, bits(0.25f) ─────────────────────────────────────
    // Input: '2' '.' '5' 'e' '-' '1'  = 50 46 53 101 45 49
    wb(ibuf, 0, 50 as u8); wb(ibuf, 1, 46 as u8); wb(ibuf, 2, 53 as u8);
    wb(ibuf, 3, 101 as u8); wb(ibuf, 4, 45 as u8); wb(ibuf, 5, 49 as u8);
    let mut z5: HermesZone = HermesZone::create(4096);
    if !hermes_parse(ibuf as *const u8, 6, &mut z5) { free(ibuf); return 14; }
    let r5: AnyVal = document_get_root(document_header(z5.base) as *const DocumentHeader);
    if r5.hi != 0x3D000000 as u32              { free(ibuf); return 15; }
    let want5: u32 = f32_bits(0.25);
    if r5.lo != want5                          { free(ibuf); return 16; }
    z5.destroy();

    // ── 6. "[1.5,-2.0]" → ObjectArray, two Real elements ────────────────────
    // Input: '[' '1' '.' '5' ',' '-' '2' '.' '0' ']'
    //   91 49 46 53 44 45 50 46 48 93
    wb(ibuf, 0, 91 as u8);  // '['
    wb(ibuf, 1, 49 as u8);  // '1'
    wb(ibuf, 2, 46 as u8);  // '.'
    wb(ibuf, 3, 53 as u8);  // '5'
    wb(ibuf, 4, 44 as u8);  // ','
    wb(ibuf, 5, 45 as u8);  // '-'
    wb(ibuf, 6, 50 as u8);  // '2'
    wb(ibuf, 7, 46 as u8);  // '.'
    wb(ibuf, 8, 48 as u8);  // '0'
    wb(ibuf, 9, 93 as u8);  // ']'
    let mut z6: HermesZone = HermesZone::create(8192);
    if !hermes_parse(ibuf as *const u8, 10, &mut z6) { free(ibuf); return 17; }
    let r6: AnyVal = document_get_root(document_header(z6.base) as *const DocumentHeader);
    if !r6.is_ptr()                             { free(ibuf); return 18; }
    let arr6: *const ObjectArray =
        (z6.base as i64 + r6.as_offset() as i64) as *const ObjectArray;
    let alen6: u64 = arr6.len();
    if alen6 != 2 as u64                        { free(ibuf); return 19; }
    let ae0: AnyVal = arr6.get(z6.base as *const u8, 0 as u64);
    let ae1: AnyVal = arr6.get(z6.base as *const u8, 1 as u64);
    if ae0.hi != 0x3D000000 as u32             { free(ibuf); return 20; }
    let w15: u32 = f32_bits(1.5);
    if ae0.lo != w15                           { free(ibuf); return 21; }
    if ae1.hi != 0x3D000000 as u32             { free(ibuf); return 22; }
    let wm2: u32 = f32_bits(-2.0);
    if ae1.lo != wm2                           { free(ibuf); return 23; }
    z6.destroy();

    // ── 7. "{x:0.0}" → ObjectMap, "x" → Real bits(0.0f) ─────────────────────
    // Input: '{' 'x' ':' '0' '.' '0' '}'
    //   123 120 58 48 46 48 125
    wb(ibuf, 0, 123 as u8); // '{'
    wb(ibuf, 1, 120 as u8); // 'x'
    wb(ibuf, 2,  58 as u8); // ':'
    wb(ibuf, 3,  48 as u8); // '0'
    wb(ibuf, 4,  46 as u8); // '.'
    wb(ibuf, 5,  48 as u8); // '0'
    wb(ibuf, 6, 125 as u8); // '}'
    let mut z7: HermesZone = HermesZone::create(8192);
    if !hermes_parse(ibuf as *const u8, 7, &mut z7) { free(ibuf); return 24; }
    let r7: AnyVal = document_get_root(document_header(z7.base) as *const DocumentHeader);
    if !r7.is_ptr()                             { free(ibuf); return 25; }
    let omap7: *const ObjectMap =
        (z7.base as i64 + r7.as_offset() as i64) as *const ObjectMap;
    let cnt7: u32 = omap7.size_count();
    if cnt7 != 1 as u32                         { free(ibuf); return 26; }
    let mut xk: u8 = 120 as u8;  // 'x'
    let got7: AnyVal = omap7.get(z7.base as *const u8, (&mut xk) as *const u8, 1 as u64);
    if got7.hi != 0x3D000000 as u32            { free(ibuf); return 27; }
    let w00: u32 = f32_bits(0.0);
    if got7.lo != w00                          { free(ibuf); return 28; }
    z7.destroy();

    free(ibuf);
    return 42;
}
