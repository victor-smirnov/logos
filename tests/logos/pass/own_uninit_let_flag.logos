// ADR 0030 S5.2: a declared-uninit `let x: T;` carries sema's drop flag (starts clear):
// each assignment drops the old value iff set, a return before any assignment and a
// never-taken branch drop nothing. It was mlir's name-keyed B8 flag (retired).
// The exit code is the drop counter; rustc 1.98.1 twin exits 21.
package own_uninit_let_flag;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(&mut self) { unsafe { *self.c = *self.c + self.v; } } }
fn f(c: *mut i64, k: bool, early: bool) -> i64 {
    let mut x: D;
    if early { return 0; }
    if k { x = D { v: 1, c: c }; }
    x = D { v: 2, c: c };
    x = D { v: 4, c: c };
    return x.v - x.v;
}
fn g(c: *mut i64, k: bool) {
    let y: D;
    if k { y = D { v: 8, c: c }; let _z = y.v; }
}
fn main() -> i32 {
    let mut n: i64 = 0; let c: *mut i64 = &mut n;
    let _a = f(c, true, false);
    let _b = f(c, false, false);
    let _e = f(c, true, true);
    g(c, true); g(c, false);
    return unsafe { *c } as i32;
}
