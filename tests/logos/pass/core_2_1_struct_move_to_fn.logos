// logos-core §2.1 — a struct moved into a fn by value: caller can't
// use it afterward (it's consumed). The body sees the moved owner.
package core_2_1_struct_move_to_fn;
struct S { v: i32 }
fn take(s: S) -> i32 { return s.v; }
fn main() -> i32 {
    let s: S = S { v: 42i32 };
    let r: i32 = take(s);
    if r != 42i32 { return 1i32; }
    return 0i32;
}
