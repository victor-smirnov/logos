package test;

use std.collections.hashmap;
use std.lang.iter;
use std.lang.option;

fn main() -> i32 {
    unsafe {
        let mut m: HashMap<i32, i32> = hashmap_new::<i32, i32>();
        let pm: *mut HashMap<i32, i32> = &mut m;

        let mut i: i32 = 0;
        while i < 10 {
            pm.insert(i, i * 100);
            i = i + 1;
        }

        // Sum of all keys: 0+1+...+9 = 45.
        let pc: *const HashMap<i32, i32> = &m;
        let mut ks: HashMapKeys<i32, i32> = pc.keys();
        let mut ksum: i32 = 0;
        loop {
            match ks.next() {
                Option::None    => { break; }
                Option::Some(k) => { ksum = ksum + k; }
            }
        }
        if ksum != 45 { return 1; }

        // Sum of all values: 100*(0+..+9) = 4500.
        let mut vs: HashMapValues<i32, i32> = pc.values();
        let mut vsum: i32 = 0;
        loop {
            match vs.next() {
                Option::None    => { break; }
                Option::Some(v) => { vsum = vsum + v; }
            }
        }
        if vsum != 4500 { return 2; }

        // iter: count entries + check invariant val == key * 100.
        let mut it: HashMapIter<i32, i32> = pc.iter();
        let mut n: i32 = 0;
        loop {
            match it.next() {
                Option::None     => { break; }
                Option::Some(zp) => {
                    if zp.second != zp.first * 100 { return 3; }
                    n = n + 1;
                }
            }
        }
        if n != 10 { return 4; }

        return 7;
    }
}
