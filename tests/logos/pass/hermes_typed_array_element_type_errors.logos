// Typed-array element type errors -> null (hermes2): strings, bools, floats
// in integer arrays; floats OK in F64.
package hermes_typed_array_element_type_errors;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.mem.hermes.parser;
use logos.mem.rc;

unsafe fn main() -> i32 {
    let rc: Rc<Hermes> = hermes_rc(8192);
    let h: &Hermes = rc.deref();
    if !parse(h, "<I32>[1,\"x\",3]").is_null() { return 1; }
    if !parse(h, "<I32>[true]").is_null() { return 2; }
    if !parse(h, "<I32>[1.25]").is_null() { return 3; }
    if parse(h, "<F64>[1.25]").is_null() { return 4; }
    return 0;
}
