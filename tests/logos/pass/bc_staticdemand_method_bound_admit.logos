// A 'static argument at a method with `where 'a: 'static`; it runs.
// TWIN of fail/bc_staticdemand_method_bound_refuse, one token apart. src/compiler/PROBES.md 2026-09-13d-staticdemand.
package bc_staticdemand_method_bound_admit;
static N: i64 = 4i64;
struct K { b: i64 }
impl K {
    fn keep<'a>(self: &Self, t: &'a i64) -> i64 where 'a: 'static { return *t + self.b; }
}
fn g(k: &K, u: &'static i64) -> i64 {
    return k.keep(u);
}
fn main() -> i32 { let k = K { b: 1i64 }; return g(&k, &N) as i32; }
