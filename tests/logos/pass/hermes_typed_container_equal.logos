// hermes_typed_container_equal.logos — verify HermesEqual for typed containers.
//
// Tests structural equality via anyval_equal for Array<i32> and Map<i32,AnyVal>.
// Uses Hermes text parser (supports <I32>[...] and <I32,AnyVal>{...}).

package hermes_typed_container_equal;

use hermes.ctr;
use hermes.equal;
use std.lang.text;

pub unsafe fn main() -> i32 {
    // ── 1. Array<i32>: identical docs are equal ───────────────────────────────
    let mut a1: Hermes = Hermes::new(4096);
    match a1.parse("<I32>[1,2,3]" as *const u8, 12 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 1; }
    }
    let mut b1: Hermes = Hermes::new(4096);
    match b1.parse("<I32>[1,2,3]" as *const u8, 12 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 2; }
    }
    let mut ec1: EqualCtx = EqualCtx { base_self: a1.base(), base_other: b1.base() };
    if !anyval_equal(a1.root(), b1.root(), &mut ec1) { return 3; }

    // ── 2. Array<i32>: different last element → not equal ────────────────────
    let mut a2: Hermes = Hermes::new(4096);
    match a2.parse("<I32>[1,2,3]" as *const u8, 12 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 4; }
    }
    let mut b2: Hermes = Hermes::new(4096);
    match b2.parse("<I32>[1,2,4]" as *const u8, 12 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 5; }
    }
    let mut ec2: EqualCtx = EqualCtx { base_self: a2.base(), base_other: b2.base() };
    if anyval_equal(a2.root(), b2.root(), &mut ec2) { return 6; }

    // ── 3. Array<i32>: different lengths → not equal ─────────────────────────
    let mut a3: Hermes = Hermes::new(4096);
    match a3.parse("<I32>[1,2,3]" as *const u8, 12 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 7; }
    }
    let mut b3: Hermes = Hermes::new(4096);
    match b3.parse("<I32>[1,2]" as *const u8, 10 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 8; }
    }
    let mut ec3: EqualCtx = EqualCtx { base_self: a3.base(), base_other: b3.base() };
    if anyval_equal(a3.root(), b3.root(), &mut ec3) { return 9; }

    // ── 4. Array<i32> with negative values: identical → equal ────────────────
    let mut a4: Hermes = Hermes::new(4096);
    match a4.parse("<I32>[-1,0,1]" as *const u8, 13 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 10; }
    }
    let mut b4: Hermes = Hermes::new(4096);
    match b4.parse("<I32>[-1,0,1]" as *const u8, 13 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 11; }
    }
    let mut ec4: EqualCtx = EqualCtx { base_self: a4.base(), base_other: b4.base() };
    if !anyval_equal(a4.root(), b4.root(), &mut ec4) { return 12; }

    // ── 5. Map<i32,AnyVal>: identical docs are equal ─────────────────────────
    let mut a5: Hermes = Hermes::new(4096);
    match a5.parse("<I32,AnyVal>{1:10,2:20}" as *const u8, 23 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 13; }
    }
    let mut b5: Hermes = Hermes::new(4096);
    match b5.parse("<I32,AnyVal>{1:10,2:20}" as *const u8, 23 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 14; }
    }
    let mut ec5: EqualCtx = EqualCtx { base_self: a5.base(), base_other: b5.base() };
    if !anyval_equal(a5.root(), b5.root(), &mut ec5) { return 15; }

    // ── 6. Map<i32,AnyVal>: different value → not equal ──────────────────────
    let mut a6: Hermes = Hermes::new(4096);
    match a6.parse("<I32,AnyVal>{1:10,2:20}" as *const u8, 23 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 16; }
    }
    let mut b6: Hermes = Hermes::new(4096);
    match b6.parse("<I32,AnyVal>{1:10,2:99}" as *const u8, 23 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 17; }
    }
    let mut ec6: EqualCtx = EqualCtx { base_self: a6.base(), base_other: b6.base() };
    if anyval_equal(a6.root(), b6.root(), &mut ec6) { return 18; }

    // ── 7. Array<i32> equal to cloned copy ───────────────────────────────────
    let mut src7: Hermes = Hermes::new(4096);
    match src7.parse("<I32>[5,6,7]" as *const u8, 12 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 19; }
    }
    let dst7: Hermes = src7.clone();
    let mut ec7: EqualCtx = EqualCtx { base_self: src7.base(), base_other: dst7.base() };
    if !anyval_equal(src7.root(), dst7.root(), &mut ec7) { return 20; }

    // ── 8. Map equal to cloned copy ──────────────────────────────────────────
    let mut src8: Hermes = Hermes::new(4096);
    match src8.parse("<I32>{3:true,4:false}" as *const u8, 21 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 21; }
    }
    let dst8: Hermes = src8.clone();
    let mut ec8: EqualCtx = EqualCtx { base_self: src8.base(), base_other: dst8.base() };
    if !anyval_equal(src8.root(), dst8.root(), &mut ec8) { return 22; }

    return 0;
}
