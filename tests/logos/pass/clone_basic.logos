package clone_test;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printii(fmt: str, a: i32, b: i32) { unsafe { printf(fmt.as_ptr(), a, b); } }

trait Clone { fn clone(&self) -> Self; }

struct Point { x: i32, y: i32, }

impl Clone for Point {
    fn clone(&self) -> Point {
        return Point { x: self.x, y: self.y };
    }
}

unsafe fn main() -> i32 {
    let p1 = Point { x: 3, y: 7 };
    let p2 = p1.clone();
    printii("%d %d\n", p2.x, p2.y);
    return 0;
}
