// THE LEGAL TWIN: impl<'a, T> S<'a, T> where S { x: &'a T } — the impl header's WF implies T: 'a (RFC 2093) for the method body (2026-09-03a)
package bc_wf_impl_header;
struct S<'a, T> { x: &'a T }
impl<'a, T> S<'a, T> { fn f(&self) -> i64 { let z: Option<&'a T> = Option::None; return 0i64; } }
fn main() -> i32 { let n = 1i64; let s = S { x: &n }; return s.f() as i32; }
