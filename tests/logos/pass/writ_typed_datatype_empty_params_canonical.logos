// Empty-params canonicalization (writ2): @T=x == @T()=x == @T( )=x — all
// parse to a null params slot, render identically, compare/hash equal.
package writ_typed_datatype_empty_params_canonical;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.typed_value;
use logos.mem.writ.parser;
use logos.mem.writ.equal;
use logos.mem.writ.hashing;
use logos.mem.writ.stringify;
use logos.lang.rc;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(8192);
    let h: &Writ = rc.deref();
    let a: HAny = parse(h, "@I64=42");
    let b: HAny = parse(h, "@I64()=42");
    let c: HAny = parse(h, "@I64( )=42");
    if a.is_null() || b.is_null() || c.is_null() { return 1; }

    if a.as_typed_value().has_params() { return 2; }
    if b.as_typed_value().has_params() { return 3; }
    if c.as_typed_value().has_params() { return 4; }

    if !writ_equal(a, b) || !writ_equal(a, c) { return 5; }
    if writ_hash(a) != writ_hash(b) { return 6; }

    let sa: String = stringify(a);
    let sb: String = stringify(b);
    if !sa.eq_str("42@I64") { return 7; }
    if !sa.eq_str(sb.as_str()) { return 8; }
    return 0;
}
