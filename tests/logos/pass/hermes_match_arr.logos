// Test: Hermes array structural patterns @[...].

package hermes_match_arr;

use logos.lang.hermes.anyval;
use logos.mem.hermes.ctr;
use logos.mem.hermes.pat;
use logos.lang.hermes.view;
use logos.mem.hermes.view;

unsafe fn classify(d: &HermesStatic) -> i32 {
    match d {
        @[@1, @2, @3] => 1,
        @[@1, @2]     => 2,
        @[]           => 3,
        _             => 0,
    }
}

unsafe fn main() -> i32 {
    let a: HermesStatic = @[1, 2, 3];
    let b: HermesStatic = @[1, 2];
    let c: HermesStatic = @[];
    let d: HermesStatic = @[1, 2, 3, 4];
    // 1 + 2 + 3 + 0 = 6
    return classify(&a) + classify(&b) + classify(&c) + classify(&d);
}
