package pub_fields;
// pub fields: syntax and accessibility within same package
extern fn printf(fmt: *const u8, ...) -> i32;
fn printii(fmt: *const u8, a: i32, b: i32) { unsafe { printf(fmt, a, b); } }
fn printi(fmt: *const u8, v: i32) { unsafe { printf(fmt, v); } }

struct Point {
    pub x: i32,
    pub y: i32,
}

struct Counter {
    pub  value: i32,   // public — accessible everywhere
    step: i32,         // private — accessible only within package (same file)
}

impl Counter {
    static fn new(step: i32) -> Counter {
        return Counter { value: 0, step: step };
    }
    unsafe fn tick(self: *mut Counter) {
        self.value = self.value + self.step;
    }
}

unsafe fn main() -> i32 {
    let p = Point { x: 3, y: 4 };
    printii("%d %d\n", p.x, p.y);

    let mut c = Counter::new(5);
    c.tick();
    c.tick();
    printi("%d\n", c.value);   // 10

    return 0;
}
