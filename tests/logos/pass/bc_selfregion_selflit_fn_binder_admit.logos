// A literal spelled with the struct's NAME is typed from its values: `MyStruct<'a>`. Legal.
// TWIN of fail/bc_selfregion_selflit_fn_binder_refuse, one token apart. src/compiler/PROBES.md 2026-09-13b-selfregion-land.
package bc_selfregion_selflit_fn_binder_admit;
struct MyStruct<'a> { field: &'a i64 }
impl MyStruct<'_> {
    fn make<'a>(field: &'a i64) -> MyStruct<'a> {
        return MyStruct { field: field };
    }
}
fn main() -> i32 {
    let v: i64 = 42i64;
    let m = MyStruct::make(&v);
    return *m.field as i32;
}
