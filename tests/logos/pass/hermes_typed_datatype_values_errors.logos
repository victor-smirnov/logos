// Malformed @Type forms parse to null (hermes2): missing '=', unclosed
// params, missing name.
package hermes_typed_datatype_values_errors;
use logos.lang.hermes2.container;
use logos.lang.hermes2.anyval;
use logos.mem.hermes2.parser;
use logos.mem.rc;

unsafe fn main() -> i32 {
    let rc: Rc<Hermes2> = hermes2_rc(8192);
    let h: &Hermes2 = rc.deref();
    if !parse(h, "@I64 42").is_null() { return 1; }            // no '='
    if !parse(h, "\"12\"@Decimal(10,2").is_null() { return 2; } // unclosed '('
    if !parse(h, "@=1").is_null() { return 3; }                 // no name
    if !parse(h, "@I64(=1").is_null() { return 4; }             // bad params
    // A good form still parses after errors.
    if parse(h, "@I64=1").is_null() { return 5; }
    return 0;
}
