// C8f: HermesView — non-owning view of a live Hermes.
package hermes_ctr_view;
use std.hermes.ctr;
use logos.lang.hermes.anyval;
use logos.lang.hermes.view;
use std.hermes.view;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    // Build a small document.
    let mut ctr: Hermes = Hermes::new(4096);
    match ctr.parse("{\"x\": 1, \"y\": 2}") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 1; }
    }

    // Obtain a view — borrows ctr.
    let v: HermesView = ctr.as_view();
    let root: AnyVal = v.root();
    if root.is_null() { return 2; }

    // stringify via view.
    let text: String = v.to_string();
    if !text.eq_str("{\"x\":1,\"y\":2}") { return 3; }

    // View of a capture-literal Hermes.
    let id: i32 = 99;
    let doc: Hermes = @{"id": $id};
    let dv: HermesView = doc.as_view();
    let dr: AnyVal = dv.root();
    if dr.is_null() { return 4; }

    return 0;
}
