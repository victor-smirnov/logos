// Was SOUNDNESS QUEUE row match_tuple_door_nested_struct_binds_nothing (tier 3, refuses); CLOSED
// 2026-09-16p-tupdoor. `match sv { (P { x, y }, z) => .. }` is legal Rust and was refused "undefined
// variable 'x'": bind_pattern_ref's Tuple door recursed into a whitelist of sub-pattern kinds that did
// not include Struct, so the nested pattern bound nothing. Struct added to that whitelist.
// ⚠ THE BOUND VALUES ARE PRINTED, NOT ONLY COMPARED. When a binder is defined in sema but never
// emitted by mlir_gen, the guarded `if` is not emitted either and the program falls through to
// `return 0` — an exit-code-only assertion passes on a compiler that binds nothing. stdout is the
// column that separates "bound correctly" from "never bound".
// legality: rustc 1.98.1 --edition 2024 compiles and runs it, exit 0 (round record 2026-09-16p).
package match_tuple_door_nested_struct_binds_nothing;
extern fn printf(fmt: *const u8, ...) -> i32;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let sv: (P, i64) = (P { x: 3i64, y: 2i64 }, 2i64);
    let mut got: i64 = 0i64;
    match sv {
        (P { x, y }, z) => { got = x + y + z; }
    }
    unsafe { printf("got=%ld\n".as_ptr(), got); }
    if got != 7i64 { return 1i32; }
    return 0i32;
}
