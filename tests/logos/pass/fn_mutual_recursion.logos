package fn_mutual_recursion;
// F10: direct recursion (mutual isn't supported without forward decls)
// Test deep recursion via direct: fib
fn fib(n: i32) -> i32 {
    if n <= 1 { return n; }
    return fib(n - 1) + fib(n - 2);
}
fn fact(n: i32) -> i32 {
    if n <= 1 { return 1; }
    return n * fact(n - 1);
}
fn main() -> i32 {
    let f9: i32 = fib(9);    // 34
    let f3: i32 = fact(3);   // 6
    // 34 + 6 + 2 = 42
    return f9 + f3 + 2;
}
