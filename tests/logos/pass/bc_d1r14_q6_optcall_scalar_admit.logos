// ── D1 round 14 ADMIT CONTROL ─────────────────────────────────────────────
// The refusal fixture alone cannot tell a CLOSED LEAK from an OVER-REFUSAL:
// both print a diagnostic. This is the other half of the pair — the same
// shape used SOUNDLY (the borrow never outlives its referent), which must
// keep COMPILING. If it starts refusing, the round-14 arm is too wide.
// Q6, the NEGATIVE half: `Option<i64>` from an i64 argument carries no borrow,
// so widening the arm's ENTRY to `type_may_carry_borrow` must not tie it to
// anything. The arm still ties only args that are themselves ref/bc.
package bc_d1r14_q6_optcall_scalar_admit;
use logos.lang.option;
fn pickv(v: i64) -> Option<i64> { return Option::Some(v); }
fn main() -> i32 {
    let mut acc: i64 = 0i64;
    { let x: i64 = 5i64; let o: Option<i64> = pickv(x);
      match o { Option::Some(n) => { acc = n; } Option::None => { acc = 0i64; } } }
    if acc != 5i64 { return 1; }
    return 0;
}
