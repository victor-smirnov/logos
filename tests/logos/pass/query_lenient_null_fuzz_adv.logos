// query_lenient_null_fuzz_adv — ADVERSARIAL differential fuzzer for the Deem
// engine's LENIENT (erased-source) mode + CEL-style Null propagation (ADR
// 0012-queue2 §4a). Rows are string-keyed Writ maps bound via
// bind_source_erased (NO catalog); each int field is independently PRESENT or
// MISSING, and a missing field reads Null. A deterministic LCG builds, each
// iteration, a random VALID query over two erased sources T/U, runs it through
// Query::compile/run, and compares — as a NULL-AWARE multiset of cells — against
// an INDEPENDENT naive evaluator that implements the ADR §4a table verbatim:
//   ==/!= : Null==Null -> true ; Null==x -> false ; != negates
//   < <= > >= : any Null operand -> false (never orders)
//   + - * /   : any Null operand -> Null
//   && || !   : Null is falsy (!Null -> true)
//   ?:        : Null condition takes the else branch
//   group/distinct/join key equality: Null==Null -> true (nulls coalesce)
// Output cells carry a NULL FLAG so a Null cell never compares equal to 0.
// Exit 0 iff every iteration agrees; a nonzero code names the failing template.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.wmap;
use logos.lang.writ.wstring;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

// A dummy catalog (erased sources need none, but Query::compile wants a &cat).
pub schema Dummy : code(0x0DF1_0000_0000_0001) { z: i64 = 0 }
resource cat = schema_catalog!{ Dummy };

// ── deterministic RNG (Knuth MMIX LCG) — wrapping_* is MANDATORY ──────────────
struct Rng { s: u64 }
impl Rng {
    fn next(self: &mut Rng) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
    fn upto(self: &mut Rng, n: i64) -> i64 { return (self.next() % (n as u64)) as i64; }
    fn range(self: &mut Rng, lo: i64, hi: i64) -> i64 { return lo + self.upto(hi - lo); }
}

// ── oracle value: k = 0 Null | 1 Int ─────────────────────────────────────────
struct OVal { k: i64, i: i64 }
impl Copy for OVal {}
fn onull() -> OVal { return OVal { k: 0i64, i: 0i64 }; }
fn oint(v: i64) -> OVal { return OVal { k: 1i64, i: v }; }

// rt_eq mirror (int/null only here).
fn o_eq(a: OVal, b: OVal) -> bool {
    if a.k == 1i64 && b.k == 1i64 { return a.i == b.i; }
    if a.k == 0i64 && b.k == 0i64 { return true; }
    return false;
}
// comparison op (0 ==,1 !=,2 <,3 <=,4 >,5 >=) with Null rules.
fn o_cmp(a: OVal, op: i64, b: OVal) -> bool {
    if op == 0i64 { return o_eq(a, b); }
    if op == 1i64 { return !o_eq(a, b); }
    // ordering: any Null -> false
    if a.k == 0i64 || b.k == 0i64 { return false; }
    if op == 2i64 { return a.i <  b.i; }
    if op == 3i64 { return a.i <= b.i; }
    if op == 4i64 { return a.i >  b.i; }
    return a.i >= b.i;
}
// arithmetic op (0 +,1 -,2 *): any Null -> Null.
fn o_arith(a: OVal, op: i64, b: OVal) -> OVal {
    if a.k == 0i64 || b.k == 0i64 { return onull(); }
    if op == 0i64 { return oint(a.i + b.i); }
    if op == 1i64 { return oint(a.i - b.i); }
    return oint(a.i * b.i);
}
fn o_truthy(a: OVal) -> bool { if a.k == 0i64 { return false; } return a.i != 0i64; }

fn op_str(op: i64) -> str {
    if op == 0i64 { return "=="; }
    if op == 1i64 { return "!="; }
    if op == 2i64 { return "<";  }
    if op == 3i64 { return "<="; }
    if op == 4i64 { return ">";  }
    return ">=";
}
fn arith_str(op: i64) -> str { if op == 0i64 { return "+"; } if op == 1i64 { return "-"; } return "*"; }

// ── string table (for builtin-on-null templates) ─────────────────────────────
fn stab(i: i64) -> str {
    if i == 0i64 { return ""; }
    if i == 1i64 { return "ab"; }
    if i == 2i64 { return "abc"; }
    if i == 3i64 { return "xy"; }
    return "aXbc";
}
fn NSTAB() -> i64 { return 5i64; }
fn sub_of(i: i64) -> str { if i == 0i64 { return "a"; } if i == 1i64 { return "ab"; } if i == 2i64 { return "b"; } return "z"; }

// ── oracle data: per source, flat val[n*3] + pres[n*3] (pres 0 = MISSING) ─────
// plus one string field per row: sidx[n] (-1 = MISSING, else index into stab).
struct Src { val: Vec<i64>, pres: Vec<i64>, sidx: Vec<i64>, n: i64 }
fn src_new() -> Src { return Src { val: vec_new::<i64>(), pres: vec_new::<i64>(), sidx: vec_new::<i64>(), n: 0i64 }; }
fn src_field(s: &Src, row: i64, f: i64) -> OVal {
    if s.pres.get(row * 3i64 + f) == 0i64 { return onull(); }
    return oint(s.val.get(row * 3i64 + f));
}
// str field OVal-analogue: k=0 Null, else k=1 with i = sidx.
fn src_str(s: &Src, row: i64) -> OVal {
    let sx: i64 = s.sidx.get(row);
    if sx < 0i64 { return onull(); }
    return oint(sx);
}
// generate n rows: each field present with prob 3/5, value in [0,vrange).
fn gen_src(rng: &mut Rng, n: i64, vrange: i64) -> Src {
    let mut s: Src = src_new();
    s.n = n;
    let mut i: i64 = 0i64;
    while i < n * 3i64 {
        let present: bool = rng.upto(5i64) < 3i64;
        if present { s.pres.push(1i64); s.val.push(rng.upto(vrange)); }
        else       { s.pres.push(0i64); s.val.push(0i64); }
        i = i + 1i64;
    }
    let mut r: i64 = 0i64;
    while r < n {
        if rng.upto(5i64) < 3i64 { s.sidx.push(rng.upto(NSTAB())); } else { s.sidx.push(-1i64); }
        r = r + 1i64;
    }
    return s;
}

// ── build the ENGINE-side erased source (array of string-keyed maps) ──────────
// field names: f0/f1/f2 for T, g0/g1/g2 for U.
fn build_erased(d: &Writ, s: &Src, prefix: str, with_str: bool) -> WAny {
    let arr: &mut WArray<WAny> = d.array(s.n + 1i64);
    let mut i: i64 = 0i64;
    while i < s.n {
        let m: &mut WMap<WString, WAny> = d.map(4i64);
        let mut f: i64 = 0i64;
        while f < 3i64 {
            if s.pres.get(i * 3i64 + f) != 0i64 {
                let mut key: String = String::new();
                key.push_str(prefix); key.push_i64(f);
                m.set(sview(&key), s.val.get(i * 3i64 + f));
            }
            f = f + 1i64;
        }
        if with_str && s.sidx.get(i) >= 0i64 { m.set("s", stab(s.sidx.get(i))); }
        arr.push(WAny::from(&*m));
        i = i + 1i64;
    }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

// ── null-aware result multiset: parallel (val,nullflag) cells, width nc ───────
struct Cells { v: Vec<i64>, nul: Vec<i64>, nc: i64 }
fn cells_new(nc: i64) -> Cells { return Cells { v: vec_new::<i64>(), nul: vec_new::<i64>(), nc: nc }; }
fn cells_push(c: &mut Cells, o: OVal) {
    if o.k == 0i64 { c.v.push(0i64); c.nul.push(1i64); }
    else           { c.v.push(o.i); c.nul.push(0i64); }
}
fn cells_nrows(c: &Cells) -> i64 { if c.nc == 0i64 { return 0i64; } return c.v.len() / c.nc; }

// compare two cells (row i of A vs row j of B) lexicographically: nullflag then value
fn crow_lt(a: &Cells, i: i64, b: &Cells, j: i64) -> bool {
    let mut c: i64 = 0i64;
    while c < a.nc {
        let an: i64 = a.nul.get(i * a.nc + c); let bn: i64 = b.nul.get(j * a.nc + c);
        if an < bn { return true; } if an > bn { return false; }
        if an == 0i64 {
            let av: i64 = a.v.get(i * a.nc + c); let bv: i64 = b.v.get(j * a.nc + c);
            if av < bv { return true; } if av > bv { return false; }
        }
        c = c + 1i64;
    }
    return false;
}
fn crow_eq(a: &Cells, i: i64, b: &Cells, j: i64) -> bool {
    let mut c: i64 = 0i64;
    while c < a.nc {
        if a.nul.get(i * a.nc + c) != b.nul.get(j * a.nc + c) { return false; }
        if a.nul.get(i * a.nc + c) == 0i64 {
            if a.v.get(i * a.nc + c) != b.v.get(j * a.nc + c) { return false; }
        }
        c = c + 1i64;
    }
    return true;
}
// selection sort rows of a Cells in place (by crow_lt against itself)
fn cells_swap(a: &mut Cells, i: i64, j: i64) {
    let mut c: i64 = 0i64;
    while c < a.nc {
        let tv: i64 = a.v.get(i * a.nc + c); a.v.set(i * a.nc + c, a.v.get(j * a.nc + c)); a.v.set(j * a.nc + c, tv);
        let tn: i64 = a.nul.get(i * a.nc + c); a.nul.set(i * a.nc + c, a.nul.get(j * a.nc + c)); a.nul.set(j * a.nc + c, tn);
        c = c + 1i64;
    }
}
fn cells_sort(a: &mut Cells) {
    if a.nc <= 0i64 { return; }
    let nr: i64 = cells_nrows(a);
    let mut i: i64 = 0i64;
    while i < nr {
        let mut m: i64 = i; let mut j: i64 = i + 1i64;
        while j < nr { if crow_lt(a, j, a, m) { m = j; } j = j + 1i64; }
        if m != i { cells_swap(a, i, m); }
        i = i + 1i64;
    }
}
fn cells_eq(a: &mut Cells, b: &mut Cells) -> bool {
    if a.nc != b.nc { return false; }
    if a.v.len() != b.v.len() { return false; }
    cells_sort(a); cells_sort(b);
    let nr: i64 = cells_nrows(a);
    let mut i: i64 = 0i64;
    while i < nr { if !crow_eq(a, i, b, i) { return false; } i = i + 1i64; }
    return true;
}

// extract QRows into null-aware Cells
fn eng_cells(r: &QRows, nc: i64) -> Cells {
    let mut out: Cells = cells_new(nc);
    let nr: i64 = r.row_count();
    let mut i: i64 = 0i64;
    while i < nr {
        let mut c: i64 = 0i64;
        while c < nc {
            if r.is_null(i, c) { out.v.push(0i64); out.nul.push(1i64); }
            else               { out.v.push(r.get_i64(i, c)); out.nul.push(0i64); }
            c = c + 1i64;
        }
        i = i + 1i64;
    }
    return out;
}

fn pushf(q: &mut String, var: str, prefix: str, f: i64) { q.push_str(var); q.push_str("."); q.push_str(prefix); q.push_i64(f); }

fn contains_ov(c: &Cells, o: OVal) -> bool {
    let nr: i64 = cells_nrows(c);
    let mut i: i64 = 0i64;
    while i < nr {
        if o.k == 0i64 { if c.nul.get(i) == 1i64 { return true; } }
        else { if c.nul.get(i) == 0i64 && c.v.get(i) == o.i { return true; } }
        i = i + 1i64;
    }
    return false;
}

fn main() -> i32 {
    let mut rng: Rng = Rng { s: 0x51E7A3B9C4D6F208u64 };
    let c: SchemaCatalog = cat();

    let NITER: i64 = 4000i64;
    let MAXROWS: i64 = 7i64;

    let mut it: i64 = 0i64;
    while it < NITER {
        let tmpl: i64 = rng.upto(14i64);
        let VRANGE: i64 = rng.range(2i64, 5i64);
        let na: i64 = rng.upto(MAXROWS);
        let nb: i64 = rng.upto(MAXROWS);
        let ts: Src = gen_src(&mut rng, na, VRANGE);
        let us: Src = gen_src(&mut rng, nb, VRANGE);

        let d: Writ = writ_new(16384i64);
        let tsrc: WAny = build_erased(&d, &ts, "f", true);
        let usrc: WAny = build_erased(&d, &us, "g", false);
        let mut env: QEnv = QEnv::new();
        env.bind_source_erased("T", tsrc);
        env.bind_source_erased("U", usrc);

        let mut qt: String = String::new();
        let mut want: Cells = cells_new(1i64);
        let mut nc: i64 = 1i64;

        if tmpl == 0i64 {
            // cmp filter: from T t where t.f{i} {op} {C} select (t.f{j}, t.f{k})
            let i: i64 = rng.upto(3i64); let op: i64 = rng.upto(6i64); let cc: i64 = rng.upto(VRANGE);
            let j: i64 = rng.upto(3i64); let k: i64 = rng.upto(3i64);
            nc = 2i64; want = cells_new(2i64);
            qt.push_str("from T t where "); pushf(&mut qt, "t", "f", i);
            qt.push_str(" "); qt.push_str(op_str(op)); qt.push_str(" "); qt.push_i64(cc);
            qt.push_str(" select ("); pushf(&mut qt, "t", "f", j); qt.push_str(", "); pushf(&mut qt, "t", "f", k); qt.push_str(")");
            let mut r: i64 = 0i64;
            while r < na {
                if o_cmp(src_field(&ts, r, i), op, oint(cc)) {
                    cells_push(&mut want, src_field(&ts, r, j));
                    cells_push(&mut want, src_field(&ts, r, k));
                }
                r = r + 1i64;
            }
        } else if tmpl == 1i64 {
            // arith select: from T t select (t.f{i} {aop} {C}, t.f{j} {aop2} t.f{k})
            let i: i64 = rng.upto(3i64); let aop: i64 = rng.upto(3i64); let cc: i64 = rng.upto(VRANGE);
            let j: i64 = rng.upto(3i64); let aop2: i64 = rng.upto(3i64); let k: i64 = rng.upto(3i64);
            nc = 2i64; want = cells_new(2i64);
            qt.push_str("from T t select ("); pushf(&mut qt, "t", "f", i);
            qt.push_str(" "); qt.push_str(arith_str(aop)); qt.push_str(" "); qt.push_i64(cc);
            qt.push_str(", "); pushf(&mut qt, "t", "f", j); qt.push_str(" "); qt.push_str(arith_str(aop2)); qt.push_str(" "); pushf(&mut qt, "t", "f", k);
            qt.push_str(")");
            let mut r: i64 = 0i64;
            while r < na {
                cells_push(&mut want, o_arith(src_field(&ts, r, i), aop, oint(cc)));
                cells_push(&mut want, o_arith(src_field(&ts, r, j), aop2, src_field(&ts, r, k)));
                r = r + 1i64;
            }
        } else if tmpl == 2i64 {
            // bare-field truthy where: from T t where t.f{i} select t.f{j}
            let i: i64 = rng.upto(3i64); let j: i64 = rng.upto(3i64);
            nc = 1i64; want = cells_new(1i64);
            qt.push_str("from T t where "); pushf(&mut qt, "t", "f", i);
            qt.push_str(" select "); pushf(&mut qt, "t", "f", j);
            let mut r: i64 = 0i64;
            while r < na {
                if o_truthy(src_field(&ts, r, i)) { cells_push(&mut want, src_field(&ts, r, j)); }
                r = r + 1i64;
            }
        } else if tmpl == 3i64 {
            // eq-null: from T t where t.f{i} == t.f{j} select t.f{k}  (both missing -> true)
            let i: i64 = rng.upto(3i64); let j: i64 = rng.upto(3i64); let k: i64 = rng.upto(3i64);
            nc = 1i64; want = cells_new(1i64);
            qt.push_str("from T t where "); pushf(&mut qt, "t", "f", i); qt.push_str(" == "); pushf(&mut qt, "t", "f", j);
            qt.push_str(" select "); pushf(&mut qt, "t", "f", k);
            let mut r: i64 = 0i64;
            while r < na {
                if o_cmp(src_field(&ts, r, i), 0i64, src_field(&ts, r, j)) { cells_push(&mut want, src_field(&ts, r, k)); }
                r = r + 1i64;
            }
        } else if tmpl == 4i64 {
            // ne-null: from T t where t.f{i} != t.f{j} select t.f{k}  (both missing -> false)
            let i: i64 = rng.upto(3i64); let j: i64 = rng.upto(3i64); let k: i64 = rng.upto(3i64);
            nc = 1i64; want = cells_new(1i64);
            qt.push_str("from T t where "); pushf(&mut qt, "t", "f", i); qt.push_str(" != "); pushf(&mut qt, "t", "f", j);
            qt.push_str(" select "); pushf(&mut qt, "t", "f", k);
            let mut r: i64 = 0i64;
            while r < na {
                if o_cmp(src_field(&ts, r, i), 1i64, src_field(&ts, r, j)) { cells_push(&mut want, src_field(&ts, r, k)); }
                r = r + 1i64;
            }
        } else if tmpl == 5i64 {
            // ternary select: from T t select (t.f{i} > {C} ? t.f{j} : t.f{k})
            let i: i64 = rng.upto(3i64); let cc: i64 = rng.upto(VRANGE); let j: i64 = rng.upto(3i64); let k: i64 = rng.upto(3i64);
            nc = 1i64; want = cells_new(1i64);
            qt.push_str("from T t select ("); pushf(&mut qt, "t", "f", i); qt.push_str(" > "); qt.push_i64(cc);
            qt.push_str(" ? "); pushf(&mut qt, "t", "f", j); qt.push_str(" : "); pushf(&mut qt, "t", "f", k); qt.push_str(")");
            let mut r: i64 = 0i64;
            while r < na {
                let cond: bool = o_cmp(src_field(&ts, r, i), 4i64, oint(cc));
                if cond { cells_push(&mut want, src_field(&ts, r, j)); } else { cells_push(&mut want, src_field(&ts, r, k)); }
                r = r + 1i64;
            }
        } else if tmpl == 6i64 {
            // group by dyn key (nulls coalesce): from T t group by t.f{g} aggregate c=count() select (key, c)
            let g: i64 = rng.upto(3i64);
            nc = 2i64; want = cells_new(2i64);
            qt.push_str("from T t group by "); pushf(&mut qt, "t", "f", g);
            qt.push_str(" aggregate c = count() select (key, c)");
            let mut keys: Vec<i64> = vec_new::<i64>();   // parallel key val + null
            let mut keyn: Vec<i64> = vec_new::<i64>();
            let mut cnts: Vec<i64> = vec_new::<i64>();
            let mut r: i64 = 0i64;
            while r < na {
                let kv: OVal = src_field(&ts, r, g);
                let mut gi: i64 = -1i64;
                let mut x: i64 = 0i64;
                while x < keys.len() {
                    let ek: OVal = if keyn.get(x) == 1i64 { onull() } else { oint(keys.get(x)) };
                    if o_eq(ek, kv) { gi = x; break; }
                    x = x + 1i64;
                }
                if gi < 0i64 {
                    gi = keys.len();
                    if kv.k == 0i64 { keys.push(0i64); keyn.push(1i64); } else { keys.push(kv.i); keyn.push(0i64); }
                    cnts.push(0i64);
                }
                cnts.set(gi, cnts.get(gi) + 1i64);
                r = r + 1i64;
            }
            let mut ki: i64 = 0i64;
            while ki < keys.len() {
                if keyn.get(ki) == 1i64 { cells_push(&mut want, onull()); } else { cells_push(&mut want, oint(keys.get(ki))); }
                cells_push(&mut want, oint(cnts.get(ki)));
                ki = ki + 1i64;
            }
        } else if tmpl == 7i64 {
            // distinct: from T t select distinct t.f{i}  (nulls coalesce to one)
            let i: i64 = rng.upto(3i64);
            nc = 1i64; want = cells_new(1i64);
            qt.push_str("from T t select distinct "); pushf(&mut qt, "t", "f", i);
            let mut r: i64 = 0i64;
            while r < na {
                let ov: OVal = src_field(&ts, r, i);
                if !contains_ov(&want, ov) { cells_push(&mut want, ov); }
                r = r + 1i64;
            }
        } else if tmpl == 8i64 {
            // join on dyn key: from T t join U u on t.f{i}==u.g{j} select (t.f{k}, u.g{l})
            let i: i64 = rng.upto(3i64); let j: i64 = rng.upto(3i64); let k: i64 = rng.upto(3i64); let l: i64 = rng.upto(3i64);
            nc = 2i64; want = cells_new(2i64);
            qt.push_str("from T t join U u on "); pushf(&mut qt, "t", "f", i); qt.push_str(" == "); pushf(&mut qt, "u", "g", j);
            qt.push_str(" select ("); pushf(&mut qt, "t", "f", k); qt.push_str(", "); pushf(&mut qt, "u", "g", l); qt.push_str(")");
            let mut ra: i64 = 0i64;
            while ra < na {
                let mut rb: i64 = 0i64;
                while rb < nb {
                    if o_cmp(src_field(&ts, ra, i), 0i64, src_field(&us, rb, j)) {
                        cells_push(&mut want, src_field(&ts, ra, k));
                        cells_push(&mut want, src_field(&us, rb, l));
                    }
                    rb = rb + 1i64;
                }
                ra = ra + 1i64;
            }
        } else if tmpl == 9i64 {
            // anti join: from T t anti join U u on t.f{i}==u.g{j} select t.f{k}
            let i: i64 = rng.upto(3i64); let j: i64 = rng.upto(3i64); let k: i64 = rng.upto(3i64);
            nc = 1i64; want = cells_new(1i64);
            qt.push_str("from T t anti join U u on "); pushf(&mut qt, "t", "f", i); qt.push_str(" == "); pushf(&mut qt, "u", "g", j);
            qt.push_str(" select "); pushf(&mut qt, "t", "f", k);
            let mut ra: i64 = 0i64;
            while ra < na {
                let mut hit: bool = false;
                let mut rb: i64 = 0i64;
                while rb < nb { if o_cmp(src_field(&ts, ra, i), 0i64, src_field(&us, rb, j)) { hit = true; } rb = rb + 1i64; }
                if !hit { cells_push(&mut want, src_field(&ts, ra, k)); }
                ra = ra + 1i64;
            }
        } else if tmpl == 10i64 {
            // builtin contains on maybe-null string: from T t where contains(t.s, "{sub}") select t.f{k}
            // missing s -> Null arg -> Null result -> truthy false -> row dropped.
            let sb: i64 = rng.upto(4i64); let k: i64 = rng.upto(3i64);
            nc = 1i64; want = cells_new(1i64);
            qt.push_str("from T t where contains(t.s, \""); qt.push_str(sub_of(sb)); qt.push_str("\") select "); pushf(&mut qt, "t", "f", k);
            let mut r: i64 = 0i64;
            while r < na {
                let so: OVal = src_str(&ts, r);
                let keep: bool = if so.k == 0i64 { false } else { str_contains(stab(so.i), sub_of(sb)) };
                if keep { cells_push(&mut want, src_field(&ts, r, k)); }
                r = r + 1i64;
            }
        } else if tmpl == 11i64 {
            // builtin starts_with on maybe-null string
            let sb: i64 = rng.upto(4i64); let k: i64 = rng.upto(3i64);
            nc = 1i64; want = cells_new(1i64);
            qt.push_str("from T t where starts_with(t.s, \""); qt.push_str(sub_of(sb)); qt.push_str("\") select "); pushf(&mut qt, "t", "f", k);
            let mut r: i64 = 0i64;
            while r < na {
                let so: OVal = src_str(&ts, r);
                let keep: bool = if so.k == 0i64 { false } else { str_starts_with(stab(so.i), sub_of(sb)) };
                if keep { cells_push(&mut want, src_field(&ts, r, k)); }
                r = r + 1i64;
            }
        } else if tmpl == 12i64 {
            // builtin len on maybe-null string, compared: len(t.s) {op} {C}
            // missing s -> len(Null) -> Null -> Null {op} C per ADR table.
            let op: i64 = rng.upto(6i64); let cc: i64 = rng.upto(4i64); let k: i64 = rng.upto(3i64);
            nc = 1i64; want = cells_new(1i64);
            qt.push_str("from T t where len(t.s) "); qt.push_str(op_str(op)); qt.push_str(" "); qt.push_i64(cc);
            qt.push_str(" select "); pushf(&mut qt, "t", "f", k);
            let mut r: i64 = 0i64;
            while r < na {
                let so: OVal = src_str(&ts, r);
                let lo: OVal = if so.k == 0i64 { onull() } else { oint(stab(so.i).len()) };
                if o_cmp(lo, op, oint(cc)) { cells_push(&mut want, src_field(&ts, r, k)); }
                r = r + 1i64;
            }
        } else {
            // COMPOSED null: arithmetic feeds a comparison — (t.f{i} {aop} t.f{j}) {op} {C}
            // any null operand -> Null sum -> Null {op} C  (ordering/==: false, !=: true)
            let i: i64 = rng.upto(3i64); let aop: i64 = rng.upto(3i64); let j: i64 = rng.upto(3i64);
            let op: i64 = rng.upto(6i64); let cc: i64 = rng.upto(2i64 * VRANGE); let k: i64 = rng.upto(3i64);
            nc = 1i64; want = cells_new(1i64);
            qt.push_str("from T t where ("); pushf(&mut qt, "t", "f", i); qt.push_str(" "); qt.push_str(arith_str(aop));
            qt.push_str(" "); pushf(&mut qt, "t", "f", j); qt.push_str(") "); qt.push_str(op_str(op)); qt.push_str(" "); qt.push_i64(cc);
            qt.push_str(" select "); pushf(&mut qt, "t", "f", k);
            let mut r: i64 = 0i64;
            while r < na {
                let lhs: OVal = o_arith(src_field(&ts, r, i), aop, src_field(&ts, r, j));
                if o_cmp(lhs, op, oint(cc)) { cells_push(&mut want, src_field(&ts, r, k)); }
                r = r + 1i64;
            }
        }

        let q: Query = match Query::compile(qt.as_str(), &c) {
            Result::Ok(v) => { v } Result::Err(_e) => { return 20i32 + (tmpl as i32); }
        };
        let rows: QRows = match q.run(&env) {
            Result::Ok(v) => { v } Result::Err(_e2) => { return 40i32 + (tmpl as i32); }
        };
        if rows.col_count() != nc { return 60i32 + (tmpl as i32); }
        let mut got: Cells = eng_cells(&rows, nc);
        if !cells_eq(&mut want, &mut got) { return 80i32 + (tmpl as i32); }

        it = it + 1i64;
    }
    return 0i32;
}

fn sview(s: &String) -> str { return unsafe { str_from_raw(s.as_ptr(), s.len()) }; }
