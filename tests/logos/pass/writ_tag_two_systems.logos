package h2tag;
// PROOF: the SAME type_code (171) lives in TWO tag systems with model-specific
// impls — no collision. A stateful node holds an internal pointer to a Leaf;
// the Writ1 impl resolves it BASE-RELATIVE (base + offset), the Writ impl
// resolves it SELF-RELATIVE (RelAny materialise). Dispatch is keyed by
// (system, type_code), so both coexist and each resolves its inner pointer right.
use logos.lang.ptr;
use logos.mem.writ.tag_system;
extern fn malloc(size: i64) -> *mut u8;

#[rel_ptr] struct RelAny { _o: i64 }                 // type-erased self-relative ptr

#[type_code=170] #[datatype] struct Leaf { v: i32 }

// ── Writ1 world: inner pointer = base-relative u32 offset ───────────────────
#[tag_dispatch(WritTypeTagSystem)] trait SumH1 { unsafe fn total(self: *const Self, base: *const u8) -> i32; }
#[type_code=171] #[datatype] struct NodeH1 { val: i32, leaf_off: u32 }
impl SumH1 for NodeH1 {
    pub unsafe fn total(self: *const NodeH1, base: *const u8) -> i32 {
        let leaf: *const Leaf = base.byte_add(self.leaf_off as i64) as *const Leaf;  // base + off
        return self.val + leaf.v;
    }
}

// ── Writ world: inner pointer = self-relative RelAny — SAME type_code 171 ───
#[tag_dispatch(WritTagSystem)] trait SumH2 { unsafe fn total(self: *const Self) -> i32; }
#[type_code=171] #[datatype] struct NodeH2 { val: i32, leaf: RelAny }
impl SumH2 for NodeH2 {
    pub unsafe fn total(self: *const NodeH2) -> i32 {
        let lp: *const u8 = self.leaf;               // self-relative materialise (&self.leaf + off)
        let leaf: *const Leaf = lp as *const Leaf;
        return self.val + leaf.v;
    }
}

unsafe fn dispatch_h1(o: *const u8, base: *const u8) -> i32 {
    let t: &tagged<WritTypeTagSystem> SumH1 = o;   // h1 table, code 171 → NodeH1::total
    return t.total(base);
}
unsafe fn dispatch_h2(o: *const u8) -> i32 {
    let t: &tagged<WritTagSystem> SumH2 = o;      // h2 table, code 171 → NodeH2::total
    return t.total();
}

unsafe fn main() -> i32 {
    let base: *mut u8 = malloc(256i64);

    // ── Writ1: Leaf{5} at base+64; NodeH1{val:10, leaf_off:64} at base+96 ──
    let l1o: *mut u8 = base.byte_add(64i64);  write_tag(l1o, type_code_of::<Leaf>());
    let l1p: *mut Leaf = l1o as *mut Leaf;  l1p.v = 5i32;
    let n1o: *mut u8 = base.byte_add(96i64);  write_tag(n1o, type_code_of::<NodeH1>());
    let n1: *mut NodeH1 = n1o as *mut NodeH1;  n1.val = 10i32;  n1.leaf_off = 64u32;
    if dispatch_h1(n1o as *const u8, base as *const u8) != 15i32 { return 1i32; }   // 10 + 5

    // ── Writ: Leaf{5} at base+160; NodeH2{val:20, leaf:->leaf} at base+192 ──
    let l2o: *mut u8 = base.byte_add(160i64);  write_tag(l2o, type_code_of::<Leaf>());
    let l2p: *mut Leaf = l2o as *mut Leaf;  l2p.v = 5i32;
    let n2o: *mut u8 = base.byte_add(192i64);  write_tag(n2o, type_code_of::<NodeH2>());
    let n2: *mut NodeH2 = n2o as *mut NodeH2;  n2.val = 20i32;
    n2.leaf = l2o as *const u8;                                                      // self-relative lower
    if dispatch_h2(n2o as *const u8) != 25i32 { return 2i32; }                       // 20 + 5

    // sanity: both NodeH1 and NodeH2 carry the SAME type_code 171
    if type_code_of::<NodeH1>() != type_code_of::<NodeH2>() { return 3i32; }
    return 0i32;
}
