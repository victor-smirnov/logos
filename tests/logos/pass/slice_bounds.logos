package slice_bounds;
// Edge case: slice operations at bounds (first, last), length of different sizes
fn sum_between(s: &[i32], lo: i64, hi: i64) -> i32 {
    let mut t: i32 = 0;
    let mut i: i64 = lo;
    while i < hi && i < s.len() {
        t = t + s[i];
        i = i + 1;
    }
    return t;
}

unsafe fn main() -> i32 {
    let data: [i32; 5] = [3, 7, 12, 5, 15];
    let s: &[i32] = &data;
    // sum_between(s, 0, 3) = 3+7+12 = 22
    let a: i32 = sum_between(s, 0, 3);
    // sum_between(s, 2, 5) = 12+5+15 = 32
    let b: i32 = sum_between(s, 2, 5);
    // a+b = 54 - 12 = 42 (12 counted twice)
    return a + b - 12;
}
