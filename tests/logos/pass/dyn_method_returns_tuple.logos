package dyn_method_returns_tuple;
use logos.mem.boxed;
trait Pair { fn pair(&self, k: i64) -> (i64, i64); fn trip(&self) -> (i32, i64, i32); }
struct A { x: i64 }
impl Pair for A {
    fn pair(&self, k: i64) -> (i64, i64) { return (self.x, self.x * k); }
    fn trip(&self) -> (i32, i64, i32) { return (1, self.x, 3); }
}
fn main() -> i32 {
    let a = A { x: 6 };
    let d: &dyn Pair = &a;
    let p = d.pair(7);
    if p.0 != 6 || p.1 != 42 { return 1; }
    let b: Box<dyn Pair> = Box::new(A { x: 9 });
    let t = b.trip();
    if t.0 != 1 || t.1 != 9 || t.2 != 3 { return 2; }
    return 0;
}
