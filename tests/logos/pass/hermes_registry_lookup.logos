// Dispatch-table registry lookup (hermes2 successor of the Hermes1 registry
// test): #[tag_dispatch] generates a (type_code -> impl fn-ptr) table; the
// __logos_dispatch_lookup__ entry point resolves registered codes and returns
// null for unregistered ones.
package hermes_registry_lookup;
use logos.lang.hermes2.anyval;
use logos.mem.hermes2.tag_system;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

#[tag_dispatch(DataTypeTagSystem)]
pub trait Describe {
    unsafe fn describe(self: *const Self) -> i32;
}

#[zoned] struct Imp { v: i32 }

impl Describe for Imp {
    pub unsafe fn describe(self: *const Imp) -> i32 { return self.v + 1; }
}

extern fn __logos_dispatch_lookup__DataTypeTagSystem__Describe__describe(
    code: u64) -> *const u8;

unsafe fn main() -> i32 {
    let tc: u64 = type_code_of::<Imp>();
    if tc < 129u64 { return 1; }

    // Registered code resolves to a non-null impl pointer.
    let f_raw: *const u8 =
        __logos_dispatch_lookup__DataTypeTagSystem__Describe__describe(tc);
    if f_raw == (0 as *const u8) { return 2; }

    // Unregistered code returns null.
    let miss: *const u8 =
        __logos_dispatch_lookup__DataTypeTagSystem__Describe__describe(99999u64);
    if miss != (0 as *const u8) { return 3; }

    // The resolved pointer is callable with the impl ABI.
    let buf: *mut u8 = malloc(64);
    let obj: *mut Imp = (buf as i64 + 16) as *mut Imp;
    write_tag(obj as *mut u8, tc);
    obj.v = 41;
    let f: fn(*const u8) -> i32 = f_raw as fn(*const u8) -> i32;
    let got: i32 = f(obj as *const u8);
    free(buf);
    if got != 42 { return 4; }
    return 0;
}
