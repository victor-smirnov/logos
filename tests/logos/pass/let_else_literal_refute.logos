package let_else_literal_refute;
// G154-5 (silent miscompile): a refutable literal/range pattern in `let … else`
// never refuted — a non-enum scrutinee always fell into the match arm, so the
// else branch was dead. Now the let-else codegen tests the value (== literal /
// range) and branches to else on mismatch.
fn t(x: i64) -> i64 {
    let 4i64 = x else { return 99i64; };
    return 42i64;
}
fn r(x: i64) -> i64 {
    let 1i64..=5i64 = x else { return -1i64; };
    return 7i64;
}
fn main() -> i64 {
    if t(5i64) != 99 { return 1; }
    if t(4i64) != 42 { return 2; }
    if r(3i64) != 7 { return 3; }
    if r(9i64) != -1 { return 4; }
    return 0;
}
