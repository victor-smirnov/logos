// `Iterator::max_by_key` / `min_by_key` are methods (only free fns over `T: Copy` existed). The key
// closure borrows the item (`FnMut(&Item) -> K`); of equal keys `max_by_key` keeps the last and
// `min_by_key` the first, as in Rust. `-x` on an `&i32` is Rust's `impl Neg for &i32`, and `p.1` on a
// `p: &&(i32, i32)` auto-derefs through both references.
// rustc twin: 0.
package iter_max_min_by_key_methods;
use logos.mem.collections.vec;
use logos.mem.string;
fn main() -> i32 {
    let v: Vec<i32> = vec![3, 1, 4, 1, 5, 9, 2];
    let m = v.into_iter().max_by_key(|x| -x);
    match m { Option::Some(x) => { if x != 1 { return 1; } } Option::None => { return 2; } }
    let pairs: Vec<(i32, i32)> = vec![(1, 7), (2, 9), (3, 9), (4, 0)];
    match pairs.iter().max_by_key(|p| p.1) {
        Option::Some(p) => { if p.0 != 3 { return 3; } }
        Option::None => { return 4; }
    }
    match pairs.iter().min_by_key(|p| p.1 / 9) {
        Option::Some(p) => { if p.0 != 1 { return 5; } }
        Option::None => { return 6; }
    }
    let mut words: Vec<String> = Vec::<String>::new();
    words.push(String::from("bb")); words.push(String::from("a")); words.push(String::from("ccc"));
    match words.into_iter().min_by_key(|s| s.len()) {
        Option::Some(s) => { if s.len() != 1i64 { return 7; } }
        Option::None => { return 8; }
    }
    let e: Vec<i32> = Vec::<i32>::new();
    if e.iter().max_by_key(|x| **x).is_some() { return 9; }
    return 0;
}
