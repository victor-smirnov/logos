// query_incr_join_fuzz — property-based DIFFERENTIAL test for the slice-1
// incremental engine (ADR 0013 §9.3). A DETERMINISTIC LCG (NOT host RNG —
// the test is a Logos program) drives a battery of seeds; each seed runs a
// multi-epoch (T=12) sequence of random ±insert/±delete deltas split across
// both sources over a SMALL key domain (forced join-key collisions + bag
// multiplicity), mirrored into a truth model. After EVERY epoch the maintained
// engine state is compared, as a weighted multiset at quiescence, against the
// queue-2 batch oracle recomputed from the clamped truth. Any divergence ⇒
// nonzero exit. Run as an outer 2×2 over {collapsing d.dname, injective
// (d.dname,e.name)} × {select, select distinct}.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.lang.arith;
use logos.mem.collections.vec;

pub schema Emp : code(0x0E02_0000_0000_0001) {
    name: str = 0,
    dept: i64 = 1,
    val:  i64 = 2,
}
pub schema Dept : code(0x0E02_0000_0000_0002) {
    id:    i64 = 0,
    dname: str = 1,
}

resource cat = schema_catalog!{ Emp, Dept };

fn mk_emp(d: &Writ, name: str, dept: i64, val: i64) -> WAny {
    let e: Emp = d.make::<Emp>();
    e.name = name; e.dept = dept; e.val = val;
    return WAny::ref_to((e.m as i64) as *const u8);
}
fn mk_dept(d: &Writ, id: i64, dname: str) -> WAny {
    let x: Dept = d.make::<Dept>();
    x.id = id; x.dname = dname;
    return WAny::ref_to((x.m as i64) as *const u8);
}

// ── Deterministic LCG (Knuth MMIX constants); high bits via >>33 ─────────────
struct Lcg { s: u64 }
impl Lcg {
    fn next(self: &mut Lcg) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
}
fn lcg_seed(seed: u64) -> Lcg {
    let mut l: Lcg = Lcg { s: wrapping_add(wrapping_mul(seed, 2862933555777941757u64), 3037000493u64) };
    let _w0: u64 = l.next();
    let _w1: u64 = l.next();
    return l;
}
fn rand_n(l: &mut Lcg, n: i64) -> i64 {
    if n <= 0i64 { return 0i64; }
    return (l.next() % (n as u64)) as i64;
}

// Effective-delta discipline (U1).
fn src_apply(hs: &Vec<WAny>, wts: &mut Vec<i64>, batch: &mut ZBatch, idx: i64, raw: i64) {
    let old: i64 = wts.get(idx);
    let mut neww: i64 = old + raw;
    if neww < 0i64 { neww = 0i64; }
    let eff: i64 = neww - old;
    wts.set(idx, neww);
    if eff != 0i64 { batch.push(hs.get(idx), eff); }
}

fn build_src(d: &Writ, hs: &Vec<WAny>, wts: &Vec<i64>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(256i64);
    let n: i64 = hs.len();
    let mut i: i64 = 0i64;
    while i < n {
        let w: i64 = wts.get(i);
        let mut k: i64 = 0i64;
        while k < w { arr.push(hs.get(i)); k = k + 1i64; }
        i = i + 1i64;
    }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

fn qrow_eq(a: &QRows, ai: i64, b: &QRows, bi: i64) -> bool {
    let nc: i64 = a.col_count();
    let mut c: i64 = 0i64;
    while c < nc {
        let ty: str = a.col_ty(c);
        if a.is_null(ai, c) != b.is_null(bi, c) { return false; }
        if str_eq(ty, "str") {
            if !str_eq(a.get_str(ai, c), b.get_str(bi, c)) { return false; }
        } else if str_eq(ty, "i64") {
            if a.get_i64(ai, c) != b.get_i64(bi, c) { return false; }
        } else if str_eq(ty, "bool") {
            if a.get_bool(ai, c) != b.get_bool(bi, c) { return false; }
        } else if str_eq(ty, "f64") {
            // avg is bit-exact here: both sides sum integer-valued args (≪ 2^53)
            // and divide once — batch sums in f64, incremental sums in i64 then
            // casts; identical bits ⇒ exact == (no epsilon).
            if a.get_f64(ai, c) != b.get_f64(bi, c) { return false; }
        } else {
            return false;
        }
        c = c + 1i64;
    }
    return true;
}

fn multiset_eq(a: &QRows, b: &QRows) -> bool {
    if a.row_count() != b.row_count() { return false; }
    if a.col_count() != b.col_count() { return false; }
    let n: i64 = a.row_count();
    let mut used: Vec<bool> = vec_new::<bool>();
    let mut i: i64 = 0i64;
    while i < n { used.push(false); i = i + 1i64; }
    let mut ai: i64 = 0i64;
    while ai < n {
        let mut found: bool = false;
        let mut bi: i64 = 0i64;
        while bi < n && !found {
            if !used.get(bi) {
                if qrow_eq(a, ai, b, bi) { used.set(bi, true); found = true; }
            }
            bi = bi + 1i64;
        }
        if !found { return false; }
        ai = ai + 1i64;
    }
    return true;
}

fn cmp(eng: &IncrJoin, q: &Query, doc: &Writ, eh: &Vec<WAny>, ew: &Vec<i64>,
       dh: &Vec<WAny>, dw: &Vec<i64>, oenv: &mut QEnv) -> bool {
    let es: WAny = build_src(doc, eh, ew);
    let ds: WAny = build_src(doc, dh, dw);
    oenv.bind_source("emps", es);
    oenv.bind_source("depts", ds);
    let orc: QRows = match q.run(oenv) { Result::Ok(r) => { r } Result::Err(_e) => { return false; } };
    let snap: QRows = eng.snapshot();
    return multiset_eq(&snap, &orc);
}

// One seed → a T-epoch random sequence. Returns 0 on all-match, else 1+epoch.
fn run_seed(q: &Query, seed: u64, doc: &Writ, eh: &Vec<WAny>, dh: &Vec<WAny>) -> i32 {
    let ne: i64 = eh.len();
    let nd: i64 = dh.len();
    // base truth: emps[0..4] and depts[0..nd] present (non-empty for the tier).
    let mut ew: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < ne { if i < 4i64 { ew.push(1i64); } else { ew.push(0i64); } i = i + 1i64; }
    let mut dw: Vec<i64> = vec_new::<i64>();
    let mut j: i64 = 0i64;
    while j < nd { dw.push(1i64); j = j + 1i64; }

    let mut eng_env: QEnv = QEnv::new();
    eng_env.bind_source("emps", build_src(doc, eh, &ew));
    eng_env.bind_source("depts", build_src(doc, dh, &dw));
    let mut eng: IncrJoin = match q.incremental(&eng_env) { Result::Ok(e) => { e } Result::Err(_e2) => { return 99i32; } };

    let mut oenv: QEnv = QEnv::new();
    if !cmp(&eng, q, doc, eh, &ew, dh, &dw, &mut oenv) { return 1i32; }

    let mut lcg: Lcg = lcg_seed(seed);
    let mut ep: i64 = 0i64;
    while ep < 12i64 {
        let mut da: ZBatch = ZBatch::new();
        let mut db: ZBatch = ZBatch::new();
        let nops: i64 = 1i64 + rand_n(&mut lcg, 3i64);
        let mut o: i64 = 0i64;
        while o < nops {
            let side: i64 = rand_n(&mut lcg, 2i64);
            let raw: i64 = if rand_n(&mut lcg, 2i64) == 0i64 { 1i64 } else { -1i64 };
            if side == 0i64 {
                let idx: i64 = rand_n(&mut lcg, ne);
                src_apply(eh, &mut ew, &mut da, idx, raw);
            } else {
                let idx: i64 = rand_n(&mut lcg, nd);
                src_apply(dh, &mut dw, &mut db, idx, raw);
            }
            o = o + 1i64;
        }
        eng.epoch(&da, &db);
        if !cmp(&eng, q, doc, eh, &ew, dh, &dw, &mut oenv) { return (2i64 + ep) as i32; }
        ep = ep + 1i64;
    }
    return 0i32;
}

fn run_variant(qtext: str, c: &SchemaCatalog, doc: &Writ, eh: &Vec<WAny>, dh: &Vec<WAny>) -> i32 {
    let q: Query = match Query::compile(qtext, c) { Result::Ok(v) => { v } Result::Err(_e) => { return 98i32; } };
    let mut seed: u64 = 0u64;
    while seed < 40u64 {
        let r: i32 = run_seed(&q, seed, doc, eh, dh);
        if r != 0i32 { return r; }
        seed = seed + 1u64;
    }
    return 0i32;
}

fn main() -> i32 {
    let doc: Writ = writ_new(1048576i64);
    // emp pool: 12 handles, dept = j % 5 (dept 4 never matches → unmatched mix)
    let mut eh: Vec<WAny> = vec_new::<WAny>();
    let names: [str; 12] = ["E0","E1","E2","E3","E4","E5","E6","E7","E8","E9","EA","EB"];
    // val = (j*37)%101 — distinct, non-monotonic, uncorrelated with dept (j%5) so
    // the group extremum is NOT the lowest-index member and best-churn is real.
    // EXCEPTION: index 10 is overridden 67→84 to COLLIDE with index 5 (both dept 0),
    // giving a deliberate within-group DUPLICATE extremum: retracting one copy must
    // leave the best unchanged (count>0, no rescan), distinct from retracting the
    // last copy (rescan fires). Covers the self-critique's duplicate-of-best path.
    let vals: [i64; 12] = [0i64, 37i64, 74i64, 10i64, 47i64, 84i64, 20i64, 57i64, 94i64, 30i64, 84i64, 3i64];
    let mut j: i64 = 0i64;
    while j < 12i64 { eh.push(mk_emp(&doc, names[j], j % 5i64, vals[j])); j = j + 1i64; }
    // dept pool: 4 distinct ids 0..3
    let mut dh: Vec<WAny> = vec_new::<WAny>();
    dh.push(mk_dept(&doc, 0i64, "D0"));
    dh.push(mk_dept(&doc, 1i64, "D1"));
    dh.push(mk_dept(&doc, 2i64, "D2"));
    dh.push(mk_dept(&doc, 3i64, "D3"));

    let c: SchemaCatalog = cat();

    let r1: i32 = run_variant("from emps e join depts d on e.dept == d.id select d.dname", &c, &doc, &eh, &dh);
    if r1 != 0i32 { return 100i32 + r1; }
    let r2: i32 = run_variant("from emps e join depts d on e.dept == d.id select distinct d.dname", &c, &doc, &eh, &dh);
    if r2 != 0i32 { return 200i32 + r2; }
    let r3: i32 = run_variant("from emps e join depts d on e.dept == d.id select (d.dname, e.name)", &c, &doc, &eh, &dh);
    if r3 != 0i32 { return 300i32 + r3; }
    let r4: i32 = run_variant("from emps e join depts d on e.dept == d.id select distinct (d.dname, e.name)", &c, &doc, &eh, &dh);
    if r4 != 0i32 { return 400i32 + r4; }

    // ── slice-2 ANTI variants (§10.4 crossing; dept-4 emps E4/E9 are permanent
    // anti-output; deleting the sole supporting dept drives an emp's mc→0 = it
    // ENTERS, re-adding drives mc 0→>0 = it LEAVES). Injective + non-injective
    // (E5/E10→dept0, E4/E9→dept4 coalesce) × bag/set to pin per-row-not-per-key.
    let r5: i32 = run_variant("from emps e anti join depts d on e.dept == d.id select e.name", &c, &doc, &eh, &dh);
    if r5 != 0i32 { return 500i32 + r5; }
    let r6: i32 = run_variant("from emps e anti join depts d on e.dept == d.id select distinct e.name", &c, &doc, &eh, &dh);
    if r6 != 0i32 { return 600i32 + r6; }
    let r7: i32 = run_variant("from emps e anti join depts d on e.dept == d.id select e.dept", &c, &doc, &eh, &dh);
    if r7 != 0i32 { return 700i32 + r7; }
    let r8: i32 = run_variant("from emps e anti join depts d on e.dept == d.id select distinct e.dept", &c, &doc, &eh, &dh);
    if r8 != 0i32 { return 800i32 + r8; }

    // ── slice-3 GROUP-AGGREGATE variants (§3.1 abelian GROUP: inverse-on-retract
    // + empty-group drop). Groups = dept `j%5` over emps 0..3 base (groups
    // {0,1,2,3}); the 12-epoch ±churn drives a group gcount→0 (empty-drop) and
    // back (re-appear). The aggregate references ONLY emps — dept churn is a
    // consistent no-op on both sides (epoch ignores db, the oracle reads no dept).
    // The oracle stays Query::run (queue-2 batch group-by) from clamped truth.
    let r9: i32 = run_variant("from emps e group by e.dept aggregate cnt = count() select (key, cnt)", &c, &doc, &eh, &dh);
    if r9 != 0i32 { return 900i32 + r9; }
    // key dropped ⇒ projection coalesce + empty-group multiplicity crossing.
    let r10: i32 = run_variant("from emps e group by e.dept aggregate cnt = count() select distinct cnt", &c, &doc, &eh, &dh);
    if r10 != 0i32 { return 1000i32 + r10; }
    let r11: i32 = run_variant("from emps e group by e.dept aggregate s = sum(e.dept) select (key, s)", &c, &doc, &eh, &dh);
    if r11 != 0i32 { return 1100i32 + r11; }
    // avg — the f64-column variant (bit-exact == vs the batch oracle).
    let r12: i32 = run_variant("from emps e group by e.dept aggregate a = avg(e.dept) select (key, a)", &c, &doc, &eh, &dh);
    if r12 != 0i32 { return 1200i32 + r12; }
    // multi-aggregate (≤ the batch limit).
    let r13: i32 = run_variant("from emps e group by e.dept aggregate cnt = count(), s = sum(e.dept) select (key, cnt, s)", &c, &doc, &eh, &dh);
    if r13 != 0i32 { return 1300i32 + r13; }

    // ── slice-4 SEMILATTICE min/max variants (§3.1: O(1) improve on insert,
    // RESCAN-on-best-retraction, empty-group drop). Groups = dept j%5; the
    // distinct `val` column means the extremum is not the lowest-index member,
    // so ±churn on group members drives: delete-current-best → RE-MIN/RE-MAX to
    // the next value (trap 1); delete-all → empty-drop (trap 2); re-add a
    // smaller/larger value → O(1) improve (trap 4); the index-5/10 duplicate
    // exercises retract-one-copy-of-best-with-best-unchanged. Oracle = Query::run
    // batch min/max recomputed from clamped truth each epoch (independent).
    let r14: i32 = run_variant("from emps e group by e.dept aggregate m = min(e.val) select (key, m)", &c, &doc, &eh, &dh);
    if r14 != 0i32 { return 1400i32 + r14; }
    let r15: i32 = run_variant("from emps e group by e.dept aggregate m = max(e.val) select (key, m)", &c, &doc, &eh, &dh);
    if r15 != 0i32 { return 1500i32 + r15; }
    // mixed GROUP + SEMILATTICE columns in one query (per-column agg_fnid dispatch).
    let r16: i32 = run_variant("from emps e group by e.dept aggregate cnt = count(), lo = min(e.val), hi = max(e.val) select (key, cnt, lo, hi)", &c, &doc, &eh, &dh);
    if r16 != 0i32 { return 1600i32 + r16; }

    return 0i32;
}
