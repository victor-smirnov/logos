// audit-v2 T2-27 (complete): the remaining pattern-parse gaps.
//  • `&&pat` — double-reference pattern (`&&` is the AND token; an inner
//    PAT_REF rule lets the outer wrap a second time).
//  • `S { 0: a }` — tuple-struct field by index in struct-pattern syntax.
//  • `S { ref mut a }` — field bound `&mut`, write-back via `*a = v`
//    (shorthand IS_REF/IS_MUT → synthesized PatRefBind, same shape as a
//    plain `ref mut a`).
package pattern_parse_batch_full;

struct P { x: i32 }
struct T(i32, i32);
struct S { a: i32, b: i32 }

fn deref2(p: &&P) -> i32 {
    match p { &&P { x } => x }      // &&pat
}

fn by_index(t: T) -> i32 {
    match t { T { 0: a, 1: b } => a + b }   // S { 0: a }
}

fn ref_mut_writeback() -> i32 {
    let mut s = S { a: 1i32, b: 2i32 };
    match s {
        S { ref mut a, .. } => { *a = 100i32; }
    }
    return s.a;                     // written back
}

fn main() -> i32 {
    let p = P { x: 5i32 };
    let r = &p;
    if deref2(&r) != 5i32 { return 1; }
    if by_index(T(3i32, 4i32)) != 7i32 { return 2; }
    if ref_mut_writeback() != 100i32 { return 3; }
    return 0;
}
