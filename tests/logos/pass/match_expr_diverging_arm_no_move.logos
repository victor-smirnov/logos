// A variable moved ONLY inside a DIVERGING match-EXPRESSION arm must stay
// usable on the fall-through path (Rust parity): the per-arm moved-vars /
// definite-assignment state is saved/restored and diverging arms are
// excluded from the post-match merge — in sema (moved_vars_) AND in the LIR
// borrow checker (MatchExpr state merge). Regression fixture for the class
// fix that previously had only an incidental stdlib guard (canon.logos).
package match_expr_diverging_arm_no_move;

fn take(s: String) -> i64 { return s.len(); }

fn pick(r: Result<i64, i64>, doc: String) -> i64 {
    let v: i64 = match r {
        Result::Ok(x) => { x }
        Result::Err(_e) => { return take(doc); }   // moves doc, then DIVERGES
    };
    // fall-through: doc was moved only on the diverging path — still ours
    let n: i64 = take(doc);
    return n + v;
}

fn main() -> i32 {
    let a: String = String::from("hello");
    if pick(Result::Ok(2i64), a) != 7i64 { return 1i32; }
    let b: String = String::from("world!");
    if pick(Result::Err(9i64), b) != 6i64 { return 2i32; }
    return 0i32;
}
