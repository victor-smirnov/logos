// `for mut i in lo..hi`: a mutable range-for binding; the body's write lands on the
// binding's OWN per-iteration slot, not the induction slot (acc = 33, three iterations).
// Twin: bc_bindmut_for_range_nomut_assign_fail (no `mut`, E0384). Landed 2026-09-09b
// from soundness-queue row for_range_mut_var_syntax.
package bc_bindmut_for_range_mut_assign;
fn main() -> i32 {
    let mut acc: i64 = 0i64;
    for mut i in 0i64..3i64 {
        i = i + 10i64;
        acc = acc + i;
    }
    if acc != 33i64 { return 1i32; }
    return 0i32;
}
