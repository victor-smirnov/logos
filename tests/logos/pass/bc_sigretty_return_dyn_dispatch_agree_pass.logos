// The twin of tests/logos/fail/sigretty_return_dyn_dispatch_fail, one token
// apart: the DECLARATION says `-> i64` and so does the impl. Dispatch through
// `&dyn` still reaches the impl and returns the receiver's own value.
package bc_sigretty_return_dyn_dispatch_agree_pass;
extern fn printf(fmt: *const u8, ...) -> i32;
fn pr(v: i64) { unsafe { printf("%lld\n".as_ptr(), v); } }

struct R {
    v: i64,
}

trait Ask {
    fn ask(self: &Self) -> i64;
}

impl Ask for R {
    fn ask(self: &R) -> i64 {
        return self.v;
    }
}

fn main() -> i32 {
    let r: R = R { v: 21i64 };
    let d: &dyn Ask = &r;
    pr(d.ask());
    return 0;
}
