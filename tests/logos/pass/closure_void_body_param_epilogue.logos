// SOUNDNESS QUEUE closure_byvalue_param_never_dropped, CLOSED 2026-09-07s.
// A CLOSURE BODY IS A FUNCTION BODY AND ENDS THE SAME WAY. `lower_fn` runs an
// epilogue over its PARAMS scope when the body falls off the end
// (`if (!body_terminated) … emit_frame_drops(frame, …, &body_ever_moved_)`);
// the closure-literal lowering did `lower_block(body)` then `pop_scope()` with
// nothing in between. The body block's own collect_drops walks only the INNER
// scope, so an unused BY-VALUE owner parameter — which lives in the params
// frame — was never destroyed. The discriminator was the closure's RETURN TYPE:
// a `-> i64` body ends in `return`, which reaches collect_all_drops, and was
// always correct; a VOID body reached nothing. Measured 0 for 1 at four
// spellings; a heap `String` parameter leaked its buffer with no count to show
// for it (valgrind-only, lattice cell l_param_string_void).
package closure_void_body_param_epilogue;

struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }

fn as_buf<F>(d: D, f: F) where F: FnOnce(D) { f(d); }

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    as_buf(D { v: 1000i64, c: p }, |x: D| {});
    let got: i64 = unsafe { n };
    if got != 1000i64 { return 1i32; }
    as_buf(D { v: 1i64, c: p }, |x: D| { let _r: i64 = x.v; });
    let got2: i64 = unsafe { n };
    if got2 != 1001i64 { return 2i32; }
    return 0i32;
}
