// query_proto_observer_l0 — the L0 PROTO-OBSERVER (Nous ladder rung 0; ADR
// 0015 §0 table + Synthea bootstrap/01 three conditions, condition 1 only).
// A proto-Observer is a system that COLLIDES with its own computational
// irreducibility via self-modeling — the Encounter — without yet the reflexive
// Conclusion or Action (those are S3+, the full Observer).
//
// This test closes the HOCP loop end-to-end on the landed S1+S2 mechanism:
//   1. an IncrRec engine derives a self-model workload under a budget and
//      CUTS — registering a residual it provably could not derive (S2);
//   2. the registered residual (TruncatedTail) + the evaluation trace (S1)
//      MATERIALIZE as ordinary EDB facts (I1: sensor facts about the past);
//   3. a Deem rule over that EDB derives the Encounter fact
//        encounter(epoch) :- tail(epoch, converged=false, pending>0)
//      — the engine's own irreducibility, lifted to a fact it can reason
//      over (HOCP: "without HOCP the system IS irreducible; with HOCP it
//      KNOWS it is irreducible");
//   4. the honesty pair (ADR §6, machine-checkable half): with a larger
//      budget the SAME workload converges and the Encounter fact is ABSENT —
//      the residual was real at decision time and dissolves in retrospect.
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema Edge : code(0x0E07_0000_0000_000D) {
    src: i64 = 0,
    dst: i64 = 1,
}
// The residual descriptor as EDB (the ADR §3 truncated_tail relation shape).
pub schema Tail : code(0x0E07_0000_0000_000E) {
    epoch:     i64 = 0,
    converged: i64 = 1,   // 0/1 (bool as i64 — rel columns are i64)
    pending:   i64 = 2,
    cutr:      i64 = 3,
}
resource cat = schema_catalog!{ Edge, Tail };

fn mk_edge(d: &Writ, s: i64, t: i64) -> WAny {
    let e: Edge = d.make::<Edge>();
    e.src = s; e.dst = t;
    return WAny::ref_to((e.m as i64) as *const u8);
}

fn build_src(d: &Writ, hs: &Vec<WAny>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(64i64);
    let n: i64 = hs.len();
    let mut i: i64 = 0i64;
    while i < n { arr.push(hs.get(i)); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

// Materialize the engine's registered residual as one EDB fact node.
fn tail_edb(d: &Writ, eng: &IncrRec) -> WAny {
    let t: TruncatedTail = eng.tail();
    let r: Tail = d.make::<Tail>();
    r.epoch     = t.epoch;
    r.converged = if t.converged { 1i64 } else { 0i64 };
    r.pending   = t.pending_delta_card;
    r.cutr      = t.cut_reason as i64;
    let arr: &mut WArray<WAny> = d.array(4i64);
    arr.push(WAny::ref_to((r.m as i64) as *const u8));
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

// Run the self-model workload: build on the first edge, feed the rest in one
// epoch under `steps` budget (0 rounds = tightest, <0 = unbudgeted).
fn run_workload(q: &Query, doc: &Writ, all: &Vec<WAny>, steps: i64)
    -> Result<IncrRec, QError> {
    let mut seed: Vec<WAny> = vec_new::<WAny>();
    seed.push(all.get(0i64));
    let mut env: QEnv = QEnv::new();
    env.bind_source("edges", build_src(doc, &seed));
    let mut eng: IncrRec = match q.incremental_rec(&env)
    { Result::Ok(e) => { e } Result::Err(er) => { return Result::Err(er); } };
    if steps >= 0i64 { eng.set_budget_steps(steps); }
    let mut d1: ZBatch = ZBatch::new();
    let mut i: i64 = 1i64;
    while i < all.len() { d1.push(all.get(i), 1i64); i = i + 1i64; }
    eng.epoch(&d1);
    return Result::Ok(eng);
}

// Derive the Encounter from the materialized residual EDB. Returns the number
// of encounter facts (0 or 1 here — one tail row).
fn encounters(qe: &Query, doc: &Writ, eng: &IncrRec) -> i64 {
    let mut env: QEnv = QEnv::new();
    env.bind_source("tails", tail_edb(doc, eng));
    let rows: QRows = match qe.run(&env)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 0i64 - 1i64; } };
    return rows.row_count();
}

fn main() -> i32 {
    let doc: Writ = writ_new(262144i64);
    let c: SchemaCatalog = cat();
    // the self-model workload: transitive closure over a 12-chain (any
    // recursive derivation serves; TC is the engine's own reachability).
    let q: Query = match Query::compile(
        r#"rel path(a: i64, b: i64) {
             from edges e select (e.src, e.dst);
             from path p join edges e on p.b == e.src select (p.a, e.dst);
           }
           from path p select (p.a, p.b)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };
    // the Encounter rule: irreducibility registered ⇒ encounter fact.
    let qe: Query = match Query::compile(
        r#"from tails t where t.converged == 0 && t.pending > 0
           select (t.epoch, t.pending)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e2) => { return 91i32; } };

    let mut all: Vec<WAny> = vec_new::<WAny>();
    let mut k: i64 = 0i64;
    while k < 12i64 { all.push(mk_edge(&doc, k, k + 1i64)); k = k + 1i64; }

    // ── 1+2+3: budgeted run collides with its own irreducibility ──
    let engb: IncrRec = match run_workload(&q, &doc, &all, 1i64)
    { Result::Ok(e) => { e } Result::Err(_e3) => { return 1i32; } };
    if engb.is_converged() { return 2i32; }          // the collision happened
    let nb: i64 = encounters(&qe, &doc, &engb);
    if nb < 0i64 { return 3i32; }
    if nb != 1i64 { return 4i32; }                   // Encounter DERIVED

    // ── 4: honesty pair — a larger budget dissolves the residual ──
    let engu: IncrRec = match run_workload(&q, &doc, &all, 0i64 - 1i64)
    { Result::Ok(e) => { e } Result::Err(_e4) => { return 5i32; } };
    if !engu.is_converged() { return 6i32; }
    let nu: i64 = encounters(&qe, &doc, &engu);
    if nu < 0i64 { return 7i32; }
    if nu != 0i64 { return 8i32; }                   // no residual ⇒ no Encounter

    // the budgeted run's result was a sound underapproximation of the full one
    // (both engines saw the identical workload) — spot-check cardinalities.
    let sb: QRows = engb.snapshot();
    let su: QRows = engu.snapshot();
    if su.row_count() != 78i64 { return 9i32; }      // C(13,2) = full closure
    if sb.row_count() >= su.row_count() { return 10i32; }

    return 0i32;
}
