package a14_cas_retry_loop;
use logos.lang.atomic;
fn main() -> i32 {
    let mut a: AtomicI32 = atomic_i32_new(100i32);
    let p: *mut AtomicI32 = &mut a as *mut AtomicI32;
    let mut iters: i32 = 0i32;
    loop {
        let cur: i32 = a.load();
        let nxt: i32 = cur + 1i32;
        let ok: bool = unsafe { p.compare_exchange(cur, nxt) };
        if ok { break; }
        iters = iters + 1i32;
        if iters > 100i32 { return 1i32; }
    }
    if a.load() != 101i32 { return 2i32; }
    return 0i32;
}
