package if_single_line;
// Edge cases: if in tight nesting, else-if with complex conditions, no-else that falls through
fn sign(x: i32) -> i32 {
    if x > 0 { return 1; }
    else if x < 0 { return -1; }
    else { return 0; }
}
fn main() -> i32 {
    // sign(-10)=-1, sign(0)=0, sign(5)=1
    let a: i32 = sign(-10);  // -1
    let b: i32 = sign(0);    // 0
    let c: i32 = sign(5);    // 1
    // (-1 + 0 + 1) = 0, need 42: use abs values
    // |(-1)| + |0| + |1| = 2, not useful
    // Use: c * 14 + b * 10 + a * (-14) + 42 = 14+0+14+42... nope
    // simpler: sign(100)*42 = 42
    return sign(100) * 42;
}
