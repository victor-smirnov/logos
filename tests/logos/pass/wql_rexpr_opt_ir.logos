// The ENTRY FOLDING rules, asserted through the surface (ADR 0031 R6). They were
// the relational peephole pass `simplify_rexpr` and this fixture built RExpr
// trees by hand to watch each collapse fire; R6 deleted that pass — a query's
// constant clauses are now folded once, as a plan value (`dplan::dp_fold_entry`)
// — so each rule is asked here of a real query, and its verdict read off the
// prepared plan's ground: a collapse that does not fire shows as WG_SCAN.
//
//   (a) const-true  `where`                 → dropped: `select p` is then IDENTITY.
//   (a) const-false `where`                 → the answer is EMPTY (no scan).
//   (b) `select p` over an unfiltered scan  → IDENTITY.
//   (b, negative) a filtered scan           → a SCAN (the filter is kept).
//   ⚠ `where p.age > 1 select p` — the whole row WITH a filter — does not
//   compile today: the scan emitter types the element `i64` and the generated
//   `__out.push(p)` fails (`Buffer__push: expected i64, got &Person`), a type
//   error in generated code instead of a Deem diagnostic. Recorded for ADR 0031
//   R4 (typing on the core); the negative case asks `select p.age` meanwhile.
//   (d) a constant sort key                 → dropped: IDENTITY again.
//   (e) `limit 0`                           → EMPTY.
// (The old rule (c), a projection over a projection, has no subject: the core
// has one head per clause.)
package test;

use logos.std.wql.wql;
use logos.std.wql.why;
use logos.mem.collections.vec;
use logos.lang.result;

struct Person { pub name: str, pub age: i64 }

pub deem t_true(ps: &[Person])     { from ps p where true select p }
pub deem t_false(ps: &[Person])    { from ps p where false select p.age }
pub deem t_ident(ps: &[Person])    { from ps p select p }
pub deem t_filtered(ps: &[Person]) { from ps p where p.age > 1 select p.age }
pub deem t_sortk(ps: &[Person])    { from ps p select p order by 1 }
pub deem t_lim0(ps: &[Person])     { from ps p select p.age limit 0 }

fn main() -> i32 {
    let ps: Vec<Person> = vec![Person { name: "a", age: 3 }, Person { name: "b", age: 1 }];
    if t_true_prepare(&ps).ground() != WG_IDENTITY() { return 1i32; }
    if t_false_prepare(&ps).ground() != WG_FALSE_FILTER() { return 2i32; }
    if t_ident_prepare(&ps).ground() != WG_IDENTITY() { return 3i32; }
    if t_filtered_prepare(&ps).ground() != WG_SCAN() { return 4i32; }
    if t_sortk_prepare(&ps).ground() != WG_IDENTITY() { return 5i32; }
    if t_lim0_prepare(&ps).ground() != WG_FALSE_FILTER() { return 6i32; }
    // and the answers
    match t_true(&ps) { Result::Ok(v) => { if v.len() != 2i64 { return 11i32; } } Result::Err(_e) => { return 12i32; } }
    match t_false(&ps) { Result::Ok(v) => { if v.len() != 0i64 { return 13i32; } } Result::Err(_e) => { return 14i32; } }
    match t_filtered(&ps) { Result::Ok(v) => { if v.len() != 1i64 { return 15i32; } } Result::Err(_e) => { return 16i32; } }
    match t_lim0(&ps) { Result::Ok(v) => { if v.len() != 0i64 { return 17i32; } } Result::Err(_e) => { return 18i32; } }
    return 0i32;
}
