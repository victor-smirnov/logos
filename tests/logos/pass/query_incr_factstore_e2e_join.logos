// query_incr_factstore_e2e_join — slice-8 END-TO-END, TWO-source seam: a
// standing equi-join (emps ⋈ depts) driven entirely by TWO FactStores, each
// PRODUCING its own epoch delta via take_delta, pumped together through
// pump_join into one IncrJoin (ADR 0013 §6). No hand-synthesized batch; the
// stores own the U1 clamp + canonical interning. After every epoch the
// maintained snapshot is compared as a weighted multiset against the queue-2
// batch oracle over BOTH stores' build_present(). Enumerated hazard battery:
// matched insert · unmatched insert · delete-of-present · delete-of-absent
// (no-op) · projection collision · new-dept then matching-emp then delete-dept
// (A_int⋈ΔB, ΔA⋈B_int order) · same-epoch ΔA-insert + ΔB-delete.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema Emp : code(0x0C09_0000_0000_0001) {
    name: str = 0,
    dept: i64 = 1,
}
pub schema Dept : code(0x0C09_0000_0000_0002) {
    id:    i64 = 0,
    dname: str = 1,
}
resource cat = schema_catalog!{ Emp, Dept };

fn mk_emp(dp: *const Writ, name: str, dept: i64) -> WAny {
    let d: &Writ = unsafe { &*dp };
    let e: Emp = d.make::<Emp>();
    e.name = name; e.dept = dept;
    return WAny::ref_to((e.m as i64) as *const u8);
}
fn mk_dept(dp: *const Writ, id: i64, dname: str) -> WAny {
    let d: &Writ = unsafe { &*dp };
    let x: Dept = d.make::<Dept>();
    x.id = id; x.dname = dname;
    return WAny::ref_to((x.m as i64) as *const u8);
}

fn qrow_eq(a: &QRows, ai: i64, b: &QRows, bi: i64) -> bool {
    let nc: i64 = a.col_count();
    let mut c: i64 = 0i64;
    while c < nc {
        let ty: str = a.col_ty(c);
        if a.is_null(ai, c) != b.is_null(bi, c) { return false; }
        if str_eq(ty, "str") {
            if !str_eq(a.get_str(ai, c), b.get_str(bi, c)) { return false; }
        } else if str_eq(ty, "i64") {
            if a.get_i64(ai, c) != b.get_i64(bi, c) { return false; }
        } else if str_eq(ty, "bool") {
            if a.get_bool(ai, c) != b.get_bool(bi, c) { return false; }
        } else {
            return false;
        }
        c = c + 1i64;
    }
    return true;
}
fn multiset_eq(a: &QRows, b: &QRows) -> bool {
    if a.row_count() != b.row_count() { return false; }
    if a.col_count() != b.col_count() { return false; }
    let n: i64 = a.row_count();
    let mut used: Vec<bool> = vec_new::<bool>();
    let mut i: i64 = 0i64;
    while i < n { used.push(false); i = i + 1i64; }
    let mut ai: i64 = 0i64;
    while ai < n {
        let mut found: bool = false;
        let mut bi: i64 = 0i64;
        while bi < n && !found {
            if !used.get(bi) {
                if qrow_eq(a, ai, b, bi) { used.set(bi, true); found = true; }
            }
            bi = bi + 1i64;
        }
        if !found { return false; }
        ai = ai + 1i64;
    }
    return true;
}

fn cmp(eng: &IncrJoin, q: &Query, se: &FactStore, sd: &FactStore, oenv: &mut QEnv) -> bool {
    oenv.bind_source("emps", se.build_present());
    oenv.bind_source("depts", sd.build_present());
    let orc: QRows = match q.run(oenv) { Result::Ok(r) => { r } Result::Err(_e) => { return false; } };
    let snap: QRows = eng.snapshot();
    return multiset_eq(&snap, &orc);
}

fn run_variant(qtext: str, c: &SchemaCatalog) -> i32 {
    let ekf: [str; 2] = ["name", "dept"];
    let dkf: [str; 2] = ["id", "dname"];
    let mut se: FactStore = match FactStore::new(c, "Emp", &ekf[..], 262144i64) {
        Result::Ok(s) => { s } Result::Err(_e) => { return 91i32; }
    };
    let mut sd: FactStore = match FactStore::new(c, "Dept", &dkf[..], 262144i64) {
        Result::Ok(s) => { s } Result::Err(_e) => { return 92i32; }
    };
    let ep: *const Writ = se.arena_ptr();
    let dp: *const Writ = sd.arena_ptr();

    // stable handle pools (canonical raws pinned across epochs)
    let e0: WAny = mk_emp(ep, "Ann", 1i64);
    let e1: WAny = mk_emp(ep, "Bob", 2i64);
    let e2: WAny = mk_emp(ep, "Cid", 1i64);
    let e3: WAny = mk_emp(ep, "Dan", 9i64);   // unmatched
    let e4: WAny = mk_emp(ep, "Eve", 1i64);   // collision on dept1
    let e5: WAny = mk_emp(ep, "Flo", 3i64);   // matches d2
    let e6: WAny = mk_emp(ep, "Gus", 2i64);   // dept2
    let d0: WAny = mk_dept(dp, 1i64, "Core");
    let d1: WAny = mk_dept(dp, 2i64, "Ops");
    let d2: WAny = mk_dept(dp, 3i64, "Lab");

    // base = emps {e0,e1}, depts {d0,d1}
    se.insert(e0); se.insert(e1);
    sd.insert(d0); sd.insert(d1);

    let q: Query = match Query::compile(qtext, c) { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };

    let mut eng_env: QEnv = QEnv::new();
    eng_env.bind_source("emps", se.build_present());
    eng_env.bind_source("depts", sd.build_present());
    let mut eng: IncrJoin = match q.incremental(&eng_env) { Result::Ok(e) => { e } Result::Err(_e2) => { return 93i32; } };
    let _ba: ZBatch = se.take_delta();   // discard baseline deltas
    let _bb: ZBatch = sd.take_delta();

    let mut oenv: QEnv = QEnv::new();
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 1i32; }

    // E1: matched insert (+e2 dept1)
    se.insert(e2); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 2i32; }
    // E2: unmatched insert (+e3 dept9)
    se.insert(e3); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 3i32; }
    // E3: delete-of-present matched (-e0 dept1)
    se.retract(e0); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 4i32; }
    // E4: delete-of-present unmatched (-e3)
    se.retract(e3); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 5i32; }
    // E5: delete-of-ABSENT (e5 never inserted → no-op)
    se.retract(e5); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 6i32; }
    // E6: projection collision (+e4 dept1 → dept1 now has e2,e4)
    se.insert(e4); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 7i32; }
    // E7a: insert a NEW dept (+d2 id3)
    sd.insert(d2); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 8i32; }
    // E7b: insert an emp matching the new dept (+e5 dept3) — A_int⋈ΔB path
    se.insert(e5); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 9i32; }
    // E7c: delete the dept (-d2) — ΔB retract removes the matched row
    sd.retract(d2); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 10i32; }
    // E8: SAME-EPOCH ΔA insert + ΔB delete on one key (+e6 dept2, -d1 id2)
    se.insert(e6); sd.retract(d1); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 11i32; }
    // E9: insert-of-PRESENT (e6 again) + retract-of-ABSENT (d1 again) — both no-ops
    se.insert(e6); sd.retract(d1); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 12i32; }
    // E10: re-insert d1 (re-growth) → matched rows for dept2 reappear
    sd.insert(d1); pump_join(&mut se, &mut sd, &mut eng);
    if !cmp(&eng, &q, &se, &sd, &mut oenv) { return 13i32; }

    return 0i32;
}

fn main() -> i32 {
    let c: SchemaCatalog = cat();
    let r1: i32 = run_variant("from emps e join depts d on e.dept == d.id select d.dname", &c);
    if r1 != 0i32 { return 100i32 + r1; }
    let r2: i32 = run_variant("from emps e join depts d on e.dept == d.id select distinct d.dname", &c);
    if r2 != 0i32 { return 200i32 + r2; }
    let r3: i32 = run_variant("from emps e join depts d on e.dept == d.id select (d.dname, e.name)", &c);
    if r3 != 0i32 { return 300i32 + r3; }
    let r4: i32 = run_variant("from emps e join depts d on e.dept == d.id select distinct (d.dname, e.name)", &c);
    if r4 != 0i32 { return 400i32 + r4; }
    return 0i32;
}
