// RFC-2229 over a TUPLE, the admitting half. `try_path` has always known how to
// spell `t.0`; the capture SCANNER's TupleIndex arm never asked it, so a tuple
// capture widened to the whole variable while the byte-identical STRUCT program
// kept `p.x`. This program admits before and after — the widened capture took
// the `shared_whole` branch, which records no loan at all — and it is here as
// the pair of fail/bc_captuple_elem_conflict, which is the direction the
// widening was silently losing.
package bc_captuple_elem_disjoint;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
fn main() -> i32 {
    let mut t: (i64, i64) = (1i64, 2i64);
    let f = || -> i64 { return t.0; };
    t.1 = 5i64;
    printi("v=%ld\n", f() + t.1);
    return 0i32;
}
