package char_unicode_properties;
use logos.std.fmt;
use logos.lang.option;
use logos.lang.char;
fn main() {
    let cs = ['ö', 'Ж', 'é', 'a', '7', 'ß', 'ǅ', '٣', '½', 'Ⅻ', '\u{3000}', '\u{85}', '\u{0B}', 'ℵ', '𝔄', '中', '_', '\u{2028}'];
    for c in cs.iter() {
        println!("{:>6x} al={} an={} up={} lo={} nu={} ws={} cc={}", *c as u32, c.is_alphabetic(), c.is_alphanumeric(),
                 c.is_uppercase(), c.is_lowercase(), c.is_numeric(), c.is_whitespace(), c.is_control());
    }
    let (ma, mi, pa) = char::UNICODE_VERSION;
    println!("unicode {}.{}.{}", ma, mi, pa);
    let n = "Größe 42 ½ ЖЖ".chars().filter(|c| c.is_alphanumeric()).count();
    println!("{}", n);
}
