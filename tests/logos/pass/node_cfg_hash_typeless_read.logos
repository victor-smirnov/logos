// Verifies the bridge mechanism the container-directory dispatch in
// handle.logos will use: cfg_hash is readable from a NodeBase root
// through a typeless *mut u64 cast at slot 1 (offset 8 bytes), without
// the caller knowing CFG statically. rc stays at slot 0.
//
// Two distinct CFGs allocate roots; each root's slot-1 must equal the
// CFG's hstatic_hash_of and differ between CFGs.
package node_cfg_hash_typeless_read;

use std.data.persistent.bt.node;
use std.data.persistent.bt.cow;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;
use std.hermes.anyval;

pub const CfgA: HermesStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 16 };
pub const CfgB: HermesStatic = @{ "key": <type:u32>, "value": <type:u32>, "fanout":  8 };

fn read_cfg_hash(root: *mut u8) -> u64 {
    unsafe {
        let header: *mut u64 = root as *mut u64;
        // Slot 0 = rc, slot 1 = cfg_hash. Pointer arithmetic via i64 add.
        let slot1: *mut u64 = (header as i64 + 8i64) as *mut u64;
        return *slot1;
    }
}

fn read_rc(root: *mut u8) -> u64 {
    unsafe {
        let slot0: *mut u64 = root as *mut u64;
        return *slot0;
    }
}

fn main() -> i32 {
    let h_a: u64 = hstatic_hash_of::<CfgA>();
    let h_b: u64 = hstatic_hash_of::<CfgB>();
    if h_a == 0u64 { return 1; }
    if h_a == h_b { return 2; }

    let r_a: *mut NodeBase<u64, u64, CfgA> = node_alloc_c::<u64, u64, CfgA>();
    let r_b: *mut NodeBase<u32, u32, CfgB> = node_alloc_c::<u32, u32, CfgB>();

    // Type-erased read at the universal layout (rc, cfg_hash, ...).
    let rc_a:        u64 = read_rc(r_a as *mut u8);
    let rc_b:        u64 = read_rc(r_b as *mut u8);
    let hash_a_read: u64 = read_cfg_hash(r_a as *mut u8);
    let hash_b_read: u64 = read_cfg_hash(r_b as *mut u8);

    if rc_a != 1u64 { return 3; }
    if rc_b != 1u64 { return 4; }
    if hash_a_read != h_a { return 5; }
    if hash_b_read != h_b { return 6; }
    if hash_a_read == hash_b_read { return 7; }

    // Cleanup — typed release per CFG (mirrors what registry dispatch does
    // through fn-pointer lookup by cfg_hash).
    unsafe {
        node_release_c::<u64, u64, CfgA>(r_a);
        node_release_c::<u32, u32, CfgB>(r_b);
    }

    return 42;
}
