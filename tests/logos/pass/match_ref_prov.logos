// Match expression provenance: returning ref from match arms — valid when all arms borrow params
package match_ref_prov;

fn pick<'a>(a: &'a i32, b: &'a i32, tag: i32) -> &'a i32 {
    return match tag {
        1 => a,
        2 => b,
        _ => a,
    };
}

unsafe fn main() -> i32 {
    let x: i32 = 10;
    let y: i32 = 20;
    let r = pick(&x, &y, 1);
    return 0;
}
