// A `group by` with more aggregates than the old emitter's eight slots
// (2026-10-05). The aggregate list was a fixed eight-slot array in three
// layers (the parser's fan, the IR's `RAggArr`, the emitter's per-aggregate
// arrays); a ninth was first dropped (`undefined variable 'a9'` in generated
// code), then refused by name. Every layer holds any number now, and the
// eleventh aggregate's value is checked, in the batch and the incremental
// form.
//
// exit 0 = every aggregate of both groups is the hand-computed value.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct X { pub k: i64, pub v: i64 }

pub deem wide(xs: &[X]) {
    from xs x group by x.k
    aggregate a1 = count(), a2 = sum(x.v), a3 = min(x.v), a4 = max(x.v), a5 = sum(x.v + 1),
              a6 = min(x.v + 1), a7 = max(x.v + 1), a8 = sum(x.v * 2), a9 = min(x.v * 2),
              a10 = max(x.v * 2), a11 = sum(x.v * 3)
    select (key, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11) order by key
}

fn main() -> i32 {
    let xs: [X; 4] = [X { k: 1i64, v: 2i64 }, X { k: 1i64, v: 5i64 }, X { k: 2i64, v: 7i64 }, X { k: 2i64, v: 1i64 }];
    let r = wide(&xs[..]).unwrap();
    if r.len() != 2i64 { return 1i32; }
    let g1 = r.get(0i64);
    if g1.0 != 1i64 || g1.1 != 2i64 || g1.2 != 7i64 || g1.3 != 2i64 || g1.4 != 5i64 { return 2i32; }
    if g1.5 != 9i64 || g1.6 != 3i64 || g1.7 != 6i64 || g1.8 != 14i64 || g1.9 != 4i64 { return 3i32; }
    if g1.10 != 10i64 || g1.11 != 21i64 { return 4i32; }
    let g2 = r.get(1i64);
    if g2.0 != 2i64 || g2.1 != 2i64 || g2.2 != 8i64 || g2.3 != 1i64 || g2.4 != 7i64 { return 5i32; }
    if g2.11 != 24i64 { return 6i32; }
    return 0i32;
}
