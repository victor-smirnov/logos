// Test: move semantics — moved variable is not double-dropped
package drop_move_basic;

extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }

trait Drop { fn drop(self: Self); }

struct Res { id: i32, }

impl Drop for Res {
    fn drop(self: Res) { printi("d%d ", self.id); }
}

fn consume(r: Res) {
    printi("c%d ", r.id);
}

unsafe fn main() -> i32 {
    let result: i32 = 42;
    let a: Res = Res { id: 1 };
    consume(a);
    // a is moved — should NOT be dropped at scope exit
    return result;
}
