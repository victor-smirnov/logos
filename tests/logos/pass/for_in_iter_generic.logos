package for_in_iter_generic;

extern fn printf(fmt: *const u8, ...) -> i32;

enum Option<T> {
    None,
    Some(T),
}

struct Counter {
    val: i32;
    max: i32;
}

impl Counter {
    fn next(self: *mut Counter) -> Option<i32> {
        if self.val >= self.max {
            return Option::None;
        }
        let v = self.val;
        self.val = self.val + 1;
        return Option::Some(v);
    }
}

fn main() -> i32 {
    let mut c = Counter { val: 1, max: 5 };
    let mut product = 1;
    for x in c {
        product = product * x;
    }
    printf("%d\n", product);
    return 0;
}
