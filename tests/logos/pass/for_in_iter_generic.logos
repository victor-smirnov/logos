// ADR 0030 S10 row 1: a `for` head must implement Iterator (Rust E0277 "is not an iterator"); the
// struct's `next` was an inherent method found by name, over a local `enum Option`.
package for_in_iter_generic;

extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }

struct Counter {
    val: i32,
    max: i32,
}

impl Iterator for Counter {
    type Item = i32;
    fn next(&mut self) -> Option<i32> {
        if self.val >= self.max {
            return Option::None;
        }
        let v = self.val;
        self.val = self.val + 1;
        return Option::Some(v);
    }
}


unsafe fn main() -> i32 {
    let mut c = Counter { val: 1, max: 5 };
    let mut product = 1;
    for x in c {
        product = product * x;
    }
    printi("%d\n", product);
    return 0;
}
