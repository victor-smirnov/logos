// query_compile_robust_e2e — regressions for three dynamic Query::compile
// robustness/type-check defects found by the adversarial fan-out:
//
//  • BUG2 (crash): an out-of-range integer literal (> i64::MAX) trapped the
//    surface tokenizer's decoder (v = v*10 + d, unguarded checked multiply) and
//    SIGILL'd the whole process. Now the three decoders (surface / EL / trama)
//    saturate like the f64 mantissa guard — compile returns cleanly (Ok/Err).
//  • BUG3 (silent wrong-answer): an f64 `group by` key was accepted by the
//    dynamic executor (no total order / stable hash) though the static codegen
//    and `distinct` reject it. Now a named compile error.
//  • BUG4 (silent divergence): a non-bool ternary condition (C-truthiness) was
//    accepted, though `where`/`having` and the static codegen require a bool.
//    Now a named compile error.
//
// Exit 0 iff: the huge-literal queries compile WITHOUT crashing, and the f64
// group key + non-bool ternary each return Result::Err.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema A : code(0x0DF5_0000_0000_0001) { a0: i64 = 0, a1: i64 = 1, af: f64 = 2 }
resource cat = schema_catalog!{ A };

// Compile-only; returns true iff compile SUCCEEDED (Ok). No crash either way.
fn compiles_ok(t: str, c: &SchemaCatalog) -> bool {
    match Query::compile(t, c) { Result::Ok(_q) => { return true; } Result::Err(_e) => { return false; } }
}
// A query is REJECTED iff compile OR run returns Err. The dynamic path defers
// the strict type-check to run(), so an f64 group key / non-bool ternary is a
// run-time Err (over a non-empty bound source), not a compile error — either is
// a valid rejection (queue errors are values); silently returning rows is the bug.
fn rejected(t: str, c: &SchemaCatalog, env: &QEnv) -> bool {
    match Query::compile(t, c) {
        Result::Ok(q) => { match q.run(env) { Result::Ok(_r) => { return false; } Result::Err(_e) => { return true; } } }
        Result::Err(_e2) => { return true; }
    }
}

fn main() -> i32 {
    let c: SchemaCatalog = cat();
    // a non-empty source so run() reaches the strict type-check (not a stub error)
    let d: Writ = writ_new(4096i64);
    let arr: &mut WArray<WAny> = d.array(4i64);
    let r0: A = d.make::<A>(); r0.a0 = 1i64; r0.a1 = 2i64; r0.af = 1.5f64; arr.push(WAny::ref_to((r0.m as i64) as *const u8));
    let r1: A = d.make::<A>(); r1.a0 = 1i64; r1.a1 = 3i64; r1.af = 2.5f64; arr.push(WAny::ref_to((r1.m as i64) as *const u8));
    let mut env: QEnv = QEnv::new();
    env.bind_source("A", WAny::ref_to(arr as *const WArray<WAny> as *const u8));

    // ── BUG2: out-of-range integer literals must not crash the process ────────
    // (reaching this line at all — no SIGILL — is 90% of the test; the bool is
    //  irrelevant, Ok or Err are both acceptable graceful outcomes.)
    let _b1: bool = compiles_ok("from A x where x.a0 == 99999999999999999999999999 select x.a0", &c);
    let _b2: bool = compiles_ok("from A x where x.a0 == 9223372036854775808 select x.a0", &c);       // i64::MAX + 1
    let _b3: bool = compiles_ok("from A x select x.a0 limit 99999999999999999999", &c);
    let _b4: bool = compiles_ok("from A x group by x.a0 aggregate s = sum(x.a0 * 999999999999999999999) select (key, s)", &c);

    // a normal in-range literal still compiles fine (the guard didn't break the common path)
    if !compiles_ok("from A x where x.a0 == 42 select x.a0", &c) { return 1i32; }

    // ── BUG3: an f64 `group by` key must be rejected ─────────────────────────
    if !rejected("from A x group by x.af aggregate c = count() select (key, c)", &c, &env) { return 2i32; }
    // control: an i64 group key over the same shape is ACCEPTED (runs cleanly)
    if rejected("from A x group by x.a0 aggregate c = count() select (key, c)", &c, &env) { return 3i32; }

    // ── BUG4: a non-bool ternary condition must be rejected ──────────────────
    if !rejected("from A x select (x.a0 ? 1 : 2)", &c, &env) { return 4i32; }    // i64 condition
    if !rejected("from A x select (x.af ? 1 : 2)", &c, &env) { return 5i32; }    // f64 condition
    // control: a bool condition is ACCEPTED
    if rejected("from A x select (x.a0 > 0 ? 1 : 2)", &c, &env) { return 6i32; }

    return 0i32;
}
