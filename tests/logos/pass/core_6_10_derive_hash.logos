// logos-core §6.10 sub-deliverable 4/8: derive(Hash).
//
// Handler emits `fn hash<H: Hasher>(&self, state: &mut H) { self.f1.hash(state); ... }`.
// Each field's `.hash(state)` dispatches through its own Hash impl.
// Identical structs produce identical hashes; different field values
// produce (with overwhelming probability) different hashes.
package core_6_10_derive_hash;

use logos.std.compiler.metaprog;
use logos.lang.hash;

#[derive_hash]
struct Pt { x: i32, y: i32 }

fn hash_pt(p: &Pt) -> u64 {
    let mut h: FxHasher = fx_hasher_new();
    p.hash(&mut h);
    return h.finish();
}

fn main() -> i32 {
    let a: Pt = Pt { x: 7i32, y: 13i32 };
    let b: Pt = Pt { x: 7i32, y: 13i32 };
    let c: Pt = Pt { x: 7i32, y: 99i32 };

    let ha: u64 = hash_pt(&a);
    let hb: u64 = hash_pt(&b);
    let hc: u64 = hash_pt(&c);

    if ha != hb { return 1i32; }   // identical structs hash same
    if ha == hc { return 2i32; }   // different y → different hash
    if ha == (0 as u64) { return 3i32; }   // sanity: hash is non-trivial
    return 0i32;
}
