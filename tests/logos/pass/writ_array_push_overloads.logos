// WArray<WAny> overloaded push() — `a.push(x)` for the common element types instead
// of `a.push(WAny::from(x))`: i64/bool inline Pods, &WString / &WArray<WAny> Refs,
// and `str` (interned into the array's own arena as an WString, then a Ref).
package test;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.hstring;
use logos.lang.str;
fn main() -> i32 {
    let h: Writ = writ_new(64i64);
    let a: &mut WArray<WAny> = h.array(2i64);
    a.push(42i64);                       // i64 → inline Pod
    a.push(true);                        // bool → inline Pod
    a.push("hello");                     // str → interned WString Ref (no manual WString)
    let hs: &WString = h.hstring("world");
    a.push(hs);                          // &WString → Ref
    let nested: &mut WArray<WAny> = h.array(1i64);
    nested.push(7i64);
    a.push(&*nested);                    // &WArray<WAny> → Ref (nested)

    if a.len() != 5i64 { return 1; }
    if a.get(0i64).as_i56()  != 42i64 { return 2; }
    if a.get(1i64).as_bool() != true  { return 3; }
    if !str_eq(h.hstring_of(a.get(2i64)).as_str(), "hello") { return 4; }
    if !str_eq(h.hstring_of(a.get(3i64)).as_str(), "world") { return 5; }
    if h.array_of(a.get(4i64)).get(0i64).as_i56() != 7i64 { return 6; }
    return 0;
}
