// Tests std.data.persistent.map with a Primitive-path key/value.
// Exercises the second ContainerOrd blanket: `impl<DT: Primitive + Ord>
// ContainerOrd for DT`.  PMap operations should work identically to the
// PodRef-keyed case, but the buffer stores the raw `Prim` value (u64
// here) instead of a *const-shaped view.
package test;

use std.data.persistent.map;
use std.data.persistent.btree.node;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;

pub struct U64Key { pub x: u64 }
impl Primitive for U64Key { type Prim = u64; }
impl Ord for U64Key {
    fn cmp(&self, other: &Self) -> Ordering {
        if self.x < other.x { return Ordering::Less; }
        if self.x > other.x { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

pub struct U64Val { pub x: u64 }
impl Primitive for U64Val { type Prim = u64; }

fn ki(v: u64) -> U64Key { return U64Key { x: v }; }

fn main() -> i32 {
    let mut m: PMap<U64Key, U64Val> = map_new::<U64Key, U64Val>();

    // 6 ordered keys force a leaf split (node_max_keys()=4).
    let k1: U64Key = ki(10u64);
    let k2: U64Key = ki(20u64);
    let k3: U64Key = ki(30u64);
    let k4: U64Key = ki(40u64);
    let k5: U64Key = ki(50u64);
    let k6: U64Key = ki(60u64);

    // For Primitive K, the stored Prim and the qkey must agree (the
    // ContainerOrd impl compares them via DT::Ord on the byte-identical
    // Prim layout).  So the K::ViewInStore (= u64) here equals k_i.x.
    map_insert::<U64Key, U64Val>(&mut m, 10u64, 100u64, &k1 as *const U64Key);
    map_insert::<U64Key, U64Val>(&mut m, 20u64, 200u64, &k2 as *const U64Key);
    map_insert::<U64Key, U64Val>(&mut m, 30u64, 300u64, &k3 as *const U64Key);
    map_insert::<U64Key, U64Val>(&mut m, 40u64, 400u64, &k4 as *const U64Key);
    if map_len::<U64Key, U64Val>(&m) != 4u64 { return 1; }
    unsafe { if !m.root.is_leaf { return 2; } }

    map_insert::<U64Key, U64Val>(&mut m, 50u64, 500u64, &k5 as *const U64Key);
    map_insert::<U64Key, U64Val>(&mut m, 60u64, 600u64, &k6 as *const U64Key);
    if map_len::<U64Key, U64Val>(&m) != 6u64 { return 3; }
    unsafe { if m.root.is_leaf { return 4; } }

    // All keys reachable through the recursive find.
    if !map_contains::<U64Key, U64Val>(&m, &k1 as *const U64Key) { return 5; }
    if !map_contains::<U64Key, U64Val>(&m, &k4 as *const U64Key) { return 6; }
    if !map_contains::<U64Key, U64Val>(&m, &k6 as *const U64Key) { return 7; }
    let miss: U64Key = ki(99u64);
    if  map_contains::<U64Key, U64Val>(&m, &miss as *const U64Key) { return 8; }

    // map_get reads the Prim value back by-value.
    let mut out: u64 = 0u64;
    if !map_get::<U64Key, U64Val>(&m, &k1 as *const U64Key, &mut out as *mut u64) { return 9; }
    if out != 100u64 { return 10; }
    if !map_get::<U64Key, U64Val>(&m, &k4 as *const U64Key, &mut out as *mut u64) { return 11; }
    if out != 400u64 { return 12; }
    if !map_get::<U64Key, U64Val>(&m, &k6 as *const U64Key, &mut out as *mut u64) { return 13; }
    if out != 600u64 { return 14; }

    // Upsert hit.
    if !map_insert::<U64Key, U64Val>(&mut m, 40u64, 4242u64, &k4 as *const U64Key) { return 15; }
    if map_len::<U64Key, U64Val>(&m) != 6u64 { return 16; }
    if !map_get::<U64Key, U64Val>(&m, &k4 as *const U64Key, &mut out as *mut u64) { return 17; }
    if out != 4242u64 { return 18; }

    // Snapshot is preserved across deep mutation.
    let mut snap: PMap<U64Key, U64Val> = map_snapshot::<U64Key, U64Val>(&m);
    map_insert::<U64Key, U64Val>(&mut m, 10u64, 9999u64, &k1 as *const U64Key);
    if !map_get::<U64Key, U64Val>(&m, &k1 as *const U64Key, &mut out as *mut u64) { return 19; }
    if out != 9999u64 { return 20; }
    if !map_get::<U64Key, U64Val>(&snap, &k1 as *const U64Key, &mut out as *mut u64) { return 21; }
    if out != 100u64 { return 22; }

    // Remove.
    if !map_remove::<U64Key, U64Val>(&mut m, &k3 as *const U64Key) { return 23; }
    if map_len::<U64Key, U64Val>(&m) != 5u64 { return 24; }
    if  map_contains::<U64Key, U64Val>(&m, &k3 as *const U64Key) { return 25; }
    // Snapshot still has k3 with v=300.
    if !map_get::<U64Key, U64Val>(&snap, &k3 as *const U64Key, &mut out as *mut u64) { return 26; }
    if out != 300u64 { return 27; }

    map_drop::<U64Key, U64Val>(&mut snap);
    map_drop::<U64Key, U64Val>(&mut m);
    return 42;
}
