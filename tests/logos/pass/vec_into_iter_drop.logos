// Vec.into_iter ownership transfer — VecIter takes over the heap
// buffer, caller's `v` is marked moved (no caller-side Drop), inner
// into_iter zeros self.ptr so its auto-Drop's null-guard fires.
// VecIter's own Drop walks remaining elements + dealloc.
//
// Previously triple-clashed: caller's `v` dropped (free), into_iter's
// `self` dropped (free again → double-free in tcache), and VecIter
// held a dangling pointer that segfaulted on .next() / .collect().
//
// Three pieces of the fix exercised here:
//   1. sema's track_recv_moved marks caller's `v` as moved.
//   2. into_iter zeros self.ptr → Vec::drop null-guard short-circuits.
//   3. VecIter owns_buf=true + Drop frees the heap on iterator death.
package vec_into_iter_drop;

use logos.mem.collections.vec;
use logos.lang.option;
use logos.lang.iter;

fn main() -> i32 {
    let mut v: Vec<i32> = Vec::<i32>::new();
    v.push(10i32);
    v.push(20i32);
    v.push(30i32);
    let mut it: VecIntoIter<i32> = v.into_iter();
    // Pull all three through .next(), then VecIntoIter's Drop deallocs.
    let mut sum: i32 = 0i32;
    loop {
        match it.next() {
            Option::None    => { break; }
            Option::Some(x) => { sum = sum + x; }
        }
    }
    if sum != 60i32 { return 1; }
    return 0;
}
