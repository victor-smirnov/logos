// Closed squeue vec_truncate_drop_order_wrong (#659): Vec::truncate drops the tail front to back after shrinking the length.
package vec_truncate_drop_order_wrong;
use logos.mem.collections.vec;
struct Tok { id: i64, log: *mut i64 }
impl Drop for Tok { fn drop(&mut self) { unsafe { *self.log = *self.log * 10 + self.id; } } }
fn main() -> i32 {
    let mut log: i64 = 0;
    let p: *mut i64 = &mut log;
    let mut v: Vec<Tok> = Vec::new();
    let mut i: i64 = 1;
    while i <= 4 { v.push(Tok { id: i, log: p }); i = i + 1; }
    v.truncate(1);
    let got = unsafe { *p };
    if got == 432 { return 3; }
    if got == 234 { return 0; }
    return 1;
}
