// REPAIR (a) OF THE CLOSURE MINT — a parameter that MENTIONS A WRITTEN REGION
// is left un-minted: its remaining elided slots are tied by the user to a
// binder the CALLER supplies, and minting the ELIDED OUTER slot of
// `&mut &'a i64` rigid refuses this legal call.
// Measured 2026-09-03b: without the skip this program is refused with
// `closure call arg 1: variance mismatch — expected &mut &'a i64, got
// &mut &'a i64` — the same spelling printed twice.
//
// ⚠ ITS REFUSED TWIN IS ONE TOKEN AWAY, TWICE:
// tests/logos/fail/bc_closmint_two_params_untied_fail — drop the two `'a`.
package bc_closmint_two_params_tied;

fn run<'a>(p: &mut &'a i64, w: &'a i64) {
    let c = |q: &mut &'a i64, r: &'a i64| { *q = r; };
    c(p, w);
}

fn main() -> i32 {
    let x: i64 = 1i64;
    let y: i64 = 2i64;
    let mut p: &i64 = &x;
    run(&mut p, &y);
    if *p != 2i64 { return 1i32; }
    return 0i32;
}
