// Tests std.data.persistent.map B+tree splits.
// Inserts enough keys to overflow the root leaf (node_max_keys()=4)
// and force a root split, growing the tree to height 2; then more
// inserts to trigger a secondary leaf split.  Verifies all keys are
// reachable through the recursive find/get path.
package test;

use std.data.persistent.uid256;
use std.data.persistent.map;
use std.lang.cmp;
use std.lang.datatypes;

// Build a UID256 with `b` as the most-significant byte; rest zero.
// Big-endian Ord makes these compare in `b` order, so we control
// insertion ordering deterministically.
fn mk(b: u8) -> UID256 {
    let mut id: UID256 = uid256_zero();
    id.bytes[0] = b;
    return id;
}

fn main() -> i32 {
    // 9 distinct keys, increasing order.  node_max_keys()=4, so:
    //   - inserts 1..4 fill the root leaf.
    //   - insert 5 splits the leaf and grows the root to height 2.
    //   - inserts 6..9 fill the right leaf and split it again.
    let k1: UID256 = mk(0x10u8);
    let k2: UID256 = mk(0x20u8);
    let k3: UID256 = mk(0x30u8);
    let k4: UID256 = mk(0x40u8);
    let k5: UID256 = mk(0x50u8);
    let k6: UID256 = mk(0x60u8);
    let k7: UID256 = mk(0x70u8);
    let k8: UID256 = mk(0x80u8);
    let k9: UID256 = mk(0x90u8);

    let v1: UID256 = mk(0x01u8);
    let v2: UID256 = mk(0x02u8);
    let v3: UID256 = mk(0x03u8);
    let v4: UID256 = mk(0x04u8);
    let v5: UID256 = mk(0x05u8);
    let v6: UID256 = mk(0x06u8);
    let v7: UID256 = mk(0x07u8);
    let v8: UID256 = mk(0x08u8);
    let v9: UID256 = mk(0x09u8);

    let mut m: PMap<UID256, UID256> = map_new::<UID256, UID256>();

    map_insert::<UID256, UID256>(&mut m, &k1 as *const UID256, &v1 as *const UID256, &k1 as *const UID256);
    map_insert::<UID256, UID256>(&mut m, &k2 as *const UID256, &v2 as *const UID256, &k2 as *const UID256);
    map_insert::<UID256, UID256>(&mut m, &k3 as *const UID256, &v3 as *const UID256, &k3 as *const UID256);
    map_insert::<UID256, UID256>(&mut m, &k4 as *const UID256, &v4 as *const UID256, &k4 as *const UID256);
    if map_len::<UID256, UID256>(&m) != 4u64 { return 1; }
    unsafe { if !m.root.is_leaf { return 2; } }

    // 5th insert overflows the leaf → root split, height = 2.
    map_insert::<UID256, UID256>(&mut m, &k5 as *const UID256, &v5 as *const UID256, &k5 as *const UID256);
    if map_len::<UID256, UID256>(&m) != 5u64 { return 3; }
    unsafe { if m.root.is_leaf { return 4; } }

    // Grow further to force a second leaf split.
    map_insert::<UID256, UID256>(&mut m, &k6 as *const UID256, &v6 as *const UID256, &k6 as *const UID256);
    map_insert::<UID256, UID256>(&mut m, &k7 as *const UID256, &v7 as *const UID256, &k7 as *const UID256);
    map_insert::<UID256, UID256>(&mut m, &k8 as *const UID256, &v8 as *const UID256, &k8 as *const UID256);
    map_insert::<UID256, UID256>(&mut m, &k9 as *const UID256, &v9 as *const UID256, &k9 as *const UID256);
    if map_len::<UID256, UID256>(&m) != 9u64 { return 5; }

    // All keys are reachable.
    if !map_contains::<UID256, UID256>(&m, &k1 as *const UID256) { return 10; }
    if !map_contains::<UID256, UID256>(&m, &k2 as *const UID256) { return 11; }
    if !map_contains::<UID256, UID256>(&m, &k3 as *const UID256) { return 12; }
    if !map_contains::<UID256, UID256>(&m, &k4 as *const UID256) { return 13; }
    if !map_contains::<UID256, UID256>(&m, &k5 as *const UID256) { return 14; }
    if !map_contains::<UID256, UID256>(&m, &k6 as *const UID256) { return 15; }
    if !map_contains::<UID256, UID256>(&m, &k7 as *const UID256) { return 16; }
    if !map_contains::<UID256, UID256>(&m, &k8 as *const UID256) { return 17; }
    if !map_contains::<UID256, UID256>(&m, &k9 as *const UID256) { return 18; }

    let miss: UID256 = mk(0xFFu8);
    if map_contains::<UID256, UID256>(&m, &miss as *const UID256) { return 19; }

    // Values come back through the recursive get.
    let mut out: *const UID256 = 0 as *const UID256;
    if !map_get::<UID256, UID256>(&m, &k1 as *const UID256, &mut out as *mut *const UID256) { return 20; }
    unsafe { if !(&*out).eq(&v1) { return 21; } }
    if !map_get::<UID256, UID256>(&m, &k5 as *const UID256, &mut out as *mut *const UID256) { return 22; }
    unsafe { if !(&*out).eq(&v5) { return 23; } }
    if !map_get::<UID256, UID256>(&m, &k9 as *const UID256, &mut out as *mut *const UID256) { return 24; }
    unsafe { if !(&*out).eq(&v9) { return 25; } }

    // Upsert hits down through internal nodes.
    let v5b: UID256 = mk(0x55u8);
    if !map_insert::<UID256, UID256>(&mut m, &k5 as *const UID256, &v5b as *const UID256, &k5 as *const UID256) { return 26; }
    if map_len::<UID256, UID256>(&m) != 9u64 { return 27; }
    if !map_get::<UID256, UID256>(&m, &k5 as *const UID256, &mut out as *mut *const UID256) { return 28; }
    unsafe { if !(&*out).eq(&v5b) { return 29; } }

    // Snapshot is preserved across multi-level mutation.
    let mut snap: PMap<UID256, UID256> = map_snapshot::<UID256, UID256>(&m);
    let v9b: UID256 = mk(0x99u8);
    map_insert::<UID256, UID256>(&mut m, &k9 as *const UID256, &v9b as *const UID256, &k9 as *const UID256);

    if !map_get::<UID256, UID256>(&m,    &k9 as *const UID256, &mut out as *mut *const UID256) { return 30; }
    unsafe { if !(&*out).eq(&v9b) { return 31; } }
    if !map_get::<UID256, UID256>(&snap, &k9 as *const UID256, &mut out as *mut *const UID256) { return 32; }
    unsafe { if !(&*out).eq(&v9) { return 33; } }

    // Remove an entry from a deep leaf; size drops by one, key is gone,
    // others remain.
    if !map_remove::<UID256, UID256>(&mut m, &k3 as *const UID256) { return 34; }
    if map_len::<UID256, UID256>(&m) != 8u64 { return 35; }
    if  map_contains::<UID256, UID256>(&m, &k3 as *const UID256) { return 36; }
    if !map_contains::<UID256, UID256>(&m, &k1 as *const UID256) { return 37; }
    if !map_contains::<UID256, UID256>(&m, &k9 as *const UID256) { return 38; }
    // Snapshot still has k3 with v3.
    if !map_get::<UID256, UID256>(&snap, &k3 as *const UID256, &mut out as *mut *const UID256) { return 39; }
    unsafe { if !(&*out).eq(&v3) { return 40; } }

    map_drop::<UID256, UID256>(&mut snap);
    map_drop::<UID256, UID256>(&mut m);
    return 42;
}
