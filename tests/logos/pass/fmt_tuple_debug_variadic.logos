// Variadic tuple Debug: single `impl<A...: Debug> Debug for (A...)` covers all
// arities (replaced the per-arity 1/2/3/4 impls). Exercises arity 1 (trailing
// comma), 2..5, and a nested tuple field.
package fmt_tuple_debug_variadic;
use logos.lang.str;
use logos.mem.string;
use logos.mem.fmt;
fn main() -> i32 {
    if !str_eq(fmt_debug_to_string::<(i32,)>(&(7i32,)).as_str(), "(7,)") { return 1i32; }
    if !str_eq(fmt_debug_to_string::<(i32,bool)>(&(7i32, true)).as_str(), "(7, true)") { return 2i32; }
    if !str_eq(fmt_debug_to_string::<(i32,i32,i32)>(&(1i32,2i32,3i32)).as_str(), "(1, 2, 3)") { return 3i32; }
    if !str_eq(fmt_debug_to_string::<(i32,i32,i32,i32,i32)>(&(1i32,2i32,3i32,4i32,5i32)).as_str(), "(1, 2, 3, 4, 5)") { return 5i32; }
    if !str_eq(fmt_debug_to_string::<(i32,(i32,bool),i32,i32,i32)>(&(1i32,(2i32,true),3i32,4i32,5i32)).as_str(), "(1, (2, true), 3, 4, 5)") { return 6i32; }
    return 0i32;
}
