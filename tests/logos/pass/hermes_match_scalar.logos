// Test: Hermes scalar match patterns — scrutinee is a HermesStatic view.

package hermes_match_scalar;

use hermes.anyval;
use hermes.view;

unsafe fn classify(d: HermesStatic) -> i32 {
    match d {
        @null  => { return 1; }
        @true  => { return 2; }
        @false => { return 3; }
        @42    => { return 4; }
        @-7    => { return 5; }
        _      => { return 0; }
    }
}

unsafe fn main() -> i32 {
    // 1+2+3+4+5+0 = 15
    return classify(@null) + classify(@true) + classify(@false)
         + classify(@42) + classify(@-7) + classify(@99);
}
