// Test: Hermes scalar match patterns — @null, @true, @false, @<int>, @-<int>.

package hermes_match_scalar;

use hermes.anyval;

unsafe fn classify(av: AnyVal) -> i32 {
    match av {
        @null  => { return 1; }
        @true  => { return 2; }
        @false => { return 3; }
        @42    => { return 4; }
        @-7    => { return 5; }
        _      => { return 0; }
    }
}

unsafe fn main() -> i32 {
    let a: AnyVal = AnyVal::null_ptr();
    let b: AnyVal = AnyVal::embed_bool(true);
    let c: AnyVal = AnyVal::embed_bool(false);
    let d: AnyVal = AnyVal::embed_i24(42);
    let e: AnyVal = AnyVal::embed_i24(-7);
    let f: AnyVal = AnyVal::embed_i24(99);

    // 1+2+3+4+5+0 = 15
    return classify(a) + classify(b) + classify(c) + classify(d) + classify(e) + classify(f);
}
