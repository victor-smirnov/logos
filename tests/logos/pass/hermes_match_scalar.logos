// Test: Hermes scalar match patterns — scrutinee is a view.

package hermes_match_scalar;

use hermes.anyval;
use hermes.ctr;
use hermes.view;

unsafe fn mk(v: AnyVal) -> Hermes {
    let mut c: Hermes = Hermes::builder(128 as i64);
    c.set_root(v);
    return c;
}

unsafe fn classify(d: &Hermes) -> i32 {
    match d {
        @null  => { return 1; }
        @true  => { return 2; }
        @false => { return 3; }
        @42    => { return 4; }
        @-7    => { return 5; }
        _      => { return 0; }
    }
}

unsafe fn main() -> i32 {
    let a: Hermes = mk(AnyVal::null_ptr());
    let b: Hermes = mk(AnyVal::embed_bool(true));
    let c: Hermes = mk(AnyVal::embed_bool(false));
    let d: Hermes = mk(AnyVal::embed_i24(42));
    let e: Hermes = mk(AnyVal::embed_i24(-7));
    let f: Hermes = mk(AnyVal::embed_i24(99));

    // 1+2+3+4+5+0 = 15
    return classify(&a) + classify(&b) + classify(&c)
         + classify(&d) + classify(&e) + classify(&f);
}
