// an if-let whose then-branch moves under a runtime condition: every path drops each value once PROBES.md 2026-09-06d: `if let` / `while let` / let-chains lower BY DELEGATION to lower_match (temp hoist, per-arm scrutinee move, arm drops, cond-move merge); the count is a destructor tally through a raw pointer.
package bc_patown_iflet_runtime_cond_moveout;
fn pick(p: *mut i64, k: i64) -> E { if k > 0i64 { return E::A(S { v: 1i64, i: p }); } return E::B(S { v: 2i64, i: p }); }
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
enum E { A(S), B(S) }
fn go(p: *mut i64, k: i64) -> i64 {
    let e: E = pick(p, k);
    if let E::A(r) = e { return eat(r); }
    return 0i64;
}
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    let _a: i64 = go(p, 1i64);
    let _b: i64 = go(p, 0i64);
    return c as i32;
}
