// `(**bb).f = 7` and `bb.f = 9` on a `Box<Box<S>>`: legal, runs.
// PROBES.md 2026-09-08a: a place in a mutable-use position takes the DerefMut/IndexMut step at every level, a Deref-only/Index-only step is refused, and the bare `deref_mut()` receiver is asked the binding-mut question.
package bc_mutplace_boxbox_field_write_both;
struct S { f: i64 }
fn main() -> i32 {
    let mut bb: Box<Box<S>> = Box::new(Box::new(S { f: 1i64 }));
    (**bb).f = 7i64;
    if bb.f != 7i64 { return 1i32; }
    bb.f = 9i64;
    if (**bb).f != 9i64 { return 2i32; }
    return 0i32;
}
