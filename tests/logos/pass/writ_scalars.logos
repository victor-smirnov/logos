// P1 scalar port — EXACT round-trip for every Writ scalar width. Narrow ints
// stay INLINE with their precise width tag (I8=20..U24=25); wide values box into a
// tagged arena object (I64=26, U64=27, F32=30, F64=31). `type_code()` emits the
// Writ1 wire tag in both forms.
package test;
use logos.lang.writ.anyval;
use logos.lang.writ.container;
use logos.lang.writ.array;
fn main() -> i32 {
    let a: WAny = WAny::from(-5i8);
    if !a.is_i8() { return 1i32; }
    if a.as_i8() != -5i8 { return 2i32; }
    if a.type_code() != 20u64 { return 3i32; }          // HT_I8
    if a.is_i16() || a.is_bool() { return 4i32; }      // exact: not i16/bool

    let b: WAny = WAny::from(200u8);
    if !b.is_u8() || b.as_u8() != 200u8 { return 5i32; }

    let c: WAny = WAny::from(-1000i16);
    if !c.is_i16() || c.as_i16() != -1000i16 { return 6i32; }

    let d: WAny = WAny::from(60000u16);
    if !d.is_u16() || d.as_u16() != 60000u16 { return 7i32; }

    let e: WAny = WAny::from((-5000000i64) as i24);
    if !e.is_i24() || e.as_i24() != ((-5000000i64) as i24) { return 8i32; }

    let f: WAny = WAny::from((15000000i64) as u24);
    if !f.is_u24() || f.as_u24() != ((15000000i64) as u24) { return 9i32; }

    // all classify as int, none float
    if !a.is_int() || !f.is_int() { return 10i32; }
    if a.is_float() { return 11i32; }
    // negative sign-extension
    if WAny::from(-1i8).as_i8() != -1i8 { return 12i32; }

    // ── boxed wide scalars via a Writ array (boxing needs the zone) ──
    let h: Writ = writ_new(256i64);
    let arr: &mut WArray<WAny> = h.array(8i64);
    arr.push(9000000000000000000u64);    // u64 → boxed U64 (27)
    arr.push(3.5f32);                     // boxed F32 (30)
    arr.push(2.5f64);                     // boxed F64 (31)
    arr.push(1000000000000000000i64);     // i64 > i56 → boxed I64 (26)

    let g0: WAny = arr.get(0i64);
    if !g0.is_u64() || g0.as_u64() != 9000000000000000000u64 { return 13i32; }
    if g0.type_code() != 27u64 { return 14i32; }
    let g1: WAny = arr.get(1i64);
    if !g1.is_f32() || g1.as_f32() != 3.5f32 { return 15i32; }
    if g1.type_code() != 30u64 { return 16i32; }
    let g2: WAny = arr.get(2i64);
    if !g2.is_float() || g2.as_f64() != 2.5f64 { return 17i32; }
    if g2.type_code() != 31u64 { return 18i32; }
    let g3: WAny = arr.get(3i64);
    if !g3.is_int() || g3.as_i64() != 1000000000000000000i64 { return 19i32; }
    if g3.type_code() != 26u64 { return 20i32; }

    // cross-checks: a float is not int, a u64 is int not float
    if g1.is_int() || g0.is_float() { return 21i32; }
    return 0i32;
}
