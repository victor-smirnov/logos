// query_incr_factstore_epochs — the FactStore EPOCH-HISTORY layer (ADR 0017 P1):
// every take_delta() commits the epoch's ±slot log into a deem.data container
// (one commit per epoch, heads[e] names epoch e's SET in the snapshot DAG).
// The ADR gate: facts of epoch N stay readable after N+k. Asserts:
//   (a) epoch_count advances once per take_delta;
//   (b) count_at(e) reflects the SET as of epoch e, not the current one;
//   (c) contains_at(e, fact) — presence by CONTENT at a past epoch, incl. a
//       fact retracted later (readable in its epoch, absent after);
//   (d) same-epoch insert+retract nets out (absent at that epoch's commit);
//   (e) re-insert after retract is visible again at the later epoch;
//   (f) multi-field keys (i64 pair) and a str-keyed relation both round-trip
//       through the fs_key_enc byte encoding.
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Edge : code(0x0E08_0000_0000_0011) {
    src: i64 = 0,
    dst: i64 = 1,
}
pub schema Tag : code(0x0E08_0000_0000_0012) {
    name: str = 0,
}
resource cat = schema_catalog!{ Edge, Tag };

fn mk_edge(dp: *const Writ, s: i64, t: i64) -> WAny {
    let d: &Writ = unsafe { &*dp };
    let e: Edge = d.make::<Edge>();
    e.src = s; e.dst = t;
    return WAny::ref_to((e.m as i64) as *const u8);
}

fn mk_tag(dp: *const Writ, nm: str) -> WAny {
    let d: &Writ = unsafe { &*dp };
    let t: Tag = d.make::<Tag>();
    t.name = nm;
    return WAny::ref_to((t.m as i64) as *const u8);
}

fn main() -> i32 {
    let c: SchemaCatalog = cat();
    let kf: [str; 2] = ["src", "dst"];
    let mut st: FactStore = match FactStore::new(&c, "Edge", &kf[..], 65536i64) {
        Result::Ok(s)   => { s }
        Result::Err(_e) => { return 10i32; }
    };
    if st.epoch_count() != 0i64 { return 11i32; }

    // ── epoch 0: {(0,1), (1,2)} ──
    let a: WAny = mk_edge(st.arena_ptr(), 0i64, 1i64);
    let b: WAny = mk_edge(st.arena_ptr(), 1i64, 2i64);
    st.insert(a);
    st.insert(b);
    let _d0: ZBatch = st.take_delta();
    if st.epoch_count() != 1i64 { return 20i32; }        // (a)
    if st.count_at(0i64) != 2i64 { return 21i32; }       // (b)

    // ── epoch 1: retract (0,1), insert (2,3) → {(1,2), (2,3)} ──
    st.retract(a);
    let e23: WAny = mk_edge(st.arena_ptr(), 2i64, 3i64);
    st.insert(e23);
    let _d1: ZBatch = st.take_delta();
    if st.epoch_count() != 2i64 { return 30i32; }
    if st.count_at(1i64) != 2i64 { return 31i32; }
    // (c) the ADR gate: epoch 0's SET is still readable after later epochs.
    if st.count_at(0i64) != 2i64 { return 32i32; }
    if !st.contains_at(0i64, a) { return 33i32; }        // present at 0…
    if st.contains_at(1i64, a) { return 34i32; }         // …retracted at 1
    if !st.contains_at(1i64, e23) { return 35i32; }
    if st.contains_at(0i64, e23) { return 36i32; }       // not yet at 0

    // ── epoch 2: same-epoch insert+retract nets out (d); re-insert a (e) ──
    let e45: WAny = mk_edge(st.arena_ptr(), 4i64, 5i64);
    st.insert(e45);
    st.retract(e45);
    st.insert(a);                                         // (e) re-insert
    let _d2: ZBatch = st.take_delta();
    if st.epoch_count() != 3i64 { return 40i32; }
    if st.contains_at(2i64, e45) { return 41i32; }       // (d)
    if !st.contains_at(2i64, a) { return 42i32; }        // (e)
    if st.count_at(2i64) != 3i64 { return 43i32; }       // {(0,1),(1,2),(2,3)}
    // earlier epochs unchanged
    if st.count_at(0i64) != 2i64 { return 44i32; }
    if st.count_at(1i64) != 2i64 { return 45i32; }

    // ── (f) a str-keyed relation rides the same encoding ──
    let kt: [str; 1] = ["name"];
    let mut ts: FactStore = match FactStore::new(&c, "Tag", &kt[..], 65536i64) {
        Result::Ok(s)   => { s }
        Result::Err(_e) => { return 50i32; }
    };
    let t1: WAny = mk_tag(ts.arena_ptr(), "alpha");
    let t2: WAny = mk_tag(ts.arena_ptr(), "beta");
    ts.insert(t1);
    ts.insert(t2);
    let _t0: ZBatch = ts.take_delta();
    ts.retract(t1);
    let _t1d: ZBatch = ts.take_delta();
    if ts.count_at(0i64) != 2i64 { return 51i32; }
    if ts.count_at(1i64) != 1i64 { return 52i32; }
    if !ts.contains_at(0i64, t1) { return 53i32; }
    if ts.contains_at(1i64, t1) { return 54i32; }
    if !ts.contains_at(1i64, t2) { return 55i32; }

    return 0i32;
}
