// Arrays had no methods ("receiver is not a struct (got [i64; 4])"). A `[T; N]`
// receiver now unsizes to `[T]` for a slice method (Rust's autoref + unsize step):
// iter / iter_mut / contains / first / reverse / fill / to_vec. rustc twin: 0.
package array_slice_methods;
use logos.mem.collections.vec;
fn main() -> i32 {
    let arr: [i64; 4] = [10, 20, 30, 40];
    let mut sum: i64 = 0;
    for x in arr.iter() { sum += *x; }
    if sum != 100 || arr.len() != 4 { return 1; }
    if !arr.contains(&30) { return 2; }
    let mut b: [i64; 3] = [3, 1, 2];
    b.reverse();
    if b[0] != 2 { return 3; }
    for x in b.iter_mut() { *x *= 2; }
    if b[2] != 6 { return 4; }
    match arr.first() { Option::Some(f) => { if *f != 10 { return 5; } } Option::None => { return 5; } }
    b.fill(9);
    if b[1] != 9 { return 6; }
    let v: Vec<i64> = arr.to_vec();
    if v.len() != 4 || v[3] != 40 { return 7; }
    return (sum as i32) * 10 + arr.len() as i32 - 1004;
}
