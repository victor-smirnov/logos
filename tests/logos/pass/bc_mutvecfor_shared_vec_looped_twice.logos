// THE LEGAL TWIN, ONE TOKEN APART: `&Vec` instead of `&mut Vec`. A shared
// reference is Copy — `IntoIterator for &Vec` copies it — so looping twice over
// the same binding is legal, and the move rule must not reach it.
package bc_mutvecfor_shared_vec_looped_twice;

fn main() -> i32 {
    let mut vals: Vec<i64> = Vec::<i64>::new();
    vals.push(3i64);
    let v: &Vec<i64> = &vals;
    let mut t: i64 = 0i64;
    for n in v {
        t = t + *n;
    }
    for n in v {
        t = t + *n;
    }
    return t as i32;
}
