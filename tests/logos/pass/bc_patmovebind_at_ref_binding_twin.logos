// Compiles and runs as in rustc 1.98.1 (squeue row of the same name).
package bc_patmovebind_at_ref_binding_twin;
struct P { n: i64 }
impl Drop for P { fn drop(self: &mut P) {} }
enum E { A(P), B }
fn main() -> i32 {
    let e = E::A(P { n: 1i64 });
    let r: &E = &e;
    match *r {
        E::A(ref d) => {
            let v: i64 = d.n;
            return (v - 1i64) as i32;
        }
        ref b @ E::B => { return 1i32; }
    }
}
