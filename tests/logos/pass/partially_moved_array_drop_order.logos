// Drop order of a partially moved array (let and match): moved middles, two moved indices, moved
// ends, a `..` rest, and partially moved struct elements. rustc 1.98.1 prints the same lines.
package partially_moved_array_drop_order;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct W { a: D, b: D }
fn d(v: i64, p: *mut i64) -> D { return D { v: v, c: p }; }
fn mkw(x: i64, p: *mut i64) -> W { return W { a: D { v: x, c: p }, b: D { v: x + 5i64, c: p } }; }
fn a5(p: *mut i64) { let arr: [D; 5] = [d(1i64, p), d(2i64, p), d(3i64, p), d(4i64, p), d(5i64, p)]; let [_, _, y, _, _] = arr; let _ = y.v; }
fn b5(p: *mut i64) { let arr: [D; 5] = [d(1i64, p), d(2i64, p), d(3i64, p), d(4i64, p), d(5i64, p)]; let [_, x, _, y, _] = arr; let _ = x.v + y.v; }
fn c5(p: *mut i64) { let arr: [D; 5] = [d(1i64, p), d(2i64, p), d(3i64, p), d(4i64, p), d(5i64, p)]; let [x, _, _, _, y] = arr; let _ = x.v + y.v; }
fn d5(p: *mut i64) { let arr: [D; 5] = [d(1i64, p), d(2i64, p), d(3i64, p), d(4i64, p), d(5i64, p)]; let [_, x, ..] = arr; let _ = x.v; }
fn p1(p: *mut i64) { let arr: [W; 3] = [mkw(1i64, p), mkw(2i64, p), mkw(3i64, p)]; match arr { [_, W { a: x, b: _ }, _] => { let _ = x.v; } } }
fn p2(p: *mut i64) { let arr: [W; 4] = [mkw(1i64, p), mkw(2i64, p), mkw(3i64, p), mkw(4i64, p)]; match arr { [_, W { a: x, b: _ }, y, _] => { let _ = x.v + y.a.v; } } }
fn p3(p: *mut i64) { let arr: [W; 3] = [mkw(1i64, p), mkw(2i64, p), mkw(3i64, p)]; match arr { [.., W { a: x, b: _ }] => { let _ = x.v; } } }
fn run(f: fn(*mut i64)) { let mut n: i64 = 0i64; f(&mut n); unsafe { printf("%lld\n".as_ptr(), n); } }
fn main() -> i32 { run(a5); run(b5); run(c5); run(d5); run(p1); run(p2); run(p3); return 0i32; }
