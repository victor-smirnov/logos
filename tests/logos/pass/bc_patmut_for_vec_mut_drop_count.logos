// DESTRUCTOR COUNT: `for mut s in vec` over two Drop values, each mutated then dropped ONCE with the mutated value (11 + 12 = 23). PROBES.md 2026-09-06b: the by-value pattern `mut` is carried into the LIR for match/if-let/while-let/for bindings.
package bc_patmut_for_vec_mut_drop_count;
use logos.mem.collections.vec;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let mut vs: Vec<S> = Vec::new();
        vs.push(S { v: 1i64, i: p });
        vs.push(S { v: 2i64, i: p });
        for mut s in vs {
            s.v = s.v + 10i64;
        }
    }
    if c != 23i64 { return 1i32; }
    return 0i32;
}
