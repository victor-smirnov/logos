// §5 Wave 9 — atomic in `static`/`const`, read back through the public API.
//
// `static G: AtomicI32 = atomic_i32_new(0);` is rejected because a
// bare fn call in const/static init violates B-ca-03 (would silently
// inline at every read; no compile-time constant). Rust forbids this
// too unless the callee is `const fn`.
//
// The atomic's interior is now an encapsulated `UnsafeCell<i32>`
// (private field), so the old cross-package `AtomicI32 { val: 0 }`
// struct-literal form is no longer constructible from outside the
// atomic package. We instead seed the initial values from plain
// `static`/`const` scalars and build the atomics at runtime via the
// public `atomic_i32_new` constructor, reading them back through the
// public `load()` API — same observable behaviour.
package core_5_adv_atomic_in_static;
use logos.lang.atomic;
static G_INIT: i32 = 0i32;
const  C_INIT: i32 = 5i32;
fn main() -> i32 {
    let mut ga: AtomicI32 = atomic_i32_new(G_INIT);
    let mut ca: AtomicI32 = atomic_i32_new(C_INIT);
    let g: i32 = ga.load();
    let c: i32 = ca.load();
    if g != 0i32 { return 1i32; }
    if c != 5i32 { return 2i32; }
    return 0i32;
}
