// pmap_leaf_iter.logos — first slice of the leaf-iter on pmap.
//
// Builds a small CFG=4-fanout pmap with 10 ordered keys (forces a
// few leaves), then walks leaves left-to-right via LeafIter, collects
// the keys, and verifies they came out in order. Then walks back via
// the reverse iterator and verifies the reversed sequence.

package main;

use std.data.persistent.view;
use std.data.persistent.mutv;
use std.data.persistent.btree;
use std.data.persistent.iter;
use std.data.persistent.cfg;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.compiler.metaprog;
use std.hermes.ctr;
use std.hermes.view;
use std.hermes.anyval;

pub struct U64Key { pub x: u64, }
impl Primitive for U64Key { type Prim = u64; }
impl Ord for U64Key {
    fn cmp(&self, other: &Self) -> Ordering {
        if self.x < other.x { return Ordering::Less; }
        if self.x > other.x { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

pub struct U64Val { pub x: u64, }
impl Primitive for U64Val { type Prim = u64; }

fn ki(v: u64) -> U64Key { return U64Key { x: v }; }

pub const Cfg4: HermesStatic = @{
    "key":    <type:U64Key>,
    "value":  <type:U64Val>,
    "fanout": 4,
};

pub type MyMap = PMapMut<Cfg4>;

unsafe fn main() -> i32 {
    let cfg: HermesStatic = @{
        "key": <type:U64Key>, "value": <type:U64Val>, "fanout": 4,
    };
    if validate_pmap_cfg(cfg) != 0 { return 1; }

    let mut pm: MyMap = pmap_mut_new::<Cfg4>(0u64, 0u64, 0 as *mut u64);
    let pmptr: *mut MyMap = &mut pm as *mut MyMap;

    // 10 keys, ordered → with fanout=4 we get multiple leaves.
    let mut i: u64 = 0u64;
    while i < 10u64 {
        let v: u64 = (i + 1u64) * 10u64;
        let k: U64Key = ki(v);
        let _ = pmap_mut_insert::<Cfg4>(pmptr, v, v * 10u64, &k as *const U64Key);
        i = i + 1u64;
    }
    if pm.view.len() != 10u64 { return 2; }

    // Forward walk.
    let mut it: LeafIter<U64Key, U64Val, Cfg4> = pmap_view_acquire_leaf_iter::<Cfg4>(&pm.view as *const PMapView<Cfg4>);
    let itp: *mut LeafIter<U64Key, U64Val, Cfg4> = &mut it as *mut LeafIter<U64Key, U64Val, Cfg4>;

    let mut prev: u64 = 0u64;
    let mut count: u64 = 0u64;
    let mut leaves: u64 = 0u64;
    while leaf_iter_valid::<U64Key, U64Val, Cfg4>(itp as *const LeafIter<U64Key, U64Val, Cfg4>) {
        leaves = leaves + 1u64;
        let leaf: *mut LeafNode<U64Key, U64Val, Cfg4> = leaf_iter_leaf::<U64Key, U64Val, Cfg4>(itp as *const LeafIter<U64Key, U64Val, Cfg4>);
        let n: u64 = leaf_iter_size::<U64Key, U64Val, Cfg4>(itp as *const LeafIter<U64Key, U64Val, Cfg4>);
        let mut j: u64 = 0u64;
        while j < n {
            let kv: u64 = leaf.keys.get(j);
            if kv <= prev { return 10; }
            prev = kv;
            count = count + 1u64;
            j = j + 1u64;
        }
        leaf_iter_next_leaf::<U64Key, U64Val, Cfg4>(itp);
    }
    if count != 10u64 { return 11; }
    if leaves < 2u64 { return 12; }
    pmap_view_release_leaf_iter::<Cfg4>(itp);

    // Reverse walk.
    let mut rit: LeafIter<U64Key, U64Val, Cfg4> = pmap_view_acquire_leaf_iter_last::<Cfg4>(&pm.view as *const PMapView<Cfg4>);
    let ritp: *mut LeafIter<U64Key, U64Val, Cfg4> = &mut rit as *mut LeafIter<U64Key, U64Val, Cfg4>;

    let mut last: u64 = 1000u64;
    let mut rcount: u64 = 0u64;
    while leaf_iter_valid::<U64Key, U64Val, Cfg4>(ritp as *const LeafIter<U64Key, U64Val, Cfg4>) {
        let leaf: *mut LeafNode<U64Key, U64Val, Cfg4> = leaf_iter_leaf::<U64Key, U64Val, Cfg4>(ritp as *const LeafIter<U64Key, U64Val, Cfg4>);
        let n: u64 = leaf.keys.len();
        // Walk leaf right-to-left.
        let mut j: u64 = n;
        while j > 0u64 {
            j = j - 1u64;
            let kv: u64 = leaf.keys.get(j);
            if kv >= last { return 20; }
            last = kv;
            rcount = rcount + 1u64;
        }
        leaf_iter_prev_leaf::<U64Key, U64Val, Cfg4>(ritp);
    }
    if rcount != 10u64 { return 21; }
    pmap_view_release_leaf_iter::<Cfg4>(ritp);

    pmap_mut_drop::<Cfg4>(pmptr);
    return 0;
}
