// Hermes residency/escape: a document built in make_doc() OUTLIVES that scope —
// the returned Held<HArray<HVal>> carries a holder (Rc clone) that keeps the
// container's segments alive. The container drops (frees segments) only when the
// last holder drops (here at main's end).
package test;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.array;
use logos.mem.rc;

fn make_doc() -> Held<HArray<HVal>> {
    let mut h: Rc<Hermes> = hermes_rc(48i64);
    let root: &mut HArray<HVal> = h.array(2i64);     // build via Rc (auto-deref)
    root.push(HAny::from(10i64));
    root.push(HAny::from(20i64));
    root.push(HAny::from(30i64));             // forces a grow too
    return hold(&mut h, root);                    // escape: carry the holder
    // local `h` drops here (-1); the Held's holder keeps the container alive
}

fn main() -> i32 {
    let doc: Held<HArray<HVal>> = make_doc();         // container outlived make_doc
    let r: &HArray<HVal> = doc.get();
    if r.len() != 3i64 { return 1; }
    let mut sum: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < r.len() { sum = sum + r.get(i).as_i56(); i = i + 1i64; }
    if sum != 60i64 { return 2; }                  // 10+20+30
    return 0;
    // doc drops → holder Rc → count 0 → Hermes Drop → segments freed
}
