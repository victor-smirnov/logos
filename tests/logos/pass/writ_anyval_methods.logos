// WAny accessor surface (writ successor of writ_anyval_methods):
// is_*/as_* over every Pod kind + boxed wide scalars.
package writ_anyval_methods;
use logos.lang.writ.anyval;
use logos.lang.writ.allocator;
use logos.lang.writ.container;
use logos.lang.rc;
use logos.lang.cell;

unsafe fn main() -> i32 {
    // --- is_null ---
    let nul: WAny = WAny::Ref(0 as *const u8);
    if !nul.is_null()  { return 1; }

    // --- is_int / as_i64 (inline i56) ---
    let vi: WAny = WAny::from(77 as i56);
    if !vi.is_int()    { return 2; }
    if vi.is_bool()    { return 3; }
    if vi.as_i64() != 77i64 { return 4; }

    // --- is_bool / as_bool ---
    let vb: WAny = WAny::from(true);
    if !vb.is_bool()   { return 5; }
    if vb.is_int()     { return 6; }
    if !vb.as_bool()   { return 7; }

    // --- small unsigned coercions ---
    let vu: WAny = WAny::from(255 as u8);
    if !vu.is_int()    { return 8; }
    if vu.as_i64() != 255i64 { return 9; }

    // --- boxed wide scalars live in a zone; accessors see through the box ---
    let rc: Rc<Writ> = writ_rc(4096);
    let h: &Writ = rc.deref();
    let hp: *mut Writ = h as *const Writ as *mut Writ;
    let big: WAny = box_i64(hp.allocator.get(), 1311768467463790320i64);
    if !big.is_int()   { return 10; }
    if big.is_pod()    { return 11; }                       // boxed → Ref, not Pod
    if big.as_i64() != 1311768467463790320i64 { return 12; }

    let bu: WAny = box_u64(hp.allocator.get(), 18446744073709551615u64);
    if bu.as_u64() != 18446744073709551615u64 { return 13; }

    let bf: WAny = box_f64(hp.allocator.get(), 2.5);
    if !bf.is_float()  { return 14; }
    if bf.as_f64() != 2.5 { return 15; }

    return 42;
}
