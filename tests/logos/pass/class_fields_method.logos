package class_fields_method;
// Edge case: class with multiple fields and methods accessing them
class Rectangle {
    width: i32,
    height: i32,

    static fn create(w: i32, h: i32) -> *mut Rectangle {
        return new Rectangle { width: w, height: h };
    }

    unsafe fn area(self: *mut Rectangle) -> i32 {
        return self.width * self.height;
    }

    unsafe fn perimeter(self: *mut Rectangle) -> i32 {
        return 2 * (self.width + self.height);
    }
}

unsafe fn main() -> i32 {
    let r: *mut Rectangle = Rectangle::create(6, 7);
    let mut a: i32 = 0; let mut p: i32 = 0;
    unsafe {
        a = r.area();       // 42
        p = r.perimeter();  // 26
        delete r;
    }
    return a;  // 42
}
