// DROP ORDER, TUPLE ELEMENTS — TWIN of `drop_tuple_elems_index_order` with the
// three ids REVERSED, so index order prints 321 here and 123 there.
//
// A reverse-order compiler swaps the two answers and fails BOTH halves; either
// half alone would pass on one of them. Pre-fix it printed 123 and exited 90.
package drop_tuple_elems_index_order_reversed;

extern fn printf(fmt: *const u8, ...) -> i32;

// Each destructor appends its id to a decimal SEQUENCE and bumps a COUNT, so
// this fixture pins WHICH ORDER the fields drop in (stdout + the `seq` check)
// AND that each field drops exactly once (the exit code IS the destructor
// count: 2 would be a leak, 4 a double drop, and neither moves the sequence).
struct O { id: i32, seq: *mut i32, n: *mut i32 }
impl Drop for O {
    fn drop(self: &mut O) {
        unsafe {
            *self.seq = *self.seq * 10 + self.id;
            *self.n = *self.n + 1;
            printf("%d".as_ptr(), self.id);
        }
    }
}


fn main() -> i32 {
    let mut seq: i32 = 0;
    let mut cnt: i32 = 0;
    let ps: *mut i32 = &mut seq;
    let pn: *mut i32 = &mut cnt;
    let mut probe: i32 = 0;
    {
        let t: (O, O, O) = (O { id: 3, seq: ps, n: pn },
                            O { id: 2, seq: ps, n: pn },
                            O { id: 1, seq: ps, n: pn });
        probe = t.0.id;
    }
    unsafe { printf("\n".as_ptr()); }
    if probe != 3 { return 91; }
    let got: i32 = unsafe { seq };
    if got != 321 { return 90; }
    return unsafe { cnt };
}
