package char_copy_bound;

// G139-4: `char` implements Copy (used-after-pass stays valid).
fn copy_it<T: Copy>(v: T) -> T { return v; }

fn main() -> i32 {
    let c: char = 'x';
    let c2: char = copy_it(c);
    // c is still usable (Copy, not moved).
    if c != 'x' { return 1i32; }
    if c2 != 'x' { return 2i32; }
    let d: char = c;
    if d != c { return 3i32; }
    return 0i32;
}
