package impl_generic_result;
// impl<T, E> on two-parameter generic enum — methods on GRes<T, E>-style enums.
extern fn printf(fmt: *const u8, ...) -> i32;
fn print(s: str) { unsafe { printf(s.as_ptr()); } }
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }

enum GRes<T, E> { Ok(T), Err(E) }

impl<T, E> GRes<T, E> {
    fn unwrap_or(self: GRes<T, E>, def: T) -> T {
        match self {
            GRes::Ok(v)  => { return v; }
            GRes::Err(_) => { return def; }
        }
    }
    fn is_ok(self: GRes<T, E>) -> bool {
        match self {
            GRes::Ok(_)  => { return true; }
            GRes::Err(_) => { return false; }
        }
    }
}

fn divide(a: i32, b: i32) -> GRes<i32, i32> {
    if b == 0 { return GRes::Err(-1); }
    return GRes::Ok(a / b);
}

unsafe fn main() -> i32 {
    let r1 = divide(10, 2);
    let r2 = divide(10, 0);
    printi("%d\n", r1.unwrap_or(0));    // 5
    printi("%d\n", r2.unwrap_or(0));    // 0
    if r1.is_ok() { print("ok\n"); }   // ok
    if !r2.is_ok() { print("err\n"); } // err
    return 0;
}
