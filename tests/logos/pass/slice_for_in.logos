package slice_for_in;
// for-in over &[T] slice: iterate by index using dynamic length from fat pointer.
extern fn printf(fmt: *const u8, ...) -> i32;

fn sum_slice(s: &[i32]) -> i32 {
    let mut total = 0;
    for x in s { total = total + x; }
    return total;
}

fn count_positive(s: &[i32]) -> i32 {
    let mut n = 0;
    for x in s { if x > 0 { n = n + 1; } }
    return n;
}

fn main() -> i32 {
    let data: [i32; 5] = [1, -2, 3, -4, 5];
    let total = sum_slice(&data);
    let pos   = count_positive(&data);
    printf("%d %d\n", total, pos);
    return 0;
}
