// A CLOSURE INSIDE A GENERIC FUNCTION, INSTANTIATED AT TWO TYPES — the second
// witness of the same defect, with a closure that takes a `&T` PARAMETER.
//
// Was soundness-queue row closure_in_generic_two_insts (tier 3, `refuses`).
// Same cause and same fix as its sibling pass fixture
// generic_closure_id_collides_across_instances: mono copied the per-LITERAL
// closure id verbatim across substitutions, so two instances asked for one
// symbol. Closed by keying the id on the substitution.
//
// ⚠ KEEP BOTH INSTANTIATIONS: one alone never collides.
package closure_in_generic_two_insts;
fn twice<T: Copy>(v: T) -> T {
    let c = |x: &T| -> T { return *x; };
    return c(&v);
}
fn main() -> i32 {
    let a: i64 = twice(3i64);
    let b: i32 = twice(4i32);
    if a != 3i64 { return 1i32; }
    if b != 4i32 { return 2i32; }
    return 0i32;
}
