// `println!("pat", args...)` macro shell. Lowers to a block expr that
// builds a String via format_args_str and feeds it to println through
// the std.fmt re-export wrapper. Exit code = length of the printed
// string (for verification without parsing stdout).
package println_macro_basic;

use std.fmt;
use std.lang.text;

fn main() -> i32 {
    println!("hello {}, x={}", "world", 42i32);  // "hello world, x=42"
    return 17;
}
