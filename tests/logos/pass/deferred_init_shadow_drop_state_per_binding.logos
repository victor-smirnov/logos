// Deferred-init bindings shadowed in the same block and inside an `if` arm: each binding's
// drop state is its own (mlir-gen restores the outer binding's at scope exit). rustc 1.98.1: 2134 (exit 86).
package deferred_init_shadow_drop_state_per_binding;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    {
        let x: D;
        x = D { v: 1i64, c: p };
        let x: D;
        x = D { v: 2i64, c: p };
        let _ = x.v;
    }
    let mut m: i64 = 0i64;
    let q: *mut i64 = &mut m;
    let c: bool = n > 0i64;
    {
        let y: D;
        if c {
            let y: D;
            y = D { v: 3i64, c: q };
            let _ = y.v;
        }
        y = D { v: 4i64, c: q };
        let _ = y.v;
    }
    unsafe { printf("%lld\n".as_ptr(), n * 100i64 + m); }
    return 0i32;
}
