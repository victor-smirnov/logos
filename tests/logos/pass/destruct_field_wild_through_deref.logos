// PIN (2026-09-04land, root 2): `_` in a destructuring `let` TAKES NOTHING.
// Through a `&` source the field stays the referent's; pre-fix this loop emitted
// a by-value field READ for every spelling, so `_` bound a second owner of the
// same value and the pair double-freed (run rc 134, `free(): double free`).
// THE ASSERTION IS THE DESTRUCTOR COUNT, not the exit code: an rc oracle cannot
// tell one drop from two, nor from none.
// TWIN one token apart: destruct_field_ref_through_deref (`_` -> `ref v`).
package destruct_field_wild_through_deref;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
static mut N: i64 = 0i64;
struct Owner { k: i64 }
impl Drop for Owner { fn drop(self: Owner) { unsafe { N = N + 1i64; } } }
struct A { o: Owner, t: i64 }
fn f(r: &A) -> i64 {
    let A { o: _, t: w } = *r;
    return w;
}
fn main() -> i32 {
    {
        let a: A = A { o: Owner { k: 7i64 }, t: 2i64 };
        let g: i64 = f(&a);
        if g != 2i64 { return 3i32; }
    }
    unsafe {
        printi("N=%d\n", N as i32);
        if N != 1i64 { return 1i32; }
    }
    return 0i32;
}
