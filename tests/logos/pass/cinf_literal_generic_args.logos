// ADR 0030 C-INF: an unsuffixed literal that fixes a type parameter is an integer VARIABLE a later use
// solves, at every argument shape (bare, `&`, array and tuple leaves, `vec!`), and a trait bound on it
// waits for the solution. It was i32 at the call: `vec![3, 4]` then `: Vec<i64>` refused, `first([3, 4])`
// then `: i64` read an i32 array as i64, `let a = 7; wid(a); let b: i64 = a;` dispatched to the i32
// impl, `T1(7)` then `: T1<i64>` refused, and `println!("{}", 5000000000)` printed 705032704 (unsolved: i64 when it does not fit, the
// Logos default). rustc twin (the println line aside, which rustc refuses): same output.
package cinf_literal_generic_args;
use logos.std.fmt; use logos.mem.string; use logos.mem.collections.vec; use logos.lang.option;
trait W { fn w(&self) -> i32; }
impl W for i32 { fn w(&self) -> i32 { return 32; } }
impl W for i64 { fn w(&self) -> i32 { return 64; } }
impl W for u8 { fn w(&self) -> i32 { return 8; } }
fn id<T>(t: T) -> T { return t; }
fn wid<T: W>(t: T) -> i32 { return t.w(); }
fn rd<T: Copy>(t: &T) -> T { return *t; }
fn first<T: Copy>(a: [T; 2]) -> T { return a[0]; }
fn fst<A, B>(p: (A, B)) -> A { return p.0; }
fn pick<T>(x: T, y: T) -> T { return y; }
fn sh<T: Display>(t: &T) { println!("{}", t); }
struct S {}
struct T1<T>(T);
impl S { fn m<T: Copy>(&self, t: T) -> T { return t; } }
fn main() -> i32 {
    let x = vec![3, 4]; let y: Vec<i64> = x; println!("{}", y[0] + 5000000000);
    let a = id(7); let b: i64 = a; println!("{}", b + 5000000000);
    let a = rd(&7); let b: u8 = a; println!("{} {}", b.w(), b + 200);
    let a = first([3, 4]); let b: i64 = a; println!("{} {}", b.w(), b + 5000000000);
    let a = fst((1, 2)); let b: i64 = a; println!("{} {}", b.w(), b + 5000000000);
    let a = 7; let s = wid(a); let b: i64 = a; println!("{} {}", s, b);
    let a = id(7); let s = wid(a); let b: u8 = a; println!("{} {}", s, b);
    println!("{}", wid(7));
    let a = S {}.m(5); let b: i64 = a; println!("{}", b.w());
    println!("{} {}", pick(1, 2i64).w(), pick(2i64, 1).w());
    let o = Some(7); let s = o.map(|x| wid(x)); let b: Option<u8> = o; println!("{}", s.unwrap());
    let a = id(-128); let b: i8 = a; println!("{}", b);
    let a = &5000000000; sh(a);
    let c = &7; let d: &u8 = c; println!("{}", d.w());
    println!("{} {}", 5000000000, 7);
    let t = T1(7); let x: T1<i64> = t; println!("{} {}", x.0.w(), x.0 + 5000000000);
    return 0;
}
