// Arena-layer exerciser on hermes2 (successor of the Hermes1 ex_arena):
// self-relative links, HAny wire encodings, vlen datatag raw byte layout.
package hermes_ex_arena;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.mem.hermes.tag_system;
use logos.mem.rc;

struct Slot { pub val: i32 }

unsafe fn main() -> i32 {
    let rc: Rc<Hermes> = hermes_rc(8192);
    let h: &Hermes = rc.deref();
    let hp: *mut Hermes = h as *const Hermes as *mut Hermes;

    // ── Self-relative link (the hermes2 RelPtr) ─────────────────────────────
    let na: *mut Slot = hermes_alloc::<Slot>(hp);
    let nb: *mut Slot = hermes_alloc::<Slot>(hp);
    na.val = 10; nb.val = 99;
    let link_slot: *mut i64 = hermes_alloc::<i64>(hp);
    *link_slot = (nb as i64) - (link_slot as i64);          // store
    let res: *const Slot = ((link_slot as i64) + *link_slot) as *const Slot;  // resolve
    if res as i64 != nb as i64                                  { return 1; }
    if res.val != 99                                            { return 2; }
    *link_slot = 0i64;                                          // null form
    if *link_slot != 0i64                                       { return 3; }

    // ── HAny wire format — Ref mode ─────────────────────────────────────────
    // Value form: the word IS the absolute pointer; bit 0 = 0.
    let p: HAny = HAny::ref_to(na as *const u8);
    if (p.raw() & 1i64) != 0i64                                 { return 4; }
    if p.resolve() as i64 != na as i64                          { return 5; }
    if p.is_pod()                                               { return 6; }

    // ── HAny wire format — Pod mode ─────────────────────────────────────────
    // (v<<8) | (code<<1) | 1: bool=2 -> |5; i56=1 -> |3.
    let vb: HAny = HAny::from(true);
    if vb.raw() != ((1i64 << 8i64) | 5i64)                      { return 7; }
    let vi: HAny = HAny::from(7 as i56);
    if vi.raw() != ((7i64 << 8i64) | 3i64)                      { return 8; }
    let vneg: HAny = HAny::from(-1 as i56);
    if vneg.as_i64() != -1i64                                   { return 9; }

    // ── vlen datatag raw byte layout ────────────────────────────────────────
    let obj: *mut u8 = (hermes_alloc_bytes(hp, 32) as i64 + 16) as *mut u8;
    write_tag(obj, 130u64);                  // single byte: obj[-1] = 130
    if *((obj as i64 - 1) as *const u8) != 130 as u8            { return 10; }
    write_tag(obj, 2107u64);                 // multi: header 224, LE bytes follow
    if *((obj as i64 - 1) as *const u8) != 224 as u8            { return 11; }
    if *((obj as i64 - 2) as *const u8) != 59 as u8             { return 12; }  // 2107 & 0xFF
    if *((obj as i64 - 3) as *const u8) != 8 as u8              { return 13; }  // 2107 >> 8
    if h2_type_code(obj as *const u8) != 2107u64                { return 14; }
    if h2_tag_size(130u64) != 1i64                              { return 15; }
    if h2_tag_size(2107u64) != 3i64                             { return 16; }

    return 42;
}
