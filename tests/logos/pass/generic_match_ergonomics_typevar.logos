// T2-26 (last carve-out): a bare-TypeVar payload participates in default
// binding modes like any other type. In a GENERIC body `match &o { Some(x) }`
// over `o: &Option<T>` now binds `x: &T` (RFC 2005, exactly Rust) — it used to
// be carved out to by-value `x: T` to dodge a mono blow-up that actually came
// from `Option::take`/`replace` rebuilding `Some(v)` from a `&mut T` binding
// (non-Rust; now they do a value-level move like `mem::replace`).
//
// Exercises: generic `&Option<T>` match (by-ref payload via `*x`), generic
// `&mut Option<T>` match (write-back via `*v`), and the iterator path
// (Option::into_iter → OptionIter::next → take) that the blow-up lived on.
package test.generic_match_ergonomics_typevar;

fn get_or<T>(o: &Option<T>, d: T) -> T {
    match o {
        Some(x) => { return *x; }   // x: &T  (default binding mode)
        None    => { return d; }
    }
}

fn bump_if_some(o: &mut Option<i64>) {
    match o {
        Some(v) => { *v = *v + 1i64; }   // v: &mut i64 — write-back through the borrow
        None    => {}
    }
}

fn sum_iter(o: Option<i64>) -> i64 {
    let mut acc: i64 = 0i64;
    for x in o {            // Option::into_iter → OptionIter::next → take()
        acc = acc + x;
    }
    return acc;
}

fn main() -> i32 {
    let oa: Option<i64> = Some(41i64);
    let a = get_or(&oa, 0i64);          // 41

    let mut ob: Option<i64> = Some(9i64);
    bump_if_some(&mut ob);               // Some(10)
    let b = get_or(&ob, 0i64);          // 10

    let c = sum_iter(Some(7i64)) + sum_iter(None);   // 7 + 0

    let r = a + b + c;                   // 41 + 10 + 7 = 58
    return (r - 58i64) as i32;
}
