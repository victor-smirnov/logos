package foreach_array_rvalue_elements_never_dropped_run;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut s: i64 = 0i64;
    for d in [D { v: 1i64, c: p }, D { v: 10i64, c: p }] {
        s = s + d.v;
    }
    let got: i64 = unsafe { n };
    unsafe { printf("s=%ld n=%ld\n".as_ptr(), s, got); }
    if s != 11i64 { return 3i32; }
    if got != 11i64 { return 1i32; }
    return 0i32;
}
