// ADR 0025 §5 — THE ASYMPTOTICS AS AN ASSERTION, NOT A COMMENT.
//
// §5 claims the leaf-batch producer pays ONE DESCENT PER LEAF where the per-row
// walk paid one container method per ROW. Every fixture in the tree so far
// asserted the ANSWER (same rows, same order) — and the answer is IDENTICAL if
// the batch stream secretly re-descends per row, so the whole claim §5 exists to
// make was pinned by nothing.
//
// THIS FILE IS THE SUBJECT, NOT THE WHOLE GATE. Its own exit code pins what a
// program can see from inside: the rows, the order, the sums and the batch count
// against the container's own per-row cursor. The COST is not visible from
// inside a program at all, so it is measured from outside by
// `tests/logos/ctr_leaf_descent_gate.sh`, which runs this same binary under
// callgrind and counts calls — `bt_seek_at` (the root-to-leaf descent) attributed
// to its CALLER, so the batch plane's descents and the row cursor's are separated
// rather than summed. That is why this program is deliberately MINIMAL: exactly
// one full row walk and exactly one full batch scan, no landings, no second
// stream, so every counted call has exactly one possible origin.
//
// The oracle is independent of the batch plane in both halves: `seek(0)` +
// `next(&cur)` is the container's own row surface, and it also yields the leaf
// count independently — a row cursor crosses a leaf boundary by descending
// again (ops.logos: a CoW tree has no sibling pointer), so the number of
// descents INSIDE the row walk is the container's leaf count, measured without
// asking the batch plane anything. The gate compares the two.
package ctr_leaf_descent_count;

use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.sync;
use logos.lang.stream;
use logos.lang.option;
use logos.mem.bt.batch;

pub container Led {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure count;
    measure max(key);
}

// 1000 entries of two u64 columns in 4K leaf blocks = 8 leaves, MEASURED (the
// same shape `pass/ctr_family_leaf_batches` pins). >= 3 is what §5 needs to be
// about anything; the exact 8 is what makes "per leaf, not per row" a number.
const N: u64 = 1000u64;
const LEAVES: u64 = 8u64;

fn main() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();
    let snap: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    let mut c = create_ctr::<typeof(Led)>(&snap, 1u64);
    let mut i: u64 = 0u64;
    while i < N { c.insert(i * 2u64, i * 10u64); i = i + 1u64; }

    // ── ORACLE: the container's own per-row cursor, ONE full walk ───────
    let mut rows_w: u64 = 0u64;
    let mut ksum_w: u64 = 0u64;
    let mut vsum_w: u64 = 0u64;
    let mut ord_w: bool = true;
    {
        let mut cu = c.seek(0u64);
        let mut prev: u64 = 0u64;
        while cu.valid() {
            let k: u64 = cu.key();
            if rows_w > 0u64 && k <= prev { ord_w = false; }
            prev = k;
            ksum_w = ksum_w + k; vsum_w = vsum_w + cu.value(); rows_w = rows_w + 1u64;
            cu = c.next(&cu);
        }
    }

    // ── THE LEAF-BATCH STREAM, ONE full scan, in §1's shape ─────────────
    // `next_batch()` outside, the index loop inside — the same two lines the
    // emitter writes, so what the gate measures below is the emitted shape's
    // cost and not a second hand-written route to it.
    let mut rows_b: u64 = 0u64;
    let mut ksum_b: u64 = 0u64;
    let mut vsum_b: u64 = 0u64;
    let mut batches: u64 = 0u64;
    let mut ord_b: bool = true;
    {
        let mut s = c.leaf_batches();
        let mut prevb: u64 = 0u64;
        loop {
            let ob = s.next_batch();
            if ob.is_some() {
                {
                    let b = ob.unwrap();
                    batches = batches + 1u64;
                    let n: u64 = b.len();
                    let kc: PdtCol = b.keys();
                    let vc: PdtCol = b.vals();
                    let mut j: u64 = 0u64;
                    while j < n {
                        let k: u64 = kc.at(j);
                        if rows_b > 0u64 && k <= prevb { ord_b = false; }
                        prevb = k;
                        ksum_b = ksum_b + k; vsum_b = vsum_b + vc.at(j);
                        rows_b = rows_b + 1u64; j = j + 1u64;
                    }
                }
            } else { break; }
        }
    }

    if rows_w != N { return 1i32; }
    if rows_b != rows_w { return 2i32; }
    if ksum_b != ksum_w || vsum_b != vsum_w { return 3i32; }
    if !ord_w || !ord_b { return 4i32; }
    if batches < 3u64 { return 5i32; }        // >= 3 leaves, or §5 is about nothing
    if batches >= rows_b { return 6i32; }     // per LEAF, not per row
    if batches != LEAVES { return 7i32; }     // …and per leaf EXACTLY
    return 0i32;
}
