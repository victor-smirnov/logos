// `if let … else if let …`: each arm owns its payload; the unmatched Option drops at scope exit (1 + 2) PROBES.md 2026-09-06d: `if let` / `while let` / let-chains lower BY DELEGATION to lower_match (temp hoist, per-arm scrutinee move, arm drops, cond-move merge); the count is a destructor tally through a raw pointer.
package bc_patown_elseif_chain_drops;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn mk(p: *mut i64, v: i64) -> Option<S> { return Option::Some(S { v: v, i: p }); }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let o: Option<S> = mk(p, 1i64);
        let k: Option<S> = mk(p, 2i64);
        if let Option::Some(a) = o {
            let _x: i64 = eat(a);
        } else if let Option::Some(b) = k {
            let _y: i64 = eat(b);
        } else {
        }
    }
    return c as i32;
}
