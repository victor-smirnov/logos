// memstore_smoke — the hand-written MemoryStore / MemorySnapshot (ADR 0020 Track
// B, container⟂store split, increment 2a). Exercises the store machinery the
// generated container will run on, BEFORE the emitter threads through it: the
// storage capability, the `ctr_id → root` directory, multi-container
// fork/commit/release refcounting, and the container-AGNOSTIC recursive tree
// release over the uniform branch shape (a branch DECLARES its child-ref slot
// in the node header; tree_release reads it from there).
package test;

use logos.mem.bt.memstore;   // MemoryStore, MemorySnapshot, DirEntry
use logos.mem.bt.map;        // trait Snapshot — brings snapshot_id() into scope
use logos.mem.bt.node;       // node_snapshot / node_rc / node_pkd / node_child_slot —
                             // verify the header stamps directly
use logos.mem.pkd;           // PkdAlloc, PkdArray — build a branch's child column
use logos.lang.result;       // Result (format/push)

fn main() -> i32 {
    // ── (1) storage capability ───────────────────────────────────────────
    let mut store: MemoryStore = MemoryStore::new();
    let mut s1: MemorySnapshot = store.fork();
    if s1.snapshot_id() != 1u64 { return 1i32; }

    let h: *mut u8 = s1.node_alloc(4096u32, 2u32);
    if unsafe { node_snapshot(h) } != 1u64 { return 2i32; }   // stamps the skip key
    if unsafe { node_rc(h) } != 1u32 { return 3i32; }          // alloc = one parent ref
    if s1.inc_rc(h) != 2u32 { return 4i32; }
    if s1.dec_rc(h) != 1u32 { return 5i32; }
    if s1.child_ref_of(h) != (h as u64) { return 6i32; }       // u64 child ref = address
    if s1.get_child(s1.child_ref_of(h)) != h { return 7i32; }  // roundtrips
    if s1.cow_needed(h) { return 8i32; }                       // stamped with s1 → no clone

    let mut s2: MemorySnapshot = store.fork();
    if s2.snapshot_id() != 2u64 { return 9i32; }
    if !s2.cow_needed(h) { return 10i32; }                     // h frozen for s2 → must clone
    s1.node_free(h);
    s1.release();   // s1's (empty) directory — h was never registered
    s2.release();

    // ── (2) directory + multi-container fork/commit refcounting ───────────
    let mut s0: MemorySnapshot = store.fork();                 // id 3, empty dir
    let a: *mut u8 = s0.node_alloc(4096u32, 2u32);             // container 7 root (leaf)
    let b: *mut u8 = s0.node_alloc(4096u32, 2u32);             // container 9 root (leaf)
    s0.set_root(7u64, a, 0u32);
    s0.set_root(9u64, b, 0u32);
    if !s0.has_ctr(7u64) || !s0.has_ctr(9u64) { return 11i32; }
    if s0.root_of(7u64).root != a || s0.root_of(9u64).level != 0u32 { return 12i32; }

    store.commit(&s0);                                         // HEAD adopts a,b (inc_rc each)
    if unsafe { node_rc(a) } != 2u32 { return 13i32; }         // s0 + HEAD
    if unsafe { node_rc(b) } != 2u32 { return 14i32; }

    let mut sf: MemorySnapshot = store.fork();                 // shares HEAD's a,b (inc_rc)
    if !sf.has_ctr(7u64) { return 15i32; }                     // directory copied from HEAD
    if unsafe { node_rc(a) } != 3u32 { return 16i32; }         // s0 + HEAD + sf

    sf.release();                                              // drop sf's share
    if unsafe { node_rc(a) } != 2u32 { return 17i32; }
    s0.release();                                              // drop s0's share
    if unsafe { node_rc(a) } != 1u32 { return 18i32; }         // only HEAD left
    store.release();                                           // HEAD → a,b freed at rc 0

    // ── (3) container-agnostic recursive tree release (branch → leaf) ─────
    let mut store2: MemoryStore = MemoryStore::new();
    let mut s: MemorySnapshot = store2.fork();
    let leaf: *mut u8 = s.node_alloc(4096u32, 2u32);           // level-0 child (rc 1)
    let br: *mut u8 = s.branch_alloc(4096u32, 3u32, 2u32);     // level-1 branch (rc 1),
                                                               // children declared in slot 2
    // The header carries WHERE children live: a leaf declares nothing, a branch
    // declares its slot. This is what lets tree_release stay container-agnostic
    // without any container having to bend its branch layout around a global
    // slot number.
    unsafe {
        if node_child_slot(leaf) != NODE_NO_CHILDREN { return 17i32; }
        if node_child_slot(br) != 2u32 { return 18i32; }
    }
    unsafe {
        let pa: *mut PkdAlloc = node_pkd(br);
        match PkdArray::<u64>::format(pa, 2u32) {              // the declared child slot
            Result::Ok(_p) => {}
            Result::Err(_e) => { return 19i32; }
        }
        let ch: *mut PkdArray<u64> = pa.get::<PkdArray<u64>>(2u32);
        match (*ch).push(&(leaf as u64)) {                     // br adopts leaf (leaf's rc 1 = this ref)
            Result::Ok(_u) => {}
            Result::Err(_e) => { return 20i32; }
        }
    }
    s.set_root(5u64, br, 1u32);
    s.release();   // tree_release(br,1): dec br→0 → recurse the DECLARED child
                   // slot → tree_release(leaf,0) → free both
    return 0i32;
}
