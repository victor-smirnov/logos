// ADR 0030 S5 (C-OWN): the same with the branch NOT taken: the old value drops before the new one.
// The exit code is the drop counter; rustc 1.98.1 twin exits 11.
package own_reassign_after_cond_move_not_taken;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(&mut self) { unsafe { *self.c = *self.c + self.v; } } }
fn eat(_d: D) {}
fn main() -> i32 { let mut n: i64 = 0; let c: *mut i64 = &mut n; let k = n != 0; { let mut x = D { v: 1, c: c }; if k { eat(x); } x = D { v: 10, c: c }; let _q = x.v; } return unsafe { *c } as i32; }
