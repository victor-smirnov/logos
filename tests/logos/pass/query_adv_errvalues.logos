// query_adv_errvalues — ADDED COVERAGE (adversarial error-path regression). A
// battery of ill-typed / malformed DYNAMIC Deem queries, each of which under
// Rust-parity strict typing has NO well-typed meaning, asserted to be handled
// as a VALUE (Result::Err from compile OR run) — never a crash, never a silent
// Ok. Plus positive controls that MUST still succeed. Exit 0 iff every case
// behaves; a nonzero code 100+idx names the query that WRONGLY returned Ok.
//
// NOTE: two shapes that the STATIC `deem!` executor rejects but the dynamic
// executor SILENTLY ACCEPTS are intentionally OMITTED here (each has its own
// red repro): an f64 `group by` key (query_adv_f64groupkey) and a non-bool
// ternary condition (query_adv_terncond). Once those are fixed on the dynamic
// side they can be folded into this battery.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema S : code(0x0AD0_0000_0000_0001) {
    i: i64  = 0,
    f: f64  = 1,
    s: str  = 2,
    b: bool = 3,
}
pub schema T : code(0x0AD0_0000_0000_0002) {
    ti: i64 = 0,
    ts: str = 1,
}
resource cat = schema_catalog!{ S, T };

fn mk_s(d: &Writ, i: i64, f: f64, s: str, b: bool) -> WAny {
    let r: S = d.make::<S>();
    r.i = i; r.f = f; r.s = s; r.b = b;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn mk_t(d: &Writ, ti: i64, ts: str) -> WAny {
    let r: T = d.make::<T>();
    r.ti = ti; r.ts = ts;
    return WAny::ref_to((r.m as i64) as *const u8);
}

// true iff the query WRONGLY succeeded (compile-Ok AND run-Ok).
fn succeeded(text: str, c: &SchemaCatalog, env: &QEnv) -> bool {
    match Query::compile(text, c) {
        Result::Ok(q) => {
            match q.run(env) {
                Result::Ok(_r) => { return true; }
                Result::Err(_e) => { return false; }
            }
        }
        Result::Err(_e2) => { return false; }
    }
}
// true iff the query FAILED (did not produce Ok rows) — for positive controls.
fn failed(text: str, c: &SchemaCatalog, env: &QEnv) -> bool { return !succeeded(text, c, env); }

fn main() -> i32 {
    let c: SchemaCatalog = cat();

    let d: Writ = writ_new(8192i64);
    let sarr: &mut WArray<WAny> = d.array(8i64);
    sarr.push(mk_s(&d, 1i64, 1.5, "aa", true));
    sarr.push(mk_s(&d, 2i64, 2.5, "bb", false));
    sarr.push(mk_s(&d, 1i64, 3.5, "aa", true));
    let ssrc: WAny = WAny::ref_to(sarr as *const WArray<WAny> as *const u8);
    let tarr: &mut WArray<WAny> = d.array(4i64);
    tarr.push(mk_t(&d, 1i64, "aa"));
    tarr.push(mk_t(&d, 9i64, "zz"));
    let tsrc: WAny = WAny::ref_to(tarr as *const WArray<WAny> as *const u8);
    let mut env: QEnv = QEnv::new();
    env.bind_source("s", ssrc);
    env.bind_source("t", tsrc);

    // ── comparison type mismatches ────────────────────────────────────────
    if succeeded("from s x where x.s == x.i select x.i", &c, &env) { return 101i32; }
    if succeeded("from s x where x.s < x.i select x.i", &c, &env)  { return 102i32; }
    if succeeded("from s x where x.b == x.i select x.i", &c, &env) { return 103i32; }
    if succeeded("from s x where x.b < x.b select x.i", &c, &env)  { return 104i32; }
    if succeeded("from s x where x.s < x.f select x.i", &c, &env)  { return 105i32; }
    // ── arithmetic on non-numeric ────────────────────────────────────────
    if succeeded("from s x select x.s + x.i", &c, &env) { return 106i32; }
    if succeeded("from s x select x.s - x.i", &c, &env) { return 107i32; }
    if succeeded("from s x select x.i * x.s", &c, &env) { return 108i32; }
    if succeeded("from s x select x.i % x.f", &c, &env) { return 109i32; }
    if succeeded("from s x select x.b + x.i", &c, &env) { return 110i32; }
    if succeeded("from s x select -x.s", &c, &env)      { return 111i32; }
    if succeeded("from s x select x.b * x.b", &c, &env) { return 112i32; }
    // ── boolean / condition misuse (WHERE requires bool) ─────────────────
    if succeeded("from s x where !x.i select x.i", &c, &env) { return 113i32; }
    if succeeded("from s x where x.i select x.i", &c, &env)  { return 114i32; }
    if succeeded("from s x where x.s select x.i", &c, &env)  { return 115i32; }
    if succeeded("from s x select (x.b ? x.s : x.i)", &c, &env) { return 116i32; }
    // ── builtins on wrong types ──────────────────────────────────────────
    if succeeded("from s x select upper(x.i)", &c, &env) { return 118i32; }
    if succeeded("from s x select len(x.b)", &c, &env)   { return 119i32; }
    if succeeded("from s x where contains(x.i, x.s) select x.i", &c, &env) { return 120i32; }
    if succeeded("from s x select len(x.s, x.s)", &c, &env) { return 121i32; }
    // ── aggregate type misuse ────────────────────────────────────────────
    if succeeded("from s x group by x.i aggregate a = avg(x.s) select key", &c, &env) { return 124i32; }
    if succeeded("from s x group by x.i aggregate a = sum(x.b) select key", &c, &env) { return 125i32; }
    if succeeded("from s x group by x.i aggregate a = min(x.b) select key", &c, &env) { return 126i32; }
    if succeeded("from s x group by x.i aggregate a = max(x.b) select key", &c, &env) { return 127i32; }
    if succeeded("from s x group by x.i aggregate a = sum() select key", &c, &env)    { return 128i32; }
    // ── distinct requiring Eq ────────────────────────────────────────────
    if succeeded("from s x select distinct x.f", &c, &env)          { return 129i32; }
    if succeeded("from s x select distinct (x.i, x.f)", &c, &env)   { return 130i32; }
    // ── join key type mismatch (non-numeric mixes) ───────────────────────
    if succeeded("from s x join t y on x.s == y.ti select x.i", &c, &env) { return 131i32; }
    if succeeded("from s x join t y on x.i == y.ts select x.i", &c, &env) { return 132i32; }
    if succeeded("from s x join t y on x.b == y.ti select x.i", &c, &env) { return 133i32; }
    // ── having clause type misuse ────────────────────────────────────────
    if succeeded("from s x group by x.i aggregate n = count() having key select key", &c, &env) { return 135i32; }
    if succeeded("from s x group by x.i aggregate n = count() having x.s select key", &c, &env) { return 136i32; }
    // ── limit param type misuse ──────────────────────────────────────────
    let mut env2: QEnv = QEnv::new();
    env2.bind_source("s", ssrc); env2.bind_source("t", tsrc); env2.bind_f64("k", 2.0);
    if succeeded("from s x select x.i limit k", &c, &env2) { return 137i32; }
    let mut env3: QEnv = QEnv::new();
    env3.bind_source("s", ssrc); env3.bind_source("t", tsrc); env3.bind_str("k", "two");
    if succeeded("from s x select x.i limit k", &c, &env3) { return 138i32; }
    // ── unbound / cross-scope select vars ────────────────────────────────
    if succeeded("from s x select y.i", &c, &env) { return 139i32; }
    if succeeded("from s x where x.i > 0 select z.s", &c, &env) { return 140i32; }

    // ── POSITIVE controls: these MUST still succeed ──────────────────────
    if failed("from s x group by x.b aggregate n = count() select key", &c, &env) { return 150i32; } // bool key has Eq
    if failed("from s x join t y on x.f == y.ti select x.i", &c, &env)            { return 151i32; } // numeric-tower join
    if failed("from s x where x.i > 0 select x.i", &c, &env)                      { return 152i32; }
    if failed("from s x group by x.i aggregate n = count(), s2 = sum(x.i) select (key, n, s2)", &c, &env) { return 153i32; }

    return 0i32;
}
