// TWIN HALF of the pair pinning `BufWriter`'s drop.  One token apart from
// `bufwriter_drop_flushes_buffer.logos`: the single added statement
// `w.close();` below.  The count must be IDENTICAL -- `close` flushes and frees
// eagerly, and the drop that follows must do neither a second time.  A
// `flushes=2` here is the double-release the null guard exists to prevent.
//
// The oracle is a DESTRUCTOR COUNT, not an exit code: a `*mut i64` that
// `CountSink::write` bumps once per flush.  A buffer never flushed or freed
// reads `flushes=0`; a second release reads `flushes=2`.  Neither is visible to
// an exit code -- which is why all six fixtures of this leak class exited 42
// while losing memory.
//
// This half is GREEN on the pre-fix compiler too -- `close` was always there.
// It is the control that says the fix did not buy its half with a double free.
package test;

use logos.std.io.buffered;
use logos.std.io;
use logos.lang.mem;
use logos.lcm.io.write;

extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;

pub struct CountSink {
    pub flushes: *mut i64,
    pub fd:      i32,
}

impl Write for CountSink {
    fn write(self: &mut CountSink, buf: *const u8, len: i64) -> i64 {
        unsafe {
            self.flushes[0 as i64] = self.flushes[0 as i64] + 1 as i64;
            return write(self.fd, buf, len);
        }
    }
    fn flush(self: &mut CountSink) -> i64 { return 0 as i64; }
}

unsafe fn emit_digit(n: i64) {
    let d: [u8; 1] = [(48 as i64 + n) as u8];
    write(1, &d[0 as i64] as *const u8, 1 as i64);
}

fn main() -> i32 {
    unsafe {
        let craw: *mut u8 = alloc(8 as i64);
        let c: *mut i64 = craw as *mut i64;
        c[0 as i64] = 0 as i64;

        print("got=");
        {
            let mut w: BufWriter<CountSink> =
                buf_writer_wrap::<CountSink>(CountSink { flushes: c, fd: 1 }, 64 as i64);
            w.write_str("abc");
            w.close();
            // The drop still runs, and must flush nothing and free nothing.
        }
        print(" flushes=");
        let n: i64 = c[0 as i64];
        emit_digit(n);
        dealloc(craw);
        if n != 1 as i64 { return 3; }
    }
    return 42;
}
