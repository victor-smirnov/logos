// Test: OR-pattern with Writ scalars must short-circuit correctly.

package writ_match_or;

use logos.lang.writ.anyval;
use logos.lang.writ.pat;
use logos.lang.writ.container;
use logos.lang.rc;

unsafe fn mk(v: HAny) -> Rc<Writ> {
    let rc: Rc<Writ> = writ_rc(1024);
    let h: &Writ = rc.deref();
    h.set_root(v);
    return rc;
}

unsafe fn check(d: &Rc<Writ>) -> i32 {
    match d {
        @null | @42 => 1,
        @true | @-7 => 2,
        _ => 0,
    }
}

unsafe fn main() -> i32 {
    let a: Rc<Writ> = mk(HAny::Ref(0 as *const u8));        // 1
    let b: Rc<Writ> = mk(HAny::from(42 as i56));     // 1
    let c: Rc<Writ> = mk(HAny::from(true));  // 2
    let d: Rc<Writ> = mk(HAny::from(-7 as i56));     // 2
    let e: Rc<Writ> = mk(HAny::from(100 as i56));    // 0
    return check(&a) + check(&b) + check(&c) + check(&d) + check(&e); // 6
}
