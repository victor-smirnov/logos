package if_let_some;
// if let: extract payload from Opt::Some
extern fn printf(fmt: *const u8, ...) -> i32;
fn print(s: str) { unsafe { printf(s.as_ptr()); } }
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }

enum Opt { Some(i32), None }

unsafe fn main() -> i32 {
    let s = Opt::Some(42);
    let n = Opt::None;

    // if let Some(x) = s → prints x, else prints -1
    if let Opt::Some(x) = s {
        printi("%d ", x);
    } else {
        print("-1 ");
    }

    // if let Some(y) = n → not taken, prints 0
    if let Opt::Some(y) = n {
        printi("%d\n", y);
    } else {
        print("0\n");
    }

    return 0;
}
