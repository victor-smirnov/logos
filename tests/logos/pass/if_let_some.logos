package if_let_some;
// if let: extract payload from Opt::Some
extern fn printf(fmt: *const u8, ...) -> i32;

enum Opt { Some(i32), None }

fn main() -> i32 {
    let s = Opt::Some(42);
    let n = Opt::None;

    // if let Some(x) = s → prints x, else prints -1
    if let Opt::Some(x) = s {
        printf("%d ", x);
    } else {
        printf("-1 ");
    }

    // if let Some(y) = n → not taken, prints 0
    if let Opt::Some(y) = n {
        printf("%d\n", y);
    } else {
        printf("0\n");
    }

    return 0;
}
