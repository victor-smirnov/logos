package f5_question_op;
// `?` works on the prelude's Result (the lang item, ADR 0030 L0); a local `enum Result`
// without a `Try` impl is E0277 (try_on_user_result_without_try_refused), as in rustc.
fn parse(s: &str) -> Result<i32, i32> {
    return Result::<i32, i32>::Ok(5i32);
}
fn main_inner() -> Result<i32, i32> {
    let v: i32 = parse("5")?;
    return Result::<i32, i32>::Ok(v);
}
fn main() -> i32 { return 0i32; }
