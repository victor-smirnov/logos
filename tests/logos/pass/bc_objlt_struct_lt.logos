// THE LEGAL TWIN, ONE TOKEN APART: the object carries the struct's own lifetime.
package bc_objlt_struct_lt;
trait Tr { fn m(self: &Self) -> i64; }
struct W<'a> { r: &'a i64 }
impl<'a> Tr for W<'a> { fn m(self: &Self) -> i64 { return *self.r; } }
fn f<'a>(w: W<'a>) -> Box<dyn Tr + 'a> {
    return Box::new(w);
}
fn main() -> i32 { let n = 3i64; let b = f(W { r: &n }); return (b.m() - 3i64) as i32; }
