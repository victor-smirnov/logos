// A FAT result of a method that ALSO takes a ref/fat parameter is ambiguous
// under elision-without-lifetimes — the checker must NOT tie it to self
// (Token::text(&self, src: str) -> str slices src; the token is offsets).
package slice_ret_arg_not_self_tied;
use logos.lang.str;

pub struct Tok { start: i64, len: i64 }
impl Tok {
    // ⚠ THE RECEIVER IS BY VALUE, and that is the point of the fixture: with
    // `self: &Tok` there are TWO input regions and the elided result takes the
    // RECEIVER's under Rust's elision rule 3, so the returned `str` borrows the
    // token rather than `src` — rustc 1.98.1 then refuses the call site with
    // error[E0597] (MEASURED 2026-09-21). `Tok` is two scalars, so by value is
    // free, and it leaves `src` as the sole input region, which is what the name
    // of this fixture claims.
    pub fn text(self: Tok, src: str) -> str {
        return unsafe {
            str_from_raw((src.as_ptr() as i64 + self.start) as *const u8, self.len)
        };
    }
}
fn main() -> i32 {
    let src: str = "hello world";
    let mut name: str = "";
    {
        let t: Tok = Tok { start: 6i64, len: 5i64 };
        name = t.text(src);
    }                          // t dies; name borrows src, NOT t
    if str_cmp(name, "world") != 0i32 { return 1i32; }
    return 0i32;
}
