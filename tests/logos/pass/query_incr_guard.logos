// query_incr_guard — the slice-1 fragment guard is an error VALUE
// (Result::Err), not a compile diagnostic, so this is a PASS test. Asserts
// Query::incremental REJECTS every out-of-fragment plan (aggregate / limit /
// order-by / self-join / self-anti / rel-block / f64 (loop-tier) key) and
// ACCEPTS the linear + one-hash-join fragment PLUS a single top-level anti join
// (slice-2). Exit 0 iff all classifications correct.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Emp : code(0x0D02_0000_0000_0001) {
    name: str = 0,
    dept: i64 = 1,
    rate: f64 = 2,
}
pub schema Dept : code(0x0D02_0000_0000_0002) {
    id:    i64 = 0,
    dname: str = 1,
    cap:   f64 = 2,
}

resource cat = schema_catalog!{ Emp, Dept };

fn mk_emp(d: &Writ, name: str, dept: i64, rate: f64) -> WAny {
    let e: Emp = d.make::<Emp>();
    e.name = name; e.dept = dept; e.rate = rate;
    return WAny::ref_to((e.m as i64) as *const u8);
}
fn mk_dept(d: &Writ, id: i64, dname: str, cap: f64) -> WAny {
    let x: Dept = d.make::<Dept>();
    x.id = id; x.dname = dname; x.cap = cap;
    return WAny::ref_to((x.m as i64) as *const u8);
}

// true iff incremental() ACCEPTS (Ok).
fn accepts(qtext: str, c: &SchemaCatalog, env: &QEnv) -> bool {
    let q: Query = match Query::compile(qtext, c) { Result::Ok(v) => { v } Result::Err(_e) => { return false; } };
    let mut ok: bool = false;
    match q.incremental(env) { Result::Ok(_e) => { ok = true; } Result::Err(_e2) => { ok = false; } }
    return ok;
}

fn main() -> i32 {
    let doc: Writ = writ_new(8192i64);
    let emps: &mut WArray<WAny> = doc.array(4i64);
    emps.push(mk_emp(&doc, "Ann", 1i64, 1.5f64));
    emps.push(mk_emp(&doc, "Bob", 2i64, 2.5f64));
    let esrc: WAny = WAny::ref_to(emps as *const WArray<WAny> as *const u8);
    let depts: &mut WArray<WAny> = doc.array(4i64);
    depts.push(mk_dept(&doc, 1i64, "Core", 1.5f64));
    depts.push(mk_dept(&doc, 2i64, "Ops",  2.5f64));
    let dsrc: WAny = WAny::ref_to(depts as *const WArray<WAny> as *const u8);

    let c: SchemaCatalog = cat();
    let mut env: QEnv = QEnv::new();
    env.bind_source("emps", esrc);
    env.bind_source("depts", dsrc);

    // ACCEPT: the linear + one-hash-join fragment.
    if !accepts("from emps e join depts d on e.dept == d.id select d.dname", &c, &env) { return 1i32; }
    // ACCEPT: with a WHERE filter (linear) and a distinct (set mode).
    if !accepts("from emps e join depts d on e.dept == d.id where e.dept > 0 select distinct d.dname", &c, &env) { return 2i32; }

    // ACCEPT: anti join (slice-2 — stateful matchcount, §3/§10.4).
    if !accepts("from emps e anti join depts d on e.dept == d.id select e.name", &c, &env) { return 3i32; }
    // REJECT: self-anti (a single ΔA must feed both positions — §10.4).
    if accepts("from emps e anti join emps m on e.dept == m.dept select e.name", &c, &env) { return 11i32; }
    // ACCEPT: top-level GROUP aggregate over a single scan (slice-3, abelian
    // GROUP — count/sum/avg have an O(1) inverse-on-retract).
    if !accepts("from emps e group by e.dept aggregate cnt = count() select (key, cnt)", &c, &env) { return 4i32; }
    if !accepts("from emps e group by e.dept aggregate s = sum(e.dept) select (key, s)", &c, &env) { return 12i32; }
    if !accepts("from emps e group by e.dept aggregate a = avg(e.dept) select (key, a)", &c, &env) { return 13i32; }
    // REJECT: SEMILATTICE min/max incremental is deferred (§3.1 re-min on retraction).
    if accepts("from emps e group by e.dept aggregate m = min(e.dept) select (key, m)", &c, &env) { return 14i32; }
    if accepts("from emps e group by e.dept aggregate m = max(e.dept) select (key, m)", &c, &env) { return 15i32; }
    // REJECT: limit (top-of-plan, order-dependent).
    if accepts("from emps e join depts d on e.dept == d.id select d.dname limit 1", &c, &env) { return 5i32; }
    // REJECT: order by (RSort).
    if accepts("from emps e join depts d on e.dept == d.id select d.dname order by d.dname", &c, &env) { return 6i32; }
    // REJECT: self-join (a single ΔA must feed both positions — §10.4).
    if accepts("from emps e join emps m on e.dept == m.dept select e.name", &c, &env) { return 7i32; }
    // REJECT: f64 join key → loop tier (not hash-arrangeable).
    if accepts("from emps e join depts d on e.rate == d.cap select e.name", &c, &env) { return 8i32; }
    // REJECT: a rel block (reg.n != 0 — recursion/rels out of slice-1).
    if accepts("rel r(x: i64) { from emps e select e.dept; } from r p select p.x", &c, &env) { return 9i32; }
    // REJECT: no join at all (single scan).
    if accepts("from emps e select e.name", &c, &env) { return 10i32; }

    return 0i32;
}
