// Tests std.io_uring: open, write, read, close via io_uring.
package test;

use std.io.linux.uring;
use std.mem;
use logos.lang.result;

fn main() -> i32 {
    let mut ring: IoRing = match IoRing::new(8) {
        Result::Ok(r)  => { r }
        Result::Err(_) => { return 1; }
    };

    // Path: "/tmp/logos_io_ring_test.txt\0" (28 bytes + padding)
    let mut path: [u8; 31] = [
        47, 116, 109, 112, 47,           // /tmp/
        108, 111, 103, 111, 115, 95,     // logos_
        105, 111, 95, 114, 105, 110,     // io_rin
        103, 95, 116, 101, 115, 116,     // g_test
        46, 116, 120, 116, 0,            // .txt\0
        0, 0, 0                          // padding
    ];

    // Open (create + truncate) — O_RDWR|O_CREAT|O_TRUNC = 578, mode 0o666 = 438
    let fd: i32 = match (&mut ring).openat(AT_FDCWD(), &path[0], 578, 438) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return 2; }
    };

    // Write "Hello\n" (6 bytes)
    let mut wbuf: [u8; 8] = [72, 101, 108, 108, 111, 10, 0, 0];
    let nw: i64 = match (&mut ring).write(fd, &wbuf[0], 6 as i64, 0 as i64) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { let _: Result<(), IoUringError> = (&mut ring).close(fd); return 3; }
    };
    if nw != 6 as i64 {
        let _: Result<(), IoUringError> = (&mut ring).close(fd);
        return 3;
    }

    // Read back from offset 0
    let mut rbuf: [u8; 8] = [0, 0, 0, 0, 0, 0, 0, 0];
    let nr: i64 = match (&mut ring).read(fd, &mut rbuf[0], 6 as i64, 0 as i64) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { let _: Result<(), IoUringError> = (&mut ring).close(fd); return 4; }
    };
    if nr != 6 as i64 {
        let _: Result<(), IoUringError> = (&mut ring).close(fd);
        return 4;
    }

    // Verify: 'H'=72, 'o'=111
    if rbuf[0] != 72 {
        let _: Result<(), IoUringError> = (&mut ring).close(fd);
        return 5;
    }
    if rbuf[4] != 111 {
        let _: Result<(), IoUringError> = (&mut ring).close(fd);
        return 6;
    }

    match (&mut ring).close(fd) {
        Result::Ok(())  => { }
        Result::Err(_)  => { return 7; }
    }

    // ring drops here → io_uring_queue_exit + dealloc.
    return 42;
}
