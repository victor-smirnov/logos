// ADR 0011 — a `WAny`-typed schema field is dynamic: it stores/reads any WAny
// verbatim (identity — no conversion, no boxing). The heterogeneous-field case.
package test;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;

schema Cell : code(0x0005000000000000) {
    v:   WAny = 0,
    tag: i56  = 1,
}

fn main() -> i32 {
    let h: Writ = writ_new(256i64);
    let c: Cell = h.make::<Cell>();
    if !c.v.is_null() { return 10i32; }     // absent → null WAny

    c.v = WAny::from(42i56);
    if c.v.as_i64() != 42i64 { return 1i32; }

    c.v = WAny::from(true);                  // now holds a bool
    if !c.v.as_bool() { return 2i32; }

    c.v = WAny::from(-9i8);                   // now holds an i8
    if c.v.as_i64() != -9i64 { return 3i32; }

    c.tag = 5i56;
    if c.tag != 5i56 { return 4i32; }
    return 0i32;
}
