// A user trait implemented for the ambiguous-name `logos.mem.sync::Weak`: direct call, `&dyn` call, generic bound; clone + drop balance the weak count (rustc 1.98.1: 2 1 0).
package weak_ambiguous_name_user_trait_sync;
use logos.mem.sync;
extern fn printf(fmt: *const u8, ...) -> i32;
trait Probe { fn alive(&self) -> i32; }
impl<T> Probe for Weak<T> {
    fn alive(&self) -> i32 { match self.upgrade() { Option::Some(_a) => { return 1i32; } Option::None => { return 0i32; } } }
}
fn via<P: Probe>(p: &P) -> i32 { return p.alive() * 100i32; }
fn wca(a: &Arc<i32>) -> i32 { unsafe { let q: *mut Arc<i32> = a as *const Arc<i32> as *mut Arc<i32>; return q.weak_count(); } }
fn main() -> i32 {
    let a: Arc<i32> = arc_new::<i32>(20);
    let mut c0: i32 = 0i32;
    let mut al: i32 = 0i32;
    {
        let w: Weak<i32> = a.downgrade();
        let w2: Weak<i32> = w.clone();
        c0 = wca(&a);
        let d: &dyn Probe = &w2;
        al = d.alive() + via(&w) + via::<Weak<i32>>(&w2);
    }
    let c1: i32 = wca(&a);
    unsafe { printf("%d %d %d\n".as_ptr(), c0, al, c1); }
    return 0i32;
}
