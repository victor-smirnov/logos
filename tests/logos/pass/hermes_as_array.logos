// Hermes C6: Logos &[T] slice → typed hermes2 array via `as <T>[]` cast.
// The result is an Rc<Hermes> whose root is a TypedArray<T>; verify content
// via hermes2 stringify.
package hermes_as_array;
use logos.lang.hermes.typed_arr;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.mem.hermes.stringify;
use logos.mem.rc;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    // Build an i32 slice from a local array and cast to a typed hermes2 array.
    let arr: [i32; 3] = [10, 20, 30];
    let s: &[i32] = &arr;
    let ctr: Rc<Hermes> = s as <I32>[];
    let h: &Hermes = ctr.deref();
    let root: HAny = h.root();
    if root.is_null() { return 1; }
    if !root.is_ref() { return 2; }
    let text: String = stringify(root);
    if !text.eq_str("<I32> [10, 20, 30]") { return 3; }

    // u64 slice → TypedArray<u64>.
    let arr2: [u64; 2] = [100, 200];
    let s2: &[u64] = &arr2;
    let ctr2: Rc<Hermes> = s2 as <U64>[];
    let h2: &Hermes = ctr2.deref();
    let root2: HAny = h2.root();
    if root2.is_null() { return 4; }
    if !root2.is_ref() { return 5; }
    let text2: String = stringify(root2);
    if !text2.eq_str("<U64> [100, 200]") { return 6; }

    return 0;
}
