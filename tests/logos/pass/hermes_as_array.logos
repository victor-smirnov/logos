// Hermes C6: Logos &[T] slice → typed Hermes array via `as <T>[]` cast.
package hermes_as_array;
use hermes.ctr;

unsafe fn main() -> i32 {
    // Build an i32 slice from a local array and cast to ArrayI32 HermesCtr.
    let arr: [i32; 3] = [10, 20, 30];
    let s: &[i32] = &arr;
    let ctr: HermesCtr = s as <I32>[];
    let root: AnyVal = ctr.root();
    if root.is_null() { return 1; }

    // u64 slice → ArrayU64 HermesCtr.
    let arr2: [u64; 2] = [100, 200];
    let s2: &[u64] = &arr2;
    let ctr2: HermesCtr = s2 as <U64>[];
    let root2: AnyVal = ctr2.root();
    if root2.is_null() { return 2; }

    return 0;
}
