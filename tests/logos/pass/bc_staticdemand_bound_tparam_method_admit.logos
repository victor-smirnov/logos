// On a `T: Keep` receiver with a 'static argument; it runs.
// TWIN of fail/bc_staticdemand_bound_tparam_method_refuse, one token apart. src/compiler/PROBES.md 2026-09-13d-staticdemand.
package bc_staticdemand_bound_tparam_method_admit;
static N: i64 = 10i64;
trait Keep { fn keep<'a>(self: &Self, t: &'a i64) -> i64 where 'a: 'static; }
struct K { b: i64 }
impl Keep for K {
    fn keep<'a>(self: &Self, t: &'a i64) -> i64 where 'a: 'static { return *t + self.b; }
}
fn g<T: Keep>(d: &T, u: &'static i64) -> i64 {
    return d.keep(u);
}
fn main() -> i32 { let k = K { b: 1i64 }; return g(&k, &N) as i32; }
