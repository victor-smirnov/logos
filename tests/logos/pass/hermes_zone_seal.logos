package hermes_zone_seal;
// Phase 7: Zone<Mutable> → zone_seal() → Zone<Immutable>.
// Demonstrates: allocate in mutable zone, seal, read from immutable zone,
// verify holder RC lifecycle throughout.

use hermes.zone;

eidos Pair {
    a: i32,
    b: i32,
}

unsafe fn main() -> i32 {
    // Create mutable zone: holder RC = 1.
    let mut z: Zone<Mutable> = zone_create(4096);

    // Allocate two Pairs; each zone_alloc_typed retains → holder RC = 3.
    let p1: DataRef<Pair> = zone_alloc_typed::<Pair>(&mut z);
    let p2: DataRef<Pair> = zone_alloc_typed::<Pair>(&mut z);

    // Initialise via mut_ptr().
    let pw1: *mut Pair = p1.mut_ptr();
    pw1.a = 7;
    pw1.b = 3;

    let pw2: *mut Pair = p2.mut_ptr();
    pw2.a = 20;
    pw2.b = 12;

    // Seal the zone: Zone<Mutable> consumed, Zone<Immutable> returned.
    // The zone handle reference is transferred; holder RC stays 3.
    let frozen: Zone<Immutable> = zone_seal(z);

    // Read through DataRefs (still valid — holder is alive).
    let pr1: *const Pair = p1.ptr();
    let pr2: *const Pair = p2.ptr();
    let result: i32 = pr1.a + pr1.b + pr2.a + pr2.b;  // 7+3+20+12 = 42

    // Release references: each release() decrements holder RC.
    p1.release();      // holder RC → 2
    p2.release();      // holder RC → 1
    frozen.release();  // holder RC → 0 → zone buffer + MemHolder freed

    return result;  // 42
}
