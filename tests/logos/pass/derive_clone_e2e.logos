// derive(Clone) end-to-end via metaprog hook — mirror of derive_debug_e2e.
//
// Hook reads struct fields via OView::ast_struct_field_count /
// ast_struct_field / ast_field_name and emits an `impl Clone for Name`
// whose `clone(self: Self) -> Self` constructs a new value with each
// field set to `self.<f>.clone()`. Generic-aware: for `<T, ...>` the
// header becomes `impl<T: Clone, ...> Clone for Name<T, ...>`.

package main;

use std.hermes.view;
use std.hermes.anyval;
use std.hermes.string;
use std.compiler.metaprog;
use std.lang.clone;
use std.lang.text;

#[metaprog_handler("derive_clone")]
fn derive_clone_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: AnyVal = AnyVal::from_offset(target_offset);
    let name: StringView = view.ast_node_name(item);
    if name.len == (0 as u64) { return; }

    let nf: u64 = view.ast_struct_field_count(item);
    let np: u64 = view.ast_type_param_count(item);

    let mut em: Emitter = Emitter::new();
    em.emit_target_pkg(&view);
    em.emit_raw("use std.lang.clone;");

    // impl<T: Clone, ...> Clone for Name<T, ...>
    em.buf.push_str("impl");
    if np > (0 as u64) {
        em.buf.push_str("<");
        let mut k: u64 = 0 as u64;
        while k < np {
            if k > (0 as u64) { em.buf.push_str(", "); }
            let tp: StringView = view.ast_type_param_name(item, k);
            unsafe { em.buf.push_bytes(tp.ptr, tp.len as i64); }
            em.buf.push_str(": Clone");
            k = k + (1 as u64);
        }
        em.buf.push_str(">");
    }
    em.buf.push_str(" Clone for ");
    unsafe { em.buf.push_bytes(name.ptr, name.len as i64); }
    if np > (0 as u64) {
        em.buf.push_str("<");
        let mut k: u64 = 0 as u64;
        while k < np {
            if k > (0 as u64) { em.buf.push_str(", "); }
            let tp: StringView = view.ast_type_param_name(item, k);
            unsafe { em.buf.push_bytes(tp.ptr, tp.len as i64); }
            k = k + (1 as u64);
        }
        em.buf.push_str(">");
    }
    em.buf.push_str(" {");
    em.buf.push_u8(10 as u8);

    em.buf.push_str("    fn clone(self: ");
    unsafe { em.buf.push_bytes(name.ptr, name.len as i64); }
    if np > (0 as u64) {
        em.buf.push_str("<");
        let mut k: u64 = 0 as u64;
        while k < np {
            if k > (0 as u64) { em.buf.push_str(", "); }
            let tp: StringView = view.ast_type_param_name(item, k);
            unsafe { em.buf.push_bytes(tp.ptr, tp.len as i64); }
            k = k + (1 as u64);
        }
        em.buf.push_str(">");
    }
    em.buf.push_str(") -> ");
    unsafe { em.buf.push_bytes(name.ptr, name.len as i64); }
    if np > (0 as u64) {
        em.buf.push_str("<");
        let mut k: u64 = 0 as u64;
        while k < np {
            if k > (0 as u64) { em.buf.push_str(", "); }
            let tp: StringView = view.ast_type_param_name(item, k);
            unsafe { em.buf.push_bytes(tp.ptr, tp.len as i64); }
            k = k + (1 as u64);
        }
        em.buf.push_str(">");
    }
    em.buf.push_str(" {");
    em.buf.push_u8(10 as u8);

    em.buf.push_str("        return ");
    unsafe { em.buf.push_bytes(name.ptr, name.len as i64); }
    em.buf.push_str(" {");
    em.buf.push_u8(10 as u8);

    let mut i: u64 = 0 as u64;
    while i < nf {
        let fld: AnyVal = view.ast_struct_field(item, i);
        let fname: StringView = view.ast_field_name(fld);

        em.buf.push_str("            ");
        unsafe { em.buf.push_bytes(fname.ptr, fname.len as i64); }
        em.buf.push_str(": self.");
        unsafe { em.buf.push_bytes(fname.ptr, fname.len as i64); }
        em.buf.push_str(".clone(),");
        em.buf.push_u8(10 as u8);

        i = i + (1 as u64);
    }

    em.buf.push_str("        };");
    em.buf.push_u8(10 as u8);
    em.buf.push_str("    }");
    em.buf.push_u8(10 as u8);
    em.buf.push_str("}");
    em.commit();
    return;
}

#[derive_clone]
struct Pair { a: i32, b: i64 }

#[derive_clone]
struct GenPair<T> { x: T, y: T }

unsafe fn main() -> i32 {
    let p: Pair = Pair { a: 7, b: 100 };
    let q: Pair = p.clone();
    if q.a != 7 { return 11; }
    if q.b != (100 as i64) { return 12; }

    let g: GenPair<i32> = GenPair { x: 3, y: 5 };
    let h: GenPair<i32> = g.clone();
    if h.x != 3 { return 21; }
    if h.y != 5 { return 22; }

    return 0;
}
