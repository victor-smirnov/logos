// writ2 document header (successor of the Writ1 DocumentHeader test):
// the root word lives at blob offset 0, self-relative; null/Pod/Ref forms.
package writ_document;
use logos.lang.writ.hstatic;
use logos.lang.writ.anyval;
use logos.lang.writ.container;
use logos.lang.rc;

unsafe fn main() -> i32 {
    // Static blob: the header IS the first word.
    let s: WritStatic = @{"k": 1};
    let w: i64 = *(s.ptr as *const i64);
    if w == 0i64 { return 1; }                  // non-null root
    if (w & 1i64) != 0i64 { return 2; }         // a map root is a Ref (even delta)
    let root: HAny = HAny::Ref((s.ptr as i64 + w) as *const u8);
    if !root.is_map() { return 3; }

    // Pod root blob: the word is the Pod itself.
    let p: WritStatic = @42;
    let wp: i64 = *(p.ptr as *const i64);
    if (wp & 1i64) != 1i64 { return 4; }
    let proot: HAny = HAny::Pod(wp as u64);
    if proot.as_i64() != 42i64 { return 5; }

    // Runtime container: root() reconstructs the stored form.
    let c: Rc<Writ> = writ_rc(4096);
    let h: &Writ = c.deref();
    if !h.root().is_null() { return 6; }        // fresh container → null root
    h.set_root(HAny::from(7 as i56));
    if h.root().as_i64() != 7i64 { return 7; }

    return 42;
}
