// THE SCALAR ARITHMETIC INSIDE AN AGGREGATE'S ARGUMENT, OVER A `u64` COLUMN —
// the seam one level below `wql_u64_sum_accumulator`, with the same two error
// classes and one cell per operator.
//
// ── WHY THIS IS A SECOND SEAM AND NOT THE SAME ONE ──────────────────────────
// The accumulator adds a row's value into a running total; this file is about
// what computes the row's value in the first place. `sum(s.u + 1)` runs the
// `+` in `deem/tpl.logos`'s tree-walk evaluator (`eval_sexpr`), which has no plan and no
// catalog reach — it sees two `RtVal::I` payloads and a checked i64 add — and
// it fails in both directions for exactly the reason the accumulator did:
//
//   FALSE POSITIVE  `sum(s.u + s.u)` over one row holding 2^62. The true sum
//     2^63 FITS u64, the i64 add overflows, and the engine refuses a query
//     whose right answer is representable.
//   FALSE NEGATIVE  `sum(s.u + 1)` over one row holding 2^64-1. The true value
//     2^64 does NOT fit u64, the i64 add of the payloads (-1 and 1) is 0, and
//     0 is returned with no error at all.
//
// ── HOW THE CLAIM GETS HERE, WHICH IS THE PART THAT CAN BREAK QUIETLY ───────
// The checker joins its operands' `ordw` at every arithmetic node
// (`ct_join_ordw`) and hands the aggregate's argument type to `QPlan.agg_argu`;
// the evaluator takes that as `ua` and passes it DOWN through arithmetic
// operands and ternary branches only. Both halves must hold: if the checker
// stops joining, `agg_argu` goes false and these cells answer signed; if the
// evaluator stops threading, they answer signed too. Neither shows up in
// `wql_u64_sum_accumulator`, whose arguments are all bare column reads.
//
// A NON-NEGATIVE INTEGER LITERAL IS NEUTRAL in that join — it is in the domain
// of every integer type the EL admits — which is why `s.u + 1` is unsigned
// while `s.u + s.v` (a genuinely mixed expression) still drops the claim and
// keeps its old reading. Blocks 1 and 3 are the two sides of that.
//
// ── EVERY NUMBER IS DERIVED, NEVER READ OFF A RUN ──────────────────────────
//   sp: u = 2^62     = 4611686018427387904
//     u + u = 2^63   = 9223372036854775808, FITS u64; i64 bits -9223372036854775808
//                      [signed: an overflow error]
//     u * 3 = 13835058055282163712, FITS u64 (< 2^64), overflows i64;
//                      i64 bits 13835058055282163712 - 2^64 = -4611686018427387904
//                      [signed: an overflow error]
//     u - 5000000000000000000 UNDERFLOWS u64 (2^62 < 5e18) → error
//                      [signed: -388313981572612096, no error]
//   sq: u = 2^64-1   = 18446744073709551615
//     u + 1 = 2^64   → OVERFLOWS u64          [signed: -1 + 1 = 0, no error]
//     u / 3 = 6148914691236517205 exactly (3 · that = 2^64-1)  [signed: -1/3 = 0]
//     u % 10 = 5                                               [signed: -1 % 10 = -1]
// `/` and `%` are the sharp pair: unlike `+`/`-`/`*` they disagree on the
// VALUE and not merely on the overflow verdict, because the i64 division reads
// the payload as a negative number.
//
// EXIT CODES: 10s `+` (both directions), 20s `*`, 30s `-`, 40s `/` and `%`,
// 50s the SIGNED control (the same four operators over an i64 column), 60s the
// MIXED control (`u64 + i64` — the case the join still drops).
//
// exit 0 = an aggregate argument typed unsigned computes under the u64
//          overflow predicate, in both runtime tiers, for every operator.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.wql.wql;
use logos.mem.deem;
use logos.lang.result;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema V : code(0x0E68_0000_0000_0003) {
    id: i64 = 0,
    g:  i64 = 1,
    u:  u64 = 2,
    v:  i64 = 3
}
resource vcat = schema_catalog!{ V };

fn mkv(d: &Writ, id: i64, g: i64, u: u64, v: i64) -> WAny {
    let r: V = d.make::<V>();
    r.id = id; r.g = g; r.u = u; r.v = v;
    return WAny::ref_to((r.m as i64) as *const u8);
}

fn main() -> i32 {
    let d: Writ = writ_new(65536i64);
    let c: SchemaCatalog = vcat();

    let sp: &mut WArray<WAny> = d.array(2i64);
    sp.push(mkv(&d, 0i64, 7i64, 4611686018427387904u64, 0i64));
    let sq: &mut WArray<WAny> = d.array(2i64);
    sq.push(mkv(&d, 0i64, 7i64, 18446744073709551615u64, 0i64));
    // the signed control set: v = 10, 32, 0 in ONE group; `u` is 3 there so the
    // MIXED block has an unsigned operand to pair with a signed one.
    let sv: &mut WArray<WAny> = d.array(4i64);
    sv.push(mkv(&d, 0i64, 7i64, 3u64, 10i64));
    sv.push(mkv(&d, 1i64, 7i64, 3u64, 32i64));
    sv.push(mkv(&d, 2i64, 7i64, 3u64,  0i64));

    let mut e: QEnv = QEnv::new();
    e.bind_source("sp", WAny::ref_to(sp as *const WArray<WAny> as *const u8));
    e.bind_source("sq", WAny::ref_to(sq as *const WArray<WAny> as *const u8));
    e.bind_source("sv", WAny::ref_to(sv as *const WArray<WAny> as *const u8));

    // ══ 1. `+` — BOTH DIRECTIONS ═══════════════════════════════════════════
    // `s.u + s.u`: two unsigned operands. `s.u + 1`: one unsigned and one
    // NEUTRAL literal, which is the case the join had no way to express before
    // `CTy.lit` existed.
    let qa: Query = match Query::compile(
        "from sp s group by s.g aggregate t = sum(s.u + s.u) select t", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 10i32; } };
    let ra: QRows = match qa.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 11i32; } };
    if ra.row_count() != 1i64 { return 12i32; }
    if ra.get_i64(0i64, 0i64) != -9223372036854775808i64 { return 13i32; }
    let ga: IncrJoin = match qa.incremental(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 14i32; } };
    if ga.had_error() { return 15i32; }
    let sa2: QRows = ga.snapshot();
    if sa2.row_count() != 1i64 { return 16i32; }
    if sa2.get_i64(0i64, 0i64) != -9223372036854775808i64 { return 17i32; }

    let qb: Query = match Query::compile(
        "from sq s group by s.g aggregate t = sum(s.u + 1) select t", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 18i32; } };
    match qb.run(&e) {
        Result::Ok(_v) => { return 19i32; }   // 0 with no error, before the fix
        Result::Err(_e) => { }
    }
    let gb: IncrJoin = match qb.incremental(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 20i32; } };
    if !gb.had_error() { return 21i32; }

    // ══ 2. `*` — fits u64, overflows i64 ═══════════════════════════════════
    let qm: Query = match Query::compile(
        "from sp s group by s.g aggregate t = sum(s.u * 3) select t", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 22i32; } };
    let rm: QRows = match qm.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 23i32; } };
    if rm.row_count() != 1i64 { return 24i32; }
    if rm.get_i64(0i64, 0i64) != -4611686018427387904i64 { return 25i32; }
    let gm: IncrJoin = match qm.incremental(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 26i32; } };
    if gm.had_error() { return 27i32; }

    // ══ 3. `-` — an ordinary i64 subtraction, a u64 UNDERFLOW ══════════════
    let qs: Query = match Query::compile(
        "from sp s group by s.g aggregate t = sum(s.u - 5000000000000000000) select t", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 30i32; } };
    match qs.run(&e) {
        Result::Ok(_v) => { return 31i32; }
        Result::Err(_e) => { }
    }
    let gs: IncrJoin = match qs.incremental(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 32i32; } };
    if !gs.had_error() { return 33i32; }

    // ══ 4. `/` and `%` — the two that disagree on the VALUE ════════════════
    let qd: Query = match Query::compile(
        "from sq s group by s.g aggregate a = sum(s.u / 3), b = sum(s.u % 10) select (a, b)", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 40i32; } };
    let rd: QRows = match qd.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 41i32; } };
    if rd.row_count() != 1i64 { return 42i32; }
    if rd.get_i64(0i64, 0i64) != 6148914691236517205i64 { return 43i32; }
    if rd.get_i64(0i64, 1i64) != 5i64                   { return 44i32; }
    let gd: IncrJoin = match qd.incremental(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 45i32; } };
    if gd.had_error() { return 46i32; }
    let sd2: QRows = gd.snapshot();
    if sd2.row_count() != 1i64 { return 47i32; }
    if sd2.get_i64(0i64, 0i64) != 6148914691236517205i64 { return 48i32; }
    if sd2.get_i64(0i64, 1i64) != 5i64                   { return 49i32; }

    // ══ 5. THE SIGNED CONTROL — the same operators over an i64 column ══════
    //   sum(v / 3) = 3 + 10 + 0 = 13     sum(v % 3) = 1 + 2 + 0 = 3
    //   sum(v - 100) = (-90) + (-68) + (-100) = -258
    // The last is the sharp one: every subtraction in it UNDERFLOWS u64 and is
    // an ordinary i64 subtraction, so a fix keyed on the integer CLASS rather
    // than on the column's own type would answer an overflow error here —
    // which is exactly what block 3 gets, on the same shape.
    let qc: Query = match Query::compile(
        "from sv s group by s.g aggregate a = sum(s.v / 3), b = sum(s.v % 3), t = sum(s.v - 100) select (a, b, t)", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 50i32; } };
    let rc: QRows = match qc.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 51i32; } };
    if rc.row_count() != 1i64 { return 52i32; }
    if rc.get_i64(0i64, 0i64) != 13i64   { return 53i32; }
    if rc.get_i64(0i64, 1i64) != 3i64    { return 54i32; }
    if rc.get_i64(0i64, 2i64) != -258i64 { return 55i32; }
    let gc: IncrJoin = match qc.incremental(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 56i32; } };
    if gc.had_error() { return 57i32; }
    let sc2: QRows = gc.snapshot();
    if sc2.row_count() != 1i64 { return 58i32; }
    if sc2.get_i64(0i64, 2i64) != -258i64 { return 59i32; }

    // ══ 6. THE MIXED CONTROL — `u64 + i64` still DROPS the claim ═══════════
    // One operand claims the moved predicate and the other contradicts it, so
    // `ct_join_ordw` answers false and this expression keeps the reading it had
    // before any of this existed: a signed add. Over v = 10, 32, 0 and u = 3 the
    // sums are 13, 35, 3 → 51 either way, so this block is NOT about the number;
    // it is about the arm not being pulled into the unsigned path by a rule that
    // keys on "some operand is unsigned". `sum(s.v - 100)` in block 5 is where a
    // wrong answer would show; this is where a wrong TYPE would.
    let qx: Query = match Query::compile(
        "from sv s group by s.g aggregate t = sum(s.u + s.v) select t", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 60i32; } };
    let rx: QRows = match qx.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 61i32; } };
    if rx.row_count() != 1i64 { return 62i32; }
    if rx.get_i64(0i64, 0i64) != 51i64 { return 63i32; }

    return 0i32;
}
