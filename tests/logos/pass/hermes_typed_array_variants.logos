// hermes_typed_array_variants.logos — runtime coverage for all 8 new typed Array element types.
//
// Tests @<T>[...] literal construction and stringify for:
//   i8, u8, i16, u16, u32, i64, f32, f64
// f32/f64 HermesStringify casts elements to i64, so use whole-number values.

package hermes_typed_array_variants;

use hermes.view;
use hermes.stringify;
use hermes.array;
use hermes.map;
use hermes.typed_value;
use std.string;

unsafe fn check(hs: &HermesStatic, expected: str, err_code: i32) -> i32 {
    let s: String = hs.to_string();
    if !s.eq_str(expected) { return err_code; }
    return 0;
}

pub unsafe fn main() -> i32 {
    let mut rc: i32 = 0;

    // 1. Array<i8>
    let a1: HermesStatic = @<I8>[-1, 2, -3];
    rc = check(&a1, "<I8> [-1,2,-3]", 1);
    if rc != 0 { return rc; }

    // 2. Array<i8> empty
    let a2: HermesStatic = @<I8>[];
    rc = check(&a2, "<I8> []", 2);
    if rc != 0 { return rc; }

    // 3. Array<u8>
    let a3: HermesStatic = @<U8>[0, 255, 128];
    rc = check(&a3, "<U8> [0,255,128]", 3);
    if rc != 0 { return rc; }

    // 4. Array<u8> empty
    let a4: HermesStatic = @<U8>[];
    rc = check(&a4, "<U8> []", 4);
    if rc != 0 { return rc; }

    // 5. Array<i16>
    let a5: HermesStatic = @<I16>[-100, 200, -300];
    rc = check(&a5, "<I16> [-100,200,-300]", 5);
    if rc != 0 { return rc; }

    // 6. Array<u16>
    let a6: HermesStatic = @<U16>[1000, 2000, 65535];
    rc = check(&a6, "<U16> [1000,2000,65535]", 6);
    if rc != 0 { return rc; }

    // 7. Array<u32>
    let a7: HermesStatic = @<U32>[10, 20, 30];
    rc = check(&a7, "<U32> [10,20,30]", 7);
    if rc != 0 { return rc; }

    // 8. Array<i64>
    let a8: HermesStatic = @<I64>[-1000000, 0, 1000000];
    rc = check(&a8, "<I64> [-1000000,0,1000000]", 8);
    if rc != 0 { return rc; }

    // 9. Array<f32> — HermesStringify casts f32 to i64; use whole-number values.
    let a9: HermesStatic = @<F32>[1, 2, 3];
    rc = check(&a9, "<F32> [1,2,3]", 9);
    if rc != 0 { return rc; }

    // 10. Array<f64> — same truncation behaviour.
    let a10: HermesStatic = @<F64>[10, 20, 30];
    rc = check(&a10, "<F64> [10,20,30]", 10);
    if rc != 0 { return rc; }

    return 0;
}
