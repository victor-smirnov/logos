fn main() -> i32 {
    // ── i8 ── codes 20..25
    let rows_i8: [S_i8; 4] = [S_i8 { x: 1i8, id: 0i64 },
                              S_i8 { x: -128i8, id: 1i64 },
                              S_i8 { x: 127i8, id: 2i64 },
                              S_i8 { x: -1i8, id: 3i64 }];
    let v_i8: Vec<i8> = match sel_i8(&rows_i8[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 20i32; } };
    if v_i8.len() != 4i64 { return 21i32; }
    if v_i8.get(1i64) != -128i8 { return 22i32; }
    if v_i8.get(2i64) != 127i8 { return 23i32; }
    if v_i8.get(0i64) != 1i8 { return 24i32; }
    if v_i8.get(3i64) != -1i8 { return 24i32; }
    let o_i8: Vec<i64> = match ord_i8(&rows_i8[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 25i32; } };
    if o_i8.len() != 4i64 { return 25i32; }
    if o_i8.get(0i64) != 1i64 { return 25i32; }
    if o_i8.get(1i64) != 3i64 { return 25i32; }
    if o_i8.get(2i64) != 0i64 { return 25i32; }
    if o_i8.get(3i64) != 2i64 { return 25i32; }

    // ── i16 ── codes 26..31
    let rows_i16: [S_i16; 4] = [S_i16 { x: 1i16, id: 0i64 },
                                S_i16 { x: -32768i16, id: 1i64 },
                                S_i16 { x: 32767i16, id: 2i64 },
                                S_i16 { x: -1i16, id: 3i64 }];
    let v_i16: Vec<i16> = match sel_i16(&rows_i16[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 26i32; } };
    if v_i16.len() != 4i64 { return 27i32; }
    if v_i16.get(1i64) != -32768i16 { return 28i32; }
    if v_i16.get(2i64) != 32767i16 { return 29i32; }
    if v_i16.get(0i64) != 1i16 { return 30i32; }
    if v_i16.get(3i64) != -1i16 { return 30i32; }
    let o_i16: Vec<i64> = match ord_i16(&rows_i16[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 31i32; } };
    if o_i16.len() != 4i64 { return 31i32; }
    if o_i16.get(0i64) != 1i64 { return 31i32; }
    if o_i16.get(1i64) != 3i64 { return 31i32; }
    if o_i16.get(2i64) != 0i64 { return 31i32; }
    if o_i16.get(3i64) != 2i64 { return 31i32; }

    // ── i32 ── codes 32..37
    let rows_i32: [S_i32; 4] = [S_i32 { x: 1i32, id: 0i64 },
                                S_i32 { x: -2147483648i32, id: 1i64 },
                                S_i32 { x: 2147483647i32, id: 2i64 },
                                S_i32 { x: -1i32, id: 3i64 }];
    let v_i32: Vec<i32> = match sel_i32(&rows_i32[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 32i32; } };
    if v_i32.len() != 4i64 { return 33i32; }
    if v_i32.get(1i64) != -2147483648i32 { return 34i32; }
    if v_i32.get(2i64) != 2147483647i32 { return 35i32; }
    if v_i32.get(0i64) != 1i32 { return 36i32; }
    if v_i32.get(3i64) != -1i32 { return 36i32; }
    let o_i32: Vec<i64> = match ord_i32(&rows_i32[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 37i32; } };
    if o_i32.len() != 4i64 { return 37i32; }
    if o_i32.get(0i64) != 1i64 { return 37i32; }
    if o_i32.get(1i64) != 3i64 { return 37i32; }
    if o_i32.get(2i64) != 0i64 { return 37i32; }
    if o_i32.get(3i64) != 2i64 { return 37i32; }

    // ── i64 ── codes 38..43
    let rows_i64: [S_i64; 4] = [S_i64 { x: 1i64, id: 0i64 },
                                S_i64 { x: -9223372036854775808i64, id: 1i64 },
                                S_i64 { x: 9223372036854775807i64, id: 2i64 },
                                S_i64 { x: -1i64, id: 3i64 }];
    let v_i64: Vec<i64> = match sel_i64(&rows_i64[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 38i32; } };
    if v_i64.len() != 4i64 { return 39i32; }
    if v_i64.get(1i64) != -9223372036854775808i64 { return 40i32; }
    if v_i64.get(2i64) != 9223372036854775807i64 { return 41i32; }
    if v_i64.get(0i64) != 1i64 { return 42i32; }
    if v_i64.get(3i64) != -1i64 { return 42i32; }
    let o_i64: Vec<i64> = match ord_i64(&rows_i64[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 43i32; } };
    if o_i64.len() != 4i64 { return 43i32; }
    if o_i64.get(0i64) != 1i64 { return 43i32; }
    if o_i64.get(1i64) != 3i64 { return 43i32; }
    if o_i64.get(2i64) != 0i64 { return 43i32; }
    if o_i64.get(3i64) != 2i64 { return 43i32; }

    // ── i128 ── codes 44..49
    let rows_i128: [S_i128; 4] = [S_i128 { x: 1i128, id: 0i64 },
                                  S_i128 { x: -170141183460469231731687303715884105728i128, id: 1i64 },
                                  S_i128 { x: 170141183460469231731687303715884105727i128, id: 2i64 },
                                  S_i128 { x: -1i128, id: 3i64 }];
    let v_i128: Vec<i128> = match sel_i128(&rows_i128[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 44i32; } };
    if v_i128.len() != 4i64 { return 45i32; }
    if v_i128.get(1i64) != -170141183460469231731687303715884105728i128 { return 46i32; }
    if v_i128.get(2i64) != 170141183460469231731687303715884105727i128 { return 47i32; }
    if v_i128.get(0i64) != 1i128 { return 48i32; }
    if v_i128.get(3i64) != -1i128 { return 48i32; }
    let o_i128: Vec<i64> = match ord_i128(&rows_i128[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 49i32; } };
    if o_i128.len() != 4i64 { return 49i32; }
    if o_i128.get(0i64) != 1i64 { return 49i32; }
    if o_i128.get(1i64) != 3i64 { return 49i32; }
    if o_i128.get(2i64) != 0i64 { return 49i32; }
    if o_i128.get(3i64) != 2i64 { return 49i32; }

    // ── isize ── codes 50..55
    let rows_isize: [S_isize; 4] = [S_isize { x: 1isize, id: 0i64 },
                                    S_isize { x: -9223372036854775808isize, id: 1i64 },
                                    S_isize { x: 9223372036854775807isize, id: 2i64 },
                                    S_isize { x: -1isize, id: 3i64 }];
    let v_isize: Vec<isize> = match sel_isize(&rows_isize[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 50i32; } };
    if v_isize.len() != 4i64 { return 51i32; }
    if v_isize.get(1i64) != -9223372036854775808isize { return 52i32; }
    if v_isize.get(2i64) != 9223372036854775807isize { return 53i32; }
    if v_isize.get(0i64) != 1isize { return 54i32; }
    if v_isize.get(3i64) != -1isize { return 54i32; }
    let o_isize: Vec<i64> = match ord_isize(&rows_isize[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 55i32; } };
    if o_isize.len() != 4i64 { return 55i32; }
    if o_isize.get(0i64) != 1i64 { return 55i32; }
    if o_isize.get(1i64) != 3i64 { return 55i32; }
    if o_isize.get(2i64) != 0i64 { return 55i32; }
    if o_isize.get(3i64) != 2i64 { return 55i32; }

    // ── i24 ── codes 56..61
    let rows_i24: [S_i24; 4] = [S_i24 { x: 1i24, id: 0i64 },
                                S_i24 { x: -8388608i24, id: 1i64 },
                                S_i24 { x: 8388607i24, id: 2i64 },
                                S_i24 { x: -1i24, id: 3i64 }];
    let v_i24: Vec<i24> = match sel_i24(&rows_i24[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 56i32; } };
    if v_i24.len() != 4i64 { return 57i32; }
    if v_i24.get(1i64) != -8388608i24 { return 58i32; }
    if v_i24.get(2i64) != 8388607i24 { return 59i32; }
    if v_i24.get(0i64) != 1i24 { return 60i32; }
    if v_i24.get(3i64) != -1i24 { return 60i32; }
    let o_i24: Vec<i64> = match ord_i24(&rows_i24[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 61i32; } };
    if o_i24.len() != 4i64 { return 61i32; }
    if o_i24.get(0i64) != 1i64 { return 61i32; }
    if o_i24.get(1i64) != 3i64 { return 61i32; }
    if o_i24.get(2i64) != 0i64 { return 61i32; }
    if o_i24.get(3i64) != 2i64 { return 61i32; }

    // ── i56 ── codes 62..67
    let rows_i56: [S_i56; 4] = [S_i56 { x: 1i56, id: 0i64 },
                                S_i56 { x: -36028797018963968i56, id: 1i64 },
                                S_i56 { x: 36028797018963967i56, id: 2i64 },
                                S_i56 { x: -1i56, id: 3i64 }];
    let v_i56: Vec<i56> = match sel_i56(&rows_i56[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 62i32; } };
    if v_i56.len() != 4i64 { return 63i32; }
    if v_i56.get(1i64) != -36028797018963968i56 { return 64i32; }
    if v_i56.get(2i64) != 36028797018963967i56 { return 65i32; }
    if v_i56.get(0i64) != 1i56 { return 66i32; }
    if v_i56.get(3i64) != -1i56 { return 66i32; }
    let o_i56: Vec<i64> = match ord_i56(&rows_i56[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 67i32; } };
    if o_i56.len() != 4i64 { return 67i32; }
    if o_i56.get(0i64) != 1i64 { return 67i32; }
    if o_i56.get(1i64) != 3i64 { return 67i32; }
    if o_i56.get(2i64) != 0i64 { return 67i32; }
    if o_i56.get(3i64) != 2i64 { return 67i32; }

    // ── u8 ── codes 68..73
    let rows_u8: [S_u8; 4] = [S_u8 { x: 128u8, id: 0i64 },
                              S_u8 { x: 0u8, id: 1i64 },
                              S_u8 { x: 255u8, id: 2i64 },
                              S_u8 { x: 1u8, id: 3i64 }];
    let v_u8: Vec<u8> = match sel_u8(&rows_u8[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 68i32; } };
    if v_u8.len() != 4i64 { return 69i32; }
    if v_u8.get(1i64) != 0u8 { return 70i32; }
    if v_u8.get(2i64) != 255u8 { return 71i32; }
    if v_u8.get(0i64) != 128u8 { return 72i32; }
    if v_u8.get(3i64) != 1u8 { return 72i32; }
    let o_u8: Vec<i64> = match ord_u8(&rows_u8[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 73i32; } };
    if o_u8.len() != 4i64 { return 73i32; }
    if o_u8.get(0i64) != 1i64 { return 73i32; }
    if o_u8.get(1i64) != 3i64 { return 73i32; }
    if o_u8.get(2i64) != 0i64 { return 73i32; }
    if o_u8.get(3i64) != 2i64 { return 73i32; }

    // ── u16 ── codes 74..79
    let rows_u16: [S_u16; 4] = [S_u16 { x: 32768u16, id: 0i64 },
                                S_u16 { x: 0u16, id: 1i64 },
                                S_u16 { x: 65535u16, id: 2i64 },
                                S_u16 { x: 1u16, id: 3i64 }];
    let v_u16: Vec<u16> = match sel_u16(&rows_u16[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 74i32; } };
    if v_u16.len() != 4i64 { return 75i32; }
    if v_u16.get(1i64) != 0u16 { return 76i32; }
    if v_u16.get(2i64) != 65535u16 { return 77i32; }
    if v_u16.get(0i64) != 32768u16 { return 78i32; }
    if v_u16.get(3i64) != 1u16 { return 78i32; }
    let o_u16: Vec<i64> = match ord_u16(&rows_u16[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 79i32; } };
    if o_u16.len() != 4i64 { return 79i32; }
    if o_u16.get(0i64) != 1i64 { return 79i32; }
    if o_u16.get(1i64) != 3i64 { return 79i32; }
    if o_u16.get(2i64) != 0i64 { return 79i32; }
    if o_u16.get(3i64) != 2i64 { return 79i32; }

    // ── u32 ── codes 80..85
    let rows_u32: [S_u32; 4] = [S_u32 { x: 2147483648u32, id: 0i64 },
                                S_u32 { x: 0u32, id: 1i64 },
                                S_u32 { x: 4294967295u32, id: 2i64 },
                                S_u32 { x: 1u32, id: 3i64 }];
    let v_u32: Vec<u32> = match sel_u32(&rows_u32[..]) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 80i32; } };
    if v_u32.len() != 4i64 { return 81i32; }
    if v_u32.get(1i64) != 0u32 { return 82i32; }
    if v_u32.get(2i64) != 4294967295u32 { return 83i32; }
