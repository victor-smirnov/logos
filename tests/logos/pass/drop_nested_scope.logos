// Test: Droppable var in inner block, dropped when inner block exits
package drop_nested_scope;

extern fn printf(fmt: *const u8, ...) -> i32;
fn print(s: str) { unsafe { printf(s.as_ptr()); } }
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }

trait Drop {
    fn drop(self: Self);
}

struct Resource {
    id: i32,
}

impl Drop for Resource {
    fn drop(self: Resource) {
        printi("d%d ", self.id);
    }
}

unsafe fn main() -> i32 {
    let result: i32 = 42;
    let outer: Resource = Resource { id: 1 };
    if true {
        let inner: Resource = Resource { id: 2 };
        print("in ");
    }
    print("out ");
    return result;
}
