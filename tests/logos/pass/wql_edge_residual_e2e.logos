// WQL EDGE TRAVERSAL (slice D) — the OPTIONAL `on` residual: a traversal
// step's `on P` is a per-element FILTER after containment (no strategy
// cascade — traversal is always a nested loop whose source depends on the
// outer row var). Composes with `where` over the OUTER var and a scalar
// param referenced inside the residual.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

struct Emp  { pub name: str, pub skills: Vec<str> }
struct Dept { pub dname: str, pub emps: Vec<Emp> }

// Residual on BOTH traversal levels + where over the outer var.
resource eng_skills = wql!(depts: &[Dept], banned: str) {
    from depts d
    join d.emps e on e.name != "bob"
    join e.skills s on s != banned
    where d.dname == "eng"
    select s };

fn mk_emp(name: str, s1: str, s2: str) -> Emp {
    let mut sk: Vec<str> = Vec::<str>::new();
    if s1.len() > 0i64 { sk.push(s1); }
    if s2.len() > 0i64 { sk.push(s2); }
    return Emp { name: name, skills: sk };
}

fn main() -> i32 {
    let mut eng_emps: Vec<Emp> = Vec::<Emp>::new();
    eng_emps.push(mk_emp("ann", "rust", "none"));   // "none" filtered by residual
    eng_emps.push(mk_emp("bob", "cobol", ""));      // bob filtered at level 1
    let mut ops_emps: Vec<Emp> = Vec::<Emp>::new();
    ops_emps.push(mk_emp("eve", "sql", ""));        // ops filtered by where
    let mut depts: Vec<Dept> = Vec::<Dept>::new();
    depts.push(Dept { dname: "eng", emps: eng_emps });
    depts.push(Dept { dname: "ops", emps: ops_emps });

    let rows: Vec<str> = eng_skills(depts.as_slice(), "none");
    if rows.len() != 1i64 { return 1i32; }
    if !str_eq(rows.get(0i64), "rust") { return 2i32; }
    return 0i32;
}
