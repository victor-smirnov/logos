// Deferred-2 follow-up: mono's ClosureCall struct-callee dispatch now
// probes the impl method registry for call / call_mut / call_once
// (in that order) and picks the matching one, so `impl Fn` / `impl
// FnMut` / `impl FnOnce` on user structs all bridge correctly to the
// parenthesized bound (`F: Fn(...)` / `F: FnMut(...)` / `F:
// FnOnce(...)`).
//
// Pre-fix: the dispatch hardcoded "call", so FnMut and FnOnce
// struct-impls (whose methods are call_mut / call_once respectively)
// failed at link time with "<Struct>__call does not reference a valid
// function".
package fn_bound_struct_impl_all_three_test;

use logos.lang.ops;

// Fn (shared ref receiver) — method name = "call"
pub struct Adder { pub bias: i32 }
impl Fn<i32> for Adder {
    type Output = i32;
    fn call(&self, x: i32) -> i32 { return self.bias + x; }
}

// FnMut (mut ref receiver) — method name = "call_mut"
pub struct Counter { pub n: i32 }
impl FnMut<i32> for Counter {
    type Output = i32;
    fn call_mut(&mut self, x: i32) -> i32 {
        self.n = self.n + x;
        return self.n;
    }
}

// FnOnce (by-value receiver) — method name = "call_once"
pub struct Consumer { pub bias: i32 }
impl FnOnce<i32> for Consumer {
    type Output = i32;
    fn call_once(self: Consumer, x: i32) -> i32 { return self.bias + x; }
}

fn apply_fn<F: Fn(i32) -> i32>(f: F, x: i32) -> i32 { return f(x); }
fn apply_mut<F: FnMut(i32) -> i32>(f: F, x: i32) -> i32 {
    let mut g: F = f;
    return g(x);
}
fn apply_once<F: FnOnce(i32) -> i32>(f: F, x: i32) -> i32 { return f(x); }

unsafe fn main() -> i32 {
    let a = Adder { bias: 10 };
    if apply_fn::<Adder>(a, 5) != 15 { return 1; }

    let c = Counter { n: 100 };
    if apply_mut::<Counter>(c, 7) != 107 { return 2; }

    let k = Consumer { bias: 30 };
    if apply_once::<Consumer>(k, 12) != 42 { return 3; }

    return 42;
}
