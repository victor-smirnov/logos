package match_bool;
// F33: match on bool value
fn describe(b: bool) -> i32 {
    match b {
        true  => { return 1; }
        false => { return 0; }
    }
}
fn main() -> i32 {
    let t: i32 = describe(true);   // 1
    let f: i32 = describe(false);  // 0
    // t*42 + f*10 = 42
    return t * 42 + f * 10;
}
