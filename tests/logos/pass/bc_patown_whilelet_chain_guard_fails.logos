// `while let Some(s) = v.pop() && s.v < 3`: the popped value whose guard fails is dropped on the break path (3), n = 0 PROBES.md 2026-09-06d: `if let` / `while let` / let-chains lower BY DELEGATION to lower_match (temp hoist, per-arm scrutinee move, arm drops, cond-move merge); the count is a destructor tally through a raw pointer.
package bc_patown_whilelet_chain_guard_fails;
use logos.mem.collections.vec;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn mk(p: *mut i64, v: i64) -> Option<S> { return Option::Some(S { v: v, i: p }); }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    let mut n: i64 = 0i64;
    {
        let mut vs: Vec<S> = Vec::new();
        vs.push(S { v: 1i64, i: p });
        vs.push(S { v: 2i64, i: p });
        vs.push(S { v: 3i64, i: p });
        while let Option::Some(s) = vs.pop() && s.v < 3i64 {
            n = n + s.v;
        }
        if c != 3i64 { return 90i32; }
    }
    return (c * 10i64 + n) as i32;
}
