// Default method vs override dispatched through generic bound
package trait_default_generic;
trait HasVal {
    fn val(self: Self) -> i32 { return 0; }
}
struct Zero {}
struct Five { n: i32, }
impl HasVal for Zero {}
impl HasVal for Five {
    fn val(self: Five) -> i32 { return self.n; }
}
fn get<T: HasVal>(x: T) -> i32 { return x.val(); }
unsafe fn main() -> i32 {
    let z: Zero = Zero {};
    let f: Five = Five { n: 42 };
    return get::<Zero>(z) + get::<Five>(f);
}
