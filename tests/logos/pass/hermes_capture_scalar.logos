// Hermes capture: scalar values captured from variables into @-literals (hermes2).
package hermes_capture_scalar;
use logos.lang.hermes.tmpl;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.static_view;
use logos.mem.rc;

unsafe fn main() -> i32 {
    let v0: HView2 = HView2 { base: 0 as *const u8 };
    let id: i32 = 42;

    // Capture i32 scalar into untyped map.
    let doc: Rc<Hermes> = @{"id": $id};
    let h: &Hermes = doc.deref();
    let root: HAny = h.root();
    if root.is_null() { return 1; }
    if v0.get_int(v0.map_get(root, "id")) != 42i64 { return 10; }

    // Capture bool scalar.
    let flag: bool = true;
    let doc2: Rc<Hermes> = @{"ok": $flag};
    let h2: &Hermes = doc2.deref();
    let root2: HAny = h2.root();
    if root2.is_null() { return 2; }
    if !v0.get_bool(v0.map_get(root2, "ok")) { return 20; }

    // Capture expression.
    let a: i32 = 10;
    let b: i32 = 5;
    let doc3: Rc<Hermes> = @{"sum": ${a + b}};
    let h3: &Hermes = doc3.deref();
    let root3: HAny = h3.root();
    if root3.is_null() { return 3; }
    if v0.get_int(v0.map_get(root3, "sum")) != 15i64 { return 30; }

    return 0;
}
