package default_binding_mode_ref_tuple;
// Default binding modes (RFC 2005), tuple shape: `match &(T,U) { (a,b) => … }`.
// The `&tuple` scrutinee is accepted (deref to the inner tuple); a move-only
// element binds by reference (no move out of the borrow → no double-free), a
// Copy element by value. Built on the tuple-struct-element inline-layout fix.
use logos.mem.string;

fn add(p: &(i64, i64)) -> i64 { match p { (a, b) => { return a + b; } } }
fn slen(p: &(String, i64)) -> i64 { match p { (s, n) => { return s.len() + *n; } } }

fn main() -> i64 {
    let c: (i64, i64) = (2, 3);
    if add(&c) != 5 { return 1; }
    if add(&c) != 5 { return 2; }

    let s: (String, i64) = (String::from("xy"), 3);
    if slen(&s) != 5 { return 3; }
    if slen(&s) != 5 { return 4; }   // reuse — must not double-free
    return 0;
}
