package match_expr_i64;
// Bug: match-expr result type was always taken from the first arm.
// When first arm is IntLit(0) and second is i64(10000000000),
// result_type stayed IntLit → truncated. Fix: unify_int across arms.
fn main() -> i32 {
    let x: i64 = match 1 { 0 => 0, _ => 10000000000 };
    if x == 10000000000 { return 0; }
    return 1;
}
