// D1 round 10 / J0, ADMIT direction — the loan J0's deleted restriction was
// written to protect: the holder `vs` is LOOP-LOCAL, so the borrow of `c` dies
// with the region. It must still compile. Measured with a fire print inside
// merge_loans: this program reaches the join with ZERO raised rows — pop_scope
// released the loan inside the body — which is the evidence that the
// restriction was guarding an empty population.
package bc_d1r10_j0_region_scoped_admit;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn stash(c: &C, v: &mut Vec<B>) { v.push(c.mk()); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut i: i64 = 0i64;
    while i < 2i64 {
        let mut vs: Vec<B> = Vec::new();
        stash(&c, &mut vs);
        i = i + 1i64;
    }
    c.bump();                        // must be ADMITTED
    return c.v;
}
