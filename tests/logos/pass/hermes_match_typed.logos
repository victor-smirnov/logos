// SPDX-License-Identifier: Apache-2.0
// Test: typed-container patterns @<T>[..] / @<K,V>{..} match by type_code.

package hermes_match_typed;

use std.hermes.anyval;
use std.hermes.array;
use std.hermes.map;
use std.hermes.typed_value;
use std.hermes.ctr;
use std.hermes.pat;
use std.hermes.view;

unsafe fn kind(d: &HermesStatic) -> i32 {
    match d {
        @<I32>[..]            => 1,
        @<U64>[..]             => 2,
        @<Varchar, AnyVal>{..} => 3,
        @<I32, AnyVal>{..}     => 4,
        @[..]                  => 10,   // untyped ObjectArray
        @{}                    => 20,   // any map (fallback — shouldn't reach for typed map)
        _                      => 0,
    }
}

unsafe fn main() -> i32 {
    let i32_arr: HermesStatic = @<I32>[1, 2, 3];
    let u64_arr: HermesStatic = @<U64>[10, 20];
    let any_arr: HermesStatic = @[1, "two", 3];
    let str_map: HermesStatic = @{"a": 1, "b": 2};
    let i32_map: HermesStatic = @<I32, AnyVal>{1: 10, 2: 20};
    let scalar:  HermesStatic = @42;

    // 1 + 2 + 10 + 3 + 4 + 0 = 20; add offset → 123
    let s: i32 =
        kind(&i32_arr) +
        kind(&u64_arr) +
        kind(&any_arr) +
        kind(&str_map) +
        kind(&i32_map) +
        kind(&scalar);
    return s + 103;
}
