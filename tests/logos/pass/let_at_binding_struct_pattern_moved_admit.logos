// CLOSED 2026-09-23 (squeue #305): sema's flow-insensitive move/uninit diagnostics are retired; the BIR judges per CFG path and ADMITS this, as rustc does.
// SOUNDNESS QUEUE row let_at_binding_struct_pattern_moved_variable_refused (tier 3, refuses). A LEGAL
// `let y @ W { .. } = w;` IS REFUSED "use of moved variable 'y'".
//
// rustc 1.98.1 --edition 2024 compiles and runs it: k=3, n=2, exit 0 (twin
// src/compiler/probes/2026-09-16e-atbind/rust/a11.rs). We refuse it, and the sentence blames `y` — the
// binding the statement is INTRODUCING — for a move, which is not a thing the program does.
// ⚠ MEASURED DISTINCT from let_at_binding_tuple_sub_unsupported (a whitelist with no PAT_TUPLE) and from
// let_at_binding_type_annot_syntax (the PARSER): this spelling parses and reaches the move checker.
// Unmoved by 2026-09-16f-atbind (refused identically on base and landed). Reason 1: the refusal happens
// before any binder is given storage, so that round's change has no carrier here.
// Found 2026-09-16e (battery a11), rowed 2026-09-16f.
package let_at_binding_struct_pattern_moved_variable_refused;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
struct W { a: D, b: i64 }
fn g(p: *mut i64) -> i64 {
    let mut k: i64 = 0i64;
    {
        let w: W = W { a: D { v: 2i64, c: p }, b: 3i64 };
        let y @ W { .. } = w;
        k = y.b;
    }
    return k;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, rd(p)); }
    return 0i32;
}
