package trait_impl_two_types;
// Edge case: same trait impl for two different types, dispatch via generic
trait Val { fn val(self: Self) -> i32; }

struct Small { n: i32; }
struct Large { n: i32; }

impl Val for Small { fn val(self: Small) -> i32 { return self.n; } }
impl Val for Large { fn val(self: Large) -> i32 { return self.n * 10; } }

fn get_val<T: Val>(x: T) -> i32 { return x.val(); }

unsafe fn main() -> i32 {
    let s: Small = Small { n: 2 };    // val = 2
    let l: Large = Large { n: 4 };    // val = 40
    // 2 + 40 = 42
    return get_val::<Small>(s) + get_val::<Large>(l);
}
