// CLOSED soundness_queue row operator_autoref_temp_never_dropped (tier 1), round 2026-09-14o-autoreffund.
// `a == D { .. }` auto-borrows a fresh droppable rvalue to match `fn eq(&self, &other)`. It used to be spilled with no
// owner and never dropped (counter 1). SemaChecker::autoref_operand gives it a slot in the statement's temporary scope,
// initialised where the operand is evaluated, dropped at the end of the statement. The destructor COUNT is the oracle:
// 1001 = both owners ran; the program exits 0 only on 1001 and prints the count. Rust: exit 0.
package bc_autoreffund_operator_temp_dropped_admit;

extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
impl Eq for D { fn eq(&self, other: &D) -> bool { return self.v > 0i64 && other.v > 0i64; } }

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    {
        let a: D = D { v: 1i64, c: p };
        if !(a == D { v: 1000i64, c: p }) { return 3i32; }
    }
    let got: i64 = unsafe { n };
    unsafe { printf("n=%ld\n".as_ptr(), got); }
    if got != 1001i64 { return 1i32; }
    return 0i32;
}
