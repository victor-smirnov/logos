// TakeWhileIter / SkipWhileIter: the gating item, the skipped prefix, the tail and the phantom each die exactly once.
//
// #112 — the `*((&x) as *const T)` duplicate-owner class.

package rawdup_take_skip_while_drop_once;

use logos.std.fmt;
use logos.lang.option;
use logos.lang.iter;
use logos.mem.collections.vec;

// Heap-owning AND printing payload — see rawdup_option_filter_drop_once for why both
// halves are load-bearing. The assertion is the EXACT set of destructor lines.
struct Inner { pub n: i64, pub v: Vec<i64> }
impl Drop for Inner { fn drop(self: &mut Inner) { println!("DROP n={}", self.n); } }
fn mk(n: i64) -> Inner { let mut v: Vec<i64> = vec_new::<i64>(); v.push(n); return Inner { n: n, v: v }; }

fn lt3(x: &Inner) -> bool { return x.n < 3i64; }

fn main() -> i32 {
    println!("-- take_while");
    let mut s: Vec<Inner> = vec_new::<Inner>();
    s.push(mk(1i64)); s.push(mk(2i64)); s.push(mk(3i64)); s.push(mk(4i64));
    let t: TakeWhileIter<VecIntoIter<Inner>, Inner> =
        unsafe { iter_take_while::<VecIntoIter<Inner>, Inner>(s.into_iter(), lt3, mk(0i64)) };
    println!("count={}", t.count());
    println!("-- skip_while");
    let mut s2: Vec<Inner> = vec_new::<Inner>();
    s2.push(mk(11i64)); s2.push(mk(12i64)); s2.push(mk(13i64)); s2.push(mk(14i64));
    let k: SkipWhileIter<VecIntoIter<Inner>, Inner> =
        unsafe { iter_skip_while::<VecIntoIter<Inner>, Inner>(s2.into_iter(), lt3, mk(0i64)) };
    println!("count={}", k.count());
    println!("-- end");
    return 0i32;
}
