// hand battery: round 2026-09-16c-armelem, program h19_prefix_and_suffix — caught: [a, .., b] over [D; 4] — the suffix index is N-sc+j, and memory records this exact spelling binding the wrong index in an earlier round (base 411234).
// legality MEASURED with rustc 1.98.1 --edition 2024; the twin is
//   src/compiler/probes/2026-09-16c-armelem/rust/h19_prefix_and_suffix.rs and it prints the SAME line.
// The stdout pinned here IS the destructor trace (each drop does n = n*10 + v), so a leak
// reads short and a double free reads long — an exit code alone could not tell them apart.
package bc_armelem16c_hb_h19_prefix_and_suffix_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn g(p: *mut i64) -> i64 {
    let arr: [D; 4] = [D { v: 1i64, c: p }, D { v: 2i64, c: p }, D { v: 3i64, c: p }, D { v: 4i64, c: p }];
    match arr {
        [a, .., b] => { return a.v * 10i64 + b.v; }
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, n); }
    return 0i32;
}
