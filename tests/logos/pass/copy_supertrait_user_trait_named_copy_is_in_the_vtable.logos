// CLOSES soundness-queue row `copy_named_supertrait_loses_vtable_slot`
// (tier 3, `refuses`). A user's own `trait Copy` used as a SUPERTRAIT is an
// ordinary supertrait: its methods take vtable slots and `Sh` upcasts to it.
//
// Pre-fix (`ac6f342a01c2affb 43`) this program was REFUSED —
//   error [fn main]: trait 'Sh' has no method 'dup'
// — because four sites dropped a supertrait whose NAME was `Copy` from the
// vtable walk, the supertrait-existence check, the per-impl parity check and
// the emitted SUPERTRAITS list. Only the LANG ITEM is the methodless marker
// that has no slot; each site now asks `TraitBound::canonical_trait`, which it
// already had in hand.
//
// PAIR: fail/copy_supertrait_user_trait_named_copy_needs_an_impl — this file
// with `impl Copy for Sq` deleted, which must now be REFUSED (it was admitted,
// rc 0: row `copy_named_supertrait_impl_parity_skipped`, tier 2, `admits`).
// AND pass/copy_supertrait_lang_item_is_not_a_supertrait, the same shape
// against the real lang item, which must keep compiling with NO impl at all.
package copy_supertrait_user_trait_named_copy_is_in_the_vtable;
use logos.mem.boxed;
extern fn printf(fmt: *const u8, ...) -> i32;

trait Copy { fn dup(&self) -> i32; }
trait Sh: Copy { fn area(&self) -> i32; }

struct Sq { s: i32 }
impl Copy for Sq { fn dup(&self) -> i32 { return self.s * 10i32; } }
impl Sh for Sq { fn area(&self) -> i32 { return self.s * self.s; } }

unsafe fn main() -> i32 {
    let b: Box<dyn Sh> = Box::new(Sq { s: 3i32 });
    let a: i32 = b.area();
    let d: i32 = b.dup();
    printf("area=%d dup=%d\n".as_ptr(), a, d);
    if a != 9i32 { return 1i32; }
    if d != 30i32 { return 2i32; }
    return 0i32;
}
