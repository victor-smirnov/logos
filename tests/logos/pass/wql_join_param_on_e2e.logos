// WQL — SCALAR PARAM inside a join ON-predicate. `d.budget > min_b` references
// the deem!(…) scalar param `min_b` — a BOUND-side name in the equi/residual
// classification, so `e.dept == d.id` still drives the hash probe and the
// param comparison lands in the RESIDUAL (`hash join (i64 key) + residual`).
// Different arguments at different call sites re-parameterize the SAME
// generated fn (the prepared-statement model).
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct Emp  { pub dept: i64, pub salary: i64 }
struct Dept { pub id: i64,   pub budget: i64 }

resource rich_sal = deem!(emps: &[Emp], depts: &[Dept], min_b: i64) {
    from emps e
    join depts d on e.dept == d.id && d.budget > min_b
    select e.salary };

fn main() -> i32 {
    let emps: [Emp; 3] = [
        Emp { dept: 1i64, salary: 50i64 },   // dept 1 budget 200
        Emp { dept: 2i64, salary: 60i64 },   // dept 2 budget  80
        Emp { dept: 1i64, salary: 70i64 },
    ];
    let depts: [Dept; 2] = [
        Dept { id: 1i64, budget: 200i64 },
        Dept { id: 2i64, budget: 80i64  },
    ];

    // min_b = 100: only dept 1 qualifies.
    let hi: Vec<i64> = rich_sal(&emps[..], &depts[..], 100i64).unwrap();
    if hi.len() != 2i64      { return 1i32; }
    if hi.get(0i64) != 50i64 { return 2i32; }
    if hi.get(1i64) != 70i64 { return 3i32; }

    // min_b = 50: both depts qualify — same fn, new argument.
    let lo: Vec<i64> = rich_sal(&emps[..], &depts[..], 50i64).unwrap();
    if lo.len() != 3i64      { return 4i32; }
    if lo.get(1i64) != 60i64 { return 5i32; }
    return 0i32;
}
