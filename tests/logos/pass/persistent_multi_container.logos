// Multi-container in one snapshot:
//   - Create 4 containers (ids 1, 7, 99, 1000) in one snap.
//   - Each gets a distinct value formula so cross-container leaks
//     are visible (would resolve to a different value).
//   - open_pmap on a missing ctr_id returns an empty handle (arc.p == null).
//   - Operations on one container don't affect others.
//   - After commit + fork, all four containers are visible in the fork.

package persistent_multi_container;

use std.collections.vec;
use std.mem;
use std.lang.cmp; use std.lang.ord; use std.lang.datatypes;
use std.hermes.view; use std.hermes.anyval;

use std.data.persistent.node;
use std.data.persistent.cow;
use std.data.persistent.store;
use std.data.persistent.handle;

pub const StoreCfg: HermesStatic = @{
    "name": "multi-ctr", "ctr_id": <type:u64>, "snp_id": <type:u64>, "block_id": <type:u64>,
};
pub const MapCfg: HermesStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 8 };

unsafe fn cp_of(snap: &mut Snap<StoreCfg>) -> *mut u64 {
    let store_ref: &mut LockingStore<StoreCfg> = snap.arc.deref_mut();
    return &mut store_ref.next_block_id as *mut u64;
}

unsafe fn fill(cr: &mut ContainerRef<StoreCfg, MapCfg>, n: u64, mul: u64, snap_id: u64, cp: *mut u64) {
    let mut i: u64 = 0u64;
    while i < n {
        cr.insert(i, i * mul, &i as *const u64, snap_id, cp);
        i = i + 1u64;
    }
}

unsafe fn check(cr: &ContainerRef<StoreCfg, MapCfg>, n: u64, mul: u64) -> bool {
    if cr.len() != n { return false; }
    let mut i: u64 = 0u64;
    while i < n {
        let mut out: u64 = 0u64;
        if !cr.get(&i as *const u64, &mut out as *mut u64) { return false; }
        if out != i * mul { return false; }
        i = i + 1u64;
    }
    return true;
}

fn main() -> i32 {
    let mut store: Store<StoreCfg> = store_open::<StoreCfg>();
    let mut commit: i64 = -1i64;

    {
        let mut snap: Snap<StoreCfg> = snap_begin::<StoreCfg>(&mut store);
        let s_id: u64 = snap.snapshot_id;
        let cp: *mut u64 = unsafe { cp_of(&mut snap) };

        // Four containers, distinct multipliers.
        unsafe {
            let mut a: ContainerRef<StoreCfg, MapCfg> = create_pmap::<MapCfg, StoreCfg>(&mut snap, 1u64);
            fill(&mut a, 30u64, 3u64, s_id, cp);
            // Drop a here — its slot's NodeARC is in the dir; cr.arc share dropped.
        }
        unsafe {
            let mut b: ContainerRef<StoreCfg, MapCfg> = create_pmap::<MapCfg, StoreCfg>(&mut snap, 7u64);
            fill(&mut b, 50u64, 5u64, s_id, cp);
        }
        unsafe {
            let mut c: ContainerRef<StoreCfg, MapCfg> = create_pmap::<MapCfg, StoreCfg>(&mut snap, 99u64);
            fill(&mut c, 20u64, 9u64, s_id, cp);
        }
        unsafe {
            let mut d: ContainerRef<StoreCfg, MapCfg> = create_pmap::<MapCfg, StoreCfg>(&mut snap, 1000u64);
            fill(&mut d, 10u64, 13u64, s_id, cp);
        }

        // open_pmap on missing id returns empty handle.
        {
            let missing: ContainerRef<StoreCfg, MapCfg> =
                open_pmap::<MapCfg, StoreCfg>(&mut snap, 42u64);
            let p: *mut dyn BTreeNode<StoreCfg> = missing.arc.p;
            if (p as *mut u8) != (0 as *mut u8) { return 10; }
        }

        // Re-open each container, verify its own data.
        {
            let a: ContainerRef<StoreCfg, MapCfg> = open_pmap::<MapCfg, StoreCfg>(&mut snap, 1u64);
            if !unsafe { check(&a, 30u64, 3u64) } { return 11; }
            let b: ContainerRef<StoreCfg, MapCfg> = open_pmap::<MapCfg, StoreCfg>(&mut snap, 7u64);
            if !unsafe { check(&b, 50u64, 5u64) } { return 12; }
            let c: ContainerRef<StoreCfg, MapCfg> = open_pmap::<MapCfg, StoreCfg>(&mut snap, 99u64);
            if !unsafe { check(&c, 20u64, 9u64) } { return 13; }
            let d: ContainerRef<StoreCfg, MapCfg> = open_pmap::<MapCfg, StoreCfg>(&mut snap, 1000u64);
            if !unsafe { check(&d, 10u64, 13u64) } { return 14; }
        }

        commit = snap.commit();
    }
    if commit < 0i64 { return 20; }

    // Fork: all four containers visible, untouched.
    {
        let mut fork: Snap<StoreCfg> = snap_fork::<StoreCfg>(&mut store, commit);
        let a: ContainerRef<StoreCfg, MapCfg> = open_pmap::<MapCfg, StoreCfg>(&mut fork, 1u64);
        if !unsafe { check(&a, 30u64, 3u64) } { return 30; }
        let b: ContainerRef<StoreCfg, MapCfg> = open_pmap::<MapCfg, StoreCfg>(&mut fork, 7u64);
        if !unsafe { check(&b, 50u64, 5u64) } { return 31; }
        let c: ContainerRef<StoreCfg, MapCfg> = open_pmap::<MapCfg, StoreCfg>(&mut fork, 99u64);
        if !unsafe { check(&c, 20u64, 9u64) } { return 32; }
        let d: ContainerRef<StoreCfg, MapCfg> = open_pmap::<MapCfg, StoreCfg>(&mut fork, 1000u64);
        if !unsafe { check(&d, 10u64, 13u64) } { return 33; }
    }

    return 0;
}
