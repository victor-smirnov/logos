// `min`/`max` over an f64 column must return A VALUE FROM THE GROUP.
//
// They did not. Both engines seeded the accumulator at ±1.7976931348623157e308
// — `f64::MAX`, which is NOT the extremum of f64: ±inf and NaN all lie beyond
// it — and folded with the language's `<`/`>`, a PARTIAL order. Two failures
// fall out, and MEASURED at the previous HEAD both engines produced both:
//
//   group          asked   answered            should be
//   { +inf }       min     1.797…e308 (MAX)    +inf
//   { -inf }       max     -1.797…e308         -inf
//   { NaN }        min     1.797…e308          NaN      — a pure sentinel leak:
//   { NaN }        max     -1.797…e308         NaN        the answer is a value
//                                                         present in NO row
//   { NaN, 1.0 }   max     1.0                 NaN      — NaN is the greatest
//
// ⚠ INVISIBLE TO EVERY DIFFERENTIAL, which is why it survived: the static
// emitter and the dynamic engine implemented the IDENTICAL wrong thing, so
// static-vs-dynamic agreed perfectly and said nothing. The same blind spot hid
// the `rt_cmp` partial-order bug. Hence the expectations below are written-out
// CONSTANTS — an oracle that computed them by folding would just reproduce
// whichever fold it was written with.
//
// P5: the dynamic arm is deleted with the interpreter. THIS FIXTURE LOSES
// NOTHING BY IT — its own header says the differential was blind to the defect,
// and every assertion here is against a hand-written constant, not against the
// other engine. The sentinel-leak assertion (the one that names the WRONG value)
// is re-pointed at the static answers, where it now does the work it used to do
// on the dynamic ones. Exit codes 12 and 13 named the dynamic arms; retired.
//
// The rule is PostgreSQL's, and it is not a separate rule: `min`/`max` are the
// extremes under the SAME order `order by` uses (`f64_data_key`), so all NaNs
// are one value that is greater than everything, -0.0 equals +0.0, and IEEE
// order holds elsewhere. The seed is the order's own extremum and is always
// displaced by an actual row value.
//
// exit 0 = the emitted engine answers what PostgreSQL answers.
package test;

use logos.std.wql.wql;
use logos.lang.result;
use logos.lang.num.float;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

struct S { pub g: i64, pub v: f64 }

pub deem q_min(ss: &[S]) { from ss s group by s.g aggregate lo = min(s.v) select lo : f64 }
pub deem q_max(ss: &[S]) { from ss s group by s.g aggregate hi = max(s.v) select hi : f64 }

fn nan_()  -> f64 { return f64_from_bits(0x7FF8000000000000u64); }
fn pinf_() -> f64 { return f64_from_bits(0x7FF0000000000000u64); }
fn ninf_() -> f64 { return f64_from_bits(0xFFF0000000000000u64); }

// Four groups, each hand-decidable, in first-occurrence order:
//   g=0 { +inf }        g=1 { -inf }        g=2 { NaN }        g=3 { NaN, 1.0 }
fn rows() -> Vec<S> {
    let mut v: Vec<S> = vec_new::<S>();
    v.push(S { g: 0i64, v: pinf_() });
    v.push(S { g: 1i64, v: ninf_() });
    v.push(S { g: 2i64, v: nan_()  });
    v.push(S { g: 3i64, v: nan_()  });
    v.push(S { g: 3i64, v: 1.0f64  });
    return v;
}

// ⚠ THE EXPECTATIONS WERE CONSTANTS BUT THE EQUALITY WAS NOT. Until 2026-08-09
// this comparison spelled `f64_data_key(got) != f64_data_key(want)` — and
// `f64_data_key` is EXACTLY what the emitted min/max fold compares through
// (`stdlib/mem/wql/rexpr_walk.logos` emits `if f64_data_key(__v) < f64_data_key(…)`
// at both the batch and the incremental improve sites). So the hand-written
// constants were checked against the engine THROUGH THE ENGINE'S OWN COMPARATOR,
// and the file inherited the very sharing its header warns about.
//
// MEASURED 2026-08-09 — CONTROL-REVERT, at the function, not at a call site:
// `f64_data_key` in `stdlib/lang/num/float.logos` was made to return 0 for every
// input (a total order that calls every float equal), archives dropped, stdlib
// rebuilt. THE FILE AS IT STOOD AT `a4028326` EXITED 0. Green, on an engine
// whose `min`/`max` could no longer improve past their seed. Codes 10/11/30/31
// all went blind at once and NOT because the two sides agreed on a wrong answer
// — because the COMPARISON ITSELF was destroyed: `f64_data_key(a) != f64_data_key(b)`
// is false for every a, b, so `same` returned true whatever the engine said.
// Codes 20/21 survived only because they use raw `==` on f64, and the wrong
// answers happened not to be the sentinel they name.
// With the two arms below in place the same control gives **exit 10** — `pg_eq`
// fires first, at min over { NaN, 1.0 }; `same_bits` is the second net and would
// have caught it at 14 had `pg_eq` passed. MEASURED both ways, same build.
// A SECOND control — `0 - f64_total_key(x)`, an order-REVERSING key that is still
// injective and total — reds BOTH versions at 10, and says so: the old equality
// was defeated only by a key that stopped separating values, not by a key that
// merely ordered them wrongly. Naming which control a sensor survives is the
// point of running two.
//
// Two arms replace it, and NEITHER can be moved by the comparator:
//
//   `pg_eq`   — PostgreSQL VALUE equality written out from the rule (all NaNs
//               one value, −0.0 == +0.0, IEEE elsewhere). `x != x` IS the IEEE
//               NaN test, so this function calls NOTHING: not `f64_data_key`,
//               not `f64_total_key`, no stdlib entry at all.
//   `same_bits` — bit identity. This is the header's own claim stated exactly:
//               `min`/`max` must return A VALUE FROM THE GROUP, so the answer
//               must be bit-identical to the row it came from, payload and all.
//               It shares only `f64_to_bits`, a reinterpret cast with no
//               comparison in it — a degenerate ORDER cannot make it agree.
//               Nothing here is over-strict: every wanted cell below is a
//               bit-for-bit copy of a row value.
fn pg_eq(a: f64, b: f64) -> bool {
    let an: bool = a != a;
    let bn: bool = b != b;
    if an || bn { return an && bn; }   // all NaNs are one value, equal to nothing else
    return a == b;                     // `==` already calls -0.0 and +0.0 equal
}
fn same(got: &Vec<f64>, want: &Vec<f64>) -> bool {
    if got.len() != want.len() { return false; }
    let mut i: i64 = 0i64;
    while i < want.len() {
        if !pg_eq(got.get(i), want.get(i)) { return false; }
        i = i + 1i64;
    }
    return true;
}
fn same_bits(got: &Vec<f64>, want: &Vec<f64>) -> bool {
    if got.len() != want.len() { return false; }
    let mut i: i64 = 0i64;
    while i < want.len() {
        if f64_to_bits(got.get(i)) != f64_to_bits(want.get(i)) { return false; }
        i = i + 1i64;
    }
    return true;
}
fn v4(a: f64, b: f64, c: f64, d: f64) -> Vec<f64> {
    let mut v: Vec<f64> = vec_new::<f64>();
    v.push(a); v.push(b); v.push(c); v.push(d);
    return v;
}

fn main() -> i32 {
    let ss: Vec<S> = rows();

    // group order is first-occurrence: g = 0, 1, 2, 3.
    //   min: +inf, -inf, NaN, 1.0      (NaN is the greatest, so 1.0 wins in g=3)
    //   max: +inf, -inf, NaN, NaN      (NaN is the greatest, so it wins in g=3)
    let want_min: Vec<f64> = v4(pinf_(), ninf_(), nan_(), 1.0f64);
    let want_max: Vec<f64> = v4(pinf_(), ninf_(), nan_(), nan_());

    let gmin: Vec<f64> = q_min(ss.as_slice()).unwrap();
    let gmax: Vec<f64> = q_max(ss.as_slice()).unwrap();
    if !same(&gmin, &want_min) { return 10i32; }
    if !same(&gmax, &want_max) { return 11i32; }
    // …and bit-identically, which is the "a value FROM THE GROUP" claim itself:
    // every wanted cell above is a bit-for-bit copy of a row value, NaN payload
    // included, so nothing here is over-strict. Codes 12/13 named the deleted
    // dynamic arms and are NOT reused.
    if !same_bits(&gmin, &want_min) { return 14i32; }
    if !same_bits(&gmax, &want_max) { return 15i32; }

    // ⚠ The sentinel itself, asserted directly: f64::MAX must not appear in any
    // answer. This is the assertion that fails loudest if a seed ever leaks
    // again — it names the wrong value rather than only the right one.
    let mx: f64 = 1.7976931348623157e308f64;
    let mut i: i64 = 0i64;
    while i < 4i64 {
        if gmin.get(i) == mx || gmin.get(i) == -mx { return 20i32; }
        if gmax.get(i) == mx || gmax.get(i) == -mx { return 21i32; }
        i = i + 1i64;
    }

    // …and f64::MAX as an actual DATUM must still come back: the fix must make
    // the sentinel unreachable, not make the value unrepresentable.
    let mut t: Vec<S> = vec_new::<S>();
    t.push(S { g: 0i64, v: mx });
    t.push(S { g: 0i64, v: -mx });
    let mut w2: Vec<f64> = vec_new::<f64>(); w2.push(-mx);
    if !same(&q_min(t.as_slice()).unwrap(), &w2) { return 30i32; }
    let mut w3: Vec<f64> = vec_new::<f64>(); w3.push(mx);
    if !same(&q_max(t.as_slice()).unwrap(), &w3) { return 31i32; }
    if !same_bits(&q_min(t.as_slice()).unwrap(), &w2) { return 32i32; }
    if !same_bits(&q_max(t.as_slice()).unwrap(), &w3) { return 33i32; }

    return 0i32;
}
