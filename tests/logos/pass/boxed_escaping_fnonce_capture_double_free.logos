// A `Box<dyn FnOnce>` whose closure body consumes its capture, called once:
// the destructor runs ONCE. The call is Rust's call_once for a boxed FnOnce —
// the box is consumed (marked moved: no scope-end drop, so the env glue does not
// drop the capture a second time), the closure body's once-epilogue drops the
// captures it did not move out and frees the heap env (EClosure::fn_once /
// capture_body_moved → mlir-gen), and the call site frees the box block.
// valgrind clean. Twins: tests/logos/pass/boxed_fnonce_consume_shapes.logos,
// tests/logos/fail/boxed_fnonce_called_twice_refused.logos.
package boxed_escaping_fnonce_capture_double_free;

use logos.mem.boxed;

struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }

fn mko(p: *mut i64) -> Box<dyn FnOnce() -> i64> {
    let x: D = D { v: 1i64, c: p };
    return Box::new(move || -> i64 { let t: D = x; return t.v; });
}

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut r: i64 = -1i64;
    {
        let f: Box<dyn FnOnce() -> i64> = mko(p);
        r = f();
    }
    if r != 1i64 { return 3i32; }
    let got: i64 = unsafe { n };
    if got != 1i64 { return 2i32; }
    return 0i32;
}
// rustc 1.98.1 --edition 2024 (round 2026-09-15f-rustcaudit, class CONFIRMED): COMPILES and RUNS exit 0. Twin src/compiler/probes/2026-09-15f-rustcaudit/rust/boxed_escaping_fnonce_capture_double_free.rs. Audit note: Box<dyn FnOnce> call consumes; control exit 2.
