// query_tail_order_adv — ADVERSARIAL, ORDER-SENSITIVE differential over the
// select-tail modifiers (`order by [asc|desc]`, `limit n|param`, `having`,
// aggregate-output ordering). THREE independent evaluators of the same query
// are compared POSITIONALLY (the query DEFINES the row order — the result is
// NOT sorted before comparison):
//   • STATIC  `deem!` native emitted fns (codegen path);
//   • DYNAMIC `Query::compile`/`run` interpreter;
//   • NAIVE   brute-force oracle with a hand-written STABLE sort (equal sort
//             keys keep scan order) that shares zero code with the engine.
//
// Each row projects to a SINGLE i64 that is UNIQUE per source row (a2 is set to
// the row index, 0..n), so an exact positional sequence compare pins down every
// ordering/tie/limit decision. Boundary limits (0, >rowcount, negative, param)
// and empty inputs are drawn adversarially. Exit 0 iff all three agree in every
// iteration; a nonzero code names the failing shape.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.wql.wql;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

struct SA { pub a0: i64, pub a1: i64, pub a2: i64 }
pub schema A : code(0x0DF3_0000_0000_0001) { a0: i64 = 0, a1: i64 = 1, a2: i64 = 2 }
resource cat = schema_catalog!{ A };

// STATIC shapes (fixed text; a2 == row index makes each projection unique).
pub deem so_asc(a: &[SA]) { from a x select x.a0 * 1000 + x.a2 order by x.a0 : i64 }
pub deem so_desc(a: &[SA]) { from a x select x.a0 * 1000 + x.a2 order by x.a0 desc : i64 }
pub deem so_k1(a: &[SA]) { from a x select x.a1 * 1000 + x.a2 order by x.a1 : i64 }
pub deem so_lim(a: &[SA], n: i64) { from a x select x.a0 * 1000 + x.a2 order by x.a0 limit n : i64 }
pub deem so_wlim(a: &[SA], thr: i64, n: i64) { from a x where x.a1 >= thr select x.a0 * 1000 + x.a2 order by x.a0 desc limit n : i64 }
pub deem sg_ord(a: &[SA]) { from a x group by x.a0 aggregate s = sum(x.a1) select key * 1000 + s order by key desc : i64 }
pub deem sg_hav(a: &[SA]) { from a x group by x.a0 aggregate c = count() having c >= 2 select key * 100 + c order by key : i64 }
pub deem so_scan(a: &[SA], n: i64) { from a x select x.a0 * 1000 + x.a2 limit n : i64 }

struct Rng { s: u64 }
impl Rng {
    fn next(self: &mut Rng) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
    fn upto(self: &mut Rng, n: i64) -> i64 { return (self.next() % (n as u64)) as i64; }
    fn range(self: &mut Rng, lo: i64, hi: i64) -> i64 { return lo + self.upto(hi - lo); }
}

// raw data flat stride 3; col2 forced to row index (unique tag).
fn gen_rows(rng: &mut Rng, n: i64, vrange: i64) -> Vec<i64> {
    let mut v: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < n {
        v.push(rng.upto(vrange));   // a0
        v.push(rng.upto(vrange));   // a1
        v.push(i);                  // a2 = row index (unique)
        i = i + 1i64;
    }
    return v;
}
fn rg(v: &Vec<i64>, row: i64, col: i64) -> i64 { return v.get(row * 3i64 + col); }
fn nrows_of(v: &Vec<i64>) -> i64 { return v.len() / 3i64; }
fn contains(v: &Vec<i64>, x: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < v.len() { if v.get(i) == x { return true; } i = i + 1i64; }
    return false;
}

// POSITIONAL (ordered) equality — NO sorting; the query defines the order.
fn eq_ord(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    if a.len() != b.len() { return false; }
    let mut i: i64 = 0i64;
    while i < a.len() { if a.get(i) != b.get(i) { return false; } i = i + 1i64; }
    return true;
}

// dynamic-engine Writ builders + one-column ordered extract
fn mkA(d: &Writ, x0: i64, x1: i64, x2: i64) -> WAny {
    let r: A = d.make::<A>(); r.a0 = x0; r.a1 = x1; r.a2 = x2;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn wsrcA(d: &Writ, raw: &Vec<i64>) -> WAny {
    let n: i64 = nrows_of(raw); let arr: &mut WArray<WAny> = d.array(n + 1i64);
    let mut i: i64 = 0i64;
    while i < n { arr.push(mkA(d, rg(raw, i, 0i64), rg(raw, i, 1i64), rg(raw, i, 2i64))); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}
fn dyn_run(qt: str, c: &SchemaCatalog, env: &QEnv) -> Vec<i64> {
    let mut out: Vec<i64> = vec_new::<i64>();
    match Query::compile(qt, c) {
        Result::Ok(q) => {
            match q.run(env) {
                Result::Ok(r) => {
                    let nr: i64 = r.row_count();
                    let mut i: i64 = 0i64;
                    while i < nr { out.push(r.get_i64(i, 0i64)); i = i + 1i64; }
                }
                Result::Err(_e2) => { out.push(-998i64); }
            }
        }
        Result::Err(_e) => { out.push(-999i64); }
    }
    return out;
}
fn slabA(raw: &Vec<i64>) -> Vec<SA> {
    let mut v: Vec<SA> = vec_new::<SA>(); let n: i64 = nrows_of(raw); let mut i: i64 = 0i64;
    while i < n { v.push(SA { a0: rg(raw, i, 0i64), a1: rg(raw, i, 1i64), a2: rg(raw, i, 2i64) }); i = i + 1i64; }
    return v;
}

// ── naive STABLE sort of row indices by key column `kc`, asc/desc ─────────────
// preserves input order among equal keys (== engine's stable insertion sort).
fn stable_order(raw: &Vec<i64>, kc: i64, desc: bool) -> Vec<i64> {
    let n: i64 = nrows_of(raw);
    let mut ord: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < n {
        // insertion of i keeping stability
        ord.push(i);
        let mut j: i64 = ord.len() - 1i64;
        while j > 0i64 {
            let kb: i64 = rg(raw, ord.get(j - 1i64), kc);
            let kv: i64 = rg(raw, ord.get(j), kc);
            let swap: bool = if desc { kb < kv } else { kb > kv };
            if !swap { j = -1i64; } else {
                let t: i64 = ord.get(j); ord.set(j, ord.get(j - 1i64)); ord.set(j - 1i64, t);
                j = j - 1i64;
            }
        }
        i = i + 1i64;
    }
    return ord;
}

fn main() -> i32 {
    let mut rng: Rng = Rng { s: 0xD1B54A32D192ED03u64 };
    let c: SchemaCatalog = cat();
    let NITER: i64 = 2500i64;
    let MAXROWS: i64 = 9i64;

    let mut it: i64 = 0i64;
    while it < NITER {
        let shape: i64 = rng.upto(8i64);
        let VRANGE: i64 = rng.range(2i64, 7i64);
        let na: i64 = rng.upto(MAXROWS);
        let av: Vec<i64> = gen_rows(&mut rng, na, VRANGE);
        let thr: i64 = rng.upto(VRANGE);
        // limit boundary: negative, 0, mid, > rowcount
        let lim: i64 = rng.range(-2i64, na + 3i64);

        let d: Writ = writ_new(8192i64);
        let mut env: QEnv = QEnv::new();
        env.bind_source("a", wsrcA(&d, &av));
        let sla: Vec<SA> = slabA(&av);

        let mut stat: Vec<i64> = vec_new::<i64>();
        let mut dynv: Vec<i64> = vec_new::<i64>();
        let mut naive: Vec<i64> = vec_new::<i64>();

        if shape == 0i64 {
            // order by a0 ASC
            stat = so_asc(sla.as_slice()).unwrap();
            dynv = dyn_run("from a x select x.a0 * 1000 + x.a2 order by x.a0", &c, &env);
            let ord: Vec<i64> = stable_order(&av, 0i64, false);
            let mut k: i64 = 0i64;
            while k < ord.len() { let r: i64 = ord.get(k); naive.push(rg(&av, r, 0i64) * 1000i64 + rg(&av, r, 2i64)); k = k + 1i64; }
        } else if shape == 1i64 {
            // order by a0 DESC
            stat = so_desc(sla.as_slice()).unwrap();
            dynv = dyn_run("from a x select x.a0 * 1000 + x.a2 order by x.a0 desc", &c, &env);
            let ord: Vec<i64> = stable_order(&av, 0i64, true);
            let mut k: i64 = 0i64;
            while k < ord.len() { let r: i64 = ord.get(k); naive.push(rg(&av, r, 0i64) * 1000i64 + rg(&av, r, 2i64)); k = k + 1i64; }
        } else if shape == 2i64 {
            // order by a1 ASC (different key column)
            stat = so_k1(sla.as_slice()).unwrap();
            dynv = dyn_run("from a x select x.a1 * 1000 + x.a2 order by x.a1", &c, &env);
            let ord: Vec<i64> = stable_order(&av, 1i64, false);
            let mut k: i64 = 0i64;
            while k < ord.len() { let r: i64 = ord.get(k); naive.push(rg(&av, r, 1i64) * 1000i64 + rg(&av, r, 2i64)); k = k + 1i64; }
        } else if shape == 3i64 {
            // where a1>=thr, order by a0 DESC, limit param
            env.bind_i64("thr", thr);
            env.bind_i64("n", lim);
            stat = so_wlim(sla.as_slice(), thr, lim).unwrap();
            let mut qs: String = String::new();
            qs.push_str("from a x where x.a1 >= thr select x.a0 * 1000 + x.a2 order by x.a0 desc limit n");
            dynv = dyn_run(qs.as_str(), &c, &env);
            let ord: Vec<i64> = stable_order(&av, 0i64, true);
            let mut k: i64 = 0i64; let mut cnt: i64 = 0i64;
            let cap: i64 = if lim < 0i64 { 0i64 } else { lim };
            while k < ord.len() {
                let r: i64 = ord.get(k);
                if rg(&av, r, 1i64) >= thr { if cnt < cap { naive.push(rg(&av, r, 0i64) * 1000i64 + rg(&av, r, 2i64)); cnt = cnt + 1i64; } }
                k = k + 1i64;
            }
        } else if shape == 4i64 {
            // order by a0 ASC, limit param
            env.bind_i64("n", lim);
            stat = so_lim(sla.as_slice(), lim).unwrap();
            dynv = dyn_run("from a x select x.a0 * 1000 + x.a2 order by x.a0 limit n", &c, &env);
            let ord: Vec<i64> = stable_order(&av, 0i64, false);
            let cap: i64 = if lim < 0i64 { 0i64 } else { lim };
            let mut k: i64 = 0i64;
            while k < ord.len() && k < cap { let r: i64 = ord.get(k); naive.push(rg(&av, r, 0i64) * 1000i64 + rg(&av, r, 2i64)); k = k + 1i64; }
        } else if shape == 5i64 {
            // group by a0 aggregate sum(a1), order by key DESC
            stat = sg_ord(sla.as_slice()).unwrap();
            dynv = dyn_run("from a x group by x.a0 aggregate s = sum(x.a1) select key * 1000 + s order by key desc", &c, &env);
            // distinct keys, then order desc
            let mut keys: Vec<i64> = vec_new::<i64>(); let mut r: i64 = 0i64;
            while r < na { let k: i64 = rg(&av, r, 0i64); if !contains(&keys, k) { keys.push(k); } r = r + 1i64; }
            // selection sort keys DESC (keys unique, stability irrelevant)
            let mut i2: i64 = 0i64;
            while i2 < keys.len() {
                let mut m: i64 = i2; let mut j2: i64 = i2 + 1i64;
                while j2 < keys.len() { if keys.get(j2) > keys.get(m) { m = j2; } j2 = j2 + 1i64; }
                if m != i2 { let t: i64 = keys.get(i2); keys.set(i2, keys.get(m)); keys.set(m, t); }
                i2 = i2 + 1i64;
            }
            let mut ki: i64 = 0i64;
            while ki < keys.len() {
                let k: i64 = keys.get(ki); let mut sm: i64 = 0i64; let mut r2: i64 = 0i64;
                while r2 < na { if rg(&av, r2, 0i64) == k { sm = sm + rg(&av, r2, 1i64); } r2 = r2 + 1i64; }
                naive.push(k * 1000i64 + sm); ki = ki + 1i64;
            }
        } else if shape == 6i64 {
            // group by a0 aggregate count, having c>=2, order by key ASC
            stat = sg_hav(sla.as_slice()).unwrap();
            dynv = dyn_run("from a x group by x.a0 aggregate c = count() having c >= 2 select key * 100 + c order by key", &c, &env);
            let mut keys: Vec<i64> = vec_new::<i64>(); let mut r: i64 = 0i64;
            while r < na { let k: i64 = rg(&av, r, 0i64); if !contains(&keys, k) { keys.push(k); } r = r + 1i64; }
            // sort keys ASC
            let mut i2: i64 = 0i64;
            while i2 < keys.len() {
                let mut m: i64 = i2; let mut j2: i64 = i2 + 1i64;
                while j2 < keys.len() { if keys.get(j2) < keys.get(m) { m = j2; } j2 = j2 + 1i64; }
                if m != i2 { let t: i64 = keys.get(i2); keys.set(i2, keys.get(m)); keys.set(m, t); }
                i2 = i2 + 1i64;
            }
            let mut ki: i64 = 0i64;
            while ki < keys.len() {
                let k: i64 = keys.get(ki); let mut cc: i64 = 0i64; let mut r2: i64 = 0i64;
                while r2 < na { if rg(&av, r2, 0i64) == k { cc = cc + 1i64; } r2 = r2 + 1i64; }
                if cc >= 2i64 { naive.push(k * 100i64 + cc); }
                ki = ki + 1i64;
            }
        } else {
            // limit-only (no order): first `lim` in SCAN order (non-sorted scan-limit path)
            env.bind_i64("n", lim);
            stat = so_scan(sla.as_slice(), lim).unwrap();
            dynv = dyn_run("from a x select x.a0 * 1000 + x.a2 limit n", &c, &env);
            let cap: i64 = if lim < 0i64 { 0i64 } else { lim };
            let mut k: i64 = 0i64;
            while k < na && k < cap { naive.push(rg(&av, k, 0i64) * 1000i64 + rg(&av, k, 2i64)); k = k + 1i64; }
        }

        if !eq_ord(&stat, &naive) { return 40i32 + (shape as i32); }
        if !eq_ord(&dynv, &naive) { return 60i32 + (shape as i32); }
        it = it + 1i64;
    }
    return 0i32;
}
