// hand battery: round 2026-09-17l, program b03_rvalue — caught: the genuine RVALUE carrier — it has no place to address, so it proves the spill fallback is still reached and correct
// legality MEASURED with rustc 1.98.1 --edition 2024 (twin beside the round record).
package bc_17l_hb_b03_rvalue;
extern fn printf(fmt: *const u8, ...) -> i32;
fn mk() -> [i64; 2] { return [1i64, 2i64]; }
fn main() -> i32 {
    let mut out: i64 = 0i64;
    match mk() {
        [_, y] => { out = y; }
    }
    unsafe { printf("got=%ld\n".as_ptr(), out); }
    if out != 2i64 { return 1i32; }
    return 0i32;
}
