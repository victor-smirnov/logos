// Low-bit niche optimization: a 2-variant enum with one aligned-pointer arm
// (low bit always 0) + one <=63-bit integer arm packs into ONE word (no disc
// field), the discriminant living in the low bit -- Ptr = word (low-bit-0),
// Val = (v << 1) | 1. So sizeof::<E>() == 8 (the payload word alone), and both
// arms round-trip: the pointer arm derefs the aligned pointer, the value arm
// recovers (word >> 1) with sign extension.
package niche_low_bit;

enum E { Ptr(&i64), Val(i32) }

fn main() -> i32 {
    if (sizeof::<E>() as i64) != 8i64 { return 50i32; }   // niche-packed: no disc word
    let n: i64 = 99i64;
    let e1: E = E::Ptr(&n);
    match e1 { E::Ptr(p) => { if *p != 99i64 { return 1i32; } } E::Val(v) => { return 2i32; } }
    let e2: E = E::Val(12345i32);
    match e2 { E::Ptr(p) => { return 3i32; } E::Val(v) => { if v != 12345i32 { return 4i32; } } }
    let e3: E = E::Val(0i32 - 7i32);
    match e3 { E::Ptr(p) => { return 5i32; } E::Val(v) => { if v != (0i32 - 7i32) { return 6i32; } } }
    return 0i32;
}
