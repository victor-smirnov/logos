struct W { b: Box<i64> }
fn main() -> i32 {
    let w: W = W { b: Box::new(1i64) };
    let W { b: mut bb } = w;
    let r: &mut i64 = &mut *bb;
    *r = 4i64;
    if *bb != 4i64 { return 1i32; }
