package bc_bindmut_ergo_amp_at_nomod;
fn main() -> i32 {
    let o: Option<i64> = Option::Some(3i64);
    let mut out: i64 = 0i64;
    match &o {
        Option::Some(n @ 1i64..=5i64) => { out = *n; },
        Option::Some(_) => { out = -1i64; },
        Option::None => {}
    }
    if out != 3i64 { return 1i32; }
    return 0i32;
}
