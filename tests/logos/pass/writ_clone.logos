// Deep clone of writ documents (successor of legacy src.clone()):
// scalars, strings, arrays, maps, typed arrays — copied into a fresh container,
// structurally equal to the source, independent storage.
package writ_clone;
use logos.lang.writ.hstatic;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.mem.writ.clone;
use logos.mem.writ.equal;
use logos.lang.rc;

unsafe fn root_of(hs: &WritStatic) -> WAny {
    let base: *const u8 = hs.ptr;
    let w: i64 = *(base as *const i64);
    if w == 0i64 { return WAny::Ref(0i64 as *const u8); }
    if (w & 1i64) == 1i64 { return WAny::Pod(w as u64); }
    return WAny::Ref((base as i64 + w) as *const u8);
}

unsafe fn check_clone(src: WAny) -> bool {
    let c: Rc<Writ> = writ_clone(src);
    let h: &Writ = c.deref();
    let croot: WAny = h.root();
    if !writ_equal(src, croot) { return false; }
    // Independent storage: a Ref clone resolves to a DIFFERENT address.
    if src.is_ref() && !src.is_null() {
        if croot.resolve() == src.resolve() { return false; }
    }
    return true;
}

unsafe fn main() -> i32 {
    // 1. Scalar integer (Pod copies verbatim).
    let s1: WritStatic = @42;
    if !check_clone(root_of(&s1)) { return 1; }

    // 2. String.
    let s2: WritStatic = @"hello world";
    if !check_clone(root_of(&s2)) { return 2; }

    // 3. Array with mixed elements.
    let s3: WritStatic = @[1, "two", true, [3, 4]];
    if !check_clone(root_of(&s3)) { return 3; }

    // 4. Map with nested values.
    let s4: WritStatic = @{"a": 1, "b": [2, 3], "c": {"d": "deep"}};
    if !check_clone(root_of(&s4)) { return 4; }

    // 5. Typed array (raw element payload).
    let s5: WritStatic = @<I32>[10, 20, 30];
    if !check_clone(root_of(&s5)) { return 5; }

    // 6. Null root.
    let nul: WAny = WAny::Ref(0 as *const u8);
    let c6: Rc<Writ> = writ_clone(nul);
    let h6: &Writ = c6.deref();
    if !h6.root().is_null() { return 6; }

    return 0;
}
