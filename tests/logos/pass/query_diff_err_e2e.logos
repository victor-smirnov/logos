// query_diff_err_e2e — ERROR INPUTS ARE RETURNED ERRORS. The same overflowing /
// divide-by-zero query, run through a static `deem!` resource fn over the SAME
// data, must return `Result::Err(ElError)`; a valid query must return Ok with the
// exact row. This pins the whole-engine policy: a math error is a returned error
// on every Deem surface, never a host trap.
//
// P5: this file WAS the static≡dynamic differential (`Query::compile`+`run` beside
// each static arm). The dynamic executor is gone, so the CROSS-TIER claim is gone
// with it and is not pretended to here. What survives is the policy claim on the
// tier that remains, and it still bites: before the checked-arithmetic work each
// of the two error arms was a host TRAP, not an `Err`. Exit codes 2, 4 and 8 named
// the dynamic arms and are retired, not reused.
package test;

use logos.std.wql.wql;
use logos.lang.result;
use logos.mem.collections.vec;

struct SA { pub a0: i64, pub a1: i64 }

// overflow: a0 = 4e9, 4e9 * 4e9 = 1.6e19 > i64::MAX
pub deem s_ov(a: &[SA]) { from a x select x.a0 * 4000000000 : i64 }
// division by zero
pub deem s_dz(a: &[SA]) { from a x select x.a0 / x.a1 : i64 }
// valid
pub deem s_ok(a: &[SA]) { from a x select x.a0 + x.a1 : i64 }

fn static_errored_ov(sl: &[SA]) -> bool { match s_ov(sl) { Result::Ok(_v) => { return false; } Result::Err(_e) => { return true; } } }
fn static_errored_dz(sl: &[SA]) -> bool { match s_dz(sl) { Result::Ok(_v) => { return false; } Result::Err(_e) => { return true; } } }

fn main() -> i32 {
    let sl: [SA; 1] = [ SA { a0: 4000000000i64, a1: 0i64 } ];

    // ── OVERFLOW: must error, not trap ───────────────────────────────────────
    if !static_errored_ov(&sl[..]) { return 1i32; }

    // ── DIVISION BY ZERO: must error, not trap ───────────────────────────────
    if !static_errored_dz(&sl[..]) { return 3i32; }

    // ── VALID query: Ok, with the exact row ──────────────────────────────────
    let sok: Vec<i64> = match s_ok(&sl[..]) { Result::Ok(v) => { v } Result::Err(_e) => { return 5i32; } };
    if sok.len() != 1i64 { return 6i32; }
    if sok.get(0i64) != 4000000000i64 { return 7i32; }   // 4e9 + 0

    return 0i32;
}
