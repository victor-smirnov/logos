// Document clone (raw byte-copy) tests
package hermes_clone;
use hermes.ctr;
use std.string;

unsafe fn main() -> i32 {
    // ── 1. Scalar integer ─────────────────────────────────────────────────
    let mut src1: HermesCtr = HermesCtr::new(4096);
    match src1.parse("42") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 1; }
    }
    let dst1: HermesCtr = src1.clone();
    let mut buf1: String = String::with_capacity(64);
    dst1.stringify(&mut buf1);
    if !buf1.eq_cstr("42") { return 2; }

    // ── 2. String root ────────────────────────────────────────────────────
    let mut src2: HermesCtr = HermesCtr::new(4096);
    match src2.parse("\"world\"") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 3; }
    }
    let dst2: HermesCtr = src2.clone();
    let mut buf2: String = String::with_capacity(64);
    dst2.stringify(&mut buf2);
    if !buf2.eq_cstr("\"world\"") { return 4; }

    // ── 3. Array ──────────────────────────────────────────────────────────
    let mut src3: HermesCtr = HermesCtr::new(4096);
    match src3.parse("[1,2,3]") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 5; }
    }
    let dst3: HermesCtr = src3.clone();
    let mut buf3: String = String::with_capacity(64);
    dst3.stringify(&mut buf3);
    if !buf3.eq_cstr("[1,2,3]") { return 6; }

    // ── 4. Map ────────────────────────────────────────────────────────────
    let mut src4: HermesCtr = HermesCtr::new(4096);
    match src4.parse("{\"k\": true}") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 7; }
    }
    let dst4: HermesCtr = src4.clone();
    let mut buf4o: String = String::with_capacity(64);
    let mut buf4d: String = String::with_capacity(64);
    src4.stringify(&mut buf4o);
    dst4.stringify(&mut buf4d);
    if !buf4d.eq_cstr(buf4o.as_ptr()) { return 8; }

    // ── 5. Clone is independent: mutating src doesn't affect dst ──────────
    let mut src5: HermesCtr = HermesCtr::new(4096);
    match src5.parse("99") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 9; }
    }
    let dst5: HermesCtr = src5.clone();
    // Build a new value in src5 (exercises the zone)
    let _v: AnyVal = src5.build_str("mutation");
    let mut buf5: String = String::with_capacity(64);
    dst5.stringify(&mut buf5);
    if !buf5.eq_cstr("99") { return 10; }

    // ── 6. Nested document ────────────────────────────────────────────────
    let mut src6: HermesCtr = HermesCtr::new(4096);
    match src6.parse("{\"a\": [1, 2], \"b\": {\"c\": true}}") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 11; }
    }
    let dst6: HermesCtr = src6.clone();
    let mut buf6o: String = String::with_capacity(128);
    let mut buf6d: String = String::with_capacity(128);
    src6.stringify(&mut buf6o);
    dst6.stringify(&mut buf6d);
    if !buf6d.eq_cstr(buf6o.as_ptr()) { return 12; }

    return 0;
}
