package tagged_multi_payload;
// F22: tagged enum with multiple payload fields (struct-like)
// Note: current grammar supports one payload per variant.
// Test different variants with single payloads.
enum Expr {
    Num(i32),
    Neg(i32),
    Dbl(i32),
}
fn eval(e: Expr) -> i32 {
    match e {
        Expr::Num(v) => { return v; }
        Expr::Neg(v) => { return 0 - v; }
        Expr::Dbl(v) => { return v * 2; }
    }
}
fn main() -> i32 {
    let a: i32 = eval(Expr::Num(10));   // 10
    let b: i32 = eval(Expr::Neg(-5));   // 5
    let c: i32 = eval(Expr::Dbl(13));   // 26
    let d: i32 = eval(Expr::Num(1));    // 1
    return a + b + c + d;    // 10+5+26+1 = 42
}
