// Hermes2 Phase 2a — type-safe placement surface. No `unsafe` and no raw pointer
// in user code: `put` places a value into the never-move arena and returns an
// OPAQUE `Slot<T>`; `get`/`get_mut` borrow it back as `&'a T` / `&'a mut T` tied
// to the container's lifetime; the container is RAII (auto-freed on drop).
// (Borrow-exclusivity between views and mutation is a separate borrow-checker
// strengthening — see the deferred BC work; this exercises the safe surface.)
package test;
use logos.lang.hermes.container;

fn main() -> i32 {
    let mut d: Hermes2 = hermes2_new(64i64);
    let a: Slot<i64> = d.put(40i64);
    let b: Slot<i64> = d.put(2i64);
    {
        let m: &mut i64 = d.get_mut(a);
        *m = *m + 2i64;             // 40 -> 42 in place
    }
    let va: &i64 = d.get(a);
    let vb: &i64 = d.get(b);
    if *va != 42i64 { return 1; }
    if *vb != 2i64  { return 2; }
    return 0;                        // container auto-freed (Drop)
}
