// Closed squeue inherent_impl_same_method_one_funcinfo_ice (#703): the borrow checker now finds a call's callee among the generic structs' METHOD TEMPLATES by impl-target pattern when mono left the instance to codegen, so the ICE is gone and the program runs (exit 0, as rustc). NOT fixed and not observable here: both generic templates are still emitted under one name (W__tag__g__ref_W$G1$ref_T).
package inherent_impl_same_method_one_funcinfo_ice;
use logos.mem.boxed;
struct W<T> { t: T }
impl<T> W<&T> { fn tag(&self) -> i32 { return 1i32; } }
impl<T> W<Box<T>> { fn tag(&self) -> i32 { return 2i32; } }
impl W<i64> { fn tag(&self) -> i32 { return 3i32; } }
fn main() -> i32 {
    let x = 5i64;
    let wr = W { t: &x };
    if wr.tag() != 1i32 { return 1i32; }
    let wb = W { t: Box::new(5i64) };
    if wb.tag() != 2i32 { return 2i32; }
    let wi = W { t: 5i64 };
    if wi.tag() != 3i32 { return 3i32; }
    return 0i32;
}
