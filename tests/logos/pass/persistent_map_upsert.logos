// Tests std.data.persistent.map upsert/get/remove against UID256/UID256.
package test;

use std.data.persistent.uid256;
use std.data.persistent.map;
use std.lang.cmp;
use std.lang.datatypes;

fn main() -> i32 {
    let a: UID256 = uid256_random();
    let b: UID256 = uid256_random();
    let c: UID256 = uid256_random();

    let v1: UID256 = uid256_random();
    let v2: UID256 = uid256_random();

    let mut m: PMap<UID256, UID256> = map_new::<UID256, UID256>();

    // Initial inserts (upsert path, miss branch).
    if map_insert::<UID256, UID256>(&mut m, &a as *const UID256, &v1 as *const UID256, &a as *const UID256) { return 1; }
    if map_insert::<UID256, UID256>(&mut m, &b as *const UID256, &v1 as *const UID256, &b as *const UID256) { return 2; }
    if map_len::<UID256, UID256>(&m) != 2u64 { return 3; }

    // Upsert hit: overwrite a's value with v2.
    if !map_insert::<UID256, UID256>(&mut m, &a as *const UID256, &v2 as *const UID256, &a as *const UID256) { return 4; }
    if map_len::<UID256, UID256>(&m) != 2u64 { return 5; }

    // map_get reads back v2 for a, v1 for b.
    let mut out: *const UID256 = 0 as *const UID256;
    if !map_get::<UID256, UID256>(&m, &a as *const UID256, &mut out as *mut *const UID256) { return 6; }
    unsafe {
        if !(&*out).eq(&v2) { return 7; }
    }
    if !map_get::<UID256, UID256>(&m, &b as *const UID256, &mut out as *mut *const UID256) { return 8; }
    unsafe {
        if !(&*out).eq(&v1) { return 9; }
    }

    // Miss returns false, out untouched (we just don't read it).
    if map_get::<UID256, UID256>(&m, &c as *const UID256, &mut out as *mut *const UID256) { return 10; }

    // Remove a; len drops to 1; subsequent get misses.
    if !map_remove::<UID256, UID256>(&mut m, &a as *const UID256) { return 11; }
    if map_len::<UID256, UID256>(&m) != 1u64 { return 12; }
    if map_contains::<UID256, UID256>(&m, &a as *const UID256) { return 13; }
    if !map_contains::<UID256, UID256>(&m, &b as *const UID256) { return 14; }

    // Remove miss is false.
    if map_remove::<UID256, UID256>(&mut m, &a as *const UID256) { return 15; }

    // Remove b; len drops to 0.
    if !map_remove::<UID256, UID256>(&mut m, &b as *const UID256) { return 16; }
    if map_len::<UID256, UID256>(&m) != 0u64 { return 17; }

    map_drop::<UID256, UID256>(&mut m);

    return 42;
}
