// Runtime document building (writ successor of the legacy builder test):
// fresh container, root map, string + int values, stringify check.
package writ_builder;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;
use logos.lang.writ.wstring;
use logos.mem.writ.stringify;
use logos.lang.rc;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(4096);
    let h: &Writ = rc.deref();

    // Root map with 8 slots; fill via typed set overloads + explicit WAny.
    let m: &mut WMap<WString, WAny> = h.map(8);
    m.set("greet", WAny::from(&*(h.wstring("hello") as *const WString)));
    m.set("n", 42i64);
    let mp: *const WMap<WString, WAny> = m as *const WMap<WString, WAny>;
    h.set_root(WAny::ref_to(mp as *const u8));

    let root: WAny = h.root();
    if root.is_null() { return 1; }
    if !root.is_map() { return 2; }

    let g: WAny = (&*mp).get("greet");
    if !g.is_string() { return 3; }
    let n: WAny = (&*mp).get("n");
    if n.as_i64() != 42i64 { return 4; }

    let text: String = stringify(root);
    if text.len() != 27i64 { return 5; }   // {"greet": "hello", "n": 42} (key order hash-dependent)
    return 0;
}
