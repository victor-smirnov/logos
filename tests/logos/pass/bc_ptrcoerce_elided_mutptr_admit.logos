package bc_ptrcoerce_elided_mutptr_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
fn show(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
static G: i64 = 7i64;
fn raw(q: *mut &i64) -> i64 {
    return unsafe { **q };
}
fn main() -> i32 {
    let mut r: &'static i64 = &G;
    let q: *mut &i64 = &mut r;
    let mut a: [&'static i64; 2] = [&G, &G];
    // 2026-09-16d: the ARRAY line needs the explicit cast now (rustc E0308); the `&mut r`
    // line above is a plain `&mut T` -> `*mut T` and is untouched by that removal.
    let d: *mut &i64 = (&mut a) as *mut [&'static i64; 2] as *mut &i64;
    let n: i64 = unsafe { **q } + unsafe { **d } + raw(&mut r);
    show("n=%lld", n);
    return n as i32;
}
