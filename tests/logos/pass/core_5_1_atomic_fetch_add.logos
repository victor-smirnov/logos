// logos-core §5.1 — atomic fetch_add returns PREVIOUS value (Rust
// semantics) and updates the atomic to prev+delta. The MLIR intrinsic
// path (`llvm.atomicrmw add`) shouldn't return the post-update value.
package core_5_1_atomic_fetch_add;
use logos.lang.atomic;
fn main() -> i32 {
    let mut a: AtomicI32 = atomic_i32_new(10i32);
    let p: *mut AtomicI32 = &mut a as *mut AtomicI32;
    let prev: i32 = unsafe { p.fetch_add(5i32) };
    if prev != 10i32 { return 1i32; }
    if a.load() != 15i32 { return 2i32; }
    return 0i32;
}
