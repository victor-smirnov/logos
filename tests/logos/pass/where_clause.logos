package where_clause;
// where T: Trait — alternative syntax for trait bounds
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }

trait Show { fn show(&self) -> i32; }
trait Double { fn double(&self) -> i32; }

struct Num { val: i32, }
impl Show   for Num { fn show(&self) -> i32   { return self.val; } }
impl Double for Num { fn double(&self) -> i32 { return self.val * 2; } }

// where with single bound
fn print_show<T>(x: T) -> i32 where T: Show {
    return x.show();
}

// where with multiple bounds
fn show_and_double<T>(x: T) -> i32 where T: Show + Double {
    return x.show() + x.double();
}

unsafe fn main() -> i32 {
    // Each generic call moves its by-value arg (Num is a non-Copy struct);
    // construct a fresh Num at each call site.
    printi("%d\n", print_show(Num { val: 7 }));      // 7
    printi("%d\n", show_and_double(Num { val: 7 })); // 21
    return 0;
}
