// SDN text parsing on writ2 (successor of Writ::parse): scalars, strings,
// arrays, maps (quoted + bare keys), nesting; parse -> read/verify.
package writ_parse;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.hmap;
use logos.lang.writ.hstring;
use logos.mem.writ.parser;
use logos.lang.rc;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(16384);
    let h: &Writ = rc.deref();

    // Scalars.
    if parse(h, "42").as_i64() != 42i64 { return 1; }
    if parse(h, "-7").as_i64() != -7i64 { return 2; }
    if !parse(h, "true").as_bool() { return 3; }
    if !parse(h, "null").is_null() { return 4; }

    // Wide int boxes transparently.
    if parse(h, "9000000000").as_i64() != 9000000000i64 { return 5; }

    // String.
    let s: WAny = parse(h, "\"hello\"");
    if !s.is_string() { return 6; }
    let hs: &WString = &*(s.resolve() as *const WString);
    if !str_eq(hs.as_str(), "hello") { return 7; }

    // Array.
    let a: WAny = parse(h, "[10, 20, 30]");
    if !a.is_array() { return 8; }
    let arr: &WArray<WAny> = &*(a.resolve() as *const WArray<WAny>);
    if arr.len() != 3i64 { return 9; }
    if arr.get(1).as_i64() != 20i64 { return 10; }

    // Map with quoted AND bare keys + nesting.
    let m: WAny = parse(h, "{\"a\": 1, b: [true, null], c: {x: 55}}");
    if !m.is_map() { return 11; }
    let mm: &WMap<WString, WAny> = &*(m.resolve() as *const WMap<WString, WAny>);
    if mm.get("a").as_i64() != 1i64 { return 12; }
    let bv: WAny = mm.get("b");
    if !bv.is_array() { return 13; }
    let cv: WAny = mm.get("c");
    if !cv.is_map() { return 14; }
    let cm: &WMap<WString, WAny> = &*(cv.resolve() as *const WMap<WString, WAny>);
    if cm.get("x").as_i64() != 55i64 { return 15; }

    return 42;
}
