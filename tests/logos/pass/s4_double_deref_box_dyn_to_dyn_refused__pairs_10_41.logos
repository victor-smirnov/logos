// ADR 0030 S4 acceptance: feature-interaction audit cluster `double-deref-box-dyn-to-dyn-refused`, member pairs-10_41
// (tests/interactions/clusters/double-deref-box-dyn-to-dyn-refused/pairs-10_41.logos); rustc 1.98.1 twin gives the same stdout and exit code.
package m23d;
use logos.std.fmt;
trait Tr { fn v(&self) -> i64; }
struct L { a: i64 }
impl Tr for L { fn v(&self) -> i64 { self.a } }
fn walk(t: &dyn Tr) -> i64 { t.v() }
fn main() { let t: Box<dyn Tr> = Box::new(L { a: 4 }); println!("{}", walk(&*t)); }
