// `if let Some(mut s) = o { s.v = s.v + 5 }`: the drop sees the MUTATED value (the binding is the owner, not a copy) PROBES.md 2026-09-06d: `if let` / `while let` / let-chains lower BY DELEGATION to lower_match (temp hoist, per-arm scrutinee move, arm drops, cond-move merge); the count is a destructor tally through a raw pointer.
package bc_patown_iflet_mut_fieldwrite;

struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let o: Option<S> = Option::Some(S { v: 1i64, i: p });
        if let Option::Some(mut s) = o { s.v = s.v + 5i64; }
    }
    return c as i32;
}
