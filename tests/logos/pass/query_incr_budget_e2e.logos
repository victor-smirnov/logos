// query_incr_budget_e2e — S2 BUDGETED FIXPOINT (ADR 0015 §3, anytime semantics).
// IncrRec::set_budget_steps/ns cuts the inner fixpoint BETWEEN rounds (before
// the promote), leaving the un-promoted frontier as engine state; tail() is
// the residual descriptor; an empty-ΔEDB epoch RESUMES from the watermark.
// Oracles (all differential vs an UNBUDGETED twin engine on the same edges):
//   (a) SOUNDNESS — a truncated snapshot is a SUBSET of the full closure
//       (positive rel: everything derived is true, some things are missing);
//   (b) RESUME EQUIVALENCE — budgeted-then-resumed == never-budgeted (set
//       equality), i.e. truncation loses nothing, it only defers;
//   (c) descriptor structure — converged/pending/bound_dir/cut_reason honest
//       through cut → resume → convergence (and ns-budget 0 cuts immediately
//       with cut_reason = ns, deterministically);
//   (d) RETRACTION RESTORES CONVERGENCE — DRed on a truncated state yields the
//       exact closure of the surviving edge set (the ADR §3 caveat, discharged);
//   (e) SEMILATTICE BOUND — a truncated MIN-aggregate (SSSP) snapshot is a
//       certified one-sided bound: every champion ≥ the true least distance
//       (bound_dir = upper), and resume converges to the exact distances;
//   (f) the S1 consistency oracle (Σ delta_card == final cardinality) HOLDS
//       THROUGH CUTS — a cut is an assessment, not an admission.
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema Edge : code(0x0E07_0000_0000_000C) {
    src: i64 = 0,
    dst: i64 = 1,
    w:   i64 = 2,
}
resource cat = schema_catalog!{ Edge };

fn mk_edge(d: &Writ, s: i64, t: i64, w: i64) -> WAny {
    let e: Edge = d.make::<Edge>();
    e.src = s; e.dst = t; e.w = w;
    return WAny::ref_to((e.m as i64) as *const u8);
}

fn build_src(d: &Writ, hs: &Vec<WAny>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(256i64);
    let n: i64 = hs.len();
    let mut i: i64 = 0i64;
    while i < n { arr.push(hs.get(i)); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

// Is 2-col row (a,b) present in `q`? (n² probe — test sizes are tiny)
fn has_row(q: &QRows, a: i64, b: i64) -> bool {
    let n: i64 = q.row_count();
    let mut i: i64 = 0i64;
    while i < n {
        if q.get_i64(i, 0i64) == a && q.get_i64(i, 1i64) == b { return true; }
        i = i + 1i64;
    }
    return false;
}

// A ⊆ B as 2-col i64 row sets.
fn subset(a: &QRows, b: &QRows) -> bool {
    let n: i64 = a.row_count();
    let mut i: i64 = 0i64;
    while i < n {
        if !has_row(b, a.get_i64(i, 0i64), a.get_i64(i, 1i64)) { return false; }
        i = i + 1i64;
    }
    return true;
}

fn set_eq(a: &QRows, b: &QRows) -> bool {
    if a.row_count() != b.row_count() { return false; }
    return subset(a, b) && subset(b, a);
}

// QRows is borrow-carrying — never hold one across an engine mutation. These
// helpers scope the snapshots to the check itself (the sssp_fuzz idiom).
fn snap_count(e: &IncrRec) -> i64 {
    let s: QRows = e.snapshot();
    return s.row_count();
}

fn snap_subset(a: &IncrRec, b: &IncrRec) -> bool {
    let sa: QRows = a.snapshot();
    let sb: QRows = b.snapshot();
    return subset(&sa, &sb);
}

fn snap_eq(a: &IncrRec, b: &IncrRec) -> bool {
    let sa: QRows = a.snapshot();
    let sb: QRows = b.snapshot();
    return set_eq(&sa, &sb);
}

fn trace_delta_sum(eng: &IncrRec) -> i64 {
    let mut s: i64 = 0i64;
    let n: i64 = eng.trace_len();
    let mut i: i64 = 0i64;
    while i < n { s = s + eng.trace_at(i).delta_card; i = i + 1i64; }
    return s;
}

// The true least distance for the Part-E graph (chain 0→1→2→3 w1 + 0→3 w10).
fn true_dist(n: i64) -> i64 {
    if n == 1i64 { return 1i64; }
    if n == 2i64 { return 2i64; }
    if n == 3i64 { return 3i64; }
    return 0i64 - 1i64;
}

// Truncated-min bound check (scoped snapshot): 0 ok, else the fail code.
fn min_bound_code(eng: &IncrRec) -> i32 {
    let s: QRows = eng.snapshot();
    if s.row_count() < 1i64 { return 35i32; }
    let mut i: i64 = 0i64;
    while i < s.row_count() {
        let td: i64 = true_dist(s.get_i64(i, 0i64));
        if td < 0i64 { return 36i32; }              // champion for a non-node
        if s.get_i64(i, 1i64) < td { return 37i32; } // undershoots true min — lies
        i = i + 1i64;
    }
    return 0i32;
}

// Converged-min exactness check (scoped snapshot): 0 ok, else the fail code.
fn min_final_code(eng: &IncrRec) -> i32 {
    let s: QRows = eng.snapshot();
    if s.row_count() != 3i64 { return 39i32; }
    let mut i: i64 = 0i64;
    while i < 3i64 {
        if s.get_i64(i, 1i64) != true_dist(s.get_i64(i, 0i64)) { return 40i32; }
        i = i + 1i64;
    }
    return 0i32;
}

fn main() -> i32 {
    let doc: Writ = writ_new(262144i64);
    let c: SchemaCatalog = cat();
    let qtc: Query = match Query::compile(
        r#"rel path(a: i64, b: i64) {
             from edges e select (e.src, e.dst);
             from path p join edges e on p.b == e.src select (p.a, e.dst);
           }
           from path p select (p.a, p.b)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };

    // ── chain 0→1→…→10 (10 edges, closure = 55 rows) ──
    let mut all: Vec<WAny> = vec_new::<WAny>();
    let mut k: i64 = 0i64;
    while k < 10i64 { all.push(mk_edge(&doc, k, k + 1i64, 1i64)); k = k + 1i64; }

    // FULL twin (never budgeted): all edges at build.
    let mut envf: QEnv = QEnv::new();
    envf.bind_source("edges", build_src(&doc, &all));
    let engf: IncrRec = match qtc.incremental_rec(&envf)
    { Result::Ok(e) => { e } Result::Err(_e2) => { return 1i32; } };
    if snap_count(&engf) != 55i64 { return 2i32; }

    // BUDGETED engine: 1 edge at build, the other 9 in one budgeted epoch.
    let mut seed1: Vec<WAny> = vec_new::<WAny>();
    seed1.push(all.get(0i64));
    let mut enva: QEnv = QEnv::new();
    enva.bind_source("edges", build_src(&doc, &seed1));
    let mut enga: IncrRec = match qtc.incremental_rec(&enva)
    { Result::Ok(e) => { e } Result::Err(_e3) => { return 3i32; } };
    if !enga.is_converged() { return 4i32; }
    let t0: TruncatedTail = enga.tail();
    if !t0.converged || t0.pending_delta_card != 0i64
    || t0.bound_dir != 0i32 || t0.cut_reason != 0i32 { return 5i32; }

    enga.set_budget_steps(1i64);
    let mut d1: ZBatch = ZBatch::new();
    let mut k2: i64 = 1i64;
    while k2 < 10i64 { d1.push(all.get(k2), 1i64); k2 = k2 + 1i64; }
    enga.epoch(&d1);

    // (c) cut happened, descriptor honest.
    if enga.is_converged() { return 6i32; }
    let t1: TruncatedTail = enga.tail();
    if t1.converged { return 7i32; }
    if t1.pending_delta_card <= 0i64 { return 8i32; }
    if t1.bound_dir != 1i32 { return 9i32; }    // positive rel ⇒ lower (subset)
    if t1.cut_reason != 1i32 { return 10i32; }  // steps

    // (a) SOUNDNESS: truncated ⊆ full, and strictly missing something.
    if !snap_subset(&enga, &engf) { return 11i32; }
    if snap_count(&enga) >= 55i64 { return 12i32; }

    // (b) RESUME under the same budget: empty-ΔEDB epochs, ≤ 32 to converge.
    let mut tries: i64 = 0i64;
    while !enga.is_converged() && tries < 32i64 {
        let dre: ZBatch = ZBatch::new();
        enga.epoch(&dre);
        tries = tries + 1i64;
    }
    if !enga.is_converged() { return 13i32; }
    let t2: TruncatedTail = enga.tail();
    if !t2.converged || t2.pending_delta_card != 0i64 || t2.bound_dir != 0i32 { return 14i32; }
    if !snap_eq(&enga, &engf) { return 15i32; }

    // (f) S1 consistency oracle THROUGH cuts: Σδ == final cardinality.
    if trace_delta_sum(&enga) != 55i64 { return 16i32; }

    // (c) ns budget = 0 ⇒ deterministic immediate cut, cut_reason = ns.
    enga.set_budget_ns(0i64);
    let e1011: WAny = mk_edge(&doc, 10i64, 11i64, 1i64);
    let mut d2: ZBatch = ZBatch::new();
    d2.push(e1011, 1i64);
    enga.epoch(&d2);
    if enga.is_converged() { return 17i32; }
    if enga.tail().cut_reason != 2i32 { return 18i32; }

    // (d) RETRACTION on the truncated state: DRed re-converges exactly.
    let mut d3: ZBatch = ZBatch::new();
    d3.push(all.get(5i64), 0i64 - 1i64);   // retract edge 5→6
    enga.epoch(&d3);
    if !enga.is_converged() { return 19i32; }
    // oracle: fresh full engine over the surviving edge set {0..11} ∖ {5→6}.
    let mut surv: Vec<WAny> = vec_new::<WAny>();
    let mut k3: i64 = 0i64;
    while k3 < 10i64 {
        if k3 != 5i64 { surv.push(all.get(k3)); }
        k3 = k3 + 1i64;
    }
    surv.push(e1011);
    let mut envs: QEnv = QEnv::new();
    envs.bind_source("edges", build_src(&doc, &surv));
    let engs: IncrRec = match qtc.incremental_rec(&envs)
    { Result::Ok(e) => { e } Result::Err(_e4) => { return 20i32; } };
    if !snap_eq(&enga, &engs) { return 21i32; }

    // clear_budget ⇒ a later insert epoch runs to convergence in one call.
    enga.clear_budget();
    let mut d4: ZBatch = ZBatch::new();
    d4.push(all.get(5i64), 1i64);          // re-insert edge 5→6
    enga.epoch(&d4);
    if !enga.is_converged() { return 22i32; }

    // ── (e) SEMILATTICE BOUND: SSSP min over chain 0→1→2→3 (w 1) + 0→3 (w 10) ──
    let qmin: Query = match Query::compile(
        r#"rel dist(node: i64, d: i64) {
             from edges e where e.src == 0 select (e.dst, e.w);
             from dist x join edges e on e.src == x.node
                 group by e.dst aggregate d = min(x.d + e.w) select (e.dst, d);
           }
           from dist r select (r.node, r.d)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e5) => { return 30i32; } };
    let e03: WAny = mk_edge(&doc, 0i64, 3i64, 10i64);
    let mut seedm: Vec<WAny> = vec_new::<WAny>();
    seedm.push(e03);
    let mut envm: QEnv = QEnv::new();
    envm.bind_source("edges", build_src(&doc, &seedm));
    let mut engm: IncrRec = match qmin.incremental_rec(&envm)
    { Result::Ok(e) => { e } Result::Err(_e6) => { return 31i32; } };
    engm.set_budget_steps(0i64);           // cut right after the seed
    let mut dm: ZBatch = ZBatch::new();
    dm.push(mk_edge(&doc, 0i64, 1i64, 1i64), 1i64);
    dm.push(mk_edge(&doc, 1i64, 2i64, 1i64), 1i64);
    dm.push(mk_edge(&doc, 2i64, 3i64, 1i64), 1i64);
    engm.epoch(&dm);
    if engm.is_converged() { return 32i32; }
    let tm: TruncatedTail = engm.tail();
    if tm.bound_dir != 2i32 { return 33i32; }   // min ⇒ champions are UPPER bounds
    if tm.cut_reason != 1i32 { return 34i32; }
    // every truncated champion is ≥ the true least distance for its node.
    let bc: i32 = min_bound_code(&engm);
    if bc != 0i32 { return bc; }
    // resume to convergence ⇒ exact least distances.
    engm.clear_budget();
    let dm2: ZBatch = ZBatch::new();
    engm.epoch(&dm2);
    if !engm.is_converged() { return 38i32; }
    let mc: i32 = min_final_code(&engm);
    if mc != 0i32 { return mc; }
    if engm.had_error() { return 41i32; }
    if enga.had_error() { return 42i32; }

    return 0i32;
}
