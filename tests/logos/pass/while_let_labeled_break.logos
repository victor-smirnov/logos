package while_let_labeled_break;
// G152-16: labeled break/continue on a `while let` loop. The desugar to
// `loop { match … }` dropped the loop label (only loop/for/while captured
// pending_loop_label_), so `break 'a` / `continue 'a` errored "label not in
// scope". Fixed: while-let threads the label onto the desugared SLoop + frame.
use logos.lang.option;
fn step(n: i64) -> Option<i64> { if n < 5 { return Option::Some(n + 1); } return Option::None; }
fn main() -> i64 {
    let mut n: i64 = 0;
    'a: while let Option::Some(x) = step(n) {
        n = x;
        if x == 1 { continue 'a; }
        if x >= 3 { break 'a; }
    }
    if n != 3 { return 1; }
    return 0;
}
