// Hermes2 — minimal heterogeneous document, object-oriented + fully safe: a root
// ZArray holding inline ints AND a NESTED ZArray (ZonedAny::from(child)), deep-
// traversed (ZArray::from(ref) descends). One never-move container, RAII.
package test;
use logos.lang.hermes2.container;
use logos.lang.hermes2.anyval;
use logos.lang.hermes2.array;

fn deep_sum(a: ZArray) -> i64 {
    let mut s: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < a.len() {
        let e: ZonedAny = a.get(i);
        if e.is_i56() { s = s + e.as_i56(); }
        else { if e.is_ref() { s = s + deep_sum(ZArray::from(e)); } }
        i = i + 1i64;
    }
    return s;
}

fn main() -> i32 {
    let mut h: Hermes2 = hermes2_new(48i64);
    let mut nested: ZArray = h.array(2i64);
    nested.push(ZonedAny::from(1i64));
    nested.push(ZonedAny::from(2i64));
    nested.push(ZonedAny::from(3i64));
    let mut root: ZArray = h.array(2i64);
    root.push(ZonedAny::from(10i64));
    root.push(ZonedAny::from(20i64));
    root.push(ZonedAny::from(nested));      // nest the child array
    root.push(ZonedAny::from(40i64));
    let total: i64 = deep_sum(root);        // 10+20+(1+2+3)+40 = 76
    if total != 76i64 { return total as i32; }
    return 0;
}
