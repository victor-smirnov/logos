// Document root + tree walker (P4). A Hermes2 container holds a ROOT HAny
// (set_root/root); node_count/depth recurse the heterogeneous tree from it,
// type_code-dispatching like equal/stringify. Builds {"a":[1,2,3],"b":42},
// sets it as the root, and walks: 6 nodes, depth 3. (Null root = empty doc.)
package test;
use logos.lang.hermes2.container;
use logos.lang.hermes2.anyval;
use logos.lang.hermes2.array;
use logos.lang.hermes2.hmap;
use logos.lang.hermes2.hstring;
use logos.lang.hermes2.document;
fn main() -> i32 {
    let h: Hermes2 = hermes2_new(512i64);
    let arr: &mut HArray<HVal> = h.array(4i64);
    arr.push(1i64); arr.push(2i64); arr.push(3i64);
    let m: &mut HMap<HString, HVal> = h.map(4i64);
    m.set("a", HAny::from(&*arr));      // nested array
    m.set("b", 42i64);
    h.set_root(HAny::from(&*m));        // document root
    let r: HAny = h.root();
    if !r.is_map() { return 1i32; }
    // node_count: map(1) + array(1) + three ints + int 42 = 6
    if node_count(r) != 6i64 { return 10i32 + (node_count(r) as i32); }
    // depth: map -> array -> int = 3
    if depth(r) != 3i64 { return 20i32 + (depth(r) as i32); }
    // null root on a fresh container
    let e: Hermes2 = hermes2_new(64i64);
    if !e.root().is_null() { return 2i32; }
    if node_count(e.root()) != 0i64 { return 3i32; }
    return 0i32;
}
