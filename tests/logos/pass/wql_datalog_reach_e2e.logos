// WQL RECURSIVE RELS (slice C — static Datalog): the canonical TRANSITIVE
// CLOSURE. A `rel` body may reference the rel ITSELF — the walker condenses
// the dependency graph (SCC) and emits ONE semi-naïve fixpoint fn for the
// recursive component: seed bodies (no in-SCC source) run once, then each
// recursive body re-runs per round with its in-SCC occurrence bound to the
// DELTA slice (new tuples only) until every delta is empty (least fixpoint;
// set semantics via the shadow HashSet).
//
//   rel path — base: the edges themselves; step: path ⋈ edges (delta on the
//   base side ⇒ the hash build lands on `edges` each round);
//   entry    — filter by a scalar $param + order by (over the materialized rel).
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

struct Edge { pub src: i64, pub dst: i64 }

resource reach = wql!(edges: &[Edge], start: i64) {
    rel path(a: i64, b: i64) {
        from edges e select (e.src, e.dst);
        from path p join edges e on p.b == e.src select (p.a, e.dst);
    }
    from path p where p.a == start select p.b order by p.b
};

fn main() -> i32 {
    let edges: [Edge; 5] = [
        Edge { src: 1i64, dst: 2i64 },
        Edge { src: 2i64, dst: 3i64 },
        Edge { src: 2i64, dst: 4i64 },
        Edge { src: 5i64, dst: 6i64 },
        Edge { src: 2i64, dst: 3i64 },   // duplicate edge — set semantics dedup
    ];

    // 1 ⇒ {2, 3, 4} (1→2, 1→2→3, 1→2→4), ordered.
    let out1: Vec<i64> = reach(&edges[..], 1i64);
    if out1.len() != 3i64      { return 1i32; }
    if out1.get(0i64) != 2i64  { return 2i32; }
    if out1.get(1i64) != 3i64  { return 3i32; }
    if out1.get(2i64) != 4i64  { return 4i32; }

    // 5 ⇒ {6} (single hop, disconnected component).
    let out5: Vec<i64> = reach(&edges[..], 5i64);
    if out5.len() != 1i64      { return 5i32; }
    if out5.get(0i64) != 6i64  { return 6i32; }

    // 3 ⇒ ∅ (sink node).
    let out3: Vec<i64> = reach(&edges[..], 3i64);
    if out3.len() != 0i64      { return 7i32; }

    return 0i32;
}
