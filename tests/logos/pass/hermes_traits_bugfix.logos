package hermes_traits_bugfix;
// Regression for bug hunt performed on Phase-3 implementation of
// HermesEqual / HermesHash / HermesClone.
//
// Each test block targets a specific fix documented in the commit log.

use logos.lang.hermes.zone;
use logos.lang.hermes.anyval;
use logos.lang.hermes.view;
use logos.mem.hermes.string;
use logos.mem.string;
use logos.lang.str;
use logos.lang.hermes.typetag;
use logos.mem.hermes.tag_system;
use logos.mem.hermes.array;
use logos.mem.hermes.map;
use logos.mem.hermes.typed_value;
use logos.mem.hermes.objectmap;
use logos.lang.hermes.document;
use logos.mem.hermes.ctr;
use logos.mem.hermes.stringify;
use logos.mem.hermes.equal;
use logos.mem.hermes.hashing;
use logos.mem.hermes.clone;

unsafe fn build(text: str) -> Hermes {
    let mut doc: Hermes = Hermes::new(8192);
    match doc.parse(text) {
        Result::Ok(())  => {}
        Result::Err(_)  => {}
    }
    return doc;
}

unsafe fn main() -> i32 {
    // ── Bug: ObjectMap::equal false-positive on null values with disjoint keys.
    let mut da: Hermes = build("{x:null}");
    let mut db: Hermes = build("{y:null}");
    let mut ec: EqualCtx = EqualCtx { base_self: da.base(), base_other: db.base() };
    if anyval_equal(da.root(), db.root(), &mut ec) { return 10; }

    // ── Bug: HermesHash type_code mixed as u8 → collisions for codes >255.
    let mut dc: Hermes = build("{a:1}");
    let mut dd: Hermes = build("{a:1_s8}");
    let mut hc: HashCtx = HashCtx { base: dc.base() };
    let mut hd: HashCtx = HashCtx { base: dd.base() };
    if anyval_hash(dc.root(), &mut hc) == anyval_hash(dd.root(), &mut hd) { return 11; }

    // ── Positive clone round-trip: d1 == clone(d1) structurally and stringified.
    let mut src: Hermes = build("{a:1,b:\"ok\",c:[true,false]}");
    let mut dst: Hermes = Hermes::builder(8192);
    let mut cc: CloneCtx = CloneCtx {
        base_src: src.base(),
        zone_dst: dst.zone_mut(),
        map: 0 as *mut CloneMap,
    };
    let new_root: AnyVal = anyval_clone(src.root(), &mut cc);
    if new_root.is_null() { return 12; }
    dst.set_root(new_root);

    let s_src: String = src.to_string();
    let s_dst: String = dst.to_string();
    if !s_src.eq_string(&s_dst) { return 13; }

    // Cross-zone equal and hash after clone.
    let mut ec2: EqualCtx = EqualCtx { base_self: src.base(), base_other: dst.base() };
    if !anyval_equal(src.root(), new_root, &mut ec2) { return 14; }

    let mut hc_s: HashCtx = HashCtx { base: src.base() };
    let mut hc_d: HashCtx = HashCtx { base: dst.base() };
    if anyval_hash(src.root(), &mut hc_s) != anyval_hash(new_root, &mut hc_d) { return 15; }

    return 0;
}
