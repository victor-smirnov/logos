package bc_0914d_meetoblland_hb_l104_admit;
struct P<'a> { x: &'a i64, y: &'a i64 }
trait Sum { fn sum(self: &Self) -> i64; }
impl<'a> Sum for P<'a> { fn sum(self: &Self) -> i64 { return *self.x + *self.y; } }
fn total<T: Sum>(t: &T, u: &T) -> i64 { return t.sum() + u.sum(); }
fn go<'a, 'b>(x: &'a i64, y: &'b i64) -> i64 {
    let p = P { x: x, y: y };
    let q = P { x: y, y: x };
    return total(&p, &q);
}
fn main() -> i32 {
    let a: i64 = 1i64;
    let b: i64 = 2i64;
    return go(&a, &b) as i32;
}
