// SPDX-License-Identifier: Apache-2.0
// block_type_hash invariant — every NodeBase carries a structural hash
// of its concrete schema at offset 16. Leaf and Branch differ; the
// hash is stable across allocations of the same schema; cfg_hash at
// offset 8 stays as the per-CFG identity used by open_pmap validation.

package persistent_block_type_hash_probe;

use std.data.persistent.handle;
use std.data.persistent.bt.node;
use std.data.persistent.bt.cow;
use std.compiler.metaprog;
use std.lang.cmp; use std.lang.ord; use std.lang.datatypes;
use std.hermes.view; use std.hermes.anyval;

pub const StoreCfg: HermesStatic = @{ "name": "blkhash", "ctr_id": <type:u64>, "snp_id": <type:u64> };
pub const MapCfg:   HermesStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 4 };

unsafe fn read_block_type_hash(node: *mut u8) -> u64 {
    // Slot 2 of NodeBase is block_type_hash (offset 16).
    let p: *mut u64 = (node as i64 + 16i64) as *mut u64;
    return *p;
}

unsafe fn read_cfg_hash(node: *mut u8) -> u64 {
    let p: *mut u64 = (node as i64 + 8i64) as *mut u64;
    return *p;
}

unsafe fn main() -> i32 {
    // 1. Direct alloc — Leaf and Branch hashes must differ.
    let leaf: *mut NodeBase<u64, u64, MapCfg> = node_alloc_c::<u64, u64, MapCfg>();
    let h_leaf: u64 = read_block_type_hash(leaf as *mut u8);
    let h_leaf_expected: u64 = type_hash::<LeafNode<u64, u64, MapCfg>>();
    if h_leaf != h_leaf_expected { return 11; }

    let br: *mut NodeBase<u64, u64, MapCfg> = node_alloc_internal_c::<u64, u64, MapCfg>();
    let h_br: u64 = read_block_type_hash(br as *mut u8);
    let h_br_expected: u64 = type_hash::<BranchNode<u64, u64, MapCfg>>();
    if h_br != h_br_expected { return 12; }

    if h_leaf == h_br { return 13; }              // distinct schemas
    if h_leaf == 0u64 { return 14; }
    if h_br   == 0u64 { return 15; }

    // 2. Stability — second leaf alloc has the same hash.
    let leaf2: *mut NodeBase<u64, u64, MapCfg> = node_alloc_c::<u64, u64, MapCfg>();
    if read_block_type_hash(leaf2 as *mut u8) != h_leaf { return 21; }

    // 3. cfg_hash at slot 1 (offset 8) is unchanged — still the
    //    CFG-byte-hash. block_type_hash and cfg_hash are independent.
    let cfg_h: u64 = read_cfg_hash(leaf as *mut u8);
    let cfg_h_expected: u64 = hstatic_hash_of::<MapCfg>();
    if cfg_h != cfg_h_expected { return 31; }

    // Cleanup.
    node_release_c::<u64, u64, MapCfg>(leaf);
    node_release_c::<u64, u64, MapCfg>(leaf2);
    node_release_c::<u64, u64, MapCfg>(br);

    // 4. End-to-end through create_pmap — root carries the leaf schema
    //    hash (initial root is a leaf).
    let mut s: Store<StoreCfg> = store_open();
    let mut sn: Snap<StoreCfg> = snap_begin(&mut s);
    {
        let mut cr: ContainerRef<MapCfg> = create_pmap::<MapCfg>(&mut sn, 7u64);
        let _ = cr.insert(1u64, 100u64, &1u64 as *const u64);
    }
    let r7: u64 = sn.get_root(7u64);
    if r7 == 0u64 { return 41; }
    if read_block_type_hash(r7 as *mut u8) != h_leaf_expected { return 42; }

    return 0;
}
