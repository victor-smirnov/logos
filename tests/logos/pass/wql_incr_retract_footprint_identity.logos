// ══════════════════════════════════════════════════════════════════════════════
// WHAT A BARE-SCAN RETRACTION IS MATCHED ON — THE ROW, AND WHERE IT IS STILL
// ONLY THE FOOTPRINT
// ══════════════════════════════════════════════════════════════════════════════
//
// HISTORY. The 2026-08-08 slice that closed the shipping corruption in
// `<q>_retract` (see `deem_incr_static_retract_e2e` block G3) gave a
// retract-eligible BARE-SCAN query a Z-set of the fold's FOOTPRINT — the group
// KEY followed by every aggregate ARGUMENT — and refused a retraction of a
// footprint the handle did not hold. It did not store the ROW, because a `str`
// field is a view of caller bytes and an `f64` field's `==` is not identity.
// This file pinned what that left open, as three annotated defects:
//   §1 two rows agreeing on (key, arguments) were one row to the handle, so a
//      retraction of a row never inserted was ACCEPTED;
//   §2 a `count` has no argument, its footprint was the key alone, and the
//      handle then disagreed with `<q>()` over the true surviving multiset;
//   §3 a multi-row `_apply` refused mid-way kept the rows before the refusal.
//
// 2026-10-03, BOTH CLOSED. `<q>_apply` runs on a shadow copy of the handle and
// commits only on `Ok` (§3). The sensor stores the WHOLE ROW wherever the row
// has a holdable identity — every field a scalar, `str`, `String` or float: a
// `str` is held as an owned `String`, a float by `f64_canon_bits` (all zeros one
// value, all NaNs one value, the identity the multiplicity map keys floats on,
// which inherits Victor's OPEN f64 key decision rather than answering it). The
// plan names the choice: `retract identity -> row` or `-> footprint`.
//
// WHAT STAYS OPEN, PINNED IN §6: a row with a field of a NAMED type (here a
// fieldless enum) has no identity the store can hold, so it keeps the footprint
// and §1's defect with it. §6 asserts the ACCEPTED retraction on purpose; a
// slice that widens `incr_rowid_text` to named types turns it into a refusal.
//
// exit 0 = a retraction of a row the handle never held is refused (§1, §2, §5),
//          the fields the fold reads are policed (§1b), a refused multi-row
//          delta leaves the handle as it was (§3), the key is part of the
//          identity (§4), and the footprint fallback's defect is pinned (§6).
package test;

use logos.mem.collections.vec;
use logos.mem.deem;
use logos.std.wql.wql;
use logos.std.wql.ir;
use logos.std.wql.el;
use logos.std.fmt;
use logos.lang.result;

// A row with a field the fold NEVER READS (`nm`, a `str`): the field that made
// whole-row storage impossible before, and the one §1 retracts on.
struct S { pub g: i64, pub v: i64, pub nm: str }

pub deem sumq(rs: &[S]) { from rs r group by r.g aggregate s = sum(r.v) select (key, s) }
pub deem cntq(rs: &[S]) { from rs r group by r.g aggregate n = count() select (key, n) }

// A footprint with MORE THAN ONE COMPONENT beside the key and an aggregate
// argument that is an EXPRESSION (`r.v * 2`). The row identity does not depend
// on either, but §4's snapshot reads the expression's value.
pub deem twoq(rs: &[S]) { from rs r
      group by r.g
      aggregate n = count(), s = sum(r.v * 2)
      select (key, n, s) }

// §5: a float field the fold never reads. Its identity is `f64_canon_bits`.
struct F { pub g: i64, pub v: i64, pub x: f64 }
pub deem fltq(rs: &[F]) { from rs r group by r.g aggregate s = sum(r.v) select (key, s) }

// §6: a field of a NAMED type — no holdable identity, so the footprint.
enum Kind { A, B }
struct N { pub g: i64, pub v: i64, pub k: Kind }
pub deem namq(rs: &[N]) { from rs r group by r.g aggregate s = sum(r.v) select (key, s) }

// THE CENSUS: `chk` counts predicates that executed, `rows` counts rows the
// engine handed back, and `.expected` pins the printed line, so deleting an
// assertion turns this file red instead of leaving it silently green.
struct Tally { pub chk: i64, pub rows: i64 }
fn bad(t: &mut Tally, c: bool) -> bool { t.chk = t.chk + 1i64; return c; }
fn arm_ok(t: &mut Tally) { t.chk = t.chk + 1i64; }

fn absent(t: &mut Tally, e: ElError) -> bool {
    match e {
        ElError::RetractAbsent => { arm_ok(t); return true; }
        ElError::Underflow  => { println!("WRONG ARM: Underflow");  return false; }
        ElError::Overflow   => { println!("WRONG ARM: Overflow");   return false; }
        ElError::DivByZero  => { println!("WRONG ARM: DivByZero");  return false; }
        ElError::SrcUnknown => { println!("WRONG ARM: SrcUnknown"); return false; }
    }
}

fn checks(t: &mut Tally) -> i32 {
    // ══ §1. A FIELD THE FOLD DOES NOT READ IS PART OF THE IDENTITY ═══════════
    // Insert (1, 5, "y"). Retract (1, 5, "x"): a row that was NEVER inserted,
    // differing only in `nm`. Refused, and the group still holds its row.
    let mut h1: SumqIncr = sumq_incremental();
    let i1: [S; 1] = [S { g: 1i64, v: 5i64, nm: "y" }];
    match sumq_epoch(&mut h1, &i1) { Result::Ok(_n) => {} Result::Err(_e) => { return 1i32; } }
    let r1: [S; 1] = [S { g: 1i64, v: 5i64, nm: "x" }];
    match sumq_retract(&mut h1, &r1) {
        Result::Ok(_n)  => { println!("§1: a row never inserted was retracted (footprint identity)"); return 21i32; }
        Result::Err(e1) => { if !absent(t, e1) { return 21i32; } }
    }
    let v1: Vec<(i64, i64)> = match sumq_snapshot(&h1) { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    t.rows = t.rows + v1.len();
    if bad(t, v1.len() != 1i64 || v1.get(0i64).1 != 5i64) { println!("§1: rows {}", v1.len()); return 22i32; }
    // …and the row that WAS inserted retracts.
    let r1b: [S; 1] = [S { g: 1i64, v: 5i64, nm: "y" }];
    match sumq_retract(&mut h1, &r1b) {
        Result::Ok(_n)  => { arm_ok(t); }
        Result::Err(_e) => { println!("§1: the inserted row was refused"); return 22i32; }
    }
    let v1b: Vec<(i64, i64)> = match sumq_snapshot(&h1) { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    t.rows = t.rows + v1b.len();
    if bad(t, v1b.len() != 0i64) { println!("§1: rows after {}", v1b.len()); return 22i32; }

    // ══ §1b. THE FIELDS IT DOES READ ARE POLICED ═════════════════════════════
    let mut h2: SumqIncr = sumq_incremental();
    match sumq_epoch(&mut h2, &i1) { Result::Ok(_n) => {} Result::Err(_e) => { return 1i32; } }
    let r2: [S; 1] = [S { g: 1i64, v: 6i64, nm: "y" }];
    match sumq_retract(&mut h2, &r2) {
        Result::Ok(_n)  => { println!("§1b: retracting a value never inserted was ACCEPTED"); return 23i32; }
        Result::Err(e2) => { if !absent(t, e2) { return 23i32; } }
    }
    let v2: Vec<(i64, i64)> = match sumq_snapshot(&h2) { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    t.rows = t.rows + v2.len();
    if bad(t, v2.len() != 1i64)      { println!("§1b: rows {}", v2.len());        return 24i32; }
    if bad(t, v2.get(0i64).1 != 5i64) { println!("§1b: sum {}", v2.get(0i64).1); return 24i32; }

    // ══ §2. A `count` SEES THE ROW, NOT ONLY ITS GROUP ═══════════════════════
    // Insert (1,10,"a") and (1,5,"b"); retract (1,999,"z"), a row that shares
    // only the key with either. Refused, and the handle agrees with the batch fn
    // over the true multiset (both rows): 2.
    let mut h3: CntqIncr = cntq_incremental();
    let i3: [S; 2] = [S { g: 1i64, v: 10i64, nm: "a" }, S { g: 1i64, v: 5i64, nm: "b" }];
    match cntq_epoch(&mut h3, &i3) { Result::Ok(_n) => {} Result::Err(_e) => { return 2i32; } }
    let r3: [S; 1] = [S { g: 1i64, v: 999i64, nm: "z" }];
    match cntq_retract(&mut h3, &r3) {
        Result::Ok(_n)  => { println!("§2: a count-only query retracted a row it never held"); return 25i32; }
        Result::Err(e3) => { if !absent(t, e3) { return 25i32; } }
    }
    let v3: Vec<(i64, i64)> = match cntq_snapshot(&h3) { Result::Ok(v) => { v } Result::Err(_e) => { return 2i32; } };
    t.rows = t.rows + v3.len();
    let b3: Vec<(i64, i64)> = match cntq(&i3) { Result::Ok(v) => { v } Result::Err(_e) => { return 2i32; } };
    t.rows = t.rows + b3.len();
    if bad(t, v3.len() != 1i64 || v3.get(0i64).1 != 2i64) { println!("§2: count {}", v3.get(0i64).1); return 26i32; }
    if bad(t, b3.get(0i64).1 != v3.get(0i64).1) { println!("§2: handle {} vs batch {}", v3.get(0i64).1, b3.get(0i64).1); return 27i32; }

    // ══ §3. A MULTI-ROW `_apply` IS ATOMIC ═══════════════════════════════════
    // Insert (1,10,"a") and (1,5,"b") → the group holds 15. Retract a TWO-ROW
    // delta whose first row is legitimate (1,10,"a") and whose second was never
    // inserted (1,999,"z"). `Err(RetractAbsent)`, and the first row, folded on
    // the shadow copy, is discarded with it: 15. (Before 2026-10-03: 5.)
    let mut h4: SumqIncr = sumq_incremental();
    match sumq_epoch(&mut h4, &i3) { Result::Ok(_n) => {} Result::Err(_e) => { return 3i32; } }
    let r4: [S; 2] = [S { g: 1i64, v: 10i64, nm: "a" }, S { g: 1i64, v: 999i64, nm: "z" }];
    match sumq_retract(&mut h4, &r4) {
        Result::Ok(_n)  => { println!("§3: a delta containing a never-inserted row was ACCEPTED"); return 28i32; }
        Result::Err(e4) => { if !absent(t, e4) { return 28i32; } }
    }
    let v4: Vec<(i64, i64)> = match sumq_snapshot(&h4) { Result::Ok(v) => { v } Result::Err(_e) => { return 3i32; } };
    t.rows = t.rows + v4.len();
    if bad(t, v4.len() != 1i64) { println!("§3: rows {}", v4.len()); return 29i32; }
    if bad(t, v4.get(0i64).1 != 15i64) { println!("§3: sum after a partly-refused delta {}", v4.get(0i64).1); return 29i32; }
    // …and the handle is still usable: the legitimate row alone retracts.
    let r4b: [S; 1] = [S { g: 1i64, v: 10i64, nm: "a" }];
    match sumq_retract(&mut h4, &r4b) {
        Result::Ok(_n)  => { arm_ok(t); }
        Result::Err(_e) => { println!("§3: the handle after a refused delta refused a legal retraction"); return 29i32; }
    }
    let v4b: Vec<(i64, i64)> = match sumq_snapshot(&h4) { Result::Ok(v) => { v } Result::Err(_e) => { return 3i32; } };
    t.rows = t.rows + v4b.len();
    if bad(t, v4b.len() != 1i64 || v4b.get(0i64).1 != 5i64) { println!("§3: sum after the legal retraction {}", v4b.get(0i64).1); return 29i32; }

    // ══ §4. THE KEY IS PART OF THE IDENTITY ══════════════════════════════════
    // Insert (1,5,"a") and (2,5,"a") — two rows that differ ONLY in the key.
    //   (a) retract (1,5,"a"): legal, group 1 empties;
    //   (b) retract (1,5,"a") again: refused, although group 2 holds a row
    //       equal to it in every other field.
    let mut h5: TwoqIncr = twoq_incremental();
    let i5: [S; 2] = [S { g: 1i64, v: 5i64, nm: "a" }, S { g: 2i64, v: 5i64, nm: "a" }];
    match twoq_epoch(&mut h5, &i5) { Result::Ok(_n) => {} Result::Err(_e) => { return 4i32; } }
    let v5: Vec<(i64, i64, i64)> = match twoq_snapshot(&h5) { Result::Ok(v) => { v } Result::Err(_e) => { return 4i32; } };
    t.rows = t.rows + v5.len();
    if bad(t, v5.len() != 2i64) { println!("§4: rows {}", v5.len()); return 30i32; }
    // the ARGUMENT is `r.v * 2`, so the group's sum is 10, not 5
    if bad(t, v5.get(0i64).2 != 10i64) { println!("§4: sum {}", v5.get(0i64).2); return 30i32; }
    let r5: [S; 1] = [S { g: 1i64, v: 5i64, nm: "a" }];
    match twoq_retract(&mut h5, &r5) {
        Result::Ok(_n)  => { arm_ok(t); }
        Result::Err(_e) => { println!("§4a: a LEGAL retraction was refused"); return 31i32; }
    }
    match twoq_retract(&mut h5, &r5) {
        Result::Ok(_n)   => { println!("§4b: the SECOND retraction was accepted — the KEY is not part of the identity"); return 32i32; }
        Result::Err(e5b) => { if !absent(t, e5b) { return 32i32; } }
    }
    let w5: Vec<(i64, i64, i64)> = match twoq_snapshot(&h5) { Result::Ok(v) => { v } Result::Err(_e) => { return 4i32; } };
    t.rows = t.rows + w5.len();
    if bad(t, w5.len() != 1i64)        { println!("§4: rows after {}", w5.len());           return 33i32; }
    if bad(t, w5.get(0i64).0 != 2i64)  { println!("§4: surviving key {}", w5.get(0i64).0);  return 33i32; }
    if bad(t, w5.get(0i64).2 != 10i64) { println!("§4: surviving sum {}", w5.get(0i64).2);  return 33i32; }

    // ══ §5. A FLOAT FIELD IS HELD BY `f64_canon_bits` ════════════════════════
    // Insert (1,5,-0.0). Retract (1,5,1.0): a different float, refused. Retract
    // (1,5,+0.0): the zeros are one value under the canonical identity, so it is
    // the row the handle holds, and the group empties.
    let mut h6: FltqIncr = fltq_incremental();
    let i6: [F; 1] = [F { g: 1i64, v: 5i64, x: -0.0 }];
    match fltq_epoch(&mut h6, &i6) { Result::Ok(_n) => {} Result::Err(_e) => { return 5i32; } }
    let r6: [F; 1] = [F { g: 1i64, v: 5i64, x: 1.0 }];
    match fltq_retract(&mut h6, &r6) {
        Result::Ok(_n)  => { println!("§5: a row with a float never inserted was retracted"); return 34i32; }
        Result::Err(e6) => { if !absent(t, e6) { return 34i32; } }
    }
    let r6b: [F; 1] = [F { g: 1i64, v: 5i64, x: 0.0 }];
    match fltq_retract(&mut h6, &r6b) {
        Result::Ok(_n)  => { arm_ok(t); }
        Result::Err(_e) => { println!("§5: +0.0 did not retract the -0.0 row (canonical identity)"); return 35i32; }
    }
    let v6: Vec<(i64, i64)> = match fltq_snapshot(&h6) { Result::Ok(v) => { v } Result::Err(_e) => { return 5i32; } };
    t.rows = t.rows + v6.len();
    if bad(t, v6.len() != 0i64) { println!("§5: rows after {}", v6.len()); return 35i32; }

    // ══ §6. THE FOOTPRINT FALLBACK, AND ITS DEFECT, PINNED ═══════════════════
    // ⚠ GREEN AND WRONG, DELIBERATELY. `k: Kind` is a named type, so `namq`'s
    // store is the footprint (key, v): insert (1,5,A), retract (1,5,B), a row
    // never inserted — ACCEPTED, and the group empties. A slice that gives named
    // fields an identity turns this arm into `Err(RetractAbsent)` and must edit
    // this block.
    let mut h7: NamqIncr = namq_incremental();
    let i7: [N; 1] = [N { g: 1i64, v: 5i64, k: Kind::A }];
    match namq_epoch(&mut h7, &i7) { Result::Ok(_n) => {} Result::Err(_e) => { return 6i32; } }
    let r7: [N; 1] = [N { g: 1i64, v: 5i64, k: Kind::B }];
    match namq_retract(&mut h7, &r7) {
        Result::Ok(_n)  => { arm_ok(t); }     // ⚠ THE DEFECT, PINNED
        Result::Err(_e) => { println!("§6: named fields grew an identity — retire this block"); return 36i32; }
    }
    let v7: Vec<(i64, i64)> = match namq_snapshot(&h7) { Result::Ok(v) => { v } Result::Err(_e) => { return 6i32; } };
    t.rows = t.rows + v7.len();
    if bad(t, v7.len() != 0i64) { println!("§6: rows after {}", v7.len()); return 37i32; }

    return 0i32;
}

fn main() -> i32 {
    let mut t: Tally = Tally { chk: 0i64, rows: 0i64 };
    let r: i32 = checks(&mut t);
    if r != 0i32 { return r; }
    println!("footprint residue ok chk={} rows={}", t.chk, t.rows);
    return 0i32;
}
