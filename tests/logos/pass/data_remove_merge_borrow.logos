// Multi-level remove with rebalance: borrow from sibling + merge.
// Inserts enough to grow the tree to 2-3 levels (fanout=4 with 30
// keys → root branch + branch-of-leaves), then drains by removing
// every key. Each remove triggers underflow checks; the algorithm
// must borrow/merge to keep B+tree invariants and root-collapse
// when the root branch shrinks to one child.
//
// Validates: no key disappears between removes; final size = 0;
// removing a non-existent key returns false at every stage.
package persistent_remove_merge_borrow;

use logos.std.deem.data.handle;
use logos.std.deem.data.store;
use logos.std.deem.data.bt.node;
use logos.std.deem.data.bt.cow;
use logos.std.deem.data.bt.descent;
use logos.std.deem.data.bt.mutate;
use logos.lang.fabric;
use logos.lang.writ.wstatic;

pub const StoreCfg: WritStatic = @{
    "name": "rebal", "ctr_id": <type:u64>, "snp_id": <type:u64>, "block_id": <type:u64>,
};
// Small fanout exercises split, borrow, merge and root-collapse paths
// repeatedly with modest data.
pub const MapCfg: WritStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 4 };

fn main() -> i32 {
    let mut store = store_open::<StoreCfg>();
    let mut snap = store.fork(GENESIS);
    let mut cr =
        create_ctr::<MapCfg>(&mut snap, 1u64);

    // Insert 30 keys → multi-level tree.
    let mut i = 0u64;
    while i < 30u64 {
        cr.insert(i, i * 7u64);
        i = i + 1u64;
    }
    if cr.len() != 30u64 { return 1; }

    // Sequential drain from low end. Each remove may trigger
    // borrow-from-right or merge-with-right; eventually the root
    // collapses through one or more branch levels.
    let mut r = 0u64;
    while r < 30u64 {
        if !cr.remove(r) { return 10 + r as i32; }
        // Every remaining key must still be reachable.
        let mut q = r + 1u64;
        while q < 30u64 {
            if !cr.contains(q) { return 100 + q as i32; }
            let out = match cr.get(q) {
                Option::Some(x) => x,
                Option::None => { return 200 + q as i32; }
            };
            if out != q * 7u64 { return 300 + q as i32; }
            q = q + 1u64;
        }
        // Removed key must NOT be reachable.
        if cr.contains(r) { return 400 + r as i32; }
        // Removing again returns false.
        if cr.remove(r) { return 500 + r as i32; }
        r = r + 1u64;
    }
    if cr.len() != 0u64 { return 2; }

    // Re-insert in reverse order — exercise borrow-from-left + merge-
    // with-left paths (drain from high end after).
    let mut k = 30u64;
    while k > 0u64 {
        k = k - 1u64;
        cr.insert(k, k * 11u64);
    }
    if cr.len() != 30u64 { return 3; }

    let mut s = 30u64;
    while s > 0u64 {
        s = s - 1u64;
        if !cr.remove(s) { return 600 + s as i32; }
        let mut q = 0u64;
        while q < s {
            if !cr.contains(q) { return 700 + q as i32; }
            q = q + 1u64;
        }
    }
    if cr.len() != 0u64 { return 4; }

    return 0;
}
