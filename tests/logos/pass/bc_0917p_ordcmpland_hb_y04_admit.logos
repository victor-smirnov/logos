package bc_0917p_ordcmpland_hb_y04_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
fn f1() -> i64 { return 1i64; }
fn f2() -> i64 { return 2i64; }
fn main() -> i32 {
    let a: fn() -> i64 = f1;
    let b: fn() -> i64 = f2;
