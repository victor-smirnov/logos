// THE LEGAL TWIN, ONE TOKEN APART: a place under a module static IS 'static —
// `&ARR[1]` and `&S0.n` both. The fail twin indexes the local array `arr`.
package bc_stplace_under_static_is_static;

struct S { n: i64 }

static ARR: [i64; 3] = [1i64, 2i64, 3i64];
static S0: S = S { n: 7i64 };

fn main() -> i32 {
    let arr: [i64; 3] = [4i64, 5i64, 6i64];
    let y: &'static i64 = &ARR[1];
    let z: &'static i64 = &S0.n;
    return *y as i32 + *z as i32 + arr[0] as i32 - 13i32;
}
