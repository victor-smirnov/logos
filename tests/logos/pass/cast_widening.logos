package cast_widening;
// F13: narrowing and widening casts i32 ↔ i64 ↔ i8
unsafe fn main() -> i32 {
    let a: i32 = 42;
    let b: i64 = a as i64;   // widening
    let c: i32 = b as i32;   // narrowing back
    let d: i8  = 42 as i8;   // to byte
    let e: i32 = d as i32;   // byte to i32
    return c + (e - c);      // 42
}
