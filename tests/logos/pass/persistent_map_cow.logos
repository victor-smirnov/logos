// Tests std.data.persistent.map snapshot + path-copy CoW semantics.
package test;

use std.data.persistent.uid256;
use std.data.persistent.map;
use std.lang.cmp;
use std.lang.datatypes;

fn main() -> i32 {
    let a: UID256 = uid256_random();
    let b: UID256 = uid256_random();
    let c: UID256 = uid256_random();

    let v1: UID256 = uid256_random();
    let v2: UID256 = uid256_random();

    let mut m: PMap<UID256, UID256> = map_new::<UID256, UID256>();
    map_insert::<UID256, UID256>(&mut m, &a as *const UID256, &v1 as *const UID256, &a as *const UID256);
    map_insert::<UID256, UID256>(&mut m, &b as *const UID256, &v1 as *const UID256, &b as *const UID256);

    // Snapshot — both handles share the same root with rc=2.
    let mut snap: PMap<UID256, UID256> = map_snapshot::<UID256, UID256>(&m);

    // Sanity: same length, both observe both keys.
    if map_len::<UID256, UID256>(&m)    != 2u64 { return 1; }
    if map_len::<UID256, UID256>(&snap) != 2u64 { return 2; }

    // Mutate the original: insert c.  Path-copy fires (rc was 2), snap
    // keeps its frozen view.
    map_insert::<UID256, UID256>(&mut m, &c as *const UID256, &v1 as *const UID256, &c as *const UID256);

    if map_len::<UID256, UID256>(&m)    != 3u64 { return 3; }
    if map_len::<UID256, UID256>(&snap) != 2u64 { return 4; }
    if  map_contains::<UID256, UID256>(&snap, &c as *const UID256) { return 5; }
    if !map_contains::<UID256, UID256>(&m,    &c as *const UID256) { return 6; }

    // Upsert hit on m: overwrite a's value with v2.  m's root is now
    // unique (rc=1 after the previous CoW), so this stays in-place; snap
    // already had its own root, so it still sees v1.
    map_insert::<UID256, UID256>(&mut m, &a as *const UID256, &v2 as *const UID256, &a as *const UID256);

    let mut out_m: *const UID256 = 0 as *const UID256;
    let mut out_s: *const UID256 = 0 as *const UID256;
    if !map_get::<UID256, UID256>(&m,    &a as *const UID256, &mut out_m as *mut *const UID256) { return 7; }
    if !map_get::<UID256, UID256>(&snap, &a as *const UID256, &mut out_s as *mut *const UID256) { return 8; }
    unsafe {
        if !(&*out_m).eq(&v2) { return 9; }
        if !(&*out_s).eq(&v1) { return 10; }
    }

    // Take a second snapshot of m, then mutate snap (path-copy on snap's root).
    let mut snap2: PMap<UID256, UID256> = map_snapshot::<UID256, UID256>(&m);
    map_remove::<UID256, UID256>(&mut snap, &a as *const UID256);

    if map_len::<UID256, UID256>(&snap)  != 1u64 { return 11; }
    if map_len::<UID256, UID256>(&m)     != 3u64 { return 12; }
    if map_len::<UID256, UID256>(&snap2) != 3u64 { return 13; }
    if  map_contains::<UID256, UID256>(&snap, &a as *const UID256) { return 14; }
    if !map_contains::<UID256, UID256>(&m,    &a as *const UID256) { return 15; }
    if !map_contains::<UID256, UID256>(&snap2, &a as *const UID256) { return 16; }

    map_drop::<UID256, UID256>(&mut snap2);
    map_drop::<UID256, UID256>(&mut snap);
    map_drop::<UID256, UID256>(&mut m);

    return 42;
}
