package arith_precedence;
// F02: operator precedence — * before +, parens override
unsafe fn main() -> i32 {
    let a: i32 = 2 + 3 * 8;        // 2+24 = 26
    let b: i32 = (2 + 3) * 8;      // 40
    let c: i32 = 10 - 2 * 4;       // 10-8 = 2
    let d: i32 = (10 - 2) * 4;     // 32
    // we want a result = 42
    // 26 - 40 + 2 + 32 = 20  nope
    // 40 + 2 = 42 yes
    return b + c;
}
