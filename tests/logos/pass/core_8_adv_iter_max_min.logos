package i08_max_min;
fn main() -> i32 {
    let mut v: Vec<i32> = Vec::<i32>::new();
    v.push(3i32); v.push(1i32); v.push(4i32); v.push(1i32); v.push(5i32); v.push(9i32);
    let mx: Option<&i32> = iter_max::<VecIter<i32>, &i32>(v.iter());
    let mn: Option<&i32> = iter_min::<VecIter<i32>, &i32>(v.iter());
    let mx_v: i32 = match mx { Option::Some(x) => *x, Option::None => 0i32 };
    let mn_v: i32 = match mn { Option::Some(x) => *x, Option::None => 0i32 };
    if mx_v != 9i32 { return 1i32; }
    if mn_v != 1i32 { return 2i32; }
    return 0i32;
}
