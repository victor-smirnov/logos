// {:#?} across std containers and tuples (Vec<Option>, tuple with array, Result of 1-tuple, empty array) and {:?} of a tuple holding Option<[T; 1]> (rustc output).
package pretty_debug_std_container_shapes;
use logos.std.fmt;
use logos.mem.collections.vec;
fn main() -> i32 {
    let mut v: Vec<Option<i64>> = Vec::new();
    v.push(Some(1i64)); v.push(None);
    println!("{:#?}", v);
    println!("{:#?}", (1i64, [2i64, 3i64]));
    let r: Result<(i64,), i64> = Ok((4i64,));
    println!("{:#?}", r);
    let e: [i64; 0] = [];
    println!("{:#?}", e);
    println!("{:?}", (Some([1i64]), 2i64));
    return 0;
}
