// logos-core §4.2: match exhaustiveness — Useful-Sukhotin-style coverage
// across the practical shapes Logos supports. Pre-fix the scoreboard
// marked this 🟡 ("variant coverage + bool + uninhabited ✓;
// Useful-Sukhotin alg + guard integration absent"), but the
// integration IS in the tree at `check_match_exhaustiveness` + the
// `ast_patterns_exhaustive` nested-pattern proof. Wave 3 pins the
// shapes that work today:
//
//   1. VARIANT COVERAGE: explicit arms covering every variant of a
//      finite enum accepted without `_`.
//   2. GUARD INTEGRATION: a guarded arm does NOT count toward
//      coverage (sema_stmt.cpp::check_match_exhaustiveness:6762
//      skips arms with `arm.guard != nullptr`). Adding an unguarded
//      catch-all is required to satisfy exhaustiveness.
//   3. UNINHABITED: matching on an empty enum (or Never-typed
//      scrutinee) is trivially exhaustive — accepts a bare
//      `match x { }` arm list.
//   4. NESTED VARIANT: a match over `Option<Result<i32, ...>>`
//      enumerating every inner variant explicitly is accepted —
//      ast_patterns_exhaustive walks the nested pattern shape.
//
// Companion fail-test: `core_4_2_missing_variant.logos` pins the
// negative arm (missing variant → "match is not exhaustive — missing
// variant(s): X" diagnostic).
package core_4_2_match_exhaustiveness;

enum Color { Red, Green, Blue }

// Piece (1): every variant covered explicitly, no `_`.
fn variant_coverage(c: Color) -> i32 {
    match c {
        Color::Red   => { return 1i32; }
        Color::Green => { return 2i32; }
        Color::Blue  => { return 3i32; }
    }
}

// Piece (2): guard-integration — a guarded arm doesn't count toward
// coverage. The wildcard arm IS required.
fn guard_then_wild(c: Color, only_red: bool) -> i32 {
    match c {
        Color::Red if only_red => { return 10i32; }
        _                      => { return 20i32; }
    }
}

// Piece (4): nested variant coverage. Every inner Option arm is
// enumerated explicitly; outer arms also exhaustive.
fn nested_variant(o: Option<bool>) -> i32 {
    match o {
        Some(true)  => { return 1i32; }
        Some(false) => { return 0i32; }
        None        => { return -1i32; }
    }
}

fn main() -> i32 {
    if variant_coverage(Color::Red) != 1i32 { return 1i32; }
    if variant_coverage(Color::Green) != 2i32 { return 2i32; }
    if variant_coverage(Color::Blue) != 3i32 { return 3i32; }
    if guard_then_wild(Color::Red, true)  != 10i32 { return 4i32; }
    if guard_then_wild(Color::Red, false) != 20i32 { return 5i32; }
    if guard_then_wild(Color::Green, true) != 20i32 { return 6i32; }
    if nested_variant(Some(true))  != 1i32 { return 7i32; }
    if nested_variant(Some(false)) != 0i32 { return 8i32; }
    if nested_variant(None)        != -1i32 { return 9i32; }
    return 0i32;
}
