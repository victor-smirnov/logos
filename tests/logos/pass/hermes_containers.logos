package hermes_containers;
// Phase 8: TinyObjectMap and ObjectArray — Hermes container datatypes.

use std.hermes.zone;
use std.hermes.anyval;
use std.hermes.array;
use std.hermes.map;
use std.hermes.typed_value;
use std.hermes.mem_holder;

unsafe fn main() -> i32 {
    let mut zone: HermesZone = HermesZone::create(4096);
    let base: *mut u8 = zone.base;

    // ---------------------------------------------------------------------------
    // TinyObjectMap: capacity 10
    // ---------------------------------------------------------------------------
    let map_sz:  i64   = sizeof::<TinyObjectMap>() as i64;
    let map_raw: *mut u8 = zone.alloc_raw(map_sz);
    let arr_raw: *mut u8 = zone.alloc_raw(80);   // 10 * sizeof(AnyVal) = 10*8
    let map: *mut TinyObjectMap = TinyObjectMap::init(map_raw, arr_raw, base, 10 as u32);

    // Insert three entries: keys 0, 3, 7
    map.set(base, 0 as u8, AnyVal::embed_i24(42));
    map.set(base, 7 as u8, AnyVal::from_offset(1000 as u32));
    map.set(base, 3 as u8, AnyVal::embed_bool(true));

    // Size should be 3
    if map.size() != 3 as u32           { return 1; }

    // Key 0 → i32(42)
    let v0: AnyVal = map.get(base as *const u8, 0 as u8);
    if v0.is_ptr()                      { return 2; }
    if v0.as_i24() != 42                { return 3; }

    // Key 3 → bool(true)
    let v3: AnyVal = map.get(base as *const u8, 3 as u8);
    if v3.is_ptr()                      { return 4; }
    if !v3.as_bool()                    { return 5; }

    // Key 7 → ptr(offset=1000)
    let v7: AnyVal = map.get(base as *const u8, 7 as u8);
    if !v7.is_ptr()                     { return 6; }
    if v7.as_offset() != 1000 as u32    { return 7; }

    // Key 5 → absent → null
    let v5: AnyVal = map.get(base as *const u8, 5 as u8);
    if !v5.is_null()                    { return 8; }

    // contains()
    if !map.contains(0 as u8)           { return 9; }
    if !map.contains(3 as u8)           { return 10; }
    if  map.contains(5 as u8)           { return 11; }

    // Overwrite key 0 → i32(99)
    map.set(base, 0 as u8, AnyVal::embed_i24(99));
    if map.size() != 3 as u32           { return 12; }  // no new key
    let v0b: AnyVal = map.get(base as *const u8, 0 as u8);
    if v0b.as_i24() != 99               { return 13; }

    // ---------------------------------------------------------------------------
    // ObjectArray: capacity 8
    // ---------------------------------------------------------------------------
    let oa_sz:   i64   = sizeof::<ObjectArray>() as i64;
    let oa_raw:  *mut u8 = zone.alloc_raw(oa_sz);
    let obuf:    *mut u8 = zone.alloc_raw(64);   // 8 * 8
    let arr: *mut ObjectArray = ObjectArray::init(oa_raw, obuf, base, 8 as u64);

    // Wrap zone.base in a MemHolder so growable push() has a zone to alloc in.
    // Capacity is preset to 8 and we push only 3, so grow never fires.
    let holder: *mut MemHolder =
        memholder_wrap(base, 4096, memholder_destroy_none);
    arr.push(holder, AnyVal::embed_i24(10));
    arr.push(holder, AnyVal::embed_i24(20));
    arr.push(holder, AnyVal::embed_i24(30));

    if arr.len() != 3 as u64            { return 14; }

    let a0: AnyVal = arr.get(base as *const u8, 0 as u64);
    let a1: AnyVal = arr.get(base as *const u8, 1 as u64);
    let a2: AnyVal = arr.get(base as *const u8, 2 as u64);

    if a0.as_i24() != 10                { return 15; }
    if a1.as_i24() != 20                { return 16; }
    if a2.as_i24() != 30                { return 17; }

    // Out-of-bounds → null
    let oob: AnyVal = arr.get(base as *const u8, 5 as u64);
    if !oob.is_null()                   { return 18; }

    zone.destroy();
    return 42;
}
