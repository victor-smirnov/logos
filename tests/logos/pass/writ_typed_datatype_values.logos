// @Type typed values inside documents (writ): prefix/postfix forms as map
// members; reads through WTypedValue accessors.
package writ_typed_datatype_values;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.wmap;
use logos.lang.writ.wstring;
use logos.lang.writ.typed_value;
use logos.mem.writ.parser;
use logos.lang.rc;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(32768);
    let h: &Writ = rc.deref();

    let root: WAny = parse(h,
        "{\"a\": @I64 = 42, \"b\": \"123.45\" @Decimal(10,2), \"c\": @Point({\"fmt\": \"xy\"})={\"x\": 1, \"y\": 2}}");
    if !root.is_map() { return 1; }
    let m: &WMap<WString, WAny> = &*(root.resolve() as *const WMap<WString, WAny>);

    // a: @I64 = 42 — no params, int init.
    let a: WAny = m.get("a");
    if !a.is_typed_value() { return 2; }
    let atv: &WTypedValue = a.as_typed_value();
    if !str_eq(atv.type_name_str(), "I64") { return 3; }
    if atv.has_params() { return 4; }
    if atv.init().as_i64() != 42i64 { return 5; }

    // b: postfix decimal annotation, string init.
    let b: WAny = m.get("b");
    if !b.is_typed_value() { return 6; }
    let btv: &WTypedValue = b.as_typed_value();
    if !str_eq(btv.type_name_str(), "Decimal") { return 7; }
    if !btv.has_params() { return 8; }
    if !btv.init().is_string() { return 9; }

    // c: structured params + map initializer.
    let c: WAny = m.get("c");
    if !c.is_typed_value() { return 10; }
    let ctv: &WTypedValue = c.as_typed_value();
    if !str_eq(ctv.type_name_str(), "Point") { return 11; }
    let prm: WAny = ctv.params();
    if !prm.is_array() { return 12; }
    let init: WAny = ctv.init();
    if !init.is_map() { return 13; }
    let im: &WMap<WString, WAny> = &*(init.resolve() as *const WMap<WString, WAny>);
    if im.get("y").as_i64() != 2i64 { return 14; }

    return 0;
}
