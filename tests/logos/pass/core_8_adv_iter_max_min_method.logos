package i08_max_min_method;
fn main() -> i32 {
    let mut v: Vec<i32> = Vec::<i32>::new();
    v.push(3i32); v.push(1i32); v.push(4i32); v.push(1i32);
    v.push(5i32); v.push(9i32); v.push(2i32); v.push(6i32);
    let mx: Option<&i32> = v.iter().max();
    let mn: Option<&i32> = v.iter().min();
    let mx_v: i32 = match mx { Option::Some(x) => *x, Option::None => 0i32 };
    let mn_v: i32 = match mn { Option::Some(x) => *x, Option::None => 0i32 };
    if mx_v != 9i32 { return 1i32; }
    if mn_v != 1i32 { return 2i32; }
    return 0i32;
}
