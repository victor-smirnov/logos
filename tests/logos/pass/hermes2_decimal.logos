// HDecimal — fixed-precision signed decimal (Hermes2 port of Hermes1 Decimal,
// code 102): value = (neg?-1:1)*coeff/10^scale. Round-trips 3.14 (coeff 314,
// scale 2) and -0.5, checking scale/coeff/sign/to_f64 + the 102 tag.
package test;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.decimal;
fn main() -> i32 {
    let h: Hermes2 = hermes2_new(256i64);
    let d: HAny = h.decimal(314u64, 2u32, false);    // 3.14
    if !d.is_decimal() || d.type_code() != 102u64 { return 1i32; }
    let dd: &HDecimal = d.as_decimal();
    if dd.scale() != 2u32 || dd.coeff() != 314u64 || dd.is_neg() { return 2i32; }
    let f: f64 = dd.to_f64();
    if f < 3.139f64 || f > 3.141f64 { return 3i32; }
    let n: HAny = h.decimal(5u64, 1u32, true);        // -0.5
    let nn: &HDecimal = n.as_decimal();
    if !nn.is_neg() { return 4i32; }
    let nf: f64 = nn.to_f64();
    if nf > -0.49f64 || nf < -0.51f64 { return 5i32; }
    return 0i32;
}
