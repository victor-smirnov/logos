// C8f: WritStatic → WritView conversion via as_view().
package writ_view_from_static;
use logos.lang.writ.wstatic;
use logos.lang.writ.static_view;  // WView2
use logos.lang.writ.anyval;       // WAny
use logos.mem.writ.stringify;     // stringify
use logos.mem.string;
use logos.lang.str;

unsafe fn check_view(v: WView2, expected: str, err_code: i32) -> i32 {
    let text: String = stringify(v.root());
    if !text.eq_str(expected) { return err_code; }
    return 0;
}

unsafe fn main() -> i32 {
    // Static literal → view.
    let s1: WritStatic = @42;
    let v1: WView2 = wview2_from_ptr(s1.ptr);
    let r: i32 = check_view(v1, "42", 1);
    if r != 0 { return r; }

    // Array literal → view.
    let s2: WritStatic = @[1, 2, 3];
    let v2: WView2 = wview2_from_ptr(s2.ptr);
    let r2: i32 = check_view(v2, "[1, 2, 3]", 2);
    if r2 != 0 { return r2; }

    // Map literal → view.
    let s3: WritStatic = @{"key": true};
    let v3: WView2 = wview2_from_ptr(s3.ptr);
    let r3: i32 = check_view(v3, "{\"key\": true}", 3);
    if r3 != 0 { return r3; }

    return 0;
}
