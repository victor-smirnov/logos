// `fn f(mut x: T)` — a mutable parameter binding (Rust idiom; caller-invisible).
// The body may reassign the param and take `&mut` of it. Desugared to a synth
// immutable param + a `let mut x = synth;` prologue.
package mut_param_binding;

fn add_one(mut x: i64) -> i64 {
    x = x + 1i64;
    return x;
}

fn bump(p: &mut i64) { *p = *p + 1i64; }
fn via_ref(mut x: i64) -> i64 {
    bump(&mut x);   // take &mut of a mut param
    return x;
}

fn twice<F>(mut f: F, x: i64) -> i64 where F: FnMut(i64) -> i64 {
    return f(x) + f(x);
}
fn dbl(n: i64) -> i64 { return n * 2i64; }

fn drain(mut v: Vec<i64>) -> i64 {   // move-type mut param (no double-free)
    v.push(99i64);
    return v.length();
}

struct Counter { n: i64 }
impl Counter {
    fn bump_by(self: Counter, mut step: i64) -> i64 {
        step = step + 1i64;
        return self.n + step;
    }
}

fn main() -> i32 {
    if add_one(4i64) != 5i64 { return 1i32; }
    if via_ref(40i64) != 41i64 { return 2i32; }
    if twice(dbl, 5i64) != 20i64 { return 3i32; }

    let mut xs: Vec<i64> = Vec::<i64>::new();
    xs.push(1i64); xs.push(2i64);
    if drain(xs) != 3i64 { return 4i32; }

    let c: Counter = Counter { n: 10i64 };
    if c.bump_by(4i64) != 15i64 { return 5i32; }

    return 0i32;
}
