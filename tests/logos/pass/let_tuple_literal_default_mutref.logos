// An unsuffixed literal inside a `let` tuple takes the literal default (i32) like a bare one: `let mut u = (Some(4), 3);
// h(&mut u)` at `&mut (Option<i32>, i32)` failed invariance on `{integer}` (squeue #row closed). rustc twin: 8.
package let_tuple_literal_default_mutref;
fn h(t: &mut (Option<i32>, i32)) -> i32 { match t { (None, _) => { return 0; } (Some(v), b) => { *v = *v + 1; return *v + *b; } } }
fn main() -> i32 { let mut u = (Some(4), 3); return h(&mut u); }
