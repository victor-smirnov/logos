// hermes_typed_array_all_elems.logos — end-to-end stringify coverage for all
// 10 element types in @<T>[...] literals.  Exercises the full Logos codegen
// → HermesStringify → type tag dispatch stack.
//
// f32/f64: HermesStringify casts elements to i64 (integer output, no decimals).

package hermes_typed_array_all_elems;

use std.hermes.view;
use std.hermes.stringify;
use std.hermes.array;
use std.hermes.map;
use std.hermes.typed_value;
use std.lang.text;

unsafe fn check(hs: &HermesStatic, expected: str, err_code: i32) -> i32 {
    let s: String = hs.to_string();
    if !s.eq_str(expected) { return err_code; }
    return 0;
}

pub unsafe fn main() -> i32 {
    let mut rc: i32 = 0;

    // ── i8 (error offset 10) ──────────────────────────────────────────────────
    let a_i8: HermesStatic = @<I8>[-1, 2, 127];
    rc = check(&a_i8, "<I8> [-1,2,127]", 10);
    if rc != 0 { return rc; }

    let e_i8: HermesStatic = @<I8>[];
    rc = check(&e_i8, "<I8> []", 11);
    if rc != 0 { return rc; }

    // ── u8 (error offset 20) ──────────────────────────────────────────────────
    let a_u8: HermesStatic = @<U8>[0, 128, 255];
    rc = check(&a_u8, "<U8> [0,128,255]", 20);
    if rc != 0 { return rc; }

    let e_u8: HermesStatic = @<U8>[];
    rc = check(&e_u8, "<U8> []", 21);
    if rc != 0 { return rc; }

    // ── i16 (error offset 30) ─────────────────────────────────────────────────
    let a_i16: HermesStatic = @<I16>[-300, 0, 300];
    rc = check(&a_i16, "<I16> [-300,0,300]", 30);
    if rc != 0 { return rc; }

    let e_i16: HermesStatic = @<I16>[];
    rc = check(&e_i16, "<I16> []", 31);
    if rc != 0 { return rc; }

    // ── u16 (error offset 40) ─────────────────────────────────────────────────
    let a_u16: HermesStatic = @<U16>[0, 1000, 65535];
    rc = check(&a_u16, "<U16> [0,1000,65535]", 40);
    if rc != 0 { return rc; }

    let e_u16: HermesStatic = @<U16>[];
    rc = check(&e_u16, "<U16> []", 41);
    if rc != 0 { return rc; }

    // ── i32 (error offset 50) ─────────────────────────────────────────────────
    let a_i32: HermesStatic = @<I32>[-1, 0, 1];
    rc = check(&a_i32, "<I32> [-1,0,1]", 50);
    if rc != 0 { return rc; }

    let e_i32: HermesStatic = @<I32>[];
    rc = check(&e_i32, "<I32> []", 51);
    if rc != 0 { return rc; }

    // ── u32 (error offset 60) ─────────────────────────────────────────────────
    let a_u32: HermesStatic = @<U32>[0, 1, 4294967295];
    rc = check(&a_u32, "<U32> [0,1,4294967295]", 60);
    if rc != 0 { return rc; }

    let e_u32: HermesStatic = @<U32>[];
    rc = check(&e_u32, "<U32> []", 61);
    if rc != 0 { return rc; }

    // ── i64 (error offset 70) ─────────────────────────────────────────────────
    let a_i64: HermesStatic = @<I64>[-1, 0, 1];
    rc = check(&a_i64, "<I64> [-1,0,1]", 70);
    if rc != 0 { return rc; }

    let e_i64: HermesStatic = @<I64>[];
    rc = check(&e_i64, "<I64> []", 71);
    if rc != 0 { return rc; }

    // ── u64 (error offset 80) ─────────────────────────────────────────────────
    let a_u64: HermesStatic = @<U64>[0, 1, 18446744073709551615];
    rc = check(&a_u64, "<U64> [0,1,18446744073709551615]", 80);
    if rc != 0 { return rc; }

    let e_u64: HermesStatic = @<U64>[];
    rc = check(&e_u64, "<U64> []", 81);
    if rc != 0 { return rc; }

    // ── f32 (error offset 90) — HermesStringify casts f32 → i64 ─────────────
    let a_f32: HermesStatic = @<F32>[1, 2, 3];
    rc = check(&a_f32, "<F32> [1,2,3]", 90);
    if rc != 0 { return rc; }

    let e_f32: HermesStatic = @<F32>[];
    rc = check(&e_f32, "<F32> []", 91);
    if rc != 0 { return rc; }

    // ── f64 (error offset 100) — HermesStringify casts f64 → i64 ────────────
    let a_f64: HermesStatic = @<F64>[10, 20, 30];
    rc = check(&a_f64, "<F64> [10,20,30]", 100);
    if rc != 0 { return rc; }

    let e_f64: HermesStatic = @<F64>[];
    rc = check(&e_f64, "<F64> []", 101);
    if rc != 0 { return rc; }

    return 0;
}
