// A trait impl's header `where` bounds a parameter as an inline bound does, mixed
// with an inline one; an inherent impl's `where` beside it. rustc 1.98.1: exit 0.
package trait_impl_where_and_inline_bounds;
trait Tr { fn t(self: &Self) -> i64; }
impl Tr for i64 { fn t(self: &Self) -> i64 { return *self; } }
trait Sum { fn sum(self: &Self) -> i64; }
struct P<X, Y> { x: X, y: Y }
impl<X: Tr, Y> Sum for P<X, Y> where Y: Tr {
    fn sum(self: &Self) -> i64 { return self.x.t() + self.y.t(); }
}
struct Q<X> { x: X }
impl<X> Q<X> where X: Tr { fn s(self: &Self) -> i64 { return self.x.t(); } }
fn main() -> i32 { let p = P { x: 1i64, y: 2i64 }; let q = Q { x: 4i64 }; return (p.sum() + q.s() - 7) as i32; }
