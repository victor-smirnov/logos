package class_two_levels;
// F27: 2-level class hierarchy with method override
class Animal {
    val: i32;
    fn speak(self: *mut Animal) -> i32 { return self.val; }
}
class Dog extends Animal {
    fn speak(self: *mut Dog) -> i32 { return self.val * 2; }
    fn fetch(self: *mut Dog) -> i32 { return self.val + 1; }
}
class Guide extends Dog {
    fn guide(self: *mut Guide) -> i32 { return self.val * 3; }
}
fn main() -> i32 {
    let a: *mut Animal = new Animal { val: 5 };
    let d: *mut Dog = new Dog { val: 6 };
    let g: *mut Guide = new Guide { val: 7 };
    let r1: i32 = a.speak();   // 5
    let r2: i32 = d.speak();   // 12
    let r3: i32 = d.fetch();   // 7
    let r4: i32 = g.guide();   // 21
    delete a; delete d; delete g;
    // 5+12+7+21 = 45 - 3 = 42
    return r1 + r2 + r3 + r4 - 3;
}
