package class_two_levels;
// F27: 2-level class hierarchy with method override
class Animal {
    val: i32,
    unsafe fn speak(self: *mut Animal) -> i32 { return self.val; }
}
class Dog extends Animal {
    unsafe fn speak(self: *mut Dog) -> i32 { return self.val * 2; }
    unsafe fn fetch(self: *mut Dog) -> i32 { return self.val + 1; }
}
class Guide extends Dog {
    unsafe fn guide(self: *mut Guide) -> i32 { return self.val * 3; }
}
unsafe fn main() -> i32 {
    let a: *mut Animal = new Animal { val: 5 };
    let d: *mut Dog = new Dog { val: 6 };
    let g: *mut Guide = new Guide { val: 7 };
    let mut r1: i32 = 0; let mut r2: i32 = 0; let mut r3: i32 = 0; let mut r4: i32 = 0;
    unsafe {
        r1 = a.speak();   // 5
        r2 = d.speak();   // 12
        r3 = d.fetch();   // 7
        r4 = g.guide();   // 21
        delete a; delete d; delete g;
    }
    // 5+12+7+21 = 45 - 3 = 42
    return r1 + r2 + r3 + r4 - 3;
}
