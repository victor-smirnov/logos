// A package-local `Vec` with its OWN `IntoIterator for &Vec<T>`: `for x in &v`
// reaches the local impl — the bare key `$ref_Vec__into_iter` is filtered by the
// receiver's declaration, so the stdlib's `&Vec` impl is not a candidate. Twin
// of tests/logos/fail/localvec_for_ref_names_stdlib_as_slice.logos.
package localvec_for_ref_own_into_iter;
use logos.lang.option;
use logos.lang.iter;
pub struct Vec<T> { a: i64, b: i64 }
pub struct VIt { cur: i64, end: i64 }
impl Iterator<i64> for VIt {
    fn next(&mut self) -> Option<i64> {
        if self.cur >= self.end { return Option::None; }
        self.cur = self.cur + 1i64;
        return Option::Some(self.cur);
    }
}
impl<T> IntoIterator<i64> for &Vec<T> {
    type Iter = VIt;
    fn into_iter(self: Self) -> VIt { return VIt { cur: self.a, end: self.b }; }
}
fn main() -> i32 {
    let v: Vec<i64> = Vec { a: 1i64, b: 4i64 };
    let mut t: i64 = 0i64;
    for x in &v { t = t + x; }
    return t as i32;
}
