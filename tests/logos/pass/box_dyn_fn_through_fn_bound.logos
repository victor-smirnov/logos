// Rust's `impl<F: Fn* + ?Sized> Fn* for Box<F>`: a `Box<dyn Fn*>` satisfies an Fn-family bound and
// is called through it (C-OBL builtin + mono's ClosureCall at F = Box<closure>). Matrix 1_39;
// stdout equals rustc 1.98.1. Known residue: the Box block of a Box<dyn FnOnce> consumed through
// a generic FnOnce is not freed (valgrind: 16 bytes).
package box_dyn_fn_through_fn_bound;
use logos.std.fmt;
use logos.mem.boxed;
use logos.mem.string;
struct D { n: i64 }
impl Drop for D { fn drop(&mut self) { println!("drop {}", self.n); } }
fn twice<F: FnMut() -> i64>(mut f: F) -> i64 { f() + f() }
fn once<F: FnOnce() -> String>(f: F) -> String { f() }
fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 { f(x) }
fn main() {
    let mut c: i64 = 0;
    let m: Box<dyn FnMut() -> i64> = Box::new(move || { c += 1; c });
    println!("{}", twice(m));
    let s = String::from("hi");
    let d = D { n: 7 };
    let o: Box<dyn FnOnce() -> String> = Box::new(move || { let _k = &d; s });
    println!("{}", once(o));
    let k = 5;
    let f: Box<dyn Fn(i64) -> i64> = Box::new(move |x| x + k);
    println!("{}", apply(f, 1));
    println!("end");
}
