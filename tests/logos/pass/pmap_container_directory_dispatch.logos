// End-to-end validator of the container-directory dispatch mechanism
// used by std.data.persistent.handle.
//
// The chain under test:
//   1. Process-global block-ops registry (std.data.persistent.bt.registry)
//      — keyed on `block_type_hash = type_hash::<NodeSchema>() ^ cfg_hash`.
//      Populated idempotently by `register_data_container_block_ops::<CFG>`
//      / `register_dir_container_block_ops::<...>` at first allocation.
//   2. Two container roots allocated for two distinct CFGs (different K, V,
//      fanout). Each NodeBase carries a block_type_hash at offset 16 that
//      distinguishes (Leaf vs Branch) × (CFG-A vs CFG-B).
//   3. Dispatched release: read block_type_hash at slot 2 → registry lookup →
//      fn-pointer call. The right monomorphisation fires for each entry
//      (data leaves do not retain children; dir leaves walk their vals as
//      child pointers).

package pmap_container_directory_dispatch;

use std.data.persistent.bt.node;
use std.data.persistent.bt.cow;
use std.data.persistent.bt.registry;
use std.mem;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;
use std.hermes.anyval;

pub const CfgA: HermesStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 16 };
pub const CfgB: HermesStatic = @{ "key": <type:u32>, "value": <type:u32>, "fanout":  8 };

unsafe fn read_block_type_hash(root: *mut u8) -> u64 {
    let p: *mut u64 = (root as i64 + 16i64) as *mut u64;
    return *p;
}

fn main() -> i32 {
    // ── 1. Register block ops for two CFGs in the process-global registry.
    register_data_container_block_ops::<u64, u64, CfgA>();
    register_data_container_block_ops::<u32, u32, CfgB>();
    // Re-registration is idempotent.
    register_data_container_block_ops::<u64, u64, CfgA>();

    // ── 2. Allocate two roots; their block_type_hash slots differ because
    //       cfg_hash gets folded in at alloc time.
    let r_a: *mut NodeBase<u64, u64, CfgA> = node_alloc_c::<u64, u64, CfgA>(0u64, 0u64);
    let r_b: *mut NodeBase<u32, u32, CfgB> = node_alloc_c::<u32, u32, CfgB>(0u64, 0u64);

    let h_a: u64 = unsafe { read_block_type_hash(r_a as *mut u8) };
    let h_b: u64 = unsafe { read_block_type_hash(r_b as *mut u8) };
    if h_a == 0u64 { return 1; }
    if h_b == 0u64 { return 2; }
    if h_a == h_b { return 3; }                    // distinct dispatch keys

    // ── 3. Mock dir: parallel ctr_id / root_ptr_as_u64 vecs.
    let mut dir_ctr_ids: PrimVec<u64> = PrimVec::<u64>::empty();
    let mut dir_roots:   PrimVec<u64> = PrimVec::<u64>::empty();
    dir_ctr_ids.push(101u64);  dir_roots.push(r_a as u64);
    dir_ctr_ids.push(202u64);  dir_roots.push(r_b as u64);

    // ── 4. Walk dir, dispatch release via the process-global registry.
    //       The right monomorphised release thunk fires for each CFG.
    let n: u64 = dir_ctr_ids.len;
    let mut i: u64 = 0u64;
    while i < n {
        let root_u64: u64 = dir_roots.get(i);
        let h: u64 = unsafe { read_block_type_hash(root_u64 as *mut u8) };
        let fp_u64: u64 = block_ops_lookup_release(h);
        if fp_u64 == 0u64 { return 5; }
        unsafe {
            let release: fn(*mut u8) -> () = fp_u64 as fn(*mut u8) -> ();
            release(root_u64 as *mut u8);
        }
        i = i + 1u64;
    }

    return 42;
}
