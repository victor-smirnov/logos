// Writ type-tags — an WAny Ref carries the in-band type code of its pointee
// (obj[-1], Writ1 datatag wire), so a generic walker can dispatch string vs
// array vs map vs inline Pod. Foundation for stringify / binary / parser.
package test;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.hmap;
use logos.lang.writ.hstring;
use logos.lang.str;
fn main() -> i32 {
    let h: Writ = writ_new(512i64);
    let s: &WString = h.hstring("hi");
    let a: &mut WArray<WAny> = h.array(2i64);
    let m: &mut WMap<WString, WAny> = h.map(8i64);
    let vs: WAny = WAny::from(s);
    let va: WAny = WAny::from(&*a);
    let vm: WAny = WAny::from(&*m);
    let vi: WAny = WAny::from(7i56);
    let vb: WAny = WAny::from(true);
    if !vs.is_string() { return 1; }
    if !va.is_array()  { return 2; }
    if !vm.is_map()    { return 3; }
    if !vi.is_i56()    { return 4; }
    if !vb.is_bool()   { return 5; }
    if vs.is_array() || vs.is_map()    { return 6; }
    if va.is_string() || va.is_map()   { return 7; }
    if vi.is_string() || vi.is_array() { return 8; }
    if !str_eq(h.hstring_of(vs).as_str(), "hi") { return 9; }   // readable after tagging
    return 0;
}
