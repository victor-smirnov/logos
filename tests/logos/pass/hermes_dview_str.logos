// DView over strings (datatype String, H2_STRING) in Buffer<DView>: store
// variable-width UTF-8 keys, read back (as_str), and order lexicographically via
// the shared htag_cmp string arm. Exercises the variable-width store with a
// non-scalar, align-1 payload.

package hermes_dview_str;

use logos.lang.cmp;
use logos.lang.fabric;
use logos.lang.str;
use logos.lang.hermes.dview;

fn main() -> i32 {
    let mut b: Buffer<DView> = Buffer::<DView>::new();
    b.push(DView::from_str("banana"));
    b.push(DView::from_str("apple"));
    b.push(DView::from_str("cherry"));
    if b.len() != 3u64 { return 1; }

    // lexicographic order: apple < banana < cherry (via stored views)
    match b.get(1u64).compare(&b.get(0u64)) { Ordering::Less => {} _ => { return 2; } }
    match b.get(0u64).compare(&b.get(2u64)) { Ordering::Less => {} _ => { return 3; } }

    // round-trip: stored bytes equal the literal (byte-compare == Equal)
    match b.get(1u64).compare(&DView::from_str("apple")) { Ordering::Equal => {} _ => { return 4; } }

    // materialize a str from the stored view
    let a: str = b.get(1u64).as_str();
    if a.len() != 5i64 { return 5; }                       // "apple"
    if unsafe { *(a.as_ptr()) } != 97u8 { return 6; }      // 'a'

    // common-prefix length rule: "app" < "apple"
    match DView::from_str("app").compare(&DView::from_str("apple")) { Ordering::Less => {} _ => { return 7; } }

    return 0;
}
