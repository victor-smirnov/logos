// Writ C6: Logos &[T] slice → typed writ array via `as <T>[]` cast.
// The result is an Rc<Writ> whose root is a TypedArray<T>; verify content
// via writ stringify.
package writ_as_array;
use logos.lang.writ.typed_arr;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.mem.writ.stringify;
use logos.lang.rc;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    // Build an i32 slice from a local array and cast to a typed writ array.
    let arr: [i32; 3] = [10, 20, 30];
    let s: &[i32] = &arr;
    let ctr: Rc<Writ> = s as <I32>[];
    let h: &Writ = ctr.deref();
    let root: WAny = h.root();
    if root.is_null() { return 1; }
    if !root.is_ref() { return 2; }
    let text: String = stringify(root);
    if !text.eq_str("<I32> [10, 20, 30]") { return 3; }

    // u64 slice → TypedArray<u64>.
    let arr2: [u64; 2] = [100, 200];
    let s2: &[u64] = &arr2;
    let ctr2: Rc<Writ> = s2 as <U64>[];
    let h2: &Writ = ctr2.deref();
    let root2: WAny = h2.root();
    if root2.is_null() { return 4; }
    if !root2.is_ref() { return 5; }
    let text2: String = stringify(root2);
    if !text2.eq_str("<U64> [100, 200]") { return 6; }

    return 0;
}
