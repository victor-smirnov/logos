// WQL Trama frontend (ADR 0012, peg-frontend Phase 4): the peg_gen_logos-GENERATED
// Trama parser (`logos.std.wql.trama_parser::parse_tpl`) consumes Trama template
// TEXT and produces the **Trama AST** — a Writ-schema tree (category 0x0013, port
// of TplASTCodes: FOR/IF/ELSE/SET/VAR), dogfooding ADR 0011 exactly like the
// Phase-1 IR. Each statement's EXPRESSION attribute holds a Phase-1 `SExpr` IR
// produced by the GENERATED EL parser (the ONLY coupling between the template and
// expression languages).
//
// The generated `parse_tpl` yields the `tpl` as a WArray of per-statement TStmt
// handles (bodies are likewise WArray edges); the `trama!` handler stitches the
// `next`-chain afterwards (T3 post-pass). This test walks the WArray form directly
// and asserts the AST SHAPE (statement KINDS via `schema enum TStmt` + `match`)
// AND that the EXPRESSION holds EL IR (walked via the SExpr edge resolvers).
//
// Coverage:
//   1. "{% for u in users %}{{ u.name }}{% endfor %}" — top = TFor; its body[0] =
//      TVar whose EXPRESSION = `u.name` (a nested SExpr::Field chain).
//   2. "Hi {{ name }}!" — text run, {{ }} var, text run (arr[0..3]).
//   3. "{% if a %}X{% else %}Y{% endif %}" — TIf with then/else bodies (WArrays)
//      + an SExpr condition.
//   4. "{% set x = 1 + 2 %}" — TSet, EXPRESSION = an SExpr::Bin.
//   5. malformed template ("{% for u in users %}…" with no endfor) → null root
//      (the export rejects a non-EOF remainder).
//
// Each numbered failure returns a distinct nonzero exit code.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.el;               // OP_* consts (shared)
use logos.std.wql.trama;            // TStmt schema family
use logos.std.wql.trama_parser;     // parse_tpl — the GENERATED Trama parser

// A body/alt edge (a WArray handle) → its i-th statement, viewed as TStmt.
fn body_at(edge: WRef<TStmt>, i: i64) -> TStmt {
    let a: WAny = edge.any();
    let arr: &WArray<WAny> = a.as_array();
    return arr.get(i).view::<TStmt>();
}
fn body_len(edge: WRef<TStmt>) -> i64 {
    let a: WAny = edge.any();
    let arr: &WArray<WAny> = a.as_array();
    return arr.len();
}

fn main() -> i32 {
    let h: Writ = writ_new(2048i64);

    // ── 1. "{% for u in users %}{{ u.name }}{% endfor %}" ─────────────────
    // Expect: tpl[0] = TFor; body[0] = TVar; TVar.EXPRESSION = SField over SField.
    let r1: WAny = parse_tpl("{% for u in users %}{{ u.name }}{% endfor %}", &h);
    if r1.is_null() { return 1i32; }
    let arr1: &WArray<WAny> = r1.as_array();
    if arr1.len() != 1i64 { return 30i32; }
    let t1: TStmt = arr1.get(0i64).view::<TStmt>();
    match t1 {
        TStmt::For(f) => {
            // the loop iterable is an SExpr (users → a bare field root)
            let it: SExpr = f.expr_expr();
            match it { SExpr::Field(_) => {} _ => { return 2i32; } }
            // body[0] = TVar (the only body statement)
            if body_len(f.body) != 1i64 { return 5i32; }
            let body: TStmt = body_at(f.body, 0i64);
            match body {
                TStmt::Var(v) => {
                    // EXPRESSION holds EL IR: `u.name` = SField(name) over SField(u).
                    let e: SExpr = v.expr_expr();
                    match e {
                        SExpr::Field(fld) => {
                            let base: SExpr = fld.base_expr();
                            match base { SExpr::Field(_) => {} _ => { return 3i32; } }
                        }
                        _ => { return 4i32; }
                    }
                }
                _ => { return 6i32; }
            }
        }
        _ => { return 7i32; }
    }

    // ── 2. "Hi {{ name }}!" — text / var / text sequence ──────────────────
    let r2: WAny = parse_tpl("Hi {{ name }}!", &h);
    if r2.is_null() { return 8i32; }
    let arr2: &WArray<WAny> = r2.as_array();
    if arr2.len() != 3i64 { return 9i32; }
    match arr2.get(0i64).view::<TStmt>() { TStmt::Text(_) => {} _ => { return 15i32; } }
    match arr2.get(1i64).view::<TStmt>() {
        TStmt::Var(v) => {
            let e: SExpr = v.expr_expr();
            match e { SExpr::Field(_) => {} _ => { return 10i32; } }
        }
        _ => { return 14i32; }
    }
    match arr2.get(2i64).view::<TStmt>() { TStmt::Text(_) => {} _ => { return 13i32; } }

    // ── 3. "{% if a %}X{% else %}Y{% endif %}" — TIf with else ────────────
    let r3: WAny = parse_tpl("{% if a %}X{% else %}Y{% endif %}", &h);
    if r3.is_null() { return 16i32; }
    let arr3: &WArray<WAny> = r3.as_array();
    if arr3.len() != 1i64 { return 31i32; }
    match arr3.get(0i64).view::<TStmt>() {
        TStmt::If(iff) => {
            // condition is EL IR
            let c: SExpr = iff.expr_expr();
            match c { SExpr::Field(_) => {} _ => { return 17i32; } }
            // then-body[0] = text run "X"
            match body_at(iff.body, 0i64) { TStmt::Text(_) => {} _ => { return 18i32; } }
            // else-body[0] = text run "Y"
            match body_at(iff.alt, 0i64) { TStmt::Text(_) => {} _ => { return 19i32; } }
        }
        _ => { return 20i32; }
    }

    // ── 4. "{% set x = 1 + 2 %}" — TSet, EXPRESSION = SExpr::Bin ───────────
    let r4: WAny = parse_tpl("{% set x = 1 + 2 %}", &h);
    if r4.is_null() { return 21i32; }
    let arr4: &WArray<WAny> = r4.as_array();
    if arr4.len() != 1i64 { return 32i32; }
    match arr4.get(0i64).view::<TStmt>() {
        TStmt::Set(st) => {
            let e: SExpr = st.expr_expr();
            match e {
                SExpr::Bin(b) => { if b.op != OP_ADD() { return 22i32; } }
                _ => { return 23i32; }
            }
        }
        _ => { return 24i32; }
    }

    // ── 5. malformed: a `for` with no `endfor` → null root ────────────────
    let r5: WAny = parse_tpl("{% for u in users %}{{ u.name }}", &h);
    if !r5.is_null() { return 25i32; }

    return 0i32;
}
