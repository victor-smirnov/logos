// An arm after an unguarded `_` is unreachable: rustc WARNS (`unreachable pattern`) and the program
// runs the `_` arm (exit 1). It was a hard error (ADR 0030 S3 made it the warning).
package match_arm_after_catchall_warns;
fn main() -> i32 {
    let x: i32 = 3;
    match x {
        _ => { return 1; }
        3 => { return 2; }
    }
}
