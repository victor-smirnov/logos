package fn_void_return;
// F10: void functions, side-effect via pointer
unsafe fn add_inplace(p: *mut i32, val: i32) {
    let cur: i32 = *p;
    *p = cur + val;
}
fn main() -> i32 {
    let mut x: i32 = 0;
    unsafe { add_inplace(&mut x, 12); }
    unsafe { add_inplace(&mut x, 30); }
    return x;  // 42
}
