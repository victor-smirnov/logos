// A REBORROW THROUGH A PROJECTION IS STILL A REBORROW. `t` is NOT declared
// `mut` and does not need to be: nothing about `t` is mutated, the `&mut`-ness
// comes from the ELEMENT's type. try_implicit_reborrow_mut (sema_expr.cpp)
// produces `AddrOfTemp(Deref(TupleIndex(t,0)))` here; borrow_check's peel used
// to accept only a bare VarRef terminal, so this fell to the place
// decomposition and was refused "cannot borrow 't.0' as mutable: 't' not
// declared as mut".
// EXCLUSIVITY IS UNCHANGED: fail/bc_tuple_reborrow_mut_alias (two live &mut out
// of one element) and fail/bc_reborrow_tuple_value_elem_fail (a VALUE element,
// where `t` really is mutated) both still refuse.
package bc_reborrow_through_tuple_elem_admit;
struct S { v: i64 }
fn takes(r: &mut S) -> i64 { return r.v; }
fn main() -> i32 {
    let mut s: S = S { v: 1i64 };
    let r: &mut S = &mut s;
    let t: (&mut S, i64) = (r, 1i64);
    if takes(t.0) != 1i64 { return 1i32; }
    return 0i32;
}
