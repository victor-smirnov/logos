package bc_ptrcoerce_mut_to_const_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
fn show(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
static G: i64 = 7i64;
fn raw<'a>(q: *mut &'a i64) -> *const &'a i64 {
    return q;
}
fn main() -> i32 {
    let mut r: &'static i64 = &G;
    let q: *mut &'static i64 = &mut r;
    let p: *const &i64 = raw(q);
    let k: i64 = unsafe { **p };
    show("k=%lld", k);
    return k as i32;
}
