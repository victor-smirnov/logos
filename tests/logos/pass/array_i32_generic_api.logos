// Verifies generic inherent API on Array<T> for T=i32:
// Array<T>::init / push_ptr / get_ptr — no per-type hand-writing.
package array_i32_generic_api;

use hermes.zone;
use hermes.mem_holder;
use hermes.containers;

unsafe fn main() -> i32 {
    let mut zone: Zone<Mutable> = zone_create(4096);
    let arr_raw: *mut u8 = zone_m_alloc_raw(&mut zone, sizeof::<Array<i32>>() as i64);
    let buf_raw: *mut u8 = zone_m_alloc_raw(&mut zone, 16 as i64);
    let arr: *mut Array<i32> =
        Array::<i32>::init(arr_raw, buf_raw, zone.holder.base, 4 as u64);

    let v1: i32 = 10;
    let v2: i32 = 20;
    let v3: i32 = 30;
    arr.push_ptr(zone.holder.base, &v1 as *const i32);
    arr.push_ptr(zone.holder.base, &v2 as *const i32);
    arr.push_ptr(zone.holder.base, &v3 as *const i32);

    let p0: *const i32 = arr.get_ptr(zone.holder.base as *const u8, 0 as u64);
    let p1: *const i32 = arr.get_ptr(zone.holder.base as *const u8, 1 as u64);
    let p2: *const i32 = arr.get_ptr(zone.holder.base as *const u8, 2 as u64);
    let p_oob: *const i32 = arr.get_ptr(zone.holder.base as *const u8, 9 as u64);

    if p_oob != 0 as *const i32 { return 99; }
    return *p0 + *p1 + *p2;  // 60
}
