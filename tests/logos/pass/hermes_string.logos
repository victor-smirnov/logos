package hermes_string;
// Phase 10: HermesString — vlen encoding and UTF-8 string anchored in a zone.

use hermes.zone;
use hermes.string;

unsafe fn main() -> i32 {
    let mut zone: HermesZone = HermesZone::create(4096);

    // --- vlen_encode_size ---
    // Small values (< 249): exactly 1 byte.
    if vlen_encode_size(0 as u64)   != 1 as u32 { return 1; }
    if vlen_encode_size(1 as u64)   != 1 as u32 { return 2; }
    if vlen_encode_size(248 as u64) != 1 as u32 { return 3; }
    // 249: needs 1 byte to represent → marker + 1 = 2 bytes total.
    if vlen_encode_size(249 as u64) != 2 as u32 { return 4; }
    // 255: fits in 1 byte → marker + 1 = 2 bytes.
    if vlen_encode_size(255 as u64) != 2 as u32 { return 5; }
    // 256 (0x100): needs 2 bytes → marker + 2 = 3 bytes.
    if vlen_encode_size(256 as u64) != 3 as u32 { return 6; }

    // --- vlen_write + vlen_read roundtrip (small) ---
    let buf_sm: *mut u8 = zone.alloc_raw(16);
    let w1: u32 = vlen_write(buf_sm, 100 as u64);
    if w1 != 1 as u32                            { return 7; }
    let r1: u64 = vlen_read(buf_sm as *const u8);
    if r1 != 100 as u64                          { return 8; }
    if vlen_prefix_size(buf_sm as *const u8) != 1 as u32 { return 9; }

    // --- vlen_write + vlen_read roundtrip (large: 300 = 0x012C) ---
    // 300 needs 2 bytes → marker 250, then [0x2C, 0x01]; total written = 3.
    let buf_lg: *mut u8 = zone.alloc_raw(16);
    let w2: u32 = vlen_write(buf_lg, 300 as u64);
    if w2 != 3 as u32                            { return 10; }
    let r2: u64 = vlen_read(buf_lg as *const u8);
    if r2 != 300 as u64                          { return 11; }
    if vlen_prefix_size(buf_lg as *const u8) != 3 as u32 { return 12; }

    // --- HermesString: "hello" (5 bytes) ---
    // Write "hello" into a zone buffer (h=104, e=101, l=108, l=108, o=111).
    let text: *mut u8 = zone.alloc_raw(8);
    let tp0: *mut u8 = (text as i64 + 0 as i64) as *mut u8;
    let tp1: *mut u8 = (text as i64 + 1 as i64) as *mut u8;
    let tp2: *mut u8 = (text as i64 + 2 as i64) as *mut u8;
    let tp3: *mut u8 = (text as i64 + 3 as i64) as *mut u8;
    let tp4: *mut u8 = (text as i64 + 4 as i64) as *mut u8;
    *tp0 = 104 as u8;   // 'h'
    *tp1 = 101 as u8;   // 'e'
    *tp2 = 108 as u8;   // 'l'
    *tp3 = 108 as u8;   // 'l'
    *tp4 = 111 as u8;   // 'o'

    // init: 1 byte vlen prefix (len=5, fits < 249) + 5 bytes data = 6 bytes.
    let str_raw: *mut u8 = zone.alloc_raw(6);
    let hs: *mut HermesString = HermesString::init(str_raw, text as *const u8, 5 as u64);

    if hs.len() != 5 as u64                              { return 13; }
    if !hs.equals_bytes(text as *const u8, 5 as u64)     { return 14; }

    // bytes() must point at 'h'.
    let bptr: *const u8 = hs.bytes();
    let first: u8 = *bptr;
    if first != 104 as u8                                 { return 15; }

    // Wrong length → not equal.
    if hs.equals_bytes(text as *const u8, 3 as u64)      { return 16; }

    // hash() must be non-zero for "hello".
    let h: u64 = hs.hash();
    if h == 0 as u64                                      { return 17; }

    // Two calls to hash() on the same content must agree.
    let h2: u64 = hs.hash();
    if h2 != h                                            { return 18; }

    // --- hermes_fnv1a: empty string has the FNV-1a basis ---
    // FNV-1a of empty string = basis = 0xcbf29ce484222325.
    let empty_buf: *mut u8 = zone.alloc_raw(1);
    *empty_buf = 0 as u8;
    let hempty: u64 = hermes_fnv1a(empty_buf as *const u8, 0 as u64);
    // basis = 0xcbf29ce484222325; verify it's non-zero.
    if hempty == 0 as u64                                 { return 19; }

    zone.destroy();
    return 42;
}
