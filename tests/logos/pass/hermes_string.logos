// hermes2 zone strings (successor of the Hermes1 HermesString test):
// hstring allocation, len/as_str, interning across HAny, empty + long strings.
package hermes_string;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.hstring;
use logos.mem.rc;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Hermes2> = hermes2_rc(8192);
    let h: &Hermes2 = rc.deref();

    // --- basic alloc + read-back ---
    let s1: &HString = h.hstring("hello");
    if s1.len() != 5i64 { return 1; }
    if !str_eq(s1.as_str(), "hello") { return 2; }

    // --- empty string ---
    let s2: &HString = h.hstring("");
    if s2.len() != 0i64 { return 3; }

    // --- through HAny: tag + accessor roundtrip ---
    let v: HAny = HAny::from(&*(s1 as *const HString));
    if !v.is_string() { return 4; }
    if h2_type_code(v.resolve()) != H2_STRING { return 5; }
    let s3: &HString = &*(v.resolve() as *const HString);
    if !str_eq(s3.as_str(), "hello") { return 6; }

    // --- a longer string (multi-word payload) ---
    let s4: &HString = h.hstring("the quick brown fox jumps over the lazy dog");
    if s4.len() != 43i64 { return 7; }
    if !str_eq(s4.as_str(), "the quick brown fox jumps over the lazy dog") { return 8; }

    // --- hstring_of: HAny -> &HString helper ---
    let s5: &HString = h.hstring_of(v);
    if !str_eq(s5.as_str(), "hello") { return 9; }

    return 42;
}
