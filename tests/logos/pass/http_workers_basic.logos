// serve_mt_bounded — multi-worker accept loop with round-robin dispatch.
// Server + client fibers on main scheduler.  Worker thread runs the
// connection fiber; response round-trips back through main's reactor.

package test;

use std.io.http;
use std.io.net;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.lang.option;
use logos.lang.result;
use logos.std.rt.fiber;

let TEST_PORT: u16 = 48401 as u16;
let N_CLIENTS: i64 = 8 as i64;
let N_WORKERS: i32 = 4 as i32;

fn handler(req: &Request) -> Response {
    let mut resp: Response = Response::new(200 as i32);
    (&mut resp.headers).append("Content-Length", "2");
    (&mut resp.headers).append("Connection", "close");
    unsafe {
        let bp: *mut Vec<u8> = &resp.body as *const Vec<u8> as *mut Vec<u8>;
        bp.push(111 as u8);   // 'o'
        bp.push(107 as u8);   // 'k'
    }
    return resp;
}

struct ServerArg {
    pool_out: *mut i64,
    svc:      *mut FnService,
}

fn server_fiber(arg: i64) {
    let a: *mut ServerArg = arg as *mut ServerArg;
    let svc: *mut FnService = unsafe { a.svc };
    let pool_out: *mut i64  = unsafe { a.pool_out };
    let pool: *mut ThreadPool =
        serve_mt_bounded(TEST_PORT, N_WORKERS, N_CLIENTS, unsafe { &mut *svc });
    unsafe { *pool_out = pool as i64; }
}

fn client_fiber(arg: i64) {
    let rp: *mut i64 = arg as *mut i64;
    let ip: u32 = ip4(127 as u32, 0 as u32, 0 as u32, 1 as u32);
    match http_get_at(ip, TEST_PORT, "localhost", "/") {
        Result::Ok(resp) => {
            if resp.status != 200 as i32 { unsafe { *rp = 0 - 1 as i64; } return; }
            unsafe {
                let bp: *mut Vec<u8> = &resp.body as *const Vec<u8> as *mut Vec<u8>;
                if bp.length() != 2 as i64 { *rp = 0 - 2 as i64; return; }
                if bp.get(0 as i64) != 111 as u8 { *rp = 0 - 3 as i64; return; }
                if bp.get(1 as i64) != 107 as u8 { *rp = 0 - 4 as i64; return; }
                *rp = 1 as i64;
            }
        }
        Result::Err(_) => { unsafe { *rp = 0 - 10 as i64; } }
    }
}

unsafe fn main() -> i32 {
    let s: *mut Scheduler = sched_new();
    sched_set_current(s);
    let r: *mut Reactor = reactor_new(128);
    if r == 0 as *mut Reactor { return 1; }
    reactor_set_current(r);

    let mut results:   [i64; 8] = [0 as i64; 8];
    let mut pool_slot: [i64; 1] = [0 as i64; 1];
    let mut svc: FnService = fn_service(handler);
    let mut sa: ServerArg = ServerArg {
        pool_out: &mut pool_slot[0 as i64] as *mut i64,
        svc:      &mut svc as *mut FnService,
    };
    spawn(server_fiber, &mut sa as *mut ServerArg as i64);

    let mut i: i64 = 0 as i64;
    while i < N_CLIENTS {
        let rp: i64 = &mut results[i] as *mut i64 as i64;
        spawn(client_fiber, rp);
        i = i + 1;
    }
    reactor_run(s, r);

    // All fibers drained.  Safe to block on join now: no fiber on this
    // scheduler is waiting on a CQE.
    let pool: *mut ThreadPool = pool_slot[0 as i64] as *mut ThreadPool;
    if pool != 0 as *mut ThreadPool {
        thread_pool_join(pool);
        thread_pool_free(pool);
    }

    reactor_free(r);
    sched_free(s);

    let mut ok: i64 = 0 as i64;
    i = 0 as i64;
    while i < N_CLIENTS {
        if results[i] == 1 as i64 { ok = ok + 1; }
        i = i + 1;
    }
    if ok == N_CLIENTS { return 42; }
    return ok as i32;
}
