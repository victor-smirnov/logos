package expr_bug_float_arr_lit;
// Bug fix: float array literals and fill should coerce FloatLit to f32 elem type

fn main() -> i32 {
    let a: [f32; 3] = [1.5, 2.5, 3.5];
    let b: [f32; 3] = [0.0; 3];
    let sum: f32 = a[0] + a[1] + a[2] + b[0];
    // 1.5+2.5+3.5+0.0 = 7.5, as i32 = 7, 7+35 = 42
    return sum as i32 + 35;
}
