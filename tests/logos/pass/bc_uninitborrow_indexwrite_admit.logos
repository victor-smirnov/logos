// PAIR of bc_uninitborrow_indexwrite_refuse, one token apart: `f` carries its
// initialiser, the overloaded index write runs, and the value is read back.
package bc_uninitborrow_indexwrite_admit;
struct I { v: i64 }
impl Index<i64, i64> for I { fn index(self: &I, i: i64) -> &i64 { return &self.v; } }
impl IndexMut<i64, i64> for I { fn index_mut(self: &mut I, i: i64) -> &mut i64 { return &mut self.v; } }
fn main() -> i32 {
    let mut f: I = I { v: 0i64 };
    f[0i64] = 3i64;
    return f.v as i32;
}
