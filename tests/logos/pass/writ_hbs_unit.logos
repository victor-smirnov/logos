// Writ HBS — binary round-trip: doc → bytes → doc. Array (order-deterministic,
// compared via stringify) + map (compared via key lookups, since bucket order may
// differ on reconstruction).
package test;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.wmap;
use logos.lang.writ.wstring;
use logos.mem.writ.wbs;
use logos.mem.writ.stringify;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.lang.str;
fn main() -> i32 {
    let h1: Writ = writ_new(2048i64);
    // nested array doc
    let inner: &mut WArray<WAny> = h1.array(2i64);
    inner.push(10i64); inner.push(20i64);
    let a: &mut WArray<WAny> = h1.array(8i64);
    a.push(1i64); a.push(2i64); a.push(&*inner); a.push("hi"); a.push(true);
    let orig: WAny = WAny::from(&*a);
    let s1: String = stringify(orig);
    let bytes: Vec<u8> = wbs_write(orig);
    let h2: Writ = writ_new(2048i64);
    let doc2: WAny = wbs_read(&h2, bytes.as_slice().as_ptr(), bytes.len());
    if !str_eq(s1.as_str(), stringify(doc2).as_str()) { return 1; }

    // map doc → round-trip → verify via lookups (order-independent)
    let m: &mut WMap<WString, WAny> = h1.map(8i64);
    m.set("n", 42i64); m.set("ok", true); m.set("name", "Ada");
    let nested: &mut WArray<WAny> = h1.array(2i64); nested.push(7i64); nested.push(8i64);
    m.set("xs", &*nested);
    let mb: Vec<u8> = wbs_write(WAny::from(&*m));
    let h3: Writ = writ_new(2048i64);
    let md: WAny = wbs_read(&h3, mb.as_slice().as_ptr(), mb.len());
    let m2: &WMap<WString, WAny> = unsafe { &*(md.resolve() as *const WMap<WString, WAny>) };
    if m2.len() != 4i64 { return 2; }
    if m2.get("n").as_i56() != 42i64 { return 3; }
    if m2.get("ok").as_bool() != true { return 4; }
    if !str_eq(h3.wstring_of(m2.get("name")).as_str(), "Ada") { return 5; }
    let xs: &WArray<WAny> = unsafe { &*(m2.get("xs").resolve() as *const WArray<WAny>) };
    if xs.len() != 2i64 { return 6; }
    if xs.get(0i64).as_i56() != 7i64 { return 7; }
    if xs.get(1i64).as_i56() != 8i64 { return 8; }
    return 0;
}
