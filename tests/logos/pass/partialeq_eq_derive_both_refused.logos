// Closed squeue partialeq_eq_derive_both_refused (#682): Eq is a marker over PartialEq (Rust's shape): #[derive_partial_eq] + #[derive_eq] no longer declare eq twice; exit 0 as rustc.
package partialeq_eq_derive_both_refused;
use logos.std.compiler.metaprog;
use logos.lang.cmp;
#[derive_partial_eq]
#[derive_eq]
struct Pt { x: i64, y: i64 }
fn main() -> i32 {
    let a = Pt { x: 1, y: 2 };
    let b = Pt { x: 1, y: 2 };
    if !(a == b) { return 3; }
    return 0;
}
