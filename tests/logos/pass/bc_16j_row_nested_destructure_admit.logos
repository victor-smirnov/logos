// hand battery: round 2026-09-16j-arrpath2, program bc_16j_row_nested_destructure_admit — caught: a nested struct sub-pattern under an array element recorded NO move path, so the array's scope-exit drop destroyed the moved-out field a SECOND time (n=112, rustc 12)
// Was soundness_queue row `match_array_nested_destructure_elem_double_drop`, CLOSED by this round. The row leaving IS the record of the fix: the
// queue gate went RED on this program ("NO LONGER REPRODUCES — want run=1, read run=0"), the row was
// deleted, `# TOTAL` re-derived by direct listing, and the program landed here in the same commit.
// Expected exit and destructor trace MEASURED against a rustc 1.98.1 twin. The COUNT is the oracle:
// n = n*10 + v per D::drop, so a leak reads SHORT and a double destructor reads LONG; rc alone cannot
// tell those apart, and valgrind is blind to both over an i64 counter.
package bc_16j_row_nested_destructure_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct W { a: D, b: D }
fn g(p: *mut i64) -> i64 {
    let arr: [W; 1] = [W { a: D { v: 1i64, c: p }, b: D { v: 2i64, c: p } }];
    match arr {
        [W { a: x, b: _ }] => { return x.v; }
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    let got: i64 = unsafe { n };
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 1i64 { return 2i32; }
    if got != 12i64 { return 1i32; }
    return 0i32;
}
