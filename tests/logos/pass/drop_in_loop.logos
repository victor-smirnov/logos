// Test: Droppable var created inside loop body, dropped each iteration
package drop_in_loop;

extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: *const u8, v: i32) { unsafe { printf(fmt, v); } }

trait Drop {
    fn drop(self: Self);
}

struct Resource {
    id: i32,
}

impl Drop for Resource {
    fn drop(self: Resource) {
        printi("d%d ", self.id);
    }
}

unsafe fn main() -> i32 {
    let result: i32 = 42;
    for i in 0..3 {
        let r: Resource = Resource { id: i };
        printi("a%d ", r.id);
    }
    return result;
}
