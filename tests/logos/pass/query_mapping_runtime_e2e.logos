// query_mapping_runtime_e2e — a `mapping` item CONSUMED (ADR 0016: mappings are
// STATIC-ONLY items).
//
// ⚠ P5 — THIS FIXTURE'S ORIGINAL SUBJECT IS GONE, AND THE FILE IS KEPT FOR WHAT
// IS LEFT, NOT PRETENDED WHOLE. It was written for the DYNAMIC consumer: the
// `mapping` item emits `<M>__rules()` (canonical rel-list text) and `<M>__src()`
// (its source-param name), and `Query::compile_with_mapping` fused them into
// runtime query text with the same parser + rename machinery the static path
// uses; the assertion was PARITY between that and the static twin. P5 deleted
// `Query`, so there is no second consumer to have parity WITH, and the emitted
// `__rules()`/`__src()` artifacts lose their only reader — their byte-level pin
// lives on in `tests/logos/pass/wql_mapping_rules_escape_e2e.logos` §A, which is
// where that claim is now sensed and where the same P5 loss is written down.
//
// What is asserted here now is the STATIC consumption path — a `deem` whose
// source parameter is a `mapping` type — against hand-derived answers rather
// than against the other tier: the document has exactly two `.engine` leaves and
// their values are "pg" and "redis". Exit codes 2 and 3 named the dynamic arm and
// are retired, not reused.
package test;

use logos.lang.writ.container;
use logos.mem.writ.parser;
use logos.std.wql.wql;
use logos.std.wql.mapping_item;
use logos.mem.collections.vec;
use logos.lang.str;
use logos.std.io;

pub mapping Net(g: &Writ) {
    pub rel engine(owner: i64, name: str) {
        from g ** .engine e select (e.parent, e.vs);
    }
}

pub deem s_engines(w: Net) {
    from engine e select e.name
}

fn has(v: &Vec<str>, s: str) -> bool {
    let mut i: i64 = 0i64;
    while i < v.len() { if str_eq(v.get(i), s) { return true; } i = i + 1i64; }
    return false;
}

fn main() -> i32 {
    let doc: Writ = parse_writ(r#"{ db: { engine: "pg" }, cache: { engine: "redis" } }"#);

    let st: Vec<str> = match s_engines(&doc)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };

    if st.len() != 2i64 { return 4i32; }
    if !has(&st, "pg") { return 5i32; }
    if !has(&st, "redis") { return 6i32; }
    // the mapping's emitted artifacts, still asserted at this seam
    if !str_eq(Net__src(), "g") { return 7i32; }

    return 0i32;
}
