package layout_clike_enum_backing;
// A C-LIKE ENUM IS ITS DISCRIMINANT, SIZED BY ITS BACKING TYPE — IN EVERY
// ENGINE, AT EVERY WIDTH, THROUGH EVERY INSTANTIATION. MEASURED, NOT CLAIMED.
//
// `Mono::mono_enum_layout` ran payload → `classify_niche` → `tagged_enum`
// unconditionally: it never read `EnumView::backing_type`. Sema had that branch
// and mlir-gen had it, so for `enum B : u64` sema and mlir-gen said {8,8} and
// mono said {4,4}. Mono's number is the byte offset of a DstRef PREFIX FIELD at
// the re-lowering site, so with
//
//   struct I<T: ?Sized> { h: B64, k: u8, val: T }
//   struct R<T: ?Sized> { inner: *mut I<T> }
//
// the generic `?Sized` method wrote `k` at byte 4 — INSIDE the eight-byte
// discriminant — while the sized instantiation of the SAME method wrote it at
// byte 8. MEASURED before the fix, by scanning the allocation for the byte that
// changed: sized 8, dyn 4, `offset_of!` claiming 8.
//
// Two more of the same class were found with it, both by the ENGINE × SHAPE
// matrix in `layout_engine_agreement_gate.sh`:
//
//   * `clone_enum_def` dropped BACKING_TYPE on generic instances, so
//     `sizeof::<GT<i32>>()` was 4 for an eight-byte type while `offset_of!` —
//     sema, resolving the TEMPLATE — still claimed 8 for the field after it;
//   * every post-mono lookup of an enum DECLARATION used the BARE name, which
//     after mono resolves nothing for a generic enum (only `GT__i32` exists), so
//     the backing type was silently the default i32.
//
// The oracle here is MEMORY. Each row writes one byte through one path and
// scans a zeroed allocation for it; the two paths are compared to EACH OTHER
// first — a comparison no engine takes part in — and to `offset_of!` second.
//
// The general form (every backing width, generic and not) is generated by
// `layout_lattice_gen.py`; this fixture pins the measured rows in the suite.

extern fn malloc(n: i64) -> *mut u8;

enum B64 : u64 { X, Y }
enum B8  : u8  { P, Q }
enum BD        { M, N }      // no backing clause — the default i32 disc
enum G64<T> : u64 { X, Y }   // generic: the backing must survive mono

trait Tr { fn v(&self) -> i64; }
struct A { x: i64 }
impl Tr for A { fn v(&self) -> i64 { return self.x; } }

struct I64H<T: ?Sized> { h: B64, k: u8, val: T }
struct I8H <T: ?Sized> { h: B8,  k: u8, val: T }
struct IDH <T: ?Sized> { h: BD,  k: u8, val: T }
struct R64<T: ?Sized> { inner: *mut I64H<T> }
struct R8 <T: ?Sized> { inner: *mut I8H<T> }
struct RD <T: ?Sized> { inner: *mut IDH<T> }

impl<T: ?Sized> R64<T> { fn setk(&mut self, v: u8) { unsafe { self.inner.k = v; } } }
impl<T: ?Sized> R8<T>  { fn setk(&mut self, v: u8) { unsafe { self.inner.k = v; } } }
impl<T: ?Sized> RD<T>  { fn setk(&mut self, v: u8) { unsafe { self.inner.k = v; } } }

struct GH<T> { pub h: G64<T>, pub k: u8, pub v: i64 }

unsafe fn zeroed(n: i64) -> *mut u8 {
    let raw: *mut u8 = malloc(n);
    let mut i: i64 = 0;
    while i < n { *(raw.add(i)) = 0u8; i = i + 1; }
    return raw;
}
// Where did the write REALLY land? No engine is asked.
unsafe fn scan(raw: *mut u8, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n { if *(raw.add(i)) == 171u8 { return i; } i = i + 1; }
    return -1;
}

unsafe fn main() -> i32 {
    // ── u64-backed: the width at which mono was four bytes short ────────────
    {
        let ra: *mut u8 = zeroed(128i64);
        let mut rs: R64<A> = R64::<A> { inner: ra as *mut I64H<A> };
        rs.setk(171u8);
        let sized_at: i64 = scan(ra, 128i64);

        let rb: *mut u8 = zeroed(128i64);
        let rq: R64<A> = R64::<A> { inner: rb as *mut I64H<A> };
        let mut rd: R64<dyn Tr> = rq as R64<dyn Tr>;
        rd.setk(171u8);
        let dyn_at: i64 = scan(rb, 128i64);

        // TWO MEASUREMENTS, NO ENGINE: the same field, two lowerings.
        if sized_at != dyn_at { return 1i32; }
        // …and the claim.
        if dyn_at != offset_of!(I64H<A>, k) as i64 { return 2i32; }
        // `h` is EIGHT bytes, so `k` cannot be at 4.
        if dyn_at != 8i64 { return 3i32; }
    }
    // ── u8-backed: the same law in the other direction ──────────────────────
    {
        let ra: *mut u8 = zeroed(128i64);
        let mut rs: R8<A> = R8::<A> { inner: ra as *mut I8H<A> };
        rs.setk(171u8);
        let sized_at: i64 = scan(ra, 128i64);

        let rb: *mut u8 = zeroed(128i64);
        let rq: R8<A> = R8::<A> { inner: rb as *mut I8H<A> };
        let mut rd: R8<dyn Tr> = rq as R8<dyn Tr>;
        rd.setk(171u8);
        let dyn_at: i64 = scan(rb, 128i64);

        if sized_at != dyn_at { return 4i32; }
        if dyn_at != offset_of!(I8H<A>, k) as i64 { return 5i32; }
        if dyn_at != 1i64 { return 6i32; }
    }
    // ── no backing clause: the default i32 disc, the width at which a missing
    //    branch and a correct one agree — which is why it proves nothing alone.
    {
        let ra: *mut u8 = zeroed(128i64);
        let mut rs: RD<A> = RD::<A> { inner: ra as *mut IDH<A> };
        rs.setk(171u8);
        let sized_at: i64 = scan(ra, 128i64);

        let rb: *mut u8 = zeroed(128i64);
        let rq: RD<A> = RD::<A> { inner: rb as *mut IDH<A> };
        let mut rd: RD<dyn Tr> = rq as RD<dyn Tr>;
        rd.setk(171u8);
        let dyn_at: i64 = scan(rb, 128i64);

        if sized_at != dyn_at { return 7i32; }
        if dyn_at != offset_of!(IDH<A>, k) as i64 { return 8i32; }
        if dyn_at != 4i64 { return 9i32; }
    }
    // ── the backing type survives MONOMORPHISATION ──────────────────────────
    {
        if sizeof::<G64<i32>>() as i64 != sizeof::<B64>() as i64 { return 10i32; }
        if sizeof::<G64<i32>>() as i64 != 8i64 { return 11i32; }
        let ra: *mut u8 = zeroed(128i64);
        let p: *mut GH<i32> = ra as *mut GH<i32>;
        p.k = 171u8;
        if scan(ra, 128i64) != offset_of!(GH<i32>, k) as i64 { return 12i32; }
        if scan(ra, 128i64) != 8i64 { return 13i32; }
    }
    return 0i32;
}
