// `char` is a 4-byte Unicode scalar (Rust-style); `'X'` is a char literal.
// Distinct from u32 — explicit cast required. Lifetimes (`'a`) still
// parse correctly because the lexer peeks for the closing apostrophe.
// 2026-09-09: the incidental lifetime scaffold fed `&x` of a fn-LOCAL into a
// `Borrowed<'static>` slot (E0597 in rustc). Sixth fixture of the class
// `8a37797f0` repaired on 2026-09-02 the same way and for the same reason —
// the source is now a `static` item, so the &'static is genuine. Every char
// assertion below is untouched; only the borrow's SOURCE moved.
package char_literal;

static X: i32 = 7;

struct Borrowed<'a> { p: &'a i32 }

fn upper(c: char) -> char { return c; }

fn main() -> i32 {
    let a: char = 'A';                      // 65
    let nl: char = '\n';                    // 10
    let bs: char = '\\';                    // 92
    let q:  char = '\'';                    // 39
    let z:  char = '\0';                    // 0
    let _b: char = upper(a);

    // Cast char→u32 (no-op) and char→u8 (truncating).
    let n: u32 = a as u32;
    let bv: u8 = a as u8;

    // Lifetime tokens still work alongside char literals.
    let r: Borrowed<'static> = Borrowed { p: &X };

    return (n as i32) + (bv as i32) + (nl as u32 as i32) +
           (bs as u32 as i32) + (q as u32 as i32) + (z as u32 as i32) + *r.p;
    // 65 + 65 + 10 + 92 + 39 + 0 + 7 = 278; 278 mod 256 = 22
}
