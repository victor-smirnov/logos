// `quote_ty! { ($t1, $t2) }` and `quote_ty! { [$t; N] }` — antiquot in
// tuple- and array-type positions, lowered to __tuple_type_apply__ /
// __array_type_apply__. MP3 sibling slice.

package meta_quote_ty_tup_arr_probe;

use std.compiler.metaprog;

unsafe fn main() -> i32 {
    let ti = type_of::<i32>();
    let tb = type_of::<bool>();
    let tu = type_of::<u8>();

    // Pure antiquot tuple.
    let p1 = quote_ty! { ($ti, $tb) };
    let direct2 = type_of::<(i32, bool)>();
    if p1.uid != direct2.uid { return 1; }

    // Mixed tuple: literal + antiquot.
    let p2 = quote_ty! { (i32, $tb) };
    if p2.uid != direct2.uid { return 2; }

    // Three-elem tuple, mixed.
    let p3 = quote_ty! { ($ti, bool, $tu) };
    let direct3 = type_of::<(i32, bool, u8)>();
    if p3.uid != direct3.uid { return 3; }

    // Array antiquot.
    let a1 = quote_ty! { [$ti; 4] };
    let direct_a = type_of::<[i32; 4]>();
    if a1.uid != direct_a.uid { return 4; }

    // No antiquots — falls back to original quote_ty! path.
    let p4 = quote_ty! { (i32, bool) };
    if p4.uid != direct2.uid { return 5; }

    let a2 = quote_ty! { [i32; 4] };
    if a2.uid != direct_a.uid { return 6; }

    return 0;
}
