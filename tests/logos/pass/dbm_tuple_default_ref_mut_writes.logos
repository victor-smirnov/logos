// PAIR (pass half) with fail/dbm_tuple_default_shared_write_refused, ONE TOKEN
// apart: `&mut t` here, `&t` there. Closes soundness-queue row
// match_tuple_copy_elem_no_default_mut_ref. Under a `&mut` scrutinee the default
// binding mode is `ref mut`, so `a : &mut i64` and the write lands in `t`.
// Spec pat.binding.default-by-ref-mode; PROBES.md 2026-09-06j.
package dbm_tuple_default_ref_mut_writes;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
fn main() -> i32 {
    let mut t: (i64, i64) = (3i64, 4i64);
    match &mut t {
        (a, b) => { *a = *a + 1i64; if *b != 4i64 { return 2i32; } }
    }
    printi("%ld\n", t.0);
    printi("%ld\n", t.1);
    if t.0 != 4i64 { return 1i32; }
    return 0i32;
}
