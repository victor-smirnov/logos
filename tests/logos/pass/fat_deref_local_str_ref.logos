// Fat-element deref class, local-reference siblings: `*(&str_local)`,
// `**(&&str)` (outer deref has fat pointee), and ASSIGN (not let) from a
// deref. All must treat `*p` over a fat {ptr,len} pointee as a no-op
// reinterpret (str value = pointer-to-pair), never an 8-byte load.
package test;
use logos.lang.str;

fn main() -> i32 {
    // *(&str_local) via a named ref and inline
    let a: str = "hello";
    let r = &a;
    let b: str = *r;
    if !str_eq(b, "hello") { return 1i32; }
    let c: str = *(&a);
    if !str_eq(c, "hello") { return 2i32; }
    // &&str: inner deref pointee is a thin &str (8B load — correct);
    // outer deref pointee is the fat str (no-op).
    let rr = &r;
    let d: str = **rr;
    if !str_eq(d, "hello") { return 3i32; }
    // assign-from-deref: RHS deref yields the pair pointer; the assign
    // memcpys the 16-byte pair (independent copy — source unclobbered).
    let mut s: str = "other";
    s = *r;
    if !str_eq(s, "hello") { return 4i32; }
    if !str_eq(a, "hello") { return 5i32; }
    return 0i32;
}
