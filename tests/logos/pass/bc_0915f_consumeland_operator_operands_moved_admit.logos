// CLOSED soundness_queue row byvalue_operator_operand_not_moved_double_drop (tier 1), round 2026-09-15f-consumeland.
// A BY-VALUE OPERATOR OVERLOAD MOVES ITS OPERANDS. `impl Add for A { fn add(self: A, o: A) -> i64 }` and `s = a + b;` over two
// droppable locals: the callee owns and drops both parameters (1 + 1000) and the caller's scope exit must not drop them again.
// It read 2002 (each operand destroyed twice): SemaChecker::lower_binop's push_operand handed a by-value operand to the call and
// recorded no move. It now calls mark_moved_expr on a move-type by-value operand, as TUPLE_LIT / call arguments already do; the same
// decision at lower_unary (Neg / Not) and at lower_compound_assign / lower_place_compound_assign (*Assign rhs) landed with it.
// The destructor COUNT is the oracle: 1001, exit 0. Fail twin: bc_0915f_consumeland_operator_operands_moved_refuse (reads `a` after).
// rustc 1.98.1 --edition 2024 on the twin src/compiler/probes/2026-09-15f-consumeland/rust/closed_operator_operands_moved_admit.rs: compiles, runs, n=1001.
package bc_0915f_consumeland_operator_operands_moved_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
struct A { v: i64, c: *mut i64 }
impl Drop for A { fn drop(self: &mut A) { unsafe { *self.c = *self.c + self.v; } } }
impl Add for A { type Output = i64; fn add(self: A, o: A) -> i64 { return self.v + o.v; } }

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut s: i64 = 0i64;
    {
        let a: A = A { v: 1i64, c: p };
        let b: A = A { v: 1000i64, c: p };
        s = a + b;
    }
    if s != 1001i64 { return 2i32; }
    let got: i64 = unsafe { n };
    unsafe { printf("n=%ld\n".as_ptr(), got); }
    if got != 1001i64 { return 1i32; }
    return 0i32;
}
