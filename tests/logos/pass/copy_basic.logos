package copy_basic;
// Copy trait: types implementing Copy are not move-only.
// Assignment and passing by value keep the original usable.
extern fn printf(fmt: *const u8, ...) -> i32;
fn printii(fmt: *const u8, a: i32, b: i32) { unsafe { printf(fmt, a, b); } }

trait Copy {}

struct Vec2 { x: i32; y: i32; }
impl Copy for Vec2 {}

fn dot(a: Vec2, b: Vec2) -> i32 { return a.x * b.x + a.y * b.y; }

fn main() -> i32 {
    let u = Vec2 { x: 1, y: 2 };
    let v = Vec2 { x: 3, y: 4 };
    let d1 = dot(u, v);   // u, v are Copy — not consumed
    let d2 = dot(u, v);   // still usable
    printii("%d %d\n", d1, d2);
    return 0;
}
