// Tests std.data.persistent.map — handle creation, insert, find, drop.
package test;

use std.data.persistent.uid256;
use std.data.persistent.map;
use std.lang.cmp;
use std.lang.datatypes;

fn main() -> i32 {
    let a: UID256 = uid256_random();
    let b: UID256 = uid256_random();
    let c: UID256 = uid256_random();

    let mut m: PMap<UID256, UID256> = map_new::<UID256, UID256>();

    if map_len::<UID256, UID256>(&m) != 0u64 { return 1; }
    if map_contains::<UID256, UID256>(&m, &a as *const UID256) { return 2; }

    map_insert_new::<UID256, UID256>(&mut m, &a as *const UID256, &a as *const UID256);
    map_insert_new::<UID256, UID256>(&mut m, &b as *const UID256, &b as *const UID256);
    map_insert_new::<UID256, UID256>(&mut m, &c as *const UID256, &c as *const UID256);

    if map_len::<UID256, UID256>(&m) != 3u64 { return 3; }
    if !map_contains::<UID256, UID256>(&m, &a as *const UID256) { return 4; }
    if !map_contains::<UID256, UID256>(&m, &b as *const UID256) { return 5; }
    if !map_contains::<UID256, UID256>(&m, &c as *const UID256) { return 6; }

    if map_find::<UID256, UID256>(&m, &a as *const UID256) != 0i64 { return 7; }
    if map_find::<UID256, UID256>(&m, &b as *const UID256) != 1i64 { return 8; }
    if map_find::<UID256, UID256>(&m, &c as *const UID256) != 2i64 { return 9; }

    let miss: UID256 = uid256_random();
    if map_contains::<UID256, UID256>(&m, &miss as *const UID256) { return 10; }

    map_drop::<UID256, UID256>(&mut m);

    return 42;
}
