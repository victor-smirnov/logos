// CP-cm-08b (b) — tuple `==` for nested-tuple fields via Eq blanket.
//
// Previously: outer spec's body emitted a recursive call with the
// outer's type_args (e.g. ((i32,i32), bool) — stale for the inner
// call), so mono didn't generate a fresh inner spec — the body
// infinite-recursed into the outer symbol → stack overflow.
//
// Fix: in mono_clone.cpp's MethodCall path, when the receiver
// unwraps to a Tuple, REPLACE nc.type_args with the receiver
// tuple's element types (previous code only injected when empty).

package tuple_eq_nested;

use std.lang.cmp;

fn main() -> i32 {
    let a: ((i32, i32), bool) = ((1i32, 2i32), true);
    let b: ((i32, i32), bool) = ((1i32, 2i32), true);
    let c: ((i32, i32), bool) = ((1i32, 3i32), true);
    let d: ((i32, i32), bool) = ((1i32, 2i32), false);

    if !(a == b) { return 1i32; }
    if a == c    { return 2i32; }
    if a == d    { return 3i32; }

    // Three-deep nesting.
    let p: ((i32, (i32, i32)), bool) = ((1i32, (2i32, 3i32)), true);
    let q: ((i32, (i32, i32)), bool) = ((1i32, (2i32, 3i32)), true);
    let r: ((i32, (i32, i32)), bool) = ((1i32, (2i32, 4i32)), true);
    if !(p == q) { return 4i32; }
    if p == r    { return 5i32; }

    return 0i32;
}
