package match_negative_int;
// Edge case: negative values hitting match arms — wildcard catches negatives
// (negative literal patterns like -1 => are not supported; test behavior instead)

fn check(n: i32) -> i32 {
    match n {
        42 => { return 1; }
        0  => { return 2; }
        _  => { return 3; }   // negative values land here
    }
}

unsafe fn main() -> i32 {
    let a: i32 = check(0 - 1);  // -1 → wildcard → 3
    let b: i32 = check(42);     // exact match  → 1
    let c: i32 = check(0);      // exact match  → 2
    // (3 + 1 + 2) * 7 = 42
    return (a + b + c) * 7;
}
