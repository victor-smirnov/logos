// #437: `set_root` refuses a Ref into another container — `root()` would hand it back with this
// container's region, and `hold`'s projection `w.array_of(w.root())` would leave the held arena.
package writ_foreign_root_refused;
use logos.lang.writ.container;
use logos.lang.writ.array;
use logos.lang.writ.anyval;
fn main() -> i32 {
    let a: Writ = writ_new(256i64);
    let b: Writ = writ_new(256i64);
    let arr: &mut WArray<WAny> = b.array(4i64);
    let e: WAny = unsafe { WAny::ref_to(arr as *const WArray<WAny> as *const u8) };
    a.set_root(e);
    return 0i32;
}
