// DView: non-owning type-erased Hermes view. Erase concrete values (i64/u64/
// bool) into views, type-check (is), extract (as/to), and compare via the
// shared tag-keyed capability layer. No owning container, no allocation.

package hermes_dview_smoke;

use logos.lang.cmp;
use logos.lang.option;
use logos.lang.hermes.dview;

fn main() -> i32 {
    let a: i64 = 5i64;
    let b: i64 = -3i64;
    let va: DView = DView::from(&a);
    let vb: DView = DView::from(&b);

    // type-check + extract
    if !va.is_a::<i64>() { return 1; }
    if va.is_a::<u64>()  { return 2; }
    if va.to::<i64>() != 5i64 { return 3; }
    match va.try_to::<i64>() { Option::Some(x) => { if x != 5i64 { return 4; } } Option::None => { return 5; } }
    match va.try_to::<u64>() { Option::Some(_) => { return 6; } Option::None => {} }

    // signed ordering through the shared layer
    match va.compare(&vb) { Ordering::Greater => {} _ => { return 7; } }
    match vb.compare(&va) { Ordering::Less    => {} _ => { return 8; } }

    // u64 (unsigned) + bool
    let c: u64 = 10u64;
    let d: u64 = 10u64;
    if DView::from(&c).compare(&DView::from(&d)) as i32 != Ordering::Equal as i32 { return 9; }

    let f: bool = false;
    let t: bool = true;
    match DView::from(&f).compare(&DView::from(&t)) { Ordering::Less => {} _ => { return 10; } }

    // tag = (space:8, code:56). A captured i64's tag is Hermes-space, code H2_I64.
    if dv_space(va.type_code()) != DV_SPACE_HERMES { return 11; }
    if dv_code(va.type_code()) != 26u64 { return 12; }   // H2_I64
    // pack/unpack a Logos-space tag (e.g. captured heap String, code 130) —
    // distinct space, code preserved, no collision with the 56-bit code.
    let lt: u64 = dv_make_tag(DV_SPACE_LOGOS, 130u64);
    if dv_space(lt) != DV_SPACE_LOGOS { return 13; }
    if dv_code(lt)  != 130u64 { return 14; }
    if lt == 130u64 { return 15; }   // the space byte makes it != the raw code

    return 0;
}
