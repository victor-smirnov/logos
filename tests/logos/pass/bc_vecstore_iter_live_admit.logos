package bc_vecstore_iter_live_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
fn show(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    let mut w: Vec<i64> = Vec::new();
    v.push(1i64); v.push(2i64);
    w.push(3i64); w.push(4i64);
    for x in w.iter() {
        v[0u64] = *x;
    }
    let k: i64 = v[0u64];
    show("k=%lld", k);
    return k as i32;
}
