// `if let Some(W { b: bb, k }) = o { read }` drops bb once PROBES.md 2026-09-06d: `if let` / `while let` / let-chains lower BY DELEGATION to lower_match (temp hoist, per-arm scrutinee move, arm drops, cond-move merge); the count is a destructor tally through a raw pointer.
package bc_patown_iflet_nested_struct_sub;

struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
struct W { b: S, k: i64 }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let o: Option<W> = Option::Some(W { b: S { v: 1i64, i: p }, k: 7i64 });
        let mut out: i64 = 0i64;
        if let Option::Some(W { b: bb, k }) = o { out = bb.v + k; }
        if out != 8i64 { return 99i32; }
    }
    return c as i32;
}
