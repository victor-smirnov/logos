// Test: drops fire in reverse declaration order (LIFO)
package drop_reverse_order;

extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: *const u8, v: i32) { unsafe { printf(fmt, v); } }

trait Drop { fn drop(self: Self); }

struct Res { id: i32; }

impl Drop for Res {
    fn drop(self: Res) { printi("d%d ", self.id); }
}

unsafe fn main() -> i32 {
    let result: i32 = 42;
    let a: Res = Res { id: 1 };
    let b: Res = Res { id: 2 };
    let c: Res = Res { id: 3 };
    return result;
}
