// offset_of!(Type, field) — Rust-faithful compile-time byte offset (core::mem::
// offset_of!). Covers a plain struct (alignment padding), a #[self_describing]
// DST's tail (the Rust-faithful replacement for sizeof-of-unsized=header), and
// a generic struct instantiation.
package offset_of_basic;

struct P { a: i32, b: i64, c: u8 }       // a@0, b@8 (pad), c@16
#[self_describing]
struct Block { count: i64, code: i32, tail: [i64] }  // count@0, code@8, tail@16
struct GB<T> { hdr: i64, val: T }

// B-ca-03 escape: offset_of! is a compile-time i64 const, valid in const-init
// (a plain literal-equivalent, no fn-call inlining).
const BLOCK_HDR: i64 = offset_of!(Block, tail);
const BLOCK_HDR_X2: i64 = offset_of!(Block, tail) * 2i64;

fn main() -> i32 {
    if BLOCK_HDR != 16i64    { return 20i32; }
    if BLOCK_HDR_X2 != 32i64 { return 21i32; }
    if offset_of!(P, a) != 0i64  { return 1i32; }
    if offset_of!(P, b) != 8i64  { return 2i32; }
    if offset_of!(P, c) != 16i64 { return 3i32; }
    if offset_of!(Block, count) != 0i64  { return 4i32; }
    if offset_of!(Block, code)  != 8i64  { return 5i32; }
    if offset_of!(Block, tail)  != 16i64 { return 6i32; }   // header size = tail offset
    if offset_of!(GB<i64>, hdr) != 0i64  { return 7i32; }
    if offset_of!(GB<i64>, val) != 8i64  { return 8i32; }
    if offset_of!(GB<i32>, val) != 8i64  { return 9i32; }   // i32 val still @8 (i64 hdr)
    return 0i32;
}
