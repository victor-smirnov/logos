// Bitwise/shift operator overloading on user structs (parallel to arithmetic
// Add/Sub/... which already worked): `a & b`, `a | b`, `a ^ b`, `a << b`, `a >> b`
// dispatch to the BitAnd/BitOr/BitXor/Shl/Shr trait impls.
package struct_bitwise_operator_overload;

struct Bits { v: i64 }
impl BitAnd for Bits { fn bitand(self: Bits, r: Bits) -> Bits { return Bits { v: self.v & r.v }; } }
impl BitOr  for Bits { fn bitor (self: Bits, r: Bits) -> Bits { return Bits { v: self.v | r.v }; } }
impl BitXor for Bits { fn bitxor(self: Bits, r: Bits) -> Bits { return Bits { v: self.v ^ r.v }; } }
impl Shl    for Bits { fn shl   (self: Bits, r: Bits) -> Bits { return Bits { v: self.v << r.v }; } }
impl Shr    for Bits { fn shr   (self: Bits, r: Bits) -> Bits { return Bits { v: self.v >> r.v }; } }

fn main() -> i32 {
    let a: Bits = Bits { v: 6i64 };
    let b: Bits = Bits { v: 3i64 };
    if (a & b).v != 2i64 { return 1i32; }    // 6 & 3 = 2
    if (a | b).v != 7i64 { return 2i32; }    // 6 | 3 = 7
    if (a ^ b).v != 5i64 { return 3i32; }    // 6 ^ 3 = 5
    let one: Bits = Bits { v: 1i64 };
    let sh:  Bits = Bits { v: 4i64 };
    if (one << sh).v != 16i64 { return 4i32; }  // 1 << 4 = 16
    let big: Bits = Bits { v: 32i64 };
    if (big >> sh).v != 2i64 { return 5i32; }   // 32 >> 4 = 2
    return 0i32;
}
