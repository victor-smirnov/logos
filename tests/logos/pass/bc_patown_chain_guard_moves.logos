// a let-chain guard that moves `y`: dropped once in the callee, the flagged scope-exit drop is skipped PROBES.md 2026-09-06d: `if let` / `while let` / let-chains lower BY DELEGATION to lower_match (temp hoist, per-arm scrutinee move, arm drops, cond-move merge); the count is a destructor tally through a raw pointer.
package bc_patown_chain_guard_moves;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn mk(p: *mut i64, v: i64) -> Option<S> { return Option::Some(S { v: v, i: p }); }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    let mut n: i64 = 0i64;
    {
        let o: Option<S> = mk(p, 1i64);
        let y: S = S { v: 5i64, i: p };
        if let Option::Some(x) = o && eat(y) > 0i64 { n = x.v; }
    }
    return (c * 10i64 + n) as i32;
}
