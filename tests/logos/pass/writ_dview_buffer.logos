// Buffer<DView> (type-erased keys) + Buffer<WAny> (runtime-typed values) — the
// at-rest storage halves of the planned Map<DView, WAny>. A DView stored into a
// Buffer is encoded into an owned cell; reading it back yields a DView pointing
// INTO the buffer (valid until the buffer mutates). WAny stores by value.

package writ_dview_buffer;

use logos.lang.cmp;
use logos.lang.fabric;
use logos.lang.writ.dview;
use logos.lang.writ.anyval;

fn main() -> i32 {
    // ── Buffer<DView>: store/retrieve type-erased keys ───────────────────────
    let mut kb: Buffer<DView> = Buffer::<DView>::new();
    let a: i64 = 5i64;
    let b: i64 = -3i64;
    let c: i64 = 100i64;
    kb.push(DView::from(&a));
    kb.push(DView::from(&b));
    kb.push(DView::from(&c));
    if kb.len() != 3u64 { return 1; }

    // read back — values survive the encode→cell→decode round-trip
    if kb.get(0u64).to::<i64>() != 5i64   { return 2; }
    if kb.get(1u64).to::<i64>() != -3i64  { return 3; }
    if kb.get(2u64).to::<i64>() != 100i64 { return 4; }

    // tag survives; ordering via two stored views (signed)
    if !kb.get(0u64).is_a::<i64>() { return 5; }
    match kb.get(0u64).compare(&kb.get(1u64)) { Ordering::Greater => {} _ => { return 6; } }
    match kb.get(1u64).compare(&kb.get(2u64)) { Ordering::Less    => {} _ => { return 7; } }

    // ── Buffer<WAny>: store/retrieve runtime-typed values ────────────────────
    let mut vb: Buffer<WAny> = Buffer::<WAny>::new();
    vb.push(WAny::from(7i32));
    vb.push(WAny::from(true));
    if vb.len() != 2u64 { return 8; }

    let h0: WAny = vb.get(0u64);
    if !h0.is_int() { return 9; }
    if h0.as_i64() != 7i64 { return 10; }

    let h1: WAny = vb.get(1u64);
    if !h1.is_bool() { return 11; }

    // ── split_at / merge / insert / erase on Buffer<DView> ───────────────────
    // kb = [5, -3, 100]; split at 1 → self=[5], right=[-3, 100]
    let mut right: Buffer<DView> = kb.split_at(1u64);
    if kb.len() != 1u64 { return 12; }
    if right.len() != 2u64 { return 13; }
    if kb.get(0u64).to::<i64>() != 5i64 { return 14; }
    if right.get(0u64).to::<i64>() != -3i64 { return 15; }
    if right.get(1u64).to::<i64>() != 100i64 { return 16; }

    // merge right back onto kb → [5, -3, 100]
    kb.merge(right);
    if kb.len() != 3u64 { return 17; }
    if kb.get(2u64).to::<i64>() != 100i64 { return 18; }

    // insert / erase
    let x: i64 = 42i64;
    kb.insert(1u64, DView::from(&x));     // [5, 42, -3, 100]
    if kb.len() != 4u64 { return 19; }
    if kb.get(1u64).to::<i64>() != 42i64 { return 20; }
    kb.erase(1u64);                        // [5, -3, 100]
    if kb.len() != 3u64 { return 21; }
    if kb.get(1u64).to::<i64>() != -3i64 { return 22; }

    return 0;
}
