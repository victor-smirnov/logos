// WQL TUPLE PROJECTIONS + `select first` — single-row mode over a tuple row:
// the generated fn returns Option<(T1, T2)>; the first matching row's tuple in
// scan order (early-exit loop), None on a miss. Also first + order by desc
// (sort permutation, head row projected as a tuple).
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

struct Person { pub name: str, pub age: i64 }

// hit: the first adult → ("Ada", 45).
pub deem first_adult(people: &[Person]) { from people p where p.age >= 18 select first (p.name, p.age) }

// miss: nobody above 100 → None.
pub deem first_ancient(people: &[Person]) { from people p where p.age > 100 select first (p.name, p.age) }

// first + order by desc: the OLDEST person as a tuple.
pub deem oldest(people: &[Person]) { from people p select first (p.name, p.age) order by p.age desc }

fn main() -> i32 {
    let people: [Person; 4] = [
        Person { name: "Eve",  age: 12i64 },
        Person { name: "Ada",  age: 45i64 },
        Person { name: "Bob",  age: 41i64 },
        Person { name: "Cleo", age: 70i64 },
    ];

    match first_adult(&people[..]).unwrap() {
        Option::Some(t) => {
            if !str_eq(t.0, "Ada") { return 1i32; }
            if t.1 != 45i64 { return 2i32; }
        }
        Option::None => { return 3i32; }
    }

    match first_ancient(&people[..]).unwrap() {
        Option::Some(_) => { return 4i32; }
        Option::None => { }
    }

    match oldest(&people[..]).unwrap() {
        Option::Some(t) => {
            if !str_eq(t.0, "Cleo") { return 5i32; }
            if t.1 != 70i64 { return 6i32; }
        }
        Option::None => { return 7i32; }
    }
    return 0i32;
}
