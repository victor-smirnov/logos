// ADR 0030 S9a step A: a Map adapter whose item is the closure's output — B is constrained by `F: FnMut(I::Item) -> B`
// (RFC 447: an associated-type equality on a constrained input); `where Self::Item: Into<i64>` at a concrete item calls the
// impl Into selects. rustc 1.98.1 (Rust-shaped twin): 48.
package s9a_map_adapter_item_from_fn_output;
use logos.lang.marker;
trait It {
    type Item;
    fn nx(&mut self) -> Option<Self::Item>;
    fn mp<MpOut, MpFn: FnMut(Self::Item) -> MpOut>(self, f: MpFn) -> Mp<Self, MpFn, MpOut> where Self: Sized { Mp { it: self, f: f, _b: PhantomData::<MpOut> {} } }
    fn fold_sum(mut self) -> i64 where Self: Sized, Self::Item: Into<i64> {
        let mut s: i64 = 0;
        while let Some(x) = self.nx() { s = s + x.into(); }
        s
    }
}
struct Up { i: i64, n: i64 }
impl It for Up {
    type Item = i64;
    fn nx(&mut self) -> Option<i64> { if self.i < self.n { self.i = self.i + 1; Some(self.i) } else { None } }
}
struct Mp<I, F, B> { it: I, f: F, _b: PhantomData<B> }
impl<I: It, F: FnMut(I::Item) -> B, B> It for Mp<I, F, B> {
    type Item = B;
    fn nx(&mut self) -> Option<B> { match self.it.nx() { Some(x) => Some((self.f)(x)), None => None } }
}
fn main() -> i32 {
    let a = Up { i: 0, n: 3 }.mp(|x: i64| x * 10).fold_sum();
    let b = Up { i: 0, n: 2 }.mp(|x: i64| x + 1).mp(|y: i64| y * 100).fold_sum();
    return (a + b) as i32;
}
