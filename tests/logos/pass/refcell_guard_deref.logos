// A RefCell guard had no Deref: `cell.borrow().x` was "struct 'Ref$G1$P' has no field
// 'x'", `*cell.borrow_mut() += 1` did not exist. Ref: Deref, RefMut: Deref + DerefMut.
// A compound assignment whose place CALLS evaluates the call once (the read-twice
// desugar borrowed twice and panicked "already borrowed"; `*pick(&mut a, &mut n) += 5`
// ran `pick` twice). rustc twin: 0.
package refcell_guard_deref;
use logos.lang.cell;
use logos.mem.string;
struct P { x: i32, y: i32 }
fn pick<'a>(v: &'a mut [i64; 2], n: &mut i32) -> &'a mut i64 { *n += 1; return &mut v[0]; }
fn nx(n: &mut i32) -> usize { *n += 1; return 1; }
fn main() -> i32 {
    let c: RefCell<P> = RefCell::new(P { x: 1, y: 2 });
    {
        let g = c.borrow();
        if g.x + g.y != 3 { return 1; }
    }
    { let mut g = c.borrow_mut(); g.x = 10; }
    let a = c.borrow().x;
    if a != 10 { return 2; }
    c.borrow_mut().y += 5;
    if c.borrow().y != 7 { return 3; }
    let cv: RefCell<i32> = RefCell::new(5);
    *cv.borrow_mut() += 1;
    if *cv.borrow() != 6 { return 4; }
    let cs: RefCell<String> = RefCell::new(String::from("ab"));
    cs.borrow_mut().push_str("cd");
    if cs.borrow().len() != 4 { return 5; }
    let mut arr: [i64; 2] = [1, 2];
    let mut n: i32 = 0;
    *pick(&mut arr, &mut n) += 5;
    if n != 1 || arr[0] != 6 { return 6; }
    arr[nx(&mut n)] += 3;
    if n != 2 || arr[1] != 5 { return 7; }
    return 0;
}
