// Writ compactify — copy a multi-segment doc into a fresh arena (copying GC).
// Build a doc in a TINY-segment source (forcing many segments), compactify into a
// fresh arena, and verify the compacted copy stringifies identically + is fully
// independent (round-trips through HBS on its own).
package test;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.wmap;
use logos.lang.writ.wstring;
use logos.lang.writ.compactify;
use logos.mem.writ.parser;
use logos.mem.writ.stringify;
use logos.mem.writ.wbs;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.lang.str;
fn main() -> i32 {
    let src: str = "{\"a\": [1, 2, 3], \"b\": {\"c\": \"deep\", \"d\": [true, false, null]}, \"n\": -42}";
    // parse into a TINY-segment arena → the doc spans many never-move segments
    let small: Writ = writ_new(32i64);
    let doc: WAny = parse(&small, src);
    let before: String = stringify(doc);

    // compactify into a fresh arena (one big segment → single rigid block)
    let big: Writ = writ_new(4096i64);
    let comp: WAny = compactify(&big, doc);
    if !str_eq(stringify(comp).as_str(), before.as_str()) { return 1; }   // identical content

    // the compacted copy is fully independent — round-trips through HBS by itself
    let bytes: Vec<u8> = wbs_write(comp);
    let h3: Writ = writ_new(4096i64);
    let back: WAny = wbs_read(&h3, bytes.as_slice().as_ptr(), bytes.len());
    if !str_eq(stringify(back).as_str(), before.as_str()) { return 2; }

    // spot-check structure of the compacted map
    let m: &WMap<WString, WAny> = unsafe { &*(comp.resolve() as *const WMap<WString, WAny>) };
    if m.get("n").as_i56() != (0i64 - 42i64) { return 3; }
    let inner: &WMap<WString, WAny> = unsafe { &*(m.get("b").resolve() as *const WMap<WString, WAny>) };
    if !str_eq(h3.wstring_of(inner.get("c")).as_str(), "deep") {
        // note: inner is in `big`, resolve via any arena (wstring_of ignores self)
        if !str_eq(big.wstring_of(inner.get("c")).as_str(), "deep") { return 4; }
    }
    return 0;
}
