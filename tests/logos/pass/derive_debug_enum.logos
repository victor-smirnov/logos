// Phase 7 slice 24b+c: derive(Debug) on an enum with mixed variants.
//
// Hook walks ENUM.ITEMS (wrapped variant_list), reads each VARIANT_DEF
// for NAME + payload arity, and synthesises a `match self { ... }`
// body. Unit variants emit just the name; tuple variants bind their
// payloads as `_v0, _v1, ...` and recurse with `.fmt(__f)`. Each
// payload field dispatches into its own Debug impl through the
// generic-context path.

package main;

use logos.lang.writ.wstatic;
use logos.lang.writ.anyval;
use logos.std.compiler.metaprog;
use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;
use logos.std.io;

#[metaprog_handler("derive_debug_enum")]
fn derive_debug_enum_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: WAny = view.node_at(target_offset);
    let name: SView = view.ast_node_name(item);
    if name.len == (0 as u64) { return; }

    let nv: u64 = view.ast_enum_variant_count(item);

    let mut em: Emitter = Emitter::new();
    em.emit_target_pkg(&view);
    em.emit_raw("use logos.std.fmt;");
    em.emit_raw("use logos.mem.string;\nuse logos.lang.str;\nuse logos.lang.result;");

    em.buf.push_str("impl Debug for ");
    unsafe { em.buf.push_bytes(name.ptr, name.len as i64); }
    em.buf.push_str(" {");
    em.buf.push_u8(10 as u8);

    em.buf.push_str("    fn fmt(&self, __f: &mut Formatter) -> Result<(), Error> {");
    em.buf.push_u8(10 as u8);

    em.buf.push_str("        match *self {");
    em.buf.push_u8(10 as u8);

    let mut i: u64 = 0 as u64;
    while i < nv {
        let v: WAny = view.ast_enum_variant(item, i);
        let vname: SView = view.ast_node_name(v);
        let arity: u64 = view.ast_variant_arity(v);

        em.buf.push_str("            ");
        unsafe { em.buf.push_bytes(name.ptr, name.len as i64); }
        em.buf.push_str("::");
        unsafe { em.buf.push_bytes(vname.ptr, vname.len as i64); }

        if arity == (0 as u64) {
            em.buf.push_str(" => { let _ = __f.write_str(\"");
            unsafe { em.buf.push_bytes(vname.ptr, vname.len as i64); }
            em.buf.push_str("\"); }");
        } else {
            em.buf.push_str("(");
            let mut k: u64 = 0 as u64;
            while k < arity {
                if k > (0 as u64) { em.buf.push_str(", "); }
                em.buf.push_str("_v");
                em.buf.push_u64(k);
                k = k + (1 as u64);
            }
            em.buf.push_str(") => { let _ = __f.write_str(\"");
            unsafe { em.buf.push_bytes(vname.ptr, vname.len as i64); }
            em.buf.push_str("(\"); ");
            let mut k2: u64 = 0 as u64;
            while k2 < arity {
                if k2 > (0 as u64) {
                    em.buf.push_str("let _ = __f.write_str(\", \"); ");
                }
                em.buf.push_str("let _ = fmt_debug(&_v");
                em.buf.push_u64(k2);
                em.buf.push_str(", __f); ");
                k2 = k2 + (1 as u64);
            }
            em.buf.push_str("let _ = __f.write_char(41 as u8); }");
        }
        em.buf.push_u8(10 as u8);

        i = i + (1 as u64);
    }

    em.buf.push_str("        }");
    em.buf.push_u8(10 as u8);
    em.buf.push_str("        return ok();");
    em.buf.push_u8(10 as u8);
    em.buf.push_str("    }");
    em.buf.push_u8(10 as u8);
    em.buf.push_str("}");
    em.commit();
    return;
}

#[derive_debug_enum]
enum Shape { Circle(i32), Rect(i32, i32), Empty }

unsafe fn main() -> i32 {
    let s1: Shape = Shape::Rect(3, 4);
    let s2: Shape = Shape::Circle(7);
    let s3: Shape = Shape::Empty;
    let mut buf: String = String::new();
    let t1: String = fmt_debug_to_string::<Shape>(&s1);
    buf.push_str(t1.as_str());
    buf.push_u8(32 as u8);
    let t2: String = fmt_debug_to_string::<Shape>(&s2);
    buf.push_str(t2.as_str());
    buf.push_u8(32 as u8);
    let t3: String = fmt_debug_to_string::<Shape>(&s3);
    buf.push_str(t3.as_str());
    println_string(&buf);
    // "Rect(3, 4) Circle(7) Empty" = 26 bytes
    return buf.len() as i32;
}
