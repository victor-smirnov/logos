package meta_struct;

use hermes.view;
use hermes.anyval;

#[zoned] struct MyPoint {
    x: i32,
    y: i32,
    meta @{ "deprecated": true, "since": "0.1", "priority": 42 }
}

unsafe fn main() -> i32 {
    let info: HermesStatic = reflect::<MyPoint>();
    let root: AnyVal = info.root();
    if root.is_null() { return 1; }

    // "meta" key must be present
    let meta_av: AnyVal = info.map_get(root, "meta");
    if meta_av.is_null() { return 2; }
    if !meta_av.is_ptr() { return 3; }

    // "deprecated" must be true (non-null)
    let dep_av: AnyVal = info.map_get(meta_av, "deprecated");
    if dep_av.is_null() { return 4; }

    // "since" must be a non-null string
    let since_av: AnyVal = info.map_get(meta_av, "since");
    if since_av.is_null() { return 5; }

    // "priority" must be an integer 42
    let prio_av: AnyVal = info.map_get(meta_av, "priority");
    if prio_av.is_null() { return 6; }
    let prio: i64 = info.get_int(prio_av);
    if prio != 42 { return 7; }

    return 42;
}
