// Test: AnyVal convenience type-check and extraction methods (Task 2).

package hermes_anyval_methods;

use hermes.anyval;
use hermes.zone;
use hermes.typetag;

unsafe fn main() -> i32 {
    // --- is_null ---
    let nul: AnyVal = AnyVal::null_ptr();
    if !nul.is_null()  { return 1; }

    // --- is_int (hash=23) ---
    let vi32: AnyVal = AnyVal::embed_i24(77 as i32);
    if !vi32.is_int()  { return 2; }
    if vi32.is_bool()  { return 3; }

    // --- as_i64 ---
    if vi32.as_i64() != 77 as i64 { return 4; }

    // --- is_bool (hash=37) ---
    let vb: AnyVal = AnyVal::embed_bool(true);
    if !vb.is_bool()  { return 5; }
    if vb.is_int()    { return 6; }
    if !vb.as_bool()  { return 7; }

    // --- is_bool false ---
    let vbf: AnyVal = AnyVal::embed_bool(false);
    if !vbf.is_bool() { return 8; }
    if vbf.as_bool()  { return 9; }

    // --- is_int: null returns false ---
    if nul.is_int()    { return 10; }
    // --- is_bool: pointer returns false ---
    let ptr_val: AnyVal = AnyVal::from_offset(128 as u32);
    if ptr_val.is_bool() { return 11; }
    if ptr_val.is_int()  { return 12; }

    // --- as_i64: non-int returns 0 ---
    if vb.as_i64() != 0 as i64 { return 13; }

    // --- is_string, is_array, is_map: need a zone ---
    let mut zone: HermesZone = HermesZone::create(4096 as i64);
    let base: *const u8 = zone.base as *const u8;

    // Reserve offset 0 for DocumentHeader sentinel (offset 0 = null).
    let _hdr: *mut u8 = zone.alloc_raw(8 as i64);

    // Allocate a HermesString tagged object (descriptor=0, hash=28).
    // Content: 1-byte vlen=1 + 'X'.
    let hs_raw: *mut u8 = zone.alloc_tagged(2 as i64, hermes_tag_string(), hermes_desc_data());
    *((hs_raw as i64 + 0 as i64) as *mut u8) = 1 as u8;   // vlen
    *((hs_raw as i64 + 1 as i64) as *mut u8) = 88 as u8;  // 'X'
    let hs_off: u32 = (hs_raw as i64 - base as i64) as u32;
    let hs_val: AnyVal = AnyVal::from_offset(hs_off);

    if !hs_val.is_string(base) { return 14; }
    if  hs_val.is_array(base)  { return 15; }
    if  hs_val.is_map(base)    { return 16; }

    // Allocate an ObjectArray tagged object (descriptor=1).
    // Minimal: just a 24-byte header (no element buffer needed for the type check).
    let oa_raw: *mut u8 = zone.alloc_tagged(24 as i64, hermes_tag_array(), hermes_desc_array());
    // zero-init: size=0, capacity=0, data=0
    let mut k: i64 = 0 as i64;
    while k < 24 as i64 {
        *((oa_raw as i64 + k) as *mut u8) = 0 as u8;
        k = k + 1 as i64;
    }
    let oa_off: u32 = (oa_raw as i64 - base as i64) as u32;
    let oa_val: AnyVal = AnyVal::from_offset(oa_off);

    if  oa_val.is_string(base) { return 17; }
    if !oa_val.is_array(base)  { return 18; }
    if  oa_val.is_map(base)    { return 19; }

    // Allocate a TinyObjectMap tagged object (descriptor=2, hash=98).
    let tm_raw: *mut u8 = zone.alloc_tagged(16 as i64, hermes_tag_tiny_map(), hermes_desc_map());
    let mut m: i64 = 0 as i64;
    while m < 16 as i64 {
        *((tm_raw as i64 + m) as *mut u8) = 0 as u8;
        m = m + 1 as i64;
    }
    let tm_off: u32 = (tm_raw as i64 - base as i64) as u32;
    let tm_val: AnyVal = AnyVal::from_offset(tm_off);

    if  tm_val.is_string(base) { return 20; }
    if  tm_val.is_array(base)  { return 21; }
    if !tm_val.is_map(base)    { return 22; }

    // null pointer should return false for all pointer-type checks
    if nul.is_string(base) { return 23; }
    if nul.is_array(base)  { return 24; }
    if nul.is_map(base)    { return 25; }

    zone.destroy();
    return 42;
}
