// An array literal under `as [T; N]` takes its element type from the cast target, as from any expected-type position; the identity cast is then a no-op.
package arraylit_cast_target_elem_type;
use logos.lang.cmp;
struct S { v: i64 }
impl Eq for S { fn eq(&self, other: &S) -> bool { return self.v == other.v; } }
fn main() -> i32 {
    let e: [S; 0] = [];
    if e != [] as [S; 0] { return 1i32; }
    let a = [Option::None, Option::Some(2i64)] as [Option<i64>; 2];
    match a[1] { Option::Some(x) => { if x != 2i64 { return 2i32; } } Option::None => { return 3i32; } }
    let b = [1, 2] as [i8; 2];
    if b[0] + b[1] != 3i8 { return 4i32; }
    return 0i32;
}
