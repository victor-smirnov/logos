// std.io.read + std.io.write — exercise traits through Pipe.
package test;

use std.io.read;
use std.io.write;
use std.io.pipe;

fn do_write<W: Write>(w: &mut W, buf: *const u8, len: i64) -> i64 {
    return write_all::<W>(w, buf, len);
}

fn do_read<R: Read>(r: &mut R, buf: *mut u8, len: i64) -> i64 {
    return read_exact::<R>(r, buf, len);
}

fn main() -> i32 {
    let mut p: Pipe = pipe_new();
    if !(&p).is_valid() { return 1; }

    let src: [u8; 4] = [72, 101, 108, 108];
    let wrc: i64 = do_write::<Pipe>(&mut p, &src[0] as *const u8, 4 as i64);
    if wrc != 0 { return 10; }

    let mut buf: [u8; 4] = [0, 0, 0, 0];
    let rrc: i64 = do_read::<Pipe>(&mut p, &mut buf[0] as *mut u8, 4 as i64);
    if rrc != 0 { return 20; }

    if buf[0] != 72  { return 30; }
    if buf[1] != 101 { return 31; }
    if buf[2] != 108 { return 32; }
    if buf[3] != 108 { return 33; }

    (&mut p).close();
    return 42;
}
