// CONTROL twin of rawdup_partition_vec_drop_once: a Copy payload still answers correctly.
//
// #112 — the `*((&x) as *const T)` duplicate-owner class.

package rawdup_partition_vec_copy_ctl;

use logos.std.fmt;
use logos.lang.option;
use logos.lang.iter;
use logos.mem.collections.vec;

fn gt1(x: &i64) -> bool { return *x > 1i64; }

fn main() -> i32 {
    let mut s: Vec<i64> = vec_new::<i64>();
    s.push(1i64); s.push(2i64); s.push(3i64);
    let p: ZipPair<Vec<i64>, Vec<i64>> = iter_partition_vec::<VecIntoIter<i64>, i64>(s.into_iter(), gt1);
    println!("yes={} no={}", p.first.len(), p.second.len());
    return 0i32;
}
