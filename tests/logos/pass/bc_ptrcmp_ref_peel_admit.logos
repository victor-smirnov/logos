package bc_ptrcmp_ref_peel_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
fn show(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
fn compiles<'a, 'b>(x: *mut &'a i64, y: *mut &'a i64) -> i64 {
    let rx = &x;
    let ry = &y;
    let eq: bool = rx == ry;
    if eq { return 8i64; }
    return 8i64;
}
fn main() -> i32 {
    let mut r: &'static i64 = &5i64;
    let p: *mut &'static i64 = &mut r as *mut &'static i64;
    let n: i64 = compiles(p, p);
    show("peeled=%lld\n", n);
    return n as i32;
}
