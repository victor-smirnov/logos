// Mono nested-generic-enum mangling + mlir-gen tagged-enum
// pre-registration. `Option<Option<T>>` now mangles to
// `Option__Option__T` (full inner-arg path), and Option<T>'s payload
// slot inside the outer is resolved to `ptr_type` rather than the
// discriminant scalar — both pieces are needed for `option_flatten`
// to actually read the inner Option pointer.

package option_flatten_pass;

use std.lang.option;

fn main() -> i32 {
    let some_some: Option<Option<i32>> = Option::Some(Option::Some(42i32));
    match option_flatten::<i32>(some_some) {
        Option::Some(v) => {
            if v != 42i32 { return 1i32; }
        }
        Option::None => { return 2i32; }
    }

    let some_none: Option<Option<i32>> = Option::Some(Option::None);
    match option_flatten::<i32>(some_none) {
        Option::Some(_) => { return 3i32; }
        Option::None    => { }
    }

    let none_none: Option<Option<i32>> = Option::None;
    match option_flatten::<i32>(none_none) {
        Option::Some(_) => { return 4i32; }
        Option::None    => { }
    }

    // 3-level nest: Option<Option<Option<i32>>>.
    let triple: Option<Option<Option<i32>>> =
        Option::Some(Option::Some(Option::Some(7i32)));
    match triple {
        Option::Some(inner) => {
            match inner {
                Option::Some(innerinner) => {
                    match innerinner {
                        Option::Some(v) => {
                            if v != 7i32 { return 5i32; }
                        }
                        Option::None => { return 6i32; }
                    }
                }
                Option::None => { return 7i32; }
            }
        }
        Option::None => { return 8i32; }
    }

    return 0i32;
}
