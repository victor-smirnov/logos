package bc_refeqland_typevar_ref_pair_calls_eq_admit;
use logos.lang.cmp;
struct D { v: i64 }
impl Eq for D {
    fn eq(&self, other: &D) -> bool {
        return self.v == other.v;
    }
}
fn same<T: Eq>(a: &T, b: &T) -> bool {
    return a == b;
}
fn main() -> i32 {
    let a: D = D { v: 4i64 };
    let b: D = D { v: 4i64 };
    if !same::<D>(&a, &b) { return 1i32; }
    let c: char = 'k';
    let d: char = 'k';
    if !same::<char>(&c, &d) { return 2i32; }
    return 0i32;
}
