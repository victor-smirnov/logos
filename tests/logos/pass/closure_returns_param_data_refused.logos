// Closed squeue closure_returns_param_data_refused (#747): a closure under an EARLY-BOUND parameter type (map's `F: FnMut(Self::Item) -> B`, Item = `&'a B`) may return data its parameter points at. rustc 1.98.1 prints the same.
package closure_returns_param_data_refused;
use logos.std.fmt;
use logos.mem.string;
use logos.mem.collections.vec;
struct B { t: String }
fn titles(bs: &Vec<B>) -> Vec<&str> { let v: Vec<&str> = bs.iter().map(|b| b.t.as_str()).collect(); return v; }
fn main() { let bs: Vec<B> = vec![B { t: String::from("x") }, B { t: String::from("yz") }]; println!("{:?}", titles(&bs)); }
