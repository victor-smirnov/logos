// Array binders keep their shape in both match forms: an array element, a nested array pattern in a tuple, an array field (renamed and destructured), an array enum payload (rustc 1.98.1: 3 345 8 21 10 42).
package array_binders_keep_shape;
extern fn printf(fmt: *const u8, ...) -> i32;
struct R { a: [i64; 2], y: i64 }
enum E { V([i64; 2]), W }
fn main() -> i32 {
    let m: [[i64; 2]; 2] = [[1i64, 2i64], [3i64, 4i64]];
    let r1: i64 = match m { [x, _] => x[0] + x[1] };
    let sv: ([i64; 2], i64) = ([3i64, 4i64], 5i64);
    let r2: i64 = match sv { ([a, b], c) => a * 100i64 + b * 10i64 + c };
    let mut r3: i64 = 0i64;
    match sv { ([a, _], c) => { r3 = a + c; } }
    let r: R = R { a: [6i64, 7i64], y: 8i64 };
    let r4: i64 = match r { R { a: v, y } => v[0] + v[1] + y };
    let e: E = E::V([9i64, 10i64]);
    let r5: i64 = match e { E::V(arr) => arr[1], E::W => 0i64 };
    let r6: i64 = match r { R { a: [p, q], y: _ } => p * q };
    unsafe { printf("%lld %lld %lld %lld %lld %lld\n".as_ptr(), r1, r2, r3, r4, r5, r6); }
    return 0i32;
}
