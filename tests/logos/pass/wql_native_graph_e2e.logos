// wql_native_graph_e2e — a NATIVE Logos object graph as a deem! source
// (ADR 0016 case 2b, STATIC form; the honest half of what "T4/M4" meant).
// Native objects are deliberately UNTAGGED — types are known statically — so
// #[derive_graph_source] generates the traversal by COMPILE-TIME reflection:
// a walker + materializer + `impl GraphSource for T` per annotated struct,
// emitting the SAME eight-column vocabulary as the Writ walker. Every deem!
// feature applies to native objects unchanged: `**` descent, gpath sugar
// ([*]), {kind} filters, joins, and (by construction) generic mappings.
// Asserts: nested-struct descent finds db.port via `**`; [*] enumerates a
// Vec field. Ordering machinery under test: the deem! sites' natspec is
// seeded BY CONVENTION from the annotation one metaprog round before the
// derive's emitted impl collects (identical re-registration = confirmation).
package test;
use logos.std.compiler.metaprog;
use logos.std.wql.wql;
use logos.std.wql.writ_graph;
use logos.lang.writ.container;
use logos.mem.collections.vec;
use logos.lang.str;
use logos.lang.num.float;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.wstring;
use logos.std.deem;
use logos.std.io;

#[derive_graph_source]
pub struct Db { pub host: str, pub port: i64, pub load: f64 }

#[derive_graph_source]
pub struct Cfg { pub name: str, pub db: Db, pub replicas: Vec<i64> }

pub deem ports(g: &Cfg) {
    from g ** p {i64} where p.key == "port" select p.vi
}

pub deem all_replicas(g: &Cfg) {
    from g .replicas [*] r select r.vi
}

pub deem loads(g: &Cfg) {
    from g ** p {f64} select p.vi
}

// runtime twin: the derive's materializer rows, bound to a DYNAMIC query.
fn edges_to_source(rows: &Vec<WritEdgeRow>, d: &Writ) -> WAny {
    let n: i64 = rows.len();
    let arr: &mut WArray<WAny> = d.array(n + 1i64);
    let mut i: i64 = 0i64;
    while i < n {
        let r: WritEdgeRow = rows.get(i);
        let row: &mut WArray<WAny> = d.array(8i64);
        row.push(d.int(r.0));
        row.push(WAny::from(d.wstring(r.1)));
        row.push(d.int(r.2));
        row.push(d.int(r.3));
        row.push(WAny::from(d.wstring(r.4)));
        row.push(d.int(r.5));
        row.push(d.int(r.6));
        row.push(WAny::from(d.wstring(r.7)));
        arr.push(WAny::ref_to(row as *const WArray<WAny> as *const u8));
        i = i + 1i64;
    }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

fn main() -> i32 {
    let mut reps: Vec<i64> = vec_new::<i64>();
    reps.push(9001i64); reps.push(9002i64);
    let cfg: Cfg = Cfg { name: "prod", db: Db { host: "h1", port: 5432i64, load: 0.75f64 }, replicas: reps };

    let p: Vec<i64> = match ports(&cfg)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    if p.len() != 1i64 { return 2i32; }
    if p.get(0i64) != 5432i64 { return 3i32; }

    let r: Vec<i64> = match all_replicas(&cfg)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 4i32; } };
    if r.len() != 2i64 { return 5i32; }

    // f64 leaf: vi carries the IEEE bits (kind "f64") — exact, and
    // recoverable via f64_from_bits after the query.
    let l: Vec<i64> = match loads(&cfg)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 6i32; } };
    if l.len() != 1i64 { return 7i32; }
    let lf: f64 = f64_from_bits(l.get(0i64) as u64);
    if !(lf > 0.74f64 && lf < 0.76f64) { return 8i32; }

    // ── runtime: the SAME materializer rows through a dynamic query ──
    let rows: Vec<WritEdgeRow> = __gs_edges_Cfg(&cfg);
    let d: Writ = writ_new(16384i64);
    let src: WAny = edges_to_source(&rows, &d);
    let cat: SchemaCatalog = SchemaCatalog::new();
    let q: Query = match Query::compile(
        "from g e where e.key == \"port\" select e.vi", &cat)
    { Result::Ok(v) => { v } Result::Err(e) => { println(e.msg.as_str()); return 9i32; } };
    let mut env: QEnv = QEnv::new();
    env.bind_edge_rows("g", src);
    let rr: QRows = match q.run(&env)
    { Result::Ok(v) => { v } Result::Err(e) => { println(e.msg.as_str()); return 10i32; } };
    if rr.row_count() != 1i64 { return 11i32; }
    if rr.get_i64(0i64, 0i64) != 5432i64 { return 12i32; }
    return 0i32;
}
