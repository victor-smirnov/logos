// Stores into places rooted in temporaries: a struct literal's field, a
// by-value call result's array element, a tuple literal's element, and a
// `&mut`-rooted place; each temporary drops at the end of its statement
// (rustc 1.98.1: 7 + 100 + 2000 = 2107, exit 59).
package temp_rooted_place_assign_shapes;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct W { d: D, k: [i64; 2] }
fn mk(p: *mut i64) -> W { return W { d: D { v: 100i64, c: p }, k: [0i64, 0i64] }; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    W { d: D { v: 1i64, c: p }, k: [0i64, 0i64] }.d.v = 7i64;
    mk(p).k[1] = 3i64;
    (D { v: 1000i64, c: p }, 5i64).0.v = 2000i64;
    let got: i64 = unsafe { n };
    return (got % 256i64) as i32;
}
