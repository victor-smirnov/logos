package datatype_own;
// Phase 6: DataOwn<T> — reference-counted owning handle for a Datatype.

use hermes.zone;
use hermes.own;

datatype Point {
    x: i32,
    y: i32,
}

unsafe fn main() -> i32 {
    // Allocate zone and a Point inside it.
    let mut zone: HermesZone = HermesZone::create(4096);
    let size: i64 = sizeof::<Point>();
    let raw: *mut u8 = zone.alloc_raw(size);
    let base_int: i64 = zone.base as i64;
    let raw_int: i64 = raw as i64;
    let offset: u32 = (raw_int - base_int) as u32;

    // Initialise the Point via raw pointer.
    let pw: *mut Point = raw as *mut Point;
    pw.x = 10;
    pw.y = 20;

    // Create owning handle: RC=1.
    let mut own1: DataOwn<Point> = dataown_create::<Point>(zone.base, offset);

    // Clone: RC becomes 2.
    let mut own2: DataOwn<Point> = own1.clone_ref();
    let rc2: i32 = own1.ref_count();

    // Release one clone: RC drops to 1.
    own2.release();
    let rc1: i32 = own1.ref_count();

    // Read via own1.ptr().
    let pr: *const Point = own1.ptr();
    let sum: i32 = pr.x + pr.y;

    // Release last handle: RC reaches 0, RC heap storage freed.
    own1.release();

    zone.destroy();

    // sum=30, rc2=2, rc1=1 → result = 30 + 2 + 1 = 33
    return sum + rc2 + rc1;
}
