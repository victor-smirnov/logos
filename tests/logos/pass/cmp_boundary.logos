package cmp_boundary;
// Edge cases: comparing at boundary values, zero, equal operands
fn bool_to_int(b: bool) -> i32 { if b { return 1; } return 0; }
fn main() -> i32 {
    // zero boundary comparisons
    let a: i32 = bool_to_int(0 == 0);   // 1
    let b: i32 = bool_to_int(0 < 1);    // 1
    let c: i32 = bool_to_int(-1 < 0);   // 1
    let d: i32 = bool_to_int(0 > -1);   // 1
    let e: i32 = bool_to_int(0 >= 0);   // 1
    let f: i32 = bool_to_int(0 <= 0);   // 1
    // false cases
    let g: i32 = bool_to_int(0 != 0);   // 0
    let h: i32 = bool_to_int(1 < 0);    // 0
    // a+b+c+d+e+f = 6, g+h = 0; total = 6; 6*7 = 42
    return (a + b + c + d + e + f + g + h) * 7;
}
