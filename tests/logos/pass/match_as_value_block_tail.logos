// A `match` that is the last statement of a block used as a value is that
// block's value (ADR 0030 S2). Four doors lost it: a closure body (its tail
// mode was inherited, not set), a match-expression arm block (every match of
// plain values "always diverted" — expression arms were skipped by the
// divergence walk), a `let` initializer inside such a block ("always
// returned"), and a `match` at the end of a tail `if` branch (the tail flag
// reached only the body's top level). A closure's expression body moves its
// value out through the one return judgment.
package match_as_value_block_tail;

struct D { n: *mut i64 }
impl Drop for D {
    fn drop(&mut self) { unsafe { *self.n = *self.n + 1; } }
}

fn arm_block(k: i64) -> i64 {
    let v = match k { 1 => { let t = k * 2; match t { 2 => 5, _ => 6 } } _ => 0 };
    return v;
}
fn arm_let(k: i64) -> i64 {
    let v = match k { 1 => { let w = match k { _ => 7 }; w } _ => 0 };
    return v;
}
fn tail_if(k: i64, o: Option<i64>) -> i64 {
    if k < 5 { match o { Some(v) => v + k, None => 0 } } else { 1 }
}
fn nested_return(t: Option<i64>, op: i64) -> Result<i64, i64> {
    return match t {
        None => Ok(0),
        Some(b) => { match op { 1 => Ok(b + 1), _ => if b == 0 { Err(1) } else { Ok(b - 1) } } }
    };
}

fn main() -> i32 {
    if arm_block(1) != 5 { return 1; }
    if arm_let(1) != 7 { return 2; }
    if tail_if(2, Some(2)) != 4 || tail_if(9, Some(2)) != 1 { return 3; }
    match nested_return(Some(5), 1) { Ok(v) => { if v != 6 { return 4; } } Err(_) => { return 4; } }
    match nested_return(Some(0), 2) { Ok(_) => { return 5; } Err(e) => { if e != 1 { return 5; } } }
    let c = |v: i32| { match v { 0 => 7, _ => 9 } };
    if c(1) != 9 { return 6; }
    let mut drops: i64 = 0;
    let n: *mut i64 = &mut drops as *mut i64;
    {
        let id = |d: D| d;
        let kept = id(D { n: n });
        if drops != 0 { return 7; }
        let _ = kept;
    }
    if drops != 1 { return 8; }
    return 42;
}
