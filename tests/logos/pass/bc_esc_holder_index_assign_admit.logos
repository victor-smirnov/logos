// #86 MISS-C — ADMIT half. ONE VARIABLE against
// fail/bc_esc_holder_index_assign_dangle: the assigned borrow is rooted at a
// PARAMETER, not at a fn-local. Same `index_mut` lowering, same door.
//
// `ok_static` pins the 'static root beside it: an index-assign of a literal is
// not a holder escape at all.
package bc_esc_holder_index_assign_admit;
use logos.mem.string;

pub fn ok(s: str) -> Vec<str> {
    let mut v: Vec<str> = Vec::<str>::new();
    v.push("x");
    v[0i64] = s;
    return v;
}

pub fn ok_static() -> Vec<str> {
    let mut v: Vec<str> = Vec::<str>::new();
    v.push("x");
    v[0i64] = "abcde";
    return v;
}

fn main() -> i32 {
    let o: String = String::from("hello");
    let a: Vec<str> = ok(o.as_str());
    if a.len() != 1i64 { return 1i32; }
    if a.get(0i64).len() != 5i64 { return 2i32; }
    let b: Vec<str> = ok_static();
    if b.get(0i64).len() != 5i64 { return 3i32; }
    return 0i32;
}
