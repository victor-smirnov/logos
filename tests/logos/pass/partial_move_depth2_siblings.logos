// Boundary pins for T1-10 (B78) — all valgrind-verified during development:
// after `move o.i.s`, the disjoint sibling `o.i.t` stays usable AND the
// scope-end drop walk releases exactly the non-moved leaves (the pre-fix
// first-segment truncation skipped the whole `o.i`, leaking `o.i.t`).
// Field re-assignment lifts the suppression so the new value drops.
package partial_move_depth2_siblings;

struct Inner { s: String, t: String }
struct Outer { i: Inner }

fn consume(s: String) -> i64 { s.len() }

fn sibling_use() -> i64 {
    let o = Outer { i: Inner { s: String::from("a"), t: String::from("bb") } };
    let n = consume(o.i.s);
    let sib = o.i.t;          // disjoint sibling — usable
    n + consume(sib)
}

fn sibling_scope_drop() -> i64 {
    let o = Outer { i: Inner { s: String::from("a"), t: String::from("bb") } };
    consume(o.i.s)
    // o.i.t drops here (leaked pre-fix)
}

fn reinit_then_use() -> i64 {
    let mut o = Outer { i: Inner { s: String::from("a"), t: String::from("bb") } };
    let n = consume(o.i.s);
    o.i.s = String::from("ccc");
    n + consume(o.i.s)
}

fn reinit_then_drop() -> i64 {
    let mut o = Outer { i: Inner { s: String::from("a"), t: String::from("bb") } };
    let n = consume(o.i.s);
    o.i.s = String::from("ccc");
    n
    // reinit'd o.i.s + o.i.t both drop here
}

fn main() -> i32 {
    if sibling_use() != 3i64 { return 1; }
    if sibling_scope_drop() != 1i64 { return 2; }
    if reinit_then_use() != 4i64 { return 3; }
    if reinit_then_drop() != 1i64 { return 4; }
    return 0;
}
