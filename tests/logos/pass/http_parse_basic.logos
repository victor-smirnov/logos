// Phase F: parse + serialize round-trip on in-memory byte buffers.
package test;

use std.io.http;
use logos.mem.string;
use logos.lang.str;
use std.io.net.url;
use logos.lang.option;
use logos.lang.result;
use std.collections.vec;

fn main() -> i32 {
    // ── Request parsing ──────────────────────────────────────────────────────
    let req_text: str =
        "POST /submit?x=1 HTTP/1.1\r\nHost: example.com\r\nContent-Length: 5\r\nContent-Type: text/plain\r\n\r\nhello";

    match parse_request_buf(req_text.as_ptr(), req_text.len()) {
        Result::Ok(req) => {
            if req.method.code != 1            { return 1; }
            if !(&req.url.path).eq_str("/submit") { return 2; }
            if !(&req.url.query).eq_str("x=1")    { return 3; }
            if (&req.headers).len() != 3 as i64   { return 4; }
            match (&req.headers).get("host") {
                Option::Some(v) => {
                    if !(&v).eq_str("example.com") { return 5; }
                }
                Option::None => { return 6; }
            }
            unsafe {
                let bp: *mut Vec<u8> = &req.body as *const Vec<u8> as *mut Vec<u8>;
                if bp.length() != 5 as i64 { return 7; }
                if bp.get(0) != 104 as u8  { return 8; }
                if bp.get(4) != 111 as u8  { return 9; }
            }
        }
        Result::Err(_) => { return 100; }
    }

    // ── Response parsing ─────────────────────────────────────────────────────
    let resp_text: str =
        "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nContent-Type: application/json\r\n\r\nok";

    match parse_response_buf(resp_text.as_ptr(), resp_text.len()) {
        Result::Ok(resp) => {
            if resp.status != 200               { return 10; }
            if !(&resp.reason).eq_str("OK")     { return 11; }
            if (&resp.headers).len() != 2 as i64 { return 12; }
            unsafe {
                let bp: *mut Vec<u8> = &resp.body as *const Vec<u8> as *mut Vec<u8>;
                if bp.length() != 2 as i64 { return 13; }
                if bp.get(0) != 111 as u8  { return 14; }
                if bp.get(1) != 107 as u8  { return 15; }
            }
        }
        Result::Err(_) => { return 101; }
    }

    // ── Serialize then re-parse request ──────────────────────────────────────
    let mut r2: Request = Request::new(Method::get(),
        match url_parse("http://example.com/path") {
            Option::Some(u) => u,
            Option::None    => { return 20; }
        });
    (&mut r2.headers).append("Host", "example.com");
    (&mut r2.headers).append("Accept", "text/plain");

    let mut buf: Vec<u8> = vec_new::<u8>();
    serialize_request(&r2, &mut buf);

    unsafe {
        let bp: *mut Vec<u8> = &buf as *const Vec<u8> as *mut Vec<u8>;
        let blen: i64 = bp.length();
        if bp.get(0) != 71 as u8 { return 21; }
        if bp.get(1) != 69 as u8 { return 22; }
        if bp.get(2) != 84 as u8 { return 23; }
        match parse_request_buf(bp.at_const(0 as i64) as *const u8, blen) {
            Result::Ok(req2) => {
                if req2.method.code != 0           { return 24; }
                if !(&req2.url.path).eq_str("/path") { return 25; }
                if (&req2.headers).len() != 2 as i64 { return 26; }
            }
            Result::Err(_) => { return 27; }
        }
    }

    // ── Malformed inputs ─────────────────────────────────────────────────────
    let bad1: str = "GET /\r\n\r\n";
    match parse_request_buf(bad1.as_ptr(), bad1.len()) {
        Result::Ok(_)  => { return 30; }
        Result::Err(_) => {}
    }

    let bad2: str = "HTTP/1.1 OK\r\n\r\n";
    match parse_response_buf(bad2.as_ptr(), bad2.len()) {
        Result::Ok(_)  => { return 31; }
        Result::Err(_) => {}
    }

    return 42;
}
