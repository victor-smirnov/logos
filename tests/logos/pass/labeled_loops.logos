package labeled_loops;
fn main() -> i32 {
    let mut result: i32 = 0;
    // Test break with label: outer loop should exit when inner finds match
    'outer: for i in 0..5 {
        for j in 0..5 {
            if i + j == 4 {
                result = i * 10 + j;
                break 'outer;
            }
        }
    }
    // result should be 0*10+4=4 (first i+j==4 is i=0,j=4)
    if result != 4 { return 1; }

    // Test continue with label
    let mut sum: i32 = 0;
    'outer2: for i in 0..3 {
        for j in 0..3 {
            if j == 1 {
                continue 'outer2;
            }
            sum = sum + 1;
        }
    }
    // Each outer iteration: j=0 adds 1, j=1 continues to outer, j=2 never reached
    // So sum = 3 * 1 = 3
    if sum != 3 { return 2; }

    return 42;
}
