package x;
trait Show { fn show(self: &Self) -> i32; }
impl Show for i32 { fn show(self: &i32) -> i32 { return *self; } }
impl<T: Show> Show for &T { fn show(self: &&T) -> i32 { return (**self).show() + 100; } }

fn use_show<X: Show>(x: X) -> i32 { return x.show(); }

// The blanket answers where Self IS the reference (`X = &i32`: 107). A method call on `r: &i32` takes
// `i32::show(&self)` — its receiver as is, by value before autoref, as rustc does (7).
unsafe fn main() -> i32 {
    let x: i32 = 7;
    let r: &i32 = &x;
    return (use_show(r) - 107) + (r.show() - 7);
}
