// An UNSUFFIXED literal adopts the narrower width it fits, at a let, a free
// call and an overloaded method (first declared overload that fits). Twin of
// tests/logos/fail/overload_set_arg_mismatch_says_no_method.logos.
package intlit_unsuffixed_adopts_overload;
struct C { v: i64 }
impl C {
    fn put(&self, _x: u8) -> i32 { return 1i32; }
    fn put(&self, _x: i64) -> i32 { return 2i32; }
}
fn f(x: u8) -> i32 { return x as i32; }
fn main() -> i32 {
    let c: C = C { v: 1i64 };
    let a: u8 = 9;
    let r1: i32 = c.put(9);
    let r2: i32 = c.put(300);
    let r3: i32 = c.put(9i64);
    let r4: i32 = c.put(9u8);
    if a != 9u8 || f(7) != 7i32 { return 1i32; }
    if r1 != 1i32 || r2 != 2i32 || r3 != 2i32 || r4 != 1i32 { return 2i32; }
    if c.v != 1i64 { return 3i32; }
    return 0i32;
}
