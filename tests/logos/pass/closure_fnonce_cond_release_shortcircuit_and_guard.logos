package closure_fnonce_cond_release_shortcircuit_and_guard;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn aa(c: bool, p: *mut i64) -> bool {
    let r: bool;
    { let x: D = D { v: 1i64, c: p }; let f = move || -> bool { let t: D = x; return t.v > 0i64; };
      r = c && f(); }
    return r;
}
fn g(k: i64, p: *mut i64) -> i64 {
    let mut r: i64 = 0i64;
    { let x: D = D { v: 2i64, c: p }; let f = move || -> bool { let t: D = x; return t.v > 0i64; };
      match k { 0 if f() => { r = 1i64; } _ => { r = 7i64; } } }
    return r;
}
fn main() -> i32 {
    let mut k1: i64 = 0i64; let mut k2: i64 = 0i64; let mut k3: i64 = 0i64; let mut k4: i64 = 0i64;
    let r1: bool = aa(true, &mut k1); let r2: bool = aa(false, &mut k2);
    let r3: i64 = g(0i64, &mut k3); let r4: i64 = g(1i64, &mut k4);
    unsafe { printf("%d %lld %d %lld | %lld %lld %lld %lld\n".as_ptr(), r1 as i32, k1, r2 as i32, k2, r3, k3, r4, k4); }
    return 0i32;
}
