// `[D{1}, D{10}][0].v = 5;` — a store into a place rooted in a TEMPORARY. Such
// an assignment is `{ let __v = v; let mut __t = R; __t[0].v = __v; }`
// (lower_temp_rooted_place_assign_): the value first, as Rust evaluates it, and
// the temporary drops at the end of the statement. rustc 1.98.1: n=15.
// Twins: tests/logos/pass/temp_rooted_place_assign_shapes.logos,
// tests/logos/fail/temp_rooted_place_assign_through_shared_ref.logos.
package array_temp_elem_field_store_refused;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    {
        [D { v: 1i64, c: p }, D { v: 10i64, c: p }][0].v = 5i64;
    }
    let got: i64 = unsafe { n };
    unsafe { printf("n=%ld\n".as_ptr(), got); }
    if got != 15i64 { return 1i32; }
    return 0i32;
}
