// Runtime document building (hermes2 successor of the Hermes1 builder test):
// fresh container, root map, string + int values, stringify check.
package hermes_builder;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.hmap;
use logos.lang.hermes.hstring;
use logos.mem.hermes.stringify;
use logos.lang.rc;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Hermes> = hermes_rc(4096);
    let h: &Hermes = rc.deref();

    // Root map with 8 slots; fill via typed set overloads + explicit HAny.
    let m: &mut HMap<HString, HAny> = h.map(8);
    m.set("greet", HAny::from(&*(h.hstring("hello") as *const HString)));
    m.set("n", 42i64);
    let mp: *const HMap<HString, HAny> = m as *const HMap<HString, HAny>;
    h.set_root(HAny::ref_to(mp as *const u8));

    let root: HAny = h.root();
    if root.is_null() { return 1; }
    if !root.is_map() { return 2; }

    let g: HAny = (&*mp).get("greet");
    if !g.is_string() { return 3; }
    let n: HAny = (&*mp).get("n");
    if n.as_i64() != 42i64 { return 4; }

    let text: String = stringify(root);
    if text.len() != 27i64 { return 5; }   // {"greet": "hello", "n": 42} (key order hash-dependent)
    return 0;
}
