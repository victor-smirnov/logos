// StableLayout — the validated layout-freeze contract: primitives are
// covered by lang impls; a struct impl is accepted when every field is
// itself stable (primitives, raw pointers, fixed arrays, nested stable
// structs). The fail twin (stable_layout_enum_field) rejects violations.
package test;

use logos.lang.marker;

struct Inner { a: i64, b: f64 }
impl StableLayout for Inner {}

struct Node { hdr: u32, flag: bool, xs: [u64; 4], inner: Inner, p: *mut u8 }
impl StableLayout for Node {}

fn frozen<T: StableLayout>(v: T) -> T { return v; }

fn main() -> i32 {
    let _a: i64 = frozen(1i64);
    let n: Node = Node {
        hdr: 7u32, flag: true,
        xs: [1u64, 2u64, 3u64, 4u64],
        inner: Inner { a: 1i64, b: 2.0f64 },
        p: 0i64 as *mut u8,
    };
    let _n2: Node = frozen(n);
    return 0i32;
}
