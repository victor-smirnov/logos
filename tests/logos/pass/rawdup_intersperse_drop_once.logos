// IntersperseIter CLONES the separator and the lookahead; creations and destructions balance.
//
// #112 — the `*((&x) as *const T)` duplicate-owner class.

package rawdup_intersperse_drop_once;

use logos.std.fmt;
use logos.lang.option;
use logos.lang.iter;
use logos.mem.collections.vec;
use logos.lang.clone;

// Heap-owning AND printing payload — see rawdup_option_filter_drop_once for why both
// halves are load-bearing. The assertion is the EXACT set of destructor lines.
struct Inner { pub n: i64, pub v: Vec<i64> }
impl Drop for Inner { fn drop(self: &mut Inner) { println!("DROP n={}", self.n); } }
// ⚠ THE CLONE IS TAGGED. `clone()` gives the duplicate `n + 100`, so a genuine clone
// and a raw bitwise ALIAS of the same value are DISTINGUISHABLE in the destructor log.
// Without the tag this fixture does not discriminate: the pre-#112 body handed out a
// bitwise copy of `sep` / `peeked_val`, and copy-plus-original destroys the same NUMBER
// of times as clone-plus-original — the control revert measured that and passed.
impl Clone for Inner { fn clone(self: &Inner) -> Inner { let mut v: Vec<i64> = vec_new::<i64>(); v.push(self.n + 100i64); return Inner { n: self.n + 100i64, v: v }; } }
fn mk(n: i64) -> Inner { let mut v: Vec<i64> = vec_new::<i64>(); v.push(n); return Inner { n: n, v: v }; }

fn main() -> i32 {
    let mut s: Vec<Inner> = vec_new::<Inner>();
    s.push(mk(1i64)); s.push(mk(2i64));
    let it: IntersperseIter<VecIntoIter<Inner>, Inner> =
        iter_intersperse::<VecIntoIter<Inner>, Inner>(s.into_iter(), mk(8i64), mk(0i64));
    println!("count={}", it.count());
    println!("-- end");
    return 0i32;
}
