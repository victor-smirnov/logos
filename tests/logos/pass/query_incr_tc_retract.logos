// query_incr_tc_retract — slice-6 RETRACTION correctness via mark-based
// DELETE-REDERIVE (ADR 0013 §4.2). A − edge delta correctly SHRINKS the
// maintained closure: over-delete every path fact whose derivation could use
// the deleted edge, then re-derive over the survivors. Asserted eng == oracle
// after retraction. Two named cases (formerly the pinned gap, now closed):
//   (R-last)     delete the ONLY support of a path fact → the batch oracle drops
//                it AND the engine drops it (over-delete, no re-derive) → 1 row.
//   (R-spurious) edges {a→b, b→c, c→b}; delete a→b. The oracle drops every
//                (a,·). A single SCALAR WEIGHT would keep (a,b)/(a,c) alive via
//                the surviving b⇄c cycle (spurious circular support) — the exact
//                case that makes weight-cancellation UNSOUND on cyclic graphs.
//                Mark-based DRed gets it RIGHT: over-delete removes (a,b)/(a,c)
//                (derivable via a→b), re-derive does NOT bring them back (a has
//                no other out-edge), the b⇄c closure survives → 4 rows == oracle.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema Edge : code(0x0E07_0000_0000_0001) {
    src: i64 = 0,
    dst: i64 = 1,
}
resource cat = schema_catalog!{ Edge };

fn mk_edge(d: &Writ, s: i64, t: i64) -> WAny {
    let e: Edge = d.make::<Edge>();
    e.src = s; e.dst = t;
    return WAny::ref_to((e.m as i64) as *const u8);
}

fn build_src(d: &Writ, hs: &Vec<WAny>, wts: &Vec<i64>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(64i64);
    let n: i64 = hs.len();
    let mut i: i64 = 0i64;
    while i < n {
        if wts.get(i) > 0i64 { arr.push(hs.get(i)); }
        i = i + 1i64;
    }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

fn src_apply(hs: &Vec<WAny>, wts: &mut Vec<i64>, batch: &mut ZBatch, idx: i64, raw: i64) {
    let old: i64 = wts.get(idx);
    let mut neww: i64 = old + raw;
    if neww < 0i64 { neww = 0i64; }
    let eff: i64 = neww - old;
    wts.set(idx, neww);
    if eff != 0i64 { batch.push(hs.get(idx), eff); }
}

fn oracle_rows(q: &Query, doc: &Writ, hs: &Vec<WAny>, wts: &Vec<i64>) -> i64 {
    let mut oenv: QEnv = QEnv::new();
    oenv.bind_source("edges", build_src(doc, hs, wts));
    let orc: QRows = match q.run(&oenv) { Result::Ok(r) => { r } Result::Err(_e) => { return -1i64; } };
    return orc.row_count();
}

fn main() -> i32 {
    let doc: Writ = writ_new(65536i64);
    let c: SchemaCatalog = cat();
    let q: Query = match Query::compile(
        "rel path(a: i64, b: i64) { from edges e select (e.src, e.dst); from path p join edges e on p.b == e.src select (p.a, e.dst); } from path p select (p.a, p.b)",
        &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };

    // ── (R-last): chain 0→1→2, delete 1→2. Oracle: {(0,1)} (1 row). ──
    let mut hs: Vec<WAny> = vec_new::<WAny>();
    hs.push(mk_edge(&doc, 0i64, 1i64));   // idx 0
    hs.push(mk_edge(&doc, 1i64, 2i64));   // idx 1
    let mut wts: Vec<i64> = vec_new::<i64>();
    wts.push(1i64); wts.push(1i64);

    let mut env: QEnv = QEnv::new();
    env.bind_source("edges", build_src(&doc, &hs, &wts));
    let mut eng: IncrRec = match q.incremental_rec(&env) { Result::Ok(e) => { e } Result::Err(_e2) => { return 91i32; } };
    // baseline closure = {(0,1),(1,2),(0,2)} = 3
    if eng.snapshot().row_count() != 3i64 { return 92i32; }
    if oracle_rows(&q, &doc, &hs, &wts) != 3i64 { return 93i32; }

    // retract 1→2
    let mut d1: ZBatch = ZBatch::new();
    src_apply(&hs, &mut wts, &mut d1, 1i64, -1i64);
    eng.epoch(&d1);
    let orc_after: i64 = oracle_rows(&q, &doc, &hs, &wts);   // = 1  {(0,1)}
    let eng_after: i64 = eng.snapshot().row_count();         // = 1  (DRed shrinks)
    if orc_after != 1i64 { return 94i32; }
    // DRed over-deletes (1,2) and (0,2) [both derivable via the deleted 1→2],
    // re-derive brings back nothing (no alternative support) ⇒ engine == oracle.
    if eng_after != 1i64 { return 95i32; }

    // ── (R-spurious): edges {a→b, b→c, c→b}; delete a→b. Oracle drops all (a,·). ──
    let mut hs2: Vec<WAny> = vec_new::<WAny>();
    hs2.push(mk_edge(&doc, 0i64, 1i64));   // a→b  idx 0
    hs2.push(mk_edge(&doc, 1i64, 2i64));   // b→c  idx 1
    hs2.push(mk_edge(&doc, 2i64, 1i64));   // c→b  idx 2
    let mut w2: Vec<i64> = vec_new::<i64>();
    w2.push(1i64); w2.push(1i64); w2.push(1i64);

    let mut env2: QEnv = QEnv::new();
    env2.bind_source("edges", build_src(&doc, &hs2, &w2));
    let mut eng2: IncrRec = match q.incremental_rec(&env2) { Result::Ok(e) => { e } Result::Err(_e3) => { return 96i32; } };
    let base2: i64 = eng2.snapshot().row_count();
    if oracle_rows(&q, &doc, &hs2, &w2) != base2 { return 97i32; }

    // delete a→b (idx 0)
    let mut d2: ZBatch = ZBatch::new();
    src_apply(&hs2, &mut w2, &mut d2, 0i64, -1i64);
    eng2.epoch(&d2);
    let orc2: i64 = oracle_rows(&q, &doc, &hs2, &w2);   // b⇄c closure only: {(1,2),(2,1),(1,1),(2,2)} = 4
    let eng2_after: i64 = eng2.snapshot().row_count();  // DRed: drops (0,·), keeps b⇄c
    if orc2 != 4i64 { return 98i32; }
    // DECISIVE: mark-based DRed drops the spurious (0,·) tuples (over-deleted via
    // a→b, no re-derive since a has no other out-edge) while the b⇄c cycle
    // survives ⇒ engine == oracle. Scalar-weight cancellation got this WRONG.
    if eng2_after != 4i64 { return 99i32; }

    return 0i32;
}
