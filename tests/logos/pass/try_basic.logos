// Test: ? operator for Result<T,E> error propagation
package try_basic;

// The prelude's Result: `?` is the lang item's (ADR 0030 L0); a local `enum Result`
// without a `Try` impl is E0277, as in rustc.

fn divide(a: i32, b: i32) -> Result<i32, i32> {
    if b == 0 {
        return Result::Err(1);
    }
    return Result::Ok(a / b);
}

fn calc(a: i32, b: i32, c: i32) -> Result<i32, i32> {
    let x: i32 = divide(a, b)?;
    let y: i32 = divide(x, c)?;
    return Result::Ok(y);
}

unsafe fn main() -> i32 {
    let r: Result<i32, i32> = calc(84, 2, 1);
    match r {
        Result::Ok(v)  => { return v; }
        Result::Err(e) => { return 0; }
    }
}
