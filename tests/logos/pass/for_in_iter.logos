package for_in_iter;

extern fn printf(fmt: *const u8, ...) -> i32;

enum Option<T> {
    None,
    Some(T),
}

struct Range {
    current: i32;
    end: i32;
}

impl Range {
    fn next(self: *mut Range) -> Option<i32> {
        if self.current >= self.end {
            return Option::None;
        }
        let v = self.current;
        self.current = self.current + 1;
        return Option::Some(v);
    }
}

fn main() -> i32 {
    let mut r = Range { current: 0, end: 4 };
    let mut sum = 0;
    for x in r {
        sum = sum + x;
    }
    printf("%d\n", sum);
    return 0;
}
