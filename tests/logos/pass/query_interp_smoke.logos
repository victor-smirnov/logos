// query_interp_smoke — the queue-2 INTERPRETER's runtime-unique behaviors, in
// one place (ADR 0012-queue2). The static `deem!` engine already covers every
// query SEMANTIC statically (the wql_* suite); this test keeps only what is
// intrinsic to compiling query TEXT at runtime and cannot exist statically:
//   (1) RE-ENTRANCY — one compiled Query, run over DIFFERENT envs (new params,
//       new source arrays, even a different graph) → different results.
//   (2) runtime JOIN-TIER dispatch — the tier is chosen at CHECK time from
//       checked types: i64 equi-key + residual → HASH; f64 == f64 → LOOP
//       (PartialEq only, NaN kills Hash/Ord); anti join → hash ABSENCE.
//   (3) runtime Datalog FIXPOINT — a `rel` transitive closure executed as the
//       semi-naïve interpreter loop; set semantics terminate a CYCLE.
// Everything the interpreter does that the compiled path also does is left to
// the static wql_* tests; this is the deliberately-minimal dynamic footprint.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Emp : code(0x0B2C_0000_0000_0001) {
    name: str = 0,
    dept: i64 = 1,
    age:  i64 = 2,
    rate: f64 = 3,
}
pub schema Dept : code(0x0B2C_0000_0000_0002) {
    id:      i64 = 0,
    dname:   str = 1,
    cap:     f64 = 2,
    min_age: i64 = 3,
}
pub schema Edge : code(0x0B2C_0000_0000_0003) {
    src: i64 = 0,
    dst: i64 = 1,
}

resource cat = schema_catalog!{ Emp, Dept, Edge };

fn mk_emp(d: &Writ, name: str, dept: i64, age: i64, rate: f64) -> WAny {
    let e: Emp = d.make::<Emp>();
    e.name = name; e.dept = dept; e.age = age; e.rate = rate;
    return WAny::ref_to((e.m as i64) as *const u8);
}
fn mk_dept(d: &Writ, id: i64, dname: str, cap: f64, min_age: i64) -> WAny {
    let x: Dept = d.make::<Dept>();
    x.id = id; x.dname = dname; x.cap = cap; x.min_age = min_age;
    return WAny::ref_to((x.m as i64) as *const u8);
}
fn mk_edge(d: &Writ, s: i64, t: i64) -> WAny {
    let e: Edge = d.make::<Edge>();
    e.src = s; e.dst = t;
    return WAny::ref_to((e.m as i64) as *const u8);
}

fn main() -> i32 {
    let d: Writ = writ_new(8192i64);
    let c: SchemaCatalog = cat();

    // ═══ (2) runtime JOIN-TIER dispatch ══════════════════════════════════════
    let emps: &mut WArray<WAny> = d.array(8i64);
    emps.push(mk_emp(&d, "Ann", 1i64, 45i64, 1.5f64));
    emps.push(mk_emp(&d, "Bob", 2i64, 55i64, 2.5f64));
    emps.push(mk_emp(&d, "Cid", 1i64, 35i64, 3.5f64));
    emps.push(mk_emp(&d, "Dan", 9i64, 40i64, 4.5f64));   // dept 9 has no Dept row
    let esrc: WAny = WAny::ref_to(emps as *const WArray<WAny> as *const u8);
    let depts: &mut WArray<WAny> = d.array(4i64);
    depts.push(mk_dept(&d, 1i64, "Core", 1.5f64, 30i64));
    depts.push(mk_dept(&d, 2i64, "Ops",  9.9f64, 40i64));
    let dsrc: WAny = WAny::ref_to(depts as *const WArray<WAny> as *const u8);

    let mut jenv: QEnv = QEnv::new();
    jenv.bind_source("emps", esrc);
    jenv.bind_source("depts", dsrc);

    // HASH tier — i64 equi-key + residual (e.age > d.min_age).
    let q_hash: Query = match Query::compile(
        r#"from emps e
             join depts d on e.dept == d.id && e.age > d.min_age
             select (d.dname, e.name)"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    let rh: QRows = match q_hash.run(&jenv) { Result::Ok(r) => { r } Result::Err(_e2) => { return 2i32; } };
    if rh.row_count() != 3i64 { return 3i32; }                       // Ann/Bob/Cid
    if !str_eq(rh.get_str(0i64, 0i64), "Core") { return 4i32; }
    if !str_eq(rh.get_str(1i64, 1i64), "Bob")  { return 5i32; }

    // LOOP tier — f64 == f64 equi-term (PartialEq only).
    let q_loop: Query = match Query::compile(
        r#"from emps e
             join depts d on e.rate == d.cap
             select e.name"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e3) => { return 6i32; } };
    let rl: QRows = match q_loop.run(&jenv) { Result::Ok(r) => { r } Result::Err(_e4) => { return 7i32; } };
    if rl.row_count() != 1i64 { return 8i32; }                       // Ann (1.5 == 1.5)
    if !str_eq(rl.get_str(0i64, 0i64), "Ann") { return 9i32; }

    // ANTI join — hash absence test (kept iff no dept matches).
    let q_anti: Query = match Query::compile(
        r#"from emps e
             anti join depts d on e.dept == d.id
             select e.name"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e5) => { return 10i32; } };
    let ra: QRows = match q_anti.run(&jenv) { Result::Ok(r) => { r } Result::Err(_e6) => { return 11i32; } };
    if ra.row_count() != 1i64 { return 12i32; }                      // Dan (dept 9, no row)
    if !str_eq(ra.get_str(0i64, 0i64), "Dan") { return 13i32; }

    // ═══ (3) runtime Datalog FIXPOINT + (1) RE-ENTRANCY over graphs ══════════
    // Compile the transitive-closure `rel` ONCE; run it over two different
    // graphs and several `start` params — the semi-naïve interpreter loop, set
    // semantics terminating each cycle.
    let q_reach: Query = match Query::compile(
        r#"rel path(a: i64, b: i64) {
             from edges e select (e.src, e.dst);
             from path p join edges e on p.b == e.src select (p.a, e.dst);
           }
           from path p where p.a == start select p.b order by p.b"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e7) => { return 14i32; } };

    // graph 1: cycle 1→2→3→1 + disconnected 5→6 + a duplicate edge.
    let g1: &mut WArray<WAny> = d.array(8i64);
    g1.push(mk_edge(&d, 1i64, 2i64));
    g1.push(mk_edge(&d, 2i64, 3i64));
    g1.push(mk_edge(&d, 3i64, 1i64));   // closes the cycle — set semantics terminate
    g1.push(mk_edge(&d, 5i64, 6i64));
    g1.push(mk_edge(&d, 2i64, 3i64));   // duplicate — deduped on insert
    let src1: WAny = WAny::ref_to(g1 as *const WArray<WAny> as *const u8);
    let mut env1: QEnv = QEnv::new();
    env1.bind_source("edges", src1);
    env1.bind_i64("start", 1i64);
    let r1: QRows = match q_reach.run(&env1) { Result::Ok(r) => { r } Result::Err(_e8) => { return 15i32; } };
    if r1.row_count() != 3i64 { return 16i32; }                      // reach(1) = {1,2,3}
    if r1.get_i64(0i64, 0i64) != 1i64 { return 17i32; }
    if r1.get_i64(2i64, 0i64) != 3i64 { return 18i32; }

    // re-entrancy over PARAMS: same env, new `start`.
    env1.bind_i64("start", 5i64);
    let r2: QRows = match q_reach.run(&env1) { Result::Ok(r) => { r } Result::Err(_e9) => { return 19i32; } };
    if r2.row_count() != 1i64 { return 20i32; }                      // reach(5) = {6}
    if r2.get_i64(0i64, 0i64) != 6i64 { return 21i32; }

    // re-entrancy over a DIFFERENT GRAPH: same compiled Query, new source (2-cycle 1⇄2).
    let g2: &mut WArray<WAny> = d.array(4i64);
    g2.push(mk_edge(&d, 1i64, 2i64));
    g2.push(mk_edge(&d, 2i64, 1i64));
    let src2: WAny = WAny::ref_to(g2 as *const WArray<WAny> as *const u8);
    let mut env2: QEnv = QEnv::new();
    env2.bind_source("edges", src2);
    env2.bind_i64("start", 1i64);
    let r3: QRows = match q_reach.run(&env2) { Result::Ok(r) => { r } Result::Err(_e10) => { return 22i32; } };
    if r3.row_count() != 2i64 { return 23i32; }                      // reach(1) = {1,2}
    if r3.get_i64(1i64, 0i64) != 2i64 { return 24i32; }

    return 0i32;
}
