package cmp_min_max_by_test;
use logos.lang.cmp;

// #114: `cmp_min_by`/`cmp_max_by` take a BORROWING comparator. By value the
// comparator consumed both operands and the function then returned one of
// them — two owners for one value. The signature is Rust's
// (`FnOnce(&T, &T) -> Ordering`), and this fixture is the caller re-aim.
fn cmp_i32(a: &i32, b: &i32) -> Ordering {
    let x: i32 = *a;
    let y: i32 = *b;
    if x < y { return Ordering::Less; }
    if x > y { return Ordering::Greater; }
    return Ordering::Equal;
}

fn main() -> i32 {
    if cmp_min_by(3i32, 7i32, cmp_i32) != 3i32 { return 1i32; }
    if cmp_max_by(3i32, 7i32, cmp_i32) != 7i32 { return 2i32; }
    if cmp_min_by(5i32, 5i32, cmp_i32) != 5i32 { return 3i32; }
    if cmp_max_by(5i32, 5i32, cmp_i32) != 5i32 { return 4i32; }
    return 0i32;
}
