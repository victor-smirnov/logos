package cmp_chains;
// F03: comparisons in if/while conditions
fn clamp(v: i32, lo: i32, hi: i32) -> i32 {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}
unsafe fn main() -> i32 {
    let a: i32 = clamp(-5, 0, 100);   // 0
    let b: i32 = clamp(200, 0, 100);  // 100
    let c: i32 = clamp(42, 0, 100);   // 42
    // a==0, b==100: a != b, b >= c, a <= c
    // return 0 + 100 - 100 + 42 = 42
    return a + b - b + c;
}
