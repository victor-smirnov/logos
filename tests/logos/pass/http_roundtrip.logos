// Phase J: client+server in one process, single scheduler+reactor.
// Server fiber accepts one connection; client fiber GETs / and verifies
// status=200, body="hello".

package test;

use std.http;
use std.net;
use std.string;
use std.vec;
use std.option;
use fiber;

const TEST_PORT: u16 = 48271 as u16;

fn handler(req: &Request) -> Response {
    let mut resp: Response = Response::new(200 as i32);
    (&mut resp.headers).append("Content-Length", "5");
    unsafe {
        let bp: *mut Vec<u8> = &resp.body as *const Vec<u8> as *mut Vec<u8>;
        bp.push(104 as u8);  // 'h'
        bp.push(101 as u8);  // 'e'
        bp.push(108 as u8);  // 'l'
        bp.push(108 as u8);  // 'l'
        bp.push(111 as u8);  // 'o'
    }
    return resp;
}

fn server_fiber(arg: i64) {
    let _: i32 = serve_n(TEST_PORT, 1 as i64, handler);
}

fn client_fiber(arg: i64) {
    let rp: *mut i32 = arg as *mut i32;
    let ip: u32 = ip4(127 as u32, 0 as u32, 0 as u32, 1 as u32);
    match http_get_at(ip, TEST_PORT, "localhost", "/") {
        Option::Some(resp) => {
            if resp.status != 200 as i32 { unsafe { *rp = 10; } return; }
            unsafe {
                let bp: *mut Vec<u8> = &resp.body as *const Vec<u8> as *mut Vec<u8>;
                if bp.length() != 5 as i64 { *rp = 11; return; }
                if bp.get(0) != 104 as u8  { *rp = 12; return; }
                if bp.get(1) != 101 as u8  { *rp = 13; return; }
                if bp.get(4) != 111 as u8  { *rp = 14; return; }
                *rp = 42;
            }
        }
        Option::None => { unsafe { *rp = 20; } }
    }
}

unsafe fn main() -> i32 {
    let s: *mut Scheduler = sched_new();
    sched_set_current(s);

    let r: *mut Reactor = reactor_new(64);
    if r == 0 as *mut Reactor { return 1; }
    reactor_set_current(r);

    let mut result: i32 = 0;
    let rp: i64 = &result as *const i32 as i64;

    spawn(server_fiber, 0 as i64);
    spawn(client_fiber, rp);

    reactor_run(s, r);

    reactor_free(r);
    sched_free(s);

    return result;
}
