// logos-core 1.3 / audit-v2 R1: `_` holes in let-annotations resolve
// from the RHS and NEVER pin a generic instantiation. Pre-fix
// `let v: Vec<_> = vec![…]` leaked the hole into mono as a literal
// `Vec$G1$_` (mlir-gen verification failure); `Option<_>` leaked via
// hint_enum_type_. Three converging rules: (1) unify_types never binds
// a TypeVar to InferredType, (2) hole-y annotations set no lowering
// hints (RHS infers freely), (3) the binding type is the annotation
// with holes FILLED from the RHS (fill_inferred_from_rhs).
package inferred_hole_annotations;
fn main() -> i32 {
    let v: Vec<_> = vec![1i64, 2, 3];
    let o: Option<_> = Some(7);
    let t: (i64, _) = (5, 2.5);
    let s: &[_] = &[1, 2];
    let mut n = 0i32;
    if v.len() == 3i64 { n = n + 1; }
    if let Some(x) = o { if x == 7 { n = n + 1; } }
    if t.0 == 5i64 && t.1 == 2.5f64 { n = n + 1; }
    if s.len() == 2i64 { n = n + 1; }
    n - 4
}
