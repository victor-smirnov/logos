// PIN (2026-09-04land, root 5): `(*r)()` through a `&mut` borrow of a closure,
// called TWICE, with a live capture. No Box anywhere — the defect was the deref,
// not the Box, contrary to how it was recorded (`wrap<F>(f:F)->Box<F>` is
// innocent and works). Pre-fix: compile rc 0, run rc 139.
// TWIN one token apart: deref_call_ref_closure_direct (`(*r)()` -> `r()`).
package deref_call_ref_closure;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
fn main() -> i32 {
    let k: i64 = 5i64;
    let mut c = || { return k + 1i64; };
    let r = &mut c;
    let a: i64 = (*r)();
    let b: i64 = (*r)();
    printi("a=%d ", a as i32);
    printi("b=%d ", b as i32);
    if a != 6i64 { return 1i32; }
    if b != 6i64 { return 2i32; }
    return 0i32;
}
