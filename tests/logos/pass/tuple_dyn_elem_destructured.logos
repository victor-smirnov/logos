// `let (d, n) = t` over `(&dyn Tr, i64)`: the binder is a `&dyn` local (called through
// garbage before). rustc 1.98.1: exit 0; valgrind clean.
package tuple_dyn_elem_destructured;
trait Tr { fn g(self: &Self) -> i64; }
struct D { v: i64 }
impl Tr for D { fn g(self: &Self) -> i64 { return self.v; } }
fn main() -> i32 {
    let dd: D = D { v: 40 };
    let t: (&dyn Tr, i64) = (&dd, 2);
    let (d, n) = t;
    return (d.g() + n - 42) as i32;
}
