// The legal twin of fail/fnitem_to_fnptr_array_elem_admits: `foo` really returns
// a `'static`, so it fits `[fn(&S) -> &'static S; 1]` (rustc 1.98.1: exit 0).
package fnitem_array_elem_static_return_ok;
struct S { n: i64 }
static GS: S = S { n: 0i64 };
fn foo<'a>(x: &'a S) -> &'static S { return &GS; }
fn main() -> i32 {
    let a: [fn(&S) -> &'static S; 1] = [foo];
    let s = S { n: 3i64 };
    return (a[0](&s).n) as i32;
}
