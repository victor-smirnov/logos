// metacall returning WritStatic — callee builds an @-literal and the
// driver freezes its blob bytes into rodata, splicing a WRIT_BLOB into
// the AST. The user-facing type stays WritStatic.
//
// Parity check: the same callee is invoked at runtime (no metacall),
// and both views must report the same size. The metacall path is a
// CTFE-equivalent of the runtime call.
package metacall_writ_static;

use logos.lang.writ.wstatic;

fn build_cfg() -> WritStatic {
    return @{"x": 42, "y": "hello"};
}

unsafe fn main() -> i32 {
    // Compile-time: blob is spliced into rodata as WRIT_BLOB.
    let cfg_meta: WritStatic = metacall build_cfg();
    

    // Runtime: same callee, ordinary call.
    let cfg_rt: WritStatic = build_cfg();
    

    if cfg_meta.size() == 0u64 {
        return 1;
    }
    if cfg_rt.size() == 0u64 {
        return 2;
    }
    // Both paths build the same blob — sizes must match byte-for-byte.
    if cfg_meta.size() != cfg_rt.size() {
        return 3;
    }
    return 42;
}
