// TypedValue must participate in Hermes trait dispatch tables.
package hermes_typed_datatype_trait_coverage;

use std.hermes.ctr;
use logos.lang.hermes.anyval;
use logos.lang.hermes.typetag;
use logos.lang.hermes.datatag;
use std.hermes.registry;
use std.hermes.stringify;
use std.hermes.equal;
use std.hermes.hashing;
use std.hermes.clone;
use std.hermes.release;
use logos.lang.hermes.zone;

unsafe fn main() -> i32 {
    let mut d: Hermes = Hermes::new(4096);
    match d.parse("@I64=42" as *const u8, 7 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 1; }
    }

    let root: AnyVal = d.root();
    if !root.is_ptr() { return 2; }
    let obj: *const u8 = (d.base() as i64 + root.as_offset() as i64) as *const u8;
    if read_type_code(obj) != 4115 as u64 { return 3; }

    let fs: fn(*const u8, *mut StringifyCtx) -> () = hermes_fn_stringify(4115 as u64);
    if (fs as *const u8) == 0 as *const u8 { return 4; }

    let fe: fn(*const u8, *const u8, *mut EqualCtx) -> bool = hermes_fn_equal(4115 as u64);
    if (fe as *const u8) == 0 as *const u8 { return 5; }

    let fh: fn(*const u8, *mut HashCtx) -> u64 = hermes_fn_hash(4115 as u64);
    if (fh as *const u8) == 0 as *const u8 { return 6; }

    let fc: fn(*const u8, *mut CloneCtx) -> *mut u8 = hermes_fn_clone(4115 as u64);
    if (fc as *const u8) == 0 as *const u8 { return 7; }

    let fr: fn(*const u8) -> () = hermes_fn_release(4115 as u64);
    if (fr as *const u8) == 0 as *const u8 { return 8; }

    let mut ectx: EqualCtx = EqualCtx {
        base_self: d.base(),
        base_other: d.base(),
    };
    if !fe(obj, obj, &mut ectx) { return 9; }

    let mut hctx: HashCtx = HashCtx { base: d.base() };
    if fh(obj, &mut hctx) == 0 as u64 { return 10; }

    let mut dst: Zone<Mutable> = zone_create(4096);
    let mut cctx: CloneCtx = CloneCtx {
        base_src: d.base(),
        zone_dst: &mut dst as *mut Zone<Mutable>,
        map: 0 as *mut CloneMap,
    };
    let copy_obj: *mut u8 = fc(obj, &mut cctx);
    if copy_obj == 0 as *mut u8 { return 11; }

    fr(copy_obj as *const u8);

    return 0;
}
