// `fold(0, |acc, x| acc + x)` over `&i64` items: the literal init stays an integer variable the closure solves (`{integer} + &i64` is i64), it was defaulted to i32 first ('callable |i32, &i64| -> i64 does not match').
package p;
use logos.std.fmt;
use logos.mem.collections.vec;
fn main() {
    let xs = [1i64, 2, 3];
    let a = xs.iter().fold(0, |acc, x| acc + x);
    let b = xs.iter().fold(0, |acc, _x| acc + 1);
    let c: i64 = xs.iter().fold(10, |acc, x| acc * x);
    let v: Vec<u8> = vec![1, 2, 250];
    let d = v.iter().fold(0, |acc, x| acc + *x as u32);
    println!("{} {} {} {}", a, b, c, d);
}
