// writ_typed_arr_lit.logos — verify @<ElemType>[...] compile-time typed array blobs.
//
// Tests that:
//  - @<I32>[...] emits Array<i32> (tc=104) blob with correct dense i32 layout
//  - @<U64>[...] emits Array<u64> (tc=108) blob with correct dense u64 layout
//  - stringify_document produces the expected <Type> [elem,...] text

package writ_typed_arr_lit;

use logos.lang.writ.hstatic;
use logos.mem.writ.stringify;
use logos.lang.writ.static_view;
use logos.lang.writ.anyval;
use logos.mem.string;
use logos.lang.str;

unsafe fn check(hs: &WritStatic, expected: str, err_code: i32) -> i32 {
    let s: String = stringify(hview2_from_ptr(hs.ptr).root());
    if !s.eq_str(expected) { return err_code; }
    return 0;
}

pub unsafe fn main() -> i32 {
    let mut rc: i32 = 0;

    // 1. @<I32>[10, 20, 30] → Array<i32> (tc=104) → "<I32> [10, 20, 30]"
    let lit1: WritStatic = @<I32>[10, 20, 30];
    rc = check(&lit1, "<I32> [10, 20, 30]", 1);
    if rc != 0 { return rc; }

    // 2. @<I32>[] — empty typed array
    let lit2: WritStatic = @<I32>[];
    rc = check(&lit2, "<I32> []", 2);
    if rc != 0 { return rc; }

    // 3. @<U64>[1, 2, 3, 4, 5] → Array<u64> (tc=108) → "<U64> [1, 2, 3, 4, 5]"
    let lit3: WritStatic = @<U64>[1, 2, 3, 4, 5];
    rc = check(&lit3, "<U64> [1, 2, 3, 4, 5]", 3);
    if rc != 0 { return rc; }

    // 4. @<U64>[] — empty u64 array
    let lit4: WritStatic = @<U64>[];
    rc = check(&lit4, "<U64> []", 4);
    if rc != 0 { return rc; }

    // 5. Negative i32 values
    let lit5: WritStatic = @<I32>[-1, 0, 1];
    rc = check(&lit5, "<I32> [-1, 0, 1]", 5);
    if rc != 0 { return rc; }

    return 0;
}
