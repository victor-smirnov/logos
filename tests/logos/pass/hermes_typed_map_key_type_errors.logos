// Typed map key typing errors for <I32>{...} / <I32,AnyVal>{...}.
package hermes_typed_map_key_type_errors;

use std.hermes.ctr;

unsafe fn main() -> i32 {
    // Quoted string key is invalid for i32-key map.
    let mut d1: Hermes = Hermes::new(4096);
    match d1.parse("<I32>{\"a\":1}" as *const u8, 12 as i64) {
        Result::Ok(()) => { return 1; }
        Result::Err(_) => {}
    }

    // Bare identifier key is invalid for i32-key map.
    let mut d2: Hermes = Hermes::new(4096);
    match d2.parse("<I32>{abc:1}" as *const u8, 12 as i64) {
        Result::Ok(()) => { return 2; }
        Result::Err(_) => {}
    }

    // Float key is invalid for i32-key map.
    let mut d3: Hermes = Hermes::new(4096);
    match d3.parse("<I32,AnyVal>{1.5:1}" as *const u8, 19 as i64) {
        Result::Ok(()) => { return 3; }
        Result::Err(_) => {}
    }

    // Out-of-range key is invalid for i32.
    let mut d4: Hermes = Hermes::new(4096);
    match d4.parse("<I32,AnyVal>{2147483648:1}" as *const u8, 26 as i64) {
        Result::Ok(()) => { return 4; }
        Result::Err(_) => {}
    }

    return 0;
}
