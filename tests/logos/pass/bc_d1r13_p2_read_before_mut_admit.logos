// ADMIT CONTROL for fail/bc_d1r13_p2_outparam_deposit. The loan is never raised (the callee/arm only READS
// the container), so the later mutation must stay ADMITTED. A refusal rule that
// cannot be told from over-refusal by its message alone is priced here.
package bc_d1r13_p2_read_before_mut_admit;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct H { r: &mut Vec<B> }
fn peek(h: &mut H, c: &C) -> i64 { return h.r.len() as i64; }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut h: H = H { r: &mut vs };
    let n: i64 = peek(&mut h, &c);
    c.bump();                        // must be ADMITTED
    return c.v + n;
}
