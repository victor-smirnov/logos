package hermes_buffer_string;
use logos.lang.fabric;
use logos.lang.fabric.string_store;
use logos.lang.hermes2.hstatic;
// Buffer<StrDt>: SoA storage (packed bytes + end offsets).  Push three
// strings, read them back via StringView, verify each byte.

use logos.lang.hermes2.hstatic;
use logos.lang.fabric;

unsafe fn bytes_eq(a: *const u8, b: *const u8, n: u64) -> bool {
    let mut i: u64 = 0 as u64;
    while i < n {
        let ap: *const u8 = (a as i64 + i as i64) as *const u8;
        let bp: *const u8 = (b as i64 + i as i64) as *const u8;
        if *ap != *bp { return false; }
        i = i + 1 as u64;
    }
    return true;
}

unsafe fn sv(s: str, n: u64) -> StringView {
    return StringView { ptr: s.as_ptr(), len: n };
}

unsafe fn main() -> i32 {
    let mut b: Buffer<StrDt> = Buffer::<StrDt>::new();
    if b.len() != 0 as u64 { return 1; }

    b.push(sv("alpha",  5 as u64));
    b.push(sv("",       0 as u64));
    b.push(sv("gamma!", 6 as u64));

    if b.len() != 3 as u64 { return 2; }

    let s0: StringView = b.get(0 as u64);
    if s0.len != 5 as u64 { return 10; }
    if !bytes_eq(s0.ptr, "alpha".as_ptr(), 5 as u64) { return 11; }

    let s1: StringView = b.get(1 as u64);
    if s1.len != 0 as u64 { return 20; }

    let s2: StringView = b.get(2 as u64);
    if s2.len != 6 as u64 { return 30; }
    if !bytes_eq(s2.ptr, "gamma!".as_ptr(), 6 as u64) { return 31; }

    // Force several bytes-buffer growths to exercise realloc.
    let mut k: i32 = 0;
    while k < 50 {
        b.push(sv("lorem-ipsum", 11 as u64));
        k = k + 1;
    }
    if b.len() != 53 as u64 { return 40; }

    let last: StringView = b.get(52 as u64);
    if last.len != 11 as u64 { return 41; }
    if !bytes_eq(last.ptr, "lorem-ipsum".as_ptr(), 11 as u64) { return 42; }

    return 0;
}
