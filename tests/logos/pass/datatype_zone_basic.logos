// Typed allocation in a writ arena (successor of the legacy zone basic test).
package datatype_zone_basic;
use logos.lang.writ.container;
use logos.lang.rc;

struct Point { x: i32, y: i32 }

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(4096);
    let h: &Writ = rc.deref();
    let hp: *mut Writ = h as *const Writ as *mut Writ;
    let p: *mut Point = writ_alloc::<Point>(hp);
    p.x = 18;
    p.y = 12;
    return p.x + p.y;   // 30
}
