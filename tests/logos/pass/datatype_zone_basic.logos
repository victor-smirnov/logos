package datatype_zone_basic;
// Phase 2: allocate a #[zoned] struct in a HermesZone, write and read fields.

use hermes.zone;

#[zoned] struct Point {
    x: i32,
    y: i32,
}

unsafe fn main() -> i32 {
    let mut zone: HermesZone = HermesZone::create(4096);
    let size: i64 = sizeof::<Point>();
    let raw: *mut u8 = zone.alloc_raw(size);
    let p: *mut Point = raw as *mut Point;
    // Write fields through the pointer
    p.x = 10;
    p.y = 20;
    // Read back and compute result
    let result: i32 = p.x + p.y;
    zone.destroy();
    return result;  // 30
}
