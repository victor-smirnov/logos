// Closed backlog localvec_homonym_listcomp_vec_leak (#16): a list comprehension beside a module-local type named
// `Vec` drops its elements — the destructor count is 3 (and valgrind on the p2 probes is clean). The measurement
// the entry named, taken once listcomp_value_elem_type_refused closed.
package localvec_homonym_listcomp_drops;
use logos.mem.collections.vec;
pub struct Vec<T> { a: i64, b: i64 }
struct D { c: *mut i64 }
impl Drop for D {
    fn drop(&mut self) { unsafe { *self.c = *self.c + 1i64; } }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let src: [i64; 3] = [1i64, 2i64, 3i64];
    {
        let v = [D { c: p } for x in src];
    }
    let got: i64 = unsafe { n };
    if got != 3i64 {
        return got as i32 + 10i32;
    }
    return 0i32;
}
