// THE LEGAL TWIN, ONE TOKEN APART: one input lifetime. Also pins what the
// walker must NOT count with two inputs: a 'static inside the arg, a named
// one, a fn-pointer return (its own elision scope), and `&self` + Option.
package bc_dclretargs_nested_ref_one_input;

static SEVEN: i64 = 7i64;

fn g(x: &i64, y: i64) -> Vec<&i64> {
    let mut v: Vec<&i64> = Vec::<&i64>::new();
    v.push(x);
    return v;
}
fn s(x: &i64, y: &i64) -> Vec<&'static i64> {
    let mut v: Vec<&'static i64> = Vec::<&'static i64>::new();
    v.push(&SEVEN);
    return v;
}
fn n<'a>(x: &'a i64, y: &i64) -> Option<&'a i64> { return Some(x); }
fn id(x: &i64) -> &i64 { return x; }
fn p(x: &i64, y: &i64) -> fn(&i64) -> &i64 { return id; }
struct H { v: i64 }
impl H { fn m(self: &H, o: &i64) -> Option<&i64> { return Some(&self.v); } }

fn main() -> i32 {
    let a: i64 = 1i64;
    let b: i64 = 2i64;
    if *g(&a, 0i64)[0] != 1i64 { return 1i32; }
    if *s(&a, &b)[0] != 7i64 { return 2i32; }
    match n(&a, &b) { Some(r) => { if *r != 1i64 { return 3i32; } } None => { return 4i32; } }
    if *(p(&a, &b))(&b) != 2i64 { return 5i32; }
    let h: H = H { v: 6i64 };
    match h.m(&a) { Some(r) => { if *r != 6i64 { return 6i32; } } None => { return 7i32; } }
    return 0i32;
}
