// Copyright 2026 Victor Smirnov
// pmap_assembled_client.logos — first full tie of pmap + the
// component-metaprog assembler. The assembler-metafn reads its cfg's
// "client" capability list and emits a `RoClient` wrapper around
// `PMapMut<K,V,CFG>` whose method set is a subset of pmap's full
// API:
//
//   "client" = ["read"]            → contains/get/len only
//   "client" = ["read", "write"]   → also insert
//
// The constructive read-only-ness lives in the type system: a
// RoClient assembled from cfg without "write" simply has no
// `insert` method — calling `client.insert(...)` would be a
// compile error on that branch. This is the core demonstrable
// architectural win of the assembler over runtime gates.
//
// Implementation note: all references to user-defined types
// (U64Key/U64Val/Cfg16) inside `quote_item!` route through `#ident`
// antiquots. The metafn body itself never references them — keeps
// the metacall JIT scope clean.

package main;

use std.compiler.metaprog;
use std.data.persistent.view;
use std.data.persistent.mutv;
use std.data.persistent.btree;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;
use std.hermes.anyval;
use std.hermes.string;

pub struct U64Key { pub x: u64, }
impl Primitive for U64Key { type Prim = u64; }
impl Ord for U64Key {
    fn cmp(&self, other: &Self) -> Ordering {
        if self.x < other.x { return Ordering::Less; }
        if self.x > other.x { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
pub struct U64Val { pub x: u64, }
impl Primitive for U64Val { type Prim = u64; }

pub const Cfg16: HermesStatic = @{ "key": <type:U64Key>, "value": <type:U64Val>, "fanout": 16 };

fn assemble_client<const ASMCFG: HermesStatic>() -> QuoteItemBlob {
    unsafe {
        let v = ASMCFG.as_view();

        // User-type names threaded as Idents — read from cfg as plain
        // strings so the metafn body never touches U64Key/Cfg16 etc.
        let k_av:   AnyVal = v.map_get(v.root(), "key_name");
        let k_sv:   StringView = v.get_str_view(k_av);
        let k_id:   Ident = Ident { ptr: k_sv.ptr, len: k_sv.len };
        let v_av:   AnyVal = v.map_get(v.root(), "val_name");
        let v_sv:   StringView = v.get_str_view(v_av);
        let v_id:   Ident = Ident { ptr: v_sv.ptr, len: v_sv.len };
        let cfg_av: AnyVal = v.map_get(v.root(), "cfg_name");
        let cfg_sv: StringView = v.get_str_view(cfg_av);
        let cfg_id: Ident = Ident { ptr: cfg_sv.ptr, len: cfg_sv.len };

        // Capability detection.
        let arr: AnyVal = v.map_get(v.root(), "client");
        let n: u64 = v.array_len(arr);
        let mut have_read:  bool = false;
        let mut have_write: bool = false;
        let mut i: u64 = 0u64;
        while i < n {
            let cap: AnyVal = v.array_get(arr, i);
            let cs: StringView = v.get_str_view(cap);
            if cs.len == 4u64
                && *((cs.ptr as i64 + 0i64) as *const u8) == 114u8
                && *((cs.ptr as i64 + 1i64) as *const u8) == 101u8
                && *((cs.ptr as i64 + 2i64) as *const u8) == 97u8
                && *((cs.ptr as i64 + 3i64) as *const u8) == 100u8 {
                have_read = true;
            }
            if cs.len == 5u64
                && *((cs.ptr as i64 + 0i64) as *const u8) == 119u8
                && *((cs.ptr as i64 + 1i64) as *const u8) == 114u8
                && *((cs.ptr as i64 + 2i64) as *const u8) == 105u8
                && *((cs.ptr as i64 + 3i64) as *const u8) == 116u8
                && *((cs.ptr as i64 + 4i64) as *const u8) == 101u8 {
                have_write = true;
            }
            i = i + 1u64;
        }

        if have_read && have_write {
            return quote_item! {
                pub struct RoClient { pub handle: PMapMut<#cfg_id>, }
                impl RoClient {
                    pub fn contains(&self, key: *const #k_id) -> bool {
                        unsafe { return self.handle.view.contains(key); }
                    }
                    pub fn len(&self) -> u64 {
                        unsafe { return self.handle.view.len(); }
                    }
                    pub fn insert(&mut self, key: u64, val: u64, qkey: *const #k_id) -> bool {
                        unsafe {
                            return pmap_mut_insert::<#k_id, #v_id, #cfg_id>(
                                &mut self.handle as *mut PMapMut<#cfg_id>,
                                key, val, qkey);
                        }
                    }
                }
            };
        }
        if have_read {
            return quote_item! {
                pub struct RoClient { pub handle: PMapMut<#cfg_id>, }
                impl RoClient {
                    pub fn contains(&self, key: *const #k_id) -> bool {
                        unsafe { return self.handle.view.contains(key); }
                    }
                    pub fn len(&self) -> u64 {
                        unsafe { return self.handle.view.len(); }
                    }
                }
            };
        }
        return quote_item! {
            pub struct RoClient { pub handle: PMapMut<#cfg_id>, }
        };
    }
}

metacall assemble_client::<@{
    "key_name": "U64Key",
    "val_name": "U64Val",
    "cfg_name": "Cfg16",
    "client":   ["read"],
}>();

unsafe fn main() -> i32 {
    let mut pm: PMapMut<Cfg16> = pmap_mut_new::<Cfg16>();
    let pmptr: *mut PMapMut<Cfg16> = &mut pm as *mut PMapMut<Cfg16>;

    let k1: U64Key = U64Key { x: 10u64 };
    let k2: U64Key = U64Key { x: 20u64 };
    let _ = pmap_mut_insert::<Cfg16>(pmptr, 10u64, 100u64, &k1 as *const U64Key);
    let _ = pmap_mut_insert::<Cfg16>(pmptr, 20u64, 200u64, &k2 as *const U64Key);

    let client: RoClient = RoClient { handle: pm };

    if client.len() != 2u64 { return 1; }
    if !client.contains(&k1 as *const U64Key) { return 2; }
    if !client.contains(&k2 as *const U64Key) { return 3; }
    let miss: U64Key = U64Key { x: 99u64 };
    if  client.contains(&miss as *const U64Key) { return 4; }

    pmap_mut_drop::<Cfg16>(&mut client.handle as *mut PMapMut<Cfg16>);
    return 0;
}
