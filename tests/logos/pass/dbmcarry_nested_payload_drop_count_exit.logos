// THE PROGRAM OF SOUNDNESS-QUEUE ROW nested_variant_payload_under_ref_double_drops
// (tier 1, `run 2`), landed as its pass half. A variant payload of a MOVE type bound
// inside a TUPLE pattern under a by-reference scrutinee had its destructor run TWICE:
// `build_pattern_impl`'s TUPLE door handed the sub-pattern the BARE element type, so
// `build_pattern_variant_data` re-derived the default binding mode as `move` and bound
// the payload BY VALUE — Drop-scheduled at arm exit AND again for the scrutinee.
// The count is read through a `static mut` AFTER the value's scope has ended, so a wrong
// count is an EXIT CODE: 2 on the base binary 95d01d3ae0a1858d, 0 here and in Rust.
// PAIR: fail/dbmcarry_ergo_tuple_scalar_mut_fail — the same tuple door, one modifier
// token that the Rust-2024 rule forbids.
package dbmcarry_nested_payload_drop_count_exit;
extern fn printf(fmt: *const u8, ...) -> i32;
static mut NDROP: i64 = 0i64;
struct S { pub n: i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { NDROP = NDROP + 1i64; } } }
fn inner() -> i64 {
    let p: (Option<S>, i64) = (Option::Some(S { n: 5i64 }), 9i64);
    let mut out: i64 = 0i64;
    match &p {
        (Option::Some(a), b) => { out = a.n + *b; },
        (Option::None, _) => {}
    }
    return out;
}
fn main() -> i32 {
    let out: i64 = inner();
    if out != 14i64 { return 3i32; }
    unsafe { if NDROP != 1i64 { return NDROP as i32; } }
    unsafe { printf("%ld\n".as_ptr(), NDROP); }
    return 0i32;
}
