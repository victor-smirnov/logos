// Closed soundness row box_field_move (#99). A partial move of a drop-carrying
// field out of a Box is legal Rust (Box is the one type with DerefMove). It used to
// free the moved String twice (rc 134). ADR 0028: `*b` of a stdlib Box is a built-in
// place projection, `(*b).s` is the move path `b.*.s`, and the box's drop drops what
// is left of the pointee and frees the block without running Box::drop.
package box_field_move;
use logos.mem.boxed;
use logos.mem.string;
struct Inner { s: String, n: i64 }
fn main() -> i32 {
    let bx: Box<Inner> = Box::new(Inner { s: String::from("abcdefghijklmnop"), n: 3i64 });
    let v: String = bx.s;
    if v.len() != 16i64 { return 1i32; }
    return 0i32;
}
