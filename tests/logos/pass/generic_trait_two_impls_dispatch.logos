// type arguments (`Converter<i32>` and `Converter<i64>`) dispatches each by the expected type. Stopped reproducing
// when the method probe took its candidates from the identity index (ADR 0030 S9b row 2), where both impls'
// methods are candidates. rustc twin: exit 0.
package generic_trait_two_impls_dispatch;
trait Converter<T> { fn convert(self: &Self) -> T; }
struct Num { v: i32 }
impl Converter<i32> for Num { fn convert(self: &Num) -> i32 { return self.v; } }
impl Converter<i64> for Num { fn convert(self: &Num) -> i64 { return self.v as i64; } }
fn main() -> i32 {
    let n: Num = Num { v: 7 };
    let a: i32 = n.convert();
    let b: i64 = n.convert();
    if a != 7 { return 1; }
    if b != 7i64 { return 2; }
    return 0;
}
