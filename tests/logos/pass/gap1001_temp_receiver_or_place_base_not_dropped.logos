// ADR 0030 S0-S7 gap audit 2026-10-01, cluster `temp-receiver-or-place-base-not-dropped` (pairs-10#13); rustc twin: the cluster .rs.
use logos.std.fmt;
struct B { id: i64 }
impl Drop for B { fn drop(&mut self) { println!("drop B {}", self.id); } }
impl B { fn hi(&self) -> i64 { self.id } }
fn make(k: i64) -> Box<B> { Box::new(B { id: k }) }
fn main() { println!("{}", make(7).hi()); println!("end"); }
