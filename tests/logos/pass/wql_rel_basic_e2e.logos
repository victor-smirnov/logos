// WQL REL BLOCKS — basic (static-Datalog slice B): ONE `rel` + an entry query
// with where/order over the rel scan.
//
//   rel e2(a: i64, b: i64) { <one simple body> }
//   from e2 s where s.b > lo select s.b order by s.b desc
//
// Exercises: the program envelope parse (rel block + entry), rel registration
// (2 i64 columns → native (i64, i64) rows), body emission into the per-rel
// helper fn with SET-dedup (HashSet<(i64,i64)> shadow — the new per-arity
// tuple Hash impls), the entry prelude (materialize + as_slice view), the
// rel-sourced scan (row var binds &(i64, i64); `s.b` emits the positional
// `s.1`), and the full order-by machinery over a rel scan.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

struct Edge { pub src: i64, pub dst: i64 }

pub deem big_dsts(edges: &[Edge], lo: i64) {
    rel e2(a: i64, b: i64) {
        from edges e where e.src > 0 select (e.src, e.dst);
    }
    from e2 s where s.b > lo select s.b order by s.b desc
}

fn main() -> i32 {
    let edges: [Edge; 4] = [
        Edge { src: 1i64, dst: 10i64 },
        Edge { src: 2i64, dst: 20i64 },
        Edge { src: 0i64, dst: 99i64 },   // filtered out by the body's where
        Edge { src: 3i64, dst: 15i64 },
    ];

    // rel e2 = {(1,10), (2,20), (3,15)}; entry: b > 12, desc → [20, 15].
    let out: Vec<i64> = big_dsts(&edges[..], 12i64).unwrap();
    if out.len() != 2i64      { return 1i32; }
    if out.get(0i64) != 20i64 { return 2i32; }
    if out.get(1i64) != 15i64 { return 3i32; }

    // Threshold excludes everything → empty.
    let none: Vec<i64> = big_dsts(&edges[..], 99i64).unwrap();
    if none.len() != 0i64 { return 4i32; }

    return 0i32;
}
