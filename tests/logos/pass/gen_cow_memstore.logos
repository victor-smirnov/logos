// gen_cow_memstore — the CoW map generated against the hand-written MemoryStore
// (ADR 0020 Track B, container⟂store split, increment 2b). One `kind ordered_map`
// declaration → Canon derives the shape → the handler emits the map's typed half
// (leaf/branch/cow_insert/descend_get + the `GenCow` Ctr handle), which now runs
// on the SHARED MemoryStore / MemorySnapshot instead of a generated store. main()
// mirrors the snapshot-isolation contract: version A fills [0,N), version B
// branches and appends [N,2N), and the frozen A still sees only [0,N) — the
// directory + rc reclamation keep the versions apart. Multi-level (branch)
// structure is forced by N ≫ one leaf.
package test;

use logos.lcm.canon.container_item;   // the `container` lowering handler
use logos.mem.pkd;                    // the generated leaf/branch target (PkdArray::format)
use logos.mem.bt.map;                 // Ctr trait (the generated `impl Ctr` names it)
use logos.mem.bt.memstore;            // MemoryStore, MemorySnapshot — the shared store

container GenCow for u8 { kind ordered_map; entry { key: u64, val: u64 } measure max(key); }

fn main() -> i32 {
    let mut store: MemoryStore = MemoryStore::new();
    let n: u64 = 2000u64;

    // ── version A: create container #1, fill [0, N) ──────────────────────
    let mut s0: MemorySnapshot = store.fork();
    if s0.snapshot_id() != 1u64 { return 1i32; }
    let m0: GenCow = GenCow::create(&mut s0, 1u64);
    let mut k: u64 = 0u64;
    while k < n { m0.insert(k, k + 7u64); k = k + 1u64; }
    if m0.size() != n { return 2i32; }
    store.commit(&s0);

    // ── version B: branch from A, append [N, 2N) — CoW copies the path ───
    let mut s1: MemorySnapshot = store.fork();
    if s1.snapshot_id() != 2u64 { return 3i32; }
    let m1: GenCow = GenCow::open(&mut s1, 1u64);
    if m1.get_or(0u64, 0xFFFFu64) != 7u64 { return 4i32; }
    if m1.get_or(n - 1u64, 0xFFFFu64) != (n - 1u64) + 7u64 { return 5i32; }
    k = n;
    while k < 2u64 * n { m1.insert(k, k + 7u64); k = k + 1u64; }
    store.commit(&s1);

    // ── ISOLATION: s0 (frozen) still sees ONLY [0, N); s1 sees [0, 2N) ───
    let m0b: GenCow = GenCow::open(&mut s0, 1u64);
    if m0b.size() != n { return 6i32; }
    if m1.size() != 2u64 * n { return 7i32; }
    k = 0u64;
    while k < n {
        if m0b.get_or(k, 0xFFFFu64) != k + 7u64 { return 8i32; }
        k = k + 1u64;
    }
    if m0b.get_or(n, 0xDEADu64) != 0xDEADu64 { return 9i32; }              // s1's key, absent in s0
    if m0b.get_or(2u64 * n - 1u64, 0xDEADu64) != 0xDEADu64 { return 10i32; }
    k = 0u64;
    while k < 2u64 * n {
        if m1.get_or(k, 0xFFFFu64) != k + 7u64 { return 11i32; }
        k = k + 1u64;
    }

    // ── teardown: each version drops its share; HEAD frees the rest ──────
    s1.release();
    s0.release();
    store.release();
    return 0i32;
}
