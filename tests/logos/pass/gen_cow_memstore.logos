// gen_cow_memstore — the CoW map generated against the hand-written MemoryStore
// (ADR 0020 Track B container⟂store split + ADR 0021 Phase 4b demand path).
// One `kind ordered_map` declaration lowers to a CFG doc + CtrClass
// alias; `create_ctr::<typeof(GenCow)>` fires the mono demand and the metaclass
// FACTORY generates the family (@hs-keyed leaf/branch + CoW handle, package
// logos.gen), which runs on the SHARED MemoryStore / MemorySnapshot. main()
// mirrors the snapshot-isolation contract: version A fills [0,N), version B
// branches and appends [N,2N), and the frozen A still sees only [0,N) — the
// directory + rc reclamation keep the versions apart. Multi-level (branch)
// structure is forced by N ≫ one leaf.
package test;

use logos.lcm.canon.container_item;   // the `container` lowering handler + the factory
use logos.lcm.canon.metaclass;        // create_ctr/open_ctr (ADR 0021 Phase 4b surface)
use logos.mem.pkd;                    // the generated leaf/branch target
use logos.mem.bt.map;                 // Ctr trait (the generated `impl Ctr` names it)
use logos.mem.bt.memstore;
use logos.mem.sync;   // Arc — the store/snapshot plane            // MemoryStore, MemorySnapshot — the shared store

container GenCow {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure max(key);
}

fn main() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();
    let n: u64 = 2000u64;

    // ── version A: create container #1, fill [0, N) ──────────────────────
    let mut s0: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    if s0.snapshot_id() != 1u64 { return 1i32; }
    let m0 = create_ctr::<typeof(GenCow)>(&s0, 1u64);
    let mut k: u64 = 0u64;
    while k < n { m0.insert(k, k + 7u64); k = k + 1u64; }
    if m0.size() != n { return 2i32; }
    s0.commit();

    // ── version B: branch from A, append [N, 2N) — CoW copies the path ───
    let mut s1: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    if s1.snapshot_id() != 2u64 { return 3i32; }
    let m1 = open_ctr::<typeof(GenCow)>(&s1, 1u64);
    if m1.get_or(0u64, 0xFFFFu64) != 7u64 { return 4i32; }
    if m1.get_or(n - 1u64, 0xFFFFu64) != (n - 1u64) + 7u64 { return 5i32; }
    k = n;
    while k < 2u64 * n { m1.insert(k, k + 7u64); k = k + 1u64; }
    s1.commit();

    // ── ISOLATION: s0 (frozen) still sees ONLY [0, N); s1 sees [0, 2N) ───
    let m0b = open_ctr::<typeof(GenCow)>(&s0, 1u64);
    if m0b.size() != n { return 6i32; }
    if m1.size() != 2u64 * n { return 7i32; }
    k = 0u64;
    while k < n {
        if m0b.get_or(k, 0xFFFFu64) != k + 7u64 { return 8i32; }
        k = k + 1u64;
    }
    if m0b.get_or(n, 0xDEADu64) != 0xDEADu64 { return 9i32; }              // s1's key, absent in s0
    if m0b.get_or(2u64 * n - 1u64, 0xDEADu64) != 0xDEADu64 { return 10i32; }
    k = 0u64;
    while k < 2u64 * n {
        if m1.get_or(k, 0xFFFFu64) != k + 7u64 { return 11i32; }
        k = k + 1u64;
    }

    // ── teardown: each version drops its share; HEAD frees the rest ──────
    return 0i32;
}
