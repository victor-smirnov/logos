// Test: OR-pattern with Hermes scalars must short-circuit correctly.

package hermes_match_or;

use logos.lang.hermes.anyval;
use logos.lang.hermes.pat;
use logos.lang.hermes.container;
use logos.lang.rc;

unsafe fn mk(v: HAny) -> Rc<Hermes> {
    let rc: Rc<Hermes> = hermes_rc(1024);
    let h: &Hermes = rc.deref();
    h.set_root(v);
    return rc;
}

unsafe fn check(d: &Rc<Hermes>) -> i32 {
    match d {
        @null | @42 => 1,
        @true | @-7 => 2,
        _ => 0,
    }
}

unsafe fn main() -> i32 {
    let a: Rc<Hermes> = mk(HAny::Ref(0 as *const u8));        // 1
    let b: Rc<Hermes> = mk(HAny::from(42 as i56));     // 1
    let c: Rc<Hermes> = mk(HAny::from(true));  // 2
    let d: Rc<Hermes> = mk(HAny::from(-7 as i56));     // 2
    let e: Rc<Hermes> = mk(HAny::from(100 as i56));    // 0
    return check(&a) + check(&b) + check(&c) + check(&d) + check(&e); // 6
}
