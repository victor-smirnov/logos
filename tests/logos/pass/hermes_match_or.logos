// Test: OR-pattern with Hermes scalars must short-circuit correctly.

package hermes_match_or;

use hermes.anyval;
use hermes.view;

unsafe fn check(d: HermesStatic) -> i32 {
    match d {
        @null | @42 => 1,
        @true | @-7 => 2,
        _ => 0,
    }
}

unsafe fn main() -> i32 {
    // 1 + 1 + 2 + 2 + 0 = 6
    return check(@null) + check(@42) + check(@true) + check(@-7) + check(@99);
}
