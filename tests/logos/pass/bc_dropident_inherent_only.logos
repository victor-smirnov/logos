// TWIN of bc_dropident_inherent_first with the `impl Drop` block DELETED: an
// inherent method that happens to be spelled `drop` is NOT a destructor and
// must not run at scope exit. The whole assertion is the ABSENCE of "I".
package bc_dropident_inherent_only;
extern fn printf(fmt: *const u8, ...) -> i32;
fn say(s: str) { unsafe { printf(s.as_ptr()); } }
struct R { id: i32 }
impl R {
    fn drop(self: &mut Self) -> i32 { say("I"); return 0i32; }
}
fn main() -> i32 {
    {
        let mut r: R = R { id: 7i32 };
    }
    say("|END");
    return 0i32;
}
