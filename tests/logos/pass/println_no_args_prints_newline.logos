// `println!()` with no arguments prints a bare newline, as in Rust (it used to
// be refused: "call to 'format_args_str': expected at least 1 args, got 0").
// `eprintln!()` likewise, and `writeln!(sink)` writes just "\n". rustc twin:
// stdout "a\n\nb\n", exit 0.
package println_no_args_prints_newline;
use logos.std.fmt;
use logos.mem.string;
use logos.mem.fmt;

fn main() -> i32 {
    println!("a");
    println!();
    println!("b");
    eprintln!();
    let mut s: String = String::new();
    let _ = writeln!(s);
    let _ = writeln!(s, "x{}", 1);
    if s.as_str() != "\nx1\n" { return 1; }
    return 0;
}
