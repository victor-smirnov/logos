// ADR 0030 S4 acceptance: feature-interaction audit cluster `unsize-in-aggregate-generic-ctor-slot`, member pairs-11_41
// (tests/interactions/clusters/unsize-in-aggregate-generic-ctor-slot/pairs-11_41.logos); rustc 1.98.1 twin gives the same stdout and exit code.
package y15b;
use logos.std.fmt;
use logos.lang.rc;
use logos.lang.cell;
trait Op { fn ap(&self) -> i64; }
struct A(i64);
impl Op for A { fn ap(&self) -> i64 { self.0 } }
fn main() { let b: Vec<Box<dyn Op>> = vec![Box::new(A(1)), Box::new(A(2))]; println!("{}", b[1].ap()); }
