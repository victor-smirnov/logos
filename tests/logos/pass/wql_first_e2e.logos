// WQL `select first` — single-row query mode e2e (ADR 0012 select-tail).
// `select first S` returns Option<ElemTy>: the FIRST projected value in scan
// order (early-exit loop — no Vec), or in ORDER BY order when `order by` is
// present (sort permutation, then head); Option::None when no row matches.
// Exercises: hit + miss (simple), first + order by desc, first + scalar param,
// join + first.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

struct Person { pub name: str, pub age: i64 }
struct Dept   { pub id: i64, pub label: str }

// hit: the first adult's name in SCAN order (Eve 12 skipped → Ada).
resource first_adult = deem!(people: &[Person]) { from people p where p.age >= 18 select first p.name : str };

// miss: nobody above 100 → None.
resource first_ancient = deem!(people: &[Person]) { from people p where p.age > 100 select first p.age };

// order by desc: the OLDEST person's name (sort first, then take the head).
resource oldest_name = deem!(people: &[Person]) { from people p select first p.name order by p.age desc : str };

// scalar param in the predicate (typed via the deem!(…) list).
resource first_over = deem!(people: &[Person], n: i64) { from people p where p.age >= n select first p.name : str };

// join + first: the first (x,d) match in scan order projects d.label.
resource first_dept = deem!(people: &[Person], depts: &[Dept]) { from people x join depts d on x.age == d.id select first d.label : str };

fn main() -> i32 {
    let people: [Person; 4] = [
        Person { name: "Eve",  age: 12i64 },
        Person { name: "Ada",  age: 45i64 },
        Person { name: "Bob",  age: 41i64 },
        Person { name: "Cleo", age: 70i64 },
    ];
    let depts: [Dept; 2] = [
        Dept { id: 45i64, label: "mgmt" },
        Dept { id: 41i64, label: "eng" },
    ];

    // hit → Some("Ada") (first in scan order past Eve).
    match first_adult(&people[..]) {
        Option::Some(n) => { if !str_eq(n, "Ada") { return 1i32; } }
        Option::None => { return 2i32; }
    }

    // miss → None.
    match first_ancient(&people[..]) {
        Option::Some(_) => { return 3i32; }
        Option::None => { }
    }

    // order by age desc → Cleo (70).
    match oldest_name(&people[..]) {
        Option::Some(n) => { if !str_eq(n, "Cleo") { return 4i32; } }
        Option::None => { return 5i32; }
    }

    // scalar param: >= 46 keeps only Cleo; >= 200 keeps nobody.
    match first_over(&people[..], 46i64) {
        Option::Some(n) => { if !str_eq(n, "Cleo") { return 6i32; } }
        Option::None => { return 7i32; }
    }
    match first_over(&people[..], 200i64) {
        Option::Some(_) => { return 8i32; }
        Option::None => { }
    }

    // join first: scan order hits Ada(45)×mgmt before Bob(41)×eng.
    match first_dept(&people[..], &depts[..]) {
        Option::Some(l) => { if !str_eq(l, "mgmt") { return 9i32; } }
        Option::None => { return 10i32; }
    }
    return 0i32;
}
