package datatype_zone_ergonomic;
// Phase 7: ergonomic DataRef<T> field access — p.x and p.x = val
// without explicit intermediate pointer variables.

use logos.lang.hermes.zone;

#[zoned] struct Point {
    x: i32,
    y: i32,
}

unsafe fn main() -> i32 {
    let mut z: Zone<Mutable> = zone_create(4096);

    // Allocate and wrap in DataRef; holder RC = 2.
    let mut p: DataRef<Point> = zone_alloc_typed::<Point>(&mut z);

    // Ergonomic write: compiler inserts mut_ptr() auto-deref.
    p.x = 15;
    p.y = 27;

    // Ergonomic read: compiler inserts ptr() auto-deref.
    let result: i32 = p.x + p.y;

    p.release();   // holder RC → 1
    z.release();   // holder RC → 0, freed

    return result;  // 42
}
