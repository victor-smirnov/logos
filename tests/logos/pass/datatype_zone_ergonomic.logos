// Ergonomic typed writes through the arena pointer (writ2 successor of the
// DataRef mut_ptr auto-deref test): plain *mut T field writes, never-move reads.
package datatype_zone_ergonomic;
use logos.lang.writ.container;
use logos.lang.rc;

struct Point { x: i32, y: i32 }

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(4096);
    let h: &Writ = rc.deref();
    let hp: *mut Writ = h as *const Writ as *mut Writ;
    let p: *mut Point = writ_alloc::<Point>(hp);
    p.x = 40;
    p.y = 2;
    p.x = p.x + p.y;        // read-modify-write through the same pointer
    let r: &Point = &*p;    // shared read view of the same never-move object
    return r.x;             // 42
}
