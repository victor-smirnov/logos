package bc_e0207_assoc_names_static_not_binder;
extern fn printf(fmt: *const u8, ...) -> i32;
struct S { n: i64 }
struct T3 { n: i64 }
trait Tr { type Item; fn go(self: Self) -> i64; }
impl<'zz> Tr for &S {
    type Item = &'static T3;
    fn go(self: Self) -> i64 { return 1i64; }
}
unsafe fn main() -> i32 {
    let s = S { n: 41i64 };
