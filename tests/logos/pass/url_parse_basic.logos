// Tests std.url url_parse / url_format.
package test;

use logos.std.io.net.url;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;

fn main() -> i32 {
    // http://example.com/
    match url_parse("http://example.com/") {
        Option::Some(u) => {
            if !u.scheme.eq_str("http")        { return 1; }
            if !u.host.eq_str("example.com")   { return 2; }
            if u.port != 0 - 1                 { return 3; }
            if !u.path.eq_str("/")             { return 4; }
            if u.query.len() != 0 as i64       { return 5; }
        }
        Option::None => { return 100; }
    }

    // http://host:8080/foo/bar?a=1&b=2#frag
    match url_parse("http://host:8080/foo/bar?a=1&b=2#frag") {
        Option::Some(u) => {
            if !u.scheme.eq_str("http")        { return 10; }
            if !u.host.eq_str("host")          { return 11; }
            if u.port != 8080                  { return 12; }
            if !u.path.eq_str("/foo/bar")      { return 13; }
            if !u.query.eq_str("a=1&b=2")      { return 14; }
        }
        Option::None => { return 101; }
    }

    // https://a.b/
    match url_parse("https://a.b/") {
        Option::Some(u) => {
            if !u.scheme.eq_str("https")       { return 20; }
            if url_default_port_s(&u.scheme) != 443 { return 21; }
        }
        Option::None => { return 102; }
    }

    // Empty host → None
    match url_parse("http://:80/") {
        Option::Some(_) => { return 30; }
        Option::None    => { }
    }

    // Missing scheme → None
    match url_parse("://x/") {
        Option::Some(_) => { return 31; }
        Option::None    => { }
    }

    // Bad port → None
    match url_parse("http://h:99999/") {
        Option::Some(_) => { return 32; }
        Option::None    => { }
    }

    // Round-trip via url_format
    match url_parse("http://example.com:8080/a?x=1") {
        Option::Some(u) => {
            let mut out: String = String::new();
            url_format(&u, &mut out);
            if !out.eq_str("http://example.com:8080/a?x=1") { return 40; }
        }
        Option::None => { return 103; }
    }

    // Default port omitted on format
    match url_parse("http://h:80/") {
        Option::Some(u) => {
            let mut out: String = String::new();
            url_format(&u, &mut out);
            if !out.eq_str("http://h/") { return 41; }
        }
        Option::None => { return 104; }
    }

    return 42;
}
