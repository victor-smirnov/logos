package class_abstract;
// F27: class with inheritance — methods on derived type
class Animal {
    val: i32;
    fn get(self: *mut Animal) -> i32 { return self.val; }
    fn doubled(self: *mut Animal) -> i32 { return self.val * 2; }
}
class Dog extends Animal {
    fn fetch(self: *mut Dog) -> i32 { return self.val + 10; }
}
fn main() -> i32 {
    let a: *mut Animal = new Animal { val: 5 };
    let d: *mut Dog = new Dog { val: 6 };
    let r1: i32 = a.get();       // 5
    let r2: i32 = a.doubled();   // 10
    let r3: i32 = d.get();       // 6
    let r4: i32 = d.fetch();     // 16
    delete a;
    delete d;
    // 5 + 10 + 6 + 16 + 5 = 42
    return r1 + r2 + r3 + r4 + 5;
}
