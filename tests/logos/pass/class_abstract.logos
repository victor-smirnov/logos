package class_abstract;
// F27: class with inheritance — methods on derived type
class Animal {
    val: i32,
    unsafe fn get(self: *mut Animal) -> i32 { return self.val; }
    unsafe fn doubled(self: *mut Animal) -> i32 { return self.val * 2; }
}
class Dog extends Animal {
    unsafe fn fetch(self: *mut Dog) -> i32 { return self.val + 10; }
}
unsafe fn main() -> i32 {
    let a: *mut Animal = new Animal { val: 5 };
    let d: *mut Dog = new Dog { val: 6 };
    let mut r1: i32 = 0; let mut r2: i32 = 0; let mut r3: i32 = 0; let mut r4: i32 = 0;
    unsafe {
        r1 = a.get();       // 5
        r2 = a.doubled();   // 10
        r3 = d.get();       // 6
        r4 = d.fetch();     // 16
        delete a;
        delete d;
    }
    return r1 + r2 + r3 + r4 + 5;
}
