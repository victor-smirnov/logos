// hermes_sdn_lit.logos — @-literals return HermesStatic (C8e); verify via stringify.
//
// Each @-literal produces a compile-time Hermes zone blob in rodata with an
// 8-byte size prefix.  HermesStatic.ptr points past the prefix to the blob;
// HermesStatic.size() reads the prefix via *(ptr - 8).
//
// We stringify via HermesRead.to_string() and compare to expected SDN text.

package hermes_sdn_lit;

use logos.lang.hermes.hstatic;
use logos.mem.hermes.stringify;       // stringify(HAny)
use logos.lang.hermes.static_view;  // HView2
use logos.lang.hermes.anyval;       // HAny
use logos.mem.string;
use logos.lang.str;

unsafe fn check(hs: &HermesStatic, expected: str, err_code: i32) -> i32 {
    let s: String = stringify(hview2_from_ptr(hs.ptr).root());
    if !s.eq_str(expected) {
        return err_code;
    }
    return 0;
}

pub unsafe fn main() -> i32 {
    let mut rc: i32 = 0;

    // 1. null
    let lit1: HermesStatic = @null;
    rc = check(&lit1, "null", 1);
    if rc != 0 { return rc; }

    // 2. true
    let lit2: HermesStatic = @true;
    rc = check(&lit2, "true", 2);
    if rc != 0 { return rc; }

    // 3. false
    let lit3: HermesStatic = @false;
    rc = check(&lit3, "false", 3);
    if rc != 0 { return rc; }

    // 4a. integer 42  (inline i24)
    let lit4: HermesStatic = @42;
    rc = check(&lit4, "42", 4);
    if rc != 0 { return rc; }

    // 4b. negative integer -1  (inline i24 with sign extension)
    let lit40: HermesStatic = @-1;
    rc = check(&lit40, "-1", 40);
    if rc != 0 { return rc; }

    // 5. string "hello"
    let lit5: HermesStatic = @"hello";
    rc = check(&lit5, "\"hello\"", 5);
    if rc != 0 { return rc; }

    // 6. array [1, 2, 3]
    let lit6: HermesStatic = @[1, 2, 3];
    rc = check(&lit6, "[1, 2, 3]", 6);
    if rc != 0 { return rc; }

    // 7. single-key map
    let lit7: HermesStatic = @{"k": 99};
    rc = check(&lit7, "{\"k\": 99}", 7);
    if rc != 0 { return rc; }

    // 8. size-prefix + nested stringify via the hermes2 reader.
    //    hermes_static_size reads *(ptr-8); HView2 reads the blob.
    let lit8: HermesStatic = @{"x": true};
    let sz: u64 = lit8.size();
    if sz == 0u64 { return 80; }
    let s8: String = stringify(hview2_from_ptr(lit8.ptr).root());
    if !s8.eq_str("{\"x\": true}") { return 8; }

    return 0;
}
