// PIN (2026-09-04land, root 2): `ref v` in a destructuring `let` BORROWS.
// TWIN of destruct_field_wild_through_deref, one token apart (`_` -> `ref v`).
// Pre-fix `v` was a by-value COPY of the field, so it and the referent both
// dropped it: run rc 134, valgrind 1 alloc / 2 frees. THE ASSERTION IS THE COUNT.
package destruct_field_ref_through_deref;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
static mut N: i64 = 0i64;
struct Owner { k: i64 }
impl Drop for Owner { fn drop(self: Owner) { unsafe { N = N + 1i64; } } }
struct A { o: Owner, t: i64 }
fn f(r: &A) -> i64 {
    let A { o: ref v, t: w } = *r;
    return v.k + w;
}
fn main() -> i32 {
    {
        let a: A = A { o: Owner { k: 7i64 }, t: 2i64 };
        let g: i64 = f(&a);
        if g != 9i64 { return 3i32; }
    }
    unsafe {
        printi("N=%d\n", N as i32);
        if N != 1i64 { return 1i32; }
    }
    return 0i32;
}
