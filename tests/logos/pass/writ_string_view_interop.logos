// Zone-string views from parsed documents (writ2 successor of the Writ1
// StringView interop test): array of strings -> per-element byte views.
package writ_string_view_interop;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.hstring;
use logos.mem.writ.parser;
use logos.lang.rc;
use logos.lang.str;

unsafe fn views_eq(a: str, b: str) -> bool { return str_eq(a, b); }

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(16384);
    let h: &Writ = rc.deref();
    let root: HAny = parse(h, "[\"hello\", \"\", \"world!\"]");
    if !root.is_array() { return 1; }
    let arr: &HArray<HAny> = &*(root.resolve() as *const HArray<HAny>);
    if arr.len() != 3i64 { return 2; }

    let s0: &HString = &*(arr.get(0).resolve() as *const HString);
    if !views_eq(s0.as_str(), "hello") { return 3; }
    let s1: &HString = &*(arr.get(1).resolve() as *const HString);
    if s1.len() != 0i64 { return 4; }
    let s2: &HString = &*(arr.get(2).resolve() as *const HString);
    if !views_eq(s2.as_str(), "world!") { return 5; }
    if s2.len() != 6i64 { return 6; }

    // Views alias zone bytes — no copies: pointer is inside the arena string.
    let p: *const u8 = s0.as_str().as_ptr();
    if *p != 104 as u8 { return 7; }    // 'h'

    return 0;
}
