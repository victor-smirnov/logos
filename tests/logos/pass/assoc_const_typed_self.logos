// An associated const typed by `Self` / `Self::Val`: the impl's `i64` / `M` conforms (Self substituted before the comparison), and `T::ZERO` through a bound is typed T.
package f20_assoc_const_self_type;
use logos.std.fmt;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.rc;
trait HasZero { const ZERO: Self; }
impl HasZero for i64 { const ZERO: i64 = 0; }
fn z<T: HasZero>() -> T { return T::ZERO; }
fn main() { let a: i64 = z(); println!("{} {}", a, i64::ZERO); }
