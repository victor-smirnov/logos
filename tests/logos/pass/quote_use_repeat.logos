// A quote carries a RUNTIME-SIZED import list (`#( use #us; )*`).
//
// An emitter's imports are sized while it runs: a query imports the module of
// each native source it happens to bind. A quote is otherwise a fixed shape, so
// the only way to carry that was a row of optional slots — one per import that
// might occur — which works (`quote_optional_use`) but has to be sized for the
// worst case and says nothing about what is actually there.
//
// The repeat form `field_def` already had for fields now exists for imports, so
// one slot covers any count. Uses are NOT items in this grammar — they are a
// separate list on the module and on the quote — which is why the repeat had to
// go on `any_use_decl`; putting it on `item` parses the `#` and then fails on
// the `use` inside, which is what the first attempt did.
//
// ⚠ THE ASSERTION IS THE COMPILE, and it only asserts if the imported package
// is otherwise UNREACHABLE. The first version of this test imported
// `logos.mem.collections.vec` and `logos.lang.option` — both reachable through
// the implicit prelude — so it passed while the mechanism was a complete no-op:
// the repeat group was copied into the synth module's USES verbatim, never
// numbered by the quote lowering, and dropped at splice time. Every package
// named here must therefore be one the entry module does NOT import and the
// prelude does NOT re-export; `Writ` and `Ident` are exactly that.
package test;

use logos.std.compiler.metaprog;

fn gen() -> QuoteItemBlob {
    let mut us: Vec<Ident> = vec_new::<Ident>();
    us.push(Ident::new("logos.lang.writ.container"));
    us.push(Ident::new("logos.mem.collections.vec"));
    return quote_item! {
        #( use #us; )*
        pub fn made() -> i64 {
            // Both imports are load-bearing: `Writ`/`writ_new` from the first
            // (NOT in the prelude — a quote with no imports fails to resolve
            // it), `Vec`/`vec_new` from the second.
            let _w: Writ = writ_new(1024i64);
            let mut v: Vec<i64> = vec_new::<i64>();
            v.push(41i64);
            return v.get(0i64) + 1i64;
        }
    };
}

metacall gen();

fn main() -> i32 {
    if made() != 42i64 { return 1i32; }
    return 0i32;
}
