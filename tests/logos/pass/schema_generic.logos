package test;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;

schema Wrap<T: WritField> : code(0x0007000000000000) { val: T = 0 }

// CRUX: field access in a GENERIC body — `w.val` lowers to `T__from_wany`; mono
// retargets T→concrete when get_val instantiates at i64 / bool.
fn get_val<T: WritField>(w: &Wrap<T>) -> T { return w.val; }

fn main() -> i32 {
    let h: Writ = writ_new(256i64);

    let bi: Wrap<i64> = h.make::<Wrap<i64>>();
    bi.val = 1152921504606846976i64;             // wide → boxed via z
    if bi.val != 1152921504606846976i64 { return 1i32; }
    if get_val::<i64>(&bi) != 1152921504606846976i64 { return 2i32; }

    let bb: Wrap<bool> = h.make::<Wrap<bool>>();
    bb.val = true;
    if !bb.val { return 3i32; }
    if !get_val::<bool>(&bb) { return 4i32; }

    // G4 distinct per-instance codes: a Wrap<i64> TOM binds as Wrap<i64>, NOT Wrap<u64>.
    let any_i: WAny = WAny::ref_to(bi.m as *const u8);
    match any_i.view_checked::<Wrap<i64>>() {
        Option::Some(w) => { if w.val != 1152921504606846976i64 { return 5i32; } }
        Option::None => { return 6i32; }
    }
    match any_i.view_checked::<Wrap<u64>>() {
        Option::Some(w) => { return 7i32; }
        Option::None => { }
    }
    return 0i32;
}
