// WDecimal accessor surface (writ): scale/coeff/is_neg/tag + container
// membership + is_decimal discrimination.
package writ_decimal_methods;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.decimal;
use logos.lang.rc;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(8192);
    let h: &Writ = rc.deref();

    let a: WAny = hdec_from_str(h, "123.45");
    if a.is_null() { return 1; }
    if !a.is_decimal() { return 2; }
    if a.as_decimal().scale() != 2u32 { return 3; }
    if a.as_decimal().coeff() != 12345u64 { return 4; }
    if a.as_decimal().is_neg() { return 5; }
    if h2_type_code(a.resolve()) != H2_DECIMAL { return 6; }

    let b: WAny = hdec_from_str(h, "-7");
    if !b.as_decimal().is_neg() { return 7; }
    if b.as_decimal().scale() != 0u32 { return 8; }

    // Non-decimals are rejected by the discriminator.
    if WAny::from(5 as i56).is_decimal() { return 9; }
    if WAny::from(true).is_decimal() { return 10; }

    return 0;
}
