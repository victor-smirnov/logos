// <Varchar[,AnyVal]>{...} is the ObjectMap spelled with a key type (writ2).
package writ_typed_map_default_materialize;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.hmap;
use logos.lang.writ.hstring;
use logos.mem.writ.parser;
use logos.lang.rc;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(8192);
    let h: &Writ = rc.deref();

    let m1: HAny = parse(h, "<Varchar>{\"a\":1,\"b\":2}");
    if !m1.is_map() { return 1; }
    let mm1: &HMap<HString, HAny> = &*(m1.resolve() as *const HMap<HString, HAny>);
    if mm1.get("a").as_i64() != 1i64 { return 2; }
    if mm1.get("b").as_i64() != 2i64 { return 3; }

    let m2: HAny = parse(h, "<Varchar,AnyVal>{\"x\":7}");
    if !m2.is_map() { return 4; }
    let mm2: &HMap<HString, HAny> = &*(m2.resolve() as *const HMap<HString, HAny>);
    if mm2.get("x").as_i64() != 7i64 { return 5; }
    return 0;
}
