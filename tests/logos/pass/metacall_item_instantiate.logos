// MC2.4 base case: a metafunction can emit `instantiate Foo<T>;` inside its
// QuoteItemBlob, and mono treats it as a root pin — even when no source code
// directly references the generic instance. The trait method `weight()` must
// resolve through dispatch, proving UserBox<i64> was instantiated.

package main;

use std.compiler.metaprog;
use std.hermes.view;

trait BoxLike { fn weight(self: Self) -> i64; }

struct UserBox<T> { v: T }

impl BoxLike for UserBox<i64> {
    fn weight(self: UserBox<i64>) -> i64 { return self.v; }
}

fn emit_inst() -> QuoteItemBlob {
    return quote_item! {
        instantiate UserBox<i64>;
    };
}

metacall emit_inst();

unsafe fn main() -> i32 {
    let b: UserBox<i64> = UserBox::<i64> { v: 42i64 };
    return b.weight() as i32;
}
