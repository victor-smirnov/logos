// Writ comprehension auto-coercion: i32, bool, str values (writ2).
package writ_comp_coerce;

use logos.lang.writ.comp_builder;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.static_view;
use logos.lang.rc;

fn main() -> i32 {
    let xs: [i32; 4] = [1, 2, 3, 4];

    // List comprehension with raw i32 value (auto-coerced to HAny).
    let la: Rc<Writ> = @[x * x for x in xs];

    // Bool value, auto-coerced.
    let lb: Rc<Writ> = @[(x % 2) == 0 for x in xs];

    // Map with string values — auto-coerced to HString in the zone.
    let keys: [str; 3] = ["a", "b", "c"];
    let idx:  [i32; 3] = [0, 1, 2];
    let md: Rc<Writ> = @{keys[x as i64]: "val" for x in idx};

    unsafe {
        let v0: HView2 = HView2 { base: 0 as *const u8 };

        // la: [1, 4, 9, 16]
        let ha: &Writ = la.deref();
        let ra: HAny = ha.root();
        if v0.array_len(ra) != 4u64 { return 1; }
        if v0.get_int(v0.array_get(ra, 2u64)) != 9i64 { return 2; }
        if v0.get_int(v0.array_get(ra, 3u64)) != 16i64 { return 3; }

        // lb: [false, true, false, true]
        let hb: &Writ = lb.deref();
        let rb: HAny = hb.root();
        if v0.array_len(rb) != 4u64 { return 4; }
        if !v0.get_bool(v0.array_get(rb, 1u64)) { return 5; }
        if v0.get_bool(v0.array_get(rb, 0u64)) { return 6; }

        // md: {"a": "val", "b": "val", "c": "val"}
        let hm: &Writ = md.deref();
        let rm: HAny = hm.root();
        if !rm.is_map() { return 7; }
        let v: HAny = v0.map_get(rm, "b");
        if !v.is_string() { return 8; }
        let sv: SView2 = v0.get_str_view(v);
        if sv.len != 3u64 { return 9; }
    }

    return 42;
}
