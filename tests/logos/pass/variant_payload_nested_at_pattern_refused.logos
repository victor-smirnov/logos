// Compiles and runs as in rustc 1.98.1 (squeue row of the same name).
package variant_payload_nested_at_pattern_refused;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
struct W { a: D, b: i64 }
enum E { V(W), Z }
fn g(p: *mut i64) -> i64 {
    let e: E = E::V(W { a: D { v: 2i64, c: p }, b: 3i64 });
    match e {
        E::V(y @ W { .. }) => { return y.b; }
        E::Z => { return 0i64; }
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, rd(p)); }
    if k != 3i64 { return 2i32; }
    if rd(p) != 2i64 { return 1i32; }
    return 0i32;
}
