// `q.N = v` THROUGH A LOCAL `&mut (T, U)` REACHES THE TUPLE. Was soundness-queue
// row tuple_index_write_through_local_refmut_clobbers_binding (tier 1, `run 1`) —
// the TupleIndex twin of the index row, ONE root: gen_expr_kind(EAddrOfTempView)
// routes IndexRead and `is_mut && TupleIndex` into the same gen_lvalue_addr call.
// PAIR: fail/refslot_tuple_write_not_mut_fail, one token apart (`let mut t` -> `let t`).
package refslot_tuple_write_local_refmut;
extern fn printf(fmt: *const u8, ...) -> i32;
fn main() -> i32 {
    let mut t: (i64, i64) = (1i64, 2i64);
    let q: &mut (i64, i64) = &mut t;
    q.0 = 77i64;
    unsafe { printf("t0=%ld t1=%ld\n".as_ptr(), t.0, t.1); }
    if t.0 != 77i64 { return 1i32; }
    if t.1 != 2i64 { return 2i32; }
    return 0i32;
}
