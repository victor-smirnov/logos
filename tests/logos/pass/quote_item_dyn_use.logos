// Dynamic package path in a quote_item! `use` — the path comes from a runtime
// ident (`use #pid;`) rather than a literal. The emitted code calls
// str_byte_at, which lives in logos.lang.str — a package that is NOT in the
// prelude and NOT imported by this file or the metafn — so it resolves ONLY if
// the dynamic `use #pid;` placeholder is substituted at splice time. (An earlier
// version imported Vec, which the prelude re-exports, masking the substitution.)
// Regression for the USES NAME_VAR substitution pass in logos_emit_item_blob_subst.
package main;

use logos.std.compiler.metaprog;
use logos.lang.writ.wstatic;

#[metaprog_handler("dyn_use")]
fn dyn_use_hook(target_offset: u32) -> () {
    let s: str = "Gen2";
    let id: Ident = Ident::new(s);
    let pkg: str = "logos.lang.str";
    let pid: Ident = Ident::new(pkg);
    let blob: QuoteItemBlob = quote_item! {
        use #pid;
        struct #id { }
        impl #id {
            pub static fn probe() -> i64 {
                // str_byte_at is reachable ONLY through the antiquoted `use #pid;`.
                return str_byte_at("A", 0i64) as i64;   // 'A' = 65
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}

#[dyn_use]
struct Marker2 {}

fn main() -> i32 {
    return Gen2::probe() as i32 - 65i32;
}
