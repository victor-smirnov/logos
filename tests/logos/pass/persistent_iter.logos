// Multi-level forward iter: insert N keys (creates a multi-level
// BTree at small fanout), iterate once, verify all keys appear in
// sorted order with correct values, exact count.
package persistent_iter;

use logos.std.data.persistent.handle;
use logos.std.data.persistent.store;
use logos.std.data.persistent.bt.node;
use logos.std.data.persistent.bt.cow;
use logos.std.data.persistent.bt.descent;
use logos.std.data.persistent.bt.mutate;
use logos.std.data.persistent.bt.iter;
use logos.lang.fabric;
use logos.lang.hermes.hstatic;

pub const StoreCfg: HermesStatic = @{
    "name": "iter", "ctr_id": <type:u64>, "snp_id": <type:u64>, "block_id": <type:u64>,
};
pub const MapCfg: HermesStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 4 };

fn main() -> i32 {
    let mut store = store_open::<StoreCfg>();
    let mut snap = store.fork(GENESIS);
    let mut cr =
        create_pmap::<MapCfg>(&mut snap, 1u64);

    // ── Empty iter ──
    {
        let it = cr.iter();
        if it.valid() { return 1; }
    }

    // Insert keys in shuffled order so multi-level structure is
    // exercised + iter must still produce sorted output.
    let order = [
        17u64, 5u64, 23u64, 1u64, 19u64, 11u64, 7u64, 29u64, 13u64, 3u64,
        25u64, 0u64, 21u64, 9u64, 27u64, 15u64, 28u64, 4u64, 12u64, 6u64,
        10u64, 18u64, 26u64, 24u64, 8u64, 14u64, 22u64, 2u64, 20u64, 16u64,
    ];
    let mut i = 0u64;
    while i < 30u64 {
        cr.insert(order[i as i64], order[i as i64] * 13u64);
        i = i + 1u64;
    }
    if cr.len() != 30u64 { return 2; }

    // Iter forward — keys 0..29 in order, values = key * 13.
    let mut it = cr.iter();
    let mut expect = 0u64;
    while it.valid() {
        let k = it.key();
        let v = it.val();
        if k != expect              { return 100 + expect as i32; }
        if v != expect * 13u64      { return 200 + expect as i32; }
        expect = expect + 1u64;
        it.step();
    }
    if expect != 30u64 { return 3; }

    // Remove half the keys; iter again over the rest.
    let mut r = 0u64;
    while r < 30u64 {
        if r % 2u64 == 0u64 { cr.remove(r); }
        r = r + 1u64;
    }
    if cr.len() != 15u64 { return 4; }

    let mut it2 = cr.iter();
    let mut want = 1u64;
    let mut count = 0u64;
    while it2.valid() {
        let k = it2.key();
        if k != want                { return 300 + want as i32; }
        want = want + 2u64;
        count = count + 1u64;
        it2.step();
    }
    if count != 15u64 { return 5; }

    return 0;
}
