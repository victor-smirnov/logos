// query_incr_sssp_fuzz — slice-7 INCREMENTAL RECURSIVE AGGREGATION (SSSP / R2,
// ADR 0013 §4.3). A single linear-recursive MIN aggregate rel maintained under
// ±edge deltas, differential-tested every epoch vs an INDEPENDENT array-based
// Bellman-Ford oracle (relax all edges |V| times) over the CURRENT edge set.
//
//   rel dist(node, d) {
//       from edges e where e.src == 0 select (e.dst, e.w);              // base: direct edges from source 0
//       from dist x join edges e on e.src == x.node
//            group by e.dst aggregate d = min(x.d + e.w) select (e.dst, d);  // relax
//   }
//   from dist r select (r.node, r.d)
//
// The recursive body absorbs each candidate (dst, x.d+e.w) against the per-node
// BEST (min) — the ⊓ meet IS the fixpoint gate; the maintained view is the
// champion map, projected as least distances (not the raw improvement log).
//
// GREEN here:
//   • INSERTIONS (true incremental, monotone improvement): a brand-new edge, an
//     off-path edge (no change), a strictly-shorter parallel edge — each seeded
//     off the ΔEDB and propagated to a best-fixpoint.
//   • RETRACTIONS (correct + terminating via RECOMPUTE — the design-blessed
//     "degrading toward recompute" fallback; NOT incrementally minimal): delete
//     an off-path edge (no change), delete the SHORTEST-path edge (distance
//     GROWS to the next-best surviving path), delete-then-re-add (round-trip).
//   • CYCLE stress: a positive cycle on the shortest-path support; deleting the
//     tree edge re-routes around the cycle with NO stale short distance.
//
// The incremental re-min-in-fixpoint (DRed-for-lattices) is the deferred R2
// followup: the additive-weight improvement log is INFINITE on a cycle, so a
// SET-semantics over-delete propagation does not terminate — recompute is the
// correct terminating retraction for this pass (see deem.logos epoch()).
//
// Node 0 is the source and has NO incoming edge (a pure source) so `dist` never
// contains node 0 — the oracle reports dist[v] for v != 0, v reachable.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.lang.arith;
use logos.mem.collections.vec;

pub schema Edge : code(0x0E07_0000_0000_0002) {
    src: i64 = 0,
    dst: i64 = 1,
    w:   i64 = 2,
}
resource cat = schema_catalog!{ Edge };

fn mk_edge(d: &Writ, s: i64, t: i64, w: i64) -> WAny {
    let e: Edge = d.make::<Edge>();
    e.src = s; e.dst = t; e.w = w;
    return WAny::ref_to((e.m as i64) as *const u8);
}

// Present-edge array (presence multiplicity > 0) bound as the `edges` source.
fn build_src(d: &Writ, hs: &Vec<WAny>, wts: &Vec<i64>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(256i64);
    let n: i64 = hs.len();
    let mut i: i64 = 0i64;
    while i < n {
        if wts.get(i) > 0i64 { arr.push(hs.get(i)); }
        i = i + 1i64;
    }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

// Toggle edge `idx` presence by `raw` (+1 present / -1 absent), staging the
// NETTED ±handle into `batch` (identity-coalesced by the engine).
fn edge_apply(hs: &Vec<WAny>, wts: &mut Vec<i64>, batch: &mut ZBatch, idx: i64, raw: i64) {
    let old: i64 = wts.get(idx);
    let mut neww: i64 = old + raw;
    if neww < 0i64 { neww = 0i64; }
    let eff: i64 = neww - old;
    wts.set(idx, neww);
    if eff != 0i64 { batch.push(hs.get(idx), eff); }
}

// ── INDEPENDENT reference: array Bellman-Ford over the CURRENT present edges.
// dist[0] = 0; relax every present edge |V| times. out[v] = INF ⇒ unreachable. ──
fn ref_dist(hs: &Vec<WAny>, wts: &Vec<i64>, out: &mut [i64; 32]) {
    let inf: i64 = 1000000000i64;
    let mut i: i64 = 0i64;
    while i < 32i64 { out[i] = inf; i = i + 1i64; }
    out[0] = 0i64;
    let mut it: i64 = 0i64;
    while it < 32i64 {
        let mut e: i64 = 0i64;
        while e < hs.len() {
            if wts.get(e) > 0i64 {
                let ed: Edge = hs.get(e).view::<Edge>();
                if out[ed.src] < inf {
                    let nd: i64 = out[ed.src] + ed.w;
                    if nd < out[ed.dst] { out[ed.dst] = nd; }
                }
            }
            e = e + 1i64;
        }
        it = it + 1i64;
    }
}

// DIFFERENTIAL check: snapshot champions (least distances) == Bellman-Ford ref
// for every node 1..31 (node 0 = source, excluded from `dist`). Returns true iff
// they agree cell-for-cell (as a per-node distance map).
fn agrees(eng: &IncrRec, hs: &Vec<WAny>, wts: &Vec<i64>) -> bool {
    let mut refd: [i64; 32] = [1000000000i64; 32];
    ref_dist(hs, wts, &mut refd);
    let inf: i64 = 1000000000i64;

    let mut snap: [i64; 32] = [1000000000i64; 32];
    let rows: QRows = eng.snapshot();
    let nr: i64 = rows.row_count();
    let mut r: i64 = 0i64;
    while r < nr {
        let node: i64 = rows.get_i64(r, 0i64);
        let dv:   i64 = rows.get_i64(r, 1i64);
        if node < 0i64 || node >= 32i64 { return false; }
        if node == 0i64 { return false; }   // dist must never contain the source
        snap[node] = dv;
        r = r + 1i64;
    }
    // per-node agreement for v != 0
    let mut v: i64 = 1i64;
    let mut want_cnt: i64 = 0i64;
    while v < 32i64 {
        let want: i64 = if refd[v] < inf { refd[v] } else { inf };
        if snap[v] != want { return false; }
        if want < inf { want_cnt = want_cnt + 1i64; }
        v = v + 1i64;
    }
    // row-count parity (no extra/duplicate champion rows)
    if nr != want_cnt { return false; }
    return true;
}


// ═══════════════════════════════════════════════════════════════════════════
// RANDOMIZED NASTY seed battery (adversary extension): random ±edge deltas over
// a small node/weight domain with forced cycles + parallel min-edges, emitted as
// weight-SPLIT + phantom net-zero ZBatch decompositions, differential-tested vs
// the Bellman-Ford oracle after EVERY epoch. Targets delete-the-shortest-edge
// (distance must GROW), positive-cycle-on-support delete, insert-then-retract
// coalesce, and empty epochs — the recursive MIN-aggregate retraction=recompute
// path plus the incremental insert path under nasty batches.
// ═══════════════════════════════════════════════════════════════════════════

struct Lcg { s: u64 }
impl Lcg {
    fn next(self: &mut Lcg) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
}
fn lcg_seed(seed: u64) -> Lcg {
    let mut l: Lcg = Lcg { s: wrapping_add(wrapping_mul(seed, 2862933555777941757u64), 3037000493u64) };
    let _w0: u64 = l.next();
    let _w1: u64 = l.next();
    return l;
}
fn rand_n(l: &mut Lcg, n: i64) -> i64 {
    if n <= 0i64 { return 0i64; }
    return (l.next() % (n as u64)) as i64;
}

// NASTY presence toggle: same net presence as edge_apply, split (eff+k)/(−k).
// Edge presence is weight>0 (a SET) so multiplicity is transparent — this drives
// the ± admit loop through an overshoot before it settles.
fn nasty_apply(hs: &Vec<WAny>, wts: &mut Vec<i64>, batch: &mut ZBatch,
               lcg: &mut Lcg, idx: i64, raw: i64) {
    let old: i64 = wts.get(idx);
    let mut neww: i64 = old + raw;
    if neww < 0i64 { neww = 0i64; }
    let eff: i64 = neww - old;
    wts.set(idx, neww);
    let k: i64 = rand_n(lcg, 4i64);
    let first: i64 = eff + k;
    if first != 0i64 { batch.push(hs.get(idx), first); }
    if k != 0i64 { batch.push(hs.get(idx), 0i64 - k); }
}

// PHANTOM net-zero pair on a random edge: +m/−m. On an absent edge it forces
// the retraction=RECOMPUTE path with no net change (a "deleted" edge that was
// never present); on a present edge a pure no-op. Distances must not move.
fn phantom_pair(hs: &Vec<WAny>, batch: &mut ZBatch, lcg: &mut Lcg, n: i64) {
    let m: i64 = rand_n(lcg, 3i64);
    if m == 0i64 { return; }
    let idx: i64 = rand_n(lcg, n);
    batch.push(hs.get(idx), m);
    batch.push(hs.get(idx), 0i64 - m);
}

// One seed → a T-epoch random ± sequence over the fixed edge pool. 0 on all
// epochs agreeing with Bellman-Ford, else 2+epoch.
fn run_seed(q: &Query, seed: u64, doc: &Writ, hs: &Vec<WAny>, init: &Vec<i64>) -> i32 {
    let ne: i64 = hs.len();
    let mut wts: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < ne { wts.push(init.get(i)); i = i + 1i64; }

    let mut env: QEnv = QEnv::new();
    env.bind_source("edges", build_src(doc, hs, &wts));
    let mut eng: IncrRec = match q.incremental_rec(&env) { Result::Ok(e) => { e } Result::Err(_e) => { return 99i32; } };
    if !agrees(&eng, hs, &wts) { return 1i32; }

    let mut lcg: Lcg = lcg_seed(seed);
    let mut ep: i64 = 0i64;
    while ep < 16i64 {
        let mut de: ZBatch = ZBatch::new();
        let empty: bool = rand_n(&mut lcg, 5i64) == 0i64;
        let nops: i64 = if empty { 0i64 } else { 1i64 + rand_n(&mut lcg, 3i64) };
        let mut o: i64 = 0i64;
        while o < nops {
            let idx: i64 = rand_n(&mut lcg, ne);
            let cur: i64 = wts.get(idx);
            // Bias toward TOGGLE (present→retract / absent→insert) so the
            // shortest-path support is frequently deleted and re-created.
            let raw: i64 = if cur > 0i64 { 0i64 - cur } else { 1i64 };
            nasty_apply(hs, &mut wts, &mut de, &mut lcg, idx, raw);
            o = o + 1i64;
        }
        phantom_pair(hs, &mut de, &mut lcg, ne);
        eng.epoch(&de);
        if !agrees(&eng, hs, &wts) { return (2i64 + ep) as i32; }
        ep = ep + 1i64;
    }
    return 0i32;
}

fn main() -> i32 {
    let doc: Writ = writ_new(1048576i64);
    let c: SchemaCatalog = cat();
    let q: Query = match Query::compile(
        r#"rel dist(node: i64, d: i64) {
             from edges e where e.src == 0 select (e.dst, e.w);
             from dist x join edges e on e.src == x.node
                 group by e.dst aggregate d = min(x.d + e.w) select (e.dst, d);
           }
           from dist r select (r.node, r.d)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };

    // ── edge pool: nodes 0..3 (0 = pure source, NO edge into 0), every ordered
    // pair (src,dst) with dst != 0, src != dst, in TWO parallel copies with
    // DIFFERENT weights (min-of-parallel + delete-shortest-grows). Cycles present
    // (1->2 & 2->1, etc.) so the positive-cycle-on-support delete is exercised. ──
    let mut hs: Vec<WAny> = vec_new::<WAny>();
    let mut s: i64 = 0i64;
    while s < 4i64 {
        let mut dd: i64 = 1i64;
        while dd < 4i64 {
            if s != dd {
                // two parallel weights, deterministic + distinct per (s,dd)
                let w1: i64 = 2i64 + ((s * 3i64 + dd) % 7i64);
                let w2: i64 = 3i64 + ((s * 5i64 + dd * 2i64) % 9i64);
                hs.push(mk_edge(&doc, s, dd, w1));
                hs.push(mk_edge(&doc, s, dd, w2));
            }
            dd = dd + 1i64;
        }
        s = s + 1i64;
    }
    let ne: i64 = hs.len();

    // initial present set: a connected spine 0->1->2->3 + 0->2 (both parallels
    // of each present so min-selection is live). Use handle indices via a helper.
    let mut init: Vec<i64> = vec_new::<i64>();
    let mut z: i64 = 0i64;
    while z < ne { init.push(0i64); z = z + 1i64; }
    // present the FIRST parallel copy of a few spine edges (indices computed by
    // scanning the pool for the desired (src,dst)).
    let mut e: i64 = 0i64;
    while e < ne {
        let ed: Edge = hs.get(e).view::<Edge>();
        let sp: bool = (ed.src == 0i64 && ed.dst == 1i64)
                    || (ed.src == 1i64 && ed.dst == 2i64)
                    || (ed.src == 2i64 && ed.dst == 3i64)
                    || (ed.src == 0i64 && ed.dst == 2i64);
        if sp { init.set(e, 1i64); }
        e = e + 1i64;
    }

    let mut seed: u64 = 0u64;
    while seed < 150u64 {
        let r: i32 = run_seed(&q, seed, &doc, &hs, &init);
        if r != 0i32 { return 100i32 + r; }
        seed = seed + 1u64;
    }
    return 0i32;
}
