// `order by` IN THE DYNAMIC TIER — PART c OF THREE: u64, usize, f32, f64, bool, str.
//
// ⚠⚠ NO BLOCK IN THIS FILE ASSERTS A WRONG ORDER ANY MORE — and the shape that
// got them all closed is worth keeping, because the next defect in this family
// will be pinned the same way. Each wrong cell was asserted AS WRONG beside a
// FIXED SIGNATURE arm holding the order it OUGHT to produce, with its own exit
// code, so that a fix announced itself as a fix rather than as a generic
// mismatch. Both of this file's defects then closed by REPRODUCING the recorded
// signature exactly: f32 on 2026-08-04 (exit 104's block) and u64/usize on
// 2026-08-05 (exit codes 93 and 99 fired, position for position). Nothing below
// was ever re-read off a run. Same idiom, same reason, as
// `tests/logos/fail/wql_agg_avg_struct_arg_fail.logos`.
//
// ── THE EXPERIMENT ──────────────────────────────────────────────────────────
// One schema, eighteen typed columns, four rows, one placement for every column:
// row 0 holds the column's third-largest value, row 1 its SMALLEST, row 2 its
// LARGEST, row 3 its second-smallest. So sorting by the column's own order must
// hand back the ids 1, 3, 0, 2 — the same four numbers for every type — and a
// tier that sorted by anything else (a SIGNED compare at 64 bits over `u64`
// gives 0, 2, 1, 3) says so by producing a DIFFERENT sequence rather than by
// refusing. `bool` has only two distinct values, so the id order within a tie is
// not a fact this fixture may assert; the two groups are.
//
// ── THE TWO DEFECTS THIS FAMILY CARRIED, BOTH NOW CLOSED ────────────────────
//  • `u64` and `usize` (part c) — CLOSED 2026-08-05. `wany_to_rt`
//    (stdlib/mem/deem/deem.logos) has ONE integer arm, `RtVal::I(i64)`, so every
//    value at or above 2^63 arrives NEGATIVE; `order by` then answered the SIGNED
//    order, ids 0, 2, 1, 3 over rows {2^63, 0, 2^64-1, 1}. ⚠ THE ROOT WAS NOT
//    `RtVal`, AND WIDENING IT WAS NOT THE FIX. The static tier answered the same
//    query correctly all along (`wql_domain_static_extremes` pins ids 1, 3, 0, 2
//    over the same four values) because its emitted key vector is typed with the
//    key's OWN type — `Vec<u64>`, so the language lowers `<` to `ult`. The
//    runtime tiers had no such carrier: `schema_catalog!` emitted a `u64` column
//    as `"ty":"i64"`, and the signedness was destroyed one step before any
//    comparison site could ask for it. The remedy carries the column's own type
//    NAME on the blob (`"src"`), derives `ElTy.ord == EL_ORD_WRAP` from it once,
//    and consumes that one bit at the comparison seams through
//    `el_wrap_ord_key` — the same shape as the float arc's `f64_data_key`.
//  • `f32` (part c) — CLOSED 2026-08-04. `WAny::as_f64` read the boxed payload as
//    `*const f64` without consulting the Ref's type code, so every f32 arrived as
//    its own 32 bits zero-extended into an f64 — four positive denormals whose
//    order is the order of those bit patterns, ids 0, 2, 3, 1.
//    `wql_domain_runtime_extremes` pins the same accessor on the values.
//
// ⚠ WHAT IS STILL A DIFFERENTIAL AND MUST STAY ONE: parts a and b of this family
// carry u8/u16/u24/u32/u56, whose orders were NEVER wrong (every value is
// non-negative in i64, so the signed compare already agreed) and which the
// remedy leaves alone — it asks each type's own `ord`, not its signedness. Those
// green blocks are the control on this fix: if the key were applied by class
// rather than by derived order fidelity, they would move.
//
// ── WHY THREE FILES ─────────────────────────────────────────────────────────
// An `order by` cannot be shared across columns, so eighteen columns need
// eighteen queries. Measured on this box, logosc costs ~2.1 s per compile/run
// site in this shape; the pass-test timeout is 30 s
// (tests/logos/CMakeLists.txt:701) and the single-file draft TIMED OUT solo,
// before any suite contention. Six columns per file keeps each near 6 s.
//
// ⚠ THE EXPECTATIONS ARE HAND-DERIVED CONSTANTS. Nothing here asks `el_ty`,
// `RtVal` or any survey artifact what the answer is
// (`feedback_oracle_must_be_independent`).
//
// EXIT CODES: base = 20 + 6*i for the i-th COLUMN OF THE EIGHTEEN (so the codes
// identify the column across all three files and do not collide), with +0 any
// failure of that column's order — compile Err, run Err, row count or
// permutation. The +1 codes (93 for u64, 99 for usize) were the DEFECT-CLOSED
// arms; both fired on 2026-08-05 and their blocks were rewritten to the OUGHT
// they had been carrying. All codes are ≤ 123; the exit status is 8-bit.
//
// exit 0 = these six columns each order by their OWN order.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.wql.wql;
use logos.mem.deem;
use logos.lang.result;
use logos.lang.str;
use logos.lang.num.float;
use logos.mem.collections.vec;

pub schema R : code(0x0E66_0000_0000_0004) {
    id: i64 = 0,
    x_i8: i8 = 1,
    x_i16: i16 = 2,
    x_i32: i32 = 3,
    x_i64: i64 = 4,
    x_isize: isize = 5,
    x_i24: i24 = 6,
    x_i56: i56 = 7,
    x_u8: u8 = 8,
    x_u16: u16 = 9,
    x_u32: u32 = 10,
    x_u24: u24 = 11,
    x_u56: u56 = 12,
    x_u64: u64 = 13,
    x_usize: usize = 14,
    x_f32: f32 = 15,
    x_f64: f64 = 16,
    x_bool: bool = 17,
    x_str: str = 18
}
resource cat = schema_catalog!{ R };

fn mkr(d: &Writ, id: i64, v_i8: i8, v_i16: i16, v_i32: i32, v_i64: i64, v_isize: isize, v_i24: i24, v_i56: i56, v_u8: u8, v_u16: u16, v_u32: u32, v_u24: u24, v_u56: u56, v_u64: u64, v_usize: usize, v_f32: f32, v_f64: f64, v_bool: bool, v_str: str) -> WAny {
    let r: R = d.make::<R>();
    r.id = id;
    r.x_i8 = v_i8;
    r.x_i16 = v_i16;
    r.x_i32 = v_i32;
    r.x_i64 = v_i64;
    r.x_isize = v_isize;
    r.x_i24 = v_i24;
    r.x_i56 = v_i56;
    r.x_u8 = v_u8;
    r.x_u16 = v_u16;
    r.x_u32 = v_u32;
    r.x_u24 = v_u24;
    r.x_u56 = v_u56;
    r.x_u64 = v_u64;
    r.x_usize = v_usize;
    r.x_f32 = v_f32;
    r.x_f64 = v_f64;
    r.x_bool = v_bool;
    r.x_str = v_str;
    return WAny::ref_to((r.m as i64) as *const u8);
}

fn main() -> i32 {
    let d: Writ = writ_new(65536i64);
    let c: SchemaCatalog = cat();
    let a: &mut WArray<WAny> = d.array(5i64);
    a.push(mkr(&d, 0i64,
              1i8,
              1i16,
              1i32,
              1i64,
              1isize,
              1i24,
              1i56,
              128u8,
              32768u16,
              2147483648u32,
              8388608u24,
              36028797018963968u56,
              9223372036854775808u64,
              9223372036854775808usize,
              0.1f32,
              0.1f64,
              true,
              "ccc"));
    a.push(mkr(&d, 1i64,
              -128i8,
              -32768i16,
              -2147483648i32,
              -9223372036854775808i64,
              -9223372036854775808isize,
              -8388608i24,
              -36028797018963968i56,
              0u8,
              0u16,
              0u32,
              0u24,
              0u56,
              0u64,
              0usize,
              -1048576.5f32,
              -1.0e300f64,
              false,
              "aaa"));
    a.push(mkr(&d, 2i64,
              127i8,
              32767i16,
              2147483647i32,
              9223372036854775807i64,
              9223372036854775807isize,
              8388607i24,
              36028797018963967i56,
              255u8,
              65535u16,
              4294967295u32,
              16777215u24,
              72057594037927935u56,
              18446744073709551615u64,
              18446744073709551615usize,
              1048576.5f32,
              1.0e300f64,
              true,
              "ddd"));
    a.push(mkr(&d, 3i64,
              -1i8,
              -1i16,
              -1i32,
              -1i64,
              -1isize,
              -1i24,
              -1i56,
              1u8,
              1u16,
              1u32,
              1u24,
              1u56,
              1u64,
              1usize,
              -1.5f32,
              -1.5f64,
              false,
              "bbb"));
    let mut e: QEnv = QEnv::new();
    e.bind_source("ss", WAny::ref_to(a as *const WArray<WAny> as *const u8));

    // ── u64 ── code 92   ✅ CLOSED 2026-08-05 (the compare seam)
    // The permutation below is the FIXED SIGNATURE this block carried while it
    // was pinned wrong — the column's own ascending order, written as the OUGHT
    // before any fix existed. It fired on exit code 93, exactly as designed, and
    // the fix reproduced it position for position. The root was never the sort:
    // the catalog emitted this column as `"ty":"i64"` and its SIGNEDNESS died
    // there, so the comparator had two `RtVal::I` and no way to ask. The column's
    // own type name now rides the catalog blob as `"src"`, `ElTy.ord` turns it
    // into one bit on the plan, and `rt_cmp` keys through `el_wrap_ord_key`.
    let q_u64: Query = match Query::compile("from ss s select s.id order by s.x_u64", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 92i32; } };
    let r_u64: QRows = match q_u64.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 92i32; } };
    if r_u64.row_count() != 4i64 { return 92i32; }
    // the column's OWN ascending order, asserted position by position.
    if r_u64.get_i64(0i64, 0i64) != 1i64 { return 92i32; }
    if r_u64.get_i64(1i64, 0i64) != 3i64 { return 92i32; }
    if r_u64.get_i64(2i64, 0i64) != 0i64 { return 92i32; }
    if r_u64.get_i64(3i64, 0i64) != 2i64 { return 92i32; }

    // ── usize ── code 98   ✅ CLOSED 2026-08-05 (the compare seam)
    // Same OUGHT, same fix, and the two columns closing together is the point:
    // nothing about `usize` is spelled anywhere in the remedy. `ElTy` already
    // stores that it is a 64-bit unsigned type, `el_ord_of` already derived that
    // its order does not survive normalization into i64, and the fix consumes
    // that derivation — so a `u48` added tomorrow needs no edit here, and u8..u56
    // (whose order DOES survive) are untouched, as their green blocks in parts a
    // and b of this family say.
    let q_usize: Query = match Query::compile("from ss s select s.id order by s.x_usize", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 98i32; } };
    let r_usize: QRows = match q_usize.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 98i32; } };
    if r_usize.row_count() != 4i64 { return 98i32; }
    if r_usize.get_i64(0i64, 0i64) != 1i64 { return 98i32; }
    if r_usize.get_i64(1i64, 0i64) != 3i64 { return 98i32; }
    if r_usize.get_i64(2i64, 0i64) != 0i64 { return 98i32; }
    if r_usize.get_i64(3i64, 0i64) != 2i64 { return 98i32; }

    // ── f32 ── code 104   ✅ CLOSED 2026-08-04 (slice A)
    // The permutation below was written as the OUGHT before any fix existed, and
    // the one-line dispatch in `WAny::as_f64` produced exactly it. The root was
    // the accessor reading eight bytes out of a four-byte W_F32 box — not the
    // sort, not `RtVal`.
    let q_f32: Query = match Query::compile("from ss s select s.id order by s.x_f32", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 104i32; } };
    let r_f32: QRows = match q_f32.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 104i32; } };
    if r_f32.row_count() != 4i64 { return 104i32; }
    // the column's OWN ascending order, asserted position by position.
    if r_f32.get_i64(0i64,0i64) != 1i64 { return 104i32; }
    if r_f32.get_i64(1i64,0i64) != 3i64 { return 104i32; }
    if r_f32.get_i64(2i64,0i64) != 0i64 { return 104i32; }
    if r_f32.get_i64(3i64,0i64) != 2i64 { return 104i32; }

    // ── f64 ── codes 110..110
    let q_f64: Query = match Query::compile("from ss s select s.id order by s.x_f64", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 110i32; } };
    let r_f64: QRows = match q_f64.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 110i32; } };
    if r_f64.row_count() != 4i64 { return 110i32; }
    if r_f64.get_i64(0i64, 0i64) != 1i64 { return 110i32; }
    if r_f64.get_i64(1i64, 0i64) != 3i64 { return 110i32; }
    if r_f64.get_i64(2i64, 0i64) != 0i64 { return 110i32; }
    if r_f64.get_i64(3i64, 0i64) != 2i64 { return 110i32; }

    // ── bool ── codes 116..116
    let q_bool: Query = match Query::compile("from ss s select s.id order by s.x_bool", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 116i32; } };
    let r_bool: QRows = match q_bool.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 116i32; } };
    if r_bool.row_count() != 4i64 { return 116i32; }
    // only two distinct values, so the id order WITHIN a tie is not a
    // fact this fixture may assert; the two groups are.
    if r_bool.get_i64(0i64,0i64) + r_bool.get_i64(1i64,0i64) != 4i64 { return 116i32; }
    if r_bool.get_i64(2i64,0i64) + r_bool.get_i64(3i64,0i64) != 2i64 { return 116i32; }

    // ── str ── codes 122..122
    let q_str: Query = match Query::compile("from ss s select s.id order by s.x_str", &c) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 122i32; } };
    let r_str: QRows = match q_str.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 122i32; } };
    if r_str.row_count() != 4i64 { return 122i32; }
    if r_str.get_i64(0i64, 0i64) != 1i64 { return 122i32; }
    if r_str.get_i64(1i64, 0i64) != 3i64 { return 122i32; }
    if r_str.get_i64(2i64, 0i64) != 0i64 { return 122i32; }
    if r_str.get_i64(3i64, 0i64) != 2i64 { return 122i32; }
    return 0i32;
}
