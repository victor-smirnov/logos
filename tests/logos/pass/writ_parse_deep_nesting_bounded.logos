// REGRESSION: the Writ recursive-descent parser must not stack-overflow (SIGSEGV)
// on deeply-nested adversarial-but-valid input. Before the depth guard in
// logos.mem.writ.parser, `[[[…42…]]]` with ~20000 nesting levels recursed one
// native C-stack frame per '[' and crashed the process (EXIT=139). The fix caps
// nesting at WRIT_PARSE_MAX_DEPTH (512): past the cap parse_value returns null and
// the enclosing container loops unwind into a bounded best-effort doc — never a
// crash. Also asserts shallow nesting still parses correctly (guard is far above
// any real document).
package writ_parse_deep_nesting_bounded;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.mem.writ.parser;
use logos.lang.rc;
use logos.mem.string;
use logos.lang.str;

fn build_nest(depth: i64) -> String {
    let mut s: String = String::new();
    let mut i: i64 = 0i64;
    while i < depth { s.push_str("["); i = i + 1i64; }
    s.push_str("42");
    i = 0i64;
    while i < depth { s.push_str("]"); i = i + 1i64; }
    return s;
}

fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(1i64 << 22i64);
    let h: &Writ = rc.deref();

    // 1) Adversarial deep nesting well past the crashing threshold (was SIGSEGV).
    //    Must return WITHOUT crashing (bounded partial parse or null — either is fine).
    let deep: String = build_nest(20000i64);
    let root: WAny = parse(h, deep.as_str());
    // A depth just over the cap must also survive.
    let mid: String = build_nest(600i64);
    let _r2: WAny = parse(h, mid.as_str());

    // 2) Shallow nesting (well within the cap) must still parse correctly:
    //    [[[42]]] -> array whose sole element is an array … innermost holds 42.
    let shallow: WAny = parse(h, "[[[42]]]");
    if shallow.is_null() { return 1; }
    if !shallow.is_array() { return 2; }
    let a0: &WArray<WAny> = shallow.as_array();
    if a0.len() != 1i64 { return 3; }
    let e0: WAny = a0.get(0i64);
    if !e0.is_array() { return 4; }
    let a1: &WArray<WAny> = e0.as_array();
    let e1: WAny = a1.get(0i64);
    if !e1.is_array() { return 5; }
    let a2: &WArray<WAny> = e1.as_array();
    let leaf: WAny = a2.get(0i64);
    if !leaf.is_int() { return 6; }
    if leaf.as_i64() != 42i64 { return 7; }

    // Reference the deep root so it is not optimized away.
    if root.raw() == 12345678i64 { return 8; }
    return 0;
}
