// ONE TOKEN from fail/dbmcarry_ergo_tuple_scalar_mut_fail (`mut a` -> `a`): with no
// binding modifier written, the default binding mode is by-reference and the
// nested payload binds `&i64`, so the read spells `*a` and the program is legal.
// This is the pass half of soundness-queue row match_ergo_nested_tuple_mut_admit.
package dbmcarry_ergo_tuple_scalar_nomut;
extern fn printf(fmt: *const u8, ...) -> i32;
fn main() -> i32 {
    let p: (Option<i64>, i64) = (Option::Some(3i64), 9i64);
    let mut out: i64 = 0i64;
    match &p {
        (Option::Some(a), b) => { out = *a + *b; },
        (Option::None, _) => {}
    }
    if out != 12i64 { return 1i32; }
    unsafe { printf("%ld\n".as_ptr(), out); }
    return 0i32;
}
