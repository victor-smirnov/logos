// `'outer: while let` with `continue 'outer` from an inner loop drops the binding on every path (6 drops, n = 2) PROBES.md 2026-09-06d: `if let` / `while let` / let-chains lower BY DELEGATION to lower_match (temp hoist, per-arm scrutinee move, arm drops, cond-move merge); the count is a destructor tally through a raw pointer.
package bc_patown_labeled_whilelet_continue;
use logos.mem.collections.vec;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn mk(p: *mut i64, v: i64) -> Option<S> { return Option::Some(S { v: v, i: p }); }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    let mut n: i64 = 0i64;
    {
        let mut vs: Vec<S> = Vec::new();
        vs.push(S { v: 1i64, i: p });
        vs.push(S { v: 2i64, i: p });
        vs.push(S { v: 3i64, i: p });
        'outer: while let Option::Some(s) = vs.pop() {
            let mut i: i64 = 0i64;
            loop {
                i = i + 1i64;
                if i > 1i64 { continue 'outer; }
                if s.v == 2i64 { break; }
            }
            n = n + s.v;
        }
    }
    return (c * 10i64 + n) as i32;
}
