// Debug — primitive impls. Exercises the trait via generic dispatch
// (`dbg_to(...)`) so we can mix bool/u64/i64 in one driver without
// per-call `as` casts.
package debug_primitives;

use std.fmt;
use logos.mem.string;
use logos.lang.str;
use std.io;

fn dbg_to<T: Debug>(v: &T, buf: &mut String) {
    let s: String = fmt_debug_to_string::<T>(v);
    buf.push_str(s.as_str());
    buf.push_u8(32 as u8);
}

unsafe fn main() -> i32 {
    let mut s: String = String::new();
    let a: i32 = 0 - 7;
    dbg_to::<i32>(&a, &mut s);
    let b: bool = true;
    dbg_to::<bool>(&b, &mut s);
    let c: u64 = 42 as u64;
    dbg_to::<u64>(&c, &mut s);
    let n: i64 = 0 - 999;
    dbg_to::<i64>(&n, &mut s);
    println_string(&s);
    return 42;
}
