// WQL RECURSIVE AGGREGATION (slice 1) — single-source shortest path as a
// recursive rel carrying a MONOTONE min aggregate, converging to the least
// fixpoint on the per-key (min,+) lattice.
//
//   rel dist(node, d) {
//       from src s                             select (s.id, 0);        // seed
//       from dist x join edges e on e.src==x.node
//            group by e.dst aggregate d = min(x.d + e.w) select (e.dst, d);  // relax
//   }
//
// The recursive body is an aggregate whose head is `min` (an idempotent
// meet-semilattice ⇒ fixpoint-safe): each derived candidate `(dst, x.d+e.w)`
// is ABSORBED against the running best per node — kept iff it strictly improves.
// The semi-naïve driver drives the improvement wave off the delta; the round
// guard aborts (never hangs) if a negative-weight cycle destroys convergence.
//
// DIFFERENTIAL ORACLE: an INDEPENDENT array-based Bellman-Ford in this same file
// (relax all edges |V| times) computes the reference distances; the wql result
// must equal it as a sorted (node, dist) row-set.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

struct Node { pub id: i64 }
struct Edge { pub src: i64, pub dst: i64, pub w: i64 }

resource sssp = wql!(src: &[Node], edges: &[Edge]) {
    rel dist(node: i64, d: i64) {
        from src s select (s.id, 0);
        from dist x join edges e on e.src == x.node
            group by e.dst
            aggregate d = min(x.d + e.w)
            select (e.dst, d);
    }
    from dist r select (r.node, r.d) order by r.node
};

// ── Independent reference: array Bellman-Ford (relax all edges maxid times) ──
fn ref_sssp(edges: &[Edge], source: i64, maxid: i64) -> Vec<(i64, i64)> {
    let inf: i64 = 1000000000i64;
    let mut dist: [i64; 32] = [1000000000i64; 32];
    dist[source] = 0i64;
    let mut it: i64 = 0i64;
    while it < maxid {
        let mut e: i64 = 0i64;
        while e < edges.len() {
            let ed: &Edge = &edges[e];
            if dist[ed.src] < inf {
                let nd: i64 = dist[ed.src] + ed.w;
                if nd < dist[ed.dst] { dist[ed.dst] = nd; }
            }
            e = e + 1i64;
        }
        it = it + 1i64;
    }
    let mut out: Vec<(i64, i64)> = Vec::<(i64, i64)>::new();
    let mut i: i64 = 1i64;
    while i <= maxid {
        if dist[i] < inf { out.push((i, dist[i])); }
        i = i + 1i64;
    }
    return out;
}

fn main() -> i32 {
    // Classic Dijkstra example (source = node 1). Shortest distances:
    //   1:0  2:7  3:9  4:20  5:20  6:11
    let src: [Node; 1] = [ Node { id: 1i64 } ];
    let edges: [Edge; 9] = [
        Edge { src: 1i64, dst: 2i64, w: 7i64  },
        Edge { src: 1i64, dst: 3i64, w: 9i64  },
        Edge { src: 1i64, dst: 6i64, w: 14i64 },
        Edge { src: 2i64, dst: 3i64, w: 10i64 },
        Edge { src: 2i64, dst: 4i64, w: 15i64 },
        Edge { src: 3i64, dst: 4i64, w: 11i64 },
        Edge { src: 3i64, dst: 6i64, w: 2i64  },
        Edge { src: 4i64, dst: 5i64, w: 6i64  },
        Edge { src: 6i64, dst: 5i64, w: 9i64  },
    ];

    let got: Vec<(i64, i64)> = sssp(&src[..], &edges[..]);
    let want: Vec<(i64, i64)> = ref_sssp(&edges[..], 1i64, 6i64);

    if got.len() != want.len() { return 1i32; }
    let mut k: i64 = 0i64;
    while k < got.len() {
        let g: (i64, i64) = got.get(k);
        let w: (i64, i64) = want.get(k);
        if g.0 != w.0 { return 2i32; }
        if g.1 != w.1 { return 3i32; }
        k = k + 1i64;
    }
    // Spot-check the known optimum for node 5 (1→3→6→5 = 9+2+9 = 20).
    let n5: (i64, i64) = got.get(4i64);
    if n5.0 != 5i64  { return 4i32; }
    if n5.1 != 20i64 { return 5i32; }
    return 0i32;
}
