package hermes_typetag;
// Phase 11: alloc_tagged + ShortTypeCode constants + tag read helpers.

use hermes.zone;
use hermes.typetag;

unsafe fn main() -> i32 {
    let mut zone: HermesZone = HermesZone::create(4096);

    // --- ShortTypeCode constants ---
    if hermes_tag_string()   != 0 as u8  { return 1; }
    if hermes_tag_array()    != 1 as u8  { return 2; }
    if hermes_tag_map()      != 2 as u8  { return 3; }
    if hermes_tag_document() != 3 as u8  { return 4; }

    // --- alloc_tagged: first allocation ---
    // Reserves 2 tag bytes before the object, aligns to 8.
    // With zone.offset=0: pre=2, aligned=8, object at base+8, offset becomes 16.
    let type_h: u8 = 0x5A as u8;
    let desc:   u8 = hermes_tag_map();       // descriptor = 2
    let obj: *mut u8 = zone.alloc_tagged(8, type_h, desc);

    // tag byte [obj-2] = type_hash
    let got_hash: u8 = tag_read_hash(obj as *const u8);
    if got_hash != 0x5A as u8            { return 5; }

    // tag byte [obj-1] = 1 | (descriptor << 3)
    // descriptor = 2 → tag1 = 1 | 16 = 17; tag_read_descriptor = 17>>3 = 2
    let got_desc: u8 = tag_read_descriptor(obj as *const u8);
    if got_desc != 2 as u8              { return 6; }

    // --- Second alloc_tagged (type_hash=0 → hermes_tag_string) ---
    let obj2: *mut u8 = zone.alloc_tagged(16, hermes_tag_string(), hermes_tag_document());
    let got_h2: u8 = tag_read_hash(obj2 as *const u8);
    if got_h2 != hermes_tag_string()     { return 7; }
    let got_d2: u8 = tag_read_descriptor(obj2 as *const u8);
    if got_d2 != hermes_tag_document()   { return 8; }  // descriptor = 3

    // --- alloc_tagged vs alloc_raw: objects must not overlap ---
    // obj points to zone base+8 (size 8), so its end is base+16.
    // obj2: pre = 16+2 = 18, aligned = 24, obj2 = base+24.
    let obj_int:  i64 = obj  as i64;
    let obj2_int: i64 = obj2 as i64;
    // obj2 must come after obj (at least 8 bytes gap for obj's size + 2 tag bytes).
    if obj2_int <= obj_int + 8 as i64   { return 9; }

    zone.destroy();
    return 42;
}
