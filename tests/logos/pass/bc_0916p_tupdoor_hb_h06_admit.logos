// hand battery: round 2026-09-16p-tupdoor, program h06 — caught: the same door under an OR-pattern
// join. collect_pat_bindings (mlir_gen_stmt.cpp) has no Struct arm, so the two alts could have been
// given no SHARED alloca for x/y; a wrong answer here is a miscompile, not a refusal. Measured to bind
// correctly on the landed binary; refused "undefined variable 'x'" on the base one.
// legality: rustc 1.98.1 --edition 2024 compiles and runs it, exit 0.
package bc_0916p_tupdoor_hb_h06_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let sv: (P, i64) = (P { x: 1i64, y: 2i64 }, 9i64);
    let mut got: i64 = 0i64;
    match sv {
        (P { x, y }, 9i64) | (P { x, y }, 8i64) => { got = x + y; }
        _ => { got = 100i64; }
    }
    unsafe { printf("got=%ld\n".as_ptr(), got); }
    if got != 3i64 { return 1i32; }
    return 0i32;
}
