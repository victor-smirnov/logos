// wql_mapping_rules_escape_e2e — the `mapping` item's `<M>__rules()` literal,
// pinned BYTE FOR BYTE over rule text that needs escaping.
//
// WHY THIS EXISTS. `__mapping_item` emits `<M>__rules() -> str` whose body is a
// string LITERAL holding the mapping's rel text verbatim. Three bytes cannot
// appear raw in a Logos literal — `"`, `\` and a newline — so the emitter
// escapes them, and since ADR 0024 S5 the escaped literal is REIFIED
// (`parse_expr`) and spliced into a quoted item instead of being pushed as
// source text. That makes the compiler's own lexer responsible for turning the
// escapes back into bytes, which is a round trip the corpus did not exercise at
// all: NO mapping anywhere in it has a `"` or a `\` inside a rel body (the
// quotes in the other mapping tests are all in CONSUMER deems), so the only
// escape ever run was the newline.
//
// So this file puts all three in one mapping and checks two independent things:
//   §A `Esc__rules()` equals the expected text EXACTLY — one `str_eq` against a
//      literal written out here, which fails on a single wrong byte. A
//      round-trip that dropped a backslash or doubled a quote would still
//      produce a *plausible* string, so the count/shape assertions the other
//      mapping tests make would not see it.
//   §B the text is still USABLE: the dynamic consumer
//      (`Query::compile_with_mapping`) reparses those very bytes and the query
//      returns the same rows as the static twin. §A pins the bytes, §B pins
//      that they mean what they meant.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.mem.writ.parser;
use logos.std.wql.wql;
use logos.std.wql.mapping_item;
use logos.mem.deem;
use logos.mem.collections.vec;
use logos.lang.str;
use logos.std.io;

// A `"` (the string literals), a `\` (inside one of them) and newlines (the
// bodies span lines) — the full escape set in one mapping. The indentation is
// load-bearing: the rel text travels VERBATIM, so §A's expected literal
// reproduces these exact leading spaces.
pub mapping Esc(g: &Writ) {
    pub rel pg(owner: i64) {
        from g ** .engine e where e.vs == "pg" select e.parent;
    }
    pub rel backslash(owner: i64) {
        from g ** .engine e where e.vs == "p\\g" select e.parent;
    }
}

// the static twin — the same rel, compiled at the item seam.
pub deem s_pg(w: Esc) { from pg p select p.owner }

fn main() -> i32 {
    // ── §A the literal, byte for byte ──────────────────────────────────────
    // `\"` here is a quote IN the rules text; `\\\\` is the two characters
    // backslash-backslash that the mapping source itself spells.
    let want: str = "rel pg(owner: i64) {\n        from g ** .engine e where e.vs == \"pg\" select e.parent;\n    }\nrel backslash(owner: i64) {\n        from g ** .engine e where e.vs == \"p\\\\g\" select e.parent;\n    }\n";
    if !str_eq(Esc__rules(), want) {
        println("§A rules text mismatch; got:");
        println(Esc__rules());
        return 1i32;
    }
    if !str_eq(Esc__src(), "g") { return 2i32; }

    // ── §B the same bytes, reparsed by the dynamic consumer ───────────────
    let doc: Writ = parse_writ(r#"{ db: { engine: "pg" }, cache: { engine: "redis" } }"#);

    let st: Vec<i64> = match s_pg(&doc)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 3i32; } };
    if st.len() != 1i64 { return 4i32; }

    let cat: SchemaCatalog = SchemaCatalog::new();
    let q: Query = match Query::compile_with_mapping(
        "from pg p select p.owner", &cat,
        "w", Esc__rules(), Esc__src())
    { Result::Ok(v) => { v } Result::Err(e) => { println(e.msg.as_str()); return 5i32; } };
    let mut env: QEnv = QEnv::new();
    env.bind_source_tree("w", doc.root());
    let rows: QRows = match q.run(&env)
    { Result::Ok(v) => { v } Result::Err(e) => { println(e.msg.as_str()); return 6i32; } };
    if rows.row_count() != st.len() { return 7i32; }
    if rows.get_i64(0i64, 0i64) != st.get(0i64) { return 8i32; }

    // The backslash rel is not just carried — it is COMPILABLE from the
    // carried text: `p\g` matches nothing in the document, so it must run and
    // return zero rows rather than fail to parse.
    let q2: Query = match Query::compile_with_mapping(
        "from backslash b select b.owner", &cat,
        "w", Esc__rules(), Esc__src())
    { Result::Ok(v) => { v } Result::Err(e) => { println(e.msg.as_str()); return 9i32; } };
    let rows2: QRows = match q2.run(&env)
    { Result::Ok(v) => { v } Result::Err(e) => { println(e.msg.as_str()); return 10i32; } };
    if rows2.row_count() != 0i64 { return 11i32; }

    return 0i32;
}
