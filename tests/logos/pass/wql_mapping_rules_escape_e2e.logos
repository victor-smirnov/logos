// wql_mapping_rules_escape_e2e — a `mapping` whose rule text needs escaping,
// consumed through static fusion.
//
// WHY THIS EXISTS. A mapping's rel bodies reach a consumer as TEXT: the
// compiler's `mappings_` pre-scan records each mapping's canonical rule text
// and splices it into the consumer's program, which is parsed again there.
// Three bytes cannot appear raw in a Logos string literal — `"`, `\` and a
// newline — and NO other mapping in the corpus has a `"` or a `\` inside a
// rel body (the quotes in the other mapping tests are all in CONSUMER deems).
// So this file puts all three in one mapping and consumes both rels:
//   §A `backslash` — its literal spells `p\\g` in the source, so it matches the
//      document value `p\g` only if the backslash survives the splice as ONE
//      backslash. A doubled or dropped one matches nothing (the doc also holds
//      `pg`, so a dropped backslash matches the wrong row).
//   §B `pg` — the plain quote case.
//
// HISTORY (#353, 2026-10-03). §A used to compare the emitted `Esc__rules()`
// literal byte for byte, and before P5 a dynamic consumer reparsed it. Both the
// artifact fns and their reader are gone; what is checked now is the path the
// rule text actually takes into a query. Exit codes 1, 2 and 5–11 are retired,
// not reused.
package test;

use logos.lang.writ.container;
use logos.mem.writ.parser;
use logos.std.wql.wql;
use logos.std.wql.mapping_item;
use logos.mem.collections.vec;
use logos.lang.str;
use logos.std.io;

// A `"` (the string literals), a `\` (inside one of them) and newlines (the
// bodies span lines) — the full escape set in one mapping.
pub mapping Esc(g: &Writ) {
    pub rel pg(owner: i64) {
        from g ** .engine e where e.vs == "pg" select e.parent;
    }
    pub rel backslash(owner: i64) {
        from g ** .engine e where e.vs == "p\\g" select e.parent;
    }
}

// the consumers — each rel compiled at the item seam and fused.
pub deem s_pg(w: Esc) { from pg p select p.owner }
pub deem s_bs(w: Esc) { from backslash p select p.owner }

fn main() -> i32 {
    let doc: Writ = parse_writ(r#"{ db: { engine: "pg" }, cache: { engine: "redis" }, odd: { engine: "p\\g" } }"#);

    // ── §A the backslash survives the splice as one byte ───────────────────
    let bs: Vec<i64> = match s_bs(&doc)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 13i32; } };
    if bs.len() != 1i64 { return 14i32; }
    if bs.get(0i64) == 0i64 { return 15i32; }

    // ── §B the plain quote case ────────────────────────────────────────────
    let st: Vec<i64> = match s_pg(&doc)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 3i32; } };
    if st.len() != 1i64 { return 4i32; }
    // hand-derived: only `db` carries `engine == "pg"`, and the owner projected
    // by `select e.parent` is that node's OWN handle, never the reserved
    // non-handle 0 that the virtual root edge uses
    // (`stdlib/mem/wql/writ_graph.logos`). MEASURED: a `!= 0` here was the first
    // spelling of this line and it FAILED at exit 12 when written as `== 0`, so
    // the assertion is reading a real projected word and not a default.
    if st.get(0i64) == 0i64 { return 12i32; }
    // the two owners are different nodes
    if st.get(0i64) == bs.get(0i64) { return 16i32; }

    return 0i32;
}
