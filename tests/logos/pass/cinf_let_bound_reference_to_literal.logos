// `let x = &(7, 8); f(x)` with `f(p: &(i64, i64))`: the literal's leaves take i64 from the use (ADR 0030
// C-INF: every unsuffixed literal is an integer variable, and the extending borrow's temporary holds the
// variables). Was squeue row let_bound_reference_to_literal_refused: refused "expected &(i64, i64), got
// &({integer}, {integer})"; before 2026-09-28 it read i32 leaves as i64. rustc twin: exit 0.
package cinf_let_bound_reference_to_literal;
fn f(p: &(i64, i64)) -> i64 { p.0 * 100 + p.1 }
fn main() -> i32 { let x = &(7, 8); if f(x) != 708 { return 1i32; } return 0i32; }
