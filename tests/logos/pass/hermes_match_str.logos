// Test: Hermes string pattern — @"str" matches HermesString root.

package hermes_match_str;

use logos.lang.hermes.anyval;
use logos.mem.hermes.ctr;
use logos.lang.hermes.view;
use logos.mem.hermes.view;
use logos.lang.hermes2.pat;   // hermes_pat_eq_str — `@"str"` pattern helper

unsafe fn mk_str(s: str) -> Hermes {
    let mut c: Hermes = Hermes::builder(128 as i64);
    let v: AnyVal = c.build_str(s);
    c.set_root(v);
    return c;
}

unsafe fn mk_i(i: i32) -> Hermes {
    let mut c: Hermes = Hermes::builder(128 as i64);
    c.set_root(AnyVal::embed_i24(i));
    return c;
}

unsafe fn classify(d: &Hermes) -> i32 {
    match d {
        @"hello" => 1,
        @"world" => 2,
        @42      => 3,
        _        => 0,
    }
}

unsafe fn main() -> i32 {
    let a: Hermes = mk_str("hello");
    let b: Hermes = mk_str("world");
    let c: Hermes = mk_i(42);
    let d: Hermes = mk_str("other");
    // 1+2+3+0 = 6
    return classify(&a) + classify(&b) + classify(&c) + classify(&d);
}
