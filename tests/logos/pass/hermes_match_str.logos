// Test: Hermes string pattern — @"str" matches HermesString root.

package hermes_match_str;

use logos.lang.hermes.anyval;
use logos.lang.hermes.pat;   // hermes_pat_eq_str — `@"str"` pattern helper
use logos.lang.hermes.container;
use logos.lang.hermes.hstring;
use logos.lang.rc;

unsafe fn mk_str(s: str) -> Rc<Hermes> {
    let rc: Rc<Hermes> = hermes_rc(1024);
    let h: &Hermes = rc.deref();
    let hs: &HString = h.hstring(s);
    h.set_root(HAny::from(hs));
    return rc;
}

unsafe fn mk_i(i: i32) -> Rc<Hermes> {
    let rc: Rc<Hermes> = hermes_rc(1024);
    let h: &Hermes = rc.deref();
    h.set_root(HAny::from(i as i56));
    return rc;
}

unsafe fn classify(d: &Rc<Hermes>) -> i32 {
    match d {
        @"hello" => 1,
        @"world" => 2,
        @42      => 3,
        _        => 0,
    }
}

unsafe fn main() -> i32 {
    let a: Rc<Hermes> = mk_str("hello");
    let b: Rc<Hermes> = mk_str("world");
    let c: Rc<Hermes> = mk_i(42);
    let d: Rc<Hermes> = mk_str("other");
    // 1+2+3+0 = 6
    return classify(&a) + classify(&b) + classify(&c) + classify(&d);
}
