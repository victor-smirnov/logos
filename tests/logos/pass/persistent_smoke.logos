// Smoke test for logos.std.data.persistent — rebuild of the persistent
// store on dyn-trait dispatch. Verifies that the package's primitives
// (NodeBase header, NodeARC handle, BranchNode/LeafNode/LeafDirNode
// concrete types) compose into a working rc'd tree with recursive
// release through the auto-Drop chain.
//
// Tree under test:
//
//     Branch
//     ├── Leaf(data, vals=[10u64, 20u64])
//     └── Leaf(data, vals=[30u64])
//
// Plus a separate LeafDirNode that stores NodeARCs (= directory leaf):
//
//     LeafDir
//     ├── leaf_a (rc shared with the data tree)
//     └── leaf_b
//
// Drop counters via *mut u64 (drop_count fields on the concrete impls)
// let us assert the full release chain fired correctly.

package zz_v3_smoke;

use logos.mem.collections.vec;
use logos.lang.mem;
use logos.lang.cmp; use logos.lang.cmp; use logos.lang.fabric;
use logos.lang.drop;
use logos.lang.hermes.hstatic;

use logos.std.data.persistent.bt.node;
use logos.std.data.persistent.bt.cow;

pub const StoreCfg: HermesStatic = @{
    "name":     "smoke",
    "ctr_id":   <type:u64>,
    "snp_id":   <type:u64>,
    "block_id": <type:u64>,
};

pub const DataCfg: HermesStatic = @{
    "key":    <type:u64>,
    "value":  <type:u64>,
    "fanout": 8,
};

pub const DirCfg: HermesStatic = @{
    "key":    <type:u64>,
    "fanout": 16,
};

fn main() -> i32 {
    // ── Stage 1 — single data leaf, NodeARC, drop ─────────────────────
    {
        let lp: *mut LeafNode<u64, u64, StoreCfg, DataCfg> = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(101u64, 1u64)
        };
        unsafe {
            lp.keys.push(10u64);
            lp.vals.push(100u64);
        }
        let arc: NodeARC<StoreCfg> = node_arc_wrap::<StoreCfg>(lp as *mut dyn BTreeNode<StoreCfg>);
        let _ = arc;
        // arc drops at scope exit → leaf rc 1→0 → leaf's __drop_in_place
        // (default) fires → keys/vals Buffer auto-drops → dealloc. No way
        // to assert from outside without a counter, but no segfault = win.
    }

    // ── Stage 2 — branch holding two data leaves ──────────────────────
    {
        let la: *mut LeafNode<u64, u64, StoreCfg, DataCfg> = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(201u64, 1u64)
        };
        let lb: *mut LeafNode<u64, u64, StoreCfg, DataCfg> = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(202u64, 1u64)
        };
        unsafe {
            la.keys.push(1u64);  la.vals.push(11u64);
            lb.keys.push(2u64);  lb.vals.push(22u64);
        }
        let arcA: NodeARC<StoreCfg> = node_arc_wrap::<StoreCfg>(la as *mut dyn BTreeNode<StoreCfg>);
        let arcB: NodeARC<StoreCfg> = node_arc_wrap::<StoreCfg>(lb as *mut dyn BTreeNode<StoreCfg>);

        let bp: *mut BranchNode<u64, StoreCfg, DataCfg> = unsafe {
            branch_alloc::<u64, StoreCfg, DataCfg>(301u64, 1u64)
        };
        unsafe {
            bp.children.push(arcA);
            bp.children.push(arcB);
        }
        let root: NodeARC<StoreCfg> = node_arc_wrap::<StoreCfg>(bp as *mut dyn BTreeNode<StoreCfg>);
        let _ = root;
        // root drops → branch rc 1→0 → branch's auto-Drop chain:
        //   1. keys Buffer drops (no-op for u64 storage).
        //   2. children Vec drops → per-element NodeARC drops → leaves
        //      rc 1→0 → leaf auto-Drop chain → keys/vals Buffer drops.
        //   3. dealloc branch.
    }

    // ── Stage 3 — directory leaf holding container roots as NodeARCs ──
    {
        let leaf_a: *mut LeafNode<u64, u64, StoreCfg, DataCfg> = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(401u64, 2u64)
        };
        let leaf_b: *mut LeafNode<u64, u64, StoreCfg, DataCfg> = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(402u64, 2u64)
        };
        let arc_a: NodeARC<StoreCfg> = node_arc_wrap::<StoreCfg>(leaf_a as *mut dyn BTreeNode<StoreCfg>);
        let arc_b: NodeARC<StoreCfg> = node_arc_wrap::<StoreCfg>(leaf_b as *mut dyn BTreeNode<StoreCfg>);

        let dirp: *mut LeafDirNode<u64, StoreCfg, DirCfg> = unsafe {
            leaf_dir_alloc::<u64, StoreCfg, DirCfg>(501u64, 2u64)
        };
        unsafe {
            dirp.keys.push(101u64);  dirp.vals.push(arc_a);
            dirp.keys.push(202u64);  dirp.vals.push(arc_b);
        }
        let dir_root: NodeARC<StoreCfg> = node_arc_wrap::<StoreCfg>(dirp as *mut dyn BTreeNode<StoreCfg>);
        let _ = dir_root;
        // dir_root drops → LeafDirNode auto-Drop:
        //   keys Buffer drops, vals Vec<NodeARC> drops → per-element
        //   NodeARC drops → child leaves rc 1→0 → leaf auto-Drop → ...
    }

    // ── Stage 4 — cow_clone via vtable, both originals and clones drop cleanly ──
    {
        let lp: *mut LeafNode<u64, u64, StoreCfg, DataCfg> = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(601u64, 5u64)
        };
        unsafe {
            lp.keys.push(7u64);
            lp.vals.push(700u64);
        }
        let arc: NodeARC<StoreCfg> = node_arc_wrap::<StoreCfg>(lp as *mut dyn BTreeNode<StoreCfg>);

        // Trigger cow_clone via vtable. Clone has fresh id+snap_id stamp.
        let cloned = unsafe { arc.p.cow_clone(701u64, 9u64) };

        unsafe {
            // Original unchanged — original block keeps id=601, snap=5.
            let op: *mut u8 = node_arc_data_ptr::<StoreCfg>(&arc);
            if *((op as i64 +  8i64) as *mut u64) != 601u64 { return 1; }
            if *((op as i64 + 16i64) as *mut u64) != 5u64   { return 2; }
            // Cloned has new stamp.
            let cp: *mut u8 = node_arc_data_ptr::<StoreCfg>(&cloned);
            if *((cp as i64 +  8i64) as *mut u64) != 701u64 { return 3; }
            if *((cp as i64 + 16i64) as *mut u64) != 9u64   { return 4; }
        }
        // Both arcs drop at scope exit — independent allocations, no shared rc.
    }

    // ── Stage 5 — make_unique CoW skip rule (snapshot_id check) ───────
    {
        let lp: *mut LeafNode<u64, u64, StoreCfg, DataCfg> = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(801u64, 7u64)
        };
        let mut arc: NodeARC<StoreCfg> = node_arc_wrap::<StoreCfg>(lp as *mut dyn BTreeNode<StoreCfg>);

        let mut next_id: u64 = 800u64;
        // Same snapshot — no clone, no id bump.
        unsafe { make_unique::<StoreCfg>(&mut arc, 7u64, &mut next_id as *mut u64); }
        if next_id != 800u64 { return 5; }
        unsafe {
            let dp: *mut u8 = node_arc_data_ptr::<StoreCfg>(&arc);
            if *((dp as i64 + 8i64) as *mut u64) != 801u64 { return 6; }
        }

        // Different snapshot — clone fires, arc swaps to new node.
        unsafe { make_unique::<StoreCfg>(&mut arc, 9u64, &mut next_id as *mut u64); }
        if next_id != 801u64 { return 7; }
        unsafe {
            let dp: *mut u8 = node_arc_data_ptr::<StoreCfg>(&arc);
            if *((dp as i64 +  8i64) as *mut u64) != 801u64 { return 8; }
            if *((dp as i64 + 16i64) as *mut u64) != 9u64   { return 9; }
        }
    }

    return 0;
}
