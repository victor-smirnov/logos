// Array patterns in a match EXPRESSION over droppable elements: `[x, _]`, an rvalue array, `ref`
// binders, a struct sub-pattern, and a scalar array. rustc 1.98.1 prints the same line.
package match_expr_array_pattern_binders;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn a(p: *mut i64) -> i64 {
    let arr: [D; 2] = [D { v: 1i64, c: p }, D { v: 2i64, c: p }];
    let k: i64 = match arr { [x, _] => x.v };
    return k;
}
fn b(p: *mut i64) -> i64 {
    let k: i64 = match [D { v: 3i64, c: p }, D { v: 4i64, c: p }] { [x, y] => x.v * 10i64 + y.v };
    return k;
}
fn c(p: *mut i64) -> i64 {
    let arr: [D; 2] = [D { v: 5i64, c: p }, D { v: 6i64, c: p }];
    let k: i64 = match arr { [ref x, ref y] => x.v + y.v };
    return k;
}
fn d(p: *mut i64) -> i64 {
    let arr: [D; 2] = [D { v: 7i64, c: p }, D { v: 8i64, c: p }];
    let k: i64 = match arr { [D { v, c: _ }, y] => v * 10i64 + y.v };
    return k;
}
fn e() -> i64 {
    let arr: [i64; 3] = [1i64, 2i64, 3i64];
    return match arr { [x, _, z] => x + z };
}
fn main() -> i32 {
    let mut n1: i64 = 0i64; let r1: i64 = a(&mut n1);
    let mut n2: i64 = 0i64; let r2: i64 = b(&mut n2);
    let mut n3: i64 = 0i64; let r3: i64 = c(&mut n3);
    let mut n4: i64 = 0i64; let r4: i64 = d(&mut n4);
    unsafe { printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld\n".as_ptr(), r1, n1, r2, n2, r3, n3, r4, n4, e()); }
    return 0i32;
}
