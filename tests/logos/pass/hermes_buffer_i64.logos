package hermes_buffer_i64;
// Basic Buffer<I64>: push N values, read them back, verify len/get;
// rely on Drop to release the heap buffer at end of scope.

use logos.mem.hermes.fabric;
use logos.mem.hermes.scalar;

unsafe fn main() -> i32 {
    let mut b: Buffer<I64> = Buffer::<I64>::new();
    if b.len() != 0 as u64 { return 1; }

    // Push 10 values — exercises grow: 0→4, 4→8, 8→16.
    let mut i: i64 = 0;
    while i < 10 {
        b.push(i * 100 as i64);
        i = i + 1;
    }
    if b.len() != 10 as u64 { return 2; }

    // Read-back.
    let mut k: u64 = 0 as u64;
    while k < 10 as u64 {
        let got: i64 = b.get(k);
        let expect: i64 = (k as i64) * 100 as i64;
        if got != expect { return 3; }
        k = k + 1 as u64;
    }

    return 0;
}
