// fabric Buffer over a bare scalar (hermes2: the Primitive blanket makes
// Buffer<i64> direct — the Hermes1 I64 wrapper datatype is gone).
package hermes_buffer_i64;
use logos.lang.fabric;

unsafe fn main() -> i32 {
    let mut b: Buffer<i64> = Buffer::<i64>::new();
    if b.len() != 0 as u64 { return 1; }
    // Push 10 values — exercises grow: 0→4, 4→8, 8→16.
    let mut i: i64 = 0;
    while i < 10 {
        b.push(i * 10);
        i = i + 1;
    }
    if b.len() != 10 as u64 { return 2; }
    if b.get(0 as u64) != 0i64 { return 3; }
    if b.get(5 as u64) != 50i64 { return 4; }
    if b.get(9 as u64) != 90i64 { return 5; }
    // Overwrite.
    b.set(5 as u64, 555i64);
    if b.get(5 as u64) != 555i64 { return 6; }
    return 0;
}
