// The CONTROL half of destructure_fnparam_tuple_drop_once: the pattern is off
// the parameter and in the body, so the `let`-position destructure (which has
// marked its source moved since G154-4) owns the step. Green before and after.
package destructure_fnparam_plain_drop_once;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
trait Drop { fn drop(self: &mut Self); }
struct Owner { i: *mut i64 }
impl Drop for Owner { fn drop(self: &mut Self) { unsafe { *self.i += 1i64; } } }
fn probe(t: (Owner, i64)) -> i64 {
    let (s, n) = t;
    return n + (s.i as i64) - (s.i as i64);
}
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    let t: (Owner, i64) = (Owner { i: p }, 5i64);
    let _x = probe(t);
    printi("%ld\n", c);
    return 0i32;
}
