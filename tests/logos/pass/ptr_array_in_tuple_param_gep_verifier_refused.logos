// Compiles and runs as in rustc 1.98.1 (squeue row of the same name).
package ptr_array_in_tuple_param_gep_verifier_refused;
fn first<'a>(t: ([*mut &'a i64; 1], i64)) -> i64 {
    return unsafe { **(t.0[0]) };
}
fn main() -> i32 {
    let v: i64 = 9i64;
    let mut r: &i64 = &v;
    let p: *mut &i64 = &mut r;
    return (first(([p], 1i64)) - 9i64) as i32;
}
