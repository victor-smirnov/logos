package if_expr_value;
// F05: if as expression (result used in return)
fn select(cond: bool, a: i32, b: i32) -> i32 {
    return if cond { a; } else { b; };
}
unsafe fn main() -> i32 {
    let a: i32 = select(true, 42, 0);    // 42
    let b: i32 = select(false, 0, 100);  // 100
    let c: i32 = select(true, 1, 2);     // 1
    // a=42, b=100, c=1: return a (the truthy one)
    return a;
}
