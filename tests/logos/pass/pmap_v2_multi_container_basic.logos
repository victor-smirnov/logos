package pmap_v2_multi_container_basic;
use std.data.persistent.pmap_v2.handle;
use std.lang.cmp; use std.lang.ord; use std.lang.datatypes;
use std.hermes.view; use std.hermes.anyval;

pub type StoreCfg = @{ "name": "v1-default", "ctr_id": <type:u64>, "snp_id": <type:u64> };
pub type CfgA = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 8 };
pub type CfgB = @{ "key": <type:u32>, "value": <type:u32>, "fanout": 8 };

fn main() -> i32 {
    let mut store: Store<StoreCfg> = store_open::<StoreCfg>();
    let mut snap:  Snap<StoreCfg>  = snap_begin(&mut store);
    {
        let mut c_a: ContainerRef<CfgA> = create_pmap::<CfgA>(&mut snap, 101u64);
        let mut c_b: ContainerRef<CfgB> = create_pmap::<CfgB>(&mut snap, 202u64);

        if !c_a.is_valid() { return 1; }
        if !c_b.is_valid() { return 2; }

        let mut i: u64 = 1u64;
        while i <= 50u64 {
            let k: u64 = i;
            let _ = c_a.insert(k, k * 7u64, &k as *const u64);
            i = i + 1u64;
        }

        let mut j: u32 = 1u32;
        while j <= 30u32 {
            let kk: u32 = j;
            let vv: u32 = j * 11u32;
            let _ = c_b.insert(kk, vv, &kk as *const u32);
            j = j + 1u32;
        }

        if c_a.len() != 50u64 { return 3; }
        if c_b.len() != 30u64 { return 4; }
    }

    {
        let mut c_a2: ContainerRef<CfgA> = open_pmap::<CfgA>(&mut snap, 101u64);
        if !c_a2.is_valid() { return 9; }
        if c_a2.len() != 50u64 { return 10; }
    }

    {
        let c_mismatch: ContainerRef<CfgB> = open_pmap::<CfgB>(&mut snap, 101u64);
        if c_mismatch.is_valid() { return 12; }
    }

    {
        let c_nope: ContainerRef<CfgA> = open_pmap::<CfgA>(&mut snap, 999u64);
        if c_nope.is_valid() { return 13; }
    }

    return 42;
}
