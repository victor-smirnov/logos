// queue-2 I3 — LENIENT mode (ADR 0012-queue2 §4a): erased sources
// (bind_source_erased — rows are string-keyed Writ maps, resolved by NAME at
// runtime, no catalog), Null propagation through where/select (CEL-style:
// compare-with-Null → false, arithmetic-with-Null → Null), the FK_ANY
// ("any"-typed) field on a STRICT schema resolving leniently, and Trama
// render over an erased context (bind_node_erased + {{ e.anything }}).
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.wmap;
use logos.lang.writ.wstring;   // WString — the string-keyed map key type
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Emp : code(0x0B13_0000_0000_0001) {
    name: str  = 0,
    age:  i64  = 1,
    meta: WAny = 2,   // FK_ANY — erased field on a STRICT schema
}

resource cat = schema_catalog!{ Emp };

fn mk_emp(d: &Writ, name: str, age: i64, meta: i64) -> WAny {
    let e: Emp = d.make::<Emp>();
    e.name = name;
    e.age = age;
    if meta != 0i64 { e.meta = WAny::from(meta as i56); }   // 0 = leave UNSET
    let w: i64 = e.m as i64;
    return WAny::ref_to(w as *const u8);
}

fn main() -> i32 {
    let d: Writ = writ_new(8192i64);
    let c: SchemaCatalog = cat();

    // ── FK_ANY on a STRICT schema resolves leniently ──────────────────────
    let emps: &mut WArray<WAny> = d.array(4i64);
    emps.push(mk_emp(&d, "Ann", 45i64, 7i64));
    emps.push(mk_emp(&d, "Bob", 31i64, 0i64));   // meta UNSET → Null
    let esrc: WAny = WAny::ref_to(emps as *const WArray<WAny> as *const u8);
    let mut env: QEnv = QEnv::new();
    env.bind_source("emps", esrc);

    // select e.meta → a "dyn" column; the unset cell is Null.
    let q1: Query = match Query::compile("from emps e select (e.name, e.meta)", &c) {
        Result::Ok(v) => { v }
        Result::Err(_e) => { return 1i32; }
    };
    let r1: QRows = match q1.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e2) => { return 2i32; }
    };
    if r1.row_count() != 2i64 { return 3i32; }
    if !str_eq(r1.col_ty(1i64), "dyn") { return 4i32; }
    if r1.is_null(0i64, 1i64) { return 5i32; }
    if r1.get_i64(0i64, 1i64) != 7i64 { return 6i32; }
    if !r1.is_null(1i64, 1i64) { return 7i32; }

    // where over FK_ANY: Null compares FALSE — only Ann passes.
    let q2: Query = match Query::compile("from emps e where e.meta == 7 select e.name", &c) {
        Result::Ok(v) => { v }
        Result::Err(_e3) => { return 8i32; }
    };
    let r2: QRows = match q2.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e4) => { return 9i32; }
    };
    if r2.row_count() != 1i64 { return 10i32; }
    if !str_eq(r2.get_str(0i64, 0i64), "Ann") { return 11i32; }

    // ── ERASED source: string-keyed map rows, NO catalog entry at all ─────
    let m1: &mut WMap<WString, WAny> = d.map(4i64);
    m1.set("name", "Ann");
    m1.set("score", 10i64);
    let m2: &mut WMap<WString, WAny> = d.map(4i64);
    m2.set("name", "Bob");                        // score MISSING → Null
    let things: &mut WArray<WAny> = d.array(4i64);
    things.push(WAny::from(&*m1));
    things.push(WAny::from(&*m2));
    let tsrc: WAny = WAny::ref_to(things as *const WArray<WAny> as *const u8);
    env.bind_source_erased("things", tsrc);

    // where t.score > 5: Bob's Null > 5 → false (row dropped, no error).
    let q3: Query = match Query::compile(
        "from things t where t.score > 5 select (t.name, t.score + 1)", &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e5) => { return 12i32; }
    };
    let r3: QRows = match q3.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e6) => { return 13i32; }
    };
    if r3.row_count() != 1i64 { return 14i32; }
    if !str_eq(r3.get_str(0i64, 0i64), "Ann") { return 15i32; }
    if r3.get_i64(0i64, 1i64) != 11i64 { return 16i32; }

    // select of a MISSING field: Null cell + Null arithmetic → Null.
    let q4: Query = match Query::compile(
        "from things t select (t.name, t.score, t.score * 2)", &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e7) => { return 17i32; }
    };
    let r4: QRows = match q4.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e8) => { return 18i32; }
    };
    if r4.row_count() != 2i64 { return 19i32; }
    if r4.get_i64(0i64, 1i64) != 10i64 { return 20i32; }
    if !r4.is_null(1i64, 1i64) { return 21i32; }   // Bob: missing key → Null
    if !r4.is_null(1i64, 2i64) { return 22i32; }   // Null * 2 → Null

    // ── Trama over an ERASED context (bind_node_erased) ───────────────────
    let t: Tpl = match Tpl::compile(
        "{{ x.name }}:{{ x.score }}:{{ x.score + 1 }}:{% if x.score %}Y{% else %}N{% endif %}", &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e9) => { return 23i32; }
    };
    let mut env2: QEnv = QEnv::new();
    env2.bind_node_erased("x", WAny::from(&*m1));
    let s1: String = match t.render(&env2) {
        Result::Ok(s) => { s }
        Result::Err(_ea) => { return 24i32; }
    };
    if !str_eq(sview(&s1), "Ann:10:11:Y") { return 25i32; }
    env2.bind_node_erased("x", WAny::from(&*m2));
    let s2: String = match t.render(&env2) {
        Result::Ok(s) => { s }
        Result::Err(_eb) => { return 26i32; }
    };
    // missing score: {{ Null }} renders EMPTY; Null + 1 → Null → EMPTY; if → N
    if !str_eq(sview(&s2), "Bob:::N") { return 27i32; }

    return 0i32;
}

fn sview(s: &String) -> str {
    return unsafe { str_from_raw(s.as_ptr(), s.len()) };
}
