// The ADMIT half of fail/bc_genrecv_shared_then_mut_fail. ONE VARIABLE: the
// shared loan is DEAD before the mutable one is taken. The shared receiver tie
// must be NLL-scoped in the same way the mutable one is, or this file reds.
//
// It also RUNS the two exemptions the SHARED direction needs: several live
// shared loans through the same generic `&self` method must coexist, and a
// generic method returning BY VALUE must tie nothing at all.
package bc_genrecv_shared_then_mut_admit;

struct C { v: i64 }

impl C {
    fn peek<T>(&self) -> &i64 { return &self.v; }
    fn get<T>(&mut self) -> &mut i64 { return &mut self.v; }
    fn count<T>(&self) -> i64 { return self.v; }
}

fn main() -> i32 {
    let mut c: C = C { v: 1i64 };

    // 1. the shared loan is read out and dead before the mutable one is taken
    let s: &i64 = c.peek::<i64>();
    if *s != 1i64 { return 1i32; }
    let m: &mut i64 = c.get::<i64>();
    *m = 2i64;
    if c.v != 2i64 { return 2i32; }

    // 2. two live shared loans through the generic &self method
    let s1: &i64 = c.peek::<i64>();
    let s2: &i64 = c.peek::<i64>();
    if *s1 + *s2 != 4i64 { return 3i32; }

    // 3. a generic method returning by value ties nothing
    let n: i64 = c.count::<i64>();
    c.v = 9i64;
    if n != 2i64 { return 4i32; }
    if c.v != 9i64 { return 5i32; }

    return 42i32;
}
