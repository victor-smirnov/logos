// Adversarial #2 (p15): index-position autoderef — w[i] read AND compound
// write through Deref/DerefMut to Vec; .len() method autoderef.
package adv2_index_autoderef_wrapper;
use logos.lang.ops;
struct W { v: Vec<i64> }
impl Deref<Vec<i64>> for W { fn deref(&self) -> &Vec<i64> { return &self.v; } }
impl DerefMut<Vec<i64>> for W { fn deref_mut(&mut self) -> &mut Vec<i64> { return &mut self.v; } }
fn main() -> i32 {
    let mut v: Vec<i64> = Vec::<i64>::new();
    v.push(1i64); v.push(2i64);
    let mut w = W { v: v };
    w[0] += 10i64;
    if w[0] != 11i64 { return 1i32; }
    if w.len() != 2 { return 2i32; }
    return 0i32;
}
