// ex-soundness-queue row pattern_mut_recv (tier 3 REFUSES) — `E::A(mut s)` then a `&mut self` method: legal, runs. ONE TOKEN from fail/bc_patmut_match_variant_no_mut_recv_fail (drop the `mut`). PROBES.md 2026-09-06b: the by-value pattern `mut` is carried into the LIR for match/if-let/while-let/for bindings.
package bc_patmut_match_variant_recv;
struct S { v: i64 }
impl S { fn get(&mut self) -> &mut i64 { return &mut self.v; } }
enum E { A(S), B }
fn main() -> i32 {
    let e: E = E::A(S { v: 1i64 });
    match e {
        E::A(mut s) => {
            let r: &mut i64 = s.get();
            *r = 8i64;
            if s.v != 8i64 { return 1i32; }
        },
        E::B => {}
    }
    return 0i32;
}
