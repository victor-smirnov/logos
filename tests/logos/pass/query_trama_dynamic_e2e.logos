// queue-2 I1 — DYNAMIC Trama end to end (ADR 0012-queue2 §§3,7): template TEXT
// compiled AT RUNTIME (`Tpl::compile` — the reused generated parser + the
// reused `simplify_sexpr` optimizer + the runtime checker) and rendered over
// schema'd Writ data (`render` — strict per-env check + the eval tree walk).
//
// Covers: interpolation (str/i64), `{% if %}`/`{% else %}` over a schema field
// compare, `{% for %}` over a WRef<S> edge holding a Writ ARRAY (loop var
// bound as a node; nested field reads through the catalog key codes),
// `{% set %}` (env-scoped local), and compile-once/render-many RE-ENTRANCY
// over two different envs. Exact-string assertions; distinct exit codes.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;              // WRef<S>
use logos.std.wql.catalog_macro;   // schema_catalog!
use logos.std.deem;               // SchemaCatalog / QEnv / Tpl / QError
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Emp : code(0x0A02_0000_0000_0001) {
    name: str = 0,
    age:  i64 = 1,
}

pub schema Team : code(0x0A02_0000_0000_0002) {
    title: str       = 0,
    emps:  WRef<Emp> = 1,
}

impl Emp  { pub fn as_any(self: &Emp)  -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }
impl Team { pub fn as_any(self: &Team) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }

resource cat = schema_catalog!{ Emp, Team };

fn str_view(s: &String) -> str {
    return unsafe { str_from_raw(s.as_ptr(), s.len()) };
}

fn main() -> i32 {
    // ── data: a Team with two Emps in a Writ doc ──────────────────────────
    let d: Writ = writ_new(4096i64);
    let e1: Emp = d.make::<Emp>();
    e1.name = "Ann";
    e1.age = 45i64;
    let e2: Emp = d.make::<Emp>();
    e2.name = "Bob";
    e2.age = 31i64;
    let t1: Team = d.make::<Team>();
    t1.title = "Core";
    let arr: &mut WArray<WAny> = d.array(4i64);
    arr.push(e1.as_any());
    arr.push(e2.as_any());
    // NB: pack the array ref via the raw-pointer cast (the generated parsers'
    // idiom) — `WAny::from(arr as &WArray<WAny>)` on a FAT &mut mis-packs.
    t1.emps = WRef::<Emp>::from_any(WAny::ref_to(arr as *const WArray<WAny> as *const u8));

    let c: SchemaCatalog = cat();

    // ── compile once ──────────────────────────────────────────────────────
    let tpl: Tpl = match Tpl::compile(
        "Hello {{ e.name }}, {% if e.age >= 40 %}senior{% else %}junior{% endif %}; team {{ t.title }}:{% for m in t.emps %} {{ m.name }}({{ m.age }}){% endfor %}{% set x = 2 + 3 %} x={{ x }}",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e) => { return 1i32; }
    };

    // ── render #1 ─────────────────────────────────────────────────────────
    let mut env: QEnv = QEnv::new();
    env.bind_node("e", e1.as_any());
    env.bind_node("t", t1.as_any());
    let s1: String = match tpl.render(&env) {
        Result::Ok(s) => { s }
        Result::Err(_e2) => { return 2i32; }
    };
    let want1: str = "Hello Ann, senior; team Core: Ann(45) Bob(31) x=5";
    if !str_eq(str_view(&s1), want1) { return 3i32; }

    // ── render #2: SAME Tpl, different env (re-entrancy) ──────────────────
    let mut env2: QEnv = QEnv::new();
    env2.bind_node("e", e2.as_any());
    env2.bind_node("t", t1.as_any());
    let s2: String = match tpl.render(&env2) {
        Result::Ok(s) => { s }
        Result::Err(_e3) => { return 4i32; }
    };
    let want2: str = "Hello Bob, junior; team Core: Ann(45) Bob(31) x=5";
    if !str_eq(str_view(&s2), want2) { return 5i32; }

    return 0i32;
}
