// PeekableIter::peek / next / next_back: the cached item is MOVED out, never bitwise-duplicated.
//
// #112 — the `*((&x) as *const T)` duplicate-owner class.

package rawdup_peekable_drop_once;

use logos.std.fmt;
use logos.lang.option;
use logos.lang.iter;
use logos.mem.collections.vec;

// Heap-owning AND printing payload — see rawdup_option_filter_drop_once for why both
// halves are load-bearing. The assertion is the EXACT set of destructor lines.
struct Inner { pub n: i64, pub v: Vec<i64> }
impl Drop for Inner { fn drop(self: &mut Inner) { println!("DROP n={}", self.n); } }
fn mk(n: i64) -> Inner { let mut v: Vec<i64> = vec_new::<i64>(); v.push(n); return Inner { n: n, v: v }; }

fn main() -> i32 {
    println!("-- peek then next");
    let mut s: Vec<Inner> = vec_new::<Inner>();
    s.push(mk(1i64)); s.push(mk(2i64));
    let mut p: PeekableIter<VecIntoIter<Inner>, Inner> =
        iter_peekable::<VecIntoIter<Inner>, Inner>(s.into_iter(), mk(0i64));
    unsafe { match p.peek() { Option::Some(r) => { println!("peek={}", r.n); } Option::None => { println!("peek none"); } } }
    match p.next() { Option::Some(x) => { println!("next={}", x.n); } Option::None => { println!("none"); } }
    println!("rest={}", p.count());
    println!("-- peek then next_back");
    let mut s2: Vec<Inner> = vec_new::<Inner>();
    s2.push(mk(11i64));
    let mut q: PeekableIter<VecIntoIter<Inner>, Inner> =
        iter_peekable::<VecIntoIter<Inner>, Inner>(s2.into_iter(), mk(0i64));
    unsafe { match q.peek() { Option::Some(r) => { println!("peek={}", r.n); } Option::None => { println!("peek none"); } } }
    match q.next_back() { Option::Some(x) => { println!("back={}", x.n); } Option::None => { println!("none"); } }
    println!("-- end");
    return 0i32;
}
