// vec![a, b] moves its elements (rustc: `<[_]>::into_vec(Box::new([a, b]))`):
// no Copy bound, so a Vec<String> literal works; vec![e; n] clones e n-1 times
// with a runtime n (rustc's vec::from_elem); vec![] takes its element type from
// the context. ADR 0030 R0: built over the parsed arguments, no text.
package vec_macro_moves_elements;

fn main() -> i32 {
    let v: Vec<String> = vec![String::from("a"), String::from("bc")];
    if v.len() != 2 { return 1; }
    if v[1] != String::from("bc") { return 2; }
    let n: i64 = 3;
    let r: Vec<String> = vec![String::from("z"); n];
    if r.len() != 3 { return 3; }
    if r[2] != String::from("z") { return 4; }
    let zero: Vec<String> = vec![String::from("gone"); 0];
    if zero.len() != 0 { return 5; }
    let e: Vec<i64> = vec![];
    if e.len() != 0 { return 6; }
    let w: Vec<i64> = vec![1, 2, 3,];
    if w[2] != 3 { return 7; }
    return 42;
}
