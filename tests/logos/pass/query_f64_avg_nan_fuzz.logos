// f64_avg_nan_fuzz — differential (STATIC deem! vs an independent NAIVE oracle
// written in this file) targeting the f64 / avg / NaN dimension of the Deem
// engine. Data columns: g:i64 (group/join key), v:f64 drawn from an adversarial
// pool { +0.0, -0.0, 1.0, 2.0, NaN, 0.5, -1.0, 3.0 } so every iteration mixes
// signed zeros, NaN, and dyadic values. f64 results are compared BIT-EXACT
// (multiset of keys) — NaN==NaN is false, so a value compare would be
// meaningless; the engine and the oracle must agree on the exact bit pattern,
// accumulating avg/sum in the SAME (input) order. The ONE exception is the
// payload of a NaN, which the source does not determine — see `f_bits`, which
// is where that is argued and where the measurement behind it is recorded.
// Exit 0 iff both agree every iteration; nonzero code = failing shape.
//
// P5: the DYNAMIC `Query::run` arm is deleted with the interpreter. It was the
// THIRD reading, never the oracle — `naive_agg` and the per-shape nested loops
// below call nothing from `logos.mem.deem` or `logos.std.wql`, and `ueq3`/`ieq3`
// were `ueq(static, dynamic) && ueq(dynamic, naive)`, i.e. transitively
// static-vs-naive. The comparison is now `ueq2`/`ieq2` against the same oracle
// and the same 6000 iterations; what is lost is a corroborating engine, not a
// second opinion.
package test;

use logos.std.wql.wql;
use logos.lang.result;
use logos.lang.num.float;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

// static side: plain structs
struct SA { pub g: i64, pub v: f64 }
struct SB { pub g: i64, pub v: f64 }

// STATIC resources (native emitted fns)
pub deem s_sel(a: &[SA]) { from a x select x.v }
pub deem s_flt(a: &[SA]) { from a x where x.v > 0.5 select x.v }
pub deem s_join(a: &[SA], b: &[SB]) { from a x join b y on x.v == y.v select x.g }
pub deem s_avg(a: &[SA]) { from a x group by x.g aggregate m = avg(x.v) select m }
pub deem s_sum(a: &[SA]) { from a x group by x.g aggregate s = sum(x.v) select s }
pub deem s_min(a: &[SA]) { from a x group by x.g aggregate lo = min(x.v) select lo }
pub deem s_max(a: &[SA]) { from a x group by x.g aggregate hi = max(x.v) select hi }

// ── RNG ───────────────────────────────────────────────────────────────────────
struct Rng { s: u64 }
impl Rng {
    fn next(self: &mut Rng) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
    fn upto(self: &mut Rng, n: i64) -> i64 { return (self.next() % (n as u64)) as i64; }
}

// adversarial f64 value pool
fn poolf(i: i64) -> f64 {
    if i == 0i64 { return 0.0f64; }
    if i == 1i64 { return f64_from_bits(0x8000000000000000u64); }   // -0.0
    if i == 2i64 { return 1.0f64; }
    if i == 3i64 { return 2.0f64; }
    if i == 4i64 { return f64_from_bits(0x7ff8000000000000u64); }   // NaN (quiet)
    if i == 5i64 { return 0.5f64; }
    if i == 6i64 { return -1.0f64; }
    if i == 7i64 { return 3.0f64; }
    if i == 8i64 { return f64_from_bits(0x7ff0000000000000u64); }   // +inf
    return f64_from_bits(0xfff0000000000000u64);                    // -inf
}

// raw data: parallel Vec<i64> of g and vidx
fn nrows_of(g: &Vec<i64>) -> i64 { return g.len(); }

// ── u64 (bit) multiset ────────────────────────────────────────────────────────
fn usort(v: &mut Vec<u64>) {
    let n: i64 = v.len();
    let mut i: i64 = 0i64;
    while i < n {
        let mut m: i64 = i;
        let mut j: i64 = i + 1i64;
        while j < n { if v.get(j) < v.get(m) { m = j; } j = j + 1i64; }
        if m != i { let t: u64 = v.get(i); v.set(i, v.get(m)); v.set(m, t); }
        i = i + 1i64;
    }
}
fn ueq(a: &mut Vec<u64>, b: &mut Vec<u64>) -> bool {
    if a.len() != b.len() { return false; }
    usort(a); usort(b);
    let mut i: i64 = 0i64;
    while i < a.len() { if a.get(i) != b.get(i) { return false; } i = i + 1i64; }
    return true;
}
fn ueq2(a: &mut Vec<u64>, b: &mut Vec<u64>) -> bool {
    return ueq(a, b);
}

// ── i64 multiset ──────────────────────────────────────────────────────────────
fn isort(v: &mut Vec<i64>) {
    let n: i64 = v.len();
    let mut i: i64 = 0i64;
    while i < n {
        let mut m: i64 = i;
        let mut j: i64 = i + 1i64;
        while j < n { if v.get(j) < v.get(m) { m = j; } j = j + 1i64; }
        if m != i { let t: i64 = v.get(i); v.set(i, v.get(m)); v.set(m, t); }
        i = i + 1i64;
    }
}
fn ieq(a: &mut Vec<i64>, b: &mut Vec<i64>) -> bool {
    if a.len() != b.len() { return false; }
    isort(a); isort(b);
    let mut i: i64 = 0i64;
    while i < a.len() { if a.get(i) != b.get(i) { return false; } i = i + 1i64; }
    return true;
}
fn ieq2(a: &mut Vec<i64>, b: &mut Vec<i64>) -> bool {
    return ieq(a, b);
}

// f64 -> comparison key. Bit-exact, with EXACTLY ONE collapse: every NaN maps
// to one key.
//
// ⚠ This is not a loosening, it is the assertion matching what the source
// determines. The sign and payload of a NaN PRODUCED BY ARITHMETIC are left
// unspecified by IEEE 754 and by LLVM, so they are a function of the OPTIMISER,
// not of the program: `fadd` is commutable and x86 ADDSD returns the
// DESTINATION operand's NaN, so which of two NaNs survives `a + b` depends on
// register allocation — i.e. on whether a callee was inlined. MEASURED
// 2026-08-03: emitting the stdlib in 3+ objects stopped `rt_f` being inlined
// into the aggregate loop and flipped the sign of this test's `avg`, at shape 3,
// iteration 3927, on the group { +inf, 1.0, -inf, NaN, -0.0 }. Both answers are
// correct; a test that demands one of them is testing the inliner.
//
// Everything else stays EXACT, deliberately:
//   * −0.0 and +0.0 keep DIFFERENT keys — IEEE fully determines the sign of a
//     zero sum, so the three engines must agree on it and this test still says
//     so. (`order by` treats them as one VALUE — that is the data order,
//     `f64_data_key`, and a different question from "did we compute the same
//     number".)
//   * every finite value, both infinities and every rounding stay bit-exact.
//   * a NaN on one side and a number on the other still fails, because the
//     canonical NaN key equals no ordinary bit pattern.
fn f_bits(v: &Vec<f64>) -> Vec<u64> {
    let mut o: Vec<u64> = vec_new::<u64>();
    let mut i: i64 = 0i64;
    while i < v.len() {
        let x: f64 = v.get(i);
        if x != x { o.push(0x7ff8000000000000u64); }   // `x != x` IS the NaN test
        else      { o.push(f64_to_bits(x)); }
        i = i + 1i64;
    }
    return o;
}

// static slabs
fn slabA(gs: &Vec<i64>, vi: &Vec<i64>) -> Vec<SA> {
    let mut v: Vec<SA> = vec_new::<SA>(); let n: i64 = gs.len(); let mut i: i64 = 0i64;
    while i < n { v.push(SA { g: gs.get(i), v: poolf(vi.get(i)) }); i = i + 1i64; }
    return v;
}
fn slabB(gs: &Vec<i64>, vi: &Vec<i64>) -> Vec<SB> {
    let mut v: Vec<SB> = vec_new::<SB>(); let n: i64 = gs.len(); let mut i: i64 = 0i64;
    while i < n { v.push(SB { g: gs.get(i), v: poolf(vi.get(i)) }); i = i + 1i64; }
    return v;
}

// distinct int-key list in first-occurrence order
fn contains_i(v: &Vec<i64>, x: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < v.len() { if v.get(i) == x { return true; } i = i + 1i64; }
    return false;
}

fn main() -> i32 {
    let mut rng: Rng = Rng { s: 0xDEADBEEF12345678u64 };
    let NITER: i64 = 6000i64;
    let MAXROWS: i64 = 7i64;

    let mut it: i64 = 0i64;
    while it < NITER {
        let shape: i64 = rng.upto(8i64);
        let na: i64 = rng.upto(MAXROWS);
        let nb: i64 = rng.upto(MAXROWS);

        let mut ga: Vec<i64> = vec_new::<i64>();
        let mut va: Vec<i64> = vec_new::<i64>();
        let mut r0: i64 = 0i64;
        while r0 < na { ga.push(rng.upto(3i64)); va.push(rng.upto(10i64)); r0 = r0 + 1i64; }
        let mut gb: Vec<i64> = vec_new::<i64>();
        let mut vb: Vec<i64> = vec_new::<i64>();
        let mut r1: i64 = 0i64;
        while r1 < nb { gb.push(rng.upto(3i64)); vb.push(rng.upto(10i64)); r1 = r1 + 1i64; }

        let sla: Vec<SA> = slabA(&ga, &va);
        let slb: Vec<SB> = slabB(&gb, &vb);

        if shape == 0i64 {
            // SELECT f64
            let st: Vec<f64> = s_sel(sla.as_slice()).unwrap();
            let mut nv: Vec<f64> = vec_new::<f64>();
            let mut r: i64 = 0i64;
            while r < na { nv.push(poolf(va.get(r))); r = r + 1i64; }
            let mut sb: Vec<u64> = f_bits(&st); let mut nb2: Vec<u64> = f_bits(&nv);
            if !ueq2(&mut sb, &mut nb2) { return 10i32; }
        } else if shape == 1i64 {
            // FILTER f64: v > 0.5
            let st: Vec<f64> = s_flt(sla.as_slice()).unwrap();
            let mut nv: Vec<f64> = vec_new::<f64>();
            let mut r: i64 = 0i64;
            while r < na { let x: f64 = poolf(va.get(r)); if x > 0.5f64 { nv.push(x); } r = r + 1i64; }
            let mut sb: Vec<u64> = f_bits(&st); let mut nb2: Vec<u64> = f_bits(&nv);
            if !ueq2(&mut sb, &mut nb2) { return 11i32; }
        } else if shape == 2i64 {
            // JOIN on f64 key (nested-loop tier), project x.g
            let mut st: Vec<i64> = s_join(sla.as_slice(), slb.as_slice()).unwrap();
            let mut nv: Vec<i64> = vec_new::<i64>();
            let mut ra: i64 = 0i64;
            while ra < na {
                let mut rb: i64 = 0i64;
                while rb < nb {
                    if poolf(va.get(ra)) == poolf(vb.get(rb)) { nv.push(ga.get(ra)); }
                    rb = rb + 1i64;
                }
                ra = ra + 1i64;
            }
            if !ieq2(&mut st, &mut nv) { return 12i32; }
        } else if shape == 3i64 {
            // GROUP BY int, avg(f64)  (bit-exact)
            let st: Vec<f64> = s_avg(sla.as_slice()).unwrap();
            let mut nv: Vec<f64> = naive_agg(&ga, &va, 5i64);
            let mut sb: Vec<u64> = f_bits(&st); let mut nb2: Vec<u64> = f_bits(&nv);
            if !ueq2(&mut sb, &mut nb2) { return 15i32; }
        } else if shape == 4i64 {
            // GROUP BY int, sum(f64)
            let st: Vec<f64> = s_sum(sla.as_slice()).unwrap();
            let mut nv: Vec<f64> = naive_agg(&ga, &va, 2i64);
            let mut sb: Vec<u64> = f_bits(&st); let mut nb2: Vec<u64> = f_bits(&nv);
            if !ueq2(&mut sb, &mut nb2) { return 16i32; }
        } else if shape == 5i64 {
            // GROUP BY int, min(f64)
            let st: Vec<f64> = s_min(sla.as_slice()).unwrap();
            let mut nv: Vec<f64> = naive_agg(&ga, &va, 3i64);
            let mut sb: Vec<u64> = f_bits(&st); let mut nb2: Vec<u64> = f_bits(&nv);
            if !ueq2(&mut sb, &mut nb2) { return 17i32; }
        } else if shape == 6i64 {
            // GROUP BY int, max(f64)
            let st: Vec<f64> = s_max(sla.as_slice()).unwrap();
            let mut nv: Vec<f64> = naive_agg(&ga, &va, 4i64);
            let mut sb: Vec<u64> = f_bits(&st); let mut nb2: Vec<u64> = f_bits(&nv);
            if !ueq2(&mut sb, &mut nb2) { return 18i32; }
        }
        // (An f64 `group by` KEY is rejected by both engines — no total order /
        // stable hash; that rejection is pinned cleanly by query_compile_robust_e2e.
        // This fuzzer stays on the f64 VALUE-aggregation dimension where the
        // engines agree bit-exactly.)

        it = it + 1i64;
    }
    return 0i32;
}

// PostgreSQL float ORDER, written out from the rule and reaching no stdlib
// function: `a` strictly precedes `b` iff `a` is not NaN and either `b` is NaN
// (NaN is greater than every number) or `a < b`. All NaNs are one value, so
// NaN-vs-NaN is neither `<` nor `>`; `-0.0 == +0.0` needs no clause because
// IEEE `<` already answers false both ways. This is `f64_data_key`'s order
// WITHOUT `f64_data_key`.
fn pg_ord_lt(a: f64, b: f64) -> bool {
    if a != a { return false; }        // `x != x` IS the IEEE NaN test
    if b != b { return true; }
    return a < b;
}

// naive per-int-group aggregate over f64 values; fn: 2=sum 3=min 4=max 5=avg.
// Accumulates in INPUT order per group (matches engine accumulation order).
fn naive_agg(gs: &Vec<i64>, vi: &Vec<i64>, fnid: i64) -> Vec<f64> {
    let n: i64 = gs.len();
    let mut keys: Vec<i64> = vec_new::<i64>();
    let mut r: i64 = 0i64;
    while r < n { let k: i64 = gs.get(r); if !contains_i(&keys, k) { keys.push(k); } r = r + 1i64; }
    let mut out: Vec<f64> = vec_new::<f64>();
    let mut ki: i64 = 0i64;
    while ki < keys.len() {
        let k: i64 = keys.get(ki);
        let mut acc: f64 = 0.0f64;
        let mut cnt: i64 = 0i64;
        let mut r2: i64 = 0i64;
        while r2 < n {
            if gs.get(r2) == k {
                let x: f64 = poolf(vi.get(r2));
                cnt = cnt + 1i64;
                if fnid == 2i64 { acc = acc + x; }
                else if fnid == 5i64 { acc = acc + x; }
            }
            r2 = r2 + 1i64;
        }
        // ⚠ min/max are computed by a DIFFERENT ALGORITHM from the fold both
        // engines run — two passes (find the extreme KEY, then take the FIRST
        // value carrying it) instead of one accumulate. This oracle used to be
        // the fold, seed and all: `acc = ±1.797…e308` then `if x < acc`. That is
        // why this fuzz never caught the seed leak — the oracle WAS the
        // implementation, so all three sides agreed on the same wrong answer
        // (min over { +inf } = f64::MAX, a value in no row). An oracle that
        // shares the algorithm under test is not an oracle.
        //
        // ⚠ 2026-08-09: that rewrite fixed the ALGORITHM sharing and LEFT THE KEY
        // sharing. It ranked candidates by `f64_data_key` — the very function the
        // emitted fold compares through (`stdlib/mem/wql/rexpr_walk.logos` emits
        // `if f64_data_key(__v) < f64_data_key(…)`) — so the oracle's notion of
        // "extreme" was the engine's. `pg_ord_lt` below is that order written out
        // from the rule instead: NaN is greater than every number and equal to
        // every NaN, `-0.0 == +0.0` needs no clause because IEEE `<` already
        // answers false both ways, IEEE elsewhere. It calls NOTHING — `x != x` is
        // the IEEE NaN test — so no stdlib entry is on its path.
        //
        // ⚠ HONESTY ABOUT WHAT THIS COST AND WHAT IT BOUGHT: TWO control-reverts
        // of `f64_data_key` in `stdlib/lang/num/float.logos` were run on 2026-08-09
        // (archives dropped, stdlib rebuilt, both fixture versions run on the SAME
        // build), and NEITHER separates the old arm from this one:
        //   · collapse — `return 0i64` for every input: OLD **18**, NEW **18**.
        //   · reverse  — `0 - f64_total_key(x)`, still injective and total:
        //                OLD **18**, NEW **18**.
        // The reason is `f_bits`: this file compares BIT PATTERNS, and under a
        // wrong order the engine stops displacing its SEED, so it answers a value
        // present in no row. Any oracle that returns a row value disagrees with
        // that, however it ranked. So the sharing was real and this fuzz was never
        // blind to it — the rewrite removes a dependency, it does not repair a
        // measured hole. Contrast `tests/logos/pass/query_minmax_float_seed_leak.logos`,
        // whose EQUALITY went through the key: under the collapse control it
        // exited 0 and now exits 10. That is where the same hazard was fatal.
        if fnid == 3i64 || fnid == 4i64 {
            let mut best: f64 = 0.0f64; let mut have: bool = false;
            let mut r3: i64 = 0i64;
            while r3 < n {
                if gs.get(r3) == k {
                    let x1: f64 = poolf(vi.get(r3));
                    if !have { best = x1; have = true; }
                    else if fnid == 3i64 { if pg_ord_lt(x1, best) { best = x1; } }
                    else                 { if pg_ord_lt(best, x1) { best = x1; } }
                }
                r3 = r3 + 1i64;
            }
            // FIRST value equal to the extreme, so the tie-break is row order —
            // the same tie-break a one-pass strict-improve fold implements.
            let mut r4: i64 = 0i64;
            while r4 < n {
                if gs.get(r4) == k {
                    let x2: f64 = poolf(vi.get(r4));
                    if !pg_ord_lt(x2, best) && !pg_ord_lt(best, x2) { acc = x2; break; }
                }
                r4 = r4 + 1i64;
            }
        }
        if fnid == 5i64 { out.push(if cnt > 0i64 { acc / (cnt as f64) } else { 0.0f64 }); }
        else { out.push(acc); }
        ki = ki + 1i64;
    }
    return out;
}

// ⚠ UNCALLED — grep says `naive_group_fkey_count` has no call site in this file,
// and an oracle nobody asks is silence, not agreement. It is the oracle for
// `group by` on an f64 KEY, which BOTH tiers reject outright (see the note in
// `main`), so the shape it answers is never generated: `rng.upto(8i64)` picks
// 0-7 and only 0-6 are handled. Kept, not deleted, because the day an f64
// group key is admitted this is the answer it must produce — but it is pinning
// nothing today and the comment must not pretend otherwise.
//
// naive group-by f64 key with `==` semantics (NaN each own group), count per
// group, first-occurrence order. (It used to be described as mirroring the
// dynamic `rt_eq` linear scan; P5 deleted `rt_eq` with the interpreter, so the
// grouping here is written from `==` and mirrors nothing that still exists.)
fn naive_group_fkey_count(vi: &Vec<i64>) -> Vec<i64> {
    let n: i64 = vi.len();
    let mut kf: Vec<f64> = vec_new::<f64>();
    let mut cnt: Vec<i64> = vec_new::<i64>();
    let mut r: i64 = 0i64;
    while r < n {
        let x: f64 = poolf(vi.get(r));
        let mut gi: i64 = -1i64;
        let mut j: i64 = 0i64;
        while j < kf.len() { if kf.get(j) == x { gi = j; break; } j = j + 1i64; }
        if gi < 0i64 { kf.push(x); cnt.push(1i64); }
        else { cnt.set(gi, cnt.get(gi) + 1i64); }
        r = r + 1i64;
    }
    return cnt;
}
