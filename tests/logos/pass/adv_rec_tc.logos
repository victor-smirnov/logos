// adv_rec_tc — recursion/fixpoint differential (batch): transitive closure.
// static deem! rel  vs  an INDEPENDENT naive fixpoint, over 2000 fuzzed graphs.
//
// P5: the dynamic `Query::run` arm is deleted with the interpreter. THE ORACLE IS
// NOT THE ONE THAT LEFT — `naive_tc` (Floyd-Warshall) and `naive_odd` (a hand
// fixpoint) are written in this file, call nothing from `logos.mem.deem` or
// `logos.std.wql`, and are what both surviving comparisons are against. The
// interpreter was a THIRD reading of the same question, and it was the SUBJECT of
// the two arms that go (exit 20, exit 40), not the oracle of the two that stay.
// Exit codes 20 and 40 are retired, not reused.
package test;

use logos.std.wql.wql;
use logos.lang.result;
use logos.lang.arith;
use logos.mem.collections.vec;

struct SE { pub src: i64, pub dst: i64 }

pub deem tc(edges: &[SE]) {
    rel path(a: i64, b: i64) {
        from edges e select (e.src, e.dst);
        from path p join edges e on p.b == e.src select (p.a, e.dst);
    }
    from path p select p.a * 100 + p.b
}

pub deem mut_odd(edges: &[SE]) {
    rel odd(a: i64, b: i64) {
        from edges e select (e.src, e.dst);
        from even v join edges e on v.b == e.src select (v.a, e.dst);
    }
    rel even(a: i64, b: i64) {
        from odd o join edges e on o.b == e.src select (o.a, e.dst);
    }
    from odd p select p.a * 100 + p.b
}

struct Rng { s: u64 }
impl Rng {
    fn next(self: &mut Rng) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
    fn upto(self: &mut Rng, n: i64) -> i64 { if n <= 0i64 { return 0i64; } return (self.next() % (n as u64)) as i64; }
}

fn contains(v: &Vec<i64>, x: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < v.len() { if v.get(i) == x { return true; } i = i + 1i64; }
    return false;
}
fn isort(v: &mut Vec<i64>) {
    let n: i64 = v.len();
    let mut i: i64 = 0i64;
    while i < n {
        let mut m: i64 = i; let mut j: i64 = i + 1i64;
        while j < n { if v.get(j) < v.get(m) { m = j; } j = j + 1i64; }
        if m != i { let t: i64 = v.get(i); v.set(i, v.get(m)); v.set(m, t); }
        i = i + 1i64;
    }
}
fn veq(a: &mut Vec<i64>, b: &mut Vec<i64>) -> bool {
    if a.len() != b.len() { return false; }
    isort(a); isort(b);
    let mut i: i64 = 0i64;
    while i < a.len() { if a.get(i) != b.get(i) { return false; } i = i + 1i64; }
    return true;
}

// naive transitive closure over N nodes (length >= 1)
fn naive_tc(sv: &Vec<i64>, dv: &Vec<i64>, N: i64) -> Vec<i64> {
    let mut reach: Vec<bool> = vec_new::<bool>();
    let mut z: i64 = 0i64;
    while z < N * N { reach.push(false); z = z + 1i64; }
    let ne: i64 = sv.len();
    let mut e: i64 = 0i64;
    while e < ne { reach.set(sv.get(e) * N + dv.get(e), true); e = e + 1i64; }
    // Floyd-Warshall transitive closure
    let mut k: i64 = 0i64;
    while k < N {
        let mut a: i64 = 0i64;
        while a < N {
            let mut b: i64 = 0i64;
            while b < N {
                if reach.get(a * N + k) && reach.get(k * N + b) { reach.set(a * N + b, true); }
                b = b + 1i64;
            }
            a = a + 1i64;
        }
        k = k + 1i64;
    }
    let mut out: Vec<i64> = vec_new::<i64>();
    let mut a2: i64 = 0i64;
    while a2 < N {
        let mut b2: i64 = 0i64;
        while b2 < N {
            if reach.get(a2 * N + b2) { out.push(a2 * 100i64 + b2); }
            b2 = b2 + 1i64;
        }
        a2 = a2 + 1i64;
    }
    return out;
}

// naive mutual recursion: odd/even length paths (>=1 hop), fixpoint
fn naive_odd(sv: &Vec<i64>, dv: &Vec<i64>, N: i64) -> Vec<i64> {
    let mut odd: Vec<bool> = vec_new::<bool>();
    let mut evn: Vec<bool> = vec_new::<bool>();
    let mut z: i64 = 0i64;
    while z < N * N { odd.push(false); evn.push(false); z = z + 1i64; }
    let ne: i64 = sv.len();
    let mut e: i64 = 0i64;
    while e < ne { odd.set(sv.get(e) * N + dv.get(e), true); e = e + 1i64; }
    let mut changed: bool = true;
    while changed {
        changed = false;
        // even = odd ∘ edge
        let mut a: i64 = 0i64;
        while a < N {
            let mut b: i64 = 0i64;
            while b < N {
                if odd.get(a * N + b) {
                    let mut ei: i64 = 0i64;
                    while ei < ne {
                        if sv.get(ei) == b {
                            let idx: i64 = a * N + dv.get(ei);
                            if !evn.get(idx) { evn.set(idx, true); changed = true; }
                        }
                        ei = ei + 1i64;
                    }
                }
                b = b + 1i64;
            }
            a = a + 1i64;
        }
        // odd = edges ∪ (even ∘ edge)
        let mut a2: i64 = 0i64;
        while a2 < N {
            let mut b2: i64 = 0i64;
            while b2 < N {
                if evn.get(a2 * N + b2) {
                    let mut ei2: i64 = 0i64;
                    while ei2 < ne {
                        if sv.get(ei2) == b2 {
                            let idx2: i64 = a2 * N + dv.get(ei2);
                            if !odd.get(idx2) { odd.set(idx2, true); changed = true; }
                        }
                        ei2 = ei2 + 1i64;
                    }
                }
                b2 = b2 + 1i64;
            }
            a2 = a2 + 1i64;
        }
    }
    let mut out: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < N {
        let mut j: i64 = 0i64;
        while j < N { if odd.get(i * N + j) { out.push(i * 100i64 + j); } j = j + 1i64; }
        i = i + 1i64;
    }
    return out;
}

fn main() -> i32 {
    let mut rng: Rng = Rng { s: 0xD1B54A32D192ED03u64 };
    let N: i64 = 5i64;
    let NITER: i64 = 2000i64;

    let mut it: i64 = 0i64;
    while it < NITER {
        let ne: i64 = rng.upto(8i64);   // 0..7 edges, includes empty graph
        let mut sv: Vec<i64> = vec_new::<i64>();
        let mut dv: Vec<i64> = vec_new::<i64>();
        let mut sl: Vec<SE> = vec_new::<SE>();
        let mut k: i64 = 0i64;
        while k < ne {
            let s: i64 = rng.upto(N); let t: i64 = rng.upto(N);
            sv.push(s); dv.push(t); sl.push(SE { src: s, dst: t });
            k = k + 1i64;
        }
        let mut naive: Vec<i64> = naive_tc(&sv, &dv, N);
        let mut stat: Vec<i64> = tc(sl.as_slice()).unwrap();

        if !veq(&mut stat, &mut naive) { return 10i32; }

        // ── mutual recursion odd/even ──
        let mut nodd: Vec<i64> = naive_odd(&sv, &dv, N);
        let mut sodd: Vec<i64> = mut_odd(sl.as_slice()).unwrap();
        if !veq(&mut sodd, &mut nodd) { return 30i32; }

        it = it + 1i64;
    }
    return 0i32;
}
