// WQL — THE LATTICE'S COMPARISON FACTS ARE MEASURED AGAINST THE LANGUAGE.
//
// `ElTy.self_ord` / `ElTy.self_ident` say what `<`, `>`, `==` and the emitted hash
// DO for a type. They are the antecedent of the join-order licence (C1) and of the
// group/equi-join key capability, so a wrong one is a plan decision taken over a
// comparison that does not do what the plan believes.
//
// They used to be INFERRED FROM THE FOUR-VALUE CLASS TAG:
//
//     self_ord = if cls == EL_TY_FLT() { PARTIAL } else { OK }
//
// which is a claim about the instructions the backend selects, derived from how
// this compiler happens to bucket types. It was FALSE for the whole life of the
// table: `usize` is `EL_TY_INT`, so the tag said "OK, the emitted `<` realizes
// usize's order", and the backend emitted `slt` — every usize at or above 2^63
// ranked below zero (fixed in `0684b185`; the INFERENCE was unfounded before that
// commit and is still unfounded after it, which is why it is gone). It was false a
// second way for `String`: the tag said the emitted comparison is faithful, and
// the backend emits no `String` comparison at all.
//
// THIS FIXTURE IS WHERE THOSE FACTS ARE KEPT HONEST. For every type `el_ty` names
// it RUNS the comparison in the language, on values at the extremes that separate
// a right lowering from a wrong one, and compares the outcome with the row:
//
//   unsigned  1 < 2^(w-1) < 2^w - 1        — the middle value has its top bit set,
//                                            so a signed `<` ranks it below 1
//   signed    -2^(w-1) < 0 < 2^(w-1) - 1   — an unsigned `<` ranks the minimum top
//   float     -1.5 < 0.0 < 1.5, plus a NaN — which must compare false against
//                                            every value INCLUDING ITSELF
//   bool      false < true
//   str       "" < "a" < "ab", and "z" < "é" (byte order, not code point order:
//             `é` is 0xC3 0xA9 and `z` is 0x7A)
//   String    its content compared through the `str` view
//
// and, for every type the lattice licenses as an INDEX key, calls the `Hash` and
// `Eq` instances: equal values must hash equal and `Eq::eq` must agree with `==`.
// That call is also the proof the instances EXIST — a type `el_index_key_ok`
// admits without a `Hash` impl does not compile here.
//
// ⚠ THE VALUES COME FROM CALLS, never from literals in the comparison, so nothing
// under test can be folded away before the backend picks a predicate.
//
// ⚠ WHAT THE .expected PINS IS THE LANGUAGE, NOT THE TABLE. Each line is what the
// running program measured; the `agree=` column is the table's answer checked
// against it. A lowering change moves the measured column and fails the test; a
// table edit moves the agreement column and fails the test. Both are the point.
//
// ⚠ THE ONE ROW THAT CANNOT BE MEASURED AT RUN TIME IS `String`'s ORDER, because
// there is nothing to run: `a < b` over two `String`s passes sema and dies in
// mlir_gen with "'logos.mem.string.String__lt' does not reference a valid
// function". Absence of an operator is a COMPILE-time fact, so the probe records
// it as `NO_CMP` and this comment is its witness. If `String` ever gains an `lt`,
// the row and this probe are both wrong and must both be revisited — that residual
// is stated rather than hidden.
package test;

use logos.std.wql.el;
use logos.lang.str;
use logos.lang.hash;
use logos.lang.cmp;
use logos.mem.string;

extern fn printf(fmt: *const u8, ...) -> i32;

fn emit(b: &mut String) {
    b.push_u8(10u8);
    b.push_u8(0u8);
    let f: str = "%s";
    unsafe { printf(f.as_ptr(), b.as_ptr()); }
}

/// The hash the backend emits for this type, through the same `Hasher` the
/// `HashMap` uses. Generic, so it exists only for types with a `Hash` instance.
fn hv<K: Hash>(k: &K) -> u64 {
    let mut s: FxHasher = fx_hasher_new();
    k.hash(&mut s);
    return s.finish();
}
/// The `Eq` instance — the equality a `HashMap` bucket actually calls, which is
/// not the same artifact as the `==` operator and must agree with it.
fn eqv<K: Eq>(a: &K, b: &K) -> bool { return a.eq(b); }

// ── MEASURED VERDICTS (this fixture's vocabulary, not the table's) ─────────
// The mapping onto `EL_ORD_*` / `EL_ID_*` is in `expect_ord` / `expect_ident`,
// and MISORDER / BAD map onto NOTHING: a type whose `<` is total and ranks
// against its own order is a language defect, not a table entry, so it can only
// ever be reported as a disagreement.
fn M_OK()       -> i32 { return 0i32; }
fn M_PARTIAL()  -> i32 { return 1i32; }
fn M_MISORDER() -> i32 { return 2i32; }
fn M_NO_CMP()   -> i32 { return 3i32; }

fn I_OK()    -> i32 { return 0i32; }
fn I_NO_EQ() -> i32 { return 1i32; }
fn I_BAD()   -> i32 { return 2i32; }

pub struct Meas {
    pub s_ord:   i32,   // M_* — what `<` / `>` did on this type's own values
    pub s_ident: i32,   // I_* — what `==` (and the hash) did on them
    pub inj:     bool,  // the conversion into `repr` kept distinct values distinct
    pub keeps:   bool,  // the conversion into `repr` kept the order
    pub hashed:  bool,  // this probe called the `Hash` + `Eq` instances
}

fn ord_verdict(chain: bool, refl: bool, total: bool) -> i32 {
    if !chain { return M_MISORDER(); }   // ranks against the type's own order
    if !refl  { return M_PARTIAL(); }    // a value comparable to nothing, not even itself
    if !total { return M_PARTIAL(); }    // some pair satisfies none of < == >
    return M_OK();
}
fn ident_verdict(refl: bool, dist: bool, hok: bool) -> i32 {
    if !refl { return I_NO_EQ(); }       // equality is not reflexive
    if !dist { return I_BAD(); }         // distinct values compare equal
    if !hok  { return I_BAD(); }         // the hash or `Eq` disagrees with `==`
    return I_OK();
}
fn mk(chain: bool, refl: bool, total: bool, dist: bool, hok: bool,
      inj: bool, keeps: bool, hashed: bool) -> Meas {
    return Meas { s_ord: ord_verdict(chain, refl, total),
                  s_ident: ident_verdict(refl, dist, hok),
                  inj: inj, keeps: keeps, hashed: hashed };
}

// ── THE LADDERS ───────────────────────────────────────────────────────────
// Every value is returned by a call. A literal written into the comparison
// itself could be folded before the backend chooses a predicate, and then the
// measurement would be of the folder rather than of the emitted code.
fn k_i8(i: i64)  -> i8  { if i == 0i64 { return -128i8; }   if i == 1i64 { return 0i8; } return 127i8; }
fn k_i16(i: i64) -> i16 { if i == 0i64 { return -32768i16; } if i == 1i64 { return 0i16; } return 32767i16; }
fn k_i32(i: i64) -> i32 { if i == 0i64 { return -2147483648i32; } if i == 1i64 { return 0i32; } return 2147483647i32; }
fn k_i64(i: i64) -> i64 { if i == 0i64 { return (-9223372036854775807i64) - 1i64; } if i == 1i64 { return 0i64; } return 9223372036854775807i64; }
fn k_i128(i: i64) -> i128 {
    if i == 0i64 { return (-170141183460469231731687303715884105727i128) - 1i128; }
    if i == 1i64 { return 0i128; }
    return 170141183460469231731687303715884105727i128;
}
fn k_u8(i: i64)  -> u8  { if i == 0i64 { return 1u8; }  if i == 1i64 { return 128u8; }   return 255u8; }
fn k_u16(i: i64) -> u16 { if i == 0i64 { return 1u16; } if i == 1i64 { return 32768u16; } return 65535u16; }
fn k_u32(i: i64) -> u32 { if i == 0i64 { return 1u32; } if i == 1i64 { return 2147483648u32; } return 4294967295u32; }
fn k_u64(i: i64) -> u64 { if i == 0i64 { return 1u64; } if i == 1i64 { return 9223372036854775808u64; } return 18446744073709551615u64; }
fn k_u128(i: i64) -> u128 {
    if i == 0i64 { return 1u128; }
    if i == 1i64 { return 170141183460469231731687303715884105728u128; }
    return 340282366920938463463374607431768211455u128;
}
fn k_isize(i: i64) -> isize { return k_i64(i) as isize; }
fn k_usize(i: i64) -> usize { return k_u64(i) as usize; }
fn k_i56(i: i64) -> i56 { if i == 0i64 { return -36028797018963968i64 as i56; } if i == 1i64 { return 0i64 as i56; } return 36028797018963967i64 as i56; }
fn k_u56(i: i64) -> u56 { if i == 0i64 { return 1u64 as u56; } if i == 1i64 { return 36028797018963968u64 as u56; } return 72057594037927935u64 as u56; }
fn k_i24(i: i64) -> i24 { if i == 0i64 { return -8388608i64 as i24; } if i == 1i64 { return 0i64 as i24; } return 8388607i64 as i24; }
fn k_u24(i: i64) -> u24 { if i == 0i64 { return 1u64 as u24; } if i == 1i64 { return 8388608u64 as u24; } return 16777215u64 as u24; }
fn k_f64(i: i64) -> f64 { if i == 0i64 { return -1.5; } if i == 1i64 { return 0.0; } return 1.5; }
fn k_f32(i: i64) -> f32 { if i == 0i64 { return -1.5f32; } if i == 1i64 { return 0.0f32; } return 1.5f32; }
fn nan_f64() -> f64 { let z: f64 = k_f64(1i64); return z / z; }
fn nan_f32() -> f32 { let z: f32 = k_f32(1i64); return z / z; }
fn k_bool(i: i64) -> bool { if i == 0i64 { return false; } return true; }
fn k_str(i: i64) -> str { if i == 0i64 { return ""; } if i == 1i64 { return "a"; } return "ab"; }
/// A second, independent producer of the same bytes — an equal value of separate
/// provenance, which is what "equal values hash equal" has to be asked about.
fn k_str2(i: i64) -> str { if i == 0i64 { return ""; } if i == 1i64 { return "a"; } return "ab"; }
fn k_zed() -> str { return "z"; }
fn k_acc() -> str { return "é"; }
fn k_string(i: i64) -> String {
    let mut b: String = String::new();
    b.push_str(k_str(i));
    return b;
}

// ── THE PROBES ────────────────────────────────────────────────────────────
fn m_i8() -> Meas {
    let lo: i8 = k_i8(0i64); let md: i8 = k_i8(1i64); let hi: i8 = k_i8(2i64);
    let nlo: i64 = lo as i64; let nmd: i64 = md as i64; let nhi: i64 = hi as i64;
    return mk((lo < md) && (md < hi) && (lo < hi) && (md > lo) && (hi > md) && (hi > lo)
                && !(md < lo) && !(hi < md) && !(lo > md),
              !(hi < hi) && !(hi > hi) && (hi == hi) && (lo == lo) && (md == md),
              (lo < md) || (lo == md) || (lo > md),
              !(lo == md) && !(md == hi) && !(lo == hi),
              hv(&lo) == hv(&k_i8(0i64)) && hv(&hi) == hv(&k_i8(2i64))
                && eqv(&hi, &k_i8(2i64)) && !eqv(&lo, &hi),
              (nlo != nmd) && (nmd != nhi) && (nlo != nhi)
                && ((nlo as i8) == lo) && ((nmd as i8) == md) && ((nhi as i8) == hi),
              (nlo < nmd) && (nmd < nhi) && (nlo < nhi), true);
}
fn m_i16() -> Meas {
    let lo: i16 = k_i16(0i64); let md: i16 = k_i16(1i64); let hi: i16 = k_i16(2i64);
    let nlo: i64 = lo as i64; let nmd: i64 = md as i64; let nhi: i64 = hi as i64;
    return mk((lo < md) && (md < hi) && (lo < hi) && (md > lo) && (hi > md) && (hi > lo)
                && !(md < lo) && !(hi < md) && !(lo > md),
              !(hi < hi) && !(hi > hi) && (hi == hi) && (lo == lo) && (md == md),
              (lo < md) || (lo == md) || (lo > md),
              !(lo == md) && !(md == hi) && !(lo == hi),
              hv(&lo) == hv(&k_i16(0i64)) && hv(&hi) == hv(&k_i16(2i64))
                && eqv(&hi, &k_i16(2i64)) && !eqv(&lo, &hi),
              (nlo != nmd) && (nmd != nhi) && (nlo != nhi)
                && ((nlo as i16) == lo) && ((nmd as i16) == md) && ((nhi as i16) == hi),
              (nlo < nmd) && (nmd < nhi) && (nlo < nhi), true);
}
fn m_i32() -> Meas {
    let lo: i32 = k_i32(0i64); let md: i32 = k_i32(1i64); let hi: i32 = k_i32(2i64);
    let nlo: i64 = lo as i64; let nmd: i64 = md as i64; let nhi: i64 = hi as i64;
    return mk((lo < md) && (md < hi) && (lo < hi) && (md > lo) && (hi > md) && (hi > lo)
                && !(md < lo) && !(hi < md) && !(lo > md),
              !(hi < hi) && !(hi > hi) && (hi == hi) && (lo == lo) && (md == md),
              (lo < md) || (lo == md) || (lo > md),
              !(lo == md) && !(md == hi) && !(lo == hi),
              hv(&lo) == hv(&k_i32(0i64)) && hv(&hi) == hv(&k_i32(2i64))
                && eqv(&hi, &k_i32(2i64)) && !eqv(&lo, &hi),
              (nlo != nmd) && (nmd != nhi) && (nlo != nhi)
                && ((nlo as i32) == lo) && ((nmd as i32) == md) && ((nhi as i32) == hi),
              (nlo < nmd) && (nmd < nhi) && (nlo < nhi), true);
}
