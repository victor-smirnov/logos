              hv(&lo) == hv(&k_usize(0i64)) && hv(&hi) == hv(&k_usize(2i64))
                && eqv(&hi, &k_usize(2i64)) && !eqv(&lo, &hi),
              (nlo != nmd) && (nmd != nhi) && (nlo != nhi)
                && ((nlo as usize) == lo) && ((nmd as usize) == md) && ((nhi as usize) == hi),
              (nlo < nmd) && (nmd < nhi) && (nlo < nhi), true);
}
fn m_i56() -> Meas {
    let lo: i56 = k_i56(0i64); let md: i56 = k_i56(1i64); let hi: i56 = k_i56(2i64);
    let nlo: i64 = lo as i64; let nmd: i64 = md as i64; let nhi: i64 = hi as i64;
    return mk((lo < md) && (md < hi) && (lo < hi) && (md > lo) && (hi > md) && (hi > lo)
                && !(md < lo) && !(hi < md) && !(lo > md),
              !(hi < hi) && !(hi > hi) && (hi == hi) && (lo == lo) && (md == md),
              (lo < md) || (lo == md) || (lo > md),
              !(lo == md) && !(md == hi) && !(lo == hi),
              hv(&lo) == hv(&k_i56(0i64)) && hv(&hi) == hv(&k_i56(2i64))
                && eqv(&hi, &k_i56(2i64)) && !eqv(&lo, &hi),
              (nlo != nmd) && (nmd != nhi) && (nlo != nhi)
                && ((nlo as i56) == lo) && ((nmd as i56) == md) && ((nhi as i56) == hi),
              (nlo < nmd) && (nmd < nhi) && (nlo < nhi), true);
}
fn m_i24() -> Meas {
    let lo: i24 = k_i24(0i64); let md: i24 = k_i24(1i64); let hi: i24 = k_i24(2i64);
    let nlo: i64 = lo as i64; let nmd: i64 = md as i64; let nhi: i64 = hi as i64;
    return mk((lo < md) && (md < hi) && (lo < hi) && (md > lo) && (hi > md) && (hi > lo)
                && !(md < lo) && !(hi < md) && !(lo > md),
              !(hi < hi) && !(hi > hi) && (hi == hi) && (lo == lo) && (md == md),
              (lo < md) || (lo == md) || (lo > md),
              !(lo == md) && !(md == hi) && !(lo == hi),
              hv(&lo) == hv(&k_i24(0i64)) && hv(&hi) == hv(&k_i24(2i64))
                && eqv(&hi, &k_i24(2i64)) && !eqv(&lo, &hi),
              (nlo != nmd) && (nmd != nhi) && (nlo != nhi)
                && ((nlo as i24) == lo) && ((nmd as i24) == md) && ((nhi as i24) == hi),
              (nlo < nmd) && (nmd < nhi) && (nlo < nhi), true);
}
fn m_u24() -> Meas {
    let lo: u24 = k_u24(0i64); let md: u24 = k_u24(1i64); let hi: u24 = k_u24(2i64);
    let nlo: i64 = lo as i64; let nmd: i64 = md as i64; let nhi: i64 = hi as i64;
    return mk((lo < md) && (md < hi) && (lo < hi) && (md > lo) && (hi > md) && (hi > lo)
                && !(md < lo) && !(hi < md) && !(lo > md),
              !(hi < hi) && !(hi > hi) && (hi == hi) && (lo == lo) && (md == md),
              (lo < md) || (lo == md) || (lo > md),
              !(lo == md) && !(md == hi) && !(lo == hi),
              hv(&lo) == hv(&k_u24(0i64)) && hv(&hi) == hv(&k_u24(2i64))
                && eqv(&hi, &k_u24(2i64)) && !eqv(&lo, &hi),
              (nlo != nmd) && (nmd != nhi) && (nlo != nhi)
                && ((nlo as u24) == lo) && ((nmd as u24) == md) && ((nhi as u24) == hi),
              (nlo < nmd) && (nmd < nhi) && (nlo < nhi), true);
}
fn m_u56() -> Meas {
    let lo: u56 = k_u56(0i64); let md: u56 = k_u56(1i64); let hi: u56 = k_u56(2i64);
    let nlo: i64 = lo as i64; let nmd: i64 = md as i64; let nhi: i64 = hi as i64;
    return mk((lo < md) && (md < hi) && (lo < hi) && (md > lo) && (hi > md) && (hi > lo)
                && !(md < lo) && !(hi < md) && !(lo > md),
              !(hi < hi) && !(hi > hi) && (hi == hi) && (lo == lo) && (md == md),
              (lo < md) || (lo == md) || (lo > md),
              !(lo == md) && !(md == hi) && !(lo == hi),
              hv(&lo) == hv(&k_u56(0i64)) && hv(&hi) == hv(&k_u56(2i64))
                && eqv(&hi, &k_u56(2i64)) && !eqv(&lo, &hi),
              (nlo != nmd) && (nmd != nhi) && (nlo != nhi)
                && ((nlo as u56) == lo) && ((nmd as u56) == md) && ((nhi as u56) == hi),
              (nlo < nmd) && (nmd < nhi) && (nlo < nhi), true);
}
// The float probes ask the SAME questions, and the reflexivity witness is a NaN
// rather than the ladder's top: that is the whole difference between this class
// and every other one, and it is measured rather than assumed.
fn m_f32() -> Meas {
    let lo: f32 = k_f32(0i64); let md: f32 = k_f32(1i64); let hi: f32 = k_f32(2i64);
    let nn: f32 = nan_f32();
    let nlo: f64 = lo as f64; let nmd: f64 = md as f64; let nhi: f64 = hi as f64;
    return mk((lo < md) && (md < hi) && (lo < hi) && (md > lo) && (hi > md) && (hi > lo)
                && !(md < lo) && !(hi < md) && !(lo > md),
              !(nn < nn) && !(nn > nn) && (nn == nn) && (lo == lo) && (md == md) && (hi == hi),
              (nn < md) || (nn == md) || (nn > md),
              !(lo == md) && !(md == hi) && !(lo == hi),
              true,
              (nlo != nmd) && (nmd != nhi) && (nlo != nhi)
                && ((nlo as f32) == lo) && ((nmd as f32) == md) && ((nhi as f32) == hi),
              (nlo < nmd) && (nmd < nhi) && (nlo < nhi), false);
}
fn m_f64() -> Meas {
    let lo: f64 = k_f64(0i64); let md: f64 = k_f64(1i64); let hi: f64 = k_f64(2i64);
    let nn: f64 = nan_f64();
    return mk((lo < md) && (md < hi) && (lo < hi) && (md > lo) && (hi > md) && (hi > lo)
                && !(md < lo) && !(hi < md) && !(lo > md),
              !(nn < nn) && !(nn > nn) && (nn == nn) && (lo == lo) && (md == md) && (hi == hi),
              (nn < md) || (nn == md) || (nn > md),
              !(lo == md) && !(md == hi) && !(lo == hi),
              true,
              !(lo == md) && !(md == hi) && !(lo == hi),
              (lo < md) && (md < hi), false);
}
// `bool` has two values, so the ladder is a pair; everything else is unchanged.
fn m_bool() -> Meas {
    let lo: bool = k_bool(0i64); let hi: bool = k_bool(1i64);
    return mk((lo < hi) && (hi > lo) && !(hi < lo) && !(lo > hi),
              !(hi < hi) && !(hi > hi) && (hi == hi) && (lo == lo),
              (lo < hi) || (lo == hi) || (lo > hi),
              !(lo == hi),
              hv(&lo) == hv(&k_bool(0i64)) && hv(&hi) == hv(&k_bool(1i64))
                && eqv(&hi, &k_bool(1i64)) && !eqv(&lo, &hi),
              !(lo == hi), lo < hi, true);
}
// `str` is byte-lexicographic, so the ladder carries the empty string and a
// multi-byte value whose first byte outranks `z` — a code-point comparison would
// order those two the same way, a length comparison would not, and a comparison
// that stopped at the NUL of the shorter string would put "ab" before "a".
fn m_str() -> Meas {
    let lo: str = k_str(0i64); let md: str = k_str(1i64); let hi: str = k_str(2i64);
    return mk((lo < md) && (md < hi) && (lo < hi) && (md > lo) && (hi > md) && (hi > lo)
                && !(md < lo) && !(hi < md) && !(lo > md)
                && (k_zed() < k_acc()) && !(k_acc() < k_zed()),
              !(hi < hi) && !(hi > hi) && (hi == hi) && (lo == lo) && (md == md),
              (lo < md) || (lo == md) || (lo > md),
              !(lo == md) && !(md == hi) && !(lo == hi),
              hv(&lo) == hv(&k_str2(0i64)) && hv(&hi) == hv(&k_str2(2i64))
                && eqv(&hi, &k_str2(2i64)) && !eqv(&lo, &hi),
              !(lo == md) && !(md == hi) && !(lo == hi),
              (lo < md) && (md < hi), true);
}
// `String`: `==` IS emitted and exact; `<` IS NOT EMITTED AT ALL (see the header),
// so the order verdict is the compile-time fact NO_CMP and everything else is
// measured through the `str` view the EL normalizes a String into.
fn m_string() -> Meas {
    let refl: bool = (k_string(0i64) == k_string(0i64))
                  && (k_string(1i64) == k_string(1i64))
                  && (k_string(2i64) == k_string(2i64));
    let dist: bool = !(k_string(0i64) == k_string(1i64))
                  && !(k_string(1i64) == k_string(2i64))
                  && !(k_string(0i64) == k_string(2i64));
    let a: String = k_string(0i64); let b: String = k_string(1i64); let c: String = k_string(2i64);
    let keeps: bool = (a.as_str() < b.as_str()) && (b.as_str() < c.as_str());
    let inj: bool = !(a.as_str() == b.as_str()) && !(b.as_str() == c.as_str())
                 && (c.as_str() == k_string(2i64).as_str());
    return Meas { s_ord: M_NO_CMP(), s_ident: ident_verdict(refl, dist, true),
                  inj: inj, keeps: keeps, hashed: false };
}

fn probe(name: str) -> Meas {
    if str_eq(name, "i8")     { return m_i8(); }
    if str_eq(name, "i16")    { return m_i16(); }
    if str_eq(name, "i32")    { return m_i32(); }
    if str_eq(name, "i64")    { return m_i64(); }
    if str_eq(name, "i128")   { return m_i128(); }
    if str_eq(name, "u8")     { return m_u8(); }
    if str_eq(name, "u16")    { return m_u16(); }
    if str_eq(name, "u32")    { return m_u32(); }
    if str_eq(name, "u64")    { return m_u64(); }
    if str_eq(name, "u128")   { return m_u128(); }
    if str_eq(name, "isize")  { return m_isize(); }
    if str_eq(name, "usize")  { return m_usize(); }
    if str_eq(name, "i56")    { return m_i56(); }
    if str_eq(name, "u56")    { return m_u56(); }
    if str_eq(name, "i24")    { return m_i24(); }
    if str_eq(name, "u24")    { return m_u24(); }
    if str_eq(name, "f32")    { return m_f32(); }
    if str_eq(name, "f64")    { return m_f64(); }
    if str_eq(name, "bool")   { return m_bool(); }
    if str_eq(name, "str")    { return m_str(); }
    if str_eq(name, "String") { return m_string(); }
    // NO PROBE — a row was added to the lattice and nobody measured it. The
    // verdicts below cannot match any stored code, so the gate fails naming it.
    return Meas { s_ord: -1i32, s_ident: -1i32, inj: false, keeps: false, hashed: false };
}

// ── MEASURED → THE CODE THE ROW MUST CARRY ────────────────────────────────
// The two negative results are OUTSIDE the `EL_ORD_*` / `EL_ID_*` domains on
// purpose: no row may carry them, so they can only ever surface as a
// disagreement, and each names a distinct thing to go fix.
fn X_MISORDER() -> i32 { return -1i32; }   // total, and ranks against its own order
fn X_UNPROBED() -> i32 { return -2i32; }   // a lattice row nobody measured
fn X_LOSSY()    -> i32 { return -3i32; }   // the conversion lost values it should not

fn expect_self_ord(m: Meas) -> i32 {
    if m.s_ord == M_OK()       { return EL_ORD_OK(); }
    if m.s_ord == M_PARTIAL()  { return EL_ORD_PARTIAL(); }
    if m.s_ord == M_NO_CMP()   { return EL_ORD_NO_CMP(); }
    if m.s_ord == M_MISORDER() { return X_MISORDER(); }
    return X_UNPROBED();
}
fn expect_self_ident(m: Meas) -> i32 {
    if m.s_ident == I_OK()    { return EL_ID_OK(); }
    if m.s_ident == I_NO_EQ() { return EL_ID_NO_EQ(); }
    if m.s_ident == I_BAD()   { return X_MISORDER(); }
    return X_UNPROBED();
}
/// `ord` is the composition the table claims: the value survives the conversion
/// into `repr`, and then `repr`'s OWN comparison decides. Both halves measured.
fn expect_ord(m: Meas, repr: Meas, bits: i64, cls: i32) -> i32 {
    if !m.inj {
        if cls == EL_TY_INT() && bits > 64i64 { return EL_ORD_TRUNC(); }
        return X_LOSSY();
    }
    if !m.keeps { return EL_ORD_WRAP(); }
    return expect_self_ord(repr);
}
fn expect_ident(m: Meas, repr: Meas) -> i32 {
    if m.s_ident == I_NO_EQ() { return EL_ID_NO_EQ(); }
    if !m.inj                 { return EL_ID_NO_INJ(); }
    return expect_self_ident(repr);
}

fn ord_name(o: i32) -> str {
    if o == X_MISORDER()     { return "MISORDER"; }
    if o == X_UNPROBED()     { return "UNPROBED"; }
    if o == X_LOSSY()        { return "LOSSY"; }
    if o == EL_ORD_OK()      { return "OK"; }
    if o == EL_ORD_PARTIAL() { return "PARTIAL"; }
    if o == EL_ORD_WRAP()    { return "WRAP"; }
    if o == EL_ORD_TRUNC()   { return "TRUNC"; }
    if o == EL_ORD_UNNAMED() { return "UNNAMED"; }
    if o == EL_ORD_NO_CMP()  { return "NO_CMP"; }
    return "??";
}
fn id_name(i: i32) -> str {
    if i == X_MISORDER()    { return "BAD"; }
    if i == X_UNPROBED()    { return "UNPROBED"; }
    if i == EL_ID_OK()      { return "OK"; }
    if i == EL_ID_NO_EQ()   { return "NO_EQ"; }
    if i == EL_ID_NO_INJ()  { return "NO_INJ"; }
    if i == EL_ID_UNNAMED() { return "UNNAMED"; }
    return "??";
}
fn yn(v: bool) -> str { if v { return "y"; } return "n"; }

fn cmp_field(b: &mut String, label: str, want: i32, got: i32, is_ord: bool) -> i64 {
    b.push_str(" ");
    b.push_str(label);
    b.push_str("=");
    if is_ord { b.push_str(ord_name(want)); } else { b.push_str(id_name(want)); }
    if want == got { return 0i64; }
    b.push_str("/TABLE=");
    if is_ord { b.push_str(ord_name(got)); } else { b.push_str(id_name(got)); }
    b.push_str("!MISMATCH");
    return 1i64;
}
fn cmp_bool(b: &mut String, label: str, want: bool, got: bool) -> i64 {
    b.push_str(" ");
    b.push_str(label);
    b.push_str("=");
    b.push_str(yn(want));
    if want == got { return 0i64; }
    b.push_str("/TABLE=");
    b.push_str(yn(got));
    b.push_str("!MISMATCH");
    return 1i64;
}

fn main() -> i32 {
    let mut bad: i64 = 0i64;
    let n: i64 = el_ty_arity();
    let mut i: i64 = 0i64;
    while i < n {
        let t: ElTy = el_ty_at(i);
        let m: Meas = probe(t.name);
        let r: Meas = probe(t.repr);
        let mut b: String = String::new();
        b.push_str(t.name);
        bad = bad + cmp_field(&mut b, "self_ord",   expect_self_ord(m), t.self_ord, true);
        bad = bad + cmp_field(&mut b, "self_ident", expect_self_ident(m), t.self_ident, false);
        bad = bad + cmp_field(&mut b, "ord",   expect_ord(m, r, t.bits, t.cls), t.ord, true);
        bad = bad + cmp_field(&mut b, "ident", expect_ident(m, r), t.ident, false);
        bad = bad + cmp_bool(&mut b, "fits",  m.inj && m.keeps, t.fits);
        bad = bad + cmp_bool(&mut b, "index", m.hashed, el_index_key_ok(t.name));
        emit(&mut b);
        i = i + 1i64;
    }

    // ⚠ THE ARITY IS PINNED AGAINST THE CASE LIST, not asserted beside it: the last
    // admitted index must be admitted and the next one must not. A row added to
    // `el_ty_at` without bumping `el_ty_arity` is invisible to `el_ty` and to the
    // loop above; a bump without a row hands the scan a denied name.
    let mut c: String = String::new();
    c.push_str("arity="); c.push_i64(n);
    c.push_str(" last_admitted="); c.push_str(yn(el_ty_at(n - 1i64).cls >= 0i32));
    c.push_str(" past_end_denied="); c.push_str(yn(el_ty_at(n).cls < 0i32));
    // And the scan finds by NAME what the enumeration returns by index.
    let mut round: bool = true;
    let mut j: i64 = 0i64;
    while j < n {
        if el_ty(el_ty_at(j).name).cls != el_ty_at(j).cls { round = false; }
        j = j + 1i64;
    }
    c.push_str(" name_scan_agrees="); c.push_str(yn(round));
    emit(&mut c);

    let mut d: String = String::new();
    d.push_str("mismatches="); d.push_i64(bad);
    emit(&mut d);
    return bad as i32;
}
