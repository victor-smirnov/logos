// CLOSED soundness_queue row array_rvalue_range_index_temp_never_dropped (tier 1), round 2026-09-14o-autoreffund.
// `mkarr(p)[0..1]` borrows the array rvalue to decay it to a slice; the array was spilled with no owner and neither element
// was dropped (n=0). Now owned by the statement temp scope. Oracle: destructor count 1001, exit 0.
package bc_autoreffund_array_range_temp_dropped_admit;
use logos.lang.cmp;
use logos.mem.string;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
impl Eq for D { fn eq(&self, other: &D) -> bool { return self.v > 0i64 && other.v > 0i64; } }
fn mkarr(p: *mut i64) -> [D; 2] { return [D { v: 1i64, c: p }, D { v: 1000i64, c: p }]; }
fn body(p: *mut i64) -> i64 {
    let k: i64 = mkarr(p)[0i64..1i64].len() as i64;
    return k - 1i64;
}

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = body(p);
    let got: i64 = unsafe { n };
    unsafe { printf("n=%ld r=%ld\n".as_ptr(), got, r); }
    if r != 0i64 { return 2i32; }
    if got != 1001i64 { return 1i32; }
    return 0i32;
}
