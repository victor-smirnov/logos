// SEPARATOR CLASS — the closure-formal type hint (`preload_formals`).
// The lookup name is COMPOSED as `<struct>__<method>`, then was re-PARSED
// with `rfind("__")` to strip a `$G…` suffix — a cut that lands inside any
// method name containing `__`. Re-composed from the parts instead.
package tr;
struct hold<T> { v: T }
impl<T> hold<T> {
    fn a__b(&self, f: fn(i64) -> i64) -> i64 { return f(4i64); }
}
fn twice(x: i64) -> i64 { return x + x; }
fn main() -> i32 {
    let h = hold::<i64> { v: 1i64 };
    return h.a__b(twice) as i32;
}
