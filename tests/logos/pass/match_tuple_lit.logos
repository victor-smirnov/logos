// Tuple patterns with literal sub-patterns.

package match_tuple_lit;

fn classify(p: (i32, i32)) -> i32 {
    match p {
        (0, 0)  => 1,
        (0, _)  => 2,
        (_, 0)  => 3,
        (1, 1)  => 4,
        (a, b)  => a + b + 100,
    }
}

fn main() -> i32 {
    let s: i32 =
        classify((0, 0))    // 1
      + classify((0, 9))    // 2
      + classify((5, 0))    // 3
      + classify((1, 1))    // 4
      + classify((2, 3));   // 105
    return s;                // 115
}
