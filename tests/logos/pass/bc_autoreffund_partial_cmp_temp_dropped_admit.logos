// `a < V { .. }` derived from partial_cmp auto-borrows the fresh right operand; it was never dropped (n=1). It is now owned
// by the statement temp scope (SemaChecker::autoref_operand at push_pc). Oracle: destructor count 1001, exit 0.
package bc_autoreffund_partial_cmp_temp_dropped_admit;
use logos.lang.cmp;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
impl Eq for D { fn eq(&self, other: &D) -> bool { return self.v > 0i64 && other.v > 0i64; } }
fn mk(v: i64, c: *mut i64) -> D { return D { v: v, c: c }; }
struct V { v: i64, c: *mut i64 }
impl Drop for V { fn drop(self: &mut V) { unsafe { *self.c = *self.c + self.v; } } }
impl PartialOrd for V {
    fn partial_cmp(self: &V, other: &V) -> Ordering {
        if self.v < other.v { return Ordering::Less; }
        if self.v > other.v { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
fn body(p: *mut i64) -> i64 {
    let a: V = V { v: 1i64, c: p };
    if !(a < V { v: 1000i64, c: p }) { return 3i64; }
    return 0i64;
}

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = body(p);
    let got: i64 = unsafe { n };
    unsafe { printf("n=%ld r=%ld\n".as_ptr(), got, r); }
    if r != 0i64 { return 2i32; }
    if got != 1001i64 { return 1i32; }
    return 0i32;
}
