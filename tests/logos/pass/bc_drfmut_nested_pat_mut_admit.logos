// THE MASK, half 2 of 2 — a DIFFERENT door to the same lost fact. A struct
// pattern NESTED in a variant payload is lowered to a synthetic payload
// binding (`__pat_pld_*`) plus a prologue destructure off it; the `mut` is
// dropped there too. This half is what proves the mask must PROPAGATE along
// the projection rather than test one temp-name prefix: `__pat_pld_*` is
// itself a pattern binding, `__dst_*` is a plain `let`, and only the pair of
// them covers both doors. LEGAL Rust; refused by the one-prefix spelling.
package bc_drfmut_nested_pat_mut_admit;

struct W { b: Box<i64> }

fn main() -> i32 {
    let o: Option<W> = Option::Some(W { b: Box::new(1i64) });
    if let Option::Some(W { b: mut bb }) = o {
        let r: &mut i64 = &mut *bb;
        *r = 5i64;
        if *bb != 5i64 { return 1i32; }
    }
    return 0i32;
}
