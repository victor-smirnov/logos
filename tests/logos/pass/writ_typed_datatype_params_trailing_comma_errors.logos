// Trailing commas in @Type params are rejected in both spellings (writ2).
package writ_typed_datatype_params_trailing_comma_errors;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.mem.writ.parser;
use logos.lang.rc;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(8192);
    let h: &Writ = rc.deref();
    if !parse(h, "@I64(1,)=42").is_null() { return 1; }
    if !parse(h, "\"x\"@I64(1,)").is_null() { return 2; }
    if parse(h, "@I64(1)=42").is_null() { return 3; }
    return 0;
}
