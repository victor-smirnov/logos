// Multi-snapshot CoW smoke for v3 persistent stack.
//
//   1. snap_a creates ctr=7 with [0..50) → i*3 (multi-level: splits cause
//      Branch root). Commits → C0.
//   2. Fork B from C0: reads ctr=7 (sees 50 inherited entries), extends
//      with [50..100) → i*5. Commits → C1.
//   3. Fork C from C0: must NOT see fork B's writes — C0's container
//      stays clean. Adds [100..150) → i*7. Commits → C2.
//   4. Fork D from C0: still clean (50 entries).
//   5. Fork B' from C1: sees [0..100). 6. Fork C' from C2: sees [0..50) ∪ [100..150).
//
// Validates: dir CoW + container CoW (make_unique on snapshot mismatch),
// writeback into dir slot on root-grow, isolation between sibling forks.

package zz_v3_fork_smoke;

use std.collections.vec;
use std.mem;
use std.lang.cmp; use std.lang.ord; use std.lang.datatypes;
use std.lang.drop;
use std.hermes.view; use std.hermes.anyval;

use std.data.persistent.v3.node;
use std.data.persistent.v3.cow;
use std.data.persistent.v3.store;
use std.data.persistent.v3.handle;

pub const StoreCfg: HermesStatic = @{
    "name":     "v3-fork",
    "ctr_id":   <type:u64>,
    "snp_id":   <type:u64>,
    "block_id": <type:u64>,
};

pub const MapCfg: HermesStatic = @{
    "key":    <type:u64>,
    "value":  <type:u64>,
    "fanout": 8,
};

unsafe fn fill_range(cr: &mut ContainerRefV3<StoreCfg, MapCfg>, lo: u64, hi: u64, mul: u64, snap_id: u64, cp: *mut u64) {
    let mut i: u64 = lo;
    while i < hi {
        cr.insert(i, i * mul, &i as *const u64, snap_id, cp);
        i = i + 1u64;
    }
}

unsafe fn check_range(cr: &ContainerRefV3<StoreCfg, MapCfg>, lo: u64, hi: u64, mul: u64) -> i32 {
    let mut i: u64 = lo;
    while i < hi {
        let mut out: u64 = 0u64;
        if !cr.get(&i as *const u64, &mut out as *mut u64) { return 1i32; }
        if out != i * mul { return 2i32; }
        i = i + 1u64;
    }
    return 0i32;
}

fn main() -> i32 {
    let mut store: StoreV3<StoreCfg> = store_open_v3::<StoreCfg>();

    // Build base commit C0 — ctr=7 has [0..50) at *3 (multi-level)
    let mut c0: i64 = -1i64;
    {
        let mut snap_a: SnapV3<StoreCfg> = snap_begin_v3::<StoreCfg>(&mut store);
        {
            let mut cr: ContainerRefV3<StoreCfg, MapCfg> =
                create_pmap_v3::<MapCfg, StoreCfg>(&mut snap_a, 7u64);
            let s_id: u64 = snap_a.snapshot_id;
            let store_ref: &mut LockingStoreV3<StoreCfg> = snap_a.arc.deref_mut();
            let cp: *mut u64 = &mut store_ref.next_block_id as *mut u64;
            unsafe { fill_range(&mut cr, 0u64, 50u64, 3u64, s_id, cp); }
            if cr.len() != 50u64 { return 10; }
        }
        c0 = snap_a.commit();
    }
    if c0 < 0i64 { return 11; }

    // Fork B: extend ctr=7 with [50..100) at *5
    let mut c1: i64 = -1i64;
    {
        let mut snap_b: SnapV3<StoreCfg> = snap_fork_v3::<StoreCfg>(&mut store, c0);
        {
            let mut cr: ContainerRefV3<StoreCfg, MapCfg> =
                open_pmap_v3::<MapCfg, StoreCfg>(&mut snap_b, 7u64);
            if cr.len() != 50u64 { return 21; }
            let s_id: u64 = snap_b.snapshot_id;
            let store_ref: &mut LockingStoreV3<StoreCfg> = snap_b.arc.deref_mut();
            let cp: *mut u64 = &mut store_ref.next_block_id as *mut u64;
            unsafe { fill_range(&mut cr, 50u64, 100u64, 5u64, s_id, cp); }
            if cr.len() != 100u64 { return 22; }
        }
        c1 = snap_b.commit();
    }
    if c1 < 0i64 { return 23; }

    // Fork C from C0 — extend ctr=7 with [100..150) at *7
    let mut c2: i64 = -1i64;
    {
        let mut snap_c: SnapV3<StoreCfg> = snap_fork_v3::<StoreCfg>(&mut store, c0);
        {
            let mut cr: ContainerRefV3<StoreCfg, MapCfg> =
                open_pmap_v3::<MapCfg, StoreCfg>(&mut snap_c, 7u64);
            if cr.len() != 50u64 { return 30; }
            let s_id: u64 = snap_c.snapshot_id;
            let store_ref: &mut LockingStoreV3<StoreCfg> = snap_c.arc.deref_mut();
            let cp: *mut u64 = &mut store_ref.next_block_id as *mut u64;
            unsafe { fill_range(&mut cr, 100u64, 150u64, 7u64, s_id, cp); }
            if cr.len() != 100u64 { return 31; }
        }
        c2 = snap_c.commit();
    }
    if c2 < 0i64 { return 32; }

    // Fork D from C0 — must see only [0..50), not fork B's nor C's writes.
    {
        let mut snap_d: SnapV3<StoreCfg> = snap_fork_v3::<StoreCfg>(&mut store, c0);
        let cr: ContainerRefV3<StoreCfg, MapCfg> =
            open_pmap_v3::<MapCfg, StoreCfg>(&mut snap_d, 7u64);
        if cr.len() != 50u64 { return 40; }
        if unsafe { check_range(&cr, 0u64, 50u64, 3u64) } != 0i32 { return 41; }
        let probe: u64 = 75u64;
        if cr.contains(&probe as *const u64) { return 42; }
    }

    // Fork B' from C1 — sees [0..100) merged.
    {
        let mut snap_b2: SnapV3<StoreCfg> = snap_fork_v3::<StoreCfg>(&mut store, c1);
        let cr: ContainerRefV3<StoreCfg, MapCfg> =
            open_pmap_v3::<MapCfg, StoreCfg>(&mut snap_b2, 7u64);
        if cr.len() != 100u64 { return 50; }
        if unsafe { check_range(&cr, 0u64, 50u64, 3u64) } != 0i32 { return 51; }
        if unsafe { check_range(&cr, 50u64, 100u64, 5u64) } != 0i32 { return 52; }
        let probe: u64 = 120u64;
        if cr.contains(&probe as *const u64) { return 53; }
    }

    // Fork C' from C2 — sees [0..50) ∪ [100..150).
    {
        let mut snap_c2: SnapV3<StoreCfg> = snap_fork_v3::<StoreCfg>(&mut store, c2);
        let cr: ContainerRefV3<StoreCfg, MapCfg> =
            open_pmap_v3::<MapCfg, StoreCfg>(&mut snap_c2, 7u64);
        if cr.len() != 100u64 { return 60; }
        if unsafe { check_range(&cr, 0u64, 50u64, 3u64) } != 0i32 { return 61; }
        if unsafe { check_range(&cr, 100u64, 150u64, 7u64) } != 0i32 { return 62; }
        let probe: u64 = 75u64;
        if cr.contains(&probe as *const u64) { return 63; }
    }

    return 0;
}
