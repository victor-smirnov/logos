// A `let` array pattern over a temporary: the unbound elements drop at the end of the let (all
// bound, a `..` rest, a middle binder). rustc 1.98.1 prints the same lines.
package let_array_pattern_temp_source_drops;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn mk(p: *mut i64) -> [D; 3] { return [D { v: 1i64, c: p }, D { v: 2i64, c: p }, D { v: 3i64, c: p }]; }
fn all(p: *mut i64) { let [a, b, c] = mk(p); let _ = a.v + b.v + c.v; }
fn rest(p: *mut i64) { let [x, ..] = mk(p); let _ = x.v; }
fn mid(p: *mut i64) { let [_, y, _] = mk(p); let _ = y.v; }
fn run(f: fn(*mut i64)) { let mut n: i64 = 0i64; f(&mut n); unsafe { printf("%lld\n".as_ptr(), n); } }
fn main() -> i32 { run(all); run(rest); run(mid); return 0i32; }
