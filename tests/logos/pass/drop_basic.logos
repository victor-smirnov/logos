// Test: Drop trait — automatic cleanup at scope exit
package drop_basic;

extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: *const u8, v: i32) { unsafe { printf(fmt, v); } }

trait Drop {
    fn drop(self: Self);
}

struct Resource {
    id: i32;
}

impl Drop for Resource {
    fn drop(self: Resource) {
        printi("dropped %d\n", self.id);
    }
}

fn main() -> i32 {
    let result: i32 = 42;
    let r: Resource = Resource { id: 7 };
    // r should be dropped before return
    return result;
}
