// Cross-container subtree import on hermes2 (successor of import_from):
// clone a SUBTREE of one document into another container; both stay live and
// independent.
package hermes_import_export;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.array;
use logos.lang.hermes.hmap;
use logos.lang.hermes.hstring;
use logos.mem.hermes.parser;
use logos.mem.hermes.clone;
use logos.mem.hermes.equal;
use logos.lang.rc;
use logos.lang.str;

unsafe fn main() -> i32 {
    // 1. Source document with a nested array.
    let rc1: Rc<Hermes> = hermes_rc(16384);
    let src_h: &Hermes = rc1.deref();
    let src_root: HAny = parse(src_h, "{\"x\": 10, \"arr\": [1, 2, 3], \"s\": \"hello\"}");
    let sm: &HMap<HString, HAny> = &*(src_root.resolve() as *const HMap<HString, HAny>);
    let arr_val: HAny = sm.get("arr");
    if arr_val.is_null() { return 2; }

    // 2. Import the array subtree into a fresh container.
    let rc2: Rc<Hermes> = hermes_rc(16384);
    let dst_h: &Hermes = rc2.deref();
    let imported: HAny = hermes_clone_into(dst_h, arr_val);
    if imported.is_null() { return 4; }
    if !imported.is_array() { return 5; }
    let ia: &HArray<HAny> = &*(imported.resolve() as *const HArray<HAny>);
    if ia.len() != 3i64 { return 6; }
    if ia.get(2).as_i64() != 3i64 { return 7; }

    // 3. The copy is structurally equal but physically separate.
    if !hermes_equal(arr_val, imported) { return 8; }
    if imported.resolve() == arr_val.resolve() { return 9; }

    // 4. Import a string leaf too.
    let s_val: HAny = sm.get("s");
    let s_imp: HAny = hermes_clone_into(dst_h, s_val);
    if !s_imp.is_string() { return 10; }
    let hs: &HString = &*(s_imp.resolve() as *const HString);
    if !str_eq(hs.as_str(), "hello") { return 11; }

    // 5. Mutating the destination does not disturb the source.
    let dm: &mut HMap<HString, HAny> = dst_h.map(8);
    dm.set("import", imported);
    let dmp: *const HMap<HString, HAny> = dm as *const HMap<HString, HAny>;
    dst_h.set_root(HAny::ref_to(dmp as *const u8));
    if sm.get("x").as_i64() != 10i64 { return 12; }

    return 0;
}
