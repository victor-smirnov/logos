package copy_drop;
// A Copy type with Drop: each copy gets its own destructor call.
// Original is not consumed by pass-by-value.
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: *const u8, v: i32) { unsafe { printf(fmt, v); } }

trait Drop { fn drop(self: Self); }
trait Copy {}

struct Token { id: i32; }

impl Drop for Token {
    fn drop(self: Token) { printi("drop %d\n", self.id); }
}
impl Copy for Token {}

fn use_token(t: Token) { printi("use %d\n", t.id); }

fn main() -> i32 {
    let t = Token { id: 7 };
    use_token(t);   // copy passed — copy dropped at end of use_token
    use_token(t);   // original still live
    // t dropped at end of main
    return 0;
}
