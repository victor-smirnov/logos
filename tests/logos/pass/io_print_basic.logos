// Tests logos.std.io: print, println, eprint, eprintln.
package test;

use logos.std.io;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    // stdout
    print("hello");
    println(" world");

    // eprintln goes to stderr — not captured by the test runner's stdout check.
    eprintln("(stderr line)");

    // print_string
    let mut s: String = String::new();
    s.push_str("done");
    print_string(&s);
    print("\n");

    return 42;
}
