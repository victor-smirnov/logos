// while-let binding dropped on the `continue` path PROBES.md 2026-09-06d: `if let` / `while let` / let-chains lower BY DELEGATION to lower_match (temp hoist, per-arm scrutinee move, arm drops, cond-move merge); the count is a destructor tally through a raw pointer.
package bc_patown_whilelet_continue_readonly;
use logos.mem.collections.vec;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let mut vs: Vec<S> = Vec::new();
        vs.push(S { v: 1i64, i: p });
        vs.push(S { v: 2i64, i: p });
        let mut k: i64 = 0i64;
        while let Option::Some(r) = vs.pop() { k = k + r.v; continue; }
        if k != 3i64 { return 99i32; }
    }
    return c as i32;
}
