// Smoke: logos.mem.fmt::Formatter + FmtWrite trait.
// Mirror of core::fmt's Formatter + Write surface (renamed to
// FmtWrite to avoid colliding with logos.lcm.io.write::Write).
package test;

use logos.lang.result;
use logos.lang.str;
use logos.lang.panic;
use logos.mem.string;
use logos.mem.fmt;

fn main() -> i32 {
    let mut buf: String = String::new();
    let mut f: Formatter = formatter_for(&mut buf);

    let r1: Result<(), Error> = f.write_str("hello ");
    match r1 { Ok(_) => {} Err(_) => { return 1; } }

    let r2: Result<(), Error> = f.write_char(119u8);  // 'w'
    match r2 { Ok(_) => {} Err(_) => { return 2; } }

    let r3: Result<(), Error> = f.write_str("orld");
    match r3 { Ok(_) => {} Err(_) => { return 3; } }

    let out: str = buf.as_str();
    if !str_eq(out, "hello world") { return 4; }

    return 42;
}
