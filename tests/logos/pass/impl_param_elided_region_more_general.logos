// An impl method parameter with an elided region (`o: &M`) where the trait reads `&'a M` is more general and conforms (rustc's compare_impl_method): `impl<'a> Mul<&'a M> for &'a M` with `fn mul(self, o: &M)`.
package m133;
use logos.std.fmt;
struct M { v: i64 }
impl<'a> Mul<&'a M> for &'a M { type Output = i64; fn mul(self, o: &M) -> i64 { self.v * o.v } }
fn main() { let a = M { v: 3 }; let b = M { v: 4 }; println!("{}", &a * &b); }
