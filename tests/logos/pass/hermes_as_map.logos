// Hermes C6: MapSliceI32 → <I32,AnyVal>{} cast produces Map<i32, AnyVal> Hermes.
package hermes_as_map;
use hermes.ctr;
use std.string;

unsafe fn main() -> i32 {
    let keys_arr: [i32; 3] = [1, 2, 3];
    let vals_arr: [AnyVal; 3] = [
        AnyVal::embed_i24(10),
        AnyVal::embed_i24(20),
        AnyVal::embed_i24(30),
    ];
    let ms: MapSliceI32 = MapSliceI32 {
        keys: &keys_arr,
        vals: &vals_arr,
    };
    let ctr: Hermes = ms as <I32, AnyVal>{};
    let root: AnyVal = ctr.root();
    if root.is_null() { return 1; }
    if !root.is_ptr() { return 2; }
    let text: String = ctr.to_string();
    if !text.eq_str("<I32,AnyVal> {1:10,2:20,3:30}") { return 3; }

    return 0;
}
