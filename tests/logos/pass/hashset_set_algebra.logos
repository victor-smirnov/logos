// HashSet had no union / intersection / difference / symmetric_difference (and `union`,
// a reserved keyword, could not even be spelled as a method name: it is now accepted
// after `.` and `fn`, as `new` and `null` are), no is_subset / is_superset / is_disjoint,
// no owning for-in. The algebra yields `&K`. Checked under valgrind. rustc twin: 0.
package hashset_set_algebra;
use logos.mem.collections.set;
use logos.mem.string;
fn main() -> i32 {
    let mut a: HashSet<i32> = HashSet::new();
    let mut b: HashSet<i32> = HashSet::new();
    unsafe {
        let pa: *mut HashSet<i32> = &mut a;
        let pb: *mut HashSet<i32> = &mut b;
        pa.insert(1); pa.insert(2);
        pb.insert(2); pb.insert(3);
    }
    let u = a.union(&b).count();
    if u != 3 { return 1; }
    let mut isum = 0;
    for x in a.intersection(&b) { isum += *x; }
    if isum != 2 { return 2; }
    let mut d = 0;
    for x in a.difference(&b) { d += *x; }
    if d != 1 { return 3; }
    if a.symmetric_difference(&b).count() != 2 { return 4; }
    if a.is_subset(&b) || a.is_disjoint(&b) { return 5; }
    let mut total = 0;
    for x in a { total += x; }
    if total != 3 { return 6; }
    let mut ss: HashSet<String> = HashSet::new();
    unsafe { let p: *mut HashSet<String> = &mut ss; p.insert(String::from("x")); p.insert(String::from("yy")); }
    let mut l: i64 = 0;
    for s in ss { l += s.len(); }
    if l != 3 { return 7; }
    return 0;
}
