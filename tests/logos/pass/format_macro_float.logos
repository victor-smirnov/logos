// Float Display / LowerExp / UpperExp through stdlib/rt/fmt_native.c, in
// Rust's forms: Display is the shortest round-trip decimal, `{:e}` / `{:E}`
// the same digits as `d[.ddd]e<exp>` (rustc prints the same).
package format_macro_float;

use logos.std.fmt;
use logos.mem.string;
use logos.lang.str;

fn main() -> i32 {
    let a: String = format!("{}", 3.14f64);             // "3.14"
    let b: String = format!("{}", 1.5f32);              // "1.5"
    let c: String = format!("{:e}", 123456.789f64);     // "1.23456789e5"
    let d: String = format!("{:E}", 0.001f64);          // "1E-3"
    println!("[{}][{}][{}][{}]", a.as_str(), b.as_str(),
             c.as_str(), d.as_str());
    return (a.len() + b.len() + c.len() + d.len()) as i32;
}
