// Test: bindings inside @{...} / @[...] patterns.

package writ_match_bind;

use logos.lang.writ.pat;
use logos.lang.writ.hstatic;

unsafe fn classify(d: &WritStatic) -> i32 {
    match d {
        @[@1, x, @3] => if x.is_int() { x.as_i24() } else { -1 },
        @{"k": v}    => if v.is_int() { v.as_i24() + 100 } else { -2 },
        _            => 0,
    }
}

unsafe fn nested(d: &WritStatic) -> i32 {
    match d {
        @{"data": @[a, b]} => {
            if a.is_int() && b.is_int() {
                return a.as_i24() * 10 + b.as_i24();
            }
            return -1;
        }
        _ => return 0,
    }
    return 0;
}

unsafe fn main() -> i32 {
    let a: WritStatic = @[1, 2, 3];
    let b: WritStatic = @[1, 42, 3];
    let c: WritStatic = @{"k": 7};
    let d: WritStatic = @42;
    // classify: 2 + 42 + 107 + 0 = 151
    let r1: i32 = classify(&a) + classify(&b) + classify(&c) + classify(&d);
    let e: WritStatic = @{"data": [4, 9]};
    // nested: 4*10+9 = 49
    let r2: i32 = nested(&e);
    // 151 + 49 = 200
    return r1 + r2;
}
