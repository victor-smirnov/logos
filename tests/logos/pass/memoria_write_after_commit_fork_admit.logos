// ADR 0039 law 1 (row M2g), the admitted twin of
// memoria_write_after_commit_abort: the change goes into a FORK of the
// committed snapshot, and the committed version still answers as it did.
package test;

use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;
use logos.mem.pkd;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.sync;
use logos.lang.str;
use logos.mem.string;
use logos.mem.fmt;
use logos.std.io;

container Ledger {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure max(key);
}

fn main() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();
    let s1: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    let mut l = create_ctr::<typeof(Ledger)>(&s1, 1u64);
    l.insert(1u64, 10u64);
    s1.commit();
    let s2: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    let mut l2 = open_ctr::<typeof(Ledger)>(&s2, 1u64);
    l2.insert(1u64, 99u64);
    let l1 = open_ctr::<typeof(Ledger)>(&s1, 1u64);
    let fork_val: u64 = l2.get_or(1u64, 0u64);
    let committed_val: u64 = l1.get_or(1u64, 0u64);
    let mut m: String = String::new();
    m.push_str("fork "); m.push_str(fork_val.to_string().as_str());
    m.push_str(" committed "); m.push_str(committed_val.to_string().as_str());
    println_string(&m);
    return 0i32;
}
