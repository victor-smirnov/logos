// Test: struct with lifetime parameter
// struct Foo<'a, T> can be declared, instantiated, and used.
package struct_lifetime_param;

struct View<'z> {
    pub ptr: *const u8,
    pub len: u32,
}

fn make_view<'z>(data: &'z u8, len: u32) -> View<'z> {
    return View { ptr: data as *const u8, len: len };
}

unsafe fn main() -> i32 {
    let x: u8 = 42 as u8;
    let v: View = make_view(&x, 1 as u32);
    if v.len != 1 as u32 { return 1; }
    return 0;
}
