// Destructuring assignment in every shape the grammar takes (ADR 0030 HIR pass):
// nested tuples with `_` and `..`, arrays, structs (named and shorthand fields),
// `(x) = e` as a plain assignment, and a swap.
package destructuring_assign_shapes;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let mut a: i64 = 0; let mut b: i64 = 0; let mut c: i64 = 0;
    (a, (b, _), ..) = (1, (2, 3), 4, 5);
    if a != 1 || b != 2 { return 1; }
    [a, b] = [7, 8];
    if a != 7 || b != 8 { return 2; }
    let mut y: i64 = 0;
    P { x: c, y } = P { x: 10, y: 20 };
    if c != 10 || y != 20 { return 3; }
    (a) = 5;
    if a != 5 { return 4; }
    (a, b) = (b, a);
    if a != 8 || b != 5 { return 5; }
    return 42;
}
