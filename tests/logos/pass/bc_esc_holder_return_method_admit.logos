// #86 SUB-SITE C — ADMIT half of the bound spelling. ONE VARIABLE against
// fail/bc_esc_holder_return_method_dangle: the field's borrow is rooted at a
// PARAMETER. `ok_ref` adds the receiver-by-reference spelling of the same
// extraction, where the holder is not a local at all.
//
// A non-borrow result off a carrier local (`n`) is here for the other
// direction: the gate must not fire on a method whose result carries no borrow
// merely because the RECEIVER does.
package bc_esc_holder_return_method_admit;
use logos.mem.string;

// ⚠ THE REGION IS NAMED, AND THAT IS THE SHAPE. With `struct W { v: str }` and
// `fn get(&self) -> str` the result's region is ELIDED, so Rust's elision rule 3
// gives it `&self`'s — and `ok`, whose holder is a LOCAL, is then error[E0515]
// (rustc 1.98.1, MEASURED 2026-09-21). To mean "the FIELD's region" one must SAY
// it, as this stdlib's own `VecIter<'a, T>` does. Decision 2026-09-21 (Victor):
// Logos follows Rust here; there is no elision divergence, and the header of the
// dangle sibling that called the field-region reading "Rust parity" was wrong.
pub struct W<'a> { pub v: &'a str }

impl<'a> W<'a> {
    pub fn get(self: &W<'a>) -> &'a str { return self.v; }
    pub fn n(self: &W<'a>) -> i64 { return 7i64; }
}

pub fn ok<'a>(s: &'a str) -> &'a str {
    let w: W<'a> = W { v: s };
    return w.get();
}

pub fn ok_ref<'a>(w: &W<'a>) -> &'a str { return w.get(); }

pub fn ok_scalar() -> i64 {
    let o: String = String::from("hello");
    let w: W = W { v: o.as_str() };
    return w.n();
}

fn main() -> i32 {
    let o: String = String::from("hello");
    if ok(o.as_str()).len() != 5i64 { return 1i32; }
    let w: W = W { v: "abcde" };
    if ok_ref(&w).len() != 5i64 { return 2i32; }
    if ok_scalar() != 7i64 { return 3i32; }
    return 0i32;
}
