// Smoke test for logos.lcm.deem.data — rebuild of the persistent
// store on dyn-trait dispatch. Verifies that the package's primitives
// (NodeBase header, NodeARC handle, BranchNode/LeafNode/LeafDirNode
// concrete types) compose into a working rc'd tree with recursive
// release through the auto-Drop chain.
//
// Tree under test:
//
//     Branch
//     ├── Leaf(data, vals=[10u64, 20u64])
//     └── Leaf(data, vals=[30u64])
//
// Plus a separate LeafDirNode that stores NodeARCs (= directory leaf):
//
//     LeafDir
//     ├── leaf_a (rc shared with the data tree)
//     └── leaf_b
//
// Drop counters via *mut u64 (drop_count fields on the concrete impls)
// let us assert the full release chain fired correctly.

package zz_v3_smoke;

use logos.mem.collections.vec;
use logos.lang.mem;
use logos.lang.cmp; use logos.lang.cmp; use logos.lang.fabric;
use logos.lang.drop;
use logos.lang.option;
use logos.lang.writ.wstatic;

use logos.lcm.deem.data.bt.node;
use logos.lcm.deem.data.bt.cow;

pub const StoreCfg: WritStatic = @{
    "name":     "smoke",
    "ctr_id":   <type:u64>,
    "snp_id":   <type:u64>,
    "block_id": <type:u64>,
};

pub const DataCfg: WritStatic = @{
    "key":    <type:u64>,
    "value":  <type:u64>,
    "fanout": 8,
};

pub const DirCfg: WritStatic = @{
    "key":    <type:u64>,
    "fanout": 16,
};

fn main() -> i32 {
    // ── Stage 1 — single data leaf, NodeARC, drop ─────────────────────
    {
        let arc = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(101u64, 1u64)
        };
        unsafe {
            let lp = node_arc_data_ptr::<StoreCfg>(&arc)
                as *mut LeafNode<u64, u64, StoreCfg, DataCfg>;
            lp.keys.push(10u64);
            lp.vals.push(100u64);
        }
        let _ = arc;
        // arc drops at scope exit → strong 1→0 → vtable[0] drop_in_place fires
        // → keys/vals Buffer auto-drops → dealloc. No way to assert from outside
        // without a counter, but no leak/segfault = win (valgrind-checked).
    }

    // ── Stage 2 — branch holding two data leaves ──────────────────────
    {
        let arcA = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(201u64, 1u64)
        };
        let arcB = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(202u64, 1u64)
        };
        unsafe {
            let la = node_arc_data_ptr::<StoreCfg>(&arcA)
                as *mut LeafNode<u64, u64, StoreCfg, DataCfg>;
            let lb = node_arc_data_ptr::<StoreCfg>(&arcB)
                as *mut LeafNode<u64, u64, StoreCfg, DataCfg>;
            la.keys.push(1u64);  la.vals.push(11u64);
            lb.keys.push(2u64);  lb.vals.push(22u64);
        }

        let root = unsafe {
            branch_alloc::<u64, StoreCfg, DataCfg>(301u64, 1u64)
        };
        unsafe {
            let bp = node_arc_data_ptr::<StoreCfg>(&root)
                as *mut BranchNode<u64, StoreCfg, DataCfg>;
            bp.children.push(arcA);
            bp.children.push(arcB);
        }
        let _ = root;
        // root drops → branch strong 1→0 → branch's auto-Drop chain:
        //   1. keys Buffer drops (no-op for u64 storage).
        //   2. children Vec drops → per-element NodeARC drops → leaves
        //      strong 1→0 → leaf auto-Drop chain → keys/vals Buffer drops.
        //   3. dealloc branch.
    }

    // ── Stage 3 — directory leaf holding container roots as NodeARCs ──
    {
        let arc_a = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(401u64, 2u64)
        };
        let arc_b = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(402u64, 2u64)
        };

        let dir_root = unsafe {
            leaf_dir_alloc::<u64, StoreCfg, DirCfg>(501u64, 2u64)
        };
        unsafe {
            let dirp = node_arc_data_ptr::<StoreCfg>(&dir_root)
                as *mut LeafDirNode<u64, StoreCfg, DirCfg>;
            dirp.keys.push(101u64);  dirp.vals.push(arc_a);
            dirp.keys.push(202u64);  dirp.vals.push(arc_b);
        }
        let _ = dir_root;
        // dir_root drops → LeafDirNode auto-Drop:
        //   keys Buffer drops, vals Vec<NodeARC> drops → per-element
        //   NodeARC drops → child leaves strong 1→0 → leaf auto-Drop → ...
    }

    // ── Stage 4 — cow_clone via vtable, both originals and clones drop cleanly ──
    {
        let arc = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(601u64, 5u64)
        };
        unsafe {
            let lp = node_arc_data_ptr::<StoreCfg>(&arc)
                as *mut LeafNode<u64, u64, StoreCfg, DataCfg>;
            lp.keys.push(7u64);
            lp.vals.push(700u64);
        }

        // Trigger cow_clone via vtable dispatch. Clone has fresh id+snap_id stamp.
        let cloned = unsafe { arc.deref().cow_clone(701u64, 9u64) };

        unsafe {
            // Original unchanged — original block keeps id=601, snap=5.
            // NodeBase layout (rc removed in the Arc migration): id @0, snap @8.
            let op = node_arc_data_ptr::<StoreCfg>(&arc);
            if *((op as i64 +  0i64) as *mut u64) != 601u64 { return 1; }
            if *((op as i64 +  8i64) as *mut u64) != 5u64   { return 2; }
            // Cloned has new stamp.
            let cp = node_arc_data_ptr::<StoreCfg>(&cloned);
            if *((cp as i64 +  0i64) as *mut u64) != 701u64 { return 3; }
            if *((cp as i64 +  8i64) as *mut u64) != 9u64   { return 4; }
        }
        // Both arcs drop at scope exit — independent allocations, no shared rc.
    }

    // ── Stage 5 — make_unique CoW skip rule (snapshot_id check) ───────
    {
        let mut arc = unsafe {
            leaf_alloc::<u64, u64, StoreCfg, DataCfg>(801u64, 7u64)
        };

        let mut next_id = 800u64;
        // Same snapshot — no clone, no id bump.
        unsafe { make_unique::<StoreCfg>(&mut arc, 7u64, &mut next_id as *mut u64); }
        if next_id != 800u64 { return 5; }
        unsafe {
            let dp = node_arc_data_ptr::<StoreCfg>(&arc);
            if *((dp as i64 + 0i64) as *mut u64) != 801u64 { return 6; }
        }

        // Different snapshot — clone fires, arc swaps to new node.
        unsafe { make_unique::<StoreCfg>(&mut arc, 9u64, &mut next_id as *mut u64); }
        if next_id != 801u64 { return 7; }
        unsafe {
            let dp = node_arc_data_ptr::<StoreCfg>(&arc);
            if *((dp as i64 + 0i64) as *mut u64) != 801u64 { return 8; }
            if *((dp as i64 + 8i64) as *mut u64) != 9u64   { return 9; }
        }
    }

    return 0;
}
