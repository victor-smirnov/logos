// The legal twin of match_ergo_ref_struct_shorthand_under_ref_fail, ONE TOKEN apart: the
// scrutinee is `p`, not `&p`. The default binding mode is `move`, so the written `ref`
// shorthand is legal and `x` binds `&i64` into the matched value. It RUNS.
package match_ergo_ref_struct_shorthand_byvalue_pass;
use logos.std.fmt;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let p: P = P { x: 3i64, y: 4i64 };
    let mut out: i64 = 0i64;
    match p {
        P { ref x, y } => { out = *x + y; }
    }
    println!("out={}", out);
    if out != 7i64 { return 1i32; }
    return 0i32;
}
