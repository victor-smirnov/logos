// ADR 0030 S10 row 1: a `for` head must implement Iterator (Rust E0277 "is not an iterator"); the
// struct's `next` was an inherent method found by name, over a local `enum Option`.
package for_in_iter_break;

extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }

struct Range { current: i32, end: i32, }

impl Iterator for Range {
    type Item = i32;
    fn next(&mut self) -> Option<i32> {
        if self.current >= self.end { return Option::None; }
        let v = self.current;
        self.current = self.current + 1;
        return Option::Some(v);
    }
}


unsafe fn main() -> i32 {
    // break: stop at first value >= 3  → sum = 0+1+2 = 3
    let mut r = Range { current: 0, end: 10 };
    let mut sum = 0;
    for x in r {
        if x >= 3 { break; }
        sum = sum + x;
    }
    printi("%d\n", sum);   // 3

    // continue: skip odd numbers → sum = 0+2+4 = 6
    let mut r2 = Range { current: 0, end: 5 };
    let mut sum2 = 0;
    for x in r2 {
        if x * 2 != (x / 1) * 2 { continue; }  // always false, just test continue path
        sum2 = sum2 + x;
    }
    printi("%d\n", sum2);  // 0+1+2+3+4 = 10 (continue never triggers)
    return 0;
}
