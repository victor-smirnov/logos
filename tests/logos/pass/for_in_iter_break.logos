package for_in_iter_break;

extern fn printf(fmt: *const u8, ...) -> i32;

enum Option<T> { None, Some(T), }

struct Range { current: i32; end: i32; }

impl Range {
    fn next(self: *mut Range) -> Option<i32> {
        if self.current >= self.end { return Option::None; }
        let v = self.current;
        self.current = self.current + 1;
        return Option::Some(v);
    }
}

fn main() -> i32 {
    // break: stop at first value >= 3  → sum = 0+1+2 = 3
    let mut r = Range { current: 0, end: 10 };
    let mut sum = 0;
    for x in r {
        if x >= 3 { break; }
        sum = sum + x;
    }
    printf("%d\n", sum);   // 3

    // continue: skip odd numbers → sum = 0+2+4 = 6
    let mut r2 = Range { current: 0, end: 5 };
    let mut sum2 = 0;
    for x in r2 {
        if x * 2 != (x / 1) * 2 { continue; }  // always false, just test continue path
        sum2 = sum2 + x;
    }
    printf("%d\n", sum2);  // 0+1+2+3+4 = 10 (continue never triggers)
    return 0;
}
