// `impl P<'_, '_>` has TWO distinct anonymous regions; copying each field to its own slot is legal.
// TWIN of fail/bc_selfregion_two_anon_refuse, two tokens (the fields swap) apart. src/compiler/PROBES.md 2026-09-13b-selfregion-land.
package bc_selfregion_two_anon_admit;
struct P<'a, 'b> { x: &'a i64, y: &'b i64 }
impl P<'_, '_> {
    fn same(&self) -> Self {
        return Self { x: self.x, y: self.y };
    }
}
fn main() -> i32 {
    let a: i64 = 20i64;
    let b: i64 = 28i64;
    let p = P { x: &a, y: &b };
    let q = p.same();
    return (*q.x + *q.y) as i32;
}
