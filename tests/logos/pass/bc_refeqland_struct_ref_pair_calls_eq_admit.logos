package bc_refeqland_struct_ref_pair_calls_eq_admit;
use logos.lang.cmp;

struct D { v: i64 }
impl Eq for D { fn eq(&self, other: &D) -> bool { return self.v == other.v; } }

fn main() -> i32 {
    let a: D = D { v: 4i64 };
    let b: D = D { v: 4i64 };
    let ra: &D = &a;
    let rb: &D = &b;
    if ra == rb {
        return 7i32;
    }
    return 1i32;
}
