// B-ts-01 regression: tuple-struct syntax `struct Foo(T1, T2);` with
// positional constructor `Foo(a, b)`, tuple-index member access
// (`foo.0`, `foo.1`), `let Foo(a, b) = …` destructure, and match
// arm pattern `Foo(a, b) => …`. Fields are synth-named "0", "1", …
// in sema's struct registry so the existing named-field machinery
// handles codegen / drop / move without a separate IR path.
package tuple_struct;

struct Pair(i32, i32);
struct Triple(i32, i32, i32);

fn sum(p: Pair) -> i32 {
    return p.0 + p.1;
}

fn sum_via_destructure(p: Pair) -> i32 {
    let Pair(a, b) = p;
    return a + b;
}

fn classify(t: Triple) -> i32 {
    match t {
        Triple(_a, _b, _c) => { return _a + _b + _c; }
    }
}

fn main() -> i32 {
    let p: Pair = Pair(3i32, 4i32);
    if p.0 != 3i32 { return 1; }
    if p.1 != 4i32 { return 2; }

    let q: Pair = Pair(3i32, 4i32);
    if sum(q) != 7i32 { return 3; }

    let r: Pair = Pair(3i32, 4i32);
    if sum_via_destructure(r) != 7i32 { return 4; }

    let t: Triple = Triple(10i32, 20i32, 30i32);
    if classify(t) != 60i32 { return 5; }

    let u: Triple = Triple(10i32, 20i32, 30i32);
    if u.0 != 10i32 { return 6; }
    if u.1 != 20i32 { return 7; }
    if u.2 != 30i32 { return 8; }

    return 0;
}
