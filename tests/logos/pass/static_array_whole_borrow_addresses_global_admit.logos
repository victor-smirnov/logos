package static_array_whole_borrow_reads_garbage;
static ARR: [i64; 3] = [5i64, 2i64, 7i64];
fn third(s: &[i64; 3]) -> i64 {
    return s[2];
}
fn main() -> i32 {
    let s = &ARR;
    if s[0] != 5i64 { return 1i32; }
    if third(&ARR) != 7i64 { return 2i32; }
    return 0i32;
}
