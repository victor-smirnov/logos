// The where subject is the declared parameter `U`; `f::<i64>` runs. (Two tokens apart: the phantom parameter needs its argument.)
// TWIN of fail/bc_declarrival_where_undecl_second_param_refuse, one token apart. src/compiler/PROBES.md 2026-09-13f-declarrivalland.
package bc_declarrival_where_undecl_second_param_admit;
trait Tr {
    fn t(self: &Self) -> i64;
}
impl Tr for i64 {
    fn t(self: &Self) -> i64 { return *self; }
}
fn f<U: Tr>(u: &U) -> i64
where U: Tr
{
    return u.t();
}
fn main() -> i32 {
    let a = 3i64;
    return f::<i64>(&a) as i32;
}
