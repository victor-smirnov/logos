// Was SOUNDNESS QUEUE row if_let_scrutinee_temporary_dropped_after_else (#701, closed by 0de42e796): an if-let's scrutinee temporary drops before else.
package if_let_scrutinee_temporary_dropped_after_else;
struct D { id: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10 + self.id; } } }
fn mk(id: i64, c: *mut i64) -> Option<D> { return Some(D { id: id, c: c }); }
fn main() -> i32 {
    let mut seq: i64 = 0i64;
    let p: *mut i64 = &mut seq;
    if let None = mk(1i64, p) { unsafe { *p = *p * 10 + 7; } } else { unsafe { *p = *p * 10 + 2; } }
    if unsafe { seq } != 12i64 { return 1i32; }
    return 0i32;
}
