// `for (d, k) in &ts` binds `d: &D`: the tuple is not copied out and each D drops once, at the array's end (rustc 1.98.1: 1500 34).
package for_header_ref_tuple_drop;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64; let c: *mut i64 = &mut n;
    let mut acc: i64 = 0i64;
    {
        let ts = [(D { v: 3i64, c: c }, 7i64), (D { v: 4i64, c: c }, 1i64)];
        for (d, k) in &ts { acc = acc + d.v + *k; }
        acc = acc * 100i64 + unsafe { *c };
    }
    unsafe { printf("%lld %lld\n".as_ptr(), acc, n); }
    return 0i32;
}
