// WQL — THE CENSUS IS A STATE, AND A PROGRAM CAN READ IT (ADR 0024 S4o).
//
// Three consecutive rounds of the join-order axis shipped green and were then found
// to carry a FALSE justification, always the same way: a ground was a SENTENCE
// composed at the moment of deciding, the mechanism moved, the sentence stayed. The
// last of them was measured on the wql/deem corpus and is what this fixture exists
// for:
//
//   59 of 259 plans said "the order axis was never entered" one clause after their
//   own ground had said an anti join, a traversal or the absence of `order by` had
//   REFUSED them. The suffix was keyed on `nperm == 0`, which is true of a query
//   with no join AND of a chain the axis entered and refused before enumerating
//   anything. A count that means two things is not a fact.
//
// So the plan carries the justification as VALUES, and the three states are three
// numbers a program can compare:
//
//   `axis()`     0 no order axis at all · 1 entered and refused BEFORE enumeration ·
//                2 the derivation ran. A FIELD the decision writes.
//
//                ⚠⚠ FOR ONE ROUND IT WAS DERIVED FROM THE GROUND CODE'S RANGE, and
//                that was the SAME DEFECT one level in — the cure carrying the
//                disease. It could not contradict the ground; it contradicted the
//                QUERY. `WG_AGG` (6) sits in the 0–9 "no axis" band, so
//                `wql_join_group_e2e::region_totals` — whose own trace line one row
//                above reads `[plan] d -> hash join on i64` — announced "this query
//                has no join whose order a plan could choose". Nine corpus plans,
//                two of them carrying an `order by`; a `where 1 > 2` over a join
//                reached the same sentence on `WG_FALSE_FILTER`. A range couples two
//                independent decisions — WHAT the ground is, WHICH state it was
//                reached in — into one number, and the second moves silently when the
//                first is extended. `agg_scan`/`agg_join` below are the pair that
//                holds it: ONE GROUND, TWO STATES, which is exactly what no function
//                of the code can produce.
//   `ground()`   WHICH ANTECEDENT FAILED (`why::WG_*`).
//   `operand()`  the value it failed on, where the antecedent has one that is not a
//                count (the `order by` key's type, the source that could not be
//                measured).
//   `refused(c)` how many permutations each `why::RJ_*` constraint turned down —
//                the conjunction the conclusion rests on, not its first term.
//
// ⚠ EVERY CONSTANT IS PINNED AGAINST THE FUNCTION THAT DEFINES IT, IN ONE RUN. The
// emitter splices literals into the plan's methods; this fixture compares them to
// `why::AX_*` / `why::WG_*` themselves, so the emitted number and the named code
// cannot drift apart without a test going red. That is the same discipline
// `wql_plan_no_table_e2e` applies to `jc_none_*`, and it is the reason the gates may
// assert the record with plain integers.
//
// ⚠ THE DECISIVE PAIR IS `anti_sorted` VS `scan`. Both carry no candidate table,
// both report `enumerated()` 0, `proved()` 0, `considered()` 0 — every count they
// have is identical. `axis()` is the only thing that tells them apart, and before it
// existed the compiler said the same false sentence about both.
//
// The other half of the property — that `explain()` and the `[plan]` trace are ONE
// TEXT from ONE renderer — is asserted by `prepared_plan_gate.sh`, which is the only
// side that can read both channels.
package test;

use logos.std.wql.wql;
use logos.std.wql.why;         // the vocabulary itself — both sides of every pin
use logos.mem.collections.vec;
use logos.lang.option;
use logos.lang.str;            // str_contains — the rendered prose is asserted too

struct A { pub k: i64, pub v: i64 }
struct B { pub k: i64, pub m: i64 }
struct W { pub k: i64 }

// ── STATE 0: NO ORDER AXIS AT ALL ────────────────────────────────────────────
// One source. There is no join whose order a plan could choose, so nothing is
// permuted and `decide_join_orders` is never reached.
pub deem scan(as_: &[A]) {
    from as_ a where a.v > 0 select a.k }

// ── STATE 1: THE AXIS WAS ENTERED AND REFUSED BEFORE ENUMERATION ─────────────
// An anti join on the FIRST step, with an `order by` so that the refusal is the
// anti's asymmetry and nothing else: `order by` is present, the key is `i64` and
// therefore order-faithful, so C1 holds and the antecedent that fails is the one
// this plan names. The derivation never runs — the counts are the same three zeros
// `scan` reports.
pub deem anti_sorted(as_: &[A], ws: &[W]) {
    from as_ a
    anti join ws w on a.k == w.k
    select a.v order by a.k }

// ── STATE 1, A DIFFERENT ANTECEDENT: no sequence is named ────────────────────
// A classic join with no `order by`. Same state, different ground — which is what
// makes `ground()` worth reading beside `axis()`.
pub deem unsorted(as_: &[A], bs: &[B]) {
    from as_ a
    join bs b on a.k == b.k
    select a.v * 100 + b.m }

// ── ONE GROUND, TWO STATES ───────────────────────────────────────────────────
// THE PAIR THAT REFUTES ANY FUNCTION FROM THE GROUND CODE TO THE CENSUS STATE. Both
// record `why::WG_AGG` — an aggregate's output order is its groups' first-occurrence
// order, which no sort restores, so there is nothing for a measurement to choose
// between — and that is the whole justification in both cases. But `agg_scan` has ONE
// source and `agg_join` has a join whose order a plan could in principle have chosen:
// the first has no order axis, the second has one and this ground is what refused it.
//
// ⚠ NEITHER IS A JOIN-ORDER DECISION: `emit_aggregate` never calls
// `decide_join_orders`, so nothing downstream can supply the state. The emitter holds
// the linearized chain and is the only thing that knows.
pub deem agg_scan(as_: &[A]) {
    from as_ a
    group by a.k
    aggregate tot = sum(a.v)
    select key * 1000i64 + tot }

pub deem agg_join(as_: &[A], bs: &[B]) {
    from as_ a
    join bs b on a.k == b.k
    group by a.k
    aggregate tot = sum(b.m)
    select key * 1000i64 + tot }

// ── STATE 2: THE DERIVATION RAN ──────────────────────────────────────────────
// Two floatable sources, `order by` on an i64 key: two permutations, both
// admissible, both carried.
pub deem sorted(as_: &[A], bs: &[B]) {
    from as_ a
    join bs b on a.k == b.k
    select a.v * 100 + b.m order by a.k }

fn main() -> i32 {
    let as_: [A; 3] = [ A { k: 1i64, v: 10i64 }, A { k: 2i64, v: 20i64 },
                        A { k: 3i64, v: 30i64 } ];
    let bs: [B; 2] = [ B { k: 1i64, m: 7i64 }, B { k: 3i64, m: 9i64 } ];
    let ws: [W; 1] = [ W { k: 2i64 } ];

    let ps: ScanPlan       = scan_prepare(&as_[..]);
    let pa: AntiSortedPlan = anti_sorted_prepare(&as_[..], &ws[..]);
    let pu: UnsortedPlan   = unsorted_prepare(&as_[..], &bs[..]);
    let pj: SortedPlan     = sorted_prepare(&as_[..], &bs[..]);
    let pgs: AggScanPlan   = agg_scan_prepare(&as_[..]);
    let pgj: AggJoinPlan   = agg_join_prepare(&as_[..], &bs[..]);

    // ── 1. THE THREE STATES, AS THREE DISTINCT VALUES ─────────────────────
    if ps.axis() != AX_NONE()     { return 1i32; }
    if pa.axis() != AX_REFUSED()  { return 2i32; }
    if pu.axis() != AX_REFUSED()  { return 3i32; }
    if pj.axis() != AX_SEARCHED() { return 4i32; }

    // …and they are three DIFFERENT values. A partition that collapsed would be the
    // defect back, and comparing to named codes alone would not catch two codes
    // defined equal.
    if ps.axis() == pa.axis()     { return 5i32; }
    if pa.axis() == pj.axis()     { return 6i32; }
    if ps.axis() == pj.axis()     { return 7i32; }

    // ── 2. THE DECISIVE PAIR: EVERY COUNT IS EQUAL, THE STATE IS NOT ──────
    // This is the measurement the whole slice rests on. `scan` and `anti_sorted`
    // are indistinguishable by any number the plan carried before `axis()`, and one
    // of them HAS an order axis that refused it.
    if ps.enumerated() != 0i64 { return 10i32; }
    if pa.enumerated() != 0i64 { return 11i32; }
    if ps.proved()     != 0i64 { return 12i32; }
    if pa.proved()     != 0i64 { return 13i32; }
    if ps.considered() != 0i64 { return 14i32; }
    if pa.considered() != 0i64 { return 15i32; }
    if ps.enumerated() != pa.enumerated() { return 16i32; }
    if ps.proved()     != pa.proved()     { return 17i32; }
    if ps.considered() != pa.considered() { return 18i32; }
    if ps.axis()       == pa.axis()       { return 19i32; }

    // ── 3. THE GROUND NAMES WHICH ANTECEDENT FAILED ───────────────────────
    if ps.ground() != WG_SCAN()       { return 20i32; }
    if pa.ground() != WG_ANTI_FIRST() { return 21i32; }
    if pu.ground() != WG_NO_SORT()    { return 22i32; }
    if pj.ground() != WG_ADMITTED()   { return 23i32; }
    // Two plans in the SAME state with DIFFERENT grounds — the state is not the
    // whole justification and the ground is not the state.
    if pa.axis() != pu.axis()       { return 24i32; }
    if pa.ground() == pu.ground()   { return 25i32; }
    // ⚠⚠ AND THE STATE IS *NOT* A FUNCTION OF THE GROUND. This block used to assert
    // that it was — `why_axis_of(p.ground()) == p.axis()` for all four plans above —
    // and the assertion held for all four while being false of the language: it was
    // written from the four shapes in front of the author, and the function it pinned
    // was the very coupling that then told nine joined queries they had no join.
    // `why_axis_of` is deleted; what replaces the block is its REFUTATION.
    //
    // ONE GROUND, TWO STATES, read off two plans in one run:
    if pgs.ground() != WG_AGG() { return 26i32; }
    if pgj.ground() != WG_AGG() { return 27i32; }
    if pgs.ground() != pgj.ground() { return 28i32; }
    // …and the states differ, which no function of that one shared code could give.
    if pgs.axis() != AX_NONE()    { return 29i32; }
    if pgj.axis() != AX_REFUSED() { return 36i32; }
    if pgs.axis() == pgj.axis()   { return 37i32; }
    // Every count they carry is identical too — the same trap `scan` vs `anti_sorted`
    // sets one level up, now sprung by two plans that also share a ground.
    if pgs.enumerated() != pgj.enumerated() { return 38i32; }
    if pgs.proved()     != pgj.proved()     { return 39i32; }
    if pgs.considered() != pgj.considered() { return 43i32; }
    // THE SENTENCE A PERSON READS FOLLOWS THE FIELD, not the code: the joined
    // aggregate must NOT be told it has no join.
    if !str_contains(pgj.explain(), "an aggregate's output order") { return 44i32; }
    if !str_contains(pgs.explain(), "an aggregate's output order") { return 45i32; }
    if str_contains(pgj.explain(), "no join whose order a plan could choose") { return 46i32; }
    if !str_contains(pgs.explain(), "no join whose order a plan could choose") { return 47i32; }
    if !str_contains(pgj.explain(), "ORDER AXIS ENTERED AND REFUSED BEFORE ENUMERATION") { return 48i32; }

    // ── 4. THE SEARCHED PLAN'S CENSUS IS A TRIPLE THAT AGREES WITH ITSELF ─
    if pj.enumerated() != 2i64 { return 30i32; }
    if pj.proved()     != 2i64 { return 31i32; }
    if pj.considered() != 2i64 { return 32i32; }
    // Nothing was refused, so every refusal count is 0 — and asking outside the code
    // space is "never asked for" (-1), not "no refusals".
    let mut rc: i32 = 0i32;
    while rc < 8i32 {
        if pj.refused(rc) != 0i64 { return 33i32; }
        rc = rc + 1i32;
    }
    if pj.refused(8i32) != -1i64 { return 34i32; }
    if pj.refused(-1i32) != -1i64 { return 35i32; }

    // ── 5. THE OPERAND ────────────────────────────────────────────────────
    // None of these grounds has a non-count operand: an anti join's asymmetry is a
    // property of the step, not of a value. Empty is the answer, and it is an answer
    // rather than a hole — `wql_join_order_key_fidelity_e2e` holds the case where a
    // key type IS the operand.
    if ps.operand().len() != 0i64 { return 40i32; }
    if pa.operand().len() != 0i64 { return 41i32; }
    if pj.operand().len() != 0i64 { return 42i32; }

    // ── 6. THE PROSE IS RENDERED FROM THE RECORD, AND SAYS THE SAME THING ─
    // A human reads `explain()`; the point of the record is that the sentence cannot
    // contradict the numbers, because it is selected by them.
    if !str_contains(ps.explain(), "ORDER AXIS NOT ENTERED") { return 50i32; }
    if str_contains(ps.explain(), "REFUSED BEFORE ENUMERATION") { return 51i32; }
    if !str_contains(pa.explain(), "ORDER AXIS ENTERED AND REFUSED BEFORE ENUMERATION") { return 52i32; }
    if str_contains(pa.explain(), "NOT ENTERED") { return 53i32; }
    if !str_contains(pa.explain(), "an anti join is not symmetric") { return 54i32; }
    if !str_contains(pj.explain(), "ORDER AXIS SEARCHED") { return 55i32; }

    // ⚠ AND THE REMEDY IS DERIVED FROM THE ANTECEDENT THAT FAILED, not written for
    // the query in front of the author. `unsorted` is refused for want of a named
    // sequence, so its remedy is to name one; `anti_sorted` is refused by an
    // asymmetry the query ASKED for, so its remedy says there is no repair on this
    // axis and names what a different query would look like. A previous round shipped
    // a remedy advising a declaration on a source that has nowhere to declare it —
    // the whole reason the repair now comes from the same code as the refusal.
    if !str_contains(pu.explain(), "add an `order by`") { return 56i32; }
    if !str_contains(pa.explain(), "there is no repair on this axis") { return 57i32; }
    if str_contains(pa.explain(), "add an `order by`") { return 58i32; }
    // The remedy of a state-0 plan is silence: its own ground already says there is
    // nothing for a measurement to decide, so advice would be advice to write a
    // different query.
    if str_contains(ps.explain(), "THE REMEDY") { return 59i32; }

    // ── 7. AND THE ROWS ARE THE ROWS ──────────────────────────────────────
    // Every claim above is about a justification; none of it is worth anything if
    // the plan it justifies answers differently from the query.
    let r1: Vec<i64> = scan_run(&ps, &as_[..]).unwrap();
    let r1d: Vec<i64> = scan(&as_[..]).unwrap();
    if r1.len() != 3i64 { return 60i32; }
    if r1.len() != r1d.len() { return 61i32; }

    let r2: Vec<i64> = anti_sorted_run(&pa, &as_[..], &ws[..]).unwrap();
    if r2.len() != 2i64 { return 62i32; }
    if r2.get(0i64) != 10i64 { return 63i32; }
    if r2.get(1i64) != 30i64 { return 64i32; }

    let r3: Vec<i64> = unsorted_run(&pu, &as_[..], &bs[..]).unwrap();
    if r3.len() != 2i64 { return 65i32; }

    let r4: Vec<i64> = sorted_run(&pj, &as_[..], &bs[..]).unwrap();
    let r4d: Vec<i64> = sorted(&as_[..], &bs[..]).unwrap();
    if r4.len() != 2i64 { return 66i32; }
    if r4.get(0i64) != 1007i64 { return 67i32; }
    if r4.get(1i64) != 3009i64 { return 68i32; }
    if r4d.len() != r4.len() { return 69i32; }
    if r4d.get(0i64) != r4.get(0i64) { return 70i32; }
    if r4d.get(1i64) != r4.get(1i64) { return 71i32; }

    // The two new plans answer, and answer the same as their direct fns.
    let g1: Vec<i64> = agg_scan_run(&pgs, &as_[..]).unwrap();
    let g1d: Vec<i64> = agg_scan(&as_[..]).unwrap();
    if g1.len() != 3i64 { return 72i32; }
    if g1.len() != g1d.len() { return 73i32; }
    if g1.get(0i64) != g1d.get(0i64) { return 74i32; }

    let g2: Vec<i64> = agg_join_run(&pgj, &as_[..], &bs[..]).unwrap();
    let g2d: Vec<i64> = agg_join(&as_[..], &bs[..]).unwrap();
    if g2.len() != 2i64 { return 75i32; }
    if g2.len() != g2d.len() { return 76i32; }
    if g2.get(0i64) != g2d.get(0i64) { return 77i32; }
    if g2.get(1i64) != g2d.get(1i64) { return 78i32; }

    return 0i32;
}
