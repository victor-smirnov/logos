// Adversarial #1 (C): Rust capture-drop semantics for move closures.
// RFC 2229 drop-order rule: a path capture whose ROOT type impls Drop
// captures the WHOLE variable; the captures drop WITH the closure binding
// (at its drop slot, in capture order) — rustc prints "s3 d1 d2 ".
package adv1_capture_drop_order;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
trait Drop { fn drop(self: Self); }
struct R { id: i32 }
impl Drop for R { fn drop(self: R) { printi("d%d ", self.id); } }
unsafe fn main() -> i32 {
    let a = R { id: 1i32 };
    let b = R { id: 2i32 };
    let cl = move || -> i32 { return a.id + b.id; };
    let s = cl();
    printi("s%d ", s);
    return 0i32;
}
