// Test: Writ string pattern — @"str" matches WritString root.

package writ_match_str;

use logos.lang.writ.anyval;
use logos.lang.writ.pat;   // writ_pat_eq_str — `@"str"` pattern helper
use logos.lang.writ.container;
use logos.lang.writ.wstring;
use logos.lang.rc;

unsafe fn mk_str(s: str) -> Rc<Writ> {
    let rc: Rc<Writ> = writ_rc(1024);
    let h: &Writ = rc.deref();
    let hs: &WString = h.wstring(s);
    h.set_root(WAny::from(hs));
    return rc;
}

unsafe fn mk_i(i: i32) -> Rc<Writ> {
    let rc: Rc<Writ> = writ_rc(1024);
    let h: &Writ = rc.deref();
    h.set_root(WAny::from(i as i56));
    return rc;
}

unsafe fn classify(d: &Rc<Writ>) -> i32 {
    match d {
        @"hello" => 1,
        @"world" => 2,
        @42      => 3,
        _        => 0,
    }
}

unsafe fn main() -> i32 {
    let a: Rc<Writ> = mk_str("hello");
    let b: Rc<Writ> = mk_str("world");
    let c: Rc<Writ> = mk_i(42);
    let d: Rc<Writ> = mk_str("other");
    // 1+2+3+0 = 6
    return classify(&a) + classify(&b) + classify(&c) + classify(&d);
}
