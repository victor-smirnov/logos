// WHICH QUERIES GAIN THE INCREMENTAL FORM — THE POPULATION, DERIVED.
//
// The incremental handle is emitted UNCONDITIONALLY-WHEN-ELIGIBLE: nothing in
// the surface asks for it (the `deem` item head has no attribute slot and the
// query DSL has no modifier slot, so every opt-in spelling would be a grammar
// change), and eligibility is DERIVED from the plan. A derived population is
// only trustworthy if it is observable, so `incr_eligible` traces every decision
// with its GROUND on `LOGOS_TRACE_PLAN`, and `incr_eligibility_gate.sh` reads
// this file's compile and asserts the verdict for every query below.
//
// ⚠ THIS FILE IS HALF OF THAT ASSERTION AND THE GATE IS THE OTHER HALF. What it
// pins ON ITS OWN is the positive direction — `ok_basic` is eligible, so its
// three derived fns EXIST and answer, and a change that stopped emitting them
// makes this file fail to COMPILE. What it cannot pin on its own is the negative
// direction: a query whose handle is absent is a query with nothing to call, and
// a test cannot name a function that is not there. That is what the trace is
// for, and why the gate exists rather than six more `fail/` fixtures.
//
// ⚠ EVERY QUERY HERE MUST COMPILE, INCLUDING THE INELIGIBLE ONES. Declining the
// incremental form is not a refusal of the query — the batch fn is emitted
// exactly as before — and if declining ever became a hard error this file would
// go red rather than the corpus going quiet.
//
// ⚠ A SECOND AXIS RUNS OVER THE SAME QUERIES, AND IT IS NOT THE SAME
// POPULATION. `incremental` says whether a query gets a HANDLE; `retraction`
// says whether that handle may be run BACKWARDS, and it is asked only of a query
// that already has one. A query can be on the first list and off the second —
// `no_retract_avg` below is exactly that — and the gate asserts both lists with
// both counts, because a second derived population read off one count is a
// population nobody wrote down twice.
//
// exit 0 = the eligible query's handle exists, agrees with its batch fn and
// retracts; the retract-declined query still has its handle; and every
// ineligible query still compiles and still answers.
package test;

use logos.std.wql.wql;
use logos.std.wql.el;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

struct S { pub g: i64, pub v: i64, pub nm: str }
struct T { pub g: i64, pub w: i64 }
// `U` is `S` WITHOUT the `str` field and `V` is a third relation for the
// two-step chain. They exist so that the join refusals below can be told apart:
// with only `S` in the file, "declined because it joins" and "declined because
// its row carries a `str`" produce the same verdict and nothing separates them.
struct U { pub g: i64, pub v: i64 }
struct V { pub g: i64, pub z: i64 }

// ── ELIGIBLE — the control, and the only one with derived fns to call ───────
pub deem ok_basic(ss: &[S]) {
    from ss s group by s.g aggregate t = sum(s.v) select (key, t)
}

// ── ELIGIBLE FOR THE HANDLE, DECLINED FOR RETRACTION ───────────────────────
// A SECOND population, derived on its own axis. `avg` accumulates an f64
// numerator for EVERY admitted argument class, so running it backwards rests on
// (S+x)−x == S, which f64 does not give — an OPEN fork reserved to Victor, and
// emitting `<q>_retract` here would take it silently. What this file pins on
// its own is that the refusal is NARROW: `_incremental` / `_epoch` / `_snapshot`
// still exist and still answer. That `_retract` does NOT exist is exactly what a
// fixture cannot say (there is no name to write), so the gate reads the traced
// decision instead — the same split the file's header states for the axis above.
//
// ⚠ AND `min`/`max` IS *NOT* IN THIS CATEGORY, which is why the example here is
// an `avg` and not a `min`. A `min`/`max` handle retracts by RESCANNING a
// value→multiplicity map: it computes no inverse, so the f64 fork does not
// reach it and it is admitted at every type.
pub deem no_retract_avg(ss: &[S]) {
    from ss s group by s.g aggregate a = avg(s.v) select (key, a)
}

// ── ELIGIBLE, AND IT IS A JOIN — P3 ────────────────────────────────────────
// ONE join step over two relations whose row types the handle can OWN (no `str`
// field — it would be a borrow of source bytes) and IDENTIFY (no `f64` field —
// `==` on a float is not identity, and the Z-set's normal form searches on it).
// `<q>_apply` is the WHOLE surface: `<q>_epoch` / `<q>_retract` forward at tag 0,
// which on a join would silently mean "the LEFT relation", so neither is emitted.
pub deem ok_join(uu: &[U], tt: &[T]) {
    from uu u join tt t on u.g == t.g group by u.g aggregate n = count(), w = sum(t.w) select (key, n, w)
}

// ── INELIGIBLE, one named shape each ───────────────────────────────────────
// A JOIN whose ROW TYPE carries a `str`. `S` has `nm: str`, so storing its rows
// on the handle would make the handle hold a view of bytes the caller may drop
// between epochs — which is exactly the capability the typed handle exists to
// have. The refusal is about the FIELD, not about the join.
pub deem no_join_strrow(ss: &[S], tt: &[T]) {
    from ss s join tt u on s.g == u.g group by s.g aggregate t = sum(u.w) select (key, t)
}
// TWO join steps. Rooting the nest at a step other than the base re-splits every
// equi-term's build/probe halves and re-places every floating predicate, which
// is `decide_join_orders`' derivation and `emit_aggregate` never runs it.
pub deem no_join2(uu: &[U], tt: &[T], vv: &[V]) {
    from uu u join tt t on u.g == t.g join vv v on t.g == v.g
    group by u.g aggregate w = sum(v.z) select (key, w)
}
// A JOIN that keeps the INSERT-ONLY surface. `avg` accumulates in f64, so
// `incr_retract_eligible` is false (decision D4) — and the source TAG a join
// delta must carry lives on `<q>_apply`, which only the retracting surface
// emits. Two independent axes; only their COMBINATION is unbuilt.
pub deem no_join_avg(uu: &[U], tt: &[T]) {
    from uu u join tt t on u.g == t.g group by u.g aggregate a = avg(t.w) select (key, a)
}
// A SELF-JOIN: one relation in two chain positions, so one tag would feed both.
pub deem no_join_self(uu: &[U]) {
    from uu u join uu v on u.g == v.g group by u.g aggregate n = count() select (key, n)
}
// A PRE-GROUP `where`: rows are filtered before the fold.
pub deem no_where(ss: &[S]) {
    from ss s where s.v > 0 group by s.g aggregate t = sum(s.v) select (key, t)
}
// `order by` acts on the SNAPSHOT rather than on the fold.
pub deem no_order(ss: &[S]) {
    from ss s group by s.g aggregate t = sum(s.v) select (key, t) order by key desc
}
// `limit`, same reason.
pub deem no_limit(ss: &[S]) {
    from ss s group by s.g aggregate t = sum(s.v) select (key, t) limit 1
}
// A `str` GROUP KEY: the handle would have to own the bytes, which is what the
// dynamic engine's Writ arena does and what a typed handle exists not to need.
pub deem no_strkey(ss: &[S]) {
    from ss s group by s.nm aggregate t = sum(s.v) select t
}
// `select` REACHES THE SOURCE ROW: its index means nothing across epochs.
pub deem no_rowsel(ss: &[S]) {
    from ss s group by s.g aggregate t = sum(s.v) select s.v
}

fn rows() -> Vec<S> {
    let mut v: Vec<S> = vec_new::<S>();
    v.push(S { g: 0i64, v:  5i64, nm: "a" });
    v.push(S { g: 1i64, v: -2i64, nm: "b" });
    v.push(S { g: 0i64, v:  7i64, nm: "a" });
    return v;
}
fn one_row(g: i64, v: i64) -> Vec<S> {
    let mut r: Vec<S> = vec_new::<S>();
    r.push(S { g: g, v: v, nm: "a" });
    return r;
}
fn trows() -> Vec<T> {
    let mut v: Vec<T> = vec_new::<T>();
    v.push(T { g: 0i64, w: 3i64 });
    v.push(T { g: 1i64, w: 4i64 });
    return v;
}
fn urows() -> Vec<U> {
    let mut v: Vec<U> = vec_new::<U>();
    v.push(U { g: 0i64, v:  5i64 });
    v.push(U { g: 1i64, v: -2i64 });
    v.push(U { g: 0i64, v:  7i64 });
    return v;
}
fn vrows() -> Vec<V> {
    let mut v: Vec<V> = vec_new::<V>();
    v.push(V { g: 0i64, z: 9i64 });
    return v;
}

fn main() -> i32 {
    let ss: Vec<S> = rows();
    let tt: Vec<T> = trows();
    let uu: Vec<U> = urows();
    let vv: Vec<V> = vrows();

    // ── the ELIGIBLE query: the handle exists, and it agrees with the batch ──
    // By hand: g=0 { 5, 7 } = 12, g=1 { -2 } = -2, in first-occurrence order.
    let bv: Vec<(i64, i64)> = match ok_basic(ss.as_slice()) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 10i32; }
    };
    if bv.len() != 2i64      { return 11i32; }
    if bv.get(0i64).1 != 12i64 { return 12i32; }
    if bv.get(1i64).1 != -2i64 { return 13i32; }
    let mut h: OkBasicIncr = ok_basic_incremental();
    match ok_basic_epoch(&mut h, ss.as_slice()) {
        Result::Ok(_n) => { } Result::Err(_e) => { return 14i32; }
    }
    let iv: Vec<(i64, i64)> = match ok_basic_snapshot(&h) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 15i32; }
    };
    if iv.len() != bv.len()    { return 16i32; }
    if iv.get(0i64).1 != 12i64 { return 17i32; }
    if iv.get(1i64).1 != -2i64 { return 18i32; }
    // …and it RETRACTS, because every aggregate in its list runs backwards.
    // By hand: retract (0, 5) and g=0's sum is 12 − 5 = 7; g=1 is untouched.
    let r1: Vec<S> = one_row(0i64, 5i64);
    match ok_basic_retract(&mut h, r1.as_slice()) {
        Result::Ok(_n) => { } Result::Err(_e) => { return 19i32; }
    }
    let rv: Vec<(i64, i64)> = match ok_basic_snapshot(&h) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 40i32; }
    };
    if rv.len() != 2i64        { return 41i32; }
    if rv.get(0i64).1 != 7i64  { return 42i32; }
    if rv.get(1i64).1 != -2i64 { return 43i32; }

    // ── THE RETRACT-DECLINED QUERY STILL HAS ITS HANDLE ────────────────────
    // The decline takes away `_retract` and nothing else. By hand: g=0 mean of
    // { 5, 7 } = 6.0, g=1 mean of { −2 } = −2.0, both exact in binary f64.
    let mut ha: NoRetractAvgIncr = no_retract_avg_incremental();
    match no_retract_avg_epoch(&mut ha, ss.as_slice()) {
        Result::Ok(_n) => { } Result::Err(_e) => { return 44i32; }
    }
    let av: Vec<(i64, f64)> = match no_retract_avg_snapshot(&ha) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 45i32; }
    };
    if av.len() != 2i64          { return 46i32; }
    if av.get(0i64).1 != 6.0f64  { return 47i32; }
    if av.get(1i64).1 != -2.0f64 { return 48i32; }

    // ── AN OUT-OF-RANGE SOURCE TAG ON A *ONE-SOURCE* QUERY ─────────────────
    // ⚠⚠ THIS IS THE ASSERTION THE OLD BEHAVIOUR COULD NOT CARRY, AND IT BELONGS
    // ON A BARE SCAN AND NOT ONLY ON A JOIN. `<q>_apply` used to answer `Ok(0)`
    // for any tag but 0, with the ground "a delta for a source this operator
    // does not read contributes nothing" — true while a tag could not be wrong,
    // and a silent success that folds nothing as soon as it can be. `ok_basic`
    // has exactly one relation, so 1 names none of them, and the answer must be
    // an ERROR by NAME. `deem_incr_join_e2e` asserts the same thing where two
    // sources exist; this is the half of the population that is not a join.
    match ok_basic_apply(&mut h, 1i32, 1i64, ss.as_slice()) {
        Result::Ok(_n) => { return 66i32; }
        Result::Err(es) => {
            match es {
                ElError::SrcUnknown => { }
                ElError::RetractAbsent => { return 67i32; }
                ElError::Underflow  => { return 68i32; }
                ElError::Overflow   => { return 69i32; }
                ElError::DivByZero  => { return 70i32; }
            }
        }
    }

    // ── THE ELIGIBLE JOIN: `<q>_apply` is the whole surface ────────────────
    // By hand over `uu` ⋈ `tt` on g: g=0 has U rows {5, 7} and T row w=3, so
    // n=2 and w=6; g=1 has U row {−2} and T row w=4, so n=1 and w=4.
    // ⚠ THE HANDLE IS DRIVEN ONE SIDE AT A TIME, WHICH IS THE ONLY SURFACE IT
    // HAS — and the first call matches nothing because the other side is still
    // empty. `deem_incr_join_e2e` is where the epoch algebra is asserted; what
    // this file pins is that the three derived fns EXIST for a join at all.
    let mut hj: OkJoinIncr = ok_join_incremental();
    match ok_join_apply(&mut hj, 0i32, 1i64, uu.as_slice(), tt.as_slice()) {
        Result::Ok(n) => { if n != 0i64 { return 50i32; } }
        Result::Err(_e) => { return 51i32; }
    }
    match ok_join_apply(&mut hj, 1i32, 1i64, uu.as_slice(), tt.as_slice()) {
        Result::Ok(n) => { if n != 3i64 { return 52i32; } }
        Result::Err(_e) => { return 53i32; }
    }
    let jv: Vec<(i64, i64, i64)> = match ok_join_snapshot(&hj) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 54i32; }
    };
    if jv.len() != 2i64      { return 55i32; }
    if jv.get(0i64).1 != 2i64 { return 56i32; }
    if jv.get(0i64).2 != 6i64 { return 57i32; }
    if jv.get(1i64).1 != 1i64 { return 58i32; }
    if jv.get(1i64).2 != 4i64 { return 59i32; }
    // …and the BATCH fn agrees with it.
    let jb: Vec<(i64, i64, i64)> = match ok_join(uu.as_slice(), tt.as_slice()) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 60i32; }
    };
    if jb.len() != jv.len()          { return 61i32; }
    if jb.get(0i64).1 != jv.get(0i64).1 { return 62i32; }
    if jb.get(0i64).2 != jv.get(0i64).2 { return 63i32; }
    if jb.get(1i64).1 != jv.get(1i64).1 { return 64i32; }
    if jb.get(1i64).2 != jv.get(1i64).2 { return 65i32; }

    // ── every INELIGIBLE query still compiles and still answers ─────────────
    // The batch fn is untouched by the decline, which is the property that keeps
    // "not eligible" from ever meaning "not supported".
    match no_join_strrow(ss.as_slice(), tt.as_slice()) {
        Result::Ok(v) => { if v.len() != 2i64 { return 20i32; } }
        Result::Err(_e) => { return 21i32; }
    }
    match no_join2(uu.as_slice(), tt.as_slice(), vv.as_slice()) {
        Result::Ok(v) => { if v.len() != 1i64 { return 44i32; } }
        Result::Err(_e) => { return 45i32; }
    }
    match no_join_avg(uu.as_slice(), tt.as_slice()) {
        Result::Ok(v) => { if v.len() != 2i64 { return 46i32; } }
        Result::Err(_e) => { return 47i32; }
    }
    match no_join_self(uu.as_slice()) {
        Result::Ok(v) => { if v.len() != 2i64 { return 48i32; } }
        Result::Err(_e) => { return 49i32; }
    }
    match no_where(ss.as_slice()) {
        Result::Ok(v) => { if v.len() != 1i64 { return 22i32; } }
        Result::Err(_e) => { return 23i32; }
    }
    match no_order(ss.as_slice()) {
        Result::Ok(v) => { if v.len() != 2i64 { return 24i32; } }
        Result::Err(_e) => { return 25i32; }
    }
    match no_limit(ss.as_slice()) {
        Result::Ok(v) => { if v.len() != 1i64 { return 26i32; } }
        Result::Err(_e) => { return 27i32; }
    }
    match no_strkey(ss.as_slice()) {
        Result::Ok(v) => { if v.len() != 2i64 { return 28i32; } }
        Result::Err(_e) => { return 29i32; }
    }
    match no_rowsel(ss.as_slice()) {
        Result::Ok(v) => { if v.len() != 2i64 { return 30i32; } }
        Result::Err(_e) => { return 31i32; }
    }
    return 0i32;
}
