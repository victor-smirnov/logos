// Structural validation (successor of the Writ1 Writ::check test):
// well-formed documents pass; a corrupted tag fails.
package writ_check;
use logos.lang.writ.hstatic;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.hmap;
use logos.lang.writ.hstring;
use logos.mem.writ.check;
use logos.mem.writ.clone;
use logos.lang.rc;

unsafe fn root_of(hs: &WritStatic) -> HAny {
    let base: *const u8 = hs.ptr;
    let w: i64 = *(base as *const i64);
    if w == 0i64 { return HAny::Ref(0i64 as *const u8); }
    if (w & 1i64) == 1i64 { return HAny::Pod(w as u64); }
    return HAny::Ref((base as i64 + w) as *const u8);
}

unsafe fn main() -> i32 {
    // 1. Null root validates.
    if !writ_check(HAny::Ref(0 as *const u8)) { return 1; }

    // 2. Scalar roots.
    if !writ_check(HAny::from(42 as i56)) { return 2; }
    if !writ_check(HAny::from(true)) { return 3; }

    // 3. Static literals of every shape.
    let s1: WritStatic = @{"a": [1, "two", true], "n": {"deep": 7}};
    if !writ_check(root_of(&s1)) { return 4; }
    let s2: WritStatic = @<I32>[1, 2, 3];
    if !writ_check(root_of(&s2)) { return 5; }
    let s3: WritStatic = @<I64, AnyVal>{5: 50};
    if !writ_check(root_of(&s3)) { return 6; }

    // 4. Runtime container (clone of a static doc) validates.
    let c: Rc<Writ> = writ_clone(root_of(&s1));
    let h: &Writ = c.deref();
    if !writ_check(h.root()) { return 7; }

    // 5. Corruption: zero the tag byte of a runtime map -> check fails.
    let rc2: Rc<Writ> = writ_rc(4096);
    let h2: &Writ = rc2.deref();
    let m: &mut HMap<HString, HAny> = h2.map(8);
    m.set("k", 1i64);
    let mp: *const HMap<HString, HAny> = m as *const HMap<HString, HAny>;
    let obj: *mut u8 = mp as *mut u8;
    *((obj as i64 - 1) as *mut u8) = 0 as u8;        // clobber the vlen tag
    if writ_check(HAny::ref_to(obj as *const u8)) { return 8; }

    return 0;
}
