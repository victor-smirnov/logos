package hermes_stringify;
// Phase: stringify — trait-based recursive serialisation of Hermes zone documents.

use logos.lang.hermes.zone;
use std.hermes.anyval;
use logos.lang.hermes.view;
use std.hermes.string;
use logos.lang.hermes.typetag;
use logos.lang.hermes.datatag;
use std.hermes.tag_system;
use std.hermes.array;
use std.hermes.map;
use std.hermes.typed_value;
use std.hermes.objectmap;
use std.hermes.document;
use std.hermes.stringify;
use logos.mem.string;
use logos.lang.str;

// Helper: stringify one AnyVal into `sb` with compact options and the given base.
unsafe fn stringify_one(val: AnyVal, base: *const u8, sb: *mut String) {
    sb.clear();
    let mut ctx: StringifyCtx = StringifyCtx {
        out:   sb,
        base:  base,
        opts:  StringifyOpts::compact(),
        depth: 0 as i64,
    };
    stringify_anyval(val, &mut ctx);
}

unsafe fn main() -> i32 {
    let mut zone: Zone<Mutable> = zone_create(16384);
    let base: *mut u8 = zone.holder.base;

    // Reserve zone offset 0 for DocumentHeader.
    let hdr_raw: *mut u8 = zone_m_alloc_raw(&mut zone, 8);
    let doc: *mut DocumentHeader = document_create(hdr_raw);

    let mut sb: String = String::new();
    let b: *const u8 = base as *const u8;

    // 1. null AnyVal → "null"
    stringify_one(AnyVal::null_ptr(), b, &mut sb);
    if !sb.eq_str("null") { return 1; }

    // 2. Integer (i32): "42"
    stringify_one(AnyVal::embed_i24(42), b, &mut sb);
    if !sb.eq_str("42") { return 2; }

    // 3. Integer zero: "0"
    stringify_one(AnyVal::embed_i24(0), b, &mut sb);
    if !sb.eq_str("0") { return 3; }

    // 4. Negative integer: "-1"
    stringify_one(AnyVal::embed_i24(-1), b, &mut sb);
    if !sb.eq_str("-1") { return 4; }

    // 5. UInteger (u24): "99_u32"
    stringify_one(AnyVal::embed_u24(99 as u32), b, &mut sb);
    if !sb.eq_str("99_u32") { return 5; }

    // 6. Boolean: "true" / "false"
    stringify_one(AnyVal::embed_bool(true), b, &mut sb);
    if !sb.eq_str("true") { return 6; }

    stringify_one(AnyVal::embed_bool(false), b, &mut sb);
    if !sb.eq_str("false") { return 7; }

    // 7. TinyInt (i8): "5_s8"
    stringify_one(AnyVal::embed_i8(5 as i8), b, &mut sb);
    if !sb.eq_str("5_s8") { return 8; }

    // 8. UInteger zero: "0_u32"
    stringify_one(AnyVal::embed_u24(0 as u32), b, &mut sb);
    if !sb.eq_str("0_u32") { return 9; }

    // 9. HermesString "hi" → `"hi"`
    let hs_raw: *mut u8 = zone_m_alloc_tagged(&mut zone, 3,
                              hermes_tag_string());
    let hs_p0: *mut u8 = (hs_raw as i64 + 0 as i64) as *mut u8;
    let hs_p1: *mut u8 = (hs_raw as i64 + 1 as i64) as *mut u8;
    let hs_p2: *mut u8 = (hs_raw as i64 + 2 as i64) as *mut u8;
    *hs_p0 = 2 as u8;    // vlen: 2 bytes follow
    *hs_p1 = 104 as u8;  // 'h'
    *hs_p2 = 105 as u8;  // 'i'
    let hs_val: AnyVal = AnyVal::from_offset((hs_raw as i64 - base as i64) as u32);

    stringify_one(hs_val, b, &mut sb);
    if !sb.eq_str("\"hi\"") { return 10; }

    // 10. ObjectArray [i32(1), i32(2)] → "[1,2]"
    let oa_raw: *mut u8 = zone_m_alloc_tagged(&mut zone,
                              sizeof::<ObjectArray>() as i64,
                              hermes_tag_array());
    let oa_buf: *mut u8 = zone_m_alloc_raw(&mut zone, 64);
    let arr: *mut ObjectArray = ObjectArray::init(oa_raw, oa_buf, base, 8 as u64);
    arr.push(zone.holder, AnyVal::embed_i24(1));
    arr.push(zone.holder, AnyVal::embed_i24(2));

    stringify_one(AnyVal::from_offset((oa_raw as i64 - base as i64) as u32), b, &mut sb);
    if !sb.eq_str("[1,2]") { return 11; }

    // 11. TinyObjectMap {k0: i32(7)} → `{"k0":7}`
    let tm_raw: *mut u8 = zone_m_alloc_tagged(&mut zone,
                              sizeof::<TinyObjectMap>() as i64,
                              hermes_tag_tiny_map());
    let tm_arr: *mut u8 = zone_m_alloc_raw(&mut zone, 80);
    let tmap: *mut TinyObjectMap = TinyObjectMap::init(tm_raw, tm_arr, base, 10 as u32);
    tmap.set(base, 0 as u8, AnyVal::embed_i24(7));

    stringify_one(AnyVal::from_offset((tm_raw as i64 - base as i64) as u32), b, &mut sb);
    if !sb.eq_str("{\"k0\":7}") { return 12; }

    // 12. stringify_document: root = i32(100) → "100"
    document_set_root(doc, AnyVal::embed_i24(100));

    sb.clear();
    stringify_document(b, &mut sb, StringifyOpts::compact());
    if !sb.eq_str("100") { return 13; }

    return 42;
}
