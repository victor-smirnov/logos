// query_diff_static — THREE-WAY differential: the STATIC `deem!` engine (native
// emitted code) vs the DYNAMIC `Query::run` interpreter vs an independent NAIVE
// oracle, over the same fuzzed data. The static and dynamic engines share the
// queue-1 LOWERING but DIVERGE at execution — static emits native Logos (the
// codegen path), dynamic interprets — so a static-vs-dynamic disagreement is a
// codegen bug the interpreter-only fuzzer (query_diff_fuzz) cannot see.
//
// The static query shapes are fixed (a macro can't be generated at runtime), so
// adversarial variation comes from the DATA (+ a fuzzed filter parameter). Each
// shape projects to a SINGLE i64 (columns arithmetic-combined) so all three
// sides return a Vec<i64> compared as a multiset. Static consumes plain-struct
// slices (&[SA]); dynamic consumes schema'd Writ rows — same columns, mirrored.
// Exit 0 iff all three agree every iteration; a nonzero code names the shape.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.wql.wql;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

// static side: plain-struct rows
struct SA { pub a0: i64, pub a1: i64, pub a2: i64 }
struct SB { pub b0: i64, pub b1: i64, pub b2: i64 }
// dynamic side: schema'd Writ rows (same columns)
pub schema A : code(0x0DF2_0000_0000_0001) { a0: i64 = 0, a1: i64 = 1, a2: i64 = 2 }
pub schema B : code(0x0DF2_0000_0000_0002) { b0: i64 = 0, b1: i64 = 1, b2: i64 = 2 }
resource cat = schema_catalog!{ A, B };

// ── the six STATIC resources (native emitted fns), single-i64 projection ──────
resource sf = deem!(a: &[SA], thr: i64) { from a x where x.a0 >= thr select x.a1 * 100 + x.a2 : i64 };
resource sj = deem!(a: &[SA], b: &[SB]) { from a x join b y on x.a0 == y.b0 select x.a1 * 100 + y.b1 : i64 };
resource sa = deem!(a: &[SA], b: &[SB]) { from a x anti join b y on x.a0 == y.b0 select x.a1 : i64 };
resource sg = deem!(a: &[SA]) { from a x group by x.a0 aggregate s = sum(x.a1) select key * 100 + s : i64 };
resource sm = deem!(a: &[SA]) { from a x group by x.a0 aggregate lo = min(x.a1), hi = max(x.a1) select key * 10000 + lo * 100 + hi : i64 };
resource sd = deem!(a: &[SA]) { from a x select distinct x.a1 : i64 };

// ── RNG (wrapping — plain */+ trap on u64 overflow) ──────────────────────────
struct Rng { s: u64 }
impl Rng {
    fn next(self: &mut Rng) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
    fn upto(self: &mut Rng, n: i64) -> i64 { return (self.next() % (n as u64)) as i64; }
    fn range(self: &mut Rng, lo: i64, hi: i64) -> i64 { return lo + self.upto(hi - lo); }
}

// raw data: flat row-major, stride 3
fn gen_rows(rng: &mut Rng, n: i64, vrange: i64) -> Vec<i64> {
    let mut v: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < n * 3i64 { v.push(rng.upto(vrange)); i = i + 1i64; }
    return v;
}
fn rg(v: &Vec<i64>, row: i64, col: i64) -> i64 { return v.get(row * 3i64 + col); }
fn nrows_of(v: &Vec<i64>) -> i64 { return v.len() / 3i64; }
fn contains(v: &Vec<i64>, x: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < v.len() { if v.get(i) == x { return true; } i = i + 1i64; }
    return false;
}

// result multiset (nc columns), sorted then compared
fn row_lt(cells: &Vec<i64>, nc: i64, i: i64, j: i64) -> bool {
    let mut c: i64 = 0i64;
    while c < nc {
        let x: i64 = cells.get(i * nc + c); let y: i64 = cells.get(j * nc + c);
        if x < y { return true; } if x > y { return false; }
        c = c + 1i64;
    }
    return false;
}
fn row_swap(cells: &mut Vec<i64>, nc: i64, i: i64, j: i64) {
    let mut c: i64 = 0i64;
    while c < nc {
        let t: i64 = cells.get(i * nc + c);
        cells.set(i * nc + c, cells.get(j * nc + c)); cells.set(j * nc + c, t);
        c = c + 1i64;
    }
}
fn rows_sort(cells: &mut Vec<i64>, nc: i64) {
    if nc <= 0i64 { return; }
    let nr: i64 = cells.len() / nc;
    let mut i: i64 = 0i64;
    while i < nr {
        let mut m: i64 = i; let mut j: i64 = i + 1i64;
        while j < nr { if row_lt(cells, nc, j, m) { m = j; } j = j + 1i64; }
        if m != i { row_swap(cells, nc, i, m); }
        i = i + 1i64;
    }
}
fn eq3(a: &mut Vec<i64>, b: &mut Vec<i64>, cc: &mut Vec<i64>) -> bool {
    if a.len() != b.len() { return false; }
    if a.len() != cc.len() { return false; }
    rows_sort(a, 1i64); rows_sort(b, 1i64); rows_sort(cc, 1i64);
    let mut i: i64 = 0i64;
    while i < a.len() { if a.get(i) != b.get(i) { return false; } if a.get(i) != cc.get(i) { return false; } i = i + 1i64; }
    return true;
}

// dynamic-engine Writ builders + one-column extract
fn mkA(d: &Writ, x0: i64, x1: i64, x2: i64) -> WAny {
    let r: A = d.make::<A>(); r.a0 = x0; r.a1 = x1; r.a2 = x2;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn mkB(d: &Writ, x0: i64, x1: i64, x2: i64) -> WAny {
    let r: B = d.make::<B>(); r.b0 = x0; r.b1 = x1; r.b2 = x2;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn wsrcA(d: &Writ, raw: &Vec<i64>) -> WAny {
    let n: i64 = nrows_of(raw); let arr: &mut WArray<WAny> = d.array(n + 1i64);
    let mut i: i64 = 0i64;
    while i < n { arr.push(mkA(d, rg(raw, i, 0i64), rg(raw, i, 1i64), rg(raw, i, 2i64))); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}
fn wsrcB(d: &Writ, raw: &Vec<i64>) -> WAny {
    let n: i64 = nrows_of(raw); let arr: &mut WArray<WAny> = d.array(n + 1i64);
    let mut i: i64 = 0i64;
    while i < n { arr.push(mkB(d, rg(raw, i, 0i64), rg(raw, i, 1i64), rg(raw, i, 2i64))); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}
fn dyn_run(qt: str, c: &SchemaCatalog, env: &QEnv) -> Vec<i64> {
    let mut out: Vec<i64> = vec_new::<i64>();
    match Query::compile(qt, c) {
        Result::Ok(q) => {
            match q.run(env) {
                Result::Ok(r) => {
                    let nr: i64 = r.row_count();
                    let mut i: i64 = 0i64;
                    while i < nr { out.push(r.get_i64(i, 0i64)); i = i + 1i64; }
                }
                Result::Err(_e2) => { out.push(-998i64); }
            }
        }
        Result::Err(_e) => { out.push(-999i64); }
    }
    return out;
}

// static-side plain-struct slices from raw
fn slabA(raw: &Vec<i64>) -> Vec<SA> {
    let mut v: Vec<SA> = vec_new::<SA>(); let n: i64 = nrows_of(raw); let mut i: i64 = 0i64;
    while i < n { v.push(SA { a0: rg(raw, i, 0i64), a1: rg(raw, i, 1i64), a2: rg(raw, i, 2i64) }); i = i + 1i64; }
    return v;
}
fn slabB(raw: &Vec<i64>) -> Vec<SB> {
    let mut v: Vec<SB> = vec_new::<SB>(); let n: i64 = nrows_of(raw); let mut i: i64 = 0i64;
    while i < n { v.push(SB { b0: rg(raw, i, 0i64), b1: rg(raw, i, 1i64), b2: rg(raw, i, 2i64) }); i = i + 1i64; }
    return v;
}

fn main() -> i32 {
    let mut rng: Rng = Rng { s: 0x9E3779B97F4A7C15u64 };
    let c: SchemaCatalog = cat();
    let NITER: i64 = 1500i64;
    let MAXROWS: i64 = 8i64;

    let mut it: i64 = 0i64;
    while it < NITER {
        let shape: i64 = rng.upto(6i64);
        let VRANGE: i64 = rng.range(2i64, 8i64);
        let na: i64 = rng.upto(MAXROWS);
        let av: Vec<i64> = gen_rows(&mut rng, na, VRANGE);
        let nb: i64 = rng.upto(MAXROWS);
        let bv: Vec<i64> = gen_rows(&mut rng, nb, VRANGE);
        let thr: i64 = rng.upto(VRANGE);

        // shared dynamic env
        let d: Writ = writ_new(8192i64);
        let mut env: QEnv = QEnv::new();
        env.bind_source("a", wsrcA(&d, &av));
        env.bind_source("b", wsrcB(&d, &bv));

        let sla: Vec<SA> = slabA(&av);
        let slb: Vec<SB> = slabB(&bv);

        let mut stat: Vec<i64> = vec_new::<i64>();
        let mut dynv: Vec<i64> = vec_new::<i64>();
        let mut naive: Vec<i64> = vec_new::<i64>();

        if shape == 0i64 {
            env.bind_i64("thr", thr);
            stat = sf(sla.as_slice(), thr);
            dynv = dyn_run("from a x where x.a0 >= thr select x.a1 * 100 + x.a2", &c, &env);
            let mut r: i64 = 0i64;
            while r < na { if rg(&av, r, 0i64) >= thr { naive.push(rg(&av, r, 1i64) * 100i64 + rg(&av, r, 2i64)); } r = r + 1i64; }
        } else if shape == 1i64 {
            stat = sj(sla.as_slice(), slb.as_slice());
            dynv = dyn_run("from a x join b y on x.a0 == y.b0 select x.a1 * 100 + y.b1", &c, &env);
            let mut ra: i64 = 0i64;
            while ra < na {
                let mut rb: i64 = 0i64;
                while rb < nb { if rg(&av, ra, 0i64) == rg(&bv, rb, 0i64) { naive.push(rg(&av, ra, 1i64) * 100i64 + rg(&bv, rb, 1i64)); } rb = rb + 1i64; }
                ra = ra + 1i64;
            }
        } else if shape == 2i64 {
            stat = sa(sla.as_slice(), slb.as_slice());
            dynv = dyn_run("from a x anti join b y on x.a0 == y.b0 select x.a1", &c, &env);
            let mut ra: i64 = 0i64;
            while ra < na {
                let mut hit: bool = false; let mut rb: i64 = 0i64;
                while rb < nb { if rg(&av, ra, 0i64) == rg(&bv, rb, 0i64) { hit = true; } rb = rb + 1i64; }
                if !hit { naive.push(rg(&av, ra, 1i64)); }
                ra = ra + 1i64;
            }
        } else if shape == 3i64 {
            stat = sg(sla.as_slice());
            dynv = dyn_run("from a x group by x.a0 aggregate s = sum(x.a1) select key * 100 + s", &c, &env);
            let mut keys: Vec<i64> = vec_new::<i64>(); let mut r: i64 = 0i64;
            while r < na { let k: i64 = rg(&av, r, 0i64); if !contains(&keys, k) { keys.push(k); } r = r + 1i64; }
            let mut ki: i64 = 0i64;
            while ki < keys.len() {
                let k: i64 = keys.get(ki); let mut sm2: i64 = 0i64; let mut r2: i64 = 0i64;
                while r2 < na { if rg(&av, r2, 0i64) == k { sm2 = sm2 + rg(&av, r2, 1i64); } r2 = r2 + 1i64; }
                naive.push(k * 100i64 + sm2); ki = ki + 1i64;
            }
        } else if shape == 4i64 {
            stat = sm(sla.as_slice());
            dynv = dyn_run("from a x group by x.a0 aggregate lo = min(x.a1), hi = max(x.a1) select key * 10000 + lo * 100 + hi", &c, &env);
            let mut keys: Vec<i64> = vec_new::<i64>(); let mut r: i64 = 0i64;
            while r < na { let k: i64 = rg(&av, r, 0i64); if !contains(&keys, k) { keys.push(k); } r = r + 1i64; }
            let mut ki: i64 = 0i64;
            while ki < keys.len() {
                let k: i64 = keys.get(ki); let mut lo: i64 = 0i64; let mut hi: i64 = 0i64; let mut seen: bool = false; let mut r2: i64 = 0i64;
                while r2 < na {
                    if rg(&av, r2, 0i64) == k {
                        let vv: i64 = rg(&av, r2, 1i64);
                        if !seen { lo = vv; hi = vv; seen = true; } else { if vv < lo { lo = vv; } if vv > hi { hi = vv; } }
                    }
                    r2 = r2 + 1i64;
                }
                naive.push(k * 10000i64 + lo * 100i64 + hi); ki = ki + 1i64;
            }
        } else {
            stat = sd(sla.as_slice());
            dynv = dyn_run("from a x select distinct x.a1", &c, &env);
            let mut r: i64 = 0i64;
            while r < na { let vv: i64 = rg(&av, r, 1i64); if !contains(&naive, vv) { naive.push(vv); } r = r + 1i64; }
        }

        if !eq3(&mut stat, &mut dynv, &mut naive) { return 40i32 + (shape as i32); }
        it = it + 1i64;
    }
    return 0i32;
}
