// query_diff_static — differential fuzzer for the STATIC `deem` engine (native
// emitted code) against an independent NAIVE oracle written IN THIS FILE, over
// fuzzed data. TEN shapes: six numeric (0-5) and four STRING (6-9).
//
// ── WHY THE ORACLE IS THE NAIVE ARM, NOT THE INTERPRETER ─────────────────────
// Read at the COMPARISON SITE: `eq2`/`strv_*_eq`/`pair_ms_eq` put the emitted
// engine's answer beside nested loops that call NOTHING from `logos.mem.deem` or
// `logos.std.wql`. The interpreter was a THIRD opinion on shapes 0-5, never the
// oracle. P5 DELETED IT, and this file is where that cost is priced: shapes 0-5
// lose their third arm and shapes 6-9 lose nothing — they were already written
// in post-cut form. The comparison went from `eq3(stat, dynv, naive)` to
// `eq2(stat, naive)`; the ORACLE side of it did not move.
//
// ⚠ THE STRING ORACLE MUST NOT CALL `str_cmp`/`str_eq`. Sema lowers the emitted
// engine's `str` relationals to `logos.lang.str::str_cmp` (see the note at
// `str_cmp`, echoed in `stdlib/mem/wql/rexpr_walk.logos` and
// `stdlib/mem/wql/el.logos`), so an oracle that called it would share the exact
// fold under test. `b_cmp` below is a local byte loop over `str_byte_at`.
//
// ── THE FOUR COMPARE FOLDS THE STATIC TIER ACTUALLY HAS ──────────────────────
// A single perturbation cannot control this fixture, and pretending otherwise
// is how the previous round's control changed nothing:
//   · `emit_binop` (`stdlib/mem/wql/codegen.logos`) — scalar/ordered compare in
//     a `where` residual. Shapes 0, 6.
//   · `key_norm_body` + the HashMap/HashSet probe built by `emit_step_texts` /
//     `equi_term_sides` (`stdlib/mem/wql/rexpr_walk.logos`) — equi-JOIN
//     equality, which does NOT reach `emit_binop`. Shapes 1, 2, 7.
//   · the group-key hash — shapes 3, 4, 8; `select distinct` — shape 5.
//   · `sort_perm_frag` / `key_ord_frag` (`rexpr_walk.logos`) — `order by`.
//     Shape 9.
// The string shapes are laid out so each fold gets one: 6 = emit_binop ordered
// on `str`, 7 = str join key, 8 = str group key, 9 = str order key.
//
// The static query shapes are fixed (a macro can't be generated at runtime), so
// adversarial variation comes from the DATA (+ a fuzzed filter parameter, and a
// fuzzed `str` PARAM for shape 6). Numeric shapes project to a SINGLE i64 so
// all three sides return a Vec<i64> compared as a multiset. Static consumes
// plain-struct slices (&[SA]). Exit 0 iff both arms agree every iteration; a nonzero
// code names the shape.
package test;

use logos.std.wql.wql;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

// static side: plain-struct rows
struct SA { pub a0: i64, pub a1: i64, pub a2: i64 }
struct SB { pub b0: i64, pub b1: i64, pub b2: i64 }
// static side: str-bearing rows (shapes 6-9)
struct SS { pub s: str, pub n: i64 }
struct ST { pub t: str, pub m: i64 }

// ── the six STATIC resources (native emitted fns), single-i64 projection ──────
pub deem sf(a: &[SA], thr: i64) { from a x where x.a0 >= thr select x.a1 * 100 + x.a2 : i64 }
pub deem sj(a: &[SA], b: &[SB]) { from a x join b y on x.a0 == y.b0 select x.a1 * 100 + y.b1 : i64 }
pub deem sa(a: &[SA], b: &[SB]) { from a x anti join b y on x.a0 == y.b0 select x.a1 : i64 }
pub deem sg(a: &[SA]) { from a x group by x.a0 aggregate s = sum(x.a1) select key * 100 + s : i64 }
pub deem sm(a: &[SA]) { from a x group by x.a0 aggregate lo = min(x.a1), hi = max(x.a1) select key * 10000 + lo * 100 + hi : i64 }
pub deem sd(a: &[SA]) { from a x select distinct x.a1 : i64 }

// ── the four STRING shapes, one per compare fold ──────────────────────────────
// `q: str` is a TYPED PARAM (the `wql_typed_params_e2e` spelling), so the fuzzed
// string LITERAL stays a fuzzed dimension without one `deem` item per pool entry.
pub deem ss_lt(a: &[SS], q: str) { from a x where x.s < q select x.n : i64 }
pub deem ss_join(a: &[SS], b: &[ST]) { from a x join b y on x.s == y.t select x.n * 100 + y.m : i64 }
pub deem ss_grp(a: &[SS]) { from a x group by x.s aggregate c = count() select (key, c) }
pub deem ss_ord(a: &[SS]) { from a x select x.s order by x.s : str }

// ── RNG (wrapping — plain */+ trap on u64 overflow) ──────────────────────────
struct Rng { s: u64 }
impl Rng {
    fn next(self: &mut Rng) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
    fn upto(self: &mut Rng, n: i64) -> i64 { return (self.next() % (n as u64)) as i64; }
    fn range(self: &mut Rng, lo: i64, hi: i64) -> i64 { return lo + self.upto(hi - lo); }
}

// raw data: flat row-major, stride 3
fn gen_rows(rng: &mut Rng, n: i64, vrange: i64) -> Vec<i64> {
    let mut v: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < n * 3i64 { v.push(rng.upto(vrange)); i = i + 1i64; }
    return v;
}
fn rg(v: &Vec<i64>, row: i64, col: i64) -> i64 { return v.get(row * 3i64 + col); }
fn nrows_of(v: &Vec<i64>) -> i64 { return v.len() / 3i64; }
fn contains(v: &Vec<i64>, x: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < v.len() { if v.get(i) == x { return true; } i = i + 1i64; }
    return false;
}

// result multiset (nc columns), sorted then compared
fn row_lt(cells: &Vec<i64>, nc: i64, i: i64, j: i64) -> bool {
    let mut c: i64 = 0i64;
    while c < nc {
        let x: i64 = cells.get(i * nc + c); let y: i64 = cells.get(j * nc + c);
        if x < y { return true; } if x > y { return false; }
        c = c + 1i64;
    }
    return false;
}
fn row_swap(cells: &mut Vec<i64>, nc: i64, i: i64, j: i64) {
    let mut c: i64 = 0i64;
    while c < nc {
        let t: i64 = cells.get(i * nc + c);
        cells.set(i * nc + c, cells.get(j * nc + c)); cells.set(j * nc + c, t);
        c = c + 1i64;
    }
}
fn rows_sort(cells: &mut Vec<i64>, nc: i64) {
    if nc <= 0i64 { return; }
    let nr: i64 = cells.len() / nc;
    let mut i: i64 = 0i64;
    while i < nr {
        let mut m: i64 = i; let mut j: i64 = i + 1i64;
        while j < nr { if row_lt(cells, nc, j, m) { m = j; } j = j + 1i64; }
        if m != i { row_swap(cells, nc, i, m); }
        i = i + 1i64;
    }
}
fn eq2(a: &mut Vec<i64>, b: &mut Vec<i64>) -> bool {
    if a.len() != b.len() { return false; }
    rows_sort(a, 1i64); rows_sort(b, 1i64);
    let mut i: i64 = 0i64;
    while i < a.len() { if a.get(i) != b.get(i) { return false; } i = i + 1i64; }
    return true;
}

// ── the string pool (static literals; the engine borrows keys from them) ──────
// Chosen as in `query_diff_str_adv`: the EMPTY string, a prefix chain a/aa/aaa,
// "B"(66) vs "a"(97) so byte order and case order disagree, plus duplicates via
// the per-iteration span — forcing empty keys, prefix boundaries and collisions.
fn pool(i: i64) -> str {
    if i == 0i64 { return ""; }
    if i == 1i64 { return "a"; }
    if i == 2i64 { return "aa"; }
    if i == 3i64 { return "aaa"; }
    if i == 4i64 { return "b"; }
    if i == 5i64 { return "B"; }
    if i == 6i64 { return "ab"; }
    return "ba";
}
fn POOLN() -> i64 { return 8i64; }

// ── the INDEPENDENT str comparator: a byte loop, NOT `str_cmp`/`str_eq` ───────
// `str_byte_at` is a byte ACCESSOR; the ordering decision is made here.
fn b_cmp(a: str, b: str) -> i64 {
    let na: i64 = a.len(); let nb: i64 = b.len();
    let mut i: i64 = 0i64;
    while i < na {
        if i >= nb { return 1i64; }
        let x: i64 = str_byte_at(a, i) as i64;
        let y: i64 = str_byte_at(b, i) as i64;
        if x < y { return -1i64; }
        if x > y { return 1i64; }
        i = i + 1i64;
    }
    if nb > na { return -1i64; }
    return 0i64;
}
fn b_eq(a: str, b: str) -> bool { return b_cmp(a, b) == 0i64; }
fn b_lt(a: str, b: str) -> bool { return b_cmp(a, b) < 0i64; }

fn strv_sort(v: &mut Vec<str>) {
    let n: i64 = v.len();
    let mut i: i64 = 0i64;
    while i < n {
        let mut m: i64 = i; let mut j: i64 = i + 1i64;
        while j < n { if b_lt(v.get(j), v.get(m)) { m = j; } j = j + 1i64; }
        if m != i { let t: str = v.get(i); v.set(i, v.get(m)); v.set(m, t); }
        i = i + 1i64;
    }
}
// ORDER-sensitive (order by): element-wise, no sort of the engine's side.
fn strv_seq_eq(a: &Vec<str>, b: &Vec<str>) -> bool {
    if a.len() != b.len() { return false; }
    let mut i: i64 = 0i64;
    while i < a.len() { if !b_eq(a.get(i), b.get(i)) { return false; } i = i + 1i64; }
    return true;
}
fn contains_str(v: &Vec<str>, x: str) -> bool {
    let mut i: i64 = 0i64;
    while i < v.len() { if b_eq(v.get(i), x) { return true; } i = i + 1i64; }
    return false;
}
// (str,i64) multiset — the group-by(str key) result
fn pair_lt(ka: str, na: i64, kb: str, nb: i64) -> bool {
    let c: i64 = b_cmp(ka, kb);
    if c < 0i64 { return true; }
    if c > 0i64 { return false; }
    return na < nb;
}
fn pair_sort(k: &mut Vec<str>, n: &mut Vec<i64>) {
    let cnt: i64 = k.len();
    let mut i: i64 = 0i64;
    while i < cnt {
        let mut m: i64 = i; let mut j: i64 = i + 1i64;
        while j < cnt { if pair_lt(k.get(j), n.get(j), k.get(m), n.get(m)) { m = j; } j = j + 1i64; }
        if m != i {
            let ts: str = k.get(i); k.set(i, k.get(m)); k.set(m, ts);
            let ti: i64 = n.get(i); n.set(i, n.get(m)); n.set(m, ti);
        }
        i = i + 1i64;
    }
}
fn pair_ms_eq(ak: &mut Vec<str>, an: &mut Vec<i64>, bk: &mut Vec<str>, bn: &mut Vec<i64>) -> bool {
    if ak.len() != bk.len() { return false; }
    pair_sort(ak, an); pair_sort(bk, bn);
    let mut i: i64 = 0i64;
    while i < ak.len() {
        if !b_eq(ak.get(i), bk.get(i)) { return false; }
        if an.get(i) != bn.get(i) { return false; }
        i = i + 1i64;
    }
    return true;
}

// static-side plain-struct slices from raw
fn slabA(raw: &Vec<i64>) -> Vec<SA> {
    let mut v: Vec<SA> = vec_new::<SA>(); let n: i64 = nrows_of(raw); let mut i: i64 = 0i64;
    while i < n { v.push(SA { a0: rg(raw, i, 0i64), a1: rg(raw, i, 1i64), a2: rg(raw, i, 2i64) }); i = i + 1i64; }
    return v;
}
fn slabB(raw: &Vec<i64>) -> Vec<SB> {
    let mut v: Vec<SB> = vec_new::<SB>(); let n: i64 = nrows_of(raw); let mut i: i64 = 0i64;
    while i < n { v.push(SB { b0: rg(raw, i, 0i64), b1: rg(raw, i, 1i64), b2: rg(raw, i, 2i64) }); i = i + 1i64; }
    return v;
}

// static-side str slabs from pool indices
fn slabS(idx: &Vec<i64>, nv: &Vec<i64>) -> Vec<SS> {
    let mut v: Vec<SS> = vec_new::<SS>(); let mut i: i64 = 0i64;
    while i < idx.len() { v.push(SS { s: pool(idx.get(i)), n: nv.get(i) }); i = i + 1i64; }
    return v;
}
fn slabT(idx: &Vec<i64>, nv: &Vec<i64>) -> Vec<ST> {
    let mut v: Vec<ST> = vec_new::<ST>(); let mut i: i64 = 0i64;
    while i < idx.len() { v.push(ST { t: pool(idx.get(i)), m: nv.get(i) }); i = i + 1i64; }
    return v;
}

fn main() -> i32 {
    let mut rng: Rng = Rng { s: 0x9E3779B97F4A7C15u64 };
    let NITER: i64 = 1500i64;
    let MAXROWS: i64 = 8i64;

    // ── shapes 6-9: the STRING dimension, static vs the fixture-local oracle ──
    let mut sit: i64 = 0i64;
    while sit < NITER {
        let sshape: i64 = rng.upto(4i64);
        let span: i64 = rng.range(2i64, POOLN() + 1i64);   // pool[0..span)
        let ns: i64 = rng.upto(MAXROWS);
        let nt: i64 = rng.upto(MAXROWS);
        let mut si: Vec<i64> = vec_new::<i64>(); let mut sn: Vec<i64> = vec_new::<i64>();
        let mut r0: i64 = 0i64;
        while r0 < ns { si.push(rng.upto(span)); sn.push(rng.range(0i64, 5i64)); r0 = r0 + 1i64; }
        let mut ti: Vec<i64> = vec_new::<i64>(); let mut tn: Vec<i64> = vec_new::<i64>();
        let mut r1: i64 = 0i64;
        while r1 < nt { ti.push(rng.upto(span)); tn.push(rng.range(0i64, 5i64)); r1 = r1 + 1i64; }
        let sls: Vec<SS> = slabS(&si, &sn);
        let slt: Vec<ST> = slabT(&ti, &tn);

        if sshape == 0i64 {
            // FOLD `emit_binop`: ordered compare on a str column vs a str PARAM.
            let q: str = pool(rng.upto(span));
            let mut stat: Vec<i64> = ss_lt(sls.as_slice(), q).unwrap();
            let mut want: Vec<i64> = vec_new::<i64>();
            let mut r: i64 = 0i64;
            while r < ns { if b_lt(pool(si.get(r)), q) { want.push(sn.get(r)); } r = r + 1i64; }
            if !eq2(&mut stat, &mut want) { return 46i32; }
        } else if sshape == 1i64 {
            // FOLD `key_norm_body` + the hash probe: equi-JOIN on a str key.
            let mut stat: Vec<i64> = ss_join(sls.as_slice(), slt.as_slice()).unwrap();
            let mut want: Vec<i64> = vec_new::<i64>();
            let mut ra: i64 = 0i64;
            while ra < ns {
                let mut rb: i64 = 0i64;
                while rb < nt {
                    if b_eq(pool(si.get(ra)), pool(ti.get(rb))) { want.push(sn.get(ra) * 100i64 + tn.get(rb)); }
                    rb = rb + 1i64;
                }
                ra = ra + 1i64;
            }
            if !eq2(&mut stat, &mut want) { return 47i32; }
        } else if sshape == 2i64 {
            // FOLD the group-key hash: `group by` a str key.
            let g: Vec<(str, i64)> = ss_grp(sls.as_slice()).unwrap();
            let mut gk: Vec<str> = vec_new::<str>(); let mut gc: Vec<i64> = vec_new::<i64>();
            let mut i: i64 = 0i64;
            while i < g.len() { gk.push(g.get(i).0); gc.push(g.get(i).1); i = i + 1i64; }
            let mut keys: Vec<str> = vec_new::<str>();
            let mut r: i64 = 0i64;
            while r < ns { let k: str = pool(si.get(r)); if !contains_str(&keys, k) { keys.push(k); } r = r + 1i64; }
            let mut wk: Vec<str> = vec_new::<str>(); let mut wc: Vec<i64> = vec_new::<i64>();
            let mut ki: i64 = 0i64;
            while ki < keys.len() {
                let k: str = keys.get(ki); let mut cnt: i64 = 0i64; let mut r2: i64 = 0i64;
                while r2 < ns { if b_eq(pool(si.get(r2)), k) { cnt = cnt + 1i64; } r2 = r2 + 1i64; }
                wk.push(k); wc.push(cnt); ki = ki + 1i64;
            }
            if !pair_ms_eq(&mut wk, &mut wc, &mut gk, &mut gc) { return 48i32; }
        } else {
            // FOLD `sort_perm_frag`/`key_ord_frag`: `order by` a str key.
            // ORDER-SENSITIVE — the engine's sequence is compared position by
            // position against a byte-lexicographic sort written here.
            let got: Vec<str> = ss_ord(sls.as_slice()).unwrap();
            let mut want: Vec<str> = vec_new::<str>();
            let mut r: i64 = 0i64;
            while r < ns { want.push(pool(si.get(r))); r = r + 1i64; }
            strv_sort(&mut want);
            if !strv_seq_eq(&want, &got) { return 49i32; }
        }
        sit = sit + 1i64;
    }

    let mut it: i64 = 0i64;
    while it < NITER {
        let shape: i64 = rng.upto(6i64);
        let VRANGE: i64 = rng.range(2i64, 8i64);
        let na: i64 = rng.upto(MAXROWS);
        let av: Vec<i64> = gen_rows(&mut rng, na, VRANGE);
        let nb: i64 = rng.upto(MAXROWS);
        let bv: Vec<i64> = gen_rows(&mut rng, nb, VRANGE);
        let thr: i64 = rng.upto(VRANGE);

        let sla: Vec<SA> = slabA(&av);
        let slb: Vec<SB> = slabB(&bv);

        let mut stat: Vec<i64> = vec_new::<i64>();
        let mut naive: Vec<i64> = vec_new::<i64>();

        if shape == 0i64 {
            stat = sf(sla.as_slice(), thr).unwrap();
            let mut r: i64 = 0i64;
            while r < na { if rg(&av, r, 0i64) >= thr { naive.push(rg(&av, r, 1i64) * 100i64 + rg(&av, r, 2i64)); } r = r + 1i64; }
        } else if shape == 1i64 {
            stat = sj(sla.as_slice(), slb.as_slice()).unwrap();
            let mut ra: i64 = 0i64;
            while ra < na {
                let mut rb: i64 = 0i64;
                while rb < nb { if rg(&av, ra, 0i64) == rg(&bv, rb, 0i64) { naive.push(rg(&av, ra, 1i64) * 100i64 + rg(&bv, rb, 1i64)); } rb = rb + 1i64; }
                ra = ra + 1i64;
            }
        } else if shape == 2i64 {
            stat = sa(sla.as_slice(), slb.as_slice()).unwrap();
            let mut ra: i64 = 0i64;
            while ra < na {
                let mut hit: bool = false; let mut rb: i64 = 0i64;
                while rb < nb { if rg(&av, ra, 0i64) == rg(&bv, rb, 0i64) { hit = true; } rb = rb + 1i64; }
                if !hit { naive.push(rg(&av, ra, 1i64)); }
                ra = ra + 1i64;
            }
        } else if shape == 3i64 {
            stat = sg(sla.as_slice()).unwrap();
            let mut keys: Vec<i64> = vec_new::<i64>(); let mut r: i64 = 0i64;
            while r < na { let k: i64 = rg(&av, r, 0i64); if !contains(&keys, k) { keys.push(k); } r = r + 1i64; }
            let mut ki: i64 = 0i64;
            while ki < keys.len() {
                let k: i64 = keys.get(ki); let mut sm2: i64 = 0i64; let mut r2: i64 = 0i64;
                while r2 < na { if rg(&av, r2, 0i64) == k { sm2 = sm2 + rg(&av, r2, 1i64); } r2 = r2 + 1i64; }
                naive.push(k * 100i64 + sm2); ki = ki + 1i64;
            }
        } else if shape == 4i64 {
            stat = sm(sla.as_slice()).unwrap();
            let mut keys: Vec<i64> = vec_new::<i64>(); let mut r: i64 = 0i64;
            while r < na { let k: i64 = rg(&av, r, 0i64); if !contains(&keys, k) { keys.push(k); } r = r + 1i64; }
            let mut ki: i64 = 0i64;
            while ki < keys.len() {
                let k: i64 = keys.get(ki); let mut lo: i64 = 0i64; let mut hi: i64 = 0i64; let mut seen: bool = false; let mut r2: i64 = 0i64;
                while r2 < na {
                    if rg(&av, r2, 0i64) == k {
                        let vv: i64 = rg(&av, r2, 1i64);
                        if !seen { lo = vv; hi = vv; seen = true; } else { if vv < lo { lo = vv; } if vv > hi { hi = vv; } }
                    }
                    r2 = r2 + 1i64;
                }
                naive.push(k * 10000i64 + lo * 100i64 + hi); ki = ki + 1i64;
            }
        } else {
            stat = sd(sla.as_slice()).unwrap();
            let mut r: i64 = 0i64;
            while r < na { let vv: i64 = rg(&av, r, 1i64); if !contains(&naive, vv) { naive.push(vv); } r = r + 1i64; }
        }

        if !eq2(&mut stat, &mut naive) { return 40i32 + (shape as i32); }
        it = it + 1i64;
    }
    return 0i32;
}
