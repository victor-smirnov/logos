// #86 MISS-A — ADMIT half. ONE VARIABLE against
// fail/bc_esc_holder_reborrow_field_dangle: the borrow stored through the
// `&mut` reborrow local is rooted at a PARAMETER, not at a fn-local, so it
// outlives the frame and `return w.v` is sound. The re-home (`r` → `w`) runs
// identically in both — this file is what proves the fix re-homes rather than
// refuses.
//
// `ok_param` pins the second spelling of the same fact: the reborrow SOURCE is
// itself a parameter (`let r: &mut W = w;`), so the holder is caller storage
// and nothing in the frame can dangle.
package bc_esc_holder_reborrow_field_admit;
use logos.mem.string;

pub struct W { pub v: str }

pub fn ok(s: str) -> str {
    let mut w: W = W { v: "" };
    let r: &mut W = &mut w;
    r.v = s;
    return w.v;
}

pub fn ok_param(w: &mut W, s: str) -> str {
    let r: &mut W = w;
    r.v = s;
    return w.v;
}

fn main() -> i32 {
    let o: String = String::from("hello");
    if ok(o.as_str()).len() != 5i64 { return 1i32; }
    let mut w2: W = W { v: "" };
    if ok_param(&mut w2, o.as_str()).len() != 5i64 { return 2i32; }
    if w2.v.len() != 5i64 { return 3i32; }
    return 0i32;
}
