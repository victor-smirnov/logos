// query_metamorphic_adv — METAMORPHIC differential for the Deem query engine.
// Instead of an independent oracle, this probe runs the engine against ITSELF
// under semantics-preserving transforms and asserts the results agree as a
// multiset. Any disagreement is a self-inconsistency bug in the engine.
//
// Invariants exercised (per iteration, random query+data):
//   T0  FILTER is invariant to input row PERMUTATION.
//   T1  JOIN   is invariant to input row PERMUTATION (both sources shuffled).
//   T2  GROUP-BY(sum) is invariant to input row PERMUTATION.
//   T3  DISTINCT is invariant to input row DUPLICATION (SET-insensitive to dups).
//   T4  `where P1 && P2` == `where P2 && P1`  (&& commutativity).
//   T5  `A join B on k` == `B join A on k`     (join commutativity up to proj).
//   T6  `where P1 || P2` == `where P2 || P1`  (|| commutativity).
//   T7  GROUP-BY(min,max) invariant to input row PERMUTATION.
//   T8  DISTINCT idempotent under permute+duplicate (distinct(D)==distinct(π(2D))).
//   T9  ANTI join invariant to input row PERMUTATION.
//
// Exit 0 iff every iteration's two forms agree; a nonzero code names the failing
// template (100+tmpl compile-err form1, 130+tmpl run-err form1, 160+.. form2,
// 40+tmpl multiset disagreement, 60+tmpl col-count mismatch).
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema A : code(0x0DF5_0000_0000_0001) { a0: i64 = 0, a1: i64 = 1, a2: i64 = 2 }
pub schema B : code(0x0DF5_0000_0000_0002) { b0: i64 = 0, b1: i64 = 1, b2: i64 = 2 }
resource cat = schema_catalog!{ A, B };

struct Rng { s: u64 }
impl Rng {
    fn next(self: &mut Rng) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
    fn upto(self: &mut Rng, n: i64) -> i64 { return (self.next() % (n as u64)) as i64; }
    fn range(self: &mut Rng, lo: i64, hi: i64) -> i64 { return lo + self.upto(hi - lo); }
}

fn op_str(op: i64) -> str {
    if op == 0i64 { return "=="; }
    if op == 1i64 { return "!="; }
    if op == 2i64 { return "<";  }
    if op == 3i64 { return "<="; }
    if op == 4i64 { return ">";  }
    return ">=";
}

// raw data flat row-major, stride 3
fn gen_rows(rng: &mut Rng, n: i64, vrange: i64) -> Vec<i64> {
    let mut v: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < n * 3i64 { v.push(rng.upto(vrange)); i = i + 1i64; }
    return v;
}
fn rowget(v: &Vec<i64>, row: i64, col: i64) -> i64 { return v.get(row * 3i64 + col); }
fn nrows_of(v: &Vec<i64>) -> i64 { return v.len() / 3i64; }

// permute rows (Fisher-Yates over row indices), emit new stride-3 vec
fn permute_rows(rng: &mut Rng, raw: &Vec<i64>) -> Vec<i64> {
    let n: i64 = nrows_of(raw);
    let mut idx: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < n { idx.push(i); i = i + 1i64; }
    let mut k: i64 = n;
    while k > 1i64 {
        let j: i64 = rng.upto(k);
        let t: i64 = idx.get(k - 1i64);
        idx.set(k - 1i64, idx.get(j));
        idx.set(j, t);
        k = k - 1i64;
    }
    let mut out: Vec<i64> = vec_new::<i64>();
    let mut r: i64 = 0i64;
    while r < n {
        let src: i64 = idx.get(r);
        out.push(rowget(raw, src, 0i64));
        out.push(rowget(raw, src, 1i64));
        out.push(rowget(raw, src, 2i64));
        r = r + 1i64;
    }
    return out;
}
// duplicate every row (2x the rows)
fn dup_rows(raw: &Vec<i64>) -> Vec<i64> {
    let n: i64 = nrows_of(raw);
    let mut out: Vec<i64> = vec_new::<i64>();
    let mut r: i64 = 0i64;
    while r < n {
        out.push(rowget(raw, r, 0i64)); out.push(rowget(raw, r, 1i64)); out.push(rowget(raw, r, 2i64));
        out.push(rowget(raw, r, 0i64)); out.push(rowget(raw, r, 1i64)); out.push(rowget(raw, r, 2i64));
        r = r + 1i64;
    }
    return out;
}

// result multiset compare (nc cols): sort then cell compare
fn row_lt(cells: &Vec<i64>, nc: i64, i: i64, j: i64) -> bool {
    let mut c: i64 = 0i64;
    while c < nc {
        let x: i64 = cells.get(i * nc + c); let y: i64 = cells.get(j * nc + c);
        if x < y { return true; } if x > y { return false; }
        c = c + 1i64;
    }
    return false;
}
fn row_swap(cells: &mut Vec<i64>, nc: i64, i: i64, j: i64) {
    let mut c: i64 = 0i64;
    while c < nc {
        let t: i64 = cells.get(i * nc + c);
        cells.set(i * nc + c, cells.get(j * nc + c)); cells.set(j * nc + c, t);
        c = c + 1i64;
    }
}
fn rows_sort(cells: &mut Vec<i64>, nc: i64) {
    if nc <= 0i64 { return; }
    let nr: i64 = cells.len() / nc;
    let mut i: i64 = 0i64;
    while i < nr {
        let mut m: i64 = i; let mut j: i64 = i + 1i64;
        while j < nr { if row_lt(cells, nc, j, m) { m = j; } j = j + 1i64; }
        if m != i { row_swap(cells, nc, i, m); }
        i = i + 1i64;
    }
}
fn rows_eq(a: &mut Vec<i64>, b: &mut Vec<i64>, nc: i64) -> bool {
    if a.len() != b.len() { return false; }
    rows_sort(a, nc);
    rows_sort(b, nc);
    let mut i: i64 = 0i64;
    while i < a.len() { if a.get(i) != b.get(i) { return false; } i = i + 1i64; }
    return true;
}

// engine Writ builders
fn mkA(d: &Writ, x0: i64, x1: i64, x2: i64) -> WAny {
    let r: A = d.make::<A>(); r.a0 = x0; r.a1 = x1; r.a2 = x2;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn mkB(d: &Writ, x0: i64, x1: i64, x2: i64) -> WAny {
    let r: B = d.make::<B>(); r.b0 = x0; r.b1 = x1; r.b2 = x2;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn build_src(d: &Writ, raw: &Vec<i64>, is_a: bool) -> WAny {
    let n: i64 = nrows_of(raw);
    let arr: &mut WArray<WAny> = d.array(n + 1i64);
    let mut i: i64 = 0i64;
    while i < n {
        let c0: i64 = rowget(raw, i, 0i64); let c1: i64 = rowget(raw, i, 1i64); let c2: i64 = rowget(raw, i, 2i64);
        if is_a { arr.push(mkA(d, c0, c1, c2)); } else { arr.push(mkB(d, c0, c1, c2)); }
        i = i + 1i64;
    }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

// run one query form over given raw A/B data; returns flat cells or a 1-cell
// sentinel [-771..] on compile/run error so a one-sided error surfaces as a
// multiset disagreement (which the caller reports).
fn run_form(qt: str, c: &SchemaCatalog, av: &Vec<i64>, bv: &Vec<i64>, out_ok: &mut i64) -> Vec<i64> {
    let d: Writ = writ_new(8192i64);
    let asrc: WAny = build_src(&d, av, true);
    let bsrc: WAny = build_src(&d, bv, false);
    let mut env: QEnv = QEnv::new();
    env.bind_source("A", asrc);
    env.bind_source("B", bsrc);
    let mut out: Vec<i64> = vec_new::<i64>();
    match Query::compile(qt, c) {
        Result::Ok(q) => {
            match q.run(&env) {
                Result::Ok(r) => {
                    *out_ok = r.col_count();
                    let nr: i64 = r.row_count();
                    let ncol: i64 = r.col_count();
                    let mut i: i64 = 0i64;
                    while i < nr {
                        let mut cc: i64 = 0i64;
                        while cc < ncol { out.push(r.get_i64(i, cc)); cc = cc + 1i64; }
                        i = i + 1i64;
                    }
                }
                Result::Err(_e2) => { *out_ok = -2i64; }
            }
        }
        Result::Err(_e) => { *out_ok = -1i64; }
    }
    return out;
}

fn push_af(q: &mut String, var: str, i: i64) { q.push_str(var); q.push_str(".a"); q.push_i64(i); }
fn push_bf(q: &mut String, var: str, i: i64) { q.push_str(var); q.push_str(".b"); q.push_i64(i); }

fn main() -> i32 {
    let mut rng: Rng = Rng { s: 0x243F6A8885A308D3u64 };
    let c: SchemaCatalog = cat();

    let NITER: i64 = 6000i64;
    let MAXROWS: i64 = 10i64;

    let mut it: i64 = 0i64;
    while it < NITER {
        let tmpl: i64 = rng.upto(10i64);
        let VRANGE: i64 = rng.range(2i64, 6i64);   // tiny range → dup/collision heavy
        let na: i64 = rng.upto(MAXROWS);
        let av: Vec<i64> = gen_rows(&mut rng, na, VRANGE);
        let nb: i64 = rng.upto(MAXROWS);
        let bv: Vec<i64> = gen_rows(&mut rng, nb, VRANGE);

        // form1 / form2 query text + data
        let mut q1: String = String::new();
        let mut q2: String = String::new();
        let mut ncol: i64 = 1i64;

        // form2 data (defaults = form1 data; templates override)
        let mut a2: Vec<i64> = vec_new::<i64>();
        let mut b2: Vec<i64> = vec_new::<i64>();
        let mut r0: i64 = 0i64;
        while r0 < av.len() { a2.push(av.get(r0)); r0 = r0 + 1i64; }
        r0 = 0i64;
        while r0 < bv.len() { b2.push(bv.get(r0)); r0 = r0 + 1i64; }

        if tmpl == 0i64 {
            // FILTER permutation invariance
            let i: i64 = rng.upto(3i64); let op: i64 = rng.upto(6i64); let cc: i64 = rng.upto(VRANGE);
            let j: i64 = rng.upto(3i64); let k: i64 = rng.upto(3i64);
            ncol = 2i64;
            q1.push_str("from A x where "); push_af(&mut q1, "x", i);
            q1.push_str(" "); q1.push_str(op_str(op)); q1.push_str(" "); q1.push_i64(cc);
            q1.push_str(" select ("); push_af(&mut q1, "x", j); q1.push_str(", "); push_af(&mut q1, "x", k); q1.push_str(")");
            q2.push_str(q1.as_str());
            a2 = permute_rows(&mut rng, &av);
        } else if tmpl == 1i64 {
            // JOIN permutation invariance
            let i: i64 = rng.upto(3i64); let j: i64 = rng.upto(3i64);
            let k: i64 = rng.upto(3i64); let l: i64 = rng.upto(3i64);
            ncol = 2i64;
            q1.push_str("from A x join B y on "); push_af(&mut q1, "x", i); q1.push_str(" == "); push_bf(&mut q1, "y", j);
            q1.push_str(" select ("); push_af(&mut q1, "x", k); q1.push_str(", "); push_bf(&mut q1, "y", l); q1.push_str(")");
            q2.push_str(q1.as_str());
            a2 = permute_rows(&mut rng, &av);
            b2 = permute_rows(&mut rng, &bv);
        } else if tmpl == 2i64 {
            // GROUP sum permutation invariance
            let g: i64 = rng.upto(3i64); let v: i64 = rng.upto(3i64);
            ncol = 2i64;
            q1.push_str("from A x group by "); push_af(&mut q1, "x", g);
            q1.push_str(" aggregate s = sum("); push_af(&mut q1, "x", v); q1.push_str(") select (key, s)");
            q2.push_str(q1.as_str());
            a2 = permute_rows(&mut rng, &av);
        } else if tmpl == 3i64 {
            // DISTINCT dup-insensitivity
            let i: i64 = rng.upto(3i64);
            ncol = 1i64;
            q1.push_str("from A x select distinct "); push_af(&mut q1, "x", i);
            q2.push_str(q1.as_str());
            a2 = dup_rows(&av);
        } else if tmpl == 4i64 {
            // && commutativity
            let i: i64 = rng.upto(3i64); let op1: i64 = rng.upto(6i64); let c1: i64 = rng.upto(VRANGE);
            let j: i64 = rng.upto(3i64); let op2: i64 = rng.upto(6i64); let c2: i64 = rng.upto(VRANGE);
            let k: i64 = rng.upto(3i64);
            ncol = 1i64;
            q1.push_str("from A x where "); push_af(&mut q1, "x", i); q1.push_str(" "); q1.push_str(op_str(op1)); q1.push_str(" "); q1.push_i64(c1);
            q1.push_str(" && "); push_af(&mut q1, "x", j); q1.push_str(" "); q1.push_str(op_str(op2)); q1.push_str(" "); q1.push_i64(c2);
            q1.push_str(" select "); push_af(&mut q1, "x", k);
            q2.push_str("from A x where "); push_af(&mut q2, "x", j); q2.push_str(" "); q2.push_str(op_str(op2)); q2.push_str(" "); q2.push_i64(c2);
            q2.push_str(" && "); push_af(&mut q2, "x", i); q2.push_str(" "); q2.push_str(op_str(op1)); q2.push_str(" "); q2.push_i64(c1);
            q2.push_str(" select "); push_af(&mut q2, "x", k);
        } else if tmpl == 5i64 {
            // JOIN commutativity up to projection
            let i: i64 = rng.upto(3i64); let j: i64 = rng.upto(3i64);
            let k: i64 = rng.upto(3i64); let l: i64 = rng.upto(3i64);
            ncol = 2i64;
            q1.push_str("from A x join B y on "); push_af(&mut q1, "x", i); q1.push_str(" == "); push_bf(&mut q1, "y", j);
            q1.push_str(" select ("); push_af(&mut q1, "x", k); q1.push_str(", "); push_bf(&mut q1, "y", l); q1.push_str(")");
            q2.push_str("from B y join A x on "); push_bf(&mut q2, "y", j); q2.push_str(" == "); push_af(&mut q2, "x", i);
            q2.push_str(" select ("); push_af(&mut q2, "x", k); q2.push_str(", "); push_bf(&mut q2, "y", l); q2.push_str(")");
        } else if tmpl == 6i64 {
            // || commutativity
            let i: i64 = rng.upto(3i64); let op1: i64 = rng.upto(6i64); let c1: i64 = rng.upto(VRANGE);
            let j: i64 = rng.upto(3i64); let op2: i64 = rng.upto(6i64); let c2: i64 = rng.upto(VRANGE);
            let k: i64 = rng.upto(3i64);
            ncol = 1i64;
            q1.push_str("from A x where "); push_af(&mut q1, "x", i); q1.push_str(" "); q1.push_str(op_str(op1)); q1.push_str(" "); q1.push_i64(c1);
            q1.push_str(" || "); push_af(&mut q1, "x", j); q1.push_str(" "); q1.push_str(op_str(op2)); q1.push_str(" "); q1.push_i64(c2);
            q1.push_str(" select "); push_af(&mut q1, "x", k);
            q2.push_str("from A x where "); push_af(&mut q2, "x", j); q2.push_str(" "); q2.push_str(op_str(op2)); q2.push_str(" "); q2.push_i64(c2);
            q2.push_str(" || "); push_af(&mut q2, "x", i); q2.push_str(" "); q2.push_str(op_str(op1)); q2.push_str(" "); q2.push_i64(c1);
            q2.push_str(" select "); push_af(&mut q2, "x", k);
        } else if tmpl == 7i64 {
            // GROUP min/max permutation invariance
            let g: i64 = rng.upto(3i64); let v: i64 = rng.upto(3i64);
            ncol = 3i64;
            q1.push_str("from A x group by "); push_af(&mut q1, "x", g);
            q1.push_str(" aggregate lo = min("); push_af(&mut q1, "x", v); q1.push_str("), hi = max("); push_af(&mut q1, "x", v);
            q1.push_str(") select (key, lo, hi)");
            q2.push_str(q1.as_str());
            a2 = permute_rows(&mut rng, &av);
        } else if tmpl == 8i64 {
            // DISTINCT idempotence under permute+dup
            let i: i64 = rng.upto(3i64);
            ncol = 1i64;
            q1.push_str("from A x select distinct "); push_af(&mut q1, "x", i);
            q2.push_str(q1.as_str());
            let dd: Vec<i64> = dup_rows(&av);
            a2 = permute_rows(&mut rng, &dd);
        } else {
            // ANTI join permutation invariance
            let i: i64 = rng.upto(3i64); let j: i64 = rng.upto(3i64); let k: i64 = rng.upto(3i64);
            ncol = 1i64;
            q1.push_str("from A x anti join B y on "); push_af(&mut q1, "x", i); q1.push_str(" == "); push_bf(&mut q1, "y", j);
            q1.push_str(" select "); push_af(&mut q1, "x", k);
            q2.push_str(q1.as_str());
            a2 = permute_rows(&mut rng, &av);
            b2 = permute_rows(&mut rng, &bv);
        }

        let mut ok1: i64 = 0i64;
        let mut got1: Vec<i64> = run_form(q1.as_str(), &c, &av, &bv, &mut ok1);
        if ok1 == -1i64 { return 100i32 + (tmpl as i32); }
        if ok1 == -2i64 { return 130i32 + (tmpl as i32); }

        let mut ok2: i64 = 0i64;
        let mut got2: Vec<i64> = run_form(q2.as_str(), &c, &a2, &b2, &mut ok2);
        if ok2 == -1i64 { return 100i32 + (tmpl as i32); }
        if ok2 == -2i64 { return 130i32 + (tmpl as i32); }

        if ok1 != ok2 { return 60i32 + (tmpl as i32); }
        if ok1 != ncol { return 60i32 + (tmpl as i32); }

        if !rows_eq(&mut got1, &mut got2, ncol) { return 40i32 + (tmpl as i32); }

        it = it + 1i64;
    }
    return 0i32;
}
