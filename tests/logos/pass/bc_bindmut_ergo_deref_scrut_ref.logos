package bc_bindmut_ergo_deref_scrut_ref;
fn get(o: &Option<i64>) -> i64 {
    match *o {
        Option::Some(ref n) => { return *n; },
        Option::None => { return 0i64; }
    }
}
fn main() -> i32 {
    let o: Option<i64> = Option::Some(3i64);
    if get(&o) != 3i64 { return 1i32; }
    return 0i32;
}
