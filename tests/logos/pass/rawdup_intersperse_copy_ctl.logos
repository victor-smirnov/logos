// CONTROL twin of rawdup_intersperse_drop_once: a Copy payload still answers correctly.
//
// #112 — the `*((&x) as *const T)` duplicate-owner class.

package rawdup_intersperse_copy_ctl;

use logos.std.fmt;
use logos.lang.option;
use logos.lang.iter;
use logos.mem.collections.vec;
use logos.lang.clone;

fn main() -> i32 {
    let mut s: Vec<i64> = vec_new::<i64>();
    s.push(1i64); s.push(2i64);
    let it: IntersperseIter<VecIntoIter<i64>, i64> =
        iter_intersperse::<VecIntoIter<i64>, i64>(s.into_iter(), 8i64, 0i64);
    println!("count={}", it.count());
    return 0i32;
}
