// A narrowing bound may be a query PARAMETER, not only a literal (ADR 0024 S4).
//
// ⚠ WHY THIS WAS MISSING, because the shape recurs. `plan_narrow_rel` demanded a
// literal, under a comment that said "a narrowing needs the VALUE, not just the
// shape". It does not. A declared operation takes the bound as an ARGUMENT, and
// an argument may be a parameter exactly where a constant would be — `lo` is in
// scope in the generated fn. So `where e.key >= lo` scanned the entire container
// for no reason but that assumption, and every parameterised range query paid it.
//
// This is also the first piece of the dynamic-planning direction, and it is the
// piece that needs no dynamism at all: the bound does not have to be KNOWN to be
// passed. What still needs runtime facts is CHOOSING between the scan and the
// narrowing — that is a separate decision and a separate slice.
//
// ORACLE: the pull count. Both plans return the same rows; only how far the
// source was read says which one ran.
package test;

use logos.std.wql.wql;
use logos.mem.bt.map;
use logos.mem.collections.vec;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.result;

static mut PULLED: i64 = 0i64;

pub struct Steps { pub n: i64 }
pub struct StepsIter { pub n: i64, pub i: i64 }

impl Iterator<(i64, i64)> for StepsIter {
    fn next(self: &mut StepsIter) -> Option<(i64, i64)> {
        if self.i >= self.n { return Option::None; }
        unsafe { PULLED = PULLED + 1i64; }
        let v: (i64, i64) = (self.i, self.i * 10i64);
        self.i = self.i + 1i64;
        return Option::Some(v);
    }
}

pub fn steps_rows(s: &Steps) -> StepsIter { return StepsIter { n: s.n, i: 0i64 }; }
pub fn steps_from(s: &Steps, lo: i64) -> StepsIter {
    let start: i64 = if lo < 0i64 { 0i64 } else { lo };
    return StepsIter { n: s.n, i: start };
}

impl OrderedMapSource<i64, i64> for Steps {
    rel entry = steps_rows;
    op entry.key ge = steps_from  exact;
}

// The bound is a PARAMETER. Nothing about it is known at expansion time.
pub deem tail(s: &Steps, lo: i64) {
    from s e where e.key >= lo select (e.key, e.val)
}

// The literal form, unchanged — kept beside it so a regression on either shows.
pub deem tail_lit(s: &Steps) {
    from s e where e.key >= 190 select (e.key, e.val)
}

// ⚠ A parameter whose type is NOT the column's cannot be passed by name, and the
// plan must say so and scan rather than emit a bad call into generated code.
pub deem tail_wide(s: &Steps, lo: i32) {
    from s e where e.key >= 190 select (e.key, e.val)
}

fn main() -> i32 {
    let s: Steps = Steps { n: 200i64 };

    unsafe { PULLED = 0i64; }
    let a: Vec<(i64, i64)> = match tail(&s, 190i64)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    if a.len() != 10i64 { return 2i32; }
    if a.get(0i64).0 != 190i64 || a.get(9i64).1 != 1990i64 { return 3i32; }
    // Landed at 190 and walked ten rows plus the one that reports exhaustion.
    // A scan would be 201.
    unsafe { if PULLED > 11i64 { return 4i32; } }

    // The SAME compiled fn, a different bound — the argument is passed, not baked.
    unsafe { PULLED = 0i64; }
    let b: Vec<(i64, i64)> = match tail(&s, 198i64)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 5i32; } };
    if b.len() != 2i64 { return 6i32; }
    if b.get(0i64).0 != 198i64 { return 7i32; }
    unsafe { if PULLED > 3i64 { return 8i32; } }

    unsafe { PULLED = 0i64; }
    let c: Vec<(i64, i64)> = match tail_lit(&s)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 9i32; } };
    if c.len() != 10i64 { return 10i32; }
    unsafe { if PULLED > 11i64 { return 11i32; } }

    // The mismatched parameter is unused by the filter, so the LITERAL still
    // narrows; the point is that the compile succeeds rather than emitting a
    // call the host compiler would reject.
    let d: Vec<(i64, i64)> = match tail_wide(&s, 1i32)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 12i32; } };
    if d.len() != 10i64 { return 13i32; }
    return 0i32;
}
