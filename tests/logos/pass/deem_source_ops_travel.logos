// A source's declared operations REACH the planner (ADR 0024 S6.2).
//
// The planner is Deem's — Canon builds containers from their declarative specs
// and supplies facts about them — so what a source says about itself has to
// TRAVEL rather than be read where it was collected. natspec is that channel:
// it already carried the relation's columns, and now carries the operation set
// alongside them, `{col cmp fn x,…}`, x being `e` for exact-on-that-comparison
// and `s` for a superset.
//
// The query below runs over a source that declares three operations. What it
// proves is the round trip: the section is emitted, parsed and registered, and
// the ordinary path is unaffected by its presence. A malformed section would
// derail the scanner and this query would not compile at all.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.result;

pub trait Rows<K, V> { rel item(k: K, v: V); }

struct Led { pub xs: Vec<(i64, i64)> }

pub fn led_all(l: &Led) -> Vec<(i64, i64)> {
    let mut out: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut i: i64 = 0i64;
    while i < l.xs.len() { out.push(l.xs.get(i)); i = i + 1i64; }
    return out;
}
pub fn led_at(l: &Led)   -> Vec<(i64, i64)> { return led_all(l); }
pub fn led_from(l: &Led) -> Vec<(i64, i64)> { return led_all(l); }

impl Rows<i64, i64> for Led {
    rel item = led_all;
    op item.k eq = led_at    exact;
    op item.k ge = led_from  exact;
}

pub deem big(l: &Led) { from l e where e.v > 20 select (e.k, e.v) }

fn main() -> i32 {
    let mut xs: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    xs.push((1i64, 10i64));
    xs.push((2i64, 30i64));
    xs.push((3i64, 50i64));
    let led: Led = Led { xs: xs };
    let got: Vec<(i64, i64)> = match big(&led)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    if got.len() != 2i64        { return 2i32; }
    if got.get(0i64).0 != 2i64  { return 3i32; }
    if got.get(1i64).1 != 50i64 { return 4i32; }
    return 0i32;
}
