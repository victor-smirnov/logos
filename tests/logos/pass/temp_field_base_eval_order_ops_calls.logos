// A droppable temporary field base is built where its read is evaluated: after the operands before it (rustc 1.98.1).
package temp_field_base_eval_order_ops_calls;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, s: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.s = *self.s * 10i64 + self.v + 4i64; } } }
fn mk(v: i64, s: *mut i64) -> D { unsafe { *s = *s * 10i64 + v; } return D { v: v, s: s }; }
fn side(v: i64, s: *mut i64) -> i64 { unsafe { *s = *s * 10i64 + v; } return v; }
fn two(a: i64, b: i64) -> i64 { return a * 10i64 + b; }
fn main() -> i32 {
    let mut q: i64 = 0i64; let s: *mut i64 = &mut q;
    let a = side(1i64, s) + mk(2i64, s).v;
    let r1 = q; q = 0i64;
    let b = two(side(1i64, s), mk(2i64, s).v);
    let r2 = q; q = 0i64;
    let c = mk(1i64, s).v + mk(2i64, s).v;
    let r3 = q; q = 0i64;
    let d = two(mk(3i64, s).v, side(1i64, s)) + side(2i64, s);
    let r4 = q;
    unsafe { printf("%lld %lld %lld %lld %lld %lld %lld %lld\n".as_ptr(), a, r1, b, r2, c, r3, d, r4); }
    return 0i32;
}
