// query_diff_str_adv — DIFFERENTIAL fuzzer for the Deem query engine focused on
// the STRING-COLUMN dimension. A deterministic LCG generates, each iteration, a
// random VALID query over two str-bearing schema sources A/B (a `str` column `s`
// plus an i64 column `n`) and runs it two independent ways, asserting agreement:
//
//   • ENGINE — the query TEXT built at runtime and run through Query::compile /
//              Query::run (queue-2 interpreter);
//   • NAIVE  — a brute-force evaluator hand-written here with its OWN byte-wise
//              str compare (str_cmp/str_eq), sharing ZERO code with the engine.
//
// Strings are drawn from a tiny pool that DELIBERATELY includes the empty string,
// a prefix chain ("a"/"aa"/"aaa"), case variants ("B" byte 66 vs "a" byte 97 to
// probe byte-order vs case-order), and duplicates — to force key collisions,
// empty-string keys, prefix-ordering boundaries, and interning/arena reuse.
//
// Templates cover str in: projection, ==/!=/< in where (vs literal), equi-join
// on str key, anti-join on str key, group-by str key (count), distinct, and
// order-by str key (ORDER-sensitive check). Exit 0 iff every iteration agrees;
// a nonzero code names the failing template.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema A : code(0x0DF5_0000_0000_0001) { s: str = 0, n: i64 = 1 }
pub schema B : code(0x0DF5_0000_0000_0002) { s: str = 0, n: i64 = 1 }
resource cat = schema_catalog!{ A, B };

// ── deterministic RNG (Knuth MMIX LCG; wrapping — plain */+ trap on overflow) ──
struct Rng { s: u64 }
impl Rng {
    fn next(self: &mut Rng) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
    fn upto(self: &mut Rng, n: i64) -> i64 { return (self.next() % (n as u64)) as i64; }
    fn range(self: &mut Rng, lo: i64, hi: i64) -> i64 { return lo + self.upto(hi - lo); }
}

// ── string pool (static literals stay live for the engine's borrowed keys) ────
// Chosen to force: empty key, prefix chain, case-vs-byte ordering, duplicates.
fn pool(i: i64) -> str {
    if i == 0i64 { return ""; }
    if i == 1i64 { return "a"; }
    if i == 2i64 { return "aa"; }
    if i == 3i64 { return "aaa"; }
    if i == 4i64 { return "b"; }
    if i == 5i64 { return "B"; }     // byte 66 < 'a' (97): case flips byte order
    if i == 6i64 { return "ab"; }
    return "ba";
}
fn POOLN() -> i64 { return 8i64; }

// ── naive-side str compare wrappers (independent of the engine) ───────────────
fn s_lt(a: str, b: str) -> bool { return str_cmp(a, b) < 0i32; }

// ── i64 multiset (width nc, row-major) ────────────────────────────────────────
fn row_lt(cells: &Vec<i64>, nc: i64, i: i64, j: i64) -> bool {
    let mut c: i64 = 0i64;
    while c < nc {
        let x: i64 = cells.get(i * nc + c); let y: i64 = cells.get(j * nc + c);
        if x < y { return true; } if x > y { return false; }
        c = c + 1i64;
    }
    return false;
}
fn row_swap(cells: &mut Vec<i64>, nc: i64, i: i64, j: i64) {
    let mut c: i64 = 0i64;
    while c < nc {
        let t: i64 = cells.get(i * nc + c);
        cells.set(i * nc + c, cells.get(j * nc + c)); cells.set(j * nc + c, t);
        c = c + 1i64;
    }
}
fn rows_sort(cells: &mut Vec<i64>, nc: i64) {
    if nc <= 0i64 { return; }
    let nr: i64 = cells.len() / nc;
    let mut i: i64 = 0i64;
    while i < nr {
        let mut m: i64 = i; let mut j: i64 = i + 1i64;
        while j < nr { if row_lt(cells, nc, j, m) { m = j; } j = j + 1i64; }
        if m != i { row_swap(cells, nc, i, m); }
        i = i + 1i64;
    }
}
fn i64ms_eq(a: &mut Vec<i64>, b: &mut Vec<i64>, nc: i64) -> bool {
    if a.len() != b.len() { return false; }
    rows_sort(a, nc); rows_sort(b, nc);
    let mut i: i64 = 0i64;
    while i < a.len() { if a.get(i) != b.get(i) { return false; } i = i + 1i64; }
    return true;
}

// ── str multiset (Vec<str>) — sort by byte-wise str_cmp, then compare ─────────
fn strv_sort(v: &mut Vec<str>) {
    let n: i64 = v.len();
    let mut i: i64 = 0i64;
    while i < n {
        let mut m: i64 = i; let mut j: i64 = i + 1i64;
        while j < n { if str_cmp(v.get(j), v.get(m)) < 0i32 { m = j; } j = j + 1i64; }
        if m != i { let t: str = v.get(i); v.set(i, v.get(m)); v.set(m, t); }
        i = i + 1i64;
    }
}
fn strv_ms_eq(a: &mut Vec<str>, b: &mut Vec<str>) -> bool {
    if a.len() != b.len() { return false; }
    strv_sort(a); strv_sort(b);
    let mut i: i64 = 0i64;
    while i < a.len() { if !str_eq(a.get(i), b.get(i)) { return false; } i = i + 1i64; }
    return true;
}
// ORDER-sensitive str equality (for order-by): compare element-wise, no sort.
fn strv_seq_eq(a: &Vec<str>, b: &Vec<str>) -> bool {
    if a.len() != b.len() { return false; }
    let mut i: i64 = 0i64;
    while i < a.len() { if !str_eq(a.get(i), b.get(i)) { return false; } i = i + 1i64; }
    return true;
}

// ── (str,i64) pair multiset — group-by(str key) results ───────────────────────
fn pair_lt(ka: str, na: i64, kb: str, nb: i64) -> bool {
    let c: i32 = str_cmp(ka, kb);
    if c < 0i32 { return true; }
    if c > 0i32 { return false; }
    return na < nb;
}
fn pair_ms_eq(ak: &mut Vec<str>, an: &mut Vec<i64>, bk: &mut Vec<str>, bn: &mut Vec<i64>) -> bool {
    if ak.len() != bk.len() { return false; }
    // selection sort both parallel arrays
    let na: i64 = ak.len();
    let mut i: i64 = 0i64;
    while i < na {
        let mut m: i64 = i; let mut j: i64 = i + 1i64;
        while j < na { if pair_lt(ak.get(j), an.get(j), ak.get(m), an.get(m)) { m = j; } j = j + 1i64; }
        if m != i {
            let ts: str = ak.get(i); ak.set(i, ak.get(m)); ak.set(m, ts);
            let ti: i64 = an.get(i); an.set(i, an.get(m)); an.set(m, ti);
        }
        i = i + 1i64;
    }
    let nb: i64 = bk.len();
    let mut i2: i64 = 0i64;
    while i2 < nb {
        let mut m2: i64 = i2; let mut j2: i64 = i2 + 1i64;
        while j2 < nb { if pair_lt(bk.get(j2), bn.get(j2), bk.get(m2), bn.get(m2)) { m2 = j2; } j2 = j2 + 1i64; }
        if m2 != i2 {
            let ts2: str = bk.get(i2); bk.set(i2, bk.get(m2)); bk.set(m2, ts2);
            let ti2: i64 = bn.get(i2); bn.set(i2, bn.get(m2)); bn.set(m2, ti2);
        }
        i2 = i2 + 1i64;
    }
    let mut k: i64 = 0i64;
    while k < ak.len() {
        if !str_eq(ak.get(k), bk.get(k)) { return false; }
        if an.get(k) != bn.get(k) { return false; }
        k = k + 1i64;
    }
    return true;
}

// ── engine-side Writ builders ─────────────────────────────────────────────────
fn mkA(d: &Writ, s: str, n: i64) -> WAny {
    let r: A = d.make::<A>(); r.s = s; r.n = n;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn mkB(d: &Writ, s: str, n: i64) -> WAny {
    let r: B = d.make::<B>(); r.s = s; r.n = n;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn build_src(d: &Writ, sidx: &Vec<i64>, nval: &Vec<i64>, is_a: bool) -> WAny {
    let n: i64 = sidx.len();
    let arr: &mut WArray<WAny> = d.array(n + 1i64);
    let mut i: i64 = 0i64;
    while i < n {
        let sv: str = pool(sidx.get(i));
        let nn: i64 = nval.get(i);
        if is_a { arr.push(mkA(d, sv, nn)); } else { arr.push(mkB(d, sv, nn)); }
        i = i + 1i64;
    }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

fn contains_i64(v: &Vec<i64>, x: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < v.len() { if v.get(i) == x { return true; } i = i + 1i64; }
    return false;
}
fn contains_str(v: &Vec<str>, x: str) -> bool {
    let mut i: i64 = 0i64;
    while i < v.len() { if str_eq(v.get(i), x) { return true; } i = i + 1i64; }
    return false;
}

fn emit_lit(q: &mut String, li: i64) {
    q.push_str("\""); q.push_str(pool(li)); q.push_str("\"");
}

fn main() -> i32 {
    let mut rng: Rng = Rng { s: 0x1D872B41A0FEC93Bu64 };
    let c: SchemaCatalog = cat();

    let NITER: i64 = 4000i64;
    let MAXROWS: i64 = 7i64;             // includes 0 (empty source)

    let mut it: i64 = 0i64;
    while it < NITER {
        let tmpl: i64 = rng.upto(9i64);
        // narrow pool span per iteration to force collisions/dups/empties
        let span: i64 = rng.range(2i64, POOLN() + 1i64);   // use pool[0..span)
        let na: i64 = rng.upto(MAXROWS);
        let nb: i64 = rng.upto(MAXROWS);

        let mut asi: Vec<i64> = vec_new::<i64>();
        let mut ani: Vec<i64> = vec_new::<i64>();
        let mut r0: i64 = 0i64;
        while r0 < na { asi.push(rng.upto(span)); ani.push(rng.range(0i64, 5i64)); r0 = r0 + 1i64; }
        let mut bsi: Vec<i64> = vec_new::<i64>();
        let mut bni: Vec<i64> = vec_new::<i64>();
        let mut r1: i64 = 0i64;
        while r1 < nb { bsi.push(rng.upto(span)); bni.push(rng.range(0i64, 5i64)); r1 = r1 + 1i64; }

        let d: Writ = writ_new(16384i64);
        let asrc: WAny = build_src(&d, &asi, &ani, true);
        let bsrc: WAny = build_src(&d, &bsi, &bni, false);
        let mut env: QEnv = QEnv::new();
        env.bind_source("A", asrc);
        env.bind_source("B", bsrc);

        let mut qt: String = String::new();

        if tmpl == 0i64 {
            // STR PROJECTION: from A x select x.s  (Vec<str> multiset)
            qt.push_str("from A x select x.s");
            let mut want: Vec<str> = vec_new::<str>();
            let mut r: i64 = 0i64;
            while r < na { want.push(pool(asi.get(r))); r = r + 1i64; }
            let q: Query = match Query::compile(qt.as_str(), &c) { Result::Ok(v) => { v } Result::Err(_e) => { return 20i32; } };
            let rows: QRows = match q.run(&env) { Result::Ok(v) => { v } Result::Err(_e2) => { return 30i32; } };
            if rows.col_count() != 1i64 { return 60i32; }
            let mut got: Vec<str> = vec_new::<str>();
            let mut i: i64 = 0i64;
            while i < rows.row_count() { got.push(rows.get_str(i, 0i64)); i = i + 1i64; }
            if !strv_ms_eq(&mut want, &mut got) { return 40i32; }

        } else if tmpl == 1i64 {
            // STR WHERE ==: from A x where x.s == "LIT" select x.n
            let li: i64 = rng.upto(span);
            qt.push_str("from A x where x.s == "); emit_lit(&mut qt, li); qt.push_str(" select x.n");
            let mut want: Vec<i64> = vec_new::<i64>();
            let mut r: i64 = 0i64;
            while r < na { if str_eq(pool(asi.get(r)), pool(li)) { want.push(ani.get(r)); } r = r + 1i64; }
            let q: Query = match Query::compile(qt.as_str(), &c) { Result::Ok(v) => { v } Result::Err(_e) => { return 21i32; } };
            let rows: QRows = match q.run(&env) { Result::Ok(v) => { v } Result::Err(_e2) => { return 31i32; } };
            let mut got: Vec<i64> = vec_new::<i64>();
            let mut i: i64 = 0i64;
            while i < rows.row_count() { got.push(rows.get_i64(i, 0i64)); i = i + 1i64; }
            if !i64ms_eq(&mut want, &mut got, 1i64) { return 41i32; }

        } else if tmpl == 2i64 {
            // STR WHERE !=: from A x where x.s != "LIT" select x.n
            let li: i64 = rng.upto(span);
            qt.push_str("from A x where x.s != "); emit_lit(&mut qt, li); qt.push_str(" select x.n");
            let mut want: Vec<i64> = vec_new::<i64>();
            let mut r: i64 = 0i64;
            while r < na { if !str_eq(pool(asi.get(r)), pool(li)) { want.push(ani.get(r)); } r = r + 1i64; }
            let q: Query = match Query::compile(qt.as_str(), &c) { Result::Ok(v) => { v } Result::Err(_e) => { return 22i32; } };
            let rows: QRows = match q.run(&env) { Result::Ok(v) => { v } Result::Err(_e2) => { return 32i32; } };
            let mut got: Vec<i64> = vec_new::<i64>();
            let mut i: i64 = 0i64;
            while i < rows.row_count() { got.push(rows.get_i64(i, 0i64)); i = i + 1i64; }
            if !i64ms_eq(&mut want, &mut got, 1i64) { return 42i32; }

        } else if tmpl == 3i64 {
            // STR WHERE <: from A x where x.s < "LIT" select x.n
            let li: i64 = rng.upto(span);
            qt.push_str("from A x where x.s < "); emit_lit(&mut qt, li); qt.push_str(" select x.n");
            let mut want: Vec<i64> = vec_new::<i64>();
            let mut r: i64 = 0i64;
            while r < na { if s_lt(pool(asi.get(r)), pool(li)) { want.push(ani.get(r)); } r = r + 1i64; }
            let q: Query = match Query::compile(qt.as_str(), &c) { Result::Ok(v) => { v } Result::Err(_e) => { return 23i32; } };
            let rows: QRows = match q.run(&env) { Result::Ok(v) => { v } Result::Err(_e2) => { return 33i32; } };
            let mut got: Vec<i64> = vec_new::<i64>();
            let mut i: i64 = 0i64;
            while i < rows.row_count() { got.push(rows.get_i64(i, 0i64)); i = i + 1i64; }
            if !i64ms_eq(&mut want, &mut got, 1i64) { return 43i32; }

        } else if tmpl == 4i64 {
            // STR EQUI-JOIN: from A x join B y on x.s == y.s select (x.n, y.n)
            qt.push_str("from A x join B y on x.s == y.s select (x.n, y.n)");
            let mut want: Vec<i64> = vec_new::<i64>();
            let mut ra: i64 = 0i64;
            while ra < na {
                let mut rb: i64 = 0i64;
                while rb < nb {
                    if str_eq(pool(asi.get(ra)), pool(bsi.get(rb))) { want.push(ani.get(ra)); want.push(bni.get(rb)); }
                    rb = rb + 1i64;
                }
                ra = ra + 1i64;
            }
            let q: Query = match Query::compile(qt.as_str(), &c) { Result::Ok(v) => { v } Result::Err(_e) => { return 24i32; } };
            let rows: QRows = match q.run(&env) { Result::Ok(v) => { v } Result::Err(_e2) => { return 34i32; } };
            if rows.col_count() != 2i64 { return 64i32; }
            let mut got: Vec<i64> = vec_new::<i64>();
            let mut i: i64 = 0i64;
            while i < rows.row_count() { got.push(rows.get_i64(i, 0i64)); got.push(rows.get_i64(i, 1i64)); i = i + 1i64; }
            if !i64ms_eq(&mut want, &mut got, 2i64) { return 44i32; }

        } else if tmpl == 5i64 {
            // STR ANTI-JOIN: from A x anti join B y on x.s == y.s select x.n
            qt.push_str("from A x anti join B y on x.s == y.s select x.n");
            let mut want: Vec<i64> = vec_new::<i64>();
            let mut ra: i64 = 0i64;
            while ra < na {
                let mut hit: bool = false;
                let mut rb: i64 = 0i64;
                while rb < nb { if str_eq(pool(asi.get(ra)), pool(bsi.get(rb))) { hit = true; } rb = rb + 1i64; }
                if !hit { want.push(ani.get(ra)); }
                ra = ra + 1i64;
            }
            let q: Query = match Query::compile(qt.as_str(), &c) { Result::Ok(v) => { v } Result::Err(_e) => { return 25i32; } };
            let rows: QRows = match q.run(&env) { Result::Ok(v) => { v } Result::Err(_e2) => { return 35i32; } };
            let mut got: Vec<i64> = vec_new::<i64>();
            let mut i: i64 = 0i64;
            while i < rows.row_count() { got.push(rows.get_i64(i, 0i64)); i = i + 1i64; }
            if !i64ms_eq(&mut want, &mut got, 1i64) { return 45i32; }

        } else if tmpl == 6i64 {
            // GROUP BY str key: from A x group by x.s aggregate c=count() select (key, c)
            qt.push_str("from A x group by x.s aggregate c = count() select (key, c)");
            let mut keys: Vec<str> = vec_new::<str>();
            let mut r: i64 = 0i64;
            while r < na { let k: str = pool(asi.get(r)); if !contains_str(&keys, k) { keys.push(k); } r = r + 1i64; }
            let mut wk: Vec<str> = vec_new::<str>();
            let mut wc: Vec<i64> = vec_new::<i64>();
            let mut ki: i64 = 0i64;
            while ki < keys.len() {
                let k: str = keys.get(ki); let mut cnt: i64 = 0i64;
                let mut r2: i64 = 0i64;
                while r2 < na { if str_eq(pool(asi.get(r2)), k) { cnt = cnt + 1i64; } r2 = r2 + 1i64; }
                wk.push(k); wc.push(cnt);
                ki = ki + 1i64;
            }
            let q: Query = match Query::compile(qt.as_str(), &c) { Result::Ok(v) => { v } Result::Err(_e) => { return 26i32; } };
            let rows: QRows = match q.run(&env) { Result::Ok(v) => { v } Result::Err(_e2) => { return 36i32; } };
            if rows.col_count() != 2i64 { return 66i32; }
            let mut gk: Vec<str> = vec_new::<str>();
            let mut gc: Vec<i64> = vec_new::<i64>();
            let mut i: i64 = 0i64;
            while i < rows.row_count() { gk.push(rows.get_str(i, 0i64)); gc.push(rows.get_i64(i, 1i64)); i = i + 1i64; }
            if !pair_ms_eq(&mut wk, &mut wc, &mut gk, &mut gc) { return 46i32; }

        } else if tmpl == 7i64 {
            // DISTINCT str: from A x select distinct x.s
            qt.push_str("from A x select distinct x.s");
            let mut want: Vec<str> = vec_new::<str>();
            let mut r: i64 = 0i64;
            while r < na { let k: str = pool(asi.get(r)); if !contains_str(&want, k) { want.push(k); } r = r + 1i64; }
            let q: Query = match Query::compile(qt.as_str(), &c) { Result::Ok(v) => { v } Result::Err(_e) => { return 27i32; } };
            let rows: QRows = match q.run(&env) { Result::Ok(v) => { v } Result::Err(_e2) => { return 37i32; } };
            let mut got: Vec<str> = vec_new::<str>();
            let mut i: i64 = 0i64;
            while i < rows.row_count() { got.push(rows.get_str(i, 0i64)); i = i + 1i64; }
            if !strv_ms_eq(&mut want, &mut got) { return 47i32; }

        } else {
            // ORDER BY str (ORDER-sensitive): from A x select x.s order by x.s
            qt.push_str("from A x select x.s order by x.s");
            // naive: collect then byte-lexicographic stable sort
            let mut want: Vec<str> = vec_new::<str>();
            let mut r: i64 = 0i64;
            while r < na { want.push(pool(asi.get(r))); r = r + 1i64; }
            strv_sort(&mut want);
            let q: Query = match Query::compile(qt.as_str(), &c) { Result::Ok(v) => { v } Result::Err(_e) => { return 28i32; } };
            let rows: QRows = match q.run(&env) { Result::Ok(v) => { v } Result::Err(_e2) => { return 38i32; } };
            let mut got: Vec<str> = vec_new::<str>();
            let mut i: i64 = 0i64;
            while i < rows.row_count() { got.push(rows.get_str(i, 0i64)); i = i + 1i64; }
            if !strv_seq_eq(&want, &got) { return 48i32; }
        }

        it = it + 1i64;
    }
    return 0i32;
}
