// pass — Box<T> smoke test.
package test;

use logos.mem.boxed;

fn main() -> i32 {
    unsafe {
        // ── i32 ──────────────────────────────────────────────────────────────
        let mut b: Box<i32> = box_new::<i32>(42);
        let p: *const i32 = Box::as_ptr(&b);
        if *p != 42 { return 1; }

        let pm: *mut i32 = Box::as_mut_ptr(&mut b);
        *pm = 99;
        if *Box::as_ptr(&b) != 99 { return 2; }


        // ── i64 — larger type ────────────────────────────────────────────────
        let mut b64: Box<i64> = box_new::<i64>(1234567890 as i64);
        if *Box::as_ptr(&b64) != 1234567890 as i64 { return 3; }
        *Box::as_mut_ptr(&mut b64) = 0 as i64;
        if *Box::as_ptr(&b64) != 0 as i64 { return 4; }
    }
    return 42;
}
