// PARAM slot encoding roundtrip (successor of the Hermes1 embed_param test):
// the capture placeholder is an inline Pod, word = (value_index<<8)|(127<<1)|1.
package hermes_param_roundtrip;
use logos.lang.hermes.anyval;

fn embed_param(idx: u32) -> HAny {
    return HAny::Pod((((idx as u64) << 8u64) | 0xFFu64));
}
fn is_param(v: HAny) -> bool {
    return v.is_pod() && v.pod_code() == 127 as u8;
}
fn param_index(v: HAny) -> u32 {
    return ((v.raw() as u64) >> 8u64) as u32;
}

unsafe fn main() -> i32 {
    let p0: HAny = embed_param(0 as u32);
    if !is_param(p0) { return 1; }
    if param_index(p0) != 0 as u32 { return 2; }

    let p42: HAny = embed_param(42 as u32);
    if !is_param(p42) { return 3; }
    if param_index(p42) != 42 as u32 { return 4; }

    // Params are NOT ints/bools/nulls — the code is reserved.
    if p42.is_int()  { return 5; }
    if p42.is_bool() { return 6; }
    if p42.is_null() { return 7; }

    // Max 24-bit index survives.
    let pmax: HAny = embed_param(16777215 as u32);
    if param_index(pmax) != 16777215 as u32 { return 8; }
    return 0;
}
