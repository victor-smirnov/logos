package for_u8_lo_i64;
// for i in lo..hi where lo: u8 = 200, hi: i64 = 205
// loop_type = i64 (hi is i64); coerce_int(i8(-56), i64) via ExtSIOp
// gave i64(-56) instead of i64(200) → wrong start value
unsafe fn main() -> i32 {
    let lo: u8 = 200;
    let hi: i64 = 205;
    let mut count: i32 = 0;
    for i in lo..hi {
        count = count + 1;
    }
    if count == 5 { return 0; }
    return 1;
}
