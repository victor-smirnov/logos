// Decimal -> f64 conversion on hermes2: zero, integers, fractions, negatives,
// deep scales, wide coefficients.
package hermes_decimal_f64;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.decimal;
use logos.lang.rc;

unsafe fn close(a: f64, b: f64) -> bool {
    let d: f64 = if a > b { a - b } else { b - a };
    return d < 0.0000001;
}

unsafe fn main() -> i32 {
    let rc: Rc<Hermes> = hermes_rc(8192);
    let h: &Hermes = rc.deref();

    if hdec_from_str(h, "0.00").as_decimal().to_f64() != 0.0 { return 1; }
    if hdec_from_str(h, "42").as_decimal().to_f64() != 42.0 { return 2; }
    if !close(hdec_from_str(h, "123.45").as_decimal().to_f64(), 123.45) { return 3; }
    if !close(hdec_from_str(h, "-0.5").as_decimal().to_f64(), -0.5) { return 4; }
    if !close(hdec_from_str(h, "0.0001").as_decimal().to_f64(), 0.0001) { return 5; }
    if !close(hdec_from_str(h, "9000000000").as_decimal().to_f64(), 9000000000.0) { return 6; }
    if !close(hdec_from_str(h, "-123456.789").as_decimal().to_f64(), -123456.789) { return 7; }

    return 0;
}
