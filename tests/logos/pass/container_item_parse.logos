// ADR 0020 wave-0 — item-pipeline fixture: both canonical `container`
// declarations parse, sema-register, and round through the token-macro item
// seam to `__container_item`, whose fact-mirror shape gate must stay silent
// (an error() there fails this compile). The backing types (VecCtr/MapCtr)
// are intentionally undeclared — nothing resolves them before the emission
// path (M4), which pins the parse+facts-only contract for wave-0 Map.
package test;

use logos.std.canon.container_item;

pub container Vector<T> for VecCtr<T> { kind vector; entry { elem: T } measure count; }

pub container Map<K, V> for MapCtr<K, V> { kind ordered_map; entry { key: K, val: V } measure count; measure max(key); }

fn main() -> i32 {
    return 0i32;
}
