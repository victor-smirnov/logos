// HBS round-trip test: serialize a Hermes document to HBS binary and
// deserialize into a fresh container; verify that stringify output matches.
package hermes_hbs;
use std.hermes.ctr;
use std.lang.text;

extern fn write(fd: i32, buf: *const u8, count: i64) -> i32;

unsafe fn main() -> i32 {
    // ── 1. Parse a document ───────────────────────────────────────────────────
    let mut src: Hermes = Hermes::new(4096);
    match src.parse("[1,\"hello\",true,null,42]") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 1; }
    }

    // ── 2. Stringify original ─────────────────────────────────────────────────
    let s1: String = src.to_string();

    // ── 3. Serialize to HBS ───────────────────────────────────────────────────
    let hbs: String = src.serialize();
    if hbs.len() < 12 as i64 { return 2; }

    // ── 4. Deserialize into fresh container ───────────────────────────────────
    let mut dst: Hermes = Hermes::builder(4096);
    if !dst.deserialize(hbs.as_ptr(), hbs.len()) { return 3; }

    // ── 5. Stringify deserialized ─────────────────────────────────────────────
    let s2: String = dst.to_string();

    // Print both (they should be identical)
    write(1 as i32, s1.as_ptr(), s1.len());
    write(1 as i32, "\n" as *const u8, 1 as i64);
    write(1 as i32, s2.as_ptr(), s2.len());
    write(1 as i32, "\n" as *const u8, 1 as i64);

    // Verify content matches
    if s1.len() != s2.len() { return 4; }
    let mut i: i64 = 0 as i64;
    while i < s1.len() {
        let b1: u8 = *((s1.as_ptr() as i64 + i) as *const u8);
        let b2: u8 = *((s2.as_ptr() as i64 + i) as *const u8);
        if b1 != b2 { return 5; }
        i = i + 1 as i64;
    }

    return 0;
}
