// HBS binary roundtrip on hermes2: serialize -> bytes -> deserialize ->
// structurally equal + identical render.
package hermes_hbs;
use logos.lang.hermes2.container;
use logos.lang.hermes2.anyval;
use logos.mem.hermes2.parser;
use logos.mem.hermes2.hbs;
use logos.mem.hermes2.equal;
use logos.mem.hermes2.stringify;
use logos.mem.collections.vec;
use logos.mem.rc;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Hermes2> = hermes2_rc(16384);
    let h: &Hermes2 = rc.deref();

    // 1. Parse a mixed document.
    let src: HAny = parse(h, "[1, \"hello\", true, null, 42]");
    let s1: String = stringify(src);

    // 2. Serialize to bytes.
    let wire: Vec<u8> = hbs_write(src);
    if wire.len() == 0 { return 1; }

    // 3. Deserialize into a second container.
    let rc2: Rc<Hermes2> = hermes2_rc(32768);
    let h2: &Hermes2 = rc2.deref();
    let ws: &[u8] = wire.as_slice();
    let dst: HAny = hbs_read(h2, ws.as_ptr(), wire.len() as i64);
    if dst.is_null() { return 2; }

    // 4. Structural equality + identical render.
    if !hermes2_equal(src, dst) { return 3; }
    let s2: String = stringify(dst);
    if !s1.eq_str(s2.as_str()) { return 4; }

    return 0;
}
