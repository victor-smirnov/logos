package bc_bindmut_at_payload_mut_addrmut;
enum E { N(i64), Z }
fn bump(r: &mut i64) { *r = *r + 100i64; }
fn main() -> i32 {
    let e: E = E::N(3i64);
    let mut out: i64 = 0i64;
    match e {
        E::N(mut n @ 1i64..=5i64) => { bump(&mut n); out = n; },
        E::N(_) => { out = -1i64; },
        E::Z => {}
    }
    if out != 103i64 { return 1i32; }
    return 0i32;
}
