// WQL SURFACE-parser smoke (ADR 0012 Phase 2): parse a sample `wql!` query
// through the peg-GENERATED surface parser (`wql_surface_parser::parse_program`
// → the RQProgram envelope; slice B) and assert the ENTRY is the correct
// RQuery plan — the schema-enum family the walker-emitter consumes. The local
// `parse_entry` helper unwraps the envelope (these samples declare no rels, so
// the rels edge is NULL).
//
// PARAMETERIZED surface: sources are named by their `deem!(…)` slice-param name
// (`from people p` — no inline `:[Ty]`; the handler stamps row types AFTER the
// parse, so `row_ty`/`a_ty`/`b_ty` are EMPTY here), scalar params are bare
// idents inside the EL bodies, and `limit` takes an INTEGER or a bare IDENT
// (the `$`/`with` machinery is gone from the grammar).
//
// Covers all four surface shapes:
//   • simple:    from people p where p.age >= 18 select p.name
//   • join:      from a x join b y on x.k == y.k select x.name : str
//   • aggregate: from o r group by r.dept aggregate total = sum(r.amt) select total : i64
//   • find:      (covered via the e2e tests; the shapes here spot-check parses)
// plus the limit INTEGER|IDENT forms and the comprehension embed.
//
// Each parse builds the plan into a live Writ arena `h`; the root is viewed as
// `RQuery` and matched. The embedded EL clause bodies (where/select/on/key/agg)
// are resolved through the `WRef<SExpr>` edges and spot-checked, proving the
// cross-grammar embed (el_parser::parse_expr) wired the SExpr IR in correctly.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;
use logos.lang.str;
use logos.std.wql.ir;
use logos.std.wql.plan;
use logos.std.wql.wql_surface_parser;   // parse_program — the GENERATED surface parser

// Parse + unwrap the RQProgram envelope: the ENTRY query node (a null WAny on
// a parse failure — also asserts the rels edge is NULL for these rel-less
// samples, exercising `has_rels` on the envelope).
fn parse_entry(src: str, h: &Writ) -> WAny {
    let root: WAny = parse_program(src, h);
    if root.is_null() { return WAny::Ref(0i64 as *const u8); }
    let prog: RQProgram = root.view::<RQProgram>();
    if prog.has_rels() { return WAny::Ref(0i64 as *const u8); }
    // Launder through the raw arena word (the ref_to(raw) idiom): the WAny
    // targets the entry's TOM in the arena (outlives this frame), not the
    // local view — keeps the borrow checker off the local `prog`.
    let w: i64 = prog.entry_any().raw();
    return WAny::ref_to(w as *const u8);
}

fn main() -> i32 {
    // ── SIMPLE ────────────────────────────────────────────────────────────
    {
        let h: Writ = writ_new(4096i64);
        let src: str = "from people p where p.age >= 18 select p.name";
        let root: WAny = parse_entry(src, &h);
        if root.is_null() { return 1i32; }
        let plan: RQuery = root.view::<RQuery>();
        match plan {
            RQuery::Simple(s) => {
                // fn_name / row_ty are NOT set by the parser: the handler stamps
                // them (binding name + slice-param element type) — empty here.
                if s.fn_name.len() != 0i64       { return 2i32; }
                if s.row_ty.len() != 0i64        { return 3i32; }
                if !str_eq(s.src_name, "people") { return 4i32; }
                if !str_eq(s.var_name, "p")      { return 5i32; }
                if !s.has_where                  { return 6i32; }
                if s.has_result_ty               { return 7i32; }   // no `: RTy`

                // where predicate:  p.age >= 18  → SBin(OP_GE, SField(age), SLit(18)).
                let we: SExpr = s.where_expr();
                match we {
                    SExpr::Bin(b) => {
                        if b.op != 8i32 { return 8i32; }   // OP_GE
                        let l: SExpr = b.lhs.any().view::<SExpr>();
                        match l {
                            SExpr::Field(f) => { if !str_eq(f.name, "age") { return 9i32; } }
                            _ => { return 10i32; }
                        }
                    }
                    _ => { return 11i32; }
                }

                // select projection:  p.name  → SField(name).
                let se: SExpr = s.select_expr();
                match se {
                    SExpr::Field(f) => { if !str_eq(f.name, "name") { return 12i32; } }
                    _ => { return 13i32; }
                }
            }
            _ => { return 18i32; }
        }
    }

    // ── LIMIT forms: INTEGER literal vs bare IDENT (scalar-param name) ─────
    {
        let h: Writ = writ_new(4096i64);
        let src: str = "from people p select p.age limit 3";
        let root: WAny = parse_entry(src, &h);
        if root.is_null() { return 90i32; }
        let plan: RQuery = root.view::<RQuery>();
        match plan {
            RQuery::Simple(s) => {
                if !s.has_limit       { return 91i32; }
                if s.limit_is_param   { return 92i32; }
                if s.limit_n != 3i64  { return 93i32; }
            }
            _ => { return 94i32; }
        }
    }
    {
        let h: Writ = writ_new(4096i64);
        let src: str = "from people p select p.age limit n";
        let root: WAny = parse_entry(src, &h);
        if root.is_null() { return 95i32; }
        let plan: RQuery = root.view::<RQuery>();
        match plan {
            RQuery::Simple(s) => {
                if !s.has_limit                 { return 96i32; }
                if !s.limit_is_param            { return 97i32; }
                if !str_eq(s.limit_param, "n")  { return 98i32; }
            }
            _ => { return 99i32; }
        }
    }

    // ── JOIN (one step → RQJoinStepArr of 1) ──────────────────────────────
    {
        let h: Writ = writ_new(4096i64);
        let src: str = "from a x join b y on x.k == y.k select x.name : str";
        let root: WAny = parse_entry(src, &h);
        if root.is_null() { return 20i32; }
        let plan: RQuery = root.view::<RQuery>();
        match plan {
            RQuery::Join(j) => {
                if j.fn_name.len() != 0i64  { return 21i32; }   // parser leaves fn_name empty
                if !str_eq(j.a_name, "a")   { return 22i32; }
                if j.a_ty.len() != 0i64     { return 23i32; }   // handler-stamped, empty here
                if !str_eq(j.x_var, "x")    { return 24i32; }
                let steps: RQJoinStepArr = j.steps_arr();
                if steps.len() != 1i64      { return 25i32; }
                let s0: RQJoinStep = steps.step_at(0i64);
                if s0.is_anti                 { return 26i32; }
                if !str_eq(s0.src_name, "b")  { return 27i32; }   // handler stamps row_ty later
                if !str_eq(s0.var_name, "y")  { return 28i32; }
                if !str_eq(j.result_ty, "str") { return 29i32; }
                if j.has_where              { return 30i32; }

                // on:  x.k == y.k  → SBin(OP_EQ, …).
                let oe: SExpr = s0.on_expr();
                match oe {
                    SExpr::Bin(b) => { if b.op != 3i32 { return 31i32; } }   // OP_EQ
                    _ => { return 32i32; }
                }
            }
            _ => { return 33i32; }
        }
    }

    // ── JOIN CHAIN (N-way: two steps, second anti) ────────────────────────
    {
        let h: Writ = writ_new(8192i64);
        let src: str = "from a x join b y on x.k == y.k anti join c z on y.j == z.j select x.name : str";
        let root: WAny = parse_entry(src, &h);
        if root.is_null() { return 100i32; }
        let plan: RQuery = root.view::<RQuery>();
        match plan {
            RQuery::Join(j) => {
                if !str_eq(j.a_name, "a") { return 101i32; }
                let steps: RQJoinStepArr = j.steps_arr();
                if steps.len() != 2i64    { return 102i32; }
                let s0: RQJoinStep = steps.step_at(0i64);
                if s0.is_anti                { return 103i32; }
                if !str_eq(s0.src_name, "b") { return 104i32; }
                if !str_eq(s0.var_name, "y") { return 105i32; }
                let s1: RQJoinStep = steps.step_at(1i64);
                if !s1.is_anti               { return 106i32; }
                if !str_eq(s1.src_name, "c") { return 107i32; }
                if !str_eq(s1.var_name, "z") { return 108i32; }
                // Each step's on-pred is an OP_EQ SBin.
                match s1.on_expr() {
                    SExpr::Bin(b) => { if b.op != 3i32 { return 109i32; } }
                    _ => { return 110i32; }
                }
            }
            _ => { return 111i32; }
        }
    }

    // ── AGGREGATE over a JOINED stream (join_steps? on the aggr shape) ────
    {
        let h: Writ = writ_new(8192i64);
        let src: str = "from o r join d q on r.dept == q.id group by q.region aggregate total = sum(r.amt) select total : i64";
        let root: WAny = parse_entry(src, &h);
        if root.is_null() { return 120i32; }
        let plan: RQuery = root.view::<RQuery>();
        match plan {
            RQuery::Aggr(g) => {
                if !g.has_steps()  { return 121i32; }
                let steps: RQJoinStepArr = g.steps_arr();
                if steps.len() != 1i64 { return 122i32; }
                if !str_eq(steps.step_at(0i64).src_name, "d") { return 123i32; }
            }
            _ => { return 124i32; }
        }
    }

    // ── AGGREGATE ─────────────────────────────────────────────────────────
    {
        let h: Writ = writ_new(4096i64);
        let src: str = "from o r group by r.dept aggregate total = sum(r.amt) select total : i64";
        let root: WAny = parse_entry(src, &h);
        if root.is_null() { return 40i32; }
        let plan: RQuery = root.view::<RQuery>();
        match plan {
            RQuery::Aggr(g) => {
                if g.fn_name.len() != 0i64     { return 41i32; }   // parser leaves fn_name empty
                if !str_eq(g.a_name, "o")      { return 42i32; }
                if !str_eq(g.x_var, "r")       { return 43i32; }
                if g.has_where                 { return 44i32; }
                if !str_eq(g.result_ty, "i64") { return 45i32; }

                // group key:  r.dept  → SField(dept).
                let ke: SExpr = g.key_expr();
                match ke {
                    SExpr::Field(f) => { if !str_eq(f.name, "dept") { return 46i32; } }
                    _ => { return 47i32; }
                }

                // aggregate total = sum(r.amt) → one RQAgg(name="total", fn_name="sum", has_arg).
                let aa: RQAggArr = g.aggs_arr();
                if aa.len() != 1i64 { return 48i32; }
                let a0: RQAgg = aa.agg_at(0i64);
                if !str_eq(a0.name, "total")  { return 49i32; }
                if !str_eq(a0.fn_name, "sum") { return 50i32; }
                if !a0.has_arg                { return 51i32; }
                let ae: SExpr = a0.arg_expr();
                match ae {
                    SExpr::Field(f) => { if !str_eq(f.name, "amt") { return 52i32; } }
                    _ => { return 53i32; }
                }

                // select total  → SField(total) (a bare field-root over the grouped local).
                let se: SExpr = g.select_expr();
                match se {
                    SExpr::Field(f) => { if !str_eq(f.name, "total") { return 54i32; } }
                    _ => { return 55i32; }
                }
            }
            _ => { return 56i32; }
        }
    }

    // ── ANTI-JOIN + `where` (ordered-choice + per-step is_anti flag) ──────
    {
        let h: Writ = writ_new(4096i64);
        let src: str = "from a x anti join b y on x.k == y.k where x.ok select x.name : str";
        let root: WAny = parse_entry(src, &h);
        if root.is_null() { return 60i32; }
        let plan: RQuery = root.view::<RQuery>();
        match plan {
            RQuery::Join(j) => {
                if !j.steps_arr().step_at(0i64).is_anti { return 61i32; }
                if !j.has_where { return 62i32; }
                // where x.ok → SField(ok).
                let we: SExpr = j.where_expr();
                match we {
                    SExpr::Field(f) => { if !str_eq(f.name, "ok") { return 63i32; } }
                    _ => { return 64i32; }
                }
            }
            _ => { return 65i32; }
        }
    }

    // ── AGGREGATE + `where` + count() (empty-paren alt) + 2 aggs ───────────
    {
        let h: Writ = writ_new(4096i64);
        let src: str = "from o r where r.paid group by r.dept aggregate n = count(), total = sum(r.amt) select total : i64";
        let root: WAny = parse_entry(src, &h);
        if root.is_null() { return 70i32; }
        let plan: RQuery = root.view::<RQuery>();
        match plan {
            RQuery::Aggr(g) => {
                if !g.has_where { return 71i32; }
                let aa: RQAggArr = g.aggs_arr();
                if aa.len() != 2i64 { return 72i32; }
                let a0: RQAgg = aa.agg_at(0i64);
                if !str_eq(a0.name, "n")        { return 73i32; }
                if !str_eq(a0.fn_name, "count") { return 74i32; }
                if a0.has_arg                   { return 75i32; }   // count() → no arg
                let a1: RQAgg = aa.agg_at(1i64);
                if !str_eq(a1.name, "total")    { return 76i32; }
                if !a1.has_arg                  { return 77i32; }
            }
            _ => { return 78i32; }
        }
    }

    // ── COMPREHENSION in select (embed `[…]` depth tracking) ───────────────
    // `select [ v.n for v in xs ]` — the `[`/`]` and inner `for`/`in` must NOT
    // terminate the sel_body embed early (they are inside brackets / not stops).
    {
        let h: Writ = writ_new(4096i64);
        let src: str = "from rows r select [ v.n for v in items ] : i64";
        let root: WAny = parse_entry(src, &h);
        if root.is_null() { return 80i32; }
        let plan: RQuery = root.view::<RQuery>();
        match plan {
            RQuery::Simple(s) => {
                if !str_eq(s.result_ty, "i64") { return 81i32; }
                let se: SExpr = s.select_expr();
                match se {
                    SExpr::Comp(_) => { }
                    _ => { return 82i32; }
                }
            }
            _ => { return 83i32; }
        }
    }

    return 0i32;
}
