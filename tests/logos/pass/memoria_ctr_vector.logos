// ctr_vector — the Vector<V> family gate: the pure stream-size container
// (branch nodes carry ONLY per-child subtree entry counts) through the full
// metaclass pipeline: CFG literal → mono demand → __container_factory →
// generated family (Hs<hex>, package logos.gen) → thin glue over
// logos.mem.bt.btvec. Model-equivalence harness in the gen_multimap style:
// the reference model is a plain Vec<u64>; every mutation rides the
// generated handle; laws are checked against the model each round.
//
// Error-code decades:
//   10..19  empty container + trivial appends (default nodes)
//   20..39  config A: small nodes (reformat 512/320) — random positional
//           inserts, per-round size/check, periodic full equivalence
//           (get(i) AND seek(i).value() vs the model); final level ≥ 2
//   40..49  set-in-place over config A's final state
//   80..89  pipeline smoke (second container id independence, open)
package test;

use logos.lcm.canon.container_item;   // the factory (an emitted `use` cannot LOAD a module)
use logos.lcm.canon.metaclass;        // create_ctr / open_ctr (mono demand surface)
use logos.mem.bt.btvec;               // Btvec — the tree() law surface
use logos.mem.bt.node;                // CowProfile
use logos.mem.bt.map;                 // trait hub (declaring-unit contract)
use logos.mem.bt.memstore;
use logos.mem.sync;                   // Arc — the store/snapshot plane
use logos.mem.pkd;
use logos.lang.arith;
use logos.lang.writ.wstatic;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.std.io;

pub const VecCfg: WritStatic = @{ "kind": "vector", "value": <type:u64> };
pub type V64 = CtrClass<VecCfg>;

// deterministic LCG (Knuth MMIX) — wrapping BY DESIGN
struct Lcg {
    s: u64,
}

impl Lcg {
    fn next(self: &mut Lcg) -> u64 {
        self.s = wrapping_add::<u64>(
            wrapping_mul::<u64>(self.s, 6364136223846793005u64),
            1442695040888963407u64);
        return self.s >> 33u64;
    }
}

// Vec has no positional insert — shift-right by hand (the model is O(n²)
// over the run; fine at this scale).
fn model_insert_at(m: &mut Vec<u64>, pos: i64, v: u64) {
    m.push(0u64);
    let mut i: i64 = m.len() - 1i64;
    while i > pos {
        m.set(i, m.get(i - 1i64));
        i = i - 1i64;
    }
    m.set(pos, v);
}

fn run_all() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();
    let snap: Arc<dyn Snapshot> = store_fork_arc(&mut store);

    // ── 10..19: empty + trivial appends (default nodes) ─────────────────────
    {
        let mut v0 = create_ctr::<V64>(&snap, 1u64);
        if v0.size() != 0u64 {
            return 10i32;
        }
        if v0.seek(0u64).valid() {
            return 11i32;
        }
        if !v0.check() {
            return 12i32;
        }
        v0.append(7u64);
        v0.append(9u64);
        if v0.size() != 2u64 {
            return 13i32;
        }
        if v0.get(0u64) != 7u64 || v0.get(1u64) != 9u64 {
            return 14i32;
        }
        let c = v0.seek(1u64);
        if !c.valid() || c.value() != 9u64 {
            return 15i32;
        }
        if v0.seek(2u64).valid() {
            return 16i32;
        }
    }

    // ── 20..39: config A — small nodes, random positional inserts ───────────
    {
        let mut va = create_ctr::<V64>(&snap, 2u64);
        va.reformat(512u32, 320u32);
        let mut model: Vec<u64> = vec_new::<u64>();
        let mut lcg: Lcg = Lcg { s: 0x5EEDu64 };
        let mut r: i64 = 0i64;
        while r < 1500i64 {
            let val: u64 = lcg.next();
            // Mix appends (2/3) with random-position inserts (1/3): front,
            // middle and tail all get traffic across splits.
            let mode: u64 = lcg.next() % 3u64;
            if mode == 0u64 && model.len() > 0i64 {
                let pos: u64 = lcg.next() % ((model.len() as u64) + 1u64);
                va.insert_at(pos, val);
                model_insert_at(&mut model, pos as i64, val);
            } else {
                va.append(val);
                model.push(val);
            }
            if va.size() != model.len() as u64 {
                return 21i32;
            }
            if !va.check() {
                return 22i32;   // a branch count row disagrees with its subtree
            }
            // Periodic FULL equivalence — every element via BOTH read paths.
            if r % 100i64 == 99i64 {
                let mut i: i64 = 0i64;
                while i < model.len() {
                    if va.get(i as u64) != model.get(i) {
                        return 23i32;
                    }
                    let c = va.seek(i as u64);
                    if !c.valid() {
                        return 24i32;
                    }
                    if c.value() != model.get(i) {
                        return 25i32;
                    }
                    i = i + 1i64;
                }
                if va.seek(model.len() as u64).valid() {
                    return 26i32;
                }
            }
            r = r + 1i64;
        }
        if va.level() < 2u32 {
            return 38i32;   // the scenario must cross branch-split depth
        }

        // ── 40..49: set-in-place over the final state ───────────────────────
        let n: i64 = model.len();
        let mut k: i64 = 0i64;
        while k < 200i64 {
            let pos: u64 = lcg.next() % (n as u64);
            let nv: u64 = lcg.next();
            va.set(pos, nv);
            model.set(pos as i64, nv);
            if va.get(pos) != nv {
                return 41i32;
            }
            k = k + 1i64;
        }
        if !va.check() {
            return 42i32;
        }
        // spot re-verify after the write burst
        let mut i2: i64 = 0i64;
        while i2 < n {
            if va.get(i2 as u64) != model.get(i2) {
                return 43i32;
            }
            i2 = i2 + 37i64;
        }
    }

    // ── 50..69: BATCH insert (make_buffer / push / insert(pos, buf)) ────────
    // The two-stage batch path: staging in the container-provided buffer,
    // weight-calculus packing at the 90% fill target. Laws vs the same
    // Vec<u64> model; the count-invariant check() runs after every splice.
    {
        let mut vb = create_ctr::<V64>(&snap, 5u64);
        vb.reformat(512u32, 320u32);        // small nodes — deep trees cheap
        let mut model: Vec<u64> = vec_new::<u64>();
        let mut lcg: Lcg = Lcg { s: 0xBA7C4u64 };

        // (a) BULK LOAD into the empty container: one big buffer → a whole
        // multi-level tree built by packing alone.
        {
            let mut buf = vb.make_buffer();
            let mut i: u64 = 0u64;
            while i < 5000u64 {
                let v: u64 = lcg.next();
                buf.push(v);
                model.push(v);
                i = i + 1u64;
            }
            if buf.len() != 5000u64 {
                return 50i32;
            }
            vb.insert(0u64, &buf);
        }
        if vb.size() != 5000u64 {
            return 51i32;
        }
        if !vb.check() {
            return 52i32;
        }
        if vb.level() < 2u32 {
            return 53i32;   // bulk load must have built a deep tree
        }

        // (b) random-position batches of random sizes (incl. the in-place
        // fast path and multi-fragment splices), model-equivalent each round.
        let mut r: i64 = 0i64;
        while r < 25i64 {
            let bn: u64 = 1u64 + lcg.next() % 900u64;
            let pos: u64 = lcg.next() % ((model.len() as u64) + 1u64);
            let mut buf = vb.make_buffer();
            let mut i: u64 = 0u64;
            while i < bn {
                let v: u64 = lcg.next();
                buf.push(v);
                model_insert_at(&mut model, (pos + i) as i64, v);
                i = i + 1u64;
            }
            vb.insert(pos, &buf);
            if vb.size() != model.len() as u64 {
                return 54i32;
            }
            if !vb.check() {
                return 55i32;
            }
            // spot equivalence around the splice + dual read paths
            let lo: u64 = if pos > 3u64 { pos - 3u64 } else { 0u64 };
            let mut hi: u64 = pos + bn + 3u64;
            if hi > model.len() as u64 {
                hi = model.len() as u64;
            }
            let mut q: u64 = lo;
            while q < hi {
                if vb.get(q) != model.get(q as i64) {
                    return 56i32;
                }
                q = q + 1u64;
            }
            r = r + 1i64;
        }
        // full equivalence at the end — every element via BOTH read paths
        {
            let mut i: i64 = 0i64;
            while i < model.len() {
                if vb.get(i as u64) != model.get(i) {
                    return 57i32;
                }
                let c = vb.seek(i as u64);
                if !c.valid() || c.value() != model.get(i) {
                    return 58i32;
                }
                i = i + 1i64;
            }
        }

        // (c) buffer REUSE: the same buffer spliced twice inserts twice.
        {
            let mut buf = vb.make_buffer();
            buf.push(0xAAu64);
            buf.push(0xBBu64);
            vb.insert(0u64, &buf);
            vb.insert(0u64, &buf);
            model_insert_at(&mut model, 0i64, 0xBBu64);
            model_insert_at(&mut model, 0i64, 0xAAu64);
            model_insert_at(&mut model, 0i64, 0xBBu64);
            model_insert_at(&mut model, 0i64, 0xAAu64);
            if vb.size() != model.len() as u64 {
                return 60i32;
            }
            if vb.get(0u64) != 0xAAu64 || vb.get(1u64) != 0xBBu64
               || vb.get(2u64) != 0xAAu64 || vb.get(3u64) != 0xBBu64 {
                return 61i32;
            }
            // (d) the EMPTY buffer is a no-op.
            let ebuf = vb.make_buffer();
            vb.insert(0u64, &ebuf);
            if vb.size() != model.len() as u64 {
                return 62i32;
            }
            if !vb.check() {
                return 63i32;
            }
        }
    }

    // ── 70..79: REMOVAL — random insert/remove interleave vs the model ──────
    // The deletion slice: remove_at + the parent-driven neighbor merge under
    // exact weight admission. The count-invariant check() runs after every
    // removal; the drain exercises root collapse down to the empty leaf.
    {
        let mut vr = create_ctr::<V64>(&snap, 6u64);
        vr.reformat(512u32, 320u32);
        let mut model: Vec<u64> = vec_new::<u64>();
        let mut lcg: Lcg = Lcg { s: 0xDE1E7Eu64 };
        let mut r: i64 = 0i64;
        while r < 1200i64 {
            let grow: bool = model.len() == 0i64 || lcg.next() % 3u64 != 0u64;
            if grow {
                let v: u64 = lcg.next();
                let pos: u64 = lcg.next() % ((model.len() as u64) + 1u64);
                vr.insert_at(pos, v);
                model_insert_at(&mut model, pos as i64, v);
            } else {
                let pos: u64 = lcg.next() % (model.len() as u64);
                vr.remove_at(pos);
                // model shift-left
                let mut i: i64 = pos as i64;
                while i + 1i64 < model.len() {
                    model.set(i, model.get(i + 1i64));
                    i = i + 1i64;
                }
                model.pop();
            }
            if vr.size() != model.len() as u64 {
                return 70i32;
            }
            if !vr.check() {
                return 71i32;   // a branch count row disagrees post-merge
            }
            if r % 150i64 == 149i64 {
                let mut i: i64 = 0i64;
                while i < model.len() {
                    if vr.get(i as u64) != model.get(i) {
                        return 72i32;
                    }
                    i = i + 1i64;
                }
            }
            r = r + 1i64;
        }
        // drain to EMPTY: root collapse all the way, then reuse
        while vr.size() > 0u64 {
            vr.remove_at(0u64);
        }
        if !vr.check() {
            return 73i32;
        }
        if vr.level() != 0u32 {
            return 74i32;   // the empty vector is a single leaf again
        }
        vr.append(11u64);
        if vr.get(0u64) != 11u64 || vr.size() != 1u64 {
            return 75i32;
        }
    }

    // ── 80..89: pipeline smoke ──────────────────────────────────────────────
    {
        let mut vb = create_ctr::<V64>(&snap, 3u64);
        vb.append(1u64);
        let vc = create_ctr::<V64>(&snap, 4u64);
        if vc.size() != 0u64 {
            return 81i32;   // container ids are independent
        }
        let vb2 = open_ctr::<V64>(&snap, 3u64);
        if vb2.size() != 1u64 || vb2.get(0u64) != 1u64 {
            return 82i32;
        }
    }

    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap and report SUCCESS.
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL ctr_vector: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
