// `h.v[0] = 7` (IndexMut on a FIELD receiver): legal, runs.
// PROBES.md 2026-09-08a: a place in a mutable-use position takes the DerefMut/IndexMut step at every level, a Deref-only/Index-only step is refused, and the bare `deref_mut()` receiver is asked the binding-mut question.
package bc_mutplace_field_vec_index_write;
struct H { v: Vec<i64> }
fn main() -> i32 {
    let v0: Vec<i64> = Vec::new();
    let mut h: H = H { v: v0 };
    h.v.push(1i64);
    h.v[0] = 7i64;
    if h.v[0] != 7i64 { return 1i32; }
    return 0i32;
}
