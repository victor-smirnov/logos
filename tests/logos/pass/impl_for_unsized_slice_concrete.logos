// Phase 1B-10: concrete `impl Trait for [u8]` — non-generic unsized
// self-type. Dispatch from `&[u8]` recv looks up the `$slice$u8`-mangled
// method.

package impl_for_unsized_slice_concrete;

trait Sum { fn sum_bytes(self: &Self) -> i64; }

impl Sum for [u8] {
    fn sum_bytes(self: &[u8]) -> i64 {
        let mut acc: i64 = 0 as i64;
        let n: i64 = self.len();
        let mut i: i64 = 0 as i64;
        while i < n {
            unsafe {
                let p: *const u8 = self.as_ptr();
                acc = acc + (*((p as i64 + i) as *const u8)) as i64;
            }
            i = i + 1 as i64;
        }
        return acc;
    }
}

unsafe fn main() -> i32 {
    let buf: [u8; 4] = [1u8, 2u8, 3u8, 4u8];
    let s: &[u8] = &buf;
    return (s.sum_bytes() - 10 as i64) as i32;
}
