package cond_move_if_assign;
extern fn printf(fmt: *const u8, ...) -> i32;
extern fn fflush(f: *mut u8) -> i32;
fn pr(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); fflush(0 as *mut u8); } }
fn ps(s: str) { unsafe { printf(s.as_ptr()); fflush(0 as *mut u8); } }

trait Drop { fn drop(self: Self); }

/// HEAP-OWNING payload. The `Vec` is what makes the oracle bite: a second
/// destructor call on the same value is a genuine double free (glibc aborts),
/// a missing one a genuine leak. Every conditional move already in the corpus
/// carries a Copy payload, which is exactly why 3844 green tests could hold
/// this defect — the counting oracle below is the only thing that sees it.
struct Pay { n: i64, v: Vec<i64> }
impl Drop for Pay {
    fn drop(self: Pay) { pr("D%ld ", self.n); }
}
fn mk(n: i64) -> Pay {
    let mut v: Vec<i64> = Vec::new();
    v.push(n);
    pr("M%ld ", n);
    return Pay { n: n, v: v };
}
fn consume(p: Pay) -> i64 { return p.n; }

/// #118 cell A — `if c { k = a } else { k = b }`. Before drop-flag
/// elaboration the branch NOT taken lost its source silently (rc 0, no
/// diagnostic): the union merge put BOTH `a` and `b` in moved_vars_, so
/// neither got a scope-exit destructor. Three values in, three out, both paths.
fn cellA(c: bool) {
    let a: Pay = mk(1); let b: Pay = mk(2); let mut k: Pay = mk(0);
    if c { k = a; } else { k = b; }
    pr("k=%ld ", k.n);
}

/// cell C — `if` with NO else: the implicit fall-through is a reaching path
/// that moved nothing, so the source must still be destroyed on it.
fn cellC(c: bool) {
    let a: Pay = mk(1); let mut k: Pay = mk(0);
    if c { k = a; }
    pr("k=%ld ", k.n);
}

/// cell J — nested conditionals. ONE flag, armed at the INNER merge; the outer
/// merge must not clear it a second time (that would fire on the whole branch).
fn cellJ(c: bool, d: bool) {
    let a: Pay = mk(1); let b: Pay = mk(2); let mut k: Pay = mk(0);
    if c { if d { k = a; } } else { k = b; }
    pr("k=%ld ", k.n);
}

unsafe fn main() -> i32 {
    ps("A+ "); cellA(true);        ps("\n");
    ps("A- "); cellA(false);       ps("\n");
    ps("C+ "); cellC(true);        ps("\n");
    ps("C- "); cellC(false);       ps("\n");
    ps("J++ "); cellJ(true, true);   ps("\n");
    ps("J+- "); cellJ(true, false);  ps("\n");
    ps("J- "); cellJ(false, true);  ps("\n");
    return 0;
}
