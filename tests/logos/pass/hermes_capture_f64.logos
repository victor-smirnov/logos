// Hermes capture: f64 value captured as zone-allocated F64 object (hermes2).
// C7-fix1: is_ref/is_map checks — confirms root is a zone object (not inline/null).
package hermes_capture_f64;
use logos.lang.hermes.tmpl;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.static_view;
use logos.lang.rc;

unsafe fn main() -> i32 {
    let v0: HView2 = HView2 { base: 0 as *const u8 };

    // Capture an f64 into a map.
    let price: f64 = 3.14;
    let doc: Rc<Hermes> = @{"price": $price};
    let h: &Hermes = doc.deref();
    let root: HAny = h.root();
    if root.is_null() { return 1; }
    if !root.is_ref() { return 2; }
    if !root.is_map() { return 3; }
    let pv: HAny = v0.map_get(root, "price");
    if !pv.is_float() { return 31; }
    if pv.as_f64() != 3.14 { return 32; }

    // Capture f64 in an array.
    let arr: Rc<Hermes> = @[$price, ${1.5 + 0.5}];
    let ah: &Hermes = arr.deref();
    let arr_root: HAny = ah.root();
    if arr_root.is_null() { return 4; }
    if !arr_root.is_ref() { return 5; }
    if !arr_root.is_array() { return 6; }
    if v0.array_len(arr_root) != 2u64 { return 61; }
    let e1: HAny = v0.array_get(arr_root, 1u64);
    if e1.as_f64() != 2.0 { return 62; }

    // Mix: i32 + f64 in same literal (mixed zone-alloc + inline).
    let count: i32 = 42;
    let ratio: f64 = 0.5;
    let mix: Rc<Hermes> = @{"n": $count, "r": $ratio};
    let mh: &Hermes = mix.deref();
    let mix_root: HAny = mh.root();
    if mix_root.is_null() { return 7; }
    if !mix_root.is_ref() { return 8; }
    if !mix_root.is_map() { return 9; }
    if v0.get_int(v0.map_get(mix_root, "n")) != 42i64 { return 91; }
    if v0.map_get(mix_root, "r").as_f64() != 0.5 { return 92; }

    return 0;
}
