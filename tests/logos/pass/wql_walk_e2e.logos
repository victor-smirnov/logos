// WQL Phase 3 — WALKER-EMITTER end-to-end (ADR 0012). Exercises the peg + walker
// spine: `deem_walk!(<params>){ … }` parses the block via the peg-GENERATED surface parser
// (→ an `RQuery` plan) and WALKS that schema'd plan (`plan_walker::walk_query`)
// to emit the native fn — the peg-all-the-way replacement for the QLexer path.
//
// Covers all THREE walker shapes (RQSimple / RQJoin / RQAggr) so the ported
// emit logic is proven to produce runnable code with the SAME behavior as the
// QLexer path:
//   • simple:    filter+project over one slice;
//   • join:      inner nested-loop join over two slices;
//   • aggregate: group-by + sum over one slice.
package test;

use logos.std.wql.wql_walk;
use logos.mem.collections.vec;

struct Person { pub name: i64, pub age: i64 }
struct Dept   { pub id: i64,   pub head: i64 }
struct Order  { pub dept: i64, pub amt: i64 }

// ── SIMPLE: filter+project (adults' ages). ───────────────────────────────────
resource adults = deem_walk!(people: &[Person]) { from people p where p.age >= 18 select p.age : i64 };

// ── JOIN: inner nested-loop join on p.name == d.id → project d.head. ──────────
resource joined = deem_walk!(people: &[Person], depts: &[Dept]) { from people p join depts d on p.name == d.id select d.head : i64 };

// ── AGGREGATE: group by dept, sum amt. ───────────────────────────────────────
resource totals = deem_walk!(orders: &[Order]) { from orders o group by o.dept aggregate total = sum(o.amt) select total : i64 };

fn main() -> i32 {
    // ── simple ──
    let people: [Person; 4] = [
        Person { name: 1i64, age: 15i64 },
        Person { name: 2i64, age: 18i64 },
        Person { name: 3i64, age: 40i64 },
        Person { name: 4i64, age: 9i64  },
    ];
    let ages: Vec<i64> = adults(&people[..]).unwrap();
    if ages.len() != 2i64      { return 1i32; }
    if ages.get(0i64) != 18i64 { return 2i32; }
    if ages.get(1i64) != 40i64 { return 3i32; }

    // ── join ──
    // people.name ∈ {1,2,3,4}; depts.id ∈ {2,3}; matches → depts' heads {20,30}.
    let depts: [Dept; 2] = [
        Dept { id: 2i64, head: 20i64 },
        Dept { id: 3i64, head: 30i64 },
    ];
    let heads: Vec<i64> = joined(&people[..], &depts[..]).unwrap();
    if heads.len() != 2i64      { return 10i32; }
    if heads.get(0i64) != 20i64 { return 11i32; }   // p.name=2 matches d.id=2
    if heads.get(1i64) != 30i64 { return 12i32; }   // p.name=3 matches d.id=3

    // ── aggregate ──
    // dept 7: 100+50=150 ; dept 9: 200. Groups in first-seen order: [7, 9].
    let orders: [Order; 3] = [
        Order { dept: 7i64, amt: 100i64 },
        Order { dept: 9i64, amt: 200i64 },
        Order { dept: 7i64, amt: 50i64  },
    ];
    let sums: Vec<i64> = totals(&orders[..]).unwrap();
    if sums.len() != 2i64       { return 20i32; }
    if sums.get(0i64) != 150i64 { return 21i32; }   // dept 7
    if sums.get(1i64) != 200i64 { return 22i32; }   // dept 9

    return 0i32;
}
