// Steps A+B of the Fn/FnMut/FnOnce epic.
//
// Step A — trait declarations `FnOnce<A...>` / `FnMut<A...>` /
// `Fn<A...>` in `logos.lang.ops`.
// Step B (matcher half) — the trait-impl matcher in
// sema_collect.cpp now recognises a variadic trait type-param and
// allows the impl to expose any concrete arity from the pack
// position onward.
//
// Coverage in this test:
//   1. All three traits implemented on one struct at unary arity.
//   2. Binary + ternary impls of Fn dispatch through method syntax.
//
// Still pending (later Step B + Step C work):
//   - Nullary `Fn<>` impls (empty type-arg list is a syntax error).
//   - Per-element pack/impl type-arg cross-check (today's matcher is
//     loose past the pack position).
//   - Supertrait chain `Fn: FnMut: FnOnce`.
//   - fn-ptr blanket impl + closure auto-impl.
//   - Iter adapter migration from `fn(T) -> R` to `impl Fn<T>`.
package fn_traits_decl_test;

use logos.lang.ops;

pub struct AdderFn { pub bias: i32 }

impl FnOnce<i32> for AdderFn {
    type Output = i32;
    fn call_once(self: AdderFn, x: i32) -> i32 { return self.bias + x; }
}

impl FnMut<i32> for AdderFn {
    type Output = i32;
    fn call_mut(&mut self, x: i32) -> i32 { return self.bias + x; }
}

impl Fn<i32> for AdderFn {
    type Output = i32;
    fn call(&self, x: i32) -> i32 { return self.bias + x; }
}

// Arity-2 / arity-3 Fn impls to exercise the variadic-pack matcher.
pub struct AddBoth {}
impl Fn<i32, i32> for AddBoth {
    type Output = i32;
    fn call(&self, x: i32, y: i32) -> i32 { return x + y; }
}

pub struct AddTriple {}
impl Fn<i32, i32, i32> for AddTriple {
    type Output = i32;
    fn call(&self, x: i32, y: i32, z: i32) -> i32 { return x + y + z; }
}

unsafe fn main() -> i32 {
    let mut a = AdderFn { bias: 10 };

    // Fn  — shared ref
    if a.call(5)         != 15 { return 1; }

    // FnMut — mut ref
    if a.call_mut(7)     != 17 { return 2; }

    // FnOnce — by-value
    let r = AdderFn { bias: 100 }.call_once(3);
    if r != 103 { return 3; }

    // Multi-arity Fn (matcher fix from Step B)
    let b = AddBoth {};
    if b.call(3, 4) != 7 { return 4; }
    let t = AddTriple {};
    if t.call(1, 2, 3) != 6 { return 5; }

    return 42;
}
