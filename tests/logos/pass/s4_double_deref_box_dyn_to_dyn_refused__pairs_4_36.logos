// ADR 0030 S4 acceptance: feature-interaction audit cluster `double-deref-box-dyn-to-dyn-refused`, member pairs-4_36
// (tests/interactions/clusters/double-deref-box-dyn-to-dyn-refused/pairs-4_36.logos); rustc 1.98.1 twin gives the same stdout and exit code.
package m39;
use logos.std.fmt;
use logos.mem.string;
use logos.lang.rc;
trait Shape { fn area(&self) -> i64; }
struct Circle { r: i64 }
impl Shape for Circle { fn area(&self) -> i64 { 3 * self.r * self.r } }
fn f(s: &dyn Shape) -> i64 { s.area() }
fn main() {
    let b: Box<dyn Shape> = Box::new(Circle { r: 2 });
    println!("{}", f(&*b));
    let rb: &Box<dyn Shape> = &b;
    let d: &dyn Shape = &**rb;
    println!("{}", d.area());
    println!("{}", f(&**rb));
}
