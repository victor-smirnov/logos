// if-let over the OTHER variant: the payload drops at scope exit (flagged drop on the else path) PROBES.md 2026-09-06d: `if let` / `while let` / let-chains lower BY DELEGATION to lower_match (temp hoist, per-arm scrutinee move, arm drops, cond-move merge); the count is a destructor tally through a raw pointer.
package bc_patown_iflet_other_variant;

struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
enum E { A(S), B(S) }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let e: E = E::B(S { v: 2i64, i: p });
        if let E::A(r) = e { let _k: i64 = eat(r); }
    }
    return c as i32;
}
