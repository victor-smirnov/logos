package tuple_rest_in_let;

fn main() -> i32 {
    let t: (i64, i64, i64, i64) = (1i64, 2i64, 3i64, 4i64);
    // G140-4: `..` rest in a let tuple pattern.
    let (a, ..) = t;
    if a != 1i64 { return 1i32; }
    let (.., b) = t;
    if b != 4i64 { return 2i32; }
    let (p, .., q) = t;
    if p != 1i64 { return 3i32; }
    if q != 4i64 { return 4i32; }
    let (x, y, ..) = t;
    if x != 1i64 { return 5i32; }
    if y != 2i64 { return 6i32; }
    // existing no-rest full destructure still works (regression guard).
    let (c, d, e, f) = t;
    if c + d + e + f != 10i64 { return 7i32; }
    // nested tuple still works.
    let nt: (i64, (i64, i64)) = (9i64, (8i64, 7i64));
    let (g, (h, ..)) = nt;
    if g != 9i64 { return 8i32; }
    if h != 8i64 { return 9i32; }
    return 0i32;
}
