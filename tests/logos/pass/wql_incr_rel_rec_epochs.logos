// INCREMENTAL RECURSION — A RECURSIVE `rel` MAINTAINED ACROSS EPOCHS, ON
// CYCLIC DATA, CHECKED AT EVERY EPOCH AGAINST A WITNESS THAT SHARES NO CODE.
//
// Until this slice a `deem` whose source was a declared `rel` was REFUSED a
// handle, and the refusal was not a deferral: the handle that existed before it
// answered WRONG and returned `Ok`. What lands here is the answer for one shape
// — a single-member RECURSIVE SCC over one slice parameter, insert-only:
//
//     let mut h: TcIncr = tc_incremental();
//     tc_epoch(&mut h, one_edge)?;      // ← accumulates the input, EXTENDS
//     let out = tc_snapshot(&h)?;       //   the fixpoint total, folds the NEW
//                                       //   derived rows at +1
//
// ── WHAT MAKES IT INCREMENTAL, AND WHERE THE TWO COLLAPSES LIVE ────────────
// The handle owns the ACCUMULATED INPUT (`__edb`) and the rel's FIXPOINT TOTAL
// (`__tot_path`). `tc_epoch` presence-gates the delta into the input, calls the
// CROSS-EPOCH semi-naive driver `__wql_tc_scc0_i` on the total (which seeds its
// shadow set FROM that total and runs a naive round 0 before going semi-naive),
// and folds the rows the total GAINED — a suffix, because the driver only
// appends.
//
//   INBOUND  (weight → presence): the delta enters `__edb` through a linear
//            `==` identity gate and NOTHING ELSE. There is no multiplicity
//            vector beside `__edb`, so "the same edge twice is one fact" is
//            structural. Inside the SCC the only crossing is the driver's
//            shadow-set presence bit.
//   OUTBOUND (+1 per derived row, never a weight): the fold runs over the new
//            rows at `+1`, and `__wd` DOES NOT EXIST — a rel-backed query takes
//            the insert-only surface, so folding at a weight is not
//            expressible.
//
// Both collapses are the same fact: counting derivations through a cycle
// DIVERGES. `path(a,b) :- path(a,c), edge(c,b)` has unboundedly many
// derivations of one fact, and set semantics is exactly what makes the fixpoint
// terminate.
//
// ── THE DATA, CHOSEN SO THAT A DAG COULD NOT SEE ANY OF IT ────────────────
// Seven epochs, ONE edge each:
//
//   E1 (1,2)   E2 (2,3)   E3 (3,1) — closes the 3-cycle
//   E4 (2,2) — a SELF-LOOP that is already in the closure
//   E5 (1,4)   E6 (3,4) — already reachable   E7 (1,2) — a DUPLICATE
//
// Node 4 is reachable from 1 by TWO PATHS OF DIFFERENT LENGTHS (1→4 directly,
// and 1→2→3→4). Epochs 4, 6 and 7 are the sharpest assertions in the file: the
// truth DOES NOT MOVE across them, so a multiplicity leak has nothing to cancel
// against and shows immediately.
//
// ── THE ANSWERS, BY HAND, BEFORE ANYTHING WAS RUN ─────────────────────────
// `tc` is `from path p group by p.a aggregate c = count()`, so the table is
// key → |{ b : path(key,b) }|:
//
//   E1  1:1
//   E2  1:2  2:1
//   E3  1:3  2:3  3:3        (all 9 pairs among {1,2,3})
//   E4  1:3  2:3  3:3        UNCHANGED — (2,2) is already derived
//   E5  1:4  2:4  3:4        4 becomes reachable from all three
//   E6  1:4  2:4  3:4        UNCHANGED — 3 already reached 4
//   E7  1:4  2:4  3:4        UNCHANGED — a rel is a SET
//
// ── THREE WITNESSES, BECAUSE AN ORACLE THAT SHARES THE ALGORITHM IS NOT ONE ─
//  (i)   the table above, hand-derived;
//  (ii)  `naive_count` — a from-scratch closure recomputed over the ACCUMULATED
//        edge list at every epoch by repeated `P := E ∪ (P ∘ E)` with a linear
//        dedup. It shares NO code with the emitter: no semi-naive rewriting, no
//        delta, no shadow set, no SCC.
//  (iii) the batch fn `tc()` over the same accumulated edges — and this one is
//        a CONTROL, NOT AN ORACLE, and the difference is stated because this
//        arc has twice been burned by three sides running one wrong fold: `tc()`
//        goes through the SAME `emit_scc_fn`, so it would agree with a wrong
//        semi-naive rewriting. It is here to separate "the driver is wrong" from
//        "the cross-epoch entry is wrong", not to certify either.
//
// ── WHAT A FAILURE WOULD LOOK LIKE, so the assertions are placed where the
// broken code has already done its work rather than where it is cheap to catch:
//   • from-scratch-per-epoch (the refused behaviour) → E2 reads 1:1;
//   • no naive round 0 (only in-SCC deltas)          → E5 reads 1:4 2:3 3:4 —
//     group 1 is RIGHT (the seed body derives (1,4) directly) and 2 is wrong,
//     so a fixture asserting one group, or only `len()`, passes over it. EVERY
//     GROUP IS ASSERTED AT EVERY EPOCH for that reason;
//   • shadow set not seeded from the total            → E2 reads 1:3;
//   • a weight reaching the fold or the SCC           → E4/E6/E7 rise;
//   • the presence gate lost inside the SCC           → E3 does not terminate.
//     That last one is visible only on CYCLIC data and surfaces as the suite's
//     own timeout — which is why no shorter one is added here.
//
// exit 0 = all three witnesses agree with the hand table at all seven epochs.
package test;

use logos.std.wql.wql;
use logos.std.wql.el;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

struct E { pub a: i64, pub b: i64 }

pub deem tc(es: &[E]) {
    rel path(a: i64, b: i64) {
        from es e select (e.a, e.b);
        from path p join es e on p.b == e.a select (p.a, e.b);
    }
    from path p group by p.a aggregate c = count() select (key, c)
}

// ── WITNESS (ii): a from-scratch naive closure, sharing nothing with the
// emitter. `P := E ∪ (P ∘ E)` repeated until no growth, dedup by linear `==`.
fn pair_uniq(p: &mut Vec<(i64, i64)>, a: i64, b: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < p.len() {
        let c: (i64, i64) = p.get(i);
        if c.0 == a && c.1 == b { return false; }
        i = i + 1i64;
    }
    p.push((a, b));
    return true;
}

fn naive_closure(es: &[E]) -> Vec<(i64, i64)> {
    let mut p: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut i: i64 = 0i64;
    while i < es.len() {
        pair_uniq(&mut p, es[i].a, es[i].b);
        i = i + 1i64;
    }
    let mut grew: bool = true;
    while grew {
        grew = false;
        let mut k: i64 = 0i64;
        while k < p.len() {
            let pr: (i64, i64) = p.get(k);
            let mut j: i64 = 0i64;
            while j < es.len() {
                if pr.1 == es[j].a {
                    if pair_uniq(&mut p, pr.0, es[j].b) { grew = true; }
                }
                j = j + 1i64;
            }
            k = k + 1i64;
        }
    }
    return p;
}

fn naive_count(es: &[E], key: i64) -> i64 {
    let p: Vec<(i64, i64)> = naive_closure(es);
    let mut n: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < p.len() {
        if p.get(i).0 == key { n = n + 1i64; }
        i = i + 1i64;
    }
    return n;
}

// ⚠ LOOKED UP BY KEY, NEVER BY POSITION. Group order is first-occurrence order
// and it is a real property, but asserting counts BY INDEX would make every row
// of the table depend on it and hide a wrong count behind a right order (or the
// reverse). `-1` = the group is absent, which is a distinct and assertable
// answer from "present with count 0".
fn cnt_of(out: &Vec<(i64, i64)>, key: i64) -> i64 {
    let mut i: i64 = 0i64;
    while i < out.len() {
        let r: (i64, i64) = out.get(i);
        if r.0 == key { return r.1; }
        i = i + 1i64;
    }
    return -1i64;
}

fn edge(a: i64, b: i64) -> Vec<E> {
    let mut v: Vec<E> = vec_new::<E>();
    v.push(E { a: a, b: b });
    return v;
}

// One epoch: apply `d` to the handle, append it to the accumulated list, and
// check the snapshot against ALL THREE witnesses for the three keys the table
// names. Returns 0 on agreement, else a code that names WHICH witness and WHICH
// key disagreed — the epoch number is added by the caller.
fn step(h: &mut TcIncr, acc: &mut Vec<E>, d: &Vec<E>,
        w1: i64, w2: i64, w3: i64) -> i32 {
    match tc_epoch(h, d.as_slice()) {
        Result::Ok(_n) => { } Result::Err(_e) => { return 1i32; }
    }
    let mut i: i64 = 0i64;
    while i < d.len() { acc.push(d.get(i)); i = i + 1i64; }

    let out: Vec<(i64, i64)> = match tc_snapshot(h) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 2i32; }
    };
    // (i) THE HAND TABLE.
    if cnt_of(&out, 1i64) != w1 { return 3i32; }
    if cnt_of(&out, 2i64) != w2 { return 4i32; }
    if cnt_of(&out, 3i64) != w3 { return 5i32; }
    // ⚠ THE GROUP POPULATION, BY COUNT. Without this, a handle that invented an
    // eighth group nobody asked about would pass every lookup above. `-1` in the
    // table means "absent", so the expected size is the number of non-`-1`
    // entries and it is DERIVED here rather than passed in.
    let mut want_n: i64 = 0i64;
    if w1 >= 0i64 { want_n = want_n + 1i64; }
    if w2 >= 0i64 { want_n = want_n + 1i64; }
    if w3 >= 0i64 { want_n = want_n + 1i64; }
    if out.len() != want_n { return 6i32; }

    // (ii) THE INDEPENDENT NAIVE CLOSURE over the accumulated input.
    if naive_count(acc.as_slice(), 1i64) != w1 { return 7i32; }
    if w2 >= 0i64 { if naive_count(acc.as_slice(), 2i64) != w2 { return 8i32; } }
    if w3 >= 0i64 { if naive_count(acc.as_slice(), 3i64) != w3 { return 9i32; } }

    // (iii) THE BATCH CONTROL — same emitter, so agreement here says the
    // cross-epoch entry did not diverge from the from-scratch one, and says
    // NOTHING about whether either is right. That is what (ii) is for.
    let bout: Vec<(i64, i64)> = match tc(acc.as_slice()) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 10i32; }
    };
    if bout.len() != out.len() { return 11i32; }
    if cnt_of(&bout, 1i64) != w1 { return 12i32; }
    if cnt_of(&bout, 2i64) != w2 { return 13i32; }
    if cnt_of(&bout, 3i64) != w3 { return 14i32; }
    return 0i32;
}

fn main() -> i32 {
    let mut h: TcIncr = tc_incremental();
    let mut acc: Vec<E> = vec_new::<E>();

    // E1 — (1,2). One fact, one derived row.
    let r1: i32 = step(&mut h, &mut acc, &edge(1i64, 2i64), 1i64, -1i64, -1i64);
    if r1 != 0i32 { return 10i32 + r1; }
    // E2 — (2,3). THE TRANSITIVE ONE: (1,3) comes from an OLD path row joined
    // with a NEW edge, which is the derivation a delta-only round 0 misses.
    let r2: i32 = step(&mut h, &mut acc, &edge(2i64, 3i64), 2i64, 1i64, -1i64);
    if r2 != 0i32 { return 30i32 + r2; }
    // E3 — (3,1) CLOSES THE CYCLE. Every member reaches every member.
    let r3: i32 = step(&mut h, &mut acc, &edge(3i64, 1i64), 3i64, 3i64, 3i64);
    if r3 != 0i32 { return 50i32 + r3; }
    // E4 — (2,2) a SELF-LOOP ALREADY IN THE CLOSURE. Nothing may move.
    let r4: i32 = step(&mut h, &mut acc, &edge(2i64, 2i64), 3i64, 3i64, 3i64);
    if r4 != 0i32 { return 70i32 + r4; }
    // E5 — (1,4). Node 4 becomes reachable from all three, by paths of
    // DIFFERENT LENGTHS from 1 (direct) and from 2 and 3 (through the cycle).
    let r5: i32 = step(&mut h, &mut acc, &edge(1i64, 4i64), 4i64, 4i64, 4i64);
    if r5 != 0i32 { return 90i32 + r5; }
    // E6 — (3,4), a SECOND PATH to an already-reachable node. Nothing may move.
    let r6: i32 = step(&mut h, &mut acc, &edge(3i64, 4i64), 4i64, 4i64, 4i64);
    if r6 != 0i32 { return 110i32 + r6; }
    // E7 — (1,2) A DUPLICATE EDGE. A rel is a SET; nothing may move.
    let r7: i32 = step(&mut h, &mut acc, &edge(1i64, 2i64), 4i64, 4i64, 4i64);
    if r7 != 0i32 { return 130i32 + r7; }

    // ── THE METAMORPHIC LAW, and it is not a fourth witness of the same rows.
    // For any SPLIT of one edge multiset into epochs, the snapshot equals the
    // batch over the concatenation. Above, the split is seven singletons; here
    // it is ONE epoch carrying all seven at once — the shape in which the
    // per-epoch dedup and the cross-epoch dedup are the SAME code path, so a
    // handle that only deduped within a call would pass this and fail above,
    // and one that only deduped across calls would do the reverse.
    let mut h2: TcIncr = tc_incremental();
    match tc_epoch(&mut h2, acc.as_slice()) {
        Result::Ok(_n) => { } Result::Err(_e) => { return 150i32; }
    }
    let o2: Vec<(i64, i64)> = match tc_snapshot(&h2) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 151i32; }
    };
    if o2.len() != 3i64          { return 152i32; }
    if cnt_of(&o2, 1i64) != 4i64 { return 153i32; }
    if cnt_of(&o2, 2i64) != 4i64 { return 154i32; }
    if cnt_of(&o2, 3i64) != 4i64 { return 155i32; }

    // ── AND A SATURATED HANDLE RE-FED ITS OWN INPUT MUST NOT MOVE. The
    // strongest form of the outbound boundary: every fact is already present,
    // so the fixpoint gains no row and the fold sees an EMPTY suffix. A `+1`
    // over the whole total (rather than over the new rows) doubles every count
    // here, and a weight crossing outbound does the same.
    match tc_epoch(&mut h2, acc.as_slice()) {
        Result::Ok(n) => { if n != 0i64 { return 156i32; } }
        Result::Err(_e) => { return 157i32; }
    }
    let o3: Vec<(i64, i64)> = match tc_snapshot(&h2) {
        Result::Ok(v) => { v } Result::Err(_e) => { return 158i32; }
    };
    if o3.len() != 3i64          { return 159i32; }
    if cnt_of(&o3, 1i64) != 4i64 { return 160i32; }
    if cnt_of(&o3, 2i64) != 4i64 { return 161i32; }
    if cnt_of(&o3, 3i64) != 4i64 { return 162i32; }

    return 0i32;
}
