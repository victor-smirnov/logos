// AN OVER-REFUSAL THE SAME CARRY REPAIRS, IN THE OTHER DIRECTION. Under a `&mut`
// scrutinee the tuple door handed its sub-pattern the BARE element type, so the
// nested payload bound BY VALUE and `a.n = …` was refused with "assignment to
// immutable variable 'a'" on the base binary 95d01d3ae0a1858d. Carrying the mode
// gives `a : &mut D`, the write lands in the scrutinee, and the payload is dropped
// ONCE. COUNT = 6 (the payload's v after the write), asserted through the drop.
// This program has no soundness-queue row: it was found by the 2026-09-07q matrix
// and is pinned here so the gain ratchets.
package dbmcarry_mutref_tuple_nested_payload_write;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut r: i64 = 0i64;
    {
        let mut t: (Option<D>, i64) = (Option::Some(D { v: 5i64, c: p }), 9i64);
        match &mut t {
            (Option::Some(a), b) => { a.v = a.v + 1i64; r = a.v + *b; },
            (Option::None, _) => {}
        }
    }
    if r != 15i64 { return 2i32; }
    unsafe { printf("%ld\n".as_ptr(), n); }
    return 0i32;
}
