// wql_engine_source_e2e — THE ENGINE AS A SOURCE (ADR 0016 M5, case S).
// A `deem!` parameter typed `&IncrRec` exposes the reasoner's own past as
// four native relations — <p>_trace, <p>_epochs, <p>_tail, <p>_controls —
// materialized by logos.std.deem's state materializers. This is ADR 0015's
// I1 as a mapping-class contract, and it replaces the hand-rolled per-test
// materialization of the L0/L1 Observer tests. Asserts:
//   (a) the ENCOUNTER rule as a static deem! query over <p>_tail: one row
//       (epoch, pending>0) at the budget cut — decision-time irreducibility;
//   (b) the honesty pair's second half: after raise+converge the SAME query
//       returns zero rows — the residual dissolves in retrospect;
//   (c) Σδ CONSISTENCY as an aggregate over <p>_trace: sum(delta) == the
//       engine's maintained cardinality (the S1 oracle, now IN Deem itself);
//   (d) <p>_controls audits the applied atoms (the raise is visible);
//   (e) <p>_epochs counts epoch() calls.
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.std.wql.wql;

pub schema Edge : code(0x0E20_0000_0000_0002) { src: i64 = 0, dst: i64 = 1 }
resource cat = schema_catalog!{ Edge };

// the L0 Observer's Encounter rule — statically compiled, over the engine
pub deem encounters(e: &IncrRec) {
    from e_tail t where t.converged == 0 && t.pending > 0 select (t.epoch, t.pending)
}
// the S1 consistency oracle — IN Deem: Σ delta over the whole trace
pub deem delta_sum(e: &IncrRec) {
    from e_trace t group by t.kind aggregate s = sum(t.delta) select (key, s)
}
// applied raise-budget atoms (kind 1)
pub deem raises(e: &IncrRec) {
    from e_controls c where c.kind == 1 select (c.epoch, c.val)
}
// epochs ledger
pub deem n_epochs(e: &IncrRec) {
    from e_epochs x select x.epoch
}

fn mk_edge(d: &Writ, s: i64, t: i64) -> WAny {
    let ee: Edge = d.make::<Edge>();
    ee.src = s; ee.dst = t;
    return WAny::ref_to((ee.m as i64) as *const u8);
}
fn build_src(d: &Writ, hs: &Vec<WAny>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(64i64);
    let mut i: i64 = 0i64;
    while i < hs.len() { arr.push(hs.get(i)); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}
fn snap_count(e: &IncrRec) -> i64 {
    let s: QRows = e.snapshot();
    return s.row_count();
}

fn main() -> i32 {
    let doc: Writ = writ_new(65536i64);
    let c: SchemaCatalog = cat();
    let q: Query = match Query::compile(
        r#"rel path(a: i64, b: i64) {
             from edges x select (x.src, x.dst);
             from path p join edges x on p.b == x.src select (p.a, x.dst);
           }
           from path p select (p.a, p.b)"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };
    let mut hs: Vec<WAny> = vec_new::<WAny>();
    let mut k: i64 = 0i64;
    while k < 10i64 { hs.push(mk_edge(&doc, k, k + 1i64)); k = k + 1i64; }
    let mut seed: Vec<WAny> = vec_new::<WAny>();
    seed.push(hs.get(0i64));
    let mut env: QEnv = QEnv::new();
    env.bind_source("edges", build_src(&doc, &seed));
    let mut eng: IncrRec = match q.incremental_rec(&env)
    { Result::Ok(v) => { v } Result::Err(_e2) => { return 91i32; } };

    // budget via the lawful control path; one big epoch → cut
    eng.control_set_budget_steps(1i64);
    let mut d1: ZBatch = ZBatch::new();
    let mut k2: i64 = 1i64;
    while k2 < 10i64 { d1.push(hs.get(k2), 1i64); k2 = k2 + 1i64; }
    eng.epoch(&d1);
    if eng.is_converged() { return 1i32; }

    // ── (a) Encounter, decision-time: one row, pending > 0, cut epoch ──────
    let enc1: Vec<(i64, i64)> = match encounters(&eng)
    { Result::Ok(v) => { v } Result::Err(_e3) => { return 2i32; } };
    if enc1.len() != 1i64 { return 3i32; }
    let e0: (i64, i64) = enc1.get(0i64);
    if e0.0 != 1i64 { return 4i32; }     // the cut epoch
    if e0.1 <= 0i64 { return 5i32; }     // registered residual

    // raise (journaled) + resume to convergence
    eng.control_raise_budget(100i64);
    let d2: ZBatch = ZBatch::new();
    eng.epoch(&d2);
    if !eng.is_converged() { return 6i32; }

    // ── (b) post-hoc: the SAME rule now derives nothing ────────────────────
    let enc2: Vec<(i64, i64)> = match encounters(&eng)
    { Result::Ok(v) => { v } Result::Err(_e4) => { return 7i32; } };
    if enc2.len() != 0i64 { return 8i32; }

    // ── (c) Σδ consistency IN Deem: Σ over all kinds == cardinality ────────
    let ds: Vec<(i64, i64)> = match delta_sum(&eng)
    { Result::Ok(v) => { v } Result::Err(_e5) => { return 9i32; } };
    let mut total: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < ds.len() {
        let r: (i64, i64) = ds.get(i);
        total = total + r.1;
        i = i + 1i64;
    }
    if total != snap_count(&eng) { return 10i32; }
    if total != 55i64 { return 11i32; }               // C(11,2): full closure

    // ── (d) the applied raise is auditable ─────────────────────────────────
    let rs: Vec<(i64, i64)> = match raises(&eng)
    { Result::Ok(v) => { v } Result::Err(_e6) => { return 12i32; } };
    if rs.len() != 1i64 { return 13i32; }
    let r0: (i64, i64) = rs.get(0i64);
    if r0.0 != 2i64 || r0.1 != 100i64 { return 14i32; }

    // ── (e) epochs ledger ───────────────────────────────────────────────────
    let ep: Vec<i64> = match n_epochs(&eng)
    { Result::Ok(v) => { v } Result::Err(_e7) => { return 15i32; } };
    if ep.len() != 2i64 { return 16i32; }

    return 0i32;
}
