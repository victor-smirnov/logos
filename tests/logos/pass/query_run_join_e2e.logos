// queue-2 I2 — the runtime JOIN CASCADE (ADR 0012-queue2 §7): the tier is
// decided at CHECK time from CHECKED types (never per row) —
//   • i64 equi-key + residual        → HASH tier (FNV bucket + rt_eq verify
//                                      + residual conjunct after the probe);
//   • f64 == f64 equi-term           → LOOP tier (PartialEq only — NaN kills
//                                      Hash and total Ord; full predicate);
//   • anti join, no residual         → hash ABSENCE test (kept iff no match).
// Row order is left-major/source order (the static nested-loop baseline).
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.query;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Emp : code(0x0B02_0000_0000_0001) {
    name: str = 0,
    dept: i64 = 1,
    age:  i64 = 2,
    rate: f64 = 3,
}

pub schema Dept : code(0x0B02_0000_0000_0002) {
    id:      i64 = 0,
    dname:   str = 1,
    cap:     f64 = 2,
    min_age: i64 = 3,
}

impl Emp  { pub fn as_any(self: &Emp)  -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }
impl Dept { pub fn as_any(self: &Dept) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }

resource cat = schema_catalog!{ Emp, Dept };

fn mk_emp(d: &Writ, name: str, dept: i64, age: i64, rate: f64) -> WAny {
    let e: Emp = d.make::<Emp>();
    e.name = name;
    e.dept = dept;
    e.age  = age;
    e.rate = rate;
    let w: i64 = e.m as i64;
    return WAny::ref_to(w as *const u8);
}

fn mk_dept(d: &Writ, id: i64, dname: str, cap: f64, min_age: i64) -> WAny {
    let x: Dept = d.make::<Dept>();
    x.id      = id;
    x.dname   = dname;
    x.cap     = cap;
    x.min_age = min_age;
    let w: i64 = x.m as i64;
    return WAny::ref_to(w as *const u8);
}

fn main() -> i32 {
    let d: Writ = writ_new(8192i64);
    let emps: &mut WArray<WAny> = d.array(8i64);
    emps.push(mk_emp(&d, "Ann", 1i64, 45i64, 1.5f64));
    emps.push(mk_emp(&d, "Bob", 2i64, 55i64, 2.5f64));
    emps.push(mk_emp(&d, "Cid", 1i64, 35i64, 3.5f64));
    emps.push(mk_emp(&d, "Dan", 9i64, 40i64, 4.5f64));   // dept 9 has no Dept row
    let esrc: WAny = WAny::ref_to(emps as *const WArray<WAny> as *const u8);

    let depts: &mut WArray<WAny> = d.array(4i64);
    depts.push(mk_dept(&d, 1i64, "Core", 1.5f64, 30i64));
    depts.push(mk_dept(&d, 2i64, "Ops",  9.9f64, 40i64));
    let dsrc: WAny = WAny::ref_to(depts as *const WArray<WAny> as *const u8);

    let c: SchemaCatalog = cat();
    let mut env: QEnv = QEnv::new();
    env.bind_source("emps", esrc);
    env.bind_source("depts", dsrc);

    // ── HASH tier: i64 equi-key + RESIDUAL (e.age > d.min_age) ────────────
    let q1: Query = match Query::compile(
        "from emps e join depts d on e.dept == d.id && e.age > d.min_age select (d.dname, e.name)",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e) => { return 1i32; }
    };
    let r1: QRows = match q1.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e2) => { return 2i32; }
    };
    if r1.row_count() != 3i64 { return 3i32; }
    if !str_eq(r1.get_str(0i64, 0i64), "Core") { return 4i32; }
    if !str_eq(r1.get_str(0i64, 1i64), "Ann")  { return 5i32; }
    if !str_eq(r1.get_str(1i64, 0i64), "Ops")  { return 6i32; }
    if !str_eq(r1.get_str(1i64, 1i64), "Bob")  { return 7i32; }
    if !str_eq(r1.get_str(2i64, 0i64), "Core") { return 8i32; }
    if !str_eq(r1.get_str(2i64, 1i64), "Cid")  { return 9i32; }

    // ── LOOP tier: f64 == f64 equi-term (PartialEq only) ──────────────────
    let q2: Query = match Query::compile(
        "from emps e join depts d on e.rate == d.cap select e.name", &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e3) => { return 10i32; }
    };
    let r2: QRows = match q2.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e4) => { return 11i32; }
    };
    if r2.row_count() != 1i64 { return 12i32; }
    if !str_eq(r2.get_str(0i64, 0i64), "Ann") { return 13i32; }

    // ── ANTI join, hash tier, no residual (pure absence test) ─────────────
    let q3: Query = match Query::compile(
        "from emps e anti join depts d on e.dept == d.id select e.name", &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e5) => { return 14i32; }
    };
    let r3: QRows = match q3.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e6) => { return 15i32; }
    };
    if r3.row_count() != 1i64 { return 16i32; }
    if !str_eq(r3.get_str(0i64, 0i64), "Dan") { return 17i32; }

    // ── ANTI + residual: kept iff no dept matches BOTH conjuncts ──────────
    let q4: Query = match Query::compile(
        "from emps e anti join depts d on e.dept == d.id && d.min_age > e.age select e.name",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e7) => { return 18i32; }
    };
    let r4: QRows = match q4.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e8) => { return 19i32; }
    };
    // Ann(1,45): Core min30>45 no → kept; Bob(2,55): Ops 40>55 no → kept;
    // Cid(1,35): Core 30>35 no → kept; Dan(9): no dept at all → kept.
    if r4.row_count() != 4i64 { return 20i32; }

    // ── 3-level chain: emps → depts (hash) → back over emps (loop) ────────
    let q5: Query = match Query::compile(
        "from depts d join emps e on e.dept == d.id join emps m on m.age > e.age && m.dept == e.dept select (e.name, m.name)",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e9) => { return 21i32; }
    };
    let r5: QRows = match q5.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e10) => { return 22i32; }
    };
    // d=Core: e=Ann(45) → m older in dept1: none(45 max? Cid35 no) → 0;
    //         e=Cid(35) → m=Ann(45) → (Cid, Ann)
    // d=Ops:  e=Bob(55) → none.
    if r5.row_count() != 1i64 { return 23i32; }
    if !str_eq(r5.get_str(0i64, 0i64), "Cid") { return 24i32; }
    if !str_eq(r5.get_str(0i64, 1i64), "Ann") { return 25i32; }

    return 0i32;
}
