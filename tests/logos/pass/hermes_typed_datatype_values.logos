// Hermes SDN datatype instantiation forms:
//   @Type = <initializer>
//   "string" @Type(params)
package hermes_typed_datatype_values;

use hermes.ctr;
use hermes.anyval;
use hermes.typetag;
use hermes.datatag;
use hermes.array;
use hermes.map;
use hermes.typed_value;
use hermes.string;
use std.lang.text;

unsafe fn cstr_eq_bytes(p: *const u8, n: u64, lit: *const u8) -> bool {
    let mut i: i64 = 0 as i64;
    while i < n as i64 {
        if *((lit as i64 + i) as *const u8) == 0 as u8 { return false; }
        if *((p as i64 + i) as *const u8) != *((lit as i64 + i) as *const u8) { return false; }
        i = i + 1 as i64;
    }
    return *((lit as i64 + n as i64) as *const u8) == 0 as u8;
}

unsafe fn main() -> i32 {
    let mut d: Hermes = Hermes::new(8192);
    let txt: str =
        r#"{
            "a": @I64 = 42, 
            "b": "123.45" @Decimal(10,2),
            "c": @Point({"fmt": "xy"})={"x":1,"y":2}
        }"#;

    match d.parse(txt) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 1; }
    }

    let root: AnyVal = d.root();
    if !root.is_ptr() { return 2; }

    let va: AnyVal = d.map_get(root, "a");
    let vb: AnyVal = d.map_get(root, "b");
    let vc: AnyVal = d.map_get(root, "c");
    if va.is_null() || vb.is_null() || vc.is_null() { return 3; }

    let base: *const u8 = d.base();
    let oa: *const u8 = (base as i64 + va.as_offset() as i64) as *const u8;
    let ob: *const u8 = (base as i64 + vb.as_offset() as i64) as *const u8;
    let oc: *const u8 = (base as i64 + vc.as_offset() as i64) as *const u8;
    if read_type_code(oa) != 4115 as u64 || read_type_code(ob) != 102 as u64 || read_type_code(oc) != 4115 as u64 {
        return 4;
    }

    let ta: *const TypedValue = oa as *const TypedValue;
    let tc: *const TypedValue = oc as *const TypedValue;

    let hsa: *const HermesString = (base as i64 + ta.type_off.offset as i64) as *const HermesString;
    let hsc: *const HermesString = (base as i64 + tc.type_off.offset as i64) as *const HermesString;
    if !cstr_eq_bytes(hsa.bytes(), hsa.len(), "I64".as_ptr()) { return 5; }
    if !cstr_eq_bytes(hsc.bytes(), hsc.len(), "Point".as_ptr()) { return 6; }

    let inita: AnyVal = AnyVal { raw: ta.init_raw };
    if d.get_i64(inita) != 42 as i64 { return 7; }
    if d.decimal_precision(vb) != 10 as u32 { return 8; }
    if d.decimal_scale(vb) != 2 as u32 { return 9; }
    let ds: String = d.decimal_to_string(vb);
    if !ds.eq_str("123.45") { return 10; }

    let paramsc: AnyVal = AnyVal { raw: tc.params_raw };
    if !paramsc.is_ptr() { return 11; }
    let opc: *const u8 = (base as i64 + paramsc.as_offset() as i64) as *const u8;
    if read_type_code(opc) != 100 as u64 { return 12; }
    let arrc: *const ObjectArray = opc as *const ObjectArray;
    if arrc.size != 1 as u64 { return 13; }
    let p0: AnyVal = arrc.get(base, 0 as u64);
    if !p0.is_ptr() { return 14; }
    let p0o: *const u8 = (base as i64 + p0.as_offset() as i64) as *const u8;
    if read_type_code(p0o) != 101 as u64 { return 15; }

    let initc: AnyVal = AnyVal { raw: tc.init_raw };
    if !initc.is_ptr() { return 16; }
    let i0: *const u8 = (base as i64 + initc.as_offset() as i64) as *const u8;
    if read_type_code(i0) != 101 as u64 { return 17; }

    return 0;
}
