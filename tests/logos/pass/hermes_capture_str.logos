// Hermes capture: str captured as HString into @-literals (hermes2 template path).
// C7-fix2: added stringify verification of captured string values.
package hermes_capture_str;
use logos.lang.hermes.tmpl;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.mem.hermes.stringify;
use logos.mem.rc;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    // Capture a string into a map.
    let s: str = "hello";
    let doc: Rc<Hermes> = @{"msg": $s};
    let h: &Hermes = doc.deref();
    let root: HAny = h.root();
    if root.is_null() { return 1; }
    // Verify the map contains the expected string value.
    let t1: String = stringify(root);
    if !t1.eq_str("{\"msg\": \"hello\"}") { return 2; }

    // Capture strings in an array.
    let key: str = "world";
    let arr_doc: Rc<Hermes> = @[$key, $s];
    let ah: &Hermes = arr_doc.deref();
    let arr_root: HAny = ah.root();
    if arr_root.is_null() { return 3; }
    let t2: String = stringify(arr_root);
    if !t2.eq_str("[\"world\", \"hello\"]") { return 4; }

    // Mix: scalar + string capture in same literal.
    let id: i32 = 7;
    let label: str = "item";
    let mix: Rc<Hermes> = @{"id": $id, "label": $label};
    let mh: &Hermes = mix.deref();
    let mix_root: HAny = mh.root();
    if mix_root.is_null() { return 5; }
    let t3: String = stringify(mix_root);
    if !t3.eq_str("{\"id\": 7, \"label\": \"item\"}") { return 6; }

    return 0;
}
