// SL-sl-03: Option::as_ref / Option::as_mut — safe (no unsafe block)
// via `ref v` / `ref mut v` bindings in match arms.
//
// `ref v` inside `Option::Some(ref v)` (or any PAT_VARIANT_DATA) now
// binds `v` to a reference to the payload slot instead of a value
// copy. Sema wraps the variant binding's type in `Ref`/`MutRef`;
// mlir-gen detects the synthetic wrap (pvd_binding_types[bi] is Ref
// but vp->logos_types[bi] isn't) and binds to the payload's GEP
// address rather than emitting a load.
//
// This closes the long-standing gap where `Option::Some(ref v)` was
// flattened to a plain `v` binding because PAT_VARIANT_DATA's
// `bindings` list stored only names (no per-binding IS_REF flag).

package option_as_ref_as_mut;

use std.lang.option;

fn main() -> i32 {
    // as_ref on Some — read through the returned &T.
    let o: Option<i32> = Option::Some(42i32);
    match o.as_ref() {
        Option::Some(r) => { if *r != 42i32 { return 1i32; } }
        Option::None    => { return 2i32; }
    }

    // as_ref on None — returns None.
    let n: Option<i32> = Option::None;
    match n.as_ref() {
        Option::Some(_) => { return 3i32; }
        Option::None    => { }
    }

    // as_mut on Some — mutate the underlying payload through the &mut.
    let mut m: Option<i32> = Option::Some(10i32);
    match m.as_mut() {
        Option::Some(r) => { *r = 99i32; }
        Option::None    => { return 4i32; }
    }
    match m {
        Option::Some(v) => { if v != 99i32 { return 5i32; } }
        Option::None    => { return 6i32; }
    }

    return 0i32;
}
