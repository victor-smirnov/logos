// Payload moves that only SOME paths make: a false guard, two guarded arms of one variant moving different fields, the move inside a loop (rustc 1.98.1).
package enum_payload_partial_move_flagged;
extern fn printf(fmt: *const u8, ...) -> i32;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i * 10i64 + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
enum E { V(S, S), W(S) }
fn mkv(p: *mut i64) -> E { return E::V(S { v: 1i64, i: p }, S { v: 2i64, i: p }); }
fn g_false(p: *mut i64) { let e: E = mkv(p); let g: bool = false; match e { E::V(a, _) if g => { let _k: i64 = eat(a); }, _ => {} } }
fn two_arms(g: bool, p: *mut i64) { let e: E = mkv(p); match e { E::V(a, _) if g => { let _k: i64 = eat(a); }, E::V(_, b) => { let _k: i64 = eat(b); }, E::W(_) => {} } }
fn in_loop(p: *mut i64) { let mut n: i64 = 0i64; while n < 2i64 { let e: E = mkv(p); match e { E::V(_, b) => { let _k: i64 = eat(b); }, E::W(_) => {} } n = n + 1i64; } }
fn run(n: i64, p: *mut i64) -> i64 {
    unsafe { *p = 0i64; }
    if n == 0i64 { g_false(p); } else if n == 1i64 { two_arms(true, p); } else if n == 2i64 { two_arms(false, p); } else { in_loop(p); }
    return unsafe { *p };
}
fn main() -> i32 {
    let mut q: i64 = 0i64; let p: *mut i64 = &mut q;
    let mut n: i64 = 0i64;
    while n < 4i64 { unsafe { printf("%lld ".as_ptr(), run(n, p)); } n = n + 1i64; }
    unsafe { printf("\n".as_ptr()); }
    return 0i32;
}
