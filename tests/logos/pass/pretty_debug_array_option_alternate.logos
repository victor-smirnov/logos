// `{:#?}` of arrays and Option: the std impls go through debug_list / debug_tuple, which honour the alternate flag.
package pretty_debug_array_option_alternate;
use logos.std.fmt;
use logos.mem.string;
fn main() -> i32 {
    if format!("{:#?}", [1i64, 2i64]) != "[\n    1,\n    2,\n]" { return 1i32; }
    let o: Option<i64> = Some(5i64);
    if format!("{:#?}", o) != "Some(\n    5,\n)" { return 2i32; }
    return 0i32;
}
