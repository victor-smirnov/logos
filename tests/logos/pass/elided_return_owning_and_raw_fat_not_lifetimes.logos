// An owning `Box<[T]>` and a raw fat pointer share `&[T]`'s representation but are no
// lifetime position: `mk() -> Box<[i32]>` needs no annotation, and in
// `pick(p: *const [i32], x: &i32) -> &i32` the only input lifetime is x's (rustc 1.98.1: exit 0).
package elided_return_owning_and_raw_fat_not_lifetimes;
use logos.mem.boxed;

fn pick(p: *const [i32], x: &i32) -> &i32 { return x; }
fn mk() -> Box<[i32]> { return box_new::<[i32; 3]>([5, 6, 7]) as Box<[i32]>; }

fn main() -> i32 {
    let a: [i32; 1] = [1i32];
    let b: Box<[i32]> = mk();
    let r: &i32 = pick(&a[..] as *const [i32], &b[2]);
    return *r - 7i32;
}
