// `*b = v[0] + 1`: the RHS index is a READ (Index), only the LHS is the mutable-use position; legal, runs.
// PROBES.md 2026-09-08a: a place in a mutable-use position takes the DerefMut/IndexMut step at every level, a Deref-only/Index-only step is refused, and the bare `deref_mut()` receiver is asked the binding-mut question.
package bc_mutplace_index_read_in_rhs_of_deref_write;
fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    v.push(3i64);
    let mut b: Box<i64> = Box::new(0i64);
    *b = v[0] + 1i64;
    if *b != 4i64 { return 1i32; }
    return 0i32;
}
