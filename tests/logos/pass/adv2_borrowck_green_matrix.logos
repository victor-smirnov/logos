// Adversarial #2 green matrix: NLL last-use, two-phase borrow, disjoint
// field split borrows, match &mut payload, loop reborrows, partial-move
// field reinit — all Rust-accepts that must stay accepted AND compute right.
package adv2_borrowck_green_matrix;
struct S { x: i64, y: i64 }
enum E { A(i64), B }
fn main() -> i32 {
    let mut v: Vec<i64> = Vec::<i64>::new();
    v.push(10i64);
    let r: &i64 = &v[0];
    let x: i64 = *r;                  // NLL: last use before mutation
    v.push(v.len() as i64);           // two-phase borrow
    if x != 10i64 { return 1i32; }
    if v[1] != 1i64 { return 2i32; }
    let mut s = S { x: 1i64, y: 2i64 };
    let a: &mut i64 = &mut s.x;       // disjoint field splits
    let b: &mut i64 = &mut s.y;
    *a += 10i64; *b += 20i64;
    if s.x + s.y != 33i64 { return 3i32; }
    let mut e = E::A(5i64);
    match &mut e { E::A(p) => { *p += 1i64; } E::B => { return 4i32; } }
    match e { E::A(p) => { if p != 6i64 { return 5i32; } } E::B => { return 6i32; } }
    let mut total = 0i64;
    let m: &mut i64 = &mut total;
    let mut i = 0i64;
    while i < 3i64 { *(&mut *m) += i; i += 1i64; }
    if total != 3i64 { return 7i32; }
    return 0i32;
}
