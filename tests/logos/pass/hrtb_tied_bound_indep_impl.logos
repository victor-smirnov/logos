// B63: a bound that ties two trait-arg slots to the same binder is
// satisfied by an impl that uses independent params — impl is strictly
// more general (can produce Foo<&x,&x> by setting both params to x).
package hrtb_tied_bound_indep_impl;

trait Foo<X, Y> { fn foo(self: Self, x: X, y: Y) -> i32; }

struct S { _x: i32 }
impl<'a, 'b> Foo<&'a i64, &'b i64> for S {
    fn foo(self: S, x: &'a i64, y: &'b i64) -> i32 { return 0i32; }
}

fn want_tied<T>(t: T) -> i32
    where T: for<'z> Foo<&'z i64, &'z i64>
{
    let a: i64 = 1i64;
    return t.foo(&a, &a);
}

fn main() -> i32 {
    return want_tied::<S>(S{ _x: 0i32 });
}
