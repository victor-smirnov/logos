// Test: let b = a moves a; only b is dropped, not a
package drop_move_let;

extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }

trait Drop { fn drop(self: Self); }

struct Res { id: i32, }

impl Drop for Res {
    fn drop(self: Res) { printi("d%d ", self.id); }
}

unsafe fn main() -> i32 {
    let result: i32 = 42;
    let a: Res = Res { id: 1 };
    let b: Res = a;
    // a is moved into b; only b should be dropped once
    return result;
}
