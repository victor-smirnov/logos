// Tests std.data.persistent.uid256: zero, random, Eq, Hash.
package test;

use std.data.persistent.uid256;
use std.lang.cmp;
use std.lang.hash;

fn main() -> i32 {
    // 1. uid256_zero is all zeros and is_zero() reports true.
    let z: UID256 = uid256_zero();
    if !z.is_zero() { return 1; }

    // 2. uid256_random is (almost surely) non-zero.
    let r1: UID256 = uid256_random();
    if r1.is_zero() { return 2; }

    // 3. Two random UIDs differ (probability of collision is 2^-256).
    let r2: UID256 = uid256_random();
    if (&r1).eq(&r2) { return 3; }

    // 4. Eq is reflexive.
    if !(&r1).eq(&r1) { return 4; }

    // 5. Eq distinguishes zero from random.
    if (&z).eq(&r1) { return 5; }

    // 6. Hash: same UID hashes to the same value twice.
    let mut h1: FxHasher = fx_hasher_new();
    let mut h2: FxHasher = fx_hasher_new();
    (&r1).hash(&mut h1);
    (&r1).hash(&mut h2);
    if h1.finish() != h2.finish() { return 6; }

    // 7. Hash: different UIDs almost surely hash differently.
    let mut h3: FxHasher = fx_hasher_new();
    let mut h4: FxHasher = fx_hasher_new();
    (&r1).hash(&mut h3);
    (&r2).hash(&mut h4);
    if h3.finish() == h4.finish() { return 7; }

    return 42;
}
