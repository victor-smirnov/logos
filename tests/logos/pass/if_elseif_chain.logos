package if_elseif_chain;
// F05: else-if chain
fn classify(x: i32) -> i32 {
    if x < 0   { return 0; }
    else if x < 10  { return 1; }
    else if x < 100 { return 2; }
    else            { return 3; }
}
fn main() -> i32 {
    let a: i32 = classify(-5);   // 0
    let b: i32 = classify(7);    // 1
    let c: i32 = classify(42);   // 2
    let d: i32 = classify(200);  // 3
    // 0+1+2+3 = 6, need 42: 6 * 7 = 42
    return (a + b + c + d) * 7;
}
