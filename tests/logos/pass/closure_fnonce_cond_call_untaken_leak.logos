// An `FnOnce` closure called in one branch only: the capture is destroyed
// exactly once on either path (squeue #141). The release of a move-closure
// capture merges at the branch like a conditional move — flagged, the flag
// cleared on the consuming path, the drop guarded (rustc 1.98.1: exit 0).
package closure_fnonce_cond_call_untaken_leak;

struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut r: i64 = -1i64;
    {
        let x: D = D { v: 1i64, c: p };
        let f = move || -> i64 { let t: D = x; return t.v; };
        if n == 7i64 { r = f(); } else { r = 5i64; }
    }
    let got: i64 = unsafe { n };
    if got != 1i64 { return 1i32; }
    if r != 5i64 { return 3i32; }
    return 0i32;
}
