package test;

use std.hashmap;

fn main() -> i32 {
    unsafe {
        let mut m: HashMap<i32, i32> = hashmap_new::<i32, i32>();
        let pm: *mut HashMap<i32, i32> = &mut m;
        let c: i64 = pm.capacity();
        let l: i64 = pm.len();
        let empty: bool = pm.is_empty();
        if !empty { return 99 as i32; }
        return (c + l) as i32;
    }
}
