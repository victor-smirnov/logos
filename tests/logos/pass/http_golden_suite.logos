// Golden suite: five scenarios over raw TCP against serve_bounded, each on
// its own connection.  Covers behaviors no existing test pins down:
//
//   conn1  pipelining        — 2 GETs back-to-back on one conn (close on #2)
//   conn2  chunked request   — POST with Transfer-Encoding: chunked
//   conn3  100-continue      — Expect: 100-continue acked before body
//   conn4  bad method        — non-tchar method byte → 400 Bad Request
//   conn5  CL+TE smuggling   — both framing headers → 400 Bad Request
//
// A single server fiber runs serve_bounded(count=5).  A single client
// fiber walks the five scenarios sequentially and returns a scenario-
// specific error code on mismatch, else exits 42.
//
// The server handler inspects req.url.path / req.body and encodes what it
// observed into the response body, so a simple substring match on the
// client side doubles as an end-to-end conformance check.

package test;

use std.io.http;
use std.io.net;
use logos.mem.string;
use logos.lang.str;
use std.collections.vec;
use logos.lang.option;
use logos.lang.result;
use logos.std.rt.fiber;

let TEST_PORT: u16 = 48407 as u16;

// ── Handler ──────────────────────────────────────────────────────────────

fn body_eq_str(body: &Vec<u8>, want: str) -> bool {
    unsafe {
        let bp: *mut Vec<u8> = body as *const Vec<u8> as *mut Vec<u8>;
        if bp.length() != want.len() { return false; }
        let mut i: i64 = 0 as i64;
        while i < want.len() {
            if bp.get(i) != want.as_ptr()[i] { return false; }
            i = i + 1;
        }
    }
    return true;
}

fn push_bytes(dst: &mut Vec<u8>, s: str) {
    let mut i: i64 = 0 as i64;
    unsafe {
        while i < s.len() { vec_push_u8(dst, s.as_ptr()[i]); i = i + 1; }
    }
}

fn handler(req: &Request) -> Response {
    let mut resp: Response = Response::new(200 as i32);
    let path: &String = &req.url.path;
    if (path).eq_str("/chk") {
        if body_eq_str(&req.body, "HelloWorld") {
            push_bytes(&mut resp.body, "CHK-OK");
        } else {
            push_bytes(&mut resp.body, "CHK-NO");
        }
        (&mut resp.headers).append("Content-Length", "6");
    } else if (path).eq_str("/cont") {
        if body_eq_str(&req.body, "abc") {
            push_bytes(&mut resp.body, "CONT-OK");
        } else {
            push_bytes(&mut resp.body, "CONT-NO");
        }
        (&mut resp.headers).append("Content-Length", "7");
    } else {
        push_bytes(&mut resp.body, "OK");
        (&mut resp.headers).append("Content-Length", "2");
    }
    return resp;
}

fn server_fiber(arg: i64) {
    let mut svc: FnService = fn_service(handler);
    let _: Result<(), HttpError> =
        serve_bounded::<FnService>(TEST_PORT, 5 as i64, &mut svc);
}

// ── Client helpers ───────────────────────────────────────────────────────

// Count non-overlapping occurrences of `needle` in buf[0..n].
fn count_substr(buf: *const u8, n: i64, needle: str) -> i64 {
    let nlen: i64 = needle.len();
    let np: *const u8 = needle.as_ptr();
    if nlen == 0 as i64 { return 0 as i64; }
    let mut i: i64 = 0 as i64;
    let mut hits: i64 = 0 as i64;
    unsafe {
        while i + nlen <= n {
            let mut ok: bool = true;
            let mut k: i64 = 0 as i64;
            while k < nlen && ok {
                if buf[i + k] != np[k] { ok = false; }
                k = k + 1;
            }
            if ok { hits = hits + 1; i = i + nlen; } else { i = i + 1; }
        }
    }
    return hits;
}

// Drain `s` until EOF or buffer full.  Returns bytes read, or -1 on I/O err.
fn recv_to_eof(s: &TcpStream, dst: *mut u8, cap: i64) -> i64 {
    let mut got: i64 = 0 as i64;
    loop {
        let into: *mut u8 = (dst as i64 + got) as *mut u8;
        let n: i64 = s.async_recv(into, cap - got);
        if n < 0 as i64 { return 0 - 1; }
        if n == 0 as i64 { return got; }
        got = got + n;
        if got >= cap { return got; }
    }
}

// Open + write + drain-to-EOF.  Returns bytes received, or -1 on connect /
// send / recv failure.  `rx` is zeroed so substring scans are deterministic.
fn exchange(req: str, rx: *mut u8, cap: i64) -> i64 {
    let ip: u32 = ip4(127 as u32, 0 as u32, 0 as u32, 1 as u32);
    let mut st: TcpStream = async_tcp_connect(ip, TEST_PORT);
    if !(&st).is_valid() { return 0 - 1; }
    let sent: i64 = (&st).async_send(req.as_ptr(), req.len());
    if sent < 0 as i64 { st.close(); return 0 - 1; }
    let got: i64 = recv_to_eof(&st, rx, cap);
    st.close();
    return got;
}

// ── Scenarios ────────────────────────────────────────────────────────────

// Scenario 1: pipelined GET /a + GET /b (Connection: close).
// Expect two "HTTP/1.1 200" status lines and two "OK" bodies on one conn.
fn scen1() -> i32 {
    let req: str =
        "GET /a HTTP/1.1\r\nHost: x\r\n\r\nGET /b HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n";
    let mut rx: [u8; 2048] = [0 as u8; 2048];
    let n: i64 = exchange(req, &mut rx[0] as *mut u8, 2048 as i64);
    if n < 0 as i64 { return 11; }
    if count_substr(&rx[0] as *const u8, n, "HTTP/1.1 200") != 2 as i64 { return 12; }
    // "OK" body appears once per response (= 2), but the ASCII "OK" also
    // appears in the status line "200 OK" (= 2), so total = 4.
    if count_substr(&rx[0] as *const u8, n, "OK") != 4 as i64 { return 13; }
    return 0;
}

// Scenario 2: POST /chk with Transfer-Encoding: chunked, "Hello"+"World".
// Handler reports CHK-OK iff it observed a decoded body of "HelloWorld".
fn scen2() -> i32 {
    let req: str =
        "POST /chk HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n5\r\nHello\r\n5\r\nWorld\r\n0\r\n\r\n";
    let mut rx: [u8; 1024] = [0 as u8; 1024];
    let n: i64 = exchange(req, &mut rx[0] as *mut u8, 1024 as i64);
    if n < 0 as i64 { return 21; }
    if count_substr(&rx[0] as *const u8, n, "HTTP/1.1 200") != 1 as i64 { return 22; }
    if count_substr(&rx[0] as *const u8, n, "CHK-OK") != 1 as i64 { return 23; }
    return 0;
}

// Scenario 3: POST /cont with Expect: 100-continue, CL=3 body "abc".
// Server must write an interim "HTTP/1.1 100 Continue\r\n\r\n" before the
// final 200.  Handler reports CONT-OK on body match.
fn scen3() -> i32 {
    let req: str =
        "POST /cont HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc";
    let mut rx: [u8; 1024] = [0 as u8; 1024];
    let n: i64 = exchange(req, &mut rx[0] as *mut u8, 1024 as i64);
    if n < 0 as i64 { return 31; }
    if count_substr(&rx[0] as *const u8, n, "HTTP/1.1 100") != 1 as i64 { return 32; }
    if count_substr(&rx[0] as *const u8, n, "HTTP/1.1 200") != 1 as i64 { return 33; }
    if count_substr(&rx[0] as *const u8, n, "CONT-OK")      != 1 as i64 { return 34; }
    return 0;
}

// Scenario 4: malformed request line — non-tchar byte in method.  Server
// must answer with 400 Bad Request and close.
fn scen4() -> i32 {
    let req: str = "G@T / HTTP/1.1\r\nHost: x\r\n\r\n";
    let mut rx: [u8; 512] = [0 as u8; 512];
    let n: i64 = exchange(req, &mut rx[0] as *mut u8, 512 as i64);
    if n < 0 as i64 { return 41; }
    if count_substr(&rx[0] as *const u8, n, "HTTP/1.1 400") != 1 as i64 { return 42; }
    // Must NOT be answered with 200 (handler must not have run).
    if count_substr(&rx[0] as *const u8, n, "HTTP/1.1 200") != 0 as i64 { return 43; }
    return 0;
}

// Scenario 5: CL + TE:chunked both present — smuggling vector, expect 400.
fn scen5() -> i32 {
    let req: str =
        "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n";
    let mut rx: [u8; 512] = [0 as u8; 512];
    let n: i64 = exchange(req, &mut rx[0] as *mut u8, 512 as i64);
    if n < 0 as i64 { return 51; }
    if count_substr(&rx[0] as *const u8, n, "HTTP/1.1 400") != 1 as i64 { return 52; }
    if count_substr(&rx[0] as *const u8, n, "HTTP/1.1 200") != 0 as i64 { return 53; }
    return 0;
}

fn client_fiber(arg: i64) {
    let rp: *mut i32 = arg as *mut i32;
    let r: i32 = scen1(); if r != 0 as i32 { unsafe { *rp = r; } return; }
    let r: i32 = scen2(); if r != 0 as i32 { unsafe { *rp = r; } return; }
    let r: i32 = scen3(); if r != 0 as i32 { unsafe { *rp = r; } return; }
    let r: i32 = scen4(); if r != 0 as i32 { unsafe { *rp = r; } return; }
    let r: i32 = scen5(); if r != 0 as i32 { unsafe { *rp = r; } return; }
    unsafe { *rp = 42; }
}

unsafe fn main() -> i32 {
    let s: *mut Scheduler = sched_new();
    sched_set_current(s);
    let r: *mut Reactor = reactor_new(64);
    if r == 0 as *mut Reactor { return 1; }
    reactor_set_current(r);

    let mut result: i32 = 0;
    let rp: i64 = &result as *const i32 as i64;
    spawn(server_fiber, 0 as i64);
    spawn(client_fiber, rp);
    reactor_run(s, r);

    reactor_free(r);
    sched_free(s);
    return result;
}
