// Remove patterns:
//   1. remove non-existent → returns false, container unchanged
//   2. remove all entries one by one → cr.len shrinks to 0, contains
//      goes false for every removed key as we go
//   3. interleaved insert + remove preserves invariants
//   4. remove half then re-insert (lazy underflow path; v1 doesn't
//      rebalance, just leaves leaves underfull — must still be readable)

package persistent_remove_patterns;

use logos.mem.collections.vec;
use logos.lang.mem;
use logos.lang.cmp; use logos.lang.cmp; use logos.lang.fabric;
use logos.lang.hermes.hstatic;

use logos.std.data.persistent.bt.node;
use logos.std.data.persistent.bt.cow;
use logos.std.data.persistent.store;
use logos.std.data.persistent.handle;

pub const StoreCfg: HermesStatic = @{
    "name": "rm-patterns", "ctr_id": <type:u64>, "snp_id": <type:u64>, "block_id": <type:u64>,
};
pub const MapCfg: HermesStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 8 };


fn main() -> i32 {
    let mut store: Store<StoreCfg> = store_open::<StoreCfg>();
    let mut snap: Snap<StoreCfg> = store.fork(GENESIS);

    // ── Stage 1: remove from empty container ──
    {
        let mut cr: ContainerRef<StoreCfg, MapCfg> =
            create_pmap::<MapCfg, StoreCfg>(&mut snap, 1u64);

        let k: u64 = 42u64;
        if cr.remove(k) { return 10; }
        if cr.len() != 0u64 { return 11; }
    }

    // ── Stage 2: insert N, remove all sequentially ──
    {
        let mut cr: ContainerRef<StoreCfg, MapCfg> =
            create_pmap::<MapCfg, StoreCfg>(&mut snap, 2u64);

        let mut i: u64 = 0u64;
        while i < 30u64 {
            cr.insert(i, i * 5u64);
            i = i + 1u64;
        }
        if cr.len() != 30u64 { return 20; }

        // Remove non-existent key → false, len unchanged.
        let absent: u64 = 9999u64;
        if cr.remove(absent) { return 21; }
        if cr.len() != 30u64 { return 22; }

        // Remove all 30 in order.
        i = 0u64;
        while i < 30u64 {
            if !cr.remove(i) { return 23; }
            if cr.contains(i) { return 24; }
            // remaining entries still there
            let after: u64 = i + 1u64;
            if after < 30u64 && !cr.contains(after) { return 25; }
            i = i + 1u64;
        }
        if cr.len() != 0u64 { return 26; }
        // Second remove of an already-removed key returns false.
        let r: u64 = 5u64;
        if cr.remove(r) { return 27; }
    }

    // ── Stage 3: interleaved insert + remove ──
    {
        let mut cr: ContainerRef<StoreCfg, MapCfg> =
            create_pmap::<MapCfg, StoreCfg>(&mut snap, 3u64);

        // Insert 0..20, remove evens, verify odds remain, re-insert evens.
        let mut i: u64 = 0u64;
        while i < 20u64 {
            cr.insert(i, i * 3u64);
            i = i + 1u64;
        }
        i = 0u64;
        while i < 20u64 {
            if !cr.remove(i) { return 30; }
            i = i + 2u64;
        }
        if cr.len() != 10u64 { return 31; }
        // odds present, evens absent
        let mut j: u64 = 0u64;
        while j < 20u64 {
            let want: bool = j % 2u64 == 1u64;
            let got:  bool = cr.contains(j);
            if want != got { return 32; }
            j = j + 1u64;
        }
        // Re-insert evens, all 20 back.
        i = 0u64;
        while i < 20u64 {
            cr.insert(i, i * 100u64);
            i = i + 2u64;
        }
        if cr.len() != 20u64 { return 33; }
        // Evens have new value, odds untouched.
        j = 0u64;
        while j < 20u64 {
            let out: u64 = match cr.get(j) {
                Option::Some(x) => x,
                Option::None => { return 34; }
            };
            let want: u64 = if j % 2u64 == 0u64 { j * 100u64 } else { j * 3u64 };
            if out != want { return 35; }
            j = j + 1u64;
        }
    }

    let id: u64 = snap.commit();
    return 0;
}
