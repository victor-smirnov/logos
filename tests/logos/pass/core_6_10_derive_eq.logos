// logos-core §6.10 sub-deliverable 3/8: derive(Eq). As rustc's: `Eq` is a
// marker over `PartialEq`, so `#[derive_eq]` emits `impl Eq for Pair {}` and
// `eq` / `ne` come from `#[derive_partial_eq]` beside it.
package core_6_10_derive_eq;

use logos.std.compiler.metaprog;
use logos.lang.cmp;

#[derive_partial_eq]
#[derive_eq]
struct Pair { a: i64, b: i64 }

fn main() -> i32 {
    let x: Pair = Pair { a: 10 as i64, b: 20 as i64 };
    let y: Pair = Pair { a: 10 as i64, b: 20 as i64 };
    let z: Pair = Pair { a: 10 as i64, b: 21 as i64 };
    if !x.eq(&y) { return 1i32; }
    if x.eq(&z)  { return 2i32; }
    if !x.ne(&z) { return 3i32; }   // default ne in PartialEq
    return 0i32;
}
