package index_borrow_of_slice_ref_elem;
use logos.std.fmt;
use logos.mem.collections.vec;
fn main() {
    let mut v: Vec<&str> = Vec::new(); v.push("a"); v.push("bc");
    let r: &&str = &v[1];
    println!("{} {} {}", v.len(), v[1], r);
    let a: [&str; 2] = ["x", "yz"];
    let q: &&str = &a[1];
    println!("{} {}", q, q.len());
    let x = [5i64, 6, 7];
    let mut w: Vec<&[i64]> = Vec::new(); w.push(&x[1..]);
    let s: &&[i64] = &w[0];
    let t: &[i64] = &x[..2];
    println!("{} {} {}", s.len(), s[0], t.len());
}
