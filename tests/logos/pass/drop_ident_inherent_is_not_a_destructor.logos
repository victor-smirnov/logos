// PIN (2026-09-04land, root 3): an INHERENT `fn drop` is an ordinary method.
// The destructor was keyed on the MANGLED NAME `<T>__drop`, so ANY method spelled
// `drop` ran at scope exit; this program returned 1 where Rust returns 0.
// THE ASSERTION IS THE COUNT: 0 automatic calls, and the method still callable.
// TWIN one token apart: drop_ident_trait_is_a_destructor (`impl S` -> `impl Drop for S`).
package drop_ident_inherent_is_not_a_destructor;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
static mut I: i64 = 0i64;
struct S { k: i64 }
impl S { fn drop(self: &mut Self) { unsafe { I = I + 1i64; } } }
fn main() -> i32 {
    {
        let mut s: S = S { k: 5i64 };
        if s.k != 5i64 { return 3i32; }
    }
    unsafe {
        printi("I=%d\n", I as i32);
        if I != 0i64 { return 1i32; }
    }
    return 0i32;
}
