// `impl Add<E> for D` — an operator impl whose right operand is not `Self` —
// with `a + b` over `D`, `E`. The operator traits are Rust's shape now:
// `trait Add<Rhs = Self> { type Output; fn add(self, rhs: Rhs) -> Self::Output; }`
// (stdlib/lang/ops/ops.logos), every impl states `type Output`, an omitted
// `Rhs` is `Self`. rustc 1.98.1: s=11 n=11. Twins: tests/logos/pass/
// operator_trait_output_shapes.logos, operator_generic_output_projection.logos;
// tests/logos/fail/operator_generic_result_is_output_not_self.logos,
// operator_impl_omitted_rhs_is_self.logos.
package operator_trait_rhs_type_param_refused;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct E { v: i64, c: *mut i64 }
impl Drop for E { fn drop(self: &mut E) { unsafe { *self.c = *self.c + self.v; } } }
impl Add<E> for D {
    type Output = i64;
    fn add(self: D, o: E) -> i64 {
        return self.v + o.v;
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut s: i64 = 0i64;
    {
        let a: D = D { v: 1i64, c: p };
        let b: E = E { v: 10i64, c: p };
        s = a + b;
    }
    let got: i64 = unsafe { n };
    unsafe { printf("s=%ld n=%ld\n".as_ptr(), s, got); }
    if s != 11i64 { return 2i32; }
    if got != 11i64 { return 1i32; }
    return 0i32;
}
