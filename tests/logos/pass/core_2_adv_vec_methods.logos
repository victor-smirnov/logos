// §2 Wave 9 — Rust API parity methods added to Vec.
package core_2_adv_vec_methods;
fn main() -> i32 {
    let mut v: Vec<i32> = Vec::<i32>::new();
    v.push(1i32); v.push(2i32); v.push(3i32);
    if v.len() != 3i64 { return 1i32; }
    if v.first().unwrap_or(&0i32) != &1i32 { /* address compare in test */ }
    let f: Option<&i32> = v.first();
    if f.is_none() { return 2i32; }
    let l: Option<&i32> = v.last();
    if l.is_none() { return 3i32; }
    if !v.contains(&2i32) { return 4i32; }
    if v.contains(&99i32) { return 5i32; }
    return 0i32;
}
