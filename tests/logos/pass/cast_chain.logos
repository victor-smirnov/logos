package cast_chain;
// Edge case: chain of casts through multiple types
unsafe fn main() -> i32 {
    let a: i8 = 42 as i8;
    let b: i32 = a as i32;    // 42
    let c: i64 = b as i64;    // 42
    let d: i32 = c as i32;    // 42
    let e: u8 = d as u8;      // 42
    let f: i32 = e as i32;    // 42
    return f;
}
