// A labelled break out of an array for-each drops the untaken tail (rustc: 123).
package foreach_array_labelled_break_drops_tail;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn f(p: *mut i64) {
    'outer: loop {
        for d in [D { v: 1i64, c: p }, D { v: 2i64, c: p }, D { v: 3i64, c: p }] {
            if d.v == 1i64 { break 'outer; }
        }
    }
}
fn main() -> i32 { let mut n: i64 = 0i64; f(&mut n); unsafe { printf("%lld\n".as_ptr(), n); } return 0i32; }
