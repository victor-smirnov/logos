// The container was declared in the ctr_mod ARCHIVE — this consumer only
// imports and queries it: CONTAINER_DEF_DONE re-registration + the generated
// projection must both survive the module boundary (the "cross-module Canon
// reasoning" claim, previously untested).
package container_item_from_module;

use ctr_mod;
use logos.std.wql.wql;
use logos.mem.collections.vec;

pub deem big(v: &BoxCtr<u64>) {
    from v e where e.elem > 10 select (e.pos, e.elem)
}

fn main() -> i32 {
    let mut c: BoxCtr<u64> = BoxCtr::<u64>::new(8i64);
    c.push(3u64);
    c.push(25u64);
    c.push(7u64);
    c.push(42u64);
    let rows: Vec<(i64, i64)> = match big(&c)
    { Result::Ok(r) => { r } Result::Err(_e) => { return 1i32; } };
    if rows.len() != 2i64 { return 2i32; }
    let mut seen25: bool = false;
    let mut seen42: bool = false;
    let mut i: i64 = 0i64;
    while i < rows.len() {
        let r: (i64, i64) = rows.get(i);
        if r.0 == 1i64 && r.1 == 25i64 { seen25 = true; }
        else if r.0 == 3i64 && r.1 == 42i64 { seen42 = true; }
        else { return 3i32; }
        i = i + 1i64;
    }
    if !seen25 { return 4i32; }
    if !seen42 { return 5i32; }
    return 0i32;
}
