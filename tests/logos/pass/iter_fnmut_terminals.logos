// Regression test: Iterator trait terminal default methods that take
// `F: FnMut(...)` now accept capturing closures.
//
// All eight terminals migrated: fold, for_each, any, all,
// find, find_map, reduce, position. The find/position
// auto-borrow gap closed in the same sweep
// (sema_expr.cpp:6234 / 6298 — added auto-ref in the struct-method
// generic-method dispatch path); the find_map mono-segfault closed
// via method_bound_ok's TypeVar-deferred branch; reduce inlines
// fold's body to dodge a chained-FnMut-bound sema bug.
package iter_fnmut_terminals_test;

use logos.lang.range;
use logos.lang.iter;
use logos.lang.option;

unsafe fn main() -> i32 {
    // fold with capturing closure (bias is captured).
    let bias = 100;
    let s = range_i32(1, 5).fold(0, |acc: i32, x: i32| -> i32 {
        return acc + bias + x;
    });
    // (100+1)+(100+2)+(100+3)+(100+4) = 410
    if s != 410 { return 1; }

    // any with capturing closure (threshold captured).
    let threshold = 3;
    let any_over = range_i32(0, 5).any(|x: i32| -> bool {
        return x > threshold;
    });
    if !any_over { return 2; }

    // all with capturing closure (max captured).
    let max = 10;
    let all_under = range_i32(0, 5).all(|x: i32| -> bool {
        return x < max;
    });
    if !all_under { return 3; }

    // for_each with capturing closure mutating a counter.
    let mut count = 0;
    range_i32(0, 7).for_each(|_x: i32| {
        count = count + 1;
    });
    if count != 7 { return 4; }

    // find with capturing closure.
    let needle = 3;
    let mut it_find = range_i32(0, 10);
    unsafe {
        match it_find.find(|x: i32| -> bool { return x == needle; }) {
            Option::Some(v) => { if v != 3 { return 5; } }
            Option::None    => { return 6; }
        }
    }

    // position with capturing closure.
    let target = 5;
    let mut it_pos = range_i32(0, 10);
    unsafe {
        match it_pos.position(|x: i32| -> bool { return x == target; }) {
            Option::Some(idx) => { if idx != 5 as i64 { return 7; } }
            Option::None      => { return 8; }
        }
    }

    // reduce with capturing closure.
    let extra = 100;
    match range_i32(1, 4).reduce(|acc: i32, x: i32| -> i32 { return acc + x + extra; }) {
        Option::Some(v) => { if v != 1 + (2 + 100) + (3 + 100) { return 9; } }
        Option::None    => { return 10; }
    }

    return 42;
}
