// Microslice: GENERIC_REF in registry-shape pattern.
//
// Verifies the ingredients needed for ContainerRegistry / pmap container
// directory dispatch:
//   1. Distinct GENERIC_REF instantiations produce distinct fn-pointers
//      with distinct behaviour at runtime.
//   2. fn-pointers can be stored in a uniform-typed array and dispatched
//      by index (the "registry lookup → call" shape).
//   3. WritStatic-keyed instantiation works the same way.
package generic_ref_registry_shape;

use logos.lang.writ.hstatic;

// (1) Const-generic thunks — distinct N values yield distinct functions.
fn add_n<const N: i64>(x: i32) -> i32 {
    return x + (N as i32);
}

// (2) Different generic, same shape — proves multiple registrants coexist.
fn mul_n<const N: i64>(x: i32) -> i32 {
    return x * (N as i32);
}

// (3) WritStatic-keyed thunk. CFG identity = byte-hash; two distinct CFGs
// produce two distinct symbols. The body need not reference CFG directly —
// monomorphisation already separates them by mangled name.
fn cfg_thunk<const CFG: WritStatic>(x: i32) -> i32 {
    return x;
}

fn main() -> i32 {
    // (1) Capture two const-generic instantiations as fn-pointers.
    let f10: fn(i32) -> i32 = add_n::<10i64>;
    let f20: fn(i32) -> i32 = add_n::<20i64>;
    let m3:  fn(i32) -> i32 = mul_n::<3i64>;

    // (2) Call each fn-pointer directly to verify distinct behaviour.
    let r1: i32 = f10(5);
    let r2: i32 = f20(5);
    let r3: i32 = m3(5);
    if r1 != 15 { return 1; }
    if r2 != 25 { return 2; }
    if r3 != 15 { return 3; }

    // (3) WritStatic-keyed: distinct CFGs → distinct symbols. Just verify
    // the fn-pointers are callable; identity (≠ across CFGs) is guaranteed
    // by mangling — same path as add_n::<N>.
    let c1: fn(i32) -> i32 = cfg_thunk::<@{ "tag": "alpha" }>;
    let c2: fn(i32) -> i32 = cfg_thunk::<@{ "tag": "beta" }>;
    let r4: i32 = c1(7);
    let r5: i32 = c2(7);
    if r4 != 7 { return 4; }
    if r5 != 7 { return 5; }

    return 42;
}
