// #469: `impl<T: Copy> Cell<T>` instantiates for the built-in Copy handle kinds (a shared
// reference) and for tuples of Copy elements — `get` returns the value.
package cell_get_copy_handles_admit;
use logos.lang.cell;
fn main() -> i32 {
    let b: i64 = 4i64;
    let c1: Cell<&i64> = Cell::new(&b);
    let r: &i64 = c1.get();
    let c2: Cell<(i64, i64)> = Cell::new((1i64, 2i64));
    let t: (i64, i64) = c2.get();
    let c3: Cell<(&i64, i64)> = Cell::new((&b, 2i64));
    let u: (&i64, i64) = c3.get();
    if *r + t.0 + *u.0 != 9i64 { return 1i32; }
    return 0i32;
}
