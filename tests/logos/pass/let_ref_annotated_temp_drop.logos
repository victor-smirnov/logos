// `let ref a: D = mk()` binds a reference to a temporary that lives to the end of the block and is dropped once
// (rustc 1.98.1: 12 0 21).
package let_ref_annotated_temp_drop;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn mk(v: i64, c: *mut i64) -> D { return D { v: v, c: c }; }
fn main() -> i32 {
    let mut n: i64 = 0i64; let p: *mut i64 = &mut n;
    let mut seen: i64 = 0i64;
    let mut mid: i64 = 0i64;
    {
        let ref a: D = mk(1i64, p);
        let ref b = mk(2i64, p);
        mid = unsafe { *p };
        seen = a.v * 10i64 + b.v;
    }
    unsafe { printf("%lld %lld %lld\n".as_ptr(), seen, mid, n); }
    return 0i32;
}
