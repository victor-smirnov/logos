// Hermes2 HString — a UTF-8 string interned into the never-move arena as a real
// self-describing DST (inline `len` header + `[u8]` tail, one allocation). Read
// via a thin `*const HString` (the proven self-describing idiom, like HermesString):
// `as_str` materializes the absolute slice. Round-trips; survives a second
// allocation pushing it across a segment boundary; RAII-freed.
package test;
use logos.lang.hermes2.container;
use logos.lang.hermes2.hstring;
use logos.lang.str;
fn main() -> i32 {
    let h: Hermes2 = hermes2_new(32i64);            // tiny segment
    unsafe {
        let a: *const HString = h.hstring("alpha");
        let b: *const HString = h.hstring("a longer string crossing the 32-byte segment");
        if a.len() != 5i64 { return 1; }
        if !str_eq(a.as_str(), "alpha") { return 2; }   // a still valid after b's alloc
        if !str_eq(b.as_str(), "a longer string crossing the 32-byte segment") { return 3; }
    }
    return 0;
}
