package let_mutref_annotation_to_meet_struct_admit;
struct P<'a> { x: &'a i64, y: &'a i64 }
fn bump(p: &mut P) -> i64 { return *p.x + *p.y; }
fn go<'a, 'b>(x: &'a i64, y: &'b i64) -> i64 {
    let mut p = P { x: x, y: y };
    let r: &mut P = &mut p;
    return bump(r);
}
fn main() -> i32 {
    let a: i64 = 2i64;
    let b: i64 = 7i64;
    if go(&a, &b) != 9i64 { return 1i32; }
    return 0i32;
}
