// C8f: HermesStatic → HermesView conversion via as_view().
package hermes_view_from_static;
use std.hermes.ctr;
use std.hermes.view;
use logos.mem.string;
use logos.lang.str;

unsafe fn check_view(v: &HermesView, expected: str, err_code: i32) -> i32 {
    let text: String = v.to_string();
    if !text.eq_str(expected) { return err_code; }
    return 0;
}

unsafe fn main() -> i32 {
    // Static literal → view.
    let s1: HermesStatic = @42;
    let v1: HermesView = s1.as_view();
    let r: i32 = check_view(&v1, "42", 1);
    if r != 0 { return r; }

    // Array literal → view.
    let s2: HermesStatic = @[1, 2, 3];
    let v2: HermesView = s2.as_view();
    let r2: i32 = check_view(&v2, "[1,2,3]", 2);
    if r2 != 0 { return r2; }

    // Map literal → view.
    let s3: HermesStatic = @{"key": true};
    let v3: HermesView = s3.as_view();
    let r3: i32 = check_view(&v3, "{\"key\":true}", 3);
    if r3 != 0 { return r3; }

    return 0;
}
