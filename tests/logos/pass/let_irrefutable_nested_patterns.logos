// Irrefutable `let` patterns: a struct inside a tuple, `w @ (a, b)`, nested arrays, an array of (Drop, i64) tuples moved out (rustc 1.98.1).
package let_irrefutable_nested_patterns;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let mut n: i64 = 0i64; let p: *mut i64 = &mut n;
    let t: (P, i64) = (P { x: 1i64, y: 2i64 }, 3i64);
    let (P { x, y: _ }, z) = t;
    let w @ (a, b) = (4i64, 5i64);
    let arr: [[i64; 2]; 2] = [[6i64, 7i64], [8i64, 9i64]];
    let [[c, _], [_, d]] = arr;
    let mut k: i64 = 0i64;
    {
        let ds: [(D, i64); 1] = [(D { v: 1i64, c: p }, 2i64)];
        let [(e, f)] = ds;
        k = e.v + f;
    }
    unsafe { printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld\n".as_ptr(), x, z, w.0, a + b, c, d, k, n, 0i64); }
    return 0i32;
}
