// `for mut s in arr` (array iteration: sk::IS_MUT is the ForEach map's 9th key; capacity 8 aborted the compiler) then a `&mut self` method: legal, runs. ONE TOKEN from fail/bc_patmut_for_arr_no_mut_recv_fail. PROBES.md 2026-09-06b: the by-value pattern `mut` is carried into the LIR for match/if-let/while-let/for bindings.
package bc_patmut_for_arr_recv;
struct S { v: i64 }
impl S { fn get(&mut self) -> &mut i64 { return &mut self.v; } }
fn main() -> i32 {
    let arr: [S; 2] = [S { v: 1i64 }, S { v: 2i64 }];
    let mut acc: i64 = 0i64;
    for mut s in arr {
        let r: &mut i64 = s.get();
        *r = *r + 10i64;
        acc = acc + s.v;
    }
    if acc != 23i64 { return 1i32; }
    return 0i32;
}
