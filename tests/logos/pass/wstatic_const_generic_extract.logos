// wstatic_const_generic_extract.logos — runtime extraction of a
// WritStatic const-generic from inside a generic body.
//
// Without this, wstatic-as-const-generic only carries type identity:
// the cfg distinguishes types but you can't read its content. With
// this slice the cfg behaves like a real compile-time constant —
// the body uses `CFG` like an inlined `let cfg: WritStatic = @{...};`.
//
// Pieces wired together (atop wstatic_const_generic_uid):
//   • Sema, at LIT_WSTATIC resolution, also lowers the @-literal via
//     lower_writ_lit and registers the resulting LExpr* in
//     LProgram::wstatic_registry_ keyed by hash. First-write-wins —
//     identical literals share one registered LExpr.
//   • Mono moves wstatic_registry_ alongside expr_pool_ so cloned
//     bodies can splice the registered literal.
//   • Mono's VarRef clone, on a `__const_param:NAME` reference whose
//     SubstMap entry is WStaticLit(hash=H), looks up registry[H] and
//     deep-clones that LExpr at the use site (subst_expr with empty
//     subst). The cloned EWritLit emits exactly like an inline
//     `@{...}` would — the cfg is materialised in rodata.
//
// End-to-end check: read the field "k" from the cfg back as i64.
// Two `@{"k": 7}` instantiations dedupe; `@{"k": 13}` materialises
// distinctly.

package wstatic_const_generic_extract;

use logos.std.compiler.metaprog;
use logos.lang.writ.wstatic;
use logos.lang.writ.static_view;
use logos.lang.writ.anyval;

unsafe fn read_k<const CFG: WritStatic>() -> i64 {
    let v: WView2 = wview2_from_ptr(CFG.ptr);
    let r: WAny = v.root();
    if r.is_null() { return -1i64; }
    let kv: WAny = v.map_get(r, "k");
    if kv.is_null() { return -2i64; }
    if !kv.is_int() { return -3i64; }
    return kv.as_i64();
}

unsafe fn main() -> i32 {
    let a: i64 = read_k::<@{"k": 7}>();
    let b: i64 = read_k::<@{"k": 13}>();
    let c: i64 = read_k::<@{"k": 7}>();   // identical to a → same instantiation
    if a != 7  { return 1; }
    if b != 13 { return 2; }
    if c != 7  { return 3; }
    if a != c  { return 4; }
    return 0;
}
