// query_observer_l1 — the L1 OBSERVER (Nous ladder rung 1; ADR 0015 §0 —
// all THREE conditions, on the landed S1+S2+S3 mechanism):
//   1. ENCOUNTER — a budgeted self-model run collides with its own
//      irreducibility: the cut registers a residual (S2 truncated_tail);
//   2. CONCLUSION — a Deem meta-rule over the residual EDB derives the
//      epistemic result: how much is pending and that it is irreducible
//      within the current budget (the derived fact, not a hardcoded check);
//   3. ACTION — the conclusion is the CAUSAL FOUNDATION of behavior: the
//      raise-budget control atom's argument IS the derived pending count
//      (data flows conclusion → action), enqueued and applied at the next
//      epoch (S3, I2), after which the run converges.
// The causal chain is auditable in the journal: the applied atom's value
// equals the derived fact's value, and the epoch it steered converged.
// Honesty (ADR §6 pair, both halves):
//   - decision-time irreducibility: the cut epoch's tail shows pending > 0 —
//     the agent acted from a state it provably had not exhausted;
//   - post-hoc reconstructibility: an unbudgeted twin over the same workload
//     converges to the full result; the deliberated (truncated) result is a
//     strict subset — the "freedom" dissolves in retrospect, with the delta
//     exhibited.
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema Edge : code(0x0E07_0000_0000_0010) {
    src: i64 = 0,
    dst: i64 = 1,
}
pub schema Tail : code(0x0E07_0000_0000_0011) {
    epoch:     i64 = 0,
    converged: i64 = 1,
    pending:   i64 = 2,
    budget:    i64 = 3,
}
resource cat = schema_catalog!{ Edge, Tail };

fn mk_edge(d: &Writ, s: i64, t: i64) -> WAny {
    let e: Edge = d.make::<Edge>();
    e.src = s; e.dst = t;
    return WAny::ref_to((e.m as i64) as *const u8);
}

fn build_src(d: &Writ, hs: &Vec<WAny>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(64i64);
    let n: i64 = hs.len();
    let mut i: i64 = 0i64;
    while i < n { arr.push(hs.get(i)); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

fn snap_count(e: &IncrRec) -> i64 {
    let s: QRows = e.snapshot();
    return s.row_count();
}

// Materialize the engine's residual + current budget as one EDB fact.
fn tail_edb(d: &Writ, eng: &IncrRec, budget: i64) -> WAny {
    let t: TruncatedTail = eng.tail();
    let r: Tail = d.make::<Tail>();
    r.epoch     = t.epoch;
    r.converged = if t.converged { 1i64 } else { 0i64 };
    r.pending   = t.pending_delta_card;
    r.budget    = budget;
    let arr: &mut WArray<WAny> = d.array(4i64);
    arr.push(WAny::ref_to((r.m as i64) as *const u8));
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

fn main() -> i32 {
    let doc: Writ = writ_new(262144i64);
    let c: SchemaCatalog = cat();
    let q: Query = match Query::compile(
        r#"rel path(a: i64, b: i64) {
             from edges e select (e.src, e.dst);
             from path p join edges e on p.b == e.src select (p.a, e.dst);
           }
           from path p select (p.a, p.b)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };
    // CONCLUSION meta-rule: irreducible within the current budget ⇒ derive
    // (epoch, pending) — pending doubles as the recommended budget raise.
    let qc: Query = match Query::compile(
        r#"from tails t where t.converged == 0 && t.pending > 0 && t.budget >= 0
           select (t.epoch, t.pending)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e2) => { return 91i32; } };

    let mut all: Vec<WAny> = vec_new::<WAny>();
    let mut k: i64 = 0i64;
    while k < 12i64 { all.push(mk_edge(&doc, k, k + 1i64)); k = k + 1i64; }
    let mut seed: Vec<WAny> = vec_new::<WAny>();
    seed.push(all.get(0i64));

    let mut env: QEnv = QEnv::new();
    env.bind_source("edges", build_src(&doc, &seed));
    let mut eng: IncrRec = match q.incremental_rec(&env)
    { Result::Ok(e) => { e } Result::Err(_e3) => { return 1i32; } };

    // ── 1. ENCOUNTER: 1-step budget (via the lawful control path), big epoch ──
    eng.control_set_budget_steps(1i64);
    let mut d1: ZBatch = ZBatch::new();
    let mut k2: i64 = 1i64;
    while k2 < 12i64 { d1.push(all.get(k2), 1i64); k2 = k2 + 1i64; }
    eng.epoch(&d1);
    if eng.is_converged() { return 2i32; }              // the collision
    let cut_epoch: i64 = eng.tail().epoch;
    let cut_pending: i64 = eng.tail().pending_delta_card;
    if cut_pending <= 0i64 { return 3i32; }             // decision-time residual

    // ── 2. CONCLUSION: Deem derives the epistemic result from the residual ──
    let mut cenv: QEnv = QEnv::new();
    cenv.bind_source("tails", tail_edb(&doc, &eng, 1i64));
    let mut concl_epoch: i64 = 0i64 - 1i64;
    let mut concl_pending: i64 = 0i64 - 1i64;
    {
        let rows: QRows = match qc.run(&cenv)
        { Result::Ok(v) => { v } Result::Err(_e4) => { return 4i32; } };
        if rows.row_count() != 1i64 { return 5i32; }    // exactly one conclusion
        concl_epoch = rows.get_i64(0i64, 0i64);
        concl_pending = rows.get_i64(0i64, 1i64);
    }
    if concl_epoch != cut_epoch { return 6i32; }
    if concl_pending != cut_pending { return 7i32; }

    // ── 3. ACTION: the derived fact drives the control atom (data-causal) ──
    eng.control_raise_budget(concl_pending + 16i64);    // derived value flows in
    let d2: ZBatch = ZBatch::new();
    eng.epoch(&d2);                                     // acted-from epoch
    let mut guard: i64 = 0i64;
    while !eng.is_converged() && guard < 32i64 {        // finish under raised budget
        let dr: ZBatch = ZBatch::new();
        eng.epoch(&dr);
        guard = guard + 1i64;
    }
    if !eng.is_converged() { return 8i32; }

    // causal chain auditable in the journal: the atom applied at the epoch
    // after the conclusion carries exactly the derived-value payload.
    let mut found: bool = false;
    let mut i: i64 = 0i64;
    while i < eng.journal_len() {
        let ncc: i64 = eng.journal_controls_at(i);
        let mut j: i64 = 0i64;
        while j < ncc {
            let ca: ControlAtom = eng.journal_control_at(i, j);
            if ca.kind == 1i32 && ca.val == concl_pending + 16i64
            && ca.epoch == cut_epoch + 1i64 { found = true; }
            j = j + 1i64;
        }
        i = i + 1i64;
    }
    if !found { return 9i32; }

    // ── honesty pair, half 2: post-hoc reconstructibility ──
    let mut envu: QEnv = QEnv::new();
    envu.bind_source("edges", build_src(&doc, &seed));
    let mut engu: IncrRec = match q.incremental_rec(&envu)
    { Result::Ok(e) => { e } Result::Err(_e5) => { return 10i32; } };
    let mut du: ZBatch = ZBatch::new();
    let mut k3: i64 = 1i64;
    while k3 < 12i64 { du.push(all.get(k3), 1i64); k3 = k3 + 1i64; }
    engu.epoch(&du);                                    // unbudgeted twin
    if !engu.is_converged() { return 11i32; }
    let fulln: i64 = snap_count(&engu);
    if fulln != 78i64 { return 12i32; }                 // C(13,2)
    // the deliberated run, once resumed, reaches the same full result —
    // and the residual the agent acted from is exactly the exhibited delta.
    if snap_count(&eng) != fulln { return 13i32; }

    return 0i32;
}
