package hermes_traits_full;
// End-to-end test of HermesEqual, HermesHash, HermesClone across zones.

use logos.lang.hermes.zone;
use logos.lang.hermes.anyval;
use logos.lang.hermes.view;
use std.hermes.string;
use logos.mem.string;
use logos.lang.str;
use logos.lang.hermes.typetag;
use std.hermes.tag_system;
use std.hermes.array;
use std.hermes.map;
use logos.lang.hermes.typed_value;
use std.hermes.objectmap;
use std.hermes.document;
use std.hermes.ctr;
use std.hermes.stringify;
use std.hermes.equal;
use std.hermes.hashing;
use std.hermes.clone;

unsafe fn build_doc(text: str) -> Hermes {
    let mut doc: Hermes = Hermes::new(8192);
    match doc.parse(text) {
        Result::Ok(())  => {}
        Result::Err(_)  => {}
    }
    return doc;
}

unsafe fn main() -> i32 {
    let t1: str = "{a:1,b:\"hi\",c:[1,2,3]}";
    let t2: str = "{a:1,b:\"hi\",c:[1,2,3]}";
    let t3: str = "{a:1,b:\"hi\",c:[1,2,4]}";

    let mut d1: Hermes = build_doc(t1);
    let mut d2: Hermes = build_doc(t2);
    let mut d3: Hermes = build_doc(t3);

    let r1: AnyVal = d1.root();
    let r2: AnyVal = d2.root();
    let r3: AnyVal = d3.root();

    let b1: *const u8 = d1.base();
    let b2: *const u8 = d2.base();
    let b3: *const u8 = d3.base();

    // ── equal: d1 == d2, d1 != d3
    let mut eq_ctx: EqualCtx = EqualCtx { base_self: b1, base_other: b2 };
    if !anyval_equal(r1, r2, &mut eq_ctx) { return 1; }

    let mut eq_ctx2: EqualCtx = EqualCtx { base_self: b1, base_other: b3 };
    if anyval_equal(r1, r3, &mut eq_ctx2) { return 2; }

    // ── hash: d1 and d2 same, d1 and d3 different
    let mut h_ctx1: HashCtx = HashCtx { base: b1 };
    let mut h_ctx2: HashCtx = HashCtx { base: b2 };
    let mut h_ctx3: HashCtx = HashCtx { base: b3 };
    let h1: u64 = anyval_hash(r1, &mut h_ctx1);
    let h2: u64 = anyval_hash(r2, &mut h_ctx2);
    let h3: u64 = anyval_hash(r3, &mut h_ctx3);
    if h1 != h2 { return 3; }
    if h1 == h3 { return 4; }

    // ── clone: copy d1 into a fresh builder zone, compare via stringify output
    let mut dst: Hermes = Hermes::builder(8192);
    let mut c_ctx: CloneCtx = CloneCtx {
        base_src: b1,
        zone_dst: dst.zone_mut(),
        map: 0 as *mut CloneMap,
    };
    let cloned_root: AnyVal = anyval_clone(r1, &mut c_ctx);
    if cloned_root.is_null() { return 5; }
    dst.set_root(cloned_root);

    let s_orig:   String = d1.to_string();
    let s_cloned: String = dst.to_string();
    if !s_orig.eq_string(&s_cloned) { return 6; }

    return 0;
}
