package query_order_by_float_data_key;
// `order by <f64 key>` sorts on the DATA KEY, a TOTAL order over values.
//
// ⚠ THIS FILE WAS `query_order_by_float_static_vs_dynamic` AND IS RENAMED, because
// P5 deleted the dynamic `Query::compile`/`run` interpreter and there is no
// "static vs dynamic" left to assert. The history below is kept verbatim because
// it is the reason every expectation here is WRITTEN OUT rather than computed —
// the two engines agreed while both were wrong, which is how the defect lived.
// Exit codes 10, 11, 14, 15, 21, 23, 30, 32 and 34 named the dynamic arm; they
// are retired and NOT reused.
//
// wql_order_by_float_is_a_total_order_e2e found this defect on the STATIC side
// and pinned it there: an insertion sort whose comparator is the language's
// `<`/`>` on f64 is sorting with a PARTIAL order. A NaN is neither `<`, `>` nor
// `==` anything, so the comparator answers "equal" for every pair involving
// one, the inner loop never shifts a row past it, and the output comes back in
// COLLECTION order. The static emitter was moved to a KEY — today
// `f64_data_key`, the order over VALUES — in `rexpr_walk.logos` `key_ord_frag`.
//
// The DYNAMIC engine kept the defect. Its comparator, `rt_cmp` in
// `exec.logos`, still fell through to `if lf < rf … if lf > rf …`. Nothing
// covered it: every test that ran a dynamic `order by` sorted on a `str` or an
// `i64` key (query_diff_str_adv, query_incr_guard, query_interp_smoke,
// query_tail_order_adv, query_tree_source_graph_e2e, query_parser_robust_adv*),
// and query_f64_avg_nan_fuzz — the one test that does compare the two engines
// on f64 — sorts BOTH sides before comparing, so it is blind to order by
// construction.
//
// MEASURED at the previous HEAD, on tables small enough to decide by hand:
//   rows [ +0.0, -0.0 ]      static [ -0.0, +0.0 ]   dynamic [ +0.0, -0.0 ]
//   rows [ 1.0, NaN, 0.0 ]   static [ 0.0, 1.0, NaN ] dynamic [ 1.0, NaN, 0.0 ]
// The second is the whole failure in three rows: the dynamic answer is the
// INPUT, unsorted and unflagged. The first needs no NaN at all — `-0.0 < 0.0`
// is false, so the two zeros compared equal and kept their input order.
//
// ⚠ The FIRST row's expected answer has since changed, and not because the
// defect changed: under the data order the two zeros are ONE value, so the
// right answer to `[+0.0, -0.0]` is the input order — the same list the broken
// comparator returned, for an entirely different reason. Group 4 therefore
// asserts BOTH input orders; a fixed rank and a tie only differ on one of them.
//
// ⚠ THE ORACLE IS WRITTEN OUT, NOT COMPUTED — the discipline
// wql_order_by_float_is_a_total_order_e2e records. Asserting only
// "static == dynamic" would pass with both engines wrong, which is precisely
// how this survived; and an oracle sort written here with the same comparator
// would reproduce the defect and compare the implementation with itself. So
// group 1 asserts a CONSTANT id sequence derived BY HAND from the data order,
// and group 3's fuzz oracle sorts on `f64_data_key` — a key, not a float
// comparison, so it cannot inherit a partial-order bug.
//
// exit 0 = the emitted engine and the hand oracle agree, on the fixed table and
// on 300 fuzzed ones.
use logos.std.wql.wql;
use logos.lang.result;
use logos.lang.arith;
use logos.lang.num.float;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

struct S { pub k: f64, pub id: i64 }

pub deem q_asc(ss: &[S])  { from ss s select s.id order by s.k : i64 }
pub deem q_desc(ss: &[S]) { from ss s select s.id order by s.k desc : i64 }

// ── the fixed table: the same eight rows the static test pins ────────────────
//
//   key      -inf  -2.5  -0.0   0.0   1.0   3.0  +inf   NaN
//   id          4     7     1     5     3     0     6     2
//
// ⚠ `desc` is NOT the exact reverse, and that is the point of the fixture.
// Under the DATA order (`f64_data_key`, PostgreSQL's) −0.0 and +0.0 are the
// SAME key, so ids 1 and 5 TIE. A tie is broken by the source row index
// ASCENDING — the emitter does it explicitly (`ix_lex_gt_frag`) — and the
// tie-break does NOT flip with `desc`. So the tied pair reads 1,5 in both directions:
//
//   asc    4  7  [1 5]  3  0  6  2
//   desc   2  6  0  3  [1 5]  7  4
//                       ^^^^^ same order as asc, not reversed
//
// Hand-derived from the two rules, not read off a run.
fn nan_()  -> f64 { return f64_from_bits(0x7FF8000000000000u64); }
fn pinf_() -> f64 { return f64_from_bits(0x7FF0000000000000u64); }
fn ninf_() -> f64 { return f64_from_bits(0xFFF0000000000000u64); }
fn nzero_() -> f64 { return f64_from_bits(0x8000000000000000u64); }

fn rows() -> Vec<S> {
    let mut v: Vec<S> = vec_new::<S>();
    v.push(S { k: 3.0f64,   id: 0i64 });
    v.push(S { k: nzero_(), id: 1i64 });
    v.push(S { k: nan_(),   id: 2i64 });
    v.push(S { k: 1.0f64,   id: 3i64 });
    v.push(S { k: ninf_(),  id: 4i64 });
    v.push(S { k: 0.0f64,   id: 5i64 });
    v.push(S { k: pinf_(),  id: 6i64 });
    v.push(S { k: -2.5f64,  id: 7i64 });
    return v;
}

fn eq_v(got: &Vec<i64>, want: &Vec<i64>) -> bool {
    if got.len() != want.len() { return false; }
    let mut i: i64 = 0i64;
    while i < want.len() { if got.get(i) != want.get(i) { return false; } i = i + 1i64; }
    return true;
}
fn v8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> Vec<i64> {
    let mut v: Vec<i64> = vec_new::<i64>();
    v.push(a); v.push(b); v.push(c); v.push(d); v.push(e); v.push(f); v.push(g); v.push(h);
    return v;
}

// ── the independent oracle: a STABLE sort on the DATA KEY ────────────────────
// It compares i64 keys, never floats, so it cannot reproduce a partial-order
// comparator by construction. Stable, so equal keys keep row order — which is
// the tie-break both engines implement, and the pool below is full of ties.
fn oracle_ids(ss: &Vec<S>, desc: bool) -> Vec<i64> {
    let n: i64 = ss.len();
    let mut ord: Vec<i64> = vec_new::<i64>();
    let mut i: i64 = 0i64;
    while i < n {
        ord.push(i);
        let mut j: i64 = ord.len() - 1i64;
        while j > 0i64 {
            let ka: i64 = f64_data_key(ss.get(ord.get(j)).k);
            let kb: i64 = f64_data_key(ss.get(ord.get(j - 1i64)).k);
            let swap: bool = if desc { ka > kb } else { ka < kb };
            if !swap { break; }
            ord.swap(j, j - 1i64);
            j = j - 1i64;
        }
        i = i + 1i64;
    }
    let mut out: Vec<i64> = vec_new::<i64>();
    let mut k: i64 = 0i64;
    while k < ord.len() { out.push(ss.get(ord.get(k)).id); k = k + 1i64; }
    return out;
}

struct Rng { s: u64 }
impl Rng {
    fn next(self: &mut Rng) -> u64 {
        self.s = wrapping_add(wrapping_mul(self.s, 6364136223846793005u64), 1442695040888963407u64);
        return self.s >> 33u64;
    }
    fn upto(self: &mut Rng, n: i64) -> i64 { return (self.next() % (n as u64)) as i64; }
}
// The pool is the point: signed zeros, both NaN SIGNS, both infinities, and a
// duplicate. Under the DATA order three of these collapse into ties — +0.0,
// −0.0 and the duplicate 0.0 are ONE key, and the two NaN signs are ONE key
// that sorts LAST — so the fuzz exercises the tie-break hard, which is exactly
// where the two engines could still disagree. Both NaN signs are kept in the
// pool deliberately: under the OLD totalOrder key they sat at opposite ends of
// the result, so if the data key ever regressed to it, this pool would say so.
fn poolf(i: i64) -> f64 {
    if i == 0i64 { return 0.0f64; }
    if i == 1i64 { return nzero_(); }
    if i == 2i64 { return 1.0f64; }
    if i == 3i64 { return -1.0f64; }
    if i == 4i64 { return nan_(); }
    if i == 5i64 { return f64_from_bits(0xFFF8000000000000u64); }   // -NaN
    if i == 6i64 { return pinf_(); }
    if i == 7i64 { return ninf_(); }
    if i == 8i64 { return 2.5f64; }
    return 0.0f64;                                                  // duplicate of 0
}

fn main() -> i32 {
    let ss: Vec<S> = rows();

    // ── 1+2. the engine against the hand-written constant ───────────────────
    let st_asc: Vec<i64> = q_asc(ss.as_slice()).unwrap();
    if !eq_v(&st_asc, &v8(4i64, 7i64, 1i64, 5i64, 3i64, 0i64, 6i64, 2i64)) { return 12i32; }
    let st_desc: Vec<i64> = q_desc(ss.as_slice()).unwrap();
    if !eq_v(&st_desc, &v8(2i64, 6i64, 0i64, 3i64, 1i64, 5i64, 7i64, 4i64)) { return 13i32; }

    // the oracle reproduces the hand table — if it does not, group 3 is junk
    if !eq_v(&oracle_ids(&ss, false), &v8(4i64, 7i64, 1i64, 5i64, 3i64, 0i64, 6i64, 2i64)) { return 16i32; }
    if !eq_v(&oracle_ids(&ss, true),  &v8(2i64, 6i64, 0i64, 3i64, 1i64, 5i64, 7i64, 4i64)) { return 17i32; }

    // ── 3. fuzz: the engine against the key-sorted oracle ────────────────────
    let mut rng: Rng = Rng { s: 0x51DEB00BF10A7C0Du64 };
    let mut it: i64 = 0i64;
    while it < 300i64 {
        let n: i64 = 1i64 + rng.upto(7i64);
        let mut tb: Vec<S> = vec_new::<S>();
        let mut r0: i64 = 0i64;
        while r0 < n { tb.push(S { k: poolf(rng.upto(10i64)), id: r0 }); r0 = r0 + 1i64; }

        let o_a: Vec<i64> = oracle_ids(&tb, false);
        let o_d: Vec<i64> = oracle_ids(&tb, true);
        let s_a: Vec<i64> = q_asc(tb.as_slice()).unwrap();
        let s_d: Vec<i64> = q_desc(tb.as_slice()).unwrap();

        if !eq_v(&s_a, &o_a) { return 20i32; }   // engine vs oracle, asc
        if !eq_v(&s_d, &o_d) { return 22i32; }   // engine vs oracle, desc
        it = it + 1i64;
    }

    // ── 4. the two hand-decidable minima ────────────────────────────────────
    // [ +0.0, -0.0 ]: no NaN needed. The two zeros are the SAME VALUE, so this
    // is a pure TIE — and a tie is broken by row index, leaving them as given.
    // ⚠ Both a wrong answer and the OTHER order would be [1, 0]: the IEEE
    // totalOrder key sorts −0.0 first, and the old partial `<` comparator left
    // the input alone. Only the data key returns the input order BY RULE.
    let mut z: Vec<S> = vec_new::<S>();
    z.push(S { k: 0.0f64, id: 0i64 });
    z.push(S { k: nzero_(), id: 1i64 });
    let mut want_z: Vec<i64> = vec_new::<i64>(); want_z.push(0i64); want_z.push(1i64);
    if !eq_v(&q_asc(z.as_slice()).unwrap(), &want_z) { return 31i32; }

    // …and the SAME two rows given in the other order must come back in THAT
    // order. This is the assertion the totalOrder key fails: it would answer
    // [1, 0] for both inputs, because it ranks −0.0 below +0.0 unconditionally.
    // One direction alone cannot see that — a tie and a fixed rank agree on
    // whichever input happens to already be sorted.
    let mut z2: Vec<S> = vec_new::<S>();
    z2.push(S { k: nzero_(), id: 0i64 });
    z2.push(S { k: 0.0f64,   id: 1i64 });
    if !eq_v(&q_asc(z2.as_slice()).unwrap(), &want_z) { return 35i32; }

    // [ 1.0, NaN, 0.0 ]: under the partial-order comparator this list came back
    // unchanged — the input, unsorted and unflagged.
    let mut w: Vec<S> = vec_new::<S>();
    w.push(S { k: 1.0f64, id: 0i64 });
    w.push(S { k: nan_(),  id: 1i64 });
    w.push(S { k: 0.0f64, id: 2i64 });
    let mut want_w: Vec<i64> = vec_new::<i64>(); want_w.push(2i64); want_w.push(0i64); want_w.push(1i64);
    if !eq_v(&q_asc(w.as_slice()).unwrap(), &want_w) { return 33i32; }

    return 0i32;
}
