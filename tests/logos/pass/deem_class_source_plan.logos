// A `deem` may bind a container CLASS — an instance of the container
// metaclass — instead of a type:
//
//     pub deem high_value_entries<K, V: Number>(map: Map<K, V>) { … }
//
// `Map` is deliberately NOT a type. Its handle type is generated per store and
// per config, named by a content hash, and downstream of the very declaration
// the query is written against — so binding the class is the only spelling of
// a query that never mentions a generated name.
//
// A class source makes the item a PLAN, not a function: it is compiled where
// the class meets its type arguments — at a CALL, whose argument type names
// the family. This file never calls it, and that is the case being pinned: an
// uninstantiated plan is not an error, exactly as an uninstantiated generic fn
// is not. Nothing is emitted for it, and the program compiles and runs.
//
// The end-to-end instantiation lives in conuco/memoria/tests/ctr_class_deem.
package test;

use logos.lcm.canon.container_item;
use logos.mem.bt.map;
use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.result;

pub container Map<K, V> {
    kind ordered_map;
    entry { key: K, val: V }
    measure max(key);
}

pub deem high_value_entries<K, V: Number>(map: Map<K, V>) {
    from map e where e.val > 100 select (e.key, e.val)
}

fn main() -> i32 {
    return 0i32;
}
