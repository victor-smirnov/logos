// PIN (2026-09-04land, root 5): the TWIN of deref_call_ref_closure, one token
// apart (`(*r)()` -> `r()`). The `&mut F` callee auto-deref reaches the same
// codegen branch by the other spelling and must give the same answer.
package deref_call_ref_closure_direct;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
fn main() -> i32 {
    let k: i64 = 5i64;
    let mut c = || { return k + 1i64; };
    let r = &mut c;
    let a: i64 = r();
    let b: i64 = r();
    printi("a=%d ", a as i32);
    printi("b=%d ", b as i32);
    if a != 6i64 { return 1i32; }
    if b != 6i64 { return 2i32; }
    return 0i32;
}
