// For-each over array VALUES: a nested field, a call result, a borrowed field, and a field array of Drop elements moved out one by one (rustc 1.98.1).
package foreach_array_value_forms;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct In { arr: [i64; 3] }
struct S { inner: In, tag: i64 }
struct Hd { ds: [D; 2] }
fn mk() -> [i64; 3] { return [4i64, 5i64, 6i64]; }
fn main() -> i32 {
    let s: S = S { inner: In { arr: [1i64, 2i64, 3i64] }, tag: 7i64 };
    let mut a: i64 = 0i64;
    for x in s.inner.arr { a = a + x; }
    let mut b: i64 = 0i64;
    for x in mk() { b = b * 10i64 + x; }
    let mut c: i64 = 0i64;
    for x in &s.inner.arr { c = c + *x; }
    let mut n: i64 = 0i64; let p: *mut i64 = &mut n;
    let mut seen: i64 = 0i64;
    {
        let h: Hd = Hd { ds: [D { v: 1i64, c: p }, D { v: 2i64, c: p }] };
        for d in h.ds { seen = seen * 10i64 + d.v; }
    }
    let got: i64 = unsafe { *p };
    unsafe { printf("%lld %lld %lld %lld %lld\n".as_ptr(), a, b, c, seen, got); }
    return 0i32;
}
