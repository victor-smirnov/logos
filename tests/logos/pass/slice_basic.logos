// Priority #8: slice method surface — split_at, chunks, windows,
// binary_search, sort.
package slice_basic_test;

use logos.lang.slice;
use logos.lang.iter;
use logos.lang.option;
use logos.lang.result;

unsafe fn main() -> i32 {
    let arr: [i32; 6] = [1, 2, 3, 4, 5, 6];
    let s: &[i32] = &arr;

    // split_at at index 3 → ([1,2,3], [4,5,6])
    let pair = slice_split_at::<i32>(s, 3);
    if pair.left_len != 3 as i64 { return 1; }
    if pair.right_len != 3 as i64 { return 2; }
    let left_slice  = slice_from_raw::<i32>(pair.left_ptr, pair.left_len);
    let right_slice = slice_from_raw::<i32>(pair.right_ptr, pair.right_len);
    let lsum = iter_sum_i32(iter_copied::<SliceIter<i32>, i32>(iter_over_slice::<i32>(left_slice)));
    let rsum = iter_sum_i32(iter_copied::<SliceIter<i32>, i32>(iter_over_slice::<i32>(right_slice)));
    if lsum != 6 { return 3; }       // 1+2+3
    if rsum != 15 { return 4; }      // 4+5+6

    // chunks(2) on 1..7 → (1,2),(3,4),(5,6); each chunk sums = 3, 7, 11
    let mut chunks_it = slice_chunks::<i32>(s, 2);
    let chunk1 = chunks_it.next();
    match chunk1 {
        Option::Some(c) => { if iter_sum_i32(iter_copied::<SliceIter<i32>, i32>(iter_over_slice::<i32>(c))) != 3 { return 5; } }
        Option::None => { return 6; }
    }

    // windows(3) on 1..7 → first window (1,2,3) sums to 6
    let mut wins_it = slice_windows::<i32>(s, 3);
    let w1 = wins_it.next();
    match w1 {
        Option::Some(w) => { if iter_sum_i32(iter_copied::<SliceIter<i32>, i32>(iter_over_slice::<i32>(w))) != 6 { return 7; } }
        Option::None => { return 8; }
    }
    let w2 = wins_it.next();
    match w2 {
        Option::Some(w) => { if iter_sum_i32(iter_copied::<SliceIter<i32>, i32>(iter_over_slice::<i32>(w))) != 9 { return 9; } }  // 2+3+4
        Option::None => { return 10; }
    }

    // binary_search: 4 in [1..6] is at index 3
    match slice_binary_search::<i32>(s, 4) {
        Result::Ok(i) => { if i != 3 as i64 { return 11; } }
        Result::Err(_) => { return 12; }
    }
    // binary_search: 99 missing → Err(insertion_point=6)
    match slice_binary_search::<i32>(s, 99) {
        Result::Ok(_) => { return 13; }
        Result::Err(i) => { if i != 6 as i64 { return 14; } }
    }

    // sort: [3,1,4,1,5,9,2,6] → [1,1,2,3,4,5,6,9]
    let mut unsorted: [i32; 8] = [3, 1, 4, 1, 5, 9, 2, 6];
    let base: *mut i32 = &mut unsorted[0] as *mut i32;
    slice_sort::<i32>(base, 8 as i64);
    if unsorted[0] != 1 { return 20; }
    if unsorted[1] != 1 { return 21; }
    if unsorted[2] != 2 { return 22; }
    if unsorted[3] != 3 { return 23; }
    if unsorted[7] != 9 { return 24; }

    return 42;
}
