// query_gpath_e2e — GRAPH-PATH sugar on the RUNTIME engine (ADR 0016 M2a).
// The SAME desugar pass the static macro uses (shared plan→plan rewriting)
// serves Query::compile over a bind_source_tree source. Covers:
//   (a) exact key path / array steps / kind filter / mid-path bindings —
//       result parity with the equivalent hand-written classic queries;
//   (b) named errors: bind-less last step, a binder on a {kind} filter,
//       `**` with no following step, consecutive `**`;
//   (c) a gpath head + classic join step against a second tree source;
//   (d) `**` descent (the injected reach rel) — anywhere-key, trailing bind,
//       kind-filtered harvest — incl. parity with a hand-written rel.
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.mem.writ.parser;
use logos.lang.rc;
use logos.std.wql.ir;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

fn rows_of(text: str, env: &QEnv, c: &SchemaCatalog) -> i64 {
    match Query::compile(text, c) {
        Result::Ok(q) => {
            match q.run(env) {
                Result::Ok(rows) => { return rows.row_count(); }
                Result::Err(_e)  => { return -100i64; }
            }
        }
        Result::Err(_e2) => { return -200i64; }
    }
}

fn compile_err_contains(text: str, c: &SchemaCatalog, needle: str) -> bool {
    match Query::compile(text, c) {
        Result::Ok(_q) => { return false; }
        Result::Err(er) => { return str_contains(er.message(), needle); }
    }
}

fn main() -> i32 {
    let rc: Rc<Writ> = unsafe { writ_rc(65536i64) };
    let h: &Writ = rc.deref();
    let doc: WAny = unsafe { parse(h,
        r#"{ db: { engine: "pg", pool: { min: 2, max: 16 } },
             ports: [8080, 8443],
             cache: { engine: "redis" } }"#) };
    let c: SchemaCatalog = SchemaCatalog::new();
    let mut env: QEnv = QEnv::new();
    env.bind_source_tree("g", doc);

    // ── (a) sugar ≡ classic (result parity on counts) ───────────────────────
    if rows_of("from g .db .pool .min m select m.vi", &env, &c) != 1i64 { return 1i32; }
    if rows_of("from g .ports [*] p select p.vi", &env, &c) != 2i64 { return 2i32; }
    if rows_of("from g .ports [1] p select p.vi", &env, &c) != 1i64 { return 3i32; }
    if rows_of("from g * s {map} select s.key", &env, &c) != 2i64 { return 4i32; }
    if rows_of("from g .db d * e select (d.child, e.key)", &env, &c) != 2i64 { return 5i32; }
    // parity: the same question, hand-written classic form
    let sugar: i64 = rows_of(r#"from g .db d * e where e.key == "engine" select e.vs"#, &env, &c);
    let classic: i64 = rows_of(
        r#"from g a join g d on d.parent == a.child join g e on e.parent == d.child
           where a.parent == 0 && d.key == "db" && e.key == "engine" select e.vs"#, &env, &c);
    if sugar != 1i64 { return 6i32; }
    if sugar != classic { return 7i32; }

    // ── (b) named errors ────────────────────────────────────────────────────
    if !compile_err_contains("from g .db .pool select 1", &c, "must bind the row variable") { return 8i32; }
    if !compile_err_contains("from g * s {map} x select x.key", &c, "cannot carry a binder") { return 9i32; }
    if !compile_err_contains("from g .db ** select 1", &c, "must be followed by a step") { return 30i32; }
    if !compile_err_contains("from g ** ** v select v.vi", &c, "consecutive") { return 31i32; }

    // ── (d) ** descent ──────────────────────────────────────────────────────
    if rows_of("from g ** .engine e select e.vs", &env, &c) != 2i64 { return 10i32; }
    if rows_of("from g .db ** v select v.key", &env, &c) != 4i64 { return 32i32; }
    if rows_of("from g .db ** v {i64} select v.vi", &env, &c) != 2i64 { return 33i32; }
    // parity: ** ≡ the hand-written reach rel
    let sugar2: i64 = rows_of("from g ** .engine e select e.vs", &env, &c);
    let classic2: i64 = rows_of(
        r#"rel rch(a: i64, b: i64) {
             from g e select (e.parent, e.parent);
             from g e select (e.child, e.child);
             from rch r join g e on e.parent == r.b select (r.a, e.child);
           }
           from g a join rch r on r.a == a.child join g e on e.parent == r.b
           where a.parent == 0 && e.key == "engine" select e.vs"#, &env, &c);
    if sugar2 != classic2 { return 34i32; }

    // ── (c) gpath + classic join against a SECOND tree ──────────────────────
    let doc2: WAny = unsafe { parse(h, r#"{ svc: { engine: "mysql" } }"#) };
    let mut env2: QEnv = QEnv::new();
    env2.bind_source_tree("g", doc);
    env2.bind_source_tree("g2", doc2);
    // engines of g (via path) × engine edges of g2 (classic join by key)
    let n: i64 = rows_of(
        r#"from g .db d * e join g2 e2 on e2.key == e.key
           where e.key == "engine" select (e.vs, e2.vs)"#, &env2, &c);
    if n != 1i64 { return 11i32; }

    return 0i32;
}
