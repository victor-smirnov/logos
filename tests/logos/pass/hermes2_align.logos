// Hermes2 allocator — arbitrary power-of-two alignment with a minimum-2 floor
// (a Ref'd object's low bit must be 0). Interleave odd-sized requests so the bump
// cursor is misaligned, then verify each allocation meets its requested align.
package test;
use logos.lang.hermes2.container;
use logos.lang.hermes2.allocator;
use logos.lang.ptr;
fn main() -> i32 {
    let h: Hermes2 = hermes2_new(4096i64);
    unsafe {
        let a: *mut Allocator = &mut (&h as *const Hermes2 as *mut Hermes2).allocator as *mut Allocator;
        // request align 1 → floor to 2
        let p1: i64 = allocator_alloc(a, 1i64, 1i64) as i64;
        if p1 % 2i64 != 0i64 { return 1; }
        let _odd: i64 = allocator_alloc(a, 3i64, 1i64) as i64;   // bump to an odd-ish cursor
        let p4: i64 = allocator_alloc(a, 5i64, 4i64) as i64;
        if p4 % 4i64 != 0i64 { return 2; }
        let _o2: i64 = allocator_alloc(a, 1i64, 1i64) as i64;
        let p8: i64 = allocator_alloc(a, 7i64, 8i64) as i64;
        if p8 % 8i64 != 0i64 { return 3; }
        let _o3: i64 = allocator_alloc(a, 3i64, 1i64) as i64;
        let p16: i64 = allocator_alloc(a, 9i64, 16i64) as i64;
        if p16 % 16i64 != 0i64 { return 4; }
        let _o4: i64 = allocator_alloc(a, 5i64, 1i64) as i64;
        let p32: i64 = allocator_alloc(a, 1i64, 32i64) as i64;
        if p32 % 32i64 != 0i64 { return 5; }
        // typed alloc honours align_of: i64 → 8, i32 → 4, u8 → ≥2
        let pi64: i64 = hermes2_alloc::<i64>(&h as *const Hermes2 as *mut Hermes2) as i64;
        if pi64 % 8i64 != 0i64 { return 6; }
        let pi32: i64 = hermes2_alloc::<i32>(&h as *const Hermes2 as *mut Hermes2) as i64;
        if pi32 % 4i64 != 0i64 { return 7; }
    }
    return 0;
}
