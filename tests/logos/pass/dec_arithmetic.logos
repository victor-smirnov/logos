// Comprehensive Decimal arithmetic tests
package dec_arithmetic;
use hermes.ctr;
use std.string;

unsafe fn main() -> i32 {
    // ── 1. add(max_limb, 1) crosses limb boundary ────────────────────────────
    // 999999999 + 1 = 1000000000 = 10^9 (2 limbs: [0, 1])
    let mut d1: HermesCtr = HermesCtr::builder(8192);
    let a1: AnyVal = d1.decimal_from(10 as i32, 0 as i32, "999999999");
    let b1: AnyVal = d1.decimal_from(10 as i32, 0 as i32, "1");
    if a1.is_null() { return 1; }
    if b1.is_null() { return 2; }
    let r1: AnyVal = d1.decimal_add(a1, b1);
    if r1.is_null() { return 3; }
    if d1.decimal_len(r1) != 2 as u32 { return 4; }
    let s1: String = d1.decimal_to_string(r1);
    if !s1.eq_str("1000000000") { return 5; }

    // ── 2. add(x, -x) = 0 (opposite signs, equal magnitude) ─────────────────
    let mut d2: HermesCtr = HermesCtr::builder(8192);
    let pos: AnyVal = d2.decimal_from(10 as i32, 2 as i32, "123.45");
    let neg: AnyVal = d2.decimal_from(10 as i32, 2 as i32, "-123.45");
    if pos.is_null() { return 6; }
    if neg.is_null() { return 7; }
    let zero: AnyVal = d2.decimal_add(pos, neg);
    if zero.is_null() { return 8; }
    if d2.decimal_len(zero) != 0 as u32 { return 9; }  // should be zero (0 limbs)
    if d2.decimal_is_negative(zero) { return 10; }
    let sz: String = d2.decimal_to_string(zero);
    if !sz.eq_str("0.00") { return 11; }

    // ── 3. sub(-x, -x) = 0 (both negative, equal magnitude) ─────────────────
    let mut d3: HermesCtr = HermesCtr::builder(8192);
    let n1: AnyVal = d3.decimal_from(10 as i32, 2 as i32, "-50.00");
    if n1.is_null() { return 12; }
    let r3: AnyVal = d3.decimal_sub(n1, n1);
    if r3.is_null() { return 13; }
    if d3.decimal_is_negative(r3) { return 14; }
    let s3: String = d3.decimal_to_string(r3);
    if !s3.eq_str("0.00") { return 15; }

    // ── 4. add(-3, -4) = -7 (both negative → add magnitudes, keep negative) ──
    let mut d4: HermesCtr = HermesCtr::builder(8192);
    let nm3: AnyVal = d4.decimal_from(5 as i32, 2 as i32, "-3.00");
    let nm4: AnyVal = d4.decimal_from(5 as i32, 2 as i32, "-4.00");
    if nm3.is_null() { return 16; }
    if nm4.is_null() { return 17; }
    let r4: AnyVal = d4.decimal_add(nm3, nm4);
    if r4.is_null() { return 18; }
    if !d4.decimal_is_negative(r4) { return 19; }
    let s4: String = d4.decimal_to_string(r4);
    if !s4.eq_str("-7.00") { return 20; }

    // ── 5. sub(4, -3) = 7 (subtract negative = add) ──────────────────────────
    let mut d5: HermesCtr = HermesCtr::builder(8192);
    let p4: AnyVal = d5.decimal_from(5 as i32, 2 as i32, "4.00");
    let n3: AnyVal = d5.decimal_from(5 as i32, 2 as i32, "-3.00");
    if p4.is_null() { return 21; }
    if n3.is_null() { return 22; }
    let r5: AnyVal = d5.decimal_sub(p4, n3);
    if r5.is_null() { return 23; }
    if d5.decimal_is_negative(r5) { return 24; }
    let s5: String = d5.decimal_to_string(r5);
    if !s5.eq_str("7.00") { return 25; }

    // ── 6. sub(-3, 4) = -7 (negative minus positive → more negative) ─────────
    let mut d6: HermesCtr = HermesCtr::builder(8192);
    let n3b: AnyVal = d6.decimal_from(5 as i32, 2 as i32, "-3.00");
    let p4b: AnyVal = d6.decimal_from(5 as i32, 2 as i32, "4.00");
    if n3b.is_null() { return 26; }
    if p4b.is_null() { return 27; }
    let r6: AnyVal = d6.decimal_sub(n3b, p4b);
    if r6.is_null() { return 28; }
    if !d6.decimal_is_negative(r6) { return 29; }
    let s6: String = d6.decimal_to_string(r6);
    if !s6.eq_str("-7.00") { return 30; }

    // ── 7. Precision overflow rejects (but same P/S mismatch also rejects) ────
    let mut d7: HermesCtr = HermesCtr::builder(8192);
    let x7: AnyVal = d7.decimal_from(3 as i32, 2 as i32, "9.99");
    let y7: AnyVal = d7.decimal_from(3 as i32, 3 as i32, "0.001");
    if x7.is_null() { return 31; }
    if y7.is_null() { return 32; }
    // scale mismatch (2 vs 3) must return null
    let r7: AnyVal = d7.decimal_add(x7, y7);
    if !r7.is_null() { return 33; }

    // ── 8. Parsing: "0" → zero decimal ───────────────────────────────────────
    let mut d8: HermesCtr = HermesCtr::builder(4096);
    let z8: AnyVal = d8.decimal_from(1 as i32, 0 as i32, "0");
    if z8.is_null() { return 34; }
    if d8.decimal_len(z8) != 0 as u32 { return 35; }
    let s8: String = d8.decimal_to_string(z8);
    if !s8.eq_str("0") { return 36; }

    // ── 9. add(0, value) = value ──────────────────────────────────────────────
    let mut d9: HermesCtr = HermesCtr::builder(4096);
    let zero9: AnyVal = d9.decimal_from(10 as i32, 2 as i32, "0.00");
    let v9: AnyVal = d9.decimal_from(10 as i32, 2 as i32, "42.50");
    if zero9.is_null() { return 37; }
    if v9.is_null() { return 38; }
    let r9: AnyVal = d9.decimal_add(zero9, v9);
    if r9.is_null() { return 39; }
    let s9: String = d9.decimal_to_string(r9);
    if !s9.eq_str("42.50") { return 40; }

    // ── 10. Canonicalize: "007.50" → "7.50" ──────────────────────────────────
    let mut d10: HermesCtr = HermesCtr::builder(4096);
    let v10: AnyVal = d10.decimal_from(10 as i32, 2 as i32, "007.50");
    if v10.is_null() { return 41; }
    let s10: String = d10.decimal_to_string(v10);
    if !s10.eq_str("7.50") { return 42; }

    return 0;
}
