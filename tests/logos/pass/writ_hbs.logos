// HBS binary roundtrip on writ2: serialize -> bytes -> deserialize ->
// structurally equal + identical render.
package writ_hbs;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.mem.writ.parser;
use logos.mem.writ.wbs;
use logos.mem.writ.equal;
use logos.mem.writ.stringify;
use logos.mem.collections.vec;
use logos.lang.rc;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(16384);
    let h: &Writ = rc.deref();

    // 1. Parse a mixed document.
    let src: WAny = parse(h, "[1, \"hello\", true, null, 42]");
    let s1: String = stringify(src);

    // 2. Serialize to bytes.
    let wire: Vec<u8> = wbs_write(src);
    if wire.len() == 0 { return 1; }

    // 3. Deserialize into a second container.
    let rc2: Rc<Writ> = writ_rc(32768);
    let h2: &Writ = rc2.deref();
    let ws: &[u8] = wire.as_slice();
    let dst: WAny = wbs_read(h2, ws.as_ptr(), wire.len() as i64);
    if dst.is_null() { return 2; }

    // 4. Structural equality + identical render.
    if !writ_equal(src, dst) { return 3; }
    let s2: String = stringify(dst);
    if !s1.eq_str(s2.as_str()) { return 4; }

    return 0;
}
