package at_bind_struct_field_variant_sub;
struct Q { o: Option<i64>, y: i64 }
fn main() -> i32 {
    let q: Q = Q { o: Option::Some(4i64), y: 2i64 };
    let mut out: i64 = 0i64;
    match q {
        Q { o: a @ Option::Some(_), y } => { out = y; if let Option::Some(v) = a { out = out + v; } }
        Q { o: _, y: _ } => { out = -1i64; }
    }
    if out != 6i64 { return 1i32; }
    return 0i32;
}
