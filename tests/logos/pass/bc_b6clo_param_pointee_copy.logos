// THE LEGAL TWIN of fail/bc_b6clo_param_escape: the closure writes the
// closure-local's VALUE through the out-parameter, not a borrow of it.
// (2026-09-02c)
package bc_b6clo_param_pointee_copy;
fn dangle(out: &mut i64) {
    let c = || { let local: i64 = 4i64; *out = local; };
    c();
}
fn main() -> i32 {
    let mut z: i64 = 0i64;
    dangle(&mut z);
    return (z - 4i64) as i32;
}
