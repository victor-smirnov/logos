// Stress with fanout=4: more splits per N, deeper tree, more
// arc_replace_in_slot + writeback cycles. Confirms the rc protocol
// holds up under heavy CoW traffic.

package persistent_small_fanout;

use std.collections.vec;
use std.mem;
use std.lang.cmp; use std.lang.ord; use std.lang.datatypes;
use std.hermes.view; use std.hermes.anyval;

use std.data.persistent.node;
use std.data.persistent.cow;
use std.data.persistent.store;
use std.data.persistent.handle;

pub const StoreCfg: HermesStatic = @{
    "name": "small-fanout", "ctr_id": <type:u64>, "snp_id": <type:u64>, "block_id": <type:u64>,
};
pub const MapCfg: HermesStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 4 };

unsafe fn cp_of(snap: &mut Snap<StoreCfg>) -> *mut u64 {
    let store_ref: &mut LockingStore<StoreCfg> = snap.arc.deref_mut();
    return &mut store_ref.next_block_id as *mut u64;
}

fn main() -> i32 {
    let mut store: Store<StoreCfg> = store_open::<StoreCfg>();
    let mut commit: i64 = -1i64;

    // 200 entries with fanout=4 → tree of depth ~4 (4^4 = 256).
    {
        let mut snap: Snap<StoreCfg> = snap_begin::<StoreCfg>(&mut store);
        {
            let mut cr: ContainerRef<StoreCfg, MapCfg> =
                create_pmap::<MapCfg, StoreCfg>(&mut snap, 1u64);
            let s_id: u64 = snap.snapshot_id;
            let cp: *mut u64 = unsafe { cp_of(&mut snap) };
            let mut i: u64 = 0u64;
            while i < 200u64 {
                cr.insert(i, i * 13u64, &i as *const u64, s_id, cp);
                i = i + 1u64;
            }
            if cr.len() != 200u64 { return 10; }
            // Verify all 200.
            i = 0u64;
            while i < 200u64 {
                let mut out: u64 = 0u64;
                if !cr.get(&i as *const u64, &mut out as *mut u64) { return 11; }
                if out != i * 13u64 { return 12; }
                i = i + 1u64;
            }
            // Remove every 3rd key, leaves should hit underflow paths.
            i = 0u64;
            while i < 200u64 {
                if !cr.remove(&i as *const u64, s_id, cp) { return 13; }
                i = i + 3u64;
            }
            // Survivors (~134) still readable.
            i = 0u64;
            while i < 200u64 {
                let want: bool = i % 3u64 != 0u64;
                let got: bool = cr.contains(&i as *const u64);
                if want != got { return 14; }
                i = i + 1u64;
            }
        }
        commit = snap.commit();
    }
    if commit < 0i64 { return 20; }

    // Fork: the inherited tree is multi-level; descend reads must work.
    {
        let mut snap: Snap<StoreCfg> = snap_fork::<StoreCfg>(&mut store, commit);
        let mut cr: ContainerRef<StoreCfg, MapCfg> =
            open_pmap::<MapCfg, StoreCfg>(&mut snap, 1u64);
        let s_id: u64 = snap.snapshot_id;
        let cp: *mut u64 = unsafe { cp_of(&mut snap) };

        // Re-add the removed (every 3rd) keys with new values; first
        // mutation in this fork triggers full container CoW from root
        // through descent path.
        let mut i: u64 = 0u64;
        while i < 200u64 {
            cr.insert(i, i * 17u64, &i as *const u64, s_id, cp);
            i = i + 3u64;
        }
        if cr.len() != 200u64 { return 30; }
        // Verify: i % 3 == 0 → i*17, else → i*13 (inherited).
        i = 0u64;
        while i < 200u64 {
            let mut out: u64 = 0u64;
            if !cr.get(&i as *const u64, &mut out as *mut u64) { return 31; }
            let want: u64 = if i % 3u64 == 0u64 { i * 17u64 } else { i * 13u64 };
            if out != want { return 32; }
            i = i + 1u64;
        }
    }

    // Original commit must still resolve cleanly post-fork.
    {
        let mut snap: Snap<StoreCfg> = snap_fork::<StoreCfg>(&mut store, commit);
        let cr: ContainerRef<StoreCfg, MapCfg> =
            open_pmap::<MapCfg, StoreCfg>(&mut snap, 1u64);
        let mut i: u64 = 0u64;
        while i < 200u64 {
            let want: bool = i % 3u64 != 0u64;
            let got: bool = cr.contains(&i as *const u64);
            if want != got { return 40; }
            i = i + 1u64;
        }
    }

    return 0;
}
