// Stress with fanout=4: more splits per N, deeper tree, more
// arc_replace_in_slot + writeback cycles. Confirms the rc protocol
// holds up under heavy CoW traffic.

package persistent_small_fanout;

use logos.mem.collections.vec;
use logos.lang.mem;
use logos.lang.cmp; use logos.lang.cmp; use logos.lang.fabric;
use logos.lang.writ.wstatic;

use logos.std.data.persistent.bt.node;
use logos.std.data.persistent.bt.cow;
use logos.std.data.persistent.store;
use logos.std.data.persistent.handle;

pub const StoreCfg: WritStatic = @{
    "name": "small-fanout", "ctr_id": <type:u64>, "snp_id": <type:u64>, "block_id": <type:u64>,
};
pub const MapCfg: WritStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 4 };


fn main() -> i32 {
    let mut store = store_open::<StoreCfg>();
    let mut commit = 0u64;

    // 200 entries with fanout=4 → tree of depth ~4 (4^4 = 256).
    {
        let mut snap = store.fork(GENESIS);
        {
            let mut cr =
                create_ctr::<MapCfg>(&mut snap, 1u64);
            let mut i = 0u64;
            while i < 200u64 {
                cr.insert(i, i * 13u64);
                i = i + 1u64;
            }
            if cr.len() != 200u64 { return 10; }
            // Verify all 200.
            i = 0u64;
            while i < 200u64 {
                let out = match cr.get(i) {
                    Option::Some(x) => x,
                    Option::None => { return 11; }
                };
                if out != i * 13u64 { return 12; }
                i = i + 1u64;
            }
            // Remove every 3rd key, leaves should hit underflow paths.
            i = 0u64;
            while i < 200u64 {
                if !cr.remove(i) { return 13; }
                i = i + 3u64;
            }
            // Survivors (~134) still readable.
            i = 0u64;
            while i < 200u64 {
                let want: bool = i % 3u64 != 0u64;
                let got: bool = cr.contains(i);
                if want != got { return 14; }
                i = i + 1u64;
            }
        }
        commit = snap.commit();
    }

    // Fork: the inherited tree is multi-level; descend reads must work.
    {
        let mut snap = store.fork(commit);
        let mut cr =
            open_ctr::<MapCfg>(&mut snap, 1u64).unwrap();

        // Re-add the removed (every 3rd) keys with new values; first
        // mutation in this fork triggers full container CoW from root
        // through descent path.
        let mut i = 0u64;
        while i < 200u64 {
            cr.insert(i, i * 17u64);
            i = i + 3u64;
        }
        if cr.len() != 200u64 { return 30; }
        // Verify: i % 3 == 0 → i*17, else → i*13 (inherited).
        i = 0u64;
        while i < 200u64 {
            let out = match cr.get(i) {
                Option::Some(x) => x,
                Option::None => { return 31; }
            };
            let want = if i % 3u64 == 0u64 { i * 17u64 } else { i * 13u64 };
            if out != want { return 32; }
            i = i + 1u64;
        }
    }

    // Original commit must still resolve cleanly post-fork.
    {
        let mut snap = store.fork(commit);
        let cr =
            open_ctr::<MapCfg>(&mut snap, 1u64).unwrap();
        let mut i = 0u64;
        while i < 200u64 {
            let want: bool = i % 3u64 != 0u64;
            let got: bool = cr.contains(i);
            if want != got { return 40; }
            i = i + 1u64;
        }
    }

    return 0;
}
