// End-to-end smoke for the persistent stack: store_open → snap_begin
// → create_pmap → insert → commit → drop chain releases everything.
//
// v1 limits: single-leaf inserts only (no branch descent / splits).
// Snapshot fork + multi-level CoW land when mutate's full BTree
// algos port over.

package zz_v3_handle_smoke;

use logos.mem.collections.vec;
use logos.lang.mem;
use logos.lang.cmp; use logos.lang.cmp; use logos.lang.fabric;
use logos.lang.drop;
use logos.lang.hermes.hstatic;

use logos.std.data.persistent.bt.node;
use logos.std.data.persistent.bt.cow;
use logos.std.data.persistent.store;
use logos.std.data.persistent.handle;

pub const StoreCfg: HermesStatic = @{
    "name":     "handle",
    "ctr_id":   <type:u64>,
    "snp_id":   <type:u64>,
    "block_id": <type:u64>,
};

pub const MapCfg: HermesStatic = @{
    "key":    <type:u64>,
    "value":  <type:u64>,
    "fanout": 8,
};

fn main() -> i32 {
    let mut store: Store<StoreCfg> = store_open::<StoreCfg>();
    let mut snap:  Snap<StoreCfg>  = store.fork(GENESIS);

    {
        let mut cr: ContainerRef<StoreCfg, MapCfg> =
            create_pmap::<MapCfg, StoreCfg>(&mut snap, 7u64);

        if cr.len() != 0u64 { return 1; }

        // Push enough entries to force multi-level splits (fanout=8).
        let mut i: u64 = 0u64;
        while (i < 1000u64) {
            let k: u64 = i;
            cr.insert(k, k * 7u64);
            i = i + 1u64;
        }
        if cr.len() != 1000u64 { return 2; }

        // Verify all keys are reachable through descent.
        let mut probe: u64 = 0u64;
        while (probe < 1000u64) {
            if !cr.contains(probe) { return 10 + probe as i32; }
            let out: u64 = match cr.get(probe) {
                Option::Some(x) => x,
                Option::None => { return 50 + probe as i32; }
            };
            if out != probe * 7u64 { return 100 + probe as i32; }
            probe = probe + 1u64;
        }

        // 8 fits in fanout=8, no split. Just verify reads.
        let r1: u64 = 5u64;
        if !cr.remove(r1) { return 4; }
        if cr.len() != 999u64 { return 6; }
        if cr.contains(r1) { return 7; }
    }

    let id: u64 = snap.commit();
    

    // snap drops at fn-end — its dir NodeARC's drop chain hits:
    //   dir LeafDirNode → vals: Vec<NodeARC> → child container root
    //   NodeARCs → leaves' rc 1→0 → leaves' Buffer auto-drops.
    //
    // BUT: commit cloned the dir's rc into the DAG, so the DAG-side
    // entry keeps everything alive past snap's drop. When `store`
    // drops at fn-end, the DAG (Vec<CommitEntry>) auto-drops →
    // CommitEntry.drop → NodeARC.drop → recursive release. Full
    // teardown.

    return 0;
}
