// `while let Some(mut x) = … && cond` keeps `mut` PROBES.md 2026-09-06d: `if let` / `while let` / let-chains lower BY DELEGATION to lower_match (temp hoist, per-arm scrutinee move, arm drops, cond-move merge); the count is a destructor tally through a raw pointer.
package bc_patown_whileletchain_mut;
use logos.mem.collections.vec;
struct S { v: i64 }
fn main() -> i32 {
    let mut vs: Vec<S> = Vec::new();
    vs.push(S { v: 1i64 });
    vs.push(S { v: 2i64 });
    let mut out: i64 = 0i64;
    while let Option::Some(mut s) = vs.pop() && s.v > 0i64 {
        s.v = s.v + 10i64;
        out = out + s.v;
    }
    if out != 23i64 { return 1i32; }
    return 0i32;
}
