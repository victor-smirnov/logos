// A bool reaching LENIENT arithmetic is worth ONE — RATIFIED, and now stated
// where the language states rules: `deem.exec.lenient-bool-one` in
// docs/spec/deem.md.
//
// Victor ruled that `avg` admits bool with true worth 1.0. Implementing that
// gave `rt_f` (deem.logos) a `B` arm. The commit disclosed one consequence —
// `QRows::get_f64` on a bool cell — and DENIED any other, on the ground that
// every other caller is EL arithmetic over operands `check_expr` has already
// typed as numeric, "so a bool cannot reach them".
//
// The denial is false. `ct_is_open(t)` is `t == CT_UNKNOWN || t == CT_DYN`
// (deem.logos) and check.logos uses it to waive the numeric-operand refusal for
// exactly the types that were NOT typed as numeric. An FK_ANY cell holding a
// bool is CT_DYN at check time and RtVal::B at run time, so it reaches `rt_f`.
// MEASURED by control revert on a REBUILT stdlib: `e.meta + 1.0` answers 2.0
// with the arm and 1.0 without; `e.meta` read through `get_f64` answers 1.0 with
// and 0.0 without.
//
// ⚠ WHAT CHANGED, AND WHAT DID NOT. This file used to say it pinned the numbers
// PENDING a ruling, and listed three defensible answers (ratify one; refuse a
// bool operand in lenient arithmetic; leave the path untyped). The ruling is
// now RATIFY ONE, on three grounds: it agrees with `rt_i`, which has answered 1
// for a bool since c00b2888 (2026-07-02, the original queue-2 slice — a month
// before `rt_f`'s arm), so the two spellings of "what is a bool worth" finally
// agree; it is the current behaviour, so it preserves every program that works
// today, which is the express ground the `avg` ruling itself gave; and a value
// that differs by which accessor you read it through is not a value.
// NOT ONE NUMBER IN THIS FILE MOVED — the numbers were the behaviour and the
// behaviour is what was ratified. What moved is the rule's home: a rule
// asserted only by a test is a rule nobody can look up, so it is written in the
// spec and this file is now its end-to-end pin rather than its only record.
//
// ⚠⚠ METHOD. The first attempt to check the two statements above ran `ctest`
// after editing but BEFORE rebuilding the stdlib. ctest runs PREBUILT archives,
// so both probes measured a tree without the arm and both came back "measured
// false" — the correct conclusion inverted by a stale build. Edit, BUILD, run.
//
// exit 0 = a bool is worth one in every numeric spelling reachable from here,
//          which is `deem.exec.lenient-bool-one` end to end.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Rec : code(0x0B13_0000_0000_0031) {
    name: str  = 0,
    meta: WAny = 1,   // FK_ANY — CT_DYN at check time, RtVal::B at run time
}

resource cat = schema_catalog!{ Rec };

fn mk(d: &Writ, name: str, meta: bool) -> WAny {
    let r: Rec = d.make::<Rec>();
    r.name = name;
    r.meta = WAny::from(meta);
    let w: i64 = r.m as i64;
    return WAny::ref_to(w as *const u8);
}

fn f64_of(qt: str, c: &SchemaCatalog, env: &QEnv) -> f64 {
    match Query::compile(qt, c) {
        Result::Ok(q) => {
            match q.run(env) {
                Result::Ok(r) => {
                    if r.row_count() != 1i64 { return -777.0f64; }
                    return r.get_f64(0i64, 0i64);
                }
                Result::Err(_a) => { return -778.0f64; }
            }
        }
        Result::Err(_b) => { return -779.0f64; }
    }
}
fn i64_of(qt: str, c: &SchemaCatalog, env: &QEnv) -> i64 {
    match Query::compile(qt, c) {
        Result::Ok(q) => {
            match q.run(env) {
                Result::Ok(r) => {
                    if r.row_count() != 1i64 { return -777i64; }
                    return r.get_i64(0i64, 0i64);
                }
                Result::Err(_a) => { return -778i64; }
            }
        }
        Result::Err(_b) => { return -779i64; }
    }
}

fn main() -> i32 {
    let d: Writ = writ_new(8192i64);
    let c: SchemaCatalog = cat();
    let rows: &mut WArray<WAny> = d.array(4i64);
    rows.push(mk(&d, "t", true));
    let src: WAny = WAny::ref_to(rows as *const WArray<WAny> as *const u8);
    let mut env: QEnv = QEnv::new();
    env.bind_source("rows", src);

    // ── 1. the INTEGER spelling: a bool is worth one, and always has been ──
    if i64_of("from rows e select e.meta", &c, &env) != 1i64 { return 10i32; }
    if i64_of("from rows e select (e.meta + 1)", &c, &env) != 2i64 { return 11i32; }

    // ── 2. the FLOAT spelling now AGREES, and that is the change ───────────
    // Exact comparisons: 0.0, 1.0 and 2.0 are all representable, so no tolerance
    // is involved and none is being relaxed. Both of these answered differently
    // before the `rt_f` B arm: `e.meta` read 0.0 and `e.meta + 1.0` read 1.0.
    if f64_of("from rows e select e.meta", &c, &env) != 1.0f64 { return 20i32; }
    if f64_of("from rows e select (e.meta + 1.0)", &c, &env) != 2.0f64 { return 21i32; }

    // ── 3. the ruling's own path over a LENIENT column: a RUN-TIME ERROR ───
    // Measured, and it is the third distinct answer to "what is a bool worth"
    // reachable from one program: 1 (get_i64), 0.0 (get_f64), and here `q.run`
    // returns Err. The ruling admits bool for a column the schema TYPES as bool
    // — wql_agg_avg_bool_three_engines pins that at 0.75 — and says nothing
    // about a bool arriving through an FK_ANY cell, which is what this is.
    // Erroring is a defensible answer for the lenient path; having three answers
    // is not. Pinned so the count cannot quietly become four.
    let a: f64 = f64_of("from rows e group by e.name aggregate m = avg(e.meta) select m", &c, &env);
    if a != -778.0f64 { return 30i32; }   // -778.0 = `q.run` returned Err

    return 0i32;
}
