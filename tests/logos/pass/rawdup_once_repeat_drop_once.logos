// OnceIter MOVES its value out; RepeatIter CLONES per pull. Both balance creations against destructions.
//
// #112 — the `*((&x) as *const T)` duplicate-owner class.

package rawdup_once_repeat_drop_once;

use logos.std.fmt;
use logos.lang.option;
use logos.lang.iter;
use logos.mem.collections.vec;
use logos.lang.clone;

// Heap-owning AND printing payload — see rawdup_option_filter_drop_once for why both
// halves are load-bearing. The assertion is the EXACT set of destructor lines.
struct Inner { pub n: i64, pub v: Vec<i64> }
impl Drop for Inner { fn drop(self: &mut Inner) { println!("DROP n={}", self.n); } }
impl Clone for Inner { fn clone(self: &Inner) -> Inner { let mut v: Vec<i64> = vec_new::<i64>(); v.push(self.n); return Inner { n: self.n, v: v }; } }
fn mk(n: i64) -> Inner { let mut v: Vec<i64> = vec_new::<i64>(); v.push(n); return Inner { n: n, v: v }; }

fn main() -> i32 {
    println!("-- once, pulled");
    let mut a: OnceIter<Inner> = iter_once::<Inner>(mk(5i64));
    match a.next() { Option::Some(x) => { println!("got={}", x.n); } Option::None => { println!("none"); } }
    match a.next() { Option::Some(x) => { println!("got2={}", x.n); } Option::None => { println!("exhausted"); } }
    println!("-- once, never pulled");
    let b: OnceIter<Inner> = iter_once::<Inner>(mk(9i64));
    println!("-- once, next_back");
    let mut c: OnceIter<Inner> = iter_once::<Inner>(mk(6i64));
    match c.next_back() { Option::Some(x) => { println!("back={}", x.n); } Option::None => { println!("none"); } }
    println!("-- repeat, two pulls");
    let mut r: RepeatIter<Inner> = iter_repeat::<Inner>(mk(4i64));
    match r.next() { Option::Some(x) => { println!("r1={}", x.n); } Option::None => { } }
    match r.next() { Option::Some(x) => { println!("r2={}", x.n); } Option::None => { } }
    println!("-- end");
    return 0i32;
}
