package bc_vecstore_value_reads_loan_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
fn show(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    v.push(1i64); v.push(2i64);
    let e: &i64 = &v[1u64];
    v[0u64] = *e + 1i64;
    let k: i64 = v[0u64];
    show("k=%lld", k);
    return k as i32;
}
