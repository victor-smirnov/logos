package memoria_pmap;
use logos.std.data.memoria.pmap;
use logos.lang.option;
use logos.lang.iter;

fn main() -> i32 {
    let mut m: PMap<u64, i64> = PMap::<u64, i64>::new();
    m.insert(3u64, 300i64);
    m.insert(1u64, 100i64);
    m.insert(2u64, 200i64);
    if m.len() != 3u64 { return 1; }
    if m.is_empty() { return 2; }
    // get -> Option<V>
    match m.get(2u64) { Option::Some(v) => { if v != 200i64 { return 3; } } Option::None => { return 4; } }
    match m.get(9u64) { Option::Some(_) => { return 5; } Option::None => { } }
    if !m.contains(1u64) { return 6; }
    // ordered iteration with tuple destructure
    let mut prev: u64 = 0u64; let mut n: u64 = 0u64;
    for e in m.iter() {
        let k: u64 = e.0; let v: i64 = e.1;
        if k <= prev && n > 0u64 { return 7; }   // strictly ascending
        if v != (k as i64) * 100i64 { return 8; }
        prev = k; n = n + 1u64;
    }
    if n != 3u64 { return 9; }
    // remove
    if !m.remove(2u64) { return 10; }
    if m.contains(2u64) { return 11; }
    if m.len() != 2u64 { return 12; }
    // snapshot independence
    let snap: PMap<u64, i64> = m.snapshot();
    m.insert(7u64, 700i64);
    if snap.len() != 2u64 { return 13; }     // snapshot unchanged
    if m.len() != 3u64 { return 14; }
    return 0;
}
