// Rust's Vec surface beyond push/pop: sort, sort_by, sort_by_key (stable), dedup, retain, binary_search, insert,
// truncate, swap_remove — none existed. Checked under valgrind (String elements dropped once). rustc twin: 0.
package vec_sort_retain_dedup_api;
use logos.mem.collections.vec;
use logos.mem.string;
struct P { k: i64, tag: i64 }
fn main() -> i32 {
    let mut fails = 0;
    let mut v: Vec<i64> = vec![5, 3, 9, 1, 3, 7];
    v.sort();
    if v[0] != 1 || v[1] != 3 || v[2] != 3 || v[5] != 9 { fails = fails + 1; }
    v.dedup();
    if v.len() != 5 { fails = fails + 2; }
    v.retain(|x: &i64| -> bool { return *x % 3 != 0; });
    if v.len() != 3 { fails = fails + 4; }
    match v.binary_search(&7) { Result::Ok(i) => { if i != 2 { fails = fails + 8; } } Result::Err(_) => { fails = fails + 8; } }
    v.insert(0, 42);
    if v[0] != 42 { fails = fails + 16; }
    let mut ps: Vec<P> = Vec::new();
    ps.push(P { k: 2, tag: 0 }); ps.push(P { k: 1, tag: 1 }); ps.push(P { k: 2, tag: 2 }); ps.push(P { k: 1, tag: 3 });
    ps.sort_by_key(|p: &P| -> i64 { return p.k; });
    if ps[0].tag != 1 || ps[1].tag != 3 || ps[2].tag != 0 || ps[3].tag != 2 { fails = fails + 32; }
    let mut ss: Vec<String> = Vec::new();
    ss.push(String::from("pear")); ss.push(String::from("apple")); ss.push(String::from("fig"));
    ss.sort_by(|a: &String, b: &String| -> Ordering { return b.len().cmp(&a.len()); });
    if ss[0].len() != 5 { fails = fails + 64; }
    ss.retain(|s: &String| -> bool { return s.len() > 3; });
    ss.truncate(1);
    let t = ss.swap_remove(0);
    if t.len() != 5 || ss.len() != 0 { fails = fails + 128; }
    return fails;
}
