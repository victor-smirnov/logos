// REGRESSION: the Writ recursive tree walkers (compactify / clone / equal) must
// not stack-overflow (SIGSEGV) on deeply-nested-but-valid input. Before the depth
// guard, a chain of ~100000 WArray<WAny> — each holding the next child — recursed
// one native C-stack frame per nesting level inside compactify()/equal() and
// crashed the process (EXIT=139). The fix caps descent at *_MAX_DEPTH (4096):
// past the cap the walker stops (compactify → null, equal → not-equal) and unwinds
// into a bounded best-effort result — never a crash. This mirrors the parser guard
// (WRIT_PARSE_MAX_DEPTH). Same class as clone.writ_clone_into / mem.writ.writ_equal.
// Also asserts SHALLOW nesting still compactifies to an equal copy (guard is far
// above any real document).
package writ_compactify_deep_nesting_bounded;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.compactify;
use logos.lang.writ.equal;

// Build a chain of `depth` nested single-element arrays around a 42 leaf, all in
// arena `h`. Returns the root WAny (never-move; each parent holds its child).
fn build_deep(h: &Writ, depth: i64) -> WAny {
    let bottom: &mut WArray<WAny> = h.array(1i64);
    bottom.push(42i64);
    let mut cur: WAny = WAny::ref_to(&*bottom as *const WArray<WAny> as *const u8);
    let mut i: i64 = 0i64;
    while i < depth {
        let outer: &mut WArray<WAny> = h.array(1i64);
        outer.push(cur);
        cur = WAny::ref_to(&*outer as *const WArray<WAny> as *const u8);
        i = i + 1i64;
    }
    return cur;
}

fn main() -> i32 {
    let h: Writ = writ_new(4096i64);

    // 1) Adversarial deep nesting well past the crashing threshold (was SIGSEGV).
    //    compactify must return WITHOUT crashing (bounded partial copy or null).
    let deep: WAny = build_deep(&h, 100000i64);
    let h2: Writ = writ_new(65536i64);
    let packed: WAny = compactify(&h2, deep);
    // equal on the deep tree walks the same way — must also survive (no crash).
    let _e: bool = equal(deep, packed);
    // Reference `packed` so the copy is not optimized away.
    if packed.raw() == 12345678i64 { return 1; }

    // 2) Shallow nesting (well within the cap) must still round-trip correctly:
    //    compactify produces a VALUE-equal independent copy.
    let sh: Writ = writ_new(4096i64);
    let src: WAny = build_deep(&sh, 8i64);
    let sh2: Writ = writ_new(4096i64);
    let cp: WAny = compactify(&sh2, src);
    if cp.is_null() { return 2; }
    if !cp.is_array() { return 3; }
    if !equal(src, cp) { return 4; }   // copy must equal the original (identity oracle)

    return 0;
}
