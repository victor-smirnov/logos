// S0 conformance: runtime key-type descriptor (logos.std.data.memoria.keydesc).
// Resolve descriptors by Hermes type-code at runtime, dispatch cmp/build_view/
// hash through the `dyn KeyDesc` vtable, confirm a 2-block KeyView round-trips.
package memoria_keydesc;

use logos.std.data.memoria.keydesc;
use logos.lang.hermes.anyval;     // H2_U64 / H2_I64
use logos.lang.cmp;               // Ordering

fn main() -> i32 {
    unsafe {
        // u64 descriptor resolved at runtime by type-code.
        let du: *mut dyn KeyDesc = desc_for(H2_U64);
        if (&*du).key_size() != 8u64 { return 1; }
        if (&*du).meta_is_ptr()      { return 2; }

        let mut a: u64 = 100u64;
        let mut b: u64 = 200u64;
        match (&*du).cmp_raw(&a as *const u64 as *const u8,
                             &b as *const u64 as *const u8, 0u64) {
            Ordering::Less => { }
            _ => { return 3; }
        }

        // build_view: 2-block view round-trips data + meta.
        let v: KeyView = (&*du).build_view(&a as *const u64 as *const u8, 0xAAu64);
        if v.meta != 0xAAu64                 { return 4; }
        if *(v.data as *const u64) != 100u64 { return 5; }

        if (&*du).hash_raw(&a as *const u64 as *const u8, 0u64) != 100u64 { return 6; }

        // i64 descriptor: signed compare, -5 < 3 (unsigned would say >).
        let di: *mut dyn KeyDesc = desc_for(H2_I64);
        let mut x: i64 = -5i64;
        let mut y: i64 = 3i64;
        match (&*di).cmp_raw(&x as *const i64 as *const u8,
                             &y as *const i64 as *const u8, 0u64) {
            Ordering::Less => { }
            _ => { return 7; }
        }
    }
    return 0;
}
