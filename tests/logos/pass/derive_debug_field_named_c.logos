// `#[derive_debug]` names each field by stringifying it (`##field`), a quote-less LIT_STR value; a field whose name
// starts with `c` (`cents`, `cr_id`) was read as a C-string literal (`&'static CStr`). A real `c"…"` stays one. As rustc.
package derive_debug_field_named_c;
use logos.std.fmt;
use logos.lang.ffi;
#[derive_debug]
struct M { cents: i64, cr_id: i64, zz: i64 }
fn main() { let m = M { cents: 5, cr_id: 6, zz: 7 }; println!("{:?}", m); let c = c"ok"; println!("{}", c.to_bytes().len()); }
