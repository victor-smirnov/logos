// A quote carries CONDITIONAL imports (`use #pkg?;`).
//
// The last unknown between the quote system and a converted emitter. An emitter
// writes a text CHUNK today — its own module document with its own use-decls —
// and the reason that looked load-bearing is that its imports are DYNAMIC: a
// query imports the module of each native source it happens to bind, a list
// known only while the emitter runs.
//
// The quote route already answers that. `use #pkg?;` drops the whole import when
// the substituted path is EMPTY, so a fixed set of optional slots expresses a
// runtime-sized import list without a blob-variant per present/absent
// combination.
//
// ⚠ THE ASSERTION IS THE COMPILE, and it only asserts if the PRESENT package is
// otherwise UNREACHABLE. The first version imported `logos.mem.collections.vec`
// — reachable through the implicit prelude — so it passed while the mechanism
// was a no-op: the quote's USES were never numbered by the lowering and the
// splice path dropped the placeholder outright. `logos.lang.writ.container` is
// neither imported by this module nor re-exported by the prelude, so an import
// that fails to land fails the compile.
package test;

use logos.std.compiler.metaprog;
use logos.mem.string;
use logos.lang.str;

fn gen(want_writ: bool) -> QuoteItemBlob {
    // The PRESENT case: a real module path, chosen at metaprog time.
    let a: Ident = if want_writ { Ident::new("logos.lang.writ.container") }
                   else { Ident::new("") };
    // The ABSENT case: an empty path, so this import must vanish entirely.
    let b: Ident = Ident::new("");
    return quote_item! {
        use #a?;
        use #b?;
        pub fn made() -> i64 {
            let _w: Writ = writ_new(1024i64);
            return 42i64;
        }
    };
}

metacall gen(true);

fn main() -> i32 {
    if made() != 42i64 { return 1i32; }
    return 0i32;
}
