// Closed squeue refcell_replace_noncopy_refused (#686): RefCell::replace/swap read the old value with logos.lang.ptr::read (#463) instead of a move out of the raw pointer; the pre-mono check of impl-generic methods found it in the stdlib build.
package refcell_replace_noncopy_refused;
use logos.lang.cell;
struct N { id: i32 }
impl Drop for N { fn drop(&mut self) { } }
fn main() -> i32 {
    let c = RefCell::new(N { id: 1 });
    let old = c.replace(N { id: 2 });
    if old.id == 1 && c.borrow().id == 2 { return 0i32; }
    return 1i32;
}
