// Slice 4 of metaprog-quote (~/.claude/plans/metaprog-quote.md).
//
// `quote_item! { item* }` lowers in sema to a `QuoteItemBlob` value
// bundling a Writ template blob and a (possibly-empty) idents array.
// The hook hands the blob to logos_emit_item_blob_subst and the host
// substitutes `#name` placeholders before splicing the items as a
// fresh entry-ast. Main then uses the injected struct at runtime.

package main;

use logos.std.compiler.metaprog;
use logos.lang.writ.wstatic;

#[metaprog_handler("quote_inject")]
fn quote_inject_hook(target_offset: u32) -> () {
    let blob: QuoteItemBlob = quote_item! {
        struct QuotedFoo { x: i32 }
    };
    unsafe {
        logos_emit_item_blob_subst(&blob);
    }
    return;
}

#[quote_inject]
struct Marker {}

unsafe fn main() -> i32 {
    let f: QuotedFoo = QuotedFoo { x: 42 };
    return f.x;
}
