// Trait with void method dispatched through generic
package trait_void_dispatch;
extern fn puts(s: *const u8) -> i32;
fn print(s: str) { unsafe { puts(s.as_ptr()); } }
trait Notify { fn notify(self: Self); }
struct Msg { code: i32, }
impl Notify for Msg {
    fn notify(self: Msg) { print("notified"); }
}
fn send<T: Notify>(x: T) { x.notify(); }
unsafe fn main() -> i32 {
    // send moves its by-value arg (Msg is non-Copy); read code first, then send.
    let m: Msg = Msg { code: 42 };
    let code: i32 = m.code;
    send::<Msg>(m);
    return code;
}
