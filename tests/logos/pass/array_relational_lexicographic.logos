// #377 — RELATIONAL OPERATORS ON ARRAYS. Was a refusal (a raw binop on the
// aggregate's slot pointer reached `arith.cmpi`, an ICE); the refusal stood
// while `[T; N]` had no ordering impl. It has one now (Rust's lexicographic
// `impl<T: PartialOrd, const N: usize> PartialOrd for [T; N]`, 2026-10-17), so
// `a < b` orders through it: [1, 2] < [1, 3] — exit 0. The twin
// `array_relational_admitted` keeps the shapes that worked before.
package array_relational_lexicographic;

fn main() -> i32 {
    let a: [i32; 2] = [1i32, 2i32];
    let b: [i32; 2] = [1i32, 3i32];
    return if a < b { 0i32 } else { 1i32 };
}
