// ADR 0026 F9 — a merge join over two sources that ascend on the join key.
//
// `BTreeMap` and the local `Runs` both declare `order entry = key` over an
// `OrderedBy` walk, so an equi-join on the two key columns walks both in step
// (the plan facts gate pins `merge join` on the admitted queries and
// `merge declined` / a hash join on the twin). Under `order by` (`mj_order`)
// the step still merges and pins the written nest (`WG_MERGE`); the sort runs
// after it. `Runs` holds DUPLICATE keys, so
// a base key repeats (the run is replayed) and a step key repeats (the run
// holds several rows). Every expectation is derived by hand from the data
// below, in the nest's sequence: base order, then step order.
//
//   a: 1→10 2→20 4→40 5→50 7→70          (BTreeMap, inserted out of order)
//   b: 2→200 3→300 4→400 7→700 9→900    (BTreeMap)
//   r: 2→1 2→2 4→3 4→4 4→5 8→6          (Runs, sorted, keys repeat)
//   s: 2→7 4→8 4→9 6→0                  (Runs)
package test;

use logos.std.wql.source;
use logos.std.wql.wql;
use logos.mem.bt.map;             // trait OrderedMapSource
use logos.mem.collections.btree;
use logos.mem.collections.vec;
use logos.lang.iter;
use logos.lang.stream;            // OrderedBy
use logos.lang.option;
use logos.lang.result;

pub struct Runs { pub keys: [i64; 6], pub vals: [i64; 6], pub n: i64 }

pub struct RunRows { r: *const Runs, at: i64 }

impl Iterator for RunRows {
    type Item = (i64, i64);
    fn next(self: &mut RunRows) -> Option<(i64, i64)> {
        unsafe {
            if self.at >= (*self.r).n { return Option::None; }
            let v: (i64, i64) = ((*self.r).keys[self.at], (*self.r).vals[self.at]);
            self.at = self.at + 1i64;
            return Option::Some(v);
        }
    }
}

impl OrderedBy<i64> for RunRows { }

pub fn runs_rows(m: &Runs) -> RunRows { return RunRows { r: m as *const Runs, at: 0i64 }; }

impl OrderedMapSource<i64, i64> for Runs {
    rel entry = runs_rows;
    order entry = key;
}

pub struct Bag { pub k: i64 }

// ── admitted ────────────────────────────────────────────────────────────────
pub deem mj(a: &BTreeMap<i64, i64>, b: &BTreeMap<i64, i64>) {
    from a x join b y on x.key == y.key select (x.key, x.val, y.val) }
pub deem mj_flip(a: &BTreeMap<i64, i64>, b: &BTreeMap<i64, i64>) {
    from a x join b y on y.key == x.key select (x.key, x.val, y.val) }
pub deem mj_resid(a: &BTreeMap<i64, i64>, b: &BTreeMap<i64, i64>) {
    from a x join b y on x.key == y.key && x.key + y.val > 400 select (x.key, x.val, y.val) }
pub deem mj_where(a: &BTreeMap<i64, i64>, b: &BTreeMap<i64, i64>) {
    from a x join b y on x.key == y.key where x.key != 4 select (x.key, x.val, y.val) }
pub deem mj_limit(a: &BTreeMap<i64, i64>, b: &BTreeMap<i64, i64>) {
    from a x join b y on x.key == y.key select (x.key, x.val, y.val) limit 2 }
pub deem mj_base_runs(r: &Runs, b: &BTreeMap<i64, i64>) {
    from r x join b y on x.key == y.key select (x.key, x.val, y.val) }
pub deem mj_step_runs(a: &BTreeMap<i64, i64>, r: &Runs) {
    from a x join r y on x.key == y.key select (x.key, x.val, y.val) }
pub deem mj_both_runs(r: &Runs, s: &Runs) {
    from r x join s y on x.key == y.key select (x.key, x.val, y.val) }
pub deem mj_group(r: &Runs, s: &Runs) {
    from r x join s y on x.key == y.key group by x.key aggregate n = count(), t = sum(y.val) select (key, n, t) }
// A rel block drains every source, so the step is walked by ordinal.
pub deem mj_drained(r: &Runs, s: &Runs, xs: &[Bag]) {
    rel hot(k: i64) {
        from xs q where q.k > 0 select q.k;
    }
    from r x join s y on x.key == y.key select (x.key, x.val, y.val) }

// ── declined: the hash join answers ─────────────────────────────────────────
pub deem hj_val(a: &BTreeMap<i64, i64>, b: &BTreeMap<i64, i64>) {
    from a x join b y on x.val * 10 == y.val select (x.key, x.val, y.val) }
// `order by` the base's order column: the merge already emits that sequence
// (ties base-then-step, the sort's own tiebreak), so the sort is elided
pub deem mj_sorted(r: &Runs, s: &Runs) {
    from r x join s y on x.key == y.key select (x.key, x.val, y.val) order by x.key }
// an anti join and a `left join` merge too: the run equal to the base key is
// empty or not (with a residual: has a passing row or not)
pub deem mj_anti(r: &Runs, s: &Runs) {
    from r x anti join s y on x.key == y.key select (x.key, x.val, 0) }
pub deem mj_anti_resid(r: &Runs, s: &Runs) {
    from r x anti join s y on x.key == y.key && y.val > 8 select (x.key, x.val, 0) }
pub deem mj_left(r: &Runs, s: &Runs) {
    from r x left join s y on x.key == y.key select (x.key, x.val, unwrap_or(y.val, -1)) }
pub deem mj_order(r: &Runs, s: &Runs) {
    from r x join s y on x.key == y.key select (x.key, x.val, y.val) order by y.val }

fn rows_are(v: &Vec<(i64, i64, i64)>, want: &[(i64, i64, i64)]) -> bool {
    if v.len() != want.len() { return false; }
    let mut i: i64 = 0i64;
    while i < v.len() {
        let g: (i64, i64, i64) = v.get(i);
        if g.0 != want[i].0 || g.1 != want[i].1 || g.2 != want[i].2 { return false; }
        i = i + 1i64;
    }
    return true;
}

fn main() -> i32 {
    let mut a: BTreeMap<i64, i64> = btreemap_new::<i64, i64>();
    let mut b: BTreeMap<i64, i64> = btreemap_new::<i64, i64>();
    let ak: [i64; 5] = [5i64, 1i64, 7i64, 2i64, 4i64];
    let bk: [i64; 5] = [9i64, 4i64, 2i64, 7i64, 3i64];
    let mut i: i64 = 0i64;
    while i < 5i64 {
        unsafe {
            (*(&mut a as *mut BTreeMap<i64, i64>)).insert(ak[i], ak[i] * 10i64);
            (*(&mut b as *mut BTreeMap<i64, i64>)).insert(bk[i], bk[i] * 100i64);
        }
        i = i + 1i64;
    }
    let r: Runs = Runs { keys: [2i64, 2i64, 4i64, 4i64, 4i64, 8i64], vals: [1i64, 2i64, 3i64, 4i64, 5i64, 6i64], n: 6i64 };
    let s: Runs = Runs { keys: [2i64, 4i64, 4i64, 6i64, 0i64, 0i64], vals: [7i64, 8i64, 9i64, 0i64, 0i64, 0i64], n: 4i64 };
    let xs: [Bag; 1] = [Bag { k: 1i64 }];

    // a ⋈ b on key: 2, 4, 7.
    let w_ab: [(i64, i64, i64); 3] = [(2i64, 20i64, 200i64), (4i64, 40i64, 400i64), (7i64, 70i64, 700i64)];
    if !rows_are(&mj(&a, &b).unwrap(), &w_ab[..]) { return 1i32; }
    if !rows_are(&mj_flip(&a, &b).unwrap(), &w_ab[..]) { return 2i32; }
    // the residual x.key + y.val > 400: 202 fails, 404 and 707 pass.
    if !rows_are(&mj_resid(&a, &b).unwrap(), &w_ab[1..3]) { return 3i32; }
    let w_where: [(i64, i64, i64); 2] = [(2i64, 20i64, 200i64), (7i64, 70i64, 700i64)];
    if !rows_are(&mj_where(&a, &b).unwrap(), &w_where[..]) { return 4i32; }
    if !rows_are(&mj_limit(&a, &b).unwrap(), &w_ab[0..2]) { return 5i32; }

    // r ⋈ b: base keys repeat — 2,2 meet 200; 4,4,4 meet 400; 8 meets nothing.
    let w_rb: [(i64, i64, i64); 5] = [(2i64, 1i64, 200i64), (2i64, 2i64, 200i64),
        (4i64, 3i64, 400i64), (4i64, 4i64, 400i64), (4i64, 5i64, 400i64)];
    if !rows_are(&mj_base_runs(&r, &b).unwrap(), &w_rb[..]) { return 6i32; }
    // a ⋈ r: step keys repeat — 2 meets 1,2; 4 meets 3,4,5.
    let w_ar: [(i64, i64, i64); 5] = [(2i64, 20i64, 1i64), (2i64, 20i64, 2i64),
        (4i64, 40i64, 3i64), (4i64, 40i64, 4i64), (4i64, 40i64, 5i64)];
    if !rows_are(&mj_step_runs(&a, &r).unwrap(), &w_ar[..]) { return 7i32; }
    // r ⋈ s: both repeat — each r row with 2 meets 7; each r row with 4 meets 8, 9.
    let w_rs: [(i64, i64, i64); 8] = [(2i64, 1i64, 7i64), (2i64, 2i64, 7i64),
        (4i64, 3i64, 8i64), (4i64, 3i64, 9i64), (4i64, 4i64, 8i64), (4i64, 4i64, 9i64),
        (4i64, 5i64, 8i64), (4i64, 5i64, 9i64)];
    if !rows_are(&mj_both_runs(&r, &s).unwrap(), &w_rs[..]) { return 8i32; }
    if !rows_are(&mj_sorted(&r, &s).unwrap(), &w_rs[..]) { return 13i32; }
    // r: 2→1 2→2 4→3 4→4 4→5 8→6;  s: 2→7 4→8 4→9 6→0
    let w_anti: [(i64, i64, i64); 1] = [(8i64, 6i64, 0i64)];
    if !rows_are(&mj_anti(&r, &s).unwrap(), &w_anti[..]) { return 14i32; }
    let w_ar: [(i64, i64, i64); 3] = [(2i64, 1i64, 0i64), (2i64, 2i64, 0i64), (8i64, 6i64, 0i64)];
    if !rows_are(&mj_anti_resid(&r, &s).unwrap(), &w_ar[..]) { return 15i32; }
    let w_left: [(i64, i64, i64); 9] = [(2i64, 1i64, 7i64), (2i64, 2i64, 7i64),
        (4i64, 3i64, 8i64), (4i64, 3i64, 9i64), (4i64, 4i64, 8i64), (4i64, 4i64, 9i64),
        (4i64, 5i64, 8i64), (4i64, 5i64, 9i64), (8i64, 6i64, -1i64)];
    if !rows_are(&mj_left(&r, &s).unwrap(), &w_left[..]) { return 16i32; }
    if !rows_are(&mj_drained(&r, &s, &xs[..]).unwrap(), &w_rs[..]) { return 9i32; }
    // grouped: key 2 → 2 rows, sum 14; key 4 → 6 rows, sum 3·(8+9) = 51.
    let w_g: [(i64, i64, i64); 2] = [(2i64, 2i64, 14i64), (4i64, 6i64, 51i64)];
    if !rows_are(&mj_group(&r, &s).unwrap(), &w_g[..]) { return 10i32; }

    // declined twins
    if !rows_are(&hj_val(&a, &b).unwrap(), &w_ab[..]) { return 11i32; }
    let w_o: [(i64, i64, i64); 8] = [(2i64, 1i64, 7i64), (2i64, 2i64, 7i64),
        (4i64, 3i64, 8i64), (4i64, 4i64, 8i64), (4i64, 5i64, 8i64),
        (4i64, 3i64, 9i64), (4i64, 4i64, 9i64), (4i64, 5i64, 9i64)];
    if !rows_are(&mj_order(&r, &s).unwrap(), &w_o[..]) { return 12i32; }
    return 0i32;
}
