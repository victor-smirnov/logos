package deref_swap;
// swap two variables via *mut pointers — tests deref-write + &mut
fn swap(a: *mut i32, b: *mut i32) {
    let tmp: i32 = *a;
    *a = *b;
    *b = tmp;
}
fn main() -> i32 {
    let mut x: i32 = 10;
    let mut y: i32 = 32;
    swap(&mut x, &mut y);
    return x + y;  // 32+10 = 42
}
