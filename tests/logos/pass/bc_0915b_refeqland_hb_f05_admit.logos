package bc_0915b_refeqland_hb_f05_admit;
use logos.lang.cmp;
struct D { v: i64 }
impl Eq for D {
    fn eq(&self, other: &D) -> bool {
        return self.v == other.v;
    }
}
fn tick<'a>(s: *mut i64, k: i64, d: &'a D) -> &'a D {
    unsafe { *s = *s * 10i64 + k; }
    return d;
}
fn main() -> i32 {
    let a: D = D { v: 4i64 };
    let b: D = D { v: 4i64 };
    let mut seq: i64 = 0i64;
    let sp: *mut i64 = &mut seq;
    let same: bool = tick(sp, 1i64, &a) == tick(sp, 2i64, &b);
    if !same { return 1i32; }
    let got: i64 = unsafe { *sp };
    if got != 12i64 { return 2i32; }
    return 0i32;
}
