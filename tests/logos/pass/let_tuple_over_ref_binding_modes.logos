// `let (…) = &t` / `&mut t`: element binders are references (writes, nested tuples, a droppable
// element not dropped by the binding, `_`). rustc 1.98.1 prints the same line.
package let_tuple_over_ref_binding_modes;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn main() -> i32 {
    let mut t: (i64, i64) = (1i64, 2i64);
    { let (a, b) = &mut t; *a = *a + 10i64; *b = 20i64; }
    let n: ((i64, i64), i64) = ((3i64, 4i64), 5i64);
    let ((x, y), z) = &n;
    let mut k: i64 = 0i64;
    {
        let d: (D, i64) = (D { v: 7i64, c: &mut k }, 8i64);
        let (dd, e) = &d;
        let (_, f) = &d;
        let _ = dd.v + *e + *f;
    }
    unsafe { printf("%lld %lld %lld %lld %lld %lld\n".as_ptr(), t.0, t.1, *x, *y, *z, k); }
    return 0i32;
}
