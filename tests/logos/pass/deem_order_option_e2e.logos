// `order by` an outer join's optional column: the key is an `Option<T>` and
// orders as Rust's `Option` — `None` before every `Some`, two `Some`s by the
// payload (an f64 payload by its data key). `desc` reverses it, so `None`
// lands last; ties keep the row-index tiebreak in both directions.
// Rows: hand-derived from the data below.
//   es: 1→10 2→20 3→30 4→20      ds: 10→(floor 5, w -1.5) 20→(floor 2, w 0.5)
//   e3 matches nothing (None); e2 and e4 tie on every key.
package test;
use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.result;
use logos.lang.option;
use logos.std.fmt;
struct Emp { pub id: i64, pub dept: i64 }
struct Dept { pub id: i64, pub floor: i64, pub w: f64 }
pub deem by_floor(es: &[Emp], ds: &[Dept]) {
    from es e left join ds d on d.id == e.dept select e.id order by d.floor }
pub deem by_floor_desc(es: &[Emp], ds: &[Dept]) {
    from es e left join ds d on d.id == e.dept select e.id order by d.floor desc }
pub deem by_w(es: &[Emp], ds: &[Dept]) {
    from es e left join ds d on d.id == e.dept select e.id order by d.w }
pub deem by_w_desc(es: &[Emp], ds: &[Dept]) {
    from es e left join ds d on d.id == e.dept select e.id order by d.w desc }
fn show(tag: str, r: &Vec<i64>) {
    print!("{}", tag);
    let mut i: i64 = 0i64;
    while i < r.len() { print!(" {}", r.get(i)); i = i + 1i64; }
    println!("");
}
fn main() -> i32 {
    let es: [Emp; 4] = [ Emp { id: 1, dept: 10 }, Emp { id: 2, dept: 20 }, Emp { id: 3, dept: 30 }, Emp { id: 4, dept: 20 } ];
    let ds: [Dept; 2] = [ Dept { id: 10, floor: 5, w: -1.5 }, Dept { id: 20, floor: 2, w: 0.5 } ];
    show("floor", &by_floor(&es[..], &ds[..]).unwrap());
    show("floor desc", &by_floor_desc(&es[..], &ds[..]).unwrap());
    show("w", &by_w(&es[..], &ds[..]).unwrap());
    show("w desc", &by_w_desc(&es[..], &ds[..]).unwrap());
    return 0i32;
}
