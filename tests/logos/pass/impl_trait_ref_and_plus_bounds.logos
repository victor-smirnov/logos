// `&impl Trait` / `&mut impl Trait` parameters and `impl A + B` / `impl Tr + 'a` bounds (grammar: ref_pointee takes
// impl_type; the bounds after the first ride in SUPERS). Output as rustc 1.98.1.
package impl_trait_ref_and_plus_bounds;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.string;
trait Visit { fn hit(&mut self) -> i64; fn peek(&self) -> i64; }
struct C(i64);
impl Visit for C { fn hit(&mut self) -> i64 { self.0 += 1; self.0 } fn peek(&self) -> i64 { self.0 } }
fn bump(v: &mut impl Visit) -> i64 { v.hit() }
fn look(v: &impl Visit) -> i64 { v.peek() }
fn both(x: impl Debug + Clone) -> String { format!("{:?}", x.clone()) }
fn evens<'a>(v: &'a Vec<i64>) -> impl Iterator<Item = &'a i64> + 'a { v.iter().filter(|x| **x % 2 == 0) }
fn main() {
    let mut c = C(1);
    println!("{} {} {}", bump(&mut c), look(&c), both(7i64));
    let v = vec![1i64, 2, 3, 4];
    let s: i64 = evens(&v).sum();
    println!("{}", s);
}
