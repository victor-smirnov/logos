package impl_generic_enum;
// impl<T> on generic enum — methods on GOpt<T>-style enums.
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }

enum GOpt<T> { Some(T), None }

impl<T> GOpt<T> {
    fn unwrap_or(self: GOpt<T>, def: T) -> T {
        match self {
            GOpt::Some(v) => { return v; }
            GOpt::None    => { return def; }
        }
    }
    fn is_some(self: GOpt<T>) -> bool {
        match self {
            GOpt::Some(_) => { return true; }
            GOpt::None    => { return false; }
        }
    }
}

unsafe fn main() -> i32 {
    let a: GOpt<i32> = GOpt::Some(42);
    let b: GOpt<i32> = GOpt::None;
    printi("%d\n", a.unwrap_or(0));    // 42
    printi("%d\n", b.unwrap_or(99));   // 99
    return 0;
}
