package impl_generic_enum;
// impl<T> on generic enum — methods on Option<T>-style enums.
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }

enum Option<T> { Some(T), None }

impl<T> Option<T> {
    fn unwrap_or(self: Option<T>, def: T) -> T {
        match self {
            Option::Some(v) => { return v; }
            Option::None    => { return def; }
        }
    }
    fn is_some(self: Option<T>) -> bool {
        match self {
            Option::Some(_) => { return true; }
            Option::None    => { return false; }
        }
    }
}

unsafe fn main() -> i32 {
    let a: Option<i32> = Option::Some(42);
    let b: Option<i32> = Option::None;
    printi("%d\n", a.unwrap_or(0));    // 42
    printi("%d\n", b.unwrap_or(99));   // 99
    return 0;
}
