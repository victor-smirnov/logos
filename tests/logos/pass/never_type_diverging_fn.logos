package never_type_diverging_fn;

fn always_fail() -> ! { loop { } }

fn checked(n: i64) -> i64 {
    // a `-> !` call coerces to the expected type in value position
    let v: i64 = if n < 0i64 { always_fail() } else { n };
    return v;
}

fn main() -> i32 {
    if checked(7i64) != 7i64 { return 1i32; }
    return 0i32;
}
