// ssrle_index — SSRLE increment-5 gate: the flat size/sum index + reindex.
//
// C++ oracle map: packed_ssrle_seq.hpp (AtomsPerBlock threshold, index
// sizing), ssrleseq_reindex_fn.hpp (the reindex walk), and the indexed
// branches of access/rank_fn/select_fw_fn in packed_ssrle_seq_so.hpp. The
// C++ Misc/Rank/Select suites drive 32768-run corpora through the indexed
// paths; this gate does the same three-way:
//
//   INDEXED packed queries ↔ the increment-2 vector algebra (== the scan
//   paths, proven against the packed scan in the increment-4 gate) ↔ the
//   naive materialized oracle (exhaustively, on threshold-scale corpora).
//
// Sections (error-code decades):
//   10..19  index existence/threshold laws + index cell laws
//           (Σ size cells = size; Σ sum column = total rank; block count =
//           the pricing function)
//   20..29  boundary + sampled rank/access parity vs the vector algebra
//           (block boundaries ±1 are the off-by-one sites)
//   30..39  boundary + sampled select parity + inverse laws
//   40..49  exhaustive three-way on a just-past-threshold corpus
//   50..59  reindex(): stream preserved, queries unchanged, index rebuilt
//   60..69  32768-run corpora (the C++ suite scale), sampled parity
//   70..79  OOM on an under-provisioned indexed-scale block: clean Err,
//           sequence left valid-empty
package test;

use logos.mem.pkd.ssrle;
use logos.mem.pkd.sseq;
use logos.mem.pkd;
use logos.lang.arith;
use logos.lang.mem;
use logos.lang.result;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.std.io;

// ── deterministic corpus (LCG via wrapping arithmetic) ──────────────────────

fn rnd(st: &mut u64) -> u64 {
    let next: u64 = wrapping_add(wrapping_mul(*st, 6364136223846793005u64), 1442695040888963407u64);
    *st = next;
    return next >> 33u64;
}

fn rnd_pattern(st: &mut u64) -> u64 {
    return (rnd(st) << 31u64) | rnd(st);
}

fn rand_run(bps: u32, st: &mut u64, rl_cap: u64) -> SsrleRun {
    let cap: u64 = ssrle_encodable_pattern_length(bps) as u64;
    let plen: u64 = 1u64 + rnd(st) % cap;
    let mut mrl: u64 = ssrle_max_run_length(bps, plen as u32);
    if mrl > rl_cap {
        mrl = rl_cap;
    }
    let rl: u64 = 1u64 + rnd(st) % mrl;
    return ssrle_run_new(bps, plen as u32, rnd_pattern(st), rl);
}

// Grow a corpus until its encoded stream passes `min_units` code units.
fn runs_until_units(bps: u32, st: &mut u64, min_units: u64, rl_cap: u64) -> Vec<SsrleRun> {
    let mut v: Vec<SsrleRun> = vec_new::<SsrleRun>();
    let mut going: bool = true;
    while going {
        v.push(rand_run(bps, st, rl_cap));
        if ssrle_compute_size(bps, &v, 0u64) > min_units {
            going = false;
        }
    }
    return v;
}

fn rand_runs(bps: u32, st: &mut u64, n: i64, rl_cap: u64) -> Vec<SsrleRun> {
    let mut v: Vec<SsrleRun> = vec_new::<SsrleRun>();
    let mut i: i64 = 0i64;
    while i < n {
        v.push(rand_run(bps, st, rl_cap));
        i = i + 1i64;
    }
    return v;
}

// ── oracles over the RUN VECTOR (index-free by construction) ────────────────

// access oracle: find_run + per-run symbol
fn oracle_access(bps: u32, runs: &Vec<SsrleRun>, pos: u64) -> u64 {
    let res: SsrleFindRun = ssrle_find_run(runs, pos);
    let run: &SsrleRun = runs.borrow(res.run_idx);
    return run.symbol(bps, res.local_offset);
}

// ── the per-corpus check ────────────────────────────────────────────────────

// Verify one packed sequence against the vector algebra at `pos` for `sym`.
fn rank_parity(seq: &PkdSsrle, runs: &Vec<SsrleRun>, pos: u64, sym: u64) -> bool {
    return seq.rank_eq(pos, sym) == ssrle_rank_eq(seq.bps(), runs, pos, sym);
}

fn select_parity(seq: &PkdSsrle, runs: &Vec<SsrleRun>, rank: u64, sym: u64) -> bool {
    let got: SsrleSelect = seq.select_fw_eq(rank, sym);
    return got.idx == ssrle_select_fw_eq(seq.bps(), runs, rank, sym);
}

fn test_symbols(bps: u32, st: &mut u64) -> Vec<u64> {
    let alpha: u64 = 1u64 << (bps as u64);
    let mut syms: Vec<u64> = vec_new::<u64>();
    if bps <= 2u32 {
        let mut s: u64 = 0u64;
        while s < alpha {
            syms.push(s);
            s = s + 1u64;
        }
    } else {
        syms.push(0u64);
        syms.push(alpha - 1u64);
        syms.push(rnd(st) % alpha);
        syms.push(rnd(st) % alpha);
    }
    return syms;
}

// Boundary sampling stride: every boundary for small indexes, ~12 sampled
// boundaries for deep ones (the oracle is O(runs) per query — keep the 32768-
// run corpora affordable while still hitting off-by-one sites).
fn boundary_stride(blocks: u64) -> u64 {
    return blocks / 12u64 + 1u64;
}

// Positions worth probing: 0, 1, mid, size−1, size, sampled index-block
// boundaries ±1 (the off-by-one sites), and `extra` random ones.
fn probe_positions(seq: &PkdSsrle, st: &mut u64, extra: i64) -> Vec<u64> {
    let size: u64 = seq.size();
    let mut pos: Vec<u64> = vec_new::<u64>();
    pos.push(0u64);
    pos.push(size);
    if size > 0u64 {
        pos.push(1u64);
        pos.push(size / 2u64);
        pos.push(size - 1u64);
    }
    let blocks: u64 = seq.index_blocks();
    let stride: u64 = boundary_stride(blocks);
    let mut prefix: u64 = 0u64;
    let mut b: u64 = 0u64;
    while b < blocks {
        prefix = prefix + seq.index_size_at(b);
        if (b % stride == 0u64) || b + 1u64 == blocks {
            if prefix > 0u64 && prefix - 1u64 <= size {
                pos.push(prefix - 1u64);
            }
            if prefix <= size {
                pos.push(prefix);
            }
            if prefix + 1u64 <= size {
                pos.push(prefix + 1u64);
            }
        }
        b = b + 1u64;
    }
    let mut i: i64 = 0i64;
    while i < extra {
        pos.push(rnd(st) % (size + 1u64));
        i = i + 1i64;
    }
    return pos;
}

fn check_corpus_body(seq: &PkdSsrle, bps: u32, runs: &Vec<SsrleRun>, st: &mut u64, extra: i64) -> i32 {
    let size: u64 = ssrle_count_symbols(runs);
    let nunits: u64 = ssrle_compute_size(bps, runs, 0u64);
    let apb: u64 = ssrle_atoms_per_block(bps);
    // 10.. index existence + cell laws
    if seq.size() != size {
        return 10i32;
    }
    if seq.needs_index() != (nunits > apb) {
        return 11i32;
    }
    if seq.has_index() != seq.needs_index() {
        return 12i32;
    }
    if seq.index_blocks() != pkd_ssrle_index_blocks(bps, nunits) {
        return 13i32;
    }
    let blocks: u64 = seq.index_blocks();
    let mut size_total: u64 = 0u64;
    let mut b: u64 = 0u64;
    while b < blocks {
        size_total = size_total + seq.index_size_at(b);
        b = b + 1u64;
    }
    if seq.has_index() && size_total != size {
        return 14i32;
    }
    let syms: Vec<u64> = test_symbols(bps, st);
    if seq.has_index() {
        let mut si: i64 = 0i64;
        while si < syms.length() {
            let sym: u64 = syms.get(si);
            let mut col: u64 = 0u64;
            b = 0u64;
            while b < blocks {
                col = col + seq.index_sum_at(b, sym);
                b = b + 1u64;
            }
            if col != ssrle_rank_eq(bps, runs, size, sym) {
                return 15i32;
            }
            si = si + 1i64;
        }
    }
    // 20.. rank + access parity at boundary/sampled positions
    let positions: Vec<u64> = probe_positions(seq, st, extra);
    let mut pi: i64 = 0i64;
    while pi < positions.length() {
        let p: u64 = positions.get(pi);
        if p < size {
            if seq.access(p) != oracle_access(bps, runs, p) {
                return 20i32;
            }
        }
        let mut si: i64 = 0i64;
        while si < syms.length() {
            if !rank_parity(seq, runs, p, syms.get(si)) {
                return 21i32;
            }
            si = si + 1i64;
        }
        pi = pi + 1i64;
    }
    // 30.. select parity: boundary ranks (rank prefix at each block edge ±1),
    // sampled ranks, not-found law, inverse laws
    let mut si: i64 = 0i64;
    while si < syms.length() {
        let sym: u64 = syms.get(si);
        let total: u64 = ssrle_rank_eq(bps, runs, size, sym);
        let mut ranks: Vec<u64> = vec_new::<u64>();
        ranks.push(0u64);
        if total > 0u64 {
            ranks.push(total / 2u64);
            ranks.push(total - 1u64);
        }
        let stride: u64 = boundary_stride(blocks);
        let mut prefix: u64 = 0u64;
        b = 0u64;
        while b < blocks {
            prefix = prefix + seq.index_sum_at(b, sym);
            if (b % stride == 0u64) || b + 1u64 == blocks {
                if prefix > 0u64 {
                    ranks.push(prefix - 1u64);
                }
                ranks.push(prefix);
                ranks.push(prefix + 1u64);
            }
            b = b + 1u64;
        }
        let mut i: i64 = 0i64;
        while i < extra {
            ranks.push(rnd(st) % (total + 2u64));
            i = i + 1i64;
        }
        let mut ri: i64 = 0i64;
        while ri < ranks.length() {
            let r: u64 = ranks.get(ri);
            if !select_parity(seq, runs, r, sym) {
                return 30i32;
            }
            if r < total {
                let got: SsrleSelect = seq.select_fw_eq(r, sym);
                if seq.access(got.idx) != sym {
                    return 31i32;
                }
                if seq.rank_eq(got.idx, sym) != r {
                    return 32i32;
                }
            }
            ri = ri + 1i64;
        }
        // beyond-total: {size, total}
        let nf: SsrleSelect = seq.select_fw_eq(total + 3u64, sym);
        if nf.idx != size || nf.rank != total {
            return 33i32;
        }
        si = si + 1i64;
    }
    return 0i32;
}

fn check_corpus(bps: u32, runs: &Vec<SsrleRun>, st: &mut u64, extra: i64) -> i32 {
    let alphabet: u32 = 1u32 << bps;
    let nunits: u64 = ssrle_compute_size(bps, runs, 0u64);
    let block_size: u32 = pkd_ssrle_block_size(alphabet, nunits);
    unsafe {
        let mem: *mut u8 = alloc(block_size as i64);
        let mut seq: PkdSsrle = match pkd_ssrle_create(mem, block_size, alphabet, runs) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 9i32;
            }
        };
        let mut rc: i32 = check_corpus_body(&seq, bps, runs, st, extra);
        // 50.. reindex(): compactify may refactor runs, the SYMBOL stream and
        // every query answer must survive; the old run vector stays a valid
        // oracle (same stream).
        if rc == 0i32 {
            rc = match seq.reindex() {
                Result::Ok(_) => { 0i32 }
                Result::Err(_) => { 50i32 }
            };
        }
        if rc == 0i32 && seq.size() != ssrle_count_symbols(runs) {
            rc = 51i32;
        }
        if rc == 0i32 && seq.has_index() != seq.needs_index() {
            rc = 52i32;
        }
        if rc == 0i32 {
            // Re-derive the oracle from the compacted stream (same symbols,
            // possibly fewer runs/units — the original nunits no longer
            // describes the slot).
            let runs2: Vec<SsrleRun> = seq.as_runs();
            // stream preservation, checked in full at affordable sizes
            if ssrle_count_symbols(runs) <= 20000u64 {
                let before: Vec<u64> = ssrle_materialize(bps, runs);
                let after: Vec<u64> = ssrle_materialize(bps, &runs2);
                if before.length() != after.length() {
                    rc = 54i32;
                }
                let mut i: i64 = 0i64;
                while rc == 0i32 && i < before.length() {
                    if before.get(i) != after.get(i) {
                        rc = 55i32;
                    }
                    i = i + 1i64;
                }
            }
            if rc == 0i32 {
                let rc2: i32 = check_corpus_body(&seq, bps, &runs2, st, extra);
                if rc2 != 0i32 {
                    rc = 53i32;
                }
            }
        }
        dealloc(mem);
        return rc;
    }
}

// ── 40..: exhaustive three-way on a just-past-threshold corpus ──────────────

fn check_exhaustive(bps: u32, st: &mut u64) -> i32 {
    let alphabet: u32 = 1u32 << bps;
    let apb: u64 = ssrle_atoms_per_block(bps);
    let runs: Vec<SsrleRun> = runs_until_units(bps, st, apb, 4u64);
    let stream: Vec<u64> = ssrle_materialize(bps, &runs);
    let size: u64 = stream.length() as u64;
    let nunits: u64 = ssrle_compute_size(bps, &runs, 0u64);
    let block_size: u32 = pkd_ssrle_block_size(alphabet, nunits);
    unsafe {
        let mem: *mut u8 = alloc(block_size as i64);
        let seq: PkdSsrle = match pkd_ssrle_create(mem, block_size, alphabet, &runs) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 40i32;
            }
        };
        let rc: i32 = check_exhaustive_body(&seq, bps, &runs, &stream, size, st);
        dealloc(mem);
        return rc;
    }
}

fn check_exhaustive_body(seq: &PkdSsrle, bps: u32, runs: &Vec<SsrleRun>, stream: &Vec<u64>, size: u64, st: &mut u64) -> i32 {
    if !seq.has_index() {
        return 41i32;
    }
    // exhaustive access vs the materialized stream
    let mut p: u64 = 0u64;
    while p < size {
        if seq.access(p) != stream.get(p as i64) {
            return 42i32;
        }
        p = p + 1u64;
    }
    // exhaustive rank + on-occurrence select for the probe symbols
    let syms: Vec<u64> = test_symbols(bps, st);
    let mut si: i64 = 0i64;
    while si < syms.length() {
        let sym: u64 = syms.get(si);
        let mut naive: u64 = 0u64;
        p = 0u64;
        while p <= size {
            if seq.rank_eq(p, sym) != naive {
                return 43i32;
            }
            if p < size && stream.get(p as i64) == sym {
                let got: SsrleSelect = seq.select_fw_eq(naive, sym);
                if got.idx != p {
                    return 44i32;
                }
                naive = naive + 1u64;
            }
            p = p + 1u64;
        }
        // the vector algebra agrees on the totals (three-way closure)
        if naive != ssrle_rank_eq(bps, runs, size, sym) {
            return 45i32;
        }
        let nf: SsrleSelect = seq.select_fw_eq(naive, sym);
        if nf.idx != size || nf.rank != naive {
            return 46i32;
        }
        si = si + 1i64;
    }
    return 0i32;
}

// ── 70..: OOM at indexed scale leaves a valid empty sequence ────────────────

fn check_oom_indexed() -> i32 {
    let bps: u32 = 2u32;
    let alphabet: u32 = 4u32;
    let mut st: u64 = 0xacedu64;
    let apb: u64 = ssrle_atoms_per_block(bps);
    let runs: Vec<SsrleRun> = runs_until_units(bps, &mut st, apb * 2u64, 8u64);
    let nunits: u64 = ssrle_compute_size(bps, &runs, 0u64);
    // room for the stream but NOT for the index slots
    let block_size: u32 = pkd_ssrle_empty_size() + round_up_bytes((nunits * 2u64) as u32);
    unsafe {
        let mem: *mut u8 = alloc(block_size as i64);
        let mut rc: i32 = 0i32;
        let seq: PkdSsrle = match pkd_ssrle_format(mem, block_size, alphabet) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 70i32;
            }
        };
        let mut seq2: PkdSsrle = seq;
        match seq2.set_runs(&runs) {
            Result::Ok(_) => {
                rc = 71i32;
            }
            Result::Err(_) => {}
        }
        // the reset-to-empty contract: still a valid, queryable sequence
        if rc == 0i32 && (seq2.size() != 0u64 || seq2.code_units() != 0u64) {
            rc = 72i32;
        }
        if rc == 0i32 && seq2.has_index() {
            rc = 73i32;
        }
        if rc == 0i32 && seq2.rank_eq(0u64, 1u64) != 0u64 {
            rc = 74i32;
        }
        dealloc(mem);
        return rc;
    }
}

// ── main ────────────────────────────────────────────────────────────────────

fn run_all() -> i32 {
    let mut st: u64 = 0x1dec5eed1dec5eedu64;
    let mut bps: u32 = 1u32;
    while bps <= 8u32 {
        let apb: u64 = ssrle_atoms_per_block(bps);
        // below threshold (scan regime intact)
        let small: Vec<SsrleRun> = rand_runs(bps, &mut st, 8i64, 6u64);
        let rc1: i32 = check_corpus(bps, &small, &mut st, 8i64);
        if rc1 != 0i32 {
            return rc1;
        }
        // just past the threshold
        let edge: Vec<SsrleRun> = runs_until_units(bps, &mut st, apb, 6u64);
        let rc2: i32 = check_corpus(bps, &edge, &mut st, 24i64);
        if rc2 != 0i32 {
            return rc2 + 1000i32;
        }
        // several blocks deep
        let mid: Vec<SsrleRun> = runs_until_units(bps, &mut st, apb * 5u64, 20u64);
        let rc3: i32 = check_corpus(bps, &mid, &mut st, 24i64);
        if rc3 != 0i32 {
            return rc3 + 2000i32;
        }
        // the exhaustive three-way
        let rc4: i32 = check_exhaustive(bps, &mut st);
        if rc4 != 0i32 {
            return rc4 + 3000i32;
        }
        bps = bps + 1u32;
    }
    // the C++ suite scale: 32768-run corpora, sampled parity (two Bps rows
    // keep the runtime sane; the mechanism is Bps-uniform)
    let big2: Vec<SsrleRun> = rand_runs(2u32, &mut st, 32768i64, 10000u64);
    let rcb2: i32 = check_corpus(2u32, &big2, &mut st, 32i64);
    if rcb2 != 0i32 {
        return rcb2 + 4000i32;
    }
    let big8: Vec<SsrleRun> = rand_runs(8u32, &mut st, 32768i64, 10000u64);
    let rcb8: i32 = check_corpus(8u32, &big8, &mut st, 32i64);
    if rcb8 != 0i32 {
        return rcb8 + 5000i32;
    }
    let rco: i32 = check_oom_indexed();
    if rco != 0i32 {
        return rco + 6000i32;
    }
    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap (256 & 0xFF == 0) and report
// SUCCESS. The status is a fixed non-zero byte; the code carries the detail.
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL ssrle_index: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
