package no_auto_drop_container_ctl;
use logos.mem.manually_drop;
extern fn printf(fmt: *const u8, ...) -> i32;
extern fn fflush(f: *mut u8) -> i32;
extern fn malloc(n: u64) -> *mut u8;
extern fn free(p: *mut u8);
fn pr(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); fflush(0 as *mut u8); } }
fn ps(s: str) { unsafe { printf(s.as_ptr()); fflush(0 as *mut u8); } }

trait Drop { fn drop(self: Self); }

/// CONTROL TWIN of `no_auto_drop_container` — THE ADMIT SIDE.
///
/// Byte-for-byte the same twenty-five storage sites with `#[no_auto_drop]`
/// REMOVED and the hand `rel()` reclaim removed with it. Every one of the
/// twenty-nine values is now the COMPILER's to destroy, and the transcript
/// demands exactly one `D<n>` per `M<n>` — no `R`, none missing, none doubled.
///
/// This is the half a suppression fix cannot fake. #123's own fixture family
/// asserts that certain destructors DO NOT run; on its own that is satisfied
/// by a compiler that stopped emitting drop glue at all. The pair fixes the
/// meaning of the attribute to the attribute: identical programs, one token
/// apart, opposite and complete drop behaviour.
///
/// `NADD` here keeps its user `impl Drop` and, with the attribute gone, prints
/// `U` (the user destructor) AND `D<n>` (the field glue for its `Pay`) — the
/// two halves `item.struct.no-auto-drop` suppresses together.
struct Pay { n: i64, b: *mut u8 }
impl Drop for Pay { fn drop(self: Pay) { pr("D%ld ", self.n); unsafe { free(self.b); } } }
fn mk(n: i64) -> Pay { pr("M%ld ", n); unsafe { return Pay { n: n, b: malloc(64u64) }; } }

struct NAD { p: Pay }

/// The admit side of the user-drop half: `U` prints on every NADD value.
struct NADD { p: Pay }
impl Drop for NADD { fn drop(self: NADD) { ps("U "); } }

struct Sib  { n: NAD, real: Pay }     // suppressed field beside a droppable one
struct Wrap { n: NAD }
enum E { A(NAD), B }

fn eat(n: NAD) { pr("e%ld ", n.p.n); }
fn sink<T>(t: T) { ps("s "); }
fn gen_ret<T>(t: T) -> T { return t; }
fn eat_nadd(n: NADD) { pr("f%ld ", n.p.n); }

// ── every storage site, attribute ABSENT ────────────────────────────────
fn c_local()    { let a: Pay = mk(1i64); let x: NAD = NAD { p: a }; pr("a%ld ", x.p.n); }
fn c_sibling()  { let a: Pay = mk(2i64); let s: Sib = Sib { n: NAD { p: a }, real: mk(3i64) };
                  pr("b%ld ", s.real.n); }
fn c_vec()      { let a: Pay = mk(4i64); let c: Pay = mk(5i64); let mut v: Vec<NAD> = Vec::new();
                  v.push(NAD { p: a }); v.push(NAD { p: c });
                  pr("c%ld ", v.len() as i64); }
fn c_box()      { let a: Pay = mk(6i64); let x: Box<NAD> = Box::new(NAD { p: a }); pr("d%ld ", x.p.n); }
fn c_generic()  { let a: Pay = mk(7i64);                   sink::<NAD>(NAD { p: a }); }
fn c_genret()   { let a: Pay = mk(8i64); let x: NAD = gen_ret::<NAD>(NAD { p: a }); pr("g%ld ", x.p.n); }
fn c_nestvec()  { let a: Pay = mk(9i64); let mut i: Vec<NAD> = Vec::new(); i.push(NAD { p: a });
 let mut o: Vec<Vec<NAD>> = Vec::new(); o.push(i);
                  pr("h%ld ", o.len() as i64); }
fn c_rc()       { let a: Pay = mk(10i64); let r: Rc<NAD> = rc_new::<NAD>(NAD { p: a }); pr("i%ld ", r.p.n); }
fn c_enumvec()  { let a: Pay = mk(11i64); let mut v: Vec<E> = Vec::new(); v.push(E::A(NAD { p: a }));
                  pr("j%ld ", v.len() as i64); }
fn c_array()    { let a: Pay = mk(12i64); let c: Pay = mk(13i64); let x: [NAD; 2] = [NAD { p: a }, NAD { p: c }]; pr("k%ld ", x[0].p.n); }
fn c_tuple()    { let a: Pay = mk(14i64); let t: (NAD, i64) = (NAD { p: a }, 1i64); pr("l%ld ", t.1); }
fn c_wrapvec()  { let a: Pay = mk(15i64); let mut v: Vec<Wrap> = Vec::new(); v.push(Wrap { n: NAD { p: a } });
                  pr("m%ld ", v.len() as i64); }
fn c_param()    { let a: Pay = mk(16i64);                   eat(NAD { p: a }); }

// ── the user-drop half: `U` MUST print, once per value ───────────────────
fn c_ud_local() { let a: Pay = mk(17i64); let x: NADD = NADD { p: a }; pr("n%ld ", x.p.n); }
fn c_ud_vec()   { let a: Pay = mk(18i64); let mut v: Vec<NADD> = Vec::new(); v.push(NADD { p: a });
                  pr("o%ld ", v.len() as i64); }
fn c_ud_param() { let a: Pay = mk(19i64);                   eat_nadd(NADD { p: a }); }
fn c_ud_clos()  { let a: Pay = mk(20i64); let x: NADD = NADD { p: a };
 let f = move || -> i64 { return x.p.n; }; pr("p%ld ", f()); }

// ── the lang item, unwrapped (plain Pay in each container) ───────────────
// ⚠ `ManuallyDrop` is STDLIB: its attribute cannot be removed for a control,
//    so these three cells hold a BARE `Pay` in the same three containers. The
//    genuine wrapper is exercised by `md_inner` below, whose `into_inner`
//    hands the value back and is correct on BOTH sides of the pair.
fn c_md_local() { let a: Pay = mk(21i64); pr("q%ld ", a.n); }
fn c_md_vec()   { let mut v: Vec<Pay> = Vec::new(); v.push(mk(22i64)); pr("r%ld ", v.len() as i64); }
fn c_md_box()   { let x: Box<Pay> = Box::new(mk(23i64)); pr("t%ld ", x.n); }

// ── THE OTHER DIRECTION. Not suppressed: exactly one `D` each, and if the
//    suppression over-reaches these turn into `definitely lost`.
fn c_plain()    { let a: Pay = mk(24i64); pr("u%ld ", a.n); }
fn c_plainvec() { let mut v: Vec<Pay> = Vec::new(); v.push(mk(25i64)); v.push(mk(26i64));
                  pr("v%ld ", v.len() as i64); }
fn c_plainbox() { let x: Box<Pay> = Box::new(mk(27i64)); pr("w%ld ", x.n); }
fn c_md_inner() { let m: ManuallyDrop<Pay> = manually_drop_new::<Pay>(mk(28i64));
 let p: Pay = manually_drop_into_inner::<Pay>(m); pr("x%ld ", p.n); }
fn c_plaingen() { sink::<Pay>(mk(29i64)); }

unsafe fn main() -> i32 {
    ps("local    "); c_local();    ps("\n");
    ps("sibling  "); c_sibling();  ps("\n");
    ps("vec      "); c_vec();      ps("\n");
    ps("box      "); c_box();      ps("\n");
    ps("generic  "); c_generic();  ps("\n");
    ps("genret   "); c_genret();   ps("\n");
    ps("nestvec  "); c_nestvec();  ps("\n");
    ps("rc       "); c_rc();       ps("\n");
    ps("enumvec  "); c_enumvec();  ps("\n");
    ps("array    "); c_array();    ps("\n");
    ps("tuple    "); c_tuple();    ps("\n");
    ps("wrapvec  "); c_wrapvec();  ps("\n");
    ps("param    "); c_param();    ps("\n");
    ps("ud_local "); c_ud_local(); ps("\n");
    ps("ud_vec   "); c_ud_vec();   ps("\n");
    ps("ud_param "); c_ud_param(); ps("\n");
    ps("ud_clos  "); c_ud_clos();  ps("\n");
    ps("md_local "); c_md_local(); ps("\n");
    ps("md_vec   "); c_md_vec();   ps("\n");
    ps("md_box   "); c_md_box();   ps("\n");
    ps("plain    "); c_plain();    ps("\n");
    ps("plainvec "); c_plainvec(); ps("\n");
    ps("plainbox "); c_plainbox(); ps("\n");
    ps("md_inner "); c_md_inner(); ps("\n");
    ps("plaingen "); c_plaingen(); ps("\n");
    return 0;
}
