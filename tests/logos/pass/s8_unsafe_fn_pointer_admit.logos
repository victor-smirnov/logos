package s8_unsafe_fn_pointer_admit;
// ADR 0030 S8 row 1 (E0133 judged on the call, once): `unsafe fn` pointers called in `unsafe`; a SAFE fn coerces to an `unsafe fn` pointer.
unsafe fn f() -> i32 { return 7; }
fn g() -> i32 { return 5; }
fn main() -> i32 { let p: unsafe fn() -> i32 = f; let q: unsafe fn() -> i32 = g; return unsafe { p() + q() } - 12; }
