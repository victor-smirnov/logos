// DEEM HAS THREE ENGINES, AND THE THIRD ONE FOLDED f64 THROUGH `as i64`.
//
// `deem!` (static, compiled fold), `Query::run` (dynamic interpreter) and
// `Query::incremental` (DBSP maintenance) must answer the same question the same
// way. This file asks all three the SAME four aggregates over the SAME f64
// column and compares them against constants DERIVED BY HAND, every one of them
// exact in binary f64 — so a disagreement names an engine, not a rounding mode.
//
// ⚠ WHAT IT CAUGHT, MEASURED AT 7f12908d BEFORE THE FIX. `AggState`
// (deem/incr.logos) was integer THROUGHOUT — `gsum: Vec<i64>` for sum/avg,
// `vbest: Vec<i64>` + `vmap: Vec<HashMap<i64,i64>>` for min/max — and every
// argument entered it through `rt_i`, which is `x as i64` for a float. So the
// incremental engine answered, on exactly the rows below:
//        sum          avg          min          max
//   g0   1.0 (≠2.0)   0.5 (≠1.0)   0.0 (≠0.5)   1.0 (≠1.5)
//   g1   2.0 (≠2.25)  2.0 (≠2.25)  2.0 (≠2.25)  2.0 (≠2.25)
//   g2  −1.0 (≠−1.5) −1.0 (≠−1.5) −1.0 (≠−1.5) −1.0 (≠−1.5)
//   g3   0.0 (≠1.0)   0.0 (≠0.5)   0.0 (≠0.25)  0.0 (≠0.75)
// while engines 1 and 2 were correct. `QRows::col_ty` reported `f64` on both
// sides: an f64-typed column whose cells were integers.
//
// ⚠ AND FOR min/max IT WAS NOT TRUNCATION BUT IDENTITY LOSS, WHICH IS WORSE.
// The multiplicity map is keyed on the accumulated value, so g3's `0.25` and
// `0.75` — DISTINCT rows — collided onto the single key `0` with count 2.
// Retracting either would have retracted the other's multiplicity. Group g3
// exists in this file for that reason and for no other; it is not a second
// sample of g0.
//
// ⚠ WHY THIS SURVIVED. The engine-3 fixtures that look like float coverage are
// not: query_incr_nasty_join:306 and query_incr_join_fuzz:265 run
// `avg(e.dept)` where `dept: i64` and label it "the f64-column variant" — the
// f64 there is avg's RESULT type, never its ARGUMENT; min/max there run over
// `e.val: i64`. query_f64_avg_nan_fuzz IS bit-exact over an adversarial f64
// pool and IS a 3-way differential, but its three sides are static / dynamic /
// naive oracle — engine 3 is not one of them. A differential over two engines
// is what let a defect in the third one live.
//
// SCOPE. Base epoch only (the fill through `ag_run`), because the exactness of
// an f64 accumulator UNDER RETRACTION is a separate open question: the i64
// accumulator is an exact abelian group and f64 is not, so `(S+x)−x == S` is a
// property this file deliberately does not claim. See the ⚠ FORK note at
// `AggState` in deem/incr.logos. min/max carry no such caveat — they are a
// semilattice with a rescan-on-retract and are exact either way.
//
// exit 0 = the three engines agree with the hand-derived answers.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.wql.wql;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

struct S { pub g: i64, pub x: f64 }
pub schema SF : code(0x0E44_0000_0000_0002) { g: i64 = 0, x: f64 = 1 }
resource cat = schema_catalog!{ SF };

// ENGINE 1 — static `deem!`, one aggregate each (the compiled fold).
pub deem q_sum(ss: &[S]) { from ss s group by s.g aggregate a = sum(s.x) select a : f64 }
pub deem q_avg(ss: &[S]) { from ss s group by s.g aggregate a = avg(s.x) select a : f64 }
pub deem q_min(ss: &[S]) { from ss s group by s.g aggregate a = min(s.x) select a : f64 }
pub deem q_max(ss: &[S]) { from ss s group by s.g aggregate a = max(s.x) select a : f64 }

// THE ROWS, and every expectation below is derived from THESE by hand:
//   g0 { 0.5, 1.5 }    sum 2.0    avg 1.0   min 0.5   max 1.5
//   g1 { 2.25 }        sum 2.25   avg 2.25  min 2.25  max 2.25
//   g2 { −1.5 }        sum −1.5   avg −1.5  min −1.5  max −1.5
//   g3 { 0.25, 0.75 }  sum 1.0    avg 0.5   min 0.25  max 0.75
// Halves and quarters only: every value, every partial sum and every quotient
// is representable exactly, so `==` on f64 is the right comparison here.
// g3's two values BOTH truncate to 0 — that is what makes it the identity probe.
fn rows() -> Vec<S> {
    let mut v: Vec<S> = vec_new::<S>();
    v.push(S { g: 0i64, x: 0.5f64  });
    v.push(S { g: 0i64, x: 1.5f64  });
    v.push(S { g: 1i64, x: 2.25f64 });
    v.push(S { g: 2i64, x: 0.0f64 - 1.5f64 });
    v.push(S { g: 3i64, x: 0.25f64 });
    v.push(S { g: 3i64, x: 0.75f64 });
    return v;
}

fn exp_sum(g: i64) -> f64 {
    if g == 0i64 { return 2.0f64; }
    if g == 1i64 { return 2.25f64; }
    if g == 2i64 { return 0.0f64 - 1.5f64; }
    return 1.0f64;
}
fn exp_avg(g: i64) -> f64 {
    if g == 0i64 { return 1.0f64; }
    if g == 1i64 { return 2.25f64; }
    if g == 2i64 { return 0.0f64 - 1.5f64; }
    return 0.5f64;
}
fn exp_min(g: i64) -> f64 {
    if g == 0i64 { return 0.5f64; }
    if g == 1i64 { return 2.25f64; }
    if g == 2i64 { return 0.0f64 - 1.5f64; }
    return 0.25f64;
}
fn exp_max(g: i64) -> f64 {
    if g == 0i64 { return 1.5f64; }
    if g == 1i64 { return 2.25f64; }
    if g == 2i64 { return 0.0f64 - 1.5f64; }
    return 0.75f64;
}

fn mkR(d: &Writ, g: i64, x: f64) -> WAny {
    let r: SF = d.make::<SF>(); r.g = g; r.x = x;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn wsrc(d: &Writ, ss: &Vec<S>) -> WAny {
    let n: i64 = ss.len();
    let arr: &mut WArray<WAny> = d.array(n + 1i64);
    let mut i: i64 = 0i64;
    while i < n { arr.push(mkR(d, ss.get(i).g, ss.get(i).x)); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

// Row index of group `g` in a `(key, sum, avg, min, max)` result, or −1.
// Looked up by KEY rather than by position so the file measures the VALUES and
// leaves group ordering to the fixtures that pin group ordering.
fn find_row(r: &QRows, g: i64) -> i64 {
    let n: i64 = r.row_count();
    let mut i: i64 = 0i64;
    while i < n {
        if r.get_i64(i, 0i64) == g { return i; }
        i = i + 1i64;
    }
    return 0i64 - 1i64;
}

// The four-aggregate text, shared by engines 2 and 3 so the two ask ONE query.
fn qtext() -> str {
    return "from ss s group by s.g aggregate sm = sum(s.x), av = avg(s.x), mn = min(s.x), mx = max(s.x) select (key, sm, av, mn, mx)";
}

// Check one `(key, sum, avg, min, max)` table against the hand-derived answers.
// Returns 0 on agreement, else `base + 1..4` naming the aggregate that differs
// (+ 5 for a missing group, + 6 for a bad row count).
fn check_table(r: &QRows, base: i32) -> i32 {
    if r.row_count() != 4i64 { return base + 6i32; }
    let mut g: i64 = 0i64;
    while g < 4i64 {
        let i: i64 = find_row(r, g);
        if i < 0i64                          { return base + 5i32; }
        if r.get_f64(i, 1i64) != exp_sum(g)  { return base + 1i32; }
        if r.get_f64(i, 2i64) != exp_avg(g)  { return base + 2i32; }
        if r.get_f64(i, 3i64) != exp_min(g)  { return base + 3i32; }
        if r.get_f64(i, 4i64) != exp_max(g)  { return base + 4i32; }
        g = g + 1i64;
    }
    return 0i32;
}

fn main() -> i32 {
    let c: SchemaCatalog = cat();
    let ss: Vec<S> = rows();
    let d: Writ = writ_new(8192i64);
    let mut e: QEnv = QEnv::new();
    e.bind_source("ss", wsrc(&d, &ss));

    // ── ENGINE 1 — static `deem!` ──────────────────────────────────────────
    // The static surface groups in FIRST-OCCURRENCE order, which for `rows()`
    // is g0, g1, g2, g3 — so index i carries group i here.
    let sv: Vec<f64> = match q_sum(ss.as_slice()) {
        Result::Ok(v) => { v } Result::Err(_a) => { return 10i32; }
    };
    let av: Vec<f64> = match q_avg(ss.as_slice()) {
        Result::Ok(v) => { v } Result::Err(_b) => { return 11i32; }
    };
    let nv: Vec<f64> = match q_min(ss.as_slice()) {
        Result::Ok(v) => { v } Result::Err(_c) => { return 12i32; }
    };
    let xv: Vec<f64> = match q_max(ss.as_slice()) {
        Result::Ok(v) => { v } Result::Err(_d) => { return 13i32; }
    };
    if sv.len() != 4i64 || av.len() != 4i64 || nv.len() != 4i64 || xv.len() != 4i64 { return 14i32; }
    let mut g1: i64 = 0i64;
    while g1 < 4i64 {
        if sv.get(g1) != exp_sum(g1) { return 15i32; }
        if av.get(g1) != exp_avg(g1) { return 16i32; }
        if nv.get(g1) != exp_min(g1) { return 17i32; }
        if xv.get(g1) != exp_max(g1) { return 18i32; }
        g1 = g1 + 1i64;
    }

    // ── ENGINE 2 — dynamic `Query::run` ────────────────────────────────────
    let dq: Query = match Query::compile(qtext(), &c) {
        Result::Ok(q) => { q } Result::Err(_e) => { return 20i32; }
    };
    let dr: QRows = match dq.run(&e) {
        Result::Ok(r) => { r } Result::Err(_f) => { return 21i32; }
    };
    let d2: i32 = check_table(&dr, 20i32);
    if d2 != 0i32 { return d2; }

    // ── ENGINE 3 — incremental (DBSP), BASE EPOCH ──────────────────────────
    let iq: Query = match Query::compile(qtext(), &c) {
        Result::Ok(q) => { q } Result::Err(_g) => { return 30i32; }
    };
    let eng: IncrJoin = match iq.incremental(&e) {
        Result::Ok(x) => { x } Result::Err(_h) => { return 31i32; }
    };
    if eng.had_error() { return 32i32; }
    let ir: QRows = eng.snapshot();
    let d3: i32 = check_table(&ir, 40i32);
    if d3 != 0i32 { return d3; }

    // ── AND THE THREE AGREE PAIRWISE ON EVERY CELL ─────────────────────────
    // Asserted directly, not inferred from "both matched the constants": a
    // differential that only ever runs through an expectation table stops being
    // a differential the day the table is edited.
    let mut g3: i64 = 0i64;
    while g3 < 4i64 {
        let di: i64 = find_row(&dr, g3);
        let ii: i64 = find_row(&ir, g3);
        if di < 0i64 || ii < 0i64 { return 50i32; }
        if dr.get_f64(di, 1i64) != ir.get_f64(ii, 1i64) { return 51i32; }
        if dr.get_f64(di, 2i64) != ir.get_f64(ii, 2i64) { return 52i32; }
        if dr.get_f64(di, 3i64) != ir.get_f64(ii, 3i64) { return 53i32; }
        if dr.get_f64(di, 4i64) != ir.get_f64(ii, 4i64) { return 54i32; }
        if sv.get(g3) != ir.get_f64(ii, 1i64) { return 55i32; }
        if av.get(g3) != ir.get_f64(ii, 2i64) { return 56i32; }
        if nv.get(g3) != ir.get_f64(ii, 3i64) { return 57i32; }
        if xv.get(g3) != ir.get_f64(ii, 4i64) { return 58i32; }
        g3 = g3 + 1i64;
    }

    return 0i32;
}
