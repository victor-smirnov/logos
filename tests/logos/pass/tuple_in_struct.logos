package tuple_in_struct;
// F20: tuple as struct field
struct Segment {
    start: (i32, i32);
    end:   (i32, i32);
}
fn dx(s: Segment) -> i32 { return s.end.0 - s.start.0; }
fn dy(s: Segment) -> i32 { return s.end.1 - s.start.1; }
fn main() -> i32 {
    let s: Segment = Segment {
        start: (0, 0),
        end:   (6, 36)
    };
    // dx=6, dy=36: 6+36 = 42
    return dx(s) + dy(s);
}
