package bc_bindmut_for_range_mut_call_bound;
fn bound() -> i64 { return 4i64; }
fn main() -> i32 {
    let mut acc: i64 = 0i64;
    let mut cnt: i64 = 0i64;
    for mut i in 0i64..bound() {
        i = i + 1i64;
        acc = acc + i;
        cnt = cnt + 1i64;
    }
    if acc != 10i64 { return 1i32; }
    if cnt != 4i64 { return 2i32; }
    return 0i32;
}
