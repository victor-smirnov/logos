// CLOSED soundness_queue row double_ref_temp_arg_never_dropped (tier 1), round 2026-09-14o-autoreffund.
// `peek(&&D { .. })` in a non-extending position: the inner `&` spilled the rvalue with no owner (n=1). Now owned by the
// statement temp scope; the extending `let r = &&<rvalue>` takes lower_let's named-temp extension instead. Count 1001, exit 0.
package bc_autoreffund_double_ref_temp_dropped_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn peek(r: &&D) -> i64 { return r.v; }
fn body(p: *mut i64) -> i64 {
    let a: D = D { v: 1i64, c: p };
    let k: i64 = peek(&&D { v: 1000i64, c: p });
    return k - 1000i64 + a.v - 1i64;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = body(p);
    let got: i64 = unsafe { n };
