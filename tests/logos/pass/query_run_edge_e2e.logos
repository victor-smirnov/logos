// queue-2 I2 — REdge TRAVERSAL at runtime (ADR 0012-queue2 §7): the
// interpreter re-resolves `base_var` + `path` (the SEMANTIC step fields —
// never the static `src` spelling) against its own row bindings. Covers:
//   • collection-edge step (`join t.emps e`) over a WRef<Emp> Writ array;
//   • chained SCALAR-ELEMENT array step (`join e.skills s`, WRef<str> —
//     the I2 FK_EARR catalog extension, macro-emitted);
//   • SINGLE-NODE edge (`join e.boss b`, WRef<Emp> holding ONE object —
//     runtime shape dispatch iterates exactly once; null iterates zero);
//   • anti traversal (NOT-EXISTS; empty collection ⇒ kept).
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.wstring;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.query;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Emp : code(0x0B03_0000_0000_0001) {
    name:   str        = 0,
    age:    i64        = 1,
    skills: WRef<str>  = 2,   // SCALAR-ELEMENT array edge (FK_EARR)
    boss:   WRef<Emp>  = 3,   // SINGLE-NODE edge (one object, not an array)
}

pub schema Team : code(0x0B03_0000_0000_0002) {
    title: str       = 0,
    emps:  WRef<Emp> = 1,     // collection edge (Writ array of Emp)
}

impl Emp  { pub fn as_any(self: &Emp)  -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }
impl Team { pub fn as_any(self: &Team) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }

resource cat = schema_catalog!{ Emp, Team };

// A string payload as a WAny array element (the generated parsers' idiom).
fn wstr_any(d: &Writ, s: str) -> WAny {
    let ws: &WString = d.wstring(s);
    return WAny::ref_to(ws as *const WString as *const u8);
}

fn arr_any(a: &WArray<WAny>) -> WAny {
    return WAny::ref_to(a as *const WArray<WAny> as *const u8);
}

fn main() -> i32 {
    let d: Writ = writ_new(8192i64);

    // Ann(45, [go, c]), Bob(31, [go], boss=Ann), Cid(52, [], boss=Ann)
    let ann: Emp = d.make::<Emp>();
    ann.name = "Ann";
    ann.age = 45i64;
    let ska: &mut WArray<WAny> = d.array(2i64);
    ska.push(wstr_any(&d, "go"));
    ska.push(wstr_any(&d, "c"));
    ann.skills = WRef::<str>::from_any(arr_any(ska));

    let bob: Emp = d.make::<Emp>();
    bob.name = "Bob";
    bob.age = 31i64;
    let skb: &mut WArray<WAny> = d.array(2i64);
    skb.push(wstr_any(&d, "go"));
    bob.skills = WRef::<str>::from_any(arr_any(skb));
    bob.boss = WRef::<Emp>::from_any(ann.as_any());   // SINGLE node, not array

    let cid: Emp = d.make::<Emp>();
    cid.name = "Cid";
    cid.age = 52i64;
    cid.boss = WRef::<Emp>::from_any(ann.as_any());

    let t1: Team = d.make::<Team>();
    t1.title = "Core";
    let te: &mut WArray<WAny> = d.array(4i64);
    te.push(ann.as_any());
    te.push(bob.as_any());
    te.push(cid.as_any());
    t1.emps = WRef::<Emp>::from_any(arr_any(te));

    let teams: &mut WArray<WAny> = d.array(2i64);
    teams.push(t1.as_any());

    let c: SchemaCatalog = cat();
    // the FK_EARR catalog extension is macro-emitted (WRef<str> → arr:str)
    if !str_eq(c.field_ty("Emp", "skills"), "arr:str") { return 1i32; }
    if !str_eq(c.field_ty("Emp", "boss"), "edge") { return 2i32; }

    let mut env: QEnv = QEnv::new();
    env.bind_source("teams", arr_any(teams));

    // ── collection-edge traversal ─────────────────────────────────────────
    let q1: Query = match Query::compile(
        "from teams t join t.emps e select (t.title, e.name)", &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e) => { return 3i32; }
    };
    let r1: QRows = match q1.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e2) => { return 4i32; }
    };
    if r1.row_count() != 3i64 { return 5i32; }
    if !str_eq(r1.get_str(0i64, 0i64), "Core") { return 6i32; }
    if !str_eq(r1.get_str(0i64, 1i64), "Ann") { return 7i32; }
    if !str_eq(r1.get_str(2i64, 1i64), "Cid") { return 8i32; }

    // ── chained SCALAR-ELEMENT step + `on` residual over the element ──────
    let q2: Query = match Query::compile(
        "from teams t join t.emps e join e.skills s on s == \"go\" select (e.name, s)", &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e3) => { return 9i32; }
    };
    let r2: QRows = match q2.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e4) => { return 10i32; }
    };
    if r2.row_count() != 2i64 { return 11i32; }
    if !str_eq(r2.get_str(0i64, 0i64), "Ann") { return 12i32; }
    if !str_eq(r2.get_str(0i64, 1i64), "go") { return 13i32; }
    if !str_eq(r2.get_str(1i64, 0i64), "Bob") { return 14i32; }

    // ── SINGLE-NODE edge: iterate exactly one (null boss ⇒ zero) ──────────
    let q3: Query = match Query::compile(
        "from teams t join t.emps e join e.boss b select (e.name, b.name)", &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e5) => { return 15i32; }
    };
    let r3: QRows = match q3.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e6) => { return 16i32; }
    };
    if r3.row_count() != 2i64 { return 17i32; }   // Ann has no boss
    if !str_eq(r3.get_str(0i64, 0i64), "Bob") { return 18i32; }
    if !str_eq(r3.get_str(0i64, 1i64), "Ann") { return 19i32; }
    if !str_eq(r3.get_str(1i64, 0i64), "Cid") { return 20i32; }

    // ── ANTI traversal: kept iff NO skill == "go" (empty ⇒ kept) ──────────
    let q4: Query = match Query::compile(
        "from teams t join t.emps e anti join e.skills s on s == \"go\" select e.name", &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e7) => { return 21i32; }
    };
    let r4: QRows = match q4.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e8) => { return 22i32; }
    };
    if r4.row_count() != 1i64 { return 23i32; }
    if !str_eq(r4.get_str(0i64, 0i64), "Cid") { return 24i32; }

    return 0i32;
}
