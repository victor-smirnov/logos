// A local type shadows every import of its name, whatever the import's kind (Rust's one type namespace): a local `enum Slot` beside `use logos.mem.collections.hashmap` (private `struct Slot`) is the enum ('Slot is private to package ...').
package f19;
use logos.std.fmt;
use logos.mem.collections.hashmap;
enum Slot<T> { Empty, Full(T) }
struct Bag { a: Slot<i64> }
fn main() {
    let b = Bag { a: Slot::Full(4) };
    match b.a { Slot::Full(v) => println!("{}", v), Slot::Empty => println!("e") }
}
