package metacall_hermes;
use logos.lang.hermes.comp_builder;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.static_view;
use logos.lang.hermes.hstatic;
use logos.mem.rc;

unsafe fn build_cfg() -> Rc<Hermes2> {
    let arr: [i32; 4] = [10, 20, 30, 40];
    return @{"k": x for x in arr};
}

unsafe fn main() -> i32 {
    // Compile-time: metacall JITs build_cfg, freezes the Rc<Hermes2> into a
    // HermesStatic rodata blob.
    let cfg_meta: HermesStatic = metacall build_cfg();
    let vm: HView2 = hview2_from_ptr(cfg_meta.ptr);
    let mroot: HAny = vm.root();
    if mroot.is_null() { return 1; }
    let mk: HAny = vm.map_get(mroot, "k");
    if !mk.is_int() { return 2; }

    // Runtime: same builder, read through the container.
    let cfg_rt: Rc<Hermes2> = build_cfg();
    let h: &Hermes2 = cfg_rt.deref();
    let rroot: HAny = h.root();
    if rroot.is_null() { return 3; }
    let v0: HView2 = HView2 { base: 0 as *const u8 };
    let rk: HAny = v0.map_get(rroot, "k");
    if !rk.is_int() { return 4; }

    // The comprehension's constant key overwrites per iteration -> k == 40 both sides.
    if vm.get_int(mk) != 40i64 { return 5; }
    if v0.get_int(rk) != 40i64 { return 6; }

    return 42;
}
