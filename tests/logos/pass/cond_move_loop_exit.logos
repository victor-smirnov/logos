package cond_move_loop_exit;
extern fn printf(fmt: *const u8, ...) -> i32;
extern fn fflush(f: *mut u8) -> i32;
fn pr(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); fflush(0 as *mut u8); } }
fn ps(s: str) { unsafe { printf(s.as_ptr()); fflush(0 as *mut u8); } }

trait Drop { fn drop(self: Self); }

/// HEAP-OWNING payload. The `Vec` is what makes the oracle bite: a second
/// destructor call on the same value is a genuine double free (glibc aborts),
/// a missing one a genuine leak. Every conditional move already in the corpus
/// carries a Copy payload, which is exactly why 3844 green tests could hold
/// this defect — the counting oracle below is the only thing that sees it.
struct Pay { n: i64, v: Vec<i64> }
impl Drop for Pay {
    fn drop(self: Pay) { pr("D%ld ", self.n); }
}
fn mk(n: i64) -> Pay {
    let mut v: Vec<i64> = Vec::new();
    v.push(n);
    pr("M%ld ", n);
    return Pay { n: n, v: v };
}
fn consume(p: Pay) -> i64 { return p.n; }

/// #118 cell H — a move followed by `break`. `branch_diverges` lumped
/// break/continue with `return`, so the branch's moves were DISCARDED at the
/// merge; but control does arrive at the enclosing frame's drops, via the loop
/// edge, and re-freed the moved-out heap (rc 134). `return` (cell G) was and
/// stays correct because control really leaves.
fn cellH(c: bool) {
    let a: Pay = mk(1); let b: Pay = mk(2);
    let mut i: i64 = 0;
    while i < 1 as i64 {
        if c { pr("u=%ld ", consume(a)); break; }
        i = i + 1 as i64;
    }
    pr("b=%ld ", b.n);
}

/// cell G — early `return` after a conditional move: the return's own unwind
/// already had the right move state, and must keep it.
fn cellG(c: bool) {
    let a: Pay = mk(1); let b: Pay = mk(2);
    if c { pr("u=%ld ", consume(a)); return; }
    pr("b=%ld ", b.n);
}

unsafe fn main() -> i32 {
    ps("H+ "); cellH(true);  ps("\n");
    ps("H- "); cellH(false); ps("\n");
    ps("G+ "); cellG(true);  ps("\n");
    ps("G- "); cellG(false); ps("\n");
    return 0;
}
