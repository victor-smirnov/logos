// vec!(a, b, c) → vec_from_arr([a, b, c]) — single-call lowering.
// Both element type and array length flow through unify_types' array
// branches; the user's `let v: Vec<T> = ...` annotation is the only
// type hint needed.
package fn_macro_vec_basic;

use std.compiler.metaprog;
use std.collections.vec;

#[fn_macro]
pub fn vec(elems: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! { vec_from_arr([#(#elems),*]) };
}

fn main() -> i32 {
    let v: Vec<i32> = vec!(1i32, 2i32, 3i32, 4i32);
    return v.get(0i64) + v.get(1i64) + v.get(2i64) + v.get(3i64);
}
