// query_incr_trace_e2e — S1 TRACE REIFICATION (ADR 0015 §2, invariant I1).
// IncrRec records append-only sensor facts about its OWN evaluation: per-step
// TraceStep(epoch, kind, step, delta_card, total_rows, ns) and per-epoch
// TraceEpoch(epoch, d_ins, d_del, rounds, ns). Asserts, over a TC engine:
//   (a) CONSISTENCY ORACLE — Σ delta_card over the whole trace == the final
//       maintained row count (holds through build, insert epochs, and DRed);
//   (b) golden trace STRUCTURE (deterministic part only — never the ns sensor):
//       build = one kind-0 step at epoch 0; an insert epoch = kind-1 seed then
//       kind-2 rounds with consecutive step indices and increasing totals; a
//       retraction epoch = one kind-3 step with a negative net delta; a no-op
//       epoch = a summary row with rounds == 0 and no steps;
//   (c) ns ≥ 0 on every record (sensor sanity, no golden values);
//   (d) I3 toggle — set_trace(false) ⇒ an epoch records NOTHING;
//   (e) DOGFOOD (the I1 loop): the trace materializes into schema'd nodes,
//       binds as an ordinary source, and a Deem query derives `taking_long`
//       facts from the engine's own past (delta_card > expected_cost).
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema Edge : code(0x0E07_0000_0000_000A) {
    src: i64 = 0,
    dst: i64 = 1,
}
// The engine's own trace, re-entering the engine as an ordinary source (I1).
pub schema TraceRow : code(0x0E07_0000_0000_000B) {
    epoch: i64 = 0,
    kind:  i64 = 1,
    step:  i64 = 2,
    delta: i64 = 3,
    total: i64 = 4,
}
resource cat = schema_catalog!{ Edge, TraceRow };

fn mk_edge(d: &Writ, s: i64, t: i64) -> WAny {
    let e: Edge = d.make::<Edge>();
    e.src = s; e.dst = t;
    return WAny::ref_to((e.m as i64) as *const u8);
}

fn build_src(d: &Writ, hs: &Vec<WAny>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(64i64);
    let n: i64 = hs.len();
    let mut i: i64 = 0i64;
    while i < n { arr.push(hs.get(i)); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

// Σ delta_card over the full trace — the consistency oracle's left-hand side.
fn trace_delta_sum(eng: &IncrRec) -> i64 {
    let mut s: i64 = 0i64;
    let n: i64 = eng.trace_len();
    let mut i: i64 = 0i64;
    while i < n { s = s + eng.trace_at(i).delta_card; i = i + 1i64; }
    return s;
}

// Every record's ns must be a sane sensor reading (≥ 0; never golden values).
fn ns_sane(eng: &IncrRec) -> bool {
    let mut i: i64 = 0i64;
    while i < eng.trace_len() {
        if eng.trace_at(i).ns < 0i64 { return false; }
        i = i + 1i64;
    }
    let mut j: i64 = 0i64;
    while j < eng.epochs_len() {
        if eng.epoch_at(j).ns < 0i64 { return false; }
        j = j + 1i64;
    }
    return true;
}

fn main() -> i32 {
    let doc: Writ = writ_new(65536i64);
    let c: SchemaCatalog = cat();
    let q: Query = match Query::compile(
        r#"rel path(a: i64, b: i64) {
             from edges e select (e.src, e.dst);
             from path p join edges e on p.b == e.src select (p.a, e.dst);
           }
           from path p select (p.a, p.b)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 90i32; } };

    // ── build: chain 0→1→2→3 ⇒ closure = 6 paths ──
    let mut hs: Vec<WAny> = vec_new::<WAny>();
    hs.push(mk_edge(&doc, 0i64, 1i64));
    hs.push(mk_edge(&doc, 1i64, 2i64));
    hs.push(mk_edge(&doc, 2i64, 3i64));
    let mut env: QEnv = QEnv::new();
    env.bind_source("edges", build_src(&doc, &hs));
    let mut eng: IncrRec = match q.incremental_rec(&env)
    { Result::Ok(e) => { e } Result::Err(_e2) => { return 1i32; } };

    // (b) build = exactly one kind-0 step at epoch 0, delta == total == 6.
    if eng.cur_epoch() != 0i64 { return 2i32; }
    if eng.trace_len() != 1i64 { return 3i32; }
    if eng.epochs_len() != 0i64 { return 4i32; }
    let b0: TraceStep = eng.trace_at(0i64);
    if b0.epoch != 0i64 || b0.kind != 0i32 || b0.step != 0i64 { return 5i32; }
    if b0.delta_card != 6i64 || b0.total_rows != 6i64 { return 6i32; }

    // ── epoch 1: insert edge(3,4) ⇒ +4 paths ((3,4),(2,4),(1,4),(0,4)) ──
    let e34: WAny = mk_edge(&doc, 3i64, 4i64);
    hs.push(e34);
    let mut d1: ZBatch = ZBatch::new();
    d1.push(e34, 1i64);
    eng.epoch(&d1);
    if eng.cur_epoch() != 1i64 { return 7i32; }
    if eng.epochs_len() != 1i64 { return 8i32; }
    let te1: TraceEpoch = eng.epoch_at(0i64);
    if te1.epoch != 1i64 || te1.d_ins != 1i64 || te1.d_del != 0i64 { return 9i32; }
    if te1.rounds < 1i64 { return 10i32; }
    // epoch-1 steps: kind-1 seed at step 0, then kind-2 rounds; consecutive step
    // indices; strictly increasing totals; Σ deltas == 4; last total == 10.
    let mut sum1: i64 = 0i64;
    let mut prev_total: i64 = 6i64;
    let mut want_step: i64 = 0i64;
    let mut i1: i64 = 1i64;
    while i1 < eng.trace_len() {
        let st: TraceStep = eng.trace_at(i1);
        if st.epoch != 1i64 { return 11i32; }
        if st.step != want_step { return 12i32; }
        if want_step == 0i64 { if st.kind != 1i32 { return 13i32; } }
        else                 { if st.kind != 2i32 { return 14i32; } }
        if st.delta_card <= 0i64 { return 15i32; }
        if st.total_rows != prev_total + st.delta_card { return 16i32; }
        prev_total = st.total_rows;
        sum1 = sum1 + st.delta_card;
        want_step = want_step + 1i64;
        i1 = i1 + 1i64;
    }
    if sum1 != 4i64 { return 17i32; }
    if prev_total != 10i64 { return 18i32; }
    if te1.rounds != want_step { return 19i32; }

    // ── epoch 2: no-op ⇒ summary only (rounds 0), no steps ──
    let tl_before: i64 = eng.trace_len();
    let d2: ZBatch = ZBatch::new();
    eng.epoch(&d2);
    if eng.trace_len() != tl_before { return 20i32; }
    if eng.epochs_len() != 2i64 { return 21i32; }
    let te2: TraceEpoch = eng.epoch_at(1i64);
    if te2.epoch != 2i64 || te2.d_ins != 0i64 || te2.d_del != 0i64
    || te2.rounds != 0i64 { return 22i32; }

    // ── epoch 3: retract edge(1,2) ⇒ DRed; closure = {(0,1),(2,3),(2,4),(3,4)} ──
    let mut d3: ZBatch = ZBatch::new();
    d3.push(hs.get(1i64), 0i64 - 1i64);
    eng.epoch(&d3);
    if eng.epochs_len() != 3i64 { return 23i32; }
    let te3: TraceEpoch = eng.epoch_at(2i64);
    if te3.epoch != 3i64 || te3.d_ins != 0i64 || te3.d_del != 1i64
    || te3.rounds != 0i64 { return 24i32; }
    if eng.trace_len() != tl_before + 1i64 { return 25i32; }
    let sd: TraceStep = eng.trace_at(tl_before);
    if sd.epoch != 3i64 || sd.kind != 3i32 || sd.step != 0i64 { return 26i32; }
    if sd.delta_card != (0i64 - 6i64) || sd.total_rows != 4i64 { return 27i32; }

    // (a) CONSISTENCY ORACLE: Σ delta_card == final maintained row count.
    let snap: QRows = eng.snapshot();
    if snap.row_count() != 4i64 { return 28i32; }
    if trace_delta_sum(&eng) != snap.row_count() { return 29i32; }

    // (c) sensor sanity.
    if !ns_sane(&eng) { return 30i32; }

    // (d) I3 toggle: tracing off ⇒ an epoch records NOTHING, engine still right.
    eng.set_trace(false);
    let tl2: i64 = eng.trace_len();
    let ep2: i64 = eng.epochs_len();
    let mut d4: ZBatch = ZBatch::new();
    d4.push(hs.get(1i64), 1i64);   // re-insert edge(1,2)
    eng.epoch(&d4);
    if eng.trace_len() != tl2 || eng.epochs_len() != ep2 { return 31i32; }
    let snap2: QRows = eng.snapshot();
    if snap2.row_count() != 10i64 { return 32i32; }

    // (e) DOGFOOD: the engine's own past as an ordinary Deem source. Derive
    // taking_long(epoch) :- trace(epoch,…,delta,…), delta > expected_cost.
    let tdoc: Writ = writ_new(65536i64);
    let tarr: &mut WArray<WAny> = tdoc.array(64i64);
    let mut ti: i64 = 0i64;
    while ti < eng.trace_len() {
        let st2: TraceStep = eng.trace_at(ti);
        let r: TraceRow = tdoc.make::<TraceRow>();
        r.epoch = st2.epoch;
        r.kind  = st2.kind as i64;
        r.step  = st2.step;
        r.delta = st2.delta_card;
        r.total = st2.total_rows;
        tarr.push(WAny::ref_to((r.m as i64) as *const u8));
        ti = ti + 1i64;
    }
    let tq: Query = match Query::compile(
        r#"from trace t where t.delta > expected_cost
           select (t.epoch, t.delta)"#,
        &c)
    { Result::Ok(v) => { v } Result::Err(_e6) => { return 33i32; } };
    let mut tenv: QEnv = QEnv::new();
    tenv.bind_source("trace", WAny::ref_to(tarr as *const WArray<WAny> as *const u8));
    tenv.bind_i64("expected_cost", 4i64);
    let trows: QRows = match tq.run(&tenv)
    { Result::Ok(v) => { v } Result::Err(_e7) => { return 34i32; } };
    // only the build step admitted > 4 rows (delta 6, epoch 0).
    if trows.row_count() != 1i64 { return 35i32; }
    if trows.get_i64(0i64, 0i64) != 0i64 { return 36i32; }
    if trows.get_i64(0i64, 1i64) != 6i64 { return 37i32; }

    return 0i32;
}
