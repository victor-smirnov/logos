// `==` over non-primitive operands compares VALUES through the elements' `Eq`, never addresses (squeue row; rustc 1.98.1: exit 0).
package ref_pair_nonprim_tuple_eq_compares_addresses_run;
use logos.lang.cmp;
use logos.mem.string;
struct S { v: i64 }
impl Eq for S {
    fn eq(&self, other: &S) -> bool {
        return self.v == other.v;
    }
}
fn main() -> i32 {
    let u1: (S, i64) = (S { v: 5i64 }, 6i64);
    let u2: (S, i64) = (S { v: 5i64 }, 6i64);
    let ru1: &(S, i64) = &u1;
    let ru2: &(S, i64) = &u2;
    if !(ru1 == ru2) { return 1i32; }
    let s1: (String, i64) = (String::from("ab"), 1i64);
    let s2: (String, i64) = (String::from("ab"), 1i64);
    let rs1: &(String, i64) = &s1;
    let rs2: &(String, i64) = &s2;
    if !(rs1 == rs2) { return 2i32; }
    return 0i32;
}
