// Phase 0 RAII: container auto-frees its never-move arena on scope exit (Drop),
// no manual writ_free. Allocate across a segment boundary, then just return.
package test;
use logos.lang.writ.container;
struct Node { val: i64, link: *mut Node }
fn main() -> i32 {
    unsafe {
        let mut hh: Writ = writ_new(32);   // 32B segments → 2 Nodes each
        let a: *mut Node = writ_alloc::<Node>(&mut hh);
        let b: *mut Node = writ_alloc::<Node>(&mut hh);
        let c: *mut Node = writ_alloc::<Node>(&mut hh);   // forces a 2nd segment
        a.val = 1; b.val = 2; c.val = 3;
        let s: i64 = a.val + b.val + c.val;
        if s != 6 { return 1; }
        // NO writ_free — Drop frees both segments at scope exit.
    }
    return 0;
}
