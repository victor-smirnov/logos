// Partial-specialisation of a struct: an empty base + per-key-shape specs with
// DIFFERENT layouts. Regression for two bugs where the spec's layout/attributes
// were lost:
//   1. sizeof / layout_of resolved the empty base (find_any_struct) instead of the
//      best-matching spec — `mono_abi_size`/`mono_dst_prefix_field` now route through
//      `resolve_struct_layout` (find_best_struct_spec first).
//   2. `lower_spec_struct` dropped struct-level flags (#[zone_mut]/#[zoned2]/…) on
//      a specialisation — now applied via `apply_struct_flags`.
// Both reachable only when a concrete spec instantiation is actually emitted, so we
// force instantiation by accessing the spec's fields through a pointer.
package test;

#[zoned2] pub struct Base<K, V> {}

#[zoned2] pub struct KeyA { pub junk: i64 }
#[zoned2] pub struct Base<KeyA, V> { pub a: i64, pub b: i64, pub c: i64 }   // 24 bytes

#[zoned2] pub struct Marker {}
#[zoned2] pub struct Base<Marker, V> { pub x: i64, pub y: i64 }             // 16 bytes

#[zoned2] pub struct Val { pub v: i64 }

// Force instantiation + field-offset resolution against the chosen spec.
fn read_a(p: *const Base<KeyA, Val>) -> i64 { return unsafe { p.a + p.b + p.c }; }
fn read_x(q: *const Base<Marker, Val>) -> i64 { return unsafe { q.x + q.y }; }

fn main() -> i32 {
    // sizeof picks the best-matching spec, not the empty base (which would be ~0/8).
    if sizeof::<Base<KeyA, Val>>()   as i64 != 24i64 { return 1; }
    if sizeof::<Base<Marker, Val>>() as i64 != 16i64 { return 2; }

    // Field offsets resolve against the chosen spec: write three i64s into a 24-byte
    // buffer as a Base<KeyA,Val>, read them back via the spec's a/b/c.
    let mut buf: [i64; 3] = [10i64, 20i64, 30i64];
    let pa: *const Base<KeyA, Val> = &mut buf as *mut [i64; 3] as *const Base<KeyA, Val>;
    if read_a(pa) != 60i64 { return 3; }

    let mut buf2: [i64; 2] = [7i64, 8i64];
    let px: *const Base<Marker, Val> = &mut buf2 as *mut [i64; 2] as *const Base<Marker, Val>;
    if read_x(px) != 15i64 { return 4; }
    return 0;
}
