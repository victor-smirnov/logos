// Parse-then-traverse (writ2 successor of the Writ1 traversal test):
// int/bool extraction, array walk, map lookup — through container reads.
package writ_ctr_traversal;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.hmap;
use logos.lang.writ.hstring;
use logos.mem.writ.parser;
use logos.lang.rc;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(16384);
    let h: &Writ = rc.deref();

    // 1. Integer root.
    let v1: HAny = parse(h, "12345");
    if !v1.is_int() { return 1; }
    if v1.as_i64() != 12345i64 { return 2; }

    // 2. Bool root.
    let v2: HAny = parse(h, "false");
    if !v2.is_bool() { return 3; }
    if v2.as_bool() { return 4; }

    // 3. Array traversal: sum of [10, 20, 30] = 60.
    let v3: HAny = parse(h, "[10, 20, 30]");
    let arr: &HArray<HAny> = &*(v3.resolve() as *const HArray<HAny>);
    let mut sum: i64 = 0;
    let mut i: i64 = 0;
    while i < arr.len() {
        sum = sum + arr.get(i).as_i64();
        i = i + 1;
    }
    if sum != 60i64 { return 5; }

    // 4. Map lookup {x: 55}.
    let v4: HAny = parse(h, "{x: 55}");
    let m: &HMap<HString, HAny> = &*(v4.resolve() as *const HMap<HString, HAny>);
    if m.get("x").as_i64() != 55i64 { return 6; }
    if !m.get("y").is_null() { return 7; }

    // 5. Deep mixed traversal.
    let v5: HAny = parse(h, "{items: [{id: 1}, {id: 2}], total: 2}");
    let mm: &HMap<HString, HAny> = &*(v5.resolve() as *const HMap<HString, HAny>);
    if mm.get("total").as_i64() != 2i64 { return 8; }
    let items: &HArray<HAny> = &*(mm.get("items").resolve() as *const HArray<HAny>);
    let it1: &HMap<HString, HAny> = &*(items.get(1).resolve() as *const HMap<HString, HAny>);
    if it1.get("id").as_i64() != 2i64 { return 9; }

    return 42;
}
