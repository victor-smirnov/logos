package a11_acqrel;
use logos.lang.atomic;
fn main() -> i32 {
    let mut a: AtomicI32 = atomic_i32_new(1i32);
    let p: *mut AtomicI32 = &mut a as *mut AtomicI32;
    let prev: i32 = unsafe { p.fetch_add_ordered(10i32, Ordering::AcqRel) };
    if prev != 1i32 { return 1i32; }
    if a.load_ordered(Ordering::Acquire) != 11i32 { return 2i32; }
    return 0i32;
}
