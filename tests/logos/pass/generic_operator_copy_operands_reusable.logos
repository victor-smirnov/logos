// With `T: Add + Copy` the operands are copies: `x` stays usable after `x + y`.
package generic_operator_copy_operands_reusable;
use logos.lang.clone;
extern fn printf(fmt: *const u8, ...) -> i32;
struct P { v: i64 }
impl Clone for P { fn clone(&self) -> P { return P { v: self.v }; } }
impl Copy for P {}
impl Add for P { type Output = P; fn add(self: P, o: P) -> P { return P { v: self.v + o.v }; } }
fn sumc<T: Add<Output = T> + Copy>(x: T, y: T) -> T { let s: T = x + y; let t: T = x + s; return t; }
fn main() -> i32 { unsafe { printf("%lld\n".as_ptr(), sumc(P { v: 1i64 }, P { v: 2i64 }).v); } return 0i32; }
