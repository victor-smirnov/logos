package short_circuit_and;
// Bug 5: && was lowered to arith.andi (bitwise AND) so RHS was always evaluated.
// Fix: generate control-flow — only evaluate RHS when LHS is true.

unsafe fn inc(p: *mut i32) -> bool {
    *p = *p + 1;
    return true;
}

unsafe fn main() -> i32 {
    let mut x: i32 = 0;
    let p: *mut i32 = &mut x;
    // With correct short-circuit: LHS=false → RHS not called → x stays 0
    // With old bitwise AND:       both sides always evaluated → x becomes 1
    if false && inc(p) {
        return 0;  // unreachable
    }
    if x == 0 {
        return 42;  // RHS was correctly skipped
    }
    return 0;       // RHS was wrongly evaluated
}
