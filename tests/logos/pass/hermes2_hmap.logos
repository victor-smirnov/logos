// Hermes2 HMap<HString, HVal> — string-keyed growing hash map (the JSON object) over the
// never-move arena. set/get/update, str + scalar values, GROWTH (insert past the
// initial capacity → rehash, all keys still retrievable), contains/len.
package test;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.hmap;
use logos.lang.hermes.hstring;
use logos.lang.str;
use logos.mem.string;        // i64::to_string, String::as_str (mem tier — test is standalone)
fn main() -> i32 {
    let h: Hermes2 = hermes2_new(64i64);
    let m: &mut HMap<HString, HVal> = h.map(8i64);

    m.set("age", 36i64);                 // scalar value
    m.set("name", "Ada");                // str value → interned
    m.set("active", true);               // bool

    if m.len() != 3i64 { return 1; }
    if m.get("age").as_i56() != 36i64 { return 2; }
    if !str_eq(h.hstring_of(m.get("name")).as_str(), "Ada") { return 3; }
    if m.get("active").as_bool() != true { return 4; }
    if !m.contains("name") { return 5; }
    if m.contains("missing") { return 6; }
    if !m.get("missing").is_null() { return 7; }

    // update existing key (no new slot)
    m.set("age", 37i64);
    if m.len() != 3i64 { return 8; }
    if m.get("age").as_i56() != 37i64 { return 9; }

    // GROWTH: insert 50 distinct keys (past cap=8) → forces several rehashes.
    let mut i: i64 = 0i64;
    while i < 50i64 {
        let s: String = i.to_string();
        m.set(s.as_str(), i * 100i64);
        i = i + 1i64;
    }
    if m.len() != 53i64 { return 10; }   // 3 original + 50

    // all 50 still retrievable after the rehashes
    let mut j: i64 = 0i64;
    while j < 50i64 {
        let s: String = j.to_string();
        if m.get(s.as_str()).as_i56() != j * 100i64 { return 100i32 + (j as i32); }
        j = j + 1i64;
    }
    // original keys survive growth too
    if m.get("age").as_i56() != 37i64 { return 200; }
    if !str_eq(h.hstring_of(m.get("name")).as_str(), "Ada") { return 201; }
    return 0;
}
