// queue-2 I3 — DYNAMIC Datalog STRATIFICATION: negation/aggregation against
// an EARLIER stratum (fully materialized rel) WORKS — through recursion it
// has no stratified semantics and Query::compile returns a QError NAMING the
// cycle members (value errors, never diagnostics; the same rules the static
// walker enforces, re-hosted over the SHARED compute_rel_scc condensation).
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Edge : code(0x0B12_0000_0000_0001) {
    src: i64 = 0,
    dst: i64 = 1,
}

resource cat = schema_catalog!{ Edge };

fn mk_edge(d: &Writ, s: i64, t: i64) -> WAny {
    let e: Edge = d.make::<Edge>();
    e.src = s;
    e.dst = t;
    let w: i64 = e.m as i64;
    return WAny::ref_to(w as *const u8);
}

fn expect_compile_err(text: str, c: &SchemaCatalog, frag: str) -> bool {
    match Query::compile(text, c) {
        Result::Ok(_q) => { return false; }
        Result::Err(e) => { return str_contains(e.message(), frag); }
    }
}

fn main() -> i32 {
    let d: Writ = writ_new(8192i64);
    let c: SchemaCatalog = cat();
    // Edges 1→2, 2→3: sources {1,2}; the only sink-dst is 3.
    let arr: &mut WArray<WAny> = d.array(4i64);
    arr.push(mk_edge(&d, 1i64, 2i64));
    arr.push(mk_edge(&d, 2i64, 3i64));
    let src: WAny = WAny::ref_to(arr as *const WArray<WAny> as *const u8);
    let mut env: QEnv = QEnv::new();
    env.bind_source("edges", src);

    // ── CROSS-STRATUM negation WORKS (rel body anti-joins an EARLIER rel) ──
    let q1: Query = match Query::compile(
        "rel base(x: i64) { from edges e select e.src; } rel snk(x: i64) { from edges e anti join base b on e.dst == b.x select e.dst; } from snk s select s.x order by s.x",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e) => { return 1i32; }
    };
    let r1: QRows = match q1.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e2) => { return 2i32; }
    };
    if r1.row_count() != 1i64 { return 3i32; }
    if r1.get_i64(0i64, 0i64) != 3i64 { return 4i32; }

    // ── ENTRY-level anti join against a rel also works ────────────────────
    let q2: Query = match Query::compile(
        "rel base(x: i64) { from edges e select e.src; } from edges e anti join base b on e.dst == b.x select e.dst",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e3) => { return 5i32; }
    };
    let r2: QRows = match q2.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e4) => { return 6i32; }
    };
    if r2.row_count() != 1i64 { return 7i32; }
    if r2.get_i64(0i64, 0i64) != 3i64 { return 8i32; }

    // ── ENTRY aggregation over a materialized rel works ───────────────────
    let q3: Query = match Query::compile(
        "rel base(x: i64) { from edges e select e.src; } from base b group by b.x aggregate n = count() select (key, n)",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e5) => { return 9i32; }
    };
    let r3: QRows = match q3.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e6) => { return 10i32; }
    };
    if r3.row_count() != 2i64 { return 11i32; }   // base = {1, 2} (set)

    // ── same-SCC negation → QError naming the cycle members ──────────────
    if !expect_compile_err(
        "rel p(a: i64) { from edges e select e.src; from p x anti join p y on x.a == y.a select x.a; } from p z select z.a",
        &c, "non-stratifiable negation") { return 12i32; }
    if !expect_compile_err(
        "rel p(a: i64) { from edges e select e.src; from p x anti join p y on x.a == y.a select x.a; } from p z select z.a",
        &c, "{p}") { return 13i32; }

    // ── same-SCC aggregation → the cycle error; out-of-cycle aggregate
    //    bodies → the plain shape reject (both static parity) ─────────────
    if !expect_compile_err(
        "rel r(a: i64) { from edges e select e.src; from r x group by x.a aggregate n = count() select key; } from r z select z.a",
        &c, "non-stratifiable aggregation") { return 14i32; }
    if !expect_compile_err(
        "rel q(a: i64) { from edges e group by e.src aggregate n = count() select key; } from q x select x.a",
        &c, "aggregate bodies are not allowed") { return 15i32; }

    // ── the borrow-outward gates: find over a rel / whole-row select ─────
    if !expect_compile_err(
        "rel base(x: i64) { from edges e select e.src; } from base b find b.x == 1",
        &c, "`find` over rel") { return 16i32; }
    if !expect_compile_err(
        "rel base(x: i64) { from edges e select e.src; } from base b select b",
        &c, "whole rel row") { return 17i32; }

    return 0i32;
}
