// deem_to_number_e2e — the EL builtin `to_number(s)`, Soufflé's string-to-
// number functor, read as Rust's `str::parse::<i64>`: an optional sign, then
// ASCII digits and nothing else. Soufflé reads it with C's `stoll` (blanks,
// `0x`/`0b`, trailing text ignored) and aborts on the rest; here every string
// that is not a number is `ElError::Parse`, one out of range `Overflow`.
//   (a) signs, leading zeros, both i64 limits;
//   (b) each fault, one row per call: trailing text, empty, a bare sign, a
//       leading blank, a hex prefix (Parse); one past each limit (Overflow);
//   (c) a join on the parsed key;
//   (d) a rel nobody reads still faults: the naive program evaluates it, so
//       neither the live-rel pruning nor a demand may drop it — the parse and
//       an out-of-range shift amount (`el_shamt`) both count as fallible.
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.std.wql.wql;
use logos.std.wql.el;       // ElError — the fault is asserted by name
use logos.mem.collections.vec;
use logos.lang.result;

struct T { pub s: &'static str, pub id: i64 }
struct K { pub k: i64, pub v: i64 }

// (a) (b)
pub deem nums(ts: &[T]) { from ts t select to_number(t.s) order by t.id }
// (c)
pub deem joined(ts: &[T], ks: &[K]) { from ts t join ks y on to_number(t.s) == y.k select y.v order by y.v }
// (d)
pub deem parse_dead(ts: &[T], ks: &[K]) {
    rel junk(n: i64) {
        from ts t select to_number(t.s);
    }
    from ks y select y.v order by y.v }
pub deem shift_dead(ks: &[K]) {
    rel junk(n: i64) {
        from ks y select 1 << y.k;
    }
    from ks y select y.v order by y.v }

// 0 = Ok, 1 = Parse, 2 = Overflow, 3 = another error
fn fault_of(s: &'static str) -> i32 {
    let one: [T; 1] = [T { s: s, id: 1i64 }];
    match nums(&one[..]) {
        Result::Ok(_v) => { return 0i32; }
        Result::Err(e) => {
            match e {
                ElError::Parse         => { return 1i32; }
                ElError::Overflow      => { return 2i32; }
                ElError::DivByZero     => { return 3i32; }
                ElError::Underflow     => { return 3i32; }
                ElError::RetractAbsent => { return 3i32; }
                ElError::SrcUnknown    => { return 3i32; }
            }
        }
    }
}

fn main() -> i32 {
    // (a)
    let ts: [T; 6] = [
        T { s: "42", id: 1i64 }, T { s: "-7", id: 2i64 }, T { s: "+3", id: 3i64 },
        T { s: "9223372036854775807", id: 4i64 }, T { s: "-9223372036854775808", id: 5i64 },
        T { s: "007", id: 6i64 },
    ];
    let a: Vec<i64> = nums(&ts[..]).unwrap();
    if a.len() != 6i64 { return 1i32; }
    if a.get(0i64) != 42i64 || a.get(1i64) != -7i64 || a.get(2i64) != 3i64 { return 2i32; }
    if a.get(3i64) != 9223372036854775807i64 || a.get(4i64) != (-9223372036854775807i64 - 1i64) || a.get(5i64) != 7i64 { return 3i32; }
    // (b)
    if fault_of("12abc") != 1i32 { return 4i32; }
    if fault_of("") != 1i32 { return 5i32; }
    if fault_of("-") != 1i32 { return 6i32; }
    if fault_of(" 1") != 1i32 { return 7i32; }
    if fault_of("0x10") != 1i32 { return 8i32; }
    if fault_of("9223372036854775808") != 2i32 { return 9i32; }
    if fault_of("-9223372036854775809") != 2i32 { return 10i32; }
    // (c) keys 42, -7, 3 meet k 3 → 30, 42 → 420
    let ks: [K; 3] = [K { k: 3i64, v: 30i64 }, K { k: 42i64, v: 420i64 }, K { k: 5i64, v: 50i64 }];
    let c: Vec<i64> = joined(&ts[0..3], &ks[..]).unwrap();
    if c.len() != 2i64 || c.get(0i64) != 30i64 || c.get(1i64) != 420i64 { return 11i32; }
    // (d) the clean twins answer; the faulting ones return the fault
    let good: Vec<i64> = parse_dead(&ts[..], &ks[..]).unwrap();
    if good.len() != 3i64 { return 12i32; }
    let bad: [T; 2] = [T { s: "1", id: 1i64 }, T { s: "x", id: 2i64 }];
    match parse_dead(&bad[..], &ks[..]) {
        Result::Ok(_v) => { return 13i32; }
        Result::Err(e) => { match e { ElError::Parse => { } _ => { return 14i32; } } }
    }
    if shift_dead(&ks[..]).unwrap().len() != 3i64 { return 15i32; }
    let wide: [K; 2] = [K { k: 3i64, v: 30i64 }, K { k: 70i64, v: 700i64 }];
    match shift_dead(&wide[..]) {
        Result::Ok(_v) => { return 16i32; }
        Result::Err(e) => { match e { ElError::Overflow => { } _ => { return 17i32; } } }
    }
    return 0i32;
}
