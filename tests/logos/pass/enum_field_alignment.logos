// Unified layout: a tagged enum is `{ i32 disc, <aligned payload blob> }` —
// an i64/ptr/align-8 payload lands on an 8-aligned offset (not mis-positioned
// at offset 4), so the enum is align-8 and sized correctly. Value-copy memcpy
// (let/assign/field-write) uses the unified size, so no bytes are dropped —
// Some(5)==Some(5) must hold, and an enum field inside a struct round-trips.
package test;
enum E { A(i64), B }
struct Cell { v: i64, tag: Option<i64> }
fn main() -> i32 {
    if sizeof::<E>() != 16i64 { return 1i32; }            // align-8 payload, padded
    if sizeof::<Option<i64>>() != 16i64 { return 2i32; }
    let a: Option<i64> = Option::Some(5i64);
    let b: Option<i64> = Option::Some(5i64);
    if !(a == b) { return 3i32; }                          // full i64 payload copied
    let mut c: Cell = Cell { v: 0i64, tag: Option::None };
    c.tag = Option::Some(7i64);                            // enum-valued field store
    match c.tag {
        Option::Some(t) => { if t != 7i64 { return 4i32; } }
        Option::None    => { return 5i32; }
    }
    return 42i32;
}
