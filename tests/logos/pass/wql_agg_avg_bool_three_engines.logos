// `avg` OVER A `bool` COLUMN — true is 1.0, false is 0.0, ON ALL THREE ENGINES.
//
// THE RULING (Victor, option (c) of three): `avg` ADMITS `bool` as numeric with
// the value rule true→1.0 / false→0.0, and REFUSES every other non-numeric
// argument. The other two options were to refuse `bool` as well (which breaks
// programs that compile and answer today) and to leave the hole open (which
// lets `avg(str)` keep compiling).
//
// ⚠ THE RULE IS NOT INVENTED HERE — IT IS WHAT `as f64` ALREADY MEANS. mlir-gen
// zero-extends i1 before the conversion on purpose (`sitofp(i1(1))` = -1.0 is
// wrong, `uitofp(i1(1))` = 1.0 is right), and the incremental tier already folds
// a bool through `rt_i`, which maps true→1. Three independent implementations
// converge on the same arithmetic; the ruling makes the FRONT END admit it.
//
// ⚠ THREE ENGINES, NOT TWO, AND THEY DISAGREED. Measured at the parent commit:
//   • static  `deem!`            — compiled rc=0 and answered 0.75 (the check
//                                  that would have refused it was SKIPPED, see
//                                  `agg_cast` in rexpr_walk);
//   • dynamic `Query::compile`   — compiled, then `run()` returned Err: the
//                                  shared rule table refused a BOOL argument;
//   • incremental `Query::incremental` — gated by the same check, so it refused
//                                  too, while its FOLD would have been correct.
// Admitting bool in the one shared table (`el::el_quot_ty`) moves all three at
// once. That is the point of the table — and it is exactly why a fixture that
// asserted only two of them would leave the third free to drift.
//
// ⚠ THE EXPECTATIONS ARE WRITTEN-OUT CONSTANTS, DERIVED BY HAND, NOT READ OFF A
// RUN — the discipline `query_minmax_float_seed_leak` states: an oracle that
// computes the answer by folding just reproduces whichever fold it was written
// with, and a differential is blind when both sides implement the same wrong
// thing. By hand, over the group's rows in first-occurrence order:
//   g=0  { true, true, true, false }  → (1.0+1.0+1.0+0.0)/4 = 3.0/4 = 0.75
//   g=1  { true }                     → 1.0/1               = 1.0
//   g=2  { false }                    → 0.0/1               = 0.0
// All three are exact in binary f64 (3/4 = 0.11₂), so `==` is the right compare
// and no tolerance is involved.
//
// ⚠ 0.0 GETS ITS OWN EXIT CODE, per engine. The dynamic tier reads a cell as f64
// through `rt_f`, whose `bool` arm did not exist: every bool read as 0.0 while
// `rt_i` — the same value, the other spelling — already answered 1. A fix that
// admits bool in the table but not in `rt_f` makes the dynamic engine ACCEPT the
// query and silently answer 0.0. That failure must be legible AS ITSELF and not
// as a generic mismatch, so it is asserted before the general compare.
//
// exit 0 = static, dynamic and incremental all answer 0.75 / 1.0 / 0.0.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.wql.wql;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

struct S { pub g: i64, pub b: bool }
pub schema SB : code(0x0E44_0000_0000_0001) { g: i64 = 0, b: bool = 1 }
resource cat = schema_catalog!{ SB };

pub deem q_avg(ss: &[S]) { from ss s group by s.g aggregate a = avg(s.b) select a : f64 }

// The 3-of-4-true shape, plus a singleton true and a singleton false so that
// true→1.0 and false→0.0 are each pinned on their own and not only through the
// quotient.
fn rows() -> Vec<S> {
    let mut v: Vec<S> = vec_new::<S>();
    v.push(S { g: 0i64, b: true  });
    v.push(S { g: 0i64, b: true  });
    v.push(S { g: 0i64, b: true  });
    v.push(S { g: 0i64, b: false });
    v.push(S { g: 1i64, b: true  });
    v.push(S { g: 2i64, b: false });
    return v;
}

fn mkR(d: &Writ, g: i64, b: bool) -> WAny {
    let r: SB = d.make::<SB>(); r.g = g; r.b = b;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn wsrc(d: &Writ, ss: &Vec<S>) -> WAny {
    let n: i64 = ss.len();
    let arr: &mut WArray<WAny> = d.array(n + 1i64);
    let mut i: i64 = 0i64;
    while i < n { arr.push(mkR(d, ss.get(i).g, ss.get(i).b)); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}

fn main() -> i32 {
    let c: SchemaCatalog = cat();
    let ss: Vec<S> = rows();
    let d: Writ = writ_new(8192i64);
    let mut e: QEnv = QEnv::new();
    e.bind_source("ss", wsrc(&d, &ss));

    // ── ENGINE 1: the static `deem!` emitter ────────────────────────────────
    let sv: Vec<f64> = match q_avg(ss.as_slice()) {
        Result::Ok(v)  => { v }
        Result::Err(_e) => { return 10i32; }
    };
    if sv.len() != 3i64                { return 11i32; }
    if sv.get(0i64) == 0.0f64          { return 12i32; }   // the 0.0 signature
    if sv.get(0i64) != 0.75f64         { return 13i32; }
    if sv.get(1i64) != 1.0f64          { return 14i32; }
    if sv.get(2i64) != 0.0f64          { return 15i32; }

    // ── ENGINE 2: the dynamic `Query::compile` interpreter ──────────────────
    let dq: Query = match Query::compile("from ss s group by s.g aggregate a = avg(s.b) select a", &c) {
        Result::Ok(q)   => { q }
        Result::Err(_e) => { return 20i32; }
    };
    let dr: QRows = match dq.run(&e) {
        Result::Ok(r)   => { r }
        Result::Err(_e) => { return 21i32; }
    };
    if dr.row_count() != 3i64          { return 22i32; }
    if dr.get_f64(0i64, 0i64) == 0.0f64 { return 23i32; }  // the `rt_f` bool-arm signature
    if dr.get_f64(0i64, 0i64) != 0.75f64 { return 24i32; }
    if dr.get_f64(1i64, 0i64) != 1.0f64  { return 25i32; }
    if dr.get_f64(2i64, 0i64) != 0.0f64  { return 26i32; }

    // ── ENGINE 3: the incremental (DBSP) engine, read at the base epoch ─────
    // `select (key, a)` is the aggregate shape the incremental fragment admits;
    // column 1 is the aggregate, column 0 the group key.
    let iq: Query = match Query::compile("from ss s group by s.g aggregate a = avg(s.b) select (key, a)", &c) {
        Result::Ok(q)   => { q }
        Result::Err(_e) => { return 30i32; }
    };
    let eng: IncrJoin = match iq.incremental(&e) {
        Result::Ok(g)   => { g }
        Result::Err(_e) => { return 31i32; }
    };
    if eng.had_error()                 { return 32i32; }
    let ir: QRows = eng.snapshot();
    if ir.row_count() != 3i64          { return 33i32; }
    if ir.get_f64(0i64, 1i64) == 0.0f64 { return 34i32; }
    if ir.get_f64(0i64, 1i64) != 0.75f64 { return 35i32; }
    if ir.get_f64(1i64, 1i64) != 1.0f64  { return 36i32; }
    if ir.get_f64(2i64, 1i64) != 0.0f64  { return 37i32; }

    return 0i32;
}
