// pmap_find_iter.logos — search returning (iter, pos, hit).
//
// `pmap_view_find` is the canonical entry-point: lower-bound walk
// from the root, returning a positioned LeafIter, the in-leaf slot,
// and an exact-match flag. Iterator carries no record cursor; the
// caller walks j from `pos` over leaf.keys / leaf.vals (and resets
// j=0 on every leaf transition). Covers four cases:
//   • exact hit in middle leaf
//   • miss in middle (pos points at next-greater)
//   • before-start (pos=0 in first leaf)
//   • past-end (pos == leaf.keys.len() in last leaf)

package main;

use std.data.persistent.view;
use std.data.persistent.mutv;
use std.data.persistent.btree;
use std.data.persistent.iter;
use std.data.persistent.cfg;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.compiler.metaprog;
use std.hermes.ctr;
use std.hermes.view;
use std.hermes.anyval;

pub struct U64Key { pub x: u64, }
impl Primitive for U64Key { type Prim = u64; }
impl Ord for U64Key {
    fn cmp(&self, other: &Self) -> Ordering {
        if self.x < other.x { return Ordering::Less; }
        if self.x > other.x { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

pub struct U64Val { pub x: u64, }
impl Primitive for U64Val { type Prim = u64; }

fn ki(v: u64) -> U64Key { return U64Key { x: v }; }

pub const Cfg4: HermesStatic = @{
    "key":    <type:U64Key>,
    "value":  <type:U64Val>,
    "fanout": 4,
};

pub type MyView = PMapView<Cfg4>;
pub type MyMap  = PMapMut<Cfg4>;

unsafe fn main() -> i32 {
    let cfg: HermesStatic = @{
        "key": <type:U64Key>, "value": <type:U64Val>, "fanout": 4,
    };
    if validate_pmap_cfg(cfg) != 0 { return 1; }

    let mut pm: MyMap = pmap_mut_new::<Cfg4>(0u64, 0u64, 0 as *mut u64);
    let pmptr: *mut MyMap = &mut pm as *mut MyMap;

    // 16 keys: 10, 20, ..., 160. fanout=4 ⇒ multi-leaf.
    let mut i: u64 = 0u64;
    while i < 16u64 {
        let v: u64 = (i + 1u64) * 10u64;
        let k: U64Key = ki(v);
        let _ = pmap_mut_insert::<Cfg4>(pmptr, v, v * 7u64, &k as *const U64Key);
        i = i + 1u64;
    }
    if pm.view.len() != 16u64 { return 2; }

    // ── Case 1: exact hit, then forward range walk from pos. ─────
    let k70: U64Key = ki(70u64);
    let mut f1: Found<U64Key, U64Val, Cfg4> = pmap_view_find::<Cfg4>(&pm.view as *const MyView, &k70 as *const U64Key);
    if !f1.hit { return 10; }
    {
        let it1p: *const LeafIter<U64Key, U64Val, Cfg4> = &f1.it as *const LeafIter<U64Key, U64Val, Cfg4>;
        let leaf1: *mut LeafNode<U64Key, U64Val, Cfg4> = leaf_iter_leaf::<U64Key, U64Val, Cfg4>(it1p);
        if leaf1.keys.get(f1.pos) != 70u64 { return 11; }
        if leaf1.vals.get(f1.pos) != 490u64 { return 12; }
    }

    // Walk forward from f1.pos: should cover 70, 80, ..., 160 (10 keys).
    let it1m: *mut LeafIter<U64Key, U64Val, Cfg4> = &mut f1.it as *mut LeafIter<U64Key, U64Val, Cfg4>;
    let mut walked: u64 = 0u64;
    let mut sum: u64 = 0u64;
    let mut j: u64 = f1.pos;
    while leaf_iter_valid::<U64Key, U64Val, Cfg4>(it1m as *const LeafIter<U64Key, U64Val, Cfg4>) {
        let leaf: *mut LeafNode<U64Key, U64Val, Cfg4> = leaf_iter_leaf::<U64Key, U64Val, Cfg4>(it1m as *const LeafIter<U64Key, U64Val, Cfg4>);
        let n: u64 = leaf.keys.len();
        while j < n {
            sum = sum + leaf.keys.get(j);
            walked = walked + 1u64;
            j = j + 1u64;
        }
        leaf_iter_next_leaf::<U64Key, U64Val, Cfg4>(it1m);
        j = 0u64;
    }
    if walked != 10u64 { return 13; }
    // 70 + 80 + ... + 160 = 10 * (70+160)/2 = 1150.
    if sum != 1150u64 { return 14; }
    pmap_view_release_leaf_iter::<Cfg4>(it1m);

    // ── Case 2: miss in middle (between 70 and 80). ──────────────
    let k75: U64Key = ki(75u64);
    let mut f2: Found<U64Key, U64Val, Cfg4> = pmap_view_find::<Cfg4>(&pm.view as *const MyView, &k75 as *const U64Key);
    if f2.hit { return 20; }
    {
        let leaf2: *mut LeafNode<U64Key, U64Val, Cfg4> = leaf_iter_leaf::<U64Key, U64Val, Cfg4>(&f2.it as *const LeafIter<U64Key, U64Val, Cfg4>);
        if f2.pos >= leaf2.keys.len() { return 21; }
        if leaf2.keys.get(f2.pos) != 80u64 { return 22; }
    }
    pmap_view_release_leaf_iter::<Cfg4>(&mut f2.it as *mut LeafIter<U64Key, U64Val, Cfg4>);

    // ── Case 3: before-start (smaller than every key). ───────────
    let k5: U64Key = ki(5u64);
    let mut f3: Found<U64Key, U64Val, Cfg4> = pmap_view_find::<Cfg4>(&pm.view as *const MyView, &k5 as *const U64Key);
    if f3.hit { return 30; }
    if f3.pos != 0u64 { return 31; }
    {
        let leaf3: *mut LeafNode<U64Key, U64Val, Cfg4> = leaf_iter_leaf::<U64Key, U64Val, Cfg4>(&f3.it as *const LeafIter<U64Key, U64Val, Cfg4>);
        if leaf3.keys.get(0u64) != 10u64 { return 32; }
    }
    pmap_view_release_leaf_iter::<Cfg4>(&mut f3.it as *mut LeafIter<U64Key, U64Val, Cfg4>);

    // ── Case 4: past-end (larger than every key). ────────────────
    let k200: U64Key = ki(200u64);
    let mut f4: Found<U64Key, U64Val, Cfg4> = pmap_view_find::<Cfg4>(&pm.view as *const MyView, &k200 as *const U64Key);
    if f4.hit { return 40; }
    {
        let leaf4: *mut LeafNode<U64Key, U64Val, Cfg4> = leaf_iter_leaf::<U64Key, U64Val, Cfg4>(&f4.it as *const LeafIter<U64Key, U64Val, Cfg4>);
        if f4.pos != leaf4.keys.len() { return 41; }
        // Last key in the rightmost leaf is 160.
        if leaf4.keys.get(leaf4.keys.len() - 1u64) != 160u64 { return 42; }
    }
    pmap_view_release_leaf_iter::<Cfg4>(&mut f4.it as *mut LeafIter<U64Key, U64Val, Cfg4>);

    // ── Binary-leaf variant: must agree with linear on all 4 cases. ─
    let probes: [u64; 4] = [70u64, 75u64, 5u64, 200u64];
    let mut p: u64 = 0u64;
    while p < 4u64 {
        let kp: U64Key = ki(probes[p]);
        let mut fl: Found<U64Key, U64Val, Cfg4> = pmap_view_find::<Cfg4>(&pm.view as *const MyView, &kp as *const U64Key);
        let mut fb: Found<U64Key, U64Val, Cfg4> = pmap_view_find_binary::<Cfg4>(&pm.view as *const MyView, &kp as *const U64Key);
        if fl.hit != fb.hit { return 50; }
        if fl.pos != fb.pos { return 51; }
        let leafL: *mut LeafNode<U64Key, U64Val, Cfg4> = leaf_iter_leaf::<U64Key, U64Val, Cfg4>(&fl.it as *const LeafIter<U64Key, U64Val, Cfg4>);
        let leafB: *mut LeafNode<U64Key, U64Val, Cfg4> = leaf_iter_leaf::<U64Key, U64Val, Cfg4>(&fb.it as *const LeafIter<U64Key, U64Val, Cfg4>);
        // Same leaf ⇒ same first key (cheap structural check).
        if leafL.keys.len() != leafB.keys.len() { return 52; }
        if leafL.keys.len() > 0u64 {
            if leafL.keys.get(0u64) != leafB.keys.get(0u64) { return 53; }
        }
        pmap_view_release_leaf_iter::<Cfg4>(&mut fl.it as *mut LeafIter<U64Key, U64Val, Cfg4>);
        pmap_view_release_leaf_iter::<Cfg4>(&mut fb.it as *mut LeafIter<U64Key, U64Val, Cfg4>);
        p = p + 1u64;
    }

    pmap_mut_drop::<Cfg4>(pmptr);
    return 0;
}
