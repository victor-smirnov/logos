// Empty subtype params must canonicalize:
//   @Type=...  ==  @Type()=...  ==  @Type( )=...
package hermes_typed_datatype_empty_params_canonical;

use hermes.ctr;
use hermes.anyval;
use hermes.typetag;
use hermes.datatag;
use hermes.registry;
use hermes.stringify;
use hermes.equal;
use hermes.hashing;
use std.string;

unsafe fn main() -> i32 {
    let mut d1: Hermes = Hermes::new(1024);
    match d1.parse("@I64=42" as *const u8, 7 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 1; }
    }

    let mut d2: Hermes = Hermes::new(1024);
    match d2.parse("@I64()=42" as *const u8, 9 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 2; }
    }

    let mut d3: Hermes = Hermes::new(1024);
    match d3.parse("@I64( )=42" as *const u8, 10 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 3; }
    }

    let r1: AnyVal = d1.root();
    let r2: AnyVal = d2.root();
    let r3: AnyVal = d3.root();
    if !r1.is_ptr() || !r2.is_ptr() || !r3.is_ptr() { return 4; }

    let o1: *const u8 = (d1.base() as i64 + r1.as_offset() as i64) as *const u8;
    let o2: *const u8 = (d2.base() as i64 + r2.as_offset() as i64) as *const u8;
    let o3: *const u8 = (d3.base() as i64 + r3.as_offset() as i64) as *const u8;
    if read_type_code(o1) != 4115 as u64 || read_type_code(o2) != 4115 as u64 || read_type_code(o3) != 4115 as u64 {
        return 5;
    }

    let fe: fn(*const u8, *const u8, *mut EqualCtx) -> bool = hermes_fn_equal(4115 as u64);
    if (fe as *const u8) == 0 as *const u8 { return 6; }
    let mut eq12: EqualCtx = EqualCtx { base_self: d1.base(), base_other: d2.base() };
    let mut eq13: EqualCtx = EqualCtx { base_self: d1.base(), base_other: d3.base() };
    if !fe(o1, o2, &mut eq12) { return 7; }
    if !fe(o1, o3, &mut eq13) { return 8; }

    let fh: fn(*const u8, *mut HashCtx) -> u64 = hermes_fn_hash(4115 as u64);
    if (fh as *const u8) == 0 as *const u8 { return 9; }
    let mut h1c: HashCtx = HashCtx { base: d1.base() };
    let mut h2c: HashCtx = HashCtx { base: d2.base() };
    let mut h3c: HashCtx = HashCtx { base: d3.base() };
    let h1: u64 = fh(o1, &mut h1c);
    let h2: u64 = fh(o2, &mut h2c);
    let h3: u64 = fh(o3, &mut h3c);
    if h1 != h2 || h1 != h3 { return 10; }

    let s2: String = d2.to_string();
    let s3: String = d3.to_string();
    if !s2.eq_str("@I64 = 42") { return 11; }
    if !s3.eq_str("@I64 = 42") { return 12; }

    return 0;
}
