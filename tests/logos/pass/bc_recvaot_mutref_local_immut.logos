// 2026-09-05a: ex-soundness-queue row mutref_recv_immut_binding — an IMMUTABLE local holding &mut S calls a &mut self method (a reborrow needs no 'mut' on the binding).
package bc_recvaot_mutref_local_immut;
struct S { v: i64 }
impl S {
    fn get(&mut self) -> &mut i64 { return &mut self.v; }
}
fn main() -> i32 {
    let mut s: S = S { v: 1i64 };
    let sr: &mut S = &mut s;
    let r: &mut i64 = sr.get();
    *r = 9i64;
    if s.v != 9i64 { return 1i32; }
    return 0i32;
}
