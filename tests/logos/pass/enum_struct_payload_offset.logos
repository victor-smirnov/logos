// Regression: a struct payload field in a multi-field enum variant must not
// alias the variant's later payload slots. The constructor memcpy's an
// aggregate payload field inline (its full ABI byte size), but the payload
// struct type used for field GEPs was built from the collapsed `ptr`
// field-types — so a struct field reserved only 8 bytes, the field after it
// landed at offset 8 (inside the struct), and reading the struct's 2nd field
// returned the next payload slot. Now the payload struct type uses the inline
// aggregate type so offsets match the memcpy footprint. Covers struct-then-
// scalar, struct-then-struct, and the single-struct regression.
package enum_struct_payload_offset;

struct P { x: i64, y: i64 }
enum E {
    Two(P, i64),
    Pair(P, P),
    One(P),
}

fn main() -> i32 {
    match E::Two(P { x: 10i64, y: 20i64 }, 99i64) {
        E::Two(p, z) => {
            if p.x != 10i64 { return 1i32; }
            if p.y != 20i64 { return 2i32; }   // <- the bug: returned z (99)
            if z != 99i64 { return 3i32; }
        }
        _ => { return 10i32; }
    }
    match E::Pair(P { x: 1i64, y: 2i64 }, P { x: 3i64, y: 4i64 }) {
        E::Pair(p, q) => {
            if p.x != 1i64 { return 4i32; }
            if p.y != 2i64 { return 5i32; }
            if q.x != 3i64 { return 6i32; }
            if q.y != 4i64 { return 7i32; }
        }
        _ => { return 11i32; }
    }
    match E::One(P { x: 7i64, y: 8i64 }) {
        E::One(p) => {
            if p.x != 7i64 { return 8i32; }
            if p.y != 8i64 { return 9i32; }
        }
        _ => { return 12i32; }
    }
    return 0i32;
}
