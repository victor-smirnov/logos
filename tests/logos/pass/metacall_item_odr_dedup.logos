// MC2.5: two metacalls emitting body-equal struct definitions should
// dedup, not collide. SRC_LINE is excluded from ODR equality so items
// quoted at different source lines still match.

package main;

use logos.std.compiler.metaprog;
use logos.lang.hermes2.hstatic;

fn emit_a() -> QuoteItemBlob {
    return quote_item! {
        struct Synth { x: i32 }
    };
}

fn emit_b() -> QuoteItemBlob {
    return quote_item! {
        struct Synth { x: i32 }
    };
}

metacall emit_a();
metacall emit_b();

unsafe fn main() -> i32 {
    let s: Synth = Synth { x: 42 };
    return s.x;
}
