// THE `move` BOUNDARY. A `move` closure OWNS its captures, so its body operates
// on env COPIES and must NOT be read in the enclosing frame's namespace: `tick`
// mutates its own copy of `counter`, and the OUTER `counter` is untouched (0).
// ⚠ THE NAME IS NOW HALF FALSE AND IS KEPT SO THE HISTORY IS FINDABLE. The
// `move` body IS walked as of 2026-08-31p (`capmovewalk`, 2 rows); what this
// fixture pins is the half that did NOT change — the walk resolves the body's
// names in the CLOSURE's frame, so the OUTER `counter` is untouched (0). The
// 2026-08-29 sentence it used to carry ("walking both arms prices identically")
// was measured against a ledger that no longer exists; a ceiling decays.
package bc_capbody_move_body_not_walked_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
fn main() -> i32 {
    let mut counter: i64 = 0i64;
    let mut tick = move || -> i64 { counter = counter + 1i64; return counter; };
    let v1: i64 = tick();
    let v2: i64 = tick();
    printi("v=%ld\n", v1 + v2 + counter);
    return 0i32;
}
