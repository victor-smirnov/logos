// Writ residency/escape: a document built in make_doc() OUTLIVES that scope —
// the returned Held<WArray<WAny>> carries a holder (Rc clone) that keeps the
// container's segments alive. The container drops (frees segments) only when the
// last holder drops (here at main's end).
package test;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.rc;

// The projection `hold` applies to the held container: the document root, read
// back from the container itself.
fn root_array(w: &Writ) -> &WArray<WAny> { return w.array_of(w.root()); }

fn make_doc() -> Held<WArray<WAny>> {
    let h: Rc<Writ> = writ_rc(48i64);
    let root: &mut WArray<WAny> = h.array(2i64);     // build via Rc (auto-deref)
    root.push(WAny::from(10));
    root.push(WAny::from(20));
    root.push(WAny::from(30));             // forces a grow too
    h.set_root(WAny::from(&*root));
    return hold(&h, root_array);              // escape: carry the holder
    // local `h` drops here (-1); the Held's holder keeps the container alive
}

fn main() -> i32 {
    let doc: Held<WArray<WAny>> = make_doc();         // container outlived make_doc
    let r: &WArray<WAny> = doc.get();
    if r.len() != 3i64 { return 1; }
    let mut sum: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < r.len() { sum = sum + r.get(i).as_i56(); i = i + 1i64; }
    if sum != 60i64 { return 2; }                  // 10+20+30
    return 0;
    // doc drops → holder Rc → count 0 → Writ Drop → segments freed
}
