// Boxed wide scalars in hermes2 zones (successor of the Hermes1 scalar test):
// I64/U64 beyond the inline range, boxed via the container; reads see through.
package hermes_scalar;
use logos.lang.hermes2.container;
use logos.lang.hermes2.allocator;
use logos.lang.hermes2.anyval;
use logos.lang.hermes2.hmap;
use logos.lang.hermes2.hstring;
use logos.mem.hermes2.stringify;
use logos.mem.rc;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    let c: Rc<Hermes2> = hermes2_rc(8192);
    let h: &Hermes2 = c.deref();
    let hp: *mut Hermes2 = h as *const Hermes2 as *mut Hermes2;
    let ap: *mut Allocator = &mut hp.allocator as *mut Allocator;

    let big_i: i64 = 9000000000i64;             // beyond i24/i32
    let big_u: u64 = 18000000000u64;

    // make_int picks inline Pod vs boxed by range.
    let small: HAny = make_int(ap, 7i64);
    if !small.is_pod() { return 1; }
    if small.as_i64() != 7i64 { return 2; }
    let bi: HAny = make_int(ap, big_i);
    if bi.is_pod() && bi.as_i64() != big_i { return 3; }
    if bi.as_i64() != big_i { return 4; }

    let bu: HAny = box_u64(ap, big_u);
    if bu.is_pod() { return 5; }
    if bu.as_u64() != big_u { return 6; }
    if h2_type_code(bu.resolve()) != H2_U64 { return 7; }

    // Inside a map; stringify renders values.
    let m: &mut HMap<HString, HVal> = h.map(8);
    m.set("i", bi);
    m.set("u", bu);
    let mv: HAny = (&*(m as *const HMap<HString, HVal>)).get("i");
    if mv.as_i64() != big_i { return 8; }
    let s: String = stringify((&*(m as *const HMap<HString, HVal>)).get("u"));
    if !s.eq_str("18000000000") { return 9; }

    return 0;
}
