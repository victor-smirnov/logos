// Phase 1B-6: GENERIC_REF (`IDENT::<TARGS>` as fn-pointer value) honours
// per-arg `unsized_ok_` based on the target fn's `?Sized` type params.
// `take_ref::<[u8]>` (without parens) yields a fn-pointer with the
// unsized substitution applied; calling that pointer routes through
// the same Ref/Ptr→Slice canonicalisation as direct call sites.

package relaxed_sized_generic_ref;

fn take_ref<T: ?Sized>(x: &T) -> i32 {
    return 23;
}

unsafe fn main() -> i32 {
    let buf: [u8; 2] = [1, 2];
    let s: &[u8] = &buf;
    // Capture as fn-pointer with explicit unsized turbofish.
    let fp: fn(&[u8]) -> i32 = take_ref::<[u8]>;
    return fp(s) - 23;
}
