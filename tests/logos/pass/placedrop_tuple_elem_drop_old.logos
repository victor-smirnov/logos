// `t.0 = new` DROPS THE OLD ELEMENT. Was soundness-queue row
// assign_tuple_elem_no_drop_old (tier 1, `run 1`): the place-assign liveness was
// computed for `la::FIELD_READ` alone, so a TUPLE_INDEX place always stored with
// drop_old = false and the old element leaked.
// COUNT = 1 (old t.0, at the store) + 1000 (new t.0) + 10 (t.1) = 1011.
// PAIR: placedrop_tuple_elem_moved_container_fail, one token apart (`u` -> `t`).
package placedrop_tuple_elem_drop_old;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut r: i64 = 0i64;
    {
        let mut t: (D, D) = (D { v: 1i64, c: p }, D { v: 10i64, c: p });
        t.0 = D { v: 1000i64, c: p };
        r = t.0.v;
    }
    if r != 1000i64 { return 2i32; }
    unsafe { printf("%ld\n".as_ptr(), n); }
    return 0i32;
}
