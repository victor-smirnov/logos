// CP-cm-08: tuple == / != compares fields, not the by-pointer ABI.
// Limitation: primitive-only fields today; str / nested-tuple / struct
// fields still hit the historic pointer-cmp behaviour.

package tuple_eq_op;

fn main() -> i32 {
    let a: (i32, bool) = (1i32, true);
    let b: (i32, bool) = (1i32, true);
    if !(a == b) { return 1i32; }
    if a != b { return 2i32; }

    let c: (i32, bool) = (1i32, false);
    if a == c { return 3i32; }
    if !(a != c) { return 4i32; }

    let d: (i32, bool) = (2i32, true);
    if a == d { return 5i32; }

    // i32, i64, f64, char, bool — all primitive variants.
    let e: (i32, i64, f64) = (1i32, 2i64, 3.0f64);
    let f: (i32, i64, f64) = (1i32, 2i64, 3.0f64);
    if !(e == f) { return 6i32; }

    let g: (i32, i64, f64) = (1i32, 2i64, 4.0f64);
    if e == g { return 7i32; }

    return 0i32;
}
