// Hermes — direct-reference surface (no handle/view wrapper): the client holds a
// `&mut HArray<HAny>` to an array living in the never-move arena, used like a Vec
// (a.push/a.get/a.len). Allocation is interior-mutability (`h.array(&h)`,
// bumpalo-style), so two arrays coexist. Typed HAny::from(i56)/from(bool).
// FULLY safe: zero `unsafe`/raw pointer in user code.
package test;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.array;
fn main() -> i32 {
    let h: Hermes = hermes_new(48i64);
    let nested: &mut HArray<HAny> = h.array(2i64);
    nested.push(HAny::from(1i64));
    nested.push(HAny::from(2i64));
    nested.push(HAny::from(3i64));
    let root: &mut HArray<HAny> = h.array(2i64);
    root.push(HAny::from(10i64));
    root.push(HAny::from(20i64));
    root.push(HAny::from(true));
    if root.len() != 3i64 { return 1; }
    let mut s: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < root.len() {
        let e: HAny = root.get(i);
        if e.is_i56() { s = s + e.as_i56(); }
        i = i + 1i64;
    }
    if s != 30i64 { return 2; }
    let mut ns: i64 = 0i64;
    i = 0i64;
    while i < nested.len() {
        ns = ns + nested.get(i).as_i56();
        i = i + 1i64;
    }
    if ns != 6i64 { return 3; }
    return 0;
}
