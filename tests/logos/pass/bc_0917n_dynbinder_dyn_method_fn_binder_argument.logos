// Closed soundness-queue row dyn_method_fn_binder_argument_refuses (was tier 3).
// try_method_on_dyn compared the argument against the callee's BINDER `'q` by name and
// carried `'q` into the return type; it now instantiates both through the one map
// (inst_call_params_ / subst_call_ret_lts_), as the free-fn and method paths do.
// rustc 1.98.1 --edition 2024: COMPILES and RUNS exit 0 (twin measured this round).
package bc_0917n_dynbinder_dyn_method_fn_binder_argument;

trait P {
    fn pick<'q>(&self, x: &'q i64) -> &'q i64;
}

struct S { k: i64 }

impl P for S {
    fn pick<'q>(&self, x: &'q i64) -> &'q i64 {
        let _u: i64 = self.k;
        return x;
    }
}

fn store<'a>(d: &dyn P, p: &'a i64, out: &mut &'a i64) {
    *out = d.pick(p);
}

fn main() -> i32 {
    let s: S = S { k: 0i64 };
    let w: i64 = 70i64;
    let z: i64 = 0i64;
    let mut r: &i64 = &z;
    store(&s, &w, &mut r);
    if *r != 70i64 { return 1i32; }
    return 0i32;
}
