// CLOSED soundness_queue row enum_eq_operand_temp_never_dropped (tier 1), round 2026-09-14o-autoreffund.
// An enum `==` whose right operand is a variant rvalue with a droppable payload: take_operand_ref spilled it with no owner
// (n=1). Now owned by the statement temp scope. Oracle: destructor count 1001, exit 0.
package bc_autoreffund_enum_eq_temp_dropped_admit;
use logos.lang.cmp;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
impl Eq for D { fn eq(&self, other: &D) -> bool { return self.v > 0i64 && other.v > 0i64; } }
fn mk(v: i64, c: *mut i64) -> D { return D { v: v, c: c }; }
enum E { A(D), B }
impl Eq for E { fn eq(&self, other: &E) -> bool { return true; } }
fn body(p: *mut i64) -> i64 {
    let e: E = E::A(D { v: 1i64, c: p });
    if !(e == E::A(D { v: 1000i64, c: p })) { return 3i64; }
    return 0i64;
}

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = body(p);
    let got: i64 = unsafe { n };
    unsafe { printf("n=%ld r=%ld\n".as_ptr(), got, r); }
    if r != 0i64 { return 2i32; }
    if got != 1001i64 { return 1i32; }
    return 0i32;
}
