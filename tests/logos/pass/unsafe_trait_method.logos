package unsafe_trait_method;
// unsafe fn in trait definition and impl

trait Dangerous {
    unsafe fn do_it(self: Self) -> i32;
}

struct Bomb { val: i32; }

impl Dangerous for Bomb {
    unsafe fn do_it(self: Bomb) -> i32 {
        return self.val;
    }
}

unsafe fn main() -> i32 {
    let b = Bomb { val: 33 };
    let v: i32 = unsafe { b.do_it(); };
    return v;
}
