//
// hermes_round_trip — parse a non-trivial Hermes document, stringify it,
// and print the result to stdout.
//
// Input document (compact form, 70 bytes):
//   {name:"widget",version:42,active:true,count:7_s8,tags:["fast","safe"]}
//
// Expected: program exits 0 and prints the stringified form.
// (Map key order depends on FNV-1a hash, so the .expected file only checks
//  the exit code.  Observe the actual output while polishing the impl.)

package hermes_round_trip;

use hermes.zone;
use hermes.anyval;
use hermes.string;
use hermes.typetag;
use hermes.array;
use hermes.map;
use hermes.typed_value;
use hermes.objectmap;
use hermes.document;
use hermes.parser;
use hermes.stringify;
use std.string;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);
// POSIX write: fd=1 → stdout
extern fn write(fd: i32, buf: *const u8, count: i64) -> i64;

// ---------------------------------------------------------------------------
// wb — write a single byte into a raw buffer at a given offset.
// ---------------------------------------------------------------------------

unsafe fn wb(buf: *mut u8, i: i64, v: u8) {
    *((buf as i64 + i) as *mut u8) = v;
}

// ---------------------------------------------------------------------------
// build_input — fill `buf` with the Hermes source text, return byte count.
//
// Text (70 bytes):
//   {name:"widget",version:42,active:true,count:7_s8,tags:["fast","safe"]}
// ---------------------------------------------------------------------------

unsafe fn build_input(buf: *mut u8) -> i64 {
    // { n a m e : " w i d g e t "
    wb(buf,  0, 123 as u8);  // {
    wb(buf,  1, 110 as u8);  // n
    wb(buf,  2, 97  as u8);  // a
    wb(buf,  3, 109 as u8);  // m
    wb(buf,  4, 101 as u8);  // e
    wb(buf,  5, 58  as u8);  // :
    wb(buf,  6, 34  as u8);  // "
    wb(buf,  7, 119 as u8);  // w
    wb(buf,  8, 105 as u8);  // i
    wb(buf,  9, 100 as u8);  // d
    wb(buf, 10, 103 as u8);  // g
    wb(buf, 11, 101 as u8);  // e
    wb(buf, 12, 116 as u8);  // t
    wb(buf, 13, 34  as u8);  // "
    // , v e r s i o n : 4 2
    wb(buf, 14, 44  as u8);  // ,
    wb(buf, 15, 118 as u8);  // v
    wb(buf, 16, 101 as u8);  // e
    wb(buf, 17, 114 as u8);  // r
    wb(buf, 18, 115 as u8);  // s
    wb(buf, 19, 105 as u8);  // i
    wb(buf, 20, 111 as u8);  // o
    wb(buf, 21, 110 as u8);  // n
    wb(buf, 22, 58  as u8);  // :
    wb(buf, 23, 52  as u8);  // 4
    wb(buf, 24, 50  as u8);  // 2
    // , a c t i v e : t r u e
    wb(buf, 25, 44  as u8);  // ,
    wb(buf, 26, 97  as u8);  // a
    wb(buf, 27, 99  as u8);  // c
    wb(buf, 28, 116 as u8);  // t
    wb(buf, 29, 105 as u8);  // i
    wb(buf, 30, 118 as u8);  // v
    wb(buf, 31, 101 as u8);  // e
    wb(buf, 32, 58  as u8);  // :
    wb(buf, 33, 116 as u8);  // t
    wb(buf, 34, 114 as u8);  // r
    wb(buf, 35, 117 as u8);  // u
    wb(buf, 36, 101 as u8);  // e
    // , c o u n t : 7 _ s 8
    wb(buf, 37, 44  as u8);  // ,
    wb(buf, 38, 99  as u8);  // c
    wb(buf, 39, 111 as u8);  // o
    wb(buf, 40, 117 as u8);  // u
    wb(buf, 41, 110 as u8);  // n
    wb(buf, 42, 116 as u8);  // t
    wb(buf, 43, 58  as u8);  // :
    wb(buf, 44, 55  as u8);  // 7
    wb(buf, 45, 95  as u8);  // _
    wb(buf, 46, 115 as u8);  // s
    wb(buf, 47, 56  as u8);  // 8
    // , t a g s : [ " f a s t " , " s a f e " ] }
    wb(buf, 48, 44  as u8);  // ,
    wb(buf, 49, 116 as u8);  // t
    wb(buf, 50, 97  as u8);  // a
    wb(buf, 51, 103 as u8);  // g
    wb(buf, 52, 115 as u8);  // s
    wb(buf, 53, 58  as u8);  // :
    wb(buf, 54, 91  as u8);  // [
    wb(buf, 55, 34  as u8);  // "
    wb(buf, 56, 102 as u8);  // f
    wb(buf, 57, 97  as u8);  // a
    wb(buf, 58, 115 as u8);  // s
    wb(buf, 59, 116 as u8);  // t
    wb(buf, 60, 34  as u8);  // "
    wb(buf, 61, 44  as u8);  // ,
    wb(buf, 62, 34  as u8);  // "
    wb(buf, 63, 115 as u8);  // s
    wb(buf, 64, 97  as u8);  // a
    wb(buf, 65, 102 as u8);  // f
    wb(buf, 66, 101 as u8);  // e
    wb(buf, 67, 34  as u8);  // "
    wb(buf, 68, 93  as u8);  // ]
    wb(buf, 69, 125 as u8);  // }
    return 70 as i64;
}

// ---------------------------------------------------------------------------
// print_buf — write all bytes of `sb` to stdout, followed by a newline.
// ---------------------------------------------------------------------------

unsafe fn print_buf(sb: *mut String) {
    write(1 as i32, sb.as_ptr(), sb.len());
    let nl: u8 = 10 as u8;
    write(1 as i32, &nl as *const u8, 1 as i64);
}

// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------

unsafe fn main() -> i32 {
    // ── Build input ──────────────────────────────────────────────────────────
    let ibuf: *mut u8 = malloc(128);
    if ibuf == 0 as *mut u8 { return 2; }
    let ilen: i64 = build_input(ibuf);

    // ── Parse ────────────────────────────────────────────────────────────────
    let mut zone: Zone<Mutable> = zone_create(8192);
    let ok: bool = hermes_parse(ibuf as *const u8, ilen, &mut zone);
    free(ibuf);
    if !ok {
        // zone is cleaned up by Drop
        return 1;
    }

    // ── Stringify ────────────────────────────────────────────────────────────
    let mut sb: String = String::new();
    stringify_document(zone.holder.base as *const u8, &mut sb, StringifyOpts::compact());

    // ── Print ────────────────────────────────────────────────────────────────
    print_buf(&mut sb);

    // ── Cleanup ──────────────────────────────────────────────────────────────
    // zone is cleaned up by Drop
    return 0;
}
