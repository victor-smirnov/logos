// query_rec_agg_batch_e2e — regression for the batch dynamic executor dropping
// EVERY row of a recursive semilattice-aggregate rel (SSSP / widest-path).
// Root cause (fixed): Query::run built the per-rel row/shadow state but never
// allocated the per-rel champion (best) map that qrel_push_agg absorbs into, so
// for a `group by … aggregate d = min(…)` recursive rel best_i==0 and the push
// early-returned — the rel materialized NOTHING and run() silently returned zero
// rows, while the static deem! codegen and the incremental engine were correct.
//
// This asserts the DYNAMIC Query::run result equals the STATIC deem! result
// (the oracle that was already correct) for SSSP (min,+) and widest-path
// (max,min) over a chain, a branch, and a cycle. Rows (node,dist) are encoded
// node*1000+dist and compared as a sorted multiset. Exit 0 iff every graph
// agrees on both aggregates.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.wql.wql;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

// dynamic (schema Writ rows)
pub schema Src  : code(0x0DF3_0000_0000_0001) { id: i64 = 0 }
pub schema Edge : code(0x0DF3_0000_0000_0002) { src: i64 = 0, dst: i64 = 1, w: i64 = 2 }
resource cat = schema_catalog!{ Src, Edge };
// static (plain structs)
struct SS { pub id: i64 }
struct SE { pub src: i64, pub dst: i64, pub w: i64 }

// static oracles (already correct pre-fix): least-fixpoint SSSP and widest-path
pub deem sssp(src: &[SS], edges: &[SE]) {
    rel dist(node: i64, d: i64) {
        from src s select (s.id, 0);
        from dist x join edges e on e.src == x.node group by e.dst aggregate d = min(x.d + e.w) select (e.dst, d);
    }
    from dist r select r.node * 1000 + r.d : i64
}
// max-direction recursive aggregate (longest-hop-count to each node) — exercises
// the dir==4 best-map path too. Acyclic-safe (hop count, +1 per edge) so the
// max fixpoint converges; the cycle graph G3 is checked with SSSP (min) only.
pub deem longest(src: &[SS], edges: &[SE]) {
    rel hop(node: i64, d: i64) {
        from src s select (s.id, 0);
        from hop x join edges e on e.src == x.node group by e.dst aggregate d = max(x.d + 1) select (e.dst, d);
    }
    from hop r select r.node * 1000 + r.d : i64
}

fn sort_v(v: &mut Vec<i64>) {
    let n: i64 = v.len(); let mut i: i64 = 0i64;
    while i < n { let mut m: i64 = i; let mut j: i64 = i + 1i64;
        while j < n { if v.get(j) < v.get(m) { m = j; } j = j + 1i64; }
        if m != i { let t: i64 = v.get(i); v.set(i, v.get(m)); v.set(m, t); } i = i + 1i64; }
}
fn veq(a: &mut Vec<i64>, b: &mut Vec<i64>) -> bool {
    if a.len() != b.len() { return false; }
    sort_v(a); sort_v(b);
    let mut i: i64 = 0i64;
    while i < a.len() { if a.get(i) != b.get(i) { return false; } i = i + 1i64; }
    return true;
}

// build dynamic Writ sources from parallel raw arrays
fn dsrc(d: &Writ, ids: &Vec<i64>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(ids.len() + 1i64); let mut i: i64 = 0i64;
    while i < ids.len() { let r: Src = d.make::<Src>(); r.id = ids.get(i); arr.push(WAny::ref_to((r.m as i64) as *const u8)); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}
fn dedge(d: &Writ, es: &Vec<i64>, et: &Vec<i64>, ew: &Vec<i64>) -> WAny {
    let arr: &mut WArray<WAny> = d.array(es.len() + 1i64); let mut i: i64 = 0i64;
    while i < es.len() { let r: Edge = d.make::<Edge>(); r.src = es.get(i); r.dst = et.get(i); r.w = ew.get(i);
        arr.push(WAny::ref_to((r.m as i64) as *const u8)); i = i + 1i64; }
    return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
}
fn dyn_run(qt: str, c: &SchemaCatalog, env: &QEnv) -> Vec<i64> {
    let mut out: Vec<i64> = vec_new::<i64>();
    match Query::compile(qt, c) {
        Result::Ok(q) => {
            match q.run(env) {
                Result::Ok(r) => { let nr: i64 = r.row_count(); let mut i: i64 = 0i64; while i < nr { out.push(r.get_i64(i, 0i64)); i = i + 1i64; } }
                Result::Err(_e2) => { out.push(-1i64); }
            }
        }
        Result::Err(_e) => { out.push(-2i64); }
    }
    return out;
}

// one graph: assert dynamic == static for both SSSP and widest. base = distinct exit tens.
fn check(base: i32, do_max: bool, ss: &Vec<SS>, se: &Vec<SE>,
         ids: &Vec<i64>, es: &Vec<i64>, et: &Vec<i64>, ew: &Vec<i64>, c: &SchemaCatalog) -> i32 {
    let d: Writ = writ_new(8192i64);
    let mut env: QEnv = QEnv::new();
    env.bind_source("src", dsrc(&d, ids));
    env.bind_source("edges", dedge(&d, es, et, ew));

    let mut s1: Vec<i64> = sssp(ss.as_slice(), se.as_slice()).unwrap();
    let mut d1: Vec<i64> = dyn_run("rel dist(node: i64, d: i64) { from src s select (s.id, 0); from dist x join edges e on e.src == x.node group by e.dst aggregate d = min(x.d + e.w) select (e.dst, d); } from dist r select r.node * 1000 + r.d", c, &env);
    if s1.len() == 0i64 { return base + 8i32; }          // static broke → different regression
    if !veq(&mut s1, &mut d1) { return base + 1i32; }    // SSSP (min) dynamic != static (the bug)

    if do_max {
        let mut s2: Vec<i64> = longest(ss.as_slice(), se.as_slice()).unwrap();
        let mut d2: Vec<i64> = dyn_run("rel hop(node: i64, d: i64) { from src s select (s.id, 0); from hop x join edges e on e.src == x.node group by e.dst aggregate d = max(x.d + 1) select (e.dst, d); } from hop r select r.node * 1000 + r.d", c, &env);
        if !veq(&mut s2, &mut d2) { return base + 2i32; } // max-aggregate dynamic != static
    }
    return 0i32;
}

fn mkSS(ids: &Vec<i64>) -> Vec<SS> { let mut v: Vec<SS> = vec_new::<SS>(); let mut i: i64 = 0i64; while i < ids.len() { v.push(SS { id: ids.get(i) }); i = i + 1i64; } return v; }
fn mkSE(es: &Vec<i64>, et: &Vec<i64>, ew: &Vec<i64>) -> Vec<SE> { let mut v: Vec<SE> = vec_new::<SE>(); let mut i: i64 = 0i64; while i < es.len() { v.push(SE { src: es.get(i), dst: et.get(i), w: ew.get(i) }); i = i + 1i64; } return v; }

fn push3(a: &mut Vec<i64>, b: &mut Vec<i64>, cc: &mut Vec<i64>, x: i64, y: i64, z: i64) { a.push(x); b.push(y); cc.push(z); }

fn main() -> i32 {
    let c: SchemaCatalog = cat();

    // G1: chain 0→1(w5)→2(w3). src {0}.
    let mut id1: Vec<i64> = vec_new::<i64>(); id1.push(0i64);
    let mut e1: Vec<i64> = vec_new::<i64>(); let mut t1: Vec<i64> = vec_new::<i64>(); let mut w1: Vec<i64> = vec_new::<i64>();
    push3(&mut e1, &mut t1, &mut w1, 0i64, 1i64, 5i64); push3(&mut e1, &mut t1, &mut w1, 1i64, 2i64, 3i64);
    let r1: i32 = check(10i32, true, &mkSS(&id1), &mkSE(&e1, &t1, &w1), &id1, &e1, &t1, &w1, &c);
    if r1 != 0i32 { return r1; }

    // G2: branch 0→1(w2), 0→2(w9), 1→2(w1)  (so dist(2)=min(9, 2+1)=3). src {0}.
    let mut id2: Vec<i64> = vec_new::<i64>(); id2.push(0i64);
    let mut e2: Vec<i64> = vec_new::<i64>(); let mut t2: Vec<i64> = vec_new::<i64>(); let mut w2: Vec<i64> = vec_new::<i64>();
    push3(&mut e2, &mut t2, &mut w2, 0i64, 1i64, 2i64); push3(&mut e2, &mut t2, &mut w2, 0i64, 2i64, 9i64); push3(&mut e2, &mut t2, &mut w2, 1i64, 2i64, 1i64);
    let r2: i32 = check(20i32, true, &mkSS(&id2), &mkSE(&e2, &t2, &w2), &id2, &e2, &t2, &w2, &c);
    if r2 != 0i32 { return r2; }

    // G3: cycle 0→1(w1)→2(w1)→0(w1). src {0}. fixpoint must terminate.
    let mut id3: Vec<i64> = vec_new::<i64>(); id3.push(0i64);
    let mut e3: Vec<i64> = vec_new::<i64>(); let mut t3: Vec<i64> = vec_new::<i64>(); let mut w3: Vec<i64> = vec_new::<i64>();
    push3(&mut e3, &mut t3, &mut w3, 0i64, 1i64, 1i64); push3(&mut e3, &mut t3, &mut w3, 1i64, 2i64, 1i64); push3(&mut e3, &mut t3, &mut w3, 2i64, 0i64, 1i64);
    let r3: i32 = check(30i32, false, &mkSS(&id3), &mkSE(&e3, &t3, &w3), &id3, &e3, &t3, &w3, &c);
    if r3 != 0i32 { return r3; }

    return 0i32;
}
