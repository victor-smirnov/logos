// Regression: a ContainerRef stays valid across dir-tree growth that
// reallocates / splits the dir leaf holding its entry.
//
// The bug (now fixed): ContainerRef used to cache a raw *mut NodeARC
// pointing INTO the dir leaf's `vals` Vec buffer. Opening more containers
// into the same dir grows that Vec; once len==cap the buffer reallocs (and
// past the dir fanout the leaf splits), so the first ref's cached slot
// pointer dangled — the next writeback wrote through freed memory (UAF).
//
// Fix: ContainerRef holds a pointer to the Snap's stable `dir` field and
// re-resolves the slot freshly via dir_lookup inside writeback. This test
// keeps the FIRST container's ref live while creating enough sibling
// containers to force both a vals-Vec realloc (cap 8→16) and a dir-leaf
// split (DirCfg fanout = 16), then mutates + reads through the first ref.

package persistent_dir_ref_stable;

use logos.std.data.persistent.handle;
use logos.std.data.persistent.store;
use logos.std.data.persistent.bt.node;
use logos.std.data.persistent.bt.cow;
use logos.std.data.persistent.bt.descent;
use logos.std.data.persistent.bt.mutate;
use logos.mem.collections.vec;
use logos.lang.fabric;
use logos.lang.hermes.hstatic;

pub const StoreCfg: HermesStatic = @{
    "name": "drs", "ctr_id": <type:u64>, "snp_id": <type:u64>, "block_id": <type:u64>,
};
pub const MapCfg: HermesStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 4 };

fn main() -> i32 {
    let mut store: Store<StoreCfg> = store_open::<StoreCfg>();
    let mut snap: Snap<StoreCfg> = store.fork(GENESIS);

    // First container — keep its ref LIVE for the whole test.
    let mut cr1: ContainerRef<StoreCfg, MapCfg> =
        create_pmap::<MapCfg, StoreCfg>(&mut snap, 1u64);
    cr1.insert(10u64, 100u64);

    // Create 24 more containers into the same dir. This crosses the
    // vals-Vec realloc boundary (cap 8→16→32) AND the dir-leaf split
    // boundary (fanout 16) — both used to invalidate cr1's cached slot.
    let mut id: u64 = 2u64;
    while id <= 25u64 {
        let mut crx: ContainerRef<StoreCfg, MapCfg> =
            create_pmap::<MapCfg, StoreCfg>(&mut snap, id);
        crx.insert(id, id * 10u64);
        let _ = crx;            // drop crx; its rc share releases
        id = id + 1u64;
    }

    // cr1's cached dir slot would now be dangling under the old code.
    // Mutate through cr1 → writeback re-resolves the slot against the
    // (grown, possibly split) dir. Must not crash; data must be intact.
    cr1.insert(20u64, 200u64);

    let v1: u64 = match cr1.get(10u64) {
        Option::Some(x) => x,
        Option::None => { return 1; }
    };
    if v1 != 100u64 { return 2; }
    let v2: u64 = match cr1.get(20u64) {
        Option::Some(x) => x,
        Option::None => { return 3; }
    };
    if v2 != 200u64 { return 4; }
    if cr1.len() != 2u64 { return 5; }

    // A sibling container created mid-growth is still correct via a fresh open.
    let cr7: ContainerRef<StoreCfg, MapCfg> =
        open_pmap::<MapCfg, StoreCfg>(&mut snap, 7u64).unwrap();
    if cr7.len() != 1u64 { return 6; }
    let v7: u64 = match cr7.get(7u64) {
        Option::Some(x) => x,
        Option::None => { return 7; }
    };
    if v7 != 70u64 { return 8; }

    return 0;
}
