// ADMIT TWIN for fail/bc_d1_container_push_held. The container's LAST USE
// precedes the mutation, so NLL releases the stored loan and the mutation is
// legal. Pins that the store-into-container rule extends a loan's LIFETIME to
// the receiver's last use — it does not make the receiver a lexical borrow.
package bc_d1_container_last_use_admits;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn main() -> i32 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    vs.push(c.mk());
    let n: i64 = *vs.get(0u64).p;
    c.bump();
    if n != 1i64 { return 1; }
    if c.v != 2i64 { return 2; }
    return 0;
}
