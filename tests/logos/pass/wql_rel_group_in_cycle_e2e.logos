// A grouping rel body inside a recursive component (#9 roadmap): `deg` is
// closed into a cycle by its PLAIN body, while its grouping body reads only an
// earlier stratum (the edges) — so the group's rows are a constant input to
// the fixpoint, folded once as a seed. (Refused before as
// fail/wql_rel_group_in_cycle_fail.) Rows: hand-derived.
package test;
use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.result;
use logos.std.fmt;
struct Edge { pub src: i64, pub dst: i64 }
// deg(n, k): a node's out-degree (a group over the edges, an earlier stratum)
// — and, recursively, every node reachable from a node with degree k carries k too.
pub deem q(edges: &[Edge]) {
    rel deg(n: i64, k: i64) {
        from edges e group by e.src aggregate k = count() select (key, k);
        from deg d join edges e on e.src == d.n select (e.dst, d.k);
    }
    from deg d select (d.n, d.k) order by d.n * 10 + d.k
}
fn main() -> i32 {
    let edges: [Edge; 4] = [ Edge { src: 1, dst: 2 }, Edge { src: 1, dst: 3 }, Edge { src: 3, dst: 4 }, Edge { src: 5, dst: 1 } ];
    let r: Vec<(i64, i64)> = q(&edges[..]).unwrap();
    let mut i: i64 = 0i64;
    while i < r.len() { println!("{} {}", r.get(i).0, r.get(i).1); i = i + 1i64; }
    return 0i32;
}
