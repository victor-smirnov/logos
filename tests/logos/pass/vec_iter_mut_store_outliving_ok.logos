// The legal twin: a reference that outlives the Vec is stored through iter_mut (rustc 1.98.1: exit 0).
package vec_iter_mut_store_outliving_ok;
fn main() -> i32 {
    let d: i64 = 2i64;
    let mut v: Vec<&i64> = Vec::<&i64>::new();
    v.push(&d);
    {
        let x: i64 = 5i64;
        for r in v.iter_mut() { *r = &d; }
    }
    return (*v.get(0u64) - 2i64) as i32;
}
