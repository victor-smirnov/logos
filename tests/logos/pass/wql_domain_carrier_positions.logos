// ONE EXPRESSION, ONE VALUE — THE CARRIER AT EVERY POSITION THAT COMPUTES OR
// COMPARES AN INTEGER THAT CAME FROM A COLUMN.
//
// THE LAW THIS FILE ASSERTS, and it is one law rather than a list of fixtures:
//
//     for every position P and every u64-valued expression E,
//         value_at(P, E)  ==  value_at(aggregate_argument, E)
//
// The aggregate argument is the reference not because it is privileged but
// because it was the ONE position that already carried the claim — `QPlan.agg_argu`
// — so before this commit the law was FALSE at every other position, measurably:
// on a row holding 2^64−1, `s.u / 3` answered 6148914691236517205 inside
// `sum(…)` and 0 in a projection. Same query text, same row, same engine,
// decided by where the expression sat. The reference side of every comparison
// below is therefore ALSO pinned to a hand-derived constant, so a regression
// that moves both sides together still goes red.
//
// ⚠ EVERY CONSTANT HERE IS DERIVED FROM THE ARITHMETIC, NOT READ OFF A RUN.
// The column holds u = {5, 2^63, 2^64−1}. As u64:
//        5           / 3 = 1
//        2^63        / 3 = 9223372036854775808 / 3 = 3074457345618258602
//        2^64−1      / 3 = 18446744073709551615 / 3 = 6148914691236517205
// The i64 payloads those three bit-patterns spell are 5, −9223372036854775808
// and −1, so the SIGNED quotients are 1, −3074457345618258602 and 0 — the three
// answers this file must never see from a position that claims u64.
//
// ⚠ EVERY BLOCK CARRIES ITS i64 TWIN IN THE SAME PROGRAM OVER THE SAME ROWS.
// v = {30, 20, 10} is the signed control column; v / 3 = {10, 6, 3}. A remedy
// keyed on the INTEGER CLASS rather than on the column's derived order fidelity
// moves the control too, and the control is what catches it. The bit-exact
// positions — equality, hashing, `group by`, `distinct` — are asserted UNMOVED
// for the same reason: the u64 → i64 conversion is a bijection, so those were
// right all along and a fix that touches them is over-reaching.
//
// exit 0 = the law holds at every position reachable from the surface grammar.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

pub schema Rw : code(0x0B13_0000_0000_0061) {
    id: i64  = 0,
    g:  i64  = 1,
    u:  u64  = 2,   // the unsigned column: its order and its overflow predicate wrap
    v:  i64  = 3,   // the signed control, same width
    p:  bool = 4,   // ternary selector — false on every row
}
// The join's right-hand side: `k` holds exactly the three UNSIGNED quotients, so
// an equi-join on `a.u / 3 == b.k` matches all three rows iff the key expression
// was computed unsigned. Equality itself is bit-exact and innocent.
pub schema Kw : code(0x0B13_0000_0000_0062) {
    kid: i64 = 0,
    k:   u64 = 1,
}
resource cat = schema_catalog!{ Rw, Kw };

// THE THREE DERIVED CONSTANTS. u64 division by 3, computed by hand above.
const Q0: i64 = 1i64;
const Q1: i64 = 3074457345618258602i64;
const Q2: i64 = 6148914691236517205i64;
// …and the three SIGNED quotients, named so a wrong answer is recognised rather
// than merely rejected. Q1S is the negation of Q1; Q2S is (−1)/3 = 0.
const Q1S: i64 = -3074457345618258602i64;
const Q2S: i64 = 0i64;

// An identity UDF — the argument position of a registered function.
fn ident(args: &[RtVal]) -> RtVal { return args[0i64]; }

fn sview(s: &String) -> str { return unsafe { str_from_raw(s.as_ptr(), s.len()); } }

fn mk(d: &Writ, id: i64, g: i64, u: u64, v: i64, p: bool) -> WAny {
    let r: Rw = d.make::<Rw>(); r.id = id; r.g = g; r.u = u; r.v = v; r.p = p;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn mkk(d: &Writ, kid: i64, k: u64) -> WAny {
    let r: Kw = d.make::<Kw>(); r.kid = kid; r.k = k;
    return WAny::ref_to((r.m as i64) as *const u8);
}

// ⚠ NO `fn qrun(…) -> Result<QRows, QError>` HELPER, AND THE COMPILER IS RIGHT
// TO REFUSE ONE: a `QRows` holds `str` views into its `Query`'s own IR doc, so
// returning it past the local `Query` is a dangling reference and the borrow
// checker says so. Every block therefore keeps its `Query` alive in this frame,
// which is the idiom the rest of the query corpus already uses.

// Does column `col` of `r` hold `want` in SOME row? (group/join output order is
// a hash-map artefact and is not what any block here is about).
fn has(r: &QRows, col: i64, want: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < r.row_count() { if r.get_i64(i, col) == want { return true; } i = i + 1i64; }
    return false;
}
// The cell of column `vc` in the row whose column `kc` equals `key`; a miss is
// reported as the sentinel, which no expectation below uses.
fn cell_for(r: &QRows, kc: i64, key: i64, vc: i64) -> i64 {
    let mut i: i64 = 0i64;
    while i < r.row_count() {
        if r.get_i64(i, kc) == key { return r.get_i64(i, vc); }
        i = i + 1i64;
    }
    return -777i64;
}

fn main() -> i32 {
    let c: SchemaCatalog = cat();
    let d: Writ = writ_new(16384i64);
    let rows: &mut WArray<WAny> = d.array(8i64);
    rows.push(mk(&d, 0i64, 0i64, 5u64,                    30i64, false));
    rows.push(mk(&d, 1i64, 1i64, 9223372036854775808u64,  20i64, false));
    rows.push(mk(&d, 2i64, 2i64, 18446744073709551615u64, 10i64, false));
    let ks: &mut WArray<WAny> = d.array(8i64);
    ks.push(mkk(&d, 100i64, 1u64));
    ks.push(mkk(&d, 101i64, 3074457345618258602u64));
    ks.push(mkk(&d, 102i64, 6148914691236517205u64));

    let mut e: QEnv = QEnv::new();
    e.bind_source("rs", WAny::ref_to(rows as *const WArray<WAny> as *const u8));
    e.bind_source("ks", WAny::ref_to(ks   as *const WArray<WAny> as *const u8));
    let at1: [str; 1] = ["i64"];
    if !e.register_fn("ident", ident, &at1[..], "i64") { return 1i32; }

    // ── R. THE REFERENCE POSITION — the aggregate ARGUMENT ─────────────────
    // One row per group, so `sum` is the identity and the cell IS the argument's
    // value. This position carried the claim before this commit; it is pinned to
    // the hand-derived constants so it cannot drift along with the others.
    let c_rr: Query = match Query::compile("from rs s group by s.id aggregate q = sum(s.u / 3), w = sum(s.v / 3) select (key, q, w)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 10i32; } };
    let rr: QRows = match c_rr.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 10i32; } };
    if rr.row_count() != 3i64 { return 11i32; }
    if cell_for(&rr, 0i64, 0i64, 1i64) != Q0 { return 12i32; }
    if cell_for(&rr, 0i64, 1i64, 1i64) != Q1 { return 13i32; }
    if cell_for(&rr, 0i64, 2i64, 1i64) != Q2 { return 14i32; }
    // CONTROL, same query, same rows: the i64 column's quotients are 10, 6, 3.
    if cell_for(&rr, 0i64, 0i64, 2i64) != 10i64 { return 15i32; }
    if cell_for(&rr, 0i64, 1i64, 2i64) != 6i64  { return 16i32; }
    if cell_for(&rr, 0i64, 2i64, 2i64) != 3i64  { return 17i32; }

    // ── A. THE FILTER — the defect as it was named ─────────────────────────
    // `where s.u > 5`: unsigned, 2^63 and 2^64−1 both exceed 5, so ids 1 and 2.
    // Signed, both read negative and NO row passes — the measured answer at HEAD
    // was zero rows, and the filter arm had no carrier of any kind.
    let c_ra: Query = match Query::compile("from rs s where s.u > 5 select s.id", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 20i32; } };
    let ra: QRows = match c_ra.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 20i32; } };
    if ra.row_count() != 2i64 { return 21i32; }
    if ra.get_i64(0i64, 0i64) != 1i64 { return 22i32; }
    if ra.get_i64(1i64, 0i64) != 2i64 { return 23i32; }
    // CONTROL: the i64 twin. 30, 20, 10 all exceed 5 → three rows. This was
    // ALREADY three rows before the fix, which is what makes it a control.
    let c_ra2: Query = match Query::compile("from rs s where s.v > 5 select s.id", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 24i32; } };
    let ra2: QRows = match c_ra2.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 24i32; } };
    if ra2.row_count() != 3i64 { return 25i32; }
    // …and the strict/non-strict boundary of the same compare: `>= 5` admits the
    // row holding exactly 5, so all three. A carrier that keyed the operands but
    // dropped the `=` would show here and nowhere else.
    let c_ra3: Query = match Query::compile("from rs s where s.u >= 5 select s.id", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 26i32; } };
    let ra3: QRows = match c_ra3.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 26i32; } };
    if ra3.row_count() != 3i64 { return 27i32; }
    // The other direction: `< 5` admits nothing, because 5 is the unsigned MINIMUM
    // of this column. Signed it would admit 2^63 and 2^64−1 — the exact inversion.
    let c_ra4: Query = match Query::compile("from rs s where s.u < 5 select s.id", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 28i32; } };
    let ra4: QRows = match c_ra4.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 28i32; } };
    if ra4.row_count() != 0i64 { return 29i32; }

    // ── B. THE PROJECTION CELL — the other half of "one expression, two values"
    let c_rb: Query = match Query::compile("from rs s select (s.id, s.u / 3, s.v / 3)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 30i32; } };
    let rb: QRows = match c_rb.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 30i32; } };
    if rb.row_count() != 3i64 { return 31i32; }
    if rb.get_i64(0i64, 1i64) != Q0 { return 32i32; }
    if rb.get_i64(1i64, 1i64) != Q1 { return 33i32; }
    if rb.get_i64(2i64, 1i64) != Q2 { return 34i32; }
    // THE LAW: this cell and the aggregate argument's are the same expression.
    if rb.get_i64(1i64, 1i64) != cell_for(&rr, 0i64, 1i64, 1i64) { return 35i32; }
    if rb.get_i64(2i64, 1i64) != cell_for(&rr, 0i64, 2i64, 1i64) { return 36i32; }
    // …and neither is the SIGNED quotient, named rather than merely excluded.
    if rb.get_i64(1i64, 1i64) == Q1S { return 37i32; }
    if rb.get_i64(2i64, 1i64) == Q2S { return 38i32; }
    // CONTROL: the i64 cells of the SAME Proj node — one relational node whose
    // cells' claims differ, which is why no table keyed by the Proj node could
    // ever have carried this.
    if rb.get_i64(0i64, 2i64) != 10i64 { return 39i32; }

    // ── C. THE GROUP KEY ──────────────────────────────────────────────────
    // `group by (s.u / 3)`: three distinct quotients, so three groups of one.
    // Signed, the emitted key would be a number `sum` of the same expression
    // would never produce.
    let c_rc: Query = match Query::compile("from rs s group by (s.u / 3) aggregate n = count() select (key, n)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 40i32; } };
    let rc: QRows = match c_rc.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 40i32; } };
    if rc.row_count() != 3i64 { return 41i32; }
    if !has(&rc, 0i64, Q0) { return 42i32; }
    if !has(&rc, 0i64, Q1) { return 43i32; }
    if !has(&rc, 0i64, Q2) { return 44i32; }
    if has(&rc, 0i64, Q1S) { return 45i32; }

    // ── D. `having` OVER AN AGGREGATE OUT-NAME — the sharpest form ─────────
    // `max(s.u)` is CORRECT already (the fold reads `QPlan.agg_argu`), so this is
    // a value PRODUCED with the claim honoured and then COMPARED without it,
    // inside one query. Measured at HEAD: zero rows. The out-name `m` is a Var,
    // not a Field — its claim comes from the checker's binding table, which is
    // read at the leaf and stamped onto the comparison node.
    // Groups g=1 (2^63) and g=2 (2^64−1) exceed 5; g=0 holds exactly 5.
    let c_rd: Query = match Query::compile("from rs s group by s.g aggregate m = max(s.u) having m > 5 select (key, m)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 50i32; } };
    let rd: QRows = match c_rd.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 50i32; } };
    if rd.row_count() != 2i64 { return 51i32; }
    if !has(&rd, 0i64, 1i64) { return 52i32; }
    if !has(&rd, 0i64, 2i64) { return 53i32; }
    if has(&rd, 0i64, 0i64) { return 54i32; }
    // CONTROL in the same shape: `count()` is an i64 out-name and `n > 0` held
    // before the fix as it holds after it.
    let c_rd2: Query = match Query::compile("from rs s group by s.g aggregate n = count() having n > 0 select (key, n)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 55i32; } };
    let rd2: QRows = match c_rd2.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 55i32; } };
    if rd2.row_count() != 3i64 { return 56i32; }
    // ARITHMETIC over the out-name, i.e. the claim through a Var and then through
    // a `/`: m/3 > 0 unsigned holds for all three (1, Q1, Q2 are all positive);
    // signed it held for group 0 only, because Q1S is negative and Q2S is 0.
    let c_rd3: Query = match Query::compile("from rs s group by s.g aggregate m = max(s.u) having m / 3 > 0 select (key, m)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 57i32; } };
    let rd3: QRows = match c_rd3.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 57i32; } };
    if rd3.row_count() != 3i64 { return 58i32; }

    // ── E. A TERNARY IN A PROJECTION ──────────────────────────────────────
    // Both branches are the same u64 column, so `ct_join_ordw` says this node IS
    // u64 — and at an aggregate argument the evaluator honoured exactly that.
    // The projection dropped it: the plumbing was missing, not the type.
    let c_re: Query = match Query::compile("from rs s select (s.id, (s.p ? s.u : s.u) / 3)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 60i32; } };
    let re: QRows = match c_re.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 60i32; } };
    if re.row_count() != 3i64 { return 61i32; }
    if re.get_i64(1i64, 1i64) != Q1 { return 62i32; }
    if re.get_i64(2i64, 1i64) != Q2 { return 63i32; }
    // ⚠ THE OVER-CARRY CONTROL, and it must stay signed. `p` is false on every
    // row, so this takes the `s.u` branch — but the branches DISAGREE (u64 vs
    // i64), so the claim is DROPPED and the quotient is the SIGNED one. This is
    // the regression `query_u64_ordw_origin` group 3 was written for, asked here
    // of a projection rather than a sort key.
    let c_re2: Query = match Query::compile("from rs s select (s.id, (s.p ? s.v : s.u) / 3)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 64i32; } };
    let re2: QRows = match c_re2.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 64i32; } };
    if re2.get_i64(1i64, 1i64) != Q1S { return 65i32; }
    if re2.get_i64(2i64, 1i64) != Q2S { return 66i32; }

    // ── F. A BOOL CELL IN A PROJECTION — the compare arm from a third caller
    let c_rf: Query = match Query::compile("from rs s select (s.id, s.u > 5, s.v > 5)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 70i32; } };
    let rf: QRows = match c_rf.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 70i32; } };
    if rf.row_count() != 3i64 { return 71i32; }
    if rf.get_bool(0i64, 1i64) { return 72i32; }        // 5 > 5 is false
    if !rf.get_bool(1i64, 1i64) { return 73i32; }       // 2^63 > 5
    if !rf.get_bool(2i64, 1i64) { return 74i32; }       // 2^64−1 > 5
    if !rf.get_bool(0i64, 2i64) { return 75i32; }       // CONTROL: 30 > 5

    // ── G. THE SORT KEY — the position that bought consistency with a restriction
    // `sx_is_origin` refused a COMPUTED key the column's signedness, because the
    // evaluator computed it signed. Both halves now agree, the restriction is
    // retired, and the unsigned quotients ascend as 1 < Q1 < Q2 → ids 0,1,2.
    let c_rg: Query = match Query::compile("from rs s select s.id order by (s.u / 3)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 80i32; } };
    let rg: QRows = match c_rg.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 80i32; } };
    if rg.row_count() != 3i64 { return 81i32; }
    if rg.get_i64(0i64, 0i64) != 0i64 { return 82i32; }
    if rg.get_i64(1i64, 0i64) != 1i64 { return 83i32; }
    if rg.get_i64(2i64, 0i64) != 2i64 { return 84i32; }
    // CONTROL: the i64 twin sorts by 10 < 6 < 3 reversed → ids 2,1,0, the exact
    // opposite permutation, so a comparator that ignored the key could not pass
    // both halves by coincidence.
    let c_rg2: Query = match Query::compile("from rs s select s.id order by (s.v / 3)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 85i32; } };
    let rg2: QRows = match c_rg2.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 85i32; } };
    if rg2.get_i64(0i64, 0i64) != 2i64 { return 86i32; }
    if rg2.get_i64(2i64, 0i64) != 0i64 { return 87i32; }

    // ── H. THE JOIN KEY ───────────────────────────────────────────────────
    // `ks` holds the three UNSIGNED quotients, so all three rows match iff the
    // key EXPRESSION was computed unsigned. Measured at HEAD: 1 row.
    let c_rh: Query = match Query::compile("from rs a join ks b on a.u / 3 == b.k select (a.id, b.kid)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 90i32; } };
    let rh: QRows = match c_rh.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 90i32; } };
    if rh.row_count() != 3i64 { return 91i32; }
    if cell_for(&rh, 0i64, 1i64, 1i64) != 101i64 { return 92i32; }
    if cell_for(&rh, 0i64, 2i64, 1i64) != 102i64 { return 93i32; }

    // ── I. A UDF ARGUMENT ─────────────────────────────────────────────────
    let c_ri: Query = match Query::compile("from rs s select (s.id, ident(s.u / 3))", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 100i32; } };
    let ri: QRows = match c_ri.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 100i32; } };
    if ri.get_i64(1i64, 1i64) != Q1 { return 101i32; }
    if ri.get_i64(2i64, 1i64) != Q2 { return 102i32; }

    // ── J. THE TEMPLATE TIER — both halves of the defect in one string ─────
    let tp: Tpl = match Tpl::compile("{{ n.u / 3 }}|{{ n.u > 5 }}", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 110i32; } };
    let mut te: QEnv = QEnv::new();
    te.bind_node("n", rows.get(2i64));
    let ts: String = match tp.render(&te) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 111i32; } };
    if !str_eq(sview(&ts), "6148914691236517205|true") { return 112i32; }
    // CONTROL: the i64 column through the same template shape — 10 / 3 = 3.
    let tp2: Tpl = match Tpl::compile("{{ n.v / 3 }}|{{ n.v > 5 }}", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 113i32; } };
    let ts2: String = match tp2.render(&te) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 114i32; } };
    if !str_eq(sview(&ts2), "3|true") { return 115i32; }

    // ── K. THE INCREMENTAL TIER — the same positions, the same answers ─────
    // The two tiers never disagreed with EACH OTHER; each replicated the same
    // disagreement between POSITIONS. One carrier moves both, and these blocks
    // are what says so.
    let qk1: Query = match Query::compile("from rs s group by s.id aggregate q = sum(s.u / 3) select (key, q)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 120i32; } };
    let gk1: IncrJoin = match qk1.incremental(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 121i32; } };
    if gk1.had_error() { return 122i32; }
    let sk1: QRows = gk1.snapshot();
    if sk1.row_count() != 3i64 { return 123i32; }
    if cell_for(&sk1, 0i64, 1i64, 1i64) != Q1 { return 124i32; }
    if cell_for(&sk1, 0i64, 2i64, 1i64) != Q2 { return 125i32; }

    // the incremental GROUP KEY — signed at HEAD in this tier too
    let qk2: Query = match Query::compile("from rs s group by (s.u / 3) aggregate n = count() select (key, n)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 126i32; } };
    let gk2: IncrJoin = match qk2.incremental(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 127i32; } };
    if gk2.had_error() { return 128i32; }
    let sk2: QRows = gk2.snapshot();
    if sk2.row_count() != 3i64 { return 129i32; }
    if !has(&sk2, 0i64, Q1) { return 130i32; }
    if !has(&sk2, 0i64, Q2) { return 131i32; }

    // the incremental JOIN KEY
    let qk3: Query = match Query::compile("from rs a join ks b on a.u / 3 == b.k select (a.id, b.kid)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 132i32; } };
    let gk3: IncrJoin = match qk3.incremental(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 133i32; } };
    if gk3.had_error() { return 134i32; }
    let sk3: QRows = gk3.snapshot();
    if sk3.row_count() != 3i64 { return 135i32; }

    // ── L. THE CLAIM IS DROPPED WHERE THE OPERANDS DISAGREE ────────────────
    // ⚠ THIS BLOCK FAILS IF THE CARRIER OVER-REACHES, and it does so by a
    // REFUSAL rather than by a value, which is the sharpest available signal.
    // `s.u + s.v` mixes u64 with i64, so `ct_join_ordw` drops the claim and the
    // add is checked in i64: (−1) + 10 = 9, no overflow, three rows. Under the
    // u64 predicate the same add is 18446744073709551615 + 10, which leaves u64
    // and the evaluator returns an arithmetic error — so an over-carrying build
    // does not answer differently here, it answers Err.
    let c_rl: Query = match Query::compile("from rs s select (s.id, s.u + s.v)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 140i32; } };
    let rl: QRows = match c_rl.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 140i32; } };
    if rl.row_count() != 3i64 { return 141i32; }
    if rl.get_i64(0i64, 1i64) != 35i64 { return 142i32; }   // 5 + 30
    if rl.get_i64(2i64, 1i64) != 9i64  { return 143i32; }   // (−1) + 10, signed
    // …and the UNMIXED add is refused for exactly the opposite reason: both
    // operands claim u64, so 2^64−1 + 2^64−1 leaves u64 and must be an error.
    // Signed it is (−1) + (−1) = −2 with no i64 overflow at all, so a build that
    // dropped the claim here would answer −2 and pass no assertion below.
    let c_rl2: Query = match Query::compile("from rs s select (s.id, s.u + s.u)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 145i32; } };
    match c_rl2.run(&e) {
        Result::Ok(_v) => { return 144i32; }
        Result::Err(_x) => { }
    }

    // ── M. THE BIT-EXACT POSITIONS, ASSERTED UNMOVED ──────────────────────
    // Equality, hashing, `group by` and `distinct` read the payload's BITS, and
    // the u64 → i64 conversion is a bijection, so they were right before any of
    // this existed. A remedy that moves them is keyed on the wrong thing.
    let c_rm: Query = match Query::compile("from rs s group by s.u aggregate n = count() select (key, n)", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 150i32; } };
    let rm: QRows = match c_rm.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 150i32; } };
    if rm.row_count() != 3i64 { return 151i32; }
    let c_rm2: Query = match Query::compile("from rs s select distinct s.u", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 152i32; } };
    let rm2: QRows = match c_rm2.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 152i32; } };
    if rm2.row_count() != 3i64 { return 153i32; }
    // equality on the u64 column still matches by bits — the row holding 2^64−1
    // is found by an equi-join whose key is the column itself, unchanged.
    let c_rm3: Query = match Query::compile("from rs s where s.u == 5 select s.id", &c) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 154i32; } };
    let rm3: QRows = match c_rm3.run(&e) {
        Result::Ok(v) => { v } Result::Err(_x) => { return 154i32; } };
    if rm3.row_count() != 1i64 { return 155i32; }
    if rm3.get_i64(0i64, 0i64) != 0i64 { return 156i32; }

    return 0i32;
}
