// Operator overloading through generic trait bound: v + v on TypeVar
package op_generic_add;
use logos.lang.clone;
trait Add { fn add(self: Self, rhs: Self) -> Self; }
struct Vec2 { x: i32, y: i32, }
impl Clone for Vec2 { fn clone(&self) -> Vec2 { return Vec2 { x: self.x, y: self.y }; } }
impl Copy for Vec2 {}
impl Add for Vec2 {
    type Output = Vec2;
    fn add(self: Vec2, rhs: Vec2) -> Vec2 {
        return Vec2 { x: self.x + rhs.x, y: self.y + rhs.y };
    }
}
// `v + v` moves `v` twice unless T is Copy (Rust E0382): the bound says so.
fn double<T: Add<Output = T> + Copy>(v: T) -> T { return v + v; }
unsafe fn main() -> i32 {
    let v: Vec2 = Vec2 { x: 10, y: 11 };
    let d: Vec2 = double::<Vec2>(v);
    return d.x + d.y;
}
