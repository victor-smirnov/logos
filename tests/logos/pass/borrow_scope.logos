package borrow_scope;
// Borrow at call site is transient — variable available again after call
extern fn printf(fmt: *const u8, ...) -> i32;
struct Counter { val: i32; }
fn inc(c: &mut Counter) -> i32 {
    c.val = c.val + 1;
    return c.val;
}
fn main() -> i32 {
    let mut c = Counter { val: 0 };
    // &mut c is a call-site borrow — released after inc() returns
    let a: i32 = inc(&mut c);
    // c available again
    let b: i32 = inc(&mut c);
    return a + b;   // 1 + 2 = 3
}
