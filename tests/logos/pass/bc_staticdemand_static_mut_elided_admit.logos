// Storing a borrow of another static into the elided `static mut`; it runs.
// TWIN of fail/bc_staticdemand_static_mut_elided_refuse, one token apart. src/compiler/PROBES.md 2026-09-13d-staticdemand.
package bc_staticdemand_static_mut_elided_admit;
static FOO: u8 = 4u8;
static FOO2: u8 = 3u8;
static mut BAR: &u8 = &FOO;
fn set(n: u8) {
    unsafe { BAR = &FOO2; }
}
fn main() -> i32 { set(3u8); unsafe { return *BAR as i32; } }
