// Multi-container commit/fork:
//   • s1 = begin → fill ctr 101 (50 keys) + ctr 202 (30 keys) → commit → c0
//   • s2 = fork from c0 → add 50 more keys to ctr 101 → commit → c1
//   • Reopen c0: ctr 101 should still have 50 keys (parent preserved)
//   • Reopen c1: ctr 101 should have 100 keys
//   • Both snapshots' ctr 202 should still have 30 keys
package pmap_v2_multi_container_commit_fork;

use std.data.persistent.pmap_v2.handle;
use std.data.persistent.store;
use std.lang.cmp; use std.lang.ord; use std.lang.datatypes;
use std.hermes.view; use std.hermes.anyval;

pub type StoreCfg = @{
    "name":   "v1-default",
    "ctr_id": <type:u64>,
    "snp_id": <type:u64>,
};
pub type CfgA = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 8 };
pub type CfgB = @{ "key": <type:u32>, "value": <type:u32>, "fanout": 8 };

fn fill_a(c: &mut ContainerRef<CfgA>, lo: u64, hi: u64) {
    let mut i: u64 = lo;
    while i <= hi {
        let k: u64 = i;
        let _ = c.insert(k, k * 7u64, &k as *const u64);
        i = i + 1u64;
    }
}

fn fill_b(c: &mut ContainerRef<CfgB>, lo: u32, hi: u32) {
    let mut j: u32 = lo;
    while j <= hi {
        let kk: u32 = j;
        let _ = c.insert(kk, kk * 11u32, &kk as *const u32);
        j = j + 1u32;
    }
}

fn main() -> i32 {
    let mut store: Store<StoreCfg> = store_open();

    // ── s1: create + fill + commit ──
    let mut s1: Snap<StoreCfg> = snap_begin(&mut store);
    {
        let mut c_a: ContainerRef<CfgA> = create_pmap::<CfgA>(&mut s1, 101u64);
        let mut c_b: ContainerRef<CfgB> = create_pmap::<CfgB>(&mut s1, 202u64);
        fill_a(&mut c_a, 1u64, 50u64);
        fill_b(&mut c_b, 1u32, 30u32);
        if c_a.len() != 50u64 { return 1; }
        if c_b.len() != 30u64 { return 2; }
    }
    let c0: i64 = s1.commit();
    if c0 < 0i64 { return 3; }

    // ── s2: fork from c0, add more to ctr 101, commit ──
    let mut s2: Snap<StoreCfg> = snap_fork(&mut store, c0);
    {
        let mut c_a: ContainerRef<CfgA> = open_pmap::<CfgA>(&mut s2, 101u64);
        if !c_a.is_valid() { return 4; }
        if c_a.len() != 50u64 { return 5; }     // inherited
        fill_a(&mut c_a, 51u64, 100u64);
        if c_a.len() != 100u64 { return 6; }
    }
    let c1: i64 = s2.commit();
    if c1 < 0i64 { return 7; }
    if c1 == c0 { return 8; }

    // ── checkout c0: ctr 101 unchanged at 50 ──
    let mut s_c0: Snap<StoreCfg> = snap_fork(&mut store, c0);
    {
        let mut c_a: ContainerRef<CfgA> = open_pmap::<CfgA>(&mut s_c0, 101u64);
        if !c_a.is_valid() { return 10; }
        if c_a.len() != 50u64 { return 11; }
        let probe: u64 = 25u64;
        if !c_a.contains(&probe as *const u64) { return 12; }
        let probe_high: u64 = 75u64;
        if  c_a.contains(&probe_high as *const u64) { return 13; }   // not in c0

        let mut c_b: ContainerRef<CfgB> = open_pmap::<CfgB>(&mut s_c0, 202u64);
        if !c_b.is_valid() { return 14; }
        if c_b.len() != 30u64 { return 15; }
    }

    // ── checkout c1: ctr 101 has 100, ctr 202 still has 30 ──
    let mut s_c1: Snap<StoreCfg> = snap_fork(&mut store, c1);
    {
        let mut c_a: ContainerRef<CfgA> = open_pmap::<CfgA>(&mut s_c1, 101u64);
        if !c_a.is_valid() { return 20; }
        if c_a.len() != 100u64 { return 21; }
        let probe_high: u64 = 75u64;
        if !c_a.contains(&probe_high as *const u64) { return 22; }

        let mut c_b: ContainerRef<CfgB> = open_pmap::<CfgB>(&mut s_c1, 202u64);
        if !c_b.is_valid() { return 23; }
        if c_b.len() != 30u64 { return 24; }
    }

    return 42;
}
