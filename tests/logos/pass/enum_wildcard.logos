package enum_wildcard;
// F21: C-enum match with wildcard arm
enum Dir { North, South, East, West }
fn value(d: Dir) -> i32 {
    match d {
        Dir::North => { return 10; }
        Dir::South => { return 20; }
        _          => { return 6; }   // East or West
    }
}
fn main() -> i32 {
    let a: i32 = value(Dir::North);  // 10
    let b: i32 = value(Dir::South);  // 20
    let c: i32 = value(Dir::East);   // 6
    let d: i32 = value(Dir::West);   // 6
    return a + b + c + d;   // 10+20+6+6 = 42
}
