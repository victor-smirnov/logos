package logic_not;
// F04: ! (not) operator
fn is_zero(x: i32) -> bool { return x == 0; }
fn main() -> i32 {
    let a: bool = !is_zero(1);   // true
    let b: bool = !is_zero(0);   // false
    let c: bool = !b;            // true
    let d: bool = a && c;        // true
    if d { return 42; }
    return 0;
}
