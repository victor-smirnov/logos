// query_tree_source_graph_e2e — the GRAPH semantics of virtual sources over a
// general Writ object graph, not just a tree, AND THE QUERY CAPABILITIES OVER
// THE WALK: join, recursion over a CYCLIC edge set, order by, group-by
// aggregate.
//
// ⚠⚠ REWRITTEN 2026-08-09 — WHAT DIED AND WHAT REPLACED IT.
// Every leg used to be `QEnv::bind_source_tree` + `Query::compile`/`Query::run`.
// `QEnv`/`Query` (stdlib/mem/deem/query.logos) and the walker's only caller
// (the `QB_TSRC` arm of `exec_rexpr`, exec.logos) are both on the P5 deletion
// list, so this file measured the interpreter's ROUTE to the walker and not the
// walker. `dyn_graph_edge_rows` (stdlib/mem/deem/graphsrc.logos) materializes
// the same walk as named-column rows, and a `deem` over that slice keeps every
// capability the interpreter held over it: `from … join … on …`, `rel` with a
// recursive body, `order by`, `group by … aggregate`. A Vec alone would NOT
// have replaced them — that is why the slice-sourced form exists.
//
// Each leg is written TWICE, once over `&Writ` (the STATIC walker,
// logos.std.wql.writ_graph::writ_graph_edges) and once over the slice, so the
// file is now a two-producer differential where it used to be single-sourced.
//
// ⚠ THE RUNTIME-BOUND ANCHOR IS GONE AND NOT MISSED. `env.bind_i64("root", …)`
// and `bind_i64("tom", …)` fed handles the test had computed into the query.
// A `deem` takes no such binding, and none is needed: the root is reachable as
// the VIRTUAL ROOT EDGE (`parent == 0` — the vocabulary's one document-
// independent anchor) and the TOM is reachable by joining through the edge
// whose `kind` is "tom". Both rewrites are strictly document-independent.
//
// ⚠ CARDINALITY IS ASSERTED ON THE PRODUCERS' OWN Vec, NOT THROUGH A `select`.
// `select` is a SET projection: the two `s` edges carry the SAME child id, so
// `from g e select e.child` cannot count edges. The old file counted rows out
// of the interpreter's RowSet, which does not dedup, and the number would have
// silently changed meaning under a deem. Edge counts below read
// `writ_graph_edges(...).len()` / `dyn_graph_edges(...).len()` directly; the
// deems assert the SEMANTICS.
//
// Asserts:
//   (a) DAG — a SHARED container child: every incoming edge emits (the child
//       appears once per edge), but its children EXPAND exactly once (no
//       subtree duplication);
//   (b) CYCLE — a map that (transitively) contains itself: the scan
//       TERMINATES, the cyclic edge is present, and a recursive rel over the
//       cyclic edge set converges (set semantics);
//   (c) LEAF IDENTITY — equal scalar leaves in different places get DISTINCT
//       child ids (a leaf's value word is not an identity: two 7s must not
//       alias), while a shared CONTAINER keeps one id across its edges;
//   (d) TOM — a schema'd row (tiny object map) EXPANDS: fields edge with
//       idx = the field key code, reached by a JOIN through the tom edge;
//   (e) `tag` column — the raw type_code flows through and matches the
//       friendly `kind` classification for builtins, counted with a
//       GROUP BY … AGGREGATE over the walk;
//   (f) PARITY — the two producers agree on the whole relation, row for row.
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.wmap;
use logos.lang.writ.wstring;
use logos.std.wql.ir;
use logos.std.wql.wql;            // the deem handler
use logos.std.wql.writ_graph;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

// a schema'd row for the TOM arm (key codes 0 and 3 — deliberately sparse, so
// `idx` cannot be mistaken for a dense field counter)
pub schema Meta : code(0x0E11_0000_0000_0001) {
    alpha: i64 = 0,
    beta:  i64 = 3,
}

// ── (a)/(c) the `s` edges: TWO of them (parent differs), ONE child identity ──
pub deem w_s(g: &Writ)      { from g x where x.key == "s" select (x.parent, x.child) }
pub deem s_s(e: &[DynEdge]) { from e x where x.key == "s" select (x.parent, x.child) }

// ── (a) expansion-once: `shared`'s own child, reached only through it ───────
pub deem w_x(g: &Writ)      { from g x where x.key == "x" select (x.parent, x.child) }
pub deem s_x(e: &[DynEdge]) { from e x where x.key == "x" select (x.parent, x.child) }

// ── (b) the cyclic edge: `back` points AT the root, i.e. at the child of the
// virtual root edge. Expressed as a JOIN so no handle is bound in. ──────────
pub deem w_back(g: &Writ) {
    from g v join g b on b.child == v.child
    where v.parent == 0 && b.key == "back" select b.parent
}
pub deem s_back(e: &[DynEdge]) {
    from e v join e b on b.child == v.child
    where v.parent == 0 && b.key == "back" select b.parent
}

// ── (b) RECURSION OVER A CYCLIC EDGE SET. Seeded from the root's own outgoing
// edges (anchored on the virtual root edge), then closed. Convergence is the
// assertion: over a cyclic graph a fixpoint that did not dedup would not
// terminate. `select d.b` is a SET, so this is the reachable-node set. ──────
pub deem w_reach(g: &Writ) {
    rel dsc(a: i64, b: i64) {
        from g v join g x on x.parent == v.child where v.parent == 0 select (v.child, x.child);
        from dsc d join g x on x.parent == d.b select (d.a, x.child);
    }
    from dsc d select d.b
}
pub deem s_reach(e: &[DynEdge]) {
    rel dsc(a: i64, b: i64) {
        from e v join e x on x.parent == v.child where v.parent == 0 select (v.child, x.child);
        from dsc d join e x on x.parent == d.b select (d.a, x.child);
    }
    from dsc d select d.b
}

// ── (c) the two equal `seven` leaves: distinct ids under distinct parents ───
pub deem w_seven(g: &Writ)      { from g x where x.key == "seven" select (x.parent, x.child) }
pub deem s_seven(e: &[DynEdge]) { from e x where x.key == "seven" select (x.parent, x.child) }

// ── (d) the TOM's field edges, reached by a JOIN through the tom edge, with
// ORDER BY over the walk. idx is the 6-bit key CODE. ────────────────────────
pub deem w_tom(g: &Writ) {
    from g t join g f on f.parent == t.child
    where t.kind == "tom" select (f.idx, f.vi) order by f.idx
}
pub deem s_tom(e: &[DynEdge]) {
    from e t join e f on f.parent == t.child
    where t.kind == "tom" select (f.idx, f.vi) order by f.idx
}

// ── (e) GROUP BY … AGGREGATE over the walk: one raw type code for every
// map-kind edge, and the number of such EDGES. ─────────────────────────────
pub deem w_maptag(g: &Writ) {
    from g x where x.kind == "map" group by x.tag aggregate n = count() select (key, n)
}
pub deem s_maptag(e: &[DynEdge]) {
    from e x where x.kind == "map" group by x.tag aggregate n = count() select (key, n)
}
pub deem w_tomtag(g: &Writ)      { from g x where x.kind == "tom" select x.tag }
pub deem s_tomtag(e: &[DynEdge]) { from e x where x.kind == "tom" select x.tag }

fn eq_pairs(a: &Vec<(i64, i64)>, b: &Vec<(i64, i64)>) -> bool {
    if a.len() != b.len() { return false; }
    let mut i: i64 = 0i64;
    while i < a.len() {
        if a.get(i).0 != b.get(i).0 { return false; }
        if a.get(i).1 != b.get(i).1 { return false; }
        i = i + 1i64;
    }
    return true;
}

fn eq_i64(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    if a.len() != b.len() { return false; }
    let mut i: i64 = 0i64;
    while i < a.len() { if a.get(i) != b.get(i) { return false; } i = i + 1i64; }
    return true;
}

fn main() -> i32 {
    let d: Writ = writ_new(65536i64);

    // ── build the GRAPH by hand (the parser only makes trees) ───────────────
    //   root = { left: {...}, right: {...}, meta: <TOM> }
    //   shared = { x: 7 }            — child of BOTH left and right (DAG)
    //   left  = { seven: 7, s: shared }
    //   right = { seven: 7, s: shared, back: root }   — `back` closes a CYCLE
    let shared: &mut WMap<WString, WAny> = d.map(4i64);
    shared.set("x", 7i64);
    let left: &mut WMap<WString, WAny> = d.map(4i64);
    left.set("seven", 7i64);
    left.set("s", WAny::from(&*shared));
    let right: &mut WMap<WString, WAny> = d.map(4i64);
    right.set("seven", 7i64);
    right.set("s", WAny::from(&*shared));
    let meta: Meta = d.make::<Meta>();
    meta.alpha = 100i64;
    meta.beta = 200i64;
    let root: &mut WMap<WString, WAny> = d.map(8i64);
    root.set("left", WAny::from(&*left));
    root.set("right", WAny::from(&*right));
    root.set("meta", WAny::ref_to((meta.m as i64) as *const u8));
    right.set("back", WAny::from(&*root));      // the cycle
    let rootv: WAny = WAny::from(&*root);
    d.set_root(rootv);

    // THE TWO PRODUCERS, neither of them an interpreter.
    let st: Vec<WritEdgeRow> = writ_graph_edges(&d);
    let dyr: Vec<WritEdgeRow> = dyn_graph_edges(rootv, &d);
    let dy: Vec<DynEdge> = dyn_graph_edge_rows(rootv, &d);

    // total edges: VIRTUAL ROOT EDGE (0→root) = 1, root{left,right,meta}=3,
    // left{seven,s}=2, right{seven,s,back}=3, shared{x}=1 (EXPANDED ONCE),
    // meta{alpha,beta}=2 = 12 — termination + DAG-once in one number.
    if st.len()  != 12i64 { return 1i32; }
    if dyr.len() != 12i64 { return 2i32; }
    if dy.len()  != 12i64 { return 3i32; }

    // ── (f) PARITY over the whole relation, row for row, all eight columns ──
    let mut i: i64 = 0i64;
    while i < st.len() {
        let x: WritEdgeRow = st.get(i);
        let y: WritEdgeRow = dyr.get(i);
        if x.0 != y.0        { return 4i32; }
        if !str_eq(x.1, y.1) { return 5i32; }
        if x.2 != y.2        { return 6i32; }
        if x.3 != y.3        { return 7i32; }
        if !str_eq(x.4, y.4) { return 8i32; }
        if x.5 != y.5        { return 9i32; }
        if x.6 != y.6        { return 10i32; }
        if !str_eq(x.7, y.7) { return 11i32; }
        i = i + 1i64;
    }

    // ── (a) DAG: `s` edges from BOTH parents; shared child = ONE id ─────────
    let ws: Vec<(i64, i64)> = match w_s(&d)             { Result::Ok(v) => { v } Result::Err(_a) => { return 12i32; } };
    let ss: Vec<(i64, i64)> = match s_s(dy.as_slice())  { Result::Ok(v) => { v } Result::Err(_b) => { return 12i32; } };
    if ws.len() != 2i64 { return 13i32; }                 // two DISTINCT edges
    if ws.get(0i64).0 == ws.get(1i64).0 { return 14i32; } // different parents
    // (c-container) one shared identity across both edges, and it IS the handle
    if ws.get(0i64).1 != ws.get(1i64).1 { return 15i32; }
    if ws.get(0i64).1 != (WAny::from(&*shared).raw() as i64) { return 16i32; }
    if !eq_pairs(&ws, &ss) { return 17i32; }

    // shared's OWN child ("x") appears exactly once (expansion-once): one edge,
    // and its parent is the shared handle.
    let wx: Vec<(i64, i64)> = match w_x(&d)            { Result::Ok(v) => { v } Result::Err(_c) => { return 18i32; } };
    let sx: Vec<(i64, i64)> = match s_x(dy.as_slice()) { Result::Ok(v) => { v } Result::Err(_e) => { return 18i32; } };
    if wx.len() != 1i64 { return 19i32; }
    if wx.get(0i64).0 != (WAny::from(&*shared).raw() as i64) { return 20i32; }
    if !eq_pairs(&wx, &sx) { return 21i32; }

    // ── (b) cycle: the back edge exists and points AT the root's handle ─────
    let wb: Vec<i64> = match w_back(&d)            { Result::Ok(v) => { v } Result::Err(_f) => { return 22i32; } };
    let sb: Vec<i64> = match s_back(dy.as_slice()) { Result::Ok(v) => { v } Result::Err(_g) => { return 22i32; } };
    if wb.len() != 1i64 { return 23i32; }
    if wb.get(0i64) != (WAny::from(&*right).raw() as i64) { return 24i32; }
    if !eq_i64(&wb, &sb) { return 25i32; }

    // a recursive closure over the CYCLIC edge set converges, and its set is
    // the reachable-from-root nodes: left, right, meta, shared, root (via
    // back), and the leaves left.seven, right.seven, shared.x, meta.alpha,
    // meta.beta = 10.
    let wr: Vec<i64> = match w_reach(&d)            { Result::Ok(v) => { v } Result::Err(_i) => { return 26i32; } };
    let sr: Vec<i64> = match s_reach(dy.as_slice()) { Result::Ok(v) => { v } Result::Err(_j) => { return 26i32; } };
    if wr.len() != 10i64 { return 27i32; }
    if sr.len() != 10i64 { return 28i32; }

    // ── (c) leaf identity: the two `seven` leaves are DISTINCT ids ──────────
    let wv: Vec<(i64, i64)> = match w_seven(&d)            { Result::Ok(v) => { v } Result::Err(_k) => { return 29i32; } };
    let sv: Vec<(i64, i64)> = match s_seven(dy.as_slice()) { Result::Ok(v) => { v } Result::Err(_l) => { return 29i32; } };
    if wv.len() != 2i64 { return 30i32; }
    if wv.get(0i64).0 == wv.get(1i64).0 { return 31i32; }   // different parents
    if wv.get(0i64).1 == wv.get(1i64).1 { return 32i32; }   // DISTINCT ids
    if !eq_pairs(&wv, &sv) { return 33i32; }

    // ── (d) TOM expansion: field edges with idx = the key codes (0 and 3) ───
    let wt: Vec<(i64, i64)> = match w_tom(&d)            { Result::Ok(v) => { v } Result::Err(_m) => { return 34i32; } };
    let stm: Vec<(i64, i64)> = match s_tom(dy.as_slice()) { Result::Ok(v) => { v } Result::Err(_n) => { return 34i32; } };
    if wt.len() != 2i64 { return 35i32; }
    if wt.get(0i64).0 != 0i64   { return 36i32; }   // alpha @ key code 0
    if wt.get(0i64).1 != 100i64 { return 37i32; }
    if wt.get(1i64).0 != 3i64   { return 38i32; }   // beta  @ key code 3
    if wt.get(1i64).1 != 200i64 { return 39i32; }
    if !eq_pairs(&wt, &stm) { return 40i32; }

    // ── (e) tag column, via GROUP BY … AGGREGATE over the walk ─────────────
    // every map-kind edge carries the same raw type code, and it differs from
    // the tom edge's (open vocabulary, exact codes not hardcoded here).
    let wk: Vec<(i64, i64)> = match w_maptag(&d)            { Result::Ok(v) => { v } Result::Err(_o) => { return 41i32; } };
    let sk: Vec<(i64, i64)> = match s_maptag(dy.as_slice()) { Result::Ok(v) => { v } Result::Err(_p) => { return 41i32; } };
    if wk.len() != 1i64 { return 42i32; }           // ONE code for all maps
    // map-kind EDGES: virtual 0→root, root→left, root→right, left→s,
    // right→s, right→back = 6 (edges, not distinct nodes)
    if wk.get(0i64).1 != 6i64 { return 43i32; }
    if !eq_pairs(&wk, &sk) { return 44i32; }
    let map_tag: i64 = wk.get(0i64).0;

    let wtt: Vec<i64> = match w_tomtag(&d)            { Result::Ok(v) => { v } Result::Err(_q) => { return 45i32; } };
    let stt: Vec<i64> = match s_tomtag(dy.as_slice()) { Result::Ok(v) => { v } Result::Err(_r) => { return 45i32; } };
    if wtt.len() != 1i64 { return 46i32; }
    if wtt.get(0i64) == map_tag { return 47i32; }
    if !eq_i64(&wtt, &stt) { return 48i32; }

    return 0i32;
}
