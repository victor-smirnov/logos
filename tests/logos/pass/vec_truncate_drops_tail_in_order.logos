// `Vec::truncate` drops the removed tail front to back, after shrinking the
// length (Rust: `drop_in_place` over the tail slice). It dropped back to front.
// rustc 1.98.1 prints the same.
package vec_truncate_drops_tail_in_order;
use logos.std.fmt;
use logos.mem.collections.vec;
struct D { n: i64 }
impl Drop for D { fn drop(&mut self) { println!("drop {}", self.n); } }
fn main() {
    let mut v: Vec<D> = Vec::new();
    for i in 0..4 { v.push(D { n: i }); }
    v.truncate(1);
    println!("len {}", v.len());
    v.truncate(5);
    println!("end");
}
