// `5.into()` into M with `impl From<i64> for M` (through `impl<T, U: From<T>> Into<U> for T`): the literal takes the one integer type M's From impls accept (it defaulted to i32: 'M does not implement From').
package m; use logos.lang.convert;
struct M(i64);
struct N(i64);
impl From<i64> for M { fn from(x: i64) -> Self { M(x * 100) } }
impl From<u8> for N { fn from(x: u8) -> Self { N(x as i64 + 1) } }
fn main() -> i32 { let m: M = 5.into(); let n: N = 7.into(); let k = M::from(2); ((m.0 / 100) + n.0 + k.0 / 100) as i32 }
