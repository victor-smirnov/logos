// PHASE 2 AT N = 2 — THE COMPACT'S REFUSAL IS TRANSACTIONAL **ACROSS MEMBERS**,
// AND THAT IS THE ONE PROPERTY NO SINGLE-MEMBER FIXTURE CAN SEE.
//
// ── THE DECISION UNDER TEST, QUOTED FROM THE EMITTER ──────────────────────
// `emit_scc_od_fns` builds `_cpt` as TWO SEPARATE REPEATS over the SCC members:
// every member's read-only `OD ⊆ T` check runs (`cchk`), and only then does any
// member's write run (`cdo`). Its own comment states why:
//
//     "Every member's check runs before ANY member's compact, so a violation
//      found on member 2 cannot leave member 1 already rewritten. Interleaving
//      them would make the refusal non-transactional at N ≥ 2 while looking
//      IDENTICAL AT N = 1 — and N = 1 is the only shape with a witness
//      anywhere today."
//
// ⚠⚠ THAT LAST SENTENCE WAS TRUE WHEN IT WAS WRITTEN AND IS THE REASON THIS FILE
// EXISTS. The whole DRed fixture set runs on `tc`, a ONE-member SCC, where
// "check all, then write all" and "check-and-write per member" produce
// byte-identical code. The decision was therefore correct, documented, AND
// COMPLETELY UNWITNESSED: interleaving the two repeats left every test in the
// tree green. This file is the input on which the two shapes differ.
//
// ── THE SHAPE ─────────────────────────────────────────────────────────────
//     rel odd (a,b) :- es(a,b)
//     rel odd (a,b) :- even(a,c), es(c,b)
//     rel even(a,b) :- odd(a,c),  es(c,b)
//
// One SCC, two members, both with row type `(i64, i64)`. On `es = {1→2, 2→3}`:
//     T_odd  = [(1,2), (2,3)]        (the two length-1 paths; `even ⋈ es`
//                                     contributes nothing — (1,3) has no
//                                     outgoing edge from 3)
//     T_even = [(1,3)]               ((1,2) ⋈ (2,3))
//
// ── WHY THE REFUSING INPUT IS THE EXPENSIVE ONE ───────────────────────────
// The refusal cell hands `_cpt`:
//     OD_odd  = {(1,2)}   — a REAL row of T_odd, so member 0's check PASSES
//     OD_even = {(9,9)}   — a row `even` never held, so member 1's check FAILS
// `9→9` is not an edge of `es` and `(9,9)` is in neither total; `|T_even| −
// keep = 1 − 1 = 0 ≠ 1 = |OD_even|`, which is the refusal.
//
// ⚠ MEMBER 0 IS ALREADY COMMITTED-LOOKING BY THEN. Its check passed and its
// removal is REAL — an interleaved `_cpt` would have retained `[(2,3)]` and
// popped `(1,2)` before it ever looked at member 1, and `(1,2)` is then gone
// from the caller's Vec with no way back. So the assertion "T_odd is unchanged
// in content AND in order" is made about a total that the wrong implementation
// has already destroyed. A refusal that faulted on member 0 instead would make
// the same assertion pass FOR FREE — nothing had been written yet — which is
// why that CHEAP variant is also run below, and labelled as the one that proves
// nothing on its own.
//
// ── WHAT ELSE THIS FILE PINS ──────────────────────────────────────────────
//  · `__rm_<m>` — the negative delta, PER MEMBER, both under a success (cleared
//    then filled from T's order) and under a refusal (the caller's seed
//    survives). Seeded with (7,7)/(8,8) rather than left fresh: a fresh Vec
//    passes identically whether the callee clears, writes, or does neither.
//  · THE LATCH ORDER AT N = 2 — six i64, three per member in SIGNATURE order.
//    The two members' `|S|` differ (1 vs 0) on the successful input, so a
//    driver that bound the members' totals in the wrong order — which
//    TYPECHECKS, both row types being `(i64,i64)` — is caught here rather than
//    answering with the two relations exchanged.
//
// ── CONTROLS, MEASURED 2026-08-08 (archives dropped, whole stdlib rebuilt) ─
//  • THE TWO REPEATS INTERLEAVED — `cpt_body` rebuilt as one loop of
//    check-then-write per member instead of `#(cchk)* … #(cdo)*`.
//    → **exit 41** — the N=2 refusal cell: the call still refuses, `T_even` is
//    still intact, and `T_odd` has already been compacted to `[(2,3)]`.
//    PREDICTED BEFORE RUNNING AND MEASURED AT 41.
//    ⚠ AND THE OTHER HALF OF THAT MEASUREMENT: under the SAME control,
//    `wql_incr_rel_od_phase1`, `..._od_phase1_adv`, `..._od_phase3` and
//    `..._dred_product_random` ALL STAYED GREEN. Every one of them is a
//    one-member SCC, and this file is the only thing in the tree that speaks —
//    which is the measured form of "N = 1 cannot see this" and the reason the
//    decision needed a fixture rather than a comment.
//    ⚠ The control keeps `__lat.clear()` + the `__rm_` clears immediately after
//    the FIRST member's check, precisely so that at N = 1 the emitted body is
//    unchanged in every other respect: without that care the control would also
//    move the clear across the refusal and the single-member fixtures would go
//    red for an unrelated reason, and the "only this file speaks" claim above
//    would have been an artefact of the control rather than a fact about N.
//
// exit 0 = the successful compact leaves `S`, `rm` and six latches right for
// BOTH members; the member-1 refusal leaves both totals, both `rm` seeds and the
// latch seed byte-identical; and the member-0 refusal does too.
package test;

use logos.std.wql.wql;
use logos.std.wql.el;
use logos.lang.result;
use logos.mem.collections.vec;

struct E { pub a: i64, pub b: i64 }

pub deem oddq(es: &[E]) {
    rel odd(a: i64, b: i64) {
        from es e select (e.a, e.b);
        from even v join es e on v.b == e.a select (v.a, e.b);
    }
    rel even(a: i64, b: i64) {
        from odd o join es e on o.b == e.a select (o.a, e.b);
    }
    from odd p group by p.a aggregate c = count() select (key, c)
}

fn pair_has(p: &Vec<(i64, i64)>, a: i64, b: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < p.len() {
        let c: (i64, i64) = p.get(i);
        if c.0 == a && c.1 == b { return true; }
        i = i + 1i64;
    }
    return false;
}

fn seq_eq(x: &Vec<(i64, i64)>, y: &Vec<(i64, i64)>) -> bool {
    if x.len() != y.len() { return false; }
    let mut i: i64 = 0i64;
    while i < x.len() {
        let a: (i64, i64) = x.get(i);
        let b: (i64, i64) = y.get(i);
        if a.0 != b.0 || a.1 != b.1 { return false; }
        i = i + 1i64;
    }
    return true;
}

fn ed(a: i64, b: i64) -> E { return E { a: a, b: b }; }

fn edges() -> Vec<E> {
    let mut v: Vec<E> = vec_new::<E>();
    v.push(ed(1i64, 2i64)); v.push(ed(2i64, 3i64));
    return v;
}

fn pr(a: i64, b: i64) -> Vec<(i64, i64)> {
    let mut v: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    v.push((a, b));
    return v;
}

fn main() -> i32 {
    let es: Vec<E> = edges();

    // ══ THE PREVIOUS TOTALS, from the emitter's from-scratch driver ══════
    // Both members' totals are POSITIONAL out-params in registry order.
    let mut t_odd: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut t_even: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    match __wql_oddq_scc0(es.as_slice(), &mut t_odd, &mut t_even) {
        Result::Ok(_u) => { } Result::Err(_e) => { return 1i32; }
    }
    // Hand-computed, and asserted as exact SEQUENCES so a member swap is caught
    // before anything about `_cpt` is measured.
    let mut w_odd: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    w_odd.push((1i64, 2i64)); w_odd.push((2i64, 3i64));
    let mut w_even: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    w_even.push((1i64, 3i64));
    if !seq_eq(&t_odd, &w_odd)   { return 2i32; }
    if !seq_eq(&t_even, &w_even) { return 3i32; }

    // ══ CELL 1 — THE REFUSAL THAT FAULTS ON MEMBER **1**, AFTER MEMBER 0's
    // ══ CHECK HAS ALREADY PASSED. THE EXPENSIVE ONE. ═════════════════════
    let mut r_odd: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut r_even: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    match __wql_oddq_scc0(es.as_slice(), &mut r_odd, &mut r_even) {
        Result::Ok(_u) => { } Result::Err(_e) => { return 4i32; }
    }
    let od_odd_ok: Vec<(i64, i64)>  = pr(1i64, 2i64);   // REAL: member 0 passes
    let od_even_bad: Vec<(i64, i64)> = pr(9i64, 9i64);  // never held: member 1 faults
    // ⚠ SEEDED OUT OF RANGE. `rm` and `lat` are exactly the params a lazy
    // implementation would leave alone anyway; asked of fresh Vecs the
    // assertions below hold whatever the callee does. (7,7) and (8,8) are pairs
    // neither relation can contain (every row here has a < b ≤ 3), and 777 is
    // outside every latch's range.
    let mut rm_odd: Vec<(i64, i64)> = pr(7i64, 7i64);
    let mut rm_even: Vec<(i64, i64)> = pr(8i64, 8i64);
    let mut lat_b: Vec<i64> = vec_new::<i64>();
    lat_b.push(777i64);
    match __wql_oddq_scc0_cpt(od_odd_ok.as_slice(), od_even_bad.as_slice(),
                              &mut r_odd, &mut r_even,
                              &mut rm_odd, &mut rm_even, &mut lat_b) {
        Result::Ok(_u) => { return 40i32; }              // it must NOT succeed
        Result::Err(_e) => { }
    }
    // ⚠⚠ THE ASSERTION THIS FILE EXISTS FOR. Member 0's removal was legal and
    // its check passed; only the second member's did not. An interleaved
    // implementation has already retained `[(2,3)]` and popped `(1,2)` here.
    if !seq_eq(&r_odd, &w_odd)   { return 41i32; }
    if !seq_eq(&r_even, &w_even) { return 42i32; }
    // …and neither out-param was touched: transactional in the reports too.
    if rm_odd.len() != 1i64                  { return 43i32; }
    if !pair_has(&rm_odd, 7i64, 7i64)        { return 44i32; }
    if rm_even.len() != 1i64                 { return 45i32; }
    if !pair_has(&rm_even, 8i64, 8i64)       { return 46i32; }
    if lat_b.len() != 1i64                   { return 47i32; }
    if lat_b.get(0i64) != 777i64             { return 48i32; }

    // ══ CELL 2 — THE **CHEAP** REFUSAL, LABELLED AS SUCH ═════════════════
    // Member 0 faults, so nothing had been written when the refusal fired and
    // every assertion above would hold even for the interleaved shape. It is
    // here to pin that the check is per-member and fires from either position,
    // NOT as evidence about transactionality — that is cell 1's job, and this
    // cell is the control for reading cell 1 correctly.
    let mut c_odd: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut c_even: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    match __wql_oddq_scc0(es.as_slice(), &mut c_odd, &mut c_even) {
        Result::Ok(_u) => { } Result::Err(_e) => { return 50i32; }
    }
    let od_odd_bad: Vec<(i64, i64)> = pr(9i64, 9i64);
    let od_even_ok: Vec<(i64, i64)> = pr(1i64, 3i64);
    let mut rm2_odd: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut rm2_even: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut lat2: Vec<i64> = vec_new::<i64>();
    match __wql_oddq_scc0_cpt(od_odd_bad.as_slice(), od_even_ok.as_slice(),
                              &mut c_odd, &mut c_even,
                              &mut rm2_odd, &mut rm2_even, &mut lat2) {
        Result::Ok(_u) => { return 51i32; }
        Result::Err(_e) => { }
    }
    if !seq_eq(&c_odd, &w_odd)   { return 52i32; }
    if !seq_eq(&c_even, &w_even) { return 53i32; }

    // ══ CELL 3 — THE SUCCESSFUL N=2 COMPACT ══════════════════════════════
    // OD_odd = {(1,2)}, OD_even = {(1,3)} — both legal.
    //   S_odd  = [(2,3)]   rm_odd  = [(1,2)]
    //   S_even = []        rm_even = [(1,3)]
    //   lat    = [1, 1, -1,  1, 0, -1]    (|OD|,|S|,|RD| per member)
    // ⚠ THE TWO MEMBERS' `|S|` DIFFER (1 vs 0) AND THAT IS DELIBERATE. Both row
    // types are `(i64,i64)`, so binding the totals in the wrong order typechecks
    // and answers with the relations exchanged; the latch triple is the only
    // thing here that can tell odd from even.
    let mut s_odd: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    let mut s_even: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    match __wql_oddq_scc0(es.as_slice(), &mut s_odd, &mut s_even) {
        Result::Ok(_u) => { } Result::Err(_e) => { return 60i32; }
    }
    // SEEDED AGAIN, ON THE SUCCESS PATH — the path that had no witness for the
    // `clear`. A fresh Vec passes whether the callee clears or appends.
    let mut rm3_odd: Vec<(i64, i64)> = pr(7i64, 7i64);
    let mut rm3_even: Vec<(i64, i64)> = pr(8i64, 8i64);
    let mut lat3: Vec<i64> = vec_new::<i64>();
    lat3.push(555i64);
    match __wql_oddq_scc0_cpt(od_odd_ok.as_slice(), od_even_ok.as_slice(),
                              &mut s_odd, &mut s_even,
                              &mut rm3_odd, &mut rm3_even, &mut lat3) {
        Result::Ok(_u) => { } Result::Err(_e) => { return 61i32; }
    }
    let mut ws_odd: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    ws_odd.push((2i64, 3i64));
    let ws_even: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
    if !seq_eq(&s_odd, &ws_odd)   { return 62i32; }
    if !seq_eq(&s_even, &ws_even) { return 63i32; }
    // THE NEGATIVE DELTAS, per member, seeds cleared.
    let wr_odd: Vec<(i64, i64)> = pr(1i64, 2i64);
    let wr_even: Vec<(i64, i64)> = pr(1i64, 3i64);
    if !seq_eq(&rm3_odd, &wr_odd)   { return 64i32; }
    if !seq_eq(&rm3_even, &wr_even) { return 65i32; }
    // THE SIX LATCHES, in signature order — and the `555` seed gone with them.
    if lat3.len() != 6i64            { return 66i32; }
    if lat3.get(0i64) != 1i64        { return 67i32; }   // |OD_odd|
    if lat3.get(1i64) != 1i64        { return 68i32; }   // |S_odd|
    if lat3.get(2i64) != 0i64 - 1i64 { return 69i32; }   // |RD_odd| sentinel
    if lat3.get(3i64) != 1i64        { return 70i32; }   // |OD_even|
    if lat3.get(4i64) != 0i64        { return 71i32; }   // |S_even| — 0, not 1
    if lat3.get(5i64) != 0i64 - 1i64 { return 72i32; }   // |RD_even| sentinel

    return 0i32;
}
