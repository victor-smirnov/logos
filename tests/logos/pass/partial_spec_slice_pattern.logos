// C++-style partial specialization of a PLAIN struct with a SLICE pattern —
// the blessed divergence backing the unified PkdArray<T> (memoria): ONE name,
// two representations. `S<T>` (base, sized T) vs `S<[E]>` (spec) differ in
// FIELDS and in same-named METHODS; the spec governs its instantiations
// (base bounds do not apply to spec-matched args), impl selection prefers
// the more-specialized formal (C++ partial order), and mono instantiates
// struct AND method bodies from the spec.
package partial_spec_slice_pattern;

pub struct PkdA<T: Copy + ?Sized> {
    count: u32,
    x:     u32,
}

pub struct PkdA<[E]> {
    hdr: u64,
}

impl<T: Copy> PkdA<T> {
    pub fn tag(self: &PkdA<T>) -> u32 { return self.x; }
}

impl<E> PkdA<[E]> {
    pub fn tag(self: &PkdA<[E]>) -> u64 { return self.hdr; }
    pub fn twice(self: &PkdA<[E]>) -> u64 { return self.tag() * 2u64; }
}

fn main() -> i32 {
    let f: PkdA<u64> = PkdA::<u64> { count: 1u32, x: 7u32 };
    if f.tag() != 7u32 { return 1i32; }

    let v: PkdA<[u8]> = PkdA::<[u8]> { hdr: 9u64 };
    if v.tag() != 9u64 { return 2i32; }        // spec method, overlapping name
    if v.twice() != 18u64 { return 3i32; }     // spec method calling spec method

    // a second slice instantiation routes to the same spec
    let w: PkdA<[u64]> = PkdA::<[u64]> { hdr: 4u64 };
    if w.tag() != 4u64 { return 4i32; }
    return 0i32;
}
