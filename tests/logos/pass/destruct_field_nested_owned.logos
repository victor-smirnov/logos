// PIN (2026-09-04land, root 2): a NESTED struct pattern. The intermediate
// receiver is bound by value and must be told which of ITS fields were taken;
// pre-fix nothing was recorded for it, so the inner value was dropped twice
// (run rc 1, 2 destructor runs for 1 value).
// TWIN one token apart: destruct_field_nested_ref (`o: v` -> `o: ref v`).
package destruct_field_nested_owned;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
static mut N: i64 = 0i64;
struct Owner { k: i64 }
impl Drop for Owner { fn drop(self: Owner) { unsafe { N = N + 1i64; } } }
struct B { o: Owner }
struct A { b: B, t: i64 }
fn main() -> i32 {
    {
        let a: A = A { b: B { o: Owner { k: 7i64 } }, t: 2i64 };
        let A { b: B { o: v }, t: w } = a;
        if v.k + w != 9i64 { return 3i32; }
    }
    unsafe {
        printi("N=%d\n", N as i32);
        if N != 1i64 { return 1i32; }
    }
    return 0i32;
}
