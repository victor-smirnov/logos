// `impl Trait for <primitive>` with method dispatch via dot-call.
// Both `&self` (ref) and `self: *const Self` (raw pointer) styles work;
// A raw-pointer receiver is never made by autoref (as rustc): pass one explicitly.
package impl_trait_for_primitive;

trait DoubledRef { fn doubled_ref(&self) -> i32; }
impl DoubledRef for i32 { fn doubled_ref(&self) -> i32 { return *self * 2; } }

trait DoubledPtr { fn doubled_ptr(self: *const Self) -> i32; }
impl DoubledPtr for i32 { fn doubled_ptr(self: *const i32) -> i32 { unsafe { return (*self) * 2; } } }

fn main() -> i32 {
    let x: i32 = 7;
    return x.doubled_ref() + unsafe { (&x as *const i32).doubled_ptr() };
    // 14 + 14 = 28
}
