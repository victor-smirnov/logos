package vec_usage;
// Vec<T>: generic stack-allocated struct with inline array backing

struct Vec<T> {
    data: [T; 64],
    len: i64,
}

impl<T> Vec<T> {
    unsafe fn push(self: *mut Vec<T>, val: T) {
        self.data[self.len as u64] = val;
        self.len = self.len + 1;
    }
    unsafe fn get(self: *mut Vec<T>, i: i64) -> T {
        return self.data[i as u64];
    }
    unsafe fn len(self: *mut Vec<T>) -> i64 {
        return self.len;
    }
}

unsafe fn main() -> i32 {
    let mut v: Vec<i32> = Vec { data: [0; 64], len: 0 };
    v.push(10);
    v.push(20);
    v.push(12);
    let sum: i32 = v.get(0) + v.get(1) + v.get(2);
    return sum;  // 42
}
