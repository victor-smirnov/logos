// @Type in a small arena (hermes2: segments grow on demand — the tiny
// initial capacity is a stress, not a limit).
package hermes_typed_datatype_empty_params_small_zone;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.typed_value;
use logos.mem.hermes.parser;
use logos.mem.rc;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Hermes> = hermes_rc(256);     // deliberately tiny
    let h: &Hermes = rc.deref();
    let a: HAny = parse(h, "@I64=1");
    if a.is_null() { return 1; }
    if !str_eq(a.as_typed_value().type_name_str(), "I64") { return 2; }
    let b: HAny = parse(h, "@I64()=1");
    if b.is_null() { return 3; }
    if b.as_typed_value().has_params() { return 4; }
    return 0;
}
