// Empty params must not allocate a params array object.
// Regression: @Type() used to allocate-and-drop an unused ObjectArray.
package hermes_typed_datatype_empty_params_small_zone;

use hermes.ctr;

unsafe fn main() -> i32 {
    // This capacity is enough for @I64=1, and should also be enough for @I64()=1
    // once empty params stop allocating a temporary array.
    let mut d1: Hermes = Hermes::new(96);
    match d1.parse("@I64=1" as *const u8, 6 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 1; }
    }

    let mut d2: Hermes = Hermes::new(96);
    match d2.parse("@I64()=1" as *const u8, 8 as i64) {
        Result::Ok(()) => {}
        Result::Err(_) => { return 2; }
    }

    return 0;
}
