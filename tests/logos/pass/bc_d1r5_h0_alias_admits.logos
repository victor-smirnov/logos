// Admit twin for fail/bc_d1r5_h0_alias_out_param — read before the
// mutation, so NLL retires the loan. Pins that the alias rule extends a
// loan's LIFETIME; it does not make the reborrow a lexical borrow.
package bc_d1r5_h0_alias_admits;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn stash(c: &C, v: &mut Vec<B>) { let r: &mut Vec<B> = v; r.push(c.mk()); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    stash(&c, &mut vs);
    let x: i64 = *vs.get(0u64).p;
    c.bump();
    return x;
}
