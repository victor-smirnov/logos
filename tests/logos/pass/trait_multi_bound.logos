// Multiple trait bounds: T: A + B
package trait_multi_bound;

trait ToVal { fn to_val(self: Self) -> i32; }
trait Name  { fn name(self: Self) -> i32; }

struct Pair { x: i32, y: i32, }
impl ToVal for Pair { fn to_val(self: Pair) -> i32 { return self.x; } }
impl Name  for Pair { fn name(self: Pair) -> i32 { return self.y; } }

fn combine<T: ToVal + Name>(t: T) -> i32 {
    return t.to_val() + t.name();
}

unsafe fn main() -> i32 {
    let p: Pair = Pair { x: 20, y: 22 };
    return combine::<Pair>(p);
}
