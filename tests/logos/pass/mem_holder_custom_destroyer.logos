// Container RAII (hermes2 successor of the MemHolder custom-destroyer test):
// a Hermes2 container owns its arena; values live until the holder drops at
// scope end (RAII Drop), including through an Rc share.
package mem_holder_custom_destroyer;
use logos.lang.hermes2.container;
use logos.lang.hermes2.anyval;
use logos.mem.rc;

struct Blob { sentinel: u8, n: i64 }

unsafe fn sum_in(c: &Rc<Hermes2>) -> i64 {
    let h: &Hermes2 = c.deref();
    let hp: *mut Hermes2 = h as *const Hermes2 as *mut Hermes2;
    let b: *mut Blob = hermes2_alloc::<Blob>(hp);
    b.sentinel = 0xEE as u8;
    b.n = 41;
    if b.sentinel != 0xEE as u8 { return -1; }
    return b.n + 1;   // 42
}

unsafe fn main() -> i32 {
    // Inner scope: container + share are created and dropped (RAII).
    let mut got: i64 = 0;
    {
        let rc: Rc<Hermes2> = hermes2_rc(4096);
        let rc2: Rc<Hermes2> = rc.clone();
        got = sum_in(&rc2);
    }   // both handles drop -> arena freed exactly once (valgrind-clean suite)
    if got != 42 { return 1; }
    return 0;
}
