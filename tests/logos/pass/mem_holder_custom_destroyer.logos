// MemHolder with a user-provided buffer + custom destroyer — exercises
// the ownership/allocation split: the holder manages lifetime via RC but
// never calls malloc/free on the buffer itself.
//
// The destroyer writes a sentinel byte into the buffer's last slot so
// main() can tell (via the retained pointer) that it fired exactly once
// on RC = 0.  This sidesteps needing mutable statics / closures.
package mem_holder_custom_destroyer;

use logos.lang.hermes.mem_holder;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

// Writes 0xEE into buf[capacity-1] then leaves the buffer alive — the
// test harness frees it manually after inspecting the sentinel.
unsafe fn mark_sentinel(buf: *mut u8, capacity: i64) {
    let slot: *mut u8 = (buf as i64 + capacity - 1 as i64) as *mut u8;
    *slot = 0xEE as u8;
}

unsafe fn main() -> i32 {
    let buf: *mut u8 = malloc(128);
    if buf == 0 as *mut u8 { return 1; }
    // Zero the sentinel cell up-front so we can tell if the destroyer ran.
    let sentinel: *mut u8 = (buf as i64 + 127 as i64) as *mut u8;
    *sentinel = 0 as u8;

    let h: *mut MemHolder = memholder_wrap(buf, 128, mark_sentinel);
    if h == 0 as *mut MemHolder { return 2; }
    if h.rc != 1 as i32         { return 3; }

    // Bump allocator works on the user-provided buffer.
    let a: *mut u8 = memholder_alloc(h, 32);
    if a == 0 as *mut u8        { return 4; }
    if h.used != 32 as i64      { return 5; }

    // Retain → release pair: destroyer must NOT fire yet.
    memholder_retain(h);           // rc = 2
    memholder_release(h);          // rc = 1
    if *sentinel != 0 as u8     { return 6; }

    // Final release → rc = 0 → destroyer fires.
    memholder_release(h);
    if *sentinel != 0xEE as u8  { return 7; }

    // Clean up the buffer ourselves — the destroyer only wrote a marker.
    free(buf);
    return 0;
}
