// Compiles and runs as in rustc 1.98.1 (squeue row of the same name).
package generic_ref_typevar_ordering_mlir_verifier_refused;
use logos.lang.cmp;
fn less<T: Ord>(a: &T, b: &T) -> bool {
    return a < b;
}
fn main() -> i32 {
    let x: i64 = 3i64;
    let y: i64 = 8i64;
    if less::<i64>(&y, &x) { return 1i32; }
    if !less::<i64>(&x, &y) { return 2i32; }
    return 0i32;
}
