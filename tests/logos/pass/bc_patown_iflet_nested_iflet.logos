package bc_patown_iflet_nested_iflet;

struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let o: Option<Option<S>> = Option::Some(Option::Some(S { v: 1i64, i: p }));
        if let Option::Some(inner) = o { if let Option::Some(r) = inner { let _k: i64 = eat(r); } }
    }
    return c as i32;
}
