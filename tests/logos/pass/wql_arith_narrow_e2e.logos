// WQL — AN INTEGER ARITHMETIC NODE HAS ITS OPERANDS' TYPE, AS IN LOGOS (Rust typing).
//
// `s.w + 1` over a `u32` column is a `u32`: the literal takes its type from the
// other side, and the node's type is what Logos would give the same expression.
// The node is COMPUTED in its tower (`el_add`/… over i64) and brought back into
// its own type by a range check per node (`el_fit_i`), so a value outside the
// type is an `ElError` — never a wrapped value, and never a silently wider one.
//
// Until 2026-10-02 the node's type was the tower's (`i64`): `s.w + 1` returned
// `Vec<i64>`, `u32 + u32` past u32::MAX answered with the exact i64 sum, and
// `-s.w` over a `u32` was a negative i64. That was SQL-style promotion; the EL now
// types like the language it is embedded in, so all three changed meaning:
//
//   1. `u32 + literal`: a `u32`, exact while it fits;
//   2. `u32 + u32` past u32::MAX: `Err(Overflow)` — the sum no longer widens;
//   3. `(i8 + 100) - 100`: `Err(Overflow)` on the INTERMEDIATE value, because the
//      check runs per node, not once at the end;
//   4. `u8 - 1` below zero: `Err(Underflow)`, the unsigned floor crossed;
//   5. `order by` an arithmetic key: the key vector is the node's type (`u32`);
//   6. `f32 * float literal` still computes in f64 — the float half of Rust typing
//      is the next slice, and this claim moves with it.
//
// `-s.w` over an unsigned column is refused, as Rust refuses it:
// wql_arith_unsigned_neg_fail (u32) and wql_arith_u64_neg_fail (u64).
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.std.wql.el;    // ElError — the faults are asserted by NAME

struct Rec { pub id: i64, pub w: u32, pub f: f32, pub s: i8, pub b: u8 }

pub deem plus(src: &[Rec])   { from src s select s.w + 1 }
pub deem twice(src: &[Rec])  { from src s select s.w + s.w }
pub deem roundt(src: &[Rec]) { from src s select (s.s + 100) - 100 }
pub deem dec(src: &[Rec])    { from src s select s.b - 1 }
pub deem scaled(src: &[Rec]) { from src s select s.f * 2.0 }
pub deem by_sum(src: &[Rec]) { from src s select s.id order by s.w + 1 }

fn main() -> i32 {
    let rs: [Rec; 2] = [
        Rec { id: 1i64, w: 4000000000u32, f: 1.5f32, s: 100i8, b: 0u8 },
        Rec { id: 2i64, w: 7u32,          f: 0.5f32, s: 1i8,   b: 9u8 },
    ];
    let small: [Rec; 1] = [ Rec { id: 3i64, w: 7u32, f: 0.5f32, s: 1i8, b: 9u8 } ];

    // 1. u32 + 1: a u32, exact.
    let a: Vec<u32> = plus(&rs[..]).unwrap();
    if a.len() != 2i64              { return 1i32; }
    if a.get(0i64) != 4000000001u32 { return 2i32; }
    if a.get(1i64) != 8u32          { return 3i32; }

    // 2. u32 + u32: 14 when it fits, Overflow when it does not.
    let b: Vec<u32> = twice(&small[..]).unwrap();
    if b.get(0i64) != 14u32 { return 4i32; }
    match twice(&rs[..]) {
        Result::Err(ElError::Overflow) => { }
        _ => { return 5i32; }
    }

    // 3. the intermediate i8 value 200 overflows even though the result would fit.
    let r: Vec<i8> = roundt(&small[..]).unwrap();
    if r.get(0i64) != 1i8 { return 12i32; }
    match roundt(&rs[..]) {
        Result::Err(ElError::Overflow) => { }
        _ => { return 13i32; }
    }

    // 4. u8 0 - 1 crosses the floor.
    let d1: Vec<u8> = dec(&small[..]).unwrap();
    if d1.get(0i64) != 8u8 { return 14i32; }
    match dec(&rs[..]) {
        Result::Err(ElError::Underflow) => { }
        _ => { return 15i32; }
    }

    // 6. f32 * 2.0 computed in f64 (the float slice moves this claim).
    let c: Vec<f64> = scaled(&rs[..]).unwrap();
    if c.get(0i64) != 3.0f64 { return 6i32; }
    if c.get(1i64) != 1.0f64 { return 7i32; }

    // 5. an arithmetic sort key of the node's type.
    let d: Vec<i64> = by_sum(&rs[..]).unwrap();
    if d.get(0i64) != 2i64 { return 8i32; }
    if d.get(1i64) != 1i64 { return 9i32; }

    return 0i32;
}
