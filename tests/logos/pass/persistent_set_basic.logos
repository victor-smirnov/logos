// Tests std.data.persistent.set — PSet over a Primitive key.
// Exercises insert/contains/remove and snapshot CoW through the
// underlying PMap<K, PSetUnit> wrapper.
package test;

use std.data.persistent.set;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;

pub struct U64Key { pub x: u64 }
impl Primitive for U64Key { type Prim = u64; }
impl Ord for U64Key {
    fn cmp(&self, other: &Self) -> Ordering {
        if self.x < other.x { return Ordering::Less; }
        if self.x > other.x { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

fn ki(v: u64) -> U64Key { return U64Key { x: v }; }

fn main() -> i32 {
    let mut s: PSet<U64Key> = pset_new::<U64Key>();

    let k1: U64Key = ki(10u64);
    let k2: U64Key = ki(20u64);
    let k3: U64Key = ki(30u64);
    let k4: U64Key = ki(40u64);
    let k5: U64Key = ki(50u64);
    let k6: U64Key = ki(60u64);

    // Fresh inserts return false (not previously present).
    if  pset_insert::<U64Key>(&mut s, 10u64, &k1 as *const U64Key) { return 1; }
    if  pset_insert::<U64Key>(&mut s, 20u64, &k2 as *const U64Key) { return 2; }
    if  pset_insert::<U64Key>(&mut s, 30u64, &k3 as *const U64Key) { return 3; }
    if  pset_insert::<U64Key>(&mut s, 40u64, &k4 as *const U64Key) { return 4; }
    if  pset_insert::<U64Key>(&mut s, 50u64, &k5 as *const U64Key) { return 5; }
    if  pset_insert::<U64Key>(&mut s, 60u64, &k6 as *const U64Key) { return 6; }
    if pset_len::<U64Key>(&s) != 6u64 { return 7; }

    // Membership.
    if !pset_contains::<U64Key>(&s, &k1 as *const U64Key) { return 8; }
    if !pset_contains::<U64Key>(&s, &k4 as *const U64Key) { return 9; }
    if !pset_contains::<U64Key>(&s, &k6 as *const U64Key) { return 10; }
    let miss: U64Key = ki(99u64);
    if  pset_contains::<U64Key>(&s, &miss as *const U64Key) { return 11; }

    // Re-insert is idempotent (returns true = was present, len unchanged).
    if !pset_insert::<U64Key>(&mut s, 30u64, &k3 as *const U64Key) { return 12; }
    if pset_len::<U64Key>(&s) != 6u64 { return 13; }

    // Snapshot is preserved across mutation.
    let mut snap: PSet<U64Key> = pset_snapshot::<U64Key>(&s);
    if !pset_remove::<U64Key>(&mut s, &k3 as *const U64Key) { return 14; }
    if pset_len::<U64Key>(&s) != 5u64 { return 15; }
    if  pset_contains::<U64Key>(&s, &k3 as *const U64Key) { return 16; }
    // Snapshot still holds k3.
    if !pset_contains::<U64Key>(&snap, &k3 as *const U64Key) { return 17; }
    if pset_len::<U64Key>(&snap) != 6u64 { return 18; }

    // Remove of a missing key returns false, no state change.
    if pset_remove::<U64Key>(&mut s, &miss as *const U64Key) { return 19; }
    if pset_len::<U64Key>(&s) != 5u64 { return 20; }

    pset_drop::<U64Key>(&mut snap);
    pset_drop::<U64Key>(&mut s);
    return 42;
}
