// Test: String growth via realloc — stringify several values into a String
// starting with small capacity so that grow() is triggered and data is
// preserved correctly.

package hermes_stringbuf_grow;

use hermes.zone;
use hermes.anyval;
use hermes.typetag;
use hermes.datatag;
use hermes.array;
use hermes.map;
use hermes.typed_value;
use hermes.objectmap;
use hermes.document;
use hermes.stringify;
use std.string;

unsafe fn main() -> i32 {
    // Set up a zone with a DocumentHeader.
    let mut zone: Zone<Mutable> = zone_create(4096 as i64);
    let base: *mut u8 = zone.holder.base;
    let hdr_raw: *mut u8 = zone_m_alloc_raw(&mut zone, 8 as i64);
    let doc: *mut DocumentHeader = document_create(hdr_raw);

    // Build an ObjectArray with 20 i32 values so the stringified output
    // exceeds the String's initial small capacity.
    let oa_sz: i64 = sizeof::<ObjectArray>() as i64;
    let oa_raw: *mut u8 = zone_m_alloc_tagged(&mut zone, oa_sz, hermes_tag_array() as u64);
    let oa_buf: *mut u8 = zone_m_alloc_raw(&mut zone, 20 as i64 * 4 as i64);
    let arr: *mut ObjectArray = ObjectArray::init(oa_raw, oa_buf, base, 20 as u64);

    // Push integers 0..19
    let mut i: i64 = 0 as i64;
    while i < 20 as i64 {
        arr.push(zone.holder, AnyVal::embed_i24(i as i32));
        i = i + 1 as i64;
    }

    // Set document root to the array.
    let arr_off: u32 = (oa_raw as i64 - base as i64) as u32;
    document_set_root(doc, AnyVal::from_offset(arr_off));

    // Stringify into a String starting with zero capacity (will grow).
    let mut sb: String = String::new();
    stringify_document(base as *const u8, &mut sb, StringifyOpts::compact());

    // The output must be non-empty (at least "[0,1,...,19]" = many bytes).
    if sb.len() < 20 as i64 { return 1; }

    // First byte must be '[' (91).
    if *((sb.as_ptr() as i64 + 0) as *const u8) != 91 as u8 { return 2; }

    // Last byte must be ']' (93).
    let last_idx: i64 = sb.len() - 1 as i64;
    if *((sb.as_ptr() as i64 + last_idx) as *const u8) != 93 as u8 { return 3; }

    // Capacity must be at least as large as the length.
    if sb.capacity() < sb.len() { return 4; }

    zone.release();
    return 42;
}
