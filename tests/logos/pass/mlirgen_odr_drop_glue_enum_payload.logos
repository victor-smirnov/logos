// PAIR: mlirgen_odr_drop_glue_enum_payload_ctl, one token apart.
package test;
struct String { pub a: i64 }
enum Wrap { W(String), N }
fn main() -> i32 {
    let mut ys: Vec<Wrap> = Vec::<Wrap>::new();
    ys.push(Wrap::W(String{a:9i64}));
    let mut n: i64 = 0i64;
    match ys.borrow(0u64) {
        Wrap::W(s) => { n = s.a; }
        Wrap::N => { n = 1i64; }
    }
    return n as i32;
}
