// Deep clone of typed dense containers (hermes2): typed arrays + typed maps
// copy raw payloads into the destination zone, equal + separate.
package hermes_typed_container_clone;
use logos.lang.hermes.hstatic;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.mem.hermes.clone;
use logos.mem.hermes.equal;
use logos.mem.rc;

unsafe fn root_of(hs: &HermesStatic) -> HAny {
    let base: *const u8 = hs.ptr;
    let w: i64 = *(base as *const i64);
    if w == 0i64 { return HAny::Ref(0i64 as *const u8); }
    if (w & 1i64) == 1i64 { return HAny::Pod(w as u64); }
    return HAny::Ref((base as i64 + w) as *const u8);
}

unsafe fn main() -> i32 {
    // 1. Typed array.
    let s1: HermesStatic = @<I32>[1, 2, 3];
    let r1: HAny = root_of(&s1);
    let c1: Rc<Hermes> = hermes_clone(r1);
    let h1: &Hermes = c1.deref();
    if !hermes_equal(r1, h1.root()) { return 1; }
    if h1.root().resolve() == r1.resolve() { return 2; }

    // 2. Typed map with mixed values — wait, typed maps hold AnyVal values.
    let s2: HermesStatic = @<I64, AnyVal>{5: 50, 6: "six"};
    let r2: HAny = root_of(&s2);
    let c2: Rc<Hermes> = hermes_clone(r2);
    let h2: &Hermes = c2.deref();
    if !hermes_equal(r2, h2.root()) { return 3; }

    // 3. Mutating the clone leaves the (rodata) source untouched & unequal.
    let croot: HAny = h1.root();
    let p: *mut u8 = croot.resolve() as *mut u8;
    let df: i64 = (p as i64) + 16;
    let elems: i64 = df + *(df as *const i64);
    *(elems as *mut i32) = 99;
    if hermes_equal(r1, croot) { return 4; }

    return 0;
}
