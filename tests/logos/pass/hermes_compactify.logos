// Document compactify (GC-by-copying) tests
//
// Each test:
//   1. Builds a document (parse or builder).
//   2. Calls compactify() to get a fresh compacted copy.
//   3. Verifies the compacted copy stringifies identically to the original.
//   4. (Where possible) verifies that the compacted zone is smaller or equal.
package hermes_compactify;
use std.hermes.ctr;
use std.hermes.anyval;
use std.hermes.decimal;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    // ── 1. Null root: compactify of an empty builder ──────────────────────
    let src1: Hermes = Hermes::builder(4096);
    let dst1: Hermes = src1.compactify();
    // root is null in both; stringify should produce "null"
    let mut buf1: String = String::with_capacity(64);
    dst1.stringify(&mut buf1);
    if !buf1.eq_str("null") { return 1; }

    // ── 2. Scalar integer root ────────────────────────────────────────────
    let mut src2: Hermes = Hermes::new(4096);
    match src2.parse("42") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 2; }
    }
    let dst2: Hermes = src2.compactify();
    let mut buf2: String = String::with_capacity(64);
    dst2.stringify(&mut buf2);
    if !buf2.eq_str("42") { return 3; }

    // ── 3. String root ────────────────────────────────────────────────────
    let mut src3: Hermes = Hermes::new(4096);
    match src3.parse("\"hello\"") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 4; }
    }
    let dst3: Hermes = src3.compactify();
    let mut buf3: String = String::with_capacity(64);
    dst3.stringify(&mut buf3);
    if !buf3.eq_str("\"hello\"") { return 5; }

    // ── 4. Array root ─────────────────────────────────────────────────────
    let mut src4: Hermes = Hermes::new(4096);
    match src4.parse("[1, 2, 3]") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 6; }
    }
    let dst4: Hermes = src4.compactify();
    let mut buf4: String = String::with_capacity(64);
    dst4.stringify(&mut buf4);
    if !buf4.eq_str("[1,2,3]") { return 7; }

    // ── 5. Map root ───────────────────────────────────────────────────────
    let mut src5: Hermes = Hermes::new(4096);
    match src5.parse("{\"x\": 10, \"y\": 20}") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 8; }
    }
    let dst5: Hermes = src5.compactify();
    let mut buf5o: String = String::with_capacity(64);
    let mut buf5d: String = String::with_capacity(64);
    src5.stringify(&mut buf5o);
    dst5.stringify(&mut buf5d);
    if !buf5d.eq_string(&buf5o) { return 9; }

    // ── 6. Nested document ────────────────────────────────────────────────
    let mut src6: Hermes = Hermes::new(4096);
    match src6.parse("{\"a\": [1, 2], \"b\": {\"c\": true}}") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 10; }
    }
    let dst6: Hermes = src6.compactify();
    let mut buf6o: String = String::with_capacity(128);
    let mut buf6d: String = String::with_capacity(128);
    src6.stringify(&mut buf6o);
    dst6.stringify(&mut buf6d);
    if !buf6d.eq_string(&buf6o) { return 11; }

    // ── 7. compactify with explicit capacity hint ─────────────────────────
    let mut src7: Hermes = Hermes::new(4096);
    match src7.parse("[true, false, null]") {
        Result::Ok(()) => {}
        Result::Err(_) => { return 12; }
    }
    let dst7: Hermes = src7.compactify(512 as i64);
    let mut buf7: String = String::with_capacity(64);
    dst7.stringify(&mut buf7);
    if !buf7.eq_str("[true,false,null]") { return 13; }

    // ── 8. Compactify preserves Decimal typed value ───────────────────────
    let mut src8: Hermes = Hermes::builder(4096);
    let dv8: AnyVal = src8.decimal_from(10 as i32, 2 as i32, "123.45");
    if dv8.is_null() { return 14; }
    src8.set_root(dv8);
    let dst8: Hermes = src8.compactify();
    let view8: DecimalView = dst8.decimal_view(dst8.root());
    if view8.is_null() { return 15; }
    let s8: String = view8.to_string_value();
    if !s8.eq_str("123.45") { return 16; }

    return 0;
}
