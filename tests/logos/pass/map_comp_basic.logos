package map_comp_basic;

use logos.mem.collections.hashmap;

fn main() -> i32 {
    let arr: [i32; 5] = [1, 2, 3, 4, 5];

    // Map comp: keys = value, vals = value*value.
    let mut sq = {x: x * x for x in arr};

    // With guard: only evens.
    let mut ev = {x: x * 10 for x in arr if (x % 2) == 0};

    unsafe {
        let ps: *mut HashMap<i32, i32> = &mut sq;
        let pe: *mut HashMap<i32, i32> = &mut ev;

        if (*ps).len() != 5 as i64 { return 1; }
        if (*pe).len() != 2 as i64 { return 2; }

        let k1: i32 = 3;
        let p: Option<&i32> = (*ps).get(&k1);
        if p.is_none() { return 3; }
        if *p.unwrap() != 9 { return 4; }

        let k2: i32 = 4;
        let pv: Option<&i32> = (*pe).get(&k2);
        if pv.is_none() { return 5; }
        if *pv.unwrap() != 40 { return 6; }

        let k3: i32 = 3;
        if (*pe).contains_key(&k3) { return 7; }
    }

    return 42;
}
