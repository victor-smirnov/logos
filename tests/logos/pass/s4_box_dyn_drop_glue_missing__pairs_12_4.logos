// ADR 0030 S4 acceptance: feature-interaction audit cluster `box-dyn-drop-glue-missing`, member pairs-12_4
// (tests/interactions/clusters/box-dyn-drop-glue-missing/pairs-12_4.logos); rustc 1.98.1 twin gives the same stdout and exit code.
package m03w;
use logos.std.compiler.metaprog;
use logos.mem.collections.vec;
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.btree;
use logos.mem.collections.btreeset;
use logos.mem.collections.deque;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.std.fmt;
use logos.std.io;
use logos.lang.cmp;
use logos.lang.rc;
use logos.lang.iter;
use logos.mem.boxed;
use logos.lang.ops;
use logos.lang.mem;
use logos.lang.hash;
use logos.lang.cell;
use logos.lang.ptr;
trait Tag { fn tag(&self) -> i32; }
struct A(i32);
struct B { v: i32 }
impl Tag for A { fn tag(&self) -> i32 { return self.0; } }
impl Tag for B { fn tag(&self) -> i32 { return self.v * 2; } }
impl Drop for A { fn drop(&mut self) { println!("dropA {}", self.0); } }
impl Drop for B { fn drop(&mut self) { println!("dropB {}", self.v); } }
struct Hold<T> { x: Option<T> }
impl<T> Hold<T> { fn put(&mut self, v: T) { self.x = Some(v); } }
fn main() {
    let mut h: Hold<Box<dyn Tag>> = Hold { x: None };
    h.put(Box::new(A(2)));
    let mut v: Vec<Box<dyn Tag>> = Vec::new();
    v.push(Box::new(B { v: 3 }));
    println!("end");
}
