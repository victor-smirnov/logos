// Generic trait with both required and default methods
package trait_generic_default;
trait Convert<T> {
    fn convert(self: Self) -> T;
    fn tag(self: Self) -> i32 { return 1; }
}
struct Num { v: i32, }
impl Convert<i32> for Num {
    fn convert(self: Num) -> i32 { return self.v; }
}
unsafe fn main() -> i32 {
    let n: Num = Num { v: 41 };
    return n.convert() + n.tag();
}
