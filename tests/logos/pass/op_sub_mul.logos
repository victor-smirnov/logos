package op_sub_mul;
// F26: operator overloading for Sub and Mul
trait Sub { fn sub(self: Self, rhs: Self) -> Self; }
trait Mul { fn mul(self: Self, rhs: Self) -> Self; }

struct Vec2 { x: i32; y: i32; }

impl Sub for Vec2 {
    fn sub(self: Vec2, rhs: Vec2) -> Vec2 {
        return Vec2 { x: self.x - rhs.x, y: self.y - rhs.y };
    }
}
impl Mul for Vec2 {
    fn mul(self: Vec2, rhs: Vec2) -> Vec2 {
        return Vec2 { x: self.x * rhs.x, y: self.y * rhs.y };
    }
}

unsafe fn main() -> i32 {
    let a: Vec2 = Vec2 { x: 10, y: 8 };
    let b: Vec2 = Vec2 { x: 4, y: 2 };
    let c: Vec2 = a - b;   // {6, 6}
    let d: Vec2 = c * c;   // {36, 36}
    // 36 + 36 - 30 = 42
    return d.x + d.y - 30;
}
