// `==` over non-primitive operands compares VALUES through the elements' `Eq`, never addresses (squeue row; rustc 1.98.1: exit 0).
package array_nonprim_elem_eq_compares_addresses_run;
use logos.lang.cmp;
struct S { v: i64, c: *mut i64 }
impl Drop for S {
    fn drop(self: &mut S) {
        unsafe { *self.c = *self.c + 1i64; }
    }
}
impl Eq for S {
    fn eq(&self, other: &S) -> bool {
        return self.v == other.v;
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut part: i32 = 0i32;
    {
        let a: [S; 2] = [S { v: 1i64, c: p }, S { v: 2i64, c: p }];
        let b: [S; 2] = [S { v: 1i64, c: p }, S { v: 2i64, c: p }];
        let ra: &[S; 2] = &a;
        let rb: &[S; 2] = &b;
        if !(ra == rb) { part = 2i32; }
    }
    {
        let a: [S; 2] = [S { v: 1i64, c: p }, S { v: 2i64, c: p }];
        let b: [S; 2] = [S { v: 1i64, c: p }, S { v: 2i64, c: p }];
        if !(a == b) { part = 1i32; }
    }
    let got: i64 = unsafe { n };
    if got != 8i64 { return 10i32 + got as i32; }
    if part != 0i32 { return part; }
    let x: [[i64; 2]; 2] = [[1i64, 2i64], [3i64, 4i64]];
    let y: [[i64; 2]; 2] = [[1i64, 2i64], [3i64, 4i64]];
    if x != y { return 3i32; }
    return 0i32;
}
