// ADR 0030's HIR pass desugars `if let`, `while let` and let-chains into
// MATCH / LOOP before sema sees a body; sema no longer has a branch for them
// (a surface form reaching it is an internal error). Every position: a
// statement, an expression (with `else if` / `else if let` chains), a let
// chain with a boolean segment, a labeled `while let` chain with `break`.
package hir_let_forms_in_every_position;

fn f(o: Option<i64>, p: Option<i64>) -> i64 {
    let mut acc: i64 = 0;
    if let Some(x) = o { acc = acc + x; } else { acc = acc + 100; }
    let v = if let Some(y) = p { y * 2 } else if acc > 50 { 7 } else { 8 };
    acc = acc + v;
    if let Some(a) = o && let Some(b) = p && a < b { acc = acc + 1000; }
    let w = if let Some(a) = o && a > 0 { a } else { 0 };
    let mut stack: Vec<i64> = vec![1, 2, 3];
    while let Some(t) = stack.pop() { acc = acc + t; }
    let mut n: i64 = 3;
    'outer: while let Some(q) = Some(n) && q > 0 { n = n - 1; if n == 1 { break 'outer; } }
    let mut clause: i64 = 0;
    if let None = o { clause = 1; } else if 4 > 5 { clause = 2; } else if let Some(_) = p { clause = 3; } else { clause = 4; }
    return acc + w + n + clause;   // 1 + 10 + 1000 + 1 + 6 + 1 + 3
}

fn main() -> i32 {
    if f(Some(1), Some(5)) != 1022 { return 1; }
    return 42;
}
