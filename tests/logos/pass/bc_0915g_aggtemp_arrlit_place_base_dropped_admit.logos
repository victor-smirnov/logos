// soundness queue row aggregate_literal_temp_place_base_never_dropped_run — CLOSED by round 2026-09-15g-aggtemp, commit of this fixture.
// asserts: an array-literal temporary in a place position is now OWNED by the statement and dropped: k=10 n=11 (base n=0, exit 1)
// legality: rustc 1.98.1 --edition 2024, twin cited in the round's rust/ directory; measured, not read.
package bc_0915g_aggtemp_arrlit_place_base_dropped_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut k: i64 = 0i64;
    {
        k = [D { v: 1i64, c: p }, D { v: 10i64, c: p }][1].v;
    }
    let got: i64 = unsafe { n };
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 10i64 { return 2i32; }
    if got != 11i64 { return 1i32; }
    return 0i32;
}
