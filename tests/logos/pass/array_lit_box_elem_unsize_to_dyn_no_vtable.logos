// Compiles and runs as in rustc 1.98.1; valgrind clean (squeue row of the same name).
package array_lit_box_elem_unsize_to_dyn_no_vtable;
struct D { v: i64 }
trait Tr { fn get(self: &Self) -> i64; }
impl Tr for D { fn get(self: &D) -> i64 { return self.v; } }
fn main() -> i32 {
    let b1: Box<D> = Box::new(D { v: 1i64 });
    let b2: Box<D> = Box::new(D { v: 10i64 });
    let arr: [Box<dyn Tr>; 2] = [b1, b2];
    if arr[0].get() + arr[1].get() != 11i64 { return 1i32; }
    return 0i32;
}
