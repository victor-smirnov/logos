// A reference parameter read after `&x`: pointer identity through a cast, a field, a method, a
// call, a generic version, and write-through via `&mut &mut`. rustc 1.98.1 prints the same line.
package param_ref_reads_after_addr_of;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64 }
impl D { fn get(&self) -> i64 { return self.v; } }
fn h(a: &&D) -> *const D { let x: &D = *a; return x as *const D; }
fn hg<T>(a: &&T) -> *const T { let x: &T = *a; return x as *const T; }
fn rd(x: &D) -> i64 { return x.v; }
fn g(x: &D) -> i64 {
    let same: bool = h(&x) == x as *const D;
    let s: i64 = if same { 1i64 } else { 0i64 };
    return s * 1000i64 + x.v * 100i64 + x.get() * 10i64 + rd(x);
}
fn gg<T>(x: &T) -> bool { return hg(&x) == x as *const T; }
fn wm(mut p: &mut D) -> i64 { let pp: &mut &mut D = &mut p; (**pp).v = 5i64; return p.v; }
fn main() -> i32 {
    let d: D = D { v: 3i64 };
    let mut e: D = D { v: 1i64 };
    let w: i64 = wm(&mut e);
    unsafe { printf("%lld %d %lld %lld\n".as_ptr(), g(&d), gg(&d) as i32, w, e.v); }
    return 0i32;
}
