// THE VALUE DOMAIN, MEASURED ACROSS THE THREE ENGINES — a fixture, not a claim.
//
// The query compiler's value domain is written THREE times and only one of them
// is the language's type system:
//   1. rel COLUMNS      — the Logos type + a `Hash` trait query (ADR 0024 S1/S2);
//   2. EXPRESSIONS      — `el_ty_stored` in stdlib/mem/wql/el.logos, 21 rows
//                         keyed on the type NAME;
//   3. THE RUNTIME      — `enum RtVal { I(i64), F(f64), B(bool), S(str), … }` in
//                         stdlib/mem/deem/deem.logos:793 — no widths, no user
//                         types, ONE float arm.
// Everything below is a CONSEQUENCE of (3) being narrower than (1) and (2), and
// every number in it was produced by running this program. Nothing here is
// inferred from a table.
//
// ⚠ CLOSED 2026-08-04 (f32) AND 2026-08-05 (u64 `order by`). NO ARM IN THIS FILE
// ASSERTS A WRONG ANSWER ANY MORE. Every one of them was written as "what the
// engine DOES, beside the value it OUGHT to produce", the OUGHT recorded before
// any fix existed; each fix then made this file RED at exactly the arm it fixed
// and reproduced the recorded OUGHT, and the arm was rewritten to it. That is
// the whole discipline and it is why the numbers below are evidence rather than
// a transcript: nothing here was re-read off a run.
//
// ⚠ THE ROOTS WERE NOT `RtVal`, EITHER TIME. f32 was one accessor reading eight
// bytes out of a four-byte box. u64 was a CATALOG that emitted the column as
// `"ty":"i64"`, destroying its signedness before any comparison site could ask —
// so the comparator had two `RtVal::I` and no type, and adding an `RtVal` arm
// would have closed neither. The remedy is the column's own type name on the
// blob, `ElTy.ord` derived from it once, and `el_wrap_ord_key` consumed at the
// comparison seams.
//
// ── WHAT WAS MEASURED (1066 TYPE x POSITION x TIER cells, each a compile and,
//    where it compiled, a run) ────────────────────────────────────────────────
//   • THE ROOT, and it is one line: `WAny::as_f64` (stdlib/lang/writ/anyval.logos
//     :329) dereferences the boxed payload as an `f64` WITHOUT asking the Ref's
//     own type code, which distinguishes W_F32=30 from W_F64=31 and which
//     `is_float()` twenty lines above DOES read. A boxed f32 therefore comes back
//     as an f64 whose BITS are the f32's bits — a denormal ~5.1e-315. The dynamic
//     tier reads every float column through it (`deem/tpl.logos`, `fn field_read`, guarded by
//     `t == EL_TY_FLT()`, a class tag that cannot tell 32 from 64), so every f32
//     answer in the dynamic AND incremental tiers is silently garbage.
//   • u64/usize above 2^63 arrive as NEGATIVE i64 in the dynamic and incremental
//     tiers (`WAny::as_i64` → `RtVal::I`) — that much is unchanged and is the
//     reason the read-back path still spells 2^64-1 as -1. What WAS wrong and is
//     now fixed is every ORDERED comparison built on it: `order by` ranked such a
//     value below zero and `max` answered the smaller value. The STATIC emitter
//     always got the same query right, and still refuses the aggregate positions
//     outright with a diagnostic — that refusal is NOT on this axis and did not
//     move (`sum` over u64 is a separate, untaken semantics decision).
//   • The incremental engine REFUSES an equi-join on an f32 or f64 key that the
//     dynamic engine ACCEPTS (the LOOP tier).
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.wmap;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.wql.wql;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.lang.num.float;

pub schema U : code(0x0E60_0000_0000_0001) { x: u64 = 0, id: i64 = 1 }
pub schema G : code(0x0E60_0000_0000_0002) { y: f32 = 0, id: i64 = 1 }
pub schema H : code(0x0E60_0000_0000_0003) { z: f64 = 0, id: i64 = 1 }
resource cat = schema_catalog!{ U, G, H };

// The STATIC engine, over the same two columns.
struct SU { pub x: u64, pub id: i64 }
struct SG { pub y: f32, pub id: i64 }
pub deem su_order(ss: &[SU]) { from ss s select s.id order by s.x }
pub deem sg_sel(ss: &[SG])   { from ss s select s.y }

fn mku(d: &Writ, xv: u64, i: i64) -> WAny {
    let r: U = d.make::<U>(); r.x = xv; r.id = i;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn mkg(d: &Writ, yv: f32, i: i64) -> WAny {
    let r: G = d.make::<G>(); r.y = yv; r.id = i;
    return WAny::ref_to((r.m as i64) as *const u8);
}
fn mkh(d: &Writ, zv: f64, i: i64) -> WAny {
    let r: H = d.make::<H>(); r.z = zv; r.id = i;
    return WAny::ref_to((r.m as i64) as *const u8);
}

fn main() -> i32 {
    let d: Writ = writ_new(32768i64);
    let c: SchemaCatalog = cat();

    // ══ 1. THE ROOT, WITH NO QUERY IN THE WAY ═════════════════════════════════
    // A schema field holding 0.1f32, read three ways off the SAME WAny.
    let gr: G = d.make::<G>(); gr.y = 0.1f32; gr.id = 0i64;
    let gm: &WMap<Wu6, WAny> = unsafe { &*gr.m };
    let gv: WAny = gm.get(0u8);
    if !gv.is_float()                                { return 10i32; }  // the code KNOWS it is a float
    if f32_to_bits(gv.as_f32()) != 0x3DCCCCCDu32     { return 11i32; }  // CORRECT: 4-byte read
    // ✅ CLOSED 2026-08-04 (slice A). `as_f64` used to read 8 bytes and never ask
    // W_F32 vs W_F64, so this answered the f32 pattern zero-extended,
    // 0x000000003DCCCCCD = 1036831949 — a denormal. The OUGHT below was written
    // before any fix existed and is bit-for-bit what the dispatch produced.
    //   0.1f32 widened = 0x3FB999999A000000 = 4591870180174331904
    if f64_to_bits(gv.as_f64()) != 4591870180174331904u64 { return 12i32; }
    // and the f64 field beside it is exact, which is why nothing had noticed.
    let hr: H = d.make::<H>(); hr.z = 0.1f64; hr.id = 0i64;
    let hm: &WMap<Wu6, WAny> = unsafe { &*hr.m };
    if f64_to_bits(hm.get(0u8).as_f64()) != f64_to_bits(0.1f64) { return 13i32; }

    // ══ 2. THE STATIC EMITTER IS CORRECT ON BOTH COLUMNS ══════════════════════
    let us: [SU; 3] = [SU { x: 5u64,                    id: 0i64 },
                       SU { x: 18446744073709551615u64, id: 1i64 },
                       SU { x: 9223372036854775808u64,  id: 2i64 }];
    let so: Vec<i64> = su_order(&us[..]).unwrap();
    if so.len() != 3i64     { return 20i32; }
    if so.get(0i64) != 0i64 { return 21i32; }   // 5
    if so.get(1i64) != 2i64 { return 22i32; }   // 2^63
    if so.get(2i64) != 1i64 { return 23i32; }   // 2^64-1

    let gs: [SG; 1] = [SG { y: 0.1f32, id: 0i64 }];
    let sg: Vec<f32> = sg_sel(&gs[..]).unwrap();
    if sg.len() != 1i64                        { return 24i32; }
    if f32_to_bits(sg.get(0i64)) != 0x3DCCCCCDu32 { return 25i32; }

    // ══ 3. THE DYNAMIC ENGINE, SAME TWO QUERIES ═══════════════════════════════
    let ua: &mut WArray<WAny> = d.array(4i64);
    ua.push(mku(&d, 5u64, 0i64));
    ua.push(mku(&d, 18446744073709551615u64, 1i64));
    ua.push(mku(&d, 9223372036854775808u64, 2i64));
    let ga: &mut WArray<WAny> = d.array(4i64);
    ga.push(mkg(&d, 1.0f32, 0i64));
    ga.push(mkg(&d, 2.0f32, 0i64));
    let gb: &mut WArray<WAny> = d.array(4i64);
    gb.push(mkg(&d, 1.0f32, 0i64));
    let ha: &mut WArray<WAny> = d.array(4i64);
    ha.push(mkh(&d, 1.5f64, 0i64));
    let hb: &mut WArray<WAny> = d.array(4i64);
    hb.push(mkh(&d, 1.5f64, 0i64));
    let mut e: QEnv = QEnv::new();
    e.bind_source("us", WAny::ref_to(ua as *const WArray<WAny> as *const u8));
    e.bind_source("gs", WAny::ref_to(ga as *const WArray<WAny> as *const u8));
    e.bind_source("gt", WAny::ref_to(gb as *const WArray<WAny> as *const u8));
    e.bind_source("hs", WAny::ref_to(ha as *const WArray<WAny> as *const u8));
    e.bind_source("ht", WAny::ref_to(hb as *const WArray<WAny> as *const u8));

    // ✅ CLOSED 2026-08-05 — u64 `order by` in the interpreter. It ranked by the
    // SIGNED reinterpretation (ids 2, 1, 0: i64::MIN < -1 < 5) while the STATIC
    // emitter twenty lines above answered ids 0, 2, 1 over the same three values.
    // The OUGHT asserted here is that same static answer, which is why this is a
    // DIFFERENTIAL and not a second opinion: the two tiers now agree, and the
    // static block above is the independent oracle for it.
    let qo: Query = match Query::compile("from us s select s.id order by s.x", &c) {
        Result::Ok(v) => { v } Result::Err(_e1) => { return 30i32; } };
    let ro: QRows = match qo.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e2) => { return 31i32; } };
    if ro.row_count() != 3i64        { return 32i32; }
    if ro.get_i64(0i64, 0i64) != 0i64 { return 33i32; }   // 5
    if ro.get_i64(1i64, 0i64) != 2i64 { return 34i32; }   // 2^63
    if ro.get_i64(2i64, 0i64) != 1i64 { return 35i32; }   // 2^64-1

    // ✅ CLOSED 2026-08-04 (slice A) — `sum` over an f32 column, dynamic tier.
    // It used to add two denormals and answer 0x000000007F800000 = 2139095040.
    let qs: Query = match Query::compile("from gs s group by s.id aggregate a = sum(s.y) select a", &c) {
        Result::Ok(v) => { v } Result::Err(_e3) => { return 40i32; } };
    let rs: QRows = match qs.run(&e) {
        Result::Ok(v) => { v } Result::Err(_e4) => { return 41i32; } };
    if rs.row_count() != 1i64                          { return 42i32; }
    if f64_to_bits(rs.get_f64(0i64, 0i64)) != 4613937818241073152u64 { return 43i32; }

    // ══ 4. THE INCREMENTAL ENGINE ═════════════════════════════════════════════
    // ⚠ THIS BLOCK NEVER MEASURED A CROSS-ROW `max` AND ITS OLD LABEL SAID IT
    // DID. `group by s.id` over three rows with three distinct ids gives THREE
    // ONE-ROW GROUPS, so each group's `max` is that row's own value and no
    // comparison between 5 and 2^64-1 ever happened here — the block was green
    // before the 2026-08-05 fix and is green after it, and the "answers the
    // SMALLER value" caption belonged to `wql_domain_incr_disagreement` block 1,
    // which really does put both values in one group. What this block DOES pin is
    // worth keeping and is now stated correctly: a one-row group's `max` is that
    // row's value for every value, INCLUDING 2^64-1, which reads back as -1. That
    // is the SEED canary — a min/max seed outside the order the fold compares in
    // would win against the single row and answer a value present in no row (the
    // f64 half of exactly this defect is on record at `exec.logos`'s seed block).
    let qm: Query = match Query::compile(
        "from us s group by s.id aggregate a = max(s.x) select (key, a)", &c) {
        Result::Ok(v) => { v } Result::Err(_e5) => { return 50i32; } };
    let gm2: IncrJoin = match qm.incremental(&e) {
        Result::Ok(v) => { v } Result::Err(_e6) => { return 51i32; } };
    if gm2.had_error()  { return 52i32; }
    let rm: QRows = gm2.snapshot();
    // group by s.id gives one group per row here; the 2^64-1 row is its own group
    // and its max is that row's value, read back as -1.
    if rm.row_count() != 3i64          { return 53i32; }
    let mut seen_neg1: bool = false;
    let mut i: i64 = 0i64;
    while i < rm.row_count() {
        if rm.get_i64(i, 1i64) == -1i64 { seen_neg1 = true; }
        i = i + 1i64;
    }
    if !seen_neg1 { return 54i32; }

    // ══ 5. ADMISSIBILITY DISAGREES BETWEEN THE TWO RUNTIME TIERS ══════════════
    // An f32 equi-join: the dynamic engine takes it (LOOP tier — PartialEq is
    // enough), the incremental engine refuses it. Same query text, same catalog,
    // same env — two different answers to "is this type allowed here".
    let qjf: Query = match Query::compile(
        "from gs x join gt y on x.y == y.y select (x.id, y.id)", &c) {
        Result::Ok(v) => { v } Result::Err(_e7) => { return 60i32; } };
    match qjf.run(&e) {
        Result::Ok(_r)   => { }                       // dynamic: ACCEPTED
        Result::Err(_e8) => { return 61i32; }
    }
    match qjf.incremental(&e) {
        Result::Ok(_g)   => { return 62i32; }         // incremental: REFUSED
        Result::Err(_e9) => { }
    }
    // and the same for f64.
    let qjd: Query = match Query::compile(
        "from hs x join ht y on x.z == y.z select (x.id, y.id)", &c) {
        Result::Ok(v) => { v } Result::Err(_ea) => { return 63i32; } };
    match qjd.run(&e) {
        Result::Ok(_r2)  => { }                       // dynamic: ACCEPTED
        Result::Err(_eb) => { return 64i32; }
    }
    match qjd.incremental(&e) {
        Result::Ok(_g2)  => { return 65i32; }         // incremental: REFUSED
        Result::Err(_ec) => { }
    }

    return 0i32;
}
