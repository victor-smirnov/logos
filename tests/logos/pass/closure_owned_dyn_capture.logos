// A `move` closure OWNING a `Box<dyn Tr>`, returned as `Box<dyn Fn() -> i64>` and
// called after its defining fn returned (Rust: 59). An escaping move closure now
// owns an owning `Box<dyn>` capture by value — sema's `owned_by_closure` and
// mlir-gen's `capture_own_inline` agree (the probe `clowndyn` retired) — in a
// 16-byte {data, vtable} env field (the 8-byte handle slot overflowed the env).
// valgrind clean. Twin: tests/logos/pass/closure_owned_dyn_capture_drops_once.logos.
package closure_owned_dyn_capture;
trait Tr { fn m(self: &Self) -> i64; }
struct S { v: i64 }
impl Tr for S {
    fn m(self: &Self) -> i64 { return self.v; }
}
fn f(b: Box<dyn Tr>) -> Box<dyn Fn() -> i64> {
    return Box::new(move || { return b.m(); });
}
fn main() -> i32 {
    let g: Box<dyn Fn() -> i64> = f(Box::new(S { v: 59i64 }));
    let got: i64 = g();
    if got != 59i64 {
        return 1i32;
    }
    return 0i32;
}
