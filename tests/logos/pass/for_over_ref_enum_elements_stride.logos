package for_over_ref_enum_elements_stride;
use logos.mem.collections.vec;
use logos.lang.iter;
use logos.lang.option;
enum Op { Add(i64), Mul(i64) }
fn main() -> i32 {
    let v: Vec<Option<i64>> = vec![Some(1), Some(2), Some(3)];
    let mut n: i64 = 0;
    for p in &v { if let Some(x) = p { n += *x; } }
    if n != 6 { return 1; }
    let ops = [Op::Add(5), Op::Mul(3), Op::Add(1)];
    let mut acc: i64 = 1;
    for op in &ops { match op { Op::Add(k) => { acc = acc + *k; } Op::Mul(k) => { acc = acc * *k; } } }
    if acc != 19 { return 2; }
    let s: &[Option<i64>] = &v;
    let mut m: i64 = 0;
    for p in s { if let Some(x) = p { m = m * 10 + *x; } }
    if m != 123 { return 3; }
    return 0;
}
