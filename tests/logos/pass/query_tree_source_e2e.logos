// query_tree_source_e2e — VIRTUAL TREE SOURCES (bind_source_tree, QB_TSRC).
// The no-gratuitous-materialization rule made executable: a JSON-like Writ
// document is queried DIRECTLY — the scan is a preorder walk emitting one row
// per edge (parent/child = node handles, key/idx, kind, vi/vs) — no fact
// tables, no numbering pass, nothing persistent besides the document itself.
// Asserts:
//   (a) flat scan — edge count, kind filter, key filter (typed str column);
//   (b) vi/vs LENIENT cells — scalar harvest + Null propagation (a map edge's
//       vi is Null ⇒ comparison false ⇒ row dropped, no error);
//   (c) hash-join tier — parent/child are TYPED i64 ⇒ a self-join on handles
//       takes the hash cascade (grandchildren via e1.child == e2.parent);
//   (d) RECURSION over the virtual source — rel dsc(a,b) computes subtree
//       membership straight off the document; subtree leaf harvest dsc ⋈ tree;
//   (e) ORACLE — (c) and (d) agree with a hand-walked reference over the same
//       parsed document (independent traversal, no Deem);
//   (f) the incremental paths REJECT a tree source with a named error
//       (virtual = re-scan; no delta capture).
// Exit 0 iff every assertion holds; a nonzero code names the first failure.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.wmap;
use logos.lang.writ.wstring;
use logos.mem.writ.parser;
use logos.lang.rc;
use logos.std.wql.ir;
use logos.mem.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

// ── independent reference walk (the oracle): count edges, str leaves, and
// the subtree edge-set under a named top-level section ──────────────────────
struct Ref {
    pub edges:     i64,
    pub str_vals:  i64,
    pub i64_leaves: i64,
}

unsafe fn ref_walk(v: WAny, r: &mut Ref) {
    if v.is_map() {
        let m: &WMap<WString, WAny> = v.as_map();
        let ns: i64 = m.slots();
        let mut s: i64 = 0i64;
        while s < ns {
            if !m.key_at(s).is_null() {
                r.edges = r.edges + 1i64;
                let cv: WAny = m.val_at(s);
                if cv.is_string() { r.str_vals = r.str_vals + 1i64; }
                if cv.is_int()    { r.i64_leaves = r.i64_leaves + 1i64; }
                ref_walk(cv, r);
            }
            s = s + 1i64;
        }
        return;
    }
    if v.is_array() {
        let a: &WArray<WAny> = v.as_array();
        let mut i: i64 = 0i64;
        while i < a.len() {
            r.edges = r.edges + 1i64;
            let cv: WAny = a.get(i);
            if cv.is_string() { r.str_vals = r.str_vals + 1i64; }
            if cv.is_int()    { r.i64_leaves = r.i64_leaves + 1i64; }
            ref_walk(cv, r);
            i = i + 1i64;
        }
    }
}

// count i64 leaves under `v` (subtree oracle for (d))
unsafe fn ref_ints_under(v: WAny) -> i64 {
    let mut n: i64 = 0i64;
    if v.is_map() {
        let m: &WMap<WString, WAny> = v.as_map();
        let ns: i64 = m.slots();
        let mut s: i64 = 0i64;
        while s < ns {
            if !m.key_at(s).is_null() {
                let cv: WAny = m.val_at(s);
                if cv.is_int() { n = n + 1i64; }
                n = n + ref_ints_under(cv);
            }
            s = s + 1i64;
        }
        return n;
    }
    if v.is_array() {
        let a: &WArray<WAny> = v.as_array();
        let mut i: i64 = 0i64;
        while i < a.len() {
            let cv: WAny = a.get(i);
            if cv.is_int() { n = n + 1i64; }
            n = n + ref_ints_under(cv);
            i = i + 1i64;
        }
    }
    return n;
}

fn run_count(q: &Query, env: &QEnv) -> i64 {
    match q.run(env) {
        Result::Ok(rows) => { return rows.row_count(); }
        Result::Err(_e)  => { return 0i64 - 1i64; }
    }
}

fn main() -> i32 {
    let rc: Rc<Writ> = unsafe { writ_rc(65536i64) };
    let h: &Writ = rc.deref();
    let doc: WAny = unsafe { parse(h,
        r#"{
            service: "api",
            replicas: 3,
            ports: [8080, 8443],
            db:    { engine: "pg", host: "db1", pool: { min: 2, max: 16 } },
            cache: { engine: "redis", host: "c1" },
            debug: false
        }"#) };

    let mut rf: Ref = Ref { edges: 0i64, str_vals: 0i64, i64_leaves: 0i64 };
    unsafe { ref_walk(doc, &mut rf); }

    let c: SchemaCatalog = SchemaCatalog::new();   // no schemas needed
    let mut env: QEnv = QEnv::new();
    env.bind_source_tree("tree", doc);

    // ── (a) flat scans ──────────────────────────────────────────────────────
    let q_all: Query = match Query::compile("from tree e select e.child", &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    // +1: the VIRTUAL ROOT EDGE (parent 0 → root) — the root is queryable
    if run_count(&q_all, &env) != rf.edges + 1i64 { return 2i32; }

    let q_maps: Query = match Query::compile(
        r#"from tree e where e.kind == "map" select e.child"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e2) => { return 3i32; } };
    if run_count(&q_maps, &env) != 4i64 { return 4i32; }   // ROOT(virtual), db, cache, pool

    // key filter over the TYPED str column
    let q_eng: Query = match Query::compile(
        r#"from tree e where e.key == "engine" select e.vs"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e3) => { return 5i32; } };
    match q_eng.run(&env) {
        Result::Ok(rows) => {
            if rows.row_count() != 2i64 { return 6i32; }
            // both cells are non-null strings (pg / redis)
            if rows.is_null(0i64, 0i64) || rows.is_null(1i64, 0i64) { return 7i32; }
        }
        Result::Err(_e4) => { return 8i32; }
    }

    // ── (b) vi lenient cells: i64 harvest + Null-propagation drop ───────────
    let q_ints: Query = match Query::compile(
        "from tree e where e.vi >= 2 select (e.key, e.vi)", &c)
    { Result::Ok(v) => { v } Result::Err(_e5) => { return 9i32; } };
    // i64 leaves ≥ 2: replicas 3, ports 8080+8443, pool.min 2, pool.max 16 = 5
    // (map/arr/str/bool-false edges all fail the compare via Null/false — no error)
    if run_count(&q_ints, &env) != 5i64 { return 10i32; }

    // ── (c) hash self-join on typed handles: grandchild edges of the root ───
    // root handle = the parsed doc's raw word; e1: root→X, e2: X→Y
    let root_h: i64 = doc.raw() as i64;
    let mut env2: QEnv = QEnv::new();
    env2.bind_source_tree("tree", doc);
    env2.bind_i64("root", root_h);
    let q_gc: Query = match Query::compile(
        "from tree e1 join tree e2 on e2.parent == e1.child where e1.parent == root select e2.child", &c)
    { Result::Ok(v) => { v } Result::Err(_e6) => { return 11i32; } };
    // grandchildren: ports[0],ports[1], db.{engine,host,pool}, cache.{engine,host} = 7
    let gc: i64 = run_count(&q_gc, &env2);
    if gc != 7i64 { return 12i32; }

    // ── (d) recursion over the virtual source: subtree i64-leaf harvest ─────
    let q_db: Query = match Query::compile(
        r#"from tree e where e.key == "db" select e.child : i64"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e7) => { return 13i32; } };
    let db_h: i64 = match q_db.run(&env)
    { Result::Ok(rows) => { if rows.row_count() != 1i64 { return 14i32; } rows.get_i64(0i64, 0i64) }
      Result::Err(_e8) => { return 15i32; } };

    let q_sub: Query = match Query::compile(
        r#"rel dsc(a: i64, b: i64) {
             from tree e select (e.parent, e.child);
             from dsc d join tree e on e.parent == d.b select (d.a, e.child);
           }
           from dsc d join tree e on e.child == d.b
           where d.a == start && e.kind == "i64" select e.vi"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e9) => { return 16i32; } };
    let mut env3: QEnv = QEnv::new();
    env3.bind_source_tree("tree", doc);
    env3.bind_i64("start", db_h);
    let sub_ints: i64 = run_count(&q_sub, &env3);
    // ── (e) oracle agreement ────────────────────────────────────────────────
    let want_ints: i64 = unsafe {
        // resolve db node again by reference walk: root map → "db"
        let m: &WMap<WString, WAny> = doc.as_map();
        ref_ints_under(m.get("db"))
    };
    if want_ints != 2i64 { return 17i32; }         // pool.min, pool.max
    if sub_ints != want_ints { return 18i32; }

    // ── (f) incremental paths reject the virtual source, by name ────────────
    match q_sub.incremental_rec(&env3) {
        Result::Ok(_e10)  => { return 19i32; }
        Result::Err(er) => {
            if !str_contains(er.message(), "tree source") { return 20i32; }
        }
    }

    return 0i32;
}
