// derive(Clone) via the stdlib hook in logos.std.compiler.metaprog.
// Exercises `#[derive_clone]` registration from the library, no local hook.
// Covers both non-generic structs and `<T, ...>` generics.

package main;

use logos.std.compiler.metaprog;
use logos.lang.clone;

#[derive_clone]
struct PairS { a: i32, b: i64 }

#[derive_clone]
struct TripS { x: i32, y: i32, z: i32 }

#[derive_clone]
struct GenPairS<T> { x: T, y: T }

unsafe fn main() -> i32 {
    let p: PairS = PairS { a: 7, b: 100 };
    let q: PairS = p.clone();
    if q.a != 7 { return 11; }
    if q.b != (100 as i64) { return 12; }

    let t: TripS = TripS { x: 1, y: 2, z: 3 };
    let u: TripS = t.clone();
    if u.x != 1 { return 21; }
    if u.y != 2 { return 22; }
    if u.z != 3 { return 23; }

    let g: GenPairS<i32> = GenPairS { x: 41, y: 42 };
    let h: GenPairS<i32> = g.clone();
    if h.x != 41 { return 31; }
    if h.y != 42 { return 32; }
    return 0;
}
