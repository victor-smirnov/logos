// pmap_point_ops_full.logos — end-to-end coverage of the
// componentized PMap v2 surface after the bt/ split:
//
//   • PMap construction via PMapMut on a CFG=4-fanout map.
//   • Point ops: insert (new + upsert), contains, get, len, remove.
//   • Snapshot via Store: begin / commit / checkout / rollback.
//   • Iteration on a snapshot (forward + reverse), with the leaf iter
//     exposing leaves only — caller walks own j over leaf.keys/vals.
//   • CoW: post-commit mutation does not perturb a held snapshot view.

package main;

use std.data.persistent.view;
use std.data.persistent.mutv;
use std.data.persistent.btree;
use std.data.persistent.iter;
use std.data.persistent.cfg;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.compiler.metaprog;
use std.hermes.ctr;
use std.hermes.view;
use std.hermes.anyval;

pub struct U64Key { pub x: u64, }
impl Primitive for U64Key { type Prim = u64; }
impl Ord for U64Key {
    fn cmp(&self, other: &Self) -> Ordering {
        if self.x < other.x { return Ordering::Less; }
        if self.x > other.x { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

pub struct U64Val { pub x: u64, }
impl Primitive for U64Val { type Prim = u64; }

fn ki(v: u64) -> U64Key { return U64Key { x: v }; }

pub const Cfg4: HermesStatic = @{
    "key":    <type:U64Key>,
    "value":  <type:U64Val>,
    "fanout": 4,
};

pub type MyView = PMapView<Cfg4>;
pub type MyMap  = PMapMut<Cfg4>;

unsafe fn main() -> i32 {
    let cfg: HermesStatic = @{
        "key": <type:U64Key>, "value": <type:U64Val>, "fanout": 4,
    };
    if validate_pmap_cfg(cfg) != 0 { return 1; }

    // Build with 12 ordered keys (10..120) — fanout=4 ⇒ several leaves.
    let mut pm: MyMap = pmap_mut_new::<Cfg4>();
    let pmptr: *mut MyMap = &mut pm as *mut MyMap;

    let mut i: u64 = 0u64;
    while i < 12u64 {
        let v: u64 = (i + 1u64) * 10u64;
        let k: U64Key = ki(v);
        let _ = pmap_mut_insert::<Cfg4>(pmptr, v, v * 7u64, &k as *const U64Key);
        i = i + 1u64;
    }
    if pm.view.len() != 12u64 { return 2; }

    // Point ops: contains hit / miss, get, upsert, remove.
    let k50: U64Key = ki(50u64);
    let k99: U64Key = ki(99u64);
    if !pm.view.contains(&k50 as *const U64Key) { return 10; }
    if  pm.view.contains(&k99 as *const U64Key) { return 11; }
    let mut out: u64 = 0u64;
    if !pm.view.get(&k50 as *const U64Key, &mut out as *mut u64) { return 12; }
    if out != 350u64 { return 13; }
    // Upsert (replace-on-hit): same k50, new value.
    if !pmap_mut_insert::<Cfg4>(pmptr, 50u64, 5555u64, &k50 as *const U64Key) { return 14; }
    if pm.view.len() != 12u64 { return 15; }
    if !pm.view.get(&k50 as *const U64Key, &mut out as *mut u64) { return 16; }
    if out != 5555u64 { return 17; }
    // Remove.
    let k30: U64Key = ki(30u64);
    if !pmap_mut_remove::<Cfg4>(pmptr, &k30 as *const U64Key) { return 18; }
    if pm.view.len() != 11u64 { return 19; }
    if  pm.view.contains(&k30 as *const U64Key) { return 20; }
    // Re-insert k30 so we have 12 again for iter/snapshot tests.
    let _ = pmap_mut_insert::<Cfg4>(pmptr, 30u64, 210u64, &k30 as *const U64Key);

    // Snapshot via pmap.view's snapshot helper.
    let mut snap: MyView = pmap_mut_snapshot::<Cfg4>(pmptr as *const MyMap);
    if snap.len() != 12u64 { return 30; }
    // Mutate live → snapshot must not move.
    let _ = pmap_mut_insert::<Cfg4>(pmptr, 50u64, 9999u64, &k50 as *const U64Key);
    if !pm.view.get(&k50 as *const U64Key, &mut out as *mut u64) { return 31; }
    if out != 9999u64 { return 32; }
    if !snap.get(&k50 as *const U64Key, &mut out as *mut u64) { return 33; }
    if out != 5555u64 { return 34; }

    // Iter forward over the snapshot.
    let mut it: LeafIter<U64Key, U64Val, Cfg4> = pmap_view_acquire_leaf_iter::<Cfg4>(&snap as *const MyView);
    let itp: *mut LeafIter<U64Key, U64Val, Cfg4> = &mut it as *mut LeafIter<U64Key, U64Val, Cfg4>;
    let mut prev: u64 = 0u64;
    let mut sum_keys: u64 = 0u64;
    let mut sum_vals: u64 = 0u64;
    let mut count: u64 = 0u64;
    while leaf_iter_valid::<U64Key, U64Val, Cfg4>(itp as *const LeafIter<U64Key, U64Val, Cfg4>) {
        let leaf: *mut LeafNode<U64Key, U64Val, Cfg4> = leaf_iter_leaf::<U64Key, U64Val, Cfg4>(itp as *const LeafIter<U64Key, U64Val, Cfg4>);
        let n: u64 = leaf.keys.len();
        // Tight client-side scan — no cursor, just j.
        let mut j: u64 = 0u64;
        while j < n {
            let kv: u64 = leaf.keys.get(j);
            let vv: u64 = leaf.vals.get(j);
            if kv <= prev { return 40; }
            prev = kv;
            sum_keys = sum_keys + kv;
            sum_vals = sum_vals + vv;
            count = count + 1u64;
            j = j + 1u64;
        }
        leaf_iter_next_leaf::<U64Key, U64Val, Cfg4>(itp);
    }
    if count != 12u64 { return 41; }
    // Sum 10..120 step 10 = 780.
    if sum_keys != 780u64 { return 42; }
    // Snapshot has k50 = 5555 (pre-mutation), other keys = key*7.
    // Σ = (sum_keys - 50) * 7 + 5555 = (780 - 50) * 7 + 5555 = 5110 + 5555 = 10665.
    if sum_vals != 10665u64 { return 43; }
    pmap_view_release_leaf_iter::<Cfg4>(itp);

    // Iter reverse over the live view (which has k50 = 9999).
    let mut rit: LeafIter<U64Key, U64Val, Cfg4> = pmap_view_acquire_leaf_iter_last::<Cfg4>(&pm.view as *const MyView);
    let ritp: *mut LeafIter<U64Key, U64Val, Cfg4> = &mut rit as *mut LeafIter<U64Key, U64Val, Cfg4>;
    let mut last: u64 = 1000u64;
    let mut rcount: u64 = 0u64;
    while leaf_iter_valid::<U64Key, U64Val, Cfg4>(ritp as *const LeafIter<U64Key, U64Val, Cfg4>) {
        let leaf: *mut LeafNode<U64Key, U64Val, Cfg4> = leaf_iter_leaf::<U64Key, U64Val, Cfg4>(ritp as *const LeafIter<U64Key, U64Val, Cfg4>);
        let n: u64 = leaf.keys.len();
        let mut j: u64 = n;
        while j > 0u64 {
            j = j - 1u64;
            let kv: u64 = leaf.keys.get(j);
            if kv >= last { return 50; }
            last = kv;
            rcount = rcount + 1u64;
        }
        leaf_iter_prev_leaf::<U64Key, U64Val, Cfg4>(ritp);
    }
    if rcount != 12u64 { return 51; }
    pmap_view_release_leaf_iter::<Cfg4>(ritp);

    pmap_view_drop::<Cfg4>(&mut snap as *mut MyView);
    pmap_mut_drop::<Cfg4>(pmptr);
    return 0;
}
