// queue-2 I2 — runtime AGGREGATES (ADR 0012-queue2 §§6,7): group by + having
// + the GENERIC rule table (el::agg_result_ty — ONE table for static+dynamic;
// avg: T→Quot(T), Quot(INT)=Quot(FLT)=FLT — the mean is ALWAYS f64-exact) +
// a UDA (init/step/fin triple) through the QEnv registry. Groups come out in
// first-occurrence order (the static two-pass discipline's observable order).
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.query;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Sale : code(0x0B05_0000_0000_0001) {
    dept:   i64 = 0,
    amount: i64 = 1,
    price:  f64 = 2,
}

impl Sale { pub fn as_any(self: &Sale) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }

resource cat = schema_catalog!{ Sale };

fn mk_sale(d: &Writ, dept: i64, amount: i64, price: f64) -> WAny {
    let s: Sale = d.make::<Sale>();
    s.dept   = dept;
    s.amount = amount;
    s.price  = price;
    let w: i64 = s.m as i64;
    return WAny::ref_to(w as *const u8);
}

// UDA `prod` — product of i64 arguments (init 1, step *, fin identity).
fn prod_init() -> RtVal { return RtVal::I(1i64); }
fn prod_step(acc: RtVal, v: RtVal) -> RtVal {
    let mut a: i64 = 1i64;
    let mut x: i64 = 1i64;
    match acc { RtVal::I(i) => { a = i; } _ => { } }
    match v   { RtVal::I(i) => { x = i; } _ => { } }
    return RtVal::I(a * x);
}
fn prod_fin(acc: RtVal) -> RtVal { return acc; }

fn main() -> i32 {
    let d: Writ = writ_new(8192i64);
    let sales: &mut WArray<WAny> = d.array(8i64);
    sales.push(mk_sale(&d, 1i64, 41i64, 2.5f64));
    sales.push(mk_sale(&d, 2i64, 30i64, 1.0f64));
    sales.push(mk_sale(&d, 1i64, 20i64, 1.5f64));
    let src: WAny = WAny::ref_to(sales as *const WArray<WAny> as *const u8);

    let c: SchemaCatalog = cat();
    let mut env: QEnv = QEnv::new();
    env.bind_source("sales", src);
    env.register_agg("prod", prod_init, prod_step, prod_fin, "i64", "i64");

    // ── group by + having + count/sum/min/max/avg + the UDA ───────────────
    let q1: Query = match Query::compile(
        "from sales s group by s.dept aggregate total = sum(s.amount) , cnt = count() , lo = min(s.amount) , av = avg(s.amount) , p = prod(s.amount) having total > 50 select (key, total, cnt, lo, av, p)",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e) => { return 1i32; }
    };
    let r1: QRows = match q1.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e2) => { return 2i32; }
    };
    // dept 1: total 61 > 50 kept; dept 2: total 30 filtered by having.
    if r1.row_count() != 1i64 { return 3i32; }
    if r1.col_count() != 6i64 { return 4i32; }
    if r1.get_i64(0i64, 0i64) != 1i64  { return 5i32; }   // key
    if r1.get_i64(0i64, 1i64) != 61i64 { return 6i32; }   // total
    if r1.get_i64(0i64, 2i64) != 2i64  { return 7i32; }   // cnt
    if r1.get_i64(0i64, 3i64) != 20i64 { return 8i32; }   // lo
    if r1.get_f64(0i64, 4i64) != 30.5f64 { return 9i32; } // av — EXACT mean
    if r1.get_i64(0i64, 5i64) != 820i64 { return 10i32; } // prod = 41*20
    // avg over an INT argument is FLT — the rule table (Quot(INT)=FLT)
    if !str_eq(r1.col_ty(4i64), "f64") { return 11i32; }
    if !str_eq(r1.col_ty(1i64), "i64") { return 12i32; }  // sum: T→T

    // ── avg over an f64 argument stays FLT (Quot(FLT)=FLT) ────────────────
    let q2: Query = match Query::compile(
        "from sales s group by s.dept aggregate pav = avg(s.price) , hi = max(s.price) select (key, pav, hi)",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e3) => { return 13i32; }
    };
    let r2: QRows = match q2.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e4) => { return 14i32; }
    };
    if r2.row_count() != 2i64 { return 15i32; }
    if r2.get_i64(0i64, 0i64) != 1i64 { return 16i32; }
    if r2.get_f64(0i64, 1i64) != 2.0f64 { return 17i32; }   // (2.5+1.5)/2
    if r2.get_f64(0i64, 2i64) != 2.5f64 { return 18i32; }   // max: T→T (FLT)
    if r2.get_i64(1i64, 0i64) != 2i64 { return 19i32; }
    if r2.get_f64(1i64, 1i64) != 1.0f64 { return 20i32; }
    if !str_eq(r2.col_ty(1i64), "f64") { return 21i32; }
    if !str_eq(r2.col_ty(2i64), "f64") { return 22i32; }

    // ── sum over a str argument → rule-table domain error ─────────────────
    let q3: Query = match Query::compile(
        "from sales s group by s.dept aggregate t = sum(s.amount) select key", &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e5) => { return 23i32; }
    };
    let r3: QRows = match q3.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e6) => { return 24i32; }
    };
    if r3.row_count() != 2i64 { return 25i32; }

    return 0i32;
}
