// LEGAL Rust: a type may have BOTH an inherent `fn drop` and an `impl Drop`.
// The DESTRUCTOR is the trait's, and the inherent method is an ordinary one.
// Here the inherent impl block is declared FIRST. Exactly one "T".
package bc_dropident_inherent_first;
extern fn printf(fmt: *const u8, ...) -> i32;
fn say(s: str) { unsafe { printf(s.as_ptr()); } }
struct R { id: i32 }
impl R {
    fn drop(self: &mut Self) -> i32 { say("I"); return 0i32; }
}
impl Drop for R {
    fn drop(self: &mut Self) { say("T"); }
}
fn main() -> i32 {
    {
        let mut r: R = R { id: 7i32 };
    }
    say("|END");
    return 0i32;
}
