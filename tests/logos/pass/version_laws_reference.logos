// ADR 0039 row M2: the D5 law suite against the reference model (full copy
// on fork) and against a canary model whose forks SHARE their parent's rows
// (the defect row M3v names in logos.mem.bt's vector family), and against a
// model whose delta drops replaced values (row M6's planted violation). The
// reference holds every law; the shared-rows canary must violate laws 1 and 2
// and the lossy-delta one laws 3 and 5, or the suite is blind.
package test;

use logos.lang.str;
use logos.lang.rc;
use logos.lang.cell;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.version.vocab;
use logos.mem.version.laws;
use logos.mem.version.reference;
use logos.std.io;

pub struct LeakSnap { ver: u64, parent: u64, rows: Rc<RefCell<Vec<(u64, u64)>>> }
pub struct LeakWs { base: u64, lin: Rc<RefCell<RefLineage>>, rows: Rc<RefCell<Vec<(u64, u64)>>> }
pub struct LeakStore { lin: Rc<RefCell<RefLineage>> }

impl Snapshot for LeakSnap {
    fn version(self: &LeakSnap) -> u64 { return self.ver; }
    fn parents(self: &LeakSnap) -> Vec<u64> {
        let mut p: Vec<u64> = Vec::new();
        if self.parent != 0u64 { p.push(self.parent); }
        return p;
    }
}
impl Workspace for LeakWs {
    type Snap = LeakSnap;
    fn base(self: &LeakWs) -> u64 { return self.base; }
    fn commit(self: LeakWs) -> LeakSnap {
        let v: u64 = ref_lineage_commit(&self.lin, self.base);
        return LeakSnap { ver: v, parent: self.base, rows: self.rows };
    }
    fn abort(self: LeakWs) { }
}
impl VersionStore for LeakStore {
    type Snap = LeakSnap;
    type Ws = LeakWs;
    fn root(self: &mut LeakStore) -> LeakSnap {
        return LeakSnap { ver: 0u64, parent: 0u64, rows: rc_new::<RefCell<Vec<(u64, u64)>>>(RefCell::new(Vec::new())) };
    }
    fn fork(self: &mut LeakStore, base: &LeakSnap) -> LeakWs {
        return LeakWs { base: base.ver, lin: self.lin.clone_ref(), rows: base.rows.clone_ref() };
    }
    fn heads(self: &LeakStore) -> Vec<u64> { return ref_lineage_heads(&self.lin); }
    fn release(self: &mut LeakStore, s: LeakSnap) { }
    fn fork_cost(self: &LeakStore) -> u32 { return FORK_COST_CONSTANT(); }
}
impl MapRead for LeakSnap { fn rows(self: &LeakSnap) -> Vec<(u64, u64)> { return law_copy_rows(&self.rows.borrow()); } }
impl MapRead for LeakWs { fn rows(self: &LeakWs) -> Vec<(u64, u64)> { return law_copy_rows(&self.rows.borrow()); } }
impl MapWrite for LeakWs {
    fn put(self: &mut LeakWs, k: u64, v: u64) { law_put_sorted(&mut self.rows.borrow_mut(), k, v); }
    fn del(self: &mut LeakWs, k: u64) { law_del_sorted(&mut self.rows.borrow_mut(), k); }
}
impl MapDelta for LeakSnap {
    fn delta_since(self: &LeakSnap, base: &LeakSnap) -> Vec<(u64, u64, i64)> { return ref_rows_delta(&self.rows.borrow(), &base.rows.borrow()); }
}

// The reference model with a delta that loses every replaced value
// (a key carrying both -old and +new).
pub struct LossySnap { inner: RefSnap }
pub struct LossyWs { inner: RefWs }
pub struct LossyStore { inner: RefStore }
impl Snapshot for LossySnap {
    fn version(self: &LossySnap) -> u64 { return self.inner.version(); }
    fn parents(self: &LossySnap) -> Vec<u64> { return self.inner.parents(); }
}
impl Workspace for LossyWs {
    type Snap = LossySnap;
    fn base(self: &LossyWs) -> u64 { return self.inner.base(); }
    fn commit(self: LossyWs) -> LossySnap { return LossySnap { inner: self.inner.commit() }; }
    fn abort(self: LossyWs) { self.inner.abort(); }
}
impl VersionStore for LossyStore {
    type Snap = LossySnap;
    type Ws = LossyWs;
    fn root(self: &mut LossyStore) -> LossySnap { return LossySnap { inner: self.inner.root() }; }
    fn fork(self: &mut LossyStore, base: &LossySnap) -> LossyWs { return LossyWs { inner: self.inner.fork(&base.inner) }; }
    fn heads(self: &LossyStore) -> Vec<u64> { return self.inner.heads(); }
    fn release(self: &mut LossyStore, s: LossySnap) { self.inner.release(s.inner); }
    fn fork_cost(self: &LossyStore) -> u32 { return self.inner.fork_cost(); }
}
impl MapRead for LossySnap { fn rows(self: &LossySnap) -> Vec<(u64, u64)> { return self.inner.rows(); } }
impl MapRead for LossyWs { fn rows(self: &LossyWs) -> Vec<(u64, u64)> { return self.inner.rows(); } }
impl MapWrite for LossyWs {
    fn put(self: &mut LossyWs, k: u64, v: u64) { self.inner.put(k, v); }
    fn del(self: &mut LossyWs, k: u64) { self.inner.del(k); }
}
impl MapDelta for LossySnap {
    fn delta_since(self: &LossySnap, base: &LossySnap) -> Vec<(u64, u64, i64)> {
        let d: Vec<(u64, u64, i64)> = self.inner.delta_since(&base.inner);
        let mut out: Vec<(u64, u64, i64)> = Vec::new();
        let mut i: i64 = 0i64;
        while i < d.len() {
            let replaced: bool = (i + 1i64 < d.len() && d[i + 1i64].0 == d[i].0) || (i > 0i64 && d[i - 1i64].0 == d[i].0);
            if !replaced { out.push(d[i]); }
            i = i + 1i64;
        }
        return out;
    }
}

fn main() -> i32 {
    let mut rs: RefStore = ref_store_new();
    let a: String = run_laws::<RefStore>(&mut rs, "reference");
    print_string(&a);
    let mut ls: LeakStore = LeakStore { lin: ref_lineage_new() };
    let b: String = run_laws::<LeakStore>(&mut ls, "canary shared-rows");
    print_string(&b);
    let mut lo: LossyStore = LossyStore { inner: ref_store_new() };
    let c: String = run_laws::<LossyStore>(&mut lo, "canary lossy-delta");
    print_string(&c);
    return 0i32;
}
