package genos_reflect;

use hermes.view;
use hermes.anyval;

genos Learnable {
    meta @{ "domain": "inductive", "version": 1 }
}

unsafe fn main() -> i32 {
    let info: HermesStatic = reflect::<Learnable>();
    let root: AnyVal = info.root();
    if root.is_null() { return 1; }
    if !root.is_ptr() { return 2; }

    // kind must be 3 (genos)
    let kind_av: AnyVal = info.map_get(root, "kind");
    if kind_av.is_null() { return 3; }
    let kind_val: i64 = info.get_int(kind_av);
    if kind_val != 3 { return 4; }

    // meta must be present
    let meta_av: AnyVal = info.map_get(root, "meta");
    if meta_av.is_null() { return 5; }
    if !meta_av.is_ptr() { return 6; }

    // "version" must be 1
    let ver_av: AnyVal = info.map_get(meta_av, "version");
    if ver_av.is_null() { return 7; }
    let ver: i64 = info.get_int(ver_av);
    if ver != 1 { return 8; }

    return 42;
}
