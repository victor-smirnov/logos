// Writ map comprehension: fixed key per iteration (put path, last-write-wins)
// + guard. writ2 Rc<Writ> builder.
package writ_map_comp_basic;

use logos.lang.writ.comp_builder;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.static_view;
use logos.lang.rc;

fn main() -> i32 {
    let arr: [i32; 4] = [10, 20, 30, 40];

    // All-same-key — tests the put path, last-write-wins.
    let doc: Rc<Writ> = @{"k": x for x in arr};

    // Guarded: keep only x divisible by 20.
    let doc2: Rc<Writ> = @{"k": x * 2 for x in arr if (x % 20) == 0};

    unsafe {
        let v0: WView2 = WView2 { base: 0 as *const u8 };
        let h1: &Writ = doc.deref();
        let r1: WAny = h1.root();
        if !r1.is_map() { return 1; }
        if v0.get_int(v0.map_get(r1, "k")) != 40i64 { return 2; }   // last wins

        let h2: &Writ = doc2.deref();
        let r2: WAny = h2.root();
        if !r2.is_map() { return 3; }
        if v0.get_int(v0.map_get(r2, "k")) != 80i64 { return 4; }   // 20,40 → last 80
    }

    return 42;
}
