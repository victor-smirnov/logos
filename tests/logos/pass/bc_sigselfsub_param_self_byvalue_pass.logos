// The twin of tests/logos/fail/bc_sigselfsub_param_self_byvalue_fail, one token
// apart: `other: R` instead of `other: Q`.
package bc_sigselfsub_param_self_byvalue_pass;

struct R {
    v: i64,
}

trait Take {
    fn take(self: &Self, other: Self) -> i64;
}

impl Take for R {
    fn take(self: &R, other: R) -> i64 {
        return other.v;
    }
}

fn main() -> i32 {
    let a: R = R { v: 6i64 };
    let b: R = R { v: 7i64 };
    if a.take(b) == 7i64 {
        return 0;
    }
    return 1;
}
