package cmp_all_ops;
// F03: all 6 comparison operators
fn bool_to_int(b: bool) -> i32 { if b { return 1; } return 0; }
unsafe fn main() -> i32 {
    let a: i32 = bool_to_int(3 == 3);   // 1
    let b: i32 = bool_to_int(3 != 4);   // 1
    let c: i32 = bool_to_int(3 < 4);    // 1
    let d: i32 = bool_to_int(4 > 3);    // 1
    let e: i32 = bool_to_int(3 <= 3);   // 1
    let f: i32 = bool_to_int(3 >= 3);   // 1
    // false cases
    let g: i32 = bool_to_int(3 == 4);   // 0
    let h: i32 = bool_to_int(4 < 3);    // 0
    // a+b+c+d+e+f+g+h = 6
    // 6 * 7 = 42
    return (a + b + c + d + e + f + g + h) * 7;
}
