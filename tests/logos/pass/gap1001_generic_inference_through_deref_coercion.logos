package gap1001_generic_inference_through_deref_coercion;
// ADR 0030 S0-S7 gap audit 2026-10-01, cluster `generic-inference-through-deref-coercion` (pairs-5#7); rustc twin: the cluster .rs.
use logos.std.fmt;
use logos.mem.collections.vec;
fn cnt<T>(xs: &[T]) -> i64 { return xs.len(); }
fn first<'a, T>(xs: &'a [T]) -> &'a T { return &xs[0]; }
fn main() {
    let v: Vec<i64> = vec![4, 5, 6];
    println!("{}", cnt(&v));
    println!("{}", first(&v));
}
