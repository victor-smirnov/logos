// logos-core §6.10 sub-deliverable 8/8: derive(Debug).
//
// Rust-shape field-named output `Pt { x: 5, y: 7 }`, emitted by the
// stdlib derive_debug hook via the `DebugStruct` builder. The field
// NAME labels come from `##field` str-position antiquots (T2-22): the
// quote machinery substitutes an Ident into a string-literal position,
// so `f.debug_struct(##nm).field(##fnames, &self.#fnames)` renders the
// names. The builder owns brace padding + `, ` separators (no trailing
// comma) — byte-identical to `core::fmt`'s derive.
package core_6_10_derive_debug;

use logos.std.compiler.metaprog;
use logos.mem.fmt;
use logos.std.io;

#[derive_debug]
struct Pt { x: i32, y: i32 }

fn main() -> i32 {
    let p: Pt = Pt { x: 5i32, y: 7i32 };
    let s: String = fmt_debug_to_string(&p);
    println_string(&s);
    // Rust-exact field-named shape.
    if s.as_str() != "Pt { x: 5, y: 7 }" { return 1i32; }
    return 0i32;
}
