// `v[i]` / `v[i] = x` on Vec (Rust parity): Index/IndexMut impls on Vec<T>
// route to the bounds-checked borrow / borrow_mut. The `a[i]` read/write
// lowering grew a generic-struct fallback (the concrete `Vec$G1$i64__index`
// symbol doesn't exist at sema — only the template), routing through the
// normal method-call machinery and deriving Output from the impl's trait args.
package vec_index_operator;
fn main() -> i32 {
    let mut v: Vec<i64> = vec![10i64, 20i64, 30i64];
    if v[1i64] != 20i64 { return 1i32; }   // read, suffixed index
    if v[2] != 30i64 { return 2i32; }      // read, IntLit index
    v[0i64] = 99i64;                        // write via IndexMut
    if v[0i64] != 99i64 { return 3i32; }
    v[1] = v[2] + 5i64;                     // index in both read + write
    if v[1i64] != 35i64 { return 4i32; }

    // Index on a Vec of non-Copy elements (returns the element place).
    let mut s: Vec<String> = vec_new::<String>();
    s.push(String::from("ab"));
    if s[0i64] != "ab" { return 5i32; }
    return 0i32;
}
