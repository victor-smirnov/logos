// PAIR 2 of 3, root lifereg.N1 — the LEGAL twin, one token from
// fail/bc_tmcb_erased_method_local: the brace closing `g`'s scope moves BELOW
// the use of `b`, so the receiver outlives the box that borrows it.
// 2026-09-02y: `Box<dyn It + 'a>` / `Box<dyn It + '_>` — as first written (`Box<dyn It>`, 'static)
// this twin was not legal Rust (a 'static object borrowing `self.v`) and is refused since the
// object-lifetime bound is checked.
package bc_tmcb_erased_method_outlives_twin;

trait It { fn get(self: &Self) -> i64; }
struct Holder<'a> { r: &'a i64 }
impl<'a> It for Holder<'a> { fn get(self: &Self) -> i64 { return *self.r; } }
struct G { v: i64 }
impl G { fn nb<'a>(self: &'a Self) -> Box<dyn It + 'a> { return Box::new(Holder { r: &self.v }); } }

fn main() -> i32 {
    let mut b: Box<dyn It + '_>;
    { let g = G { v: 5i64 }; b = g.nb();
    return (b.get() - 5i64) as i32; }
}
