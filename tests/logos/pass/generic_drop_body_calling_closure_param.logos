// CLOSED SOUNDNESS-QUEUE ROW `generic_drop_body_calling_closure_param_corrupts_
// callers_closure` (tier 1, `run 139`), closed 2026-09-09 by the FatClosure
// return-ABI move in `repr_return_type`.
//
// ⚠ THE ROW'S RECORDED ROOT IS REFUTED, AND THIS FIXTURE IS WHY IT IS PINNED
// WITH ITS ORIGINAL PROSE BELOW. The header said the discriminator was "the
// presence of a CALL to `F` inside the drop body" and offered five controls.
// The actual root is neither the drop body nor the call: `a_out<F>(a) -> F`
// RETURNS A CLOSURE, and a returned closure was handed back as a POINTER to
// the callee's frame slot instead of as its 16-byte {fn,env} pair. Deleting
// `g();` moved the arm only because it changed that frame's layout — a
// one-token control can separate two programs without naming their cause.
// Nothing in the drop mechanism was touched to close this row.
//
// THE ASSERTION IS A FIRING COUNT, NOT AN EXIT CODE: a leak reads low and a
// double fire high, and both are invisible to rc alone. Both halves of the
// original one-token pair are kept in the program, so the fixture still
// carries its own control.
package generic_drop_body_calling_closure_param;
use logos.lang.ptr;
extern fn malloc(n: i64) -> *mut u8;
extern fn printf(f: *const u8, a: i64) -> i32;

#[no_auto_drop]
struct MD<T> { value: T }

// ── THE DEFECT ARM: drop body reads AND CALLS the closure. ─────────────
struct A<F: FnOnce() -> ()> { f: MD<F>, armed: bool }
impl<F: FnOnce() -> ()> Drop for A<F> {
    fn drop(self: A<F>) {
        if self.armed {
            let p: *const F = &self.f.value as *const F;
            let g: F = unsafe { read::<F>(p) };
            g();
        }
    }
}
fn a_new<F: FnOnce() -> ()>(f: F) -> A<F> { return A::<F> { f: MD::<F> { value: f }, armed: true }; }
fn a_out<F: FnOnce() -> ()>(a: A<F>) -> F {
    let mut d: A<F> = a;
    d.armed = false;
    let p: *const F = &d.f.value as *const F;
    return unsafe { read::<F>(p) };
}

// ── THE CONTROL: byte-identical except the drop body does not CALL. ────
struct B<F: FnOnce() -> ()> { f: MD<F>, armed: bool }
impl<F: FnOnce() -> ()> Drop for B<F> {
    fn drop(self: B<F>) {
        if self.armed {
            let p: *const F = &self.f.value as *const F;
            let g: F = unsafe { read::<F>(p) };
        }
    }
}
fn b_new<F: FnOnce() -> ()>(f: F) -> B<F> { return B::<F> { f: MD::<F> { value: f }, armed: true }; }
fn b_out<F: FnOnce() -> ()>(b: B<F>) -> F {
    let mut d: B<F> = b;
    d.armed = false;
    let p: *const F = &d.f.value as *const F;
    return unsafe { read::<F>(p) };
}

static mut FIRED: i64 = 0i64;

unsafe fn main() -> i32 {
    // THE DEFECT ARM — SIGSEGVs at `f()` today.
    FIRED = 0i64;
    {
        let a: A<||->()> = a_new::<||->()>(|| { unsafe { FIRED = FIRED + 1i64; } });
        let f: ||->() = a_out::<||->()>(a);
        printf("arm: before call, firings (want 0): %ld\n".as_ptr(), FIRED);
        f();
    }
    printf("arm: after call, firings (want 1): %ld\n".as_ptr(), FIRED);
    if FIRED != 1i64 { return 1i32; }

    // THE ONE-TOKEN CONTROL — correct today.
    FIRED = 0i64;
    {
        let b: B<||->()> = b_new::<||->()>(|| { unsafe { FIRED = FIRED + 1i64; } });
        let f: ||->() = b_out::<||->()>(b);
        f();
    }
    printf("control: after call, firings (want 1): %ld\n".as_ptr(), FIRED);
    if FIRED != 1i64 { return 2i32; }

    return 0i32;
}
