// Test: three levels of nesting — C contains B contains A, explicit Drop on A and B, glue on C
//
// ⚠ RE-PINNED 2026-09-08. This fixture used to assert `b3` — i.e. it pinned
// `A::drop` NOT RUNNING, against its own comment three lines below, which says
// what the program is for: `c drops via glue -> B::drop(b3) -> A::drop(a7)`.
// Under the owner's Rust-canonical drop decision (drop glue is: run
// `Drop::drop`, THEN drop the fields, at every depth) it prints `b3 a7 `, which
// is what the comment always asked for. The exit code is unchanged at 42 and
// the subject still runs — it runs MORE of itself: `A::drop` goes from zero
// calls to one. Loosening it back to `b3` would be pinning a leak.
package drop_glue_three_levels;

extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }

struct A { id: i32, }

impl Drop for A {
    fn drop(self: &mut Self) { printi("a%d ", self.id); }
}

// B has explicit Drop and a droppable field A
struct B {
    inner: A,
    tag: i32,
}

impl Drop for B {
    fn drop(self: &mut Self) { printi("b%d ", self.tag); }
}

// C has NO explicit Drop but has droppable field B — drop glue fires
struct C { nested: B, }

unsafe fn main() -> i32 {
    let result: i32 = 42;
    let c: C = C { nested: B { inner: A { id: 7 }, tag: 3 } };
    // c drops via glue → B::drop(b3) → A::drop(a7)
    return result;
}
