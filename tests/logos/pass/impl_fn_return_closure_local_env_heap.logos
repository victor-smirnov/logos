// `let c = move || …; return c;` — the local bound to a returned closure builds its env on the heap (it dangled on the stack: SIGSEGV).
package impl_fn_return_closure_local_env_heap;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + 1i64; } } }
fn mk(p: *mut i64) -> impl Fn() -> i64 {
    let d: D = D { v: 7i64, c: p };
    let c = move || -> i64 { return d.v; };
    return c;
}
fn noise(k: i64) -> i64 { let a: [i64; 16] = [k; 16]; return a[3] + a[9]; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    {
        let h = mk(p);
        let z = noise(99);
        if h() != 7i64 { return 2i32; }
        if z != 198 { return 5i32; }
    }
    if unsafe { n } != 1i64 { return 1i32; }
    return 0i32;
}
