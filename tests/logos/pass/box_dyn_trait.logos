package box_dyn_trait;
// Box<dyn Trait>: heap-allocated fat pointer returned from a function.
extern fn printf(fmt: *const u8, ...) -> i32;

trait Animal {
    fn speak(self: Self);
}

class Dog { val: i32; }
class Cat { val: i32; }

impl Animal for Dog { fn speak(self: Dog) { printf("woof\n"); } }
impl Animal for Cat { fn speak(self: Cat) { printf("meow\n"); } }

fn make_animal(is_dog: i32) -> Box<dyn Animal> {
    if is_dog == 1 {
        return new Dog { val: 0 };
    }
    return new Cat { val: 0 };
}

fn main() -> i32 {
    let d = make_animal(1);
    let c = make_animal(0);
    d.speak();
    c.speak();
    return 0;
}
