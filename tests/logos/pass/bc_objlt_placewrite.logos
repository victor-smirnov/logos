// THE LEGAL TWIN, ONE TOKEN APART: a closure with no captures is 'static.
package bc_objlt_placewrite;
fn main() -> i32 {
    let b: Box<dyn Fn() -> u64>;
    {
        let f: u64 = 7u64;
        let r: &u64 = &f;
        b = Box::new(|| -> u64 { return 7u64; });
    }
    return (b() - 7u64) as i32;
}
