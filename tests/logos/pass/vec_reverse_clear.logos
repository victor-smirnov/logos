package vec_reverse_clear;
use logos.mem.collections.vec;

fn main() -> i32 {
    let mut v: Vec<i32> = vec_new::<i32>();
    v.push(1i32);
    v.push(2i32);
    v.push(3i32);
    v.push(4i32);

    v.reverse();
    if v.get(0i64) != 4i32 { return 1i32; }
    if v.get(1i64) != 3i32 { return 2i32; }
    if v.get(2i64) != 2i32 { return 3i32; }
    if v.get(3i64) != 1i32 { return 4i32; }

    v.clear();
    if v.length() != 0i64 { return 5i32; }

    // Reversing empty / single-element no-ops.
    v.reverse();
    v.push(7i32);
    v.reverse();
    if v.get(0i64) != 7i32 { return 6i32; }
    return 0i32;
}
