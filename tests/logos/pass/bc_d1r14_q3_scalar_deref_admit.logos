// ── D1 round 14 ADMIT CONTROL ─────────────────────────────────────────────
// The refusal fixture alone cannot tell a CLOSED LEAK from an OVER-REFUSAL:
// both print a diagnostic. This is the other half of the pair — the same
// shape used SOUNDLY (the borrow never outlives its referent), which must
// keep COMPILING. If it starts refusing, the round-14 arm is too wide.
// Q3: DEREFERENCING A `&i64` COPIES A SCALAR OUT — it borrows nothing, so the
// binding may outlive the referent. This control is not hypothetical: the
// first cut of the Deref arm had no result-type gate and REFUSED this shape
// (it was the only red in 2088 L2 tests, as pass/nll_borrow_not_used_after_
// scope), which is what forced the `type_may_carry_borrow` guard.
package bc_d1r14_q3_scalar_deref_admit;
fn main() -> i32 {
    let mut acc: i64 = 0i64;
    let mut r: &i64;
    { let x: i64 = 5i64; r = &x; acc = *r; }
    if acc != 5i64 { return 1; }
    return 0;
}
