// Test: Hermes nested structural patterns.

package hermes_match_nested;

use std.hermes.anyval;
use std.hermes.ctr;
use std.hermes.pat;
use std.hermes.view;

unsafe fn classify(d: &HermesStatic) -> i32 {
    match d {
        @{"data": @[@1, @2]}              => 1,
        @{"data": @{"inner": @"x"}}       => 2,
        @[@{"k": @1}, @{"k": @2}]         => 3,
        _                                 => 0,
    }
}

unsafe fn main() -> i32 {
    let a: HermesStatic = @{"data": [1, 2]};
    let b: HermesStatic = @{"data": {"inner": "x"}};
    let c: HermesStatic = @[{"k": 1}, {"k": 2}];
    let d: HermesStatic = @{"data": [1, 2, 3]};
    // 1 + 2 + 3 + 0 = 6
    return classify(&a) + classify(&b) + classify(&c) + classify(&d);
}
