package bc_ptrcoerce_unique_to_mut_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
fn show(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
static G: i64 = 7i64;
fn raw<'a>(x: &mut &'a i64) -> *mut &'a i64 {
    return x;
}
fn main() -> i32 {
    let mut r: &'static i64 = &G;
    let p: *mut &i64 = raw(&mut r);
    let k: i64 = unsafe { **p };
    show("k=%lld", k);
    return k as i32;
}
