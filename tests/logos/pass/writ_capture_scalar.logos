// Writ capture: scalar values captured from variables into @-literals (writ2).
package writ_capture_scalar;
use logos.lang.writ.tmpl;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.static_view;
use logos.lang.rc;

unsafe fn main() -> i32 {
    let v0: WView2 = WView2 { base: 0 as *const u8 };
    let id: i32 = 42;

    // Capture i32 scalar into untyped map.
    let doc: Rc<Writ> = @{"id": $id};
    let h: &Writ = doc.deref();
    let root: WAny = h.root();
    if root.is_null() { return 1; }
    if v0.get_int(v0.map_get(root, "id")) != 42i64 { return 10; }

    // Capture bool scalar.
    let flag: bool = true;
    let doc2: Rc<Writ> = @{"ok": $flag};
    let h2: &Writ = doc2.deref();
    let root2: WAny = h2.root();
    if root2.is_null() { return 2; }
    if !v0.get_bool(v0.map_get(root2, "ok")) { return 20; }

    // Capture expression.
    let a: i32 = 10;
    let b: i32 = 5;
    let doc3: Rc<Writ> = @{"sum": ${a + b}};
    let h3: &Writ = doc3.deref();
    let root3: WAny = h3.root();
    if root3.is_null() { return 3; }
    if v0.get_int(v0.map_get(root3, "sum")) != 15i64 { return 30; }

    return 0;
}
