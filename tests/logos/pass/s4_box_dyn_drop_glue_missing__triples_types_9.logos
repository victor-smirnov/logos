// ADR 0030 S4 acceptance: feature-interaction audit cluster `box-dyn-drop-glue-missing`, member triples-types_9
// (tests/interactions/clusters/box-dyn-drop-glue-missing/triples-types_9.logos); rustc 1.98.1 twin gives the same stdout and exit code.
package m80;
use logos.std.fmt; use logos.mem.collections.vec; use logos.lang.iter; use logos.mem.string; use logos.lang.option; use logos.lang.result; use logos.lang.ops; use logos.lang.cmp; use logos.lang.str; use logos.mem.boxed;
trait T { fn g(&self) -> i64; }
struct S { v: i64 }
impl T for S { fn g(&self) -> i64 { self.v } }
impl Drop for S { fn drop(&mut self) { println!("drop {}", self.v); } }
fn main() {
    { let mut cs: Vec<Box<dyn T>> = Vec::new(); cs.push(Box::new(S { v: 1 })); println!("{}", cs[0].g()); }
    println!("mid");
    { let b: Box<dyn T> = Box::new(S { v: 3 }); drop(b); println!("after drop"); }
    { let b: Box<S> = Box::new(S { v: 4 }); drop(b); println!("after drop4"); }
    println!("end");
}
