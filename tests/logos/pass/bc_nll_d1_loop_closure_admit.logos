// D1, ADMIT twin — the CLOSURE spelling of the same defect: the closure is dead
// at the end of each iteration and its capture loan must die with it.
package bc_nll_d1_loop_closure_admit;
fn main() -> i64 {
    let mut n: i64 = 0i64;
    let mut acc: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < 3i64 {
        let mut c = || { n = n + 1i64; };
        c();                          // last use of the holder
        acc = acc + n;                // must be ADMITTED: `c` is dead
        i = i + 1i64;
    }
    return acc;
}
