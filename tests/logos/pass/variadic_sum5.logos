package variadic_sum5;
// Edge case: variadic sum with 5 arguments (more than existing tests)
fn sum_all() -> i32 { return 0; }
fn sum_all<H, T...>(first: H, rest: T...) -> i32 {
    return (first as i32) + sum_all(rest...);
}

unsafe fn main() -> i32 {
    // 5+7+9+11+10 = 42
    return sum_all::<i32, i32, i32, i32, i32>(5, 7, 9, 11, 10);
}
