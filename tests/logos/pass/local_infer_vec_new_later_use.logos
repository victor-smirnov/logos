// Local inference: Vec::new's T from a push, a let annotation, and inside a generic body.
package local_infer_vec_new_later_use;
fn fill<T: Copy>(x: T) -> Vec<T> {
    let mut v = Vec::new();
    v.push(x);
    v.push(x);
    return v;
}
fn main() -> i32 {
    let mut a = Vec::new();
    a.push(4u8);
    a.push(6u8);
    let b = Vec::new();
    let c: Vec<i64> = b;
    let d = fill(7i64);
    return (a[0] as i64 + a[1] as i64 + c.len() + d[1] + d.len()) as i32;
}
