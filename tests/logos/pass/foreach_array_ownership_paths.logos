// By-value array for-each ownership: break partway, continue, a local array, locals in a literal,
// the body moving the element, a tuple pattern, and a return from inside the loop.
// rustc 1.98.1 prints the same line.
package foreach_array_ownership_paths;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn eat(d: D) -> i64 { return d.v; }
fn brk(p: *mut i64) { for d in [D { v: 1i64, c: p }, D { v: 2i64, c: p }, D { v: 3i64, c: p }] { if d.v == 2i64 { break; } } }
fn cont(p: *mut i64) { for d in [D { v: 1i64, c: p }, D { v: 2i64, c: p }] { if d.v == 1i64 { continue; } let _ = d.v; } }
fn local(p: *mut i64) { let arr: [D; 2] = [D { v: 4i64, c: p }, D { v: 5i64, c: p }]; for d in arr { let _ = d.v; } }
fn lits(p: *mut i64) { let a: D = D { v: 6i64, c: p }; let b: D = D { v: 7i64, c: p }; for d in [a, b] { let _ = d.v; } }
fn moved(p: *mut i64) -> i64 { let mut s: i64 = 0i64; for d in [D { v: 8i64, c: p }, D { v: 9i64, c: p }] { s = s + eat(d); } return s; }
fn pat(p: *mut i64) { for (d, k) in [(D { v: 1i64, c: p }, 5i64), (D { v: 2i64, c: p }, 6i64)] { let _ = d.v + k; } }
fn ret(p: *mut i64) -> i64 { for d in [D { v: 1i64, c: p }, D { v: 2i64, c: p }, D { v: 3i64, c: p }] { if d.v == 1i64 { return 7i64; } } return 0i64; }
fn main() -> i32 {
    let mut n1: i64 = 0i64; brk(&mut n1);
    let mut n2: i64 = 0i64; cont(&mut n2);
    let mut n3: i64 = 0i64; local(&mut n3);
    let mut n4: i64 = 0i64; lits(&mut n4);
    let mut n5: i64 = 0i64; let s5: i64 = moved(&mut n5);
    let mut n6: i64 = 0i64; pat(&mut n6);
    let mut n7: i64 = 0i64; let r7: i64 = ret(&mut n7);
    unsafe { printf("%lld %lld %lld %lld %lld %lld %lld %lld %lld\n".as_ptr(), n1, n2, n3, n4, s5, n5, n6, r7, n7); }
    return 0i32;
}
