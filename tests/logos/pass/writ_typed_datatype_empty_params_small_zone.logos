// @Type in a small arena (writ2: segments grow on demand — the tiny
// initial capacity is a stress, not a limit).
package writ_typed_datatype_empty_params_small_zone;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.typed_value;
use logos.mem.writ.parser;
use logos.lang.rc;
use logos.lang.str;

unsafe fn main() -> i32 {
    let rc: Rc<Writ> = writ_rc(256);     // deliberately tiny
    let h: &Writ = rc.deref();
    let a: HAny = parse(h, "@I64=1");
    if a.is_null() { return 1; }
    if !str_eq(a.as_typed_value().type_name_str(), "I64") { return 2; }
    let b: HAny = parse(h, "@I64()=1");
    if b.is_null() { return 3; }
    if b.as_typed_value().has_params() { return 4; }
    return 0;
}
