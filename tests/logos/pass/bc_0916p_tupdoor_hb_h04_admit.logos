// hand battery: round 2026-09-16p-tupdoor, program h04 — caught: a struct pattern under TWO tuple
// levels binds nothing on the base binary ("undefined variable 'x'") and binds correctly on the
// landed one; it is the recursion, not the one-level case, that the widened whitelist buys.
// legality: rustc 1.98.1 --edition 2024 compiles and runs it, exit 0.
package bc_0916p_tupdoor_hb_h04_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let sv: ((P, i64), i64) = ((P { x: 1i64, y: 2i64 }, 3i64), 4i64);
    let mut got: i64 = 0i64;
    match sv {
        ((P { x, y }, q), z) => { got = x + y + q + z; }
    }
    unsafe { printf("got=%ld\n".as_ptr(), got); }
    if got != 10i64 { return 1i32; }
    return 0i32;
}
