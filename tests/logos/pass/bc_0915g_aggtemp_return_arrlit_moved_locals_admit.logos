// asserts: locals moved into a returned array literal are not dropped again at function exit: n=11 (base n=22, exit 1)
// legality: rustc 1.98.1 --edition 2024, twin cited in the round's rust/ directory; measured, not read.
package bc_0915g_aggtemp_return_arrlit_moved_locals_admit;
extern fn printf(fmt: *const u8, ...) -> i32;
struct C { v: i64, c: *mut i64 }
impl Drop for C { fn drop(self: &mut C) { unsafe { *self.c = *self.c + self.v; } } }
fn mkarr(p: *mut i64) -> [C; 2] {
    let a: C = C { v: 1i64, c: p };
    let b: C = C { v: 10i64, c: p };
    return [a, b];
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    {
        let arr: [C; 2] = mkarr(p);
        if arr[1].v != 10i64 { return 3i32; }
    }
    let got: i64 = unsafe { n };
    unsafe { printf("n=%ld\n".as_ptr(), got); }
    if got != 11i64 { return 1i32; }
    return 0i32;
}
