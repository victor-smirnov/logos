// Batch B test: discriminant enums + match
package enum_match;

enum Direction { North, South = 10, East, West }

enum Color { Red = 1, Green = 2, Blue = 3 }

fn color_code(c: i32) -> i32 {
    let mut result: i32 = 0;
    // An integer is compared with a discriminant through `as` (rustc refuses an
    // enum-variant pattern over an integer scrutinee, E0308).
    match c {
        x if x == Color::Red as i32   => { result = 1; }
        x if x == Color::Green as i32 => { result = 2; }
        x if x == Color::Blue as i32  => { result = 3; }
        _                             => { result = 0; }
    }
    return result;
}

pub unsafe fn main() -> i32 {
    // A fieldless enum's discriminant is read with `as` (Rust: no implicit coercion)
    let n: i32 = Direction::North as i32;
    let s: i32 = Direction::South as i32;
    let e: i32 = Direction::East as i32;
    let w: i32 = Direction::West as i32;

    // North=0, South=10, East=11, West=12 → sum = 33
    let sum: i32 = n + (s + (e + w));

    // match on integer literal
    let mut ok: i32 = 0;
    match sum {
        33 => { ok = 1; }
        _  => { ok = 0; }
    }

    // match on enum: Color::Green = 2
    let col: i32 = Color::Green as i32;
    let ccode: i32 = color_code(col);

    // ok=1, ccode=2 → return 3
    return ok + ccode;
}
