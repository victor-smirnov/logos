// Admit twin for fail/bc_d1r5_h5_struct_pat.
package bc_d1r5_h5_struct_pat_admits;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct Wrap { b: B }
fn stash(c: &C, v: &mut Vec<B>) {
    let w: Wrap = Wrap { b: c.mk() };
    match w { Wrap { b: inner } => { v.push(inner); } }
}
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    stash(&c, &mut vs);
    let x: i64 = *vs.get(0u64).p;
    c.bump();
    return x;
}
