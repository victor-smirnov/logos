// PIN (2026-09-04land, root 3): the TWIN of
// drop_ident_inherent_is_not_a_destructor, one token apart
// (`impl S` -> `impl Drop for S`). The identity test must ACCEPT this one, or the
// fix for the first is a silent removal of every destructor in the tree.
package drop_ident_trait_is_a_destructor;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
static mut I: i64 = 0i64;
struct S { k: i64 }
impl Drop for S { fn drop(self: &mut Self) { unsafe { I = I + 1i64; } } }
fn main() -> i32 {
    {
        let mut s: S = S { k: 5i64 };
        if s.k != 5i64 { return 3i32; }
    }
    unsafe {
        printi("I=%d\n", I as i32);
        if I != 1i64 { return 1i32; }
    }
    return 0i32;
}
