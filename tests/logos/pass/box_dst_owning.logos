package test;
use logos.mem.boxed;
use logos.lang.mem;
struct Buf { hdr: i32, tail: [u8] }
unsafe fn read(b: &Buf) -> i32 {
    let mut acc: i32 = b.hdr;
    let s: &[u8] = b.tail;
    let mut i: i64 = 0;
    while i < s.len() { acc = acc + (s[i] as i32); i = i + 1; }
    return acc;
}
unsafe fn main() -> i32 {
    let raw: *mut u8 = alloc(4 + 4) as *mut u8;
    raw[0] = 50u8; raw[1] = 0u8; raw[2] = 0u8; raw[3] = 0u8;   // hdr=50
    raw[4] = 1u8; raw[5] = 2u8; raw[6] = 3u8; raw[7] = 4u8;    // tail
    let fr: &Buf = dst_from_raw_parts::<Buf>(raw as *const u8, 4 as i64);
    {
        let bb: Box<Buf> = fr as Box<Buf>;   // owning
        let r: i32 = read(&bb);              // deref-coerce &Box<Buf> → &Buf
        if r != 60 { return 99; }
    }   // bb drops → frees raw
    return 60;
}
