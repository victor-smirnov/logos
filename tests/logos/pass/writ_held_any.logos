// An WAny (a Ref into the arena) escapes its building scope via HeldAny, bound to
// the Writ holder (not the parent Array). The arena stays alive while the
// HeldAny lives; freed when it drops.
package t;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.rc;

fn make_elem() -> HeldAny {
    let mut h: Rc<Writ> = writ_rc(64i64);
    let arr: &mut WArray<WAny> = h.array(2i64);
    arr.push(WAny::from(7i64));
    let nested: &mut WArray<WAny> = h.array(2i64);
    nested.push(WAny::from(99i64));
    let e: WAny = WAny::from(&*nested);     // a Ref WAny into the arena
    return hold_any(&mut h, e);             // escape: carry the Writ holder
    // local `h` Rc drops here; HeldAny's holder keeps the arena alive
}

fn main() -> i32 {
    let held: HeldAny = make_elem();        // WAny outlived its build scope
    let e: WAny = held.val();
    if !e.is_ref() { return 1; }
    let child: &WArray<WAny> = unsafe { &*(e.resolve() as *const WArray<WAny>) };
    if child.len() != 1i64 { return 2; }
    if child.get(0i64).as_i56() != 99i64 { return 3; }
    return 0;
    // held drops → Writ holder → arena freed
}
