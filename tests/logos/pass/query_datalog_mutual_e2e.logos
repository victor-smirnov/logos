// queue-2 I3 — DYNAMIC Datalog: MUTUAL RECURSION + forward reference.
// `odd`/`even` (odd-/even-length paths) form ONE two-member SCC: odd's step
// body reads `even` (declared LATER — forward references are legal, the
// registry completes before bodies resolve) and even's reads `odd`. The
// interpreter runs ONE shared semi-naïve loop for the SCC: rounds promote
// BOTH deltas and run each recursive body's delta variant until both empty.
// Two Query objects share the rel program text with different entries —
// asserting BOTH members materialize correctly.
package test;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.std.wql.ir;
use logos.std.wql.catalog_macro;
use logos.std.deem;
use logos.lang.result;
use logos.mem.string;
use logos.lang.str;

pub schema Edge : code(0x0B11_0000_0000_0001) {
    src: i64 = 0,
    dst: i64 = 1,
}

resource cat = schema_catalog!{ Edge };

fn mk_edge(d: &Writ, s: i64, t: i64) -> WAny {
    let e: Edge = d.make::<Edge>();
    e.src = s;
    e.dst = t;
    let w: i64 = e.m as i64;
    return WAny::ref_to(w as *const u8);
}

fn main() -> i32 {
    let d: Writ = writ_new(8192i64);
    let c: SchemaCatalog = cat();

    let qo: Query = match Query::compile(
        "rel odd(a: i64, b: i64) { from edges e select (e.src, e.dst); from even v join edges e on v.b == e.src select (v.a, e.dst); } rel even(a: i64, b: i64) { from odd o join edges e on o.b == e.src select (o.a, e.dst); } from odd p where p.a == start select p.b order by p.b",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e) => { return 1i32; }
    };
    let qe: Query = match Query::compile(
        "rel odd(a: i64, b: i64) { from edges e select (e.src, e.dst); from even v join edges e on v.b == e.src select (v.a, e.dst); } rel even(a: i64, b: i64) { from odd o join edges e on o.b == e.src select (o.a, e.dst); } from even p where p.a == start select p.b order by p.b",
        &c)
    {
        Result::Ok(v) => { v }
        Result::Err(_e2) => { return 2i32; }
    };

    // Chain 1→2→3→4→5.
    let arr: &mut WArray<WAny> = d.array(8i64);
    arr.push(mk_edge(&d, 1i64, 2i64));
    arr.push(mk_edge(&d, 2i64, 3i64));
    arr.push(mk_edge(&d, 3i64, 4i64));
    arr.push(mk_edge(&d, 4i64, 5i64));
    let src: WAny = WAny::ref_to(arr as *const WArray<WAny> as *const u8);

    let mut env: QEnv = QEnv::new();
    env.bind_source("edges", src);
    env.bind_i64("start", 1i64);

    // Odd-length paths from 1: 1 hop → 2, 3 hops → 4.
    let o1: QRows = match qo.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e3) => { return 3i32; }
    };
    if o1.row_count() != 2i64 { return 4i32; }
    if o1.get_i64(0i64, 0i64) != 2i64 { return 5i32; }
    if o1.get_i64(1i64, 0i64) != 4i64 { return 6i32; }

    // Even-length paths from 1: 2 hops → 3, 4 hops → 5.
    let e1: QRows = match qe.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e4) => { return 7i32; }
    };
    if e1.row_count() != 2i64 { return 8i32; }
    if e1.get_i64(0i64, 0i64) != 3i64 { return 9i32; }
    if e1.get_i64(1i64, 0i64) != 5i64 { return 10i32; }

    // From 2: odd → {3, 5}; even → {4}.
    env.bind_i64("start", 2i64);
    let o2: QRows = match qo.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e5) => { return 11i32; }
    };
    if o2.row_count() != 2i64 { return 12i32; }
    if o2.get_i64(0i64, 0i64) != 3i64 { return 13i32; }
    if o2.get_i64(1i64, 0i64) != 5i64 { return 14i32; }
    let e2: QRows = match qe.run(&env) {
        Result::Ok(r) => { r }
        Result::Err(_e6) => { return 15i32; }
    };
    if e2.row_count() != 1i64 { return 16i32; }
    if e2.get_i64(0i64, 0i64) != 4i64 { return 17i32; }

    return 0i32;
}
