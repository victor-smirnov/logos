// Copyright 2026 Victor Smirnov
// Test: escape sequence handling in Hermes string parser.
//
// Covers:
//   1. "\"" → single double-quote byte (34)
//   2. "\\" → single backslash byte (92)
//   3. "\n" → newline byte (10)
//   4. "\t" → tab byte (9)
//   5. "\r" → carriage return byte (13)
//   6. Mixed: "a\nb"  → bytes [97, 10, 98], length 3
//   7. Map key with escaped string: {"a\"b": 1} → lookup key a"b → 1

package hermes_escape_strings;

use hermes.zone;
use hermes.anyval;
use hermes.string;
use hermes.typetag;
use hermes.containers;
use hermes.objectmap;
use hermes.document;
use hermes.parser;
use std.string;

// Append a byte to the buffer.  Thin wrapper to keep the test shape compact.
fn append(buf: &mut String, b: u8) {
    buf.push_u8(b);
}

// Parse `buf` into a fresh zone and return the root HermesString pointer
// (or null if the root isn't a zone-pointer / parse failed).
unsafe fn parse_string(buf: &String, zone: &mut Zone<Mutable>) -> *const HermesString {
    if !hermes_parse(buf.as_ptr(), buf.len(), zone) {
        return 0 as *const HermesString;
    }
    let root: AnyVal = document_get_root(
        document_header(zone.holder.base) as *const DocumentHeader);
    if !root.is_ptr() { return 0 as *const HermesString; }
    return (zone.holder.base as i64 + root.as_offset() as i64)
        as *const HermesString;
}

unsafe fn main() -> i32 {
    // ── 1. "\"" — lone escaped double quote ─────────────────────────────────
    // Input bytes:  " \ " "   →   decoded: single byte 34 (')
    let mut b1: String = String::with_capacity(4);
    append(&mut b1,  34 as u8);  // opening "
    append(&mut b1,  92 as u8);  // backslash
    append(&mut b1,  34 as u8);  // "  (escaped)
    append(&mut b1,  34 as u8);  // closing "
    let mut z1: Zone<Mutable> = zone_create(4096);
    let hs1: *const HermesString = parse_string(&b1, &mut z1);
    if hs1 == 0 as *const HermesString { return 1; }
    if hs1.len() != 1 as u64           { return 2; }
    if *hs1.bytes() != 34 as u8        { return 3; }

    // ── 2. "\\" — lone escaped backslash ────────────────────────────────────
    let mut b2: String = String::with_capacity(4);
    append(&mut b2,  34 as u8);
    append(&mut b2,  92 as u8);
    append(&mut b2,  92 as u8);  // backslash (escaped)
    append(&mut b2,  34 as u8);
    let mut z2: Zone<Mutable> = zone_create(4096);
    let hs2: *const HermesString = parse_string(&b2, &mut z2);
    if hs2 == 0 as *const HermesString { return 4; }
    if hs2.len() != 1 as u64           { return 5; }
    if *hs2.bytes() != 92 as u8        { return 6; }

    // ── 3. "\n" — escaped newline ────────────────────────────────────────────
    let mut b3: String = String::with_capacity(4);
    append(&mut b3,  34 as u8);
    append(&mut b3,  92 as u8);
    append(&mut b3, 110 as u8);  // 'n'
    append(&mut b3,  34 as u8);
    let mut z3: Zone<Mutable> = zone_create(4096);
    let hs3: *const HermesString = parse_string(&b3, &mut z3);
    if hs3 == 0 as *const HermesString { return 7; }
    if hs3.len() != 1 as u64           { return 8; }
    if *hs3.bytes() != 10 as u8        { return 9; }

    // ── 4. "\t" — escaped tab ────────────────────────────────────────────────
    let mut b4: String = String::with_capacity(4);
    append(&mut b4,  34 as u8);
    append(&mut b4,  92 as u8);
    append(&mut b4, 116 as u8);  // 't'
    append(&mut b4,  34 as u8);
    let mut z4: Zone<Mutable> = zone_create(4096);
    let hs4: *const HermesString = parse_string(&b4, &mut z4);
    if hs4 == 0 as *const HermesString { return 10; }
    if hs4.len() != 1 as u64           { return 11; }
    if *hs4.bytes() != 9 as u8         { return 12; }

    // ── 5. "\r" — escaped carriage return ───────────────────────────────────
    let mut b5: String = String::with_capacity(4);
    append(&mut b5,  34 as u8);
    append(&mut b5,  92 as u8);
    append(&mut b5, 114 as u8);  // 'r'
    append(&mut b5,  34 as u8);
    let mut z5: Zone<Mutable> = zone_create(4096);
    let hs5: *const HermesString = parse_string(&b5, &mut z5);
    if hs5 == 0 as *const HermesString { return 13; }
    if hs5.len() != 1 as u64           { return 14; }
    if *hs5.bytes() != 13 as u8        { return 15; }

    // ── 6. "a\nb" — mixed literal and escape ────────────────────────────────
    // Decoded: [97, 10, 98], length 3
    let mut b6: String = String::with_capacity(6);
    append(&mut b6,  34 as u8);
    append(&mut b6,  97 as u8);  // 'a'
    append(&mut b6,  92 as u8);
    append(&mut b6, 110 as u8);  // 'n'
    append(&mut b6,  98 as u8);  // 'b'
    append(&mut b6,  34 as u8);
    let mut z6: Zone<Mutable> = zone_create(4096);
    let hs6: *const HermesString = parse_string(&b6, &mut z6);
    if hs6 == 0 as *const HermesString { return 16; }
    if hs6.len() != 3 as u64           { return 17; }
    let b6_0: u8 = *hs6.bytes();
    let b6_1: u8 = *((hs6.bytes() as i64 + 1) as *const u8);
    let b6_2: u8 = *((hs6.bytes() as i64 + 2) as *const u8);
    if b6_0 != 97 as u8                { return 18; }  // 'a'
    if b6_1 != 10 as u8                { return 19; }  // LF
    if b6_2 != 98 as u8                { return 20; }  // 'b'

    // ── 7. {"a\"b": 1} — escaped quote in map key ───────────────────────────
    let mut b7: String = String::with_capacity(10);
    append(&mut b7, 123 as u8);  // '{'
    append(&mut b7,  34 as u8);  // '"'
    append(&mut b7,  97 as u8);  // 'a'
    append(&mut b7,  92 as u8);  // '\'
    append(&mut b7,  34 as u8);  // '"' (escaped)
    append(&mut b7,  98 as u8);  // 'b'
    append(&mut b7,  34 as u8);  // '"' (closing)
    append(&mut b7,  58 as u8);  // ':'
    append(&mut b7,  49 as u8);  // '1'
    append(&mut b7, 125 as u8);  // '}'
    let mut z7: Zone<Mutable> = zone_create(8192);
    if !hermes_parse(b7.as_ptr(), b7.len(), &mut z7) { return 21; }
    let r7: AnyVal = document_get_root(
        document_header(z7.holder.base) as *const DocumentHeader);
    if !r7.is_ptr() { return 22; }
    let omap7: *const ObjectMap =
        (z7.holder.base as i64 + r7.as_offset() as i64) as *const ObjectMap;
    if omap7.size_count() != 1 as u32 { return 23; }

    // Look up key `a"b` = [97, 34, 98].
    let mut key: String = String::with_capacity(3);
    append(&mut key, 97 as u8);
    append(&mut key, 34 as u8);
    append(&mut key, 98 as u8);
    let got7: AnyVal = omap7.get(z7.holder.base as *const u8,
                                 key.as_ptr(), key.len() as u64);
    if got7.is_null()                { return 24; }
    // i24(1) has raw = (1 << 8) | 0x2F = 0x0000012F
    if got7.raw != 0x0000012F as u32 { return 25; }

    return 42;
}
