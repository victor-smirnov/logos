// ADMIT CONTROL for fail/bc_d1r13_p0a_struct_destructure. The loan is never raised (the callee/arm only READS
// the container), so the later mutation must stay ADMITTED. A refusal rule that
// cannot be told from over-refusal by its message alone is priced here.
// ⚠ THE ARM DOES NOT CALL A METHOD THROUGH THE BINDING, and that is not
// stylistic: `n = s.len()` through a pattern-bound `&mut Vec<T>` returns
// GARBAGE on this tree (measured: exit 240/32 for a one-element Vec, and it
// reproduces with the D1 round 13 borrow-check changes REVERTED, so it is a
// pre-existing codegen defect and not this arc's). Asserting a value through
// a miscompiled shape would have pinned the defect green; the control instead
// binds the reference and reads `c.v`, which is the fact it is here to price.
package bc_d1r13_p0a_dead_admit;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct H { r: &mut Vec<B> }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let h: H = H { r: &mut vs };
    match h { H { r: s } => { let _keep: &mut Vec<B> = s; } }
    c.bump();                        // must be ADMITTED
    return c.v;
}
