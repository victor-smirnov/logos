// Generic trait: trait Into<T>
package trait_generic;

trait Into<T> {
    fn into(self: Self) -> T;
}

struct Celsius { v: i32; }

impl Into<i32> for Celsius {
    fn into(self: Celsius) -> i32 { return self.v; }
}

unsafe fn main() -> i32 {
    let c: Celsius = Celsius { v: 42 };
    return c.into();
}
