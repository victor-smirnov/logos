// format() via logos.std.fmt — variadic generics + Display trait
package variadic_format;

use logos.std.fmt;
use logos.std.io;
use logos.mem.string;
use logos.lang.str;

unsafe fn main() -> i32 {
    let s: String = format::<str, i32, bool>("{} says: x={}, ok={}", "logos", 42, true);
    println_string(&s);
    return 42;
}
