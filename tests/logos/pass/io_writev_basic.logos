// Vectored write + readback through a Pipe.  Exercises IoSlice layout
// (matches struct iovec: ptr,len) and Pipe::write_vectored / read_vectored.
//
// NOTE: this test builds the iovec array via a raw [i64; N] buffer rather
// than a [IoSlice; N] literal, because struct-array literals currently
// lay out elements with 8-byte stride instead of the struct's actual
// sizeof (16 bytes here).  Raw layout matches `struct iovec[]` exactly.

package test;

use logos.std.io.pipe;
use logos.std.io.write;  // IoSlice

fn main() -> i32 {
    let mut p: Pipe = pipe_new();
    if !p.is_valid() { return 1; }

    // Two source buffers: "hel" + "lo"
    let a: [u8; 3] = [104, 101, 108];
    let b: [u8; 2] = [108, 111];

    // iovec[2] laid out raw: (ptr, len, ptr, len)
    let mut wiov: [i64; 4] = [0 as i64, 0 as i64, 0 as i64, 0 as i64];
    wiov[0] = &a[0] as *const u8 as i64;
    wiov[1] = 3 as i64;
    wiov[2] = &b[0] as *const u8 as i64;
    wiov[3] = 2 as i64;

    let n: i64 = p.write_vectored(&wiov[0] as *const IoSlice, 2);
    if n != 5 as i64 { p.close(); return 2; }

    // Read back into two destination buffers via readv.
    let mut x: [u8; 2] = [0, 0];
    let mut y: [u8; 3] = [0, 0, 0];

    let mut riov: [i64; 4] = [0 as i64, 0 as i64, 0 as i64, 0 as i64];
    riov[0] = &x[0] as *const u8 as i64;
    riov[1] = 2 as i64;
    riov[2] = &y[0] as *const u8 as i64;
    riov[3] = 3 as i64;

    let nr: i64 = p.read_vectored(&riov[0] as *mut IoSlice, 2);
    if nr != 5 as i64 { p.close(); return 3; }

    // Expect x=[h,e] y=[l,l,o]
    if x[0] as i32 != 104 { p.close(); return 4; }
    if x[1] as i32 != 101 { p.close(); return 5; }
    if y[0] as i32 != 108 { p.close(); return 6; }
    if y[1] as i32 != 108 { p.close(); return 7; }
    if y[2] as i32 != 111 { p.close(); return 8; }

    p.close();
    return 42;
}
