// Regression for debt #16: `quote_item!` accepts REPEAT_GROUP and
// antiquoted field-name `#name` in struct field-list position.
//
// Local handler builds two parallel Vec<Ident> cursors (field names
// and field types) and emits a struct whose body is generated by
// `#( pub #names: PrimVec<#types> ),*` — two-cursor parallel
// iteration over the field-list.

package main;

use std.compiler.metaprog;
use logos.mem.collections.vec;
use logos.lang.hermes.view;
use logos.mem.hermes.view;
use logos.lang.hermes.anyval;
use logos.mem.hermes.string;
use logos.mem.hermes.fabric;

#[metaprog_handler("derive_struct_with_cols")]
fn derive_struct_with_cols_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }
    let item: AnyVal = AnyVal::from_offset(target_offset);
    if view.ast_node_name(item).len == (0 as u64) { return; }

    let s_a:   str = "a";
    let s_b:   str = "b";
    let s_u64: str = "u64";
    let s_i64: str = "i64";
    let mut col_names: Vec<Ident> = vec_new::<Ident>();
    let mut col_types: Vec<Ident> = vec_new::<Ident>();
    unsafe {
        (&mut col_names as *mut Vec<Ident>).push(Ident { ptr: s_a.as_ptr(),   len: s_a.len()   as u64 });
        (&mut col_types as *mut Vec<Ident>).push(Ident { ptr: s_u64.as_ptr(), len: s_u64.len() as u64 });
        (&mut col_names as *mut Vec<Ident>).push(Ident { ptr: s_b.as_ptr(),   len: s_b.len()   as u64 });
        (&mut col_types as *mut Vec<Ident>).push(Ident { ptr: s_i64.as_ptr(), len: s_i64.len() as u64 });
    }

    let blob: QuoteItemBlob = quote_item! {
        pub struct GeneratedCols {
            #( pub #col_names: PrimVec<#col_types> ),*
        }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}

#[derive_struct_with_cols]
pub struct Trigger {
    pub n: u64,
}

fn main() -> i32 {
    let sz: i64 = sizeof::<GeneratedCols>();
    if sz <= 0i64 { return 1; }
    return 0;
}
