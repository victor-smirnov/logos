// Option/Result method-surface fill-in (post Fmt-Session-4, post-
// mono-Phase-1 + sema turbofish-on-enum-lit fix).
//
// Direct-method coverage:
//   - Result::as_ref / as_mut (ref/mut-ref into inner via `ref v` /
//     `ref mut v` match bindings).
//
// Free-fn forms (Logos's inherent-impl partial-spec on nested generic
// shapes still doesn't dispatch through method position):
//   - option_zip<T, U>
//   - option_unzip<A, B>           — UNBLOCKED by sema fix.
//   - option_flatten<T>
//   - option_unwrap_or_default<T: Default>
//   - result_unwrap_or_default<T: Default, E>
//   - result_flatten<T, E>         — UNBLOCKED by sema fix.
//   - result_transpose<T, E>       — UNBLOCKED by sema fix.

package option_result_method_surface;

use logos.lang.option;
use logos.lang.result;
use logos.lang.default;

fn fail(code: i32) -> i32 { return code; }

fn main() -> i32 {
    // ── option_zip free fn ──────────────────────────────────────────
    let a: Option<i32> = Option::<i32>::Some(1i32);
    let b: Option<i64> = Option::<i64>::Some(2i64);
    match option_zip::<i32, i64>(a, b) {
        Option::Some(t) => {
            if t.0 != 1i32 { return fail(1); }
            if t.1 != 2i64 { return fail(2); }
        }
        Option::None => { return fail(3); }
    }

    let none_a: Option<i32> = Option::<i32>::None;
    let b2:     Option<i64> = Option::<i64>::Some(5i64);
    match option_zip::<i32, i64>(none_a, b2) {
        Option::Some(_) => { return fail(4); }
        Option::None    => {}
    }

    // ── option_unzip ────────────────────────────────────────────────
    let pair: Option<(i32, i64)> = Option::<(i32, i64)>::Some((10i32, 20i64));
    let parts: (Option<i32>, Option<i64>) = option_unzip::<i32, i64>(pair);
    match parts.0 {
        Option::Some(v) => { if v != 10i32 { return fail(10); } }
        Option::None    => { return fail(11); }
    }
    match parts.1 {
        Option::Some(v) => { if v != 20i64 { return fail(12); } }
        Option::None    => { return fail(13); }
    }

    let nope: Option<(i32, i64)> = Option::<(i32, i64)>::None;
    let parts2: (Option<i32>, Option<i64>) = option_unzip::<i32, i64>(nope);
    match parts2.0 {
        Option::Some(_) => { return fail(14); }
        Option::None    => {}
    }

    // ── option_flatten free fn ──────────────────────────────────────
    let nested: Option<Option<i32>> = Option::<Option<i32>>::Some(Option::<i32>::Some(42i32));
    match option_flatten::<i32>(nested) {
        Option::Some(v) => { if v != 42i32 { return fail(20); } }
        Option::None    => { return fail(21); }
    }

    let nested_none: Option<Option<i32>> = Option::<Option<i32>>::Some(Option::<i32>::None);
    match option_flatten::<i32>(nested_none) {
        Option::Some(_) => { return fail(22); }
        Option::None    => {}
    }

    // ── option_unwrap_or_default free fn ────────────────────────────
    let some_i32: Option<i32> = Option::<i32>::Some(7i32);
    if option_unwrap_or_default::<i32>(some_i32) != 7i32 { return fail(30); }
    let none_i32: Option<i32> = Option::<i32>::None;
    if option_unwrap_or_default::<i32>(none_i32) != 0i32 { return fail(31); }

    // ── Result::as_ref ──────────────────────────────────────────────
    let ok_r:  Result<i32, i64> = Result::<i32, i64>::Ok(99i32);
    let err_r: Result<i32, i64> = Result::<i32, i64>::Err(123i64);
    match ok_r.as_ref() {
        Result::Ok(v)  => { if *v != 99i32 { return fail(40); } }
        Result::Err(_) => { return fail(41); }
    }
    match err_r.as_ref() {
        Result::Ok(_)  => { return fail(42); }
        Result::Err(e) => { if *e != 123i64 { return fail(43); } }
    }

    // ── Result::as_mut ──────────────────────────────────────────────
    let mut ok_mut: Result<i32, i64> = Result::<i32, i64>::Ok(50i32);
    match ok_mut.as_mut() {
        Result::Ok(v)  => { *v = *v + 1i32; }
        Result::Err(_) => { return fail(50); }
    }
    match ok_mut {
        Result::Ok(v)  => { if v != 51i32 { return fail(51); } }
        Result::Err(_) => { return fail(52); }
    }

    // ── result_unwrap_or_default free fn ────────────────────────────
    let ok2:  Result<i32, i64> = Result::<i32, i64>::Ok(8i32);
    if result_unwrap_or_default::<i32, i64>(ok2) != 8i32 { return fail(60); }
    let err2: Result<i32, i64> = Result::<i32, i64>::Err(0i64);
    if result_unwrap_or_default::<i32, i64>(err2) != 0i32 { return fail(61); }

    // ── result_flatten ──────────────────────────────────────────────
    let inner_ok: Result<Result<i32, i64>, i64> =
        Result::<Result<i32, i64>, i64>::Ok(Result::<i32, i64>::Ok(70i32));
    let flat_ok: Result<i32, i64> = result_flatten::<i32, i64>(inner_ok);
    if !flat_ok.is_ok() { return fail(70); }
    if flat_ok.unwrap() != 70i32 { return fail(71); }

    let outer_err: Result<Result<i32, i64>, i64> =
        Result::<Result<i32, i64>, i64>::Err(81i64);
    let flat_err: Result<i32, i64> = result_flatten::<i32, i64>(outer_err);
    if !flat_err.is_err() { return fail(72); }
    if flat_err.unwrap_err() != 81i64 { return fail(73); }

    // ── result_transpose ────────────────────────────────────────────
    let ok_some: Result<Option<i32>, i64> =
        Result::<Option<i32>, i64>::Ok(Option::<i32>::Some(91i32));
    let t_some: Option<Result<i32, i64>> = result_transpose::<i32, i64>(ok_some);
    if !t_some.is_some() { return fail(80); }
    let r_ok: Result<i32, i64> = t_some.unwrap();
    if !r_ok.is_ok() { return fail(81); }
    if r_ok.unwrap() != 91i32 { return fail(82); }

    let ok_none: Result<Option<i32>, i64> =
        Result::<Option<i32>, i64>::Ok(Option::<i32>::None);
    let t_none: Option<Result<i32, i64>> = result_transpose::<i32, i64>(ok_none);
    if t_none.is_some() { return fail(83); }

    let err_t: Result<Option<i32>, i64> = Result::<Option<i32>, i64>::Err(99i64);
    let t_err: Option<Result<i32, i64>> = result_transpose::<i32, i64>(err_t);
    if !t_err.is_some() { return fail(84); }
    let r_err: Result<i32, i64> = t_err.unwrap();
    if !r_err.is_err() { return fail(85); }
    if r_err.unwrap_err() != 99i64 { return fail(86); }

    return 0;
}
