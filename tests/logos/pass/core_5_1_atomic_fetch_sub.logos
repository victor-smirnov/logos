// logos-core §5.1 — atomic fetch_sub: returns prev, updates to prev-delta.
package core_5_1_atomic_fetch_sub;
use logos.lang.atomic;
fn main() -> i32 {
    let mut a: AtomicI32 = atomic_i32_new(20i32);
    let p: *mut AtomicI32 = &mut a as *mut AtomicI32;
    let prev: i32 = unsafe { p.fetch_sub(3i32) };
    if prev != 20i32 { return 1i32; }
    if a.load() != 17i32 { return 2i32; }
    return 0i32;
}
