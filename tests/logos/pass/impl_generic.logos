package impl_generic;
// Generic impl: `impl<T> Pair<T>` — standalone generic impl block.
extern fn printf(fmt: *const u8, ...) -> i32;

class Pair<T> { first: T; second: T; }

impl<T> Pair<T> {
    fn get_first(self: Pair<T>) -> T { return self.first; }
    fn get_second(self: Pair<T>) -> T { return self.second; }
}

fn main() -> i32 {
    let p = new Pair { first: 10, second: 20 };
    let a = p.get_first();
    let b = p.get_second();
    printf("%d %d\n", a, b);
    return 0;
}
