// THE ADMIT TWIN of fail/ctr_family_mut_while_next_batch.logos (ADR 0025 §7
// rung 1, pulled through §1's pinned `next_batch()` signature): the same shape
// with the batch's — and the stream's — scope CLOSED before the mutation. It
// must compile AND answer correctly.
//
// "cannot borrow 'c' as mutable: 'c' has shared borrows" is byte-identical to
// what an OVER-refusing checker prints. A checker that carried the loan into
// the `Option` and then never released it — the easy way to close D1 wrongly —
// would red THIS half with those same words while making the container
// unusable after its first scan, and the fail half would look just as green.
// Only the pair separates a closed hole from a dead container.
//
// The values are the second half of the point: the scan AFTER the mutation
// must SEE the mutation (sum2 covers the inserted key), so the batch plane is
// reading the live tree and not a landing cached at construction. And the
// rows come out through the `Option` door specifically — `next_batch()` +
// `unwrap()`, the two by-value hops that used to launder the borrow — so this
// twin also proves the closure did not cost the door its results.
package ctr_family_next_batch_then_mut;

use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.sync;
use logos.lang.stream;
use logos.lang.option;
use logos.mem.bt.batch;     // PdtCol

pub container Led {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure count;
    measure max(key);
}

fn main() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();
    let snap: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    let mut c = create_ctr::<typeof(Led)>(&snap, 1u64);
    c.insert(1u64, 10u64);
    c.insert(2u64, 20u64);

    let mut sum: u64 = 0u64;
    let mut batches: u64 = 0u64;
    {
        let mut s = c.leaf_batches();
        loop {
            let ob = s.next_batch();
            if ob.is_some() {
                {
                    let b = ob.unwrap();     // the two by-value hops of D1
                    batches = batches + 1u64;
                    let kc: PdtCol = b.keys();
                    let vc: PdtCol = b.vals();
                    let n: u64 = b.len();
                    let mut j: u64 = 0u64;
                    while j < n { sum = sum + kc.at(j) + vc.at(j); j = j + 1u64; }
                }
            } else { break; }
        }
    }                                   // the batch's and the stream's borrows end HERE

    c.insert(3u64, 35u64);              // admitted: nothing is reading the tree

    let mut sum2: u64 = 0u64;
    {
        let mut s2 = c.leaf_batches();
        loop {
            let ob = s2.next_batch();
            if ob.is_some() {
                {
                    let b = ob.unwrap();
                    let kc: PdtCol = b.keys();
                    let n: u64 = b.len();
                    let mut j: u64 = 0u64;
                    while j < n { sum2 = sum2 + kc.at(j); j = j + 1u64; }
                }
            } else { break; }
        }
    }

    if batches != 1u64 { return 3i32; } // two entries = one leaf = one batch
    if sum  != 33u64 { return 1i32; }   // (1+10) + (2+20)
    if sum2 != 6u64  { return 2i32; }   // 1+2+3 — the second scan SEES the insert
    return 0i32;
}
