// #83 — ADMIT half of the generic-receiver door. THE FIX IS PRECISE, AND THIS
// FILE IS WHERE THAT IS PROVED: every shape below still compiles, including
// the one a CONSERVATIVE fix would have refused.
//
// The measure-only round for #83 costed a conservative route (treat an
// unresolvable receiver as retaining every ref-kind argument, the documented
// (d) route the FnPtrCall arm takes). It reds nothing on this tree, but it is
// measurably WRONG in the language: `self_sourced` below — a generic method
// whose result comes from `self` while its signature also takes a borrow —
// would have refused under it, stricter than BOTH the `&dyn` and the concrete
// spelling of the same program, where rustc accepts all three (elision rule 3
// gives the output `&self`'s lifetime). Repairing the NAME instead
// (resolve_call_flow's mono-key fallback) resolves `K::pick`'s real summary
// `result<-0x1` and admits it for the right reason. THIS FILE IS THE ONLY
// THING THAT KEEPS THAT DISTINCTION HONEST — a corpus that merely stayed green
// cannot tell a precise fix from a conservative one.
//
// The five shapes, each one variable away from fail/bc_esc_generic_recv_dangle:
//   self_sourced  callee returns `self.s`, signature still takes a borrow
//                 (result<-0x1: the argument is NOT retained)
//   owned_arg     the argument is moved in by value, so nothing is borrowed
//   recv_outlives the receiver outlives the call and the result is its view
//   thru_param    the retained argument is the CALLER'S OWN parameter
//   scalar        the result cannot carry a borrow at all
//   via_where     the callee is reached through a where-clause bound
//   outparam_ok   the &mut out-param is filled from the caller's parameter,
//                 not from a callee-frame local (the twin of
//                 fail/bc_esc_generic_outparam_dangle)
package bc_esc_generic_recv_admit;

use logos.mem.string;

pub trait Tr {
    fn thru(&self, s: str) -> str;
    fn pick(&self, probe: str) -> str;
    fn keep(&self, s: String) -> i64;
    fn n(&self) -> i64;
    fn stash(&self, s: str, out: &mut str);
}

pub struct K { pub z: i64, pub s: str }

impl Tr for K {
    fn thru(&self, s: str) -> str { return s; }
    fn pick(&self, probe: str) -> str { return self.s; }
    fn keep(&self, s: String) -> i64 { return s.len(); }
    fn n(&self) -> i64 { return self.z; }
    fn stash(&self, s: str, out: &mut str) { *out = s; }
}

// The result comes from `self`, and the frame-local borrow handed in as the
// argument is NOT retained. A conservative route refuses this; the summary
// admits it.
pub fn self_sourced<T: Tr>(t: &T) -> str {
    let o: String = String::from("hello");
    return t.pick(o.as_str());
}

pub fn owned_arg<T: Tr>(t: &T) -> i64 {
    let o: String = String::from("hello");
    return t.keep(o);
}

pub fn recv_outlives<T: Tr>(t: &T) -> str { return t.pick("probe"); }

pub fn thru_param<T: Tr>(t: &T, p: str) -> str { return t.thru(p); }

pub fn scalar<T: Tr>(t: &T) -> i64 {
    let o: String = String::from("hello");
    return t.n() + o.len();
}

pub fn via_where<T>(t: &T, p: str) -> str where T: Tr { return t.thru(p); }

pub fn outparam_ok<T: Tr>(t: &T, p: str) -> str {
    let mut v: str = "";
    t.stash(p, &mut v);
    return v;
}

fn main() -> i32 {
    let k: K = K { z: 1i64, s: "abcd" };
    if self_sourced::<K>(&k).len()  != 4i64 { return 1i32; }
    if owned_arg::<K>(&k)           != 5i64 { return 2i32; }
    if recv_outlives::<K>(&k).len() != 4i64 { return 3i32; }
    if thru_param::<K>(&k, "xyz").len() != 3i64 { return 4i32; }
    if scalar::<K>(&k)              != 6i64 { return 5i32; }
    if via_where::<K>(&k, "wq").len()   != 2i64 { return 6i32; }
    if outparam_ok::<K>(&k, "pq").len() != 2i64 { return 7i32; }
    return 0i32;
}
