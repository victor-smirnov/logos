// A match arm that moves ONE payload field of an enum local leaves the rest of the payload to the enum's scope-exit drop (rustc 1.98.1: exit 0).
package enum_payload_partial_move_leak;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
enum E { V(S, S), W }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let e: E = E::V(S { v: 1i64, i: p }, S { v: 2i64, i: p });
        match e {
            E::V(a, _) => { let _k: i64 = eat(a); },
            E::W => {}
        }
    }
    if c != 3i64 { return 1i32; }
    return 0i32;
}
