// PAIR (pass half) with fail/dbm_slice_default_shared_write_refused, ONE TOKEN
// apart: `&mut arr` here, `&arr` there. Closes soundness-queue row
// slice_copy_elem_no_default_mut_ref. Spec pat.binding.default-by-ref-mode.
package dbm_slice_default_ref_mut_writes;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
fn main() -> i32 {
    let mut arr: [i64; 2] = [3i64, 4i64];
    match &mut arr {
        [a, b] => { *a = *a + 1i64; if *b != 4i64 { return 2i32; } }
    }
    printi("%ld\n", arr[0]);
    printi("%ld\n", arr[1]);
    if arr[0] != 4i64 { return 1i32; }
    return 0i32;
}
