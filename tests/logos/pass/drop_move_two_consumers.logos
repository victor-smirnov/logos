// Test: two resources, one moved to function, one kept — correct drops for each
package drop_move_two_consumers;

extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: *const u8, v: i32) { unsafe { printf(fmt, v); } }

trait Drop { fn drop(self: Self); }

struct Res { id: i32; }

impl Drop for Res {
    fn drop(self: Res) { printi("d%d ", self.id); }
}

fn consume(r: Res) {
    printi("c%d ", r.id);
}

fn main() -> i32 {
    let result: i32 = 42;
    let a: Res = Res { id: 1 };
    let b: Res = Res { id: 2 };
    consume(a);
    // a is moved; b remains and is dropped at scope exit
    return result;
}
