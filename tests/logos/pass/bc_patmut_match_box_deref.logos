// `E::A(mut bb)` then `&mut *bb`: legal, runs. ONE TOKEN from fail/bc_patmut_match_box_deref_no_mut_fail. PROBES.md 2026-09-06b: the by-value pattern `mut` is carried into the LIR for match/if-let/while-let/for bindings.
package bc_patmut_match_box_deref;
enum E { A(Box<i64>), B }
fn main() -> i32 {
    let e: E = E::A(Box::new(1i64));
    match e {
        E::A(mut bb) => { let r: &mut i64 = &mut *bb; *r = 8i64; if *bb != 8i64 { return 1i32; } },
        E::B => {}
    }
    return 0i32;
}
