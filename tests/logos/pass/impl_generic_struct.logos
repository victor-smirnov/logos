package impl_generic_struct;
// impl<T> on generic struct — standalone impl block with type parameter.
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: *const u8, v: i32) { unsafe { printf(fmt, v); } }

struct Stack<T> {
    data: [T; 8],
    top: i32,
}

impl<T> Stack<T> {
    unsafe fn push(self: *mut Stack<T>, val: T) {
        self.data[self.top as u64] = val;
        self.top = self.top + 1;
    }
    unsafe fn pop(self: *mut Stack<T>) -> T {
        self.top = self.top - 1;
        return self.data[self.top as u64];
    }
    unsafe fn size(self: *mut Stack<T>) -> i32 {
        return self.top;
    }
}

unsafe fn main() -> i32 {
    let mut s: Stack<i32> = Stack { data: [0; 8], top: 0 };
    s.push(10);
    s.push(20);
    s.push(30);
    printi("%d\n", s.size());  // 3
    printi("%d\n", s.pop());   // 30
    printi("%d\n", s.pop());   // 20
    printi("%d\n", s.size());  // 1
    return 0;
}
