// WQL EDGE TRAVERSAL (slice D) — ANTI traversal, both forms:
//   `anti join d.emps e`           (no on) — keep d iff d.emps is EMPTY;
//   `anti join e.skills s on P`    (with on) — keep the bound row iff NO
//                                   element of e.skills satisfies P.
// Falls out of the nested-loop anti shape: scan-for-witness + `if (!__m)`.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

struct Emp  { pub name: str, pub skills: Vec<str> }
struct Dept { pub dname: str, pub emps: Vec<Emp> }

// Depts with NO employees at all (anti + empty-containment).
resource empty_depts = wql!(depts: &[Dept]) {
    from depts d
    anti join d.emps e
    select d.dname };

// Employees with NO "rust" skill (anti traversal WITH a predicate).
resource no_rust = wql!(depts: &[Dept]) {
    from depts d
    join d.emps e
    anti join e.skills s on s == "rust"
    select e.name };

fn mk_emp(name: str, s1: str, s2: str) -> Emp {
    let mut sk: Vec<str> = Vec::<str>::new();
    if s1.len() > 0i64 { sk.push(s1); }
    if s2.len() > 0i64 { sk.push(s2); }
    return Emp { name: name, skills: sk };
}

fn main() -> i32 {
    let mut eng_emps: Vec<Emp> = Vec::<Emp>::new();
    eng_emps.push(mk_emp("ann", "rust", "c"));   // has rust → excluded from no_rust
    eng_emps.push(mk_emp("bob", "cobol", ""));   // no rust  → kept
    eng_emps.push(mk_emp("cid", "", ""));        // no skills at all → kept (vacuous)
    let mut depts: Vec<Dept> = Vec::<Dept>::new();
    depts.push(Dept { dname: "eng",  emps: eng_emps });
    depts.push(Dept { dname: "idle", emps: Vec::<Emp>::new() });   // empty → empty_depts

    let ed: Vec<str> = empty_depts(depts.as_slice());
    if ed.len() != 1i64 { return 1i32; }
    if !str_eq(ed.get(0i64), "idle") { return 2i32; }

    let nr: Vec<str> = no_rust(depts.as_slice());
    if nr.len() != 2i64 { return 3i32; }
    if !str_eq(nr.get(0i64), "bob") { return 4i32; }
    if !str_eq(nr.get(1i64), "cid") { return 5i32; }
    return 0i32;
}
