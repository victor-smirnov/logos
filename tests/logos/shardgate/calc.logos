pub fn dyn_b_6() -> i64 { let b: Box<dyn Sp> = box_new(B { tag: String::from("b6"), y: 12i64 }) as Box<dyn Sp>; return b.v(); }
pub fn dyn_b_7() -> i64 { let b: Box<dyn Sp> = box_new(B { tag: String::from("b7"), y: 14i64 }) as Box<dyn Sp>; return b.v(); }
pub fn dyn_b_8() -> i64 { let b: Box<dyn Sp> = box_new(B { tag: String::from("b8"), y: 16i64 }) as Box<dyn Sp>; return b.v(); }
pub fn dyn_b_9() -> i64 { let b: Box<dyn Sp> = box_new(B { tag: String::from("b9"), y: 18i64 }) as Box<dyn Sp>; return b.v(); }
pub fn dyn_b_10() -> i64 { let b: Box<dyn Sp> = box_new(B { tag: String::from("b10"), y: 20i64 }) as Box<dyn Sp>; return b.v(); }
