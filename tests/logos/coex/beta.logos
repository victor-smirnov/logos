package beta;

use logos.mem.collections.vec;
use logos.lang.any;

pub fn shared(x: i32) -> i32 { return x + 100; }
pub fn beta_only() -> i32 { return 11; }

// G156-1 regression: DIFFERENT layout than alpha::Ping (two i64 fields vs one
// i32) so a silent layout-pick corrupts the sum and the test exit diverges.
pub struct Ping { pub x: i64, pub y: i64 }
pub fn beta_ping_sum() -> i64 {
    let mut v: Vec<Ping> = Vec::<Ping>::new();
    v.push(Ping { x: 10, y: 20 });
    v.push(Ping { x: 30, y: 40 });
    return v[0].x + v[0].y + v[1].x + v[1].y;   // 100
}
// G156-1 sibling (runtime type-UID): distinct from alpha::Ping's.
pub fn beta_ping_tid() -> u64 { return type_id_of::<Ping>().lo; }

// G156-1 sibling: beta's LIMIT (distinct value) coexists with alpha's.
pub const LIMIT: i32 = 20;
pub fn beta_limit() -> i32 { return LIMIT; }
pub fn beta_is_limit(x: i32) -> bool {
    match x {
        LIMIT => { return true; }
        _ => { return false; }
    }
}

// ── dyn_vtable_bare_key carrier (2026-09-11) ────────────────────────────────
// beta's half. DIFFERENT method body (+2000) on purpose: an overwrite is only
// observable when the two method vectors disagree. See alpha.logos.
pub trait Dyg { fn mark(&self) -> i64; }
pub struct Dz { pub v: i64 }
impl Dyg for Dz { fn mark(&self) -> i64 { return self.v + 2000i64; } }
pub fn beta_dyn_mark(n: i64) -> i64 {
    let t: Dz = Dz { v: n };
    let d: &dyn Dyg = &t;
    return d.mark();
}

// ── enum_bare_key carrier (2026-09-11) ──────────────────────────────────────
// beta's half. FIVE variants and `: i64` on purpose: a bare-keyed registry is
// only observable when the two enums' BACKING TYPES differ. See alpha.logos.
pub enum Kolej : i64 { A = 10, B = 20, C = 30, D = 40, E = 50 }
pub fn beta_kolej_size() -> i64 { return sizeof::<Kolej>() as i64; }
pub fn beta_kolej_arr() -> i64 { return sizeof::<[Kolej; 4]>() as i64; }
