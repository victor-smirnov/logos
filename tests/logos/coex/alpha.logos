package alpha;

use logos.mem.collections.vec;
use logos.lang.any;

pub fn shared(x: i32) -> i32 { return x + 1; }
pub fn alpha_only() -> i32 { return 7; }

// G156-1 regression: `alpha::Ping` and `beta::Ping` are same-named structs in
// DIFFERENT packages of the SAME module (identical module_id). Without folding
// the PACKAGE into the type-arg mangle, both `Vec<Ping>` instances collapse to
// one symbol `Vec$G1$Ping$Mcoex__*` and the linker silently picks one LAYOUT.
pub struct Ping { pub a: i32 }
pub fn alpha_ping_sum() -> i32 {
    let mut v: Vec<Ping> = Vec::<Ping>::new();
    v.push(Ping { a: 3 });
    v.push(Ping { a: 4 });
    return v[0].a + v[1].a;   // 7
}
// G156-1 sibling (runtime type-UID): type_id_of::<Ping>() must be package-
// DISTINCT from beta::Ping so Any/downcast can't confuse the two (type_id_canon
// folds the package for ambiguous names via collect_module_tags).
pub fn alpha_ping_tid() -> u64 { return type_id_of::<Ping>().lo; }

// G156-1 sibling (package-scoped consts): `alpha::LIMIT` and `beta::LIMIT` are
// same-named consts in different packages of one module. Pre-fix this tripped
// `duplicate const 'LIMIT'`; now they coexist and each package's code resolves
// its OWN LIMIT (current-package-first).
pub const LIMIT: i32 = 10;
pub fn alpha_limit() -> i32 { return LIMIT; }
pub fn alpha_is_limit(x: i32) -> bool {
    match x {
        LIMIT => { return true; }
        _ => { return false; }
    }
}

// ── dyn_vtable_bare_key carrier (2026-09-11) ────────────────────────────────
// `alpha::Dyg` and `beta::Dyg` are same-named traits in different packages of
// ONE module, each implemented for its OWN same-named `Dz`. `mlir_gen_dyn.cpp`
// registers the method vector under `td.name() + "::" + ib.target_type()` —
// BOTH SIDES BARE — so both packages file under the single key `Dyg::Dz` and
// the second registration overwrites the first. `alpha_dyn_mark()` then
// dispatches through beta's `mark`. The two vtable GLOBALS are module-distinct
// (`__logos_vtable__Dyg__Dz$M…`); the method VECTOR behind one of them is not.
pub trait Dyg { fn mark(&self) -> i64; }
pub struct Dz { pub v: i64 }
impl Dyg for Dz { fn mark(&self) -> i64 { return self.v + 1000i64; } }
pub fn alpha_dyn_mark(n: i64) -> i64 {
    let t: Dz = Dz { v: n };
    let d: &dyn Dyg = &t;
    return d.mark();
}

// ── enum_bare_key carrier (2026-09-11) ──────────────────────────────────────
// `alpha::Kolej` and `beta::Kolej` are same-named enums in different packages
// of ONE module. `mlir_gen.cpp` pass 0.5 registered `enum_types_[ed.name()]` —
// the BARE name — so only one of the two could hold the slot, and every
// `sizeof` of the loser resolved against the WINNER's backing type. THREE
// variants, `: u8`, so this half is 1 byte and the array stride is 1; beta's is
// `: i64` and 8. On a bare-keyed registry one of the four numbers below is
// wrong, and WHICH one depends only on registration order.
pub enum Kolej : u8 { Lo = 1, Mid = 2, Hi = 3 }
pub fn alpha_kolej_size() -> i64 { return sizeof::<Kolej>() as i64; }
pub fn alpha_kolej_arr() -> i64 { return sizeof::<[Kolej; 4]>() as i64; }
