// 2026-09-05a: a &mut S reached through a SHARED reference local (&&mut S) may not give out &mut — E0596 'behind a & reference'; the MutRef-spelled exemption must not fire for a shared root.
package bc_recvaot_ref_to_mutref_local_fail;
struct S { v: i64 }
impl S {
    fn get(&mut self) -> &mut i64 { return &mut self.v; }
}
fn main() -> i32 {
    let mut s: S = S { v: 1i64 };
    let sr: &mut S = &mut s;
    let rr: &&mut S = &sr;
    let r: &mut i64 = rr.get();
    *r = 3i64;
    return 0i32;
}
