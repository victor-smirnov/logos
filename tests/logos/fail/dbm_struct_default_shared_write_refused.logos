// PAIR (fail half) with pass/dbm_struct_default_ref_mut_writes, ONE TOKEN apart:
// `&s` here, `&mut s` there. A shared `&` scrutinee binds `x : &i64`; the write
// must be refused.
package dbm_struct_default_shared_write_refused;
struct S { x: i64, y: i64 }
fn main() -> i32 {
    let mut s: S = S { x: 3i64, y: 4i64 };
    match &s {
        S { x, y } => { *x = *x + 1i64; if *y != 4i64 { return 2i32; } }
    }
    if s.x != 4i64 { return 1i32; }
    return 0i32;
}
