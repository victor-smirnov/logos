// RETRACTION THROUGH RECURSION IS REFUSED, AND THIS IS WHAT MAKES THE REFUSAL
// LOAD-BEARING.
//
// P3b gives a recursive `rel` an incremental handle for INSERTS. It does not
// give it retraction, and the ground is a fact rather than a deferral: a derived
// fact may support ITSELF through a cycle — `path(1,2)` is re-derived from
// `path(1,3)` and `edge(3,2)` once the cycle closes — so "subtract what this
// fact added" names no amount. The correct mechanism is DRed (over-delete every
// consequence, compact, re-derive from surviving support), which is a provenance
// state machine and not an inverse fold.
//
// ⚠ A REFUSAL THAT ONLY EXISTS AS A TRACE LINE IS NOT LOAD-BEARING. The
// eligibility gate reads the traced GROUND, which catches the ground being
// reworded — but a compiler that emitted `<q>_retract` anyway while still
// tracing "declined" would pass it. What is asserted here is the ARTIFACT: the
// name does not exist, so a program that reaches for it does not COMPILE.
//
// ⚠ AND IT BITES. `incr_retract_eligible`'s rel clause selects the insert-only
// surface; delete it and `tc_retract` is emitted, this fixture COMPILES, and a
// `fail/` test that compiles is a RED test on the per-commit path. That is the
// control, and it is the reason this file exists as a `fail/` fixture rather
// than as a sentence in a header.
//
// `__wd` does not exist anywhere in this query's emitted code either: with no
// `<q>_apply` there is no weight parameter, so folding a derived row at a weight
// is not expressible rather than merely wrong.
package test;

use logos.std.wql.wql;
use logos.lang.result;
use logos.mem.collections.vec;

struct E { pub a: i64, pub b: i64 }

pub deem tc(es: &[E]) {
    rel path(a: i64, b: i64) {
        from es e select (e.a, e.b);
        from path p join es e on p.b == e.a select (p.a, e.b);
    }
    from path p group by p.a aggregate c = count() select (key, c)
}

fn main() -> i32 {
    let mut h: TcIncr = tc_incremental();
    let mut v: Vec<E> = vec_new::<E>();
    v.push(E { a: 1i64, b: 2i64 });
    match tc_epoch(&mut h, v.as_slice()) {
        Result::Ok(_n) => { } Result::Err(_e) => { return 1i32; }
    }
    // ⚠ THE LINE UNDER TEST. `tc_retract` is not emitted for a rel-backed query.
    match tc_retract(&mut h, v.as_slice()) {
        Result::Ok(_n) => { } Result::Err(_e) => { return 2i32; }
    }
    return 0i32;
}
