// D1 round 12 / A2 — AN OUT-PARAM DEPOSIT IS AN ALIAS, NOT ONLY A LOAN MOVE.
// `wire` summarises `result<-0 out0<-0x2`, the TRUE mask, so the loss is not in
// the summarizer: `apply_flow_outparams` had only the RETROSPECTIVE half
// (inherit_loans / take_ref_borrows move loans the argument ALREADY carries).
// A borrow deposited into an out-param therefore created no reborrow edge, and
// a loan raised AFTER the call never reached `vs`.
//
// The two discriminators that make this a leak rather than a policy are both in
// the corpus beside it: bc_d1r12_a2_loan_before_twin (the same program with the
// loan raised BEFORE the call — the retrospective half does work) and
// bc_d1r12_a2_direct_twin (`t.x = &mut vs` spelled inline). Both refused before
// this fix. The ONLY difference between refusal and admission was whether the
// borrow crossed the call.
package bc_d1r12_a2_outparam_prospective;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct T { x: &mut Vec<B> }
fn wire(t: &mut T, v: &mut Vec<B>) { t.x = v; }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut ws: Vec<B> = Vec::new();
    let mut t: T = T { x: &mut ws };
    wire(&mut t, &mut vs);
    t.x.push(c.mk());                // loan raised AFTER the call
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
