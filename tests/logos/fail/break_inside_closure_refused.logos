// An unlabeled break inside a closure cannot leave the enclosing fn's loop (rustc E0267); it was admitted and broke the outer loop.
package break_inside_closure_refused;
fn t() -> i64 { let mut n = 0; loop { let f = || { break; }; f(); n += 1; if n > 2 { break; } } n }
fn main() -> i32 { return 0; }
