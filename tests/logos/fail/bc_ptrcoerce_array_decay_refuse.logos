// ⚠ 2026-09-16d: THE VERDICT IS UNCHANGED (still refused); THE SENTENCE CHANGED, and only the TEXT
// oracle saw it. The old wording said "variance mismatch ... lifetime structure incompatible" —
// that reason was an ARTEFACT of the array-decay branch, which compared the array's ELEMENT type
// against the pointee and failed on variance. Ruling 3a removed that branch (rustc has no such
// coercion, E0308), so the program is now refused by the plain type mismatch instead, which is the
// Rust-correct reason. `.expected` re-pinned to the sentence the compiler actually gives.
package bc_ptrcoerce_array_decay_refuse;
extern fn printf(fmt: *const u8, ...) -> i32;
fn show(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
static G: i64 = 7i64;
fn first<'a>(x: &[&'a i64; 2]) -> *const &'static i64 {
    return x;
}
fn main() -> i32 {
    let a: [&'static i64; 2] = [&G, &G];
    let p: *const &i64 = first(&a);
    let k: i64 = unsafe { **p };
    show("k=%lld", k);
    return k as i32;
}
