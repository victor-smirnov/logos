// `Rc<A>` to `Rc<dyn Other>` with `A: !Other` is E0277 at the coercion (rustc 1.98.1), refused
// by sema with one sentence — no longer an mlir-gen "no vtable" (squeue row of the same name).
package wrapper_unsize_missing_impl_backend_diag;
use logos.lang.rc;

trait Sp { fn v(&self) -> i64; }
trait Other { fn w(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }

fn main() -> i32 {
    let rc: Rc<A> = rc_new(A { x: 17i64 });
    let d: Rc<dyn Other> = rc;
    if d.w() != 17i64 { return 10i32; }
    return 0i32;
}
