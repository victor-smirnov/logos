// WQL — A KEY THE EMITTED KEY VECTOR CANNOT HOLD IS REFUSED, WITH ITS GROUND.
//
// The sort collects keys into a vector typed with the class's REPRESENTATIVE
// (i64 / f64 / str / bool), and the key expression has whatever type the query
// gave it. Those coincide only when the key type IS its own repr, or when the
// normalization into it preserves every value (`ElTy.fits` — u8..u32, u56, i8..
// i32, isize, f32, all pinned working by wql_widened_col_e2e).
//
// `u64` is the case where it does not: the `as i64` normalization REINTERPRETS,
// so every value at or above 2^63 arrives negative and the sort ranks the largest
// values below zero — with a comparison that is TOTAL and identical in every nest,
// which is exactly why no downstream plan decision can detect it.
//
// ⚠ WHAT THIS REPLACES IS NOT A WEAKER CHECK, IT IS NO CHECK. Before the key was
// normalized through the type, this query reached the backend and failed as
//   <metaprog-blob-subst>: error [fn sorted_run]: method 'Vec__push' arg 1:
//   expected i64, got u64
// — a type error in a generated line, naming neither the key nor the reason. The
// refusal now names the failed antecedent and the remedy, which is the whole point
// of a type domain that carries the type.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct Rec { pub id: i64, pub v: u64 }

pub deem sorted(src: &[Rec]) { from src s select s.id order by s.v }

fn main() -> i32 {
    let rs: [Rec; 1] = [ Rec { id: 1i64, v: 1u64 } ];
    let out: Vec<i64> = sorted(&rs[..]).unwrap();
    return out.len() as i32;
}
