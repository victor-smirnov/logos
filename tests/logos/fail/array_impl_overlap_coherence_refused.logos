// E0119: `impl<T> Kind for [T; 2]` and `impl Kind for [u8; 2]` overlap (array impl keys are compared by pattern).
package array_impl_overlap_coherence_refused;
trait Kind { fn kind(&self) -> i64; }
impl<T> Kind for [T; 2] { fn kind(&self) -> i64 { return 100i64; } }
impl Kind for [u8; 2] { fn kind(&self) -> i64 { return 200i64; } }
fn main() -> i32 { let a: [u8; 2] = [1u8, 2u8]; return (a.kind() - 200i64) as i32; }
