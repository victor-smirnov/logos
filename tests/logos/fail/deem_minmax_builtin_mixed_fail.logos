// `max(a, b)` over an i64 and an i32 column: two types, refused as the
// comparison `a < b` over them is (Rust's mismatched types).
package test;
use logos.std.wql.wql;
use logos.mem.collections.vec;
struct P { pub a: i64, pub s: i32 }
pub deem q(ps: &[P]) { from ps x select max(x.a, x.s) }
fn main() -> i32 { return 0i32; }
