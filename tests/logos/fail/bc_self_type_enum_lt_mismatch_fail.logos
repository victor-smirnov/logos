// An enum lives in `enums_`, so the `impl_self_ty` fallback chain — which has a
// struct arm and a datatype arm — used to hand back a bare `C` with no lifetime
// arguments. Pair twin: pass/bc_self_type_enum_lt_match.logos, ONE TOKEN apart.
package bc_self_type_enum_lt_mismatch_fail;
enum C<'a> { R(&'a i64), O(i64) }
impl<'a> C<'a> {
    fn g(self: &C<'static>) -> i64 { return 0i64; }
}
fn main() -> i32 {
    let n: i64 = 1i64;
    let c: C = C::R(&n);
    return c.g() as i32;
}
