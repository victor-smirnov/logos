// D1 round 10 / J0 at the MATCH join, which never called merge_loans at all.
// The arm fold took `merged_s = states_` (whole VarStates, counters included)
// for the FIRST surviving arm and thereafter folded only `st.moved`, so arm 1's
// counters survived BY ACCIDENT and arms 2..n's were discarded. This file is
// the arm-1 witness's twin with the call moved to arm 2; before the fix the
// two verdicts differed (rc=1 vs rc=0) on the same program.
package bc_d1r10_j0_match_second_arm;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn stash(c: &C, v: &mut Vec<B>) { v.push(c.mk()); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    match c.v {
        0i64 => { }
        _ => { stash(&c, &mut vs); }
    }
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
