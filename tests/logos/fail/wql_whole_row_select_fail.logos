// #737 — a row selected whole over a filter is copied out of the source, so a
// row type that is neither `Copy` nor `Clone` is refused at the select.
package test;
use logos.std.wql.wql;
use logos.mem.collections.vec;
struct Person { pub name: String, pub age: i64 }
pub deem t(ps: &[Person]) { from ps p where p.age > 1 select p }
fn main() -> i32 { return 0i32; }
