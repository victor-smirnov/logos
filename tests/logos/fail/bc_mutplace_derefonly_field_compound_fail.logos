// `w.f += 6` (auto-deref field compound) where W: Deref only: E0594, refused (it compiled and RAN). Twin pass/bc_mutplace_derefmut_field_compound adds the DerefMut impl.
// PROBES.md 2026-09-08a: a place in a mutable-use position takes the DerefMut/IndexMut step at every level, a Deref-only/Index-only step is refused, and the bare `deref_mut()` receiver is asked the binding-mut question.
package bc_mutplace_derefonly_field_compound_fail;
use logos.lang.ops;
struct S { f: i64 }
struct W { inner: S }
impl Deref<S> for W { fn deref(&self) -> &S { return &self.inner; } }
fn main() -> i32 {
    let mut w: W = W { inner: S { f: 1i64 } };
    w.f += 6i64;
    return 0i32;
}
