// logos-core §6.1: union pattern outside `unsafe` is rejected —
// Rust spec `items.union.pattern.safety` (matching reads the named
// field's memory).
package core_6_1_union_pattern_nounsafe;

union Pair {
    a: i32,
    b: i32,
}

fn main() -> i32 {
    let u: Pair = Pair { a: 42i32 };
    let r: i32 = match u {
        Pair { a } => a,
    };
    if r != 42i32 { return 1i32; }
    return 0i32;
}
