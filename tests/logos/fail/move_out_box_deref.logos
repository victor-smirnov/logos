// `let s = *b` over a Box<move-type> is a move out of the Box's pointee. Rust's
// Box has built-in DerefMove; Logos does not implement it, so left unchecked it
// bit-copies the content and both the copy and the Box's Drop free it (double
// free / abort). Rejected with E0507 (a clear error beats silent UB). For
// Rc/user-Deref this is genuinely E0507 in Rust too.
package move_out_box_deref;
use logos.mem.string;
fn main() -> i32 {
    let b: Box<String> = Box::new(String::from("x"));
    let s = *b;
    let _ = s;
    0i32
}
