// The MERGE half: `x` is assigned on only ONE arm of the if, so it is possibly
// uninitialised at the borrow. Rust: E0381. PAIR: bc_uninitborrow_bothbranches_admit,
// which differs by the `else` arm alone.
package bc_uninitborrow_onebranch_refuse;
fn f(c: i64) -> i32 {
    let mut x: i64;
    if c == 0i64 { x = 1i64; }
    let p: &i64 = &x;
    return *p as i32;
}
fn main() -> i32 { return f(0i64); }
