// TWIN for bc_d1r13_p0a_struct_destructure. The SAME program with the binding
// spelled as a field read instead of a pattern — one variable — and it refused
// before the fix as well. It is the discriminator: without it "the destructure
// admits" is a sentence about a checker that might refuse everything of this
// shape, and with it the two spellings are pinned to the same verdict.
package bc_d1r13_p0a_field_read_twin;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct H { r: &mut Vec<B> }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut h: H = H { r: &mut vs };
    let s: &mut Vec<B> = h.r;
    s.push(c.mk());
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
