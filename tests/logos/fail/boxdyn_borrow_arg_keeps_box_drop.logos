// PAIR HALF (fail) — passing the same owning `Box<dyn Tr>` local BY VALUE does
// consume it. ONE CALL apart from
// tests/logos/pass/boxdyn_borrow_arg_keeps_box_drop.logos: `use_ref(&b)` there,
// `eat(b)` here. The guard added for the closed row
// boxdyn_arg_deref_borrow_kills_box_drop keys on the EXPRESSION's type
// (a borrowed trait object is not an owner), so it must not reach this half.
// rustc: E0382.
package boxdyn_borrow_arg_keeps_box_drop;
use logos.mem.boxed;
extern fn printf(fmt: *const u8, ...) -> i32;
fn say(s: str) { unsafe { printf(s.as_ptr()); } }

trait Sp { fn v(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }
impl Drop for A { fn drop(self: &mut A) { say("D"); } }

fn use_ref(r: &dyn Sp) -> i64 { return r.v(); }
fn eat(b: Box<dyn Sp>) -> i64 { return b.v(); }

fn main() -> i32 {
    {
        let b: Box<dyn Sp> = box_new(A { x: 42i64 });
        if eat(b) != 42i64 { return 1i32; }
        if b.v() != 42i64 { return 2i32; }
    }
    say("|END");
    return 0i32;
}
