// Assigning to a range-for variable declared without `mut` is E0384; before 2026-09-09b
// it compiled and the write STEERED THE LOOP (the named var was the induction slot).
// Twin: bc_bindmut_for_range_mut_assign. From soundness-queue row for_range_var_assign_admit.
package bc_bindmut_for_range_nomut_assign_fail;
fn main() -> i32 {
    let mut acc: i64 = 0i64;
    for i in 0i64..3i64 {
        i = i + 10i64;
        acc = acc + i;
    }
    if acc != 33i64 { return 1i32; }
    return 0i32;
}
