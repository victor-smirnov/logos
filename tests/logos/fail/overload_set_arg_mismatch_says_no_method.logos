// A SUFFIXED integer literal has its suffix's type (Rust: `9u64` is `u64`,
// E0308 at a `u8` or `i64` slot). The dispatch selector already refused to
// narrow it; the coercion judgment (widen_int_expr) adopted any literal that
// FITS, so the reporting arm had nothing to say and the call read "'C' has no
// method 'put'". Both judgments now let only an UNSUFFIXED literal adopt a
// narrower width. Twin: tests/logos/pass/intlit_unsuffixed_adopts_overload.logos.
// Neighbour, same gate: tests/logos/fail/intlit_suffixed_let_no_narrowing.logos.
package overload_set_arg_mismatch_says_no_method;
struct C { v: i64 }
impl C {
    fn put(&self, _x: u8) -> i32 { return 1i32; }
    fn put(&self, _x: i64) -> i32 { return 2i32; }
}
fn main() -> i32 {
    let c: C = C { v: 1i64 };
    return c.put(9u64);
}
