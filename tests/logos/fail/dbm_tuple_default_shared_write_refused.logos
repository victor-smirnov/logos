// PAIR (fail half) with pass/dbm_tuple_default_ref_mut_writes, ONE TOKEN apart:
// `&t` here, `&mut t` there. A SHARED `&` scrutinee sets the default binding
// mode to `ref`, so `a : &i64` and a write through it must be REFUSED — the
// default-binding-mode mint must not hand out `&mut` on a shared borrow.
package dbm_tuple_default_shared_write_refused;
fn main() -> i32 {
    let mut t: (i64, i64) = (3i64, 4i64);
    match &t {
        (a, b) => { *a = *a + 1i64; if *b != 4i64 { return 2i32; } }
    }
    if t.0 != 4i64 { return 1i32; }
    return 0i32;
}
