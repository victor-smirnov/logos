// rustc E0277: `*b` over a `Box<dyn Tr>` / `&[T]` is an unsized place; taking
// it BY VALUE (a `let` initializer, an argument) has no size. The
// owning trait object's deref is its own representation, so `let d = *b;` was a
// silent move of `b`. Borrowing the place (`&*b`, `let ref d = *b`, `(*b).m()`) is
// legal and stays admitted (pass/box_dyn_as_ref_as_mut, the matrix twin 9_29).
package unsized_deref_by_value_e0277;
use logos.mem.boxed;
trait Shape { fn area(&self) -> i64; }
struct Ci { r: i64 }
impl Shape for Ci { fn area(&self) -> i64 { self.r } }
fn take<T>(t: T) -> i64 { 0 }
fn main() -> i32 {
    let b: Box<dyn Shape> = Box::new(Ci { r: 2 });
    let d = *b;
    let v: &[i64] = &[1, 2];
    let n = take(*v);
    return 0;
}
