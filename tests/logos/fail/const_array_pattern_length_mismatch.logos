// A const array pattern must have the scrutinee's length. rustc 1.98.1: E0308
// "mismatched types: expected `[u8; 3]`, found `[u8; 2]`".
package const_array_pattern_length_mismatch;
const K: [u8; 2] = [1u8, 2u8];
fn c(x: [u8; 3]) -> i32 { match x { K => { return 1; } _ => { return 0; } } }
fn main() -> i32 { return c([1u8, 2u8, 3u8]); }
