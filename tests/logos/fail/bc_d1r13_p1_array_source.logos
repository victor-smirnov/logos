// D1 round 13 / P1 (array) — the container-granular half. An array index is not
// a static path component (a dynamic `arr[i]` cannot be named, and under the
// flow-sensitive `set()` a per-element key could not be retracted element-wise),
// so the element edge is keyed at the ARRAY PLACE itself: the literal records
// `arr -> vs` and an index step answers the container place, appending nothing.
// A dynamic index therefore takes the same answer as a constant one and cannot
// silently drop the edge.
package bc_d1r13_p1_array_source;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct H { r: &mut Vec<B> }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut arr: [&mut Vec<B>; 1] = [&mut vs];
    let s: &mut Vec<B> = arr[0];
    s.push(c.mk());
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
