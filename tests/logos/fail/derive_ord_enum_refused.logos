// #[derive_ord] alone on an enum is refused as rustc refuses #[derive(Ord)] alone (E0277): the
// expansion needs its supertraits Eq and PartialOrd, which nothing here derives.
package derive_ord_enum_refused;
use logos.std.compiler.metaprog;
use logos.lang.cmp;
#[derive_ord]
enum E { A, B(i64) }
fn main() -> i32 { return 0; }
