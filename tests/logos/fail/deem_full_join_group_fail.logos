// `group by` over a `full join` is refused for now.
package test;
use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.option;
struct Emp { pub id: i64, pub dept: i64 }
struct Dept { pub id: i64, pub floor: i64 }
struct Boss { pub id: i64 }
pub deem q(es: &[Emp], ds: &[Dept], bs: &[Boss]) { from es e full join ds d on d.id == e.dept group by d.floor aggregate n = count() select n }
fn main() -> i32 { return 0i32; }
