// A `group by` over a `full join` may read only `key` and the aggregates: a
// group has no representative row, since either side may be absent
// (deem_full_join_group_e2e is the admitted twin).
package test;
use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.option;
struct Emp { pub id: i64, pub dept: i64 }
struct Dept { pub id: i64, pub floor: i64 }
pub deem q(es: &[Emp], ds: &[Dept]) { from es e full join ds d on d.id == e.dept group by d.floor aggregate n = count() select (n, e.id) }
fn main() -> i32 { return 0i32; }
