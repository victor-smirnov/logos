// The FAIL half of tests/logos/pass/bc_sigelide_impl_elides_receiver_pass, ONE
// TOKEN apart: the trait's return is `&'static i64` instead of `&'a i64`. The
// impl's return is ELIDED, and elision gives an output the RECEIVER's lifetime
// — shorter than 'static — so the impl is not a valid implementation. The pair
// is what says elision expansion computes the output's binder rather than
// waving the slot through.
package bc_sigelide_impl_elides_receiver_static_fail;
struct R {
    v: i64,
}

trait Peek {
    fn peek<'a>(self: &'a Self) -> &'static i64;
}

impl Peek for R {
    fn peek(self: &R) -> &i64 {
        return &self.v;
    }
}

fn main() -> i32 {
    return 0;
}
