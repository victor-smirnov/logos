// ADR 0039 D5 law 7: reading a released snapshot is impossible by
// construction. `release` consumes the snapshot, so a later read is a use
// of a moved value, refused at compile time.
package test;

use logos.lang.str;
use logos.lang.rc;
use logos.lang.cell;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.mem.version.vocab;
use logos.mem.version.laws;
use logos.mem.version.reference;
use logos.std.io;

fn main() -> i32 {
    let mut st: RefStore = ref_store_new();
    let r = st.root();
    let w = st.fork(&r);
    let s = w.commit();
    st.release(s);
    let v: u64 = s.version();
    return v as i32;
}
