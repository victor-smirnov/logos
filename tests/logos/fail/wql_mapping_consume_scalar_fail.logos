// ADR 0016: a mapping's scalar params bind at the consumption site by NAME
// IDENTITY — the consumer must declare a param with the same name and type.
// Missing one is a NAMED error, not an opaque downstream failure.
package test;

use logos.lang.writ.container;
use logos.std.wql.wql;
use logos.std.wql.mapping_item;
use logos.mem.collections.vec;

mapping Limits(g: &Writ, floor: i64) {
    pub rel over(key: str, v: i64) {
        from g ** x {i64} where x.vi >= floor select (x.key, x.vi);
    }
}

// No `floor: i64` param declared here.
resource bad = deem!(w: Limits) { from over o select o.v };

fn main() -> i32 { return 0i32; }
