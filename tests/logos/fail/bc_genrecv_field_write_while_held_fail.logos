// THE SAME LOST RECEIVER LOAN, READ FROM THE OTHER SIDE: not a second borrow
// but a WRITE THROUGH THE OWNER while the generic method's result is still
// live. The non-generic twin refuses with "cannot borrow 'c.v': 'c' is already
// mutably borrowed"; adding a type parameter to the method admitted it, so the
// assignment and `*a` aliased the same i64.
//
// Kept SEPARATE from fail/bc_genrecv_two_mut_conflict_fail on purpose: that one
// is caught by the borrow-vs-borrow conflict and this one by the
// borrow-vs-assignment one, two different checks over the same missing loan. A
// fix that deposits the loan on only one of the two paths passes one file and
// reds the other.
package bc_genrecv_field_write_while_held_fail;

struct C { v: i64 }

impl C {
    fn get<T>(&mut self) -> &mut i64 { return &mut self.v; }
}

fn main() -> i32 {
    let mut c: C = C { v: 1i64 };
    let a: &mut i64 = c.get::<i64>();
    c.v = 9i64;
    *a = 2i64;
    return 0i32;
}
