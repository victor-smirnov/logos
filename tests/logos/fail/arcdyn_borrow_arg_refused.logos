// `&Arc<dyn Sp>` at a `&dyn Sp` parameter: E0277, as for Rc and Box (rustc 1.98.1).
package arcdyn_borrow_arg_refused;
use logos.mem.sync;
trait Sp { fn v(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }
fn use_ref(r: &dyn Sp) -> i64 { return r.v(); }
fn main() -> i32 {
    let r: Arc<dyn Sp> = arc_new(A { x: 42i64 });
    return (use_ref(&r) - 42) as i32;
}
