// D1 round 13 / P2 — A DEPOSIT MUST FOLLOW THE REBORROW EDGE. The out-param
// deposit was keyed to the holder `h`, whose last use IS the call, so NLL
// retired the loan one line before `c.bump()`. The callee wrote through `h.r`,
// and `h.r` reborrows `vs`. The mask is IDENTICAL on both sides of the verdict
// split (`out0<-0x2` here and on the refusing direct-param twin), so the
// summarizer was right and the whole loss was caller-side.
package bc_d1r13_p2_outparam_deposit;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct H { r: &mut Vec<B> }
fn stash(h: &mut H, c: &C) { h.r.push(c.mk()); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut h: H = H { r: &mut vs };
    stash(&mut h, &c);
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
