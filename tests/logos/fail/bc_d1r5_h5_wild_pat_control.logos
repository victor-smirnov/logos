// D1 round 5 / H5 — CONTROL that the arm which WAS handled still is: a
// bare-name (Wild) binding. Refused before the fix and must stay refused.
package bc_d1r5_h5_wild_pat_control;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn stash(c: &C, v: &mut Vec<B>) {
    let w: B = c.mk();
    match w { all => { v.push(all); } }
}
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    stash(&c, &mut vs);
    c.bump();
    return *vs.get(0u64).p;
}
