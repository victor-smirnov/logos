// THE REFUSING HALF of the E0510 index-base loan (borrow_check.cpp, IndexRead).
// Paired with tests/logos/pass/bc_idxbase_read_in_index.logos, which pins the
// reads that must stay legal.
//
// This is the ONE program out of seventeen hand-written counter-examples that
// the mechanism refused, and it is refused for the upstream reason: writing a
// DIFFERENT element of the base from inside the base's own index is still a
// write to `a`, and rustc rejects it (E0510) exactly as it rejects the
// whole-array assignment in the imported twin
// (tests/imported/fail/borrowck/slice-index-bounds-check-invalidation--min).
// Element granularity is deliberately NOT claimed here: `a[0]` and `a[2]` are
// disjoint in fact, and rustc refuses anyway. FIELD granularity IS claimed and
// is pinned on the pass side.
package bc_idxbase_elem_write_in_index_fail;
fn main() -> i32 {
    let mut a: [i64; 3] = [1i64, 2i64, 3i64];
    let z: i64 = a[{ a[0u64] = 9i64; 2u64 }];
    return z as i32;
}
