// `Pin::get_mut` is gated on `T: Unpin` — a pinned !Unpin target must not
// hand out `&mut T` safely.
package pin_get_mut_not_unpin;
use logos.lang.pin;
use logos.lang.marker;
use logos.mem.boxed;

struct Gen { state: i32, _pp: PhantomPinned }

fn main() -> i32 {
    let mut pb: Pin<Box<Gen>> = box_pin(Gen { state: 0, _pp: PhantomPinned {} });
    let pm: Pin<&mut Gen> = pb.as_mut();
    let m: &mut Gen = pm.get_mut();
    m.state = 1;
    return m.state;
}
