// `&**b` with `b: Box<dyn Sp>`: `*b` is already the UNSIZED `dyn Sp` place, and
// a place of unsized type has no `*` — rustc 1.98.1: E0614, type `dyn Sp`
// cannot be dereferenced (the cure is to drop a `*`). The type cannot tell
// `dyn Tr` from `&dyn Tr` (one Kind), so lower_deref REPORTS when it returned
// its operand as the unsized place (deref_yielded_unsized_) and the enclosing
// deref / `&*` / `&mut *` refuses. Twins: tests/logos/pass/
// deref_dyn_place_legal_spellings.logos, tests/logos/fail/slice_double_deref_e0614.logos.
package boxdyn_double_deref_wrong_error_code;
use logos.mem.boxed;

trait Sp { fn v(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }

fn use_ref(r: &dyn Sp) -> i64 { return r.v(); }

fn main() -> i32 {
    let b: Box<dyn Sp> = box_new(A { x: 42i64 });
    if use_ref(&**b) != 42i64 { return 3i32; }
    return 0i32;
}
