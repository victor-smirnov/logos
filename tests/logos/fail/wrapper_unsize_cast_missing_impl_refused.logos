// The explicit `as Rc<dyn Other>` is refused the same way, with no cascade at the use.
package wrapper_unsize_cast_missing_impl_refused;
use logos.lang.rc;
trait Sp { fn v(&self) -> i64; }
trait Other { fn w(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }
fn main() -> i32 {
    let rc: Rc<A> = rc_new(A { x: 17i64 });
    let d = rc as Rc<dyn Other>;
    return d.w() as i32;
}
