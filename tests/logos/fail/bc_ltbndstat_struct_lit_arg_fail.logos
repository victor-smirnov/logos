// LANDED 2026-09-01.
package bc_ltbndstat_struct_lit_arg_fail;

struct Stat<T: 'static> { v: T }

fn f5<'a>(r: &'a i64) -> i64 {
    let s: Stat<&'a i64> = Stat::<&'a i64> { v: r };
    return 5i64;
}

fn main() -> i32 {
    let n: i64 = 0i64;
    if f5(&n) != 5i64 { return 5i32; }
    return 0i32;
}
