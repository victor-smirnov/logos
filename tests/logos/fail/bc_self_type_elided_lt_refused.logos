// `self: &C` inside `impl<'a> C<'a>` is rustc E0308 (mismatched `self` parameter type): an
// elided lifetime list is a FRESH region, not Self's. This file used to be the pass fixture
// pinning the opposite ("elision asserts nothing"), a wrong rule that admitted a receiver
// whose region was unrelated to Self's (deem's bare-holder `self: &mut P` push dangled).
package bc_self_type_elided_lt_refused;
enum C<'a> { R(&'a i64), O(i64) }
impl<'a> C<'a> {
    fn g(self: &C) -> i64 { return 0i64; }
}
fn main() -> i32 {
    let n: i64 = 1i64;
    let c: C = C::R(&n);
    return c.g() as i32;
}
