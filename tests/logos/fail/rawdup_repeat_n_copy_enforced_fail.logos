// RepeatNIter re-emits a BITWISE copy of its value; its `T: Copy` bound predates #112 and this pins that it is really enforced.
//
// #112 — the ADMIT/REFUSE pair for a grounded (b) survivor of the
// `*((&x) as *const T)` duplicate-owner class. The admit half is the
// `_copy_ctl` fixture in tests/logos/pass; this is the refuse half.

package rawdup_repeat_n_copy_enforced_fail;

use logos.std.fmt;
use logos.lang.option;
use logos.lang.iter;
use logos.mem.collections.vec;

struct Inner { pub n: i64, pub v: Vec<i64> }
impl Drop for Inner { fn drop(self: &mut Inner) { println!("DROP n={}", self.n); } }
fn mk(n: i64) -> Inner { let mut v: Vec<i64> = vec_new::<i64>(); v.push(n); return Inner { n: n, v: v }; }

fn main() -> i32 {
    let it: RepeatNIter<Inner> = iter_repeat_n::<Inner>(mk(3i64), 2i64);
    println!("count={}", it.count());
    return 0i32;
}
