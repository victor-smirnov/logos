// Regression for B-he-01: nested @{...} / @[...] inside other writ
// literals must parse.  We don't import stdlib here so WritStatic
// fails type resolution — but the test asserts that error appears, which
// implicitly confirms the parser reached sema.  Pre-fix the grammar would
// have emitted "syntax error near '}'" and never reached type lookup.
package writ_nested_at_literals_parse;

pub const A: WritStatic = @{ "k": @{} };
pub const B: WritStatic = @[@{}];
pub const C: WritStatic = @[@[1, 2]];
pub const D: WritStatic = @{ "k": @[1, 2] };

fn main() -> i32 { return 0; }
