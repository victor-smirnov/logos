// A container config with OPEN type parameters is a Writ TEMPLATE, not a
// configuration — and a container family's identity IS its config's content,
// so a template names no family. Projecting a handle out of one has to be
// rejected, by name, at the point the family would have been demanded.
//
// Before templates were recognised this hashed like any other document (over
// the parameter's own NAME) and the factory happily generated a family for the
// type `K`, which then died as `unknown type '<error>'` in the generated node
// code — a wrong artifact where a diagnostic belonged.
//
// The writable alternatives are in the message: instantiate the container
// (`typeof(Map::<u64, u64>)`), or bound the query on the source trait.
package test;

use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.sync;
use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.result;

pub container Map<K, V> for u8 {
    kind ordered_map;
    entry { key: K, val: V }
    measure max(key);
}

pub deem big_vals<K, V>(w: &<typeof(Map::<K, V>) as CtrFamily>::Handle) {
    from w e where e.val > 100 select (e.key, e.val)
}

fn main() -> i32 {
    return 0i32;
}
