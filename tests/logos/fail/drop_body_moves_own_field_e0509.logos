// E0509 — A `Drop::drop` BODY MAY NOT MOVE A FIELD OF `self` OUT.
// `@rule intrinsic.drop.move-out-of-drop-type-refused`.
//
// This is the FAIL half of a pair. The pass half,
// tests/logos/pass/drop_body_moves_own_field_e0509_ok, is this program ONE
// TOKEN apart — `let q: N = self.inner;` becomes `let q: i64 = self.inner.w;`,
// a Copy read of the same field — and it RUNS, asserting the destructor count.
//
// Was soundness_queue row `drop_body_moving_field_double_drops_local` (tier 1,
// run 1), closed 2026-09-08 by the owner's Rust-canonical drop decision. Before:
// the program compiled and the moved-out field was destroyed TWICE (count 2 for
// a single live value, want 1) — a double free with a green exit code on every
// oracle in the tree except this one. The fix is not "drop it once": under the
// canonical rule the program does not exist, because `Drop::drop` is guaranteed
// the whole value.
package drop_body_moves_own_field_e0509;
extern fn malloc(n: i64) -> *mut u8;

trait Drop { fn drop(self: Self); }
struct N { w: i64, c: *mut i64 }
impl Drop for N { fn drop(self: N) { unsafe { self.c[0] = self.c[0] + self.w; } } }

struct P2 { inner: N }
impl Drop for P2 { fn drop(self: P2) { let q: N = self.inner; } }

unsafe fn main() -> i32 {
    let c: *mut i64 = malloc(8) as *mut i64;
    c[0] = 0i64;
    { let p: P2 = P2 { inner: N { w: 7i64, c: c } }; }
    if c[0] != 7i64 { return 1i32; }
    return 0i32;
}
