// WQL RECURSIVE AGGREGATION (slice 1) — OUT-OF-SLICE diagnostic: a recursive
// aggregate rel supports exactly ONE aggregate (the single per-key lattice). A
// body carrying two aggregate heads (min AND max) is rejected with a named
// error — the slice-1 boundary, decidable from the query text alone.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

struct Node { pub id: i64 }
struct Edge { pub src: i64, pub dst: i64, pub w: i64 }

resource bad = wql!(src: &[Node], edges: &[Edge]) {
    rel dist(node: i64, lo: i64, hi: i64) {
        from src s select (s.id, 0, 0);
        from dist x join edges e on e.src == x.node
            group by e.dst
            aggregate lo = min(x.lo + e.w) , hi = max(x.hi + e.w)
            select (e.dst, lo, hi);
    }
    from dist r select (r.node, r.lo) order by r.node
};

fn main() -> i32 {
    let src: [Node; 1] = [ Node { id: 1i64 } ];
    let edges: [Edge; 1] = [ Edge { src: 1i64, dst: 2i64, w: 1i64 } ];
    let out: Vec<(i64, i64)> = bad(&src[..], &edges[..]);
    return out.len() as i32;
}
