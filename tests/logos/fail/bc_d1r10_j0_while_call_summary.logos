// D1 round 10 / J0 — a loan raised inside a `while` region BY A CALL SUMMARY.
// `merge_loans` used to carry a counter across the join only when the target
// was in `rehomed_slots_`/`rehomed_names_` (Door B's own population), so a
// summary-raised counter was DROPPED and `c.bump()` after the loop saw zero
// shared borrows. Measured over the whole stdlib: 99 rows reach that join,
// ALL 99 resident in the pre-region state — the region-local population the
// restriction protected is EMPTY (pop_scope/NLL retires it one layer up).
// The restriction separated PROVENANCE, not lifetime, and is deleted.
package bc_d1r10_j0_while_call_summary;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn stash(c: &C, v: &mut Vec<B>) { v.push(c.mk()); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut i: i64 = 0i64;
    while i < 1i64 {
        stash(&c, &mut vs);
        i = i + 1i64;
    }
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
