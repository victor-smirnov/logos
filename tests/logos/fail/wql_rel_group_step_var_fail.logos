// After `group by`, a grouping rel body reads `key`, its aggregate outputs and
// the base row var (the group's representative row) — a join step's row var is
// out of scope: the group holds many step rows and none is representative.
package test;
use logos.std.wql.wql;
use logos.mem.collections.vec;
struct Sale { pub region: str, pub amt: i64 }
struct Region { pub region: str, pub zone: str }
pub deem q(ss: &[Sale], regions: &[Region]) {
    rel pr(r: str, z: str, t: i64) {
        from ss s join regions g on g.region == s.region group by s.region aggregate t = sum(s.amt)
            select (key, g.zone, t);
    }
    from pr p select (p.r, p.t)
}
fn main() -> i32 { return 0i32; }
