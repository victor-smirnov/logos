// #100 HALF C CONTROL for the refuse half: a collision-free trait name. The
// refusal must be present here too — otherwise the sibling's refusal would be
// evidence about the homonym path rather than about method resolution.
package test;
trait ZqExactSizeUnique { fn len(&self) -> i64; }
struct ZqH { w: i64 }
impl ZqExactSizeUnique for ZqH { fn len(&self) -> i64 { return self.w + 7i64; } }
fn main() -> i32 { let h = ZqH{w:20i64}; if h.is_empty() { return 1; } return 0; }
