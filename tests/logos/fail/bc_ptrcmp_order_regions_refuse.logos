package bc_ptrcmp_order_regions_refuse;
extern fn printf(fmt: *const u8, ...) -> i32;
fn show(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
fn before<'a, 'b>(x: *mut &'a i64, y: *mut &'b i64) -> bool {
    return x < y;
}
fn main() -> i32 {
    show("n=%lld\n", 0i64);
    return 0i32;
}
