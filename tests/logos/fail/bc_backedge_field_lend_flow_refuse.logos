// DOOR 1, MEMBER 2 OF THE CLASS — the FIELD-PATH twin of
// imported/fail/borrowck/borrowck-lend-flow-loop. `r` holds a MUT FIELD loan on
// `s.a`, raised at the body's bottom, and the holder's last use `*r` sits at the
// TOP: the same Q < P window one level down, in the SECOND of the two copies of
// the retirement comparison that `release_dead_borrows` carries.
// ⚠ THIS SITE FIRED ZERO TIMES ACROSS THE WHOLE ACCEPTANCE POPULATION (probe
// `loanptF`, 0 arrivals over 1079 builds) and FOUR TIMES here. Without this
// fixture the field half of the class has no carrier at all and nothing would
// red if it were reverted — which is why it is a fixture and not a note.
package bc_backedge_field_lend_flow_refuse;
struct S { a: i64, b: i64 }
fn readit(v: &i64) -> i64 { return *v; }
fn main() -> i32 {
    let mut s: S = S { a: 0i64, b: 0i64 };
    let mut t: S = S { a: 0i64, b: 0i64 };
    let mut r: &mut i64 = &mut t.a;
    let mut i: i64 = 0i64;
    while i < 3i64 {
        *r = *r + 1i64;
        let _z: i64 = readit(&s.a);
        r = &mut s.a;
        i = i + 1i64;
    }
    return 0i32;
}
