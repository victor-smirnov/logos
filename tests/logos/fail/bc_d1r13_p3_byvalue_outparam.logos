// D1 round 13 / P3 — AN OUT-PARAM NEED NOT BE A `&mut`. `is_outparam` was set
// only for `is_mut_ref` params, so a BY-VALUE aggregate transitively holding a
// `&mut` never got the bit and its `to_outparam` row was skipped by every
// consumer — while `bc_holds_mut_ref_type` (round 10's predicate for exactly
// this question) sat 176 lines away, unconsulted. The mask pair is pinned in
// tests/logos/bc_flow_mask/p3_byvalue_outparam.logos; this is its verdict half,
// which only became visible once P2 landed.
package bc_d1r13_p3_byvalue_outparam;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct H { r: &mut Vec<B> }
fn stashv(h: H, c: &C) { h.r.push(c.mk()); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let h: H = H { r: &mut vs };
    stashv(h, &c);
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
