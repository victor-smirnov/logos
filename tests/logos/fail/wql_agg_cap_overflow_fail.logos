// More aggregates than a `group by` holds (8) is a PARSE ERROR naming the cap.
// The generated parser used to drop the 9th, which then failed as
// `undefined variable 'a9'` in the generated code (measured, 2026-10-04).
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct X { pub k: i64, pub v: i64 }

pub deem bad(xs: &[X]) {
    from xs x group by x.k
    aggregate a1 = count(), a2 = count(), a3 = count(), a4 = count(), a5 = count(),
              a6 = count(), a7 = count(), a8 = count(), a9 = sum(x.v)
    select (key, a9)
}

fn main() -> i32 { return 0i32; }
