// D1 round 10 / SP0 — a recorded aggregate COMPOSED INTO another aggregate.
// `note_alias`'s U2 gate asked whether the STORED VALUE is a `&mut`, so the
// struct-typed store `h.i = inn` was rejected and the edge `h -> inn` never
// existed. `inn.r -> v` WAS recorded, but the deposit lands on root `h` and
// each_root(h) = {h}, so the summary was lost WHOLE (LOGOS_DUMP_FLOWS printed
// no line at all for the callee, against the depth-1 twin's `out1<-0x1`).
// The gate now also admits an aggregate that transitively holds a `&mut` —
// which is a write path, i.e. exactly what an alias edge is consumed for.
// Census: the new arm admits 1230 stores across lang/mem/lcm/std (40 distinct
// places per package) and all four still compile, no verdict moves.
package bc_d1r10_sp0_aggregate_composed_in;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct Inner { r: &mut Vec<B> }
struct Mid { i: Inner }
struct Outer { m: Mid }
fn stash2(c: &C, v: &mut Vec<B>) {
    let inn: Inner = Inner { r: v };
    let mut h: Mid = Mid { i: Inner { r: v } };
    h.i = inn;
    h.i.r.push(c.mk());
}
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    stash2(&c, &mut vs);
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
