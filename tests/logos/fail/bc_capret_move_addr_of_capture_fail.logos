// §CAPRET pair B, FAIL half. ONE TOKEN from pass/bc_capret_move_capture_value_pass:
// `&t` for `r`, under a `move` closure.
//
// ⚠ THIS FILE IS THE ABUSE DIRECTION OF THE PAIR AND ITS MESSAGE IS DELIBERATELY
// UNCHANGED. 2026-09-09j-capret deposits `move` capture names into
// `closure_capture_names_` so the pass half stops being over-refused; the risk
// of that deposit is that it also exempts the ADDRESS of a moved capture, which
// really does dangle on the closure's own environment. It does not: the verdict
// and the sentence here are identical before and after (measured on the control
// revert), which is the only way to see that the deposit did not open a hole.
package bc_capret_move_addr_of_capture_fail;
fn f() -> i64 {
    let t: i64 = 9i64;
    let c = move || -> &i64 { return &t; };
    let v: &i64 = c();
    return *v;
}
fn main() -> i32 { return f() as i32; }
