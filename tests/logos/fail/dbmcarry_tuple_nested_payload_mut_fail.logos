// A `mut` BINDING MODIFIER UNDER A BY-REFERENCE DEFAULT BINDING MODE IS AN ERROR
// (Rust 2024, owner decision 2026-09-05; spec pat.binding.modifier-requires-move-mode).
// Was soundness-queue row match_ergo_nested_tuple_mut_admit (tier 2, `admits`):
// the TUPLE door handed its sub-pattern the BARE element type, so the payload
// door saw no reference, never asked `modifier_under_ref_scrutinee`, and the
// program compiled and ran.
// PAIR: pass/dbmcarry_tuple_nested_payload_drop_once, one token apart (`mut a` -> `a`).
package dbmcarry_tuple_nested_payload_mut_fail;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut r: i64 = 0i64;
    {
        let t: (Option<D>, i64) = (Option::Some(D { v: 1i64, c: p }), 9i64);
        match &t {
            (Option::Some(mut a), b) => { r = a.v + *b; },
            (Option::None, _) => {}
        }
    }
    if r != 10i64 { return 2i32; }
    unsafe { printf("%ld\n".as_ptr(), n); }
    return 0i32;
}
