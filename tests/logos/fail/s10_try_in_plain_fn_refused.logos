// ADR 0030 S10 row 2: `?` in a fn returning `i32` — no FromResidual impl takes the residual (rustc E0277).
package s10_try_in_plain_fn_refused;
struct E1 { c: i32 }
fn f(x: i32) -> Result<i32, E1> { if x > 0 { return Ok(x); } return Err(E1 { c: 4 }); }
fn h(x: i32) -> i32 { let v = f(x)?; return v; }
fn main() -> i32 { return 0; }
