// TWIN for bc_d1r13_p1_tuple_source / bc_d1r13_p1_array_source: the same
// program with a STRUCT holder. It refused throughout — the holder KIND was the
// only variable, which is what made the two leaks parity gaps rather than policy.
package bc_d1r13_p1_struct_twin;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct H { r: &mut Vec<B> }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut h: H = H { r: &mut vs };
    let s: &mut Vec<B> = h.r;
    s.push(c.mk());
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
