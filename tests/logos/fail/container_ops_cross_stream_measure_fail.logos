// BTFL 8b — a measure-bound op argument binds to a measure of the SAME
// stream (Canon decl-time verdict): keys' `select(count)` referencing the
// count measure declared by the VALUES stream fails the compile with
// Canon's op_measure_ref reason.
package test;

use logos.lcm.canon.container_item;

pub container CrossRef<K, V> {
    kind multimap;
    stream keys {
        entry { key: K }
        measure max(key);
        ops { seek(max(key)); select(count); }
    }
    stream values {
        entry { val: V }
        measure count;
        ops { select(count); }
    }
}

fn main() -> i32 {
    return 0i32;
}
