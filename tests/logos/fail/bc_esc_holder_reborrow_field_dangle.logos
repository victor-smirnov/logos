// #86 MISS-A — THE ESCAPE FACT LANDED ON THE NAME BEING WRITTEN THROUGH.
//
// Runtime-confirmed use-after-free (the returned `str` stops comparing equal
// after intervening String allocations). MEASURED rc 0 at the #86 landing.
//
// This is NOT the "no hook at all" hole #86 SITE b closed: the DerefWrite door
// DID fire here — `[#86trace-derefwrite] fn=fn bad var=r loc=1` — and deposited
// the escape on `r`, the `&mut` REBORROW LOCAL. `r` is not the storage: `w` is.
// The two controls that named it, both run on the same tree:
//   `w.v = o.as_str()` written directly  → rc 1 (refused)
//   `return r.v` instead of `return w.v` → rc 1 (so the record LANDED, on the
//                                                wrong name)
// The re-home is the one the loan channel has done since D1 round 5 / H1
// (`rehome_reborrow` + `ref_place_root`); the escape channel simply never
// asked for it.
//
// THE ONE VARIABLE against pass/bc_esc_holder_reborrow_field_admit: where the
// stored borrow comes from — a fn-LOCAL `String` here, a PARAMETER there.
// Same struct, same reborrow local, same `return w.v`.
package bc_esc_holder_reborrow_field_dangle;
use logos.mem.string;

pub struct W { pub v: str }

pub fn bad() -> str {
    let o: String = String::from("hello");
    let mut w: W = W { v: "" };
    let r: &mut W = &mut w;
    r.v = o.as_str();
    return w.v;
}

fn main() -> i32 {
    if bad().len() == 5i64 { return 0i32; }
    return 1i32;
}
