// #100 HALF A ABUSE CONTROL. The same unsatisfied bound over a trait name that
// collides with nothing: the refusal must be present here TOO, so the sibling's
// refusal is not being produced by the homonym machinery.
package test;
trait ZqBorrowUnique { fn zqtag(&self) -> i64; }
struct ZqH { w: i64 }
struct ZqNo { w: i64 }
impl ZqBorrowUnique for ZqH { fn zqtag(&self) -> i64 { return self.w + 7i64; } }
fn viag<T2: ZqBorrowUnique>(x: &T2) -> i64 { return x.zqtag(); }
fn main() -> i32 { let n = ZqNo{w:20i64}; return viag(&n) as i32; }
