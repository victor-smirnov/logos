// A trait renamed by `use … as` cannot name a trait object yet: a trait object is keyed by its
// trait's name downstream, so the rename is refused at the `dyn` instead of resolving to a homonym.
// (Rust admits it; the trait-object identity step lifts this.)
package use_as_renamed_trait_in_dyn_refused;
use logos.mem.collections.vec;
use logos.mem.bt.map;
use logos.mem.version.vocab;
use logos.mem.bt.map.Snapshot as Snapshot;
use logos.mem.version.vocab.Snapshot as VSnapshot;

struct Y { v: u64 }
impl VSnapshot for Y {
    fn version(self: &Self) -> u64 { return self.v; }
    fn parents(self: &Self) -> Vec<u64> { return Vec::new(); }
}
fn ver<T: VSnapshot>(t: &T) -> u64 { return t.version(); }
fn take2(m: &dyn VSnapshot) -> u64 { return m.version(); }
fn take(m: &dyn Snapshot) -> u64 { return m.snapshot_id(); }

fn main() -> i32 {
    let y: Y = Y { v: 7u64 };
    return (ver(&y) + y.version()) as i32 - 14i32;
}
