// B62: an impl that pins its trait-arg to a concrete lifetime ('static)
// must NOT satisfy a bound that demands a universally-quantified lifetime
// (HRTB / `for<'a>`-style). Rust rejects; Logos must reject.
package hrtb_concrete_impl_universal_bound;

trait Trait<T> { fn run(self: Self, x: T) -> i32; }

struct OnlyStatic { _x: i32 }
impl Trait<&'static i64> for OnlyStatic {
    fn run(self: OnlyStatic, x: &'static i64) -> i32 { return (*x) as i32; }
}

fn use_universal<F>(f: F, v: &i64) -> i32
    where F: for<'a> Trait<&'a i64>
{
    return f.run(v);
}

fn main() -> i32 {
    let local: i64 = 7i64;
    // OnlyStatic only impls Trait<&'static i64>, not for<'a> Trait<&'a i64>.
    let r = use_universal::<OnlyStatic>(OnlyStatic{ _x: 0i32 }, &local);
    return r - 7i32;
}
