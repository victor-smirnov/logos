// audit-v2 T1-10 (B78): partial-move tracking at FULL dotted-path
// granularity. Pre-fix only depth-1 (`o.f`) registered — a depth-2 move
// (`o.i.s`) was invisible: re-reading the moved leaf, using the parent
// (`o.i`), or the whole root all compiled. Pointer-mediated chains
// (`(*p).field`, e.g. Rc::drop_rc's self.inner.val) stay untracked —
// ownership doesn't flow through raw pointers.
package partial_move_depth2;

struct Inner { s: String, t: String }
struct Outer { i: Inner }

fn consume(s: String) -> i64 { s.len() }

fn main() -> i32 {
    let o = Outer { i: Inner { s: String::from("a"), t: String::from("bb") } };
    let n = consume(o.i.s);
    let again = o.i.s;
    (n + again.len()) as i32
}
