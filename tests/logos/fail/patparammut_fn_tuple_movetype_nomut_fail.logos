// ONE TOKEN from patparammut_fn_tuple_movetype (the `mut` on `a` is gone): a
// move-typed element binder is no more mutable than a scalar one, and writing
// through its FIELD is the same refusal.
package patparammut_fn_tuple_movetype_nomut_fail;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
trait Drop { fn drop(self: Self); }
struct D { v: i64 }
impl Drop for D { fn drop(self: D) { printi("d%d ", self.v as i32); } }
fn probe((a, b): (D, D)) -> i64 {
    a.v = a.v + 1i64;
    return a.v + b.v;
}
fn main() -> i32 {
    let t: (D, D) = (D { v: 3i64 }, D { v: 4i64 });
    if probe(t) != 8i64 { return 1i32; }
    return 0i32;
}
