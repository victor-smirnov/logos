// `T::WIDTH` where T is a TYPE PARAMETER has no value until T is bound, so it
// cannot be resolved in sema. It must be REFUSED with a clear message rather
// than silently yielding a zero-length array — that silent zero is the whole
// reason this area was overhauled. Mono-time resolution is a separate step.
package array_len_assoc_const_typaram;

trait HasWidth { const WIDTH: usize; }

fn make<T: HasWidth>() -> [u64; T::WIDTH] {
    return [0u64; 1];
}

fn main() -> i32 { return 0i32; }
