package mut_borrow_blocks_move;
// Phase 2: cannot move while borrowed
trait Drop { fn drop(self: Self); }
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
struct Buf { data: i32, }
impl Drop for Buf { fn drop(self: Buf) { printi("%d\n", self.data); } }
fn consume(b: Buf) -> i32 { return b.data; }
fn main() -> i32 {
    let mut b = Buf { data: 7 };
    let r: &mut Buf = &mut b;
    let n: i32 = consume(b);   // error: cannot move while borrowed
    (*r).data = 0i32;
    return n;
}
