// D1 round 11 / X0 — the LAST join family: the loop-EXIT state collectors.
// `frame2.break_states` / `frame2.continue_states` received loop_propagate_moves
// and never merge_loans, so a loan raised on a path that leaves the body via
// `break` was dropped at the loop's end. The drop is DOUBLE here on purpose:
// the exit sits in a nested `if`, so the if-join is skipped on the diverging
// arm (nothing crosses there either) and the exit collector was the only route
// left. A `break` at the body's TOP LEVEL is NOT a witness — post-body
// `states_` still carries the loan and the pre-existing
// merge_loans(states_, post2_s) crosses it.
package bc_d1r11_x0_nested_if_break;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn stash(c: &C, v: &mut Vec<B>) { v.push(c.mk()); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut i: i64 = 0i64;
    while i < 3i64 {
        if i > 0i64 {
            stash(&c, &mut vs);
            break;
        }
        i = i + 1i64;
    }
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
