// THE BY-VALUE `self` HALF of the same rule (E0382). `method_self_kind` returns
// 0 for a by-value `self` AND for "unresolved" AND for "ambiguous" AND for "no
// params" — four facts under one number — so the receiver check deliberately
// does not branch on the self kind at all: a call uses the whole receiver
// whichever way `self` is spelled, and asking at every spelling is what kept
// the measured cost at zero.
package bc_recvpartial_byval_recv_fail;

struct P { s: str, x: i64 }
impl Drop for P { fn drop(self: &mut P) {} }
struct L { origin: P, middle: P }
impl L { fn consume(self: L) {} }

fn main() -> i32 {
    let l = L { origin: P{s:"a", x:1i64}, middle: P{s:"b", x:2i64} };
    let _a = l.origin;
    l.consume();
    return 0i32;
}
