// PAIR HALF (fail) — the selector was widened to admit the wrapper unsize, NOT
// to stop checking. ONE TOKEN apart from
// tests/logos/pass/method_arg_wrapper_unsize_dispatch.logos: `h.eat(5i64)` here,
// `h.eat(rc)` there. An `i64` reaches `Rc<dyn Sp>` by no coercion the pipeline
// has, so there is no candidate and the call is refused.
// THE SENTENCE WAS COARSE AND IS NOT ANY MORE. This fixture used to pin
// "method call: 'Holder' has no method 'eat'" — false, since `Holder` DOES have
// `eat` — and its header cited "soundness-queue row
// method_arg_mismatch_reported_as_no_method". THAT ROW NEVER EXISTED: 0 hits in
// soundness_queue.ledger, 0 programs on the shelf, and no commit in the history
// ever added it (measured 2026-09-10). Pinning the sentence here is what made
// changing it visible, which is exactly what happened: the ARGUMENT member of
// the class is now reported as an argument mismatch. See spec clause
// `expr.method.candidate-rejection-reason`.
package method_arg_wrapper_unsize_dispatch;
use logos.lang.rc;

trait Sp { fn v(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }

struct Holder { n: i64 }
impl Holder { pub fn eat(&self, r: Rc<dyn Sp>) -> i64 { return r.v() + self.n; } }

fn main() -> i64 {
    let h: Holder = Holder { n: 1i64 };
    let rc: Rc<A> = rc_new(A { x: 17i64 });
    if h.eat(5i64) != 18i64 { return 1i64; }
    return 7i64;
}
