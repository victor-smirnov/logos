// Parser fail: top-level 'let' statement is not valid syntax.
// The parser stops at 'let', so 'fn main' after it is never parsed.
// Verifies that logosc reports the stray token instead of silently emitting
// an empty (or broken) object file.
package stray_token;

fn helper() -> i32 {
    return 7;
}

let bad: i32 = 42;

fn main() -> i32 {
    return helper();
}
