// ADR 0030 S3 (C-PAT) battery catch: logosc ACCEPTED this non-exhaustive / refutable shape and the missing
// value fell through (undefined value, SIGSEGV or the code after); rustc refuses it (E0004).
// exhaustiveness oracle battery (ADR 0030 S3): &[i64] {[1,..],[]} non-1 head missing (value [5])
package exh_slice_literal_nonexh;
fn f(v: &[i64]) -> i64 { match v { [1i64, ..] => 1i64, [] => 0i64 } }
fn run() -> i32 { let a: [i64; 1] = [5i64]; return f(&a) as i32; }

fn main() -> i32 { return run(); }
