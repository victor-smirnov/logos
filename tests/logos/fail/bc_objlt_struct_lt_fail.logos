// A struct carrying a lifetime, `W<'a>`, boxed into `Box<dyn Tr>` ('static). The legal twin, one token apart (`Box<dyn Tr>` -> `Box<dyn Tr + 'a>`), is bc_objlt_struct_lt.
package bc_objlt_struct_lt_fail;
trait Tr { fn m(self: &Self) -> i64; }
struct W<'a> { r: &'a i64 }
impl<'a> Tr for W<'a> { fn m(self: &Self) -> i64 { return *self.r; } }
fn f<'a>(w: W<'a>) -> Box<dyn Tr> {
    return Box::new(w);
}
fn main() -> i32 { return 0i32; }
