// D1 round 3 / F0 — the RETURN channel's by-value hop across a free Call.
// prov_of's Code::Call arm merged provenance only from `is_plain_ref_kind`
// arguments, so a by-VALUE borrow-carrying argument contributed NOTHING and
// `return idb(b)` escaped while the DIRECT spelling `return b;` refused and
// both wrapper twins (Option::Some(b), Wrap{b:..}) refused — the LOAN channel
// had taken by-value bc args since round 1, so the two channels disagreed at
// the same expression kind and the loan channel was right. `Box::new` is such
// a Call. Closed by consulting the callee's BORROW-FLOW SUMMARY (idb
// summarises as result<-{b}); with no summary the plain-ref rule is kept AND
// by-value bc args are added, which is the loan channel's rule.
// ADMIT TWIN: pass/bc_d1r3_f0_param_root_admits — same hop, borrow rooted at
// a &-PARAM, which must stay admitted.
package bc_d1r3_f0_call_byval_return;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
}
fn idb(b: B) -> B { return b; }
fn leak() -> B { let c: C = C { v: 1i64 }; let b: B = c.mk(); return idb(b); }
fn main() -> i64 { let b: B = leak(); return *b.p; }
