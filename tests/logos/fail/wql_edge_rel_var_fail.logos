// wql! diagnostic (slice D): traversal FROM a rel-bound row var is
// meaningless — rel rows are native tuples (no collection fields). Named
// error instead of a broken emitted chunk.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct Node { pub id: i64, pub kids: Vec<i64> }

pub deem bad(nodes: &[Node]) {
    rel ids(x: i64) {
        from nodes n select n.id;
    }
    from ids r
    join r.kids k
    select k }

fn main() -> i32 { return 0i32; }
