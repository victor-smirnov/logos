// A CALL IN A `break` VALUE STILL DEPOSITS THROUGH ITS OUT-PARAMETERS.
//
// The FlowSummarizer's Break arm tainted from the value and stopped — every
// other arm that does `add_taint(dst, taint_of(v))` also runs `call_effects(v)`,
// because a call in that value can deposit through a `&mut` OUT-PARAMETER and
// the taint of the RESULT says nothing about what the call did to its arguments.
// `break <call>` did the first and not the second, on every path.
// ONE-PROPERTY TWIN: the same file with `let n: i64 = stash(h, c);` in place of
// the loop — refused all along, which is what made this visible as a divergence.
// Here `stash` pushes `c.mk()` into `h.r`, so mutating `c` afterwards leaves a
// live reference into it inside the vector, and the return reads it.
package bc_break_outparam_deposit;
#[borrow_carrying]
struct B<'a> { p: &'a i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct H<'a, 'b> { r: &'a mut Vec<B<'b>> }
fn stash<'a, 'b>(h: &mut H<'a, 'b>, c: &'b C) -> i64 { h.r.push(c.mk()); return 0i64; }
fn wrap<'a, 'b>(h: &mut H<'a, 'b>, c: &'b C) -> i64 { let n: i64 = loop { break stash(h, c); }; return n; }
fn main() -> i32 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut h: H = H { r: &mut vs };
    wrap(&mut h, &c);
    c.bump();
    return *vs.get(0i64).p as i32;
}
