// A method's `where 'a: 'static` — the method call site asks it too.
// TWIN of pass/bc_staticdemand_method_bound_admit, one token apart. src/compiler/PROBES.md 2026-09-13d-staticdemand.
package bc_staticdemand_method_bound_refuse;
struct K { b: i64 }
impl K {
    fn keep<'a>(self: &Self, t: &'a i64) -> i64 where 'a: 'static { return *t + self.b; }
}
fn g(k: &K, u: &i64) -> i64 {
    return k.keep(u);
}
fn main() -> i32 { let n: i64 = 4i64; let k = K { b: 1i64 }; return g(&k, &n) as i32; }
