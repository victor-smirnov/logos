// TWIN for bc_d1r13_p2_outparam_deposit: the direct-param spelling
// (`stash(&mut vs, &c)`), which refused before the fix with the SAME summary
// mask. It is the control that proves the loss was not in the summarizer.
package bc_d1r13_p2_directparam_twin;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct H { r: &mut Vec<B> }
fn stashd(v: &mut Vec<B>, c: &C) { v.push(c.mk()); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    stashd(&mut vs, &c);
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
