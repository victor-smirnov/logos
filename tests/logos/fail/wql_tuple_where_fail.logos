// wql! diagnostic: a tuple expression is ONLY a `select` projection form —
// a tuple-rooted `where` predicate is rejected with a named clause diagnostic.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct P { pub a: i64, pub b: i64 }

resource bad = wql!(ps: &[P]) { from ps p where (p.a, p.b) select p.a };

fn main() -> i32 { return 0i32; }
