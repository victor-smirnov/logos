// E0207. The trait argument is `W<'a>` — a lifetime NESTED one level down, not a
// bare lifetime at the argument slot. `'a` is constrained through it; `'b` is not.
// PASS TWIN: tests/logos/pass/bc_e0207_nested_trait_arg_constrains.logos, one token
// (`W<'a>` -> `W<'b>`). A rule that only reads LIFETIME_PARAM items directly under
// the trait's argument list refuses the legal twin.
package bc_e0207_nested_trait_arg_other_binder;
struct S { n: i64 }
struct W<'a> { r: &'a i64 }
trait Tr2<A> { type Item; fn go(self: Self) -> i64; }
impl<'a, 'b> Tr2<W<'a>> for S {
    type Item = &'b i64;
    fn go(self: Self) -> i64 { return 3i64; }
}
fn main() -> i32 { return 0i32; }
