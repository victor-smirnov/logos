// logos-core §1.4: Kind::FnItem distinct from Kind::FnPtr. Two different
// fns with IDENTICAL FnPtr signatures get DISTINCT FnItem TypeUIDs at
// the bare-name reference site (`add1` vs `sub1` both type as
// `FnItem<...>` with the symbol-name carried in struct_name for
// identity). Assigning one to a place of the other's type is Rust
// E0308: "expected fn item, found a different fn item". Pre-fix Logos
// collapsed bare `add1` and bare `sub1` into the same `fn(i32) -> i32`
// FnPtr. (Was an array literal `[add1, sub1]`; rustc 1.98.1 ACCEPTS
// that — a literal's elements meet at their LUB, the fn pointer — and
// so does Logos since ADR 0030 S4.4c: pass/lub_array_elems.)
package core_1_4_fnitem_distinct_arms;

fn add1(x: i32) -> i32 { return x + 1i32; }
fn sub1(x: i32) -> i32 { return x - 1i32; }

fn main() -> i32 {
    // `f` has `add1`'s fn-item type; `sub1`'s is another (rustc E0308).
    let mut f = add1;
    f = sub1;
    let _ = f;
    return 0i32;
}
