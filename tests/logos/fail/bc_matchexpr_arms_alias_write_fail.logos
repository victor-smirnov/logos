// THE ABUSE DIRECTION of the per-arm baseline in the MatchExpr arm: joining
// the arms must not lose the loan. `w` still holds a `&mut a` whichever arm
// ran, so writing `a` while `w` is live is refused exactly as before.
package bc_matchexpr_arms_alias_write_fail;
fn total(x: &mut [i64]) -> i64 { return x[0i64]; }
fn main() -> i32 {
    let mut a: [i64; 3] = [1i64, 2i64, 3i64];
    let w: &mut [i64] = match true { true => &mut a, false => &mut a };
    a[0i64] = 9i64;
    if total(w) != 9i64 { return 1i32; }
    return 0i32;
}
