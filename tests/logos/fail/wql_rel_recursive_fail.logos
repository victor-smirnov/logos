// WQL REL BLOCKS — recursion diagnostic (slice B): a rel body referencing the
// rel ITSELF (or any not-yet-declared rel — forward/mutual reference) is the
// named "recursive rel" error. The fixpoint lands in the next slice; slice B
// enforces declaration-order scoping.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

struct Edge { pub src: i64, pub dst: i64 }

resource reach = wql!(edges: &[Edge]) {
    rel step(a: i64, b: i64) {
        from edges e select (e.src, e.dst);
        from edges e join step s on e.dst == s.a select (e.src, s.b);
    }
    from step s select s.b
};

fn main() -> i32 {
    let edges: [Edge; 1] = [ Edge { src: 1i64, dst: 2i64 } ];
    let out: Vec<i64> = reach(&edges[..]);
    return out.len() as i32;
}
