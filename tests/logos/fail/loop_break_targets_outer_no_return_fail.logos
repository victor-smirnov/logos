// RETURN REACHABILITY, the widest consumer of the same lie. `f`'s last statement
// is a `loop` whose `break` targets IT, so control leaves the loop and falls off
// the end of `f` with no value. TWIN: pass/loop_break_targets_inner_admit.logos,
// where the break targets a nested `while` and the `loop` genuinely diverges —
// which is bt_upper_bound's shape (stdlib/lcm/deem/data/bt/descent.logos) and
// the reason a presence-of-token walk cannot be the predicate.
package loop_div_d;
fn f(n: i32) -> i32 {
    let mut i: i32 = 0i32;
    loop {
        if i == 3i32 { break; }
        i = i + 1i32;
        if i > n { return i; }
    }
}
fn main() -> i32 { return f(9i32); }
