// THE REFUSE TWIN of `pass/bc_dropck_shadowed_name_admit`. A `Drop`-carrying
// lifetime-parameterised binding whose borrow source really does die first must
// still be refused — the 2026-08-25 slot-keying fix narrows WHICH binding the
// rule is about, and must not turn the rule off.
//
// If this ever admits, the dropck check has been bought away rather than
// sharpened.
package bc_dropck_source_dies_first_fail;
use logos.lang.drop;

// ⚠ THE STDLIB LANG ITEM, NOT A LOCAL `trait Drop`. The rule this pair is
// about — B87 dropck — is ABOUT the `Drop` lang item, and a locally declared
// `trait Drop` is an ordinary trait that implements nothing (rustc: `Drop` is
// selected by `#[lang = "drop"]`, never by spelling). While borrow_check's
// drop set was keyed on the SYMBOL SPELLING `__drop` the distinction was
// invisible; it no longer is, so the pair states its own subject.
struct H<'a> { r: &'a i64 }
impl<'a> Drop for H<'a> { fn drop(self: &mut H<'a>) { } }

fn main() -> i32 {
    let g: H;
    { let short: i64 = 2i64; g = H { r: &short }; }
    return 0i32;
}
