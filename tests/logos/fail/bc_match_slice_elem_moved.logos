package bc_match_slice_elem_moved;
struct W {}
impl Drop for W { fn drop(self: &mut W) {} }
fn main() -> i32 {
    let a: [W; 1] = [W {}];
    let s = &a[..];
    match s[0] { w => { return 0i32; } }
