// Without `'b: 'a` the covariant field `r: &'b` does not outlive the binder pinned by the
// invariant field (rustc 1.98.1: lifetime may not live long enough).
package struct_lit_invariant_binder_covariant_short_refused;
struct C<'a> { r: &'a i64, m: &'a mut &'a i64 }
fn mk<'a, 'b>(m: &'a mut &'a i64, r: &'b i64) -> C<'a> {
    return C { r: r, m: m };
}
fn main() -> i32 { return 0; }
