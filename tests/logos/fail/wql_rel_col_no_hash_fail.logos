// ADR 0031 R4.1 — a rel column type must be Eq + Hash; the refusal names both.
package test;
use logos.std.wql.wql;
use logos.mem.collections.vec;
struct NoHash { pub a: i64 }
struct Row { pub k: NoHash, pub n: i64 }
pub deem q(rs: &[Row]) {
    rel r2(k: NoHash, n: i64) { from rs r select (r.k, r.n); }
    from r2 x select x.n
}
fn main() -> i32 { return 0i32; }
