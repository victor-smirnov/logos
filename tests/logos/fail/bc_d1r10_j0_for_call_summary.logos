// D1 round 10 / J0, second region form — the `for` loop. Same join, same
// summary-raised counter; kept beside the `while` witness because the two
// reach `visit_loop_body` by different statement kinds.
package bc_d1r10_j0_for_call_summary;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn stash(c: &C, v: &mut Vec<B>) { v.push(c.mk()); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    for i in 0i64..1i64 {
        stash(&c, &mut vs);
    }
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
