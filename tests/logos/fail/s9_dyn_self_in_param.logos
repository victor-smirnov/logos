// ADR 0030 S9 row 8: dyn compatibility as Rust's (E0038); rustc 1.98.1 refuses the Rust twin with the same error.
package s9_dyn_self_in_param;
trait T { fn eq2(&self, o: &Self) -> bool; }
struct S { v: i32 }
impl T for S { fn eq2(&self, o: &S) -> bool { self.v == o.v } }
fn main() -> i32 { let s = S { v: 5 }; let d: &dyn T = &s; 0 }
