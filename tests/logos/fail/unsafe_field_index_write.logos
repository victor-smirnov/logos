package unsafe_field_index_write;
// Bug 3: writing through raw pointer field via indexing requires unsafe context

extern fn malloc(n: i64) -> *mut u8;
fn alloc(size: i64) -> *mut u8 { unsafe { return malloc(size); } }

struct Buf { ptr: *mut i32, }

fn main() -> i32 {
    let p: *mut i32 = alloc(4) as *mut i32;
    let b = Buf { ptr: p };
    b.ptr[0] = 77;  // error: field index write through raw pointer requires unsafe context
    return 0;
}
