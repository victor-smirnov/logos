// ADR 0030 S9 row 8: dyn compatibility as Rust's (E0038); rustc 1.98.1 refuses the Rust twin with the same error.
package s9_dyn_supertrait_generic_method;
trait U { fn h<X>(&self, x: X) -> i32; }
trait T: U { fn f(&self) -> i32; }
struct S { v: i32 }
impl U for S { fn h<X>(&self, x: X) -> i32 { 1 } }
impl T for S { fn f(&self) -> i32 { self.v } }
fn main() -> i32 { let s = S { v: 5 }; let d: &dyn T = &s; d.f() }
