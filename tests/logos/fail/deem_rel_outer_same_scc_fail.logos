// An outer join through recursion is refused like an anti join: its absent
// side is a negation, and negation through recursion has no stratified
// semantics.
package test;
use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.result;
use logos.std.fmt;
struct Emp { pub id: i64, pub dept: i64 }
pub deem bad(es: &[Emp]) {
    rel p(n: i64, m: Option<i64>) {
        from es e left join p q on q.n == e.dept select (e.id, q.n);
    }
    from p x select x.n
}
fn main() -> i32 { return 0i32; }
