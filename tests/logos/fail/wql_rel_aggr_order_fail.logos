// An aggregating rel body is a rel body: its rows are a SET, so `order by`
// (like `limit`, `select first`, `distinct` and a result type) is refused there.
// Before ADR 0031 R2 the walker asked this of the simple and join body shapes
// only, and an aggregating body's `order by` compiled and was silently dropped;
// the check now reads the core, where every body has one envelope.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct Node { pub id: i64 }
struct Edge { pub src: i64, pub dst: i64, pub w: i64 }

pub deem sssp(src: &[Node], edges: &[Edge]) {
    rel dist(node: i64, d: i64) {
        from src s select (s.id, 0);
        from dist x join edges e on e.src == x.node
            group by e.dst
            aggregate d = min(x.d + e.w)
            select (e.dst, d)
            order by d;
    }
    from dist r select (r.node, r.d)
}

fn main() -> i32 { return 0i32; }
