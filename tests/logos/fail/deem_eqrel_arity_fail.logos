// An `eqrel` is a binary relation over one domain (Soufflé's `eqrel`): three
// columns are a named error at the declaration.
package test;
use logos.std.wql.wql;
use logos.mem.collections.vec;
struct R { pub a: i64, pub b: i64 }
pub deem q(rs: &[R]) {
    rel w(a: i64, b: i64, c: i64) eqrel { from rs r select (r.a, r.b, r.a); }
    from w x select x.a
}
fn main() -> i32 { return 0i32; }
