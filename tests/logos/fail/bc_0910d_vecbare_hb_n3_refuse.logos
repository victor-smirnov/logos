pub struct Vec<T> { a: i64, b: i64 }

fn total(s: &[i64]) -> i64 {
    let mut t: i64 = 0i64;
    for x in s { t = t + *x; }
    return t;
}

fn main() -> i32 {
    let mut v: Vec<i64> = Vec { a: 7i64, b: 3i64 };
    let n: i64 = total(&mut v);
    if n != 0i64 { return 1i32; }
    return 0i32;
}
