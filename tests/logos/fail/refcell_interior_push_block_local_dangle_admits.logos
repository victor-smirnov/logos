// Refused as rustc 1.98.1 refuses it (squeue row of the same name).
package refcell_interior_push_block_local_dangle_admits;
use logos.lang.cell;
struct H<'a, 'b> { c: &'a RefCell<Vec<&'b i64>> }
impl<'a, 'b> H<'a, 'b> {
    fn set(self: &mut H<'a, 'b>, c: &'a RefCell<Vec<&'b i64>>) { self.c = c; }
}
unsafe fn main() -> i32 {
    let g: RefCell<Vec<&i64>> = RefCell::<Vec<&i64>>::new(Vec::<&i64>::new());
    let cell: RefCell<Vec<&i64>> = RefCell::<Vec<&i64>>::new(Vec::<&i64>::new());
    let mut h: H = H { c: &g };
    h.set(&cell);
    {
        let d: i64 = 2i64;
        let mut gd = h.c.borrow_mut();
        gd.get_mut().push(&d);
    }
    let n: i64 = cell.borrow().get().len() as i64;
    return n as i32;
}
