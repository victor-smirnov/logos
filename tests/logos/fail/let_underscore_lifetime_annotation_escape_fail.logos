// Twin of pass/let_underscore_lifetime_annotation_admit: through `H<'_, '_>` the store of `y`
// into `out` still needs `y: 'a` (rustc E0621).
package let_underscore_lifetime_annotation_escape_fail;
struct H<'p, 'q> { r: &'p mut &'q i64 }
fn f<'a>(x: &'a i64, y: &i64) -> &'a i64 {
  let mut out: &i64 = x;
  { let h: H<'_, '_> = H { r: &mut out }; *h.r = y; }
  return out;
}
fn main() -> i32 { return 0i32; }
