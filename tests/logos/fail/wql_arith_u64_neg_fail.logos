// WQL — UNARY `-` OVER AN UNSIGNED VALUE IS REFUSED, AS RUST REFUSES IT.
//
// An arithmetic node has its operand's type (Rust typing, 2026-10-02), so `-s.u`
// over a `u64` column would be a `u64`, and every non-zero u64 has no negative
// image in the type. There is no `el_negu` and there will not be one; reaching the
// signed tower's `el_neg` would mean reading the column as i64, a silent choice of
// signedness. The same refusal covers every unsigned width, not only the u64
// tower's: wql_arith_unsigned_neg_fail is the `u32` twin.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct Rec { pub id: i64, pub u: u64 }

pub deem negd(src: &[Rec]) { from src s select -s.u }

fn main() -> i32 { return 0i32; }
