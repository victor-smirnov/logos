// A ref bound through an if-expression must borrow all EAddrOf sources.
// Trying to take a mutable borrow on either source must fail.
package cond_ref_borrow;

fn test(tag: i32) -> i32 {
    let mut x: i32 = 10;
    let mut y: i32 = 20;
    // r conditionally borrows x or y — both must be marked borrowed.
    let r: &mut i32 = if tag > 0 { &mut x; } else { &mut y; };
    // x is mutably borrowed through r — cannot use it directly.
    let z: i32 = x;  // error: cannot use 'x' while it is mutably borrowed
    *r = 99i32;
    return z;
}

fn main() -> i32 {
    return test(1);
}
