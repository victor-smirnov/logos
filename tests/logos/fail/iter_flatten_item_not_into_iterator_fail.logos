// `flatten()` over items that are not IntoIterator is refused (rustc E0277: `i32` is not an
// iterator), at the call.
package iter_flatten_item_not_into_iterator_fail;
use logos.std.fmt;
use logos.mem.collections.vec;
fn main() {
    let v: Vec<i32> = vec![1, 2];
    let c: Vec<i32> = v.into_iter().flatten().collect();
    println!("{:?}", c);
}
