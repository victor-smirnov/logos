// D1 round 10 / J0 — the if EXPRESSION join merged moves but not loans. The
// arm matters: post-join `states_` is the ELSE value's, so only a loan raised
// in the THEN arm reaches the merge. Control-reverted: without the added
// merge_loans this file compiles (rc=0) while the else-arm spelling refuses
// either way — which is why the consumer had to be found, not assumed.
package bc_d1r10_j0_ifexpr_then_arm;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn stash(c: &C, v: &mut Vec<B>) { v.push(c.mk()); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let k: i64 = if c.v > 0i64 { stash(&c, &mut vs); 1i64 } else { 0i64 };
    c.bump();                        // must be REFUSED
    return k + *vs.get(0u64).p;
}
