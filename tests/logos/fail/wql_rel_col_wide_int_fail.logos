// WQL — A RECURSIVE min/max OVER A u64 VALUE COLUMN IS REFUSED BY ITS ORDER.
//
// A recursive min/max is a LATTICE JOIN: the fixpoint converges to the extremum
// of the order the emitted comparison realizes, and the emitted lattice join is
// the i64 baseline. A `u64` column is a legal rel column (`Eq + Hash`, ADR 0031
// R4.1), so the column check no longer stands in front of this question: the
// aggregate seam asks it itself, and refuses every value column but `i64`.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.str;

struct Node { pub id: i64 }
struct Edge { pub src: i64, pub dst: i64, pub w: u64 }

pub deem bad(src: &[Node], edges: &[Edge]) {
    rel dist(node: i64, lo: u64) {
        from src s select (s.id, 0);
        from dist x join edges e on e.src == x.node
            group by e.dst
            aggregate lo = min(x.lo + e.w)
            select (e.dst, lo);
    }
    from dist r select (r.node, r.lo) order by r.node
}

fn main() -> i32 {
    let src: [Node; 1] = [ Node { id: 1i64 } ];
    let edges: [Edge; 1] = [ Edge { src: 1i64, dst: 2i64, w: 1u64 } ];
    let out: Vec<(i64, u64)> = bad(&src[..], &edges[..]);
    return out.len() as i32;
}
