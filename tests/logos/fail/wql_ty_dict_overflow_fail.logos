// A BINDING THAT DOES NOT FIT IS A DIAGNOSTIC, NEVER A SILENT `i64`.
//
// The type dictionary is a fixed-size table (`el::EL_TY_CAP`, 256 bindings —
// eight sources of thirty-two columns, four times the flat rel-column window
// this plane already states). Past the cap a binding used to be dropped with no
// word at all, and a dropped binding is not an absent type: `ty_name_of` answers
// the `i64` baseline, so the column is EMITTED at the wrong width with nothing
// to see. That is how this plane's worst defects begin, so the overflow is
// recorded where it is decided (the setter) and reported by the stampers, which
// hold the metaprog diag channel `el` deliberately does not import.
//
// `W` declares 300 columns; the 257th binding is the first one dropped, and the
// message names it.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct W {
    pub c0: i64, pub c1: i64, pub c2: i64, pub c3: i64, pub c4: i64, pub c5: i64, pub c6: i64, pub c7: i64, pub c8: i64, pub c9: i64,
    pub c10: i64, pub c11: i64, pub c12: i64, pub c13: i64, pub c14: i64, pub c15: i64, pub c16: i64, pub c17: i64, pub c18: i64, pub c19: i64,
    pub c20: i64, pub c21: i64, pub c22: i64, pub c23: i64, pub c24: i64, pub c25: i64, pub c26: i64, pub c27: i64, pub c28: i64, pub c29: i64,
