// ADR 0030 S3 (C-PAT) battery catch: logosc ACCEPTED this non-exhaustive / refutable shape and the missing
// value fell through (undefined value, SIGSEGV or the code after); rustc refuses it (E0004).
// exhaustiveness oracle battery (ADR 0030 S3): i64 stmt-form {0,1} no wildcard, fallthrough return 99 (value=5)
package exh_i64_literal_nonexh_stmt;
fn run() -> i32 { let x: i64 = 5i64; match x { 0i64 => { return 1i32; } 1i64 => { return 2i32; } } return 99i32; }

fn main() -> i32 { return run(); }
