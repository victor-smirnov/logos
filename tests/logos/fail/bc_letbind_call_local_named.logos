package bc_letbind_call_local_named;
struct A<'a> { x: &'a i64 }
impl<'q> A<'q> {
    fn newa(x: &'q i64) -> A<'q> {
        return A { x: x };
    }
}
fn foo<'a>(p: &'a i64) -> i64 {
    let v: i64 = 22i64;
    let x: A<'a> = A::newa(&v);
    return *x.x + v - v;
