package bc_thruref_assign_ref_binding_borrowed_refuse;
extern fn printf(fmt: *const u8, ...) -> i32;
fn show(fmt: str, v: i64) { unsafe { printf(fmt.as_ptr(), v); } }
struct P { a: i64, b: i64 }
fn main() -> i32 {
    let s1: P = P { a: 1i64, b: 2i64 };
    let s2: P = P { a: 3i64, b: 4i64 };
    let mut r: &P = &s1;
    let q: &&P = &r;
    r = &s2;
    show("q.a=%lld\n", q.a);
    return (q.a + r.b) as i32;
}
