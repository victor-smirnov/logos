// D1 round 9 / S1 — THE SUMMARIZER DID NOT SEE A `&mut` STORED INTO A FIELD.
//
// THE DEFECT (unsound, rc=0 at HEAD and on r8). `fn stash(c: &C, v: &mut
// Vec<B>) { let mut h: Inner = Inner { r: v }; h.r.push(c.mk()); }` lost
// `out1` ENTIRELY — LOGOS_DUMP_FLOWS printed no summary line for `stash` at
// all — while the local-alias twin (`let r: &mut Vec<B> = v;`) summarised
// `result<-0 out1<-0x1`. `note_alias` was reached from exactly two call sites
// (walk_stmt's Let and Assign) behind a gate on the WHOLE value's type, and a
// struct literal is not a `&mut`. Round 8 unified the shape walker, the store
// and the resolve; the FEEDING stayed split. It no longer is: `each_ref_store`
// is the one enumeration all three instances are fed through.
package bc_d1r9_s1_summary_field_store;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct Inner { r: &mut Vec<B> }
struct Outer { i: Inner }
fn stash(c: &C, v: &mut Vec<B>) {
    let mut h: Inner = Inner { r: v };   // the &mut goes into a struct FIELD
    h.r.push(c.mk());
}
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    stash(&c, &mut vs);
    c.bump();                            // must be REFUSED
    return *vs.get(0u64).p;
}
