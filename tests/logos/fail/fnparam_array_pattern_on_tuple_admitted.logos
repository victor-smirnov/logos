// An ARRAY pattern against a TUPLE parameter type. This too COMPILED CLEAN AND
// RAN on b917cf69ace435e6: the parameter door read the pattern's kind and never
// the type's, so a shape that cannot match at all bound nothing and passed.
// Rust refuses it (E0529, "expected an array or slice, found `(i64, i64)`").
// Twin of fnparam_tuple_pattern_arity_admitted, one door, two directions.
package fnparam_array_pattern_on_tuple_admitted;
fn probe([a, b]: (i64, i64)) -> i32 {
    if a + b != 3i64 { return 1i32; }
    return 0i32;
}
fn main() -> i32 {
    let t: (i64, i64) = (1i64, 2i64);
    return probe(t);
}
