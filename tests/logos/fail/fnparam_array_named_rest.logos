// `name @ ..` at a function parameter: the parameter binds as `let PAT = param`,
// and the `let` door refuses a named rest in an array pattern. Rust binds it by
// value as the sub-array (squeue let_array_named_rest_refused).
package fnparam_array_named_rest;
fn probe([a, xs @ ..]: [i64; 3]) -> i32 {
    if a != 1i64 { return 1i32; }
    return 0i32;
}
fn main() -> i32 {
    let arr: [i64; 3] = [1i64, 2i64, 4i64];
    return probe(arr);
}
