// Slice 4.4e closed precision/sign/`#`/`0`; only float-Display-backed
// scientific notation `{:e}` / `{:E}` remains gated (no Display impls
// for f32/f64 yet).
package format_macro_spec_not_impl;

use std.fmt;
use std.lang.text;

fn main() -> i32 {
    let s = format!("{:e}", 3.14f64);
    return 0;
}
