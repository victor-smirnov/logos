package datanode_return_value;
// Sema fail: returning a DataNode datatype by bare value from a function.
// FakePtr<T> is a generic Datatype field → Node.is_data_plain = false.

pub datatype FakePtr<T> { offset: u32 }

datatype Node {
    value: i32,
    next:  FakePtr<Node>,
}

// Error: Node is DataNode — cannot be returned by value.
fn make_node() -> Node {
    return Node { value: 0, next: FakePtr { offset: 0 as u32 } };
}

fn main() -> i32 { return 0; }
