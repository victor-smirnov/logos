// D1 round 11 / X0 — the `continue` half of the exit-collector family. Same
// shape as the `break` witness; kept separate because the two states reach the
// after-loop join through different collectors (frame2.continue_states vs
// frame2.break_states) and one can be fixed without the other.
package bc_d1r11_x0_nested_if_continue;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn stash(c: &C, v: &mut Vec<B>) { v.push(c.mk()); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut i: i64 = 0i64;
    while i < 3i64 {
        i = i + 1i64;
        if i > 1i64 {
            stash(&c, &mut vs);
            continue;
        }
    }
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
