// D1, OVER-REFUSAL guard — intra-body NLL must be keyed on the holder's LAST
// USE, not on "the iteration is over". `r` is used BELOW the read of `n`, so
// the loan is live at the read and it must stay REFUSED.
package bc_nll_d1_loop_live_refuse;
fn main() -> i64 {
    let mut n: i64 = 0i64;
    let mut acc: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < 3i64 {
        let r: &mut i64 = &mut n;
        acc = acc + n;                // must be REFUSED: `r` is used below
        *r = *r + 1i64;
        i = i + 1i64;
    }
    return acc;
}
