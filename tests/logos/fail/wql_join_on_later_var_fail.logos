// A step's `on` may read only the row vars bound at or before that step: `c`
// is bound by the NEXT step. A named error; it used to surface as
// `undefined variable 'c'` in the generated code.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct A { pub k: i64, pub v: i64 }
struct B { pub m: i64 }
struct C { pub n: i64 }

pub deem bad(xs: &[A], ys: &[B], zs: &[C]) {
    from xs a
    join ys b on b.m == c.n
    join zs c on c.n == a.k
    select a.v }

fn main() -> i32 { return 0i32; }
