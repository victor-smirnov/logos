// n2 — HOMONYM: the module declares its OWN `Vec` AND imports the stdlib one.
// Both live in the same compilation. The local `Vec` must not reach the slice
// coercion; the stdlib one, obtained through `vec_new`, must still reach it.
package bc_0910d_vecbare_hb_n2_refuse;
use logos.mem.collections.vec;

pub struct Vec<T> { a: i64, b: i64 }

fn total(s: &[i64]) -> i64 {
    let mut t: i64 = 0i64;
    for x in s { t = t + *x; }
    return t;
}

fn main() -> i32 {
    let v: Vec<i64> = Vec { a: 7i64, b: 3i64 };
    let n: i64 = total(&v);
    if n != 0i64 { return 1i32; }
    return 0i32;
}
