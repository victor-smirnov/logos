// The second uncovered class member: `f[i] += v` in
// `lower_place_compound_assign`, which mints the receiver twice (read and
// write) from the bare name and never lowers it as a value. Rust: E0381.
// PAIR: bc_uninitborrow_indexcompound_admit.
package bc_uninitborrow_indexcompound_refuse;
struct I { v: i64 }
impl Index<i64, i64> for I { fn index(self: &I, i: i64) -> &i64 { return &self.v; } }
impl IndexMut<i64, i64> for I { fn index_mut(self: &mut I, i: i64) -> &mut i64 { return &mut self.v; } }
fn main() -> i32 {
    let mut f: I;
    f[0i64] += 3i64;
    f = I { v: 0i64 };
    return f.v as i32;
}
