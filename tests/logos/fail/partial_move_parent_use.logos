// T1-10 (B78): using the PARENT (`o.i`) or whole root after a depth-2
// leaf move (`o.i.s`) is a use of partially-moved data.
package partial_move_parent_use;

struct Inner { s: String, t: String }
struct Outer { i: Inner }

fn consume(s: String) -> i64 { s.len() }
fn use_inner(i: Inner) -> i64 { i.t.len() }

fn main() -> i32 {
    let o = Outer { i: Inner { s: String::from("a"), t: String::from("bb") } };
    let n = consume(o.i.s);
    let w = use_inner(o.i);
    (n + w) as i32
}
