// D1 round 12 / A0 — A MATCH IS A TRANSPARENT MULTI-ARM VALUE. `ref_source_places`
// enumerated Cast / IfExpr / BlockExpr and NOT MatchExpr, so `s` was recorded
// reborrowing NOTHING and `s.push(c.mk())` laundered a loan `vs` never learned
// about. The summarizer's twin walker (`taint_of`) already had the arm — the two
// one-shape enumerations had drifted, which is exactly what round 8 charged for.
// The `if`-`else` spelling one line down (bc_d1r12_a0_if_twin) refuses, which is
// what makes this a leak and not a policy.
package bc_d1r12_a0_match_source;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut ws: Vec<B> = Vec::new();
    let k: i64 = 1i64;
    let s: &mut Vec<B> = match k { 1i64 => &mut vs, _ => &mut ws };
    s.push(c.mk());
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
