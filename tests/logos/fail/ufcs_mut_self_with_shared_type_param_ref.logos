// UFCS `K::bump(t)` with `bump(&mut self)` and `t: &T` is refused (rustc E0308).
package m;
use logos.std.fmt;
struct C { n: i64 }
trait K { fn bump(&mut self); }
impl K for C { fn bump(&mut self) { self.n += 10; } }
fn g<T: K>(t: &T) { K::bump(t); }
fn main() { let c = C { n: 1 }; g(&c); println!("{}", c.n); }
