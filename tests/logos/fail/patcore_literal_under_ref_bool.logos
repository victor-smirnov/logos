// PATTERN SCALAR CORE (soundness queue, closed 2026-09-06f). RFC 2005: a
// NON-REFERENCE pattern matches the POINTEE, so a scalar door needs the chain
// collapsed to ZERO layers where an aggregate door wants ONE. Spec:
// pat.scalar.core-under-ref. The fail twin is ONE TOKEN away — the scrutinee
// `&v` becomes `&b` — and pins that the door still refuses on the CORE type,
// naming the core and not the reference.
package patcore_literal_under_ref_bool;
fn main() -> i32 {
    let b: bool = true;
    let v: i64 = 4i64;
    let c: char = 'q';
    let t: bool = true;
    let mut out: i64 = 0i64;
    match &b {
        4i64 => { out = out + 1i64; }
        _ => { return 1i32; }
    }
    match &c {
        'q' => { out = out + 1i64; }
        _ => { return 2i32; }
    }
    match &t {
        true => { out = out + 1i64; }
        false => { return 3i32; }
    }
    if out != 3i64 { return 4i32; }
    return 0i32;
}
