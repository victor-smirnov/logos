// ONE TOKEN FROM pass/refslot_index_write_local_refmut (`let mut a` -> `let a`):
// the array the reference is taken from is not declared `mut`, so the `&mut`
// borrow is refused before codegen ever builds the place. The pass half's repair
// is a CODEGEN one (gen_lvalue_addr loads a reference-typed local's pointer); this
// half pins that the refusal in front of it is unchanged — an added load must not
// turn an illegal borrow into a legal one.
package refslot_index_write_not_mut_fail;
extern fn printf(fmt: *const u8, ...) -> i32;
fn main() -> i32 {
    let a: [i64; 2] = [1i64, 2i64];
    let q: &mut [i64; 2] = &mut a;
    q[0i64] = 77i64;
    let k: i64 = q[0i64];
    unsafe { printf("q0=%ld\n".as_ptr(), k); }
    if a[0i64] != 77i64 { return 1i32; }
    if a[1i64] != 2i64 { return 2i32; }
    return 0i32;
}
