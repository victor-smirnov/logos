// D1 round 5 / H5 — the TUPLE pattern, the same hole in the same site.
package bc_d1r5_h5_tuple_pat;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn stash(c: &C, v: &mut Vec<B>) {
    let w: (B, i64) = (c.mk(), 0i64);
    match w { (inner, _n) => { v.push(inner); } }
}
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    stash(&c, &mut vs);
    c.bump();
    return *vs.get(0u64).p;
}
