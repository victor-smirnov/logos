// D1 round 5 / H3 — STATEMENT ORDER IS INERT, forward half. The twin of
// fail/bc_d1r5_h3_stmt_order_chain: the same five-link assignment chain, the
// same sink, written in FORWARD order so one intra-procedural pass suffices.
//
// Under the retired kBodyPasses=3 truncation this half refused at every depth
// while the reverse-order twin ADMITTED from hop 3 on — the boundary sitting
// exactly on the cap. Two programs that differ only in the order of
// independent assignments must get the same verdict; the pair is that
// invariant, and neither half alone states it.
package bc_d1r5_h3_stmt_order_forward;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn stash(c: &C, v: &mut Vec<B>) {
    let z: i64 = 0i64;
    let mut a1: B = B { p: &z };
    let mut a2: B = B { p: &z };
    let mut a3: B = B { p: &z };
    let mut a4: B = B { p: &z };
    let mut a5: B = B { p: &z };
    a1 = c.mk();
    a2 = a1;
    a3 = a2;
    a4 = a3;
    a5 = a4;
    v.push(a5);
}
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    stash(&c, &mut vs);
    c.bump();
    return *vs.get(0u64).p;
}
