// More rels than a program holds is a named error, checked right after the
// parse (`lower::plan_caps_ok`). The registry is dynamic (2026-10-05); what
// still bounds the count is the rel masks (63). The generated parser used to
// DROP the items past a fan's slots: at the old cap of 8 the 9th rel was gone,
// and the query failed as `unknown source` for a rel it does declare
// (measured, 2026-10-04).
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct X { pub k: i64 }

