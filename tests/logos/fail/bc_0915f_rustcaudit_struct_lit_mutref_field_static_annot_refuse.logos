package bc_0915f_rustcaudit_struct_lit_mutref_field_static_annot_refuse;
static G: i64 = 7i64;
struct H<'a> { p: *mut &'a i64 }
struct HM<'a> { m: &'a mut &'a i64 }
fn main() -> i32 {
    let mut r: &'static i64 = &G;
    let q: *mut &'static i64 = &mut r;
    let h: H = H { p: q };
    let mut s: &'static i64 = &G;
