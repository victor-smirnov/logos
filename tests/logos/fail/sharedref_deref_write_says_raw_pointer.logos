// A write through a SHARED reference is E0594 in the borrow checker's words, not
// "write through raw pointer requires unsafe context" (squeue row of the same name).
package sharedref_deref_write_says_raw_pointer;
fn main() -> i32 {
    let mut t: (i64, i64) = (3i64, 4i64);
    match t {
        (ref a, b) => { *a = *a + 1i64; if b != 4i64 { return 2i32; } }
    }
    return 0i32;
}
