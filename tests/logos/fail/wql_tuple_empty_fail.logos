// wql! diagnostic: `select ()` — an EMPTY tuple is not a projection (EL has no
// unit value); the select body fails the EL parse and the whole query is
// rejected as malformed.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct P { pub a: i64 }

resource bad = deem!(ps: &[P]) { from ps p select () };

fn main() -> i32 { return 0i32; }
