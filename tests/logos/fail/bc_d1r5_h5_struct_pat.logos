// D1 round 5 / H5 — FlowSummarizer::bind_pat handled 2 of the 13 pattern
// kinds and silently returned for the other 11. A STRUCT pattern in the
// callee bound nothing, so the summary read `result<-0` while the ENUM twin
// refused. The Wrap is manufactured INSIDE the callee on purpose: passing
// it by value at the call site is refused by door 8b, a different rule.
// Admit twin: pass/bc_d1r5_h5_struct_pat_admits.
package bc_d1r5_h5_struct_pat;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct Wrap { b: B }
fn stash(c: &C, v: &mut Vec<B>) {
    let w: Wrap = Wrap { b: c.mk() };
    match w { Wrap { b: inner } => { v.push(inner); } }
}
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    stash(&c, &mut vs);
    c.bump();
    return *vs.get(0u64).p;
}
