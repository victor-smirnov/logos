// HAny escape safety: an HAny may be a Ref (absolute ptr) into a Hermes2 arena.
// Returning one derived from a LOCAL container is dangling (the container drops →
// arena freed → the Ref dangles). Caught because HAny is `#[borrow_carrying]`: the
// borrow checker escape-tracks it like a reference — `arr.get(i)` / `HAny::from(&x)`
// tie the result to the container, so returning it past the container's scope is
// rejected. (To escape safely, launder through a holder: hold_any → HeldAny.)
package hany_ref_escapes_container;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.array;
fn make_elem() -> HAny {
    let h: Hermes2 = hermes2_new(64i64);
    let nested: &mut HArray<HVal> = h.array(2i64);
    nested.push(HAny::from(99i64));
    return HAny::from(&*nested);   // ERROR: Ref into local container's arena, escapes
}
fn main() -> i32 { return 0; }
