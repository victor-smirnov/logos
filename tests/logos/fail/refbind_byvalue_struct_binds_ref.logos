// The fail half of pass/refbind_byvalue_struct_field_read, ONE TOKEN away:
// `let q: S = w;` instead of `let q: &S = w;`. `ref w` over a by-value struct
// binds `w : &S` — a BORROW, not the struct — and that sema fact is exactly the
// one the closed defect's codegen failed to carry into the binding's shape.
package refbind_byvalue_struct_binds_ref;
struct S { pub a: i64, pub b: i64 }
fn main() -> i32 {
    let s: S = S{ a: 4i64, b: 7i64 };
    match s {
        ref w => {
            let q: S = w;
            if q.a != 4i64 { return 1i32; }
            return 0i32;
        }
    }
}
