// An INVARIANT binder takes no meet: `put(&mut s, &n)` with `s: &'static i64` is refused
// (rustc 1.98.1: E0597).
package call_invariant_binder_no_meet_refused;
static V: i64 = 5i64;
fn put<'a>(slot: &'a mut &'a i64, v: &'a i64) { *slot = v; }
fn main() -> i32 {
    let mut s: &'static i64 = &V;
    let n: i64 = 6;
    put(&mut s, &n);
    return 0;
}
