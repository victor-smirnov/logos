package at_bind_tuple_elem_nomut_assign_fail;
fn main() -> i32 {
    let t: (i64, i64) = (1i64, 2i64);
    let mut out: i64 = 0i64;
    match t {
        (a @ 1i64..=5i64, b) => { a = a + 10i64; out = a + b; }
        (_, _) => { out = -1i64; }
    }
    if out != 13i64 { return 1i32; }
    return 0i32;
}
