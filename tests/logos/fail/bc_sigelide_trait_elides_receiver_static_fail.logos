// The FAIL half of tests/logos/pass/bc_sigelide_trait_elides_receiver_pass,
// ONE TOKEN apart: the trait's return is `&'static i64` instead of `&i64`.
// The impl returns `&'a i64`, a lifetime tied to the receiver — SHORTER than
// 'static. A return position is covariant, so an impl may return a longer
// lifetime than the trait declares but never a shorter one, and rustc refuses
// this (`impl` item signature doesn't match `trait` item signature, the same
// verdict as tests/ui/lifetimes/trait-impl-mismatch-elided-lifetime-issue-65866).
// This is the fixture that says the 2026-09-09elide elision expansion did NOT
// simply stop comparing return lifetimes.
package bc_sigelide_trait_elides_receiver_static_fail;
struct R {
    v: i64,
}

trait Peek {
    fn peek(self: &Self) -> &'static i64;
}

impl Peek for R {
    fn peek<'a>(self: &'a R) -> &'a i64 {
        return &self.v;
    }
}

fn main() -> i32 {
    return 0;
}
