// mapping ITEM (ADR 0016) — REL COLUMN TYPE diagnostic. Rel rows are
// set-deduplicated, so column types must be joinable/Eq: i64/str/bool.
// An f64 column must be rejected AT THE ITEM (sema lower_mapping_def),
// naming the mapping, the rel, the column, and the offending type.
package test;

use logos.lang.writ.container;
use logos.mem.collections.vec;
use logos.std.wql.mapping_item;

pub mapping Bad(g: &Writ) {
    pub rel weights(k: str, w: f64) {
        from g .weights [*] q select (q.key, q.vi);
    }
}

fn main() -> i32 {
    return 0i32;
}
