// A move out of `d` while a `&&D` built on `&d` is still used is E0505 (rustc 1.98.1). `D` carries `impl Drop` so it is a MOVE type:
// a plain-data `D` is structurally auto-Copy in Logos (DIVERGENCES.md A16, canonised), where `let moved = d` copies and is legal —
// which is why squeue double_ref_move_while_borrowed_admits was closed as not a defect and replaced by this pin.
package double_ref_move_while_borrowed_refused;
struct D { v: i64 }
impl Drop for D { fn drop(self: &mut D) {} }
fn read(src: &&D) -> i64 {
    return src.v;
}
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    let rd: &D = &d;
    let hold: &&D = &rd;
    let moved: D = d;
    return (read(hold) - 6i64 + moved.v - 6i64) as i32;
}
