// The fail half of pass/refbind_over_ref_scrutinee_shapes: a top-level `ref w`
// over a `&i64` scrutinee binds `w : &&i64` whatever the surrounding shape, and
// that extra layer is exactly what the closed defect dropped. `*w` is `&i64`,
// so it does not initialise an `i64` (rustc 1.98.1: E0308). (Passing `w` to a
// `&i64` parameter is a deref coercion and compiles —
// pass/refbind_over_ref_scrutinee_deref_coerced_call.)
package refbind_over_ref_scrutinee_shapes_type;
fn main() -> i32 {
    let j: i64 = 33i64;
    match &j {
        ref w => {
            let x: i64 = *w;
            return x as i32;
        }
    }
}
