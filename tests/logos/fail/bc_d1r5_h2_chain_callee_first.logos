// D1 round 5 / H2 — the reversed-declaration twin of
// bc_d1r5_h2_chain_caller_first. Same program, inert difference.
package bc_d1r5_h2_chain_callee_first;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B<'a> { p: &'a i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn s0<'a>(c: &'a C, v: &mut Vec<B<'a>>) { v.push(c.mk()); }
fn s1<'a>(c: &'a C, v: &mut Vec<B<'a>>) { s0(c, v); }
fn s2<'a>(c: &'a C, v: &mut Vec<B<'a>>) { s1(c, v); }
fn s3<'a>(c: &'a C, v: &mut Vec<B<'a>>) { s2(c, v); }
fn s4<'a>(c: &'a C, v: &mut Vec<B<'a>>) { s3(c, v); }
fn s5<'a>(c: &'a C, v: &mut Vec<B<'a>>) { s4(c, v); }
fn s6<'a>(c: &'a C, v: &mut Vec<B<'a>>) { s5(c, v); }
fn s7<'a>(c: &'a C, v: &mut Vec<B<'a>>) { s6(c, v); }
fn s8<'a>(c: &'a C, v: &mut Vec<B<'a>>) { s7(c, v); }
fn s9<'a>(c: &'a C, v: &mut Vec<B<'a>>) { s8(c, v); }
fn s10<'a>(c: &'a C, v: &mut Vec<B<'a>>) { s9(c, v); }
fn s11<'a>(c: &'a C, v: &mut Vec<B<'a>>) { s10(c, v); }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    s11(&c, &mut vs);
    c.bump();
    return *vs.get(0u64).p;
}
