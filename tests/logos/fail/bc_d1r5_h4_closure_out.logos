// D1 round 5 / H4 — the out-param sink of the same defect: `vs.push(f())`.
// A SHARED whole-root capture registers no borrow at the ClosureBox, so
// there was no loan for the receiver to inherit.
// Admit twin: pass/bc_d1r5_h4_closure_out_admits.
package bc_d1r5_h4_closure_out;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let f = || -> B { return c.mk(); };
    vs.push(f());
    c.bump();
    return *vs.get(0u64).p;
}
