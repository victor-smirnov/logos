package bc_sigdefuniq_default_selfparam_fail;

struct R {
    v: i64,
}

trait Same {
    fn same(self: &Self, other: &Self) -> bool {
        return false;
    }
}

impl Same for R {
    fn same(self: &R, other: &i64) -> bool {
        return self.v == *other;
    }
}

fn main() -> i32 {
    let r: R = R { v: 7i64 };
    let n: i64 = 7i64;
    if r.same(&n) {
        return 0;
    }
    return 1;
}
