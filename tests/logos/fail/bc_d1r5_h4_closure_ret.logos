// D1 round 5 / H4 — a CLOSURE-CALL result carried no provenance. A
// closure's provenance lives in its CAPTURES, which are not operands of the
// call, so the documented indirect-call fallback was structurally vacuous
// rather than merely conservative. Direct twin: `return c.mk();` refused.
package bc_d1r5_h4_closure_ret;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
fn mkb() -> B {
    let c: C = C { v: 1i64 };
    let f = || -> B { return c.mk(); };
    return f();
}
fn main() -> i64 { let b: B = mkb(); return *b.p; }
