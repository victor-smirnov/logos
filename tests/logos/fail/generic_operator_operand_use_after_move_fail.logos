// `x + y` over `T: Add` MOVES x and y (Add::add takes self by value): a later use of x is E0382.
package generic_operator_operand_use_after_move_fail;
struct D { v: i64 }
impl Drop for D { fn drop(self: &mut D) { } }
impl Add for D { type Output = D; fn add(self: D, o: D) -> D { return D { v: self.v + o.v }; } }
fn sum<T: Add<Output = T>>(x: T, y: T) -> T { let s: T = x + y; let t: T = x; return s; }
fn main() -> i32 { return sum(D { v: 1i64 }, D { v: 2i64 }).v as i32; }
