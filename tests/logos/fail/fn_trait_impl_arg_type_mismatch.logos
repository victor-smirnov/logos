// Deferred-3: per-element type-arg check past the pack position in
// the trait-impl matcher (sema_collect.cpp).
//
// `impl Fn<i32, i32> for Foo` binds the variadic Args pack to
// [i32, i32]. An impl method that exposes
// `fn call(&self, x: u8, y: bool)` must be rejected — those impl
// params don't match the pack's concrete types. Before B.4 the
// matcher silently accepted any post-pack params; the fix rejects
// the mismatched impl with a clear "missing method 'call'" error
// (no signature satisfies both arity and per-arg types).
package fn_trait_impl_arg_type_mismatch_test;

use logos.lang.ops;

pub struct Foo {}

// Impl declares Fn<i32, i32> but its call exposes (u8, bool) — should
// be rejected by the per-element check.
impl Fn<i32, i32> for Foo {
    type Output = i32;
    fn call(&self, _x: u8, _y: bool) -> i32 { return 0; }
}

fn main() -> i32 { return 0; }
