// logos-core §6.1: union pattern naming 2 fields is rejected — Rust
// spec `items.union.pattern.one-field`.
package core_6_1_union_pattern_two;

union Pair {
    a: i32,
    b: i32,
}

fn main() -> i32 {
    let u: Pair = Pair { a: 42i32 };
    let r: i32 = unsafe {
        match u {
            Pair { a, b } => a,
        }
    };
    if r != 42i32 { return 1i32; }
    return 0i32;
}
