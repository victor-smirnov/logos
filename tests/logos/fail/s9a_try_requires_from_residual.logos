// ADR 0030 S9a step C: `Try` is Rust-shaped — `trait Try: FromResidual<Self::Residual> { type Output; type Residual; ... }`;
// an impl without the supertrait impl for its own residual is refused (Rust: E0277 on the supertrait bound).
package s9a_try_requires_from_residual;
use logos.lang.ops;
use logos.lang.try_trait;
struct E {}
struct W { v: i32 }
impl Try for W {
    type Output = i32;
    type Residual = E;
    fn from_output(output: i32) -> W { return W { v: output }; }
    fn branch(self: W) -> ControlFlow<E, i32> { return ControlFlow::Continue(self.v); }
}
fn main() -> i32 { return 0; }
