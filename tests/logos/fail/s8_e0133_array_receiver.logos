package s8_e0133_array_receiver;
// ADR 0030 S8 row 1 (E0133 judged on the call, once): an unsafe method of `impl T for [i64; 2]` called on an array.
use logos.mem.collections.vec;
trait T { unsafe fn m(&self) -> i32; } impl T for [i64; 2] { unsafe fn m(&self) -> i32 { return 1; } } fn main() -> i32 { let a = [1i64, 2]; return a.m(); }
