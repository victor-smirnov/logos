// Twin of pass/closure_void_body_param_epilogue, one BINDING apart: the void
// body now moves its by-value parameter out twice. The epilogue the pass half
// adds is the CONSERVATIVE `body_ever_moved_` arm of `emit_frame_drops`, the
// same one `lower_fn` passes, so a parameter moved on any path gets no
// unguarded drop — and using it after the move is still a diagnostic, not a
// silent second destructor.
package closure_void_body_param_moved_twice_fail;

struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }

fn as_buf<F>(d: D, f: F) where F: FnOnce(D) { f(d); }

fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    as_buf(D { v: 1000i64, c: p }, |x: D| { let _a: D = x; let _b: D = x; });
    return 0i32;
}
