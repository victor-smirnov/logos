package dyn_send_field_site;

trait Speak { fn hi(&self) -> i32; }

struct NotSend { p: *mut u8 }
impl Speak for NotSend { fn hi(&self) -> i32 { 1 } }

struct Holder { d: &dyn Speak + Send }

fn main() -> i32 {
    let mut b = 0u8;
    let ns = NotSend { p: &mut b };
    let h = Holder { d: &ns };
    h.d.hi() - 1
}
