// #[pinned] — a location-anchored at-rest type (the Hermes HAnyRel pattern):
// its bits are anchored to its storage slot (a self-relative delta), so it must
// NEVER be moved by value (memcpy would break the anchor). It lives only behind a
// pointer (`*mut`), accessed in place + materialised explicitly to its movable
// value form. Unlike #[rel_ptr] (whose value-form is the resolved absolute pointer,
// so it is itself movable), a #[pinned] type is non-movable itself. Here a by-value
// `let` binding of the pinned type is the rejection.
package pinned_non_movable;
#[pinned] struct HAnyRel { raw: i64 }
fn main() -> i32 {
    let x: HAnyRel = HAnyRel { raw: 0i64 };   // ERROR: pinned type by value
    return x.raw as i32;
}
