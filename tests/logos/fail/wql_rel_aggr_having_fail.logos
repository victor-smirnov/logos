// An aggregating rel body's `having` is refused. The recursive min/max fold
// (`rel_body_agg_frag`) reads the group key, the one aggregate's argument and
// the `where` — never the `having` — so before ADR 0031 R6 a `having` here
// compiled and was silently not applied (the same class as the `order by` of
// wql_rel_aggr_order_fail, which the core's rule-shape check closed in R2).
// Filter the rel's rows in the entry query instead.
package test;

use logos.std.wql.wql;
use logos.mem.collections.vec;

struct Node { pub id: i64 }
struct Edge { pub src: i64, pub dst: i64, pub w: i64 }

pub deem sssp(src: &[Node], edges: &[Edge]) {
    rel dist(node: i64, d: i64) {
        from src s select (s.id, 0);
        from dist x join edges e on e.src == x.node
            group by e.dst
            aggregate d = min(x.d + e.w)
            having d < 100
            select (e.dst, d);
    }
    from dist r select (r.node, r.d)
}

fn main() -> i32 { return 0i32; }
