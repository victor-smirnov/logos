package bc_0910d_vecbare_hb_n4_refuse;

pub struct Vec<T> { only: i64 }

fn total(s: &[i64]) -> i64 {
    let mut t: i64 = 0i64;
    for x in s { t = t + *x; }
    return t;
}

fn main() -> i32 {
