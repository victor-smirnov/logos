// Was SOUNDNESS QUEUE row rawptr_mixed_mutability_eq_admitted; closed 2026-09-23 (rustc E0308).
// SOUNDNESS QUEUE row rawptr_mixed_mutability_eq_admitted (tier 1).
// AN ILLEGAL PROGRAM COMPILES AND RUNS. `*mut i64 == *const i64` is a TYPE ERROR in Rust —
// `impl PartialEq for *const T` / `*mut T` are two separate single-type impls and there is no
// cross-mutability one, so rustc 1.98.1 refuses this with error[E0308]: mismatched types
// (measured, twin src/compiler/probes/2026-09-17p-ordcmpland/rust/w01_mixedmut_eq.rs).
// logosc compiles it and RUNS it at exit 1: sema's comparison arm accepts the pair because
// `types_compatible(*mut i64, *const i64)` is true (the `*const T / *mut T -> &T` and
// `&T / &mut T -> *const T / *mut T` coercion arms in sema.cpp), and mlir-gen's `==` branch
// emits `llvm.icmp eq` over two `!llvm.ptr`. The ORDERING twin one token away (`p < q`) is
// refused today only by the MLIR verifier, NOT by a type check — it is the same hole seen
// through a different emitter branch.
// Found by round 2026-09-17p-ordcmpland (hand w01) while pricing the ordering arm: the arm had
// to carry a TYPE-IDENTITY gate precisely so it would not inherit this admission.
// Rust: refused (E0308). Observed: run 1.
package rawptr_mixed_mutability_eq_fail;
fn main() -> i32 {
    let mut v: i64 = 1i64;
    let p: *mut i64 = &mut v as *mut i64;
    let q: *const i64 = &v as *const i64;
    if p == q { return 1i32; }
    return 0i32;
}
