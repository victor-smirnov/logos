// D1 round 3 / F4, the erased-CLOSURE spelling of fail/bc_d1r3_f4_box_ref_local.
// `Box<dyn Fn() -> i64>` names no borrow anywhere in its type, yet the closure
// captures `b`, a reference to the fn-local `x`, and the whole thing walks out
// of the function. Two things had to be true for this to be caught: the return
// gate must fire on the retention (not the type name), and the flow through
// `Box::new` must be visible — which is why the summary's "can this type carry
// a borrow" answer says YES for a raw POINTER and for a CLOSURE. Measured: with
// either missing, `box_new`'s `let p = alloc(…); p[0] = val; return Box{ptr:p}`
// summarised as retaining NOTHING and this program went back to rc=0.
// re-pinned 2026-09-02y: the object-lifetime bound at the unsize coercion now refuses this first; the earlier pin was `cannot return reference to local variable`
package bc_d1r3_f4_closure_local;
use logos.mem.boxed;
fn mk_closure() -> Box<dyn Fn() -> i64> {
    let x: i64 = 5i64;
    let b: &i64 = &x;
    return Box::new(move || -> i64 { return *b; });
}
fn main() -> i64 { let f: Box<dyn Fn() -> i64> = mk_closure(); return f(); }
