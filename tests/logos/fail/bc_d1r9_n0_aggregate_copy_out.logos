// D1 round 9 / N0, third shape — the aggregate copied back OUT of the nested
// place (`let mut inner: Inner = h.i;`). This one leaked as a CONSEQUENCE:
// `note_place_copy` is correctly conditioned on the source's sub-place keys
// existing, and they never did until the nested literal was recorded.
package bc_d1r9_n0_aggregate_copy_out;
use logos.mem.collections.vec;
#[borrow_carrying]
struct B { p: &i64 }
struct C { v: i64 }
impl C {
    fn mk(&self) -> B { return B { p: &self.v }; }
    fn bump(&mut self) { self.v = self.v + 1i64; }
}
struct Inner { r: &mut Vec<B> }
struct Outer { i: Inner }
fn main() -> i64 {
    let mut c: C = C { v: 1i64 };
    let mut vs: Vec<B> = Vec::new();
    let mut h: Outer = Outer { i: Inner { r: &mut vs } };
    let mut inner: Inner = h.i;
    inner.r.push(c.mk());
    c.bump();                        // must be REFUSED
    return *vs.get(0u64).p;
}
