// three_layer fixture: top tier. Depends on three_layer.mid (which
// transitively depends on three_layer.low). Manifest declares
// `prelude three_layer.mid`, but this file carries
// `#![no_implicit_prelude]` so the prelude is NOT injected — the
// explicit `use` lines below are required. Exercises Phase 3.4
// opt-out attribute.

#![no_implicit_prelude]

package three_layer.hi;

use three_layer.mid;
use three_layer.low;

pub fn hi_sextuple(x: i32) -> i32 {
    return mid_quadruple(x) + low_double(x);
}
