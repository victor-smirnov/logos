// Module fixture: a GENERIC #[self_describing] DST whose methods call each
// other through the DstRef receiver. Regression class (module-mode only):
// the DstRef method-call path lowers to a NAMED call whose receiver base
// carries no "$M<module>" coexistence tag, so the lazy-method enqueue key
// missed concrete_struct_types_ and private helper instances (me/at) were
// never cloned — "does not reference a valid function" at mlir verify.
// Building THIS module is half the test; the consumer test crosses modules.
package sd_dst_mod;

use logos.lang.marker;

extern fn malloc(n: i64) -> *mut u8;

#[self_describing]
pub struct SdArr<T: Copy> {
    count: u32,
    pad:   u32,
    tail:  [T],
}

impl<T: Copy> SelfDescribing for SdArr<T> {
    fn dst_len(self: *const SdArr<T>) -> i64 {
        return unsafe { (*self).count as i64 };
    }
}

impl<T: Copy> SdArr<T> {
    // private helpers — reachable ONLY through cloned method bodies
    fn me(self: &SdArr<T>) -> i64 {
        let sp: *const SdArr<T> = self as *const SdArr<T>;
        return sp as i64;
    }
    unsafe fn at(self: &SdArr<T>, i: u32) -> *mut T {
        return (self.me() + (sizeof::<SdArr<T>>() as i64)
                          + (i as i64) * sizeof::<T>()) as *mut T;
    }
    pub unsafe fn get(self: &SdArr<T>, i: u32) -> T { return *self.at(i); }
    pub unsafe fn set(self: &SdArr<T>, i: u32, v: T) { *self.at(i) = v; }
    pub unsafe fn init(self: *mut SdArr<T>, n: u32) {
        unsafe { (*self).count = n; }
    }
}

/// In-module instantiation (the emit-module compile must already clone the
/// full method set transitively).
pub unsafe fn sd_mod_probe() -> u64 {
    let m: *mut u8 = malloc(64i64);
    let a: *mut SdArr<u64> = m as *mut SdArr<u64>;
    a.init(2u32);
    a.set(0u32, 40u64);
    a.set(1u32, 2u64);
    return a.get(0u32) + a.get(1u32);
}

// ── slice-pattern partial spec (the PkdArray FSE/VLE unification model) ──────
// The [E] spec has different fields AND same-named methods; method bodies
// call each other (me→at→get chain analog). Regression: the mono named-call
// seam bound impl params POSITIONALLY from struct args (E := [u8]) →
// runaway instantiation depth (SdArr<[[u8]]>, <[[[u8]]]>, …), module-mode only.

#[self_describing]
pub struct SdVle<T: Copy> { count: u32, pad: u32, tail: [T] }

impl<T: Copy> SelfDescribing for SdVle<T> {
    fn dst_len(self: *const SdVle<T>) -> i64 { return unsafe { (*self).count as i64 }; }
}

#[self_describing]
pub struct SdVle<[E]> { hdr: u32, cnt: u32, buf: [u8] }

impl<E> SelfDescribing for SdVle<[E]> {
    fn dst_len(self: *const SdVle<[E]>) -> i64 { return unsafe { (*self).hdr as i64 }; }
}

impl<T: Copy> SdVle<T> {
    pub unsafe fn count(self: &SdVle<T>) -> u32 { return self.count; }
}

impl<E> SdVle<[E]> {
    unsafe fn base(self: &SdVle<[E]>) -> i64 {
        let sp: *const SdVle<[E]> = self as *const SdVle<[E]>;
        return sp as i64;
    }
    pub unsafe fn count(self: &SdVle<[E]>) -> u32 {
        let _b: i64 = self.base();
        return self.cnt;
    }
    pub unsafe fn bump(self: &mut SdVle<[E]>, d: u32) -> u32 {
        let sp: *mut SdVle<[E]> = self as *mut SdVle<[E]>;
        let c: u32 = sp.count();
        sp.cnt = c + d;
        return sp.count();
    }
}

pub unsafe fn sd_vle_format<E>(mem: *mut u8) -> *mut SdVle<[E]> {
    return mem as *mut SdVle<[E]>;
}

/// In-module instantiation of the spec (build-time regression for the seam).
pub unsafe fn sd_vle_probe() -> u32 {
    let m: *mut u8 = malloc(64i64);
    let v: *mut SdVle<[u8]> = sd_vle_format::<u8>(m);
    (*v).hdr = 0u32;
    (*v).cnt = 40u32;
    return v.bump(2u32);
}

// ── bound-discriminated spec (module-mode regression) ───────────────────────
// The classes this exercises at MODULE build: eager method cloning for spec
// templates despite TYPE_PARAMS (the lazy-skip emptiness test), impl→spec
// routing by bound-set equality, the $where symbol fingerprint for
// structurally-identical method twins.

pub trait SdFrozen {}
impl SdFrozen for u64 {}
impl SdFrozen for u32 {}

pub struct SdSel<T: ?Sized> { pub hdr: u64, pub cnt: u32, pub pad: u32 }
pub struct SdSel<T: Copy + SdFrozen> { pub count: u32, pub x: u32 }

impl<T: ?Sized> SdSel<T> {
    pub fn tag(self: &SdSel<T>) -> u64 { return self.hdr; }
}
impl<T: Copy + SdFrozen> SdSel<T> {
    pub fn tag(self: &SdSel<T>) -> u64 { return (self.x as u64) + 100u64; }
    pub fn bump(self: &mut SdSel<T>, d: u32) -> u64 {
        self.x = self.x + d;
        return self.tag();
    }
}

/// In-module instantiations of BOTH families.
pub fn sd_sel_probe() -> u64 {
    let mut f: SdSel<u64> = SdSel::<u64> { count: 0u32, x: 40u32 };
    let v: SdSel<i64> = SdSel::<i64> { hdr: 1000u64, cnt: 0u32, pad: 0u32 };
    return f.bump(2u32) + v.tag();    // 142 + 1000
}
