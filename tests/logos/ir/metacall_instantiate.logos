// IR snapshot: a metacall-emitted `instantiate Box<i64>;` must produce a
// concrete `Box$G1$i64` LLVM struct type and the trait method symbol
// `Box$G1$i64__weight` in IR. Locks MC2.4-base behavior at the IR level.

package main;

use std.compiler.metaprog;
use std.hermes.view;

trait BoxLike { fn weight(self: Self) -> i64; }

struct Box<T> { v: T }

impl BoxLike for Box<i64> {
    fn weight(self: Box<i64>) -> i64 { return self.v; }
}

fn emit_inst() -> QuoteItemBlob {
    return quote_item! {
        instantiate Box<i64>;
    };
}

metacall emit_inst();

unsafe fn main() -> i32 {
    let b: Box<i64> = Box::<i64> { v: 42i64 };
    return b.weight() as i32;
}
