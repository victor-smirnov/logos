; FileCheck spec for generic_id_mono.logos.
;
; Asserts:
;   1. main() exists and calls the mono'd `<pkg>$id__g__T__i64` symbol.
;   2. The mono'd specialization exists with i64 sig (no TypeVar leak).
;   3. There is no remaining generic template `<pkg>$id__g__T` (un-suffixed).
;
; B-mv-01: free-fn symbols are pkg-qualified — `main$id__g__T__i64` here.

; CHECK-LABEL: define i32 @main()
; CHECK: call i64 @"main$id__g__T__i64"(i64 42)
; CHECK: ret i32

; CHECK-LABEL: define i64 @"main$id__g__T__i64"(i64
; CHECK: ret i64

; CHECK-NOT: define {{.*}} @"main$id__g__T"(
