; FileCheck spec for main_trivial.logos.
;
; Asserts the IR contains exactly one user-defined function (main); no
; mono'd `__g__` specializations, no trait dispatch tables, no stdlib
; symbol leaks for an arithmetic-only program.

; CHECK-LABEL: define i32 @main()
; CHECK: add i64
; CHECK: trunc i64
; CHECK: ret i32

; CHECK-NOT: __g__
; CHECK-NOT: define {{.*}} @{{[A-Za-z_][A-Za-z0-9_]*}}__
