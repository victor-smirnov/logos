; FileCheck spec for metacall_instantiate.logos.
;
; Asserts mono honors a metacall-emitted `instantiate Box<i64>;`:
;   1. Mangled struct type `Box$G1$i64` appears as an LLVM type.
;   2. Trait method specialization `main.Box$G1$i64__weight` is defined.
;   3. main calls into that specialization.

; CHECK: %"main.Box{{(\$M[0-9a-f]{16})?}}$G1$i64" = type { i64 }
; CHECK: define {{.*}}i64 @"main.Box{{(\$M[0-9a-f]{16})?}}$G1$i64__weight__f__Box{{(\$M[0-9a-f]{16})?}}$G1$i64"
; CHECK-LABEL: define {{.*}}i32 @main()
; CHECK: call i64 @"main.Box{{(\$M[0-9a-f]{16})?}}$G1$i64__weight__f__Box{{(\$M[0-9a-f]{16})?}}$G1$i64"
