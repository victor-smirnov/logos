// IR snapshot for the FREEZE LATTICE — the five axes along which
// `type_is_freeze` (src/compiler/mlir_gen_types.cpp) either keeps recursing or
// stops, plus the unresolved-residue path that the whole soundness argument
// leans on.
//
// Rule: `type.shared-ref.write-through-derived-ub`. A shared `&T` earns
// `noalias`+`readonly` exactly when no UnsafeCell is reachable through the
// pointee's OWN INLINE BYTES. Each pair below moves ONE thing and holds
// everything else fixed, so a line that breaks names the axis that moved.
//
// WHY EACH AXIS IS HERE, and not just "more cases":
//   1. ARRAY ELEMENTS       — recursion must enter `[T; N]`. Its control
//      `&[i64;4]` has the IDENTICAL 32/8 layout, so if the pair moves between
//      them, element recursion is what changed and nothing else can be blamed.
//   2. DEPTH-2 NESTING      — one level of struct nesting is not enough to
//      prove the recursion is a fixpoint rather than a single peel.
//   3. A `*mut Cell` FIELD  — the recursion must STOP at an indirection, or
//      Rc/Arc (whose refcount lives behind a pointer they LOAD) would be
//      non-Freeze and the whole attribute would evaporate. This is the axis
//      that keeps the rule livable, and it is rustc parity.
//   4. GENERIC MONOMORPHISATION — the predicate is asked about the INSTANCE,
//      not the definition. Two instances of ONE generic must disagree.
//   5. ENUM PAYLOAD, COEXISTING — `Option<i64>` and `Option<Cell<i64>>` in one
//      program: the answer must be per-instance, not cached per enum name.
//   R. UNRESOLVED RESIDUE   — an HRTB binder leaves a bare TypeVar in the
//      signature. `layout_of` has no answer for a type with no instance, so
//      align/dereferenceable must be OMITTED (they are a layout claim), while
//      the aliasing facts are simply absent because the pointee is unknown.
//      This is the conservative-on-unknown direction: a missed case costs an
//      optimization, never soundness.
//
// EVERY EXPECTATION IN THE .check WAS DERIVED BY HAND FROM THE PREDICATE AND
// THE LAYOUTS FIRST, then confirmed against the emitted IR — not read off a
// run. All nine matched on the first comparison.
package param_attrs_freeze_lattice;

use logos.lang.cell;
use logos.lang.option;

// ── AXIS 1: array element recursion. Both pointees are 32 bytes, align 8. ───
fn axis_array_cell(a: &[Cell<i64>; 4]) -> i64 { return a[0].get(); }
fn axis_array_plain(a: &[i64; 4]) -> i64 { return a[0]; }

// ── AXIS 2: depth-2 struct nesting. ────────────────────────────────────────
struct Inner { c: Cell<i64> }
struct Outer { i: Inner, t: i64 }
fn axis_nested2(o: &Outer) -> i64 { return o.i.c.get() + o.t; }

// ── AXIS 3: a *mut Cell<i64> field. The pointee of the RAW pointer is not
//    part of PtrField's own inline bytes, so recursion stops and PtrField IS
//    Freeze — same reasoning that keeps Rc and Arc Freeze. ─────────────────
struct PtrField { p: *mut Cell<i64> }
fn axis_ptr_field(p: &PtrField) -> i64 { return 0i64; }

// ── AXIS 4: one generic, two monomorphisations. The concrete argument is a
//    trailing segment of the mangled name, so the two instances are
//    distinguishable in the IR and can be pinned separately. ───────────────
struct Box2<T> { v: T }
fn axis_generic<T>(b: &Box2<T>) -> i64 { return 0i64; }

// ── AXIS 5: two Option instances alive in ONE program. ─────────────────────
fn axis_opt_plain(o: &Option<i64>) -> i64 { return 0i64; }
fn axis_opt_cell(o: &Option<Cell<i64>>) -> i64 { return 0i64; }

// ── RESIDUE: the HRTB binder shape (mirrors tests/imported/pass/closures/
//    hrtb-nested-binder). `Id::call` keeps a bare TypeVar `&'a T` in its
//    signature; no instance of that type exists anywhere. ─────────────────
trait FnLike<A, R> { fn call(self: Self, a: A) -> R; }
struct Id { _x: i32 }
impl<'a, T> FnLike<&'a T, &'a T> for Id {
    fn call(self: Id, a: &'a T) -> &'a T { return a; }
}
fn run<F>(f: F) -> i32 where F: for<'a> FnLike<&'a i32, &'a i32> {
    let v: i32 = 7i32;
    let r: &i32 = f.call(&v);
    return *r - 7i32;
}

fn main() -> i32 {
    let ac: [Cell<i64>; 4] = [Cell::new(0i64), Cell::new(0i64),
                              Cell::new(0i64), Cell::new(0i64)];
    let ap: [i64; 4] = [0i64, 2i64, 3i64, 4i64];
    let o: Outer = Outer { i: Inner { c: Cell::new(0i64) }, t: 0i64 };
    let mut cc: Cell<i64> = Cell::new(3i64);
    let pf: PtrField = PtrField { p: &mut cc as *mut Cell<i64> };
    let bi: Box2<i64> = Box2 { v: 5i64 };
    let bc: Box2<Cell<i64>> = Box2 { v: Cell::new(6i64) };
    let oi: Option<i64> = Option::Some(7i64);
    let oc: Option<Cell<i64>> = Option::Some(Cell::new(8i64));

    let acc: i64 = axis_array_cell(&ac) + axis_array_plain(&ap) + axis_nested2(&o)
                 + axis_ptr_field(&pf) + axis_generic::<i64>(&bi)
                 + axis_generic::<Cell<i64>>(&bc)
                 + axis_opt_plain(&oi) + axis_opt_cell(&oc);
    if acc != 0i64 { return 1; }
    return run::<Id>(Id { _x: 0i32 });
}
