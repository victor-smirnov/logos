package mylib;

pub struct Point {
    pub x: i32,
    pub y: i32,
}

struct Secret {
    hidden: i32,
}

pub fn make_point(x: i32, y: i32) -> i32 {
    return x + y;
}

fn internal_helper(x: i32) -> i32 {
    return x * 2;
}

// T1-9 visibility fixtures: private vs pub enum / trait.
enum PrivEnum { PA, PB }

pub enum PubEnum { QA, QB }

trait PrivTrait { fn ph(&self) -> i32; }

pub trait PubTrait { fn qh(&self) -> i32; }

// §4 module system: `pub(module)` — visible to other packages in the SAME module
// (here package `mybridge`), but NOT to consumers of the mylib module.
pub(module) fn module_secret() -> i32 {
    return 99i32;
}

// §4.1b: a pub(module) STRUCT — usable within the mylib module, hidden from consumers.
pub(module) struct ModuleData {
    pub val: i32,
}

// Cross-module statics/consts: a consumer reading these exercises the
// imported-static read path (storage + init owned by the final exe, not mylib.a).
pub const MYLIB_CONST: i32 = 1234i32;
pub static MYLIB_STATIC: i32 = 5678i32;
pub static mut MYLIB_COUNTER: i32 = 0i32;

// Cross-module dynamic dispatch + generic-with-imported-bound: a consumer
// coercing an imported type to `&dyn ImportedTrait`, or instantiating a generic
// bounded by an imported trait, must resolve the imported method (vtable +
// find_func_op). Regressed silently under the type-coexistence symbol-qualifier.
pub struct Gadget { pub g: i32 }
pub trait Describe { fn describe(&self) -> i32; }
impl Describe for Gadget { fn describe(&self) -> i32 { return self.g; } }
