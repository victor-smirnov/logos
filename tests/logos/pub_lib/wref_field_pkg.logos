// Phase-1 generic-WritField mono fix — PACKAGE case (the one the single-CU
// tests/logos/pass/wql_wref_field_read.logos could NOT catch).
//
// This package READS a `WRef<S>` schema field but NEVER constructs a `WRef<S>`
// value. Built with `--emit-module` (a library archive), a CU that only reads a
// `WRef<S>` field emits a call to the generic `WRef<S>::from_wany` (which
// returns `Self = WRef<S>`) yet materializes no `WRef<S>` value, so mono used
// to never clone `WRef$G1$S`'s methods → mlir-gen "'func.call' op
// '…WRef$G1$S__from_wany__g__WAny' does not reference a valid function".
//
// CRUCIAL for the assertion: `UNode` is a fresh package-local schema enum, so
// `WRef$G1$UNode__from_wany` is pre-baked in NO stdlib archive — only mono's
// generic-struct-method instantiation (record_needed_struct at the concrete-
// rewrite site, mono_clone.cpp) can supply it. The edge is wired by writing the
// target node's raw WAny ref straight into the parent's map slot (NO WRef built).
package wref_field_pkg;

use logos.std.wql.ir;            // WRef<S> generic + schema machinery
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;

schema WFLeaf : code(0x0057_0000_0000_0000) { v: i56 = 0 }

schema enum WFNode : category(0x0057_0000_0000_0000) {
    L(WFLeaf),
}

// A schema with a `WRef<WFNode>` edge — `WRef$G1$WFNode__from_wany` exists in
// no archive.
schema WFHolder : code(0x0058_0000_0000_0000) { edge: WRef<WFNode> = 0 }

impl WFLeaf { fn as_ref(self: &WFLeaf) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }

// READ-ONLY consumer: reads the `WRef<WFNode>` field, binds the target view,
// constructs NO `WRef<WFNode>`.
fn wf_edge_val(hd: &WFHolder) -> i64 {
    let e: WRef<WFNode> = hd.edge;              // generic-WritField field read; targs=[WFNode]
    let node: WFNode = e.any().view::<WFNode>();
    match node {
        WFNode::L(l) => { return l.v; }
    }
}

// Self-contained entry (exported): build leaf + holder, wire the edge via a raw
// WAny slot (no `WRef<WFNode>` constructed), then READ the `WRef<WFNode>` field
// back. Returns the carried leaf value so a consumer can assert it.
pub fn wref_field_pkg_run(v: i56) -> i64 {
    let h: Writ = writ_new(512i64);
    let n: WFLeaf = h.make::<WFLeaf>();
    n.v = v;
    let leaf_word: i64 = n.as_ref().raw();
    let m: &mut WMap<Wu6, WAny> = h.tinymap(2i64);
    m.set_schema_type_code(0x0058_0000_0000_0000u64);   // WFHolder's code
    m.set(0u8, WAny::ref_to(leaf_word as *const u8));    // edge = key 0 (raw WAny)
    let hd: WFHolder = (&*m).view::<WFHolder>();
    return wf_edge_val(&hd);
}
