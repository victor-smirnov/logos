// cluster_divergence — the repair of arm_divergence, over the schema.
//
// ⚠ THE PEER GROUP WAS THE MISTAKE, NOT THE THRESHOLD. arm_divergence ranked by
// the fraction of ALL arms of a switch: max 0.55, nothing sharp, because twenty
// statement kinds have twenty jobs and nineteen owe P nothing. Against that
// denominator `check_live` is called by 6 of visit_stmt's ~22 live arms — 0.27,
// below any noise floor a cut-off could sit above. Tuning could never have
// reached it.
//
// The peers are the arms that SHARE a callee: they are doing the same kind of
// work, and the cluster supplies its own denominator, derived.
#include "cxx_schema.dl"
#include "lir_dispatch.dl"
#include "lir_questions.dl"
target_enum(E) :- decl(E, "Enum", "logos::compiler::lir_schema::stmt::Code").

.decl arm(f: symbol, k: symbol)
arm(F, K) :- tests(F, K, "case_live").

.decl cluster_size(f: symbol, q: symbol, n: number)
cluster_size(F, Q, N) :- arm_call(F, _, Q), ours(F), !structural(Q),
                         N = count : { arm_call(F, _K, Q) }, N >= 3.

.decl both(f: symbol, q: symbol, p: symbol, n: number)
both(F, Q, P, N) :- cluster_size(F, Q, _), arm_call(F, _, P), !structural(P), P != Q,
                    N = count : { arm_call(F, K, Q), arm_call(F, K, P) }.

// `both = size - 1` is not a tuned threshold; it is the definition of
// "everyone else in this cluster does it".
.decl odd_one_out(f: symbol, k: symbol, missing: symbol, cluster: symbol, size: number)
.output odd_one_out
odd_one_out(F, K, P, Q, N) :- cluster_size(F, Q, N), arm_call(F, K, Q),
                              !arm_call(F, K, P), both(F, Q, P, M), M = N - 1.
