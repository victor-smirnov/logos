// cxx_schema — the derived vocabulary every question is written against.
//
// Below this line nothing knows what a "place walker" is. These are the
// general shapes: ancestry, the enclosing named context, and what a node
// REFERS to. lir_facts.cpp had to be edited and rebuilt for each of them;
// here they are rules, and a new question is a new rule.
.decl node(id: symbol, kind: symbol, parent: symbol, index: number)
.decl type_of(id: symbol, tid: symbol)
.decl cast_kind(id: symbol, kind: symbol)
.decl loc(id: symbol, file: symbol, line: number, col: number)
.decl decl(did: symbol, kind: symbol, qname: symbol)
.decl decl_node(id: symbol, did: symbol)
.decl ref(use: symbol, did: symbol)
.decl call(callid: symbol, callee: symbol)
.decl enum_member(enumd: symbol, constd: symbol, name: symbol)
.decl decl_name(did: symbol, name: symbol)
.input node
.input type_of
.input cast_kind
.input loc
.input decl
.input decl_node
.input ref
.input call
.input enum_member
.input decl_name

// ── the enclosing named CONTEXT ─────────────────────────────────────────────
// ⚠ COMPUTED LINEARLY, NOT AS A TRANSITIVE CLOSURE OF `parent`. Full ancestry
// over 115610 nodes at a depth of tens is millions of tuples for a question
// that only ever asks for the NEAREST such ancestor. `ctx_of` walks up one
// level per rule application and stops at the first context, so it is O(nodes).
.decl context(id: symbol)
context(N) :- node(N, "Function", _, _).
context(N) :- node(N, "CXXMethod", _, _).
context(N) :- node(N, "LambdaExpr", _, _).

// ⚠ AN ANONYMOUS LAMBDA MUST NOT BREAK THE CHAIN. `each_elem([&](e){ … })`
// inside a switch arm is a LambdaExpr with no variable to be named for, and
// stopping there attributes the arm's calls to nothing — 398 of 1231 arm_call
// rows vanished that way on the first port. A context you cannot NAME is not a
// context anyone can ask about, so walk past it to the enclosing one, which is
// what the C++ version's scope stack did when the name came back empty.
.decl named_context(id: symbol)
named_context(N) :- context(N), ctx_name(N, _).

.decl ctx_of(n: symbol, c: symbol)
ctx_of(N, N)  :- named_context(N).
ctx_of(N, C)  :- node(N, _, P, _), P != "-", !named_context(N), ctx_of(P, C).

// A context's NAME. A function or method has a declaration and therefore a
// qualified name; a lambda has neither, and the name a reader means is the
// variable it is stored in — `try_path` is a std::function, not a function.
.decl ctx_name(c: symbol, name: symbol)
ctx_name(C, N) :- context(C), decl_node(C, D), decl_name(D, N).
ctx_name(C, N) :- node(C, "LambdaExpr", P, _), lambda_named(P, N).

// The lambda's variable, found by climbing past the implicit conversion nodes
// that wrap it. ⚠ THE ASSIGNMENT IS NOT THE IMMEDIATE PARENT: storing a lambda
// in a std::function inserts a CXXConstructExpr and a MaterializeTemporaryExpr,
// which is why a one-level lookup found nothing and `try_path` — the walker the
// whole tool exists to check — once contributed zero facts.
.decl lambda_named(n: symbol, name: symbol)
lambda_named(N, Name) :- node(N, "CXXOperatorCallExpr", _, _),
                         node(A, _, N, 1), ref(A, D), decl(D, "Var", _), decl_name(D, Name).
lambda_named(N, Name) :- node(N, "DeclRefExpr", _, _), ref(N, D),
                         decl(D, "Var", _), decl_name(D, Name).
// …and a lambda written straight into a VarDecl's INITIALISER, which is the
// other half of the same idiom: `std::function<…> f = [&]{…};` versus
// `std::function<…> f; f = [&]{…};`. Only the second is an assignment, and a
// rule that knew only about assignments lost `forms_borrow_at_call` — eleven
// rows, and the only rows the rewrite was missing.
// ⚠ THE FIX WAS ONE RULE. No extractor change, no rebuild, no new fact: the
// initialiser was already in the schema and the question had simply not asked.
// That is the difference this layer buys.
lambda_named(N, Name) :- node(N, "Var", _, _), decl_node(N, D), decl_name(D, Name).
lambda_named(N, Name) :- node(N, K, P, _), P != "-",
                         K != "CXXOperatorCallExpr", lambda_named(P, Name).

// The last `::`-separated component, so `logos::SemaChecker::try_path` reads as
// `try_path` and joins with everything else keyed on a bare name.


// ── seeing through the wrappers clang inserts ───────────────────────────────
// `case Code::X:` is CaseStmt -> ConstantExpr -> ImplicitCastExpr -> DeclRefExpr.
// A question that looks at the immediate child finds a ConstantExpr and reports
// nothing — which is exactly what happened on the first run of the rewrite:
// `cond` matched 95 of 102 and `case_live` matched 0 of 325, a silent shape
// mismatch that looks like a clean result.
.decl through(outer: symbol, inner: symbol)
through(N, N) :- node(N, _, _, _).
through(N, I) :- transparent(N), node(C, _, N, 0), through(C, I).

// ── TRANSPARENT: DERIVED PER NODE, not claimed per KIND ─────────────────────
// The previous version listed eight node kinds to see through — an enumeration,
// standing in the middle of the directory built to catch enumerations, and
// labelled as such because the derivable definition needed a `type_of` relation
// the extractor did not yet emit. It emits one now, so the list is REPLACED.
//
// A node is transparent when it has exactly ONE child and carries the SAME
// canonical type as that child: it renames a value without changing what the
// value is. That is a property of the NODE, which is strictly better than a
// property of its kind — an ImplicitCastExpr that changes the type is no longer
// swept in merely for being an ImplicitCastExpr.
.decl only_child(parent: symbol, child: symbol)
only_child(N, C) :- node(C, _, N, 0), !node(_, _, N, 1).

.decl transparent(n: symbol)
transparent(N) :- only_child(N, C), type_of(N, T), type_of(C, T).

// ⚠ AN "IntegralCast IS ALSO TRANSPARENT" RULE WAS WRITTEN HERE AND REMOVED.
// The reasoning was plausible — an enum constant in a `case` label could be
// promoted, giving node and child different canonical types while naming the
// same constant — and the bite test says it is worth nothing: removing it
// changes NOTHING on the control revision, both chains still agree, all 427
// rows stand. An unexercised rule with a good story is a comment pretending to
// be code. Left as this note so that if a future gap appears at a promoted enum
// comparison, the first place to look is written down.
// (`cast_kind` is still emitted; it costs nothing and the next question may
// have a use for it that this one did not.)

// ── the CFG, joined to the AST rather than parallel to it ───────────────────
// ⚠ lir_facts EMITTED cfg_call(fnName, block, calleeName) AS A FACT, and
// nothing could be joined to it: the graph named functions by string while
// every other relation named them by declaration. Here cfg_stmt points at the
// very node ids `call`, `ref` and `type_of` already talk about, so per-block
// ANYTHING is a join and needs no second extraction — calls today, and
// whatever the next question asks for without touching the extractor.
.decl cfg_block(fn: symbol, b: symbol)
.decl cfg_entry(fn: symbol, b: symbol)
.decl cfg_exit(fn: symbol, b: symbol)
.decl cfg_edge(fn: symbol, from: symbol, to: symbol)
.decl cfg_stmt(fn: symbol, b: symbol, n: symbol)
.input cfg_block
.input cfg_entry
.input cfg_exit
.input cfg_edge
.input cfg_stmt

.decl block_call(fn: symbol, b: symbol, callee: symbol)
block_call(F, B, P) :- cfg_stmt(F, B, N), call(N, P).

// Reachability that AVOIDS a given callee — the dominance question, and the one
// operation this whole directory exists for: transitive closure is what I
// approximate by sampling and stop early on.
.decl block_clean(fn: symbol, b: symbol, p: symbol)
block_clean(F, B, P) :- cfg_block(F, B), block_call(F, _, P), !block_call(F, B, P).

.decl avoids(fn: symbol, b: symbol, p: symbol)
avoids(F, B, P) :- cfg_entry(F, B), block_clean(F, B, P).
avoids(F, C, P) :- avoids(F, B, P), cfg_edge(F, B, C), block_clean(F, C, P).
