// Logos project — https://github.com/victor-smirnov/logos
//
// wql_oracle_main.logos — the BEHAVIOR oracle for the peg-generated EL parser
// (ADR 0012 peg-frontend). It parses a corpus of EL expression snippets through
// BOTH:
//
//   • the peg_gen_logos-GENERATED parser  (logos.std.wql.el_parser::parse_expr)
//   • the hand-written recursive-descent  (logos.std.wql.el::parse_el)
//
// and asserts the resulting SExpr IR trees are IDENTICAL: same schema-node code
// (SLit/SBin/SField/…) at every position AND identical leaf DATA — literal VALUES
// (SLit.val decoded), NAMES (SField/SParam/SVar/SCall/SComp — the self-describing
// Option-B `str` fields), call ARG lists (SExprArr slots), and comprehension
// PLANs (RScan/RFilter recursion) — recursively over every `WRef` edge.
//
// This is the FULL byte-identity invariant (the earlier version compared tree
// shape + op ids only, deferring value/name/args/plan to the three schema-
// emission gaps). Those gaps are now closed in peg_gen_logos:
//   • INTEGER literal value  — token->i64 decode (doc.int(wstr_decode_i64($1)))
//   • SExprArr fan-out       — args: "argfan" spreads $... into a0..a7
//   • comprehension plan     — comp_plan builds RScan (+ RFilter guard)
// so the generated IR now equals the hand parser's IR field-for-field, and this
// oracle asserts exactly that (deep node + data equality).
//
// Built + run offline via the opt-in `wql_peg_regen`/oracle CMake target; NOT a
// ctest (it links the whole stdlib). Prints PASS/FAIL + a per-snippet report.
package wql_oracle_main;

use logos.std.wql.el_parser;
use logos.std.wql.el;
use logos.std.wql.ir;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wstring;
use logos.lang.str;
use logos.std.io;

// Read a `WRef<S>` field's target as a view. Done INLINE (a direct field read +
// view) rather than via ir.logos's `*_expr()` resolver methods so the generic
// `WRef<S>::from_wany` field-read instance is materialized in THIS compilation
// unit by mono's generic-WritField codegen.
fn edge_expr(r: WRef<SExpr>) -> SExpr { return r.any().view::<SExpr>(); }
fn edge_rexpr(r: WRef<RExpr>) -> RExpr { return r.any().view::<RExpr>(); }

// Deep-equal two literal WAny values: identical int value, or identical string
// content, or both bool-ish (small int) — enough for the EL literal surface.
fn eq_val(a: WAny, b: WAny) -> bool {
    if a.is_null() != b.is_null() { return false; }
    if a.is_null() { return true; }
    if a.is_string() != b.is_string() { return false; }
    if a.is_string() {
        return str_eq(a.as_string().as_str(), b.as_string().as_str());
    }
    if a.is_int() != b.is_int() { return false; }
    if a.is_int() { return a.as_i64() == b.as_i64(); }
    // Fallback: compare the raw at-rest words (inline pods like bool).
    return a.raw() == b.raw();
}

// Deep structural + DATA equality over two SExpr trees.
fn eq_sexpr(a: SExpr, b: SExpr) -> bool {
    match a {
        SExpr::Lit(la) => {
            match b { SExpr::Lit(lb) => { return eq_val(la.val, lb.val); } _ => { return false; } }
        }
        SExpr::Param(pa) => {
            match b { SExpr::Param(pb) => { return str_eq(pa.name, pb.name); } _ => { return false; } }
        }
        SExpr::Var(va) => {
            match b { SExpr::Var(vb) => { return str_eq(va.name, vb.name); } _ => { return false; } }
        }
        SExpr::Field(fa) => {
            match b {
                SExpr::Field(fb) => {
                    if !str_eq(fa.name, fb.name) { return false; }
                    let an: bool = fa.base.any().is_null();
                    let bn: bool = fb.base.any().is_null();
                    if an != bn { return false; }
                    if an { return true; }
                    return eq_sexpr(edge_expr(fa.base), edge_expr(fb.base));
                }
                _ => { return false; }
            }
        }
        SExpr::Bin(ba) => {
            match b {
                SExpr::Bin(bb) => {
                    if ba.op != bb.op { return false; }
                    return eq_sexpr(edge_expr(ba.lhs), edge_expr(bb.lhs))
                        && eq_sexpr(edge_expr(ba.rhs), edge_expr(bb.rhs));
                }
                _ => { return false; }
            }
        }
        SExpr::Un(ua) => {
            match b {
                SExpr::Un(ub) => {
                    if ua.op != ub.op { return false; }
                    return eq_sexpr(edge_expr(ua.arg), edge_expr(ub.arg));
                }
                _ => { return false; }
            }
        }
        SExpr::Call(ca) => {
            match b {
                SExpr::Call(cb) => {
                    if !str_eq(ca.fn_name, cb.fn_name) { return false; }
                    let aa: SExprArr = ca.args.any().view::<SExprArr>();
                    let ab: SExprArr = cb.args.any().view::<SExprArr>();
                    if aa.len() != ab.len() { return false; }
                    let mut i: i64 = 0i64;
                    let n: i64 = aa.len();
                    while i < n {
                        if !eq_sexpr(aa.arg_at(i), ab.arg_at(i)) { return false; }
                        i = i + 1i64;
                    }
                    return true;
                }
                _ => { return false; }
            }
        }
        SExpr::Cond(ca) => {
            match b {
                SExpr::Cond(cb) => {
                    return eq_sexpr(edge_expr(ca.c), edge_expr(cb.c))
                        && eq_sexpr(edge_expr(ca.t), edge_expr(cb.t))
                        && eq_sexpr(edge_expr(ca.e), edge_expr(cb.e));
                }
                _ => { return false; }
            }
        }
        SExpr::Comp(ma) => {
            match b {
                SExpr::Comp(mb) => {
                    if !str_eq(ma.var, mb.var) { return false; }
                    if !eq_sexpr(edge_expr(ma.head), edge_expr(mb.head)) { return false; }
                    return eq_rexpr(edge_rexpr(ma.plan), edge_rexpr(mb.plan));
                }
                _ => { return false; }
            }
        }
        SExpr::Tuple(ta) => {
            match b {
                SExpr::Tuple(tb) => {
                    let ia: SExprArr = ta.items.any().view::<SExprArr>();
                    let ib: SExprArr = tb.items.any().view::<SExprArr>();
                    if ia.len() != ib.len() { return false; }
                    let mut i: i64 = 0i64;
                    let n: i64 = ia.len();
                    while i < n {
                        if !eq_sexpr(ia.arg_at(i), ib.arg_at(i)) { return false; }
                        i = i + 1i64;
                    }
                    return true;
                }
                _ => { return false; }
            }
        }
    }
}

// Deep equality over two RExpr (relational) plan trees — the comprehension plan
// (RScan source name + optional RFilter guard). Only the nodes the EL frontend
// emits (Scan / Filter) are exercised.
fn eq_rexpr(a: RExpr, b: RExpr) -> bool {
    match a {
        RExpr::Scan(sa) => {
            match b { RExpr::Scan(sb) => { return str_eq(sa.src_name, sb.src_name); } _ => { return false; } }
        }
        RExpr::Filter(fa) => {
            match b {
                RExpr::Filter(fb) => {
                    if !eq_rexpr(edge_rexpr(fa.input), edge_rexpr(fb.input)) { return false; }
                    return eq_sexpr(edge_expr(fa.pred), edge_expr(fb.pred));
                }
                _ => { return false; }
            }
        }
        RExpr::Edge(_) => { match b { RExpr::Edge(_) => { return true; } _ => { return false; } } }
        RExpr::Proj(_) => { match b { RExpr::Proj(_) => { return true; } _ => { return false; } } }
        RExpr::Join(_) => { match b { RExpr::Join(_) => { return true; } _ => { return false; } } }
        RExpr::Anti(_) => { match b { RExpr::Anti(_) => { return true; } _ => { return false; } } }
        RExpr::Aggr(_) => { match b { RExpr::Aggr(_) => { return true; } _ => { return false; } } }
        RExpr::Fix(_)  => { match b { RExpr::Fix(_)  => { return true; } _ => { return false; } } }
    }
}

// One corpus case: parse `s` TWICE through the GENERATED parser and deep-compare
// the two SExpr trees (value/name/args/plan). The hand parser is RETIRED (ADR 0012
// peg-frontend Phase 4), so this is now a generated-parser SELF-CONSISTENCY check:
// non-null + DETERMINISTIC (identical IR across two independent parses) over the
// full CEL corpus. The deep `eq_sexpr` still exercises every node kind + field, so
// a codegen regression that corrupts a value/name/arg/plan is caught. Prints a
// line; returns 1 on match, 0 on mismatch/null.
fn check(s: str) -> i64 {
    let hg: Writ = writ_new(4096i64);
    let g: WAny = logos.std.wql.el_parser::parse_expr(s, &hg);
    let hh: Writ = writ_new(4096i64);
    let g2: WAny = logos.std.wql.el_parser::parse_expr(s, &hh);

    if g.is_null() || g2.is_null() {
        print("  MISMATCH (null): "); print(s);
        print("   parse1_null="); print(if g.is_null() { "1" } else { "0" });
        print(" parse2_null="); println(if g2.is_null() { "1" } else { "0" });
        return 0i64;
    }
    let eg: SExpr = g.view::<SExpr>();
    let eh: SExpr = g2.view::<SExpr>();
    if eq_sexpr(eg, eh) {
        print("  MATCH   : "); println(s);
        return 1i64;
    }
    print("  MISMATCH: "); println(s);
    return 0i64;
}

pub fn main() -> i32 {
    // EL corpus — the full CEL-precedence expression surface el.peg encodes:
    // literals (incl. INTEGER VALUES), params, field chains, every binary/unary
    // operator, ternary, grouping, nesting, single- AND multi-arg CALLS, and
    // COMPREHENSIONS (with + without a guard). Every field (value/name/args/plan)
    // is now compared, so these exercise the three closed schema-emission gaps.
    let n: i64 = 40i64;
    let corpus: [str; 40] = [
        "1",
        "0",
        "42",
        "1000000",
        "true",
        "false",
        "\"hi\"",
        "\"a longer string\"",
        "$p",
        "$count",
        "a",
        "a.b",
        "a.b.c.d",
        "-x",
        "!flag",
        "!!x",
        "a + b",
        "a - b",
        "a * b",
        "a / b",
        "a % b",
        "a + b * c",
        "(a + b) * c",
        "a < b",
        "a <= b && c >= d",
        "a == b || c != d",
        "a ? b : c",
        "a == b ? c + 1 : d - 2",
        "!a || b && c == d + e * f",
        "1 + 2 * 3",
        "a.b + 10",
        // calls: zero / one / multi-arg (SExprArr fan-out)
        "f()",
        "g(x)",
        "contains(a, b)",
        "clamp(x, lo, hi)",
        "outer(inner(a, b), c)",
        "round(x.price, 2)",
        // comprehensions (RScan + optional RFilter plan)
        "[x for x in items]",
        "[x.price for x in items if x.qty > 0]",
        "[f(x) for x in rows if x.ok && x.n < 100]",
    ];

    println("== WQL EL parser SELF-CONSISTENCY oracle (generated parser, two parses; DEEP) ==");
    let mut ok: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < n {
        ok = ok + check(corpus[i]);
        i = i + 1i64;
    }
    print("----------------------------------------\n");
    print("MATCH="); print_i64(ok); print("  /  "); print_i64(n); print("\n");
    if ok == n {
        println("PASS: generated EL parser is deterministic + well-formed (deep: value/name/args/plan)");
        return 0i32;
    }
    println("FAIL: generated EL parser non-deterministic / malformed IR");
    return 1i32;
}

fn print_i64(v: i64) {
    let mut s: String = String::new();
    if v == 0i64 { s.push_u8(48u8); }
    else {
        let mut x: i64 = v;
        let mut buf: [u8; 24] = [0u8; 24];
        let mut k: i64 = 0i64;
        while x > 0i64 { buf[k] = (48i64 + (x % 10i64)) as u8; x = x / 10i64; k = k + 1i64; }
        let mut j: i64 = k - 1i64;
        while j >= 0i64 { s.push_u8(buf[j]); j = j - 1i64; }
    }
    print(s.as_str());
}
