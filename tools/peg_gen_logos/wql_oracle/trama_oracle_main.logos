// Logos project — https://github.com/victor-smirnov/logos
//
// trama_oracle_main.logos — the BEHAVIOR oracle for the peg-generated Trama
// template parser (ADR 0012 peg-frontend, Phase 3). It parses a corpus of Trama
// templates through BOTH:
//
//   • the peg_gen_logos-GENERATED parser  (logos.std.wql.trama_parser::parse_tpl)
//   • the hand-written recursive-descent  (logos.std.wql.trama::parse_trama)
//
// and asserts the resulting Trama-AST statement SEQUENCES are equal: same
// statement KIND at every position, same literal TEXT runs (T1 — the raw-until-
// delimiter text lexer), and — crucially — the EMBEDDED EL EXPRESSIONS are
// DEEP-EQUAL SExpr trees (T2 — the cross-grammar EL seam; each `{{ … }}` /
// `{% … %}` body is sub-parsed by the generated el_parser). Bodies of `for`/`if`
// recurse.
//
// SEQUENCE representation differs by design (T3 = handler post-pass): the hand
// parser returns a `next`-LINKED TStmt chain; the generated parser returns a
// WArray of TStmt handles (the `tpl <- stmt*` array). The oracle walks the hand
// chain via `next_stmt` and the generated array by index, in parallel — so it
// validates T1 + T2 (the generator's job) without asserting the `next`-linking /
// elif-desugaring that the wql!/trama! HANDLER stitches afterwards. The corpus
// therefore uses plain if/else (no elif — that desugaring is a handler pass).
//
// Built + run offline via the opt-in `trama_peg_oracle` CMake target; NOT a ctest
// (it links the whole stdlib). Prints PASS/FAIL + a per-template report.
package trama_oracle_main;

use logos.std.wql.trama_parser;
use logos.std.wql.trama;
use logos.std.wql.el;
use logos.std.wql.ir;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.array;
use logos.lang.writ.wstring;
use logos.lang.str;
use logos.std.io;

// ── SExpr deep equality (same as wql_oracle_main) ──────────────────────────
fn edge_expr(r: WRef<SExpr>) -> SExpr { return r.any().view::<SExpr>(); }
fn edge_rexpr(r: WRef<RExpr>) -> RExpr { return r.any().view::<RExpr>(); }

fn eq_val(a: WAny, b: WAny) -> bool {
    if a.is_null() != b.is_null() { return false; }
    if a.is_null() { return true; }
    if a.is_string() != b.is_string() { return false; }
    if a.is_string() { return str_eq(a.as_string().as_str(), b.as_string().as_str()); }
    if a.is_int() != b.is_int() { return false; }
    if a.is_int() { return a.as_i64() == b.as_i64(); }
    return a.raw() == b.raw();
}

fn eq_sexpr(a: SExpr, b: SExpr) -> bool {
    match a {
        SExpr::Lit(la) => { match b { SExpr::Lit(lb) => { return eq_val(la.val, lb.val); } _ => { return false; } } }
        SExpr::Param(pa) => { match b { SExpr::Param(pb) => { return str_eq(pa.name, pb.name); } _ => { return false; } } }
        SExpr::Var(va) => { match b { SExpr::Var(vb) => { return str_eq(va.name, vb.name); } _ => { return false; } } }
        SExpr::Field(fa) => {
            match b {
                SExpr::Field(fb) => {
                    if !str_eq(fa.name, fb.name) { return false; }
                    let an: bool = fa.base.any().is_null();
                    let bn: bool = fb.base.any().is_null();
                    if an != bn { return false; }
                    if an { return true; }
                    return eq_sexpr(edge_expr(fa.base), edge_expr(fb.base));
                }
                _ => { return false; }
            }
        }
        SExpr::Bin(ba) => {
            match b {
                SExpr::Bin(bb) => {
                    if ba.op != bb.op { return false; }
                    return eq_sexpr(edge_expr(ba.lhs), edge_expr(bb.lhs)) && eq_sexpr(edge_expr(ba.rhs), edge_expr(bb.rhs));
                }
                _ => { return false; }
            }
        }
        SExpr::Un(ua) => {
            match b {
                SExpr::Un(ub) => { if ua.op != ub.op { return false; } return eq_sexpr(edge_expr(ua.arg), edge_expr(ub.arg)); }
                _ => { return false; }
            }
        }
        SExpr::Call(ca) => {
            match b {
                SExpr::Call(cb) => {
                    if !str_eq(ca.fn_name, cb.fn_name) { return false; }
                    let aa: SExprArr = ca.args.any().view::<SExprArr>();
                    let ab: SExprArr = cb.args.any().view::<SExprArr>();
                    if aa.len() != ab.len() { return false; }
                    let mut i: i64 = 0i64; let n: i64 = aa.len();
                    while i < n { if !eq_sexpr(aa.arg_at(i), ab.arg_at(i)) { return false; } i = i + 1i64; }
                    return true;
                }
                _ => { return false; }
            }
        }
        SExpr::Cond(ca) => {
            match b {
                SExpr::Cond(cb) => {
                    return eq_sexpr(edge_expr(ca.c), edge_expr(cb.c)) && eq_sexpr(edge_expr(ca.t), edge_expr(cb.t)) && eq_sexpr(edge_expr(ca.e), edge_expr(cb.e));
                }
                _ => { return false; }
            }
        }
        SExpr::Comp(ma) => {
            match b {
                SExpr::Comp(mb) => {
                    if !str_eq(ma.var, mb.var) { return false; }
                    if !eq_sexpr(edge_expr(ma.head), edge_expr(mb.head)) { return false; }
                    return eq_rexpr(edge_rexpr(ma.plan), edge_rexpr(mb.plan));
                }
                _ => { return false; }
            }
        }
    }
}

fn eq_rexpr(a: RExpr, b: RExpr) -> bool {
    match a {
        RExpr::Scan(sa) => { match b { RExpr::Scan(sb) => { return str_eq(sa.src_name, sb.src_name); } _ => { return false; } } }
        RExpr::Filter(fa) => {
            match b {
                RExpr::Filter(fb) => {
                    if !eq_rexpr(edge_rexpr(fa.input), edge_rexpr(fb.input)) { return false; }
                    return eq_sexpr(edge_expr(fa.pred), edge_expr(fb.pred));
                }
                _ => { return false; }
            }
        }
        RExpr::Edge(_) => { match b { RExpr::Edge(_) => { return true; } _ => { return false; } } }
        RExpr::Proj(_) => { match b { RExpr::Proj(_) => { return true; } _ => { return false; } } }
        RExpr::Join(_) => { match b { RExpr::Join(_) => { return true; } _ => { return false; } } }
        RExpr::Anti(_) => { match b { RExpr::Anti(_) => { return true; } _ => { return false; } } }
        RExpr::Aggr(_) => { match b { RExpr::Aggr(_) => { return true; } _ => { return false; } } }
        RExpr::Fix(_)  => { match b { RExpr::Fix(_)  => { return true; } _ => { return false; } } }
    }
}

// ── Statement-sequence walkers ─────────────────────────────────────────────
// HAND side: a `next`-linked TStmt chain — collect its handles into a Vec-like
// fixed array. GEN side: a WArray of TStmt handles. Both flatten to an ordered
// list of statement handles (WAny), then compared element-for-element.

struct HandleList { pub items: [WAny; 256], pub n: i64 }

fn hl_new() -> HandleList {
    return HandleList { items: [WAny::from(0i56); 256], n: 0i64 };
}
fn hl_push(l: &mut HandleList, h: WAny) { if l.n < 256i64 { l.items[l.n] = h; l.n = l.n + 1i64; } }

// Flatten a generated WArray of TStmt handles into ordered handles.
fn flatten_gen(arr: &WArray<WAny>) -> HandleList {
    let mut l: HandleList = hl_new();
    let mut i: i64 = 0i64;
    while i < arr.len() { hl_push(&mut l, arr.get(i)); i = i + 1i64; }
    return l;
}

// Deep-compare one hand statement handle vs one generated statement handle.
fn eq_stmt(hh: WAny, gh: WAny) -> bool {
    if hh.is_null() != gh.is_null() { return false; }
    if hh.is_null() { return true; }
    let hs: TStmt = hh.view::<TStmt>();
    let gs: TStmt = gh.view::<TStmt>();
    match hs {
        TStmt::Text(ht) => {
            match gs {
                TStmt::Text(gt) => { return eq_val(ht.text, gt.text); }
                _ => { return false; }
            }
        }
        TStmt::Var(hv) => {
            match gs {
                TStmt::Var(gv) => { return eq_sexpr(edge_expr(hv.expr), edge_expr(gv.expr)); }
                _ => { return false; }
            }
        }
        TStmt::Set(hset) => {
            match gs {
                TStmt::Set(gset) => {
                    if !str_eq(hset.var, gset.var) { return false; }
                    return eq_sexpr(edge_expr(hset.expr), edge_expr(gset.expr));
                }
                _ => { return false; }
            }
        }
        TStmt::For(hf) => {
            match gs {
                TStmt::For(gf) => {
                    if !str_eq(hf.var, gf.var) { return false; }
                    if !eq_sexpr(edge_expr(hf.expr), edge_expr(gf.expr)) { return false; }
                    return eq_body(hf.body, gf.body);
                }
                _ => { return false; }
            }
        }
        TStmt::If(hi) => {
            match gs {
                TStmt::If(gi) => {
                    if !eq_sexpr(edge_expr(hi.expr), edge_expr(gi.expr)) { return false; }
                    if !eq_body(hi.body, gi.body) { return false; }
                    return eq_body(hi.alt, gi.alt);
                }
                _ => { return false; }
            }
        }
    }
}

// Compare two GENERATED body/alt edges (each a WArray handle, or null). A
// grammar-desugared elif produces a single TIf node rather than a WArray; both
// parses produce the same shape, so a non-array edge is compared 1:1. Recurses
// via eq_list.
fn eq_body(hedge: WRef<TStmt>, gedge: WRef<TStmt>) -> bool {
    let ha: WAny = hedge.any();
    let ga: WAny = gedge.any();
    if ha.is_null() != ga.is_null() { return false; }
    if ha.is_null() { return true; }
    if ha.is_array() != ga.is_array() { return false; }
    if !ha.is_array() {
        // A single node (grammar-desugared elif TIf) on both sides — compare 1:1.
        return eq_stmt(ha, ga);
    }
    let har: &WArray<WAny> = ha.as_array();
    let gar: &WArray<WAny> = ga.as_array();
    let hl: HandleList = flatten_gen(har);
    let gl: HandleList = flatten_gen(gar);
    return eq_list(&hl, &gl);
}

fn eq_list(hl: &HandleList, gl: &HandleList) -> bool {
    if hl.n != gl.n { return false; }
    let mut i: i64 = 0i64;
    while i < hl.n {
        if !eq_stmt(hl.items[i], gl.items[i]) { return false; }
        i = i + 1i64;
    }
    return true;
}

// One corpus case: parse `t` TWICE through the GENERATED parser, deep-compare the
// statement sequences (kinds + embedded EL + for/if bodies). The hand parser is
// RETIRED (ADR 0012 peg-frontend Phase 4), so this is a generated-parser SELF-
// CONSISTENCY check: non-null WArray + DETERMINISTIC IR across two independent
// parses. The deep `eq_body` recursion still exercises every statement family,
// text run, and embedded SExpr, so a codegen regression is caught.
fn check(t: str) -> i64 {
    let hh: Writ = writ_new(65536i64);
    let gen1: WAny = logos.std.wql.trama_parser::parse_tpl(t, &hh);
    let hg: Writ = writ_new(65536i64);
    let gen: WAny = logos.std.wql.trama_parser::parse_tpl(t, &hg);

    if gen.is_null() || gen1.is_null() {
        print("  MISMATCH (gen null): "); println(t);
        return 0i64;
    }
    if !gen.is_array() || !gen1.is_array() {
        print("  MISMATCH (gen not array): "); println(t);
        return 0i64;
    }
    let gar: &WArray<WAny> = gen.as_array();
    let gar1: &WArray<WAny> = gen1.as_array();
    let hl: HandleList = flatten_gen(gar1);
    let gl: HandleList = flatten_gen(gar);
    if eq_list(&hl, &gl) {
        print("  MATCH   : "); println(t);
        return 1i64;
    }
    print("  MISMATCH: "); println(t);
    print("    parse1_stmts="); print_i64(hl.n); print(" parse2_stmts="); print_i64(gl.n); print("\n");
    return 0i64;
}

pub fn main() -> i32 {
    // Trama corpus — the template surface trama.peg encodes: literal text runs
    // (incl. bare `{` in text, ws, newlines — T1), {{ expr }} with the FULL EL
    // expression surface embedded (T2), {% if/for/set %} control tags, if/else,
    // if/elif/else (grammar-desugared to nested TIf), whitespace-control trims.
    let n: i64 = 24i64;
    let corpus: [str; 24] = [
        "hello world",
        "a {{ x }} b",
        "{{ name }}",
        "line1\nline2\n{{ v }}",
        "text with a bare { brace",
        "{{ x.y.z }}",
        "{{ a + b * c }}",
        "{{ (a + b) * c }}",
        "{{ f(x, y) }}",
        "{{ $p }}",
        "{{ a == b ? c : d }}",
        "pre {{ price }} mid {{ qty }} post",
        "{% set z = a + 1 %}",
        "{% if active %}ON{% endif %}",
        "{% if active %}ON{% else %}OFF{% endif %}",
        "{% for i in items %}[{{ i }}]{% endfor %}",
        "{% for row in rows %}{{ row.name }}={{ row.val }}{% endfor %}",
        "head{% if a %}x{% if b %}y{% endif %}z{% endif %}tail",
        "{{- trimmed -}}",
        "{%- if a -%}t{%- endif -%}",
        "{% if x.n > 0 %}pos{% else %}neg{% endif %}",
        "{% for e in [x for x in items if x.ok] %}{{ e }}{% endfor %}",
        "{% if s >= 90 %}A{% elif s >= 70 %}B{% else %}C{% endif %}",
        "{% if a %}x{% elif b %}y{% elif c %}z{% endif %}",
    ];

    println("== Trama parser SELF-CONSISTENCY oracle (generated parser, two parses) ==");
    let mut ok: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < n {
        ok = ok + check(corpus[i]);
        i = i + 1i64;
    }
    print("----------------------------------------\n");
    print("MATCH="); print_i64(ok); print("  /  "); print_i64(n); print("\n");
    if ok == n {
        println("PASS: generated Trama parser is deterministic + well-formed (text + embedded EL + elif)");
        return 0i32;
    }
    println("FAIL: generated Trama parser non-deterministic / malformed IR");
    return 1i32;
}

fn print_i64(v: i64) {
    let mut s: String = String::new();
    if v == 0i64 { s.push_u8(48u8); }
    else {
        let mut x: i64 = v;
        let mut buf: [u8; 24] = [0u8; 24];
        let mut k: i64 = 0i64;
        while x > 0i64 { buf[k] = (48i64 + (x % 10i64)) as u8; x = x / 10i64; k = k + 1i64; }
        let mut j: i64 = k - 1i64;
        while j >= 0i64 { s.push_u8(buf[j]); j = j - 1i64; }
    }
    print(s.as_str());
}
