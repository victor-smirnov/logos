// SPDX-License-Identifier: Apache-2.0
// lforge — Logos build system.
//
// CLI:
//   lforge build [--release]   — compile project rooted at cwd
//   lforge run [--release] [-- args]
//                              — build + exec the bin target (single-bin
//                                projects only; for multi-bin use a binary
//                                directly out of .lforge/<profile>/out/)
//   lforge clean               — rm -rf .lforge/
//
// Manifest (Hermes-SDN, ./lforge.hermes):
//
//   {
//     name:    "my-project",
//     version: "0.1.0",
//     targets: [
//       { kind: "lib", name: "core", src: "src/core" },
//       { kind: "bin", name: "app",  src: "src", entry: "main",
//         deps: ["core"] }
//     ]
//   }
//
// Backwards-compat: if `targets` is absent, the top-level `src` + `entry`
// fields synthesize a single bin target named after the project. This is
// the schema B0.5 shipped with.
//
// Targets:
//   bin: compiles <src>/<entry>.logos through logosc, then links the .o
//        with sibling-lib .a archives + system stdlib via cc.
//   lib: writes a generated module manifest, invokes
//        `logosc --emit-module` to produce a .a archive.
//
// Library deps are sibling targets in the same project; they're built
// first via topological sort and added to downstream link/compile lines.
//
// Output layout (per profile):
//   .lforge/<profile>/_gen/<lib>.module     generated lib manifest
//   .lforge/<profile>/out/<bin>             linked bin executable
//   .lforge/<profile>/out/<bin>.o           bin object file
//   .lforge/<profile>/out/lib<lib>.a        lib archive
//
// Today: full rebuild every invocation; CAS scaffolding (B0.4) is in
// stdlib but not yet hooked. B1.2 wires it.

package lforge_main;

use std.hermes.zone;
use std.hermes.anyval;
use std.hermes.view;
use std.hermes.string;
use std.hermes.typetag;
use std.hermes.array;
use std.hermes.map;
use std.hermes.typed_value;
use std.hermes.objectmap;
use std.hermes.document;
use std.hermes.parser;
use std.io.fs;
use std.io.fs.path;
use std.lang.text;
use std.lang.option;
use std.lang.result;
use std.lang.iter;
use std.collections.vec;
use std.sys.process;
use std.sys.args;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;
extern fn getenv(name: *const u8) -> *const u8;
extern fn execv(path: *const u8, argv: *const *const u8) -> i32;

// ── Schema ────────────────────────────────────────────────────────────────

pub enum TargetKind { Bin, Lib }

pub struct Target {
    pub kind:  TargetKind,
    pub name:  String,
    pub src:   String,
    pub entry: String,           // empty for lib targets
    pub deps:  Vec<String>,      // names of sibling lib targets
}

pub struct Manifest {
    pub name:    String,
    pub version: String,
    pub targets: Vec<Target>,
}

pub struct ManifestError {
    pub message: String,
}

// ── String helpers ────────────────────────────────────────────────────────

unsafe fn cstr(s: str) -> *mut u8 {
    let n: i64 = s.len();
    let h: *mut u8 = alloc(n + 1 as i64);
    let mut i: i64 = 0 as i64;
    while i < n { h[i] = s.as_ptr()[i]; i = i + 1 as i64; }
    h[n] = 0 as u8;
    return h;
}

fn str_eq_local(a: str, b: str) -> bool {
    if a.len() != b.len() { return false; }
    return str_starts_with(a, b);
}

unsafe fn err_msg(msg: str) -> ManifestError {
    let mut s: String = String::new();
    s.push_str(msg);
    return ManifestError { message: s };
}

unsafe fn err_msg2(a: str, b: str) -> ManifestError {
    let mut s: String = String::new();
    s.push_str(a);
    s.push_str(b);
    return ManifestError { message: s };
}

unsafe fn print_str(fd: i32, s: str) {
    write(fd, s.as_ptr(), s.len());
}

unsafe fn println_str(fd: i32, s: str) {
    print_str(fd, s);
    let nl: u8 = 10 as u8;
    write(fd, &nl as *const u8, 1 as i64);
}

unsafe fn println_string(fd: i32, s: &String) {
    write(fd, s.as_ptr(), s.len());
    let nl: u8 = 10 as u8;
    write(fd, &nl as *const u8, 1 as i64);
}

// Append `<base>/<rest>` semantics into an existing String.
unsafe fn append_path(base: &mut String, rest: str) {
    let n: i64 = base.len();
    if n > 0 as i64 && (base.as_ptr()[n - 1 as i64] as i32) != 47 {
        base.push_u8(47 as u8);
    }
    base.push_str(rest);
}

// ── Hermes helpers ────────────────────────────────────────────────────────

unsafe fn read_str_field(view: &HermesView<'a>, root: AnyVal, key: str) -> Result<String, ManifestError> {
    let v: AnyVal = view.map_get(root, key);
    if v.is_null() {
        return Result::Err(err_msg2("manifest: missing required field ", key));
    }
    if !v.is_string(view.base()) {
        return Result::Err(err_msg2("manifest: not a string: ", key));
    }
    let sv: StringView = view.get_str_view(v);
    let mut out: String = String::new();
    out.push_bytes(sv.ptr, sv.len as i64);
    return Result::Ok(out);
}

// Read an optional string field — returns empty String if absent.
unsafe fn read_str_opt(view: &HermesView<'a>, root: AnyVal, key: str) -> String {
    let mut out: String = String::new();
    let v: AnyVal = view.map_get(root, key);
    if !v.is_null() && v.is_string(view.base()) {
        let sv: StringView = view.get_str_view(v);
        out.push_bytes(sv.ptr, sv.len as i64);
    }
    return out;
}

// Read an array of strings (e.g. `deps: ["a", "b"]`). Returns empty Vec if
// absent or wrong type.
unsafe fn read_str_array(view: &HermesView<'a>, root: AnyVal, key: str) -> Vec<String> {
    let mut out: Vec<String> = vec_new::<String>();
    let v: AnyVal = view.map_get(root, key);
    let base: *const u8 = view.base();
    if !v.is_null() && v.is_array(base) {
        let n: u64 = view.array_len(v);
        let outp: *mut Vec<String> = (&mut out) as *mut Vec<String>;
        let mut i: u64 = 0 as u64;
        while i < n {
            let elem: AnyVal = view.array_get(v, i);
            if elem.is_string(base) {
                let sv: StringView = view.get_str_view(elem);
                let mut s: String = String::new();
                s.push_bytes(sv.ptr, sv.len as i64);
                outp.push(s);
            }
            i = i + 1 as u64;
        }
    }
    return out;
}

// ── Manifest parser ──────────────────────────────────────────────────────

unsafe fn parse_target(view: &HermesView<'a>, base: *const u8, t_av: AnyVal) -> Result<Target, ManifestError> {
    if !t_av.is_map(base) {
        return Result::Err(err_msg("manifest: targets[] entry is not a map"));
    }
    let kind_s: String = match read_str_field(view, t_av, "kind") {
        Result::Err(e) => { return Result::Err(e); }
        Result::Ok(s)  => { s }
    };
    let mut k: TargetKind = TargetKind::Bin;
    let kv: str = str_from_raw(kind_s.as_ptr(), kind_s.len());
    if str_eq_local(kv, "lib") {
        k = TargetKind::Lib;
    } else if !str_eq_local(kv, "bin") {
        return Result::Err(err_msg2("manifest: target.kind must be 'bin' or 'lib', got ", kv));
    }
    let name_s: String = match read_str_field(view, t_av, "name") {
        Result::Err(e) => { return Result::Err(e); }
        Result::Ok(s)  => { s }
    };
    let src_s: String = match read_str_field(view, t_av, "src") {
        Result::Err(e) => { return Result::Err(e); }
        Result::Ok(s)  => { s }
    };
    let entry_s: String = read_str_opt(view, t_av, "entry");
    let deps_v: Vec<String> = read_str_array(view, t_av, "deps");
    return Result::Ok(Target {
        kind:  k,
        name:  name_s,
        src:   src_s,
        entry: entry_s,
        deps:  deps_v,
    });
}

pub unsafe fn parse_manifest(text: str) -> Result<Manifest, ManifestError> {
    let mut z: Zone<Mutable> = zone_create(8192);
    if !hermes_parse(text.as_ptr(), text.len(), &mut z) {
        return Result::Err(err_msg("manifest: SDN parse failed"));
    }
    let view: HermesView<'a> = HermesView {
        base: z.holder.base as *const u8,
        size: z.holder.used as u64,
    };
    let root: AnyVal = view.root();
    let base: *const u8 = view.base();
    if !root.is_map(base) {
        return Result::Err(err_msg("manifest: top-level value must be a map"));
    }

    // Required: name + version.
    let name_s: String = match read_str_field(&view, root, "name") {
        Result::Err(e) => { return Result::Err(e); }
        Result::Ok(s)  => { s }
    };
    let version_s: String = match read_str_field(&view, root, "version") {
        Result::Err(e) => { return Result::Err(e); }
        Result::Ok(s)  => { s }
    };

    // Targets: prefer explicit targets[]; fall back to legacy {src, entry}.
    let mut targets: Vec<Target> = vec_new::<Target>();
    let tp: *mut Vec<Target> = (&mut targets) as *mut Vec<Target>;
    let targets_av: AnyVal = view.map_get(root, "targets");
    let mut have_legacy: bool = false;
    if targets_av.is_array(base) {
        let n: u64 = view.array_len(targets_av);
        let mut i: u64 = 0 as u64;
        while i < n {
            let t_av: AnyVal = view.array_get(targets_av, i);
            match parse_target(&view, base, t_av) {
                Result::Err(e) => { return Result::Err(e); }
                Result::Ok(t)  => { tp.push(t); }
            }
            i = i + 1 as u64;
        }
    } else {
        // Legacy schema: synthesize one bin target.
        have_legacy = true;
        let src_s: String = match read_str_field(&view, root, "src") {
            Result::Err(e) => { return Result::Err(e); }
            Result::Ok(s)  => { s }
        };
        let entry_s: String = match read_str_field(&view, root, "entry") {
            Result::Err(e) => { return Result::Err(e); }
            Result::Ok(s)  => { s }
        };
        let mut nm: String = String::new();
        nm.push_bytes(name_s.as_ptr(), name_s.len());
        let synth: Target = Target {
            kind:  TargetKind::Bin,
            name:  nm,
            src:   src_s,
            entry: entry_s,
            deps:  vec_new::<String>(),
        };
        tp.push(synth);
    }

    if targets.length() == 0 as i64 {
        return Result::Err(err_msg("manifest: no targets"));
    }

    return Result::Ok(Manifest {
        name:    name_s,
        version: version_s,
        targets: targets,
    });
}

unsafe fn read_manifest(p: str) -> Result<Manifest, ManifestError> {
    let cs: *mut u8 = cstr(p);
    let body: Result<String, i32> = read_to_string(cs as *const u8);
    dealloc(cs);
    match body {
        Result::Err(_) => { return Result::Err(err_msg("lforge.hermes: cannot read")); }
        Result::Ok(s)  => {
            let view: str = str_from_raw(s.as_ptr(), s.len());
            return parse_manifest(view);
        }
    }
}

// ── Topological sort of targets by deps ───────────────────────────────────

// Returns an order of indices into `targets` such that for any i in the
// order, all of targets[i].deps appear before i. Errors out on cycles or
// unknown dep names.
unsafe fn topo_order(targets: &Vec<Target>) -> Result<Vec<i64>, ManifestError> {
    let n: i64 = targets.length();
    let tp: *const Vec<Target> = targets as *const Vec<Target>;

    // state: 0 = unvisited, 1 = visiting (on stack), 2 = done.
    let state: *mut u8 = alloc(n);
    let mut s_init: i64 = 0 as i64;
    while s_init < n { state[s_init] = 0 as u8; s_init = s_init + 1 as i64; }

    let mut order: Vec<i64> = vec_new::<i64>();
    let order_p: *mut Vec<i64> = (&mut order) as *mut Vec<i64>;

    // Recursion helper. Returns Err on cycle / unknown.
    let mut err_buf: String = String::new();
    let mut have_err: bool = false;
    // Iterative DFS using an explicit stack of (target_idx, dep_cursor).
    let mut work_idx: *mut i64 = alloc(n * 8 as i64) as *mut i64;
    let mut work_cur: *mut i64 = alloc(n * 8 as i64) as *mut i64;
    let mut top: i64 = 0 as i64;

    let mut start: i64 = 0 as i64;
    while start < n && !have_err {
        if state[start] != 0 as u8 {
            start = start + 1 as i64;
            continue;
        }
        work_idx[top] = start;
        work_cur[top] = 0 as i64;
        state[start] = 1 as u8;
        top = top + 1 as i64;
        while top > 0 as i64 && !have_err {
            let cur: i64 = work_idx[top - 1 as i64];
            let cur_dep: i64 = work_cur[top - 1 as i64];
            let t: *const Target = tp.at_const(cur);
            let dn: i64 = (*t).deps.length();
            if cur_dep < dn {
                let dp: *const Vec<String> = (&(*t).deps) as *const Vec<String>;
                let dnm: *const String = dp.at_const(cur_dep);
                let dnms: str = str_from_raw((*dnm).as_ptr(), (*dnm).len());
                // Inline resolve dep name → target index.
                let mut didx: i64 = 0 as i64 - 1 as i64;
                let mut ri: i64 = 0 as i64;
                while ri < n {
                    let rt: *const Target = tp.at_const(ri);
                    let rtnm: str = str_from_raw((*rt).name.as_ptr(), (*rt).name.len());
                    if str_eq_local(rtnm, dnms) { didx = ri; ri = n; }
                    else { ri = ri + 1 as i64; }
                }
                work_cur[top - 1 as i64] = cur_dep + 1 as i64;
                if didx < 0 as i64 {
                    have_err = true;
                    err_buf.push_str("manifest: unknown dep '");
                    err_buf.push_bytes((*dnm).as_ptr(), (*dnm).len());
                    err_buf.push_str("'");
                } else if state[didx] == 1 as u8 {
                    have_err = true;
                    err_buf.push_str("manifest: dependency cycle involving '");
                    err_buf.push_bytes((*t).name.as_ptr(), (*t).name.len());
                    err_buf.push_str("'");
                } else if state[didx] == 0 as u8 {
                    work_idx[top] = didx;
                    work_cur[top] = 0 as i64;
                    state[didx] = 1 as u8;
                    top = top + 1 as i64;
                }
            } else {
                state[cur] = 2 as u8;
                order_p.push(cur);
                top = top - 1 as i64;
            }
        }
        start = start + 1 as i64;
    }

    dealloc(state);
    dealloc(work_idx as *mut u8);
    dealloc(work_cur as *mut u8);
    if have_err {
        return Result::Err(ManifestError { message: err_buf });
    }
    return Result::Ok(order);
}

// ── Tool resolution ───────────────────────────────────────────────────────

unsafe fn resolve_logos_lib_dir() -> String {
    let env_key: *mut u8 = cstr("LOGOS_LIB_DIR");
    let env_val: *const u8 = getenv(env_key as *const u8);
    dealloc(env_key);
    if env_val != 0 as *const u8 {
        let s: str = str_from_cstr(env_val);
        let mut out: String = String::new();
        out.push_str(s);
        return out;
    }
    let candidates: [str; 2] = ["./build/lib/logos", "/usr/local/lib/logos"];
    let mut i: i64 = 0 as i64;
    while i < 2 as i64 {
        let c: str = candidates[i];
        let cs: *mut u8 = cstr(c);
        let ok: bool = is_dir(cs as *const u8);
        dealloc(cs);
        if ok {
            let mut out: String = String::new();
            out.push_str(c);
            return out;
        }
        i = i + 1 as i64;
    }
    return String::new();
}

unsafe fn resolve_logosc_path() -> String {
    let env_key: *mut u8 = cstr("LOGOSC");
    let env_val: *const u8 = getenv(env_key as *const u8);
    dealloc(env_key);
    if env_val != 0 as *const u8 {
        let s: str = str_from_cstr(env_val);
        let mut out: String = String::new();
        out.push_str(s);
        return out;
    }
    let cs: *mut u8 = cstr("./build/bin/logosc");
    let ok: bool = is_file(cs as *const u8);
    dealloc(cs);
    let mut out: String = String::new();
    if ok { out.push_str("./build/bin/logosc"); }
    else  { out.push_str("logosc"); }
    return out;
}

// ── Process orchestration ─────────────────────────────────────────────────

unsafe fn push_arg(args: *mut Vec<String>, s: str) {
    let mut a: String = String::new();
    a.push_str(s);
    args.push(a);
}

unsafe fn push_string_arg(args: *mut Vec<String>, s: &String) {
    let mut a: String = String::new();
    a.push_bytes(s.as_ptr(), s.len());
    args.push(a);
}

unsafe fn run_child(argv_strs: &Vec<String>) -> i32 {
    let n: i64 = argv_strs.length();
    let argv_buf: *mut *const u8 = alloc((n + 1 as i64) * 8 as i64) as *mut *const u8;
    let mut i: i64 = 0 as i64;
    let ap: *const Vec<String> = argv_strs as *const Vec<String>;
    while i < n {
        let s: *const String = ap.at_const(i);
        argv_buf[i] = (*s).as_ptr();
        i = i + 1 as i64;
    }
    argv_buf[n] = 0 as *const u8;

    let mut child: Child = spawn(argv_buf as *const *const u8, false, true, true);
    if child.pid() < 0 {
        dealloc(argv_buf as *mut u8);
        return 0 - 1;
    }

    let mut lr_out: LineReader = child.stdout_lines();
    loop {
        match lr_out.next() {
            Option::Some(line) => { println_str(1, str_from_raw(line.as_ptr(), line.len())); }
            Option::None       => { break; }
        }
    }
    let mut lr_err: LineReader = child.stderr_lines();
    loop {
        match lr_err.next() {
            Option::Some(line) => { println_str(2, str_from_raw(line.as_ptr(), line.len())); }
            Option::None       => { break; }
        }
    }
    let st: ExitStatus = child.wait();
    dealloc(argv_buf as *mut u8);
    return st.code();
}

// ── Build helpers ─────────────────────────────────────────────────────────

unsafe fn out_dir_for(profile: str) -> String {
    let mut d: String = String::new();
    d.push_str(".lforge/");
    d.push_str(profile);
    d.push_str("/out");
    return d;
}

unsafe fn gen_dir_for(profile: str) -> String {
    let mut d: String = String::new();
    d.push_str(".lforge/");
    d.push_str(profile);
    d.push_str("/_gen");
    return d;
}

// Path of the .a archive a lib target produces.
unsafe fn lib_archive_path(profile: str, lib_name: str) -> String {
    let mut p: String = out_dir_for(profile);
    p.push_str("/lib");
    p.push_str(lib_name);
    p.push_str(".a");
    return p;
}

// Path of the bin executable a bin target produces.
unsafe fn bin_path(profile: str, bin_name: str) -> String {
    let mut p: String = out_dir_for(profile);
    p.push_u8(47 as u8);
    p.push_str(bin_name);
    return p;
}

// Resolve dep names → archive paths under <profile>/out/lib<name>.a, in the
// order the deps appear in the bin target's manifest.
unsafe fn dep_archive_paths(targets: &Vec<Target>, deps: &Vec<String>, profile: str) -> Vec<String> {
    let mut out: Vec<String> = vec_new::<String>();
    let outp: *mut Vec<String> = (&mut out) as *mut Vec<String>;
    let dn: i64 = deps.length();
    let dp: *const Vec<String> = deps as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < dn {
        let nm: *const String = dp.at_const(i);
        let nm_view: str = str_from_raw((*nm).as_ptr(), (*nm).len());
        let p: String = lib_archive_path(profile, nm_view);
        outp.push(p);
        i = i + 1 as i64;
    }
    return out;
}

// ── Incremental rebuild (mtime-based) ─────────────────────────────────────
//
// Action skip rule: if the output file exists and its mtime is >= the max
// mtime of every input file, the action is fresh and we skip the spawn.
// Matches the cmake/ninja default behavior (which is what users expect).
//
// A future slice can replace this with content-hash keyed CAS — the
// primitives are already in tests/logos/pass/lforge_graph_cas.logos.

unsafe fn collect_logos_files(dir: str) -> Vec<String> {
    let mut out: Vec<String> = vec_new::<String>();
    let outp: *mut Vec<String> = (&mut out) as *mut Vec<String>;
    let cs: *mut u8 = cstr(dir);
    let exists_dir: bool = is_dir(cs as *const u8);
    dealloc(cs);
    if exists_dir {
        let entries: Vec<DirEntry> = walk_dir(dir);
        let ep: *const Vec<DirEntry> = (&entries) as *const Vec<DirEntry>;
        let n: i64 = entries.length();
        let mut i: i64 = 0 as i64;
        while i < n {
            let de: *const DirEntry = ep.at_const(i);
            i = i + 1 as i64;
            if (*de).is_dir { continue; }
            let pview: str = str_from_raw((*de).name.as_ptr(), (*de).name.len());
            let pn: i64 = pview.len();
            if pn < 6 as i64 { continue; }
            let suffix: str = ".logos";
            let off: i64 = pn - 6 as i64;
            let mut ok: bool = true;
            let mut sk: i64 = 0 as i64;
            while sk < 6 as i64 && ok {
                if pview[off + sk] != suffix[sk] { ok = false; }
                sk = sk + 1 as i64;
            }
            if !ok { continue; }
            let mut p: String = String::new();
            p.push_str(pview);
            outp.push(p);
        }
    }
    return out;
}

// Latest mtime in a list of file paths; returns 0 if list is empty or every
// stat fails.
unsafe fn newest_mtime(paths: &Vec<String>) -> i64 {
    let mut max_mt: i64 = 0 as i64;
    let n: i64 = paths.length();
    let pp: *const Vec<String> = paths as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let s: *const String = pp.at_const(i);
        let cs: *mut u8 = cstr(str_from_raw((*s).as_ptr(), (*s).len()));
        let mt: Result<i64, i32> = mtime_ns(cs as *const u8);
        dealloc(cs);
        match mt {
            Result::Ok(t)  => { if t > max_mt { max_mt = t; } }
            Result::Err(_) => { }
        }
        i = i + 1 as i64;
    }
    return max_mt;
}

// True if `out_path` exists and its mtime is >= every input mtime.
unsafe fn output_is_fresh(out_path: str, max_input_mt: i64) -> bool {
    let cs: *mut u8 = cstr(out_path);
    let ok: bool = exists(cs as *const u8);
    if !ok { dealloc(cs); return false; }
    let mt: Result<i64, i32> = mtime_ns(cs as *const u8);
    dealloc(cs);
    match mt {
        Result::Ok(t)  => { return t >= max_input_mt; }
        Result::Err(_) => { return false; }
    }
}

// ── Per-target build actions ──────────────────────────────────────────────

// Spawn an action without piping stdout/stderr — child inherits the
// parent's fds. Used for parallel fan-out where capturing N concurrent
// pipes would either serialise them or require multiplexing. Output
// interleaving is per-line-atomic on libc-line-buffered streams; good
// enough for build progress.
unsafe fn spawn_inherit(argv: &Vec<String>) -> Child {
    let n: i64 = argv.length();
    let argv_buf: *mut *const u8 = alloc((n + 1 as i64) * 8 as i64) as *mut *const u8;
    let ap: *const Vec<String> = argv as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let s: *const String = ap.at_const(i);
        argv_buf[i] = (*s).as_ptr();
        i = i + 1 as i64;
    }
    argv_buf[n] = 0 as *const u8;
    let child: Child = spawn(argv_buf as *const *const u8, false, false, false);
    dealloc(argv_buf as *mut u8);
    return child;
}

// Per-file artifact paths under .lforge/<profile>/_files/<lib_name>/.
unsafe fn per_file_dir(profile: str, lib_name: str) -> String {
    let mut d: String = String::new();
    d.push_str(".lforge/");
    d.push_str(profile);
    d.push_str("/_files/");
    d.push_str(lib_name);
    return d;
}

// `<dir>/<stem>` — basename of source without `.logos` extension, joined
// with the per-lib output dir. Caller appends `.o` / `.hermes0`.
unsafe fn per_file_prefix(dir: &String, src_path: &String) -> String {
    let stem_str: String = stem(str_from_raw(src_path.as_ptr(), src_path.len()));
    let mut p: String = String::new();
    p.push_bytes(dir.as_ptr(), dir.len());
    p.push_u8(47 as u8);
    p.push_bytes(stem_str.as_ptr(), stem_str.len());
    return p;
}

unsafe fn build_lib(t: &Target, profile: str, logosc: &String) -> i32 {
    // ── Walk source files and decide what needs rebuild ──────────────────
    let src_view: str = str_from_raw(t.src.as_ptr(), t.src.len());
    let sources: Vec<String> = collect_logos_files(src_view);
    let n_src: i64 = sources.length();
    if n_src == 0 as i64 {
        let mut msg: String = String::new();
        msg.push_str("lforge: lib ");
        msg.push_bytes(t.name.as_ptr(), t.name.len());
        msg.push_str(": no .logos files under ");
        msg.push_bytes(t.src.as_ptr(), t.src.len());
        println_string(2, &msg);
        return 1;
    }

    let lib_name_view: str = str_from_raw(t.name.as_ptr(), t.name.len());
    let pf_dir: String = per_file_dir(profile, lib_name_view);
    let pf_dir_view: str = str_from_raw(pf_dir.as_ptr(), pf_dir.len());
    match mkdir_p(pf_dir_view) {
        Result::Err(_) => { println_str(2, "lforge: cannot create _files dir"); return 1; }
        Result::Ok(_)  => { }
    }

    let od: String = out_dir_for(profile);
    let od_view: str = str_from_raw(od.as_ptr(), od.len());
    match mkdir_p(od_view) {
        Result::Err(_) => { println_str(2, "lforge: cannot create out dir"); return 1; }
        Result::Ok(_)  => { }
    }
    let arch: String = lib_archive_path(profile, lib_name_view);

    // ── Generate .module manifest text (each --only-file invocation needs it) ──
    let gd: String = gen_dir_for(profile);
    let gd_view: str = str_from_raw(gd.as_ptr(), gd.len());
    match mkdir_p(gd_view) {
        Result::Err(_) => { println_str(2, "lforge: cannot create _gen dir"); return 1; }
        Result::Ok(_)  => { }
    }
    let mut man: String = String::new();
    man.push_str("module ");
    man.push_bytes(t.name.as_ptr(), t.name.len());
    man.push_u8(10 as u8);
    man.push_str("version 0.1\n");
    man.push_str("root ");
    man.push_bytes(t.src.as_ptr(), t.src.len());
    man.push_u8(10 as u8);
    let mut man_path: String = String::new();
    man_path.push_bytes(gd.as_ptr(), gd.len());
    man_path.push_u8(47 as u8);
    man_path.push_bytes(t.name.as_ptr(), t.name.len());
    man_path.push_str(".module");
    let man_path_cs: *mut u8 = cstr(str_from_raw(man_path.as_ptr(), man_path.len()));
    let wr: Result<i32, i32> = write_string(man_path_cs as *const u8, &man);
    dealloc(man_path_cs);
    match wr {
        Result::Err(_) => { println_str(2, "lforge: cannot write generated .module"); return 1; }
        Result::Ok(_)  => { }
    }

    // ── For each source: determine whether per-file .o is up-to-date.   ──
    // Spawn the rebuilds in parallel; collect Child handles to wait on.
    let sp: *const Vec<String> = (&sources) as *const Vec<String>;
    let mut children: Vec<Child> = vec_new::<Child>();
    let cp: *mut Vec<Child> = (&mut children) as *mut Vec<Child>;
    let mut rebuilt_count: i32 = 0;

    let mut i: i64 = 0 as i64;
    while i < n_src {
        let src_p: *const String = sp.at_const(i);
        i = i + 1 as i64;
        let src_view2: str = str_from_raw((*src_p).as_ptr(), (*src_p).len());

        // Per-file prefix: <_files/lib>/<stem>
        let prefix: String = per_file_prefix(&pf_dir, &(*src_p));
        let mut obj_path: String = String::new();
        obj_path.push_bytes(prefix.as_ptr(), prefix.len());
        obj_path.push_str(".o");

        // mtime check: if .o is newer than the source, skip rebuild.
        let src_cs: *mut u8 = cstr(src_view2);
        let src_mt: i64 = match mtime_ns(src_cs as *const u8) {
            Result::Ok(v)  => { v }
            Result::Err(_) => { 0 as i64 }
        };
        dealloc(src_cs);
        let obj_view: str = str_from_raw(obj_path.as_ptr(), obj_path.len());
        if output_is_fresh(obj_view, src_mt) {
            continue;
        }

        // Build argv: logosc --emit-module <manifest> --only-file <src> -o <prefix>
        let mut argv: Vec<String> = vec_new::<String>();
        let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
        push_string_arg(argv_p, logosc);
        push_arg(argv_p, "--emit-module");
        push_string_arg(argv_p, &man_path);
        push_arg(argv_p, "--only-file");
        push_string_arg(argv_p, &(*src_p));
        push_arg(argv_p, "-o");
        push_string_arg(argv_p, &prefix);

        let child: Child = spawn_inherit(&argv);
        if child.pid() < 0 {
            println_str(2, "lforge: spawn failed");
            return 1;
        }
        cp.push(child);
        rebuilt_count = rebuilt_count + 1;
    }

    // Announce.
    if rebuilt_count > 0 {
        let mut msg: String = String::new();
        msg.push_str("lforge: build lib ");
        msg.push_bytes(t.name.as_ptr(), t.name.len());
        msg.push_str(" — compiling ");
        msg.push_i64(rebuilt_count as i64);
        msg.push_str(" file(s) in parallel");
        println_string(1, &msg);
    }

    // ── Wait for all spawned children ────────────────────────────────────
    let mut all_ok: bool = true;
    let mut waited: i64 = 0 as i64;
    let nch: i64 = children.length();
    while waited < nch {
        let cgp: *mut Vec<Child> = (&mut children) as *mut Vec<Child>;
        // Pop yields children in reverse spawn order; we just need every
        // one to be reaped.
        match cgp.pop() {
            Option::None       => { waited = nch; }
            Option::Some(c)    => {
                let mut child_local: Child = c;
                let st: ExitStatus = child_local.wait();
                if !st.success() { all_ok = false; }
                waited = waited + 1 as i64;
            }
        }
    }
    if !all_ok {
        println_str(2, "lforge: one or more per-file compilations failed");
        return 1;
    }

    // ── Re-archive if anything was rebuilt or the .a is missing/stale ───
    let arch_view: str = str_from_raw(arch.as_ptr(), arch.len());
    let mut need_ar: bool = rebuilt_count > 0;
    if !need_ar {
        // Check archive freshness against every per-file artifact.
        let mut max_pf: i64 = 0 as i64;
        let mut k: i64 = 0 as i64;
        while k < n_src {
            let src_p: *const String = sp.at_const(k);
            k = k + 1 as i64;
            let prefix: String = per_file_prefix(&pf_dir, &(*src_p));
            let mut obj_p: String = String::new();
            obj_p.push_bytes(prefix.as_ptr(), prefix.len());
            obj_p.push_str(".o");
            let cs: *mut u8 = cstr(str_from_raw(obj_p.as_ptr(), obj_p.len()));
            let mt: Result<i64, i32> = mtime_ns(cs as *const u8);
            dealloc(cs);
            match mt {
                Result::Ok(v)  => { if v > max_pf { max_pf = v; } }
                Result::Err(_) => { }
            }
        }
        if !output_is_fresh(arch_view, max_pf) { need_ar = true; }
    }

    if !need_ar {
        let mut msg: String = String::new();
        msg.push_str("lforge: lib ");
        msg.push_bytes(t.name.as_ptr(), t.name.len());
        msg.push_str(" up-to-date");
        println_string(1, &msg);
        return 0;
    }

    // Build `ar rcs <arch> <obj1> <h0_1> <obj2> <h0_2> ...`
    let mut ar_argv: Vec<String> = vec_new::<String>();
    let aap: *mut Vec<String> = (&mut ar_argv) as *mut Vec<String>;
    push_arg(aap, "ar");
    push_arg(aap, "rcs");
    push_string_arg(aap, &arch);
    let mut j: i64 = 0 as i64;
    while j < n_src {
        let src_p: *const String = sp.at_const(j);
        j = j + 1 as i64;
        let prefix: String = per_file_prefix(&pf_dir, &(*src_p));
        let mut o: String = String::new();
        o.push_bytes(prefix.as_ptr(), prefix.len());
        o.push_str(".o");
        let mut h: String = String::new();
        h.push_bytes(prefix.as_ptr(), prefix.len());
        h.push_str(".hermes0");
        aap.push(o);
        aap.push(h);
    }

    // Remove a stale archive first; ar would otherwise append rather than
    // replace and dead members would linger.
    let arch_cs: *mut u8 = cstr(arch_view);
    unlink(arch_cs as *const u8);
    dealloc(arch_cs);

    let ar_child: Child = spawn_inherit(&ar_argv);
    if ar_child.pid() < 0 {
        println_str(2, "lforge: ar spawn failed");
        return 1;
    }
    let mut ar_local: Child = ar_child;
    let ar_st: ExitStatus = ar_local.wait();
    if !ar_st.success() {
        println_str(2, "lforge: ar failed");
        return 1;
    }
    return 0;
}

unsafe fn build_bin(t: &Target,
                    targets: &Vec<Target>,
                    profile: str,
                    logosc: &String,
                    lib_dir: &String) -> i32 {
    if t.entry.len() == 0 as i64 {
        println_str(2, "lforge: bin target missing 'entry'");
        return 1;
    }
    let od: String = out_dir_for(profile);
    let od_view: str = str_from_raw(od.as_ptr(), od.len());
    match mkdir_p(od_view) {
        Result::Err(_) => { println_str(2, "lforge: cannot create out dir"); return 1; }
        Result::Ok(_)  => { }
    }

    // Incremental skip: if the linked binary is newer than every input
    // (the bin's own .logos files + every dep .a archive), skip the action.
    let src_view: str = str_from_raw(t.src.as_ptr(), t.src.len());
    let mut all_inputs: Vec<String> = collect_logos_files(src_view);
    let alp: *mut Vec<String> = (&mut all_inputs) as *mut Vec<String>;
    let dep_archs_for_check: Vec<String> = dep_archive_paths(targets, &t.deps, profile);
    let dap_check: *const Vec<String> = (&dep_archs_for_check) as *const Vec<String>;
    let dnc: i64 = dep_archs_for_check.length();
    let mut di: i64 = 0 as i64;
    while di < dnc {
        let s: *const String = dap_check.at_const(di);
        let mut copy: String = String::new();
        copy.push_bytes((*s).as_ptr(), (*s).len());
        alp.push(copy);
        di = di + 1 as i64;
    }
    let max_mt: i64 = newest_mtime(&all_inputs);
    let bp_check: String = bin_path(profile, str_from_raw(t.name.as_ptr(), t.name.len()));
    let bp_check_view: str = str_from_raw(bp_check.as_ptr(), bp_check.len());
    if output_is_fresh(bp_check_view, max_mt) {
        let mut msg: String = String::new();
        msg.push_str("lforge: bin ");
        msg.push_bytes(t.name.as_ptr(), t.name.len());
        msg.push_str(" up-to-date");
        println_string(1, &msg);
        return 0;
    }

    // Compose entry path: <src>/<entry>.logos
    let mut entry_path: String = String::new();
    entry_path.push_bytes(t.src.as_ptr(), t.src.len());
    let elen: i64 = entry_path.len();
    if elen > 0 as i64 && (entry_path.as_ptr()[elen - 1 as i64] as i32) != 47 {
        entry_path.push_u8(47 as u8);
    }
    entry_path.push_bytes(t.entry.as_ptr(), t.entry.len());
    entry_path.push_str(".logos");

    let mut obj_path: String = String::new();
    obj_path.push_bytes(od.as_ptr(), od.len());
    obj_path.push_u8(47 as u8);
    obj_path.push_bytes(t.name.as_ptr(), t.name.len());
    obj_path.push_str(".o");

    let bp: String = bin_path(profile, str_from_raw(t.name.as_ptr(), t.name.len()));

    // Resolve dep archives.
    let dep_archs: Vec<String> = dep_archive_paths(targets, &t.deps, profile);

    // logosc <entry> -o <obj> [-l <dep_arch>]...
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_string_arg(argv_p, logosc);
    push_string_arg(argv_p, &entry_path);
    push_arg(argv_p, "-o");
    push_string_arg(argv_p, &obj_path);
    let dn: i64 = dep_archs.length();
    let dap: *const Vec<String> = (&dep_archs) as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < dn {
        let s: *const String = dap.at_const(i);
        push_arg(argv_p, "-l");
        push_string_arg(argv_p, &(*s));
        i = i + 1 as i64;
    }

    let mut prefix: String = String::new();
    prefix.push_str("lforge: build bin ");
    prefix.push_bytes(t.name.as_ptr(), t.name.len());
    println_string(1, &prefix);
    let rc: i32 = run_child(&argv);
    if rc != 0 {
        println_str(2, "lforge: logosc failed");
        return rc;
    }

    if lib_dir.len() == 0 as i64 {
        println_str(2, "lforge: cannot locate Logos lib dir (set LOGOS_LIB_DIR)");
        return 1;
    }

    // cc <obj> [<dep_arch>...] <stdlib_archives> -lpthread -lm -o <bin>
    let mut largv: Vec<String> = vec_new::<String>();
    let largv_p: *mut Vec<String> = (&mut largv) as *mut Vec<String>;
    push_arg(largv_p, "cc");
    push_string_arg(largv_p, &obj_path);
    let mut k: i64 = 0 as i64;
    while k < dn {
        let s: *const String = dap.at_const(k);
        push_string_arg(largv_p, &(*s));
        k = k + 1 as i64;
    }
    let lib_view: str = str_from_raw(lib_dir.as_ptr(), lib_dir.len());
    let mut p1: String = String::new();
    p1.push_str(lib_view); append_path(&mut p1, "liblstdlib.a"); largv_p.push(p1);
    let mut p2: String = String::new();
    p2.push_str(lib_view); append_path(&mut p2, "liblstdlib_fibers.a"); largv_p.push(p2);
    let mut p3: String = String::new();
    p3.push_str(lib_view); append_path(&mut p3, "liblstdlib_rt.a"); largv_p.push(p3);
    let mut p4: String = String::new();
    p4.push_str(lib_view); append_path(&mut p4, "liblstdlib_uring.a"); largv_p.push(p4);
    push_arg(largv_p, "-lpthread");
    push_arg(largv_p, "-lm");
    push_arg(largv_p, "-o");
    push_string_arg(largv_p, &bp);

    let mut prefix2: String = String::new();
    prefix2.push_str("lforge: link bin ");
    prefix2.push_bytes(t.name.as_ptr(), t.name.len());
    println_string(1, &prefix2);
    return run_child(&largv);
}

// ── Top-level commands ────────────────────────────────────────────────────

// Find target index by name, or -1 if absent.
unsafe fn find_target_index(targets: &Vec<Target>, name: str) -> i64 {
    let n: i64 = targets.length();
    let tp: *const Vec<Target> = targets as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let t: *const Target = tp.at_const(i);
        let tnm: str = str_from_raw((*t).name.as_ptr(), (*t).name.len());
        if str_eq_local(tnm, name) { return i; }
        i = i + 1 as i64;
    }
    return 0 as i64 - 1 as i64;
}

// If `selected_idx` >= 0, build only that target plus its transitive deps.
// Otherwise build everything in topo order.
unsafe fn cmd_build_selected(m: &Manifest, profile: str, selected_idx: i64) -> i32 {
    let logosc: String = resolve_logosc_path();
    let lib_dir: String = resolve_logos_lib_dir();
    let full_order: Vec<i64> = match topo_order(&m.targets) {
        Result::Err(e) => {
            print_str(2, "lforge: ");
            println_str(2, str_from_raw(e.message.as_ptr(), e.message.len()));
            return 1;
        }
        Result::Ok(o) => { o }
    };

    // Compute which targets to actually build. If selected_idx < 0 → all.
    // Else mark selected + transitively close over deps and intersect.
    let nt: i64 = m.targets.length();
    let want: *mut u8 = alloc(nt);
    let mut wi: i64 = 0 as i64;
    while wi < nt {
        if selected_idx < 0 as i64 { want[wi] = 1 as u8; }
        else                       { want[wi] = 0 as u8; }
        wi = wi + 1 as i64;
    }
    if selected_idx >= 0 as i64 {
        // Iterate to fixed point: for any wanted target, mark its deps
        // wanted too.
        want[selected_idx] = 1 as u8;
        let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
        let mut changed: bool = true;
        while changed {
            changed = false;
            let mut k: i64 = 0 as i64;
            while k < nt {
                if want[k] == 1 as u8 {
                    let t: *const Target = tp.at_const(k);
                    let dn: i64 = (*t).deps.length();
                    let dp: *const Vec<String> = (&(*t).deps) as *const Vec<String>;
                    let mut di: i64 = 0 as i64;
                    while di < dn {
                        let nm: *const String = dp.at_const(di);
                        let nm_view: str = str_from_raw((*nm).as_ptr(), (*nm).len());
                        let didx: i64 = find_target_index(&m.targets, nm_view);
                        if didx >= 0 as i64 && want[didx] == 0 as u8 {
                            want[didx] = 1 as u8;
                            changed = true;
                        }
                        di = di + 1 as i64;
                    }
                }
                k = k + 1 as i64;
            }
        }
    }

    let n_ord: i64 = full_order.length();
    let op: *const Vec<i64> = (&full_order) as *const Vec<i64>;
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    let mut built: i32 = 0;
    while i < n_ord {
        let idx_p: *const i64 = op.at_const(i);
        let idx: i64 = *idx_p;
        i = i + 1 as i64;
        if want[idx] == 0 as u8 { continue; }
        let t: *const Target = tp.at_const(idx);
        let rc: i32 = match (*t).kind {
            TargetKind::Lib => { build_lib(&(*t), profile, &logosc) }
            TargetKind::Bin => { build_bin(&(*t), &m.targets, profile, &logosc, &lib_dir) }
        };
        if rc != 0 {
            dealloc(want);
            return rc;
        }
        built = built + 1;
    }
    dealloc(want);
    println_str(1, "lforge: build OK");
    return 0;
}

unsafe fn cmd_build(m: &Manifest, profile: str) -> i32 {
    return cmd_build_selected(m, profile, 0 as i64 - 1 as i64);
}

// Find the first bin target's name (for `lforge run`).
unsafe fn first_bin_name(m: &Manifest) -> String {
    let n: i64 = m.targets.length();
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let t: *const Target = tp.at_const(i);
        match (*t).kind {
            TargetKind::Bin => {
                let mut out: String = String::new();
                out.push_bytes((*t).name.as_ptr(), (*t).name.len());
                return out;
            }
            TargetKind::Lib => { }
        }
        i = i + 1 as i64;
    }
    return String::new();
}

// Build (selected target if name non-empty) and run the bin target. If no
// name is given, runs the first bin target in declared order.
unsafe fn cmd_run_named(m: &Manifest, profile: str,
                        target_name: str, run_args: &Vec<String>) -> i32 {
    // Pick the bin name (and selected build index).
    let mut bin_nm: String = String::new();
    let mut sel_idx: i64 = 0 as i64 - 1 as i64;
    if target_name.len() > 0 as i64 {
        sel_idx = find_target_index(&m.targets, target_name);
        if sel_idx < 0 as i64 {
            println_str(2, "lforge: unknown target");
            return 1;
        }
        bin_nm.push_str(target_name);
    } else {
        bin_nm = first_bin_name(m);
        if bin_nm.len() == 0 as i64 {
            println_str(2, "lforge: project has no bin target to run");
            return 1;
        }
    }

    let rc: i32 = cmd_build_selected(m, profile, sel_idx);
    if rc != 0 { return rc; }

    let bp: String = bin_path(profile, str_from_raw(bin_nm.as_ptr(), bin_nm.len()));
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_string_arg(argv_p, &bp);
    let an: i64 = run_args.length();
    let rp: *const Vec<String> = run_args as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < an {
        let s: *const String = rp.at_const(i);
        push_string_arg(argv_p, &(*s));
        i = i + 1 as i64;
    }
    return run_child(&argv);
}

unsafe fn cmd_clean() -> i32 {
    match rm_rf(".lforge") {
        Result::Err(_) => { return 1; }
        Result::Ok(_)  => { return 0; }
    }
}

// ── lforge install ────────────────────────────────────────────────────────
//
// Copies built artifacts to a standard prefix layout:
//   bin targets → <prefix>/bin/<name>            (mode 0755)
//   lib targets → <prefix>/lib/lib<name>.a       (mode 0644)
//
// Triggers a build first so artifacts are present and up-to-date.
// Default prefix is /usr/local. Override with `--prefix <path>` (or
// `--prefix=<path>`).

unsafe fn install_one(src: &String, dst: &String, mode: str) -> i32 {
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_arg(argv_p, "install");
    push_arg(argv_p, "-D");
    push_arg(argv_p, "-m");
    push_arg(argv_p, mode);
    push_string_arg(argv_p, src);
    push_string_arg(argv_p, dst);
    return run_child(&argv);
}

unsafe fn read_prefix() -> String {
    let mut s: String = String::new();
    match get_option("prefix", "") {
        Option::Some(v) => { s.push_str(v); }
        Option::None    => { s.push_str("/usr/local"); }
    }
    return s;
}

unsafe fn cmd_install(m: &Manifest, profile: str) -> i32 {
    // Build first.
    let rc: i32 = cmd_build(m, profile);
    if rc != 0 { return rc; }

    let prefix: String = read_prefix();
    let pview: str = str_from_raw(prefix.as_ptr(), prefix.len());

    let mut bin_dir: String = String::new();
    bin_dir.push_str(pview); append_path(&mut bin_dir, "bin");
    let mut lib_dir: String = String::new();
    lib_dir.push_str(pview); append_path(&mut lib_dir, "lib");

    let nt: i64 = m.targets.length();
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    while i < nt {
        let t: *const Target = tp.at_const(i);
        i = i + 1 as i64;
        let nm_view: str = str_from_raw((*t).name.as_ptr(), (*t).name.len());
        match (*t).kind {
            TargetKind::Bin => {
                let src: String = bin_path(profile, nm_view);
                let mut dst: String = String::new();
                dst.push_bytes(bin_dir.as_ptr(), bin_dir.len());
                append_path(&mut dst, nm_view);
                let mut msg: String = String::new();
                msg.push_str("lforge: install ");
                msg.push_bytes(dst.as_ptr(), dst.len());
                println_string(1, &msg);
                let rci: i32 = install_one(&src, &dst, "0755");
                if rci != 0 {
                    println_str(2, "lforge: install failed");
                    return rci;
                }
            }
            TargetKind::Lib => {
                let src: String = lib_archive_path(profile, nm_view);
                let mut dst: String = String::new();
                dst.push_bytes(lib_dir.as_ptr(), lib_dir.len());
                let mut leaf: String = String::new();
                leaf.push_str("lib");
                leaf.push_str(nm_view);
                leaf.push_str(".a");
                append_path(&mut dst, str_from_raw(leaf.as_ptr(), leaf.len()));
                let mut msg: String = String::new();
                msg.push_str("lforge: install ");
                msg.push_bytes(dst.as_ptr(), dst.len());
                println_string(1, &msg);
                let rci: i32 = install_one(&src, &dst, "0644");
                if rci != 0 {
                    println_str(2, "lforge: install failed");
                    return rci;
                }
            }
        }
    }
    println_str(1, "lforge: install OK");
    return 0;
}

// ── lforge test ───────────────────────────────────────────────────────────
//
// Walks `tests/` (top level only — no recursion for now) for `*.logos`
// files. Each file is treated as a stand-alone test program: compile,
// link with all project lib targets, run, expect exit 0. Per-test
// artifacts go under .lforge/<profile>/test/<name>.{o,bin}.
//
// Failures aggregate; exit code is 0 iff every test passed.

unsafe fn build_test_bin(test_logos: &String,
                          test_name:  &String,
                          targets:    &Vec<Target>,
                          profile:    str,
                          logosc:     &String,
                          lib_dir:    &String) -> i32 {
    // Output dirs.
    let mut td: String = String::new();
    td.push_str(".lforge/");
    td.push_str(profile);
    td.push_str("/test");
    let td_view: str = str_from_raw(td.as_ptr(), td.len());
    match mkdir_p(td_view) {
        Result::Err(_) => { return 1; }
        Result::Ok(_)  => { }
    }

    let mut obj_path: String = String::new();
    obj_path.push_bytes(td.as_ptr(), td.len());
    obj_path.push_u8(47 as u8);
    obj_path.push_bytes(test_name.as_ptr(), test_name.len());
    obj_path.push_str(".o");

    let mut bin_p: String = String::new();
    bin_p.push_bytes(td.as_ptr(), td.len());
    bin_p.push_u8(47 as u8);
    bin_p.push_bytes(test_name.as_ptr(), test_name.len());

    // Tests link against every lib target in the project (mimics
    // ctest pattern: tests are top-level consumers of the libs).
    let mut all_lib_archs: Vec<String> = vec_new::<String>();
    let alp: *mut Vec<String> = (&mut all_lib_archs) as *mut Vec<String>;
    let nt: i64 = targets.length();
    let tp: *const Vec<Target> = targets as *const Vec<Target>;
    let mut ti: i64 = 0 as i64;
    while ti < nt {
        let tt: *const Target = tp.at_const(ti);
        match (*tt).kind {
            TargetKind::Lib => {
                let nm_view: str = str_from_raw((*tt).name.as_ptr(), (*tt).name.len());
                let p: String = lib_archive_path(profile, nm_view);
                alp.push(p);
            }
            TargetKind::Bin => { }
        }
        ti = ti + 1 as i64;
    }

    // logosc <test_logos> -o <obj> [-l <lib>]...
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_string_arg(argv_p, logosc);
    push_string_arg(argv_p, test_logos);
    push_arg(argv_p, "-o");
    push_string_arg(argv_p, &obj_path);
    let lan: i64 = all_lib_archs.length();
    let lap: *const Vec<String> = (&all_lib_archs) as *const Vec<String>;
    let mut li: i64 = 0 as i64;
    while li < lan {
        let s: *const String = lap.at_const(li);
        push_arg(argv_p, "-l");
        push_string_arg(argv_p, &(*s));
        li = li + 1 as i64;
    }
    let rc: i32 = run_child(&argv);
    if rc != 0 { return rc; }

    if lib_dir.len() == 0 as i64 {
        println_str(2, "lforge: cannot locate Logos lib dir");
        return 1;
    }

    // cc <obj> [<lib>...] <stdlib_archives> -lpthread -lm -o <bin>
    let mut largv: Vec<String> = vec_new::<String>();
    let largv_p: *mut Vec<String> = (&mut largv) as *mut Vec<String>;
    push_arg(largv_p, "cc");
    push_string_arg(largv_p, &obj_path);
    let mut lk: i64 = 0 as i64;
    while lk < lan {
        let s: *const String = lap.at_const(lk);
        push_string_arg(largv_p, &(*s));
        lk = lk + 1 as i64;
    }
    let lib_view: str = str_from_raw(lib_dir.as_ptr(), lib_dir.len());
    let mut p1: String = String::new();
    p1.push_str(lib_view); append_path(&mut p1, "liblstdlib.a"); largv_p.push(p1);
    let mut p2: String = String::new();
    p2.push_str(lib_view); append_path(&mut p2, "liblstdlib_fibers.a"); largv_p.push(p2);
    let mut p3: String = String::new();
    p3.push_str(lib_view); append_path(&mut p3, "liblstdlib_rt.a"); largv_p.push(p3);
    let mut p4: String = String::new();
    p4.push_str(lib_view); append_path(&mut p4, "liblstdlib_uring.a"); largv_p.push(p4);
    push_arg(largv_p, "-lpthread");
    push_arg(largv_p, "-lm");
    push_arg(largv_p, "-o");
    push_string_arg(largv_p, &bin_p);
    return run_child(&largv);
}

// Strip a path's trailing extension. "tests/foo.logos" → "tests/foo".
unsafe fn strip_dot_logos(s: str) -> String {
    let mut out: String = String::new();
    let n: i64 = s.len();
    let mut stripped: bool = false;
    if n >= 6 as i64 {
        let suffix: str = ".logos";
        let off: i64 = n - 6 as i64;
        let mut ok: bool = true;
        let mut k: i64 = 0 as i64;
        while k < 6 as i64 && ok {
            if s[off + k] != suffix[k] { ok = false; }
            k = k + 1 as i64;
        }
        if ok {
            out.push_bytes(s.as_ptr(), off);
            stripped = true;
        }
    }
    if !stripped {
        out.push_str(s);
    }
    return out;
}

// Extract base file name from a path: "a/b/c.logos" → "c.logos".
unsafe fn basename_view(p: str) -> str {
    let n: i64 = p.len();
    let mut start: i64 = 0 as i64;
    let mut i: i64 = n - 1 as i64;
    while i >= 0 as i64 {
        if (p[i] as i32) == 47 { start = i + 1 as i64; i = 0 as i64 - 1 as i64; }
        else { i = i - 1 as i64; }
    }
    return str_from_raw((p.as_ptr() as i64 + start) as *const u8, n - start);
}

unsafe fn cmd_test(m: &Manifest, profile: str) -> i32 {
    // 1. Build all lib targets first; bin targets are not needed for tests.
    let logosc:  String = resolve_logosc_path();
    let lib_dir: String = resolve_logos_lib_dir();
    let order: Vec<i64> = match topo_order(&m.targets) {
        Result::Err(e) => {
            print_str(2, "lforge: ");
            println_str(2, str_from_raw(e.message.as_ptr(), e.message.len()));
            return 1;
        }
        Result::Ok(o) => { o }
    };
    let n_ord: i64 = order.length();
    let op: *const Vec<i64> = (&order) as *const Vec<i64>;
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut k: i64 = 0 as i64;
    while k < n_ord {
        let idx_p: *const i64 = op.at_const(k);
        let idx: i64 = *idx_p;
        let t: *const Target = tp.at_const(idx);
        match (*t).kind {
            TargetKind::Lib => {
                let rc: i32 = build_lib(&(*t), profile, &logosc);
                if rc != 0 {
                    println_str(2, "lforge: lib target failed; aborting test run");
                    return rc;
                }
            }
            TargetKind::Bin => { }
        }
        k = k + 1 as i64;
    }

    // 2. Walk tests/ for .logos files.
    let cs_tests: *mut u8 = cstr("tests");
    let exists_tests: bool = is_dir(cs_tests as *const u8);
    dealloc(cs_tests);
    if !exists_tests {
        println_str(1, "lforge: no tests/ dir, nothing to test");
        return 0;
    }

    let entries: Vec<DirEntry> = walk_dir("tests");
    let ep: *const Vec<DirEntry> = (&entries) as *const Vec<DirEntry>;
    let en: i64 = entries.length();

    let mut pass_n: i32 = 0;
    let mut fail_n: i32 = 0;
    let mut ei: i64 = 0 as i64;
    while ei < en {
        let de: *const DirEntry = ep.at_const(ei);
        ei = ei + 1 as i64;
        if (*de).is_dir { continue; }
        let pview: str = str_from_raw((*de).name.as_ptr(), (*de).name.len());
        let pn: i64 = pview.len();
        if pn < 6 as i64 { continue; }
        // Quick suffix check: ".logos"
        let suffix: str = ".logos";
        let off: i64 = pn - 6 as i64;
        let mut ok: bool = true;
        let mut sk: i64 = 0 as i64;
        while sk < 6 as i64 && ok {
            if pview[off + sk] != suffix[sk] { ok = false; }
            sk = sk + 1 as i64;
        }
        if !ok { continue; }

        let bn_view: str = basename_view(pview);
        let stem: String = strip_dot_logos(bn_view);
        let mut path_str: String = String::new();
        path_str.push_str(pview);

        let mut prefix: String = String::new();
        prefix.push_str("lforge: test ");
        prefix.push_bytes(stem.as_ptr(), stem.len());
        println_string(1, &prefix);

        let rc: i32 = build_test_bin(&path_str, &stem, &m.targets, profile, &logosc, &lib_dir);
        if rc != 0 {
            println_str(2, "  FAIL (compile/link)");
            fail_n = fail_n + 1;
            continue;
        }

        // Run the test binary.
        let mut bin_p: String = String::new();
        bin_p.push_str(".lforge/");
        bin_p.push_str(profile);
        bin_p.push_str("/test/");
        bin_p.push_bytes(stem.as_ptr(), stem.len());

        let mut argv: Vec<String> = vec_new::<String>();
        let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
        push_string_arg(argv_p, &bin_p);
        let exit_rc: i32 = run_child(&argv);
        if exit_rc == 0 {
            println_str(1, "  PASS");
            pass_n = pass_n + 1;
        } else {
            println_str(2, "  FAIL (exit code)");
            fail_n = fail_n + 1;
        }
    }

    // Summary.
    let mut summary: String = String::new();
    summary.push_str("lforge: tests passed=");
    summary.push_i64(pass_n as i64);
    summary.push_str(" failed=");
    summary.push_i64(fail_n as i64);
    println_string(1, &summary);
    if fail_n > 0 { return 1; }
    return 0;
}

// ── main ──────────────────────────────────────────────────────────────────

unsafe fn select_profile() -> str {
    if has_flag("release", "") { return "release"; }
    if has_flag("debug",   "") { return "debug"; }
    return "debug";
}

unsafe fn main() -> i32 {
    let cmd: str = positional(0 as i32);
    if cmd.len() == 0 as i64 {
        println_str(2, "usage: lforge <build|run|clean> [--release] [-- args...]");
        return 2;
    }

    if str_eq_local(cmd, "clean") {
        return cmd_clean();
    }

    let m: Manifest = match read_manifest("./lforge.hermes") {
        Result::Err(e) => {
            print_str(2, "lforge: ");
            println_str(2, str_from_raw(e.message.as_ptr(), e.message.len()));
            return 1;
        }
        Result::Ok(x)  => { x }
    };

    let profile: str = select_profile();

    if str_eq_local(cmd, "build") {
        // Optional positional: target name to build (with transitive deps).
        let target_arg: str = positional(1 as i32);
        let mut sel: i64 = 0 as i64 - 1 as i64;
        if target_arg.len() > 0 as i64 {
            sel = find_target_index(&m.targets, target_arg);
            if sel < 0 as i64 {
                print_str(2, "lforge: unknown target '");
                print_str(2, target_arg);
                println_str(2, "'");
                return 1;
            }
        }
        return cmd_build_selected(&m, profile, sel);
    }
    if str_eq_local(cmd, "test") {
        return cmd_test(&m, profile);
    }
    if str_eq_local(cmd, "install") {
        return cmd_install(&m, profile);
    }
    if str_eq_local(cmd, "run") {
        // Optional positional: bin target to run.
        let target_arg: str = positional(1 as i32);
        let mut run_args: Vec<String> = vec_new::<String>();
        let rap: *mut Vec<String> = (&mut run_args) as *mut Vec<String>;
        let pn: i32 = positional_count();
        let mut start_k: i32 = 1;
        let mut sel_target: str = "";
        if target_arg.len() > 0 as i64 {
            // Treat first positional after `run` as a target name only if
            // it matches an existing bin target; otherwise it's a run arg.
            let idx: i64 = find_target_index(&m.targets, target_arg);
            if idx >= 0 as i64 {
                let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
                let t: *const Target = tp.at_const(idx);
                match (*t).kind {
                    TargetKind::Bin => { sel_target = target_arg; start_k = 2; }
                    TargetKind::Lib => {
                        println_str(2, "lforge: cannot run a lib target");
                        return 1;
                    }
                }
            }
        }
        let mut k: i32 = start_k;
        while k < pn {
            let a: str = positional(k);
            let mut copy: String = String::new();
            copy.push_str(a);
            rap.push(copy);
            k = k + 1;
        }
        return cmd_run_named(&m, profile, sel_target, &run_args);
    }
    println_str(2, "lforge: unknown command (expected: build, run, test, install, clean)");
    return 2;
}
