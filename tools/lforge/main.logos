// SPDX-License-Identifier: Apache-2.0
// lforge — Logos build system.
//
// CLI:
//   lforge build [--release]   — compile project rooted at cwd
//   lforge run [--release] [-- args]
//                              — build + exec the bin target (single-bin
//                                projects only; for multi-bin use a binary
//                                directly out of .lforge/<profile>/out/)
//   lforge clean               — rm -rf .lforge/
//
// Manifest (Hermes-SDN, ./lforge.hermes):
//
//   {
//     name:    "my-project",
//     version: "0.1.0",
//     targets: [
//       { kind: "lib", name: "core", src: "src/core" },
//       { kind: "bin", name: "app",  src: "src", entry: "main",
//         deps: ["core"] }
//     ]
//   }
//
// Backwards-compat: if `targets` is absent, the top-level `src` + `entry`
// fields synthesize a single bin target named after the project. This is
// the schema B0.5 shipped with.
//
// Targets:
//   bin: compiles <src>/<entry>.logos through logosc, then links the .o
//        with sibling-lib .a archives + system stdlib via cc.
//   lib: writes a generated module manifest, invokes
//        `logosc --emit-module` to produce a .a archive.
//
// Library deps are sibling targets in the same project; they're built
// first via topological sort and added to downstream link/compile lines.
//
// Output layout (per profile):
//   .lforge/<profile>/_gen/<lib>.module     generated lib manifest
//   .lforge/<profile>/out/<bin>             linked bin executable
//   .lforge/<profile>/out/<bin>.o           bin object file
//   .lforge/<profile>/out/lib<lib>.a        lib archive
//
// Today: full rebuild every invocation; CAS scaffolding (B0.4) is in
// stdlib but not yet hooked. B1.2 wires it.

package lforge_main;

use std.hermes.zone;
use std.hermes.anyval;
use std.hermes.view;
use std.hermes.string;
use std.hermes.typetag;
use std.hermes.array;
use std.hermes.map;
use std.hermes.typed_value;
use std.hermes.objectmap;
use std.hermes.document;
use std.hermes.parser;
use std.io.fs;
use std.io.fs.path;
use std.lang.text;
use std.lang.option;
use std.lang.result;
use std.lang.iter;
use std.collections.vec;
use std.sys.process;
use std.sys.args;

use lforge.version;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;
extern fn getenv(name: *const u8) -> *const u8;
extern fn execv(path: *const u8, argv: *const *const u8) -> i32;
extern fn chdir(path: *const u8) -> i32;
extern fn getcwd(buf: *mut u8, size: u64) -> *mut u8;

// ── Schema ────────────────────────────────────────────────────────────────

pub enum TargetKind { Bin, Lib }

pub struct Target {
    pub kind:  TargetKind,
    pub name:  String,
    pub src:   String,           // dir for Logos sources (may be empty)
    pub entry: String,           // empty for lib targets
    pub deps:  Vec<String>,      // names of sibling lib targets
    // Native sources, project-root-relative paths. C and asm files are
    // compiled via `cc -c <src> -o <stem>.<ext>.o` and folded into the
    // same archive as Logos artifacts. Both arrays are independently
    // optional; `src` may also be empty for pure-native libs.
    pub c_sources:   Vec<String>,
    pub asm_sources: Vec<String>,
}

// External dependency on another lforge project. Either a local path
// (`path:`) or a git URL (`project:`) -- exactly one. For git deps,
// exactly one of `tag` / `branch` / `sha` must be set.
pub struct ExternalDep {
    pub path:    String,
    pub project: String,
    pub tag:     String,
    pub branch:  String,
    pub sha:     String,
    pub modules: Vec<String>,
}

// One pinned entry in lforge.lock (B3). `tag` is preserved for diff
// readability; SHA is the source of truth for what gets fetched.
pub struct LockEntry {
    pub project: String,
    pub tag:     String,
    pub sha:     String,
}

// One git project that's been resolved during the closure walk. Used to
// detect MVS conflicts (same project at different versions in the same
// closure) and apply the lockfile's pin atomically across all consumers.
pub struct GitWinner {
    pub display: String,
    pub tag:     String,
    pub sha:     String,
}

pub struct Manifest {
    pub name:    String,
    pub version: String,
    pub targets: Vec<Target>,
    pub deps:    Vec<ExternalDep>,
}

pub struct ManifestError {
    pub message: String,
}

// ── String helpers ────────────────────────────────────────────────────────

unsafe fn cstr(s: str) -> *mut u8 {
    let n: i64 = s.len();
    let h: *mut u8 = alloc(n + 1 as i64);
    let mut i: i64 = 0 as i64;
    while i < n { h[i] = s.as_ptr()[i]; i = i + 1 as i64; }
    h[n] = 0 as u8;
    return h;
}

fn str_eq_local(a: str, b: str) -> bool {
    if a.len() != b.len() { return false; }
    return str_starts_with(a, b);
}

unsafe fn err_msg(msg: str) -> ManifestError {
    let mut s: String = String::new();
    s.push_str(msg);
    return ManifestError { message: s };
}

unsafe fn err_msg2(a: str, b: str) -> ManifestError {
    let mut s: String = String::new();
    s.push_str(a);
    s.push_str(b);
    return ManifestError { message: s };
}

unsafe fn print_str(fd: i32, s: str) {
    write(fd, s.as_ptr(), s.len());
}

unsafe fn println_str(fd: i32, s: str) {
    print_str(fd, s);
    let nl: u8 = 10 as u8;
    write(fd, &nl as *const u8, 1 as i64);
}

unsafe fn println_string(fd: i32, s: &String) {
    write(fd, s.as_ptr(), s.len());
    let nl: u8 = 10 as u8;
    write(fd, &nl as *const u8, 1 as i64);
}

// Append `<base>/<rest>` semantics into an existing String.
unsafe fn append_path(base: &mut String, rest: str) {
    let n: i64 = base.len();
    if n > 0 as i64 && (base.as_ptr()[n - 1 as i64] as i32) != 47 {
        base.push_u8(47 as u8);
    }
    base.push_str(rest);
}

// ── Hermes helpers ────────────────────────────────────────────────────────

unsafe fn read_str_field(view: &HermesView<'a>, root: AnyVal, key: str) -> Result<String, ManifestError> {
    let v: AnyVal = view.map_get(root, key);
    if v.is_null() {
        return Result::Err(err_msg2("manifest: missing required field ", key));
    }
    if !v.is_string(view.base()) {
        return Result::Err(err_msg2("manifest: not a string: ", key));
    }
    let sv: StringView = view.get_str_view(v);
    let mut out: String = String::new();
    out.push_bytes(sv.ptr, sv.len as i64);
    return Result::Ok(out);
}

// Read an optional string field — returns empty String if absent.
unsafe fn read_str_opt(view: &HermesView<'a>, root: AnyVal, key: str) -> String {
    let mut out: String = String::new();
    let v: AnyVal = view.map_get(root, key);
    if !v.is_null() && v.is_string(view.base()) {
        let sv: StringView = view.get_str_view(v);
        out.push_bytes(sv.ptr, sv.len as i64);
    }
    return out;
}

// Read an array of strings (e.g. `deps: ["a", "b"]`). Returns empty Vec if
// absent or wrong type.
unsafe fn read_str_array(view: &HermesView<'a>, root: AnyVal, key: str) -> Vec<String> {
    let mut out: Vec<String> = vec_new::<String>();
    let v: AnyVal = view.map_get(root, key);
    let base: *const u8 = view.base();
    if !v.is_null() && v.is_array(base) {
        let n: u64 = view.array_len(v);
        let outp: *mut Vec<String> = (&mut out) as *mut Vec<String>;
        let mut i: u64 = 0 as u64;
        while i < n {
            let elem: AnyVal = view.array_get(v, i);
            if elem.is_string(base) {
                let sv: StringView = view.get_str_view(elem);
                let mut s: String = String::new();
                s.push_bytes(sv.ptr, sv.len as i64);
                outp.push(s);
            }
            i = i + 1 as u64;
        }
    }
    return out;
}

// ── Manifest parser ──────────────────────────────────────────────────────

// Parse one entry of the project-level `deps: [...]` array. Forms:
//     { path: "../foo", modules: [...] }
//     { project: "github.com/x/y", tag:    "v1.0", modules: [...] }
//     { project: "github.com/x/y", branch: "main", modules: [...] }
//     { project: "github.com/x/y", sha:    "abc...", modules: [...] }
unsafe fn parse_external_dep(view: &HermesView<'a>, base: *const u8, d_av: AnyVal) -> Result<ExternalDep, ManifestError> {
    if !d_av.is_map(base) {
        return Result::Err(err_msg("manifest: deps[] entry is not a map"));
    }
    let path_s:    String = read_str_opt(view, d_av, "path");
    let project_s: String = read_str_opt(view, d_av, "project");
    let tag_s:     String = read_str_opt(view, d_av, "tag");
    let branch_s:  String = read_str_opt(view, d_av, "branch");
    let sha_s:     String = read_str_opt(view, d_av, "sha");

    let has_path: bool = path_s.len()    > 0 as i64;
    let has_proj: bool = project_s.len() > 0 as i64;
    if has_path && has_proj {
        return Result::Err(err_msg("manifest: deps[] entry has both 'path' and 'project' -- pick one"));
    }
    if has_path == false && has_proj == false {
        return Result::Err(err_msg("manifest: deps[] entry has neither 'path' nor 'project'"));
    }
    let has_tag:    bool = tag_s.len()    > 0 as i64;
    let has_branch: bool = branch_s.len() > 0 as i64;
    let has_sha:    bool = sha_s.len()    > 0 as i64;
    let mut nv: i32 = 0 as i32;
    if has_tag    { nv = nv + 1 as i32; }
    if has_branch { nv = nv + 1 as i32; }
    if has_sha    { nv = nv + 1 as i32; }
    if has_proj && nv != 1 as i32 {
        return Result::Err(err_msg("manifest: deps[] git entry needs exactly one of 'tag' / 'branch' / 'sha'"));
    }
    if has_path && nv != 0 as i32 {
        return Result::Err(err_msg("manifest: deps[] local entry must not have 'tag' / 'branch' / 'sha'"));
    }

    let mods: Vec<String> = read_str_array(view, d_av, "modules");
    if mods.length() == 0 as i64 {
        return Result::Err(err_msg("manifest: deps[].modules is empty -- list at least one lib target name"));
    }
    return Result::Ok(ExternalDep {
        path:    path_s,
        project: project_s,
        tag:     tag_s,
        branch:  branch_s,
        sha:     sha_s,
        modules: mods,
    });
}

unsafe fn parse_target(view: &HermesView<'a>, base: *const u8, t_av: AnyVal) -> Result<Target, ManifestError> {
    if !t_av.is_map(base) {
        return Result::Err(err_msg("manifest: targets[] entry is not a map"));
    }
    let kind_s: String = match read_str_field(view, t_av, "kind") {
        Result::Err(e) => { return Result::Err(e); }
        Result::Ok(s)  => { s }
    };
    let mut k: TargetKind = TargetKind::Bin;
    let kv: str = str_from_raw(kind_s.as_ptr(), kind_s.len());
    if str_eq_local(kv, "lib") {
        k = TargetKind::Lib;
    } else if !str_eq_local(kv, "bin") {
        return Result::Err(err_msg2("manifest: target.kind must be 'bin' or 'lib', got ", kv));
    }
    let name_s: String = match read_str_field(view, t_av, "name") {
        Result::Err(e) => { return Result::Err(e); }
        Result::Ok(s)  => { s }
    };
    // src is required only when not all native; we accept missing here
    // and let build_lib enforce "must have at least one source category".
    let src_s: String = read_str_opt(view, t_av, "src");
    let entry_s: String = read_str_opt(view, t_av, "entry");
    let deps_v: Vec<String> = read_str_array(view, t_av, "deps");
    let c_v:   Vec<String> = read_str_array(view, t_av, "c_sources");
    let asm_v: Vec<String> = read_str_array(view, t_av, "asm_sources");
    return Result::Ok(Target {
        kind:  k,
        name:  name_s,
        src:   src_s,
        entry: entry_s,
        deps:  deps_v,
        c_sources:   c_v,
        asm_sources: asm_v,
    });
}

pub unsafe fn parse_manifest(text: str) -> Result<Manifest, ManifestError> {
    let mut z: Zone<Mutable> = zone_create(8192);
    if !hermes_parse(text.as_ptr(), text.len(), &mut z) {
        return Result::Err(err_msg("manifest: SDN parse failed"));
    }
    let view: HermesView<'a> = HermesView {
        base: z.holder.base as *const u8,
        size: z.holder.used as u64,
    };
    let root: AnyVal = view.root();
    let base: *const u8 = view.base();
    if !root.is_map(base) {
        return Result::Err(err_msg("manifest: top-level value must be a map"));
    }

    // Required: name + version.
    let name_s: String = match read_str_field(&view, root, "name") {
        Result::Err(e) => { return Result::Err(e); }
        Result::Ok(s)  => { s }
    };
    let version_s: String = match read_str_field(&view, root, "version") {
        Result::Err(e) => { return Result::Err(e); }
        Result::Ok(s)  => { s }
    };

    // Targets: prefer explicit targets[]; fall back to legacy {src, entry}.
    let mut targets: Vec<Target> = vec_new::<Target>();
    let tp: *mut Vec<Target> = (&mut targets) as *mut Vec<Target>;
    let targets_av: AnyVal = view.map_get(root, "targets");
    let mut have_legacy: bool = false;
    if targets_av.is_array(base) {
        let n: u64 = view.array_len(targets_av);
        let mut i: u64 = 0 as u64;
        while i < n {
            let t_av: AnyVal = view.array_get(targets_av, i);
            match parse_target(&view, base, t_av) {
                Result::Err(e) => { return Result::Err(e); }
                Result::Ok(t)  => { tp.push(t); }
            }
            i = i + 1 as u64;
        }
    } else {
        // Legacy schema: synthesize one bin target.
        have_legacy = true;
        let src_s: String = match read_str_field(&view, root, "src") {
            Result::Err(e) => { return Result::Err(e); }
            Result::Ok(s)  => { s }
        };
        let entry_s: String = match read_str_field(&view, root, "entry") {
            Result::Err(e) => { return Result::Err(e); }
            Result::Ok(s)  => { s }
        };
        let mut nm: String = String::new();
        nm.push_bytes(name_s.as_ptr(), name_s.len());
        let synth: Target = Target {
            kind:  TargetKind::Bin,
            name:  nm,
            src:   src_s,
            entry: entry_s,
            deps:  vec_new::<String>(),
            c_sources:   vec_new::<String>(),
            asm_sources: vec_new::<String>(),
        };
        tp.push(synth);
    }

    if targets.length() == 0 as i64 {
        return Result::Err(err_msg("manifest: no targets"));
    }

    // Project-level deps: [{ path: "...", modules: [...] }, ...] (B2).
    let mut deps: Vec<ExternalDep> = vec_new::<ExternalDep>();
    let dp: *mut Vec<ExternalDep> = (&mut deps) as *mut Vec<ExternalDep>;
    let deps_av: AnyVal = view.map_get(root, "deps");
    if deps_av.is_array(base) {
        let nd: u64 = view.array_len(deps_av);
        let mut j: u64 = 0 as u64;
        while j < nd {
            let d_av: AnyVal = view.array_get(deps_av, j);
            match parse_external_dep(&view, base, d_av) {
                Result::Err(e) => { return Result::Err(e); }
                Result::Ok(d)  => { dp.push(d); }
            }
            j = j + 1 as u64;
        }
    }

    return Result::Ok(Manifest {
        name:    name_s,
        version: version_s,
        targets: targets,
        deps:    deps,
    });
}

unsafe fn read_manifest(p: str) -> Result<Manifest, ManifestError> {
    let cs: *mut u8 = cstr(p);
    let body: Result<String, i32> = read_to_string(cs as *const u8);
    dealloc(cs);
    match body {
        Result::Err(_) => { return Result::Err(err_msg("lforge.hermes: cannot read")); }
        Result::Ok(s)  => {
            let view: str = str_from_raw(s.as_ptr(), s.len());
            return parse_manifest(view);
        }
    }
}

// ── Topological sort of targets by deps ───────────────────────────────────

// Returns an order of indices into `targets` such that for any i in the
// order, all of targets[i].deps appear before i. Errors out on cycles or
// unknown dep names.
unsafe fn topo_order(targets: &Vec<Target>, externals: &Vec<ExternalLib>) -> Result<Vec<i64>, ManifestError> {
    let n: i64 = targets.length();
    let tp: *const Vec<Target> = targets as *const Vec<Target>;

    // state: 0 = unvisited, 1 = visiting (on stack), 2 = done.
    let state: *mut u8 = alloc(n);
    let mut s_init: i64 = 0 as i64;
    while s_init < n { state[s_init] = 0 as u8; s_init = s_init + 1 as i64; }

    let mut order: Vec<i64> = vec_new::<i64>();
    let order_p: *mut Vec<i64> = (&mut order) as *mut Vec<i64>;

    // Recursion helper. Returns Err on cycle / unknown.
    let mut err_buf: String = String::new();
    let mut have_err: bool = false;
    // Iterative DFS using an explicit stack of (target_idx, dep_cursor).
    let mut work_idx: *mut i64 = alloc(n * 8 as i64) as *mut i64;
    let mut work_cur: *mut i64 = alloc(n * 8 as i64) as *mut i64;
    let mut top: i64 = 0 as i64;

    let mut start: i64 = 0 as i64;
    while start < n && !have_err {
        if state[start] != 0 as u8 {
            start = start + 1 as i64;
            continue;
        }
        work_idx[top] = start;
        work_cur[top] = 0 as i64;
        state[start] = 1 as u8;
        top = top + 1 as i64;
        while top > 0 as i64 && !have_err {
            let cur: i64 = work_idx[top - 1 as i64];
            let cur_dep: i64 = work_cur[top - 1 as i64];
            let t: *const Target = tp.at_const(cur);
            let dn: i64 = (*t).deps.length();
            if cur_dep < dn {
                let dp: *const Vec<String> = (&(*t).deps) as *const Vec<String>;
                let dnm: *const String = dp.at_const(cur_dep);
                let dnms: str = str_from_raw((*dnm).as_ptr(), (*dnm).len());
                // Inline resolve dep name → target index.
                let mut didx: i64 = 0 as i64 - 1 as i64;
                let mut ri: i64 = 0 as i64;
                while ri < n {
                    let rt: *const Target = tp.at_const(ri);
                    let rtnm: str = str_from_raw((*rt).name.as_ptr(), (*rt).name.len());
                    if str_eq_local(rtnm, dnms) { didx = ri; ri = n; }
                    else { ri = ri + 1 as i64; }
                }
                work_cur[top - 1 as i64] = cur_dep + 1 as i64;
                if didx < 0 as i64 {
                    // External-dep name? Treat as edge to nothing (already
                    // built before topo_order is called).
                    if external_lookup(externals, dnms) >= 0 as i64 {
                        // skip — no in-target predecessor
                    } else {
                        have_err = true;
                        err_buf.push_str("manifest: unknown dep '");
                        err_buf.push_bytes((*dnm).as_ptr(), (*dnm).len());
                        err_buf.push_str("'");
                    }
                } else if state[didx] == 1 as u8 {
                    have_err = true;
                    err_buf.push_str("manifest: dependency cycle involving '");
                    err_buf.push_bytes((*t).name.as_ptr(), (*t).name.len());
                    err_buf.push_str("'");
                } else if state[didx] == 0 as u8 {
                    work_idx[top] = didx;
                    work_cur[top] = 0 as i64;
                    state[didx] = 1 as u8;
                    top = top + 1 as i64;
                }
            } else {
                state[cur] = 2 as u8;
                order_p.push(cur);
                top = top - 1 as i64;
            }
        }
        start = start + 1 as i64;
    }

    dealloc(state);
    dealloc(work_idx as *mut u8);
    dealloc(work_cur as *mut u8);
    if have_err {
        return Result::Err(ManifestError { message: err_buf });
    }
    return Result::Ok(order);
}

// ── Working-directory + path helpers ──────────────────────────────────────

unsafe fn save_cwd() -> String {
    let cap: u64 = 4096 as u64;
    let buf: *mut u8 = alloc(cap as i64);
    let r: *mut u8 = getcwd(buf, cap);
    if r == 0 as *mut u8 {
        dealloc(buf);
        return String::new();
    }
    let s: str = str_from_cstr(r as *const u8);
    let mut out: String = String::new();
    out.push_str(s);
    dealloc(buf);
    return out;
}

unsafe fn chdir_str(path: str) -> i32 {
    let cs: *mut u8 = cstr(path);
    let rc: i32 = chdir(cs as *const u8);
    dealloc(cs);
    return rc;
}

// Concatenate cwd + "/" + rel into an absolute path (no normalisation —
// the kernel handles `.` / `..` fine and lockfile/cache canonicalisation
// is a future-step concern).
unsafe fn make_absolute(rel: str) -> String {
    let n: i64 = rel.len();
    if n > 0 as i64 && (rel.as_ptr()[0 as i64] as i32) == 47 {
        let mut out: String = String::new();
        out.push_str(rel);
        return out;
    }
    let cwd: String = save_cwd();
    let mut out: String = String::new();
    out.push_bytes(cwd.as_ptr(), cwd.len());
    append_path(&mut out, rel);
    return out;
}

// ── External deps (B2: local paths only) ──────────────────────────────────

pub struct ExternalLib {
    pub name:         String,    // lib target name in the external project
    pub archive_path: String,    // absolute path to <ext>/.lforge/<profile>/out/lib<name>.a
}

// Build the lib targets named in `dep.modules` from the external project at
// `dep.path`. Returns the absolute archive paths so the consumer can
// resolve t.deps lookups + pass them to logosc/cc.
//
// NOTE v1: external projects must NOT themselves declare project-level
// `deps:` — recursive resolution lands with the lockfile + MVS in B3.
unsafe fn build_external(dep: &ExternalDep, profile: str, logosc: &String,
                         lock_in: &Vec<LockEntry>,
                         lock_out: *mut Vec<LockEntry>,
                         visited: *mut Vec<String>,
                         winners: *mut Vec<GitWinner>) -> Result<Vec<ExternalLib>, i32> {
    let saved: String = save_cwd();
    if saved.len() == 0 as i64 {
        println_str(2, "lforge: getcwd failed");
        return Result::Err(1);
    }

    // Local `path:` -> use as-is. Git `project:` -> resolve to a cache path
    // (lockfile fast-path or ls-remote + clone). MVS conflict check before
    // we commit to fetching: if another consumer already pinned this
    // project to a higher version, silently defer to that one; a lower
    // pin would require an upgrade we don't support yet.
    let mut resolved_path: String = String::new();
    let mut resolved_display: String = String::new();
    let mut resolved_sha: String = String::new();
    let mut resolved_tag: String = String::new();
    if dep.path.len() > 0 as i64 {
        resolved_path.push_bytes(dep.path.as_ptr(), dep.path.len());
    } else {
        match resolve_git_dep(dep, lock_in, lock_out) {
            Result::Err(rc) => { return Result::Err(rc); }
            Result::Ok(t)   => {
                resolved_path = t.0;
                resolved_display = t.1;
                resolved_sha = t.2;
            }
        }
        if dep.tag.len() > 0 as i64 {
            resolved_tag.push_bytes(dep.tag.as_ptr(), dep.tag.len());
        }
        let dview: str = str_from_raw(resolved_display.as_ptr(), resolved_display.len());
        let tview: str = str_from_raw(resolved_tag.as_ptr(),     resolved_tag.len());
        let sview: str = str_from_raw(resolved_sha.as_ptr(),     resolved_sha.len());
        let verdict: i32 = check_git_winner(&(*winners), dview, tview, sview);
        if verdict == 2 as i32 || verdict == 1 as i32 {
            // 1 = same SHA already a winner (transitive dup). 2 = higher
            // version already wins. Either way: skip without recursing or
            // building. Symbols of this project are already covered by the
            // existing winner.
            return Result::Ok(vec_new::<ExternalLib>());
        }
        if verdict == 0 as i32 - 1 as i32 {
            print_str(2, "lforge: project '");
            print_str(2, dview);
            print_str(2, "' requested at version '");
            print_str(2, tview);
            print_str(2, "' but a lower-version pin is already in this build's closure. ");
            println_str(2, "Full MVS upgrade not yet implemented; use a `replace:` directive in the manifest to choose explicitly.");
            return Result::Err(1);
        }
        let mut display_c: String = String::new();
        display_c.push_bytes(resolved_display.as_ptr(), resolved_display.len());
        let mut tag_c: String = String::new();
        tag_c.push_bytes(resolved_tag.as_ptr(), resolved_tag.len());
        let mut sha_c: String = String::new();
        sha_c.push_bytes(resolved_sha.as_ptr(), resolved_sha.len());
        winners.push(GitWinner { display: display_c, tag: tag_c, sha: sha_c });
    }

    // Cycle / duplicate guard: skip if we've already built this absolute
    // path. Returns empty Vec — modules already produced earlier in the
    // walk are visible via the parent's externals accumulator.
    let abs_path: String = make_absolute(str_from_raw(resolved_path.as_ptr(), resolved_path.len()));
    let abs_view: str = str_from_raw(abs_path.as_ptr(), abs_path.len());
    let vn: i64 = (*visited).length();
    let vp: *const Vec<String> = visited as *const Vec<String>;
    let mut vi: i64 = 0 as i64;
    while vi < vn {
        let s: *const String = vp.at_const(vi);
        let sv: str = str_from_raw((*s).as_ptr(), (*s).len());
        if str_eq_local(sv, abs_view) {
            return Result::Ok(vec_new::<ExternalLib>());
        }
        vi = vi + 1 as i64;
    }
    let mut abs_copy: String = String::new();
    abs_copy.push_bytes(abs_path.as_ptr(), abs_path.len());
    visited.push(abs_copy);

    let path_view: str = str_from_raw(resolved_path.as_ptr(), resolved_path.len());
    if chdir_str(path_view) != 0 {
        let mut msg: String = String::new();
        msg.push_str("lforge: cannot chdir into external dep ");
        msg.push_str(path_view);
        println_string(2, &msg);
        return Result::Err(1);
    }

    let m: Manifest = match read_manifest("./lforge.hermes") {
        Result::Err(e) => {
            print_str(2, "lforge: external dep ");
            print_str(2, path_view);
            print_str(2, ": ");
            println_str(2, str_from_raw(e.message.as_ptr(), e.message.len()));
            chdir_str(str_from_raw(saved.as_ptr(), saved.len()));
            return Result::Err(1);
        }
        Result::Ok(m) => { m }
    };

    // Recurse into the external's own project-level deps before building.
    // We're currently chdir'd in the external; child resolutions chdir
    // further and restore back to here.
    let mut out: Vec<ExternalLib> = vec_new::<ExternalLib>();
    let outp: *mut Vec<ExternalLib> = (&mut out) as *mut Vec<ExternalLib>;
    if m.deps.length() > 0 as i64 {
        match build_all_externals(&m.deps, profile, logosc, lock_in, lock_out, visited, winners) {
            Result::Err(rc) => {
                chdir_str(str_from_raw(saved.as_ptr(), saved.len()));
                return Result::Err(rc);
            }
            Result::Ok(sublibs) => {
                let sn: i64 = sublibs.length();
                let sp: *const Vec<ExternalLib> = (&sublibs) as *const Vec<ExternalLib>;
                let mut si: i64 = 0 as i64;
                while si < sn {
                    let lb: *const ExternalLib = sp.at_const(si);
                    let mut nm_c: String = String::new();
                    nm_c.push_bytes((*lb).name.as_ptr(), (*lb).name.len());
                    let mut ap_c: String = String::new();
                    ap_c.push_bytes((*lb).archive_path.as_ptr(), (*lb).archive_path.len());
                    outp.push(ExternalLib { name: nm_c, archive_path: ap_c });
                    si = si + 1 as i64;
                }
            }
        }
    }

    // Build only the requested modules. Each one must exist as a `kind: lib`
    // target in the external manifest.
    let mn: i64 = dep.modules.length();
    let mp: *const Vec<String> = (&dep.modules) as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < mn {
        let nm: *const String = mp.at_const(i);
        let nm_view: str = str_from_raw((*nm).as_ptr(), (*nm).len());
        let idx: i64 = find_target_index(&m.targets, nm_view);
        if idx < 0 as i64 {
            print_str(2, "lforge: external dep ");
            print_str(2, path_view);
            print_str(2, ": no lib target named ");
            println_str(2, nm_view);
            chdir_str(str_from_raw(saved.as_ptr(), saved.len()));
            return Result::Err(1);
        }
        let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
        let t: *const Target = tp.at_const(idx);
        match (*t).kind {
            TargetKind::Lib => { }
            TargetKind::Bin => {
                print_str(2, "lforge: external dep ");
                print_str(2, path_view);
                print_str(2, ": '");
                print_str(2, nm_view);
                println_str(2, "' is a bin target — only libs can be exported");
                chdir_str(str_from_raw(saved.as_ptr(), saved.len()));
                return Result::Err(1);
            }
        }
        // External's lib is built with the closure of already-resolved
        // externals (its own deps + their transitives) visible to logosc.
        let rc: i32 = build_lib(&(*t), profile, logosc, &out);
        if rc != 0 {
            print_str(2, "lforge: external dep ");
            print_str(2, path_view);
            print_str(2, ": build of '");
            print_str(2, nm_view);
            println_str(2, "' failed");
            chdir_str(str_from_raw(saved.as_ptr(), saved.len()));
            return Result::Err(rc);
        }
        // Resolve the produced archive to an absolute path so the consumer
        // can reference it after we chdir back.
        let rel_arch: String = lib_archive_path(profile, nm_view);
        let abs_arch: String = make_absolute(str_from_raw(rel_arch.as_ptr(), rel_arch.len()));
        let mut nm_copy: String = String::new();
        nm_copy.push_bytes((*nm).as_ptr(), (*nm).len());
        outp.push(ExternalLib { name: nm_copy, archive_path: abs_arch });
        i = i + 1 as i64;
    }

    if chdir_str(str_from_raw(saved.as_ptr(), saved.len())) != 0 {
        println_str(2, "lforge: cannot restore cwd after building external dep");
        return Result::Err(1);
    }
    return Result::Ok(out);
}

unsafe fn build_all_externals(deps: &Vec<ExternalDep>, profile: str, logosc: &String,
                              lock_in: &Vec<LockEntry>,
                              lock_out: *mut Vec<LockEntry>,
                              visited:  *mut Vec<String>,
                              winners:  *mut Vec<GitWinner>) -> Result<Vec<ExternalLib>, i32> {
    let mut all: Vec<ExternalLib> = vec_new::<ExternalLib>();
    let allp: *mut Vec<ExternalLib> = (&mut all) as *mut Vec<ExternalLib>;
    let n: i64 = deps.length();
    let dp: *const Vec<ExternalDep> = deps as *const Vec<ExternalDep>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let d: *const ExternalDep = dp.at_const(i);
        match build_external(&(*d), profile, logosc, lock_in, lock_out, visited, winners) {
            Result::Err(rc) => { return Result::Err(rc); }
            Result::Ok(libs) => {
                let m: i64 = libs.length();
                let lp: *const Vec<ExternalLib> = (&libs) as *const Vec<ExternalLib>;
                let mut j: i64 = 0 as i64;
                while j < m {
                    let lb: *const ExternalLib = lp.at_const(j);
                    let mut nm_copy: String = String::new();
                    nm_copy.push_bytes((*lb).name.as_ptr(), (*lb).name.len());
                    let mut ap_copy: String = String::new();
                    ap_copy.push_bytes((*lb).archive_path.as_ptr(), (*lb).archive_path.len());
                    allp.push(ExternalLib { name: nm_copy, archive_path: ap_copy });
                    j = j + 1 as i64;
                }
            }
        }
        i = i + 1 as i64;
    }
    return Result::Ok(all);
}

unsafe fn external_lookup(externals: &Vec<ExternalLib>, name: str) -> i64 {
    let n: i64 = externals.length();
    let lp: *const Vec<ExternalLib> = externals as *const Vec<ExternalLib>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let lb: *const ExternalLib = lp.at_const(i);
        let nm_view: str = str_from_raw((*lb).name.as_ptr(), (*lb).name.len());
        if str_eq_local(nm_view, name) { return i; }
        i = i + 1 as i64;
    }
    return 0 as i64 - 1 as i64;
}

// -- Git URL helpers (B2.5) -----------------------------------------------

unsafe fn home_dir() -> String {
    let key: *mut u8 = cstr("HOME");
    let val: *const u8 = getenv(key as *const u8);
    dealloc(key);
    let mut out: String = String::new();
    if val != 0 as *const u8 { out.push_str(str_from_cstr(val)); }
    return out;
}

unsafe fn find_byte(s: str, b: u8) -> i64 {
    let n: i64 = s.len();
    let mut i: i64 = 0 as i64;
    while i < n {
        if s.as_ptr()[i] == b { return i; }
        i = i + 1 as i64;
    }
    return 0 as i64 - 1 as i64;
}

unsafe fn slice_from_off(s: str, off: i64) -> str {
    let p: *const u8 = (s.as_ptr() as i64 + off) as *const u8;
    let n: i64 = s.len() - off;
    return str_from_raw(p, n);
}

unsafe fn ends_with_dot_git(s: str) -> bool {
    return str_ends_with(s, ".git");
}

unsafe fn strip_dot_git_inplace(s: &mut String) {
    let view: str = str_from_raw(s.as_ptr(), s.len());
    let has: bool = str_ends_with(view, ".git");
    if has { s.truncate(s.len() - 4 as i64); }
}

// Compute (display_id, fetch_url) from a manifest-supplied `project` string.
//   bare host/path             -- prepend https://
//   https:// or http://        -- use as-is
//   ssh:// (with optional user@)  -- use as-is, strip user@ from display
//   user@host:path SCP-style   -- use as-is, replace `:` with `/` in display
// Always: ensure fetch ends with `.git`; display drops `.git` and scheme.
// Find first occurrence of "://" — returns offset of the ':' or -1.
unsafe fn find_scheme_sep(s: str) -> i64 {
    let n: i64 = s.len();
    if n < 3 as i64 { return 0 as i64 - 1 as i64; }
    let mut i: i64 = 0 as i64;
    while i + 2 as i64 < n {
        let a: i32 = s.as_ptr()[i + 0 as i64] as i32;
        let b: i32 = s.as_ptr()[i + 1 as i64] as i32;
        let c: i32 = s.as_ptr()[i + 2 as i64] as i32;
        if a == 58 as i32 && b == 47 as i32 && c == 47 as i32 { return i; }
        i = i + 1 as i64;
    }
    return 0 as i64 - 1 as i64;
}

unsafe fn canonical_url(project: str) -> (String, String) {
    let mut display: String = String::new();
    let mut fetch:   String = String::new();

    let scheme_off: i64 = find_scheme_sep(project);
    let is_gh:    bool = str_starts_with(project, "github.com/");

    if scheme_off >= 0 as i64 {
        // <scheme>://<rest>
        let after: str = slice_from_off(project, scheme_off + 3 as i64);
        // For ssh:// strip optional user@ from display.
        let is_ssh: bool = str_starts_with(project, "ssh://");
        if is_ssh {
            let at_off: i64 = find_byte(after, 64 as u8);
            if at_off >= 0 as i64 {
                display.push_str(slice_from_off(after, at_off + 1 as i64));
            } else {
                display.push_str(after);
            }
        } else {
            display.push_str(after);
        }
        fetch.push_str(project);
    } else {
        // No scheme. Either SCP shorthand (`user@host:path`) or bare host/path.
        let at_off: i64 = find_byte(project, 64 as u8);
        let cl_off: i64 = find_byte(project, 58 as u8);
        let is_scp: bool = at_off >= 0 as i64 && cl_off > at_off && is_gh == false;
        if is_scp {
            let after_at: str = slice_from_off(project, at_off + 1 as i64);
            let cn: i64 = after_at.len();
            let mut k: i64 = 0 as i64;
            while k < cn {
                let bb: u8 = after_at.as_ptr()[k];
                let cc: i32 = bb as i32;
                if cc == 58 as i32 { display.push_u8(47 as u8); }
                else               { display.push_u8(bb); }
                k = k + 1 as i64;
            }
            fetch.push_str(project);
        } else {
            display.push_str(project);
            fetch.push_str("https://");
            fetch.push_str(project);
        }
    }

    strip_dot_git_inplace(&mut display);
    let fview: str = str_from_raw(fetch.as_ptr(), fetch.len());
    let has_g: bool = ends_with_dot_git(fview);
    let is_file_scheme: bool = str_starts_with(project, "file://");
    if has_g == false && is_file_scheme == false { fetch.push_str(".git"); }

    return (display, fetch);
}

// `/`, `:`, `@` -> `_` so the display id can be used as a directory name.
unsafe fn display_to_dirname(display: str) -> String {
    let mut out: String = String::new();
    let n: i64 = display.len();
    let mut i: i64 = 0 as i64;
    while i < n {
        let bb: u8 = display.as_ptr()[i];
        let cc: i32 = bb as i32;
        if cc == 47 as i32 { out.push_u8(95 as u8); }
        else if cc == 58 as i32 { out.push_u8(95 as u8); }
        else if cc == 64 as i32 { out.push_u8(95 as u8); }
        else { out.push_u8(bb); }
        i = i + 1 as i64;
    }
    return out;
}

unsafe fn lforge_cache_src_dir() -> String {
    let h: String = home_dir();
    if h.len() == 0 as i64 { return String::new(); }
    let mut out: String = String::new();
    out.push_bytes(h.as_ptr(), h.len());
    append_path(&mut out, ".cache");
    append_path(&mut out, "lforge");
    append_path(&mut out, "src");
    return out;
}

// -- Lockfile (B3) ---------------------------------------------------------

unsafe fn parse_lockfile(text: str) -> Vec<LockEntry> {
    let mut z: Zone<Mutable> = zone_create(8192);
    if !hermes_parse(text.as_ptr(), text.len(), &mut z) { return vec_new::<LockEntry>(); }
    let view: HermesView<'a> = HermesView {
        base: z.holder.base as *const u8,
        size: z.holder.used as u64,
    };
    let root: AnyVal = view.root();
    let base: *const u8 = view.base();
    if !root.is_map(base) { return vec_new::<LockEntry>(); }
    let pinned_av: AnyVal = view.map_get(root, "pinned");
    if !pinned_av.is_array(base) { return vec_new::<LockEntry>(); }
    let mut out: Vec<LockEntry> = vec_new::<LockEntry>();
    let outp: *mut Vec<LockEntry> = (&mut out) as *mut Vec<LockEntry>;
    let n: u64 = view.array_len(pinned_av);
    let mut i: u64 = 0 as u64;
    while i < n {
        let e_av: AnyVal = view.array_get(pinned_av, i);
        i = i + 1 as u64;
        if !e_av.is_map(base) { continue; }
        let proj: String = read_str_opt(&view, e_av, "project");
        let tag:  String = read_str_opt(&view, e_av, "tag");
        let sha:  String = read_str_opt(&view, e_av, "sha");
        if proj.len() == 0 as i64 || sha.len() == 0 as i64 { continue; }
        outp.push(LockEntry { project: proj, tag: tag, sha: sha });
    }
    return out;
}

unsafe fn read_lockfile_or_empty(path: str) -> Vec<LockEntry> {
    let cs: *mut u8 = cstr(path);
    let exists: bool = is_file(cs as *const u8);
    if exists == false {
        dealloc(cs);
        return vec_new::<LockEntry>();
    }
    let body: Result<String, i32> = read_to_string(cs as *const u8);
    dealloc(cs);
    match body {
        Result::Err(_) => { return vec_new::<LockEntry>(); }
        Result::Ok(s)  => {
            return parse_lockfile(str_from_raw(s.as_ptr(), s.len()));
        }
    }
}

unsafe fn lookup_lock_sha(lock: &Vec<LockEntry>, project: str, expected_tag: str) -> String {
    let n: i64 = lock.length();
    let lp: *const Vec<LockEntry> = lock as *const Vec<LockEntry>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let le: *const LockEntry = lp.at_const(i);
        let pv: str = str_from_raw((*le).project.as_ptr(), (*le).project.len());
        if str_eq_local(pv, project) {
            // If expected_tag is non-empty, require it match the locked tag.
            // Empty expected_tag means "branch or sha" form -- accept any.
            if expected_tag.len() == 0 as i64 {
                let mut s: String = String::new();
                s.push_bytes((*le).sha.as_ptr(), (*le).sha.len());
                return s;
            }
            let tv: str = str_from_raw((*le).tag.as_ptr(), (*le).tag.len());
            if str_eq_local(tv, expected_tag) {
                let mut s: String = String::new();
                s.push_bytes((*le).sha.as_ptr(), (*le).sha.len());
                return s;
            }
        }
        i = i + 1 as i64;
    }
    return String::new();
}

unsafe fn write_lockfile(path: str, entries: &Vec<LockEntry>) -> i32 {
    let mut buf: String = String::new();
    buf.push_str("// Auto-generated by lforge. DO NOT EDIT.\n");
    buf.push_str("{\n    pinned: [\n");
    let n: i64 = entries.length();
    let ep: *const Vec<LockEntry> = entries as *const Vec<LockEntry>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let le: *const LockEntry = ep.at_const(i);
        buf.push_str("        { project: \"");
        buf.push_bytes((*le).project.as_ptr(), (*le).project.len());
        buf.push_str("\", tag: \"");
        buf.push_bytes((*le).tag.as_ptr(), (*le).tag.len());
        buf.push_str("\", sha: \"");
        buf.push_bytes((*le).sha.as_ptr(), (*le).sha.len());
        buf.push_str("\" }");
        if i + 1 as i64 < n { buf.push_str(","); }
        buf.push_str("\n");
        i = i + 1 as i64;
    }
    buf.push_str("    ]\n}\n");
    let cs: *mut u8 = cstr(path);
    let res: Result<i32, i32> = write_string(cs as *const u8, &buf);
    dealloc(cs);
    match res {
        Result::Err(_) => { return 0 - 1; }
        Result::Ok(_)  => { return 0; }
    }
}

// Compare two version-ish tags. Returns:
//   <0  if a < b
//    0  if a == b (or both unparseable and string-equal)
//   >0  if a > b
//
// Recognised shape: optional leading `v`, then dot-separated decimal
// segments (`v1.2.3`, `1.0`). Trailing pre-release suffixes ("v1.0-rc1")
// fall back to lexical compare. For tags that don't fit the shape, we
// just compare strings.
unsafe fn cmp_tags(a: str, b: str) -> i32 {
    if a.len() == 0 as i64 && b.len() == 0 as i64 { return 0 as i32; }
    if a.len() == 0 as i64 { return 0 as i32 - 1 as i32; }
    if b.len() == 0 as i64 { return 1 as i32; }
    let mut ai: i64 = 0 as i64;
    let mut bi: i64 = 0 as i64;
    if a.as_ptr()[0] == 118 as u8 { ai = 1 as i64; }   // 'v'
    if b.as_ptr()[0] == 118 as u8 { bi = 1 as i64; }
    let an: i64 = a.len();
    let bn: i64 = b.len();
    loop {
        let mut av: i64 = 0 as i64;
        let mut have_a: bool = false;
        while ai < an {
            let cc: i32 = a.as_ptr()[ai] as i32;
            if cc < 48 as i32 || cc > 57 as i32 { break; }
            av = av * 10 as i64 + (cc - 48 as i32) as i64;
            have_a = true;
            ai = ai + 1 as i64;
        }
        let mut bv: i64 = 0 as i64;
        let mut have_b: bool = false;
        while bi < bn {
            let cc: i32 = b.as_ptr()[bi] as i32;
            if cc < 48 as i32 || cc > 57 as i32 { break; }
            bv = bv * 10 as i64 + (cc - 48 as i32) as i64;
            have_b = true;
            bi = bi + 1 as i64;
        }
        if have_a == false && have_b == false {
            // Neither side has more numeric segments. Lexical compare on tail.
            let mut i: i64 = 0 as i64;
            let ar: i64 = an - ai;
            let br: i64 = bn - bi;
            let mut lim: i64 = ar;
            if br < ar { lim = br; }
            while i < lim {
                let ca: i32 = a.as_ptr()[ai + i] as i32;
                let cb: i32 = b.as_ptr()[bi + i] as i32;
                if ca < cb { return 0 as i32 - 1 as i32; }
                if ca > cb { return 1 as i32; }
                i = i + 1 as i64;
            }
            if ar < br { return 0 as i32 - 1 as i32; }
            if ar > br { return 1 as i32; }
            return 0 as i32;
        }
        if have_a == false { return 0 as i32 - 1 as i32; }
        if have_b == false { return 1 as i32; }
        if av < bv { return 0 as i32 - 1 as i32; }
        if av > bv { return 1 as i32; }
        // Skip a `.` separator on each side if present.
        if ai < an && a.as_ptr()[ai] == 46 as u8 { ai = ai + 1 as i64; }
        if bi < bn && b.as_ptr()[bi] == 46 as u8 { bi = bi + 1 as i64; }
    }
    return 0 as i32;
}

// Returns:
//   0  → no conflict; ok to proceed (and caller should add to winners on success)
//   1  → already a winner with this exact SHA (skip; transitive dup)
//   2  → already a winner with HIGHER tag — skip this dep silently
//  -1  → already a winner with LOWER tag — current request would upgrade,
//        which v1 doesn't support; caller errors out.
unsafe fn check_git_winner(winners: &Vec<GitWinner>, display: str, tag: str, sha: str) -> i32 {
    let n: i64 = winners.length();
    let wp: *const Vec<GitWinner> = winners as *const Vec<GitWinner>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let w: *const GitWinner = wp.at_const(i);
        let dv: str = str_from_raw((*w).display.as_ptr(), (*w).display.len());
        if str_eq_local(dv, display) {
            let sv: str = str_from_raw((*w).sha.as_ptr(), (*w).sha.len());
            if str_eq_local(sv, sha) { return 1 as i32; }
            let tv: str = str_from_raw((*w).tag.as_ptr(), (*w).tag.len());
            let cmp: i32 = cmp_tags(tv, tag);
            if cmp >= 0 as i32 { return 2 as i32; }
            return 0 as i32 - 1 as i32;
        }
        i = i + 1 as i64;
    }
    return 0 as i32;
}

unsafe fn looks_like_sha(s: str) -> bool {
    let n: i64 = s.len();
    if n < 7 as i64    { return false; }
    if n > 40 as i64   { return false; }
    let mut i: i64 = 0 as i64;
    while i < n {
        let cc: i32 = s.as_ptr()[i] as i32;
        let d:  bool = cc >= 48 as i32 && cc <= 57 as i32;
        let lo: bool = cc >= 97 as i32 && cc <= 102 as i32;
        let up: bool = cc >= 65 as i32 && cc <= 70 as i32;
        if d == false && lo == false && up == false { return false; }
        i = i + 1 as i64;
    }
    return true;
}

// Resolve a `git ls-remote <url> <ref>` output line to its SHA. `ref` may
// be a tag, branch, or already-a-SHA (echoed back).
unsafe fn git_resolve_sha(fetch_url: str, ref_str: str) -> Result<String, i32> {
    if looks_like_sha(ref_str) {
        let mut s: String = String::new();
        s.push_str(ref_str);
        return Result::Ok(s);
    }

    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_arg(argv_p, "git");
    push_arg(argv_p, "ls-remote");
    push_arg(argv_p, "--exit-code");
    let mut url_s: String = String::new();
    url_s.push_str(fetch_url);
    push_string_arg(argv_p, &url_s);
    let mut ref_s: String = String::new();
    ref_s.push_str(ref_str);
    push_string_arg(argv_p, &ref_s);

    let res: (i32, String) = run_child_capture_stdout(&argv);
    let rc:  i32 = res.0;
    let out: String = res.1;
    if rc != 0 {
        print_str(2, "lforge: git ls-remote failed for ");
        print_str(2, fetch_url);
        print_str(2, " ref=");
        println_str(2, ref_str);
        return Result::Err(rc);
    }
    let view: str = str_from_raw(out.as_ptr(), out.len());
    let nl: i64 = find_byte(view, 10 as u8);
    let mut end: i64 = view.len();
    if nl >= 0 as i64 { end = nl; }
    // First whitespace token = SHA.
    let mut tok_end: i64 = end;
    let tab_off: i64 = find_byte(view, 9 as u8);
    if tab_off >= 0 as i64 && tab_off < tok_end { tok_end = tab_off; }
    let sp_off: i64 = find_byte(view, 32 as u8);
    if sp_off >= 0 as i64 && sp_off < tok_end { tok_end = sp_off; }
    if tok_end == 0 as i64 {
        println_str(2, "lforge: git ls-remote returned empty SHA");
        return Result::Err(1);
    }
    let mut sha: String = String::new();
    sha.push_bytes(view.as_ptr(), tok_end);
    return Result::Ok(sha);
}

// Clone fetch_url into dest_dir then checkout the given SHA. dest_dir
// must not exist.
unsafe fn git_clone_at_sha(fetch_url: str, sha: str, dest_dir: str) -> i32 {
    let mut a1: Vec<String> = vec_new::<String>();
    let a1p: *mut Vec<String> = (&mut a1) as *mut Vec<String>;
    push_arg(a1p, "git");
    push_arg(a1p, "clone");
    push_arg(a1p, "--quiet");
    let mut url_s: String = String::new(); url_s.push_str(fetch_url);
    push_string_arg(a1p, &url_s);
    let mut dst_s: String = String::new(); dst_s.push_str(dest_dir);
    push_string_arg(a1p, &dst_s);
    let rc1: i32 = run_child(&a1);
    if rc1 != 0 { return rc1; }

    let mut a2: Vec<String> = vec_new::<String>();
    let a2p: *mut Vec<String> = (&mut a2) as *mut Vec<String>;
    push_arg(a2p, "git");
    push_arg(a2p, "-C");
    push_string_arg(a2p, &dst_s);
    push_arg(a2p, "checkout");
    push_arg(a2p, "--quiet");
    let mut sha_s: String = String::new(); sha_s.push_str(sha);
    push_string_arg(a2p, &sha_s);
    return run_child(&a2);
}

// Resolve a git ExternalDep into an absolute filesystem path. Returns
// (cache_path, display_id, sha). Lockfile fast-path: if `lock_in` has
// an entry for this project AND the manifest's expected ref matches the
// lock's tag (or is sha/branch form), the locked SHA is used and
// ls-remote is skipped. Either way, we record the resolved entry into
// `lock_out` so the freshly written lockfile reflects the build.
unsafe fn resolve_git_dep(dep:  &ExternalDep,
                          lock_in:  &Vec<LockEntry>,
                          lock_out: *mut Vec<LockEntry>) -> Result<(String, String, String), i32> {
    let proj_view: str = str_from_raw(dep.project.as_ptr(), dep.project.len());
    let pair: (String, String) = canonical_url(proj_view);
    let display: String = pair.0;
    let fetch:   String = pair.1;

    let mut ref_s: String = String::new();
    if dep.tag.len() > 0 as i64 {
        ref_s.push_bytes(dep.tag.as_ptr(), dep.tag.len());
    } else if dep.branch.len() > 0 as i64 {
        ref_s.push_bytes(dep.branch.as_ptr(), dep.branch.len());
    } else {
        ref_s.push_bytes(dep.sha.as_ptr(), dep.sha.len());
    }

    let display_view: str = str_from_raw(display.as_ptr(), display.len());
    let mut sha: String = String::new();
    if dep.tag.len() > 0 as i64 {
        sha = lookup_lock_sha(lock_in, display_view, str_from_raw(dep.tag.as_ptr(), dep.tag.len()));
    }
    if sha.len() == 0 as i64 {
        let fetch_view: str = str_from_raw(fetch.as_ptr(), fetch.len());
        let ref_view:   str = str_from_raw(ref_s.as_ptr(),  ref_s.len());
        sha = match git_resolve_sha(fetch_view, ref_view) {
            Result::Err(rc) => { return Result::Err(rc); }
            Result::Ok(s)  => { s }
        };
    }

    let cache_root: String = lforge_cache_src_dir();
    if cache_root.len() == 0 as i64 {
        println_str(2, "lforge: $HOME unset -- cannot locate ~/.cache/lforge");
        return Result::Err(1);
    }
    let dirname: String = display_to_dirname(display_view);

    // Ensure parent dir <cache_root>/<dirname>/ exists.
    let mut parent: String = String::new();
    parent.push_bytes(cache_root.as_ptr(), cache_root.len());
    append_path(&mut parent, str_from_raw(dirname.as_ptr(), dirname.len()));
    let pview: str = str_from_raw(parent.as_ptr(), parent.len());
    match mkdir_p(pview) {
        Result::Err(_) => { println_str(2, "lforge: cannot create cache parent dir"); return Result::Err(1); }
        Result::Ok(_)  => { }
    }

    // Full cache dir = parent / sha.
    let mut full: String = String::new();
    full.push_bytes(parent.as_ptr(), parent.len());
    append_path(&mut full, str_from_raw(sha.as_ptr(), sha.len()));

    // Cache hit: <full>/lforge.hermes already there.
    let mut manifest_path: String = String::new();
    manifest_path.push_bytes(full.as_ptr(), full.len());
    append_path(&mut manifest_path, "lforge.hermes");
    let mc_cs: *mut u8 = cstr(str_from_raw(manifest_path.as_ptr(), manifest_path.len()));
    let cache_hit: bool = is_file(mc_cs as *const u8);
    dealloc(mc_cs);

    if cache_hit == false {
        let full_view: str = str_from_raw(full.as_ptr(), full.len());
        let cs_full: *mut u8 = cstr(full_view);
        let exists: bool = is_dir(cs_full as *const u8);
        dealloc(cs_full);
        if exists {
            match rm_rf(full_view) {
                Result::Err(_) => {
                    println_str(2, "lforge: cannot wipe stale cache dir");
                    return Result::Err(1);
                }
                Result::Ok(_) => { }
            }
        }
        let fetch_view: str = str_from_raw(fetch.as_ptr(), fetch.len());
        print_str(1, "lforge: fetching ");
        print_str(1, display_view);
        print_str(1, " @ ");
        println_str(1, str_from_raw(sha.as_ptr(), sha.len()));
        let rc: i32 = git_clone_at_sha(fetch_view,
                                       str_from_raw(sha.as_ptr(), sha.len()),
                                       full_view);
        if rc != 0 { return Result::Err(rc); }
    }

    // Record the resolved entry for the freshly written lockfile.
    let mut tag_copy: String = String::new();
    if dep.tag.len() > 0 as i64 {
        tag_copy.push_bytes(dep.tag.as_ptr(), dep.tag.len());
    }
    let mut display_lc: String = String::new();
    display_lc.push_bytes(display.as_ptr(), display.len());
    let mut sha_lc: String = String::new();
    sha_lc.push_bytes(sha.as_ptr(), sha.len());
    let already: bool = lookup_lock_sha(&(*lock_out), display_view,
                                        str_from_raw(tag_copy.as_ptr(), tag_copy.len())).len() > 0 as i64;
    if already == false {
        lock_out.push(LockEntry {
            project: display_lc,
            tag:     tag_copy,
            sha:     sha_lc,
        });
    }

    return Result::Ok((full, display, sha));
}

// ── Tool resolution ───────────────────────────────────────────────────────

unsafe fn resolve_logos_lib_dir() -> String {
    let env_key: *mut u8 = cstr("LOGOS_LIB_DIR");
    let env_val: *const u8 = getenv(env_key as *const u8);
    dealloc(env_key);
    if env_val != 0 as *const u8 {
        let s: str = str_from_cstr(env_val);
        let mut out: String = String::new();
        out.push_str(s);
        return out;
    }
    let candidates: [str; 2] = ["./build/lib/logos", "/usr/local/lib/logos"];
    let mut i: i64 = 0 as i64;
    while i < 2 as i64 {
        let c: str = candidates[i];
        let cs: *mut u8 = cstr(c);
        let ok: bool = is_dir(cs as *const u8);
        dealloc(cs);
        if ok {
            let mut out: String = String::new();
            out.push_str(c);
            return out;
        }
        i = i + 1 as i64;
    }
    return String::new();
}

unsafe fn resolve_logosc_path() -> String {
    let env_key: *mut u8 = cstr("LOGOSC");
    let env_val: *const u8 = getenv(env_key as *const u8);
    dealloc(env_key);
    if env_val != 0 as *const u8 {
        let s: str = str_from_cstr(env_val);
        let mut out: String = String::new();
        out.push_str(s);
        return out;
    }
    let cs: *mut u8 = cstr("./build/bin/logosc");
    let ok: bool = is_file(cs as *const u8);
    dealloc(cs);
    let mut out: String = String::new();
    if ok { out.push_str("./build/bin/logosc"); }
    else  { out.push_str("logosc"); }
    return out;
}

// ── Process orchestration ─────────────────────────────────────────────────

unsafe fn push_arg(args: *mut Vec<String>, s: str) {
    let mut a: String = String::new();
    a.push_str(s);
    args.push(a);
}

unsafe fn push_string_arg(args: *mut Vec<String>, s: &String) {
    let mut a: String = String::new();
    a.push_bytes(s.as_ptr(), s.len());
    args.push(a);
}

unsafe fn run_child(argv_strs: &Vec<String>) -> i32 {
    let n: i64 = argv_strs.length();
    let argv_buf: *mut *const u8 = alloc((n + 1 as i64) * 8 as i64) as *mut *const u8;
    let mut i: i64 = 0 as i64;
    let ap: *const Vec<String> = argv_strs as *const Vec<String>;
    while i < n {
        let s: *const String = ap.at_const(i);
        argv_buf[i] = (*s).as_ptr();
        i = i + 1 as i64;
    }
    argv_buf[n] = 0 as *const u8;

    let mut child: Child = spawn(argv_buf as *const *const u8, false, true, true);
    if child.pid() < 0 {
        dealloc(argv_buf as *mut u8);
        return 0 - 1;
    }

    let mut lr_out: LineReader = child.stdout_lines();
    loop {
        match lr_out.next() {
            Option::Some(line) => { println_str(1, str_from_raw(line.as_ptr(), line.len())); }
            Option::None       => { break; }
        }
    }
    let mut lr_err: LineReader = child.stderr_lines();
    loop {
        match lr_err.next() {
            Option::Some(line) => { println_str(2, str_from_raw(line.as_ptr(), line.len())); }
            Option::None       => { break; }
        }
    }
    let st: ExitStatus = child.wait();
    dealloc(argv_buf as *mut u8);
    return st.code();
}

// Spawn `argv` and capture stdout into a String. Stderr is forwarded to the
// parent's stderr. Used for short-output commands like `git ls-remote`.
unsafe fn run_child_capture_stdout(argv_strs: &Vec<String>) -> (i32, String) {
    let n: i64 = argv_strs.length();
    let argv_buf: *mut *const u8 = alloc((n + 1 as i64) * 8 as i64) as *mut *const u8;
    let mut i: i64 = 0 as i64;
    let ap: *const Vec<String> = argv_strs as *const Vec<String>;
    while i < n {
        let s: *const String = ap.at_const(i);
        argv_buf[i] = (*s).as_ptr();
        i = i + 1 as i64;
    }
    argv_buf[n] = 0 as *const u8;

    let mut child: Child = spawn(argv_buf as *const *const u8, false, true, true);
    if child.pid() < 0 {
        dealloc(argv_buf as *mut u8);
        return (0 - 1, String::new());
    }

    let mut out: String = String::new();
    let mut lr_out: LineReader = child.stdout_lines();
    loop {
        match lr_out.next() {
            Option::Some(line) => {
                if out.len() > 0 as i64 { out.push_u8(10 as u8); }
                out.push_bytes(line.as_ptr(), line.len());
            }
            Option::None => { break; }
        }
    }
    let mut lr_err: LineReader = child.stderr_lines();
    loop {
        match lr_err.next() {
            Option::Some(line) => { println_str(2, str_from_raw(line.as_ptr(), line.len())); }
            Option::None       => { break; }
        }
    }
    let st: ExitStatus = child.wait();
    dealloc(argv_buf as *mut u8);
    return (st.code(), out);
}

// ── Build helpers ─────────────────────────────────────────────────────────

unsafe fn out_dir_for(profile: str) -> String {
    let mut d: String = String::new();
    d.push_str(".lforge/");
    d.push_str(profile);
    d.push_str("/out");
    return d;
}

unsafe fn gen_dir_for(profile: str) -> String {
    let mut d: String = String::new();
    d.push_str(".lforge/");
    d.push_str(profile);
    d.push_str("/_gen");
    return d;
}

// Path of the .a archive a lib target produces.
unsafe fn lib_archive_path(profile: str, lib_name: str) -> String {
    let mut p: String = out_dir_for(profile);
    p.push_str("/lib");
    p.push_str(lib_name);
    p.push_str(".a");
    return p;
}

// Path of the bin executable a bin target produces.
unsafe fn bin_path(profile: str, bin_name: str) -> String {
    let mut p: String = out_dir_for(profile);
    p.push_u8(47 as u8);
    p.push_str(bin_name);
    return p;
}

// Resolve dep names → archive paths. Externals shadow local libs of the
// same name (consumer's t.deps already declared the name; the project that
// defines a lib with that name wins). Order preserved from the bin target's
// manifest.
unsafe fn dep_archive_paths(targets: &Vec<Target>, deps: &Vec<String>, profile: str,
                            externals: &Vec<ExternalLib>) -> Vec<String> {
    let mut out: Vec<String> = vec_new::<String>();
    let outp: *mut Vec<String> = (&mut out) as *mut Vec<String>;
    let dn: i64 = deps.length();
    let dp: *const Vec<String> = deps as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < dn {
        let nm: *const String = dp.at_const(i);
        let nm_view: str = str_from_raw((*nm).as_ptr(), (*nm).len());
        let ei: i64 = external_lookup(externals, nm_view);
        if ei >= 0 as i64 {
            let lp: *const Vec<ExternalLib> = externals as *const Vec<ExternalLib>;
            let lb: *const ExternalLib = lp.at_const(ei);
            let mut p: String = String::new();
            p.push_bytes((*lb).archive_path.as_ptr(), (*lb).archive_path.len());
            outp.push(p);
        } else {
            let p: String = lib_archive_path(profile, nm_view);
            outp.push(p);
        }
        i = i + 1 as i64;
    }
    return out;
}

// ── Incremental rebuild (mtime-based) ─────────────────────────────────────
//
// Action skip rule: if the output file exists and its mtime is >= the max
// mtime of every input file, the action is fresh and we skip the spawn.
// Matches the cmake/ninja default behavior (which is what users expect).
//
// A future slice can replace this with content-hash keyed CAS — the
// primitives are already in tests/logos/pass/lforge_graph_cas.logos.

unsafe fn collect_logos_files(dir: str) -> Vec<String> {
    let mut out: Vec<String> = vec_new::<String>();
    let outp: *mut Vec<String> = (&mut out) as *mut Vec<String>;
    let cs: *mut u8 = cstr(dir);
    let exists_dir: bool = is_dir(cs as *const u8);
    dealloc(cs);
    if exists_dir {
        let entries: Vec<DirEntry> = walk_dir(dir);
        let ep: *const Vec<DirEntry> = (&entries) as *const Vec<DirEntry>;
        let n: i64 = entries.length();
        let mut i: i64 = 0 as i64;
        while i < n {
            let de: *const DirEntry = ep.at_const(i);
            i = i + 1 as i64;
            if (*de).is_dir { continue; }
            let pview: str = str_from_raw((*de).name.as_ptr(), (*de).name.len());
            let pn: i64 = pview.len();
            if pn < 6 as i64 { continue; }
            let suffix: str = ".logos";
            let off: i64 = pn - 6 as i64;
            let mut ok: bool = true;
            let mut sk: i64 = 0 as i64;
            while sk < 6 as i64 && ok {
                if pview[off + sk] != suffix[sk] { ok = false; }
                sk = sk + 1 as i64;
            }
            if !ok { continue; }
            let mut p: String = String::new();
            p.push_str(pview);
            outp.push(p);
        }
    }
    return out;
}

// Latest mtime in a list of file paths; returns 0 if list is empty or every
// stat fails.
unsafe fn newest_mtime(paths: &Vec<String>) -> i64 {
    let mut max_mt: i64 = 0 as i64;
    let n: i64 = paths.length();
    let pp: *const Vec<String> = paths as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let s: *const String = pp.at_const(i);
        let cs: *mut u8 = cstr(str_from_raw((*s).as_ptr(), (*s).len()));
        let mt: Result<i64, i32> = mtime_ns(cs as *const u8);
        dealloc(cs);
        match mt {
            Result::Ok(t)  => { if t > max_mt { max_mt = t; } }
            Result::Err(_) => { }
        }
        i = i + 1 as i64;
    }
    return max_mt;
}

// True if `out_path` exists and its mtime is >= every input mtime.
unsafe fn output_is_fresh(out_path: str, max_input_mt: i64) -> bool {
    let cs: *mut u8 = cstr(out_path);
    let ok: bool = exists(cs as *const u8);
    if !ok { dealloc(cs); return false; }
    let mt: Result<i64, i32> = mtime_ns(cs as *const u8);
    dealloc(cs);
    match mt {
        Result::Ok(t)  => { return t >= max_input_mt; }
        Result::Err(_) => { return false; }
    }
}

// ── Per-target build actions ──────────────────────────────────────────────

// Spawn an action without piping stdout/stderr — child inherits the
// parent's fds. Used for parallel fan-out where capturing N concurrent
// pipes would either serialise them or require multiplexing. Output
// interleaving is per-line-atomic on libc-line-buffered streams; good
// enough for build progress.
unsafe fn spawn_inherit(argv: &Vec<String>) -> Child {
    let n: i64 = argv.length();
    let argv_buf: *mut *const u8 = alloc((n + 1 as i64) * 8 as i64) as *mut *const u8;
    let ap: *const Vec<String> = argv as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let s: *const String = ap.at_const(i);
        argv_buf[i] = (*s).as_ptr();
        i = i + 1 as i64;
    }
    argv_buf[n] = 0 as *const u8;
    let child: Child = spawn(argv_buf as *const *const u8, false, false, false);
    dealloc(argv_buf as *mut u8);
    return child;
}

// Per-file artifact paths under .lforge/<profile>/_files/<lib_name>/.
unsafe fn per_file_dir(profile: str, lib_name: str) -> String {
    let mut d: String = String::new();
    d.push_str(".lforge/");
    d.push_str(profile);
    d.push_str("/_files/");
    d.push_str(lib_name);
    return d;
}

// `<dir>/<stem>` — basename of source without `.logos` extension, joined
// with the per-lib output dir. Caller appends `.o` / `.hermes0`.
unsafe fn per_file_prefix(dir: &String, src_path: &String) -> String {
    let stem_str: String = stem(str_from_raw(src_path.as_ptr(), src_path.len()));
    let mut p: String = String::new();
    p.push_bytes(dir.as_ptr(), dir.len());
    p.push_u8(47 as u8);
    p.push_bytes(stem_str.as_ptr(), stem_str.len());
    return p;
}

// `<dir>/<basename>.o` — used for native (C/asm) sources. The full
// basename including extension goes into the object name so foo.c and
// foo.S don't collide with each other or with foo.logos's foo.o.
unsafe fn native_obj_path(dir: &String, src_path: &String) -> String {
    let bn_str: String = basename(str_from_raw(src_path.as_ptr(), src_path.len()));
    let mut p: String = String::new();
    p.push_bytes(dir.as_ptr(), dir.len());
    p.push_u8(47 as u8);
    p.push_bytes(bn_str.as_ptr(), bn_str.len());
    p.push_str(".o");
    return p;
}

// Spawn `cc -c <src> -o <obj>` for a single C/asm file. cc handles both
// .c and .S via file extension, so this one helper covers both.
unsafe fn spawn_native_compile(src_path: &String, obj_path: &String) -> Child {
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_arg(argv_p, "cc");
    push_arg(argv_p, "-c");
    push_string_arg(argv_p, src_path);
    push_arg(argv_p, "-o");
    push_string_arg(argv_p, obj_path);
    return spawn_inherit(&argv);
}

unsafe fn build_lib(t: &Target, profile: str, logosc: &String,
                    externals: &Vec<ExternalLib>) -> i32 {
    let lib_name_view: str = str_from_raw(t.name.as_ptr(), t.name.len());

    // ── Walk Logos source dir, if any ────────────────────────────────────
    let mut sources: Vec<String> = vec_new::<String>();
    if t.src.len() > 0 as i64 {
        let src_view: str = str_from_raw(t.src.as_ptr(), t.src.len());
        sources = collect_logos_files(src_view);
    }
    let n_src: i64 = sources.length();
    let n_c:   i64 = t.c_sources.length();
    let n_asm: i64 = t.asm_sources.length();
    if n_src == 0 as i64 && n_c == 0 as i64 && n_asm == 0 as i64 {
        let mut msg: String = String::new();
        msg.push_str("lforge: lib ");
        msg.push_bytes(t.name.as_ptr(), t.name.len());
        msg.push_str(": no Logos / C / asm sources");
        println_string(2, &msg);
        return 1;
    }

    let pf_dir: String = per_file_dir(profile, lib_name_view);
    let pf_dir_view: str = str_from_raw(pf_dir.as_ptr(), pf_dir.len());
    match mkdir_p(pf_dir_view) {
        Result::Err(_) => { println_str(2, "lforge: cannot create _files dir"); return 1; }
        Result::Ok(_)  => { }
    }

    let od: String = out_dir_for(profile);
    let od_view: str = str_from_raw(od.as_ptr(), od.len());
    match mkdir_p(od_view) {
        Result::Err(_) => { println_str(2, "lforge: cannot create out dir"); return 1; }
        Result::Ok(_)  => { }
    }
    let arch: String = lib_archive_path(profile, lib_name_view);

    // ── Generate .module manifest text only when there are Logos files ──
    let mut man_path: String = String::new();
    if n_src > 0 as i64 {
        let gd: String = gen_dir_for(profile);
        let gd_view: str = str_from_raw(gd.as_ptr(), gd.len());
        match mkdir_p(gd_view) {
            Result::Err(_) => { println_str(2, "lforge: cannot create _gen dir"); return 1; }
            Result::Ok(_)  => { }
        }
        let mut man: String = String::new();
        man.push_str("module ");
        man.push_bytes(t.name.as_ptr(), t.name.len());
        man.push_u8(10 as u8);
        man.push_str("version 0.1\n");
        man.push_str("root ");
        man.push_bytes(t.src.as_ptr(), t.src.len());
        man.push_u8(10 as u8);
        man_path.push_bytes(gd.as_ptr(), gd.len());
        man_path.push_u8(47 as u8);
        man_path.push_bytes(t.name.as_ptr(), t.name.len());
        man_path.push_str(".module");
        let man_path_cs: *mut u8 = cstr(str_from_raw(man_path.as_ptr(), man_path.len()));
        let wr: Result<i32, i32> = write_string(man_path_cs as *const u8, &man);
        dealloc(man_path_cs);
        match wr {
            Result::Err(_) => { println_str(2, "lforge: cannot write generated .module"); return 1; }
            Result::Ok(_)  => { }
        }
    }

    // ── For each source: determine whether per-file .o is up-to-date.   ──
    // Spawn the rebuilds in parallel; collect Child handles to wait on.
    let sp: *const Vec<String> = (&sources) as *const Vec<String>;
    let cp_arr: *const Vec<String> = (&t.c_sources) as *const Vec<String>;
    let ap_arr: *const Vec<String> = (&t.asm_sources) as *const Vec<String>;
    let mut children: Vec<Child> = vec_new::<Child>();
    let cp: *mut Vec<Child> = (&mut children) as *mut Vec<Child>;
    let mut rebuilt_count: i32 = 0;

    // Logos files via logosc --only-file
    let mut i: i64 = 0 as i64;
    while i < n_src {
        let src_p: *const String = sp.at_const(i);
        i = i + 1 as i64;
        let src_view2: str = str_from_raw((*src_p).as_ptr(), (*src_p).len());

        let prefix: String = per_file_prefix(&pf_dir, &(*src_p));
        let mut obj_path: String = String::new();
        obj_path.push_bytes(prefix.as_ptr(), prefix.len());
        obj_path.push_str(".o");

        let src_cs: *mut u8 = cstr(src_view2);
        let src_mt: i64 = match mtime_ns(src_cs as *const u8) {
            Result::Ok(v)  => { v }
            Result::Err(_) => { 0 as i64 }
        };
        dealloc(src_cs);
        let obj_view: str = str_from_raw(obj_path.as_ptr(), obj_path.len());
        if output_is_fresh(obj_view, src_mt) { continue; }

        let mut argv: Vec<String> = vec_new::<String>();
        let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
        push_string_arg(argv_p, logosc);
        push_arg(argv_p, "--emit-module");
        push_string_arg(argv_p, &man_path);
        push_arg(argv_p, "--only-file");
        push_string_arg(argv_p, &(*src_p));
        push_arg(argv_p, "-o");
        push_string_arg(argv_p, &prefix);
        // External archives so logosc can load their .hermes0 modules and
        // resolve `use <pkg>` statements that reference symbols outside
        // this project.
        let en_lib: i64 = externals.length();
        let ep_lib: *const Vec<ExternalLib> = externals as *const Vec<ExternalLib>;
        let mut ei_lib: i64 = 0 as i64;
        while ei_lib < en_lib {
            let lb: *const ExternalLib = ep_lib.at_const(ei_lib);
            push_arg(argv_p, "-l");
            push_string_arg(argv_p, &(*lb).archive_path);
            ei_lib = ei_lib + 1 as i64;
        }

        let child: Child = spawn_inherit(&argv);
        if child.pid() < 0 {
            println_str(2, "lforge: spawn failed");
            return 1;
        }
        cp.push(child);
        rebuilt_count = rebuilt_count + 1;
    }

    // C and asm files via cc -c
    let mut native_lists: [*const Vec<String>; 2] = [cp_arr, ap_arr];
    let mut native_counts: [i64; 2] = [n_c, n_asm];
    let mut nl: i64 = 0 as i64;
    while nl < 2 as i64 {
        let lst: *const Vec<String> = native_lists[nl];
        let cnt: i64 = native_counts[nl];
        nl = nl + 1 as i64;
        let mut k: i64 = 0 as i64;
        while k < cnt {
            let src_p: *const String = lst.at_const(k);
            k = k + 1 as i64;
            let src_view2: str = str_from_raw((*src_p).as_ptr(), (*src_p).len());

            let obj_path: String = native_obj_path(&pf_dir, &(*src_p));
            let src_cs: *mut u8 = cstr(src_view2);
            let src_mt: i64 = match mtime_ns(src_cs as *const u8) {
                Result::Ok(v)  => { v }
                Result::Err(_) => { 0 as i64 }
            };
            dealloc(src_cs);
            let obj_view: str = str_from_raw(obj_path.as_ptr(), obj_path.len());
            if output_is_fresh(obj_view, src_mt) { continue; }

            let child: Child = spawn_native_compile(&(*src_p), &obj_path);
            if child.pid() < 0 {
                println_str(2, "lforge: cc spawn failed");
                return 1;
            }
            cp.push(child);
            rebuilt_count = rebuilt_count + 1;
        }
    }

    // Announce.
    if rebuilt_count > 0 {
        let mut msg: String = String::new();
        msg.push_str("lforge: build lib ");
        msg.push_bytes(t.name.as_ptr(), t.name.len());
        msg.push_str(" — compiling ");
        msg.push_i64(rebuilt_count as i64);
        msg.push_str(" file(s) in parallel");
        println_string(1, &msg);
    }

    // ── Wait for all spawned children ────────────────────────────────────
    let mut all_ok: bool = true;
    let mut waited: i64 = 0 as i64;
    let nch: i64 = children.length();
    while waited < nch {
        let cgp: *mut Vec<Child> = (&mut children) as *mut Vec<Child>;
        // Pop yields children in reverse spawn order; we just need every
        // one to be reaped.
        match cgp.pop() {
            Option::None       => { waited = nch; }
            Option::Some(c)    => {
                let mut child_local: Child = c;
                let st: ExitStatus = child_local.wait();
                if !st.success() { all_ok = false; }
                waited = waited + 1 as i64;
            }
        }
    }
    if !all_ok {
        println_str(2, "lforge: one or more per-file compilations failed");
        return 1;
    }

    // ── Re-archive if anything was rebuilt or the .a is missing/stale ───
    let arch_view: str = str_from_raw(arch.as_ptr(), arch.len());
    let mut need_ar: bool = rebuilt_count > 0;
    if !need_ar {
        // Check archive freshness against every per-file artifact —
        // Logos .o, plus C/asm .o files.
        let mut max_pf: i64 = 0 as i64;
        let mut k: i64 = 0 as i64;
        while k < n_src {
            let src_p: *const String = sp.at_const(k);
            k = k + 1 as i64;
            let prefix: String = per_file_prefix(&pf_dir, &(*src_p));
            let mut obj_p: String = String::new();
            obj_p.push_bytes(prefix.as_ptr(), prefix.len());
            obj_p.push_str(".o");
            let cs: *mut u8 = cstr(str_from_raw(obj_p.as_ptr(), obj_p.len()));
            let mt: Result<i64, i32> = mtime_ns(cs as *const u8);
            dealloc(cs);
            match mt {
                Result::Ok(v)  => { if v > max_pf { max_pf = v; } }
                Result::Err(_) => { }
            }
        }
        let mut nl2: i64 = 0 as i64;
        while nl2 < 2 as i64 {
            let lst: *const Vec<String> = native_lists[nl2];
            let cnt: i64 = native_counts[nl2];
            nl2 = nl2 + 1 as i64;
            let mut k2: i64 = 0 as i64;
            while k2 < cnt {
                let src_p: *const String = lst.at_const(k2);
                k2 = k2 + 1 as i64;
                let obj_p: String = native_obj_path(&pf_dir, &(*src_p));
                let cs: *mut u8 = cstr(str_from_raw(obj_p.as_ptr(), obj_p.len()));
                let mt: Result<i64, i32> = mtime_ns(cs as *const u8);
                dealloc(cs);
                match mt {
                    Result::Ok(v)  => { if v > max_pf { max_pf = v; } }
                    Result::Err(_) => { }
                }
            }
        }
        if !output_is_fresh(arch_view, max_pf) { need_ar = true; }
    }

    if !need_ar {
        let mut msg: String = String::new();
        msg.push_str("lforge: lib ");
        msg.push_bytes(t.name.as_ptr(), t.name.len());
        msg.push_str(" up-to-date");
        println_string(1, &msg);
        return 0;
    }

    // Build `ar rcs <arch> <logos_obj> <logos_hermes0> ... <native_obj> ...`
    let mut ar_argv: Vec<String> = vec_new::<String>();
    let aap: *mut Vec<String> = (&mut ar_argv) as *mut Vec<String>;
    push_arg(aap, "ar");
    push_arg(aap, "rcs");
    push_string_arg(aap, &arch);
    let mut j: i64 = 0 as i64;
    while j < n_src {
        let src_p: *const String = sp.at_const(j);
        j = j + 1 as i64;
        let prefix: String = per_file_prefix(&pf_dir, &(*src_p));
        let mut o: String = String::new();
        o.push_bytes(prefix.as_ptr(), prefix.len());
        o.push_str(".o");
        let mut h: String = String::new();
        h.push_bytes(prefix.as_ptr(), prefix.len());
        h.push_str(".hermes0");
        aap.push(o);
        aap.push(h);
    }
    // Native (C/asm) .o files.
    let mut nl3: i64 = 0 as i64;
    while nl3 < 2 as i64 {
        let lst: *const Vec<String> = native_lists[nl3];
        let cnt: i64 = native_counts[nl3];
        nl3 = nl3 + 1 as i64;
        let mut k3: i64 = 0 as i64;
        while k3 < cnt {
            let src_p: *const String = lst.at_const(k3);
            k3 = k3 + 1 as i64;
            let o: String = native_obj_path(&pf_dir, &(*src_p));
            aap.push(o);
        }
    }

    // Remove a stale archive first; ar would otherwise append rather than
    // replace and dead members would linger.
    let arch_cs: *mut u8 = cstr(arch_view);
    unlink(arch_cs as *const u8);
    dealloc(arch_cs);

    let ar_child: Child = spawn_inherit(&ar_argv);
    if ar_child.pid() < 0 {
        println_str(2, "lforge: ar spawn failed");
        return 1;
    }
    let mut ar_local: Child = ar_child;
    let ar_st: ExitStatus = ar_local.wait();
    if !ar_st.success() {
        println_str(2, "lforge: ar failed");
        return 1;
    }
    return 0;
}

unsafe fn build_bin(t: &Target,
                    targets: &Vec<Target>,
                    profile: str,
                    logosc: &String,
                    lib_dir: &String,
                    externals: &Vec<ExternalLib>) -> i32 {
    if t.entry.len() == 0 as i64 {
        println_str(2, "lforge: bin target missing 'entry'");
        return 1;
    }
    let od: String = out_dir_for(profile);
    let od_view: str = str_from_raw(od.as_ptr(), od.len());
    match mkdir_p(od_view) {
        Result::Err(_) => { println_str(2, "lforge: cannot create out dir"); return 1; }
        Result::Ok(_)  => { }
    }

    // Incremental skip: if the linked binary is newer than every input
    // (the bin's own .logos files + every dep .a archive), skip the action.
    let src_view: str = str_from_raw(t.src.as_ptr(), t.src.len());
    let mut all_inputs: Vec<String> = collect_logos_files(src_view);
    let alp: *mut Vec<String> = (&mut all_inputs) as *mut Vec<String>;
    let dep_archs_for_check: Vec<String> = dep_archive_paths(targets, &t.deps, profile, externals);
    let dap_check: *const Vec<String> = (&dep_archs_for_check) as *const Vec<String>;
    let dnc: i64 = dep_archs_for_check.length();
    let mut di: i64 = 0 as i64;
    while di < dnc {
        let s: *const String = dap_check.at_const(di);
        let mut copy: String = String::new();
        copy.push_bytes((*s).as_ptr(), (*s).len());
        alp.push(copy);
        di = di + 1 as i64;
    }
    let max_mt: i64 = newest_mtime(&all_inputs);
    let bp_check: String = bin_path(profile, str_from_raw(t.name.as_ptr(), t.name.len()));
    let bp_check_view: str = str_from_raw(bp_check.as_ptr(), bp_check.len());
    if output_is_fresh(bp_check_view, max_mt) {
        let mut msg: String = String::new();
        msg.push_str("lforge: bin ");
        msg.push_bytes(t.name.as_ptr(), t.name.len());
        msg.push_str(" up-to-date");
        println_string(1, &msg);
        return 0;
    }

    // Compose entry path: <src>/<entry>.logos
    let mut entry_path: String = String::new();
    entry_path.push_bytes(t.src.as_ptr(), t.src.len());
    let elen: i64 = entry_path.len();
    if elen > 0 as i64 && (entry_path.as_ptr()[elen - 1 as i64] as i32) != 47 {
        entry_path.push_u8(47 as u8);
    }
    entry_path.push_bytes(t.entry.as_ptr(), t.entry.len());
    entry_path.push_str(".logos");

    let mut obj_path: String = String::new();
    obj_path.push_bytes(od.as_ptr(), od.len());
    obj_path.push_u8(47 as u8);
    obj_path.push_bytes(t.name.as_ptr(), t.name.len());
    obj_path.push_str(".o");

    let bp: String = bin_path(profile, str_from_raw(t.name.as_ptr(), t.name.len()));

    // Resolve dep archives.
    let dep_archs: Vec<String> = dep_archive_paths(targets, &t.deps, profile, externals);

    // Transitive closure: every external archive (direct + indirect) must
    // be visible to logosc and cc, so the consumer's source can resolve
    // symbols across the whole closure. Dedupe against dep_archs.
    let mut all_archs: Vec<String> = vec_new::<String>();
    let aap: *mut Vec<String> = (&mut all_archs) as *mut Vec<String>;
    let mut di: i64 = 0 as i64;
    let dap_v: *const Vec<String> = (&dep_archs) as *const Vec<String>;
    while di < dep_archs.length() {
        let s: *const String = dap_v.at_const(di);
        let mut c: String = String::new();
        c.push_bytes((*s).as_ptr(), (*s).len());
        aap.push(c);
        di = di + 1 as i64;
    }
    let en: i64 = externals.length();
    let ep: *const Vec<ExternalLib> = externals as *const Vec<ExternalLib>;
    let mut ei: i64 = 0 as i64;
    while ei < en {
        let lb: *const ExternalLib = ep.at_const(ei);
        let lbv: str = str_from_raw((*lb).archive_path.as_ptr(), (*lb).archive_path.len());
        let mut already: bool = false;
        let mut ai: i64 = 0 as i64;
        let aap_v: *const Vec<String> = (&all_archs) as *const Vec<String>;
        while ai < all_archs.length() {
            let s: *const String = aap_v.at_const(ai);
            let sv: str = str_from_raw((*s).as_ptr(), (*s).len());
            if str_eq_local(sv, lbv) { already = true; ai = all_archs.length(); }
            else                     { ai = ai + 1 as i64; }
        }
        if already == false {
            let mut c: String = String::new();
            c.push_bytes(lbv.as_ptr(), lbv.len());
            aap.push(c);
        }
        ei = ei + 1 as i64;
    }

    // logosc <entry> -o <obj> [-l <dep_arch>]...
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_string_arg(argv_p, logosc);
    push_string_arg(argv_p, &entry_path);
    push_arg(argv_p, "-o");
    push_string_arg(argv_p, &obj_path);
    let dn: i64 = all_archs.length();
    let dap: *const Vec<String> = (&all_archs) as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < dn {
        let s: *const String = dap.at_const(i);
        push_arg(argv_p, "-l");
        push_string_arg(argv_p, &(*s));
        i = i + 1 as i64;
    }

    let mut prefix: String = String::new();
    prefix.push_str("lforge: build bin ");
    prefix.push_bytes(t.name.as_ptr(), t.name.len());
    println_string(1, &prefix);
    let rc: i32 = run_child(&argv);
    if rc != 0 {
        println_str(2, "lforge: logosc failed");
        return rc;
    }

    if lib_dir.len() == 0 as i64 {
        println_str(2, "lforge: cannot locate Logos lib dir (set LOGOS_LIB_DIR)");
        return 1;
    }

    // cc <obj> [<dep_arch>...] <stdlib_archives> -lpthread -lm -o <bin>
    let mut largv: Vec<String> = vec_new::<String>();
    let largv_p: *mut Vec<String> = (&mut largv) as *mut Vec<String>;
    push_arg(largv_p, "cc");
    push_string_arg(largv_p, &obj_path);
    let mut k: i64 = 0 as i64;
    while k < dn {
        let s: *const String = dap.at_const(k);
        push_string_arg(largv_p, &(*s));
        k = k + 1 as i64;
    }
    let lib_view: str = str_from_raw(lib_dir.as_ptr(), lib_dir.len());
    let mut p1: String = String::new();
    p1.push_str(lib_view); append_path(&mut p1, "liblstdlib.a"); largv_p.push(p1);
    let mut p2: String = String::new();
    p2.push_str(lib_view); append_path(&mut p2, "liblstdlib_fibers.a"); largv_p.push(p2);
    let mut p3: String = String::new();
    p3.push_str(lib_view); append_path(&mut p3, "liblstdlib_rt.a"); largv_p.push(p3);
    let mut p4: String = String::new();
    p4.push_str(lib_view); append_path(&mut p4, "liblstdlib_uring.a"); largv_p.push(p4);
    push_arg(largv_p, "-lpthread");
    push_arg(largv_p, "-lm");
    push_arg(largv_p, "-o");
    push_string_arg(largv_p, &bp);

    let mut prefix2: String = String::new();
    prefix2.push_str("lforge: link bin ");
    prefix2.push_bytes(t.name.as_ptr(), t.name.len());
    println_string(1, &prefix2);
    return run_child(&largv);
}

// ── Top-level commands ────────────────────────────────────────────────────

// Find target index by name, or -1 if absent.
unsafe fn find_target_index(targets: &Vec<Target>, name: str) -> i64 {
    let n: i64 = targets.length();
    let tp: *const Vec<Target> = targets as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let t: *const Target = tp.at_const(i);
        let tnm: str = str_from_raw((*t).name.as_ptr(), (*t).name.len());
        if str_eq_local(tnm, name) { return i; }
        i = i + 1 as i64;
    }
    return 0 as i64 - 1 as i64;
}

// If `selected_idx` >= 0, build only that target plus its transitive deps.
// Otherwise build everything in topo order.
unsafe fn cmd_build_selected(m: &Manifest, profile: str, selected_idx: i64, use_lock: bool) -> i32 {
    let logosc: String = resolve_logosc_path();
    let lib_dir: String = resolve_logos_lib_dir();

    // Build external (project-level) deps first so their archives are
    // available when local targets resolve their per-target deps. The
    // lockfile gives us a fast-path: tags pinned in lforge.lock skip
    // ls-remote, and the freshly resolved entries are written back at
    // the end of the build.
    let mut lock_in: Vec<LockEntry> = vec_new::<LockEntry>();
    if use_lock { lock_in = read_lockfile_or_empty("./lforge.lock"); }
    let mut lock_out: Vec<LockEntry> = vec_new::<LockEntry>();
    let mut visited: Vec<String> = vec_new::<String>();
    let mut winners: Vec<GitWinner> = vec_new::<GitWinner>();
    let externals: Vec<ExternalLib> = match build_all_externals(
        &m.deps, profile, &logosc,
        &lock_in,
        (&mut lock_out) as *mut Vec<LockEntry>,
        (&mut visited) as *mut Vec<String>,
        (&mut winners) as *mut Vec<GitWinner>) {
        Result::Err(rc) => { return rc; }
        Result::Ok(libs) => { libs }
    };

    // Write a fresh lockfile if anything changed (or didn't exist).
    if m.deps.length() > 0 as i64 {
        let rc: i32 = write_lockfile("./lforge.lock", &lock_out);
        if rc != 0 { println_str(2, "lforge: warning: could not write lforge.lock"); }
    }

    let full_order: Vec<i64> = match topo_order(&m.targets, &externals) {
        Result::Err(e) => {
            print_str(2, "lforge: ");
            println_str(2, str_from_raw(e.message.as_ptr(), e.message.len()));
            return 1;
        }
        Result::Ok(o) => { o }
    };

    // Compute which targets to actually build. If selected_idx < 0 → all.
    // Else mark selected + transitively close over deps and intersect.
    let nt: i64 = m.targets.length();
    let want: *mut u8 = alloc(nt);
    let mut wi: i64 = 0 as i64;
    while wi < nt {
        if selected_idx < 0 as i64 { want[wi] = 1 as u8; }
        else                       { want[wi] = 0 as u8; }
        wi = wi + 1 as i64;
    }
    if selected_idx >= 0 as i64 {
        // Iterate to fixed point: for any wanted target, mark its deps
        // wanted too.
        want[selected_idx] = 1 as u8;
        let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
        let mut changed: bool = true;
        while changed {
            changed = false;
            let mut k: i64 = 0 as i64;
            while k < nt {
                if want[k] == 1 as u8 {
                    let t: *const Target = tp.at_const(k);
                    let dn: i64 = (*t).deps.length();
                    let dp: *const Vec<String> = (&(*t).deps) as *const Vec<String>;
                    let mut di: i64 = 0 as i64;
                    while di < dn {
                        let nm: *const String = dp.at_const(di);
                        let nm_view: str = str_from_raw((*nm).as_ptr(), (*nm).len());
                        let didx: i64 = find_target_index(&m.targets, nm_view);
                        if didx >= 0 as i64 && want[didx] == 0 as u8 {
                            want[didx] = 1 as u8;
                            changed = true;
                        }
                        di = di + 1 as i64;
                    }
                }
                k = k + 1 as i64;
            }
        }
    }

    let n_ord: i64 = full_order.length();
    let op: *const Vec<i64> = (&full_order) as *const Vec<i64>;
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    let mut built: i32 = 0;
    while i < n_ord {
        let idx_p: *const i64 = op.at_const(i);
        let idx: i64 = *idx_p;
        i = i + 1 as i64;
        if want[idx] == 0 as u8 { continue; }
        let t: *const Target = tp.at_const(idx);
        let rc: i32 = match (*t).kind {
            TargetKind::Lib => { build_lib(&(*t), profile, &logosc, &externals) }
            TargetKind::Bin => { build_bin(&(*t), &m.targets, profile, &logosc, &lib_dir, &externals) }
        };
        if rc != 0 {
            dealloc(want);
            return rc;
        }
        built = built + 1;
    }
    dealloc(want);
    println_str(1, "lforge: build OK");
    return 0;
}

unsafe fn cmd_build(m: &Manifest, profile: str) -> i32 {
    return cmd_build_selected(m, profile, 0 as i64 - 1 as i64, true);
}

// `lforge update` — re-resolve every git dep ignoring the lockfile, then
// rewrite it. Equivalent to `cmd_build` with use_lock=false.
unsafe fn cmd_update(m: &Manifest, profile: str) -> i32 {
    return cmd_build_selected(m, profile, 0 as i64 - 1 as i64, false);
}

// Find the first bin target's name (for `lforge run`).
unsafe fn first_bin_name(m: &Manifest) -> String {
    let n: i64 = m.targets.length();
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let t: *const Target = tp.at_const(i);
        match (*t).kind {
            TargetKind::Bin => {
                let mut out: String = String::new();
                out.push_bytes((*t).name.as_ptr(), (*t).name.len());
                return out;
            }
            TargetKind::Lib => { }
        }
        i = i + 1 as i64;
    }
    return String::new();
}

// Build (selected target if name non-empty) and run the bin target. If no
// name is given, runs the first bin target in declared order.
unsafe fn cmd_run_named(m: &Manifest, profile: str,
                        target_name: str, run_args: &Vec<String>) -> i32 {
    // Pick the bin name (and selected build index).
    let mut bin_nm: String = String::new();
    let mut sel_idx: i64 = 0 as i64 - 1 as i64;
    if target_name.len() > 0 as i64 {
        sel_idx = find_target_index(&m.targets, target_name);
        if sel_idx < 0 as i64 {
            println_str(2, "lforge: unknown target");
            return 1;
        }
        bin_nm.push_str(target_name);
    } else {
        bin_nm = first_bin_name(m);
        if bin_nm.len() == 0 as i64 {
            println_str(2, "lforge: project has no bin target to run");
            return 1;
        }
    }

    let rc: i32 = cmd_build_selected(m, profile, sel_idx, true);
    if rc != 0 { return rc; }

    let bp: String = bin_path(profile, str_from_raw(bin_nm.as_ptr(), bin_nm.len()));
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_string_arg(argv_p, &bp);
    let an: i64 = run_args.length();
    let rp: *const Vec<String> = run_args as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < an {
        let s: *const String = rp.at_const(i);
        push_string_arg(argv_p, &(*s));
        i = i + 1 as i64;
    }
    return run_child(&argv);
}

unsafe fn cmd_clean() -> i32 {
    match rm_rf(".lforge") {
        Result::Err(_) => { return 1; }
        Result::Ok(_)  => { return 0; }
    }
}

// ── lforge install ────────────────────────────────────────────────────────
//
// Copies built artifacts to a standard prefix layout:
//   bin targets → <prefix>/bin/<name>            (mode 0755)
//   lib targets → <prefix>/lib/lib<name>.a       (mode 0644)
//
// Triggers a build first so artifacts are present and up-to-date.
// Default prefix is /usr/local. Override with `--prefix <path>` (or
// `--prefix=<path>`).

unsafe fn install_one(src: &String, dst: &String, mode: str) -> i32 {
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_arg(argv_p, "install");
    push_arg(argv_p, "-D");
    push_arg(argv_p, "-m");
    push_arg(argv_p, mode);
    push_string_arg(argv_p, src);
    push_string_arg(argv_p, dst);
    return run_child(&argv);
}

unsafe fn read_prefix() -> String {
    let mut s: String = String::new();
    match get_option("prefix", "") {
        Option::Some(v) => { s.push_str(v); }
        Option::None    => { s.push_str("/usr/local"); }
    }
    return s;
}

unsafe fn cmd_install(m: &Manifest, profile: str) -> i32 {
    // Build first.
    let rc: i32 = cmd_build(m, profile);
    if rc != 0 { return rc; }

    let prefix: String = read_prefix();
    let pview: str = str_from_raw(prefix.as_ptr(), prefix.len());

    let mut bin_dir: String = String::new();
    bin_dir.push_str(pview); append_path(&mut bin_dir, "bin");
    let mut lib_dir: String = String::new();
    lib_dir.push_str(pview); append_path(&mut lib_dir, "lib");

    let nt: i64 = m.targets.length();
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    while i < nt {
        let t: *const Target = tp.at_const(i);
        i = i + 1 as i64;
        let nm_view: str = str_from_raw((*t).name.as_ptr(), (*t).name.len());
        match (*t).kind {
            TargetKind::Bin => {
                let src: String = bin_path(profile, nm_view);
                let mut dst: String = String::new();
                dst.push_bytes(bin_dir.as_ptr(), bin_dir.len());
                append_path(&mut dst, nm_view);
                let mut msg: String = String::new();
                msg.push_str("lforge: install ");
                msg.push_bytes(dst.as_ptr(), dst.len());
                println_string(1, &msg);
                let rci: i32 = install_one(&src, &dst, "0755");
                if rci != 0 {
                    println_str(2, "lforge: install failed");
                    return rci;
                }
            }
            TargetKind::Lib => {
                let src: String = lib_archive_path(profile, nm_view);
                let mut dst: String = String::new();
                dst.push_bytes(lib_dir.as_ptr(), lib_dir.len());
                let mut leaf: String = String::new();
                leaf.push_str("lib");
                leaf.push_str(nm_view);
                leaf.push_str(".a");
                append_path(&mut dst, str_from_raw(leaf.as_ptr(), leaf.len()));
                let mut msg: String = String::new();
                msg.push_str("lforge: install ");
                msg.push_bytes(dst.as_ptr(), dst.len());
                println_string(1, &msg);
                let rci: i32 = install_one(&src, &dst, "0644");
                if rci != 0 {
                    println_str(2, "lforge: install failed");
                    return rci;
                }
            }
        }
    }
    println_str(1, "lforge: install OK");
    return 0;
}

// ── lforge test ───────────────────────────────────────────────────────────
//
// Walks `tests/` (top level only — no recursion for now) for `*.logos`
// files. Each file is treated as a stand-alone test program: compile,
// link with all project lib targets, run, expect exit 0. Per-test
// artifacts go under .lforge/<profile>/test/<name>.{o,bin}.
//
// Failures aggregate; exit code is 0 iff every test passed.

unsafe fn build_test_bin(test_logos: &String,
                          test_name:  &String,
                          targets:    &Vec<Target>,
                          profile:    str,
                          logosc:     &String,
                          lib_dir:    &String) -> i32 {
    // Output dirs.
    let mut td: String = String::new();
    td.push_str(".lforge/");
    td.push_str(profile);
    td.push_str("/test");
    let td_view: str = str_from_raw(td.as_ptr(), td.len());
    match mkdir_p(td_view) {
        Result::Err(_) => { return 1; }
        Result::Ok(_)  => { }
    }

    let mut obj_path: String = String::new();
    obj_path.push_bytes(td.as_ptr(), td.len());
    obj_path.push_u8(47 as u8);
    obj_path.push_bytes(test_name.as_ptr(), test_name.len());
    obj_path.push_str(".o");

    let mut bin_p: String = String::new();
    bin_p.push_bytes(td.as_ptr(), td.len());
    bin_p.push_u8(47 as u8);
    bin_p.push_bytes(test_name.as_ptr(), test_name.len());

    // Tests link against every lib target in the project (mimics
    // ctest pattern: tests are top-level consumers of the libs).
    let mut all_lib_archs: Vec<String> = vec_new::<String>();
    let alp: *mut Vec<String> = (&mut all_lib_archs) as *mut Vec<String>;
    let nt: i64 = targets.length();
    let tp: *const Vec<Target> = targets as *const Vec<Target>;
    let mut ti: i64 = 0 as i64;
    while ti < nt {
        let tt: *const Target = tp.at_const(ti);
        match (*tt).kind {
            TargetKind::Lib => {
                let nm_view: str = str_from_raw((*tt).name.as_ptr(), (*tt).name.len());
                let p: String = lib_archive_path(profile, nm_view);
                alp.push(p);
            }
            TargetKind::Bin => { }
        }
        ti = ti + 1 as i64;
    }

    // logosc <test_logos> -o <obj> [-l <lib>]...
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_string_arg(argv_p, logosc);
    push_string_arg(argv_p, test_logos);
    push_arg(argv_p, "-o");
    push_string_arg(argv_p, &obj_path);
    let lan: i64 = all_lib_archs.length();
    let lap: *const Vec<String> = (&all_lib_archs) as *const Vec<String>;
    let mut li: i64 = 0 as i64;
    while li < lan {
        let s: *const String = lap.at_const(li);
        push_arg(argv_p, "-l");
        push_string_arg(argv_p, &(*s));
        li = li + 1 as i64;
    }
    let rc: i32 = run_child(&argv);
    if rc != 0 { return rc; }

    if lib_dir.len() == 0 as i64 {
        println_str(2, "lforge: cannot locate Logos lib dir");
        return 1;
    }

    // cc <obj> [<lib>...] <stdlib_archives> -lpthread -lm -o <bin>
    let mut largv: Vec<String> = vec_new::<String>();
    let largv_p: *mut Vec<String> = (&mut largv) as *mut Vec<String>;
    push_arg(largv_p, "cc");
    push_string_arg(largv_p, &obj_path);
    let mut lk: i64 = 0 as i64;
    while lk < lan {
        let s: *const String = lap.at_const(lk);
        push_string_arg(largv_p, &(*s));
        lk = lk + 1 as i64;
    }
    let lib_view: str = str_from_raw(lib_dir.as_ptr(), lib_dir.len());
    let mut p1: String = String::new();
    p1.push_str(lib_view); append_path(&mut p1, "liblstdlib.a"); largv_p.push(p1);
    let mut p2: String = String::new();
    p2.push_str(lib_view); append_path(&mut p2, "liblstdlib_fibers.a"); largv_p.push(p2);
    let mut p3: String = String::new();
    p3.push_str(lib_view); append_path(&mut p3, "liblstdlib_rt.a"); largv_p.push(p3);
    let mut p4: String = String::new();
    p4.push_str(lib_view); append_path(&mut p4, "liblstdlib_uring.a"); largv_p.push(p4);
    push_arg(largv_p, "-lpthread");
    push_arg(largv_p, "-lm");
    push_arg(largv_p, "-o");
    push_string_arg(largv_p, &bin_p);
    return run_child(&largv);
}

// Strip a path's trailing extension. "tests/foo.logos" → "tests/foo".
unsafe fn strip_dot_logos(s: str) -> String {
    let mut out: String = String::new();
    let n: i64 = s.len();
    let mut stripped: bool = false;
    if n >= 6 as i64 {
        let suffix: str = ".logos";
        let off: i64 = n - 6 as i64;
        let mut ok: bool = true;
        let mut k: i64 = 0 as i64;
        while k < 6 as i64 && ok {
            if s[off + k] != suffix[k] { ok = false; }
            k = k + 1 as i64;
        }
        if ok {
            out.push_bytes(s.as_ptr(), off);
            stripped = true;
        }
    }
    if !stripped {
        out.push_str(s);
    }
    return out;
}

// Extract base file name from a path: "a/b/c.logos" → "c.logos".
unsafe fn basename_view(p: str) -> str {
    let n: i64 = p.len();
    let mut start: i64 = 0 as i64;
    let mut i: i64 = n - 1 as i64;
    while i >= 0 as i64 {
        if (p[i] as i32) == 47 { start = i + 1 as i64; i = 0 as i64 - 1 as i64; }
        else { i = i - 1 as i64; }
    }
    return str_from_raw((p.as_ptr() as i64 + start) as *const u8, n - start);
}

unsafe fn cmd_test(m: &Manifest, profile: str) -> i32 {
    // 1. Build all lib targets first; bin targets are not needed for tests.
    let logosc:  String = resolve_logosc_path();
    let lib_dir: String = resolve_logos_lib_dir();
    // External deps are not threaded through cmd_test yet — that lands when
    // tests need to import from external libs (B3+).
    let no_externals: Vec<ExternalLib> = vec_new::<ExternalLib>();
    let order: Vec<i64> = match topo_order(&m.targets, &no_externals) {
        Result::Err(e) => {
            print_str(2, "lforge: ");
            println_str(2, str_from_raw(e.message.as_ptr(), e.message.len()));
            return 1;
        }
        Result::Ok(o) => { o }
    };
    let n_ord: i64 = order.length();
    let op: *const Vec<i64> = (&order) as *const Vec<i64>;
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut k: i64 = 0 as i64;
    while k < n_ord {
        let idx_p: *const i64 = op.at_const(k);
        let idx: i64 = *idx_p;
        let t: *const Target = tp.at_const(idx);
        match (*t).kind {
            TargetKind::Lib => {
                let rc: i32 = build_lib(&(*t), profile, &logosc, &no_externals);
                if rc != 0 {
                    println_str(2, "lforge: lib target failed; aborting test run");
                    return rc;
                }
            }
            TargetKind::Bin => { }
        }
        k = k + 1 as i64;
    }

    // 2. Walk tests/ for .logos files.
    let cs_tests: *mut u8 = cstr("tests");
    let exists_tests: bool = is_dir(cs_tests as *const u8);
    dealloc(cs_tests);
    if !exists_tests {
        println_str(1, "lforge: no tests/ dir, nothing to test");
        return 0;
    }

    let entries: Vec<DirEntry> = walk_dir("tests");
    let ep: *const Vec<DirEntry> = (&entries) as *const Vec<DirEntry>;
    let en: i64 = entries.length();

    let mut pass_n: i32 = 0;
    let mut fail_n: i32 = 0;
    let mut ei: i64 = 0 as i64;
    while ei < en {
        let de: *const DirEntry = ep.at_const(ei);
        ei = ei + 1 as i64;
        if (*de).is_dir { continue; }
        let pview: str = str_from_raw((*de).name.as_ptr(), (*de).name.len());
        let pn: i64 = pview.len();
        if pn < 6 as i64 { continue; }
        // Quick suffix check: ".logos"
        let suffix: str = ".logos";
        let off: i64 = pn - 6 as i64;
        let mut ok: bool = true;
        let mut sk: i64 = 0 as i64;
        while sk < 6 as i64 && ok {
            if pview[off + sk] != suffix[sk] { ok = false; }
            sk = sk + 1 as i64;
        }
        if !ok { continue; }

        let bn_view: str = basename_view(pview);
        let stem: String = strip_dot_logos(bn_view);
        let mut path_str: String = String::new();
        path_str.push_str(pview);

        let mut prefix: String = String::new();
        prefix.push_str("lforge: test ");
        prefix.push_bytes(stem.as_ptr(), stem.len());
        println_string(1, &prefix);

        let rc: i32 = build_test_bin(&path_str, &stem, &m.targets, profile, &logosc, &lib_dir);
        if rc != 0 {
            println_str(2, "  FAIL (compile/link)");
            fail_n = fail_n + 1;
            continue;
        }

        // Run the test binary.
        let mut bin_p: String = String::new();
        bin_p.push_str(".lforge/");
        bin_p.push_str(profile);
        bin_p.push_str("/test/");
        bin_p.push_bytes(stem.as_ptr(), stem.len());

        let mut argv: Vec<String> = vec_new::<String>();
        let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
        push_string_arg(argv_p, &bin_p);
        let exit_rc: i32 = run_child(&argv);
        if exit_rc == 0 {
            println_str(1, "  PASS");
            pass_n = pass_n + 1;
        } else {
            println_str(2, "  FAIL (exit code)");
            fail_n = fail_n + 1;
        }
    }

    // Summary.
    let mut summary: String = String::new();
    summary.push_str("lforge: tests passed=");
    summary.push_i64(pass_n as i64);
    summary.push_str(" failed=");
    summary.push_i64(fail_n as i64);
    println_string(1, &summary);
    if fail_n > 0 { return 1; }
    return 0;
}

// ── main ──────────────────────────────────────────────────────────────────

unsafe fn select_profile() -> str {
    if has_flag("release", "") { return "release"; }
    if has_flag("debug",   "") { return "debug"; }
    return "debug";
}

unsafe fn main() -> i32 {
    let cmd: str = positional(0 as i32);
    if cmd.len() == 0 as i64 {
        println_str(2, "usage: lforge <build|run|update|clean|test|install> [--release] [target] [-- args...]");
        return 2;
    }

    if str_eq_local(cmd, "clean") {
        return cmd_clean();
    }

    if str_eq_local(cmd, "version") {
        println_str(1, lforge_version());
        return 0;
    }

    let m: Manifest = match read_manifest("./lforge.hermes") {
        Result::Err(e) => {
            print_str(2, "lforge: ");
            println_str(2, str_from_raw(e.message.as_ptr(), e.message.len()));
            return 1;
        }
        Result::Ok(x)  => { x }
    };

    let profile: str = select_profile();

    if str_eq_local(cmd, "build") {
        // Optional positional: target name to build (with transitive deps).
        let target_arg: str = positional(1 as i32);
        let mut sel: i64 = 0 as i64 - 1 as i64;
        if target_arg.len() > 0 as i64 {
            sel = find_target_index(&m.targets, target_arg);
            if sel < 0 as i64 {
                print_str(2, "lforge: unknown target '");
                print_str(2, target_arg);
                println_str(2, "'");
                return 1;
            }
        }
        return cmd_build_selected(&m, profile, sel, true);
    }
    if str_eq_local(cmd, "update") {
        return cmd_update(&m, profile);
    }
    if str_eq_local(cmd, "test") {
        return cmd_test(&m, profile);
    }
    if str_eq_local(cmd, "install") {
        return cmd_install(&m, profile);
    }
    if str_eq_local(cmd, "run") {
        // Optional positional: bin target to run.
        let target_arg: str = positional(1 as i32);
        let mut run_args: Vec<String> = vec_new::<String>();
        let rap: *mut Vec<String> = (&mut run_args) as *mut Vec<String>;
        let pn: i32 = positional_count();
        let mut start_k: i32 = 1;
        let mut sel_target: str = "";
        if target_arg.len() > 0 as i64 {
            // Treat first positional after `run` as a target name only if
            // it matches an existing bin target; otherwise it's a run arg.
            let idx: i64 = find_target_index(&m.targets, target_arg);
            if idx >= 0 as i64 {
                let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
                let t: *const Target = tp.at_const(idx);
                match (*t).kind {
                    TargetKind::Bin => { sel_target = target_arg; start_k = 2; }
                    TargetKind::Lib => {
                        println_str(2, "lforge: cannot run a lib target");
                        return 1;
                    }
                }
            }
        }
        let mut k: i32 = start_k;
        while k < pn {
            let a: str = positional(k);
            let mut copy: String = String::new();
            copy.push_str(a);
            rap.push(copy);
            k = k + 1;
        }
        return cmd_run_named(&m, profile, sel_target, &run_args);
    }
    println_str(2, "lforge: unknown command (expected: build, run, test, install, clean)");
    return 2;
}
