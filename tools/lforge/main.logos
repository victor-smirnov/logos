use std.hermes.document;
use std.hermes.parser;
use std.io.fs;
use std.io.fs.path;
use std.lang.text;
use std.lang.option;
use std.lang.result;
use std.lang.iter;
use std.collections.vec;
use std.sys.process;
use std.sys.args;

use lforge.version;
use lforge.schema;
use lforge.util;
use lforge.hermes_io;
use lforge.cwd;
use lforge.manifest;
use lforge.lockfile;
use lforge.proc;
use lforge.git_dep;
use lforge.topo;
use lforge.build_paths;
use lforge.spawn_helpers;
use lforge.builder;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;
extern fn getenv(name: *const u8) -> *const u8;
extern fn execv(path: *const u8, argv: *const *const u8) -> i32;
extern fn chdir(path: *const u8) -> i32;
extern fn getcwd(buf: *mut u8, size: u64) -> *mut u8;

// Schema types (TargetKind/Target/ExternalDep/ExternalLib/LockEntry/
// GitWinner/Manifest/ManifestError) live in `lforge.schema`.

// String / I/O helpers (cstr, str_eq_local, err_msg/2, print_str,
// println_str, println_string, append_path) live in `lforge.util`.

// Hermes-view typed field helpers (read_str_field/opt/array) live in
// `lforge.hermes_io`.

// Manifest parser (parse_external_dep / parse_target / parse_manifest /
// read_manifest) lives in `lforge.manifest`.

// Topological sort of build targets (topo_order) + external_lookup
// live in `lforge.topo`.

// Working-directory helpers (save_cwd / chdir_str / make_absolute) live
// in `lforge.cwd`.

// ── External deps (B2: local paths only) ──────────────────────────────────

// ExternalLib lives in lforge.schema.

// Build the lib targets named in `dep.modules` from the external project at
// `dep.path`. Returns the absolute archive paths so the consumer can
// resolve t.deps lookups + pass them to logosc/cc.
//
// NOTE v1: external projects must NOT themselves declare project-level
// `deps:` — recursive resolution lands with the lockfile + MVS in B3.
unsafe fn build_external(dep: &ExternalDep, profile: str, logosc: &String,
                         lock_in: &Vec<LockEntry>,
                         lock_out: *mut Vec<LockEntry>,
                         visited: *mut Vec<String>,
                         winners: *mut Vec<GitWinner>) -> Result<Vec<ExternalLib>, i32> {
    let saved: String = save_cwd();
    if saved.len() == 0 as i64 {
        println_str(2, "lforge: getcwd failed");
        return Result::Err(1);
    }

    // Local `path:` -> use as-is. Git `project:` -> resolve to a cache path
    // (lockfile fast-path or ls-remote + clone). MVS conflict check before
    // we commit to fetching: if another consumer already pinned this
    // project to a higher version, silently defer to that one; a lower
    // pin would require an upgrade we don't support yet.
    let mut resolved_path: String = String::new();
    let mut resolved_display: String = String::new();
    let mut resolved_sha: String = String::new();
    let mut resolved_tag: String = String::new();
    if dep.path.len() > 0 as i64 {
        resolved_path.push_bytes(dep.path.as_ptr(), dep.path.len());
    } else {
        match resolve_git_dep(dep, lock_in, lock_out) {
            Result::Err(rc) => { return Result::Err(rc); }
            Result::Ok(t)   => {
                resolved_path = t.0;
                resolved_display = t.1;
                resolved_sha = t.2;
            }
        }
        if dep.tag.len() > 0 as i64 {
            resolved_tag.push_bytes(dep.tag.as_ptr(), dep.tag.len());
        }
        let dview: str = str_from_raw(resolved_display.as_ptr(), resolved_display.len());
        let tview: str = str_from_raw(resolved_tag.as_ptr(),     resolved_tag.len());
        let sview: str = str_from_raw(resolved_sha.as_ptr(),     resolved_sha.len());
        let verdict: i32 = check_git_winner(&(*winners), dview, tview, sview);
        if verdict == 2 as i32 || verdict == 1 as i32 {
            // 1 = same SHA already a winner (transitive dup). 2 = higher
            // version already wins. Either way: skip without recursing or
            // building. Symbols of this project are already covered by the
            // existing winner.
            return Result::Ok(vec_new::<ExternalLib>());
        }
        if verdict == 0 as i32 - 1 as i32 {
            print_str(2, "lforge: project '");
            print_str(2, dview);
            print_str(2, "' requested at version '");
            print_str(2, tview);
            print_str(2, "' but a lower-version pin is already in this build's closure. ");
            println_str(2, "Full MVS upgrade not yet implemented; use a `replace:` directive in the manifest to choose explicitly.");
            return Result::Err(1);
        }
        let mut display_c: String = String::new();
        display_c.push_bytes(resolved_display.as_ptr(), resolved_display.len());
        let mut tag_c: String = String::new();
        tag_c.push_bytes(resolved_tag.as_ptr(), resolved_tag.len());
        let mut sha_c: String = String::new();
        sha_c.push_bytes(resolved_sha.as_ptr(), resolved_sha.len());
        winners.push(GitWinner { display: display_c, tag: tag_c, sha: sha_c });
    }

    // Cycle / duplicate guard: skip if we've already built this absolute
    // path. Returns empty Vec — modules already produced earlier in the
    // walk are visible via the parent's externals accumulator.
    let abs_path: String = make_absolute(str_from_raw(resolved_path.as_ptr(), resolved_path.len()));
    let abs_view: str = str_from_raw(abs_path.as_ptr(), abs_path.len());
    let vn: i64 = (*visited).length();
    let vp: *const Vec<String> = visited as *const Vec<String>;
    let mut vi: i64 = 0 as i64;
    while vi < vn {
        let s: *const String = vp.at_const(vi);
        let sv: str = str_from_raw((*s).as_ptr(), (*s).len());
        if str_eq_local(sv, abs_view) {
            return Result::Ok(vec_new::<ExternalLib>());
        }
        vi = vi + 1 as i64;
    }
    let mut abs_copy: String = String::new();
    abs_copy.push_bytes(abs_path.as_ptr(), abs_path.len());
    visited.push(abs_copy);

    let path_view: str = str_from_raw(resolved_path.as_ptr(), resolved_path.len());
    if chdir_str(path_view) != 0 {
        let mut msg: String = String::new();
        msg.push_str("lforge: cannot chdir into external dep ");
        msg.push_str(path_view);
        println_string(2, &msg);
        return Result::Err(1);
    }

    let m: Manifest = match read_manifest("./lforge.hermes") {
        Result::Err(e) => {
            print_str(2, "lforge: external dep ");
            print_str(2, path_view);
            print_str(2, ": ");
            println_str(2, str_from_raw(e.message.as_ptr(), e.message.len()));
            chdir_str(str_from_raw(saved.as_ptr(), saved.len()));
            return Result::Err(1);
        }
        Result::Ok(m) => { m }
    };

    // Recurse into the external's own project-level deps before building.
    // We're currently chdir'd in the external; child resolutions chdir
    // further and restore back to here.
    let mut out: Vec<ExternalLib> = vec_new::<ExternalLib>();
    let outp: *mut Vec<ExternalLib> = (&mut out) as *mut Vec<ExternalLib>;
    if m.deps.length() > 0 as i64 {
        match build_all_externals(&m.deps, profile, logosc, lock_in, lock_out, visited, winners) {
            Result::Err(rc) => {
                chdir_str(str_from_raw(saved.as_ptr(), saved.len()));
                return Result::Err(rc);
            }
            Result::Ok(sublibs) => {
                let sn: i64 = sublibs.length();
                let sp: *const Vec<ExternalLib> = (&sublibs) as *const Vec<ExternalLib>;
                let mut si: i64 = 0 as i64;
                while si < sn {
                    let lb: *const ExternalLib = sp.at_const(si);
                    let mut nm_c: String = String::new();
                    nm_c.push_bytes((*lb).name.as_ptr(), (*lb).name.len());
                    let mut ap_c: String = String::new();
                    ap_c.push_bytes((*lb).archive_path.as_ptr(), (*lb).archive_path.len());
                    outp.push(ExternalLib { name: nm_c, archive_path: ap_c });
                    si = si + 1 as i64;
                }
            }
        }
    }

    // Build only the requested modules. Each one must exist as a `kind: lib`
    // target in the external manifest.
    let mn: i64 = dep.modules.length();
    let mp: *const Vec<String> = (&dep.modules) as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < mn {
        let nm: *const String = mp.at_const(i);
        let nm_view: str = str_from_raw((*nm).as_ptr(), (*nm).len());
        let idx: i64 = find_target_index(&m.targets, nm_view);
        if idx < 0 as i64 {
            print_str(2, "lforge: external dep ");
            print_str(2, path_view);
            print_str(2, ": no lib target named ");
            println_str(2, nm_view);
            chdir_str(str_from_raw(saved.as_ptr(), saved.len()));
            return Result::Err(1);
        }
        let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
        let t: *const Target = tp.at_const(idx);
        match (*t).kind {
            TargetKind::Lib => { }
            TargetKind::Bin => {
                print_str(2, "lforge: external dep ");
                print_str(2, path_view);
                print_str(2, ": '");
                print_str(2, nm_view);
                println_str(2, "' is a bin target — only libs can be exported");
                chdir_str(str_from_raw(saved.as_ptr(), saved.len()));
                return Result::Err(1);
            }
        }
        // External's lib is built with the closure of already-resolved
        // externals (its own deps + their transitives) visible to logosc.
        let rc: i32 = build_lib(&(*t), profile, logosc, &out);
        if rc != 0 {
            print_str(2, "lforge: external dep ");
            print_str(2, path_view);
            print_str(2, ": build of '");
            print_str(2, nm_view);
            println_str(2, "' failed");
            chdir_str(str_from_raw(saved.as_ptr(), saved.len()));
            return Result::Err(rc);
        }
        // Resolve the produced archive to an absolute path so the consumer
        // can reference it after we chdir back.
        let rel_arch: String = lib_archive_path(profile, nm_view);
        let abs_arch: String = make_absolute(str_from_raw(rel_arch.as_ptr(), rel_arch.len()));
        let mut nm_copy: String = String::new();
        nm_copy.push_bytes((*nm).as_ptr(), (*nm).len());
        outp.push(ExternalLib { name: nm_copy, archive_path: abs_arch });
        i = i + 1 as i64;
    }

    if chdir_str(str_from_raw(saved.as_ptr(), saved.len())) != 0 {
        println_str(2, "lforge: cannot restore cwd after building external dep");
        return Result::Err(1);
    }
    return Result::Ok(out);
}

unsafe fn build_all_externals(deps: &Vec<ExternalDep>, profile: str, logosc: &String,
                              lock_in: &Vec<LockEntry>,
                              lock_out: *mut Vec<LockEntry>,
                              visited:  *mut Vec<String>,
                              winners:  *mut Vec<GitWinner>) -> Result<Vec<ExternalLib>, i32> {
    let mut all: Vec<ExternalLib> = vec_new::<ExternalLib>();
    let allp: *mut Vec<ExternalLib> = (&mut all) as *mut Vec<ExternalLib>;
    let n: i64 = deps.length();
    let dp: *const Vec<ExternalDep> = deps as *const Vec<ExternalDep>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let d: *const ExternalDep = dp.at_const(i);
        match build_external(&(*d), profile, logosc, lock_in, lock_out, visited, winners) {
            Result::Err(rc) => { return Result::Err(rc); }
            Result::Ok(libs) => {
                let m: i64 = libs.length();
                let lp: *const Vec<ExternalLib> = (&libs) as *const Vec<ExternalLib>;
                let mut j: i64 = 0 as i64;
                while j < m {
                    let lb: *const ExternalLib = lp.at_const(j);
                    let mut nm_copy: String = String::new();
                    nm_copy.push_bytes((*lb).name.as_ptr(), (*lb).name.len());
                    let mut ap_copy: String = String::new();
                    ap_copy.push_bytes((*lb).archive_path.as_ptr(), (*lb).archive_path.len());
                    allp.push(ExternalLib { name: nm_copy, archive_path: ap_copy });
                    j = j + 1 as i64;
                }
            }
        }
        i = i + 1 as i64;
    }
    return Result::Ok(all);
}

// Git URL canonicalization + ls-remote/clone helpers + closure-walk
// resolver (resolve_git_dep) live in `lforge.git_dep`.

// Tool resolution + build-output paths + mtime-based freshness check
// (resolve_logos_lib_dir / resolve_logosc_path / out_dir_for / gen_dir_for /
// lib_archive_path / bin_path / dep_archive_paths / collect_logos_files /
// newest_mtime / output_is_fresh) live in `lforge.build_paths`.

// Spawn helpers (spawn_inherit / per_file_dir / per_file_prefix /
// native_obj_path / spawn_native_compile) live in `lforge.spawn_helpers`.

// build_lib + build_bin live in `lforge.builder`.

// ── Top-level commands ────────────────────────────────────────────────────

// Find target index by name, or -1 if absent.
unsafe fn find_target_index(targets: &Vec<Target>, name: str) -> i64 {
    let n: i64 = targets.length();
    let tp: *const Vec<Target> = targets as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let t: *const Target = tp.at_const(i);
        let tnm: str = str_from_raw((*t).name.as_ptr(), (*t).name.len());
        if str_eq_local(tnm, name) { return i; }
        i = i + 1 as i64;
    }
    return 0 as i64 - 1 as i64;
}

// If `selected_idx` >= 0, build only that target plus its transitive deps.
// Otherwise build everything in topo order.
unsafe fn cmd_build_selected(m: &Manifest, profile: str, selected_idx: i64, use_lock: bool) -> i32 {
    let logosc: String = resolve_logosc_path();
    let lib_dir: String = resolve_logos_lib_dir();

    // Build external (project-level) deps first so their archives are
    // available when local targets resolve their per-target deps. The
    // lockfile gives us a fast-path: tags pinned in lforge.lock skip
    // ls-remote, and the freshly resolved entries are written back at
    // the end of the build.
    let mut lock_in: Vec<LockEntry> = vec_new::<LockEntry>();
    if use_lock { lock_in = read_lockfile_or_empty("./lforge.lock"); }
    let mut lock_out: Vec<LockEntry> = vec_new::<LockEntry>();
    let mut visited: Vec<String> = vec_new::<String>();
    let mut winners: Vec<GitWinner> = vec_new::<GitWinner>();
    let externals: Vec<ExternalLib> = match build_all_externals(
        &m.deps, profile, &logosc,
        &lock_in,
        (&mut lock_out) as *mut Vec<LockEntry>,
        (&mut visited) as *mut Vec<String>,
        (&mut winners) as *mut Vec<GitWinner>) {
        Result::Err(rc) => { return rc; }
        Result::Ok(libs) => { libs }
    };

    // Write a fresh lockfile if anything changed (or didn't exist).
    if m.deps.length() > 0 as i64 {
        let rc: i32 = write_lockfile("./lforge.lock", &lock_out);
        if rc != 0 { println_str(2, "lforge: warning: could not write lforge.lock"); }
    }

    let full_order: Vec<i64> = match topo_order(&m.targets, &externals) {
        Result::Err(e) => {
            print_str(2, "lforge: ");
            println_str(2, str_from_raw(e.message.as_ptr(), e.message.len()));
            return 1;
        }
        Result::Ok(o) => { o }
    };

    // Compute which targets to actually build. If selected_idx < 0 → all.
    // Else mark selected + transitively close over deps and intersect.
    let nt: i64 = m.targets.length();
    let want: *mut u8 = alloc(nt);
    let mut wi: i64 = 0 as i64;
    while wi < nt {
        if selected_idx < 0 as i64 { want[wi] = 1 as u8; }
        else                       { want[wi] = 0 as u8; }
        wi = wi + 1 as i64;
    }
    if selected_idx >= 0 as i64 {
        // Iterate to fixed point: for any wanted target, mark its deps
        // wanted too.
        want[selected_idx] = 1 as u8;
        let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
        let mut changed: bool = true;
        while changed {
            changed = false;
            let mut k: i64 = 0 as i64;
            while k < nt {
                if want[k] == 1 as u8 {
                    let t: *const Target = tp.at_const(k);
                    let dn: i64 = (*t).deps.length();
                    let dp: *const Vec<String> = (&(*t).deps) as *const Vec<String>;
                    let mut di: i64 = 0 as i64;
                    while di < dn {
                        let nm: *const String = dp.at_const(di);
                        let nm_view: str = str_from_raw((*nm).as_ptr(), (*nm).len());
                        let didx: i64 = find_target_index(&m.targets, nm_view);
                        if didx >= 0 as i64 && want[didx] == 0 as u8 {
                            want[didx] = 1 as u8;
                            changed = true;
                        }
                        di = di + 1 as i64;
                    }
                }
                k = k + 1 as i64;
            }
        }
    }

    let n_ord: i64 = full_order.length();
    let op: *const Vec<i64> = (&full_order) as *const Vec<i64>;
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    let mut built: i32 = 0;
    while i < n_ord {
        let idx_p: *const i64 = op.at_const(i);
        let idx: i64 = *idx_p;
        i = i + 1 as i64;
        if want[idx] == 0 as u8 { continue; }
        let t: *const Target = tp.at_const(idx);
        let rc: i32 = match (*t).kind {
            TargetKind::Lib => { build_lib(&(*t), profile, &logosc, &externals) }
            TargetKind::Bin => { build_bin(&(*t), &m.targets, profile, &logosc, &lib_dir, &externals) }
        };
        if rc != 0 {
            dealloc(want);
            return rc;
        }
        built = built + 1;
    }
    dealloc(want);
    println_str(1, "lforge: build OK");
    return 0;
}

unsafe fn cmd_build(m: &Manifest, profile: str) -> i32 {
    return cmd_build_selected(m, profile, 0 as i64 - 1 as i64, true);
}

// `lforge update` — re-resolve every git dep ignoring the lockfile, then
// rewrite it. Equivalent to `cmd_build` with use_lock=false.
unsafe fn cmd_update(m: &Manifest, profile: str) -> i32 {
    return cmd_build_selected(m, profile, 0 as i64 - 1 as i64, false);
}

// Find the first bin target's name (for `lforge run`).
unsafe fn first_bin_name(m: &Manifest) -> String {
    let n: i64 = m.targets.length();
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let t: *const Target = tp.at_const(i);
        match (*t).kind {
            TargetKind::Bin => {
                let mut out: String = String::new();
                out.push_bytes((*t).name.as_ptr(), (*t).name.len());
                return out;
            }
            TargetKind::Lib => { }
        }
        i = i + 1 as i64;
    }
    return String::new();
}

// Build (selected target if name non-empty) and run the bin target. If no
// name is given, runs the first bin target in declared order.
unsafe fn cmd_run_named(m: &Manifest, profile: str,
                        target_name: str, run_args: &Vec<String>) -> i32 {
    // Pick the bin name (and selected build index).
    let mut bin_nm: String = String::new();
    let mut sel_idx: i64 = 0 as i64 - 1 as i64;
    if target_name.len() > 0 as i64 {
        sel_idx = find_target_index(&m.targets, target_name);
        if sel_idx < 0 as i64 {
            println_str(2, "lforge: unknown target");
            return 1;
        }
        bin_nm.push_str(target_name);
    } else {
        bin_nm = first_bin_name(m);
        if bin_nm.len() == 0 as i64 {
            println_str(2, "lforge: project has no bin target to run");
            return 1;
        }
    }

    let rc: i32 = cmd_build_selected(m, profile, sel_idx, true);
    if rc != 0 { return rc; }

    let bp: String = bin_path(profile, str_from_raw(bin_nm.as_ptr(), bin_nm.len()));
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_string_arg(argv_p, &bp);
    let an: i64 = run_args.length();
    let rp: *const Vec<String> = run_args as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < an {
        let s: *const String = rp.at_const(i);
        push_string_arg(argv_p, &(*s));
        i = i + 1 as i64;
    }
    return run_child(&argv);
}

unsafe fn cmd_clean() -> i32 {
    match rm_rf(".lforge") {
        Result::Err(_) => { return 1; }
        Result::Ok(_)  => { return 0; }
    }
}

// ── lforge install ────────────────────────────────────────────────────────
//
// Copies built artifacts to a standard prefix layout:
//   bin targets → <prefix>/bin/<name>            (mode 0755)
//   lib targets → <prefix>/lib/lib<name>.a       (mode 0644)
//
// Triggers a build first so artifacts are present and up-to-date.
// Default prefix is /usr/local. Override with `--prefix <path>` (or
// `--prefix=<path>`).

unsafe fn install_one(src: &String, dst: &String, mode: str) -> i32 {
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_arg(argv_p, "install");
    push_arg(argv_p, "-D");
    push_arg(argv_p, "-m");
    push_arg(argv_p, mode);
    push_string_arg(argv_p, src);
    push_string_arg(argv_p, dst);
    return run_child(&argv);
}

unsafe fn read_prefix() -> String {
    let mut s: String = String::new();
    match get_option("prefix", "") {
        Option::Some(v) => { s.push_str(v); }
        Option::None    => { s.push_str("/usr/local"); }
    }
    return s;
}

unsafe fn cmd_install(m: &Manifest, profile: str) -> i32 {
    // Build first.
    let rc: i32 = cmd_build(m, profile);
    if rc != 0 { return rc; }

    let prefix: String = read_prefix();
    let pview: str = str_from_raw(prefix.as_ptr(), prefix.len());

    let mut bin_dir: String = String::new();
    bin_dir.push_str(pview); append_path(&mut bin_dir, "bin");
    let mut lib_dir: String = String::new();
    lib_dir.push_str(pview); append_path(&mut lib_dir, "lib");

    let nt: i64 = m.targets.length();
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut i: i64 = 0 as i64;
    while i < nt {
        let t: *const Target = tp.at_const(i);
        i = i + 1 as i64;
        let nm_view: str = str_from_raw((*t).name.as_ptr(), (*t).name.len());
        match (*t).kind {
            TargetKind::Bin => {
                let src: String = bin_path(profile, nm_view);
                let mut dst: String = String::new();
                dst.push_bytes(bin_dir.as_ptr(), bin_dir.len());
                append_path(&mut dst, nm_view);
                let mut msg: String = String::new();
                msg.push_str("lforge: install ");
                msg.push_bytes(dst.as_ptr(), dst.len());
                println_string(1, &msg);
                let rci: i32 = install_one(&src, &dst, "0755");
                if rci != 0 {
                    println_str(2, "lforge: install failed");
                    return rci;
                }
            }
            TargetKind::Lib => {
                let src: String = lib_archive_path(profile, nm_view);
                let mut dst: String = String::new();
                dst.push_bytes(lib_dir.as_ptr(), lib_dir.len());
                let mut leaf: String = String::new();
                leaf.push_str("lib");
                leaf.push_str(nm_view);
                leaf.push_str(".a");
                append_path(&mut dst, str_from_raw(leaf.as_ptr(), leaf.len()));
                let mut msg: String = String::new();
                msg.push_str("lforge: install ");
                msg.push_bytes(dst.as_ptr(), dst.len());
                println_string(1, &msg);
                let rci: i32 = install_one(&src, &dst, "0644");
                if rci != 0 {
                    println_str(2, "lforge: install failed");
                    return rci;
                }
            }
        }
    }
    println_str(1, "lforge: install OK");
    return 0;
}

// ── lforge test ───────────────────────────────────────────────────────────
//
// Walks `tests/` (top level only — no recursion for now) for `*.logos`
// files. Each file is treated as a stand-alone test program: compile,
// link with all project lib targets, run, expect exit 0. Per-test
// artifacts go under .lforge/<profile>/test/<name>.{o,bin}.
//
// Failures aggregate; exit code is 0 iff every test passed.

unsafe fn build_test_bin(test_logos: &String,
                          test_name:  &String,
                          targets:    &Vec<Target>,
                          profile:    str,
                          logosc:     &String,
                          lib_dir:    &String) -> i32 {
    // Output dirs.
    let mut td: String = String::new();
    td.push_str(".lforge/");
    td.push_str(profile);
    td.push_str("/test");
    let td_view: str = str_from_raw(td.as_ptr(), td.len());
    match mkdir_p(td_view) {
        Result::Err(_) => { return 1; }
        Result::Ok(_)  => { }
    }

    let mut obj_path: String = String::new();
    obj_path.push_bytes(td.as_ptr(), td.len());
    obj_path.push_u8(47 as u8);
    obj_path.push_bytes(test_name.as_ptr(), test_name.len());
    obj_path.push_str(".o");

    let mut bin_p: String = String::new();
    bin_p.push_bytes(td.as_ptr(), td.len());
    bin_p.push_u8(47 as u8);
    bin_p.push_bytes(test_name.as_ptr(), test_name.len());

    // Tests link against every lib target in the project (mimics
    // ctest pattern: tests are top-level consumers of the libs).
    let mut all_lib_archs: Vec<String> = vec_new::<String>();
    let alp: *mut Vec<String> = (&mut all_lib_archs) as *mut Vec<String>;
    let nt: i64 = targets.length();
    let tp: *const Vec<Target> = targets as *const Vec<Target>;
    let mut ti: i64 = 0 as i64;
    while ti < nt {
        let tt: *const Target = tp.at_const(ti);
        match (*tt).kind {
            TargetKind::Lib => {
                let nm_view: str = str_from_raw((*tt).name.as_ptr(), (*tt).name.len());
                let p: String = lib_archive_path(profile, nm_view);
                alp.push(p);
            }
            TargetKind::Bin => { }
        }
        ti = ti + 1 as i64;
    }

    // logosc <test_logos> -o <obj> [-l <lib>]...
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_string_arg(argv_p, logosc);
    push_string_arg(argv_p, test_logos);
    push_arg(argv_p, "-o");
    push_string_arg(argv_p, &obj_path);
    let lan: i64 = all_lib_archs.length();
    let lap: *const Vec<String> = (&all_lib_archs) as *const Vec<String>;
    let mut li: i64 = 0 as i64;
    while li < lan {
        let s: *const String = lap.at_const(li);
        push_arg(argv_p, "-l");
        push_string_arg(argv_p, &(*s));
        li = li + 1 as i64;
    }
    let rc: i32 = run_child(&argv);
    if rc != 0 { return rc; }

    if lib_dir.len() == 0 as i64 {
        println_str(2, "lforge: cannot locate Logos lib dir");
        return 1;
    }

    // cc <obj> [<lib>...] <stdlib_archives> -lpthread -lm -o <bin>
    let mut largv: Vec<String> = vec_new::<String>();
    let largv_p: *mut Vec<String> = (&mut largv) as *mut Vec<String>;
    push_arg(largv_p, "cc");
    push_string_arg(largv_p, &obj_path);
    let mut lk: i64 = 0 as i64;
    while lk < lan {
        let s: *const String = lap.at_const(lk);
        push_string_arg(largv_p, &(*s));
        lk = lk + 1 as i64;
    }
    let lib_view: str = str_from_raw(lib_dir.as_ptr(), lib_dir.len());
    let mut p1: String = String::new();
    p1.push_str(lib_view); append_path(&mut p1, "liblstdlib.a"); largv_p.push(p1);
    let mut p2: String = String::new();
    p2.push_str(lib_view); append_path(&mut p2, "liblstdlib_fibers.a"); largv_p.push(p2);
    let mut p3: String = String::new();
    p3.push_str(lib_view); append_path(&mut p3, "liblstdlib_rt.a"); largv_p.push(p3);
    let mut p4: String = String::new();
    p4.push_str(lib_view); append_path(&mut p4, "liblstdlib_uring.a"); largv_p.push(p4);
    push_arg(largv_p, "-lpthread");
    push_arg(largv_p, "-lm");
    push_arg(largv_p, "-o");
    push_string_arg(largv_p, &bin_p);
    return run_child(&largv);
}

// Strip a path's trailing extension. "tests/foo.logos" → "tests/foo".
unsafe fn strip_dot_logos(s: str) -> String {
    let mut out: String = String::new();
    let n: i64 = s.len();
    let mut stripped: bool = false;
    if n >= 6 as i64 {
        let suffix: str = ".logos";
        let off: i64 = n - 6 as i64;
        let mut ok: bool = true;
        let mut k: i64 = 0 as i64;
        while k < 6 as i64 && ok {
            if s[off + k] != suffix[k] { ok = false; }
            k = k + 1 as i64;
        }
        if ok {
            out.push_bytes(s.as_ptr(), off);
            stripped = true;
        }
    }
    if !stripped {
        out.push_str(s);
    }
    return out;
}

// Extract base file name from a path: "a/b/c.logos" → "c.logos".
unsafe fn basename_view(p: str) -> str {
    let n: i64 = p.len();
    let mut start: i64 = 0 as i64;
    let mut i: i64 = n - 1 as i64;
    while i >= 0 as i64 {
        if (p[i] as i32) == 47 { start = i + 1 as i64; i = 0 as i64 - 1 as i64; }
        else { i = i - 1 as i64; }
    }
    return str_from_raw((p.as_ptr() as i64 + start) as *const u8, n - start);
}

unsafe fn cmd_test(m: &Manifest, profile: str) -> i32 {
    // 1. Build all lib targets first; bin targets are not needed for tests.
    let logosc:  String = resolve_logosc_path();
    let lib_dir: String = resolve_logos_lib_dir();
    // External deps are not threaded through cmd_test yet — that lands when
    // tests need to import from external libs (B3+).
    let no_externals: Vec<ExternalLib> = vec_new::<ExternalLib>();
    let order: Vec<i64> = match topo_order(&m.targets, &no_externals) {
        Result::Err(e) => {
            print_str(2, "lforge: ");
            println_str(2, str_from_raw(e.message.as_ptr(), e.message.len()));
            return 1;
        }
        Result::Ok(o) => { o }
    };
    let n_ord: i64 = order.length();
    let op: *const Vec<i64> = (&order) as *const Vec<i64>;
    let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
    let mut k: i64 = 0 as i64;
    while k < n_ord {
        let idx_p: *const i64 = op.at_const(k);
        let idx: i64 = *idx_p;
        let t: *const Target = tp.at_const(idx);
        match (*t).kind {
            TargetKind::Lib => {
                let rc: i32 = build_lib(&(*t), profile, &logosc, &no_externals);
                if rc != 0 {
                    println_str(2, "lforge: lib target failed; aborting test run");
                    return rc;
                }
            }
            TargetKind::Bin => { }
        }
        k = k + 1 as i64;
    }

    // 2. Walk tests/ for .logos files.
    let cs_tests: *mut u8 = cstr("tests");
    let exists_tests: bool = is_dir(cs_tests as *const u8);
    dealloc(cs_tests);
    if !exists_tests {
        println_str(1, "lforge: no tests/ dir, nothing to test");
        return 0;
    }

    let entries: Vec<DirEntry> = walk_dir("tests");
    let ep: *const Vec<DirEntry> = (&entries) as *const Vec<DirEntry>;
    let en: i64 = entries.length();

    let mut pass_n: i32 = 0;
    let mut fail_n: i32 = 0;
    let mut ei: i64 = 0 as i64;
    while ei < en {
        let de: *const DirEntry = ep.at_const(ei);
        ei = ei + 1 as i64;
        if (*de).is_dir { continue; }
        let pview: str = str_from_raw((*de).name.as_ptr(), (*de).name.len());
        let pn: i64 = pview.len();
        if pn < 6 as i64 { continue; }
        // Quick suffix check: ".logos"
        let suffix: str = ".logos";
        let off: i64 = pn - 6 as i64;
        let mut ok: bool = true;
        let mut sk: i64 = 0 as i64;
        while sk < 6 as i64 && ok {
            if pview[off + sk] != suffix[sk] { ok = false; }
            sk = sk + 1 as i64;
        }
        if !ok { continue; }

        let bn_view: str = basename_view(pview);
        let stem: String = strip_dot_logos(bn_view);
        let mut path_str: String = String::new();
        path_str.push_str(pview);

        let mut prefix: String = String::new();
        prefix.push_str("lforge: test ");
        prefix.push_bytes(stem.as_ptr(), stem.len());
        println_string(1, &prefix);

        let rc: i32 = build_test_bin(&path_str, &stem, &m.targets, profile, &logosc, &lib_dir);
        if rc != 0 {
            println_str(2, "  FAIL (compile/link)");
            fail_n = fail_n + 1;
            continue;
        }

        // Run the test binary.
        let mut bin_p: String = String::new();
        bin_p.push_str(".lforge/");
        bin_p.push_str(profile);
        bin_p.push_str("/test/");
        bin_p.push_bytes(stem.as_ptr(), stem.len());

        let mut argv: Vec<String> = vec_new::<String>();
        let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
        push_string_arg(argv_p, &bin_p);
        let exit_rc: i32 = run_child(&argv);
        if exit_rc == 0 {
            println_str(1, "  PASS");
            pass_n = pass_n + 1;
        } else {
            println_str(2, "  FAIL (exit code)");
            fail_n = fail_n + 1;
        }
    }

    // Summary.
    let mut summary: String = String::new();
    summary.push_str("lforge: tests passed=");
    summary.push_i64(pass_n as i64);
    summary.push_str(" failed=");
    summary.push_i64(fail_n as i64);
    println_string(1, &summary);
    if fail_n > 0 { return 1; }
    return 0;
}

// ── main ──────────────────────────────────────────────────────────────────

unsafe fn select_profile() -> str {
    if has_flag("release", "") { return "release"; }
    if has_flag("debug",   "") { return "debug"; }
    return "debug";
}

unsafe fn main() -> i32 {
    let cmd: str = positional(0 as i32);
    if cmd.len() == 0 as i64 {
        println_str(2, "usage: lforge <build|run|update|clean|test|install> [--release] [target] [-- args...]");
        return 2;
    }

    if str_eq_local(cmd, "clean") {
        return cmd_clean();
    }

    if str_eq_local(cmd, "version") {
        println_str(1, lforge_version());
        return 0;
    }

    let m: Manifest = match read_manifest("./lforge.hermes") {
        Result::Err(e) => {
            print_str(2, "lforge: ");
            println_str(2, str_from_raw(e.message.as_ptr(), e.message.len()));
            return 1;
        }
        Result::Ok(x)  => { x }
    };

    let profile: str = select_profile();

    if str_eq_local(cmd, "build") {
        // Optional positional: target name to build (with transitive deps).
        let target_arg: str = positional(1 as i32);
        let mut sel: i64 = 0 as i64 - 1 as i64;
        if target_arg.len() > 0 as i64 {
            sel = find_target_index(&m.targets, target_arg);
            if sel < 0 as i64 {
                print_str(2, "lforge: unknown target '");
                print_str(2, target_arg);
                println_str(2, "'");
                return 1;
            }
        }
        return cmd_build_selected(&m, profile, sel, true);
    }
    if str_eq_local(cmd, "update") {
        return cmd_update(&m, profile);
    }
    if str_eq_local(cmd, "test") {
        return cmd_test(&m, profile);
    }
    if str_eq_local(cmd, "install") {
        return cmd_install(&m, profile);
    }
    if str_eq_local(cmd, "run") {
        // Optional positional: bin target to run.
        let target_arg: str = positional(1 as i32);
        let mut run_args: Vec<String> = vec_new::<String>();
        let rap: *mut Vec<String> = (&mut run_args) as *mut Vec<String>;
        let pn: i32 = positional_count();
        let mut start_k: i32 = 1;
        let mut sel_target: str = "";
        if target_arg.len() > 0 as i64 {
            // Treat first positional after `run` as a target name only if
            // it matches an existing bin target; otherwise it's a run arg.
            let idx: i64 = find_target_index(&m.targets, target_arg);
            if idx >= 0 as i64 {
                let tp: *const Vec<Target> = (&m.targets) as *const Vec<Target>;
                let t: *const Target = tp.at_const(idx);
                match (*t).kind {
                    TargetKind::Bin => { sel_target = target_arg; start_k = 2; }
                    TargetKind::Lib => {
                        println_str(2, "lforge: cannot run a lib target");
                        return 1;
                    }
                }
            }
        }
        let mut k: i32 = start_k;
        while k < pn {
            let a: str = positional(k);
            let mut copy: String = String::new();
            copy.push_str(a);
            rap.push(copy);
            k = k + 1;
        }
        return cmd_run_named(&m, profile, sel_target, &run_args);
    }
    println_str(2, "lforge: unknown command (expected: build, run, test, install, clean)");
    return 2;
}
