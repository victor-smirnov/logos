// lforge.hermes_io — manifest-reading helpers over hermes2 documents.
//
// hermes2 HAny is self-relative: no view/base threading — readers take the
// node handle directly.

package lforge.hermes_io;

use logos.mem.string;
use logos.lang.str;
use logos.lang.result;
use logos.mem.collections.vec;
use logos.lang.hermes2.anyval;
use logos.lang.hermes2.hmap;
use logos.lang.hermes2.hstring;
use logos.lang.hermes2.array;
use lforge.schema;
use lforge.util;

fn map_get2(root: HAny, key: str) -> HAny {
    if !root.is_map() { return HAny::ref_to(0i64 as *const u8); }
    return unsafe { (&*(root.resolve() as *const HMap<HString, HVal>)).get(key) };
}

pub fn read_str_field(root: HAny, key: str) -> Result<String, ManifestError> {
    unsafe {
        let v: HAny = map_get2(root, key);
        if v.is_null() {
            return Result::Err(err_msg2("manifest: missing required field ", key));
        }
        if !v.is_string() {
            return Result::Err(err_msg2("manifest: not a string: ", key));
        }
        let hs: &HString = &*(v.resolve() as *const HString);
        let mut out: String = String::new();
        out.push_str(hs.as_str());
        return Result::Ok(out);
    }
}

pub fn read_str_opt(root: HAny, key: str) -> String {
    let mut out: String = String::new();
    unsafe {
        let v: HAny = map_get2(root, key);
        if !v.is_null() && v.is_string() {
            let hs: &HString = &*(v.resolve() as *const HString);
            out.push_str(hs.as_str());
        }
    }
    return out;
}

pub fn read_str_array(root: HAny, key: str) -> Vec<String> {
    let mut out: Vec<String> = vec_new::<String>();
    unsafe {
        let v: HAny = map_get2(root, key);
        if !v.is_null() && v.is_array() {
            let arr: &HArray<HVal> = &*(v.resolve() as *const HArray<HVal>);
            let n: i64 = arr.len();
            let mut i: i64 = 0;
            while i < n {
                let elem: HAny = arr.get(i);
                if elem.is_string() {
                    let hs: &HString = &*(elem.resolve() as *const HString);
                    let mut s: String = String::new();
                    s.push_str(hs.as_str());
                    out.push(s);
                }
                i = i + 1;
            }
        }
    }
    return out;
}
