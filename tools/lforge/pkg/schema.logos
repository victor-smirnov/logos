// SPDX-License-Identifier: Apache-2.0
// lforge — schema types: Manifest, Target, dep records, lock state.

package lforge.schema;

use std.lang.text;
use std.collections.vec;

pub enum TargetKind { Bin, Lib }

pub struct Target {
    pub kind:  TargetKind,
    pub name:  String,
    pub src:   String,           // dir for Logos sources (may be empty)
    pub entry: String,           // empty for lib targets
    pub deps:  Vec<String>,      // names of sibling lib targets
    // Native sources, project-root-relative paths. C and asm files are
    // compiled via `cc -c <src> -o <stem>.<ext>.o` and folded into the
    // same archive as Logos artifacts. Both arrays are independently
    // optional; `src` may also be empty for pure-native libs.
    pub c_sources:   Vec<String>,
    pub asm_sources: Vec<String>,
}

// External dependency on another lforge project. Either a local path
// (`path:`) or a git URL (`project:`) -- exactly one. For git deps,
// exactly one of `tag` / `branch` / `sha` must be set.
pub struct ExternalDep {
    pub path:    String,
    pub project: String,
    pub tag:     String,
    pub branch:  String,
    pub sha:     String,
    pub modules: Vec<String>,
}

// Built archive of an external dep, surfaced to consumer compiles.
// `cache_key` is the sha256-hex content-addressed cache key (B4) for git
// deps; empty for local-path deps that aren't cached. Used as input to
// downstream consumers' own keys so a sub-dep change invalidates them.
pub struct ExternalLib {
    pub name:         String,    // lib target name in the external project
    pub archive_path: String,    // absolute path to the built .a
    pub cache_key:    String,    // sha256-hex (empty for non-cached)
}

// One pinned entry in lforge.lock (B3). `tag` is preserved for diff
// readability; SHA is the source of truth for what gets fetched.
pub struct LockEntry {
    pub project: String,
    pub tag:     String,
    pub sha:     String,
}

// One git project that's been resolved during the closure walk. Used to
// detect MVS conflicts (same project at different versions in the same
// closure) and apply the lockfile's pin atomically across all consumers.
pub struct GitWinner {
    pub display: String,
    pub tag:     String,
    pub sha:     String,
}

// One `replace:` entry. Matches by `project` (canonicalised display id);
// substitution form is a local `path:`. Other replacement forms (e.g.
// `replace foo@v1 with foo@v2`) can land later — for v1, path-only.
pub struct ReplaceEntry {
    pub project: String,
    pub path:    String,
}

pub struct Manifest {
    pub name:           String,
    pub version:        String,
    pub requires_logos: String,        // e.g. "0.1" — empty = no floor
    pub targets:        Vec<Target>,
    pub deps:           Vec<ExternalDep>,
    pub replace:        Vec<ReplaceEntry>,
}

pub struct ManifestError {
    pub message: String,
}
