// lforge — top-level command handlers (build / update / run / clean /
// install / test). Each one consumes a parsed Manifest + a profile.

package lforge.cmd;

use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.mem.collections.vec;
use logos.std.io.fs;
use logos.std.env;

use lforge.schema_types;
use lforge.util;
use lforge.proc;
use lforge.lockfile;
use lforge.topo;
use lforge.build_paths;
use lforge.cwd;
use lforge.builder;
use lforge.external_build;

// B5: parse `logosc --version` (format: "logosc X.Y[.Z]") into the bare
// version segment. Empty string means we couldn't determine — the caller
// treats that as a soft pass.
pub fn get_logosc_version(logosc: &String) -> String {
    unsafe {
        let mut argv: Vec<String> = vec_new::<String>();
    push_string_arg(&mut argv, logosc);
    push_arg(&mut argv, "--version");
    let res: (i32, String) = run_child_capture_stdout(&argv);
    let rc:  i32 = res.0;
    let out: String = res.1;
    if rc != 0 { return String::new(); }
    let view: str = out.as_str();
    // First line, after the prefix "logosc ".
    let mut start: i64 = 0 as i64;
    let prefix: str = "logosc ";
    let n: i64 = view.len();
    if n >= 7 as i64 {
        let mut ok: bool = true;
        let mut k: i64 = 0 as i64;
        while k < 7 as i64 && ok {
            if view[k] != prefix[k] { ok = false; }
            k = k + 1 as i64;
        }
        if ok { start = 7 as i64; }
    }
    let mut end: i64 = n;
    let mut i: i64 = start;
    while i < end {
        let cc: i32 = view[i] as i32;
        if cc == 10 as i32 || cc == 13 as i32 || cc == 32 as i32 { end = i; }
        else { i = i + 1 as i64; }
    }
    let mut s: String = String::new();
    s.push_bytes((view.as_ptr() as i64 + start) as *const u8, end - start);
    return s;
    }
}

// B5: compare logosc's reported version to the manifest's `requires_logos`
// floor. Returns 0 OK, 1 error (already printed). Empty floor → pass.
pub fn check_requires_logos(m: &Manifest) -> i32 {
    if m.requires_logos.len() == 0 as i64 { return 0; }
    let logosc: String = resolve_logosc_path();
    let have: String = get_logosc_version(&logosc);
    if have.len() == 0 as i64 {
        println_str(2, "lforge: warning: could not determine logosc version; skipping requires_logos check");
        return 0;
    }
    let hv: str = have.as_str();
    let nv: str = m.requires_logos.as_str();
    let cmp: i32 = cmp_tags(hv, nv);
    if cmp < 0 as i32 {
        print_str(2, "lforge: error: this manifest requires logosc >= ");
        print_str(2, nv);
        print_str(2, ", but the active compiler is ");
        println_str(2, hv);
        return 1;
    }
    return 0;
}

// If `selected_idx` >= 0, build only that target plus its transitive deps.
// Otherwise build everything in topo order. `dump_metacall_sel` is the raw
// `--dump-metacall` argument: empty disables dumping; `*` or any non-empty
// value triggers logosc to write metafn-emitted ASTs as Logos source under
// `.lforge/<profile>/dump/<target>/<callee>__<file>_<line>/post_quote.logos`.
// (Selector filtering is a v2 — the current build dumps every metacall in
// each target's compilation; the directory layout makes greping easy.)
pub fn cmd_build_selected(m: &Manifest, profile: str, selected_idx: i64, use_lock: bool,
                                 dump_metacall_sel: &String) -> i32 {
    unsafe {
        let logosc: String = resolve_logosc_path();
    let lib_dir: String = resolve_logos_lib_dir();

    // Toolchain-change gate: lforge's incremental skip keys on source mtimes, so
    // a compiler upgrade (same sources, new logosc) would otherwise reuse stale
    // .o/.a/bin. Compare the current `logosc --version` (which carries a build
    // discriminator: commit id when clean, +timestamp when dirty/snapshot)
    // against the stamp that produced this profile's outputs; on mismatch force a
    // full rebuild. Empty version (couldn't query) → don't disrupt.
    let cur_ver: String = get_logosc_version(&logosc);
    let stamp_p: String = toolchain_stamp_path(profile);
    let mut force_rebuild: bool = false;
    if cur_ver.len() > 0 as i64 {
        if is_file(stamp_p.as_str()) {
            match read_to_string(stamp_p.as_str()) {
                Result::Ok(prev) => {
                    if !str_eq_local(prev.as_str(), cur_ver.as_str()) {
                        force_rebuild = true;
                        println_str(1, "lforge: compiler changed since last build — rebuilding all");
                    }
                }
                Result::Err(_) => { force_rebuild = true; }
            }
        } else {
            force_rebuild = true;   // no stamp (pre-feature / fresh tree) → rebuild + stamp
        }
    }

    // Build external (project-level) deps first so their archives are
    // available when local targets resolve their per-target deps. The
    // lockfile gives us a fast-path: tags pinned in lforge.lock skip
    // ls-remote, and the freshly resolved entries are written back at
    // the end of the build.
    let mut lock_in: Vec<LockEntry> = vec_new::<LockEntry>();
    if use_lock { lock_in = read_lockfile_or_empty("./lforge.lock"); }
    let mut lock_out: Vec<LockEntry> = vec_new::<LockEntry>();
    let mut visited: Vec<String> = vec_new::<String>();
    let mut winners: Vec<GitWinner> = vec_new::<GitWinner>();
    let externals: Vec<ExternalLib> = match build_all_externals(
        &m.deps, profile, &logosc,
        &lock_in,
        &mut lock_out,
        &mut visited,
        &mut winners,
        &m.replace) {
        Result::Err(rc) => { return rc; }
        Result::Ok(libs) => { libs }
    };

    // Write a fresh lockfile if anything changed (or didn't exist).
    if m.deps.length() > 0 as i64 {
        let rc: i32 = write_lockfile("./lforge.lock", &lock_out);
        if rc != 0 { println_str(2, "lforge: warning: could not write lforge.lock"); }
    }

    let full_order: Vec<i64> = match topo_order(&m.targets, &externals) {
        Result::Err(e) => {
            print_str(2, "lforge: ");
            println_str(2, e.message.as_str());
            return 1;
        }
        Result::Ok(o) => { o }
    };

    // Compute which targets to actually build. If selected_idx < 0 → all.
    // Else mark selected + transitively close over deps and intersect.
    let nt: i64 = m.targets.length();
    let want: *mut u8 = alloc(nt);
    let mut wi: i64 = 0 as i64;
    while wi < nt {
        if selected_idx < 0 as i64 { want[wi] = 1 as u8; }
        else                       { want[wi] = 0 as u8; }
        wi = wi + 1 as i64;
    }
    if selected_idx >= 0 as i64 {
        // Iterate to fixed point: for any wanted target, mark its deps
        // wanted too.
        want[selected_idx] = 1 as u8;
        let mut changed: bool = true;
        while changed {
            changed = false;
            let mut k: i64 = 0 as i64;
            while k < nt {
                if want[k] == 1 as u8 {
                    let t: &Target = m.targets.borrow(k);
                    let dn: i64 = t.deps.length();
                    let dp: &Vec<String> = &t.deps;
                    let mut di: i64 = 0 as i64;
                    while di < dn {
                        let nm: &String = dp.borrow(di);
                        let nm_view: str = nm.as_str();
                        let didx: i64 = find_target_index(&m.targets, nm_view);
                        if didx >= 0 as i64 && want[didx] == 0 as u8 {
                            want[didx] = 1 as u8;
                            changed = true;
                        }
                        di = di + 1 as i64;
                    }
                }
                k = k + 1 as i64;
            }
        }
    }

    let n_ord: i64 = full_order.length();
    let mut i: i64 = 0 as i64;
    let mut built: i32 = 0;
    while i < n_ord {
        let idx_p: &i64 = full_order.borrow(i);
        let idx: i64 = *idx_p;
        i = i + 1 as i64;
        if want[idx] == 0 as u8 { continue; }
        let t: &Target = m.targets.borrow(idx);
        // Per-target dump dir: .lforge/<profile>/dump/<target>/. logosc
        // creates per-metacall subdirs by callee + file:line. The selector
        // value (`*` / callee / file:line) is passed verbatim to logosc as
        // --dump-metaprog-filter; logosc applies a substring/equality
        // match against ctx.callee_name / ctx.trigger / file:line.
        let mut dump_dir: String = String::new();
        if dump_metacall_sel.len() > 0 as i64 {
            dump_dir.push_str(".lforge/");
            dump_dir.push_str(profile);
            dump_dir.push_str("/dump/");
            dump_dir.push_str(t.name.as_str());
        }
        let rc: i32 = match t.kind {
            TargetKind::Lib => { build_lib(t, profile, &logosc, &lib_dir, &externals, &dump_dir, dump_metacall_sel, force_rebuild) }
            TargetKind::Bin => { build_bin(t, &m.targets, profile, &logosc, &lib_dir, &externals, &dump_dir, dump_metacall_sel, force_rebuild) }
        };
        if rc != 0 {
            dealloc(want);
            return rc;
        }
        built = built + 1;
    }
    dealloc(want);
    // Record the compiler version that produced these outputs (best-effort; the
    // profile dir exists once a target has built). Next build compares against it.
    if cur_ver.len() > 0 as i64 {
        match write_string(stamp_p.as_str(), &cur_ver) {
            Result::Ok(_)  => { }
            Result::Err(_) => { }
        }
    }
    println_str(1, "lforge: build OK");
    return 0;
    }
}

pub fn cmd_build(m: &Manifest, profile: str) -> i32 {
    let empty: String = String::new();
    return cmd_build_selected(m, profile, 0 as i64 - 1 as i64, true, &empty);
}

// `lforge update` — re-resolve every git dep ignoring the lockfile, then
// rewrite it. Equivalent to `cmd_build` with use_lock=false.
pub fn cmd_update(m: &Manifest, profile: str) -> i32 {
    let empty: String = String::new();
    return cmd_build_selected(m, profile, 0 as i64 - 1 as i64, false, &empty);
}

// Find the first bin target's name (for `lforge run`).
pub fn first_bin_name(m: &Manifest) -> String {
    let n: i64 = m.targets.length();
    let mut i: i64 = 0 as i64;
    while i < n {
        let t: &Target = m.targets.borrow(i);
        match t.kind {
            TargetKind::Bin => {
                let mut out: String = String::new();
                out.push_str(t.name.as_str());
                return out;
            }
            TargetKind::Lib => { }
        }
        i = i + 1 as i64;
    }
    return String::new();
}

// Build (selected target if name non-empty) and run the bin target. If no
// name is given, runs the first bin target in declared order.
pub fn cmd_run_named(m: &Manifest, profile: str,
                            target_name: str, run_args: &Vec<String>) -> i32 { unsafe {    // Pick the bin name (and selected build index).
    let mut bin_nm: String = String::new();
    let mut sel_idx: i64 = 0 as i64 - 1 as i64;
    if target_name.len() > 0 as i64 {
        sel_idx = find_target_index(&m.targets, target_name);
        if sel_idx < 0 as i64 {
            println_str(2, "lforge: unknown target");
            return 1;
        }
        bin_nm.push_str(target_name);
    } else {
        bin_nm = first_bin_name(m);
        if bin_nm.len() == 0 as i64 {
            println_str(2, "lforge: project has no bin target to run");
            return 1;
        }
    }

    let empty: String = String::new();
    let rc: i32 = cmd_build_selected(m, profile, sel_idx, true, &empty);
    if rc != 0 { return rc; }

    let bp: String = bin_path(profile, bin_nm.as_str());
    let mut argv: Vec<String> = vec_new::<String>();
    push_string_arg(&mut argv, &bp);
    let an: i64 = run_args.length();
    let mut i: i64 = 0 as i64;
    while i < an {
        let s: &String = run_args.borrow(i);
        push_string_arg(&mut argv, s);
        i = i + 1 as i64;
    }
    return run_child(&argv);
    }
}

pub fn cmd_clean() -> i32 {
    match rm_rf(".lforge") {
        Result::Err(_) => { return 1; }
        Result::Ok(_)  => { return 0; }
    }
}

// ── lforge install ────────────────────────────────────────────────────────
//
// Copies built artifacts to a standard prefix layout:
//   bin targets → <prefix>/bin/<name>            (mode 0755)
//   lib targets → <prefix>/lib/lib<name>.a       (mode 0644)
//
// Triggers a build first so artifacts are present and up-to-date.
// Default prefix is /usr/local. Override with `--prefix <path>` (or
// `--prefix=<path>`).

fn install_one(src: &String, dst: &String, mode: str) -> i32 {
    unsafe {
        let mut argv: Vec<String> = vec_new::<String>();
    push_arg(&mut argv, "install");
    push_arg(&mut argv, "-D");
    push_arg(&mut argv, "-m");
    push_arg(&mut argv, mode);
    push_string_arg(&mut argv, src);
    push_string_arg(&mut argv, dst);
    return run_child(&argv);
    }
}

fn read_prefix() -> String {
    let mut s: String = String::new();
    match get_option("prefix", "") {
        Option::Some(v) => { s.push_str(v); }
        Option::None    => { s.push_str("/usr/local"); }
    }
    return s;
}

pub fn cmd_install(m: &Manifest, profile: str) -> i32 {
    // Build first.
    let rc: i32 = cmd_build(m, profile);
    if rc != 0 { return rc; }

    let prefix: String = read_prefix();
    let pview: str = prefix.as_str();

    let mut bin_dir: String = String::new();
    bin_dir.push_str(pview); append_path(&mut bin_dir, "bin");
    let mut lib_dir: String = String::new();
    lib_dir.push_str(pview); append_path(&mut lib_dir, "lib");

    let nt: i64 = m.targets.length();
    let mut i: i64 = 0 as i64;
    while i < nt {
        let t: &Target = m.targets.borrow(i);
        i = i + 1 as i64;
        let nm_view: str = t.name.as_str();
        match t.kind {
            TargetKind::Bin => {
                let src: String = bin_path(profile, nm_view);
                let mut dst: String = String::new();
                dst.push_str(bin_dir.as_str());
                append_path(&mut dst, nm_view);
                let mut msg: String = String::new();
                msg.push_str("lforge: install ");
                msg.push_str(dst.as_str());
                println_string(1, &msg);
                let rci: i32 = install_one(&src, &dst, "0755");
                if rci != 0 {
                    println_str(2, "lforge: install failed");
                    return rci;
                }
            }
            TargetKind::Lib => {
                let src: String = lib_archive_path(profile, nm_view);
                let mut dst: String = String::new();
                dst.push_str(lib_dir.as_str());
                let mut leaf: String = String::new();
                leaf.push_str("lib");
                leaf.push_str(nm_view);
                leaf.push_str(".a");
                append_path(&mut dst, leaf.as_str());
                let mut msg: String = String::new();
                msg.push_str("lforge: install ");
                msg.push_str(dst.as_str());
                println_string(1, &msg);
                let rci: i32 = install_one(&src, &dst, "0644");
                if rci != 0 {
                    println_str(2, "lforge: install failed");
                    return rci;
                }
            }
        }
    }
    println_str(1, "lforge: install OK");
    return 0;
}

// ── lforge test ───────────────────────────────────────────────────────────
//
// Walks `tests/` (top level only — no recursion for now) for `*.logos`
// files. Each file is treated as a stand-alone test program: compile,
// link with all project lib targets, run, expect exit 0. Per-test
// artifacts go under .lforge/<profile>/test/<name>.{o,bin}.
//
// Failures aggregate; exit code is 0 iff every test passed.

// The test's COMPILE command (logosc → .o). Split out of build_test_bin so a
// whole suite's compiles can go through the job pool instead of one at a time.
pub fn test_compile_argv(test_logos: &String, test_name: &String,
                         targets: &Vec<Target>, profile: str,
                         logosc: &String) -> Vec<String> {
    let mut argv: Vec<String> = vec_new::<String>();
    let obj_path: String = test_obj_path(test_name, profile);
    push_string_arg(&mut argv, logosc);
    push_string_arg(&mut argv, test_logos);
    push_arg(&mut argv, "-o");
    push_string_arg(&mut argv, &obj_path);
    // The profile's flags, exactly as lib and bin targets get them — tests were
    // the one path compiled at -O0 whatever was asked for, which is why an
    // assertion-heavy law sweep dominated the suite's wall time (20s at -O0,
    // 8s at -O2 — and the optimized compile is not the slower one). `lforge
    // test --release` is now the fast loop; debug keeps -g for a debuggable
    // failure.
    profile_compile_flags(profile, &mut argv);
    {
        let gd: String = gensrc_dir_for(profile);
        push_arg(&mut argv, "--gen-dir");
        let ga: String = make_absolute(gd.as_str());
        argv.push(ga);
    }
    let mut all_lib_archs: Vec<String> = vec_new::<String>();
    collect_lib_archives(targets, profile, &mut all_lib_archs);
    let lan: i64 = all_lib_archs.length();
    let mut li: i64 = 0 as i64;
    while li < lan {
        let sa: &String = all_lib_archs.borrow(li);
        push_arg(&mut argv, "-l");
        push_string_arg(&mut argv, sa);
        li = li + 1 as i64;
    }
    return argv;
}

/// Where a test's object and binary live.
pub fn test_obj_path(test_name: &String, profile: str) -> String {
    let mut p: String = String::new();
    p.push_str(".lforge/"); p.push_str(profile); p.push_str("/test/");
    p.push_str(test_name.as_str()); p.push_str(".o");
    return p;
}

pub fn test_bin_path(test_name: &String, profile: str) -> String {
    let mut p: String = String::new();
    p.push_str(".lforge/"); p.push_str(profile); p.push_str("/test/");
    p.push_str(test_name.as_str());
    return p;
}

// Every lib target's archive — tests are top-level consumers of all of them.
fn collect_lib_archives(targets: &Vec<Target>, profile: str, out: &mut Vec<String>) {
    let nt: i64 = targets.length();
    let mut ti: i64 = 0 as i64;
    while ti < nt {
        let tt: &Target = targets.borrow(ti);
        match tt.kind {
            TargetKind::Lib => {
                let p: String = lib_archive_path(profile, tt.name.as_str());
                out.push(p);
            }
            TargetKind::Bin => { }
        }
        ti = ti + 1 as i64;
    }
}

/// The stdlib + project archives a test links against, newest-mtime of which
/// decides whether its binary is stale (the stale-link trap: a fresh source
/// with an old archive must still relink).
pub fn test_link_inputs(targets: &Vec<Target>, profile: str, lib_dir: &String) -> Vec<String> {
    let mut out: Vec<String> = vec_new::<String>();
    collect_lib_archives(targets, profile, &mut out);
    let lv: str = lib_dir.as_str();
    let names: [str; 7] = ["liblogos-std.a", "liblogos-lcm.a", "liblogos-mem.a",
                           "liblogos-lang.a", "liblstdlib_fibers.a",
                           "liblstdlib_rt.a", "liblstdlib_uring.a"];
    let mut i: i64 = 0 as i64;
    while i < 7 as i64 {
        let mut p: String = String::new();
        p.push_str(lv); append_path(&mut p, names[i]);
        out.push(p);
        i = i + 1 as i64;
    }
    return out;
}

fn build_test_bin(test_logos: &String,
                          test_name:  &String,
                          targets:    &Vec<Target>,
                          profile:    str,
                          logosc:     &String,
                          lib_dir:    &String) -> i32 { unsafe {    // Output dirs.
    let mut td: String = String::new();
    td.push_str(".lforge/");
    td.push_str(profile);
    td.push_str("/test");
    let td_view: str = td.as_str();
    match mkdir_p(td_view) {
        Result::Err(_) => { return 1; }
        Result::Ok(_)  => { }
    }

    let mut obj_path: String = String::new();
    obj_path.push_str(td.as_str());
    obj_path.push_u8(47 as u8);
    obj_path.push_str(test_name.as_str());
    obj_path.push_str(".o");

    let mut bin_p: String = String::new();
    bin_p.push_str(td.as_str());
    bin_p.push_u8(47 as u8);
    bin_p.push_str(test_name.as_str());

    // Tests link against every lib target in the project (mimics
    // ctest pattern: tests are top-level consumers of the libs).
    let mut all_lib_archs: Vec<String> = vec_new::<String>();
    let nt: i64 = targets.length();
    let mut ti: i64 = 0 as i64;
    while ti < nt {
        let tt: &Target = targets.borrow(ti);
        match tt.kind {
            TargetKind::Lib => {
                let nm_view: str = tt.name.as_str();
                let p: String = lib_archive_path(profile, nm_view);
                all_lib_archs.push(p);
            }
            TargetKind::Bin => { }
        }
        ti = ti + 1 as i64;
    }

    // logosc <test_logos> -o <obj> [-l <lib>]...
    let mut argv: Vec<String> = vec_new::<String>();
    push_string_arg(&mut argv, logosc);
    push_string_arg(&mut argv, test_logos);
    push_arg(&mut argv, "-o");
    push_string_arg(&mut argv, &obj_path);
    // Generated sources of container/metaprog decls in TESTS land in the
    // project gen dir too (display-only here — tests compile without -g).
    {
        let gd: String = gensrc_dir_for(profile);
        push_arg(&mut argv, "--gen-dir");
        let ga: String = make_absolute(gd.as_str());
        argv.push(ga);
    }
    let lan: i64 = all_lib_archs.length();
    let mut li: i64 = 0 as i64;
    while li < lan {
        let s: &String = all_lib_archs.borrow(li);
        push_arg(&mut argv, "-l");
        push_string_arg(&mut argv, s);
        li = li + 1 as i64;
    }
    let rc: i32 = run_child(&argv);
    if rc != 0 { return rc; }

    if lib_dir.len() == 0 as i64 {
        println_str(2, "lforge: cannot locate Logos lib dir");
        return 1;
    }

    let largv: Vec<String> = test_link_argv(test_name, targets, profile, lib_dir);
    return run_child(&largv);
    }
}

/// The test's LINK command (cc → binary), pool-runnable like the compile.
///
// cc <obj> --start-group [<lib>...] <stdlib_archives> --end-group … -o <bin>
pub fn test_link_argv(test_name: &String, targets: &Vec<Target>, profile: str,
                      lib_dir: &String) -> Vec<String> {
    let obj_path: String = test_obj_path(test_name, profile);
    let bin_p: String = test_bin_path(test_name, profile);
    let mut all_lib_archs: Vec<String> = vec_new::<String>();
    collect_lib_archives(targets, profile, &mut all_lib_archs);
    let lan: i64 = all_lib_archs.length();
    // ALL FOUR stdlib layers (std+lcm+mem+lang) inside one ld group: a test
    // may reference any layer directly (e.g. logos.lang.mem::alloc), and
    // archive cross-references make single-pass left-to-right ordering
    // fragile — the group mirrors the repo ctest harness (run_test.sh).
    // The set must equal logosc's symbol-discovery glob (all liblogos-*.a):
    // a mono instance carried only by a higher layer's archive (layer
    // dedup, e.g. Vec$G1$u64__clear living in liblogos-lcm.a) is
    // body-skipped at compile and resolves only if that layer is linked.
    let mut largv: Vec<String> = vec_new::<String>();
    push_arg(&mut largv, "cc");
    push_arg(&mut largv, "-Wl,--gc-sections");
    push_string_arg(&mut largv, &obj_path);
    push_arg(&mut largv, "-Wl,--start-group");
    let mut lk: i64 = 0 as i64;
    while lk < lan {
        let s: &String = all_lib_archs.borrow(lk);
        push_string_arg(&mut largv, s);
        lk = lk + 1 as i64;
    }
    let lib_view: str = lib_dir.as_str();
    let mut p1: String = String::new();
    p1.push_str(lib_view); append_path(&mut p1, "liblogos-std.a"); largv.push(p1);
    let mut p1c: String = String::new();
    p1c.push_str(lib_view); append_path(&mut p1c, "liblogos-lcm.a"); largv.push(p1c);
    let mut p1m: String = String::new();
    p1m.push_str(lib_view); append_path(&mut p1m, "liblogos-mem.a"); largv.push(p1m);
    let mut p1l: String = String::new();
    p1l.push_str(lib_view); append_path(&mut p1l, "liblogos-lang.a"); largv.push(p1l);
    let mut p2: String = String::new();
    p2.push_str(lib_view); append_path(&mut p2, "liblstdlib_fibers.a"); largv.push(p2);
    let mut p3: String = String::new();
    p3.push_str(lib_view); append_path(&mut p3, "liblstdlib_rt.a"); largv.push(p3);
    let mut p4: String = String::new();
    p4.push_str(lib_view); append_path(&mut p4, "liblstdlib_uring.a"); largv.push(p4);
    push_arg(&mut largv, "-Wl,--end-group");
    push_arg(&mut largv, "-Wl,--allow-multiple-definition");
    push_arg(&mut largv, "-lpthread");
    push_arg(&mut largv, "-lm");
    push_arg(&mut largv, "-lstdc++");
    push_arg(&mut largv, "-o");
    push_string_arg(&mut largv, &bin_p);
    return largv;
}

// Strip a path's trailing extension. "tests/foo.logos" → "tests/foo".
fn strip_dot_logos(s: str) -> String {
    let mut out: String = String::new();
    let n: i64 = s.len();
    let mut stripped: bool = false;
    if n >= 6 as i64 {
        let suffix: str = ".logos";
        let off: i64 = n - 6 as i64;
        let mut ok: bool = true;
        let mut k: i64 = 0 as i64;
        while k < 6 as i64 && ok {
            if s[off + k] != suffix[k] { ok = false; }
            k = k + 1 as i64;
        }
        if ok {
            out.push_bytes(s.as_ptr(), off);
            stripped = true;
        }
    }
    if !stripped {
        out.push_str(s);
    }
    return out;
}

// Extract base file name from a path: "a/b/c.logos" → "c.logos".
fn basename_view(p: str) -> str {
    let n: i64 = p.len();
    let mut start: i64 = 0 as i64;
    let mut i: i64 = n - 1 as i64;
    while i >= 0 as i64 {
        if (p[i] as i32) == 47 { start = i + 1 as i64; i = 0 as i64 - 1 as i64; }
        else { i = i - 1 as i64; }
    }
    return str_from_raw((p.as_ptr() as i64 + start) as *const u8, n - start);
}

pub fn cmd_test(m: &Manifest, profile: str) -> i32 {
    unsafe {
        // 1. Build all lib targets first; bin targets are not needed for tests.
    let logosc:  String = resolve_logosc_path();
    let lib_dir: String = resolve_logos_lib_dir();
    // External deps are not threaded through cmd_test yet — that lands when
    // tests need to import from external libs (B3+).
    let no_externals: Vec<ExternalLib> = vec_new::<ExternalLib>();
    let order: Vec<i64> = match topo_order(&m.targets, &no_externals) {
        Result::Err(e) => {
            print_str(2, "lforge: ");
            println_str(2, e.message.as_str());
            return 1;
        }
        Result::Ok(o) => { o }
    };
    let n_ord: i64 = order.length();
    let mut k: i64 = 0 as i64;
    while k < n_ord {
        let idx_p: &i64 = order.borrow(k);
        let idx: i64 = *idx_p;
        let t: &Target = m.targets.borrow(idx);
        match t.kind {
            TargetKind::Lib => {
                let no_dump: String = String::new();
                let no_filter: String = String::new();
                let rc: i32 = build_lib(t, profile, &logosc, &lib_dir, &no_externals, &no_dump, &no_filter, false);
                if rc != 0 {
                    println_str(2, "lforge: lib target failed; aborting test run");
                    return rc;
                }
            }
            TargetKind::Bin => { }
        }
        k = k + 1 as i64;
    }

    // 2. Walk tests/ for .logos files.
    if !is_dir("tests") {
        println_str(1, "lforge: no tests/ dir, nothing to test");
        return 0;
    }

    let mut names: Vec<String> = vec_new::<String>();   // stem per test
    let mut paths: Vec<String> = vec_new::<String>();   // source per test
    {
        let entries: Vec<DirEntry> = walk_dir("tests");
        let en: i64 = entries.length();
        let mut ei: i64 = 0 as i64;
        while ei < en {
            let de: &DirEntry = entries.borrow(ei);
            ei = ei + 1 as i64;
            if de.is_dir { continue; }
            let pview: str = de.name.as_str();
            if !str_ends_with(pview, ".logos") { continue; }
            let stem: String = strip_dot_logos(basename_view(pview));
            let mut pp: String = String::new();
            pp.push_str(pview);
            names.push(stem);
            paths.push(pp);
        }
    }
    let nts: i64 = names.length();
    if nts == 0 as i64 {
        println_str(1, "lforge: no tests found");
        return 0;
    }

    {
        let mut td: String = String::new();
        td.push_str(".lforge/"); td.push_str(profile); td.push_str("/test");
        match mkdir_p(td.as_str()) {
            Result::Err(_) => { println_str(2, "lforge: cannot create test dir"); return 1; }
            Result::Ok(_)  => { }
        }
    }

    // ── 3. COMPILE every stale test, in parallel ────────────────────────────
    //
    // One test at a time was the whole suite's cost: logosc is single-threaded
    // per invocation and the tests are independent, so the run was as long as
    // the sum of its compiles. Now the pool runs `LFORGE_JOBS` (default 8) at
    // once, and a test whose binary is newer than its source AND newer than
    // every archive it links is skipped entirely — the archive half of that
    // check is what keeps a stale binary from being re-run against a rebuilt
    // stdlib.
    let mut link_inputs: Vec<String> = test_link_inputs(&m.targets, profile, &lib_dir);
    // The COMPILER counts as an input: a rebuilt logosc means new codegen (and
    // new flags — this is what keeps a profile switch from re-running yesterday's
    // binaries).
    {
        let mut lc: String = String::new();
        lc.push_str(logosc.as_str());
        link_inputs.push(lc);
    }
    let archives_mt: i64 = newest_mtime(&link_inputs);
    let slots: i64 = job_slots(8 as i64);

    let mut stale: Vec<i64> = vec_new::<i64>();
    {
        let mut i: i64 = 0 as i64;
        while i < nts {
            let src: &String = paths.borrow(i);
            let stem: &String = names.borrow(i);
            let bin_p: String = test_bin_path(stem, profile);
            let mut newest: i64 = archives_mt;
            match mtime_ns(src.as_str()) {
                Result::Ok(t)  => { if t > newest { newest = t; } }
                Result::Err(_) => { }
            }
            if !output_is_fresh(bin_p.as_str(), newest) { stale.push(i); }
            i = i + 1 as i64;
        }
    }

    let n_stale: i64 = stale.length();
    if n_stale > 0 as i64 {
        let mut msg: String = String::new();
        msg.push_str("lforge: compiling ");
        msg.push_i64(n_stale);
        msg.push_str(" of ");
        msg.push_i64(nts);
        msg.push_str(" test(s), ");
        msg.push_i64(slots);
        msg.push_str(" at a time");
        println_string(1, &msg);
    }

    let mut broken: Vec<i64> = vec_new::<i64>();
    if n_stale > 0 as i64 {
        let mut cjobs: Vec<Vec<String>> = vec_new::<Vec<String>>();
        {
            let mut i: i64 = 0 as i64;
            while i < n_stale {
                let idx: i64 = *stale.borrow(i);
                cjobs.push(test_compile_argv(paths.borrow(idx), names.borrow(idx),
                                             &m.targets, profile, &logosc));
                i = i + 1 as i64;
            }
        }
        let ccodes: Vec<i32> = run_jobs(&cjobs, slots);

        // ── 4. LINK the ones that compiled, in parallel ─────────────────────
        let mut ljobs: Vec<Vec<String>> = vec_new::<Vec<String>>();
        let mut linked: Vec<i64> = vec_new::<i64>();
        {
            let mut i: i64 = 0 as i64;
            while i < n_stale {
                let idx: i64 = *stale.borrow(i);
                if *ccodes.borrow(i) != 0 {
                    broken.push(idx);
                } else {
                    ljobs.push(test_link_argv(names.borrow(idx), &m.targets, profile, &lib_dir));
                    linked.push(idx);
                }
                i = i + 1 as i64;
            }
        }
        let lcodes: Vec<i32> = run_jobs(&ljobs, slots);
        {
            let mut i: i64 = 0 as i64;
            while i < linked.length() {
                if *lcodes.borrow(i) != 0 { broken.push(*linked.borrow(i)); }
                i = i + 1 as i64;
            }
        }
    }

    // ── 5. RUN, also through the pool ───────────────────────────────────────
    //
    // Execution dominates once nothing needs compiling (a suite that builds in
    // seconds still took half a minute to run), and test binaries are
    // independent processes. Their stdio is inherited, so a FAILING test's
    // diagnostics still reach the terminal — interleaved with its neighbours',
    // which is why the verdict lines are printed afterwards, in file order,
    // with each test named.
    let mut runnable: Vec<i64> = vec_new::<i64>();
    let mut rjobs: Vec<Vec<String>> = vec_new::<Vec<String>>();
    {
        let mut i: i64 = 0 as i64;
        while i < nts {
            let mut is_broken: bool = false;
            {
                let mut b: i64 = 0 as i64;
                while b < broken.length() {
                    if *broken.borrow(b) == i { is_broken = true; }
                    b = b + 1 as i64;
                }
            }
            if !is_broken {
                let bp: String = test_bin_path(names.borrow(i), profile);
                let mut argv: Vec<String> = vec_new::<String>();
                push_string_arg(&mut argv, &bp);
                rjobs.push(argv);
                runnable.push(i);
            }
            i = i + 1 as i64;
        }
    }
    // A wider cap than the build phase: waves cost their SLOWEST member, and a
    // test process is short-lived and small where a logosc invocation is neither.
    // Measured on this suite: 8 → 21s, 16 → 19s, 32 → 12.5s, against a ~7s
    // critical path (the slowest single test). A true sliding window needs
    // wait-for-ANY, which the process surface does not expose yet.
    let rcodes: Vec<i32> = run_jobs(&rjobs, slots * 4 as i64);

    let mut pass_n: i32 = 0;
    let mut fail_n: i32 = 0;
    let mut ti2: i64 = 0 as i64;
    while ti2 < nts {
        let stem: &String = names.borrow(ti2);
        let mut line: String = String::new();
        line.push_str("lforge: test ");
        line.push_str(stem.as_str());
        // find this test's run slot (absent = it never built)
        let mut slot: i64 = 0 as i64 - 1 as i64;
        {
            let mut r: i64 = 0 as i64;
            while r < runnable.length() {
                if *runnable.borrow(r) == ti2 { slot = r; }
                r = r + 1 as i64;
            }
        }
        if slot < 0 as i64 {
            line.push_str("  FAIL (compile/link)");
            println_string(2, &line);
            fail_n = fail_n + 1;
        } else if *rcodes.borrow(slot) == 0 {
            line.push_str("  PASS");
            println_string(1, &line);
            pass_n = pass_n + 1;
        } else {
            line.push_str("  FAIL (exit code)");
            println_string(2, &line);
            fail_n = fail_n + 1;
        }
        ti2 = ti2 + 1 as i64;
    }

    {
        let mut summary: String = String::new();
        summary.push_str("lforge: tests passed=");
        summary.push_i64(pass_n as i64);
        summary.push_str(" failed=");
        summary.push_i64(fail_n as i64);
        println_string(1, &summary);
    }
    if fail_n > 0 { return 1; }
    return 0;
    }
}
