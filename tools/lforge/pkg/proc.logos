// lforge — process orchestration: argv builders, blocking spawn-and-wait
// with stdout streaming or capture.

package lforge.proc;

use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.mem.collections.vec;
use logos.std.process;

use lforge.util;

pub fn push_arg(args: &mut Vec<String>, s: str) {
    let mut a: String = String::new();
    a.push_str(s);
    args.push(a);
}

pub fn push_string_arg(args: &mut Vec<String>, s: &String) {
    let mut a: String = String::new();
    a.push_str(s.as_str());
    args.push(a);
}

// Build a NUL-terminated argv buffer from `argv_strs` as an owning
// `Vec<*const u8>` — the Vec owns the pointer array and frees it on drop
// (no manual alloc/dealloc). The stored pointers borrow `argv_strs`, which
// the caller keeps alive for the whole spawn. Pass `buf.as_ptr()` to spawn.
fn build_argv_buf(argv_strs: &Vec<String>) -> Vec<*const u8> {
    let n: i64 = argv_strs.length();
    let mut buf: Vec<*const u8> = vec_new::<*const u8>();
    let mut i: i64 = 0 as i64;
    while i < n {
        buf.push(argv_strs.borrow(i).as_ptr());
        i = i + 1 as i64;
    }
    buf.push(0 as *const u8);
    return buf;
}

pub fn run_child(argv_strs: &Vec<String>) -> i32 {
    let argv_buf: Vec<*const u8> = build_argv_buf(argv_strs);
    unsafe {
        let mut child: Child = spawn(argv_buf.as_ptr() as *const *const u8, false, true, true);
        if child.pid() < 0 {
            return 0 - 1;
        }

        let mut lr_out: LineReader = child.stdout_lines();
        loop {
            match lr_out.next() {
                Option::Some(line) => { println_str(1, line.as_str()); }
                Option::None       => { break; }
            }
        }
        let mut lr_err: LineReader = child.stderr_lines();
        loop {
            match lr_err.next() {
                Option::Some(line) => { println_str(2, line.as_str()); }
                Option::None       => { break; }
            }
        }
        let st: ExitStatus = child.wait();
        return exit_rc_of(&st);
    }
}

// Shell convention for a signal death (128 + signo): code() is WEXITSTATUS,
// which reads 0 for a SIGNAL-KILLED child — an aborting test binary
// (SIGABRT on heap corruption) must NOT count as success.
fn exit_rc_of(st: &ExitStatus) -> i32 {
    if !st.exited() { return 128 + st.signal(); }
    return st.code();
}

// Spawn `argv` and capture stdout into a String. Stderr is forwarded to the
// parent's stderr. Used for short-output commands like `git ls-remote`.
pub fn run_child_capture_stdout(argv_strs: &Vec<String>) -> (i32, String) {
    let argv_buf: Vec<*const u8> = build_argv_buf(argv_strs);
    unsafe {
        let mut child: Child = spawn(argv_buf.as_ptr() as *const *const u8, false, true, true);
        if child.pid() < 0 {
            return (0 - 1, String::new());
        }

        let mut out: String = String::new();
        let mut lr_out: LineReader = child.stdout_lines();
        loop {
            match lr_out.next() {
                Option::Some(line) => {
                    if out.len() > 0 as i64 { out.push_u8(10 as u8); }
                    out.push_str(line.as_str());
                }
                Option::None => { break; }
            }
        }
        let mut lr_err: LineReader = child.stderr_lines();
        loop {
            match lr_err.next() {
                Option::Some(line) => { println_str(2, line.as_str()); }
                Option::None       => { break; }
            }
        }
        let st: ExitStatus = child.wait();
        return (exit_rc_of(&st), out);
    }
}
