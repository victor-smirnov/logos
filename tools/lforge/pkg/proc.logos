// lforge — process orchestration: argv builders, blocking spawn-and-wait
// with stdout streaming or capture.

package lforge.proc;

use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.mem.collections.vec;
use logos.std.process;

use lforge.util;

pub fn push_arg(args: &mut Vec<String>, s: str) {
    let mut a: String = String::new();
    a.push_str(s);
    args.push(a);
}

pub fn push_string_arg(args: &mut Vec<String>, s: &String) {
    let mut a: String = String::new();
    a.push_str(s.as_str());
    args.push(a);
}

// Build a NUL-terminated argv buffer from `argv_strs`. Returned pointer
// owns alloc'd memory; caller is responsible for `dealloc`.
unsafe fn build_argv_buf(argv_strs: &Vec<String>) -> *mut *const u8 {
    let n: i64 = argv_strs.length();
    let buf: *mut *const u8 = alloc((n + 1 as i64) * 8 as i64) as *mut *const u8;
    let mut i: i64 = 0 as i64;
    while i < n {
        let s: &String = argv_strs.borrow(i);
        buf[i] = s.as_ptr();
        i = i + 1 as i64;
    }
    buf[n] = 0 as *const u8;
    return buf;
}

pub fn run_child(argv_strs: &Vec<String>) -> i32 {
    unsafe {
        let argv_buf: *mut *const u8 = build_argv_buf(argv_strs);
        let mut child: Child = spawn(argv_buf as *const *const u8, false, true, true);
        if child.pid() < 0 {
            dealloc(argv_buf as *mut u8);
            return 0 - 1;
        }

        let mut lr_out: LineReader = child.stdout_lines();
        loop {
            match lr_out.next() {
                Option::Some(line) => { println_str(1, line.as_str()); }
                Option::None       => { break; }
            }
        }
        let mut lr_err: LineReader = child.stderr_lines();
        loop {
            match lr_err.next() {
                Option::Some(line) => { println_str(2, line.as_str()); }
                Option::None       => { break; }
            }
        }
        let st: ExitStatus = child.wait();
        dealloc(argv_buf as *mut u8);
        return st.code();
    }
}

// Spawn `argv` and capture stdout into a String. Stderr is forwarded to the
// parent's stderr. Used for short-output commands like `git ls-remote`.
pub fn run_child_capture_stdout(argv_strs: &Vec<String>) -> (i32, String) {
    unsafe {
        let argv_buf: *mut *const u8 = build_argv_buf(argv_strs);
        let mut child: Child = spawn(argv_buf as *const *const u8, false, true, true);
        if child.pid() < 0 {
            dealloc(argv_buf as *mut u8);
            return (0 - 1, String::new());
        }

        let mut out: String = String::new();
        let mut lr_out: LineReader = child.stdout_lines();
        loop {
            match lr_out.next() {
                Option::Some(line) => {
                    if out.len() > 0 as i64 { out.push_u8(10 as u8); }
                    out.push_str(line.as_str());
                }
                Option::None => { break; }
            }
        }
        let mut lr_err: LineReader = child.stderr_lines();
        loop {
            match lr_err.next() {
                Option::Some(line) => { println_str(2, line.as_str()); }
                Option::None       => { break; }
            }
        }
        let st: ExitStatus = child.wait();
        dealloc(argv_buf as *mut u8);
        return (st.code(), out);
    }
}
