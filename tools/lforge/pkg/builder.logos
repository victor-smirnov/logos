// lforge — per-target build_lib (one .a per lib) and build_bin (link
// final executable). Both honour the mtime-based incremental skip rule.

package lforge.builder;

use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.result;
use logos.mem.collections.vec;
use logos.std.io.fs;
use logos.std.process;
use logos.std.env;

use lforge.schema_types;
use lforge.util;
use lforge.proc;
use lforge.build_paths;
use lforge.topo;            // external_lookup — sibling-vs-external dep split
use lforge.cwd;            // make_absolute — dep -L paths survive logosc cwd
use lforge.spawn_helpers;

// Append profile-driven compilation flags to a logosc argv. debug = -g (DWARF
// debug info; -O0 is logosc's default), release = -O3 (optimized, no debug
// info). Without this, lforge profiles only changed OUTPUT PATHS — builds were
// non-debuggable at the Logos level and release was never optimized.
fn profile_compile_flags(profile: str, argv: &mut Vec<String>) {
    if str_eq_local(profile, "release") {
        // -O3 (matching cargo's release default of opt-level 3, NOT rustc -O's
        // opt-level 2): the more aggressive loop unroll/interleave thresholds
        // close much of the residual instruction-density gap vs rustc on hot
        // loops (e.g. spectral-norm 1.40×→1.22× instr) that -O2 leaves rolled.
        push_arg(argv, "-O3");
        // Release targets the host CPU by default so the backend can use
        // AVX/AVX2/AVX-512 — a large win on vectorizable code (logosc otherwise
        // emits only the SSE2 baseline). Non-portable; override the cpu with the
        // LFORGE_TARGET_CPU env var (e.g. =generic for a portable binary, or a
        // specific cpu name like x86-64-v3).
        push_arg(argv, "-C");
        match var("LFORGE_TARGET_CPU") {
            Option::Some(cpu) => {
                if cpu.len() > 0 as i64 {
                    let mut a: String = String::new();
                    a.push_str("target-cpu=");
                    a.push_str(cpu.as_str());
                    push_arg(argv, a.as_str());
                } else {
                    push_arg(argv, "target-cpu=native");
                }
            }
            Option::None => { push_arg(argv, "target-cpu=native"); }
        }
    }
    else                                { push_arg(argv, "-g"); }
}

// Push `p` made absolute (module-loader -L paths must survive logosc's cwd).
fn largv_push_abs(argv: &mut Vec<String>, p: &String) {
    let a: String = make_absolute(p.as_str());
    argv.push(a);
}

pub fn build_lib(t: &Target, profile: str, logosc: &String,
                        lib_dir: &String,
                        externals: &Vec<ExternalLib>,
                        dump_dir: &String,
                        dump_filter: &String,
                        force: bool) -> i32 {
    let lib_name_view: str = t.name.as_str();

    // ── Walk Logos source dir, if any ────────────────────────────────────
    let mut sources: Vec<String> = vec_new::<String>();
    if t.src.len() > 0 as i64 {
        let src_view: str = t.src.as_str();
        sources = collect_logos_files(src_view);
    }
    let n_src: i64 = sources.length();
    let n_c:   i64 = t.c_sources.length();
    let n_asm: i64 = t.asm_sources.length();
    if n_src == 0 as i64 && n_c == 0 as i64 && n_asm == 0 as i64 {
        let mut msg: String = String::new();
        msg.push_str("lforge: lib ");
        msg.push_str(t.name.as_str());
        msg.push_str(": no Logos / C / asm sources");
        println_string(2, &msg);
        return 1;
    }

    let pf_dir: String = per_file_dir(profile, lib_name_view);
    let pf_dir_view: str = pf_dir.as_str();
    match mkdir_p(pf_dir_view) {
        Result::Err(_) => { println_str(2, "lforge: cannot create _files dir"); return 1; }
        Result::Ok(_)  => { }
    }

    let od: String = out_dir_for(profile);
    let od_view: str = od.as_str();
    match mkdir_p(od_view) {
        Result::Err(_) => { println_str(2, "lforge: cannot create out dir"); return 1; }
        Result::Ok(_)  => { }
    }
    let arch: String = lib_archive_path(profile, lib_name_view);

    // ── Generate .module manifest text only when there are Logos files ──
    let mut man_path: String = String::new();
    if n_src > 0 as i64 {
        let gd: String = gensrc_dir_for(profile);
        let gd_view: str = gd.as_str();
        match mkdir_p(gd_view) {
            Result::Err(_) => { println_str(2, "lforge: cannot create _gen dir"); return 1; }
            Result::Ok(_)  => { }
        }
        let mut man: String = String::new();
        man.push_str("module ");
        man.push_str(t.name.as_str());
        man.push_u8(10 as u8);
        man.push_str("version 0.1\n");
        man.push_str("root ");
        man.push_str(t.src.as_str());
        man.push_u8(10 as u8);
        // SIBLING lib deps become manifest `depends` lines so the module
        // loader LINKS their archives instead of recompiling their bodies
        // from the archived ASTs (and so cross-target `use` resolves).
        // EXTERNAL deps are excluded: their archives live in the external
        // project's own out/cache dir and already reach logosc via the
        // `-l <archive>` loop below — a `depends` line would send the
        // loader hunting for lib<name>.a in OUR -L paths and fail.
        let ndeps: i64 = t.deps.length();
        let mut di: i64 = 0 as i64;
        while di < ndeps {
            let d: &String = t.deps.borrow(di);
            if external_lookup(externals, d.as_str()) < 0 as i64 {
                man.push_str("depends ");
                man.push_str(d.as_str());
                man.push_u8(10 as u8);
            }
            di = di + 1 as i64;
        }
        man_path.push_str(gd.as_str());
        man_path.push_u8(47 as u8);
        man_path.push_str(t.name.as_str());
        man_path.push_str(".module");
        match write_string(man_path.as_str(), &man) {
            Result::Err(_) => { println_str(2, "lforge: cannot write generated .module"); return 1; }
            Result::Ok(_)  => { }
        }
    }

    // ── For each source: determine whether per-file .o is up-to-date.   ──
    // Spawn the rebuilds in parallel; collect Child handles to wait on.
    let mut children: Vec<Child> = vec_new::<Child>();
    let mut rebuilt_count: i32 = 0;

    // Logos files via logosc --only-file
    let mut i: i64 = 0 as i64;
    while i < n_src {
        let src_p: &String = sources.borrow(i);
        i = i + 1 as i64;
        let src_view2: str = src_p.as_str();

        let prefix: String = per_file_prefix(&pf_dir, src_p);
        let mut obj_path: String = String::new();
        obj_path.push_str(prefix.as_str());
        obj_path.push_str(".o");

        let src_mt: i64 = match mtime_ns(src_view2) {
            Result::Ok(v)  => { v }
            Result::Err(_) => { 0 as i64 }
        };
        if !force && output_is_fresh(obj_path.as_str(), src_mt) { continue; }

        let mut argv: Vec<String> = vec_new::<String>();
        push_string_arg(&mut argv, logosc);
        push_arg(&mut argv, "--emit-module");
        push_string_arg(&mut argv, &man_path);
        push_arg(&mut argv, "--only-file");
        push_string_arg(&mut argv, src_p);
        push_arg(&mut argv, "-o");
        push_string_arg(&mut argv, &prefix);
        profile_compile_flags(profile, &mut argv);
        // Generated sources: readable dumps + debugger-visible line info
        // (the dump path IS the DWARF file for quote-emitted code).
        {
            let gd: String = gensrc_dir_for(profile);
            push_arg(&mut argv, "--gen-dir");
            largv_push_abs(&mut argv, &gd);
        }
        if dump_dir.len() > 0 as i64 {
            push_arg(&mut argv, "--dump-metaprog");
            push_string_arg(&mut argv, dump_dir);
            if dump_filter.len() > 0 as i64 {
                push_arg(&mut argv, "--dump-metaprog-filter");
                push_string_arg(&mut argv, dump_filter);
            }
        }
        // Sibling dep archives resolve through the project out dir: the
        // generated manifest's `depends` lines + this -L let the module
        // loader link lib<dep>.a (topo order guarantees they exist).
        if t.deps.length() > 0 as i64 {
            push_arg(&mut argv, "-L");
            let odl: String = out_dir_for(profile);
            largv_push_abs(&mut argv, &odl);
        }
        // External archives so logosc can load their .writ0 modules and
        // resolve `use <pkg>` statements that reference symbols outside
        // this project.
        let en_lib: i64 = externals.length();
        let mut ei_lib: i64 = 0 as i64;
        while ei_lib < en_lib {
            let lb: &ExternalLib = externals.borrow(ei_lib);
            push_arg(&mut argv, "-l");
            push_string_arg(&mut argv, &lb.archive_path);
            ei_lib = ei_lib + 1 as i64;
        }
        // The three stdlib layers as explicit `-l` archives so emit_module
        // nm-scans them into the skeleton-skip gate. Without this, a source
        // that pulls a stdlib METAPROG cone (a `container`/`deem` item drags
        // in wql_surface_parser) RE-LOWERS those bodies from the archived AST
        // instead of skipping them — and the comptime `parse_expr` intercept
        // does not survive re-lowering ("initializer produced no value").
        // The baked -L already RESOLVES stdlib for plain `use`; this makes it
        // SKELETON-SKIPPED, which the metaprog cone needs.
        if lib_dir.len() > 0 as i64 {
            let mut sp: String = String::new();
            sp.push_str(lib_dir.as_str()); append_path(&mut sp, "liblogos-std.a");
            push_arg(&mut argv, "-l"); push_string_arg(&mut argv, &sp);
            let mut mp: String = String::new();
            mp.push_str(lib_dir.as_str()); append_path(&mut mp, "liblogos-mem.a");
            push_arg(&mut argv, "-l"); push_string_arg(&mut argv, &mp);
            let mut lp: String = String::new();
            lp.push_str(lib_dir.as_str()); append_path(&mut lp, "liblogos-lang.a");
            push_arg(&mut argv, "-l"); push_string_arg(&mut argv, &lp);
        }

        let child: Child = spawn_inherit(&argv);
        if child.pid() < 0 {
            println_str(2, "lforge: spawn failed");
            return 1;
        }
        children.push(child);
        rebuilt_count = rebuilt_count + 1;
    }

    // C and asm files via cc -c
    let native_lists: [&Vec<String>; 2] = [&t.c_sources, &t.asm_sources];
    let mut native_counts: [i64; 2] = [n_c, n_asm];
    let mut nl: i64 = 0 as i64;
    while nl < 2 as i64 {
        let lst: &Vec<String> = native_lists[nl];
        let cnt: i64 = native_counts[nl];
        nl = nl + 1 as i64;
        let mut k: i64 = 0 as i64;
        while k < cnt {
            let src_p: &String = lst.borrow(k);
            k = k + 1 as i64;
            let src_view2: str = src_p.as_str();

            let obj_path: String = native_obj_path(&pf_dir, src_p);
            let src_mt: i64 = match mtime_ns(src_view2) {
                Result::Ok(v)  => { v }
                Result::Err(_) => { 0 as i64 }
            };
            if !force && output_is_fresh(obj_path.as_str(), src_mt) { continue; }

            let child: Child = spawn_native_compile(src_p, &obj_path, profile);
            if child.pid() < 0 {
                println_str(2, "lforge: cc spawn failed");
                return 1;
            }
            children.push(child);
            rebuilt_count = rebuilt_count + 1;
        }
    }

    // Announce.
    if rebuilt_count > 0 {
        let mut msg: String = String::new();
        msg.push_str("lforge: build lib ");
        msg.push_str(t.name.as_str());
        msg.push_str(" — compiling ");
        msg.push_i64(rebuilt_count as i64);
        msg.push_str(" file(s) in parallel");
        println_string(1, &msg);
    }

    // ── Wait for all spawned children ────────────────────────────────────
    let mut all_ok: bool = true;
    let mut waited: i64 = 0 as i64;
    let nch: i64 = children.length();
    while waited < nch {
        // Pop yields children in reverse spawn order; we just need every
        // one to be reaped.
        match children.pop() {
            Option::None       => { waited = nch; }
            Option::Some(c)    => {
                let mut child_local: Child = c;
                let st: ExitStatus = child_local.wait();
                if !st.success() { all_ok = false; }
                waited = waited + 1 as i64;
            }
        }
    }
    if !all_ok {
        println_str(2, "lforge: one or more per-file compilations failed");
        return 1;
    }

    // ── Re-archive if anything was rebuilt or the .a is missing/stale ───
    let arch_view: str = arch.as_str();
    let mut need_ar: bool = rebuilt_count > 0;
    if !need_ar {
        // Check archive freshness against every per-file artifact —
        // Logos .o, plus C/asm .o files.
        let mut max_pf: i64 = 0 as i64;
        let mut k: i64 = 0 as i64;
        while k < n_src {
            let src_p: &String = sources.borrow(k);
            k = k + 1 as i64;
            let prefix: String = per_file_prefix(&pf_dir, src_p);
            let mut obj_p: String = String::new();
            obj_p.push_str(prefix.as_str());
            obj_p.push_str(".o");
            match mtime_ns(obj_p.as_str()) {
                Result::Ok(v)  => { if v > max_pf { max_pf = v; } }
                Result::Err(_) => { }
            }
        }
        let mut nl2: i64 = 0 as i64;
        while nl2 < 2 as i64 {
            let lst: &Vec<String> = native_lists[nl2];
            let cnt: i64 = native_counts[nl2];
            nl2 = nl2 + 1 as i64;
            let mut k2: i64 = 0 as i64;
            while k2 < cnt {
                let src_p: &String = lst.borrow(k2);
                k2 = k2 + 1 as i64;
                let obj_p: String = native_obj_path(&pf_dir, src_p);
                match mtime_ns(obj_p.as_str()) {
                    Result::Ok(v)  => { if v > max_pf { max_pf = v; } }
                    Result::Err(_) => { }
                }
            }
        }
        if force || !output_is_fresh(arch_view, max_pf) { need_ar = true; }
    }

    if !need_ar {
        let mut msg: String = String::new();
        msg.push_str("lforge: lib ");
        msg.push_str(t.name.as_str());
        msg.push_str(" up-to-date");
        println_string(1, &msg);
        return 0;
    }

    // Build `ar rcs <arch> <logos_obj> <logos_writ0> ... <native_obj> ...`
    let mut ar_argv: Vec<String> = vec_new::<String>();
    push_arg(&mut ar_argv, "ar");
    push_arg(&mut ar_argv, "rcs");
    push_string_arg(&mut ar_argv, &arch);
    let mut j: i64 = 0 as i64;
    while j < n_src {
        let src_p: &String = sources.borrow(j);
        j = j + 1 as i64;
        let prefix: String = per_file_prefix(&pf_dir, src_p);
        let mut o: String = String::new();
        o.push_str(prefix.as_str());
        o.push_str(".o");
        let mut h: String = String::new();
        h.push_str(prefix.as_str());
        h.push_str(".wr0");
        ar_argv.push(o);
        ar_argv.push(h);
    }
    // Native (C/asm) .o files.
    let mut nl3: i64 = 0 as i64;
    while nl3 < 2 as i64 {
        let lst: &Vec<String> = native_lists[nl3];
        let cnt: i64 = native_counts[nl3];
        nl3 = nl3 + 1 as i64;
        let mut k3: i64 = 0 as i64;
        while k3 < cnt {
            let src_p: &String = lst.borrow(k3);
            k3 = k3 + 1 as i64;
            let o: String = native_obj_path(&pf_dir, src_p);
            ar_argv.push(o);
        }
    }

    // Remove a stale archive first; ar would otherwise append rather than
    // replace and dead members would linger.
    match unlink(arch_view) {
        Result::Ok(_)  => { }
        Result::Err(_) => { }
    }

    let ar_child: Child = spawn_inherit(&ar_argv);
    if ar_child.pid() < 0 {
        println_str(2, "lforge: ar spawn failed");
        return 1;
    }
    let mut ar_local: Child = ar_child;
    let ar_st: ExitStatus = ar_local.wait();
    if !ar_st.success() {
        println_str(2, "lforge: ar failed");
        return 1;
    }
    return 0;
}

pub fn build_bin(t: &Target, 
                        targets: &Vec<Target>,
                        profile: str,
                        logosc: &String,
                        lib_dir: &String,
                        externals: &Vec<ExternalLib>,
                        dump_dir: &String,
                        dump_filter: &String,
                        force: bool) -> i32 {
    if t.entry.len() == 0 as i64 {
        println_str(2, "lforge: bin target missing 'entry'");
        return 1;
    }
    
    let od: String = out_dir_for(profile);
    let od_view: str = od.as_str();
    match mkdir_p(od_view) {
        Result::Err(_) => { println_str(2, "lforge: cannot create out dir"); return 1; }
        Result::Ok(_)  => { }
    }

    // Incremental skip: if the linked binary is newer than every input
    // (the bin's own .logos files + every dep .a archive), skip the action.
    let src_view: str = t.src.as_str();
    let mut all_inputs: Vec<String> = collect_logos_files(src_view);
    let dep_archs_for_check: Vec<String> = dep_archive_paths(targets, &t.deps, profile, externals);
    let dnc: i64 = dep_archs_for_check.length();
    let mut di: i64 = 0 as i64;
    while di < dnc {
        let s: &String = dep_archs_for_check.borrow(di);
        let mut copy: String = String::new();
        copy.push_str(s.as_str());
        all_inputs.push(copy);
        di = di + 1 as i64;
    }
    let max_mt: i64 = newest_mtime(&all_inputs);
    let bp_check: String = bin_path(profile, t.name.as_str());
    let bp_check_view: str = bp_check.as_str();
    if !force && output_is_fresh(bp_check_view, max_mt) {
        let mut msg: String = String::new();
        msg.push_str("lforge: bin ");
        msg.push_str(t.name.as_str());
        msg.push_str(" up-to-date");
        println_string(1, &msg);
        return 0;
    }

    // Compose entry path: <src>/<entry>.logos
    let mut entry_path: String = String::new();
    entry_path.push_str(t.src.as_str());
    append_path(&mut entry_path, t.entry.as_str());
    entry_path.push_str(".logos");

    let mut obj_path: String = String::new();
    obj_path.push_str(od.as_str());
    obj_path.push_u8(47 as u8);
    obj_path.push_str(t.name.as_str());
    obj_path.push_str(".o");

    let bp: String = bin_path(profile, t.name.as_str());

    // Resolve dep archives.
    let dep_archs: Vec<String> = dep_archive_paths(targets, &t.deps, profile, externals);

    // Transitive closure: every external archive (direct + indirect) must
    // be visible to logosc and cc, so the consumer's source can resolve
    // symbols across the whole closure. Dedupe against dep_archs.
    let mut all_archs: Vec<String> = vec_new::<String>();
    let mut di: i64 = 0 as i64;
    while di < dep_archs.length() {
        let s: &String = dep_archs.borrow(di);
        let mut c: String = String::new();
        c.push_str(s.as_str());
        all_archs.push(c);
        di = di + 1 as i64;
    }
    let en: i64 = externals.length();
    let mut ei: i64 = 0 as i64;
    while ei < en {
        let lb: &ExternalLib = externals.borrow(ei);
        let lbv: str = lb.archive_path.as_str();
        let mut already: bool = false;
        let mut ai: i64 = 0 as i64;
        while ai < all_archs.length() {
            let s: &String = all_archs.borrow(ai);
            let sv: str = s.as_str();
            if str_eq_local(sv, lbv) { already = true; ai = all_archs.length(); }
            else                     { ai = ai + 1 as i64; }
        }
        if already == false {
            let mut c: String = String::new();
            c.push_str(lbv);
            all_archs.push(c);
        }
        ei = ei + 1 as i64;
    }

    // logosc <entry> -o <obj> [-l <dep_arch>]...
    let mut argv: Vec<String> = vec_new::<String>();
    push_string_arg(&mut argv, logosc);
    push_string_arg(&mut argv, &entry_path);
    push_arg(&mut argv, "-o");
    push_string_arg(&mut argv, &obj_path);
    profile_compile_flags(profile, &mut argv);
    {
        let gd: String = gensrc_dir_for(profile);
        push_arg(&mut argv, "--gen-dir");
        largv_push_abs(&mut argv, &gd);
    }
    if dump_dir.len() > 0 as i64 {
        push_arg(&mut argv, "--dump-metaprog");
        push_string_arg(&mut argv, dump_dir);
        if dump_filter.len() > 0 as i64 {
            push_arg(&mut argv, "--dump-metaprog-filter");
            push_string_arg(&mut argv, dump_filter);
        }
    }
    let dn: i64 = all_archs.length();
    let mut i: i64 = 0 as i64;
    while i < dn {
        let s: &String = all_archs.borrow(i);
        push_arg(&mut argv, "-l");
        push_string_arg(&mut argv, s);
        i = i + 1 as i64;
    }

    let mut prefix: String = String::new();
    prefix.push_str("lforge: build bin ");
    prefix.push_str(t.name.as_str());
    println_string(1, &prefix);
    let rc: i32 = run_child(&argv);
    if rc != 0 {
        println_str(2, "lforge: logosc failed");
        return rc;
    }

    if lib_dir.len() == 0 as i64 {
        println_str(2, "lforge: cannot locate Logos lib dir (set LOGOS_LIB_DIR)");
        return 1;
    }

    // cc <obj> [<dep_arch>...] <stdlib_archives> -lpthread -lm -o <bin>
    let mut largv: Vec<String> = vec_new::<String>();
    push_arg(&mut largv, "cc");
    push_arg(&mut largv, "-Wl,--gc-sections");
    push_string_arg(&mut largv, &obj_path);
    let mut k: i64 = 0 as i64;
    while k < dn {
        let s: &String = all_archs.borrow(k);
        push_string_arg(&mut largv, s);
        k = k + 1 as i64;
    }
    let lib_view: str = lib_dir.as_str();
    // Three modular stdlib layers, each carrying only its own codegen
    // (emit_module's layer dedup forward-declares whatever a lower layer
    // already defines). They cross-reference (std→mem→lang + mono
    // instantiations either way), so wrap them in --start-group/--end-group
    // to let ld resolve in any order.
    push_arg(&mut largv, "-Wl,--start-group");
    let mut p1: String = String::new();
    p1.push_str(lib_view); append_path(&mut p1, "liblogos-std.a"); largv.push(p1);
    let mut p1b: String = String::new();
    p1b.push_str(lib_view); append_path(&mut p1b, "liblogos-mem.a"); largv.push(p1b);
    let mut p1c: String = String::new();
    p1c.push_str(lib_view); append_path(&mut p1c, "liblogos-lang.a"); largv.push(p1c);
    push_arg(&mut largv, "-Wl,--end-group");
    let mut p2: String = String::new();
    p2.push_str(lib_view); append_path(&mut p2, "liblstdlib_fibers.a"); largv.push(p2);
    let mut p3: String = String::new();
    p3.push_str(lib_view); append_path(&mut p3, "liblstdlib_rt.a"); largv.push(p3);
    let mut p4: String = String::new();
    p4.push_str(lib_view); append_path(&mut p4, "liblstdlib_uring.a"); largv.push(p4);
    push_arg(&mut largv, "-lpthread");
    push_arg(&mut largv, "-lm");
    push_arg(&mut largv, "-lstdc++");
    push_arg(&mut largv, "-o");
    push_string_arg(&mut largv, &bp);

    let mut prefix2: String = String::new();
    prefix2.push_str("lforge: link bin ");
    prefix2.push_str(t.name.as_str());
    println_string(1, &prefix2);
    return run_child(&largv);
}
