// lforge — tool resolution + build-output path helpers + mtime-based
// freshness check used to skip up-to-date actions.

package lforge.build_paths;

use logos.mem.string;
use logos.lang.str;
use logos.lang.result;
use logos.mem.collections.vec;
use logos.std.io.fs;

use lforge.schema;
use lforge.util;
use lforge.topo;
use lforge.proc;
use lforge.hermes_io;
use logos.lang.hermes.anyval;
use logos.lang.hermes.container;
use logos.lang.hermes.hmap;
use logos.lang.hermes.hstring;
use logos.mem.hermes.parser;
use logos.lang.rc;

extern fn getenv(name: *const u8) -> *const u8;
extern fn readlink(path: *const u8, buf: *mut u8, bufsiz: u64) -> i64;

// The sibling tool `<name>` next to THIS lforge binary, found via /proc/self/exe
// (which resolves the alternatives/versioned symlink chain to the real file in
// the slot tree). Empty if it doesn't exist. So lforge-<slot> binds to its OWN
// slot's logosc, not whatever `logosc` happens to be the PATH default.
fn sibling_tool(name: str) -> String {
    unsafe {
    let buf: *mut u8 = alloc(4096 as i64);
    let selfp: *mut u8 = cstr("/proc/self/exe");
    let n: i64 = readlink(selfp as *const u8, buf, 4095 as u64);
    dealloc(selfp);
    if n <= 0 as i64 { dealloc(buf); return String::new(); }
    let mut slash: i64 = 0 as i64 - 1 as i64;
    let mut i: i64 = 0 as i64;
    while i < n {
        if buf[i] == 47 as u8 { slash = i; }   // '/'
        i = i + 1 as i64;
    }
    if slash < 0 as i64 { dealloc(buf); return String::new(); }
    let mut out: String = String::new();
    out.push_bytes(buf as *const u8, slash + 1 as i64);   // "<dir>/"
    dealloc(buf);
    out.push_str(name);                                    // "<dir>/<name>"
    let view: str = str_from_raw(out.as_ptr(), out.len());
    let cs: *mut u8 = cstr(view);
    let ok: bool = is_file(cs as *const u8);
    dealloc(cs);
    if ok { return out; }
    return String::new();
    }
}

// ── Tool resolution ───────────────────────────────────────────────────────

pub fn resolve_logos_lib_dir() -> String {
    unsafe {
        let env_key: *mut u8 = cstr("LOGOS_LIB_DIR");
    let env_val: *const u8 = getenv(env_key as *const u8);
    dealloc(env_key);
    if env_val != 0 as *const u8 {
        let s: str = str_from_cstr(env_val);
        let mut out: String = String::new();
        out.push_str(s);
        return out;
    }
    let candidates: [str; 2] = ["./build/lib/logos", "/usr/local/lib/logos"];
    let mut i: i64 = 0 as i64;
    while i < 2 as i64 {
        let c: str = candidates[i];
        let cs: *mut u8 = cstr(c);
        let ok: bool = is_dir(cs as *const u8);
        dealloc(cs);
        if ok {
            let mut out: String = String::new();
            out.push_str(c);
            return out;
        }
        i = i + 1 as i64;
    }
    // Installed slot tree (lib/logos/<slot>/lib/): query the resolved logosc for
    // ALL its metadata as a Hermes doc (--print-metadata) and read lib_dir. The
    // dir always matches the exact compiler lforge uses — no path guessing — and
    // works even when driving a different-version logosc (no layout assumption).
    let logosc: String = resolve_logosc_path();
    let mut argv: Vec<String> = vec_new::<String>();
    let argv_p: *mut Vec<String> = (&mut argv) as *mut Vec<String>;
    push_string_arg(argv_p, &logosc);
    push_arg(argv_p, "--print-metadata");
    let res: (i32, String) = run_child_capture_stdout(&argv);
    if res.0 == 0 as i32 {
        let raw: String = res.1;
        let view: str = str_from_raw(raw.as_ptr(), raw.len());
        let ctr: Rc<Hermes> = hermes_rc(8192 as i64);
        let h: &Hermes = ctr.deref();
        let root: HAny = parse(h, view);
        if root.is_map() {
            let lib: String = read_str_opt(root, "lib_dir");
            if lib.len() > 0 as i64 { return lib; }
        }
    }
    return String::new();
    }
}

pub fn resolve_logosc_path() -> String {
    unsafe {
        let env_key: *mut u8 = cstr("LOGOSC");
    let env_val: *const u8 = getenv(env_key as *const u8);
    dealloc(env_key);
    if env_val != 0 as *const u8 {
        let s: str = str_from_cstr(env_val);
        let mut out: String = String::new();
        out.push_str(s);
        return out;
    }
    // DEFAULT: the logosc sibling in THIS lforge's slot tree (predictable —
    // lforge-<slot> uses logosc-<slot>, not the PATH-default alternative).
    let sib: String = sibling_tool("logosc");
    if sib.len() > 0 as i64 { return sib; }
    let cs: *mut u8 = cstr("./build/bin/logosc");
    let ok: bool = is_file(cs as *const u8);
    dealloc(cs);
    let mut out: String = String::new();
    if ok { out.push_str("./build/bin/logosc"); }
    else  { out.push_str("logosc"); }
    return out;
    }
}

// ── Build output paths ────────────────────────────────────────────────────

pub fn out_dir_for(profile: str) -> String {
    let mut d: String = String::new();
    d.push_str(".lforge/");
    d.push_str(profile);
    d.push_str("/out");
    return d;
}

pub fn gen_dir_for(profile: str) -> String {
    let mut d: String = String::new();
    d.push_str(".lforge/");
    d.push_str(profile);
    d.push_str("/_gen");
    return d;
}

// Path of the .a archive a lib target produces.
pub fn lib_archive_path(profile: str, lib_name: str) -> String {
    let mut p: String = out_dir_for(profile);
    p.push_str("/lib");
    p.push_str(lib_name);
    p.push_str(".a");
    return p;
}

// Path of the bin executable a bin target produces.
pub fn bin_path(profile: str, bin_name: str) -> String {
    let mut p: String = out_dir_for(profile);
    p.push_u8(47 as u8);
    p.push_str(bin_name);
    return p;
}

// Resolve dep names → archive paths. Externals shadow local libs of the
// same name (consumer's t.deps already declared the name; the project that
// defines a lib with that name wins). Order preserved from the bin target's
// manifest.
pub fn dep_archive_paths(targets: &Vec<Target>, deps: &Vec<String>, profile: str,
                                externals: &Vec<ExternalLib>) -> Vec<String> { unsafe {    let mut out: Vec<String> = vec_new::<String>();
    let outp: *mut Vec<String> = (&mut out) as *mut Vec<String>;
    let dn: i64 = deps.length();
    let dp: *const Vec<String> = deps as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < dn {
        let nm: *const String = dp.at_const(i);
        let nm_view: str = str_from_raw((*nm).as_ptr(), (*nm).len());
        let ei: i64 = external_lookup(externals, nm_view);
        if ei >= 0 as i64 {
            let lp: *const Vec<ExternalLib> = externals as *const Vec<ExternalLib>;
            let lb: *const ExternalLib = lp.at_const(ei);
            let mut p: String = String::new();
            p.push_bytes((*lb).archive_path.as_ptr(), (*lb).archive_path.len());
            outp.push(p);
        } else {
            let p: String = lib_archive_path(profile, nm_view);
            outp.push(p);
        }
        i = i + 1 as i64;
    }
    return out;
    }
}

// ── Incremental rebuild (mtime-based) ─────────────────────────────────────
//
// Action skip rule: if the output file exists and its mtime is >= the max
// mtime of every input file, the action is fresh and we skip the spawn.
// Matches the cmake/ninja default behavior (which is what users expect).

pub fn collect_logos_files(dir: str) -> Vec<String> {
    unsafe {
        let mut out: Vec<String> = vec_new::<String>();
    let outp: *mut Vec<String> = (&mut out) as *mut Vec<String>;
    let cs: *mut u8 = cstr(dir);
    let exists_dir: bool = is_dir(cs as *const u8);
    dealloc(cs);
    if exists_dir {
        let entries: Vec<DirEntry> = walk_dir(dir);
        let ep: *const Vec<DirEntry> = (&entries) as *const Vec<DirEntry>;
        let n: i64 = entries.length();
        let mut i: i64 = 0 as i64;
        while i < n {
            let de: *const DirEntry = ep.at_const(i);
            i = i + 1 as i64;
            if (*de).is_dir { continue; }
            let pview: str = str_from_raw((*de).name.as_ptr(), (*de).name.len());
            let pn: i64 = pview.len();
            if pn < 6 as i64 { continue; }
            let suffix: str = ".logos";
            let off: i64 = pn - 6 as i64;
            let mut ok: bool = true;
            let mut sk: i64 = 0 as i64;
            while sk < 6 as i64 && ok {
                if pview[off + sk] != suffix[sk] { ok = false; }
                sk = sk + 1 as i64;
            }
            if !ok { continue; }
            let mut p: String = String::new();
            p.push_str(pview);
            outp.push(p);
        }
    }
    return out;
    }
}

// Latest mtime in a list of file paths; returns 0 if list is empty or every
// stat fails.
pub fn newest_mtime(paths: &Vec<String>) -> i64 {
    unsafe {
        let mut max_mt: i64 = 0 as i64;
    let n: i64 = paths.length();
    let pp: *const Vec<String> = paths as *const Vec<String>;
    let mut i: i64 = 0 as i64;
    while i < n {
        let s: *const String = pp.at_const(i);
        let cs: *mut u8 = cstr(str_from_raw((*s).as_ptr(), (*s).len()));
        let mt: Result<i64, i32> = mtime_ns(cs as *const u8);
        dealloc(cs);
        match mt {
            Result::Ok(t)  => { if t > max_mt { max_mt = t; } }
            Result::Err(_) => { }
        }
        i = i + 1 as i64;
    }
    return max_mt;
    }
}

// True if `out_path` exists and its mtime is >= every input mtime.
pub fn output_is_fresh(out_path: str, max_input_mt: i64) -> bool {
    unsafe {
        let cs: *mut u8 = cstr(out_path);
    let ok: bool = exists(cs as *const u8);
    if !ok { dealloc(cs); return false; }
    let mt: Result<i64, i32> = mtime_ns(cs as *const u8);
    dealloc(cs);
    match mt {
        Result::Ok(t)  => { return t >= max_input_mt; }
        Result::Err(_) => { return false; }
    }
    }
}
