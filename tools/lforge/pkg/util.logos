// lforge — small string / I/O / error-construction helpers shared by all
// sub-packages and the entry-point.

package lforge.util;

use logos.mem.string;
use logos.lang.str;
use logos.std.io;
use lforge.schema;

// Heap-allocate a NUL-terminated copy of `s`. Caller frees with `dealloc`.
// Safe to call (allocates valid memory + copies); unsafe by ownership
// contract — caller must dealloc.
pub fn cstr(s: str) -> *mut u8 {
    unsafe {
        let n: i64 = s.len();
        let h: *mut u8 = alloc(n + 1 as i64);
        let mut i: i64 = 0 as i64;
        while i < n { h[i] = s.as_ptr()[i]; i = i + 1 as i64; }
        h[n] = 0 as u8;
        return h;
    }
}

pub fn str_eq_local(a: str, b: str) -> bool {
    if a.len() != b.len() { return false; }
    return str_starts_with(a, b);
}

pub fn err_msg(msg: str) -> ManifestError {
    let mut s: String = String::new();
    s.push_str(msg);
    return ManifestError { message: s };
}

pub fn err_msg2(a: str, b: str) -> ManifestError {
    let mut s: String = String::new();
    s.push_str(a);
    s.push_str(b);
    return ManifestError { message: s };
}

// fd 2 → stderr, anything else → stdout. Delegates to the stdlib io primitives
// (which encapsulate the raw write); lforge only ever uses fd 1/2.
pub fn print_str(fd: i32, s: str) {
    if fd == 2 { eprint(s); } else { print(s); }
}

pub fn println_str(fd: i32, s: str) {
    if fd == 2 { eprintln(s); } else { println(s); }
}

pub fn println_string(fd: i32, s: &String) {
    if fd == 2 { eprintln_string(s); } else { println_string(s); }
}

// Append `<base>/<rest>` semantics into an existing String.
pub fn append_path(base: &mut String, rest: str) {
    if base.len() > 0 as i64 && !str_ends_with(base.as_str(), "/") {
        base.push_u8(47 as u8);
    }
    base.push_str(rest);
}
