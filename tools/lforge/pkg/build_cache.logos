// lforge — content-addressed build cache for external git deps (B4).
//
// Layout:
//   ~/.cache/lforge/build/<sha256-hex>/
//       lib<module>.a    — cached archive
//       meta.hermes      — { project, sha, module, profile, logosc_mtime }
//
// Key inputs: project_id (display) || git sha || module name || profile ||
//             logosc binary mtime || dep cache_keys (sorted).
//
// Consumer never invalidates cache; entries accumulate. `lforge cache prune`
// is a future addition.

package lforge.build_cache;

use std.lang.text;
use std.lang.option;
use std.lang.result;
use std.collections.vec;
use std.io.fs;
use std.crypto;

use lforge.util;
use lforge.proc;

extern fn getenv(name: *const u8) -> *const u8;

pub fn cache_root() -> String {
    let key: *mut u8 = cstr("HOME");
    let home_view: str = unsafe {
        let val: *const u8 = getenv(key as *const u8);
        if val == 0 as *const u8 { str_from_raw(0 as *const u8, 0 as i64) }
        else                     { str_from_cstr(val) }
    };
    dealloc(key);
    if home_view.len() == 0 as i64 { return String::new(); }
    let mut out: String = String::new();
    out.push_str(home_view);
    append_path(&mut out, ".cache");
    append_path(&mut out, "lforge");
    append_path(&mut out, "build");
    return out;
}

pub fn logosc_mtime(logosc: &String) -> i64 {
    let cs: *mut u8 = cstr(logosc.as_str());
    let mt: Result<i64, i32> = mtime_ns(cs as *const u8);
    dealloc(cs);
    match mt {
        Result::Ok(v)  => { return v; }
        Result::Err(_) => { return 0 as i64; }
    }
}

// sha256 of NUL-separated record over (project, sha, module, profile,
// logosc_mtime decimal, then \1-separated dep_keys). Returns hex.
pub fn compute_key(project: str, sha: str, module: str, profile: str,
                          mtime_ns_val: i64, dep_keys: &Vec<String>) -> String {
    let mut buf: String = String::new();
    buf.push_str(project); buf.push_u8(0 as u8);
    buf.push_str(sha);     buf.push_u8(0 as u8);
    buf.push_str(module);  buf.push_u8(0 as u8);
    buf.push_str(profile); buf.push_u8(0 as u8);
    buf.push_i64(mtime_ns_val); buf.push_u8(0 as u8);
    let n: i64 = dep_keys.length();
    let mut i: i64 = 0 as i64;
    while i < n {
        let s: &String = dep_keys.borrow(i);
        buf.push_bytes(s.as_ptr(), s.len());
        buf.push_u8(1 as u8);
        i = i + 1 as i64;
    }
    let mut out: String = String::new();
    sha256_hex(buf.as_ptr(), buf.len(), &mut out);
    return out;
}

pub fn cache_dir_for(key: str) -> String {
    let root: String = cache_root();
    if root.len() == 0 as i64 { return String::new(); }
    let mut out: String = String::new();
    out.push_bytes(root.as_ptr(), root.len());
    append_path(&mut out, key);
    return out;
}

// Returns absolute path of the cached archive on hit, or empty string on miss.
pub fn cache_lookup(key: str, archive_basename: str) -> String {
    let dir: String = cache_dir_for(key);
    if dir.len() == 0 as i64 { return String::new(); }
    let mut p: String = String::new();
    p.push_bytes(dir.as_ptr(), dir.len());
    append_path(&mut p, archive_basename);
    let cs: *mut u8 = cstr(p.as_str());
    let exists: bool = is_file(cs as *const u8);
    dealloc(cs);
    if exists { return p; }
    return String::new();
}

// Copy <src_archive> into <cache>/<archive_basename>; write meta.hermes.
// Returns 0 on success, non-zero on failure (caller should treat the dep
// as "built but uncached" rather than fail the whole build).
pub fn cache_populate(key: str, src_archive: &String, archive_basename: str,
                             project: str, sha: str, module: str, profile: str,
                             mtime_ns_val: i64) -> i32 {
    let dir: String = cache_dir_for(key);
    if dir.len() == 0 as i64 { return 0 - 1; }
    match mkdir_p(dir.as_str()) {
        Result::Err(_) => { return 0 - 1; }
        Result::Ok(_)  => { }
    }
    // Copy via /bin/cp -f for predictable semantics (overwrite existing,
    // preserve mode). Avoids pulling in a Logos-side splice loop.
    let mut dst: String = String::new();
    dst.push_bytes(dir.as_ptr(), dir.len());
    append_path(&mut dst, archive_basename);
    let mut argv: Vec<String> = vec_new::<String>();
    push_arg(&mut argv, "cp");
    push_arg(&mut argv, "-f");
    push_string_arg(&mut argv, src_archive);
    push_string_arg(&mut argv, &dst);
    let rc: i32 = run_child(&argv);
    if rc != 0 { return rc; }

    // Write meta.hermes for debugging — not load-bearing.
    let mut meta_buf: String = String::new();
    meta_buf.push_str("// Auto-generated by lforge build cache.\n");
    meta_buf.push_str("{\n    project: \"");
    meta_buf.push_str(project);
    meta_buf.push_str("\", sha: \"");
    meta_buf.push_str(sha);
    meta_buf.push_str("\", module: \"");
    meta_buf.push_str(module);
    meta_buf.push_str("\", profile: \"");
    meta_buf.push_str(profile);
    meta_buf.push_str("\", logosc_mtime: ");
    meta_buf.push_i64(mtime_ns_val);
    meta_buf.push_str("\n}\n");
    let mut meta_path: String = String::new();
    meta_path.push_bytes(dir.as_ptr(), dir.len());
    append_path(&mut meta_path, "meta.hermes");
    let cs: *mut u8 = cstr(meta_path.as_str());
    let wr: Result<i32, i32> = write_string(cs as *const u8, &meta_buf);
    dealloc(cs);
    match wr {
        Result::Err(_) => { return 0 - 1; }
        Result::Ok(_)  => { return 0; }
    }
}
