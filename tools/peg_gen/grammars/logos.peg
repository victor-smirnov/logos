// SPDX-License-Identifier: Apache-2.0
// Copyright 2026 Victor Smirnov
// Logos project — https://github.com/victor-smirnov/logos
//
// Logos language grammar — Iteration 3.
//
// Rust-like syntax. Packages, use declarations, extern fn, pub visibility,
// string literals, pointer types, free functions, let, if/else, return,
// while loops, assignment, structs with fields and methods, field access,
// method calls, struct literals, parenthesised expressions.

%meta {
    name:      "logos"
    version:   "0.3"
    namespace: "logos::compiler"
    output:    "logos_parser"
}

%export { module }

// ── AST field keys ────────────────────────────────────────────────────────
%fields {
    CODE        = 0
    NAME        = 1
    ITEMS       = 2
    TYPE        = 3
    PARAMS      = 4
    BODY        = 5
    RET_TYPE    = 6
    VALUE       = 7
    COND        = 8
    THEN        = 9
    ELSE        = 10
    OP          = 11
    LHS         = 12
    RHS         = 13
    CALLEE      = 14
    ARGS        = 15
    PATH        = 16
    USES        = 17
    POINTEE     = 18
    MUTPTR      = 19
    RECEIVER    = 20
    FIELD       = 21
    FIELDS      = 22
    SIZE        = 23
    SRC_LINE    = 24
    IS_MUT      = 25
    INCLUSIVE   = 26
    TYPE_PARAMS = 27
    PARENT      = 28
    IS_ABSTRACT = 29
    IS_VARARG   = 30
    ITER        = 31
    IS_VARIADIC = 32
    IS_PUB      = 33
    PAT         = 34
    GUARD       = 35
    EXPR        = 36
    NAMES       = 37
    WHERE          = 38
    IS_CONST       = 39
    LIFETIME       = 40
    IMPL_TYPE_PARAMS = 41
    IS_UNSAFE      = 42
}

// ── AST node codes ────────────────────────────────────────────────────────
%nodes {
    MODULE      = 1
    PACKAGE     = 2
    USE         = 3
    FN          = 10
    EXTERN_FN   = 11
    PARAM       = 12
    BLOCK       = 20
    LET         = 21
    RETURN      = 22
    IF          = 23
    EXPR_STMT   = 24
    CALL        = 30
    BINOP       = 31
    VAR_REF     = 32
    LIT_INT     = 33
    LIT_BOOL    = 34
    LIT_STR     = 35
    TYPE_REF    = 40
    PTR_TYPE    = 41
    STRUCT      = 50
    FIELD_DEF   = 51
    FIELD_INIT  = 52
    STRUCT_LIT  = 53
    FIELD_READ  = 54
    FIELD_WRITE = 55
    METHOD_CALL = 56
    ASSIGN      = 57
    WHILE       = 58
    DEREF       = 59
    PAREN_EXPR  = 60
    UNARY       = 61
    INDEX_READ  = 62
    INDEX_WRITE = 63
    ARR_TYPE    = 64
    ARR_LIT     = 65
    BREAK       = 66
    CONTINUE    = 67
    LOOP        = 68
    CAST        = 69
    FOR         = 70
    CONST_DEF   = 71
    TYPE_ALIAS  = 72
    ENUM        = 80
    VARIANT_DEF = 81
    MATCH       = 82
    MATCH_ARM   = 83
    PAT_VARIANT = 84
    PAT_WILD    = 85
    ENUM_LIT    = 86
    PAT_INT     = 87
    PAT_BOOL    = 88
    TRAIT_BOUND = 89
    TYPE_PARAM  = 90
    GENERIC_CALL = 91
    GENERIC_INST = 92
    CLASS        = 93
    NEW_EXPR     = 94
    DELETE_STMT  = 95
    ABSTRACT_FN  = 96
    STATIC_FN    = 97
    STATIC_CALL  = 98
    FOR_EACH     = 99
    TUPLE_TYPE   = 100
    TUPLE_LIT    = 101
    TUPLE_INDEX  = 102
    ENUM_LIT_DATA    = 104
    PAT_VARIANT_DATA = 105
    TRAIT_DEF        = 106
    IMPL_BLOCK       = 107
    CLOSURE_EXPR     = 109
    SLICE_TYPE           = 111
    RANGE_EXPR           = 112
    FIELD_INDEX_WRITE    = 113
    ADDR_OF_MUT          = 114
    DEREF_WRITE          = 115
    IMPL_TYPE            = 116
    PACK_EXPAND          = 117
    DYN_TYPE             = 118
    ASSOC_TYPE_DEF       = 119
    ASSOC_TYPE_IMPL      = 120
    ASSOC_TYPE_REF       = 121
    TRY_EXPR             = 122
    LET_DESTRUCT         = 123
    WHERE_CLAUSE         = 124
    CLOSURE_TYPE         = 125
    COMPOUND_ASSIGN      = 126
    ARR_FILL_LIT         = 127
    DEREF_FIELD_WRITE    = 128
    REF_TYPE             = 129
    MUT_REF_TYPE         = 130
    LIFETIME_PARAM       = 131
    UNSAFE_BLOCK         = 132
}

// ── Tokens ────────────────────────────────────────────────────────────────
%tokens {
    // Keywords (longest-match first within same length)
    KW_CONTINUE = "continue"
    KW_ABSTRACT = "abstract"
    KW_PACKAGE  = "package"
    KW_EXTENDS  = "extends"
    KW_STATIC   = "static"
    KW_DELETE   = "delete"
    KW_RETURN   = "return"
    KW_EXTERN   = "extern"
    KW_STRUCT   = "struct"
    KW_MATCH    = "match"
    KW_WHILE    = "while"
    KW_BREAK    = "break"
    KW_FALSE    = "false"
    KW_TRAIT    = "trait"
    KW_CONST    = "const"
    KW_CLASS    = "class"
    KW_TYPE     = "type"
    KW_IMPL     = "impl"
    KW_ENUM     = "enum"
    KW_LOOP     = "loop"
    KW_ELSE     = "else"
    KW_TRUE     = "true"
    KW_FOR      = "for"
    KW_USE      = "use"
    KW_MUT      = "mut"
    KW_LET      = "let"
    KW_DYN      = "dyn"
    KW_PUB      = "pub"
    KW_NEW      = "new"
    KW_FN       = "fn"
    KW_IF       = "if"
    KW_IN       = "in"
    KW_AS       = "as"
    KW_WHERE    = "where"
    KW_UNSAFE   = "unsafe"

    // Punctuation
    LBRACE      = "{"
    RBRACE      = "}"
    LBRACKET    = "["
    RBRACKET    = "]"
    LPAREN      = "("
    RPAREN      = ")"
    COLON       = ":"
    COMMA       = ","
    SEMI        = ";"
    ARROW       = "->"
    DOT         = "."
    STAR        = "*"
    AMP         = "&"

    // Operators (multi-char first)
    AND         = "&&"
    OR          = "||"
    EQ          = "=="
    NE          = "!="
    LE          = "<="
    GE          = ">="
    SHL_EQ      = "<<="
    SHR_EQ      = ">>="
    SHL         = "<<"
    SHR         = ">>"
    PLUS_EQ     = "+="
    MINUS_EQ    = "-="
    STAR_EQ     = "*="
    SLASH_EQ    = "/="
    PERCENT_EQ  = "%="
    AMP_EQ      = "&="
    PIPE_EQ     = "|="
    CARET_EQ    = "^="
    PIPE        = "|"
    DOTDOTDOT   = "..."
    DOTDOTEQ    = "..="
    DOTDOT      = ".."
    LT          = "<"
    GT          = ">"
    PLUS        = "+"
    MINUS       = "-"
    SLASH       = "/"
    PERCENT     = "%"
    BANG        = "!"
    QUESTION    = "?"
    ASSIGN      = "="
    FATARROW    = "=>"
    COLONCOLON  = "::"
    CARET       = "^"

    // Literals & identifiers
    STRING      = /"([^"\\]|\\.)*"/
    INTEGER     = /[-]?[0-9]+/
    LIFETIME    = /'[a-z][a-z0-9_]*/
    IDENT       = /[a-zA-Z_][a-zA-Z0-9_]*/

    // Skip
    %skip       = /[ \t\n\r]+/
    %skip       = /\/\/[^\n]*/
    %skip       = /\/\*.*?\*\//
}

// ── Rules ─────────────────────────────────────────────────────────────────
%rules {

    // ── Top level ────────────────────────────────────────────────
    module <- KW_PACKAGE IDENT DOT IDENT SEMI use_decl* item*
           => { CODE: MODULE, NAME: $2, PATH: $4, USES: $6, ITEMS: $... }
            / KW_PACKAGE IDENT SEMI use_decl* item*
           => { CODE: MODULE, NAME: $2, USES: $4, ITEMS: $... }

    use_decl <- KW_USE IDENT DOT IDENT SEMI
             => { CODE: USE, NAME: $2, PATH: $4 }
              / KW_USE IDENT SEMI
             => { CODE: USE, NAME: $2 }

    item <- const_def / type_alias / pub_enum_def / enum_def / class_def / pub_struct_def / struct_def / pub_trait_def / trait_def / impl_block / extern_fn_def / pub_fn_def / fn_def

    // const NAME: type = expr;
    const_def <- KW_CONST IDENT COLON type_ref ASSIGN expr SEMI
              => { CODE: CONST_DEF, NAME: $2, TYPE: $4, VALUE: $6 }

    // static NAME: type = expr;  (module-level mutable static — same repr as const for now)
    // type NAME = type_ref;
    type_alias <- KW_TYPE IDENT ASSIGN type_ref SEMI
               => { CODE: TYPE_ALIAS, NAME: $2, TYPE: $4 }

    // ── Enum definition ──────────────────────────────────────────
    // enum Color { Red, Green = 5, Blue }
    // enum Option<T> { Some(T), None }
    pub_enum_def <- KW_PUB KW_ENUM IDENT type_param_list? LBRACE variant_list? RBRACE
                 => { CODE: ENUM, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, ITEMS: $6 }

    enum_def <- KW_ENUM IDENT type_param_list? LBRACE variant_list? RBRACE
             => { CODE: ENUM, NAME: $2, TYPE_PARAMS: $3, ITEMS: $5 }

    variant_list <- variant_def (COMMA variant_def)* COMMA?
                 => { ITEMS: $... }

    variant_def <- IDENT LPAREN type_ref (COMMA type_ref)* RPAREN
                => { CODE: VARIANT_DEF, NAME: $1, ITEMS: $... }
                 / IDENT ASSIGN INTEGER
                => { CODE: VARIANT_DEF, NAME: $1, VALUE: $3 }
                 / IDENT
                => { CODE: VARIANT_DEF, NAME: $1 }

    // ── Trait definition ─────────────────────────────────────────
    // trait Name { fn method(self: Self) -> T; }
    pub_trait_def <- KW_PUB KW_TRAIT IDENT type_param_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, ITEMS: $... }
                  / KW_PUB KW_TRAIT IDENT LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, NAME: $3, ITEMS: $... }

    trait_def <- KW_TRAIT IDENT type_param_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, NAME: $2, TYPE_PARAMS: $3, ITEMS: $... }
              / KW_TRAIT IDENT LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, NAME: $2, ITEMS: $... }

    trait_method <- KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
                 => { CODE: FN, NAME: $2, PARAMS: $4, RET_TYPE: $7, BODY: $8 }
                  / KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref SEMI
                 => { CODE: FN, NAME: $2, PARAMS: $4, RET_TYPE: $7 }
                  / KW_FN IDENT LPAREN param_list? RPAREN block
                 => { CODE: FN, NAME: $2, PARAMS: $4, BODY: $6 }
                  / KW_FN IDENT LPAREN param_list? RPAREN SEMI
                 => { CODE: FN, NAME: $2, PARAMS: $4 }
                  / KW_TYPE IDENT SEMI
                 => { CODE: ASSOC_TYPE_DEF, NAME: $2 }

    // ── Impl block ──────────────────────────────────────────────
    // impl Trait for Type { fn method(...) { ... } }
    // impl Type { fn method(...) { ... } }   — standalone (no trait)
    // impl<T> Trait for Struct<T> { ... }   — generic trait impl
    impl_block <- KW_IMPL type_param_list IDENT LT type_arg_list GT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IMPL_TYPE_PARAMS: $2, NAME: $3, TYPE_PARAMS: $5, TYPE: $8, ITEMS: $... }
                / KW_IMPL type_param_list IDENT KW_FOR ptr_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IMPL_TYPE_PARAMS: $2, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_IMPL type_param_list IDENT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IMPL_TYPE_PARAMS: $2, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_IMPL IDENT LT type_arg_list GT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, NAME: $2, TYPE_PARAMS: $4, TYPE: $7, ITEMS: $... }
                / KW_IMPL IDENT KW_FOR ptr_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, NAME: $2, TYPE: $4, ITEMS: $... }
                / KW_IMPL IDENT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, NAME: $2, TYPE: $4, ITEMS: $... }
                // impl<T> Pair<T> { ... } — standalone impl with own type parameters
                / KW_IMPL type_param_list simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, TYPE_PARAMS: $2, TYPE: $3, ITEMS: $... }
                / KW_IMPL simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, TYPE: $2, ITEMS: $... }

    // impl_item: method or associated type definition
    impl_item <- method_def
               / KW_TYPE IDENT ASSIGN type_ref SEMI
              => { CODE: ASSOC_TYPE_IMPL, NAME: $2, TYPE: $4 }

    // ── Class definition ─────────────────────────────────────────
    // class ClassName { ... }
    // class ClassName extends ParentName { ... }
    // abstract class ClassName { ... }
    // abstract class ClassName extends ParentName { ... }
    class_def <- KW_ABSTRACT KW_CLASS IDENT type_param_list? KW_EXTENDS simple_type LBRACE class_member* RBRACE
              => { CODE: CLASS, NAME: $3, TYPE_PARAMS: $4, PARENT: $6, IS_ABSTRACT: true, ITEMS: $8 }
               / KW_ABSTRACT KW_CLASS IDENT type_param_list? LBRACE class_member* RBRACE
              => { CODE: CLASS, NAME: $3, TYPE_PARAMS: $4, IS_ABSTRACT: true, ITEMS: $6 }
               / KW_CLASS IDENT type_param_list? KW_EXTENDS simple_type LBRACE class_member* RBRACE
              => { CODE: CLASS, NAME: $2, TYPE_PARAMS: $3, PARENT: $5, ITEMS: $7 }
               / KW_CLASS IDENT type_param_list? LBRACE class_member* RBRACE
              => { CODE: CLASS, NAME: $2, TYPE_PARAMS: $3, ITEMS: $5 }

    // class member: abstract method, static method, concrete method, or field
    class_member <- abstract_method_def / pub_static_fn_def / static_fn_def / pub_fn_def / fn_def / field_def

    // pub static fn name(params) -> ret_type { ... }
    pub_static_fn_def <- KW_PUB KW_STATIC KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
                      => { CODE: STATIC_FN, IS_PUB: 1, NAME: $4, PARAMS: $6, RET_TYPE: $9, BODY: $10 }
                       / KW_PUB KW_STATIC KW_FN IDENT LPAREN param_list? RPAREN block
                      => { CODE: STATIC_FN, IS_PUB: 1, NAME: $4, PARAMS: $6, BODY: $8 }

    // static fn name(params) -> ret_type { ... }
    // 'new' and 'delete' are allowed as method names (common constructor/destructor conventions).
    static_fn_def <- KW_STATIC KW_FN IDENT  LPAREN param_list? RPAREN ARROW type_ref block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, RET_TYPE: $8, BODY: $9 }
                   / KW_STATIC KW_FN KW_NEW LPAREN param_list? RPAREN ARROW type_ref block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, RET_TYPE: $8, BODY: $9 }
                   / KW_STATIC KW_FN IDENT  LPAREN param_list? RPAREN block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, BODY: $7 }
                   / KW_STATIC KW_FN KW_NEW LPAREN param_list? RPAREN block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, BODY: $7 }

    // abstract fn name(params) -> ret_type;
    abstract_method_def <- KW_ABSTRACT KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref SEMI
                        => { CODE: ABSTRACT_FN, NAME: $3, PARAMS: $5, RET_TYPE: $8 }
                         / KW_ABSTRACT KW_FN IDENT LPAREN param_list? RPAREN SEMI
                        => { CODE: ABSTRACT_FN, NAME: $3, PARAMS: $5 }

    // ── Struct definition ────────────────────────────────────────
    pub_struct_def <- KW_PUB KW_STRUCT IDENT type_param_list? LBRACE field_def* method_def* RBRACE
                   => { CODE: STRUCT, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, FIELDS: $6, ITEMS: $7 }

    struct_def <- KW_STRUCT IDENT type_param_list? LBRACE field_def* method_def* RBRACE
               => { CODE: STRUCT, NAME: $2, TYPE_PARAMS: $3, FIELDS: $5, ITEMS: $6 }

    field_def <- KW_PUB IDENT COLON type_ref SEMI
              => { CODE: FIELD_DEF, IS_PUB: 1, NAME: $2, TYPE: $4 }
               / IDENT COLON type_ref SEMI
              => { CODE: FIELD_DEF, NAME: $1, TYPE: $3 }

    // method_def: passthrough — static, pub, or regular fn
    method_def <- pub_static_fn_def / static_fn_def / pub_fn_def / fn_def

    // ── Extern function (FFI) ────────────────────────────────────
    extern_fn_def <- KW_EXTERN KW_FN IDENT LPAREN param_list COMMA DOTDOTDOT RPAREN ARROW type_ref SEMI
                  => { CODE: EXTERN_FN, NAME: $3, PARAMS: $5, RET_TYPE: $10, IS_VARARG: true }
                   / KW_EXTERN KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref SEMI
                  => { CODE: EXTERN_FN, NAME: $3, PARAMS: $5, RET_TYPE: $8 }
                   / KW_EXTERN KW_FN IDENT LPAREN param_list? RPAREN SEMI
                  => { CODE: EXTERN_FN, NAME: $3, PARAMS: $5 }

    // where T: Trait, U: Trait2
    where_clause <- KW_WHERE type_param (COMMA type_param)*
                 => { CODE: WHERE_CLAUSE, ITEMS: $... }

    // ── Public function ──────────────────────────────────────────
    pub_fn_def <- KW_PUB KW_UNSAFE KW_FN IDENT type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
               => { CODE: FN, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, TYPE_PARAMS: $5, PARAMS: $7, RET_TYPE: $10, WHERE: $11, BODY: $12 }
                / KW_PUB KW_UNSAFE KW_FN IDENT type_param_list? LPAREN param_list? RPAREN where_clause? block
               => { CODE: FN, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, TYPE_PARAMS: $5, PARAMS: $7, WHERE: $9, BODY: $10 }
                / KW_PUB KW_FN IDENT type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
               => { CODE: FN, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9, WHERE: $10, BODY: $11 }
                / KW_PUB KW_FN IDENT type_param_list? LPAREN param_list? RPAREN where_clause? block
               => { CODE: FN, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, WHERE: $8, BODY: $9 }

    // ── Private function ─────────────────────────────────────────
    fn_def <- KW_CONST KW_FN IDENT type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, IS_CONST: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9, WHERE: $10, BODY: $11 }
            / KW_CONST KW_FN IDENT type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, IS_CONST: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, WHERE: $8, BODY: $9 }
            / KW_UNSAFE KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9, WHERE: $10, BODY: $11 }
            / KW_UNSAFE KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, WHERE: $8, BODY: $9 }
            / KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, RET_TYPE: $8, WHERE: $9, BODY: $10 }
            / KW_FN KW_NEW type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, RET_TYPE: $8, WHERE: $9, BODY: $10 }
            / KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, WHERE: $7, BODY: $8 }
            / KW_FN KW_NEW type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, WHERE: $7, BODY: $8 }

    param_list <- param (COMMA param)*
              => { ITEMS: $... }

    param <- IDENT COLON type_ref DOTDOTDOT
          => { CODE: PARAM, NAME: $1, TYPE: $3, IS_VARIADIC: true }
           / IDENT COLON type_ref
          => { CODE: PARAM, NAME: $1, TYPE: $3 }

    // ── Type reference ───────────────────────────────────────────
    // assoc_type_ref must come before simple_type to match T::Item before T
    impl_type <- KW_IMPL IDENT
              => { CODE: IMPL_TYPE, NAME: $2 }

    type_ref <- ptr_type / arr_type / slice_type / dyn_type / ref_type / impl_type / unit_type / closure_type / tuple_type / assoc_type_ref / simple_type

    // T::Item — associated type reference (type param :: assoc type name)
    assoc_type_ref <- IDENT COLONCOLON IDENT
                   => { CODE: ASSOC_TYPE_REF, NAME: $1, FIELD: $3 }

    // &dyn Trait — trait object (fat pointer: data + vtable)
    dyn_type <- AMP KW_DYN IDENT
             => { CODE: DYN_TYPE, NAME: $3 }
              / KW_DYN IDENT
             => { CODE: DYN_TYPE, NAME: $2 }

    // &[T] — slice type (fat pointer: ptr + len)
    slice_type <- AMP LBRACKET type_ref RBRACKET
               => { CODE: SLICE_TYPE, TYPE: $3 }

    // &'a mut T / &mut T / &'a T / &T — safe reference types (borrow-checked)
    ref_type <- AMP LIFETIME KW_MUT simple_type
             => { CODE: MUT_REF_TYPE, POINTEE: $4, LIFETIME: $2 }
              / AMP KW_MUT simple_type
             => { CODE: MUT_REF_TYPE, POINTEE: $3 }
              / AMP LIFETIME simple_type
             => { CODE: REF_TYPE, POINTEE: $3, LIFETIME: $2 }
              / AMP simple_type
             => { CODE: REF_TYPE, POINTEE: $2 }

    // |T1, T2| -> R — closure type (used in function parameter type annotations)
    closure_type_args <- type_ref (COMMA type_ref)*
                      => { ITEMS: $... }
    closure_type <- PIPE closure_type_args PIPE ARROW type_ref
                 => { CODE: CLOSURE_TYPE, PARAMS: $2, RET_TYPE: $5 }

    // () — unit/void type (empty tuple, equivalent to void)
    unit_type <- LPAREN RPAREN
              => { CODE: TUPLE_TYPE }

    // (T1, T2, ...) — tuple type (2+ elements)
    tuple_type <- LPAREN type_ref COMMA type_ref (COMMA type_ref)* RPAREN
               => { CODE: TUPLE_TYPE, ITEMS: $... }

    ptr_type <- STAR KW_CONST simple_type
             => { CODE: PTR_TYPE, POINTEE: $3, MUTPTR: false }
              / STAR KW_MUT simple_type
             => { CODE: PTR_TYPE, POINTEE: $3, MUTPTR: true }

    // [T; N] — fixed-size array type
    arr_type <- LBRACKET simple_type SEMI INTEGER RBRACKET
             => { CODE: ARR_TYPE, TYPE: $2, SIZE: $4 }

    // type_or_lt_arg: a type argument that may be a lifetime annotation or a type.
    // Lifetimes (e.g. 'a) in generic type args are stored as LIFETIME_PARAM nodes
    // so sema can skip them when resolving concrete type arguments.
    type_or_lt_arg <- LIFETIME
                   => { CODE: LIFETIME_PARAM, NAME: $1 }
                    / type_ref

    simple_type <- IDENT LT type_or_lt_arg (COMMA type_or_lt_arg)* GT
                => { CODE: GENERIC_INST, NAME: $1, ITEMS: $... }
                 / IDENT
                => { CODE: TYPE_REF, NAME: $1 }

    // ── Block ────────────────────────────────────────────────────
    block <- LBRACE stmt* RBRACE
          => { CODE: BLOCK, ITEMS: $... }

    // ── Unsafe block ─────────────────────────────────────────────
    unsafe_block <- KW_UNSAFE block
                 => { CODE: UNSAFE_BLOCK, BODY: $2 }

    // ── Statements ───────────────────────────────────────────────
    stmt <- let_stmt
          / for_stmt
          / while_stmt
          / loop_stmt
          / return_stmt
          / break_stmt
          / continue_stmt
          / deref_write_stmt
          / if_expr
          / match_stmt
          / delete_stmt
          / field_index_write_stmt
          / deref_field_write_stmt
          / field_write_stmt
          / index_write_stmt
          / compound_assign_stmt
          / assign_stmt
          / unsafe_block
          / expr SEMI
            => { CODE: EXPR_STMT, VALUE: $1 }

    // for i in lo..hi { }  (exclusive) and  for i in lo..=hi { }  (inclusive)
    // for item in array { }  (for-each over fixed-size array)
    for_stmt <- KW_FOR IDENT KW_IN expr DOTDOTEQ expr block
             => { CODE: FOR, NAME: $2, LHS: $4, RHS: $6, BODY: $7, INCLUSIVE: true }
              / KW_FOR IDENT KW_IN expr DOTDOT expr block
             => { CODE: FOR, NAME: $2, LHS: $4, RHS: $6, BODY: $7, INCLUSIVE: false }
              / KW_FOR IDENT KW_IN expr block
             => { CODE: FOR_EACH, NAME: $2, ITER: $4, BODY: $5 }

    loop_stmt     <- KW_LOOP block
                  => { CODE: LOOP, BODY: $2 }

    break_stmt    <- KW_BREAK (SEMI / COMMA)
                  => { CODE: BREAK }

    continue_stmt <- KW_CONTINUE (SEMI / COMMA)
                  => { CODE: CONTINUE }

    // match expr { Pat => stmt_or_block, ... }
    match_stmt <- KW_MATCH expr LBRACE match_arm* RBRACE
               => { CODE: MATCH, VALUE: $2, ITEMS: $... }

    match_arm <- pattern KW_IF expr FATARROW block COMMA?
              => { CODE: MATCH_ARM, LHS: $1, GUARD: $3, BODY: $5 }
              / pattern KW_IF expr FATARROW stmt
              => { CODE: MATCH_ARM, LHS: $1, GUARD: $3, BODY: $5 }
              / pattern FATARROW block COMMA?
              => { CODE: MATCH_ARM, LHS: $1, BODY: $3 }
              / pattern FATARROW stmt
              => { CODE: MATCH_ARM, LHS: $1, BODY: $3 }
              / pattern KW_IF expr FATARROW expr COMMA?
              => { CODE: MATCH_ARM, LHS: $1, GUARD: $3, EXPR: $5 }
              / pattern FATARROW expr COMMA?
              => { CODE: MATCH_ARM, LHS: $1, EXPR: $3 }

    pat_binding <- IDENT
                => { CODE: PAT_WILD, NAME: $1 }

    pat_binding_list <- pat_binding (COMMA pat_binding)*
                     => { ITEMS: $... }

    pattern <- IDENT COLONCOLON IDENT LPAREN pat_binding_list? RPAREN
            => { CODE: PAT_VARIANT_DATA, NAME: $1, FIELD: $3, ARGS: $5 }
             / IDENT COLONCOLON IDENT
            => { CODE: PAT_VARIANT, NAME: $1, FIELD: $3 }
             / INTEGER
            => { CODE: PAT_INT, VALUE: $1 }
             / KW_TRUE
            => { CODE: PAT_BOOL, VALUE: true }
             / KW_FALSE
            => { CODE: PAT_BOOL, VALUE: false }
             / IDENT
            => { CODE: PAT_WILD, NAME: $1 }

    // arr[idx] = expr;
    index_write_stmt <- IDENT LBRACKET expr RBRACKET ASSIGN expr SEMI
                     => { CODE: INDEX_WRITE, NAME: $1, LHS: $3, VALUE: $6 }

    let_stmt <- KW_LET LPAREN pat_binding_list RPAREN ASSIGN expr SEMI
             => { CODE: LET_DESTRUCT, NAMES: $3, VALUE: $6 }
              / KW_LET KW_MUT IDENT COLON type_ref ASSIGN expr SEMI
             => { CODE: LET, IS_MUT: true, NAME: $3, TYPE: $5, VALUE: $7 }
              / KW_LET KW_MUT IDENT ASSIGN expr SEMI
             => { CODE: LET, IS_MUT: true, NAME: $3, VALUE: $5 }
              / KW_LET IDENT COLON type_ref ASSIGN expr SEMI
             => { CODE: LET, NAME: $2, TYPE: $4, VALUE: $6 }
              / KW_LET IDENT ASSIGN expr SEMI
             => { CODE: LET, NAME: $2, VALUE: $4 }

    while_stmt <- KW_WHILE KW_LET pattern ASSIGN expr block
               => { CODE: WHILE, PAT: $3, VALUE: $5, BODY: $6 }
             / KW_WHILE expr block
               => { CODE: WHILE, COND: $2, BODY: $3 }

    return_stmt <- KW_RETURN expr? (SEMI / COMMA)
                => { CODE: RETURN, VALUE: $2 }

    assign_stmt <- IDENT ASSIGN expr SEMI
                => { CODE: ASSIGN, NAME: $1, VALUE: $3 }

    // Compound assignment: x += expr → x = x + expr
    compound_assign_op <- PLUS_EQ / MINUS_EQ / STAR_EQ / SLASH_EQ / PERCENT_EQ
                        / AMP_EQ / PIPE_EQ / CARET_EQ / SHL_EQ / SHR_EQ
    compound_assign_stmt <- IDENT compound_assign_op expr SEMI
                         => { CODE: COMPOUND_ASSIGN, NAME: $1, OP: $2, VALUE: $3 }

    delete_stmt <- KW_DELETE expr SEMI
               => { CODE: DELETE_STMT, VALUE: $2 }

    field_write_stmt <- IDENT DOT IDENT ASSIGN expr SEMI
                     => { CODE: FIELD_WRITE, RECEIVER: $1, FIELD: $3, VALUE: $5 }

    // (*ptr).field = val;  — field write through a dereferenced pointer
    deref_field_write_stmt <- LPAREN STAR IDENT RPAREN DOT IDENT ASSIGN expr SEMI
                           => { CODE: DEREF_FIELD_WRITE, RECEIVER: $3, FIELD: $6, VALUE: $8 }

    // a.ptr[i] = val;  — field index write (pointer field)
    field_index_write_stmt <- IDENT DOT IDENT LBRACKET expr RBRACKET ASSIGN expr SEMI
                           => { CODE: FIELD_INDEX_WRITE, RECEIVER: $1, FIELD: $3, LHS: $5, VALUE: $8 }

    // *ptr = val;  — dereference write
    deref_write_stmt <- STAR unary_expr ASSIGN expr SEMI
                     => { CODE: DEREF_WRITE, NAME: $2, VALUE: $4 }

    if_expr <- KW_IF KW_LET pattern ASSIGN expr block KW_ELSE (if_expr / block)
            => { CODE: IF, PAT: $3, VALUE: $5, THEN: $6, ELSE: $8 }
             / KW_IF KW_LET pattern ASSIGN expr block
            => { CODE: IF, PAT: $3, VALUE: $5, THEN: $6 }
             / KW_IF expr block KW_ELSE (if_expr / block)
            => { CODE: IF, COND: $2, THEN: $3, ELSE: $5 }
             / KW_IF expr block
            => { CODE: IF, COND: $2, THEN: $3 }

    // ── Expressions (precedence via rule nesting) ─────────────────
    // Binary levels use left-associative fold chains so that a + b + c
    // parses as (a + b) + c without requiring explicit parentheses.
    // Comparison and logical operators remain single-level (non-chainable).
    expr <- log_expr

    log_expr <- cmp_expr
                ( (AND / OR) cmp_expr
                    => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                )+
              / cmp_expr

    cmp_expr <- bitwise_expr (EQ / NE / LE / GE / LT / GT) bitwise_expr
                => { CODE: BINOP, OP: $2, LHS: $1, RHS: $3 }
              / bitwise_expr

    // Bitwise and shift operators (higher precedence than comparison)
    bitwise_expr <- add_expr
                    ( (SHL / SHR / AMP / CARET / PIPE) add_expr
                        => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                    )+
                  / add_expr

    add_expr <- mul_expr
                ( (PLUS / MINUS) mul_expr
                    => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                )+
              / mul_expr

    // unary_expr inserted between mul_expr and atom for prefix ops
    mul_expr <- unary_expr
                ( (STAR / SLASH / PERCENT) unary_expr
                    => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                )+
              / unary_expr

    unary_expr <- STAR  unary_expr => { CODE: DEREF,      VALUE: $2 }
                / AMP KW_MUT unary_expr => { CODE: ADDR_OF_MUT, VALUE: $3 }
                / MINUS unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / BANG  unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / AMP   unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / cast_expr

    // ── Cast expression: atom as type ────────────────────────────
    cast_expr <- atom KW_AS type_ref
              => { CODE: CAST, VALUE: $1, TYPE: $3 }
               / atom

    // ── Atoms (postfix chain) ─────────────────────────────────────
    // atom = primary_expr followed by zero or more postfix suffixes.
    // The ( ... )* uses $0 (fold accumulator) for RECEIVER so that
    // a.b.c and a.f().b are parsed correctly as left-associative chains.
    atom <- primary_expr
            ( DOT IDENT LPAREN (expr (COMMA expr)*)? RPAREN
                => { CODE: METHOD_CALL, RECEIVER: $0, NAME: $2, ARGS: $... }
            / DOT INTEGER
                => { CODE: TUPLE_INDEX, RECEIVER: $0, FIELD: $2 }
            / DOT IDENT
                => { CODE: FIELD_READ, RECEIVER: $0, FIELD: $2 }
            / LBRACKET expr RBRACKET
                => { CODE: INDEX_READ, RECEIVER: $0, VALUE: $2 }
            / QUESTION
                => { CODE: TRY_EXPR, VALUE: $0 }
            )*

    // ── Primary expressions (base of a postfix chain) ─────────────
    primary_expr <- new_expr         // new ClassName { fields }  — before struct_lit
                  / struct_lit       // IDENT { fields }  — before plain IDENT
                  / arr_fill_lit     // [value; N]  — before arr_lit (avoids ambiguity)
                  / arr_lit          // [e1, e2, ...]
                  / tuple_lit        // (a, b, ...) — before paren_expr
                  / paren_expr       // (expr)
                  / closure_expr     // |x: i32| -> i32 { ... }
                  / unsafe_block     // unsafe { ... }  — as expression
                  / if_expr          // if cond { ... } else { ... }  — as expression
                  / match_stmt       // match expr { ... }  — as expression
                  / call_expr        // IDENT(args) / Class::method(args) — before enum_lit/IDENT
                  / enum_lit         // IDENT::VARIANT     — after call_expr (no parens)
                  / STRING   => { CODE: LIT_STR,  VALUE: $1 }
                  / KW_TRUE  => { CODE: LIT_BOOL, VALUE: true }
                  / KW_FALSE => { CODE: LIT_BOOL, VALUE: false }
                  / INTEGER  => { CODE: LIT_INT,  VALUE: $1 }
                  / IDENT DOTDOTDOT => { CODE: PACK_EXPAND, NAME: $1 }
                  / IDENT    => { CODE: VAR_REF,  NAME: $1 }

    // ── Class new expression: new ClassName { field: expr, ... } ──
    new_expr <- KW_NEW IDENT LT type_arg_list GT LBRACE (field_init (COMMA field_init)*)? RBRACE
             => { CODE: NEW_EXPR, NAME: $2, TYPE_PARAMS: $4, ITEMS: $... }
              / KW_NEW IDENT LBRACE (field_init (COMMA field_init)*)? RBRACE
             => { CODE: NEW_EXPR, NAME: $2, ITEMS: $... }

    // ── Enum variant literal: Color::Red or Option::Some(42) ──────
    enum_lit <- IDENT COLONCOLON IDENT LPAREN (expr (COMMA expr)*)? RPAREN
             => { CODE: ENUM_LIT_DATA, NAME: $1, FIELD: $3, ARGS: $... }
              / IDENT COLONCOLON IDENT
             => { CODE: ENUM_LIT, NAME: $1, FIELD: $3 }

    // ── Struct literal: TypeName { field: expr, ... } ─────────────
    struct_lit <- IDENT LBRACE (field_init (COMMA field_init)*)? RBRACE
               => { CODE: STRUCT_LIT, NAME: $1, ITEMS: $... }

    field_init <- IDENT COLON expr
               => { CODE: FIELD_INIT, NAME: $1, VALUE: $3 }

    // ── Array fill literal: [value; N] ───────────────────────────
    arr_fill_lit <- LBRACKET expr SEMI INTEGER RBRACKET
                 => { CODE: ARR_FILL_LIT, VALUE: $2, SIZE: $4 }

    // ── Array literal: [e1, e2, ...] ─────────────────────────────
    arr_lit <- LBRACKET (expr (COMMA expr)*)? RBRACKET
            => { CODE: ARR_LIT, ITEMS: $... }

    // ── Tuple literal: (expr, expr, ...) — 2+ elements ────────────
    tuple_lit <- LPAREN expr COMMA expr (COMMA expr)* RPAREN
              => { CODE: TUPLE_LIT, ITEMS: $... }

    // ── Closure expression ────────────────────────────────────────
    // |x: i32, y: i32| -> i32 { return x + y; }
    // |x: i32| { return x + 1; }
    // || -> i32 { return 42; }
    closure_expr <- PIPE param_list? PIPE ARROW type_ref block
                 => { CODE: CLOSURE_EXPR, PARAMS: $2, RET_TYPE: $5, BODY: $6 }
                  / PIPE param_list? PIPE block
                 => { CODE: CLOSURE_EXPR, PARAMS: $2, BODY: $4 }

    // ── Parenthesised expression ──────────────────────────────────
    paren_expr <- LPAREN expr RPAREN
               => { CODE: PAREN_EXPR, VALUE: $2 }

    // ── Type parameter list: <T, U: Bound1 + Bound2> ─────────────
    // Also used for specialisation patterns: <i32>, <*T>, <[T; 4]>, etc.
    // Detection (TypeVar vs concrete) is done in sema, not in the grammar.
    type_param_list <- LT type_param (COMMA type_param)* GT
                    => { ITEMS: $... }

    trait_bound <- IDENT
                => { CODE: TRAIT_BOUND, NAME: $1 }

    // Lifetime parameter: 'a
    lifetime_param <- LIFETIME
                   => { CODE: LIFETIME_PARAM, NAME: $1 }

    type_param <- lifetime_param
                / ptr_type
                / arr_type
                / IDENT DOTDOTDOT COLON trait_bound (PLUS trait_bound)*
               => { CODE: TYPE_PARAM, NAME: $1, IS_VARIADIC: true, ITEMS: $... }
                / IDENT DOTDOTDOT
               => { CODE: TYPE_PARAM, NAME: $1, IS_VARIADIC: true }
                / IDENT COLON trait_bound (PLUS trait_bound)*
               => { CODE: TYPE_PARAM, NAME: $1, ITEMS: $... }
                / IDENT
               => { CODE: TYPE_PARAM, NAME: $1 }

    // ── Type argument list (for generic instantiation in types): Vec<i32> ─
    type_arg_list <- type_or_lt_arg (COMMA type_or_lt_arg)*
                  => { ITEMS: $... }

    // ── Value argument list (for call sites) ─────────────────────
    call_arg_list <- expr (COMMA expr)*
                  => { ITEMS: $... }

    // ── Free function call: fn(args) or fn::<T>(args) or Class::method(args) ─
    call_expr <- IDENT COLONCOLON LT type_arg_list GT LPAREN call_arg_list? RPAREN
              => { CODE: GENERIC_CALL, CALLEE: $1, TYPE_PARAMS: $4, ARGS: $7 }
               / IDENT COLONCOLON IDENT  LPAREN call_arg_list? RPAREN
              => { CODE: STATIC_CALL, RECEIVER: $1, NAME: $3, ARGS: $5 }
               / IDENT COLONCOLON KW_NEW LPAREN call_arg_list? RPAREN
              => { CODE: STATIC_CALL, RECEIVER: $1, NAME: $3, ARGS: $5 }
               / IDENT LPAREN (expr (COMMA expr)*)? RPAREN
              => { CODE: CALL, CALLEE: $1, ARGS: $... }
}
