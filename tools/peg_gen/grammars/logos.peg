// SPDX-License-Identifier: Apache-2.0
// Copyright 2026 Victor Smirnov
// Logos project — https://github.com/victor-smirnov/logos
//
// Logos language grammar — Iteration 3.
//
// Rust-like syntax. Packages, use declarations, extern fn, pub visibility,
// string literals, pointer types, free functions, let, if/else, return,
// while loops, assignment, structs with fields and methods, field access,
// method calls, struct literals, parenthesised expressions.

%meta {
    name:      "logos"
    version:   "0.3"
    namespace: "logos::compiler"
    output:    "logos_parser"
}

%export { module }

// ── AST field keys ────────────────────────────────────────────────────────
%fields {
    CODE        = 0
    NAME        = 1
    ITEMS       = 2
    TYPE        = 3
    PARAMS      = 4
    BODY        = 5
    RET_TYPE    = 6
    VALUE       = 7
    COND        = 8
    THEN        = 9
    ELSE        = 10
    OP          = 11
    LHS         = 12
    RHS         = 13
    CALLEE      = 14
    ARGS        = 15
    USES        = 17
    POINTEE     = 18
    MUTPTR      = 19
    RECEIVER    = 20
    FIELD       = 21
    FIELDS      = 22
    SIZE        = 23
    SRC_LINE    = 24
    IS_MUT      = 25
    INCLUSIVE   = 26
    TYPE_PARAMS = 27
    PARENT      = 28
    IS_ABSTRACT = 29
    IS_VARARG   = 30
    ITER        = 31
    IS_VARIADIC = 32
    IS_PUB      = 33
    PAT         = 34
    GUARD       = 35
    EXPR        = 36
    NAMES       = 37
    WHERE          = 38
    IS_CONST       = 39
    LIFETIME       = 40
    IMPL_TYPE_PARAMS = 41
    IS_UNSAFE      = 42
    INDEX          = 43
    IS_MOVE        = 44
    IS_REF         = 45
    BASE           = 46
    LABEL          = 47
    SUPERS         = 48
    LO_NEG         = 49
    HI_NEG         = 50
    KEY            = 51    // map key in HERMES_ENTRY

    // ── Group: mod ────────────────────────────────────────────────────────
    // Fields scoped to MODULE and USE nodes.  Slot numbers in a group reuse
    // the same 0..51 space as global fields; peg_gen resolves action field
    // names to this group when the rule is tagged `:group mod:`.
    group mod {
        PATH_PARTS = 16    // array of sub-nodes (one per component after NAME)
    }
}

// ── AST node codes ────────────────────────────────────────────────────────
%nodes {
    MODULE      = 1
    PACKAGE     = 2
    USE         = 3
    FN          = 10
    EXTERN_FN   = 11
    PARAM       = 12
    BLOCK       = 20
    LET         = 21
    RETURN      = 22
    IF          = 23
    EXPR_STMT   = 24
    CALL        = 30
    BINOP       = 31
    VAR_REF     = 32
    LIT_INT     = 33
    LIT_BOOL    = 34
    LIT_STR     = 35
    TYPE_REF    = 40
    PTR_TYPE    = 41
    STRUCT      = 50
    FIELD_DEF   = 51
    FIELD_INIT  = 52
    STRUCT_LIT  = 53
    FIELD_READ  = 54
    FIELD_WRITE = 55
    METHOD_CALL = 56
    ASSIGN      = 57
    WHILE       = 58
    DEREF       = 59
    PAREN_EXPR  = 60
    UNARY       = 61
    INDEX_READ  = 62
    INDEX_WRITE = 63
    ARR_TYPE    = 64
    ARR_LIT     = 65
    BREAK       = 66
    CONTINUE    = 67
    LOOP        = 68
    CAST        = 69
    FOR         = 70
    CONST_DEF   = 71
    TYPE_ALIAS  = 72
    ENUM        = 80
    VARIANT_DEF = 81
    MATCH       = 82
    MATCH_ARM   = 83
    PAT_VARIANT = 84
    PAT_WILD    = 85
    ENUM_LIT    = 86
    PAT_INT     = 87
    PAT_BOOL    = 88
    TRAIT_BOUND = 89
    TYPE_PARAM  = 90
    GENERIC_CALL = 91
    GENERIC_INST = 92
    CLASS        = 93
    NEW_EXPR     = 94
    DELETE_STMT  = 95
    ABSTRACT_FN  = 96
    STATIC_FN    = 97
    STATIC_CALL  = 98
    FOR_EACH     = 99
    TUPLE_TYPE   = 100
    TUPLE_LIT    = 101
    TUPLE_INDEX  = 102
    ENUM_LIT_DATA    = 104
    PAT_VARIANT_DATA = 105
    TRAIT_DEF        = 106
    IMPL_BLOCK       = 107
    CLOSURE_EXPR     = 109
    SLICE_TYPE           = 111
    RANGE_EXPR           = 112
    FIELD_INDEX_WRITE    = 113
    ADDR_OF_MUT          = 114
    DEREF_WRITE          = 115
    IMPL_TYPE            = 116
    PACK_EXPAND          = 117
    DYN_TYPE             = 118
    ASSOC_TYPE_DEF       = 119
    ASSOC_TYPE_IMPL      = 120
    ASSOC_TYPE_REF       = 121
    TRY_EXPR             = 122
    LET_DESTRUCT         = 123
    WHERE_CLAUSE         = 124
    CLOSURE_TYPE         = 125
    COMPOUND_ASSIGN      = 126
    ARR_FILL_LIT         = 127
    DEREF_FIELD_WRITE    = 128
    REF_TYPE             = 129
    MUT_REF_TYPE         = 130
    LIFETIME_PARAM       = 131
    UNSAFE_BLOCK         = 132
    CONST_PARAM          = 133
    TUPLE_FIELD_WRITE    = 134
    LIT_FLOAT            = 135
    FIELD_COMPOUND_ASSIGN = 136   // s.field op= expr
    INDEX_COMPOUND_ASSIGN = 137   // arr[i] op= expr
    PAT_NEG_INT           = 138   // negative integer literal in pattern: -42
    PAT_OR                = 139   // OR pattern: pat | pat
    FIELD_SHORTHAND       = 140   // struct field shorthand: Point { x, y }
    LET_ELSE              = 141   // let Pat = expr else { block };
    LABELED_LOOP          = 142   // 'label: loop/for/while { }
    PAT_TUPLE             = 143   // tuple pattern: (a, b, c) =>
    FN_PTR_TYPE           = 144   // fn(T) -> R — bare function pointer type
    DEREF_FIELD_COMPOUND_ASSIGN = 145   // (*ptr).field op= expr
    TUPLE_FIELD_COMPOUND_ASSIGN = 146   // var.N op= expr
    FIELD_INDEX_COMPOUND_ASSIGN = 147   // s.field[i] op= expr
    DATATYPE                    = 148   // Hermes datatype definition (C POD layout)
    PAT_UNIT                    = 149   // () unit pattern in match arms
    ANNOTATION                  = 150   // #[name], #[name = val], #[name(args)]
    TAGGED_TYPE                 = 151   // &tagged<TS> Trait — tag-dispatched thin pointer
    ASSOC_CONST_DEF             = 152   // const NAME: T;       in trait
    ASSOC_CONST_IMPL            = 153   // const NAME: T = expr; in impl
    PAT_STRUCT                  = 154   // Point { x, y } struct pattern
    PAT_SLICE                   = 155   // [a, b] or [first, .., last] slice pattern
    PAT_RANGE                   = 156   // 0..=9 inclusive range pattern
    PAT_AT                      = 157   // n @ sub_pat binding
    PAT_REF                     = 158   // &pat or &mut pat reference pattern
    PAT_FIELD                   = 159   // field binding in struct pattern
    PAT_REST                    = 160   // .. rest in struct/slice pattern
    CHAIN_FIELD_WRITE           = 161   // a.b.c = val
    CHAIN_FIELD_COMPOUND_ASSIGN = 162   // a.b.c op= val
    HERMES_MAP                  = 163   // @{k:v,...} or inner {k:v,...} Hermes map literal
    HERMES_ARRAY                = 164   // @[v,...] or inner [v,...] Hermes array literal
    HERMES_STR                  = 165   // string value in Hermes literal
    HERMES_INT                  = 166   // integer value in Hermes literal
    HERMES_FLOAT                = 167   // float value in Hermes literal
    HERMES_BOOL                 = 168   // bool value in Hermes literal
    HERMES_NULL                 = 169   // null value in Hermes literal
    HERMES_ENTRY                = 170   // key:val pair in Hermes map
}

// ── Tokens ────────────────────────────────────────────────────────────────
%tokens {
    // Keywords (longest-match first within same length)
    KW_CONTINUE = "continue"
    KW_PACKAGE  = "package"
    KW_DATATYPE = "eidos"
    KW_GENOS    = "genos"
    KW_STATIC   = "static"
    KW_RETURN   = "return"
    KW_EXTERN   = "extern"
    KW_STRUCT   = "struct"
    KW_MATCH    = "match"
    KW_WHILE    = "while"
    KW_BREAK    = "break"
    KW_FALSE    = "false"
    KW_TRAIT    = "trait"
    KW_CONST    = "const"
    KW_TYPE     = "type"
    KW_IMPL     = "impl"
    KW_ENUM     = "enum"
    KW_LOOP     = "loop"
    KW_ELSE     = "else"
    KW_TRUE     = "true"
    KW_FOR      = "for"
    KW_USE      = "use"
    KW_MUT      = "mut"
    KW_LET      = "let"
    KW_DYN      = "dyn"
    KW_TAGGED   = "tagged"
    KW_PUB      = "pub"
    KW_NEW      = "new"
    KW_FN       = "fn"
    KW_IF       = "if"
    KW_IN       = "in"
    KW_AS       = "as"
    KW_WHERE    = "where"
    KW_UNSAFE   = "unsafe"
    KW_MOVE     = "move"
    KW_REF      = "ref"
    KW_NULL     = "null"

    // Punctuation
    LBRACE      = "{"
    RBRACE      = "}"
    LBRACKET    = "["
    RBRACKET    = "]"
    LPAREN      = "("
    RPAREN      = ")"
    COLON       = ":"
    COMMA       = ","
    SEMI        = ";"
    ARROW       = "->"
    DOT         = "."
    STAR        = "*"
    AMP         = "&"

    // Operators (multi-char first)
    AND         = "&&"
    OR          = "||"
    EQ          = "=="
    NE          = "!="
    LE          = "<="
    GE          = ">="
    SHL_EQ      = "<<="
    SHR_EQ      = ">>="
    SHL         = "<<"
    SHR         = ">>"
    PLUS_EQ     = "+="
    MINUS_EQ    = "-="
    STAR_EQ     = "*="
    SLASH_EQ    = "/="
    PERCENT_EQ  = "%="
    AMP_EQ      = "&="
    PIPE_EQ     = "|="
    CARET_EQ    = "^="
    PIPE        = "|"
    DOTDOTDOT   = "..."
    DOTDOTEQ    = "..="
    DOTDOT      = ".."
    LT          = "<"
    GT          = ">"
    PLUS        = "+"
    MINUS       = "-"
    SLASH       = "/"
    PERCENT     = "%"
    BANG        = "!"
    QUESTION    = "?"
    ASSIGN      = "="
    FATARROW    = "=>"
    COLONCOLON  = "::"
    CARET       = "^"
    HASH        = "#"
    AT          = "@"

    // Literals & identifiers
    RAW_STRING  = /r"[^"]*"/
    STRING      = /"([^"\\]|\\.)*"/
    FLOAT       = /[-]?[0-9][0-9_]*\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?(f32|f64)?/
    INTEGER     = /[-]?(0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+|[0-9][0-9_]*)(i8|i16|i24|i32|i56|i64|i128|u8|u16|u24|u32|u56|u64|u128|usize|isize)?/
    LIFETIME    = /'[a-z][a-z0-9_]*/
    IDENT       = /[a-zA-Z_][a-zA-Z0-9_]*/

    // Skip
    %skip       = /[ \t\n\r]+/
    %skip       = /\/\/[^\n]*/
    %skip       = /\/\*.*?\*\//
}

// ── Rules ─────────────────────────────────────────────────────────────────
%rules {

    // ── Top level ────────────────────────────────────────────────
    // Package paths: `a`, `a.b`, `a.b.c`, … arbitrary depth.
    // `NAME` is the first component; `PATH_PARTS` is an array of sub-nodes
    // for components 2..N (empty when there's only one component).
    module :group mod: <- KW_PACKAGE IDENT path_dot_ident* SEMI use_decl* item*
           => { CODE: MODULE, NAME: $2, PATH_PARTS: $3, USES: $5, ITEMS: $... }

    use_decl :group mod: <- KW_USE IDENT path_dot_ident* SEMI
             => { CODE: USE, NAME: $2, PATH_PARTS: $3 }

    path_dot_ident <- DOT IDENT
                   => { NAME: $2 }

    item <- annotation / const_def / type_alias / pub_enum_def / enum_def / pub_datatype_def / datatype_def / pub_datatype_inst / datatype_inst / pub_trait_inst / trait_inst / pub_struct_def / struct_def / pub_trait_def / trait_def / impl_block / extern_fn_def / pub_fn_def / fn_def

    // ── Annotations ──────────────────────────────────────────────
    // #[name(arg1, arg2)]  — annotation with identifier arguments
    // #[name = 123]        — annotation with integer value
    // #[name]              — simple flag annotation
    annotation <- HASH LBRACKET IDENT LPAREN annot_args RPAREN RBRACKET
               => { CODE: ANNOTATION, NAME: $3, ARGS: $5 }
                / HASH LBRACKET IDENT ASSIGN INTEGER RBRACKET
               => { CODE: ANNOTATION, NAME: $3, VALUE: $5 }
                / HASH LBRACKET IDENT RBRACKET
               => { CODE: ANNOTATION, NAME: $3 }

    // annot_arg wraps IDENT in a sub-rule so that $... in annot_args correctly
    // collects each argument into rcap_0 (the $... spread only works for sub-rule
    // results, not bare terminal captures).
    annot_arg  <- IDENT => { NAME: $1 }

    annot_args <- annot_arg (COMMA annot_arg)* COMMA?
               => { ITEMS: $... }

    // const NAME: type = expr;
    const_def <- KW_CONST IDENT COLON type_ref ASSIGN expr SEMI
              => { CODE: CONST_DEF, NAME: $2, TYPE: $4, VALUE: $6 }

    // static NAME: type = expr;  (module-level mutable static — same repr as const for now)
    // type NAME = type_ref;
    type_alias <- KW_PUB KW_TYPE IDENT type_param_list ASSIGN type_ref SEMI
               => { CODE: TYPE_ALIAS, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, TYPE: $6 }
                / KW_PUB KW_TYPE IDENT ASSIGN type_ref SEMI
               => { CODE: TYPE_ALIAS, IS_PUB: 1, NAME: $3, TYPE: $5 }
                / KW_TYPE IDENT type_param_list ASSIGN type_ref SEMI
               => { CODE: TYPE_ALIAS, NAME: $2, TYPE_PARAMS: $3, TYPE: $5 }
                / KW_TYPE IDENT ASSIGN type_ref SEMI
               => { CODE: TYPE_ALIAS, NAME: $2, TYPE: $4 }

    // ── Enum definition ──────────────────────────────────────────
    // enum Color { Red, Green = 5, Blue }
    // enum Option<T> { Some(T), None }
    pub_enum_def <- KW_PUB KW_ENUM IDENT type_param_list? LBRACE variant_list? RBRACE
                 => { CODE: ENUM, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, ITEMS: $6 }

    enum_def <- KW_ENUM IDENT type_param_list? LBRACE variant_list? RBRACE
             => { CODE: ENUM, NAME: $2, TYPE_PARAMS: $3, ITEMS: $5 }

    variant_list <- variant_def (COMMA variant_def)* COMMA?
                 => { ITEMS: $... }

    variant_payload_list <- type_ref (COMMA type_ref)*
                         => { ITEMS: $... }

    variant_def <- IDENT LPAREN DOTDOTDOT type_ref RPAREN
                => { CODE: VARIANT_DEF, NAME: $1, IS_VARIADIC: 1, ITEMS: $4 }
                 / IDENT LPAREN variant_payload_list RPAREN
                => { CODE: VARIANT_DEF, NAME: $1, ITEMS: $3 }
                 / IDENT ASSIGN INTEGER
                => { CODE: VARIANT_DEF, NAME: $1, VALUE: $3 }
                 / IDENT
                => { CODE: VARIANT_DEF, NAME: $1 }

    // ── Trait definition ─────────────────────────────────────────
    // trait Name { fn method(self: Self) -> T; }
    // trait Foo: Bar + Baz — optional supertrait bound list after colon
    super_list <- COLON trait_bound (PLUS trait_bound)*
               => { ITEMS: $... }

    // `genos` is accepted as a synonym of `trait` so stdlib can spell
    // "pub genos Varchar { … }" while parsing/sema keep treating it as a
    // trait.  Semantic distinction (carrying type_code, one-eidos-per-TS
    // registration) will be added on top in a later pass.
    trait_kw <- KW_TRAIT / KW_GENOS

    pub_trait_def <- KW_PUB KW_UNSAFE trait_kw IDENT type_param_list super_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, TYPE_PARAMS: $5, SUPERS: $6, ITEMS: $... }
                  / KW_PUB KW_UNSAFE trait_kw IDENT type_param_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, TYPE_PARAMS: $5, ITEMS: $... }
                  / KW_PUB KW_UNSAFE trait_kw IDENT super_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, SUPERS: $5, ITEMS: $... }
                  / KW_PUB KW_UNSAFE trait_kw IDENT LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, ITEMS: $... }
                  / KW_PUB trait_kw IDENT type_param_list super_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, SUPERS: $5, ITEMS: $... }
                  / KW_PUB trait_kw IDENT type_param_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, ITEMS: $... }
                  / KW_PUB trait_kw IDENT super_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, NAME: $3, SUPERS: $4, ITEMS: $... }
                  / KW_PUB trait_kw IDENT LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, NAME: $3, ITEMS: $... }

    trait_def <- KW_UNSAFE trait_kw IDENT type_param_list super_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, SUPERS: $5, ITEMS: $... }
              / KW_UNSAFE trait_kw IDENT type_param_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, ITEMS: $... }
              / KW_UNSAFE trait_kw IDENT super_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_UNSAFE: 1, NAME: $3, SUPERS: $4, ITEMS: $... }
              / KW_UNSAFE trait_kw IDENT LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_UNSAFE: 1, NAME: $3, ITEMS: $... }
              / trait_kw IDENT type_param_list super_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, NAME: $2, TYPE_PARAMS: $3, SUPERS: $4, ITEMS: $... }
              / trait_kw IDENT type_param_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, NAME: $2, TYPE_PARAMS: $3, ITEMS: $... }
              / trait_kw IDENT super_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, NAME: $2, SUPERS: $3, ITEMS: $... }
              / trait_kw IDENT LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, NAME: $2, ITEMS: $... }

    trait_method <- KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, PARAMS: $5, RET_TYPE: $8, BODY: $9 }
                  / KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref SEMI
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, PARAMS: $5, RET_TYPE: $8 }
                  / KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN block
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, PARAMS: $5, BODY: $7 }
                  / KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN SEMI
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, PARAMS: $5 }
                  / KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
                 => { CODE: FN, NAME: $2, PARAMS: $4, RET_TYPE: $7, BODY: $8 }
                  / KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref SEMI
                 => { CODE: FN, NAME: $2, PARAMS: $4, RET_TYPE: $7 }
                  / KW_FN IDENT LPAREN param_list? RPAREN block
                 => { CODE: FN, NAME: $2, PARAMS: $4, BODY: $6 }
                  / KW_FN IDENT LPAREN param_list? RPAREN SEMI
                 => { CODE: FN, NAME: $2, PARAMS: $4 }
                  / KW_TYPE IDENT type_param_list (COLON trait_bound (PLUS trait_bound)*)? SEMI
                 => { CODE: ASSOC_TYPE_DEF, NAME: $2, TYPE_PARAMS: $3, ITEMS: $... }
                  / KW_TYPE IDENT (COLON trait_bound (PLUS trait_bound)*)? SEMI
                 => { CODE: ASSOC_TYPE_DEF, NAME: $2, ITEMS: $... }
                  / KW_CONST IDENT COLON type_ref SEMI
                 => { CODE: ASSOC_CONST_DEF, NAME: $2, TYPE: $4 }

    // ── Impl block ──────────────────────────────────────────────
    // impl Trait for Type { fn method(...) { ... } }
    // impl Type { fn method(...) { ... } }   — standalone (no trait)
    // impl<T> Trait for Struct<T> { ... }   — generic trait impl
    impl_block <- KW_UNSAFE KW_IMPL type_param_list IDENT LT type_arg_list GT_TYPE KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, IMPL_TYPE_PARAMS: $3, NAME: $4, TYPE_PARAMS: $6, TYPE: $9, ITEMS: $... }
                / KW_UNSAFE KW_IMPL type_param_list IDENT KW_FOR ptr_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, IMPL_TYPE_PARAMS: $3, NAME: $4, TYPE: $6, ITEMS: $... }
                / KW_UNSAFE KW_IMPL type_param_list IDENT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, IMPL_TYPE_PARAMS: $3, NAME: $4, TYPE: $6, ITEMS: $... }
                / KW_UNSAFE KW_IMPL IDENT LT type_arg_list GT_TYPE KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $5, TYPE: $8, ITEMS: $... }
                / KW_UNSAFE KW_IMPL IDENT KW_FOR ptr_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_UNSAFE KW_IMPL IDENT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_UNSAFE KW_IMPL type_param_list simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, TYPE_PARAMS: $3, TYPE: $4, ITEMS: $... }
                / KW_UNSAFE KW_IMPL simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, TYPE: $3, ITEMS: $... }
                / KW_IMPL type_param_list IDENT LT type_arg_list GT_TYPE KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IMPL_TYPE_PARAMS: $2, NAME: $3, TYPE_PARAMS: $5, TYPE: $8, ITEMS: $... }
                / KW_IMPL type_param_list IDENT KW_FOR ptr_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IMPL_TYPE_PARAMS: $2, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_IMPL type_param_list IDENT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IMPL_TYPE_PARAMS: $2, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_IMPL IDENT LT type_arg_list GT_TYPE KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, NAME: $2, TYPE_PARAMS: $4, TYPE: $7, ITEMS: $... }
                / KW_IMPL IDENT KW_FOR ptr_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, NAME: $2, TYPE: $4, ITEMS: $... }
                / KW_IMPL IDENT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, NAME: $2, TYPE: $4, ITEMS: $... }
                // impl<T> Pair<T> { ... } — standalone impl with own type parameters
                / KW_IMPL type_param_list simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, TYPE_PARAMS: $2, TYPE: $3, ITEMS: $... }
                / KW_IMPL simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, TYPE: $2, ITEMS: $... }

    // impl_item: method, associated type, or associated constant definition
    impl_item <- method_def
               / KW_TYPE IDENT type_param_list ASSIGN type_ref SEMI
              => { CODE: ASSOC_TYPE_IMPL, NAME: $2, TYPE_PARAMS: $3, TYPE: $5 }
               / KW_TYPE IDENT ASSIGN type_ref SEMI
              => { CODE: ASSOC_TYPE_IMPL, NAME: $2, TYPE: $4 }
               / KW_CONST IDENT COLON type_ref ASSIGN expr SEMI
              => { CODE: ASSOC_CONST_IMPL, NAME: $2, TYPE: $4, VALUE: $6 }


    // pub static fn name(params) -> ret_type { ... }
    pub_static_fn_def <- KW_PUB KW_STATIC KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
                      => { CODE: STATIC_FN, IS_PUB: 1, IS_UNSAFE: 1, NAME: $5, PARAMS: $7, RET_TYPE: $10, BODY: $11 }
                       / KW_PUB KW_STATIC KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN block
                      => { CODE: STATIC_FN, IS_PUB: 1, IS_UNSAFE: 1, NAME: $5, PARAMS: $7, BODY: $9 }
                       / KW_PUB KW_STATIC KW_FN KW_NEW LPAREN param_list? RPAREN ARROW type_ref block
                      => { CODE: STATIC_FN, IS_PUB: 1, NAME: $4, PARAMS: $6, RET_TYPE: $9, BODY: $10 }
                       / KW_PUB KW_STATIC KW_FN KW_NEW LPAREN param_list? RPAREN block
                      => { CODE: STATIC_FN, IS_PUB: 1, NAME: $4, PARAMS: $6, BODY: $8 }
                       / KW_PUB KW_STATIC KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
                      => { CODE: STATIC_FN, IS_PUB: 1, NAME: $4, PARAMS: $6, RET_TYPE: $9, BODY: $10 }
                       / KW_PUB KW_STATIC KW_FN IDENT LPAREN param_list? RPAREN block
                      => { CODE: STATIC_FN, IS_PUB: 1, NAME: $4, PARAMS: $6, BODY: $8 }

    // static fn name(params) -> ret_type { ... }
    // 'new' and 'delete' are allowed as method names (common constructor/destructor conventions).
    static_fn_def <- KW_STATIC KW_UNSAFE KW_FN IDENT  LPAREN param_list? RPAREN ARROW type_ref block
                  => { CODE: STATIC_FN, IS_UNSAFE: 1, NAME: $4, PARAMS: $6, RET_TYPE: $9, BODY: $10 }
                   / KW_STATIC KW_UNSAFE KW_FN IDENT  LPAREN param_list? RPAREN block
                  => { CODE: STATIC_FN, IS_UNSAFE: 1, NAME: $4, PARAMS: $6, BODY: $8 }
                   / KW_STATIC KW_FN IDENT  LPAREN param_list? RPAREN ARROW type_ref block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, RET_TYPE: $8, BODY: $9 }
                   / KW_STATIC KW_FN KW_NEW LPAREN param_list? RPAREN ARROW type_ref block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, RET_TYPE: $8, BODY: $9 }
                   / KW_STATIC KW_FN IDENT  LPAREN param_list? RPAREN block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, BODY: $7 }
                   / KW_STATIC KW_FN KW_NEW LPAREN param_list? RPAREN block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, BODY: $7 }

    // ── Datatype definition (Hermes — C POD layout, no heap types) ──
    pub_datatype_def <- KW_PUB KW_DATATYPE IDENT type_param_list? LBRACE field_def* RBRACE
                     => { CODE: DATATYPE, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, FIELDS: $6 }

    datatype_def <- KW_DATATYPE IDENT type_param_list? LBRACE field_def* RBRACE
                 => { CODE: DATATYPE, NAME: $2, TYPE_PARAMS: $3, FIELDS: $5 }

    // ── Explicit instantiation declarations (no body) ────────────
    // Binds metadata annotations to a generic instantiation.
    // E.g.: #[type_code=42] datatype Array<i32>;
    pub_datatype_inst <- KW_PUB KW_DATATYPE type_ref SEMI
                      => { CODE: DATATYPE, IS_PUB: 1, TYPE: $3 }

    datatype_inst <- KW_DATATYPE type_ref SEMI
                  => { CODE: DATATYPE, TYPE: $2 }

    // Explicit genos specialization decl: `#[type_code=N] pub genos Array<i32>;`.
    // Binds annotations (type_code, future metadata) to a logical-family
    // specialization; implementing eidos inherit via impl.
    pub_trait_inst <- KW_PUB trait_kw type_ref SEMI
                   => { CODE: TRAIT_DEF, IS_PUB: 1, TYPE: $3 }

    trait_inst <- trait_kw type_ref SEMI
               => { CODE: TRAIT_DEF, TYPE: $2 }

    // ── Struct definition ────────────────────────────────────────
    pub_struct_def <- KW_PUB KW_STRUCT IDENT type_param_list? LBRACE field_def* method_def* RBRACE
                   => { CODE: STRUCT, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, FIELDS: $6, ITEMS: $7 }

    struct_def <- KW_STRUCT IDENT type_param_list? LBRACE field_def* method_def* RBRACE
               => { CODE: STRUCT, NAME: $2, TYPE_PARAMS: $3, FIELDS: $5, ITEMS: $6 }

    field_def <- KW_PUB IDENT COLON type_ref COMMA?
              => { CODE: FIELD_DEF, IS_PUB: 1, NAME: $2, TYPE: $4 }
               / IDENT COLON type_ref COMMA?
              => { CODE: FIELD_DEF, NAME: $1, TYPE: $3 }
               / IDENT DOTDOTDOT COLON type_ref COMMA?
              => { CODE: FIELD_DEF, NAME: $1, TYPE: $4, IS_VARIADIC: 1 }

    // method_def: passthrough — static, pub, or regular fn
    method_def <- pub_static_fn_def / static_fn_def / pub_fn_def / fn_def

    // ── Extern function (FFI) ────────────────────────────────────
    extern_fn_def <- KW_EXTERN KW_FN IDENT LPAREN param_list COMMA DOTDOTDOT RPAREN ARROW type_ref SEMI
                  => { CODE: EXTERN_FN, NAME: $3, PARAMS: $5, RET_TYPE: $10, IS_VARARG: true }
                   / KW_EXTERN KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref SEMI
                  => { CODE: EXTERN_FN, NAME: $3, PARAMS: $5, RET_TYPE: $8 }
                   / KW_EXTERN KW_FN IDENT LPAREN param_list? RPAREN SEMI
                  => { CODE: EXTERN_FN, NAME: $3, PARAMS: $5 }

    // where T: Trait, U: Trait2
    where_clause <- KW_WHERE type_param (COMMA type_param)*
                 => { CODE: WHERE_CLAUSE, ITEMS: $... }

    // ── Public function ──────────────────────────────────────────
    pub_fn_def <- KW_PUB KW_UNSAFE KW_FN IDENT type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
               => { CODE: FN, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, TYPE_PARAMS: $5, PARAMS: $7, RET_TYPE: $10, WHERE: $11, BODY: $12 }
                / KW_PUB KW_UNSAFE KW_FN IDENT type_param_list? LPAREN param_list? RPAREN where_clause? block
               => { CODE: FN, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, TYPE_PARAMS: $5, PARAMS: $7, WHERE: $9, BODY: $10 }
                / KW_PUB KW_FN IDENT type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
               => { CODE: FN, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9, WHERE: $10, BODY: $11 }
                / KW_PUB KW_FN IDENT type_param_list? LPAREN param_list? RPAREN where_clause? block
               => { CODE: FN, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, WHERE: $8, BODY: $9 }

    // ── Private function ─────────────────────────────────────────
    fn_def <- KW_CONST KW_FN IDENT type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, IS_CONST: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9, WHERE: $10, BODY: $11 }
            / KW_CONST KW_FN IDENT type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, IS_CONST: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, WHERE: $8, BODY: $9 }
            / KW_UNSAFE KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9, WHERE: $10, BODY: $11 }
            / KW_UNSAFE KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, WHERE: $8, BODY: $9 }
            / KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, RET_TYPE: $8, WHERE: $9, BODY: $10 }
            / KW_FN KW_NEW type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, RET_TYPE: $8, WHERE: $9, BODY: $10 }
            / KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, WHERE: $7, BODY: $8 }
            / KW_FN KW_NEW type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, WHERE: $7, BODY: $8 }

    param_list <- param (COMMA param)*
              => { ITEMS: $... }

    param <- AMP KW_MUT IDENT
          => { CODE: PARAM, NAME: $3, IS_REF: true, IS_MUT: true }
           / AMP IDENT
          => { CODE: PARAM, NAME: $2, IS_REF: true }
           / IDENT COLON type_ref DOTDOTDOT
          => { CODE: PARAM, NAME: $1, TYPE: $3, IS_VARIADIC: true }
           / IDENT COLON type_ref
          => { CODE: PARAM, NAME: $1, TYPE: $3 }

    // ── Type reference ───────────────────────────────────────────
    // assoc_type_ref must come before simple_type to match T::Item before T
    impl_type <- KW_IMPL IDENT
              => { CODE: IMPL_TYPE, NAME: $2 }

    type_ref <- ptr_type / arr_type / slice_type / tagged_type / dyn_type / ref_type / impl_type / unit_type / closure_type / fn_ptr_type / tuple_type / assoc_type_ref / simple_type

    // T::Item / T::Item<A, B> — associated type reference (plain or GAT with type args)
    assoc_type_ref <- simple_type
                    ( COLONCOLON IDENT LT type_arg_list GT_TYPE
                      => { CODE: ASSOC_TYPE_REF, RECEIVER: $0, FIELD: $2, TYPE_PARAMS: $4 }
                    / COLONCOLON IDENT
                      => { CODE: ASSOC_TYPE_REF, RECEIVER: $0, FIELD: $2 }
                    )+

    // &tagged<TS> Trait — thin tag-dispatched pointer.
    // The tag (type_code) is stored in memory before the object; at call sites
    // the compiler reads the tag, looks up the dispatch table, and calls indirectly.
    tagged_type <- AMP KW_TAGGED LT simple_type GT_TYPE IDENT
               => { CODE: TAGGED_TYPE, TYPE: $4, NAME: $6 }

    // &dyn Trait — trait object (fat pointer: data + vtable)
    dyn_type <- AMP KW_DYN IDENT
             => { CODE: DYN_TYPE, NAME: $3 }
              / KW_DYN IDENT
             => { CODE: DYN_TYPE, NAME: $2 }

    // &[T] and &mut [T] — slice types (fat pointer: ptr + len)
    slice_type <- AMP KW_MUT LBRACKET type_ref RBRACKET
               => { CODE: SLICE_TYPE, TYPE: $4, MUTPTR: true }
               / AMP LBRACKET type_ref RBRACKET
               => { CODE: SLICE_TYPE, TYPE: $3 }

    // &'a mut T / &mut T / &'a T / &T — safe reference types (borrow-checked)
    ref_type <- AMP LIFETIME KW_MUT ref_pointee
             => { CODE: MUT_REF_TYPE, POINTEE: $4, LIFETIME: $2 }
              / AMP KW_MUT ref_pointee
             => { CODE: MUT_REF_TYPE, POINTEE: $3 }
              / AMP LIFETIME ref_pointee
             => { CODE: REF_TYPE, POINTEE: $3, LIFETIME: $2 }
              / AMP ref_pointee
             => { CODE: REF_TYPE, POINTEE: $2 }

    // Pointee types for & and &mut: simple types plus tuple and array composites.
    ref_pointee <- arr_type / tuple_type / unit_type / simple_type

    // |T1, T2| -> R — closure type (used in function parameter type annotations)
    closure_type_args <- type_ref (COMMA type_ref)*
                      => { ITEMS: $... }
    closure_type <- PIPE closure_type_args PIPE ARROW type_ref
                 => { CODE: CLOSURE_TYPE, PARAMS: $2, RET_TYPE: $5 }

    // fn(T1, T2) -> R — bare function pointer type
    fn_ptr_type_args <- type_ref (COMMA type_ref)*
                     => { ITEMS: $... }
    fn_ptr_type <- KW_FN LPAREN fn_ptr_type_args RPAREN ARROW type_ref
                => { CODE: FN_PTR_TYPE, PARAMS: $3, RET_TYPE: $6 }
                / KW_FN LPAREN RPAREN ARROW type_ref
                => { CODE: FN_PTR_TYPE, RET_TYPE: $5 }

    // () — unit/void type (empty tuple, equivalent to void)
    unit_type <- LPAREN RPAREN
              => { CODE: TUPLE_TYPE }

    // (T1, T2, ...) — tuple type (2+ elements); (T,) — single-element tuple
    tuple_type <- LPAREN type_ref COMMA type_ref (COMMA type_ref)* RPAREN
               => { CODE: TUPLE_TYPE, ITEMS: $... }
               / LPAREN type_ref COMMA RPAREN
               => { CODE: TUPLE_TYPE, ITEMS: $... }

    ptr_type <- STAR KW_CONST type_ref
             => { CODE: PTR_TYPE, POINTEE: $3, MUTPTR: false }
              / STAR KW_MUT type_ref
             => { CODE: PTR_TYPE, POINTEE: $3, MUTPTR: true }

    // [T; N] — fixed-size array type
    arr_type <- LBRACKET type_ref SEMI (INTEGER / IDENT) RBRACKET
              => { CODE: ARR_TYPE, TYPE: $2, SIZE: $4 }

    // type_or_lt_arg: a type argument that may be a lifetime annotation or a type.
    // Lifetimes (e.g. 'a) in generic type args are stored as LIFETIME_PARAM nodes
    // so sema can skip them when resolving concrete type arguments.
    type_or_lt_arg <- LIFETIME
                   => { CODE: LIFETIME_PARAM, NAME: $1 }
                    / type_ref

    simple_type <- IDENT LT type_or_lt_arg (COMMA type_or_lt_arg)* GT_TYPE
                => { CODE: GENERIC_INST, NAME: $1, ITEMS: $... }
                 / IDENT
                => { CODE: TYPE_REF, NAME: $1 }

    // ── Block ────────────────────────────────────────────────────
    block <- LBRACE stmt* RBRACE
          => { CODE: BLOCK, ITEMS: $... }

    // ── Unsafe block ─────────────────────────────────────────────
    unsafe_block <- KW_UNSAFE block
                 => { CODE: UNSAFE_BLOCK, BODY: $2 }

    // ── Statements ───────────────────────────────────────────────
    stmt <- labeled_loop_stmt
          / let_else_stmt
          / let_stmt
          / for_stmt
          / while_stmt
          / loop_stmt
          / return_stmt
          / break_stmt
          / continue_stmt
          / deref_write_stmt
          / if_expr
          / match_stmt

          / field_index_compound_assign_stmt
          / field_index_write_stmt
          / deref_field_compound_assign_stmt
          / deref_field_write_stmt
          / tuple_field_compound_assign_stmt
          / tuple_field_write_stmt
          / chain_field_compound_assign_stmt
          / chain_field_write_stmt
          / field_compound_assign_stmt
          / field_write_stmt
          / index_compound_assign_stmt
          / index_write_stmt
          / compound_assign_stmt
          / assign_stmt
          / unsafe_block
          / expr SEMI
            => { CODE: EXPR_STMT, VALUE: $1 }
          / expr
            => { CODE: EXPR_STMT, VALUE: $1 }

    // for i in lo..hi { }  (exclusive) and  for i in lo..=hi { }  (inclusive)
    // for item in array { }  (for-each over fixed-size array)
    //
    // Factor the shared prefix `KW_FOR IDENT KW_IN expr` so we don't reparse
    // the iterator expression on each alternative's failure.  The tail rule
    // dispatches on the operator that follows (DOTDOT / DOTDOTEQ / block).
    for_stmt <- KW_FOR IDENT KW_IN expr DOTDOTEQ expr block
             => { CODE: FOR, NAME: $2, LHS: $4, RHS: $6, BODY: $7, INCLUSIVE: true }
              / KW_FOR IDENT KW_IN expr DOTDOT   expr block
             => { CODE: FOR, NAME: $2, LHS: $4, RHS: $6, BODY: $7, INCLUSIVE: false }
              / KW_FOR IDENT KW_IN expr                block
             => { CODE: FOR_EACH, NAME: $2, ITER: $4, BODY: $5 }

    loop_stmt     <- KW_LOOP block
                  => { CODE: LOOP, BODY: $2 }

    loop_expr     <- KW_LOOP block
                  => { CODE: LOOP, BODY: $2 }

    // Labeled loop: 'label: for/while/loop { }
    labeled_loop_stmt <- LIFETIME COLON for_stmt
                      => { CODE: LABELED_LOOP, LABEL: $1, BODY: $3 }
                       / LIFETIME COLON while_stmt
                      => { CODE: LABELED_LOOP, LABEL: $1, BODY: $3 }
                       / LIFETIME COLON loop_stmt
                      => { CODE: LABELED_LOOP, LABEL: $1, BODY: $3 }

    break_stmt    <- KW_BREAK LIFETIME expr SEMI
                  => { CODE: BREAK, LABEL: $2, VALUE: $3 }
                   / KW_BREAK LIFETIME SEMI
                  => { CODE: BREAK, LABEL: $2 }
                   / KW_BREAK expr SEMI
                  => { CODE: BREAK, VALUE: $2 }
                   / KW_BREAK (SEMI / COMMA)
                  => { CODE: BREAK }

    continue_stmt <- KW_CONTINUE LIFETIME SEMI
                  => { CODE: CONTINUE, LABEL: $2 }
                   / KW_CONTINUE (SEMI / COMMA)
                  => { CODE: CONTINUE }

    // match expr { Pat => stmt_or_block, ... }
    match_stmt <- KW_MATCH expr LBRACE match_arm* RBRACE
               => { CODE: MATCH, VALUE: $2, ITEMS: $... }

    match_arm <- pattern KW_IF expr FATARROW block COMMA?
              => { CODE: MATCH_ARM, LHS: $1, GUARD: $3, BODY: $5 }
              / pattern KW_IF expr FATARROW expr COMMA?
              => { CODE: MATCH_ARM, LHS: $1, GUARD: $3, EXPR: $5 }
              / pattern KW_IF expr FATARROW stmt
              => { CODE: MATCH_ARM, LHS: $1, GUARD: $3, BODY: $5 }
              / pattern FATARROW block COMMA?
              => { CODE: MATCH_ARM, LHS: $1, BODY: $3 }
              / pattern FATARROW expr COMMA?
              => { CODE: MATCH_ARM, LHS: $1, EXPR: $3 }
              / pattern FATARROW stmt
              => { CODE: MATCH_ARM, LHS: $1, BODY: $3 }

    pat_binding <- LPAREN RPAREN
                => { CODE: PAT_UNIT }
               / IDENT
                => { CODE: PAT_WILD, NAME: $1 }

    pat_binding_list <- pat_binding (COMMA pat_binding)*
                     => { ITEMS: $... }

    pattern <- pat_single (PIPE pat_single)*
            => { CODE: PAT_OR, ITEMS: $... }

    // ── Single field in a struct pattern ─────────────────────────────────
    pat_field <- DOTDOT
              => { CODE: PAT_REST }
               / IDENT COLON pat_single
              => { CODE: PAT_FIELD, NAME: $1, VALUE: $3 }
               / IDENT
              => { CODE: PAT_FIELD, NAME: $1 }

    pat_field_list <- pat_field (COMMA pat_field)* COMMA?
                   => { ITEMS: $... }

    // ── Single element in a slice pattern ────────────────────────────────
    pat_slice_elem <- DOTDOT
                   => { CODE: PAT_REST }
                    / pat_single

    pat_slice_elems <- pat_slice_elem (COMMA pat_slice_elem)* COMMA?
                    => { ITEMS: $... }

    // ── pat_single: all pattern alternatives ─────────────────────────────
    pat_single
        // @ binding: must come before bare IDENT to capture "name @ sub"
        // G1: use pat_single (not pat_single_base) so n @ ref x and n @ &pat work.
        <- IDENT AT pat_single
        => { CODE: PAT_AT, NAME: $1, VALUE: $3 }
        // ref mut binding
        / KW_REF KW_MUT IDENT
        => { CODE: PAT_WILD, NAME: $3, IS_MUT: true, IS_REF: true }
        // ref binding
        / KW_REF IDENT
        => { CODE: PAT_WILD, NAME: $2, IS_REF: true }
        // reference pattern: &mut pat or &pat
        // NG1: use pat_single (not pat_single_base) so &ref x, &n@42, etc. work.
        / AMP KW_MUT pat_single
        => { CODE: PAT_REF, IS_MUT: true, VALUE: $3 }
        / AMP pat_single
        => { CODE: PAT_REF, VALUE: $2 }
        // everything else
        / pat_single_base

    pat_single_base
        <- IDENT COLONCOLON IDENT LPAREN pat_binding_list? RPAREN
        => { CODE: PAT_VARIANT_DATA, NAME: $1, FIELD: $3, ARGS: $5 }
        / IDENT COLONCOLON IDENT
        => { CODE: PAT_VARIANT, NAME: $1, FIELD: $3 }
        // struct pattern: Point { field_list } or Point {}
        / IDENT LBRACE pat_field_list RBRACE
        => { CODE: PAT_STRUCT, NAME: $1, ITEMS: $3 }
        / IDENT LBRACE RBRACE
        => { CODE: PAT_STRUCT, NAME: $1 }
        // slice pattern: [elems] or []
        / LBRACKET pat_slice_elems RBRACKET
        => { CODE: PAT_SLICE, ITEMS: $2 }
        / LBRACKET RBRACKET
        => { CODE: PAT_SLICE }
        // range patterns (inclusive ..=): must come before bare INTEGER
        / MINUS INTEGER DOTDOTEQ MINUS INTEGER
        => { CODE: PAT_RANGE, LHS: $2, RHS: $5, LO_NEG: true, HI_NEG: true }
        / MINUS INTEGER DOTDOTEQ INTEGER
        => { CODE: PAT_RANGE, LHS: $2, RHS: $4, LO_NEG: true }
        / INTEGER DOTDOTEQ MINUS INTEGER
        => { CODE: PAT_RANGE, LHS: $1, RHS: $4, HI_NEG: true }
        / INTEGER DOTDOTEQ INTEGER
        => { CODE: PAT_RANGE, LHS: $1, RHS: $3 }
        / MINUS INTEGER
        => { CODE: PAT_NEG_INT, VALUE: $2 }
        / INTEGER
        => { CODE: PAT_INT, VALUE: $1 }
        / KW_TRUE
        => { CODE: PAT_BOOL, VALUE: true }
        / KW_FALSE
        => { CODE: PAT_BOOL, VALUE: false }
        / LPAREN pat_single COMMA pat_single (COMMA pat_single)* RPAREN
        => { CODE: PAT_TUPLE, ITEMS: $... }
        / IDENT
        => { CODE: PAT_WILD, NAME: $1 }

    // arr[idx] = expr;
    index_write_stmt <- IDENT LBRACKET expr RBRACKET ASSIGN expr SEMI
                     => { CODE: INDEX_WRITE, NAME: $1, LHS: $3, VALUE: $6 }

    // let Pat = expr else { block };
    let_else_stmt <- KW_LET pattern ASSIGN expr KW_ELSE block SEMI
                  => { CODE: LET_ELSE, PAT: $2, VALUE: $4, BODY: $6 }

    let_stmt <- KW_LET LPAREN pat_binding_list RPAREN ASSIGN expr SEMI
             => { CODE: LET_DESTRUCT, NAMES: $3, VALUE: $6 }
              / KW_LET KW_MUT IDENT COLON type_ref ASSIGN expr SEMI
             => { CODE: LET, IS_MUT: true, NAME: $3, TYPE: $5, VALUE: $7 }
              / KW_LET KW_MUT IDENT ASSIGN expr SEMI
             => { CODE: LET, IS_MUT: true, NAME: $3, VALUE: $5 }
              / KW_LET IDENT COLON type_ref ASSIGN expr SEMI
             => { CODE: LET, NAME: $2, TYPE: $4, VALUE: $6 }
              / KW_LET IDENT ASSIGN expr SEMI
             => { CODE: LET, NAME: $2, VALUE: $4 }

    while_stmt <- KW_WHILE KW_LET pattern ASSIGN expr block
               => { CODE: WHILE, PAT: $3, VALUE: $5, BODY: $6 }
             / KW_WHILE expr block
               => { CODE: WHILE, COND: $2, BODY: $3 }

    return_stmt <- KW_RETURN expr? (SEMI / COMMA)
                => { CODE: RETURN, VALUE: $2 }

    assign_stmt <- IDENT ASSIGN expr SEMI
                => { CODE: ASSIGN, NAME: $1, VALUE: $3 }

    // Compound assignment: x += expr → x = x + expr
    compound_assign_op <- PLUS_EQ / MINUS_EQ / STAR_EQ / SLASH_EQ / PERCENT_EQ
                        / AMP_EQ / PIPE_EQ / CARET_EQ / SHL_EQ / SHR_EQ
    compound_assign_stmt <- IDENT compound_assign_op expr SEMI
                         => { CODE: COMPOUND_ASSIGN, NAME: $1, OP: $2, VALUE: $3 }

    // var.N = value;  — tuple field write (N is an integer index literal)
    tuple_field_write_stmt <- IDENT DOT INTEGER ASSIGN expr SEMI
                           => { CODE: TUPLE_FIELD_WRITE, RECEIVER: $1, INDEX: $3, VALUE: $5 }

    field_write_stmt <- IDENT DOT IDENT ASSIGN expr SEMI
                     => { CODE: FIELD_WRITE, RECEIVER: $1, FIELD: $3, VALUE: $5 }

    // a.b.c = val;  — chained field write (2 levels deep)
    chain_field_write_stmt <- IDENT DOT IDENT DOT IDENT ASSIGN expr SEMI
                           => { CODE: CHAIN_FIELD_WRITE, RECEIVER: $1, NAME: $3, FIELD: $5, VALUE: $7 }

    // s.field op= expr;  — compound assign to struct field
    field_compound_assign_stmt <- IDENT DOT IDENT compound_assign_op expr SEMI
                               => { CODE: FIELD_COMPOUND_ASSIGN, RECEIVER: $1, FIELD: $3, OP: $4, VALUE: $5 }

    // a.b.c op= val;  — chained field compound assign (2 levels deep)
    chain_field_compound_assign_stmt <- IDENT DOT IDENT DOT IDENT compound_assign_op expr SEMI
                                     => { CODE: CHAIN_FIELD_COMPOUND_ASSIGN, RECEIVER: $1, NAME: $3, FIELD: $5, OP: $6, VALUE: $7 }

    // arr[i] op= expr;  — compound assign to array index
    index_compound_assign_stmt <- IDENT LBRACKET expr RBRACKET compound_assign_op expr SEMI
                               => { CODE: INDEX_COMPOUND_ASSIGN, NAME: $1, LHS: $3, OP: $5, VALUE: $6 }

    // (*ptr).field = val;  — field write through a dereferenced pointer
    deref_field_write_stmt <- LPAREN STAR IDENT RPAREN DOT IDENT ASSIGN expr SEMI
                           => { CODE: DEREF_FIELD_WRITE, RECEIVER: $3, FIELD: $6, VALUE: $8 }

    // (*ptr).field op= val;  — compound assign to field through a dereferenced pointer
    deref_field_compound_assign_stmt <- LPAREN STAR IDENT RPAREN DOT IDENT compound_assign_op expr SEMI
                                     => { CODE: DEREF_FIELD_COMPOUND_ASSIGN, RECEIVER: $3, FIELD: $6, OP: $7, VALUE: $8 }

    // var.N op= expr;  — compound assign to tuple field
    tuple_field_compound_assign_stmt <- IDENT DOT INTEGER compound_assign_op expr SEMI
                                     => { CODE: TUPLE_FIELD_COMPOUND_ASSIGN, RECEIVER: $1, INDEX: $3, OP: $4, VALUE: $5 }

    // a.ptr[i] = val;  — field index write (pointer field)
    field_index_write_stmt <- IDENT DOT IDENT LBRACKET expr RBRACKET ASSIGN expr SEMI
                           => { CODE: FIELD_INDEX_WRITE, RECEIVER: $1, FIELD: $3, LHS: $5, VALUE: $8 }

    // s.field[i] op= val;  — compound assign to field array element
    field_index_compound_assign_stmt <- IDENT DOT IDENT LBRACKET expr RBRACKET compound_assign_op expr SEMI
                                     => { CODE: FIELD_INDEX_COMPOUND_ASSIGN, RECEIVER: $1, FIELD: $3, LHS: $5, OP: $7, VALUE: $8 }

    // *ptr = val;  — dereference write
    deref_write_stmt <- STAR unary_expr ASSIGN expr SEMI
                     => { CODE: DEREF_WRITE, NAME: $2, VALUE: $4 }

    if_expr <- KW_IF KW_LET pattern ASSIGN expr block KW_ELSE (if_expr / block)
            => { CODE: IF, PAT: $3, VALUE: $5, THEN: $6, ELSE: $8 }
             / KW_IF KW_LET pattern ASSIGN expr block
            => { CODE: IF, PAT: $3, VALUE: $5, THEN: $6 }
             / KW_IF expr block KW_ELSE (if_expr / block)
            => { CODE: IF, COND: $2, THEN: $3, ELSE: $5 }
             / KW_IF expr block
            => { CODE: IF, COND: $2, THEN: $3 }

    // ── Expressions (precedence via rule nesting) ─────────────────
    // Binary levels use left-associative fold chains so that a + b + c
    // parses as (a + b) + c without requiring explicit parentheses.
    // Comparison and logical operators remain single-level (non-chainable).
    expr <- log_expr

    log_expr <- cmp_expr
                ( (AND / OR) cmp_expr
                    => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                )*

    // Non-chainable: at most one comparison.  Wrapping in `?` removes the
    // `/ bitwise_expr` fallback that caused bitwise_expr to reparse on
    // every `(1)`-style leaf expression without a comparator.
    cmp_expr <- bitwise_expr
                ( (EQ / NE / LE / GE / LT / GT) bitwise_expr
                    => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                )?

    // Bitwise and shift operators (higher precedence than comparison)
    // (zero-or-more to avoid PEG backtracking when no operator follows)
    bitwise_expr <- add_expr
                    ( (SHL / SHR / AMP / CARET / PIPE) add_expr
                        => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                    )*

    add_expr <- mul_expr
                ( (PLUS / MINUS) mul_expr
                    => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                )*

    // Rust precedence (low → high): * / %  <  as  <  unary (- * ! & &mut)
    mul_expr <- cast_expr
                ( (STAR / SLASH / PERCENT) cast_expr
                    => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                )*

    // ── Cast expression: unary_expr (as type)* ──────────────────────
    // Lower precedence than unary operators.  Left-associative chaining
    // so `x as i64 as i24` folds naturally, and a bare `unary_expr`
    // pays no backtracking cost (fold-mode `*` with zero iterations
    // passes the capture through unchanged).
    cast_expr <- unary_expr
                ( KW_AS type_ref
                    => { CODE: CAST, VALUE: $0, TYPE: $2 }
                )*

    unary_expr <- STAR  unary_expr => { CODE: DEREF,      VALUE: $2 }
                / AMP KW_MUT unary_expr => { CODE: ADDR_OF_MUT, VALUE: $3 }
                / MINUS unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / BANG  unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / AMP   unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / atom

    // ── Atoms (postfix chain) ─────────────────────────────────────
    // atom = primary_expr followed by zero or more postfix suffixes.
    // The ( ... )* uses $0 (fold accumulator) for RECEIVER so that
    // a.b.c and a.f().b are parsed correctly as left-associative chains.
    atom <- primary_expr
            ( DOT IDENT LPAREN (expr (COMMA expr)*)? RPAREN
                => { CODE: METHOD_CALL, RECEIVER: $0, NAME: $2, ARGS: $... }
            / DOT INTEGER
                => { CODE: TUPLE_INDEX, RECEIVER: $0, FIELD: $2 }
            / DOT IDENT
                => { CODE: FIELD_READ, RECEIVER: $0, FIELD: $2 }
            / LBRACKET expr RBRACKET
                => { CODE: INDEX_READ, RECEIVER: $0, VALUE: $2 }
            / QUESTION
                => { CODE: TRY_EXPR, VALUE: $0 }
            )*

    // ── Primary expressions (base of a postfix chain) ─────────────
    primary_expr <- hermes_lit    // @{...} @[...] @scalar — Hermes SDN literal (before IDENT)
                  / generic_struct_lit // IDENT::<T> { fields } — before struct_lit
                  / struct_update_lit  // IDENT { fields, ..base } — before struct_lit
                  / struct_lit       // IDENT { fields }  — before plain IDENT
                  / arr_fill_lit     // [value; N]  — before arr_lit (avoids ambiguity)
                  / arr_lit          // [e1, e2, ...]
                  / LPAREN RPAREN => { CODE: TUPLE_LIT }  // () — unit value
                  / paren_expr       // (expr) — BEFORE tuple_lit so single-expr parens
                                     // don't pay the cost of tuple-lit backtracking
                                     // (common case in deeply nested `as`-cast chains).
                  / tuple_lit        // (a, b, ...)
                  / closure_expr     // |x: i32| -> i32 { ... }
                  / unsafe_block     // unsafe { ... }  — as expression
                  / loop_expr        // loop { ... }  — as expression (break value)
                  / if_expr          // if cond { ... } else { ... }  — as expression
                  / match_stmt       // match expr { ... }  — as expression
                  / call_expr        // IDENT(args) / Type::method(args) — before enum_lit/IDENT
                  / enum_lit         // IDENT::VARIANT     — after call_expr (no parens)
                  / RAW_STRING => { CODE: LIT_STR, VALUE: $1 }
                  / STRING   => { CODE: LIT_STR,  VALUE: $1 }
                  / KW_TRUE  => { CODE: LIT_BOOL, VALUE: true }
                  / KW_FALSE => { CODE: LIT_BOOL, VALUE: false }
                  / FLOAT    => { CODE: LIT_FLOAT, VALUE: $1 }
                  / INTEGER  => { CODE: LIT_INT,  VALUE: $1 }
                  / IDENT DOTDOTDOT => { CODE: PACK_EXPAND, NAME: $1 }
                  / IDENT    => { CODE: VAR_REF,  NAME: $1 }

    // ── Enum variant literal: Color::Red or Option::Some(42) ──────
    enum_lit <- IDENT COLONCOLON IDENT LPAREN (expr (COMMA expr)*)? RPAREN
             => { CODE: ENUM_LIT_DATA, NAME: $1, FIELD: $3, ARGS: $... }
              / IDENT COLONCOLON IDENT
             => { CODE: ENUM_LIT, NAME: $1, FIELD: $3 }

    // ── Struct literal: TypeName { field: expr, ... } ─────────────
    // Generic form: TypeName::<T, U> { field: expr, ... }
    generic_struct_lit <- IDENT COLONCOLON LT type_arg_list GT_TYPE LBRACE (field_init (COMMA field_init)* COMMA?)? RBRACE
                       => { CODE: STRUCT_LIT, NAME: $1, TYPE_PARAMS: $4, ITEMS: $... }

    // Struct update syntax: TypeName { field: val, ..base } or TypeName { ..base }
    struct_update_lit <- IDENT LBRACE field_init (COMMA field_init)* COMMA DOTDOT expr RBRACE
                      => { CODE: STRUCT_LIT, NAME: $1, ITEMS: $..., BASE: $7 }
                       / IDENT LBRACE DOTDOT expr RBRACE
                      => { CODE: STRUCT_LIT, NAME: $1, BASE: $4 }

    struct_lit <- IDENT LBRACE (field_init (COMMA field_init)* COMMA?)? RBRACE
               => { CODE: STRUCT_LIT, NAME: $1, ITEMS: $... }

    field_init <- IDENT COLON expr
               => { CODE: FIELD_INIT, NAME: $1, VALUE: $3 }
              / IDENT
               => { CODE: FIELD_SHORTHAND, NAME: $1 }

    // ── Array fill literal: [value; N] ───────────────────────────
    arr_fill_lit <- LBRACKET expr SEMI INTEGER RBRACKET
                 => { CODE: ARR_FILL_LIT, VALUE: $2, SIZE: $4 }

    // ── Hermes SDN literals: @{k:v,...}  @[v,...]  @"s"  @42  @true  @null ──
    // Only the outermost literal needs the @ sigil; inner values are plain.
    hermes_lit <- AT hermes_map
               / AT hermes_array
               / AT RAW_STRING => { CODE: HERMES_STR, VALUE: $2 }
               / AT STRING     => { CODE: HERMES_STR, VALUE: $2 }
               / AT FLOAT      => { CODE: HERMES_FLOAT, VALUE: $2 }
               / AT INTEGER    => { CODE: HERMES_INT, VALUE: $2 }
               / AT KW_TRUE    => { CODE: HERMES_BOOL, VALUE: true }
               / AT KW_FALSE   => { CODE: HERMES_BOOL, VALUE: false }
               / AT KW_NULL    => { CODE: HERMES_NULL }

    hermes_map <- LBRACE (hermes_entry (COMMA hermes_entry)* COMMA?)? RBRACE
               => { CODE: HERMES_MAP, ITEMS: $... }

    hermes_array <- LBRACKET (hermes_val (COMMA hermes_val)* COMMA?)? RBRACKET
                 => { CODE: HERMES_ARRAY, ITEMS: $... }

    // key can be a quoted string or an integer (for TinyObjectMap-style maps)
    hermes_entry <- STRING COLON hermes_val
                 => { CODE: HERMES_ENTRY, KEY: $1, VALUE: $3 }
                 / INTEGER COLON hermes_val
                 => { CODE: HERMES_ENTRY, KEY: $1, VALUE: $3 }

    // recursive: inner values don't need the @ prefix
    hermes_val <- hermes_map
               / hermes_array
               / RAW_STRING => { CODE: HERMES_STR, VALUE: $1 }
               / STRING     => { CODE: HERMES_STR, VALUE: $1 }
               / FLOAT      => { CODE: HERMES_FLOAT, VALUE: $1 }
               / INTEGER    => { CODE: HERMES_INT, VALUE: $1 }
               / KW_TRUE    => { CODE: HERMES_BOOL, VALUE: true }
               / KW_FALSE   => { CODE: HERMES_BOOL, VALUE: false }
               / KW_NULL    => { CODE: HERMES_NULL }

    // ── Array literal: [e1, e2, ...] ─────────────────────────────
    arr_lit <- LBRACKET (expr (COMMA expr)* COMMA?)? RBRACKET
            => { CODE: ARR_LIT, ITEMS: $... }

    // ── Tuple literal: (expr, expr, ...) — 2+ elements ────────────
    tuple_lit <- LPAREN expr COMMA expr (COMMA expr)* RPAREN
              => { CODE: TUPLE_LIT, ITEMS: $... }
               / LPAREN expr COMMA RPAREN
              => { CODE: TUPLE_LIT, ITEMS: $... }

    // ── Closure expression ────────────────────────────────────────
    // |x: i32, y: i32| -> i32 { return x + y; }
    // |x: i32| { return x + 1; }
    // || -> i32 { return 42; }
    closure_expr <- KW_MOVE OR ARROW type_ref block
                 => { CODE: CLOSURE_EXPR, IS_MOVE: 1, RET_TYPE: $4, BODY: $5 }
                  / KW_MOVE OR block
                 => { CODE: CLOSURE_EXPR, IS_MOVE: 1, BODY: $3 }
                  / KW_MOVE PIPE param_list? PIPE ARROW type_ref block
                 => { CODE: CLOSURE_EXPR, IS_MOVE: 1, PARAMS: $3, RET_TYPE: $6, BODY: $7 }
                  / KW_MOVE PIPE param_list? PIPE block
                 => { CODE: CLOSURE_EXPR, IS_MOVE: 1, PARAMS: $3, BODY: $5 }
                  / OR ARROW type_ref block
                 => { CODE: CLOSURE_EXPR, RET_TYPE: $3, BODY: $4 }
                  / OR block
                 => { CODE: CLOSURE_EXPR, BODY: $2 }
                  / PIPE param_list? PIPE ARROW type_ref block
                 => { CODE: CLOSURE_EXPR, PARAMS: $2, RET_TYPE: $5, BODY: $6 }
                  / PIPE param_list? PIPE block
                 => { CODE: CLOSURE_EXPR, PARAMS: $2, BODY: $4 }

    // ── Parenthesised expression ──────────────────────────────────
    paren_expr <- LPAREN expr RPAREN
               => { CODE: PAREN_EXPR, VALUE: $2 }

    // ── Type parameter list: <T, U: Bound1 + Bound2> ─────────────
    // Also used for specialisation patterns: <i32>, <*T>, <[T; 4]>, etc.
    // Detection (TypeVar vs concrete) is done in sema, not in the grammar.
    type_param_list <- LT type_param (COMMA type_param)* GT
                    => { ITEMS: $... }

    trait_bound <- IDENT LT type_arg_list GT_TYPE
                => { CODE: TRAIT_BOUND, NAME: $1, TYPE_PARAMS: $3 }
                 / IDENT
                => { CODE: TRAIT_BOUND, NAME: $1 }

    // Lifetime parameter: 'a
    lifetime_param <- LIFETIME
                   => { CODE: LIFETIME_PARAM, NAME: $1 }

    type_param <- lifetime_param
                / ptr_type
                / arr_type
                / KW_CONST IDENT COLON type_ref
               => { CODE: CONST_PARAM, NAME: $2, TYPE: $4 }
                / IDENT DOTDOTDOT COLON trait_bound (PLUS trait_bound)*
               => { CODE: TYPE_PARAM, NAME: $1, IS_VARIADIC: true, ITEMS: $... }
                / IDENT DOTDOTDOT
               => { CODE: TYPE_PARAM, NAME: $1, IS_VARIADIC: true }
                / IDENT COLON trait_bound (PLUS trait_bound)*
               => { CODE: TYPE_PARAM, NAME: $1, ITEMS: $... }
                / IDENT
               => { CODE: TYPE_PARAM, NAME: $1 }

    // ── Type argument list (for generic instantiation in types): Vec<i32> ─
    type_arg_list <- type_or_lt_arg (COMMA type_or_lt_arg)*
                  => { ITEMS: $... }

    // ── Value argument list (for call sites) ─────────────────────
    call_arg_list <- expr (COMMA expr)*
                  => { ITEMS: $... }

    // ── Free function call: fn(args) or fn::<T>(args) or Class::method(args) ─
    //                       or Class::<T>::method(args) — turbofish on the type.
    call_expr <- IDENT COLONCOLON LT type_arg_list GT_TYPE COLONCOLON IDENT LPAREN call_arg_list? RPAREN
              => { CODE: STATIC_CALL, RECEIVER: $1, TYPE_PARAMS: $4, NAME: $7, ARGS: $9 }
               / IDENT COLONCOLON LT type_arg_list GT_TYPE COLONCOLON KW_NEW LPAREN call_arg_list? RPAREN
              => { CODE: STATIC_CALL, RECEIVER: $1, TYPE_PARAMS: $4, NAME: $7, ARGS: $9 }
               / IDENT COLONCOLON LT type_arg_list GT_TYPE LPAREN call_arg_list? RPAREN
              => { CODE: GENERIC_CALL, CALLEE: $1, TYPE_PARAMS: $4, ARGS: $7 }
               / IDENT COLONCOLON IDENT  LPAREN call_arg_list? RPAREN
              => { CODE: STATIC_CALL, RECEIVER: $1, NAME: $3, ARGS: $5 }
               / IDENT COLONCOLON KW_NEW LPAREN call_arg_list? RPAREN
              => { CODE: STATIC_CALL, RECEIVER: $1, NAME: $3, ARGS: $5 }
               / IDENT LPAREN (expr (COMMA expr)*)? RPAREN
              => { CODE: CALL, CALLEE: $1, ARGS: $... }
}
