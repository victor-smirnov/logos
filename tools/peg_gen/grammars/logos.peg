//
// Logos language grammar — Iteration 3.
//
// Rust-like syntax. Packages, use declarations, extern fn, pub visibility,
// string literals, pointer types, free functions, let, if/else, return,
// while loops, assignment, structs with fields and methods, field access,
// method calls, struct literals, parenthesised expressions.

%meta {
    name:      "logos"
    version:   "0.3"
    namespace: "logos::compiler"
    output:    "logos_parser"
}

%export { module }

// ── AST field keys ────────────────────────────────────────────────────────
%fields {
    CODE        = 0
    NAME        = 1
    ITEMS       = 2
    TYPE        = 3
    PARAMS      = 4
    BODY        = 5
    RET_TYPE    = 6
    VALUE       = 7
    COND        = 8
    THEN        = 9
    ELSE        = 10
    OP          = 11
    LHS         = 12
    RHS         = 13
    CALLEE      = 14
    ARGS        = 15
    PATH        = 16
    USES        = 17
    POINTEE     = 18
    MUTPTR      = 19
    RECEIVER    = 20
    FIELD       = 21
    FIELDS      = 22
    SIZE        = 23
    SRC_LINE    = 24
}

// ── AST node codes ────────────────────────────────────────────────────────
%nodes {
    MODULE      = 1
    PACKAGE     = 2
    USE         = 3
    FN          = 10
    EXTERN_FN   = 11
    PARAM       = 12
    BLOCK       = 20
    LET         = 21
    RETURN      = 22
    IF          = 23
    EXPR_STMT   = 24
    CALL        = 30
    BINOP       = 31
    VAR_REF     = 32
    LIT_INT     = 33
    LIT_BOOL    = 34
    LIT_STR     = 35
    TYPE_REF    = 40
    PTR_TYPE    = 41
    STRUCT      = 50
    FIELD_DEF   = 51
    FIELD_INIT  = 52
    STRUCT_LIT  = 53
    FIELD_READ  = 54
    FIELD_WRITE = 55
    METHOD_CALL = 56
    ASSIGN      = 57
    WHILE       = 58
    DEREF       = 59
    PAREN_EXPR  = 60
    UNARY       = 61
    INDEX_READ  = 62
    INDEX_WRITE = 63
    ARR_TYPE    = 64
    ARR_LIT     = 65
}

// ── Tokens ────────────────────────────────────────────────────────────────
%tokens {
    // Keywords (longest-match first within same length)
    KW_PACKAGE  = "package"
    KW_STRUCT   = "struct"
    KW_EXTERN   = "extern"
    KW_RETURN   = "return"
    KW_WHILE    = "while"
    KW_FALSE    = "false"
    KW_CONST    = "const"
    KW_TRUE     = "true"
    KW_ELSE     = "else"
    KW_USE      = "use"
    KW_MUT      = "mut"
    KW_LET      = "let"
    KW_PUB      = "pub"
    KW_FN       = "fn"
    KW_IF       = "if"

    // Punctuation
    LBRACE      = "{"
    RBRACE      = "}"
    LBRACKET    = "["
    RBRACKET    = "]"
    LPAREN      = "("
    RPAREN      = ")"
    COLON       = ":"
    COMMA       = ","
    SEMI        = ";"
    ARROW       = "->"
    DOT         = "."
    STAR        = "*"
    AMP         = "&"

    // Operators (multi-char first)
    AND         = "&&"
    OR          = "||"
    EQ          = "=="
    NE          = "!="
    LE          = "<="
    GE          = ">="
    LT          = "<"
    GT          = ">"
    PLUS        = "+"
    MINUS       = "-"
    SLASH       = "/"
    PERCENT     = "%"
    BANG        = "!"
    ASSIGN      = "="

    // Literals & identifiers
    STRING      = /"([^"\\]|\\.)*"/
    INTEGER     = /[-]?[0-9]+/
    IDENT       = /[a-zA-Z_][a-zA-Z0-9_]*/

    // Skip
    %skip       = /[ \t\n\r]+/
    %skip       = /\/\/[^\n]*/
    %skip       = /\/\*.*?\*\//
}

// ── Rules ─────────────────────────────────────────────────────────────────
%rules {

    // ── Top level ────────────────────────────────────────────────
    module <- KW_PACKAGE IDENT DOT IDENT SEMI use_decl* item*
           => { CODE: MODULE, NAME: $2, PATH: $4, USES: $6, ITEMS: $... }
            / KW_PACKAGE IDENT SEMI use_decl* item*
           => { CODE: MODULE, NAME: $2, USES: $4, ITEMS: $... }

    use_decl <- KW_USE IDENT DOT IDENT SEMI
             => { CODE: USE, NAME: $2, PATH: $4 }

    item <- struct_def / extern_fn_def / pub_fn_def / fn_def

    // ── Struct definition ────────────────────────────────────────
    struct_def <- KW_STRUCT IDENT LBRACE field_def* method_def* RBRACE
               => { CODE: STRUCT, NAME: $2, FIELDS: $4, ITEMS: $5 }

    field_def <- IDENT COLON type_ref SEMI
              => { CODE: FIELD_DEF, NAME: $1, TYPE: $3 }

    // method_def: passthrough — pub_fn_def or fn_def (each has its own action)
    method_def <- pub_fn_def / fn_def

    // ── Extern function (FFI) ────────────────────────────────────
    extern_fn_def <- KW_EXTERN KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref SEMI
                  => { CODE: EXTERN_FN, NAME: $3, PARAMS: $5, RET_TYPE: $8 }
                   / KW_EXTERN KW_FN IDENT LPAREN param_list? RPAREN SEMI
                  => { CODE: EXTERN_FN, NAME: $3, PARAMS: $5 }

    // ── Public function ──────────────────────────────────────────
    pub_fn_def <- KW_PUB KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
               => { CODE: FN, NAME: $3, PARAMS: $5, RET_TYPE: $8, BODY: $9 }
                / KW_PUB KW_FN IDENT LPAREN param_list? RPAREN block
               => { CODE: FN, NAME: $3, PARAMS: $5, BODY: $7 }

    // ── Private function ─────────────────────────────────────────
    fn_def <- KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
           => { CODE: FN, NAME: $2, PARAMS: $4, RET_TYPE: $7, BODY: $8 }
            / KW_FN IDENT LPAREN param_list? RPAREN block
           => { CODE: FN, NAME: $2, PARAMS: $4, BODY: $6 }

    param_list <- param (COMMA param)*
              => { ITEMS: $... }

    param <- IDENT COLON type_ref
          => { CODE: PARAM, NAME: $1, TYPE: $3 }

    // ── Type reference ───────────────────────────────────────────
    type_ref <- ptr_type / arr_type / simple_type

    ptr_type <- STAR KW_CONST simple_type
             => { CODE: PTR_TYPE, POINTEE: $3, MUTPTR: false }
              / STAR KW_MUT simple_type
             => { CODE: PTR_TYPE, POINTEE: $3, MUTPTR: true }

    // [T; N] — fixed-size array type
    arr_type <- LBRACKET simple_type SEMI INTEGER RBRACKET
             => { CODE: ARR_TYPE, TYPE: $2, SIZE: $4 }

    simple_type <- IDENT
                => { CODE: TYPE_REF, NAME: $1 }

    // ── Block ────────────────────────────────────────────────────
    block <- LBRACE stmt* RBRACE
          => { CODE: BLOCK, ITEMS: $... }

    // ── Statements ───────────────────────────────────────────────
    stmt <- let_stmt
          / while_stmt
          / return_stmt
          / if_expr
          / field_write_stmt
          / index_write_stmt
          / assign_stmt
          / expr SEMI
            => { CODE: EXPR_STMT, VALUE: $1 }

    // arr[idx] = expr;
    index_write_stmt <- IDENT LBRACKET expr RBRACKET ASSIGN expr SEMI
                     => { CODE: INDEX_WRITE, NAME: $1, LHS: $3, VALUE: $6 }

    let_stmt <- KW_LET IDENT COLON type_ref ASSIGN expr SEMI
             => { CODE: LET, NAME: $2, TYPE: $4, VALUE: $6 }
              / KW_LET IDENT ASSIGN expr SEMI
             => { CODE: LET, NAME: $2, VALUE: $4 }

    while_stmt <- KW_WHILE expr block
               => { CODE: WHILE, COND: $2, BODY: $3 }

    return_stmt <- KW_RETURN expr? SEMI
                => { CODE: RETURN, VALUE: $2 }

    assign_stmt <- IDENT ASSIGN expr SEMI
                => { CODE: ASSIGN, NAME: $1, VALUE: $3 }

    field_write_stmt <- IDENT DOT IDENT ASSIGN expr SEMI
                     => { CODE: FIELD_WRITE, RECEIVER: $1, FIELD: $3, VALUE: $5 }

    if_expr <- KW_IF expr block KW_ELSE (if_expr / block)
            => { CODE: IF, COND: $2, THEN: $3, ELSE: $5 }
             / KW_IF expr block
            => { CODE: IF, COND: $2, THEN: $3 }

    // ── Expressions (precedence via rule nesting) ─────────────────
    // Each binary level is deliberately non-associative: chains require
    // explicit parentheses, e.g. (a + b) + c.  This keeps the grammar
    // unambiguous and easy for LLMs to reason about.
    expr <- log_expr

    log_expr <- cmp_expr (AND / OR) cmp_expr
                => { CODE: BINOP, OP: $2, LHS: $1, RHS: $3 }
              / cmp_expr

    cmp_expr <- add_expr (EQ / NE / LE / GE / LT / GT) add_expr
                => { CODE: BINOP, OP: $2, LHS: $1, RHS: $3 }
              / add_expr

    add_expr <- mul_expr (PLUS / MINUS) mul_expr
                => { CODE: BINOP, OP: $2, LHS: $1, RHS: $3 }
              / mul_expr

    // unary_expr inserted between mul_expr and atom for prefix ops
    mul_expr <- unary_expr (STAR / SLASH / PERCENT) unary_expr
                => { CODE: BINOP, OP: $2, LHS: $1, RHS: $3 }
              / unary_expr

    unary_expr <- STAR  unary_expr => { CODE: DEREF,  VALUE: $2 }
                / MINUS unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / BANG  unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / AMP   unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / atom

    // ── Atoms ────────────────────────────────────────────────────
    // Order matters: more-specific patterns before plain IDENT.
    atom <- method_call_expr   // IDENT.IDENT(args)  — before field_read
          / field_read_expr    // IDENT.IDENT         — before plain IDENT
          / index_read_expr    // IDENT[expr]         — before call and var_ref
          / call_expr          // IDENT(args)         — before plain IDENT
          / struct_lit         // IDENT { fields }    — before plain IDENT
          / arr_lit            // [e1, e2, ...]
          / paren_expr         // (expr)
          / STRING     => { CODE: LIT_STR,  VALUE: $1 }
          / KW_TRUE    => { CODE: LIT_BOOL, VALUE: true }
          / KW_FALSE   => { CODE: LIT_BOOL, VALUE: false }
          / INTEGER    => { CODE: LIT_INT,  VALUE: $1 }
          / IDENT      => { CODE: VAR_REF,  NAME: $1 }

    // ── Method call: receiver.method(args) ───────────────────────
    method_call_expr <- IDENT DOT IDENT LPAREN (expr (COMMA expr)*)? RPAREN
                     => { CODE: METHOD_CALL, RECEIVER: $1, NAME: $3, ARGS: $... }

    // ── Field read: receiver.field ────────────────────────────────
    field_read_expr <- IDENT DOT IDENT
                    => { CODE: FIELD_READ, RECEIVER: $1, FIELD: $3 }

    // ── Struct literal: TypeName { field: expr, ... } ─────────────
    struct_lit <- IDENT LBRACE (field_init (COMMA field_init)*)? RBRACE
               => { CODE: STRUCT_LIT, NAME: $1, ITEMS: $... }

    field_init <- IDENT COLON expr
               => { CODE: FIELD_INIT, NAME: $1, VALUE: $3 }

    // ── Array subscript read: arr[i] ─────────────────────────────
    index_read_expr <- IDENT LBRACKET expr RBRACKET
                    => { CODE: INDEX_READ, NAME: $1, VALUE: $3 }

    // ── Array literal: [e1, e2, ...] ─────────────────────────────
    arr_lit <- LBRACKET (expr (COMMA expr)*)? RBRACKET
            => { CODE: ARR_LIT, ITEMS: $... }

    // ── Parenthesised expression ──────────────────────────────────
    paren_expr <- LPAREN expr RPAREN
               => { CODE: PAREN_EXPR, VALUE: $2 }

    // ── Free function call: fn(args) ─────────────────────────────
    call_expr <- IDENT LPAREN (expr (COMMA expr)*)? RPAREN
              => { CODE: CALL, CALLEE: $1, ARGS: $... }
}
