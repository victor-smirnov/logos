// Logos project — https://github.com/victor-smirnov/logos
//
// Logos language grammar — Iteration 3.
//
// Rust-like syntax. Packages, use declarations, extern fn, pub visibility,
// string literals, pointer types, free functions, let, if/else, return,
// while loops, assignment, structs with fields and methods, field access,
// method calls, struct literals, parenthesised expressions.

%meta {
    name:      "logos"
    version:   "0.3"
    namespace: "logos::compiler"
    output:    "logos_parser"
}

%export { module }

// ── AST field keys ────────────────────────────────────────────────────────
%fields {
    CODE        = 0
    NAME        = 1
    ITEMS       = 2
    TYPE        = 3
    PARAMS      = 4
    BODY        = 5
    RET_TYPE    = 6
    VALUE       = 7
    COND        = 8
    THEN        = 9
    ELSE        = 10
    OP          = 11
    LHS         = 12
    RHS         = 13
    CALLEE      = 14
    ARGS        = 15
    USES        = 17
    POINTEE     = 18
    MUTPTR      = 19
    RECEIVER    = 20
    FIELD       = 21
    FIELDS      = 22
    SIZE        = 23
    SRC_LINE    = 24
    IS_MUT      = 25
    INCLUSIVE   = 26
    TYPE_PARAMS = 27
    PARENT      = 28
    IS_AUTO     = 29
    IS_VARARG   = 30
    ITER        = 31
    IS_VARIADIC = 32
    IS_PUB      = 33
    PAT         = 34
    GUARD       = 35
    EXPR        = 36
    NAMES       = 37
    WHERE          = 38
    IS_CONST       = 39
    LIFETIME       = 40
    IMPL_TYPE_PARAMS = 41
    IS_UNSAFE      = 42
    INDEX          = 43
    IS_MOVE        = 44
    IS_REF         = 45
    BASE           = 46
    LABEL          = 47
    SUPERS         = 48
    LO_NEG         = 49
    HI_NEG         = 50
    KEY            = 51    // map key in HERMES_ENTRY
    IS_NEGATIVE    = 43    // negative impl marker (impl !Trait for X {}); reuses INDEX slot — IMPL_BLOCK never has INDEX
    HRTB_BINDERS   = 41    // `for<'a, 'b>` binder list on a TRAIT_BOUND (reuses IMPL_TYPE_PARAMS slot — trait bounds never carry impl-type-params). Value is a sub-node with ITEMS=[LIFETIME_PARAM...].
    PATH           = 22    // sub-node carrying ITEMS=[str,...] for N-deep chain field write (reuses FIELDS slot — chain stmts never carry struct field defs)
    NAME_VAR       = 38    // antiquot var name for `#ident` placeholder inside quote_*! body (reuses WHERE slot — STRUCT/ENUM/FN never have a where_clause AND a NAME_VAR simultaneously: NAME_VAR exists only inside quote_*! bodies, where where_clause is parsed separately)
    META           = 16    // meta @{...} block on struct/datatype/trait declarations (slot 16; reuses PATH_PARTS slot, mutually exclusive node types)
    RAW_TEXT       = 7     // raw source text captured from a balanced delim group on FN_MACRO_CALL (reuses VALUE slot — fn-macro nodes never carry a literal payload)
    // ── Group: mod ────────────────────────────────────────────────────────
    // Fields scoped to MODULE and USE nodes.  Slot numbers in a group reuse
    // the same 0..51 space as global fields; peg_gen resolves action field
    // names to this group when the rule is tagged `:group mod:`.
    group mod {
        PATH_PARTS = 16    // array of sub-nodes (one per component after NAME)
    }
    // ── Group: variant ────────────────────────────────────────────────────
    // Fields scoped to VARIANT_DEF / ENUM_LIT_DATA / PAT_VARIANT_DATA nodes.
    // These nodes never carry a loop label, so slot 47 (global LABEL) is
    // safe to reuse here. Grouping the key documents the intent and keeps
    // the global slot space clean.
    group variant {
        IS_STRUCT_SHAPE = 47   // P4-pm-01: struct-shape variant marker
    }
}

// ── AST node codes ────────────────────────────────────────────────────────
%nodes {
    MODULE      = 1
    PACKAGE     = 2
    USE         = 3
    FN          = 10
    EXTERN_FN   = 11
    PARAM       = 12
    BLOCK       = 20
    LET         = 21
    RETURN      = 22
    IF          = 23
    EXPR_STMT   = 24
    CALL        = 30
    BINOP       = 31
    VAR_REF     = 32
    LIT_INT     = 33
    LIT_BOOL    = 34
    LIT_STR     = 35
    TYPE_REF    = 40
    PTR_TYPE    = 41
    STRUCT      = 50
    FIELD_DEF   = 51
    FIELD_INIT  = 52
    STRUCT_LIT  = 53
    FIELD_READ  = 54
    FIELD_WRITE = 55
    METHOD_CALL = 56
    ASSIGN      = 57
    WHILE       = 58
    DEREF       = 59
    PAREN_EXPR  = 60
    UNARY       = 61
    INDEX_READ  = 62
    INDEX_WRITE = 63
    ARR_TYPE    = 64
    ARR_LIT     = 65
    BREAK       = 66
    CONTINUE    = 67
    LOOP        = 68
    CAST        = 69
    FOR         = 70
    CONST_DEF   = 71
    TYPE_ALIAS  = 72
    ENUM        = 80
    VARIANT_DEF = 81
    MATCH       = 82
    MATCH_ARM   = 83
    PAT_VARIANT = 84
    PAT_WILD    = 85
    ENUM_LIT    = 86
    PAT_INT     = 87
    PAT_BOOL    = 88
    TRAIT_BOUND = 89
    TYPE_PARAM  = 90
    GENERIC_CALL = 91
    GENERIC_INST = 92
    CLASS        = 93
    NEW_EXPR     = 94
    DELETE_STMT  = 95
    ABSTRACT_FN  = 96
    STATIC_FN    = 97
    STATIC_CALL  = 98
    FOR_EACH     = 99
    TUPLE_TYPE   = 100
    TUPLE_LIT    = 101
    TUPLE_INDEX  = 102
    ENUM_LIT_DATA    = 104
    PAT_VARIANT_DATA = 105
    TRAIT_DEF        = 106
    IMPL_BLOCK       = 107
    CLOSURE_EXPR     = 109
    SLICE_TYPE           = 111
    RANGE_EXPR           = 112
    FIELD_INDEX_WRITE    = 113
    ADDR_OF_MUT          = 114
    DEREF_WRITE          = 115
    IMPL_TYPE            = 116
    PACK_EXPAND          = 117
    DYN_TYPE             = 118
    ASSOC_TYPE_DEF       = 119
    ASSOC_TYPE_IMPL      = 120
    ASSOC_TYPE_REF       = 121
    TRY_EXPR             = 122
    LET_DESTRUCT         = 123
    WHERE_CLAUSE         = 124
    CLOSURE_TYPE         = 125
    COMPOUND_ASSIGN      = 126
    ARR_FILL_LIT         = 127
    DEREF_FIELD_WRITE    = 128
    REF_TYPE             = 129
    MUT_REF_TYPE         = 130
    LIFETIME_PARAM       = 131
    UNSAFE_BLOCK         = 132
    CONST_PARAM          = 133
    TUPLE_FIELD_WRITE    = 134
    LIT_FLOAT            = 135
    FIELD_COMPOUND_ASSIGN = 136   // s.field op= expr
    INDEX_COMPOUND_ASSIGN = 137   // arr[i] op= expr
    PAT_NEG_INT           = 138   // negative integer literal in pattern: -42
    PAT_OR                = 139   // OR pattern: pat | pat
    FIELD_SHORTHAND       = 140   // struct field shorthand: Point { x, y }
    LET_ELSE              = 141   // let Pat = expr else { block };
    LABELED_LOOP          = 142   // 'label: loop/for/while { }
    PAT_TUPLE             = 143   // tuple pattern: (a, b, c) =>
    FN_PTR_TYPE           = 144   // fn(T) -> R — bare function pointer type
    DEREF_FIELD_COMPOUND_ASSIGN = 145   // (*ptr).field op= expr
    TUPLE_FIELD_COMPOUND_ASSIGN = 146   // var.N op= expr
    FIELD_INDEX_COMPOUND_ASSIGN = 147   // s.field[i] op= expr
    DATATYPE                    = 148   // Hermes datatype definition (C POD layout)
    PAT_UNIT                    = 149   // () unit pattern in match arms
    ANNOTATION                  = 150   // #[name], #[name = val], #[name(args)]
    TAGGED_TYPE                 = 151   // &tagged<TS> Trait — tag-dispatched thin pointer
    ASSOC_CONST_DEF             = 152   // const NAME: T;       in trait
    ASSOC_CONST_IMPL            = 153   // const NAME: T = expr; in impl
    PAT_STRUCT                  = 154   // Point { x, y } struct pattern
    PAT_SLICE                   = 155   // [a, b] or [first, .., last] slice pattern
    PAT_RANGE                   = 156   // 0..=9 inclusive range pattern
    PAT_AT                      = 157   // n @ sub_pat binding
    PAT_REF                     = 158   // &pat or &mut pat reference pattern
    PAT_FIELD                   = 159   // field binding in struct pattern
    PAT_REST                    = 160   // .. rest in struct/slice pattern
    CHAIN_FIELD_WRITE           = 161   // a.b.c = val
    CHAIN_FIELD_COMPOUND_ASSIGN = 162   // a.b.c op= val
    HERMES_MAP                  = 163   // @{k:v,...} or inner {k:v,...} Hermes map literal
    HERMES_ARRAY                = 164   // @[v,...] or inner [v,...] Hermes array literal
    HERMES_STR                  = 165   // string value in Hermes literal
    HERMES_INT                  = 166   // integer value in Hermes literal
    HERMES_FLOAT                = 167   // float value in Hermes literal
    HERMES_BOOL                 = 168   // bool value in Hermes literal
    HERMES_NULL                 = 169   // null value in Hermes literal
    HERMES_ENTRY                = 170   // key:val pair in Hermes map
    HERMES_TYPED_ARRAY          = 171   // @<ElemType>[v,...] — typed dense array literal
    HERMES_NEG_INT              = 172   // negative integer: @-42 or inner -42 in array/map
    HERMES_TYPED_MAP            = 173   // @<K,V>{...} — typed map literal
    HERMES_CAP_IDENT            = 174   // $x — capture identifier; NAME = var name
    HERMES_CAP_EXPR             = 175   // ${expr} — capture expression; VALUE = expr
    HERMES_ARR_TYPE             = 176   // <ElemType>[] type expression; TYPE = elem name
    HERMES_MAP_TYPE             = 177   // <K,V>{} type expression; TYPE = key, RET_TYPE = val
    LIST_COMP                   = 178   // [elem for x in iter (if guard)?]; VALUE=elem, NAME=var, ITER=iter, GUARD?=pred
    MAP_COMP                    = 179   // {k:v for x in iter (if guard)?}; KEY=k, VALUE=v, NAME=var, ITER=iter, GUARD?=pred
    HERMES_LIST_COMP            = 180   // @[elem for x in iter (if guard)?]; VALUE=elem, NAME=var, ITER=iter, GUARD?=pred
    HERMES_MAP_COMP             = 181   // @{k:v for x in iter (if guard)?}; KEY=k, VALUE=v, NAME=var, ITER=iter, GUARD?=pred
    PAT_HERMES_NULL             = 182   // @null pattern
    PAT_HERMES_BOOL             = 183   // @true / @false pattern; VALUE
    PAT_HERMES_INT              = 184   // @<int> or @-<int> pattern; VALUE, IS_NEG
    PAT_HERMES_STR              = 185   // @"..." pattern; VALUE = string literal
    PAT_HERMES_MAP              = 186   // @{k: pat, ...} pattern; ITEMS = entries
    PAT_HERMES_ARR              = 187   // @[pat, ...] pattern; ITEMS = sub-patterns
    PAT_HERMES_MAP_ENTRY        = 188   // entry: KEY = string key, VALUE = sub-pattern
    PAT_HERMES_TYPED_ARR        = 189   // @<T>[..] typed-array type check; TYPE
    PAT_HERMES_TYPED_MAP        = 190   // @<K,V>{..} typed-map type check; TYPE, RET_TYPE?
    TYPEOF_TYPE                 = 191   // typeof(expr) type-position — compile-time type of expr; VALUE = expr AST
    ANNOT_KV                    = 192   // annotation named arg: NAME=key, VALUE=literal
    ANNOT_POS                   = 193   // annotation positional arg: VALUE=literal
    ANNOT_ARR                   = 194   // annotation array literal: ITEMS=literals
    META_BLOCK                  = 195   // meta @{...} block; VALUE=hermes_lit node
    GENOS_DEF                   = 196   // genos declaration (trait with is_genos=true)
    BLOCK_STMT                  = 197   // bare scoping block { stmts... }; BODY = block
    METACALL                    = 198   // metacall <call_expr>; VALUE = inner call AST
    TEMPLATE_DECL               = 199   // `template <decl>` — declaration-as-data; VALUE = wrapped item AST
    QUOTE_ITEM                  = 200   // quote_item! { item* } — typed AST literal; ITEMS = array of item nodes
    QUOTE_EXPR                  = 201   // quote_expr! { expr } — typed AST literal; VALUE = expr node (root carries schema_type_code)
    REPEAT_GROUP                = 202   // #(body)sep* inside quote_*! body; VALUE=body expr, OP=sep code (0=none, 1=comma, 2=&&)
    SIZEOF_PACK                 = 203   // sizeof...(T) — value-position expression yielding pack length as u64; NAME = pack ident
    QUOTE_TY                    = 204   // quote_ty! { type } — typed Type literal; TYPE = inner type AST
    ANTIQUOT_TYPE               = 205   // $ident in a type position; NAME = ident of a Type-valued binding (only legal inside quote_ty!)
    ANTIQUOT_PACK               = 206   // $ident... in a type-arg list; NAME = ident of an Array<Type> binding (only legal inside quote_ty!)
    ASSOC_EQ_BIND               = 207   // Name = Type clause inside trait bound `<...>`; NAME = assoc-type name; TYPE = rhs type AST
    INSTANTIATE_DECL            = 208   // `instantiate Foo<T>;` — pre-instantiation root pin; TYPE = target type, IS_PUB? = lib-site re-export marker
    METACALL_ITEM               = 209   // `metacall <call_expr>;` at module-item position; VALUE = inner call AST. Driver runs the JIT'd callee returning QuoteItemBlob and splices its emitted items via `logos_emit_item_blob_subst`; node is marked consumed after splice.
    METACALL_ITEM_DONE          = 210   // Set by the driver after a METACALL_ITEM has been invoked; sema item-dispatch silently skips. Never parsed.
    HERMES_TYPE_LIT             = 211   // Component-metaprog slice 1: `<type:T>` inside @-literal. NAME = bare type identifier (slice 1: IDENT only). Sema embeds it as a first-class Hermes Type value.
    LIT_HSTATIC                 = 212   // HermesStatic literal at type-arg position: Foo::<@{...}>. VALUE = nested hermes_lit AST. Sema lowers to ConstVar(HermesStatic, hash) with byte-hash identity.
    CFG_SLOT_TYPE               = 213   // Type-position `<type:CFG.SLOT>`: extract the type stored at top-level slot SLOT of HermesStatic CFG (a const-generic param or type alias). NAME = CFG ident, KEY = slot ident. Mono resolves to the slot's `<type:T>` value when CFG becomes concrete.
    GENERIC_REF                 = 214   // `IDENT::<TARGS>` at expression position; CALLEE = ident, TYPE_PARAMS = type_arg_list.
    PAT_FLOAT                   = 215   // float-literal pattern (Sprint 4.2 — B-pt-06; rejected at sema, but parses cleanly).
    PAT_BYTES                   = 216   // byte-string-literal pattern (B-pt-03; reserved, lexer support pending).
    LET_PAT                     = 217   // `let <pattern> = expr;` — irrefutable destructure beyond simple ident/tuple. Sema checks refutability and lowers via match.
    DOUBLE_REF_TYPE             = 218   // `&&T` (Sprint 6.2 — B-ty-07; resolved by sema as nested REF_TYPE).
    DOUBLE_REF_MUT_TYPE         = 219   // `&&mut T` (B-ty-07; resolved as REF_TYPE wrapping MUT_REF_TYPE).
    DEREF_COMPOUND              = 220   // `*p op= val;` — compound assign through bare deref (B-st-04). Sema lowers to deref_write of *p = *p OP val.
    CHAINED_CMP                 = 221   // `a < b < c` (2+ comparators in a row). Sema rejects with "chained comparisons not supported; use `a < b && b < c`" (B-ex-08).
    PAREN_TYPE                  = 222   // `(T)` — paren-wrapped type expression (B-ty-09). Sema unwraps to inner; structurally same as T.
    TAIL_EXPR                   = 223   // `expr` (no SEMI) at stmt position; sema synthesizes implicit `return expr` for non-void fns (B-fn-06).
    LIT_CHAR                    = 224   // `'X'` Unicode scalar literal. VALUE = original char-lit text including quotes; sema decodes.
    FN_MACRO_CALL               = 225   // `name!(args)` / `name![args]` — function-style macro. CALLEE = ident, ARGS = expr-list. Sema resolves CALLEE against #[fn_macro] fns; arg ASTs become ExprBlobs.
    FN_MACRO_CALL_ITEM          = 226   // `name!{...}` at module item position. Same shape as FN_MACRO_CALL but routes through metacall_item-style splice (callee returns ItemList / QuoteItemBlob).
    FN_MACRO_CALL_ITEM_DONE     = 227   // set by driver after item-macro splice; sema skips.
    PAT_CHAR                    = 228   // char-literal pattern (`'A'` in match arm). VALUE = original CHAR_LIT text; sema decodes to u32 scalar.
    PAT_CHAR_RANGE              = 229   // char-range pattern (`'a' ..= 'z'`). LHS / RHS = original CHAR_LIT text for each endpoint.
    INVOKE_EXPR                 = 230   // `(expr)(args)` — IIFE / expression-as-callee (P4-pm-16). RECEIVER = callee expression, ARGS = arg-list. Sema routes through closure-call / fn-ptr-call.
    BREAK_EXPR                  = 231   // `break` in expression position (P3-pg-04). Rust-style `!`/Never; sema lowers as a SBreak stmt + Error-typed sentinel expression so surrounding type-checks accept.
    CONTINUE_EXPR               = 232   // `continue` in expression position (P3-pg-04). Same shape as BREAK_EXPR.
    RETURN_EXPR                 = 233   // `return` in expression position (P3-pg-04). Same shape — bare form only (no value).
    LIT_BYTES                   = 234   // P4-pm-07: `b"..."` byte-string literal at expression position. VALUE = raw token text including the `b"…"` quotes; sema decodes escapes and lowers to an `[u8; N]` array literal.
}

// ── Tokens ────────────────────────────────────────────────────────────────
%tokens {
    // Keywords (longest-match first within same length)
    KW_CONTINUE = "continue"
    KW_QUOTE_ITEM = "quote_item"
    KW_QUOTE_EXPR = "quote_expr"
    KW_QUOTE_TY   = "quote_ty"
    KW_TEMPLATE = "template"
    KW_PACKAGE  = "package"
    KW_INSTANTIATE = "instantiate"
    KW_EIDOS = "eidos"
    KW_GENOS    = "genos"
    KW_AUTO     = "auto"
    KW_METACALL = "metacall"
    KW_STATIC   = "static"
    KW_RETURN   = "return"
    KW_EXTERN   = "extern"
    KW_STRUCT   = "struct"
    KW_MATCH    = "match"
    KW_WHILE    = "while"
    KW_BREAK    = "break"
    KW_FALSE    = "false"
    KW_TRAIT    = "trait"
    KW_CONST    = "const"
    KW_TYPE     = "type"
    KW_IMPL     = "impl"
    KW_ENUM     = "enum"
    KW_LOOP     = "loop"
    KW_ELSE     = "else"
    KW_TRUE     = "true"
    KW_FOR      = "for"
    KW_USE      = "use"
    KW_MUT      = "mut"
    KW_LET      = "let"
    KW_DYN      = "dyn"
    KW_TAGGED   = "tagged"
    KW_PUB      = "pub"
    KW_NEW      = "new"
    KW_FN       = "fn"
    KW_IF       = "if"
    KW_IN       = "in"
    KW_AS       = "as"
    KW_WHERE    = "where"
    KW_UNSAFE   = "unsafe"
    KW_MOVE     = "move"
    KW_TYPEOF   = "typeof"
    KW_REF      = "ref"
    KW_NULL     = "null"

    // Reserved (no grammar use yet) — kept for stackless-coroutine path on
    // wasm32/64 where threads/context-switch aren't available.
    KW_ASYNC    = "async"
    KW_AWAIT    = "await"

    // Punctuation
    LBRACE      = "{"
    RBRACE      = "}"
    LBRACKET    = "["
    RBRACKET    = "]"
    LPAREN      = "("
    RPAREN      = ")"
    COLON       = ":"
    COMMA       = ","
    SEMI        = ";"
    ARROW       = "->"
    DOT         = "."
    STAR        = "*"
    AMP         = "&"

    // Operators (multi-char first)
    AND         = "&&"
    OR          = "||"
    EQ          = "=="
    NE          = "!="
    LE          = "<="
    GE          = ">="
    SHL_EQ      = "<<="
    SHR_EQ      = ">>="
    SHL         = "<<"
    SHR         = ">>"
    PLUS_EQ     = "+="
    MINUS_EQ    = "-="
    STAR_EQ     = "*="
    SLASH_EQ    = "/="
    PERCENT_EQ  = "%="
    AMP_EQ      = "&="
    PIPE_EQ     = "|="
    CARET_EQ    = "^="
    PIPE        = "|"
    DOTDOTDOT   = "..."
    DOTDOTEQ    = "..="
    DOTDOT      = ".."
    LT          = "<"
    GT          = ">"
    PLUS        = "+"
    MINUS       = "-"
    SLASH       = "/"
    PERCENT     = "%"
    BANG        = "!"
    QUESTION    = "?"
    ASSIGN      = "="
    FATARROW    = "=>"
    COLONCOLON  = "::"
    CARET       = "^"
    HASH        = "#"
    AT          = "@"
    DOLLAR      = "$"

    // Literals & identifiers
    RAW_STRING  = /r"[^"]*"/
    BYTE_STRING = /b"([^"\\]|\\.)*"/
    STRING      = /"([^"\\]|\\.)*"/
    FLOAT       = /[-]?[0-9][0-9_]*\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?(f32|f64)?/
    INTEGER     = /[-]?(0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+|[0-9][0-9_]*)(i8|i16|i24|i32|i56|i64|i128|u8|u16|u24|u32|u56|u64|u128|usize|isize)?/
    // Char literal — must be matched BEFORE LIFETIME so `'A'` (closing
    // apostrophe present) wins over `'A` (lifetime). codegen.cpp has a
    // hand-coded matcher keyed off the leading `'(` in the pattern.
    // CHAR_LIT body is one of: a `\<x>` escape, or a single Unicode codepoint
    // encoded as 1..4 UTF-8 bytes (regex `[^'\\]` reads byte-by-byte but the
    // hand-coded matcher in tools/peg_gen/src/codegen.cpp consumes the full
    // codepoint). Sema decodes the body back into the scalar value.
    CHAR_LIT    = /'(\\.|[^'\\])'/
    LIFETIME    = /'[a-z_][a-z0-9_]*/
    IDENT       = /[a-zA-Z_][a-zA-Z0-9_]*/

    // Skip
    %skip       = /[ \t\n\r]+/
    %skip       = /\/\/[^\n]*/
    %skip       = /\/\*.*?\*\//
}

// ── Rules ─────────────────────────────────────────────────────────────────
%rules {

    // ── Top level ────────────────────────────────────────────────
    // Package paths: `a`, `a.b`, `a.b.c`, … arbitrary depth.
    // `NAME` is the first component; `PATH_PARTS` is an array of sub-nodes
    // for components 2..N (empty when there's only one component).
    module :group mod: <- KW_PACKAGE IDENT path_dot_ident* SEMI any_use_decl* item*
           => { CODE: MODULE, NAME: $2, PATH_PARTS: $3, USES: $5, ITEMS: $... }

    any_use_decl <- pub_use_decl / use_decl

    pub_use_decl :group mod: <- KW_PUB KW_USE IDENT path_dot_ident* SEMI
                 => { CODE: USE, IS_PUB: 1, NAME: $3, PATH_PARTS: $4 }

    use_decl :group mod: <- KW_USE IDENT path_dot_ident* SEMI
             => { CODE: USE, NAME: $2, PATH_PARTS: $3 }

    path_dot_ident <- DOT IDENT
                   => { NAME: $2 }

    item <- template_decl / annotation / const_def / type_alias / pub_enum_def / enum_def / pub_datatype_def / datatype_def / pub_datatype_inst / datatype_inst / pub_trait_inst / trait_inst / pub_struct_inst / struct_inst / pub_instantiate_decl / instantiate_decl / metacall_item_decl / fn_macro_item_decl / pub_struct_def / struct_def / pub_trait_def / trait_def / impl_block / extern_fn_def / pub_fn_def / fn_def

    // Slice 6 of fn-macros — item-position macro invocation. Brace
    // delimiter only (parens / brackets stay at expression position).
    // RAW_TEXT capture identical to FN_MACRO_CALL; sema dispatches
    // through the metacall-item pipeline (callee returns ItemList).
    fn_macro_item_decl <- IDENT BANG RAW_GROUP_BRACE
                       => { CODE: FN_MACRO_CALL_ITEM, CALLEE: $1, RAW_TEXT: $3 }

    // ── Item-position metacall ───────────────────────────────────
    // `metacall foo::<...>(...);` at module top level. The callee returns
    // a `QuoteItemBlob` (typed AST item-blob); the driver runs the JIT'd
    // thunk, which calls `logos_emit_item_blob_subst` to splice the items
    // into the program. METACALL_ITEM node is marked consumed after splice.
    metacall_item_decl <- KW_METACALL call_expr SEMI
                       => { CODE: METACALL_ITEM, VALUE: $2 }

    // ── Explicit instantiation (root-pin) ────────────────────────
    // `instantiate Foo<T>;` materializes Foo<T> as a root for monomorphization
    // (analog of C++ `template class Foo<int>;`). All inherent + trait methods
    // become roots, and the worklist transitively pulls everything they call.
    // `pub instantiate Foo<T>;` additionally marks the instance as part of the
    // package's public API surface (lib-site re-export); semantically identical
    // until separate codegen lands.
    pub_instantiate_decl <- KW_PUB KW_INSTANTIATE type_ref SEMI
                         => { CODE: INSTANTIATE_DECL, IS_PUB: 1, TYPE: $3 }

    instantiate_decl <- KW_INSTANTIATE type_ref SEMI
                     => { CODE: INSTANTIATE_DECL, TYPE: $2 }

    // ── Template declaration ─────────────────────────────────────
    // `template <item>` marks the wrapped declaration as data, not a real
    // binding. INNER carries the unmodified item AST (struct/enum/impl/fn/
    // trait), to be consumed by metafunctions via apply / metacall.
    // Slice 1 — only syntax + AST node; sema skips templates entirely
    // (their inner names never get registered, so referencing them as
    // types yields the standard "unknown type" diagnostic).
    template_decl <- KW_TEMPLATE template_inner
                  => { CODE: TEMPLATE_DECL, VALUE: $2 }

    template_inner <- pub_struct_def / struct_def
                    / pub_enum_def / enum_def
                    / pub_datatype_def / datatype_def
                    / pub_trait_def / trait_def
                    / impl_block
                    / pub_fn_def / fn_def

    // ── Annotations ──────────────────────────────────────────────
    // #[name(arg1, arg2)]      — annotation with identifier arguments
    // #[name = 123]            — annotation with integer value
    // #[name = Enum::Variant]  — annotation with enum-variant value
    // #[name]                  — simple flag annotation
    annotation <- HASH LBRACKET IDENT LPAREN annot_args RPAREN RBRACKET
               => { CODE: ANNOTATION, NAME: $3, ARGS: $5 }
                / HASH LBRACKET IDENT ASSIGN annot_val RBRACKET
               => { CODE: ANNOTATION, NAME: $3, VALUE: $5 }
                / HASH LBRACKET IDENT RBRACKET
               => { CODE: ANNOTATION, NAME: $3 }

    annot_val <- IDENT COLONCOLON IDENT
              => { CODE: ENUM_LIT, NAME: $1, FIELD: $3 }
               / INTEGER
              => { CODE: LIT_INT, VALUE: $1 }

    // Annotation argument forms:
    //   key = lit          → { CODE: ANNOT_KV, NAME: key, VALUE: lit }
    //   lit                → { CODE: ANNOT_POS, VALUE: lit }
    //   IDENT              → { NAME: ident }   (legacy bare-identifier form; kept for
    //                        #[tag_dispatch(sys_name)]; new code should use literals)
    annot_arg  <- IDENT ASSIGN annot_lit
               => { CODE: ANNOT_KV, NAME: $1, VALUE: $3 }
                / annot_lit
               => { CODE: ANNOT_POS, VALUE: $1 }
                / IDENT
               => { NAME: $1 }

    // Literal values that may appear inside an annotation argument list.
    // Ordering: multi-token forms (enum) first; KW_TRUE/KW_FALSE before IDENT
    // so they don't get swallowed by the bare-ident fallback inside annot_arg.
    annot_lit  <- IDENT COLONCOLON IDENT
               => { CODE: ENUM_LIT, NAME: $1, FIELD: $3 }
                / RAW_STRING => { CODE: LIT_STR, VALUE: $1 }
                / STRING     => { CODE: LIT_STR, VALUE: $1 }
                / FLOAT      => { CODE: LIT_FLOAT, VALUE: $1 }
                / INTEGER    => { CODE: LIT_INT, VALUE: $1 }
                / KW_TRUE    => { CODE: LIT_BOOL, VALUE: true }
                / KW_FALSE   => { CODE: LIT_BOOL, VALUE: false }
                / LBRACKET (annot_lit (COMMA annot_lit)* COMMA?)? RBRACKET
               => { CODE: ANNOT_ARR, ITEMS: $... }

    annot_args <- annot_arg (COMMA annot_arg)* COMMA?
               => { ITEMS: $... }

    // Module-level constants. Two surface forms, same AST:
    //
    //   pub let X: T = expr;            — simple non-generic constant (legacy)
    //   pub const X: T = expr;          — same shape, alternate keyword
    //   pub const X<T1,T2>: T = expr;   — generic compile-time factory.
    //                                     RHS is templated; substitution at
    //                                     each use site materialises a
    //                                     fresh value. Common case: HermesStatic
    //                                     literal parameterised by type args
    //                                     (`pub const PMap<K,V>: HermesStatic =
    //                                     @{"key": <type:K>, "value": <type:V>};`).
    //
    // `pub let` stays non-generic; `pub const` admits an optional type-param
    // list. Both produce CONST_DEF nodes; sema reads TYPE_PARAMS when present.
    const_def <- KW_PUB KW_CONST IDENT type_param_list COLON type_ref ASSIGN expr SEMI
              => { CODE: CONST_DEF, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, TYPE: $6, VALUE: $8 }
               / KW_PUB KW_CONST IDENT COLON type_ref ASSIGN expr SEMI
              => { CODE: CONST_DEF, IS_PUB: 1, NAME: $3, TYPE: $5, VALUE: $7 }
               / KW_CONST IDENT type_param_list COLON type_ref ASSIGN expr SEMI
              => { CODE: CONST_DEF, NAME: $2, TYPE_PARAMS: $3, TYPE: $5, VALUE: $7 }
               / KW_CONST IDENT COLON type_ref ASSIGN expr SEMI
              => { CODE: CONST_DEF, NAME: $2, TYPE: $4, VALUE: $6 }
               / KW_PUB KW_LET IDENT COLON type_ref ASSIGN expr SEMI
              => { CODE: CONST_DEF, IS_PUB: 1, NAME: $3, TYPE: $5, VALUE: $7 }
               / KW_LET IDENT COLON type_ref ASSIGN expr SEMI
              => { CODE: CONST_DEF, NAME: $2, TYPE: $4, VALUE: $6 }

    // static NAME: type = expr;  (module-level mutable static — same repr as const for now)
    // type NAME = type_ref;
    type_alias <- KW_PUB KW_TYPE IDENT type_param_list ASSIGN type_ref SEMI
               => { CODE: TYPE_ALIAS, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, TYPE: $6 }
                / KW_PUB KW_TYPE IDENT ASSIGN type_ref SEMI
               => { CODE: TYPE_ALIAS, IS_PUB: 1, NAME: $3, TYPE: $5 }
                / KW_TYPE IDENT type_param_list ASSIGN type_ref SEMI
               => { CODE: TYPE_ALIAS, NAME: $2, TYPE_PARAMS: $3, TYPE: $5 }
                / KW_TYPE IDENT ASSIGN type_ref SEMI
               => { CODE: TYPE_ALIAS, NAME: $2, TYPE: $4 }

    // ── Enum definition ──────────────────────────────────────────
    // enum Color { Red, Green = 5, Blue }
    // enum Option<T> { Some(T), None }
    // enum Tags : u64 { X = 0xdead }          — explicit backing integer type
    pub_enum_def <- KW_PUB KW_ENUM HASH LPAREN expr RPAREN type_param_list? COLON type_ref LBRACE variant_list? RBRACE
                 => { CODE: ENUM, IS_PUB: 1, NAME_VAR: $5, TYPE_PARAMS: $7, TYPE: $9, ITEMS: $11 }
                  / KW_PUB KW_ENUM HASH LPAREN expr RPAREN type_param_list? LBRACE variant_list? RBRACE
                 => { CODE: ENUM, IS_PUB: 1, NAME_VAR: $5, TYPE_PARAMS: $7, ITEMS: $9 }
                  / KW_PUB KW_ENUM IDENT type_param_list? COLON type_ref LBRACE variant_list? RBRACE
                 => { CODE: ENUM, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, TYPE: $6, ITEMS: $8 }
                  / KW_PUB KW_ENUM IDENT type_param_list? LBRACE variant_list? RBRACE
                 => { CODE: ENUM, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, ITEMS: $6 }

    enum_def <- KW_ENUM HASH LPAREN expr RPAREN type_param_list? COLON type_ref LBRACE variant_list? RBRACE
             => { CODE: ENUM, NAME_VAR: $4, TYPE_PARAMS: $6, TYPE: $8, ITEMS: $10 }
              / KW_ENUM HASH LPAREN expr RPAREN type_param_list? LBRACE variant_list? RBRACE
             => { CODE: ENUM, NAME_VAR: $4, TYPE_PARAMS: $6, ITEMS: $8 }
              / KW_ENUM IDENT type_param_list? COLON type_ref LBRACE variant_list? RBRACE
             => { CODE: ENUM, NAME: $2, TYPE_PARAMS: $3, TYPE: $5, ITEMS: $7 }
              / KW_ENUM IDENT type_param_list? LBRACE variant_list? RBRACE
             => { CODE: ENUM, NAME: $2, TYPE_PARAMS: $3, ITEMS: $5 }

    variant_list <- variant_def (COMMA variant_def)* COMMA?
                 => { ITEMS: $... }


    variant_payload_list <- type_ref (COMMA type_ref)*
                         => { ITEMS: $... }

    // S8-en-02: `X::Y` reference at enum-discriminant position.
    // Carries NAME=enum, FIELD=variant; consumer reads BODY sub-map.
    enum_xref <- IDENT COLONCOLON IDENT
              => { NAME: $1, FIELD: $3 }

    // P4-pm-01: struct-shape variant `Foo { x: T, y: U }`.
    // Reuses variant_struct_field_list to collect FIELD_DEF entries
    // (each carries NAME + TYPE). Sema sets payload_types[] in
    // declaration order and parallel payload_field_names[].
    variant_struct_field <- KW_PUB IDENT COLON type_ref COMMA?
                         => { CODE: FIELD_DEF, IS_PUB: 1, NAME: $2, TYPE: $4 }
                          / IDENT COLON type_ref COMMA?
                         => { CODE: FIELD_DEF, NAME: $1, TYPE: $3 }

    variant_struct_field_list <- variant_struct_field+
                              => { ITEMS: $... }

    variant_def :group variant: <- IDENT LPAREN DOTDOTDOT type_ref RPAREN
                => { CODE: VARIANT_DEF, NAME: $1, IS_VARIADIC: 1, ITEMS: $4 }
                 / IDENT LPAREN variant_payload_list RPAREN
                => { CODE: VARIANT_DEF, NAME: $1, ITEMS: $3 }
                 / IDENT LBRACE variant_struct_field_list RBRACE
                => { CODE: VARIANT_DEF, NAME: $1, IS_STRUCT_SHAPE: 1, ITEMS: $3 }
                 / IDENT ASSIGN MINUS INTEGER
                => { CODE: VARIANT_DEF, NAME: $1, VALUE: $4, LO_NEG: true }
                 / IDENT ASSIGN INTEGER
                => { CODE: VARIANT_DEF, NAME: $1, VALUE: $3 }
                 / IDENT ASSIGN KW_METACALL block
                => { CODE: VARIANT_DEF, NAME: $1, BODY: $4 }
                 // S8-en-02: cross-enum disc reference — `X::Variant (as T)?`.
                 // Stored as a sub-map under BODY with NAME=enum, FIELD=variant
                 // so the disc lowerer can look it up in the already-collected
                 // enums. The `as T` cast suffix is consumed but the type
                 // dropped — width is governed by the enclosing enum's
                 // backing_type / repr.
                 / IDENT ASSIGN enum_xref KW_AS type_ref
                => { CODE: VARIANT_DEF, NAME: $1, BODY: $3 }
                 / IDENT ASSIGN enum_xref
                => { CODE: VARIANT_DEF, NAME: $1, BODY: $3 }
                 / IDENT
                => { CODE: VARIANT_DEF, NAME: $1 }

    // ── Trait definition ─────────────────────────────────────────
    // trait Name { fn method(self: Self) -> T; }
    // trait Foo: Bar + Baz — optional supertrait bound list after colon
    super_list <- COLON trait_bound (PLUS trait_bound)*
               => { ITEMS: $... }

    // `genos` keyword reserved for computable specifications (slice 3β
    // of genos-design.md). Legacy data-trait-family role migrated to
    // `pub trait` + `#[hermes_eidos]` annotation. Keyword and
    // GENOS_DEF AST code retained for the upcoming spec form.
    trait_kw <- KW_TRAIT

    pub_trait_def <- KW_PUB KW_AUTO trait_kw IDENT type_param_list super_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_AUTO: 1, NAME: $4, TYPE_PARAMS: $5, SUPERS: $6, ITEMS: $... }
                  / KW_PUB KW_AUTO trait_kw IDENT type_param_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_AUTO: 1, NAME: $4, TYPE_PARAMS: $5, ITEMS: $... }
                  / KW_PUB KW_AUTO trait_kw IDENT super_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_AUTO: 1, NAME: $4, SUPERS: $5, ITEMS: $... }
                  / KW_PUB KW_AUTO trait_kw IDENT LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_AUTO: 1, NAME: $4, ITEMS: $... }
                  / KW_PUB KW_UNSAFE trait_kw IDENT type_param_list super_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, TYPE_PARAMS: $5, SUPERS: $6, ITEMS: $... }
                  / KW_PUB KW_UNSAFE trait_kw IDENT type_param_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, TYPE_PARAMS: $5, ITEMS: $... }
                  / KW_PUB KW_UNSAFE trait_kw IDENT super_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, SUPERS: $5, ITEMS: $... }
                  / KW_PUB KW_UNSAFE trait_kw IDENT LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, ITEMS: $... }
                  / KW_PUB trait_kw IDENT type_param_list super_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, SUPERS: $5, ITEMS: $... }
                  / KW_PUB trait_kw IDENT type_param_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, ITEMS: $... }
                  / KW_PUB trait_kw IDENT super_list LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, NAME: $3, SUPERS: $4, ITEMS: $... }
                  / KW_PUB trait_kw IDENT LBRACE trait_method* RBRACE
                  => { CODE: TRAIT_DEF, IS_PUB: 1, NAME: $3, ITEMS: $... }

    trait_def <- KW_AUTO trait_kw IDENT type_param_list super_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_AUTO: 1, NAME: $3, TYPE_PARAMS: $4, SUPERS: $5, ITEMS: $... }
              / KW_AUTO trait_kw IDENT type_param_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_AUTO: 1, NAME: $3, TYPE_PARAMS: $4, ITEMS: $... }
              / KW_AUTO trait_kw IDENT super_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_AUTO: 1, NAME: $3, SUPERS: $4, ITEMS: $... }
              / KW_AUTO trait_kw IDENT LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_AUTO: 1, NAME: $3, ITEMS: $... }
              / KW_UNSAFE trait_kw IDENT type_param_list super_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, SUPERS: $5, ITEMS: $... }
              / KW_UNSAFE trait_kw IDENT type_param_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, ITEMS: $... }
              / KW_UNSAFE trait_kw IDENT super_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_UNSAFE: 1, NAME: $3, SUPERS: $4, ITEMS: $... }
              / KW_UNSAFE trait_kw IDENT LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, IS_UNSAFE: 1, NAME: $3, ITEMS: $... }
              / trait_kw IDENT type_param_list super_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, NAME: $2, TYPE_PARAMS: $3, SUPERS: $4, ITEMS: $... }
              / trait_kw IDENT type_param_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, NAME: $2, TYPE_PARAMS: $3, ITEMS: $... }
              / trait_kw IDENT super_list LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, NAME: $2, SUPERS: $3, ITEMS: $... }
              / trait_kw IDENT LBRACE trait_method* RBRACE
              => { CODE: TRAIT_DEF, NAME: $2, ITEMS: $... }

    trait_method <- KW_UNSAFE KW_FN IDENT type_param_list LPAREN param_list? RPAREN ARROW type_ref block
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9, BODY: $10 }
                  / KW_UNSAFE KW_FN IDENT type_param_list LPAREN param_list? RPAREN ARROW type_ref SEMI
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9 }
                  / KW_UNSAFE KW_FN IDENT type_param_list LPAREN param_list? RPAREN block
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, BODY: $8 }
                  / KW_UNSAFE KW_FN IDENT type_param_list LPAREN param_list? RPAREN SEMI
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6 }
                  / KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, PARAMS: $5, RET_TYPE: $8, BODY: $9 }
                  / KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref SEMI
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, PARAMS: $5, RET_TYPE: $8 }
                  / KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN block
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, PARAMS: $5, BODY: $7 }
                  / KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN SEMI
                 => { CODE: FN, IS_UNSAFE: 1, NAME: $3, PARAMS: $5 }
                  / KW_FN IDENT type_param_list LPAREN param_list? RPAREN ARROW type_ref block
                 => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, RET_TYPE: $8, BODY: $9 }
                  / KW_FN IDENT type_param_list LPAREN param_list? RPAREN ARROW type_ref SEMI
                 => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, RET_TYPE: $8 }
                  / KW_FN IDENT type_param_list LPAREN param_list? RPAREN block
                 => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, BODY: $7 }
                  / KW_FN IDENT type_param_list LPAREN param_list? RPAREN SEMI
                 => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5 }
                  / KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
                 => { CODE: FN, NAME: $2, PARAMS: $4, RET_TYPE: $7, BODY: $8 }
                  / KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref SEMI
                 => { CODE: FN, NAME: $2, PARAMS: $4, RET_TYPE: $7 }
                  / KW_FN IDENT LPAREN param_list? RPAREN block
                 => { CODE: FN, NAME: $2, PARAMS: $4, BODY: $6 }
                  / KW_FN IDENT LPAREN param_list? RPAREN SEMI
                 => { CODE: FN, NAME: $2, PARAMS: $4 }
                  / KW_FN KW_NEW LPAREN param_list? RPAREN ARROW type_ref block
                 => { CODE: FN, NAME: $2, PARAMS: $4, RET_TYPE: $7, BODY: $8 }
                  / KW_FN KW_NEW LPAREN param_list? RPAREN ARROW type_ref SEMI
                 => { CODE: FN, NAME: $2, PARAMS: $4, RET_TYPE: $7 }
                  / KW_FN KW_NEW LPAREN param_list? RPAREN block
                 => { CODE: FN, NAME: $2, PARAMS: $4, BODY: $6 }
                  / KW_FN KW_NEW LPAREN param_list? RPAREN SEMI
                 => { CODE: FN, NAME: $2, PARAMS: $4 }
                  / KW_FN KW_NULL LPAREN param_list? RPAREN ARROW type_ref block
                 => { CODE: FN, NAME: $2, PARAMS: $4, RET_TYPE: $7, BODY: $8 }
                  / KW_FN KW_NULL LPAREN param_list? RPAREN ARROW type_ref SEMI
                 => { CODE: FN, NAME: $2, PARAMS: $4, RET_TYPE: $7 }
                  / KW_FN KW_NULL LPAREN param_list? RPAREN block
                 => { CODE: FN, NAME: $2, PARAMS: $4, BODY: $6 }
                  / KW_FN KW_NULL LPAREN param_list? RPAREN SEMI
                 => { CODE: FN, NAME: $2, PARAMS: $4 }
                  / KW_TYPE IDENT type_param_list (COLON trait_bound (PLUS trait_bound)*)? SEMI
                 => { CODE: ASSOC_TYPE_DEF, NAME: $2, TYPE_PARAMS: $3, ITEMS: $... }
                  / KW_TYPE IDENT (COLON trait_bound (PLUS trait_bound)*)? SEMI
                 => { CODE: ASSOC_TYPE_DEF, NAME: $2, ITEMS: $... }
                  / KW_CONST IDENT COLON type_ref SEMI
                 => { CODE: ASSOC_CONST_DEF, NAME: $2, TYPE: $4 }

    // ── Impl block ──────────────────────────────────────────────
    // impl Trait for Type { fn method(...) { ... } }
    // impl Type { fn method(...) { ... } }   — standalone (no trait)
    // impl<T> Trait for Struct<T> { ... }   — generic trait impl
    impl_block <- KW_UNSAFE KW_IMPL type_param_list IDENT LT type_arg_list GT_TYPE KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, IMPL_TYPE_PARAMS: $3, NAME: $4, TYPE_PARAMS: $6, TYPE: $9, ITEMS: $... }
                / KW_UNSAFE KW_IMPL type_param_list IDENT KW_FOR ptr_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, IMPL_TYPE_PARAMS: $3, NAME: $4, TYPE: $6, ITEMS: $... }
                / KW_UNSAFE KW_IMPL type_param_list IDENT KW_FOR ref_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, IMPL_TYPE_PARAMS: $3, NAME: $4, TYPE: $6, ITEMS: $... }
                / KW_UNSAFE KW_IMPL type_param_list IDENT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, IMPL_TYPE_PARAMS: $3, NAME: $4, TYPE: $6, ITEMS: $... }
                / KW_UNSAFE KW_IMPL IDENT LT type_arg_list GT_TYPE KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $5, TYPE: $8, ITEMS: $... }
                / KW_UNSAFE KW_IMPL IDENT KW_FOR ptr_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_UNSAFE KW_IMPL IDENT KW_FOR ref_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_UNSAFE KW_IMPL IDENT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_UNSAFE KW_IMPL type_param_list simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, TYPE_PARAMS: $3, TYPE: $4, ITEMS: $... }
                / KW_UNSAFE KW_IMPL simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IS_UNSAFE: 1, TYPE: $3, ITEMS: $... }
                // Negative impls: `impl !Trait for Type {}` (empty body).
                / KW_IMPL type_param_list BANG IDENT KW_FOR simple_type LBRACE RBRACE
               => { CODE: IMPL_BLOCK, IS_NEGATIVE: 1, IMPL_TYPE_PARAMS: $2, NAME: $4, TYPE: $6 }
                / KW_IMPL type_param_list BANG IDENT KW_FOR ptr_type LBRACE RBRACE
               => { CODE: IMPL_BLOCK, IS_NEGATIVE: 1, IMPL_TYPE_PARAMS: $2, NAME: $4, TYPE: $6 }
                / KW_IMPL type_param_list BANG IDENT KW_FOR ref_type LBRACE RBRACE
               => { CODE: IMPL_BLOCK, IS_NEGATIVE: 1, IMPL_TYPE_PARAMS: $2, NAME: $4, TYPE: $6 }
                / KW_IMPL BANG IDENT KW_FOR simple_type LBRACE RBRACE
               => { CODE: IMPL_BLOCK, IS_NEGATIVE: 1, NAME: $3, TYPE: $5 }
                / KW_IMPL BANG IDENT KW_FOR ptr_type LBRACE RBRACE
               => { CODE: IMPL_BLOCK, IS_NEGATIVE: 1, NAME: $3, TYPE: $5 }
                / KW_IMPL BANG IDENT KW_FOR ref_type LBRACE RBRACE
               => { CODE: IMPL_BLOCK, IS_NEGATIVE: 1, NAME: $3, TYPE: $5 }
                / KW_IMPL type_param_list IDENT LT type_arg_list GT_TYPE KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IMPL_TYPE_PARAMS: $2, NAME: $3, TYPE_PARAMS: $5, TYPE: $8, ITEMS: $... }
                / KW_IMPL type_param_list IDENT LT type_arg_list GT_TYPE KW_FOR ref_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IMPL_TYPE_PARAMS: $2, NAME: $3, TYPE_PARAMS: $5, TYPE: $8, ITEMS: $... }
                / KW_IMPL type_param_list IDENT KW_FOR ptr_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IMPL_TYPE_PARAMS: $2, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_IMPL type_param_list IDENT KW_FOR ref_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IMPL_TYPE_PARAMS: $2, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_IMPL type_param_list IDENT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, IMPL_TYPE_PARAMS: $2, NAME: $3, TYPE: $5, ITEMS: $... }
                / KW_IMPL IDENT LT type_arg_list GT_TYPE KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, NAME: $2, TYPE_PARAMS: $4, TYPE: $7, ITEMS: $... }
                / KW_IMPL IDENT LT type_arg_list GT_TYPE KW_FOR ref_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, NAME: $2, TYPE_PARAMS: $4, TYPE: $7, ITEMS: $... }
                / KW_IMPL IDENT KW_FOR ptr_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, NAME: $2, TYPE: $4, ITEMS: $... }
                / KW_IMPL IDENT KW_FOR ref_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, NAME: $2, TYPE: $4, ITEMS: $... }
                / KW_IMPL IDENT KW_FOR simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, NAME: $2, TYPE: $4, ITEMS: $... }
                // impl<T> Pair<T> { ... } — standalone impl with own type parameters
                / KW_IMPL type_param_list simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, TYPE_PARAMS: $2, TYPE: $3, ITEMS: $... }
                / KW_IMPL simple_type LBRACE impl_item* RBRACE
               => { CODE: IMPL_BLOCK, TYPE: $2, ITEMS: $... }

    // impl_item: method, associated type, or associated constant definition
    impl_item <- method_def
               / KW_TYPE IDENT type_param_list ASSIGN type_ref SEMI
              => { CODE: ASSOC_TYPE_IMPL, NAME: $2, TYPE_PARAMS: $3, TYPE: $5 }
               / KW_TYPE IDENT ASSIGN type_ref SEMI
              => { CODE: ASSOC_TYPE_IMPL, NAME: $2, TYPE: $4 }
               / KW_CONST IDENT COLON type_ref ASSIGN expr SEMI
              => { CODE: ASSOC_CONST_IMPL, NAME: $2, TYPE: $4, VALUE: $6 }


    // pub static fn name(params) -> ret_type { ... }
    pub_static_fn_def <- KW_PUB KW_STATIC KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
                      => { CODE: STATIC_FN, IS_PUB: 1, IS_UNSAFE: 1, NAME: $5, PARAMS: $7, RET_TYPE: $10, BODY: $11 }
                       / KW_PUB KW_STATIC KW_UNSAFE KW_FN IDENT LPAREN param_list? RPAREN block
                      => { CODE: STATIC_FN, IS_PUB: 1, IS_UNSAFE: 1, NAME: $5, PARAMS: $7, BODY: $9 }
                       / KW_PUB KW_STATIC KW_FN KW_NEW LPAREN param_list? RPAREN ARROW type_ref block
                      => { CODE: STATIC_FN, IS_PUB: 1, NAME: $4, PARAMS: $6, RET_TYPE: $9, BODY: $10 }
                       / KW_PUB KW_STATIC KW_FN KW_NEW LPAREN param_list? RPAREN block
                      => { CODE: STATIC_FN, IS_PUB: 1, NAME: $4, PARAMS: $6, BODY: $8 }
                       / KW_PUB KW_STATIC KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref block
                      => { CODE: STATIC_FN, IS_PUB: 1, NAME: $4, PARAMS: $6, RET_TYPE: $9, BODY: $10 }
                       / KW_PUB KW_STATIC KW_FN IDENT LPAREN param_list? RPAREN block
                      => { CODE: STATIC_FN, IS_PUB: 1, NAME: $4, PARAMS: $6, BODY: $8 }

    // static fn name(params) -> ret_type { ... }
    // 'new' and 'delete' are allowed as method names (common constructor/destructor conventions).
    static_fn_def <- KW_STATIC KW_UNSAFE KW_FN IDENT  LPAREN param_list? RPAREN ARROW type_ref block
                  => { CODE: STATIC_FN, IS_UNSAFE: 1, NAME: $4, PARAMS: $6, RET_TYPE: $9, BODY: $10 }
                   / KW_STATIC KW_UNSAFE KW_FN IDENT  LPAREN param_list? RPAREN block
                  => { CODE: STATIC_FN, IS_UNSAFE: 1, NAME: $4, PARAMS: $6, BODY: $8 }
                   / KW_STATIC KW_FN IDENT  LPAREN param_list? RPAREN ARROW type_ref block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, RET_TYPE: $8, BODY: $9 }
                   / KW_STATIC KW_FN KW_NEW LPAREN param_list? RPAREN ARROW type_ref block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, RET_TYPE: $8, BODY: $9 }
                   / KW_STATIC KW_FN IDENT  LPAREN param_list? RPAREN block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, BODY: $7 }
                   / KW_STATIC KW_FN KW_NEW LPAREN param_list? RPAREN block
                  => { CODE: STATIC_FN, NAME: $3, PARAMS: $5, BODY: $7 }

    // ── Datatype definition (Hermes — C POD layout, no heap types) ──
    pub_datatype_def <- KW_PUB KW_EIDOS IDENT type_param_list? LBRACE field_def* RBRACE
                     => { CODE: DATATYPE, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, FIELDS: $6 }

    datatype_def <- KW_EIDOS IDENT type_param_list? LBRACE field_def* RBRACE
                 => { CODE: DATATYPE, NAME: $2, TYPE_PARAMS: $3, FIELDS: $5 }

    // ── Explicit instantiation declarations (no body) ────────────
    // Binds metadata annotations to a generic instantiation.
    // E.g.: #[type_code=42] datatype Array<i32>;
    pub_datatype_inst <- KW_PUB KW_EIDOS type_ref SEMI
                      => { CODE: DATATYPE, IS_PUB: 1, TYPE: $3 }

    datatype_inst <- KW_EIDOS type_ref SEMI
                  => { CODE: DATATYPE, TYPE: $2 }

    // Explicit genos specialization decl: `#[type_code=N] pub genos Array<i32>;`.
    // Binds annotations (type_code, future metadata) to a logical-family
    // specialization; implementing eidos inherit via impl.
    pub_trait_inst <- KW_PUB trait_kw type_ref SEMI
                   => { CODE: TRAIT_DEF, IS_PUB: 1, TYPE: $3 }

    trait_inst <- trait_kw type_ref SEMI
               => { CODE: TRAIT_DEF, TYPE: $2 }

    // ── Struct definition ────────────────────────────────────────
    // Explicit struct instantiation declaration (binds annotations to generic instantiation).
    pub_struct_inst <- KW_PUB KW_STRUCT type_ref SEMI
                    => { CODE: STRUCT, IS_PUB: 1, TYPE: $3 }

    struct_inst <- KW_STRUCT type_ref SEMI
                => { CODE: STRUCT, TYPE: $2 }

    pub_struct_def <- KW_PUB KW_STRUCT HASH LPAREN expr RPAREN type_param_list? LBRACE field_def* method_def* RBRACE
                   => { CODE: STRUCT, IS_PUB: 1, NAME_VAR: $5, TYPE_PARAMS: $7, FIELDS: $9, ITEMS: $10 }
                    / KW_PUB KW_STRUCT HASH IDENT type_param_list? LBRACE field_def* method_def* RBRACE
                   => { CODE: STRUCT, IS_PUB: 1, NAME_VAR: $4, TYPE_PARAMS: $5, FIELDS: $7, ITEMS: $8 }
                    / KW_PUB KW_STRUCT IDENT type_param_list? LBRACE field_def* method_def* RBRACE
                   => { CODE: STRUCT, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, FIELDS: $6, ITEMS: $7 }
                    / KW_PUB KW_STRUCT IDENT LPAREN tuple_field (COMMA tuple_field)* RPAREN SEMI
                   => { CODE: STRUCT, IS_PUB: 1, NAME: $3, FIELDS: $... }

    struct_def <- KW_STRUCT HASH LPAREN expr RPAREN type_param_list? LBRACE field_def* method_def* RBRACE
               => { CODE: STRUCT, NAME_VAR: $4, TYPE_PARAMS: $6, FIELDS: $8, ITEMS: $9 }
                / KW_STRUCT HASH IDENT type_param_list? LBRACE field_def* method_def* RBRACE
               => { CODE: STRUCT, NAME_VAR: $3, TYPE_PARAMS: $4, FIELDS: $6, ITEMS: $7 }
                / KW_STRUCT IDENT type_param_list? LPAREN tuple_field (COMMA tuple_field)* RPAREN SEMI
               => { CODE: STRUCT, NAME: $2, FIELDS: $... }
                / KW_STRUCT IDENT type_param_list? LBRACE field_def* method_def* RBRACE
               => { CODE: STRUCT, NAME: $2, TYPE_PARAMS: $3, FIELDS: $5, ITEMS: $6 }

    // B-ts-01: tuple-struct fields — types only, no field names.
    // Sema synthesises field names "0", "1", … so `foo.0` / pattern
    // `Foo(a, b)` work uniformly with named-field structs.
    tuple_field <- KW_PUB type_ref
                => { CODE: FIELD_DEF, IS_PUB: 1, TYPE: $2 }
                 / type_ref
                => { CODE: FIELD_DEF, TYPE: $1 }

    field_def <- HASH LPAREN field_def RPAREN COMMA STAR
              => { CODE: REPEAT_GROUP, VALUE: $3, OP: 1 }
               / HASH LPAREN field_def RPAREN STAR
              => { CODE: REPEAT_GROUP, VALUE: $3, OP: 0 }
               / KW_PUB HASH IDENT COLON type_ref COMMA?
              => { CODE: FIELD_DEF, IS_PUB: 1, NAME_VAR: $3, TYPE: $5 }
               / HASH IDENT COLON type_ref COMMA?
              => { CODE: FIELD_DEF, NAME_VAR: $2, TYPE: $4 }
               / KW_PUB IDENT COLON type_ref COMMA?
              => { CODE: FIELD_DEF, IS_PUB: 1, NAME: $2, TYPE: $4 }
               / KW_PUB KW_NEW COLON type_ref COMMA?
              => { CODE: FIELD_DEF, IS_PUB: 1, NAME: $2, TYPE: $4 }
               / KW_PUB KW_NULL COLON type_ref COMMA?
              => { CODE: FIELD_DEF, IS_PUB: 1, NAME: $2, TYPE: $4 }
               / IDENT COLON type_ref COMMA?
              => { CODE: FIELD_DEF, NAME: $1, TYPE: $3 }
               / KW_NEW COLON type_ref COMMA?
              => { CODE: FIELD_DEF, NAME: $1, TYPE: $3 }
               / KW_NULL COLON type_ref COMMA?
              => { CODE: FIELD_DEF, NAME: $1, TYPE: $3 }
               / IDENT DOTDOTDOT COLON type_ref COMMA?
              => { CODE: FIELD_DEF, NAME: $1, TYPE: $4, IS_VARIADIC: 1 }

    // method_def: passthrough — static, pub, or regular fn
    method_def <- pub_static_fn_def / static_fn_def / pub_fn_def / fn_def

    // ── Extern function (FFI) ────────────────────────────────────
    extern_fn_def <- KW_EXTERN KW_FN IDENT LPAREN param_list COMMA DOTDOTDOT RPAREN ARROW type_ref SEMI
                  => { CODE: EXTERN_FN, NAME: $3, PARAMS: $5, RET_TYPE: $10, IS_VARARG: true }
                   / KW_EXTERN KW_FN IDENT LPAREN param_list? RPAREN ARROW type_ref SEMI
                  => { CODE: EXTERN_FN, NAME: $3, PARAMS: $5, RET_TYPE: $8 }
                   / KW_EXTERN KW_FN IDENT LPAREN param_list? RPAREN SEMI
                  => { CODE: EXTERN_FN, NAME: $3, PARAMS: $5 }

    // where T: Trait, U: Trait2
    where_clause <- KW_WHERE type_param (COMMA type_param)*
                 => { CODE: WHERE_CLAUSE, ITEMS: $... }

    // ── Public function ──────────────────────────────────────────
    // Antiquot alts (NAME_VAR holds an expr-TOM; only valid inside quote_*! body —
    // sema gates) come first; they omit where_clause? since NAME_VAR/WHERE share slot 38.
    pub_fn_def <- KW_PUB KW_UNSAFE KW_FN HASH LPAREN expr RPAREN type_param_list? LPAREN param_list? RPAREN ARROW type_ref block
               => { CODE: FN, IS_PUB: 1, IS_UNSAFE: 1, NAME_VAR: $6, TYPE_PARAMS: $8, PARAMS: $10, RET_TYPE: $13, BODY: $14 }
                / KW_PUB KW_UNSAFE KW_FN HASH LPAREN expr RPAREN type_param_list? LPAREN param_list? RPAREN block
               => { CODE: FN, IS_PUB: 1, IS_UNSAFE: 1, NAME_VAR: $6, TYPE_PARAMS: $8, PARAMS: $10, BODY: $12 }
                / KW_PUB KW_FN HASH LPAREN expr RPAREN type_param_list? LPAREN param_list? RPAREN ARROW type_ref block
               => { CODE: FN, IS_PUB: 1, NAME_VAR: $5, TYPE_PARAMS: $7, PARAMS: $9, RET_TYPE: $12, BODY: $13 }
                / KW_PUB KW_FN HASH LPAREN expr RPAREN type_param_list? LPAREN param_list? RPAREN block
               => { CODE: FN, IS_PUB: 1, NAME_VAR: $5, TYPE_PARAMS: $7, PARAMS: $9, BODY: $11 }
                / KW_PUB KW_UNSAFE KW_FN IDENT type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
               => { CODE: FN, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, TYPE_PARAMS: $5, PARAMS: $7, RET_TYPE: $10, WHERE: $11, BODY: $12 }
                / KW_PUB KW_UNSAFE KW_FN IDENT type_param_list? LPAREN param_list? RPAREN where_clause? block
               => { CODE: FN, IS_PUB: 1, IS_UNSAFE: 1, NAME: $4, TYPE_PARAMS: $5, PARAMS: $7, WHERE: $9, BODY: $10 }
                / KW_PUB KW_FN IDENT type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
               => { CODE: FN, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9, WHERE: $10, BODY: $11 }
                / KW_PUB KW_FN IDENT type_param_list? LPAREN param_list? RPAREN where_clause? block
               => { CODE: FN, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, WHERE: $8, BODY: $9 }
                / KW_PUB KW_FN KW_NEW type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
               => { CODE: FN, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9, WHERE: $10, BODY: $11 }
                / KW_PUB KW_FN KW_NEW type_param_list? LPAREN param_list? RPAREN where_clause? block
               => { CODE: FN, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, WHERE: $8, BODY: $9 }
                / KW_PUB KW_FN KW_NULL type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
               => { CODE: FN, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9, WHERE: $10, BODY: $11 }
                / KW_PUB KW_FN KW_NULL type_param_list? LPAREN param_list? RPAREN where_clause? block
               => { CODE: FN, IS_PUB: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, WHERE: $8, BODY: $9 }

    // ── Private function ─────────────────────────────────────────
    fn_def <- KW_UNSAFE KW_FN HASH LPAREN expr RPAREN type_param_list? LPAREN param_list? RPAREN ARROW type_ref block
           => { CODE: FN, IS_UNSAFE: 1, NAME_VAR: $5, TYPE_PARAMS: $7, PARAMS: $9, RET_TYPE: $12, BODY: $13 }
            / KW_UNSAFE KW_FN HASH LPAREN expr RPAREN type_param_list? LPAREN param_list? RPAREN block
           => { CODE: FN, IS_UNSAFE: 1, NAME_VAR: $5, TYPE_PARAMS: $7, PARAMS: $9, BODY: $11 }
            / KW_FN HASH LPAREN expr RPAREN type_param_list? LPAREN param_list? RPAREN ARROW type_ref block
           => { CODE: FN, NAME_VAR: $4, TYPE_PARAMS: $6, PARAMS: $8, RET_TYPE: $11, BODY: $12 }
            / KW_FN HASH LPAREN expr RPAREN type_param_list? LPAREN param_list? RPAREN block
           => { CODE: FN, NAME_VAR: $4, TYPE_PARAMS: $6, PARAMS: $8, BODY: $10 }
            / KW_UNSAFE KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, RET_TYPE: $9, WHERE: $10, BODY: $11 }
            / KW_UNSAFE KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, IS_UNSAFE: 1, NAME: $3, TYPE_PARAMS: $4, PARAMS: $6, WHERE: $8, BODY: $9 }
            / KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, RET_TYPE: $8, WHERE: $9, BODY: $10 }
            / KW_FN KW_NEW type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, RET_TYPE: $8, WHERE: $9, BODY: $10 }
            / KW_FN KW_NULL type_param_list? LPAREN param_list? RPAREN ARROW type_ref where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, RET_TYPE: $8, WHERE: $9, BODY: $10 }
            / KW_FN IDENT  type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, WHERE: $7, BODY: $8 }
            / KW_FN KW_NEW type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, WHERE: $7, BODY: $8 }
            / KW_FN KW_NULL type_param_list? LPAREN param_list? RPAREN where_clause? block
           => { CODE: FN, NAME: $2, TYPE_PARAMS: $3, PARAMS: $5, WHERE: $7, BODY: $8 }

    // Trailing comma allowed except when followed by `...` (variadic
    // marker in extern fns).  Negative lookahead avoids the ambiguity
    // that would let param_list eat the comma intended for the
    // `, ...` separator (closes B-fn-03).
    param_list <- param (COMMA param)* (COMMA !DOTDOTDOT)?
              => { ITEMS: $... }

    param <- AMP KW_MUT IDENT
          => { CODE: PARAM, NAME: $3, IS_REF: true, IS_MUT: true }
           / AMP IDENT
          => { CODE: PARAM, NAME: $2, IS_REF: true }
           / KW_REF IDENT COLON type_ref
          => { CODE: PARAM, NAME: $2, TYPE: $4, IS_REF: true }
           // P4-pm-19 / C5-cl-07: `(a, b, ...): (T1, T2, ...)` tuple-
           // destructure parameter. Reuses `pat_binding_list` (which
           // emits an `{ITEMS: [PAT_WILD{NAME}…]}` sub-map already used
           // by LET_DESTRUCT). Sema fn-collect / closure-expr detects
           // NAMES presence, generates a synth tuple-typed parameter
           // `__tup_param_<N>` and prepends a body-prologue
           // `let user_k = __tup_param_<N>.k;` for each binding so the
           // user-visible names see the destructured tuple elements.
           / LPAREN pat_binding_list RPAREN COLON type_ref
          => { CODE: PARAM, NAMES: $2, TYPE: $5 }
           / IDENT COLON type_ref DOTDOTDOT
          => { CODE: PARAM, NAME: $1, TYPE: $3, IS_VARIADIC: true }
           / IDENT COLON type_ref
          => { CODE: PARAM, NAME: $1, TYPE: $3 }

    // ── Type reference ───────────────────────────────────────────
    // assoc_type_ref must come before simple_type to match T::Item before T
    impl_type <- KW_IMPL IDENT
              => { CODE: IMPL_TYPE, NAME: $2 }

    // hstatic_lit_type intentionally absent: `@{...}` is a HermesStatic *value*,
    // not a type. At type-arg position (`Foo<@{...}>`) it goes through
    // type_or_lt_arg's hermes_lit alt; at top-level naming, use
    // `pub const X: HermesStatic = @{...};` instead of legacy
    // `pub type X = @{...};` (the latter no longer parses).
    type_ref <- antiquot_type / typeof_type / cfg_slot_assoc_ref / cfg_slot_type / hermes_arr_type / hermes_map_type / ptr_type / arr_type / slice_type / tagged_type / dyn_type / ref_type / impl_type / unit_type / closure_type / fn_ptr_type / tuple_type / paren_type / assoc_type_ref / simple_type

    // (T) — paren-wrapped type. Distinct from `()` (unit), `(T,)` (1-tuple),
    // and `(T1, T2)` (n-tuple). Sema unwraps PAREN_TYPE.TYPE to its inner.
    paren_type <- LPAREN type_ref RPAREN
               => { CODE: PAREN_TYPE, TYPE: $2 }

    // <type:CFG.path> — extract the type stored at the given path of a
    // HermesStatic-typed type-level binding. Mono-time projection; the
    // form needs the leading IDENT (CFG) plus at least one path step.
    // GT_TYPE on the tail lets `>>` close both this form and the
    // enclosing generic.
    //
    // Path step kinds (OP discriminator):
    //   OP=0  .IDENT                  — string-keyed map field
    //   OP=1  .INTEGER                — integer-keyed map field
    //   OP=2  .[INTEGER]              — array index (brackets disambig
    //                                   array index from int-key map)
    path_step <- DOT IDENT                       => { OP: 0, NAME: $2 }
               / DOT INTEGER                     => { OP: 1, INDEX: $2 }
               / DOT LBRACKET INTEGER RBRACKET   => { OP: 2, INDEX: $3 }

    cfg_slot_type <- LT KW_TYPE COLON IDENT path_step path_step* GT_TYPE
                  => { CODE: CFG_SLOT_TYPE, NAME: $4, ITEMS: $... }

    // <type:CFG.SLOT>::AssocName — assoc type on a CfgSlotType base.
    // Tried before bare cfg_slot_type so the `::Field` tail consumes.
    cfg_slot_assoc_ref <- cfg_slot_type COLONCOLON IDENT
                       => { CODE: ASSOC_TYPE_REF, RECEIVER: $1, FIELD: $3 }

    // hstatic_lit_type: bare `@{...}` at type position (e.g. `type Cfg = @{...};`).
    // Sema lowers via the same LIT_HSTATIC code as the type-arg form.
    hstatic_lit_type <- hermes_lit
                     => { CODE: LIT_HSTATIC, VALUE: $1 }

    // $ident — antiquot in a type position, valid only inside `quote_ty! { ... }`.
    // sema's lower_quote_ty consumes these; resolve_type errors out elsewhere.
    antiquot_type <- DOLLAR IDENT
                  => { CODE: ANTIQUOT_TYPE, NAME: $2 }

    // typeof(expr) — compile-time type of expression; expr is not evaluated
    typeof_type <- KW_TYPEOF LPAREN expr RPAREN
                => { CODE: TYPEOF_TYPE, VALUE: $3 }

    // <ElemType>[] — Hermes typed array type expression (e.g. val as <I32>[])
    hermes_arr_type <- LT IDENT GT_TYPE LBRACKET RBRACKET
                    => { CODE: HERMES_ARR_TYPE, TYPE: $2 }

    // <K,V>{} or <K>{} — Hermes typed map type expression (e.g. m as <I32,AnyVal>{})
    hermes_map_type <- LT IDENT COMMA IDENT GT_TYPE LBRACE RBRACE
                    => { CODE: HERMES_MAP_TYPE, TYPE: $2, RET_TYPE: $4 }
                   / LT IDENT GT_TYPE LBRACE RBRACE
                    => { CODE: HERMES_MAP_TYPE, TYPE: $2 }

    // T::Item / T::Item<A, B> — associated type reference (plain or GAT with type args)
    assoc_type_ref <- simple_type
                    ( COLONCOLON IDENT LT type_arg_list GT_TYPE
                      => { CODE: ASSOC_TYPE_REF, RECEIVER: $0, FIELD: $2, TYPE_PARAMS: $4 }
                    / COLONCOLON IDENT
                      => { CODE: ASSOC_TYPE_REF, RECEIVER: $0, FIELD: $2 }
                    )+

    // &tagged<TS> Trait — thin tag-dispatched pointer.
    // The tag (type_code) is stored in memory before the object; at call sites
    // the compiler reads the tag, looks up the dispatch table, and calls indirectly.
    tagged_type <- AMP KW_TAGGED LT simple_type GT_TYPE IDENT
               => { CODE: TAGGED_TYPE, TYPE: $4, NAME: $6 }

    // &dyn Trait / &dyn Trait<T,…> — trait object (fat pointer: data + vtable).
    // The TARGS form is needed for traits with type / const-generic params
    // (e.g. `&dyn BTreeNode<StoreCfg>`); type-args use the LT_TYPE/GT_TYPE
    // pair like other type-position generic instances.
    // B63.3: HRTB variants of dyn_type — `&dyn for<'a> Trait<...>`,
    // `&mut dyn for<'a> Trait<...>`, and bare `dyn for<'a> Trait<...>`.
    // Listed FIRST so the parser tries them before the binderless alts
    // (PEG ordered choice: HRTB binders are syntactic prefix and only
    // present in these forms).
    dyn_type <- AMP KW_MUT KW_DYN hrtb_binder IDENT LT_TYPE type_or_lt_arg (COMMA type_or_lt_arg)* COMMA? GT_TYPE (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $5, IS_MUT: true, HRTB_BINDERS: $4, ITEMS: $... }
              / AMP KW_MUT KW_DYN hrtb_binder IDENT LPAREN closure_type_args RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $5, IS_MUT: true, HRTB_BINDERS: $4, PARAMS: $7, RET_TYPE: $10 }
              / AMP KW_MUT KW_DYN hrtb_binder IDENT LPAREN RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $5, IS_MUT: true, HRTB_BINDERS: $4, RET_TYPE: $9 }
              / AMP KW_MUT KW_DYN hrtb_binder IDENT LPAREN closure_type_args RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $5, IS_MUT: true, HRTB_BINDERS: $4, PARAMS: $7 }
              / AMP KW_MUT KW_DYN hrtb_binder IDENT LPAREN RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $5, IS_MUT: true, HRTB_BINDERS: $4 }
              / AMP KW_MUT KW_DYN hrtb_binder IDENT (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $5, IS_MUT: true, HRTB_BINDERS: $4 }
              / AMP KW_DYN hrtb_binder IDENT LT_TYPE type_or_lt_arg (COMMA type_or_lt_arg)* COMMA? GT_TYPE (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, HRTB_BINDERS: $3, ITEMS: $... }
              / AMP KW_DYN hrtb_binder IDENT LPAREN closure_type_args RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, HRTB_BINDERS: $3, PARAMS: $6, RET_TYPE: $9 }
              / AMP KW_DYN hrtb_binder IDENT LPAREN RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, HRTB_BINDERS: $3, RET_TYPE: $8 }
              / AMP KW_DYN hrtb_binder IDENT LPAREN closure_type_args RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, HRTB_BINDERS: $3, PARAMS: $6 }
              / AMP KW_DYN hrtb_binder IDENT LPAREN RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, HRTB_BINDERS: $3 }
              / AMP KW_DYN hrtb_binder IDENT (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, HRTB_BINDERS: $3 }
              / AMP KW_MUT KW_DYN IDENT LPAREN closure_type_args RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, IS_MUT: true, PARAMS: $6, RET_TYPE: $9 }
              / AMP KW_MUT KW_DYN IDENT LPAREN RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, IS_MUT: true, RET_TYPE: $8 }
              / AMP KW_MUT KW_DYN IDENT LPAREN closure_type_args RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, IS_MUT: true, PARAMS: $6 }
              / AMP KW_MUT KW_DYN IDENT LPAREN RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, IS_MUT: true }
              / AMP KW_MUT KW_DYN IDENT LT_TYPE type_or_lt_arg (COMMA type_or_lt_arg)* COMMA? GT_TYPE (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, IS_MUT: true, ITEMS: $... }
              / AMP KW_MUT KW_DYN IDENT (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $4, IS_MUT: true }
              / AMP KW_DYN IDENT LPAREN closure_type_args RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3, PARAMS: $5, RET_TYPE: $8 }
              / AMP KW_DYN IDENT LPAREN RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3, RET_TYPE: $7 }
              / AMP KW_DYN IDENT LPAREN closure_type_args RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3, PARAMS: $5 }
              / AMP KW_DYN IDENT LPAREN RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3 }
              / AMP KW_DYN IDENT LT_TYPE type_or_lt_arg (COMMA type_or_lt_arg)* COMMA? GT_TYPE (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3, ITEMS: $... }
              / AMP KW_DYN IDENT (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3 }
              // B63.3: HRTB-quantified `dyn for<'a> Trait<&'a T>` and Fn-family
              // variants. Binders captured into HRTB_BINDERS for future region
              // inference; sema currently treats them as plain bound forms.
              / KW_DYN hrtb_binder IDENT LT_TYPE type_or_lt_arg (COMMA type_or_lt_arg)* COMMA? GT_TYPE (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3, HRTB_BINDERS: $2, ITEMS: $... }
              / KW_DYN hrtb_binder IDENT LPAREN closure_type_args RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3, HRTB_BINDERS: $2, PARAMS: $5, RET_TYPE: $8 }
              / KW_DYN hrtb_binder IDENT LPAREN RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3, HRTB_BINDERS: $2, RET_TYPE: $7 }
              / KW_DYN hrtb_binder IDENT LPAREN closure_type_args RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3, HRTB_BINDERS: $2, PARAMS: $5 }
              / KW_DYN hrtb_binder IDENT LPAREN RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3, HRTB_BINDERS: $2 }
              / KW_DYN hrtb_binder IDENT (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $3, HRTB_BINDERS: $2 }
              // Fn-family forms with parens — `dyn Fn(T1,…) -> R` / `dyn FnMut()` /
              // `dyn FnOnce()`. Arg-type list goes into PARAMS; optional `-> R`
              // into RET_TYPE. Optional `+ 'lt` lifetime bound accepted and
              // ignored by sema (Logos's lifetime model is elision-based).
              / KW_DYN IDENT LPAREN closure_type_args RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $2, PARAMS: $4, RET_TYPE: $7 }
              / KW_DYN IDENT LPAREN RPAREN ARROW type_ref (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $2, RET_TYPE: $6 }
              / KW_DYN IDENT LPAREN closure_type_args RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $2, PARAMS: $4 }
              / KW_DYN IDENT LPAREN RPAREN (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $2 }
              / KW_DYN IDENT LT_TYPE type_or_lt_arg (COMMA type_or_lt_arg)* COMMA? GT_TYPE (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $2, ITEMS: $... }
              / KW_DYN IDENT (PLUS LIFETIME)?
             => { CODE: DYN_TYPE, NAME: $2 }

    // &[T] and &mut [T] — slice types (fat pointer: ptr + len).
    // L2: with explicit lifetime — `&'a [T]` / `&'a mut [T]`. Lifetime
    // captured in LIFETIME slot; downstream sema currently doesn't
    // enforce slice-with-lifetime distinctly from plain &[T].
    slice_type <- AMP LIFETIME KW_MUT LBRACKET type_ref RBRACKET
               => { CODE: SLICE_TYPE, TYPE: $5, MUTPTR: true, LIFETIME: $2 }
               / AMP LIFETIME LBRACKET type_ref RBRACKET
               => { CODE: SLICE_TYPE, TYPE: $4, LIFETIME: $2 }
               / AMP KW_MUT LBRACKET type_ref RBRACKET
               => { CODE: SLICE_TYPE, TYPE: $4, MUTPTR: true }
               / AMP LBRACKET type_ref RBRACKET
               => { CODE: SLICE_TYPE, TYPE: $3 }

    // &'a mut T / &mut T / &'a T / &T — safe reference types (borrow-checked)
    ref_type <- AMP LIFETIME KW_MUT ref_pointee
             => { CODE: MUT_REF_TYPE, POINTEE: $4, LIFETIME: $2 }
              / AMP KW_MUT ref_pointee
             => { CODE: MUT_REF_TYPE, POINTEE: $3 }
              / AMP LIFETIME ref_pointee
             => { CODE: REF_TYPE, POINTEE: $3, LIFETIME: $2 }
              / AMP ref_pointee
             => { CODE: REF_TYPE, POINTEE: $2 }
              // B-ty-07: `&&[mut] T` lexer-greedy collision — `AMPAMP` would
              // otherwise be tokenised as logical-AND.  Sema unwraps to
              // `& & T` / `& &mut T`.
              / AND KW_MUT ref_pointee
             => { CODE: DOUBLE_REF_MUT_TYPE, POINTEE: $3 }
              / AND ref_pointee
             => { CODE: DOUBLE_REF_TYPE, POINTEE: $2 }

    // Pointee types for & and &mut: simple types plus tuple and array
    // composites; ref_type itself allows arbitrary-depth `& & … T` stacks
    // (whitespace-tolerant) at type position. `&&T` (no whitespace) is
    // still handled by the DOUBLE_REF_TYPE alts above, which the lexer
    // routes through the AND token.
    ref_pointee <- ref_type / arr_type / tuple_type / unit_type / simple_type

    // |T1, T2| -> R — closure type (used in function parameter type annotations)
    closure_type_args <- type_ref (COMMA type_ref)*
                      => { ITEMS: $... }
    closure_type <- PIPE closure_type_args PIPE ARROW type_ref
                 => { CODE: CLOSURE_TYPE, PARAMS: $2, RET_TYPE: $5 }
                 // B-ty-08: zero-arg form `|| -> R` (lexer collapses `||`).
                 / OR ARROW type_ref
                 => { CODE: CLOSURE_TYPE, RET_TYPE: $3 }

    // fn(T1, T2) -> R — bare function pointer type
    fn_ptr_type_args <- type_ref (COMMA type_ref)*
                     => { ITEMS: $... }
    // B63.3: `for<'a> fn(&'a T) -> R` — HRTB-quantified fn-pointer type.
    // Each `for<>` alt mirrors the bare-fn alt below with a HRTB_BINDERS
    // capture. Sema doesn't yet skolemize per-type binders; the binders
    // are parsed-and-captured for future region inference.
    fn_ptr_type <- hrtb_binder KW_FN LPAREN fn_ptr_type_args RPAREN ARROW type_ref
                => { CODE: FN_PTR_TYPE, HRTB_BINDERS: $1, PARAMS: $4, RET_TYPE: $7 }
                 / hrtb_binder KW_FN LPAREN fn_ptr_type_args RPAREN
                => { CODE: FN_PTR_TYPE, HRTB_BINDERS: $1, PARAMS: $4 }
                 / hrtb_binder KW_FN LPAREN RPAREN ARROW type_ref
                => { CODE: FN_PTR_TYPE, HRTB_BINDERS: $1, RET_TYPE: $6 }
                 / hrtb_binder KW_FN LPAREN RPAREN
                => { CODE: FN_PTR_TYPE, HRTB_BINDERS: $1 }
                 / KW_FN LPAREN fn_ptr_type_args RPAREN ARROW type_ref
                => { CODE: FN_PTR_TYPE, PARAMS: $3, RET_TYPE: $6 }
                 / KW_FN LPAREN fn_ptr_type_args RPAREN
                => { CODE: FN_PTR_TYPE, PARAMS: $3 }
                 / KW_FN LPAREN RPAREN ARROW type_ref
                => { CODE: FN_PTR_TYPE, RET_TYPE: $5 }
                 / KW_FN LPAREN RPAREN
                => { CODE: FN_PTR_TYPE }
                / KW_FN LPAREN RPAREN ARROW type_ref
                => { CODE: FN_PTR_TYPE, RET_TYPE: $5 }

    // () — unit/void type (empty tuple, equivalent to void)
    unit_type <- LPAREN RPAREN
              => { CODE: TUPLE_TYPE }

    // (T1, T2, ...) — tuple type (2+ elements); (T,) — single-element tuple
    tuple_type <- LPAREN type_ref COMMA type_ref (COMMA type_ref)* COMMA? RPAREN
               => { CODE: TUPLE_TYPE, ITEMS: $... }
               / LPAREN type_ref COMMA RPAREN
               => { CODE: TUPLE_TYPE, ITEMS: $... }

    // Raw fat-pointer to a slice: `*const [T]` / `*mut [T]`. Same fat
    // ptr ABI (`{*const T, usize}`) as `&[T]` — the type just drops
    // the borrow-check guarantees. Must precede the plain `ptr_type`
    // alts since arr_type requires `[T; N]` (with size); a bare
    // `[T]` would otherwise fail to parse.
    ptr_type <- STAR KW_CONST LBRACKET type_ref RBRACKET
             => { CODE: SLICE_TYPE, TYPE: $4 }
              / STAR KW_MUT LBRACKET type_ref RBRACKET
             => { CODE: SLICE_TYPE, TYPE: $4, MUTPTR: true }
              / STAR KW_CONST type_ref
             => { CODE: PTR_TYPE, POINTEE: $3, MUTPTR: false }
              / STAR KW_MUT type_ref
             => { CODE: PTR_TYPE, POINTEE: $3, MUTPTR: true }

    // [T; N] — fixed-size array type
    // First alt: [T; sizeof...(P)] — size from variadic pack length, lowered
    // by sema to symbolic arr_size_var "__sizeof_pack:P" and resolved at mono.
    arr_type <- LBRACKET type_ref SEMI IDENT DOTDOTDOT LPAREN IDENT RPAREN RBRACKET
              => { CODE: ARR_TYPE, TYPE: $2, OP: $4, NAME: $7 }
              / LBRACKET type_ref SEMI KW_METACALL block RBRACKET
              => { CODE: ARR_TYPE, TYPE: $2, BODY: $5 }
              / LBRACKET type_ref SEMI (INTEGER / IDENT) RBRACKET
              => { CODE: ARR_TYPE, TYPE: $2, SIZE: $4 }

    // type_or_lt_arg: a type argument that may be a lifetime annotation or a type.
    // Lifetimes (e.g. 'a) in generic type args are stored as LIFETIME_PARAM nodes
    // so sema can skip them when resolving concrete type arguments.
    type_or_lt_arg <- HASH LPAREN type_or_lt_arg RPAREN COMMA STAR
                   => { CODE: REPEAT_GROUP, VALUE: $3, OP: 1 }
                    / LIFETIME
                   => { CODE: LIFETIME_PARAM, NAME: $1 }
                    / IDENT DOTDOTDOT
                   => { CODE: PACK_EXPAND, NAME: $1 }
                    / DOLLAR IDENT DOTDOTDOT
                   => { CODE: ANTIQUOT_PACK, NAME: $2 }
                    / DOLLAR IDENT
                   => { CODE: ANTIQUOT_TYPE, NAME: $2 }
                    / MINUS INTEGER
                   => { CODE: LIT_INT, VALUE: $2, LO_NEG: true }
                    / INTEGER
                   => { CODE: LIT_INT, VALUE: $1 }
                    / hermes_lit
                   => { CODE: LIT_HSTATIC, VALUE: $1 }
                    / type_ref

    simple_type <- HASH LPAREN expr RPAREN LT_TYPE type_or_lt_arg (COMMA type_or_lt_arg)* COMMA? GT_TYPE
                => { CODE: GENERIC_INST, NAME_VAR: $3, ITEMS: $... }
                 / HASH IDENT LT_TYPE type_or_lt_arg (COMMA type_or_lt_arg)* COMMA? GT_TYPE
                => { CODE: GENERIC_INST, NAME_VAR: $2, ITEMS: $... }
                 / HASH LPAREN expr RPAREN
                => { CODE: TYPE_REF, NAME_VAR: $3 }
                 / HASH IDENT
                => { CODE: TYPE_REF, NAME_VAR: $2 }
                 / IDENT LT_TYPE type_or_lt_arg (COMMA type_or_lt_arg)* COMMA? GT_TYPE
                => { CODE: GENERIC_INST, NAME: $1, ITEMS: $... }
                 / IDENT
                => { CODE: TYPE_REF, NAME: $1 }

    // ── Block ────────────────────────────────────────────────────
    block <- LBRACE stmt* RBRACE
          => { CODE: BLOCK, ITEMS: $... }

    // ── Unsafe block ─────────────────────────────────────────────
    unsafe_block <- KW_UNSAFE block
                 => { CODE: UNSAFE_BLOCK, BODY: $2 }

    // ── Statements ───────────────────────────────────────────────
    stmt <- HASH LPAREN stmt RPAREN STAR
             => { CODE: REPEAT_GROUP, VALUE: $3, OP: 0 }
          / labeled_loop_stmt
          / let_else_stmt
          / let_stmt
          / for_stmt
          / while_stmt
          / loop_stmt
          / return_stmt
          / break_stmt
          / continue_stmt
          / deref_write_stmt
          / if_expr
          / match_stmt

          / field_index_compound_assign_stmt
          / field_index_write_stmt
          / deref_field_compound_assign_stmt
          / deref_field_write_stmt
          / tuple_field_compound_assign_stmt
          / tuple_field_write_stmt
          / chain_field_compound_assign_stmt
          / chain_field_write_stmt
          / field_compound_assign_stmt
          / field_write_stmt
          / index_compound_assign_stmt
          / index_write_stmt
          / compound_assign_stmt
          / assign_stmt
          / unsafe_block
          / block
            => { CODE: BLOCK_STMT, BODY: $1 }
          / expr SEMI
            => { CODE: EXPR_STMT, VALUE: $1 }
          / expr
            => { CODE: TAIL_EXPR, VALUE: $1 }

    // for i in lo..hi { }  (exclusive) and  for i in lo..=hi { }  (inclusive)
    // for item in array { }  (for-each over fixed-size array)
    //
    // Factor the shared prefix `KW_FOR IDENT KW_IN expr` so we don't reparse
    // the iterator expression on each alternative's failure.  The tail rule
    // dispatches on the operator that follows (DOTDOT / DOTDOTEQ / block).
    for_stmt <- KW_FOR IDENT KW_IN expr_ns DOTDOTEQ expr_ns block
             => { CODE: FOR, NAME: $2, LHS: $4, RHS: $6, BODY: $7, INCLUSIVE: true }
              / KW_FOR IDENT KW_IN expr_ns DOTDOT   expr_ns block
             => { CODE: FOR, NAME: $2, LHS: $4, RHS: $6, BODY: $7, INCLUSIVE: false }
              / KW_FOR IDENT KW_IN expr_ns             block
             => { CODE: FOR_EACH, NAME: $2, ITER: $4, BODY: $5 }

    loop_stmt     <- KW_LOOP block
                  => { CODE: LOOP, BODY: $2 }

    loop_expr     <- KW_LOOP block
                  => { CODE: LOOP, BODY: $2 }

    // Labeled loop: 'label: for/while/loop { }
    labeled_loop_stmt <- LIFETIME COLON for_stmt
                      => { CODE: LABELED_LOOP, LABEL: $1, BODY: $3 }
                       / LIFETIME COLON while_stmt
                      => { CODE: LABELED_LOOP, LABEL: $1, BODY: $3 }
                       / LIFETIME COLON loop_stmt
                      => { CODE: LABELED_LOOP, LABEL: $1, BODY: $3 }

    break_stmt    <- KW_BREAK LIFETIME expr SEMI
                  => { CODE: BREAK, LABEL: $2, VALUE: $3 }
                   / KW_BREAK LIFETIME SEMI
                  => { CODE: BREAK, LABEL: $2 }
                   / KW_BREAK expr SEMI
                  => { CODE: BREAK, VALUE: $2 }
                   / KW_BREAK (SEMI / COMMA)
                  => { CODE: BREAK }

    continue_stmt <- KW_CONTINUE LIFETIME SEMI
                  => { CODE: CONTINUE, LABEL: $2 }
                   / KW_CONTINUE (SEMI / COMMA)
                  => { CODE: CONTINUE }

    // match expr { Pat => stmt_or_block, ... }
    // The first alt with a bare IDENT head sidesteps the struct-lit
    // ambiguity for `match e { ... }` (B-pt-08): without it, `e {`
    // greedy-parses as a struct literal `e { }` and the match's own
    // LBRACE never matches. Complex heads (`match foo.bar() { ... }`)
    // fall through to the general expr-based alt.
    match_head_var <- IDENT => { CODE: VAR_REF, NAME: $1 }
    match_stmt <- KW_MATCH match_head_var LBRACE match_arm* RBRACE
               => { CODE: MATCH, VALUE: $2, ITEMS: $... }
                / KW_MATCH expr LBRACE match_arm* RBRACE
               => { CODE: MATCH, VALUE: $2, ITEMS: $... }

    match_arm <- pattern KW_IF expr FATARROW block COMMA?
              => { CODE: MATCH_ARM, LHS: $1, GUARD: $3, BODY: $5 }
              / pattern KW_IF expr FATARROW expr COMMA?
              => { CODE: MATCH_ARM, LHS: $1, GUARD: $3, EXPR: $5 }
              / pattern KW_IF expr FATARROW stmt
              => { CODE: MATCH_ARM, LHS: $1, GUARD: $3, BODY: $5 }
              / pattern FATARROW block COMMA?
              => { CODE: MATCH_ARM, LHS: $1, BODY: $3 }
              / pattern FATARROW expr COMMA?
              => { CODE: MATCH_ARM, LHS: $1, EXPR: $3 }
              / pattern FATARROW stmt
              => { CODE: MATCH_ARM, LHS: $1, BODY: $3 }

    pat_binding <- LPAREN RPAREN
                => { CODE: PAT_UNIT }
               / IDENT
                => { CODE: PAT_WILD, NAME: $1 }

    pat_binding_list <- pat_binding (COMMA pat_binding)*
                     => { ITEMS: $... }

    // Variant-payload pattern args: full nested patterns (closes B-pt-04).
    // Distinct from pat_binding_list because LET_DESTRUCT positions are
    // bindings, not refutable matches.
    pat_variant_args <- pat_single (COMMA pat_single)* COMMA?
                     => { ITEMS: $... }

    pattern <- pat_single (PIPE pat_single)*
            => { CODE: PAT_OR, ITEMS: $... }

    // ── Single field in a struct pattern ─────────────────────────────────
    pat_field <- DOTDOT
              => { CODE: PAT_REST }
               / IDENT COLON pat_single
              => { CODE: PAT_FIELD, NAME: $1, VALUE: $3 }
               / IDENT
              => { CODE: PAT_FIELD, NAME: $1 }

    pat_field_list <- pat_field (COMMA pat_field)* COMMA?
                   => { ITEMS: $... }

    // ── Single element in a slice pattern ────────────────────────────────
    pat_slice_elem <- DOTDOT
                   => { CODE: PAT_REST }
                    / pat_single

    pat_slice_elems <- pat_slice_elem (COMMA pat_slice_elem)* COMMA?
                    => { ITEMS: $... }

    // P4-pm-20: tuple-pattern element — either `..` rest skip or a
    // regular pat_single binding. Reuses the slice-elem PAT_REST node
    // shape; tuple-pat builder converts each rest position into
    // PAT_WILD(name="_") skips so the underlying PatTuple LIR keeps
    // its fixed-arity layout.
    pat_tuple_elem <- DOTDOT
                   => { CODE: PAT_REST }
                    // P4-pm-03: or-pattern as tuple element
                    // (`(true | false, …)`). Always emit PAT_OR; sema
                    // already unwraps single-alt PAT_OR transparently.
                    / pat_single (PIPE pat_single)*
                   => { CODE: PAT_OR, ITEMS: $... }

    // Hermes map/array pattern entry lists.
    pat_hermes_map_entry <- STRING COLON pat_single
                         => { CODE: PAT_HERMES_MAP_ENTRY, KEY: $1, VALUE: $3 }

    pat_hermes_map_entries <- pat_hermes_map_entry (COMMA pat_hermes_map_entry)* COMMA?
                           => { ITEMS: $... }

    // Array elements allow a trailing `..` to match length ≥ n.
    pat_hermes_arr_elem <- DOTDOT
                        => { CODE: PAT_REST }
                         / pat_single

    pat_hermes_arr_elems <- pat_hermes_arr_elem (COMMA pat_hermes_arr_elem)* COMMA?
                         => { ITEMS: $... }

    // ── pat_single: all pattern alternatives ─────────────────────────────
    // @ binding: must come before bare IDENT to capture "name @ sub"
    // G1: use pat_single (not pat_single_base) so n @ ref x and n @ &pat work.
    pat_single :group variant: <- IDENT AT pat_single
        => { CODE: PAT_AT, NAME: $1, VALUE: $3 }
        // ref mut binding
        / KW_REF KW_MUT IDENT
        => { CODE: PAT_WILD, NAME: $3, IS_MUT: true, IS_REF: true }
        // ref binding
        / KW_REF IDENT
        => { CODE: PAT_WILD, NAME: $2, IS_REF: true }
        // P4-pm-12: `mut x` re-bindable identifier pattern (used by
        // `match x { mut z => z = …; }` to introduce a fresh mutable
        // local from the scrutinee).
        / KW_MUT IDENT
        => { CODE: PAT_WILD, NAME: $2, IS_MUT: true }
        // reference pattern: &mut pat or &pat
        // NG1: use pat_single (not pat_single_base) so &ref x, &n@42, etc. work.
        / AMP KW_MUT pat_single
        => { CODE: PAT_REF, IS_MUT: true, VALUE: $3 }
        / AMP pat_single
        => { CODE: PAT_REF, VALUE: $2 }
        // everything else
        / pat_single_base

    // Unit pattern `()` (Sprint 4.2 — needed when generalising
    // pat_variant_args to pat_single, since `Result::Ok(())` previously
    // relied on pat_binding's LPAREN RPAREN alt).
    pat_single_base :group variant: <- LPAREN RPAREN
        => { CODE: PAT_UNIT }
        // Hermes scalar patterns: @null / @true / @false / @42 / @-42
        // Must precede other alternatives that could also consume AT via PAT_AT
        // (PAT_AT is `IDENT AT pat_single`, different leading token, so no conflict).
        / AT KW_NULL
        => { CODE: PAT_HERMES_NULL }
        / AT KW_TRUE
        => { CODE: PAT_HERMES_BOOL, VALUE: true }
        / AT KW_FALSE
        => { CODE: PAT_HERMES_BOOL, VALUE: false }
        / AT MINUS INTEGER
        => { CODE: PAT_HERMES_INT, VALUE: $3, LO_NEG: true }
        / AT INTEGER
        => { CODE: PAT_HERMES_INT, VALUE: $2 }
        / AT STRING
        => { CODE: PAT_HERMES_STR, VALUE: $2 }
        / AT LT IDENT COMMA IDENT GT LBRACE DOTDOT RBRACE
        => { CODE: PAT_HERMES_TYPED_MAP, TYPE: $3, RET_TYPE: $5 }
        / AT LT IDENT GT LBRACE DOTDOT RBRACE
        => { CODE: PAT_HERMES_TYPED_MAP, TYPE: $3 }
        / AT LT IDENT GT LBRACKET DOTDOT RBRACKET
        => { CODE: PAT_HERMES_TYPED_ARR, TYPE: $3 }
        / AT LBRACE pat_hermes_map_entries RBRACE
        => { CODE: PAT_HERMES_MAP, ITEMS: $3 }
        / AT LBRACE RBRACE
        => { CODE: PAT_HERMES_MAP }
        / AT LBRACKET pat_hermes_arr_elems RBRACKET
        => { CODE: PAT_HERMES_ARR, ITEMS: $3 }
        / AT LBRACKET RBRACKET
        => { CODE: PAT_HERMES_ARR }
        / IDENT COLONCOLON IDENT LPAREN pat_variant_args? RPAREN
        => { CODE: PAT_VARIANT_DATA, NAME: $1, FIELD: $3, ARGS: $5 }
        // P4-pm-01: struct-shape variant pattern `E::V { x, y: pat, .. }`.
        // Reuses pat_field_list (used by PAT_STRUCT). Sema resolves
        // field names → variant payload indices via payload_field_names.
        / IDENT COLONCOLON IDENT LBRACE pat_field_list RBRACE
        => { CODE: PAT_VARIANT_DATA, NAME: $1, FIELD: $3, IS_STRUCT_SHAPE: 1, ITEMS: $5 }
        / IDENT COLONCOLON IDENT LBRACE RBRACE
        => { CODE: PAT_VARIANT_DATA, NAME: $1, FIELD: $3, IS_STRUCT_SHAPE: 1 }
        / IDENT COLONCOLON IDENT
        => { CODE: PAT_VARIANT, NAME: $1, FIELD: $3 }
        // B-ts-01: tuple-struct pattern `Foo(a, b)` (no `::` separator).
        // Emits PAT_VARIANT_DATA with empty FIELD; sema dispatches to
        // tuple-struct destructure when the name resolves as a
        // tuple-struct rather than an enum.
        / IDENT LPAREN pat_variant_args RPAREN
        => { CODE: PAT_VARIANT_DATA, NAME: $1, ARGS: $3 }
        // struct pattern: Point { field_list } or Point {}
        / IDENT LBRACE pat_field_list RBRACE
        => { CODE: PAT_STRUCT, NAME: $1, ITEMS: $3 }
        / IDENT LBRACE RBRACE
        => { CODE: PAT_STRUCT, NAME: $1 }
        // slice pattern: [elems] or []
        / LBRACKET pat_slice_elems RBRACKET
        => { CODE: PAT_SLICE, ITEMS: $2 }
        / LBRACKET RBRACKET
        => { CODE: PAT_SLICE }
        // range patterns (inclusive ..=): must come before bare INTEGER
        / MINUS INTEGER DOTDOTEQ MINUS INTEGER
        => { CODE: PAT_RANGE, LHS: $2, RHS: $5, LO_NEG: true, HI_NEG: true, INCLUSIVE: true }
        / MINUS INTEGER DOTDOTEQ INTEGER
        => { CODE: PAT_RANGE, LHS: $2, RHS: $4, LO_NEG: true, INCLUSIVE: true }
        / INTEGER DOTDOTEQ MINUS INTEGER
        => { CODE: PAT_RANGE, LHS: $1, RHS: $4, HI_NEG: true, INCLUSIVE: true }
        / INTEGER DOTDOTEQ INTEGER
        => { CODE: PAT_RANGE, LHS: $1, RHS: $3, INCLUSIVE: true }
        // P4-pm-22: exclusive integer-range patterns (`lo..hi`). Same
        // shape as the inclusive form but INCLUSIVE=false. Codegen
        // adjusts the upper-bound predicate accordingly.
        / MINUS INTEGER DOTDOT MINUS INTEGER
        => { CODE: PAT_RANGE, LHS: $2, RHS: $5, LO_NEG: true, HI_NEG: true, INCLUSIVE: false }
        / MINUS INTEGER DOTDOT INTEGER
        => { CODE: PAT_RANGE, LHS: $2, RHS: $4, LO_NEG: true, INCLUSIVE: false }
        / INTEGER DOTDOT MINUS INTEGER
        => { CODE: PAT_RANGE, LHS: $1, RHS: $4, HI_NEG: true, INCLUSIVE: false }
        / INTEGER DOTDOT INTEGER
        => { CODE: PAT_RANGE, LHS: $1, RHS: $3, INCLUSIVE: false }
        / MINUS INTEGER
        => { CODE: PAT_NEG_INT, VALUE: $2 }
        / INTEGER
        => { CODE: PAT_INT, VALUE: $1 }
        // char-range / char-literal patterns
        / CHAR_LIT DOTDOTEQ CHAR_LIT
        => { CODE: PAT_CHAR_RANGE, LHS: $1, RHS: $3 }
        / CHAR_LIT
        => { CODE: PAT_CHAR, VALUE: $1 }
        // Float literal pattern (closes B-pt-06).  Sema rejects with a
        // diagnostic — IEEE equality semantics are deliberately not committed
        // to until the language has a defined story (Rust deprecated this).
        / FLOAT
        => { CODE: PAT_FLOAT, VALUE: $1 }
        // Byte-string literal pattern (closes B-pt-03 — parses; sema
        // rejects until codegen for &[u8] equality matching lands).
        / BYTE_STRING
        => { CODE: PAT_BYTES, VALUE: $1 }
        / KW_TRUE
        => { CODE: PAT_BOOL, VALUE: true }
        / KW_FALSE
        => { CODE: PAT_BOOL, VALUE: false }
        // P4-pm-20: tuple pattern with optional `..` rest at any
        // single position. `pat_tuple_elem` admits either PAT_REST
        // (the `..` skip-marker) or a regular pat_single.
        / LPAREN pat_tuple_elem COMMA pat_tuple_elem (COMMA pat_tuple_elem)* RPAREN
        => { CODE: PAT_TUPLE, ITEMS: $... }
        / IDENT
        => { CODE: PAT_WILD, NAME: $1 }

    // arr[idx] = expr;
    index_write_stmt <- IDENT LBRACKET expr RBRACKET ASSIGN expr SEMI
                     => { CODE: INDEX_WRITE, NAME: $1, LHS: $3, VALUE: $6 }

    // let Pat = expr else { block };
    let_else_stmt <- KW_LET pattern ASSIGN expr KW_ELSE block SEMI
                  => { CODE: LET_ELSE, PAT: $2, VALUE: $4, BODY: $6 }

    let_stmt <- KW_LET LPAREN pat_binding_list RPAREN COLON type_ref ASSIGN expr SEMI
             => { CODE: LET_DESTRUCT, NAMES: $3, TYPE: $6, VALUE: $8 }
              / KW_LET LPAREN pat_binding_list RPAREN ASSIGN expr SEMI
             => { CODE: LET_DESTRUCT, NAMES: $3, VALUE: $6 }
              // P4-pm-14: `let ref y = x;` — `ref`-binding sugar for
              // `let y = &x;`. Sema detects IS_REF and wraps the lowered
              // RHS in an addr-of.
              / KW_LET KW_REF IDENT COLON type_ref ASSIGN expr SEMI
             => { CODE: LET, IS_REF: true, NAME: $3, TYPE: $5, VALUE: $7 }
              / KW_LET KW_REF IDENT ASSIGN expr SEMI
             => { CODE: LET, IS_REF: true, NAME: $3, VALUE: $5 }
              / KW_LET KW_MUT IDENT COLON type_ref ASSIGN expr SEMI
             => { CODE: LET, IS_MUT: true, NAME: $3, TYPE: $5, VALUE: $7 }
              / KW_LET KW_MUT IDENT COLON type_ref SEMI
             => { CODE: LET, IS_MUT: true, NAME: $3, TYPE: $5 }
              / KW_LET KW_MUT IDENT ASSIGN expr SEMI
             => { CODE: LET, IS_MUT: true, NAME: $3, VALUE: $5 }
              / KW_LET IDENT COLON type_ref ASSIGN expr SEMI
             => { CODE: LET, NAME: $2, TYPE: $4, VALUE: $6 }
              / KW_LET IDENT COLON type_ref SEMI
             => { CODE: LET, NAME: $2, TYPE: $4 }
              / KW_LET IDENT ASSIGN expr SEMI
             => { CODE: LET, NAME: $2, VALUE: $4 }
              // B-pt-02: irrefutable destructure with full pattern
              // (struct, enum-variant, tuple-pattern with non-IDENT subs).
              // Tried last because the IDENT-prefixed alts above cover the
              // common path; this picks up forms the simpler alts reject.
              // Refutability is checked at sema time.
              / KW_LET pat_single ASSIGN expr SEMI
             => { CODE: LET_PAT, PAT: $2, VALUE: $4 }

    while_stmt <- KW_WHILE KW_LET pattern ASSIGN expr_ns block
               => { CODE: WHILE, PAT: $3, VALUE: $5, BODY: $6 }
             / KW_WHILE expr_ns block
               => { CODE: WHILE, COND: $2, BODY: $3 }

    return_stmt <- KW_RETURN expr? (SEMI / COMMA)
                => { CODE: RETURN, VALUE: $2 }

    assign_stmt <- IDENT ASSIGN expr SEMI
                => { CODE: ASSIGN, NAME: $1, VALUE: $3 }

    // Compound assignment: x += expr → x = x + expr
    compound_assign_op <- PLUS_EQ / MINUS_EQ / STAR_EQ / SLASH_EQ / PERCENT_EQ
                        / AMP_EQ / PIPE_EQ / CARET_EQ / SHL_EQ / SHR_EQ
    compound_assign_stmt <- IDENT compound_assign_op expr SEMI
                         => { CODE: COMPOUND_ASSIGN, NAME: $1, OP: $2, VALUE: $3 }

    // var.N = value;  — tuple field write (N is an integer index literal)
    tuple_field_write_stmt <- IDENT DOT INTEGER ASSIGN expr SEMI
                           => { CODE: TUPLE_FIELD_WRITE, RECEIVER: $1, INDEX: $3, VALUE: $5 }

    field_write_stmt <- IDENT DOT IDENT ASSIGN expr SEMI
                     => { CODE: FIELD_WRITE, RECEIVER: $1, FIELD: $3, VALUE: $5 }

    // `.field` segment used by chained field writes; default-action returns the IDENT string.
    chain_path_id <- DOT IDENT

    // Path of two or more `.field` segments, packaged as a sub-node {ITEMS: [str, ...]}.
    chain_field_path <- chain_path_id chain_path_id chain_path_id*
                     => { ITEMS: $... }

    // a.b.c = val;  — chained field write (2+ levels deep, N-ary)
    chain_field_write_stmt <- IDENT chain_field_path ASSIGN expr SEMI
                           => { CODE: CHAIN_FIELD_WRITE, RECEIVER: $1, PATH: $2, VALUE: $4 }

    // s.field op= expr;  — compound assign to struct field
    field_compound_assign_stmt <- IDENT DOT IDENT compound_assign_op expr SEMI
                               => { CODE: FIELD_COMPOUND_ASSIGN, RECEIVER: $1, FIELD: $3, OP: $4, VALUE: $5 }

    // a.b.c op= val;  — chained field compound assign (2+ levels deep, N-ary)
    chain_field_compound_assign_stmt <- IDENT chain_field_path compound_assign_op expr SEMI
                                     => { CODE: CHAIN_FIELD_COMPOUND_ASSIGN, RECEIVER: $1, PATH: $2, OP: $3, VALUE: $4 }

    // arr[i] op= expr;  — compound assign to array index
    index_compound_assign_stmt <- IDENT LBRACKET expr RBRACKET compound_assign_op expr SEMI
                               => { CODE: INDEX_COMPOUND_ASSIGN, NAME: $1, LHS: $3, OP: $5, VALUE: $6 }

    // (*ptr).field = val;  — field write through a dereferenced pointer
    deref_field_write_stmt <- LPAREN STAR IDENT RPAREN DOT IDENT ASSIGN expr SEMI
                           => { CODE: DEREF_FIELD_WRITE, RECEIVER: $3, FIELD: $6, VALUE: $8 }

    // (*ptr).field op= val;  — compound assign to field through a dereferenced pointer
    deref_field_compound_assign_stmt <- LPAREN STAR IDENT RPAREN DOT IDENT compound_assign_op expr SEMI
                                     => { CODE: DEREF_FIELD_COMPOUND_ASSIGN, RECEIVER: $3, FIELD: $6, OP: $7, VALUE: $8 }

    // var.N op= expr;  — compound assign to tuple field
    tuple_field_compound_assign_stmt <- IDENT DOT INTEGER compound_assign_op expr SEMI
                                     => { CODE: TUPLE_FIELD_COMPOUND_ASSIGN, RECEIVER: $1, INDEX: $3, OP: $4, VALUE: $5 }

    // a.ptr[i] = val;  — field index write (pointer field)
    field_index_write_stmt <- IDENT DOT IDENT LBRACKET expr RBRACKET ASSIGN expr SEMI
                           => { CODE: FIELD_INDEX_WRITE, RECEIVER: $1, FIELD: $3, LHS: $5, VALUE: $8 }

    // s.field[i] op= val;  — compound assign to field array element
    field_index_compound_assign_stmt <- IDENT DOT IDENT LBRACKET expr RBRACKET compound_assign_op expr SEMI
                                     => { CODE: FIELD_INDEX_COMPOUND_ASSIGN, RECEIVER: $1, FIELD: $3, LHS: $5, OP: $7, VALUE: $8 }

    // *ptr = val;  — dereference write
    deref_write_stmt <- STAR unary_expr ASSIGN expr SEMI
                     => { CODE: DEREF_WRITE, NAME: $2, VALUE: $4 }
                      // B-st-04: `*p += v` — compound assign through bare deref.
                      // Lowers to `*p = *p + v` at sema.
                      / STAR unary_expr compound_assign_op expr SEMI
                     => { CODE: DEREF_COMPOUND, NAME: $2, OP: $3, VALUE: $4 }

    if_expr <- KW_IF KW_LET pattern ASSIGN expr_ns block KW_ELSE (if_expr / block)
            => { CODE: IF, PAT: $3, VALUE: $5, THEN: $6, ELSE: $8 }
             / KW_IF KW_LET pattern ASSIGN expr_ns block
            => { CODE: IF, PAT: $3, VALUE: $5, THEN: $6 }
             / KW_IF expr_ns block KW_ELSE (if_expr / block)
            => { CODE: IF, COND: $2, THEN: $3, ELSE: $5 }
             / KW_IF expr_ns block
            => { CODE: IF, COND: $2, THEN: $3 }

    // ── Expressions (precedence via rule nesting) ─────────────────
    // Binary levels use left-associative fold chains so that a + b + c
    // parses as (a + b) + c without requiring explicit parentheses.
    // Comparison and logical operators remain single-level (non-chainable).
    // Range as a value-position expression: `lo..hi` and `lo..=hi`. Sema
    // lowers each to a stdlib `RangeI64` (or RangeI32) struct construction
    // which implements `Iterator<T>`. for-stmt keeps its dedicated
    // DOTDOT path (uses expr_ns, no range here) so simple integer loops
    // stay zero-overhead.
    expr <- range_expr

    range_expr <- log_expr DOTDOTEQ log_expr
               => { CODE: RANGE_EXPR, LHS: $1, RHS: $3, INCLUSIVE: true }
                / log_expr DOTDOT   log_expr
               => { CODE: RANGE_EXPR, LHS: $1, RHS: $3 }
                / log_expr

    // ── No-struct-lit expression chain ──────────────────────────
    // Used in if/while/for-cond positions where a trailing `IDENT { ... }`
    // would be greedily eaten as a struct literal, swallowing the loop's
    // own block. Mirrors Rust's "Expression with restrictions" mode.
    // Only the *top-level* primary skips struct lits; once we're inside
    // parens/brackets/calls, full `expr` resumes.
    expr_ns <- log_expr_ns

    log_expr_ns <- cmp_expr_ns
                   ( (AND / OR) cmp_expr_ns
                       => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                   )*

    cmp_expr_ns <- bitwise_expr_ns (EQ / NE / LE / GE / LT / GT) bitwise_expr_ns
                   (EQ / NE / LE / GE / LT / GT) bitwise_expr_ns
                   ((EQ / NE / LE / GE / LT / GT) bitwise_expr_ns)*
                   => { CODE: CHAINED_CMP, ITEMS: $... }
                 / bitwise_expr_ns
                   ( (EQ / NE / LE / GE / LT / GT) bitwise_expr_ns
                       => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                   )?

    bitwise_expr_ns <- add_expr_ns
                       ( (SHL / SHR / AMP / CARET / PIPE) add_expr_ns
                           => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                       )*

    add_expr_ns <- mul_expr_ns
                   ( (PLUS / MINUS) mul_expr_ns
                       => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                   )*

    mul_expr_ns <- cast_expr_ns
                   ( (STAR / SLASH / PERCENT) cast_expr_ns
                       => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                   )*

    cast_expr_ns <- unary_expr_ns
                    ( KW_AS type_ref
                        => { CODE: CAST, VALUE: $0, TYPE: $2 }
                    )*

    unary_expr_ns <- STAR  unary_expr_ns => { CODE: DEREF,      VALUE: $2 }
                   / AMP KW_MUT unary_expr_ns => { CODE: ADDR_OF_MUT, VALUE: $3 }
                   / MINUS unary_expr_ns => { CODE: UNARY,  OP: $1, VALUE: $2 }
                   / BANG  unary_expr_ns => { CODE: UNARY,  OP: $1, VALUE: $2 }
                   / AMP   unary_expr_ns => { CODE: UNARY,  OP: $1, VALUE: $2 }
                   / AND   unary_expr_ns => { CODE: UNARY,  OP: $1, VALUE: $2 }
                   / atom_ns

    atom_ns <- primary_expr_ns
               ( DOT IDENT COLONCOLON LT_TYPE type_arg_list GT_TYPE LPAREN call_arg_list? RPAREN
                   => { CODE: METHOD_CALL, RECEIVER: $0, NAME: $2, TYPE_PARAMS: $5, ARGS: $8 }
               / DOT IDENT LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
                   => { CODE: METHOD_CALL, RECEIVER: $0, NAME: $2, ARGS: $... }
               / DOT KW_NEW LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
                   => { CODE: METHOD_CALL, RECEIVER: $0, NAME: $2, ARGS: $... }
               / DOT KW_NULL LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
                   => { CODE: METHOD_CALL, RECEIVER: $0, NAME: $2, ARGS: $... }
               / DOT INTEGER
                   => { CODE: TUPLE_INDEX, RECEIVER: $0, FIELD: $2 }
               / DOT HASH LPAREN expr RPAREN
                   => { CODE: FIELD_READ, RECEIVER: $0, NAME_VAR: $4 }
               / DOT HASH IDENT
                   => { CODE: FIELD_READ, RECEIVER: $0, NAME_VAR: $3 }
               / DOT IDENT
                   => { CODE: FIELD_READ, RECEIVER: $0, FIELD: $2 }
               / DOT KW_NEW
                   => { CODE: FIELD_READ, RECEIVER: $0, FIELD: $2 }
               / DOT KW_NULL
                   => { CODE: FIELD_READ, RECEIVER: $0, FIELD: $2 }
               / LBRACKET expr RBRACKET
                   => { CODE: INDEX_READ, RECEIVER: $0, VALUE: $2 }
               / QUESTION
                   => { CODE: TRY_EXPR, VALUE: $0 }
               )*

    // primary_expr without the three IDENT-prefixed struct-lit alts.
    // Falls through to plain IDENT (VAR_REF), so `if a < b { ... }` parses
    // the cond as `a < b` and the LBRACE belongs to the if-body block.
    // To use a struct literal in cond position, parenthesize: `if (Foo {x:1}.ok) { }`.
    primary_expr_ns <- hermes_lit
                     / list_comp
                     / map_comp
                     / arr_fill_lit
                     / arr_lit
                     / LPAREN RPAREN => { CODE: TUPLE_LIT }
                     / paren_expr
                     / tuple_lit
                     / closure_expr
                     / unsafe_block
                     / loop_expr
                     / if_expr
                     / match_stmt
                     // P3-pg-04: break as expression (Rust typing it as
                     // `!`/Never). Only the bare form — labeled / value-
                     // carrying variants greedily eat following tokens.
                     // `continue` / `return` deliberately excluded since
                     // adding them to primary_expr_ns shadows the
                     // stmt-level forms (`return *v;` would parse as
                     // bare RETURN_EXPR followed by orphan `*v`).
                     / KW_BREAK    => { CODE: BREAK_EXPR }
                     / KW_METACALL block
                                        => { CODE: METACALL, VALUE: $2 }
                     / KW_METACALL LPAREN expr RPAREN
                                        => { CODE: METACALL, VALUE: $3 }
                     / KW_METACALL call_expr
                                        => { CODE: METACALL, VALUE: $2 }
                     / IDENT DOTDOTDOT LPAREN IDENT RPAREN
                                        => { CODE: SIZEOF_PACK, OP: $1, NAME: $4 }
                     / quote_item_expr
                     / quote_expr_expr
                     / quote_ty_expr
                     / call_expr
                     / IDENT COLONCOLON LT_TYPE type_arg_list GT_TYPE
                                        => { CODE: GENERIC_REF, CALLEE: $1, TYPE_PARAMS: $4 }
                     / enum_lit
                     / RAW_STRING => { CODE: LIT_STR, VALUE: $1 }
                     / STRING   => { CODE: LIT_STR,  VALUE: $1 }
                     / BYTE_STRING => { CODE: LIT_BYTES, VALUE: $1 }
                     / CHAR_LIT => { CODE: LIT_CHAR, VALUE: $1 }
                     / KW_TRUE  => { CODE: LIT_BOOL, VALUE: true }
                     / KW_FALSE => { CODE: LIT_BOOL, VALUE: false }
                     / FLOAT    => { CODE: LIT_FLOAT, VALUE: $1 }
                     / INTEGER  => { CODE: LIT_INT,  VALUE: $1 }
                     / IDENT DOTDOTDOT => { CODE: PACK_EXPAND, NAME: $1 }
                     / HASH LPAREN expr RPAREN AND STAR
                           => { CODE: REPEAT_GROUP, VALUE: $3, OP: 2 }
                     / HASH LPAREN expr RPAREN COMMA STAR
                           => { CODE: REPEAT_GROUP, VALUE: $3, OP: 1 }
                     / HASH LPAREN expr RPAREN STAR
                           => { CODE: REPEAT_GROUP, VALUE: $3, OP: 0 }
                     / HASH LPAREN expr RPAREN
                           => { CODE: VAR_REF, NAME_VAR: $3 }
                     / HASH IDENT => { CODE: VAR_REF, NAME_VAR: $2 }
                     / IDENT    => { CODE: VAR_REF,  NAME: $1 }

    log_expr <- cmp_expr
                ( (AND / OR) cmp_expr
                    => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                )*

    // Non-chainable: at most one comparison.  The CHAINED_CMP alt comes first
    // so 2+ comparators (`a < b < c`) parse cleanly and sema rejects with a
    // helpful diagnostic instead of a generic "syntax error" (B-ex-08).
    cmp_expr <- bitwise_expr (EQ / NE / LE / GE / LT / GT) bitwise_expr
                (EQ / NE / LE / GE / LT / GT) bitwise_expr
                ((EQ / NE / LE / GE / LT / GT) bitwise_expr)*
                => { CODE: CHAINED_CMP, ITEMS: $... }
              / bitwise_expr
                ( (EQ / NE / LE / GE / LT / GT) bitwise_expr
                    => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                )?

    // Bitwise and shift operators (higher precedence than comparison)
    // (zero-or-more to avoid PEG backtracking when no operator follows)
    bitwise_expr <- add_expr
                    ( (SHL / SHR / AMP / CARET / PIPE) add_expr
                        => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                    )*

    add_expr <- mul_expr
                ( (PLUS / MINUS) mul_expr
                    => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                )*

    // Rust precedence (low → high): * / %  <  as  <  unary (- * ! & &mut)
    mul_expr <- cast_expr
                ( (STAR / SLASH / PERCENT) cast_expr
                    => { CODE: BINOP, OP: $1, LHS: $0, RHS: $2 }
                )*

    // ── Cast expression: unary_expr (as type)* ──────────────────────
    // Lower precedence than unary operators.  Left-associative chaining
    // so `x as i64 as i24` folds naturally, and a bare `unary_expr`
    // pays no backtracking cost (fold-mode `*` with zero iterations
    // passes the capture through unchanged).
    cast_expr <- unary_expr
                ( KW_AS type_ref
                    => { CODE: CAST, VALUE: $0, TYPE: $2 }
                )*

    unary_expr <- STAR  unary_expr => { CODE: DEREF,      VALUE: $2 }
                / AMP KW_MUT unary_expr => { CODE: ADDR_OF_MUT, VALUE: $3 }
                / MINUS unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / BANG  unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / AMP   unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                // `&&v` — lexer collapses `&&` to AND. Sema lowers as
                // nested ADDR_OF (mirror of DOUBLE_REF_TYPE at type level).
                / AND   unary_expr => { CODE: UNARY,  OP: $1, VALUE: $2 }
                / atom

    // ── Atoms (postfix chain) ─────────────────────────────────────
    // atom = primary_expr followed by zero or more postfix suffixes.
    // The ( ... )* uses $0 (fold accumulator) for RECEIVER so that
    // a.b.c and a.f().b are parsed correctly as left-associative chains.
    atom <- primary_expr
            ( DOT IDENT COLONCOLON LT_TYPE type_arg_list GT_TYPE LPAREN call_arg_list? RPAREN
                => { CODE: METHOD_CALL, RECEIVER: $0, NAME: $2, TYPE_PARAMS: $5, ARGS: $8 }
            // P4-pm-16: bare-IIFE / expression-as-callee — `(|| body)(args)`,
            // `(get_fn())(args)`. INVOKE_EXPR with RECEIVER = callee
            // expression and ARGS = arg-list. Sema routes through the
            // existing closure-call / fn-ptr-call path. Postfix grouping
            // so chained `(…)(a)(b)` works.
            / LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
                => { CODE: INVOKE_EXPR, RECEIVER: $0, ARGS: $... }
            / DOT IDENT LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
                => { CODE: METHOD_CALL, RECEIVER: $0, NAME: $2, ARGS: $... }
            / DOT KW_NEW LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
                => { CODE: METHOD_CALL, RECEIVER: $0, NAME: $2, ARGS: $... }
            / DOT KW_NULL LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
                => { CODE: METHOD_CALL, RECEIVER: $0, NAME: $2, ARGS: $... }
            / DOT INTEGER
                => { CODE: TUPLE_INDEX, RECEIVER: $0, FIELD: $2 }
            / DOT HASH LPAREN expr RPAREN
                => { CODE: FIELD_READ, RECEIVER: $0, NAME_VAR: $4 }
            / DOT HASH IDENT
                => { CODE: FIELD_READ, RECEIVER: $0, NAME_VAR: $3 }
            / DOT IDENT
                => { CODE: FIELD_READ, RECEIVER: $0, FIELD: $2 }
            / DOT KW_NEW
                => { CODE: FIELD_READ, RECEIVER: $0, FIELD: $2 }
            / DOT KW_NULL
                => { CODE: FIELD_READ, RECEIVER: $0, FIELD: $2 }
            / LBRACKET expr RBRACKET
                => { CODE: INDEX_READ, RECEIVER: $0, VALUE: $2 }
            / QUESTION
                => { CODE: TRY_EXPR, VALUE: $0 }
            )*

    // ── Primary expressions (base of a postfix chain) ─────────────
    primary_expr <- hermes_lit    // @{...} @[...] @scalar — Hermes SDN literal (before IDENT)
                  / generic_struct_lit // IDENT::<T> { fields } — before struct_lit
                  / struct_update_lit  // IDENT { fields, ..base } — before struct_lit
                  / struct_lit       // IDENT { fields }  — before plain IDENT
                  / list_comp        // [expr for x in iter (if p)?] — before arr_fill_lit/arr_lit
                  / map_comp         // {k: v for x in iter (if p)?} — before struct_lit (no IDENT prefix, but keep early)
                  / arr_fill_lit     // [value; N]  — before arr_lit (avoids ambiguity)
                  / arr_lit          // [e1, e2, ...]
                  / LPAREN RPAREN => { CODE: TUPLE_LIT }  // () — unit value
                  / paren_expr       // (expr) — BEFORE tuple_lit so single-expr parens
                                     // don't pay the cost of tuple-lit backtracking
                                     // (common case in deeply nested `as`-cast chains).
                  / tuple_lit        // (a, b, ...)
                  / closure_expr     // |x: i32| -> i32 { ... }
                  / block            // { stmts; tail_expr }  — block-as-expression
                  / unsafe_block     // unsafe { ... }  — as expression
                  / loop_expr        // loop { ... }  — as expression (break value)
                  / if_expr          // if cond { ... } else { ... }  — as expression
                  / match_stmt       // match expr { ... }  — as expression
                  / KW_BREAK    => { CODE: BREAK_EXPR }      // P3-pg-04 (bare only)
                  / KW_METACALL block
                                     => { CODE: METACALL, VALUE: $2 }
                  / KW_METACALL LPAREN expr RPAREN
                                     => { CODE: METACALL, VALUE: $3 }
                  / KW_METACALL call_expr
                                     => { CODE: METACALL, VALUE: $2 }
                  / IDENT DOTDOTDOT LPAREN IDENT RPAREN
                                     => { CODE: SIZEOF_PACK, OP: $1, NAME: $4 }
                  / quote_item_expr
                  / quote_expr_expr
                  / quote_ty_expr

                  // Function-style macros: `name!(...)` / `name![...]` /
                  // `name!{...}`. Slice 3: raw-capture grammar — contents
                  // between balanced delimiters are stashed as source text
                  // and re-interpreted at sema time per callee marker
                  // (#[fn_macro] re-parses as expr-list; #[token_macro]
                  // lexes as TokenStream).
                  / IDENT BANG RAW_GROUP_PAREN
                                     => { CODE: FN_MACRO_CALL, CALLEE: $1, RAW_TEXT: $3 }
                  / IDENT BANG RAW_GROUP_BRACKET
                                     => { CODE: FN_MACRO_CALL, CALLEE: $1, RAW_TEXT: $3 }
                  / IDENT BANG RAW_GROUP_BRACE
                                     => { CODE: FN_MACRO_CALL, CALLEE: $1, RAW_TEXT: $3 }

                  / call_expr        // IDENT(args) / Type::method(args) — before enum_lit/IDENT
                  / IDENT COLONCOLON LT_TYPE type_arg_list GT_TYPE
                                     => { CODE: GENERIC_REF, CALLEE: $1, TYPE_PARAMS: $4 }
                  / enum_lit         // IDENT::VARIANT     — after call_expr (no parens)
                  / RAW_STRING => { CODE: LIT_STR, VALUE: $1 }
                  / STRING   => { CODE: LIT_STR,  VALUE: $1 }
                  // P4-pm-07: byte-string as expression. Sema lowers
                  // to an `[u8; N]` array literal using the decoded
                  // bytes (escapes \n/\t/\r/\0/\\/\"/\x.. supported,
                  // matching the PAT_BYTES decoder).
                  / BYTE_STRING => { CODE: LIT_BYTES, VALUE: $1 }
                  / CHAR_LIT => { CODE: LIT_CHAR, VALUE: $1 }
                  / KW_TRUE  => { CODE: LIT_BOOL, VALUE: true }
                  / KW_FALSE => { CODE: LIT_BOOL, VALUE: false }
                  / FLOAT    => { CODE: LIT_FLOAT, VALUE: $1 }
                  / INTEGER  => { CODE: LIT_INT,  VALUE: $1 }
                  / IDENT DOTDOTDOT => { CODE: PACK_EXPAND, NAME: $1 }
                  / HASH LPAREN expr RPAREN AND STAR
                        => { CODE: REPEAT_GROUP, VALUE: $3, OP: 2 }
                  / HASH LPAREN expr RPAREN COMMA STAR
                        => { CODE: REPEAT_GROUP, VALUE: $3, OP: 1 }
                  / HASH LPAREN expr RPAREN STAR
                        => { CODE: REPEAT_GROUP, VALUE: $3, OP: 0 }
                  / HASH LPAREN expr RPAREN
                        => { CODE: VAR_REF, NAME_VAR: $3 }
                  / HASH IDENT => { CODE: VAR_REF, NAME_VAR: $2 }
                  / IDENT    => { CODE: VAR_REF,  NAME: $1 }

    // ── Enum variant literal: Color::Red or Option::Some(42) ──────
    enum_lit_args <- LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
                  => { ITEMS: $... }

    enum_lit :group variant: <- IDENT COLONCOLON IDENT COLONCOLON LT_TYPE type_arg_list GT_TYPE enum_lit_args
             => { CODE: ENUM_LIT_DATA, NAME: $1, FIELD: $3, TYPE_PARAMS: $6, ARGS: $8 }
              / IDENT COLONCOLON IDENT COLONCOLON LT_TYPE type_arg_list GT_TYPE
             => { CODE: ENUM_LIT, NAME: $1, FIELD: $3, TYPE_PARAMS: $6 }
              / IDENT COLONCOLON IDENT LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
             => { CODE: ENUM_LIT_DATA, NAME: $1, FIELD: $3, ARGS: $... }
              // P4-pm-01: struct-shape variant ctor `E::V { x: e, y: e }`.
              // Reuses field_init (used by struct literals); sema looks
              // up the variant, resolves field names → positional
              // indices via payload_field_names, type-checks, and
              // builds an EEnumLitData with the canonical positional
              // payload.
              / IDENT COLONCOLON IDENT LBRACE (field_init (COMMA field_init)* COMMA?)? RBRACE
             => { CODE: ENUM_LIT_DATA, NAME: $1, FIELD: $3, IS_STRUCT_SHAPE: 1, ITEMS: $... }
              / IDENT COLONCOLON IDENT
             => { CODE: ENUM_LIT, NAME: $1, FIELD: $3 }

    // ── Struct literal: TypeName { field: expr, ... } ─────────────
    // Generic form: TypeName::<T, U> { field: expr, ... }
    generic_struct_lit <- IDENT COLONCOLON LT_TYPE type_arg_list GT_TYPE LBRACE (field_init (COMMA field_init)* COMMA?)? RBRACE
                       => { CODE: STRUCT_LIT, NAME: $1, TYPE_PARAMS: $4, ITEMS: $... }

    // Struct update syntax: TypeName { field: val, ..base } or TypeName { ..base }
    // or TypeName { ..base, field: val } (B-li-04; field-order doesn't change
    // semantics — explicit fields always override base).
    struct_update_lit <- IDENT LBRACE field_init (COMMA field_init)* COMMA DOTDOT expr RBRACE
                      => { CODE: STRUCT_LIT, NAME: $1, ITEMS: $..., BASE: $7 }
                       / IDENT LBRACE DOTDOT expr COMMA field_init (COMMA field_init)* COMMA? RBRACE
                      => { CODE: STRUCT_LIT, NAME: $1, BASE: $4, ITEMS: $... }
                       / IDENT LBRACE DOTDOT expr RBRACE
                      => { CODE: STRUCT_LIT, NAME: $1, BASE: $4 }

    struct_lit <- HASH LPAREN expr RPAREN LBRACE (field_init (COMMA field_init)* COMMA?)? RBRACE
               => { CODE: STRUCT_LIT, NAME_VAR: $3, ITEMS: $... }
                / HASH IDENT LBRACE (field_init (COMMA field_init)* COMMA?)? RBRACE
               => { CODE: STRUCT_LIT, NAME_VAR: $2, ITEMS: $... }
                / IDENT LBRACE (field_init (COMMA field_init)* COMMA?)? RBRACE
               => { CODE: STRUCT_LIT, NAME: $1, ITEMS: $... }

    // Antiquot alts (only valid inside `quote_expr!` body — sema gates) come
    // first; they enable `#(expr): expr` for a placeholder field name and
    // `#(field_init),*` for cursor-expanded field-init lists in struct literals.
    field_init <- HASH LPAREN field_init RPAREN COMMA STAR
               => { CODE: REPEAT_GROUP, VALUE: $3, OP: 1 }
              / HASH LPAREN expr RPAREN COLON expr
               => { CODE: FIELD_INIT, NAME_VAR: $3, VALUE: $6 }
              / HASH IDENT COLON expr
               => { CODE: FIELD_INIT, NAME_VAR: $2, VALUE: $4 }
              / IDENT COLON expr
               => { CODE: FIELD_INIT, NAME: $1, VALUE: $3 }
              / KW_NEW COLON expr
               => { CODE: FIELD_INIT, NAME: $1, VALUE: $3 }
              / KW_NULL COLON expr
               => { CODE: FIELD_INIT, NAME: $1, VALUE: $3 }
              / IDENT
               => { CODE: FIELD_SHORTHAND, NAME: $1 }

    // ── Array fill literal: [value; N] ───────────────────────────
    // First alt: [v; sizeof...(P)] — size from variadic pack length,
    // mirrors the form admitted by arr_type at the type level.
    arr_fill_lit <- LBRACKET expr SEMI IDENT DOTDOTDOT LPAREN IDENT RPAREN RBRACKET
                 => { CODE: ARR_FILL_LIT, VALUE: $2, OP: $4, NAME: $7 }
                  / LBRACKET expr SEMI KW_METACALL block RBRACKET
                 => { CODE: ARR_FILL_LIT, VALUE: $2, BODY: $5 }
                  / LBRACKET expr SEMI INTEGER RBRACKET
                 => { CODE: ARR_FILL_LIT, VALUE: $2, SIZE: $4 }

    // ── List comprehension: [expr for x in iter (if p)?] ─────────
    list_comp <- LBRACKET expr KW_FOR IDENT KW_IN expr KW_IF expr RBRACKET
              => { CODE: LIST_COMP, VALUE: $2, NAME: $4, ITER: $6, GUARD: $8 }
               / LBRACKET expr KW_FOR IDENT KW_IN expr RBRACKET
              => { CODE: LIST_COMP, VALUE: $2, NAME: $4, ITER: $6 }

    // ── Map comprehension: {kexpr: vexpr for x in iter (if p)?} ──
    map_comp <- LBRACE expr COLON expr KW_FOR IDENT KW_IN expr KW_IF expr RBRACE
             => { CODE: MAP_COMP, KEY: $2, VALUE: $4, NAME: $6, ITER: $8, GUARD: $10 }
              / LBRACE expr COLON expr KW_FOR IDENT KW_IN expr RBRACE
             => { CODE: MAP_COMP, KEY: $2, VALUE: $4, NAME: $6, ITER: $8 }

    // ── Hermes SDN literals: @{k:v,...}  @[v,...]  @"s"  @42  @true  @null ──
    // @<ElemType>[v,...] — typed dense array (e.g. @<I32>[1,2,3])
    // @<K,V>{...} / @<K>{...} — typed map (e.g. @<I32,AnyVal>{1:42})
    // Only the outermost literal needs the @ sigil; inner values are plain.
    hermes_typed_array <- LT IDENT GT LBRACKET (hermes_val (COMMA hermes_val)* COMMA?)? RBRACKET
                       => { CODE: HERMES_TYPED_ARRAY, TYPE: $2, ITEMS: $... }

    hermes_typed_map <- LT IDENT COMMA IDENT GT LBRACE (hermes_entry (COMMA hermes_entry)* COMMA?)? RBRACE
                     => { CODE: HERMES_TYPED_MAP, TYPE: $2, RET_TYPE: $4, ITEMS: $... }
                     / LT IDENT GT LBRACE (hermes_entry (COMMA hermes_entry)* COMMA?)? RBRACE
                     => { CODE: HERMES_TYPED_MAP, TYPE: $2, ITEMS: $... }

    hermes_list_comp <- AT LBRACKET expr KW_FOR IDENT KW_IN expr KW_IF expr RBRACKET
                     => { CODE: HERMES_LIST_COMP, VALUE: $3, NAME: $5, ITER: $7, GUARD: $9 }
                      / AT LBRACKET expr KW_FOR IDENT KW_IN expr RBRACKET
                     => { CODE: HERMES_LIST_COMP, VALUE: $3, NAME: $5, ITER: $7 }

    hermes_map_comp <- AT LBRACE expr COLON expr KW_FOR IDENT KW_IN expr KW_IF expr RBRACE
                    => { CODE: HERMES_MAP_COMP, KEY: $3, VALUE: $5, NAME: $7, ITER: $9, GUARD: $11 }
                     / AT LBRACE expr COLON expr KW_FOR IDENT KW_IN expr RBRACE
                    => { CODE: HERMES_MAP_COMP, KEY: $3, VALUE: $5, NAME: $7, ITER: $9 }

    hermes_lit <- hermes_list_comp
               / hermes_map_comp
               / AT hermes_typed_map
               / AT hermes_typed_array
               / AT hermes_map
               / AT hermes_array
               / AT RAW_STRING => { CODE: HERMES_STR, VALUE: $2 }
               / AT STRING     => { CODE: HERMES_STR, VALUE: $2 }
               / AT FLOAT      => { CODE: HERMES_FLOAT, VALUE: $2 }
               / AT MINUS INTEGER => { CODE: HERMES_NEG_INT, VALUE: $3 }
               / AT INTEGER    => { CODE: HERMES_INT, VALUE: $2 }
               / AT KW_TRUE    => { CODE: HERMES_BOOL, VALUE: true }
               / AT KW_FALSE   => { CODE: HERMES_BOOL, VALUE: false }
               / AT KW_NULL    => { CODE: HERMES_NULL }

    hermes_map <- LBRACE (hermes_entry (COMMA hermes_entry)* COMMA?)? RBRACE
               => { CODE: HERMES_MAP, ITEMS: $... }

    hermes_array <- LBRACKET (hermes_val (COMMA hermes_val)* COMMA?)? RBRACKET
                 => { CODE: HERMES_ARRAY, ITEMS: $... }

    // key can be a quoted string, integer, or negative integer (for TinyObjectMap-style maps)
    hermes_entry <- STRING COLON hermes_val
                 => { CODE: HERMES_ENTRY, KEY: $1, VALUE: $3 }
                 / MINUS INTEGER COLON hermes_val
                 => { CODE: HERMES_ENTRY, KEY: $2, VALUE: $4, LO_NEG: true }
                 / INTEGER COLON hermes_val
                 => { CODE: HERMES_ENTRY, KEY: $1, VALUE: $3 }

    // recursive: inner values don't need the @ prefix, but accept it too
    // (closes B-he-01 — nested `@{...}` / `@[...]` inside another hermes literal).
    // $ident and ${expr} are runtime capture placeholders
    // <type:T> embeds a Logos Type as a first-class Hermes value.
    // Slot extraction (CFG.path) keeps the IDENT-only head; the general
    // form accepts any simple_type so generic instantiations like
    // Vec<u8> / Result<T,E> reach sema as a structured TYPE child (3a').
    hermes_val <- LT KW_TYPE COLON IDENT path_step path_step* GT_TYPE
               => { CODE: CFG_SLOT_TYPE, NAME: $4, ITEMS: $... }
               / LT KW_TYPE COLON simple_type GT_TYPE
               => { CODE: HERMES_TYPE_LIT, TYPE: $4 }
               / DOLLAR LBRACE expr RBRACE => { CODE: HERMES_CAP_EXPR, VALUE: $3 }
               / DOLLAR IDENT              => { CODE: HERMES_CAP_IDENT, NAME: $2 }
               / AT hermes_typed_array
               / AT hermes_map
               / AT hermes_array
               / hermes_map
               / hermes_array
               / RAW_STRING => { CODE: HERMES_STR, VALUE: $1 }
               / STRING     => { CODE: HERMES_STR, VALUE: $1 }
               / FLOAT      => { CODE: HERMES_FLOAT, VALUE: $1 }
               / MINUS INTEGER => { CODE: HERMES_NEG_INT, VALUE: $2 }
               / INTEGER    => { CODE: HERMES_INT, VALUE: $1 }
               / KW_TRUE    => { CODE: HERMES_BOOL, VALUE: true }
               / KW_FALSE   => { CODE: HERMES_BOOL, VALUE: false }
               / KW_NULL    => { CODE: HERMES_NULL }

    // ── Array literal: [e1, e2, ...] ─────────────────────────────
    arr_lit <- LBRACKET (expr (COMMA expr)* COMMA?)? RBRACKET
            => { CODE: ARR_LIT, ITEMS: $... }

    // ── Tuple literal: (expr, expr, ...) — 2+ elements ────────────
    tuple_lit <- LPAREN expr COMMA expr (COMMA expr)* RPAREN
              => { CODE: TUPLE_LIT, ITEMS: $... }
               / LPAREN expr COMMA RPAREN
              => { CODE: TUPLE_LIT, ITEMS: $... }

    // ── Closure expression ────────────────────────────────────────
    // |x: i32, y: i32| -> i32 { return x + y; }
    // |x: i32| { return x + 1; }
    // || -> i32 { return 42; }
    closure_expr <- KW_MOVE OR ARROW type_ref block
                 => { CODE: CLOSURE_EXPR, IS_MOVE: 1, RET_TYPE: $4, BODY: $5 }
                  / KW_MOVE OR block
                 => { CODE: CLOSURE_EXPR, IS_MOVE: 1, BODY: $3 }
                  / KW_MOVE PIPE param_list? PIPE ARROW type_ref block
                 => { CODE: CLOSURE_EXPR, IS_MOVE: 1, PARAMS: $3, RET_TYPE: $6, BODY: $7 }
                  / KW_MOVE PIPE param_list? PIPE block
                 => { CODE: CLOSURE_EXPR, IS_MOVE: 1, PARAMS: $3, BODY: $5 }
                  / OR ARROW type_ref block
                 => { CODE: CLOSURE_EXPR, RET_TYPE: $3, BODY: $4 }
                  / OR block
                 => { CODE: CLOSURE_EXPR, BODY: $2 }
                  / PIPE param_list? PIPE ARROW type_ref block
                 => { CODE: CLOSURE_EXPR, PARAMS: $2, RET_TYPE: $5, BODY: $6 }
                  / PIPE param_list? PIPE block
                 => { CODE: CLOSURE_EXPR, PARAMS: $2, BODY: $4 }

    // ── Parenthesised expression ──────────────────────────────────
    paren_expr <- LPAREN expr RPAREN
               => { CODE: PAREN_EXPR, VALUE: $2 }

    // ── quote_item! { item* } — typed AST literal ─────────────────
    // Slice 4 of metaprog-quote (~/.claude/plans/metaprog-quote.md):
    // body parses as zero or more `item` declarations. Sema deep-clones
    // those items into a fresh Hermes module, serialises bytes, and
    // emits a HermesStatic literal — the expression value is the byte
    // slice that Slice 3's logos_emit_item_blob consumes.
    quote_item_expr <- KW_QUOTE_ITEM BANG LBRACE item* RBRACE
                    => { CODE: QUOTE_ITEM, ITEMS: $4 }

    // ── quote_expr! { expr } — typed AST literal (Slice 7) ─────────
    // Body is a single expression. Sema deep-clones the parsed expr
    // AnyVal as the root TOM of a fresh Hermes doc, sets the root's
    // schema_type_code from CODE so position-aware lower_hermes_blob
    // can recurse into lower_expr at splice time, and emits an
    // ExprBlob value. Splices via metacall, like ExprBlob returns.
    quote_expr_expr <- KW_QUOTE_EXPR BANG LBRACE expr RBRACE
                   => { CODE: QUOTE_EXPR, VALUE: $4 }

    // ── quote_ty! { type } — typed Type literal (Slice 1 of quote_ty epic) ──
    // MVP: body is a single type expression; sema resolves it to a TypeRef
    // and emits the same Type{kind, name, size} struct literal that
    // type_of::<T>() produces. Future slices add `$t` antiquotation and
    // pack-splice `$ts...` for runtime-composed type values.
    quote_ty_expr <- KW_QUOTE_TY BANG LBRACE type_ref RBRACE
                  => { CODE: QUOTE_TY, TYPE: $4 }

    // ── Type parameter list: <T, U: Bound1 + Bound2> ─────────────
    // Also used for specialisation patterns: <i32>, <*T>, <[T; 4]>, etc.
    // Detection (TypeVar vs concrete) is done in sema, not in the grammar.
    type_param_list <- LT type_param (COMMA type_param)* COMMA? GT
                    => { ITEMS: $... }

    // HRTB: `for<'a (, 'b)*> Trait<...>`. Logos doesn't track
    // lifetimes structurally, so the binder is parsed-then-dropped —
    // semantically `for<'a> Fn(&'a T)` ≡ `Fn(&T)` here. We accept the
    // prefix in every trait_bound alt below by parsing it into a
    // disposable head.
    // Each binder lifetime wraps in a LIFETIME_PARAM sub-node so the parent's
    // $... collector (which only picks up rule results, not bare terminals)
    // actually records the names.
    hrtb_lt <- LIFETIME
            => { CODE: LIFETIME_PARAM, NAME: $1 }
    hrtb_binder <- KW_FOR LT hrtb_lt (COMMA hrtb_lt)* COMMA? GT_TYPE
                =>  { ITEMS: $... }
    hrtb_opt <- hrtb_binder?
             =>  { ITEMS: $... }

    trait_bound <- hrtb_binder IDENT LT bound_arg_list GT_TYPE
                => { CODE: TRAIT_BOUND, NAME: $2, HRTB_BINDERS: $1, TYPE_PARAMS: $4 }
                 / hrtb_binder IDENT LPAREN closure_type_args RPAREN ARROW type_ref
                => { CODE: TRAIT_BOUND, NAME: $2, HRTB_BINDERS: $1, PARAMS: $4, RET_TYPE: $7 }
                 / hrtb_binder IDENT LPAREN RPAREN ARROW type_ref
                => { CODE: TRAIT_BOUND, NAME: $2, HRTB_BINDERS: $1, RET_TYPE: $6 }
                 / hrtb_binder IDENT LPAREN closure_type_args RPAREN
                => { CODE: TRAIT_BOUND, NAME: $2, HRTB_BINDERS: $1, PARAMS: $4 }
                 / hrtb_binder IDENT LPAREN RPAREN
                => { CODE: TRAIT_BOUND, NAME: $2, HRTB_BINDERS: $1 }
                 / hrtb_binder IDENT
                => { CODE: TRAIT_BOUND, NAME: $2, HRTB_BINDERS: $1 }
                 / IDENT LT bound_arg_list GT_TYPE
                => { CODE: TRAIT_BOUND, NAME: $1, TYPE_PARAMS: $3 }
                 // Fn-family parenthesized form: `Fn(T1, ...) -> R` /
                 // `FnMut(T)` / `FnOnce()`. The arg-type list lives in
                 // PARAMS (parallel to IDENT<...>'s TYPE_PARAMS slot)
                 // and the optional `-> R` in RET_TYPE.
                 / IDENT LPAREN closure_type_args RPAREN ARROW type_ref
                => { CODE: TRAIT_BOUND, NAME: $1, PARAMS: $3, RET_TYPE: $6 }
                 / IDENT LPAREN RPAREN ARROW type_ref
                => { CODE: TRAIT_BOUND, NAME: $1, RET_TYPE: $5 }
                 / IDENT LPAREN closure_type_args RPAREN
                => { CODE: TRAIT_BOUND, NAME: $1, PARAMS: $3 }
                 / IDENT LPAREN RPAREN
                => { CODE: TRAIT_BOUND, NAME: $1 }
                 / IDENT
                => { CODE: TRAIT_BOUND, NAME: $1 }

    // Inside a trait bound's `<...>` either positional type args or
    // associated-type equality clauses (Name = Type) may appear, mixed.
    bound_arg_list <- bound_arg (COMMA bound_arg)*
                   => { ITEMS: $... }

    bound_arg <- IDENT ASSIGN type_ref
              => { CODE: ASSOC_EQ_BIND, NAME: $1, TYPE: $3 }
               / type_or_lt_arg

    // B65: outlives lifetime — wraps LIFETIME so $... in lifetime_param /
    // type_param actually captures the outlives names (bare LIFETIME tokens
    // don't flow into the rule-captures array). Same shape as hrtb_lt.
    outlives_lt <- LIFETIME
                => { CODE: LIFETIME_PARAM, NAME: $1 }

    // Lifetime parameter: 'a; with outlives bound: 'a: 'b (+ 'c)*
    lifetime_param <- LIFETIME COLON outlives_lt (PLUS outlives_lt)*
                   => { CODE: LIFETIME_PARAM, NAME: $1, ITEMS: $... }
                    / LIFETIME
                   => { CODE: LIFETIME_PARAM, NAME: $1 }

    type_param <- HASH LPAREN type_param RPAREN COMMA STAR
               => { CODE: REPEAT_GROUP, VALUE: $3, OP: 1 }
                / lifetime_param
                // Type outlives bound: T: 'a (+ 'b)*  — must come before
                // the trait-bound form below so the `'` lookahead resolves.
                // Stored as TYPE_PARAM where every ITEMS element is a
                // LIFETIME_PARAM (vs trait_bound for the regular trait-
                // bound case). Sema's bound-walker distinguishes the two
                // shapes via the ITEMS element code.
                / IDENT COLON lifetime_param (PLUS lifetime_param)*
               => { CODE: TYPE_PARAM, NAME: $1, ITEMS: $... }
                / ptr_type
                / arr_type
                / KW_CONST IDENT DOTDOTDOT COLON type_ref
               => { CODE: CONST_PARAM, NAME: $2, IS_VARIADIC: true, TYPE: $5 }
                / KW_CONST HASH IDENT COLON type_ref
               => { CODE: CONST_PARAM, NAME_VAR: $3, TYPE: $5 }
                / KW_CONST IDENT COLON type_ref
               => { CODE: CONST_PARAM, NAME: $2, TYPE: $4 }
                / IDENT DOTDOTDOT COLON trait_bound (PLUS trait_bound)*
               => { CODE: TYPE_PARAM, NAME: $1, IS_VARIADIC: true, ITEMS: $... }
                / IDENT DOTDOTDOT
               => { CODE: TYPE_PARAM, NAME: $1, IS_VARIADIC: true }
                / HASH IDENT COLON trait_bound (PLUS trait_bound)*
               => { CODE: TYPE_PARAM, NAME_VAR: $2, ITEMS: $... }
                / HASH IDENT
               => { CODE: TYPE_PARAM, NAME_VAR: $2 }
                / IDENT COLON trait_bound (PLUS trait_bound)*
               => { CODE: TYPE_PARAM, NAME: $1, ITEMS: $... }
                / IDENT
               => { CODE: TYPE_PARAM, NAME: $1 }

    // ── Type argument list (for generic instantiation in types): Vec<i32> ─
    type_arg_list <- type_or_lt_arg (COMMA type_or_lt_arg)* COMMA?
                  => { ITEMS: $... }

    // ── Value argument list (for call sites) ─────────────────────
    call_arg_list <- expr (COMMA expr)* COMMA?
                  => { ITEMS: $... }

    // ── Free function call: fn(args) or fn::<T>(args) or Class::method(args) ─
    //                       or Class::<T>::method(args) — turbofish on the type.
    call_expr <- IDENT COLONCOLON LT_TYPE type_arg_list GT_TYPE COLONCOLON IDENT LPAREN call_arg_list? RPAREN
              => { CODE: STATIC_CALL, RECEIVER: $1, TYPE_PARAMS: $4, NAME: $7, ARGS: $9 }
               / IDENT COLONCOLON LT_TYPE type_arg_list GT_TYPE COLONCOLON KW_NEW LPAREN call_arg_list? RPAREN
              => { CODE: STATIC_CALL, RECEIVER: $1, TYPE_PARAMS: $4, NAME: $7, ARGS: $9 }
               / IDENT COLONCOLON LT_TYPE type_arg_list GT_TYPE LPAREN call_arg_list? RPAREN
              => { CODE: GENERIC_CALL, CALLEE: $1, TYPE_PARAMS: $4, ARGS: $7 }
               / KW_NEW COLONCOLON LT_TYPE type_arg_list GT_TYPE LPAREN call_arg_list? RPAREN
              => { CODE: GENERIC_CALL, CALLEE: $1, TYPE_PARAMS: $4, ARGS: $7 }
               / KW_NULL COLONCOLON LT_TYPE type_arg_list GT_TYPE LPAREN call_arg_list? RPAREN
              => { CODE: GENERIC_CALL, CALLEE: $1, TYPE_PARAMS: $4, ARGS: $7 }
               / IDENT COLONCOLON IDENT  LPAREN call_arg_list? RPAREN
              => { CODE: STATIC_CALL, RECEIVER: $1, NAME: $3, ARGS: $5 }
               / IDENT COLONCOLON KW_NEW LPAREN call_arg_list? RPAREN
              => { CODE: STATIC_CALL, RECEIVER: $1, NAME: $3, ARGS: $5 }
               / HASH IDENT LPAREN RPAREN
              => { CODE: CALL, NAME_VAR: $2, ARGS: $... }
               / HASH IDENT LPAREN expr (COMMA expr)* COMMA? RPAREN
              => { CODE: CALL, NAME_VAR: $2, ARGS: $... }
               / HASH LPAREN expr RPAREN LPAREN RPAREN
              => { CODE: CALL, NAME_VAR: $3, ARGS: $... }
               / HASH LPAREN expr RPAREN LPAREN expr (COMMA expr)* COMMA? RPAREN
              => { CODE: CALL, NAME_VAR: $3, ARGS: $... }
               / IDENT LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
              => { CODE: CALL, CALLEE: $1, ARGS: $... }
               / KW_NEW LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
              => { CODE: CALL, CALLEE: $1, ARGS: $... }
               / KW_NULL LPAREN (expr (COMMA expr)* COMMA?)? RPAREN
              => { CODE: CALL, CALLEE: $1, ARGS: $... }
}
