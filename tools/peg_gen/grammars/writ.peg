// Logos project — https://github.com/victor-smirnov/logos
//
// Writ data format grammar.
//
// This grammar can be %imported by other grammars (SQL, DSL) to add native
// Writ literal support.
//
// Exported rules: value, map, array, typed_value, typed_collection.

%meta {
    name:      "writ"
    version:   "1.0"
    namespace: "logos::writ"
    output:    "writ_parser"
}

%export { value map array typed_value typed_collection }

// ── AST field keys ────────────────────────────────────────────────────────
%fields {
    CODE        = 0
    VALUE       = 1
    KEY         = 2
    ITEMS       = 3
    NAME        = 4
    PARAMS      = 5
    SRC_LINE    = 6
}

// ── AST node codes ────────────────────────────────────────────────────────
%nodes {
    MAP         = 0
    ARRAY       = 1
    STRING      = 2
    INTEGER     = 3
    FLOAT       = 4
    BOOLEAN     = 5
    NULL_VAL    = 6
    TYPED_VALUE = 7     // Typename(value)  e.g. Date("2026-01-01")
    DATATYPE    = 8     // Typename<Param, ...>
    MAP_ENTRY   = 9
    PARAM_VAL   = 10    // $N  — positional PARAM placeholder (type_hash=127)
}

// ── Tokens ────────────────────────────────────────────────────────────────
%tokens {
    // Punctuation
    LBRACE      = "{"
    RBRACE      = "}"
    LBRACKET    = "["
    RBRACKET    = "]"
    LPAREN      = "("
    RPAREN      = ")"
    LANGLE      = "<"
    RANGLE      = ">"
    COLON       = ":"
    COMMA       = ","
    EQUALS      = "="
    DOLLAR      = "$"

    // Literals
    TRUE        = "true"
    FALSE       = "false"
    NULL        = "null"
    STRING      = /"([^"\\]|\\.)*"/
    INTEGER     = /[-]?(0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|[0-9]+)(_(u|s)(8|16|32|64)|ull|ul|ll|u)?/
    FLOAT       = /[-]?[0-9]*\.[0-9]+([eE][+-]?[0-9]+)?[fd]?/

    // Identifier (used as map keys and type names)
    IDENT       = /[a-zA-Z_][a-zA-Z0-9_]*/

    // Skip
    %skip       = /[ \t\n\r]+/
    %skip       = /\/\/[^\n]*/     // line comment
    %skip       = /\/\*.*?\*\//    // block comment (non-greedy)
}

// ── Rules ─────────────────────────────────────────────────────────────────
%rules {
    // Top-level value — the entry point for embedding in other grammars.
    value <- param_val
           / typed_value
           / typed_collection
           / map
           / array
           / STRING      => { CODE: STRING,   VALUE: $1 }
           / FLOAT       => { CODE: FLOAT,    VALUE: $1 }
           / INTEGER     => { CODE: INTEGER,  VALUE: $1 }
           / TRUE        => { CODE: BOOLEAN,  VALUE: true }
           / FALSE       => { CODE: BOOLEAN,  VALUE: false }
           / NULL        => { CODE: NULL_VAL }

    // { key: value, ... }
    map <- LBRACE (map_entry (COMMA map_entry)*)? COMMA? RBRACE
        => { CODE: MAP, ITEMS: $... }

    map_entry <- (STRING / IDENT) COLON value
              => { CODE: MAP_ENTRY, KEY: $1, VALUE: $3 }

    // [ value, ... ]
    array <- LBRACKET (value (COMMA value)*)? COMMA? RBRACKET
          => { CODE: ARRAY, ITEMS: $... }

    // TypeName(value)  — typed value constructor, e.g. Date("2026-01-01")
    typed_value <- datatype LPAREN value RPAREN
                => { CODE: TYPED_VALUE, NAME: $1, VALUE: $3 }

    // Typed collections:
    //   <T>[...]        — typed array
    //   <K>{...}        — typed map, V defaults to AnyVal
    //   <K,V>{...}      — typed map
    // Runtime Writ parser keeps type params as syntax hints and returns
    // regular ARRAY / MAP nodes.
    typed_collection <- typed_array / typed_map

    typed_array <- LANGLE datatype RANGLE array

    typed_map <- LANGLE datatype RANGLE map
              / LANGLE datatype COMMA datatype RANGLE map

    // TypeName  or  TypeName<Arg, Arg>
    // Arg can be a nested datatype or a non-type integer literal (C++-like).
    // Generic argument list is non-empty when '<...>' is present.
    datatype <- IDENT (LANGLE type_arg (COMMA type_arg)* RANGLE)?
             => { CODE: DATATYPE, NAME: $1, PARAMS: $... }

    type_arg <- datatype
             / INTEGER

    // $N — positional PARAM placeholder (type_hash=127, tag=0xFF).
    // Used in document templates; N is a non-negative decimal integer.
    param_val <- DOLLAR INTEGER
              => { CODE: PARAM_VAL, VALUE: $2 }
}
