// Logos standard library — logos.lcm.canon.writcell
//
// A Writ object as a container cell (ADR 0039 M1w). An ordered_map declared
// `entry { key: K, val: WritObjectData }` stores each object as one VLE value:
// its type tag (8 bytes, little-endian) followed by its tagless run. The tag
// rides the cell because the column is heterogeneous (any object kind); the
// run is position-independent, so reading back is one copy, no fix-up.
// The surface on the family handle (try_insert_obj / insert_obj / get_obj)
// is generated by the container factory on the `"writ"` CFG flag.

package logos.lcm.canon.writcell;

use logos.lang.writ.objdata;
use logos.lang.option;
use logos.lang.slice;
use logos.mem.collections.vec;

/// Appends the cell bytes of `v` to `out`: its tag, then its run.
pub fn writ_cell_bytes(v: &WritObjectData, out: &mut Vec<u8>) {
    let t: u64 = v.tag();
    let mut i: u64 = 0u64;
    while i < 8u64 { out.push(((t >> (8u64 * i)) & 255u64) as u8); i = i + 1u64; }
    let p: *const u8 = v.as_ptr();
    let mut j: i64 = 0i64;
    while j < v.len() { out.push(unsafe { *p.byte_add(j) }); j = j + 1i64; }
}

/// The object a cell holds, as an owned copy; None for an empty slice (no cell).
pub fn writ_of_cell(b: &[u8]) -> Option<WritObjectData> {
    if b.len() < 8i64 { return Option::None; }
    let mut t: u64 = 0u64;
    let mut i: i64 = 0i64;
    while i < 8i64 { t = t | ((b[i] as u64) << (8u64 * (i as u64))); i = i + 1i64; }
    return Option::Some(unsafe { wod_from_raw(b.as_ptr().byte_add(8i64), b.len() - 8i64, t) });
}
