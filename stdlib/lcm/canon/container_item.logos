// logos.lcm.canon.container_item — the `container` ITEM lowering backend
// (ADR 0020 wave-0, Memoria container-interface plane).
//
// A CONTAINER declaration names a relational interface over a backing type:
//
//   pub container Vector<T> for VecCtr<T> { kind vector; entry { elem: T } measure count; }
//
// The responsibility chain is rigid (ADR 0020 §5): the COMPILER records the
// declaration and serializes it to a one-line spec string; THIS handler
// mirrors the spec to the FACT Writ doc; CANON (deem rules over the fact doc)
// returns verdicts; the handler consumes verdicts and emits (or diagnoses).
// Canon never emits; this handler never decides.
//
// Wave-0 M2 scope: spec → fact doc + shape sanity. Canon verdicts (M3) and
// the Vector scan-projection emission (M4) attach behind the fact mirror.
//
// The spec string (compiler → handler; sema lower_container_def): one line,
// `|`-separated `k=v` in fixed key order, values never containing `|`:
//
//   pub=1|generics=<T>|gnames=T|backing=VecCtr<T>|backing_pkg=|kind=vector|entry=elem:T:1|measures=count
//
// entry cols = comma-separated `name:ty:is_param(0|1)`; measures =
// comma-separated `mfn` or `mfn(arg)`.
package logos.lcm.canon.container_item;

use logos.std.compiler.metaprog;   // ItemList, item_list_new, error, Emitter
use logos.lcm.canon.canon;         // canon_verdicts — the JUDGE (ADR 0020 §5)
use logos.lang.writ.container;     // Writ, writ_new
use logos.lang.writ.wmap;          // doc.map / WMap::set
use logos.lang.writ.array;         // doc.array / WArray::push
use logos.lang.writ.anyval;        // WAny
use logos.lang.writ.wstring;       // WString (read-back checks)
use logos.lang.str;                // str_byte_at, str_eq, str_from_raw
use logos.mem.string;              // String (diagnostic composition)
use logos.mem.fmt;                 // fmt_display_to_string — geometry splices
use logos.lcm.canon.vocab;        // shared fact/verdict vocabulary (no bare strings across the Canon seam)
use logos.mem.bt.ops;             // NOT used here — carries the MODULE-GRAPH edge
use logos.lcm.canon.alg_kernel;   // the node stream-CRUD kernel generator
                                  // (ADR 0023 S4): the leaf's mutation
                                  // mechanics are generated ALGEBRA kernels
use logos.lang.option;            // Option — the kernel-blob drain loop
use logos.mem.bt.storecfg;        // StoreCfg — the store-configuration plane
                                  // (MEM_STORE_NODE splice + geometry) the
                                  // emitters bake into generated families
                                  // for the emitted ordered_map blobs: an emitted
                                  // `use logos.mem.bt.ops;` resolves names but
                                  // cannot itself LOAD a module (same contract as
                                  // map.logos's bt.node edge). Every declaring
                                  // unit imports THIS handler module, so bt.ops
                                  // rides into its graph from here. map/memstore
                                  // can't carry it — ops imports both (cycle).
use logos.lcm.canon.metaclass;    // NOT used here — the same MODULE-GRAPH edge
                                  // contract for the DECL-SITE emission (ADR 0021
                                  // Phase 4b): the emitted `type <Name> =
                                  // CtrClass<<Name>Cfg>` alias names
                                  // CtrClass, so the metaclass module must
                                  // ride into every declaring unit's graph.
use logos.mem.bt.btfl;            // NOT used here — the MODULE-GRAPH edge for
                                  // the generated multimap family blobs
                                  // (BTFL 8b): the emitted `use logos.mem.bt.
                                  // btfl;` resolves Btfl<2, CowProfile>/btfl_* but cannot
                                  // itself LOAD the module; this edge carries
                                  // it (and pkd.ssrle/sseq transitively) into
                                  // every declaring unit's graph.

unsafe fn cf_sub(s: str, a: i64, b: i64) -> str {
    let l: i64 = if b > a { b - a } else { 0i64 };
    return str_from_raw((s.as_ptr() as i64 + a) as *const u8, l);
}

fn cf_find(s: str, from: i64, c: u8) -> i64 {
    let n: i64 = s.len();
    let mut i: i64 = from;
    while i < n {
        if str_byte_at(s, i) == c {
            return i;
        }
        i = i + 1i64;
    }
    return -1i64;
}

// Index of the next TOP-LEVEL `,` in s[from, end) — commas nested in
// `<…>` / `(…)` / `[…]` (generic args in a column type) don't split.
fn cf_next_comma(s: str, from: i64, end: i64) -> i64 {
    let mut i: i64 = from;
    let mut depth: i64 = 0i64;
    while i < end {
        let c: u8 = str_byte_at(s, i);
        if c == 60u8 || c == 40u8 || c == 91u8 {
            depth = depth + 1i64;
        }
        else if c == 62u8 || c == 41u8 || c == 93u8 {
            depth = depth - 1i64;
        }
        else if c == 44u8 && depth == 0i64 {
            return i;
        }
        i = i + 1i64;
    }
    return end;
}

/// One parsed container spec — string fields borrow the spec line.
pub struct ContainerSpec {
    pub is_pub:      bool,
    pub generics:    str,   // "<T>" verbatim (bounds included), "" = concrete
    pub gnames:      str,   // "T" / "K,V"
    pub backing:     str,   // "VecCtr<T>" (syntactic)
    pub backing_pkg: str,   // defining package of the backing base type, or ""
    pub kind:        str,   // "vector" | "ordered_map" | "node" | "branch" | "multimap"
    pub entry:       str,   // raw "name:ty:p,…"; stream-qualified "keys.key:K:1,…" for a multistream decl
    pub measures:    str,   // raw "count,max(key)"; stream-qualified "keys.max(key),values.count"
    pub pkg:         str,   // declaring package (ADR 0021 CFG-doc emission), "" if absent
    pub streams:     str,   // BTFL 8b: "keys,values" in declaration order; "" = BTSS sugar (one anonymous stream)
    pub ops:         str,   // BTFL 8b: "keys.seek(max(key)),keys.insert,values.scan(val),…"; unqualified for BTSS sugar; "" = none
}

pub fn container_spec_new() -> ContainerSpec {
    return ContainerSpec {
        is_pub: false, generics: "", gnames: "", backing: "",
        backing_pkg: "", kind: "", entry: "", measures: "", pkg: "",
        streams: "", ops: "",
    };
}

/// Parses the compiler's spec line. Returns false on any shape violation
/// (unknown key, missing segment, empty kind/entry) — the caller diagnoses.
pub fn parse_container_spec(spec: str, out: &mut ContainerSpec) -> bool {
    let n: i64 = spec.len();
    let mut pos: i64 = 0i64;
    let mut seen: i64 = 0i64;
    while pos < n {
        let mut end: i64 = cf_find(spec, pos, 124u8);   // '|'
        if end < 0i64 {
            end = n;
        }
        let eq: i64 = cf_find(spec, pos, 61u8);          // '='
        if eq < 0i64 || eq >= end {
            return false;
        }
        let key: str = unsafe { cf_sub(spec, pos, eq) };
        let val: str = unsafe { cf_sub(spec, eq + 1i64, end) };
        if str_eq(key, "pub") {
            out.is_pub = str_eq(val, "1");
        }
        else if str_eq(key, "generics") {
            out.generics = val;
        }
        else if str_eq(key, "gnames") {
            out.gnames = val;
        }
        else if str_eq(key, "backing") {
            out.backing = val;
        }
        else if str_eq(key, "backing_pkg") {
            out.backing_pkg = val;
        }
        else if str_eq(key, "kind") {
            out.kind = val;
        }
        else if str_eq(key, "entry") {
            out.entry = val;
        }
        else if str_eq(key, "measures") {
            out.measures = val;
        }
        else if str_eq(key, "pkg") {
            out.pkg = val;
        }
        else if str_eq(key, "streams") {
            out.streams = val;
        }
        else if str_eq(key, "ops") {
            out.ops = val;
        }
        else {
            return false;
        }
        seen = seen + 1i64;
        pos = end + 1i64;
    }
    // 8 = legacy/hand-built spec (canon_container_facts); 9 = compiler seam
    // with the ADR-0021 `pkg=` segment; +streams/+ops = the BTFL 8b
    // multistream segments (emitted only when present, so BTSS-sugar spec
    // lines stay byte-identical). kind+entry are the load-bearing fields.
    return seen >= 8i64 && seen <= 11i64 && out.kind.len() > 0i64 && out.entry.len() > 0i64;
}

// Index of the '.' splitting a stream-qualified name in s[from, to), or -1
// (BTFL 8b: `keys.key` / `keys.max` / `keys.seek` spec segments; a BTSS-sugar
// segment has no qualifier and belongs to the anonymous stream "").
fn cf_dot(s: str, from: i64, to: i64) -> i64 {
    let mut i: i64 = from;
    while i < to {
        if str_byte_at(s, i) == 46u8 {
            return i;
        }
        i = i + 1i64;
    }
    return -1i64;
}

/// Builds the FACT Writ doc for ONE container item (wave-0 has no cross-item
/// accumulation) — the ADR 0020 §5 fact vocabulary restricted to wave-0 +
/// the BTFL 8b stream/ops sections:
///
///   { containers: [ { name, pub, generics, backing, kind } ],
///     cols:       [ { ctr, idx, name, ty, param, stream } … ],
///     measures:   [ { ctr, mfn, arg, stream } … ],
///     streams:    [ { ctr, idx, name } … ],
///     ops:        [ { ctr, stream, verb, ahead, ainner } … ] }
///
/// stream = "" is the anonymous BTSS-sugar stream. Convenience shape for the
/// deem-over-&Writ graph source: top-level WMap, arrays of FLAT maps, scalar
/// leaves only. A malformed spec yields a doc with a NULL root — the caller
/// diagnoses.
pub fn container_facts(name: str, spec: str) -> Writ {
    let doc: Writ = writ_new(65536i64);
    let mut cs: ContainerSpec = container_spec_new();
    if !parse_container_spec(spec, &mut cs) {
        return doc;
    }

    let root: &mut WMap<WString, WAny> = doc.map(8i64);

    let ctrs: &mut WArray<WAny> = doc.array(1i64);
    {
        let c0: &mut WMap<WString, WAny> = doc.map(8i64);
        c0.set(K_NAME, name);
        c0.set("pub", cs.is_pub);
        c0.set("generics", cs.gnames);
        c0.set("backing", cs.backing);
        c0.set(K_KIND, cs.kind);
        ctrs.push(WAny::from(&*c0));
    }
    root.set(SEC_CONTAINERS, &*ctrs);

    let cols: &mut WArray<WAny> = doc.array(4i64);
    {
        let ce: i64 = cs.entry.len();
        let mut a: i64 = 0i64;
        let mut idx: i64 = 0i64;
        while a < ce {
            let b: i64 = cf_next_comma(cs.entry, a, ce);
            // `name:ty:p` — name up to the FIRST ':', flag after the LAST
            // (the type may itself contain `:` never, but generic commas do
            // occur — hence the depth-aware outer split).
            let c1: i64 = cf_find(cs.entry, a, 58u8);        // ':'
            let mut c2: i64 = b - 1i64;
            while c2 > a && str_byte_at(cs.entry, c2) != 58u8 {
                c2 = c2 - 1i64;
            }
            if c1 < 0i64 || c1 >= b || c2 <= c1 {
                return writ_new(64i64);
            }
            let r: &mut WMap<WString, WAny> = doc.map(8i64);
            r.set(K_CTR, name);
            r.set(K_IDX, idx);
            // `keys.key` = stream-qualified (BTFL 8b); bare = the "" stream.
            let dot: i64 = cf_dot(cs.entry, a, c1);
            if dot >= 0i64 {
                r.set(K_STREAM, unsafe { cf_sub(cs.entry, a, dot) });
                r.set(K_NAME, unsafe { cf_sub(cs.entry, dot + 1i64, c1) });
            } else {
                r.set(K_STREAM, "");
                r.set(K_NAME, unsafe { cf_sub(cs.entry, a, c1) });
            }
            r.set(K_TY, unsafe { cf_sub(cs.entry, c1 + 1i64, c2) });
            r.set(K_PARAM, str_eq(unsafe { cf_sub(cs.entry, c2 + 1i64, b) }, "1"));
            cols.push(WAny::from(&*r));
            idx = idx + 1i64;
            a = b + 1i64;
        }
    }
    root.set(SEC_COLS, &*cols);

    let meas: &mut WArray<WAny> = doc.array(4i64);
    {
        let cm: i64 = cs.measures.len();
        let mut a: i64 = 0i64;
        while a < cm {
            let b: i64 = cf_next_comma(cs.measures, a, cm);
            let lp: i64 = cf_find(cs.measures, a, 40u8);     // '('
            let r: &mut WMap<WString, WAny> = doc.map(8i64);
            r.set(K_CTR, name);
            let head_end: i64 = if lp >= 0i64 && lp < b { lp } else { b };
            let dot: i64 = cf_dot(cs.measures, a, head_end);
            let mstart: i64 = if dot >= 0i64 { dot + 1i64 } else { a };
            if dot >= 0i64 {
                r.set(K_STREAM, unsafe { cf_sub(cs.measures, a, dot) });
            } else {
                r.set(K_STREAM, "");
            }
            if lp >= 0i64 && lp < b {
                if str_byte_at(cs.measures, b - 1i64) != 41u8 {   // ')'
                    return writ_new(64i64);
                }
                r.set(K_MFN, unsafe { cf_sub(cs.measures, mstart, lp) });
                r.set(K_ARG, unsafe { cf_sub(cs.measures, lp + 1i64, b - 1i64) });
            } else {
                r.set(K_MFN, unsafe { cf_sub(cs.measures, mstart, b) });
                r.set(K_ARG, "");
            }
            meas.push(WAny::from(&*r));
            a = b + 1i64;
        }
    }
    root.set(SEC_MEASURES, &*meas);

    // ── BTFL 8b: stream + ops fact rows ─────────────────────────────────────
    let strs: &mut WArray<WAny> = doc.array(4i64);
    {
        let cn: i64 = cs.streams.len();
        let mut a: i64 = 0i64;
        let mut idx: i64 = 0i64;
        while a < cn {
            let b: i64 = cf_next_comma(cs.streams, a, cn);
            let r: &mut WMap<WString, WAny> = doc.map(4i64);
            r.set(K_CTR, name);
            r.set(K_IDX, idx);
            r.set(K_NAME, unsafe { cf_sub(cs.streams, a, b) });
            strs.push(WAny::from(&*r));
            idx = idx + 1i64;
            a = b + 1i64;
        }
    }
    root.set(SEC_STREAMS, &*strs);

    let opsa: &mut WArray<WAny> = doc.array(8i64);
    {
        // `keys.seek(max(key))` / `keys.insert` / `scan(val)` (unqualified =
        // the "" stream) → { ctr, stream, verb, ahead, ainner }.
        let cn: i64 = cs.ops.len();
        let mut a: i64 = 0i64;
        while a < cn {
            let b: i64 = cf_next_comma(cs.ops, a, cn);
            let lp: i64 = cf_find(cs.ops, a, 40u8);      // '('
            let head_end: i64 = if lp >= 0i64 && lp < b { lp } else { b };
            let dot: i64 = cf_dot(cs.ops, a, head_end);
            let vstart: i64 = if dot >= 0i64 { dot + 1i64 } else { a };
            let r: &mut WMap<WString, WAny> = doc.map(8i64);
            r.set(K_CTR, name);
            if dot >= 0i64 {
                r.set(K_STREAM, unsafe { cf_sub(cs.ops, a, dot) });
            } else {
                r.set(K_STREAM, "");
            }
            r.set(K_VERB, unsafe { cf_sub(cs.ops, vstart, head_end) });
            if lp >= 0i64 && lp < b {
                if str_byte_at(cs.ops, b - 1i64) != 41u8 {   // ')'
                    return writ_new(64i64);
                }
                // arg = `max(key)` (measure ref) or a bare ident
                let ilp: i64 = cf_find(cs.ops, lp + 1i64, 40u8);
                if ilp >= 0i64 && ilp < b - 1i64 {
                    if str_byte_at(cs.ops, b - 2i64) != 41u8 {   // inner ')'
                        return writ_new(64i64);
                    }
                    r.set(K_AHEAD, unsafe { cf_sub(cs.ops, lp + 1i64, ilp) });
                    r.set(K_AINNER, unsafe { cf_sub(cs.ops, ilp + 1i64, b - 2i64) });
                } else {
                    r.set(K_AHEAD, unsafe { cf_sub(cs.ops, lp + 1i64, b - 1i64) });
                    r.set(K_AINNER, "");
                }
            } else {
                r.set(K_AHEAD, "");
                r.set(K_AINNER, "");
            }
            opsa.push(WAny::from(&*r));
            a = b + 1i64;
        }
    }
    root.set(SEC_OPS, &*opsa);

    doc.set_root(WAny::from(&*root));
    return doc;
}

// ── verdict-doc readers (M4) ────────────────────────────────────────────────
// The handler consumes Canon's verdict doc MECHANICALLY (ADR 0020 §5): a
// capability grants an emission, an error row becomes a compile diagnostic
// carrying Canon's reason verbatim. Helpers return scalars (bool / i64
// codes), not borrowed strs — WAny steps bind to locals (borrowck contract).

fn cv_has_cap(vroot: &WMap<WString, WAny>, ctr: str, cap: str) -> bool {
    let av: WAny = vroot.get(V_CAPS);
    if !av.is_array() {
        return false;
    }
    let arr: &WArray<WAny> = av.as_array();
    let mut i: i64 = 0i64;
    while i < arr.len() {
        let e: WAny = arr.get(i);
        if e.is_map() {
            let em: &WMap<WString, WAny> = e.as_map();
            let a1: WAny = em.get(K_CTR);
            let a2: WAny = em.get(K_CAP);
            if a1.is_string() && a2.is_string() {
                if str_eq(a1.as_wstr(), ctr) && str_eq(a2.as_wstr(), cap) {
                    return true;
                }
            }
        }
        i = i + 1i64;
    }
    return false;
}

// col_proj verdict for (ctr, col): the handler's ONLY column vocabulary.
// 0 = no verdict row; 1 = direct (rel-native column, relty = declared type);
// 2 = canon_col (project to i64 through CanonCol). Any OTHER proj string is a
// Canon/handler vocabulary skew and fails LOUDLY — no silent degradation.
fn cv_col_proj(vroot: &WMap<WString, WAny>, ctr: str, col: str) -> i64 {
    let av: WAny = vroot.get(V_COL_PROJS);
    if !av.is_array() {
        error("container item: verdict doc missing its col_projs array (Canon seam regression?)");
        return 0i64;
    }
    let arr: &WArray<WAny> = av.as_array();
    let mut i: i64 = 0i64;
    while i < arr.len() {
        let e: WAny = arr.get(i);
        if e.is_map() {
            let em: &WMap<WString, WAny> = e.as_map();
            let a1: WAny = em.get(K_CTR);
            let a2: WAny = em.get(K_COL);
            let a3: WAny = em.get(K_PROJ);
            if a1.is_string() && a2.is_string() && a3.is_string() {
                if str_eq(a1.as_wstr(), ctr) && str_eq(a2.as_wstr(), col) {
                    if str_eq(a3.as_wstr(), PROJ_DIRECT) {
                        return 1i64;
                    }
                    if str_eq(a3.as_wstr(), PROJ_CANON_COL) {
                        return 2i64;
                    }
                    error("container item: unknown col_proj verdict (Canon/handler vocabulary skew?)");
                    return 0i64;
                }
            }
        }
        i = i + 1i64;
    }
    return 0i64;
}

// The split-policy verdict for a kind=node ctr: "fast" | "volume" | "" (absent).
// The leaf's split_into body is a FUNCTION of this — Canon decides, the emitter
// reproduces the matching hand-written template.
fn cv_split_policy(vroot: &WMap<WString, WAny>, ctr: str) -> str {
    let av: WAny = vroot.get(V_SPLIT);
    if !av.is_array() {
        return "";
    }
    let arr: &WArray<WAny> = av.as_array();
    let mut i: i64 = 0i64;
    while i < arr.len() {
        let e: WAny = arr.get(i);
        if e.is_map() {
            let em: &WMap<WString, WAny> = e.as_map();
            let a1: WAny = em.get(K_CTR);
            let a2: WAny = em.get(K_POLICY);
            if a1.is_string() && a2.is_string() && str_eq(a1.as_wstr(), ctr) {
                return a2.as_wstr();
            }
        }
        i = i + 1i64;
    }
    return "";
}

// BTFL 8b: the (ctr, stream) layout verdict from V_LAYOUTS; "" when absent.
fn cv_stream_layout(vroot: &WMap<WString, WAny>, ctr: str, stream: str) -> str {
    let av: WAny = vroot.get(V_LAYOUTS);
    if !av.is_array() {
        return "";
    }
    let arr: &WArray<WAny> = av.as_array();
    let mut i: i64 = 0i64;
    while i < arr.len() {
        let e: WAny = arr.get(i);
        if e.is_map() {
            let em: &WMap<WString, WAny> = e.as_map();
            let a1: WAny = em.get(K_CTR);
            let a2: WAny = em.get(K_STREAM);
            let a3: WAny = em.get(K_LAYOUT);
            if a1.is_string() && a2.is_string() && a3.is_string() {
                if str_eq(a1.as_wstr(), ctr) && str_eq(a2.as_wstr(), stream) {
                    return a3.as_wstr();
                }
            }
        }
        i = i + 1i64;
    }
    return "";
}

// relty of the (ctr, col) col_proj verdict row; "" when absent.
fn cv_col_relty(vroot: &WMap<WString, WAny>, ctr: str, col: str) -> str {
    let av: WAny = vroot.get(V_COL_PROJS);
    if !av.is_array() {
        return "";
    }
    let arr: &WArray<WAny> = av.as_array();
    let mut i: i64 = 0i64;
    while i < arr.len() {
        let e: WAny = arr.get(i);
        if e.is_map() {
            let em: &WMap<WString, WAny> = e.as_map();
            let a1: WAny = em.get(K_CTR);
            let a2: WAny = em.get(K_COL);
            let a3: WAny = em.get(K_RELTY);
            if a1.is_string() && a2.is_string() && a3.is_string() {
                if str_eq(a1.as_wstr(), ctr) && str_eq(a2.as_wstr(), col) {
                    return a3.as_wstr();
                }
            }
        }
        i = i + 1i64;
    }
    return "";
}

// Reports every Canon error row as a compile diagnostic:
//   container <ctr>: <code>: <reason>
// Returns the number of rows reported (0 = clean verdict).
fn cv_report_errors(vroot: &WMap<WString, WAny>, name: str) -> i64 {
    let av: WAny = vroot.get(V_ERRORS);
    if !av.is_array() {
        error("container item: verdict doc missing its errors array (Canon seam regression?)");
        return 1i64;
    }
    let arr: &WArray<WAny> = av.as_array();
    let mut i: i64 = 0i64;
    while i < arr.len() {
        let e: WAny = arr.get(i);
        let mut msg: String = String::new();
        msg.push_str("container ");
        msg.push_str(name);
        msg.push_str(": ");
        if e.is_map() {
            let em: &WMap<WString, WAny> = e.as_map();
            let cd: WAny = em.get(K_CODE);
            let rs: WAny = em.get(K_REASON);
            if cd.is_string() {
                msg.push_str(cd.as_wstr());
            }
            msg.push_str(": ");
            if rs.is_string() {
                msg.push_str(rs.as_wstr());
            }
        } else {
            msg.push_str("malformed Canon error row");
        }
        error(msg.as_str());
        i = i + 1i64;
    }
    return arr.len();
}

// ── projection emission (M4, kind=vector, can_scan verdict) ────────────────
// Renders the container's declared generic list with `CanonCol` appended to
// `bound_param`'s bounds (": CanonCol" when unbounded, " + CanonCol" when
// bounded). bound_param = "" renders the list verbatim.
// Renders the container's declared generic list into a STRING, with `CanonCol`
// appended to `bound_param`'s bounds (": CanonCol" when unbounded, " + CanonCol"
// when bounded); bound_param = "" renders the list verbatim; empty generics → "".
// The string is fed to parse_type_params, which reifies it into a spliceable
// type_param_list AST (empty string → an empty list that renders no `<...>`).
fn build_generics(generics: str, bound_param: str) -> String {
    let mut out: String = String::new();
    if generics.len() == 0i64 {
        return out;
    }
    let inner: str = unsafe { cf_sub(generics, 1i64, generics.len() - 1i64) };
    out.push_str("<");
    let n: i64 = inner.len();
    let mut a: i64 = 0i64;
    let mut first: bool = true;
    while a < n {
        let b: i64 = cf_next_comma(inner, a, n);
        let mut s: i64 = a;
        while s < b && str_byte_at(inner, s) == 32u8 {
            s = s + 1i64;
        }
        let mut e2: i64 = b;
        while e2 > s && str_byte_at(inner, e2 - 1i64) == 32u8 {
            e2 = e2 - 1i64;
        }
        let seg: str = unsafe { cf_sub(inner, s, e2) };
        if !first {
            out.push_str(", ");
        }
        first = false;
        out.push_str(seg);
        if bound_param.len() > 0i64 {
            let c: i64 = cf_find(seg, 0i64, 58u8);   // ':'
            let mut ne: i64 = if c >= 0i64 { c } else { seg.len() };
            while ne > 0i64 && str_byte_at(seg, ne - 1i64) == 32u8 {
                ne = ne - 1i64;
            }
            let nm: str = unsafe { cf_sub(seg, 0i64, ne) };
            if str_eq(nm, bound_param) {
                if c >= 0i64 {
                    out.push_str(" + CanonCol");
                }
                else {
                    out.push_str(": CanonCol");
                }
            }
        }
        a = b + 1i64;
    }
    out.push_str(">");
    return out;
}

// Emits the SCAN projection for one kind=vector container (design §f): a
// single-rel source trait, a scan materializer over the wave-0 backing
// contract (`count(&self) -> i64`, `get(&self, i: i64) -> T`), and the impl
// rel binding — one chunk into the declaring package, imports explicit.
//   relty:  the rel column type (i64 / str / bool);
//   direct: push `e` verbatim (str/bool cols) vs `e.canon_col()` (by_value);
//   bound_param: generic param needing the CanonCol bound ("" = none).
fn emit_vector_scan(cs: &ContainerSpec, name: str, col_name: str, col_ty: str,
                    relty: str, direct: bool, bound_param: str) {
    let view: OView = oview_module_ast();
    let mut tp: String = String::new();
    view.module_package_append(&mut tp);

    // Composite names (Strings kept alive through the emissions below).
    let mut src_s: String = String::new();
    src_s.push_str("__CtrSrc_"); src_s.push_str(name);
    let mut rows_s: String = String::new();
    rows_s.push_str("__ctr_rows_"); rows_s.push_str(name);
    let srcnm:  Ident = Ident::new(src_s.as_str());
    let rowsfn: Ident = Ident::new(rows_s.as_str());
    let colnm:  Ident = Ident::new(col_name);

    // Optional-import idents: empty ⇒ `use #x?;` drops the line. canon carries
    // CanonCol + canon_col(); backing_pkg carries the backing type. Both skip a
    // self-import (declaring package == that package).
    let canon_pkg: str = if str_eq(tp.as_str(), "logos.lcm.canon.canon") { "" }
                         else {
                             "logos.lcm.canon.canon"
                         } ;
    let canonid: Ident = Ident::new(canon_pkg);
    let bpkg: str = if cs.backing_pkg.len() > 0i64 && !str_eq(cs.backing_pkg, tp.as_str())
                    { cs.backing_pkg } else { "" };
    let bpkgid: Ident = Ident::new(bpkg);

    // Generics header string (verbatim + CanonCol on bound_param; "" = concrete).
    let gen_s: String = build_generics(cs.generics, bound_param);

    // ── source trait + scan materializer fn ─────────────────────────────────
    // ONE template: the generics list, backing type, rel/col types and the push
    // expression are reified from runtime strings (parse_type_params /
    // parse_type / quote_expr!) — ExprBlob is Copy, so each fragment splices at
    // all its sites — and the pub axis is the `pub(#vis)` visibility antiquote
    // ("pub" / "" = private) instead of a blob-variant pair.
    let vis_s: str = if cs.is_pub { "pub" } else { "" };
    let vis: Ident = Ident::new(vis_s);
    let rt: ExprBlob = parse_type(relty);
    let gp: ExprBlob = parse_type_params(gen_s.as_str());
    let bk: ExprBlob = parse_type(cs.backing);
    let ct: ExprBlob = parse_type(col_ty);
    let pv: ExprBlob = if direct { quote_expr! { e } } else { quote_expr! { e.canon_col() } };
    let b: QuoteItemBlob = quote_item! {
        use logos.mem.collections.vec;
        use #canonid?;
        use #bpkgid?;
        pub(#vis) trait #srcnm { rel row(pos: i64, #colnm: #(rt)); }
        pub(#vis) fn #rowsfn #(gp) (c: &#(bk)) -> Vec<(i64, #(rt))> {
            let mut out: Vec<(i64, #(rt))> = vec_new::<(i64, #(rt))>();
            let n: i64 = c.count();
            let mut i: i64 = 0i64;
            while i < n {
                let e: #(ct) = c.get(i);
                out.push((i, #(pv)));
                i = i + 1i64;
            }
            return out;
        }
    };
    unsafe { logos_emit_item_blob_subst(&b); }

    // ── impl rel binding (impls are never pub; gp/bk blobs reused — Copy) ───
    {
        let b2: QuoteItemBlob = quote_item! {
            use #canonid?;
            use #bpkgid?;
            impl #(gp) #srcnm for #(bk) { rel row = #rowsfn; }
        };
        unsafe { logos_emit_item_blob_subst(&b2); }
    }
}

// Emits a concrete b+tree LEAF node for one kind=node container (ADR 0020 Track
// B 2c): a struct owning a pkd block with two sibling columns (key, val) plus
// the Node contract (new/count/key_at/val_at/lower_bound/try_insert/split). The
// value-column encoding AND the split body are CHOSEN BY THE CANON VERDICT:
//   - `fast`   → all-FSE columns, count-balanced split (reproduces LeafU64);
//   - `volume` → a VLE value column (val_at yields &[u8]), a volume-balanced
//                split over both columns' prefix bytes (reproduces LeafKV).
// The verdict is the codegen decision; the emitter is mechanical.
//
// Wave-0 substrate: the generated leaf targets the memoria pkd allocator
// (logos.mem.pkd) directly, PLAIN pkd (alloc / pkd_format / dealloc, no CoW node
// header) — exactly like the hand-written leaf.logos / leaf_kv.logos templates.
fn emit_leaf_node(name: str, kty: str, vty: str, policy: str, cow: bool) {
    let vol: bool = str_eq(policy, SPLIT_VOLUME);
    // Each quote blob carries its own `use` imports (no side Emitter pass). CoW
    // flavor carries the 16-byte node header via logos.mem.bt.node; plain uses
    // logos.lang.mem.
    let nm:  Ident = Ident::new(name);
    let kid: Ident = Ident::new(kty);
    let vid: Ident = Ident::new(vty);
    // lower_bound signedness verdict: the compare domain follows the KEY
    // type — a blind u64 cast would invert negative signed keys.
    let signed_k: bool = str_byte_at(kty, 0i64) == 105u8;   // 'i'
    let lbfn: Ident = if signed_k { Ident::new("btss_lower_bound_i64") } else { Ident::new("btss_lower_bound_u64") };
    let lbdom: Ident = if signed_k { Ident::new("i64") } else { Ident::new("u64") };
    // Store-configuration plane (S2): node form + geometry baked from StoreCfg.
    let nd: Ident = Ident::new(MEM_STORE_NODE);
    let scfg: StoreCfg = mem_store_cfg(STORE_CFG_DEFAULT);
    let mut lb_u: String = fmt_display_to_string(&scfg.leaf_bytes());
    lb_u.push_str("u32");
    let lbs: ExprBlob = parse_expr(lb_u.as_str());
    let mut lb_i: String = fmt_display_to_string(&scfg.leaf_bytes());
    lb_i.push_str("i64");
    let lbsi: ExprBlob = parse_expr(lb_i.as_str());

    // Struct + cow/vol-INDEPENDENT methods (two columns: key=kty, val=vty; for a
    // volume node vty is `str` — a VLE column). `self.a()` + `split_index` live in
    // the flavor blocks below (further `impl #nm`).
    let common: QuoteItemBlob = quote_item! {
        use logos.mem.bt.btss;      // the single-stream leaf substrate (S2b/B)
        use logos.mem.pkd;
        use logos.mem.pkd.pdtbuf;
        use logos.lang.result;
        use logos.mem.collections.vec;
        pub struct #nm { mem: *mut u8, cap: u32 }
        impl #nm {
            pub fn block(self: &#nm) -> *mut u8 { return self.mem; }
            // Columns are single-column PdtBufs (the PkdArray retirement):
            // keys MAX-ordered FSE64; vals FSE64 or VLE per the Canon verdict
            // (the descriptor is stored in the block — self-describing).
            unsafe fn kc(self: &#nm) -> PdtBuf { return pdtbuf_adopt(self.a().get::<u8>(0u32)); }
            unsafe fn vc(self: &#nm) -> PdtBuf { return pdtbuf_adopt(self.a().get::<u8>(1u32)); }
            // Format slot `slot` as a single-column PdtBuf at the capacity-0
            // geometry, wired to the node allocator (nested-block discipline).
            static unsafe fn fmt_slot(a: *mut PkdAlloc, slot: u32, vle: bool, ordered: bool) {
                btss_fmt_slot(a, slot, vle, ordered);
            }
            // Two-phase column split at `at` — VLE columns reserve the moving
            // payload bytes through the right side's own chain.
            unsafe fn split_col(self: &#nm, dst: &#nm, slot: u32, at: u32) {
                btss_split_col(self.a(), dst.a(), slot, at);
            }
            pub fn count(self: &#nm) -> u32 { return unsafe { btss_count(self.a()) }; }
            pub fn key_at(self: &#nm, i: u32) -> #(kid) { return unsafe { self.kc().get(0u32, i as u64) as #(kid) }; }
            pub fn lower_bound(self: &#nm, key: #(kid)) -> u32 {
                return unsafe { #(lbfn)(self.a(), key as #(lbdom)) };
            }
            pub fn split_into(self: &mut #nm, dst: &mut #nm) {
                let at: u32 = self.split_index();
                unsafe {
                    self.split_col(&*dst, 0u32, at);
                    self.split_col(&*dst, 1u32, at);
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&common); }

    // ── ADR 0023 S4: the leaf's MUTATION mechanics are generated ALGEBRA
    // kernels. The Canon verdict lowers to the schema's wire spelling and
    // the fused upsert quad is emitted per leaf; try_insert below calls it.
    // btss_upsert_* died into these.
    let mut aname: String = String::new();
    aname.push_str(name);
    aname.push_str("Alg");
    let spec: str = if vol { "fse8o,vle" } else { "fse8o,fse8" };
    let mut kl: ItemList = alg_kernel_with_entry(aname.as_str(), spec,
                                                 "if hit { ET_SET } else { ET_INS }");
    loop {
        // drain — independent top-level items, emission order irrelevant
        match kl.blobs.pop() {
            Option::Some(b) => {
                unsafe { logos_emit_item_blob_subst(&b); }
            }
            Option::None => {
                break;
            }
        }
    }
    let mut wn: String = String::new();
    wn.push_str(name);
    wn.push_str("Alg_with_entry");
    let wek: Ident = Ident::new(wn.as_str());   // wn outlives the emissions below
    let mut dn: String = String::new();
    dn.push_str(name);
    dn.push_str("Alg_entry_del");
    let delk: Ident = Ident::new(dn.as_str()); // dn outlives the emissions below

    // val_at / try_insert / split_index — VERDICT-SELECTED (Canon fast|volume).
    if vol {
        // Volume: VLE value column — val_at borrows bytes (&[u8]); try_insert
        // admits on entry bytes with a length-fit check + replace-on-hit via
        // remove+insert (VLE has no set); split_index is byte-volume-balanced.
        let vb: QuoteItemBlob = quote_item! {
            use logos.mem.pkd;
            use logos.mem.pkd.pdtbuf;
            use logos.lang.result;
            use logos.lang.str;
            use logos.lang.slice;
            use logos.mem.collections.vec;
            use logos.mem.bt.alg;
            use logos.lang.option;
            impl #nm {
                pub fn val_at(self: &#nm, i: u32) -> &[u8] {
                    unsafe {
                        let b: PdtBuf = self.vc();
                        let off: u64 = b.row_offset(0u32, 0u32, i as u64);
                        let len: u64 = b.row_len(0u32, 0u32, i as u64);
                        return slice_from_raw::<u8>(b.payload(0u32, 0u32).byte_add(off as i64),
                                                    len as i64);
                    }
                }
                pub fn try_insert(self: &mut #nm, key: #(kid), val: #(vid)) -> bool {
                    let vlen: u32 = val.len() as u32;
                    if 8u32 + vlen > 1024u32 {
                        return false;
                    }
                    unsafe {
                        let pos: u32 = self.lower_bound(key);
                        let hit: bool = pos < self.count() && self.key_at(pos) == key;
                        // K-domain comparison HERE (signedness verdict); the
                        // mutation is the generated ALGEBRA kernel — the
                        // fused upsert quad (ADR 0023 S4). On hit the key
                        // column stays untouched (empty col = no rows).
                        let mut d: LeafBatchDatum = leaf_batch_datum_new();
                        let mut ck: DatumCol = datum_col_new();
                        if !hit {
                            ck.cells.push(key as u64);
                        }
                        d.cols.push(ck);
                        let mut cv: DatumCol = datum_col_new();
                        cv.spans.push_span(slice_from_raw::<u8>(val.as_ptr(), val.len()));
                        d.cols.push(cv);
                        return #(wek)(self.a(), pos as u64, hit, &mut d);
                    }
                }
                /// The WITH_ENTRY quad at this leaf (ADR 0023): f maps the
                /// entry's current state to its next; the transition runs on
                /// the generated algebra kernels. False iff it does not fit.
                pub fn with_entry(self: &mut #nm, key: #(kid), f: fn(Option<&[u8]>) -> Option<#(vid)>) -> bool {
                    unsafe {
                        let pos: u32 = self.lower_bound(key);
                        let hit: bool = pos < self.count() && self.key_at(pos) == key;
                        let mut cur: Option<&[u8]> = Option::None;
                        if hit {
                            cur = Option::Some(self.val_at(pos));
                        }
                        match f(cur) {
                            Option::Some(v) => {
                                let mut d: LeafBatchDatum = leaf_batch_datum_new();
                                let mut ck: DatumCol = datum_col_new();
                                if !hit {
                                    ck.cells.push(key as u64);
                                }
                                d.cols.push(ck);
                                let mut cv: DatumCol = datum_col_new();
                                cv.spans.push_span(slice_from_raw::<u8>(v.as_ptr(), v.len()));
                                d.cols.push(cv);
                                return #(wek)(self.a(), pos as u64, hit, &mut d);
                            }
                            Option::None => {
                                if !hit {
                                    return true;   // None→None: no-op
                                }
                                let dd: LeafBatchDatum = leaf_batch_datum_new();
                                return #(delk)(self.a(), pos as u64, &dd);
                            }
                        }
                    }
                }
                                static unsafe fn fmt_vc(a: *mut PkdAlloc) {
                    #nm::fmt_slot(a, 1u32, true, false);
                }
                /// Split index: VOLUME-balanced — the Canon verdict for a VLE-column node.
                pub fn split_index(self: &#nm) -> u32 {
                    return unsafe { btss_split_index_volume(self.a()) };
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&vb); }
    } else {
        // Fast: all-FSE — val_at returns by value; try_insert set-on-hit;
        // split_index is count-balanced.
        let vb: QuoteItemBlob = quote_item! {
            use logos.mem.bt.btss;      // btss_upsert_at — the u64 cell mechanics
            use logos.mem.pkd;
            use logos.mem.pkd.pdtbuf;
            use logos.lang.result;
            use logos.mem.collections.vec;
            use logos.mem.bt.alg;
            use logos.lang.option;
            impl #nm {
                pub fn try_insert(self: &mut #nm, key: #(kid), val: #(vid)) -> bool {
                    unsafe {
                        // K-domain comparison stays HERE (signedness); the
                        // mutation is the generated ALGEBRA kernel — the
                        // fused upsert quad (ADR 0023 S4). On hit the key
                        // column stays untouched (empty col = no rows).
                        let pos: u32 = self.lower_bound(key);
                        let hit: bool = pos < self.count() && self.key_at(pos) == key;
                        let mut d: LeafBatchDatum = leaf_batch_datum_new();
                        let mut ck: DatumCol = datum_col_new();
                        if !hit {
                            ck.cells.push(key as u64);
                        }
                        d.cols.push(ck);
                        let mut cv: DatumCol = datum_col_new();
                        cv.cells.push(val as u64);
                        d.cols.push(cv);
                        return #(wek)(self.a(), pos as u64, hit, &mut d);
                    }
                }
                /// The WITH_ENTRY quad at this leaf (ADR 0023): f maps the
                /// entry's current state to its next; the transition runs on
                /// the generated algebra kernels. False iff it does not fit.
                pub fn with_entry(self: &mut #nm, key: #(kid), f: fn(Option<#(vid)>) -> Option<#(vid)>) -> bool {
                    unsafe {
                        let pos: u32 = self.lower_bound(key);
                        let hit: bool = pos < self.count() && self.key_at(pos) == key;
                        let mut cur: Option<#(vid)> = Option::None;
                        if hit {
                            cur = Option::Some(self.val_at(pos));
                        }
                        match f(cur) {
                            Option::Some(v) => {
                                let mut d: LeafBatchDatum = leaf_batch_datum_new();
                                let mut ck: DatumCol = datum_col_new();
                                if !hit {
                                    ck.cells.push(key as u64);
                                }
                                d.cols.push(ck);
                                let mut cv: DatumCol = datum_col_new();
                                cv.cells.push(v as u64);
                                d.cols.push(cv);
                                return #(wek)(self.a(), pos as u64, hit, &mut d);
                            }
                            Option::None => {
                                if !hit {
                                    return true;   // None→None: no-op
                                }
                                let dd: LeafBatchDatum = leaf_batch_datum_new();
                                return #(delk)(self.a(), pos as u64, &dd);
                            }
                        }
                    }
                }
                static unsafe fn fmt_vc(a: *mut PkdAlloc) {
                    #nm::fmt_slot(a, 1u32, false, false);
                }
                /// Split index: FAST (count-balanced) — the Canon verdict for an all-FSE node.
                pub fn split_index(self: &#nm) -> u32 { return self.count() / 2u32; }
            }
        };
        unsafe { logos_emit_item_blob_subst(&vb); }
        // val_at: the FSE cell is u64; the read-back depends on the value
        // TYPE — bool admits no `as` from an integer (read via != 0).
        if str_eq(vty, "bool") {
            let vv: QuoteItemBlob = quote_item! {
                use logos.mem.pkd.pdtbuf;
                impl #nm {
                    pub fn val_at(self: &#nm, i: u32) -> #(vid) { return unsafe { self.vc().get(0u32, i as u64) != 0u64 }; }
                }
            };
            unsafe { logos_emit_item_blob_subst(&vv); }
        } else {
            let vv: QuoteItemBlob = quote_item! {
                use logos.mem.pkd.pdtbuf;
                impl #nm {
                    pub fn val_at(self: &#nm, i: u32) -> #(vid) { return unsafe { self.vc().get(0u32, i as u64) as #(vid) }; }
                }
            };
            unsafe { logos_emit_item_blob_subst(&vv); }
        }
    }

    // new / adopt / free / a — CoW (node header) vs PLAIN pkd. CoW also emits
    // cow_clone (a private copy on a fresh block stamped `snp`; a leaf shares no
    // children); its body reconstructs a `str` view over the VLE bytes for a
    // volume node, or copies by value for fast.
    if cow {
        let cb: QuoteItemBlob = quote_item! {
            use logos.mem.pkd;
            use logos.mem.bt.node;
            use logos.lang.result;
            impl #nm {
                pub static fn new() -> #nm { return #nm::new_in(0u64); }
                pub static fn new_in(snp: u64) -> #nm {
                    unsafe {
                        let base: *mut u8 = #nd::alloc(#(lbs), 2u32, snp);
                        let a: *mut PkdAlloc = #nd::pkd(base);
                        #nm::fmt_slot(a, 0u32, false, true);
                        #nm::fmt_vc(a);
                        return #nm { mem: base, cap: #(lbs) };
                    }
                }
                pub static fn adopt(mem: *mut u8) -> #nm { 
                    return #nm { 
                        mem: mem, 
                        cap: unsafe { (*#nd::pkd(mem)).block_size() } 
                    }; 
                }
                unsafe fn a(self: &#nm) -> *mut PkdAlloc { 
                    return #nd::pkd(self.mem); 
                }
                pub fn free(self: #nm) { 
                    unsafe { #nd::free(self.mem); } 
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&cb); }
        if vol {
            let cc: QuoteItemBlob = quote_item! {
                use logos.lang.slice;
                use logos.lang.str;
                impl #nm {
                    pub fn cow_clone(self: &#nm, snp: u64) -> #nm {
                        let mut c: #nm = #nm::new_in(snp);
                        let n: u32 = self.count();
                        let mut i: u32 = 0u32;
                        while i < n {
                            let v: &[u8] = self.val_at(i);
                            let vs: str = unsafe { str_from_raw(v.as_ptr(), v.len()) };
                            let _ = c.try_insert(self.key_at(i), vs);
                            i = i + 1u32;
                        }
                        return c;
                    }
                }
            };
            unsafe { logos_emit_item_blob_subst(&cc); }
        } else {
            let cc: QuoteItemBlob = quote_item! {
                impl #nm {
                    pub fn cow_clone(self: &#nm, snp: u64) -> #nm {
                        let mut c: #nm = #nm::new_in(snp);
                        let n: u32 = self.count();
                        let mut i: u32 = 0u32;
                        while i < n { 
                            let _ = c.try_insert(self.key_at(i), self.val_at(i)); 
                            i = i + 1u32; 
                        }
                        return c;
                    }
                }
            };
            unsafe { logos_emit_item_blob_subst(&cc); }
        }
    } else {
        let pb: QuoteItemBlob = quote_item! {
            use logos.mem.pkd;
            use logos.lang.mem;
            use logos.lang.result;
            impl #nm {


                pub static fn new() -> #nm {
                    unsafe {
                        let base: *mut u8 = alloc(#(lbsi));
                        let a: *mut PkdAlloc = pkd_format(base, #(lbs), 2u32);
                        #nm::fmt_slot(a, 0u32, false, true);
                        #nm::fmt_vc(a);
                        return #nm { mem: base, cap: #(lbs) };
                    }
                }
                pub static fn adopt(mem: *mut u8) -> #nm { return #nm { mem: mem, cap: unsafe { (mem as *mut PkdAlloc).block_size() } }; }
                unsafe fn a(self: &#nm) -> *mut PkdAlloc { return self.mem as *mut PkdAlloc; }
                pub fn free(self: #nm) { unsafe { dealloc(self.mem); } }
            }
        };
        unsafe { logos_emit_item_blob_subst(&pb); }
    }
}

// Emits a concrete b+tree BRANCH (routing) node for one kind=branch container
// (ADR 0020 Track B 2c). Reproduces the hand-written BranchU64 template but on
// PLAIN pkd (alloc / pkd_format / dealloc, no CoW node header) — three sibling
// FSE columns over one owned block:
//   slot 0 sep (kty) : each child's separator = the MAX key in its subtree;
//   slot 1 sz  (u64) : each child's subtree SIZE (the SUM measure column);
//   slot 2 ptr (u64) : each child's block address (reached via child_addr).
// A branch is ALWAYS count-balanced (all-FSE) — no split_policy verdict, unlike
// a leaf. The branch is CHILD-TYPE-AGNOSTIC (generated with no concrete leaf
// type in scope), so the child-descent operations (rank, get_or) take a descent
// HOOK fn-pointer — the caller binds it to the concrete leaf type; free_children
// releases child blocks by raw dealloc (block-id lifecycle, no typed handle).
fn emit_branch_node(name: str, kty: str, cow: bool) {
    // The type name (`#nm`) and the key type (`#(kid)`) are `#ident` antiquot
    // placeholders; `name`/`kty` borrow the spec, which outlives this synchronous
    // emission, so the Idents need no separate backing. Each blob carries its own
    // `use` imports (quote_item! bodies do — no side Emitter pass).
    let nm:  Ident = Ident::new(name);
    let kid: Ident = Ident::new(kty);
    // Store-configuration plane (S2): node form + geometry baked from StoreCfg.
    let nd: Ident = Ident::new(MEM_STORE_NODE);
    let scfg: StoreCfg = mem_store_cfg(STORE_CFG_DEFAULT);
    let mut bb_u: String = fmt_display_to_string(&scfg.branch_bytes());
    bb_u.push_str("u32");
    let bbs: ExprBlob = parse_expr(bb_u.as_str());
    let mut bb_i: String = fmt_display_to_string(&scfg.branch_bytes());
    bb_i.push_str("i64");
    let bbsi: ExprBlob = parse_expr(bb_i.as_str());

    // The struct + the cow-INDEPENDENT methods (three FSE columns: sep=kty,
    // sz/ptr=u64). `self.a()` (the PkdAlloc accessor) lives in the flavor impl
    // block below — a second `impl #nm` for the same type.
    let common: QuoteItemBlob = quote_item! {
        use logos.mem.bt.btss;      // the shared column mechanics (S2b/B slice 5)
        use logos.mem.pkd;
        use logos.mem.pkd.pdtbuf;
        use logos.lang.result;
        use logos.mem.collections.vec;
        pub struct #nm { mem: *mut u8, cap: u32 }
        impl #nm {
            pub fn block(self: &#nm) -> *mut u8 { return self.mem; }
            // All three columns are single-column FSE64 PdtBufs (the PkdArray
            // retirement); slot 2 is the uniform release-walk child column.
            unsafe fn sep(self: &#nm) -> PdtBuf { return pdtbuf_adopt(self.a().get::<u8>(0u32)); }
            unsafe fn szc(self: &#nm) -> PdtBuf { return pdtbuf_adopt(self.a().get::<u8>(1u32)); }
            unsafe fn ptrc(self: &#nm) -> PdtBuf { return pdtbuf_adopt(self.a().get::<u8>(2u32)); }
            static unsafe fn fmt_col(a: *mut PkdAlloc, slot: u32, ordered: bool) {
                btss_fmt_slot(a, slot, false, ordered);
            }
            // One-cell two-phase append/insert (priced by the caller).
            unsafe fn put_cell(self: &#nm, slot: u32, pos: u32, v: u64) {
                btss_put_cell(self.a(), slot, pos, v);
            }
            unsafe fn split_col(self: &#nm, dst: &#nm, slot: u32, at: u32) {
                btss_split_col(self.a(), dst.a(), slot, at);
            }
            pub fn child_count(self: &#nm) -> u32 { return unsafe { self.sep().size() as u32 }; }
            pub fn sep_at(self: &#nm, i: u32) -> #(kid) { return unsafe { self.sep().get(0u32, i as u64) as #(kid) }; }
            pub fn size_at(self: &#nm, i: u32) -> u64 { return unsafe { self.szc().get(0u32, i as u64) }; }
            pub fn child_addr(self: &#nm, i: u32) -> *mut u8 { return unsafe { self.ptrc().get(0u32, i as u64) as *mut u8 }; }
            pub fn set_child_addr(self: &mut #nm, i: u32, ptr: *mut u8) {
                unsafe {
                    let mut c: PdtBuf = self.ptrc();
                    c.set(0u32, i as u64, ptr as u64);
                }
            }
            pub fn max_sep(self: &#nm) -> #(kid) {
                let n: u32 = self.child_count();
                assert(n > 0u32, "max_sep: empty branch");
                return self.sep_at(n - 1u32);
            }
            pub fn total_size(self: &#nm) -> u64 {
                let n: u32 = self.child_count();
                let mut s: u64 = 0u64;
                let mut i: u32 = 0u32;
                while i < n {
                    s = s + self.size_at(i);
                    i = i + 1u32;
                }
                return s;
            }
            pub fn find_child(self: &#nm, key: #(kid)) -> u32 {
                let n: u32 = self.child_count();
                let mut i: u32 = 0u32;
                while i < n {
                    if self.sep_at(i) >= key {
                        return i;
                    } i = i + 1u32;
                }
                return if n > 0u32 { n - 1u32 } else { 0u32 };
            }
            pub fn rank(self: &#nm, key: #(kid), lb: fn(*mut u8, #(kid)) -> u32) -> u64 {
                let n: u32 = self.child_count();
                if n == 0u32 {
                    return 0u64;
                }
                let ci: u32 = self.find_child(key);
                let mut base: u64 = 0u64;
                let mut i: u32 = 0u32;
                while i < ci {
                    base = base + self.size_at(i);
                    i = i + 1u32;
                }
                return base + (lb(self.child_addr(ci), key) as u64);
            }
            pub fn get_or(self: &#nm, key: #(kid), sentinel: u64, probe: fn(*mut u8, #(kid), u64) -> u64) -> u64 {
                let n: u32 = self.child_count();
                if n == 0u32 {
                    return sentinel;
                }
                let ci: u32 = self.find_child(key);
                return probe(self.child_addr(ci), key, sentinel);
            }
            pub fn push_child(self: &mut #nm, sep: #(kid), sz: u64, ptr: *mut u8) {
                unsafe {
                    let n: u32 = self.child_count();
                    self.put_cell(0u32, n, sep as u64);
                    self.put_cell(1u32, n, sz);
                    self.put_cell(2u32, n, ptr as u64);
                }
            }
            pub fn insert_child(self: &mut #nm, pos: u32, sep: #(kid), sz: u64, ptr: *mut u8) {
                unsafe {
                    self.put_cell(0u32, pos, sep as u64);
                    self.put_cell(1u32, pos, sz);
                    self.put_cell(2u32, pos, ptr as u64);
                }
            }
            pub fn update_child(self: &mut #nm, i: u32, sep: #(kid), sz: u64) {
                unsafe {
                    let mut sb: PdtBuf = self.sep();
                    sb.set(0u32, i as u64, sep as u64);
                    let mut zb: PdtBuf = self.szc();
                    zb.set(0u32, i as u64, sz);
                }
            }
            pub fn can_insert_child(self: &#nm) -> bool {
                return unsafe { btss_fits_row(self.a(), 3u32) };
            }
            pub fn split_into(self: &mut #nm, dst: &mut #nm) -> #(kid) {
                let at: u32 = self.child_count() / 2u32;
                unsafe {
                    self.split_col(&*dst, 0u32, at);
                    self.split_col(&*dst, 1u32, at);
                    self.split_col(&*dst, 2u32, at);
                }
                return self.max_sep();
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&common); }

    // The FLAVOR-specific impl block (a second `impl #nm`): CoW carries the node
    // header (node_alloc/node_pkd/node_free + cow_clone bumping each shared
    // child's rc); PLAIN pkd uses alloc/pkd_format/dealloc and has no cow_clone.
    if cow {
        let flavor: QuoteItemBlob = quote_item! {
            use logos.mem.pkd;
            use logos.mem.pkd.pdtbuf;
            use logos.mem.bt.node;
            use logos.lang.result;
            impl #nm {
                pub static fn new() -> #nm { return #nm::new_in(0u64); }
                pub static fn new_in(snp: u64) -> #nm {
                    unsafe {
                        let base: *mut u8 = #nd::alloc(#(bbs), 3u32, snp);
                        // A BRANCH: declare where its child refs live, so the
                        // container-agnostic tree walk needs no global slot
                        // convention.
                        #nd::set_child_slot(base, 2u32);
                        let a: *mut PkdAlloc = #nd::pkd(base);
                        #nm::fmt_col(a, 0u32, true);
                        #nm::fmt_col(a, 1u32, false);
                        #nm::fmt_col(a, 2u32, false);
                        return #nm { mem: base, cap: #(bbs) };
                    }
                }
                pub static fn adopt(mem: *mut u8) -> #nm { return #nm { mem: mem, cap: unsafe { (*#nd::pkd(mem)).block_size() } }; }
                unsafe fn a(self: &#nm) -> *mut PkdAlloc { return #nd::pkd(self.mem); }
                pub fn free_children(self: #nm) {
                    let n: u32 = self.child_count();
                    let mut i: u32 = 0u32;
                    while i < n {
                        unsafe { #nd::free(self.child_addr(i)); } i = i + 1u32;
                    }
                    unsafe { #nd::free(self.mem); }
                }
                pub fn free_block(self: #nm) { unsafe { #nd::free(self.mem); } }
                pub fn cow_clone(self: &#nm, snp: u64) -> #nm {
                    let mut c: #nm = #nm::new_in(snp);
                    let n: u32 = self.child_count();
                    let mut i: u32 = 0u32;
                    while i < n {
                        let p: *mut u8 = self.child_addr(i);
                        unsafe { #nd::inc_rc(p); }
                        c.push_child(self.sep_at(i), self.size_at(i), p);
                        i = i + 1u32;
                    }
                    return c;
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&flavor); }
    } else {
        let flavor: QuoteItemBlob = quote_item! {
            use logos.mem.pkd;
            use logos.mem.pkd.pdtbuf;
            use logos.lang.mem;
            use logos.lang.result;
            impl #nm {
                pub static fn new() -> #nm {
                    unsafe {
                        let base: *mut u8 = alloc(#(bbsi));
                        let a: *mut PkdAlloc = pkd_format(base, #(bbs), 3u32);
                        #nm::fmt_col(a, 0u32, true);
                        #nm::fmt_col(a, 1u32, false);
                        #nm::fmt_col(a, 2u32, false);
                        return #nm { mem: base, cap: #(bbs) };
                    }
                }
                pub static fn adopt(mem: *mut u8) -> #nm { return #nm { mem: mem, cap: unsafe { (mem as *mut PkdAlloc).block_size() } }; }
                unsafe fn a(self: &#nm) -> *mut PkdAlloc { return self.mem as *mut PkdAlloc; }
                pub fn free_children(self: #nm) {
                    let n: u32 = self.child_count();
                    let mut i: u32 = 0u32;
                    while i < n {
                        unsafe { dealloc(self.child_addr(i)); } i = i + 1u32;
                    }
                    unsafe { dealloc(self.mem); }
                }
                pub fn free_block(self: #nm) { unsafe { dealloc(self.mem); } }
            }
        };
        unsafe { logos_emit_item_blob_subst(&flavor); }
    }
}

// ── ADR 0021 ops-reshape (step 2): generated nodes join the generic ops ────
//
// The per-config tree/CoW ALGORITHMS are no longer emitted — they live ONCE in
// logos.mem.bt.ops as fns generic over `L: BtLeaf<K, VIn, VOut>` /
// `B: BtBranch<K>`. The two emitters below produce only the THIN trait impls
// (one-line delegations into the inherent node methods emit_leaf_node /
// emit_branch_node just produced) that let the shared bt_* ops instantiate over
// this declaration's nodes. Emitted for the kind=ordered_map family only — a
// standalone kind=node / kind=branch stays a bare node (plain pkd, no new_in/
// cow_clone surface, nothing to join).
//
// The traits are DECLARED in logos.mem.bt.map (the import hub): a generated
// `impl BtLeaf<…> for {N}Leaf` is trait-checked at COLLECT time against the
// DECLARING unit's imports, and every declaring unit already carries
// `use logos.mem.bt.map;` (the same contract the generated `impl Ctr` rides).
//
// Delegation resolves to the INHERENT method (inherent wins over the trait
// method being defined — verified empirically; same rule as Rust), so the
// one-line bodies below do not self-recurse.
fn emit_bt_leaf_impl(lname: str, kty: str, vty: str, vol: bool) {
    let nm:  Ident = Ident::new(lname);
    let kid: Ident = Ident::new(kty);
    // VIn = declared value type verbatim (volume declares `val: str`); VOut is
    // the read-side type — by value for fast (FSE), a &[u8] view for volume (VLE).
    let vi: ExprBlob = parse_type(vty);
    let vo: ExprBlob = if vol { parse_type("&[u8]") } else { parse_type(vty) };
    let b: QuoteItemBlob = quote_item! {
        use logos.mem.bt.map;
        use logos.lang.option;
        impl BtLeaf<#(kid), #(vi), #(vo)> for #nm {
            fn adopt(mem: *mut u8) -> #nm { return #nm::adopt(mem); }
            fn new_sibling(self: &#nm, snp: u64) -> #nm { return #nm::new_in(snp); }
            fn block(self: &#nm) -> *mut u8 { return self.block(); }
            fn count(self: &#nm) -> u32 { return self.count(); }
            fn key_at(self: &#nm, i: u32) -> #(kid) { return self.key_at(i); }
            fn val_at(self: &#nm, i: u32) -> #(vo) { return self.val_at(i); }
            fn lower_bound(self: &#nm, key: #(kid)) -> u32 { return self.lower_bound(key); }
            fn try_insert(self: &mut #nm, key: #(kid), val: #(vi)) -> bool { return self.try_insert(key, val); }
            fn with_entry(self: &mut #nm, key: #(kid), f: fn(Option<#(vo)>) -> Option<#(vi)>) -> bool { return self.with_entry(key, f); }
            fn split_into(self: &mut #nm, dst: &mut #nm) { self.split_into(dst); }
            fn cow_clone(self: &#nm, snp: u64) -> #nm { return self.cow_clone(snp); }
            fn free(self: #nm) { self.free(); }
        }
    };
    unsafe { logos_emit_item_blob_subst(&b); }
}

// The branch analog — value-agnostic, so only K threads through.
fn emit_bt_branch_impl(bname: str, kty: str) {
    let nm:  Ident = Ident::new(bname);
    let kid: Ident = Ident::new(kty);
    let b: QuoteItemBlob = quote_item! {
        use logos.mem.bt.map;
        impl BtBranch<#(kid), 1> for #nm {
            fn adopt(mem: *mut u8) -> #nm { return #nm::adopt(mem); }
            fn new_sibling(self: &#nm, snp: u64) -> #nm { return #nm::new_in(snp); }
            fn block(self: &#nm) -> *mut u8 { return self.block(); }
            fn child_count(self: &#nm) -> u32 { return self.child_count(); }
            fn sep_at(self: &#nm, i: u32) -> #(kid) { return self.sep_at(i); }
            fn child_addr(self: &#nm, i: u32) -> *mut u8 { return self.child_addr(i); }
            fn set_child_addr(self: &mut #nm, i: u32, ptr: *mut u8) { self.set_child_addr(i, ptr); }
            fn max_sep(self: &#nm) -> #(kid) { return self.max_sep(); }
            fn total_size(self: &#nm) -> u64 { return self.total_size(); }
            fn totals(self: &#nm, out: &mut [u64; 1]) { out[0] = self.total_size(); }
            fn count_at(self: &#nm, i: u32, _s: u32) -> u64 { return self.size_at(i); }
            fn find_child(self: &#nm, key: #(kid)) -> u32 { return self.find_child(key); }
            fn push_row(self: &mut #nm, sep: #(kid), cnt: &[u64; 1], ptr: *mut u8) { self.push_child(sep, cnt[0], ptr); }
            fn insert_row(self: &mut #nm, pos: u32, sep: #(kid), cnt: &[u64; 1], ptr: *mut u8) { self.insert_child(pos, sep, cnt[0], ptr); }
            fn update_row(self: &mut #nm, i: u32, sep: #(kid), cnt: &[u64; 1]) { self.update_child(i, sep, cnt[0]); }
            fn can_insert_child(self: &#nm) -> bool { return self.can_insert_child(); }
            fn split_into(self: &mut #nm, dst: &mut #nm) -> #(kid) { return self.split_into(dst); }
            fn cow_clone(self: &#nm, snp: u64) -> #nm { return self.cow_clone(snp); }
            fn free_block(self: #nm) { self.free_block(); }
        }
    };
    unsafe { logos_emit_item_blob_subst(&b); }
}

// Emits the concrete b+tree ASSEMBLY handle (`{N}Tree`) realizing the
// container_shape `aspect=assembly value=tree` row (ADR 0020 §5). Since the
// ADR 0021 ops-reshape the handle is THIN: `insert`/`get_or`/`size`/`free`
// are one-line forwards into the generic ops (bt_ins / bt_descend_get /
// bt_size / bt_tree_free), instantiated over this declaration's `{N}Leaf` /
// `{N}Branch` via their BtLeaf/BtBranch impls. Only the root-split graft
// (push both halves under a fresh root branch) stays here — it mutates the
// handle's own root/root_level.
//
// Value handling is VERDICT-selected via `vol`: a fast (FSE) leaf returns the
// value by value (`get_or(key, sentinel: vty) -> vty`); a volume (VLE) leaf
// returns it by view (`get_or(key) -> &[u8]`, borrowing the tree; MISS = an
// empty slice, materialized here as the generic's sentinel argument).
fn emit_tree(tname: str, lname: str, bname: str, kty: str, vty: str, vol: bool) {
    // The tree items are quote blobs; each carries its own `use` imports. All
    // names are plain (no composite {N}IR/{N}_ins/{N}_free free-items anymore —
    // the recursion lives in logos.mem.bt.ops) and borrow the spec, which
    // outlives this synchronous emit. VIn/VOut ride ExprBlobs (Copy — each
    // fragment splices at every turbofish site).
    let tid: Ident = Ident::new(tname);
    let lid: Ident = Ident::new(lname);
    let bid: Ident = Ident::new(bname);
    let kid: Ident = Ident::new(kty);
    let vi: ExprBlob = parse_type(vty);
    let vo: ExprBlob = if vol { parse_type("&[u8]") } else { parse_type(vty) };

    // The tree handle: every op forwards into the generic library; only the
    // root-split graft stays (it mutates the handle's root/root_level).
    let handle: QuoteItemBlob = quote_item! {
        use logos.mem.bt.ops;
        pub struct #tid { root: *mut u8, root_level: u32 }
        impl #tid {
            pub static fn new() -> #tid { let lf: #lid = #lid::new(); return #tid { root: lf.block(), root_level: 0u32 }; }
            pub fn height(self: &#tid) -> u32 { return self.root_level; }
            pub fn size(self: &#tid) -> u64 { return bt_size::<#(kid), #(vi), #(vo), #(lid), #(bid)>(self.root, self.root_level); }
            pub fn insert(self: &mut #tid, key: #(kid), val: #(vi)) {
                let r: BtInsRet<#(kid), 1> = bt_ins::<#(kid), #(vi), #(vo), #(lid), #(bid)>(self.root, self.root_level, key, val);
                if r.split {
                    let mut nr: #bid = #bid::new();
                    nr.push_child(r.lsep, r.lcnt[0], self.root);
                    nr.push_child(r.rsep, r.rcnt[0], r.rptr);
                    self.root = nr.block();
                    self.root_level = self.root_level + 1u32;
                }
            }
            pub fn free(self: #tid) { bt_tree_free::<#(kid), #(vi), #(vo), #(lid), #(bid)>(self.root, self.root_level); }
        }
    };
    unsafe { logos_emit_item_blob_subst(&handle); }

    // get_or — VERDICT-SELECTED value return: fast by VALUE (caller-chosen
    // sentinel), volume by VIEW (&[u8]; the MISS sentinel is an empty slice
    // materialized here and passed to the same generic).
    if vol {
        let g: QuoteItemBlob = quote_item! {
            use logos.mem.bt.ops;
            use logos.lang.slice;
            impl #tid {
                pub fn get_or(self: &#tid, key: #(kid)) -> &[u8] {
                    let miss: &[u8] = unsafe { slice_from_raw::<u8>(self.root as *const u8, 0i64) };
                    return bt_descend_get::<#(kid), #(vi), #(vo), #(lid), #(bid)>(self.root, self.root_level, key, miss);
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&g); }
    } else {
        let g: QuoteItemBlob = quote_item! {
            use logos.mem.bt.ops;
            impl #tid {
                pub fn get_or(self: &#tid, key: #(kid), sentinel: #(vo)) -> #(vo) {
                    return bt_descend_get::<#(kid), #(vi), #(vo), #(lid), #(bid)>(self.root, self.root_level, key, sentinel);
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&g); }
    }
}

// Emits the copy-on-write map's `{N}` Ctr handle realizing the container_shape
// `aspect=versioning value=cow` row (ADR 0020 §5). Since the ADR 0021
// ops-reshape the KEY/VALUE-typed machinery ({N}CowRet / {N}_leaf_private /
// {N}_branch_private / {N}_cow_insert / {N}_descend_get) is NOT emitted — the
// CoW cascade lives ONCE in logos.mem.bt.ops (bt_cow_insert / bt_descend_get /
// bt_size), instantiated over the CoW-flavored {N}Leaf/{N}Branch through their
// BtLeaf/BtBranch impls. The handle keeps only what is genuinely per-config:
// the struct, create/open, and the root repoint/publish after an insert.
//
// The STORE/SNAPSHOT half is NOT generated: containers run on the hand-written
// MemoryStore / MemorySnapshot (logos.mem.bt.memstore) — the container⟂store
// split. `{N}` is a thin typed view of container `ctr_id` in a snapshot; it
// finds its root through the snapshot's directory (`root_of`/`set_root`) and
// releases trees through the store's container-agnostic `tree_release`. One
// snapshot holds MANY containers and commits them atomically.
//
// Value handling is VERDICT-selected via `vol`: fast (FSE) returns by value +
// sentinel; volume (VLE) returns a &[u8] view borrowing the handle (a MISS is
// an empty slice, materialized as the generic's sentinel argument).
//
// Wave-0 unit constraint: the DECLARING unit must `use logos.mem.bt.map;` — the
// generated `impl Ctr for {N}` / `impl BtLeaf<…>` / `impl BtBranch<…>` name
// those traits, and an impl's trait-existence check runs at COLLECT time
// against traits registered from the unit's own imports (an emitted `use`
// resolves types/functions/bounds at RESOLVE time, but too late for the
// collect-phase impl check). A generic `kind map` surface (① / a compiler
// traits-refresh) removes this later. `logos.mem.bt.memstore` (the
// MemorySnapshot capability + DirEntry + tree_release), `logos.mem.bt.ops` and
// `logos.mem.pkd` are function/type refs and resolve via the emitted `use`.
fn emit_cow_map(name: str, lname: str, bname: str, kty: str, vty: str, vol: bool,
                mexpr: ExprBlob) {
    // The map items are quote blobs; each carries its own `use` imports. No
    // composite free-item names remain — all plain names borrow the spec,
    // which outlives this synchronous emit.
    let nm:  Ident = Ident::new(name);
    let lid: Ident = Ident::new(lname);
    // Store-configuration plane (S2): node form + geometry baked from StoreCfg.
    let nd: Ident = Ident::new(MEM_STORE_NODE);
    let scfg: StoreCfg = mem_store_cfg(STORE_CFG_DEFAULT);
    let bid: Ident = Ident::new(bname);
    let kid: Ident = Ident::new(kty);
    let vi: ExprBlob = parse_type(vty);
    let vo: ExprBlob = if vol { parse_type("&[u8]") } else { parse_type(vty) };

    // {N} — the Ctr handle. `insert` forwards into bt_cow_insert and keeps the
    // root repoint (identity change under CoW → release the old root's tree) +
    // root-split graft + `set_root` publish; `size` forwards into bt_size.
    let handle: QuoteItemBlob = quote_item! {
        use logos.mem.bt.map;
        use logos.mem.bt.node;            // the store's node profile (spliced as #nd)
        use logos.mem.bt.memstore;
        use logos.mem.bt.meta;           // the container SCHEMA document plane
        use logos.lang.writ.wstatic;     // WritStatic — the schema document handle
        use logos.mem.bt.ops;
        use logos.mem.sync;               // Arc — the parent hold
        use logos.lang.option;            // Option — the with_entry quad
        pub struct #nm {
            // the PARENT HOLD (Ctr ──Arc→ Snapshot): the ONE snapshot field.
            snap: Arc<dyn Snapshot>,
            ctr_id: u64,
        }
        impl #nm {
            // PRIVILEGED tier: recover the concrete MemorySnapshot from the
            // erased `Arc<dyn Snapshot>` hold. Sound by construction — this
            // family is generated for MemoryStore, so its snap is always a
            // MemorySnapshot (the moral equivalent of Memoria's cast to the
            // internal interface; `dyn_data` = the fat-pointer data half).
            fn ms(self: &#nm) -> &MemorySnapshot {
                return unsafe { &*(dyn_data(&*self.snap) as *const MemorySnapshot) };
            }
            pub static fn create(snap: &Arc<dyn Snapshot>, ctr_id: u64) -> #nm {
                let msr: &MemorySnapshot = unsafe { &*(dyn_data(&**snap) as *const MemorySnapshot) };
                let lf: #lid = #lid::new_in(snap.snapshot_id());
                {
                    let __mroot: *mut u8 = ctr_publish_meta_static(lf.block(), #(mexpr));
                    msr.set_root(ctr_id, __mroot, 0u32);
                }
                return #nm { snap: snap.clone_ref(), ctr_id: ctr_id };
            }
            pub static fn open(snap: &Arc<dyn Snapshot>, ctr_id: u64) -> #nm {
                return #nm { snap: snap.clone_ref(), ctr_id: ctr_id };
            }
            pub fn insert(self: &#nm, key: #(kid), val: #(vi)) {
                unsafe {
                    // root_of_mut privatizes this snapshot's directory path to
                    // the container FIRST (acquiring ownership of the roots on
                    // that leaf), so the flat-store root lifecycle below is
                    // balanced; set_root then only repoints the directory slot.
                    let e: DirEntry = self.ms().root_of_mut(self.ctr_id);
                    let cur: u64 = self.snap.snapshot_id();
                    let r: BtInsRet<#(kid), 1> = bt_cow_insert::<#(kid), #(vi), #(vo), #(lid), #(bid), #nd>(e.root, e.level, key, val, cur);
                    let mut nrt: *mut u8 = e.root;
                    let mut nlv: u32 = e.level;
                    if r.addr != e.root {
                        nrt = r.addr;
                        tree_release(e.root, e.level);
                    }
                    if r.split {
                        let mut top: #bid = #bid::new_in(cur);
                        top.push_child(r.lsep, r.lcnt[0], r.addr);
                        top.push_child(r.rsep, r.rcnt[0], r.rptr);
                        // Root PROMOTION: BOTH documents move to the new root
                        // and the demoted node gives them up (Memoria's
                        // ctr_copy_root_metadata + ctr_root_to_node). Migrating
                        // rather than clearing is what carries the CLIENT's
                        // document across — publication below only knows the
                        // family's schema constant. The new root grows if it
                        // must, so take the address back.
                        nrt = meta_migrate(r.addr, top.block(), cur);
                        nlv = e.level + 1u32;
                    }
                    {
                        let __mroot: *mut u8 = ctr_publish_meta_static(nrt, #(mexpr));
                        self.ms().set_root(self.ctr_id, __mroot, nlv);
                    }
                }
            }
            /// The container-boundary WITH_ENTRY (ADR 0023 §Derived forms —
            /// the with_value generalization): one function drives the quad
            /// (None→Some insert, Some→Some' replace, Some→None remove,
            /// None→None no-op). Same walk discipline as insert: CoW
            /// privatization, root repoint, root-split graft. `f` may run
            /// again if the leaf splits — keep it pure.
            pub fn with_entry(self: &#nm, key: #(kid), f: fn(Option<#(vo)>) -> Option<#(vi)>) {
                unsafe {
                    let e: DirEntry = self.ms().root_of_mut(self.ctr_id);
                    let cur: u64 = self.snap.snapshot_id();
                    let r: BtInsRet<#(kid), 1> = bt_cow_with_entry::<#(kid), #(vi), #(vo), #(lid), #(bid), #nd>(e.root, e.level, key, f, cur);
                    let mut nrt: *mut u8 = e.root;
                    let mut nlv: u32 = e.level;
                    if r.addr != e.root {
                        nrt = r.addr;
                        tree_release(e.root, e.level);
                    }
                    if r.split {
                        let mut top: #bid = #bid::new_in(cur);
                        top.push_child(r.lsep, r.lcnt[0], r.addr);
                        top.push_child(r.rsep, r.rcnt[0], r.rptr);
                        // Root PROMOTION: BOTH documents move to the new root
                        // and the demoted node gives them up (Memoria's
                        // ctr_copy_root_metadata + ctr_root_to_node). Migrating
                        // rather than clearing is what carries the CLIENT's
                        // document across — publication below only knows the
                        // family's schema constant. The new root grows if it
                        // must, so take the address back.
                        nrt = meta_migrate(r.addr, top.block(), cur);
                        nlv = e.level + 1u32;
                    }
                    {
                        let __mroot: *mut u8 = ctr_publish_meta_static(nrt, #(mexpr));
                        self.ms().set_root(self.ctr_id, __mroot, nlv);
                    }
                }
            }
            pub fn size(self: &#nm) -> u64 {
                unsafe {
                    let e: DirEntry = self.ms().root_of(self.ctr_id);
                    return bt_size::<#(kid), #(vi), #(vo), #(lid), #(bid)>(e.root, e.level);
                }
            }
        }
        impl Ctr for #nm {
            fn size(self: &#nm) -> u64 {
                unsafe {
                    let e: DirEntry = self.ms().root_of(self.ctr_id);
                    return bt_size::<#(kid), #(vi), #(vo), #(lid), #(bid)>(e.root, e.level);
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&handle); }

    // get_or on the handle — reads the snapshot's current root for this
    // container, then forwards into bt_descend_get (read path, never copies).
    if vol {
        let g: QuoteItemBlob = quote_item! {
            use logos.mem.bt.memstore;
        use logos.mem.bt.meta;           // the container SCHEMA document plane
        use logos.lang.writ.wstatic;     // WritStatic — the schema document handle
            use logos.mem.bt.ops;
            use logos.lang.slice;
            impl #nm {
                pub fn get_or(self: &#nm, key: #(kid)) -> &[u8] {
                    unsafe {
                        let e: DirEntry = self.ms().root_of(self.ctr_id);
                        let miss: &[u8] = slice_from_raw::<u8>(e.root as *const u8, 0i64);
                        return bt_descend_get::<#(kid), #(vi), #(vo), #(lid), #(bid)>(e.root, e.level, key, miss);
                    }
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&g); }
    } else {
        let g: QuoteItemBlob = quote_item! {
            use logos.mem.bt.memstore;
        use logos.mem.bt.meta;           // the container SCHEMA document plane
        use logos.lang.writ.wstatic;     // WritStatic — the schema document handle
            use logos.mem.bt.ops;
            impl #nm {
                pub fn get_or(self: &#nm, key: #(kid), sentinel: #(vo)) -> #(vo) {
                    unsafe {
                        let e: DirEntry = self.ms().root_of(self.ctr_id);
                        return bt_descend_get::<#(kid), #(vi), #(vo), #(lid), #(bid)>(e.root, e.level, key, sentinel);
                    }
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&g); }
    }

    // ── the BATCH surface (slice 2): make_buffer / insert_batch ────────────
    // The container hands out the staging buffer (typed push casts at THIS
    // boundary — the same K/V discipline as try_insert); insert_batch runs
    // the CoW splice with the family's SIGNEDNESS verdict. A rejected batch
    // (unsorted / interleaving an existing key) returns false with the tree
    // untouched.
    let mut bfn: String = String::new();
    bfn.push_str(name);
    bfn.push_str("Buf");
    let bufid: Ident = Ident::new(bfn.as_str());
    let signed_k: bool = str_byte_at(kty, 0i64) == 105u8;   // 'i'
    let sgn: ExprBlob = parse_expr(if signed_k { "true" } else { "false" });
    let vletag: ExprBlob = parse_expr(if vol { "true" } else { "false" });
    let scfg2: StoreCfg = mem_store_cfg(STORE_CFG_DEFAULT);
    let mut bb_s: String = fmt_display_to_string(&scfg2.branch_bytes());
    bb_s.push_str("u32");
    let bbs: ExprBlob = parse_expr(bb_s.as_str());
    let bq: QuoteItemBlob = quote_item! {
        use logos.mem.bt.pack;
        use logos.mem.bt.node;            // the store's node profile (spliced as #nd)
        use logos.mem.bt.memstore;
        use logos.mem.bt.meta;           // the container SCHEMA document plane
        use logos.lang.writ.wstatic;     // WritStatic — the schema document handle
        pub struct #bufid { inner: BtssBuf }
        impl #bufid {
            pub fn len(self: &#bufid) -> u64 { return self.inner.len(); }
        }
        impl #nm {
            /// The staging buffer for a batch: keys + values in the leaf's
            /// physical column format, growable, RAII-owned.
            pub fn make_buffer(self: &#nm) -> #bufid {
                return #bufid { inner: btss_buf_new(#(vletag), 1024u64) };
            }
            /// Batch insert: `buf` strictly ascending by key, landing WHOLE
            /// between two adjacent existing keys. False = rejected
            /// (unsorted or interleaving), tree untouched. CoW walk — same
            /// privatize/repoint discipline as insert.
            pub fn insert_batch(self: &#nm, buf: &#bufid) -> bool {
                unsafe {
                    let e: DirEntry = self.ms().root_of_mut(self.ctr_id);
                    let r: BtssBatchRet = btss_batch_insert::<#nd>(self.ms(), e.root, e.level,
                                                                   &buf.inner, #(sgn), #(bbs));
                    if r.ok {
                        {
                            let __mroot: *mut u8 = ctr_publish_meta_static(r.root, #(mexpr));
                            self.ms().set_root(self.ctr_id, __mroot, r.level);
                        }
                    }
                    return r.ok;
                }
            }
            /// Remove `key`. False = absent (nothing mutated). CoW walk;
            /// the touched node MERGES with a neighbor when the combined
            /// weight fits (the C++ remove-then-merge discipline under
            /// exact admission); the root collapses while it is a
            /// one-child branch.
            pub fn remove(self: &#nm, key: #(kid)) -> bool {
                unsafe {
                    let e: DirEntry = self.ms().root_of_mut(self.ctr_id);
                    let r: BtssRemRet = btss_remove::<#nd>(self.ms(), e.root, e.level,
                                                           key as u64, #(sgn));
                    if r.found {
                        {
                            let __mroot: *mut u8 = ctr_publish_meta_static(r.root, #(mexpr));
                            self.ms().set_root(self.ctr_id, __mroot, r.level);
                        }
                    }
                    return r.found;
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&bq); }
    if vol {
        let bp: QuoteItemBlob = quote_item! {
            use logos.mem.bt.pack;
            use logos.mem.bt.map;         // BatchMapEntryVol — the adapter seam
            use logos.mem.collections.vec;
            use logos.lang.slice;
            use logos.lang.panic;
            impl #bufid {
                pub fn push(self: &mut #bufid, key: #(kid), val: str) {
                    // the staging-boundary entry bound (1/4 of the block)
                    assert(8i64 + val.len() <= 1024i64,
                           "batch: value exceeds the entry bound (1/4 block)");
                    unsafe {
                        self.inner.push_span(key as u64,
                                             slice_from_raw::<u8>(val.as_ptr(), val.len()));
                    }
                }
                /// One adapter-implementing application entry.
                pub fn push_from<T: BatchMapEntryVol>(self: &mut #bufid, e: &T) {
                    let v: str = e.val_str();
                    assert(8i64 + v.len() <= 1024i64,
                           "batch: value exceeds the entry bound (1/4 block)");
                    unsafe {
                        self.inner.push_span(e.key_cell(),
                                             slice_from_raw::<u8>(v.as_ptr(), v.len()));
                    }
                }
                /// A whole collection of adapter entries.
                pub fn extend_from<T: BatchMapEntryVol>(self: &mut #bufid, items: &Vec<T>) {
                    let mut i: i64 = 0i64;
                    while i < items.length() {
                        self.push_from(items.borrow(i));
                        i = i + 1i64;
                    }
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&bp); }
    } else {
        let bp: QuoteItemBlob = quote_item! {
            use logos.mem.bt.map;         // BatchMapEntry — the adapter seam
            use logos.mem.collections.vec;
            impl #bufid {
                pub fn push(self: &mut #bufid, key: #(kid), val: #(vi)) {
                    self.inner.push_cell(key as u64, val as u64);
                }
                /// One adapter-implementing application entry.
                pub fn push_from<T: BatchMapEntry>(self: &mut #bufid, e: &T) {
                    self.inner.push_cell(e.key_cell(), e.val_cell());
                }
                /// A whole collection of adapter entries.
                pub fn extend_from<T: BatchMapEntry>(self: &mut #bufid, items: &Vec<T>) {
                    let mut i: i64 = 0i64;
                    while i < items.length() {
                        self.push_from(items.borrow(i));
                        i = i + 1i64;
                    }
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&bp); }
    }

    // ── seek by entry NUMBER (the stream-size feature; Memoria's classic
    // BTSS semantics): every container doubles as an ARRAY of its entries.
    // `{N}Cur` is the v0 cursor — leaf identity + local index, with typed
    // key/value reads through the leaf; movement (next/prev) is the cursors
    // arc. The branch subtree-count column that powers the descent has been
    // maintained by every insert since S2b — bt_seek_at is its read side.
    let mut cn: String = String::new();
    cn.push_str(name);
    cn.push_str("Cur");
    let cid: Ident = Ident::new(cn.as_str());
    let cq: QuoteItemBlob = quote_item! {
        use logos.mem.bt.map;
        use logos.mem.bt.memstore;
        use logos.mem.bt.meta;           // the container SCHEMA document plane
        use logos.lang.writ.wstatic;     // WritStatic — the schema document handle
        use logos.mem.bt.ops;
        use logos.lang.panic;
        // The cursor HOLDS the adopted leaf (not the raw block pointer): a
        // volume family's `value()` returns a &[u8] view whose borrow must
        // run through `self` — a view derived from a locally adopted leaf
        // would be a dangling reference, and borrowck says so.
        pub struct #cid { pub found: bool, lf: #lid, idx: u32 }
        impl #cid {
            pub fn valid(self: &#cid) -> bool { return self.found; }
            pub fn key(self: &#cid) -> #(kid) {
                assert(self.found, "cursor: key() past the end");
                return self.lf.key_at(self.idx);
            }
            pub fn value(self: &#cid) -> #(vo) {
                assert(self.found, "cursor: value() past the end");
                return self.lf.val_at(self.idx);
            }
        }
        impl #nm {
            /// Cursor at the `pos`-th entry in KEY ORDER (0-based). Past the
            /// end ⇒ an invalid cursor (`valid() == false`), never a trap.
            pub fn seek(self: &#nm, pos: u64) -> #cid {
                unsafe {
                    let e: DirEntry = self.ms().root_of(self.ctr_id);
                    let c: BtCur = bt_seek_at::<#(kid), #(vi), #(vo), #(lid), #(bid)>(e.root, e.level, pos);
                    return #cid { found: c.found, lf: #lid::adopt(c.leaf), idx: c.idx };
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&cq); }

    // ── the Deem projection: the map AS A RELATION ─────────────────────────
    // `rel entry(key, val)` — the container's own vocabulary, one row per entry
    // in key order. The materializer walks the entry-number cursor (the same
    // descent `seek` exposes), so the projection rides the container's public
    // read surface and holds no layout knowledge of its own.
    //
    // FSE values only for now: a volume family's value is a `&[u8]`, which
    // projects as a `str` rel column — a second shape, not a harder one.
    if !vol {
        let mut rows_s: String = String::new();
        rows_s.push_str("__ctr_rows_");
        rows_s.push_str(name);
        let rowsfn: Ident = Ident::new(rows_s.as_str());
        let pq: QuoteItemBlob = quote_item! {
            use logos.mem.bt.map;             // trait OrderedMapSource — the hub rel
            use logos.mem.collections.vec;
            pub fn #rowsfn(c: &#nm) -> Vec<(i64, i64)> {
                let mut out: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
                let n: u64 = c.size();
                let mut i: u64 = 0u64;
                while i < n {
                    let cu: #cid = c.seek(i);
                    if cu.valid() {
                        out.push((cu.key() as i64, cu.value() as i64));
                    }
                    i = i + 1u64;
                }
                return out;
            }
            impl OrderedMapSource for #nm { rel entry = #rowsfn; }
        };
        unsafe { logos_emit_item_blob_subst(&pq); }
    }
}

// ── ADR 0021 Phase 4b: the container's CFG document ───────────────────────
//
// The DECL-SITE lowering of a kind=ordered_map container. Synthesize ONLY
//
//   pub const <Name>Cfg<GENERICS?>: WritStatic = @{ … };
//
// A `container Map<K,V> {...}` item is a DECLARATION, not a type, and no
// type alias is emitted for it: the container's value type depends on the
// STORE as well as the configuration (per-store emitter specialization), so
// `Map<i64,i64>` must not name a handle. The declaration-to-type bridge is
// `typeof(Map::<i64,i64>)` → `CtrClass<@{…}>` (the typed wrapper over
// the config constant — sema resolves typeof over a registered container
// declaration through THIS emitted const, so the doc has one source of
// truth and one hash). Naming the wrapper in create_ctr::<typeof(…)> fires
// the mono demand; __container_factory is the only family emitter.
//
// The CFG doc's content hash (@hs) is the family identity: structurally
// identical declarations produce byte-identical docs → one family (twin
// dedup, no name in the key). A GENERIC declaration emits a generic const
// (bounds verbatim); use-site substitution produces the concrete @hs per
// instantiation. The key column is always a sized (FSE) type → `<type:K>`;
// a concrete `str` value column is unsized (VLE) and cannot ride
// `<type:str>`, so it is recorded as the string tag "str" (the factory reads
// either form). KNOWN GAP (documented, accepted): a GENERIC value param
// instantiated at `str` renders `<type:str>` in the substituted doc and is
// rejected — str-valued maps need a concrete declaration for now.
//
// Returns false after diagnosing a shape violation loudly (the decl path has
// no other emission left — a silent skip would surface as "unknown type"
// at every consumer instead of the real error).
fn emit_cfg_doc(name: str, cs: &ContainerSpec) -> bool {
    // The POSITIONAL container's config: kind + the single value column. The
    // factory has generated b+tree-backed vector families (emit_btvec_family)
    // since 8b — what was missing is a way to ASK for one, because a family is
    // demanded by naming `typeof(V::<…>)`, and that needs a config document to
    // name. A vector without one could only ever be reached through a
    // hand-written backing type, which is the wave-0 scaffold this removes.
    if str_eq(cs.kind, KIND_VECTOR) {
        let ce0: i64 = cs.entry.len();
        let b0: i64 = cf_next_comma(cs.entry, 0i64, ce0);
        if b0 != ce0 {
            error("container item: a `kind vector` config takes exactly one entry column");
            return false;
        }
        let c1: i64 = cf_find(cs.entry, 0i64, 58u8);       // ':' after the name
        let mut c2: i64 = b0 - 1i64;
        while c2 > 0i64 && str_byte_at(cs.entry, c2) != 58u8 { c2 = c2 - 1i64; }
        if c1 < 0i64 || c2 <= c1 {
            error("container item: malformed vector entry column (compiler seam regression?)");
            return false;
        }
        let vty0: str = unsafe { cf_sub(cs.entry, c1 + 1i64, c2) };
        let mut cfgnm0_s: String = String::new();
        cfgnm0_s.push_str(name);
        cfgnm0_s.push_str("Cfg");
        let cfgnm0: Ident = Ident::new(cfgnm0_s.as_str());
        let gp0: ExprBlob = parse_type_params(cs.generics);
        let vt0: ExprBlob = parse_type(vty0);
        let b: QuoteItemBlob = quote_item! {
            use logos.lang.writ.wstatic;
            pub const #cfgnm0 #(gp0): WritStatic = @{ "kind": "vector", "value": <type:#(vt0)> };
        };
        unsafe { logos_emit_item_blob_subst(&b); }
        return true;
    }
    if !str_eq(cs.kind, KIND_ORDERED_MAP) {
        return true;
    } // map + vector surface
    if cs.pkg.len() == 0i64 {
        error("container item: ordered_map spec carries no `pkg=` segment (compiler seam regression?)");
        return false;
    }
    let ce: i64 = cs.entry.len();
    let nb0: i64 = cf_next_comma(cs.entry, 0i64, ce);
    if nb0 == ce {
        error("container item: a `kind ordered_map` needs two entry columns (`entry { key: K, val: V }`)");
        return false;
    }
    let nb1: i64 = cf_next_comma(cs.entry, nb0 + 1i64, ce);
    if nb1 != ce {
        error("container item: wave-0 `kind ordered_map` supports exactly two entry columns (key, val)");
        return false;
    }
    let k1: i64 = cf_find(cs.entry, 0i64, 58u8);       // ':' of key col
    let mut k2: i64 = nb0 - 1i64;
    while k2 > 0i64 && str_byte_at(cs.entry, k2) != 58u8 {
        k2 = k2 - 1i64;
    }
    if k1 < 0i64 || k2 <= k1 {
        error("container item: malformed key column (compiler seam regression?)");
        return false;
    }
    let kty: str = unsafe { cf_sub(cs.entry, k1 + 1i64, k2) };
    let v1: i64 = cf_find(cs.entry, nb0 + 1i64, 58u8);  // ':' of val col
    let mut v2: i64 = nb1 - 1i64;
    while v2 > nb0 && str_byte_at(cs.entry, v2) != 58u8 {
        v2 = v2 - 1i64;
    }
    if v1 < 0i64 || v2 <= v1 {
        error("container item: malformed val column (compiler seam regression?)");
        return false;
    }
    let vty: str = unsafe { cf_sub(cs.entry, v1 + 1i64, v2) };

    // The CFG const via quote_item! (retires the last hand-formatted text
    // emission on the container decl path — the fragment lands in the declaring
    // package like every other quote emitter here, no explicit `emit_into`).
    // The name is the composite Ident `<name>Cfg`; the generic header rides
    // `#(gp)` — parse_type_params of the declared list (empty ⇒ no `<...>`, the
    // concrete-decl case); the key type slot splices through `<type:#(kt)>`.
    // The value column keeps its two forms: a sized value rides `<type:#(vt)>`,
    // an unsized `str` value keeps the `"str"` VLE tag literally (it cannot ride
    // `<type:str>`). Byte-identical to the former text emission by construction:
    // both paths reduce to the same CONST_DEF AST before the renderer.
    let mut cfgnm_s: String = String::new();
    cfgnm_s.push_str(name);
    cfgnm_s.push_str("Cfg");
    let cfgnm: Ident = Ident::new(cfgnm_s.as_str());
    let gp: ExprBlob = parse_type_params(cs.generics);
    let kt: ExprBlob = parse_type(kty);
    if str_eq(vty, "str") {
        let b: QuoteItemBlob = quote_item! {
            use logos.lang.writ.wstatic;
            pub const #cfgnm #(gp): WritStatic = @{ "kind": "ordered_map", "key": <type:#(kt)>, "value": "str" };
        };
        unsafe { logos_emit_item_blob_subst(&b); }
    } else {
        let vt: ExprBlob = parse_type(vty);
        let b: QuoteItemBlob = quote_item! {
            use logos.lang.writ.wstatic;
            pub const #cfgnm #(gp): WritStatic = @{ "kind": "ordered_map", "key": <type:#(kt)>, "value": <type:#(vt)> };
        };
        unsafe { logos_emit_item_blob_subst(&b); }
    }
    return true;
}

// ── BTFL 8b Phase: the multimap (multistream) CFG document ─────────────────
//
// The DECL-SITE lowering of a kind=multimap container. Same contract as the
// ordered_map emit_cfg_doc: synthesize ONLY the config const — the family is
// generated by the factory when mono demands CtrClass<CFG>. The doc records
// the streams list, the per-stream entry columns (type slots — the generic
// substitution axis), the measure and OPS facts, and the per-stream LAYOUT
// verdicts (Canon decl-time; v0 = always row). Layout is deliberately part
// of the doc: the family identity (@hs) includes the layout decision, so
// when 8c's scan→column rule flips a verdict, the flipped doc is a NEW
// family. cols come LAST — the factory re-parses them by forward scan.
//
//   @{ "kind": "multimap", "streams": "keys,values",
//      "measures": "keys.max(key),values.count",
//      "ops": "keys.seek(max(key)),…", "layouts": "keys:row,values:row",
//      "cols": [ { "stream": "keys", "name": "key", "ty": <type:K> }, … ] }
//
// The variable-shape doc cannot ride one static @{…} quote template — the
// SOURCE is composed and reified through parse_wstatic (the same primitive
// the factory's CtrFamily impl splices), then spliced into the quoted const.
fn emit_cfg_doc_multimap(name: str, cs: &ContainerSpec,
                         vm: &WMap<WString, WAny>) -> bool {
    if cs.pkg.len() == 0i64 {
        error("container item: multimap spec carries no `pkg=` segment (compiler seam regression?)");
        return false;
    }
    // Per-stream layout verdicts (decl-time Canon; v0 row).
    let mut lay: String = String::new();
    {
        let cn: i64 = cs.streams.len();
        let mut a: i64 = 0i64;
        let mut first: bool = true;
        while a < cn {
            let b: i64 = cf_next_comma(cs.streams, a, cn);
            let sname: str = unsafe { cf_sub(cs.streams, a, b) };
            let l: str = cv_stream_layout(vm, name, sname);
            if l.len() == 0i64 {
                error("container item: Canon produced no layout verdict for a declared stream (Canon seam regression?)");
                return false;
            }
            if !first {
                lay.push_str(",");
            }
            first = false;
            lay.push_str(sname);
            lay.push_str(":");
            lay.push_str(l);
            a = b + 1i64;
        }
    }
    let mut src: String = String::new();
    src.push_str("@{ \"kind\": \"multimap\", \"streams\": \"");
    src.push_str(cs.streams);
    src.push_str("\", \"measures\": \"");
    src.push_str(cs.measures);
    src.push_str("\", \"ops\": \"");
    src.push_str(cs.ops);
    src.push_str("\", \"layouts\": \"");
    src.push_str(lay.as_str());
    src.push_str("\", \"cols\": [");
    {
        let ce: i64 = cs.entry.len();
        let mut a: i64 = 0i64;
        let mut first: bool = true;
        while a < ce {
            let b: i64 = cf_next_comma(cs.entry, a, ce);
            let c1: i64 = cf_find(cs.entry, a, 58u8);        // ':'
            let mut c2: i64 = b - 1i64;
            while c2 > a && str_byte_at(cs.entry, c2) != 58u8 {
                c2 = c2 - 1i64;
            }
            if c1 < 0i64 || c1 >= b || c2 <= c1 {
                error("container item: malformed multimap entry column (compiler seam regression?)");
                return false;
            }
            let dot: i64 = cf_dot(cs.entry, a, c1);
            if dot < 0i64 {
                error("container item: multimap entry column lacks its stream qualifier (compiler seam regression?)");
                return false;
            }
            if !first {
                src.push_str(", ");
            }
            first = false;
            src.push_str("{ \"stream\": \"");
            src.push_str(unsafe { cf_sub(cs.entry, a, dot) });
            src.push_str("\", \"name\": \"");
            src.push_str(unsafe { cf_sub(cs.entry, dot + 1i64, c1) });
            src.push_str("\", \"ty\": <type:");
            src.push_str(unsafe { cf_sub(cs.entry, c1 + 1i64, c2) });
            src.push_str("> }");
            a = b + 1i64;
        }
    }
    src.push_str("] }");

    let mut cfgnm_s: String = String::new();
    cfgnm_s.push_str(name);
    cfgnm_s.push_str("Cfg");
    let cfgnm: Ident = Ident::new(cfgnm_s.as_str());
    let gp: ExprBlob = parse_type_params(cs.generics);
    let cfg: ExprBlob = parse_wstatic(src.as_str());
    let b: QuoteItemBlob = quote_item! {
        use logos.lang.writ.wstatic;
        pub const #cfgnm #(gp): WritStatic = #(cfg);
    };
    unsafe { logos_emit_item_blob_subst(&b); }
    return true;
}

// ── BTFL 8b: the generated multimap FAMILY — thin glue over the btfl
// runtime library (the placement rule: runtime ops = logos.mem.bt.btfl free
// fns, generation = the concrete wiring for THIS cfg). v0 limits are
// VALIDATED here loudly (never silently narrowed):
//   * exactly TWO streams — the 8a runtime is the 2-stream mechanics
//     (per-symbol CNT0/CNT1 branch columns; alphabet = stream count
//     generalizes with 8c);
//   * one u64 entry column per stream (the runtime's PkdArray<u64> columns);
//   * row layout on every stream (the v0 Canon verdict — col arrives in 8c).
// The handle mirrors the CoW map's `{snap, ctr_id}` shape and finds its tree
// through the snapshot directory; node sizing is per-handle (create_with) —
// splits allocate siblings of the handle's size.
fn emit_btfl_family(name: str, cs: &ContainerSpec, vm: &WMap<WString, WAny>,
                    mexpr: ExprBlob) {
    // ── v0 shape validation ─────────────────────────────────────────────────
    let sn: i64 = cs.streams.len();
    let s0e: i64 = cf_next_comma(cs.streams, 0i64, sn);
    if s0e == sn {
        error("container factory: multimap cfg carries fewer than two streams (Canon gate regression?)");
        return;
    }
    let s1e: i64 = cf_next_comma(cs.streams, s0e + 1i64, sn);
    if s1e != sn {
        error("container factory: BTFL v0 generates exactly TWO-stream multimaps — wider families land with 8c");
        return;
    }
    let s0: str = unsafe { cf_sub(cs.streams, 0i64, s0e) };
    let s1: str = unsafe { cf_sub(cs.streams, s0e + 1i64, sn) };
    // 8c: the layout verdict (scan→column default) is ACCEPTED and recorded
    // in the generated cfg. For single-column entries — everything the v0
    // factory generates — row and col coincide physically; the runtime is
    // layout-agnostic until multi-column entries arrive. The verdict must
    // still EXIST for every stream (the Canon seam contract).
    if cv_stream_layout(vm, name, s0).len() == 0i64
            || cv_stream_layout(vm, name, s1).len() == 0i64 {
        error("container factory: Canon produced no layout verdict for a declared stream (Canon seam regression?)");
        return;
    }
    // Columns: exactly one per stream, both u64 (the 8a runtime's column type).
    let ce: i64 = cs.entry.len();
    let b0: i64 = cf_next_comma(cs.entry, 0i64, ce);
    if b0 == ce {
        error("container factory: multimap cfg carries fewer than two entry columns (seam regression?)");
        return;
    }
    let b1: i64 = cf_next_comma(cs.entry, b0 + 1i64, ce);
    if b1 != ce {
        error("container factory: BTFL v0 generates one entry column per stream — multi-column streams land with 8a2/8c");
        return;
    }
    let mut ok_cols: bool = true;
    {
        let mut a: i64 = 0i64;
        let mut which: i64 = 0i64;
        while which < 2i64 {
            let b: i64 = cf_next_comma(cs.entry, a, ce);
            let c1: i64 = cf_find(cs.entry, a, 58u8);
            let mut c2: i64 = b - 1i64;
            while c2 > a && str_byte_at(cs.entry, c2) != 58u8 {
                c2 = c2 - 1i64;
            }
            if c1 < 0i64 || c1 >= b || c2 <= c1 {
                ok_cols = false;
            } else {
                let dot: i64 = cf_dot(cs.entry, a, c1);
                if dot < 0i64 {
                    ok_cols = false;
                } else {
                    let strm: str = unsafe { cf_sub(cs.entry, a, dot) };
                    let want: str = if which == 0i64 { s0 } else { s1 };
                    if !str_eq(strm, want) {
                        ok_cols = false;
                    }
                    if !str_eq(unsafe { cf_sub(cs.entry, c1 + 1i64, c2) }, "u64") {
                        error("container factory: BTFL v0 generates u64 column streams only — generic column types land with 8c");
                        return;
                    }
                }
            }
            a = b + 1i64;
            which = which + 1i64;
        }
    }
    if !ok_cols {
        error("container factory: multimap cfg columns do not match its stream order (seam regression?)");
        return;
    }

    // ── the family: handle struct + thin delegation into logos.mem.bt.btfl ──
    let nm: Ident = Ident::new(name);
    // The store-configuration plane (S2): the node form and the default node
    // geometry come from the composed StoreCfg — the emitter BAKES them into
    // the generated family instead of hardcoding the MemoryStore spellings.
    let nd: Ident = Ident::new(MEM_STORE_NODE);
    let scfg: StoreCfg = mem_store_cfg(STORE_CFG_DEFAULT);
    let mut lbs_s: String = fmt_display_to_string(&scfg.leaf_bytes());
    lbs_s.push_str("u32");
    let lbs: ExprBlob = parse_expr(lbs_s.as_str());
    let mut bbs_s: String = fmt_display_to_string(&scfg.branch_bytes());
    bbs_s.push_str("u32");
    let bbs: ExprBlob = parse_expr(bbs_s.as_str());
    let b: QuoteItemBlob = quote_item! {
        use logos.mem.bt.btfl;
        use logos.mem.bt.map;             // Ctr / Multimap — the dyn boundary traits
        use logos.mem.bt.node;            // the store's node profile (spliced as #nd)
        use logos.mem.bt.memstore;
        use logos.mem.bt.meta;           // the container SCHEMA document plane
        use logos.lang.writ.wstatic;     // WritStatic — the schema document handle
        use logos.mem.sync;               // Arc — the parent hold
        use logos.mem.collections.vec;
        use logos.lang.panic;
        pub struct #nm {
            // the PARENT HOLD (ownership chain: Ctr ──Arc→ Snapshot): the ONE
            // snapshot field.
            snap: Arc<dyn Snapshot>,
            ctr_id: u64,
            leaf_bytes: u32,
            branch_bytes: u32,
        }
        impl #nm {
            // PRIVILEGED tier: recover the concrete MemorySnapshot from the
            // erased `Arc<dyn Snapshot>` hold (this family is generated for
            // MemoryStore, so its snap is always a MemorySnapshot).
            fn ms(self: &#nm) -> &MemorySnapshot {
                return unsafe { &*(dyn_data(&*self.snap) as *const MemorySnapshot) };
            }
            pub static fn create(snap: &Arc<dyn Snapshot>, ctr_id: u64) -> #nm {
                return #nm::create_with(snap, ctr_id, #(lbs), #(bbs));
            }
            pub static fn create_with(snap: &Arc<dyn Snapshot>, ctr_id: u64,
                                      leaf_bytes: u32, branch_bytes: u32) -> #nm {
                let msr: &MemorySnapshot = unsafe { &*(dyn_data(&**snap) as *const MemorySnapshot) };
                let t: Btfl<2, #nd> = btfl_create::<2, #nd>(msr, leaf_bytes, branch_bytes);
                {
                    let __mroot: *mut u8 = ctr_publish_meta_static(t.root, #(mexpr));
                    msr.set_root(ctr_id, __mroot, t.level);
                }
                return #nm {
                    snap: snap.clone_ref(),
                    ctr_id: ctr_id,
                    leaf_bytes: leaf_bytes,
                    branch_bytes: branch_bytes,
                };
            }
            pub static fn open(snap: &Arc<dyn Snapshot>, ctr_id: u64) -> #nm {
                return #nm {
                    snap: snap.clone_ref(),
                    ctr_id: ctr_id,
                    leaf_bytes: #(lbs),
                    branch_bytes: #(bbs),
                };
            }
            pub fn tree(self: &#nm) -> Btfl<2, #nd> {
                unsafe {
                    let e: DirEntry = self.ms().root_of(self.ctr_id);
                    return Btfl::<2, #nd> {
                        root: e.root,
                        level: e.level,
                        leaf_bytes: self.leaf_bytes,
                        branch_bytes: self.branch_bytes,
                    };
                }
            }
            // The MUTATION view: privatizes this snapshot's directory path first
            // (root_of_mut), so the engine's flat-store root lifecycle is
            // balanced and set_root only repoints the directory slot.
            fn tree_mut(self: &#nm) -> Btfl<2, #nd> {
                unsafe {
                    let e: DirEntry = self.ms().root_of_mut(self.ctr_id);
                    return Btfl::<2, #nd> {
                        root: e.root,
                        level: e.level,
                        leaf_bytes: self.leaf_bytes,
                        branch_bytes: self.branch_bytes,
                    };
                }
            }
            /// Re-creates the (EMPTY — asserted) container with new node
            /// sizing; splits then allocate siblings of the new size.
            pub fn reformat(self: &mut #nm, leaf_bytes: u32, branch_bytes: u32) {
                let t: Btfl<2, #nd> = self.tree_mut();
                assert(btfl_count::<2, #nd>(&t, 0u64) == 0u64, "reformat: container not empty");
                btfl_drop::<2, #nd>(&t);
                unsafe {
                    let t2: Btfl<2, #nd> = btfl_create::<2, #nd>(self.ms(), leaf_bytes, branch_bytes);
                    {
                        let __mroot: *mut u8 = ctr_publish_meta_static(t2.root, #(mexpr));
                        self.ms().set_root(self.ctr_id, __mroot, t2.level);
                    }
                }
                self.leaf_bytes = leaf_bytes;
                self.branch_bytes = branch_bytes;
            }
            pub fn insert(self: &#nm, key: u64, vals: &Vec<u64>) -> bool {
                unsafe {
                    let mut t: Btfl<2, #nd> = self.tree_mut();
                    // multimap container: one key entry + `vals` as stream 1
                    let mut lens: Vec<u64> = vec_new::<u64>();
                    lens.push(vals.length() as u64);
                    let ok: bool = btfl_insert_n::<2, #nd>(self.ms(), &mut t, key, vals, &lens);
                    if ok {
                        {
                            let __mroot: *mut u8 = ctr_publish_meta_static(t.root, #(mexpr));
                            self.ms().set_root(self.ctr_id, __mroot, t.level);
                        }
                    }
                    return ok;
                }
            }
            pub fn find(self: &#nm, key: u64, out: &mut Vec<u64>) -> bool {
                let t: Btfl<2, #nd> = self.tree();
                return btfl_key_stream::<2, #nd>(self.ms(), &t, key, 1u32, out);
            }
            /// Remove the ENTRY keyed `key` — the key, its whole value run
            /// and its structure symbols. False = absent (nothing mutated).
            /// The touched node merges with a neighbor under exact weight
            /// admission; the root collapses while it is a one-child branch.
            pub fn remove(self: &#nm, key: u64) -> bool {
                unsafe {
                    let mut t: Btfl<2, #nd> = self.tree_mut();
                    let ok: bool = btfl_remove::<#nd>(self.ms(), &mut t, key);
                    if ok {
                        {
                            let __mroot: *mut u8 = ctr_publish_meta_static(t.root, #(mexpr));
                            self.ms().set_root(self.ctr_id, __mroot, t.level);
                        }
                    }
                    return ok;
                }
            }
            /// Seek by the KEY MEASURE (`keys.seek(max(key))` — the declared
            /// ops row): where `key` lands in key order. The POSITIONAL
            /// `seek(n)` (Memoria's classic entry-number semantics) lives
            /// below with the cursor pair.
            pub fn seek_key(self: &#nm, key: u64) -> BtflSeek {
                let t: Btfl<2, #nd> = self.tree();
                return btfl_seek::<2, #nd>(self.ms(), &t, key);
            }
            pub fn select(self: &#nm, sym: u64, rank: u64) -> BtflLoc {
                let t: Btfl<2, #nd> = self.tree();
                return btfl_select::<2, #nd>(self.ms(), &t, sym, rank);
            }
            pub fn access(self: &#nm, pos: u64) -> u64 {
                let t: Btfl<2, #nd> = self.tree();
                return btfl_access::<2, #nd>(self.ms(), &t, pos);
            }
            pub fn count(self: &#nm, sym: u64) -> u64 {
                let t: Btfl<2, #nd> = self.tree();
                return btfl_count::<2, #nd>(&t, sym);
            }
            pub fn check(self: &#nm) -> bool {
                let t: Btfl<2, #nd> = self.tree();
                return btfl_check::<2, #nd>(self.ms(), &t);
            }
            pub fn level(self: &#nm) -> u32 {
                return self.tree().level;
            }
        }
        // ── the dyn BOUNDARY (S3): the family handle behind trait objects ──
        // Deem holds `&dyn Ctr` (uniform plane) / `&mut dyn Multimap` (typed
        // family surface); inside sits THIS monomorphized handle. The impl
        // bodies delegate to the inherent methods (same names — inherent wins
        // at dispatch, which is exactly the delegation we want).
        impl Ctr for #nm {
            fn size(self: &#nm) -> u64 { return self.count(0u64); }
        }
        impl Multimap for #nm {
            fn find(self: &#nm, key: u64, out: &mut Vec<u64>) -> bool {
                return self.find(key, out);
            }
            fn insert(self: &#nm, key: u64, vals: &Vec<u64>) -> bool {
                return self.insert(key, vals);
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&b); }

    // ── the BATCH surface (slice 3): make_buffer / insert_batch ────────────
    // Entries staged whole (key + value run — the entry-aligned cut unit);
    // the splice rebuilds each fragment's SSRLE segment from the counts.
    let mut mbn: String = String::new();
    mbn.push_str(name);
    mbn.push_str("Buf");
    let mbufid: Ident = Ident::new(mbn.as_str());
    let mbq: QuoteItemBlob = quote_item! {
        use logos.mem.bt.btfl;
        use logos.mem.bt.node;
        use logos.mem.bt.map;             // BatchMmEntry — the adapter seam
        use logos.mem.bt.memstore;
        use logos.mem.bt.meta;           // the container SCHEMA document plane
        use logos.lang.writ.wstatic;     // WritStatic — the schema document handle
        use logos.mem.collections.vec;
        pub struct #mbufid { inner: BtflBuf }
        impl #mbufid {
            pub fn len(self: &#mbufid) -> u64 { return self.inner.len(); }
            /// Append one entry: `key` with its value run.
            pub fn push(self: &mut #mbufid, key: u64, vals: &Vec<u64>) {
                self.inner.push_entry(key, vals);
            }
            /// One adapter-implementing application entry (BatchMmEntry).
            pub fn push_from<T: BatchMmEntry>(self: &mut #mbufid, e: &T) {
                let mut run: Vec<u64> = vec_new::<u64>();
                e.val_run(&mut run);
                self.inner.push_entry(e.key_cell(), &run);
            }
            /// A whole collection of adapter entries.
            pub fn extend_from<T: BatchMmEntry>(self: &mut #mbufid, items: &Vec<T>) {
                let mut i: i64 = 0i64;
                while i < items.length() {
                    self.push_from(items.borrow(i));
                    i = i + 1i64;
                }
            }
        }
        impl #nm {
            /// The staging buffer for a batch of entries.
            pub fn make_buffer(self: &#nm) -> #mbufid {
                return #mbufid { inner: btfl_buf_new() };
            }
            /// Batch insert: entries strictly ascending by key, landing
            /// WHOLE between two adjacent existing keys. False = rejected
            /// (unsorted or interleaving), tree untouched.
            pub fn insert_batch(self: &#nm, buf: &#mbufid) -> bool {
                unsafe {
                    let mut t: Btfl<2, #nd> = self.tree();
                    let ok: bool = btfl_batch_insert::<#nd>(self.ms(), &mut t, &buf.inner);
                    if ok {
                        {
                            let __mroot: *mut u8 = ctr_publish_meta_static(t.root, #(mexpr));
                            self.ms().set_root(self.ctr_id, __mroot, t.level);
                        }
                    }
                    return ok;
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&mbq); }

    // ── the hierarchical entry seek (stream-size feature, BTFL semantics):
    // `ctr.seek(n)` = cursor at the n-th KEY (symbol 0 marks the top nesting
    // level), `key_cur.seek(m)` = cursor at the m-th VALUE of that key — the
    // RELATIVE seek, resolved inside the key's leaf (the cheap case the C++
    // shuttles optimize for). Cursor movement is the cursors arc; these are
    // the v0 position pairs with typed reads.
    let mut kcn: String = String::new();
    kcn.push_str(name);
    kcn.push_str("KeyCur");
    let kcid: Ident = Ident::new(kcn.as_str());
    let mut vcn: String = String::new();
    vcn.push_str(name);
    vcn.push_str("ValCur");
    let vcid: Ident = Ident::new(vcn.as_str());
    let sq: QuoteItemBlob = quote_item! {
        use logos.mem.bt.btfl;
        use logos.mem.bt.node;
        use logos.mem.bt.memstore;
        use logos.mem.bt.meta;           // the container SCHEMA document plane
        use logos.lang.writ.wstatic;     // WritStatic — the schema document handle
        use logos.lang.panic;
        pub struct #kcid { pub found: bool, leaf: *mut u8, kidx: u32 }
        pub struct #vcid { pub found: bool, leaf: *mut u8, vidx: u32 }
        impl #kcid {
            pub fn valid(self: &#kcid) -> bool { return self.found; }
            pub fn key(self: &#kcid) -> u64 {
                assert(self.found, "key cursor: key() past the end");
                return btfl_leaf_key_at::<#nd>(self.leaf, self.kidx);
            }
            /// The size of this key's value run.
            pub fn val_count(self: &#kcid) -> u64 {
                assert(self.found, "key cursor: val_count() past the end");
                return btfl_entry_stream_count::<2, #nd>(self.leaf, self.kidx, 1u32);
            }
            /// The RELATIVE seek: cursor at the m-th value of THIS key.
            pub fn seek(self: &#kcid, m: u64) -> #vcid {
                assert(self.found, "key cursor: seek() past the end");
                let c: BtflValCur = btfl_entry_seek::<2, #nd>(self.leaf, self.kidx, 1u32, m);
                return #vcid { found: c.found, leaf: c.leaf, vidx: c.vidx };
            }
        }
        impl #vcid {
            pub fn valid(self: &#vcid) -> bool { return self.found; }
            pub fn value(self: &#vcid) -> u64 {
                assert(self.found, "value cursor: value() past the end");
                return btfl_leaf_stream_at::<2, #nd>(self.leaf, 1u32, self.vidx);
            }
        }
        impl #nm {
            /// Cursor at the `n`-th KEY in symbol order (0-based; the
            /// classic entry-number seek, BTFL's hierarchical reading).
            pub fn seek(self: &#nm, n: u64) -> #kcid {
                let t: Btfl<2, #nd> = self.tree();
                let c: BtflEntryCur = btfl_seek_nth::<2, #nd>(self.ms(), &t, n);
                return #kcid { found: c.found, leaf: c.leaf, kidx: c.kidx };
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&sq); }
}

// ── the generated VECTOR family — thin glue over logos.mem.bt.btvec ─────────
//
// Vector<V> is the pure stream-size container (Memoria bt_ss's dynamic
// vector): branch nodes carry ONLY per-child subtree entry counts, every
// operation is positional. The family is the same thin-delegation shape as
// the multimap's: handle {snap, ctr_id, sizing} over the directory, methods
// forwarding into the btvec prototype, the cursor pair for seek. v0 columns
// are u64 (validated at the factory gate); the typed cast boundary arrives
// with 8c alongside the other families'.
// `vty` is the DECLARED value type. The storage cell stays an unordered FSE64
// column — btvec's own format — and the family's surface is typed by the
// declaration, bridging through the cell's low bytes (`as u64` / `as #(vt)`).
// So a `container … { kind vector; entry { elem: i64 } }` gets an i64 surface
// without btvec knowing anything about it: the family is generated per CONFIG,
// and the config carries the type, so nothing here is generic.
fn emit_btvec_family(name: str, vty: str, mexpr: ExprBlob) {
    let nm: Ident = Ident::new(name);
    let vt: ExprBlob = parse_type(vty);
    let nd: Ident = Ident::new(MEM_STORE_NODE);
    let scfg: StoreCfg = mem_store_cfg(STORE_CFG_DEFAULT);
    let mut lbs_s: String = fmt_display_to_string(&scfg.leaf_bytes());
    lbs_s.push_str("u32");
    let lbs: ExprBlob = parse_expr(lbs_s.as_str());
    let mut bbs_s: String = fmt_display_to_string(&scfg.branch_bytes());
    bbs_s.push_str("u32");
    let bbs: ExprBlob = parse_expr(bbs_s.as_str());
    let mut cn: String = String::new();
    cn.push_str(name);
    cn.push_str("Cur");
    let cid: Ident = Ident::new(cn.as_str());
    let b: QuoteItemBlob = quote_item! {
        use logos.mem.bt.btvec;
        use logos.mem.bt.map;             // Ctr — the dyn boundary trait
        use logos.mem.bt.node;            // the store's node profile (spliced as #nd)
        use logos.mem.bt.memstore;
        use logos.mem.bt.meta;           // the container SCHEMA document plane
        use logos.lang.writ.wstatic;     // WritStatic — the schema document handle
        use logos.mem.sync;               // Arc — the parent hold
        use logos.lang.panic;
        pub struct #nm {
            // the PARENT HOLD (Ctr ──Arc→ Snapshot): the ONE snapshot field.
            snap: Arc<dyn Snapshot>,
            ctr_id: u64,
            leaf_bytes: u32,
            branch_bytes: u32,
        }
        pub struct #cid { pub found: bool, leaf: *mut u8, idx: u32 }
        impl #cid {
            pub fn valid(self: &#cid) -> bool { return self.found; }
            pub fn value(self: &#cid) -> #(vt) {
                let c: BtvecCur = BtvecCur { found: self.found, leaf: self.leaf, idx: self.idx };
                return btvec_cur_value::<#nd>(&c) as #(vt);
            }
        }
        impl #nm {
            // PRIVILEGED tier: recover the concrete MemorySnapshot from the
            // erased `Arc<dyn Snapshot>` hold (this family is generated for
            // MemoryStore, so its snap is always a MemorySnapshot).
            fn ms(self: &#nm) -> &MemorySnapshot {
                return unsafe { &*(dyn_data(&*self.snap) as *const MemorySnapshot) };
            }
            pub static fn create(snap: &Arc<dyn Snapshot>, ctr_id: u64) -> #nm {
                return #nm::create_with(snap, ctr_id, #(lbs), #(bbs));
            }
            pub static fn create_with(snap: &Arc<dyn Snapshot>, ctr_id: u64,
                                      leaf_bytes: u32, branch_bytes: u32) -> #nm {
                let msr: &MemorySnapshot = unsafe { &*(dyn_data(&**snap) as *const MemorySnapshot) };
                let t: Btvec<#nd> = btvec_create::<#nd>(msr, leaf_bytes, branch_bytes);
                {
                    let __mroot: *mut u8 = ctr_publish_meta_static(t.root, #(mexpr));
                    msr.set_root(ctr_id, __mroot, t.level);
                }
                return #nm {
                    snap: snap.clone_ref(),
                    ctr_id: ctr_id,
                    leaf_bytes: leaf_bytes,
                    branch_bytes: branch_bytes,
                };
            }
            pub static fn open(snap: &Arc<dyn Snapshot>, ctr_id: u64) -> #nm {
                return #nm {
                    snap: snap.clone_ref(),
                    ctr_id: ctr_id,
                    leaf_bytes: #(lbs),
                    branch_bytes: #(bbs),
                };
            }
            pub fn tree(self: &#nm) -> Btvec<#nd> {
                unsafe {
                    let e: DirEntry = self.ms().root_of(self.ctr_id);
                    return Btvec::<#nd> {
                        root: e.root,
                        level: e.level,
                        leaf_bytes: self.leaf_bytes,
                        branch_bytes: self.branch_bytes,
                    };
                }
            }
            // The MUTATION view (privatizes the directory path first — see the
            // map/btfl handles); used by every method that repoints the root.
            fn tree_mut(self: &#nm) -> Btvec<#nd> {
                unsafe {
                    let e: DirEntry = self.ms().root_of_mut(self.ctr_id);
                    return Btvec::<#nd> {
                        root: e.root,
                        level: e.level,
                        leaf_bytes: self.leaf_bytes,
                        branch_bytes: self.branch_bytes,
                    };
                }
            }
            /// Re-creates the (EMPTY — asserted) container with new node
            /// sizing; splits then allocate siblings of the new size.
            pub fn reformat(self: &mut #nm, leaf_bytes: u32, branch_bytes: u32) {
                let t: Btvec<#nd> = self.tree_mut();
                assert(btvec_size::<#nd>(&t) == 0u64, "reformat: container not empty");
                btvec_drop::<#nd>(&t);
                unsafe {
                    let t2: Btvec<#nd> = btvec_create::<#nd>(self.ms(), leaf_bytes, branch_bytes);
                    {
                        let __mroot: *mut u8 = ctr_publish_meta_static(t2.root, #(mexpr));
                        self.ms().set_root(self.ctr_id, __mroot, t2.level);
                    }
                }
                self.leaf_bytes = leaf_bytes;
                self.branch_bytes = branch_bytes;
            }
            pub fn append(self: &#nm, v: #(vt)) {
                unsafe {
                    let mut t: Btvec<#nd> = self.tree_mut();
                    btvec_append::<#nd>(self.ms(), &mut t, v as u64);
                    {
                        let __mroot: *mut u8 = ctr_publish_meta_static(t.root, #(mexpr));
                        self.ms().set_root(self.ctr_id, __mroot, t.level);
                    }
                }
            }
            /// The batch surface (PAIR 2026-07-24): the CONTAINER hands out
            /// the staging buffer — already the leaf's physical column
            /// format, growable, RAII-owned. Fill with push, then splice
            /// with `insert(pos, &buf)`; the buffer survives the insert and
            /// may be reused or refilled.
            pub fn make_buffer(self: &#nm) -> BtvecBuf {
                return btvec_buf_new(1024u64);
            }
            /// Batch insert: splice the buffer's rows at `pos` (0-based;
            /// `pos == size()` appends). Fragmentation is chosen by the
            /// weight calculus at the 90% fill target — no trial insertion,
            /// no block restores.
            pub fn insert(self: &#nm, pos: u64, buf: &BtvecBuf) {
                unsafe {
                    let mut t: Btvec<#nd> = self.tree_mut();
                    btvec_insert_buf::<#nd>(self.ms(), &mut t, pos, buf);
                    {
                        let __mroot: *mut u8 = ctr_publish_meta_static(t.root, #(mexpr));
                        self.ms().set_root(self.ctr_id, __mroot, t.level);
                    }
                }
            }
            pub fn insert_at(self: &#nm, pos: u64, v: #(vt)) {
                unsafe {
                    let mut t: Btvec<#nd> = self.tree_mut();
                    btvec_insert_at::<#nd>(self.ms(), &mut t, pos, v as u64);
                    {
                        let __mroot: *mut u8 = ctr_publish_meta_static(t.root, #(mexpr));
                        self.ms().set_root(self.ctr_id, __mroot, t.level);
                    }
                }
            }
            /// Remove the entry at `pos` (traps past the end). The touched
            /// node merges with a neighbor under exact weight admission;
            /// the root collapses while it is a one-child branch.
            pub fn remove_at(self: &#nm, pos: u64) {
                unsafe {
                    let mut t: Btvec<#nd> = self.tree_mut();
                    btvec_remove_at::<#nd>(self.ms(), &mut t, pos);
                    {
                        let __mroot: *mut u8 = ctr_publish_meta_static(t.root, #(mexpr));
                        self.ms().set_root(self.ctr_id, __mroot, t.level);
                    }
                }
            }
            pub fn get(self: &#nm, pos: u64) -> #(vt) {
                let t: Btvec<#nd> = self.tree();
                return btvec_get::<#nd>(self.ms(), &t, pos) as #(vt);
            }
            pub fn set(self: &#nm, pos: u64, v: #(vt)) {
                let t: Btvec<#nd> = self.tree();
                btvec_set::<#nd>(self.ms(), &t, pos, v as u64);
            }
            /// Cursor at the `pos`-th entry (0-based; the entry-number seek).
            pub fn seek(self: &#nm, pos: u64) -> #cid {
                let t: Btvec<#nd> = self.tree();
                let c: BtvecCur = btvec_seek::<#nd>(self.ms(), &t, pos);
                return #cid { found: c.found, leaf: c.leaf, idx: c.idx };
            }
            pub fn size(self: &#nm) -> u64 {
                let t: Btvec<#nd> = self.tree();
                return btvec_size::<#nd>(&t);
            }
            pub fn check(self: &#nm) -> bool {
                let t: Btvec<#nd> = self.tree();
                return btvec_check::<#nd>(self.ms(), &t);
            }
            pub fn level(self: &#nm) -> u32 {
                return self.tree().level;
            }
        }
        impl Ctr for #nm {
            fn size(self: &#nm) -> u64 {
                let t: Btvec<#nd> = self.tree();
                return btvec_size::<#nd>(&t);
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&b); }

    // ── the Deem projection: the vector AS A RELATION ───────────────────────
    // `rel row(pos, val)` — one row per element in position order, walked
    // through the same positional cursor `seek` exposes, so the projection
    // rides the family's public read surface and holds no layout knowledge.
    // Without this a generated vector family could be READ but not QUERIED,
    // and a query would have to go back through a hand-written backing type.
    {
        let mut vrows_s: String = String::new();
        vrows_s.push_str("__ctr_rows_");
        vrows_s.push_str(name);
        let vrowsfn: Ident = Ident::new(vrows_s.as_str());
        let pq: QuoteItemBlob = quote_item! {
            use logos.mem.bt.map;             // trait PositionalSource — the hub rel
            use logos.mem.collections.vec;
            pub fn #vrowsfn(c: &#nm) -> Vec<(i64, i64)> {
                let mut out: Vec<(i64, i64)> = vec_new::<(i64, i64)>();
                let n: u64 = c.size();
                let mut i: u64 = 0u64;
                while i < n {
                    let cu: #cid = c.seek(i);
                    if cu.valid() {
                        out.push(((i as i64), (cu.value() as i64)));
                    }
                    i = i + 1u64;
                }
                return out;
            }
            impl PositionalSource for #nm { rel row = #vrowsfn; }
        };
        unsafe { logos_emit_item_blob_subst(&pq); }
    }
}

// ── ADR 0021 §3 Phase 3: the metaclass FACTORY — the real container family ──
//
// The driver drains mono's `CtrClass<CFG>` demands by rendering one
//
//   package logos.gen;
//   use logos.lcm.canon.container_item;
//   use logos.mem.bt.map;
//   metacall __container_factory("<016x cfg-hash>", "<CFG doc source>");
//
// chunk per demand (main.cpp factory drain loop) and re-entering metaprog
// dispatch, which JIT-invokes this fn through the ordinary metacall-item
// thunk. The factory parses the CFG document SOURCE — exactly the doc
// emit_cfg_doc above produces, as re-rendered by sema's wstatic_sources
// capture (`@{"kind": "ordered_map", "key": <type:K>, "value": <type:V>}`,
// a `"str"` VLE tag in the value slot for an unsized value) — reconstructs
// the synthetic (name, spec) pair for the family, and routes it through the
// SAME container_item_run machinery as a source-level declaration (facts →
// Canon verdicts → ordered_map family emission), minus the CFG-doc
// re-emission (the input IS the CFG doc). Family name = `Hs<hex>` (the
// identifier-safe @hs spelling) → members Hs<hex>Leaf / Hs<hex>Branch /
// Hs<hex>Tree and the CoW handle Hs<hex>, all in `package logos.gen` (the
// chunk's unit — the hash-keyed family is package-agnostic by design).
//
// Satisfaction signal: the factory also emits
//
//   impl CtrFamily for CtrClass<CFG-literal> { fn family_id() -> u64 }
//
// splicing cfg_src verbatim as the const type-arg — re-parsing yields the
// same content hash, hence the very CtrClass instance mono demanded.
// The drain loop's re-fire semantics stay quiet-break for now; the impl
// becomes the hard satisfaction gate when create_ctr goes live (Phase 4).
// Emission of the impl is text via the emit-source seam (a WritStatic
// literal in type-arg position has no quote_item! coverage yet) — rides the
// same quote-coverage debt tracked for the wave-0 handler.

// Naive substring search — the CFG doc is one short line, no need for BMH.
fn cf_find_sub(s: str, from: i64, pat: str) -> i64 {
    let n: i64 = s.len();
    let m: i64 = pat.len();
    let mut i: i64 = from;
    while i + m <= n {
        let mut j: i64 = 0i64;
        while j < m && str_byte_at(s, i + j) == str_byte_at(pat, j) {
            j = j + 1i64;
        }
        if j == m {
            return i;
        }
        i = i + 1i64;
    }
    return -1i64;
}

fn cf_skip_ws(s: str, from: i64) -> i64 {
    let n: i64 = s.len();
    let mut i: i64 = from;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        if c != 32u8 && c != 9u8 && c != 10u8 && c != 13u8 {
            return i;
        }
        i = i + 1i64;
    }
    return n;
}

// Position of the VALUE for `"<key>":` in the CFG doc source at/after
// `from`, or -1. `key` arrives QUOTED (`"kind"`) so a slot name can never
// match inside a type.
fn cfg_value_pos_from(src: str, from: i64, key: str) -> i64 {
    let k: i64 = cf_find_sub(src, from, key);
    if k < 0i64 {
        return -1i64;
    }
    let i: i64 = cf_skip_ws(src, k + key.len());
    if i >= src.len() || str_byte_at(src, i) != 58u8 {
        return -1i64;
    } // ':'
    return cf_skip_ws(src, i + 1i64);
}

fn cfg_value_pos(src: str, key: str) -> i64 {
    return cfg_value_pos_from(src, 0i64, key);
}

// The quoted string starting at `at` (must be '"'); "" = shape violation
// (an empty slot value never occurs in a well-formed CFG doc).
fn cfg_read_quoted(src: str, at: i64) -> str {
    if at < 0i64 || at >= src.len() || str_byte_at(src, at) != 34u8 {
        return "";
    }
    let e: i64 = cf_find(src, at + 1i64, 34u8);
    if e < 0i64 {
        return "";
    }
    return unsafe { cf_sub(src, at + 1i64, e) };
}

// The `<type:T>` slot starting at `at`; returns T ("" = not a type slot).
// Depth-aware `>` matching so a generic T (`Vec<u8>`) reads whole.
fn cfg_read_type_slot(src: str, at: i64) -> str {
    if at < 0i64 || at + 6i64 > src.len() {
        return "";
    }
    if !str_eq(unsafe {
        cf_sub(src, at, at + 6i64)
    } , "<type:") { return ""; }
    let n: i64 = src.len();
    let mut i: i64 = at + 6i64;
    let mut depth: i64 = 1i64;
    while i < n {
        let c: u8 = str_byte_at(src, i);
        if c == 60u8 {
            depth = depth + 1i64;
        }
        else if c == 62u8 {
            depth = depth - 1i64;
            if depth == 0i64 {
                return unsafe { cf_sub(src, at + 6i64, i) };
            }
        }
        i = i + 1i64;
    }
    return "";
}

pub fn __container_factory(hash_hex: str, cfg_src: str) -> ItemList {
    let out: ItemList = item_list_new();
    if hash_hex.len() == 0i64 {
        error("container factory: empty CFG hash (driver drain regression?)");
        return out;
    }
    if cfg_src.len() == 0i64 {
        error("container factory: empty CFG document source (wstatic_sources gap?)");
        return out;
    }

    // ── parse the CFG doc (the co-located emit_cfg_doc format, hand-parsed) ──
    let kind: str = cfg_read_quoted(cfg_src, cfg_value_pos(cfg_src, "\"kind\""));
    if kind.len() == 0i64 {
        error("container factory: CFG document has no readable kind (emit_cfg_doc format skew?)");
        return out;
    }
    if !str_eq(kind, KIND_ORDERED_MAP) && !str_eq(kind, KIND_MULTIMAP)
       && !str_eq(kind, KIND_VECTOR) {
        error("container factory: unsupported container kind — the factory generates `ordered_map`, `multimap` and `vector` families");
        return out;
    }

    // ── synthetic (name, spec) → the shared declaration machinery ──────────
    let mut fam: String = String::new();
    fam.push_str("Hs");
    fam.push_str(hash_hex);
    let mut sp: String = String::new();
    if str_eq(kind, KIND_ORDERED_MAP) {
        let kty: str = cfg_read_type_slot(cfg_src, cfg_value_pos(cfg_src, "\"key\""));
        if kty.len() == 0i64 {
            error("container factory: CFG document has no readable `key` type slot (emit_cfg_doc format skew?)");
            return out;
        }
        let vp: i64 = cfg_value_pos(cfg_src, "\"value\"");
        let mut vty: str = cfg_read_type_slot(cfg_src, vp);
        if vty.len() == 0i64 {
            // Not a type slot — must be the `"str"` VLE tag (str is unsized).
            vty = cfg_read_quoted(cfg_src, vp);
            if !str_eq(vty, "str") {
                error("container factory: CFG `value` slot is neither <type:V> nor the \"str\" VLE tag (emit_cfg_doc format skew?)");
                return out;
            }
        }
        sp.push_str("pub=1|generics=|gnames=|backing=u8|backing_pkg=|kind=ordered_map|entry=key:");
        sp.push_str(kty);
        sp.push_str(":0,val:");
        sp.push_str(vty);
        sp.push_str(":0|measures=max(key)|pkg=logos.gen");
    } else if str_eq(kind, KIND_VECTOR) {
        // The positional container: one value column, no key, no measures —
        // the branch information is the subtree entry count alone (btvec).
        let vty: str = cfg_read_type_slot(cfg_src, cfg_value_pos(cfg_src, "\"value\""));
        if vty.len() == 0i64 {
            error("container factory: vector CFG document has no readable `value` type slot (emit_cfg_doc format skew?)");
            return out;
        }
        sp.push_str("pub=1|generics=|gnames=|backing=u8|backing_pkg=|kind=vector|entry=val:");
        sp.push_str(vty);
        sp.push_str(":0|pkg=logos.gen");
    } else {
        // BTFL 8b multimap: streams/measures/ops ride the doc as the SAME
        // compact strings the spec carries — read back verbatim; cols
        // (stream, name, <type:T>) re-parse by forward scan (they sit LAST
        // in the doc by construction, emit_cfg_doc_multimap).
        let streams: str = cfg_read_quoted(cfg_src, cfg_value_pos(cfg_src, "\"streams\""));
        if streams.len() == 0i64 {
            error("container factory: multimap CFG document has no readable streams list (emit_cfg_doc format skew?)");
            return out;
        }
        let measures: str = cfg_read_quoted(cfg_src, cfg_value_pos(cfg_src, "\"measures\""));
        let mmops: str = cfg_read_quoted(cfg_src, cfg_value_pos(cfg_src, "\"ops\""));
        let cp: i64 = cfg_value_pos(cfg_src, "\"cols\"");
        if cp < 0i64 {
            error("container factory: multimap CFG document has no cols array (emit_cfg_doc format skew?)");
            return out;
        }
        let mut entry_s: String = String::new();
        let mut cur: i64 = cp;
        let mut first: bool = true;
        let mut done: bool = false;
        while !done {
            let spos: i64 = cfg_value_pos_from(cfg_src, cur, "\"stream\"");
            if spos < 0i64 {
                done = true;
            } else {
                let sname: str = cfg_read_quoted(cfg_src, spos);
                let npos: i64 = cfg_value_pos_from(cfg_src, spos, "\"name\"");
                let colnm: str = cfg_read_quoted(cfg_src, npos);
                let tpos: i64 = cfg_value_pos_from(cfg_src, npos, "\"ty\"");
                let tty: str = cfg_read_type_slot(cfg_src, tpos);
                if sname.len() == 0i64 || colnm.len() == 0i64 || tty.len() == 0i64 {
                    error("container factory: malformed multimap cols row (emit_cfg_doc format skew?)");
                    return out;
                }
                if !first {
                    entry_s.push_str(",");
                }
                first = false;
                entry_s.push_str(sname);
                entry_s.push_str(".");
                entry_s.push_str(colnm);
                entry_s.push_str(":");
                entry_s.push_str(tty);
                entry_s.push_str(":0");
                cur = tpos;
            }
        }
        if first {
            error("container factory: multimap CFG document carries no cols rows (emit_cfg_doc format skew?)");
            return out;
        }
        sp.push_str("pub=1|generics=|gnames=|backing=u8|backing_pkg=|kind=multimap|entry=");
        sp.push_str(entry_s.as_str());
        sp.push_str("|measures=");
        sp.push_str(measures);
        sp.push_str("|streams=");
        sp.push_str(streams);
        if mmops.len() > 0i64 {
            sp.push_str("|ops=");
            sp.push_str(mmops);
        }
        sp.push_str("|pkg=logos.gen");
    }
    container_item_run(fam.as_str(), sp.as_str(), false, cfg_src);

    // ── satisfaction marker + Phase 4a surface: the full CtrFamily impl ────
    // type Handle = the family's CoW handle; create/open forward to its
    // inherent statics (the impl target is CtrClass<CFG>, not the
    // handle, so inherent-vs-trait shadowing cannot bite here).
    // The full CtrFamily impl via quote_item! (retires the last text emission on
    // the factory path). The impl target `CtrClass<@{CFG}>` splices cfg_src
    // VERBATIM (parse_wstatic → LIT_WSTATIC): re-parsing the exact doc mono
    // hashed yields the same @hs, i.e. the very CtrClass instance demanded — no
    // reconstruction, no drift. The family handle `#famid` (`Hs<hex>`) is an
    // Ident antiquot at all five sites; the family_id literal `0x<hex>u64` is
    // reified through parse_expr (a metaprog-time integer known only as a hash
    // string). The fragment emits into `logos.gen` (the hash-keyed family is
    // package-agnostic — same as container_item_run's synthetic pkg above).
    let famid: Ident = Ident::new(fam.as_str());
    let cfgty: ExprBlob = parse_wstatic(cfg_src);
    let mut hexlit: String = String::new();
    hexlit.push_str("0x");
    hexlit.push_str(hash_hex);
    hexlit.push_str("u64");
    let idexpr: ExprBlob = parse_expr(hexlit.as_str());
    let b: QuoteItemBlob = quote_item! {
        use logos.lcm.canon.metaclass;
        use logos.mem.bt.memstore;
        use logos.mem.bt.meta;           // the container SCHEMA document plane
        use logos.lang.writ.wstatic;     // WritStatic — the schema document handle
        use logos.mem.bt.map;             // trait Snapshot — the erased public tier
        use logos.mem.sync;
        impl CtrFamily for CtrClass<#(cfgty)> {
            type Handle = #famid;
            fn family_id() -> u64 {
                return #(idexpr);
            }
            fn create(snap: &Arc<dyn Snapshot>, ctr_id: u64) -> #famid {
                return #famid::create(snap, ctr_id);
            }
            fn open(snap: &Arc<dyn Snapshot>, ctr_id: u64) -> #famid {
                return #famid::open(snap, ctr_id);
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&b); }
    return out;
}

/// Lowering handler behind the `container` ITEM (ADR 0020 wave-0). Invoked by
/// the COMPILER (sema lower_container_def) through the token-macro item seam
/// with the serialized spec line. Not a user-facing macro.
#[token_macro]
pub fn __container_item(name: str, spec: str) -> ItemList {
    let out: ItemList = item_list_new();
    if name.len() == 0i64 {
        error("container item: empty container name (compiler seam regression?)");
        return out;
    }
    container_item_run(name, spec, true, "");
    return out;
}

// The shared lowering path behind BOTH entries: the compiler's `container`
// item seam (__container_item, emit_cfg=true) and the mono→factory drain
// (__container_factory, emit_cfg=false — the factory's input IS the CFG doc,
// re-emitting it would be circular). facts → Canon verdicts → capability-
// gated emission; diagnostics ride error() (nothing to thread back).
fn container_item_run(name: str, spec: str, emit_cfg: bool, cfg_src: str) {
    let facts: Writ = container_facts(name, spec);
    // Shape gate on the fact mirror — a malformed spec (or a fact-builder
    // regression) must fail the COMPILE, not silently drop the declaration.
    let root: WAny = facts.root();
    if root.is_null() || !root.is_map() {
        error("container item: malformed spec (compiler seam regression?)");
        return;
    }
    let rm: &WMap<WString, WAny> = root.as_map();
    let ca: WAny = rm.get(SEC_CONTAINERS);
    if !ca.is_array() {
        error("container item: fact doc missing its containers row (seam regression?)");
        return;
    }
    let caa: &WArray<WAny> = ca.as_array();
    if caa.len() != 1i64 {
        error("container item: fact doc missing its containers row (seam regression?)");
        return;
    }
    let row: WAny = caa.get(0i64);
    if !row.is_map() {
        error("container item: fact doc missing the container kind (seam regression?)");
        return;
    }
    let rowm: &WMap<WString, WAny> = row.as_map();
    let kv: WAny = rowm.get(K_KIND);
    if !kv.is_string() {
        error("container item: fact doc missing the container kind (seam regression?)");
        return;
    }

    // ── Canon judges (M3): facts in, verdicts out — the handler never
    // decides. An error row fails the COMPILE with Canon's reason verbatim.
    let verd: Writ = canon_verdicts(&facts);
    let vr: WAny = verd.root();
    if vr.is_null() || !vr.is_map() {
        error("container item: Canon verdict engine failure (logos.lcm.canon.canon)");
        return;
    }
    let vm: &WMap<WString, WAny> = vr.as_map();
    if cv_report_errors(vm, name) > 0i64 {
        return;
    }

    // ── emission (M4): mechanical, capability-gated. Wave-0 emits the scan
    // projection for kind=vector only; ordered_map stops at verdicts (its
    // substrate is a later track).
    let mut cs: ContainerSpec = container_spec_new();
    if !parse_container_spec(spec, &mut cs) {
        // Unreachable — container_facts gated the same parse above.
        error("container item: malformed spec (compiler seam regression?)");
        return;
    }

    // ── the family's SCHEMA document (the Deem-facing low-level schema) ─────
    // A factory-generated family publishes its CFG document into the container's
    // ROOT BLOCK at every root change (`ctr_publish_meta_tiered`), so an opened
    // store answers "what is this container" from the container's own bytes.
    // The decl-path families (raw test containers) have no CFG document and
    // pass the null handle, which publication skips.
    //
    // The document rides as the `@`-literal ITSELF (an ExprBlob spliced at each
    // publication site) rather than as a named const emitted beside the family:
    // a metaprog-emitted `pub const …: WritStatic` read from ANOTHER emitted
    // chunk resolves but loses its declared type (the argument lowers as i32 and
    // only MLIR verification notices), while the same const in an ordinary
    // module is fine. Splicing the literal has no cross-chunk dependency at all.
    let mut mexpr: ExprBlob = parse_expr("writ_static_none()");
    if cfg_src.len() > 0i64 {
        mexpr = parse_wstatic(cfg_src);
    }


    // ADR 0021 Phase 4b: the DECL SITE of an ordered_map lowers to the CFG
    // const + the CtrClass alias ONLY (emit_cfg_doc, below at the kind
    // branch). Skipped on the factory path — there the CFG doc is the INPUT,
    // not a synthesis target, and the factory is the family emitter.

    // kind=node: emit a concrete b+tree leaf, its value-column encoding and
    // split body chosen by Canon's fast|volume verdict — `fast` = all-FSE,
    // count-balanced; `volume` = VLE value column, volume-balanced split.
    if str_eq(cs.kind, KIND_NODE) {
        let policy: str = cv_split_policy(vm, name);
        if policy.len() == 0i64 {
            error("container item: Canon produced no split_policy verdict for a node (Canon seam regression?)");
            return;
        }
        if !str_eq(policy, SPLIT_FAST) && !str_eq(policy, SPLIT_VOLUME) {
            error("container item: Canon produced an unknown split_policy verdict for a node (Canon/handler vocabulary skew?)");
            return;
        }
        let ce2: i64 = cs.entry.len();
        let nb0: i64 = cf_next_comma(cs.entry, 0i64, ce2);
        if nb0 == ce2 {
            error("container item: a `kind node` needs two entry columns (`entry { key: K, val: V }`)");
            return;
        }
        let nb1: i64 = cf_next_comma(cs.entry, nb0 + 1i64, ce2);
        if nb1 != ce2 {
            error("container item: wave-0 `kind node` supports exactly two entry columns (key, val)");
            return;
        }
        let k1: i64 = cf_find(cs.entry, 0i64, 58u8);            // ':' of key col
        let mut k2: i64 = nb0 - 1i64;
        while k2 > 0i64 && str_byte_at(cs.entry, k2) != 58u8 {
            k2 = k2 - 1i64;
        }
        if k1 < 0i64 || k2 <= k1 {
            error("container item: malformed key column (compiler seam regression?)");
            return;
        }
        let kty: str = unsafe { cf_sub(cs.entry, k1 + 1i64, k2) };
        let v1: i64 = cf_find(cs.entry, nb0 + 1i64, 58u8);      // ':' of val col
        let mut v2: i64 = ce2 - 1i64;
        while v2 > nb0 && str_byte_at(cs.entry, v2) != 58u8 {
            v2 = v2 - 1i64;
        }
        if v1 < 0i64 || v2 <= v1 {
            error("container item: malformed val column (compiler seam regression?)");
            return;
        }
        let vty: str = unsafe { cf_sub(cs.entry, v1 + 1i64, v2) };
        // A standalone storage node is PLAIN pkd (no CoW header) — the header is a
        // property of a versioned map's stack, not a bare `kind node`.
        emit_leaf_node(name, kty, vty, policy, false);
        return;
    }
    // kind=branch: emit a concrete b+tree BRANCH (routing node). Always
    // count-balanced (all-FSE), so no split_policy verdict — the single `entry
    // { key: K }` column names the separator type; sz/ptr are u64.
    if str_eq(cs.kind, KIND_BRANCH) {
        let ceb: i64 = cs.entry.len();
        let bb0: i64 = cf_next_comma(cs.entry, 0i64, ceb);
        if bb0 != ceb {
            error("container item: a `kind branch` needs exactly one entry column (`entry { key: K }`)");
            return;
        }
        let bk1: i64 = cf_find(cs.entry, 0i64, 58u8);          // ':' of key col
        let mut bk2: i64 = ceb - 1i64;
        while bk2 > 0i64 && str_byte_at(cs.entry, bk2) != 58u8 {
            bk2 = bk2 - 1i64;
        }
        if bk1 < 0i64 || bk2 <= bk1 {
            error("container item: malformed key column (compiler seam regression?)");
            return;
        }
        let bkty: str = unsafe { cf_sub(cs.entry, bk1 + 1i64, bk2) };
        emit_branch_node(name, bkty, false);   // standalone branch = plain pkd
        return;
    }
    // kind=multimap (BTFL 8b): the DECL path stops at the multistream CFG
    // const (facts + Canon template validation already ran above — a bad ops
    // vocabulary/reference fails HERE, loudly, with Canon's reason). The
    // FACTORY path (emit_cfg=false, mono demanded CtrClass<CFG>) generates
    // the btfl family after the demand-time Canon verdicts (vm) re-judged
    // the concrete cfg — the two Canon moments.
    if str_eq(cs.kind, KIND_MULTIMAP) {
        if emit_cfg {
            let _ok: bool = emit_cfg_doc_multimap(name, &cs, vm);
            return;
        }
        emit_btfl_family(name, &cs, vm, mexpr);
        return;
    }
    // kind=ordered_map: realize Canon's container_shape PLAN. Structure is the
    // verdict — the handler only reproduces the node types the plan names,
    // walking its rows (never hardcoding leaf+branch). The tree-assembly and
    // CoW-map aspects are read here but realized in later increments (I2/I3).
    if str_eq(cs.kind, KIND_ORDERED_MAP) {
        // ADR 0021 Phase 4b: the DECL path stops at CFG + alias — the family
        // (nodes, trait impls, tree, CoW handle) is generated ONLY by the
        // factory when mono demands the CtrClass<CFG> instance
        // (create_ctr::<Name>). Facts + Canon template-validation above stay
        // (the descriptive facet — a bad decl still fails HERE, loudly).
        if emit_cfg {
            let _ok: bool = emit_cfg_doc(name, &cs);
            return;
        }
        // Two entry columns (key, val) — same shape as a kind=node leaf.
        let ce2: i64 = cs.entry.len();
        let nb0: i64 = cf_next_comma(cs.entry, 0i64, ce2);
        if nb0 == ce2 {
            error("container item: a `kind ordered_map` needs two entry columns (`entry { key: K, val: V }`)");
            return;
        }
        let nb1: i64 = cf_next_comma(cs.entry, nb0 + 1i64, ce2);
        if nb1 != ce2 {
            error("container item: wave-0 `kind ordered_map` supports exactly two entry columns (key, val)");
            return;
        }
        let k1: i64 = cf_find(cs.entry, 0i64, 58u8);
        let mut k2: i64 = nb0 - 1i64;
        while k2 > 0i64 && str_byte_at(cs.entry, k2) != 58u8 {
            k2 = k2 - 1i64;
        }
        if k1 < 0i64 || k2 <= k1 {
            error("container item: malformed key column (compiler seam regression?)");
            return;
        }
        let kty: str = unsafe { cf_sub(cs.entry, k1 + 1i64, k2) };
        let v1: i64 = cf_find(cs.entry, nb0 + 1i64, 58u8);
        let mut v2: i64 = ce2 - 1i64;
        while v2 > nb0 && str_byte_at(cs.entry, v2) != 58u8 {
            v2 = v2 - 1i64;
        }
        if v1 < 0i64 || v2 <= v1 {
            error("container item: malformed val column (compiler seam regression?)");
            return;
        }
        let vty: str = unsafe { cf_sub(cs.entry, v1 + 1i64, v2) };

        // Walk the plan rows to COLLECT the aspects, then realize them — the node
        // FLAVOR (plain vs CoW-header) depends on the leaf policy AND the
        // versioning aspect, so structure is emitted post-walk (order-independent).
        let sv: WAny = vm.get(V_SHAPE);
        if !sv.is_array() {
            error("container item: Canon produced no container_shape plan for an ordered_map (Canon seam regression?)");
            return;
        }
        let sa: &WArray<WAny> = sv.as_array();
        let mut saw_leaf: bool = false;
        let mut saw_branch: bool = false;
        let mut saw_tree: bool = false;
        let mut saw_cow: bool = false;
        let mut leaf_fast: bool = false;
        let mut si: i64 = 0i64;
        while si < sa.len() {
            let e: WAny = sa.get(si);
            if e.is_map() {
                let em: &WMap<WString, WAny> = e.as_map();
                let cc: WAny = em.get(K_CTR);
                let asp: WAny = em.get(K_ASPECT);
                if cc.is_string() && asp.is_string() && str_eq(cc.as_wstr(), name) {
                    if str_eq(asp.as_wstr(), ASPECT_NODE) {
                        let role: WAny = em.get(K_ROLE);
                        if role.is_string() && str_eq(role.as_wstr(), ROLE_LEAF) {
                            let pol: WAny = em.get(K_POLICY);
                            let ps: str = if pol.is_string() { pol.as_wstr() } else { SPLIT_FAST };
                            leaf_fast = str_eq(ps, SPLIT_FAST);
                            saw_leaf = true;
                        } else if role.is_string() && str_eq(role.as_wstr(), ROLE_BRANCH) {
                            saw_branch = true;
                        }
                    } else if str_eq(asp.as_wstr(), ASPECT_ASSEMBLY) {
                        let val: WAny = em.get(K_VALUE);
                        if val.is_string() && str_eq(val.as_wstr(), ASM_TREE) {
                            saw_tree = true;
                        }
                    } else if str_eq(asp.as_wstr(), ASPECT_VERSION) {
                        let val: WAny = em.get(K_VALUE);
                        if val.is_string() && str_eq(val.as_wstr(), VER_COW) {
                            saw_cow = true;
                        }
                    }
                }
            }
            si = si + 1i64;
        }
        if !saw_leaf || !saw_branch {
            error("container item: incomplete container_shape plan (leaf or branch node missing — Canon seam regression?)");
            return;
        }
        // Node flavor is a verdict: versioning=cow ⇒ the nodes carry the CoW node
        // header (snapshot_id + rc, new_in/cow_clone). The FULL tree + CoW-map
        // stack is realized for BOTH leaf policies: a fast (FSE) leaf returns the
        // value by value; a volume (VLE) leaf returns it BY VIEW (&[u8]). The
        // `vol` flavor threads that value-return difference through emit_tree /
        // emit_cow_map (the branch routes by key only — value-agnostic).
        let vol: bool = !leaf_fast;
        let node_cow: bool = saw_cow;
        let leaf_policy: str = if leaf_fast { SPLIT_FAST } else { SPLIT_VOLUME };
        let mut ln: String = String::new(); ln.push_str(name); ln.push_str("Leaf");
        let mut bn: String = String::new(); bn.push_str(name); bn.push_str("Branch");
        emit_leaf_node(ln.as_str(), kty, vty, leaf_policy, node_cow);
        emit_branch_node(bn.as_str(), kty, node_cow);
        // ADR 0021 ops-reshape: join the generic ops library — the BtLeaf/
        // BtBranch impls the shared bt_* fns instantiate over. The ordered_map
        // plan always carries versioning=cow (canon container_shape), so the
        // nodes are CoW-flavored and expose the full trait surface
        // (new_in/cow_clone); a plain-flavor node would fail here LOUDLY.
        emit_bt_leaf_impl(ln.as_str(), kty, vty, vol);
        emit_bt_branch_impl(bn.as_str(), kty);
        // assembly=tree → the multi-level b+tree over {N}Leaf / {N}Branch.
        if saw_tree {
            let mut tt: String = String::new(); tt.push_str(name); tt.push_str("Tree");
            emit_tree(tt.as_str(), ln.as_str(), bn.as_str(), kty, vty, vol);
        }
        // versioning=cow → the CoW snapshot-versioned map ({N}Store/{N}Snapshot/
        // {N}) over the same CoW-flavored nodes. Closes ②: one decl → whole stack.
        if saw_cow {
            emit_cow_map(name, ln.as_str(), bn.as_str(), kty, vty, vol, mexpr);
        }
        return;
    }
    if !str_eq(cs.kind, KIND_VECTOR) {
        return;
    }
    // FACTORY path (mono demanded CtrClass<CFG>): the b+tree-backed
    // POSITIONAL family — thin glue over logos.mem.bt.btvec. The DECL path
    // below keeps the wave-0 Deem scan projection (a different plane: source
    // rel over a declared backing, not a store-backed container).
    if !emit_cfg {
        // The declared value type — one entry column, `name:ty:prm`.
        let ve: i64 = cs.entry.len();
        let vb: i64 = cf_next_comma(cs.entry, 0i64, ve);
        let vc1: i64 = cf_find(cs.entry, 0i64, 58u8);
        let mut vc2: i64 = vb - 1i64;
        while vc2 > 0i64 && str_byte_at(cs.entry, vc2) != 58u8 { vc2 = vc2 - 1i64; }
        if vc1 < 0i64 || vc2 <= vc1 {
            error("container factory: malformed vector entry column (spec skew?)");
            return;
        }
        emit_btvec_family(name, unsafe { cf_sub(cs.entry, vc1 + 1i64, vc2) }, mexpr);
        return;
    }
    // The config document — what a `create_ctr::<typeof(V::<…>)>` demand
    // names, and therefore the only way to ASK for a generated family.
    let _okv: bool = emit_cfg_doc(name, &cs);
    // A declaration with NO backing type — `for u8`, the placeholder every
    // store-backed container carries — has nothing to project a source rel
    // over: its family, and with it the projection, come from the factory.
    // The declaration's only business is the config document.
    if str_eq(cs.backing, "u8") {
        return;
    }
    if !cv_has_cap(vm, name, "can_scan") {
        error("container item: Canon granted no can_scan capability for a vector container (Canon seam regression?)");
        return;
    }
    // Canon has already judged wave-0 emission limits (multi-entry vector,
    // unprojectable by_view column) as error rows above — a vector reaching
    // this point has exactly one entry column with a col_proj verdict.
    // Anything else here is a seam regression, not a user error.
    let ce: i64 = cs.entry.len();
    let b0: i64 = cf_next_comma(cs.entry, 0i64, ce);
    if b0 != ce {
        error("container item: multi-entry vector past Canon's verdict (seam regression?)");
        return;
    }
    let c1: i64 = cf_find(cs.entry, 0i64, 58u8);    // ':'
    let mut c2: i64 = b0 - 1i64;
    while c2 > 0i64 && str_byte_at(cs.entry, c2) != 58u8 {
        c2 = c2 - 1i64;
    }
    if c1 < 0i64 || c2 <= c1 {
        error("container item: malformed entry column (compiler seam regression?)");
        return;
    }
    let col_name: str = unsafe { cf_sub(cs.entry, 0i64, c1) };
    let col_ty: str = unsafe { cf_sub(cs.entry, c1 + 1i64, c2) };
    let col_prm: bool = str_eq(unsafe { cf_sub(cs.entry, c2 + 1i64, b0) }, "1");

    // Column projection = Canon's col_proj verdict, consumed verbatim — the
    // handler holds NO type vocabulary of its own (ADR 0020 §5; the verdict
    // rows are the single source of relty/proj truth).
    let pj: i64 = cv_col_proj(vm, name, col_name);
    if pj == 0i64 {
        error("container item: no col_proj verdict for the entry column (Canon seam regression?)");
        return;
    }
    let direct: bool = pj == 1i64;
    let relty: str = cv_col_relty(vm, name, col_name);
    if relty.len() == 0i64 {
        error("container item: col_proj verdict missing relty (Canon seam regression?)");
        return;
    }
    let bound_param: str = if !direct && col_prm { col_ty } else { "" };
    emit_vector_scan(&cs, name, col_name, col_ty, relty, direct, bound_param);
    return;
}
