// logos.lcm.canon.container_item — the `container` ITEM lowering backend
// (ADR 0020 wave-0, Memoria container-interface plane).
//
// A CONTAINER declaration names a relational interface over a backing type:
//
//   pub container Vector<T> for VecCtr<T> { kind vector; entry { elem: T } measure count; }
//
// The responsibility chain is rigid (ADR 0020 §5): the COMPILER records the
// declaration and serializes it to a one-line spec string; THIS handler
// mirrors the spec to the FACT Writ doc; CANON (deem rules over the fact doc)
// returns verdicts; the handler consumes verdicts and emits (or diagnoses).
// Canon never emits; this handler never decides.
//
// Wave-0 M2 scope: spec → fact doc + shape sanity. Canon verdicts (M3) and
// the Vector scan-projection emission (M4) attach behind the fact mirror.
//
// The spec string (compiler → handler; sema lower_container_def): one line,
// `|`-separated `k=v` in fixed key order, values never containing `|`:
//
//   pub=1|generics=<T>|gnames=T|backing=VecCtr<T>|backing_pkg=|kind=vector|entry=elem:T:1|measures=count
//
// entry cols = comma-separated `name:ty:is_param(0|1)`; measures =
// comma-separated `mfn` or `mfn(arg)`.
package logos.lcm.canon.container_item;

use logos.std.compiler.metaprog;   // ItemList, item_list_new, error, Emitter
use logos.lcm.canon.canon;         // canon_verdicts — the JUDGE (ADR 0020 §5)
use logos.lang.writ.container;     // Writ, writ_new
use logos.lang.writ.wmap;          // doc.map / WMap::set
use logos.lang.writ.array;         // doc.array / WArray::push
use logos.lang.writ.anyval;        // WAny
use logos.lang.writ.wstring;       // WString (read-back checks)
use logos.lang.str;                // str_byte_at, str_eq, str_from_raw
use logos.mem.string;              // String (diagnostic composition)
use logos.lcm.canon.vocab;        // shared fact/verdict vocabulary (no bare strings across the Canon seam)

unsafe fn cf_sub(s: str, a: i64, b: i64) -> str {
    let l: i64 = if b > a { b - a } else { 0i64 };
    return str_from_raw((s.as_ptr() as i64 + a) as *const u8, l);
}

fn cf_find(s: str, from: i64, c: u8) -> i64 {
    let n: i64 = s.len();
    let mut i: i64 = from;
    while i < n {
        if str_byte_at(s, i) == c { return i; }
        i = i + 1i64;
    }
    return -1i64;
}

// Index of the next TOP-LEVEL `,` in s[from, end) — commas nested in
// `<…>` / `(…)` / `[…]` (generic args in a column type) don't split.
fn cf_next_comma(s: str, from: i64, end: i64) -> i64 {
    let mut i: i64 = from;
    let mut depth: i64 = 0i64;
    while i < end {
        let c: u8 = str_byte_at(s, i);
        if c == 60u8 || c == 40u8 || c == 91u8 { depth = depth + 1i64; }
        else if c == 62u8 || c == 41u8 || c == 93u8 { depth = depth - 1i64; }
        else if c == 44u8 && depth == 0i64 { return i; }
        i = i + 1i64;
    }
    return end;
}

/// One parsed container spec — string fields borrow the spec line.
pub struct ContainerSpec {
    pub is_pub:      bool,
    pub generics:    str,   // "<T>" verbatim (bounds included), "" = concrete
    pub gnames:      str,   // "T" / "K,V"
    pub backing:     str,   // "VecCtr<T>" (syntactic)
    pub backing_pkg: str,   // defining package of the backing base type, or ""
    pub kind:        str,   // "vector" | "ordered_map"
    pub entry:       str,   // raw "name:ty:p,…" (iterated by the fact builder)
    pub measures:    str,   // raw "count,max(key)"
}

pub fn container_spec_new() -> ContainerSpec {
    return ContainerSpec {
        is_pub: false, generics: "", gnames: "", backing: "",
        backing_pkg: "", kind: "", entry: "", measures: "",
    };
}

/// Parses the compiler's spec line. Returns false on any shape violation
/// (unknown key, missing segment, empty kind/entry) — the caller diagnoses.
pub fn parse_container_spec(spec: str, out: &mut ContainerSpec) -> bool {
    let n: i64 = spec.len();
    let mut pos: i64 = 0i64;
    let mut seen: i64 = 0i64;
    while pos < n {
        let mut end: i64 = cf_find(spec, pos, 124u8);   // '|'
        if end < 0i64 { end = n; }
        let eq: i64 = cf_find(spec, pos, 61u8);          // '='
        if eq < 0i64 || eq >= end { return false; }
        let key: str = unsafe { cf_sub(spec, pos, eq) };
        let val: str = unsafe { cf_sub(spec, eq + 1i64, end) };
        if str_eq(key, "pub")              { out.is_pub = str_eq(val, "1"); }
        else if str_eq(key, "generics")    { out.generics = val; }
        else if str_eq(key, "gnames")      { out.gnames = val; }
        else if str_eq(key, "backing")     { out.backing = val; }
        else if str_eq(key, "backing_pkg") { out.backing_pkg = val; }
        else if str_eq(key, "kind")        { out.kind = val; }
        else if str_eq(key, "entry")       { out.entry = val; }
        else if str_eq(key, "measures")    { out.measures = val; }
        else { return false; }
        seen = seen + 1i64;
        pos = end + 1i64;
    }
    return seen == 8i64 && out.kind.len() > 0i64 && out.entry.len() > 0i64;
}

/// Builds the FACT Writ doc for ONE container item (wave-0 has no cross-item
/// accumulation) — the ADR 0020 §5 fact vocabulary restricted to wave-0:
///
///   { containers: [ { name, pub, generics, backing, kind } ],
///     cols:       [ { ctr, idx, name, ty, param } … ],
///     measures:   [ { ctr, mfn, arg } … ] }
///
/// Convenience shape for the deem-over-&Writ graph source: top-level WMap,
/// arrays of FLAT maps, scalar leaves only. A malformed spec yields a doc
/// with a NULL root — the caller diagnoses.
pub fn container_facts(name: str, spec: str) -> Writ {
    let doc: Writ = writ_new(65536i64);
    let mut cs: ContainerSpec = container_spec_new();
    if !parse_container_spec(spec, &mut cs) { return doc; }

    let root: &mut WMap<WString, WAny> = doc.map(8i64);

    let ctrs: &mut WArray<WAny> = doc.array(1i64);
    {
        let c0: &mut WMap<WString, WAny> = doc.map(8i64);
        c0.set(K_NAME, name);
        c0.set("pub", cs.is_pub);
        c0.set("generics", cs.gnames);
        c0.set("backing", cs.backing);
        c0.set(K_KIND, cs.kind);
        ctrs.push(WAny::from(&*c0));
    }
    root.set(SEC_CONTAINERS, &*ctrs);

    let cols: &mut WArray<WAny> = doc.array(4i64);
    {
        let ce: i64 = cs.entry.len();
        let mut a: i64 = 0i64;
        let mut idx: i64 = 0i64;
        while a < ce {
            let b: i64 = cf_next_comma(cs.entry, a, ce);
            // `name:ty:p` — name up to the FIRST ':', flag after the LAST
            // (the type may itself contain `:` never, but generic commas do
            // occur — hence the depth-aware outer split).
            let c1: i64 = cf_find(cs.entry, a, 58u8);        // ':'
            let mut c2: i64 = b - 1i64;
            while c2 > a && str_byte_at(cs.entry, c2) != 58u8 { c2 = c2 - 1i64; }
            if c1 < 0i64 || c1 >= b || c2 <= c1 { return writ_new(64i64); }
            let r: &mut WMap<WString, WAny> = doc.map(8i64);
            r.set(K_CTR, name);
            r.set(K_IDX, idx);
            r.set(K_NAME, unsafe { cf_sub(cs.entry, a, c1) });
            r.set(K_TY, unsafe { cf_sub(cs.entry, c1 + 1i64, c2) });
            r.set(K_PARAM, str_eq(unsafe { cf_sub(cs.entry, c2 + 1i64, b) }, "1"));
            cols.push(WAny::from(&*r));
            idx = idx + 1i64;
            a = b + 1i64;
        }
    }
    root.set(SEC_COLS, &*cols);

    let meas: &mut WArray<WAny> = doc.array(4i64);
    {
        let cm: i64 = cs.measures.len();
        let mut a: i64 = 0i64;
        while a < cm {
            let b: i64 = cf_next_comma(cs.measures, a, cm);
            let lp: i64 = cf_find(cs.measures, a, 40u8);     // '('
            let r: &mut WMap<WString, WAny> = doc.map(8i64);
            r.set(K_CTR, name);
            if lp >= 0i64 && lp < b {
                if str_byte_at(cs.measures, b - 1i64) != 41u8 {   // ')'
                    return writ_new(64i64);
                }
                r.set(K_MFN, unsafe { cf_sub(cs.measures, a, lp) });
                r.set(K_ARG, unsafe { cf_sub(cs.measures, lp + 1i64, b - 1i64) });
            } else {
                r.set(K_MFN, unsafe { cf_sub(cs.measures, a, b) });
                r.set(K_ARG, "");
            }
            meas.push(WAny::from(&*r));
            a = b + 1i64;
        }
    }
    root.set(SEC_MEASURES, &*meas);

    doc.set_root(WAny::from(&*root));
    return doc;
}

// ── verdict-doc readers (M4) ────────────────────────────────────────────────
// The handler consumes Canon's verdict doc MECHANICALLY (ADR 0020 §5): a
// capability grants an emission, an error row becomes a compile diagnostic
// carrying Canon's reason verbatim. Helpers return scalars (bool / i64
// codes), not borrowed strs — WAny steps bind to locals (borrowck contract).

fn cv_has_cap(vroot: &WMap<WString, WAny>, ctr: str, cap: str) -> bool {
    let av: WAny = vroot.get(V_CAPS);
    if !av.is_array() { return false; }
    let arr: &WArray<WAny> = av.as_array();
    let mut i: i64 = 0i64;
    while i < arr.len() {
        let e: WAny = arr.get(i);
        if e.is_map() {
            let em: &WMap<WString, WAny> = e.as_map();
            let a1: WAny = em.get(K_CTR);
            let a2: WAny = em.get(K_CAP);
            if a1.is_string() && a2.is_string() {
                if str_eq(a1.as_wstr(), ctr) && str_eq(a2.as_wstr(), cap) {
                    return true;
                }
            }
        }
        i = i + 1i64;
    }
    return false;
}

// col_proj verdict for (ctr, col): the handler's ONLY column vocabulary.
// 0 = no verdict row; 1 = direct (rel-native column, relty = declared type);
// 2 = canon_col (project to i64 through CanonCol). Any OTHER proj string is a
// Canon/handler vocabulary skew and fails LOUDLY — no silent degradation.
fn cv_col_proj(vroot: &WMap<WString, WAny>, ctr: str, col: str) -> i64 {
    let av: WAny = vroot.get(V_COL_PROJS);
    if !av.is_array() {
        error("container item: verdict doc missing its col_projs array (Canon seam regression?)");
        return 0i64;
    }
    let arr: &WArray<WAny> = av.as_array();
    let mut i: i64 = 0i64;
    while i < arr.len() {
        let e: WAny = arr.get(i);
        if e.is_map() {
            let em: &WMap<WString, WAny> = e.as_map();
            let a1: WAny = em.get(K_CTR);
            let a2: WAny = em.get(K_COL);
            let a3: WAny = em.get(K_PROJ);
            if a1.is_string() && a2.is_string() && a3.is_string() {
                if str_eq(a1.as_wstr(), ctr) && str_eq(a2.as_wstr(), col) {
                    if str_eq(a3.as_wstr(), PROJ_DIRECT) { return 1i64; }
                    if str_eq(a3.as_wstr(), PROJ_CANON_COL) { return 2i64; }
                    error("container item: unknown col_proj verdict (Canon/handler vocabulary skew?)");
                    return 0i64;
                }
            }
        }
        i = i + 1i64;
    }
    return 0i64;
}

// The split-policy verdict for a kind=node ctr: "fast" | "volume" | "" (absent).
// The leaf's split_into body is a FUNCTION of this — Canon decides, the emitter
// reproduces the matching hand-written template.
fn cv_split_policy(vroot: &WMap<WString, WAny>, ctr: str) -> str {
    let av: WAny = vroot.get(V_SPLIT);
    if !av.is_array() { return ""; }
    let arr: &WArray<WAny> = av.as_array();
    let mut i: i64 = 0i64;
    while i < arr.len() {
        let e: WAny = arr.get(i);
        if e.is_map() {
            let em: &WMap<WString, WAny> = e.as_map();
            let a1: WAny = em.get(K_CTR);
            let a2: WAny = em.get(K_POLICY);
            if a1.is_string() && a2.is_string() && str_eq(a1.as_wstr(), ctr) {
                return a2.as_wstr();
            }
        }
        i = i + 1i64;
    }
    return "";
}

// relty of the (ctr, col) col_proj verdict row; "" when absent.
fn cv_col_relty(vroot: &WMap<WString, WAny>, ctr: str, col: str) -> str {
    let av: WAny = vroot.get(V_COL_PROJS);
    if !av.is_array() { return ""; }
    let arr: &WArray<WAny> = av.as_array();
    let mut i: i64 = 0i64;
    while i < arr.len() {
        let e: WAny = arr.get(i);
        if e.is_map() {
            let em: &WMap<WString, WAny> = e.as_map();
            let a1: WAny = em.get(K_CTR);
            let a2: WAny = em.get(K_COL);
            let a3: WAny = em.get(K_RELTY);
            if a1.is_string() && a2.is_string() && a3.is_string() {
                if str_eq(a1.as_wstr(), ctr) && str_eq(a2.as_wstr(), col) {
                    return a3.as_wstr();
                }
            }
        }
        i = i + 1i64;
    }
    return "";
}

// Reports every Canon error row as a compile diagnostic:
//   container <ctr>: <code>: <reason>
// Returns the number of rows reported (0 = clean verdict).
fn cv_report_errors(vroot: &WMap<WString, WAny>, name: str) -> i64 {
    let av: WAny = vroot.get(V_ERRORS);
    if !av.is_array() {
        error("container item: verdict doc missing its errors array (Canon seam regression?)");
        return 1i64;
    }
    let arr: &WArray<WAny> = av.as_array();
    let mut i: i64 = 0i64;
    while i < arr.len() {
        let e: WAny = arr.get(i);
        let mut msg: String = String::new();
        msg.push_str("container ");
        msg.push_str(name);
        msg.push_str(": ");
        if e.is_map() {
            let em: &WMap<WString, WAny> = e.as_map();
            let cd: WAny = em.get(K_CODE);
            let rs: WAny = em.get(K_REASON);
            if cd.is_string() { msg.push_str(cd.as_wstr()); }
            msg.push_str(": ");
            if rs.is_string() { msg.push_str(rs.as_wstr()); }
        } else {
            msg.push_str("malformed Canon error row");
        }
        error(msg.as_str());
        i = i + 1i64;
    }
    return arr.len();
}

// ── projection emission (M4, kind=vector, can_scan verdict) ────────────────
// Renders the container's declared generic list with `CanonCol` appended to
// `bound_param`'s bounds (": CanonCol" when unbounded, " + CanonCol" when
// bounded). bound_param = "" renders the list verbatim.
fn emit_generics(em: &mut Emitter, generics: str, bound_param: str) {
    if generics.len() == 0i64 { return; }
    let inner: str = unsafe { cf_sub(generics, 1i64, generics.len() - 1i64) };
    em.push_text("<");
    let n: i64 = inner.len();
    let mut a: i64 = 0i64;
    let mut first: bool = true;
    while a < n {
        let b: i64 = cf_next_comma(inner, a, n);
        let mut s: i64 = a;
        while s < b && str_byte_at(inner, s) == 32u8 { s = s + 1i64; }
        let mut e2: i64 = b;
        while e2 > s && str_byte_at(inner, e2 - 1i64) == 32u8 { e2 = e2 - 1i64; }
        let seg: str = unsafe { cf_sub(inner, s, e2) };
        if !first { em.push_text(", "); }
        first = false;
        em.push_text(seg);
        if bound_param.len() > 0i64 {
            let c: i64 = cf_find(seg, 0i64, 58u8);   // ':'
            let mut ne: i64 = if c >= 0i64 { c } else { seg.len() };
            while ne > 0i64 && str_byte_at(seg, ne - 1i64) == 32u8 { ne = ne - 1i64; }
            let nm: str = unsafe { cf_sub(seg, 0i64, ne) };
            if str_eq(nm, bound_param) {
                if c >= 0i64 { em.push_text(" + CanonCol"); }
                else { em.push_text(": CanonCol"); }
            }
        }
        a = b + 1i64;
    }
    em.push_text(">");
}

// Emits the SCAN projection for one kind=vector container (design §f): a
// single-rel source trait, a scan materializer over the wave-0 backing
// contract (`count(&self) -> i64`, `get(&self, i: i64) -> T`), and the impl
// rel binding — one chunk into the declaring package, imports explicit.
//   relty:  the rel column type (i64 / str / bool);
//   direct: push `e` verbatim (str/bool cols) vs `e.canon_col()` (by_value);
//   bound_param: generic param needing the CanonCol bound ("" = none).
fn emit_vector_scan(cs: &ContainerSpec, name: str, col_name: str, col_ty: str,
                    relty: str, direct: bool, bound_param: str) {
    let view: OView = oview_module_ast();
    let mut tp: String = String::new();
    view.module_package_append(&mut tp);
    let mut em: Emitter = Emitter::new();
    em.emit_target_pkg(&view);
    em.push_text("\nuse logos.mem.collections.vec;\n");
    if !str_eq(tp.as_str(), "logos.lcm.canon.canon") {
        em.push_text("use logos.lcm.canon.canon;\n");
    }
    if cs.backing_pkg.len() > 0i64 && !str_eq(cs.backing_pkg, tp.as_str()) {
        em.push_text("use ");
        em.push_text(cs.backing_pkg);
        em.push_text(";\n");
    }
    if cs.is_pub { em.push_text("pub "); }
    em.push_text("trait __CtrSrc_");
    em.push_text(name);
    em.push_text(" { rel row(pos: i64, ");
    em.push_text(col_name);
    em.push_text(": ");
    em.push_text(relty);
    em.push_text("); }\n");
    if cs.is_pub { em.push_text("pub "); }
    em.push_text("fn __ctr_rows_");
    em.push_text(name);
    emit_generics(&mut em, cs.generics, bound_param);
    em.push_text("(c: &");
    em.push_text(cs.backing);
    em.push_text(") -> Vec<(i64, ");
    em.push_text(relty);
    em.push_text(")> {\n    let mut out: Vec<(i64, ");
    em.push_text(relty);
    em.push_text(")> = vec_new::<(i64, ");
    em.push_text(relty);
    em.push_text(")>();\n    let n: i64 = c.count();\n    let mut i: i64 = 0i64;\n    while i < n {\n        let e: ");
    em.push_text(col_ty);
    em.push_text(" = c.get(i);\n        out.push((i, ");
    if direct { em.push_text("e"); } else { em.push_text("e.canon_col()"); }
    em.push_text("));\n        i = i + 1i64;\n    }\n    return out;\n}\n");
    em.push_text("impl");
    emit_generics(&mut em, cs.generics, bound_param);
    em.push_text(" __CtrSrc_");
    em.push_text(name);
    em.push_text(" for ");
    em.push_text(cs.backing);
    em.push_text(" { rel row = __ctr_rows_");
    em.push_text(name);
    em.push_text("; }\n");
    em.commit();
}

// Emits a concrete b+tree LEAF node for one kind=node container (ADR 0020 Track
// B 2c): a struct owning a pkd block with two sibling columns (key, val) plus
// the Node contract (new/count/key_at/val_at/lower_bound/try_insert/split). The
// value-column encoding AND the split body are CHOSEN BY THE CANON VERDICT:
//   - `fast`   → all-FSE columns, count-balanced split (reproduces LeafU64);
//   - `volume` → a VLE value column (val_at yields &[u8]), a volume-balanced
//                split over both columns' prefix bytes (reproduces LeafKV).
// The verdict is the codegen decision; the emitter is mechanical.
//
// Wave-0 substrate: the generated leaf targets the memoria pkd allocator
// (logos.mem.pkd) directly, PLAIN pkd (alloc / pkd_format / dealloc, no CoW node
// header) — exactly like the hand-written leaf.logos / leaf_kv.logos templates.
fn emit_leaf_node(name: str, kty: str, vty: str, policy: str, cow: bool) {
    let vol: bool = str_eq(policy, SPLIT_VOLUME);
    let view: OView = oview_module_ast();
    let mut em: Emitter = Emitter::new();
    em.emit_target_pkg(&view);
    // CoW flavor (Canon versioning=cow verdict): the node carries the 16-byte
    // node header (snapshot_id + rc) via logos.mem.bt.node — new_in/cow_clone +
    // node_alloc/node_pkd/node_free — instead of plain pkd (alloc/pkd_format).
    em.push_text("\nuse logos.mem.pkd;\n");
    if cow { em.push_text("use logos.mem.bt.node;\n"); } else { em.push_text("use logos.lang.mem;\n"); }
    em.push_text("use logos.lang.result;\n");
    if vol { em.push_text("use logos.lang.str;\n"); }     // val.len() on a VLE column
    if vol { em.push_text("use logos.lang.slice;\n"); }   // str_from_raw / slice for cow_clone
    em.push_text("\n");
    em.push_text("pub struct "); em.push_text(name); em.push_text(" { mem: *mut u8, cap: u32 }\n");
    em.push_text("impl "); em.push_text(name); em.push_text(" {\n");
    // new / new_in — CoW stamps the block with the creating snapshot id.
    if cow {
        em.push_text("    pub static fn new() -> "); em.push_text(name); em.push_text(" { return "); em.push_text(name); em.push_text("::new_in(0u64); }\n");
        em.push_text("    pub static fn new_in(snp: u64) -> "); em.push_text(name); em.push_text(" {\n");
        em.push_text("        unsafe {\n");
        em.push_text("            let base: *mut u8 = node_alloc(4096u32, 2u32, snp);\n");
        em.push_text("            let a: *mut PkdAlloc = node_pkd(base);\n");
    } else {
        em.push_text("    pub static fn new() -> "); em.push_text(name); em.push_text(" {\n");
        em.push_text("        unsafe {\n");
        em.push_text("            let base: *mut u8 = alloc(4096i64);\n");
        em.push_text("            let a: *mut PkdAlloc = pkd_format(base, 4096u32, 2u32);\n");
    }
    em.push_text("            match PkdArray::<"); em.push_text(kty); em.push_text(">::format(a, 0u32) { Result::Ok(_p) => {} Result::Err(_e) => { assert(false, \"key col\"); } }\n");
    em.push_text("            match PkdArray::<"); em.push_text(vty); em.push_text(">::format(a, 1u32) { Result::Ok(_p) => {} Result::Err(_e) => { assert(false, \"val col\"); } }\n");
    em.push_text("            return "); em.push_text(name); em.push_text(" { mem: base, cap: 4096u32 };\n");
    em.push_text("        }\n    }\n");
    // adopt / block / free
    em.push_text("    pub static fn adopt(mem: *mut u8) -> "); em.push_text(name);
    if cow {
        em.push_text(" { return "); em.push_text(name); em.push_text(" { mem: mem, cap: unsafe { (*node_pkd(mem)).block_size() } }; }\n");
    } else {
        em.push_text(" { return "); em.push_text(name); em.push_text(" { mem: mem, cap: unsafe { (mem as *mut PkdAlloc).block_size() } }; }\n");
    }
    em.push_text("    pub fn block(self: &"); em.push_text(name); em.push_text(") -> *mut u8 { return self.mem; }\n");
    em.push_text("    pub fn free(self: "); em.push_text(name);
    if cow { em.push_text(") { unsafe { node_free(self.mem); } }\n"); } else { em.push_text(") { unsafe { dealloc(self.mem); } }\n"); }
    // column accessors
    em.push_text("    unsafe fn a(self: &"); em.push_text(name); em.push_text(") -> *mut PkdAlloc { return ");
    if cow { em.push_text("node_pkd(self.mem)"); } else { em.push_text("self.mem as *mut PkdAlloc"); }
    em.push_text("; }\n");
    em.push_text("    unsafe fn kc(self: &"); em.push_text(name); em.push_text(") -> *mut PkdArray<"); em.push_text(kty); em.push_text("> { return self.a().get::<PkdArray<"); em.push_text(kty); em.push_text(">>(0u32); }\n");
    em.push_text("    unsafe fn vc(self: &"); em.push_text(name); em.push_text(") -> *mut PkdArray<"); em.push_text(vty); em.push_text("> { return self.a().get::<PkdArray<"); em.push_text(vty); em.push_text(">>(1u32); }\n");
    // count / key_at / val_at
    em.push_text("    pub fn count(self: &"); em.push_text(name); em.push_text(") -> u32 { return unsafe { (*self.kc()).count() }; }\n");
    em.push_text("    pub fn key_at(self: &"); em.push_text(name); em.push_text(", i: u32) -> "); em.push_text(kty); em.push_text(" { return unsafe { (*self.kc()).get(i) }; }\n");
    if vol {
        // VLE value column: borrow the bytes, no owning value type.
        em.push_text("    pub fn val_at(self: &"); em.push_text(name); em.push_text(", i: u32) -> &[u8] { return unsafe { (*self.vc()).get_bytes(i) }; }\n");
    } else {
        em.push_text("    pub fn val_at(self: &"); em.push_text(name); em.push_text(", i: u32) -> "); em.push_text(vty); em.push_text(" { return unsafe { (*self.vc()).get(i) }; }\n");
    }
    // lower_bound
    em.push_text("    pub fn lower_bound(self: &"); em.push_text(name); em.push_text(", key: "); em.push_text(kty); em.push_text(") -> u32 {\n");
    em.push_text("        let n: u32 = self.count();\n        let mut i: u32 = 0u32;\n");
    em.push_text("        while i < n { if self.key_at(i) >= key { return i; } i = i + 1u32; }\n        return n;\n    }\n");
    // try_insert (fit-checked, replace-on-hit) — VERDICT-SELECTED body
    em.push_text("    pub fn try_insert(self: &mut "); em.push_text(name); em.push_text(", key: "); em.push_text(kty); em.push_text(", val: "); em.push_text(vty); em.push_text(") -> bool {\n");
    if vol {
        // VLE value column: admission guard on entry bytes, replace-on-hit via
        // remove+insert (VLE has no set), fit-checked with the value's length.
        em.push_text("        let vlen: u32 = val.len() as u32;\n");
        em.push_text("        if 8u32 + vlen > 1024u32 { return false; }\n");
        em.push_text("        unsafe {\n");
        em.push_text("            let pos: u32 = self.lower_bound(key);\n");
        em.push_text("            let hit: bool = pos < self.count() && self.key_at(pos) == key;\n");
        em.push_text("            if hit {\n");
        em.push_text("                let old: u32 = (*self.vc()).volume_upto(pos + 1u32) - (*self.vc()).volume_upto(pos);\n");
        em.push_text("                let grow: u32 = (*self.vc()).estimate_insert(vlen) - self.a().element_size(1u32);\n");
        em.push_text("                let need: u32 = if grow > old { grow - old } else { 0u32 };\n");
        em.push_text("                if need > self.a().free_space() { return false; }\n");
        em.push_text("                (*self.vc()).remove(pos);\n");
        em.push_text("                match (*self.vc()).insert(pos, val) { Result::Ok(_u) => {} Result::Err(_e) => { return false; } }\n");
        em.push_text("                return true;\n");
        em.push_text("            }\n");
        em.push_text("            let dk: u32 = (*self.kc()).estimate_insert(8u32) - self.a().element_size(0u32);\n");
        em.push_text("            let dv: u32 = (*self.vc()).estimate_insert(vlen) - self.a().element_size(1u32);\n");
        em.push_text("            if dk + dv > self.a().free_space() { return false; }\n");
        em.push_text("            match (*self.kc()).insert(pos, &key) { Result::Ok(_u) => {} Result::Err(_e) => { return false; } }\n");
        em.push_text("            match (*self.vc()).insert(pos, val) { Result::Ok(_u) => {} Result::Err(_e) => { return false; } }\n");
        em.push_text("            return true;\n        }\n    }\n");
    } else {
        em.push_text("        unsafe {\n");
        em.push_text("            let pos: u32 = self.lower_bound(key);\n");
        em.push_text("            if pos < self.count() && self.key_at(pos) == key { (*self.vc()).set(pos, val); return true; }\n");
        em.push_text("            let dk: u32 = (*self.kc()).estimate_insert(0u32) - self.a().element_size(0u32);\n");
        em.push_text("            let dv: u32 = (*self.vc()).estimate_insert(0u32) - self.a().element_size(1u32);\n");
        em.push_text("            if dk + dv > self.a().free_space() { return false; }\n");
        em.push_text("            match (*self.kc()).insert(pos, &key) { Result::Ok(_u) => {} Result::Err(_e) => { return false; } }\n");
        em.push_text("            match (*self.vc()).insert(pos, &val) { Result::Ok(_u) => {} Result::Err(_e) => { return false; } }\n");
        em.push_text("            return true;\n        }\n    }\n");
    }
    // split_index — VERDICT-SELECTED body
    if vol {
        em.push_text("    /// Split index: VOLUME-balanced — the Canon verdict for a VLE-column node.\n");
        em.push_text("    pub fn split_index(self: &"); em.push_text(name); em.push_text(") -> u32 {\n");
        em.push_text("        let n: u32 = self.count();\n");
        em.push_text("        if n <= 1u32 { return n; }\n");
        em.push_text("        unsafe {\n");
        em.push_text("            let total: u32 = (*self.kc()).volume_upto(n) + (*self.vc()).volume_upto(n);\n");
        em.push_text("            let half: u32 = total / 2u32;\n");
        em.push_text("            let mut lo: u32 = 1u32;\n");
        em.push_text("            let mut hi: u32 = n - 1u32;\n");
        em.push_text("            let mut at: u32 = 1u32;\n");
        em.push_text("            while lo <= hi {\n");
        em.push_text("                let mid: u32 = lo + (hi - lo) / 2u32;\n");
        em.push_text("                let cv: u32 = (*self.kc()).volume_upto(mid) + (*self.vc()).volume_upto(mid);\n");
        em.push_text("                if cv <= half { at = mid; lo = mid + 1u32; } else { if mid == 1u32 { break; } hi = mid - 1u32; }\n");
        em.push_text("            }\n");
        em.push_text("            return at;\n        }\n    }\n");
    } else {
        em.push_text("    /// Split index: FAST (count-balanced) — the Canon verdict for an all-FSE node.\n");
        em.push_text("    pub fn split_index(self: &"); em.push_text(name); em.push_text(") -> u32 { return self.count() / 2u32; }\n");
    }
    em.push_text("    pub fn split_into(self: &mut "); em.push_text(name); em.push_text(", dst: &mut "); em.push_text(name); em.push_text(") {\n");
    em.push_text("        let at: u32 = self.split_index();\n");
    em.push_text("        unsafe {\n");
    em.push_text("            let _ = (*self.kc()).split_into(&mut *dst.kc(), at);\n");
    em.push_text("            let _ = (*self.vc()).split_into(&mut *dst.vc(), at);\n");
    em.push_text("        }\n    }\n");
    // cow_clone — a private copy on a fresh block stamped `snp` (CoW duplication;
    // a leaf has no children to share). Only emitted for the CoW node flavor.
    if cow {
        em.push_text("    pub fn cow_clone(self: &"); em.push_text(name); em.push_text(", snp: u64) -> "); em.push_text(name); em.push_text(" {\n");
        em.push_text("        let mut c: "); em.push_text(name); em.push_text(" = "); em.push_text(name); em.push_text("::new_in(snp);\n");
        em.push_text("        let n: u32 = self.count();\n        let mut i: u32 = 0u32;\n");
        if vol {
            // VLE value: val_at yields &[u8]; reconstruct a str view over the
            // bytes (str ≡ [u8]) to feed the str-typed try_insert.
            em.push_text("        while i < n {\n");
            em.push_text("            let v: &[u8] = self.val_at(i);\n");
            em.push_text("            let vs: str = unsafe { str_from_raw(v.as_ptr(), v.len()) };\n");
            em.push_text("            let _ = c.try_insert(self.key_at(i), vs);\n");
            em.push_text("            i = i + 1u32;\n        }\n");
        } else {
            em.push_text("        while i < n { let _ = c.try_insert(self.key_at(i), self.val_at(i)); i = i + 1u32; }\n");
        }
        em.push_text("        return c;\n    }\n");
    }
    em.push_text("}\n");
    em.commit();
}

// Emits a concrete b+tree BRANCH (routing) node for one kind=branch container
// (ADR 0020 Track B 2c). Reproduces the hand-written BranchU64 template but on
// PLAIN pkd (alloc / pkd_format / dealloc, no CoW node header) — three sibling
// FSE columns over one owned block:
//   slot 0 sep (kty) : each child's separator = the MAX key in its subtree;
//   slot 1 sz  (u64) : each child's subtree SIZE (the SUM measure column);
//   slot 2 ptr (u64) : each child's block address (reached via child_addr).
// A branch is ALWAYS count-balanced (all-FSE) — no split_policy verdict, unlike
// a leaf. The branch is CHILD-TYPE-AGNOSTIC (generated with no concrete leaf
// type in scope), so the child-descent operations (rank, get_or) take a descent
// HOOK fn-pointer — the caller binds it to the concrete leaf type; free_children
// releases child blocks by raw dealloc (block-id lifecycle, no typed handle).
fn emit_branch_node(name: str, kty: str, cow: bool) {
    let view: OView = oview_module_ast();
    let mut em: Emitter = Emitter::new();
    em.emit_target_pkg(&view);
    // CoW flavor: the branch carries the node header (new_in/cow_clone; cow_clone
    // bumps every shared child's rc) via logos.mem.bt.node.
    em.push_text("\nuse logos.mem.pkd;\n");
    if cow { em.push_text("use logos.mem.bt.node;\n"); } else { em.push_text("use logos.lang.mem;\n"); }
    em.push_text("use logos.lang.result;\n\n");
    em.push_text("pub struct "); em.push_text(name); em.push_text(" { mem: *mut u8, cap: u32 }\n");
    em.push_text("impl "); em.push_text(name); em.push_text(" {\n");
    // new / new_in — one owned block, three FSE columns (sep: kty, sz/ptr: u64)
    if cow {
        em.push_text("    pub static fn new() -> "); em.push_text(name); em.push_text(" { return "); em.push_text(name); em.push_text("::new_in(0u64); }\n");
        em.push_text("    pub static fn new_in(snp: u64) -> "); em.push_text(name); em.push_text(" {\n");
        em.push_text("        unsafe {\n");
        em.push_text("            let base: *mut u8 = node_alloc(4096u32, 3u32, snp);\n");
        em.push_text("            let a: *mut PkdAlloc = node_pkd(base);\n");
    } else {
        em.push_text("    pub static fn new() -> "); em.push_text(name); em.push_text(" {\n");
        em.push_text("        unsafe {\n");
        em.push_text("            let base: *mut u8 = alloc(4096i64);\n");
        em.push_text("            let a: *mut PkdAlloc = pkd_format(base, 4096u32, 3u32);\n");
    }
    em.push_text("            match PkdArray::<"); em.push_text(kty); em.push_text(">::format(a, 0u32) { Result::Ok(_p) => {} Result::Err(_e) => { assert(false, \"sep col\"); } }\n");
    em.push_text("            match PkdArray::<u64>::format(a, 1u32) { Result::Ok(_p) => {} Result::Err(_e) => { assert(false, \"sz col\"); } }\n");
    em.push_text("            match PkdArray::<u64>::format(a, 2u32) { Result::Ok(_p) => {} Result::Err(_e) => { assert(false, \"ptr col\"); } }\n");
    em.push_text("            return "); em.push_text(name); em.push_text(" { mem: base, cap: 4096u32 };\n");
    em.push_text("        }\n    }\n");
    // adopt / block
    em.push_text("    pub static fn adopt(mem: *mut u8) -> "); em.push_text(name);
    if cow {
        em.push_text(" { return "); em.push_text(name); em.push_text(" { mem: mem, cap: unsafe { (*node_pkd(mem)).block_size() } }; }\n");
    } else {
        em.push_text(" { return "); em.push_text(name); em.push_text(" { mem: mem, cap: unsafe { (mem as *mut PkdAlloc).block_size() } }; }\n");
    }
    em.push_text("    pub fn block(self: &"); em.push_text(name); em.push_text(") -> *mut u8 { return self.mem; }\n");
    // column accessors
    em.push_text("    unsafe fn a(self: &"); em.push_text(name); em.push_text(") -> *mut PkdAlloc { return ");
    if cow { em.push_text("node_pkd(self.mem)"); } else { em.push_text("self.mem as *mut PkdAlloc"); }
    em.push_text("; }\n");
    em.push_text("    unsafe fn sep(self: &"); em.push_text(name); em.push_text(") -> *mut PkdArray<"); em.push_text(kty); em.push_text("> { return self.a().get::<PkdArray<"); em.push_text(kty); em.push_text(">>(0u32); }\n");
    em.push_text("    unsafe fn szc(self: &"); em.push_text(name); em.push_text(") -> *mut PkdArray<u64> { return self.a().get::<PkdArray<u64>>(1u32); }\n");
    em.push_text("    unsafe fn ptrc(self: &"); em.push_text(name); em.push_text(") -> *mut PkdArray<u64> { return self.a().get::<PkdArray<u64>>(2u32); }\n");
    // child_count / sep_at / size_at / child_addr / set_child_addr
    em.push_text("    pub fn child_count(self: &"); em.push_text(name); em.push_text(") -> u32 { return unsafe { (*self.sep()).count() }; }\n");
    em.push_text("    pub fn sep_at(self: &"); em.push_text(name); em.push_text(", i: u32) -> "); em.push_text(kty); em.push_text(" { return unsafe { (*self.sep()).get(i) }; }\n");
    em.push_text("    pub fn size_at(self: &"); em.push_text(name); em.push_text(", i: u32) -> u64 { return unsafe { (*self.szc()).get(i) }; }\n");
    em.push_text("    pub fn child_addr(self: &"); em.push_text(name); em.push_text(", i: u32) -> *mut u8 { return unsafe { (*self.ptrc()).get(i) as *mut u8 }; }\n");
    em.push_text("    pub fn set_child_addr(self: &mut "); em.push_text(name); em.push_text(", i: u32, ptr: *mut u8) { unsafe { (*self.ptrc()).set(i, ptr as u64); } }\n");
    // max_sep
    em.push_text("    pub fn max_sep(self: &"); em.push_text(name); em.push_text(") -> "); em.push_text(kty); em.push_text(" {\n");
    em.push_text("        let n: u32 = self.child_count();\n");
    em.push_text("        assert(n > 0u32, \"max_sep: empty branch\");\n");
    em.push_text("        return self.sep_at(n - 1u32);\n    }\n");
    // total_size (the SUM measure fold)
    em.push_text("    pub fn total_size(self: &"); em.push_text(name); em.push_text(") -> u64 {\n");
    em.push_text("        let n: u32 = self.child_count();\n        let mut s: u64 = 0u64;\n        let mut i: u32 = 0u32;\n");
    em.push_text("        while i < n { s = s + self.size_at(i); i = i + 1u32; }\n        return s;\n    }\n");
    // find_child
    em.push_text("    pub fn find_child(self: &"); em.push_text(name); em.push_text(", key: "); em.push_text(kty); em.push_text(") -> u32 {\n");
    em.push_text("        let n: u32 = self.child_count();\n        let mut i: u32 = 0u32;\n");
    em.push_text("        while i < n { if self.sep_at(i) >= key { return i; } i = i + 1u32; }\n");
    em.push_text("        return if n > 0u32 { n - 1u32 } else { 0u32 };\n    }\n");
    // rank — order statistic via the SUM column; child descent via the hook `lb`
    em.push_text("    pub fn rank(self: &"); em.push_text(name); em.push_text(", key: "); em.push_text(kty); em.push_text(", lb: fn(*mut u8, "); em.push_text(kty); em.push_text(") -> u32) -> u64 {\n");
    em.push_text("        let n: u32 = self.child_count();\n        if n == 0u32 { return 0u64; }\n");
    em.push_text("        let ci: u32 = self.find_child(key);\n        let mut base: u64 = 0u64;\n        let mut i: u32 = 0u32;\n");
    em.push_text("        while i < ci { base = base + self.size_at(i); i = i + 1u32; }\n");
    em.push_text("        return base + (lb(self.child_addr(ci), key) as u64);\n    }\n");
    // get_or — descend to the covering child, probe via the hook `probe`
    em.push_text("    pub fn get_or(self: &"); em.push_text(name); em.push_text(", key: "); em.push_text(kty); em.push_text(", sentinel: u64, probe: fn(*mut u8, "); em.push_text(kty); em.push_text(", u64) -> u64) -> u64 {\n");
    em.push_text("        let n: u32 = self.child_count();\n        if n == 0u32 { return sentinel; }\n");
    em.push_text("        let ci: u32 = self.find_child(key);\n");
    em.push_text("        return probe(self.child_addr(ci), key, sentinel);\n    }\n");
    // push_child / insert_child / update_child
    em.push_text("    pub fn push_child(self: &mut "); em.push_text(name); em.push_text(", sep: "); em.push_text(kty); em.push_text(", sz: u64, ptr: *mut u8) {\n");
    em.push_text("        unsafe {\n            let p: u64 = ptr as u64;\n");
    em.push_text("            let _ = (*self.sep()).push(&sep);\n            let _ = (*self.szc()).push(&sz);\n            let _ = (*self.ptrc()).push(&p);\n        }\n    }\n");
    em.push_text("    pub fn insert_child(self: &mut "); em.push_text(name); em.push_text(", pos: u32, sep: "); em.push_text(kty); em.push_text(", sz: u64, ptr: *mut u8) {\n");
    em.push_text("        unsafe {\n            let p: u64 = ptr as u64;\n");
    em.push_text("            let _ = (*self.sep()).insert(pos, &sep);\n            let _ = (*self.szc()).insert(pos, &sz);\n            let _ = (*self.ptrc()).insert(pos, &p);\n        }\n    }\n");
    em.push_text("    pub fn update_child(self: &mut "); em.push_text(name); em.push_text(", i: u32, sep: "); em.push_text(kty); em.push_text(", sz: u64) {\n");
    em.push_text("        unsafe {\n            (*self.sep()).set(i, sep);\n            (*self.szc()).set(i, sz);\n        }\n    }\n");
    // can_insert_child (24 bytes across the three FSE columns vs free space)
    em.push_text("    pub fn can_insert_child(self: &"); em.push_text(name); em.push_text(") -> bool {\n");
    em.push_text("        unsafe {\n");
    em.push_text("            let d0: u32 = (*self.sep()).estimate_insert(8u32) - self.a().element_size(0u32);\n");
    em.push_text("            let d1: u32 = (*self.szc()).estimate_insert(8u32) - self.a().element_size(1u32);\n");
    em.push_text("            let d2: u32 = (*self.ptrc()).estimate_insert(8u32) - self.a().element_size(2u32);\n");
    em.push_text("            return d0 + d1 + d2 <= self.a().free_space();\n        }\n    }\n");
    // split_into — count-balanced (all-FSE); returns the promoted separator
    em.push_text("    pub fn split_into(self: &mut "); em.push_text(name); em.push_text(", dst: &mut "); em.push_text(name); em.push_text(") -> "); em.push_text(kty); em.push_text(" {\n");
    em.push_text("        let at: u32 = self.child_count() / 2u32;\n");
    em.push_text("        unsafe {\n");
    em.push_text("            let _ = (*self.sep()).split_into(&mut *dst.sep(), at);\n");
    em.push_text("            let _ = (*self.szc()).split_into(&mut *dst.szc(), at);\n");
    em.push_text("            let _ = (*self.ptrc()).split_into(&mut *dst.ptrc(), at);\n");
    em.push_text("        }\n        return self.max_sep();\n    }\n");
    // free_children — release every child block, then this branch's block (a flat
    // free ignoring rc; the CoW map tears down through the rc-aware release path
    // instead, so this stays a raw free of unshared nodes).
    let free1: str = if cow { "node_free" } else { "dealloc" };
    em.push_text("    pub fn free_children(self: "); em.push_text(name); em.push_text(") {\n");
    em.push_text("        let n: u32 = self.child_count();\n        let mut i: u32 = 0u32;\n");
    em.push_text("        while i < n { unsafe { "); em.push_text(free1); em.push_text("(self.child_addr(i)); } i = i + 1u32; }\n");
    em.push_text("        unsafe { "); em.push_text(free1); em.push_text("(self.mem); }\n    }\n");
    // free_block — release ONLY this branch's block (children freed elsewhere).
    em.push_text("    pub fn free_block(self: "); em.push_text(name); em.push_text(") { unsafe { "); em.push_text(free1); em.push_text("(self.mem); } }\n");
    // cow_clone — a private copy on a fresh block stamped `snp`; copies the child
    // entries and BUMPS each child's rc (structural sharing). CoW flavor only.
    if cow {
        em.push_text("    pub fn cow_clone(self: &"); em.push_text(name); em.push_text(", snp: u64) -> "); em.push_text(name); em.push_text(" {\n");
        em.push_text("        let mut c: "); em.push_text(name); em.push_text(" = "); em.push_text(name); em.push_text("::new_in(snp);\n");
        em.push_text("        let n: u32 = self.child_count();\n        let mut i: u32 = 0u32;\n");
        em.push_text("        while i < n {\n");
        em.push_text("            let p: *mut u8 = self.child_addr(i);\n");
        em.push_text("            unsafe { node_inc_rc(p); }\n");
        em.push_text("            c.push_child(self.sep_at(i), self.size_at(i), p);\n");
        em.push_text("            i = i + 1u32;\n        }\n        return c;\n    }\n");
    }
    em.push_text("}\n");
    em.commit();
}

// Emits the concrete b+tree ASSEMBLY (`{N}Tree`) over the plan's leaf `lname`
// and branch `bname` — the multi-level tree realizing the container_shape
// `aspect=assembly value=tree` row (ADR 0020 §5). Reproduces the hand-written
// logos.mem.bt.tree template (BTreeU64) with the leaf/branch NAMES and the
// key/val types threaded in: the recursive insert cascade (descend → try_insert
// → split leaf → InsertRet up → parent grafts insert_child → split branch → new
// root on root split), plus get_or / size / height / recursive free.
//
// Threading notes vs the template: the generated leaf has no `max_key` method
// (LeafU64's), so a node's separator is `key_at(count-1)`; a non-split return's
// unread `rsep` slot is filled with `key` (any kty value — the parent ignores it
// when split==false). The branch is child-type-agnostic; the tree binds descent
// to THIS map's `{N}Leaf` directly (same package, no fn-pointer hook needed).
// Value handling is VERDICT-selected via `vol`: a fast (FSE) leaf returns the
// value by value (`get_or(key, sentinel: vty) -> vty`); a volume (VLE) leaf
// returns it by view (`get_or(key) -> &[u8]`, borrowing the tree). The insert
// cascade is identical either way (the leaf handles its own split; the branch
// routes by key only).
fn emit_tree(tname: str, lname: str, bname: str, kty: str, vty: str, vol: bool) {
    let view: OView = oview_module_ast();
    let mut em: Emitter = Emitter::new();
    em.emit_target_pkg(&view);
    if vol { em.push_text("\nuse logos.lang.slice;\n"); }   // slice_from_raw (by-view get_or)
    em.push_text("\n");
    // InsertRet — the upward result of a recursive insert (see the template).
    em.push_text("struct "); em.push_text(tname); em.push_text("IR { lsep: "); em.push_text(kty);
    em.push_text(", lsize: u64, split: bool, rsep: "); em.push_text(kty); em.push_text(", rsize: u64, rptr: *mut u8 }\n\n");
    // insert_rec
    em.push_text("fn "); em.push_text(tname); em.push_text("_ins(node: *mut u8, level: u32, key: "); em.push_text(kty); em.push_text(", val: "); em.push_text(vty); em.push_text(") -> "); em.push_text(tname); em.push_text("IR {\n");
    em.push_text("    if level == 0u32 {\n");
    em.push_text("        let mut lf: "); em.push_text(lname); em.push_text(" = "); em.push_text(lname); em.push_text("::adopt(node);\n");
    em.push_text("        if lf.try_insert(key, val) {\n");
    em.push_text("            return "); em.push_text(tname); em.push_text("IR { lsep: lf.key_at(lf.count() - 1u32), lsize: lf.count() as u64, split: false, rsep: key, rsize: 0u64, rptr: node };\n");
    em.push_text("        }\n");
    em.push_text("        let mut rt: "); em.push_text(lname); em.push_text(" = "); em.push_text(lname); em.push_text("::new();\n");
    em.push_text("        lf.split_into(&mut rt);\n");
    em.push_text("        if key <= lf.key_at(lf.count() - 1u32) { let _ = lf.try_insert(key, val); } else { let _ = rt.try_insert(key, val); }\n");
    em.push_text("        return "); em.push_text(tname); em.push_text("IR { lsep: lf.key_at(lf.count() - 1u32), lsize: lf.count() as u64, split: true, rsep: rt.key_at(rt.count() - 1u32), rsize: rt.count() as u64, rptr: rt.block() };\n");
    em.push_text("    }\n");
    em.push_text("    let mut br: "); em.push_text(bname); em.push_text(" = "); em.push_text(bname); em.push_text("::adopt(node);\n");
    em.push_text("    let ci: u32 = br.find_child(key);\n");
    em.push_text("    let r: "); em.push_text(tname); em.push_text("IR = "); em.push_text(tname); em.push_text("_ins(br.child_addr(ci), level - 1u32, key, val);\n");
    em.push_text("    br.update_child(ci, r.lsep, r.lsize);\n");
    em.push_text("    if !r.split {\n");
    em.push_text("        return "); em.push_text(tname); em.push_text("IR { lsep: br.max_sep(), lsize: br.total_size(), split: false, rsep: key, rsize: 0u64, rptr: node };\n");
    em.push_text("    }\n");
    em.push_text("    if br.can_insert_child() {\n");
    em.push_text("        br.insert_child(ci + 1u32, r.rsep, r.rsize, r.rptr);\n");
    em.push_text("        return "); em.push_text(tname); em.push_text("IR { lsep: br.max_sep(), lsize: br.total_size(), split: false, rsep: key, rsize: 0u64, rptr: node };\n");
    em.push_text("    }\n");
    em.push_text("    let mut rb: "); em.push_text(bname); em.push_text(" = "); em.push_text(bname); em.push_text("::new();\n");
    em.push_text("    let _ = br.split_into(&mut rb);\n");
    em.push_text("    let lc: u32 = br.child_count();\n");
    em.push_text("    if ci + 1u32 < lc { br.insert_child(ci + 1u32, r.rsep, r.rsize, r.rptr); } else { rb.insert_child(ci + 1u32 - lc, r.rsep, r.rsize, r.rptr); }\n");
    em.push_text("    return "); em.push_text(tname); em.push_text("IR { lsep: br.max_sep(), lsize: br.total_size(), split: true, rsep: rb.max_sep(), rsize: rb.total_size(), rptr: rb.block() };\n");
    em.push_text("}\n\n");
    // free_rec
    em.push_text("fn "); em.push_text(tname); em.push_text("_free(node: *mut u8, level: u32) {\n");
    em.push_text("    if level == 0u32 { "); em.push_text(lname); em.push_text("::adopt(node).free(); return; }\n");
    em.push_text("    let br: "); em.push_text(bname); em.push_text(" = "); em.push_text(bname); em.push_text("::adopt(node);\n");
    em.push_text("    let n: u32 = br.child_count();\n    let mut i: u32 = 0u32;\n");
    em.push_text("    while i < n { "); em.push_text(tname); em.push_text("_free(br.child_addr(i), level - 1u32); i = i + 1u32; }\n");
    em.push_text("    br.free_block();\n}\n\n");
    // the tree handle
    em.push_text("pub struct "); em.push_text(tname); em.push_text(" { root: *mut u8, root_level: u32 }\n");
    em.push_text("impl "); em.push_text(tname); em.push_text(" {\n");
    em.push_text("    pub static fn new() -> "); em.push_text(tname); em.push_text(" { let lf: "); em.push_text(lname); em.push_text(" = "); em.push_text(lname); em.push_text("::new(); return "); em.push_text(tname); em.push_text(" { root: lf.block(), root_level: 0u32 }; }\n");
    em.push_text("    pub fn height(self: &"); em.push_text(tname); em.push_text(") -> u32 { return self.root_level; }\n");
    em.push_text("    pub fn size(self: &"); em.push_text(tname); em.push_text(") -> u64 {\n");
    em.push_text("        if self.root_level == 0u32 { return "); em.push_text(lname); em.push_text("::adopt(self.root).count() as u64; }\n");
    em.push_text("        return "); em.push_text(bname); em.push_text("::adopt(self.root).total_size();\n    }\n");
    em.push_text("    pub fn insert(self: &mut "); em.push_text(tname); em.push_text(", key: "); em.push_text(kty); em.push_text(", val: "); em.push_text(vty); em.push_text(") {\n");
    em.push_text("        let r: "); em.push_text(tname); em.push_text("IR = "); em.push_text(tname); em.push_text("_ins(self.root, self.root_level, key, val);\n");
    em.push_text("        if r.split {\n");
    em.push_text("            let mut nr: "); em.push_text(bname); em.push_text(" = "); em.push_text(bname); em.push_text("::new();\n");
    em.push_text("            nr.push_child(r.lsep, r.lsize, self.root);\n");
    em.push_text("            nr.push_child(r.rsep, r.rsize, r.rptr);\n");
    em.push_text("            self.root = nr.block();\n            self.root_level = self.root_level + 1u32;\n        }\n    }\n");
    // get_or — VERDICT-SELECTED value return. fast → by VALUE: `get_or(key,
    // sentinel: vty) -> vty`. volume → by VIEW: `get_or(key) -> &[u8]`, the
    // value view BORROWING &self (its block is tree-owned; the borrow-carrying
    // result of ADR 0020 §3). slice_from_raw re-anchors the leaf handle's byte
    // view to the &self return (an unbounded lifetime from a raw ptr flows to
    // the return position), so it outlives the local leaf handle; a MISS is an
    // empty slice (no by-value sentinel exists for a view — and a second `&[u8]`
    // sentinel input would make the output lifetime ambiguous).
    if vol {
        em.push_text("    pub fn get_or(self: &"); em.push_text(tname); em.push_text(", key: "); em.push_text(kty); em.push_text(") -> &[u8] {\n");
    } else {
        em.push_text("    pub fn get_or(self: &"); em.push_text(tname); em.push_text(", key: "); em.push_text(kty); em.push_text(", sentinel: "); em.push_text(vty); em.push_text(") -> "); em.push_text(vty); em.push_text(" {\n");
    }
    em.push_text("        let mut node: *mut u8 = self.root;\n        let mut level: u32 = self.root_level;\n");
    em.push_text("        while level > 0u32 { let br: "); em.push_text(bname); em.push_text(" = "); em.push_text(bname); em.push_text("::adopt(node); node = br.child_addr(br.find_child(key)); level = level - 1u32; }\n");
    em.push_text("        let lf: "); em.push_text(lname); em.push_text(" = "); em.push_text(lname); em.push_text("::adopt(node);\n");
    em.push_text("        let p: u32 = lf.lower_bound(key);\n");
    if vol {
        em.push_text("        if p < lf.count() && lf.key_at(p) == key { let v: &[u8] = lf.val_at(p); return unsafe { slice_from_raw::<u8>(v.as_ptr(), v.len()) }; }\n");
        em.push_text("        return unsafe { slice_from_raw::<u8>(self.root as *const u8, 0i64) };\n    }\n");
    } else {
        em.push_text("        if p < lf.count() && lf.key_at(p) == key { return lf.val_at(p); }\n        return sentinel;\n    }\n");
    }
    em.push_text("    pub fn free(self: "); em.push_text(tname); em.push_text(") { "); em.push_text(tname); em.push_text("_free(self.root, self.root_level); }\n");
    em.push_text("}\n");
    em.commit();
}

// Emits the copy-on-write map's KEY/VALUE-typed half (`{N}CowRet` + the
// cow_insert / descend_get functions + the `{N}` Ctr handle) realizing the
// container_shape `aspect=versioning value=cow` row (ADR 0020 §5), over the
// CoW-flavored {N}Leaf/{N}Branch (node header + new_in/cow_clone). The
// STORE/SNAPSHOT half is NOT generated: containers run on the hand-written
// MemoryStore / MemorySnapshot (logos.mem.bt.memstore) — the container⟂store
// split. `{N}` is a thin typed view of container `ctr_id` in a snapshot; it
// finds its root through the snapshot's directory (`root_of`/`set_root`) and
// releases trees through the store's container-agnostic `tree_release`. One
// snapshot holds MANY containers and commits them atomically.
//
// This closes ②: one `container` declaration → the whole CoW-Map stack (its
// typed half + the shared store). Value handling is VERDICT-selected via `vol`:
// fast (FSE) returns by value + sentinel; volume (VLE) returns a &[u8] view
// borrowing the handle (a MISS is an empty slice).
//
// Wave-0 unit constraint: the DECLARING unit must `use logos.mem.bt.map;` — the
// generated `impl Ctr for {N}` names that trait, and the impl's trait-existence
// check runs at COLLECT time against traits registered from the unit's own
// imports (an emitted `use` resolves types/functions/bounds at RESOLVE time, but
// too late for the collect-phase impl check). A generic `kind map` surface (① /
// a compiler traits-refresh) removes this later. `logos.mem.bt.memstore` (the
// MemorySnapshot capability + DirEntry + tree_release), `logos.mem.bt.node` and
// `logos.mem.pkd` are function/type refs and resolve via the emitted `use`.
fn emit_cow_map(name: str, lname: str, bname: str, kty: str, vty: str, vol: bool) {
    let view: OView = oview_module_ast();
    let mut em: Emitter = Emitter::new();
    em.emit_target_pkg(&view);
    em.push_text("\nuse logos.mem.bt.node;\n");        // node_snapshot — the CoW skip test
    em.push_text("use logos.mem.bt.map;\n");            // Ctr trait
    em.push_text("use logos.mem.bt.memstore;\n");       // MemorySnapshot, DirEntry, tree_release
    if vol { em.push_text("use logos.lang.slice;\n"); } // slice_from_raw (by-view get_or)
    em.push_text("\n");
    // CowRet — the upward result of a recursive CoW insert (addr = this subtree's
    // root after the insert; equals the input when written in place, else a copy).
    em.push_text("struct "); em.push_text(name); em.push_text("CowRet { addr: *mut u8, lsep: "); em.push_text(kty);
    em.push_text(", lsize: u64, split: bool, rsep: "); em.push_text(kty); em.push_text(", rsize: u64, rptr: *mut u8 }\n\n");
    // release is now the store's CONTAINER-AGNOSTIC `tree_release` (logos.mem.bt
    // .memstore) — it recurses the uniform branch shape (slot 2 = child refs) +
    // the rc header from just (root, level), so the generator no longer emits a
    // per-container release. cow_insert + the {N} handle call it directly.
    // leaf_private / branch_private — a version the writer may mutate in place
    // under snapshot `cur` (the node itself when it belongs to cur, else a copy).
    em.push_text("unsafe fn "); em.push_text(name); em.push_text("_leaf_private(node: *mut u8, cur: u64) -> *mut u8 {\n");
    em.push_text("    if node_snapshot(node) == cur { return node; }\n");
    em.push_text("    return "); em.push_text(lname); em.push_text("::adopt(node).cow_clone(cur).block();\n}\n");
    em.push_text("unsafe fn "); em.push_text(name); em.push_text("_branch_private(node: *mut u8, cur: u64) -> *mut u8 {\n");
    em.push_text("    if node_snapshot(node) == cur { return node; }\n");
    em.push_text("    return "); em.push_text(bname); em.push_text("::adopt(node).cow_clone(cur).block();\n}\n\n");
    // cow_insert — insert (key,val) copying shared nodes on the path. Never
    // releases `node` itself; the caller repoints + releases when `addr` differs.
    em.push_text("unsafe fn "); em.push_text(name); em.push_text("_cow_insert(node: *mut u8, level: u32, key: "); em.push_text(kty); em.push_text(", val: "); em.push_text(vty); em.push_text(", cur: u64) -> "); em.push_text(name); em.push_text("CowRet {\n");
    em.push_text("    if level == 0u32 {\n");
    em.push_text("        let work: *mut u8 = "); em.push_text(name); em.push_text("_leaf_private(node, cur);\n");
    em.push_text("        let mut lf: "); em.push_text(lname); em.push_text(" = "); em.push_text(lname); em.push_text("::adopt(work);\n");
    em.push_text("        if lf.try_insert(key, val) {\n");
    em.push_text("            return "); em.push_text(name); em.push_text("CowRet { addr: work, lsep: lf.key_at(lf.count() - 1u32), lsize: lf.count() as u64, split: false, rsep: key, rsize: 0u64, rptr: work };\n");
    em.push_text("        }\n");
    em.push_text("        let mut rt: "); em.push_text(lname); em.push_text(" = "); em.push_text(lname); em.push_text("::new_in(cur);\n");
    em.push_text("        lf.split_into(&mut rt);\n");
    em.push_text("        if key <= lf.key_at(lf.count() - 1u32) { let _ = lf.try_insert(key, val); } else { let _ = rt.try_insert(key, val); }\n");
    em.push_text("        return "); em.push_text(name); em.push_text("CowRet { addr: work, lsep: lf.key_at(lf.count() - 1u32), lsize: lf.count() as u64, split: true, rsep: rt.key_at(rt.count() - 1u32), rsize: rt.count() as u64, rptr: rt.block() };\n");
    em.push_text("    }\n");
    em.push_text("    let work: *mut u8 = "); em.push_text(name); em.push_text("_branch_private(node, cur);\n");
    em.push_text("    let mut br: "); em.push_text(bname); em.push_text(" = "); em.push_text(bname); em.push_text("::adopt(work);\n");
    em.push_text("    let ci: u32 = br.find_child(key);\n");
    em.push_text("    let old_child: *mut u8 = br.child_addr(ci);\n");
    em.push_text("    let r: "); em.push_text(name); em.push_text("CowRet = "); em.push_text(name); em.push_text("_cow_insert(old_child, level - 1u32, key, val, cur);\n");
    em.push_text("    br.update_child(ci, r.lsep, r.lsize);\n");
    em.push_text("    if r.addr != old_child {\n");
    em.push_text("        br.set_child_addr(ci, r.addr);\n");
    em.push_text("        tree_release(old_child, level - 1u32);\n    }\n");
    em.push_text("    if !r.split {\n");
    em.push_text("        return "); em.push_text(name); em.push_text("CowRet { addr: work, lsep: br.max_sep(), lsize: br.total_size(), split: false, rsep: key, rsize: 0u64, rptr: work };\n");
    em.push_text("    }\n");
    em.push_text("    if br.can_insert_child() {\n");
    em.push_text("        br.insert_child(ci + 1u32, r.rsep, r.rsize, r.rptr);\n");
    em.push_text("        return "); em.push_text(name); em.push_text("CowRet { addr: work, lsep: br.max_sep(), lsize: br.total_size(), split: false, rsep: key, rsize: 0u64, rptr: work };\n");
    em.push_text("    }\n");
    em.push_text("    let mut rb: "); em.push_text(bname); em.push_text(" = "); em.push_text(bname); em.push_text("::new_in(cur);\n");
    em.push_text("    let _ = br.split_into(&mut rb);\n");
    em.push_text("    let lc: u32 = br.child_count();\n");
    em.push_text("    if ci + 1u32 < lc { br.insert_child(ci + 1u32, r.rsep, r.rsize, r.rptr); } else { rb.insert_child(ci + 1u32 - lc, r.rsep, r.rsize, r.rptr); }\n");
    em.push_text("    return "); em.push_text(name); em.push_text("CowRet { addr: work, lsep: br.max_sep(), lsize: br.total_size(), split: true, rsep: rb.max_sep(), rsize: rb.total_size(), rptr: rb.block() };\n");
    em.push_text("}\n\n");
    // descend_get — read path (never copies). fast returns by value + sentinel;
    // volume returns a &[u8] view (borrowing the root's storage), miss = empty.
    if vol {
        em.push_text("unsafe fn "); em.push_text(name); em.push_text("_descend_get(root: *mut u8, level: u32, key: "); em.push_text(kty); em.push_text(") -> &[u8] {\n");
    } else {
        em.push_text("unsafe fn "); em.push_text(name); em.push_text("_descend_get(root: *mut u8, level: u32, key: "); em.push_text(kty); em.push_text(", sentinel: "); em.push_text(vty); em.push_text(") -> "); em.push_text(vty); em.push_text(" {\n");
    }
    em.push_text("    let mut node: *mut u8 = root;\n    let mut lvl: u32 = level;\n");
    em.push_text("    while lvl > 0u32 { let br: "); em.push_text(bname); em.push_text(" = "); em.push_text(bname); em.push_text("::adopt(node); node = br.child_addr(br.find_child(key)); lvl = lvl - 1u32; }\n");
    em.push_text("    let lf: "); em.push_text(lname); em.push_text(" = "); em.push_text(lname); em.push_text("::adopt(node);\n");
    em.push_text("    let p: u32 = lf.lower_bound(key);\n");
    if vol {
        em.push_text("    if p < lf.count() && lf.key_at(p) == key { let v: &[u8] = lf.val_at(p); return slice_from_raw::<u8>(v.as_ptr(), v.len()); }\n    return slice_from_raw::<u8>(root as *const u8, 0i64);\n}\n\n");
    } else {
        em.push_text("    if p < lf.count() && lf.key_at(p) == key { return lf.val_at(p); }\n    return sentinel;\n}\n\n");
    }
    // {N} — the Ctr handle: a typed view of container `ctr_id` in a hand-written
    // MemorySnapshot (logos.mem.bt.memstore). The snapshot owns versioning + the
    // directory + the storage capability; this handle carries only the
    // container's identity and routes every op through the snapshot: reads/writes
    // find the root via `root_of(ctr_id)`, a CoW insert repoints it via
    // `set_root`, and node lifecycle rides the generic `tree_release` + the
    // CoW-flavored node primitives. One snapshot holds MANY such containers and
    // commits them together — the store no longer generates a per-container
    // Store/Snapshot pair.
    em.push_text("pub struct "); em.push_text(name); em.push_text(" { snap: *mut MemorySnapshot, ctr_id: u64 }\n");
    em.push_text("impl "); em.push_text(name); em.push_text(" {\n");
    // create — register a fresh empty container (a single empty leaf) under
    // `ctr_id` in `snap`, returning its handle.
    em.push_text("    pub static fn create(snap: &mut MemorySnapshot, ctr_id: u64) -> "); em.push_text(name); em.push_text(" {\n");
    em.push_text("        let lf: "); em.push_text(lname); em.push_text(" = "); em.push_text(lname); em.push_text("::new_in(snap.snapshot_id());\n");
    em.push_text("        snap.set_root(ctr_id, lf.block(), 0u32);\n");
    em.push_text("        return "); em.push_text(name); em.push_text(" { snap: snap as *mut MemorySnapshot, ctr_id: ctr_id };\n    }\n");
    // open — a handle to an already-registered container in `snap`.
    em.push_text("    pub static fn open(snap: &mut MemorySnapshot, ctr_id: u64) -> "); em.push_text(name); em.push_text(" {\n");
    em.push_text("        return "); em.push_text(name); em.push_text(" { snap: snap as *mut MemorySnapshot, ctr_id: ctr_id };\n    }\n");
    // insert — CoW path-copy under the snapshot's skip key; repoint the root (and
    // release the old one) when it changed, grow a level on a root split.
    em.push_text("    pub fn insert(self: &"); em.push_text(name); em.push_text(", key: "); em.push_text(kty); em.push_text(", val: "); em.push_text(vty); em.push_text(") {\n");
    em.push_text("        unsafe {\n");
    em.push_text("            let e: DirEntry = (*self.snap).root_of(self.ctr_id);\n");
    em.push_text("            let cur: u64 = (*self.snap).snapshot_id();\n");
    em.push_text("            let r: "); em.push_text(name); em.push_text("CowRet = "); em.push_text(name); em.push_text("_cow_insert(e.root, e.level, key, val, cur);\n");
    em.push_text("            let mut nrt: *mut u8 = e.root;\n            let mut nlv: u32 = e.level;\n");
    em.push_text("            if r.addr != e.root { nrt = r.addr; tree_release(e.root, e.level); }\n");
    em.push_text("            if r.split {\n");
    em.push_text("                let mut top: "); em.push_text(bname); em.push_text(" = "); em.push_text(bname); em.push_text("::new_in(cur);\n");
    em.push_text("                top.push_child(r.lsep, r.lsize, r.addr);\n");
    em.push_text("                top.push_child(r.rsep, r.rsize, r.rptr);\n");
    em.push_text("                nrt = top.block();\n                nlv = e.level + 1u32;\n            }\n");
    em.push_text("            (*self.snap).set_root(self.ctr_id, nrt, nlv);\n        }\n    }\n");
    // get_or — read path via the snapshot's current root for this container.
    if vol {
        em.push_text("    pub fn get_or(self: &"); em.push_text(name); em.push_text(", key: "); em.push_text(kty); em.push_text(") -> &[u8] {\n");
        em.push_text("        unsafe { let e: DirEntry = (*self.snap).root_of(self.ctr_id); return "); em.push_text(name); em.push_text("_descend_get(e.root, e.level, key); }\n    }\n");
    } else {
        em.push_text("    pub fn get_or(self: &"); em.push_text(name); em.push_text(", key: "); em.push_text(kty); em.push_text(", sentinel: "); em.push_text(vty); em.push_text(") -> "); em.push_text(vty); em.push_text(" {\n");
        em.push_text("        unsafe { let e: DirEntry = (*self.snap).root_of(self.ctr_id); return "); em.push_text(name); em.push_text("_descend_get(e.root, e.level, key, sentinel); }\n    }\n");
    }
    em.push_text("    pub fn size(self: &"); em.push_text(name); em.push_text(") -> u64 { return unsafe { "); em.push_text(name); em.push_text("_size(self.snap, self.ctr_id) }; }\n");
    em.push_text("}\n");
    // size — the SUM measure at the container's root (a free fn so the inherent
    // and the Ctr-trait `size` share one body without a self-recursive call).
    em.push_text("fn "); em.push_text(name); em.push_text("_size(snap: *mut MemorySnapshot, ctr_id: u64) -> u64 {\n");
    em.push_text("    unsafe {\n");
    em.push_text("        let e: DirEntry = (*snap).root_of(ctr_id);\n");
    em.push_text("        if e.level == 0u32 { return "); em.push_text(lname); em.push_text("::adopt(e.root).count() as u64; }\n");
    em.push_text("        return "); em.push_text(bname); em.push_text("::adopt(e.root).total_size();\n    }\n}\n");
    em.push_text("impl Ctr for "); em.push_text(name); em.push_text(" {\n");
    em.push_text("    fn size(self: &"); em.push_text(name); em.push_text(") -> u64 { return unsafe { "); em.push_text(name); em.push_text("_size(self.snap, self.ctr_id) }; }\n}\n\n");
    em.commit();
}

/// Lowering handler behind the `container` ITEM (ADR 0020 wave-0). Invoked by
/// the COMPILER (sema lower_container_def) through the token-macro item seam
/// with the serialized spec line. Not a user-facing macro.
#[token_macro]
pub fn __container_item(name: str, spec: str) -> ItemList {
    let out: ItemList = item_list_new();
    if name.len() == 0i64 {
        error("container item: empty container name (compiler seam regression?)");
        return out;
    }
    let facts: Writ = container_facts(name, spec);
    // Shape gate on the fact mirror — a malformed spec (or a fact-builder
    // regression) must fail the COMPILE, not silently drop the declaration.
    let root: WAny = facts.root();
    if root.is_null() || !root.is_map() {
        error("container item: malformed spec (compiler seam regression?)");
        return out;
    }
    let rm: &WMap<WString, WAny> = root.as_map();
    let ca: WAny = rm.get(SEC_CONTAINERS);
    if !ca.is_array() {
        error("container item: fact doc missing its containers row (seam regression?)");
        return out;
    }
    let caa: &WArray<WAny> = ca.as_array();
    if caa.len() != 1i64 {
        error("container item: fact doc missing its containers row (seam regression?)");
        return out;
    }
    let row: WAny = caa.get(0i64);
    if !row.is_map() {
        error("container item: fact doc missing the container kind (seam regression?)");
        return out;
    }
    let rowm: &WMap<WString, WAny> = row.as_map();
    let kv: WAny = rowm.get(K_KIND);
    if !kv.is_string() {
        error("container item: fact doc missing the container kind (seam regression?)");
        return out;
    }

    // ── Canon judges (M3): facts in, verdicts out — the handler never
    // decides. An error row fails the COMPILE with Canon's reason verbatim.
    let verd: Writ = canon_verdicts(&facts);
    let vr: WAny = verd.root();
    if vr.is_null() || !vr.is_map() {
        error("container item: Canon verdict engine failure (logos.lcm.canon.canon)");
        return out;
    }
    let vm: &WMap<WString, WAny> = vr.as_map();
    if cv_report_errors(vm, name) > 0i64 { return out; }

    // ── emission (M4): mechanical, capability-gated. Wave-0 emits the scan
    // projection for kind=vector only; ordered_map stops at verdicts (its
    // substrate is a later track).
    let mut cs: ContainerSpec = container_spec_new();
    if !parse_container_spec(spec, &mut cs) {
        // Unreachable — container_facts gated the same parse above.
        error("container item: malformed spec (compiler seam regression?)");
        return out;
    }
    // kind=node: emit a concrete b+tree leaf, its value-column encoding and
    // split body chosen by Canon's fast|volume verdict — `fast` = all-FSE,
    // count-balanced; `volume` = VLE value column, volume-balanced split.
    if str_eq(cs.kind, KIND_NODE) {
        let policy: str = cv_split_policy(vm, name);
        if policy.len() == 0i64 {
            error("container item: Canon produced no split_policy verdict for a node (Canon seam regression?)");
            return out;
        }
        if !str_eq(policy, SPLIT_FAST) && !str_eq(policy, SPLIT_VOLUME) {
            error("container item: Canon produced an unknown split_policy verdict for a node (Canon/handler vocabulary skew?)");
            return out;
        }
        let ce2: i64 = cs.entry.len();
        let nb0: i64 = cf_next_comma(cs.entry, 0i64, ce2);
        if nb0 == ce2 {
            error("container item: a `kind node` needs two entry columns (`entry { key: K, val: V }`)");
            return out;
        }
        let nb1: i64 = cf_next_comma(cs.entry, nb0 + 1i64, ce2);
        if nb1 != ce2 {
            error("container item: wave-0 `kind node` supports exactly two entry columns (key, val)");
            return out;
        }
        let k1: i64 = cf_find(cs.entry, 0i64, 58u8);            // ':' of key col
        let mut k2: i64 = nb0 - 1i64;
        while k2 > 0i64 && str_byte_at(cs.entry, k2) != 58u8 { k2 = k2 - 1i64; }
        if k1 < 0i64 || k2 <= k1 {
            error("container item: malformed key column (compiler seam regression?)");
            return out;
        }
        let kty: str = unsafe { cf_sub(cs.entry, k1 + 1i64, k2) };
        let v1: i64 = cf_find(cs.entry, nb0 + 1i64, 58u8);      // ':' of val col
        let mut v2: i64 = ce2 - 1i64;
        while v2 > nb0 && str_byte_at(cs.entry, v2) != 58u8 { v2 = v2 - 1i64; }
        if v1 < 0i64 || v2 <= v1 {
            error("container item: malformed val column (compiler seam regression?)");
            return out;
        }
        let vty: str = unsafe { cf_sub(cs.entry, v1 + 1i64, v2) };
        // A standalone storage node is PLAIN pkd (no CoW header) — the header is a
        // property of a versioned map's stack, not a bare `kind node`.
        emit_leaf_node(name, kty, vty, policy, false);
        return out;
    }
    // kind=branch: emit a concrete b+tree BRANCH (routing node). Always
    // count-balanced (all-FSE), so no split_policy verdict — the single `entry
    // { key: K }` column names the separator type; sz/ptr are u64.
    if str_eq(cs.kind, KIND_BRANCH) {
        let ceb: i64 = cs.entry.len();
        let bb0: i64 = cf_next_comma(cs.entry, 0i64, ceb);
        if bb0 != ceb {
            error("container item: a `kind branch` needs exactly one entry column (`entry { key: K }`)");
            return out;
        }
        let bk1: i64 = cf_find(cs.entry, 0i64, 58u8);          // ':' of key col
        let mut bk2: i64 = ceb - 1i64;
        while bk2 > 0i64 && str_byte_at(cs.entry, bk2) != 58u8 { bk2 = bk2 - 1i64; }
        if bk1 < 0i64 || bk2 <= bk1 {
            error("container item: malformed key column (compiler seam regression?)");
            return out;
        }
        let bkty: str = unsafe { cf_sub(cs.entry, bk1 + 1i64, bk2) };
        emit_branch_node(name, bkty, false);   // standalone branch = plain pkd
        return out;
    }
    // kind=ordered_map: realize Canon's container_shape PLAN. Structure is the
    // verdict — the handler only reproduces the node types the plan names,
    // walking its rows (never hardcoding leaf+branch). The tree-assembly and
    // CoW-map aspects are read here but realized in later increments (I2/I3).
    if str_eq(cs.kind, KIND_ORDERED_MAP) {
        // wave-0: only a CONCRETE ordered_map generates its b+tree stack. A
        // generic `Map<K, V>` has unbound column types (and often an undeclared
        // backing) — it stops at verdicts, the same parse/facts/verdicts-only
        // contract as before. The generic-K stack is a later increment (③).
        if cs.generics.len() > 0i64 { return out; }
        // Two entry columns (key, val) — same shape as a kind=node leaf.
        let ce2: i64 = cs.entry.len();
        let nb0: i64 = cf_next_comma(cs.entry, 0i64, ce2);
        if nb0 == ce2 {
            error("container item: a `kind ordered_map` needs two entry columns (`entry { key: K, val: V }`)");
            return out;
        }
        let nb1: i64 = cf_next_comma(cs.entry, nb0 + 1i64, ce2);
        if nb1 != ce2 {
            error("container item: wave-0 `kind ordered_map` supports exactly two entry columns (key, val)");
            return out;
        }
        let k1: i64 = cf_find(cs.entry, 0i64, 58u8);
        let mut k2: i64 = nb0 - 1i64;
        while k2 > 0i64 && str_byte_at(cs.entry, k2) != 58u8 { k2 = k2 - 1i64; }
        if k1 < 0i64 || k2 <= k1 {
            error("container item: malformed key column (compiler seam regression?)");
            return out;
        }
        let kty: str = unsafe { cf_sub(cs.entry, k1 + 1i64, k2) };
        let v1: i64 = cf_find(cs.entry, nb0 + 1i64, 58u8);
        let mut v2: i64 = ce2 - 1i64;
        while v2 > nb0 && str_byte_at(cs.entry, v2) != 58u8 { v2 = v2 - 1i64; }
        if v1 < 0i64 || v2 <= v1 {
            error("container item: malformed val column (compiler seam regression?)");
            return out;
        }
        let vty: str = unsafe { cf_sub(cs.entry, v1 + 1i64, v2) };

        // Walk the plan rows to COLLECT the aspects, then realize them — the node
        // FLAVOR (plain vs CoW-header) depends on the leaf policy AND the
        // versioning aspect, so structure is emitted post-walk (order-independent).
        let sv: WAny = vm.get(V_SHAPE);
        if !sv.is_array() {
            error("container item: Canon produced no container_shape plan for an ordered_map (Canon seam regression?)");
            return out;
        }
        let sa: &WArray<WAny> = sv.as_array();
        let mut saw_leaf: bool = false;
        let mut saw_branch: bool = false;
        let mut saw_tree: bool = false;
        let mut saw_cow: bool = false;
        let mut leaf_fast: bool = false;
        let mut si: i64 = 0i64;
        while si < sa.len() {
            let e: WAny = sa.get(si);
            if e.is_map() {
                let em: &WMap<WString, WAny> = e.as_map();
                let cc: WAny = em.get(K_CTR);
                let asp: WAny = em.get(K_ASPECT);
                if cc.is_string() && asp.is_string() && str_eq(cc.as_wstr(), name) {
                    if str_eq(asp.as_wstr(), ASPECT_NODE) {
                        let role: WAny = em.get(K_ROLE);
                        if role.is_string() && str_eq(role.as_wstr(), ROLE_LEAF) {
                            let pol: WAny = em.get(K_POLICY);
                            let ps: str = if pol.is_string() { pol.as_wstr() } else { SPLIT_FAST };
                            leaf_fast = str_eq(ps, SPLIT_FAST);
                            saw_leaf = true;
                        } else if role.is_string() && str_eq(role.as_wstr(), ROLE_BRANCH) {
                            saw_branch = true;
                        }
                    } else if str_eq(asp.as_wstr(), ASPECT_ASSEMBLY) {
                        let val: WAny = em.get(K_VALUE);
                        if val.is_string() && str_eq(val.as_wstr(), ASM_TREE) { saw_tree = true; }
                    } else if str_eq(asp.as_wstr(), ASPECT_VERSION) {
                        let val: WAny = em.get(K_VALUE);
                        if val.is_string() && str_eq(val.as_wstr(), VER_COW) { saw_cow = true; }
                    }
                }
            }
            si = si + 1i64;
        }
        if !saw_leaf || !saw_branch {
            error("container item: incomplete container_shape plan (leaf or branch node missing — Canon seam regression?)");
            return out;
        }
        // Node flavor is a verdict: versioning=cow ⇒ the nodes carry the CoW node
        // header (snapshot_id + rc, new_in/cow_clone). The FULL tree + CoW-map
        // stack is realized for BOTH leaf policies: a fast (FSE) leaf returns the
        // value by value; a volume (VLE) leaf returns it BY VIEW (&[u8]). The
        // `vol` flavor threads that value-return difference through emit_tree /
        // emit_cow_map (the branch routes by key only — value-agnostic).
        let vol: bool = !leaf_fast;
        let node_cow: bool = saw_cow;
        let leaf_policy: str = if leaf_fast { SPLIT_FAST } else { SPLIT_VOLUME };
        let mut ln: String = String::new(); ln.push_str(name); ln.push_str("Leaf");
        let mut bn: String = String::new(); bn.push_str(name); bn.push_str("Branch");
        emit_leaf_node(ln.as_str(), kty, vty, leaf_policy, node_cow);
        emit_branch_node(bn.as_str(), kty, node_cow);
        // assembly=tree → the multi-level b+tree over {N}Leaf / {N}Branch.
        if saw_tree {
            let mut tt: String = String::new(); tt.push_str(name); tt.push_str("Tree");
            emit_tree(tt.as_str(), ln.as_str(), bn.as_str(), kty, vty, vol);
        }
        // versioning=cow → the CoW snapshot-versioned map ({N}Store/{N}Snapshot/
        // {N}) over the same CoW-flavored nodes. Closes ②: one decl → whole stack.
        if saw_cow {
            emit_cow_map(name, ln.as_str(), bn.as_str(), kty, vty, vol);
        }
        return out;
    }
    if !str_eq(cs.kind, KIND_VECTOR) { return out; }
    if !cv_has_cap(vm, name, "can_scan") {
        error("container item: Canon granted no can_scan capability for a vector container (Canon seam regression?)");
        return out;
    }
    // Canon has already judged wave-0 emission limits (multi-entry vector,
    // unprojectable by_view column) as error rows above — a vector reaching
    // this point has exactly one entry column with a col_proj verdict.
    // Anything else here is a seam regression, not a user error.
    let ce: i64 = cs.entry.len();
    let b0: i64 = cf_next_comma(cs.entry, 0i64, ce);
    if b0 != ce {
        error("container item: multi-entry vector past Canon's verdict (seam regression?)");
        return out;
    }
    let c1: i64 = cf_find(cs.entry, 0i64, 58u8);    // ':'
    let mut c2: i64 = b0 - 1i64;
    while c2 > 0i64 && str_byte_at(cs.entry, c2) != 58u8 { c2 = c2 - 1i64; }
    if c1 < 0i64 || c2 <= c1 {
        error("container item: malformed entry column (compiler seam regression?)");
        return out;
    }
    let col_name: str = unsafe { cf_sub(cs.entry, 0i64, c1) };
    let col_ty: str = unsafe { cf_sub(cs.entry, c1 + 1i64, c2) };
    let col_prm: bool = str_eq(unsafe { cf_sub(cs.entry, c2 + 1i64, b0) }, "1");

    // Column projection = Canon's col_proj verdict, consumed verbatim — the
    // handler holds NO type vocabulary of its own (ADR 0020 §5; the verdict
    // rows are the single source of relty/proj truth).
    let pj: i64 = cv_col_proj(vm, name, col_name);
    if pj == 0i64 {
        error("container item: no col_proj verdict for the entry column (Canon seam regression?)");
        return out;
    }
    let direct: bool = pj == 1i64;
    let relty: str = cv_col_relty(vm, name, col_name);
    if relty.len() == 0i64 {
        error("container item: col_proj verdict missing relty (Canon seam regression?)");
        return out;
    }
    let bound_param: str = if !direct && col_prm { col_ty } else { "" };
    emit_vector_scan(&cs, name, col_name, col_ty, relty, direct, bound_param);
    return out;
}
