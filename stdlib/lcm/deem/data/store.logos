// logos.lcm.deem.data.store — Store + IStore + MutSnapshot.
//
// Store side of the persistent stack: holds the commit DAG, allocates
// monotonic block + snapshot ids, exposes a narrow IStore trait that
// container-side code (handle, mutate) routes through. Mirrors big-
// Memoria's IMemoryStore. v1 backend is in-memory + single-mutex; the
// IStore abstraction lets queue / locking-free / on-disk backends slot
// in later without touching consumers.
//
// Identity model: a commit IS a frozen snapshot. Both share the
// `SnpId<STORE_CFG>` type — store_open seeds the genesis
// commit at id 0; subsequent commits get fresh ids from
// alloc_snapshot_id and live in the dag at that index. Multi-parent
// (merge) commits are NOT yet exposed; the on-disk CommitEntry
// already supports arbitrary parent counts.

package logos.lcm.deem.data.store;

use logos.mem.collections.vec;
use logos.lang.cmp;
use logos.lcm.sync;
use logos.lang.fabric;
use logos.lang.writ.wstatic;
use logos.mem.string;              // String — commit labels + head names (ADR 0017 P2)
use logos.lang.str;

use logos.lcm.deem.data.bt.node;

// ── DAG entry ─────────────────────────────────────────────────────────
// Each commit pins one root NodeARC handle. The root is the directory
// tree root for the Snap; user containers hang off dir leaves
// (vals: NodeARC<STORE_CFG>).
//
// Multi-parent: parents.len() == 0 for the genesis root commit (id 0,
// seeded by store_open), == 1 for the usual fork-and-commit chain,
// ≥ 2 for merge commits.

/// Pins one commit in the store DAG: a frozen directory-tree root plus its DAG edges.
pub struct CommitEntry<const STORE_CFG: WritStatic> {
    /// Holds the pinned directory-tree root NodeARC for this commit.
    pub root:     NodeARC<STORE_CFG>,
    /// Lists the immediate ancestor commit ids; empty for a root/genesis commit.
    pub parents:  Vec<SnpId<STORE_CFG>>,
    /// Lists the commit ids forked directly from this one.
    pub children: Vec<SnpId<STORE_CFG>>,
    /// Marks the entry as tombstoned; when set, `root` is a null-handle NodeARC.
    // Tombstone marker. Released entries keep their dag slot (so
    // children/parents indices stay stable) but `root` is set to a
    // null-handle NodeARC. Block-level reclamation happens automatically
    // via NodeARC rc — blocks unique to this commit drop to rc=0 and
    // free; blocks shared with a sibling/descendant commit retain rc≥1.
    pub released: bool,
    /// Optional human-readable commit label (ADR 0017 P2); empty when unset.
    pub label:    String,
}

// ── IStore trait ──────────────────────────────────────────────────────
// Narrow cross-backend ABI: snapshot lifecycle + commit DAG navigation
// + id allocators. NO type params on methods (would defeat dyn dispatch
// under raw-ptr backends). v1 backend is LockingStore.

/// Narrows the cross-backend store ABI: snapshot lifecycle, DAG navigation, id allocation.
pub trait IStore<const STORE_CFG: WritStatic> {
    /// Allocates a fresh, monotonically increasing snapshot id (never returns 0).
    fn alloc_snapshot_id(self: *mut Self) -> SnpId<STORE_CFG>;
    /// Allocates a fresh, monotonically increasing block id.
    fn alloc_block_id(self:    *mut Self) -> BlockId<STORE_CFG>;

    /// Pins a new commit whose directory-tree root is `root`, chained under `parent`.
    // Pin a new commit whose directory-tree root is `root`. ADOPTS the caller's
    // share by value — the caller transfers ownership (a moved-out local), so no
    // rc bump and no double-drop. `parent` is the immediate ancestor (always
    // valid; genesis is seeded directly by store_open and bypasses this fn). The
    // parent's children list gains the new id.
    fn register_commit(self: *mut Self, root: NodeARC<STORE_CFG>, parent: SnpId<STORE_CFG>) -> SnpId<STORE_CFG>;

    /// Pins a MERGE commit whose directory-tree root is `root`, with an
    /// arbitrary non-empty parent list (ADR 0017 P2). First parent = the
    /// winner whose tree `root` is; the rest record merged-in history.
    fn register_merge_commit(self: *mut Self, root: NodeARC<STORE_CFG>, parents: Vec<SnpId<STORE_CFG>>) -> SnpId<STORE_CFG>;

    /// Returns a `NodeARC` clone of `id`'s pinned root.
    // Return a NodeARC clone of the commit's pinned root. Bumps rc.
    fn checkout(self: *mut Self, id: SnpId<STORE_CFG>) -> NodeARC<STORE_CFG>;

    /// Returns an owned copy of `id`'s parent commit ids.
    // Snapshot the parents/children of `id`. Returned vectors are owned
    // copies — callers can iterate without holding the store lock.
    fn parents_of(self:  *mut Self, id: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>>;
    /// Returns an owned copy of `id`'s child commit ids.
    fn children_of(self: *mut Self, id: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>>;

    /// Returns the total number of commits ever registered in this store.
    // Total number of commits ever registered in this store. Indices
    // [0, commit_count) are valid.
    fn commit_count(self: *mut Self) -> i64;

    /// Returns the ids of all non-released commits with no parent.
    // Root commits — entries with no parent. Allocates a fresh Vec.
    fn roots(self: *mut Self) -> Vec<SnpId<STORE_CFG>>;

    /// Releases commit `id`, dropping its pinned root and reclaiming unshared blocks.
    // Release a commit. Drops the entry's root NodeARC — block-level
    // reclamation cascades through the auto-Drop chain (blocks unique
    // to this commit drop to rc=0 and free; shared blocks retain).
    // The dag slot persists as a tombstone so existing indices stay
    // valid; subsequent checkout/parents_of/children_of on a released
    // id is a precondition violation.
    fn release_snapshot(self: *mut Self, id: SnpId<STORE_CFG>);

    /// Returns whether `id` has been released.
    // True if `id` has been released. Read-only check.
    fn is_released(self: *mut Self, id: SnpId<STORE_CFG>) -> bool;
}

// ── LockingStore — v1 backend ─────────────────────────────────────────
// Vec<CommitEntry<STORE_CFG>> guarded by Mutex. Doesn't actually need
// the mutex for v1 (no concurrent Snap), but it's already there as a
// placeholder for the queue/swmr backends.

/// Implements `IStore` v1: a `Vec<CommitEntry>` DAG guarded by a `Mutex`.
pub struct LockingStore<const STORE_CFG: WritStatic> {
    /// Holds every commit ever registered, indexed by `SnpId`.
    pub dag:              Vec<CommitEntry<STORE_CFG>>,
    /// Guards all DAG reads/writes and id allocation.
    pub lock:             Mutex<i32>,
    /// Tracks the next block id to hand out.
    pub next_block_id:    BlockId<STORE_CFG>,
    /// Tracks the next snapshot id to hand out.
    pub next_snapshot_id: SnpId<STORE_CFG>,
    /// Named heads (ADR 0017 P2): parallel name/commit vectors — a head is a
    /// named moving ref to a commit. Linear scan; head counts stay tiny.
    pub head_names:       Vec<String>,
    pub head_ids:         Vec<SnpId<STORE_CFG>>,
}

// Build a single-element parents Vec inline. Helper fn so the
// return-stmt mark_moved walker fires on the local Vec, transferring
// ownership cleanly into the StructLit init without a double-drop.
fn make_parents_vec<const STORE_CFG: WritStatic>(parent: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>> {
    let mut v: Vec<SnpId<STORE_CFG>> = vec_new::<SnpId<STORE_CFG>>();
    v.push(parent);
    return v;
}

/// Creates an empty `LockingStore` with block/snapshot id counters both at 0.
pub fn locking_store_new<const STORE_CFG: WritStatic>() -> LockingStore<STORE_CFG> {
    return LockingStore::<STORE_CFG> {
        dag:              vec_new::<CommitEntry<STORE_CFG>>(),
        lock:             mutex_new::<i32>(0i32),
        next_block_id:    0u64,
        next_snapshot_id: 0u64,
        head_names:       vec_new::<String>(),
        head_ids:         vec_new::<SnpId<STORE_CFG>>(),
    };
}

impl<const STORE_CFG: WritStatic> IStore<STORE_CFG> for LockingStore<STORE_CFG> {
    fn alloc_snapshot_id(self: *mut LockingStore<STORE_CFG>) -> SnpId<STORE_CFG> {
        unsafe {
            self.lock.lock();
            self.next_snapshot_id = self.next_snapshot_id + 1u64;
            let id: SnpId<STORE_CFG> = self.next_snapshot_id;
            self.lock.unlock();
            return id;
        }
    }
    fn alloc_block_id(self: *mut LockingStore<STORE_CFG>) -> BlockId<STORE_CFG> {
        unsafe {
            self.lock.lock();
            self.next_block_id = self.next_block_id + 1u64;
            let id: BlockId<STORE_CFG> = self.next_block_id;
            self.lock.unlock();
            return id;
        }
    }
    fn register_commit(self: *mut LockingStore<STORE_CFG>, root: NodeARC<STORE_CFG>, parent: SnpId<STORE_CFG>) -> SnpId<STORE_CFG> {
        unsafe {
            self.lock.lock();
            let id: SnpId<STORE_CFG> = self.dag.len() as SnpId<STORE_CFG>;
            // Update parent's children index before we push the new
            // entry — the lock window covers both mutations atomically.
            // borrow_mut is bounds-checked (panics on a bad parent id) — never
            // the unchecked `at` (OOB → wild write). parent is store-internal
            // and always valid, but uniform bounds-checking costs nothing.
            let parent_entry: &mut CommitEntry<STORE_CFG> = self.dag.borrow_mut(parent as i64);
            parent_entry.children.push(id);
            // Move the caller-transferred share into the entry's `root` field.
            self.dag.push(CommitEntry::<STORE_CFG> {
                root:     root,
                parents:  make_parents_vec::<STORE_CFG>(parent),
                children: vec_new::<SnpId<STORE_CFG>>(),
                released: false,
                label:    String::new(),
            });
            self.lock.unlock();
            return id;
        }
    }
    fn register_merge_commit(self: *mut LockingStore<STORE_CFG>, root: NodeARC<STORE_CFG>, parents: Vec<SnpId<STORE_CFG>>) -> SnpId<STORE_CFG> {
        unsafe {
            self.lock.lock();
            let id: SnpId<STORE_CFG> = self.dag.len() as SnpId<STORE_CFG>;
            let np: i64 = parents.len();
            let mut i: i64 = 0i64;
            while i < np {
                let p: SnpId<STORE_CFG> = parents.get(i);
                let pe: &mut CommitEntry<STORE_CFG> = self.dag.borrow_mut(p as i64);
                pe.children.push(id);
                i = i + 1i64;
            }
            self.dag.push(CommitEntry::<STORE_CFG> {
                root:     root,
                parents:  parents,
                children: vec_new::<SnpId<STORE_CFG>>(),
                released: false,
                label:    String::new(),
            });
            self.lock.unlock();
            return id;
        }
    }
    fn checkout(self: *mut LockingStore<STORE_CFG>, id: SnpId<STORE_CFG>) -> NodeARC<STORE_CFG> {
        unsafe {
            self.lock.lock();
            let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(id as i64);
            let cloned: NodeARC<STORE_CFG> = entry.root.clone();
            self.lock.unlock();
            return cloned;
        }
    }
    fn parents_of(self: *mut LockingStore<STORE_CFG>, id: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>> {
        unsafe {
            self.lock.lock();
            let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(id as i64);
            let mut out: Vec<SnpId<STORE_CFG>> = vec_new::<SnpId<STORE_CFG>>();
            let n: i64 = entry.parents.len();
            let mut i: i64 = 0i64;
            while i < n {
                out.push(entry.parents.get(i));
                i = i + 1i64;
            }
            self.lock.unlock();
            return out;
        }
    }
    fn children_of(self: *mut LockingStore<STORE_CFG>, id: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>> {
        unsafe {
            self.lock.lock();
            let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(id as i64);
            let mut out: Vec<SnpId<STORE_CFG>> = vec_new::<SnpId<STORE_CFG>>();
            let n: i64 = entry.children.len();
            let mut i: i64 = 0i64;
            while i < n {
                out.push(entry.children.get(i));
                i = i + 1i64;
            }
            self.lock.unlock();
            return out;
        }
    }
    fn commit_count(self: *mut LockingStore<STORE_CFG>) -> i64 {
        unsafe {
            self.lock.lock();
            let n: i64 = self.dag.len();
            self.lock.unlock();
            return n;
        }
    }
    fn roots(self: *mut LockingStore<STORE_CFG>) -> Vec<SnpId<STORE_CFG>> {
        unsafe {
            self.lock.lock();
            let mut out: Vec<SnpId<STORE_CFG>> = vec_new::<SnpId<STORE_CFG>>();
            let n: i64 = self.dag.len();
            let mut i: i64 = 0i64;
            while i < n {
                let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(i);
                if entry.parents.len() == 0i64 && !entry.released {
                    out.push(i as SnpId<STORE_CFG>);
                }
                i = i + 1i64;
            }
            self.lock.unlock();
            return out;
        }
    }

    fn release_snapshot(self: *mut LockingStore<STORE_CFG>, id: SnpId<STORE_CFG>) {
        unsafe {
            self.lock.lock();
            // borrow_mut: bounds-checked (panics on OOB id) — was the unchecked
            // `at`, which on a bad id did a wild out-of-bounds write (UB).
            let entry: &mut CommitEntry<STORE_CFG> = self.dag.borrow_mut(id as i64);
            if !entry.released {
                // Drop the entry's root share in place (atomic rc-- → recursive
                // auto-Drop chain), leaving a null/moved-from handle so the
                // entry's own later drop is a no-op on it.
                arc_release_in_slot::<STORE_CFG>(
                    &mut entry.root as *mut NodeARC<STORE_CFG>);
                entry.released = true;
            }
            self.lock.unlock();
        }
    }

    fn is_released(self: *mut LockingStore<STORE_CFG>, id: SnpId<STORE_CFG>) -> bool {
        unsafe {
            self.lock.lock();
            let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(id as i64);
            let r: bool = entry.released;
            self.lock.unlock();
            return r;
        }
    }
}

// ── MutSnapshot — single-thread mutable handle ────────────────────────
// Owns one rc on `root`. Carries snapshot_id + id_ctr_p so the CoW
// protocol (make_unique) can stamp + alloc fresh ids without going
// through Store on the per-mutation hot path.

/// Holds a single-thread mutable handle onto one forked-off commit, pre-`commit`.
pub struct MutSnapshot<const STORE_CFG: WritStatic> {
    /// Owns one rc share of the directory-tree root being mutated.
    pub root:        NodeARC<STORE_CFG>,
    /// Identifies the commit this snapshot forked from.
    pub parent_id:   SnpId<STORE_CFG>,
    /// Identifies this snapshot for the CoW protocol; stamped onto mutated nodes.
    pub snapshot_id: SnpId<STORE_CFG>,
    /// Points at the store's block-id counter, letting CoW allocate ids without a store round-trip.
    pub id_ctr_p:    *mut BlockId<STORE_CFG>,  // points at LockingStore.next_block_id
}
