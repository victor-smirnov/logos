// logos.std.deem — FactHistory: the history / branch-merge decorator over the
// mem-tier FactStore (ADR 0017 / ADR 0015 §4–5). Split out of incr.logos as a
// separate file (same package — private items are package-visible) so the
// Memoria-backed epoch history can later seat in the lcm tier while the core
// FactStore lives in mem. See deem.logos for the module-level doc.
package logos.lcm.deem;


use logos.lang.writ.container;    // Writ / writ_new
use logos.lang.writ.anyval;       // WAny
use logos.lang.writ.wmap;         // WMap<Wu6, WAny> — TOM reads (schema field gets)
use logos.lang.writ.array;        // WArray — edge-field iteration
use logos.lang.writ.wstring;      // WString / as_wstr — string payloads + interning
use logos.lang.writ.wstatic;      // WritStatic — the rodata metadata-blob handle
use logos.lang.writ.static_view;  // WView2 — reader over rodata Writ blobs
use logos.lang.result;            // Result — the error-as-value carrier
use logos.lang.option;            // Option — HashMapKeys iterator item (SEMILATTICE rescan)
use logos.lang.panic;             // panic — recursive-aggregate convergence guard (slice-7)
use logos.mem.string;             // String
use logos.lang.mem;               // replace — FactStore::take_delta move-out
use logos.lang.cmp;               // DView ordering (container key compare)
use logos.lang.fabric;            // NodeARC plumbing (data layer)
use logos.lang.drop;              // container-handle drops (data layer)
use logos.lang.writ.dview;        // DView — the container's runtime-typed cells
use logos.mem.deem;                // FactStore + FsKey/consts/encoders + SchemaCatalog (mem core)
use logos.lcm.deem.data.bt.node;  // storage engine (ADR 0017): epoch-history layer
use logos.lcm.deem.data.bt.cow;
use logos.lcm.deem.data.store;
use logos.lcm.deem.data.handle;
use logos.lang.num.float;         // f64_to_bits — FsKey f64 content-hash
use logos.lang.str;               // str_eq / str_cmp / str_contains / str_starts_with / …
use logos.lang.arith;             // wrapping_mul — the FNV mix wraps by design
use logos.std.wql.ir;             // SExpr family + WRef (the shared IR)
use logos.std.wql.el;             // EL_TY_* / OP_* / builtin registry / agg rule table
use logos.std.wql.optimize;       // simplify_sexpr / simplify_rexpr_ref + TermList analysis
use logos.std.wql.trama;          // TStmt family + chain_array / next_of_stmt / ttext_str
use logos.std.wql.trama_parser;   // parse_tpl — the reused generated template parser
use logos.std.wql.plan;           // RQuery / RQProgram — the surface query plan views
use logos.std.wql.wql_surface_parser;  // parse_program — the reused generated query parser
use logos.std.wql.lower;          // lower_rquery_to_rexpr — the reused PLAN→ALGEBRA lowering
use logos.std.wql.params;         // RelDeps / RelScc / compute_rel_scc — the SHARED
                                  // (metaprog-free) rel dependency-graph half (I3)
use logos.mem.collections.vec;    // Vec — row pipelines (unbounded)
use logos.mem.collections.hashmap;// HashMap — hash-join buckets / distinct sets


// ── FactHistory (ADR 0017 / ADR 0015 §4–5): the lcm-tier history + branch/merge
// decorator over a mem-tier FactStore. OWNS the core live set (composition) and
// adds the Memoria-backed epoch history (`hist`), the journal, and S4 fork/merge
// bookkeeping. insert/retract/take_delta mirror the core names but also record
// the ±slot op and (on take_delta) commit the epoch — history callers hold a
// FactHistory; the engine drivers pump the inner core's drain-only delta.
pub struct FactHistory {
    store:   FactStore,          // the mem-tier live set (node/key/present/idx/pend)
    epend:   Vec<i64>,           // this epoch's ±slot log (slot ≥ 0 insert, −slot−1 retract)
    hist:    Store<FsStoreCfg>,  // the data store (ADR 0017): epoch history
    heads:   Vec<u64>,           // commit id per epoch (heads[e] = epoch e's SET)
    jseq:    u64,                // next journal row key (== journal row count)
    br_on:   bool,               // a branch is recording
    br_pnm:  String,             // active branch's name
    br_log:  Vec<i64>,           // active branch's ±slot ops
    br_name: Vec<String>,        // ended branches: names
    br_head: Vec<u64>,           //   their epoch-head commits
    br_ops:  Vec<i64>,           //   retained logs (flat pool)
    br_off:  Vec<i64>,           //   per-branch offset into br_ops
    br_cnt:  Vec<i64>,           //   per-branch op count
    mg_win:  Vec<String>,        // merges: winner branch name
    mg_cid:  Vec<u64>,           //   merge commit id in the history DAG
    mg_lsr:  Vec<String>,        //   loser names (flat pool)
    mg_loff: Vec<i64>,           //   per-merge offset into mg_lsr
    mg_lcnt: Vec<i64>,           //   per-merge loser count
}

impl FactHistory {
    pub fn new(cat: &SchemaCatalog, sname: str, keyf: &[str], seg: i64)
        -> Result<FactHistory, str> {
        let store: FactStore = match FactStore::new(cat, sname, keyf, seg) {
            Result::Ok(o)  => { o }
            Result::Err(e) => { return Result::Err(e); }
        };
        return Result::Ok(FactHistory {
            store:   store,
            epend:   vec_new::<i64>(),
            hist:    store_open::<FsStoreCfg>(),
            heads:   vec_new::<u64>(),
            jseq:    0u64,
            br_on:   false,
            br_pnm:  String::new(),
            br_log:  vec_new::<i64>(),
            br_name: vec_new::<String>(),
            br_head: vec_new::<u64>(),
            br_ops:  vec_new::<i64>(),
            br_off:  vec_new::<i64>(),
            br_cnt:  vec_new::<i64>(),
            mg_win:  vec_new::<String>(),
            mg_cid:  vec_new::<u64>(),
            mg_lsr:  vec_new::<String>(),
            mg_loff: vec_new::<i64>(),
            mg_lcnt: vec_new::<i64>(),
        });
    }

    // ── core delegators (node-building + engine-cmp read the inner store) ──
    pub fn arena(self: &FactHistory) -> &Writ { return self.store.arena(); }
    pub fn arena_ptr(self: &FactHistory) -> *const Writ { return self.store.arena_ptr(); }
    pub fn build_present(self: &FactHistory) -> WAny { return self.store.build_present(); }
    pub fn count(self: &FactHistory) -> i64 { return self.store.count(); }
    pub fn store_ref(self: &FactHistory) -> &FactStore { return &self.store; }

    // insert/retract mirror the core names and additionally record the ±slot op.
    pub fn insert(self: &mut FactHistory, node: WAny) {
        let s: i64 = self.store.insert(node);
        if s >= 0i64 { self.record_op(s, true); }
    }
    pub fn retract(self: &mut FactHistory, node: WAny) {
        let s: i64 = self.store.retract(node);
        if s >= 0i64 { self.record_op(s, false); }
    }
    // take_delta commits this epoch to the history store, then drains the core.
    pub fn take_delta(self: &mut FactHistory) -> ZBatch {
        self.epoch_commit();
        return self.store.take_delta();
    }

    // Log one effective op: slot for an insert, −slot−1 for a retract.
    fn record_op(self: &mut FactHistory, slot: i64, is_insert: bool) {
        let op: i64 = if is_insert { slot } else { 0i64 - slot - 1i64 };
        self.epend.push(op);
        if self.br_on { self.br_log.push(op); }
    }

    // Flush this epoch's ±slot log to the history store: fork the parent
    // snapshot, apply the ops to the fact container + journal, commit, and
    // record the new head. Lifts to the lcm history decorator (Memoria-backed);
    // the mem core keeps only the live set and calls this as a no-op seam.
    fn epoch_commit(self: &mut FactHistory) {
        // ── epoch boundary (ADR 0017 P1): apply this epoch's ±slot log to the
        // history container in ONE scoped fork→apply→commit cycle. epoch =
        // commit: heads[e] names epoch e's SET in the snapshot DAG. Applying
        // in order makes the last op per slot win (same-epoch insert+retract
        // nets out exactly like the hot set).
        {
            let parent: u64 = if self.heads.len() == 0i64 { GENESIS }
                              else { self.heads.get(self.heads.len() - 1i64) };
            let mut snap = self.hist.fork(parent);
            {
                let mut cr = if self.heads.len() == 0i64 {
                    create_ctr::<FsCtrCfg>(&mut snap, FS_CTR_ID)
                } else {
                    match open_ctr::<FsCtrCfg>(&mut snap, FS_CTR_ID) {
                        Option::Some(c) => { c }
                        Option::None    => { create_ctr::<FsCtrCfg>(&mut snap, FS_CTR_ID) }
                    }
                };
                let ne: i64 = self.epend.len();
                let mut i: i64 = 0i64;
                while i < ne {
                    let op: i64 = self.epend.get(i);
                    let slot: i64 = if op >= 0i64 { op } else { 0i64 - op - 1i64 };
                    let mut kb: String = String::new();
                    fs_key_enc(self.store.key.borrow(slot), &mut kb);
                    if op >= 0i64 {
                        let sv: u64 = slot as u64;
                        cr.insert(DView::from_str(kb.as_str()), DView::from(&sv));
                    } else {
                        cr.remove(DView::from_str(kb.as_str()));
                    }
                    i = i + 1i64;
                }
            }
            // ── journal (P3): one row per effective op, in op order, same snap ──
            {
                let mut jr = if self.heads.len() == 0i64 {
                    create_ctr::<FsJnCfg>(&mut snap, FS_JN_ID)
                } else {
                    match open_ctr::<FsJnCfg>(&mut snap, FS_JN_ID) {
                        Option::Some(c) => { c }
                        Option::None    => { create_ctr::<FsJnCfg>(&mut snap, FS_JN_ID) }
                    }
                };
                let epoch: u64 = self.heads.len() as u64;
                let si: i64 = self.store.cat.sidx_of_name(self.store.sname);
                let ne: i64 = self.epend.len();
                let mut i: i64 = 0i64;
                while i < ne {
                    let op: i64 = self.epend.get(i);
                    let slot: i64 = if op >= 0i64 { op } else { 0i64 - op - 1i64 };
                    let mut rb: String = String::new();
                    fs_jn_row_enc(&self.store.cat, si, self.store.node.get(slot), epoch, op >= 0i64, &mut rb);
                    let sq: u64 = self.jseq;
                    self.jseq = self.jseq + 1u64;
                    jr.insert(sq, DView::from_str(rb.as_str()));
                    i = i + 1i64;
                }
            }
            self.heads.push(snap.commit());
            self.epend.clear();
        }
    }

    // ── epoch-history reads (ADR 0017 P1) ───────────────────────────────
    /// Number of committed epochs.
    pub fn epoch_count(self: &FactHistory) -> i64 { return self.heads.len(); }

    /// The commit id naming epoch `e`'s SET in the history store's DAG —
    /// the fork point for S4 (P2).
    pub fn epoch_head(self: &FactHistory, e: i64) -> u64 { return self.heads.get(e); }

    /// Number of facts present at committed epoch `e`.
    pub fn count_at(self: &mut FactHistory, e: i64) -> i64 {
        let head: u64 = self.heads.get(e);
        let mut snap = self.hist.fork(head);
        let mut n: i64 = 0i64;
        {
            match open_ctr::<FsCtrCfg>(&mut snap, FS_CTR_ID) {
                Option::Some(cr) => { n = cr.len() as i64; }
                Option::None     => { n = 0i64; }
            }
        }
        // read-only fork: dropped, not committed (no DAG node per read)
        return n;
    }

    /// Was the fact with `node`'s content present at committed epoch `e`?
    pub fn contains_at(self: &mut FactHistory, e: i64, node: WAny) -> bool {
        let k: Vec<FsKey> = self.store.key_of(node);
        let mut kb: String = String::new();
        fs_key_enc(&k, &mut kb);
        let head: u64 = self.heads.get(e);
        let mut snap = self.hist.fork(head);
        let mut hit: bool = false;
        {
            match open_ctr::<FsCtrCfg>(&mut snap, FS_CTR_ID) {
                Option::Some(cr) => { hit = cr.contains(DView::from_str(kb.as_str())); }
                Option::None     => { hit = false; }
            }
        }
        return hit;
    }

    // ── S4 v0 fork/merge (ADR 0015 §5 select_one; ADR 0017 P2) ──────────

    // Apply a ±slot op to the live set — the rollback / re-apply primitive.
    // Mirrors insert()'s re-insert path and retract() (presence + ZBatch +
    // epoch log), WITHOUT branch recording: callers run with br_on == false.
    fn apply_slot_op(self: &mut FactHistory, op: i64) {
        let slot: i64 = if op >= 0i64 { op } else { 0i64 - op - 1i64 };
        if op >= 0i64 {
            if !self.store.present.get(slot) {
                self.store.present.set(slot, true);
                let cn: WAny = self.store.node.get(slot);
                self.store.pend.push(cn, 1i64);
                self.epend.push(slot);
            }
        } else {
            if self.store.present.get(slot) {
                self.store.present.set(slot, false);
                let cn: WAny = self.store.node.get(slot);
                self.store.pend.push(cn, -1i64);
                self.epend.push(0i64 - slot - 1i64);
            }
        }
    }

    /// Begins recording an assumption branch. Precondition: no branch active
    /// and a clean epoch boundary (take_delta consumed).
    pub fn branch_begin(self: &mut FactHistory, name: str) {
        if self.br_on { panic("FactStore::branch_begin: a branch is already active"); }
        if self.epend.len() != 0i64 { panic("FactStore::branch_begin: pending epoch ops — take_delta first"); }
        let mut nm: String = String::new();
        nm.push_str(name);
        self.br_pnm = nm;
        self.br_on = true;
    }

    /// Ends the active branch: captures its head (the last committed epoch),
    /// retains its log for select_one, and rolls the live set back with the
    /// INVERSE ops. The caller feeds the rollback delta to the engine via the
    /// usual take_delta()/epoch() cycle.
    pub fn branch_end(self: &mut FactHistory) {
        if !self.br_on { panic("FactStore::branch_end: no active branch"); }
        if self.epend.len() != 0i64 { panic("FactStore::branch_end: pending epoch ops — take_delta first"); }
        self.br_on = false;
        let mut nm: String = String::new();
        nm.push_str(self.br_pnm.as_str());
        self.br_name.push(nm);
        let bh: u64 = if self.heads.len() == 0i64 { 0u64 }
                      else { self.heads.get(self.heads.len() - 1i64) };
        self.br_head.push(bh);
        self.br_off.push(self.br_ops.len());
        self.br_cnt.push(self.br_log.len());
        let n: i64 = self.br_log.len();
        let mut i: i64 = 0i64;
        while i < n { self.br_ops.push(self.br_log.get(i)); i = i + 1i64; }
        // Roll back: inverse ops in reverse order (op negation `−op−1` is the
        // involution slot s ↔ −s−1, i.e. insert ↔ retract of the same slot).
        let mut j: i64 = n - 1i64;
        while j >= 0i64 {
            let op: i64 = self.br_log.get(j);
            self.apply_slot_op(0i64 - op - 1i64);
            j = j - 1i64;
        }
        self.br_log.clear();
    }

    /// Resolves the ended-branch set by select_one: re-applies the winner's
    /// ops to the live set, registers a MERGE commit (winner's head = first
    /// parent, each loser's head = extra parent) in the history DAG, RELEASES
    /// the losers' head commits, records the merge for querying, and clears
    /// the branch set. Returns the merge commit id. The caller feeds the
    /// re-apply delta to the engine via take_delta()/epoch().
    pub fn select_one(self: &mut FactHistory, winner: str) -> u64 {
        if self.br_on { panic("FactStore::select_one: end the active branch first"); }
        if self.epend.len() != 0i64 { panic("FactStore::select_one: pending epoch ops — take_delta first"); }
        let nb: i64 = self.br_name.len();
        let mut w: i64 = 0i64 - 1i64;
        {
            let mut i: i64 = 0i64;
            while i < nb {
                if str_eq(self.br_name.borrow(i).as_str(), winner) { w = i; }
                i = i + 1i64;
            }
        }
        if w < 0i64 { panic("FactStore::select_one: unknown branch"); }
        // Re-apply the winner's ops (forward order).
        let off: i64 = self.br_off.get(w);
        let cnt: i64 = self.br_cnt.get(w);
        let mut k: i64 = 0i64;
        while k < cnt { self.apply_slot_op(self.br_ops.get(off + k)); k = k + 1i64; }
        // Merge commit: winner first, losers extra parents (skipping losers
        // whose head coincides with the winner's — an op-less branch).
        let wh: u64 = self.br_head.get(w);
        let mut losers: Vec<u64> = vec_new::<u64>();
        {
            let mut i: i64 = 0i64;
            while i < nb {
                if i != w {
                    let lh: u64 = self.br_head.get(i);
                    if lh != wh { losers.push(lh); }
                }
                i = i + 1i64;
            }
        }
        let mc: u64 = self.hist.merge(wh, &losers);
        {
            let nl: i64 = losers.len();
            let mut i: i64 = 0i64;
            while i < nl { self.hist.release(losers.get(i)); i = i + 1i64; }
        }
        // Record the merge (queryable: merge_count / merge_winner / …).
        {
            let mut nm: String = String::new();
            nm.push_str(winner);
            self.mg_win.push(nm);
            self.mg_cid.push(mc);
            self.mg_loff.push(self.mg_lsr.len());
            self.mg_lcnt.push(nb - 1i64);
            let mut i: i64 = 0i64;
            while i < nb {
                if i != w {
                    let mut ln: String = String::new();
                    ln.push_str(self.br_name.borrow(i).as_str());
                    self.mg_lsr.push(ln);
                }
                i = i + 1i64;
            }
        }
        self.br_name.clear();
        self.br_head.clear();
        self.br_ops.clear();
        self.br_off.clear();
        self.br_cnt.clear();
        return mc;
    }

    // ── branch/merge history reads ──
    /// Number of ended, not-yet-resolved branches.
    pub fn branch_count(self: &FactHistory) -> i64 { return self.br_name.len(); }
    /// Name of ended branch `i` (owned copy).
    pub fn branch_name(self: &FactHistory, i: i64) -> String {
        let mut out: String = String::new();
        out.push_str(self.br_name.borrow(i).as_str());
        return out;
    }
    /// Head commit of ended branch `i`.
    pub fn branch_head(self: &FactHistory, i: i64) -> u64 { return self.br_head.get(i); }
    /// Number of resolved merges.
    pub fn merge_count(self: &FactHistory) -> i64 { return self.mg_win.len(); }
    /// Winner branch name of merge `i` (owned copy).
    pub fn merge_winner(self: &FactHistory, i: i64) -> String {
        let mut out: String = String::new();
        out.push_str(self.mg_win.borrow(i).as_str());
        return out;
    }
    /// The history-DAG commit id of merge `i`.
    pub fn merge_commit(self: &FactHistory, i: i64) -> u64 { return self.mg_cid.get(i); }
    /// Number of losers of merge `i`.
    pub fn merge_loser_count(self: &FactHistory, i: i64) -> i64 { return self.mg_lcnt.get(i); }
    /// Name of loser `j` of merge `i` (owned copy).
    pub fn merge_loser(self: &FactHistory, i: i64, j: i64) -> String {
        let mut out: String = String::new();
        out.push_str(self.mg_lsr.borrow(self.mg_loff.get(i) + j).as_str());
        return out;
    }
    /// Parent commits of a history-DAG commit (e.g. a merge's [winner, losers…]).
    pub fn hist_parents_of(self: &mut FactHistory, id: u64) -> Vec<u64> {
        return self.hist.parents_of(id);
    }
    /// Whether a history-DAG commit has been released (losers are, post-merge).
    pub fn hist_is_released(self: &mut FactHistory, id: u64) -> bool {
        return self.hist.is_released(id);
    }

    /// Number of journal rows written so far.
    pub fn journal_rows(self: &FactHistory) -> i64 { return self.jseq as i64; }

    /// Rebuilds a FRESH FactStore by replaying this store's journal container
    /// (ADR 0017 P3 gate; the ADR 0015 §4 replay law at the EDB tier): rows are
    /// applied in sequence order, epoch boundaries are reproduced (take_delta
    /// at each epoch change), and each fact is RECONSTRUCTED from its journaled
    /// field tuple in the fresh store's own arena. v0 fidelity: scalar-field
    /// relations (non-scalar fields journal as a lossy marker). The replayed
    /// store re-derives its own epoch history and journal as it goes.
    pub fn replay_fresh(self: &mut FactHistory, seg: i64) -> Result<FactHistory, str> {
        let mut out: FactHistory = match FactHistory::new(&self.store.cat, self.store.sname,
                                                      self.store.keyf.as_slice(), seg) {
            Result::Ok(o)  => { o }
            Result::Err(e) => { return Result::Err(e); }
        };
        if self.heads.len() == 0i64 { return Result::Ok(out); }
        self.replay_rows_into(&mut out);
        let _last: ZBatch = out.take_delta();   // commit the final epoch
        return Result::Ok(out);
    }

    // The journal scan + fact reconstruction of replay_fresh (split out so
    // `out` has a single move-out point in the public fn).
    fn replay_rows_into(self: &mut FactHistory, out: &mut FactHistory) {
        // &mut is affine — thread a raw pointer so per-iteration method calls
        // don't consume the reference (the pend-pointer idiom of take_delta).
        let outp: *mut FactHistory = out;
        let si: i64 = self.store.cat.sidx_of_name(self.store.sname);
        let code: u64 = self.store.cat.s_codes.get(si);
        // Count the schema's fields once (TOM capacity + decode loop bound).
        let mut nf: i64 = 0i64;
        {
            let mut fi: i64 = 0i64;
            while fi < self.store.cat.f_n {
                if self.store.cat.f_owner.get(fi) == si { nf = nf + 1i64; }
                fi = fi + 1i64;
            }
        }
        let head: u64 = self.heads.get(self.heads.len() - 1i64);
        let mut snap = self.hist.fork(head);
        {
            let jr = match open_ctr::<FsJnCfg>(&mut snap, FS_JN_ID) {
                Option::Some(c) => { c }
                Option::None    => { return; }   // no journal yet
            };
            let od: &Writ = unsafe { &*(&*outp).arena_ptr() };
            let mut cur_ep: u64 = 0u64;
            let mut it = jr.iter();
            while it.valid() {
                let rv: DView = it.val();
                let bytes: str = rv.as_str();
                let epoch: u64 = fs_rd_u64(bytes, 0i64);
                if epoch != cur_ep {
                    let _d: ZBatch = unsafe { (&mut *outp).take_delta() };   // epoch boundary
                    cur_ep = epoch;
                }
                let positive: bool = str_byte_at(bytes, 8i64) == 1u8;
                // Reconstruct the fact from the journaled field tuple.
                let mp: *const WMap<Wu6, WAny> = od.make_schema(nf, code);
                let m: &mut WMap<Wu6, WAny> = unsafe { &mut *(mp as *mut WMap<Wu6, WAny>) };
                let mut at: i64 = 9i64;
                let mut fi: i64 = 0i64;
                while fi < self.store.cat.f_n {
                    if self.store.cat.f_owner.get(fi) == si {
                        let kc: u8 = self.store.cat.f_keys.get(fi) as u8;
                        let tag: u8 = str_byte_at(bytes, at);
                        at = at + 1i64;
                        if tag == 1u8 {
                            m.set(kc, od.int(fs_rd_u64(bytes, at) as i64));
                            at = at + 8i64;
                        } else if tag == 2u8 {
                            m.set(kc, od.float(f64_from_bits(fs_rd_u64(bytes, at))));
                            at = at + 8i64;
                        } else if tag == 3u8 {
                            m.set(kc, WAny::from(str_byte_at(bytes, at) == 1u8));
                            at = at + 1i64;
                        } else if tag == 4u8 {
                            let mut l: u64 = 0u64;
                            let mut k: i64 = 0i64;
                            while k < 4i64 { l = (l << 8u64) | (str_byte_at(bytes, at + k) as u64); k = k + 1i64; }
                            at = at + 4i64;
                            let sv: str = unsafe {
                                str_from_raw(((bytes.as_ptr() as i64) + at) as *const u8, l as i64)
                            };
                            let ws: &WString = od.wstring(sv);
                            m.set(kc, WAny::ref_to((ws as *const WString) as *const u8));
                            at = at + (l as i64);
                        }
                        // tags 0 (null) and 5 (non-scalar, lossy) carry no payload
                    }
                    fi = fi + 1i64;
                }
                let w: WAny = WAny::ref_to(mp as *const u8);
                if positive { unsafe { (&mut *outp).insert(w); } }
                else        { unsafe { (&mut *outp).retract(w); } }
                it.step();
            }
        }
    }
}
