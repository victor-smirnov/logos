// Logos standard library — logos.lcm.io.write
//
// Abstraction for byte-oriented output sinks.
//
// Return-value convention (shared with Read):
//   n >  0  : number of bytes written
//   n == 0  : sink refused further bytes (treat as error)
//   n <  0  : -errno

package logos.lcm.io.write;

/// A byte-oriented output sink.
///
/// `write`/`flush` follow the shared Read/Write convention: positive = byte
/// count, zero = sink refused further bytes (treat as error), negative = `-errno`.
pub trait Write {
    /// Writes up to `len` bytes from `buf`, returning bytes written or `-errno`.
    fn write(self: &mut Self, buf: *const u8, len: i64) -> i64;
    /// Flushes any buffered output, returning `0` on success or `-errno`.
    fn flush(self: &mut Self) -> i64;
}

// Memory layout matches `struct iovec` on Linux (ptr, len) so an
// array of these can be passed directly to writev(2)/readv(2) and the
// io_uring writev/readv ops.
/// A borrowed `(pointer, length)` buffer slice for vectored I/O.
pub struct IoSlice {
    /// Pointer to the first byte of the slice.
    pub base: *const u8,
    /// Number of bytes in the slice.
    pub len:  i64,
}

/// Builds an `IoSlice` from a raw pointer and length.
pub fn io_slice(ptr: *const u8, len: i64) -> IoSlice {
    return IoSlice { base: ptr, len: len };
}

/// Writes all `len` bytes from `buf`, looping over partial writes.
/// Returns `0` on success, or the negative errno from the first failing write.
pub fn write_all<W: Write>(w: &mut W, buf: *const u8, len: i64) -> i64 {
    let mut total: i64 = 0;
    while total < len {
        let n: i64 = w.write(unsafe { buf.byte_add(total) }, len - total);
        if n <= 0 { return n; }
        total = total + n;
    }
    return 0;
}
