// Logos standard library — logos.lcm.sync
//
// Cross-thread synchronisation primitives backed by POSIX:
//   Mutex<T: Send>            — exclusive lock wrapping pthread_mutex_t
//   RwLock<T: Send + Sync>    — reader/writer lock wrapping pthread_rwlock_t
//
// Usage (Rust's RAII guard surface):
//
//   let m: Mutex<i32> = Mutex::new(0);
//   { let mut g = m.lock().unwrap(); *g = *g + 1; }   // unlocked when `g` drops
//
// The raw form (`lock_raw` / `unlock`, `read_lock` / `write_lock`) stays for code
// that manages the lock by hand.
//
// pthread_mutex_t is 40 bytes on Linux x86-64 (alignment 8).
// pthread_rwlock_t is 56 bytes on Linux x86-64 (alignment 8).
// Both are stored as a heap-allocated byte block inside the struct.

package logos.lcm.sync;

use logos.lang.mem;
use logos.lang.marker;
use logos.lang.option;
use logos.lang.cell;
use logos.lang.ops;
use logos.lang.result;
use logos.lang.drop;

// ── POSIX externals ──────────────────────────────────────────────────────────

extern fn pthread_mutex_init(mutex: *mut u8, attr: *const u8) -> i32;
extern fn pthread_mutex_lock(mutex: *mut u8) -> i32;
extern fn pthread_mutex_trylock(mutex: *mut u8) -> i32;
extern fn pthread_mutex_unlock(mutex: *mut u8) -> i32;
extern fn pthread_mutex_destroy(mutex: *mut u8) -> i32;

extern fn pthread_rwlock_init(rwlock: *mut u8, attr: *const u8) -> i32;
extern fn pthread_rwlock_rdlock(rwlock: *mut u8) -> i32;
extern fn pthread_rwlock_tryrdlock(rwlock: *mut u8) -> i32;
extern fn pthread_rwlock_wrlock(rwlock: *mut u8) -> i32;
extern fn pthread_rwlock_trywrlock(rwlock: *mut u8) -> i32;
extern fn pthread_rwlock_unlock(rwlock: *mut u8) -> i32;
extern fn pthread_rwlock_destroy(rwlock: *mut u8) -> i32;

// ── Mutex<T: Send> ────────────────────────────────────────────────────────────
//
// 'raw' points to a 40-byte heap block holding the pthread_mutex_t.
// 'data' holds the protected value inline in the struct.

/// A mutual-exclusion lock protecting a `T`, backed by a heap-allocated `pthread_mutex_t`.
pub struct Mutex<T> {
    data: UnsafeCell<T>,
    raw:  *mut u8,
}

/// Creates a new `Mutex` wrapping `data`, initializing the underlying `pthread_mutex_t`.
pub fn mutex_new<T: Send>(data: T) -> Mutex<T> {
    let raw: *mut u8 = alloc(40 as i64);
    unsafe {
        let null_attr: *const u8 = 0 as *const u8;
        pthread_mutex_init(raw, null_attr);
    }
    return Mutex { data: UnsafeCell::new(data), raw: raw };
}

impl<T: Send> Mutex<T> {
    /// Acquires the lock, blocking until available; returns a mutable pointer to the data.
    /// The caller releases it with `unlock` (the RAII form is `lock`).
    pub unsafe fn lock_raw(self: *mut Mutex<T>) -> *mut T {
        pthread_mutex_lock(self.raw);
        return self.data.get();
    }

    /// Tries to acquire the lock without blocking.
    /// Returns `Some` pointer to the data on success, `None` on contention.
    pub unsafe fn try_lock_raw(self: *mut Mutex<T>) -> Option<*mut T> {
        let rc: i32 = pthread_mutex_trylock(self.raw);
        if rc == 0 {
            return Option::Some(self.data.get());
        }
        return Option::None;
    }

    /// Releases a previously acquired lock.
    pub unsafe fn unlock(self: *mut Mutex<T>) {
        pthread_mutex_unlock(self.raw);
    }
}

// Mutex<T> is Send+Sync iff T: Send (raw *mut u8 inside is OK because
// pthread_mutex_t is internally synchronized).  Matches Rust's
// `unsafe impl<T: Send> Send/Sync for Mutex<T>`.
unsafe impl<T: Send> Send for Mutex<T> {}
unsafe impl<T: Send> Sync for Mutex<T> {}

/// Destroys the underlying `pthread_mutex_t` and frees the raw heap block.
pub unsafe fn mutex_destroy<T: Send>(m: *mut Mutex<T>) {
    pthread_mutex_destroy(m.raw);
    dealloc(m.raw);
    m.raw = 0 as *mut u8;
}

// RAII: a by-value Mutex owns the heap pthread_mutex_t block, so it frees
// it on drop (the `data: T` field auto-drops afterward). Without this, a
// Mutex held as a struct field — e.g. LockingStore.lock in the persistent
// store — leaked its 40-byte raw block every time the owner dropped.
// Idempotent: guarded on `raw != null`, and mutex_destroy nulls raw, so an
// explicit mutex_destroy followed by this drop is a safe no-op (no double
// free / double pthread_mutex_destroy).
impl<T> Drop for Mutex<T> {
    fn drop(self: &mut Mutex<T>) {
        unsafe {
            if self.raw != 0 as *mut u8 {
                pthread_mutex_destroy(self.raw);
                dealloc(self.raw);
            }
        }
    }
}

// ── RwLock<T: Send + Sync> ────────────────────────────────────────────────────
//
// 'raw' points to a 56-byte heap block holding the pthread_rwlock_t.
// Multiple readers may hold the lock simultaneously; writers are exclusive.

/// A reader-writer lock protecting a `T`, backed by a heap-allocated `pthread_rwlock_t`.
pub struct RwLock<T> {
    data: UnsafeCell<T>,
    raw:  *mut u8,
}

/// Creates a new `RwLock` wrapping `data`, initializing the underlying `pthread_rwlock_t`.
pub fn rwlock_new<T: Send + Sync>(data: T) -> RwLock<T> {
    let raw: *mut u8 = alloc(56 as i64);
    unsafe {
        let null_attr: *const u8 = 0 as *const u8;
        pthread_rwlock_init(raw, null_attr);
    }
    return RwLock { data: UnsafeCell::new(data), raw: raw };
}

impl<T: Send + Sync> RwLock<T> {
    /// Acquires a shared (reader) lock, blocking until available; returns a const pointer.
    pub unsafe fn read_lock(self: *mut RwLock<T>) -> *const T {
        pthread_rwlock_rdlock(self.raw);
        return self.data.get() as *const T;
    }

    /// Tries to acquire a reader lock without blocking; `None` on contention.
    pub unsafe fn try_read_lock(self: *mut RwLock<T>) -> Option<*const T> {
        let rc: i32 = pthread_rwlock_tryrdlock(self.raw);
        if rc == 0 {
            return Option::Some(self.data.get() as *const T);
        }
        return Option::None;
    }

    /// Acquires an exclusive (writer) lock, blocking until available; returns a mutable pointer.
    pub unsafe fn write_lock(self: *mut RwLock<T>) -> *mut T {
        pthread_rwlock_wrlock(self.raw);
        return self.data.get();
    }

    /// Tries to acquire a writer lock without blocking; `None` on contention.
    pub unsafe fn try_write_lock(self: *mut RwLock<T>) -> Option<*mut T> {
        let rc: i32 = pthread_rwlock_trywrlock(self.raw);
        if rc == 0 {
            return Option::Some(self.data.get());
        }
        return Option::None;
    }

    /// Releases any lock (reader or writer) currently held by the caller.
    pub unsafe fn unlock(self: *mut RwLock<T>) {
        pthread_rwlock_unlock(self.raw);
    }
}

// RwLock<T>: Send if T: Send; Sync if T: Send + Sync (matches Rust).
unsafe impl<T: Send> Send for RwLock<T> {}
unsafe impl<T: Send + Sync> Sync for RwLock<T> {}

/// Destroys the underlying `pthread_rwlock_t` and frees the raw heap block.
pub unsafe fn rwlock_destroy<T: Send + Sync>(rw: *mut RwLock<T>) {
    pthread_rwlock_destroy(rw.raw);
    dealloc(rw.raw);
    rw.raw = 0 as *mut u8;
}

// RAII twin of Mutex's Drop: free the heap pthread_rwlock_t block on drop.
// Same idempotent guard (rwlock_destroy nulls raw → drop-after-destroy is a
// no-op).
impl<T> Drop for RwLock<T> {
    fn drop(self: &mut RwLock<T>) {
        unsafe {
            if self.raw != 0 as *mut u8 {
                pthread_rwlock_destroy(self.raw);
                dealloc(self.raw);
            }
        }
    }
}

// ── The RAII guard surface (Rust's `std::sync`) ─────────────────────────────
//
// A guard holds the lock for its lifetime and releases it on drop; it derefs to
// the protected value. Logos panics abort, so a lock is never poisoned: `lock`
// always returns `Ok`, and `PoisonError` exists for the Rust shape
// (`m.lock().unwrap()`).

/// The error of a poisoned lock (Rust's `PoisonError`); never produced (a panic aborts).
pub struct PoisonError<G> {
    guard: G,
}

impl<G> PoisonError<G> {
    /// The guard the poisoned lock would have handed out.
    pub fn into_inner(self: PoisonError<G>) -> G { return self.guard; }
}

/// Why `try_lock` / `try_read` / `try_write` did not acquire the lock (Rust's `TryLockError`).
pub enum TryLockError<G> {
    /// The lock was poisoned (never produced).
    Poisoned(PoisonError<G>),
    /// The lock is held elsewhere.
    WouldBlock,
}

/// Holds a `Mutex` locked; derefs to the data; unlocks on drop (Rust's `MutexGuard`).
#[borrow_carrying]
pub struct MutexGuard<'a, T> {
    m: *const Mutex<T>,
}

impl<T: Send> Mutex<T> {
    /// Creates a new mutex holding `data` (Rust's `Mutex::new`).
    pub fn new(data: T) -> Mutex<T> { return mutex_new::<T>(data); }

    /// Blocks until the lock is acquired; the guard releases it on drop.
    pub fn lock<'a>(self: &'a Mutex<T>) -> Result<MutexGuard<'a, T>, PoisonError<MutexGuard<'a, T>>> {
        unsafe { pthread_mutex_lock(self.raw); }
        return Result::Ok(MutexGuard { m: self as *const Mutex<T> });
    }

    /// Acquires the lock if it is free, else `Err(WouldBlock)`.
    pub fn try_lock<'a>(self: &'a Mutex<T>) -> Result<MutexGuard<'a, T>, TryLockError<MutexGuard<'a, T>>> {
        let rc: i32 = unsafe { pthread_mutex_trylock(self.raw) };
        if rc != 0 { return Result::Err(TryLockError::WouldBlock); }
        return Result::Ok(MutexGuard { m: self as *const Mutex<T> });
    }

    /// `&mut self` proves exclusivity: the data, with no locking.
    pub fn get_mut(&mut self) -> Result<&mut T, PoisonError<&mut T>> {
        return Result::Ok(self.data.get_mut());
    }

    /// Consumes the mutex, returning the data.
    pub fn into_inner(self: Mutex<T>) -> Result<T, PoisonError<T>> {
        let mut m: Mutex<T> = self;
        unsafe {
            let mp: *mut Mutex<T> = &mut m as *mut Mutex<T>;
            let cp: *mut T = mp.data.get();
            let v: T = cp[0];
            pthread_mutex_destroy(m.raw);
            dealloc(m.raw);
            m.raw = 0 as *mut u8;
            logos.lang.mem::forget::<Mutex<T>>(m);
            return Result::Ok(v);
        }
    }
}

impl<'a, T> Deref<T> for MutexGuard<'a, T> {
    fn deref(&self) -> &T { unsafe { return &*(self.m.data.get() as *const T); } }
}

impl<'a, T> DerefMut<T> for MutexGuard<'a, T> {
    fn deref_mut(&mut self) -> &mut T { unsafe { return &mut *self.m.data.get(); } }
}

impl<'a, T> Drop for MutexGuard<'a, T> {
    fn drop(self: &mut MutexGuard<'a, T>) { unsafe { pthread_mutex_unlock(self.m.raw); } }
}

/// Holds an `RwLock` read-locked; derefs to the data; unlocks on drop.
#[borrow_carrying]
pub struct RwLockReadGuard<'a, T> {
    l: *const RwLock<T>,
}

/// Holds an `RwLock` write-locked; derefs (mutably) to the data; unlocks on drop.
#[borrow_carrying]
pub struct RwLockWriteGuard<'a, T> {
    l: *const RwLock<T>,
}

impl<T: Send + Sync> RwLock<T> {
    /// Creates a new reader-writer lock holding `data` (Rust's `RwLock::new`).
    pub fn new(data: T) -> RwLock<T> { return rwlock_new::<T>(data); }

    /// Blocks until a shared (read) lock is acquired.
    pub fn read<'a>(self: &'a RwLock<T>) -> Result<RwLockReadGuard<'a, T>, PoisonError<RwLockReadGuard<'a, T>>> {
        unsafe { pthread_rwlock_rdlock(self.raw); }
        return Result::Ok(RwLockReadGuard { l: self as *const RwLock<T> });
    }

    /// Blocks until the exclusive (write) lock is acquired.
    pub fn write<'a>(self: &'a RwLock<T>) -> Result<RwLockWriteGuard<'a, T>, PoisonError<RwLockWriteGuard<'a, T>>> {
        unsafe { pthread_rwlock_wrlock(self.raw); }
        return Result::Ok(RwLockWriteGuard { l: self as *const RwLock<T> });
    }

    /// A shared lock if one is available now, else `Err(WouldBlock)`.
    pub fn try_read<'a>(self: &'a RwLock<T>) -> Result<RwLockReadGuard<'a, T>, TryLockError<RwLockReadGuard<'a, T>>> {
        let rc: i32 = unsafe { pthread_rwlock_tryrdlock(self.raw) };
        if rc != 0 { return Result::Err(TryLockError::WouldBlock); }
        return Result::Ok(RwLockReadGuard { l: self as *const RwLock<T> });
    }

    /// The exclusive lock if it is free now, else `Err(WouldBlock)`.
    pub fn try_write<'a>(self: &'a RwLock<T>) -> Result<RwLockWriteGuard<'a, T>, TryLockError<RwLockWriteGuard<'a, T>>> {
        let rc: i32 = unsafe { pthread_rwlock_trywrlock(self.raw) };
        if rc != 0 { return Result::Err(TryLockError::WouldBlock); }
        return Result::Ok(RwLockWriteGuard { l: self as *const RwLock<T> });
    }

    /// `&mut self` proves exclusivity: the data, with no locking.
    pub fn get_mut(&mut self) -> Result<&mut T, PoisonError<&mut T>> {
        return Result::Ok(self.data.get_mut());
    }
}

impl<'a, T> Deref<T> for RwLockReadGuard<'a, T> {
    fn deref(&self) -> &T { unsafe { return &*(self.l.data.get() as *const T); } }
}

impl<'a, T> Drop for RwLockReadGuard<'a, T> {
    fn drop(self: &mut RwLockReadGuard<'a, T>) { unsafe { pthread_rwlock_unlock(self.l.raw); } }
}

impl<'a, T> Deref<T> for RwLockWriteGuard<'a, T> {
    fn deref(&self) -> &T { unsafe { return &*(self.l.data.get() as *const T); } }
}

impl<'a, T> DerefMut<T> for RwLockWriteGuard<'a, T> {
    fn deref_mut(&mut self) -> &mut T { unsafe { return &mut *self.l.data.get(); } }
}

impl<'a, T> Drop for RwLockWriteGuard<'a, T> {
    fn drop(self: &mut RwLockWriteGuard<'a, T>) { unsafe { pthread_rwlock_unlock(self.l.raw); } }
}
