// Logos stdlib — fiber runtime (step 1: single-thread cooperative scheduler).
//
// Native dependency: stdlib/rt/fiber_ctx.S (compiled into liblogos_rt.a).
// All scheduler logic lives here in pure Logos.

package logos.std.rt.fiber;

use std.mem;

// ── Native symbols from fiber_ctx.S ────────────────────────────────────────

// Save current register state into *from, restore from *to, return into 'to'.
extern fn logos_fiber_switch(from: *mut FiberCtx, to: *const FiberCtx);

// Returns the address of the logos_fiber_entry trampoline as a raw integer.
extern fn logos_get_fiber_entry_addr() -> i64;

// Per-thread scheduler pointer (stored in fiber_ctx.S .data section).
extern fn logos_sched_get() -> *mut u8;
extern fn logos_sched_set(ptr: *mut u8);

// ── OS primitives ──────────────────────────────────────────────────────────

extern fn mmap(addr: *mut u8, len: i64, prot: i32, flags: i32,
               fd: i32, offset: i64) -> *mut u8;
extern fn mprotect(addr: *mut u8, len: i64, prot: i32) -> i32;
extern fn munmap(addr: *mut u8, len: i64) -> i32;

// ── Constants ─────────────────────────────────────────────────────────────

let STACK_SIZE:    i64 = 262144;  // 256 KiB usable stack per fiber
let GUARD_SIZE:    i64 = 4096;    // 4 KiB guard page (catches overflow)

// Per-scheduler pool of retired stacks: when enabled via
// sched_set_stack_pool_cap(), spawn() reuses stacks instead of mmap'ing
// a fresh one, and retire pushes into the pool instead of munmap'ing.
// The pool is opt-in (default cap = 0 = no pool) because on localhost
// HTTP-hello workloads the mmap/munmap cost is dominated by other
// syscalls and the pool has no net win; callers with heavier handlers
// (where stacks actually touch many pages) can enable it as needed.

// Number of fiber-local storage slots (i64 each, 64 bytes per fiber).
// Slots are indexed by small integer keys picked by user code by convention.
// Slot 0 is reserved for the fiber reactor's CQE result.
// pub const not yet supported end-to-end (grammar/sema/import);
// FLS_SLOTS is effectively internal to the fiber package.
let FLS_SLOTS: i64 = 8;
pub fn fls_slots() -> i64 { return FLS_SLOTS; }
pub fn fls_key_cqe_result() -> i64 { return 0 as i64; }

let PROT_NONE:     i32 = 0;
let PROT_READ:     i32 = 1;
let PROT_WRITE:    i32 = 2;
let MAP_PRIVATE:   i32 = 2;
let MAP_ANONYMOUS: i32 = 32;     // Linux MAP_ANONYMOUS = 0x20

// ── FiberCtx ───────────────────────────────────────────────────────────────
//
// Maps 1:1 to the register save area in fiber_ctx.S.
// Field order and sizes MUST NOT change without updating the asm offsets.

pub struct FiberCtx {
    rbp: i64,
    rbx: i64,
    r12: i64,   // entry fn ptr for new fibers
    r13: i64,   // entry arg for new fibers
    r14: i64,
    r15: i64,
    rsp: i64,   // saved stack pointer (return addr on top)
}

// ── Fiber ─────────────────────────────────────────────────────────────────

pub struct Fiber {
    ctx:        FiberCtx,
    stack_base: *mut u8,
    stack_size: i64,
    fls:        *mut i64,   // FLS_SLOTS i64s, heap alloc'd at spawn
    next:       *mut Fiber, // intrusive ready-queue link; 0 when not queued
}

// ── Scheduler ─────────────────────────────────────────────────────────────
//
// Intrusive singly-linked FIFO: ready_head → fiber → fiber → … → ready_tail,
// chained via Fiber.next.  Unbounded; no heap buffer, no modular arithmetic.
// All access is single-threaded (scheduler's own thread).

pub struct Scheduler {
    ready_head: *mut Fiber, // 0 when empty
    ready_tail: *mut Fiber, // 0 when empty

    current:      i64,   // *mut Fiber of the running fiber, or 0
    pending_free: i64,   // *mut Fiber to free after the next scheduler switch

    // Stack pool: array of i64 base pointers to retired mmap'd stacks,
    // each of size STACK_SIZE+GUARD_SIZE with the guard page already
    // mprotect'd to PROT_NONE.  spawn() pops from here first before
    // calling mmap.
    stack_pool_buf: *mut i64,
    stack_pool_len: i64,
    stack_pool_cap: i64,

    sched_ctx: FiberCtx,
}

// ── Internal queue helpers ─────────────────────────────────────────────────

// Intrusive link: append fiber to tail.  Caller must not enqueue a fiber
// that is already in the queue — we don't scan for duplicates.  fptr is
// stored as i64 for historical compatibility with call sites.
fn sched_enqueue(s: *mut Scheduler, fptr: i64) {
    unsafe {
        let f: *mut Fiber = fptr as *mut Fiber;
        f.next = 0 as *mut Fiber;
        if s.ready_tail == (0 as *mut Fiber) {
            s.ready_head = f;
        } else {
            s.ready_tail.next = f;
        }
        s.ready_tail = f;
    }
}

fn sched_dequeue(s: *mut Scheduler) -> i64 {
    unsafe {
        let f: *mut Fiber = s.ready_head;
        s.ready_head = f.next;
        if s.ready_head == (0 as *mut Fiber) {
            s.ready_tail = 0 as *mut Fiber;
        }
        f.next = 0 as *mut Fiber;
        return f as i64;
    }
}

fn sched_empty(s: *const Scheduler) -> bool {
    unsafe { return s.ready_head == (0 as *mut Fiber); }
}

// ── Stack pool helpers ─────────────────────────────────────────────────────

// Try to take a retired stack from the pool.  Returns null if empty.
fn stack_pool_pop(s: *mut Scheduler) -> *mut u8 {
    unsafe {
        if s.stack_pool_len <= 0 as i64 { return 0 as *mut u8; }
        s.stack_pool_len = s.stack_pool_len - 1 as i64;
        let slot: *const i64 =
            (s.stack_pool_buf as i64 + s.stack_pool_len * 8 as i64) as *const i64;
        return (*slot) as *mut u8;
    }
}

// Try to store a retired stack in the pool.  Returns false if full; caller
// must then munmap the stack.
fn stack_pool_push(s: *mut Scheduler, base: *mut u8) -> bool {
    unsafe {
        if s.stack_pool_len >= s.stack_pool_cap { return false; }
        let slot: *mut i64 =
            (s.stack_pool_buf as i64 + s.stack_pool_len * 8 as i64) as *mut i64;
        *slot = base as i64;
        s.stack_pool_len = s.stack_pool_len + 1 as i64;
        return true;
    }
}

// Retire a fiber: free FLS, push stack to pool (or munmap), free fiber struct.
fn retire_fiber(s: *mut Scheduler, dead: *mut Fiber) {
    unsafe {
        dealloc(dead.fls as *mut u8);
        let size: i64 = dead.stack_size;
        let base: *mut u8 = dead.stack_base;
        if !stack_pool_push(s, base) {
            munmap(base, size);
        }
        dealloc(dead as *mut u8);
    }
}

// ── Public API ─────────────────────────────────────────────────────────────

// Allocate and initialise a new scheduler.  The caller owns it and must
// call sched_free() when done.
pub fn sched_new() -> *mut Scheduler {
    let raw: *mut u8 = alloc(sizeof::<Scheduler>());
    let s: *mut Scheduler = raw as *mut Scheduler;
    unsafe {
        s.ready_head = 0 as *mut Fiber;
        s.ready_tail = 0 as *mut Fiber;
        s.current      = 0;
        s.pending_free = 0;
        // Stack pool is opt-in; caller enables via sched_set_stack_pool_cap.
        s.stack_pool_buf = 0 as *mut i64;
        s.stack_pool_len = 0 as i64;
        s.stack_pool_cap = 0 as i64;
        s.sched_ctx.rbp = 0;
        s.sched_ctx.rbx = 0;
        s.sched_ctx.r12 = 0;
        s.sched_ctx.r13 = 0;
        s.sched_ctx.r14 = 0;
        s.sched_ctx.r15 = 0;
        s.sched_ctx.rsp = 0;
    }
    return s;
}

// Register this scheduler as the current one for this thread.
// Must be called before spawn() or yield_fiber().
pub fn sched_set_current(s: *mut Scheduler) {
    unsafe { logos_sched_set(s as *mut u8); }
}

// Enable (or resize) the stack pool.  Must be called after sched_new()
// and before the first spawn().  `cap = 0` disables pooling; any other
// value allocates a fresh slot buffer.  Existing pool contents are
// munmap'd before the buffer is replaced.
pub fn sched_set_stack_pool_cap(s: *mut Scheduler, cap: i64) {
    unsafe {
        // Drain the old pool, if any, before resizing.
        if s.stack_pool_buf != (0 as *mut i64) {
            let mut i: i64 = 0 as i64;
            while i < s.stack_pool_len {
                let slot: *const i64 =
                    (s.stack_pool_buf as i64 + i * 8 as i64) as *const i64;
                munmap((*slot) as *mut u8, STACK_SIZE + GUARD_SIZE);
                i = i + 1 as i64;
            }
            dealloc(s.stack_pool_buf as *mut u8);
            s.stack_pool_buf = 0 as *mut i64;
        }
        s.stack_pool_len = 0 as i64;
        s.stack_pool_cap = cap;
        if cap > 0 as i64 {
            let pool_buf: *mut u8 = alloc(cap * 8 as i64);
            s.stack_pool_buf = pool_buf as *mut i64;
        }
    }
}

// Free scheduler and its queue buffer (does NOT free pending fibers).
pub fn sched_free(s: *mut Scheduler) {
    unsafe {
        // Drain stack pool (if enabled): munmap every retired stack still held.
        if s.stack_pool_buf != (0 as *mut i64) {
            let mut i: i64 = 0 as i64;
            while i < s.stack_pool_len {
                let slot: *const i64 =
                    (s.stack_pool_buf as i64 + i * 8 as i64) as *const i64;
                munmap((*slot) as *mut u8, STACK_SIZE + GUARD_SIZE);
                i = i + 1 as i64;
            }
            dealloc(s.stack_pool_buf as *mut u8);
        }
        dealloc(s as *mut u8);
    }
}

// Spawn a fiber that will call f(arg) on a fresh stack.
// The scheduler must have been set via logos_sched_set (sched_run does this).
pub fn spawn(f: fn(i64) -> (), arg: i64) {
    let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;

    // Allocate fiber struct.
    let fiber: *mut Fiber = alloc(sizeof::<Fiber>()) as *mut Fiber;

    // Allocate stack: try the pool first (guard page already mprotect'd);
    // fall back to a fresh mmap+mprotect if empty.
    let total: i64 = STACK_SIZE + GUARD_SIZE;
    let mut base: *mut u8 = stack_pool_pop(s);
    if base == (0 as *mut u8) {
        let prot_rw: i32 = PROT_READ | PROT_WRITE;
        let map_flags: i32 = MAP_PRIVATE | MAP_ANONYMOUS;
        let anon_fd: i32 = 0 - 1;   // -1
        base = unsafe { mmap(0 as *mut u8, total, prot_rw, map_flags, anon_fd, 0) };
        let _: i32 = unsafe { mprotect(base, GUARD_SIZE, PROT_NONE) };
    }

    // Compute stack top, aligned down to 16 bytes.
    let top_addr: i64 = (base as i64) + total;
    let top_aligned: i64 = top_addr & !15;

    // Place the trampoline address as the fake return address on the stack.
    // logos_fiber_switch restores rsp = top_aligned - 8 and then `ret`
    // which pops this address and jumps to logos_fiber_entry.
    let entry_addr: i64 = unsafe { logos_get_fiber_entry_addr() };
    let ret_slot: *mut i64 = (top_aligned - 8) as *mut i64;
    unsafe { *ret_slot = entry_addr; }

    // Initialise FiberCtx.
    let fp: *const u8 = f as *const u8;
    unsafe {
        fiber.ctx.rbp = 0;
        fiber.ctx.rbx = 0;
        fiber.ctx.r12 = fp as i64;   // entry fn
        fiber.ctx.r13 = arg;          // entry arg
        fiber.ctx.r14 = 0;
        fiber.ctx.r15 = 0;
        fiber.ctx.rsp = top_aligned - 8;
        fiber.stack_base = base;
        fiber.stack_size = total;

        // Allocate and zero FLS slot array (64 bytes).
        let fls_buf: *mut u8 = alloc(FLS_SLOTS * 8 as i64);
        let fls_i64: *mut i64 = fls_buf as *mut i64;
        let mut k: i64 = 0;
        while k < FLS_SLOTS {
            let slot: *mut i64 = (fls_buf as i64 + k * 8 as i64) as *mut i64;
            *slot = 0;
            k = k + 1 as i64;
        }
        fiber.fls = fls_i64;
    }

    sched_enqueue(s, fiber as i64);
}

// Voluntarily yield: push the current fiber back onto the ready queue and
// switch to the scheduler.  Returns when the scheduler picks us again.
pub fn yield_fiber() {
    let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
    let cur: i64 = unsafe { s.current };
    sched_enqueue(s, cur);
    unsafe { s.current = 0; }
    let fiber: *mut Fiber = cur as *mut Fiber;
    let from: *mut FiberCtx = unsafe { &mut fiber.ctx as *mut FiberCtx };
    let to: *const FiberCtx = unsafe { &s.sched_ctx as *const FiberCtx };
    unsafe { logos_fiber_switch(from, to); }
    // Execution resumes here when the scheduler switches back to this fiber.
}

// Called by the logos_fiber_entry trampoline (fiber_ctx.S) after the fiber
// function returns.  Notifies the scheduler to free this fiber and switches
// back to the scheduler context.
#[no_mangle]
pub fn logos_fiber_done() {
    let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
    let cur: i64 = unsafe { s.current };
    unsafe {
        s.current      = 0;
        s.pending_free = cur;  // scheduler frees after switch
    }
    let fiber: *mut Fiber = cur as *mut Fiber;
    let from: *mut FiberCtx = unsafe { &mut fiber.ctx as *mut FiberCtx };
    let to: *const FiberCtx = unsafe { &s.sched_ctx as *const FiberCtx };
    unsafe { logos_fiber_switch(from, to); }
    // Never reached.
}

// Run the scheduler until the ready queue is empty.
// Sets the global scheduler pointer so spawn() and yield_fiber() work.
pub fn sched_run(s: *mut Scheduler) {
    unsafe { logos_sched_set(s as *mut u8); }

    while !sched_empty(s) {
        // Free any fiber that finished in the previous iteration.
        let pf: i64 = unsafe { s.pending_free };
        if pf != 0 {
            let dead: *mut Fiber = pf as *mut Fiber;
            retire_fiber(s, dead);
            unsafe { s.pending_free = 0; }
        }

        // Dequeue next ready fiber and switch to it.
        let fptr: i64 = sched_dequeue(s);
        unsafe { s.current = fptr; }
        let fiber: *mut Fiber = fptr as *mut Fiber;
        let from: *mut FiberCtx = unsafe { &mut s.sched_ctx as *mut FiberCtx };
        let to: *const FiberCtx = unsafe { &fiber.ctx as *const FiberCtx };
        unsafe { logos_fiber_switch(from, to); }
        // Returns here when the fiber yields or finishes.
    }

    // Free the last fiber if it finished without yielding.
    let pf: i64 = unsafe { s.pending_free };
    if pf != 0 {
        let dead: *mut Fiber = pf as *mut Fiber;
        retire_fiber(s, dead);
        unsafe { s.pending_free = 0; }
    }
}

// ── Fiber-local storage (FLS) ─────────────────────────────────────────────
//
// Each fiber has FLS_SLOTS i64 slots, indexed by small integer keys (0..7).
// Slot 0 is reserved for the fiber reactor's CQE result; other keys are
// picked by user code by convention.  On key collision, we'll later add a
// simple key allocator — for now keys are constants.

pub fn fls_get(key: i64) -> i64 {
    let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
    if s == 0 as *mut Scheduler { return 0 as i64; }
    let cur: i64 = unsafe { s.current };
    if cur == 0 as i64 { return 0 as i64; }
    let fiber: *mut Fiber = cur as *mut Fiber;
    unsafe {
        let slot: *const i64 = (fiber.fls as i64 + key * 8 as i64) as *const i64;
        return *slot;
    }
}

pub fn fls_set(key: i64, val: i64) {
    let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
    if s == 0 as *mut Scheduler { return; }
    let cur: i64 = unsafe { s.current };
    if cur == 0 as i64 { return; }
    let fiber: *mut Fiber = cur as *mut Fiber;
    unsafe {
        let slot: *mut i64 = (fiber.fls as i64 + key * 8 as i64) as *mut i64;
        *slot = val;
    }
}

// ── Reactor hook — park current fiber ─────────────────────────────────────
//
// Similar to yield_fiber(), but the current fiber is NOT re-enqueued.
// It is the caller's responsibility to arrange for the fiber to be
// re-enqueued later (e.g. via sched_enqueue from a reactor CQE handler).
// Returns when the fiber is resumed.
pub fn park_fiber() {
    let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
    if s == 0 as *mut Scheduler { return; }
    let cur: i64 = unsafe { s.current };
    if cur == 0 as i64 { return; }
    unsafe { s.current = 0; }
    let fiber: *mut Fiber = cur as *mut Fiber;
    let from: *mut FiberCtx = unsafe { &mut fiber.ctx as *mut FiberCtx };
    let to:   *const FiberCtx = unsafe { &s.sched_ctx as *const FiberCtx };
    unsafe { logos_fiber_switch(from, to); }
    // Resume point: reactor has re-enqueued us and scheduler switched back.
}

// Returns a pointer-sized identifier of the current fiber (or 0 if none).
// Reactor stores this as io_uring SQE user_data so that on CQE delivery
// it knows which fiber to re-enqueue.
pub fn current_fiber() -> i64 {
    let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
    if s == 0 as *mut Scheduler { return 0 as i64; }
    return unsafe { s.current };
}

// Re-enqueue a previously-parked fiber into the ready queue.
// Called by the reactor when a CQE for a parked fiber arrives.
pub fn unpark_fiber(fiber_ptr: i64) {
    let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
    if s == 0 as *mut Scheduler { return; }
    sched_enqueue(s, fiber_ptr);
}
