// Logos Hermes stdlib — hermes.relptr
//
// RelPtr<T>: thin intra-zone relative pointer.
//
// Inside a HermesZone all object references are stored as u32 offsets from
// the zone base, not as absolute pointers.  This keeps the zone fully
// relocatable: the zone can be moved in memory (e.g. grown via realloc)
// without invalidating any stored references.
//
// RelPtr<T> is a #[zoned] struct (POD, 4 bytes) that wraps a u32 offset.
// To dereference it you supply the zone base pointer, which comes from the
// DataRef/DataOwn fat pointer that you hold outside the zone.
//
// Usage:
//   let rp: RelPtr<Node> = RelPtr { offset: some_u32 };
//   let np: *const Node  = rp.resolve(zone.base);

package hermes.relptr;

// Thin relative pointer — just 4 bytes stored in zone.
// T must itself be a Datatype (Rule 9).
#[zoned] pub struct RelPtr<T> {
    pub offset: u32,
}

impl<T> RelPtr<T> {
    // Resolve to a const pointer given the zone base.
    pub unsafe fn resolve(self: *const RelPtr<T>, base: *const u8) -> *const T {
        let base_int: i64 = base as i64;
        let off: i64 = self.offset as i64;
        return (base_int + off) as *const T;
    }

    // Resolve to a mutable pointer given the zone base.
    pub unsafe fn resolve_mut(self: *const RelPtr<T>, base: *mut u8) -> *mut T {
        let base_int: i64 = base as i64;
        let off: i64 = self.offset as i64;
        return (base_int + off) as *mut T;
    }

    // True if offset == 0 (null sentinel; zone offset 0 is never used for data).
    pub unsafe fn is_null(self: *const RelPtr<T>) -> bool {
        return self.offset == 0;
    }
}

// Null relative pointer sentinel.
pub unsafe fn relptr_null<T>() -> RelPtr<T> {
    return RelPtr { offset: 0 };
}
