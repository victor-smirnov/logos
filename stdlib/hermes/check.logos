// SPDX-License-Identifier: Apache-2.0
// Copyright 2026 Victor Smirnov
// Logos Hermes stdlib -- hermes.check
//
// Structural integrity check for a Hermes zone document.
//
// Algorithm (iterative breadth/depth-first walk via explicit work queue):
//   1. Allocate two bitmaps (1 bit per zone byte each):
//        `visited` — set for every byte covered by check_mark (overlap
//                    detection between distinct objects/buffers).
//        `starts`  — set only at (obj_offset - 1) for each object that
//                    the walk has entered (DAG / shared-subtree short-
//                    circuit).  Separating these prevents a corrupt
//                    AnyVal that lands inside another object's data
//                    buffer from being silently accepted as "visited".
//   2. Mark the DocumentHeader region (offset 0..7) in `visited`.
//   3. Walk the object graph from root via an explicit queue.
//   4. For each non-null zone-pointer AnyVal in the queue:
//        a. Offset bounds check.
//        b. Short-circuit if `starts` bit at (off - 1) is set.
//        c. Validate the TypeTag is known (BadTag otherwise).
//        d. Dispatch through HermesCheck trait table.
//        e. Per-type check marks all bytes (TypeTag + header + data buffer)
//           in `visited`, records the object-start in `starts`, and
//           pushes contained AnyVals into the work queue.
//   5. Free bitmaps and queue; return the result.
//
// Inline AnyVals (boolean, integer, null) carry no zone address and are
// always considered valid.

package hermes.check;

use hermes.anyval;
use hermes.zone;
use hermes.string;
use hermes.typetag;
use hermes.datatag;
use hermes.tag_system;
use hermes.containers;
use hermes.objectmap;
use hermes.document;
use hermes.scalar;
use hermes.decimal;
use hermes.mem_holder;

extern fn calloc(count: i64, size: i64) -> *mut u8;
extern fn malloc(size: i64) -> *mut u8;
extern fn realloc(ptr: *mut u8, size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

const MAX_CHECK_NODES: i64 = 10000000;  // 10M node limit

// ---------------------------------------------------------------------------
// CheckError -- result of a failed structural check.
// ---------------------------------------------------------------------------

pub enum CheckError {
    Ok,
    OutOfBounds,   // offset or object extends outside zone
    BadTag,        // type tag not in the known set
    Overlap,       // object memory overlaps with a previously visited region
    BadSize,       // container: size > capacity
    TooManyNodes,  // exceeded MAX_CHECK_NODES
}

// ---------------------------------------------------------------------------
// CheckState -- transient state for one document_check() invocation.
// ---------------------------------------------------------------------------

pub struct CheckState {
    pub base:       *const u8,   // zone buffer start
    pub zone_sz:    i64,         // zone_used bytes
    pub visited:    *mut u8,     // calloc'd bitmap: byte-used tracking
    pub starts:     *mut u8,     // calloc'd bitmap: object-start markers
    pub bitmap_len: i64,         // length of each bitmap in bytes
    pub queue:      *mut u32,    // work queue of AnyVal.raw values (ptr-mode only)
    pub queue_len:  i64,         // current number of items in queue
    pub queue_cap:  i64,         // capacity of queue buffer
    pub node_count: i64,         // total nodes processed
    pub error:      CheckError,  // first error seen (Ok = none so far)
}

pub unsafe fn check_state_create(base: *const u8, zone_sz: i64) -> CheckState {
    let bitmap_len: i64 = (zone_sz + 7 as i64) / 8 as i64;
    let visited: *mut u8 = calloc(bitmap_len, 1 as i64);
    let starts:  *mut u8 = calloc(bitmap_len, 1 as i64);
    if visited == 0 as *mut u8 || starts == 0 as *mut u8 {
        if visited != 0 as *mut u8 { free(visited); }
        if starts  != 0 as *mut u8 { free(starts);  }
        return CheckState {
            base:       base,
            zone_sz:    zone_sz,
            visited:    0 as *mut u8,
            starts:     0 as *mut u8,
            bitmap_len: 0 as i64,
            queue:      0 as *mut u32,
            queue_len:  0 as i64,
            queue_cap:  0 as i64,
            node_count: 0 as i64,
            error:      CheckError::Ok,
        };
    }
    let init_cap: i64 = 256 as i64;
    let queue: *mut u32 = malloc(init_cap * 4 as i64) as *mut u32;
    if queue == 0 as *mut u32 {
        free(visited);
        free(starts);
        return CheckState {
            base:       base,
            zone_sz:    zone_sz,
            visited:    0 as *mut u8,
            starts:     0 as *mut u8,
            bitmap_len: 0 as i64,
            queue:      0 as *mut u32,
            queue_len:  0 as i64,
            queue_cap:  0 as i64,
            node_count: 0 as i64,
            error:      CheckError::Ok,
        };
    }
    return CheckState {
        base:       base,
        zone_sz:    zone_sz,
        visited:    visited,
        starts:     starts,
        bitmap_len: bitmap_len,
        queue:      queue,
        queue_len:  0 as i64,
        queue_cap:  init_cap,
        node_count: 0 as i64,
        error:      CheckError::Ok,
    };
}

pub unsafe fn check_state_free(state: *mut CheckState) {
    if state.visited != 0 as *mut u8 {
        free(state.visited);
        state.visited = 0 as *mut u8;
    }
    if state.starts != 0 as *mut u8 {
        free(state.starts);
        state.starts = 0 as *mut u8;
    }
    if state.queue != 0 as *mut u32 {
        free(state.queue as *mut u8);
        state.queue = 0 as *mut u32;
    }
}

// ---------------------------------------------------------------------------
// Queue helper: push a non-null ptr-mode AnyVal into the work queue.
// Returns false on OOM.
// ---------------------------------------------------------------------------

pub unsafe fn check_push_val(state: *mut CheckState, val: AnyVal) -> bool {
    if val.is_null() { return true; }
    if !val.is_ptr() { return true; }
    if state.queue_len >= state.queue_cap {
        let new_cap: i64 = state.queue_cap * 2 as i64;
        let new_q: *mut u32 = realloc(state.queue as *mut u8, new_cap * 4 as i64) as *mut u32;
        if new_q == 0 as *mut u32 { return false; }
        state.queue = new_q;
        state.queue_cap = new_cap;
    }
    let p: *mut u32 = (state.queue as i64 + state.queue_len * 4 as i64) as *mut u32;
    *p = val.raw;
    state.queue_len = state.queue_len + 1 as i64;
    return true;
}

// ---------------------------------------------------------------------------
// Bitmap helpers
// ---------------------------------------------------------------------------

pub unsafe fn check_mark_start(state: *mut CheckState, zone_off: i64) {
    let byte_idx: i64 = zone_off / 8 as i64;
    let bit: u32 = 1 as u32 << ((zone_off & 7 as i64) as u32);
    let p: *mut u8 = (state.starts as i64 + byte_idx) as *mut u8;
    *p = ((*p as u32) | bit) as u8;
}

pub unsafe fn check_is_object_start(state: *mut CheckState, zone_off: i64) -> bool {
    let byte_idx: i64 = zone_off / 8 as i64;
    let bit: u32 = 1 as u32 << ((zone_off & 7 as i64) as u32);
    let p: *const u8 = (state.starts as i64 + byte_idx) as *const u8;
    return ((*p) as u32 & bit) != 0 as u32;
}

pub unsafe fn check_mark(state: *mut CheckState, zone_off: i64, nbytes: i64) -> bool {
    let mut i: i64 = zone_off;
    let end: i64 = zone_off + nbytes;
    while i < end {
        let byte_idx: i64 = i / 8 as i64;
        let bit: u32 = 1 as u32 << ((i & 7 as i64) as u32);
        let p: *mut u8 = (state.visited as i64 + byte_idx) as *mut u8;
        let curr: u8 = *p;
        if ((curr as u32) & bit) != 0 as u32 {
            state.error = CheckError::Overlap;
            return false;
        }
        *p = ((curr as u32) | bit) as u8;
        i = i + 1 as i64;
    }
    return true;
}

// ---------------------------------------------------------------------------
// Bounds check
// ---------------------------------------------------------------------------

pub unsafe fn check_bounds(state: *mut CheckState, zone_off: i64, nbytes: i64) -> bool {
    if zone_off < 0 as i64 || nbytes < 0 as i64 {
        state.error = CheckError::OutOfBounds;
        return false;
    }
    if nbytes > state.zone_sz - zone_off {
        state.error = CheckError::OutOfBounds;
        return false;
    }
    return true;
}

// ---------------------------------------------------------------------------
// HermesCheck trait -- tag-dispatched per-type structural validator.
// ---------------------------------------------------------------------------

#[tag_dispatch(HermesTypeTagSystem)]
pub trait HermesCheck {
    fn check_obj(&self, state: *mut CheckState) -> bool;
}

// ── HermesString (28) ─────────────────────────────────────────────────────

impl HermesCheck for HermesString {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let obj: *const u8 = self as *const HermesString as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            if !check_bounds(state, off - 1 as i64, 2 as i64) { return false; }
            let vlen_sz: i64 = vlen_prefix_size(obj) as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + vlen_sz) { return false; }
            let str_len: i64 = vlen_read(obj) as i64;
            let total: i64 = vlen_sz + str_len;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + total) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + total) { return false; }
            check_mark_start(state, off - 1 as i64);
            return true;
        }
    }
}

// ── I64 (26) ──────────────────────────────────────────────────────────────

impl HermesCheck for I64 {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let obj: *const u8 = self as *const I64 as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let sz: i64 = sizeof::<I64>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + sz) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + sz) { return false; }
            check_mark_start(state, off - 1 as i64);
            return true;
        }
    }
}

// ── U64 (27) ──────────────────────────────────────────────────────────────

impl HermesCheck for U64 {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let obj: *const u8 = self as *const U64 as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let sz: i64 = sizeof::<U64>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + sz) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + sz) { return false; }
            check_mark_start(state, off - 1 as i64);
            return true;
        }
    }
}

// ── Decimal (107) ─────────────────────────────────────────────────────────

impl HermesCheck for Decimal {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let d: *const Decimal = self as *const Decimal;
            let obj: *const u8 = d as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let hdr: i64 = sizeof::<Decimal>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + hdr) { return false; }
            let nlimbs: u32 = d.len();
            let total: i64 = hdr + (nlimbs as i64) * 4 as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + total) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + total) { return false; }
            check_mark_start(state, off - 1 as i64);
            return true;
        }
    }
}

// ── Array<AnyVal> (100): 24-byte header + capacity*4 data buffer ─────────

impl HermesCheck for Array<AnyVal> {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let arr: *const Array<AnyVal> = self as *const Array<AnyVal>;
            let obj: *const u8 = arr as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let hdr_sz: i64 = sizeof::<Array<AnyVal>>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            check_mark_start(state, off - 1 as i64);

            let sz: u64  = arr.size;
            let cap: u64 = arr.capacity;
            if sz > cap {
                state.error = CheckError::BadSize;
                return false;
            }
            let buf_off: i64   = arr.data as i64;
            let buf_bytes: i64 = (cap as i64) * 4 as i64;
            if buf_bytes > 0 as i64 {
                if !check_bounds(state, buf_off, buf_bytes) { return false; }
                if !check_mark(state,  buf_off, buf_bytes)  { return false; }
            }

            let mut i: u64 = 0 as u64;
            while i < sz {
                let ep: *const AnyVal =
                    (state.base as i64 + buf_off + (i as i64) * 4 as i64) as *const AnyVal;
                let val: AnyVal = AnyVal { raw: ep.raw };
                if !check_push_val(state, val) {
                    state.error = CheckError::TooManyNodes;
                    return false;
                }
                i = i + 1 as u64;
            }
            return true;
        }
    }
}

// ── Map<Bitmap, V> (98): 16-byte header + capacity*4 data buffer ────────

impl<V> HermesCheck for Map<Bitmap, V> {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let m: *const Map<Bitmap, V> = self as *const Map<Bitmap, V>;
            let obj: *const u8 = m as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let hdr_sz: i64 = sizeof::<Map<Bitmap, V>>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            check_mark_start(state, off - 1 as i64);

            let sz: u32  = ((m.header >> 58 as u64) & 0x3F as u64) as u32;
            let cap: u32 = ((m.header >> 52 as u64) & 0x3F as u64) as u32;
            if sz > cap {
                state.error = CheckError::BadSize;
                return false;
            }
            let buf_off: i64   = m.data as i64;
            let buf_bytes: i64 = (cap as i64) * 4 as i64;
            if buf_bytes > 0 as i64 {
                if !check_bounds(state, buf_off, buf_bytes) { return false; }
                if !check_mark(state,  buf_off, buf_bytes)  { return false; }
            }

            // For Map<Bitmap, AnyVal> (type_code=98), values are AnyVal.
            // For other V, no AnyVal references to push.
            // We only push AnyVal values (4 bytes each) when V = AnyVal.
            // Since this is a blanket impl, we push all sz slots as AnyVal.
            let mut i: u32 = 0 as u32;
            while i < sz {
                let ep: *const AnyVal =
                    (state.base as i64 + buf_off + (i as i64) * 4 as i64) as *const AnyVal;
                let val: AnyVal = AnyVal { raw: ep.raw };
                if !check_push_val(state, val) {
                    state.error = CheckError::TooManyNodes;
                    return false;
                }
                i = i + 1 as u32;
            }
            return true;
        }
    }
}

// ── Map<Varchar, AnyVal> / ObjectMap (101) ────────────────────────────────

impl HermesCheck for ObjectMap {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let m: *const ObjectMap = self as *const ObjectMap;
            let obj: *const u8 = m as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let hdr_sz: i64 = sizeof::<ObjectMap>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            check_mark_start(state, off - 1 as i64);

            let cap: u32 = m.capacity;
            let cnt: u32 = m.count;
            if cnt > cap {
                state.error = CheckError::BadSize;
                return false;
            }
            let ent_off: i64   = m.entries_off as i64;
            let ent_bytes: i64 = (cap as i64) * 8 as i64;
            if ent_bytes > 0 as i64 {
                if !check_bounds(state, ent_off, ent_bytes) { return false; }
                if !check_mark(state,  ent_off, ent_bytes)  { return false; }
            }

            let mut slot: u32 = 0 as u32;
            while slot < cap {
                let ep: *const MapEntry =
                    (state.base as i64 + ent_off + (slot as i64) * 8 as i64) as *const MapEntry;
                if ep.key_off != 0 as u32 {
                    if (ep.key_off & 1 as u32) != 0 as u32 {
                        state.error = CheckError::BadTag;
                        return false;
                    }
                    let key_av: AnyVal = AnyVal::from_offset(ep.key_off);
                    if !check_push_val(state, key_av) {
                        state.error = CheckError::TooManyNodes;
                        return false;
                    }
                    let val: AnyVal = AnyVal { raw: ep.val };
                    if !check_push_val(state, val) {
                        state.error = CheckError::TooManyNodes;
                        return false;
                    }
                }
                slot = slot + 1 as u32;
            }
            return true;
        }
    }
}

// ── TypedValue (106) ──────────────────────────────────────────────────────

impl HermesCheck for TypedValue {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let t: *const TypedValue = self as *const TypedValue;
            let obj: *const u8 = t as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let sz: i64 = sizeof::<TypedValue>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + sz) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + sz) { return false; }
            check_mark_start(state, off - 1 as i64);

            let type_av: AnyVal = AnyVal::from_offset(t.type_off);
            if !check_push_val(state, type_av) {
                state.error = CheckError::TooManyNodes;
                return false;
            }
            let params: AnyVal = AnyVal { raw: t.params_raw };
            if !check_push_val(state, params) {
                state.error = CheckError::TooManyNodes;
                return false;
            }
            let init_v: AnyVal = AnyVal { raw: t.init_raw };
            if !check_push_val(state, init_v) {
                state.error = CheckError::TooManyNodes;
                return false;
            }
            return true;
        }
    }
}

// ── TypedArray (102) ──────────────────────────────────────────────────────

impl HermesCheck for TypedArray {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let t: *const TypedArray = self as *const TypedArray;
            let obj: *const u8 = t as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let sz: i64 = sizeof::<TypedArray>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + sz) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + sz) { return false; }
            check_mark_start(state, off - 1 as i64);

            let type_av: AnyVal = AnyVal::from_offset(t.type_off);
            if !check_push_val(state, type_av) {
                state.error = CheckError::TooManyNodes;
                return false;
            }
            let arr_av: AnyVal = AnyVal::from_offset(t.arr_off);
            if !check_push_val(state, arr_av) {
                state.error = CheckError::TooManyNodes;
                return false;
            }
            return true;
        }
    }
}

// ── TypedMap (103) ────────────────────────────────────────────────────────

impl HermesCheck for TypedMap {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let t: *const TypedMap = self as *const TypedMap;
            let obj: *const u8 = t as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let sz: i64 = sizeof::<TypedMap>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + sz) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + sz) { return false; }
            check_mark_start(state, off - 1 as i64);

            let type_av: AnyVal = AnyVal::from_offset(t.type_off);
            if !check_push_val(state, type_av) {
                state.error = CheckError::TooManyNodes;
                return false;
            }
            let map_av: AnyVal = AnyVal::from_offset(t.map_off);
            if !check_push_val(state, map_av) {
                state.error = CheckError::TooManyNodes;
                return false;
            }
            return true;
        }
    }
}

// ── ArrayI32 (104): 24-byte header + capacity*4 i32 data (no AnyVal refs)

impl HermesCheck for ArrayI32 {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let arr: *const ArrayI32 = self as *const ArrayI32;
            let obj: *const u8 = arr as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let hdr_sz: i64 = sizeof::<ArrayI32>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            check_mark_start(state, off - 1 as i64);

            let sz: u64  = arr.size;
            let cap: u64 = arr.capacity;
            if sz > cap {
                state.error = CheckError::BadSize;
                return false;
            }
            let buf_off: i64   = arr.data as i64;
            let buf_bytes: i64 = (cap as i64) * 4 as i64;
            if buf_bytes > 0 as i64 {
                if !check_bounds(state, buf_off, buf_bytes) { return false; }
                if !check_mark(state,  buf_off, buf_bytes)  { return false; }
            }
            return true;
        }
    }
}

// ── MapI32AnyVal (105): 16-byte header + capacity*4 keys + capacity*4 vals

impl HermesCheck for MapI32AnyVal {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let m: *const MapI32AnyVal = self as *const MapI32AnyVal;
            let obj: *const u8 = m as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let hdr_sz: i64 = sizeof::<MapI32AnyVal>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            check_mark_start(state, off - 1 as i64);

            let sz: u32  = m.size;
            let cap: u32 = m.capacity;
            if sz > cap {
                state.error = CheckError::BadSize;
                return false;
            }
            let keys_off: i64   = m.keys as i64;
            let vals_off: i64   = m.vals as i64;
            let buf_bytes: i64  = (cap as i64) * 4 as i64;
            if buf_bytes > 0 as i64 {
                if !check_bounds(state, keys_off, buf_bytes) { return false; }
                if !check_mark(state,  keys_off, buf_bytes)  { return false; }
                if !check_bounds(state, vals_off, buf_bytes) { return false; }
                if !check_mark(state,  vals_off, buf_bytes)  { return false; }
            }

            let mut i: u32 = 0 as u32;
            while i < sz {
                let vp: *const AnyVal =
                    (state.base as i64 + vals_off + (i as i64) * 4 as i64) as *const AnyVal;
                let val: AnyVal = AnyVal { raw: vp.raw };
                if !check_push_val(state, val) {
                    state.error = CheckError::TooManyNodes;
                    return false;
                }
                i = i + 1 as u32;
            }
            return true;
        }
    }
}

// ---------------------------------------------------------------------------
// Known-tag validator.
// ---------------------------------------------------------------------------

pub unsafe fn is_known_tag(tag: u64) -> bool {
    if tag == hermes_tag_string()         as u64 { return true; }
    if tag == hermes_tag_i64()            as u64 { return true; }
    if tag == hermes_tag_u64()            as u64 { return true; }
    if tag == hermes_tag_decimal()        as u64 { return true; }
    if tag == hermes_tag_array()          as u64 { return true; }
    if tag == hermes_tag_tiny_map()       as u64 { return true; }
    if tag == hermes_tag_map()            as u64 { return true; }
    if tag == hermes_tag_typed_value()    as u64 { return true; }
    if tag == hermes_tag_typed_array()    as u64 { return true; }
    if tag == hermes_tag_typed_map()      as u64 { return true; }
    if tag == hermes_tag_array_i32()      as u64 { return true; }
    if tag == hermes_tag_map_i32_anyval() as u64 { return true; }
    return false;
}

// ---------------------------------------------------------------------------
// anyval_check_one: validate a single AnyVal and push its children.
// Returns false if an error was found.
// ---------------------------------------------------------------------------

pub unsafe fn anyval_check_one(val: AnyVal, state: *mut CheckState) -> bool {
    if val.is_null() { return true; }
    if !val.is_ptr() { return true; }

    state.node_count = state.node_count + 1 as i64;
    if state.node_count > MAX_CHECK_NODES {
        state.error = CheckError::TooManyNodes;
        return false;
    }

    let off: i64 = val.as_offset() as i64;

    if off < 1 as i64 || off >= state.zone_sz {
        state.error = CheckError::OutOfBounds;
        return false;
    }

    if check_is_object_start(state, off - 1 as i64) { return true; }

    let obj: *const u8 = (state.base as i64 + off) as *const u8;
    let tag: u64 = read_type_code(obj);
    if !is_known_tag(tag) {
        state.error = CheckError::BadTag;
        return false;
    }

    let tagged_obj: &tagged<HermesTypeTagSystem> HermesCheck = obj;
    return tagged_obj.check_obj(state);
}

// ---------------------------------------------------------------------------
// anyval_check (kept for compatibility with external callers)
// ---------------------------------------------------------------------------

pub unsafe fn anyval_check(val: AnyVal, state: *mut CheckState) -> bool {
    return anyval_check_one(val, state);
}

// ---------------------------------------------------------------------------
// Document-level entry point
// ---------------------------------------------------------------------------

pub unsafe fn document_check(zone: *const Zone<Mutable>) -> bool {
    if zone == 0 as *const Zone<Mutable> { return true; }
    let holder: *mut MemHolder = zone.holder;
    if holder == 0 as *mut MemHolder { return true; }

    let zone_sz: i64 = holder.used;
    if zone_sz == 0 as i64 { return true; }
    if zone_sz < 8 as i64  { return false; }

    let base: *const u8 = holder.base as *const u8;
    if base == 0 as *const u8 { return false; }

    let mut state: CheckState = check_state_create(base, zone_sz);
    if state.visited == 0 as *mut u8 { return false; }
    if state.queue == 0 as *mut u32 {
        check_state_free(&mut state);
        return false;
    }

    // Mark DocumentHeader (untagged, 8 bytes at offset 0).
    if !check_mark(&mut state, 0 as i64, 8 as i64) {
        check_state_free(&mut state);
        return false;
    }

    // Push root into queue and process iteratively.
    let doc: *const DocumentHeader = base as *const DocumentHeader;
    let root: AnyVal = document_get_root(doc);
    if !check_push_val(&mut state, root) {
        check_state_free(&mut state);
        return false;
    }

    let mut ok: bool = true;
    while state.queue_len > 0 as i64 && ok {
        // Pop from the end (DFS order).
        state.queue_len = state.queue_len - 1 as i64;
        let rp: *const u32 = (state.queue as i64 + state.queue_len * 4 as i64) as *const u32;
        let raw: u32 = *rp;
        let val: AnyVal = AnyVal { raw: raw };
        ok = anyval_check_one(val, &mut state);
    }

    check_state_free(&mut state);
    return ok;
}

// ── ArrayU64 (108): 24-byte header + capacity*8 u64 data (no AnyVal refs)

impl HermesCheck for ArrayU64 {
    pub fn check_obj(&self, state: *mut CheckState) -> bool {
        unsafe {
            let arr: *const ArrayU64 = self as *const ArrayU64;
            let obj: *const u8 = arr as *const u8;
            let off: i64 = (obj as i64) - (state.base as i64);
            let hdr_sz: i64 = sizeof::<ArrayU64>() as i64;
            if !check_bounds(state, off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            if !check_mark(state,  off - 1 as i64, 1 as i64 + hdr_sz) { return false; }
            check_mark_start(state, off - 1 as i64);

            let sz: u64  = arr.size;
            let cap: u64 = arr.capacity;
            if sz > cap {
                state.error = CheckError::BadSize;
                return false;
            }
            let buf_off: i64   = arr.data as i64;
            let buf_bytes: i64 = (cap as i64) * 8 as i64;
            if buf_bytes > 0 as i64 {
                if !check_bounds(state, buf_off, buf_bytes) { return false; }
                if !check_mark(state,  buf_off, buf_bytes)  { return false; }
            }
            return true;
        }
    }
}
