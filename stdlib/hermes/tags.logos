// Logos Hermes stdlib — hermes.tags
//
// Central registry of Hermes type codes.  Each datatype in the stdlib binds
// its #[type_code] attribute to a variant of this enum so all assignments
// live in one place.
//
// Reserved ranges:
//   0          — null / unset
//   1..127     — inline-AnyVal type codes (tag fits in 7 bits)
//   128..222   — single-byte zone tags
//   223+       — multi-byte zone tags (56-bit hash-derived)

package hermes.tags;

pub enum HermesTag {
    // Document root (special).
    Document     = 3,

    // Scalar zone datatypes.
    I8           = 20,
    U8           = 21,
    I16          = 22,
    I24          = 23,
    U16          = 24,
    U24          = 25,
    I64          = 26,
    U64          = 27,
    HermesString = 28,
    F32          = 30,
    F64          = 31,
    Bool         = 37,

    // Containers and composite datatypes.
    TinyObjectMap = 98,   // Map<Bitmap, AnyVal>
    Array         = 100,  // Array<AnyVal> (generic, untyped elements)
    ObjectMap     = 101,  // Map<HermesString, AnyVal>
    ArrayI32      = 104,
    MapI32AnyVal  = 105,
    TypedValue    = 106,
    Decimal       = 107,
    ArrayU64      = 108,
}
