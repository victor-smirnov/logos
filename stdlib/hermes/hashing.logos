// Logos Hermes stdlib — hermes.hashing
//
// Structural hash for Hermes zone documents.
//
// The per-type impl returns a u64 seeded from the type_code so that two
// values with different types but the same payload bytes don't collide.
// Containers mix child hashes via FNV-1a round so that ordering within the
// container is respected (arrays: element order; ObjectMap: insertion
// order isn't — we commute per-entry contributions by XOR).

package hermes.hashing;

use hermes.anyval;
use hermes.string;
use hermes.typetag;
use hermes.tag_system;
use hermes.containers;
use hermes.objectmap;
use hermes.document;
use hermes.scalar;
use hermes.decimal;

pub struct HashCtx {
    pub base: *const u8,
}

#[tag_dispatch(HermesTypeTagSystem)]
pub trait HermesHash {
    fn hash_value(&self, ctx: *mut HashCtx) -> u64;
}

// FNV-1a mixing primitives.
pub unsafe fn fnv_init() -> u64 {
    return 14695981039346656037;
}
pub unsafe fn fnv_mix_u64(h: u64, v: u64) -> u64 {
    let mut x: u64 = h;
    let mut i: i64 = 0;
    while i < 8 {
        let byte: u64 = (v >> (i as u64 * 8)) & 0xFF;
        x = x ^ byte;
        x = x * 1099511628211;
        i = i + 1;
    }
    return x;
}
unsafe fn fnv_mix_byte(h: u64, b: u8) -> u64 {
    let mut x: u64 = h ^ b as u64;
    x = x * 1099511628211;
    return x;
}

// ── AnyVal-level hash ─────────────────────────────────────────────────────

pub unsafe fn anyval_hash(val: AnyVal, ctx: *mut HashCtx) -> u64 {
    if val.is_null() {
        return fnv_mix_u64(fnv_init(), 0);
    }
    if !val.is_ptr() {
        // Inline: mix raw bits (type_hash + payload).
        return fnv_mix_u64(fnv_init(), val.raw as u64);
    }
    let obj: *const u8 = ctx.base.byte_add(val.as_offset() as i64);
    let th: &tagged<HermesTypeTagSystem> HermesHash = obj;
    return th.hash_value(ctx);
}

// ── HermesString (28) ─────────────────────────────────────────────────────

impl HermesHash for HermesString {
    pub fn hash_value(&self, ctx: *mut HashCtx) -> u64 {
        unsafe {
            let a: *const HermesString = self;
            // Bug fix: mix full u64 type_code, not just the low byte.
            // fnv_mix_byte would drop bits >7 and make tier-2 codes collide.
            let mut h: u64 = fnv_mix_u64(fnv_init(), 28);
            let len: u64 = a.len();
            h = fnv_mix_u64(h, len);
            let bp: *const u8 = a.bytes();
            let mut i: u64 = 0;
            while i < len {
                let c: u8 = *bp.byte_add(i as i64);
                h = fnv_mix_byte(h, c);
                i = i + 1;
            }
            return h;
        }
    }
}

// ── Raw primitive scalars (used by Array<T> blanket when T is known) ──────

impl HermesHash for i32 {
    pub fn hash_value(&self, ctx: *mut HashCtx) -> u64 {
        unsafe { return fnv_mix_u64(fnv_init(), *self as u64); }
    }
}

impl HermesHash for u64 {
    pub fn hash_value(&self, ctx: *mut HashCtx) -> u64 {
        unsafe { return fnv_mix_u64(fnv_init(), *self); }
    }
}

// ── I64 (26) / U64 (27) ───────────────────────────────────────────────────

impl HermesHash for I64 {
    pub fn hash_value(&self, ctx: *mut HashCtx) -> u64 {
        unsafe {
            let a: *const I64 = self;
            let h0: u64 = fnv_mix_u64(fnv_init(), 26);
            return fnv_mix_u64(h0, a.value() as u64);
        }
    }
}

impl HermesHash for U64 {
    pub fn hash_value(&self, ctx: *mut HashCtx) -> u64 {
        unsafe {
            let a: *const U64 = self;
            let h0: u64 = fnv_mix_u64(fnv_init(), 27);
            return fnv_mix_u64(h0, a.value());
        }
    }
}

impl HermesHash for Decimal {
    pub fn hash_value(&self, ctx: *mut HashCtx) -> u64 {
        unsafe {
            let d: *const Decimal = self;
            let mut h: u64 = fnv_mix_u64(fnv_init(), 107);
            h = fnv_mix_u64(h, d.spec_and_len as u64);
            let n: u32 = d.len();
            let mut i: u32 = 0;
            while i < n {
                h = fnv_mix_u64(h, d.limb_at(i) as u64);
                i = i + 1;
            }
            return h;
        }
    }
}

// ── AnyVal: internal dispatch through tag bits / zone pointer ─────────────

impl HermesHash for AnyVal {
    pub fn hash_value(&self, ctx: *mut HashCtx) -> u64 {
        unsafe { return anyval_hash(AnyVal { raw: (self).raw }, ctx); }
    }
}

// ── Array<T>: order-sensitive element mix for any T: HermesHash ───────────

impl<T: HermesHash> HermesHash for Array<T> {
    pub fn hash_value(&self, ctx: *mut HashCtx) -> u64 {
        unsafe {
            let a: *const Array<T> = self as *const Array<T>;
            let n: u64 = a.size;
            let mut h: u64 = fnv_mix_u64(fnv_init(), 100);
            h = fnv_mix_u64(h, n);
            let buf: *const T = ctx.base.byte_add(a.data.offset) as *const T;
            let mut i: u64 = 0;
            while i < n {
                let e: *const T = buf.add(i as i64);
                h = fnv_mix_u64(h, e.hash_value(ctx));
                i = i + 1;
            }
            return h;
        }
    }
}

// ── Map<Bitmap, V> blanket — key-order-independent mix via XOR ────────────

impl<V: HermesHash> HermesHash for Map<Bitmap, V> {
    pub fn hash_value(&self, ctx: *mut HashCtx) -> u64 {
        unsafe {
            let a: *const Map<Bitmap, V> = self as *const Map<Bitmap, V>;
            let tc: u64 = type_code_of::<Map<Bitmap, V>>();
            let base_h: u64 = fnv_mix_u64(fnv_init(), tc);
            let mut acc: u64 = 0;
            let mask: u64 = 0x000FFFFFFFFFFFFF;
            let bitmap: u64 = a.header & mask;
            acc = acc ^ fnv_mix_u64(base_h, bitmap);
            let arr_base: *const V = ctx.base.byte_add(a.data.offset) as *const V;
            let mut key: u8 = 0;
            while key < 52 {
                let key_bit: u64 = 1 << key as u64;
                if (bitmap & key_bit) != 0 {
                    let m: u64 = key_bit - 1;
                    let pos: u32 = popcount_u64(bitmap & m);
                    let v: *const V = arr_base.add(pos as i64);
                    let per: u64 = fnv_mix_u64(
                        fnv_mix_byte(base_h, key),
                        v.hash_value(ctx));
                    acc = acc ^ per;
                }
                key = key + 1;
            }
            return acc;
        }
    }
}

// ── ObjectMap (101): key-order-independent mix via XOR ────────────────────

impl HermesHash for ObjectMap {
    pub fn hash_value(&self, ctx: *mut HashCtx) -> u64 {
        unsafe {
            let a: *const ObjectMap = self;
            let base_h: u64 = fnv_mix_u64(fnv_init(), 101);
            let mut acc: u64 = 0;
            acc = acc ^ fnv_mix_u64(base_h, a.count as u64);
            let cap: u32 = a.capacity;
            let ent_base: *const MapEntry =
                ctx.base.byte_add(a.entries_off.offset as i64) as *const MapEntry;
            let mut slot: u32 = 0;
            while slot < cap {
                let ep: *const MapEntry = ent_base.add(slot as i64);
                if ep.key_off.offset != 0 {
                    let hs: *const HermesString =
                        ctx.base.byte_add(ep.key_off.offset as i64) as *const HermesString;
                    let mut kh: u64 = base_h;
                    let klen: u64 = hs.len();
                    kh = fnv_mix_u64(kh, klen);
                    let kb: *const u8 = hs.bytes();
                    let mut i: u64 = 0;
                    while i < klen {
                        kh = fnv_mix_byte(kh, *kb.byte_add(i as i64));
                        i = i + 1;
                    }
                    let v: AnyVal = AnyVal { raw: ep.val };
                    let per: u64 = fnv_mix_u64(kh, anyval_hash(v, ctx));
                    acc = acc ^ per;
                }
                slot = slot + 1;
            }
            return acc;
        }
    }
}

// ── TypedValue (106): type name + params + initializer ───────────────────

impl HermesHash for TypedValue {
    pub fn hash_value(&self, ctx: *mut HashCtx) -> u64 {
        unsafe {
            let tv: *const TypedValue = self;
            let hs: *const HermesString =
                ctx.base.byte_add(tv.type_off.offset as i64) as *const HermesString;
            let mut h: u64 = fnv_mix_u64(fnv_init(), 106);
            let n: u64 = hs.len();
            h = fnv_mix_u64(h, n);
            let bp: *const u8 = hs.bytes();
            let mut i: u64 = 0;
            while i < n {
                h = fnv_mix_byte(h, *bp.byte_add(i as i64));
                i = i + 1;
            }
            h = fnv_mix_u64(h, anyval_hash(AnyVal { raw: tv.params_raw }, ctx));
            h = fnv_mix_u64(h, anyval_hash(AnyVal { raw: tv.init_raw }, ctx));
            return h;
        }
    }
}
