// Logos Hermes stdlib — hermes.ctr
//
// HermesCtr — owning container for a Hermes document.
//
// Encapsulates zone allocation and text parsing.
// The user creates an HermesCtr, parses text into it, then traverses
// the result via root(), array_get(), map_get_cstr(), etc.
// Stringification uses a temporary buffer passed as a parameter.
// All unsafe zone/pointer work is internal.
//
// Drop: HermesCtr implements Drop and calls zone.release() to clean up
// the reference-counted MemHolder. The zone's lifetime is tied to HermesCtr.
//
// Usage:
//   let mut doc: HermesCtr = HermesCtr::new(8192);
//   match doc.parse(text, len) {
//       Result::Ok(())  => {}
//       Result::Err(_)  => { return 1; }
//   }
//   let root: AnyVal = doc.root();  // access parsed document
//   let mut buf: String = String::with_capacity(256);
//   doc.stringify(&mut buf);  // stringify into temporary buffer

package hermes.ctr;

use hermes.zone;
use hermes.anyval;
use hermes.datatag;
use hermes.containers;
use hermes.objectmap;
use hermes.typetag;
use hermes.tag_system;
use hermes.document;
use hermes.parser;
use hermes.scalar;
use hermes.decimal;
use hermes.stringify;
use hermes.clone;
use hermes.check;
use hermes.hbs_write;
use hermes.hbs_read;
use hermes.mem_holder;
use std.string;
use std.drop;

// cstr_len — byte length of a null-terminated C string.
unsafe fn cstr_len(s: *const u8) -> i64 {
    let mut n: i64 = 0 as i64;
    while *((s as i64 + n) as *const u8) != 0 as u8 {
        n = n + 1 as i64;
    }
    return n;
}

// POSIX write(2) — fd 1 = stdout.
extern fn write(fd: i32, buf: *const u8, count: i64) -> i64;

// ---------------------------------------------------------------------------
// Result / ParseError
// ---------------------------------------------------------------------------

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

pub enum ParseError {
    Failed,
}

// ---------------------------------------------------------------------------
// HermesCtr
// ---------------------------------------------------------------------------

pub struct HermesCtr {
    zone: Zone<Mutable>,
}

impl HasMemHolder for HermesCtr {
    pub fn mem_holder(&self) -> *mut MemHolder {
        return self.zone.holder;
    }
}

impl Drop for HermesCtr {
    fn drop(self: HermesCtr) {
        unsafe {
            let zone_ptr: *mut Zone<Mutable> =
                (&self.zone as *const Zone<Mutable>) as *mut Zone<Mutable>;
            zone_ptr.release();
        }
    }
}

impl HermesCtr {
    // Allocate a new container backed by a zone of `capacity` bytes.
    // Used when you will parse a document into the zone (parser creates DocumentHeader).
    pub static fn new(capacity: i64) -> HermesCtr {
        unsafe {
            return HermesCtr {
                zone: zone_create(capacity),
            };
        }
    }

    // For building a document programmatically (without parsing).
    // Pre-allocates the DocumentHeader at zone offset 0.
    pub static fn builder(capacity: i64) -> HermesCtr {
        unsafe {
            let mut zone: Zone<Mutable> = zone_create(capacity);
            let hdr_raw: *mut u8 = zone_m_alloc_raw(&mut zone, 8);
            // Guard: alloc_raw returns null if capacity is too small (< 8 bytes).
            // Without this check, document_create(null) would write to address 0.
            if hdr_raw != 0 as *mut u8 {
                document_create(hdr_raw);
            }
            return HermesCtr {
                zone: zone,
            };
        }
    }

    // Parse Hermes text (UTF-8 bytes) into the zone.
    // Returns Ok(()) on success, Err(ParseError::Failed) on parse error.
    pub fn parse(&mut self, text: *const u8, len: i64) -> Result<(), ParseError> {
        unsafe {
            if hermes_parse(text, len, &mut self.zone) {
                return Result::Ok(());
            }
            return Result::Err(ParseError::Failed);
        }
    }

    // C-string convenience overload.
    pub fn parse(&mut self, text: *const u8) -> Result<(), ParseError> {
        if text == 0 as *const u8 { return Result::Err(ParseError::Failed); }
        unsafe {
            return self.parse(text, cstr_len(text));
        }
    }

    // StringView convenience overload.
    pub fn parse(&mut self, text: StringView) -> Result<(), ParseError> {
        return self.parse(text.ptr, text.len as i64);
    }

    // ── Stringification ────────────────────────────────────────────────────
    //
    // Buffer is a per-operation context — pass in a String you own; it gets
    // cleared and overwritten.  HermesCtr itself holds no buffer.

    // Stringify into `buf` with compact formatting.
    pub fn stringify(&self, buf: &mut String) {
        unsafe {
            buf.clear();
            stringify_document(self.zone.holder.base as *const u8, buf,
                               StringifyOpts::compact());
        }
    }

    // Stringify into `buf` with explicit formatting options.
    pub fn stringify_opts(&self, buf: &mut String, opts: StringifyOpts) {
        unsafe {
            buf.clear();
            stringify_document(self.zone.holder.base as *const u8, buf, opts);
        }
    }

    // Stringify and return a new owned String (compact).
    pub fn to_string(&self) -> String {
        let mut buf: String = String::with_capacity(256);
        self.stringify(&mut buf);
        return buf;
    }

    // Stringify and return a new owned String with explicit options.
    pub fn to_string_opts(&self, opts: StringifyOpts) -> String {
        let mut buf: String = String::with_capacity(256);
        self.stringify_opts(&mut buf, opts);
        return buf;
    }

    // Raw zone base pointer (for cross-zone operations such as clone/equal).
    pub fn base(&self) -> *const u8 {
        unsafe { return self.zone.holder.base as *const u8; }
    }

    // Mutable reference to the underlying zone (for cross-zone clone-in).
    pub fn zone_mut(&mut self) -> *mut Zone<Mutable> {
        unsafe { return &mut self.zone as *mut Zone<Mutable>; }
    }

    // Root AnyVal of the parsed document.
    pub fn root(&self) -> AnyVal {
        unsafe {
            let base: *mut u8 = self.zone.holder.base;
            let doc: *const DocumentHeader = base as *const DocumentHeader;
            return document_get_root(doc);
        }
    }

    // ── Value extraction helpers ───────────────────────────────────────────────

    // Return i64 value of an Integer AnyVal (hash=23). Returns 0 if not int.
    pub fn get_int(&self, val: AnyVal) -> i64 {
        unsafe { return val.as_i64(); }
    }

    // Return bool value of a Boolean AnyVal (hash=37). Returns false if not bool.
    pub fn get_bool(&self, val: AnyVal) -> bool {
        unsafe {
            if !val.is_bool() { return false; }
            return val.as_bool();
        }
    }

    // ── StringView accessor (interop with Buffer<HermesString>) ───────────────

    // Extract a StringView from a zone-stored HermesString.  This is the same
    // view type `Buffer<HermesString>` exposes, so callers can write storage-
    // agnostic code (pass a StringView and forget where it came from).
    // Returns StringView{null, 0} if `val` is not a pointer-mode string.
    pub fn get_str_view(&self, val: AnyVal) -> StringView {
        unsafe {
            let base: *mut u8 = self.zone.holder.base;
            if !val.is_string(base as *const u8) {
                return StringView { ptr: 0 as *const u8, len: 0 as u64 };
            }
            let hs: *const HermesString =
                (base as i64 + val.as_offset() as i64) as *const HermesString;
            return StringView { ptr: hs.bytes(), len: hs.len() };
        }
    }

    // ── Scalar builders / accessors ───────────────────────────────────────────

    // Allocate a zone-backed I64. Use this when the value doesn't fit inline
    // (Integer is capped at 24 bits) or when a stable pointer is needed.
    pub fn build_i64(&mut self, v: i64) -> AnyVal {
        unsafe {
            let sz: i64 = sizeof::<I64>() as i64;
            let raw: *mut u8 = zone_m_alloc_tagged(&mut self.zone, sz,
                                   hermes_tag_i64() as u64);
            if raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            I64::init(raw, v);
            let base: *mut u8 = self.zone.holder.base;
            let off: u32 = (raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    pub fn build_u64(&mut self, v: u64) -> AnyVal {
        unsafe {
            let sz: i64 = sizeof::<U64>() as i64;
            let raw: *mut u8 = zone_m_alloc_tagged(&mut self.zone, sz,
                                   hermes_tag_u64() as u64);
            if raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            U64::init(raw, v);
            let base: *mut u8 = self.zone.holder.base;
            let off: u32 = (raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    // ── Decimal builders / accessors ───────────────────────────────────────

    // Parse decimal text into a zone Decimal(P,S). Returns null on parse/overflow error.
    pub fn decimal_from(&mut self, p: i32, s: i32,
                        txt: *const u8, len: i64) -> AnyVal {
        unsafe {
            return decimal_from_string_in_zone(&mut self.zone, p, s, txt, len);
        }
    }

    // C-string overload.
    pub fn decimal_from(&mut self, p: i32, s: i32, txt: *const u8) -> AnyVal {
        if txt == 0 as *const u8 { return AnyVal::null_ptr(); }
        unsafe {
            return self.decimal_from(p, s, txt, cstr_len(txt));
        }
    }

    // StringView overload.
    pub fn decimal_from(&mut self, p: i32, s: i32, txt: StringView) -> AnyVal {
        return self.decimal_from(p, s, txt.ptr, txt.len as i64);
    }

    // f64 overload: build Decimal(p,s) from f64, rounding half-up.
    // Returns null on NaN/Inf, precision overflow, or |val * 10^s| >= 2^53.
    pub fn decimal_from(&mut self, p: i32, s: i32, val: f64) -> AnyVal {
        unsafe {
            return decimal_from_f64_in_zone(&mut self.zone, p, s, val);
        }
    }

    pub fn decimal_view(&self, val: AnyVal) -> DecimalView {
        unsafe {
            return DecimalView::from_anyval(self.zone.holder.base as *const u8, val);
        }
    }

    pub fn decimal_to_string(&self, val: AnyVal) -> String {
        unsafe { return self.decimal_view(val).to_string_value(); }
    }

    pub fn decimal_to_f64(&self, val: AnyVal) -> f64 {
        unsafe { return self.decimal_view(val).to_f64(); }
    }

    pub fn decimal_add(&mut self, a: AnyVal, b: AnyVal) -> AnyVal {
        unsafe {
            return decimal_add_in_zone(&mut self.zone, a, b);
        }
    }

    pub fn decimal_sub(&mut self, a: AnyVal, b: AnyVal) -> AnyVal {
        unsafe {
            return decimal_sub_in_zone(&mut self.zone, a, b);
        }
    }

    pub fn decimal_precision(&self, val: AnyVal) -> u32 {
        unsafe { return self.decimal_view(val).precision(); }
    }

    pub fn decimal_scale(&self, val: AnyVal) -> u32 {
        unsafe { return self.decimal_view(val).scale(); }
    }

    pub fn decimal_len(&self, val: AnyVal) -> u32 {
        unsafe { return self.decimal_view(val).len(); }
    }

    pub fn decimal_is_negative(&self, val: AnyVal) -> bool {
        unsafe { return self.decimal_view(val).is_negative(); }
    }

    pub fn decimal_limb(&self, val: AnyVal, idx: u32) -> u32 {
        unsafe { return self.decimal_view(val).limb_at(idx); }
    }

    // Extract an i64 from either an inline Integer (hash=23) or a zone I64
    // (type_code=26). Returns 0 if val is neither.
    pub fn get_i64(&self, val: AnyVal) -> i64 {
        unsafe {
            if !val.is_ptr() {
                if val.is_int() { return val.as_i24() as i64; }
                return 0 as i64;
            }
            if val.is_null() { return 0 as i64; }
            let base: *mut u8 = self.zone.holder.base;
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag: u64 = read_type_code(obj);
            if tag != 26 as u64 { return 0 as i64; }
            let p: *const I64 = obj as *const I64;
            return p.value();
        }
    }

    // Extract a u64 from either an inline UInteger (hash=25) or a zone U64
    // (type_code=27). Returns 0 if val is neither.
    pub fn get_u64(&self, val: AnyVal) -> u64 {
        unsafe {
            if !val.is_ptr() {
                if val.is_uint() { return val.as_u24() as u64; }
                return 0 as u64;
            }
            if val.is_null() { return 0 as u64; }
            let base: *mut u8 = self.zone.holder.base;
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag: u64 = read_type_code(obj);
            if tag != 27 as u64 { return 0 as u64; }
            let p: *const U64 = obj as *const U64;
            return p.value();
        }
    }

    // ── Array traversal ───────────────────────────────────────────────────────

    // Number of elements in an ObjectArray AnyVal. Returns 0 if val is not an array.
    pub fn array_len(&self, val: AnyVal) -> u64 {
        unsafe {
            let base: *mut u8 = self.zone.holder.base;
            if !val.is_array(base as *const u8) { return 0 as u64; }
            let arr: *const ObjectArray =
                (base as i64 + val.as_offset() as i64) as *const ObjectArray;
            return arr.len();
        }
    }

    // Get element at `idx` from an ObjectArray AnyVal.
    // Returns AnyVal::null_ptr() if val is not an array or idx is out of bounds.
    pub fn array_get(&self, val: AnyVal, idx: u64) -> AnyVal {
        unsafe {
            let base: *mut u8 = self.zone.holder.base;
            if !val.is_array(base as *const u8) { return AnyVal::null_ptr(); }
            let arr: *const ObjectArray =
                (base as i64 + val.as_offset() as i64) as *const ObjectArray;
            return arr.get(base as *const u8, idx);
        }
    }

    // ── Map traversal ─────────────────────────────────────────────────────────

    // Look up a key in an ObjectMap AnyVal by null-terminated C string.
    // Returns AnyVal::null_ptr() if val is not a map or key is not found.
    pub fn map_get_cstr(&self, val: AnyVal, key: *const u8) -> AnyVal {
        unsafe {
            let base: *mut u8 = self.zone.holder.base;
            if !val.is_map(base as *const u8) { return AnyVal::null_ptr(); }
            // Read the descriptor to distinguish TinyObjectMap (hash=98) from
            // ObjectMap (hash=101). TinyObjectMap uses numeric keys only;
            // for string lookups we treat it as not found.
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag_hash: u64 = read_type_code(obj);
            if tag_hash == hermes_tag_tiny_map() as u64 {
                // TinyObjectMap: keys are u8 integers, not strings.
                return AnyVal::null_ptr();
            }
            // ObjectMap (hash=101): open-addressing, string keys.
            let omap: *const ObjectMap = obj as *const ObjectMap;
            let klen: i64 = cstr_len(key);
            return omap.get(base as *const u8, key, klen as u64);
        }
    }

    // Convenience overloads over map_get_cstr/map_set_str for "normal" string usage.
    pub fn map_get(&self, val: AnyVal, key: *const u8) -> AnyVal {
        if key == 0 as *const u8 { return AnyVal::null_ptr(); }
        return self.map_get_cstr(val, key);
    }

    pub fn map_get(&self, val: AnyVal, key: StringView) -> AnyVal {
        unsafe {
            let base: *mut u8 = self.zone.holder.base;
            if !val.is_map(base as *const u8) { return AnyVal::null_ptr(); }
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag_hash: u64 = read_type_code(obj);
            if tag_hash == 98 as u64 {
                return AnyVal::null_ptr();
            }
            let omap: *const ObjectMap = obj as *const ObjectMap;
            return omap.get(base as *const u8, key.ptr, key.len);
        }
    }

    // ── Document mutation API ──────────────────────────────────────────────────

    // Allocate a HermesString in the zone from a raw byte pointer + length.
    // Returns an AnyVal in pointer mode pointing to the string.
    // Returns AnyVal::null_ptr() on OOM.
    pub fn build_str(&mut self, s: *const u8, slen: i64) -> AnyVal {
        // Bug 2 guard: negative slen wraps to u64::MAX, making vlen_encode_size
        // return 8 and total = 7, then HermesString::init tries to copy ~2^64 bytes.
        if slen < 0 { return AnyVal::null_ptr(); }
        unsafe {
            let len: u64 = slen as u64;
            // vlen prefix size varies: 1 byte for len < 249, more for larger strings.
            let prefix_sz: i64 = vlen_encode_size(len) as i64;
            let total: i64 = prefix_sz + slen;
            let raw: *mut u8 = zone_m_alloc_tagged(&mut self.zone, total, hermes_tag_string() as u64);
            if raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            // HermesString::init writes the correct vlen prefix and copies the bytes.
            HermesString::init(raw, s, len);
            let base: *mut u8 = self.zone.holder.base;
            let off: u32 = (raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    // C-string convenience overload.
    pub fn build_str(&mut self, s: *const u8) -> AnyVal {
        if s == 0 as *const u8 { return AnyVal::null_ptr(); }
        unsafe {
            return self.build_str(s, cstr_len(s));
        }
    }

    // StringView convenience overload.
    pub fn build_str(&mut self, s: StringView) -> AnyVal {
        return self.build_str(s.ptr, s.len as i64);
    }

    // Allocate an ObjectMap in the zone with `cap_slots` hash slots.
    // cap_slots must be a power of 2 and >= 4.
    // Returns AnyVal pointer to the map, or null_ptr on OOM.
    pub fn build_map(&mut self, cap_slots: u32) -> AnyVal {
        unsafe {
            let map_sz: i64 = 16 as i64;  // sizeof ObjectMap
            let map_raw: *mut u8 = zone_m_alloc_tagged(&mut self.zone,
                map_sz, hermes_tag_map() as u64);
            if map_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let entries_raw: *mut u8 = zone_m_alloc_raw(&mut self.zone, cap_slots as i64 * 8 as i64);
            if entries_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let base: *mut u8 = self.zone.holder.base;
            ObjectMap::init(map_raw, base, entries_raw, cap_slots);
            let off: u32 = (map_raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    // Allocate an ObjectArray in the zone with `cap` initial capacity.
    // Returns AnyVal pointer to the array, or null_ptr on OOM.
    pub fn build_array(&mut self, cap: u64) -> AnyVal {
        unsafe {
            let oa_sz: i64 = 24 as i64;  // sizeof ObjectArray
            let oa_raw: *mut u8 = zone_m_alloc_tagged(&mut self.zone,
                oa_sz, hermes_tag_array() as u64);
            if oa_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let buf_raw: *mut u8 = zone_m_alloc_raw(&mut self.zone, cap as i64 * 4 as i64);
            if buf_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let base: *mut u8 = self.zone.holder.base;
            ObjectArray::init(oa_raw, buf_raw, base, cap);
            let off: u32 = (oa_raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    // Set key → val in a map AnyVal.
    // key is a C string pointer; klen is its byte length (NOT counting null).
    pub fn map_set_str(&mut self, map: AnyVal, key: *const u8, klen: i64, val: AnyVal) {
        // Bug 3 guard: negative klen wraps to u64::MAX, making hermes_fnv1a read
        // ~2^64 bytes from key → out-of-bounds memory access / crash.
        if klen < 0 { return; }
        unsafe {
            let base: *mut u8 = self.zone.holder.base;
            if !map.is_map(base as *const u8) { return; }
            let omap: *mut ObjectMap =
                (base as i64 + map.as_offset() as i64) as *mut ObjectMap;
            // Only allocate a new HermesString if the key is new.
            // On update, ObjectMap::set finds the slot via byte comparison and updates
            // only the value — it never writes key_off. So any non-zero dummy suffices.
            // Default to sentinel 1 (non-zero, used only on the update path).
            let mut key_off: u32 = 1 as u32;
            if !omap.contains(base as *const u8, key, klen as u64) {
                let key_av: AnyVal = self.build_str(key, klen);
                if key_av.is_null() { return; }
                key_off = key_av.as_offset();
            }
            omap.set(base, key_off, key, klen as u64, val);
        }
    }

    pub fn map_set(&mut self, map: AnyVal, key: *const u8, val: AnyVal) {
        if key == 0 as *const u8 { return; }
        unsafe {
            self.map_set_str(map, key, cstr_len(key), val);
        }
    }

    pub fn map_set(&mut self, map: AnyVal, key: StringView, val: AnyVal) {
        self.map_set_str(map, key.ptr, key.len as i64, val);
    }

    // Push val onto an array AnyVal.
    pub fn array_push(&mut self, arr: AnyVal, val: AnyVal) {
        unsafe {
            let base: *mut u8 = self.zone.holder.base;
            if !arr.is_array(base as *const u8) { return; }
            let oa: *mut ObjectArray =
                (base as i64 + arr.as_offset() as i64) as *mut ObjectArray;
            oa.push(base, val);
        }
    }

    // Set the document root to val.
    // Only valid after builder() constructor or a successful parse().
    pub fn set_root(&mut self, val: AnyVal) {
        unsafe {
            let base: *mut u8 = self.zone.holder.base;
            let doc: *mut DocumentHeader = base as *mut DocumentHeader;
            document_set_root(doc, val);
        }
    }

    // Deep-copy all objects reachable from the document root into a fresh zone,
    // discarding unreachable (garbage) objects.  Returns a new HermesCtr that
    // owns the compacted zone.
    //
    // capacity_hint: initial byte capacity for the destination zone.
    //   Pass 0 to auto-size from the source zone's current usage.
    pub fn compactify(&self, capacity_hint: i64) -> HermesCtr {
        unsafe {
            let new_zone: Zone<Mutable> =
                document_compactify(&self.zone, capacity_hint);
            return HermesCtr { zone: new_zone };
        }
    }

    // Convenience overload: auto-size destination zone from source usage.
    pub fn compactify(&self) -> HermesCtr {
        return self.compactify(0 as i64);
    }

    // Raw byte-copy of the zone (O(used), preserves garbage).
    // Faster than compactify(); use when you want a quick snapshot.
    pub fn clone(&self) -> HermesCtr {
        unsafe {
            return HermesCtr { zone: document_clone(&self.zone) };
        }
    }

    // ── Import / export across containers ─────────────────────────────────────
    //
    // import_from: deep-copy the object graph reachable from `src_val` out of
    // `src`'s zone into `self`'s zone. Returns an AnyVal whose offset is valid
    // in `self`. The returned handle is orphaned — unless the caller inserts it
    // somewhere reachable from the document root (or keeps it alive outside the
    // zone), the next compactify() will treat the imported subgraph as garbage.
    // Returns AnyVal::null_ptr() if `src` is null or a zone allocation fails.
    //
    // Inline AnyVals (ints, bools, etc.) are passed through unchanged — they
    // carry no zone reference.
    pub fn import_from(&mut self, src: *const HermesCtr, src_val: AnyVal) -> AnyVal {
        if src == 0 as *const HermesCtr { return AnyVal::null_ptr(); }
        unsafe {
            // Bug 1 guard: self-import would alias src and dst zones.  A grow
            // of the dst backing buffer during anyval_clone would invalidate
            // the captured `base_src`, causing reads from freed memory.
            let self_ptr: *const HermesCtr = self as *const HermesCtr;
            if src == self_ptr { return AnyVal::null_ptr(); }

            let src_holder: *mut MemHolder = src.zone.holder;
            if src_holder == 0 as *mut MemHolder { return AnyVal::null_ptr(); }

            // Bug 2 guard: holder may be non-null with a null backing buffer
            // (memholder_alloc_backed OOM path).
            let src_base: *mut u8 = src_holder.base;
            if src_base == 0 as *mut u8 { return AnyVal::null_ptr(); }

            // Bug 3 guard: destination must have a live zone or allocations
            // inside anyval_clone dereference a null holder.
            let dst_holder: *mut MemHolder = self.zone.holder;
            if dst_holder == 0 as *mut MemHolder { return AnyVal::null_ptr(); }

            let mut clone_map: CloneMap = clone_map_create();
            if clone_map.keys == 0 as *mut u32 { return AnyVal::null_ptr(); }
            let mut ctx: CloneCtx = CloneCtx {
                base_src: src_base as *const u8,
                zone_dst: &mut self.zone as *mut Zone<Mutable>,
                map: &mut clone_map,
            };
            let result: AnyVal = anyval_clone(src_val, &mut ctx);
            clone_map_free(&mut clone_map);
            return result;
        }
    }

    // export: build a fresh container holding only the subgraph reachable from
    // `src_val`, with the cloned root already installed in the destination's
    // DocumentHeader. This is the second half of import/export: no manual
    // wiring is required by the caller.
    //
    // capacity_hint: initial byte capacity for the destination zone.
    //   Pass 0 to auto-size from this container's `used` bytes (an upper bound
    //   — the subgraph may be strictly smaller, in which case compactify()
    //   later can trim further).
    //
    // Returns a container with a null holder on OOM of the destination zone.
    pub fn export(&self, src_val: AnyVal, capacity_hint: i64) -> HermesCtr {
        unsafe {
            let cap: i64 = if capacity_hint > 0 as i64 {
                capacity_hint
            } else {
                let h: *mut MemHolder = self.zone.holder;
                if h == 0 as *mut MemHolder {
                    64 as i64
                } else {
                    let u: i64 = h.used;
                    if u < 64 as i64 { 64 as i64 } else { u }
                }
            };
            let mut new_ctr: HermesCtr = HermesCtr::builder(cap);
            // Single-return structure: every branch falls through to `return
            // new_ctr`. This keeps the borrow checker happy about a Drop type
            // that would otherwise be "moved" by an early-return inside `if`.
            let dst_holder: *mut MemHolder = new_ctr.zone.holder;
            let src_holder: *mut MemHolder = self.zone.holder;
            // Bug 5 guard: source holder non-null but with null backing — do
            // not dereference garbage. Also Bug 3 guard for dst holder.
            let src_base: *mut u8 = if src_holder == 0 as *mut MemHolder {
                0 as *mut u8
            } else {
                src_holder.base
            };
            if dst_holder != 0 as *mut MemHolder
                && src_base != 0 as *mut u8 {
                let mut clone_map: CloneMap = clone_map_create();
                if clone_map.keys != 0 as *mut u32 {
                    let mut ctx: CloneCtx = CloneCtx {
                        base_src: src_base as *const u8,
                        zone_dst: &mut new_ctr.zone as *mut Zone<Mutable>,
                        map: &mut clone_map as *mut CloneMap,
                    };
                    let new_val: AnyVal = anyval_clone(src_val, &mut ctx);
                    clone_map_free(&mut clone_map);
                    let dst_base: *mut u8 = dst_holder.base;
                    if dst_base != 0 as *mut u8 {
                        let doc: *mut DocumentHeader = dst_base as *mut DocumentHeader;
                        document_set_root(doc, new_val);
                    }
                }
            }
            return new_ctr;
        }
    }

    // Convenience overload: auto-size destination zone.
    pub fn export(&self, src_val: AnyVal) -> HermesCtr {
        return self.export(src_val, 0 as i64);
    }

    // Validate structural integrity of the document zone.
    // Checks that every zone-pointer AnyVal is within bounds, every object's
    // TypeTag and size fields are consistent, and no two objects share memory.
    // Returns true if everything is OK, false on the first violation.
    pub fn check(&self) -> bool {
        unsafe {
            return document_check(&self.zone);
        }
    }

    // Serialize the document to HBS binary format.
    // Returns an owned String containing the binary data.
    pub fn serialize(&self) -> String {
        let mut buf: String = String::with_capacity(256 as i64);
        unsafe {
            hbs_write(&self.zone as *const Zone<Mutable>, &mut buf);
        }
        return buf;
    }

    // Deserialize HBS binary data into this container's zone.
    // The container must be freshly created (builder or new without parse).
    // Returns true on success, false on error.
    pub fn deserialize(&mut self, data: *const u8, len: i64) -> bool {
        unsafe {
            return hbs_read(data, len, &mut self.zone);
        }
    }

}

// Build a HermesCtr from a compile-time template blob with runtime capture substitution.
//
// Called by compiler-generated code for @-literals that contain $-captures.
//   tmpl       — pointer to template blob in rodata
//   tmpl_size  — byte size of the template blob
//   slots      — pointer to ParamSlot table: pairs of u32 (blob_offset, value_idx u24)
//   n_slots    — number of ParamSlot entries
//   resolved   — pointer to array of AnyVal.raw (u32) values, one per unique capture
//   n_values   — number of unique capture values in resolved[]
//
// Allocates a fresh zone, memcpy's the template, and patches each PARAM slot.
pub unsafe fn hermes_build_from_template(tmpl: *const u8, tmpl_size: i64, slots: *const u32, n_slots: i64, resolved: *const u32, n_values: i64) -> HermesCtr {
    // Headroom: template bytes + 4096 for future string captures (C5).
    // C3 bug 5: clamp to avoid i64 overflow when tmpl_size is very large.
    let mut cap: i64 = tmpl_size;
    if tmpl_size < 9223372036854771711 as i64 { cap = tmpl_size + 4096 as i64; }
    let mut ctr: HermesCtr = HermesCtr { zone: zone_create(cap) };
    hermes_clone_template(&mut ctr.zone, tmpl, tmpl_size, slots, n_slots, resolved, n_values);
    return ctr;
}

// ── C5: Zone-alloc capture helpers ───────────────────────────────────────────
//
// These are used by capture-literal codegen when one or more $-captures require
// zone allocation (f64 objects, varchar strings).  The caller:
//   1. hermes_template_ctr_new — copies the template blob into a fresh zone
//   2. hermes_ctr_alloc_* — allocates dynamic captures, collects AnyVal.raw values
//   3. hermes_template_patch  — patches PARAM slots with the resolved AnyVal.raw values
//
// All three use the same HermesCtr (passed by *mut pointer so they can mutate the zone).

// Creates a HermesCtr with the template blob memcpy'd to the start of the zone.
// extra_cap is reserved headroom for subsequent dynamic allocations.
// PARAM placeholders are left in place; call hermes_ctr_alloc_* + hermes_template_patch
// to resolve them.
pub unsafe fn hermes_template_ctr_new(
        tmpl: *const u8, tmpl_size: i64, extra_cap: i64) -> HermesCtr {
    let mut total_cap: i64 = tmpl_size;
    if tmpl_size < 9223372036854771711 as i64 - extra_cap {
        total_cap = tmpl_size + extra_cap;
    }
    let mut ctr: HermesCtr = HermesCtr { zone: zone_create(total_cap) };
    if tmpl != 0 as *const u8 && tmpl_size > 0 as i64 {
        let dst: *mut u8 = zone_m_alloc_raw(&mut ctr.zone, tmpl_size);
        if dst != 0 as *mut u8 {
            let mut bi: i64 = 0 as i64;
            while bi < tmpl_size {
                *((dst as i64 + bi) as *mut u8) = *((tmpl as i64 + bi) as *const u8);
                bi = bi + 1 as i64;
            }
        }
    }
    return ctr;
}

// Allocates an F64 zone object (type_code=31, 8-byte body) in ctr's zone.
// Returns AnyVal.raw (zone-relative byte offset, pointer mode, bit0=0).
// Returns 0 (null AnyVal) on OOM.
pub unsafe fn hermes_ctr_alloc_f64(ctr: *mut HermesCtr, val: f64) -> u32 {
    let raw: *mut u8 = zone_m_alloc_tagged(&mut ctr.zone, 8 as i64, 31 as u64);
    if raw == 0 as *mut u8 { return 0 as u32; }
    *(raw as *mut f64) = val;
    let base: *const u8 = ctr.zone.holder.base as *const u8;
    return (raw as i64 - base as i64) as u32;
}

// Allocates a varchar string in ctr's zone from (ptr, len).
// Returns AnyVal.raw (zone-relative offset). Returns 0 on null ptr, negative len, or OOM.
pub unsafe fn hermes_ctr_alloc_str(ctr: *mut HermesCtr, ptr: *const u8, len: i64) -> u32 {
    if ptr == 0 as *const u8 || len < 0 as i64 { return 0 as u32; }
    let lu: u64 = len as u64;
    let prefix_sz: i64 = vlen_encode_size(lu) as i64;
    let total: i64 = prefix_sz + len;
    let raw: *mut u8 = zone_m_alloc_tagged(&mut ctr.zone, total, hermes_tag_string() as u64);
    if raw == 0 as *mut u8 { return 0 as u32; }
    HermesString::init(raw, ptr, lu);
    let base: *const u8 = ctr.zone.holder.base as *const u8;
    return (raw as i64 - base as i64) as u32;
}

// C-string (null-terminated) variant.
pub unsafe fn hermes_ctr_alloc_cstr(ctr: *mut HermesCtr, ptr: *const u8) -> u32 {
    if ptr == 0 as *const u8 { return 0 as u32; }
    return hermes_ctr_alloc_str(ctr, ptr, cstr_len(ptr));
}

// ── C6: Logos-slice → Hermes typed array builders ────────────────────────────

// Builds an ArrayI32 HermesCtr from a raw i32 slice (ptr + element count).
// Layout: data buffer first (4 bytes/elem, raw), then tagged ArrayI32 header.
// The document root is set to the resulting ArrayI32 AnyVal.
pub unsafe fn hermes_build_array_i32(vals: *const i32, len: i64) -> HermesCtr {
    let byte_len: i64 = len * 4 as i64;
    let cap: i64 = 8 as i64 + byte_len + sizeof::<ArrayI32>() as i64 + 64 as i64;
    let mut ctr: HermesCtr = HermesCtr::builder(cap);
    let buf_raw: *mut u8 = zone_m_alloc_raw(&mut ctr.zone, byte_len);
    if buf_raw != 0 as *mut u8 {
        let mut bi: i64 = 0 as i64;
        while bi < byte_len {
            *((buf_raw as i64 + bi) as *mut u8) = *((vals as i64 + bi) as *const u8);
            bi = bi + 1 as i64;
        }
    }
    let buf_off: u32 = (buf_raw as i64 - ctr.zone.holder.base as i64) as u32;
    let hdr_raw: *mut u8 = zone_m_alloc_tagged(&mut ctr.zone,
                               sizeof::<ArrayI32>() as i64,
                               hermes_tag_array_i32() as u64);
    if hdr_raw != 0 as *mut u8 {
        let arr: *mut ArrayI32 = hdr_raw as *mut ArrayI32;
        arr.size     = len as u64;
        arr.capacity = len as u64;
        arr.data     = buf_off;
        let arr_off: u32 = (hdr_raw as i64 - ctr.zone.holder.base as i64) as u32;
        let doc: *mut DocumentHeader = ctr.zone.holder.base as *mut DocumentHeader;
        document_set_root(doc, AnyVal::from_offset(arr_off));
    }
    return ctr;
}

// Builds an ArrayU64 HermesCtr from a raw u64 slice (ptr + element count).
pub unsafe fn hermes_build_array_u64(vals: *const u64, len: i64) -> HermesCtr {
    let byte_len: i64 = len * 8 as i64;
    let cap: i64 = 8 as i64 + byte_len + sizeof::<ArrayU64>() as i64 + 64 as i64;
    let mut ctr: HermesCtr = HermesCtr::builder(cap);
    let buf_raw: *mut u8 = zone_m_alloc_raw(&mut ctr.zone, byte_len);
    if buf_raw != 0 as *mut u8 {
        let mut bi: i64 = 0 as i64;
        while bi < byte_len {
            *((buf_raw as i64 + bi) as *mut u8) = *((vals as i64 + bi) as *const u8);
            bi = bi + 1 as i64;
        }
    }
    let buf_off: u32 = (buf_raw as i64 - ctr.zone.holder.base as i64) as u32;
    let hdr_raw: *mut u8 = zone_m_alloc_tagged(&mut ctr.zone,
                               sizeof::<ArrayU64>() as i64,
                               hermes_tag_array_u64() as u64);
    if hdr_raw != 0 as *mut u8 {
        let arr: *mut ArrayU64 = hdr_raw as *mut ArrayU64;
        arr.size     = len as u64;
        arr.capacity = len as u64;
        arr.data     = buf_off;
        let arr_off: u32 = (hdr_raw as i64 - ctr.zone.holder.base as i64) as u32;
        let doc: *mut DocumentHeader = ctr.zone.holder.base as *mut DocumentHeader;
        document_set_root(doc, AnyVal::from_offset(arr_off));
    }
    return ctr;
}

// Patches PARAM slots in a zone that was populated via hermes_template_ctr_new.
// resolved[i] = AnyVal.raw for capture value i; slots is the ParamSlot table
// (interleaved u32 pairs: blob_offset, value_idx).
// The template starts at zone.holder.base (offset 0 in the zone).
pub unsafe fn hermes_template_patch(
        ctr: *mut HermesCtr,
        slots: *const u32, n_slots: i64,
        resolved: *const u32, n_values: i64) {
    if n_slots <= 0 as i64 || slots == 0 as *const u32 { return; }
    if n_values > 0 as i64 && resolved == 0 as *const u32 { return; }
    let base: *mut u8 = ctr.zone.holder.base;
    let zone_used: i64 = ctr.zone.holder.used;
    let mut si: i64 = 0 as i64;
    while si < n_slots {
        let off: u32  = *((slots as i64 + si * 8 as i64) as *const u32);
        let vidx: u32 = *((slots as i64 + si * 8 as i64 + 4 as i64) as *const u32)
                        & 0xFFFFFF as u32;
        if (vidx as i64) < n_values && (off as i64) + 4 as i64 <= zone_used {
            let av_raw: u32 = *((resolved as i64 + vidx as i64 * 4 as i64) as *const u32);
            let slot_ptr: *mut u32 = (base as i64 + off as i64) as *mut u32;
            *slot_ptr = av_raw;
        }
        si = si + 1 as i64;
    }
}
