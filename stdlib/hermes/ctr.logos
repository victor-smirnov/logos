// Logos Hermes stdlib — hermes.ctr
//
// HermesCtr — owning container for a Hermes document.
//
// Encapsulates zone allocation, text parsing, and stringification.
// The user creates an HermesCtr, parses text into it, then stringifies
// and/or prints the result.  All unsafe zone/pointer work is internal.
//
// Drop: HermesCtr owns HermesZone and String, both of which implement Drop.
// The compiler auto-generates drop glue — no explicit `impl Drop` needed here.
//
// Usage:
//   let mut doc: HermesCtr = HermesCtr::new(8192);
//   match doc.parse(text, len) {
//       Result::Ok(())  => {}
//       Result::Err(_)  => { return 1; }
//   }
//   doc.stringify();
//   doc.print();

package hermes.ctr;

use hermes.zone;
use hermes.anyval;
use hermes.string;
use hermes.containers;
use hermes.objectmap;
use hermes.typetag;
use hermes.document;
use hermes.parser;
use hermes.stringify;
use std.string;

// cstr_len — byte length of a null-terminated C string.
unsafe fn cstr_len(s: *const u8) -> i64 {
    let mut n: i64 = 0 as i64;
    while *((s as i64 + n) as *const u8) != 0 as u8 {
        n = n + 1 as i64;
    }
    return n;
}

// POSIX write(2) — fd 1 = stdout.
extern fn write(fd: i32, buf: *const u8, count: i64) -> i64;

// ---------------------------------------------------------------------------
// Result / ParseError
// ---------------------------------------------------------------------------

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

pub enum ParseError {
    Failed,
}

// ---------------------------------------------------------------------------
// HermesCtr
// ---------------------------------------------------------------------------

pub struct HermesCtr {
    zone: HermesZone,
    buf:  String,
}

impl HermesCtr {
    // Allocate a new container backed by a zone of `capacity` bytes.
    // Used when you will parse a document into the zone (parser creates DocumentHeader).
    pub static fn new(capacity: i64) -> HermesCtr {
        return HermesCtr {
            zone: HermesZone::create(capacity),
            buf:  String::with_capacity(256),
        };
    }

    // For building a document programmatically (without parsing).
    // Pre-allocates the DocumentHeader at zone offset 0.
    pub static fn builder(capacity: i64) -> HermesCtr {
        unsafe {
            let mut zone: HermesZone = HermesZone::create(capacity);
            let hdr_raw: *mut u8 = zone.alloc_raw(8);
            // Guard: alloc_raw returns null if capacity is too small (< 8 bytes).
            // Without this check, document_create(null) would write to address 0.
            if hdr_raw != 0 as *mut u8 {
                document_create(hdr_raw);
            }
            return HermesCtr {
                zone: zone,
                buf:  String::with_capacity(256),
            };
        }
    }

    // Parse Hermes text (UTF-8 bytes) into the zone.
    // Returns Ok(()) on success, Err(ParseError::Failed) on parse error.
    pub fn parse(&mut self, text: *const u8, len: i64) -> Result<(), ParseError> {
        if unsafe { hermes_parse(text, len, &mut self.zone) } {
            return Result::Ok(());
        }
        return Result::Err(ParseError::Failed);
    }

    // Stringify the parsed document into the internal buffer.
    // May be called multiple times; each call replaces the previous result.
    pub fn stringify(&mut self) {
        unsafe {
            self.buf.clear();
            stringify_document(self.zone.base as *const u8, &mut self.buf);
        }
    }

    // Write the stringified bytes to stdout, followed by a newline.
    // Call stringify() first.
    pub fn print(&mut self) {
        unsafe {
            write(1 as i32, self.buf.as_ptr(), self.buf.len());
            let nl: u8 = 10 as u8;
            write(1 as i32, &nl as *const u8, 1 as i64);
        }
    }

    // Pointer to the stringified bytes (valid until next stringify/destroy).
    pub fn data(&self) -> *const u8 {
        return self.buf.as_ptr();
    }

    // Length of the stringified output in bytes.
    pub fn len(&self) -> i64 {
        return self.buf.len();
    }

    // Root AnyVal of the parsed document.
    pub fn root(&self) -> AnyVal {
        unsafe {
            let doc: *const DocumentHeader = self.zone.base as *const DocumentHeader;
            return document_get_root(doc);
        }
    }

    // Zone base pointer (for advanced access to zone-allocated objects).
    pub fn base(&self) -> *const u8 {
        unsafe { return self.zone.base as *const u8; }
    }

    // Stringify the parsed document and return it as an owned String.
    pub fn to_string(&mut self) -> String {
        self.stringify();
        return String::from_bytes(self.data(), self.len());
    }

    // ── Value extraction helpers ───────────────────────────────────────────────

    // Return i64 value of an Integer AnyVal (hash=23). Returns 0 if not int.
    pub fn get_int(&self, val: AnyVal) -> i64 {
        unsafe { return val.as_i64(); }
    }

    // Return bool value of a Boolean AnyVal (hash=37). Returns false if not bool.
    pub fn get_bool(&self, val: AnyVal) -> bool {
        unsafe {
            if !val.is_bool() { return false; }
            return val.as_bool();
        }
    }

    // ── Array traversal ───────────────────────────────────────────────────────

    // Number of elements in an ObjectArray AnyVal. Returns 0 if val is not an array.
    pub fn array_len(&self, val: AnyVal) -> u64 {
        unsafe {
            let base: *const u8 = self.zone.base as *const u8;
            if !val.is_array(base) { return 0 as u64; }
            let arr: *const ObjectArray =
                (base as i64 + val.as_offset() as i64) as *const ObjectArray;
            return arr.len();
        }
    }

    // Get element at `idx` from an ObjectArray AnyVal.
    // Returns AnyVal::null_ptr() if val is not an array or idx is out of bounds.
    pub fn array_get(&self, val: AnyVal, idx: u64) -> AnyVal {
        unsafe {
            let base: *const u8 = self.zone.base as *const u8;
            if !val.is_array(base) { return AnyVal::null_ptr(); }
            let arr: *const ObjectArray =
                (base as i64 + val.as_offset() as i64) as *const ObjectArray;
            return arr.get(base, idx);
        }
    }

    // ── Map traversal ─────────────────────────────────────────────────────────

    // Look up a key in an ObjectMap AnyVal by null-terminated C string.
    // Returns AnyVal::null_ptr() if val is not a map or key is not found.
    pub fn map_get_cstr(&self, val: AnyVal, key: *const u8) -> AnyVal {
        unsafe {
            let base: *const u8 = self.zone.base as *const u8;
            if !val.is_map(base) { return AnyVal::null_ptr(); }
            // Read the descriptor to distinguish TinyObjectMap (hash=98) from
            // ObjectMap (hash=101). TinyObjectMap uses numeric keys only;
            // for string lookups we treat it as not found.
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag_hash: u8 = *((obj as i64 - 2 as i64) as *const u8);
            if tag_hash == 98 as u8 {
                // TinyObjectMap: keys are u8 integers, not strings.
                return AnyVal::null_ptr();
            }
            // ObjectMap (hash=101): open-addressing, string keys.
            let omap: *const ObjectMap = obj as *const ObjectMap;
            let klen: i64 = cstr_len(key);
            return omap.get(base, key, klen as u64);
        }
    }

    // ── Document mutation API ──────────────────────────────────────────────────

    // Allocate a HermesString in the zone from a raw byte pointer + length.
    // Returns an AnyVal in pointer mode pointing to the string.
    // Returns AnyVal::null_ptr() on OOM.
    pub fn build_str(&mut self, s: *const u8, slen: i64) -> AnyVal {
        unsafe {
            let len: u64 = slen as u64;
            // vlen prefix size varies: 1 byte for len < 249, more for larger strings.
            let prefix_sz: i64 = vlen_encode_size(len) as i64;
            let total: i64 = prefix_sz + slen;
            let raw: *mut u8 = self.zone.alloc_tagged(
                total, hermes_tag_string(), hermes_desc_data());
            if raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            // HermesString::init writes the correct vlen prefix and copies the bytes.
            HermesString::init(raw, s, len);
            let off: u32 = (raw as i64 - self.zone.base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    // Allocate an ObjectMap in the zone with `cap_slots` hash slots.
    // cap_slots must be a power of 2 and >= 4.
    // Returns AnyVal pointer to the map, or null_ptr on OOM.
    pub fn build_map(&mut self, cap_slots: u32) -> AnyVal {
        unsafe {
            let map_sz: i64 = 16 as i64;  // sizeof ObjectMap
            let map_raw: *mut u8 = self.zone.alloc_tagged(
                map_sz, hermes_tag_map(), hermes_desc_map());
            if map_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let entries_raw: *mut u8 = self.zone.alloc_raw(cap_slots as i64 * 16 as i64);
            if entries_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            ObjectMap::init(map_raw, self.zone.base, entries_raw, cap_slots);
            let off: u32 = (map_raw as i64 - self.zone.base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    // Allocate an ObjectArray in the zone with `cap` initial capacity.
    // Returns AnyVal pointer to the array, or null_ptr on OOM.
    pub fn build_array(&mut self, cap: u64) -> AnyVal {
        unsafe {
            let oa_sz: i64 = 24 as i64;  // sizeof ObjectArray
            let oa_raw: *mut u8 = self.zone.alloc_tagged(
                oa_sz, hermes_tag_array(), hermes_desc_array());
            if oa_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let buf_raw: *mut u8 = self.zone.alloc_raw(cap as i64 * 8 as i64);
            if buf_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            ObjectArray::init(oa_raw, buf_raw, self.zone.base, cap);
            let off: u32 = (oa_raw as i64 - self.zone.base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    // Set key → val in a map AnyVal.
    // key is a C string pointer; klen is its byte length (NOT counting null).
    pub fn map_set_str(&mut self, map: AnyVal, key: *const u8, klen: i64, val: AnyVal) {
        unsafe {
            let base: *const u8 = self.zone.base as *const u8;
            if !map.is_map(base) { return; }
            let omap: *mut ObjectMap =
                (self.zone.base as i64 + map.as_offset() as i64) as *mut ObjectMap;
            // Only allocate a new HermesString if the key is new.
            // On update, ObjectMap::set finds the slot via byte comparison and updates
            // only the value — it never writes key_off. So any non-zero dummy suffices.
            // Default to sentinel 1 (non-zero, used only on the update path).
            let mut key_off: u32 = 1 as u32;
            if !omap.contains(base, key, klen as u64) {
                let key_av: AnyVal = self.build_str(key, klen);
                if key_av.is_null() { return; }
                key_off = key_av.as_offset();
            }
            omap.set(self.zone.base, key_off, key, klen as u64, val);
        }
    }

    // Push val onto an array AnyVal.
    pub fn array_push(&mut self, arr: AnyVal, val: AnyVal) {
        unsafe {
            let base: *const u8 = self.zone.base as *const u8;
            if !arr.is_array(base) { return; }
            let oa: *mut ObjectArray =
                (self.zone.base as i64 + arr.as_offset() as i64) as *mut ObjectArray;
            oa.push(self.zone.base, val);
        }
    }

    // Set the document root to val.
    // Only valid after builder() constructor or a successful parse().
    pub fn set_root(&mut self, val: AnyVal) {
        unsafe {
            let doc: *mut DocumentHeader = self.zone.base as *mut DocumentHeader;
            document_set_root(doc, val);
        }
    }

}
