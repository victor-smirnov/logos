// Logos Hermes stdlib — hermes.datatag
//
// New-generation TypeTag encoding (Logos-native, not C++ compatible).
//
// Wire format — variable-length tag stored BEFORE the object in zone memory,
// written backwards (bytes are written from high address down to low):
//
//   obj[-1] ∈ [128,222] → single-byte tag; type_code = that byte
//   obj[-1] ∈ [223,255] → multi-byte; length = obj[-1] - 223 + 1 bytes total
//                          type_code in the following bytes (read backwards)
//
// Codes 0: unset/sentinel (never written).
// Codes 1-127: reserved for inline AnyVal primitives (never appear in zone tags).
// Codes 128-222: zone datatypes — single-byte tag, tier-1 dispatch (array[223]).
// Codes 223+: zone datatypes — multi-byte tag, tier-2 dispatch (binary search).
//
// Primary functions:
//   write_tag(ptr, type_code) — write tag immediately before *ptr
//   read_type_code(ptr)       — read type_code from tag before *ptr
//   tag_size(type_code)       — byte count of the tag for a given type_code

package hermes.datatag;

// ---------------------------------------------------------------------------
// Tag size computation
// ---------------------------------------------------------------------------

// Returns the number of bytes the TypeTag occupies for the given type_code.
// Single-byte for codes 1-222; multi-byte for 223+.
// Bug fix: type_code 0 is reserved/unset and occupies 0 bytes (see write_tag guard).
pub fn tag_size(type_code: u64) -> i64 {
    if type_code == 0 as u64 { return 0; }
    // Bug fix: codes 1-127 are reserved and shouldn't appear in zone tags.
    if type_code > 0 as u64 && type_code < 128 as u64 { return 0; }
    // Bug fix: after filtering 0 and reserved, the check >= 1 is always true (dead code).
    // Simplify to just check upper bound.
    if type_code <= 222 as u64 {
        return 1;
    }
    // Multi-byte: count how many bytes are needed for the code value.
    // Header byte (1) + code bytes.
    let mut bytes: i64 = 1;  // header byte
    let mut v: u64 = type_code;
    loop {
        v = v >> 8 as u64;
        bytes = bytes + 1;
        if v == 0 as u64 { break; }
    }
    return bytes;
}

// ---------------------------------------------------------------------------
// Tag write
// ---------------------------------------------------------------------------

// Write a TypeTag immediately before the object at `obj`.
// `obj` must point to the first byte of the object (after the tag bytes).
// The caller must have reserved tag_size(type_code) bytes before obj.
pub unsafe fn write_tag(obj: *mut u8, type_code: u64) {
    // Bug 3 fix: type_code 0 is reserved/unset sentinel — writing it corrupts tag format.
    if type_code == 0 as u64 { return; }
    // Bug fix: codes 1-127 are reserved for inline AnyVal and shouldn't appear in zone tags.
    if type_code > 0 as u64 && type_code < 128 as u64 { return; }
    if type_code <= 222 as u64 {
        // Single-byte tag: write the code directly at obj[-1].
        let tag_ptr: *mut u8 = (obj as i64 - 1) as *mut u8;
        *tag_ptr = type_code as u8;
    } else {
        // Multi-byte tag: write backwards.
        // Byte at obj[-1] is the header: (n_code_bytes - 1) + 223.
        // Bytes at obj[-2], obj[-3], ... are the code bytes (little-endian from high address).
        let mut v: u64 = type_code;
        let mut offset: i64 = 1;
        // Write code bytes (least significant first, from obj[-2] downward).
        loop {
            let p: *mut u8 = (obj as i64 - 1 - offset) as *mut u8;
            *p = (v & 0xFF as u64) as u8;
            v = v >> 8 as u64;
            offset = offset + 1;
            if v == 0 as u64 {
                break;
            }
        }
        let n_code_bytes: u8 = (offset - 1) as u8;
        // Bug 5 fix: type_code must fit in <=8 bytes; if not, bail out (caller error).
        if n_code_bytes > 8 as u8 { return; }
        let header: *mut u8 = (obj as i64 - 1) as *mut u8;
        *header = (223 as u64 + (n_code_bytes as u64 - 1 as u64)) as u8;
    }
}

// ---------------------------------------------------------------------------
// Tag read
// ---------------------------------------------------------------------------

// Read the type_code from the TypeTag immediately before `obj`.
pub unsafe fn read_type_code(obj: *const u8) -> u64 {
    let b: u8 = *((obj as i64 - 1) as *const u8);
    if b >= 1 as u8 && b <= 222 as u8 {
        return b as u64;
    }
    // Bug 4 fix: header 0 means unset tag; header > 230 (223+7) would need >8 code bytes —
    // beyond the maximum 8-byte type_code. Return 0 to signal invalid tag.
    if b == 0 as u8 || b > 230 as u8 { return 0 as u64; }
    // Multi-byte tag: n_code_bytes = b - 223 + 1.
    let n: i64 = (b as i64 - 223 + 1);
    let mut code: u64 = 0 as u64;
    let mut i: i64 = 0;
    loop {
        if i >= n {
            break;
        }
        let byte_ptr: *const u8 = (obj as i64 - 2 - i) as *const u8;
        let byte_val: u64 = *byte_ptr as u64;
        // Bug 2 fix: write_tag writes LSByte at obj[-2] (i=0), so read must treat i=0 as LSByte.
        // Shift = i*8 (not (n-1-i)*8 which would be big-endian).
        code = code | (byte_val << (i as u64 * 8 as u64));
        i = i + 1;
    }
    return code;
}

// ---------------------------------------------------------------------------
// Zone allocation with TypeTag
// ---------------------------------------------------------------------------

// Allocate `obj_size` bytes in the given raw memory buffer, write TypeTag.
// `buf`      — raw buffer base pointer (*mut u8)
// `offset`   — current allocation offset in the buffer (in/out)
// `capacity` — total buffer capacity
// `type_code`— TypeTag type_code to write before the object (must be > 0)
// Returns pointer to the object, or null on OOM.
pub unsafe fn alloc_tagged_raw(
    buf:       *mut u8,
    offset:    *mut i64,
    capacity:  i64,
    obj_size:  i64,
    type_code: u64
) -> *mut u8 {
    // Bug fix: validate preconditions to avoid integer overflow in overflow checks.
    if *offset < 0 as i64 { return 0 as *mut u8; }  // offset must be non-negative
    if obj_size < 0 as i64 { return 0 as *mut u8; }  // obj_size must be non-negative
    if capacity < 0 as i64 { return 0 as *mut u8; }  // capacity must be non-negative
    // Bug fix: type_code 0 is reserved/unset sentinel — reject it.
    if type_code == 0 as u64 { return 0 as *mut u8; }
    // Bug fix: codes 1-127 are reserved for inline AnyVal — reject them.
    if type_code > 0 as u64 && type_code < 128 as u64 { return 0 as *mut u8; }
    let tsz: i64 = tag_size(type_code);
    // Advance past existing bytes + tag.
    // Bug fix: check overflow when adding offset + tsz.
    let pre: i64 = *offset + tsz;
    if pre < *offset { return 0 as *mut u8; }  // overflow detected
    // Align to 8 bytes for the object start.
    // Bug fix: check overflow when adding 7 to pre.
    if pre > (9223372036854775800 as i64) { return 0 as *mut u8; }  // pre + 7 > i64::MAX
    let aligned: i64 = (pre + 7) / 8 * 8;
    // Bug fix: check overflow when computing aligned + obj_size.
    // If aligned + obj_size > i64::MAX, it wraps and check below might pass falsely.
    if aligned > capacity - obj_size {
        return 0 as *mut u8;  // equivalent to aligned + obj_size > capacity, safe from overflow
    }
    let base_int: i64 = buf as i64;
    let obj: *mut u8 = (base_int + aligned) as *mut u8;
    write_tag(obj, type_code);
    // Bug fix: check overflow when updating offset for next allocation.
    if aligned > (9223372036854775800 as i64) - obj_size { return 0 as *mut u8; }  // would overflow
    *offset = aligned + obj_size;
    return obj;
}
