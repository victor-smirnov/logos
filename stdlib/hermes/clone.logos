// Logos Hermes stdlib — hermes.clone
//
// Deep clone of a Hermes zone object into a destination zone.
//
// Each `HermesClone` impl is responsible for:
//   1. Allocating an object of the same size+tag in `ctx.zone_dst`.
//   2. Copying fixed fields.
//   3. Recursively cloning any zone-referenced children (AnyVal offsets,
//      side buffers).
//   4. Returning the raw *mut u8 pointer of the new object in the
//      destination zone.
//
// `anyval_clone` handles dispatch at AnyVal boundaries: inline values are
// copied by raw bits; zone-pointer values are dispatched through
// HermesClone, and the new offset is returned.

package hermes.clone;

use hermes.anyval;
use hermes.zone;
use hermes.string;
use hermes.typetag;
use hermes.tag_system;
use hermes.containers;
use hermes.objectmap;
use hermes.document;
use hermes.scalar;
use hermes.decimal;
use std.string;

pub struct CloneCtx {
    pub base_src: *const u8,
    pub zone_dst: *mut Zone<Mutable>,
}

#[tag_dispatch(HermesTypeTagSystem)]
pub trait HermesClone {
    fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8;
}

// Per-element clone for homogeneous containers like `Array<T>`.  The default
// semantic — copy into the dst slot — differs from `HermesClone` (which
// allocates a fresh zone entry and returns its pointer).  `CloneElem` exists
// so that blanket `impl<T: CloneElem> HermesClone for Array<T>` can uniformly
// handle inline T (primitives, AnyVal) where per-element zone allocation
// doesn't apply.
pub trait CloneElem {
    unsafe fn clone_elem(self: *const Self, ctx: *mut CloneCtx, dst: *mut Self);
}

// AnyVal: delegate to anyval_clone (handles inline-vs-zone dispatch).
impl CloneElem for AnyVal {
    pub unsafe fn clone_elem(self: *const AnyVal, ctx: *mut CloneCtx, dst: *mut AnyVal) {
        let new_val: AnyVal = anyval_clone(AnyVal { raw: self.raw }, ctx);
        dst.raw = new_val.raw;
    }
}

// Clone `val` (resolved against ctx.base_src) into ctx.zone_dst and return
// an AnyVal with the new offset (or the inline value unchanged).
// Returns null on OOM.
pub unsafe fn anyval_clone(val: AnyVal, ctx: *mut CloneCtx) -> AnyVal {
    if val.is_null() { return AnyVal::null_ptr(); }
    if !val.is_ptr() { return val; }
    let obj: *const u8 =
        (ctx.base_src as i64 + val.as_offset() as i64) as *const u8;
    let th: &tagged<HermesTypeTagSystem> HermesClone = obj;
    let new_raw: *mut u8 = th.clone_to(ctx);
    if new_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
    let dst_base: *mut u8 = ctx.zone_dst.holder.base;
    let off: u32 = (new_raw as i64 - dst_base as i64) as u32;
    return AnyVal::from_offset(off);
}

// ── HermesString (28) ─────────────────────────────────────────────────────

impl HermesClone for HermesString {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let a: *const HermesString = self as *const HermesString;
            let len: u64 = a.len();
            let prefix_sz: i64 = vlen_encode_size(len) as i64;
            let total: i64 = prefix_sz + len as i64;
            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, total,
                                   hermes_tag_string(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }
            HermesString::init(raw, a.bytes(), len);
            return raw;
        }
    }
}

// ── I64 (26) ──────────────────────────────────────────────────────────────

impl HermesClone for I64 {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let a: *const I64 = self as *const I64;
            let sz: i64 = sizeof::<I64>() as i64;
            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, sz,
                                   hermes_tag_i64(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }
            I64::init(raw, a.value());
            return raw;
        }
    }
}

// ── U64 (27) ──────────────────────────────────────────────────────────────

impl HermesClone for U64 {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let a: *const U64 = self as *const U64;
            let sz: i64 = sizeof::<U64>() as i64;
            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, sz,
                                   hermes_tag_u64(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }
            U64::init(raw, a.value());
            return raw;
        }
    }
}

impl HermesClone for Decimal {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let d: *const Decimal = self as *const Decimal;
            let n: u32 = d.len();
            let total: i64 = sizeof::<Decimal>() as i64 + (n as i64) * 4 as i64;
            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, total,
                                   hermes_tag_decimal(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }
            let out: *mut Decimal = raw as *mut Decimal;
            out.spec_and_len = d.spec_and_len;
            let mut i: u32 = 0 as u32;
            let src: *const u32 = d.limbs();
            let dst: *mut u32 = out.limbs_mut();
            while i < n {
                *((dst as i64 + (i as i64) * 4 as i64) as *mut u32) =
                    *((src as i64 + (i as i64) * 4 as i64) as *const u32);
                i = i + 1 as u32;
            }
            return raw;
        }
    }
}

// ── Array<T>: blanket over any T: CloneElem ───────────────────────────────

impl<T: CloneElem> HermesClone for Array<T> {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let a: *const Array<T> = self as *const Array<T>;
            let cap: u64 = a.capacity;
            let n:   u64 = a.size;

            let oa_sz: i64 = sizeof::<Array<T>>() as i64;
            let tc: u8     = type_code_of::<Array<T>>() as u8;
            let oa_raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, oa_sz,
                                      tc, hermes_desc_array());
            if oa_raw == 0 as *mut u8 { return 0 as *mut u8; }
            let elem_sz: i64 = sizeof::<T>() as i64;
            let buf_raw: *mut u8 = zone_m_alloc_raw(ctx.zone_dst, cap as i64 * elem_sz);
            if buf_raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_base_mut: *mut u8 = ctx.zone_dst.holder.base;
            let new_arr: *mut Array<T> = oa_raw as *mut Array<T>;
            new_arr.size     = n;
            new_arr.capacity = cap;
            new_arr.data     = (buf_raw as i64 - dst_base_mut as i64) as u32;

            let src_base: i64 = ctx.base_src as i64 + a.data as i64;
            let mut i: u64 = 0 as u64;
            while i < n {
                let src_elem: *const T = (src_base + (i as i64) * elem_sz) as *const T;
                let dst_elem: *mut T   = (buf_raw  as i64 + (i as i64) * elem_sz) as *mut T;
                src_elem.clone_elem(ctx, dst_elem);
                i = i + 1 as u64;
            }
            return oa_raw;
        }
    }
}

// ── Map<Bitmap, V> blanket — bitmap-indexed compact map clone ─────────────

impl<V: CloneElem> HermesClone for Map<Bitmap, V> {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let a: *const Map<Bitmap, V> = self as *const Map<Bitmap, V>;
            let tm_sz: i64 = sizeof::<Map<Bitmap, V>>() as i64;
            let tc: u8 = type_code_of::<Map<Bitmap, V>>() as u8;
            let tm_raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, tm_sz,
                                      tc, hermes_desc_map());
            if tm_raw == 0 as *mut u8 { return 0 as *mut u8; }
            let cap: u32 = ((a.header >> 52 as u64) & 0x3F as u64) as u32;
            let elem_sz: i64 = sizeof::<V>() as i64;
            let arr_raw: *mut u8 = zone_m_alloc_raw(ctx.zone_dst,
                                                    cap as i64 * elem_sz);
            if arr_raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_base_mut: *mut u8 = ctx.zone_dst.holder.base;
            let new_map: *mut Map<Bitmap, V> = tm_raw as *mut Map<Bitmap, V>;
            new_map.header = a.header;  // preserve bitmap + capacity + size
            new_map.data   = (arr_raw as i64 - dst_base_mut as i64) as u32;

            let mask: u64 = 0x000FFFFFFFFFFFFF as u64;
            let bitmap: u64 = a.header & mask;
            let src_arr_base: i64 = ctx.base_src as i64 + a.data as i64;
            let mut key: u8 = 0 as u8;
            while key < 52 as u8 {
                let key_bit: u64 = 1 as u64 << key as u64;
                if (bitmap & key_bit) != 0 as u64 {
                    let m: u64 = key_bit - 1 as u64;
                    let pos: u32 = popcount_u64(bitmap & m);
                    let src_v: *const V = (src_arr_base + (pos as i64) * elem_sz) as *const V;
                    let dst_v: *mut V   = (arr_raw as i64 + (pos as i64) * elem_sz) as *mut V;
                    src_v.clone_elem(ctx, dst_v);
                }
                key = key + 1 as u8;
            }
            return tm_raw;
        }
    }
}

// ── ObjectMap (101) ───────────────────────────────────────────────────────

impl HermesClone for ObjectMap {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let a: *const ObjectMap = self as *const ObjectMap;
            let cap: u32 = a.capacity;

            let om_sz: i64 = sizeof::<ObjectMap>() as i64;
            let om_raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, om_sz,
                                      hermes_tag_map(), hermes_desc_map());
            if om_raw == 0 as *mut u8 { return 0 as *mut u8; }
            let ent_raw: *mut u8 = zone_m_alloc_raw(ctx.zone_dst, cap as i64 * 8 as i64);
            if ent_raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_base_mut: *mut u8 = ctx.zone_dst.holder.base;
            let new_map: *mut ObjectMap =
                ObjectMap::init(om_raw, dst_base_mut, ent_raw, cap);

            let src_cap: u32 = a.capacity;
            let src_ent_base: i64 = ctx.base_src as i64 + a.entries_off as i64;
            let mut slot: u32 = 0 as u32;
            while slot < src_cap {
                let ep: *const MapEntry =
                    (src_ent_base + slot as i64 * 8 as i64) as *const MapEntry;
                if ep.key_off != 0 as u32 {
                    let hs: *const HermesString =
                        (ctx.base_src as i64 + ep.key_off as i64) as *const HermesString;
                    let kbytes: *const u8 = hs.bytes();
                    let klen: u64 = hs.len();
                    // Clone the key (HermesString).
                    let new_key_av: AnyVal = anyval_clone(
                        AnyVal::from_offset(ep.key_off), ctx);
                    if new_key_av.is_null() { return 0 as *mut u8; }
                    let new_key_off: u32 = new_key_av.as_offset();
                    // Bug fix: read key bytes from destination zone (cloned key), not source zone.
                    let new_key_ptr: *const HermesString =
                        (dst_base_mut as i64 + new_key_off as i64) as *const HermesString;
                    let new_kbytes: *const u8 = new_key_ptr.bytes();
                    let new_klen: u64 = new_key_ptr.len();
                    // Clone the value.
                    let src_v: AnyVal = AnyVal { raw: ep.val };
                    let new_v: AnyVal = anyval_clone(src_v, ctx);
                    new_map.set(dst_base_mut, new_key_off, new_kbytes, new_klen, new_v);
                }
                slot = slot + 1 as u32;
            }
            return om_raw;
        }
    }
}

// ── TypedValue (106) ───────────────────────────────────────────────────────

impl HermesClone for TypedValue {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let t: *const TypedValue = self as *const TypedValue;
            let sz: i64 = sizeof::<TypedValue>() as i64;
            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, sz,
                                   hermes_tag_typed_value(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }

            let ty_av: AnyVal = anyval_clone(AnyVal::from_offset(t.type_off), ctx);
            if ty_av.is_null() || !ty_av.is_ptr() { return 0 as *mut u8; }

            let params_new: AnyVal = anyval_clone(AnyVal { raw: t.params_raw }, ctx);
            if t.params_raw != 0 as u32 && params_new.is_null() { return 0 as *mut u8; }

            let init_new: AnyVal = anyval_clone(AnyVal { raw: t.init_raw }, ctx);
            if t.init_raw != 0 as u32 && init_new.is_null() { return 0 as *mut u8; }

            TypedValue::init(raw, ty_av.as_offset(), params_new, init_new);
            return raw;
        }
    }
}
