// Logos Hermes stdlib — hermes.clone
//
// Deep clone of a Hermes zone object into a destination zone.
//
// Each `HermesClone` impl is responsible for:
//   1. Allocating an object of the same size+tag in `ctx.zone_dst`.
//   2. Copying fixed fields.
//   3. Recursively cloning any zone-referenced children (AnyVal offsets,
//      side buffers).
//   4. Returning the raw *mut u8 pointer of the new object in the
//      destination zone.
//
// `anyval_clone` handles dispatch at AnyVal boundaries: inline values are
// copied by raw bits; zone-pointer values are dispatched through
// HermesClone, and the new offset is returned.

package hermes.clone;

use hermes.anyval;
use hermes.zone;
use hermes.string;
use hermes.typetag;
use hermes.tag_system;
use hermes.containers;
use hermes.objectmap;
use hermes.document;
use hermes.scalar;
use hermes.decimal;
use hermes.mem_holder;
use std.string;

extern fn calloc(count: i64, size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

// ── Cycle-safe clone map (open-addressing, power-of-2 capacity) ───────────
//
// Maps src zone-offset (u32) → dst zone-offset (u32).  Key 0 is the empty-
// slot sentinel; valid AnyVal zone offsets are always >= 10 (past the 8-byte
// DocumentHeader and 2-byte TypeTag), so 0 never collides with real data.
//
// Each clone_to impl registers src→dst BEFORE recursing into children so
// that back-edges in a cyclic graph hit the cache instead of looping forever.

pub struct CloneMap {
    pub keys: *mut u32,
    pub vals: *mut u32,
    pub cap:  u32,
    pub cnt:  u32,
}

pub unsafe fn clone_map_create() -> CloneMap {
    let cap: u32 = 64 as u32;
    let keys: *mut u8 = calloc(cap as i64, 4 as i64);
    let vals: *mut u8 = calloc(cap as i64, 4 as i64);
    if keys == 0 as *mut u8 || vals == 0 as *mut u8 {
        if keys != 0 as *mut u8 { free(keys); }
        if vals != 0 as *mut u8 { free(vals); }
        return CloneMap { keys: 0 as *mut u32, vals: 0 as *mut u32,
                          cap: 0 as u32, cnt: 0 as u32 };
    }
    return CloneMap { keys: keys as *mut u32, vals: vals as *mut u32,
                      cap: cap, cnt: 0 as u32 };
}

pub unsafe fn clone_map_free(m: *mut CloneMap) {
    if m.keys != 0 as *mut u32 { free(m.keys as *mut u8); m.keys = 0 as *mut u32; }
    if m.vals != 0 as *mut u32 { free(m.vals as *mut u8); m.vals = 0 as *mut u32; }
    m.cap = 0 as u32;
    m.cnt = 0 as u32;
}

// Returns pointer to the dst-offset slot, or null if not found.
pub unsafe fn clone_map_lookup(m: *mut CloneMap, key: u32) -> *const u32 {
    if m.cap == 0 as u32 { return 0 as *const u32; }
    let mask: u32 = m.cap - 1 as u32;
    // Bug fix: zone offsets are 8-byte aligned, so low 3 bits are always 0.
    // Shifting right by 3 before masking gives uniform bucket distribution.
    let mut h: u32 = (key >> 3 as u32) & mask;
    let mut probe: u32 = 0 as u32;
    while probe < m.cap {
        let kp: *const u32 = (m.keys as i64 + (h as i64) * 4 as i64) as *const u32;
        let k: u32 = *kp;
        if k == 0 as u32 { return 0 as *const u32; }
        if k == key { return (m.vals as i64 + (h as i64) * 4 as i64) as *const u32; }
        h = (h + 1 as u32) & mask;
        probe = probe + 1 as u32;
    }
    return 0 as *const u32;
}

unsafe fn clone_map_grow(m: *mut CloneMap) -> bool {
    let new_cap: u32 = m.cap * 2 as u32;
    let new_keys: *mut u8 = calloc(new_cap as i64, 4 as i64);
    let new_vals: *mut u8 = calloc(new_cap as i64, 4 as i64);
    if new_keys == 0 as *mut u8 || new_vals == 0 as *mut u8 {
        if new_keys != 0 as *mut u8 { free(new_keys); }
        if new_vals != 0 as *mut u8 { free(new_vals); }
        return false;
    }
    let new_mask: u32 = new_cap - 1 as u32;
    let mut i: u32 = 0 as u32;
    while i < m.cap {
        let k: u32 = *((m.keys as i64 + (i as i64) * 4 as i64) as *const u32);
        if k != 0 as u32 {
            let v: u32 = *((m.vals as i64 + (i as i64) * 4 as i64) as *const u32);
            let mut h: u32 = (k >> 3 as u32) & new_mask;
            let mut placed: bool = false;
            while !placed {
                let slot_k: *mut u32 = (new_keys as i64 + (h as i64) * 4 as i64) as *mut u32;
                if *slot_k == 0 as u32 {
                    *slot_k = k;
                    *((new_vals as i64 + (h as i64) * 4 as i64) as *mut u32) = v;
                    placed = true;
                } else {
                    h = (h + 1 as u32) & new_mask;
                }
            }
        }
        i = i + 1 as u32;
    }
    free(m.keys as *mut u8);
    free(m.vals as *mut u8);
    m.keys = new_keys as *mut u32;
    m.vals = new_vals as *mut u32;
    m.cap  = new_cap;
    return true;
}

pub unsafe fn clone_map_insert(m: *mut CloneMap, key: u32, val: u32) -> bool {
    if m.cap == 0 as u32 { return false; }
    if m.cnt * 3 as u32 >= m.cap * 2 as u32 {
        if !clone_map_grow(m) { return false; }
    }
    let mask: u32 = m.cap - 1 as u32;
    let mut h: u32 = (key >> 3 as u32) & mask;
    let mut probe: u32 = 0 as u32;
    while probe < m.cap {
        let kp: *mut u32 = (m.keys as i64 + (h as i64) * 4 as i64) as *mut u32;
        let k: u32 = *kp;
        if k == 0 as u32 {
            *kp = key;
            *((m.vals as i64 + (h as i64) * 4 as i64) as *mut u32) = val;
            m.cnt = m.cnt + 1 as u32;
            return true;
        }
        if k == key { return true; }
        h = (h + 1 as u32) & mask;
        probe = probe + 1 as u32;
    }
    return false;
}

// Mark a previously registered src_off as OOM-failed so that subsequent
// shared references to the same src object return null_ptr (not a stale copy).
// AnyVal::from_offset(0) = null_ptr, which callers treat as OOM.
pub unsafe fn clone_map_on_oom(m: *mut CloneMap, key: u32) {
    if m == 0 as *mut CloneMap { return; }
    let slot: *const u32 = clone_map_lookup(m, key);
    if slot != 0 as *const u32 { *(slot as *mut u32) = 0 as u32; }
}

pub struct CloneCtx {
    pub base_src: *const u8,
    pub zone_dst: *mut Zone<Mutable>,
    pub map:      *mut CloneMap,
}

#[tag_dispatch(HermesTypeTagSystem)]
pub trait HermesClone {
    fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8;
}

// Per-element clone for homogeneous containers like `Array<T>`.
//
// `dst_off` is a zone-relative byte offset into ctx.zone_dst where the
// element should be written.  The impl must recompute the raw pointer as
// `ctx.zone_dst.holder.base + dst_off` AFTER any recursive clone call,
// because the zone may have grown (and thus its base relocated) during
// recursion.  Using an offset instead of a raw pointer is what makes
// element writes safe across zone growth.
pub trait CloneElem {
    unsafe fn clone_elem(self: *const Self, ctx: *mut CloneCtx, dst_off: u32);
}

// AnyVal: delegate to anyval_clone, then write result via recomputed pointer.
impl CloneElem for AnyVal {
    pub unsafe fn clone_elem(self: *const AnyVal, ctx: *mut CloneCtx, dst_off: u32) {
        let new_val: AnyVal = anyval_clone(AnyVal { raw: self.raw }, ctx);
        // Recompute dst pointer: zone may have grown during anyval_clone.
        let dst: *mut AnyVal = (ctx.zone_dst.holder.base as i64 + dst_off as i64) as *mut AnyVal;
        dst.raw = new_val.raw;
    }
}

// Clone `val` (resolved against ctx.base_src) into ctx.zone_dst and return
// an AnyVal with the new offset (or the inline value unchanged).
// Returns null on OOM.
pub unsafe fn anyval_clone(val: AnyVal, ctx: *mut CloneCtx) -> AnyVal {
    if val.is_null() { return AnyVal::null_ptr(); }
    if !val.is_ptr() { return val; }
    let src_off: u32 = val.as_offset();
    // Cycle / DAG dedup: if this src object was already cloned, return the
    // previously created dst object without recursing again.
    if ctx.map != 0 as *mut CloneMap {
        let cached: *const u32 = clone_map_lookup(ctx.map, src_off);
        if cached != 0 as *const u32 { return AnyVal::from_offset(*cached); }
    }
    let obj: *const u8 = (ctx.base_src as i64 + src_off as i64) as *const u8;
    let th: &tagged<HermesTypeTagSystem> HermesClone = obj;
    let new_raw: *mut u8 = th.clone_to(ctx);
    if new_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
    let dst_base: *mut u8 = ctx.zone_dst.holder.base;
    let off: u32 = (new_raw as i64 - dst_base as i64) as u32;
    return AnyVal::from_offset(off);
}

// ── HermesString (28) ─────────────────────────────────────────────────────

impl HermesClone for HermesString {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let src_off: u32 = (self as i64 - ctx.base_src as i64) as u32;
            let a: *const HermesString = (ctx.base_src as i64 + src_off as i64) as *const HermesString;
            let len: u64 = a.len();
            let total: i64 = vlen_encode_size(len) as i64 + len as i64;
            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, total,
                                   hermes_tag_string(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_off: u32 = (raw as i64 - ctx.zone_dst.holder.base as i64) as u32;
            if ctx.map != 0 as *mut CloneMap { clone_map_insert(ctx.map, src_off, dst_off); }
            // No recursion: raw is still valid (single alloc, no grow can happen here).
            HermesString::init(raw, a.bytes(), len);
            return raw;
        }
    }
}

// ── I64 (26) ──────────────────────────────────────────────────────────────

impl HermesClone for I64 {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let src_off: u32 = (self as i64 - ctx.base_src as i64) as u32;
            let a: *const I64 = (ctx.base_src as i64 + src_off as i64) as *const I64;
            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, sizeof::<I64>() as i64,
                                   hermes_tag_i64(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_off: u32 = (raw as i64 - ctx.zone_dst.holder.base as i64) as u32;
            if ctx.map != 0 as *mut CloneMap { clone_map_insert(ctx.map, src_off, dst_off); }
            I64::init(raw, a.value());
            return raw;
        }
    }
}

// ── U64 (27) ──────────────────────────────────────────────────────────────

impl HermesClone for U64 {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let src_off: u32 = (self as i64 - ctx.base_src as i64) as u32;
            let a: *const U64 = (ctx.base_src as i64 + src_off as i64) as *const U64;
            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, sizeof::<U64>() as i64,
                                   hermes_tag_u64(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_off: u32 = (raw as i64 - ctx.zone_dst.holder.base as i64) as u32;
            if ctx.map != 0 as *mut CloneMap { clone_map_insert(ctx.map, src_off, dst_off); }
            U64::init(raw, a.value());
            return raw;
        }
    }
}

impl HermesClone for Decimal {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let src_off: u32 = (self as i64 - ctx.base_src as i64) as u32;
            let d: *const Decimal = (ctx.base_src as i64 + src_off as i64) as *const Decimal;
            let n: u32 = d.len();
            let total: i64 = sizeof::<Decimal>() as i64 + (n as i64) * 4 as i64;
            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, total,
                                   hermes_tag_decimal(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_off: u32 = (raw as i64 - ctx.zone_dst.holder.base as i64) as u32;
            if ctx.map != 0 as *mut CloneMap { clone_map_insert(ctx.map, src_off, dst_off); }
            // No recursion: raw still valid (single alloc, no further grow).
            let out: *mut Decimal = raw as *mut Decimal;
            out.spec_and_len = d.spec_and_len;
            let src_limbs: *const u32 = d.limbs();
            let dst_limbs: *mut u32 = out.limbs_mut();
            let mut i: u32 = 0 as u32;
            while i < n {
                *((dst_limbs as i64 + (i as i64) * 4 as i64) as *mut u32) =
                    *((src_limbs as i64 + (i as i64) * 4 as i64) as *const u32);
                i = i + 1 as u32;
            }
            return raw;
        }
    }
}

// ── Array<T>: blanket over any T: CloneElem ───────────────────────────────

impl<T: CloneElem> HermesClone for Array<T> {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let src_off: u32 = (self as i64 - ctx.base_src as i64) as u32;
            let a: *const Array<T> = (ctx.base_src as i64 + src_off as i64) as *const Array<T>;
            let cap: u64 = a.capacity;
            let n:   u64 = a.size;
            let src_data_off: u32 = a.data;

            let tc: u8 = type_code_of::<Array<T>>() as u8;
            let oa_raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, sizeof::<Array<T>>() as i64,
                                      tc, hermes_desc_array());
            if oa_raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_off: u32 = (oa_raw as i64 - ctx.zone_dst.holder.base as i64) as u32;
            if ctx.map != 0 as *mut CloneMap { clone_map_insert(ctx.map, src_off, dst_off); }

            let elem_sz: i64 = sizeof::<T>() as i64;
            let buf_raw: *mut u8 = zone_m_alloc_raw(ctx.zone_dst, cap as i64 * elem_sz);
            if buf_raw == 0 as *mut u8 {
                clone_map_on_oom(ctx.map, src_off);
                return 0 as *mut u8;
            }
            // Convert buf to offset immediately — zone may grow during element clones.
            let buf_off: u32 = (buf_raw as i64 - ctx.zone_dst.holder.base as i64) as u32;

            // Write header fields using current base (two allocs done, no grow yet).
            let dst_base: *mut u8 = ctx.zone_dst.holder.base;
            let new_arr: *mut Array<T> = (dst_base as i64 + dst_off as i64) as *mut Array<T>;
            new_arr.size     = n;
            new_arr.capacity = cap;
            new_arr.data     = buf_off;

            // Clone elements — each clone_elem receives a dst zone offset and
            // recomputes its raw pointer after any internal zone grow.
            let src_base: i64 = ctx.base_src as i64 + src_data_off as i64;
            let mut i: u64 = 0 as u64;
            while i < n {
                let src_elem: *const T = (src_base + (i as i64) * elem_sz) as *const T;
                let elem_dst_off: u32  = buf_off + ((i as i64) * elem_sz) as u32;
                src_elem.clone_elem(ctx, elem_dst_off);
                i = i + 1 as u64;
            }
            // Recompute raw from current base (zone may have grown during elements).
            return (ctx.zone_dst.holder.base as i64 + dst_off as i64) as *mut u8;
        }
    }
}

// ── Map<Bitmap, V> blanket — bitmap-indexed compact map clone ─────────────

impl<V: CloneElem> HermesClone for Map<Bitmap, V> {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let src_off: u32 = (self as i64 - ctx.base_src as i64) as u32;
            let a: *const Map<Bitmap, V> = (ctx.base_src as i64 + src_off as i64) as *const Map<Bitmap, V>;
            let src_header: u64 = a.header;
            let src_data_off: u32 = a.data;
            let cap: u32 = ((src_header >> 52 as u64) & 0x3F as u64) as u32;

            let tc: u8 = type_code_of::<Map<Bitmap, V>>() as u8;
            let tm_raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst,
                                      sizeof::<Map<Bitmap, V>>() as i64, tc, hermes_desc_map());
            if tm_raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_off: u32 = (tm_raw as i64 - ctx.zone_dst.holder.base as i64) as u32;
            if ctx.map != 0 as *mut CloneMap { clone_map_insert(ctx.map, src_off, dst_off); }

            let elem_sz: i64 = sizeof::<V>() as i64;
            let arr_raw: *mut u8 = zone_m_alloc_raw(ctx.zone_dst, cap as i64 * elem_sz);
            if arr_raw == 0 as *mut u8 {
                clone_map_on_oom(ctx.map, src_off);
                return 0 as *mut u8;
            }
            let arr_off: u32 = (arr_raw as i64 - ctx.zone_dst.holder.base as i64) as u32;

            // Write header fields using current base.
            let dst_base: *mut u8 = ctx.zone_dst.holder.base;
            let new_map: *mut Map<Bitmap, V> = (dst_base as i64 + dst_off as i64) as *mut Map<Bitmap, V>;
            new_map.header = src_header;
            new_map.data   = arr_off;

            let mask: u64 = 0x000FFFFFFFFFFFFF as u64;
            let bitmap: u64 = src_header & mask;
            let src_arr_base: i64 = ctx.base_src as i64 + src_data_off as i64;
            let mut key: u8 = 0 as u8;
            while key < 52 as u8 {
                let key_bit: u64 = 1 as u64 << key as u64;
                if (bitmap & key_bit) != 0 as u64 {
                    let m: u64 = key_bit - 1 as u64;
                    let pos: u32 = popcount_u64(bitmap & m);
                    let src_v: *const V = (src_arr_base + (pos as i64) * elem_sz) as *const V;
                    let elem_dst_off: u32 = arr_off + ((pos as i64) * elem_sz) as u32;
                    src_v.clone_elem(ctx, elem_dst_off);
                }
                key = key + 1 as u8;
            }
            return (ctx.zone_dst.holder.base as i64 + dst_off as i64) as *mut u8;
        }
    }
}

// ── ObjectMap (101) ───────────────────────────────────────────────────────

impl HermesClone for ObjectMap {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let src_off: u32 = (self as i64 - ctx.base_src as i64) as u32;
            let a: *const ObjectMap = (ctx.base_src as i64 + src_off as i64) as *const ObjectMap;
            let cap: u32 = a.capacity;
            let src_entries_off: u32 = a.entries_off;

            let om_raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, sizeof::<ObjectMap>() as i64,
                                      hermes_tag_map(), hermes_desc_map());
            if om_raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_off: u32 = (om_raw as i64 - ctx.zone_dst.holder.base as i64) as u32;
            if ctx.map != 0 as *mut CloneMap { clone_map_insert(ctx.map, src_off, dst_off); }

            let ent_raw: *mut u8 = zone_m_alloc_raw(ctx.zone_dst, cap as i64 * 8 as i64);
            if ent_raw == 0 as *mut u8 {
                clone_map_on_oom(ctx.map, src_off);
                return 0 as *mut u8;
            }
            let ent_off: u32 = (ent_raw as i64 - ctx.zone_dst.holder.base as i64) as u32;

            // Init ObjectMap header with current (post-alloc) base and pointers.
            let dst_base: *mut u8 = ctx.zone_dst.holder.base;
            let new_map: *mut ObjectMap = ObjectMap::init(
                (dst_base as i64 + dst_off as i64) as *mut u8,
                dst_base,
                (dst_base as i64 + ent_off as i64) as *mut u8,
                cap);

            let src_ent_base: i64 = ctx.base_src as i64 + src_entries_off as i64;
            let mut slot: u32 = 0 as u32;
            while slot < cap {
                let ep: *const MapEntry =
                    (src_ent_base + slot as i64 * 8 as i64) as *const MapEntry;
                if ep.key_off != 0 as u32 {
                    let new_key_av: AnyVal = anyval_clone(AnyVal::from_offset(ep.key_off), ctx);
                    if new_key_av.is_null() { return 0 as *mut u8; }
                    let new_key_off: u32 = new_key_av.as_offset();

                    let src_v: AnyVal = AnyVal { raw: ep.val };
                    let new_v: AnyVal = anyval_clone(src_v, ctx);

                    // Re-read base after both anyval_clone calls (zone may have grown).
                    let cur_base: *mut u8 = ctx.zone_dst.holder.base;
                    let new_key_ptr: *const HermesString =
                        (cur_base as i64 + new_key_off as i64) as *const HermesString;
                    let new_kbytes: *const u8 = new_key_ptr.bytes();
                    let new_klen: u64 = new_key_ptr.len();
                    let om_ptr: *mut ObjectMap =
                        (cur_base as i64 + dst_off as i64) as *mut ObjectMap;
                    om_ptr.set(cur_base, new_key_off, new_kbytes, new_klen, new_v);
                }
                slot = slot + 1 as u32;
            }
            return (ctx.zone_dst.holder.base as i64 + dst_off as i64) as *mut u8;
        }
    }
}

// ── TypedValue (106) ───────────────────────────────────────────────────────

impl HermesClone for TypedValue {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let src_off: u32 = (self as i64 - ctx.base_src as i64) as u32;
            let t: *const TypedValue = (ctx.base_src as i64 + src_off as i64) as *const TypedValue;
            let src_type_off: u32 = t.type_off;
            let src_params_raw: u32 = t.params_raw;
            let src_init_raw: u32 = t.init_raw;

            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, sizeof::<TypedValue>() as i64,
                                   hermes_tag_typed_value(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_off: u32 = (raw as i64 - ctx.zone_dst.holder.base as i64) as u32;
            if ctx.map != 0 as *mut CloneMap { clone_map_insert(ctx.map, src_off, dst_off); }

            let ty_av: AnyVal = anyval_clone(AnyVal::from_offset(src_type_off), ctx);
            if ty_av.is_null() || !ty_av.is_ptr() {
                clone_map_on_oom(ctx.map, src_off);
                return 0 as *mut u8;
            }

            let params_new: AnyVal = anyval_clone(AnyVal { raw: src_params_raw }, ctx);
            if src_params_raw != 0 as u32 && params_new.is_null() {
                clone_map_on_oom(ctx.map, src_off);
                return 0 as *mut u8;
            }

            let init_new: AnyVal = anyval_clone(AnyVal { raw: src_init_raw }, ctx);
            if src_init_raw != 0 as u32 && init_new.is_null() {
                clone_map_on_oom(ctx.map, src_off);
                return 0 as *mut u8;
            }

            // Recompute raw after three potential zone grows.
            let raw2: *mut u8 = (ctx.zone_dst.holder.base as i64 + dst_off as i64) as *mut u8;
            TypedValue::init(raw2, ty_av.as_offset(), params_new, init_new);
            return raw2;
        }
    }
}

// ── TypedArray (102) ──────────────────────────────────────────────────────────

impl HermesClone for TypedArray {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let src_off: u32 = (self as i64 - ctx.base_src as i64) as u32;
            let t: *const TypedArray = (ctx.base_src as i64 + src_off as i64) as *const TypedArray;
            let src_type_off: u32 = t.type_off;
            let src_arr_off: u32  = t.arr_off;

            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, sizeof::<TypedArray>() as i64,
                                   hermes_tag_typed_array(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_off: u32 = (raw as i64 - ctx.zone_dst.holder.base as i64) as u32;
            if ctx.map != 0 as *mut CloneMap { clone_map_insert(ctx.map, src_off, dst_off); }

            let type_av: AnyVal = anyval_clone(AnyVal::from_offset(src_type_off), ctx);
            if type_av.is_null() || !type_av.is_ptr() {
                clone_map_on_oom(ctx.map, src_off);
                return 0 as *mut u8;
            }
            let arr_av: AnyVal = anyval_clone(AnyVal::from_offset(src_arr_off), ctx);
            if arr_av.is_null() || !arr_av.is_ptr() {
                clone_map_on_oom(ctx.map, src_off);
                return 0 as *mut u8;
            }
            let raw2: *mut u8 = (ctx.zone_dst.holder.base as i64 + dst_off as i64) as *mut u8;
            TypedArray::init(raw2, type_av.as_offset(), arr_av.as_offset());
            return raw2;
        }
    }
}

// ── TypedMap (103) ────────────────────────────────────────────────────────────

impl HermesClone for TypedMap {
    pub fn clone_to(&self, ctx: *mut CloneCtx) -> *mut u8 {
        unsafe {
            let src_off: u32 = (self as i64 - ctx.base_src as i64) as u32;
            let t: *const TypedMap = (ctx.base_src as i64 + src_off as i64) as *const TypedMap;
            let src_type_off: u32 = t.type_off;
            let src_map_off: u32  = t.map_off;

            let raw: *mut u8 = zone_m_alloc_tagged(ctx.zone_dst, sizeof::<TypedMap>() as i64,
                                   hermes_tag_typed_map(), hermes_desc_data());
            if raw == 0 as *mut u8 { return 0 as *mut u8; }
            let dst_off: u32 = (raw as i64 - ctx.zone_dst.holder.base as i64) as u32;
            if ctx.map != 0 as *mut CloneMap { clone_map_insert(ctx.map, src_off, dst_off); }

            let type_av: AnyVal = anyval_clone(AnyVal::from_offset(src_type_off), ctx);
            if type_av.is_null() || !type_av.is_ptr() {
                clone_map_on_oom(ctx.map, src_off);
                return 0 as *mut u8;
            }
            let map_av: AnyVal = anyval_clone(AnyVal::from_offset(src_map_off), ctx);
            if map_av.is_null() || !map_av.is_ptr() {
                clone_map_on_oom(ctx.map, src_off);
                return 0 as *mut u8;
            }
            let raw2: *mut u8 = (ctx.zone_dst.holder.base as i64 + dst_off as i64) as *mut u8;
            TypedMap::init(raw2, type_av.as_offset(), map_av.as_offset());
            return raw2;
        }
    }
}

// ── Document compactify ───────────────────────────────────────────────────────
//
// Creates a fresh zone, deep-copies every object reachable from the document
// root into it (unreachable/garbage objects are skipped), and returns the new
// zone.  The caller takes ownership of the returned Zone<Mutable>.
//
// capacity_hint: initial byte capacity for the destination zone.
//   Pass 0 to auto-size from the source zone's `used` bytes.
//
// Returns a zero-holder Zone on OOM or if the source has no DocumentHeader.
pub unsafe fn document_compactify(src_zone: *const Zone<Mutable>,
                                  capacity_hint: i64) -> Zone<Mutable> {
    if src_zone == 0 as *const Zone<Mutable> {
        return Zone { holder: 0 as *mut MemHolder };
    }
    let src_holder: *mut MemHolder = src_zone.holder;
    if src_holder == 0 as *mut MemHolder {
        return Zone { holder: 0 as *mut MemHolder };
    }

    let src_base: *const u8 = src_holder.base as *const u8;

    // Determine destination capacity.
    let cap: i64 = if capacity_hint > 0 as i64 {
        capacity_hint
    } else {
        let u: i64 = src_holder.used;
        if u < 64 as i64 { 64 as i64 } else { u }
    };

    // Allocate destination zone.
    let mut dst_zone: Zone<Mutable> = zone_create(cap);
    if dst_zone.holder == 0 as *mut MemHolder {
        return Zone { holder: 0 as *mut MemHolder };
    }

    // Pre-allocate DocumentHeader at dst offset 0.
    let hdr_raw: *mut u8 = zone_m_alloc_raw(&mut dst_zone, 8);
    if hdr_raw == 0 as *mut u8 {
        dst_zone.release();
        return Zone { holder: 0 as *mut MemHolder };
    }
    let dst_doc: *mut DocumentHeader = document_create(hdr_raw);

    // Read root from source.
    let src_doc: *const DocumentHeader = src_base as *const DocumentHeader;
    let src_root: AnyVal = document_get_root(src_doc);

    // Clone the reachable object graph starting from root.
    let mut clone_map: CloneMap = clone_map_create();
    if clone_map.keys == 0 as *mut u32 {
        dst_zone.release();
        return Zone { holder: 0 as *mut MemHolder };
    }
    let mut ctx: CloneCtx = CloneCtx {
        base_src: src_base,
        zone_dst: &mut dst_zone,
        map: &mut clone_map,
    };
    let new_root: AnyVal = anyval_clone(src_root, &mut ctx);
    clone_map_free(&mut clone_map);

    // OOM: anyval_clone returns null when a non-null zone-pointer couldn't be copied.
    // src_root.is_null() covers raw=0 (null ptr, which also has b0=0 and is_ptr=true).
    if !src_root.is_null() && new_root.is_null() {
        dst_zone.release();
        return Zone { holder: 0 as *mut MemHolder };
    }

    // Store cloned root in destination header.
    document_set_root(dst_doc, new_root);

    return dst_zone;
}

// ── Document clone ────────────────────────────────────────────────────────────
//
// Raw byte-copy of the source zone: O(used bytes), faster than compactify
// because it skips dispatch and just memcpy's the entire live region.
// Unreachable (garbage) objects are preserved in the copy.
//
// Use clone() for a fast snapshot; use compactify() to reclaim space.
pub unsafe fn document_clone(src_zone: *const Zone<Mutable>) -> Zone<Mutable> {
    if src_zone == 0 as *const Zone<Mutable> {
        return Zone { holder: 0 as *mut MemHolder };
    }
    let src_holder: *mut MemHolder = src_zone.holder;
    if src_holder == 0 as *mut MemHolder {
        return Zone { holder: 0 as *mut MemHolder };
    }

    let nbytes: i64 = src_holder.used;

    // Empty source: nothing to copy.
    if nbytes <= 0 as i64 {
        return Zone { holder: 0 as *mut MemHolder };
    }

    // Add headroom so the clone zone is not immediately full.
    // Small zones get a flat 4096-byte bonus; larger get 25% extra.
    let cap: i64 = if nbytes < 4096 as i64 {
        nbytes + 4096 as i64
    } else {
        nbytes + nbytes / 4 as i64
    };

    let mut dst_zone: Zone<Mutable> = zone_create(cap);
    if dst_zone.holder == 0 as *mut MemHolder {
        return Zone { holder: 0 as *mut MemHolder };
    }

    // Raw copy of the entire live region; all offsets remain valid because
    // they are zone-relative (AnyVal stores u32 offsets, not absolute pointers).
    let src_bytes: *const u8 = src_holder.base as *const u8;
    let dst_holder: *mut MemHolder = dst_zone.holder;
    let dst_bytes: *mut u8 = dst_holder.base;
    let mut bi: i64 = 0 as i64;
    while bi < nbytes {
        *((dst_bytes as i64 + bi) as *mut u8) = *((src_bytes as i64 + bi) as *const u8);
        bi = bi + 1 as i64;
    }
    dst_holder.used = nbytes;

    return dst_zone;
}
