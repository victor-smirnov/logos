// Logos Hermes stdlib — hermes.mem_holder
//
// MemHolder: reference-counted owner of a byte buffer + bump cursor.
//
// Ownership-vs-allocation split (rearranged, not merged):
//   * MemHolder itself does NOT malloc or free memory.  It tracks the
//     lifetime of whatever buffer was handed to it via a user-supplied
//     destroyer callback that fires when the refcount reaches zero.
//   * memholder_alloc_backed() is a convenience allocator on top:
//     malloc() the holder struct AND the buffer, wire up libc `free`
//     as the destroyer.  Use it when you want the default heap
//     behaviour.
//   * For shared memory, mmap slabs, arena-from-outside, or anywhere
//     the buffer's lifetime is controlled by someone else, call
//     memholder_wrap() with your own destroyer (or the no-op
//     memholder_destroy_none).
//
// RC discipline (caller responsibility — Logos has no auto-Drop for generics):
//   memholder_wrap           → RC = 1
//   memholder_retain         → RC += 1  (for each new Zone / DataRef / DataOwn)
//   memholder_release        → RC -= 1  (call when Zone / DataRef / DataOwn goes away)

package hermes.mem_holder;

use hermes.datatag;

extern fn malloc(size: i64) -> *mut u8;
extern fn realloc(ptr: *mut u8, size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

// Destroyer callback: called once when RC reaches zero, with the buffer's
// base pointer and capacity.  Fixed signature keeps MemHolder a plain POD;
// callbacks that need extra state pack it into the buffer or carry it
// out-of-band.
pub type MemDestroyer = fn(*mut u8, i64) -> ();

// ---------------------------------------------------------------------------
// MemHolder — refcounted buffer view + bump cursor.
//
// Fields:
//   base      — pointer to the start of the underlying byte buffer
//   capacity  — total byte capacity of the buffer
//   used      — bytes consumed so far (bump-allocation cursor)
//   rc        — reference count (embedded, no extra allocation needed)
//   destroyer — called on (base, capacity) once RC hits zero; may be null
// ---------------------------------------------------------------------------
pub struct MemHolder {
    pub base:      *mut u8,
    pub capacity:  i64,
    pub used:      i64,
    pub rc:        i32,
    pub destroyer: MemDestroyer,
}

// ── Default destroyer callbacks ──────────────────────────────────────────

// No-op destroyer: caller manages the buffer's lifetime independently.
pub fn memholder_destroy_none(base: *mut u8, capacity: i64) {
    // intentionally empty
}

// libc free() destroyer: malloc'd buffers.
pub unsafe fn memholder_destroy_free(base: *mut u8, capacity: i64) {
    free(base);
}

// ── Construction ─────────────────────────────────────────────────────────

// Wrap a pre-allocated buffer.  The MemHolder struct itself is malloc'd
// (it's a tiny POD — 40 bytes — and refcounted across the program).
// `buffer` must be valid for the lifetime the destroyer decides to hold.
pub unsafe fn memholder_wrap(buffer:    *mut u8,
                             capacity:  i64,
                             destroyer: MemDestroyer) -> *mut MemHolder {
    let raw:    *mut u8        = malloc(sizeof::<MemHolder>());
    let holder: *mut MemHolder = raw as *mut MemHolder;
    holder.base      = buffer;
    holder.capacity  = capacity;
    holder.used      = 0;
    holder.rc        = 1;
    holder.destroyer = destroyer;
    return holder;
}

// Convenience: malloc a fresh buffer of `capacity` bytes and wrap it with
// the libc-free destroyer.  Equivalent to the old `memholder_create`.
pub unsafe fn memholder_alloc_backed(capacity: i64) -> *mut MemHolder {
    let buf: *mut u8 = malloc(capacity);
    return memholder_wrap(buf, capacity, memholder_destroy_free);
}

// ── Refcount ─────────────────────────────────────────────────────────────

pub unsafe fn memholder_retain(holder: *mut MemHolder) {
    holder.rc = holder.rc + 1;
}

// Decrement RC.  When RC reaches 0, invokes the destroyer on the buffer
// then frees the holder struct itself.  Do NOT access holder after this
// call if RC was 1.
pub unsafe fn memholder_release(holder: *mut MemHolder) {
    let new_rc: i32 = holder.rc - 1;
    holder.rc       = new_rc;
    if new_rc == 0 {
        // Drop the buffer (destroyer decides what that means).  Callback is
        // never null in practice — memholder_wrap requires one — but guard
        // the raw field in case someone zero-initialised the struct.
        let d: MemDestroyer = holder.destroyer;
        d(holder.base, holder.capacity);
        free(holder as *mut u8);
    }
}

// ── Bump allocation over the wrapped buffer ──────────────────────────────

// Grow the holder's buffer to fit at least `need` total bytes.
// Only works for malloc-backed holders (destroyer == memholder_destroy_free).
// Returns true on success; on success holder.base and holder.capacity are updated.
pub unsafe fn memholder_grow(holder: *mut MemHolder, need: i64) -> bool {
    if holder.destroyer as *const u8 != memholder_destroy_free as *const u8 {
        return false;
    }
    let new_cap: i64 = if holder.capacity * 2 >= need {
        holder.capacity * 2
    } else {
        need
    };
    let new_buf: *mut u8 = realloc(holder.base, new_cap);
    if new_buf == 0 as *mut u8 { return false; }
    holder.base     = new_buf;
    holder.capacity = new_cap;
    return true;
}

// Bump-allocate `size` bytes (8-byte aligned).
// Grows the backing buffer if needed (malloc-backed holders only).
// Returns null on OOM or if the holder is externally managed and full.
pub unsafe fn memholder_alloc(holder: *mut MemHolder, size: i64) -> *mut u8 {
    let aligned: i64    = (holder.used + 7) / 8 * 8;
    if aligned + size > holder.capacity {
        if !memholder_grow(holder, aligned + size) { return 0 as *mut u8; }
    }
    let base_int: i64   = holder.base as i64;
    let result: *mut u8 = (base_int + aligned) as *mut u8;
    holder.used         = aligned + size;
    return result;
}

// Allocate `size` bytes for a tagged object.  Reserves tag_size(type_code) bytes
// immediately before the object (vlen format), then 8-byte aligns.
// Writes the vlen tag via write_tag().
// Grows the backing buffer if needed.  Returns pointer to the object, or null.
pub unsafe fn memholder_alloc_tagged(holder: *mut MemHolder, size: i64, type_code: u64) -> *mut u8 {
    let tsz: i64        = tag_size(type_code);
    let pre: i64        = holder.used + tsz;
    let aligned: i64    = (pre + 7) / 8 * 8;
    if aligned + size > holder.capacity {
        if !memholder_grow(holder, aligned + size) { return 0 as *mut u8; }
    }
    let base_int: i64   = holder.base as i64;
    let obj: *mut u8    = (base_int + aligned) as *mut u8;
    write_tag(obj, type_code);
    holder.used         = aligned + size;
    return obj;
}

// ── Backward-compat alias ────────────────────────────────────────────────
// Callers that previously spelled `memholder_create(cap)` get the same
// libc-malloc-backed behaviour via `memholder_alloc_backed`.

pub unsafe fn memholder_create(capacity: i64) -> *mut MemHolder {
    return memholder_alloc_backed(capacity);
}

// ── HasMemHolder trait ────────────────────────────────────────────────────
// Objects that own or borrow a MemHolder expose this trait.
// Used to write storage-agnostic code over Zone<M>, Hermes, etc.

pub trait HasMemHolder {
    fn mem_holder(&self) -> *mut MemHolder;
}
