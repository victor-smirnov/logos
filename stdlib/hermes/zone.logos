// Logos Hermes stdlib — hermes.zone
//
// HermesZone: a bump allocator for Hermes datatypes.
// DataRef<T>: a fat zone pointer (base + u32 offset) to a datatype T.
//
// Phase 2/3: absolute base pointer in DataRef.
// Phase 7: will replace base with a u32 thin offset for full relocatability.

package hermes.zone;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

pub struct HermesZone {
    pub base: *mut u8,
    offset: i64,
    capacity: i64,
}

impl HermesZone {
    // Create a new zone backed by a malloc'd buffer of `capacity` bytes.
    pub fn create(capacity: i64) -> HermesZone {
        let base: *mut u8 = unsafe { malloc(capacity) };
        return HermesZone { base: base, offset: 0, capacity: capacity };
    }

    // Allocate `size` bytes, 8-byte aligned. Returns null on OOM.
    pub fn alloc_raw(&mut self, size: i64) -> *mut u8 {
        let aligned: i64 = (self.offset + 7) / 8 * 8;
        if aligned + size > self.capacity {
            return 0 as *mut u8;
        }
        let base_int: i64 = self.base as i64;
        let result: *mut u8 = (base_int + aligned) as *mut u8;
        self.offset = aligned + size;
        return result;
    }

    // Allocate `size` bytes for a tagged object.
    // Reserves 2 bytes before the object for the type tag, then aligns to 8.
    // Writes type_hash at (obj-2) and (descriptor<<3|1) at (obj-1).
    // Returns pointer to the object (after the tag), or null on OOM.
    pub unsafe fn alloc_tagged(&mut self, size: i64, type_hash: u8, descriptor: u8) -> *mut u8 {
        let pre: i64 = self.offset + 2;
        let aligned: i64 = (pre + 7) / 8 * 8;
        if aligned + size > self.capacity {
            return 0 as *mut u8;
        }
        let base_int: i64 = self.base as i64;
        let tag0: *mut u8 = (base_int + aligned - 2) as *mut u8;
        let tag1: *mut u8 = (base_int + aligned - 1) as *mut u8;
        *tag0 = type_hash;
        let d: u32 = descriptor as u32;
        let tag1_val: u8 = (1 as u32 | (d << 3 as u32)) as u8;
        *tag1 = tag1_val;
        self.offset = aligned + size;
        return (base_int + aligned) as *mut u8;
    }

    // Free the backing buffer. All DataRefs into this zone become invalid.
    pub fn destroy(&mut self) {
        unsafe { free(self.base); }
    }
}

// ---------------------------------------------------------------------------
// DataRef<T> — fat pointer (base + u32 offset) to a Hermes datatype T.
//
// base   — pointer to the start of the zone's memory buffer
// offset — byte offset from base to the object; fits in u32 (max zone = 4 GiB)
//
// Use ptr()     to get a *const T for field reads (requires unsafe context).
// Use mut_ptr() to get a *mut T for field writes (requires unsafe context).
// ---------------------------------------------------------------------------

pub struct DataRef<T> {
    pub base: *mut u8,
    pub offset: u32,
}

impl<T> DataRef<T> {
    // Returns a raw const pointer to the object. Requires unsafe to deref.
    pub unsafe fn ptr(self: *const DataRef<T>) -> *const T {
        let base_int: i64 = self.base as i64;
        let off: i64 = self.offset as i64;
        return (base_int + off) as *const T;
    }

    // Returns a raw mutable pointer to the object. Requires unsafe to deref.
    pub unsafe fn mut_ptr(self: *const DataRef<T>) -> *mut T {
        let base_int: i64 = self.base as i64;
        let off: i64 = self.offset as i64;
        return (base_int + off) as *mut T;
    }
}
