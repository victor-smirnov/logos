// Logos Hermes stdlib — hermes.string
//
// Phase 10: vlen_u64_56 variable-length integer encoding and HermesString.
//
// vlen rules (wire-format §4):
//   value < 249             → 1 byte  = value
//   value >= 249            → 1 byte  = 248 + N (byte count)
//                             N bytes = value little-endian
//
// HermesString layout in zone: [vlen_length: 1+ bytes][UTF-8 bytes]
// Always allocate vlen_encode_size(len) + len bytes before calling init.

package hermes.string;

use logos.lang.datatypes;
use hermes.tags;
use std.mem;

// ---------------------------------------------------------------------------
// FNV-1a hash (used by ObjectMap for string key hashing)
// ---------------------------------------------------------------------------

pub unsafe fn hermes_fnv1a(ptr: *const u8, len: u64) -> u64 {
    let mut h: u64 = 0xcbf29ce484222325;
    let prime: u64 = 0x100000001b3;
    let mut i: u64 = 0;
    while i < len {
        let p: *const u8 = ptr.byte_add(i as i64);
        let b: u64 = (*p) as u64;
        h = h ^ b;
        h = h * prime;
        i = i + 1;
    }
    return h;
}

// ---------------------------------------------------------------------------
// vlen helpers
// ---------------------------------------------------------------------------

// Number of bytes needed to encode `value` in vlen format.
// Values >= 2^56 (requiring 8+ data bytes) cannot be encoded: the marker
// byte (248+N) would overflow u8.  Such values are capped to the 7-byte
// maximum so that the returned size is always representable.
pub unsafe fn vlen_encode_size(value: u64) -> u32 {
    if value < 249 {
        return 1;
    }
    let mut n: u32 = 0;
    let mut v: u64 = value;
    while v > 0 {
        v = v >> 8;
        n = n + 1;
    }
    if n > 7 { n = 7; }
    return 1 + n;
}

// Write vlen-encoded `value` to dst. Returns number of bytes written.
pub unsafe fn vlen_write(dst: *mut u8, value: u64) -> u32 {
    if value < 249 {
        *dst = value as u8;
        return 1;
    }
    let mut n: u32 = 0;
    let mut v: u64 = value;
    while v > 0 {
        v = v >> 8;
        n = n + 1;
    }
    // Values >= 2^56 need n >= 8 data bytes; the marker byte (248+N) would
    // overflow u8.  Saturate to 7 (max the format can represent).
    if n > 7 { n = 7; }
    let marker: u8 = (248 + n) as u8;
    *dst = marker;
    let mut i: u32 = 0;
    let mut rem: u64 = value;
    while i < n {
        let p: *mut u8 = dst.byte_add(1 + i as i64);
        let byte_val: u8 = (rem & 0xFF) as u8;
        *p = byte_val;
        rem = rem >> 8;
        i = i + 1;
    }
    return 1 + n;
}

// Decode vlen value from src. Returns the decoded u64.
pub unsafe fn vlen_read(src: *const u8) -> u64 {
    let first: u8 = *src;
    let first_u32: u32 = first as u32;
    if first_u32 < 249 {
        return first as u64;
    }
    let n: u32 = first_u32 - 248;
    let mut value: u64 = 0;
    let mut i: u32 = 0;
    while i < n {
        let p: *const u8 = src.byte_add(1 + i as i64);
        let b: u64 = (*p) as u64;
        let shift: u64 = (i * 8) as u64;
        value = value | (b << shift);
        i = i + 1;
    }
    return value;
}

// Number of bytes consumed by the vlen prefix at src.
pub unsafe fn vlen_prefix_size(src: *const u8) -> u32 {
    let first: u8 = *src;
    let first_u32: u32 = first as u32;
    if first_u32 < 249 {
        return 1;
    }
    return first_u32 - 248 + 1;
}

// ---------------------------------------------------------------------------
// Varchar — logical genos ("variable-length string"), zone-eidos HermesString.
//
// HermesString is a typed anchor for a zone allocation that starts with a
// vlen length prefix followed immediately by UTF-8 bytes.  The 'first' field
// anchors the type; the actual object has dynamic size = vlen_prefix_size +
// len bytes.  The type_code is carried by the Varchar genos and propagates
// to HermesString via `impl Varchar for HermesString`.
// ---------------------------------------------------------------------------

// Canonical Varchar operations live on the genos itself — generic code
// can be written against any `V: Varchar` and call `v.len() / v.bytes() /
// v.hash() / v.equals_bytes(...)` uniformly.  Default bodies for
// equals_bytes and hash are expressed in terms of len/bytes so every new
// eidos only supplies the storage-specific primitives.
// Key-type marker for `Map<Varchar, V>` — a zero-size eidos that lives in
// the type namespace alongside the genos trait of the same name.
pub eidos Varchar { }

#[type_code = HermesTag::HermesString]
pub genos Varchar {
    unsafe fn len(self: *const Self) -> u64;
    unsafe fn bytes(self: *const Self) -> *const u8;

    unsafe fn equals_bytes(self: *const Self, other: *const u8, other_len: u64) -> bool {
        let my_len: u64 = self.len();
        if my_len != other_len { return false; }
        let my_b: *const u8 = self.bytes();
        let mut i: u64 = 0;
        while i < my_len {
            let pa: *const u8 = my_b.byte_add(i as i64);
            let pb: *const u8 = other.byte_add(i as i64);
            if *pa != *pb { return false; }
            i = i + 1;
        }
        return true;
    }

    unsafe fn hash(self: *const Self) -> u64 {
        return hermes_fnv1a(self.bytes(), self.len());
    }
}

pub eidos HermesString {
    pub first: u8,   // first byte of vlen length encoding
}

impl Varchar for HermesString {
    unsafe fn len(self: *const HermesString) -> u64 {
        return vlen_read(self as *const u8);
    }
    unsafe fn bytes(self: *const HermesString) -> *const u8 {
        let src: *const u8 = self as *const u8;
        let prefix: u32 = vlen_prefix_size(src);
        return src.byte_add(prefix as i64);
    }
}

impl HermesString {
    // Initialize a HermesString at pre-allocated memory.
    //   raw:  pointer to ≥ vlen_encode_size(len) + len bytes
    //   text: source UTF-8 bytes
    //   len:  byte count
    // Returns *mut HermesString = raw (same pointer, typed).
    pub unsafe fn init(raw: *mut u8, text: str, len: u64) -> *mut HermesString {
        return HermesString::init(raw, text.as_ptr(), len);
    }

    pub unsafe fn init(raw: *mut u8, text: *const u8, len: u64) -> *mut HermesString {
        let written: u32 = vlen_write(raw, len);
        let body: *mut u8 = raw.byte_add(written as i64);
        let mut i: u64 = 0;
        while i < len {
            let src_p: *const u8 = text.byte_add(i as i64);
            let dst_p: *mut u8   = body.byte_add(i as i64);
            *dst_p = *src_p;
            i = i + 1;
        }
        return raw as *mut HermesString;
    }
}

// ---------------------------------------------------------------------------
// View / Storage bridge — Datatype impl for HermesString.
//
// Processing format: `StringView` — ptr + len into an unspecified buffer.
// The same view is produced by Hermes (AOS, points into a zone-allocated
// HermesString's body) and by Buffer<HermesString> (SoA, points into the
// packed bytes array).  Callers work with StringView uniformly.
//
// Storage format (SoA):
//   • `bytes` — contiguous packed UTF-8 for all strings.
//   • `ends`  — u32 array, `ends[i]` = exclusive end offset of string i
//     within `bytes`.  Start offset of string i = (i==0) ? 0 : ends[i-1].
// ---------------------------------------------------------------------------

pub struct StringView {
    pub ptr: *const u8,
    pub len: u64,
}

impl Copy for StringView {}

pub struct HermesStringStorage {
    pub bytes: *mut u8,
    pub b_len: u64,
    pub b_cap: u64,
    pub ends:  *mut u32,
    pub o_len: u64,
    pub o_cap: u64,
}

// Storage for HermesStringStorage: SoA layout (packed bytes + end offsets);
// storage_get materialises a StringView on the fly from (bytes, ends[idx]).
// The view form matches zone-backed HermesString reads so container clients
// see a uniform shape.
impl Storage for HermesStringStorage {
    type Elem = StringView;
    fn storage_len(s: *const HermesStringStorage) -> u64 {
        unsafe { return s.o_len; }
    }
    fn storage_get(s: *const HermesStringStorage, idx: u64) -> StringView {
        unsafe {
            let end_p: *mut u32 = s.ends.add(idx as i64);
            let end_off: u64 = *end_p as u64;
            let start_off: u64 = if idx == 0 {
                0
            } else {
                let prev: *mut u32 = s.ends.add(idx as i64 - 1);
                *prev as u64
            };
            return StringView {
                ptr: s.bytes.byte_add(start_off as i64) as *const u8,
                len: end_off - start_off,
            };
        }
    }
}

impl OwningStorage for HermesStringStorage {
    fn storage_drop(s: *mut HermesStringStorage) {
        unsafe {
            if s.bytes != 0 as *mut u8 {
                dealloc(s.bytes);
                s.bytes = 0 as *mut u8;
            }
            if s.ends != 0 as *mut u32 {
                dealloc(s.ends as *mut u8);
                s.ends = 0 as *mut u32;
            }
            s.b_len = 0; s.b_cap = 0;
            s.o_len = 0; s.o_cap = 0;
        }
    }
}

impl DynamicStorage for HermesStringStorage {
    fn storage_new() -> HermesStringStorage {
        return HermesStringStorage {
            bytes: 0 as *mut u8,
            b_len: 0,
            b_cap: 0,
            ends:  0 as *mut u32,
            o_len: 0,
            o_cap: 0,
        };
    }
    fn storage_clear(s: *mut HermesStringStorage) {
        unsafe {
            if s.bytes != 0 as *mut u8 {
                dealloc(s.bytes);
                s.bytes = 0 as *mut u8;
            }
            if s.ends != 0 as *mut u32 {
                dealloc(s.ends as *mut u8);
                s.ends = 0 as *mut u32;
            }
            s.b_len = 0; s.b_cap = 0;
            s.o_len = 0; s.o_cap = 0;
        }
    }
    fn storage_push(s: *mut HermesStringStorage, v: StringView) {
        unsafe {
            // Grow bytes buffer to fit the new string.
            let need_b: u64 = s.b_len + v.len;
            if need_b > s.b_cap {
                let mut new_cap: u64 = if s.b_cap == 0 { 16 } else { s.b_cap * 2 };
                while new_cap < need_b { new_cap = new_cap * 2; }
                let new_buf: *mut u8 = if s.bytes == 0 as *mut u8 {
                    alloc(new_cap as i64)
                } else {
                    realloc_buf(s.bytes, new_cap as i64)
                };
                if new_buf == 0 as *mut u8 { return; }
                s.bytes = new_buf;
                s.b_cap = new_cap;
            }
            // Grow offsets buffer to fit the new end offset.
            if s.o_len == s.o_cap {
                let new_cap: u64 = if s.o_cap == 0 { 4 } else { s.o_cap * 2 };
                let new_buf: *mut u8 = if s.ends == 0 as *mut u32 {
                    alloc((new_cap * 4) as i64)
                } else {
                    realloc_buf(s.ends as *mut u8, (new_cap * 4) as i64)
                };
                if new_buf == 0 as *mut u8 { return; }
                s.ends  = new_buf as *mut u32;
                s.o_cap = new_cap;
            }
            // Copy bytes.
            let mut i: u64 = 0;
            while i < v.len {
                let dst: *mut u8 = s.bytes.byte_add(s.b_len as i64 + i as i64);
                let src: *const u8 = v.ptr.byte_add(i as i64);
                *dst = *src;
                i = i + 1;
            }
            s.b_len = s.b_len + v.len;
            // Append end-offset.
            let slot: *mut u32 = s.ends.add(s.o_len as i64);
            *slot = s.b_len as u32;
            s.o_len = s.o_len + 1;
        }
    }

}

impl Datatype for HermesString {
    type View<S: Storage> = StringView;
}

impl Container for HermesString {
    type Store       = HermesStringStorage;
    type ViewInStore = StringView;
    fn new_store()                                        -> HermesStringStorage { return HermesStringStorage::storage_new(); }
    fn drop_store(s: *mut HermesStringStorage)                                   { unsafe { HermesStringStorage::storage_drop(s); } }
    fn store_len(s: *const HermesStringStorage)           -> u64                 { unsafe { return HermesStringStorage::storage_len(s); } }
    fn store_push(s: *mut HermesStringStorage, v: StringView)                    { unsafe { HermesStringStorage::storage_push(s, v); } }
    fn store_get(s: *const HermesStringStorage, idx: u64) -> StringView          { unsafe { return HermesStringStorage::storage_get(s, idx); } }
}
