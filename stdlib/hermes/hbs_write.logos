// Logos Hermes stdlib — hermes.hbs_write
//
// HBS (Hermes Binary Serialization) writer.
//
// Format overview:
//   Header (12 bytes): magic "HBS1" + u32 flags=0 + u32 zone_used
//   Values: lead byte + payload
//   Zone objects get 0xFD id on first occurrence, 0xFE id on subsequent.
//
// Lead bytes:
//   0x00 null     0x01 false    0x02 true
//   0x10 i8       0x11 u8       0x12 i16LE   0x13 u16LE
//   0x14 i32LE    0x15 u32LE    0x16 i64LE   0x17 u64LE
//   0x22 decimal  0x30 string   0x40 array   0x41 objectmap
//   0x42 tinymap  0x50 tv       0x51 ta      0x52 tm
//   0x60 i64box   0x61 u64box   0x62 arr_i32 0x63 map_i32_anyval 0x64 arr_u64
//   0xFD DEF      0xFE REF

package hermes.hbs_write;

use hermes.anyval;
use hermes.zone;
use hermes.string;
use hermes.typetag;
use hermes.datatag;
use hermes.array;
use hermes.map;
use hermes.typed_value;
use hermes.objectmap;
use hermes.document;
use hermes.scalar;
use hermes.decimal;
use hermes.mem_holder;
use std.string;

extern fn malloc(size: i64) -> *mut u8;
extern fn realloc(ptr: *mut u8, size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

// ---------------------------------------------------------------------------
// Work item kinds for the write stack
// ---------------------------------------------------------------------------

const WK_VAL:      u8 = 0;   // write the AnyVal stored in obj_off (as raw)
const WK_ARR_IDX:  u8 = 1;   // write arr element at idx
const WK_MAP_SLOT: u8 = 2;   // write ObjectMap slot from idx..cap
const WK_TMAP_IDX: u8 = 3;   // write TinyObjectMap entry idx
const WK_MI32_IDX: u8 = 4;   // write Map<i32, AnyVal> entry idx

pub eidos WriteItem {
    pub kind:    u8,
    pub _pad0:   u8,
    pub _pad1:   u8,
    pub _pad2:   u8,
    pub obj_off: u32,  // AnyVal.raw for WK_VAL; zone offset for iterators
    pub idx:     u32,  // current index/slot
}

// ---------------------------------------------------------------------------
// Seen table (open-addressing hash map: zone_offset → stream_id)
// ---------------------------------------------------------------------------

pub struct SeenTable {
    pub keys: *mut u32,  // zone offsets (0 = empty)
    pub vals: *mut u32,  // stream ids (1-based)
    pub cap:  u32,
    pub cnt:  u32,
}

// ---------------------------------------------------------------------------
// Write state
// ---------------------------------------------------------------------------

pub struct HbsWriteState {
    pub base:      *const u8,
    pub buf:       *mut String,
    pub seen:      SeenTable,
    pub stack:     *mut WriteItem,
    pub stack_len: i64,
    pub stack_cap: i64,
    pub next_id:   u32,
}

// ---------------------------------------------------------------------------
// Output helpers
// ---------------------------------------------------------------------------

unsafe fn hbs_write_u8(buf: *mut String, v: u8) {
    buf.push_u8(v);
}

unsafe fn hbs_write_u16(buf: *mut String, v: u16) {
    buf.push_u8((v & 0xFF) as u8);
    buf.push_u8(((v >> 8) & 0xFF) as u8);
}

unsafe fn hbs_write_u32(buf: *mut String, v: u32) {
    buf.push_u8((v & 0xFF) as u8);
    buf.push_u8(((v >> 8) & 0xFF) as u8);
    buf.push_u8(((v >> 16) & 0xFF) as u8);
    buf.push_u8(((v >> 24) & 0xFF) as u8);
}

unsafe fn hbs_write_u64(buf: *mut String, v: u64) {
    hbs_write_u32(buf, (v & 0xFFFFFFFF) as u32);
    hbs_write_u32(buf, ((v >> 32) & 0xFFFFFFFF) as u32);
}

unsafe fn hbs_write_bytes(buf: *mut String, ptr: *const u8, len: i64) {
    let mut i: i64 = 0;
    while i < len {
        let b: u8 = *((ptr as i64 + i) as *const u8);
        buf.push_u8(b);
        i = i + 1;
    }
}

// ---------------------------------------------------------------------------
// SeenTable operations
// ---------------------------------------------------------------------------

unsafe fn seen_init(cap: u32) -> SeenTable {
    let sz: i64 = cap as i64 * 4;
    let keys: *mut u32 = malloc(sz) as *mut u32;
    let vals: *mut u32 = malloc(sz) as *mut u32;
    if keys == 0 as *mut u32 || vals == 0 as *mut u32 {
        if keys != 0 as *mut u32 { free(keys as *mut u8); }
        if vals != 0 as *mut u32 { free(vals as *mut u8); }
        return SeenTable { keys: 0 as *mut u32, vals: 0 as *mut u32, cap: 0, cnt: 0 };
    }
    // Zero-initialize keys (0 = empty sentinel).
    let mut i: i64 = 0;
    while i < sz {
        *((keys as i64 + i) as *mut u8) = 0;
        *((vals as i64 + i) as *mut u8) = 0;
        i = i + 1;
    }
    return SeenTable { keys: keys, vals: vals, cap: cap, cnt: 0 };
}

unsafe fn seen_free(s: *mut SeenTable) {
    if s.keys != 0 as *mut u32 { free(s.keys as *mut u8); s.keys = 0 as *mut u32; }
    if s.vals != 0 as *mut u32 { free(s.vals as *mut u8); s.vals = 0 as *mut u32; }
}

// Returns 0 if not found; otherwise returns the stream id.
unsafe fn seen_lookup(s: *const SeenTable, zone_off: u32) -> u32 {
    if s.cap == 0 { return 0; }
    let cap: u32 = s.cap;
    let mut slot: u32 = zone_off & (cap - 1);
    let mut probed: u32 = 0;
    while probed < cap {
        let kp: *const u32 = (s.keys as i64 + (slot as i64) * 4) as *const u32;
        let k: u32 = *kp;
        if k == 0 { return 0; }
        if k == zone_off {
            let vp: *const u32 = (s.vals as i64 + (slot as i64) * 4) as *const u32;
            return *vp;
        }
        slot = slot + 1;
        if slot >= cap { slot = 0; }
        probed = probed + 1;
    }
    return 0;
}

// Grow the seen table by doubling and rehashing.
unsafe fn seen_grow(s: *mut SeenTable) -> bool {
    let old_cap: u32 = s.cap;
    let new_cap: u32 = if old_cap == 0 { 16 } else { old_cap * 2 };
    let sz: i64 = new_cap as i64 * 4;
    let new_keys: *mut u32 = malloc(sz) as *mut u32;
    let new_vals: *mut u32 = malloc(sz) as *mut u32;
    if new_keys == 0 as *mut u32 || new_vals == 0 as *mut u32 {
        if new_keys != 0 as *mut u32 { free(new_keys as *mut u8); }
        if new_vals != 0 as *mut u32 { free(new_vals as *mut u8); }
        return false;
    }
    let mut i: i64 = 0;
    while i < sz {
        *((new_keys as i64 + i) as *mut u8) = 0;
        *((new_vals as i64 + i) as *mut u8) = 0;
        i = i + 1;
    }
    // Rehash old entries.
    let mut j: u32 = 0;
    while j < old_cap {
        let kp: *const u32 = (s.keys as i64 + (j as i64) * 4) as *const u32;
        let k: u32 = *kp;
        if k != 0 {
            let vp: *const u32 = (s.vals as i64 + (j as i64) * 4) as *const u32;
            let v: u32 = *vp;
            let mut slot: u32 = k & (new_cap - 1);
            let mut probed: u32 = 0;
            while probed < new_cap {
                let nkp: *mut u32 = (new_keys as i64 + (slot as i64) * 4) as *mut u32;
                if *nkp == 0 {
                    *nkp = k;
                    let nvp: *mut u32 = (new_vals as i64 + (slot as i64) * 4) as *mut u32;
                    *nvp = v;
                    probed = new_cap; // break
                } else {
                    slot = slot + 1;
                    if slot >= new_cap { slot = 0; }
                    probed = probed + 1;
                }
            }
        }
        j = j + 1;
    }
    free(s.keys as *mut u8);
    free(s.vals as *mut u8);
    s.keys = new_keys;
    s.vals = new_vals;
    s.cap = new_cap;
    return true;
}

unsafe fn seen_insert(s: *mut SeenTable, zone_off: u32, stream_id: u32) -> bool {
    // Load factor: expand if cnt >= cap*3/4.
    if s.cap == 0 || s.cnt >= (s.cap / 4) * 3 {
        if !seen_grow(s) { return false; }
    }
    let cap: u32 = s.cap;
    let mut slot: u32 = zone_off & (cap - 1);
    let mut probed: u32 = 0;
    while probed < cap {
        let kp: *mut u32 = (s.keys as i64 + (slot as i64) * 4) as *mut u32;
        if *kp == 0 {
            *kp = zone_off;
            let vp: *mut u32 = (s.vals as i64 + (slot as i64) * 4) as *mut u32;
            *vp = stream_id;
            s.cnt = s.cnt + 1;
            return true;
        }
        slot = slot + 1;
        if slot >= cap { slot = 0; }
        probed = probed + 1;
    }
    return false;
}

// ---------------------------------------------------------------------------
// Write stack operations
// ---------------------------------------------------------------------------

unsafe fn stack_push(ws: *mut HbsWriteState, item: WriteItem) -> bool {
    if ws.stack_len >= ws.stack_cap {
        let new_cap: i64 = ws.stack_cap * 2;
        let new_stk: *mut WriteItem = realloc(ws.stack as *mut u8,
            new_cap * sizeof::<WriteItem>() as i64) as *mut WriteItem;
        if new_stk == 0 as *mut WriteItem { return false; }
        ws.stack = new_stk;
        ws.stack_cap = new_cap;
    }
    let p: *mut WriteItem = (ws.stack as i64 + ws.stack_len * sizeof::<WriteItem>() as i64)
        as *mut WriteItem;
    p.kind    = item.kind;
    p._pad0   = item._pad0;
    p._pad1   = item._pad1;
    p._pad2   = item._pad2;
    p.obj_off = item.obj_off;
    p.idx     = item.idx;
    ws.stack_len = ws.stack_len + 1;
    return true;
}

unsafe fn stack_pop(ws: *mut HbsWriteState) -> WriteItem {
    ws.stack_len = ws.stack_len - 1;
    let p: *const WriteItem = (ws.stack as i64 + ws.stack_len * sizeof::<WriteItem>() as i64)
        as *const WriteItem;
    return WriteItem {
        kind:    p.kind,
        _pad0:   p._pad0,
        _pad1:   p._pad1,
        _pad2:   p._pad2,
        obj_off: p.obj_off,
        idx:     p.idx,
    };
}

// ---------------------------------------------------------------------------
// push_wk_val: push a WK_VAL item for an AnyVal
// ---------------------------------------------------------------------------

unsafe fn push_wk_val(ws: *mut HbsWriteState, raw: u32) -> bool {
    return stack_push(ws, WriteItem {
        kind: WK_VAL, _pad0: 0, _pad1: 0, _pad2: 0,
        obj_off: raw, idx: 0,
    });
}

// ---------------------------------------------------------------------------
// write_anyval_inline: write an inline (non-ptr) AnyVal
// ---------------------------------------------------------------------------

unsafe fn write_anyval_inline(ws: *mut HbsWriteState, val: AnyVal) {
    let buf: *mut String = ws.buf;
    if val.is_null() {
        hbs_write_u8(buf, 0x00);
        return;
    }
    let th: u8 = val.type_hash();
    if th == 37 {  // bool
        if val.as_bool() {
            hbs_write_u8(buf, 0x02);
        } else {
            hbs_write_u8(buf, 0x01);
        }
        return;
    }
    if th == 20 {  // i8
        hbs_write_u8(buf, 0x10);
        hbs_write_u8(buf, val.as_i64() as u8);
        return;
    }
    if th == 21 {  // u8
        hbs_write_u8(buf, 0x11);
        hbs_write_u8(buf, val.as_u64() as u8);
        return;
    }
    if th == 22 {  // i16
        hbs_write_u8(buf, 0x12);
        hbs_write_u16(buf, val.as_i64() as u16);
        return;
    }
    if th == 24 {  // u16
        hbs_write_u8(buf, 0x13);
        hbs_write_u16(buf, val.as_u64() as u16);
        return;
    }
    if th == 23 {  // i24 (sign-extend to i32)
        hbs_write_u8(buf, 0x14);
        hbs_write_u32(buf, val.as_i64() as u32);
        return;
    }
    if th == 25 {  // u24 -> u32
        hbs_write_u8(buf, 0x15);
        hbs_write_u32(buf, val.as_u64() as u32);
        return;
    }
    // Unknown inline: emit as u32
    hbs_write_u8(buf, 0x15);
    hbs_write_u32(buf, val.raw);
}

// ---------------------------------------------------------------------------
// write_zone_object: write the DEF prefix + object data, push children.
// Called on first visit of a zone object.
// ---------------------------------------------------------------------------

unsafe fn write_zone_object(ws: *mut HbsWriteState, off: u32, stream_id: u32) {
    let base: *const u8 = ws.base;
    let buf: *mut String = ws.buf;
    let obj: *const u8 = (base as i64 + off as i64) as *const u8;
    let tag: u64 = read_type_code(obj);

    hbs_write_u8(buf, 0xFD);
    hbs_write_u32(buf, stream_id);

    if tag == hermes_tag_string() {  // 28
        let vlen_sz: i64 = vlen_prefix_size(obj) as i64;
        let str_len: i64 = vlen_read(obj) as i64;
        hbs_write_u8(buf, 0x30);
        hbs_write_u32(buf, str_len as u32);
        let str_ptr: *const u8 = (obj as i64 + vlen_sz) as *const u8;
        hbs_write_bytes(buf, str_ptr, str_len);
        return;
    }

    if tag == hermes_tag_i64() {  // 26
        let p: *const I64 = obj as *const I64;
        hbs_write_u8(buf, 0x60);
        hbs_write_u64(buf, p.value() as u64);
        return;
    }

    if tag == hermes_tag_u64() {  // 27
        let p: *const U64 = obj as *const U64;
        hbs_write_u8(buf, 0x61);
        hbs_write_u64(buf, p.value());
        return;
    }

    if tag == hermes_tag_decimal() {  // 107
        let d: *const Decimal = obj as *const Decimal;
        let nlimbs: u32 = d.len();
        hbs_write_u8(buf, 0x22);
        // Write spec_and_len (the full packed field: scale+precision+nlimbs+sign)
        hbs_write_u32(buf, d.spec_and_len);
        // Write limbs
        let limbs_ptr: *const u32 = d.limbs();
        let mut li: u32 = 0;
        while li < nlimbs {
            let lv: u32 = *((limbs_ptr as i64 + (li as i64) * 4) as *const u32);
            hbs_write_u32(buf, lv);
            li = li + 1;
        }
        return;
    }

    if tag == hermes_tag_array() {  // 100
        let arr: *const Array<AnyVal> = obj as *const Array<AnyVal>;
        let sz: u64 = arr.size;
        hbs_write_u8(buf, 0x40);
        hbs_write_u32(buf, sz as u32);
        if sz > 0 {
            // Push WK_ARR_IDX{off, idx=0}
            stack_push(ws, WriteItem {
                kind: WK_ARR_IDX, _pad0: 0, _pad1: 0, _pad2: 0,
                obj_off: off, idx: 0,
            });
        }
        return;
    }

    if tag == hermes_tag_tiny_map() {  // 98
        let m: *const Map<Bitmap, AnyVal> = obj as *const Map<Bitmap, AnyVal>;
        let bitmap: u64 = m.header & 0x000FFFFFFFFFFFFF;
        let sz: u32 = ((m.header >> 58) & 0x3F) as u32;
        hbs_write_u8(buf, 0x42);
        hbs_write_u32(buf, sz);
        if sz > 0 {
            // Push WK_TMAP_IDX: we iterate bitmap positions
            // Store bitmap_low in obj_off field (we need the bitmap to iterate).
            // Since the map is at `off`, WK_TMAP_IDX will re-read it from base.
            stack_push(ws, WriteItem {
                kind: WK_TMAP_IDX, _pad0: 0, _pad1: 0, _pad2: 0,
                obj_off: off, idx: 0,
            });
        }
        return;
    }

    if tag == hermes_tag_map() {  // 101
        let m: *const ObjectMap = obj as *const ObjectMap;
        let cnt: u32 = m.count;
        hbs_write_u8(buf, 0x41);
        hbs_write_u32(buf, cnt);
        if cnt > 0 {
            stack_push(ws, WriteItem {
                kind: WK_MAP_SLOT, _pad0: 0, _pad1: 0, _pad2: 0,
                obj_off: off, idx: 0,
            });
        }
        return;
    }

    if tag == hermes_tag_typed_value() {  // 106
        let tv: *const TypedValue = obj as *const TypedValue;
        hbs_write_u8(buf, 0x50);
        // Push in reverse order (stack is LIFO): init last, params middle, type first
        // We want to write: type_str, params, init
        // Push: init (processed last), params (middle), type (first)
        push_wk_val(ws, AnyVal { raw: tv.init_raw }.raw);
        push_wk_val(ws, AnyVal { raw: tv.params_raw }.raw);
        push_wk_val(ws, AnyVal::from_offset(tv.type_off.offset).raw);
        return;
    }

    if tag == hermes_tag_array_i32() {  // 104
        let arr: *const Array<i32> = obj as *const Array<i32>;
        let sz: u64 = arr.size;
        hbs_write_u8(buf, 0x62);
        hbs_write_u32(buf, sz as u32);
        let data_ptr: *const i32 = (base as i64 + arr.data.offset) as *const i32;
        let mut i: u64 = 0;
        while i < sz {
            let iv: i32 = *((data_ptr as i64 + (i as i64) * 4) as *const i32);
            hbs_write_u32(buf, iv as u32);
            i = i + 1;
        }
        return;
    }

    if tag == hermes_tag_array_u64() {  // 108
        let arr: *const Array<u64> = obj as *const Array<u64>;
        let sz: u64 = arr.size;
        hbs_write_u8(buf, 0x64);
        hbs_write_u32(buf, sz as u32);
        let data_ptr: *const u8 = (base as i64 + arr.data.offset) as *const u8;
        let mut i: u64 = 0;
        while i < sz {
            let uv: u64 = *((data_ptr as i64 + (i as i64) * 8) as *const u64);
            hbs_write_u64(buf, uv);
            i = i + 1;
        }
        return;
    }

    if tag == hermes_tag_map_i32_anyval() {  // 105
        let m: *const Map<i32, AnyVal> = obj as *const Map<i32, AnyVal>;
        let sz: u32 = m.size;
        hbs_write_u8(buf, 0x63);
        hbs_write_u32(buf, sz);
        if sz > 0 {
            // Write keys inline, push WK_MI32_IDX for values
            let keys_ptr: *const i32 = (base as i64 + m.keys.offset) as *const i32;
            let mut ki: u32 = 0;
            while ki < sz {
                let kv: i32 = *((keys_ptr as i64 + (ki as i64) * 4) as *const i32);
                hbs_write_u32(buf, kv as u32);
                ki = ki + 1;
            }
            stack_push(ws, WriteItem {
                kind: WK_MI32_IDX, _pad0: 0, _pad1: 0, _pad2: 0,
                obj_off: off, idx: 0,
            });
        }
        return;
    }
    // Unknown tag: skip
}

// ---------------------------------------------------------------------------
// process_wk_val: handle a WK_VAL item
// ---------------------------------------------------------------------------

unsafe fn process_wk_val(ws: *mut HbsWriteState, raw: u32) {
    let val: AnyVal = AnyVal { raw: raw };
    if val.is_null() {
        hbs_write_u8(ws.buf, 0x00);
        return;
    }
    if !val.is_ptr() {
        write_anyval_inline(ws, val);
        return;
    }
    let off: u32 = val.as_offset();
    let existing: u32 = seen_lookup(&ws.seen, off);
    if existing != 0 {
        hbs_write_u8(ws.buf, 0xFE);
        hbs_write_u32(ws.buf, existing);
        return;
    }
    let id: u32 = ws.next_id;
    ws.next_id = ws.next_id + 1;
    seen_insert(&mut ws.seen, off, id);
    write_zone_object(ws, off, id);
}

// ---------------------------------------------------------------------------
// process_wk_arr_idx: handle a WK_ARR_IDX item
// ---------------------------------------------------------------------------

unsafe fn process_wk_arr_idx(ws: *mut HbsWriteState, obj_off: u32, idx: u32) {
    let base: *const u8 = ws.base;
    let arr: *const Array<AnyVal> = (base as i64 + obj_off) as *const Array<AnyVal>;
    let sz: u64 = arr.size;
    if (idx as u64) >= sz { return; }
    let next_idx: u32 = idx + 1;
    if (next_idx as u64) < sz {
        stack_push(ws, WriteItem {
            kind: WK_ARR_IDX, _pad0: 0, _pad1: 0, _pad2: 0,
            obj_off: obj_off, idx: next_idx,
        });
    }
    let buf_off: i64 = arr.data.offset;
    let ep: *const AnyVal = (base as i64 + buf_off + (idx as i64) * 4) as *const AnyVal;
    let elem_raw: u32 = ep.raw;
    // Push the element value AFTER the continuation (LIFO: elem processed first)
    push_wk_val(ws, elem_raw);
}

// ---------------------------------------------------------------------------
// process_wk_map_slot: handle a WK_MAP_SLOT item
// ---------------------------------------------------------------------------

unsafe fn process_wk_map_slot(ws: *mut HbsWriteState, obj_off: u32, slot: u32) {
    let base: *const u8 = ws.base;
    let m: *const ObjectMap = (base as i64 + obj_off) as *const ObjectMap;
    let cap: u32 = m.capacity;
    let ent_off: i64 = m.entries_off.offset as i64;

    // Find next non-empty slot starting from `slot`
    let mut s: u32 = slot;
    while s < cap {
        let ep: *const MapEntry =
            (base as i64 + ent_off + (s as i64) * 8) as *const MapEntry;
        if ep.key_off.offset != 0 {
            // Found a non-empty slot.
            let next_s: u32 = s + 1;
            if next_s < cap {
                stack_push(ws, WriteItem {
                    kind: WK_MAP_SLOT, _pad0: 0, _pad1: 0, _pad2: 0,
                    obj_off: obj_off, idx: next_s,
                });
            }
            // Push val then key (LIFO: key processed first)
            let val: AnyVal = AnyVal { raw: ep.val };
            push_wk_val(ws, val.raw);
            push_wk_val(ws, AnyVal::from_offset(ep.key_off.offset).raw);
            return;
        }
        s = s + 1;
    }
}

// ---------------------------------------------------------------------------
// process_wk_tmap_idx: handle a WK_TMAP_IDX item
// TinyObjectMap iterates bit positions in the bitmap.
// Keys are the bit positions (0..51), values at compacted positions.
// ---------------------------------------------------------------------------

unsafe fn process_wk_tmap_idx(ws: *mut HbsWriteState, obj_off: u32, idx: u32) {
    let base: *const u8 = ws.base;
    let m: *const Map<Bitmap, AnyVal> = (base as i64 + obj_off) as *const Map<Bitmap, AnyVal>;
    let bitmap: u64 = m.header & 0x000FFFFFFFFFFFFF;
    let sz: u32 = ((m.header >> 58) & 0x3F) as u32;

    // `idx` is the entry index (0..sz). Find the idx-th set bit in bitmap.
    let mut bit_pos: u32 = 0;
    let mut found: u32 = 0;
    let mut key_bit: u8 = 255;
    let mut k: u8 = 0;
    while k < 52 {
        let kb: u64 = 1 << k as u64;
        if (bitmap & kb) != 0 {
            if found == idx {
                key_bit = k;
                bit_pos = found;
                k = 52; // break
            }
            found = found + 1;
        }
        k = k + 1;
    }
    if key_bit == 255 { return; }

    let next_idx: u32 = idx + 1;
    if next_idx < sz {
        stack_push(ws, WriteItem {
            kind: WK_TMAP_IDX, _pad0: 0, _pad1: 0, _pad2: 0,
            obj_off: obj_off, idx: next_idx,
        });
    }

    // Get the value at position = popcount(bitmap & bits_below_key_bit).
    let mask: u64 = (1 << key_bit as u64) - 1;
    let pos: u32 = popcount_u64(bitmap & mask);
    let data_off: i64 = m.data.offset;
    let ep: *const AnyVal = (base as i64 + data_off + (pos as i64) * 4) as *const AnyVal;
    let val_raw: u32 = ep.raw;

    // Push val then key (LIFO: key processed first)
    // Key is the u8 key_bit, written as u8 inline
    push_wk_val(ws, AnyVal { raw: val_raw }.raw);
    // Write the key directly (u8 type, inline as AnyVal with embed_u8)
    // We write it as a synthetic WK_VAL that represents a u8 AnyVal.
    // Actually we need to write the key as a u8 value. We use embed_u8 equivalent:
    // type_hash=21 (u8), payload = key_bit.
    // AnyVal inline format: bit0=1, bits[7:1]=type_hash, bits[31:8]=payload
    // embed_u8: raw = 1 | (21 << 1) | (key_bit << 8)
    let key_raw: u32 = 1 | (21 << 1) | ((key_bit as u32) << 8);
    push_wk_val(ws, key_raw);
}

// ---------------------------------------------------------------------------
// process_wk_mi32_idx: handle a WK_MI32_IDX item
// ---------------------------------------------------------------------------

unsafe fn process_wk_mi32_idx(ws: *mut HbsWriteState, obj_off: u32, idx: u32) {
    let base: *const u8 = ws.base;
    let m: *const Map<i32, AnyVal> = (base as i64 + obj_off) as *const Map<i32, AnyVal>;
    let sz: u32 = m.size;
    if idx >= sz { return; }
    let next_idx: u32 = idx + 1;
    if next_idx < sz {
        stack_push(ws, WriteItem {
            kind: WK_MI32_IDX, _pad0: 0, _pad1: 0, _pad2: 0,
            obj_off: obj_off, idx: next_idx,
        });
    }
    let vals_ptr: *const AnyVal = (base as i64 + m.vals.offset) as *const AnyVal;
    let val: AnyVal = *((vals_ptr as i64 + (idx as i64) * 4) as *const AnyVal);
    push_wk_val(ws, val.raw);
}

// ---------------------------------------------------------------------------
// hbs_write: serialize a Hermes zone document to a byte buffer.
// ---------------------------------------------------------------------------

pub unsafe fn hbs_write(zone: *const Zone<Mutable>, buf: *mut String) {
    let holder: *mut MemHolder = zone.holder;
    if holder == 0 as *mut MemHolder {
        return;
    }
    let base: *const u8 = holder.base;
    if base == 0 as *const u8 { return; }
    let zone_used: i64 = holder.used;

    // Write header: "HBS1" + flags=0 + zone_used
    hbs_write_u8(buf, 72);   // 'H'
    hbs_write_u8(buf, 66);   // 'B'
    hbs_write_u8(buf, 83);   // 'S'
    hbs_write_u8(buf, 49);   // '1'
    hbs_write_u32(buf, 0);  // flags
    hbs_write_u32(buf, zone_used as u32);

    let init_stk_cap: i64 = 256;
    let stk_raw: *mut WriteItem = malloc(init_stk_cap * sizeof::<WriteItem>() as i64) as *mut WriteItem;
    if stk_raw == 0 as *mut WriteItem { return; }

    let mut ws: HbsWriteState = HbsWriteState {
        base:      base,
        buf:       buf,
        seen:      seen_init(256),
        stack:     stk_raw,
        stack_len: 0,
        stack_cap: init_stk_cap,
        next_id:   1,
    };

    if ws.seen.keys == 0 as *mut u32 {
        free(stk_raw as *mut u8);
        return;
    }

    // Get root and push it.
    let doc: *const DocumentHeader = base as *const DocumentHeader;
    let root: AnyVal = document_get_root(doc);

    push_wk_val(&mut ws, root.raw);

    while ws.stack_len > 0 {
        let item: WriteItem = stack_pop(&mut ws);
        if item.kind == WK_VAL {
            process_wk_val(&mut ws, item.obj_off);
        } else if item.kind == WK_ARR_IDX {
            process_wk_arr_idx(&mut ws, item.obj_off, item.idx);
        } else if item.kind == WK_MAP_SLOT {
            process_wk_map_slot(&mut ws, item.obj_off, item.idx);
        } else if item.kind == WK_TMAP_IDX {
            process_wk_tmap_idx(&mut ws, item.obj_off, item.idx);
        } else if item.kind == WK_MI32_IDX {
            process_wk_mi32_idx(&mut ws, item.obj_off, item.idx);
        }
    }

    seen_free(&mut ws.seen);
    free(ws.stack as *mut u8);
}
