//
// Hermes read/write trait split + non-owning view types.
//
//   HermesRead  — RO API; primitive: base(), size()
//   HermesWrite — RW API; supertrait of HermesRead; primitive: zone_mut()
//   HermesCtrView<'a> — non-owning fat view (base + size), impl HermesRead
//   HermesStatic      — 'static rodata view; size stored at ptr-8, impl HermesRead
//
// HermesCtr impl is in ctr.logos.

package hermes.view;

use hermes.zone;
use hermes.mem_holder;
use hermes.document;
use hermes.stringify;
use hermes.anyval;
use hermes.scalar;
use hermes.objectmap;
use hermes.containers;
use hermes.relptr;
use hermes.decimal;
use hermes.string;
use hermes.datatag;
use hermes.typetag;
use std.string;

pub unsafe fn view_cstr_len(s: *const u8) -> i64 {
    let mut n: i64 = 0;
    while *((s as i64 + n) as *const u8) != 0 { n = n + 1; }
    return n;
}

// ── HermesRead trait ─────────────────────────────────────────────────────────
//
// Read-only view over any Hermes zone.
// Implementations provide base() and size(); everything else is a default impl.

pub trait HermesRead {
    // Pointer to the first byte of the DocumentHeader in zone memory.
    fn base(self: &Self) -> *const u8;

    // Byte size of the zone content (used bytes, not capacity).
    fn size(self: &Self) -> u64;

    // Root AnyVal of the document.
    fn root(self: &Self) -> AnyVal {
        unsafe {
            let doc: *const DocumentHeader = self.base() as *const DocumentHeader;
            return document_get_root(doc);
        }
    }

    // Stringify into `buf` with compact formatting (clears buf first).
    fn stringify(self: &Self, buf: &mut String) {
        unsafe {
            buf.clear();
            stringify_document(self.base(), buf, StringifyOpts::compact());
        }
    }

    // Stringify with explicit options.
    fn stringify_opts(self: &Self, buf: &mut String, opts: StringifyOpts) {
        unsafe {
            buf.clear();
            stringify_document(self.base(), buf, opts);
        }
    }

    // Allocate and return a stringified String (compact).
    fn to_string(self: &Self) -> String {
        let mut buf: String = String::with_capacity(256);
        self.stringify(&mut buf);
        return buf;
    }

    // Allocate and return a stringified String with options.
    fn to_string_opts(self: &Self, opts: StringifyOpts) -> String {
        let mut buf: String = String::with_capacity(256);
        self.stringify_opts(&mut buf, opts);
        return buf;
    }

    // Integer payload (inline i24, cast to i64). Returns 0 if val is not int.
    fn get_int(self: &Self, val: AnyVal) -> i64 {
        unsafe { return val.as_i64(); }
    }

    // Boolean payload. Returns false if val is not bool.
    fn get_bool(self: &Self, val: AnyVal) -> bool {
        unsafe {
            if !val.is_bool() { return false; }
            return val.as_bool();
        }
    }

    // StringView over a zone HermesString. Returns {null,0} if not a string.
    fn get_str_view(self: &Self, val: AnyVal) -> StringView {
        unsafe {
            let base: *const u8 = self.base();
            if !val.is_string(base) {
                return StringView { ptr: 0 as *const u8, len: 0 };
            }
            let hs: *const HermesString =
                (base as i64 + val.as_offset() as i64) as *const HermesString;
            return StringView { ptr: hs.bytes(), len: hs.len() };
        }
    }

    // Extract i64 from inline Integer (i24) or zone I64 (type_code=26).
    fn get_i64(self: &Self, val: AnyVal) -> i64 {
        unsafe {
            if !val.is_ptr() {
                if val.is_int() { return val.as_i24() as i64; }
                return 0;
            }
            if val.is_null() { return 0; }
            let base: *const u8 = self.base();
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag: u64 = read_type_code(obj);
            if tag != 26 { return 0; }
            let p: *const I64 = obj as *const I64;
            return p.value();
        }
    }

    // Extract u64 from inline UInteger (u24) or zone U64 (type_code=27).
    fn get_u64(self: &Self, val: AnyVal) -> u64 {
        unsafe {
            if !val.is_ptr() {
                if val.is_uint() { return val.as_u24() as u64; }
                return 0;
            }
            if val.is_null() { return 0; }
            let base: *const u8 = self.base();
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag: u64 = read_type_code(obj);
            if tag != 27 { return 0; }
            let p: *const U64 = obj as *const U64;
            return p.value();
        }
    }

    // Number of elements in an ObjectArray. Returns 0 if not an array.
    fn array_len(self: &Self, val: AnyVal) -> u64 {
        unsafe {
            let base: *const u8 = self.base();
            if !val.is_array(base) { return 0; }
            let arr: *const ObjectArray =
                (base as i64 + val.as_offset() as i64) as *const ObjectArray;
            return arr.len();
        }
    }

    // Get element at idx from an ObjectArray. Returns null_ptr if out of bounds.
    fn array_get(self: &Self, val: AnyVal, idx: u64) -> AnyVal {
        unsafe {
            let base: *const u8 = self.base();
            if !val.is_array(base) { return AnyVal::null_ptr(); }
            let arr: *const ObjectArray =
                (base as i64 + val.as_offset() as i64) as *const ObjectArray;
            return arr.get(base, idx);
        }
    }

    // Look up a key (C-string) in an ObjectMap. Returns null_ptr if not found.
    fn map_get_cstr(self: &Self, val: AnyVal, key: *const u8) -> AnyVal {
        if key == 0 as *const u8 { return AnyVal::null_ptr(); }
        unsafe {
            let base: *const u8 = self.base();
            if !val.is_map(base) { return AnyVal::null_ptr(); }
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag_hash: u64 = read_type_code(obj);
            if tag_hash == hermes_tag_tiny_map() as u64 { return AnyVal::null_ptr(); }
            let omap: *const ObjectMap = obj as *const ObjectMap;
            let klen: i64 = view_cstr_len(key);
            return omap.get(base, key, klen as u64);
        }
    }

    fn map_get(self: &Self, val: AnyVal, key: *const u8) -> AnyVal {
        if key == 0 as *const u8 { return AnyVal::null_ptr(); }
        unsafe {
            let base: *const u8 = self.base();
            if !val.is_map(base) { return AnyVal::null_ptr(); }
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag_hash: u64 = read_type_code(obj);
            if tag_hash == hermes_tag_tiny_map() as u64 { return AnyVal::null_ptr(); }
            let omap: *const ObjectMap = obj as *const ObjectMap;
            let klen: i64 = view_cstr_len(key);
            return omap.get(base, key, klen as u64);
        }
    }

    fn map_get(self: &Self, val: AnyVal, key: str) -> AnyVal {
        unsafe {
            let base: *const u8 = self.base();
            if !val.is_map(base) { return AnyVal::null_ptr(); }
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag_hash: u64 = read_type_code(obj);
            if tag_hash == hermes_tag_tiny_map() as u64 { return AnyVal::null_ptr(); }
            let omap: *const ObjectMap = obj as *const ObjectMap;
            return omap.get(base, key.as_ptr(), key.len() as u64);
        }
    }

    // DecimalView for a zone Decimal AnyVal.
    fn decimal_view(self: &Self, val: AnyVal) -> DecimalView {
        unsafe { return DecimalView::from_anyval(self.base(), val); }
    }

    fn decimal_to_string(self: &Self, val: AnyVal) -> String {
        unsafe { return self.decimal_view(val).to_string_value(); }
    }

    fn decimal_to_f64(self: &Self, val: AnyVal) -> f64 {
        unsafe { return self.decimal_view(val).to_f64(); }
    }

    fn decimal_precision(self: &Self, val: AnyVal) -> u32 {
        unsafe { return self.decimal_view(val).precision(); }
    }

    fn decimal_scale(self: &Self, val: AnyVal) -> u32 {
        unsafe { return self.decimal_view(val).scale(); }
    }

    fn decimal_len(self: &Self, val: AnyVal) -> u32 {
        unsafe { return self.decimal_view(val).len(); }
    }

    fn decimal_is_negative(self: &Self, val: AnyVal) -> bool {
        unsafe { return self.decimal_view(val).is_negative(); }
    }

    fn decimal_limb(self: &Self, val: AnyVal, idx: u32) -> u32 {
        unsafe { return self.decimal_view(val).limb_at(idx); }
    }
}

// ── HermesWrite trait ─────────────────────────────────────────────────────────
//
// Read-write access to a mutable Hermes zone.
// Supertrait HermesRead gives all getters for free.
// Single primitive: zone_mut().

pub trait HermesWrite: HermesRead {
    fn zone_mut(self: &mut Self) -> *mut Zone<Mutable>;

    fn build_i64(self: &mut Self, v: i64) -> AnyVal {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let sz: i64 = sizeof::<I64>() as i64;
            let raw: *mut u8 = zone_m_alloc_tagged(zone, sz, hermes_tag_i64() as u64);
            if raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            I64::init(raw, v);
            let base: *mut u8 = zone.holder.base;
            let off: u32 = (raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    fn build_u64(self: &mut Self, v: u64) -> AnyVal {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let sz: i64 = sizeof::<U64>() as i64;
            let raw: *mut u8 = zone_m_alloc_tagged(zone, sz, hermes_tag_u64() as u64);
            if raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            U64::init(raw, v);
            let base: *mut u8 = zone.holder.base;
            let off: u32 = (raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    fn build_str(self: &mut Self, s: *const u8, slen: i64) -> AnyVal {
        if slen < 0 { return AnyVal::null_ptr(); }
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let lu: u64 = slen as u64;
            let prefix_sz: i64 = vlen_encode_size(lu) as i64;
            let total: i64 = prefix_sz + slen;
            let raw: *mut u8 = zone_m_alloc_tagged(zone, total, hermes_tag_string() as u64);
            if raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            HermesString::init(raw, s, lu);
            let base: *mut u8 = zone.holder.base;
            let off: u32 = (raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    fn build_str(self: &mut Self, sv: StringView) -> AnyVal {
        return self.build_str(sv.ptr, sv.len as i64);
    }

    fn build_str(self: &mut Self, sv: str) -> AnyVal {
        return self.build_str(sv.as_ptr(), sv.len());
    }

    fn build_str(self: &mut Self, s: *const u8) -> AnyVal {
        if s == 0 as *const u8 { return AnyVal::null_ptr(); }
        unsafe {
            let slen: i64 = view_cstr_len(s);
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let lu: u64 = slen as u64;
            let prefix_sz: i64 = vlen_encode_size(lu) as i64;
            let total: i64 = prefix_sz + slen;
            let raw: *mut u8 = zone_m_alloc_tagged(zone, total, hermes_tag_string() as u64);
            if raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            HermesString::init(raw, s, lu);
            let base: *mut u8 = zone.holder.base;
            let off: u32 = (raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    fn build_map(self: &mut Self, cap_slots: u32) -> AnyVal {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let map_sz: i64 = 16;
            let map_raw: *mut u8 = zone_m_alloc_tagged(zone, map_sz, hermes_tag_map() as u64);
            if map_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let entries_raw: *mut u8 = zone_m_alloc_raw(zone, cap_slots as i64 * 8);
            if entries_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let base: *mut u8 = zone.holder.base;
            ObjectMap::init(map_raw, base, entries_raw, cap_slots);
            let off: u32 = (map_raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    fn build_array(self: &mut Self, cap: u64) -> AnyVal {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let oa_sz: i64 = 24;
            let oa_raw: *mut u8 = zone_m_alloc_tagged(zone, oa_sz, hermes_tag_array() as u64);
            if oa_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let buf_raw: *mut u8 = zone_m_alloc_raw(zone, cap as i64 * 4);
            if buf_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let base: *mut u8 = zone.holder.base;
            ObjectArray::init(oa_raw, buf_raw, base, cap);
            let off: u32 = (oa_raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    fn map_set_str(self: &mut Self, map: AnyVal, key: *const u8, klen: i64, val: AnyVal) {
        if klen < 0 { return; }
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let base: *mut u8 = zone.holder.base;
            if !map.is_map(base as *const u8) { return; }
            let omap: *mut ObjectMap =
                (base as i64 + map.as_offset() as i64) as *mut ObjectMap;
            let mut key_off: u32 = 1;
            if !omap.contains(base as *const u8, key, klen as u64) {
                // inline build_str to avoid cross-overload call
                let lu: u64 = klen as u64;
                let prefix_sz: i64 = vlen_encode_size(lu) as i64;
                let total: i64 = prefix_sz + klen;
                let zone2: *mut Zone<Mutable> = self.zone_mut();
                let raw: *mut u8 = zone_m_alloc_tagged(zone2, total, hermes_tag_string() as u64);
                if raw == 0 as *mut u8 { return; }
                HermesString::init(raw, key, lu);
                let base2: *mut u8 = zone2.holder.base;
                key_off = (raw as i64 - base2 as i64) as u32;
            }
            // Bug fix: zone_m_alloc_tagged above may have reallocated the zone,
            // making the earlier `omap` pointer stale. Recompute from current base.
            let zone3: *mut Zone<Mutable> = self.zone_mut();
            let base3: *mut u8 = zone3.holder.base;
            let omap3: *mut ObjectMap = (base3 as i64 + map.as_offset() as i64) as *mut ObjectMap;
            omap3.set(base3, key_off, key, klen as u64, val);
        }
    }

    fn map_set(self: &mut Self, map: AnyVal, key: StringView, val: AnyVal) {
        return self.map_set_str(map, key.ptr, key.len as i64, val);
    }

    fn map_set(self: &mut Self, map: AnyVal, key: str, val: AnyVal) {
        return self.map_set_str(map, key.as_ptr(), key.len(), val);
    }

    fn map_set(self: &mut Self, map: AnyVal, key: *const u8, val: AnyVal) {
        if key == 0 as *const u8 { return; }
        unsafe {
            let klen: i64 = view_cstr_len(key);
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let base: *mut u8 = zone.holder.base;
            if !map.is_map(base as *const u8) { return; }
            let omap: *mut ObjectMap =
                (base as i64 + map.as_offset() as i64) as *mut ObjectMap;
            let mut key_off: u32 = 1;
            if !omap.contains(base as *const u8, key, klen as u64) {
                let lu: u64 = klen as u64;
                let prefix_sz: i64 = vlen_encode_size(lu) as i64;
                let total: i64 = prefix_sz + klen;
                let zone2: *mut Zone<Mutable> = self.zone_mut();
                let raw: *mut u8 = zone_m_alloc_tagged(zone2, total, hermes_tag_string() as u64);
                if raw == 0 as *mut u8 { return; }
                HermesString::init(raw, key, lu);
                let base2: *mut u8 = zone2.holder.base;
                key_off = (raw as i64 - base2 as i64) as u32;
            }
            // Bug fix: zone may have grown during key string alloc; recompute omap.
            let zone3: *mut Zone<Mutable> = self.zone_mut();
            let base3: *mut u8 = zone3.holder.base;
            let omap3: *mut ObjectMap = (base3 as i64 + map.as_offset() as i64) as *mut ObjectMap;
            omap3.set(base3, key_off, key, klen as u64, val);
        }
    }

    fn array_push(self: &mut Self, arr: AnyVal, val: AnyVal) {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let base: *mut u8 = zone.holder.base;
            if !arr.is_array(base as *const u8) { return; }
            let oa: *mut ObjectArray =
                (base as i64 + arr.as_offset() as i64) as *mut ObjectArray;
            oa.push(zone.holder, val);
        }
    }

    // ── Typed array builders (Array<i32> / Array<u64>) ───────────────────────────
    //
    // Two-step construction: reserve capacity, then push elements one at a time.
    // Push grows the buffer 2× on demand (see Array<T>::push).

    fn build_array_i32(self: &mut Self, cap: u64) -> AnyVal {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let hdr_sz: i64 = sizeof::<Array<i32>>() as i64;
            let buf_bytes: i64 = (cap as i64) * 4;
            // Alloc buf first, then CAPTURE its zone offset immediately — a
            // subsequent alloc may realloc the zone, stranding buf_raw.
            let mut buf_off: u32 = 0;
            if buf_bytes > 0 {
                let buf_raw: *mut u8 = zone_m_alloc_raw(zone, buf_bytes);
                if buf_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
                buf_off = (buf_raw as i64 - zone.holder.base as i64) as u32;
            }
            let hdr_raw: *mut u8 = zone_m_alloc_tagged(zone, hdr_sz,
                                       hermes_tag_array_i32() as u64);
            if hdr_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let base: *mut u8 = zone.holder.base;
            let arr: *mut Array<i32> = hdr_raw as *mut Array<i32>;
            arr.size     = 0;
            arr.capacity = cap;
            arr.data.offset     = buf_off;
            let off: u32 = (hdr_raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    fn array_i32_push(self: &mut Self, arr: AnyVal, val: i32) {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let base: *mut u8 = zone.holder.base;
            if !arr.is_ptr() { return; }
            if arr.is_null() { return; }
            let obj: *const u8 = (base as i64 + arr.as_offset() as i64) as *const u8;
            if read_type_code(obj) != hermes_tag_array_i32() as u64 { return; }
            let ai: *mut Array<i32> =
                (base as i64 + arr.as_offset() as i64) as *mut Array<i32>;
            ai.push(zone.holder, val);
        }
    }

    fn build_array_u64(self: &mut Self, cap: u64) -> AnyVal {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let hdr_sz: i64 = sizeof::<Array<u64>>() as i64;
            let buf_bytes: i64 = (cap as i64) * 8;
            let mut buf_off: u32 = 0;
            if buf_bytes > 0 {
                let buf_raw: *mut u8 = zone_m_alloc_raw(zone, buf_bytes);
                if buf_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
                buf_off = (buf_raw as i64 - zone.holder.base as i64) as u32;
            }
            let hdr_raw: *mut u8 = zone_m_alloc_tagged(zone, hdr_sz,
                                       hermes_tag_array_u64() as u64);
            if hdr_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let base: *mut u8 = zone.holder.base;
            let arr: *mut Array<u64> = hdr_raw as *mut Array<u64>;
            arr.size     = 0;
            arr.capacity = cap;
            arr.data.offset     = buf_off;
            let off: u32 = (hdr_raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    fn array_u64_push(self: &mut Self, arr: AnyVal, val: u64) {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let base: *mut u8 = zone.holder.base;
            if !arr.is_ptr() { return; }
            if arr.is_null() { return; }
            let obj: *const u8 = (base as i64 + arr.as_offset() as i64) as *const u8;
            if read_type_code(obj) != hermes_tag_array_u64() as u64 { return; }
            let au: *mut Array<u64> =
                (base as i64 + arr.as_offset() as i64) as *mut Array<u64>;
            au.push(zone.holder, val);
        }
    }

    // ── Typed map builder (Map<i32, AnyVal>) ─────────────────────────────────────

    fn build_map_i32_anyval(self: &mut Self, cap: u32) -> AnyVal {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let hdr_sz: i64 = sizeof::<Map<i32, AnyVal>>() as i64;
            let key_bytes: i64 = (cap as i64) * 4;
            let val_bytes: i64 = (cap as i64) * 4;
            // Each alloc may realloc the zone; stash offsets immediately.
            let mut keys_off: u32 = 0;
            if key_bytes > 0 {
                let keys_raw: *mut u8 = zone_m_alloc_raw(zone, key_bytes);
                if keys_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
                keys_off = (keys_raw as i64 - zone.holder.base as i64) as u32;
            }
            let mut vals_off: u32 = 0;
            if val_bytes > 0 {
                let vals_raw: *mut u8 = zone_m_alloc_raw(zone, val_bytes);
                if vals_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
                vals_off = (vals_raw as i64 - zone.holder.base as i64) as u32;
            }
            let hdr_raw: *mut u8 = zone_m_alloc_tagged(zone, hdr_sz,
                                       hermes_tag_map_i32_anyval() as u64);
            if hdr_raw == 0 as *mut u8 { return AnyVal::null_ptr(); }
            let base: *mut u8 = zone.holder.base;
            let m: *mut Map<i32, AnyVal> = hdr_raw as *mut Map<i32, AnyVal>;
            m.size     = 0;
            m.capacity = cap;
            m.keys.offset = keys_off;
            m.vals.offset = vals_off;
            let off: u32 = (hdr_raw as i64 - base as i64) as u32;
            return AnyVal::from_offset(off);
        }
    }

    fn map_i32_anyval_set(self: &mut Self, map: AnyVal, key: i32, val: AnyVal) {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let base: *mut u8 = zone.holder.base;
            if !map.is_ptr() { return; }
            if map.is_null() { return; }
            let obj: *const u8 = (base as i64 + map.as_offset() as i64) as *const u8;
            if read_type_code(obj) != hermes_tag_map_i32_anyval() as u64 { return; }
            let m: *mut Map<i32, AnyVal> =
                (base as i64 + map.as_offset() as i64) as *mut Map<i32, AnyVal>;
            m.set(base, key, val);
        }
    }

    fn set_root(self: &mut Self, val: AnyVal) {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            let base: *mut u8 = zone.holder.base;
            let doc: *mut DocumentHeader = base as *mut DocumentHeader;
            document_set_root(doc, val);
        }
    }

    fn decimal_from(self: &mut Self, p: i32, s: i32, val: f64) -> AnyVal {
        unsafe {
            let zone: *mut Zone<Mutable> = self.zone_mut();
            return decimal_from_f64_in_zone(zone, p, s, val);
        }
    }

    fn decimal_from(self: &mut Self, p: i32, s: i32, sv: StringView) -> AnyVal {
        unsafe { return decimal_from_string_in_zone(self.zone_mut(), p, s, sv.ptr, sv.len as i64); }
    }

    fn decimal_from(self: &mut Self, p: i32, s: i32, sv: str) -> AnyVal {
        unsafe { return decimal_from_string_in_zone(self.zone_mut(), p, s, sv.as_ptr(), sv.len()); }
    }

    fn decimal_from(self: &mut Self, p: i32, s: i32, txt: *const u8, len: i64) -> AnyVal {
        unsafe { return decimal_from_string_in_zone(self.zone_mut(), p, s, txt, len); }
    }

    fn decimal_from(self: &mut Self, p: i32, s: i32, txt: *const u8) -> AnyVal {
        if txt == 0 as *const u8 { return AnyVal::null_ptr(); }
        unsafe {
            let len: i64 = view_cstr_len(txt);
            return decimal_from_string_in_zone(self.zone_mut(), p, s, txt, len);
        }
    }

    fn decimal_add(self: &mut Self, a: AnyVal, b: AnyVal) -> AnyVal {
        unsafe { return decimal_add_in_zone(self.zone_mut(), a, b); }
    }

    fn decimal_sub(self: &mut Self, a: AnyVal, b: AnyVal) -> AnyVal {
        unsafe { return decimal_sub_in_zone(self.zone_mut(), a, b); }
    }
}

// ── HermesCtrView<'a> ────────────────────────────────────────────────────────
//
// Non-owning fat view: pointer to zone data + byte size.
// Borrows from any HermesCtr, HermesStatic, or raw zone for lifetime 'a.

pub struct HermesCtrView<'a> {
    pub base: *const u8,
    pub size: u64,
}

impl<'a> HermesRead for HermesCtrView<'a> {
    fn base(self: &HermesCtrView<'a>) -> *const u8 { return self.base; }
    fn size(self: &HermesCtrView<'a>) -> u64 { return self.size; }
}

// ── HermesStatic ─────────────────────────────────────────────────────────────
//
// Non-owning 'static view of a rodata blob created by @-literal codegen.
// Layout in rodata: [u64 size][blob bytes...].
// The ptr field points to the first blob byte (after the u64 prefix).
// Use hermes_static_size(ptr) to read the size without owning a HermesStatic.

pub struct HermesStatic {
    pub ptr: *const u8,
}

// Read the blob size stored 8 bytes before the blob pointer.
pub unsafe fn hermes_static_size(ptr: *const u8) -> u64 {
    return *((ptr as i64 - 8) as *const u64);
}

impl HermesRead for HermesStatic {
    fn base(self: &HermesStatic) -> *const u8 { return self.ptr; }
    fn size(self: &HermesStatic) -> u64 {
        unsafe { return hermes_static_size(self.ptr); }
    }
}

impl HermesStatic {
    pub fn as_view<'a>(self: &'a HermesStatic) -> HermesCtrView<'a> {
        unsafe {
            return HermesCtrView {
                base: self.ptr,
                size: hermes_static_size(self.ptr),
            };
        }
    }
}
