// Logos Hermes stdlib — hermes.own
//
// DataOwn<T>: reference-counted owning handle for a Hermes Datatype T.
//
// Holds (base, offset) like DataRef<T> plus a heap-allocated reference count.
// Unlike DataRef, DataOwn tracks object lifetime via RC.
//
// Lifecycle:
//   dataown_create<T>(base, offset) → DataOwn<T> with RC=1
//   own.clone_ref()                 → new DataOwn<T> with RC incremented
//   own.release()                   → RC decremented; if 0, RC storage freed
//   own.ref_count()                 → current RC value (for testing/debugging)
//
// Note: releasing a DataOwn does NOT free the zone or the T object itself —
// zone memory is arena-allocated and freed via HermesZone::destroy().
// DataOwn only tracks references to prevent use-after-release in user code.
//
// Phase 7 will introduce MemHolder for proper zone lifetime tracking.

package hermes.own;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

// Owning handle for a Datatype T in a Hermes zone.
// Fields mirror DataRef<T> so conversions are cheap (no extra indirection).
pub struct DataOwn<T> {
    pub base:   *mut u8,   // zone base pointer (same as DataRef)
    pub offset: u32,       // byte offset to T within zone (same as DataRef)
    rc:         *mut i32,  // heap-allocated reference count
}

// Create a new DataOwn<T> with RC=1.
// base/offset identify the T within a HermesZone (e.g. from DataRef fields).
pub unsafe fn dataown_create<T>(base: *mut u8, offset: u32) -> DataOwn<T> {
    let rc_raw: *mut u8 = malloc(4);
    let rc: *mut i32 = rc_raw as *mut i32;
    *rc = 1;
    return DataOwn { base: base, offset: offset, rc: rc };
}

impl<T> DataOwn<T> {
    // Increment RC and return a second handle to the same object.
    pub unsafe fn clone_ref(self: *const DataOwn<T>) -> DataOwn<T> {
        let rc: *mut i32 = self.rc;
        *rc = *rc + 1;
        return DataOwn { base: self.base, offset: self.offset, rc: self.rc };
    }

    // Decrement RC. If RC reaches 0, the RC allocation is freed.
    // After release(), do not use this DataOwn again.
    pub unsafe fn release(self: *mut DataOwn<T>) {
        let rc: *mut i32 = self.rc;
        *rc = *rc - 1;
        if *rc == 0 {
            free(self.rc as *mut u8);
        }
    }

    // Current reference count — for debugging and assertion.
    pub unsafe fn ref_count(self: *const DataOwn<T>) -> i32 {
        let rc: *const i32 = self.rc as *const i32;
        return *rc;
    }

    // Resolve to a const raw pointer to T (same arithmetic as DataRef::ptr).
    pub unsafe fn ptr(self: *const DataOwn<T>) -> *const T {
        let base_int: i64 = self.base as i64;
        let off: i64 = self.offset as i64;
        return (base_int + off) as *const T;
    }

    // Resolve to a mutable raw pointer to T.
    pub unsafe fn mut_ptr(self: *const DataOwn<T>) -> *mut T {
        let base_int: i64 = self.base as i64;
        let off: i64 = self.offset as i64;
        return (base_int + off) as *mut T;
    }
}
