// Logos Hermes stdlib — hermes.containers
//
// Phase 8: Hermes container datatypes — TinyObjectMap and ObjectArray.
//
// Both types are Hermes datatypes (POD, zone-allocated). Their variable-length
// data arrays live at zone-relative offsets stored in a u32 field. The caller
// allocates memory from a HermesZone and passes the raw pointers to the init
// functions below; the init functions compute zone-relative offsets and fill
// the header fields.
//
// TinyObjectMap  (16 bytes): bitmap-indexed map, u8 key → AnyVal, max 52 entries.
// ObjectArray    (24 bytes): dynamic array of AnyVal, up to 2^64-1 entries.
//
// References: openspec/specs/hermes.md §3, hermes-wire-format.md §3.

package hermes.containers;

use hermes.anyval;
use hermes.mem_holder;
use hermes.relptr;
use hermes.string;

// ---------------------------------------------------------------------------
// popcount_u64 and friends are compiler intrinsics; see sema_expr.cpp /
// mlir_gen_expr.cpp. No declaration needed — recognised by callee name.
// Available: popcount_u64, leading_zeros_u64, trailing_zeros_u64,
//            bswap_u64, bitreverse_u64.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// TinyObjectMap
//
// Layout (16 bytes, 8-byte aligned):
//   header: u64 — bits[0:51] = key presence bitmap (keys 0..51)
//                 bits[52:57] = capacity (max 52, 6 bits)
//                 bits[58:63] = current size (6 bits)
//   data:   u32 — zone-relative offset to the AnyVal[] value array
//   (4 bytes implicit trailing padding for C POD 8-byte alignment)
//
// Lookup: position of key in value array = popcount(bitmap & mask_below_key).
// This is O(1) (popcount loop is bounded by key ≤ 52).
// Insertion: shift elements right by 1 to maintain sorted key order. O(n).
// ---------------------------------------------------------------------------

// Canonical operation on any Map eidos: the current entry count.
// Template genos; no type_code (that lives on concrete specializations —
// see `Map<Bitmap, AnyVal>` below and `Map<Varchar, AnyVal>` in
// `hermes.objectmap`).
pub genos Map<K, V> {
    unsafe fn size(self: *const Self) -> u32;
}

// Abstract Map<K, V> base — never instantiated directly; exists only so
// partial specializations (e.g. `Map<Bitmap, V>`) can attach fields/impls.
pub eidos Map<K, V> { }

// Key marker for the compact bitmap-indexed map (max 52 u8 keys, 16 B header).
pub eidos Bitmap { }

// Concrete genos specialization carrying the Hermes wire-format type_code
// for the small bitmap-indexed map (was `TinyObjectMap`, type_code=98).
#[type_code=98]
pub genos Map<Bitmap, AnyVal>;

// Partial spec: Bitmap-keyed map, any V.  Layout matches the previous
// TinyObjectMap exactly (16 B header + zone-relative V[]).
pub eidos Map<Bitmap, V> {
    pub header: u64,
    pub data:   RelPtr<V>,
}

// Back-compat alias.
pub type TinyObjectMap = Map<Bitmap, AnyVal>;

impl<V> Map<Bitmap, V> for Map<Bitmap, V> {
    unsafe fn size(self: *const Map<Bitmap, V>) -> u32 {
        return ((self.header >> 58) & 0x3F as u64) as u32;
    }
}

impl Map<Bitmap, AnyVal> {
    // Initialize a Map<Bitmap, AnyVal> at pre-allocated memory.
    //   map_raw  — pointer to ≥sizeof(Map<Bitmap, AnyVal>) bytes
    //   arr_raw  — pointer to ≥ capacity*4 bytes for the AnyVal array
    //   base     — zone base pointer
    //   capacity — max number of entries (≤ 52)
    pub unsafe fn init(map_raw: *mut u8, arr_raw: *mut u8,
                       base: *mut u8, capacity: u32) -> *mut Map<Bitmap, AnyVal> {
        let base_int: i64 = base as i64;
        let arr_off: u32  = (arr_raw as i64 - base_int) as u32;
        let cap_bits: u64 = (capacity as u64) << 52;
        let map_ptr: *mut Map<Bitmap, AnyVal> = map_raw as *mut Map<Bitmap, AnyVal>;
        map_ptr.header = cap_bits;
        map_ptr.data.offset   = arr_off;
        let elem_sz: i64 = sizeof::<AnyVal>() as i64;
        let mut i: u32 = 0;
        while i < capacity {
            let ep: *mut AnyVal = (arr_raw as i64 + (i as i64) * elem_sz) as *mut AnyVal;
            ep.raw = 0 as u32;
            i = i + 1;
        }
        return map_ptr;
    }

    // True if key is present in the map.
    pub unsafe fn contains(self: *const Map<Bitmap, AnyVal>, key: u8) -> bool {
        let bitmap: u64  = self.header & 0x000FFFFFFFFFFFFF as u64;
        let key_bit: u64 = 1 as u64 << (key as u64);
        return (bitmap & key_bit) != 0 as u64;
    }

    // Get value by key. Returns AnyVal::null_ptr() if key not present.
    pub unsafe fn get(self: *const Map<Bitmap, AnyVal>, base: *const u8, key: u8) -> AnyVal {
        let bitmap: u64  = self.header & 0x000FFFFFFFFFFFFF as u64;
        let key_bit: u64 = 1 as u64 << (key as u64);
        if (bitmap & key_bit) == 0 as u64 {
            return AnyVal::null_ptr();
        }
        let mask: u64 = key_bit - 1 as u64;
        let pos: u32  = popcount_u64(bitmap & mask);
        let elem_sz: i64 = sizeof::<AnyVal>() as i64;
        let elem: *const AnyVal = (base as i64 + self.data.offset as i64 + (pos as i64) * elem_sz) as *const AnyVal;
        return AnyVal { raw: elem.raw };
    }

    // Set or update value by key.  key >= 52 is a safe no-op.
    pub unsafe fn set(self: *mut Map<Bitmap, AnyVal>, base: *mut u8, key: u8, val: AnyVal) {
        if key >= 52 as u8 { return; }
        let bitmap: u64  = self.header & 0x000FFFFFFFFFFFFF as u64;
        let key_bit: u64 = 1 as u64 << (key as u64);
        let mask: u64    = key_bit - 1 as u64;
        let pos: u32     = popcount_u64(bitmap & mask);
        let size: u32    = ((self.header >> 58) & 0x3F as u64) as u32;
        let cap: u32     = ((self.header >> 52) & 0x3F as u64) as u32;
        let elem_sz: i64 = sizeof::<AnyVal>() as i64;
        let arr_base: i64 = base as i64 + self.data.offset as i64;

        if (bitmap & key_bit) == 0 as u64 {
            if size >= cap { return; }
            let mut i: u32 = size;
            while i > pos {
                let src: *const AnyVal = (arr_base + ((i - 1) as i64) * elem_sz) as *const AnyVal;
                let dst: *mut AnyVal   = (arr_base + (i as i64) * elem_sz) as *mut AnyVal;
                dst.raw = src.raw;
                i = i - 1;
            }
            let new_bitmap: u64  = bitmap | key_bit;
            let new_size: u64    = (size + 1) as u64;
            let cap_bits: u64    = (cap as u64) << 52;
            let size_bits: u64   = new_size << 58;
            self.header = new_bitmap | cap_bits | size_bits;
        }
        let dst: *mut AnyVal = (arr_base + (pos as i64) * elem_sz) as *mut AnyVal;
        dst.raw = val.raw;
    }
}

// ---------------------------------------------------------------------------
// ObjectArray
//
// Layout (24 bytes, 8-byte aligned):
//   size:     u64 — number of elements currently in the array
//   capacity: u64 — allocated capacity (in elements)
//   data:     u32 — zone-relative offset to the AnyVal[] element buffer
//   (4 bytes implicit trailing padding)
// ---------------------------------------------------------------------------

// Canonical operation on any Array eidos: the current element count.
#[type_code=100]
pub genos Array {
    unsafe fn len(self: *const Self) -> u64;
}

// Generic array eidos: header + zone-relative offset to a T[] buffer.
pub eidos Array<T> {
    pub size:     u64,
    pub capacity: u64,
    pub data:     RelPtr<T>,
}

// Back-compat alias — keeps existing callers working after templatization.
pub type ObjectArray = Array<AnyVal>;

// Generic inherent API for Array<T>.  Concrete `impl Array<AnyVal>` below
// overrides these via the inherent-spec rule.
impl<T> Array<T> {
    // Initialize Array<T> header at pre-allocated memory.  Buffer is left
    // uninitialized; `push` is the only way to add valid elements.
    pub unsafe fn init(arr_raw: *mut u8, buf_raw: *mut u8,
                       base: *mut u8, capacity: u64) -> *mut Array<T> {
        let base_int: i64 = base as i64;
        let buf_off: u32  = (buf_raw as i64 - base_int) as u32;
        let arr: *mut Array<T> = arr_raw as *mut Array<T>;
        arr.size     = 0 as u64;
        arr.capacity = capacity;
        arr.data.offset     = buf_off;
        return arr;
    }

    // Append a T via a value pointer.  Caller must ensure self.size < self.capacity.
    pub unsafe fn push_ptr(self: *mut Array<T>, base: *mut u8, val_ptr: *const T) {
        let elem_sz: i64 = sizeof::<T>() as i64;
        let ep: *mut T = (base as i64 + self.data.offset as i64
                          + (self.size as i64) * elem_sz) as *mut T;
        *ep = *val_ptr;
        self.size = self.size + 1 as u64;
    }

    // Dynamic push with 2× growth via MemHolder.  On grow, `self` may be
    // invalidated by the realloc — callers must re-resolve through the
    // zone base afterwards if they kept a pointer.
    pub unsafe fn push(self: *mut Array<T>, holder: *mut MemHolder, val_ptr: *const T) {
        let elem_sz: i64 = sizeof::<T>() as i64;
        let arr_off: u32 = (self as i64 - holder.base as i64) as u32;
        if self.size >= self.capacity {
            let old_cap: u64 = self.capacity;
            let new_cap: u64 = if old_cap == 0 as u64 { 8 as u64 }
                               else { old_cap * 2 as u64 };
            let new_bytes: i64 = (new_cap as i64) * elem_sz;
            let new_buf: *mut u8 = memholder_alloc(holder, new_bytes);
            if new_buf == 0 as *mut u8 { return; }
            let base2: *mut u8 = holder.base;
            let arr2: *mut Array<T> = (base2 as i64 + arr_off as i64) as *mut Array<T>;
            let old_size: u64 = arr2.size;
            let old_data_off: u32 = arr2.data.offset;
            let old_bytes: i64 = (old_size as i64) * elem_sz;
            let mut i: i64 = 0 as i64;
            while i < old_bytes {
                *((new_buf as i64 + i) as *mut u8) =
                    *((base2 as i64 + old_data_off as i64 + i) as *const u8);
                i = i + 1 as i64;
            }
            arr2.data.offset     = (new_buf as i64 - base2 as i64) as u32;
            arr2.capacity = new_cap;
            let ep2: *mut T = (base2 as i64 + arr2.data.offset as i64
                               + (arr2.size as i64) * elem_sz) as *mut T;
            *ep2 = *val_ptr;
            arr2.size = arr2.size + 1 as u64;
            return;
        }
        let base: *mut u8 = holder.base;
        let ep: *mut T = (base as i64 + self.data.offset as i64
                          + (self.size as i64) * elem_sz) as *mut T;
        *ep = *val_ptr;
        self.size = self.size + 1 as u64;
    }

    // Returns a pointer to the element at idx, or null on OOB.
    pub unsafe fn get_ptr(self: *const Array<T>, base: *const u8, idx: u64) -> *const T {
        if idx >= self.size { return 0 as *const T; }
        let elem_sz: i64 = sizeof::<T>() as i64;
        return (base as i64 + self.data.offset as i64
                + (idx as i64) * elem_sz) as *const T;
    }
}

impl Array for Array<AnyVal> {
    unsafe fn len(self: *const Array<AnyVal>) -> u64 { return self.size; }
}

impl Array<AnyVal> {
    // Initialize an Array<AnyVal> at pre-allocated memory.
    //   arr_raw  — pointer to ≥sizeof(Array<AnyVal>) bytes
    //   buf_raw  — pointer to ≥ capacity*4 bytes for the element buffer
    //   base     — zone base pointer
    //   capacity — initial allocated capacity
    pub unsafe fn init(arr_raw: *mut u8, buf_raw: *mut u8,
                       base: *mut u8, capacity: u64) -> *mut Array<AnyVal> {
        let base_int: i64  = base as i64;
        let buf_off: u32   = (buf_raw as i64 - base_int) as u32;
        let arr_ptr: *mut Array<AnyVal> = arr_raw as *mut Array<AnyVal>;
        arr_ptr.size     = 0 as u64;
        arr_ptr.capacity = capacity;
        arr_ptr.data.offset     = buf_off;
        let elem_sz: i64 = sizeof::<AnyVal>() as i64;
        let mut i: u64 = 0 as u64;
        while i < capacity {
            let ep: *mut AnyVal = (buf_raw as i64 + (i as i64) * elem_sz) as *mut AnyVal;
            ep.raw = 0 as u32;
            i = i + 1 as u64;
        }
        return arr_ptr;
    }

    // Append a value.  Grows the element buffer 2× when full, allocating into
    // the zone backed by `holder`.  On OOM the push is a silent no-op.
    //
    // WARNING: after this call the caller's `self` pointer may be stale —
    // `memholder_alloc` can realloc the zone, moving `holder.base`.  Re-resolve
    // via `holder.base + arr_off` if the caller retains a handle.
    pub unsafe fn push(self: *mut Array<AnyVal>, holder: *mut MemHolder, val: AnyVal) {
        let elem_sz: i64 = sizeof::<AnyVal>() as i64;
        let arr_off: u32 = (self as i64 - holder.base as i64) as u32;
        if self.size >= self.capacity {
            let old_cap: u64 = self.capacity;
            let new_cap: u64 = if old_cap == 0 as u64 { 8 as u64 }
                               else { old_cap * 2 as u64 };
            let new_bytes: i64 = (new_cap as i64) * elem_sz;
            let new_buf: *mut u8 = memholder_alloc(holder, new_bytes);
            if new_buf == 0 as *mut u8 { return; }
            // Re-resolve self: holder.base may have moved during alloc.
            let base2: *mut u8 = holder.base;
            let arr2: *mut Array<AnyVal> =
                (base2 as i64 + arr_off as i64) as *mut Array<AnyVal>;
            let old_size: u64   = arr2.size;
            let old_data_off: u32 = arr2.data.offset;
            let old_bytes: i64  = (old_size as i64) * elem_sz;
            let mut i: i64 = 0 as i64;
            while i < old_bytes {
                *((new_buf as i64 + i) as *mut u8) =
                    *((base2 as i64 + old_data_off as i64 + i) as *const u8);
                i = i + 1 as i64;
            }
            arr2.data.offset     = (new_buf as i64 - base2 as i64) as u32;
            arr2.capacity = new_cap;
            let ep2: *mut AnyVal = (base2 as i64 + arr2.data.offset as i64
                                    + (arr2.size as i64) * elem_sz) as *mut AnyVal;
            ep2.raw = val.raw;
            arr2.size = arr2.size + 1 as u64;
            return;
        }
        let base: *mut u8 = holder.base;
        let ep: *mut AnyVal = (base as i64 + self.data.offset as i64
                               + (self.size as i64) * elem_sz) as *mut AnyVal;
        ep.raw = val.raw;
        self.size = self.size + 1 as u64;
    }

    // Get element by index. Returns AnyVal::null_ptr() if out of bounds.
    pub unsafe fn get(self: *const Array<AnyVal>, base: *const u8, idx: u64) -> AnyVal {
        if idx >= self.size { return AnyVal::null_ptr(); }
        let elem_sz: i64 = sizeof::<AnyVal>() as i64;
        let ep: *const AnyVal = (base as i64 + self.data.offset as i64 + (idx as i64) * elem_sz) as *const AnyVal;
        return AnyVal { raw: ep.raw };
    }
}

// ---------------------------------------------------------------------------
// Pre-materialized typed primitive array: <I32>[...]
//
// Dense contiguous i32 storage, tagged with a dedicated type_code so
// stringify/equal/hash/clone/release can dispatch through type handlers.
// ---------------------------------------------------------------------------

#[type_code=104]
pub eidos Array<i32>;

pub type ArrayI32 = Array<i32>;

// ---------------------------------------------------------------------------
// Pre-materialized typed primitive array: <U64>[...]
//
// Dense contiguous u64 storage, tagged with type_code=108.
// ---------------------------------------------------------------------------

#[type_code=108]
pub eidos Array<u64>;

pub type ArrayU64 = Array<u64>;

// ---------------------------------------------------------------------------
// Pre-materialized typed map: <I32,AnyVal>{...}
//
// Dense key/value arrays with linear lookup/update.
// Keys are i32, values are AnyVal.
// ---------------------------------------------------------------------------

#[type_code=105]
pub genos MapI32AnyValTag {
    unsafe fn len(self: *const Self) -> u64;
}

pub eidos MapI32AnyVal {
    pub size:     u32,
    pub capacity: u32,
    pub keys:     RelPtr<i32>,     // zone-relative offset to i32[]
    pub vals:     RelPtr<AnyVal>,  // zone-relative offset to AnyVal[]
}

impl MapI32AnyValTag for MapI32AnyVal {
    unsafe fn len(self: *const MapI32AnyVal) -> u64 { return self.size as u64; }
}

impl MapI32AnyVal {
    pub unsafe fn init(map_raw: *mut u8, keys_raw: *mut u8, vals_raw: *mut u8,
                       base: *mut u8, capacity: u32) -> *mut MapI32AnyVal {
        let base_i: i64 = base as i64;
        let m: *mut MapI32AnyVal = map_raw as *mut MapI32AnyVal;
        m.size     = 0 as u32;
        m.capacity = capacity;
        m.keys.offset = (keys_raw as i64 - base_i) as u32;
        m.vals.offset = (vals_raw as i64 - base_i) as u32;
        return m;
    }

    // Insert or update.
    pub unsafe fn set(self: *mut MapI32AnyVal, base: *mut u8, key: i32, val: AnyVal) {
        let mut i: u32 = 0 as u32;
        while i < self.size {
            let kp: *const i32 = (base as i64 + self.keys.offset as i64 + (i as i64) * 4 as i64) as *const i32;
            if *kp == key {
                let vp: *mut AnyVal = (base as i64 + self.vals.offset as i64 + (i as i64) * 4 as i64) as *mut AnyVal;
                vp.raw = val.raw;
                return;
            }
            i = i + 1 as u32;
        }
        if self.size >= self.capacity { return; }
        let n: u32 = self.size;
        let kdst: *mut i32 = (base as i64 + self.keys.offset as i64 + (n as i64) * 4 as i64) as *mut i32;
        let vdst: *mut AnyVal = (base as i64 + self.vals.offset as i64 + (n as i64) * 4 as i64) as *mut AnyVal;
        *kdst = key;
        vdst.raw = val.raw;
        self.size = self.size + 1 as u32;
    }
}

// ---------------------------------------------------------------------------
// Typed value wrapper for Hermes SDN datatype instantiation.
//
// Canonical textual form:
//   @Type(params?) = <initializer>
//
// `init_raw` and `params_raw` store AnyVal raw bits (inline or pointer).
// `params_raw` is null_ptr (raw=0) when no params are specified.
// ---------------------------------------------------------------------------

#[type_code=106]
pub genos TypedValueTag {
    unsafe fn type_name_off(self: *const Self) -> u32;
}

pub eidos TypedValue {
    pub type_off:   RelPtr<HermesString>,  // type expression string
    pub params_raw: u32,                   // AnyVal raw for params (usually Array<AnyVal> or null_ptr)
    pub init_raw:   u32,                   // AnyVal raw for initializer
}

impl TypedValueTag for TypedValue {
    unsafe fn type_name_off(self: *const TypedValue) -> u32 {
        return self.type_off.offset;
    }
}

impl TypedValue {
    pub unsafe fn init(raw: *mut u8, type_off: u32, params: AnyVal, initv: AnyVal) -> *mut TypedValue {
        let tv: *mut TypedValue = raw as *mut TypedValue;
        tv.type_off.offset = type_off;
        tv.params_raw = params.raw;
        tv.init_raw = initv.raw;
        return tv;
    }
}
