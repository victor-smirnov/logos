// Logos Hermes stdlib — hermes.map
//
// Map<K, V> — generic zone-allocated map, with the following concrete
// partial specialisations living here:
//
//   Map<Bitmap, AnyVal>   — TinyObjectMap, bitmap-indexed, max 52 u8 keys
//                           (type_code=98, 16 B header)
//   Map<i32, AnyVal>      — dense i32→AnyVal map, linear lookup
//                           (type_code=105, 16 B header + keys/vals RelPtrs)
//
// Additional string-keyed maps live in hermes.objectmap.
//
// References: openspec/specs/hermes.md §3, hermes-wire-format.md §3.

package hermes.map;

use hermes.anyval;
use hermes.tags;
use hermes.relptr;

// popcount_u64 etc. are compiler intrinsics (see sema_expr.cpp).

// ---------------------------------------------------------------------------
// Map<K, V> — generic base
// ---------------------------------------------------------------------------

// Canonical operation on any Map eidos: the current entry count.
// Template genos; no type_code (that lives on concrete specialisations).
pub genos Map<K, V> {
    unsafe fn size(self: *const Self) -> u32;
}

// Abstract Map<K, V> base — never instantiated directly; exists only so
// partial specialisations can attach fields/impls.
pub eidos Map<K, V> { }

// ---------------------------------------------------------------------------
// Map<Bitmap, V> — bitmap-indexed, max 52 u8 keys (was TinyObjectMap)
//
// Layout (16 bytes, 8-byte aligned):
//   header: u64 — bits[0:51] = key presence bitmap (keys 0..51)
//                 bits[52:57] = capacity (max 52, 6 bits)
//                 bits[58:63] = current size (6 bits)
//   data:   u32 — zone-relative offset to the V[] value array
//   (4 bytes implicit trailing padding for C POD 8-byte alignment)
//
// Lookup: position of key in value array = popcount(bitmap & mask_below_key).
// This is O(1) (popcount loop is bounded by key ≤ 52).
// Insertion: shift elements right by 1 to maintain sorted key order. O(n).
// ---------------------------------------------------------------------------

// Key marker for the compact bitmap-indexed map (max 52 u8 keys, 16 B header).
pub eidos Bitmap { }

// Concrete genos specialisation carrying the Hermes wire-format type_code
// for the small bitmap-indexed map.
#[type_code = HermesTag::TinyObjectMap]
pub genos Map<Bitmap, AnyVal>;

// Partial spec: Bitmap-keyed map, any V.
pub eidos Map<Bitmap, V> {
    pub header: u64,
    pub data:   RelPtr<V>,
}

// Back-compat alias.
pub type TinyObjectMap = Map<Bitmap, AnyVal>;

impl<V> Map<Bitmap, V> for Map<Bitmap, V> {
    unsafe fn size(self: *const Map<Bitmap, V>) -> u32 {
        return ((self.header >> 58) & 0x3F) as u32;
    }
}

impl Map<Bitmap, AnyVal> {
    // Initialize a Map<Bitmap, AnyVal> at pre-allocated memory.
    //   map_raw  — pointer to ≥sizeof(Map<Bitmap, AnyVal>) bytes
    //   arr_raw  — pointer to ≥ capacity*4 bytes for the AnyVal array
    //   base     — zone base pointer
    //   capacity — max number of entries (≤ 52)
    pub unsafe fn init(map_raw: *mut u8, arr_raw: *mut u8,
                       base: *mut u8, capacity: u32) -> *mut Map<Bitmap, AnyVal> {
        let arr_off: u32  = (arr_raw as *const u8).byte_offset_from(base as *const u8) as u32;
        let cap_bits: u64 = (capacity as u64) << 52;
        let map_ptr: *mut Map<Bitmap, AnyVal> = map_raw as *mut Map<Bitmap, AnyVal>;
        map_ptr.header = cap_bits;
        map_ptr.data.offset   = arr_off;
        let arr: *mut AnyVal = arr_raw as *mut AnyVal;
        let mut i: u32 = 0;
        while i < capacity {
            let ep: *mut AnyVal = arr.add(i as i64);
            ep.raw = 0;
            i = i + 1;
        }
        return map_ptr;
    }

    // True if key is present in the map.
    pub unsafe fn contains(self: *const Map<Bitmap, AnyVal>, key: u8) -> bool {
        let bitmap: u64  = self.header & 0x000FFFFFFFFFFFFF;
        let key_bit: u64 = 1 << (key as u64);
        return (bitmap & key_bit) != 0;
    }

    // Get value by key. Returns AnyVal::null_ptr() if key not present.
    pub unsafe fn get(self: *const Map<Bitmap, AnyVal>, base: *const u8, key: u8) -> AnyVal {
        let bitmap: u64  = self.header & 0x000FFFFFFFFFFFFF;
        let key_bit: u64 = 1 << (key as u64);
        if (bitmap & key_bit) == 0 {
            return AnyVal::null_ptr();
        }
        let mask: u64 = key_bit - 1;
        let pos: u32  = popcount_u64(bitmap & mask);
        let arr_base: *const AnyVal = base.byte_add(self.data.offset) as *const AnyVal;
        let elem: *const AnyVal = arr_base.add(pos as i64);
        return AnyVal { raw: elem.raw };
    }

    // Set or update value by key.  key >= 52 is a safe no-op.
    pub unsafe fn set(self: *mut Map<Bitmap, AnyVal>, base: *mut u8, key: u8, val: AnyVal) {
        if key >= 52 { return; }
        let bitmap: u64  = self.header & 0x000FFFFFFFFFFFFF;
        let key_bit: u64 = 1 << (key as u64);
        let mask: u64    = key_bit - 1;
        let pos: u32     = popcount_u64(bitmap & mask);
        let size: u32    = ((self.header >> 58) & 0x3F) as u32;
        let cap: u32     = ((self.header >> 52) & 0x3F) as u32;
        let arr_base: *mut AnyVal = base.byte_add(self.data.offset) as *mut AnyVal;

        if (bitmap & key_bit) == 0 {
            if size >= cap { return; }
            let mut i: u32 = size;
            while i > pos {
                let src: *mut AnyVal = arr_base.add((i - 1) as i64);
                let dst: *mut AnyVal = arr_base.add(i as i64);
                dst.raw = src.raw;
                i = i - 1;
            }
            let new_bitmap: u64  = bitmap | key_bit;
            let new_size: u64    = (size + 1) as u64;
            let cap_bits: u64    = (cap as u64) << 52;
            let size_bits: u64   = new_size << 58;
            self.header = new_bitmap | cap_bits | size_bits;
        }
        let dst: *mut AnyVal = arr_base.add(pos as i64);
        dst.raw = val.raw;
    }
}

// ---------------------------------------------------------------------------
// Map<i32, AnyVal> — dense key/value arrays with linear lookup/update.
// Partial specialisation of Map<K, V> for i32 keys and AnyVal values.
// ---------------------------------------------------------------------------

#[type_code = HermesTag::MapI32AnyVal]
pub eidos Map<i32, AnyVal> {
    pub size:     u32,
    pub capacity: u32,
    pub keys:     RelPtr<i32>,     // zone-relative offset to i32[]
    pub vals:     RelPtr<AnyVal>,  // zone-relative offset to AnyVal[]
}

impl Map<i32, AnyVal> for Map<i32, AnyVal> {
    unsafe fn size(self: *const Map<i32, AnyVal>) -> u32 { return self.size; }
}

impl Map<i32, AnyVal> {
    pub unsafe fn init(map_raw: *mut u8, keys_raw: *mut u8, vals_raw: *mut u8,
                       base: *mut u8, capacity: u32) -> *mut Map<i32, AnyVal> {
        let m: *mut Map<i32, AnyVal> = map_raw as *mut Map<i32, AnyVal>;
        m.size     = 0;
        m.capacity = capacity;
        m.keys.offset = (keys_raw as *const u8).byte_offset_from(base) as u32;
        m.vals.offset = (vals_raw as *const u8).byte_offset_from(base) as u32;
        return m;
    }

    // Insert or update.
    pub unsafe fn set(self: *mut Map<i32, AnyVal>, base: *mut u8, key: i32, val: AnyVal) {
        let keys: *mut i32    = base.byte_add(self.keys.offset) as *mut i32;
        let vals: *mut AnyVal = base.byte_add(self.vals.offset) as *mut AnyVal;
        let mut i: u32 = 0;
        while i < self.size {
            let kp: *mut i32 = keys.add(i as i64);
            if *kp == key {
                let vp: *mut AnyVal = vals.add(i as i64);
                vp.raw = val.raw;
                return;
            }
            i = i + 1;
        }
        if self.size >= self.capacity { return; }
        let n: u32 = self.size;
        let kdst: *mut i32 = keys.add(n as i64);
        let vdst: *mut AnyVal = vals.add(n as i64);
        *kdst = key;
        vdst.raw = val.raw;
        self.size = self.size + 1;
    }
}
