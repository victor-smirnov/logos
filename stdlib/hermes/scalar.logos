// Logos Hermes stdlib — hermes.scalar
//
// Zone-allocated numeric Hermes datatypes that don't fit inline in AnyVal's
// 24-bit payload. Each is a plain 8-byte POD with a 2-byte TypeTag prefix.
//
// Types defined here:
//   I64  (type_code=26, 8 bytes)  — signed 64-bit integer
//   U64  (type_code=27, 8 bytes)  — unsigned 64-bit integer
//
// The inline-capable relatives (Integer=23, UInteger=25, etc.) live as
// embedded AnyVal values; these zone types are the fallback when the value
// doesn't fit in the inline payload, or when the caller wants a stable
// pointer identity.

package hermes.scalar;

use logos.lang.datatypes;

// ---------------------------------------------------------------------------
// Int64 — logical genos (signed 64-bit integer), with I64 as its zone eidos.
// The type_code is carried by the genos; propagates to eide via impl.
// ---------------------------------------------------------------------------

// Canonical operation on any Int64 eidos: read the signed 64-bit value.
// Generic code can do `fn sum<V: Int64>(vs: &[*const V]) { vs[i].value() }`.
#[type_code=26]
pub genos Int64 {
    unsafe fn value(self: *const Self) -> i64;
}

pub eidos I64 {
    pub v: i64,
}

impl Int64 for I64 {
    unsafe fn value(self: *const I64) -> i64 { return self.v; }
}

impl I64 {
    pub unsafe fn init(raw: *mut u8, value: i64) -> *mut I64 {
        let p: *mut I64 = raw as *mut I64;
        p.v = value;
        return p;
    }
}

// ---------------------------------------------------------------------------
// UInt64 — logical genos (unsigned 64-bit integer), with U64 as its zone eidos.
// ---------------------------------------------------------------------------

#[type_code=27]
pub genos UInt64 {
    unsafe fn value(self: *const Self) -> u64;
}

pub eidos U64 {
    pub v: u64,
}

impl UInt64 for U64 {
    unsafe fn value(self: *const U64) -> u64 { return self.v; }
}

impl U64 {
    pub unsafe fn init(raw: *mut u8, value: u64) -> *mut U64 {
        let p: *mut U64 = raw as *mut U64;
        p.v = value;
        return p;
    }
}

// ---------------------------------------------------------------------------
// Canonical type-hash constants for the tag-writing helpers.
// ---------------------------------------------------------------------------

pub unsafe fn hermes_tag_i64() -> u8 { return 26 as u8; }
pub unsafe fn hermes_tag_u64() -> u8 { return 27 as u8; }

// ---------------------------------------------------------------------------
// Datatype-ification via the Primitive blanket impl in logos.lang.datatypes.
// View = inline primitive; Storage = PrimVec<Prim>; all Datatype methods
// provided generically — no per-type boilerplate.
// ---------------------------------------------------------------------------

impl Primitive for I64 { type Prim = i64; }
impl Primitive for U64 { type Prim = u64; }
