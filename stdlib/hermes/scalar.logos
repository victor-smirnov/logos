// ── Canonical type-hash constants for the tag-writing helpers ───────────

pub fn hermes_tag_i8()   -> u8 { return 20 as u8; }
pub fn hermes_tag_u8()   -> u8 { return 21 as u8; }
pub fn hermes_tag_i16()  -> u8 { return 22 as u8; }
pub fn hermes_tag_i24()  -> u8 { return 23 as u8; }
pub fn hermes_tag_u16()  -> u8 { return 24 as u8; }
pub fn hermes_tag_u24()  -> u8 { return 25 as u8; }
pub fn hermes_tag_i64()  -> u8 { return 26 as u8; }
pub fn hermes_tag_u64()  -> u8 { return 27 as u8; }
pub fn hermes_tag_f32()  -> u8 { return 30 as u8; }
pub fn hermes_tag_f64()  -> u8 { return 31 as u8; }
pub fn hermes_tag_bool() -> u8 { return 37 as u8; }

// ── Datatype-ification via the Primitive blanket ────────────────────────
// All eide above are byte-level POD wrappers around a single scalar field,
// so they plug straight into the Primitive blanket: View = the inner
// primitive, Storage = PrimVec<prim>, Buffer<T> works for free.

impl Primitive for I8   { type Prim = i8;   }
impl Primitive for U8   { type Prim = u8;   }
impl Primitive for I16  { type Prim = i16;  }
impl Primitive for I24  { type Prim = i24;  }
impl Primitive for U16  { type Prim = u16;  }
impl Primitive for U24  { type Prim = u24;  }
impl Primitive for I64  { type Prim = i64;  }
impl Primitive for U64  { type Prim = u64;  }
impl Primitive for F32  { type Prim = f32;  }
impl Primitive for F64  { type Prim = f64;  }
impl Primitive for Bool { type Prim = bool; }
