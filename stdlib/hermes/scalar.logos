// Logos Hermes stdlib — hermes.scalar
//
// Zone-allocated numeric Hermes datatypes that don't fit inline in AnyVal's
// 24-bit payload. Each is a plain 8-byte POD with a 2-byte TypeTag prefix.
//
// Types defined here:
//   I64  (type_code=26, 8 bytes)  — signed 64-bit integer
//   U64  (type_code=27, 8 bytes)  — unsigned 64-bit integer
//
// The inline-capable relatives (Integer=23, UInteger=25, etc.) live as
// embedded AnyVal values; these zone types are the fallback when the value
// doesn't fit in the inline payload, or when the caller wants a stable
// pointer identity.

package hermes.scalar;

use logos.datatypes;
use std.mem;

// ---------------------------------------------------------------------------
// I64 — zone-allocated signed 64-bit integer.
// ---------------------------------------------------------------------------

#[type_code=26]
pub datatype I64 {
    pub v: i64,
}

impl I64 {
    // Initialize an I64 at pre-allocated, 8-byte-aligned memory.
    pub unsafe fn init(raw: *mut u8, value: i64) -> *mut I64 {
        let p: *mut I64 = raw as *mut I64;
        p.v = value;
        return p;
    }

    pub unsafe fn value(self: *const I64) -> i64 {
        return self.v;
    }
}

// ---------------------------------------------------------------------------
// U64 — zone-allocated unsigned 64-bit integer.
// ---------------------------------------------------------------------------

#[type_code=27]
pub datatype U64 {
    pub v: u64,
}

impl U64 {
    pub unsafe fn init(raw: *mut u8, value: u64) -> *mut U64 {
        let p: *mut U64 = raw as *mut U64;
        p.v = value;
        return p;
    }

    pub unsafe fn value(self: *const U64) -> u64 {
        return self.v;
    }
}

// ---------------------------------------------------------------------------
// Canonical type-hash constants for the tag-writing helpers.
// ---------------------------------------------------------------------------

pub unsafe fn hermes_tag_i64() -> u8 { return 26 as u8; }
pub unsafe fn hermes_tag_u64() -> u8 { return 27 as u8; }

// ---------------------------------------------------------------------------
// View / Storage bridge — HermesDatatype impl for I64.
// ---------------------------------------------------------------------------

// Processing format: callers of `Buffer<I64>` receive and push `I64View`
// values.  Kept as a named struct (not a bare i64) so metaprogramming passes
// can refer to the processing type uniformly across datatypes.
pub struct I64View {
    pub v: i64,
}

// Fixed-size storage: trivial Vec-style (data, len, cap) of inline i64.
pub struct I64Storage {
    pub data: *mut i64,
    pub len:  u64,
    pub cap:  u64,
}

impl HermesDatatype for I64 {
    type View    = I64View;
    type Storage = I64Storage;

    fn storage_new() -> I64Storage {
        return I64Storage { data: 0 as *mut i64, len: 0 as u64, cap: 0 as u64 };
    }

    fn storage_drop(s: *mut I64Storage) {
        unsafe {
            if s.data != 0 as *mut i64 {
                dealloc(s.data as *mut u8);
                s.data = 0 as *mut i64;
                s.len  = 0 as u64;
                s.cap  = 0 as u64;
            }
        }
    }

    fn storage_len(s: *const I64Storage) -> u64 {
        unsafe { return s.len; }
    }

    fn storage_push(s: *mut I64Storage, v: I64View) {
        unsafe {
            if s.len == s.cap {
                let new_cap: u64 = if s.cap == 0 as u64 { 4 as u64 } else { s.cap * 2 as u64 };
                let bytes: i64 = (new_cap * 8 as u64) as i64;
                let new_buf: *mut u8 = if s.data == 0 as *mut i64 {
                    alloc(bytes)
                } else {
                    realloc_buf(s.data as *mut u8, bytes)
                };
                if new_buf == 0 as *mut u8 { return; }
                s.data = new_buf as *mut i64;
                s.cap  = new_cap;
            }
            let slot: *mut i64 = (s.data as i64 + (s.len as i64) * 8 as i64) as *mut i64;
            *slot = v.v;
            s.len = s.len + 1 as u64;
        }
    }

    fn storage_get(s: *const I64Storage, idx: u64) -> I64View {
        unsafe {
            let slot: *const i64 = (s.data as i64 + (idx as i64) * 8 as i64) as *const i64;
            return I64View { v: *slot };
        }
    }
}
