// Logos Hermes stdlib — hermes.typetag
//
// Phase 11: TypeTag helpers — canonical type-hash constants, TagDescriptor
// constants, and the 2-byte tag read/write helpers.
//
// TypeTag wire format (2 bytes immediately before every tagged object):
//   byte[obj-1] = code_len (bits 0-2) | descriptor (bits 3-7)
//                 code_len = 1 for all Hermes core types (2-byte tag total)
//   byte[obj-2] = type_hash low byte
//
// This is the little-endian serialisation of the C++ TypeTag uint64:
//   raw_ = (type_hash << 8) | (descriptor << 3) | code_len
// Since all core type hashes fit in 8 bits and use code_len=1, only 2 bytes
// are written.  Compatible with C++ TypeTag::read_before / write_before.
//
// Canonical type-hash values (from hermes-abi.json / type_registry.hpp):
//   28  = Varchar    (HermesString / ArenaString)
//   98  = Hermes     (TinyObjectMap)
//   100 = ObjectArray
//   101 = ObjectMap  (Logos open-addressing version)
//   3   = Document   (Logos extension — DocumentHeader at zone offset 0)
//
// TagDescriptor values (C++ TagDescriptor enum):
//   0 = Data   (plain data types: strings, integers, …)
//   1 = Array  (ObjectArray)
//   2 = Map    (TinyObjectMap or ObjectMap)

package hermes.typetag;

// ---------------------------------------------------------------------------
// Canonical type-hash constants
// ---------------------------------------------------------------------------

pub unsafe fn hermes_tag_string() -> u8 {
    return 28 as u8;    // Varchar / HermesString (ArenaString in C++)
}

pub unsafe fn hermes_tag_tiny_map() -> u8 {
    return 98 as u8;    // TinyObjectMap (type_hash::Hermes in C++)
}

pub unsafe fn hermes_tag_array() -> u8 {
    return 100 as u8;   // ObjectArray
}

pub unsafe fn hermes_tag_map() -> u8 {
    return 101 as u8;   // ObjectMap (Logos open-addressing version)
}

pub unsafe fn hermes_tag_document() -> u8 {
    return 3 as u8;     // DocumentHeader (Logos extension, no C++ counterpart)
}

// ---------------------------------------------------------------------------
// TagDescriptor constants
// ---------------------------------------------------------------------------

pub unsafe fn hermes_desc_data() -> u8 {
    return 0 as u8;   // TagDescriptor::Data
}

pub unsafe fn hermes_desc_array() -> u8 {
    return 1 as u8;   // TagDescriptor::Array
}

pub unsafe fn hermes_desc_map() -> u8 {
    return 2 as u8;   // TagDescriptor::Map
}

// ---------------------------------------------------------------------------
// Tag read helpers
// (Valid for all tags written by HermesZone::alloc_tagged with code_len=1.)
// ---------------------------------------------------------------------------

// Read the type_hash byte from the 2-byte tag preceding the object at `ptr`.
pub unsafe fn tag_read_hash(ptr: *const u8) -> u8 {
    let p: *const u8 = (ptr as i64 - 2) as *const u8;
    return *p;
}

// Read the TagDescriptor from the 2-byte tag preceding `ptr`.
// Returns the upper 5 bits of byte[obj-1]: descriptor in bits [7:3].
pub unsafe fn tag_read_descriptor(ptr: *const u8) -> u8 {
    let p: *const u8 = (ptr as i64 - 1) as *const u8;
    let raw: u8 = *p;
    return (raw as u32 >> 3 as u32) as u8;
}
