// Logos Hermes stdlib — hermes.typetag
//
// TypeTag helpers — canonical type_code constants for Hermes zone objects.
//
// TypeTag wire format (vlen, 1 byte for codes 1-222):
//   obj[-1] = type_code directly for codes 1-222
//   obj[-1] = length header for codes 223+ (multi-byte encoding)
//
// Read/write of the vlen tag is handled by hermes.datatag:
//   write_tag(obj, type_code: u64)
//   read_type_code(obj) -> u64
//   tag_size(type_code) -> i64
//
// Canonical type_code values:
//   28  = Varchar    (HermesString / ArenaString)
//   98  = Hermes     (TinyObjectMap)
//   100 = ObjectArray
//   101 = ObjectMap  (Logos open-addressing version)
//   104 = Array<i32> (<I32>[...], dense primitive array)
//   105 = MapI32AnyVal (<I32>{...} / <I32,AnyVal>{...})
//   106 = TypedValue (@Type(...)=initializer)
//   107 = Decimal (fixed-precision decimal with inline limb tail)
//   3   = Document   (Logos extension — DocumentHeader at zone offset 0)

package hermes.typetag;

// ---------------------------------------------------------------------------
// Canonical type-hash constants
// ---------------------------------------------------------------------------

pub unsafe fn hermes_tag_string() -> u8 {
    return 28;    // Varchar / HermesString (ArenaString in C++)
}

pub unsafe fn hermes_tag_tiny_map() -> u8 {
    return 98;    // TinyObjectMap (type_hash::Hermes in C++)
}

pub unsafe fn hermes_tag_array() -> u8 {
    return 100;   // ObjectArray
}

pub unsafe fn hermes_tag_map() -> u8 {
    return 101;   // ObjectMap (Logos open-addressing version)
}

pub unsafe fn hermes_tag_array_i32() -> u8 {
    return 104;   // dense typed primitive array
}

pub unsafe fn hermes_tag_array_u64() -> u8 {
    return 108;   // dense typed u64 array
}

pub unsafe fn hermes_tag_map_i32_anyval() -> u8 {
    return 105;   // typed map with i32 keys and AnyVal values
}

pub unsafe fn hermes_tag_typed_value() -> u8 {
    return 106;   // typed value wrapper
}

pub unsafe fn hermes_tag_decimal() -> u8 {
    return 107;   // Decimal(P,S) with inline u32 limbs tail
}

pub unsafe fn hermes_tag_document() -> u8 {
    return 3;     // DocumentHeader (Logos extension, no C++ counterpart)
}

