// Logos Hermes stdlib — hermes.anyval
//
// AnyVal: 4-byte polymorphic slot (pointer-or-embedded-value).
//
// Wire format (little-endian uint32):
//   Pointer mode: raw = 32-bit zone offset (low bit 0; aligned objects → low 3 bits are 0)
//                 discriminant = bit 0 of raw = 0
//   Value mode:   raw = (value_24bit << 8) | (type_hash << 1) | 1
//                 bits [7:1]  = type_hash (7 bits, 0–127)
//                 bits [31:8] = 24-bit value
//                 discriminant = bit 0 of raw = 1
//
// Null sentinel: raw == 0 (pointer mode, offset 0; offset 0 is always
// DocumentHeader, never a data object, so this is unambiguous).
//
// Embeddable types (type_hash < 128, value fits in 24 bits):
//   TinyInt   (i8)  hash=20  tag=0x29
//   UTinyInt  (u8)  hash=21  tag=0x2B
//   SmallInt  (i16) hash=22  tag=0x2D
//   Integer   (i24) hash=23  tag=0x2F
//   USmallInt (u16) hash=24  tag=0x31
//   UInteger  (u24) hash=25  tag=0x33
//   Boolean   (u8)  hash=37  tag=0x4B
//
// f32 (Real, hash=30) is NOT embeddable in the 4-byte format.
// Zone-pointer floats may be added in a future revision.
//
// See openspec/specs/hermes-wire-format.md §3 for the authoritative bit encoding.

package hermes.anyval;

use hermes.datatag;
use hermes.typetag;

// AnyVal layout: single 4-byte raw field.
pub eidos AnyVal {
    pub raw: u32,
}

impl AnyVal {
    // True if this slot is in pointer mode (discriminant == 0).
    pub unsafe fn is_ptr(self: *const AnyVal) -> bool {
        return (self.raw & 1 as u32) == 0 as u32;
    }

    // True if this is the null pointer (raw == 0).
    pub unsafe fn is_null(self: *const AnyVal) -> bool {
        return self.raw == 0 as u32;
    }

    // Segment-relative offset (only valid in pointer mode).
    pub unsafe fn as_offset(self: *const AnyVal) -> u32 {
        return self.raw;
    }

    // Resolve pointer-mode AnyVal to a raw const pointer given the segment base.
    pub unsafe fn resolve(self: *const AnyVal, base: *const u8) -> *const u8 {
        let base_int: i64 = base as i64;
        let off: i64 = self.raw as i64;
        return (base_int + off) as *const u8;
    }

    // Resolve pointer-mode AnyVal to a mutable pointer given the segment base.
    pub unsafe fn resolve_mut(self: *const AnyVal, base: *mut u8) -> *mut u8 {
        let base_int: i64 = base as i64;
        let off: i64 = self.raw as i64;
        return (base_int + off) as *mut u8;
    }

    // 7-bit type_hash from the tag byte (only valid in value mode).
    pub unsafe fn type_hash(self: *const AnyVal) -> u8 {
        return ((self.raw >> 1 as u32) & 0x7F as u32) as u8;
    }

    // --- Constructors ---

    // Null pointer sentinel (raw=0).
    pub fn null_ptr() -> AnyVal {
        return AnyVal { raw: 0 as u32 };
    }

    // Pointer mode: store a segment-relative offset.
    pub fn from_offset(offset: u32) -> AnyVal {
        return AnyVal { raw: offset };
    }

    // Embed i24 (Integer, hash=23, tag=0x2F).
    pub fn embed_i24(v: i32) -> AnyVal {
        let raw: u32 = (((v as u32) & 0xFFFFFF as u32) << 8 as u32) | 0x2F as u32;
        return AnyVal { raw: raw };
    }

    // Embed u24 (UInteger, hash=25, tag=0x33).
    pub fn embed_u24(v: u32) -> AnyVal {
        let raw: u32 = ((v & 0xFFFFFF as u32) << 8 as u32) | 0x33 as u32;
        return AnyVal { raw: raw };
    }

    // Embed i16 (SmallInt, hash=22, tag=0x2D).
    pub fn embed_i16(v: i16) -> AnyVal {
        let raw: u32 = ((((v as i32) as u32) & 0xFFFFFF as u32) << 8 as u32) | 0x2D as u32;
        return AnyVal { raw: raw };
    }

    // Embed u16 (USmallInt, hash=24, tag=0x31).
    pub fn embed_u16(v: u16) -> AnyVal {
        let raw: u32 = ((v as u32) << 8 as u32) | 0x31 as u32;
        return AnyVal { raw: raw };
    }

    // Embed i8 (TinyInt, hash=20, tag=0x29).
    pub fn embed_i8(v: i8) -> AnyVal {
        let raw: u32 = ((((v as i32) as u32) & 0xFFFFFF as u32) << 8 as u32) | 0x29 as u32;
        return AnyVal { raw: raw };
    }

    // Embed u8 (UTinyInt, hash=21, tag=0x2B).
    pub fn embed_u8(v: u8) -> AnyVal {
        let raw: u32 = ((v as u32) << 8 as u32) | 0x2B as u32;
        return AnyVal { raw: raw };
    }

    // Embed bool (Boolean, hash=37, tag=0x4B).
    pub fn embed_bool(v: bool) -> AnyVal {
        let raw: u32 = ((v as u32) << 8 as u32) | 0x4B as u32;
        return AnyVal { raw: raw };
    }

    // --- Value extraction (only valid when !is_ptr()) ---

    pub unsafe fn as_i24(self: *const AnyVal) -> i32 {
        return (self.raw as i32) >> 8;
    }

    pub unsafe fn as_u24(self: *const AnyVal) -> u32 {
        return (self.raw >> 8) as u32;
    }

    pub unsafe fn as_i16(self: *const AnyVal) -> i16 {
        return ((self.raw >> 8) as u32) as i16;
    }

    pub unsafe fn as_u16(self: *const AnyVal) -> u16 {
        return ((self.raw >> 8) as u32) as u16;
    }

    pub unsafe fn as_i8(self: *const AnyVal) -> i8 {
        return ((self.raw >> 8) as u32) as i8;
    }

    pub unsafe fn as_u8(self: *const AnyVal) -> u8 {
        return ((self.raw >> 8) as u32) as u8;
    }

    pub unsafe fn as_bool(self: *const AnyVal) -> bool {
        return (((self.raw >> 8) as u32) & 1 as u32) != 0 as u32;
    }

    // --- Safe type-check accessors (value mode) ---

    // True if this AnyVal holds an embedded integer (i24, hash=23).
    pub unsafe fn is_int(self: *const AnyVal) -> bool {
        if self.is_ptr() { return false; }
        return self.type_hash() == 23 as u8;
    }

    // True if this AnyVal holds an embedded unsigned integer (u24, hash=25).
    pub unsafe fn is_uint(self: *const AnyVal) -> bool {
        if self.is_ptr() { return false; }
        return self.type_hash() == 25 as u8;
    }

    // True if this AnyVal holds an embedded bool (Boolean, hash=37).
    pub unsafe fn is_bool(self: *const AnyVal) -> bool {
        if self.is_ptr() { return false; }
        return self.type_hash() == 37 as u8;
    }

    // --- Safe type-check accessors (pointer mode, need zone base) ---
    //
    // TypeTag layout: 2 bytes immediately before the object.
    //   byte[obj-2] = type_hash
    //   byte[obj-1] = (descriptor << 3) | code_len
    // Descriptor 0 = Data (strings), 1 = Array, 2 = Map.

    // True if this AnyVal points to a Varchar/HermesString (type_code=28).
    pub unsafe fn is_string(self: *const AnyVal, base: *const u8) -> bool {
        if !self.is_ptr() { return false; }
        if self.is_null() { return false; }
        let obj: *const u8 = (base as i64 + self.raw as i64) as *const u8;
        return read_type_code(obj) == hermes_tag_string() as u64;
    }

    // True if this AnyVal points to an ObjectArray (type_code=100).
    pub unsafe fn is_array(self: *const AnyVal, base: *const u8) -> bool {
        if !self.is_ptr() { return false; }
        if self.is_null() { return false; }
        let obj: *const u8 = (base as i64 + self.raw as i64) as *const u8;
        return read_type_code(obj) == hermes_tag_array() as u64;
    }

    // True if this AnyVal points to a map object (type_code=101 ObjectMap or 98 TinyObjectMap).
    pub unsafe fn is_map(self: *const AnyVal, base: *const u8) -> bool {
        if !self.is_ptr() { return false; }
        if self.is_null() { return false; }
        let obj: *const u8 = (base as i64 + self.raw as i64) as *const u8;
        let tc: u64 = read_type_code(obj);
        return tc == hermes_tag_map() as u64 || tc == hermes_tag_tiny_map() as u64;
    }

    // --- Safe value extraction ---

    // Return the integer value if is_int(), otherwise 0.
    pub unsafe fn as_i64(self: *const AnyVal) -> i64 {
        if !self.is_int() { return 0 as i64; }
        return self.as_i24() as i64;
    }

    // Return the unsigned integer value if is_uint(), otherwise 0.
    pub unsafe fn as_u64(self: *const AnyVal) -> u64 {
        if !self.is_uint() { return 0 as u64; }
        return self.as_u24() as u64;
    }
}
