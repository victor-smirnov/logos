// Logos Hermes stdlib — hermes.tag_system
//
// TagSystem: abstraction over the mechanism used to read a type tag
// from a memory object.  Different subsystems use different tag formats:
//
//   HermesTypeTagSystem — legacy 2-byte TypeTag: byte[-2]=type_hash (u8),
//                         byte[-1]=code_len|descriptor. Used by HermesString,
//                         ObjectArray, ObjectMap, TinyObjectMap, DocumentHeader.
//                         Codes 1-255 (type_hash is a u8).
//   DataTypeTagSystem   — TypeTag stored variable-length immediately before
//                         the object in a Hermes zone (1-8 bytes).
//                         Codes 128-222: single byte; 223+: multi-byte.
//                         Used by user datatypes with #[type_code=N].
//   TomTagSystem        — type_code stored as little-endian u64 at byte
//                         offset 0 of the object header (TinyObjectMap).
//
// This module defines the trait interface and both implementations.
// The dispatch table infrastructure (one table per TagSystem×Trait pair)
// lives in the compiler and linker layer.
//
// Safety note: all read_tag implementations dereference raw pointers.
// Callers must ensure `obj` points to a valid, live, tagged object.

package hermes.tag_system;

use hermes.datatag;

// ---------------------------------------------------------------------------
// TagSystem trait
// ---------------------------------------------------------------------------

// Encapsulates how a type tag (type_code) is read from a raw memory object.
// Each implementation receives a pointer to the first byte of the object;
// it is responsible for locating the tag according to the format.
pub trait TagSystem {
    // The tag value type.  For all current Hermes tag systems this is u64.
    type Tag;

    // Read the type tag for the object at `obj`.
    // Safety: `obj` must point to a valid, tagged, live object.
    fn read_tag(self: &Self, obj: *const u8) -> Self::Tag;
}

// ---------------------------------------------------------------------------
// HermesTypeTagSystem
// ---------------------------------------------------------------------------

// TagSystem for Hermes core zone datatypes with legacy 2-byte tag format.
// Tag layout (2 bytes immediately before the object):
//   byte[-2] = type_hash (u8)
//   byte[-1] = code_len (bits 0-2) | descriptor (bits 3-7)
// Tag value returned is just the type_hash byte (fits in u64 for uniformity
// with other TagSystems).
pub struct HermesTypeTagSystem {}

impl TagSystem for HermesTypeTagSystem {
    type Tag = u64;

    // Safety: `obj` must point to a validly-tagged Hermes legacy object
    // (allocated via zone_m_alloc_tagged with type_hash and descriptor).
    pub fn read_tag(self: &HermesTypeTagSystem, obj: *const u8) -> u64 {
        return unsafe { *((obj as i64 - 2) as *const u8) } as u64;
    }
}

// ---------------------------------------------------------------------------
// DataTypeTagSystem
// ---------------------------------------------------------------------------

// TagSystem for Hermes zone datatypes.
// Tags are variable-length (1-8 bytes) stored immediately before the object:
//   obj[-1] ∈ [128,222] → single-byte tag; type_code = that byte
//   obj[-1] ∈ [223,255] → multi-byte; length = obj[-1]-223+1; code follows
// Bug fix: codes 0 and 1-127 are reserved (unset and inline AnyVal);
// only codes 128+ appear in zone tags.
pub struct DataTypeTagSystem {}

impl TagSystem for DataTypeTagSystem {
    type Tag = u64;

    // Safety: `obj` must point to a validly-tagged Hermes zone object
    // (one that was previously written with write_tag), with the tag bytes
    // reserved in memory immediately before it.
    pub fn read_tag(self: &DataTypeTagSystem, obj: *const u8) -> u64 {
        return unsafe { read_type_code(obj) };
    }
}

// ---------------------------------------------------------------------------
// TomTagSystem
// ---------------------------------------------------------------------------

// TagSystem for TinyObjectMap (TOM) objects.
// The type_code is the little-endian u64 at byte offset 0 of the object.
// Bug fix: the comment previously said "at a fixed 8-byte offset" but meant
// the field is 8 bytes wide, not offset 8 — the field IS at offset 0.
// Bug fix: TomTagSystem reads raw u64; caller must validate reserved codes
// (0 and 1-127) aren't accepted if semantics require valid codes only.
// TODO: verify against actual TOM C++ layout when sync tool is available.
pub struct TomTagSystem {}

impl TagSystem for TomTagSystem {
    type Tag = u64;

    // Safety: `obj` must point to a valid TOM object with at least 8 bytes
    // of readable header. Pointer must not overflow when added to 7.
    pub fn read_tag(self: &TomTagSystem, obj: *const u8) -> u64 {
        // Read bytes 0..7 as little-endian u64.
        // Individual byte loads avoid alignment requirements on the pointer.
        let mut code: u64 = 0 as u64;
        let mut i: i64 = 0;
        loop {
            if i >= 8 { break; }
            // Bug fix: pointer arithmetic could overflow if obj + 7 > i64::MAX.
            // Caller must ensure obj is in valid range (< i64::MAX - 7).
            let offset_addr: i64 = obj as i64 + i;
            if offset_addr < obj as i64 { return 0 as u64; }  // overflow detected
            let b: u64 = unsafe { *( offset_addr as *const u8) } as u64;
            code = code | (b << (i as u64 * 8 as u64));
            i = i + 1;
        }
        return code;
    }
}
