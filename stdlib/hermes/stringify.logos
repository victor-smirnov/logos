// Logos Hermes stdlib — hermes.stringify
//
// Trait-based text serialisation of Hermes zone documents.
//
// Architecture
// ────────────
// Zone objects (HermesString, ObjectArray, ObjectMap, TinyObjectMap,
// DocumentHeader) implement `HermesStringify` with `#[tag_dispatch(
// HermesTypeTagSystem)]`. Dispatch reads the legacy 2-byte tag before each
// object and selects the right impl from a compiler-generated table indexed
// by type_hash.
//
// Inline AnyVal values (Integer/Boolean/…/TinyInt) are not in the zone and
// have no in-memory tag — they are handled in `stringify_anyval` with an
// explicit switch over `val.type_hash()`.
//
// Entry points:
//   pub unsafe fn stringify_anyval(val, ctx)
//   pub unsafe fn stringify_document(base, out, opts)
//
// For compact output:  StringifyOpts::compact()
// For pretty output:   StringifyOpts::pretty()   (2-space indent)

package hermes.stringify;

use hermes.anyval;
use hermes.string;
use hermes.typetag;
use hermes.datatag;
use hermes.tag_system;
use hermes.array;
use hermes.map;
use hermes.typed_value;
use hermes.objectmap;
use hermes.document;
use hermes.scalar;
use hermes.decimal;
use std.lang.text;

// ---------------------------------------------------------------------------
// StringifyOpts — formatting options passed through the recursive walk.
// ---------------------------------------------------------------------------

#[zoned] pub struct StringifyOpts {
    pub indent: i64,   // spaces per nesting level; 0 = compact
}

impl StringifyOpts {
    pub static fn compact() -> StringifyOpts {
        return StringifyOpts { indent: 0 };
    }

    pub static fn pretty() -> StringifyOpts {
        return StringifyOpts { indent: 2 };
    }

    pub static fn with_indent(n: i64) -> StringifyOpts {
        return StringifyOpts { indent: n };
    }
}

// ---------------------------------------------------------------------------
// StringifyCtx — recursive traversal context.
//
// Passed by mutable pointer through every stringify call so that any impl
// can append to the output buffer, resolve zone offsets via `base`, and
// observe/modify the indentation depth.
// ---------------------------------------------------------------------------

pub struct StringifyCtx {
    pub out:   *mut String,
    pub base:  *const u8,
    pub opts:  StringifyOpts,
    pub depth: i64,
}

// ---------------------------------------------------------------------------
// Indentation helper — writes "\n" + (indent * depth) spaces in pretty mode.
// ---------------------------------------------------------------------------

unsafe fn write_indent(ctx: *mut StringifyCtx) {
    if ctx.opts.indent <= 0 { return; }
    ctx.out.push_u8(10);
    let spaces: i64 = ctx.opts.indent * ctx.depth;
    let mut i: i64 = 0;
    while i < spaces {
        ctx.out.push_u8(32);
        i = i + 1;
    }
}

unsafe fn write_null(out: *mut String) {
    out.push_u8(110);  // 'n'
    out.push_u8(117);  // 'u'
    out.push_u8(108);  // 'l'
    out.push_u8(108);  // 'l'
}

// ---------------------------------------------------------------------------
// Quoted-string helper (shared between HermesString and ObjectMap keys).
// ---------------------------------------------------------------------------

unsafe fn write_quoted_hs(hs: *const HermesString, out: *mut String) {
    out.push_u8(34);   // '"'
    let len: u64   = hs.len();
    let bptr: *const u8 = hs.bytes();
    let mut i: u64 = 0;
    while i < len {
        let c: u8 = *bptr.byte_add(i as i64);
        if c == 34 {
            out.push_u8(92); out.push_u8(34);
        } else if c == 92 {
            out.push_u8(92); out.push_u8(92);
        } else if c == 10 {
            out.push_u8(92); out.push_u8(110);
        } else if c == 13 {
            out.push_u8(92); out.push_u8(114);
        } else if c == 9 {
            out.push_u8(92); out.push_u8(116);
        } else {
            out.push_u8(c);
        }
        i = i + 1;
    }
    out.push_u8(34);
}

// ---------------------------------------------------------------------------
// HermesStringify — polymorphic stringification trait.
//
// Dispatch reads the legacy 2-byte tag immediately before the object.
// `#[tag_dispatch(HermesTypeTagSystem)]` tells the compiler to generate a
// dispatch table keyed by type_hash (byte[obj-2]).
// ---------------------------------------------------------------------------

#[tag_dispatch(HermesTypeTagSystem)]
pub trait HermesStringify {
    fn stringify(&self, ctx: *mut StringifyCtx);
}

// ── HermesString (type_code=28) ────────────────────────────────────────────

impl HermesStringify for HermesString {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let hs: *const HermesString = self;
            write_quoted_hs(hs, ctx.out);
        }
    }
}

// ── AnyVal (static dispatch through inline bits) ───────────────────────────

impl HermesStringify for AnyVal {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe { stringify_anyval(AnyVal { raw: (self).raw }, ctx); }
    }
}


// ── MapKeyStringify — bridge trait for Map<K, AnyVal> stringify ────────────
//
// Each K provides:
//   write_key_name(ctx) — pushes the key-type name bytes, e.g. "<I32,AnyVal> {"
//   write_key_val(kp, ctx) — pushes the decimal representation of *kp
pub trait MapKeyStringify {
    unsafe fn write_key_name(ctx: *mut StringifyCtx);
    unsafe fn write_key_val(kp: *const Self, ctx: *mut StringifyCtx);
}

impl MapKeyStringify for i32 {
    pub unsafe fn write_key_name(ctx: *mut StringifyCtx) {
        ctx.out.push_u8(60);   // '<'
        ctx.out.push_u8(73);   // 'I'
        ctx.out.push_u8(51);   // '3'
        ctx.out.push_u8(50);   // '2'
        ctx.out.push_u8(44);   // ','
        ctx.out.push_u8(65);   // 'A'
        ctx.out.push_u8(110);  // 'n'
        ctx.out.push_u8(121);  // 'y'
        ctx.out.push_u8(86);   // 'V'
        ctx.out.push_u8(97);   // 'a'
        ctx.out.push_u8(108);  // 'l'
        ctx.out.push_u8(62);   // '>'
        ctx.out.push_u8(32);   // ' '
        ctx.out.push_u8(123);  // '{'
    }
    pub unsafe fn write_key_val(kp: *const i32, ctx: *mut StringifyCtx) {
        ctx.out.push_i64(*kp as i64);
    }
}

impl MapKeyStringify for u32 {
    pub unsafe fn write_key_name(ctx: *mut StringifyCtx) {
        ctx.out.push_u8(60);   // '<'
        ctx.out.push_u8(85);   // 'U'
        ctx.out.push_u8(51);   // '3'
        ctx.out.push_u8(50);   // '2'
        ctx.out.push_u8(44);   // ','
        ctx.out.push_u8(65);   // 'A'
        ctx.out.push_u8(110);  // 'n'
        ctx.out.push_u8(121);  // 'y'
        ctx.out.push_u8(86);   // 'V'
        ctx.out.push_u8(97);   // 'a'
        ctx.out.push_u8(108);  // 'l'
        ctx.out.push_u8(62);   // '>'
        ctx.out.push_u8(32);   // ' '
        ctx.out.push_u8(123);  // '{'
    }
    pub unsafe fn write_key_val(kp: *const u32, ctx: *mut StringifyCtx) {
        ctx.out.push_u64(*kp as u64);
    }
}

impl MapKeyStringify for i64 {
    pub unsafe fn write_key_name(ctx: *mut StringifyCtx) {
        ctx.out.push_u8(60);   // '<'
        ctx.out.push_u8(73);   // 'I'
        ctx.out.push_u8(54);   // '6'
        ctx.out.push_u8(52);   // '4'
        ctx.out.push_u8(44);   // ','
        ctx.out.push_u8(65);   // 'A'
        ctx.out.push_u8(110);  // 'n'
        ctx.out.push_u8(121);  // 'y'
        ctx.out.push_u8(86);   // 'V'
        ctx.out.push_u8(97);   // 'a'
        ctx.out.push_u8(108);  // 'l'
        ctx.out.push_u8(62);   // '>'
        ctx.out.push_u8(32);   // ' '
        ctx.out.push_u8(123);  // '{'
    }
    pub unsafe fn write_key_val(kp: *const i64, ctx: *mut StringifyCtx) {
        ctx.out.push_i64(*kp);
    }
}

impl MapKeyStringify for u64 {
    pub unsafe fn write_key_name(ctx: *mut StringifyCtx) {
        ctx.out.push_u8(60);   // '<'
        ctx.out.push_u8(85);   // 'U'
        ctx.out.push_u8(54);   // '6'
        ctx.out.push_u8(52);   // '4'
        ctx.out.push_u8(44);   // ','
        ctx.out.push_u8(65);   // 'A'
        ctx.out.push_u8(110);  // 'n'
        ctx.out.push_u8(121);  // 'y'
        ctx.out.push_u8(86);   // 'V'
        ctx.out.push_u8(97);   // 'a'
        ctx.out.push_u8(108);  // 'l'
        ctx.out.push_u8(62);   // '>'
        ctx.out.push_u8(32);   // ' '
        ctx.out.push_u8(123);  // '{'
    }
    pub unsafe fn write_key_val(kp: *const u64, ctx: *mut StringifyCtx) {
        ctx.out.push_u64(*kp);
    }
}

// ── Map<K, AnyVal>: blanket over any K: MapKeyStringify ────────────────────

impl<K: MapKeyStringify> HermesStringify for Map<K, AnyVal> {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let m: *const Map<K, AnyVal> = self as *const Map<K, AnyVal>;
            K::write_key_name(ctx);
            let mut i: u32 = 0;
            while i < m.size {
                if i > 0 { ctx.out.push_u8(44); }
                let keys: *const K = ctx.base.byte_add(m.keys.offset) as *const K;
                let kp: *const K = keys.add(i as i64);
                K::write_key_val(kp, ctx);
                ctx.out.push_u8(58);   // ':'
                if ctx.opts.indent > 0 { ctx.out.push_u8(32); }
                let vals: *const AnyVal = ctx.base.byte_add(m.vals.offset) as *const AnyVal;
                let vp: *const AnyVal = vals.add(i as i64);
                let vv: AnyVal = AnyVal { raw: vp.raw };
                stringify_anyval(vv, ctx);
                i = i + 1;
            }
            ctx.out.push_u8(125);  // '}'
        }
    }
}

impl HermesStringify for TypedValue {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let tv: *const TypedValue = self;
            let hs: *const HermesString = ctx.base.byte_add(tv.type_off.offset as i64) as *const HermesString;
            let b: *const u8 = hs.bytes();
            let n: u64 = hs.len();

            ctx.out.push_u8(64);   // '@'
            let mut i: u64 = 0;
            while i < n {
                ctx.out.push_u8(*b.byte_add(i as i64));
                i = i + 1;
            }

            let params: AnyVal = AnyVal { raw: tv.params_raw };
            if !params.is_null() {
                ctx.out.push_u8(40);  // '('
                if params.is_ptr() {
                    let pobj: *const u8 = ctx.base.byte_add(params.as_offset() as i64);
                    let th: u64 = read_type_code(pobj);
                    if th == hermes_tag_array() {
                        let arr: *const ObjectArray = pobj as *const ObjectArray;
                        let mut pi: u64 = 0;
                        while pi < arr.size {
                            if pi > 0 { ctx.out.push_u8(44); }
                            let v: AnyVal = arr.get(ctx.base, pi);
                            stringify_anyval(v, ctx);
                            pi = pi + 1;
                        }
                    } else {
                        stringify_anyval(params, ctx);
                    }
                } else {
                    stringify_anyval(params, ctx);
                }
                ctx.out.push_u8(41);  // ')'
            }

            ctx.out.push_u8(32);  // ' '
            ctx.out.push_u8(61);  // '='
            ctx.out.push_u8(32);  // ' '
            let initv: AnyVal = AnyVal { raw: tv.init_raw };
            stringify_anyval(initv, ctx);
        }
    }
}

// ── ArrayElemTag — presentational `<TAG> ` prefix for Array<T> stringify ──
// Orthogonal to HermesStringify: tag is about how the *container* is
// introduced in text, not how elements are formatted.  Types that should
// appear without a prefix (AnyVal, RelPtr<_>) impl it as a no-op.

// Self-method form (not associated fn) to work around a compiler bug:
// `T::emit_tag(out)` on a generic type param fails to monomorphize the
// impl; `phantom.emit_tag(out)` through EMethodCall works.  The self
// pointer is never dereferenced.
pub genos ArrayElemTag {
    unsafe fn emit_tag(self: *const Self, out: *mut String);
}

impl ArrayElemTag for AnyVal {
    unsafe fn emit_tag(self: *const AnyVal, _out: *mut String) {}
}

impl ArrayElemTag for i8 {
    unsafe fn emit_tag(self: *const i8, out: *mut String) {
        out.push_u8(60); out.push_u8(73); out.push_u8(56); out.push_u8(62); out.push_u8(32);
        // '<' 'I' '8' '>' ' '
    }
}

impl ArrayElemTag for u8 {
    unsafe fn emit_tag(self: *const u8, out: *mut String) {
        out.push_u8(60); out.push_u8(85); out.push_u8(56); out.push_u8(62); out.push_u8(32);
        // '<' 'U' '8' '>' ' '
    }
}

impl ArrayElemTag for i16 {
    unsafe fn emit_tag(self: *const i16, out: *mut String) {
        out.push_u8(60); out.push_u8(73); out.push_u8(49); out.push_u8(54); out.push_u8(62); out.push_u8(32);
        // '<' 'I' '1' '6' '>' ' '
    }
}

impl ArrayElemTag for u16 {
    unsafe fn emit_tag(self: *const u16, out: *mut String) {
        out.push_u8(60); out.push_u8(85); out.push_u8(49); out.push_u8(54); out.push_u8(62); out.push_u8(32);
        // '<' 'U' '1' '6' '>' ' '
    }
}

impl ArrayElemTag for i32 {
    unsafe fn emit_tag(self: *const i32, out: *mut String) {
        out.push_u8(60);   // '<'
        out.push_u8(73);   // 'I'
        out.push_u8(51);   // '3'
        out.push_u8(50);   // '2'
        out.push_u8(62);   // '>'
        out.push_u8(32);   // ' '
    }
}

impl ArrayElemTag for u32 {
    unsafe fn emit_tag(self: *const u32, out: *mut String) {
        out.push_u8(60); out.push_u8(85); out.push_u8(51); out.push_u8(50); out.push_u8(62); out.push_u8(32);
        // '<' 'U' '3' '2' '>' ' '
    }
}

impl ArrayElemTag for i64 {
    unsafe fn emit_tag(self: *const i64, out: *mut String) {
        out.push_u8(60); out.push_u8(73); out.push_u8(54); out.push_u8(52); out.push_u8(62); out.push_u8(32);
        // '<' 'I' '6' '4' '>' ' '
    }
}

impl ArrayElemTag for u64 {
    unsafe fn emit_tag(self: *const u64, out: *mut String) {
        out.push_u8(60);   // '<'
        out.push_u8(85);   // 'U'
        out.push_u8(54);   // '6'
        out.push_u8(52);   // '4'
        out.push_u8(62);   // '>'
        out.push_u8(32);   // ' '
    }
}

impl ArrayElemTag for f32 {
    unsafe fn emit_tag(self: *const f32, out: *mut String) {
        out.push_u8(60); out.push_u8(70); out.push_u8(51); out.push_u8(50); out.push_u8(62); out.push_u8(32);
        // '<' 'F' '3' '2' '>' ' '
    }
}

impl ArrayElemTag for f64 {
    unsafe fn emit_tag(self: *const f64, out: *mut String) {
        out.push_u8(60); out.push_u8(70); out.push_u8(54); out.push_u8(52); out.push_u8(62); out.push_u8(32);
        // '<' 'F' '6' '4' '>' ' '
    }
}

// Primitive HermesStringify impls — used when T is statically known
// (e.g. Array<i32> element formatting); no tag dispatch needed.
impl HermesStringify for i8 {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe { ctx.out.push_i64(*self as i64); }
    }
}

impl HermesStringify for u8 {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe { ctx.out.push_u64(*self as u64); }
    }
}

