// Logos Hermes stdlib — hermes.stringify
//
// Trait-based text serialisation of Hermes zone documents.
//
// Architecture
// ────────────
// Zone objects (HermesString, ObjectArray, ObjectMap, TinyObjectMap,
// DocumentHeader) implement `HermesStringify` with `#[tag_dispatch(
// HermesTypeTagSystem)]`. Dispatch reads the legacy 2-byte tag before each
// object and selects the right impl from a compiler-generated table indexed
// by type_hash.
//
// Inline AnyVal values (Integer/Boolean/…/TinyInt) are not in the zone and
// have no in-memory tag — they are handled in `stringify_anyval` with an
// explicit switch over `val.type_hash()`.
//
// Entry points:
//   pub unsafe fn stringify_anyval(val, ctx)
//   pub unsafe fn stringify_document(base, out, opts)
//
// For compact output:  StringifyOpts::compact()
// For pretty output:   StringifyOpts::pretty()   (2-space indent)

package hermes.stringify;

use hermes.anyval;
use hermes.string;
use hermes.typetag;
use hermes.datatag;
use hermes.tag_system;
use hermes.containers;
use hermes.objectmap;
use hermes.document;
use hermes.scalar;
use hermes.decimal;
use std.string;

// ---------------------------------------------------------------------------
// StringifyOpts — formatting options passed through the recursive walk.
// ---------------------------------------------------------------------------

pub eidos StringifyOpts {
    pub indent: i64,   // spaces per nesting level; 0 = compact
}

impl StringifyOpts {
    pub static fn compact() -> StringifyOpts {
        return StringifyOpts { indent: 0 };
    }

    pub static fn pretty() -> StringifyOpts {
        return StringifyOpts { indent: 2 };
    }

    pub static fn with_indent(n: i64) -> StringifyOpts {
        return StringifyOpts { indent: n };
    }
}

// ---------------------------------------------------------------------------
// StringifyCtx — recursive traversal context.
//
// Passed by mutable pointer through every stringify call so that any impl
// can append to the output buffer, resolve zone offsets via `base`, and
// observe/modify the indentation depth.
// ---------------------------------------------------------------------------

pub struct StringifyCtx {
    pub out:   *mut String,
    pub base:  *const u8,
    pub opts:  StringifyOpts,
    pub depth: i64,
}

// ---------------------------------------------------------------------------
// Indentation helper — writes "\n" + (indent * depth) spaces in pretty mode.
// ---------------------------------------------------------------------------

unsafe fn write_indent(ctx: *mut StringifyCtx) {
    if ctx.opts.indent <= 0 as i64 { return; }
    ctx.out.push_u8(10 as u8);
    let spaces: i64 = ctx.opts.indent * ctx.depth;
    let mut i: i64 = 0 as i64;
    while i < spaces {
        ctx.out.push_u8(32 as u8);
        i = i + 1 as i64;
    }
}

unsafe fn write_null(out: *mut String) {
    out.push_u8(110 as u8);  // 'n'
    out.push_u8(117 as u8);  // 'u'
    out.push_u8(108 as u8);  // 'l'
    out.push_u8(108 as u8);  // 'l'
}

// ---------------------------------------------------------------------------
// Quoted-string helper (shared between HermesString and ObjectMap keys).
// ---------------------------------------------------------------------------

unsafe fn write_quoted_hs(hs: *const HermesString, out: *mut String) {
    out.push_u8(34 as u8);   // '"'
    let len: u64   = hs.len();
    let bptr: *const u8 = hs.bytes();
    let mut i: u64 = 0 as u64;
    while i < len {
        let c: u8 = *((bptr as i64 + i as i64) as *const u8);
        if c == 34 as u8 {
            out.push_u8(92 as u8); out.push_u8(34 as u8);
        } else if c == 92 as u8 {
            out.push_u8(92 as u8); out.push_u8(92 as u8);
        } else if c == 10 as u8 {
            out.push_u8(92 as u8); out.push_u8(110 as u8);
        } else if c == 13 as u8 {
            out.push_u8(92 as u8); out.push_u8(114 as u8);
        } else if c == 9 as u8 {
            out.push_u8(92 as u8); out.push_u8(116 as u8);
        } else {
            out.push_u8(c);
        }
        i = i + 1 as u64;
    }
    out.push_u8(34 as u8);
}

// ---------------------------------------------------------------------------
// HermesStringify — polymorphic stringification trait.
//
// Dispatch reads the legacy 2-byte tag immediately before the object.
// `#[tag_dispatch(HermesTypeTagSystem)]` tells the compiler to generate a
// dispatch table keyed by type_hash (byte[obj-2]).
// ---------------------------------------------------------------------------

#[tag_dispatch(HermesTypeTagSystem)]
pub trait HermesStringify {
    fn stringify(&self, ctx: *mut StringifyCtx);
}

// ── HermesString (type_code=28) ────────────────────────────────────────────

impl HermesStringify for HermesString {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let hs: *const HermesString = self as *const HermesString;
            write_quoted_hs(hs, ctx.out);
        }
    }
}

// ── AnyVal (static dispatch through inline bits) ───────────────────────────

impl HermesStringify for AnyVal {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe { stringify_anyval(AnyVal { raw: (self as *const AnyVal).raw }, ctx); }
    }
}

impl HermesStringify for Array<i32> {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let arr: *const Array<i32> = self as *const Array<i32>;
            ctx.out.push_u8(60 as u8);   // '<'
            ctx.out.push_u8(73 as u8);   // 'I'
            ctx.out.push_u8(51 as u8);   // '3'
            ctx.out.push_u8(50 as u8);   // '2'
            ctx.out.push_u8(62 as u8);   // '>'
            ctx.out.push_u8(32 as u8);   // ' '
            ctx.out.push_u8(91 as u8);   // '['

            let mut i: u64 = 0 as u64;
            while i < arr.size {
                if i > 0 as u64 { ctx.out.push_u8(44 as u8); }
                let ep: *const i32 =
                    (ctx.base as i64 + arr.data.offset as i64 + (i as i64) * 4 as i64) as *const i32;
                ctx.out.push_i64(*ep as i64);
                i = i + 1 as u64;
            }
            ctx.out.push_u8(93 as u8);   // ']'
        }
    }
}

impl HermesStringify for Array<u64> {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let arr: *const Array<u64> = self as *const Array<u64>;
            ctx.out.push_u8(60 as u8);   // '<'
            ctx.out.push_u8(85 as u8);   // 'U'
            ctx.out.push_u8(54 as u8);   // '6'
            ctx.out.push_u8(52 as u8);   // '4'
            ctx.out.push_u8(62 as u8);   // '>'
            ctx.out.push_u8(32 as u8);   // ' '
            ctx.out.push_u8(91 as u8);   // '['

            let mut i: u64 = 0 as u64;
            while i < arr.size {
                if i > 0 as u64 { ctx.out.push_u8(44 as u8); }
                let ep: *const u64 =
                    (ctx.base as i64 + arr.data.offset as i64 + (i as i64) * 8 as i64) as *const u64;
                ctx.out.push_u64(*ep);
                i = i + 1 as u64;
            }
            ctx.out.push_u8(93 as u8);   // ']'
        }
    }
}

impl HermesStringify for MapI32AnyVal {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let m: *const MapI32AnyVal = self as *const MapI32AnyVal;
            ctx.out.push_u8(60 as u8);   // '<'
            ctx.out.push_u8(73 as u8);   // 'I'
            ctx.out.push_u8(51 as u8);   // '3'
            ctx.out.push_u8(50 as u8);   // '2'
            ctx.out.push_u8(44 as u8);   // ','
            ctx.out.push_u8(65 as u8);   // 'A'
            ctx.out.push_u8(110 as u8);  // 'n'
            ctx.out.push_u8(121 as u8);  // 'y'
            ctx.out.push_u8(86 as u8);   // 'V'
            ctx.out.push_u8(97 as u8);   // 'a'
            ctx.out.push_u8(108 as u8);  // 'l'
            ctx.out.push_u8(62 as u8);   // '>'
            ctx.out.push_u8(32 as u8);   // ' '
            ctx.out.push_u8(123 as u8);  // '{'

            let mut i: u32 = 0 as u32;
            while i < m.size {
                if i > 0 as u32 { ctx.out.push_u8(44 as u8); }
                let kp: *const i32 =
                    (ctx.base as i64 + m.keys.offset as i64 + (i as i64) * 4 as i64) as *const i32;
                ctx.out.push_i64(*kp as i64);
                ctx.out.push_u8(58 as u8);   // ':'
                if ctx.opts.indent > 0 as i64 { ctx.out.push_u8(32 as u8); }
                let vp: *const AnyVal =
                    (ctx.base as i64 + m.vals.offset as i64 + (i as i64) * 4 as i64) as *const AnyVal;
                let vv: AnyVal = AnyVal { raw: vp.raw };
                stringify_anyval(vv, ctx);
                i = i + 1 as u32;
            }
            ctx.out.push_u8(125 as u8);  // '}'
        }
    }
}

impl HermesStringify for TypedValue {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let tv: *const TypedValue = self as *const TypedValue;
            let hs: *const HermesString = (ctx.base as i64 + tv.type_off.offset as i64) as *const HermesString;
            let b: *const u8 = hs.bytes();
            let n: u64 = hs.len();

            ctx.out.push_u8(64 as u8);   // '@'
            let mut i: u64 = 0 as u64;
            while i < n {
                ctx.out.push_u8(*((b as i64 + i as i64) as *const u8));
                i = i + 1 as u64;
            }

            let params: AnyVal = AnyVal { raw: tv.params_raw };
            if !params.is_null() {
                ctx.out.push_u8(40 as u8);  // '('
                if params.is_ptr() {
                    let pobj: *const u8 = (ctx.base as i64 + params.as_offset() as i64) as *const u8;
                    let th: u64 = read_type_code(pobj);
                    if th == hermes_tag_array() as u64 {
                        let arr: *const ObjectArray = pobj as *const ObjectArray;
                        let mut pi: u64 = 0 as u64;
                        while pi < arr.size {
                            if pi > 0 as u64 { ctx.out.push_u8(44 as u8); }
                            let v: AnyVal = arr.get(ctx.base, pi);
                            stringify_anyval(v, ctx);
                            pi = pi + 1 as u64;
                        }
                    } else {
                        stringify_anyval(params, ctx);
                    }
                } else {
                    stringify_anyval(params, ctx);
                }
                ctx.out.push_u8(41 as u8);  // ')'
            }

            ctx.out.push_u8(32 as u8);  // ' '
            ctx.out.push_u8(61 as u8);  // '='
            ctx.out.push_u8(32 as u8);  // ' '
            let initv: AnyVal = AnyVal { raw: tv.init_raw };
            stringify_anyval(initv, ctx);
        }
    }
}

// ── ArrayElemTag — presentational `<TAG> ` prefix for Array<T> stringify ──
// Orthogonal to HermesStringify: tag is about how the *container* is
// introduced in text, not how elements are formatted.  Types that should
// appear without a prefix (AnyVal, RelPtr<_>) impl it as a no-op.

// Self-method form (not associated fn) to work around a compiler bug:
// `T::emit_tag(out)` on a generic type param fails to monomorphize the
// impl; `phantom.emit_tag(out)` through EMethodCall works.  The self
// pointer is never dereferenced.
pub genos ArrayElemTag {
    unsafe fn emit_tag(self: *const Self, out: *mut String);
}

impl ArrayElemTag for AnyVal {
    unsafe fn emit_tag(self: *const AnyVal, _out: *mut String) {}
}

impl ArrayElemTag for i32 {
    unsafe fn emit_tag(self: *const i32, out: *mut String) {
        out.push_u8(60 as u8);   // '<'
        out.push_u8(73 as u8);   // 'I'
        out.push_u8(51 as u8);   // '3'
        out.push_u8(50 as u8);   // '2'
        out.push_u8(62 as u8);   // '>'
        out.push_u8(32 as u8);   // ' '
    }
}

impl ArrayElemTag for u64 {
    unsafe fn emit_tag(self: *const u64, out: *mut String) {
        out.push_u8(60 as u8);   // '<'
        out.push_u8(85 as u8);   // 'U'
        out.push_u8(54 as u8);   // '6'
        out.push_u8(52 as u8);   // '4'
        out.push_u8(62 as u8);   // '>'
        out.push_u8(32 as u8);   // ' '
    }
}

// Primitive HermesStringify impls — used when T is statically known
// (e.g. Array<i32> element formatting); no tag dispatch needed.
impl HermesStringify for i32 {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe { ctx.out.push_i64(*self as i64); }
    }
}

impl HermesStringify for u64 {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe { ctx.out.push_u64(*self); }
    }
}

// ── Array<T> — blanket over any T: HermesStringify + ArrayElemTag ─────────
// Works for Array<AnyVal> (previously ObjectArray, type_code=100), Array<i32>,
// etc.  Element layout is contiguous T[] at the zone-relative `data` offset.
// `T::emit_tag` inserts `<I32> ` / `<U64> ` for primitive typed arrays;
// AnyVal and RelPtr<_> emit nothing.

impl<T: HermesStringify + ArrayElemTag> HermesStringify for Array<T> {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let arr: *const Array<T> = self as *const Array<T>;
            let phantom: *const T = 0 as *const T;
            phantom.emit_tag(ctx.out);
            ctx.out.push_u8(91 as u8);   // '['
            let sz: u64 = arr.size;
            let elem_sz: i64 = sizeof::<T>() as i64;
            let base_int: i64 = ctx.base as i64 + arr.data.offset as i64;
            let mut i: u64 = 0 as u64;
            while i < sz {
                if i > 0 as u64 { ctx.out.push_u8(44 as u8); }
                ctx.depth = ctx.depth + 1 as i64;
                write_indent(ctx);
                let elem: *const T = (base_int + (i as i64) * elem_sz) as *const T;
                elem.stringify(ctx);
                ctx.depth = ctx.depth - 1 as i64;
                i = i + 1 as u64;
            }
            if sz > 0 as u64 { write_indent(ctx); }
            ctx.out.push_u8(93 as u8);   // ']'
        }
    }
}

// ── Map<Bitmap, V> blanket — bitmap-indexed compact map ───────────────────

impl<V: HermesStringify> HermesStringify for Map<Bitmap, V> {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let map: *const Map<Bitmap, V> = self as *const Map<Bitmap, V>;
            ctx.out.push_u8(123 as u8);  // '{'
            let bitmap: u64 = map.header & 0x000FFFFFFFFFFFFF as u64;
            let elem_sz: i64 = sizeof::<V>() as i64;
            let arr_base: i64 = ctx.base as i64 + map.data.offset as i64;
            let mut first: bool = true;
            let mut key: u8 = 0 as u8;
            while key < 52 as u8 {
                let key_bit: u64 = 1 as u64 << key as u64;
                if (bitmap & key_bit) != 0 as u64 {
                    if !first { ctx.out.push_u8(44 as u8); }
                    first = false;
                    ctx.depth = ctx.depth + 1 as i64;
                    write_indent(ctx);
                    ctx.out.push_u8(34 as u8);   // '"'
                    ctx.out.push_u8(107 as u8);  // 'k'
                    ctx.out.push_u64(key as u64);
                    ctx.out.push_u8(34 as u8);   // '"'
                    ctx.out.push_u8(58 as u8);   // ':'
                    if ctx.opts.indent > 0 as i64 { ctx.out.push_u8(32 as u8); }
                    let mask: u64 = key_bit - 1 as u64;
                    let pos: u32  = popcount_u64(bitmap & mask);
                    let elem: *const V = (arr_base + (pos as i64) * elem_sz) as *const V;
                    elem.stringify(ctx);
                    ctx.depth = ctx.depth - 1 as i64;
                }
                key = key + 1 as u8;
            }
            if !first { write_indent(ctx); }
            ctx.out.push_u8(125 as u8);  // '}'
        }
    }
}

// ── ObjectMap (type_code=101) ──────────────────────────────────────────────

impl HermesStringify for ObjectMap {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let map: *const ObjectMap = self as *const ObjectMap;
            ctx.out.push_u8(123 as u8);  // '{'
            let cap: u32 = map.capacity;
            let ent_base: i64 = ctx.base as i64 + map.entries_off.offset as i64;
            let mut first: bool = true;
            let mut slot: u32 = 0 as u32;
            while slot < cap {
                let ep: *const MapEntry =
                    (ent_base + slot as i64 * 8 as i64) as *const MapEntry;
                if ep.key_off.offset != 0 as u32 {
                    if !first { ctx.out.push_u8(44 as u8); }
                    first = false;
                    ctx.depth = ctx.depth + 1 as i64;
                    write_indent(ctx);
                    let hs: *const HermesString =
                        (ctx.base as i64 + ep.key_off.offset as i64) as *const HermesString;
                    write_quoted_hs(hs, ctx.out);
                    ctx.out.push_u8(58 as u8);   // ':'
                    if ctx.opts.indent > 0 as i64 { ctx.out.push_u8(32 as u8); }
                    let val: AnyVal = AnyVal { raw: ep.val };
                    stringify_anyval(val, ctx);
                    ctx.depth = ctx.depth - 1 as i64;
                }
                slot = slot + 1 as u32;
            }
            if !first { write_indent(ctx); }
            ctx.out.push_u8(125 as u8);  // '}'
        }
    }
}

// ── I64 (type_code=26) ─────────────────────────────────────────────────────

impl HermesStringify for I64 {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let a: *const I64 = self as *const I64;
            ctx.out.push_i64(a.value());
        }
    }
}

// ── U64 (type_code=27) ─────────────────────────────────────────────────────

impl HermesStringify for U64 {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let a: *const U64 = self as *const U64;
            ctx.out.push_u64(a.value());
        }
    }
}

impl HermesStringify for Decimal {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let d: *const Decimal = self as *const Decimal;
            ctx.out.push_u8(34 as u8);   // '"'
            decimal_write_number(d, ctx.out);
            ctx.out.push_u8(34 as u8);   // '"'
            ctx.out.push_u8(64 as u8);   // '@'
            ctx.out.push_u8(68 as u8);   // 'D'
            ctx.out.push_u8(101 as u8);  // 'e'
            ctx.out.push_u8(99 as u8);   // 'c'
            ctx.out.push_u8(105 as u8);  // 'i'
            ctx.out.push_u8(109 as u8);  // 'm'
            ctx.out.push_u8(97 as u8);   // 'a'
            ctx.out.push_u8(108 as u8);  // 'l'
            ctx.out.push_u8(40 as u8);   // '('
            ctx.out.push_u64(d.precision() as u64);
            ctx.out.push_u8(44 as u8);   // ','
            ctx.out.push_u64(d.scale() as u64);
            ctx.out.push_u8(41 as u8);   // ')'
        }
    }
}

// ---------------------------------------------------------------------------
// Top-level AnyVal dispatcher — pointer vs inline, then delegates.
// ---------------------------------------------------------------------------

pub unsafe fn stringify_anyval(val: AnyVal, ctx: *mut StringifyCtx) {
    if val.is_null() { write_null(ctx.out); return; }

    if val.is_ptr() {
        // Pointer mode: dispatch through HermesTypeTagSystem trait table.
        let obj: *const u8 = (ctx.base as i64 + val.as_offset() as i64) as *const u8;
        let tagged_obj: &tagged<HermesTypeTagSystem> HermesStringify = obj;
        tagged_obj.stringify(ctx);
        return;
    }

    // Inline mode: switch on type_hash.
    let th: u8 = val.type_hash();
    let out: *mut String = ctx.out;
    if th == 23 as u8 {
        out.push_i64(val.as_i24() as i64);
    } else if th == 25 as u8 {
        out.push_u64(val.as_u24() as u64);
        out.push_u8(95 as u8); out.push_u8(117 as u8);
        out.push_u8(51 as u8); out.push_u8(50 as u8);   // "_u32"
    } else if th == 20 as u8 {
        out.push_i64(val.as_i8() as i64);
        out.push_u8(95 as u8); out.push_u8(115 as u8); out.push_u8(56 as u8);   // "_s8"
    } else if th == 21 as u8 {
        out.push_u64(val.as_u8() as u64);
        out.push_u8(95 as u8); out.push_u8(117 as u8); out.push_u8(56 as u8);   // "_u8"
    } else if th == 22 as u8 {
        out.push_i64(val.as_i16() as i64);
        out.push_u8(95 as u8); out.push_u8(115 as u8);
        out.push_u8(49 as u8); out.push_u8(54 as u8);   // "_s16"
    } else if th == 24 as u8 {
        out.push_u64(val.as_u16() as u64);
        out.push_u8(95 as u8); out.push_u8(117 as u8);
        out.push_u8(49 as u8); out.push_u8(54 as u8);   // "_u16"
    } else if th == 37 as u8 {
        if val.as_bool() {
            out.push_u8(116 as u8); out.push_u8(114 as u8);
            out.push_u8(117 as u8); out.push_u8(101 as u8);   // "true"
        } else {
            out.push_u8(102 as u8); out.push_u8(97 as u8); out.push_u8(108 as u8);
            out.push_u8(115 as u8); out.push_u8(101 as u8);   // "false"
        }
    } else {
        write_null(out);
    }
}

// ---------------------------------------------------------------------------
// Document-level entry point.
// ---------------------------------------------------------------------------

pub unsafe fn stringify_document(base: *const u8, out: *mut String, opts: StringifyOpts) {
    let doc: *const DocumentHeader = base as *const DocumentHeader;
    let root: AnyVal = document_get_root(doc);
    let mut ctx: StringifyCtx = StringifyCtx {
        out:   out,
        base:  base,
        opts:  opts,
        depth: 0 as i64,
    };
    stringify_anyval(root, &mut ctx);
}
