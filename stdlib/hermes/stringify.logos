// ── Array<T> — blanket over any T: HermesStringify + ArrayElemTag ─────────
// Works for Array<AnyVal> (previously ObjectArray, type_code=100), Array<i32>,
// etc.  Element layout is contiguous T[] at the zone-relative `data` offset.
// `T::emit_tag` inserts `<I32> ` / `<U64> ` for primitive typed arrays;
// AnyVal and RelPtr<_> emit nothing.

impl<T: HermesStringify + ArrayElemTag> HermesStringify for Array<T> {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let arr: *const Array<T> = self as *const Array<T>;
            let phantom: *const T = 0 as *const T;
            phantom.emit_tag(ctx.out);
            ctx.out.push_u8(91);   // '['
            let sz: u64 = arr.size;
            let base: *const T = ctx.base.byte_add(arr.data.offset) as *const T;
            let mut i: u64 = 0;
            while i < sz {
                if i > 0 { ctx.out.push_u8(44); }
                ctx.depth = ctx.depth + 1;
                write_indent(ctx);
                let elem: *const T = base.add(i as i64);
                elem.stringify(ctx);
                ctx.depth = ctx.depth - 1;
                i = i + 1;
            }
            if sz > 0 { write_indent(ctx); }
            ctx.out.push_u8(93);   // ']'
        }
    }
}

// ── Map<Bitmap, V> blanket — bitmap-indexed compact map ───────────────────

impl<V: HermesStringify> HermesStringify for Map<Bitmap, V> {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let map: *const Map<Bitmap, V> = self as *const Map<Bitmap, V>;
            ctx.out.push_u8(123);  // '{'
            let bitmap: u64 = map.header & 0x000FFFFFFFFFFFFF;
            let arr_base: *const V = ctx.base.byte_add(map.data.offset) as *const V;
            let mut first: bool = true;
            let mut key: u8 = 0;
            while key < 52 {
                let key_bit: u64 = 1 << key as u64;
                if (bitmap & key_bit) != 0 {
                    if !first { ctx.out.push_u8(44); }
                    first = false;
                    ctx.depth = ctx.depth + 1;
                    write_indent(ctx);
                    ctx.out.push_u8(34);   // '"'
                    ctx.out.push_u8(107);  // 'k'
                    ctx.out.push_u64(key as u64);
                    ctx.out.push_u8(34);   // '"'
                    ctx.out.push_u8(58);   // ':'
                    if ctx.opts.indent > 0 { ctx.out.push_u8(32); }
                    let mask: u64 = key_bit - 1;
                    let pos: u32  = popcount_u64(bitmap & mask);
                    let elem: *const V = arr_base.add(pos as i64);
                    elem.stringify(ctx);
                    ctx.depth = ctx.depth - 1;
                }
                key = key + 1;
            }
            if !first { write_indent(ctx); }
            ctx.out.push_u8(125);  // '}'
        }
    }
}

// ── ObjectMap (type_code=101) ──────────────────────────────────────────────

impl HermesStringify for ObjectMap {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let map: *const ObjectMap = self;
            ctx.out.push_u8(123);  // '{'
            let cap: u32 = map.capacity;
            let ent_base: *const MapEntry = ctx.base.byte_add(map.entries_off.offset as i64) as *const MapEntry;
            let mut first: bool = true;
            let mut slot: u32 = 0;
            while slot < cap {
                let ep: *const MapEntry = ent_base.add(slot as i64);
                if ep.key_off.offset != 0 {
                    if !first { ctx.out.push_u8(44); }
                    first = false;
                    ctx.depth = ctx.depth + 1;
                    write_indent(ctx);
                    let hs: *const HermesString =
                        ctx.base.byte_add(ep.key_off.offset as i64) as *const HermesString;
                    write_quoted_hs(hs, ctx.out);
                    ctx.out.push_u8(58);   // ':'
                    if ctx.opts.indent > 0 { ctx.out.push_u8(32); }
                    let val: AnyVal = AnyVal { raw: ep.val };
                    stringify_anyval(val, ctx);
                    ctx.depth = ctx.depth - 1;
                }
                slot = slot + 1;
            }
            if !first { write_indent(ctx); }
            ctx.out.push_u8(125);  // '}'
        }
    }
}

// ── I64 (type_code=26) ─────────────────────────────────────────────────────

impl HermesStringify for I64 {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let a: *const I64 = self;
            ctx.out.push_i64(a.value());
        }
    }
}

// ── U64 (type_code=27) ─────────────────────────────────────────────────────

impl HermesStringify for U64 {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let a: *const U64 = self;
            ctx.out.push_u64(a.value());
        }
    }
}

impl HermesStringify for Decimal {
    pub fn stringify(&self, ctx: *mut StringifyCtx) {
        unsafe {
            let d: *const Decimal = self;
            ctx.out.push_u8(34);   // '"'
            decimal_write_number(d, ctx.out);
            ctx.out.push_u8(34);   // '"'
            ctx.out.push_u8(64);   // '@'
            ctx.out.push_u8(68);   // 'D'
            ctx.out.push_u8(101);  // 'e'
            ctx.out.push_u8(99);   // 'c'
            ctx.out.push_u8(105);  // 'i'
            ctx.out.push_u8(109);  // 'm'
            ctx.out.push_u8(97);   // 'a'
            ctx.out.push_u8(108);  // 'l'
            ctx.out.push_u8(40);   // '('
            ctx.out.push_u64(d.precision() as u64);
            ctx.out.push_u8(44);   // ','
            ctx.out.push_u64(d.scale() as u64);
            ctx.out.push_u8(41);   // ')'
        }
    }
}

// ---------------------------------------------------------------------------
// Top-level AnyVal dispatcher — pointer vs inline, then delegates.
// ---------------------------------------------------------------------------

pub unsafe fn stringify_anyval(val: AnyVal, ctx: *mut StringifyCtx) {
    if val.is_null() { write_null(ctx.out); return; }

    if val.is_ptr() {
        // Pointer mode: dispatch through HermesTypeTagSystem trait table.
        let obj: *const u8 = ctx.base.byte_add(val.as_offset() as i64);
        let tagged_obj: &tagged<HermesTypeTagSystem> HermesStringify = obj;
        tagged_obj.stringify(ctx);
        return;
    }

    // Inline mode: switch on type_hash.
    let th: u8 = val.type_hash();
    let out: *mut String = ctx.out;
    if th == 23 {
        out.push_i64(val.as_i24() as i64);
    } else if th == 25 {
        out.push_u64(val.as_u24() as u64);
        out.push_u8(95); out.push_u8(117);
        out.push_u8(51); out.push_u8(50);   // "_u32"
    } else if th == 20 {
        out.push_i64(val.as_i8() as i64);
        out.push_u8(95); out.push_u8(115); out.push_u8(56);   // "_s8"
    } else if th == 21 {
        out.push_u64(val.as_u8() as u64);
        out.push_u8(95); out.push_u8(117); out.push_u8(56);   // "_u8"
    } else if th == 22 {
        out.push_i64(val.as_i16() as i64);
        out.push_u8(95); out.push_u8(115);
        out.push_u8(49); out.push_u8(54);   // "_s16"
    } else if th == 24 {
        out.push_u64(val.as_u16() as u64);
        out.push_u8(95); out.push_u8(117);
        out.push_u8(49); out.push_u8(54);   // "_u16"
    } else if th == 37 {
        if val.as_bool() {
            out.push_u8(116); out.push_u8(114);
            out.push_u8(117); out.push_u8(101);   // "true"
        } else {
            out.push_u8(102); out.push_u8(97); out.push_u8(108);
            out.push_u8(115); out.push_u8(101);   // "false"
        }
    } else {
        write_null(out);
    }
}

// ---------------------------------------------------------------------------
// Document-level entry point.
// ---------------------------------------------------------------------------

pub unsafe fn stringify_document(base: *const u8, out: *mut String, opts: StringifyOpts) {
    let doc: *const DocumentHeader = base as *const DocumentHeader;
    let root: AnyVal = document_get_root(doc);
    let mut ctx: StringifyCtx = StringifyCtx {
        out:   out,
        base:  base,
        opts:  opts,
        depth: 0,
    };
    stringify_anyval(root, &mut ctx);
}
