// logos.std.deem — the PUBLIC runtime query/template API (ADR 0012-queue2 §3,
// slices I1–I3). Query/template TEXT arrives at RUNTIME, is parsed by the SAME
// peg-generated parsers the static queue uses, checked against a SchemaCatalog
// (queue-1-generated schema metadata), lowered/optimized by the SAME
// `lower_rquery_to_rexpr` / `simplify_*` IR passes, and executed by a
// tree-walk evaluator over the schema'd Writ IR. No metacall, no codegen.
//
// I3 adds: dynamic `rel` blocks with the SEMI-NAÏVE fixpoint re-hosted as an
// interpreter loop (SCC condensation + stratification at Query::compile —
// the SAME graph algorithm as the static walker, shared via
// logos.std.wql.params), and LENIENT mode (bind_node_erased /
// bind_source_erased + catalog FK_ANY fields): fields on erased sources
// resolve at runtime by NAME, misses yield RtVal::Null, and Null propagates
// CEL-style (see ADR 0012-queue2 §4 for the exact table).
//
//   let cat: SchemaCatalog = cat();          // resource cat = schema_catalog!{ Emp, … };
//   let t: Tpl = Tpl::compile("Hello {{ e.name }}", &cat)?;   // Result<Tpl, QError>
//   let mut env: QEnv = QEnv::new();
//   env.bind_node("e", emp_any);             // a schema'd Writ object (TOM)
//   let s: String = t.render(&env)?;         // Result<String, QError>
//
//   let q: Query = Query::compile("from emps e where e.age >= n select e.name", &cat)?;
//   env.bind_source("emps", emps_warray);    // a Writ ARRAY of schema'd rows
//   env.bind_i64("n", 40);
//   let rows: QRows = q.run(&env)?;          // compile-once / run-many
//
// DESIGN NOTES:
//   • This package is the ABI-carried stability surface (logos.std.wql.* stays
//     ABI-excluded engine internals). Public types: SchemaCatalog, QEnv, Tpl,
//     Query, QRows, QError, RtVal (+ the QFn/QAgg* fn-ptr aliases — the
//     UDF/UDA registration surface, ADR §6). The evaluator internals stay
//     private.
//   • ERRORS ARE VALUES (Result + message), never compile diagnostics — the
//     caller is a running program (ADR §3). `Tpl::compile` runs the
//     env-INDEPENDENT checks (parse, unknown fn/arity, comprehension/tuple
//     rejection, catalog-wide unknown-field, literal type conflicts) + the
//     optimizer; the FULL strict check (var→schema resolution, field types)
//     needs the env's declarations, so it runs at the top of every `render`
//     (a cheap IR walk) — the fixed compile(text,&cat)/render(&env) API puts
//     the env in scope only at render time.
//   • STRICT typing only (ADR §4): every template root name must resolve to a
//     QEnv binding; every field to a catalog entry. Lenient/erased mode lands
//     in a later slice.
//   • RtVal str OWNERSHIP: RtVal::S carries a `str` VIEW into (a) the Tpl's own
//     IR doc (literals), (b) the caller's data doc (field reads), or (c) a
//     per-render scratch Writ arena (computed strings: concat/upper/lower are
//     interned into the scratch, whose segments never move and outlive the
//     walk). The rendered String is built before the scratch drops.
//   • Unset schema fields read as their WritField defaults (0 / "" / false /
//     0.0 / null-edge) — the SAME semantics the static schema accessors
//     compile to. A null/non-array edge iterates as an EMPTY `{% for %}`.
//   • Integer `/`/`%` by zero traps at eval time, exactly like the static
//     queue's emitted code (documented I1 semantics; a checked value-error
//     path is an I2+ concern).
//   • CATALOG SEAM (cross-module schemas): the entry representation is the
//     `add_schema`/`add_field`/`add_edge` builder-call sequence, PUBLIC so a
//     future decl-site annotation (derive-style hook on the schema decl) can
//     emit the same per-schema entry calls for schemas declared in OTHER
//     modules than the schema_catalog! callsite (same-module reflection is
//     the I1 MVP).
package logos.std.deem;

use logos.lang.writ.container;    // Writ / writ_new
use logos.lang.writ.anyval;       // WAny
use logos.lang.writ.wmap;         // WMap<Wu6, WAny> — TOM reads (schema field gets)
use logos.lang.writ.array;        // WArray — edge-field iteration
use logos.lang.writ.wstring;      // WString / as_wstr — string payloads + interning
use logos.lang.writ.wstatic;      // WritStatic — the rodata metadata-blob handle
use logos.lang.writ.static_view;  // WView2 — reader over rodata Writ blobs
use logos.lang.result;            // Result — the error-as-value carrier
use logos.lang.option;            // Option — HashMapKeys iterator item (SEMILATTICE rescan)
use logos.mem.string;             // String
use logos.lang.str;               // str_eq / str_cmp / str_contains / str_starts_with / …
use logos.lang.arith;             // wrapping_mul — the FNV mix wraps by design
use logos.std.wql.ir;             // SExpr family + WRef (the shared IR)
use logos.std.wql.el;             // EL_TY_* / OP_* / builtin registry / agg rule table
use logos.std.wql.optimize;       // simplify_sexpr / simplify_rexpr_ref + TermList analysis
use logos.std.wql.trama;          // TStmt family + chain_array / next_of_stmt / ttext_str
use logos.std.wql.trama_parser;   // parse_tpl — the reused generated template parser
use logos.std.wql.plan;           // RQuery / RQProgram — the surface query plan views
use logos.std.wql.wql_surface_parser;  // parse_program — the reused generated query parser
use logos.std.wql.lower;          // lower_rquery_to_rexpr — the reused PLAN→ALGEBRA lowering
use logos.std.wql.params;         // RelDeps / RelScc / compute_rel_scc — the SHARED
                                  // (metaprog-free) rel dependency-graph half (I3)
use logos.mem.collections.vec;    // Vec — row pipelines (unbounded)
use logos.mem.collections.hashmap;// HashMap — hash-join buckets / distinct sets

// ═══════════════════════════════════════════════════════════════════════════
// QError — a positioned runtime error VALUE.
// The generated parsers do not stamp source offsets into IR nodes (yet), so
// the position is carried as the OFFENDING NAME/OPERATOR inside the message.
// ═══════════════════════════════════════════════════════════════════════════
pub struct QError {
    pub msg: String,
}

impl QError {
    // The error text as a borrowed view (valid while the QError lives).
    pub fn message(self: &QError) -> str {
        return unsafe { str_from_raw(self.msg.as_ptr(), self.msg.len()) };
    }
}

// Build a QError from a literal message.
fn qerr(m: str) -> QError {
    let mut s: String = String::new();
    s.push_str(m);
    return QError { msg: s };
}

// Build a QError from up to five message parts (the chk_fail shape, but as a
// DIRECT value — usable inside loops where moving a Chk out is awkward).
fn qfail(a: str, b: str, c: str, d: str, e: str) -> QError {
    let mut s: String = String::new();
    s.push_str(a);
    s.push_str(b);
    s.push_str(c);
    s.push_str(d);
    s.push_str(e);
    return QError { msg: s };
}

// &String → borrowed str view (the codegen string_as_str shape, local to keep
// this package free of metaprog-importing dependencies).
fn sstr(s: &String) -> str {
    return unsafe { str_from_raw(s.as_ptr(), s.len()) };
}

// SView2 (rodata-blob string view) → str.
fn sview2_str(v: SView2) -> str {
    if v.ptr == (0 as *const u8) { return ""; }
    return unsafe { str_from_raw(v.ptr, v.len as i64) };
}

// ═══════════════════════════════════════════════════════════════════════════
// SchemaCatalog — runtime schema metadata (ADR §5).
// schema code → { field name → (key code, value type, edge target) }.
// Filled by the queue-1 `schema_catalog!{ S1, S2, … }` macro (which reflects
// the schema decls and emits the add_* calls), or by any other emitter that
// speaks the same builder calls (the decl-site annotation seam).
// ═══════════════════════════════════════════════════════════════════════════

// Field kinds.
const FK_SCALAR: i32 = 0i32;   // i64/str/bool/f64 family — f_tys holds EL_TY_*
const FK_EDGE:   i32 = 1i32;   // WRef<S> — f_targets holds S's schema code
const FK_ANY:    i32 = 2i32;   // WAny — type-erased (strict mode rejects access)
const FK_EARR:   i32 = 3i32;   // WRef<scalar> — a SCALAR-ELEMENT array edge
                               // (WRef<str>/<i64>/…): f_tys holds the ELEMENT
                               // EL type. Emitted by the same catalog blob
                               // entry shape as a schema edge ({"ty":"edge",
                               // "target":"str"}) — the scalar target NAME is
                               // the discriminator (primitive names cannot
                               // name schemas). I2 extension per I1's note.

const CAT_SCHEMAS: i64 = 16i64;
const CAT_FIELDS:  i64 = 96i64;

// LAYOUT NOTE (I3): the tables are Vec-BACKED. A SchemaCatalog rides inside
// every Tpl/Query value; with inline fixed arrays the struct was ~3.6KB and
// every generic instantiation over Option<Tpl>/Result<Query,·> scalarized
// those kilobytes into unrolled per-word copies — minutes-long stdlib builds
// (the queue-2 I3 build-time incident). Vec-backing keeps the value a few
// words; the (tiny) CAT_* caps are kept for behavior parity.
pub struct SchemaCatalog {
    // schemas
    s_names: Vec<str>,
    s_codes: Vec<u64>,
    s_n:     i64,
    // fields (flat, owner-indexed)
    f_owner:   Vec<i64>,   // index into the schema tables
    f_names:   Vec<str>,
    f_keys:    Vec<i64>,   // TOM key code
    f_tys:     Vec<i64>,   // EL_TY_* (FK_SCALAR only)
    f_kinds:   Vec<i64>,   // FK_*
    f_targets: Vec<u64>,   // FK_EDGE: target schema code (0 = unresolved)
    f_tnames:  Vec<str>,   // FK_EDGE: target schema NAME (late resolution)
    f_n:       i64,
}

impl SchemaCatalog {
    pub fn new() -> SchemaCatalog {
        return SchemaCatalog {
            s_names: vec_new::<str>(), s_codes: vec_new::<u64>(), s_n: 0i64,
            f_owner: vec_new::<i64>(), f_names: vec_new::<str>(), f_keys: vec_new::<i64>(),
            f_tys: vec_new::<i64>(), f_kinds: vec_new::<i64>(), f_targets: vec_new::<u64>(),
            f_tnames: vec_new::<str>(), f_n: 0i64,
        };
    }

    // Internal: schema index by name / code (-1 = absent).
    fn sidx_of_name(self: &SchemaCatalog, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.s_n {
            if str_eq(self.s_names.get(i), name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
    fn sidx_of_code(self: &SchemaCatalog, code: u64) -> i64 {
        if code == 0u64 { return -1i64; }
        let mut i: i64 = 0i64;
        while i < self.s_n {
            if self.s_codes.get(i) == code { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
    // Internal: field index within schema `si` (-1 = absent).
    fn fidx(self: &SchemaCatalog, si: i64, fname: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.f_n {
            if self.f_owner.get(i) == si && str_eq(self.f_names.get(i), fname) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
    // ── Builder API (the catalog-entry representation; emitted by macros) ──
    // Register a schema (name + its `code(…)` value). Idempotent by name.
    // Backfills any edge fields whose target name matches (so multi-blob
    // aggregation — the decl-site annotation route — is order-independent).
    pub fn add_schema(self: &mut SchemaCatalog, name: str, code: u64) {
        if self.sidx_of_name(name) >= 0i64 { return; }
        if self.s_n >= CAT_SCHEMAS { return; }
        self.s_names.push(name);
        self.s_codes.push(code);
        self.s_n = self.s_n + 1i64;
        let mut i: i64 = 0i64;
        while i < self.f_n {
            if self.f_kinds.get(i) == (FK_EDGE as i64) && self.f_targets.get(i) == 0u64
               && str_eq(self.f_tnames.get(i), name) {
                self.f_targets.set(i, code);
            }
            i = i + 1i64;
        }
    }

    // Register a SCALAR (or erased) field: `ty` ∈ i64/f64/bool/str/any
    // (canonical value-type names; the integer/float families are already
    // collapsed by the emitter). Unknown ty names register as erased.
    pub fn add_field(self: &mut SchemaCatalog, sname: str, field: str, key: i64, ty: str) {
        let si: i64 = self.sidx_of_name(sname);
        if si < 0i64 { return; }
        if self.f_n >= CAT_FIELDS { return; }
        let mut k: i32 = FK_SCALAR;
        let mut t: i32 = EL_TY_INT();
        if str_eq(ty, "i64")      { t = EL_TY_INT(); }
        else if str_eq(ty, "f64") { t = EL_TY_FLT(); }
        else if str_eq(ty, "bool"){ t = EL_TY_BOOL(); }
        else if str_eq(ty, "str") { t = EL_TY_STR(); }
        else                      { k = FK_ANY; }
        self.f_owner.push(si);
        self.f_names.push(field);
        self.f_keys.push(key);
        self.f_tys.push(t as i64);
        self.f_kinds.push(k as i64);
        self.f_targets.push(0u64);
        self.f_tnames.push("");
        self.f_n = self.f_n + 1i64;
    }

    // Register an EDGE field (`WRef<Target>` — by convention holds a Writ
    // ARRAY of Target objects OR a SINGLE Target object; iteration adapts to
    // the runtime shape). A target not yet registered stays code 0 and is
    // BACKFILLED when its schema arrives (add_schema) — a target never
    // registered is diagnosed on use.
    // SCALAR-ELEMENT arrays (I2): a `target` naming a PRIMITIVE type
    // (str/i64 family/f64/bool — `el_ret_class`-classifiable) registers an
    // FK_EARR field instead: the value is a Writ array of SCALARS, and the
    // element EL type is recorded in `f_tys`. Both emission routes (the
    // schema_catalog! macro and the future decl-site annotation) use the SAME
    // blob entry shape — {"ty":"edge","target":"<name>"} — the name decides.
    pub fn add_edge(self: &mut SchemaCatalog, sname: str, field: str, key: i64, target: str) {
        let si: i64 = self.sidx_of_name(sname);
        if si < 0i64 { return; }
        if self.f_n >= CAT_FIELDS { return; }
        let scls: i32 = el_ret_class(target);
        if scls >= 0i32 {
            self.f_owner.push(si);
            self.f_names.push(field);
            self.f_keys.push(key);
            self.f_tys.push(scls as i64);
            self.f_kinds.push(FK_EARR as i64);
            self.f_targets.push(0u64);
            self.f_tnames.push(target);
            self.f_n = self.f_n + 1i64;
            return;
        }
        let ti: i64 = self.sidx_of_name(target);
        let tcode: u64 = if ti >= 0i64 { self.s_codes.get(ti) } else { 0u64 };
        self.f_owner.push(si);
        self.f_names.push(field);
        self.f_keys.push(key);
        self.f_tys.push(EL_TY_INT() as i64);
        self.f_kinds.push(FK_EDGE as i64);
        self.f_targets.push(tcode);
        self.f_tnames.push(target);
        self.f_n = self.f_n + 1i64;
    }

    // ── The RODATA channel (ADR queue-2 §5 — the designated metadata path) ──
    // annotation/macro → metaprog hook → rodata Writ blob → runtime view.
    // `schema_catalog!` emits a `@{…}` static Writ blob (content-deduped
    // rodata) with the GENERIC typed-metadata-entry envelope:
    //
    //   { "v": 1, "entries": [
    //       { "kind": "schema", "name": "Emp", "code": <u64>,
    //         "fields": [ { "name": "age", "key": 1, "ty": "i64" },
    //                     { "name": "emps", "key": 2, "ty": "edge", "target": "Emp" } ] },
    //       …                                    // "fn" entries etc. ride the
    //   ] }                                      // same array in later slices
    //
    // and this ctor INDEXES it (two passes: schemas, then fields — edge
    // targets resolve by name against pass 1). The `str` views point INTO the
    // rodata blob: zero-copy, 'static. Unknown entry kinds are skipped
    // (forward-compatible envelope).
    pub fn from_static(blob: WritStatic) -> SchemaCatalog {
        let mut c: SchemaCatalog = SchemaCatalog::new();
        c.merge_static(blob);
        return c;
    }

    // Aggregate ANOTHER metadata blob into this catalog (the decl-site
    // annotation route: one per-schema blob per decl, merged at the pickup
    // point). Order-independent: edge targets resolving to a schema merged
    // LATER are backfilled by add_schema.
    pub fn merge_static(self: &mut SchemaCatalog, blob: WritStatic) {
        let c: &mut SchemaCatalog = self;
        let vw: WView2 = wview2_from_ptr(blob.ptr);
        let root: WAny = vw.root();
        let ents: WAny = vw.map_get(root, "entries");
        let n: u64 = vw.array_len(ents);
        // pass 1 — schema entries
        let mut i: u64 = 0u64;
        while i < n {
            let e: WAny = vw.array_get(ents, i);
            if str_eq(sview2_str(vw.get_str_view(vw.map_get(e, "kind"))), "schema") {
                c.add_schema(sview2_str(vw.get_str_view(vw.map_get(e, "name"))),
                             vw.get_u64(vw.map_get(e, "code")));
            }
            i = i + 1u64;
        }
        // pass 2 — fields (edge targets now resolvable)
        let mut j: u64 = 0u64;
        while j < n {
            let e2: WAny = vw.array_get(ents, j);
            if str_eq(sview2_str(vw.get_str_view(vw.map_get(e2, "kind"))), "schema") {
                let sname: str = sview2_str(vw.get_str_view(vw.map_get(e2, "name")));
                let flds: WAny = vw.map_get(e2, "fields");
                let nf: u64 = vw.array_len(flds);
                let mut k: u64 = 0u64;
                while k < nf {
                    let f: WAny = vw.array_get(flds, k);
                    let fname: str = sview2_str(vw.get_str_view(vw.map_get(f, "name")));
                    let key: i64 = vw.get_int(vw.map_get(f, "key"));
                    let ty: str = sview2_str(vw.get_str_view(vw.map_get(f, "ty")));
                    if str_eq(ty, "edge") {
                        c.add_edge(sname, fname, key,
                                   sview2_str(vw.get_str_view(vw.map_get(f, "target"))));
                    } else {
                        c.add_field(sname, fname, key, ty);
                    }
                    k = k + 1u64;
                }
            }
            j = j + 1u64;
        }
    }

    // ── Probe API (tests / tooling) ────────────────────────────────────────
    // The registered code of schema `name` (0 = not in the catalog).
    pub fn schema_code(self: &SchemaCatalog, name: str) -> u64 {
        let si: i64 = self.sidx_of_name(name);
        if si < 0i64 { return 0u64; }
        return self.s_codes.get(si);
    }
    // The TOM key of `schema.field` (-1 = unknown).
    pub fn field_key(self: &SchemaCatalog, sname: str, field: str) -> i64 {
        let si: i64 = self.sidx_of_name(sname);
        if si < 0i64 { return -1i64; }
        let fi: i64 = self.fidx(si, field);
        if fi < 0i64 { return -1i64; }
        return self.f_keys.get(fi);
    }
    // The value-type name of `schema.field`: "i64"/"f64"/"bool"/"str" for
    // scalars, "edge" for WRef<S> fields, "arr:i64"/"arr:f64"/"arr:bool"/
    // "arr:str" for scalar-element array edges, "any" for erased, "" unknown.
    pub fn field_ty(self: &SchemaCatalog, sname: str, field: str) -> str {
        let si: i64 = self.sidx_of_name(sname);
        if si < 0i64 { return ""; }
        let fi: i64 = self.fidx(si, field);
        if fi < 0i64 { return ""; }
        if self.f_kinds.get(fi) == (FK_EDGE as i64) { return "edge"; }
        if self.f_kinds.get(fi) == (FK_EARR as i64) {
            let t2: i32 = self.f_tys.get(fi) as i32;
            if t2 == EL_TY_STR()  { return "arr:str"; }
            if t2 == EL_TY_BOOL() { return "arr:bool"; }
            if t2 == EL_TY_FLT()  { return "arr:f64"; }
            return "arr:i64";
        }
        if self.f_kinds.get(fi) == (FK_ANY as i64)  { return "any"; }
        let t: i32 = self.f_tys.get(fi) as i32;
        if t == EL_TY_STR()  { return "str"; }
        if t == EL_TY_BOOL() { return "bool"; }
        if t == EL_TY_FLT()  { return "f64"; }
        return "i64";
    }
}

// Element-wise copy (a Tpl owns its catalog snapshot; compile-once/run-many
// must not depend on the caller keeping the source catalog alive).
fn catalog_clone(src: &SchemaCatalog) -> SchemaCatalog {
    let mut c: SchemaCatalog = SchemaCatalog::new();
    let mut i: i64 = 0i64;
    while i < src.s_n {
        c.s_names.push(src.s_names.get(i));
        c.s_codes.push(src.s_codes.get(i));
        i = i + 1i64;
    }
    c.s_n = src.s_n;
    let mut j: i64 = 0i64;
    while j < src.f_n {
        c.f_owner.push(src.f_owner.get(j));
        c.f_names.push(src.f_names.get(j));
        c.f_keys.push(src.f_keys.get(j));
        c.f_tys.push(src.f_tys.get(j));
        c.f_kinds.push(src.f_kinds.get(j));
        c.f_targets.push(src.f_targets.get(j));
        c.f_tnames.push(src.f_tnames.get(j));
        j = j + 1i64;
    }
    c.f_n = src.f_n;
    return c;
}

// ═══════════════════════════════════════════════════════════════════════════
// QEnv — name → value/source bindings (ADR §3). Binds schema'd Writ objects
// (bind_node — the schema code is read off the object's TOM) and scalar
// params. `str` bindings are borrowed views: the caller keeps the source
// alive across `render` (string literals are 'static and always fine).
// ═══════════════════════════════════════════════════════════════════════════

const QB_I64:   i32 = 1i32;
const QB_F64:   i32 = 2i32;
const QB_BOOL:  i32 = 3i32;
const QB_STR:   i32 = 4i32;
const QB_NODE:  i32 = 5i32;
const QB_SRC:   i32 = 6i32;   // a query SOURCE: a Writ ARRAY of schema'd rows
const QB_ENODE: i32 = 7i32;   // an ERASED node (lenient, ADR §4): fields resolve
                              // at runtime by NAME; misses read as Null
const QB_ESRC:  i32 = 8i32;   // an ERASED source: a Writ array of lenient rows

const QENV_CAP: i64 = 24i64;
// UDF/UDA registry capacities (metadata tables — rows are Vec-backed).
const QENV_FNS:     i64 = 8i64;
const QENV_FN_ARGS: i64 = 4i64;   // max declared args per UDF
const QENV_AGGS:    i64 = 4i64;

pub struct QEnv {
    names: [str; 24],
    kinds: [i32; 24],
    ivals: [i64; 24],
    fvals: [f64; 24],
    bvals: [bool; 24],
    svals: [str; 24],
    words: [i64; 24],   // node/source bindings: the WAny ref word
    codes: [u64; 24],   // node bindings: the object's schema code
    n:     i64,
    // ── UDF registry (ADR §6) — name + ptr + DECLARED signature ──────────
    f_names: [str; 8],
    f_ptrs:  [QFn; 8],
    f_arity: [i64; 8],
    f_args:  [i32; 32],   // flattened [fn][arg] EL types (QENV_FN_ARGS stride)
    f_ret:   [i32; 8],    // EL return type
    f_n:     i64,
    // ── UDA registry — init/step/fin triple + declared arg/ret EL types ──
    a_names: [str; 4],
    a_init:  [QAggInit; 4],
    a_step:  [QAggStep; 4],
    a_fin:   [QAggFin; 4],
    a_argty: [i32; 4],
    a_ret:   [i32; 4],
    a_n:     i64,
}

impl QEnv {
    pub fn new() -> QEnv {
        let dfn: QFn      = qfn_nop;
        let din: QAggInit = qagg_init_nop;
        let dst: QAggStep = qagg_step_nop;
        let dfi: QAggFin  = qagg_fin_nop;
        return QEnv {
            names: [""; 24], kinds: [0i32; 24], ivals: [0i64; 24],
            fvals: [0.0f64; 24], bvals: [false; 24], svals: [""; 24],
            words: [0i64; 24], codes: [0u64; 24], n: 0i64,
            f_names: [""; 8], f_ptrs: [dfn; 8], f_arity: [0i64; 8],
            f_args: [0i32; 32], f_ret: [0i32; 8], f_n: 0i64,
            a_names: [""; 4], a_init: [din; 4], a_step: [dst; 4],
            a_fin: [dfi; 4], a_argty: [0i32; 4], a_ret: [0i32; 4], a_n: 0i64,
        };
    }

    fn find(self: &QEnv, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.n {
            if str_eq(self.names[i], name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
    // Rebind-aware slot allocation (last write wins per name).
    fn slot(self: &mut QEnv, name: str) -> i64 {
        let i: i64 = self.find(name);
        if i >= 0i64 { return i; }
        if self.n >= QENV_CAP { return -1i64; }
        self.names[self.n] = name;
        self.n = self.n + 1i64;
        return self.n - 1i64;
    }

    // Bind a schema'd Writ OBJECT (a WAny ref to a schema-stamped TOM). The
    // schema code is read off the object; a non-schema value binds with code 0
    // and is diagnosed by the strict checker on first use.
    pub fn bind_node(self: &mut QEnv, name: str, node: WAny) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_NODE;
        self.words[i] = node.raw();
        self.codes[i] = node_schema_code(node);
    }
    pub fn bind_i64(self: &mut QEnv, name: str, v: i64) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_I64;
        self.ivals[i] = v;
    }
    pub fn bind_f64(self: &mut QEnv, name: str, v: f64) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_F64;
        self.fvals[i] = v;
    }
    pub fn bind_bool(self: &mut QEnv, name: str, v: bool) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_BOOL;
        self.bvals[i] = v;
    }
    pub fn bind_str(self: &mut QEnv, name: str, v: str) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_STR;
        self.svals[i] = v;
    }

    // Bind a query SOURCE: a Writ ARRAY of schema'd rows (`from <name> v`
    // scans it). The element schema is resolved LIVE at `run` (off the first
    // element's stamped code) — an EMPTY array binds fine and yields no rows.
    // The caller keeps the backing doc alive across `run`.
    pub fn bind_source(self: &mut QEnv, name: str, arr: WAny) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_SRC;
        self.words[i] = arr.raw();
        self.codes[i] = 0u64;
    }

    // ── LENIENT binds (ADR §4, the D4 queue-2 half) ─────────────────────────
    // Bind an ERASED node: `name.field` resolves at RUNTIME by name — a
    // string-keyed Writ map gets by key; a schema-stamped TOM whose schema is
    // in the catalog gets by the cataloged key; anything else (missing key,
    // unknown schema, non-object) reads as RtVal::Null, which propagates
    // CEL-style through operators. No catalog entry is required.
    pub fn bind_node_erased(self: &mut QEnv, name: str, node: WAny) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_ENODE;
        self.words[i] = node.raw();
        self.codes[i] = 0u64;
    }

    // Bind an ERASED source: a Writ ARRAY whose elements are lenient rows
    // (string-keyed maps / arbitrary Writ values). Scans bind the row var
    // leniently; field types are unknown at compile, so lenient rows never
    // serve as HASH-join keys (such joins take the loop tier — documented).
    pub fn bind_source_erased(self: &mut QEnv, name: str, arr: WAny) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_ESRC;
        self.words[i] = arr.raw();
        self.codes[i] = 0u64;
    }

    // ── UDF/UDA registration (ADR §6) ───────────────────────────────────────
    // Register a scalar UDF with its DECLARED signature: `args` are EL type
    // names ("i64"/"f64"/"bool"/"str", max 4), `ret` likewise. The checker
    // resolves calls against builtins FIRST, then this registry.
    // Re-registering a name overwrites it. Returns FALSE (and registers
    // nothing) on an out-of-lattice type name, more than 4 declared args, or
    // a full registry — never a silent no-op (I3; the I2 behavior was a
    // silent drop, which made the later "unknown function" error misleading).
    pub fn register_fn(self: &mut QEnv, name: str, f: QFn, args: &[str], ret: str) -> bool {
        let rc: i32 = el_ret_class(ret);
        if rc < 0i32 { return false; }
        let na: i64 = args.len();
        if na > QENV_FN_ARGS { return false; }
        let mut ats: [i32; 4] = [0i32; 4];
        let mut i: i64 = 0i64;
        while i < na {
            let ac: i32 = el_ret_class(args[i]);
            if ac < 0i32 { return false; }
            ats[i] = ac;
            i = i + 1i64;
        }
        let mut fi: i64 = self.find_fn(name);
        if fi < 0i64 {
            if self.f_n >= QENV_FNS { return false; }
            fi = self.f_n;
            self.f_n = self.f_n + 1i64;
        }
        self.f_names[fi] = name;
        self.f_ptrs[fi]  = f;
        self.f_arity[fi] = na;
        self.f_ret[fi]   = rc;
        let mut k: i64 = 0i64;
        while k < na { self.f_args[fi * QENV_FN_ARGS + k] = ats[k]; k = k + 1i64; }
        return true;
    }

    fn find_fn(self: &QEnv, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.f_n {
            if str_eq(self.f_names[i], name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }

    // Register a UDA: init() → acc, step(acc, arg) → acc, fin(acc) → result.
    // `arg_ty`/`ret_ty` are the DECLARED EL types of the aggregate argument
    // and the finalized result. Builtin aggregate names shadow UDAs.
    // Returns FALSE (nothing registered) on an out-of-lattice type name or a
    // full registry (same contract as register_fn).
    pub fn register_agg(self: &mut QEnv, name: str, init: QAggInit, step: QAggStep,
                        fin: QAggFin, arg_ty: str, ret_ty: str) -> bool {
        let ac: i32 = el_ret_class(arg_ty);
        let rc: i32 = el_ret_class(ret_ty);
        if ac < 0i32 || rc < 0i32 { return false; }
        let mut ai: i64 = self.find_agg(name);
        if ai < 0i64 {
            if self.a_n >= QENV_AGGS { return false; }
            ai = self.a_n;
            self.a_n = self.a_n + 1i64;
        }
        self.a_names[ai] = name;
        self.a_init[ai]  = init;
        self.a_step[ai]  = step;
        self.a_fin[ai]   = fin;
        self.a_argty[ai] = ac;
        self.a_ret[ai]   = rc;
        return true;
    }

    fn find_agg(self: &QEnv, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.a_n {
            if str_eq(self.a_names[i], name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Writ TOM access — the SAME reads the static schema accessors compile to
// (WMap<Wu6,WAny>::get by key code + WritField conversions).
// ═══════════════════════════════════════════════════════════════════════════

// Bind a Ref WAny to its backing TOM (points into the owning arena, which
// outlives every view taken here — the ast.logos / make_schema idiom).
fn tom_at<'a>(w: WAny) -> &'a WMap<Wu6, WAny> {
    let p: *const u8 = w.resolve();
    return unsafe { &*(p as *const WMap<Wu6, WAny>) };
}

// The schema code stamped on a WAny's pointee TOM (0 = null / not a TOM).
fn node_schema_code(w: WAny) -> u64 {
    if w.is_null() { return 0u64; }
    if !w.is_ref() { return 0u64; }
    if !w.is_tinymap() { return 0u64; }
    let m: &WMap<Wu6, WAny> = tom_at(w);
    return m.schema_type_code();
}

// A WString pointee's bytes as a `str` view (provenance-laundering: the input
// is a RAW resolve()d pointer, so the view ties to the owning arena, not to a
// local WAny — the generated parsers' wstr_as_str idiom).
fn wstr_at<'a>(p: *const u8) -> str {
    if (p as i64) == 0i64 { return ""; }
    let ws: &WString = unsafe { &*(p as *const WString) };
    return ws.as_str();
}

// A string-typed WAny's payload ("" for null/non-string).
fn wany_str(v: WAny) -> str {
    if !v.is_string() { return ""; }
    return wstr_at(v.resolve());
}

// A WAny value → RtVal by VALUE SHAPE: scalars map to their scalar variants,
// anything else referencable becomes a Node handle. This is the ELEMENT
// conversion for iterated Writ arrays — it makes scalar-element arrays
// (WRef<str> etc., FK_EARR) and schema'd-node arrays iterate uniformly.
fn wany_to_rt(v: WAny) -> RtVal {
    if v.is_null()   { return RtVal::Null; }
    if v.is_string() { return RtVal::S(wstr_at(v.resolve())); }
    if v.is_bool()   { return RtVal::B(v.as_bool()); }
    if v.is_float()  { return RtVal::F(v.as_f64()); }
    if v.is_int()    { return RtVal::I(v.as_i64()); }
    return RtVal::Node(v);
}

// ═══════════════════════════════════════════════════════════════════════════
// RtVal — the runtime scalar (ADR §2). PUBLIC since I2: the UDF/UDA registry
// signature is RtVal-based (ADR §6 — `fn(&[RtVal]) -> RtVal`), so user
// functions match on / construct it directly. Cheap to copy (all payloads are
// word-sized views/handles). `S` carries a VIEW — a UDF returning `S` must
// return a view that outlives the call (a literal, or a view into an input).
// ═══════════════════════════════════════════════════════════════════════════
pub enum RtVal {
    I(i64),
    F(f64),
    B(bool),
    S(str),
    Node(WAny),
    Null,
}
impl Copy for RtVal {}

// ── UDF/UDA function-pointer shapes (ADR §6, MVP) ───────────────────────────
// UDF: eval'd args in, one value out. UDA: init() seeds the accumulator,
// step(acc, arg) folds one row, fin(acc) finalizes (pass an identity fn when
// no finalization is needed).
pub type QFn      = fn(&[RtVal]) -> RtVal;
pub type QAggInit = fn() -> RtVal;
pub type QAggStep = fn(RtVal, RtVal) -> RtVal;
pub type QAggFin  = fn(RtVal) -> RtVal;

// Registry no-op seeds (the fixed-slot tables need an initial value).
fn qfn_nop(_a: &[RtVal]) -> RtVal { return RtVal::Null; }
fn qagg_init_nop() -> RtVal { return RtVal::Null; }
fn qagg_step_nop(acc: RtVal, _v: RtVal) -> RtVal { return acc; }
fn qagg_fin_nop(acc: RtVal) -> RtVal { return acc; }

fn rt_kind(v: RtVal) -> i32 {
    match v {
        RtVal::I(_x)    => { return 1i32; }
        RtVal::F(_x)    => { return 2i32; }
        RtVal::B(_x)    => { return 3i32; }
        RtVal::S(_x)    => { return 4i32; }
        RtVal::Node(_x) => { return 5i32; }
        RtVal::Null     => { return 0i32; }
    }
}
fn rt_i(v: RtVal) -> i64 {
    match v {
        RtVal::I(x) => { return x; }
        RtVal::F(x) => { return x as i64; }
        RtVal::B(b) => { if b { return 1i64; } return 0i64; }
        _ => { return 0i64; }
    }
}
fn rt_f(v: RtVal) -> f64 {
    match v {
        RtVal::I(x) => { return x as f64; }
        RtVal::F(x) => { return x; }
        _ => { return 0.0f64; }
    }
}
fn rt_b(v: RtVal) -> bool {
    match v { RtVal::B(b) => { return b; } _ => { return false; } }
}
fn rt_s(v: RtVal) -> str {
    match v { RtVal::S(s) => { return s; } _ => { return ""; } }
}
fn rt_node(v: RtVal) -> WAny {
    match v { RtVal::Node(w) => { return w; } _ => { return WAny::Ref(0i64 as *const u8); } }
}

// Jinja truthiness (mirrors the static emit_truthy rules).
fn rt_truthy(v: RtVal) -> bool {
    match v {
        RtVal::B(b)     => { return b; }
        RtVal::I(x)     => { return x != 0i64; }
        RtVal::F(x)     => { return x != 0.0f64; }
        RtVal::S(s)     => { return s.len() != 0i64; }
        RtVal::Node(_w) => { return true; }
        RtVal::Null     => { return false; }
    }
}

// Value equality (post-check the operands are same-class; defensive false).
fn rt_eq(l: RtVal, r: RtVal) -> bool {
    let lk: i32 = rt_kind(l);
    let rk: i32 = rt_kind(r);
    if lk == 1i32 && rk == 1i32 { return rt_i(l) == rt_i(r); }
    if (lk == 1i32 || lk == 2i32) && (rk == 1i32 || rk == 2i32) { return rt_f(l) == rt_f(r); }
    if lk == 4i32 && rk == 4i32 { return str_eq(rt_s(l), rt_s(r)); }
    if lk == 3i32 && rk == 3i32 { return rt_b(l) == rt_b(r); }
    if lk == 0i32 && rk == 0i32 { return true; }
    return false;
}

// Append a value's rendered text ({{ … }} formatting: i64, %g f64, bare str,
// true/false — the static queue's conventions).
fn rt_push(out: &mut String, v: RtVal) {
    match v {
        RtVal::I(x) => { out.push_i64(x); }
        RtVal::F(x) => {
            let s: String = wql_f64_to_str(x);
            out.push_str(sstr(&s));
        }
        RtVal::B(b) => { if b { out.push_str("true"); } else { out.push_str("false"); } }
        RtVal::S(s) => { out.push_str(s); }
        _ => { }   // Node/Null — the checker rejects these in {{ … }}
    }
}

// Intern an owned String into the render scratch arena; the returned view
// stays valid for the rest of the render (Writ segments never move).
fn intern(scratch: &Writ, s: &String) -> str {
    let ws: &WString = scratch.wstring(sstr(s));
    return ws.as_str();
}

// Intern a borrowed view into an arena (QRows string materialization).
fn intern_str(arena: &Writ, s: str) -> str {
    let ws: &WString = arena.wstring(s);
    return ws.as_str();
}

// ═══════════════════════════════════════════════════════════════════════════
// The CHECKER (ADR §4, strict) — an SExpr/TStmt walk over (catalog + env
// declarations + template-local bindings). Two phases share this walker:
//   compile phase (strict=false): env is empty; unresolvable roots type as
//     UNKNOWN and every check that needs them is deferred;
//   render phase (strict=true): every root must resolve; full lattice rules.
// ═══════════════════════════════════════════════════════════════════════════

// Checked-type tags. CT_INT..CT_FLT deliberately EQUAL the EL_TY_* values so
// catalog scalar types and builtin return types map across directly.
const CT_INT:     i32 = 0i32;
const CT_STR:     i32 = 1i32;
const CT_BOOL:    i32 = 2i32;
const CT_FLT:     i32 = 3i32;
const CT_NODE:    i32 = 10i32;   // a schema'd object; code = schema code
const CT_ARR:     i32 = 11i32;   // a collection edge; code = element schema code
const CT_UNKNOWN: i32 = 12i32;   // compile phase only (root not yet bindable)
const CT_SARR:    i32 = 13i32;   // a SCALAR-element array edge; code = element
                                 // EL tag (CT_INT..CT_FLT) as u64 (FK_EARR)
const CT_RELROW:  i32 = 14i32;   // a rel row var (I3); code = rel registry idx.
                                 // Columns read as `<var>.<col>` DOTTED idents
                                 // (the compile-time rel-field rewrite).
const CT_DYN:     i32 = 15i32;   // a LENIENT value (ADR §4): type unknown at
                                 // check time; runtime value may be Null.
const CT_DYNSRC:  i32 = 16i32;   // an ERASED source/collection: rows bind DYN.

struct CTy { t: i32, code: u64 }
impl Copy for CTy {}

fn ct(t: i32) -> CTy { return CTy { t: t, code: 0u64 }; }
fn ct_is_num(t: i32) -> bool { return t == CT_INT || t == CT_FLT; }
fn ct_is_obj(t: i32) -> bool {
    return t == CT_NODE || t == CT_ARR || t == CT_SARR
        || t == CT_RELROW || t == CT_DYNSRC;
}
// A tag every scalar-position check should wave through: the value is typed
// at RUNTIME (compile-phase unknown, or a lenient value).
fn ct_is_open(t: i32) -> bool { return t == CT_UNKNOWN || t == CT_DYN; }

// ═══════════════════════════════════════════════════════════════════════════
// QRelReg — the compile-time REL REGISTRY (I3): declared rel names + typed
// columns + the SCC condensation results. Owned by the Query (names/columns
// are str views into the Query's own IR doc). The runtime counterpart of the
// static walker's MacroParams rel section.
// ═══════════════════════════════════════════════════════════════════════════
const QREL_MAX:  i64 = 8i64;    // static parity (RQREL_MAX)
const QRELC_MAX: i64 = 64i64;   // flat column table (8 rels × 8 cols)

pub struct QRelReg {
    n:      i64,
    names:  [str; 8],
    ncols:  [i64; 8],
    coff:   [i64; 8],     // rel → first index into the flat column tables
    cnames: Vec<str>,     // flat, declaration order (Vec-backed: the Query
    ctys:   Vec<i64>,     // must stay SMALL — big by-value aggregates
                          // scalarize pathologically in codegen; CT_* tags)
    // SCC condensation (compute_rel_scc results, copied flat)
    nscc:  i64,
    comp:  [i64; 8],
    rec:   [bool; 8],
    order: [i64; 8],
}

fn qrelreg_new() -> QRelReg {
    return QRelReg {
        n: 0i64, names: [""; 8], ncols: [0i64; 8], coff: [0i64; 8],
        cnames: vec_new::<str>(), ctys: vec_new::<i64>(),
        nscc: 0i64, comp: [0i64; 8], rec: [false; 8], order: [0i64; 8],
    };
}

// Rel index by name (-1 = not a rel).
fn qreg_find(reg: &QRelReg, name: str) -> i64 {
    let mut i: i64 = 0i64;
    while i < reg.n {
        if str_eq(reg.names[i], name) { return i; }
        i = i + 1i64;
    }
    return -1i64;
}

// Column index WITHIN rel `ri` (-1 = unknown column).
fn qreg_col(reg: &QRelReg, ri: i64, col: str) -> i64 {
    let off: i64 = reg.coff[ri];
    let mut c: i64 = 0i64;
    while c < reg.ncols[ri] {
        if str_eq(reg.cnames.get(off + c), col) { return c; }
        c = c + 1i64;
    }
    return -1i64;
}

// "{p, q}" — the member list of SCC `c` (declaration order) appended to `out`
// (the stratification diagnostics — mirrors the static walker's).
fn qreg_push_scc_members(out: &mut String, reg: &QRelReg, c: i64) {
    out.push_str("{");
    let mut first: bool = true;
    let mut i: i64 = 0i64;
    while i < reg.n {
        if reg.comp[i] == c {
            if !first { out.push_str(", "); }
            out.push_str(reg.names[i]);
            first = false;
        }
        i = i + 1i64;
    }
    out.push_str("}");
}

// Split a DOTTED rel-column ident "<var>.<col>" (the rel-field rewrite's
// output; user idents cannot contain '.'). Returns the dot index, -1 if none.
fn dotted_at(name: str) -> i64 {
    let n: i64 = name.len();
    let mut i: i64 = 0i64;
    while i < n {
        if str_byte_at(name, i) == 46u8 { return i; }
        i = i + 1i64;
    }
    return -1i64;
}
fn str_prefix(s: str, n: i64) -> str {
    return unsafe { str_from_raw(s.as_ptr(), n) };
}
fn str_suffix(s: str, from: i64) -> str {
    return unsafe { str_from_raw((s.as_ptr() as i64 + from) as *const u8, s.len() - from) };
}

// Error latch — the first failure wins; the message is the QError payload.
// `defer_unknown_fn`: BOTH compile phases set this (I3 registry unification)
// — an unknown call name may be a UDF registered on the env, which only
// exists at `run`/`render` (the strict phase then resolves builtin-first,
// registry-second — ONE resolution path for queries and templates).
struct Chk { failed: bool, msg: String, defer_unknown_fn: bool }
fn chk_new() -> Chk { return Chk { failed: false, msg: String::new(), defer_unknown_fn: false }; }
fn chk_err(c: Chk) -> QError { return QError { msg: c.msg }; }
fn chk_fail(c: &mut Chk, a: str, b: str, d: str, e: str, f: str) {
    if c.failed { return; }
    c.failed = true;
    c.msg.push_str(a);
    c.msg.push_str(b);
    c.msg.push_str(d);
    c.msg.push_str(e);
    c.msg.push_str(f);
}

// The human name of an SBin/SUn operator (diagnostics).
fn bin_op_name(op: i32) -> str {
    if op == OP_OR()  { return "||"; }
    if op == OP_AND() { return "&&"; }
    if op == OP_EQ()  { return "=="; }
    if op == OP_NE()  { return "!="; }
    if op == OP_LT()  { return "<"; }
    if op == OP_LE()  { return "<="; }
    if op == OP_GT()  { return ">"; }
    if op == OP_GE()  { return ">="; }
    if op == OP_ADD() { return "+"; }
    if op == OP_SUB() { return "-"; }
    if op == OP_MUL() { return "*"; }
    if op == OP_DIV() { return "/"; }
    return "%";
}

// Template-local CHECK bindings ({% for %} loop vars, {% set %} vars) —
// scoped: callers mark/rollback around bodies; lookups scan newest-first.
const CB_CAP: i64 = 40i64;
struct CBinds {
    names: [str; 40],
    tags:  [i32; 40],
    codes: [u64; 40],
    n:     i64,
}
fn cbinds_new() -> CBinds {
    return CBinds { names: [""; 40], tags: [0i32; 40], codes: [0u64; 40], n: 0i64 };
}
impl CBinds {
    fn bind(self: &mut CBinds, name: str, tag: i32, code: u64) {
        if self.n >= CB_CAP { return; }
        self.names[self.n] = name;
        self.tags[self.n]  = tag;
        self.codes[self.n] = code;
        self.n = self.n + 1i64;
    }
    fn find(self: &CBinds, name: str) -> i64 {
        let mut i: i64 = self.n - 1i64;
        while i >= 0i64 {
            if str_eq(self.names[i], name) { return i; }
            i = i - 1i64;
        }
        return -1i64;
    }
}

// The COLLECTION type of a bound source (QB_SRC word): CT_ARR{schema code}
// for schema'd rows, CT_SARR{elem tag} for scalar elements, CT_UNKNOWN for an
// EMPTY array (nothing to type — and nothing will be evaluated over it).
fn src_elem_ty(name: str, word: i64, cat: &SchemaCatalog, chk: &mut Chk) -> CTy {
    let av: WAny = WAny::ref_to(word as *const u8);
    if !av.is_array() {
        chk_fail(chk, "source '", name, "' is not bound to a Writ array", "", "");
        return ct(CT_UNKNOWN);
    }
    let arr: &WArray<WAny> = av.as_array();
    if arr.len() == 0i64 { return ct(CT_UNKNOWN); }   // empty source: zero rows
    let e0: WAny = arr.get(0i64);
    let code: u64 = node_schema_code(e0);
    if code != 0u64 {
        if cat.sidx_of_code(code) < 0i64 {
            chk_fail(chk, "source '", name,
                     "' has an element schema that is not in the catalog — add it to schema_catalog!",
                     "", "");
            return ct(CT_UNKNOWN);
        }
        return CTy { t: CT_ARR, code: code };
    }
    // Scalar elements: type off the first element's value shape.
    let ev: RtVal = wany_to_rt(e0);
    match ev {
        RtVal::S(_s) => { return CTy { t: CT_SARR, code: CT_STR as u64 }; }
        RtVal::B(_b) => { return CTy { t: CT_SARR, code: CT_BOOL as u64 }; }
        RtVal::F(_f) => { return CTy { t: CT_SARR, code: CT_FLT as u64 }; }
        RtVal::I(_i) => { return CTy { t: CT_SARR, code: CT_INT as u64 }; }
        _ => {
            chk_fail(chk, "source '", name,
                     "' elements are not schema'd Writ objects", "", "");
            return ct(CT_UNKNOWN);
        }
    }
}

// Resolve a ROOT name (bare ident / $param / loop var) to a checked type.
// DOTTED rel-column idents ("p.b" — the rel-field rewrite's output) resolve
// through the CT_RELROW binding of their root var against the rel registry.
fn check_root(name: str, cat: &SchemaCatalog, env: &QEnv, strict: bool,
              lb: &CBinds, chk: &mut Chk, reg: &QRelReg) -> CTy {
    let li: i64 = lb.find(name);
    if li >= 0i64 { return CTy { t: lb.tags[li], code: lb.codes[li] }; }
    let dot: i64 = dotted_at(name);
    if dot > 0i64 {
        let root: str = str_prefix(name, dot);
        let li2: i64 = lb.find(root);
        if li2 >= 0i64 && lb.tags[li2] == CT_RELROW {
            let ri: i64 = lb.codes[li2] as i64;
            let ci: i64 = qreg_col(reg, ri, str_suffix(name, dot + 1i64));
            if ci < 0i64 {
                // Unreachable post-rewrite (the rewrite validated columns);
                // defensive for hand-built IR.
                chk_fail(chk, "unknown column '", str_suffix(name, dot + 1i64),
                         "' on rel '", reg.names[ri], "'");
                return ct(CT_UNKNOWN);
            }
            return ct(reg.ctys.get(reg.coff[ri] + ci) as i32);
        }
        return ct(CT_UNKNOWN);
    }
    let ei: i64 = env.find(name);
    if ei >= 0i64 {
        let k: i32 = env.kinds[ei];
        if k == QB_I64  { return ct(CT_INT); }
        if k == QB_F64  { return ct(CT_FLT); }
        if k == QB_BOOL { return ct(CT_BOOL); }
        if k == QB_STR  { return ct(CT_STR); }
        if k == QB_NODE {
            if env.codes[ei] == 0u64 {
                chk_fail(chk, "variable '", name,
                         "' is not bound to a schema'd Writ object", "", "");
                return ct(CT_UNKNOWN);
            }
            if cat.sidx_of_code(env.codes[ei]) < 0i64 {
                chk_fail(chk, "variable '", name,
                         "' has a schema that is not in the catalog — add it to schema_catalog!",
                         "", "");
                return ct(CT_UNKNOWN);
            }
            return CTy { t: CT_NODE, code: env.codes[ei] };
        }
        if k == QB_SRC   { return src_elem_ty(name, env.words[ei], cat, chk); }
        if k == QB_ENODE { return ct(CT_DYN); }      // lenient root (ADR §4)
        if k == QB_ESRC  { return ct(CT_DYNSRC); }   // lenient collection
    }
    if strict {
        chk_fail(chk, "unknown variable '", name,
                 "' — bind it on the QEnv before render", "", "");
    }
    return ct(CT_UNKNOWN);
}

fn check_expr(e: SExpr, cat: &SchemaCatalog, env: &QEnv, strict: bool,
              lb: &CBinds, chk: &mut Chk, reg: &QRelReg) -> CTy {
    match e {
        SExpr::Lit(l) => {
            let v: WAny = l.val;
            if v.is_string() { return ct(CT_STR); }
            if v.is_bool()   { return ct(CT_BOOL); }
            if v.is_float()  { return ct(CT_FLT); }
            return ct(CT_INT);
        }
        SExpr::Param(p) => { return check_root(p.name, cat, env, strict, lb, chk, reg); }
        SExpr::Var(v)   => { return check_root(v.name, cat, env, strict, lb, chk, reg); }
        SExpr::Field(f) => {
            let base_ref: WRef<SExpr> = f.base;
            if base_ref.any().is_null() {
                return check_root(f.name, cat, env, strict, lb, chk, reg);
            }
            let bt: CTy = check_expr(f.base_expr(), cat, env, strict, lb, chk, reg);
            if chk.failed { return ct(CT_UNKNOWN); }
            if bt.t == CT_NODE {
                let si: i64 = cat.sidx_of_code(bt.code);
                if si < 0i64 {
                    chk_fail(chk, "field '", f.name,
                             "': the object's schema is not in the catalog", "", "");
                    return ct(CT_UNKNOWN);
                }
                let fi: i64 = cat.fidx(si, f.name);
                if fi < 0i64 {
                    chk_fail(chk, "unknown field '", f.name, "' on schema '",
                             cat.s_names.get(si), "'");
                    return ct(CT_UNKNOWN);
                }
                if cat.f_kinds.get(fi) == (FK_EDGE as i64) {
                    if cat.f_targets.get(fi) == 0u64 {
                        chk_fail(chk, "edge field '", f.name,
                                 "' targets a schema missing from the catalog", "", "");
                        return ct(CT_UNKNOWN);
                    }
                    return CTy { t: CT_ARR, code: cat.f_targets.get(fi) };
                }
                if cat.f_kinds.get(fi) == (FK_EARR as i64) {
                    // scalar-element array edge — CT tags equal EL tags on the
                    // scalar tier, so the catalog EL type maps across directly.
                    return CTy { t: CT_SARR, code: cat.f_tys.get(fi) as u64 };
                }
                if cat.f_kinds.get(fi) == (FK_ANY as i64) {
                    // WAny-typed field on a STRICT schema: resolves LENIENTLY
                    // (ADR §4) — value shape decided at runtime, may be Null.
                    return ct(CT_DYN);
                }
                return ct(cat.f_tys.get(fi) as i32);
            }
            if bt.t == CT_DYN {
                // Lenient base: the field resolves at RUNTIME by name
                // (field_read's map/TOM arms); a miss reads Null.
                return ct(CT_DYN);
            }
            if bt.t == CT_ARR || bt.t == CT_SARR || bt.t == CT_DYNSRC {
                chk_fail(chk, "field '", f.name,
                         "' is read through a collection edge — loop over it with {% for %} first",
                         "", "");
                return ct(CT_UNKNOWN);
            }
            if bt.t == CT_RELROW {
                // Unreachable post-rewrite (rel fields become dotted idents);
                // defensive for hand-built IR.
                chk_fail(chk, "field '", f.name,
                         "' is read off a rel row outside the rel rewrite", "", "");
                return ct(CT_UNKNOWN);
            }
            if bt.t == CT_UNKNOWN {
                // Compile phase: the base is unresolved. With LENIENT bindings
                // in the language the field may legitimately resolve at run
                // even when no catalog schema declares it — the strict phase
                // (which sees the env's binding kinds) owns the rejection.
                return ct(CT_UNKNOWN);
            }
            chk_fail(chk, "field access '.", f.name, "' on a scalar value", "", "");
            return ct(CT_UNKNOWN);
        }
        SExpr::Bin(b) => {
            let op: i32 = b.op;
            let lt: CTy = check_expr(b.lhs_expr(), cat, env, strict, lb, chk, reg);
            let rt: CTy = check_expr(b.rhs_expr(), cat, env, strict, lb, chk, reg);
            if chk.failed { return ct(CT_UNKNOWN); }
            if ct_is_obj(lt.t) || ct_is_obj(rt.t) {
                chk_fail(chk, "operator '", bin_op_name(op),
                         "' cannot be applied to an object", "", "");
                return ct(CT_UNKNOWN);
            }
            // A DYN operand (lenient) types at RUNTIME: comparisons stay BOOL
            // (Null compares false), arithmetic goes DYN (Null propagates) —
            // the ADR §4 table.
            let open: bool = ct_is_open(lt.t) || ct_is_open(rt.t);
            let dyn_op: bool = lt.t == CT_DYN || rt.t == CT_DYN;
            if op == OP_AND() || op == OP_OR() {
                if (lt.t != CT_BOOL && !ct_is_open(lt.t))
                   || (rt.t != CT_BOOL && !ct_is_open(rt.t)) {
                    chk_fail(chk, "'", bin_op_name(op), "' needs bool operands", "", "");
                    return ct(CT_UNKNOWN);
                }
                return ct(CT_BOOL);
            }
            if op == OP_EQ() || op == OP_NE() {
                if !open {
                    let ok: bool = (ct_is_num(lt.t) && ct_is_num(rt.t))
                                 || (lt.t == CT_STR && rt.t == CT_STR)
                                 || (lt.t == CT_BOOL && rt.t == CT_BOOL);
                    if !ok {
                        chk_fail(chk, "'", bin_op_name(op),
                                 "' compares values of different types", "", "");
                        return ct(CT_UNKNOWN);
                    }
                }
                return ct(CT_BOOL);
            }
            if op == OP_LT() || op == OP_LE() || op == OP_GT() || op == OP_GE() {
                if !open {
                    let ok2: bool = (ct_is_num(lt.t) && ct_is_num(rt.t))
                                  || (lt.t == CT_STR && rt.t == CT_STR);
                    if !ok2 {
                        chk_fail(chk, "'", bin_op_name(op),
                                 "' needs two numbers or two strings", "", "");
                        return ct(CT_UNKNOWN);
                    }
                }
                return ct(CT_BOOL);
            }
            if op == OP_ADD() {
                if lt.t == CT_STR || rt.t == CT_STR {
                    let other: i32 = if lt.t == CT_STR { rt.t } else { lt.t };
                    if other != CT_STR && !ct_is_open(other) {
                        chk_fail(chk, "'+' cannot mix a string with a number", "", "", "", "");
                        return ct(CT_UNKNOWN);
                    }
                    return ct(CT_STR);
                }
                // numeric add
                if (lt.t == CT_BOOL) || (rt.t == CT_BOOL) {
                    chk_fail(chk, "'+' needs numeric operands", "", "", "", "");
                    return ct(CT_UNKNOWN);
                }
                if dyn_op { return ct(CT_DYN); }
                if lt.t == CT_UNKNOWN || rt.t == CT_UNKNOWN { return ct(CT_UNKNOWN); }
                if lt.t == CT_FLT || rt.t == CT_FLT { return ct(CT_FLT); }
                return ct(CT_INT);
            }
            // SUB / MUL / DIV / MOD — numeric-only tier.
            if (!ct_is_open(lt.t) && !ct_is_num(lt.t))
               || (!ct_is_open(rt.t) && !ct_is_num(rt.t)) {
                chk_fail(chk, "'", bin_op_name(op), "' needs numeric operands", "", "");
                return ct(CT_UNKNOWN);
            }
            if op == OP_MOD() {
                if lt.t == CT_FLT || rt.t == CT_FLT {
                    chk_fail(chk, "'%' needs integer operands", "", "", "", "");
                    return ct(CT_UNKNOWN);
                }
                if dyn_op { return ct(CT_DYN); }
                if lt.t == CT_UNKNOWN || rt.t == CT_UNKNOWN { return ct(CT_UNKNOWN); }
                return ct(CT_INT);
            }
            if dyn_op { return ct(CT_DYN); }
            if lt.t == CT_UNKNOWN || rt.t == CT_UNKNOWN { return ct(CT_UNKNOWN); }
            if lt.t == CT_FLT || rt.t == CT_FLT { return ct(CT_FLT); }
            return ct(CT_INT);
        }
        SExpr::Un(u) => {
            let at: CTy = check_expr(u.arg_expr(), cat, env, strict, lb, chk, reg);
            if chk.failed { return ct(CT_UNKNOWN); }
            if u.op == OP_NOT() {
                if at.t != CT_BOOL && !ct_is_open(at.t) {
                    chk_fail(chk, "'!' needs a bool operand", "", "", "", "");
                    return ct(CT_UNKNOWN);
                }
                return ct(CT_BOOL);
            }
            // unary minus
            if !ct_is_open(at.t) && !ct_is_num(at.t) {
                chk_fail(chk, "unary '-' needs a numeric operand", "", "", "", "");
                return ct(CT_UNKNOWN);
            }
            return CTy { t: at.t, code: 0u64 };
        }
        SExpr::Cond(c) => {
            let cc: CTy = check_expr(c.cond_expr(), cat, env, strict, lb, chk, reg);
            if chk.failed { return ct(CT_UNKNOWN); }
            if ct_is_obj(cc.t) {
                chk_fail(chk, "an object is not a condition", "", "", "", "");
                return ct(CT_UNKNOWN);
            }
            let tt: CTy = check_expr(c.then_expr(), cat, env, strict, lb, chk, reg);
            let et: CTy = check_expr(c.else_expr(), cat, env, strict, lb, chk, reg);
            if chk.failed { return ct(CT_UNKNOWN); }
            if ct_is_obj(tt.t) || ct_is_obj(et.t) {
                chk_fail(chk, "a ternary branch cannot yield an object", "", "", "", "");
                return ct(CT_UNKNOWN);
            }
            if tt.t == CT_DYN || et.t == CT_DYN { return ct(CT_DYN); }
            if tt.t == CT_UNKNOWN { return et; }
            if et.t == CT_UNKNOWN { return tt; }
            if tt.t == et.t { return tt; }
            if ct_is_num(tt.t) && ct_is_num(et.t) { return ct(CT_FLT); }
            chk_fail(chk, "ternary branches have different types", "", "", "", "");
            return ct(CT_UNKNOWN);
        }
        SExpr::Call(c) => {
            let bfn: i32 = builtin_of_name(c.fn_name);
            if bfn != BFN_UNKNOWN() {
                let args: SExprArr = c.args_arr();
                if args.len() != builtin_arity(bfn) {
                    chk_fail(chk, "wrong number of arguments for '", c.fn_name, "'", "", "");
                    return ct(CT_UNKNOWN);
                }
                let mut i: i64 = 0i64;
                while i < args.len() {
                    let at2: CTy = check_expr(args.arg_at(i), cat, env, strict, lb, chk, reg);
                    if chk.failed { return ct(CT_UNKNOWN); }
                    // DYN args pass — at runtime any non-string argument
                    // (Null included) makes the builtin yield Null (ADR §4).
                    if at2.t != CT_STR && !ct_is_open(at2.t) {
                        chk_fail(chk, "'", c.fn_name, "' needs string arguments", "", "");
                        return ct(CT_UNKNOWN);
                    }
                    i = i + 1i64;
                }
                return ct(builtin_ret_ty(bfn));   // EL_TY_* == CT_* on the scalar tier
            }
            // Not a builtin: the UDF registry (builtin-first precedence, ADR §6).
            let ui: i64 = env.find_fn(c.fn_name);
            if ui >= 0i64 {
                let uargs: SExprArr = c.args_arr();
                if uargs.len() != env.f_arity[ui] {
                    chk_fail(chk, "wrong number of arguments for '", c.fn_name,
                             "' — the registered signature differs", "", "");
                    return ct(CT_UNKNOWN);
                }
                let mut ai: i64 = 0i64;
                while ai < uargs.len() {
                    let uat: CTy = check_expr(uargs.arg_at(ai), cat, env, strict, lb, chk, reg);
                    if chk.failed { return ct(CT_UNKNOWN); }
                    // EXACT match (no implicit numeric promotion): the UDF
                    // body pattern-matches the RtVal variant it declared.
                    // DYN (lenient) args pass UNCHECKED — the RtVal reaches
                    // the UDF as-is (its match owns the surprise).
                    let want: i32 = env.f_args[ui * QENV_FN_ARGS + ai];
                    if !ct_is_open(uat.t) && uat.t != want {
                        chk_fail(chk, "argument type mismatch for '", c.fn_name,
                                 "' — the registered signature differs", "", "");
                        return ct(CT_UNKNOWN);
                    }
                    ai = ai + 1i64;
                }
                return ct(env.f_ret[ui]);
            }
            // Unknown: EVERY compile phase defers (query AND template — I3
            // registry unification: the registry lives on the env, which only
            // exists at run/render); the STRICT phase rejects.
            if !strict && chk.defer_unknown_fn { return ct(CT_UNKNOWN); }
            chk_fail(chk, "unknown function '", c.fn_name,
                     "' — not a builtin (len/upper/lower/contains/starts_with) and not registered on the QEnv (register_fn)",
                     "", "");
            return ct(CT_UNKNOWN);
        }
        SExpr::Comp(_cp) => {
            chk_fail(chk, "comprehension expressions are not supported in the dynamic surface — use a rel block", "", "", "", "");
            return ct(CT_UNKNOWN);
        }
        SExpr::Tuple(_tp) => {
            chk_fail(chk, "tuple expressions are not supported in templates", "", "", "", "");
            return ct(CT_UNKNOWN);
        }
        _ => { return ct(CT_UNKNOWN); }
    }
}

// Statement-level check walk (scoped bodies via CBinds mark/rollback).
fn check_stmts(head: i64, cat: &SchemaCatalog, env: &QEnv, strict: bool,
               lb: &mut CBinds, chk: &mut Chk, reg: &QRelReg) {
    let mut cur: i64 = head;
    while cur != 0i64 && !chk.failed {
        let e: TStmt = WAny::ref_to(cur as *const u8).view::<TStmt>();
        match e {
            TStmt::Text(_t) => { }
            TStmt::Var(v) => {
                let t: CTy = check_expr(v.expr_expr(), cat, env, strict, lb, chk, reg);
                if !chk.failed && ct_is_obj(t.t) {
                    chk_fail(chk, "cannot interpolate an object — render its scalar fields instead",
                             "", "", "", "");
                }
            }
            TStmt::If(i) => {
                let c: CTy = check_expr(i.expr_expr(), cat, env, strict, lb, chk, reg);
                if !chk.failed && ct_is_obj(c.t) {
                    chk_fail(chk, "an object is not a condition", "", "", "", "");
                }
                let mark: i64 = lb.n;
                check_stmts(body_word(&i.body), cat, env, strict, lb, chk, reg);
                lb.n = mark;
                let altw: i64 = alt_word(&i.alt);
                if altw != 0i64 {
                    check_stmts(altw, cat, env, strict, lb, chk, reg);
                    lb.n = mark;
                }
            }
            TStmt::For(f) => {
                let it: CTy = check_expr(f.expr_expr(), cat, env, strict, lb, chk, reg);
                if !chk.failed {
                    let mark2: i64 = lb.n;
                    if it.t == CT_ARR {
                        lb.bind(f.var, CT_NODE, it.code);
                    } else if it.t == CT_SARR {
                        // scalar-element array: the loop var binds the SCALAR
                        lb.bind(f.var, it.code as i32, 0u64);
                    } else if it.t == CT_DYNSRC || it.t == CT_DYN {
                        // lenient collection: elements type at runtime; a
                        // non-array value iterates as an EMPTY loop (ADR §4)
                        lb.bind(f.var, CT_DYN, 0u64);
                    } else if it.t == CT_UNKNOWN {
                        lb.bind(f.var, CT_UNKNOWN, 0u64);
                    } else {
                        chk_fail(chk, "'{% for %}' needs a collection-valued edge field (a WRef<S> field holding a Writ array)",
                                 "", "", "", "");
                    }
                    if !chk.failed {
                        check_stmts(body_word(&f.body), cat, env, strict, lb, chk, reg);
                    }
                    lb.n = mark2;
                }
            }
            TStmt::Set(s) => {
                let t2: CTy = check_expr(s.expr_expr(), cat, env, strict, lb, chk, reg);
                if !chk.failed {
                    if ct_is_obj(t2.t) {
                        chk_fail(chk, "'{% set %}' of an object is not supported", "", "", "", "");
                    } else {
                        lb.bind(s.var, t2.t, t2.code);
                    }
                }
            }
        }
        cur = next_of_stmt(cur);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// OPTIMIZER REUSE — after parse, run the queue-1 `simplify_sexpr` IR→IR pass
// on every embedded expression, REBINDING each statement's expr edge to the
// simplified tree (render then walks the folded IR — `{{ 1 + 2 }}` renders
// from a single SLit).
// ═══════════════════════════════════════════════════════════════════════════
fn simplify_all(head: i64, h: &Writ) {
    let mut cur: i64 = head;
    while cur != 0i64 {
        let e: TStmt = WAny::ref_to(cur as *const u8).view::<TStmt>();
        match e {
            TStmt::Text(_t) => { }
            TStmt::Var(v) => { v.expr = simplify_sexpr(v.expr_expr(), h); }
            TStmt::Set(s) => { s.expr = simplify_sexpr(s.expr_expr(), h); }
            TStmt::If(i) => {
                i.expr = simplify_sexpr(i.expr_expr(), h);
                simplify_all(body_word(&i.body), h);
                let altw: i64 = alt_word(&i.alt);
                if altw != 0i64 { simplify_all(altw, h); }
            }
            TStmt::For(f) => {
                f.expr = simplify_sexpr(f.expr_expr(), h);
                simplify_all(body_word(&f.body), h);
            }
        }
        cur = next_of_stmt(cur);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// eval_sexpr — the tree-walk evaluator (ADR §7). Runs on CHECKED IR; data-
// shape surprises (unset fields, null edges) take the WritField-default path.
// ═══════════════════════════════════════════════════════════════════════════

// Render-time LOCAL bindings (loop vars / set vars) — newest-first lookup,
// mark/rollback scoping (the CBinds shape, but carrying VALUES).
struct RBinds {
    names: [str; 40],
    kinds: [i32; 40],   // QB_* (QB_NODE stores the ref word)
    ivals: [i64; 40],
    fvals: [f64; 40],
    bvals: [bool; 40],
    svals: [str; 40],
    words: [i64; 40],
    n:     i64,
}
fn rbinds_new() -> RBinds {
    return RBinds {
        names: [""; 40], kinds: [0i32; 40], ivals: [0i64; 40], fvals: [0.0f64; 40],
        bvals: [false; 40], svals: [""; 40], words: [0i64; 40], n: 0i64,
    };
}
impl RBinds {
    fn find(self: &RBinds, name: str) -> i64 {
        let mut i: i64 = self.n - 1i64;
        while i >= 0i64 {
            if str_eq(self.names[i], name) { return i; }
            i = i - 1i64;
        }
        return -1i64;
    }
    fn val(self: &RBinds, i: i64) -> RtVal {
        let k: i32 = self.kinds[i];
        if k == QB_I64  { return RtVal::I(self.ivals[i]); }
        if k == QB_F64  { return RtVal::F(self.fvals[i]); }
        if k == QB_BOOL { return RtVal::B(self.bvals[i]); }
        if k == QB_STR  { return RtVal::S(self.svals[i]); }
        if k == QB_NODE { return RtVal::Node(WAny::ref_to(self.words[i] as *const u8)); }
        return RtVal::Null;
    }
    // Push a binding holding `v` (scoping is the caller's mark/rollback).
    fn bind_val(self: &mut RBinds, name: str, v: RtVal) {
        if self.n >= 40i64 { return; }
        self.names[self.n] = name;
        self.set_val(self.n, v);
        self.n = self.n + 1i64;
    }
    // Overwrite slot `i`'s value (per-iteration loop-var rebind).
    fn set_val(self: &mut RBinds, i: i64, v: RtVal) {
        match v {
            RtVal::I(x) => { self.kinds[i] = QB_I64;  self.ivals[i] = x; }
            RtVal::F(x) => { self.kinds[i] = QB_F64;  self.fvals[i] = x; }
            RtVal::B(x) => { self.kinds[i] = QB_BOOL; self.bvals[i] = x; }
            RtVal::S(x) => { self.kinds[i] = QB_STR;  self.svals[i] = x; }
            RtVal::Node(w) => { self.kinds[i] = QB_NODE; self.words[i] = w.raw(); }
            RtVal::Null => { self.kinds[i] = 0i32; }
        }
    }
}

// A QEnv binding as an RtVal.
fn env_val(env: &QEnv, i: i64) -> RtVal {
    let k: i32 = env.kinds[i];
    if k == QB_I64   { return RtVal::I(env.ivals[i]); }
    if k == QB_F64   { return RtVal::F(env.fvals[i]); }
    if k == QB_BOOL  { return RtVal::B(env.bvals[i]); }
    if k == QB_STR   { return RtVal::S(env.svals[i]); }
    if k == QB_NODE  { return RtVal::Node(WAny::ref_to(env.words[i] as *const u8)); }
    if k == QB_SRC   { return RtVal::Node(WAny::ref_to(env.words[i] as *const u8)); }
    if k == QB_ENODE { return RtVal::Node(WAny::ref_to(env.words[i] as *const u8)); }
    if k == QB_ESRC  { return RtVal::Node(WAny::ref_to(env.words[i] as *const u8)); }
    return RtVal::Null;
}

// Root-name value: locals shadow the env. `lb` is a RAW pointer (provenance
// laundering): the returned RtVal's payloads are COPIES of word-sized views
// into arenas/rodata, never references into the RBinds storage itself, so the
// caller's &mut RBinds must not be pinned by the shared read here.
fn eval_root(name: str, env: &QEnv, lb: *const RBinds) -> RtVal {
    let lbv: &RBinds = unsafe { &*lb };
    let li: i64 = lbv.find(name);
    if li >= 0i64 { return lbv.val(li); }
    let ei: i64 = env.find(name);
    if ei >= 0i64 { return env_val(env, ei); }
    return RtVal::Null;
}

// One field read — the ONE dynamic read both tiers share (ADR §4):
//   • a STRING-KEYED Writ map (`is_map`, the lenient row shape) resolves the
//     field by NAME directly — no catalog; a missing key reads Null and the
//     value converts by VALUE SHAPE (wany_to_rt — "type surprise" keeps the
//     runtime shape, CEL-style);
//   • a schema-stamped TOM whose schema is in the catalog reads by the
//     cataloged key code — the SAME read the static schema accessors compile
//     to, WritField defaults included (schema'd data behaves schema'd even
//     under a lenient binding). FK_ANY (WAny-typed) fields convert by value
//     shape — unset reads Null (I3: I1 rejected these at check time);
//   • anything else (unknown schema, unknown field, non-object) reads Null.
// STRICT bindings never reach the Null arms (the checker resolved every
// field), so strict semantics are unchanged.
fn field_read(cat: &SchemaCatalog, w: WAny, fname: str) -> RtVal {
    if w.is_map() {
        let sm: &WMap<WString, WAny> = w.as_map();
        let sv: WAny = sm.get(fname);
        if sv.is_null() { return RtVal::Null; }
        return wany_to_rt(sv);
    }
    let code: u64 = node_schema_code(w);
    let si: i64 = cat.sidx_of_code(code);
    if si < 0i64 { return RtVal::Null; }
    let fi: i64 = cat.fidx(si, fname);
    if fi < 0i64 { return RtVal::Null; }
    let m: &WMap<Wu6, WAny> = tom_at(w);
    let v: WAny = m.get(cat.f_keys.get(fi) as u8);
    if cat.f_kinds.get(fi) == (FK_EDGE as i64) || cat.f_kinds.get(fi) == (FK_EARR as i64) {
        if v.is_null() { return RtVal::Null; }
        return RtVal::Node(v);
    }
    if cat.f_kinds.get(fi) == (FK_ANY as i64) { return wany_to_rt(v); }
    let t: i32 = cat.f_tys.get(fi) as i32;
    if t == EL_TY_STR()  { return RtVal::S(wany_str(v)); }
    if t == EL_TY_BOOL() { return RtVal::B(v.as_bool()); }
    if t == EL_TY_FLT()  { return RtVal::F(v.as_f64()); }
    return RtVal::I(v.as_i64());
}

fn eval_sexpr(e: SExpr, cat: &SchemaCatalog, env: &QEnv, lb: *const RBinds,
              scratch: &Writ) -> RtVal {
    match e {
        SExpr::Lit(l) => {
            let v: WAny = l.val;
            if v.is_string() { return RtVal::S(wany_str(v)); }
            if v.is_bool()   { return RtVal::B(v.as_bool()); }
            if v.is_float()  { return RtVal::F(v.as_f64()); }
            if v.is_null()   { return RtVal::Null; }
            return RtVal::I(v.as_i64());
        }
        SExpr::Param(p) => { return eval_root(p.name, env, lb); }
        SExpr::Var(vv)  => { return eval_root(vv.name, env, lb); }
        SExpr::Field(f) => {
            let base_ref: WRef<SExpr> = f.base;
            if base_ref.any().is_null() { return eval_root(f.name, env, lb); }
            let base: RtVal = eval_sexpr(f.base_expr(), cat, env, lb, scratch);
            match base {
                RtVal::Node(w) => { return field_read(cat, w, f.name); }
                _ => { return RtVal::Null; }
            }
        }
        SExpr::Bin(b) => {
            let op: i32 = b.op;
            // Short-circuit boolean tier.
            if op == OP_AND() {
                if !rt_truthy(eval_sexpr(b.lhs_expr(), cat, env, lb, scratch)) {
                    return RtVal::B(false);
                }
                return RtVal::B(rt_truthy(eval_sexpr(b.rhs_expr(), cat, env, lb, scratch)));
            }
            if op == OP_OR() {
                if rt_truthy(eval_sexpr(b.lhs_expr(), cat, env, lb, scratch)) {
                    return RtVal::B(true);
                }
                return RtVal::B(rt_truthy(eval_sexpr(b.rhs_expr(), cat, env, lb, scratch)));
            }
            let l: RtVal = eval_sexpr(b.lhs_expr(), cat, env, lb, scratch);
            let r: RtVal = eval_sexpr(b.rhs_expr(), cat, env, lb, scratch);
            if op == OP_EQ() { return RtVal::B(rt_eq(l, r)); }
            if op == OP_NE() { return RtVal::B(!rt_eq(l, r)); }
            if op == OP_LT() || op == OP_LE() || op == OP_GT() || op == OP_GE() {
                // Null never orders (CEL-style, ADR §4): any Null operand
                // compares FALSE. Strict mode never produces Null operands.
                if rt_kind(l) == 0i32 || rt_kind(r) == 0i32 { return RtVal::B(false); }
                // Ordered compare: str via str_cmp; ints exactly; else f64.
                let mut c: i64 = 0i64;
                if rt_kind(l) == 4i32 && rt_kind(r) == 4i32 {
                    c = str_cmp(rt_s(l), rt_s(r)) as i64;
                } else if rt_kind(l) == 1i32 && rt_kind(r) == 1i32 {
                    let li2: i64 = rt_i(l);
                    let ri2: i64 = rt_i(r);
                    if li2 < ri2 { c = -1i64; } else if li2 > ri2 { c = 1i64; }
                } else {
                    let lf: f64 = rt_f(l);
                    let rf: f64 = rt_f(r);
                    if lf < rf { c = -1i64; } else if lf > rf { c = 1i64; }
                }
                if op == OP_LT() { return RtVal::B(c < 0i64); }
                if op == OP_LE() { return RtVal::B(c <= 0i64); }
                if op == OP_GT() { return RtVal::B(c > 0i64); }
                return RtVal::B(c >= 0i64);
            }
            // Arithmetic tier: Null PROPAGATES (any Null operand → Null).
            if rt_kind(l) == 0i32 || rt_kind(r) == 0i32 { return RtVal::Null; }
            if op == OP_ADD() {
                if rt_kind(l) == 4i32 || rt_kind(r) == 4i32 {
                    // string concatenation — interned into the render scratch
                    let mut t: String = String::new();
                    t.push_str(rt_s(l));
                    t.push_str(rt_s(r));
                    return RtVal::S(intern(scratch, &t));
                }
                if rt_kind(l) == 2i32 || rt_kind(r) == 2i32 {
                    return RtVal::F(rt_f(l) + rt_f(r));
                }
                return RtVal::I(rt_i(l) + rt_i(r));
            }
            if op == OP_SUB() {
                if rt_kind(l) == 2i32 || rt_kind(r) == 2i32 { return RtVal::F(rt_f(l) - rt_f(r)); }
                return RtVal::I(rt_i(l) - rt_i(r));
            }
            if op == OP_MUL() {
                if rt_kind(l) == 2i32 || rt_kind(r) == 2i32 { return RtVal::F(rt_f(l) * rt_f(r)); }
                return RtVal::I(rt_i(l) * rt_i(r));
            }
            if op == OP_DIV() {
                if rt_kind(l) == 2i32 || rt_kind(r) == 2i32 { return RtVal::F(rt_f(l) / rt_f(r)); }
                return RtVal::I(rt_i(l) / rt_i(r));   // div-by-zero traps (static parity)
            }
            // OP_MOD — integer tier only (checker-enforced).
            return RtVal::I(rt_i(l) % rt_i(r));
        }
        SExpr::Un(u) => {
            let a: RtVal = eval_sexpr(u.arg_expr(), cat, env, lb, scratch);
            if u.op == OP_NOT() { return RtVal::B(!rt_truthy(a)); }
            match a {
                RtVal::F(x) => { return RtVal::F(0.0f64 - x); }
                RtVal::Null => { return RtVal::Null; }   // -Null → Null (ADR §4)
                _ => { return RtVal::I(0i64 - rt_i(a)); }
            }
        }
        SExpr::Cond(c) => {
            if rt_truthy(eval_sexpr(c.cond_expr(), cat, env, lb, scratch)) {
                return eval_sexpr(c.then_expr(), cat, env, lb, scratch);
            }
            return eval_sexpr(c.else_expr(), cat, env, lb, scratch);
        }
        SExpr::Call(c) => {
            let bfn: i32 = builtin_of_name(c.fn_name);
            let args: SExprArr = c.args_arr();
            if bfn != BFN_UNKNOWN() {
                // Builtins are STRING functions: any non-string argument —
                // Null from a lenient miss, or a runtime type surprise —
                // yields Null (ADR §4; strict mode guarantees string args).
                let a0: RtVal = eval_sexpr(args.arg_at(0i64), cat, env, lb, scratch);
                if rt_kind(a0) != 4i32 { return RtVal::Null; }
                let mut a1: RtVal = RtVal::S("");
                if builtin_arity(bfn) > 1i64 {
                    a1 = eval_sexpr(args.arg_at(1i64), cat, env, lb, scratch);
                    if rt_kind(a1) != 4i32 { return RtVal::Null; }
                }
                if bfn == BFN_LEN() { return RtVal::I(rt_s(a0).len()); }
                if bfn == BFN_UPPER() {
                    let u2: String = wql_upper(rt_s(a0));
                    return RtVal::S(intern(scratch, &u2));
                }
                if bfn == BFN_LOWER() {
                    let l2: String = wql_lower(rt_s(a0));
                    return RtVal::S(intern(scratch, &l2));
                }
                if bfn == BFN_CONTAINS() {
                    return RtVal::B(str_contains(rt_s(a0), rt_s(a1)));
                }
                // BFN_STARTS_WITH
                return RtVal::B(str_starts_with(rt_s(a0), rt_s(a1)));
            }
            // Registered UDF (builtin-first precedence; arity/types checked).
            let ui: i64 = env.find_fn(c.fn_name);
            if ui >= 0i64 {
                let mut argv: [RtVal; 8] = [RtVal::Null; 8];
                let na: i64 = args.len();
                let mut k: i64 = 0i64;
                while k < na && k < 8i64 {
                    argv[k] = eval_sexpr(args.arg_at(k), cat, env, lb, scratch);
                    k = k + 1i64;
                }
                let f: QFn = env.f_ptrs[ui];
                return f(&argv[0i64..na]);
            }
            return RtVal::Null;
        }
        _ => { return RtVal::Null; }
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// The RENDER walk — TStmt chain → String (ADR §7 Trama tier).
// ═══════════════════════════════════════════════════════════════════════════

// Append a TText run, decoding the template backslash escapes (`\{` `\}`
// `` \` `` `\\`) to their bare characters (the emit_escaped de-escape rules,
// applied directly to the output instead of to generated source).
fn push_deescaped(out: &mut String, s: str) {
    let n: i64 = s.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        if c == 92u8 && i + 1i64 < n {
            let e: u8 = str_byte_at(s, i + 1i64);
            if e == 123u8 || e == 125u8 || e == 96u8 || e == 92u8 {
                out.push_u8(e);
                i = i + 2i64;
                continue;
            }
        }
        out.push_u8(c);
        i = i + 1i64;
    }
}

// `lb` is a RAW pointer through the whole walk (the eval reborrow-laundering
// contract of eval_root — RtVal payloads never point into RBinds storage).
fn render_stmts(head: i64, cat: &SchemaCatalog, env: &QEnv, lb: *mut RBinds,
                scratch: &Writ, out: &mut String) {
    let mut cur: i64 = head;
    while cur != 0i64 {
        let e: TStmt = WAny::ref_to(cur as *const u8).view::<TStmt>();
        match e {
            TStmt::Text(t) => { push_deescaped(out, ttext_str(&t)); }
            TStmt::Var(v) => {
                let val: RtVal = eval_sexpr(v.expr_expr(), cat, env, lb, scratch);
                rt_push(out, val);
            }
            TStmt::If(i) => {
                let cv: RtVal = eval_sexpr(i.expr_expr(), cat, env, lb, scratch);
                let mark: i64 = unsafe { (&*lb).n };
                if rt_truthy(cv) {
                    render_stmts(body_word(&i.body), cat, env, lb, scratch, out);
                } else {
                    let altw: i64 = alt_word(&i.alt);
                    if altw != 0i64 {
                        render_stmts(altw, cat, env, lb, scratch, out);
                    }
                }
                let lbm: &mut RBinds = unsafe { &mut *lb };
                lbm.n = mark;
            }
            TStmt::For(f) => {
                let it: RtVal = eval_sexpr(f.expr_expr(), cat, env, lb, scratch);
                match it {
                    RtVal::Node(w) => {
                        if w.is_array() {
                            let arr: &WArray<WAny> = w.as_array();
                            let mark2: i64 = unsafe { (&*lb).n };
                            unsafe { (&mut *lb).bind_val(f.var, RtVal::Null); }
                            let slot: i64 = unsafe { (&*lb).n } - 1i64;
                            let n: i64 = arr.len();
                            let mut i2: i64 = 0i64;
                            while i2 < n {
                                // shape-driven element conversion: schema'd
                                // nodes stay Node, scalar elements (FK_EARR
                                // arrays) become their scalar RtVal.
                                unsafe { (&mut *lb).set_val(slot, wany_to_rt(arr.get(i2))); }
                                render_stmts(body_word(&f.body), cat, env, lb, scratch, out);
                                i2 = i2 + 1i64;
                            }
                            let lbm2: &mut RBinds = unsafe { &mut *lb };
                            lbm2.n = mark2;
                        }
                        // a single (non-array) edge value: nothing to iterate
                    }
                    _ => { }   // null edge → empty loop
                }
            }
            TStmt::Set(s) => {
                let sv: RtVal = eval_sexpr(s.expr_expr(), cat, env, lb, scratch);
                unsafe { (&mut *lb).bind_val(s.var, sv); }
            }
        }
        cur = next_of_stmt(cur);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Tpl — compile-once / render-many dynamic template (ADR §3).
// Owns the parsed IR doc (never-move arena) + a catalog snapshot.
// ═══════════════════════════════════════════════════════════════════════════
pub struct Tpl {
    doc:  Writ,            // owns the Trama AST + embedded SExpr IR
    head: i64,             // TStmt chain head word (into `doc`'s arena)
    cat:  SchemaCatalog,   // catalog snapshot (Vec-backed — must stay SMALL,
                           // see the SchemaCatalog layout note)
}

impl Tpl {
    // Parse template TEXT → Trama IR; stitch the statement chain; run the
    // shared IR optimizer over every embedded expression; run the env-
    // independent checks. Errors are VALUES. Unknown fn names DEFER to the
    // render-time strict check (I3 registry unification: templates resolve
    // UDFs against the SAME env registry queries do — builtin-first, ADR §6;
    // I1/I2 rejected them eagerly, which made template UDFs impossible).
    pub fn compile(text: str, cat: &SchemaCatalog) -> Result<Tpl, QError> {
        let doc: Writ = writ_new(4096i64);
        let tpl_any: WAny = parse_tpl(text, &doc);
        if tpl_any.is_null() || !tpl_any.is_array() {
            return Result::Err(qerr("Tpl::compile: template parse error — unbalanced tag or malformed embedded expression"));
        }
        let arr: &WArray<WAny> = tpl_any.as_array();
        let head: i64 = chain_array(arr);
        simplify_all(head, &doc);
        let e0: QEnv = QEnv::new();
        let reg0: QRelReg = qrelreg_new();
        let mut lb: CBinds = cbinds_new();
        let mut chk: Chk = chk_new();
        chk.defer_unknown_fn = true;
        check_stmts(head, cat, &e0, false, &mut lb, &mut chk, &reg0);
        if chk.failed { return Result::Err(chk_err(chk)); }
        return Result::Ok(Tpl { doc: doc, head: head, cat: catalog_clone(cat) });
    }

    // STRICT check against (catalog + this env's declarations), then walk.
    // Re-entrant over different envs (the check is per-env by design).
    pub fn render(self: &Tpl, env: &QEnv) -> Result<String, QError> {
        let reg0: QRelReg = qrelreg_new();
        let mut lb: CBinds = cbinds_new();
        let mut chk: Chk = chk_new();
        check_stmts(self.head, &self.cat, env, true, &mut lb, &mut chk, &reg0);
        if chk.failed { return Result::Err(chk_err(chk)); }
        let scratch: Writ = writ_new(1024i64);
        let mut rb: RBinds = rbinds_new();
        let rbp: *mut RBinds = &mut rb;
        let mut out: String = String::new();
        render_stmts(self.head, &self.cat, env, rbp, &scratch, &mut out);
        return Result::Ok(out);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// ═══ QUERY — the relational executor (ADR 0012-queue2 §7, slice I2) ═══
//
// `Query::compile(text, &cat)` parses via the REUSED generated surface parser
// (`wql_surface_parser::parse_program`), rejects rel blocks (I3), lowers via
// the REUSED `lower_rquery_to_rexpr` and runs the REUSED `simplify_rexpr_ref`
// relational peephole (queue-1 optimizer verbatim — the empty signal becomes
// a zero-row fast path). The env-INDEPENDENT half of the checker runs at
// compile; the FULL strict check + the join-strategy cascade decision run at
// the top of every `run(&env)` (the I1 compile/render precedent: sources,
// params and the UDF/UDA registry live on the env). `run` then tree-walks the
// RExpr algebra over materialized Vec<row> pipelines (ADR §7) and returns a
// self-contained QRows.
// ═══════════════════════════════════════════════════════════════════════════


// Raw-pointer latch access for the EXECUTOR tier: exec fns return non-Copy
// row sets, and the conservative borrow regions would pin a `&mut Chk` for
// the result's lifetime — the RBinds provenance-laundering idiom applies.
fn chk_bad(chk: *mut Chk) -> bool { return unsafe { (&*chk).failed }; }
fn chk_fail_p(chk: *mut Chk, a: str, b: str, d: str, e: str, f: str) {
    unsafe { chk_fail(&mut *chk, a, b, d, e, f); }
}

// Result-envelope modes (mirror rexpr_walk's SELM_* — first/find are not
// algebra nodes; they shape the result).
const QM_ALL:   i32 = 0i32;
const QM_FIRST: i32 = 1i32;
const QM_FIND:  i32 = 2i32;

// Join-strategy tiers (runtime edition of the static cascade; the TREE tier
// is unreachable over the scalar lattice — hash-able ⇔ ord-able here).
const QT_HASH: i32 = 1i32;
const QT_LOOP: i32 = 3i32;

// Builtin aggregate ids (local mirror; the TYPE rules live in the SHARED
// `el::agg_result_ty` table — one rule source for static + dynamic tiers).
fn qagg_id(name: str) -> i32 {
    if str_eq(name, "count") { return 1i32; }
    if str_eq(name, "sum")   { return 2i32; }
    if str_eq(name, "min")   { return 3i32; }
    if str_eq(name, "max")   { return 4i32; }
    if str_eq(name, "avg")   { return 5i32; }
    return 0i32;
}

// An SExpr view from a raw arena word (the provenance-laundering idiom).
fn sx_of(w: i64) -> SExpr { return WAny::ref_to(w as *const u8).view::<SExpr>(); }

// The RScan under a relational edge (join right sides are always scans).
fn rscan_of(e: RExpr) -> RScan {
    match e {
        RExpr::Scan(sc) => { return sc; }
        _ => {
            // Unreachable by construction (lowering invariant); a defensive
            // null-backed view would fault loudly on read.
            return WAny::ref_to(0i64 as *const u8).view::<RScan>();
        }
    }
}

// ── QPlan — the per-run node decisions, filled by the STRICT check walk ─────
// The cascade is decided ONCE per run from CHECKED types (never per row); the
// executor looks decisions up by node word. Capacities are metadata-sized:
// ≤ 24 join steps ACROSS the entry + every rel body (I3 — each ≤ 8 by the
// grammar cap), ONE aggregate node (entry-only), ≤ 8 output columns.
// `ncols`/`ckind` are per-Proj scratch: each body's check reads them right
// after its walk; the ENTRY is checked LAST, so the surviving values are the
// entry's (what QRows carries).
struct QPlan {
    // RJoin/RAnti step plans, keyed by node word
    jw:     [i64; 24],
    jtier:  [i32; 24],
    jequi:  [i64; 24],   // the selected equi-TERM word (0 = none)
    jbuild: [i64; 24],   // new-side key expr word
    jprobe: [i64; 24],   // bound-side key expr word
    jn:     i64,
    // the single RAggr plan
    agg_n:    i64,
    agg_fnid: [i32; 8],  // 1..5 builtin, 0 = UDA
    agg_uda:  [i64; 8],  // UDA registry index (fnid 0)
    agg_ret:  [i32; 8],  // column result tag (CT_* scalar tier)
    // projection
    ncols: i64,
    ckind: [i32; 8],
}

fn qplan_new() -> QPlan {
    return QPlan {
        jw: [0i64; 24], jtier: [0i32; 24], jequi: [0i64; 24],
        jbuild: [0i64; 24], jprobe: [0i64; 24], jn: 0i64,
        agg_n: 0i64, agg_fnid: [0i32; 8], agg_uda: [0i64; 8], agg_ret: [0i32; 8],
        ncols: 0i64, ckind: [0i32; 8],
    };
}

fn qp_jfind(qp: &QPlan, w: i64) -> i64 {
    let mut i: i64 = 0i64;
    while i < qp.jn {
        if qp.jw[i] == w { return i; }
        i = i + 1i64;
    }
    return -1i64;
}

// ── Path splitting (REdge `path` — "a.b.c" → segments) ──────────────────────
struct PathSegs { segs: [str; 8], n: i64 }

fn split_path(p: str) -> PathSegs {
    let mut out: PathSegs = PathSegs { segs: [""; 8], n: 0i64 };
    let n: i64 = p.len();
    let mut start: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i <= n {
        let dot: bool = if i < n { str_byte_at(p, i) == 46u8 } else { true };
        if dot {
            if i > start && out.n < 8i64 {
                out.segs[out.n] = unsafe {
                    str_from_raw((p.as_ptr() as i64 + start) as *const u8, i - start)
                };
                out.n = out.n + 1i64;
            }
            start = i + 1i64;
        }
        i = i + 1i64;
    }
    return out;
}

// ── Source resolution (query scans) ─────────────────────────────────────────
// A scan source must be a QB_SRC env binding; the element type resolves LIVE
// (empty array ⇒ UNKNOWN ⇒ zero rows, every dependent check defers — nothing
// is ever evaluated over it).
fn resolve_source(name: str, cat: &SchemaCatalog, env: &QEnv, strict: bool,
                  chk: &mut Chk) -> CTy {
    let ei: i64 = env.find(name);
    if ei < 0i64 {
        if strict {
            chk_fail(chk, "unknown source '", name,
                     "' — bind it on the QEnv with bind_source before run", "", "");
        }
        return ct(CT_UNKNOWN);
    }
    if env.kinds[ei] == QB_ESRC { return ct(CT_DYNSRC); }   // lenient source
    if env.kinds[ei] != QB_SRC {
        chk_fail(chk, "source '", name,
                 "' is not bound as a source — use bind_source", "", "");
        return ct(CT_UNKNOWN);
    }
    return src_elem_ty(name, env.words[ei], cat, chk);
}

// Bind a scan/traversal row var from its collection type.
fn bind_row_var(lb: &mut CBinds, var: str, coll: CTy) {
    if coll.t == CT_ARR         { lb.bind(var, CT_NODE, coll.code); }
    else if coll.t == CT_SARR   { lb.bind(var, coll.code as i32, 0u64); }
    else if coll.t == CT_DYNSRC { lb.bind(var, CT_DYN, 0u64); }   // lenient row
    else                        { lb.bind(var, CT_UNKNOWN, 0u64); }
}

// ── The QUERY check walk (SExpr checks reuse check_expr verbatim) ───────────
// Walks the SIMPLIFIED RExpr tree binding row vars in scope order, checking
// every embedded scalar clause against (catalog + env + binds + rel
// registry), and — in the STRICT phase — deciding the join cascade +
// aggregate plan + projection column kinds into `qp`.
fn check_rexpr(e: RExpr, cat: &SchemaCatalog, env: &QEnv, strict: bool,
               lb: &mut CBinds, chk: &mut Chk, qp: &mut QPlan, reg: &QRelReg) {
    if chk.failed { return; }
    match e {
        RExpr::Scan(sc) => {
            // Rel names resolve FIRST (compile-known typed columns; a rel
            // shadows a same-named env binding — I3).
            let ri: i64 = qreg_find(reg, sc.src_name);
            if ri >= 0i64 {
                lb.bind(sc.var_name, CT_RELROW, ri as u64);
                return;
            }
            let st: CTy = resolve_source(sc.src_name, cat, env, strict, chk);
            if chk.failed { return; }
            bind_row_var(lb, sc.var_name, st);
        }
        RExpr::Filter(f) => {
            check_rexpr(f.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let pt: CTy = check_expr(f.pred_expr(), cat, env, strict, lb, chk, reg);
            if !chk.failed && pt.t != CT_BOOL && !ct_is_open(pt.t) {
                chk_fail(chk, "a where/having predicate must be a bool", "", "", "", "");
            }
        }
        RExpr::Sort(s) => {
            check_rexpr(s.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let kt: CTy = check_expr(s.key_expr(), cat, env, strict, lb, chk, reg);
            if !chk.failed && ct_is_obj(kt.t) {
                chk_fail(chk, "an `order by` key must be a scalar", "", "", "", "");
            }
        }
        RExpr::Edge(ed) => {
            check_rexpr(ed.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            // base var → path walk over the catalog
            let bi: i64 = lb.find(ed.base_var);
            let mut cur: CTy = ct(CT_UNKNOWN);
            if bi >= 0i64 { cur = CTy { t: lb.tags[bi], code: lb.codes[bi] }; }
            else if strict {
                chk_fail(chk, "unknown traversal base '", ed.base_var,
                         "' — it must be a row variable bound earlier in the chain", "", "");
                return;
            }
            if cur.t == CT_RELROW {
                chk_fail(chk, "traversal base '", ed.base_var,
                         "' binds a rel row — rel rows are scalar tuples and have no edges to traverse",
                         "", "");
                return;
            }
            if cur.t == CT_DYN {
                chk_fail(chk, "traversal base '", ed.base_var,
                         "' binds a lenient (erased) row — traversal needs a cataloged schema",
                         "", "");
                return;
            }
            let ps: PathSegs = split_path(ed.path);
            let mut vt: CTy = ct(CT_UNKNOWN);   // the new var's ELEMENT type
            let mut i: i64 = 0i64;
            while i < ps.n && !chk.failed {
                if cur.t == CT_UNKNOWN { vt = ct(CT_UNKNOWN); break; }
                if cur.t != CT_NODE {
                    chk_fail(chk, "traversal segment '", ps.segs[i],
                             "' is read off a non-object value", "", "");
                    break;
                }
                let si: i64 = cat.sidx_of_code(cur.code);
                if si < 0i64 {
                    chk_fail(chk, "traversal segment '", ps.segs[i],
                             "': the base schema is not in the catalog", "", "");
                    break;
                }
                let fi: i64 = cat.fidx(si, ps.segs[i]);
                if fi < 0i64 {
                    chk_fail(chk, "unknown field '", ps.segs[i], "' on schema '",
                             cat.s_names.get(si), "' in a traversal path");
                    break;
                }
                let last: bool = i == ps.n - 1i64;
                if !last {
                    // intermediate hop: a SINGLE-NODE edge at runtime
                    if cat.f_kinds.get(fi) != (FK_EDGE as i64) || cat.f_targets.get(fi) == 0u64 {
                        chk_fail(chk, "intermediate traversal segment '", ps.segs[i],
                                 "' must be an edge field", "", "");
                        break;
                    }
                    cur = CTy { t: CT_NODE, code: cat.f_targets.get(fi) };
                } else {
                    if cat.f_kinds.get(fi) == (FK_EDGE as i64) {
                        if cat.f_targets.get(fi) == 0u64 {
                            chk_fail(chk, "edge field '", ps.segs[i],
                                     "' targets a schema missing from the catalog", "", "");
                            break;
                        }
                        vt = CTy { t: CT_NODE, code: cat.f_targets.get(fi) };
                    } else if cat.f_kinds.get(fi) == (FK_EARR as i64) {
                        vt = CTy { t: cat.f_tys.get(fi) as i32, code: 0u64 };
                    } else {
                        chk_fail(chk, "traversal path must end at an edge field '",
                                 ps.segs[i], "' (a collection or single-node edge)", "", "");
                        break;
                    }
                }
                i = i + 1i64;
            }
            if chk.failed { return; }
            let mark: i64 = lb.n;
            lb.bind(ed.var_name, vt.t, vt.code);
            if ed.has_on {
                let ot: CTy = check_expr(ed.on_expr(), cat, env, strict, lb, chk, reg);
                if !chk.failed && ot.t != CT_BOOL && !ct_is_open(ot.t) {
                    chk_fail(chk, "a join `on` predicate must be a bool", "", "", "", "");
                }
            }
            // an anti step's var binds ONLY inside its own `on`
            if ed.is_anti { lb.n = mark; }
        }
        RExpr::Join(jn) => {
            check_rexpr(jn.left_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let rs: RScan = rscan_of(jn.right_expr());
            let ri: i64 = qreg_find(reg, rs.src_name);
            if ri >= 0i64 {
                lb.bind(rs.var_name, CT_RELROW, ri as u64);
            } else {
                let st: CTy = resolve_source(rs.src_name, cat, env, strict, chk);
                if chk.failed { return; }
                bind_row_var(lb, rs.var_name, st);
            }
            let ot: CTy = check_expr(jn.on_expr(), cat, env, strict, lb, chk, reg);
            if chk.failed { return; }
            if ot.t != CT_BOOL && !ct_is_open(ot.t) {
                chk_fail(chk, "a join `on` predicate must be a bool", "", "", "", "");
                return;
            }
            if strict {
                analyze_join_step(jn.on.any().raw(), rs.var_name,
                                  jn.as_ref().raw(), cat, env, lb, qp, reg);
            }
        }
        RExpr::Anti(an) => {
            check_rexpr(an.left_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let rs: RScan = rscan_of(an.right_expr());
            let mark: i64 = lb.n;
            let ri: i64 = qreg_find(reg, rs.src_name);
            if ri >= 0i64 {
                lb.bind(rs.var_name, CT_RELROW, ri as u64);
            } else {
                let st: CTy = resolve_source(rs.src_name, cat, env, strict, chk);
                if chk.failed { return; }
                bind_row_var(lb, rs.var_name, st);
            }
            let ot: CTy = check_expr(an.on_expr(), cat, env, strict, lb, chk, reg);
            if chk.failed { return; }
            if ot.t != CT_BOOL && !ct_is_open(ot.t) {
                chk_fail(chk, "a join `on` predicate must be a bool", "", "", "", "");
                return;
            }
            if strict {
                analyze_join_step(an.on.any().raw(), rs.var_name,
                                  an.as_ref().raw(), cat, env, lb, qp, reg);
            }
            lb.n = mark;   // anti var invisible downstream
        }
        RExpr::Aggr(g) => {
            let mark: i64 = lb.n;
            check_rexpr(g.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let kt: CTy = check_expr(g.key_expr(), cat, env, strict, lb, chk, reg);
            if chk.failed { return; }
            if ct_is_obj(kt.t) {
                chk_fail(chk, "a `group by` key must be a scalar", "", "", "", "");
                return;
            }
            let aggs: RAggArr = g.aggs_arr();
            let an2: i64 = aggs.len();
            let mut rets: [i32; 8] = [0i32; 8];
            let mut ci: i64 = 0i64;
            while ci < an2 && ci < 8i64 {
                let a: RAgg = aggs.agg_at(ci);
                let fnid: i32 = qagg_id(a.fn_name);
                let mut rett: i32 = CT_UNKNOWN;
                let mut uidx: i64 = -1i64;
                if fnid == 1i32 {
                    if a.has_arg {
                        chk_fail(chk, "count() takes no argument", "", "", "", "");
                        return;
                    }
                    rett = CT_INT;
                } else if fnid != 0i32 {
                    if !a.has_arg {
                        chk_fail(chk, "aggregate '", a.fn_name, "' needs an argument", "", "");
                        return;
                    }
                    let at: CTy = check_expr(a.arg_expr(), cat, env, strict, lb, chk, reg);
                    if chk.failed { return; }
                    if at.t == CT_DYN {
                        // The accumulator layout is chosen from the CHECKED
                        // type — a runtime-typed lenient value has none.
                        chk_fail(chk, "aggregate '", a.fn_name,
                                 "' cannot range over a lenient (erased) value — bind the source strictly",
                                 "", "");
                        return;
                    }
                    if at.t == CT_UNKNOWN {
                        rett = CT_UNKNOWN;
                    } else {
                        // the SHARED rule table (avg: T→Quot(T), Quot=FLT)
                        let r: i32 = agg_result_ty(a.fn_name, at.t);
                        if r < 0i32 {
                            chk_fail(chk, "aggregate '", a.fn_name,
                                     "' needs a numeric argument", "", "");
                            return;
                        }
                        rett = r;
                    }
                } else {
                    // UDA via the env registry (builtin names shadow UDAs)
                    uidx = env.find_agg(a.fn_name);
                    if uidx >= 0i64 {
                        if !a.has_arg {
                            chk_fail(chk, "aggregate '", a.fn_name, "' needs an argument", "", "");
                            return;
                        }
                        let at2: CTy = check_expr(a.arg_expr(), cat, env, strict, lb, chk, reg);
                        if chk.failed { return; }
                        if !ct_is_open(at2.t) && at2.t != env.a_argty[uidx] {
                            chk_fail(chk, "argument type mismatch for aggregate '",
                                     a.fn_name, "' — the registered signature differs", "", "");
                            return;
                        }
                        rett = env.a_ret[uidx];
                    } else if strict {
                        chk_fail(chk, "unknown aggregate '", a.fn_name,
                                 "' — builtins are count/sum/min/max/avg; register a UDA on the QEnv (register_agg)",
                                 "", "");
                        return;
                    }
                }
                rets[ci] = rett;
                qp.agg_fnid[ci] = fnid;
                qp.agg_uda[ci]  = uidx;
                qp.agg_ret[ci]  = rett;
                ci = ci + 1i64;
            }
            qp.agg_n = ci;
            // Above the aggregate only (key + outputs) are visible.
            lb.n = mark;
            lb.bind("key", kt.t, kt.code);
            let mut co: i64 = 0i64;
            while co < ci {
                let a2: RAgg = aggs.agg_at(co);
                lb.bind(a2.out, rets[co], 0u64);
                co = co + 1i64;
            }
        }
        RExpr::Proj(p) => {
            check_rexpr(p.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let sel: SExpr = p.sel_expr();
            match sel {
                SExpr::Tuple(tp) => {
                    let items: SExprArr = tp.items_arr();
                    let nn: i64 = items.len();
                    let mut i2: i64 = 0i64;
                    while i2 < nn && i2 < 8i64 {
                        let it: CTy = check_expr(items.arg_at(i2), cat, env, strict, lb, chk, reg);
                        if chk.failed { return; }
                        if ct_is_obj(it.t) {
                            chk_fail(chk, "a tuple projection component must be a scalar", "", "", "", "");
                            return;
                        }
                        qp.ckind[i2] = it.t;
                        i2 = i2 + 1i64;
                    }
                    qp.ncols = i2;
                }
                _ => {
                    let st2: CTy = check_expr(sel, cat, env, strict, lb, chk, reg);
                    if chk.failed { return; }
                    if st2.t == CT_ARR || st2.t == CT_SARR || st2.t == CT_DYNSRC {
                        chk_fail(chk, "cannot select a collection edge — traverse it with a join step first",
                                 "", "", "", "");
                        return;
                    }
                    if st2.t == CT_RELROW {
                        // static parity: a rel row is a fn-local tuple — no
                        // whole-row projection (select explicit columns).
                        chk_fail(chk, "cannot select a whole rel row — select explicit columns", "", "", "", "");
                        return;
                    }
                    qp.ckind[0] = st2.t;   // CT_NODE allowed (identity / find)
                    qp.ncols = 1i64;
                }
            }
        }
        RExpr::Distinct(d) => {
            check_rexpr(d.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let mut i3: i64 = 0i64;
            while i3 < qp.ncols {
                if qp.ckind[i3] == CT_FLT {
                    chk_fail(chk, "`distinct` over an f64 projection is not supported (set semantics require Eq)",
                             "", "", "", "");
                    return;
                }
                if qp.ckind[i3] == CT_NODE {
                    chk_fail(chk, "`distinct` over an object projection is not supported", "", "", "", "");
                    return;
                }
                i3 = i3 + 1i64;
            }
        }
        RExpr::Limit(l) => {
            check_rexpr(l.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            if l.is_param && strict {
                let ei: i64 = env.find(l.param);
                if ei < 0i64 || env.kinds[ei] != QB_I64 {
                    chk_fail(chk, "limit parameter '", l.param,
                             "' must be bound as i64 on the QEnv", "", "");
                }
            }
        }
        RExpr::Fix(_fx) => {
            // The lowering never produces RFix (rel recursion is realized by
            // the semi-naïve materializer, not an algebra node) — defensive.
            chk_fail(chk, "internal: unexpected fixpoint node in the plan", "", "", "", "");
        }
    }
}

// ── The equi/residual split + cascade decision (runtime edition) ────────────
// The IR-level decomposition (split_and_terms / refs_mask) is REUSED from the
// shared optimizer module — identical to the static analyzer's. The TYPE
// source differs by design: the static queue reads ElTypes; here the runtime
// checker (check_expr over catalog + env + binds) types each side. First
// same-typed equi-term wins; Hash+Eq keys (INT/STR/BOOL) go hash tier, an f64
// key (PartialEq only — NaN kills Hash and total Ord) or no equi-term at all
// goes nested-loop over the FULL predicate.
fn analyze_join_step(on_w: i64, new_var: str, node_w: i64,
                     cat: &SchemaCatalog, env: &QEnv, lb: &CBinds, qp: &mut QPlan,
                     reg: &QRelReg) {
    let onr: WRef<SExpr> = WRef::<SExpr>::from_any(WAny::ref_to(on_w as *const u8));
    let mut tl: TermList = term_list_new();
    split_and_terms(onr, &mut tl);

    let mut tier: i32 = QT_LOOP;
    let mut equi_w: i64 = 0i64;
    let mut build_w: i64 = 0i64;
    let mut probe_w: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < tl.n {
        if equi_w == 0i64 {
            let te: SExpr = sx_of(tl.w[i]);
            match te {
                SExpr::Bin(b) => {
                    if b.op == OP_EQ() {
                        let lm: i32 = refs_mask(b.lhs_expr(), new_var);
                        let rm: i32 = refs_mask(b.rhs_expr(), new_var);
                        let mut cw: i64 = 0i64;   // new-side (build)
                        let mut cp: i64 = 0i64;   // bound-side (probe)
                        if lm == 1i32 && (rm & 1i32) == 0i32 { cw = b.lhs.any().raw(); cp = b.rhs.any().raw(); }
                        if rm == 1i32 && (lm & 1i32) == 0i32 { cw = b.rhs.any().raw(); cp = b.lhs.any().raw(); }
                        if cw != 0i64 {
                            // Usable key ⇔ both sides check to the SAME scalar
                            // type (no cross-type hashing via promotion — a
                            // mixed-type == stays residual, static parity).
                            // A CT_DYN (lenient) side never qualifies: the key
                            // type is unknown at check time — loop tier.
                            let mut c2: Chk = chk_new();
                            let kb: CTy = check_expr(sx_of(cw), cat, env, true, lb, &mut c2, reg);
                            let kp: CTy = check_expr(sx_of(cp), cat, env, true, lb, &mut c2, reg);
                            if !c2.failed && kb.t == kp.t {
                                if kb.t == CT_INT || kb.t == CT_STR || kb.t == CT_BOOL {
                                    tier = QT_HASH;
                                    equi_w = tl.w[i];
                                    build_w = cw;
                                    probe_w = cp;
                                } else if kb.t == CT_FLT {
                                    // equi-term exists but the key is f64 —
                                    // loop tier over the full predicate.
                                    tier = QT_LOOP;
                                    equi_w = tl.w[i];
                                    build_w = 0i64;
                                    probe_w = 0i64;
                                }
                            }
                        }
                    }
                }
                _ => { }
            }
        }
        i = i + 1i64;
    }
    if qp.jn >= 24i64 { return; }
    qp.jw[qp.jn]     = node_w;
    qp.jtier[qp.jn]  = if build_w != 0i64 { tier } else { QT_LOOP };
    qp.jequi[qp.jn]  = if build_w != 0i64 { equi_w } else { 0i64 };
    qp.jbuild[qp.jn] = build_w;
    qp.jprobe[qp.jn] = probe_w;
    qp.jn = qp.jn + 1i64;
}

// ═══════════════════════════════════════════════════════════════════════════
// The REL-FIELD REWRITE (I3, compile-time, ONCE per Query) — `p.b` where `p`
// binds a rel row becomes ONE ident named "p.b" (rel rows are RtVal column
// groups, not Writ nodes — there is no object to field_read). The checker
// decodes the dotted name against the registry (check_root); the executor
// binds the dotted names as RowSet columns; refs_mask treats "p.b" as a
// reference to "p" (the shared-optimizer extension), so the join cascade
// works unchanged. The pass also collects each body's IN-SCC source
// OCCURRENCES (the semi-naïve delta variants) and gates the borrow-outward
// forms (whole-row select, traversal off a rel var) — static parity.
// ═══════════════════════════════════════════════════════════════════════════

// Rel vars in scope during the rewrite walk (var name → rel registry idx).
struct RwScope { vars: [str; 12], rel: [i64; 12], n: i64 }
fn rwscope_new() -> RwScope { return RwScope { vars: [""; 12], rel: [0i64; 12], n: 0i64 }; }
fn rw_find(sc: &RwScope, name: str) -> i64 {
    let mut i: i64 = 0i64;
    while i < sc.n {
        if str_eq(sc.vars[i], name) { return i; }
        i = i + 1i64;
    }
    return -1i64;
}

// The name of a BARE ident node ("" otherwise). The EL parser spells bare
// idents as SField with a NULL base; SVar covers hand-built IR.
fn sident_name(e: SExpr) -> str {
    match e {
        SExpr::Field(f) => {
            let bref: WRef<SExpr> = f.base;
            if bref.any().is_null() { return f.name; }
            return "";
        }
        SExpr::Var(v) => { return v.name; }
        _ => { return ""; }
    }
}

// Rewrite rel-column reads inside one scalar expression (in place; child
// edges are rebound — the simplify_all discipline). Returns the (possibly
// replaced) edge for the caller to rebind.
fn rw_expr(eref: WRef<SExpr>, sc: &RwScope, reg: &QRelReg, h: &Writ,
           chk: &mut Chk) -> WRef<SExpr> {
    if eref.any().is_null() || chk.failed { return eref; }
    let e: SExpr = eref.any().view::<SExpr>();
    match e {
        SExpr::Field(f) => {
            let bref: WRef<SExpr> = f.base;
            if bref.any().is_null() { return eref; }   // bare ident — no rewrite
            // `<relvar>.<col>` — the direct hit.
            let bn: str = sident_name(f.base_expr());
            if bn.len() > 0i64 {
                let vi: i64 = rw_find(sc, bn);
                if vi >= 0i64 {
                    let ri: i64 = sc.rel[vi];
                    let ci: i64 = qreg_col(reg, ri, f.name);
                    if ci < 0i64 {
                        chk_fail(chk, "unknown column '", f.name, "' on rel '",
                                 reg.names[ri], "'");
                        return eref;
                    }
                    let mut nm: String = String::new();
                    nm.push_str(bn);
                    nm.push_str(".");
                    nm.push_str(f.name);
                    // make_ident_sel boxes the name into the Query's doc.
                    return make_ident_sel(h, sstr(&nm));
                }
            }
            f.base = rw_expr(f.base, sc, reg, h, chk);
            if chk.failed { return eref; }
            // A rewritten base is a DOTTED ident ⇒ `p.col.x` — rel columns
            // are scalars, nothing deeper exists.
            let nb: str = sident_name(f.base_expr());
            if nb.len() > 0i64 && dotted_at(nb) > 0i64 {
                chk_fail(chk, "field '.", f.name,
                         "' is read off a rel column — rel columns are scalars", "", "");
            }
            return eref;
        }
        SExpr::Bin(b) => {
            b.lhs = rw_expr(b.lhs, sc, reg, h, chk);
            b.rhs = rw_expr(b.rhs, sc, reg, h, chk);
            return eref;
        }
        SExpr::Un(u) => {
            u.arg = rw_expr(u.arg, sc, reg, h, chk);
            return eref;
        }
        SExpr::Cond(c) => {
            c.c = rw_expr(c.c, sc, reg, h, chk);
            c.t = rw_expr(c.t, sc, reg, h, chk);
            c.e = rw_expr(c.e, sc, reg, h, chk);
            return eref;
        }
        SExpr::Call(cl) => {
            let mut args: SExprArr = cl.args_arr();
            let na: i64 = args.len();
            let mut i: i64 = 0i64;
            while i < na {
                let ar: WRef<SExpr> = WRef::<SExpr>::from_any(args.arg_any(i));
                let nr: WRef<SExpr> = rw_expr(ar, sc, reg, h, chk);
                if nr.any().raw() != ar.any().raw() { args.set_arg(i, nr.any()); }
                i = i + 1i64;
            }
            return eref;
        }
        SExpr::Tuple(tp) => {
            let mut items: SExprArr = tp.items_arr();
            let ni: i64 = items.len();
            let mut k: i64 = 0i64;
            while k < ni {
                let ir: WRef<SExpr> = WRef::<SExpr>::from_any(items.arg_any(k));
                let nr2: WRef<SExpr> = rw_expr(ir, sc, reg, h, chk);
                if nr2.any().raw() != ir.any().raw() { items.set_arg(k, nr2.any()); }
                k = k + 1i64;
            }
            return eref;
        }
        _ => { return eref; }
    }
}

// Whole-row projection gate: a bare rel var at the select root / as a tuple
// component has no sound projection (static parity — rel rows are column
// groups; select explicit columns).
fn rw_gate_comp(e: SExpr, sc: &RwScope, reg: &QRelReg, chk: &mut Chk) {
    let n: str = sident_name(e);
    if n.len() > 0i64 {
        let vi: i64 = rw_find(sc, n);
        if vi >= 0i64 {
            chk_fail(chk, "`select ", n, "` projects the whole rel row '",
                     reg.names[sc.rel[vi]], "' — select explicit columns instead");
        }
    }
}
fn rw_sel_gate(sel: SExpr, sc: &RwScope, reg: &QRelReg, chk: &mut Chk) {
    match sel {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let mut i: i64 = 0i64;
            while i < items.len() && !chk.failed {
                rw_gate_comp(items.arg_at(i), sc, reg, chk);
                i = i + 1i64;
            }
        }
        _ => { rw_gate_comp(sel, sc, reg, chk); }
    }
}

// The RExpr rewrite walk: binds rel scan vars into the scope, rewrites every
// embedded scalar clause, gates the borrow-outward forms, and — when
// `occ_c >= 0` (a body of a RECURSIVE SCC) — collects the body's in-SCC scan
// occurrences (node word + rel idx): the semi-naïve delta variants.
fn rw_walk(rref: WRef<RExpr>, sc: &mut RwScope, reg: &QRelReg, h: &Writ,
           chk: &mut Chk, occ_c: i64,
           ow: &mut [i64; 9], orel: &mut [i64; 9], on_: &mut i64) {
    if rref.any().is_null() || chk.failed { return; }
    let e: RExpr = rref.any().view::<RExpr>();
    match e {
        RExpr::Scan(s) => {
            let ri: i64 = qreg_find(reg, s.src_name);
            if ri >= 0i64 {
                if sc.n < 12i64 {
                    sc.vars[sc.n] = s.var_name;
                    sc.rel[sc.n]  = ri;
                    sc.n = sc.n + 1i64;
                }
                if occ_c >= 0i64 && reg.comp[ri] == occ_c {
                    if *on_ >= 9i64 {
                        chk_fail(chk, "too many recursive source references in one rel body", "", "", "", "");
                    } else {
                        ow[*on_]   = s.as_ref().raw();
                        orel[*on_] = ri;
                        *on_ = *on_ + 1i64;
                    }
                }
            }
        }
        RExpr::Filter(f) => {
            rw_walk(f.input, sc, reg, h, chk, occ_c, ow, orel, on_);
            f.pred = rw_expr(f.pred, sc, reg, h, chk);
        }
        RExpr::Sort(s2) => {
            rw_walk(s2.input, sc, reg, h, chk, occ_c, ow, orel, on_);
            s2.key = rw_expr(s2.key, sc, reg, h, chk);
        }
        RExpr::Edge(ed) => {
            rw_walk(ed.input, sc, reg, h, chk, occ_c, ow, orel, on_);
            if chk.failed { return; }
            if rw_find(sc, ed.base_var) >= 0i64 {
                chk_fail(chk, "traversal base '", ed.base_var,
                         "' binds a rel row — rel rows are scalar tuples and have no edges to traverse",
                         "", "");
                return;
            }
            if ed.has_on { ed.on = rw_expr(ed.on, sc, reg, h, chk); }
        }
        RExpr::Join(j) => {
            rw_walk(j.left, sc, reg, h, chk, occ_c, ow, orel, on_);
            rw_walk(j.right, sc, reg, h, chk, occ_c, ow, orel, on_);
            j.on = rw_expr(j.on, sc, reg, h, chk);
        }
        RExpr::Anti(a) => {
            rw_walk(a.left, sc, reg, h, chk, occ_c, ow, orel, on_);
            let mark: i64 = sc.n;
            rw_walk(a.right, sc, reg, h, chk, occ_c, ow, orel, on_);
            a.on = rw_expr(a.on, sc, reg, h, chk);
            sc.n = mark;   // an anti var binds only inside its own `on`
        }
        RExpr::Aggr(g) => {
            rw_walk(g.input, sc, reg, h, chk, occ_c, ow, orel, on_);
            g.key = rw_expr(g.key, sc, reg, h, chk);
            let aggs: RAggArr = g.aggs_arr();
            let na: i64 = aggs.len();
            let mut i: i64 = 0i64;
            while i < na && !chk.failed {
                let a2: RAgg = aggs.agg_at(i);
                if a2.has_arg { a2.arg = rw_expr(a2.arg, sc, reg, h, chk); }
                i = i + 1i64;
            }
        }
        RExpr::Proj(p) => {
            rw_walk(p.input, sc, reg, h, chk, occ_c, ow, orel, on_);
            if chk.failed { return; }
            rw_sel_gate(p.sel_expr(), sc, reg, chk);
            if chk.failed { return; }
            p.sel = rw_expr(p.sel, sc, reg, h, chk);
        }
        RExpr::Distinct(d) => { rw_walk(d.input, sc, reg, h, chk, occ_c, ow, orel, on_); }
        RExpr::Limit(l)    => { rw_walk(l.input, sc, reg, h, chk, occ_c, ow, orel, on_); }
        RExpr::Fix(_fx)    => { }
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// The EXECUTOR — materialized Vec<row> pipelines over the RExpr tree (§7).
// ═══════════════════════════════════════════════════════════════════════════

const RS_VARS: i64 = 12i64;

// ── RelCtx — the RUNTIME rel materialization state (I3) ─────────────────────
// One per `run`: per-rel row storage (flat Vec<RtVal>, stride = the rel's
// column count) + the semi-naïve WATERMARKS. The single storage Vec holds
// every distinct row ever derived, in first-derivation order; the regions are
//   total = rows[0 .. tot)         (includes the current delta — the
//                                   post-promote binding, static parity)
//   delta = rows[dlo .. dhi)
//   next  = rows[dhi .. len)       (this round's new rows)
// `ovr_w` — the ONE scan-node word reading the DELTA in the current variant
// (the delta-variant loop variable; every other in-SCC occurrence reads the
// total). `hmp` — the SHARED dedup buckets (hash mixes the rel index; bucket
// entries encode (row_idx << 3) | rel).
struct RelCtx {
    n:       i64,
    regp:    i64,           // *const QRelReg
    rowsp:   [i64; 8],      // *mut Vec<RtVal> per rel (READ storage — scans)
    tot:     [i64; 8],
    dlo:     [i64; 8],
    dhi:     [i64; 8],
    ovr_w:   i64,
    hmp:     i64,           // *mut HashMap<u64, Vec<i64>> (READ dedup map)
    // WRITE-REDIRECT (slice-6 DRed over-delete seed): when set, qrel_push_out
    // appends + dedups into THESE instead of rowsp/hmp, while scans still READ
    // rowsp/hmp. This lets the OD seed read the real relation but write the
    // over-delete scratch. Both must be set-or-both-clear (0 = inactive).
    wr_rowsp: [i64; 8],     // *mut Vec<RtVal> per rel (WRITE storage) or 0
    wr_hmp:   i64,          // *mut HashMap<u64, Vec<i64>> (WRITE map) or 0
}

fn relctx_new() -> RelCtx {
    return RelCtx {
        n: 0i64, regp: 0i64, rowsp: [0i64; 8],
        tot: [0i64; 8], dlo: [0i64; 8], dhi: [0i64; 8],
        ovr_w: 0i64, hmp: 0i64,
        wr_rowsp: [0i64; 8], wr_hmp: 0i64,
    };
}

fn rctx_reg<'a>(rctx: *const RelCtx) -> &'a QRelReg {
    return unsafe { &*((&*rctx).regp as *const QRelReg) };
}
fn rctx_rows<'a>(rctx: *const RelCtx, ri: i64) -> &'a Vec<RtVal> {
    return unsafe { &*((&*rctx).rowsp[ri] as *const Vec<RtVal>) };
}
// Watermark/override setters (the raw-pointer indirection keeps the borrow
// regions off the executor's shared reads; array-field writes go through a
// bound &mut).
fn rctx_set_tot(rctx: *mut RelCtx, ri: i64, v: i64) {
    let cm: &mut RelCtx = unsafe { &mut *rctx };
    cm.tot[ri] = v;
}
fn rctx_promote(rctx: *mut RelCtx, ri: i64, len: i64) {
    let cm: &mut RelCtx = unsafe { &mut *rctx };
    cm.dlo[ri] = cm.tot[ri];
    cm.dhi[ri] = len;
    cm.tot[ri] = len;
}
fn rctx_set_ovr(rctx: *mut RelCtx, w: i64) {
    let cm: &mut RelCtx = unsafe { &mut *rctx };
    cm.ovr_w = w;
}
// Force a rel's DELTA region directly (slice-5 IncrRec seed: a manual round-0
// where the delta is the whole existing total [0, hi), not a promote-derived
// watermark). Total is left untouched — the caller manages tot separately.
fn rctx_set_delta(rctx: *mut RelCtx, ri: i64, lo: i64, hi: i64) {
    let cm: &mut RelCtx = unsafe { &mut *rctx };
    cm.dlo[ri] = lo;
    cm.dhi[ri] = hi;
}
// Slice-6 DRed: point rel `ri`'s WRITE target (append + dedup) at separate
// storage/map (raw ptrs as i64) while READs still hit rowsp/hmp. Pass 0/0 to
// clear. Both fields move together (set-or-both-clear invariant).
fn rctx_set_wr(rctx: *mut RelCtx, ri: i64, rows_i: i64, hmp_i: i64) {
    let cm: &mut RelCtx = unsafe { &mut *rctx };
    cm.wr_rowsp[ri] = rows_i;
    cm.wr_hmp = hmp_i;
}

// Dedup-push every row of a body's OutTab into rel `ri` (SET semantics: the
// shared bucket map probes by row hash, verifies cell-wise with rt_eq). New
// rows append at the storage tail — the next-delta region.
fn qrel_push_out(rctx: *mut RelCtx, ri: i64, reg: &QRelReg, out: &OutTab) {
    let nc: i64 = reg.ncols[ri];
    if nc <= 0i64 { return; }
    // WRITE-REDIRECT (slice-6): dedup + append target. When wr_hmp is set the
    // OD seed writes scratch (od_rows/od_rhm) while scans still read rowsp/hmp;
    // the encoded (nrow<<3)|ri indices then key the WRITE storage consistently.
    let wr:  i64 = unsafe { (&*rctx).wr_rowsp[ri] };
    let whm: i64 = unsafe { (&*rctx).wr_hmp };
    let rows_i: i64 = if whm != 0i64 { wr } else { unsafe { (&*rctx).rowsp[ri] } };
    let hm_i:   i64 = if whm != 0i64 { whm } else { unsafe { (&*rctx).hmp } };
    let rows: *mut Vec<RtVal> = rows_i as *mut Vec<RtVal>;
    let hm: *mut HashMap<u64, Vec<i64>> = hm_i as *mut HashMap<u64, Vec<i64>>;
    let mut r: i64 = 0i64;
    while r < out.nrows {
        let mut h: u64 = 14695981039346656037u64;
        h = h_step(h, ri as u64);
        let mut c: i64 = 0i64;
        while c < nc {
            h = h_step(h, rt_key_hash(out.cells.get(r * nc + c)));
            c = c + 1i64;
        }
        let mut dup: bool = false;
        unsafe {
            let vp: *mut Vec<i64> = hm.get_or_insert(h, vec_new::<i64>());
            let bv: &Vec<i64> = &*vp;
            let nb: i64 = bv.len();
            let mut t: i64 = 0i64;
            while t < nb && !dup {
                let enc: i64 = bv.get(t);
                if (enc & 7i64) == ri {
                    let idx: i64 = enc >> 3;
                    let rv: &Vec<RtVal> = &*rows;
                    let mut same: bool = true;
                    let mut c2: i64 = 0i64;
                    while c2 < nc {
                        if !rt_eq(rv.get(idx * nc + c2), out.cells.get(r * nc + c2)) {
                            same = false;
                            break;
                        }
                        c2 = c2 + 1i64;
                    }
                    if same { dup = true; }
                }
                t = t + 1i64;
            }
            if !dup {
                let nrow: i64 = (&*rows).len() / nc;
                vp.push((nrow << 3) | ri);
                let mut c3: i64 = 0i64;
                while c3 < nc {
                    rows.push(out.cells.get(r * nc + c3));
                    c3 = c3 + 1i64;
                }
            }
        }
        r = r + 1i64;
    }
}

// A row set: named columns (row vars) × rows, cells flattened at stride nvars.
struct RowSet {
    vars:  [str; 12],
    nvars: i64,
    cells: Vec<RtVal>,
    nrows: i64,
}

fn rs_new() -> RowSet {
    return RowSet { vars: [""; 12], nvars: 0i64, cells: vec_new::<RtVal>(), nrows: 0i64 };
}

fn rs_vidx(rs: &RowSet, name: str) -> i64 {
    let mut i: i64 = 0i64;
    while i < rs.nvars {
        if str_eq(rs.vars[i], name) { return i; }
        i = i + 1i64;
    }
    return -1i64;
}

fn rs_cell(rs: &RowSet, r: i64, c: i64) -> RtVal {
    return rs.cells.get(r * rs.nvars + c);
}

// Fresh eval binds with ONE slot per row var (slot index == var index).
fn rs_binds(rs: &RowSet) -> RBinds {
    let mut b: RBinds = rbinds_new();
    let mut i: i64 = 0i64;
    while i < rs.nvars {
        b.bind_val(rs.vars[i], RtVal::Null);
        i = i + 1i64;
    }
    return b;
}

// Load row `r`'s cells into the binds (slots 0..nvars).
fn rs_load(rs: &RowSet, r: i64, lb: *mut RBinds) {
    let mut c: i64 = 0i64;
    while c < rs.nvars {
        unsafe { (&mut *lb).set_val(c, rs_cell(rs, r, c)); }
        c = c + 1i64;
    }
}

// Load row `r`'s cells into the binds at slots base..base+nvars (the join
// right-side region — rel-scan rights carry MULTIPLE columns, I3).
fn rs_load_at(rs: &RowSet, r: i64, lb: *mut RBinds, base: i64) {
    let mut c: i64 = 0i64;
    while c < rs.nvars {
        unsafe { (&mut *lb).set_val(base + c, rs_cell(rs, r, c)); }
        c = c + 1i64;
    }
}

// Append row `r` of `src` to `dst` (same column prefix), plus an optional
// extra cell (has_extra) — the join/traversal row extension.
fn rs_push_ext(dst: &mut RowSet, src: &RowSet, r: i64, has_extra: bool, extra: RtVal) {
    let mut c: i64 = 0i64;
    while c < src.nvars {
        dst.cells.push(rs_cell(src, r, c));
        c = c + 1i64;
    }
    if has_extra { dst.cells.push(extra); }
    dst.nrows = dst.nrows + 1i64;
}

// Append left row `r` + right row `j` (ALL right columns — the generalized
// join row extension; env-sourced rights have exactly one column).
fn rs_push_row(dst: &mut RowSet, l: &RowSet, r: i64, rt: &RowSet, j: i64) {
    let mut c: i64 = 0i64;
    while c < l.nvars {
        dst.cells.push(rs_cell(l, r, c));
        c = c + 1i64;
    }
    let mut c2: i64 = 0i64;
    while c2 < rt.nvars {
        dst.cells.push(rs_cell(rt, j, c2));
        c2 = c2 + 1i64;
    }
    dst.nrows = dst.nrows + 1i64;
}

// ── RtVal ordering (sort keys) + hashing (join/distinct keys) ────────────────
// Compare mirrors the eval `<`-family: str via str_cmp, int exactly, else f64.
fn rt_cmp(l: RtVal, r: RtVal) -> i64 {
    if rt_kind(l) == 4i32 && rt_kind(r) == 4i32 { return str_cmp(rt_s(l), rt_s(r)) as i64; }
    if rt_kind(l) == 1i32 && rt_kind(r) == 1i32 {
        let a: i64 = rt_i(l);
        let b: i64 = rt_i(r);
        if a < b { return -1i64; }
        if a > b { return 1i64; }
        return 0i64;
    }
    let lf: f64 = rt_f(l);
    let rf: f64 = rt_f(r);
    if lf < rf { return -1i64; }
    if lf > rf { return 1i64; }
    return 0i64;
}

// FNV-1a over a NORMALIZED (tag, payload) form — RtVal itself needs no Hash
// impl; buckets verify with rt_eq (hash collisions are benign). Only the
// hashable tier (I/S/B) ever reaches this (cascade + distinct rules).
// wrapping_mul: FNV intentionally wraps (bare `*` overflow-traps, Rust parity).
fn h_step(h: u64, b: u64) -> u64 { return wrapping_mul(h ^ b, 1099511628211u64); }

fn rt_key_hash(v: RtVal) -> u64 {
    let mut h: u64 = 14695981039346656037u64;
    match v {
        RtVal::I(x) => { h = h_step(h, 1u64); h = h_step(h, x as u64); }
        RtVal::B(b) => { h = h_step(h, 3u64); h = h_step(h, if b { 1u64 } else { 0u64 }); }
        RtVal::S(s) => {
            h = h_step(h, 2u64);
            let n: i64 = s.len();
            let mut i: i64 = 0i64;
            while i < n { h = h_step(h, str_byte_at(s, i) as u64); i = i + 1i64; }
        }
        _ => { h = h_step(h, 0u64); }
    }
    return h;
}

// Residual check: every conjunction term EXCEPT the consumed equi-term must
// hold (the equi/residual split — the probe already established the key).
fn eval_on_residual(on_w: i64, equi_w: i64, cat: &SchemaCatalog, env: &QEnv,
                    lb: *const RBinds, scratch: &Writ) -> bool {
    let onr: WRef<SExpr> = WRef::<SExpr>::from_any(WAny::ref_to(on_w as *const u8));
    let mut tl: TermList = term_list_new();
    split_and_terms(onr, &mut tl);
    let mut i: i64 = 0i64;
    while i < tl.n {
        if tl.w[i] != equi_w {
            if !rt_truthy(eval_sexpr(sx_of(tl.w[i]), cat, env, lb, scratch)) { return false; }
        }
        i = i + 1i64;
    }
    return true;
}

// ── exec_rexpr — the pipeline walk (everything BELOW the projection) ─────────
// `rctx` — the rel materialization context (always valid; n = 0 without rels).
fn exec_rexpr(e: RExpr, cat: &SchemaCatalog, env: &QEnv, qp: &QPlan,
              scratch: &Writ, chk: *mut Chk, rctx: *const RelCtx) -> RowSet {
    if chk_bad(chk) { return rs_new(); }
    match e {
        RExpr::Scan(sc) => {
            // Rel-sourced scan (I3): columns bind as DOTTED RowSet vars
            // ("p.a" — the rel-field rewrite's spelling); the row region is
            // the rel's TOTAL, or its DELTA when this node is the current
            // semi-naïve variant's delta reader.
            let creg: &QRelReg = rctx_reg(rctx);
            let ri: i64 = qreg_find(creg, sc.src_name);
            if ri >= 0i64 {
                let nc: i64 = creg.ncols[ri];
                let mut out: RowSet = rs_new();
                let mut c: i64 = 0i64;
                while c < nc && c < RS_VARS {
                    let mut nm: String = String::new();
                    nm.push_str(sc.var_name);
                    nm.push_str(".");
                    nm.push_str(creg.cnames.get(creg.coff[ri] + c));
                    out.vars[c] = intern_str(scratch, sstr(&nm));
                    c = c + 1i64;
                }
                out.nvars = nc;
                let ctxv: &RelCtx = unsafe { &*rctx };
                let mut lo: i64 = 0i64;
                let mut hi: i64 = ctxv.tot[ri];
                if ctxv.ovr_w != 0i64 && ctxv.ovr_w == sc.as_ref().raw() {
                    lo = ctxv.dlo[ri];
                    hi = ctxv.dhi[ri];
                }
                let rows: &Vec<RtVal> = rctx_rows(rctx, ri);
                let mut r: i64 = lo;
                while r < hi {
                    let mut c2: i64 = 0i64;
                    while c2 < nc {
                        out.cells.push(rows.get(r * nc + c2));
                        c2 = c2 + 1i64;
                    }
                    out.nrows = out.nrows + 1i64;
                    r = r + 1i64;
                }
                return out;
            }
            let mut out: RowSet = rs_new();
            out.vars[0] = sc.var_name;
            out.nvars = 1i64;
            let ei: i64 = env.find(sc.src_name);
            if ei < 0i64 { return out; }   // checker guarantees; defensive
            let av: WAny = WAny::ref_to(env.words[ei] as *const u8);
            if !av.is_array() { return out; }
            let arr: &WArray<WAny> = av.as_array();
            let n: i64 = arr.len();
            let mut i: i64 = 0i64;
            while i < n {
                out.cells.push(wany_to_rt(arr.get(i)));
                out.nrows = out.nrows + 1i64;
                i = i + 1i64;
            }
            return out;
        }
        RExpr::Filter(f) => {
            let input: RowSet = exec_rexpr(f.input_expr(), cat, env, qp, scratch, chk, rctx);
            if chk_bad(chk) { return rs_new(); }
            let mut out: RowSet = rs_new();
            out.vars = input.vars;
            out.nvars = input.nvars;
            let mut b: RBinds = rs_binds(&input);
            let bp: *mut RBinds = &mut b;
            let mut r: i64 = 0i64;
            while r < input.nrows {
                rs_load(&input, r, bp);
                if rt_truthy(eval_sexpr(f.pred_expr(), cat, env, bp, scratch)) {
                    rs_push_ext(&mut out, &input, r, false, RtVal::Null);
                }
                r = r + 1i64;
            }
            return out;
        }
        RExpr::Sort(s) => {
            let input: RowSet = exec_rexpr(s.input_expr(), cat, env, qp, scratch, chk, rctx);
            if chk_bad(chk) { return rs_new(); }
            // per-row keys, then a STABLE O(n²) insertion sort over indices
            // (the static emitter's MVP discipline, re-hosted).
            let mut b: RBinds = rs_binds(&input);
            let bp: *mut RBinds = &mut b;
            let mut keys: Vec<RtVal> = vec_new::<RtVal>();
            let mut r: i64 = 0i64;
            while r < input.nrows {
                rs_load(&input, r, bp);
                keys.push(eval_sexpr(s.key_expr(), cat, env, bp, scratch));
                r = r + 1i64;
            }
            let mut order: Vec<i64> = vec_new::<i64>();
            let mut i: i64 = 0i64;
            while i < input.nrows {
                order.push(i);
                let mut j: i64 = order.len() - 1i64;
                while j > 0i64 {
                    let c: i64 = rt_cmp(keys.get(order.get(j)), keys.get(order.get(j - 1i64)));
                    let swap: bool = if s.desc { c > 0i64 } else { c < 0i64 };
                    if !swap { break; }
                    order.swap(j, j - 1i64);
                    j = j - 1i64;
                }
                i = i + 1i64;
            }
            let mut out: RowSet = rs_new();
            out.vars = input.vars;
            out.nvars = input.nvars;
            let mut k: i64 = 0i64;
            while k < order.len() {
                rs_push_ext(&mut out, &input, order.get(k), false, RtVal::Null);
                k = k + 1i64;
            }
            return out;
        }
        RExpr::Edge(ed) => {
            return exec_edge(ed, cat, env, qp, scratch, chk, rctx);
        }
        RExpr::Join(jn) => {
            let left: RowSet = exec_rexpr(jn.left_expr(), cat, env, qp, scratch, chk, rctx);
            if chk_bad(chk) { return rs_new(); }
            let right: RowSet = exec_rexpr(jn.right_expr(), cat, env, qp, scratch, chk, rctx);
            if chk_bad(chk) { return rs_new(); }
            return exec_join(left, right, jn.on.any().raw(), jn.as_ref().raw(), false,
                             cat, env, qp, scratch, chk);
        }
        RExpr::Anti(an) => {
            let left: RowSet = exec_rexpr(an.left_expr(), cat, env, qp, scratch, chk, rctx);
            if chk_bad(chk) { return rs_new(); }
            let right: RowSet = exec_rexpr(an.right_expr(), cat, env, qp, scratch, chk, rctx);
            if chk_bad(chk) { return rs_new(); }
            return exec_join(left, right, an.on.any().raw(), an.as_ref().raw(), true,
                             cat, env, qp, scratch, chk);
        }
        RExpr::Aggr(g) => {
            return exec_aggr(g, cat, env, qp, scratch, chk, rctx);
        }
        _ => {
            chk_fail_p(chk, "internal: unexpected relational node below the projection root",
                     "", "", "", "");
            return rs_new();
        }
    }
}

// REdge traversal: range the new var over `base_var`'s `path` collection —
// nested-loop by construction (the source depends on the outer row). Runtime
// SHAPE dispatch (the I2 single-node extension): a Writ ARRAY iterates its
// elements; a SINGLE node iterates once; null/absent iterates zero times.
// `is_anti` keeps the outer row iff NO element passes `on` (no `on` ⇒ iff the
// collection is empty).
fn exec_edge(ed: REdge, cat: &SchemaCatalog, env: &QEnv, qp: &QPlan,
             scratch: &Writ, chk: *mut Chk, rctx: *const RelCtx) -> RowSet {
    let input: RowSet = exec_rexpr(ed.input_expr(), cat, env, qp, scratch, chk, rctx);
    if chk_bad(chk) { return rs_new(); }
    let mut out: RowSet = rs_new();
    out.vars = input.vars;
    out.nvars = input.nvars;
    if !ed.is_anti {
        if out.nvars >= RS_VARS {
            chk_fail_p(chk, "too many row variables in the join chain", "", "", "", "");
            return rs_new();
        }
        out.vars[out.nvars] = ed.var_name;
        out.nvars = out.nvars + 1i64;
    }
    let bi: i64 = rs_vidx(&input, ed.base_var);
    if bi < 0i64 { return out; }   // checker guarantees; defensive
    let ps: PathSegs = split_path(ed.path);
    // binds carry input vars + the element var (slot input.nvars)
    let mut b: RBinds = rs_binds(&input);
    b.bind_val(ed.var_name, RtVal::Null);
    let bp: *mut RBinds = &mut b;
    let eslot: i64 = input.nvars;
    let mut r: i64 = 0i64;
    while r < input.nrows && !chk_bad(chk) {
        rs_load(&input, r, bp);
        // walk the path off this row's base node
        let mut cur: RtVal = rs_cell(&input, r, bi);
        let mut i: i64 = 0i64;
        while i < ps.n - 1i64 {
            match cur {
                RtVal::Node(w) => {
                    if w.is_array() {
                        chk_fail_p(chk, "traversal path '", ed.path,
                                 "' crosses a collection before its final segment — intermediate steps must be single-node edges",
                                 "", "");
                        return rs_new();
                    }
                    cur = field_read(cat, w, ps.segs[i]);
                }
                _ => { cur = RtVal::Null; }
            }
            i = i + 1i64;
        }
        let mut fin: RtVal = RtVal::Null;
        match cur {
            RtVal::Node(w2) => {
                if !w2.is_array() && ps.n > 0i64 { fin = field_read(cat, w2, ps.segs[ps.n - 1i64]); }
            }
            _ => { }
        }
        // iterate the final value's elements (array / single / none)
        let mut matched: bool = false;
        match fin {
            RtVal::Node(w3) => {
                if w3.is_array() {
                    let arr: &WArray<WAny> = w3.as_array();
                    let n: i64 = arr.len();
                    let mut j: i64 = 0i64;
                    while j < n {
                        let ev: RtVal = wany_to_rt(arr.get(j));
                        unsafe { (&mut *bp).set_val(eslot, ev); }
                        let mut pass: bool = true;
                        if ed.has_on {
                            pass = rt_truthy(eval_sexpr(ed.on_expr(), cat, env, bp, scratch));
                        }
                        if pass {
                            matched = true;
                            if !ed.is_anti { rs_push_ext(&mut out, &input, r, true, ev); }
                        }
                        j = j + 1i64;
                    }
                } else {
                    // SINGLE-NODE edge: iterate exactly this one element
                    let ev1: RtVal = RtVal::Node(w3);
                    unsafe { (&mut *bp).set_val(eslot, ev1); }
                    let mut pass1: bool = true;
                    if ed.has_on {
                        pass1 = rt_truthy(eval_sexpr(ed.on_expr(), cat, env, bp, scratch));
                    }
                    if pass1 {
                        matched = true;
                        if !ed.is_anti { rs_push_ext(&mut out, &input, r, true, ev1); }
                    }
                }
            }
            _ => { }   // null / absent: zero elements
        }
        if ed.is_anti && !matched {
            rs_push_ext(&mut out, &input, r, false, RtVal::Null);
        }
        r = r + 1i64;
    }
    return out;
}

// One keyed/loop join step over materialized sides. The tier was decided at
// check time from CHECKED types (qp); hash buckets key on the FNV of the
// NORMALIZED RtVal and verify with rt_eq (collision-safe). The right side
// carries ONE column for env-sourced scans and ncols columns for rel-sourced
// scans (I3) — the extension is column-count generic.
fn exec_join(left: RowSet, right: RowSet, on_w: i64, node_w: i64, anti: bool,
             cat: &SchemaCatalog, env: &QEnv, qp: &QPlan,
             scratch: &Writ, chk: *mut Chk) -> RowSet {
    let mut out: RowSet = rs_new();
    out.vars = left.vars;
    out.nvars = left.nvars;
    if !anti {
        if left.nvars + right.nvars > RS_VARS {
            chk_fail_p(chk, "too many row variables in the join chain", "", "", "", "");
            return rs_new();
        }
        let mut vc: i64 = 0i64;
        while vc < right.nvars {
            out.vars[left.nvars + vc] = right.vars[vc];
            vc = vc + 1i64;
        }
        out.nvars = left.nvars + right.nvars;
    }
    let ji: i64 = qp_jfind(qp, node_w);
    let tier: i32 = if ji >= 0i64 { qp.jtier[ji] } else { QT_LOOP };

    // combined binds: left vars at slots 0.., right vars from slot left.nvars
    if left.nvars + right.nvars > RS_VARS {
        chk_fail_p(chk, "too many row variables in the join chain", "", "", "", "");
        return rs_new();
    }
    let mut cb: RBinds = rs_binds(&left);
    let mut vb: i64 = 0i64;
    while vb < right.nvars {
        cb.bind_val(right.vars[vb], RtVal::Null);
        vb = vb + 1i64;
    }
    let cbp: *mut RBinds = &mut cb;
    let rslot: i64 = left.nvars;

    if tier == QT_HASH {
        // ── build once over the NEW side ──
        let mut rkeys: Vec<RtVal> = vec_new::<RtVal>();
        let mut hm: HashMap<u64, Vec<i64>> = hashmap_new::<u64, Vec<i64>>();
        let mp: *mut HashMap<u64, Vec<i64>> = &mut hm;
        {
            let mut rb: RBinds = rs_binds(&right);
            let rbp: *mut RBinds = &mut rb;
            let mut j: i64 = 0i64;
            while j < right.nrows {
                rs_load(&right, j, rbp);
                let bk: RtVal = eval_sexpr(sx_of(qp.jbuild[ji]), cat, env, rbp, scratch);
                rkeys.push(bk);
                unsafe {
                    let vp: *mut Vec<i64> = mp.get_or_insert(rt_key_hash(bk), vec_new::<i64>());
                    vp.push(j);
                }
                j = j + 1i64;
            }
        }
        // ── probe per bound row ──
        let mut r: i64 = 0i64;
        while r < left.nrows {
            rs_load(&left, r, cbp);
            let pk: RtVal = eval_sexpr(sx_of(qp.jprobe[ji]), cat, env, cbp, scratch);
            let hp: u64 = rt_key_hash(pk);
            let bp2: *const Vec<i64> = unsafe { mp.get(&hp) };
            let mut matched: bool = false;
            if (bp2 as i64) != 0i64 {
                let bucket: &Vec<i64> = unsafe { &*bp2 };
                let nb: i64 = bucket.len();
                let mut t: i64 = 0i64;
                while t < nb {
                    let j2: i64 = bucket.get(t);
                    if rt_eq(pk, rkeys.get(j2)) {
                        rs_load_at(&right, j2, cbp, rslot);
                        if eval_on_residual(on_w, qp.jequi[ji], cat, env, cbp, scratch) {
                            matched = true;
                            if !anti {
                                rs_push_row(&mut out, &left, r, &right, j2);
                            }
                        }
                    }
                    t = t + 1i64;
                }
            }
            if anti && !matched {
                rs_push_ext(&mut out, &left, r, false, RtVal::Null);
            }
            r = r + 1i64;
        }
        return out;
    }

    // ── nested-loop tier: the FULL predicate per pair ──
    let on_e: SExpr = sx_of(on_w);
    let mut r2: i64 = 0i64;
    while r2 < left.nrows {
        rs_load(&left, r2, cbp);
        let mut matched2: bool = false;
        let mut j3: i64 = 0i64;
        while j3 < right.nrows {
            rs_load_at(&right, j3, cbp, rslot);
            if rt_truthy(eval_sexpr(on_e, cat, env, cbp, scratch)) {
                matched2 = true;
                if !anti {
                    rs_push_row(&mut out, &left, r2, &right, j3);
                }
            }
            j3 = j3 + 1i64;
        }
        if anti && !matched2 {
            rs_push_ext(&mut out, &left, r2, false, RtVal::Null);
        }
        r2 = r2 + 1i64;
    }
    return out;
}

// γ — single-pass grouping in FIRST-OCCURRENCE order (the static two-pass
// discipline's observable order), accumulators per the SHARED rule table:
// count→INT, sum/min/max→arg type, avg→f64 always (exact mean), UDA→the
// registered init/step/fin triple over RtVal accumulators.
fn exec_aggr(g: RAggr, cat: &SchemaCatalog, env: &QEnv, qp: &QPlan,
             scratch: &Writ, chk: *mut Chk, rctx: *const RelCtx) -> RowSet {
    let input: RowSet = exec_rexpr(g.input_expr(), cat, env, qp, scratch, chk, rctx);
    if chk_bad(chk) { return rs_new(); }
    let aggs: RAggArr = g.aggs_arr();
    let an: i64 = qp.agg_n;
    let mut b: RBinds = rs_binds(&input);
    let bp: *mut RBinds = &mut b;
    let mut gkeys: Vec<RtVal> = vec_new::<RtVal>();
    let mut gacc:  Vec<RtVal> = vec_new::<RtVal>();   // stride an
    let mut gcnt:  Vec<i64>   = vec_new::<i64>();
    let mut r: i64 = 0i64;
    while r < input.nrows {
        rs_load(&input, r, bp);
        let k: RtVal = eval_sexpr(g.key_expr(), cat, env, bp, scratch);
        // group lookup by VALUE equality (rt_eq — group counts are small; a
        // keyed index is a later optimization, mirrors the static O(n²) MVP)
        let mut gi: i64 = -1i64;
        let mut x: i64 = 0i64;
        while x < gkeys.len() {
            if rt_eq(gkeys.get(x), k) { gi = x; break; }
            x = x + 1i64;
        }
        if gi < 0i64 {
            gi = gkeys.len();
            gkeys.push(k);
            gcnt.push(0i64);
            let mut c0: i64 = 0i64;
            while c0 < an {
                let fnid: i32 = qp.agg_fnid[c0];
                let isf: bool = qp.agg_ret[c0] == CT_FLT;
                if fnid == 1i32      { gacc.push(RtVal::I(0i64)); }
                else if fnid == 2i32 { if isf { gacc.push(RtVal::F(0.0f64)); } else { gacc.push(RtVal::I(0i64)); } }
                else if fnid == 3i32 { if isf { gacc.push(RtVal::F(1.7976931348623157e308f64)); } else { gacc.push(RtVal::I(9223372036854775807i64)); } }
                else if fnid == 4i32 { if isf { gacc.push(RtVal::F(-1.7976931348623157e308f64)); } else { gacc.push(RtVal::I(-9223372036854775807i64 - 1i64)); } }
                else if fnid == 5i32 { gacc.push(RtVal::F(0.0f64)); }
                else {
                    let init: QAggInit = env.a_init[qp.agg_uda[c0]];
                    gacc.push(init());
                }
                c0 = c0 + 1i64;
            }
        }
        gcnt.set(gi, gcnt.get(gi) + 1i64);
        let mut c: i64 = 0i64;
        while c < an {
            let a: RAgg = aggs.agg_at(c);
            let fnid2: i32 = qp.agg_fnid[c];
            let isf2: bool = qp.agg_ret[c] == CT_FLT;
            let cur: RtVal = gacc.get(gi * an + c);
            let mut nv: RtVal = cur;
            if fnid2 == 1i32 {
                nv = RtVal::I(rt_i(cur) + 1i64);
            } else {
                let av: RtVal = eval_sexpr(a.arg_expr(), cat, env, bp, scratch);
                if fnid2 == 2i32 {
                    if isf2 { nv = RtVal::F(rt_f(cur) + rt_f(av)); }
                    else    { nv = RtVal::I(rt_i(cur) + rt_i(av)); }
                } else if fnid2 == 3i32 {
                    if isf2 { if rt_f(av) < rt_f(cur) { nv = RtVal::F(rt_f(av)); } }
                    else    { if rt_i(av) < rt_i(cur) { nv = RtVal::I(rt_i(av)); } }
                } else if fnid2 == 4i32 {
                    if isf2 { if rt_f(av) > rt_f(cur) { nv = RtVal::F(rt_f(av)); } }
                    else    { if rt_i(av) > rt_i(cur) { nv = RtVal::I(rt_i(av)); } }
                } else if fnid2 == 5i32 {
                    nv = RtVal::F(rt_f(cur) + rt_f(av));
                } else {
                    let step: QAggStep = env.a_step[qp.agg_uda[c]];
                    nv = step(cur, av);
                }
            }
            gacc.set(gi * an + c, nv);
            c = c + 1i64;
        }
        r = r + 1i64;
    }
    // materialize group rows: vars = key + output names
    let mut out: RowSet = rs_new();
    out.vars[0] = "key";
    let mut cn: i64 = 0i64;
    while cn < an {
        let a2: RAgg = aggs.agg_at(cn);
        out.vars[1i64 + cn] = a2.out;
        cn = cn + 1i64;
    }
    out.nvars = 1i64 + an;
    let mut gi2: i64 = 0i64;
    while gi2 < gkeys.len() {
        out.cells.push(gkeys.get(gi2));
        let mut c2: i64 = 0i64;
        while c2 < an {
            let acc: RtVal = gacc.get(gi2 * an + c2);
            let fnid3: i32 = qp.agg_fnid[c2];
            if fnid3 == 5i32 {
                // avg — ALWAYS FLT via the rule table (Quot(INT)=Quot(FLT)=FLT)
                out.cells.push(RtVal::F(rt_f(acc) / (gcnt.get(gi2) as f64)));
            } else if fnid3 == 0i32 {
                let fin: QAggFin = env.a_fin[qp.agg_uda[c2]];
                out.cells.push(fin(acc));
            } else {
                out.cells.push(acc);
            }
            c2 = c2 + 1i64;
        }
        out.nrows = out.nrows + 1i64;
        gi2 = gi2 + 1i64;
    }
    return out;
}

// ── The OUTPUT table (projected values) + the wrapper walk ──────────────────
struct OutTab { ncols: i64, cells: Vec<RtVal>, nrows: i64 }

fn ot_new(nc: i64) -> OutTab {
    return OutTab { ncols: nc, cells: vec_new::<RtVal>(), nrows: 0i64 };
}

// exec_root — RLimit?( RDistinct?( RProj( pipeline ) ) ).
fn exec_root(e: RExpr, cat: &SchemaCatalog, env: &QEnv, qp: &QPlan,
             scratch: &Writ, chk: *mut Chk, rctx: *const RelCtx) -> OutTab {
    if chk_bad(chk) { return ot_new(0i64); }
    match e {
        RExpr::Limit(l) => {
            let inner: OutTab = exec_root(l.input_expr(), cat, env, qp, scratch, chk, rctx);
            if chk_bad(chk) { return ot_new(0i64); }
            let mut n: i64 = l.n;
            if l.is_param {
                let ei: i64 = env.find(l.param);
                n = if ei >= 0i64 { env.ivals[ei] } else { 0i64 };
            }
            if n < 0i64 { n = 0i64; }
            if n >= inner.nrows { return inner; }
            let mut out: OutTab = ot_new(inner.ncols);
            let mut i: i64 = 0i64;
            while i < n * inner.ncols {
                out.cells.push(inner.cells.get(i));
                i = i + 1i64;
            }
            out.nrows = n;
            return out;
        }
        RExpr::Distinct(d) => {
            let inner: OutTab = exec_root(d.input_expr(), cat, env, qp, scratch, chk, rctx);
            if chk_bad(chk) { return ot_new(0i64); }
            // set semantics: row-hash buckets + full rt_eq verification
            let mut out: OutTab = ot_new(inner.ncols);
            let mut hm: HashMap<u64, Vec<i64>> = hashmap_new::<u64, Vec<i64>>();
            let mp: *mut HashMap<u64, Vec<i64>> = &mut hm;
            let mut r: i64 = 0i64;
            while r < inner.nrows {
                let mut h: u64 = 1469598103934665603u64;
                let mut c: i64 = 0i64;
                while c < inner.ncols {
                    h = h_step(h, rt_key_hash(inner.cells.get(r * inner.ncols + c)));
                    c = c + 1i64;
                }
                let mut dup: bool = false;
                unsafe {
                    let vp: *mut Vec<i64> = mp.get_or_insert(h, vec_new::<i64>());
                    let bv: &Vec<i64> = &*vp;
                    let nb: i64 = bv.len();
                    let mut t: i64 = 0i64;
                    while t < nb && !dup {
                        let o: i64 = bv.get(t);
                        let mut same: bool = true;
                        let mut c2: i64 = 0i64;
                        while c2 < inner.ncols {
                            if !rt_eq(out.cells.get(o * inner.ncols + c2),
                                      inner.cells.get(r * inner.ncols + c2)) {
                                same = false;
                                break;
                            }
                            c2 = c2 + 1i64;
                        }
                        if same { dup = true; }
                        t = t + 1i64;
                    }
                    if !dup {
                        vp.push(out.nrows);
                    }
                }
                if !dup {
                    let mut c3: i64 = 0i64;
                    while c3 < inner.ncols {
                        out.cells.push(inner.cells.get(r * inner.ncols + c3));
                        c3 = c3 + 1i64;
                    }
                    out.nrows = out.nrows + 1i64;
                }
                r = r + 1i64;
            }
            return out;
        }
        RExpr::Proj(p) => {
            let rs: RowSet = exec_rexpr(p.input_expr(), cat, env, qp, scratch, chk, rctx);
            if chk_bad(chk) { return ot_new(0i64); }
            let mut b: RBinds = rs_binds(&rs);
            let bp: *mut RBinds = &mut b;
            let sel: SExpr = p.sel_expr();
            let mut out: OutTab = ot_new(qp.ncols);
            let mut r: i64 = 0i64;
            while r < rs.nrows {
                rs_load(&rs, r, bp);
                match sel {
                    SExpr::Tuple(tp) => {
                        let items: SExprArr = tp.items_arr();
                        let nn: i64 = items.len();
                        let mut c: i64 = 0i64;
                        while c < nn {
                            out.cells.push(eval_sexpr(items.arg_at(c), cat, env, bp, scratch));
                            c = c + 1i64;
                        }
                    }
                    _ => {
                        out.cells.push(eval_sexpr(sel, cat, env, bp, scratch));
                    }
                }
                out.nrows = out.nrows + 1i64;
                r = r + 1i64;
            }
            return out;
        }
        _ => {
            chk_fail_p(chk, "internal: unexpected plan root", "", "", "", "");
            return ot_new(0i64);
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// QRows — the materialized result (ADR §3). SELF-CONTAINED: every string cell
// is interned into the QRows-OWNED Writ arena at materialization, so rows
// outlive the run's scratch AND the Query itself. Node cells (identity/find
// projections) are handles into the CALLER's data doc — the caller keeps it
// alive while reading them (the bind_source contract).
// ═══════════════════════════════════════════════════════════════════════════
pub struct QRows {
    arena: Writ,
    ncols: i64,
    kinds: [i32; 8],   // CT_* per column (checker-stamped)
    cells: Vec<RtVal>,
    nrows: i64,
}

impl QRows {
    pub fn row_count(self: &QRows) -> i64 { return self.nrows; }
    pub fn col_count(self: &QRows) -> i64 { return self.ncols; }
    // Option-shaped accessor for `select first` / `find`: did a row match?
    pub fn is_some(self: &QRows) -> bool { return self.nrows > 0i64; }

    fn cell(self: &QRows, r: i64, c: i64) -> RtVal {
        if r < 0i64 || r >= self.nrows || c < 0i64 || c >= self.ncols { return RtVal::Null; }
        return self.cells.get(r * self.ncols + c);
    }

    pub fn get_i64(self: &QRows, r: i64, c: i64) -> i64 { return rt_i(self.cell(r, c)); }
    pub fn get_f64(self: &QRows, r: i64, c: i64) -> f64 { return rt_f(self.cell(r, c)); }
    pub fn get_bool(self: &QRows, r: i64, c: i64) -> bool { return rt_b(self.cell(r, c)); }
    // The view is owned by THIS QRows (interned) — valid while it lives.
    pub fn get_str(self: &QRows, r: i64, c: i64) -> str { return rt_s(self.cell(r, c)); }
    // A row-object handle (identity / `find` projections).
    pub fn get_node(self: &QRows, r: i64, c: i64) -> WAny { return rt_node(self.cell(r, c)); }
    // Is the cell Null? (LENIENT projections may carry Null — ADR §4; the
    // typed getters return zero-values for it, this is the distinguishing
    // probe. Out-of-range reads also report null.)
    pub fn is_null(self: &QRows, r: i64, c: i64) -> bool {
        return rt_kind(self.cell(r, c)) == 0i32;
    }

    // The column's checked type name: "i64"/"str"/"bool"/"f64"/"node"/"dyn"/"".
    pub fn col_ty(self: &QRows, c: i64) -> str {
        if c < 0i64 || c >= self.ncols { return ""; }
        let t: i32 = self.kinds[c];
        if t == CT_INT  { return "i64"; }
        if t == CT_STR  { return "str"; }
        if t == CT_BOOL { return "bool"; }
        if t == CT_FLT  { return "f64"; }
        if t == CT_NODE { return "node"; }
        if t == CT_DYN  { return "dyn"; }   // lenient column (runtime-typed)
        return "";
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// QBodyTab — the compiled rel BODIES (I3): per body the owning rel, the
// simplified RExpr root, the queue-1 empty signal, and the body's in-SCC
// occurrence window into the flat (ow, orel) arrays — the semi-naïve delta
// variants (scan-node words; VARIANT = which one reads the delta).
// ═══════════════════════════════════════════════════════════════════════════
const QBODY_MAX: i64 = 64i64;   // 8 rels × 8 bodies (grammar caps)
const QOCC_MAX:  i64 = 96i64;

pub struct QBodyTab {
    n:       i64,
    owner:   Vec<i64>,
    root:    Vec<i64>,
    empty:   Vec<i64>,    // 0/1 (Vec-backed for the same small-Query reason)
    occ_off: Vec<i64>,
    occ_n:   Vec<i64>,
    ow:      Vec<i64>,
    orel:    Vec<i64>,
    on:      i64,
}

fn qbodytab_new() -> QBodyTab {
    return QBodyTab {
        n: 0i64, owner: vec_new::<i64>(), root: vec_new::<i64>(),
        empty: vec_new::<i64>(),
        occ_off: vec_new::<i64>(), occ_n: vec_new::<i64>(),
        ow: vec_new::<i64>(), orel: vec_new::<i64>(), on: 0i64,
    };
}

// Total ROW count of rel `ri` (the storage Vec is cell-flat at stride nc).
fn qrel_len(rctx: *const RelCtx, ri: i64, nc: i64) -> i64 {
    if nc <= 0i64 { return 0i64; }
    return rctx_rows(rctx, ri).len() / nc;
}

// ═══════════════════════════════════════════════════════════════════════════
// Query — compile-once / run-many dynamic query (ADR §3).
// ═══════════════════════════════════════════════════════════════════════════
pub struct Query {
    doc:      Writ,            // owns the parsed plan + lowered algebra
    root:     i64,             // simplified ENTRY RExpr root word (into `doc`)
    empty:    bool,            // queue-1 empty signal → zero-row fast path
    sel_mode: i32,             // QM_ALL / QM_FIRST / QM_FIND
    cat:      SchemaCatalog,   // catalog snapshot (Vec-backed, small)
    reg:      QRelReg,         // rel registry + SCC condensation (I3)
    bodies:   QBodyTab,        // compiled rel bodies + delta-variant occs (I3)
}

// One rel body's SELECT WIDTH vs the declared column count (compile-time; the
// TYPES check runs in the strict phase where env sources resolve).
fn qrel_body_width(root: RExpr, reg: &QRelReg, ri: i64, chk: &mut Chk) {
    let nc: i64 = reg.ncols[ri];
    match root {
        RExpr::Proj(p) => {
            let sel: SExpr = p.sel_expr();
            match sel {
                SExpr::Tuple(tp) => {
                    if nc == 1i64 {
                        chk_fail(chk, "rel '", reg.names[ri],
                                 "' declares 1 column — the body select must be a single expression",
                                 "", "");
                        return;
                    }
                    if tp.items_arr().len() != nc {
                        chk_fail(chk, "rel '", reg.names[ri],
                                 "': the select tuple width does not match the declared column count",
                                 "", "");
                    }
                }
                _ => {
                    if nc >= 2i64 {
                        chk_fail(chk, "rel '", reg.names[ri],
                                 "' declares multiple columns — the body select must be a tuple of exactly that many components",
                                 "", "");
                    }
                }
            }
        }
        _ => { }   // collapsed/empty body shapes carry no projection to check
    }
}

// Execute ONE rel body (its own RExpr pipeline through the SHARED executor —
// rel-sourced scans/joins included) and dedup-push the projected rows.
fn qrel_run_body(q: &Query, b: i64, env: &QEnv, qp: &QPlan, scratch: &Writ,
                 rctx: *mut RelCtx, chk: *mut Chk) {
    let broot: RExpr = WAny::ref_to(q.bodies.root.get(b) as *const u8).view::<RExpr>();
    let out: OutTab = exec_root(broot, &q.cat, env, qp, scratch, chk, rctx as *const RelCtx);
    if chk_bad(chk) { return; }
    qrel_push_out(rctx, q.bodies.owner.get(b), &q.reg, &out);
}

// ── The REL MATERIALIZER (I3) — the semi-naïve fixpoint AS AN INTERPRETER
// LOOP, re-hosting the static emitter's algorithm (rexpr_walk::emit_scc_fn):
// SCCs materialize in condensation-TOPO order; a non-recursive rel runs its
// bodies once; a RECURSIVE SCC seeds (bodies with no in-SCC source), then
// loops PROMOTE → EXIT → VARIANTS until every member delta is empty (least
// fixpoint — set semantics over the shared dedup buckets). A body with k
// in-SCC source occurrences runs k delta variants per round: the VARIANT IS A
// LOOP VARIABLE (rctx.ovr_w — which scan node reads the delta); no IR is
// rewritten. TERMINATION is the standard Datalog contract: guaranteed for
// non-generative programs (every round either adds a new tuple from a finite
// universe or the deltas empty out); recursive heads that MINT values
// (arithmetic) can diverge — deliberately NOT capped (a silent iteration cap
// would change semantics; static parity).
fn qrel_materialize(q: &Query, env: &QEnv, qp: &QPlan, scratch: &Writ,
                    rctx: *mut RelCtx, chk: *mut Chk) {
    let reg: &QRelReg = &q.reg;
    let mut p: i64 = 0i64;
    while p < reg.nscc && !chk_bad(chk) {
        let c: i64 = reg.order[p];
        if !reg.rec[c] {
            // ── one-shot stratum: materialize each member once ──
            let mut r: i64 = 0i64;
            while r < reg.n && !chk_bad(chk) {
                if reg.comp[r] == c {
                    let mut b: i64 = 0i64;
                    while b < q.bodies.n && !chk_bad(chk) {
                        if q.bodies.owner.get(b) == r && q.bodies.empty.get(b) == 0i64 {
                            qrel_run_body(q, b, env, qp, scratch, rctx, chk);
                        }
                        b = b + 1i64;
                    }
                    rctx_set_tot(rctx, r, qrel_len(rctx as *const RelCtx, r, reg.ncols[r]));
                }
                r = r + 1i64;
            }
        } else {
            // ── SEED: bodies with NO in-SCC occurrence run once (their rows
            // land past tot=0 — the first round's delta). ──
            let mut m: i64 = 0i64;
            while m < reg.n && !chk_bad(chk) {
                if reg.comp[m] == c {
                    let mut b1: i64 = 0i64;
                    while b1 < q.bodies.n && !chk_bad(chk) {
                        if q.bodies.owner.get(b1) == m && q.bodies.occ_n.get(b1) == 0i64
                           && q.bodies.empty.get(b1) == 0i64 {
                            qrel_run_body(q, b1, env, qp, scratch, rctx, chk);
                        }
                        b1 = b1 + 1i64;
                    }
                }
                m = m + 1i64;
            }
            loop {
                if chk_bad(chk) { break; }
                // PROMOTE: delta ← next-delta; total ∪= delta (watermarks
                // over the single append-only storage — total is always a
                // prefix). EXIT when every member delta is empty.
                let mut any: bool = false;
                let mut m2: i64 = 0i64;
                while m2 < reg.n {
                    if reg.comp[m2] == c {
                        let len2: i64 = qrel_len(rctx as *const RelCtx, m2, reg.ncols[m2]);
                        rctx_promote(rctx, m2, len2);
                        if unsafe { (&*rctx).dlo[m2] } < len2 { any = true; }
                    }
                    m2 = m2 + 1i64;
                }
                if !any { break; }   // least fixpoint reached
                // VARIANTS: recursive bodies × their in-SCC occurrences.
                let mut m3: i64 = 0i64;
                while m3 < reg.n && !chk_bad(chk) {
                    if reg.comp[m3] == c {
                        let mut b2: i64 = 0i64;
                        while b2 < q.bodies.n && !chk_bad(chk) {
                            if q.bodies.owner.get(b2) == m3 && q.bodies.occ_n.get(b2) > 0i64
                               && q.bodies.empty.get(b2) == 0i64 {
                                let off: i64 = q.bodies.occ_off.get(b2);
                                let k: i64 = q.bodies.occ_n.get(b2);
                                let mut v: i64 = 0i64;
                                while v < k && !chk_bad(chk) {
                                    rctx_set_ovr(rctx, q.bodies.ow.get(off + v));
                                    qrel_run_body(q, b2, env, qp, scratch, rctx, chk);
                                    v = v + 1i64;
                                }
                                rctx_set_ovr(rctx, 0i64);
                            }
                            b2 = b2 + 1i64;
                        }
                    }
                    m3 = m3 + 1i64;
                }
            }
        }
        p = p + 1i64;
    }
}

impl Query {
    // parse → rel registration/validation/SCC/stratification (I3) → envelope
    // validation → lower (REUSED) → simplify (REUSED) → rel-field rewrite →
    // env-independent checks. Errors are VALUES.
    pub fn compile(text: str, cat: &SchemaCatalog) -> Result<Query, QError> {
        let doc: Writ = writ_new(8192i64);
        let prog_any: WAny = parse_program(text, &doc);
        if prog_any.is_null() {
            return Result::Err(qerr("Query::compile: parse error — expected `[rel NAME(col: ty, …){ body; … }]* from <src> <var> [ [anti] join … on … ]* [where …] [group by … aggregate …] select …` (or `from <src> <var> find <pred>`)"));
        }
        let prog: RQProgram = prog_any.view::<RQProgram>();
        let mut reg: QRelReg = qrelreg_new();
        let mut bodies: QBodyTab = qbodytab_new();
        let mut chk: Chk = chk_new();
        chk.defer_unknown_fn = true;
        let mut qp: QPlan = qplan_new();
        let e0: QEnv = QEnv::new();

        if prog.has_rels() {
            let rels: RQRelArr = prog.rels_arr();
            let nr: i64 = rels.len();
            if nr > QREL_MAX {
                return Result::Err(qerr("Query::compile: too many rel blocks (max 8)"));
            }
            // ── pass 1: register names + typed columns ──────────────────────
            let mut flat: i64 = 0i64;
            let mut i: i64 = 0i64;
            while i < nr {
                let rel: RQRel = rels.rel_at(i);
                if qreg_find(&reg, rel.name) >= 0i64 {
                    return Result::Err(qfail("duplicate rel name '", rel.name, "'", "", ""));
                }
                let cols: RQRelColArr = rel.cols_arr();
                let nc: i64 = cols.len();
                if nc < 1i64 {
                    return Result::Err(qfail("rel '", rel.name, "' needs at least one column", "", ""));
                }
                if flat + nc > QRELC_MAX {
                    return Result::Err(qerr("Query::compile: too many rel columns"));
                }
                reg.names[i] = rel.name;
                reg.ncols[i] = 0i64;   // grows as columns validate (qreg_col
                                       // scans the validated window)
                reg.coff[i]  = flat;
                reg.n = i + 1i64;
                let mut k: i64 = 0i64;
                while k < nc {
                    let col: RQRelCol = cols.col_at(k);
                    let tn: str = col.ty_name;
                    let mut ctt: i32 = -1i32;
                    if str_eq(tn, "i64")       { ctt = CT_INT; }
                    else if str_eq(tn, "str")  { ctt = CT_STR; }
                    else if str_eq(tn, "bool") { ctt = CT_BOOL; }
                    if ctt < 0i32 {
                        if str_eq(tn, "f64") || str_eq(tn, "f32") {
                            return Result::Err(qfail("rel column '", col.name,
                                     "': f64 columns are not allowed (set semantics require Eq)",
                                     "", ""));
                        }
                        return Result::Err(qfail("rel '", rel.name, "' column '", col.name,
                                 "': unsupported column type — rel columns are i64 / str / bool"));
                    }
                    // per-rel column-name uniqueness
                    if qreg_col(&reg, i, col.name) >= 0i64 {
                        return Result::Err(qfail("rel '", rel.name, "': duplicate column name '",
                                 col.name, "'"));
                    }
                    reg.cnames.push(col.name);
                    reg.ctys.push(ctt as i64);
                    // grow the visible window as we validate (qreg_col scans it)
                    reg.ncols[i] = k + 1i64;
                    k = k + 1i64;
                }
                reg.ncols[i] = nc;
                flat = flat + nc;
                i = i + 1i64;
            }
            // ── pass 2: body shape gates + dependency edges (plan level) ────
            let mut deps: RelDeps = rel_deps_new();
            let mut i2: i64 = 0i64;
            while i2 < nr {
                let rel2: RQRel = rels.rel_at(i2);
                let barr: RQBodyArr = rel2.bodies_arr();
                let nb: i64 = barr.len();
                if nb < 1i64 {
                    return Result::Err(qfail("rel '", rel2.name, "' needs at least one body", "", ""));
                }
                let mut b: i64 = 0i64;
                while b < nb {
                    let q2: RQuery = barr.body_any(b).view::<RQuery>();
                    match q2 {
                        RQuery::Simple(s) => {
                            if s.sel_first || s.distinct || s.has_order || s.has_limit
                               || s.has_result_ty {
                                return Result::Err(qfail("rel '", rel2.name,
                                         "': select-tail modifiers (first/distinct/order/limit/`: Ty`) are not allowed in a rel body — bodies produce relations",
                                         "", ""));
                            }
                            let ri: i64 = qreg_find(&reg, s.src_name);
                            if ri >= 0i64 { deps.add(i2, ri); }
                        }
                        RQuery::Join(j) => {
                            if j.sel_first || j.distinct || j.has_order || j.has_limit
                               || j.has_result_ty {
                                return Result::Err(qfail("rel '", rel2.name,
                                         "': select-tail modifiers (first/distinct/order/limit/`: Ty`) are not allowed in a rel body — bodies produce relations",
                                         "", ""));
                            }
                            let ri2: i64 = qreg_find(&reg, j.a_name);
                            if ri2 >= 0i64 { deps.add(i2, ri2); }
                            let steps: RQJoinStepArr = j.steps_arr();
                            let ns: i64 = steps.len();
                            let mut si: i64 = 0i64;
                            while si < ns {
                                let st: RQJoinStep = steps.step_at(si);
                                if !st.is_edge {
                                    let ri3: i64 = qreg_find(&reg, st.src_name);
                                    if ri3 >= 0i64 {
                                        deps.add(i2, ri3);
                                        if st.is_anti { deps.add_anti(i2, ri3); }
                                    }
                                }
                                si = si + 1i64;
                            }
                        }
                        RQuery::Aggr(g) => {
                            // Rejected either way — but the DIAGNOSTIC is
                            // chosen POST-SCC (in-SCC ⇒ the cycle error), so
                            // only record the edges here (static parity).
                            let ri4: i64 = qreg_find(&reg, g.a_name);
                            if ri4 >= 0i64 { deps.add(i2, ri4); deps.add_agg(i2, ri4); }
                            if g.has_steps() {
                                let gsteps: RQJoinStepArr = g.steps_arr();
                                let gn: i64 = gsteps.len();
                                let mut gi: i64 = 0i64;
                                while gi < gn {
                                    let gst: RQJoinStep = gsteps.step_at(gi);
                                    if !gst.is_edge {
                                        let ri5: i64 = qreg_find(&reg, gst.src_name);
                                        if ri5 >= 0i64 { deps.add(i2, ri5); deps.add_agg(i2, ri5); }
                                    }
                                    gi = gi + 1i64;
                                }
                            }
                            if deps.agg_head < 0i64 { deps.agg_head = i2; }
                        }
                        RQuery::Find(_f2) => {
                            return Result::Err(qfail("rel '", rel2.name,
                                     "': `find` is not allowed in a rel body — bodies produce relations (from/join/where/select only)",
                                     "", ""));
                        }
                    }
                    b = b + 1i64;
                }
                i2 = i2 + 1i64;
            }
            // ── condense + STRATIFY (the SHARED graph half) ─────────────────
            let scc: RelScc = compute_rel_scc(&deps, nr);
            reg.nscc = scc.nscc;
            let mut ci: i64 = 0i64;
            while ci < nr {
                reg.comp[ci]  = scc.comp[ci];
                reg.order[ci] = scc.order[ci];
                reg.rec[ci]   = scc.rec[ci];
                ci = ci + 1i64;
            }
            let mut sk: i64 = 0i64;
            while sk < deps.gn {
                if scc.comp[deps.gfrom[sk]] == scc.comp[deps.gto[sk]] {
                    let mut m1: String = String::new();
                    m1.push_str("non-stratifiable aggregation — rel '");
                    m1.push_str(reg.names[deps.gfrom[sk]]);
                    m1.push_str("' aggregates over rel '");
                    m1.push_str(reg.names[deps.gto[sk]]);
                    m1.push_str("' of the same recursive component ");
                    qreg_push_scc_members(&mut m1, &reg, scc.comp[deps.gfrom[sk]]);
                    m1.push_str(" — aggregate only over rels from an earlier stratum");
                    return Result::Err(QError { msg: m1 });
                }
                sk = sk + 1i64;
            }
            let mut sk2: i64 = 0i64;
            while sk2 < deps.an {
                if scc.comp[deps.afrom[sk2]] == scc.comp[deps.ato[sk2]] {
                    let mut m2: String = String::new();
                    m2.push_str("non-stratifiable negation — rel '");
                    m2.push_str(reg.names[deps.afrom[sk2]]);
                    m2.push_str("' anti joins rel '");
                    m2.push_str(reg.names[deps.ato[sk2]]);
                    m2.push_str("' of the same recursive component ");
                    qreg_push_scc_members(&mut m2, &reg, scc.comp[deps.afrom[sk2]]);
                    m2.push_str(" — anti join only rels from an earlier stratum");
                    return Result::Err(QError { msg: m2 });
                }
                sk2 = sk2 + 1i64;
            }
            if deps.agg_head >= 0i64 {
                return Result::Err(qfail("rel '", reg.names[deps.agg_head],
                         "': aggregate bodies are not allowed — a rel body is a relation producer (from/join/where/select only)",
                         "", ""));
            }
            // ── lower + simplify + REWRITE each body; collect delta occs ────
            // (Failures LATCH in chk and break the loops — the Chk moves out
            // exactly once, after them.)
            let mut i3: i64 = 0i64;
            while i3 < nr && !chk.failed {
                let rel3: RQRel = rels.rel_at(i3);
                let barr3: RQBodyArr = rel3.bodies_arr();
                let nb3: i64 = barr3.len();
                let occ_c: i64 = if reg.rec[reg.comp[i3]] { reg.comp[i3] } else { -1i64 };
                let mut b3: i64 = 0i64;
                while b3 < nb3 && !chk.failed {
                    if bodies.n >= QBODY_MAX {
                        return Result::Err(qerr("Query::compile: too many rel bodies"));
                    }
                    let q3: RQuery = barr3.body_any(b3).view::<RQuery>();
                    let root0: WRef<RExpr> = lower_rquery_to_rexpr(q3, &doc);
                    let sig: RSimplified = simplify_rexpr_ref(root0, root0.any().view::<RExpr>(), &doc);
                    let bn: i64 = bodies.n;
                    bodies.owner.push(i3);
                    bodies.root.push(sig.root.any().raw());
                    bodies.empty.push(if sig.empty { 1i64 } else { 0i64 });
                    bodies.occ_off.push(bodies.on);
                    bodies.occ_n.push(0i64);
                    if !sig.empty {
                        let mut sc: RwScope = rwscope_new();
                        let mut ow: [i64; 9] = [0i64; 9];
                        let mut orel: [i64; 9] = [0i64; 9];
                        let mut on_: i64 = 0i64;
                        rw_walk(sig.root, &mut sc, &reg, &doc, &mut chk, occ_c,
                                &mut ow, &mut orel, &mut on_);
                        if !chk.failed {
                            if bodies.on + on_ > QOCC_MAX {
                                return Result::Err(qerr("Query::compile: too many recursive source references"));
                            }
                            let mut oi: i64 = 0i64;
                            while oi < on_ {
                                bodies.ow.push(ow[oi]);
                                bodies.orel.push(orel[oi]);
                                bodies.on = bodies.on + 1i64;
                                oi = oi + 1i64;
                            }
                            bodies.occ_n.set(bn, on_);
                            // compile-phase width gate + env-independent checks
                            qrel_body_width(sig.root.any().view::<RExpr>(), &reg, i3, &mut chk);
                        }
                        if !chk.failed {
                            let mut lbb: CBinds = cbinds_new();
                            check_rexpr(sig.root.any().view::<RExpr>(), cat, &e0, false,
                                        &mut lbb, &mut chk, &mut qp, &reg);
                        }
                    }
                    bodies.n = bn + 1i64;
                    b3 = b3 + 1i64;
                }
                i3 = i3 + 1i64;
            }
            if chk.failed { return Result::Err(chk_err(chk)); }
        }

        let entry: RQuery = prog.entry_any().view::<RQuery>();
        // result-envelope mode + `first` exclusions (the static walker's rule)
        let mut sel_mode: i32 = QM_ALL;
        let mut first_bad: bool = false;
        match entry {
            RQuery::Simple(s) => {
                if s.sel_first { sel_mode = QM_FIRST; if s.distinct || s.has_limit { first_bad = true; } }
            }
            RQuery::Join(j) => {
                if j.sel_first { sel_mode = QM_FIRST; if j.distinct || j.has_limit { first_bad = true; } }
            }
            RQuery::Aggr(g) => {
                if g.sel_first { sel_mode = QM_FIRST; if g.distinct || g.has_limit { first_bad = true; } }
            }
            RQuery::Find(f) => {
                sel_mode = QM_FIND;
                // `find` returns a row HANDLE; a rel row is an RtVal column
                // group — nothing to hand out (static parity: rels are locals).
                if qreg_find(&reg, f.src_name) >= 0i64 {
                    chk_fail(&mut chk, "`find` over rel '", f.src_name,
                             "' is not supported — use `select first (…columns…)` instead",
                             "", "");
                    return Result::Err(chk_err(chk));
                }
            }
        }
        if first_bad {
            return Result::Err(qerr("Query::compile: `select first` excludes distinct/limit"));
        }
        // REUSED queue-1 passes: lowering + the relational peephole.
        let root0: WRef<RExpr> = lower_rquery_to_rexpr(entry, &doc);
        let sig: RSimplified = simplify_rexpr_ref(root0, root0.any().view::<RExpr>(), &doc);
        // Rel-field rewrite over the ENTRY (rel scans read totals — no occs).
        if !sig.empty && reg.n > 0i64 {
            let mut esc: RwScope = rwscope_new();
            let mut eow: [i64; 9] = [0i64; 9];
            let mut eorel: [i64; 9] = [0i64; 9];
            let mut eon: i64 = 0i64;
            rw_walk(sig.root, &mut esc, &reg, &doc, &mut chk, -1i64,
                    &mut eow, &mut eorel, &mut eon);
            if chk.failed { return Result::Err(chk_err(chk)); }
        }
        // env-INDEPENDENT checks (sources/params/UDFs live on the env → run).
        let mut lb: CBinds = cbinds_new();
        check_rexpr(sig.root.any().view::<RExpr>(), cat, &e0, false, &mut lb, &mut chk, &mut qp, &reg);
        if chk.failed { return Result::Err(chk_err(chk)); }
        return Result::Ok(Query {
            doc: doc,
            root: sig.root.any().raw(),
            empty: sig.empty,
            sel_mode: sel_mode,
            cat: catalog_clone(cat),
            reg: reg,
            bodies: bodies,
        });
    }

    // STRICT check against (catalog + this env) — bodies first (their select
    // component types validate against the DECLARED rel columns), the ENTRY
    // last (its projection kinds are what QRows carries) — then materialize
    // the rels (topo order, semi-naïve where recursive) and execute the
    // entry. Re-entrant over different envs (compile-once/run-many; the check
    // + cascade are per-env because sources, params and the UDF/UDA registry
    // live there).
    pub fn run(self: &Query, env: &QEnv) -> Result<QRows, QError> {
        let root: RExpr = WAny::ref_to(self.root as *const u8).view::<RExpr>();
        let mut chk: Chk = chk_new();
        let mut qp: QPlan = qplan_new();
        let mut bi: i64 = 0i64;
        while bi < self.bodies.n && !chk.failed {
            if self.bodies.empty.get(bi) == 0i64 {
                let mut lbb: CBinds = cbinds_new();
                let broot: RExpr = WAny::ref_to(self.bodies.root.get(bi) as *const u8).view::<RExpr>();
                check_rexpr(broot, &self.cat, env, true, &mut lbb, &mut chk, &mut qp, &self.reg);
                if !chk.failed {
                    // component types vs the DECLARED columns (UNKNOWN =
                    // empty-source bodies contribute zero rows — fine)
                    let ri: i64 = self.bodies.owner.get(bi);
                    let off: i64 = self.reg.coff[ri];
                    let mut cc: i64 = 0i64;
                    while cc < qp.ncols && cc < self.reg.ncols[ri] && !chk.failed {
                        let got: i32 = qp.ckind[cc];
                        if got != CT_UNKNOWN && got != (self.reg.ctys.get(off + cc) as i32) {
                            if got == CT_DYN {
                                chk_fail(&mut chk, "rel '", self.reg.names[ri], "' column '",
                                         self.reg.cnames.get(off + cc),
                                         "': a lenient (erased) value cannot feed a typed rel column");
                            } else {
                                chk_fail(&mut chk, "rel '", self.reg.names[ri], "' column '",
                                         self.reg.cnames.get(off + cc),
                                         "': the select component type does not match the declared column type");
                            }
                        }
                        cc = cc + 1i64;
                    }
                }
            }
            bi = bi + 1i64;
        }
        if !chk.failed {
            let mut lb: CBinds = cbinds_new();
            check_rexpr(root, &self.cat, env, true, &mut lb, &mut chk, &mut qp, &self.reg);
        }
        if chk.failed { return Result::Err(chk_err(chk)); }
        let mut rows: QRows = QRows {
            arena: writ_new(1024i64),
            ncols: qp.ncols,
            kinds: qp.ckind,
            cells: vec_new::<RtVal>(),
            nrows: 0i64,
        };
        if self.empty { return Result::Ok(rows); }   // queue-1 empty signal
        let scratch: Writ = writ_new(2048i64);
        let cp: *mut Chk = &mut chk;
        // ── rel materialization state (per run; locals own the storage) ────
        let mut rr0: Vec<RtVal> = vec_new::<RtVal>();
        let mut rr1: Vec<RtVal> = vec_new::<RtVal>();
        let mut rr2: Vec<RtVal> = vec_new::<RtVal>();
        let mut rr3: Vec<RtVal> = vec_new::<RtVal>();
        let mut rr4: Vec<RtVal> = vec_new::<RtVal>();
        let mut rr5: Vec<RtVal> = vec_new::<RtVal>();
        let mut rr6: Vec<RtVal> = vec_new::<RtVal>();
        let mut rr7: Vec<RtVal> = vec_new::<RtVal>();
        let mut rhm: HashMap<u64, Vec<i64>> = hashmap_new::<u64, Vec<i64>>();
        let mut ctx: RelCtx = relctx_new();
        ctx.n = self.reg.n;
        ctx.regp = (&self.reg as *const QRelReg) as i64;
        ctx.hmp = (&mut rhm as *mut HashMap<u64, Vec<i64>>) as i64;
        ctx.rowsp[0] = (&mut rr0 as *mut Vec<RtVal>) as i64;
        ctx.rowsp[1] = (&mut rr1 as *mut Vec<RtVal>) as i64;
        ctx.rowsp[2] = (&mut rr2 as *mut Vec<RtVal>) as i64;
        ctx.rowsp[3] = (&mut rr3 as *mut Vec<RtVal>) as i64;
        ctx.rowsp[4] = (&mut rr4 as *mut Vec<RtVal>) as i64;
        ctx.rowsp[5] = (&mut rr5 as *mut Vec<RtVal>) as i64;
        ctx.rowsp[6] = (&mut rr6 as *mut Vec<RtVal>) as i64;
        ctx.rowsp[7] = (&mut rr7 as *mut Vec<RtVal>) as i64;
        let ctxp: *mut RelCtx = &mut ctx;
        if self.reg.n > 0i64 {
            qrel_materialize(self, env, &qp, &scratch, ctxp, cp);
            if chk_bad(cp) { return Result::Err(chk_err(chk)); }
        }
        let out: OutTab = exec_root(root, &self.cat, env, &qp, &scratch, cp,
                                    ctxp as *const RelCtx);
        if chk_bad(cp) { return Result::Err(chk_err(chk)); }
        // materialize: first/find keep at most one row; string views are
        // interned into the QRows arena (self-contained result).
        let mut nkeep: i64 = out.nrows;
        if (self.sel_mode == QM_FIRST || self.sel_mode == QM_FIND) && nkeep > 1i64 {
            nkeep = 1i64;
        }
        let mut r: i64 = 0i64;
        while r < nkeep {
            let mut c: i64 = 0i64;
            while c < out.ncols {
                let v: RtVal = out.cells.get(r * out.ncols + c);
                match v {
                    RtVal::S(s) => { rows.cells.push(RtVal::S(intern_str(&rows.arena, s))); }
                    _ => { rows.cells.push(v); }
                }
                c = c + 1i64;
            }
            r = r + 1i64;
        }
        rows.nrows = nkeep;
        return Result::Ok(rows);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// INCREMENTAL DATAFLOW ENGINE — slice-1 (ADR 0013 §8)
//
// A DBSP-style signed-weight (Z-set) incremental maintainer for the linear +
// ONE-bilinear-join fragment  RDistinct?( RProj( RFilter?( RJoin(Scan,Scan) ) ) ).
// Plain single-threaded: an "epoch" is one call that admits ±delta batches,
// computes the netted output delta, applies it, then integrates the deltas
// into the arranged inputs — INTEGRATE-AFTER-COMPUTE (§8.2). Derived from the
// batch evaluator: reuses eval_sexpr / eval_on_residual / rt_key_hash / rt_eq
// verbatim, so the only new surface is the weight bookkeeping.
//
// State is private; the PUBLIC surface is ZBatch / IncrJoin /
// Query::incremental. Correctness rules honored: U1 (rel-free; the dedup
// boundary is the top RDistinct, non-negative source clamp is the harness's
// job; out_int may hold transient negatives, compared only at quiescence),
// §10.4 (RProj weight-coalesce; RDistinct multiplicity-CROSSING), §8.2
// integrate-after-compute.
// ═══════════════════════════════════════════════════════════════════════════

// A ±delta batch over ONE source: signed-weight node handles. Harness-built
// (the ZBatch seam, §6 — mutation-instrumentation / snapshot-diff are drop-in
// producers behind it).
pub struct ZBatch {
    node: Vec<WAny>,
    wt:   Vec<i64>,
}
impl ZBatch {
    pub fn new() -> ZBatch { return ZBatch { node: vec_new::<WAny>(), wt: vec_new::<i64>() }; }
    pub fn push(self: &mut ZBatch, row: WAny, w: i64) { self.node.push(row); self.wt.push(w); }
    pub fn clear(self: &mut ZBatch) {
        self.node = vec_new::<WAny>();
        self.wt   = vec_new::<i64>();
    }
    pub fn len(self: &ZBatch) -> i64 { return self.node.len(); }
}

// An integrated, arranged Z-set of ONE join input, keyed on the join key.
//   node/wt/key — one slot per source-row identity (weight >0 at quiescence)
//   id  — handle-raw -> slot: coalesce ±w by identity (the change-capture is
//         per whole-node row; rt_key_hash collapses Nodes to one bucket and
//         rt_eq(Node,Node)=false, so identity is the raw self-relative ref)
//   idx — join-key hash -> slots: the arrangement / probe index (kept live).
//   mc — per-LEFT-ROW matchcount (anti mode only): weighted count of supporting
//        right matches for slot i; the left row is in the anti-output iff mc==0.
//        Sentinel -1 = "uncomputed" (a new slot not yet probed). Meaningful only
//        for the LEFT arrangement (`a`) under anti; unused for join / for `b`.
pub struct Arr {
    var:  str,
    node: Vec<WAny>,
    wt:   Vec<i64>,
    key:  Vec<RtVal>,
    mc:   Vec<i64>,
    id:   HashMap<u64, i64>,
    idx:  HashMap<u64, Vec<i64>>,
}
fn arr_new(var: str) -> Arr {
    return Arr {
        var: var, node: vec_new::<WAny>(), wt: vec_new::<i64>(), key: vec_new::<RtVal>(),
        mc: vec_new::<i64>(),
        id: hashmap_new::<u64, i64>(), idx: hashmap_new::<u64, Vec<i64>>(),
    };
}

// ── AggState — per-group i64 accumulators for incremental GROUP aggregation ──
// (DBSP slice-3, ADR 0013 §3.1). One SLOT per distinct group key; slots are
// NEVER deleted (mirrors `Arr`), an emptied group keeps its slot with
// gcount==0/gsum==0 (the abelian GROUP inverse over CLAMPED truth) and is reused
// cleanly on re-appearance.
//   keyv   — group key RtVal per slot (string keys interned into the out arena)
//   gcount — Σw = count() value AND the avg denominator per slot
//   gsum   — stride agg_n: Σ(w·rt_i(arg)) per agg slot (i64 → exact inverse, no
//            float drift; matches the slice-1 i64-value constraint). count slots
//            carry an unused 0; avg slots carry the numerator Σ(w·arg).
//   live   — gcount>0 (the group currently has an emitted output row)
//   idx    — rt_key_hash(key) -> slots (rt_eq verify on collision), the group
//            probe index (mirrors zout's bucket+verify pattern).
//   vbest  — stride agg_n: cached extremum per (slot,agg) for SEMILATTICE
//            min/max columns (fnid 3/4). A placeholder 0 while the slot's
//            vmap is empty (never read then); the first live insert sets it.
//   vmap   — stride agg_n: value→live-multiplicity map per (slot,agg) for
//            min/max columns. `vmap[v] = Σw` of live rows carrying value `v`
//            in that group; a key is dropped when its count reaches 0. On
//            retracting the current best to 0 we RESCAN this group's live
//            keys (only) for the next extremum (ADR 0013 §3.1, slice-4).
//            INVARIANT: gcount>0 ⇔ vmap non-empty ⇔ vbest valid (for min/max
//            columns); gcount is the single liveness/empty driver for all algebras.
pub struct AggState {
    keyv:   Vec<RtVal>,
    gcount: Vec<i64>,
    gsum:   Vec<i64>,
    live:   Vec<bool>,
    idx:    HashMap<u64, Vec<i64>>,
    vbest:  Vec<i64>,
    vmap:   Vec<HashMap<i64, i64>>,
}
fn aggstate_new() -> AggState {
    return AggState {
        keyv: vec_new::<RtVal>(), gcount: vec_new::<i64>(), gsum: vec_new::<i64>(),
        live: vec_new::<bool>(), idx: hashmap_new::<u64, Vec<i64>>(),
        vbest: vec_new::<i64>(), vmap: vec_new::<HashMap<i64, i64>>(),
    };
}
// Group slot of key `k`, or -1 (rt_key_hash bucket + rt_eq verify).
fn aggstate_find(agg: &AggState, k: RtVal) -> i64 {
    let h: u64 = rt_key_hash(k);
    let mp: *mut HashMap<u64, Vec<i64>> =
        (&agg.idx as *const HashMap<u64, Vec<i64>>) as *mut HashMap<u64, Vec<i64>>;
    let bp: *const Vec<i64> = unsafe { mp.get(&h) };
    if (bp as i64) == 0i64 { return -1i64; }
    let bucket: &Vec<i64> = unsafe { &*bp };
    let nb: i64 = bucket.len();
    let mut t: i64 = 0i64;
    while t < nb {
        let o: i64 = bucket.get(t);
        if rt_eq(agg.keyv.get(o), k) { return o; }
        t = t + 1i64;
    }
    return -1i64;
}
// Ensure a slot for key `k` (created zeroed, live=false, gsum stride `n`).
// String keys are interned into `arena` so the group row stays self-contained.
fn aggstate_ensure(agg: &mut AggState, k: RtVal, n: i64, arena: &Writ) -> i64 {
    let existing: i64 = aggstate_find(agg, k);
    if existing >= 0i64 { return existing; }
    let slot: i64 = agg.gcount.len();
    let h: u64 = rt_key_hash(k);
    let mp: *mut HashMap<u64, Vec<i64>> = &mut agg.idx;
    unsafe {
        let vp: *mut Vec<i64> = mp.get_or_insert(h, vec_new::<i64>());
        (&mut *vp).push(slot);
    }
    let ki: RtVal = match k {
        RtVal::S(s) => { RtVal::S(intern_str(arena, s)) }
        _ => { k }
    };
    agg.keyv.push(ki);
    agg.gcount.push(0i64);
    agg.live.push(false);
    let mut i: i64 = 0i64;
    while i < n {
        agg.gsum.push(0i64);
        agg.vbest.push(0i64);                        // placeholder (unread while vmap empty)
        agg.vmap.push(hashmap_new::<i64, i64>());    // SEMILATTICE value→live-count map
        i = i + 1i64;
    }
    return slot;
}

// The maintained OUTPUT Z-set, keyed on the canonical projected tuple.
//   cells — stride ncols (interned strings, self-contained)
//   wt    — bag multiplicity per distinct tuple
//   memb  — set membership, maintained on multiplicity CROSSING (set mode)
//   idx   — canon-row hash -> slots (rt_eq verify on collision).
pub struct ZOut {
    ncols: i64,
    cells: Vec<RtVal>,
    wt:    Vec<i64>,
    memb:  Vec<bool>,
    idx:   HashMap<u64, Vec<i64>>,
}
fn zout_new(nc: i64) -> ZOut {
    return ZOut {
        ncols: nc, cells: vec_new::<RtVal>(), wt: vec_new::<i64>(),
        memb: vec_new::<bool>(), idx: hashmap_new::<u64, Vec<i64>>(),
    };
}

// FNV fold over a row slice cells[off .. off+nc] (the exec_root Distinct hash).
fn zrow_hash(cells: &Vec<RtVal>, off: i64, nc: i64) -> u64 {
    let mut h: u64 = 1469598103934665603u64;
    let mut c: i64 = 0i64;
    while c < nc { h = h_step(h, rt_key_hash(cells.get(off + c))); c = c + 1i64; }
    return h;
}

// Find the slot of row cells[off..] in `z`; -1 if absent (rt_eq bucket verify).
fn zout_find(zp: *mut ZOut, cells: &Vec<RtVal>, off: i64) -> i64 {
    let z: &ZOut = unsafe { &*zp };
    let nc: i64 = z.ncols;
    let h: u64 = zrow_hash(cells, off, nc);
    let mp: *mut HashMap<u64, Vec<i64>> = unsafe { &mut (&mut *zp).idx };
    let bp: *const Vec<i64> = unsafe { mp.get(&h) };
    if (bp as i64) == 0i64 { return -1i64; }
    let bucket: &Vec<i64> = unsafe { &*bp };
    let nb: i64 = bucket.len();
    let mut t: i64 = 0i64;
    while t < nb {
        let o: i64 = bucket.get(t);
        let mut same: bool = true;
        let mut c2: i64 = 0i64;
        while c2 < nc {
            if !rt_eq(z.cells.get(o * nc + c2), cells.get(off + c2)) { same = false; break; }
            c2 = c2 + 1i64;
        }
        if same { return o; }
        t = t + 1i64;
    }
    return -1i64;
}

// Ensure a slot exists for row cells[off..] (created with wt 0, memb false);
// interns string cells into `arena` so the row is self-contained. Returns slot.
fn zout_upsert(zp: *mut ZOut, arena: &Writ, cells: &Vec<RtVal>, off: i64) -> i64 {
    let existing: i64 = zout_find(zp, cells, off);
    if existing >= 0i64 { return existing; }
    let z: &mut ZOut = unsafe { &mut *zp };
    let nc: i64 = z.ncols;
    let slot: i64 = z.wt.len();
    let h: u64 = zrow_hash(cells, off, nc);
    let mp: *mut HashMap<u64, Vec<i64>> = &mut z.idx;
    unsafe {
        let vp: *mut Vec<i64> = mp.get_or_insert(h, vec_new::<i64>());
        (&mut *vp).push(slot);
    }
    let mut c: i64 = 0i64;
    while c < nc {
        let v: RtVal = cells.get(off + c);
        match v {
            RtVal::S(s) => { z.cells.push(RtVal::S(intern_str(arena, s))); }
            _ => { z.cells.push(v); }
        }
        c = c + 1i64;
    }
    z.wt.push(0i64);
    z.memb.push(false);
    return slot;
}

// RProj weight-coalesce (§10.4): Δout[π(t)] += w, ADDITIVE (never 1:1).
fn zout_bump(zp: *mut ZOut, arena: &Writ, cells: &Vec<RtVal>, off: i64, w: i64) {
    if w == 0i64 { return; }
    let slot: i64 = zout_upsert(zp, arena, cells, off);
    let z: &mut ZOut = unsafe { &mut *zp };
    z.wt.set(slot, z.wt.get(slot) + w);
}

// Apply a scratch delta `od` into `out`. Bag: wt += dw. Set (has_distinct):
// maintain `memb` on multiplicity CROSSING — <=0→>0 emits +, >0→<=0 emits -
// (§10.4 RDistinct crossing, NOT w>0).
fn out_apply(outp: *mut ZOut, arena: &Writ, odp: *const ZOut, has_distinct: bool) {
    let od: &ZOut = unsafe { &*odp };
    let nc: i64 = od.ncols;
    let n: i64 = od.wt.len();
    let mut i: i64 = 0i64;
    while i < n {
        let dw: i64 = od.wt.get(i);
        if dw != 0i64 {
            let slot: i64 = zout_upsert(outp, arena, &od.cells, i * nc);
            let out: &mut ZOut = unsafe { &mut *outp };
            let old: i64 = out.wt.get(slot);
            let neww: i64 = old + dw;
            out.wt.set(slot, neww);
            if has_distinct {
                if old <= 0i64 && neww > 0i64 { out.memb.set(slot, true); }
                else if old > 0i64 && neww <= 0i64 { out.memb.set(slot, false); }
            }
        }
        i = i + 1i64;
    }
}

// Compute the join key of one node by evaluating `kexpr_w` with `var` bound.
// The key expr references ONLY its own scan var (analyze_join_step's build/
// probe split), so a single-var RBinds suffices.
fn ij_key(kexpr_w: i64, var: str, node: WAny, cat: &SchemaCatalog, env: &QEnv,
          scratch: &Writ) -> RtVal {
    let mut b: RBinds = rbinds_new();
    b.bind_val(var, RtVal::Node(node));
    let bp: *const RBinds = &b;
    return eval_sexpr(sx_of(kexpr_w), cat, env, bp, scratch);
}

// One surviving join pair (aNode ⋈ bNode, weight w) → filter → project →
// coalesce into `od`. Residual = every ON conjunct except the consumed equi
// term (the key equality was already rt_eq-verified by the caller).
fn ij_emit(odp: *mut ZOut, arena: &Writ, a_node: WAny, b_node: WAny, w: i64,
           lvar: str, rvar: str, on_w: i64, equi_w: i64, has_pred: bool, pred_w: i64,
           sel_w: i64, cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    if w == 0i64 { return; }
    let mut cb: RBinds = rbinds_new();
    cb.bind_val(lvar, RtVal::Node(a_node));
    cb.bind_val(rvar, RtVal::Node(b_node));
    let cbp: *const RBinds = &cb;
    if !eval_on_residual(on_w, equi_w, cat, env, cbp, scratch) { return; }
    if has_pred {
        if !rt_truthy(eval_sexpr(sx_of(pred_w), cat, env, cbp, scratch)) { return; }
    }
    let sel: SExpr = sx_of(sel_w);
    let mut cells: Vec<RtVal> = vec_new::<RtVal>();
    match sel {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let nn: i64 = items.len();
            let mut c: i64 = 0i64;
            while c < nn { cells.push(eval_sexpr(items.arg_at(c), cat, env, cbp, scratch)); c = c + 1i64; }
        }
        _ => { cells.push(eval_sexpr(sel, cat, env, cbp, scratch)); }
    }
    zout_bump(odp, arena, &cells, 0i64, w);
}

// One bilinear join term: stream (lnodes,lwts,lkeys) against arranged `right`.
// leftIsA=true ⇒ left rows bind the A/left var and `right` binds B/right; false
// ⇒ swapped (left=ΔB binds rvar, right=A_int binds lvar). Weights MULTIPLY.
fn ij_join_term(odp: *mut ZOut, arena: &Writ,
                lnodes: &Vec<WAny>, lwts: &Vec<i64>, lkeys: &Vec<RtVal>,
                right: &Arr, left_is_a: bool,
                lvar: str, rvar: str, on_w: i64, equi_w: i64,
                has_pred: bool, pred_w: i64, sel_w: i64,
                cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    let rp: *mut HashMap<u64, Vec<i64>> =
        (&right.idx as *const HashMap<u64, Vec<i64>>) as *mut HashMap<u64, Vec<i64>>;
    let n: i64 = lnodes.len();
    let mut i: i64 = 0i64;
    while i < n {
        let wl: i64 = lwts.get(i);
        if wl != 0i64 {
            let kl: RtVal = lkeys.get(i);
            let hp: u64 = rt_key_hash(kl);
            let bp: *const Vec<i64> = unsafe { rp.get(&hp) };
            if (bp as i64) != 0i64 {
                let bucket: &Vec<i64> = unsafe { &*bp };
                let nb: i64 = bucket.len();
                let mut t: i64 = 0i64;
                while t < nb {
                    let j: i64 = bucket.get(t);
                    let wr: i64 = right.wt.get(j);
                    if wr != 0i64 && rt_eq(kl, right.key.get(j)) {
                        let a_node: WAny = if left_is_a { lnodes.get(i) } else { right.node.get(j) };
                        let b_node: WAny = if left_is_a { right.node.get(j) } else { lnodes.get(i) };
                        ij_emit(odp, arena, a_node, b_node, wl * wr,
                                lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, cat, env, scratch);
                    }
                    t = t + 1i64;
                }
            }
        }
        i = i + 1i64;
    }
}

// Anti-output emit: a LEFT-only row (weight w, may be negative) → filter →
// project → coalesce into `od`. No rvar/residual (the anti-output is left-only;
// the where-clause is left-only by the checker). Mirrors ij_emit minus the join.
fn ij_anti_emit(odp: *mut ZOut, arena: &Writ, l_node: WAny, w: i64,
                lvar: str, has_pred: bool, pred_w: i64, sel_w: i64,
                cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    if w == 0i64 { return; }
    let mut cb: RBinds = rbinds_new();
    cb.bind_val(lvar, RtVal::Node(l_node));
    let cbp: *const RBinds = &cb;
    if has_pred {
        if !rt_truthy(eval_sexpr(sx_of(pred_w), cat, env, cbp, scratch)) { return; }
    }
    let sel: SExpr = sx_of(sel_w);
    let mut cells: Vec<RtVal> = vec_new::<RtVal>();
    match sel {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let nn: i64 = items.len();
            let mut c: i64 = 0i64;
            while c < nn { cells.push(eval_sexpr(items.arg_at(c), cat, env, cbp, scratch)); c = c + 1i64; }
        }
        _ => { cells.push(eval_sexpr(sel, cat, env, cbp, scratch)); }
    }
    zout_bump(odp, arena, &cells, 0i64, w);
}

// Aggregate group-row emit (DBSP slice-3): one group row (key + agg values,
// weight w which may be −1 on retraction) → optional HAVING → project → coalesce
// into `od`. Mirrors ij_anti_emit; the group scalars are bound by NAME ("key" +
// each agg's out-name) into RBinds — the EXACT scalar-binding contract the batch
// projection over group rows uses (eval_root resolves bare idents against RBinds).
fn ag_emit(odp: *mut ZOut, arena: &Writ, key: RtVal, aggvals: &Vec<RtVal>, an: i64, w: i64,
           agg_out: &[str], has_pred: bool, pred_w: i64, sel_w: i64,
           cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    if w == 0i64 { return; }
    let mut cb: RBinds = rbinds_new();
    cb.bind_val("key", key);
    let mut i: i64 = 0i64;
    while i < an { cb.bind_val(agg_out[i], aggvals.get(i)); i = i + 1i64; }
    let cbp: *const RBinds = &cb;
    if has_pred {
        if !rt_truthy(eval_sexpr(sx_of(pred_w), cat, env, cbp, scratch)) { return; }
    }
    let sel: SExpr = sx_of(sel_w);
    let mut cells: Vec<RtVal> = vec_new::<RtVal>();
    match sel {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let nn: i64 = items.len();
            let mut c: i64 = 0i64;
            while c < nn { cells.push(eval_sexpr(items.arg_at(c), cat, env, cbp, scratch)); c = c + 1i64; }
        }
        _ => { cells.push(eval_sexpr(sel, cat, env, cbp, scratch)); }
    }
    zout_bump(odp, arena, &cells, 0i64, w);
}

// Weighted matchcount of one left row against arranged `b`: Σ_r [key(r)==l_key
// ∧ residual(l,r)]·b.wt[r] over post-integrate `b`. Clone of ij_join_term's
// probe loop MINUS emit. A left key with two supporting depts returns 2 (enters
// the anti-output only at 0). NOT boolean — per (ℓ,r) residual, weighted.
fn ij_matchcount(l_node: WAny, l_key: RtVal, b: &Arr,
                 on_w: i64, equi_w: i64, lvar: str, rvar: str,
                 cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) -> i64 {
    let rp: *mut HashMap<u64, Vec<i64>> =
        (&b.idx as *const HashMap<u64, Vec<i64>>) as *mut HashMap<u64, Vec<i64>>;
    let hp: u64 = rt_key_hash(l_key);
    let bp: *const Vec<i64> = unsafe { rp.get(&hp) };
    let mut mc: i64 = 0i64;
    if (bp as i64) != 0i64 {
        let bucket: &Vec<i64> = unsafe { &*bp };
        let nb: i64 = bucket.len();
        let mut t: i64 = 0i64;
        while t < nb {
            let j: i64 = bucket.get(t);
            let wr: i64 = b.wt.get(j);
            if wr != 0i64 && rt_eq(l_key, b.key.get(j)) {
                let mut cb: RBinds = rbinds_new();
                cb.bind_val(lvar, RtVal::Node(l_node));
                cb.bind_val(rvar, RtVal::Node(b.node.get(j)));
                let cbp: *const RBinds = &cb;
                if eval_on_residual(on_w, equi_w, cat, env, cbp, scratch) { mc = mc + wr; }
            }
            t = t + 1i64;
        }
    }
    return mc;
}

// The ΔA ⋈ ΔB cross term (nested loop; deltas are small). Index-free so it
// never touches the arrangements — the §8.2 double-count trap is avoided by
// computing this BEFORE integrating either delta.
fn ij_cross_term(odp: *mut ZOut, arena: &Writ,
                 an: &Vec<WAny>, awt: &Vec<i64>, akey: &Vec<RtVal>,
                 bn: &Vec<WAny>, bwt: &Vec<i64>, bkey: &Vec<RtVal>,
                 lvar: str, rvar: str, on_w: i64, equi_w: i64,
                 has_pred: bool, pred_w: i64, sel_w: i64,
                 cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    let na: i64 = an.len();
    let nb: i64 = bn.len();
    let mut i: i64 = 0i64;
    while i < na {
        let wl: i64 = awt.get(i);
        if wl != 0i64 {
            let kl: RtVal = akey.get(i);
            let mut j: i64 = 0i64;
            while j < nb {
                let wr: i64 = bwt.get(j);
                if wr != 0i64 && rt_eq(kl, bkey.get(j)) {
                    ij_emit(odp, arena, an.get(i), bn.get(j), wl * wr,
                            lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, cat, env, scratch);
                }
                j = j + 1i64;
            }
        }
        i = i + 1i64;
    }
}

// Integrate a ±delta into an arrangement by identity (§8.2 step 5). Existing
// identity ⇒ wt += w (no index change; key unchanged). New identity ⇒ append a
// slot, compute + index its key. Zero-weight slots survive (skipped by joins);
// no Vec deletion, so `id`/`idx` slots stay stable across epochs.
fn ij_integrate(arr: &mut Arr, delta: &ZBatch, keyw: i64, var: str,
                cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    let n: i64 = delta.node.len();
    let mut i: i64 = 0i64;
    while i < n {
        let w: i64 = delta.wt.get(i);
        if w != 0i64 {
            let node: WAny = delta.node.get(i);
            let rawu: u64 = node.raw() as u64;
            let idp: *mut HashMap<u64, i64> = &mut arr.id;
            let sp: *const i64 = unsafe { idp.get(&rawu) };
            if (sp as i64) != 0i64 {
                let slot: i64 = unsafe { *sp };
                arr.wt.set(slot, arr.wt.get(slot) + w);
            } else {
                let slot: i64 = arr.node.len();
                let key: RtVal = ij_key(keyw, var, node, cat, env, scratch);
                arr.node.push(node);
                arr.wt.push(w);
                arr.key.push(key);
                arr.mc.push(-1i64);   // uncomputed sentinel (anti mode fills lazily)
                unsafe { let _q: *mut i64 = idp.get_or_insert(rawu, slot); }
                let hp: u64 = rt_key_hash(key);
                let ixp: *mut HashMap<u64, Vec<i64>> = &mut arr.idx;
                unsafe {
                    let vp: *mut Vec<i64> = ixp.get_or_insert(hp, vec_new::<i64>());
                    (&mut *vp).push(slot);
                }
            }
        }
        i = i + 1i64;
    }
}

// A +1/identity ZBatch over every element of a bound source array (base fill).
fn ij_batch_from_source(src: WAny) -> ZBatch {
    let mut b: ZBatch = ZBatch::new();
    if !src.is_array() { return b; }
    let a: &WArray<WAny> = src.as_array();
    let n: i64 = a.len();
    let mut i: i64 = 0i64;
    while i < n { b.push(a.get(i), 1i64); i = i + 1i64; }
    return b;
}

// ── IncrJoin — the maintained engine (arrangements + out state + frozen plan) ─
pub struct IncrJoin {
    arena: Writ,             // owns interned output-row strings (self-contained)
    a:     Arr,              // A_int (left / probe side)
    b:     Arr,              // B_int (right / build side)
    out:   ZOut,             // out_int
    cat:   SchemaCatalog,    // catalog snapshot (eval_sexpr needs it)
    envp:  i64,             // *const QEnv — param lookups only (row vars come
                             // from RBinds); the caller keeps the env alive
    on_w:   i64,
    equi_w: i64,
    build_w: i64,            // qp.jbuild (right/new-side key)
    probe_w: i64,            // qp.jprobe (left/bound-side key)
    pred_w:  i64,
    has_pred: bool,
    sel_w:   i64,
    lvar:    str,
    rvar:    str,
    has_distinct: bool,      // top RExpr::Distinct present -> set mode
    is_anti: bool,           // top step is `anti join` -> matchcount/crossing mode
    ncols:  i64,
    ckind:  [i32; 8],
    // ── slice-3: incremental GROUP aggregation (single top-level scan) ──
    is_aggr:   bool,         // top step is `group by … aggregate …` -> AggState path
    agg_n:     i64,          // number of aggregate columns
    agg_fnid:  [i32; 8],     // AGG_* id per column (1 count / 2 sum / 5 avg — GROUP)
    agg_arg_w: [i64; 8],     // raw SExpr of each agg's arg (0 for count / has_arg=false)
    agg_out:   [str; 8],     // bound out-name of each agg column (projection reads it)
    key_w:     i64,          // raw SExpr of the group key (evaluated per scan row)
    agg:       AggState,     // the maintained per-group accumulators (a/b unused here)
}

impl IncrJoin {
    // One epoch: admit (da over the LEFT source, db over the RIGHT source),
    // compute the netted output delta, apply it, THEN integrate (§8.2).
    pub fn epoch(self: &mut IncrJoin, da: &ZBatch, db: &ZBatch) {
        // slice-3: GROUP aggregation is a SINGLE-SCAN operator — consume only `da`
        // (the scan source); `db` is ignored (no second source in this fragment).
        if self.is_aggr { self.ag_run(da); return; }
        let cat: &SchemaCatalog = &self.cat;
        let env: &QEnv = unsafe { &*(self.envp as *const QEnv) };
        let scratch: Writ = writ_new(2048i64);
        let on_w: i64 = self.on_w; let equi_w: i64 = self.equi_w;
        let build_w: i64 = self.build_w; let probe_w: i64 = self.probe_w;
        let pred_w: i64 = self.pred_w; let has_pred: bool = self.has_pred;
        let sel_w: i64 = self.sel_w; let lvar: str = self.lvar; let rvar: str = self.rvar;
        let has_distinct: bool = self.has_distinct;

        // Δ keys: ΔA via probe_w (left var), ΔB via build_w (right var).
        let mut dakeys: Vec<RtVal> = vec_new::<RtVal>();
        let mut ia: i64 = 0i64;
        while ia < da.node.len() {
            dakeys.push(ij_key(probe_w, lvar, da.node.get(ia), cat, env, &scratch));
            ia = ia + 1i64;
        }
        let mut dbkeys: Vec<RtVal> = vec_new::<RtVal>();
        let mut ib: i64 = 0i64;
        while ib < db.node.len() {
            dbkeys.push(ij_key(build_w, rvar, db.node.get(ib), cat, env, &scratch));
            ib = ib + 1i64;
        }

        // ── ANTI PATH (§10.4): matchcount maintenance + 0↔>0 crossing emit ──
        if self.is_anti {
            let mut oda: ZOut = zout_new(self.ncols);
            let odap: *mut ZOut = &mut oda;

            // PHASE 1 — ΔB crossings over the EXISTING left population, using the
            // PRE-ΔA left weight and PRE-ΔB matchcount. Accumulate Δmc per touched
            // left slot (slot-indexed scratch, applied ONCE — never per db entry).
            let nla: i64 = self.a.node.len();
            let mut dmc: Vec<i64> = vec_new::<i64>();
            let mut seen: Vec<bool> = vec_new::<bool>();
            let mut zi: i64 = 0i64;
            while zi < nla { dmc.push(0i64); seen.push(false); zi = zi + 1i64; }
            let mut touched: Vec<i64> = vec_new::<i64>();
            let ap_idx: *mut HashMap<u64, Vec<i64>> =
                (&self.a.idx as *const HashMap<u64, Vec<i64>>) as *mut HashMap<u64, Vec<i64>>;
            let nbd: i64 = db.node.len();
            let mut bj: i64 = 0i64;
            while bj < nbd {
                let wb: i64 = db.wt.get(bj);
                if wb != 0i64 {
                    let kb: RtVal = dbkeys.get(bj);
                    let hp: u64 = rt_key_hash(kb);
                    let bp: *const Vec<i64> = unsafe { ap_idx.get(&hp) };
                    if (bp as i64) != 0i64 {
                        let bucket: &Vec<i64> = unsafe { &*bp };
                        let nbk: i64 = bucket.len();
                        let mut t: i64 = 0i64;
                        while t < nbk {
                            let ls: i64 = bucket.get(t);
                            // NOTE: maintain mc for ALL key-matching left slots,
                            // incl. wt==0 (else a re-inserted row reads stale mc in
                            // Phase 3). The crossing emit at wt==0 is a no-op.
                            if rt_eq(kb, self.a.key.get(ls)) {
                                let mut cb: RBinds = rbinds_new();
                                cb.bind_val(lvar, RtVal::Node(self.a.node.get(ls)));
                                cb.bind_val(rvar, RtVal::Node(db.node.get(bj)));
                                let cbp: *const RBinds = &cb;
                                if eval_on_residual(on_w, equi_w, cat, env, cbp, &scratch) {
                                    if !seen.get(ls) { seen.set(ls, true); touched.push(ls); }
                                    dmc.set(ls, dmc.get(ls) + wb);
                                }
                            }
                            t = t + 1i64;
                        }
                    }
                }
                bj = bj + 1i64;
            }
            let nt: i64 = touched.len();
            let mut tj: i64 = 0i64;
            while tj < nt {
                let ls: i64 = touched.get(tj);
                let old: i64 = self.a.mc.get(ls);
                let neww: i64 = old + dmc.get(ls);
                if old == 0i64 && neww > 0i64 {
                    // new match ⇒ left LEAVES (−left, at PRE-ΔA weight)
                    ij_anti_emit(odap, &self.arena, self.a.node.get(ls), 0i64 - self.a.wt.get(ls),
                                 lvar, has_pred, pred_w, sel_w, cat, env, &scratch);
                } else {
                    if old > 0i64 && neww == 0i64 {
                        // last match retracted ⇒ left ENTERS (+left, at PRE-ΔA weight)
                        ij_anti_emit(odap, &self.arena, self.a.node.get(ls), self.a.wt.get(ls),
                                     lvar, has_pred, pred_w, sel_w, cat, env, &scratch);
                    }
                }
                self.a.mc.set(ls, neww);
                tj = tj + 1i64;
            }

            // PHASE 2 — INTEGRATE (after Phase-1 compute). Right FIRST: Phase 3's
            // matchcount probes post-ΔB `b`. New left slots get mc = −1 sentinel.
            ij_integrate(&mut self.b, db, build_w, rvar, cat, env, &scratch);
            ij_integrate(&mut self.a, da, probe_w, lvar, cat, env, &scratch);

            // PHASE 3 — ΔA gated by CURRENT (post-ΔB) matchcount. A new left copy
            // appears in the anti-output only if its key has matchcount==0.
            let nad: i64 = da.node.len();
            let mut ai: i64 = 0i64;
            while ai < nad {
                let wa: i64 = da.wt.get(ai);
                if wa != 0i64 {
                    let dn: WAny = da.node.get(ai);
                    let rawu: u64 = dn.raw() as u64;
                    let idp: *mut HashMap<u64, i64> =
                        (&self.a.id as *const HashMap<u64, i64>) as *mut HashMap<u64, i64>;
                    let sp: *const i64 = unsafe { idp.get(&rawu) };
                    let s: i64 = unsafe { *sp };   // exists post-integrate
                    if self.a.mc.get(s) < 0i64 {
                        let mcv: i64 = ij_matchcount(dn, dakeys.get(ai), &self.b,
                                                     on_w, equi_w, lvar, rvar, cat, env, &scratch);
                        self.a.mc.set(s, mcv);
                    }
                    if self.a.mc.get(s) == 0i64 {
                        ij_anti_emit(odap, &self.arena, dn, wa,
                                     lvar, has_pred, pred_w, sel_w, cat, env, &scratch);
                    }
                }
                ai = ai + 1i64;
            }

            out_apply(&mut self.out, &self.arena, &oda, has_distinct);
            return;
        }

        // ── COMPUTE ΔJ against the CURRENT (pre-integrate) arrangements ──
        let mut od: ZOut = zout_new(self.ncols);
        let odp: *mut ZOut = &mut od;
        // T1: ΔA ⋈ B_int
        ij_join_term(odp, &self.arena, &da.node, &da.wt, &dakeys, &self.b, true,
                     lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, cat, env, &scratch);
        // T2: A_int ⋈ ΔB   (left = ΔB binds rvar; right = A_int binds lvar)
        ij_join_term(odp, &self.arena, &db.node, &db.wt, &dbkeys, &self.a, false,
                     lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, cat, env, &scratch);
        // T3: ΔA ⋈ ΔB   (the cross term — computed before integrate)
        ij_cross_term(odp, &self.arena, &da.node, &da.wt, &dakeys, &db.node, &db.wt, &dbkeys,
                      lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, cat, env, &scratch);

        // ── APPLY the netted delta into out_int (crossing for set mode) ──
        out_apply(&mut self.out, &self.arena, &od, has_distinct);

        // ── INTEGRATE (AFTER compute) ──
        ij_integrate(&mut self.a, da, probe_w, lvar, cat, env, &scratch);
        ij_integrate(&mut self.b, db, build_w, rvar, cat, env, &scratch);
    }

    // One epoch of incremental GROUP aggregation (DBSP slice-3, ADR 0013 §3.1).
    // Folds `da` into the per-group i64 accumulators (the abelian GROUP inverse
    // makes retraction O(1), no rescan) and stages the group-row Δ into a scratch
    // ZOut, then out_apply (reused verbatim — the aggregate output is a projected
    // tuple ZOut identical in kind to the join/anti output).
    //   • integrate-after-compute: the OLD group tuple is captured BEFORE any
    //     mutation to that slot; −old/+new is derived from old-vs-new.
    //   • emit-once-per-touched-slot (seen/touched): multiple `da` entries hitting
    //     one group stage exactly one −old and one +new (no intra-epoch thrash).
    //   • empty-group DROP: gcount→0 stages ONLY the −old retraction and sets
    //     live=false — never a stale 0-count row, never a +（key,0).
    fn ag_run(self: &mut IncrJoin, da: &ZBatch) {
        let cat: &SchemaCatalog = &self.cat;
        let env: &QEnv = unsafe { &*(self.envp as *const QEnv) };
        let scratch: Writ = writ_new(2048i64);
        let n: i64 = self.agg_n;
        let key_w: i64 = self.key_w;
        let lvar: str = self.lvar;
        let has_pred: bool = self.has_pred;
        let pred_w: i64 = self.pred_w;
        let sel_w: i64 = self.sel_w;

        let mut od: ZOut = zout_new(self.ncols);
        let odp: *mut ZOut = &mut od;

        // Per-touched-slot OLD snapshot (captured before mutation) + seen/touched;
        // grown to cover slots created THIS epoch (their OLD is zero/not-live).
        let mut seen:   Vec<bool> = vec_new::<bool>();
        let mut old_gc: Vec<i64>  = vec_new::<i64>();
        let mut old_lv: Vec<bool> = vec_new::<bool>();
        let mut old_gs: Vec<i64>  = vec_new::<i64>();   // stride n (GROUP accumulator)
        let mut old_best: Vec<i64> = vec_new::<i64>();  // stride n (SEMILATTICE pre-epoch best)
        let mut touched: Vec<i64> = vec_new::<i64>();

        let nd: i64 = da.node.len();
        let mut di: i64 = 0i64;
        while di < nd {
            let w: i64 = da.wt.get(di);
            if w != 0i64 {
                let node: WAny = da.node.get(di);
                let mut kb: RBinds = rbinds_new();
                kb.bind_val(lvar, RtVal::Node(node));
                let kbp: *const RBinds = &kb;
                let k: RtVal = eval_sexpr(sx_of(key_w), cat, env, kbp, &scratch);
                let slot: i64 = aggstate_ensure(&mut self.agg, k, n, &self.arena);
                // grow the OLD/seen scratch to cover `slot`
                while seen.len() <= slot {
                    seen.push(false);
                    old_gc.push(0i64);
                    old_lv.push(false);
                    let mut gi: i64 = 0i64;
                    while gi < n { old_gs.push(0i64); old_best.push(0i64); gi = gi + 1i64; }
                }
                if !seen.get(slot) {
                    seen.set(slot, true);
                    touched.push(slot);
                    old_gc.set(slot, self.agg.gcount.get(slot));
                    old_lv.set(slot, self.agg.live.get(slot));
                    let mut gi2: i64 = 0i64;
                    while gi2 < n {
                        old_gs.set(slot * n + gi2, self.agg.gsum.get(slot * n + gi2));
                        old_best.set(slot * n + gi2, self.agg.vbest.get(slot * n + gi2));
                        gi2 = gi2 + 1i64;
                    }
                }
                // MUTATE (= integrate): gcount += w; per sum/avg slot gsum += w·arg.
                self.agg.gcount.set(slot, self.agg.gcount.get(slot) + w);
                let mut ai: i64 = 0i64;
                while ai < n {
                    let fnid: i32 = self.agg_fnid[ai];
                    if fnid == 2i32 || fnid == 5i32 {
                        let av: RtVal = eval_sexpr(sx_of(self.agg_arg_w[ai]), cat, env, kbp, &scratch);
                        let cur: i64 = self.agg.gsum.get(slot * n + ai);
                        self.agg.gsum.set(slot * n + ai, cur + w * rt_i(av));
                    } else if fnid == 3i32 || fnid == 4i32 {
                        // SEMILATTICE min/max (ADR 0013 §3.1, slice-4): maintain a
                        // value→live-multiplicity map + cached best; O(1) improve on
                        // insert, rescan this group's live keys on best-retraction.
                        let av: i64 = rt_i(eval_sexpr(sx_of(self.agg_arg_w[ai]), cat, env, kbp, &scratch));
                        let mp: *mut HashMap<i64, i64> = unsafe { self.agg.vmap.at(slot * n + ai) };
                        let cp: *const i64 = unsafe { mp.get(&av) };
                        let cur: i64 = if (cp as i64) == 0i64 { 0i64 } else { unsafe { *cp } };
                        let nc: i64 = cur + w;                       // valcount[v] += w
                        let mut removed_best: bool = false;
                        if nc <= 0i64 {
                            unsafe { mp.remove(&av); }               // value fully retracted
                            // compare against the best BEFORE any mutation to it below
                            if self.agg.vbest.get(slot * n + ai) == av { removed_best = true; }
                        } else {
                            unsafe { mp.insert(av, nc); }            // upsert (overwrites)
                        }
                        // best update on a value NEWLY present (0→>0, incl. re-add):
                        if nc > 0i64 && cur <= 0i64 {
                            let mlen: i64 = unsafe { (&*(mp as *const HashMap<i64, i64>)).len() };
                            if mlen == 1i64 {
                                self.agg.vbest.set(slot * n + ai, av);       // first live value = best
                            } else if (fnid == 3i32 && av < self.agg.vbest.get(slot * n + ai))
                                   || (fnid == 4i32 && av > self.agg.vbest.get(slot * n + ai)) {
                                self.agg.vbest.set(slot * n + ai, av);       // O(1) improve (meet/join)
                            }
                        }
                        if removed_best {
                            // ── RE-MIN / RE-MAX (trap 1): rescan THIS group/col's
                            //    live keys only (never the whole relation). Empty ⇒
                            //    group emptying ⇒ gcount hits 0 ⇒ empty-drop handles it,
                            //    vbest left stale-but-unread (+new suppressed).
                            // DEFERRED OPT: an ordered structure (BTree/heap) gives an
                            //    O(log n) rescan — not built now (correctness-first).
                            let mpc: *const HashMap<i64, i64> = unsafe { self.agg.vmap.at(slot * n + ai) } as *const HashMap<i64, i64>;
                            if unsafe { (&*mpc).len() } > 0i64 {
                                let mut nb: i64 = if fnid == 3i32 { 9223372036854775807i64 } else { -9223372036854775807i64 - 1i64 };
                                let mut kit: HashMapKeys<i64, i64> = unsafe { mpc.keys() };
                                loop {
                                    match kit.next() {
                                        Option::Some(kp) => {
                                            let kv: i64 = *kp;
                                            if fnid == 3i32 { if kv < nb { nb = kv; } }
                                            else            { if kv > nb { nb = kv; } }
                                        }
                                        Option::None => { break; }
                                    }
                                }
                                self.agg.vbest.set(slot * n + ai, nb);
                            }
                        }
                    }
                    ai = ai + 1i64;
                }
            }
            di = di + 1i64;
        }

        // Stage the group-row deltas (−old if it was live, +new if still non-empty).
        let nt: i64 = touched.len();
        let mut tj: i64 = 0i64;
        while tj < nt {
            let slot: i64 = touched.get(tj);
            let key: RtVal = self.agg.keyv.get(slot);
            if old_lv.get(slot) {
                let mut oldvals: Vec<RtVal> = vec_new::<RtVal>();
                let mut oi: i64 = 0i64;
                while oi < n {
                    let fnid: i32 = self.agg_fnid[oi];
                    if fnid == 1i32 {
                        oldvals.push(RtVal::I(old_gc.get(slot)));
                    } else if fnid == 5i32 {
                        oldvals.push(RtVal::F((old_gs.get(slot * n + oi) as f64) / (old_gc.get(slot) as f64)));
                    } else if fnid == 3i32 || fnid == 4i32 {
                        oldvals.push(RtVal::I(old_best.get(slot * n + oi)));   // pre-epoch extremum
                    } else {
                        oldvals.push(RtVal::I(old_gs.get(slot * n + oi)));
                    }
                    oi = oi + 1i64;
                }
                ag_emit(odp, &self.arena, key, &oldvals, n, 0i64 - 1i64,
                        &self.agg_out, has_pred, pred_w, sel_w, cat, env, &scratch);
            }
            let newc: i64 = self.agg.gcount.get(slot);
            if newc > 0i64 {
                let mut newvals: Vec<RtVal> = vec_new::<RtVal>();
                let mut ni: i64 = 0i64;
                while ni < n {
                    let fnid: i32 = self.agg_fnid[ni];
                    if fnid == 1i32 {
                        newvals.push(RtVal::I(newc));
                    } else if fnid == 5i32 {
                        newvals.push(RtVal::F((self.agg.gsum.get(slot * n + ni) as f64) / (newc as f64)));
                    } else if fnid == 3i32 || fnid == 4i32 {
                        newvals.push(RtVal::I(self.agg.vbest.get(slot * n + ni)));   // post-epoch extremum
                    } else {
                        newvals.push(RtVal::I(self.agg.gsum.get(slot * n + ni)));
                    }
                    ni = ni + 1i64;
                }
                ag_emit(odp, &self.arena, key, &newvals, n, 1i64,
                        &self.agg_out, has_pred, pred_w, sel_w, cat, env, &scratch);
                self.agg.live.set(slot, true);
            } else {
                self.agg.live.set(slot, false);   // empty-group drop (−old already staged)
            }
            tj = tj + 1i64;
        }

        out_apply(&mut self.out, &self.arena, &od, self.has_distinct);
    }

    // Read the maintained state as a self-contained QRows (compare at
    // quiescence, U3). Set mode: one row per live tuple (memb). Bag mode:
    // `wt` duplicate rows per tuple (multiplicity expanded to match the
    // batch oracle's duplicate output rows).
    pub fn snapshot(self: &IncrJoin) -> QRows {
        let mut rows: QRows = QRows {
            arena: writ_new(1024i64),
            ncols: self.ncols,
            kinds: self.ckind,
            cells: vec_new::<RtVal>(),
            nrows: 0i64,
        };
        let out: &ZOut = &self.out;
        let nc: i64 = out.ncols;
        let n: i64 = out.wt.len();
        let mut i: i64 = 0i64;
        while i < n {
            if self.has_distinct {
                if out.memb.get(i) { ij_push_row(&mut rows, out, i, nc); }
            } else {
                let w: i64 = out.wt.get(i);
                let mut k: i64 = 0i64;
                while k < w { ij_push_row(&mut rows, out, i, nc); k = k + 1i64; }
            }
            i = i + 1i64;
        }
        return rows;
    }
}

// Push out-tuple `slot` into a QRows, re-interning strings into the QRows arena.
fn ij_push_row(rows: &mut QRows, out: &ZOut, slot: i64, nc: i64) {
    let mut c: i64 = 0i64;
    while c < nc {
        let v: RtVal = out.cells.get(slot * nc + c);
        match v {
            RtVal::S(s) => {
                let iv: str = intern_str(&rows.arena, s);
                rows.cells.push(RtVal::S(iv));
            }
            _ => { rows.cells.push(v); }
        }
        c = c + 1i64;
    }
    rows.nrows = rows.nrows + 1i64;
}

impl Query {
    // Build an incremental maintainer for this query against `env`'s base
    // sources. Slice-1 fragment = RScan/RFilter/RProj + one top RJoin; slice-2
    // adds a single top-level RAnti (stateful matchcount, §3/§10.4). Returns Err
    // (an error VALUE) if the plan is outside that: any of RSort/RLimit/REdge/
    // RAggr/RFix, a non-Scan join/anti child, a self-join/self-anti, a rel block
    // (reg.n != 0), or a non-hash (f64) join key. `env` must stay alive and
    // its base sources must be NON-EMPTY (the join tier resolves off the live
    // element type).
    pub fn incremental(self: &Query, env: &QEnv) -> Result<IncrJoin, QError> {
        if self.empty {
            return Result::Err(qerr("Query::incremental: empty query plan (no rows) — nothing to maintain"));
        }
        // U1: slice-1 is rel-free ⇒ qrel_materialize unreachable; the only
        // dedup point is the top RExpr::Distinct.
        if self.reg.n != 0i64 {
            return Result::Err(qerr("Query::incremental: query has a `rel` block — recursion/rels are out of slice-1"));
        }
        let root: RExpr = WAny::ref_to(self.root as *const u8).view::<RExpr>();
        // ── fragment guard: peel  RDistinct?( RProj( RFilter?( RJoin(Scan,Scan) ) ) ) ──
        let mut has_distinct: bool = false;
        let mut cur: RExpr = root;
        match cur {
            RExpr::Limit(_l)    => { return Result::Err(qerr("Query::incremental: `limit` is out of slice-1")); }
            RExpr::Distinct(d)  => { has_distinct = true; cur = d.input_expr(); }
            _ => { }
        }
        let mut sel_w: i64 = 0i64;
        match cur {
            RExpr::Proj(p) => { sel_w = p.sel.any().raw(); cur = p.input_expr(); }
            _ => { return Result::Err(qerr("Query::incremental: plan has no projection")); }
        }
        let mut has_pred: bool = false;
        let mut pred_w: i64 = 0i64;
        match cur {
            RExpr::Sort(_s)  => { return Result::Err(qerr("Query::incremental: `order by` is out of slice-1")); }
            RExpr::Filter(f) => { has_pred = true; pred_w = f.pred.any().raw(); cur = f.input_expr(); }
            _ => { }
        }
        // The scrutinee is a schema-enum; value-yielding match over one is not
        // supported (statement form only), so extract into mutable locals.
        let mut lvar: str = "";
        let mut rvar: str = "";
        let mut lsrc: str = "";
        let mut rsrc: str = "";
        let mut on_w: i64 = 0i64;
        let mut join_w: i64 = 0i64;
        let mut is_join: bool = false;
        let mut is_anti: bool = false;
        match cur {
            RExpr::Join(jn)  => {
                let mut lok: bool = false;
                let mut rok: bool = false;
                match jn.left_expr()  { RExpr::Scan(s) => { lvar = s.var_name; lsrc = s.src_name; lok = true; } _ => { } }
                match jn.right_expr() { RExpr::Scan(s) => { rvar = s.var_name; rsrc = s.src_name; rok = true; } _ => { } }
                if !lok { return Result::Err(qerr("Query::incremental: the join's left input is not a bare scan")); }
                if !rok { return Result::Err(qerr("Query::incremental: the join's right input is not a bare scan")); }
                on_w = jn.on.any().raw();
                join_w = jn.as_ref().raw();
                is_join = true;
            }
            // slice-2: a single top-level `anti join` (STATEFUL, §3/§10.4). Left/
            // right must be bare scans; self-anti still rejected below (str_eq).
            RExpr::Anti(an) => {
                let mut lok: bool = false;
                let mut rok: bool = false;
                match an.left_expr()  { RExpr::Scan(s) => { lvar = s.var_name; lsrc = s.src_name; lok = true; } _ => { } }
                match an.right_expr() { RExpr::Scan(s) => { rvar = s.var_name; rsrc = s.src_name; rok = true; } _ => { } }
                if !lok { return Result::Err(qerr("Query::incremental: the anti join's left input is not a bare scan")); }
                if !rok { return Result::Err(qerr("Query::incremental: the anti join's right input is not a bare scan")); }
                on_w = an.on.any().raw();
                join_w = an.as_ref().raw();
                is_join = true;
                is_anti = true;
            }
            // slice-3/4: a single top-level GROUP/SEMILATTICE aggregate over ONE
            // bare scan. count/sum/avg = abelian GROUP (O(1) inverse-on-retract);
            // min/max = SEMILATTICE (O(1) improve, rescan-on-best-retract, slice-4).
            // The input MUST be a bare Scan — this implicitly rejects join+aggregate
            // and any pre-group WHERE/RFilter. Mixed GROUP+SEMILATTICE columns in
            // one query are accepted (per-column dispatch on agg_fnid).
            RExpr::Aggr(g) => {
                let mut sok: bool = false;
                match g.input_expr() {
                    RExpr::Scan(s) => { lvar = s.var_name; lsrc = s.src_name; sok = true; }
                    _ => { }
                }
                if !sok {
                    return Result::Err(qerr("Query::incremental: aggregate input is not a bare scan — join/where+aggregate is out of slice-3"));
                }
                // strict check to populate agg_n / agg_fnid / agg_ret + ncols/ckind
                let mut achk: Chk = chk_new();
                let mut aqp: QPlan = qplan_new();
                let mut alb: CBinds = cbinds_new();
                check_rexpr(root, &self.cat, env, true, &mut alb, &mut achk, &mut aqp, &self.reg);
                if achk.failed { return Result::Err(chk_err(achk)); }
                let an: i64 = aqp.agg_n;
                // ALGEBRA GATE — accept abelian-GROUP (1 count / 2 sum / 5 avg) and
                // SEMILATTICE (3 min / 4 max, slice-4) aggregates; reject only UDA
                // (fnid 0 — no inverse, no lattice guarantee). Reuse of
                // rexpr_walk::agg_algebra's classification.
                let mut gi3: i64 = 0i64;
                while gi3 < an {
                    let fnid: i32 = aqp.agg_fnid[gi3];
                    if fnid == 0i32 {
                        return Result::Err(qerr("Query::incremental: UDA aggregate has no inverse/lattice guarantee — out of slice-3/4"));
                    }
                    gi3 = gi3 + 1i64;
                }
                // capture the group key + per-agg fnid / arg-expr / out-name
                let mut afnid: [i32; 8] = [0i32; 8];
                let mut aargw: [i64; 8] = [0i64; 8];
                let mut aout:  [str; 8] = [""; 8];
                let aggs: RAggArr = g.aggs_arr();
                let mut ci2: i64 = 0i64;
                while ci2 < an {
                    let ag: RAgg = aggs.agg_at(ci2);
                    afnid[ci2] = aqp.agg_fnid[ci2];
                    aout[ci2]  = ag.out;
                    if ag.has_arg { aargw[ci2] = ag.arg.any().raw(); }
                    ci2 = ci2 + 1i64;
                }
                let akey_w: i64 = g.key.any().raw();
                let ancols: i64 = aqp.ncols;
                let ackind: [i32; 8] = aqp.ckind;
                // resolve the single source
                let aei: i64 = env.find(lsrc);
                if aei < 0i64 {
                    return Result::Err(qerr("Query::incremental: the aggregate source is not bound on the env"));
                }
                let asrcv: WAny = WAny::ref_to(env.words[aei] as *const u8);
                // build the engine (join fields inert; a/b allocated-but-unused)
                let mut eng: IncrJoin = IncrJoin {
                    arena: writ_new(4096i64),
                    a: arr_new(lvar), b: arr_new(""),
                    out: zout_new(ancols),
                    cat: catalog_clone(&self.cat),
                    envp: (env as *const QEnv) as i64,
                    on_w: 0i64, equi_w: 0i64, build_w: 0i64, probe_w: 0i64,
                    pred_w: pred_w, has_pred: has_pred, sel_w: sel_w,
                    lvar: lvar, rvar: "", has_distinct: has_distinct,
                    is_anti: false,
                    ncols: ancols, ckind: ackind,
                    is_aggr: true, agg_n: an, agg_fnid: afnid, agg_arg_w: aargw,
                    agg_out: aout, key_w: akey_w, agg: aggstate_new(),
                };
                // base-fill: +1/identity per source element through the SAME
                // accumulate+emit path (seeds AggState and the initial out).
                let ba: ZBatch = ij_batch_from_source(asrcv);
                eng.ag_run(&ba);
                return Result::Ok(eng);
            }
            RExpr::Edge(_e) => { return Result::Err(qerr("Query::incremental: graph traversal (edge) is out of slice-1")); }
            RExpr::Fix(_x)  => { return Result::Err(qerr("Query::incremental: recursion (fix) is out of slice-1")); }
            _ => { return Result::Err(qerr("Query::incremental: the fragment must be exactly one join of two scans")); }
        }
        if !is_join {
            return Result::Err(qerr("Query::incremental: the fragment must be exactly one join of two scans"));
        }
        // self-join guard (§10.4 — a single ΔA must feed both positions).
        if str_eq(lsrc, rsrc) {
            return Result::Err(qerr("Query::incremental: self-join is out of slice-1"));
        }

        // ── strict check to populate the join plan + projection kinds ──
        let mut chk: Chk = chk_new();
        let mut qp: QPlan = qplan_new();
        let mut lb: CBinds = cbinds_new();
        check_rexpr(root, &self.cat, env, true, &mut lb, &mut chk, &mut qp, &self.reg);
        if chk.failed { return Result::Err(chk_err(chk)); }
        let ji: i64 = qp_jfind(&qp, join_w);
        if ji < 0i64 {
            return Result::Err(qerr("Query::incremental: internal — join node not in the plan"));
        }
        if qp.jtier[ji] != QT_HASH {
            return Result::Err(qerr("Query::incremental: join key is not hash-arrangeable (f64/loop tier) — out of slice-1"));
        }
        let build_w: i64  = qp.jbuild[ji];
        let probe_w: i64  = qp.jprobe[ji];
        let equi_w: i64   = qp.jequi[ji];
        let ncols: i64    = qp.ncols;
        let ckind: [i32; 8] = qp.ckind;

        // ── resolve base sources ──
        let lei: i64 = env.find(lsrc);
        let rei: i64 = env.find(rsrc);
        if lei < 0i64 || rei < 0i64 {
            return Result::Err(qerr("Query::incremental: a join source is not bound on the env"));
        }
        let lsrcv: WAny = WAny::ref_to(env.words[lei] as *const u8);
        let rsrcv: WAny = WAny::ref_to(env.words[rei] as *const u8);

        // ── build the engine ──
        let mut eng: IncrJoin = IncrJoin {
            arena: writ_new(4096i64),
            a: arr_new(lvar),
            b: arr_new(rvar),
            out: zout_new(ncols),
            cat: catalog_clone(&self.cat),
            envp: (env as *const QEnv) as i64,
            on_w: on_w, equi_w: equi_w, build_w: build_w, probe_w: probe_w,
            pred_w: pred_w, has_pred: has_pred, sel_w: sel_w,
            lvar: lvar, rvar: rvar, has_distinct: has_distinct,
            is_anti: is_anti,
            ncols: ncols, ckind: ckind,
            is_aggr: false, agg_n: 0i64, agg_fnid: [0i32; 8], agg_arg_w: [0i64; 8],
            agg_out: [""; 8], key_w: 0i64, agg: aggstate_new(),
        };
        let scratch: Writ = writ_new(2048i64);
        // fill arrangements from the base sources (+1/identity per element)
        let ba: ZBatch = ij_batch_from_source(lsrcv);
        ij_integrate(&mut eng.a, &ba, probe_w, lvar, &eng.cat, env, &scratch);
        let bb: ZBatch = ij_batch_from_source(rsrcv);
        ij_integrate(&mut eng.b, &bb, build_w, rvar, &eng.cat, env, &scratch);
        let mut od0: ZOut = zout_new(ncols);
        if is_anti {
            // base anti-out = { left row : matchcount==0 } over A_int / B_int.
            // Overwrites every left slot's mc eagerly (no −1 sentinel survives).
            let nla: i64 = eng.a.node.len();
            let mut ls: i64 = 0i64;
            while ls < nla {
                let mcv: i64 = ij_matchcount(eng.a.node.get(ls), eng.a.key.get(ls), &eng.b,
                                             on_w, equi_w, lvar, rvar, &eng.cat, env, &scratch);
                eng.a.mc.set(ls, mcv);
                if mcv == 0i64 {
                    ij_anti_emit(&mut od0, &eng.arena, eng.a.node.get(ls), eng.a.wt.get(ls),
                                 lvar, has_pred, pred_w, sel_w, &eng.cat, env, &scratch);
                }
                ls = ls + 1i64;
            }
        } else {
            // base out = A_int ⋈ B_int (one join_term — integrate-order-independent)
            ij_join_term(&mut od0, &eng.arena, &eng.a.node, &eng.a.wt, &eng.a.key, &eng.b, true,
                         lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, &eng.cat, env, &scratch);
        }
        out_apply(&mut eng.out, &eng.arena, &od0, has_distinct);
        return Result::Ok(eng);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// INCREMENTAL LINEAR-RECURSIVE REL — slice-5 (ADR 0013 §4, R1)
//
// Maintains a single LINEAR self-recursive rel (canonical: transitive closure
// over an edge relation) under ±ΔEDB, differential-tested vs the queue-2 batch
// least-fixpoint oracle (Query::run). This slice ships INSERTIONS solid.
//
// DESIGN — maximal reuse of the batch semi-naïve kernel (derive-from-foundation):
// the maintained relation is the SAME append-only RelCtx storage + shadow-set
// the batch materializer uses, PERSISTED across epochs. An insert epoch:
//   (1) admit ΔEDB, update the edge multiset, collect NEWLY-PRESENT edges (NE);
//   (2) SEED round-0 from ΔEDB — the base body over NE (new direct edges) PLUS
//       the recursive body with the EXISTING relation as its delta and NE as
//       the joined edge (existing-path ⋈ new-edge). Both push through the SAME
//       qrel_push_out shadow-set (per-round DISTINCT on MEMBERSHIP, §3 / U4);
//   (3) run the batch inner fixpoint (round-delta ⋈ FULL-edges) to quiescence.
// The shadow-set membership-crossing (a tuple appends at most once) is exactly
// the batch termination mechanism — cycles enlarge a FINITE closure, the round
// empties, NO round cap (§4.4). Correctness: closure(E∪NE) = closure(E) plus
// every path using ≥1 new edge; such a path splits at its FIRST new edge into
// (all-old prefix ∈ existing-relation) ⋈ (new edge) ⋈ (any-edge suffix) — the
// prefix+new-edge is a round-0 seed, the suffix is inner-loop propagation. So
// the incremental result equals the batch recompute by construction (same code
// path, same dedup), which the differential harness confirms.
//
// RETRACTION (− edge Δ) is NOT maintained here (honest partial): a single scalar
// weight cannot carry retraction on cyclic graphs (spurious circular support —
// R-spurious counterexample edges {a→b,b→c,c→b}, delete a→b: (a,b)/(a,c) prop
// each other up via the surviving b⇄c cycle), so LINEAR recursion does NOT let
// weight-cancellation subsume DRed. Correct retraction needs mark-based DRed
// (over-delete → re-derive); left for the next pass. This engine tracks the
// edge SET for both signs but only GROWS the closure — a − delta leaves stale
// tuples (the differential harness for − deltas is red by construction, the
// honest status). See docs/adr/0013 §4.2 and the slice-5 self-critique.
// ═══════════════════════════════════════════════════════════════════════════

// Peel RProj/RFilter to the underlying RScan and return its source name ("" if
// the shape is not a scan-rooted pipeline). Used to resolve a base body's edge
// source (a base body scans ONLY the edge source — no in-rel occurrence).
fn ir_scan_src(e: RExpr) -> str {
    let mut cur: RExpr = e;
    loop {
        match cur {
            RExpr::Proj(p)   => { cur = p.input_expr(); }
            RExpr::Filter(f) => { cur = f.input_expr(); }
            RExpr::Distinct(d) => { cur = d.input_expr(); }
            RExpr::Scan(s)   => { return s.src_name; }
            _ => { return ""; }
        }
    }
}

// Populate `qp` by strict-checking every non-empty rel body + the entry against
// `env` (mirrors Query::run's check loop — the plan words the executor reads).
fn ir_check(q: &Query, env: &QEnv, qp: &mut QPlan, chk: &mut Chk) {
    let mut bi: i64 = 0i64;
    while bi < q.bodies.n && !chk.failed {
        if q.bodies.empty.get(bi) == 0i64 {
            let mut lbb: CBinds = cbinds_new();
            let broot: RExpr = WAny::ref_to(q.bodies.root.get(bi) as *const u8).view::<RExpr>();
            check_rexpr(broot, &q.cat, env, true, &mut lbb, chk, qp, &q.reg);
        }
        bi = bi + 1i64;
    }
    if !chk.failed {
        let root: RExpr = WAny::ref_to(q.root as *const u8).view::<RExpr>();
        let mut lb: CBinds = cbinds_new();
        check_rexpr(root, &q.cat, env, true, &mut lb, chk, qp, &q.reg);
    }
}

// The maintained incremental linear-recursive relation. Owns the persistent
// rel storage (append-only rows + shadow dedup, batch parity) and the edge
// multiset; holds a raw pointer to the Query (must outlive the engine, like
// IncrJoin::envp). `env` binds ONLY the edge source (rebuilt per phase).
pub struct IncrRec {
    qptr:     i64,                     // *const Query (must outlive)
    env:      QEnv,                    // owns the edge-source binding
    edoc:     Writ,                    // arena for the per-phase edge arrays
    enode:    Vec<WAny>,               // edge nodes (slot-stable)
    ewt:      Vec<i64>,                // edge weight per slot (identity-coalesced)
    eid:      HashMap<u64, i64>,       // edge raw handle -> slot
    rows:     Vec<RtVal>,              // path storage (cell-flat, stride ncols)
    rhm:      HashMap<u64, Vec<i64>>,  // shared shadow-set (SET dedup)
    ptot:     i64,                     // path ROW count (the maintained total)
    edge_src: str,
    ncols:    i64,                     // rel column count
    rec_body: i64,                     // the single linear recursive body index
    rec_ovr:  i64,                     // its in-rel scan node word (delta reader)
    nbase:    i64,
    base_b:   [i64; 8],                // base body indices (occ_n == 0)
}

// Build a WArray<WAny> in `edoc` from `nodes` and bind it as the edge source.
// Takes fields (not whole self) so it stays disjoint from a self.qptr borrow.
fn ir_bind_edges(edoc: &mut Writ, env: &mut QEnv, edge_src: str, nodes: &Vec<WAny>) {
    let n: i64 = nodes.len();
    // Keep the FAT `&mut` (it carries the arena zone; casting to a thin raw
    // pointer drops the allocator and `push`/`zone_of` then faults).
    let arr: &mut WArray<WAny> = edoc.array(n + 1i64);
    let mut i: i64 = 0i64;
    while i < n { arr.push(nodes.get(i)); i = i + 1i64; }
    let av: WAny = WAny::ref_to(arr as *const WArray<WAny> as *const u8);
    env.bind_source(edge_src, av);
}

// Node list of every currently-present edge (weight > 0).
fn ir_full_nodes(enode: &Vec<WAny>, ewt: &Vec<i64>) -> Vec<WAny> {
    let mut out: Vec<WAny> = vec_new::<WAny>();
    let n: i64 = enode.len();
    let mut i: i64 = 0i64;
    while i < n { if ewt.get(i) > 0i64 { out.push(enode.get(i)); } i = i + 1i64; }
    return out;
}

// Slice-6 DRed COMPACT probe: is row `r` of `src` (stride nc, rel index 0)
// present in the over-delete set (od_rows keyed by od_rhm)? Same hash + cellwise
// verify as qrel_push_out, so the mark set is content-addressed identically.
fn dred_in_od(od_rows: &Vec<RtVal>, od_rhm_i: i64, nc: i64,
              src: &Vec<RtVal>, r: i64) -> bool {
    let mut h: u64 = 14695981039346656037u64;
    h = h_step(h, 0u64);   // ri = 0
    let mut c: i64 = 0i64;
    while c < nc { h = h_step(h, rt_key_hash(src.get(r * nc + c))); c = c + 1i64; }
    let hm: *mut HashMap<u64, Vec<i64>> = od_rhm_i as *mut HashMap<u64, Vec<i64>>;
    let sp: *const Vec<i64> = unsafe { hm.get(&h) };
    if (sp as i64) == 0i64 { return false; }
    let bv: &Vec<i64> = unsafe { &*sp };
    let nb: i64 = bv.len();
    let mut t: i64 = 0i64;
    while t < nb {
        let enc: i64 = bv.get(t);
        if (enc & 7i64) == 0i64 {
            let idx: i64 = enc >> 3;
            let mut same: bool = true;
            let mut c2: i64 = 0i64;
            while c2 < nc {
                if !rt_eq(od_rows.get(idx * nc + c2), src.get(r * nc + c2)) { same = false; break; }
                c2 = c2 + 1i64;
            }
            if same { return true; }
        }
        t = t + 1i64;
    }
    return false;
}

impl IncrRec {
    // Recompute the closure from scratch over the CURRENT edge set (batch
    // semi-naïve). Used at build to seed the initial state.
    fn recompute(self: &mut IncrRec) {
        self.rows = vec_new::<RtVal>();
        self.rhm  = hashmap_new::<u64, Vec<i64>>();
        self.ptot = 0i64;
        let qp_raw: i64 = self.qptr;
        let q: &Query = unsafe { &*(qp_raw as *const Query) };
        let fulln: Vec<WAny> = ir_full_nodes(&self.enode, &self.ewt);
        ir_bind_edges(&mut self.edoc, &mut self.env, self.edge_src, &fulln);
        let mut chk: Chk = chk_new();
        let mut qp: QPlan = qplan_new();
        ir_check(q, &self.env, &mut qp, &mut chk);
        if chk.failed { return; }
        let scratch: Writ = writ_new(2048i64);
        let hmp_i:  i64 = (&mut self.rhm  as *mut HashMap<u64, Vec<i64>>) as i64;
        let rows_i: i64 = (&mut self.rows as *mut Vec<RtVal>) as i64;
        let mut ctx: RelCtx = relctx_new();
        ctx.n = q.reg.n;
        ctx.regp = (&q.reg as *const QRelReg) as i64;
        ctx.hmp = hmp_i;
        ctx.rowsp[0] = rows_i;
        let cp: *mut Chk = &mut chk;
        qrel_materialize(q, &self.env, &qp, &scratch, &mut ctx, cp);
        self.ptot = self.rows.len() / self.ncols;
    }

    // One epoch: admit ΔEDB `dedges` (±weighted edge handles) and maintain the
    // closure incrementally. INSERTIONS seed round-0 from ΔEDB + inner
    // semi-naïve fixpoint (slice-5). RETRACTIONS (and mixed ±) route through
    // mark-based DELETE-REDERIVE (slice-6, ADR §4.2): over-delete every path
    // fact whose derivation could use a deleted edge, compact the survivors,
    // then re-derive over the surviving edge set. Both directions terminate by
    // quiescence (monotone fixpoints, NO cap). Correct on cyclic graphs (the
    // scalar-weight-cancellation-unsound case).
    pub fn epoch(self: &mut IncrRec, dedges: &ZBatch) {
        let qp_raw: i64 = self.qptr;
        let q: &Query = unsafe { &*(qp_raw as *const Query) };
        // ── admit ΔEDB: coalesce by identity; collect newly-PRESENT edges (NE,
        // old≤0→now>0) AND newly-ABSENT edges (DE, old>0→now≤0). ──
        let mut ne_slots: Vec<i64> = vec_new::<i64>();
        let mut de_slots: Vec<i64> = vec_new::<i64>();
        let nd: i64 = dedges.node.len();
        let mut di: i64 = 0i64;
        while di < nd {
            let w: i64 = dedges.wt.get(di);
            if w != 0i64 {
                let node: WAny = dedges.node.get(di);
                let rawu: u64 = node.raw() as u64;
                let idp: *mut HashMap<u64, i64> = &mut self.eid;
                let sp: *const i64 = unsafe { idp.get(&rawu) };
                if (sp as i64) != 0i64 {
                    let slot: i64 = unsafe { *sp };
                    let old: i64 = self.ewt.get(slot);
                    let neww: i64 = old + w;
                    self.ewt.set(slot, neww);
                    if old <= 0i64 && neww > 0i64 { ne_slots.push(slot); }
                    if old > 0i64 && neww <= 0i64 { de_slots.push(slot); }
                } else {
                    let slot: i64 = self.enode.len();
                    self.enode.push(node);
                    self.ewt.push(w);
                    unsafe { let _q: *mut i64 = idp.get_or_insert(rawu, slot); }
                    if w > 0i64 { ne_slots.push(slot); }
                }
            }
            di = di + 1i64;
        }
        // ── RETRACTION (or mixed ±) → mark-based DRed; do NOT also run the
        // insert seed (avoids double-derivation — NE ⊂ PRES, absorbed by
        // re-derive). ──
        if de_slots.len() != 0i64 {
            self.dred(q, &de_slots);
            return;
        }
        // No newly-present edge and no retraction ⇒ no-op epoch (closure only
        // grows on insert; a pure no-op changes nothing).
        if ne_slots.len() == 0i64 { return; }

        // NE node list (newly present, still present).
        let mut nen: Vec<WAny> = vec_new::<WAny>();
        let mut ni: i64 = 0i64;
        while ni < ne_slots.len() {
            let s: i64 = ne_slots.get(ni);
            if self.ewt.get(s) > 0i64 { nen.push(self.enode.get(s)); }
            ni = ni + 1i64;
        }
        let fulln: Vec<WAny> = ir_full_nodes(&self.enode, &self.ewt);

        // qp against the FULL edge set (type/plan words are array-independent).
        ir_bind_edges(&mut self.edoc, &mut self.env, self.edge_src, &fulln);
        let mut chk: Chk = chk_new();
        let mut qp: QPlan = qplan_new();
        ir_check(q, &self.env, &mut qp, &mut chk);
        if chk.failed { return; }
        let scratch: Writ = writ_new(2048i64);
        let cp: *mut Chk = &mut chk;

        // persistent RelCtx over the maintained storage (tot = current total).
        let hmp_i:  i64 = (&mut self.rhm  as *mut HashMap<u64, Vec<i64>>) as i64;
        let rows_i: i64 = (&mut self.rows as *mut Vec<RtVal>) as i64;
        let ncols: i64 = self.ncols;
        let ptot0: i64 = self.ptot;
        let rec_body: i64 = self.rec_body;
        let rec_ovr: i64 = self.rec_ovr;
        let mut ctx: RelCtx = relctx_new();
        ctx.n = q.reg.n;
        ctx.regp = (&q.reg as *const QRelReg) as i64;
        ctx.hmp = hmp_i;
        ctx.rowsp[0] = rows_i;
        ctx.tot[0] = ptot0;
        let ctxp: *mut RelCtx = &mut ctx;

        // ── SEED round-0 from ΔEDB, edges bound to NE ──
        ir_bind_edges(&mut self.edoc, &mut self.env, self.edge_src, &nen);
        // base bodies over NE (new direct edges).
        let nb: i64 = self.nbase;
        let mut bi: i64 = 0i64;
        while bi < nb && !chk_bad(cp) {
            qrel_run_body(q, self.base_b[bi], &self.env, &qp, &scratch, ctxp, cp);
            bi = bi + 1i64;
        }
        // recursive body with the EXISTING relation [0,ptot) as its delta and
        // NE as the joined edge (existing-path ⋈ new-edge).
        if ptot0 > 0i64 && !chk_bad(cp) {
            rctx_set_ovr(ctxp, rec_ovr);
            rctx_set_delta(ctxp, 0i64, 0i64, ptot0);
            qrel_run_body(q, rec_body, &self.env, &qp, &scratch, ctxp, cp);
            rctx_set_ovr(ctxp, 0i64);
        }

        // ── INNER FIXPOINT: round-delta ⋈ FULL-edges to quiescence (batch
        // semi-naïve loop; per-round DISTINCT via the shadow-set; NO cap) ──
        ir_bind_edges(&mut self.edoc, &mut self.env, self.edge_src, &fulln);
        loop {
            if chk_bad(cp) { break; }
            let len: i64 = qrel_len(ctxp as *const RelCtx, 0i64, ncols);
            rctx_promote(ctxp, 0i64, len);
            if ctx.dlo[0] >= len { break; }   // least fixpoint (empty round-delta)
            rctx_set_ovr(ctxp, rec_ovr);
            qrel_run_body(q, rec_body, &self.env, &qp, &scratch, ctxp, cp);
            rctx_set_ovr(ctxp, 0i64);
        }
        self.ptot = self.rows.len() / self.ncols;
    }

    // ── SLICE-6: mark-based DELETE-REDERIVE retraction (ADR §4.2). `den` =
    // nodes of the edges just removed; `presn` = the surviving present edge
    // set (post-batch, includes any NE). Three phases:
    //   (1) OVER-DELETE — into scratch od_rows/od_rhm: seed = base⋈DE ∪
    //       (existing-rel[0,ptot)⋈DE via the recursive rule), then propagate
    //       od-delta ⋈ PRES to a fixpoint. OD ⊇ every path fact with any
    //       derivation using a deleted edge (last-deleted-edge argument).
    //   (2) COMPACT — rebuild self.rows/self.rhm = old ∖ OD (append-only shadow
    //       keys absolute indices, so in-place delete is impossible — one
    //       O(rel) rebuild). Survivors S ⊆ closure(PRES).
    //   (3) RE-DERIVE — warm-started semi-naïve over PRES into the compacted
    //       rel: base⋈PRES + fixpoint from delta S; re-adds any over-deleted
    //       fact (and NE-derived fact) with an alternative all-survivor
    //       derivation. Final = closure(PRES) exactly (== the batch oracle).
    // Both fixpoints are monotone with per-round DISTINCT via the shadow set —
    // quiescence-only exit, NO cap (termination parity with insert).
    fn dred(self: &mut IncrRec, q: &Query, de_slots: &Vec<i64>) {
        let ncols: i64 = self.ncols;
        let ptot0: i64 = self.ptot;
        let rec_body: i64 = self.rec_body;
        let rec_ovr: i64 = self.rec_ovr;
        let nb: i64 = self.nbase;

        // DE node list (edges just removed) and PRES (surviving present set,
        // includes any NE). Owned Vecs — the enode/ewt borrows end here.
        let mut den: Vec<WAny> = vec_new::<WAny>();
        let mut dj: i64 = 0i64;
        while dj < de_slots.len() {
            den.push(self.enode.get(de_slots.get(dj)));
            dj = dj + 1i64;
        }
        let presn: Vec<WAny> = ir_full_nodes(&self.enode, &self.ewt);

        // qp against the FULL/surviving edge set (plan words are array-indep).
        ir_bind_edges(&mut self.edoc, &mut self.env, self.edge_src, &presn);
        let mut chk: Chk = chk_new();
        let mut qp: QPlan = qplan_new();
        ir_check(q, &self.env, &mut qp, &mut chk);
        if chk.failed { return; }
        let scratch: Writ = writ_new(2048i64);
        let cp: *mut Chk = &mut chk;

        // scratch over-delete storage (epoch-local).
        let mut od_rows: Vec<RtVal> = vec_new::<RtVal>();
        let mut od_rhm: HashMap<u64, Vec<i64>> = hashmap_new::<u64, Vec<i64>>();
        let od_rows_i: i64 = (&mut od_rows as *mut Vec<RtVal>) as i64;
        let od_rhm_i:  i64 = (&mut od_rhm as *mut HashMap<u64, Vec<i64>>) as i64;
        let self_rows_i: i64 = (&mut self.rows as *mut Vec<RtVal>) as i64;
        let self_rhm_i:  i64 = (&mut self.rhm as *mut HashMap<u64, Vec<i64>>) as i64;

        // ── PHASE 1a: OD SEED — READ the real relation, WRITE-REDIRECT to od ──
        ir_bind_edges(&mut self.edoc, &mut self.env, self.edge_src, &den);
        let mut sctx: RelCtx = relctx_new();
        sctx.n = q.reg.n;
        sctx.regp = (&q.reg as *const QRelReg) as i64;
        sctx.hmp = self_rhm_i;
        sctx.rowsp[0] = self_rows_i;
        sctx.tot[0] = ptot0;
        let sctxp: *mut RelCtx = &mut sctx;
        rctx_set_wr(sctxp, 0i64, od_rows_i, od_rhm_i);
        // base bodies ⋈ DE (direct deleted edges).
        let mut bi: i64 = 0i64;
        while bi < nb && !chk_bad(cp) {
            qrel_run_body(q, self.base_b[bi], &self.env, &qp, &scratch, sctxp, cp);
            bi = bi + 1i64;
        }
        // recursive rule: existing rel [0,ptot) ⋈ DE (last-step extensions of a
        // deleted edge — the term that prevents under-deletion of mid/last facts).
        if ptot0 > 0i64 && !chk_bad(cp) {
            rctx_set_ovr(sctxp, rec_ovr);
            rctx_set_delta(sctxp, 0i64, 0i64, ptot0);
            qrel_run_body(q, rec_body, &self.env, &qp, &scratch, sctxp, cp);
            rctx_set_ovr(sctxp, 0i64);
        }
        rctx_set_wr(sctxp, 0i64, 0i64, 0i64);   // clear redirect

        // ── PHASE 1b: OD PROPAGATE — od-delta ⋈ PRES to fixpoint (read==write
        // ==od; propagating along survivor edges is conservative-safe). ──
        ir_bind_edges(&mut self.edoc, &mut self.env, self.edge_src, &presn);
        let mut pctx: RelCtx = relctx_new();
        pctx.n = q.reg.n;
        pctx.regp = (&q.reg as *const QRelReg) as i64;
        pctx.hmp = od_rhm_i;
        pctx.rowsp[0] = od_rows_i;
        pctx.tot[0] = 0i64;
        let pctxp: *mut RelCtx = &mut pctx;
        loop {
            if chk_bad(cp) { break; }
            let len: i64 = qrel_len(pctxp as *const RelCtx, 0i64, ncols);
            rctx_promote(pctxp, 0i64, len);
            if pctx.dlo[0] >= len { break; }   // OD fixpoint (empty round-delta)
            rctx_set_ovr(pctxp, rec_ovr);
            qrel_run_body(q, rec_body, &self.env, &qp, &scratch, pctxp, cp);
            rctx_set_ovr(pctxp, 0i64);
        }
        if chk_bad(cp) { return; }

        // ── PHASE 2: COMPACT — self.rows/self.rhm ← old[0,ptot) ∖ OD ──
        let mut new_rows: Vec<RtVal> = vec_new::<RtVal>();
        let mut new_rhm: HashMap<u64, Vec<i64>> = hashmap_new::<u64, Vec<i64>>();
        let new_rhm_p: *mut HashMap<u64, Vec<i64>> = &mut new_rhm;
        let mut r: i64 = 0i64;
        while r < ptot0 {
            if !dred_in_od(&od_rows, od_rhm_i, ncols, &self.rows, r) {
                let ni: i64 = new_rows.len() / ncols;
                let mut h: u64 = 14695981039346656037u64;
                h = h_step(h, 0u64);   // ri = 0
                let mut c: i64 = 0i64;
                while c < ncols {
                    h = h_step(h, rt_key_hash(self.rows.get(r * ncols + c)));
                    c = c + 1i64;
                }
                unsafe {
                    let vp: *mut Vec<i64> = new_rhm_p.get_or_insert(h, vec_new::<i64>());
                    (&mut *vp).push((ni << 3) | 0i64);
                }
                let mut c2: i64 = 0i64;
                while c2 < ncols {
                    new_rows.push(self.rows.get(r * ncols + c2));
                    c2 = c2 + 1i64;
                }
            }
            r = r + 1i64;
        }
        self.rows = new_rows;
        self.rhm = new_rhm;
        self.ptot = self.rows.len() / ncols;

        // ── PHASE 3: RE-DERIVE — warm-started semi-naïve over PRES into the
        // compacted rel. tot=0 so the FIRST promote takes S ∪ new-base as the
        // initial delta; dedup against self.rhm (populated with S) re-adds only
        // facts with an alternative survivor derivation. ──
        let rd_rows_i: i64 = (&mut self.rows as *mut Vec<RtVal>) as i64;
        let rd_rhm_i:  i64 = (&mut self.rhm as *mut HashMap<u64, Vec<i64>>) as i64;
        let mut rctx: RelCtx = relctx_new();
        rctx.n = q.reg.n;
        rctx.regp = (&q.reg as *const QRelReg) as i64;
        rctx.hmp = rd_rhm_i;
        rctx.rowsp[0] = rd_rows_i;
        rctx.tot[0] = 0i64;
        let rctxp: *mut RelCtx = &mut rctx;
        let mut bi2: i64 = 0i64;
        while bi2 < nb && !chk_bad(cp) {
            qrel_run_body(q, self.base_b[bi2], &self.env, &qp, &scratch, rctxp, cp);
            bi2 = bi2 + 1i64;
        }
        loop {
            if chk_bad(cp) { break; }
            let len: i64 = qrel_len(rctxp as *const RelCtx, 0i64, ncols);
            rctx_promote(rctxp, 0i64, len);
            if rctx.dlo[0] >= len { break; }   // re-derive fixpoint
            rctx_set_ovr(rctxp, rec_ovr);
            qrel_run_body(q, rec_body, &self.env, &qp, &scratch, rctxp, cp);
            rctx_set_ovr(rctxp, 0i64);
        }
        self.ptot = self.rows.len() / ncols;
    }

    // Read the maintained closure as a self-contained QRows via the ENTRY
    // projection over the persistent relation (exact oracle parity).
    pub fn snapshot(self: &IncrRec) -> QRows {
        let qp_raw: i64 = self.qptr;
        let q: &Query = unsafe { &*(qp_raw as *const Query) };
        let root: RExpr = WAny::ref_to(q.root as *const u8).view::<RExpr>();
        let mut chk: Chk = chk_new();
        let mut qp: QPlan = qplan_new();
        let mut lb: CBinds = cbinds_new();
        check_rexpr(root, &q.cat, &self.env, true, &mut lb, &mut chk, &mut qp, &q.reg);
        let mut rows: QRows = QRows {
            arena: writ_new(1024i64),
            ncols: qp.ncols,
            kinds: qp.ckind,
            cells: vec_new::<RtVal>(),
            nrows: 0i64,
        };
        if chk.failed { return rows; }
        let scratch: Writ = writ_new(2048i64);
        let rows_i: i64 = (&self.rows as *const Vec<RtVal>) as i64;
        let hmp_i:  i64 = (&self.rhm  as *const HashMap<u64, Vec<i64>>) as i64;
        let mut ctx: RelCtx = relctx_new();
        ctx.n = q.reg.n;
        ctx.regp = (&q.reg as *const QRelReg) as i64;
        ctx.hmp = hmp_i;
        ctx.rowsp[0] = rows_i;
        ctx.tot[0] = self.ptot;
        let cp: *mut Chk = &mut chk;
        let out: OutTab = exec_root(root, &q.cat, &self.env, &qp, &scratch, cp,
                                    &ctx as *const RelCtx);
        if chk_bad(cp) { return rows; }
        let mut nkeep: i64 = out.nrows;
        if (q.sel_mode == QM_FIRST || q.sel_mode == QM_FIND) && nkeep > 1i64 { nkeep = 1i64; }
        let mut r: i64 = 0i64;
        while r < nkeep {
            let mut c: i64 = 0i64;
            while c < out.ncols {
                let v: RtVal = out.cells.get(r * out.ncols + c);
                match v {
                    RtVal::S(s) => { rows.cells.push(RtVal::S(intern_str(&rows.arena, s))); }
                    _ => { rows.cells.push(v); }
                }
                c = c + 1i64;
            }
            r = r + 1i64;
        }
        rows.nrows = nkeep;
        return rows;
    }
}

impl Query {
    // Build an incremental maintainer for a single LINEAR self-recursive rel
    // (slice-5, transitive-closure shape). The fragment guard ACCEPTS iff:
    //   • exactly one rel (reg.n == 1) and it is recursive (its SCC);
    //   • all rel columns are i64;
    //   • exactly ONE recursive body with occ_n == 1 (LINEAR — one in-rel
    //     occurrence) plus ≥1 base body (occ_n == 0);
    // and REJECTS mutual-recursion SCCs, non-linear (occ_n > 1) doubling rules,
    // recursive aggregates, and non-i64 columns with precise messages. `env`
    // must bind the edge source (non-empty) and outlive the engine.
    pub fn incremental_rec(self: &Query, env: &QEnv) -> Result<IncrRec, QError> {
        if self.empty {
            return Result::Err(qerr("Query::incremental_rec: empty query plan — nothing to maintain"));
        }
        if self.reg.n == 0i64 {
            return Result::Err(qerr("Query::incremental_rec: query has no `rel` block — use Query::incremental for the join/anti/aggregate fragment"));
        }
        if self.reg.n != 1i64 {
            return Result::Err(qerr("Query::incremental_rec: multiple rels (mutual-recursion SCC) — out of slice-5 (single linear-recursive rel only)"));
        }
        let c: i64 = self.reg.comp[0];
        if !self.reg.rec[c] {
            return Result::Err(qerr("Query::incremental_rec: the rel is not recursive — nothing to maintain incrementally (use Query::run)"));
        }
        // all columns i64
        let off: i64 = self.reg.coff[0];
        let ncols: i64 = self.reg.ncols[0];
        let mut ci: i64 = 0i64;
        while ci < ncols {
            if self.reg.ctys.get(off + ci) != (CT_INT as i64) {
                return Result::Err(qerr("Query::incremental_rec: a rel column is not i64 — out of slice-5 (i64 columns only)"));
            }
            ci = ci + 1i64;
        }
        // classify bodies: base (occ_n==0) vs the single linear recursive body
        let mut nbase: i64 = 0i64;
        let mut base_b: [i64; 8] = [0i64; 8];
        let mut nrec: i64 = 0i64;
        let mut rec_body: i64 = -1i64;
        let mut b: i64 = 0i64;
        while b < self.bodies.n {
            if self.bodies.owner.get(b) == 0i64 && self.bodies.empty.get(b) == 0i64 {
                let on: i64 = self.bodies.occ_n.get(b);
                if on == 0i64 {
                    if nbase < 8i64 { base_b[nbase] = b; nbase = nbase + 1i64; }
                } else if on == 1i64 {
                    nrec = nrec + 1i64;
                    rec_body = b;
                } else {
                    return Result::Err(qerr("Query::incremental_rec: a recursive body has >1 in-rel occurrence (non-linear / doubling recursion) — out of slice-5 (linear only)"));
                }
            }
            b = b + 1i64;
        }
        if nrec != 1i64 {
            return Result::Err(qerr("Query::incremental_rec: slice-5 needs exactly one linear recursive body (self-recursion)"));
        }
        if nbase < 1i64 {
            return Result::Err(qerr("Query::incremental_rec: the recursive rel has no base body"));
        }
        let rec_off: i64 = self.bodies.occ_off.get(rec_body);
        let rec_ovr: i64 = self.bodies.ow.get(rec_off);
        // edge source = the base body's scanned source
        let base_root: RExpr = WAny::ref_to(self.bodies.root.get(base_b[0]) as *const u8).view::<RExpr>();
        let edge_src: str = ir_scan_src(base_root);
        if edge_src.len() == 0i64 {
            return Result::Err(qerr("Query::incremental_rec: could not resolve the base edge source (base body is not a scan pipeline)"));
        }
        let ei: i64 = env.find(edge_src);
        if ei < 0i64 {
            return Result::Err(qerr("Query::incremental_rec: the edge source is not bound on the env"));
        }
        let srcv: WAny = WAny::ref_to(env.words[ei] as *const u8);
        if !srcv.is_array() {
            return Result::Err(qerr("Query::incremental_rec: the edge source is not a Writ array"));
        }
        let sarr: &WArray<WAny> = srcv.as_array();
        if sarr.len() == 0i64 {
            return Result::Err(qerr("Query::incremental_rec: the edge source is empty — bind a non-empty base relation"));
        }

        let mut eng: IncrRec = IncrRec {
            qptr: (self as *const Query) as i64,
            env: QEnv::new(),
            edoc: writ_new(65536i64),
            enode: vec_new::<WAny>(),
            ewt: vec_new::<i64>(),
            eid: hashmap_new::<u64, i64>(),
            rows: vec_new::<RtVal>(),
            rhm: hashmap_new::<u64, Vec<i64>>(),
            ptot: 0i64,
            edge_src: edge_src,
            ncols: ncols,
            rec_body: rec_body,
            rec_ovr: rec_ovr,
            nbase: nbase,
            base_b: base_b,
        };
        // seed the edge multiset from the bound base relation (+1/identity)
        let sn: i64 = sarr.len();
        let mut si: i64 = 0i64;
        while si < sn {
            let node: WAny = sarr.get(si);
            let rawu: u64 = node.raw() as u64;
            let idp: *mut HashMap<u64, i64> = &mut eng.eid;
            let sp: *const i64 = unsafe { idp.get(&rawu) };
            if (sp as i64) != 0i64 {
                let slot: i64 = unsafe { *sp };
                eng.ewt.set(slot, eng.ewt.get(slot) + 1i64);
            } else {
                let slot: i64 = eng.enode.len();
                eng.enode.push(node);
                eng.ewt.push(1i64);
                unsafe { let _z: *mut i64 = idp.get_or_insert(rawu, slot); }
            }
            si = si + 1i64;
        }
        eng.recompute();
        return Result::Ok(eng);
    }
}
