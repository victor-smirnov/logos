// logos.std.deem.data.handle — Snap + ContainerRef on top of nodes.
//
// User-facing surface for the persistent stack:
//
//   Store<STORE_CFG>           Arc<LockingStore<STORE_CFG>>; persistent
//                              over snap_begin / snap_fork / commit.
//   Snap<STORE_CFG>            Live writable snapshot. Holds dir-tree
//                              root NodeARC + ref to its Store.
//   ContainerRef<STORE_CFG, CFG>   Handle to one container in a snap.
//                              Holds NodeARC over the container root.
//
// Auto-Drop chain:
//   • ContainerRef.drop  — writes the cached root back to dir, releases
//                          open-claim. NodeARC's drop-chain handles rc.
//   • Snap.drop          — single NodeARC.drop on dir root → recursive
//                          release through Vec<NodeARC> chain → all
//                          container roots released too. Unless commit
//                          consumed the dir root first (DAG owns it).
//
// v1 limits: single-leaf-only inserts (no branch descent / leaf split
// yet); dir leaf is LeafDirNode<u64, ...>. Multi-level + on-disk land
// in mutate when the BTree algos port over.

package logos.std.deem.data.handle;

use logos.mem.collections.vec;
use logos.lang.mem;
use logos.mem.sync;
use logos.lang.rc;
use logos.lang.cmp;
use logos.lang.option;
use logos.lang.result;
use logos.lang.panic;
use logos.lang.drop;
use logos.lang.fabric;
use logos.lang.writ.wstatic;

use logos.std.deem.data.bt.node;
use logos.std.deem.data.bt.cow;
use logos.std.deem.data.store;
use logos.std.deem.data.bt.descent;
use logos.std.deem.data.bt.mutate;
use logos.std.deem.data.bt.iter;

/// Specifies the directory-tree node layout: key = `u64` ctr id, val = `NodeARC`, fanout 16.
// DirCfg — directory layout. Key = ctr_id (u64), val = NodeARC (heterogeneous
// container roots). fanout drives branch + leaf max-keys. Multi-level: dir
// can grow into a tree when a leaf overflows.
pub const DirCfg: WritStatic = @{ "key": <type:u64>, "fanout": 16 };

// ── Dir multi-level mutate (parallel to mutate.logos but for LeafDirNode) ──
// LeafDirNode holds NodeARC vals (heterogeneous container roots) — it
// can't share the data-leaf code path because map's V: Container bound
// excludes NodeARC. These helpers mirror split_leaf + insert_rec +
// bt_insert for the dir-flavoured layout.

/// Reports the result of a recursive dir-tree insert; on split, carries the new right subtree.
// DirInsertOutcome — paired with InsertOutcome's max-key model. On split,
// `right_max` carries the max ctr_id in the new right subtree; the parent
// inserts (right_max, right_arc) at i+1 and updates parent.keys[i] = the
// new max of its left child.
pub struct DirInsertOutcome<const STORE_CFG: WritStatic> {
    /// Indicates the node split; `right`/`right_max` are then populated.
    pub split:              bool,
    /// Holds the new right subtree; `Some` iff `split`.
    pub right:              Option<NodeARC<STORE_CFG>>,   // Some iff split
    /// Mirrors `split`; set when `right_max` is meaningful.
    pub right_max_present:  bool,
    /// Carries the max ctr id in the new right subtree; valid only on split.
    pub right_max:          u64,
}

// Read max ctr_id in a dir subtree (= keys.last for both leaf and branch
// under the max-key invariant).
unsafe fn dir_node_max_key<const STORE_CFG: WritStatic>(arc: &NodeARC<STORE_CFG>) -> u64 {
    let dp: *mut u8 = node_arc_data_ptr::<STORE_CFG>(arc);
    if arc_is_leaf::<STORE_CFG>(arc) {
        let leaf: *mut LeafDirNode<u64, STORE_CFG, DirCfg> = dp as *mut LeafDirNode<u64, STORE_CFG, DirCfg>;
        return leaf.keys.get(leaf.keys.len() - 1u64);
    }
    let br: *mut BranchNode<u64, STORE_CFG, DirCfg> = dp as *mut BranchNode<u64, STORE_CFG, DirCfg>;
    return br.keys.get(br.keys.len() - 1u64);
}

unsafe fn dir_split_leaf<const STORE_CFG: WritStatic>(
    leaf: *mut LeafDirNode<u64, STORE_CFG, DirCfg>,
    new_id: BlockId<STORE_CFG>, snapshot_id: SnpId<STORE_CFG>,
) -> NodeARC<STORE_CFG> {
    let cap: u64 = leaf.keys.len();
    let mid: u64 = cap / 2u64;
    let rh: NodeARC<STORE_CFG> =
        leaf_dir_alloc::<u64, STORE_CFG, DirCfg>(new_id, snapshot_id);
    let right: *mut LeafDirNode<u64, STORE_CFG, DirCfg> =
        node_arc_data_ptr::<STORE_CFG>(&rh) as *mut LeafDirNode<u64, STORE_CFG, DirCfg>;
    // Move keys[mid..] and vals[mid..] into right. Keys are u64 (Buffer),
    // vals are NodeARC (Vec) — clone bumps the child's rc; the upcoming pop on
    // `left` auto-drops its handle → balanced.
    let mut i: u64 = mid;
    while i < cap {
        right.keys.push(leaf.keys.get(i));
        let src: *mut NodeARC<STORE_CFG> = leaf.vals.at(i as i64);
        right.vals.push((*src).clone());
        i = i + 1u64;
    }
    while leaf.keys.len() > mid { leaf.keys.erase(leaf.keys.len() - 1u64); }
    while leaf.vals.len() > (mid as i64) { let _ = leaf.vals.pop(); }
    return rh;
}

// Linear search for ctr_id in a dir leaf; returns insertion position
// (lower_bound). Branches reuse mutate's branch_descend_idx (key=u64).
unsafe fn dir_leaf_lower_bound<const STORE_CFG: WritStatic>(
    leaf: *mut LeafDirNode<u64, STORE_CFG, DirCfg>, ctr_id: u64,
) -> u64 {
    let n: u64 = leaf.keys.len();
    let mut i: u64 = 0u64;
    while i < n {
        if leaf.keys.get(i) >= ctr_id { return i; }
        i = i + 1u64;
    }
    return n;
}

// Memoria-style: smallest i where keys[i] >= ctr_id (subtree containing
// the id). Returns n if id > all maxes (callers handle: read=missing,
// insert=saturate to n-1).
unsafe fn dir_branch_descend_idx<const STORE_CFG: WritStatic>(
    br: *mut BranchNode<u64, STORE_CFG, DirCfg>, ctr_id: u64,
) -> u64 {
    let n: u64 = br.keys.len();
    let mut i: u64 = 0u64;
    while i < n {
        if br.keys.get(i) >= ctr_id { return i; }
        i = i + 1u64;
    }
    return n;
}

// Recursive insert under the max-key invariant. `arc` is the dir subtree
// root (CoW'd by caller). `val_arc` ownership: caller transfers; on
// replace-on-hit the val_arc rc share moves into the slot, old released.
// On split, returns right subtree + its max ctr_id; parent inserts
// (right_max, right_arc) at i+1 and updates parent.keys[i] = new max
// of left child.
unsafe fn dir_insert_rec<const STORE_CFG: WritStatic>(
    arc: &mut NodeARC<STORE_CFG>,
    ctr_id: u64, val_arc: NodeARC<STORE_CFG>,
    cur_snapshot_id: SnpId<STORE_CFG>, id_ctr_p: *mut BlockId<STORE_CFG>,
) -> DirInsertOutcome<STORE_CFG> {
    make_unique::<STORE_CFG>(arc, cur_snapshot_id, id_ctr_p);
    let dp: *mut u8 = node_arc_data_ptr::<STORE_CFG>(arc);
    let max_keys: u64 = max_keys_leaf::<DirCfg>();

    if arc_is_leaf::<STORE_CFG>(arc) {
        let leaf: *mut LeafDirNode<u64, STORE_CFG, DirCfg> =
            dp as *mut LeafDirNode<u64, STORE_CFG, DirCfg>;
        let pos: u64 = dir_leaf_lower_bound::<STORE_CFG>(leaf, ctr_id);
        // Replace-on-hit: release the old slot's rc, write new handle.
        if pos < leaf.keys.len() && leaf.keys.get(pos) == ctr_id {
            let slot: *mut NodeARC<STORE_CFG> = leaf.vals.at(pos as i64);
            // Move val_arc's share into the slot, release the old (rc via Drop).
            arc_replace_in_slot::<STORE_CFG>(slot, val_arc);
            return DirInsertOutcome::<STORE_CFG> {
                split: false,
                right: Option::None,
                right_max_present: false, right_max: 0u64,
            };
        }
        // Insert at pos — move val_arc's share into the new slot (no rc bump:
        // ownership transfers from the by-value param into the Vec).
        leaf.keys.insert(pos, ctr_id);
        leaf.vals.push(val_arc);
        let mut k: i64 = leaf.vals.len() - 1i64;
        while k > (pos as i64) {
            let a: *mut NodeARC<STORE_CFG> = leaf.vals.at(k);
            let b: *mut NodeARC<STORE_CFG> = leaf.vals.at(k - 1i64);
            swap::<NodeARC<STORE_CFG>>(a, b);
            k = k - 1i64;
        }
        if leaf.keys.len() > max_keys {
            let new_id: BlockId<STORE_CFG> = alloc_id_dir::<STORE_CFG>(id_ctr_p);
            let right: NodeARC<STORE_CFG> = dir_split_leaf::<STORE_CFG>(leaf, new_id, cur_snapshot_id);
            let rl: *mut LeafDirNode<u64, STORE_CFG, DirCfg> =
                node_arc_data_ptr::<STORE_CFG>(&right) as *mut LeafDirNode<u64, STORE_CFG, DirCfg>;
            let rmax: u64 = rl.keys.get(rl.keys.len() - 1u64);
            return DirInsertOutcome::<STORE_CFG> {
                split: true, right: Option::Some(right),
                right_max_present: true, right_max: rmax,
            };
        }
        return DirInsertOutcome::<STORE_CFG> {
            split: false,
            right: Option::None,
            right_max_present: false, right_max: 0u64,
        };
    }
    // Branch.
    let br: *mut BranchNode<u64, STORE_CFG, DirCfg> =
        dp as *mut BranchNode<u64, STORE_CFG, DirCfg>;
    let max_branch: u64 = max_keys_branch::<DirCfg>();
    let n: u64 = br.keys.len();
    let mut i: u64 = dir_branch_descend_idx::<STORE_CFG>(br, ctr_id);
    if i >= n { i = n - 1u64; }
    let child_ref: &mut NodeARC<STORE_CFG> = br.children.borrow_mut(i as i64);
    let mut inner = dir_insert_rec::<STORE_CFG>(child_ref, ctr_id, val_arc, cur_snapshot_id, id_ctr_p);
    // Update parent.keys[i] = new max of child (may have grown).
    let child_after: &NodeARC<STORE_CFG> = br.children.borrow(i as i64);
    let new_left_max: u64 = dir_node_max_key::<STORE_CFG>(child_after);
    br.keys.set(i, new_left_max);

    if !inner.split {
        return DirInsertOutcome::<STORE_CFG> {
            split: false,
            right: Option::None,
            right_max_present: false, right_max: 0u64,
        };
    }
    // Inner split: insert (right_max, right_arc) at i+1. Move the child's right
    // handle out of the Option (split ⇒ Some).
    let right_node: NodeARC<STORE_CFG> = inner.right.take().unwrap();
    br.keys.insert(i + 1u64, inner.right_max);
    vec_arc_insert_at::<STORE_CFG>(&mut br.children as *mut Vec<NodeARC<STORE_CFG>>, (i as i64) + 1i64, right_node);
    if br.keys.len() > max_branch {
        let new_id: BlockId<STORE_CFG> = alloc_id_dir::<STORE_CFG>(id_ctr_p);
        let right: NodeARC<STORE_CFG> = split_branch::<u64, STORE_CFG, DirCfg>(br, new_id, cur_snapshot_id);
        let rb: *mut BranchNode<u64, STORE_CFG, DirCfg> =
            node_arc_data_ptr::<STORE_CFG>(&right) as *mut BranchNode<u64, STORE_CFG, DirCfg>;
        let rmax: u64 = rb.keys.get(rb.keys.len() - 1u64);
        return DirInsertOutcome::<STORE_CFG> {
            split: true, right: right,
            right_max_present: true, right_max: rmax,
        };
    }
    return DirInsertOutcome::<STORE_CFG> {
        split: false,
        right: Option::None,
        right_max_present: false, right_max: 0u64,
    };
}

unsafe fn alloc_id_dir<const STORE_CFG: WritStatic>(p: *mut BlockId<STORE_CFG>) -> BlockId<STORE_CFG> {
    *p = *p + 1u64;
    return *p;
}

/// Inserts `ctr_id` → `val_arc` into the dir tree, growing a new root on split.
/// Takes ownership of `val_arc`; an existing `ctr_id` has its value replaced.
// Top-level dir insert: descend, possibly grow root with [old_max, right_max] keys.
pub unsafe fn dir_insert<const STORE_CFG: WritStatic>(
    snap_dir: &mut NodeARC<STORE_CFG>,
    ctr_id: u64, val_arc: NodeARC<STORE_CFG>,
    cur_snapshot_id: SnpId<STORE_CFG>, id_ctr_p: *mut BlockId<STORE_CFG>,
) {
    let mut outcome = dir_insert_rec::<STORE_CFG>(snap_dir, ctr_id, val_arc, cur_snapshot_id, id_ctr_p);
    if outcome.split {
        let right_node: NodeARC<STORE_CFG> = outcome.right.take().unwrap();
        let new_id: BlockId<STORE_CFG> = alloc_id_dir::<STORE_CFG>(id_ctr_p);
        let new_arc: NodeARC<STORE_CFG> =
            branch_alloc::<u64, STORE_CFG, DirCfg>(new_id, cur_snapshot_id);
        let new_root: *mut BranchNode<u64, STORE_CFG, DirCfg> =
            node_arc_data_ptr::<STORE_CFG>(&new_arc) as *mut BranchNode<u64, STORE_CFG, DirCfg>;
        // Read old_root's max BEFORE we transfer its handle.
        let old_max: u64 = dir_node_max_key::<STORE_CFG>(snap_dir);
        new_root.keys.push(old_max);
        new_root.keys.push(outcome.right_max);
        // children[0] = old root (clone — the slot's original share is released
        // by arc_replace_in_slot below), children[1] = outcome.right (moved in).
        new_root.children.push(snap_dir.clone());
        new_root.children.push(right_node);
        arc_replace_in_slot::<STORE_CFG>(snap_dir as *mut NodeARC<STORE_CFG>, new_arc);
    }
}

/// Finds `ctr_id` in the dir tree; returns its `NodeARC` slot pointer, or null when absent.
pub unsafe fn dir_lookup<const STORE_CFG: WritStatic>(
    snap_dir: &NodeARC<STORE_CFG>, ctr_id: u64,
) -> *mut NodeARC<STORE_CFG> {
    let dp: *mut u8 = node_arc_data_ptr::<STORE_CFG>(snap_dir);
    if arc_is_leaf::<STORE_CFG>(snap_dir) {
        let leaf: *mut LeafDirNode<u64, STORE_CFG, DirCfg> =
            dp as *mut LeafDirNode<u64, STORE_CFG, DirCfg>;
        let n: u64 = leaf.keys.len();
        let mut i: u64 = 0u64;
        while i < n {
            if leaf.keys.get(i) == ctr_id {
                return leaf.vals.at(i as i64);
            }
            i = i + 1u64;
        }
        return 0 as *mut NodeARC<STORE_CFG>;
    }
    let br: *mut BranchNode<u64, STORE_CFG, DirCfg> =
        dp as *mut BranchNode<u64, STORE_CFG, DirCfg>;
    let i: u64 = dir_branch_descend_idx::<STORE_CFG>(br, ctr_id);
    if i >= br.children.len() as u64 {
        return 0 as *mut NodeARC<STORE_CFG>;     // ctr_id > all maxes
    }
    let child: &NodeARC<STORE_CFG> = br.children.borrow(i as i64);
    return dir_lookup::<STORE_CFG>(child, ctr_id);
}

// ── Store<STORE_CFG> ─────────────────────────────────────────────────
unsafe impl<const STORE_CFG: WritStatic> Send for LockingStore<STORE_CFG> {}
unsafe impl<const STORE_CFG: WritStatic> Sync for LockingStore<STORE_CFG> {}

/// Wraps a shared `Arc<LockingStore>` — the user-facing handle to a persistent store.
pub struct Store<const STORE_CFG: WritStatic> {
    /// Shares the backing `LockingStore`; cloned into every forked `Snap`.
    pub arc: Arc<LockingStore<STORE_CFG>>,
}

// store_open — initialise the store with an empty genesis commit at id 0.
// All snapshots are forks off some commit (`store.fork(parent)`); use
// `store.fork(GENESIS)` for fresh work.
//
// Multiple independent root histories should each live in their own
// Store — keeping a single store linear simplifies merge / GC /
// on-disk serialisation when those land.
/// Identifies the empty genesis commit (id 0) seeded by `store_open`; fork it for fresh work.
pub const GENESIS: u64 = 0u64;

/// Creates a store seeded with an empty genesis commit at id `GENESIS`.
pub fn store_open<const STORE_CFG: WritStatic>() -> Store<STORE_CFG> {
    let s: LockingStore<STORE_CFG> = locking_store_new::<STORE_CFG>();
    let arc: Arc<LockingStore<STORE_CFG>> = arc_new::<LockingStore<STORE_CFG>>(s);
    // Seed an empty genesis dir as commit 0. snapshot_id stamp = 0
    // (no live snap yet); any fork's first write triggers make_unique
    // CoW on the genesis dir, leaving it untouched. register_commit
    // refuses parent-less entries (no -1 sentinel under typed snp_id),
    // so the genesis row is pushed directly to dag with empty parents.
    {
        let lk: &mut LockingStore<STORE_CFG> = arc.deref_mut();
        let block_id: BlockId<STORE_CFG> = unsafe { (lk as *mut LockingStore<STORE_CFG>).alloc_block_id() };
        let dir: NodeARC<STORE_CFG> = unsafe {
            leaf_dir_alloc::<u64, STORE_CFG, DirCfg>(block_id, 0u64)
        };
        lk.dag.push(CommitEntry::<STORE_CFG> {
            root:     dir.clone(),
            parents:  vec_new::<SnpId<STORE_CFG>>(),
            children: vec_new::<SnpId<STORE_CFG>>(),
            released: false,
        });
    }
    return Store::<STORE_CFG> { arc: arc };
}

impl<const STORE_CFG: WritStatic> Store<STORE_CFG> {
    /// Forks a mutable snapshot off `parent_commit`; shares its dir, CoWs on first write.
    // Fork a mutable snapshot off `parent_commit`. The fork sees that
    // commit's directory tree (shared via rc) and CoWs on first write.
    // Pass `GENESIS` for the empty initial dir (id 0, seeded by store_open).
    pub fn fork(&mut self, parent_commit: SnpId<STORE_CFG>) -> Snap<STORE_CFG> {
        return snap_fork::<STORE_CFG>(self, parent_commit);
    }

    // ── DAG introspection (delegates to LockingStore via *mut self) ──
    /// Returns the total number of commits ever registered, including released tombstones.
    pub fn commit_count(&mut self) -> i64 {
        let s: &mut LockingStore<STORE_CFG> = self.arc.deref_mut();
        return unsafe { (s as *mut LockingStore<STORE_CFG>).commit_count() };
    }
    /// Returns an owned copy of the parent commit ids of `id`.
    pub fn parents_of(&mut self, id: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>> {
        let s: &mut LockingStore<STORE_CFG> = self.arc.deref_mut();
        return unsafe { (s as *mut LockingStore<STORE_CFG>).parents_of(id) };
    }
    /// Returns an owned copy of the child commit ids of `id`.
    pub fn children_of(&mut self, id: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>> {
        let s: &mut LockingStore<STORE_CFG> = self.arc.deref_mut();
        return unsafe { (s as *mut LockingStore<STORE_CFG>).children_of(id) };
    }
    /// Returns the ids of live parentless commits (released tombstones excluded).
    pub fn roots(&mut self) -> Vec<SnpId<STORE_CFG>> {
        let s: &mut LockingStore<STORE_CFG> = self.arc.deref_mut();
        return unsafe { (s as *mut LockingStore<STORE_CFG>).roots() };
    }

    /// Releases commit `id`, reclaiming blocks unique to its tree.
    /// The DAG slot persists as a tombstone; fork/checkout on a released id is invalid.
    // Release a commit. Drops its root NodeARC; blocks unique to this
    // commit's tree are reclaimed via the auto-Drop chain. Blocks
    // shared with siblings/descendants stay live (their rc decrements
    // but doesn't reach 0). The dag slot persists as a tombstone so
    // commit_count and existing parent/child indices remain valid;
    // checkout / fork on a released id is a precondition violation.
    pub fn release(&mut self, id: SnpId<STORE_CFG>) {
        let s: &mut LockingStore<STORE_CFG> = self.arc.deref_mut();
        unsafe { (s as *mut LockingStore<STORE_CFG>).release_snapshot(id); }
    }

    /// Returns whether commit `id` has been released.
    pub fn is_released(&mut self, id: SnpId<STORE_CFG>) -> bool {
        let s: &mut LockingStore<STORE_CFG> = self.arc.deref_mut();
        return unsafe { (s as *mut LockingStore<STORE_CFG>).is_released(id) };
    }
}

// ── Snap<STORE_CFG> ──────────────────────────────────────────────────
/// Represents a live writable snapshot: the dir-tree root plus a shared ref to its store.
/// Dropping releases the whole dir chain; `commit` consumes the snap into the DAG instead.
pub struct Snap<const STORE_CFG: WritStatic> {
    /// Owns the snapshot's directory-tree root.
    pub dir: NodeARC<STORE_CFG>,    // directory tree root
    /// Shares the backing store.
    pub arc: Arc<LockingStore<STORE_CFG>>,
    /// Identifies this snapshot — the CoW key `make_unique` compares against.
    pub snapshot_id: SnpId<STORE_CFG>,
    /// Records the commit this snap forked from; becomes the new commit's parent.
    pub parent_id:   SnpId<STORE_CFG>,  // commit id this snap forked from
    /// Counts `ContainerRef`s open on this snap; `commit` panics while nonzero.
    // DYNAMIC commit guard: count of ContainerRefs currently open on this
    // snap. create_ctr/open_ctr bump it; ContainerRef::drop decrements via a
    // raw pointer to this field. commit() refuses (panics) while any container
    // is open — a committed snap's blocks become shared/immutable, and a still-
    // open ContainerRef holds raw pointers into the snap's dir that would
    // dangle once commit consumes it. We can't enforce this in the type system
    // without forbidding multiple simultaneously-open mutable containers (the
    // deliberate multi-container model), so the invariant is checked at runtime.
    pub open_containers: u64,
}

/// Starts a new mutable snapshot from committed `parent_commit` with a fresh snapshot id.
pub fn snap_fork<const STORE_CFG: WritStatic>(
    store: &mut Store<STORE_CFG>,
    parent_commit: SnpId<STORE_CFG>,
) -> Snap<STORE_CFG> {
    let s: &mut LockingStore<STORE_CFG> = store.arc.deref_mut();
    let snap_id: SnpId<STORE_CFG> = unsafe { (s as *mut LockingStore<STORE_CFG>).alloc_snapshot_id() };
    let dir: NodeARC<STORE_CFG> = unsafe { (s as *mut LockingStore<STORE_CFG>).checkout(parent_commit) };
    return Snap::<STORE_CFG> {
        dir:             dir,
        arc:             store.arc.clone_ref(),
        snapshot_id:     snap_id,
        parent_id:       parent_commit,
        open_containers: 0u64,
    };
}

impl<const STORE_CFG: WritStatic> Snap<STORE_CFG> {
    /// Commits the dir tree as a new DAG entry; returns the new commit id.
    /// Consumes the snap — committed blocks become shared/immutable.
    /// Panics while any `ContainerRef` is still open on this snap.
    // Commit the dir tree as a new DAG entry; returns the new commit id.
    //
    // CONSUMES the snapshot (takes `self` by value). A committed snap must
    // not be mutated afterward: commit shares the snap's blocks with the new
    // (immutable) DAG entry, but make_unique keys on snapshot_id — so a later
    // in-place write through the same snap, or through a ContainerRef opened
    // before commit, would land directly in the committed blocks and corrupt
    // them. By-value `self` makes that a compile error instead of silent
    // corruption (Rust idiom: commit freezes the snapshot).
    //
    // The dir root's share is TRANSFERRED to the new DAG entry with no rc math:
    // `take_arc` moves the handle out and nulls this snap's `dir` so its
    // scope-exit drop is a no-op, and register_commit takes the NodeARC by
    // value. Ownership moves cleanly — no clone+bump hack, no double-drop.
    pub fn commit(self: Self) -> SnpId<STORE_CFG> {
        let mut me: Snap<STORE_CFG> = self;
        // Dynamic guard: a snap with open ContainerRefs must not be committed —
        // commit consumes the snap and the open handles hold raw pointers into
        // its dir that would dangle. Close (drop) every container first.
        if me.open_containers > 0u64 {
            panic("Snap::commit called while container handles are still open");
        }
        let s: &mut LockingStore<STORE_CFG> = me.arc.deref_mut();
        unsafe {
            let root: NodeARC<STORE_CFG> =
                (&mut me.dir as *mut NodeARC<STORE_CFG>).take_arc();
            return (s as *mut LockingStore<STORE_CFG>).register_commit(root, me.parent_id);
        }
    }

    // ── reusable container infrastructure ───────────────────────────────────
    // The store/snapshot/directory layer is container-AGNOSTIC: a container is
    // just a root NodeARC (any BTreeNode) planted in this snap's `dir`. A
    // specialization (map below, or a future one) brings its OWN node types,
    // descent and handle API, and reuses these to live in the snapshot + commit
    // DAG. `attach`/`lookup` return a SnapCtx the specialization embeds.

    /// Returns a raw pointer to the store's next-block-id counter.
    pub fn id_ctr(&mut self) -> *mut BlockId<STORE_CFG> {
        let s: &mut LockingStore<STORE_CFG> = self.arc.deref_mut();
        return unsafe { &mut (*(s as *mut LockingStore<STORE_CFG>)).next_block_id as *mut BlockId<STORE_CFG> };
    }
    /// Bumps and returns the store's next block id.
    pub fn alloc_block(&mut self) -> BlockId<STORE_CFG> {
        let s: &mut LockingStore<STORE_CFG> = self.arc.deref_mut();
        return unsafe { (s as *mut LockingStore<STORE_CFG>).alloc_block_id() };
    }

    /// Builds the `SnapCtx` for `ctr_id` and claims an open-container slot (commit guard).
    // Build the snap-side context for ctr_id and CLAIM an open-container slot
    // (released in the handle's Drop). The shared tail of attach/lookup.
    pub fn make_ctx(&mut self, ctr_id: u64) -> SnapCtx<STORE_CFG> {
        let idp: *mut BlockId<STORE_CFG> = self.id_ctr();
        self.open_containers = self.open_containers + 1u64;
        return SnapCtx::<STORE_CFG> {
            dir_root_p: &mut self.dir as *mut NodeARC<STORE_CFG>,
            ctr_id:     ctr_id,
            snap_id:    self.snapshot_id,
            id_ctr_p:   idp,
            open_ctr_p: &mut self.open_containers as *mut u64,
        };
    }

    /// Plants `root` in the dir under `ctr_id` (ownership transfers) and returns the handle ctx.
    // Plant a freshly-built container root under ctr_id (CoW into the dir;
    // TRANSFERS root's share to the dir entry) and return the handle's context.
    pub fn attach(&mut self, ctr_id: u64, root: NodeARC<STORE_CFG>) -> SnapCtx<STORE_CFG> {
        let idp: *mut BlockId<STORE_CFG> = self.id_ctr();
        unsafe { dir_insert::<STORE_CFG>(&mut self.dir, ctr_id, root, self.snapshot_id, idp); }
        return self.make_ctx(ctr_id);
    }

    /// Resolves `ctr_id` to `Some((root_clone, ctx))`, claiming an open slot; `None` when absent.
    // Find an existing container root under ctr_id (CoW the dir up-front so a
    // later writeback lands in this snap's dir). Some((root_clone, ctx)) — the
    // root sharing the dir slot's rc, paired with the handle's context (which
    // claimed the open slot) — or None when ctr_id isn't present.
    pub fn lookup(&mut self, ctr_id: u64) -> Option<(NodeARC<STORE_CFG>, SnapCtx<STORE_CFG>)> {
        let idp: *mut BlockId<STORE_CFG> = self.id_ctr();
        unsafe { make_unique::<STORE_CFG>(&mut self.dir, self.snapshot_id, idp); }
        let slot_p: *mut NodeARC<STORE_CFG> = unsafe { dir_lookup::<STORE_CFG>(&self.dir, ctr_id) };
        if slot_p == 0 as *mut NodeARC<STORE_CFG> { return Option::None; }
        let root: NodeARC<STORE_CFG> = unsafe { (*slot_p).clone() };
        return Option::Some((root, self.make_ctx(ctr_id)));
    }
}

// ── SnapCtx — the snap-side wiring every container handle embeds ─────────────
// Independent of the container's node types / API: the directory slot, the
// snapshot id (CoW key), the block-id allocator, and the open-container guard.
// A specialization stores a SnapCtx + its own root/handle, and uses these
// methods for writeback / id allocation / release.
/// Carries the snap-side wiring a container handle embeds: dir slot, CoW key, ids, commit guard.
pub struct SnapCtx<const STORE_CFG: WritStatic> {
    /// Points at `Snap.dir`; stable for the snap's life.
    pub dir_root_p: *mut NodeARC<STORE_CFG>,   // &Snap.dir — stable for the snap's life
    /// Identifies this container within the dir.
    pub ctr_id:     u64,                        // this container's id within the dir
    /// Keys the CoW check in `make_unique`.
    pub snap_id:    SnpId<STORE_CFG>,           // CoW key (make_unique)
    /// Points at the store's `next_block_id`.
    pub id_ctr_p:   *mut BlockId<STORE_CFG>,    // &store.next_block_id
    /// Points at `Snap.open_containers` (the commit guard).
    pub open_ctr_p: *mut u64,                    // &Snap.open_containers (commit guard)
}

impl<const STORE_CFG: WritStatic> SnapCtx<STORE_CFG> {
    /// Bumps and returns the next block id (for the specialization's node allocs).
    pub fn next_block_id(&self) -> BlockId<STORE_CFG> {
        unsafe {
            let n: BlockId<STORE_CFG> = *self.id_ctr_p + 1u64;
            *self.id_ctr_p = n;
            return n;
        }
    }
    /// Syncs the dir's slot for `ctr_id` with `root`; no-op when absent or already identical.
    // Sync the dir's slot for ctr_id with `root` (re-resolved freshly each call —
    // survives dir realloc/split/root-grow; never a cached interior pointer).
    pub unsafe fn writeback(&self, root: &NodeARC<STORE_CFG>) {
        if self.dir_root_p == 0 as *mut NodeARC<STORE_CFG> { return; }
        let slot: *mut NodeARC<STORE_CFG> = dir_lookup::<STORE_CFG>(&*self.dir_root_p, self.ctr_id);
        if slot == 0 as *mut NodeARC<STORE_CFG> { return; }
        if node_arc_same::<STORE_CFG>(&*slot, root) { return; }
        arc_replace_in_slot::<STORE_CFG>(slot, root.clone());
    }
    /// Releases this container's open-claim (the commit guard).
    pub unsafe fn release(&self) {
        if self.open_ctr_p != 0 as *mut u64 { *self.open_ctr_p = *self.open_ctr_p - 1u64; }
    }
}

// ── ContainerRef<STORE_CFG, CFG> ─────────────────────────────────────
// The map container's handle — the FIRST specialization on the reusable infra above. It
// owns the container root rc (`arc`) and embeds a `SnapCtx` (the shared
// snap-side wiring: dir slot / CoW key / id allocator / commit guard). A new
// container brings its OWN handle (its own root type + method surface) and
// reuses SnapCtx the same way — the store/snapshot/directory layer is untouched.
//
// v1: ContainerRef holds a typed pointer cast to the concrete leaf
// type. Multi-level descent (where root may be a BranchNode) lands
// when mutate gains splits. Single-leaf bring-up first.

/// Describes why a checked insert (`try_insert`) rejected a key or value.
// Why a checked insert may fail: the offered key or value is inconsistent with
// the container's runtime-discovered element type (a DView container is
// homogeneous — one tag per buffer). Static-typed containers never produce this.
pub enum InsertError {
    /// Indicates the offered key's runtime type mismatches the container's key type.
    KeyType,
    /// Indicates the offered value's runtime type mismatches the container's value type.
    ValueType,
}

/// Handles one map container in a snap: owns the root rc and embeds the snap-side `SnapCtx`.
/// Dropping releases the snap's open-container claim.
pub struct ContainerRef<const STORE_CFG: WritStatic, const CFG: WritStatic> {
    /// Owns an rc share of the container root.
    pub arc: NodeARC<STORE_CFG>,    // owning rc on the container root
    /// Embeds the shared snap-side wiring.
    pub ctx: SnapCtx<STORE_CFG>,    // shared snap-side wiring (dir / CoW / ids / guard)
}

impl<const STORE_CFG: WritStatic, const CFG: WritStatic> Drop for ContainerRef<STORE_CFG, CFG> {
    /// Releases the snap's open-container claim; no writeback (mutators write back eagerly).
    fn drop(self: ContainerRef<STORE_CFG, CFG>) {
        // Release this snap's open-container claim (the commit guard).
        // self.arc auto-drops after this body, releasing its rc.
        unsafe { self.ctx.release(); }
    }
}

/// Creates an empty container under `ctr_id` in the snap's dir and returns its open handle.
// create_ctr — alloc a fresh empty leaf for the container, insert it
// into the dir under ctr_id (descending the dir tree, splitting on
// overflow), return a ContainerRef holding the open-claim handle.
//
// CoW: dir nodes touched on the descent are make_unique'd via
// dir_insert_rec so the parent commit's dir stays untouched.
pub fn create_ctr<const CFG: WritStatic, const STORE_CFG: WritStatic>(
    snap:   &mut Snap<STORE_CFG>,
    ctr_id: u64,
) -> ContainerRef<STORE_CFG, CFG> {
    let block_id: BlockId<STORE_CFG> = snap.alloc_block();
    // Allocate the container's initial empty leaf (data flavour) — map's own
    // root node type. A second share goes to the handle; `attach` transfers the
    // first into the dir entry.
    let root: NodeARC<STORE_CFG> = unsafe {
        leaf_alloc::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(block_id, snap.snapshot_id)
    };
    let arc_for_ref: NodeARC<STORE_CFG> = root.clone();
    let ctx: SnapCtx<STORE_CFG> = snap.attach(ctr_id, root);
    return ContainerRef::<STORE_CFG, CFG> { arc: arc_for_ref, ctx: ctx };
}

/// Opens the container at `ctr_id`: `Some(ContainerRef)` sharing the dir slot's rc, else `None`.
// open_ctr — look up ctr_id in the snapshot's dir tree. Some(ContainerRef)
// sharing rc with the dir's slot, or None when ctr_id isn't present (Rust
// parity — no more null-handle sentinel the caller must remember to test).
pub fn open_ctr<const CFG: WritStatic, const STORE_CFG: WritStatic>(
    snap:   &mut Snap<STORE_CFG>,
    ctr_id: u64,
) -> Option<ContainerRef<STORE_CFG, CFG>> {
    // `lookup` CoWs the dir up-front (so a later writeback lands in this
    // snapshot's dir), resolves ctr_id, claims the open slot, and returns the
    // root clone paired with the handle context. None when ctr_id isn't present.
    match snap.lookup(ctr_id) {
        Option::Some((root, ctx)) => {
            return Option::Some(ContainerRef::<STORE_CFG, CFG> { arc: root, ctx: ctx });
        }
        Option::None => { return Option::None; }
    }
}

// ContainerRef methods — full multi-level B+tree on top of NodeARC.
// Carries the ambient snapshot_id + id allocator so insert/remove can
// route through the mutate's CoW-aware descent without round-trip
// through the Store.
impl<const STORE_CFG: WritStatic, const CFG: WritStatic> ContainerRef<STORE_CFG, CFG> {
    /// Returns the number of entries in the container.
    pub fn len(&self) -> u64 {
        return bt_size_rec::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(&self.arc);
    }

    /// Returns `true` when the container has no entries.
    pub fn is_empty(&self) -> bool {
        return self.len() == 0u64;
    }

    /// Replaces the contents with an empty leaf; old tree blocks are released recursively.
    // Replace the container's contents with an empty leaf. Old root's
    // rc is decremented via arc_replace_in_slot — recursive release
    // through the auto-Drop chain frees every block reachable from
    // the previous tree (modulo blocks shared with another snapshot).
    pub fn clear(&mut self) {
        unsafe {
            let new_id: BlockId<STORE_CFG> = self.ctx.next_block_id();
            let new_arc: NodeARC<STORE_CFG> =
                leaf_alloc::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(
                    new_id, self.ctx.snap_id);
            arc_replace_in_slot::<STORE_CFG>(
                &mut self.arc as *mut NodeARC<STORE_CFG>, new_arc);
        }
        self.writeback();
    }

    /// Returns `true` when `key` is present.
    pub fn contains(&self, key: <type:CFG.key>::ViewInStore) -> bool {
        return bt_contains_rec::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(
            &self.arc, key);
    }

    /// Returns `Some(value)` for `key`, `None` on miss (`BTreeMap::get` parity).
    pub fn get(&self, key: <type:CFG.key>::ViewInStore) -> Option<<type:CFG.value>::ViewInStore> {
        unsafe {
            return bt_get_rec::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(
                &self.arc, key);
        }
    }

    /// Returns the n-th entry (zero-indexed, sorted order), or `None` when `n >= len()`.
    // Position-indexed lookup: Some((key, value)) at the n-th slot in sorted
    // order (zero-indexed), None if n >= len. O(depth) descent via the per-op
    // SUM-shuttle wrapper emitted on BranchNode for the `subtree_size`
    // aggregate column.
    pub fn get_at(&self, n: u64)
        -> Option<(<type:CFG.key>::ViewInStore, <type:CFG.value>::ViewInStore)> {
        unsafe {
            let mut leaf_idx: u64 = 0u64;
            let leaf_opt: Option<NodeARC<STORE_CFG>> =
                bt_descend_to_n::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(
                    &self.arc, n, &mut leaf_idx as *mut u64);
            let leaf_arc: NodeARC<STORE_CFG> = match leaf_opt {
                Option::Some(a) => { a }
                Option::None    => { return Option::None; }
            };
            let leaf_p: *const LeafNode<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG> =
                node_arc_data_ptr::<STORE_CFG>(&leaf_arc) as *const LeafNode<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>;
            let k: <type:CFG.key>::ViewInStore = leaf_p.keys.get(leaf_idx);
            let v: <type:CFG.value>::ViewInStore = leaf_p.vals.get(leaf_idx);
            return Option::Some((k, v));
        }
    }

    /// Inserts `key` → `val`; returns the previous value if present (`BTreeMap::insert` parity).
    pub fn insert(&mut self, key: <type:CFG.key>::ViewInStore, val: <type:CFG.value>::ViewInStore)
        -> Option<<type:CFG.value>::ViewInStore> {
        let r: Option<<type:CFG.value>::ViewInStore> = unsafe {
            bt_insert::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(
                &mut self.arc, key, val, key,
                self.ctx.snap_id, self.ctx.id_ctr_p)
        };
        self.writeback();
        return r;
    }

    /// Inserts after checking runtime key/value types; `Err` on mismatch instead of mis-storing.
    // CHECKED insert: reject a key/value whose runtime type is inconsistent with
    // what the container already holds (Err) instead of mis-storing, otherwise
    // insert and return Ok(old). For a homogeneous DView container this is the
    // safe entry point; plain `insert` is the trusted/fast one. The check peeks
    // the leftmost leaf — the element type is uniform across the container, so
    // any existing element witnesses it; an empty container accepts anything (it
    // declares its type on that first insert).
    pub fn try_insert(&mut self, key: <type:CFG.key>::ViewInStore, val: <type:CFG.value>::ViewInStore)
        -> Result<Option<<type:CFG.value>::ViewInStore>, InsertError> {
        unsafe {
            let mut leaf_idx: u64 = 0u64;
            let leaf_opt: Option<NodeARC<STORE_CFG>> =
                bt_descend_to_n::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(
                    &self.arc, 0u64, &mut leaf_idx as *mut u64);
            match leaf_opt {
                Option::Some(leaf_arc) => {
                    let leaf_p: *const LeafNode<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG> =
                        node_arc_data_ptr::<STORE_CFG>(&leaf_arc)
                            as *const LeafNode<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>;
                    if !leaf_p.keys.accepts(key) { return Result::Err(InsertError::KeyType); }
                    if !leaf_p.vals.accepts(val) { return Result::Err(InsertError::ValueType); }
                }
                Option::None => {}
            }
        }
        return Result::Ok(self.insert(key, val));
    }

    /// Removes `key`; returns `true` when it was present.
    pub fn remove(&mut self, key: <type:CFG.key>::ViewInStore) -> bool {
        let r: bool = unsafe {
            bt_remove::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(
                &mut self.arc, key,
                self.ctx.snap_id, self.ctx.id_ctr_p)
        };
        self.writeback();
        return r;
    }

    /// Syncs the dir's slot for this container with the current root `self.arc`.
    // Sync the dir's slot for ctr_id with self.arc. Insert/remove that
    // grow/collapse the root replaced self.arc (via arc_replace_in_slot)
    // but the dir's vals[i] still has the pre-mutation handle. The slot is
    // RE-RESOLVED freshly against the current dir (dir_lookup re-descends —
    // log-fanout, cheap) so it survives any dir realloc / split / root-grow
    // since open; never a cached interior pointer. Clone-bump self.arc's
    // block rc into the slot, release the slot's old share.
    pub fn writeback(&mut self) {
        unsafe { self.ctx.writeback(&self.arc); }
    }

    /// Returns the smallest position whose key is `>= k`, or `len()` when `k` exceeds every key.
    // Smallest position N (zero-indexed) such that key-at-N ≥ k.
    // Returns len() if k exceeds every key. O(depth) via shuttle_max_k
    // + per-level subtree_size accumulation. Safe: read-only descent.
    pub fn lower_bound(&self, k: <type:CFG.key>::ViewInStore) -> u64 {
        unsafe {
            return bt_lower_bound::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(
                &self.arc, k);
        }
    }

    /// Returns the smallest position whose key is `> k` (strict), or `len()` when none exceeds.
    // Smallest position N such that key-at-N > k (strict). Returns len()
    // if k ≥ every key. Safe: read-only descent.
    pub fn upper_bound(&self, k: <type:CFG.key>::ViewInStore) -> u64 {
        unsafe {
            return bt_upper_bound::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(
                &self.arc, k);
        }
    }

    /// Opens an iterator at the n-th entry (zero-indexed); invalid iter when `n >= len()`.
    // Open an iter positioned at the n-th entry (zero-indexed) in
    // sorted order. O(depth) construction via the SUM-shuttle descent
    // — no need to walk leftmost + n forward steps. n >= len returns
    // an invalid iter (valid() == false).
    pub fn iter_from(&self, n: u64) -> BtIter<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG> {
        unsafe {
            return bt_iter_open_at::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(&self.arc, n);
        }
    }

    /// Opens a forward iterator in key order; borrowing `&self` blocks mutation while live.
    // Forward iterator over the container's entries in key order. Safe to
    // call: BtIter is #[borrow_carrying] and borrows &self, so the borrow
    // checker forbids mutating the container while the iterator is live (the
    // pinned-snapshot pointers can't be invalidated). Internal raw-pointer
    // walk is wrapped here.
    pub fn iter(&self) -> BtIter<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG> {
        unsafe {
            return bt_iter_open::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(&self.arc);
        }
    }

    /// Opens a reverse iterator at the largest key; walk with `step_back()`.
    // Reverse iterator: positioned at the largest key. Walk descending order
    // with step_back() (valid()/key()/val() are direction-agnostic). Same
    // borrow rule + safety as iter().
    pub fn iter_rev(&self) -> BtIter<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG> {
        unsafe {
            return bt_iter_open_back::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(&self.arc);
        }
    }
}
