// logos.std.deem.data.bt.shuttle — typed B+tree descent components.
//
// A "shuttle" is the per-branch step that picks which child to descend
// into for one tree dimension. Two kinds today:
//
//   SUM  — branch slot[i] = subtree-count (or any monoidal sum). The
//          shuttle finds the child whose prefix-sum brackets the target
//          ordinal, returning the child index plus the remainder
//          (target − prefix-sum) for the recursive descent.
//
//   MAX  — branch slot[i] = max-key in subtree. The shuttle finds the
//          first child whose max ≥ target. Remainder is unchanged
//          (kept for ABI uniformity with SUM).
//
// derive_branch_node emits, per op declared in BRANCH_OPS, a thin
// wrapper that calls one of these templates with the right column.
// User-side find(K) / seek(N) compose those wrappers into a descent.

package logos.std.deem.data.bt.shuttle;

use logos.lang.cmp;
use logos.lang.fabric;
use logos.lang.writ.wstatic;

/// Outcome of one branch-descent step: which child to enter and the adjusted target.
pub struct ShuttleResult {
    /// Index of the child to descend into.
    pub idx:       u64,   // child index to descend into
    /// Adjusted target to carry into the recursive descent (e.g. `target - prefix`).
    pub remainder: u64,   // adjusted target for the recursive call
}

/// Finds the child whose prefix-sum range brackets `target` in a SUM-dimension branch.
/// Assumes `target` is in-range; caller must check `len == 0` and the total beforehand.
/// Out-of-range `target` clamps to the last child with full remainder.
pub fn shuttle_sum_u64(slots: *const PrimVec<u64>, target: u64) -> ShuttleResult {
    unsafe {
        let n: u64 = slots.len;
        let mut prefix: u64 = 0u64;
        let mut i: u64 = 0u64;
        while i < n {
            let s: u64 = slots.get(i);
            if prefix + s > target {
                return ShuttleResult { idx: i, remainder: target - prefix };
            }
            prefix = prefix + s;
            i = i + 1u64;
        }
        // Out of range — clamp to last child with full remainder.
        return ShuttleResult { idx: if n > 0u64 { n - 1u64 } else { 0u64 },
                                remainder: target - prefix };
    }
}

/// Finds the first child whose max-key slot is `>= target` in a MAX-dimension branch.
/// If none qualifies, `target` is past the last subtree — clamps to the last child.
pub fn shuttle_max_u64(slots: *const PrimVec<u64>, target: u64) -> ShuttleResult {
    unsafe {
        let n: u64 = slots.len;
        let mut i: u64 = 0u64;
        while i < n {
            let s: u64 = slots.get(i);
            if s >= target {
                return ShuttleResult { idx: i, remainder: target };
            }
            i = i + 1u64;
        }
        return ShuttleResult { idx: if n > 0u64 { n - 1u64 } else { 0u64 },
                                remainder: target };
    }
}

/// Generic MAX-dimension shuttle over `K`: returns the smallest `i` with `slots[i] >= target`.
/// `slots` is the `keys` column of a `BranchNode` (i-th slot = max key in `children[i]`'s
/// subtree); comparison goes through `cmp_views`. Out-of-range `target` clamps to the last
/// child; `remainder` is always 0 (kept only for ABI parity with the SUM/MAX u64 shuttles).
pub fn shuttle_max_k<K: Container + ContainerOrd>(
    slots: *const Buffer<K>, target: K::ViewInStore
) -> ShuttleResult {
    unsafe {
        let n: u64 = slots.len();
        let mut i: u64 = 0u64;
        let phantom: *const K = 0 as *const K;
        while i < n {
            let kv: K::ViewInStore = slots.get(i);
            match phantom.cmp_views(kv, target) {
                Ordering::Less => { i = i + 1u64; }
                _ => { return ShuttleResult { idx: i, remainder: 0u64 }; }
            }
        }
        return ShuttleResult { idx: if n > 0u64 { n - 1u64 } else { 0u64 },
                                remainder: 0u64 };
    }
}
