// ═══════════════════════════════════════════════════════════════════════════
// INCREMENTAL DATAFLOW ENGINE — slice-1 (ADR 0013 §8)
//
// A DBSP-style signed-weight (Z-set) incremental maintainer for the linear +
// ONE-bilinear-join fragment  RDistinct?( RProj( RFilter?( RJoin(Scan,Scan) ) ) ).
// Plain single-threaded: an "epoch" is one call that admits ±delta batches,
// computes the netted output delta, applies it, then integrates the deltas
// into the arranged inputs — INTEGRATE-AFTER-COMPUTE (§8.2). Derived from the
// batch evaluator: reuses eval_sexpr / eval_on_residual / rt_key_hash / rt_eq
// verbatim, so the only new surface is the weight bookkeeping.
//
// State is private; the PUBLIC surface is ZBatch / IncrJoin /
// Query::incremental. Correctness rules honored: U1 (rel-free; the dedup
// boundary is the top RDistinct, non-negative source clamp is the harness's
// job; out_int may hold transient negatives, compared only at quiescence),
// §10.4 (RProj weight-coalesce; RDistinct multiplicity-CROSSING), §8.2
// integrate-after-compute.
// ═══════════════════════════════════════════════════════════════════════════

// A ±delta batch over ONE source: signed-weight node handles. Harness-built
// (the ZBatch seam, §6 — mutation-instrumentation / snapshot-diff are drop-in
// producers behind it).
pub struct ZBatch {
    node: Vec<WAny>,
    wt:   Vec<i64>,
}
impl ZBatch {
    pub fn new() -> ZBatch { return ZBatch { node: vec_new::<WAny>(), wt: vec_new::<i64>() }; }
    pub fn push(self: &mut ZBatch, row: WAny, w: i64) { self.node.push(row); self.wt.push(w); }
    pub fn clear(self: &mut ZBatch) {
        self.node = vec_new::<WAny>();
        self.wt   = vec_new::<i64>();
    }
    pub fn len(self: &ZBatch) -> i64 { return self.node.len(); }
    // Per-row accessors (test/tooling inspection of a produced changelog).
    pub fn row(self: &ZBatch, i: i64) -> WAny { return self.node.get(i); }
    pub fn weight(self: &ZBatch, i: i64) -> i64 { return self.wt.get(i); }
}

// ═══════════════════════════════════════════════════════════════════════════
// FactStore — slice-8: a MUTABLE in-memory fact-store (working memory) that
// OWNS the U1 clamp and PRODUCES the ZBatch changelog (ADR 0013 §6, change-
// capture A). One store per named source relation. It is the first real
// producer behind the ZBatch seam: today the engine consumes hand-synthesized
// batches; the store lets a caller insert/retract facts and `take_delta` the
// net ± changes since the last epoch — feeding IncrJoin/IncrRec unchanged.
//
// SET semantics (a working-memory relation is a SET, not a bag): the store
// tracks per-fact presence {absent,present} and emits ONLY effective deltas —
// insert-of-present = no-op, retract-of-absent = no-op, re-insert-after-retract
// = +1. This is exactly the `src_apply` clamp the harnesses did by hand, now
// owned by the store.
//
// FACT IDENTITY (the crux): the engine dedups on `node.raw()` (absolute pointer
// bits) and rt_eq(Node,Node)=false by design, so the store CANNOT identify
// facts by handle nor content-eq whole Nodes. Instead it content-keys on the
// schema's SCALAR fields via `field_read` (the SAME decode the oracle uses),
// maps content → ONE canonical handle, and always re-emits that canonical
// handle so the engine sees a stable pointer. Content-key fields MUST be scalar
// (i64/f64/bool/str): `field_read` returns RtVal::Node for edge/edge-array
// fields, which hash to one bucket and never rt_eq — unusable as identity. The
// ctor validates each key field via `cat.field_ty` and returns Err otherwise.
// ── The epoch-history layer (ADR 0017 P1) ───────────────────────────────────
// The hot working set below (node/key/present/idx) is untouched — it serves
// every intra-epoch read and the U1 clamps at Vec/HashMap speed. The `data`
// store records the SET at each EPOCH BOUNDARY: take_delta applies the ±
// changelog to a container in a scoped fork→apply→commit cycle, so
// **epoch = commit** — every epoch has a queryable, fork-able identity in the
// snapshot DAG, and the future dump (P4) serializes exactly this committed
// state. Snap/ContainerRef are NEVER stored across calls: SnapCtx carries a
// raw pointer into the Snap value (location-anchored), so the cycle opens and
// closes them inside one scope.
pub const FsStoreCfg: WritStatic = @{
    "name":     "factstore",
    "ctr_id":   <type:u64>,
    "snp_id":   <type:u64>,
    "block_id": <type:u64>,
};
pub const FsCtrCfg: WritStatic = @{ "key": <type:DView>, "value": <type:DView>, "fanout": 16 };
const FS_CTR_ID: u64 = 1u64;

pub struct FactStore {
    doc:     Writ,               // OWNS the arena the canonical handles point into
                                 // (must outlive the engine — bind_source contract)
    cat:     SchemaCatalog,      // owned catalog snapshot (field_read needs it)
    sname:   str,                // schema name (documentation / validation)
    keyf:    Vec<str>,           // scalar content-key field names
    node:    Vec<WAny>,          // canonical handle per DISTINCT content
    key:     Vec<Vec<FsKey>>,    // OWNED scalar key tuple per slot (identity)
    present: Vec<bool>,          // SET presence per slot
    idx:     HashMap<u64, Vec<i64>>,  // content-hash → candidate slot indices
    pend:    ZBatch,             // pending ± changelog since last take_delta
    epend:   Vec<i64>,           // this epoch's ±slot log for the history layer
                                 // (slot ≥ 0 = insert, −slot−1 = retract)
    hist:    Store<FsStoreCfg>,  // the data store (ADR 0017): epoch history
    heads:   Vec<u64>,           // commit id per epoch (heads[e] = epoch e's SET)
    // ── S4 v0 branches (ADR 0015 §5 / ADR 0017 P2): assumption-ΔEDB
    // exploration over the LIVE store. An active branch records its EFFECTIVE
    // ±slot ops; branch_end rolls the live set back by applying the INVERSE
    // ops — the engine consumes the rollback delta like any other epoch (law
    // I4: fork/merge is EDB-only, IDB re-derives incrementally). Ended
    // branches retain name + head + log; select_one re-applies the winner's
    // log, registers a MERGE commit in the history DAG (winner = first
    // parent, losers = extra parents), and RELEASES the losers' heads.
    br_on:   bool,               // a branch is recording
    br_pnm:  String,             // active branch's name
    br_log:  Vec<i64>,           // active branch's ±slot ops
    br_name: Vec<String>,        // ended branches: names
    br_head: Vec<u64>,           //   their epoch-head commits
    br_ops:  Vec<i64>,           //   retained logs (flat pool)
    br_off:  Vec<i64>,           //   per-branch offset into br_ops
    br_cnt:  Vec<i64>,           //   per-branch op count
    mg_win:  Vec<String>,        // merges: winner branch name
    mg_cid:  Vec<u64>,           //   merge commit id in the history DAG
    mg_lsr:  Vec<String>,        //   loser names (flat pool)
    mg_loff: Vec<i64>,           //   per-merge offset into mg_lsr
    mg_lcnt: Vec<i64>,           //   per-merge loser count
}

// An OWNED scalar key element. RtVal::S carries a `str` VIEW (borrows the source
// node), so a Vec<RtVal> key would tie the store's identity to node lifetimes
// AND make key_of's return borrow `self` — blocking the mutable store ops. FsKey
// OWNS its bytes (String) so a key tuple is fully self-contained: identity
// survives even a transient source node, and key_of returns a borrow-free value.
//   k: 0 null · 1 i64 · 2 f64 · 3 bool · 4 str
struct FsKey { k: i32, i: i64, f: f64, b: bool, s: String }

fn fskey_of(v: RtVal) -> FsKey {
    match v {
        RtVal::I(x)  => { return FsKey { k: 1i32, i: x,     f: 0.0f64, b: false, s: String::new() }; }
        RtVal::F(x)  => { return FsKey { k: 2i32, i: 0i64,  f: x,      b: false, s: String::new() }; }
        RtVal::B(bb) => { return FsKey { k: 3i32, i: 0i64,  f: 0.0f64, b: bb,    s: String::new() }; }
        RtVal::S(ss) => { let mut t: String = String::new(); t.push_str(ss);
                          return FsKey { k: 4i32, i: 0i64,  f: 0.0f64, b: false, s: t }; }
        _            => { return FsKey { k: 0i32, i: 0i64,  f: 0.0f64, b: false, s: String::new() }; }
    }
}

// Encode a key tuple into container-key bytes: per field, one tag byte then a
// tag-determined payload (i64/f64-bits: 8B; bool: 1B; str: 4B len + bytes).
// Deterministic and prefix-collision-safe ⇒ byte equality ≡ tuple equality;
// the B+tree only needs SOME total order, and lexicographic-over-bytes is one.
fn fs_key_enc(k: &Vec<FsKey>, out: &mut String) {
    let n: i64 = k.len();
    let mut i: i64 = 0i64;
    while i < n {
        let e: &FsKey = k.borrow(i);
        out.push_u8(e.k as u8);
        if e.k == 1i32 {
            let mut v: u64 = e.i as u64;
            let mut b: i64 = 0i64;
            while b < 8i64 { out.push_u8(((v >> 56u64) & 255u64) as u8); v = v << 8u64; b = b + 1i64; }
        } else if e.k == 2i32 {
            let mut v: u64 = f64_to_bits(e.f);
            let mut b: i64 = 0i64;
            while b < 8i64 { out.push_u8(((v >> 56u64) & 255u64) as u8); v = v << 8u64; b = b + 1i64; }
        } else if e.k == 3i32 {
            out.push_u8(if e.b { 1u8 } else { 0u8 });
        } else if e.k == 4i32 {
            let mut l: u64 = e.s.len() as u64;
            let mut b: i64 = 0i64;
            while b < 4i64 { out.push_u8(((l >> 24u64) & 255u64) as u8); l = l << 8u64; b = b + 1i64; }
            let sl: i64 = e.s.len();
            let mut j: i64 = 0i64;
            while j < sl { out.push_u8(str_byte_at(e.s.as_str(), j)); j = j + 1i64; }
        }
        i = i + 1i64;
    }
}

fn fskey_eq(a: &FsKey, b: &FsKey) -> bool {
    if a.k != b.k { return false; }
    if a.k == 1i32 { return a.i == b.i; }
    if a.k == 2i32 { return a.f == b.f; }
    if a.k == 3i32 { return a.b == b.b; }
    if a.k == 4i32 { return a.s.eq_string(&b.s); }
    return true;   // both null
}

fn fskey_hash(e: &FsKey) -> u64 {
    let mut h: u64 = 14695981039346656037u64;
    if e.k == 1i32 { h = h_step(h, 1u64); h = h_step(h, e.i as u64); return h; }
    if e.k == 3i32 { h = h_step(h, 3u64); h = h_step(h, if e.b { 1u64 } else { 0u64 }); return h; }
    if e.k == 4i32 {
        h = h_step(h, 2u64);
        let s: str = e.s.as_str();
        let n: i64 = s.len();
        let mut i: i64 = 0i64;
        while i < n { h = h_step(h, str_byte_at(s, i) as u64); i = i + 1i64; }
        return h;
    }
    if e.k == 2i32 { h = h_step(h, 4u64); h = h_step(h, f64_to_bits(e.f)); return h; }
    h = h_step(h, 0u64);
    return h;
}

// FNV-fold fskey_hash over the key-tuple elements (bucket key for `idx`).
fn fs_key_hash(k: &Vec<FsKey>) -> u64 {
    let mut h: u64 = 14695981039346656037u64;
    let n: i64 = k.len();
    let mut i: i64 = 0i64;
    while i < n { h = h_step(h, fskey_hash(k.borrow(i))); i = i + 1i64; }
    return h;
}

// Element-wise equality over two key tuples (resolves hash-bucket collisions).
fn fs_key_eq(a: &Vec<FsKey>, b: &Vec<FsKey>) -> bool {
    if a.len() != b.len() { return false; }
    let n: i64 = a.len();
    let mut i: i64 = 0i64;
    while i < n {
        if !fskey_eq(a.borrow(i), b.borrow(i)) { return false; }
        i = i + 1i64;
    }
    return true;
}

impl FactStore {
    // Build a store over `sname` in `cat`, content-keyed on `keyf` (a list of
    // SCALAR field names). Validates every key field is scalar via field_ty;
    // Err on a non-scalar (edge/arr/any) or unknown field, or empty key list.
    // `seg` sizes the owned arena's segments (canonical handles live here).
    pub fn new(cat: &SchemaCatalog, sname: str, keyf: &[str], seg: i64)
        -> Result<FactStore, str> {
        let n: i64 = keyf.len();
        if n == 0i64 { return Result::Err("FactStore: need ≥1 key field"); }
        let mut kf: Vec<str> = vec_new::<str>();
        let mut i: i64 = 0i64;
        while i < n {
            let f: str = keyf[i];
            let ty: str = cat.field_ty(sname, f);
            let ok: bool = str_eq(ty, "i64") || str_eq(ty, "f64")
                        || str_eq(ty, "bool") || str_eq(ty, "str");
            if !ok { return Result::Err("FactStore: key field must be scalar (i64/f64/bool/str)"); }
            kf.push(f);
            i = i + 1i64;
        }
        return Result::Ok(FactStore {
            doc:     writ_new(seg),
            cat:     catalog_clone(cat),
            sname:   sname,
            keyf:    kf,
            node:    vec_new::<WAny>(),
            key:     vec_new::<Vec<FsKey>>(),
            present: vec_new::<bool>(),
            idx:     hashmap_new::<u64, Vec<i64>>(),
            pend:    ZBatch::new(),
            epend:   vec_new::<i64>(),
            hist:    store_open::<FsStoreCfg>(),
            heads:   vec_new::<u64>(),
            br_on:   false,
            br_pnm:  String::new(),
            br_log:  vec_new::<i64>(),
            br_name: vec_new::<String>(),
            br_head: vec_new::<u64>(),
            br_ops:  vec_new::<i64>(),
            br_off:  vec_new::<i64>(),
            br_cnt:  vec_new::<i64>(),
            mg_win:  vec_new::<String>(),
            mg_cid:  vec_new::<u64>(),
            mg_lsr:  vec_new::<String>(),
            mg_loff: vec_new::<i64>(),
            mg_lcnt: vec_new::<i64>(),
        });
    }

    // The store's owned arena — build fact nodes into it (mk_edge(store.arena(),…))
    // so the canonical handles the store interns live as long as the store.
    pub fn arena(self: &FactStore) -> &Writ { return &self.doc; }
    // Raw-pointer view of the owned arena. Building fact nodes through this (vs
    // the &Writ `arena`) keeps the resulting WAny handle free of a tracked borrow
    // of the store, so node-build then store-mutate compose in one scope.
    pub fn arena_ptr(self: &FactStore) -> *const Writ { return &self.doc as *const Writ; }

    // Decode a node's scalar key tuple (the content identity). Returns an OWNED
    // Vec<FsKey> — fskey_of consumes each RtVal, so the result borrows nothing.
    fn key_of(self: &FactStore, node: WAny) -> Vec<FsKey> {
        let mut k: Vec<FsKey> = vec_new::<FsKey>();
        let n: i64 = self.keyf.len();
        let mut i: i64 = 0i64;
        while i < n { k.push(fskey_of(field_read(&self.cat, node, self.keyf.get(i)))); i = i + 1i64; }
        return k;
    }

    // Slot of the content key (−1 miss): hash bucket + element-wise eq scan.
    fn find(self: &mut FactStore, k: &Vec<FsKey>) -> i64 {
        let h: u64 = fs_key_hash(k);
        let ixp: *mut HashMap<u64, Vec<i64>> = &mut self.idx;
        let vp: *const Vec<i64> = unsafe { ixp.get(&h) };
        if (vp as i64) == 0i64 { return -1i64; }
        let cand: &Vec<i64> = unsafe { &*vp };
        let m: i64 = cand.len();
        let mut j: i64 = 0i64;
        while j < m {
            let slot: i64 = cand.get(j);
            if fs_key_eq(self.key.borrow(slot), k) { return slot; }
            j = j + 1i64;
        }
        return -1i64;
    }

    // Insert a fact (SET semantics, effective-delta emit — the U1 clamp OWNED
    // here). New content → append canonical slot + push +1. Present-again → NO
    // push (idempotent). Absent-again (present==false) → present, push +1 on the
    // CANONICAL handle (so the engine sees a stable pointer across re-inserts).
    pub fn insert(self: &mut FactStore, node: WAny) {
        let k: Vec<FsKey> = self.key_of(node);
        let i: i64 = self.find(&k);
        if i >= 0i64 {
            if !self.present.get(i) {
                self.present.set(i, true);
                let cn: WAny = self.node.get(i);
                self.pend.push(cn, 1i64);
                self.epend.push(i);
                if self.br_on { self.br_log.push(i); }
            }
            return;   // present-again → no-op, no push
        }
        let slot: i64 = self.node.len();
        let h: u64 = fs_key_hash(&k);
        self.node.push(node);
        self.key.push(k);
        self.present.push(true);
        let ixp: *mut HashMap<u64, Vec<i64>> = &mut self.idx;
        unsafe {
            let vp: *mut Vec<i64> = ixp.get_or_insert(h, vec_new::<i64>());
            (&mut *vp).push(slot);
        }
        self.pend.push(node, 1i64);
        self.epend.push(slot);
        if self.br_on { self.br_log.push(slot); }
    }

    // Retract a fact. Miss OR already-absent → no-op (no phantom minus). Present
    // → clear presence, push −1 on the canonical handle.
    pub fn retract(self: &mut FactStore, node: WAny) {
        let k: Vec<FsKey> = self.key_of(node);
        let i: i64 = self.find(&k);
        if i < 0i64 { return; }
        if !self.present.get(i) { return; }
        self.present.set(i, false);
        let cn: WAny = self.node.get(i);
        self.pend.push(cn, -1i64);
        self.epend.push(0i64 - i - 1i64);
        if self.br_on { self.br_log.push(0i64 - i - 1i64); }
    }

    // Move out the accumulated ± changelog and reset it. The returned ZBatch is
    // the net-change EPOCH batch since the last call — feed it to epoch directly
    // (intra-epoch multi-touch on one content = +1 then −1 on the SAME canonical
    // raw; the engine admit loops coalesce by raw() → net zero, no manual netting).
    pub fn take_delta(self: &mut FactStore) -> ZBatch {
        // ── epoch boundary (ADR 0017 P1): apply this epoch's ±slot log to the
        // history container in ONE scoped fork→apply→commit cycle. epoch =
        // commit: heads[e] names epoch e's SET in the snapshot DAG. Applying
        // in order makes the last op per slot win (same-epoch insert+retract
        // nets out exactly like the hot set).
        {
            let parent: u64 = if self.heads.len() == 0i64 { GENESIS }
                              else { self.heads.get(self.heads.len() - 1i64) };
            let mut snap = self.hist.fork(parent);
            {
                let mut cr = if self.heads.len() == 0i64 {
                    create_ctr::<FsCtrCfg>(&mut snap, FS_CTR_ID)
                } else {
                    match open_ctr::<FsCtrCfg>(&mut snap, FS_CTR_ID) {
                        Option::Some(c) => { c }
                        Option::None    => { create_ctr::<FsCtrCfg>(&mut snap, FS_CTR_ID) }
                    }
                };
                let ne: i64 = self.epend.len();
                let mut i: i64 = 0i64;
                while i < ne {
                    let op: i64 = self.epend.get(i);
                    let slot: i64 = if op >= 0i64 { op } else { 0i64 - op - 1i64 };
                    let mut kb: String = String::new();
                    fs_key_enc(self.key.borrow(slot), &mut kb);
                    if op >= 0i64 {
                        let sv: u64 = slot as u64;
                        cr.insert(DView::from_str(kb.as_str()), DView::from(&sv));
                    } else {
                        cr.remove(DView::from_str(kb.as_str()));
                    }
                    i = i + 1i64;
                }
            }
            self.heads.push(snap.commit());
            self.epend.clear();
        }
        let pp: *mut ZBatch = &mut self.pend;
        return unsafe { replace::<ZBatch>(pp, ZBatch::new()) };
    }

    // ── epoch-history reads (ADR 0017 P1) ───────────────────────────────
    /// Number of committed epochs.
    pub fn epoch_count(self: &FactStore) -> i64 { return self.heads.len(); }

    /// The commit id naming epoch `e`'s SET in the history store's DAG —
    /// the fork point for S4 (P2).
    pub fn epoch_head(self: &FactStore, e: i64) -> u64 { return self.heads.get(e); }

    /// Number of facts present at committed epoch `e`.
    pub fn count_at(self: &mut FactStore, e: i64) -> i64 {
        let head: u64 = self.heads.get(e);
        let mut snap = self.hist.fork(head);
        let mut n: i64 = 0i64;
        {
            match open_ctr::<FsCtrCfg>(&mut snap, FS_CTR_ID) {
                Option::Some(cr) => { n = cr.len() as i64; }
                Option::None     => { n = 0i64; }
            }
        }
        // read-only fork: dropped, not committed (no DAG node per read)
        return n;
    }

    /// Was the fact with `node`'s content present at committed epoch `e`?
    pub fn contains_at(self: &mut FactStore, e: i64, node: WAny) -> bool {
        let k: Vec<FsKey> = self.key_of(node);
        let mut kb: String = String::new();
        fs_key_enc(&k, &mut kb);
        let head: u64 = self.heads.get(e);
        let mut snap = self.hist.fork(head);
        let mut hit: bool = false;
        {
            match open_ctr::<FsCtrCfg>(&mut snap, FS_CTR_ID) {
                Option::Some(cr) => { hit = cr.contains(DView::from_str(kb.as_str())); }
                Option::None     => { hit = false; }
            }
        }
        return hit;
    }

    // ── S4 v0 fork/merge (ADR 0015 §5 select_one; ADR 0017 P2) ──────────

    // Apply a ±slot op to the live set — the rollback / re-apply primitive.
    // Mirrors insert()'s re-insert path and retract() (presence + ZBatch +
    // epoch log), WITHOUT branch recording: callers run with br_on == false.
    fn apply_slot_op(self: &mut FactStore, op: i64) {
        let slot: i64 = if op >= 0i64 { op } else { 0i64 - op - 1i64 };
        if op >= 0i64 {
            if !self.present.get(slot) {
                self.present.set(slot, true);
                let cn: WAny = self.node.get(slot);
                self.pend.push(cn, 1i64);
                self.epend.push(slot);
            }
        } else {
            if self.present.get(slot) {
                self.present.set(slot, false);
                let cn: WAny = self.node.get(slot);
                self.pend.push(cn, -1i64);
                self.epend.push(0i64 - slot - 1i64);
            }
        }
    }

    /// Begins recording an assumption branch. Precondition: no branch active
    /// and a clean epoch boundary (take_delta consumed).
    pub fn branch_begin(self: &mut FactStore, name: str) {
        if self.br_on { panic("FactStore::branch_begin: a branch is already active"); }
        if self.epend.len() != 0i64 { panic("FactStore::branch_begin: pending epoch ops — take_delta first"); }
        let mut nm: String = String::new();
        nm.push_str(name);
        self.br_pnm = nm;
        self.br_on = true;
    }

    /// Ends the active branch: captures its head (the last committed epoch),
    /// retains its log for select_one, and rolls the live set back with the
    /// INVERSE ops. The caller feeds the rollback delta to the engine via the
    /// usual take_delta()/epoch() cycle.
    pub fn branch_end(self: &mut FactStore) {
        if !self.br_on { panic("FactStore::branch_end: no active branch"); }
        if self.epend.len() != 0i64 { panic("FactStore::branch_end: pending epoch ops — take_delta first"); }
        self.br_on = false;
        let mut nm: String = String::new();
        nm.push_str(self.br_pnm.as_str());
        self.br_name.push(nm);
        let bh: u64 = if self.heads.len() == 0i64 { 0u64 }
                      else { self.heads.get(self.heads.len() - 1i64) };
        self.br_head.push(bh);
        self.br_off.push(self.br_ops.len());
        self.br_cnt.push(self.br_log.len());
        let n: i64 = self.br_log.len();
        let mut i: i64 = 0i64;
        while i < n { self.br_ops.push(self.br_log.get(i)); i = i + 1i64; }
        // Roll back: inverse ops in reverse order (op negation `−op−1` is the
        // involution slot s ↔ −s−1, i.e. insert ↔ retract of the same slot).
        let mut j: i64 = n - 1i64;
        while j >= 0i64 {
            let op: i64 = self.br_log.get(j);
            self.apply_slot_op(0i64 - op - 1i64);
            j = j - 1i64;
        }
        self.br_log.clear();
    }

    /// Resolves the ended-branch set by select_one: re-applies the winner's
    /// ops to the live set, registers a MERGE commit (winner's head = first
    /// parent, each loser's head = extra parent) in the history DAG, RELEASES
    /// the losers' head commits, records the merge for querying, and clears
    /// the branch set. Returns the merge commit id. The caller feeds the
    /// re-apply delta to the engine via take_delta()/epoch().
    pub fn select_one(self: &mut FactStore, winner: str) -> u64 {
        if self.br_on { panic("FactStore::select_one: end the active branch first"); }
        if self.epend.len() != 0i64 { panic("FactStore::select_one: pending epoch ops — take_delta first"); }
        let nb: i64 = self.br_name.len();
        let mut w: i64 = 0i64 - 1i64;
        {
            let mut i: i64 = 0i64;
            while i < nb {
                if str_eq(self.br_name.borrow(i).as_str(), winner) { w = i; }
                i = i + 1i64;
            }
        }
        if w < 0i64 { panic("FactStore::select_one: unknown branch"); }
        // Re-apply the winner's ops (forward order).
        let off: i64 = self.br_off.get(w);
        let cnt: i64 = self.br_cnt.get(w);
        let mut k: i64 = 0i64;
        while k < cnt { self.apply_slot_op(self.br_ops.get(off + k)); k = k + 1i64; }
        // Merge commit: winner first, losers extra parents (skipping losers
        // whose head coincides with the winner's — an op-less branch).
        let wh: u64 = self.br_head.get(w);
        let mut losers: Vec<u64> = vec_new::<u64>();
        {
            let mut i: i64 = 0i64;
            while i < nb {
                if i != w {
                    let lh: u64 = self.br_head.get(i);
                    if lh != wh { losers.push(lh); }
                }
                i = i + 1i64;
            }
        }
        let mc: u64 = self.hist.merge(wh, &losers);
        {
            let nl: i64 = losers.len();
            let mut i: i64 = 0i64;
            while i < nl { self.hist.release(losers.get(i)); i = i + 1i64; }
        }
        // Record the merge (queryable: merge_count / merge_winner / …).
        {
            let mut nm: String = String::new();
            nm.push_str(winner);
            self.mg_win.push(nm);
            self.mg_cid.push(mc);
            self.mg_loff.push(self.mg_lsr.len());
            self.mg_lcnt.push(nb - 1i64);
            let mut i: i64 = 0i64;
            while i < nb {
                if i != w {
                    let mut ln: String = String::new();
                    ln.push_str(self.br_name.borrow(i).as_str());
                    self.mg_lsr.push(ln);
                }
                i = i + 1i64;
            }
        }
        self.br_name.clear();
        self.br_head.clear();
        self.br_ops.clear();
        self.br_off.clear();
        self.br_cnt.clear();
        return mc;
    }

    // ── branch/merge history reads ──
    /// Number of ended, not-yet-resolved branches.
    pub fn branch_count(self: &FactStore) -> i64 { return self.br_name.len(); }
    /// Name of ended branch `i` (owned copy).
    pub fn branch_name(self: &FactStore, i: i64) -> String {
        let mut out: String = String::new();
        out.push_str(self.br_name.borrow(i).as_str());
        return out;
    }
    /// Head commit of ended branch `i`.
    pub fn branch_head(self: &FactStore, i: i64) -> u64 { return self.br_head.get(i); }
    /// Number of resolved merges.
    pub fn merge_count(self: &FactStore) -> i64 { return self.mg_win.len(); }
    /// Winner branch name of merge `i` (owned copy).
    pub fn merge_winner(self: &FactStore, i: i64) -> String {
        let mut out: String = String::new();
        out.push_str(self.mg_win.borrow(i).as_str());
        return out;
    }
    /// The history-DAG commit id of merge `i`.
    pub fn merge_commit(self: &FactStore, i: i64) -> u64 { return self.mg_cid.get(i); }
    /// Number of losers of merge `i`.
    pub fn merge_loser_count(self: &FactStore, i: i64) -> i64 { return self.mg_lcnt.get(i); }
    /// Name of loser `j` of merge `i` (owned copy).
    pub fn merge_loser(self: &FactStore, i: i64, j: i64) -> String {
        let mut out: String = String::new();
        out.push_str(self.mg_lsr.borrow(self.mg_loff.get(i) + j).as_str());
        return out;
    }
    /// Parent commits of a history-DAG commit (e.g. a merge's [winner, losers…]).
    pub fn hist_parents_of(self: &mut FactStore, id: u64) -> Vec<u64> {
        return self.hist.parents_of(id);
    }
    /// Whether a history-DAG commit has been released (losers are, post-merge).
    pub fn hist_is_released(self: &mut FactStore, id: u64) -> bool {
        return self.hist.is_released(id);
    }

    // Materialize the CURRENT present set into the owned arena as a Writ array of
    // canonical handles — the batch oracle binds this via bind_source. One handle
    // per present slot (byte-role-identical to the harnesses' build_src).
    pub fn build_present(self: &FactStore) -> WAny {
        let arr: &mut WArray<WAny> = self.doc.array(self.node.len() + 1i64);
        let n: i64 = self.node.len();
        let mut i: i64 = 0i64;
        while i < n {
            if self.present.get(i) { arr.push(self.node.get(i)); }
            i = i + 1i64;
        }
        return WAny::ref_to(arr as *const WArray<WAny> as *const u8);
    }

    // Count of currently-present facts (test probe).
    pub fn count(self: &FactStore) -> i64 {
        let n: i64 = self.node.len();
        let mut c: i64 = 0i64;
        let mut i: i64 = 0i64;
        while i < n { if self.present.get(i) { c = c + 1i64; } i = i + 1i64; }
        return c;
    }
}

// ── Drivers (ADR 0013 §6): pump a store's pending delta into a standing engine.
// IncrJoin/IncrRec are distinct types (no shared trait needed) — two thin helpers.
pub fn pump_rec(store: &mut FactStore, eng: &mut IncrRec) {
    let d: ZBatch = store.take_delta();
    eng.epoch(&d);
}
pub fn pump_join(sa: &mut FactStore, sb: &mut FactStore, eng: &mut IncrJoin) {
    let da: ZBatch = sa.take_delta();
    let db: ZBatch = sb.take_delta();
    eng.epoch(&da, &db);
}

// An integrated, arranged Z-set of ONE join input, keyed on the join key.
//   node/wt/key — one slot per source-row identity (weight >0 at quiescence)
//   id  — handle-raw -> slot: coalesce ±w by identity (the change-capture is
//         per whole-node row; rt_key_hash collapses Nodes to one bucket and
//         rt_eq(Node,Node)=false, so identity is the raw self-relative ref)
//   idx — join-key hash -> slots: the arrangement / probe index (kept live).
//   mc — per-LEFT-ROW matchcount (anti mode only): weighted count of supporting
//        right matches for slot i; the left row is in the anti-output iff mc==0.
//        Sentinel -1 = "uncomputed" (a new slot not yet probed). Meaningful only
//        for the LEFT arrangement (`a`) under anti; unused for join / for `b`.
pub struct Arr {
    var:  str,
    node: Vec<WAny>,
    wt:   Vec<i64>,
    key:  Vec<RtVal>,
    mc:   Vec<i64>,
    id:   HashMap<u64, i64>,
    idx:  HashMap<u64, Vec<i64>>,
}
fn arr_new(var: str) -> Arr {
    return Arr {
        var: var, node: vec_new::<WAny>(), wt: vec_new::<i64>(), key: vec_new::<RtVal>(),
        mc: vec_new::<i64>(),
        id: hashmap_new::<u64, i64>(), idx: hashmap_new::<u64, Vec<i64>>(),
    };
}

// ── AggState — per-group i64 accumulators for incremental GROUP aggregation ──
// (DBSP slice-3, ADR 0013 §3.1). One SLOT per distinct group key; slots are
// NEVER deleted (mirrors `Arr`), an emptied group keeps its slot with
// gcount==0/gsum==0 (the abelian GROUP inverse over CLAMPED truth) and is reused
// cleanly on re-appearance.
//   keyv   — group key RtVal per slot (string keys interned into the out arena)
//   gcount — Σw = count() value AND the avg denominator per slot
//   gsum   — stride agg_n: Σ(w·rt_i(arg)) per agg slot (i64 → exact inverse, no
//            float drift; matches the slice-1 i64-value constraint). count slots
//            carry an unused 0; avg slots carry the numerator Σ(w·arg).
//   live   — gcount>0 (the group currently has an emitted output row)
//   idx    — rt_key_hash(key) -> slots (rt_eq verify on collision), the group
//            probe index (mirrors zout's bucket+verify pattern).
//   vbest  — stride agg_n: cached extremum per (slot,agg) for SEMILATTICE
//            min/max columns (fnid 3/4). A placeholder 0 while the slot's
//            vmap is empty (never read then); the first live insert sets it.
//   vmap   — stride agg_n: value→live-multiplicity map per (slot,agg) for
//            min/max columns. `vmap[v] = Σw` of live rows carrying value `v`
//            in that group; a key is dropped when its count reaches 0. On
//            retracting the current best to 0 we RESCAN this group's live
//            keys (only) for the next extremum (ADR 0013 §3.1, slice-4).
//            INVARIANT: gcount>0 ⇔ vmap non-empty ⇔ vbest valid (for min/max
//            columns); gcount is the single liveness/empty driver for all algebras.
pub struct AggState {
    keyv:   Vec<RtVal>,
    gcount: Vec<i64>,
    gsum:   Vec<i64>,
    live:   Vec<bool>,
    idx:    HashMap<u64, Vec<i64>>,
    vbest:  Vec<i64>,
    vmap:   Vec<HashMap<i64, i64>>,
}
fn aggstate_new() -> AggState {
    return AggState {
        keyv: vec_new::<RtVal>(), gcount: vec_new::<i64>(), gsum: vec_new::<i64>(),
        live: vec_new::<bool>(), idx: hashmap_new::<u64, Vec<i64>>(),
        vbest: vec_new::<i64>(), vmap: vec_new::<HashMap<i64, i64>>(),
    };
}
// Group slot of key `k`, or -1 (rt_key_hash bucket + rt_eq verify).
fn aggstate_find(agg: &AggState, k: RtVal) -> i64 {
    let h: u64 = rt_key_hash(k);
    let mp: *mut HashMap<u64, Vec<i64>> =
        (&agg.idx as *const HashMap<u64, Vec<i64>>) as *mut HashMap<u64, Vec<i64>>;
    let bp: *const Vec<i64> = unsafe { mp.get(&h) };
    if (bp as i64) == 0i64 { return -1i64; }
    let bucket: &Vec<i64> = unsafe { &*bp };
    let nb: i64 = bucket.len();
    let mut t: i64 = 0i64;
    while t < nb {
        let o: i64 = bucket.get(t);
        if rt_eq(agg.keyv.get(o), k) { return o; }
        t = t + 1i64;
    }
    return -1i64;
}
// Ensure a slot for key `k` (created zeroed, live=false, gsum stride `n`).
// String keys are interned into `arena` so the group row stays self-contained.
fn aggstate_ensure(agg: &mut AggState, k: RtVal, n: i64, arena: &Writ) -> i64 {
    let existing: i64 = aggstate_find(agg, k);
    if existing >= 0i64 { return existing; }
    let slot: i64 = agg.gcount.len();
    let h: u64 = rt_key_hash(k);
    let mp: *mut HashMap<u64, Vec<i64>> = &mut agg.idx;
    unsafe {
        let vp: *mut Vec<i64> = mp.get_or_insert(h, vec_new::<i64>());
        (&mut *vp).push(slot);
    }
    let ki: RtVal = match k {
        RtVal::S(s) => { RtVal::S(intern_str(arena, s)) }
        _ => { k }
    };
    agg.keyv.push(ki);
    agg.gcount.push(0i64);
    agg.live.push(false);
    let mut i: i64 = 0i64;
    while i < n {
        agg.gsum.push(0i64);
        agg.vbest.push(0i64);                        // placeholder (unread while vmap empty)
        agg.vmap.push(hashmap_new::<i64, i64>());    // SEMILATTICE value→live-count map
        i = i + 1i64;
    }
    return slot;
}

// The maintained OUTPUT Z-set, keyed on the canonical projected tuple.
//   cells — stride ncols (interned strings, self-contained)
//   wt    — bag multiplicity per distinct tuple
//   memb  — set membership, maintained on multiplicity CROSSING (set mode)
//   idx   — canon-row hash -> slots (rt_eq verify on collision).
pub struct ZOut {
    ncols: i64,
    cells: Vec<RtVal>,
    wt:    Vec<i64>,
    memb:  Vec<bool>,
    idx:   HashMap<u64, Vec<i64>>,
    // Error-returning EL policy (incremental): set true when a projected cell
    // evaluated to RtVal::Error (integer overflow / division by zero). Surfaced
    // by the engine's `had_error()` (the harness checks it after an epoch);
    // never traps the host.
    math_err: bool,
}
fn zout_new(nc: i64) -> ZOut {
    return ZOut {
        ncols: nc, cells: vec_new::<RtVal>(), wt: vec_new::<i64>(),
        memb: vec_new::<bool>(), idx: hashmap_new::<u64, Vec<i64>>(),
        math_err: false,
    };
}

// FNV fold over a row slice cells[off .. off+nc] (the exec_root Distinct hash).
fn zrow_hash(cells: &Vec<RtVal>, off: i64, nc: i64) -> u64 {
    let mut h: u64 = 1469598103934665603u64;
    let mut c: i64 = 0i64;
    while c < nc { h = h_step(h, rt_key_hash(cells.get(off + c))); c = c + 1i64; }
    return h;
}

// Find the slot of row cells[off..] in `z`; -1 if absent (rt_eq bucket verify).
fn zout_find(zp: *mut ZOut, cells: &Vec<RtVal>, off: i64) -> i64 {
    let z: &ZOut = unsafe { &*zp };
    let nc: i64 = z.ncols;
    let h: u64 = zrow_hash(cells, off, nc);
    let mp: *mut HashMap<u64, Vec<i64>> = unsafe { &mut (&mut *zp).idx };
    let bp: *const Vec<i64> = unsafe { mp.get(&h) };
    if (bp as i64) == 0i64 { return -1i64; }
    let bucket: &Vec<i64> = unsafe { &*bp };
    let nb: i64 = bucket.len();
    let mut t: i64 = 0i64;
    while t < nb {
        let o: i64 = bucket.get(t);
        let mut same: bool = true;
        let mut c2: i64 = 0i64;
        while c2 < nc {
            if !rt_eq(z.cells.get(o * nc + c2), cells.get(off + c2)) { same = false; break; }
            c2 = c2 + 1i64;
        }
        if same { return o; }
        t = t + 1i64;
    }
    return -1i64;
}

// Ensure a slot exists for row cells[off..] (created with wt 0, memb false);
// interns string cells into `arena` so the row is self-contained. Returns slot.
fn zout_upsert(zp: *mut ZOut, arena: &Writ, cells: &Vec<RtVal>, off: i64) -> i64 {
    let existing: i64 = zout_find(zp, cells, off);
    if existing >= 0i64 { return existing; }
    let z: &mut ZOut = unsafe { &mut *zp };
    let nc: i64 = z.ncols;
    let slot: i64 = z.wt.len();
    let h: u64 = zrow_hash(cells, off, nc);
    let mp: *mut HashMap<u64, Vec<i64>> = &mut z.idx;
    unsafe {
        let vp: *mut Vec<i64> = mp.get_or_insert(h, vec_new::<i64>());
        (&mut *vp).push(slot);
    }
    let mut c: i64 = 0i64;
    while c < nc {
        let v: RtVal = cells.get(off + c);
        match v {
            RtVal::S(s) => { z.cells.push(RtVal::S(intern_str(arena, s))); }
            _ => { z.cells.push(v); }
        }
        c = c + 1i64;
    }
    z.wt.push(0i64);
    z.memb.push(false);
    return slot;
}

// Error-returning EL policy (incremental): flag the scratch ZOut when any
// projected cell evaluated to RtVal::Error (integer overflow / div-by-zero).
// The flag rides the scratch delta into the persistent engine (out_apply /
// epoch), where `had_error()` reads it — never a host trap.
fn zout_note_errs(zp: *mut ZOut, cells: &Vec<RtVal>) {
    let n: i64 = cells.len();
    let mut i: i64 = 0i64;
    while i < n {
        if rt_is_err(cells.get(i)) { let z: &mut ZOut = unsafe { &mut *zp }; z.math_err = true; return; }
        i = i + 1i64;
    }
}

// RProj weight-coalesce (§10.4): Δout[π(t)] += w, ADDITIVE (never 1:1).
fn zout_bump(zp: *mut ZOut, arena: &Writ, cells: &Vec<RtVal>, off: i64, w: i64) {
    if w == 0i64 { return; }
    let slot: i64 = zout_upsert(zp, arena, cells, off);
    let z: &mut ZOut = unsafe { &mut *zp };
    z.wt.set(slot, z.wt.get(slot) + w);
}

// Apply a scratch delta `od` into `out`. Bag: wt += dw. Set (has_distinct):
// maintain `memb` on multiplicity CROSSING — <=0→>0 emits +, >0→<=0 emits -
// (§10.4 RDistinct crossing, NOT w>0).
fn out_apply(outp: *mut ZOut, arena: &Writ, odp: *const ZOut, has_distinct: bool) {
    let od: &ZOut = unsafe { &*odp };
    // Latch a scratch-delta math error into the persistent out (had_error reads it).
    if od.math_err { let op: &mut ZOut = unsafe { &mut *outp }; op.math_err = true; }
    let nc: i64 = od.ncols;
    let n: i64 = od.wt.len();
    let mut i: i64 = 0i64;
    while i < n {
        let dw: i64 = od.wt.get(i);
        if dw != 0i64 {
            let slot: i64 = zout_upsert(outp, arena, &od.cells, i * nc);
            let out: &mut ZOut = unsafe { &mut *outp };
            let old: i64 = out.wt.get(slot);
            let neww: i64 = old + dw;
            out.wt.set(slot, neww);
            if has_distinct {
                if old <= 0i64 && neww > 0i64 { out.memb.set(slot, true); }
                else if old > 0i64 && neww <= 0i64 { out.memb.set(slot, false); }
            }
        }
        i = i + 1i64;
    }
}

// Compute the join key of one node by evaluating `kexpr_w` with `var` bound.
// The key expr references ONLY its own scan var (analyze_join_step's build/
// probe split), so a single-var RBinds suffices.
fn ij_key(kexpr_w: i64, var: str, node: WAny, cat: &SchemaCatalog, env: &QEnv,
          scratch: &Writ) -> RtVal {
    let mut b: RBinds = rbinds_new();
    b.bind_val(var, RtVal::Node(node));
    let bp: *const RBinds = &b;
    return eval_sexpr(sx_of(kexpr_w), cat, env, bp, scratch);
}

// One surviving join pair (aNode ⋈ bNode, weight w) → filter → project →
// coalesce into `od`. Residual = every ON conjunct except the consumed equi
// term (the key equality was already rt_eq-verified by the caller).
fn ij_emit(odp: *mut ZOut, arena: &Writ, a_node: WAny, b_node: WAny, w: i64,
           lvar: str, rvar: str, on_w: i64, equi_w: i64, has_pred: bool, pred_w: i64,
           sel_w: i64, cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    if w == 0i64 { return; }
    let mut cb: RBinds = rbinds_new();
    cb.bind_val(lvar, RtVal::Node(a_node));
    cb.bind_val(rvar, RtVal::Node(b_node));
    let cbp: *const RBinds = &cb;
    if !eval_on_residual(on_w, equi_w, cat, env, cbp, scratch) { return; }
    if has_pred {
        if !rt_truthy(eval_sexpr(sx_of(pred_w), cat, env, cbp, scratch)) { return; }
    }
    let sel: SExpr = sx_of(sel_w);
    let mut cells: Vec<RtVal> = vec_new::<RtVal>();
    match sel {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let nn: i64 = items.len();
            let mut c: i64 = 0i64;
            while c < nn { cells.push(eval_sexpr(items.arg_at(c), cat, env, cbp, scratch)); c = c + 1i64; }
        }
        _ => { cells.push(eval_sexpr(sel, cat, env, cbp, scratch)); }
    }
    zout_note_errs(odp, &cells);
    zout_bump(odp, arena, &cells, 0i64, w);
}

// One bilinear join term: stream (lnodes,lwts,lkeys) against arranged `right`.
// leftIsA=true ⇒ left rows bind the A/left var and `right` binds B/right; false
// ⇒ swapped (left=ΔB binds rvar, right=A_int binds lvar). Weights MULTIPLY.
fn ij_join_term(odp: *mut ZOut, arena: &Writ,
                lnodes: &Vec<WAny>, lwts: &Vec<i64>, lkeys: &Vec<RtVal>,
                right: &Arr, left_is_a: bool,
                lvar: str, rvar: str, on_w: i64, equi_w: i64,
                has_pred: bool, pred_w: i64, sel_w: i64,
                cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    let rp: *mut HashMap<u64, Vec<i64>> =
        (&right.idx as *const HashMap<u64, Vec<i64>>) as *mut HashMap<u64, Vec<i64>>;
    let n: i64 = lnodes.len();
    let mut i: i64 = 0i64;
    while i < n {
        let wl: i64 = lwts.get(i);
        if wl != 0i64 {
            let kl: RtVal = lkeys.get(i);
            let hp: u64 = rt_key_hash(kl);
            let bp: *const Vec<i64> = unsafe { rp.get(&hp) };
            if (bp as i64) != 0i64 {
                let bucket: &Vec<i64> = unsafe { &*bp };
                let nb: i64 = bucket.len();
                let mut t: i64 = 0i64;
                while t < nb {
                    let j: i64 = bucket.get(t);
                    let wr: i64 = right.wt.get(j);
                    if wr != 0i64 && rt_eq(kl, right.key.get(j)) {
                        let a_node: WAny = if left_is_a { lnodes.get(i) } else { right.node.get(j) };
                        let b_node: WAny = if left_is_a { right.node.get(j) } else { lnodes.get(i) };
                        ij_emit(odp, arena, a_node, b_node, wl * wr,
                                lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, cat, env, scratch);
                    }
                    t = t + 1i64;
                }
            }
        }
        i = i + 1i64;
    }
}

// Anti-output emit: a LEFT-only row (weight w, may be negative) → filter →
// project → coalesce into `od`. No rvar/residual (the anti-output is left-only;
// the where-clause is left-only by the checker). Mirrors ij_emit minus the join.
fn ij_anti_emit(odp: *mut ZOut, arena: &Writ, l_node: WAny, w: i64,
                lvar: str, has_pred: bool, pred_w: i64, sel_w: i64,
                cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    if w == 0i64 { return; }
    let mut cb: RBinds = rbinds_new();
    cb.bind_val(lvar, RtVal::Node(l_node));
    let cbp: *const RBinds = &cb;
    if has_pred {
        if !rt_truthy(eval_sexpr(sx_of(pred_w), cat, env, cbp, scratch)) { return; }
    }
    let sel: SExpr = sx_of(sel_w);
    let mut cells: Vec<RtVal> = vec_new::<RtVal>();
    match sel {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let nn: i64 = items.len();
            let mut c: i64 = 0i64;
            while c < nn { cells.push(eval_sexpr(items.arg_at(c), cat, env, cbp, scratch)); c = c + 1i64; }
        }
        _ => { cells.push(eval_sexpr(sel, cat, env, cbp, scratch)); }
    }
    zout_note_errs(odp, &cells);
    zout_bump(odp, arena, &cells, 0i64, w);
}

// Aggregate group-row emit (DBSP slice-3): one group row (key + agg values,
// weight w which may be −1 on retraction) → optional HAVING → project → coalesce
// into `od`. Mirrors ij_anti_emit; the group scalars are bound by NAME ("key" +
// each agg's out-name) into RBinds — the EXACT scalar-binding contract the batch
// projection over group rows uses (eval_root resolves bare idents against RBinds).
fn ag_emit(odp: *mut ZOut, arena: &Writ, key: RtVal, aggvals: &Vec<RtVal>, an: i64, w: i64,
           agg_out: &[str], has_pred: bool, pred_w: i64, sel_w: i64,
           cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    if w == 0i64 { return; }
    let mut cb: RBinds = rbinds_new();
    cb.bind_val("key", key);
    let mut i: i64 = 0i64;
    while i < an { cb.bind_val(agg_out[i], aggvals.get(i)); i = i + 1i64; }
    let cbp: *const RBinds = &cb;
    if has_pred {
        if !rt_truthy(eval_sexpr(sx_of(pred_w), cat, env, cbp, scratch)) { return; }
    }
    let sel: SExpr = sx_of(sel_w);
    let mut cells: Vec<RtVal> = vec_new::<RtVal>();
    match sel {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let nn: i64 = items.len();
            let mut c: i64 = 0i64;
            while c < nn { cells.push(eval_sexpr(items.arg_at(c), cat, env, cbp, scratch)); c = c + 1i64; }
        }
        _ => { cells.push(eval_sexpr(sel, cat, env, cbp, scratch)); }
    }
    zout_note_errs(odp, &cells);
    zout_bump(odp, arena, &cells, 0i64, w);
}

// Weighted matchcount of one left row against arranged `b`: Σ_r [key(r)==l_key
// ∧ residual(l,r)]·b.wt[r] over post-integrate `b`. Clone of ij_join_term's
// probe loop MINUS emit. A left key with two supporting depts returns 2 (enters
// the anti-output only at 0). NOT boolean — per (ℓ,r) residual, weighted.
fn ij_matchcount(l_node: WAny, l_key: RtVal, b: &Arr,
                 on_w: i64, equi_w: i64, lvar: str, rvar: str,
                 cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) -> i64 {
    let rp: *mut HashMap<u64, Vec<i64>> =
        (&b.idx as *const HashMap<u64, Vec<i64>>) as *mut HashMap<u64, Vec<i64>>;
    let hp: u64 = rt_key_hash(l_key);
    let bp: *const Vec<i64> = unsafe { rp.get(&hp) };
    let mut mc: i64 = 0i64;
    if (bp as i64) != 0i64 {
        let bucket: &Vec<i64> = unsafe { &*bp };
        let nb: i64 = bucket.len();
        let mut t: i64 = 0i64;
        while t < nb {
            let j: i64 = bucket.get(t);
            let wr: i64 = b.wt.get(j);
            if wr != 0i64 && rt_eq(l_key, b.key.get(j)) {
                let mut cb: RBinds = rbinds_new();
                cb.bind_val(lvar, RtVal::Node(l_node));
                cb.bind_val(rvar, RtVal::Node(b.node.get(j)));
                let cbp: *const RBinds = &cb;
                if eval_on_residual(on_w, equi_w, cat, env, cbp, scratch) { mc = mc + wr; }
            }
            t = t + 1i64;
        }
    }
    return mc;
}

// The ΔA ⋈ ΔB cross term (nested loop; deltas are small). Index-free so it
// never touches the arrangements — the §8.2 double-count trap is avoided by
// computing this BEFORE integrating either delta.
fn ij_cross_term(odp: *mut ZOut, arena: &Writ,
                 an: &Vec<WAny>, awt: &Vec<i64>, akey: &Vec<RtVal>,
                 bn: &Vec<WAny>, bwt: &Vec<i64>, bkey: &Vec<RtVal>,
                 lvar: str, rvar: str, on_w: i64, equi_w: i64,
                 has_pred: bool, pred_w: i64, sel_w: i64,
                 cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    let na: i64 = an.len();
    let nb: i64 = bn.len();
    let mut i: i64 = 0i64;
    while i < na {
        let wl: i64 = awt.get(i);
        if wl != 0i64 {
            let kl: RtVal = akey.get(i);
            let mut j: i64 = 0i64;
            while j < nb {
                let wr: i64 = bwt.get(j);
                if wr != 0i64 && rt_eq(kl, bkey.get(j)) {
                    ij_emit(odp, arena, an.get(i), bn.get(j), wl * wr,
                            lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, cat, env, scratch);
                }
                j = j + 1i64;
            }
        }
        i = i + 1i64;
    }
}

// Integrate a ±delta into an arrangement by identity (§8.2 step 5). Existing
// identity ⇒ wt += w (no index change; key unchanged). New identity ⇒ append a
// slot, compute + index its key. Zero-weight slots survive (skipped by joins);
// no Vec deletion, so `id`/`idx` slots stay stable across epochs.
fn ij_integrate(arr: &mut Arr, delta: &ZBatch, keyw: i64, var: str,
                cat: &SchemaCatalog, env: &QEnv, scratch: &Writ) {
    let n: i64 = delta.node.len();
    let mut i: i64 = 0i64;
    while i < n {
        let w: i64 = delta.wt.get(i);
        if w != 0i64 {
            let node: WAny = delta.node.get(i);
            let rawu: u64 = node.raw() as u64;
            let idp: *mut HashMap<u64, i64> = &mut arr.id;
            let sp: *const i64 = unsafe { idp.get(&rawu) };
            if (sp as i64) != 0i64 {
                let slot: i64 = unsafe { *sp };
                arr.wt.set(slot, arr.wt.get(slot) + w);
            } else {
                let slot: i64 = arr.node.len();
                let key: RtVal = ij_key(keyw, var, node, cat, env, scratch);
                arr.node.push(node);
                arr.wt.push(w);
                arr.key.push(key);
                arr.mc.push(-1i64);   // uncomputed sentinel (anti mode fills lazily)
                unsafe { let _q: *mut i64 = idp.get_or_insert(rawu, slot); }
                let hp: u64 = rt_key_hash(key);
                let ixp: *mut HashMap<u64, Vec<i64>> = &mut arr.idx;
                unsafe {
                    let vp: *mut Vec<i64> = ixp.get_or_insert(hp, vec_new::<i64>());
                    (&mut *vp).push(slot);
                }
            }
        }
        i = i + 1i64;
    }
}

// A +1/identity ZBatch over every element of a bound source array (base fill).
fn ij_batch_from_source(src: WAny) -> ZBatch {
    let mut b: ZBatch = ZBatch::new();
    if !src.is_array() { return b; }
    let a: &WArray<WAny> = src.as_array();
    let n: i64 = a.len();
    let mut i: i64 = 0i64;
    while i < n { b.push(a.get(i), 1i64); i = i + 1i64; }
    return b;
}

// ── IncrJoin — the maintained engine (arrangements + out state + frozen plan) ─
pub struct IncrJoin {
    arena: Writ,             // owns interned output-row strings (self-contained)
    a:     Arr,              // A_int (left / probe side)
    b:     Arr,              // B_int (right / build side)
    out:   ZOut,             // out_int
    cat:   SchemaCatalog,    // catalog snapshot (eval_sexpr needs it)
    envp:  i64,             // *const QEnv — param lookups only (row vars come
                             // from RBinds); the caller keeps the env alive
    on_w:   i64,
    equi_w: i64,
    build_w: i64,            // qp.jbuild (right/new-side key)
    probe_w: i64,            // qp.jprobe (left/bound-side key)
    pred_w:  i64,
    has_pred: bool,
    sel_w:   i64,
    lvar:    str,
    rvar:    str,
    has_distinct: bool,      // top RExpr::Distinct present -> set mode
    is_anti: bool,           // top step is `anti join` -> matchcount/crossing mode
    ncols:  i64,
    ckind:  [i32; 8],
    // ── slice-3: incremental GROUP aggregation (single top-level scan) ──
    is_aggr:   bool,         // top step is `group by … aggregate …` -> AggState path
    agg_n:     i64,          // number of aggregate columns
    agg_fnid:  [i32; 8],     // AGG_* id per column (1 count / 2 sum / 5 avg — GROUP)
    agg_arg_w: [i64; 8],     // raw SExpr of each agg's arg (0 for count / has_arg=false)
    agg_out:   [str; 8],     // bound out-name of each agg column (projection reads it)
    key_w:     i64,          // raw SExpr of the group key (evaluated per scan row)
    agg:       AggState,     // the maintained per-group accumulators (a/b unused here)
    // Error-returning EL policy: latched when any per-epoch key/projection cell
    // evaluated to RtVal::Error (overflow / div-by-zero). Read via had_error();
    // never traps the host.
    math_err:  bool,
}

impl IncrJoin {
    // One epoch: admit (da over the LEFT source, db over the RIGHT source),
    // compute the netted output delta, apply it, THEN integrate (§8.2).
    pub fn epoch(self: &mut IncrJoin, da: &ZBatch, db: &ZBatch) {
        // slice-3: GROUP aggregation is a SINGLE-SCAN operator — consume only `da`
        // (the scan source); `db` is ignored (no second source in this fragment).
        if self.is_aggr { self.ag_run(da); return; }
        // Raw handle to the engine's math-error latch (set below on a key error),
        // captured BEFORE the shared `&self.cat` borrow so the two don't conflict.
        let mep: *mut bool = &mut self.math_err;
        let cat: &SchemaCatalog = &self.cat;
        let env: &QEnv = unsafe { &*(self.envp as *const QEnv) };
        let scratch: Writ = writ_new(2048i64);
        let on_w: i64 = self.on_w; let equi_w: i64 = self.equi_w;
        let build_w: i64 = self.build_w; let probe_w: i64 = self.probe_w;
        let pred_w: i64 = self.pred_w; let has_pred: bool = self.has_pred;
        let sel_w: i64 = self.sel_w; let lvar: str = self.lvar; let rvar: str = self.rvar;
        let has_distinct: bool = self.has_distinct;

        // Δ keys: ΔA via probe_w (left var), ΔB via build_w (right var).
        let mut dakeys: Vec<RtVal> = vec_new::<RtVal>();
        let mut ia: i64 = 0i64;
        while ia < da.node.len() {
            let kva: RtVal = ij_key(probe_w, lvar, da.node.get(ia), cat, env, &scratch);
            if rt_is_err(kva) { unsafe { *mep = true; } }
            dakeys.push(kva);
            ia = ia + 1i64;
        }
        let mut dbkeys: Vec<RtVal> = vec_new::<RtVal>();
        let mut ib: i64 = 0i64;
        while ib < db.node.len() {
            let kvb: RtVal = ij_key(build_w, rvar, db.node.get(ib), cat, env, &scratch);
            if rt_is_err(kvb) { unsafe { *mep = true; } }
            dbkeys.push(kvb);
            ib = ib + 1i64;
        }

        // ── ANTI PATH (§10.4): matchcount maintenance + 0↔>0 crossing emit ──
        if self.is_anti {
            let mut oda: ZOut = zout_new(self.ncols);
            let odap: *mut ZOut = &mut oda;

            // PHASE 1 — ΔB crossings over the EXISTING left population, using the
            // PRE-ΔA left weight and PRE-ΔB matchcount. Accumulate Δmc per touched
            // left slot (slot-indexed scratch, applied ONCE — never per db entry).
            let nla: i64 = self.a.node.len();
            let mut dmc: Vec<i64> = vec_new::<i64>();
            let mut seen: Vec<bool> = vec_new::<bool>();
            let mut zi: i64 = 0i64;
            while zi < nla { dmc.push(0i64); seen.push(false); zi = zi + 1i64; }
            let mut touched: Vec<i64> = vec_new::<i64>();
            let ap_idx: *mut HashMap<u64, Vec<i64>> =
                (&self.a.idx as *const HashMap<u64, Vec<i64>>) as *mut HashMap<u64, Vec<i64>>;
            let nbd: i64 = db.node.len();
            let mut bj: i64 = 0i64;
            while bj < nbd {
                let wb: i64 = db.wt.get(bj);
                if wb != 0i64 {
                    let kb: RtVal = dbkeys.get(bj);
                    let hp: u64 = rt_key_hash(kb);
                    let bp: *const Vec<i64> = unsafe { ap_idx.get(&hp) };
                    if (bp as i64) != 0i64 {
                        let bucket: &Vec<i64> = unsafe { &*bp };
                        let nbk: i64 = bucket.len();
                        let mut t: i64 = 0i64;
                        while t < nbk {
                            let ls: i64 = bucket.get(t);
                            // NOTE: maintain mc for ALL key-matching left slots,
                            // incl. wt==0 (else a re-inserted row reads stale mc in
                            // Phase 3). The crossing emit at wt==0 is a no-op.
                            if rt_eq(kb, self.a.key.get(ls)) {
                                let mut cb: RBinds = rbinds_new();
                                cb.bind_val(lvar, RtVal::Node(self.a.node.get(ls)));
                                cb.bind_val(rvar, RtVal::Node(db.node.get(bj)));
                                let cbp: *const RBinds = &cb;
                                if eval_on_residual(on_w, equi_w, cat, env, cbp, &scratch) {
                                    if !seen.get(ls) { seen.set(ls, true); touched.push(ls); }
                                    dmc.set(ls, dmc.get(ls) + wb);
                                }
                            }
                            t = t + 1i64;
                        }
                    }
                }
                bj = bj + 1i64;
            }
            let nt: i64 = touched.len();
            let mut tj: i64 = 0i64;
            while tj < nt {
                let ls: i64 = touched.get(tj);
                let old: i64 = self.a.mc.get(ls);
                let neww: i64 = old + dmc.get(ls);
                if old == 0i64 && neww > 0i64 {
                    // new match ⇒ left LEAVES (−left, at PRE-ΔA weight)
                    ij_anti_emit(odap, &self.arena, self.a.node.get(ls), 0i64 - self.a.wt.get(ls),
                                 lvar, has_pred, pred_w, sel_w, cat, env, &scratch);
                } else {
                    if old > 0i64 && neww == 0i64 {
                        // last match retracted ⇒ left ENTERS (+left, at PRE-ΔA weight)
                        ij_anti_emit(odap, &self.arena, self.a.node.get(ls), self.a.wt.get(ls),
                                     lvar, has_pred, pred_w, sel_w, cat, env, &scratch);
                    }
                }
                self.a.mc.set(ls, neww);
                tj = tj + 1i64;
            }

            // PHASE 2 — INTEGRATE (after Phase-1 compute). Right FIRST: Phase 3's
            // matchcount probes post-ΔB `b`. New left slots get mc = −1 sentinel.
            ij_integrate(&mut self.b, db, build_w, rvar, cat, env, &scratch);
            ij_integrate(&mut self.a, da, probe_w, lvar, cat, env, &scratch);

            // PHASE 3 — ΔA gated by CURRENT (post-ΔB) matchcount. A new left copy
            // appears in the anti-output only if its key has matchcount==0.
            let nad: i64 = da.node.len();
            let mut ai: i64 = 0i64;
            while ai < nad {
                let wa: i64 = da.wt.get(ai);
                if wa != 0i64 {
                    let dn: WAny = da.node.get(ai);
                    let rawu: u64 = dn.raw() as u64;
                    let idp: *mut HashMap<u64, i64> =
                        (&self.a.id as *const HashMap<u64, i64>) as *mut HashMap<u64, i64>;
                    let sp: *const i64 = unsafe { idp.get(&rawu) };
                    let s: i64 = unsafe { *sp };   // exists post-integrate
                    if self.a.mc.get(s) < 0i64 {
                        let mcv: i64 = ij_matchcount(dn, dakeys.get(ai), &self.b,
                                                     on_w, equi_w, lvar, rvar, cat, env, &scratch);
                        self.a.mc.set(s, mcv);
                    }
                    if self.a.mc.get(s) == 0i64 {
                        ij_anti_emit(odap, &self.arena, dn, wa,
                                     lvar, has_pred, pred_w, sel_w, cat, env, &scratch);
                    }
                }
                ai = ai + 1i64;
            }

            out_apply(&mut self.out, &self.arena, &oda, has_distinct);
            return;
        }

        // ── COMPUTE ΔJ against the CURRENT (pre-integrate) arrangements ──
        let mut od: ZOut = zout_new(self.ncols);
        let odp: *mut ZOut = &mut od;
        // T1: ΔA ⋈ B_int
        ij_join_term(odp, &self.arena, &da.node, &da.wt, &dakeys, &self.b, true,
                     lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, cat, env, &scratch);
        // T2: A_int ⋈ ΔB   (left = ΔB binds rvar; right = A_int binds lvar)
        ij_join_term(odp, &self.arena, &db.node, &db.wt, &dbkeys, &self.a, false,
                     lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, cat, env, &scratch);
        // T3: ΔA ⋈ ΔB   (the cross term — computed before integrate)
        ij_cross_term(odp, &self.arena, &da.node, &da.wt, &dakeys, &db.node, &db.wt, &dbkeys,
                      lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, cat, env, &scratch);

        // ── APPLY the netted delta into out_int (crossing for set mode) ──
        out_apply(&mut self.out, &self.arena, &od, has_distinct);

        // ── INTEGRATE (AFTER compute) ──
        ij_integrate(&mut self.a, da, probe_w, lvar, cat, env, &scratch);
        ij_integrate(&mut self.b, db, build_w, rvar, cat, env, &scratch);
    }

    // One epoch of incremental GROUP aggregation (DBSP slice-3, ADR 0013 §3.1).
    // Folds `da` into the per-group i64 accumulators (the abelian GROUP inverse
    // makes retraction O(1), no rescan) and stages the group-row Δ into a scratch
    // ZOut, then out_apply (reused verbatim — the aggregate output is a projected
    // tuple ZOut identical in kind to the join/anti output).
    //   • integrate-after-compute: the OLD group tuple is captured BEFORE any
    //     mutation to that slot; −old/+new is derived from old-vs-new.
    //   • emit-once-per-touched-slot (seen/touched): multiple `da` entries hitting
    //     one group stage exactly one −old and one +new (no intra-epoch thrash).
    //   • empty-group DROP: gcount→0 stages ONLY the −old retraction and sets
    //     live=false — never a stale 0-count row, never a +（key,0).
    fn ag_run(self: &mut IncrJoin, da: &ZBatch) {
        // Math-error latch handle (set on a key/arg error), captured before the
        // shared `&self.cat` borrow.
        let mep: *mut bool = &mut self.math_err;
        let cat: &SchemaCatalog = &self.cat;
        let env: &QEnv = unsafe { &*(self.envp as *const QEnv) };
        let scratch: Writ = writ_new(2048i64);
        let n: i64 = self.agg_n;
        let key_w: i64 = self.key_w;
        let lvar: str = self.lvar;
        let has_pred: bool = self.has_pred;
        let pred_w: i64 = self.pred_w;
        let sel_w: i64 = self.sel_w;

        let mut od: ZOut = zout_new(self.ncols);
        let odp: *mut ZOut = &mut od;

        // Per-touched-slot OLD snapshot (captured before mutation) + seen/touched;
        // grown to cover slots created THIS epoch (their OLD is zero/not-live).
        let mut seen:   Vec<bool> = vec_new::<bool>();
        let mut old_gc: Vec<i64>  = vec_new::<i64>();
        let mut old_lv: Vec<bool> = vec_new::<bool>();
        let mut old_gs: Vec<i64>  = vec_new::<i64>();   // stride n (GROUP accumulator)
        let mut old_best: Vec<i64> = vec_new::<i64>();  // stride n (SEMILATTICE pre-epoch best)
        let mut touched: Vec<i64> = vec_new::<i64>();

        let nd: i64 = da.node.len();
        let mut di: i64 = 0i64;
        while di < nd {
            let w: i64 = da.wt.get(di);
            if w != 0i64 {
                let node: WAny = da.node.get(di);
                let mut kb: RBinds = rbinds_new();
                kb.bind_val(lvar, RtVal::Node(node));
                let kbp: *const RBinds = &kb;
                let k: RtVal = eval_sexpr(sx_of(key_w), cat, env, kbp, &scratch);
                if rt_is_err(k) { unsafe { *mep = true; } }
                let slot: i64 = aggstate_ensure(&mut self.agg, k, n, &self.arena);
                // grow the OLD/seen scratch to cover `slot`
                while seen.len() <= slot {
                    seen.push(false);
                    old_gc.push(0i64);
                    old_lv.push(false);
                    let mut gi: i64 = 0i64;
                    while gi < n { old_gs.push(0i64); old_best.push(0i64); gi = gi + 1i64; }
                }
                if !seen.get(slot) {
                    seen.set(slot, true);
                    touched.push(slot);
                    old_gc.set(slot, self.agg.gcount.get(slot));
                    old_lv.set(slot, self.agg.live.get(slot));
                    let mut gi2: i64 = 0i64;
                    while gi2 < n {
                        old_gs.set(slot * n + gi2, self.agg.gsum.get(slot * n + gi2));
                        old_best.set(slot * n + gi2, self.agg.vbest.get(slot * n + gi2));
                        gi2 = gi2 + 1i64;
                    }
                }
                // MUTATE (= integrate): gcount += w; per sum/avg slot gsum += w·arg.
                self.agg.gcount.set(slot, self.agg.gcount.get(slot) + w);
                let mut ai: i64 = 0i64;
                while ai < n {
                    let fnid: i32 = self.agg_fnid[ai];
                    if fnid == 2i32 || fnid == 5i32 {
                        let av: RtVal = eval_sexpr(sx_of(self.agg_arg_w[ai]), cat, env, kbp, &scratch);
                        if rt_is_err(av) { unsafe { *mep = true; } }
                        let cur: i64 = self.agg.gsum.get(slot * n + ai);
                        // checked accumulation: a running-total overflow latches
                        // math_err (surfaced via had_error()), not a trap.
                        let prod: i64 = match w.checked_mul(rt_i(av)) { Option::Some(p) => { p } Option::None => { unsafe { *mep = true; } 0i64 } };
                        let tot:  i64 = match cur.checked_add(prod)   { Option::Some(t) => { t } Option::None => { unsafe { *mep = true; } cur } };
                        self.agg.gsum.set(slot * n + ai, tot);
                    } else if fnid == 3i32 || fnid == 4i32 {
                        // SEMILATTICE min/max (ADR 0013 §3.1, slice-4): maintain a
                        // value→live-multiplicity map + cached best; O(1) improve on
                        // insert, rescan this group's live keys on best-retraction.
                        let av: i64 = rt_i(eval_sexpr(sx_of(self.agg_arg_w[ai]), cat, env, kbp, &scratch));
                        let mp: *mut HashMap<i64, i64> = unsafe { self.agg.vmap.at(slot * n + ai) };
                        let cp: *const i64 = unsafe { mp.get(&av) };
                        let cur: i64 = if (cp as i64) == 0i64 { 0i64 } else { unsafe { *cp } };
                        let nc: i64 = cur + w;                       // valcount[v] += w
                        let mut removed_best: bool = false;
                        if nc <= 0i64 {
                            unsafe { mp.remove(&av); }               // value fully retracted
                            // compare against the best BEFORE any mutation to it below
                            if self.agg.vbest.get(slot * n + ai) == av { removed_best = true; }
                        } else {
                            unsafe { mp.insert(av, nc); }            // upsert (overwrites)
                        }
                        // best update on a value NEWLY present (0→>0, incl. re-add):
                        if nc > 0i64 && cur <= 0i64 {
                            let mlen: i64 = unsafe { (&*(mp as *const HashMap<i64, i64>)).len() };
                            if mlen == 1i64 {
                                self.agg.vbest.set(slot * n + ai, av);       // first live value = best
                            } else if (fnid == 3i32 && av < self.agg.vbest.get(slot * n + ai))
                                   || (fnid == 4i32 && av > self.agg.vbest.get(slot * n + ai)) {
                                self.agg.vbest.set(slot * n + ai, av);       // O(1) improve (meet/join)
                            }
                        }
                        if removed_best {
                            // ── RE-MIN / RE-MAX (trap 1): rescan THIS group/col's
                            //    live keys only (never the whole relation). Empty ⇒
                            //    group emptying ⇒ gcount hits 0 ⇒ empty-drop handles it,
                            //    vbest left stale-but-unread (+new suppressed).
                            // DEFERRED OPT: an ordered structure (BTree/heap) gives an
                            //    O(log n) rescan — not built now (correctness-first).
                            let mpc: *const HashMap<i64, i64> = unsafe { self.agg.vmap.at(slot * n + ai) } as *const HashMap<i64, i64>;
                            if unsafe { (&*mpc).len() } > 0i64 {
                                let mut nb: i64 = if fnid == 3i32 { 9223372036854775807i64 } else { -9223372036854775807i64 - 1i64 };
                                let mut kit: HashMapKeys<i64, i64> = unsafe { mpc.keys() };
                                loop {
                                    match kit.next() {
                                        Option::Some(kp) => {
                                            let kv: i64 = *kp;
                                            if fnid == 3i32 { if kv < nb { nb = kv; } }
                                            else            { if kv > nb { nb = kv; } }
                                        }
                                        Option::None => { break; }
                                    }
                                }
                                self.agg.vbest.set(slot * n + ai, nb);
                            }
                        }
                    }
                    ai = ai + 1i64;
                }
            }
            di = di + 1i64;
        }

        // Stage the group-row deltas (−old if it was live, +new if still non-empty).
        let nt: i64 = touched.len();
        let mut tj: i64 = 0i64;
        while tj < nt {
            let slot: i64 = touched.get(tj);
            let key: RtVal = self.agg.keyv.get(slot);
            if old_lv.get(slot) {
                let mut oldvals: Vec<RtVal> = vec_new::<RtVal>();
                let mut oi: i64 = 0i64;
                while oi < n {
                    let fnid: i32 = self.agg_fnid[oi];
                    if fnid == 1i32 {
                        oldvals.push(RtVal::I(old_gc.get(slot)));
                    } else if fnid == 5i32 {
                        oldvals.push(RtVal::F((old_gs.get(slot * n + oi) as f64) / (old_gc.get(slot) as f64)));
                    } else if fnid == 3i32 || fnid == 4i32 {
                        oldvals.push(RtVal::I(old_best.get(slot * n + oi)));   // pre-epoch extremum
                    } else {
                        oldvals.push(RtVal::I(old_gs.get(slot * n + oi)));
                    }
                    oi = oi + 1i64;
                }
                ag_emit(odp, &self.arena, key, &oldvals, n, 0i64 - 1i64,
                        &self.agg_out, has_pred, pred_w, sel_w, cat, env, &scratch);
            }
            let newc: i64 = self.agg.gcount.get(slot);
            if newc > 0i64 {
                let mut newvals: Vec<RtVal> = vec_new::<RtVal>();
                let mut ni: i64 = 0i64;
                while ni < n {
                    let fnid: i32 = self.agg_fnid[ni];
                    if fnid == 1i32 {
                        newvals.push(RtVal::I(newc));
                    } else if fnid == 5i32 {
                        newvals.push(RtVal::F((self.agg.gsum.get(slot * n + ni) as f64) / (newc as f64)));
                    } else if fnid == 3i32 || fnid == 4i32 {
                        newvals.push(RtVal::I(self.agg.vbest.get(slot * n + ni)));   // post-epoch extremum
                    } else {
                        newvals.push(RtVal::I(self.agg.gsum.get(slot * n + ni)));
                    }
                    ni = ni + 1i64;
                }
                ag_emit(odp, &self.arena, key, &newvals, n, 1i64,
                        &self.agg_out, has_pred, pred_w, sel_w, cat, env, &scratch);
                self.agg.live.set(slot, true);
            } else {
                self.agg.live.set(slot, false);   // empty-group drop (−old already staged)
            }
            tj = tj + 1i64;
        }

        out_apply(&mut self.out, &self.arena, &od, self.has_distinct);
    }

    // Error-returning EL policy: true iff any epoch so far hit a math error
    // (integer overflow / division-by-zero) in a key or projection cell. The
    // harness checks this after epochs; the engine never traps the host. Latches
    // (once true, stays true). Reads both the key latch (self.math_err) and the
    // projection latch propagated into self.out (out_apply).
    pub fn had_error(self: &IncrJoin) -> bool {
        return self.math_err || self.out.math_err;
    }

    // Read the maintained state as a self-contained QRows (compare at
    // quiescence, U3). Set mode: one row per live tuple (memb). Bag mode:
    // `wt` duplicate rows per tuple (multiplicity expanded to match the
    // batch oracle's duplicate output rows).
    pub fn snapshot(self: &IncrJoin) -> QRows {
        let mut rows: QRows = QRows {
            arena: writ_new(1024i64),
            ncols: self.ncols,
            kinds: self.ckind,
            cells: vec_new::<RtVal>(),
            nrows: 0i64,
        };
        let out: &ZOut = &self.out;
        let nc: i64 = out.ncols;
        let n: i64 = out.wt.len();
        let mut i: i64 = 0i64;
        while i < n {
            if self.has_distinct {
                if out.memb.get(i) { ij_push_row(&mut rows, out, i, nc); }
            } else {
                let w: i64 = out.wt.get(i);
                let mut k: i64 = 0i64;
                while k < w { ij_push_row(&mut rows, out, i, nc); k = k + 1i64; }
            }
            i = i + 1i64;
        }
        return rows;
    }
}

// Push out-tuple `slot` into a QRows, re-interning strings into the QRows arena.
fn ij_push_row(rows: &mut QRows, out: &ZOut, slot: i64, nc: i64) {
    let mut c: i64 = 0i64;
    while c < nc {
        let v: RtVal = out.cells.get(slot * nc + c);
        match v {
            RtVal::S(s) => {
                let iv: str = intern_str(&rows.arena, s);
                rows.cells.push(RtVal::S(iv));
            }
            _ => { rows.cells.push(v); }
        }
        c = c + 1i64;
    }
    rows.nrows = rows.nrows + 1i64;
}

impl Query {
    // Build an incremental maintainer for this query against `env`'s base
    // sources. Slice-1 fragment = RScan/RFilter/RProj + one top RJoin; slice-2
    // adds a single top-level RAnti (stateful matchcount, §3/§10.4). Returns Err
    // (an error VALUE) if the plan is outside that: any of RSort/RLimit/REdge/
    // RAggr/RFix, a non-Scan join/anti child, a self-join/self-anti, a rel block
    // (reg.n != 0), or a non-hash (f64) join key. `env` must stay alive and
    // its base sources must be NON-EMPTY (the join tier resolves off the live
    // element type).
    pub fn incremental(self: &Query, env: &QEnv) -> Result<IncrJoin, QError> {
        if self.empty {
            return Result::Err(qerr("Query::incremental: empty query plan (no rows) — nothing to maintain"));
        }
        // U1: slice-1 is rel-free ⇒ qrel_materialize unreachable; the only
        // dedup point is the top RExpr::Distinct.
        if self.reg.n != 0i64 {
            return Result::Err(qerr("Query::incremental: query has a `rel` block — recursion/rels are out of slice-1"));
        }
        let root: RExpr = WAny::ref_to(self.root as *const u8).view::<RExpr>();
        // ── fragment guard: peel  RDistinct?( RProj( RFilter?( RJoin(Scan,Scan) ) ) ) ──
        let mut has_distinct: bool = false;
        let mut cur: RExpr = root;
        match cur {
            RExpr::Limit(_l)    => { return Result::Err(qerr("Query::incremental: `limit` is out of slice-1")); }
            RExpr::Distinct(d)  => { has_distinct = true; cur = d.input_expr(); }
            _ => { }
        }
        let mut sel_w: i64 = 0i64;
        match cur {
            RExpr::Proj(p) => { sel_w = p.sel.any().raw(); cur = p.input_expr(); }
            _ => { return Result::Err(qerr("Query::incremental: plan has no projection")); }
        }
        let mut has_pred: bool = false;
        let mut pred_w: i64 = 0i64;
        match cur {
            RExpr::Sort(_s)  => { return Result::Err(qerr("Query::incremental: `order by` is out of slice-1")); }
            RExpr::Filter(f) => { has_pred = true; pred_w = f.pred.any().raw(); cur = f.input_expr(); }
            _ => { }
        }
        // The scrutinee is a schema-enum; value-yielding match over one is not
        // supported (statement form only), so extract into mutable locals.
        let mut lvar: str = "";
        let mut rvar: str = "";
        let mut lsrc: str = "";
        let mut rsrc: str = "";
        let mut on_w: i64 = 0i64;
        let mut join_w: i64 = 0i64;
        let mut is_join: bool = false;
        let mut is_anti: bool = false;
        match cur {
            RExpr::Join(jn)  => {
                let mut lok: bool = false;
                let mut rok: bool = false;
                match jn.left_expr()  { RExpr::Scan(s) => { lvar = s.var_name; lsrc = s.src_name; lok = true; } _ => { } }
                match jn.right_expr() { RExpr::Scan(s) => { rvar = s.var_name; rsrc = s.src_name; rok = true; } _ => { } }
                if !lok { return Result::Err(qerr("Query::incremental: the join's left input is not a bare scan")); }
                if !rok { return Result::Err(qerr("Query::incremental: the join's right input is not a bare scan")); }
                on_w = jn.on.any().raw();
                join_w = jn.as_ref().raw();
                is_join = true;
            }
            // slice-2: a single top-level `anti join` (STATEFUL, §3/§10.4). Left/
            // right must be bare scans; self-anti still rejected below (str_eq).
            RExpr::Anti(an) => {
                let mut lok: bool = false;
                let mut rok: bool = false;
                match an.left_expr()  { RExpr::Scan(s) => { lvar = s.var_name; lsrc = s.src_name; lok = true; } _ => { } }
                match an.right_expr() { RExpr::Scan(s) => { rvar = s.var_name; rsrc = s.src_name; rok = true; } _ => { } }
                if !lok { return Result::Err(qerr("Query::incremental: the anti join's left input is not a bare scan")); }
                if !rok { return Result::Err(qerr("Query::incremental: the anti join's right input is not a bare scan")); }
                on_w = an.on.any().raw();
                join_w = an.as_ref().raw();
                is_join = true;
                is_anti = true;
            }
            // slice-3/4: a single top-level GROUP/SEMILATTICE aggregate over ONE
            // bare scan. count/sum/avg = abelian GROUP (O(1) inverse-on-retract);
            // min/max = SEMILATTICE (O(1) improve, rescan-on-best-retract, slice-4).
            // The input MUST be a bare Scan — this implicitly rejects join+aggregate
            // and any pre-group WHERE/RFilter. Mixed GROUP+SEMILATTICE columns in
            // one query are accepted (per-column dispatch on agg_fnid).
            RExpr::Aggr(g) => {
                let mut sok: bool = false;
                match g.input_expr() {
                    RExpr::Scan(s) => { lvar = s.var_name; lsrc = s.src_name; sok = true; }
                    _ => { }
                }
                if !sok {
                    return Result::Err(qerr("Query::incremental: aggregate input is not a bare scan — join/where+aggregate is out of slice-3"));
                }
                // strict check to populate agg_n / agg_fnid / agg_ret + ncols/ckind
                let mut achk: Chk = chk_new();
                let mut aqp: QPlan = qplan_new();
                let mut alb: CBinds = cbinds_new();
                check_rexpr(root, &self.cat, env, true, &mut alb, &mut achk, &mut aqp, &self.reg);
                if achk.failed { return Result::Err(chk_err(achk)); }
                let an: i64 = aqp.agg_n;
                // ALGEBRA GATE — accept abelian-GROUP (1 count / 2 sum / 5 avg) and
                // SEMILATTICE (3 min / 4 max, slice-4) aggregates; reject only UDA
                // (fnid 0 — no inverse, no lattice guarantee). Reuse of
                // rexpr_walk::agg_algebra's classification.
                let mut gi3: i64 = 0i64;
                while gi3 < an {
                    let fnid: i32 = aqp.agg_fnid[gi3];
                    if fnid == 0i32 {
                        return Result::Err(qerr("Query::incremental: UDA aggregate has no inverse/lattice guarantee — out of slice-3/4"));
                    }
                    gi3 = gi3 + 1i64;
                }
                // capture the group key + per-agg fnid / arg-expr / out-name
                let mut afnid: [i32; 8] = [0i32; 8];
                let mut aargw: [i64; 8] = [0i64; 8];
                let mut aout:  [str; 8] = [""; 8];
                let aggs: RAggArr = g.aggs_arr();
                let mut ci2: i64 = 0i64;
                while ci2 < an {
                    let ag: RAgg = aggs.agg_at(ci2);
                    afnid[ci2] = aqp.agg_fnid[ci2];
                    aout[ci2]  = ag.out;
                    if ag.has_arg { aargw[ci2] = ag.arg.any().raw(); }
                    ci2 = ci2 + 1i64;
                }
                let akey_w: i64 = g.key.any().raw();
                let ancols: i64 = aqp.ncols;
                let ackind: [i32; 8] = aqp.ckind;
                // resolve the single source
                let aei: i64 = env.find(lsrc);
                if aei < 0i64 {
                    return Result::Err(qerr("Query::incremental: the aggregate source is not bound on the env"));
                }
                if env.kinds[aei] == QB_TSRC || env.kinds[aei] == QB_EDGE {
                    return Result::Err(qerr("Query::incremental: a tree source (bind_source_tree) is virtual/re-scan — no delta capture; materialize facts via FactStore for the incremental path"));
                }
                let asrcv: WAny = WAny::ref_to(env.words[aei] as *const u8);
                // build the engine (join fields inert; a/b allocated-but-unused)
                let mut eng: IncrJoin = IncrJoin {
                    arena: writ_new(4096i64),
                    a: arr_new(lvar), b: arr_new(""),
                    out: zout_new(ancols),
                    cat: catalog_clone(&self.cat),
                    envp: (env as *const QEnv) as i64,
                    on_w: 0i64, equi_w: 0i64, build_w: 0i64, probe_w: 0i64,
                    pred_w: pred_w, has_pred: has_pred, sel_w: sel_w,
                    lvar: lvar, rvar: "", has_distinct: has_distinct,
                    is_anti: false,
                    ncols: ancols, ckind: ackind,
                    is_aggr: true, agg_n: an, agg_fnid: afnid, agg_arg_w: aargw,
                    agg_out: aout, key_w: akey_w, agg: aggstate_new(),
                    math_err: false,
                };
                // base-fill: +1/identity per source element through the SAME
                // accumulate+emit path (seeds AggState and the initial out).
                let ba: ZBatch = ij_batch_from_source(asrcv);
                eng.ag_run(&ba);
                return Result::Ok(eng);
            }
            RExpr::Edge(_e) => { return Result::Err(qerr("Query::incremental: graph traversal (edge) is out of slice-1")); }
            RExpr::Fix(_x)  => { return Result::Err(qerr("Query::incremental: recursion (fix) is out of slice-1")); }
            _ => { return Result::Err(qerr("Query::incremental: the fragment must be exactly one join of two scans")); }
        }
        if !is_join {
            return Result::Err(qerr("Query::incremental: the fragment must be exactly one join of two scans"));
        }
        // self-join guard (§10.4 — a single ΔA must feed both positions).
        if str_eq(lsrc, rsrc) {
            return Result::Err(qerr("Query::incremental: self-join is out of slice-1"));
        }

        // ── strict check to populate the join plan + projection kinds ──
        let mut chk: Chk = chk_new();
        let mut qp: QPlan = qplan_new();
        let mut lb: CBinds = cbinds_new();
        check_rexpr(root, &self.cat, env, true, &mut lb, &mut chk, &mut qp, &self.reg);
        if chk.failed { return Result::Err(chk_err(chk)); }
        let ji: i64 = qp_jfind(&qp, join_w);
        if ji < 0i64 {
            return Result::Err(qerr("Query::incremental: internal — join node not in the plan"));
        }
        if qp.jtier[ji] != QT_HASH {
            return Result::Err(qerr("Query::incremental: join key is not hash-arrangeable (f64/loop tier) — out of slice-1"));
        }
        let build_w: i64  = qp.jbuild[ji];
        let probe_w: i64  = qp.jprobe[ji];
        let equi_w: i64   = qp.jequi[ji];
        let ncols: i64    = qp.ncols;
        let ckind: [i32; 8] = qp.ckind;

        // ── resolve base sources ──
        let lei: i64 = env.find(lsrc);
        let rei: i64 = env.find(rsrc);
        if lei < 0i64 || rei < 0i64 {
            return Result::Err(qerr("Query::incremental: a join source is not bound on the env"));
        }
        if env.kinds[lei] == QB_TSRC || env.kinds[rei] == QB_TSRC || env.kinds[lei] == QB_EDGE || env.kinds[rei] == QB_EDGE {
            return Result::Err(qerr("Query::incremental: a tree source (bind_source_tree) is virtual/re-scan — no delta capture; materialize facts via FactStore for the incremental path"));
        }
        let lsrcv: WAny = WAny::ref_to(env.words[lei] as *const u8);
        let rsrcv: WAny = WAny::ref_to(env.words[rei] as *const u8);

        // ── build the engine ──
        let mut eng: IncrJoin = IncrJoin {
            arena: writ_new(4096i64),
            a: arr_new(lvar),
            b: arr_new(rvar),
            out: zout_new(ncols),
            cat: catalog_clone(&self.cat),
            envp: (env as *const QEnv) as i64,
            on_w: on_w, equi_w: equi_w, build_w: build_w, probe_w: probe_w,
            pred_w: pred_w, has_pred: has_pred, sel_w: sel_w,
            lvar: lvar, rvar: rvar, has_distinct: has_distinct,
            is_anti: is_anti,
            ncols: ncols, ckind: ckind,
            is_aggr: false, agg_n: 0i64, agg_fnid: [0i32; 8], agg_arg_w: [0i64; 8],
            agg_out: [""; 8], key_w: 0i64, agg: aggstate_new(),
            math_err: false,
        };
        let scratch: Writ = writ_new(2048i64);
        // fill arrangements from the base sources (+1/identity per element)
        let ba: ZBatch = ij_batch_from_source(lsrcv);
        ij_integrate(&mut eng.a, &ba, probe_w, lvar, &eng.cat, env, &scratch);
        let bb: ZBatch = ij_batch_from_source(rsrcv);
        ij_integrate(&mut eng.b, &bb, build_w, rvar, &eng.cat, env, &scratch);
        let mut od0: ZOut = zout_new(ncols);
        if is_anti {
            // base anti-out = { left row : matchcount==0 } over A_int / B_int.
            // Overwrites every left slot's mc eagerly (no −1 sentinel survives).
            let nla: i64 = eng.a.node.len();
            let mut ls: i64 = 0i64;
            while ls < nla {
                let mcv: i64 = ij_matchcount(eng.a.node.get(ls), eng.a.key.get(ls), &eng.b,
                                             on_w, equi_w, lvar, rvar, &eng.cat, env, &scratch);
                eng.a.mc.set(ls, mcv);
                if mcv == 0i64 {
                    ij_anti_emit(&mut od0, &eng.arena, eng.a.node.get(ls), eng.a.wt.get(ls),
                                 lvar, has_pred, pred_w, sel_w, &eng.cat, env, &scratch);
                }
                ls = ls + 1i64;
            }
        } else {
            // base out = A_int ⋈ B_int (one join_term — integrate-order-independent)
            ij_join_term(&mut od0, &eng.arena, &eng.a.node, &eng.a.wt, &eng.a.key, &eng.b, true,
                         lvar, rvar, on_w, equi_w, has_pred, pred_w, sel_w, &eng.cat, env, &scratch);
        }
        out_apply(&mut eng.out, &eng.arena, &od0, has_distinct);
        return Result::Ok(eng);
    }
}
