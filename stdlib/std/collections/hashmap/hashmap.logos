// Logos standard library — std.hashmap
//
// HashMap<K: Hash + Eq, V> — open addressing with linear probing.
// Load factor 0.75, x2 resize. Capacity is always a power of two so
// `hash & (cap - 1)` works as modulo.
//
// Slot state (parallel u8 array):
//   0 = empty, 1 = occupied, 2 = tombstone (deleted).

package std.collections.hashmap;

use std.mem;
use logos.lang.hash;
use logos.lang.cmp;
use std.lang.option;
use std.lang.iter;

let SLOT_EMPTY:     u8 = 0 as u8;
let SLOT_OCCUPIED:  u8 = 1 as u8;
let SLOT_TOMBSTONE: u8 = 2 as u8;

struct Entry<K, V> {
    key: K,
    val: V,
}

pub struct HashMap<K, V> {
    states:  *mut u8,
    entries: *mut Entry<K, V>,
    len:     i64,
    cap:     i64,
}

pub fn hashmap_new<K: Hash + Eq, V>() -> HashMap<K, V> {
    return hashmap_with_capacity::<K, V>(16 as i64);
}

pub fn hashmap_with_capacity<K: Hash + Eq, V>(cap_hint: i64) -> HashMap<K, V> {
    // Round up to next power of two, min 8.
    let mut cap: i64 = 8;
    while cap < cap_hint { cap = cap * 2; }
    let states_raw: *mut u8 = alloc(cap);
    unsafe {
        let mut i: i64 = 0;
        while i < cap { states_raw[i] = SLOT_EMPTY; i = i + 1; }
    }
    let entries_bytes: i64 = cap * sizeof::<Entry<K, V>>();
    let entries_raw: *mut u8 = alloc(entries_bytes);
    return HashMap {
        states:  states_raw,
        entries: entries_raw as *mut Entry<K, V>,
        len:     0 as i64,
        cap:     cap,
    };
}

impl<K: Hash + Eq, V> HashMap<K, V> {
    pub fn len(&self) -> i64 { return self.len; }

    pub fn is_empty(&self) -> bool { return self.len == 0 as i64; }

    pub fn capacity(&self) -> i64 { return self.cap; }

    // Compute starting slot index for a key: hash & (cap - 1).
    fn slot_index(&self, key: &K) -> i64 {
        let mut h: FxHasher = fx_hasher_new();
        key.hash(&mut h);
        let hv: u64 = h.finish();
        let mask: u64 = (self.cap - 1 as i64) as u64;
        return (hv & mask) as i64;
    }

    // Probe for the slot where `key` lives or where it would be inserted.
    // Returns (index, found) where found=true if the key is already there.
    unsafe fn probe(self: *mut HashMap<K, V>, key: &K) -> (i64, bool) {
        let mask: i64 = self.cap - 1 as i64;
        let mut idx: i64 = self.slot_index(key);
        let mut first_tomb: i64 = -1 as i64;
        loop {
            let st: u8 = self.states[idx];
            if st == SLOT_EMPTY {
                if first_tomb >= 0 as i64 { return (first_tomb, false); }
                return (idx, false);
            }
            if st == SLOT_TOMBSTONE {
                if first_tomb < 0 as i64 { first_tomb = idx; }
            } else {
                let e: *mut Entry<K, V> = &mut self.entries[idx];
                if key.eq(&e.key) { return (idx, true); }
            }
            idx = (idx + 1 as i64) & mask;
        }
    }

    pub unsafe fn insert(self: *mut HashMap<K, V>, key: K, val: V) {
        // Resize when load factor exceeds 0.75.
        // (self.len + 1) * 4 > self.cap * 3  ⇔  load > 0.75 after insert.
        if (self.len + 1 as i64) * 4 as i64 > self.cap * 3 as i64 {
            self.resize(self.cap * 2 as i64);
        }
        let (idx, found) = self.probe(&key);
        let e: *mut Entry<K, V> = &mut self.entries[idx];
        if found {
            e.val = val;
        } else {
            e.key = key;
            e.val = val;
            self.states[idx] = SLOT_OCCUPIED;
            self.len = self.len + 1 as i64;
        }
    }

    pub unsafe fn contains_key(self: *mut HashMap<K, V>, key: &K) -> bool {
        let (idx, found) = self.probe(key);
        return found;
    }

    pub unsafe fn get(self: *mut HashMap<K, V>, key: &K) -> *const V {
        let (idx, found) = self.probe(key);
        if !found { return 0 as *const V; }
        let e: *mut Entry<K, V> = &mut self.entries[idx];
        return &e.val as *const V;
    }

    pub unsafe fn get_mut(self: *mut HashMap<K, V>, key: &K) -> *mut V {
        let (idx, found) = self.probe(key);
        if !found { return 0 as *mut V; }
        let e: *mut Entry<K, V> = &mut self.entries[idx];
        return &mut e.val as *mut V;
    }

    pub unsafe fn remove(self: *mut HashMap<K, V>, key: &K) -> bool {
        let (idx, found) = self.probe(key);
        if !found { return false; }
        self.states[idx] = SLOT_TOMBSTONE;
        self.len = self.len - 1 as i64;
        return true;
    }

    pub unsafe fn clear(self: *mut HashMap<K, V>) {
        let mut i: i64 = 0;
        while i < self.cap { self.states[i] = SLOT_EMPTY; i = i + 1; }
        self.len = 0 as i64;
    }

    // Rebuild into a larger table (always a power of two).
    unsafe fn resize(self: *mut HashMap<K, V>, new_cap: i64) {
        let old_states:  *mut u8 = self.states;
        let old_entries: *mut Entry<K, V> = self.entries;
        let old_cap:     i64 = self.cap;

        let new_states: *mut u8 = alloc(new_cap);
        let mut i: i64 = 0;
        while i < new_cap { new_states[i] = SLOT_EMPTY; i = i + 1; }
        let new_entries_bytes: i64 = new_cap * sizeof::<Entry<K, V>>();
        let new_entries: *mut Entry<K, V> =
            alloc(new_entries_bytes) as *mut Entry<K, V>;

        self.states  = new_states;
        self.entries = new_entries;
        self.cap     = new_cap;
        self.len     = 0 as i64;

        let mut j: i64 = 0;
        while j < old_cap {
            if old_states[j] == SLOT_OCCUPIED {
                let e: *mut Entry<K, V> = &mut old_entries[j];
                self.insert(e.key, e.val);
            }
            j = j + 1 as i64;
        }

        dealloc(old_states);
        dealloc(old_entries as *mut u8);
    }
}

// ── Iteration ────────────────────────────────────────────────────────────────

pub struct HashMapIter<K, V> {
    states:  *const u8,
    entries: *const Entry<K, V>,
    cap:     i64,
    idx:     i64,
}

impl<K: Hash + Eq, V> Iterator<ZipPair<K, V>> for HashMapIter<K, V> {
    fn next(self: &mut HashMapIter<K, V>) -> Option<ZipPair<K, V>> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    let e: *const Entry<K, V> = &self.entries[i];
                    return Option::Some(ZipPair { first: e.key, second: e.val });
                }
            }
            return Option::None;
        }
    }
}

pub struct HashMapKeys<K, V> {
    states:  *const u8,
    entries: *const Entry<K, V>,
    cap:     i64,
    idx:     i64,
}

impl<K: Hash + Eq, V> Iterator<K> for HashMapKeys<K, V> {
    fn next(self: &mut HashMapKeys<K, V>) -> Option<K> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    let e: *const Entry<K, V> = &self.entries[i];
                    return Option::Some(e.key);
                }
            }
            return Option::None;
        }
    }
}

pub struct HashMapValues<K, V> {
    states:  *const u8,
    entries: *const Entry<K, V>,
    cap:     i64,
    idx:     i64,
}

impl<K: Hash + Eq, V> Iterator<V> for HashMapValues<K, V> {
    fn next(self: &mut HashMapValues<K, V>) -> Option<V> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    let e: *const Entry<K, V> = &self.entries[i];
                    return Option::Some(e.val);
                }
            }
            return Option::None;
        }
    }
}

impl<K: Hash + Eq, V> HashMap<K, V> {
    pub unsafe fn iter(self: *const HashMap<K, V>) -> HashMapIter<K, V> {
        return HashMapIter {
            states:  self.states as *const u8,
            entries: self.entries as *const Entry<K, V>,
            cap:     self.cap,
            idx:     0 as i64,
        };
    }

    pub unsafe fn keys(self: *const HashMap<K, V>) -> HashMapKeys<K, V> {
        return HashMapKeys {
            states:  self.states as *const u8,
            entries: self.entries as *const Entry<K, V>,
            cap:     self.cap,
            idx:     0 as i64,
        };
    }

    pub unsafe fn values(self: *const HashMap<K, V>) -> HashMapValues<K, V> {
        return HashMapValues {
            states:  self.states as *const u8,
            entries: self.entries as *const Entry<K, V>,
            cap:     self.cap,
            idx:     0 as i64,
        };
    }
}

pub unsafe fn hashmap_free<K: Hash + Eq, V>(m: *mut HashMap<K, V>) {
    dealloc(m.states);
    dealloc(m.entries as *mut u8);
}
