// Logos standard library — std.vec
//
// Vec<T> — growable heap-allocated generic array.
// Uses malloc/realloc/free from std.mem.

package std.collections.vec;

use std.mem;
use std.lang.option;
use std.lang.iter;
use std.lang.cmp;

pub struct Vec<T> {
    ptr: *mut T,
    len: i64,
    cap: i64,
}

pub fn vec_new<T>() -> Vec<T> {
    let init_cap: i64 = 8;
    let byte_size: i64 = init_cap * sizeof::<T>();
    let raw: *mut u8 = alloc(byte_size);
    let ptr: *mut T = raw as *mut T;
    return Vec { ptr: ptr, len: 0, cap: init_cap };
}

impl<T> Vec<T> {
    pub unsafe fn push(self: *mut Vec<T>, val: T) {
        if self.len == self.cap {
            self.cap = self.cap * 2;
            let byte_size: i64 = self.cap * sizeof::<T>();
            let raw: *mut u8 = realloc_buf(self.ptr as *mut u8, byte_size);
            self.ptr = raw as *mut T;
        }
        unsafe { self.ptr[self.len] = val; }
        self.len = self.len + 1;
    }

    pub unsafe fn get(self: *mut Vec<T>, i: i64) -> T {
        return self.ptr[i];
    }

    // Pointer to the i-th element (no copy). Caller must ensure the Vec
    // outlives the pointer and no resizing push happens meanwhile.
    pub unsafe fn at(self: *mut Vec<T>, i: i64) -> *mut T {
        return &mut self.ptr[i];
    }

    pub unsafe fn at_const(self: *const Vec<T>, i: i64) -> *const T {
        return &self.ptr[i];
    }

    pub unsafe fn set(self: *mut Vec<T>, i: i64, val: T) {
        self.ptr[i] = val;
    }

    pub fn length(&self) -> i64 {
        return self.len;
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0 as i64;
    }

    // Remove and return the last element, or None if empty.
    pub unsafe fn pop(self: *mut Vec<T>) -> Option<T> {
        if self.len == 0 as i64 { return Option::None; }
        self.len = self.len - 1 as i64;
        let val: T = self.ptr[self.len];
        return Option::Some(val);
    }

    // Remove element at index i, shifting subsequent elements left.
    // Panics (undefined behaviour) if i >= len.
    pub unsafe fn remove(self: *mut Vec<T>, i: i64) -> T {
        let val: T = self.ptr[i];
        let mut j: i64 = i + 1 as i64;
        while j < self.len {
            self.ptr[j - 1 as i64] = self.ptr[j];
            j = j + 1 as i64;
        }
        self.len = self.len - 1 as i64;
        return val;
    }

    // Return a read-only iterator over elements.
    pub unsafe fn iter(self: *const Vec<T>) -> VecIter<T> {
        return VecIter { data: self.ptr as *const T, len: self.len, idx: 0 as i64 };
    }
}

// ── VecIter<T> ────────────────────────────────────────────────────────────────

pub struct VecIter<T> {
    data: *const T,
    len:  i64,
    idx:  i64,
}

impl<T> Iterator<T> for VecIter<T> {
    fn next(self: &mut VecIter<T>) -> Option<T> {
        unsafe {
            if self.idx >= self.len { return Option::None; }
            let val: T = self.data[self.idx];
            self.idx = self.idx + 1 as i64;
            return Option::Some(val);
        }
    }
}

// Linear-search contains; requires T: Eq (free function to avoid bound on main impl).
pub unsafe fn vec_contains<T: Eq>(v: *const Vec<T>, val: &T) -> bool {
    let mut i: i64 = 0;
    while i < v.len {
        let item: T = v.ptr[i];
        if (&item).eq(val) { return true; }
        i = i + 1 as i64;
    }
    return false;
}

pub unsafe fn vec_free<T>(v: *mut Vec<T>) {
    dealloc(v.ptr as *mut u8);
}

// Cross-package skip-codegen probe: pre-instantiate Vec<i32> in this package.
// Downstream users of Vec<i32> link against these symbols and skip body emission.
pub instantiate Vec<i32>;
