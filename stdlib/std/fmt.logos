// Logos standard library — std.fmt
//
// Trait-based formatting with variadic generics.
//   use std.fmt;
//   let s: *mut u8 = format::<i32, bool>("n={}, ok={}", 42, true);
//   println(s as *const u8);
//   free(s);

package std.fmt;

use std.mem;
use std.string;

// ── Format trait ──────────────────────────────────────────────────────────

trait Format {
    unsafe fn fmt(self: Self, buf: *mut u8, off: i64) -> i64;
}

// ── Primitive impls ───────────────────────────────────────────────────────

impl Format for i32 {
    unsafe fn fmt(self: i32, buf: *mut u8, off: i64) -> i64 {
        return write_i32(buf, off, self);
    }
}

impl Format for i64 {
    unsafe fn fmt(self: i64, buf: *mut u8, off: i64) -> i64 {
        return write_i64(buf, off, self);
    }
}

impl Format for bool {
    unsafe fn fmt(self: bool, buf: *mut u8, off: i64) -> i64 {
        return write_bool(buf, off, self);
    }
}

impl Format for *const u8 {
    unsafe fn fmt(self: *const u8, buf: *mut u8, off: i64) -> i64 {
        let slen: i64 = str_len(self);
        mem_copy(buf, off, self, slen);
        return slen;
    }
}

// ── Format engine (variadic) ──────────────────────────────────────────────

// Base case: no more args — copy remaining format string, null-terminate.
unsafe fn fmt_into(fmt: *const u8, fi: i64, flen: i64, buf: *mut u8, pos: i64) -> i64 {
    let mut p: i64 = pos;
    let mut i: i64 = fi;
    while i < flen {
        buf[p] = fmt[i];
        p = p + 1;
        i = i + 1;
    }
    return p;
}

// Recursive case: find next {}, format one arg via trait, recurse on rest.
unsafe fn fmt_into<H: Format, T...>(fmt: *const u8, fi: i64, flen: i64,
                               buf: *mut u8, pos: i64,
                               first: H, rest: T...) -> i64 {
    let mut p: i64 = pos;
    let mut i: i64 = fi;
    while i < flen {
        if (fmt[i] as i32) == 123 {
            if i + 1 as i64 < flen {
                if (fmt[i + 1 as i64] as i32) == 125 {
                    let wrote: i64 = first.fmt(buf, p);
                    p = p + wrote;
                    return fmt_into(fmt, i + 2 as i64, flen, buf, p, rest...);
                }
            }
        }
        buf[p] = fmt[i];
        p = p + 1;
        i = i + 1;
    }
    return p;
}

// ── Public API ────────────────────────────────────────────────────────────

// format::<T...>(pattern, args...) -> *mut u8
// Returns a malloc-allocated, null-terminated string. Caller must free().
pub unsafe fn format<T...: Format>(pattern: *const u8, args: T...) -> *mut u8 {
    let flen: i64 = str_len(pattern);
    let est: i64 = flen + 256;
    let buf: *mut u8 = alloc(est);
    let pos: i64 = fmt_into(pattern, 0 as i64, flen, buf, 0 as i64, args...);
    unsafe { buf[pos] = 0 as u8; }
    return buf;
}
