// Logos stdlib — logos.std.data.memoria.keydesc
//
// Runtime key-type descriptor for the universal (dynamically-typed) Memoria
// containers. The key TYPE of a container is chosen at RUNTIME (one container =
// one fixed key type, set at creation, immutable thereafter) — so the container
// body compiles ONCE and dispatches every key operation through a descriptor
// rather than monomorphising per concrete `K`.
//
// The descriptor is an object-safe `dyn KeyDesc` whose concrete impls are
// zero-sized markers (`U64Key {}`, …): all the per-type behaviour lives in the
// vtable, none in instance data. A container resolves `code -> *mut dyn KeyDesc`
// once (via the registry below, vtable_of/dyn_from_parts) and caches it in its
// handle — see [[design]]: immutable key-meta, cached in ContainerRef.
//
// KEY VIEW (the value handed to client code on get/iterate) is a TWO-BLOCK view:
//   data — absolute pointer to the raw key bytes in a leaf (data zone);
//   meta — one word that is EITHER an inline value (small, e.g. Decimal prec/
//          scale in an i32) OR an absolute pointer to a larger metadata block
//          (descriptor decides per-type via `meta_is_ptr`). Cross-zone joins are
//          ABSOLUTE — relative refs are valid only WITHIN one zone (the data and
//          metadata zones move independently). The container absolutises at view
//          assembly; nothing cross-zone is ever stored at-rest.

package logos.std.data.memoria.keydesc;

use logos.lang.cmp;                    // Ordering
use logos.lang.hermes.anyval;          // H2_I64 / H2_U64 type codes
use logos.std.compiler.metaprog;       // vtable_of / dyn_from_parts

// ── KeyView — the two-block key view (absolute) ────────────────────────────
pub struct KeyView {
    pub data: *const u8,   // raw key bytes in the leaf (data zone), absolute
    pub meta: u64,         // value | *abs, interpreted per descriptor (meta_is_ptr)
}

// ── KeyDesc — the runtime key-type descriptor (object-safe) ────────────────
// Concrete impls are ZSTs; `&self`/`*mut self` is a `dyn` whose data half is an
// unused dummy (methods never read instance data — everything is vtable-driven).
pub trait KeyDesc {
    // Raw slot stride in bytes — the per-key cell size in a leaf's data buffer.
    fn key_size(&self) -> u64;
    // Is the view's `meta` word an absolute pointer (true) or an inline value
    // (false)? Small per-container metadata rides inline; large goes by pointer.
    fn meta_is_ptr(&self) -> bool;
    // Total order over two raw key slots. `meta` is the container-wide key
    // metadata (e.g. Decimal prec/scale) — ignored by metadata-less types.
    fn cmp_raw(&self, a: *const u8, b: *const u8, meta: u64) -> Ordering;
    // Assemble the outgoing two-block view from a leaf data pointer + the
    // (cached, absolute) meta word.
    fn build_view(&self, data: *const u8, meta: u64) -> KeyView;
    // Hash of a raw key slot (задел for hash-backed containers).
    fn hash_raw(&self, data: *const u8, meta: u64) -> u64;
    // Release any external memory a key slot owns (задел for owning key types;
    // no-op for POD keys). `data` points at the slot to drop in place.
    fn drop_raw(&self, data: *mut u8, meta: u64);
}

// ── Concrete descriptors (ZST markers) ─────────────────────────────────────

// u64 key — 8-byte raw slot, no metadata, identity-ish hash.
pub struct U64Key {}
impl KeyDesc for U64Key {
    fn key_size(&self) -> u64    { return 8u64; }
    fn meta_is_ptr(&self) -> bool { return false; }
    fn cmp_raw(&self, a: *const u8, b: *const u8, meta: u64) -> Ordering {
        unsafe {
            let x: u64 = *(a as *const u64);
            let y: u64 = *(b as *const u64);
            if x < y { return Ordering::Less; }
            if x > y { return Ordering::Greater; }
            return Ordering::Equal;
        }
    }
    fn build_view(&self, data: *const u8, meta: u64) -> KeyView {
        return KeyView { data: data, meta: meta };
    }
    fn hash_raw(&self, data: *const u8, meta: u64) -> u64 {
        unsafe { return *(data as *const u64); }
    }
    fn drop_raw(&self, data: *mut u8, meta: u64) { }
}

// i64 key — 8-byte raw slot, signed compare.
pub struct I64Key {}
impl KeyDesc for I64Key {
    fn key_size(&self) -> u64     { return 8u64; }
    fn meta_is_ptr(&self) -> bool { return false; }
    fn cmp_raw(&self, a: *const u8, b: *const u8, meta: u64) -> Ordering {
        unsafe {
            let x: i64 = *(a as *const i64);
            let y: i64 = *(b as *const i64);
            if x < y { return Ordering::Less; }
            if x > y { return Ordering::Greater; }
            return Ordering::Equal;
        }
    }
    fn build_view(&self, data: *const u8, meta: u64) -> KeyView {
        return KeyView { data: data, meta: meta };
    }
    fn hash_raw(&self, data: *const u8, meta: u64) -> u64 {
        unsafe { return *(data as *const u64); }
    }
    fn drop_raw(&self, data: *mut u8, meta: u64) { }
}

// Directional i64 key — DEMONSTRATES the meta path: the raw slot is an i64, and
// the container-wide key meta (cached, immutable) carries a direction flag in
// bit 0 (0 = ascending, 1 = descending). cmp_raw consumes `meta`; build_view
// carries it inline (meta_is_ptr = false). This proves the cached key-meta
// threads end-to-end (creation → cmp ordering → view) — the meta-zone design,
// without a remote metadata block (small meta rides as a value).
pub struct DirI64Key {}
impl KeyDesc for DirI64Key {
    fn key_size(&self) -> u64     { return 8u64; }
    fn meta_is_ptr(&self) -> bool { return false; }
    fn cmp_raw(&self, a: *const u8, b: *const u8, meta: u64) -> Ordering {
        unsafe {
            let x: i64 = *(a as *const i64);
            let y: i64 = *(b as *const i64);
            let base: Ordering = if x < y { Ordering::Less }
                                 else if x > y { Ordering::Greater }
                                 else { Ordering::Equal };
            if (meta & 1u64) == 1u64 { return base.reverse(); }   // descending
            return base;
        }
    }
    fn build_view(&self, data: *const u8, meta: u64) -> KeyView {
        return KeyView { data: data, meta: meta };
    }
    fn hash_raw(&self, data: *const u8, meta: u64) -> u64 { unsafe { return *(data as *const u64); } }
    fn drop_raw(&self, data: *mut u8, meta: u64) { }
}

// bool key/value — 1-byte raw slot (false < true).
pub struct BoolKey {}
impl KeyDesc for BoolKey {
    fn key_size(&self) -> u64     { return sizeof::<bool>() as u64; }
    fn meta_is_ptr(&self) -> bool { return false; }
    fn cmp_raw(&self, a: *const u8, b: *const u8, meta: u64) -> Ordering {
        unsafe {
            let x: bool = *(a as *const bool);
            let y: bool = *(b as *const bool);
            if !x && y { return Ordering::Less; }
            if x && !y { return Ordering::Greater; }
            return Ordering::Equal;
        }
    }
    fn build_view(&self, data: *const u8, meta: u64) -> KeyView {
        return KeyView { data: data, meta: meta };
    }
    fn hash_raw(&self, data: *const u8, meta: u64) -> u64 { unsafe { return *(data as *const u8) as u64; } }
    fn drop_raw(&self, data: *mut u8, meta: u64) { }
}

// Memoria-local key type code (outside the Hermes wire range) for DirI64Key.
pub const MK_DIR_I64: u64 = 200u64;

// ── Registry: type-code → runtime descriptor ───────────────────────────────
// Reuses the Hermes type codes (H2_I64 / H2_U64) so a Memoria key type-code is
// the same wire tag as the Hermes datatype. The descriptor is reconstructed as
// a `dyn KeyDesc` from (dummy ZST ptr, static vtable) — same shape as the
// persistent loader's node_arc_from_parts. The returned pointer's data half is
// a non-null aligned dummy that is never dereferenced.
pub unsafe fn desc_for(code: u64) -> *mut dyn KeyDesc {
    let dummy: *mut u8 = 8 as *mut u8;   // ZST: aligned, non-null, never read
    if code == H2_U64 {
        return dyn_from_parts::<KeyDesc>(dummy, vtable_of::<KeyDesc, U64Key>());
    }
    if code == H2_I64 {
        return dyn_from_parts::<KeyDesc>(dummy, vtable_of::<KeyDesc, I64Key>());
    }
    if code == MK_DIR_I64 {
        return dyn_from_parts::<KeyDesc>(dummy, vtable_of::<KeyDesc, DirI64Key>());
    }
    if code == HA_BOOL {
        return dyn_from_parts::<KeyDesc>(dummy, vtable_of::<KeyDesc, BoolKey>());
    }
    return 0 as *mut dyn KeyDesc;        // unknown code — caller's error guard
}
