// Logos stdlib — logos.std.data.memoria.ordval
//
// HermesOrdVal — the client-side OWNING materialization of a key (or value)
// handed out by a Memoria container. A KeyView borrows the container's nodes
// (which move under CoW), so when the client needs ownership / escape it
// materializes the view into a self-contained HermesOrdVal.
//
// Small-buffer optimization: a payload ≤ INLINE_CAP bytes lives inline in the
// struct (no heap); larger spills to a heap block. For the common small key
// (an i64, a Decimal of a few digits + i32 meta) the whole thing is inline —
// zero allocation, fully self-contained.

package logos.std.data.memoria.ordval;

use logos.lang.mem;   // memcpy / alloc / dealloc

// Inline capacity (bytes). ≤32B keys are stored without a heap allocation.
pub const INLINE_CAP: u64 = 32u64;

pub struct HermesOrdVal {
    inline: [u8; 32],    // payload when len <= INLINE_CAP
    heap:   *mut u8,     // owned heap block when len > INLINE_CAP; else null
    len:    u64,         // payload length in bytes
}

impl HermesOrdVal {
    // Copy `len` bytes from `data` into a fresh owned value. ≤INLINE_CAP → inline;
    // else a heap block is allocated and owned (freed by Drop).
    pub unsafe fn materialize(data: *const u8, len: u64) -> HermesOrdVal {
        let mut v: HermesOrdVal = HermesOrdVal {
            inline: [0u8; 32], heap: 0 as *mut u8, len: len,
        };
        if len <= INLINE_CAP {
            memcpy(&mut v.inline as *mut u8, data, len as i64);
        } else {
            let h: *mut u8 = alloc(len as i64);
            memcpy(h, data, len as i64);
            v.heap = h;
        }
        return v;
    }

    // Absolute pointer to the owned payload bytes (inline or heap).
    pub unsafe fn ptr(self: *const HermesOrdVal) -> *const u8 {
        if self.heap != 0 as *mut u8 { return self.heap as *const u8; }
        return &self.inline as *const u8;
    }

    pub fn len(&self) -> u64 { return self.len; }
    pub fn is_inline(&self) -> bool { return self.heap == 0 as *mut u8; }
}

impl Drop for HermesOrdVal {
    fn drop(self: HermesOrdVal) {
        unsafe { if self.heap != 0 as *mut u8 { dealloc(self.heap); } }
    }
}
