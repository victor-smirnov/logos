// Logos stdlib — logos.std.data.memoria.pmap
//
// PMap<K, V> — a persistent ordered map with specific key/value types. The
// public, object-oriented, SAFE container: typed methods (`insert` / `get` /
// `contains` / `remove` / `iter` / `snapshot`), no raw pointers, no `unsafe` at
// call sites, RAII drop. Mirrors the persistent-store PMap surface.
//
// Internally PMap<K,V> is a thin typed shell over ONE compiled, runtime-typed
// B+tree engine (tree.logos): the `<K,V>` shell only maps the types to Hermes
// type-codes and moves values by-value — the tree algorithm itself is compiled
// once, shared by every key/value type. (Same split as a typed map over a
// type-erased table.)

package logos.std.data.memoria.pmap;

use logos.lang.marker;                 // PhantomData
use logos.lang.option;
use logos.lang.ops;                    // ControlFlow (Iterator default methods)
use logos.lang.iter;                   // Iterator
use logos.lang.hermes.anyval;          // H2_* type codes
use logos.std.data.memoria.tree;       // the shared B+tree engine

// A POD type usable as a PMap key/value: it knows its Hermes type-code (which
// picks the runtime descriptor) and is moved by value.
pub trait MemType {
    fn mem_code() -> u64;
}
impl MemType for u64  { fn mem_code() -> u64 { return H2_U64;  } }
impl MemType for i64  { fn mem_code() -> u64 { return H2_I64;  } }
impl MemType for bool { fn mem_code() -> u64 { return HA_BOOL; } }

pub struct PMap<K: MemType, V: MemType> {
    core: OrdMap,
    k_:   PhantomData<K>,
    v_:   PhantomData<V>,
}

impl<K: MemType, V: MemType> PMap<K, V> {
    pub static fn new() -> PMap<K, V> {
        return PMap {
            core: unsafe { ordmap_new(K::mem_code(), V::mem_code()) },
            k_: PhantomData::<K>{}, v_: PhantomData::<V>{},
        };
    }

    pub fn len(&self) -> u64 {
        return unsafe { ordmap_len(&self.core as *const OrdMap) };
    }
    pub fn is_empty(&self) -> bool { return self.len() == 0u64; }

    pub fn insert(&mut self, key: K, val: V) {
        unsafe {
            ordmap_insert(&mut self.core as *mut OrdMap,
                          &key as *const K as *const u8,
                          &val as *const V as *const u8);
        }
    }

    pub fn get(&self, key: K) -> Option<V> {
        unsafe {
            let p: *const u8 = ordmap_get((&self.core as *const OrdMap) as *mut OrdMap,
                                          &key as *const K as *const u8);
            if (p as i64) == 0i64 { return Option::<V>::None; }
            return Option::<V>::Some(*(p as *const V));
        }
    }

    pub fn contains(&self, key: K) -> bool {
        return unsafe {
            ordmap_contains((&self.core as *const OrdMap) as *mut OrdMap,
                            &key as *const K as *const u8)
        };
    }

    pub fn remove(&mut self, key: K) -> bool {
        return unsafe {
            ordmap_remove(&mut self.core as *mut OrdMap, &key as *const K as *const u8)
        };
    }

    // In-order iterator yielding (key, value) pairs — `for (k, v) in m.iter()`.
    pub fn iter(&self) -> PMapIter<K, V> {
        return PMapIter {
            c: unsafe { cursor_open((&self.core as *const OrdMap) as *mut OrdMap) },
            k_: PhantomData::<K>{}, v_: PhantomData::<V>{},
        };
    }

    // An independent persistent snapshot (mutating one side never affects the
    // other). O(n) for now; structural-sharing CoW is the planned optimisation.
    pub fn snapshot(&self) -> PMap<K, V> {
        return PMap {
            core: unsafe { ordmap_snapshot(&self.core as *const OrdMap) },
            k_: PhantomData::<K>{}, v_: PhantomData::<V>{},
        };
    }
}

impl<K: MemType, V: MemType> Drop for PMap<K, V> {
    fn drop(self: PMap<K, V>) {
        unsafe { ordmap_free((&self.core as *const OrdMap) as *mut OrdMap); }
    }
}

// Typed in-order iterator. Implements Iterator<(K,V)> so `for (k,v) in m.iter()`
// works; the underlying cursor is released on drop.
pub struct PMapIter<K: MemType, V: MemType> {
    c:  Cursor,
    k_: PhantomData<K>,
    v_: PhantomData<V>,
}

impl<K: MemType, V: MemType> Iterator<(K, V)> for PMapIter<K, V> {
    fn next(self: &mut PMapIter<K, V>) -> Option<(K, V)> {
        unsafe {
            let cp: *mut Cursor = &mut self.c as *mut Cursor;
            if !cursor_valid(cp as *const Cursor) { return Option::<(K, V)>::None; }
            let k: K = *(cursor_key(cp).data as *const K);
            let v: V = *(cursor_val(cp) as *const V);
            cursor_next(cp);
            return Option::<(K, V)>::Some((k, v));
        }
    }
}

impl<K: MemType, V: MemType> Drop for PMapIter<K, V> {
    fn drop(self: PMapIter<K, V>) {
        unsafe { cursor_close((&self.c as *const Cursor) as *mut Cursor); }
    }
}
