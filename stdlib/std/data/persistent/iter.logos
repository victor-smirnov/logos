// std.data.persistent.iter — forward walker over a multi-level BTree.
//
// Memoria-style snapshot iter: PMapIter holds NodeARC clones for every
// branch on the path AND for the current leaf. Each clone owns an rc
// share — the underlying blocks stay alive until the iter drops, even
// if the originating ContainerRef is dropped or its tree is mutated.
// Iter walks the FROZEN view at iter-open time; mutations to the live
// container (via ContainerRef.insert / .remove) CoW-clone affected
// nodes, leaving iter's pinned tree untouched.
//
// Drop chain (after compiler debt #12 fix in mono): PMapIter's auto-
// derive Drop walks Vec<IterFrame>; Vec's drop body's per-element
// `let _x: T = p[i]` for T=IterFrame gets drop_fields=true via the
// mono SDrop sentinel→struct path → mlir-gen walks IterFrame's fields
// → branch_arc.drop fires → rc-- on each branch.

package std.data.persistent.iter;

use logos.mem.collections.vec;
use logos.mem.mem;
use logos.lang.cmp;
use logos.mem.hermes.fabric;
use logos.lang.hermes.view;
use logos.mem.hermes.view;
use logos.lang.hermes.anyval;

use std.data.persistent.node;
use std.data.persistent.cow;
use std.data.persistent.descent;
use std.data.persistent.shuttle;

// One descent frame: a branch on the path + the child index whose
// subtree the iter currently occupies. branch_arc owns an rc share —
// the block can't be deallocated while this frame is alive. branch_p
// is the typed-pointer view (derived from branch_arc's data ptr).
pub struct IterFrame<K: Container + ContainerOrd, const STORE_CFG: HermesStatic, const CFG: HermesStatic> {
    pub branch_arc: NodeARC<STORE_CFG>,
    pub branch_p:   *mut BranchNode<K, STORE_CFG, CFG>,
    pub idx:        u64,
}

// Forward walker. `leaf_arc` is null iff the iter is exhausted.
// `leaf_p` is the typed view derived from `leaf_arc.p`.
pub struct PMapIter<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic> {
    pub path:     Vec<IterFrame<K, STORE_CFG, CFG>>,
    pub leaf_arc: NodeARC<STORE_CFG>,
    pub leaf_p:   *mut LeafNode<K, V, STORE_CFG, CFG>,
    pub cursor:   u64,
}

// Descend leftmost from `start`, pushing branch frames into `path` and
// returning the leaf as a NodeARC clone (rc bumped on every visited
// branch + the leaf). Caller takes ownership of the returned NodeARC.
unsafe fn descend_leftmost<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    start: &NodeARC<STORE_CFG>,
    path:  *mut Vec<IterFrame<K, STORE_CFG, CFG>>,
) -> NodeARC<STORE_CFG> {
    let mut cur: NodeARC<STORE_CFG> = start.clone_arc();
    loop {
        let dp: *mut u8 = node_arc_data_ptr::<STORE_CFG>(&cur);
        let isleaf_p: *mut bool = (dp as i64 + 24i64) as *mut bool;
        if *isleaf_p { return cur; }
        let br: *mut BranchNode<K, STORE_CFG, CFG> = dp as *mut BranchNode<K, STORE_CFG, CFG>;
        let next_child: &NodeARC<STORE_CFG> = br.children.borrow(0i64);
        let next_arc: NodeARC<STORE_CFG> = next_child.clone_arc();
        path.push(IterFrame::<K, STORE_CFG, CFG> {
            branch_arc: cur, branch_p: br, idx: 0u64,
        });
        cur = next_arc;
    }
}

// Symmetric to descend_leftmost: walk to the rightmost leaf, recording
// each branch's last child idx in the path. Used by step_back when a
// frame has its idx decremented and we need to position at the end of
// the new subtree. (And by iter_back_open for a future reverse iter.)
unsafe fn descend_rightmost<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    start: &NodeARC<STORE_CFG>,
    path:  *mut Vec<IterFrame<K, STORE_CFG, CFG>>,
) -> NodeARC<STORE_CFG> {
    let mut cur: NodeARC<STORE_CFG> = start.clone_arc();
    loop {
        let dp: *mut u8 = node_arc_data_ptr::<STORE_CFG>(&cur);
        let isleaf_p: *mut bool = (dp as i64 + 24i64) as *mut bool;
        if *isleaf_p { return cur; }
        let br: *mut BranchNode<K, STORE_CFG, CFG> = dp as *mut BranchNode<K, STORE_CFG, CFG>;
        let last: i64 = br.children.length() - 1i64;
        let next_child: &NodeARC<STORE_CFG> = br.children.borrow(last);
        let next_arc: NodeARC<STORE_CFG> = next_child.clone_arc();
        path.push(IterFrame::<K, STORE_CFG, CFG> {
            branch_arc: cur, branch_p: br, idx: last as u64,
        });
        cur = next_arc;
    }
}

// Open a forward iter positioned at the n-th entry in sorted order.
// O(depth) descent via the same SUM-shuttle wrapper as
// pmap_descend_to_n, but recording the (branch_arc, branch_p, idx)
// frames as it descends — so step/step_back work from the new position.
//
// On out-of-range (n >= total): returns an invalid iter (valid()==false).
pub unsafe fn pmap_iter_open_at<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    arc: &NodeARC<STORE_CFG>, n: u64,
) -> PMapIter<K, V, STORE_CFG, CFG> {
    let mut path: Vec<IterFrame<K, STORE_CFG, CFG>> = vec_new::<IterFrame<K, STORE_CFG, CFG>>();
    let total: u64 = pmap_size_rec::<K, V, STORE_CFG, CFG>(arc);
    if n >= total {
        // Empty iter — null leaf, valid() returns false.
        return PMapIter::<K, V, STORE_CFG, CFG> {
            path:     path,
            leaf_arc: NodeARC::<STORE_CFG> { p: 0 as *mut dyn BTreeNode<STORE_CFG> },
            leaf_p:   0 as *mut LeafNode<K, V, STORE_CFG, CFG>,
            cursor:   0u64,
        };
    }
    let mut cur: NodeARC<STORE_CFG> = arc.clone_arc();
    let mut target: u64 = n;
    loop {
        let dp: *mut u8 = node_arc_data_ptr::<STORE_CFG>(&cur);
        let isleaf_p: *mut bool = (dp as i64 + 24i64) as *mut bool;
        if *isleaf_p { break; }
        let br: *mut BranchNode<K, STORE_CFG, CFG> = dp as *mut BranchNode<K, STORE_CFG, CFG>;
        let r: ShuttleResult = branchnode_subtree_size_shuttle::<K, STORE_CFG, CFG>(br, target);
        let next_child: &NodeARC<STORE_CFG> = br.children.borrow(r.idx as i64);
        let next_arc: NodeARC<STORE_CFG> = next_child.clone_arc();
        path.push(IterFrame::<K, STORE_CFG, CFG> {
            branch_arc: cur, branch_p: br, idx: r.idx,
        });
        target = r.remainder;
        cur = next_arc;
    }
    let leaf_p: *mut LeafNode<K, V, STORE_CFG, CFG> =
        node_arc_data_ptr::<STORE_CFG>(&cur) as *mut LeafNode<K, V, STORE_CFG, CFG>;
    return PMapIter::<K, V, STORE_CFG, CFG> {
        path:     path,
        leaf_arc: cur,
        leaf_p:   leaf_p,
        cursor:   target,
    };
}

// Open a forward iter at the leftmost (smallest) entry of the BTree
// rooted at `arc`. The iter pins its view via NodeARC clones — `arc`'s
// container can be dropped, mutated, or commit'd; the iter still walks
// the snapshot observed at iter-open time.
pub unsafe fn pmap_iter_open<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    arc: &NodeARC<STORE_CFG>,
) -> PMapIter<K, V, STORE_CFG, CFG> {
    let mut path: Vec<IterFrame<K, STORE_CFG, CFG>> = vec_new::<IterFrame<K, STORE_CFG, CFG>>();
    let leaf_arc: NodeARC<STORE_CFG> = descend_leftmost::<K, V, STORE_CFG, CFG>(
        arc, &mut path as *mut Vec<IterFrame<K, STORE_CFG, CFG>>);
    let leaf_p: *mut LeafNode<K, V, STORE_CFG, CFG> =
        node_arc_data_ptr::<STORE_CFG>(&leaf_arc) as *mut LeafNode<K, V, STORE_CFG, CFG>;
    return PMapIter::<K, V, STORE_CFG, CFG> {
        path:     path,
        leaf_arc: leaf_arc,
        leaf_p:   leaf_p,
        cursor:   0u64,
    };
}

impl<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic> PMapIter<K, V, STORE_CFG, CFG> {
    pub fn valid(&self) -> bool {
        unsafe {
            if self.leaf_p == 0 as *mut LeafNode<K, V, STORE_CFG, CFG> { return false; }
            return self.cursor < self.leaf_p.keys.len();
        }
    }

    pub unsafe fn key(&self) -> K::ViewInStore { return self.leaf_p.keys.get(self.cursor); }
    pub unsafe fn val(&self) -> V::ViewInStore { return self.leaf_p.vals.get(self.cursor); }

    // Reverse step: move one position backward in sorted order. On
    // leaf exhaustion (cursor==0 with no path), the iter becomes
    // invalid; clear leaf_p so valid() returns false. Otherwise walk
    // up the path stack to the nearest frame whose branch has a
    // previous child (idx > 0); decrement its idx, descend rightmost
    // from that subtree, position cursor at last key of the new leaf.
    pub unsafe fn step_back(&mut self) {
        if self.cursor > 0u64 {
            self.cursor = self.cursor - 1u64;
            return;
        }
        loop {
            let n: i64 = self.path.length();
            if n == 0i64 {
                arc_release_in_slot::<STORE_CFG>(&mut self.leaf_arc as *mut NodeARC<STORE_CFG>);
                self.leaf_p = 0 as *mut LeafNode<K, V, STORE_CFG, CFG>;
                self.cursor = 0u64;
                return;
            }
            let top: *mut IterFrame<K, STORE_CFG, CFG> = self.path.at(n - 1i64);
            if top.idx > 0u64 {
                top.idx = top.idx - 1u64;
                let prev_child: &NodeARC<STORE_CFG> = top.branch_p.children.borrow(top.idx as i64);
                let new_leaf: NodeARC<STORE_CFG> = descend_rightmost::<K, V, STORE_CFG, CFG>(
                    prev_child, &mut self.path as *mut Vec<IterFrame<K, STORE_CFG, CFG>>);
                arc_replace_in_slot::<STORE_CFG>(
                    &mut self.leaf_arc as *mut NodeARC<STORE_CFG>, new_leaf);
                self.leaf_p = node_arc_data_ptr::<STORE_CFG>(&self.leaf_arc) as *mut LeafNode<K, V, STORE_CFG, CFG>;
                self.cursor = self.leaf_p.keys.len() - 1u64;
                return;
            }
            // This frame is at its leftmost child; pop and look one level up.
            let _ = self.path.pop();
        }
    }

    // Advance one position. After the leaf is exhausted, walk up the
    // path stack to the nearest frame whose branch has another
    // unvisited child, then descend leftmost from that subtree —
    // releasing the old leaf NodeARC and pinning the new one.
    pub unsafe fn step(&mut self) {
        self.cursor = self.cursor + 1u64;
        if self.cursor < self.leaf_p.keys.len() { return; }
        loop {
            let n: i64 = self.path.length();
            if n == 0i64 {
                // Exhausted at root level — release leaf, mark done.
                arc_release_in_slot::<STORE_CFG>(&mut self.leaf_arc as *mut NodeARC<STORE_CFG>);
                self.leaf_p = 0 as *mut LeafNode<K, V, STORE_CFG, CFG>;
                self.cursor = 0u64;
                return;
            }
            let top: *mut IterFrame<K, STORE_CFG, CFG> = self.path.at(n - 1i64);
            let nc: u64 = top.branch_p.children.length() as u64;
            if top.idx + 1u64 < nc {
                top.idx = top.idx + 1u64;
                let next_child: &NodeARC<STORE_CFG> = top.branch_p.children.borrow(top.idx as i64);
                let new_leaf: NodeARC<STORE_CFG> = descend_leftmost::<K, V, STORE_CFG, CFG>(
                    next_child, &mut self.path as *mut Vec<IterFrame<K, STORE_CFG, CFG>>);
                arc_replace_in_slot::<STORE_CFG>(
                    &mut self.leaf_arc as *mut NodeARC<STORE_CFG>, new_leaf);
                self.leaf_p = node_arc_data_ptr::<STORE_CFG>(&self.leaf_arc) as *mut LeafNode<K, V, STORE_CFG, CFG>;
                self.cursor = 0u64;
                return;
            }
            // Frame fully visited — pop. Auto-drop releases its branch_arc
            // (debt #12 fix in mono propagates drop_fields=true through
            // the SDrop sentinel→struct substitution).
            let _ = self.path.pop();
        }
    }
}
