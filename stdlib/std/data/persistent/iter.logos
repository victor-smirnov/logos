// std.data.persistent.iter — façade over std.data.persistent
// .bt.iter, plus PMapView-taking wrappers for the acquire / release /
// find primitives. `<const CFG: HermesStatic>`-only surface; K/V are
// extracted from CFG and threaded into the bt-layer fns.

package std.data.persistent.iter;

pub use std.data.persistent.bt.iter;

use std.data.persistent.bt.node;
use std.data.persistent.bt.iter;
use std.data.persistent.view;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;
use std.hermes.anyval;

pub fn pmap_view_acquire_leaf_iter<const CFG: HermesStatic>(v: *const PMapView<CFG>) -> LeafIter<<type:CFG.key>, <type:CFG.value>, CFG> {
    unsafe { return acquire_leaf_iter_from_root::<<type:CFG.key>, <type:CFG.value>, CFG>(v.root); }
}

pub fn pmap_view_acquire_leaf_iter_last<const CFG: HermesStatic>(v: *const PMapView<CFG>) -> LeafIter<<type:CFG.key>, <type:CFG.value>, CFG> {
    unsafe { return acquire_leaf_iter_from_root_last::<<type:CFG.key>, <type:CFG.value>, CFG>(v.root); }
}

pub fn pmap_view_release_leaf_iter<const CFG: HermesStatic>(it: *mut LeafIter<<type:CFG.key>, <type:CFG.value>, CFG>) {
    release_leaf_iter::<<type:CFG.key>, <type:CFG.value>, CFG>(it);
}

pub fn pmap_view_find<const CFG: HermesStatic>(v: *const PMapView<CFG>, key: *const <type:CFG.key>) -> Found<<type:CFG.key>, <type:CFG.value>, CFG> {
    unsafe { return find_lb_from_root::<<type:CFG.key>, <type:CFG.value>, CFG>(v.root, key); }
}

pub fn pmap_view_find_binary<const CFG: HermesStatic>(v: *const PMapView<CFG>, key: *const <type:CFG.key>) -> Found<<type:CFG.key>, <type:CFG.value>, CFG> {
    unsafe { return find_lb_binary_from_root::<<type:CFG.key>, <type:CFG.value>, CFG>(v.root, key); }
}
