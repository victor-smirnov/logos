// SPDX-License-Identifier: Apache-2.0
// Logos standard library — std.data.persistent.uid256
//
// 256-bit identifier used as CtrID in the persistent collections package.
// Generated from OS entropy; collision-resistant.

package std.data.persistent.uid256;

use std.math.random;
use std.lang.cmp;
use std.lang.ord;
use std.lang.hash;
use std.lang.datatypes;

pub struct UID256 {
    pub bytes: [u8; 32],
}

pub fn uid256_zero() -> UID256 {
    return UID256 {
        bytes: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
                0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
    };
}

pub fn uid256_random() -> UID256 {
    let mut id: UID256 = uid256_zero();
    unsafe { os_random(&mut id.bytes[0], 32); }
    return id;
}

impl UID256 {
    pub fn is_zero(&self) -> bool {
        let mut i: i64 = 0;
        while i < 32 {
            if self.bytes[i] != 0u8 { return false; }
            i = i + 1;
        }
        return true;
    }

    // Read the i-th 64-bit word in little-endian order.  i ∈ [0, 4).
    pub unsafe fn word(&self, i: i64) -> u64 {
        let p: *const u64 = (&self.bytes[i * 8]) as *const u64;
        return p[0];
    }
}

impl Eq for UID256 {
    fn eq(&self, other: &Self) -> bool {
        unsafe {
            let mut i: i64 = 0;
            while i < 4 {
                if self.word(i) != other.word(i) { return false; }
                i = i + 1;
            }
            return true;
        }
    }
}

// Total order over 32 bytes — big-endian byte compare so the ordering
// matches the canonical UID256 wire form (most-significant byte first).
impl Ord for UID256 {
    fn cmp(&self, other: &Self) -> Ordering {
        let mut i: i64 = 0;
        while i < 32 {
            let a: u8 = self.bytes[i];
            let b: u8 = other.bytes[i];
            if a < b { return Ordering::Less; }
            if a > b { return Ordering::Greater; }
            i = i + 1;
        }
        return Ordering::Equal;
    }
}

// 32-byte POD, no relptrs — fits the PodRef blanket, which in turn gives
// Datatype + Container for free, so `Buffer<UID256>` works out of the box.
impl PodRef for UID256 {}

impl Hash for UID256 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        unsafe {
            state.write_u64(self.word(0));
            state.write_u64(self.word(1));
            state.write_u64(self.word(2));
            state.write_u64(self.word(3));
        }
    }
}
