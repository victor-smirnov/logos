// std.data.persistent.v3.handle — Snap + ContainerRefV3 on top of v3.
//
// User-facing surface for the v3 persistent stack:
//
//   StoreV3<STORE_CFG>           Arc<LockingStoreV3<STORE_CFG>>; persistent
//                              over snap_begin_v3 / snap_fork / commit.
//   SnapV3<STORE_CFG>            Live writable snapshot. Holds dir-tree
//                              root NodeARC + ref to its Store.
//   ContainerRefV3<STORE_CFG, CFG>   Handle to one container in a snap.
//                              Holds NodeARC over the container root.
//
// Auto-Drop chain:
//   • ContainerRefV3.drop  — writes the cached root back to dir, releases
//                          open-claim. NodeARC's drop-chain handles rc.
//   • Snap.drop          — single NodeARC.drop on dir root → recursive
//                          release through Vec<NodeARC> chain → all
//                          container roots released too. Unless commit
//                          consumed the dir root first (DAG owns it).
//
// v1 limits: single-leaf-only inserts (no branch descent / leaf split
// yet); dir leaf is LeafDirNode<u64, ...>. Multi-level + on-disk land
// in v3.mutate when the BTree algos port over.

package std.data.persistent.v3.handle;

use std.collections.vec;
use std.mem;
use std.mem.arc;
use std.mem.rc;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.lang.drop;
use std.hermes.view;
use std.hermes.anyval;

use std.data.persistent.v3.node;
use std.data.persistent.v3.cow;
use std.data.persistent.v3.store;
use std.data.persistent.v3.descent;
use std.data.persistent.v3.mutate;

// DirCfgV3 — fixed v1 directory layout. Key = ctr_id (u64), val =
// NodeARC<STORE_CFG> (heterogeneous container roots). When parametric
// HermesStatic literals land cleanly, this becomes per-STORE_CFG.
pub const DirCfgV3: HermesStatic = @{ "key": <type:u64>, "fanout": 16 };

// ── StoreV3<STORE_CFG> ─────────────────────────────────────────────────
unsafe impl<const STORE_CFG: HermesStatic> Send for LockingStoreV3<STORE_CFG> {}
unsafe impl<const STORE_CFG: HermesStatic> Sync for LockingStoreV3<STORE_CFG> {}

pub struct StoreV3<const STORE_CFG: HermesStatic> {
    pub arc: Arc<LockingStoreV3<STORE_CFG>>,
}

pub fn store_open_v3<const STORE_CFG: HermesStatic>() -> StoreV3<STORE_CFG> {
    let s: LockingStoreV3<STORE_CFG> = locking_store_new::<STORE_CFG>();
    return StoreV3::<STORE_CFG> { arc: arc_new::<LockingStoreV3<STORE_CFG>>(s) };
}

// ── SnapV3<STORE_CFG> ──────────────────────────────────────────────────
pub struct SnapV3<const STORE_CFG: HermesStatic> {
    pub dir: NodeARC<STORE_CFG>,    // directory tree root
    pub arc: Arc<LockingStoreV3<STORE_CFG>>,
    pub snapshot_id: u64,
}

// snap_fork_v3 — start a new mutable snapshot from a committed parent.
pub fn snap_fork_v3<const STORE_CFG: HermesStatic>(
    store: &mut StoreV3<STORE_CFG>,
    parent_commit: i64,
) -> SnapV3<STORE_CFG> {
    let s: &mut LockingStoreV3<STORE_CFG> = store.arc.deref_mut();
    let snap_id: u64 = unsafe { (s as *mut LockingStoreV3<STORE_CFG>).alloc_snapshot_id() };
    let dir: NodeARC<STORE_CFG> = unsafe { (s as *mut LockingStoreV3<STORE_CFG>).checkout(parent_commit) };
    return SnapV3::<STORE_CFG> {
        dir:         dir,
        arc:         store.arc.clone_ref(),
        snapshot_id: snap_id,
    };
}

pub fn snap_begin_v3<const STORE_CFG: HermesStatic>(store: &mut StoreV3<STORE_CFG>) -> SnapV3<STORE_CFG> {
    let s: &mut LockingStoreV3<STORE_CFG> = store.arc.deref_mut();
    let snap_id:  u64 = unsafe { (s as *mut LockingStoreV3<STORE_CFG>).alloc_snapshot_id() };
    let block_id: u64 = unsafe { (s as *mut LockingStoreV3<STORE_CFG>).alloc_block_id() };
    // Empty dir leaf as initial root.
    let dir_leaf: *mut LeafDirNode<u64, STORE_CFG, DirCfgV3> = unsafe {
        leaf_dir_alloc::<u64, STORE_CFG, DirCfgV3>(block_id, snap_id)
    };
    let dir: NodeARC<STORE_CFG> = node_arc_wrap::<STORE_CFG>(dir_leaf as *mut dyn BTreeNode<STORE_CFG>);
    return SnapV3::<STORE_CFG> {
        dir:         dir,
        arc:         store.arc.clone_ref(),
        snapshot_id: snap_id,
    };
}

impl<const STORE_CFG: HermesStatic> SnapV3<STORE_CFG> {
    // Commit the dir tree as a new DAG entry. Transfers the dir's rc to
    // the entry. Returns the new commit id.
    pub fn commit(&mut self) -> i64 {
        let s: &mut LockingStoreV3<STORE_CFG> = self.arc.deref_mut();
        // Bump rc twice: clone_arc gives us one extra share; the second
        // explicit bump compensates for `cloned`'s scope-exit auto-drop
        // at commit fn-end (sema's call-arg move-tracking doesn't catch
        // the method-on-*mut-pointer dispatch path here, so the local
        // does drop). Net: snap.dir keeps its share + DAG slot keeps the
        // share that survives the local's drop.
        let cloned: NodeARC<STORE_CFG> = self.dir.clone_arc();
        unsafe {
            let dp: *mut u8 = node_arc_data_ptr::<STORE_CFG>(&cloned);
            let rcp: *mut u64 = dp as *mut u64;
            *rcp = *rcp + 1u64;
        }
        let id: i64 = unsafe { (s as *mut LockingStoreV3<STORE_CFG>).register_commit(cloned, 0i64 - 1i64) };
        return id;
    }
}

// ── ContainerRefV3<STORE_CFG, CFG> ─────────────────────────────────────
// Handle to one container's root. Holds a NodeARC (open-claim rc) and
// the container's id within the dir. Drop writes back + releases.
//
// v1: ContainerRefV3 holds a typed pointer cast to the concrete leaf
// type. Multi-level descent (where root may be a BranchNode) lands
// when v3.mutate gains splits. Single-leaf bring-up first.

pub struct ContainerRefV3<const STORE_CFG: HermesStatic, const CFG: HermesStatic> {
    pub arc:    NodeARC<STORE_CFG>,    // owning rc on the container root
    pub ctr_id: u64,
    // Pointer into the dir leaf's vals slot, stored as i64 to dodge
    // mlir-gen's auto-drop pass: typed `*mut NodeARC<…>` here would be
    // treated as a NodeARC field and the pointer value would be passed
    // to NodeARC::drop on cr's scope-exit — corrupting the dir slot's
    // fat-ptr storage. Cast to *mut NodeARC<STORE_CFG> at use sites.
    // 0 when open_pmap_v3 didn't find ctr_id.
    pub dir_slot: i64,
}

// create_pmap_v3 — alloc a fresh empty leaf for the container, register
// it in the dir under ctr_id, return a ContainerRefV3 holding the
// open-claim handle.
//
// CoW: if the dir leaf was inherited from a parent commit (snap_fork_v3),
// make_unique clones it before any push so the parent dir stays
// untouched. v1 keeps the dir as a single LeafDirNode (no branching).
pub fn create_pmap_v3<const CFG: HermesStatic, const STORE_CFG: HermesStatic>(
    snap:   &mut SnapV3<STORE_CFG>,
    ctr_id: u64,
) -> ContainerRefV3<STORE_CFG, CFG> {
    let s: &mut LockingStoreV3<STORE_CFG> = snap.arc.deref_mut();
    let id_ctr_p: *mut u64 = unsafe { &mut (*(s as *mut LockingStoreV3<STORE_CFG>)).next_block_id as *mut u64 };
    unsafe { make_unique::<STORE_CFG>(&mut snap.dir, snap.snapshot_id, id_ctr_p); }
    let block_id: u64 = unsafe { (s as *mut LockingStoreV3<STORE_CFG>).alloc_block_id() };
    // Allocate the container's initial empty leaf (data flavour).
    let leaf: *mut LeafNode<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG> = unsafe {
        leaf_alloc::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(block_id, snap.snapshot_id)
    };
    // Wrap as NodeARC twice — one for the dir-leaf entry (transfers
    // rc), one for the open-claim ContainerRefV3.
    let arc_for_dir: NodeARC<STORE_CFG> =
        node_arc_wrap::<STORE_CFG>(leaf as *mut dyn BTreeNode<STORE_CFG>);
    // Bump rc on the same block: dir-leaf gets one share, ContainerRefV3
    // gets another.
    let arc_for_ref: NodeARC<STORE_CFG> = arc_for_dir.clone_arc();

    // Append to dir leaf in-place — make_unique above guarantees the
    // dir leaf is owned by this snapshot. Capture *mut to the new slot
    // for ContainerRefV3.dir_slot.
    let slot_p: *mut NodeARC<STORE_CFG> = unsafe {
        let dir_leaf: *mut LeafDirNode<u64, STORE_CFG, DirCfgV3> =
            node_arc_data_ptr::<STORE_CFG>(&snap.dir) as *mut LeafDirNode<u64, STORE_CFG, DirCfgV3>;
        dir_leaf.keys.push(ctr_id);
        dir_leaf.vals.push(arc_for_dir);
        dir_leaf.vals.at(dir_leaf.vals.length() - 1i64)
    };

    return ContainerRefV3::<STORE_CFG, CFG> {
        arc:      arc_for_ref,
        ctr_id:   ctr_id,
        dir_slot: slot_p as i64,
    };
}

// open_pmap_v3 — look up ctr_id in the snapshot's dir leaf and return a
// ContainerRefV3 sharing rc with the dir's slot.
//
// v1 limit: container root mutations don't write back into the dir.
// open+insert+commit DOES NOT yet propagate root-grow into the dir
// leaf — the DAG's view of the root stays the value the dir had at
// open time. Use create_pmap_v3 + commit (not open_pmap on a fork)
// for now. Multi-snapshot CoW for containers needs writeback wiring
// (ContainerRefV3.dir_slot + drop-time slot update) which lands next.
//
// v1: dir is a single LeafDirNode (no branching) — linear scan over keys.
pub fn open_pmap_v3<const CFG: HermesStatic, const STORE_CFG: HermesStatic>(
    snap:   &mut SnapV3<STORE_CFG>,
    ctr_id: u64,
) -> ContainerRefV3<STORE_CFG, CFG> {
    // CoW dir up-front so any later writeback through cr.dir_slot lands
    // in this snapshot's dir, not the parent commit's. Skips when dir
    // is already this snapshot's (snapshot_id matches).
    let s: &mut LockingStoreV3<STORE_CFG> = snap.arc.deref_mut();
    let id_ctr_p: *mut u64 = unsafe {
        &mut (*(s as *mut LockingStoreV3<STORE_CFG>)).next_block_id as *mut u64
    };
    unsafe { make_unique::<STORE_CFG>(&mut snap.dir, snap.snapshot_id, id_ctr_p); }
    unsafe {
        let dir_leaf: *mut LeafDirNode<u64, STORE_CFG, DirCfgV3> =
            node_arc_data_ptr::<STORE_CFG>(&snap.dir) as *mut LeafDirNode<u64, STORE_CFG, DirCfgV3>;
        let n: u64 = dir_leaf.keys.len();
        let mut i: u64 = 0u64;
        while i < n {
            if dir_leaf.keys.get(i) == ctr_id {
                let slot_p: *mut NodeARC<STORE_CFG> = dir_leaf.vals.at(i as i64);
                let cloned: NodeARC<STORE_CFG> = (*slot_p).clone_arc();
                return ContainerRefV3::<STORE_CFG, CFG> {
                    arc:      cloned,
                    ctr_id:   ctr_id,
                    dir_slot: slot_p as i64,
                };
            }
            i = i + 1u64;
        }
        return ContainerRefV3::<STORE_CFG, CFG> {
            arc:      NodeARC::<STORE_CFG> { p: 0 as *mut dyn BTreeNode<STORE_CFG> },
            ctr_id:   ctr_id,
            dir_slot: 0i64,
        };
    }
}

// ContainerRefV3 methods — full multi-level B+tree on top of NodeARC.
// Carries the ambient snapshot_id + id allocator so insert/remove can
// route through the v3.mutate's CoW-aware descent without round-trip
// through the Store.
impl<const STORE_CFG: HermesStatic, const CFG: HermesStatic> ContainerRefV3<STORE_CFG, CFG> {
    pub fn len(&self) -> u64 {
        return pmap_size_rec::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(&self.arc);
    }

    pub fn contains(&self, qkey: *const <type:CFG.key>) -> bool {
        return pmap_contains_rec::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(&self.arc, qkey);
    }

    pub fn get(&self, qkey: *const <type:CFG.key>, out: *mut <type:CFG.value>::ViewInStore) -> bool {
        unsafe {
            return pmap_get_rec::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(&self.arc, qkey, out);
        }
    }

    pub fn insert(&mut self, key: <type:CFG.key>::ViewInStore, val: <type:CFG.value>::ViewInStore, qkey: *const <type:CFG.key>, cur_snap_id: u64, id_ctr_p: *mut u64) -> bool {
        let r: bool = unsafe {
            pmap_insert::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(
                &mut self.arc, key, val, qkey, cur_snap_id, id_ctr_p)
        };
        self.writeback();
        return r;
    }

    pub fn remove(&mut self, qkey: *const <type:CFG.key>, cur_snap_id: u64, id_ctr_p: *mut u64) -> bool {
        let r: bool = unsafe {
            pmap_remove::<<type:CFG.key>, <type:CFG.value>, STORE_CFG, CFG>(
                &mut self.arc, qkey, cur_snap_id, id_ctr_p)
        };
        self.writeback();
        return r;
    }

    // Sync dir_slot's fat-handle with self.arc. Insert/remove that
    // grow/collapse the root replaced self.arc (via arc_replace_in_slot)
    // but the dir's vals[i] still has the pre-mutation handle. Clone-bump
    // self.arc's block rc into the slot, release the slot's old share.
    pub fn writeback(&mut self) {
        unsafe {
            if self.dir_slot == 0i64 { return; }
            let slot: *mut NodeARC<STORE_CFG> = self.dir_slot as *mut NodeARC<STORE_CFG>;
            let slot_handle: *mut dyn BTreeNode<STORE_CFG> = (*slot).p;
            let arc_handle:  *mut dyn BTreeNode<STORE_CFG> = self.arc.p;
            if slot_handle as *mut u8 == arc_handle as *mut u8 { return; }
            // Bump self.arc's block rc — the slot adopts a fresh share,
            // self.arc retains its own.
            let new_dp: *mut u8 = node_arc_data_ptr::<STORE_CFG>(&self.arc);
            let new_rcp: *mut u64 = new_dp as *mut u64;
            *new_rcp = *new_rcp + 1u64;
            // Write new fat-handle into slot.
            (*slot).p = arc_handle;
            // Release old fat-handle.
            let old_dp: *mut u8 = (*(slot_handle as *mut u64)) as *mut u8;
            let old_rcp: *mut u64 = old_dp as *mut u64;
            *old_rcp = *old_rcp - 1u64;
            if *old_rcp == 0u64 {
                slot_handle.__drop_in_place();
                dealloc(old_dp);
            }
        }
    }
}
