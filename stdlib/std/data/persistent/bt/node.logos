// std.data.persistent.bt.node — node shapes for the general
// componentized B+tree, post Phase-A split.
//
//   • NodeBase   — header shared by branch and leaf: rc + n + is_leaf.
//                  Pointers between nodes (children slots, iter frame
//                  stack, PMapView root) are `*mut NodeBase<K,V,CFG>`.
//                  Header access through that pointer is direct
//                  (rc/n/is_leaf are at offset 0 of either subtype
//                  thanks to NodeBase being the FIRST field).
//   • BranchNode — keys + children. Small fanout (CFG "fanout_branch"
//                  or "fanout").
//   • LeafNode   — keys + vals. Can be much larger (CFG "fanout_leaf"
//                  or "fanout"). Big leaves give long flat scans
//                  between iter frame transitions and amortise
//                  descent.
//
// All three structs are generic over <K, V, CFG> so pointers carry
// full type identity. Phantom-style use of K/V in NodeBase is
// intentional — keeps `*mut NodeBase<K,V,CFG>` distinct per tree.
//
// `BTreeNode` is kept as a type alias for `NodeBase` so existing
// callers using the unified-name form keep compiling.

package std.data.persistent.bt.node;

use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;
use std.hermes.anyval;

pub struct NodeBase<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic> {
    // rc MUST stay at offset 0 — store/store.logos::rc_bump treats any
    // *mut u8 → *mut u64 cast as the rc slot for type-erased retain.
    pub rc:       u64,
    // cfg_hash: byte-hash identity of CFG, populated at alloc time. It's
    // the universal "what kind of container is this node?" tag —
    // store-level dispatch (e.g. ContainerRegistry release thunks in
    // handle.logos) reads it through any *mut NodeBase<*,*,*> by casting
    // the root ptr to *mut u64 and indexing slot 1 (offset 8 bytes).
    // Future reuse: schema dispatch, wrapper-pool keying, type-aware
    // debug print all share this slot.
    pub cfg_hash: u64,
    pub n:        u16,
    pub is_leaf:  bool,
}

pub struct BranchNode<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic> {
    pub base:     NodeBase<K, V, CFG>,
    pub keys:     Buffer<K>,
    pub children: PrimVec<*mut NodeBase<K, V, CFG>>,
}

pub struct LeafNode<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic> {
    pub base: NodeBase<K, V, CFG>,
    pub keys: Buffer<K>,
    pub vals: Buffer<V>,
}
