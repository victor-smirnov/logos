// Copyright 2026 Victor Smirnov
// std.data.persistent.bt.node — node shapes for the general
// componentized B+tree, post Phase-A split.
//
//   • NodeBase   — header shared by branch and leaf: rc + n + is_leaf.
//                  Pointers between nodes (children slots, iter frame
//                  stack, PMapView root) are `*mut NodeBase<K,V,CFG>`.
//                  Header access through that pointer is direct
//                  (rc/n/is_leaf are at offset 0 of either subtype
//                  thanks to NodeBase being the FIRST field).
//   • BranchNode — keys + children. Small fanout (CFG "fanout_branch"
//                  or "fanout").
//   • LeafNode   — keys + vals. Can be much larger (CFG "fanout_leaf"
//                  or "fanout"). Big leaves give long flat scans
//                  between iter frame transitions and amortise
//                  descent.
//
// All three structs are generic over <K, V, CFG> so pointers carry
// full type identity. Phantom-style use of K/V in NodeBase is
// intentional — keeps `*mut NodeBase<K,V,CFG>` distinct per tree.
//
// `BTreeNode` is kept as a type alias for `NodeBase` so existing
// callers using the unified-name form keep compiling.

package std.data.persistent.bt.node;

use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;
use std.hermes.anyval;

pub struct NodeBase<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic> {
    // rc MUST stay at offset 0 — store/store.logos::rc_bump treats any
    // *mut u8 → *mut u64 cast as the rc slot for type-erased retain.
    pub rc:       u64,
    // cfg_hash (offset 8): byte-hash identity of CFG, populated at alloc
    // time. Universal "what container CFG is this node?" tag — used by
    // open_pmap for cfg-validation (defensive type check via slot-1 read
    // through `*((raw + 8) as *mut u64)`). MUST stay at offset 8 — that
    // cast is the type-erased read in handle.logos.
    pub cfg_hash:        u64,
    // block_type_hash (offset 16): runtime dispatch key for type-erased
    // ops (block-ops registry: for_each_child + release). Computed at
    // alloc time as `type_hash::<NodeSchema>() ^ hstatic_hash_of::<CFG>()`
    // — the XOR mixes CFG identity into the schema hash so that two
    // structurally-identical schemas with different CFGs (e.g.
    // LeafNode<u64,u64,DirCfg> vs LeafNode<u64,u64,MapCfg>) get distinct
    // dispatch keys. `type_hash` alone is structural and would collide
    // when K/V match across CFGs. Mirrors big Memoria's `block_type_hash`.
    pub block_type_hash: u64,
    // id (offset 24): unique block id within the owning Store. Allocated
    // monotonically by the Store at every node alloc / clone. Persistent
    // identity for save/load (mirrors big-Memoria's BlockID).
    pub id:           u64,
    // snapshot_id (offset 32): id of the snapshot in which this node was
    // created or cloned. `make_root_unique` / `make_child_unique` use it
    // as the CoW-skip key: if `node.snapshot_id == current_snapshot_id`
    // the node is owned by us — mutate in place, no clone — independent
    // of rc (rc may be >1 while another snap holds an open-claim). 0 is
    // the "no-snapshot context" sentinel for pmap-only callers.
    pub snapshot_id:  u64,
    pub n:        u16,
    pub is_leaf:  bool,
}

pub struct BranchNode<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic> {
    pub base:     NodeBase<K, V, CFG>,
    pub keys:     Buffer<K>,
    pub children: PrimVec<*mut NodeBase<K, V, CFG>>,
}

pub struct LeafNode<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic> {
    pub base: NodeBase<K, V, CFG>,
    pub keys: Buffer<K>,
    pub vals: Buffer<V>,
}
