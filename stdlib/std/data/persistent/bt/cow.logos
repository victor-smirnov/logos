// logos.std.data.persistent.bt.cow — concrete node types + alloc helpers +
// BTreeNode trait impls for the dyn-trait persistent-store rearch.
//
// Three concrete node flavours:
//
//   BranchNode<K, STORE_CFG, CFG>   — interior node. Memoria-style max-key
//                                     invariant: keys[i] = max key in
//                                     children[i]; N keys ↔ N children
//                                     (parallel arrays).
//   LeafNode<K, V, STORE_CFG, CFG>  — data leaf. vals: Buffer<V>, V is a
//                                     Container datatype (primitives, fixed
//                                     structs without Drop).
//   LeafDirNode<K, STORE_CFG, CFG>  — directory leaf. vals: Vec<NodeARC>.
//                                     Used when the map value type is itself
//                                     a NodeARC (= directory storing container
//                                     roots).
//
// Each impl BTreeNode<STORE_CFG> ships ONLY the identity hashes + the
// type-erased child walk + cow_clone; the destructor is handled by
// `Arc<dyn BTreeNode>`'s own drop (vtable drop slot → user `impl Drop` +
// recursive field destructors).
//
// Allocation model: each node is built as a VALUE, then `arc_new` moves it into
// an Arc control block and the result is unsize-cast to `Arc<dyn BTreeNode>`
// (NodeARC). The handle's `node_arc_data_ptr` recovers the node base for the
// in-place fill that the CoW / split / insert algorithms then perform.

package logos.std.data.persistent.bt.cow;

use logos.mem.collections.vec;
use logos.lang.mem;
use logos.lang.cmp;
use logos.lang.fabric;
use logos.lang.writ.hstatic;
use logos.mem.sync;                     // arc_new / Arc

use logos.std.data.persistent.bt.node;
use logos.std.data.persistent.bt.shuttle;  // ShuttleResult — derive emits per-op shuttle wrapper
use logos.std.compiler.metaprog;        // brings #[derive_branch_node] trigger into scope

// Aggregate columns on BranchNode. SUM aggregate over `subtree_size`
// turns bt_size_rec from O(N) full-tree walk into O(depth) — read
// from the root branch directly. MAX-on-K is implicit in the existing
// `keys[i] = max-in-children[i]` Memoria invariant; an explicit
// max-key column would only matter for non-K-typed comparisons.
//
// Maintenance contract: branch_alloc initialises empty; cow_clone
// inherits from parent; mutate.logos's insert/remove path updates
// per-level on bubble-up. This slice lands the column + alloc/
// cow_clone hooks; mutate-side maintenance is deferred (until then
// the column stays length=0 — bt_size_rec keeps recursing).
pub const BRANCH_OPS: WritStatic = @[
    @{ "field": "subtree_size", "type": "u64", "kind": "SUM" },
];

#[derive_branch_node(branch = "BranchNode", ops = "BRANCH_OPS")]
pub struct LeafNodeForBranch<K: Container + ContainerOrd, V: Container, const STORE_CFG: WritStatic, const CFG: WritStatic> {
    pub base: NodeBase<STORE_CFG>,
    pub keys: Buffer<K>,
    pub vals: Buffer<V>,
}

impl<K: Container + ContainerOrd, const STORE_CFG: WritStatic, const CFG: WritStatic> BTreeNode<STORE_CFG> for BranchNode<K, STORE_CFG, CFG> {
    fn cfg_hash(&self) -> u64        { return hstatic_hash_of::<CFG>(); }
    fn block_type_hash(&self) -> u64 { return self.base.block_code; }

    fn child_count(&self) -> u64 { return self.children.len() as u64; }
    fn child_at(&self, idx: u64) -> *const NodeARC<STORE_CFG> {
        unsafe { return self.children.at_const(idx as i64); }
    }

    fn cow_clone(&self, new_id: BlockId<STORE_CFG>, snapshot_id: SnpId<STORE_CFG>) -> NodeARC<STORE_CFG> {
        let h: NodeARC<STORE_CFG> = unsafe {
            branch_alloc::<K, STORE_CFG, CFG>(new_id, snapshot_id)
        };
        unsafe {
            let copy: *mut BranchNode<K, STORE_CFG, CFG> =
                node_arc_data_ptr::<STORE_CFG>(&h) as *mut BranchNode<K, STORE_CFG, CFG>;
            // Keys: shallow copy (Buffer<K> with K: Container — datatype storage).
            let nk: u64 = self.keys.len();
            let mut i: u64 = 0u64;
            while i < nk {
                copy.keys.push(self.keys.get(i));
                i = i + 1u64;
            }
            // Children: clone each NodeARC — atomic rc bump on each child block,
            // both copies own their share.
            let nc: i64 = self.children.len();
            let mut j: i64 = 0i64;
            while j < nc {
                let c: &NodeARC<STORE_CFG> = self.children.borrow(j);
                copy.children.push(c.clone());
                j = j + 1i64;
            }
            // subtree_size aggregate column — copy slot-by-slot.
            let na: u64 = self.subtree_size.len;
            let mut k: u64 = 0u64;
            while k < na {
                copy.subtree_size.push(self.subtree_size.get(k));
                k = k + 1u64;
            }
        }
        return h;
    }
}

pub fn branch_alloc<K: Container + ContainerOrd, const STORE_CFG: WritStatic, const CFG: WritStatic>(id: BlockId<STORE_CFG>, snapshot_id: SnpId<STORE_CFG>) -> NodeARC<STORE_CFG> {
    // BranchNode is macro-derived and has no literal form, so build the control
    // block uninitialised and fill the node in place (the old alloc style, minus
    // the intrusive rc which now lives in the Arc control block).
    let h: NodeARC<STORE_CFG> = unsafe {
        arc_new_uninit::<BranchNode<K, STORE_CFG, CFG>>() as NodeARC<STORE_CFG>
    };
    unsafe {
        let p: *mut BranchNode<K, STORE_CFG, CFG> =
            node_arc_data_ptr::<STORE_CFG>(&h) as *mut BranchNode<K, STORE_CFG, CFG>;
        p.base = NodeBase::<STORE_CFG> {
            id:          id,
            snapshot_id: snapshot_id,
            is_leaf:     false,
            block_code:  schema_code::<BranchNode<K, STORE_CFG, CFG>>(),
        };
        p.keys         = Buffer::<K>::new();
        p.children     = vec_new::<NodeARC<STORE_CFG>>();
        p.subtree_size = PrimVec::<u64>::empty();
    }
    return h;
}

// ── LeafNode (data flavour) ────────────────────────────────────────────
pub struct LeafNode<K: Container + ContainerOrd, V: Container, const STORE_CFG: WritStatic, const CFG: WritStatic> {
    pub base: NodeBase<STORE_CFG>,
    pub keys: Buffer<K>,
    pub vals: Buffer<V>,
}

impl<K: Container + ContainerOrd, V: Container, const STORE_CFG: WritStatic, const CFG: WritStatic> BTreeNode<STORE_CFG> for LeafNode<K, V, STORE_CFG, CFG> {
    fn cfg_hash(&self) -> u64        { return hstatic_hash_of::<CFG>(); }
    fn block_type_hash(&self) -> u64 { return self.base.block_code; }

    // Data leaves carry no NodeARC children — keys/vals are datatype storage.
    fn child_count(&self) -> u64 { return 0u64; }
    fn child_at(&self, idx: u64) -> *const NodeARC<STORE_CFG> {
        return 0 as *const NodeARC<STORE_CFG>;
    }

    fn cow_clone(&self, new_id: BlockId<STORE_CFG>, snapshot_id: SnpId<STORE_CFG>) -> NodeARC<STORE_CFG> {
        let h: NodeARC<STORE_CFG> = unsafe {
            leaf_alloc::<K, V, STORE_CFG, CFG>(new_id, snapshot_id)
        };
        unsafe {
            let copy: *mut LeafNode<K, V, STORE_CFG, CFG> =
                node_arc_data_ptr::<STORE_CFG>(&h) as *mut LeafNode<K, V, STORE_CFG, CFG>;
            let nk: u64 = self.keys.len();
            let mut i: u64 = 0u64;
            while i < nk { copy.keys.push(self.keys.get(i)); i = i + 1u64; }
            let nv: u64 = self.vals.len();
            i = 0u64;
            while i < nv { copy.vals.push(self.vals.get(i)); i = i + 1u64; }
        }
        return h;
    }
}

pub fn leaf_alloc<K: Container + ContainerOrd, V: Container, const STORE_CFG: WritStatic, const CFG: WritStatic>(id: BlockId<STORE_CFG>, snapshot_id: SnpId<STORE_CFG>) -> NodeARC<STORE_CFG> {
    let node: LeafNode<K, V, STORE_CFG, CFG> = LeafNode::<K, V, STORE_CFG, CFG> {
        base: NodeBase::<STORE_CFG> {
            id:          id,
            snapshot_id: snapshot_id,
            is_leaf:     true,
            block_code:  schema_code::<LeafNode<K, V, STORE_CFG, CFG>>(),
        },
        keys: Buffer::<K>::new(),
        vals: Buffer::<V>::new(),
    };
    return arc_new::<LeafNode<K, V, STORE_CFG, CFG>>(node) as NodeARC<STORE_CFG>;
}

// ── LeafDirNode (dir flavour) ──────────────────────────────────────────
// V = NodeARC<STORE_CFG> — vals are heterogeneous owning handles to
// child container roots. Vec<NodeARC>'s auto-drop handles recursive
// release through the rc protocol; LeafDirNode's auto-Drop fires the
// chain when this leaf's last Arc share drops.
//
// CFG carries directory-specific layout (key type = ctr_id, fanout, etc.)
// so the same LeafDirNode shape can host different directory cfgs in
// future (e.g. on-disk variants).
pub struct LeafDirNode<K: Container + ContainerOrd, const STORE_CFG: WritStatic, const CFG: WritStatic> {
    pub base: NodeBase<STORE_CFG>,
    pub keys: Buffer<K>,
    pub vals: Vec<NodeARC<STORE_CFG>>,
}

impl<K: Container + ContainerOrd, const STORE_CFG: WritStatic, const CFG: WritStatic> BTreeNode<STORE_CFG> for LeafDirNode<K, STORE_CFG, CFG> {
    fn cfg_hash(&self) -> u64        { return hstatic_hash_of::<CFG>(); }
    fn block_type_hash(&self) -> u64 { return self.base.block_code; }

    // Dir leaves' vals are NodeARC handles to container roots — those
    // ARE this dir leaf's children for the type-erased walk (drop and
    // save/load both want to recurse through them).
    fn child_count(&self) -> u64 { return self.vals.len() as u64; }
    fn child_at(&self, idx: u64) -> *const NodeARC<STORE_CFG> {
        unsafe { return self.vals.at_const(idx as i64); }
    }

    fn cow_clone(&self, new_id: BlockId<STORE_CFG>, snapshot_id: SnpId<STORE_CFG>) -> NodeARC<STORE_CFG> {
        let h: NodeARC<STORE_CFG> = unsafe {
            leaf_dir_alloc::<K, STORE_CFG, CFG>(new_id, snapshot_id)
        };
        unsafe {
            let copy: *mut LeafDirNode<K, STORE_CFG, CFG> =
                node_arc_data_ptr::<STORE_CFG>(&h) as *mut LeafDirNode<K, STORE_CFG, CFG>;
            let nk: u64 = self.keys.len();
            let mut i: u64 = 0u64;
            while i < nk { copy.keys.push(self.keys.get(i)); i = i + 1u64; }
            // Vals: each NodeARC clone bumps the child's rc; both leaves
            // own a share of every dir entry.
            let nv: i64 = self.vals.len();
            let mut j: i64 = 0i64;
            while j < nv {
                let c: &NodeARC<STORE_CFG> = self.vals.borrow(j);
                copy.vals.push(c.clone());
                j = j + 1i64;
            }
        }
        return h;
    }
}

pub fn leaf_dir_alloc<K: Container + ContainerOrd, const STORE_CFG: WritStatic, const CFG: WritStatic>(id: BlockId<STORE_CFG>, snapshot_id: SnpId<STORE_CFG>) -> NodeARC<STORE_CFG> {
    let node: LeafDirNode<K, STORE_CFG, CFG> = LeafDirNode::<K, STORE_CFG, CFG> {
        base: NodeBase::<STORE_CFG> {
            id:          id,
            snapshot_id: snapshot_id,
            is_leaf:     true,
            block_code:  schema_code::<LeafDirNode<K, STORE_CFG, CFG>>(),
        },
        keys: Buffer::<K>::new(),
        vals: vec_new::<NodeARC<STORE_CFG>>(),
    };
    return arc_new::<LeafDirNode<K, STORE_CFG, CFG>>(node) as NodeARC<STORE_CFG>;
}
