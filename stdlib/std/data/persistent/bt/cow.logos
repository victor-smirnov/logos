// std.data.persistent.bt.cow — refcount + path-copy primitives.
//
// All public ops take `*mut NodeBase<K,V,CFG>` and dispatch on
// is_leaf, casting to LeafNode / BranchNode for payload access. The
// common header (rc, n, is_leaf) is read/written through the
// NodeBase pointer directly — that field is at offset 0 of either
// concrete struct.
//
// `node_alloc_c` returns a fresh empty Leaf (back-compat: PMap's
// initial root is a leaf). `node_alloc_internal_c` returns a fresh
// empty Branch. Both return `*mut NodeBase<...>` so callers can
// store them uniformly.

package std.data.persistent.bt.cow;

use std.mem;
use std.data.persistent.bt.node;
use std.data.persistent.bt.registry;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;
use std.hermes.anyval;

// ── Type-erased visitors (passed as fn(u64) -> () via for_each_child).

// Retain: bump rc at offset 0 of the rc-counted child. Universal —
// rc lives at offset 0 of every NodeBase regardless of K/V/CFG.
pub fn retain_visitor(child_u64: u64) {
    if child_u64 == 0u64 { return; }
    unsafe {
        let rcp: *mut u64 = child_u64 as *mut u64;
        *rcp = *rcp + 1u64;
    }
}

// Release: dispatch via the process-global block-ops registry. Looks
// up the child's block_type_hash (offset 16) and invokes the release
// thunk registered for it. Recursion happens through that thunk's
// own for_each_child call (release_visitor → registry.release →
// for_each_child → release_visitor on grand-children, …).
pub fn release_visitor(child_u64: u64) {
    if child_u64 == 0u64 { return; }
    unsafe {
        let h_slot: *mut u64 = (child_u64 as i64 + 16i64) as *mut u64;
        let block_hash: u64 = *h_slot;
        let release_fp: u64 = block_ops_lookup_release(block_hash);
        if release_fp == 0u64 { return; }
        let release: fn(*mut u8) -> () = release_fp as fn(*mut u8) -> ();
        release(child_u64 as *mut u8);
    }
}

// ── Per-schema for_each_child variants.

// Branch: walk children PrimVec, visit each non-zero pointer.
pub fn for_each_child_branch_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(
    node: *mut u8, visit: fn(u64) -> ()
) {
    unsafe {
        let br: *mut BranchNode<K, V, CFG> = node as *mut BranchNode<K, V, CFG>;
        let n: u64 = br.children.len;
        let mut i: u64 = 0u64;
        while i < n {
            let c: *mut NodeBase<K, V, CFG> = br.children.get(i);
            visit(c as u64);
            i = i + 1u64;
        }
    }
}

// Leaf with data vals: no rc-counted children, no-op. Registered for
// every regular (non-directory) container. Cost: a single call /
// return; the registry caller branches on null fp_u64 anyway, so this
// could equivalently be left unregistered — but registering a real
// no-op makes "schema is known to the registry" the source-of-truth
// signal (vs "missing → no-op") which catches missed registrations.
pub fn for_each_child_leaf_data_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(
    node: *mut u8, visit: fn(u64) -> ()
) {
}

// Leaf with pointer vals: walk vals interpreting each u64 as an
// rc-counted child pointer. Registered for the directory CFG and for
// any future `Map<K, *mut Foo>`-style container whose values are
// pointers. The "directory is a continuation upward of container
// trees" pattern from the design notes.
pub fn for_each_child_leaf_ptrs_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(
    node: *mut u8, visit: fn(u64) -> ()
) {
    unsafe {
        let leaf: *mut LeafNode<K, V, CFG> = node as *mut LeafNode<K, V, CFG>;
        let n: u64 = leaf.vals.len();
        let mut i: u64 = 0u64;
        while i < n {
            // Vals stored as V::ViewInStore; for the dir-style use case
            // V is `u64` (raw container-root pointer-as-data) so the
            // cast is a no-op. Other V types using this helper would
            // need to be u64-sized.
            let v: V::ViewInStore = leaf.vals.get(i);
            visit(v as u64);
            i = i + 1u64;
        }
    }
}

// Type-erased release wrapper used in registry — keeps the fn-ptr
// signature uniform (*mut u8) so callers that retrieved the fp via u64
// can call directly without a typed cast.
pub fn node_release_erased<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(node_raw: *mut u8) {
    unsafe { node_release_c::<K, V, CFG>(node_raw as *mut NodeBase<K, V, CFG>); }
}

// Dispatch through the process-global block-ops registry: read
// block_type_hash off the node header (offset 16) and invoke its
// `for_each_child` thunk with the supplied visitor. No-op if the
// block isn't registered (= legacy callsites that allocate nodes
// without going through snap_begin / create_pmap, e.g. early
// pmap-only tests).
unsafe fn for_each_child_via_registry(node: *mut u8, visit: fn(u64) -> ()) {
    let h_slot: *mut u64 = (node as i64 + 16i64) as *mut u64;
    let block_hash: u64 = *h_slot;
    let fp_u64: u64 = block_ops_lookup_for_each_child(block_hash);
    if fp_u64 == 0u64 { return; }
    let fp: fn(*mut u8, fn(u64) -> ()) -> () = fp_u64 as fn(*mut u8, fn(u64) -> ()) -> ();
    fp(node, visit);
}

// ── Registration helpers (called once per CFG at snap_begin /
// create_pmap). Idempotent — registry de-dupes on block_type_hash.

// Register branch + leaf-data ops. For ordinary user containers whose
// leaves hold value data, not child pointers.
pub fn register_data_container_block_ops<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>() {
    let cfg_h: u64 = hstatic_hash_of::<CFG>();
    let h_branch: u64 = type_hash::<BranchNode<K, V, CFG>>() ^ cfg_h;
    let h_leaf:   u64 = type_hash::<LeafNode<K, V, CFG>>()   ^ cfg_h;
    let branch_for_each: fn(*mut u8, fn(u64) -> ()) -> () = for_each_child_branch_c::<K, V, CFG>;
    let leaf_for_each:   fn(*mut u8, fn(u64) -> ()) -> () = for_each_child_leaf_data_c::<K, V, CFG>;
    let release_erased:  fn(*mut u8) -> () = node_release_erased::<K, V, CFG>;
    block_ops_register(h_branch, branch_for_each as u64, release_erased as u64);
    block_ops_register(h_leaf,   leaf_for_each   as u64, release_erased as u64);
}

// Register branch + leaf-pointer ops. For the directory CFG and any
// future container whose leaves hold rc-counted child pointers.
pub fn register_dir_container_block_ops<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>() {
    let cfg_h: u64 = hstatic_hash_of::<CFG>();
    let h_branch: u64 = type_hash::<BranchNode<K, V, CFG>>() ^ cfg_h;
    let h_leaf:   u64 = type_hash::<LeafNode<K, V, CFG>>()   ^ cfg_h;
    let branch_for_each: fn(*mut u8, fn(u64) -> ()) -> () = for_each_child_branch_c::<K, V, CFG>;
    let leaf_for_each:   fn(*mut u8, fn(u64) -> ()) -> () = for_each_child_leaf_ptrs_c::<K, V, CFG>;
    let release_erased:  fn(*mut u8) -> () = node_release_erased::<K, V, CFG>;
    block_ops_register(h_branch, branch_for_each as u64, release_erased as u64);
    block_ops_register(h_leaf,   leaf_for_each   as u64, release_erased as u64);
}

pub fn node_alloc_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>() -> *mut NodeBase<K, V, CFG> {
    let raw: *mut u8 = alloc(sizeof::<LeafNode<K, V, CFG>>());
    let leaf: *mut LeafNode<K, V, CFG> = raw as *mut LeafNode<K, V, CFG>;
    unsafe {
        leaf.base.cfg_hash        = hstatic_hash_of::<CFG>();
        leaf.base.block_type_hash = type_hash::<LeafNode<K, V, CFG>>() ^ hstatic_hash_of::<CFG>();
        leaf.base.rc       = 1u64;
        leaf.base.n        = 0u16;
        leaf.base.is_leaf  = true;
        leaf.keys = Buffer::<K>::new();
        leaf.vals = Buffer::<V>::new();
    }
    return leaf as *mut NodeBase<K, V, CFG>;
}

pub fn node_alloc_internal_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>() -> *mut NodeBase<K, V, CFG> {
    let raw: *mut u8 = alloc(sizeof::<BranchNode<K, V, CFG>>());
    let br: *mut BranchNode<K, V, CFG> = raw as *mut BranchNode<K, V, CFG>;
    unsafe {
        br.base.cfg_hash        = hstatic_hash_of::<CFG>();
        br.base.block_type_hash = type_hash::<BranchNode<K, V, CFG>>() ^ hstatic_hash_of::<CFG>();
        br.base.rc       = 1u64;
        br.base.n        = 0u16;
        br.base.is_leaf  = false;
        br.keys     = Buffer::<K>::new();
        br.children = PrimVec::<*mut NodeBase<K, V, CFG>>::empty();
    }
    return br as *mut NodeBase<K, V, CFG>;
}

pub fn node_retain_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(node: *mut NodeBase<K, V, CFG>) {
    unsafe { node.rc = node.rc + 1u64; }
}

pub fn node_release_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(node: *mut NodeBase<K, V, CFG>) {
    unsafe {
        node.rc = node.rc - 1u64;
        if node.rc == 0u64 {
            if node.is_leaf {
                // Dir-flavour leaves have rc-counted vals — release each
                // via registry-dispatched for_each_child + release_visitor
                // before tearing down the leaf payload. Data-flavour leaves
                // are no-op at registry level. Unregistered leaves (legacy
                // pmap-only tests) also no-op via the lookup-miss path.
                for_each_child_via_registry(node as *mut u8, release_visitor);
                let leaf: *mut LeafNode<K, V, CFG> = node as *mut LeafNode<K, V, CFG>;
                let kp: *mut Buffer<K> = &mut leaf.keys as *mut Buffer<K>;
                let vp: *mut Buffer<V> = &mut leaf.vals as *mut Buffer<V>;
                kp.drop_in_place();
                vp.drop_in_place();
                dealloc(leaf as *mut u8);
            } else {
                let br: *mut BranchNode<K, V, CFG> = node as *mut BranchNode<K, V, CFG>;
                let nc: u64 = br.children.len;
                let mut i: u64 = 0u64;
                while i < nc {
                    let c: *mut NodeBase<K, V, CFG> = br.children.get(i);
                    node_release_c::<K, V, CFG>(c);
                    i = i + 1u64;
                }
                br.children.clear();
                let kp: *mut Buffer<K> = &mut br.keys as *mut Buffer<K>;
                kp.drop_in_place();
                dealloc(br as *mut u8);
            }
        }
    }
}

pub fn node_clone_for_cow_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(orig: *mut NodeBase<K, V, CFG>) -> *mut NodeBase<K, V, CFG> {
    unsafe {
        if orig.is_leaf {
            let src: *mut LeafNode<K, V, CFG> = orig as *mut LeafNode<K, V, CFG>;
            let copy: *mut NodeBase<K, V, CFG> = node_alloc_c::<K, V, CFG>();
            let dst: *mut LeafNode<K, V, CFG> = copy as *mut LeafNode<K, V, CFG>;
            let mut i: u64 = 0u64;
            while i < src.keys.len() {
                let kp: K::ViewInStore = src.keys.get(i);
                dst.keys.push(kp);
                i = i + 1u64;
            }
            i = 0u64;
            while i < src.vals.len() {
                let vp: V::ViewInStore = src.vals.get(i);
                dst.vals.push(vp);
                i = i + 1u64;
            }
            copy.n = orig.n;
            // Dir-flavour leaves hold rc-counted child pointers in vals
            // — retain each so the new clone owns its own refs, paired
            // with the future release_visitor walk when this clone (or
            // the original) drops to rc=0 in node_release_c. Data-flavour
            // leaves are no-op via registry. Dispatch through the copy
            // (they share block_type_hash so either works).
            for_each_child_via_registry(copy as *mut u8, retain_visitor);
            return copy;
        }
        let src: *mut BranchNode<K, V, CFG> = orig as *mut BranchNode<K, V, CFG>;
        let copy: *mut NodeBase<K, V, CFG> = node_alloc_internal_c::<K, V, CFG>();
        let dst: *mut BranchNode<K, V, CFG> = copy as *mut BranchNode<K, V, CFG>;
        let mut i: u64 = 0u64;
        while i < src.keys.len() {
            let kp: K::ViewInStore = src.keys.get(i);
            dst.keys.push(kp);
            i = i + 1u64;
        }
        i = 0u64;
        let nc: u64 = src.children.len;
        while i < nc {
            let c: *mut NodeBase<K, V, CFG> = src.children.get(i);
            node_retain_c::<K, V, CFG>(c);
            dst.children.push(c);
            i = i + 1u64;
        }
        copy.n = orig.n;
        return copy;
    }
}

// Pre-write CoW step: ensure the child at `idx` of `parent_branch` is
// uniquely owned before mutating it.
pub fn node_make_child_unique_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(node: *mut NodeBase<K, V, CFG>, idx: u64) {
    unsafe {
        let br: *mut BranchNode<K, V, CFG> = node as *mut BranchNode<K, V, CFG>;
        let c: *mut NodeBase<K, V, CFG> = br.children.get(idx);
        if c.rc > 1u64 {
            let copy: *mut NodeBase<K, V, CFG> = node_clone_for_cow_c::<K, V, CFG>(c);
            node_release_c::<K, V, CFG>(c);
            br.children.set(idx, copy);
        }
    }
}
