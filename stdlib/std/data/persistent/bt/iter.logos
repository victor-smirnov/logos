// std.data.persistent.bt.iter — leaf-walker over the bt B+tree.
//
// Iterator = path-from-root-to-leaf (per feedback_iter_no_record_pos);
// no record-level cursor. Frames carry *mut NodeBase — the iterator
// is type-uniform regardless of frame kind. `leaf_iter_leaf` returns
// a typed *mut LeafNode for client-side flat scans of `leaf.keys`
// and `leaf.vals`.

package std.data.persistent.bt.iter;

use std.data.persistent.bt.node;
use std.data.persistent.bt.descent;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.lang.drop;
use std.hermes.view;
use std.hermes.anyval;

pub struct LeafIter<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic> {
    pub frames_node: PrimVec<*mut NodeBase<K, V, CFG>>,
    pub frames_idx:  PrimVec<u64>,
}

unsafe fn descend_leftmost_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(it: *mut LeafIter<K, V, CFG>, start: *mut NodeBase<K, V, CFG>) {
    let mut cur: *mut NodeBase<K, V, CFG> = start;
    loop {
        it.frames_node.push(cur);
        it.frames_idx.push(0u64);
        if cur.is_leaf { return; }
        let br: *mut BranchNode<K, V, CFG> = cur as *mut BranchNode<K, V, CFG>;
        cur = br.children.get(0u64);
    }
}

unsafe fn descend_rightmost_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(it: *mut LeafIter<K, V, CFG>, start: *mut NodeBase<K, V, CFG>) {
    let mut cur: *mut NodeBase<K, V, CFG> = start;
    loop {
        if cur.is_leaf {
            it.frames_node.push(cur);
            it.frames_idx.push(0u64);
            return;
        }
        let br: *mut BranchNode<K, V, CFG> = cur as *mut BranchNode<K, V, CFG>;
        let last: u64 = br.children.len - 1u64;
        it.frames_node.push(cur);
        it.frames_idx.push(last);
        cur = br.children.get(last);
    }
}

pub fn acquire_leaf_iter_from_root<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(root: *mut NodeBase<K, V, CFG>) -> LeafIter<K, V, CFG> {
    unsafe {
        let mut it: LeafIter<K, V, CFG> = LeafIter::<K, V, CFG> {
            frames_node: PrimVec::<*mut NodeBase<K, V, CFG>>::empty(),
            frames_idx:  PrimVec::<u64>::empty(),
        };
        let itp: *mut LeafIter<K, V, CFG> = &mut it as *mut LeafIter<K, V, CFG>;
        descend_leftmost_c::<K, V, CFG>(itp, root);
        return it;
    }
}

pub fn acquire_leaf_iter_from_root_last<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(root: *mut NodeBase<K, V, CFG>) -> LeafIter<K, V, CFG> {
    unsafe {
        let mut it: LeafIter<K, V, CFG> = LeafIter::<K, V, CFG> {
            frames_node: PrimVec::<*mut NodeBase<K, V, CFG>>::empty(),
            frames_idx:  PrimVec::<u64>::empty(),
        };
        let itp: *mut LeafIter<K, V, CFG> = &mut it as *mut LeafIter<K, V, CFG>;
        descend_rightmost_c::<K, V, CFG>(itp, root);
        return it;
    }
}

pub fn release_leaf_iter<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(it: *mut LeafIter<K, V, CFG>) {
    unsafe {
        it.frames_node.clear();
        it.frames_idx.clear();
    }
}

// Auto-Drop releases the parallel PrimVec stacks. The iter borrows
// snapshot nodes — no rc bumping/decrementing here.
impl<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic> Drop for LeafIter<K, V, CFG> {
    fn drop(self: LeafIter<K, V, CFG>) {
        unsafe {
            let p: *mut LeafIter<K, V, CFG> = &self as *const LeafIter<K, V, CFG> as *mut LeafIter<K, V, CFG>;
            release_leaf_iter::<K, V, CFG>(p);
        }
    }
}

pub fn leaf_iter_valid<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(it: *const LeafIter<K, V, CFG>) -> bool {
    unsafe { return it.frames_node.len > 0u64; }
}

pub fn leaf_iter_leaf<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(it: *const LeafIter<K, V, CFG>) -> *mut LeafNode<K, V, CFG> {
    unsafe {
        let n: u64 = it.frames_node.len;
        let nb: *mut NodeBase<K, V, CFG> = it.frames_node.get(n - 1u64);
        return nb as *mut LeafNode<K, V, CFG>;
    }
}

pub fn leaf_iter_size<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(it: *const LeafIter<K, V, CFG>) -> u64 {
    unsafe {
        let leaf: *mut LeafNode<K, V, CFG> = leaf_iter_leaf::<K, V, CFG>(it);
        return leaf.keys.len();
    }
}

unsafe fn pop_frame_c<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(it: *mut LeafIter<K, V, CFG>) {
    let n: u64 = it.frames_node.len;
    it.frames_node.remove_at(n - 1u64);
    it.frames_idx.remove_at(n - 1u64);
}

pub fn leaf_iter_next_leaf<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(it: *mut LeafIter<K, V, CFG>) {
    unsafe {
        if it.frames_node.len == 0u64 { return; }
        pop_frame_c::<K, V, CFG>(it);
        loop {
            if it.frames_node.len == 0u64 { return; }
            let top: u64 = it.frames_node.len - 1u64;
            let parent: *mut NodeBase<K, V, CFG> = it.frames_node.get(top);
            let parent_br: *mut BranchNode<K, V, CFG> = parent as *mut BranchNode<K, V, CFG>;
            let pidx: u64 = it.frames_idx.get(top);
            let nc: u64 = parent_br.children.len;
            if pidx + 1u64 < nc {
                it.frames_idx.set(top, pidx + 1u64);
                let child: *mut NodeBase<K, V, CFG> = parent_br.children.get(pidx + 1u64);
                descend_leftmost_c::<K, V, CFG>(it, child);
                return;
            }
            pop_frame_c::<K, V, CFG>(it);
        }
    }
}

pub fn leaf_iter_prev_leaf<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(it: *mut LeafIter<K, V, CFG>) {
    unsafe {
        if it.frames_node.len == 0u64 { return; }
        pop_frame_c::<K, V, CFG>(it);
        loop {
            if it.frames_node.len == 0u64 { return; }
            let top: u64 = it.frames_node.len - 1u64;
            let parent: *mut NodeBase<K, V, CFG> = it.frames_node.get(top);
            let parent_br: *mut BranchNode<K, V, CFG> = parent as *mut BranchNode<K, V, CFG>;
            let pidx: u64 = it.frames_idx.get(top);
            if pidx > 0u64 {
                it.frames_idx.set(top, pidx - 1u64);
                let child: *mut NodeBase<K, V, CFG> = parent_br.children.get(pidx - 1u64);
                descend_rightmost_c::<K, V, CFG>(it, child);
                return;
            }
            pop_frame_c::<K, V, CFG>(it);
        }
    }
}

// ── Search → (iter, pos, hit) ────────────────────────────────────
//
// Per feedback_iter_no_record_pos: the iterator is the *tree position*
// (path stack); the in-leaf cursor is the search's one-shot output,
// not iter state. `Found` packages the path-positioned iter with the
// initial in-leaf slot and an exact-match flag. The caller walks
// their own `j` from `pos` over `leaf.keys`/`leaf.vals`.
//
// `pos` is a lower-bound: it points at the first key >= `key`, or at
// `leaf.keys.len()` if every key in the rightmost leaf is smaller
// than the query (past-end). Iter is always valid (path to a leaf
// exists for any non-empty tree).
pub struct Found<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic> {
    pub it:  LeafIter<K, V, CFG>,
    pub pos: u64,
    pub hit: bool,
}

// Binary-leaf-search variant of find_lb_from_root. Symmetric to the
// `node_contains_rec_c` / `node_contains_rec_binary_c` pair — branch
// descent stays linear (small fanout), the leaf step is binary. Same
// `Found` contract.
pub fn find_lb_binary_from_root<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(root: *mut NodeBase<K, V, CFG>, key: *const K) -> Found<K, V, CFG> {
    unsafe {
        let mut it: LeafIter<K, V, CFG> = LeafIter::<K, V, CFG> {
            frames_node: PrimVec::<*mut NodeBase<K, V, CFG>>::empty(),
            frames_idx:  PrimVec::<u64>::empty(),
        };
        let itp: *mut LeafIter<K, V, CFG> = &mut it as *mut LeafIter<K, V, CFG>;
        let mut cur: *mut NodeBase<K, V, CFG> = root;
        let mut pos: u64 = 0u64;
        let mut hit: bool = false;
        loop {
            if cur.is_leaf {
                itp.frames_node.push(cur);
                itp.frames_idx.push(0u64);
                let leaf: *mut LeafNode<K, V, CFG> = cur as *mut LeafNode<K, V, CFG>;
                pos = binary_lower_bound_in_leaf_c::<K, V, CFG>(cur, key);
                if pos < leaf.keys.len() {
                    let kv: K::ViewInStore = leaf.keys.get(pos);
                    let phantom: *const K = 0 as *const K;
                    match phantom.cmp_view_key(kv, key) {
                        Ordering::Equal => { hit = true; }
                        _ => { }
                    }
                }
                break;
            }
            let br: *mut BranchNode<K, V, CFG> = cur as *mut BranchNode<K, V, CFG>;
            let idx: u64 = node_descend_idx_c::<K, V, CFG>(cur, key);
            itp.frames_node.push(cur);
            itp.frames_idx.push(idx);
            cur = br.children.get(idx);
        }
        return Found::<K, V, CFG> { it: it, pos: pos, hit: hit };
    }
}

pub fn find_lb_from_root<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(root: *mut NodeBase<K, V, CFG>, key: *const K) -> Found<K, V, CFG> {
    unsafe {
        let mut it: LeafIter<K, V, CFG> = LeafIter::<K, V, CFG> {
            frames_node: PrimVec::<*mut NodeBase<K, V, CFG>>::empty(),
            frames_idx:  PrimVec::<u64>::empty(),
        };
        let itp: *mut LeafIter<K, V, CFG> = &mut it as *mut LeafIter<K, V, CFG>;
        let mut cur: *mut NodeBase<K, V, CFG> = root;
        let mut pos: u64 = 0u64;
        let mut hit: bool = false;
        loop {
            if cur.is_leaf {
                itp.frames_node.push(cur);
                itp.frames_idx.push(0u64);
                let leaf: *mut LeafNode<K, V, CFG> = cur as *mut LeafNode<K, V, CFG>;
                pos = node_lower_bound_c::<K, V, CFG>(cur, key);
                if pos < leaf.keys.len() {
                    let kv: K::ViewInStore = leaf.keys.get(pos);
                    let phantom: *const K = 0 as *const K;
                    match phantom.cmp_view_key(kv, key) {
                        Ordering::Equal => { hit = true; }
                        _ => { }
                    }
                }
                break;
            }
            let br: *mut BranchNode<K, V, CFG> = cur as *mut BranchNode<K, V, CFG>;
            let idx: u64 = node_descend_idx_c::<K, V, CFG>(cur, key);
            itp.frames_node.push(cur);
            itp.frames_idx.push(idx);
            cur = br.children.get(idx);
        }
        return Found::<K, V, CFG> { it: it, pos: pos, hit: hit };
    }
}
