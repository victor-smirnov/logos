// SPDX-License-Identifier: Apache-2.0
// std.data.persistent.bt.registry — process-global block-ops registry.
//
// Mirrors big-Memoria's ProfileMetadata::local() table. Indexed by
// `block_type_hash` (= type_hash::<NodeSchema>(), populated at offset
// 16 of every NodeBase at alloc time). Each entry binds two type-erased
// fn-pointers:
//
//   for_each_child(node, visit_u64) — walks rc-counted children of
//                                     `node` (branch children, dir-leaf
//                                     vals; no-op for data leaves).
//   release(node)                   — single-rc decrement; on rc=0,
//                                     recursively releases children
//                                     via for_each_child + release
//                                     visitor + frees the node.
//
// Lifecycle: registry is process-singleton. Registration is idempotent
// per block_type_hash and happens during `snap_begin` / `create_pmap`
// (registers Branch + Leaf for the relevant CFG). Lookups are
// non-blocking pointer-vector reads — registrations only ever grow the
// table.

package std.data.persistent.bt.registry;

// C-side primitives in stdlib/rt/block_ops_registry.c. fn-pointers are
// passed as u64 to keep the C ABI flat; the Logos side does the typed
// cast at call time.
extern fn logos_block_ops_register(block_hash: u64,
                                   for_each_child_fp: u64,
                                   release_fp: u64);
extern fn logos_block_ops_lookup_for_each_child(block_hash: u64) -> u64;
extern fn logos_block_ops_lookup_release(block_hash: u64) -> u64;

// Public Logos surface: thin wrappers that match the way handle.logos
// and bt/cow.logos expect to call them.

pub fn block_ops_register(block_hash: u64,
                          for_each_child_fp: u64,
                          release_fp: u64) {
    unsafe { logos_block_ops_register(block_hash, for_each_child_fp, release_fp); }
}

pub fn block_ops_lookup_for_each_child(block_hash: u64) -> u64 {
    return unsafe { logos_block_ops_lookup_for_each_child(block_hash) };
}

pub fn block_ops_lookup_release(block_hash: u64) -> u64 {
    return unsafe { logos_block_ops_lookup_release(block_hash) };
}
