// SPDX-License-Identifier: Apache-2.0
// Logos standard library — std.data.persistent.map
//
// PMap<K, V> — persistent map handle.  In Memoria terminology this is a
// Container: a wrapper that *holds no memory of its own*; the data lives
// in the Store (here: a B+tree root reachable from the handle, with
// intrusive ARC and CoW path-copy on mutation).
//
// v1 limitations (deliberate, design-level):
//   - linear scan within a node (no binary search yet).
//   - removal does not merge or redistribute; once a tree grows past one
//     leaf, its height never shrinks.  Empty leaves are valid.
//   - no Store/Snapshot type yet — PMap owns its root directly via ARC.

package std.data.persistent.map;

use std.data.persistent.btree.node;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;

pub struct PMap<K: Container + ContainerOrd, V: Container> {
    pub root: *mut BTreeNode<K, V>,
}

// Allocate a fresh, empty map (root = single empty leaf, rc=1).
pub fn map_new<K: Container + ContainerOrd, V: Container>() -> PMap<K, V> {
    return PMap::<K, V> { root: node_alloc::<K, V>() };
}

// Release the root; caller must not use the handle afterwards.
pub fn map_drop<K: Container + ContainerOrd, V: Container>(m: *mut PMap<K, V>) {
    unsafe { node_release::<K, V>(m.root); }
}

// Number of (key, val) pairs in the map.  Walks the whole tree.
pub fn map_len<K: Container + ContainerOrd, V: Container>(m: *const PMap<K, V>) -> u64 {
    unsafe { return node_size_rec::<K, V>(m.root); }
}

// Single-leaf debug helper: returns the index of `key` in the root leaf,
// or -1 on miss.  Only meaningful before the root has split (root is a
// leaf).  Kept for backwards compat with the leaf-only test suite.
pub fn map_find<K: Container + ContainerOrd, V: Container>(m: *const PMap<K, V>, key: *const K) -> i64 {
    unsafe {
        let r: *mut BTreeNode<K, V> = m.root;
        if !r.is_leaf { return -1i64; }
        return node_find::<K, V>(r, key);
    }
}

// True iff `key` is present anywhere in the tree.
pub fn map_contains<K: Container + ContainerOrd, V: Container>(m: *const PMap<K, V>, key: *const K) -> bool {
    unsafe { return node_contains_rec::<K, V>(m.root, key); }
}

// Snapshot the map: returns a fresh handle sharing the same root with rc++.
// Both handles are independent — mutating either path-copies on the
// shared nodes (CoW), so the other observes its frozen view.
pub fn map_snapshot<K: Container + ContainerOrd, V: Container>(m: *const PMap<K, V>) -> PMap<K, V> {
    unsafe {
        let r: *mut BTreeNode<K, V> = m.root;
        node_retain::<K, V>(r);
        return PMap::<K, V> { root: r };
    }
}

// If the root is shared (rc > 1), clone it and swap; releases the old
// reference so refcounts stay balanced.  After this call, m.root is
// guaranteed to be uniquely owned and safe to mutate in place.
fn map_make_root_unique<K: Container + ContainerOrd, V: Container>(m: *mut PMap<K, V>) {
    unsafe {
        let r: *mut BTreeNode<K, V> = m.root;
        if r.rc > 1u64 {
            let copy: *mut BTreeNode<K, V> = node_clone_for_cow::<K, V>(r);
            node_release::<K, V>(r);
            m.root = copy;
        }
    }
}

// Build a new internal root from the previous root + its split right
// sibling.  Used when the recursive insert at the root level returns a
// split: tree grows by one level.
fn map_grow_root<K: Container + ContainerOrd, V: Container>(m: *mut PMap<K, V>, right: *mut BTreeNode<K, V>) {
    unsafe {
        let new_root: *mut BTreeNode<K, V> = node_alloc_internal::<K, V>();
        let sep: K::ViewInStore = right.keys.get(0u64);
        new_root.keys.push(sep);
        new_root.children.push(m.root);
        new_root.children.push(right);
        if !right.is_leaf {
            // Internal split: separator was held at right.keys[0]; remove now.
            right.keys.remove_at(0u64);
            right.n = right.keys.len() as u16;
        }
        new_root.n = new_root.keys.len() as u16;
        m.root = new_root;
    }
}

// Insert (key, val) when caller knows the key is fresh.  Now that the
// tree maintains an ordering invariant, this is just a thin shim over
// `map_insert`; the `qkey` argument is the comparable pointer view of
// `key`.  Kept for source compat with the leaf-only API.
pub fn map_insert_new<K: Container + ContainerOrd, V: Container>(m: *mut PMap<K, V>, key: K::ViewInStore, qkey: *const K, val: V::ViewInStore) {
    unsafe { map_insert::<K, V>(m, key, val, qkey); }
}

// Read the value for `key` into `out`; returns true on hit.
pub fn map_get<K: Container + ContainerOrd, V: Container>(m: *const PMap<K, V>, key: *const K, out: *mut V::ViewInStore) -> bool {
    unsafe { return node_get_rec::<K, V>(m.root, key, out); }
}

// Upsert: if `key` is present, overwrite the existing value (returns
// true); otherwise insert (key, val) in order and return false.
// Path-copies the path from root down on mutation.
pub fn map_insert<K: Container + ContainerOrd, V: Container>(m: *mut PMap<K, V>, key: K::ViewInStore, val: V::ViewInStore, qkey: *const K) -> bool {
    unsafe {
        map_make_root_unique::<K, V>(m);
        let outcome: InsertOutcome<K, V> = node_insert_rec::<K, V>(m.root, key, val, qkey);
        if outcome.split {
            map_grow_root::<K, V>(m, outcome.right);
        }
        return outcome.hit;
    }
}

// Remove the entry with key == `key`; returns true on hit, false on
// miss.  Path-copies the descent path on hit; miss leaves the tree
// untouched.
pub fn map_remove<K: Container + ContainerOrd, V: Container>(m: *mut PMap<K, V>, key: *const K) -> bool {
    unsafe {
        if !node_contains_rec::<K, V>(m.root, key) { return false; }
        map_make_root_unique::<K, V>(m);
        return node_remove_rec::<K, V>(m.root, key);
    }
}
