// std.data.persistent.descent — read-side BTree walkers on NodeARC.
//
// Walkers follow the legacy bt.descent.* shape but operate on
// NodeARC<STORE_CFG> handles instead of raw `*mut NodeBase`. Cast to
// typed `*mut LeafNode<...>` / `*mut BranchNode<...>` via header.is_leaf.
// Branch descent reads child NodeARCs from `Vec<NodeARC>` slots and
// recurses; no CoW, no rc bumps (read-only access through borrow).

package std.data.persistent.descent;

use std.collections.vec;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;
use std.hermes.anyval;

use std.data.persistent.node;
use std.data.persistent.cow;
use std.data.persistent.shuttle;

// ── CFG fanout readers ────────────────────────────────────────────────
unsafe fn cfg_int_or<const CFG: HermesStatic>(key: str, dflt: u64) -> u64 {
    let v = CFG.as_view();
    let av: AnyVal = v.map_get(v.root(), key);
    if av.is_null() { return dflt; }
    if !av.is_int() { return dflt; }
    return av.as_i64() as u64;
}

pub unsafe fn max_keys_branch<const CFG: HermesStatic>() -> u64 {
    let fb: u64 = cfg_int_or::<CFG>("fanout_branch", 0u64);
    if fb > 0u64 { return fb; }
    let f: u64 = cfg_int_or::<CFG>("fanout", 0u64);
    if f > 0u64 { return f; }
    return 4u64;
}

pub unsafe fn max_keys_leaf<const CFG: HermesStatic>() -> u64 {
    let fl: u64 = cfg_int_or::<CFG>("fanout_leaf", 0u64);
    if fl > 0u64 { return fl; }
    let f: u64 = cfg_int_or::<CFG>("fanout", 0u64);
    if f > 0u64 { return f; }
    return 4u64;
}

// Underflow thresholds for remove rebalance. A node with fewer than
// min_keys is "underflowed" and must borrow from a sibling or merge.
// Convention: ceil(M/2) − 1 keys is the strict minimum (so that two
// adjacent under-min siblings always fit into one node ≤ M). For
// min_keys = M/2 (integer div), max combined is 2*(M/2-1) + 1 = M-1
// for branches (incl. promoted parent key) — fits, equal at M=4.
pub unsafe fn min_keys_branch<const CFG: HermesStatic>() -> u64 {
    let m: u64 = max_keys_branch::<CFG>();
    if m < 2u64 { return 1u64; }
    return m / 2u64;
}
pub unsafe fn min_keys_leaf<const CFG: HermesStatic>() -> u64 {
    let m: u64 = max_keys_leaf::<CFG>();
    if m < 2u64 { return 1u64; }
    return m / 2u64;
}

// ── Header reads via NodeARC ──────────────────────────────────────────
pub unsafe fn arc_is_leaf<const STORE_CFG: HermesStatic>(arc: &NodeARC<STORE_CFG>) -> bool {
    let dp: *mut u8 = node_arc_data_ptr::<STORE_CFG>(arc);
    let isleaf_p: *mut bool = (dp as i64 + 24i64) as *mut bool;
    return *isleaf_p;
}

pub unsafe fn as_leaf<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    arc: &NodeARC<STORE_CFG>
) -> *mut LeafNode<K, V, STORE_CFG, CFG> {
    return node_arc_data_ptr::<STORE_CFG>(arc) as *mut LeafNode<K, V, STORE_CFG, CFG>;
}

pub unsafe fn as_branch<K: Container + ContainerOrd, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    arc: &NodeARC<STORE_CFG>
) -> *mut BranchNode<K, STORE_CFG, CFG> {
    return node_arc_data_ptr::<STORE_CFG>(arc) as *mut BranchNode<K, STORE_CFG, CFG>;
}

// ── In-leaf find / lower_bound ────────────────────────────────────────
pub fn leaf_find<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    leaf: *mut LeafNode<K, V, STORE_CFG, CFG>, key: *const K
) -> i64 {
    unsafe {
        let n: u64 = leaf.keys.len();
        let mut i: u64 = 0u64;
        let phantom: *const K = 0 as *const K;
        while i < n {
            let kv: K::ViewInStore = leaf.keys.get(i);
            match phantom.cmp_view_key(kv, key) {
                Ordering::Equal => { return i as i64; }
                _ => { }
            }
            i = i + 1u64;
        }
        return -1i64;
    }
}

pub fn leaf_lower_bound<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    leaf: *mut LeafNode<K, V, STORE_CFG, CFG>, key: *const K
) -> u64 {
    unsafe {
        let n: u64 = leaf.keys.len();
        let mut i: u64 = 0u64;
        let phantom: *const K = 0 as *const K;
        while i < n {
            let kv: K::ViewInStore = leaf.keys.get(i);
            match phantom.cmp_view_key(kv, key) {
                Ordering::Less => { i = i + 1u64; }
                _ => { return i; }
            }
        }
        return n;
    }
}

// ── Branch descent index ──────────────────────────────────────────────
// Memoria-style invariant: keys[i] = max key in children[i]. N keys ↔ N
// children (parallel arrays). Returns smallest i where keys[i] >= key
// (the subtree that may contain the key — its max is ≥ target). If no
// such i (target > all maxes), returns n. Callers handle:
//   • read (contains/get): n means "not in tree"; return false.
//   • insert: saturate to n−1 (descend last child, extend it); the new
//     max bubbles up via parent.keys[i] = child.keys[last] update.
pub fn branch_descend_idx<K: Container + ContainerOrd, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    branch: *mut BranchNode<K, STORE_CFG, CFG>, key: *const K
) -> u64 {
    unsafe {
        let n: u64 = branch.keys.len();
        let mut i: u64 = 0u64;
        let phantom: *const K = 0 as *const K;
        while i < n {
            let kv: K::ViewInStore = branch.keys.get(i);
            match phantom.cmp_view_key(kv, key) {
                Ordering::Less => { i = i + 1u64; }
                _ => { return i; }     // keys[i] ≥ key
            }
        }
        return n;
    }
}

// ── Recursive walks via NodeARC ───────────────────────────────────────
pub fn pmap_contains_rec<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    arc: &NodeARC<STORE_CFG>, key: *const K
) -> bool {
    unsafe {
        if arc_is_leaf::<STORE_CFG>(arc) {
            let leaf = as_leaf::<K, V, STORE_CFG, CFG>(arc);
            return leaf_find::<K, V, STORE_CFG, CFG>(leaf, key) >= 0i64;
        }
        let br = as_branch::<K, STORE_CFG, CFG>(arc);
        let i: u64 = branch_descend_idx::<K, STORE_CFG, CFG>(br, key);
        if i >= br.children.length() as u64 { return false; }   // key > all maxes
        let child: &NodeARC<STORE_CFG> = br.children.borrow(i as i64);
        return pmap_contains_rec::<K, V, STORE_CFG, CFG>(child, key);
    }
}

pub fn pmap_get_rec<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    arc: &NodeARC<STORE_CFG>, key: *const K, out: *mut V::ViewInStore
) -> bool {
    unsafe {
        if arc_is_leaf::<STORE_CFG>(arc) {
            let leaf = as_leaf::<K, V, STORE_CFG, CFG>(arc);
            let idx: i64 = leaf_find::<K, V, STORE_CFG, CFG>(leaf, key);
            if idx < 0i64 { return false; }
            *out = leaf.vals.get(idx as u64);
            return true;
        }
        let br = as_branch::<K, STORE_CFG, CFG>(arc);
        let i: u64 = branch_descend_idx::<K, STORE_CFG, CFG>(br, key);
        if i >= br.children.length() as u64 { return false; }   // key > all maxes
        let child: &NodeARC<STORE_CFG> = br.children.borrow(i as i64);
        return pmap_get_rec::<K, V, STORE_CFG, CFG>(child, key, out);
    }
}

// ── Shuttle-driven descent: seek to the n-th key in sorted order ──────
//
// Walks the tree from `arc` to the leaf that contains the n-th key
// (zero-indexed), composing per-level `branchnode_subtree_size_shuttle`
// calls into a multi-level descent. SUM aggregate column on each
// BranchNode tells the shuttle which child holds slot N at its level
// in O(num_children); the descent itself is O(depth).
//
// On success returns a clone'd NodeARC for the leaf (rc bumped — caller
// drops normally) and writes the leaf-relative index into *out_idx.
// On out-of-range, returns a null-handle NodeARC (NodeARC::drop is a
// no-op for null) and writes 0 into *out_idx.
pub unsafe fn pmap_descend_to_n<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    arc: &NodeARC<STORE_CFG>, n: u64, out_idx: *mut u64,
) -> NodeARC<STORE_CFG> {
    let mut cur: NodeARC<STORE_CFG> = arc.clone_arc();
    let mut target: u64 = n;
    loop {
        let dp: *mut u8 = node_arc_data_ptr::<STORE_CFG>(&cur);
        let isleaf_p: *mut bool = (dp as i64 + 24i64) as *mut bool;
        if *isleaf_p { break; }
        let br: *const BranchNode<K, STORE_CFG, CFG> =
            dp as *const BranchNode<K, STORE_CFG, CFG>;
        let r: ShuttleResult = branchnode_subtree_size_shuttle::<K, STORE_CFG, CFG>(br, target);
        let nc: u64 = br.children.length() as u64;
        if r.idx >= nc {
            *out_idx = 0u64;
            return NodeARC::<STORE_CFG> { p: 0 as *mut dyn BTreeNode<STORE_CFG> };
        }
        let child_ref: &NodeARC<STORE_CFG> = br.children.borrow(r.idx as i64);
        let child_arc: NodeARC<STORE_CFG> = child_ref.clone_arc();
        target = r.remainder;
        cur = child_arc;
    }
    // At leaf — verify target within range.
    let dp_leaf: *mut u8 = node_arc_data_ptr::<STORE_CFG>(&cur);
    let leaf: *const LeafNode<K, V, STORE_CFG, CFG> =
        dp_leaf as *const LeafNode<K, V, STORE_CFG, CFG>;
    if target >= leaf.keys.len() {
        *out_idx = 0u64;
        return NodeARC::<STORE_CFG> { p: 0 as *mut dyn BTreeNode<STORE_CFG> };
    }
    *out_idx = target;
    return cur;
}

pub fn pmap_size_rec<K: Container + ContainerOrd, V: Container, const STORE_CFG: HermesStatic, const CFG: HermesStatic>(
    arc: &NodeARC<STORE_CFG>
) -> u64 {
    unsafe {
        if arc_is_leaf::<STORE_CFG>(arc) {
            let leaf = as_leaf::<K, V, STORE_CFG, CFG>(arc);
            return leaf.keys.len();
        }
        let br = as_branch::<K, STORE_CFG, CFG>(arc);
        let nc: i64 = br.children.length();
        // Fast path: SUM aggregate column maintained — sum slot-by-slot
        // without descending. Slow path: column empty (mutate.logos's
        // insert/remove maintenance not landed yet) — recursive walk.
        // Both produce the same total; the column lets us skip descent.
        if br.subtree_size.len == (nc as u64) && nc > 0i64 {
            let mut total: u64 = 0u64;
            let mut i: u64 = 0u64;
            let nu: u64 = nc as u64;
            while i < nu {
                total = total + br.subtree_size.get(i);
                i = i + 1u64;
            }
            return total;
        }
        let mut total: u64 = 0u64;
        let mut i: i64 = 0i64;
        while i < nc {
            let child: &NodeARC<STORE_CFG> = br.children.borrow(i);
            total = total + pmap_size_rec::<K, V, STORE_CFG, CFG>(child);
            i = i + 1i64;
        }
        return total;
    }
}
