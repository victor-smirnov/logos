// std.data.persistent.snapshot — ISnapshot trait.
//
// Mirrors big-Memoria's IMemorySnapshot (and IROStoreWritableSnapshotCtrOps)
// surface that abstracts container-directory ops. Every container talks to
// its snapshot through these three methods only — the snapshot decides how
// the directory itself is laid out (BTree today, RootMap=Map<CtrID,BlockID>
// once we close that loop). Concrete impls live next to each Store flavour;
// for the in-mem MVP, `Snap<STORE_CFG>` from `handle.logos` implements it.
//
// Conventions:
//   • ctr_id == 0u64 is reserved as the "directory itself" sentinel —
//     get_root(0) returns the directory's own root pointer; set_root(0, r)
//     replaces it. Mirrors big-Memoria's null-name semantics on
//     getRootID/setRoot. User containers must use ctr_id != 0.
//   • root is a u64 (BlockID-as-pointer in the in-mem store; opaque
//     handle in on-disk variants). 0u64 means "no root".

package std.data.persistent.snapshot;

// ISnapshot — narrow contract through which containers talk to the
// snapshot directory. Three methods total; everything containers do
// (create/open/find/drop their root) goes through these.
//
// Designed as a `dyn`-friendly trait so containers can be parameterised
// over `&mut dyn ISnapshot` rather than the concrete Snap type. That
// enables a single container compilation to serve every store flavour
// once we have multiple — exactly the isolation seam called out in
// `project_mini_memoria_isolation_model.md`.
pub trait ISnapshot {
    // True iff the snapshot's directory has a root registered for ctr_id.
    // For ctr_id == 0u64, true iff the directory itself has a root.
    fn has_root(&mut self, ctr_id: u64) -> bool;

    // Return the registered root for ctr_id (0u64 sentinel = directory
    // root). Returns 0u64 if no entry exists. Does NOT retain.
    fn get_root(&mut self, ctr_id: u64) -> u64;

    // Register `root` under ctr_id. For ctr_id == 0u64, replaces the
    // directory's own root (used by mutating ops on the directory
    // container itself, when RootMap-as-container lands). For non-zero
    // ctr_id, upserts the entry (CoW-cloning the directory tree as
    // needed). The MVP in-mem impl performs no ref/unref — caller
    // arranged that — but on-disk Stores will plumb the ballet here.
    fn set_root(&mut self, ctr_id: u64, root: u64);
}

// Reserved sentinel for "the directory itself" — same role as a null
// CtrID in big Memoria's getRootID/setRoot.
pub let NULL_CTR_ID: u64 = 0u64;
