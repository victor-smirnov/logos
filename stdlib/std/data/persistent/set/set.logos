// Logos standard library — std.data.persistent.set
//
// PSet<K> — persistent set handle.  Implemented as a thin wrapper over
// PMap<K, PSetUnit> where PSetUnit is a 1-byte Primitive sentinel value
// type.  Inherits CoW path-copy semantics, snapshot sharing, and the
// B+tree backing store from std.data.persistent.map.

package std.data.persistent.set;

use std.data.persistent.map;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;

// 1-byte Primitive value type used as the sentinel value in the
// underlying PMap.  Storing a u8 per entry is the smallest Primitive we
// can plumb through the existing Container machinery.
pub struct PSetUnit { pub _b: u8 }
impl Primitive for PSetUnit { type Prim = u8; }

pub struct PSet<K: Container + ContainerOrd> {
    pub inner: PMap<K, PSetUnit>,
}

pub fn pset_new<K: Container + ContainerOrd>() -> PSet<K> {
    return PSet::<K> { inner: map_new::<K, PSetUnit>() };
}

pub fn pset_drop<K: Container + ContainerOrd>(s: *mut PSet<K>) {
    unsafe { map_drop::<K, PSetUnit>(&mut s.inner as *mut PMap<K, PSetUnit>); }
}

pub fn pset_len<K: Container + ContainerOrd>(s: *const PSet<K>) -> u64 {
    unsafe { return map_len::<K, PSetUnit>(&s.inner as *const PMap<K, PSetUnit>); }
}

pub fn pset_contains<K: Container + ContainerOrd>(s: *const PSet<K>, key: *const K) -> bool {
    unsafe { return map_contains::<K, PSetUnit>(&s.inner as *const PMap<K, PSetUnit>, key); }
}

// Insert `key` into the set; returns true iff it was already present.
pub fn pset_insert<K: Container + ContainerOrd>(s: *mut PSet<K>, key: K::ViewInStore, qkey: *const K) -> bool {
    unsafe { return map_insert::<K, PSetUnit>(&mut s.inner as *mut PMap<K, PSetUnit>, key, 0u8, qkey); }
}

// Remove `key`; returns true on hit, false on miss.
pub fn pset_remove<K: Container + ContainerOrd>(s: *mut PSet<K>, key: *const K) -> bool {
    unsafe { return map_remove::<K, PSetUnit>(&mut s.inner as *mut PMap<K, PSetUnit>, key); }
}

// Snapshot — sharing semantics identical to map_snapshot.
pub fn pset_snapshot<K: Container + ContainerOrd>(s: *const PSet<K>) -> PSet<K> {
    unsafe { return PSet::<K> { inner: map_snapshot::<K, PSetUnit>(&s.inner as *const PMap<K, PSetUnit>) }; }
}
