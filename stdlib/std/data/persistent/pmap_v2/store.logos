// std.data.persistent.pmap_v2.store — Store + Snapshot layer for the
// CFG-parameterised pmap_v2.
//
// `<const CFG: HermesStatic>` is the only generic parameter. K and V
// are extracted from CFG via `<type:CFG.key>` / `<type:CFG.value>`.
// LockingStore itself is type-erased (operates on `*mut u8` roots +
// commit ids), so it's reused as-is from std.data.persistent.store.
// Snapshot/MutSnapshot wrappers + the typed store_* free fns are new
// here.
//
// v1 scope: same as the parent module — DAG = tree (parent edge per
// commit, no merge); no DAG GC; named refs deferred. Adds CFG
// type-identity threading and integration with pmap_v2's existing
// PMapMut update parts.

package std.data.persistent.pmap_v2.store;

use std.data.persistent.pmap_v2.btree;
use std.data.persistent.pmap_v2.view;
use std.data.persistent.pmap_v2.mutv;
use std.data.persistent.store;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;

// Single-threaded immutable view over a frozen tree at a specific
// commit. CFG carries the configuration the snapshot was taken at.
pub struct Snapshot<const CFG: HermesStatic> {
    pub root:      *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG>,
    pub commit_id: i64,
}

// Single-threaded mutable handle. Owns 1 rc on `root` until
// commit/rollback releases it.
pub struct MutSnapshot<const CFG: HermesStatic> {
    pub root:      *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG>,
    pub parent_id: i64,
}

pub fn pmv2_store_begin<const CFG: HermesStatic, S: StoreOps>(s: *mut S, parent: i64) -> MutSnapshot<CFG> {
    unsafe {
        if parent == NO_COMMIT {
            let r: *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG> = node_alloc_c::<<type:CFG.key>, <type:CFG.value>, CFG>();
            return MutSnapshot::<CFG> { root: r, parent_id: parent };
        }
        let raw: *mut u8 = s.get_root(parent);
        let r: *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG> = raw as *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG>;
        node_retain_c::<<type:CFG.key>, <type:CFG.value>, CFG>(r);
        return MutSnapshot::<CFG> { root: r, parent_id: parent };
    }
}

pub fn pmv2_store_commit<const CFG: HermesStatic, S: StoreOps>(s: *mut S, snap: MutSnapshot<CFG>) -> i64 {
    unsafe { return s.register_commit(snap.root as *mut u8, snap.parent_id); }
}

pub fn pmv2_store_rollback<const CFG: HermesStatic>(snap: MutSnapshot<CFG>) {
    unsafe { node_release_c::<<type:CFG.key>, <type:CFG.value>, CFG>(snap.root); }
}

pub fn pmv2_store_checkout<const CFG: HermesStatic, S: StoreOps>(s: *mut S, id: i64) -> Snapshot<CFG> {
    unsafe {
        let raw: *mut u8 = s.get_root(id);
        let r: *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG> = raw as *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG>;
        node_retain_c::<<type:CFG.key>, <type:CFG.value>, CFG>(r);
        return Snapshot::<CFG> { root: r, commit_id: id };
    }
}

pub fn pmv2_store_close<const CFG: HermesStatic>(snap: Snapshot<CFG>) {
    unsafe { node_release_c::<<type:CFG.key>, <type:CFG.value>, CFG>(snap.root); }
}

// ── Read parts on Snapshot ───────────────────────────────────────

pub fn pmv2_snapshot_len<const CFG: HermesStatic>(s: *const Snapshot<CFG>) -> u64 {
    unsafe { return node_size_rec_c::<<type:CFG.key>, <type:CFG.value>, CFG>(s.root); }
}

pub fn pmv2_snapshot_contains<const CFG: HermesStatic>(s: *const Snapshot<CFG>, key: *const <type:CFG.key>) -> bool {
    unsafe { return node_contains_rec_c::<<type:CFG.key>, <type:CFG.value>, CFG>(s.root, key); }
}

pub fn pmv2_snapshot_get<const CFG: HermesStatic>(s: *const Snapshot<CFG>, key: *const <type:CFG.key>, out: *mut <type:CFG.value>::ViewInStore) -> bool {
    unsafe { return node_get_rec_c::<<type:CFG.key>, <type:CFG.value>, CFG>(s.root, key, out); }
}

// ── Read parts on MutSnapshot ────────────────────────────────────

pub fn pmv2_mut_snapshot_len<const CFG: HermesStatic>(s: *const MutSnapshot<CFG>) -> u64 {
    unsafe { return node_size_rec_c::<<type:CFG.key>, <type:CFG.value>, CFG>(s.root); }
}

pub fn pmv2_mut_snapshot_contains<const CFG: HermesStatic>(s: *const MutSnapshot<CFG>, key: *const <type:CFG.key>) -> bool {
    unsafe { return node_contains_rec_c::<<type:CFG.key>, <type:CFG.value>, CFG>(s.root, key); }
}

pub fn pmv2_mut_snapshot_get<const CFG: HermesStatic>(s: *const MutSnapshot<CFG>, key: *const <type:CFG.key>, out: *mut <type:CFG.value>::ViewInStore) -> bool {
    unsafe { return node_get_rec_c::<<type:CFG.key>, <type:CFG.value>, CFG>(s.root, key, out); }
}

// ── Update parts on MutSnapshot — route through pmap_v2's PMapMut ─

pub fn pmv2_mut_snapshot_insert<const CFG: HermesStatic>(s: *mut MutSnapshot<CFG>, key: <type:CFG.key>::ViewInStore, val: <type:CFG.value>::ViewInStore, qkey: *const <type:CFG.key>) -> bool {
    unsafe {
        let mut pm: PMapMut<CFG> = PMapMut::<CFG> {
            view: PMapView::<CFG> { root: s.root },
        };
        let hit: bool = pmap_mut_insert::<CFG>(&mut pm as *mut PMapMut<CFG>, key, val, qkey);
        s.root = pm.view.root;
        return hit;
    }
}

pub fn pmv2_mut_snapshot_remove<const CFG: HermesStatic>(s: *mut MutSnapshot<CFG>, key: *const <type:CFG.key>) -> bool {
    unsafe {
        let mut pm: PMapMut<CFG> = PMapMut::<CFG> {
            view: PMapView::<CFG> { root: s.root },
        };
        let hit: bool = pmap_mut_remove::<CFG>(&mut pm as *mut PMapMut<CFG>, key);
        s.root = pm.view.root;
        return hit;
    }
}
