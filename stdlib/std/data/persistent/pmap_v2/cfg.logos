// std.data.persistent.pmap_v2.cfg — Phase 1 of the assembler:
// schema validation for the PMap configuration HermesStatic.
//
// Walks the cfg, asserts each required slot is present and shaped
// correctly. No metaprog dependency — checks are by AnyVal shape
// (is_ptr / is_int) so this module ships in the binary stdlib.
//
// Returned codes (0 = OK):
//   1: cfg root is not a TinyObjectMap
//   2: missing "key" slot
//   3: "key" not a Type-shaped value (must be a TOM ptr)
//   4: missing "value" slot
//   5: "value" not a Type-shaped value
//   6: missing "fanout" slot
//   7: "fanout" not an integer

package std.data.persistent.pmap_v2.cfg;

use std.hermes.view;
use std.hermes.anyval;

pub unsafe fn validate_pmap_cfg(cfg: HermesStatic) -> i32 {
    let v = cfg.as_view();
    let r: AnyVal = v.root();
    if !r.is_ptr() { return 1; }
    let k: AnyVal = v.map_get(r, "key");
    if k.is_null() { return 2; }
    if !k.is_ptr() { return 3; }
    let val: AnyVal = v.map_get(r, "value");
    if val.is_null() { return 4; }
    if !val.is_ptr() { return 5; }
    let fan: AnyVal = v.map_get(r, "fanout");
    if fan.is_null() { return 6; }
    if !fan.is_int() { return 7; }
    return 0;
}
