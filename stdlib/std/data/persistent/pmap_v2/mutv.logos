// std.data.persistent.pmap_v2.mutv — read+update sibling of PMapView.
//
// `PMapMut<K, V, CFG>` is the writable container. It embeds a
// `PMapView<K, V, CFG>` as its first field, so every Read part lives
// on the View (compiled once per <K,V,CFG>) and is reached from
// update code as `m.view.<method>` — direct projection, no shim, no
// duplicate emission.
//
// CFG flows through verbatim — the update parts don't yet specialise
// on cfg-derived constants (fanout is still the btree's hard-coded
// 4), but two PMaps with different CFGs are distinct types
// regardless, which is what the assembler arc rests on.

package std.data.persistent.pmap_v2.mutv;

use std.data.persistent.pmap_v2.view;
use std.data.persistent.btree.node;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;

pub struct PMapMut<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic> {
    pub view: PMapView<K, V, CFG>,
}

pub fn pmap_mut_new<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>() -> PMapMut<K, V, CFG> {
    return PMapMut::<K, V, CFG> {
        view: PMapView::<K, V, CFG> { root: node_alloc::<K, V>() },
    };
}

pub fn pmap_mut_drop<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(m: *mut PMapMut<K, V, CFG>) {
    unsafe { node_release::<K, V>(m.view.root); }
}

pub fn pmap_mut_snapshot<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(m: *const PMapMut<K, V, CFG>) -> PMapView<K, V, CFG> {
    unsafe {
        let r: *mut BTreeNode<K, V> = m.view.root;
        node_retain::<K, V>(r);
        return PMapView::<K, V, CFG> { root: r };
    }
}

fn pmap_mut_make_root_unique<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(m: *mut PMapMut<K, V, CFG>) {
    unsafe {
        let r: *mut BTreeNode<K, V> = m.view.root;
        if r.rc > 1u64 {
            let copy: *mut BTreeNode<K, V> = node_clone_for_cow::<K, V>(r);
            node_release::<K, V>(r);
            m.view.root = copy;
        }
    }
}

fn pmap_mut_grow_root<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(m: *mut PMapMut<K, V, CFG>, right: *mut BTreeNode<K, V>) {
    unsafe {
        let new_root: *mut BTreeNode<K, V> = node_alloc_internal::<K, V>();
        let sep: K::ViewInStore = right.keys.get(0u64);
        new_root.keys.push(sep);
        new_root.children.push(m.view.root);
        new_root.children.push(right);
        if !right.is_leaf {
            right.keys.remove_at(0u64);
            right.n = right.keys.len() as u16;
        }
        new_root.n = new_root.keys.len() as u16;
        m.view.root = new_root;
    }
}

pub fn pmap_mut_insert<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(m: *mut PMapMut<K, V, CFG>, key: K::ViewInStore, val: V::ViewInStore, qkey: *const K) -> bool {
    unsafe {
        pmap_mut_make_root_unique::<K, V, CFG>(m);
        let outcome: InsertOutcome<K, V> = node_insert_rec::<K, V>(m.view.root, key, val, qkey);
        if outcome.split {
            pmap_mut_grow_root::<K, V, CFG>(m, outcome.right);
        }
        return outcome.hit;
    }
}

pub fn pmap_mut_remove<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(m: *mut PMapMut<K, V, CFG>, qkey: *const K) -> bool {
    unsafe {
        if !node_contains_rec::<K, V>(m.view.root, qkey) { return false; }
        pmap_mut_make_root_unique::<K, V, CFG>(m);
        return node_remove_rec::<K, V>(m.view.root, qkey);
    }
}
