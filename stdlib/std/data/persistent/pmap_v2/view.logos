// std.data.persistent.pmap_v2.view — read-only base of the component-
// organised PMap, on top of the CFG-aware btree.
//
// `<const CFG: HermesStatic>` is the only generic parameter. K and V
// are extracted from CFG via the compile-time `<type:CFG.key>` /
// `<type:CFG.value>` projections, then threaded into the bt-layer
// internals which still take the `<K, V, CFG>` triple.

package std.data.persistent.pmap_v2.view;

use std.data.persistent.pmap_v2.btree;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.hermes.view;
use std.hermes.anyval;

pub struct PMapView<const CFG: HermesStatic> {
    pub root: *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG>,
}

impl<const CFG: HermesStatic> PMapView<CFG> {
    pub fn contains(&self, key: *const <type:CFG.key>) -> bool {
        unsafe { return node_contains_rec_c::<<type:CFG.key>, <type:CFG.value>, CFG>(self.root, key); }
    }

    pub fn get(&self, key: *const <type:CFG.key>, out: *mut <type:CFG.value>::ViewInStore) -> bool {
        unsafe { return node_get_rec_c::<<type:CFG.key>, <type:CFG.value>, CFG>(self.root, key, out); }
    }

    pub fn len(&self) -> u64 {
        unsafe { return node_size_rec_c::<<type:CFG.key>, <type:CFG.value>, CFG>(self.root); }
    }

    // Cfg-readback part — Read. Materialises CFG inline (per-instantiation
    // blob in rodata) and reads a top-level integer slot, falling back to
    // `dflt` on miss / wrong type. Used by parts that need a single scalar
    // out of CFG (fanout, capacity, …).
    pub unsafe fn cfg_i64(&self, key: str, dflt: i64) -> i64 {
        let v = CFG.as_view();
        let av: AnyVal = v.map_get(v.root(), key);
        if av.is_null() { return dflt; }
        if !av.is_int() { return dflt; }
        return av.as_i64();
    }
}

pub fn pmap_view_snapshot<const CFG: HermesStatic>(v: *const PMapView<CFG>) -> PMapView<CFG> {
    unsafe {
        let r: *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG> = v.root;
        node_retain_c::<<type:CFG.key>, <type:CFG.value>, CFG>(r);
        return PMapView::<CFG> { root: r };
    }
}

pub fn pmap_view_drop<const CFG: HermesStatic>(v: *mut PMapView<CFG>) {
    unsafe { node_release_c::<<type:CFG.key>, <type:CFG.value>, CFG>(v.root); }
}
