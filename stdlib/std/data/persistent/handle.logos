// std.data.persistent.handle — safe wrappers, container-directory
// architecture.
//
//   Store<STORE_CFG>     — Arc<LockingStore>; per-store release registry +
//                          STORE_CFG schema (ctr_id type, snp_id type, …).
//   Snap<STORE_CFG>      — directory MutSnapshot<DirCfg>. Hosts containers,
//                          dispatches commit/fork.
//   ContainerRef<CFG>    — handle to one container in a Snap. Holds an Rc
//                          clone of the dir snapshot (shared_ptr-style),
//                          ctr_id, and a cached root pointer.
//   Iter<CFG>            — leaf walker over a container.
//   LeafView<CFG>        — safe accessor over the iter's current leaf.
//
// commit() lives on Snap — finalises the dir tree as a new DAG entry; the
// dir's leaves carry container roots, so all containers in the snap commit
// together. fork() inherits the dir from a parent commit and rc-bumps every
// container root referenced by dir leaves so subsequent in-fork mutations
// CoW-clone cleanly without touching the parent commit's view.
//
// Drop chain (auto-fires on scope exit):
//   • ContainerRef.drop — writeback cached root to dir.
//   • Snap.drop         — walk dir, dispatch release per container via
//                          the store-level cfg_hash registry, release dir.
//                          (commit zeroes dir.root so post-commit drop
//                          skips the release walk — DAG owns the trees.)

package std.data.persistent.handle;

use std.data.persistent.btree;
use std.data.persistent.view;
use std.data.persistent.mutv;
use std.data.persistent.store;
use std.data.persistent.iter;
use std.data.persistent.cfg;
use std.data.persistent.snapshot;
use std.data.persistent.bt.node;
use std.data.persistent.bt.cow;
use std.mem.arc;
use std.mem.rc;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.lang.marker;
use std.lang.drop;
use std.hermes.view;
use std.hermes.anyval;

unsafe impl Send for LockingStore {}
unsafe impl Sync for LockingStore {}

// DirCfg is the fixed internal directory layout: ctr_id (u64) → root_ptr
// (u64). v1 hardcoded; future v2 derives from STORE_CFG slots once
// parametric HermesStatic literals land (literal whose byte-hash identity
// changes per outer instantiation).
pub const DirCfg: HermesStatic = @{ "key": <type:u64>, "value": <type:u64>, "fanout": 16 };

// Internal helpers — wrap the out-param C-style mut_snapshot_*
// free-fns so ISnapshot bodies and ContainerRef methods see normal
// shapes (Option-style returns, &mut Self receivers). The unsafe
// blocks are confined here, where the raw-pointer ABI lives.

// Directory lookup with sentinel-on-miss. Returns 0u64 if absent.
fn dir_get(dir: &MutSnapshot<DirCfg>, key: u64) -> u64 {
    unsafe {
        let mut out: u64 = 0u64;
        let hit: bool = mut_snapshot_get::<DirCfg>(
            dir as *const MutSnapshot<DirCfg>,
            &key as *const u64,
            &mut out as *mut u64);
        if hit { return out; } else { return 0u64; }
    }
}

// Read the cfg_hash slot at offset 8 of an arbitrary container root.
// `root` MUST point to an allocated NodeBase (= the offset-8 read is
// well-defined). Used by open_pmap (defensive type check) and the
// drop walker (release-thunk dispatch key).
unsafe fn cfg_hash_at(root: u64) -> u64 {
    let h_slot: *mut u64 = (root as i64 + 8i64) as *mut u64;
    return *h_slot;
}

// Directory-as-container upsert. For NULL_CTR_ID = direct dir.root
// write (recursion bottom-out). For non-zero ctr_id — perform
// mut_snapshot_insert and bottom-out via dir.root = t.root.
//
// TODO (next session): integrate ref(new) + release(prev) rc
// accounting once the leaf-clone-retain side of the protocol is
// stable. The two halves (clone retain in node_clone_for_cow_c and
// upsert ref/release here) must land together; the bug we hit while
// trying that under commit/fork is reproducible with full Increments
// 2+3+4 enabled and step-3-of-snap_fork removed — a path-condition
// in the multi-fork scenario over-releases somewhere.
unsafe fn dir_set_root_with_rc(dir: &mut MutSnapshot<DirCfg>, ctr_id: u64, root: u64) {
    if ctr_id == NULL_CTR_ID {
        dir.root = root as *mut NodeBase<u64, u64, DirCfg>;
        return;
    }
    let mut t: MutSnapshot<DirCfg> = MutSnapshot::<DirCfg> {
        root:      dir.root,
        parent_id: dir.parent_id,
    };
    let _ = mut_snapshot_insert::<DirCfg>(
        &mut t as *mut MutSnapshot<DirCfg>,
        ctr_id, root, &ctr_id as *const u64);
    dir.root = t.root;
}


// ── Store<STORE_CFG> — Arc<LockingStore> + STORE_CFG schema. ────

pub struct Store<const STORE_CFG: HermesStatic> {
    arc: Arc<LockingStore>,
}

pub fn store_open<const STORE_CFG: HermesStatic>() -> Store<STORE_CFG> {
    let s: LockingStore = locking_store_new();
    return Store::<STORE_CFG> { arc: arc_new::<LockingStore>(s) };
}

impl<const STORE_CFG: HermesStatic> Store<STORE_CFG> {
    pub fn clone(&mut self) -> Store<STORE_CFG> {
        return Store::<STORE_CFG> { arc: self.arc.clone_ref() };
    }
}

// Idempotently register the per-CFG release thunk in the per-store
// registry (cfg_hash → release fp). Used by Snap::drop's explicit
// walker. Will be subsumed by the process-global block-ops registry
// (bt.registry, keyed on block_type_hash) once Snap::drop migrates.
fn register_release_thunk<K: Container + ContainerOrd, V: Container, const CFG: HermesStatic>(s: &mut LockingStore) {
    let h: u64 = hstatic_hash_of::<CFG>();
    let fp: fn(*mut NodeBase<K, V, CFG>) -> () = node_release_c::<K, V, CFG>;
    locking_store_register_release(s, h, fp as u64);
}


// ── Snap<STORE_CFG> — directory snapshot. ──────────────────────

pub struct Snap<const STORE_CFG: HermesStatic> {
    dir: Rc<MutSnapshot<DirCfg>>,
    arc: Arc<LockingStore>,
}

pub fn snap_begin<const STORE_CFG: HermesStatic>(store: &mut Store<STORE_CFG>) -> Snap<STORE_CFG> {
    // Register the directory's release thunk in the same per-store
    // registry user containers populate. Snap::drop dispatches the dir
    // tree the same way as any user container.
    register_release_thunk::<u64, u64, DirCfg>(store.arc.deref_mut());
    // Register dir-flavour block ops in the process-global registry —
    // dir-leaves contain rc-counted child pointers, so leaf-clone has
    // to retain them and node release has to recursively release them.
    register_dir_container_block_ops::<u64, u64, DirCfg>();
    let dir_inner: MutSnapshot<DirCfg> = store_begin::<DirCfg, LockingStore>(
        store.arc.deref_mut() as *mut LockingStore, NO_COMMIT);
    return Snap::<STORE_CFG> {
        dir: rc_new::<MutSnapshot<DirCfg>>(dir_inner),
        arc: store.arc.clone_ref(),
    };
}

// snap_fork — fork from parent commit. The dir tree is rc-bumped via
// store_begin's parent path. Container roots referenced from dir
// leaves are also rc-bumped so a future mutation in either parent or
// fork CoW-clones cleanly. Type-erased rc-bump (rc at offset 0 of
// NodeBase, regardless of the container's K/V/CFG).
//
// TODO: the explicit per-container rc bump below should disappear once
// the proper CoW protocol is wired through (set_root retain/release +
// leaf-clone retain + open_pmap ref + ContainerRef::drop release). The
// process-global block-ops registry foundation is in place; the
// integration broke commit_fork's multi-fork rc balance and was
// reverted to keep the tree green. Next session: investigate.
pub fn snap_fork<const STORE_CFG: HermesStatic>(store: &mut Store<STORE_CFG>, parent: i64) -> Snap<STORE_CFG> {
    register_release_thunk::<u64, u64, DirCfg>(store.arc.deref_mut());
    register_dir_container_block_ops::<u64, u64, DirCfg>();
    let dir_inner: MutSnapshot<DirCfg> = store_begin::<DirCfg, LockingStore>(
        store.arc.deref_mut() as *mut LockingStore, parent);

    if dir_inner.root != 0 as *mut NodeBase<u64, u64, DirCfg> {
        unsafe {
            let view: PMapView<DirCfg> = PMapView::<DirCfg> { root: dir_inner.root };
            let mut it: LeafIter<u64, u64, DirCfg> =
                pmap_view_acquire_leaf_iter::<DirCfg>(&view as *const PMapView<DirCfg>);
            while leaf_iter_valid::<u64, u64, DirCfg>(&it as *const LeafIter<u64, u64, DirCfg>) {
                let leaf: *mut LeafNode<u64, u64, DirCfg> =
                    leaf_iter_leaf::<u64, u64, DirCfg>(&it as *const LeafIter<u64, u64, DirCfg>);
                let n: u64 = leaf.keys.len();
                let mut j: u64 = 0u64;
                while j < n {
                    let root_u64: u64 = leaf.vals.get(j);
                    if root_u64 != 0u64 {
                        let rcp: *mut u64 = root_u64 as *mut u64;
                        *rcp = *rcp + 1u64;
                    }
                    j = j + 1u64;
                }
                leaf_iter_next_leaf::<u64, u64, DirCfg>(&mut it as *mut LeafIter<u64, u64, DirCfg>);
            }
        }
    }

    return Snap::<STORE_CFG> {
        dir: rc_new::<MutSnapshot<DirCfg>>(dir_inner),
        arc: store.arc.clone_ref(),
    };
}

impl<const STORE_CFG: HermesStatic> Snap<STORE_CFG> {
    // commit — register the dir tree as a new DAG entry; transfers the
    // dir's root rc to the DAG. Container roots stay alive transitively
    // through dir leaves. Zeroes local dir.root so Drop skips release.
    pub fn commit(&mut self) -> i64 {
        let dir = self.dir.deref_mut();
        let stp: *mut LockingStore = self.arc.deref_mut() as *mut LockingStore;
        let id: i64 = unsafe { stp.register_commit(dir.root as *mut u8, dir.parent_id) };
        dir.root = 0 as *mut NodeBase<u64, u64, DirCfg>;
        return id;
    }
}

// ── ISnapshot impl on Snap<STORE_CFG> ───────────────────────────
// Routes through the directory MutSnapshot<DirCfg>. The NULL_CTR_ID
// sentinel (= 0u64) is the "directory itself" key — get returns the
// dir's own root, set replaces it. For non-zero ctr_id, get/set
// delegate to mut_snapshot_get / mut_snapshot_insert on the dir.
//
// MVP: set_root performs no ref/unref ballet on the *registered* root
// — caller arranged for it. The dir tree itself does CoW-clone via
// mut_snapshot_insert. on-disk Stores will plumb proper unref(prev)
// here once block-refcount semantics span backends.
impl<const STORE_CFG: HermesStatic> ISnapshot for Snap<STORE_CFG> {
    fn has_root(&mut self, ctr_id: u64) -> bool {
        let dir = self.dir.deref_mut();
        if ctr_id == NULL_CTR_ID {
            return dir.root != 0 as *mut NodeBase<u64, u64, DirCfg>;
        }
        return dir_get(dir, ctr_id) != 0u64;
    }

    fn get_root(&mut self, ctr_id: u64) -> u64 {
        let dir = self.dir.deref_mut();
        if ctr_id == NULL_CTR_ID { return dir.root as u64; }
        return dir_get(dir, ctr_id);
    }

    unsafe fn set_root(&mut self, ctr_id: u64, root: u64) {
        let dir = self.dir.deref_mut();
        dir_set_root_with_rc(dir, ctr_id, root);
    }
}

// create_pmap::<STORE_CFG, CFG>(&mut snap, ctr_id) — register the per-CFG
// release thunk (idempotent), allocate a fresh empty leaf, register
// (ctr_id → root) via ISnapshot.set_root, return ContainerRef holding
// a dir Rc clone for the writeback path on drop.
pub fn create_pmap<const CFG: HermesStatic, const STORE_CFG: HermesStatic>(snap: &mut Snap<STORE_CFG>, ctr_id: <type:STORE_CFG.ctr_id>) -> ContainerRef<CFG> {
    register_release_thunk::<<type:CFG.key>, <type:CFG.value>, CFG>(snap.arc.deref_mut());
    register_data_container_block_ops::<<type:CFG.key>, <type:CFG.value>, CFG>();
    let r: *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG> =
        node_alloc_c::<<type:CFG.key>, <type:CFG.value>, CFG>();
    let key: u64 = ctr_id as u64;
    unsafe { snap.set_root(key, r as u64); }
    return ContainerRef::<CFG> {
        dir_rc: snap.dir.clone_ref(),
        ctr_id: key,
        root:   r,
    };
}

// open_pmap::<STORE_CFG, CFG>(&mut snap, ctr_id) — dir lookup via
// ISnapshot.get_root + cfg_hash validation (defensive type check via
// slot-1 read on the root). Returns invalid (root=null) on miss or
// cfg-mismatch.
pub fn open_pmap<const CFG: HermesStatic, const STORE_CFG: HermesStatic>(snap: &mut Snap<STORE_CFG>, ctr_id: <type:STORE_CFG.ctr_id>) -> ContainerRef<CFG> {
    let key: u64 = ctr_id as u64;
    let out: u64 = snap.get_root(key);
    let mut root: *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG> =
        0 as *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG>;
    if out != 0u64 && unsafe { cfg_hash_at(out) } == hstatic_hash_of::<CFG>() {
        root = out as *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG>;
    }
    return ContainerRef::<CFG> {
        dir_rc: snap.dir.clone_ref(),
        ctr_id: key,
        root:   root,
    };
}

// Type-erased registry-driven release: look up the release thunk by
// the container's cfg_hash (offset-8 slot of its NodeBase) and invoke
// it on the root pointer. No-op if the thunk isn't registered.
fn release_root_via_registry(store: &mut LockingStore, root_u64: u64) {
    if root_u64 == 0u64 { return; }
    let h: u64 = unsafe { cfg_hash_at(root_u64) };
    let fp_u64: u64 = locking_store_lookup_release(store, h);
    if fp_u64 == 0u64 { return; }
    unsafe {
        let release: fn(*mut u8) -> () = fp_u64 as fn(*mut u8) -> ();
        release(root_u64 as *mut u8);
    }
}

// Snap.drop — auto-fires on scope exit. If commit was called, dir.root
// is zeroed → drop returns early (DAG owns the trees). Otherwise walks
// dir → registry-dispatched release per container → release dir tree
// itself through the same registry path.
impl<const STORE_CFG: HermesStatic> Drop for Snap<STORE_CFG> {
    fn drop(self: Snap<STORE_CFG>) {
        unsafe {
            let dir_p: *mut MutSnapshot<DirCfg> =
                (&self.dir as *const Rc<MutSnapshot<DirCfg>> as *mut Rc<MutSnapshot<DirCfg>>).get_mut();
            if dir_p.root == 0 as *mut NodeBase<u64, u64, DirCfg> { return; }
            let stp: *mut LockingStore =
                (&self.arc as *const Arc<LockingStore> as *mut Arc<LockingStore>).get() as *mut LockingStore;

            let view: PMapView<DirCfg> = PMapView::<DirCfg> { root: dir_p.root };
            let mut it: LeafIter<u64, u64, DirCfg> =
                pmap_view_acquire_leaf_iter::<DirCfg>(&view as *const PMapView<DirCfg>);
            while leaf_iter_valid::<u64, u64, DirCfg>(&it as *const LeafIter<u64, u64, DirCfg>) {
                let leaf: *mut LeafNode<u64, u64, DirCfg> =
                    leaf_iter_leaf::<u64, u64, DirCfg>(&it as *const LeafIter<u64, u64, DirCfg>);
                let n: u64 = leaf.keys.len();
                let mut j: u64 = 0u64;
                while j < n {
                    release_root_via_registry(&mut *stp, leaf.vals.get(j));
                    j = j + 1u64;
                }
                leaf_iter_next_leaf::<u64, u64, DirCfg>(&mut it as *mut LeafIter<u64, u64, DirCfg>);
            }

            release_root_via_registry(&mut *stp, dir_p.root as u64);
            dir_p.root = 0 as *mut NodeBase<u64, u64, DirCfg>;
        }
    }
}


// ── ContainerRef<CFG> — handle to one container in a Snap. ──────

pub struct ContainerRef<const CFG: HermesStatic> {
    dir_rc: Rc<MutSnapshot<DirCfg>>,
    ctr_id: u64,
    root:   *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG>,
}

impl<const CFG: HermesStatic> ContainerRef<CFG> {
    pub fn is_valid(&self) -> bool {
        return self.root != 0 as *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG>;
    }

    // Build a transient typed view over the cached root, sharing the
    // dir's parent_id. Used by every accessor below — its existence
    // reduces 5 method bodies to a single one-liner each.
    fn ctr_view(&mut self) -> MutSnapshot<CFG> {
        let dir = self.dir_rc.deref_mut();
        return MutSnapshot::<CFG> {
            root:      self.root,
            parent_id: dir.parent_id,
        };
    }

    pub fn len(&mut self) -> u64 {
        if !self.is_valid() { return 0u64; }
        let t = self.ctr_view();
        return unsafe { mut_snapshot_len::<CFG>(&t as *const MutSnapshot<CFG>) };
    }

    pub fn contains(&mut self, qkey: *const <type:CFG.key>) -> bool {
        if !self.is_valid() { return false; }
        let t = self.ctr_view();
        return unsafe { mut_snapshot_contains::<CFG>(&t as *const MutSnapshot<CFG>, qkey) };
    }

    pub fn insert(&mut self, key: <type:CFG.key>::ViewInStore, val: <type:CFG.value>::ViewInStore, qkey: *const <type:CFG.key>) -> bool {
        if !self.is_valid() { return false; }
        let mut t = self.ctr_view();
        let r: bool = unsafe {
            mut_snapshot_insert::<CFG>(&mut t as *mut MutSnapshot<CFG>, key, val, qkey)
        };
        self.root = t.root;
        return r;
    }

    pub fn remove(&mut self, qkey: *const <type:CFG.key>) -> bool {
        if !self.is_valid() { return false; }
        let mut t = self.ctr_view();
        let r: bool = unsafe {
            mut_snapshot_remove::<CFG>(&mut t as *mut MutSnapshot<CFG>, qkey)
        };
        self.root = t.root;
        return r;
    }

    pub fn iter(&self) -> Iter<CFG> {
        let v: PMapView<CFG> = PMapView::<CFG> { root: self.root };
        let it: LeafIter<<type:CFG.key>, <type:CFG.value>, CFG> = unsafe {
            pmap_view_acquire_leaf_iter::<CFG>(&v as *const PMapView<CFG>)
        };
        return Iter::<CFG> { inner: it };
    }
}

// ContainerRef.drop — writeback the cached root (CoW may have swapped
// it during ContainerRef's lifetime). Routes through
// dir_set_root_with_rc so this writeback shares one upsert path with
// Snap::set_root.
impl<const CFG: HermesStatic> Drop for ContainerRef<CFG> {
    fn drop(self: ContainerRef<CFG>) {
        if self.root == 0 as *mut NodeBase<<type:CFG.key>, <type:CFG.value>, CFG> { return; }
        unsafe {
            let dir_p: *mut MutSnapshot<DirCfg> =
                (&self.dir_rc as *const Rc<MutSnapshot<DirCfg>> as *mut Rc<MutSnapshot<DirCfg>>).get_mut();
            let dir: &mut MutSnapshot<DirCfg> = &mut *dir_p;
            dir_set_root_with_rc(dir, self.ctr_id, self.root as u64);
        }
    }
}


// ── Iter<CFG> + LeafView<CFG> — leaf walker over a container. ───

pub struct Iter<const CFG: HermesStatic> {
    inner: LeafIter<<type:CFG.key>, <type:CFG.value>, CFG>,
}

impl<const CFG: HermesStatic> Iter<CFG> {
    pub fn valid(&self) -> bool {
        return unsafe {
            leaf_iter_valid::<<type:CFG.key>, <type:CFG.value>, CFG>(
                &self.inner as *const LeafIter<<type:CFG.key>, <type:CFG.value>, CFG>)
        };
    }

    pub fn leaf(&self) -> LeafView<CFG> {
        let lp: *mut LeafNode<<type:CFG.key>, <type:CFG.value>, CFG> = unsafe {
            leaf_iter_leaf::<<type:CFG.key>, <type:CFG.value>, CFG>(
                &self.inner as *const LeafIter<<type:CFG.key>, <type:CFG.value>, CFG>)
        };
        return LeafView::<CFG> { inner: lp };
    }

    pub fn next(&mut self) {
        unsafe {
            leaf_iter_next_leaf::<<type:CFG.key>, <type:CFG.value>, CFG>(
                &mut self.inner as *mut LeafIter<<type:CFG.key>, <type:CFG.value>, CFG>);
        }
    }
}

pub struct LeafView<const CFG: HermesStatic> {
    inner: *mut LeafNode<<type:CFG.key>, <type:CFG.value>, CFG>,
}

// LeafView wraps a raw `*mut LeafNode<…>`. The methods autoderef
// through that pointer, which IS the unsafe op (raw-ptr field access).
// Each method's unsafe block is one line — irreducible.
impl<const CFG: HermesStatic> LeafView<CFG> {
    pub fn len(&self) -> u64 {
        return unsafe { self.inner.keys.len() };
    }
    pub fn key_at(&self, j: u64) -> <type:CFG.key>::ViewInStore {
        return unsafe { self.inner.keys.get(j) };
    }
    pub fn val_at(&self, j: u64) -> <type:CFG.value>::ViewInStore {
        return unsafe { self.inner.vals.get(j) };
    }
}


// ── Cfg validation — safe wrapper. ──────────────────────────────

pub fn validate_cfg(cfg: HermesStatic) -> i32 {
    return unsafe { validate_pmap_cfg(cfg) };
}
