// std.data.persistent.store — Store + IStore + MutSnapshot.
//
// Store side of the persistent stack: holds the commit DAG, allocates
// monotonic block + snapshot ids, exposes a narrow IStore trait that
// container-side code (handle, mutate) routes through. Mirrors big-
// Memoria's IMemoryStore. v1 backend is in-memory + single-mutex; the
// IStore abstraction lets queue / locking-free / on-disk backends slot
// in later without touching consumers.
//
// Identity model: a commit IS a frozen snapshot. Both share the
// `SnpId<STORE_CFG>` type — store_open seeds the genesis
// commit at id 0; subsequent commits get fresh ids from
// alloc_snapshot_id and live in the dag at that index. Multi-parent
// (merge) commits are NOT yet exposed; the on-disk CommitEntry
// already supports arbitrary parent counts.

package std.data.persistent.store;

use logos.mem.collections.vec;
use logos.lang.cmp;
use logos.mem.hermes.fabric;
use std.sync;
use logos.lang.hermes.view;
use logos.mem.hermes.view;
use logos.lang.hermes.anyval;

use std.data.persistent.node;

// ── DAG entry ─────────────────────────────────────────────────────────
// Each commit pins one root NodeARC handle. The root is the directory
// tree root for the Snap; user containers hang off dir leaves
// (vals: NodeARC<STORE_CFG>).
//
// Multi-parent: parents.len() == 0 for the genesis root commit (id 0,
// seeded by store_open), == 1 for the usual fork-and-commit chain,
// ≥ 2 for merge commits.

pub struct CommitEntry<const STORE_CFG: HermesStatic> {
    pub root:     NodeARC<STORE_CFG>,
    pub parents:  Vec<SnpId<STORE_CFG>>,
    pub children: Vec<SnpId<STORE_CFG>>,
    // Tombstone marker. Released entries keep their dag slot (so
    // children/parents indices stay stable) but `root` is set to a
    // null-handle NodeARC. Block-level reclamation happens automatically
    // via NodeARC rc — blocks unique to this commit drop to rc=0 and
    // free; blocks shared with a sibling/descendant commit retain rc≥1.
    pub released: bool,
}

// ── IStore trait ──────────────────────────────────────────────────────
// Narrow cross-backend ABI: snapshot lifecycle + commit DAG navigation
// + id allocators. NO type params on methods (would defeat dyn dispatch
// under raw-ptr backends). v1 backend is LockingStore.

pub trait IStore<const STORE_CFG: HermesStatic> {
    fn alloc_snapshot_id(self: *mut Self) -> SnpId<STORE_CFG>;
    fn alloc_block_id(self:    *mut Self) -> BlockId<STORE_CFG>;

    // Pin a new commit referencing `root` as the directory tree root.
    // Bumps `root`'s rc — the DAG entry shares ownership. `parent` is
    // the immediate ancestor (always valid; the genesis root is
    // seeded directly by store_open and bypasses this fn). The
    // parent's children list is updated to include the new id.
    fn register_commit(self: *mut Self, root: NodeARC<STORE_CFG>, parent: SnpId<STORE_CFG>) -> SnpId<STORE_CFG>;

    // Return a NodeARC clone of the commit's pinned root. Bumps rc.
    fn checkout(self: *mut Self, id: SnpId<STORE_CFG>) -> NodeARC<STORE_CFG>;

    // Snapshot the parents/children of `id`. Returned vectors are owned
    // copies — callers can iterate without holding the store lock.
    fn parents_of(self:  *mut Self, id: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>>;
    fn children_of(self: *mut Self, id: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>>;

    // Total number of commits ever registered in this store. Indices
    // [0, commit_count) are valid.
    fn commit_count(self: *mut Self) -> i64;

    // Root commits — entries with no parent. Allocates a fresh Vec.
    fn roots(self: *mut Self) -> Vec<SnpId<STORE_CFG>>;

    // Release a commit. Drops the entry's root NodeARC — block-level
    // reclamation cascades through the auto-Drop chain (blocks unique
    // to this commit drop to rc=0 and free; shared blocks retain).
    // The dag slot persists as a tombstone so existing indices stay
    // valid; subsequent checkout/parents_of/children_of on a released
    // id is a precondition violation.
    fn release_snapshot(self: *mut Self, id: SnpId<STORE_CFG>);

    // True if `id` has been released. Read-only check.
    fn is_released(self: *mut Self, id: SnpId<STORE_CFG>) -> bool;
}

// ── LockingStore — v1 backend ─────────────────────────────────────────
// Vec<CommitEntry<STORE_CFG>> guarded by Mutex. Doesn't actually need
// the mutex for v1 (no concurrent Snap), but it's already there as a
// placeholder for the queue/swmr backends.

pub struct LockingStore<const STORE_CFG: HermesStatic> {
    pub dag:              Vec<CommitEntry<STORE_CFG>>,
    pub lock:             Mutex<i32>,
    pub next_block_id:    BlockId<STORE_CFG>,
    pub next_snapshot_id: SnpId<STORE_CFG>,
}

// Build a single-element parents Vec inline. Helper fn so the
// return-stmt mark_moved walker fires on the local Vec, transferring
// ownership cleanly into the StructLit init without a double-drop.
fn make_parents_vec<const STORE_CFG: HermesStatic>(parent: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>> {
    let mut v: Vec<SnpId<STORE_CFG>> = vec_new::<SnpId<STORE_CFG>>();
    v.push(parent);
    return v;
}

pub fn locking_store_new<const STORE_CFG: HermesStatic>() -> LockingStore<STORE_CFG> {
    return LockingStore::<STORE_CFG> {
        dag:              vec_new::<CommitEntry<STORE_CFG>>(),
        lock:             mutex_new::<i32>(0i32),
        next_block_id:    0u64,
        next_snapshot_id: 0u64,
    };
}

impl<const STORE_CFG: HermesStatic> IStore<STORE_CFG> for LockingStore<STORE_CFG> {
    fn alloc_snapshot_id(self: *mut LockingStore<STORE_CFG>) -> SnpId<STORE_CFG> {
        unsafe {
            self.lock.lock();
            self.next_snapshot_id = self.next_snapshot_id + 1u64;
            let id: SnpId<STORE_CFG> = self.next_snapshot_id;
            self.lock.unlock();
            return id;
        }
    }
    fn alloc_block_id(self: *mut LockingStore<STORE_CFG>) -> BlockId<STORE_CFG> {
        unsafe {
            self.lock.lock();
            self.next_block_id = self.next_block_id + 1u64;
            let id: BlockId<STORE_CFG> = self.next_block_id;
            self.lock.unlock();
            return id;
        }
    }
    fn register_commit(self: *mut LockingStore<STORE_CFG>, root: NodeARC<STORE_CFG>, parent: SnpId<STORE_CFG>) -> SnpId<STORE_CFG> {
        unsafe {
            self.lock.lock();
            let id: SnpId<STORE_CFG> = self.dag.length() as SnpId<STORE_CFG>;
            // Update parent's children index before we push the new
            // entry — the lock window covers both mutations atomically.
            let parent_entry: *mut CommitEntry<STORE_CFG> = self.dag.at(parent as i64);
            parent_entry.children.push(id);
            self.dag.push(CommitEntry::<STORE_CFG> {
                root:     root,
                parents:  make_parents_vec::<STORE_CFG>(parent),
                children: vec_new::<SnpId<STORE_CFG>>(),
                released: false,
            });
            self.lock.unlock();
            return id;
        }
    }
    fn checkout(self: *mut LockingStore<STORE_CFG>, id: SnpId<STORE_CFG>) -> NodeARC<STORE_CFG> {
        unsafe {
            self.lock.lock();
            let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(id as i64);
            let cloned: NodeARC<STORE_CFG> = entry.root.clone_arc();
            self.lock.unlock();
            return cloned;
        }
    }
    fn parents_of(self: *mut LockingStore<STORE_CFG>, id: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>> {
        unsafe {
            self.lock.lock();
            let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(id as i64);
            let mut out: Vec<SnpId<STORE_CFG>> = vec_new::<SnpId<STORE_CFG>>();
            let n: i64 = entry.parents.length();
            let mut i: i64 = 0i64;
            while i < n {
                out.push(entry.parents.get(i));
                i = i + 1i64;
            }
            self.lock.unlock();
            return out;
        }
    }
    fn children_of(self: *mut LockingStore<STORE_CFG>, id: SnpId<STORE_CFG>) -> Vec<SnpId<STORE_CFG>> {
        unsafe {
            self.lock.lock();
            let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(id as i64);
            let mut out: Vec<SnpId<STORE_CFG>> = vec_new::<SnpId<STORE_CFG>>();
            let n: i64 = entry.children.length();
            let mut i: i64 = 0i64;
            while i < n {
                out.push(entry.children.get(i));
                i = i + 1i64;
            }
            self.lock.unlock();
            return out;
        }
    }
    fn commit_count(self: *mut LockingStore<STORE_CFG>) -> i64 {
        unsafe {
            self.lock.lock();
            let n: i64 = self.dag.length();
            self.lock.unlock();
            return n;
        }
    }
    fn roots(self: *mut LockingStore<STORE_CFG>) -> Vec<SnpId<STORE_CFG>> {
        unsafe {
            self.lock.lock();
            let mut out: Vec<SnpId<STORE_CFG>> = vec_new::<SnpId<STORE_CFG>>();
            let n: i64 = self.dag.length();
            let mut i: i64 = 0i64;
            while i < n {
                let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(i);
                if entry.parents.length() == 0i64 && !entry.released {
                    out.push(i as SnpId<STORE_CFG>);
                }
                i = i + 1i64;
            }
            self.lock.unlock();
            return out;
        }
    }

    fn release_snapshot(self: *mut LockingStore<STORE_CFG>, id: SnpId<STORE_CFG>) {
        unsafe {
            self.lock.lock();
            let entry: *mut CommitEntry<STORE_CFG> = self.dag.at(id as i64);
            if !entry.released {
                // Replace root with null-handle NodeARC; arc_replace_in_slot
                // drops the previous handle's rc → recursive auto-Drop chain.
                let null_arc: NodeARC<STORE_CFG> =
                    NodeARC::<STORE_CFG> { p: 0 as *mut dyn BTreeNode<STORE_CFG> };
                arc_replace_in_slot::<STORE_CFG>(
                    &mut entry.root as *mut NodeARC<STORE_CFG>, null_arc);
                entry.released = true;
            }
            self.lock.unlock();
        }
    }

    fn is_released(self: *mut LockingStore<STORE_CFG>, id: SnpId<STORE_CFG>) -> bool {
        unsafe {
            self.lock.lock();
            let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(id as i64);
            let r: bool = entry.released;
            self.lock.unlock();
            return r;
        }
    }
}

// ── MutSnapshot — single-thread mutable handle ────────────────────────
// Owns one rc on `root`. Carries snapshot_id + id_ctr_p so the CoW
// protocol (make_unique) can stamp + alloc fresh ids without going
// through Store on the per-mutation hot path.

pub struct MutSnapshot<const STORE_CFG: HermesStatic> {
    pub root:        NodeARC<STORE_CFG>,
    pub parent_id:   SnpId<STORE_CFG>,
    pub snapshot_id: SnpId<STORE_CFG>,
    pub id_ctr_p:    *mut BlockId<STORE_CFG>,  // points at LockingStore.next_block_id
}
