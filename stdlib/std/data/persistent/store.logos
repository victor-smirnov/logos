// std.data.persistent.store — Store + IStore + MutSnapshot for v3.
//
// Store side of the persistent stack: holds the commit DAG, allocates
// monotonic block + snapshot ids, exposes a narrow IStore trait that
// container-side code (handle, mutate) routes through. Mirrors big-
// Memoria's IMemoryStore. v1 backend is in-memory + single-mutex; the
// IStore abstraction lets queue / locking-free / on-disk backends slot
// in later without touching consumers.

package std.data.persistent.store;

use std.collections.vec;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.sync;
use std.hermes.view;
use std.hermes.anyval;

use std.data.persistent.node;

// ── DAG entry ─────────────────────────────────────────────────────────
// Each commit pins one root NodeARC handle. The root is the directory
// tree root for the Snap; user containers hang off dir leaves
// (vals: NodeARC<STORE_CFG>).
//
// Multi-parent: parents.len() == 0 for root commits, == 1 for the
// usual fork-and-commit chain, ≥ 2 for merge commits. children is
// maintained by register_commit (each parent's children gets the new
// commit id appended) and supports forward navigation through the DAG.

pub struct CommitEntry<const STORE_CFG: HermesStatic> {
    pub root:     NodeARC<STORE_CFG>,
    pub parents:  Vec<i64>,
    pub children: Vec<i64>,
}

// Sentinel "no parent" commit id — used for root commits in API
// signatures that take a single optional parent. Sites substitute -1i64
// inline.

// ── IStore trait ──────────────────────────────────────────────────────
// Narrow cross-backend ABI: snapshot lifecycle + commit DAG navigation
// + id allocators. NO type params on methods (would defeat dyn dispatch
// under raw-ptr backends). v1 backend is LockingStore.

pub trait IStore<const STORE_CFG: HermesStatic> {
    fn alloc_snapshot_id(self: *mut Self) -> u64;
    fn alloc_block_id(self:    *mut Self) -> u64;

    // Pin a new commit referencing `root` as the directory tree root.
    // Bumps `root`'s rc — the DAG entry shares ownership. `parent` is
    // the immediate ancestor (or -1 for a root commit). The parent's
    // children list is updated to include the new id.
    //
    // Multi-parent (merge) commits are NOT yet exposed; the merge
    // surface will add a sibling `register_merge_commit` that takes
    // both parents and constructs a parents=[a, b] entry. The on-disk
    // CommitEntry already supports arbitrary parent counts.
    fn register_commit(self: *mut Self, root: NodeARC<STORE_CFG>, parent: i64) -> i64;

    // Return a NodeARC clone of the commit's pinned root. Bumps rc.
    fn checkout(self: *mut Self, id: i64) -> NodeARC<STORE_CFG>;

    // Snapshot the parents/children of `id`. Returned vectors are owned
    // copies — callers can iterate without holding the store lock.
    fn parents_of(self:  *mut Self, id: i64) -> Vec<i64>;
    fn children_of(self: *mut Self, id: i64) -> Vec<i64>;

    // Total number of commits ever registered in this store. Indices
    // [0, commit_count) are valid.
    fn commit_count(self: *mut Self) -> i64;

    // Root commits — entries with no parent. Allocates a fresh Vec<i64>.
    fn roots(self: *mut Self) -> Vec<i64>;
}

// ── LockingStore — v1 backend ─────────────────────────────────────────
// PrimVec<CommitEntry<STORE_CFG>> guarded by Mutex. Doesn't actually
// need mutex for v1 (no concurrent Snap), but it's already there as a
// placeholder for the queue/swmr backends.

pub struct LockingStore<const STORE_CFG: HermesStatic> {
    pub dag:              Vec<CommitEntry<STORE_CFG>>,
    pub lock:             Mutex<i32>,
    pub next_block_id:    u64,
    pub next_snapshot_id: u64,
}

// Build a parents Vec for a single-parent commit. Helper fn so the
// return-stmt mark_moved walker fires on the local Vec, transferring
// ownership cleanly into the caller (= the StructLit init) without a
// double-drop. Empty Vec for parent < 0 (root commits).
fn make_parents_vec(parent: i64) -> Vec<i64> {
    let mut v: Vec<i64> = vec_new::<i64>();
    if parent >= 0i64 { v.push(parent); }
    return v;
}

pub fn locking_store_new<const STORE_CFG: HermesStatic>() -> LockingStore<STORE_CFG> {
    return LockingStore::<STORE_CFG> {
        dag:              vec_new::<CommitEntry<STORE_CFG>>(),
        lock:             mutex_new::<i32>(0i32),
        next_block_id:    0u64,
        next_snapshot_id: 0u64,
    };
}

impl<const STORE_CFG: HermesStatic> IStore<STORE_CFG> for LockingStore<STORE_CFG> {
    fn alloc_snapshot_id(self: *mut LockingStore<STORE_CFG>) -> u64 {
        unsafe {
            self.lock.lock();
            self.next_snapshot_id = self.next_snapshot_id + 1u64;
            let id: u64 = self.next_snapshot_id;
            self.lock.unlock();
            return id;
        }
    }
    fn alloc_block_id(self: *mut LockingStore<STORE_CFG>) -> u64 {
        unsafe {
            self.lock.lock();
            self.next_block_id = self.next_block_id + 1u64;
            let id: u64 = self.next_block_id;
            self.lock.unlock();
            return id;
        }
    }
    fn register_commit(self: *mut LockingStore<STORE_CFG>, root: NodeARC<STORE_CFG>, parent: i64) -> i64 {
        unsafe {
            self.lock.lock();
            let id: i64 = self.dag.length();
            // Update parent's children index before we push the new
            // entry — the lock window covers both mutations atomically.
            if parent >= 0i64 {
                let parent_entry: *mut CommitEntry<STORE_CFG> = self.dag.at(parent);
                parent_entry.children.push(id);
            }
            // Build the entry with both Vecs constructed inline-via-helpers.
            // Each helper fn returns the Vec by value with mark_moved on
            // the return path — so the temporary is moved straight into
            // the struct lit's field without a local binding that would
            // double-drop it at fn-end.
            self.dag.push(CommitEntry::<STORE_CFG> {
                root:     root,
                parents:  make_parents_vec(parent),
                children: vec_new::<i64>(),
            });
            self.lock.unlock();
            return id;
        }
    }
    fn checkout(self: *mut LockingStore<STORE_CFG>, id: i64) -> NodeARC<STORE_CFG> {
        unsafe {
            self.lock.lock();
            let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(id);
            let cloned: NodeARC<STORE_CFG> = entry.root.clone_arc();
            self.lock.unlock();
            return cloned;
        }
    }
    fn parents_of(self: *mut LockingStore<STORE_CFG>, id: i64) -> Vec<i64> {
        unsafe {
            self.lock.lock();
            let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(id);
            let mut out: Vec<i64> = vec_new::<i64>();
            let n: i64 = entry.parents.length();
            let mut i: i64 = 0i64;
            while i < n {
                out.push(entry.parents.get(i));
                i = i + 1i64;
            }
            self.lock.unlock();
            return out;
        }
    }
    fn children_of(self: *mut LockingStore<STORE_CFG>, id: i64) -> Vec<i64> {
        unsafe {
            self.lock.lock();
            let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(id);
            let mut out: Vec<i64> = vec_new::<i64>();
            let n: i64 = entry.children.length();
            let mut i: i64 = 0i64;
            while i < n {
                out.push(entry.children.get(i));
                i = i + 1i64;
            }
            self.lock.unlock();
            return out;
        }
    }
    fn commit_count(self: *mut LockingStore<STORE_CFG>) -> i64 {
        unsafe {
            self.lock.lock();
            let n: i64 = self.dag.length();
            self.lock.unlock();
            return n;
        }
    }
    fn roots(self: *mut LockingStore<STORE_CFG>) -> Vec<i64> {
        unsafe {
            self.lock.lock();
            let mut out: Vec<i64> = vec_new::<i64>();
            let n: i64 = self.dag.length();
            let mut i: i64 = 0i64;
            while i < n {
                let entry: &CommitEntry<STORE_CFG> = self.dag.borrow(i);
                if entry.parents.length() == 0i64 { out.push(i); }
                i = i + 1i64;
            }
            self.lock.unlock();
            return out;
        }
    }
}

// ── MutSnapshot — single-thread mutable handle ────────────────────────
// Owns one rc on `root`. Carries snapshot_id + id_ctr_p so the CoW
// protocol (make_unique) can stamp + alloc fresh ids without going
// through Store on the per-mutation hot path.

pub struct MutSnapshot<const STORE_CFG: HermesStatic> {
    pub root:        NodeARC<STORE_CFG>,
    pub parent_id:   i64,
    pub snapshot_id: u64,
    pub id_ctr_p:    *mut u64,    // points at LockingStore.next_block_id
}
