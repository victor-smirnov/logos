// Logos standard library — std.iter
//
// Iterator trait + adapters + terminal operations.
// Adapters take fn-pointer transformers; non-capturing closures coerce automatically.

package std.lang.iter;

use std.lang.option;
use std.lang.ord;

// ── FromIterator trait ───────────────────────────────────────────────────────
//
// Rust's `core::iter::FromIterator<A>` — `B: FromIterator<A>` says
// "values of type A can be collected into B". `Iterator::collect<B>`
// dispatches via this. Logos's Vec impl in std.collections.vec.

pub trait FromIterator<A> {
    fn from_iter<I: Iterator<A>>(iter: I) -> Self;
}

// ── Core trait ───────────────────────────────────────────────────────────────

pub trait Iterator<Item> {
    fn next(self: &mut Self) -> Option<Item>;

    // SL-sl-05: ergonomic method shortcuts that wrap the free-function
    // constructors below. Default body constructs the corresponding
    // adapter struct directly. Only `.filter()` lands here today —
    // `.map<R>` and other method-generic-with-fresh-tparam adapters
    // hit a method-generic-mono path that doesn't fully specialise
    // the adapter struct (see baghunt_iter_method_generic_mono.md).
    // Free-function `iter_map(it, f)` is the workaround until that
    // mono path closes.

    fn filter(self: Self, pred: fn(Item) -> bool) -> FilterIter<Self, Item> {
        return FilterIter { inner: self, pred: pred };
    }

    fn map<MapOut>(self: Self, f: fn(Item) -> MapOut) -> MapIter<Self, Item, MapOut> {
        return MapIter { inner: self, f: f };
    }

    // SL-sl-05: `.collect<B>` — terminal that pours the iterator into
    // any `B: FromIterator<Item>`. Standard impls: Vec<T>, plus user-
    // defined collections.
    fn collect<C: FromIterator<Item>>(self: Self) -> C {
        return C::from_iter(self);
    }

    // SL-sl-05: min/max terminals — caller supplies an i32 comparator
    // (negative = a < b, zero = equal, positive = a > b) so the trait
    // body doesn't need the Ordering enum (which would force every
    // implementor's pkg to import std.lang.ord transitively).
    unsafe fn min_by(self: Self, cmp: fn(Item, Item) -> i32) -> Option<Item> {
        let mut it: Self = self;
        let mut best: Option<Item> = Option::None;
        loop {
            match it.next() {
                Option::None    => { return best; }
                Option::Some(v) => {
                    let v_copy_a: Item = *((&v) as *const Item);
                    let v_copy_b: Item = *((&v) as *const Item);
                    match best {
                        Option::None    => { best = Option::Some(v); }
                        Option::Some(b) => {
                            let b_copy_a: Item = *((&b) as *const Item);
                            let b_copy_b: Item = *((&b) as *const Item);
                            if cmp(v_copy_a, b_copy_a) < 0i32 {
                                best = Option::Some(v_copy_b);
                            } else {
                                best = Option::Some(b_copy_b);
                            }
                        }
                    }
                }
            }
        }
    }

    unsafe fn max_by(self: Self, cmp: fn(Item, Item) -> i32) -> Option<Item> {
        let mut it: Self = self;
        let mut best: Option<Item> = Option::None;
        loop {
            match it.next() {
                Option::None    => { return best; }
                Option::Some(v) => {
                    let v_copy_a: Item = *((&v) as *const Item);
                    let v_copy_b: Item = *((&v) as *const Item);
                    match best {
                        Option::None    => { best = Option::Some(v); }
                        Option::Some(b) => {
                            let b_copy_a: Item = *((&b) as *const Item);
                            let b_copy_b: Item = *((&b) as *const Item);
                            if cmp(v_copy_a, b_copy_a) > 0i32 {
                                best = Option::Some(v_copy_b);
                            } else {
                                best = Option::Some(b_copy_b);
                            }
                        }
                    }
                }
            }
        }
    }

    // SL-sl-05 method shortcuts for the adapter free fns below. No
    // fresh method-level tparams (Item is impl-bound), so the method-
    // generic-mono machinery isn't needed here. The `unsafe` qualifier
    // matches their free-fn counterparts which require a `zero`
    // sentinel for raw-pointer copies in adapter bodies. The unusual
    // 2nd-arg `zero: Item` placeholder is a workaround for Logos's
    // lack of `mem::zeroed` / `Default` — give the adapter a typed
    // initial value for its `_t` phantom field.
    unsafe fn take_while(self: Self, pred: fn(Item) -> bool, zero: Item)
        -> TakeWhileIter<Self, Item>
    {
        return TakeWhileIter { inner: self, pred: pred, done: false, _t: zero };
    }

    unsafe fn skip_while(self: Self, pred: fn(Item) -> bool, zero: Item)
        -> SkipWhileIter<Self, Item>
    {
        return SkipWhileIter { inner: self, pred: pred, primed: false, _t: zero };
    }

    unsafe fn step_by(self: Self, step: i64, zero: Item)
        -> StepByIter<Self, Item>
    {
        return StepByIter { inner: self, step: step, first: true, _t: zero };
    }

    unsafe fn inspect(self: Self, visit: fn(Item) -> (), zero: Item)
        -> InspectIter<Self, Item>
    {
        return InspectIter { inner: self, visit: visit, _t: zero };
    }

    // Terminal: fold items into an accumulator.
    fn fold<Acc>(self: Self, init: Acc, f: fn(Acc, Item) -> Acc) -> Acc {
        let mut it: Self = self;
        let mut acc: Acc = init;
        loop {
            match it.next() {
                Option::None    => { return acc; }
                Option::Some(v) => { acc = f(acc, v); }
            }
        }
    }

    // Terminal: count items.
    fn count(self: Self) -> i64 {
        let mut it: Self = self;
        let mut n: i64 = 0 as i64;
        loop {
            match it.next() {
                Option::None    => { return n; }
                Option::Some(_) => { n = n + 1 as i64; }
            }
        }
        return n;
    }

    // Terminal: visit each item.
    fn for_each(self: Self, f: fn(Item) -> ()) {
        let mut it: Self = self;
        loop {
            match it.next() {
                Option::None    => { return; }
                Option::Some(v) => { f(v); }
            }
        }
    }

    // Terminal: any item satisfies the predicate?
    fn any(self: Self, pred: fn(Item) -> bool) -> bool {
        let mut it: Self = self;
        loop {
            match it.next() {
                Option::None    => { return false; }
                Option::Some(v) => { if pred(v) { return true; } }
            }
        }
    }

    // Terminal: every item satisfies the predicate?
    fn all(self: Self, pred: fn(Item) -> bool) -> bool {
        let mut it: Self = self;
        loop {
            match it.next() {
                Option::None    => { return true; }
                Option::Some(v) => { if !pred(v) { return false; } }
            }
        }
    }

    // Terminal: skip first `n` items, then return next.
    fn nth(self: Self, n: i64) -> Option<Item> {
        let mut it: Self = self;
        let mut k: i64 = n;
        loop {
            match it.next() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    if k == 0 as i64 { return Option::Some(v); }
                    k = k - 1 as i64;
                }
            }
        }
    }

    // Terminal: first item satisfying the predicate.
    unsafe fn find(self: Self, pred: fn(Item) -> bool) -> Option<Item> {
        let mut it: Self = self;
        loop {
            match it.next() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    let v_copy: Item = *((&v) as *const Item);
                    if pred(v_copy) { return Option::Some(v); }
                }
            }
        }
    }

    // Terminal: index of first item satisfying the predicate.
    unsafe fn position(self: Self, pred: fn(Item) -> bool) -> Option<i64> {
        let mut it: Self = self;
        let mut idx: i64 = 0i64;
        loop {
            match it.next() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    if pred(v) { return Option::Some(idx); }
                    idx = idx + 1i64;
                }
            }
        }
    }

    // Terminal: last item, consuming the iterator.
    fn last(self: Self) -> Option<Item> {
        let mut it: Self = self;
        let mut acc: Option<Item> = Option::None;
        loop {
            match it.next() {
                Option::None    => { return acc; }
                Option::Some(v) => { acc = Option::Some(v); }
            }
        }
    }

}

// ── IntoIterator ─────────────────────────────────────────────────────────────
//
// Conversion into an Iterator. Implemented for:
//   - owning types like Vec<T> (consuming)
//   - &Vec<T> (borrowing — yields T by copy)
//   - &mut Vec<T> (mut-borrowing — yields &mut T)
//
// `for x in expr` desugars to `let mut __it = expr.into_iter(); loop { ... }`
// when `expr` has no direct `next()` method.

pub trait IntoIterator<Item> {
    type Iter: Iterator<Item>;
    fn into_iter(self: Self) -> Self::Iter;
}

// ── DoubleEndedIterator ──────────────────────────────────────────────────────
//
// SL-sl-05: an Iterator that can also yield items from the back.
// Matches Rust's `core::iter::DoubleEndedIterator`. Concrete impls:
// SliceIter<T> (here) and VecIter<T> (std.collections.vec). Generic
// adapters that preserve the back-end (e.g. Rev itself, Map of a
// DEI) get their own impl when needed; we don't blanket-derive
// because not every adapter has a sensible back-end.

pub trait DoubleEndedIterator<Item>: Iterator<Item> {
    fn next_back(self: &mut Self) -> Option<Item>;

    // `.rev()` — flip front and back into a RevIter. Trait-default
    // body so every DEI implementor gets it for free.
    fn rev(self: Self) -> RevIter<Self, Item> {
        return RevIter { inner: self, _t_marker: 0i32 };
    }
}

// ── ExactSizeIterator ────────────────────────────────────────────────────────
//
// SL-sl-05: an iterator that knows its remaining length exactly.
// Matches Rust's `core::iter::ExactSizeIterator`. Used by adapters
// like TakeIter / EnumIter that need to align front/back from a
// known back-position. No `is_empty` default — caller checks `len`
// against 0 explicitly.

pub trait ExactSizeIterator<Item>: Iterator<Item> {
    fn len(&self) -> i64;
}

// ── RevIter<I, T> — swap-ends adapter on a DoubleEndedIterator ───────────────
//
// `next()` pulls from the source's back; `next_back()` pulls from
// its front. _t_marker is a zero-sized phantom so the codegen
// instantiates T (no Default trait yet to bottom T out cleanly).

pub struct RevIter<I, T> {
    pub inner: I,
    pub _t_marker: i32,
}

impl<I: DoubleEndedIterator<T>, T> Iterator<T> for RevIter<I, T> {
    fn next(self: &mut RevIter<I, T>) -> Option<T> {
        return self.inner.next_back();
    }
}

impl<I: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for RevIter<I, T> {
    fn next_back(self: &mut RevIter<I, T>) -> Option<T> {
        return self.inner.next();
    }
}

// Free fn — pair with the method form on DoubleEndedIterator.
pub fn iter_rev<I: DoubleEndedIterator<T>, T>(iter: I) -> RevIter<I, T> {
    return RevIter { inner: iter, _t_marker: 0i32 };
}

// ── MapIter<I, T, R> — lazy map ──────────────────────────────────────────────

pub struct MapIter<I, T, R> {
    pub inner: I,
    pub f: fn(T) -> R,
}

impl<I: Iterator<T>, T, R> Iterator<R> for MapIter<I, T, R> {
    fn next(self: &mut MapIter<I, T, R>) -> Option<R> {
        let f = self.f;
        match self.inner.next() {
            Option::Some(v) => { return Option::Some(f(v)); }
            Option::None    => { return Option::None; }
        }
    }
}

pub fn iter_map<I: Iterator<T>, T, R>(iter: I, f: fn(T) -> R) -> MapIter<I, T, R> {
    return MapIter { inner: iter, f: f };
}

// DEI: forwards next_back through the same fn-ptr. The mapping
// function is pure-by-signature (no side effects expected), so
// front and back evaluation are independent.
impl<I: DoubleEndedIterator<T>, T, R> DoubleEndedIterator<R> for MapIter<I, T, R> {
    fn next_back(self: &mut MapIter<I, T, R>) -> Option<R> {
        let f = self.f;
        match self.inner.next_back() {
            Option::Some(v) => { return Option::Some(f(v)); }
            Option::None    => { return Option::None; }
        }
    }
}

// ── FilterIter<I, T> — lazy filter ───────────────────────────────────────────

pub struct FilterIter<I, T> {
    pub inner: I,
    pub pred: fn(T) -> bool,
}

impl<I: Iterator<T>, T> Iterator<T> for FilterIter<I, T> {
    fn next(self: &mut FilterIter<I, T>) -> Option<T> {
        unsafe {
            loop {
                match self.inner.next() {
                    Option::Some(v) => {
                        let v_copy: T = *((&v) as *const T);
                        let pred = self.pred;
                        if pred(v_copy) { return Option::Some(v); }
                    }
                    Option::None => { return Option::None; }
                }
            }
        }
    }
}

pub fn iter_filter<I: Iterator<T>, T>(iter: I, pred: fn(T) -> bool) -> FilterIter<I, T> {
    return FilterIter { inner: iter, pred: pred };
}

// DEI: walk back through the source, returning the first item from
// the back that satisfies the predicate. Front and back can advance
// independently — the underlying DEI keeps front/back cursors
// distinct, so a filter-walking-back never collides with one
// walking-forward unless they meet.
impl<I: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for FilterIter<I, T> {
    fn next_back(self: &mut FilterIter<I, T>) -> Option<T> {
        unsafe {
            loop {
                match self.inner.next_back() {
                    Option::Some(v) => {
                        let v_copy: T = *((&v) as *const T);
                        let pred = self.pred;
                        if pred(v_copy) { return Option::Some(v); }
                    }
                    Option::None => { return Option::None; }
                }
            }
        }
    }
}

// ── TakeIter<I, T> — limit to first n items ──────────────────────────────────

pub struct TakeIter<I, T> {
    inner: I,
    remaining: i64,
    _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for TakeIter<I, T> {
    fn next(self: &mut TakeIter<I, T>) -> Option<T> {
        if self.remaining <= 0 as i64 { return Option::None; }
        self.remaining = self.remaining - 1 as i64;
        return self.inner.next();
    }
}

pub unsafe fn iter_take<I: Iterator<T>, T>(iter: I, n: i64, zero: T) -> TakeIter<I, T> {
    return TakeIter { inner: iter, remaining: n, _t: zero };
}

// DEI: requires inner: ExactSizeIterator so we know how much to
// drop from the back to align with the take-cap. If inner.len() <=
// remaining, the back yields directly from inner. Otherwise we
// drop `inner.len() - remaining` items off the back first, then
// pull next_back. Tracks remaining the same way forward does.
impl<I: DoubleEndedIterator<T> + ExactSizeIterator<T>, T> DoubleEndedIterator<T> for TakeIter<I, T> {
    fn next_back(self: &mut TakeIter<I, T>) -> Option<T> {
        if self.remaining <= 0 as i64 { return Option::None; }
        let inner_len: i64 = self.inner.len();
        if inner_len > self.remaining {
            let drop_n: i64 = inner_len - self.remaining;
            let mut k: i64 = 0 as i64;
            while k < drop_n {
                let _drained: Option<T> = self.inner.next_back();
                k = k + 1 as i64;
            }
        }
        self.remaining = self.remaining - 1 as i64;
        return self.inner.next_back();
    }
}

impl<I: ExactSizeIterator<T>, T> ExactSizeIterator<T> for TakeIter<I, T> {
    fn len(&self) -> i64 {
        let il: i64 = self.inner.len();
        if il < self.remaining { return il; }
        return self.remaining;
    }
}

// ── SkipIter<I, T> — skip first n items ──────────────────────────────────────

pub struct SkipIter<I, T> {
    inner: I,
    remaining: i64,
    _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for SkipIter<I, T> {
    fn next(self: &mut SkipIter<I, T>) -> Option<T> {
        while self.remaining > 0 as i64 {
            self.remaining = self.remaining - 1 as i64;
            match self.inner.next() {
                Option::None => { return Option::None; }
                Option::Some(v) => { }
            }
        }
        return self.inner.next();
    }
}

pub unsafe fn iter_skip<I: Iterator<T>, T>(iter: I, n: i64, zero: T) -> SkipIter<I, T> {
    return SkipIter { inner: iter, remaining: n, _t: zero };
}

// DEI: drain skip-prefix from the front first so back doesn't
// touch items the forward direction would skip, then pull from
// inner.next_back. The drain stores into a typed local before
// matching — without the temp, mono of the matched-on Option<T>
// hits a disc-load codegen bug (the whole struct lands as the
// cmpi operand instead of just its tag field).
impl<I: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for SkipIter<I, T> {
    fn next_back(self: &mut SkipIter<I, T>) -> Option<T> {
        loop {
            if self.remaining <= 0 as i64 { return self.inner.next_back(); }
            self.remaining = self.remaining - 1 as i64;
            let drained: Option<T> = self.inner.next();
            match drained {
                Option::None    => { return Option::None; }
                Option::Some(v) => { }
            }
        }
    }
}

impl<I: ExactSizeIterator<T>, T> ExactSizeIterator<T> for SkipIter<I, T> {
    fn len(&self) -> i64 {
        let il: i64 = self.inner.len();
        if il < self.remaining { return 0 as i64; }
        return il - self.remaining;
    }
}

// ── TakeWhileIter<I, T> — yield until pred returns false ─────────────────────

pub struct TakeWhileIter<I, T> {
    pub inner: I,
    pub pred: fn(T) -> bool,
    pub done: bool,
    pub _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for TakeWhileIter<I, T> {
    fn next(self: &mut TakeWhileIter<I, T>) -> Option<T> {
        if self.done { return Option::None; }
        unsafe {
            match self.inner.next() {
                Option::None    => { self.done = true; return Option::None; }
                Option::Some(v) => {
                    let v_copy: T = *((&v) as *const T);
                    let pred = self.pred;
                    if pred(v_copy) { return Option::Some(v); }
                    self.done = true;
                    return Option::None;
                }
            }
        }
    }
}

pub unsafe fn iter_take_while<I: Iterator<T>, T>(iter: I, pred: fn(T) -> bool, zero: T) -> TakeWhileIter<I, T> {
    return TakeWhileIter { inner: iter, pred: pred, done: false, _t: zero };
}

// ── SkipWhileIter<I, T> — skip until pred returns false, then yield rest ─────

pub struct SkipWhileIter<I, T> {
    pub inner: I,
    pub pred: fn(T) -> bool,
    pub primed: bool,
    pub _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for SkipWhileIter<I, T> {
    fn next(self: &mut SkipWhileIter<I, T>) -> Option<T> {
        unsafe {
            if !self.primed {
                loop {
                    match self.inner.next() {
                        Option::None    => { self.primed = true; return Option::None; }
                        Option::Some(v) => {
                            let v_copy: T = *((&v) as *const T);
                            let pred = self.pred;
                            if !pred(v_copy) {
                                self.primed = true;
                                return Option::Some(v);
                            }
                        }
                    }
                }
            }
            return self.inner.next();
        }
    }
}

pub unsafe fn iter_skip_while<I: Iterator<T>, T>(iter: I, pred: fn(T) -> bool, zero: T) -> SkipWhileIter<I, T> {
    return SkipWhileIter { inner: iter, pred: pred, primed: false, _t: zero };
}

// ── StepByIter<I, T> — yield every Nth item starting from the first ──────────

pub struct StepByIter<I, T> {
    pub inner: I,
    pub step: i64,
    pub first: bool,
    pub _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for StepByIter<I, T> {
    fn next(self: &mut StepByIter<I, T>) -> Option<T> {
        if self.first {
            self.first = false;
            return self.inner.next();
        }
        // Skip step-1 items.
        let mut k: i64 = self.step - 1i64;
        while k > 0i64 {
            match self.inner.next() {
                Option::None    => { return Option::None; }
                Option::Some(_) => { k = k - 1i64; }
            }
        }
        return self.inner.next();
    }
}

pub unsafe fn iter_step_by<I: Iterator<T>, T>(iter: I, step: i64, zero: T) -> StepByIter<I, T> {
    return StepByIter { inner: iter, step: step, first: true, _t: zero };
}

// ── InspectIter<I, T> — observe each item without consuming it ───────────────

pub struct InspectIter<I, T> {
    pub inner: I,
    pub visit: fn(T) -> (),
    pub _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for InspectIter<I, T> {
    fn next(self: &mut InspectIter<I, T>) -> Option<T> {
        unsafe {
            match self.inner.next() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    let v_copy: T = *((&v) as *const T);
                    let visit = self.visit;
                    visit(v_copy);
                    return Option::Some(v);
                }
            }
        }
    }
}

pub unsafe fn iter_inspect<I: Iterator<T>, T>(iter: I, visit: fn(T) -> (), zero: T) -> InspectIter<I, T> {
    return InspectIter { inner: iter, visit: visit, _t: zero };
}

// DEI: same shape as forward, fires the visit fn for each element
// pulled from the back.
impl<I: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for InspectIter<I, T> {
    fn next_back(self: &mut InspectIter<I, T>) -> Option<T> {
        unsafe {
            match self.inner.next_back() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    let v_copy: T = *((&v) as *const T);
                    let visit = self.visit;
                    visit(v_copy);
                    return Option::Some(v);
                }
            }
        }
    }
}

// ── PeekableIter<I, T> — one-element lookahead wrapper ───────────────────────
//
// `peek()` fetches & caches the next item without consuming it.
// Subsequent `next()` returns the cached item, then resumes normal
// iteration. Uses a `has_peeked: bool` + bare `peeked_val: T` instead
// of `peeked: Option<T>` because Logos's struct-lit `Option::None`
// initialisation stores an i32 disc into the ptr-typed field slot
// (mlir-gen layout mismatch), making is_none() crash on first peek.

pub struct PeekableIter<I, T> {
    pub inner: I,
    pub has_peeked: bool,
    pub peeked_val: T,
}

impl<I: Iterator<T>, T> Iterator<T> for PeekableIter<I, T> {
    fn next(self: &mut PeekableIter<I, T>) -> Option<T> {
        unsafe {
            if self.has_peeked {
                self.has_peeked = false;
                let v_copy: T = *((&self.peeked_val) as *const T);
                return Option::Some(v_copy);
            }
        }
        return self.inner.next();
    }
}

impl<I: Iterator<T>, T> PeekableIter<I, T> {
    pub unsafe fn peek(self: &mut PeekableIter<I, T>) -> Option<&T> {
        if !self.has_peeked {
            match self.inner.next() {
                Option::Some(v) => {
                    self.peeked_val = v;
                    self.has_peeked = true;
                }
                Option::None => { return Option::None; }
            }
        }
        // Address-of the field slot — points into the struct's storage,
        // not a temp copy. Caller's `*r` dereferences back to the
        // cached value. Lifetime tied to the PeekableIter's storage.
        let r: *const T = &self.peeked_val as *const T;
        return Option::Some(&*r);
    }
}

pub unsafe fn iter_peekable<I: Iterator<T>, T>(iter: I, zero: T) -> PeekableIter<I, T> {
    return PeekableIter { inner: iter, has_peeked: false, peeked_val: zero };
}

// DEI: pull from inner.next_back; if inner is exhausted but a front
// peek is cached, return that cached value (so the cached peek
// always observes as the last element from either direction).
// Matches Rust's std::iter::Peekable<I: DoubleEndedIterator> shape.
// Intermediate `back` local is required to dodge the disc-load
// codegen bug on rvalue-call-match-result (same workaround as
// SkipIter DEI).
impl<I: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for PeekableIter<I, T> {
    fn next_back(self: &mut PeekableIter<I, T>) -> Option<T> {
        unsafe {
            let back: Option<T> = self.inner.next_back();
            match back {
                Option::Some(v) => { return Option::Some(v); }
                Option::None => {
                    if self.has_peeked {
                        self.has_peeked = false;
                        let v_copy: T = *((&self.peeked_val) as *const T);
                        return Option::Some(v_copy);
                    }
                    return Option::None;
                }
            }
        }
    }
}

// ── Source iterators: once / empty / repeat ──────────────────────────────────
//
// Matches Rust's `core::iter::{once, empty, repeat}` shape: free fn
// returning a typed iterator struct. Trivially DEI (a single-element
// or symmetric source has the same yield from either end).

pub struct OnceIter<T> {
    pub consumed: bool,
    pub val: T,
}

impl<T> Iterator<T> for OnceIter<T> {
    fn next(self: &mut OnceIter<T>) -> Option<T> {
        unsafe {
            if self.consumed { return Option::None; }
            self.consumed = true;
            let v_copy: T = *((&self.val) as *const T);
            return Option::Some(v_copy);
        }
    }
}

impl<T> DoubleEndedIterator<T> for OnceIter<T> {
    fn next_back(self: &mut OnceIter<T>) -> Option<T> {
        unsafe {
            if self.consumed { return Option::None; }
            self.consumed = true;
            let v_copy: T = *((&self.val) as *const T);
            return Option::Some(v_copy);
        }
    }
}

pub fn iter_once<T>(val: T) -> OnceIter<T> {
    return OnceIter { consumed: false, val: val };
}

// ── OptionIter<T> — 0-or-1-element iterator over an Option<T> ────────────────
//
// Backing iterator for `impl<T> IntoIterator<T> for Option<T>` —
// matches Rust's `impl<T> IntoIterator for Option<T>` shape.
// `.next()` takes the cached Option, leaving None behind.

pub struct OptionIter<T> {
    pub state: Option<T>,
}

impl<T> Iterator<T> for OptionIter<T> {
    fn next(self: &mut OptionIter<T>) -> Option<T> {
        return self.state.take();
    }
}

impl<T> DoubleEndedIterator<T> for OptionIter<T> {
    fn next_back(self: &mut OptionIter<T>) -> Option<T> {
        return self.state.take();
    }
}

impl<T> IntoIterator<T> for Option<T> {
    type Iter = OptionIter<T>;
    fn into_iter(self: Option<T>) -> OptionIter<T> {
        return OptionIter { state: self };
    }
}

pub struct EmptyIter<T> { pub _t: T }

impl<T> Iterator<T> for EmptyIter<T> {
    fn next(self: &mut EmptyIter<T>) -> Option<T> { return Option::None; }
}

impl<T> DoubleEndedIterator<T> for EmptyIter<T> {
    fn next_back(self: &mut EmptyIter<T>) -> Option<T> { return Option::None; }
}

pub fn iter_empty<T>(zero: T) -> EmptyIter<T> {
    return EmptyIter { _t: zero };
}

pub struct RepeatIter<T> { pub val: T }

impl<T> Iterator<T> for RepeatIter<T> {
    fn next(self: &mut RepeatIter<T>) -> Option<T> {
        unsafe {
            let v_copy: T = *((&self.val) as *const T);
            return Option::Some(v_copy);
        }
    }
}

pub fn iter_repeat<T>(val: T) -> RepeatIter<T> {
    return RepeatIter { val: val };
}

// ── CycleIter<I, T> — repeat the source iterator forever ─────────────────────
//
// Stores the original (Clone'd on construction) plus the active copy.
// When the active copy yields None, refresh it by cloning the original
// and try again. `I: Clone` bound — Logos's stdlib clone trait already
// auto-impl'd for primitives + via #[derive_clone] for structs.

pub struct CycleIter<I, T> {
    pub orig: I,
    pub active: I,
    pub _t: T,
}

impl<I: Iterator<T> + Clone, T> Iterator<T> for CycleIter<I, T> {
    fn next(self: &mut CycleIter<I, T>) -> Option<T> {
        match self.active.next() {
            Option::Some(v) => { return Option::Some(v); }
            Option::None    => {
                self.active = self.orig.clone();
                return self.active.next();
            }
        }
    }
}

pub unsafe fn iter_cycle<I: Iterator<T> + Clone, T>(iter: I, zero: T) -> CycleIter<I, T> {
    let copy: I = iter.clone();
    return CycleIter { orig: iter, active: copy, _t: zero };
}

// ── EnumIter<I, T> — pair each item with its index ───────────────────────────

pub struct EnumPair<T> {
    pub idx: i64,
    pub val: T,
}

pub struct EnumIter<I, T> {
    inner: I,
    idx: i64,
    _t: T,
}

impl<I: Iterator<T>, T> Iterator<EnumPair<T>> for EnumIter<I, T> {
    fn next(self: &mut EnumIter<I, T>) -> Option<EnumPair<T>> {
        match self.inner.next() {
            Option::None => { return Option::None; }
            Option::Some(v) => {
                let i = self.idx;
                self.idx = self.idx + 1 as i64;
                return Option::Some(EnumPair { idx: i, val: v });
            }
        }
    }
}

pub unsafe fn iter_enumerate<I: Iterator<T>, T>(iter: I, zero: T) -> EnumIter<I, T> {
    return EnumIter { inner: iter, idx: 0 as i64, _t: zero };
}

// DEI: yields (position, value) from the back. The position is
// computed as `self.idx + inner.len()` after the back-pull —
// since inner's remaining items are at original positions
// [idx .. idx + inner.len()) and the pulled item was at the
// upper end of that range.
impl<I: DoubleEndedIterator<T> + ExactSizeIterator<T>, T> DoubleEndedIterator<EnumPair<T>> for EnumIter<I, T> {
    fn next_back(self: &mut EnumIter<I, T>) -> Option<EnumPair<T>> {
        let pulled: Option<T> = self.inner.next_back();
        match pulled {
            Option::None    => { return Option::None; }
            Option::Some(v) => {
                let pos: i64 = self.idx + self.inner.len();
                return Option::Some(EnumPair { idx: pos, val: v });
            }
        }
    }
}

impl<I: ExactSizeIterator<T>, T> ExactSizeIterator<EnumPair<T>> for EnumIter<I, T> {
    fn len(&self) -> i64 { return self.inner.len(); }
}

// ── ChainIter<A, B, T> — concatenate two iterators of the same Item ──────────

pub struct ChainIter<A, B, T> {
    first: A,
    second: B,
    first_done: bool,
    _t: T,
}

impl<A: Iterator<T>, B: Iterator<T>, T> Iterator<T> for ChainIter<A, B, T> {
    fn next(self: &mut ChainIter<A, B, T>) -> Option<T> {
        if !self.first_done {
            match self.first.next() {
                Option::Some(v) => { return Option::Some(v); }
                Option::None    => { self.first_done = true; }
            }
        }
        return self.second.next();
    }
}

pub unsafe fn iter_chain<A: Iterator<T>, B: Iterator<T>, T>(a: A, b: B, zero: T) -> ChainIter<A, B, T> {
    return ChainIter { first: a, second: b, first_done: false, _t: zero };
}

// DEI: pull from the back of `second` first; once `second` is
// exhausted, pull from the back of `first`. Symmetric to forward
// chain (front of `first` then front of `second`). `second_done`
// tracked locally — when next_back finds `second.next_back()` =
// None, we record that and switch to `first.next_back()`. We
// reuse `first_done` for forward exhaustion and add a new
// `second_done` field for back-end exhaustion.
impl<A: DoubleEndedIterator<T>, B: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for ChainIter<A, B, T> {
    fn next_back(self: &mut ChainIter<A, B, T>) -> Option<T> {
        match self.second.next_back() {
            Option::Some(v) => { return Option::Some(v); }
            Option::None    => { return self.first.next_back(); }
        }
    }
}

// ── ZipPair<A, B> ─────────────────────────────────────────────────────────────

pub struct ZipPair<A, B> {
    pub first: A,
    pub second: B,
}

pub struct ZipIter<A, B, T, U> {
    left: A,
    right: B,
    _t: T,
    _u: U,
}

impl<A: Iterator<T>, B: Iterator<U>, T, U> Iterator<ZipPair<T, U>> for ZipIter<A, B, T, U> {
    fn next(self: &mut ZipIter<A, B, T, U>) -> Option<ZipPair<T, U>> {
        match self.left.next() {
            Option::None => { return Option::None; }
            Option::Some(a) => {
                match self.right.next() {
                    Option::None => { return Option::None; }
                    Option::Some(b) => {
                        return Option::Some(ZipPair { first: a, second: b });
                    }
                }
            }
        }
    }
}

pub unsafe fn iter_zip<A: Iterator<T>, B: Iterator<U>, T, U>(a: A, b: B, zt: T, zu: U) -> ZipIter<A, B, T, U> {
    return ZipIter { left: a, right: b, _t: zt, _u: zu };
}

// DEI: both halves must be DEI + ESI so we can align their lengths
// from the back. Drops `max(alen,blen) - min(alen,blen)` items
// from the longer side's back first, then pulls next_back from
// both. Matches Rust's Zip<A: DEI+ESI, B: DEI+ESI> shape.
impl<A: DoubleEndedIterator<T> + ExactSizeIterator<T>,
     B: DoubleEndedIterator<U> + ExactSizeIterator<U>,
     T, U> DoubleEndedIterator<ZipPair<T, U>> for ZipIter<A, B, T, U> {
    fn next_back(self: &mut ZipIter<A, B, T, U>) -> Option<ZipPair<T, U>> {
        let alen: i64 = self.left.len();
        let blen: i64 = self.right.len();
        if alen > blen {
            let drop_n: i64 = alen - blen;
            let mut k: i64 = 0 as i64;
            while k < drop_n {
                let _drained: Option<T> = self.left.next_back();
                k = k + 1 as i64;
            }
        }
        if blen > alen {
            let drop_n: i64 = blen - alen;
            let mut k: i64 = 0 as i64;
            while k < drop_n {
                let _drained: Option<U> = self.right.next_back();
                k = k + 1 as i64;
            }
        }
        let a: Option<T> = self.left.next_back();
        let b: Option<U> = self.right.next_back();
        match a {
            Option::None     => { return Option::None; }
            Option::Some(av) => {
                match b {
                    Option::None     => { return Option::None; }
                    Option::Some(bv) => {
                        return Option::Some(ZipPair { first: av, second: bv });
                    }
                }
            }
        }
    }
}

impl<A: ExactSizeIterator<T>, B: ExactSizeIterator<U>, T, U>
    ExactSizeIterator<ZipPair<T, U>> for ZipIter<A, B, T, U> {
    fn len(&self) -> i64 {
        let alen: i64 = self.left.len();
        let blen: i64 = self.right.len();
        if alen < blen { return alen; }
        return blen;
    }
}

// ── SliceIter<T> — iterator over a slice &[T] ────────────────────────────────

pub struct SliceIter<T> {
    data: *const T,
    len: i64,
    idx: i64,
    back_idx: i64,
}

impl<T> Iterator<T> for SliceIter<T> {
    fn next(self: &mut SliceIter<T>) -> Option<T> {
        unsafe {
            if self.idx >= self.back_idx { return Option::None; }
            let val: T = self.data[self.idx];
            self.idx = self.idx + 1 as i64;
            return Option::Some(val);
        }
    }
}

impl<T> DoubleEndedIterator<T> for SliceIter<T> {
    fn next_back(self: &mut SliceIter<T>) -> Option<T> {
        unsafe {
            if self.idx >= self.back_idx { return Option::None; }
            self.back_idx = self.back_idx - 1 as i64;
            let val: T = self.data[self.back_idx];
            return Option::Some(val);
        }
    }
}

pub unsafe fn iter_over_slice<T>(s: &[T]) -> SliceIter<T> {
    let p: *const T = s.as_ptr() as *const T;
    let n: i64 = s.len() as i64;
    return SliceIter { data: p, len: n, idx: 0 as i64, back_idx: n };
}

impl<T> ExactSizeIterator<T> for SliceIter<T> {
    fn len(&self) -> i64 { return self.back_idx - self.idx; }
}

// ── Terminal operations ───────────────────────────────────────────────────────

pub fn iter_count<I: Iterator<T>, T>(iter: I) -> i64 {
    let mut it: I = iter;
    let mut n: i64 = 0 as i64;
    loop {
        match it.next() {
            Option::None    => { return n; }
            Option::Some(v) => { n = n + 1 as i64; }
        }
    }
    return n;
}

pub fn iter_fold<I: Iterator<T>, T, B>(iter: I, init: B, f: fn(B, T) -> B) -> B {
    let mut it: I = iter;
    let mut acc: B = init;
    loop {
        match it.next() {
            Option::None    => { return acc; }
            Option::Some(v) => { acc = f(acc, v); }
        }
    }
    return acc;
}

pub fn iter_for_each<I: Iterator<T>, T>(iter: I, f: fn(T) -> ()) {
    let mut it: I = iter;
    loop {
        match it.next() {
            Option::None    => { return; }
            Option::Some(v) => { f(v); }
        }
    }
}

// SL-sl-05: product terminals — multiplicative analogues of iter_sum_*.
// Identity is 1; type-monomorphised because trait-default with primitive
// Self causes the trait-default-method-mono baghunt.
pub unsafe fn iter_product_i32<I: Iterator<i32>>(iter: I) -> i32 {
    let mut it: I = iter;
    let mut p: i32 = 1i32;
    loop {
        match it.next() {
            Option::None    => { return p; }
            Option::Some(v) => { p = p * v; }
        }
    }
    return p;
}

pub unsafe fn iter_product_i64<I: Iterator<i64>>(iter: I) -> i64 {
    let mut it: I = iter;
    let mut p: i64 = 1i64;
    loop {
        match it.next() {
            Option::None    => { return p; }
            Option::Some(v) => { p = p * v; }
        }
    }
    return p;
}

// SL-sl-05: min_by / max_by — caller supplies a `cmp` closure so we don't
// need Ord bound. Returns Option<T>; empty iterator → None.
pub fn iter_max_by<I: Iterator<T>, T>(iter: I, cmp: fn(T, T) -> i32) -> Option<T> {
    let mut it: I = iter;
    let mut best: Option<T> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None        => { best = Option::Some(v); }
                    Option::Some(cur)   => {
                        if cmp(v, cur) > 0i32 { best = Option::Some(v); }
                        else                  { best = Option::Some(cur); }
                    }
                }
            }
        }
    }
}

pub fn iter_min_by<I: Iterator<T>, T>(iter: I, cmp: fn(T, T) -> i32) -> Option<T> {
    let mut it: I = iter;
    let mut best: Option<T> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None        => { best = Option::Some(v); }
                    Option::Some(cur)   => {
                        if cmp(v, cur) < 0i32 { best = Option::Some(v); }
                        else                  { best = Option::Some(cur); }
                    }
                }
            }
        }
    }
}

// SL-sl-05: typed min/max for primitive integer iterators. Don't need
// Ord bound (the trait-default-with-Self segfault would otherwise
// block this); use the integer operator < / > directly. Empty
// iterator → None.
pub fn iter_max_i32<I: Iterator<i32>>(iter: I) -> Option<i32> {
    let mut it: I = iter;
    let mut best: Option<i32> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None      => { best = Option::Some(v); }
                    Option::Some(cur) => { if v > cur { best = Option::Some(v); }
                                           else        { best = Option::Some(cur); } }
                }
            }
        }
    }
}

pub fn iter_min_i32<I: Iterator<i32>>(iter: I) -> Option<i32> {
    let mut it: I = iter;
    let mut best: Option<i32> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None      => { best = Option::Some(v); }
                    Option::Some(cur) => { if v < cur { best = Option::Some(v); }
                                           else        { best = Option::Some(cur); } }
                }
            }
        }
    }
}

pub fn iter_max_i64<I: Iterator<i64>>(iter: I) -> Option<i64> {
    let mut it: I = iter;
    let mut best: Option<i64> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None      => { best = Option::Some(v); }
                    Option::Some(cur) => { if v > cur { best = Option::Some(v); }
                                           else        { best = Option::Some(cur); } }
                }
            }
        }
    }
}

pub fn iter_min_i64<I: Iterator<i64>>(iter: I) -> Option<i64> {
    let mut it: I = iter;
    let mut best: Option<i64> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None      => { best = Option::Some(v); }
                    Option::Some(cur) => { if v < cur { best = Option::Some(v); }
                                           else        { best = Option::Some(cur); } }
                }
            }
        }
    }
}

pub unsafe fn iter_sum_i32<I: Iterator<i32>>(iter: I) -> i32 {
    let mut it: I = iter;
    let mut s: i32 = 0;
    loop {
        match it.next() {
            Option::None    => { return s; }
            Option::Some(v) => { s = s + v; }
        }
    }
    return s;
}

pub unsafe fn iter_sum_i64<I: Iterator<i64>>(iter: I) -> i64 {
    let mut it: I = iter;
    let mut s: i64 = 0 as i64;
    loop {
        match it.next() {
            Option::None    => { return s; }
            Option::Some(v) => { s = s + v; }
        }
    }
    return s;
}
