// Logos standard library — std.utf8
//
// UTF-8 encoding / decoding utilities.
//
// Codepoints are represented as u32 (Unicode scalar values 0..=0x10FFFF).
// U+FFFD (0xFFFD) is the replacement character used on invalid input.
//
// All functions taking (*const u8, len) operate on a byte slice — they do NOT
// require a null terminator.

package std.lang.text;

use logos.lang.iter;
use logos.lang.option;

// ── Encoding / decoding ───────────────────────────────────────────────────

// Number of bytes required to encode `cp` in UTF-8 (1..=4, or 0 for invalid).
pub fn encode_len(cp: u32) -> i64 {
    if cp < 0x80 as u32          { return 1; }
    if cp < 0x800 as u32         { return 2; }
    if cp < 0x10000 as u32       { return 3; }
    if cp <= 0x10FFFF as u32     { return 4; }
    return 0;
}

// Length of the UTF-8 sequence starting with `b` (1..=4, or 1 for invalid).
pub fn seq_len(b: u8) -> i64 {
    let v: i32 = b as i32;
    if v < 0x80  { return 1; }
    if v < 0xC0  { return 1; }  // continuation byte — treat as 1 (skip)
    if v < 0xE0  { return 2; }
    if v < 0xF0  { return 3; }
    return 4;
}

// Decode the codepoint at ptr[0..].  Returns U+FFFD on invalid sequences.
// Does NOT bounds-check beyond byte 0 — caller must ensure ptr is valid.
pub unsafe fn decode(ptr: *const u8) -> u32 {
    let b0: i32 = ptr[0] as i32;
    if b0 < 0x80 { return b0 as u32; }
    if b0 < 0xC2 { return 0xFFFD as u32; }   // overlong or stray continuation
    if b0 < 0xE0 {
        let b1: i32 = ptr[1] as i32;
        if (b1 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        let cp: u32 = (((b0 & 0x1F) << 6) | (b1 & 0x3F)) as u32;
        if cp < 0x80 as u32 { return 0xFFFD as u32; }  // overlong
        return cp;
    }
    if b0 < 0xF0 {
        let b1: i32 = ptr[1] as i32;
        let b2: i32 = ptr[2] as i32;
        if (b1 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        if (b2 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        let cp: u32 = (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)) as u32;
        if cp < 0x800 as u32 { return 0xFFFD as u32; }  // overlong
        if cp >= 0xD800 as u32 && cp <= 0xDFFF as u32 { return 0xFFFD as u32; }  // surrogate
        return cp;
    }
    if b0 < 0xF5 {
        let b1: i32 = ptr[1] as i32;
        let b2: i32 = ptr[2] as i32;
        let b3: i32 = ptr[3] as i32;
        if (b1 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        if (b2 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        if (b3 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        let cp: u32 = (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) |
                       ((b2 & 0x3F) << 6)  |  (b3 & 0x3F)) as u32;
        if cp < 0x10000 as u32  { return 0xFFFD as u32; }  // overlong
        if cp > 0x10FFFF as u32 { return 0xFFFD as u32; }  // out of range
        return cp;
    }
    return 0xFFFD as u32;
}

// Encode codepoint `cp` into buf[0..].  Returns bytes written (1..=4).
// Returns 0 and writes U+FFFD (3 bytes) if cp is invalid.
// Caller must ensure buf has at least 4 bytes of space.
pub unsafe fn encode(cp: u32, buf: *mut u8) -> i64 {
    if cp < 0x80 as u32 {
        buf[0] = cp as u8;
        return 1;
    }
    if cp < 0x800 as u32 {
        buf[0] = (0xC0 | (cp >> 6))  as u8;
        buf[1] = (0x80 | (cp & 0x3F)) as u8;
        return 2;
    }
    if cp < 0x10000 as u32 {
        if cp >= 0xD800 as u32 && cp <= 0xDFFF as u32 {
            // surrogates — emit replacement
            buf[0] = 0xEF as u8;
            buf[1] = 0xBF as u8;
            buf[2] = 0xBD as u8;
            return 3;
        }
        buf[0] = (0xE0 | (cp >> 12))         as u8;
        buf[1] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
        buf[2] = (0x80 | (cp & 0x3F))         as u8;
        return 3;
    }
    if cp <= 0x10FFFF as u32 {
        buf[0] = (0xF0 | (cp >> 18))          as u8;
        buf[1] = (0x80 | ((cp >> 12) & 0x3F)) as u8;
        buf[2] = (0x80 | ((cp >> 6)  & 0x3F)) as u8;
        buf[3] = (0x80 | (cp & 0x3F))          as u8;
        return 4;
    }
    // invalid — emit U+FFFD
    buf[0] = 0xEF as u8;
    buf[1] = 0xBF as u8;
    buf[2] = 0xBD as u8;
    return 3;
}

// ── Slice-level operations ────────────────────────────────────────────────

// Count the number of codepoints in the UTF-8 byte slice ptr[0..len].
// Invalid bytes each count as one replacement character.
pub unsafe fn char_count(ptr: *const u8, len: i64) -> i64 {
    let mut pos: i64 = 0;
    let mut n: i64 = 0;
    while pos < len {
        let step: i64 = seq_len(ptr[pos]);
        let avail: i64 = len - pos;
        if step > avail {
            // truncated sequence — count remaining bytes one-by-one
            n = n + avail;
            pos = len;
        } else {
            n = n + 1;
            pos = pos + step;
        }
    }
    return n;
}

// Validate that ptr[0..len] is well-formed UTF-8. Returns false on any error.
pub unsafe fn is_valid(ptr: *const u8, len: i64) -> bool {
    let mut pos: i64 = 0;
    while pos < len {
        let base: *const u8 = (ptr as i64 + pos) as *const u8;
        let b0: i32 = base[0] as i32;
        if b0 < 0x80 { pos = pos + 1; }
        else if b0 < 0xC2 { return false; }
        else if b0 < 0xE0 {
            if pos + 2 > len { return false; }
            let b1: i32 = base[1] as i32;
            if (b1 & 0xC0) != 0x80 { return false; }
            let cp: u32 = (((b0 & 0x1F) << 6) | (b1 & 0x3F)) as u32;
            if cp < 0x80 as u32 { return false; }
            pos = pos + 2;
        } else if b0 < 0xF0 {
            if pos + 3 > len { return false; }
            let b1: i32 = base[1] as i32;
            let b2: i32 = base[2] as i32;
            if (b1 & 0xC0) != 0x80 { return false; }
            if (b2 & 0xC0) != 0x80 { return false; }
            let cp: u32 = (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)) as u32;
            if cp < 0x800 as u32 { return false; }
            if cp >= 0xD800 as u32 && cp <= 0xDFFF as u32 { return false; }
            pos = pos + 3;
        } else if b0 < 0xF5 {
            if pos + 4 > len { return false; }
            let b1: i32 = base[1] as i32;
            let b2: i32 = base[2] as i32;
            let b3: i32 = base[3] as i32;
            if (b1 & 0xC0) != 0x80 { return false; }
            if (b2 & 0xC0) != 0x80 { return false; }
            if (b3 & 0xC0) != 0x80 { return false; }
            let cp: u32 = (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) |
                           ((b2 & 0x3F) << 6)  |  (b3 & 0x3F)) as u32;
            if cp < 0x10000 as u32  { return false; }
            if cp > 0x10FFFF as u32 { return false; }
            pos = pos + 4;
        } else {
            return false;
        }
    }
    return true;
}

// ── Chars iterator ────────────────────────────────────────────────────────

// Iterator over the Unicode codepoints (u32) of a UTF-8 byte slice.
// Invalid sequences yield U+FFFD (one per invalid byte).
pub struct Chars {
    ptr: *const u8,
    pos: i64,
    len: i64,
}

// Construct a Chars iterator from a raw pointer + byte length.
pub unsafe fn chars_from_raw(ptr: *const u8, len: i64) -> Chars {
    return Chars { ptr: ptr, pos: 0, len: len };
}

// Construct a Chars iterator from a str slice.
pub fn str_chars(s: str) -> Chars {
    return Chars { ptr: s.as_ptr(), pos: 0, len: s.len() };
}

impl Iterator<u32> for Chars {
    fn next(self: &mut Chars) -> Option<u32> {
        if self.pos >= self.len {
            return Option::None;
        }
        unsafe {
            let b0: u8 = self.ptr[self.pos];
            let slen: i64 = seq_len(b0);
            let avail: i64 = self.len - self.pos;
            if slen > avail {
                self.pos = self.pos + 1;
                return Option::Some(0xFFFD as u32);
            }
            let p: *const u8 = (self.ptr as i64 + self.pos) as *const u8;
            let cp: u32 = decode(p);
            self.pos = self.pos + slen;
            return Option::Some(cp);
        }
    }
}
