// Logos standard library -- std.process
//
// Process spawning: fork + execvp + waitpid.
// Pipe-based stdin/stdout/stderr redirect via std.pipe.

package std.sys.process;

use std.io.pipe;

extern fn fork() -> i32;
extern fn execvp(file: *const u8, argv: *const *const u8) -> i32;
extern fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
extern fn _exit(code: i32);
extern fn dup2(oldfd: i32, newfd: i32) -> i32;
extern fn close(fd: i32) -> i32;
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;
extern fn read(fd: i32, buf: *mut u8, n: i64) -> i64;

// ---- ExitStatus -------------------------------------------------------------

pub struct ExitStatus {
    raw: i32,  // raw waitpid status word
}

impl ExitStatus {
    // True if the process exited normally (not killed by signal).
    pub fn success(self: &ExitStatus) -> bool {
        // WIFEXITED: (status & 0x7f) == 0
        return (self.raw & 127) == 0 && self.code() == 0;
    }

    pub fn exited(self: &ExitStatus) -> bool {
        return (self.raw & 127) == 0;
    }

    // Exit code when exited() is true; otherwise 0.
    pub fn code(self: &ExitStatus) -> i32 {
        // WEXITSTATUS: (status >> 8) & 0xff
        return (self.raw >> 8) & 255;
    }

    // Signal number if killed by signal; 0 otherwise.
    pub fn signal(self: &ExitStatus) -> i32 {
        // WTERMSIG: status & 0x7f
        return self.raw & 127;
    }
}

// ---- Child ------------------------------------------------------------------

pub struct Child {
    pid:    i32,
    stdin:  i32,  // write end of stdin pipe (-1 if not piped)
    stdout: i32,  // read end of stdout pipe (-1 if not piped)
    stderr: i32,  // read end of stderr pipe (-1 if not piped)
}

impl Child {
    pub fn pid(self: &Child) -> i32 { return self.pid; }

    // Write to child stdin (only valid if Command::pipe_stdin was set).
    pub fn write_stdin(self: &Child, buf: *const u8, len: i64) -> i64 {
        unsafe {
            if self.stdin < 0 { return 0 - 1 as i64; }
            return write(self.stdin, buf, len);
        }
    }

    // Read from child stdout (only valid if Command::pipe_stdout was set).
    pub fn read_stdout(self: &Child, buf: *mut u8, len: i64) -> i64 {
        unsafe {
            if self.stdout < 0 { return 0 - 1 as i64; }
            return read(self.stdout, buf, len);
        }
    }

    // Close child stdin pipe (signals EOF to child).
    pub fn close_stdin(self: &mut Child) {
        unsafe {
            if self.stdin >= 0 { close(self.stdin); self.stdin = 0 - 1; }
        }
    }

    // Close child stdout pipe.
    pub fn close_stdout(self: &mut Child) {
        unsafe {
            if self.stdout >= 0 { close(self.stdout); self.stdout = 0 - 1; }
        }
    }

    // Close child stderr pipe.
    pub fn close_stderr(self: &mut Child) {
        unsafe {
            if self.stderr >= 0 { close(self.stderr); self.stderr = 0 - 1; }
        }
    }

    // Wait for child to exit. Returns ExitStatus.
    pub fn wait(self: &mut Child) -> ExitStatus {
        unsafe {
            let mut status: i32 = 0;
            waitpid(self.pid, &mut status, 0);
            self.close_stdin();
            self.close_stdout();
            self.close_stderr();
            return ExitStatus { raw: status };
        }
    }
}

// ---- spawn ------------------------------------------------------------------

// Spawn a child process.
// argv must be a null-terminated array of null-terminated C strings.
// The first element is the program name/path.
// pipe_stdin / pipe_stdout / pipe_stderr: if true, open a pipe for that fd.
// Returns Child with pid=-1 on fork failure.
pub fn spawn(argv: *const *const u8,
             pipe_stdin: bool, pipe_stdout: bool, pipe_stderr: bool) -> Child {
    unsafe {
        // Create pipes as needed before fork.
        let mut in_pipe:  Pipe = if pipe_stdin  { pipe_new() } else { Pipe { read_fd: 0 - 1, write_fd: 0 - 1 } };
        let mut out_pipe: Pipe = if pipe_stdout { pipe_new() } else { Pipe { read_fd: 0 - 1, write_fd: 0 - 1 } };
        let mut err_pipe: Pipe = if pipe_stderr { pipe_new() } else { Pipe { read_fd: 0 - 1, write_fd: 0 - 1 } };

        let pid: i32 = fork();

        if pid < 0 {
            // fork failed
            in_pipe.close();
            out_pipe.close();
            err_pipe.close();
            return Child { pid: 0 - 1, stdin: 0 - 1, stdout: 0 - 1, stderr: 0 - 1 };
        }

        if pid == 0 {
            // Child process
            if pipe_stdin {
                close(in_pipe.write_fd);
                dup2(in_pipe.read_fd, 0);
                close(in_pipe.read_fd);
            }
            if pipe_stdout {
                close(out_pipe.read_fd);
                dup2(out_pipe.write_fd, 1);
                close(out_pipe.write_fd);
            }
            if pipe_stderr {
                close(err_pipe.read_fd);
                dup2(err_pipe.write_fd, 2);
                close(err_pipe.write_fd);
            }
            execvp(argv[0 as i64], argv);
            _exit(127);
            // unreachable
            return Child { pid: 0, stdin: 0, stdout: 0, stderr: 0 };
        }

        // Parent process: close child-side ends.
        if pipe_stdin  { close(in_pipe.read_fd);   in_pipe.read_fd  = 0 - 1; }
        if pipe_stdout { close(out_pipe.write_fd);  out_pipe.write_fd = 0 - 1; }
        if pipe_stderr { close(err_pipe.write_fd);  err_pipe.write_fd = 0 - 1; }

        return Child {
            pid:    pid,
            stdin:  in_pipe.write_fd,
            stdout: out_pipe.read_fd,
            stderr: err_pipe.read_fd,
        };
    }
}

// Convenience: spawn without any pipes (inherit parent fds).
pub fn spawn_simple(argv: *const *const u8) -> Child {
    return spawn(argv, false, false, false);
}
