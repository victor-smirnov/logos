// SPDX-License-Identifier: Apache-2.0
// Logos standard library -- std.args
//
// Minimal stateless CLI argument parser over the process argv array.
// Supports long flags (--name), short flags (-n), long options with values
// (--name=VAL or --name VAL), short options with values (-n VAL), the '--'
// positional terminator, and indexed positional access.
//
// Users needing richer behaviour (default values, required options, nested
// subcommands) can layer on top; this module aims for the 80% case.

package std.sys.args;

use std.sys.env;
use std.lang.text;
use std.lang.option;

// ── Raw argv helpers ─────────────────────────────────────────────────────
// We scan argv[1..] (argv[0] is the program path and ignored).

fn count() -> i32 {
    let c: i32 = args_count();
    if c < 1 { return 0; }
    return c - 1;
}

fn get(i: i32) -> str {
    return arg(i + 1);
}

fn is_flag_like(s: str) -> bool {
    if s.len() < 2 as i64 { return false; }
    unsafe { return s.as_ptr()[0 as i64] == 45 as u8; }   // '-'
}

fn is_long(s: str) -> bool {
    if s.len() < 3 as i64 { return false; }
    unsafe {
        return s.as_ptr()[0 as i64] == 45 as u8
            && s.as_ptr()[1 as i64] == 45 as u8;          // "--"
    }
}

// "--" exactly
fn is_dash_dash(s: str) -> bool {
    if s.len() != 2 as i64 { return false; }
    unsafe {
        return s.as_ptr()[0 as i64] == 45 as u8
            && s.as_ptr()[1 as i64] == 45 as u8;
    }
}

// Compare str a with str b for equality.
fn str_eq(a: str, b: str) -> bool {
    if a.len() != b.len() { return false; }
    let n: i64 = a.len();
    let mut i: i64 = 0 as i64;
    unsafe {
        while i < n {
            if a.as_ptr()[i] != b.as_ptr()[i] { return false; }
            i = i + 1 as i64;
        }
    }
    return true;
}

// Prefix-compare: does str `s` start with str `prefix`?
fn starts_with(s: str, prefix: str) -> bool {
    if s.len() < prefix.len() { return false; }
    let n: i64 = prefix.len();
    let mut i: i64 = 0 as i64;
    unsafe {
        while i < n {
            if s.as_ptr()[i] != prefix.as_ptr()[i] { return false; }
            i = i + 1 as i64;
        }
    }
    return true;
}

// Return substring (fat pointer) of `s` starting at byte offset `off`.
unsafe fn slice_from(s: str, off: i64) -> str {
    let p: *const u8 = (s.as_ptr() as i64 + off) as *const u8;
    let n: i64 = s.len() - off;
    return str_from_raw(p, n);
}

// ── Public API ───────────────────────────────────────────────────────────

// Returns true if either `--long` or `-short` appears as a bare flag in
// argv (up to but not past a '--' terminator).  `short` may be "" to
// disable short-flag matching.
pub fn has_flag(long_name: str, short_name: str) -> bool {
    let n: i32 = count();
    let mut i: i32 = 0;
    while i < n {
        let a: str = get(i);
        if is_dash_dash(a) { return false; }
        if is_long(a) {
            let body: str = unsafe { slice_from(a, 2 as i64) };
            if str_eq(body, long_name) { return true; }
        } else if is_flag_like(a) && short_name.len() > 0 as i64 {
            // -x or clustered -xyz.  Accept if short_name char appears.
            let body: str = unsafe { slice_from(a, 1 as i64) };
            let mut j: i64 = 0 as i64;
            unsafe {
                while j < body.len() {
                    if short_name.len() == 1 as i64
                       && body.as_ptr()[j] == short_name.as_ptr()[0 as i64] {
                        return true;
                    }
                    j = j + 1 as i64;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// Look up an option value:
//   --long=VALUE     (inline)
//   --long VALUE     (next arg)
//   -s VALUE         (next arg; only when short_name.len() == 1)
// Returns Some(value) or None.  Stops at '--' positional terminator.
pub fn get_option(long_name: str, short_name: str) -> Option<str> {
    let n: i32 = count();
    let mut i: i32 = 0;
    while i < n {
        let a: str = get(i);
        if is_dash_dash(a) { return Option::None; }
        if is_long(a) {
            // Try --long=VAL first.
            let body: str = unsafe { slice_from(a, 2 as i64) };
            // Find '='.
            let mut eq: i64 = 0 - 1 as i64;
            let mut j: i64 = 0 as i64;
            unsafe {
                while j < body.len() {
                    if body.as_ptr()[j] == 61 as u8 { eq = j; break; }
                    j = j + 1 as i64;
                }
            }
            if eq >= 0 as i64 {
                let key: str = unsafe { str_from_raw(body.as_ptr(), eq) };
                if str_eq(key, long_name) {
                    let val: str = unsafe { slice_from(body, eq + 1 as i64) };
                    return Option::Some(val);
                }
            } else if str_eq(body, long_name) {
                if (i + 1) < n {
                    return Option::Some(get(i + 1));
                }
                return Option::None;
            }
        } else if is_flag_like(a) && short_name.len() == 1 as i64 {
            let body: str = unsafe { slice_from(a, 1 as i64) };
            if body.len() == 1 as i64
               && unsafe { body.as_ptr()[0 as i64] == short_name.as_ptr()[0 as i64] } {
                if (i + 1) < n {
                    return Option::Some(get(i + 1));
                }
                return Option::None;
            }
        }
        i = i + 1;
    }
    return Option::None;
}

// Count of positional arguments (non-flags; everything after '--' is also
// positional).
pub fn positional_count() -> i32 {
    let n: i32 = count();
    let mut i: i32 = 0;
    let mut seen_dd: bool = false;
    let mut count_p: i32 = 0;
    while i < n {
        let a: str = get(i);
        if seen_dd {
            count_p = count_p + 1;
        } else if is_dash_dash(a) {
            seen_dd = true;
        } else if !is_flag_like(a) {
            count_p = count_p + 1;
        }
        i = i + 1;
    }
    return count_p;
}

// Return the idx-th positional argument (0-indexed), or "" if out of range.
pub fn positional(idx: i32) -> str {
    let n: i32 = count();
    let mut i: i32 = 0;
    let mut seen_dd: bool = false;
    let mut cur: i32 = 0;
    while i < n {
        let a: str = get(i);
        if seen_dd {
            if cur == idx { return a; }
            cur = cur + 1;
        } else if is_dash_dash(a) {
            seen_dd = true;
        } else if !is_flag_like(a) {
            if cur == idx { return a; }
            cur = cur + 1;
        }
        i = i + 1;
    }
    return "";
}

// Program name (argv[0]) — useful for usage messages.
pub fn program_name() -> str {
    return arg(0);
}
