// Logos standard library — std.time
//
// Monotonic timing (Instant) and wall-clock time (SystemTime).
//
// Both are stored as nanoseconds in an i64, giving a range of ~292 years.
//
// Layout note: clock_gettime fills a C `struct timespec { time_t tv_sec;
// long tv_nsec; }`.  On x86-64 Linux both fields are 64-bit, so we alloc
// 16 bytes, call clock_gettime, then read sec and nsec via *const i64 casts.
//
// Clock IDs (Linux):
//   CLOCK_REALTIME  = 0  — wall clock (affected by NTP / settimeofday)
//   CLOCK_MONOTONIC = 1  — monotonic, never goes backwards

package logos.std.time;

use logos.lang.mem;

// POSIX clock_gettime.  tp must point to at least 16 bytes (two i64s).
extern fn clock_gettime(clk_id: i32, tp: *mut u8) -> i32;

// ── Duration ──────────────────────────────────────────────────────────────

/// A span of time, stored as a signed nanosecond count (range ~±292 years).
/// Negative values are valid (represent time going backwards).
pub struct Duration {
    nanos: i64,
}

impl Copy for Duration {}

/// Creates a `Duration` from a nanosecond count.
pub fn duration_from_nanos(ns: i64) -> Duration {
    return Duration { nanos: ns };
}

/// Creates a `Duration` from a microsecond count.
pub fn duration_from_micros(us: i64) -> Duration {
    return Duration { nanos: us * 1000 as i64 };
}

/// Creates a `Duration` from a millisecond count.
pub fn duration_from_millis(ms: i64) -> Duration {
    return Duration { nanos: ms * 1000000 as i64 };
}

/// Creates a `Duration` from a whole-second count.
pub fn duration_from_secs(s: i64) -> Duration {
    return Duration { nanos: s * 1000000000 as i64 };
}

impl Duration {
    /// Returns the total nanoseconds in this duration.
    pub fn as_nanos(self: Duration) -> i64 {
        return self.nanos;
    }

    /// Returns the total whole microseconds, truncated toward zero.
    pub fn as_micros(self: Duration) -> i64 {
        return self.nanos / 1000 as i64;
    }

    /// Returns the total whole milliseconds, truncated toward zero.
    pub fn as_millis(self: Duration) -> i64 {
        return self.nanos / 1000000 as i64;
    }

    /// Returns the total whole seconds, truncated toward zero.
    pub fn as_secs(self: Duration) -> i64 {
        return self.nanos / 1000000000 as i64;
    }

    /// Returns the sub-second nanosecond remainder; negative for negative durations.
    pub fn subsec_nanos(self: Duration) -> i64 {
        return self.nanos % 1000000000 as i64;
    }

    /// Returns `true` if the duration is exactly zero.
    pub fn is_zero(self: Duration) -> bool {
        return self.nanos == 0 as i64;
    }

    /// Returns `true` if the duration is negative.
    pub fn is_negative(self: Duration) -> bool {
        return self.nanos < 0 as i64;
    }
}

// ── Internal: read timespec from a 16-byte buffer ─────────────────────────

unsafe fn read_timespec_nanos(buf: *mut u8) -> i64 {
    let sec_ptr:  *const i64 = buf as *const i64;
    let nsec_ptr: *const i64 = (buf as i64 + 8) as *const i64;
    let sec:  i64 = sec_ptr[0];
    let nsec: i64 = nsec_ptr[0];
    return sec * 1000000000 as i64 + nsec;
}

// ── Instant ───────────────────────────────────────────────────────────────

/// A measurement from a monotonic clock.
/// The absolute value has no meaning — only differences between `Instant`s.
pub struct Instant {
    nanos: i64,   // nanoseconds since unspecified monotonic epoch
}

impl Copy for Instant {}

/// Returns the current `Instant` from the monotonic clock (`CLOCK_MONOTONIC`).
/// `unsafe`: allocates a raw buffer for the libc `clock_gettime` call.
pub unsafe fn instant_now() -> Instant {
    let buf: *mut u8 = alloc(16 as i64);
    clock_gettime(1, buf);   // CLOCK_MONOTONIC = 1
    let ns: i64 = read_timespec_nanos(buf);
    dealloc(buf);
    return Instant { nanos: ns };
}

impl Instant {
    /// Returns the elapsed time from `earlier` to `self` (`self - earlier`).
    /// Negative if `earlier` is actually later; never panics (unlike Rust).
    pub fn since(self: Instant, earlier: Instant) -> Duration {
        return Duration { nanos: self.nanos - earlier.nanos };
    }

    /// Returns the elapsed time since this `Instant` was captured.
    pub unsafe fn elapsed(self: Instant) -> Duration {
        let now: Instant = instant_now();
        return Duration { nanos: now.nanos - self.nanos };
    }

    /// Returns the raw nanosecond reading; meaningful only relative to other `Instant`s.
    pub fn nanos_since_epoch(self: Instant) -> i64 {
        return self.nanos;
    }
}

// ── SystemTime ────────────────────────────────────────────────────────────

/// Wall-clock time (Unix epoch = 1970-01-01 00:00:00 UTC).
/// May go backwards on NTP adjustments.
pub struct SystemTime {
    nanos: i64,   // nanoseconds since Unix epoch
}

/// Returns the current wall-clock time (`CLOCK_REALTIME`).
/// `unsafe`: allocates a raw buffer for the libc `clock_gettime` call.
pub unsafe fn system_time_now() -> SystemTime {
    let buf: *mut u8 = alloc(16 as i64);
    clock_gettime(0, buf);   // CLOCK_REALTIME = 0
    let ns: i64 = read_timespec_nanos(buf);
    dealloc(buf);
    return SystemTime { nanos: ns };
}

impl SystemTime {
    /// Returns nanoseconds since the Unix epoch.
    pub fn unix_nanos(self: SystemTime) -> i64 {
        return self.nanos;
    }

    /// Returns whole seconds since the Unix epoch, truncated toward zero.
    pub fn unix_secs(self: SystemTime) -> i64 {
        return self.nanos / 1000000000 as i64;
    }

    /// Returns whole milliseconds since the Unix epoch, truncated toward zero.
    pub fn unix_millis(self: SystemTime) -> i64 {
        return self.nanos / 1000000 as i64;
    }

    /// Returns the duration from `earlier` to `self` (`self - earlier`); may be negative.
    pub fn since(self: SystemTime, earlier: SystemTime) -> Duration {
        return Duration { nanos: self.nanos - earlier.nanos };
    }
}

// ── sleep ─────────────────────────────────────────────────────────────────

extern fn nanosleep(req: *const u8, rem: *mut u8) -> i32;

/// Sleeps for the given duration via `nanosleep`; may wake early on a signal.
/// Returns immediately if `d` is zero or negative.
pub unsafe fn sleep(d: Duration) {
    if d.nanos <= 0 as i64 { return; }
    let buf: *mut u8 = alloc(16 as i64);
    let sec:  i64 = d.nanos / 1000000000 as i64;
    let nsec: i64 = d.nanos % 1000000000 as i64;
    let sec_ptr:  *mut i64 = buf as *mut i64;
    let nsec_ptr: *mut i64 = (buf as i64 + 8) as *mut i64;
    sec_ptr[0]  = sec;
    nsec_ptr[0] = nsec;
    nanosleep(buf as *const u8, 0 as *mut u8);
    dealloc(buf);
}
