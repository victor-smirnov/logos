// Logos stdlib — fiber reactor (async I/O on top of io_uring).
//
// Each worker thread owns one Reactor.  A fiber that needs to do I/O:
//   1. Obtains an SQE from the reactor's ring via reactor_get_sqe().
//   2. Prepares the SQE using any logos_io_uring_prep_* function.
//   3. Calls reactor_submit_and_park(r, sqe) which:
//        - attaches current fiber pointer as the SQE's user_data,
//        - submits the ring,
//        - parks the current fiber (does not re-enqueue).
//      When the kernel posts the CQE and the scheduler's idle loop
//      calls reactor_poll(), the parked fiber is re-enqueued with
//      the CQE result stashed in FLS slot 0; reactor_submit_and_park
//      then returns that result to the fiber.
//
// The reactor pointer is stored in a per-thread asm TLS slot so that
// async_* wrappers can find it without threading it through every call.

package logos.std.rt.fiber;

use logos.lang.mem;
// The cooperative scheduler/fiber core moved down to the lcm tier; the reactor
// (io_uring, an OS backend) stays in std and depends downward on it.
use logos.lcm.fiber;

// ── io_uring C shims (also declared in std.io_uring; re-extern here to
//    avoid a package-level dependency on std.io_uring just for types) ─────

extern fn logos_io_uring_sizeof()                                      -> i32;
extern fn logos_io_uring_init(entries: i32, ring: *mut u8)            -> i32;
extern fn logos_io_uring_exit(ring: *mut u8);
extern fn logos_io_uring_get_sqe(ring: *mut u8)                       -> *mut u8;
extern fn logos_io_uring_submit_and_wait(ring: *mut u8, wait_nr: i32) -> i32;
extern fn logos_io_uring_wait_cqe2(ring: *mut u8, cqe_out: *mut *mut u8) -> i32;
extern fn logos_io_uring_peek_cqe2(ring: *mut u8, cqe_out: *mut *mut u8) -> i32;
extern fn logos_io_uring_cqe_result(cqe: *mut u8)                     -> i32;
extern fn logos_io_uring_cqe_advance(ring: *mut u8, cqe: *mut u8);
extern fn logos_io_uring_cqe_user_data(cqe: *mut u8)                  -> i64;
extern fn logos_uring_sqe_set_data64(sqe: *mut u8, data: i64);

// Per-thread reactor pointer (asm TLS slot in fiber_ctx.S).
extern fn logos_reactor_get() -> *mut u8;
extern fn logos_reactor_set(ptr: *mut u8);

// ── Reactor ───────────────────────────────────────────────────────────────

/// Per-thread io_uring reactor: one ring plus a count of fibers parked on in-flight I/O.
pub struct Reactor {
    ring:         *mut u8,   // io_uring struct (size = logos_io_uring_sizeof())
    parked_count: i64,       // number of fibers awaiting CQEs
}

/// Allocates and initialises a new reactor with `entries` SQ/CQ slots.
/// Returns `0` (null) on `io_uring` init failure.
pub unsafe fn reactor_new(entries: i32) -> *mut Reactor {
    let sz: i32 = logos_io_uring_sizeof();
    let ring: *mut u8 = alloc(sz as i64);
    zero_bytes(ring, sz as i64);
    let rc: i32 = logos_io_uring_init(entries, ring);
    if rc < 0 {
        dealloc(ring);
        return 0 as *mut Reactor;
    }
    let r: *mut Reactor = alloc(sizeof::<Reactor>()) as *mut Reactor;
    r.ring = ring;
    r.parked_count = 0;
    return r;
}

/// Tears down the reactor and frees its allocations; no-op on null `r`.
pub unsafe fn reactor_free(r: *mut Reactor) {
    if r == 0 as *mut Reactor { return; }
    logos_io_uring_exit(r.ring);
    dealloc(r.ring);
    dealloc(r as *mut u8);
}

/// Installs `r` as the current thread's reactor (asm TLS slot).
pub fn reactor_set_current(r: *mut Reactor) {
    unsafe { logos_reactor_set(r as *mut u8); }
}

/// Returns the current thread's reactor, or `0` if none is installed.
pub fn reactor_current() -> *mut Reactor {
    return unsafe { logos_reactor_get() } as *mut Reactor;
}

/// Returns `true` if any fibers are parked awaiting CQEs; `false` for a null `r`.
pub fn reactor_has_parked(r: *const Reactor) -> bool {
    if r == 0 as *const Reactor { return false; }
    return unsafe { r.parked_count } > 0 as i64;
}

/// Obtains a free SQE from the reactor's ring; returns `0` if the ring is full.
/// Caller must fill the SQE via a `logos_io_uring_prep_*` function before
/// `reactor_submit_and_park`.
pub unsafe fn reactor_get_sqe(r: *mut Reactor) -> *mut u8 {
    return logos_io_uring_get_sqe(r.ring);
}

/// Submits `sqe` with the current fiber attached as `user_data`, parking until its CQE arrives.
/// Returns the CQE result (stashed in FLS slot 0 by `reactor_poll`) on resume;
/// -22 (`EINVAL`) when not running inside a fiber; negative submit errors pass through.
pub unsafe fn reactor_submit_and_park(r: *mut Reactor, sqe: *mut u8) -> i32 {
    let fptr: i64 = current_fiber();
    // user_data=0 is reserved for the notify-fd multishot poll; if we are
    // not running inside a fiber we must not park (nothing would wake us).
    if fptr == 0 as i64 { return 0 - 22; }
    logos_uring_sqe_set_data64(sqe, fptr);
    r.parked_count = r.parked_count + 1 as i64;
    // wait_nr=0 → submit without blocking.
    let rc: i32 = logos_io_uring_submit_and_wait(r.ring, 0);
    if rc < 0 {
        r.parked_count = r.parked_count - 1 as i64;
        return rc;
    }
    park_fiber();
    // When we resume, reactor_poll() has stored our CQE result in FLS[0].
    return fls_get(fls_key_cqe_result()) as i32;
}

/// Drains completions from the ring, re-enqueuing each CQE's fiber with the result in its FLS[0].
/// If `blocking`, waits (unconditionally) for the first CQE, then drains the rest non-blocking.
/// Returns the number of CQEs processed, or a negative errno from the blocking wait.
pub unsafe fn reactor_poll(r: *mut Reactor, blocking: bool) -> i32 {
    let mut count: i32 = 0;
    let mut cqe: *mut u8 = 0 as *mut u8;
    let cqe_pp: *mut *mut u8 = &mut cqe;

    if blocking {
        // Unconditionally block until a CQE arrives.  A notify-fd multishot
        // poll (user_data=0) may wake us without any fiber being parked, so
        // gating on parked_count would busy-loop in the idle path.
        let rc: i32 = logos_io_uring_wait_cqe2(r.ring, cqe_pp);
        if rc < 0 { return rc; }
        reactor_dispatch_cqe(r, cqe);
        logos_io_uring_cqe_advance(r.ring, cqe);
        count = count + 1;
    }

    // Non-blocking drain of any remaining CQEs.
    loop {
        let rc: i32 = logos_io_uring_peek_cqe2(r.ring, cqe_pp);
        if rc < 0 { break; }
        reactor_dispatch_cqe(r, cqe);
        logos_io_uring_cqe_advance(r.ring, cqe);
        count = count + 1;
    }
    return count;
}

/// Drives scheduler `s` and reactor `r` until both the run queue and the parked set are empty.
/// Suits single-threaded tests and simple drivers without the full thread-pool machinery.
pub unsafe fn reactor_run(s: *mut Scheduler, r: *mut Reactor) {
    loop {
        sched_run(s);
        if !reactor_has_parked(r as *const Reactor) { break; }
        let _: i32 = reactor_poll(r, true);
    }
}

// ── Sleep ────────────────────────────────────────────────────────────────
//
// fiber_sleep_ms / fiber_sleep_ns park the current fiber until a relative
// timer elapses, using IORING_OP_TIMEOUT.  The kernel posts a CQE with
// res=-ETIME (-62); we normalise that to 0 for success.  Returns a
// negative errno on failure (no reactor, full SQ, etc.).

struct KernelTimespec {
    tv_sec:  i64,
    tv_nsec: i64,
}

extern fn logos_io_uring_prep_timeout(sqe: *mut u8, ts: *const u8,
                                       count: i32, flags: i32);

/// Sleeps the current fiber for `ns` nanoseconds via `IORING_OP_TIMEOUT`.
/// Must run inside a fiber on a thread with a reactor installed.
/// Returns 0 on success (kernel `-ETIME` normalised); -22 for no reactor or
/// negative `ns`, -12 when the SQ is full.
pub fn fiber_sleep_ns(ns: i64) -> i32 {
    let r: *mut Reactor = reactor_current();
    if r == 0 as *mut Reactor { return 0 - 22; }
    if ns < 0 as i64 { return 0 - 22; }
    let ts: KernelTimespec = KernelTimespec {
        tv_sec:  ns / 1000000000 as i64,
        tv_nsec: ns % 1000000000 as i64,
    };
    unsafe {
        let sqe: *mut u8 = reactor_get_sqe(r);
        if sqe == 0 as *mut u8 { return 0 - 12; }
        logos_io_uring_prep_timeout(sqe, &ts as *const KernelTimespec as *const u8,
                                     0, 0);
        let res: i32 = reactor_submit_and_park(r, sqe);
        // -ETIME on normal expiry.
        if res == 0 - 62 { return 0; }
        return res;
    }
}

/// Sleeps the current fiber for `ms` milliseconds.
/// Same return contract as `fiber_sleep_ns`; negative `ms` returns -22.
pub fn fiber_sleep_ms(ms: i64) -> i32 {
    if ms < 0 as i64 { return 0 - 22; }
    return fiber_sleep_ns(ms * 1000000 as i64);
}

// Hand a single CQE to its waiting fiber: write the result into the
// fiber's FLS[0] and enqueue it back onto the scheduler's run queue.
unsafe fn reactor_dispatch_cqe(r: *mut Reactor, cqe: *mut u8) {
    let ud: i64 = logos_io_uring_cqe_user_data(cqe);
    let res: i32 = logos_io_uring_cqe_result(cqe);
    if ud != 0 as i64 {
        // FLS slot 0 receives the CQE result. Fiber.fls is private to the lcm
        // fiber core now, so go through its exported helper.
        fiber_store_cqe_result(ud, res as i64);
        unpark_fiber(ud);
        r.parked_count = r.parked_count - 1 as i64;
    }
}
