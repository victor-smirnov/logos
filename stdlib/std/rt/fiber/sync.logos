// Logos stdlib — fiber/sync: intra-thread sync primitives.
//
// Latch  — count-down latch; one waiter suspends until count reaches 0.
// Chan<T> — bounded buffered channel; sender or receiver suspends when full/empty.
//
// All primitives are single-thread only (no cross-thread use).
// Chan<T> supports at most one concurrent suspended sender AND one concurrent
// suspended receiver.  Violating this invariant causes deadlock.

package logos.std.rt.fiber;

use logos.lang.mem;

extern fn logos_fiber_switch(from: *mut FiberCtx, to: *const FiberCtx);
extern fn logos_sched_get() -> *mut u8;

// ── Latch ─────────────────────────────────────────────────────────────────

/// Count-down latch: a single waiter fiber suspends until the count reaches 0.
///
/// Single-thread only; supports at most one concurrent waiter.
pub struct Latch {
    count:  i64,   // decrements toward 0; waiter woken when 0
    waiter: i64,   // *mut Fiber or 0
}

/// Creates a heap-allocated `Latch` with the given initial count; free with `latch_free`.
pub fn latch_new(count: i64) -> *mut Latch {
    let l: *mut Latch = alloc(sizeof::<Latch>()) as *mut Latch;
    unsafe { l.count = count; l.waiter = 0; }
    return l;
}

/// Deallocates a `Latch` created by `latch_new`.
pub fn latch_free(l: *mut Latch) {
    dealloc(l as *mut u8);
}

/// Decrements the count (called by workers); wakes the waiter when the count reaches 0.
///
/// Extra calls after the count hits 0 are no-ops (no underflow).
pub fn latch_count_down(l: *mut Latch) {
    // Bug 4 fix: guard against underflow — extra count_down calls are no-ops.
    let cur_count: i64 = unsafe { l.count };
    if cur_count <= 0 { return; }
    let c: i64 = cur_count - 1;
    unsafe { l.count = c; }
    if c == 0 {
        let waiter: i64 = unsafe { l.waiter };
        if waiter != 0 {
            unsafe { l.waiter = 0; }
            let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
            sched_enqueue(s, waiter);
        }
    }
}

/// Suspends the current fiber until the count reaches 0; returns immediately if already 0.
///
/// Single waiter only: a second concurrent `latch_wait` overwrites the first, deadlocking it.
pub fn latch_wait(l: *mut Latch) {
    let c: i64 = unsafe { l.count };
    if c == 0 { return; }
    let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
    let cur: i64 = unsafe { s.current };
    unsafe { l.waiter = cur; s.current = 0; }
    let fiber: *mut Fiber    = cur as *mut Fiber;
    let from:  *mut FiberCtx = fiber as *mut FiberCtx;
    let to: *const FiberCtx  = unsafe { &s.sched_ctx as *const FiberCtx };
    unsafe { logos_fiber_switch(from, to); }
}

// ── Chan<T> ───────────────────────────────────────────────────────────────
//
// Ring buffer of sizeof::<T>()-byte slots.
// send_val holds a heap *mut T when a sender is suspended.

/// Bounded FIFO channel between fibers on one thread, backed by a ring buffer.
///
/// At most one suspended sender AND one suspended receiver at a time; violating
/// this invariant is a caller error (see `chan_send` / `chan_recv`).
pub struct Chan<T> {
    buf:        *mut u8,  // ring buffer: cap * sizeof::<T>() bytes
    head:       i64,      // read index
    tail:       i64,      // write index
    cap:        i64,      // max items
    len:        i64,      // current item count
    elem_size:  i64,      // sizeof::<T>()
    send_fiber: i64,      // *mut Fiber of suspended sender, or 0
    send_val:   i64,      // *mut T on heap (pending send value), or 0
    recv_fiber: i64,      // *mut Fiber of suspended receiver, or 0
}

/// Creates a heap-allocated channel holding up to `cap` items; free with `chan_free`.
pub fn chan_new<T>(cap: i64) -> *mut Chan<T> {
    let sz: i64 = sizeof::<T>();
    let ch: *mut Chan<T> = alloc(sizeof::<Chan<T>>()) as *mut Chan<T>;
    let buf: *mut u8 = alloc(cap * sz);
    unsafe {
        ch.buf        = buf;
        ch.head       = 0;
        ch.tail       = 0;
        ch.cap        = cap;
        ch.len        = 0;
        ch.elem_size  = sz;
        ch.send_fiber = 0;
        ch.send_val   = 0;
        ch.recv_fiber = 0;
    }
    return ch;
}

/// Deallocates the channel, its ring buffer, and any pending suspended-send value.
pub fn chan_free<T>(ch: *mut Chan<T>) {
    // Bug 3 fix: free any heap-allocated pending send value.
    let sv: i64 = unsafe { ch.send_val };
    if sv != 0 { dealloc(sv as *mut u8); }
    let buf: *mut u8 = unsafe { ch.buf };
    dealloc(buf);
    dealloc(ch as *mut u8);
}

// Write one item into the ring (caller guarantees len < cap).
fn chan_ring_write<T>(ch: *mut Chan<T>, val: T) {
    let sz:   i64     = unsafe { ch.elem_size };
    let tail: i64     = unsafe { ch.tail };
    let cap:  i64     = unsafe { ch.cap };
    let buf:  *mut u8 = unsafe { ch.buf };
    let slot: *mut T  = (buf as i64 + tail * sz) as *mut T;
    unsafe { *slot = val; }
    unsafe { ch.tail = (tail + 1) % cap; }
    // Bug 1 fix: read len into local before incrementing (no nested unsafe).
    let old_len: i64 = unsafe { ch.len };
    unsafe { ch.len = old_len + 1; }
}

// Read one item from the ring (caller guarantees len > 0).
fn chan_ring_read<T>(ch: *mut Chan<T>) -> T {
    let sz:   i64       = unsafe { ch.elem_size };
    let head: i64       = unsafe { ch.head };
    let cap:  i64       = unsafe { ch.cap };
    let buf:  *const u8 = unsafe { ch.buf } as *const u8;
    let slot: *const T  = (buf as i64 + head * sz) as *const T;
    let val: T          = unsafe { *slot };
    unsafe { ch.head = (head + 1) % cap; }
    // Bug 2 fix: read len into local before decrementing (no nested unsafe).
    let old_len: i64 = unsafe { ch.len };
    unsafe { ch.len = old_len - 1; }
    return val;
}

/// Sends `val` into the channel; suspends the current fiber while the channel is full.
///
/// Wakes a suspended receiver if one is waiting. If another sender is already
/// suspended (caller error), returns immediately and `val` is silently dropped.
pub fn chan_send<T>(ch: *mut Chan<T>, val: T) {
    let cap: i64 = unsafe { ch.cap };
    let len: i64 = unsafe { ch.len };

    if len < cap {
        // There is space — write and optionally wake a waiting receiver.
        chan_ring_write::<T>(ch, val);
        let recv_fiber: i64 = unsafe { ch.recv_fiber };
        if recv_fiber != 0 {
            unsafe { ch.recv_fiber = 0; }
            let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
            sched_enqueue(s, recv_fiber);
        }
        return;
    }

    // Bug 5 fix: enforce single-suspended-sender invariant.
    // A second concurrent sender would silently overwrite the first, causing deadlock.
    let existing_sf: i64 = unsafe { ch.send_fiber };
    if existing_sf != 0 { return; }  // caller error: multiple concurrent senders

    // Channel full — heap-copy val and suspend.
    let vp: *mut T = alloc(sizeof::<T>()) as *mut T;
    unsafe { *vp = val; }
    let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
    let cur: i64 = unsafe { s.current };
    unsafe {
        ch.send_fiber = cur;
        ch.send_val   = vp as i64;
        s.current     = 0;
    }
    let fiber: *mut Fiber    = cur as *mut Fiber;
    let from:  *mut FiberCtx = fiber as *mut FiberCtx;
    let to: *const FiberCtx  = unsafe { &s.sched_ctx as *const FiberCtx };
    unsafe { logos_fiber_switch(from, to); }
}

/// Receives a value from the channel; suspends the current fiber while the channel is empty.
///
/// Unblocks a suspended sender by moving its pending value into the ring. If another
/// receiver is already suspended (caller error), the result is undefined (null read).
pub fn chan_recv<T>(ch: *mut Chan<T>) -> T {
    let len: i64 = unsafe { ch.len };

    if len > 0 {
        let val: T = chan_ring_read::<T>(ch);
        // If a sender was suspended waiting for space, unblock it now.
        let sf: i64 = unsafe { ch.send_fiber };
        if sf != 0 {
            let sv: i64 = unsafe { ch.send_val };
            unsafe { ch.send_fiber = 0; ch.send_val = 0; }
            // Write the pending value into the ring.
            let vp: *mut T = sv as *mut T;
            let pval: T = unsafe { *vp };
            dealloc(vp as *mut u8);
            chan_ring_write::<T>(ch, pval);
            let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
            sched_enqueue(s, sf);
        }
        return val;
    }

    // Bug 5 fix: enforce single-suspended-receiver invariant.
    let existing_rf: i64 = unsafe { ch.recv_fiber };
    if existing_rf != 0 {
        // Caller error: multiple concurrent receivers — return zero value.
        let zero: T = unsafe { *(0 as *const T) };
        return zero;
    }

    // Channel empty — suspend until a sender arrives.
    let s: *mut Scheduler = unsafe { logos_sched_get() } as *mut Scheduler;
    let cur: i64 = unsafe { s.current };
    unsafe { ch.recv_fiber = cur; s.current = 0; }
    let fiber: *mut Fiber    = cur as *mut Fiber;
    let from:  *mut FiberCtx = fiber as *mut FiberCtx;
    let to: *const FiberCtx  = unsafe { &s.sched_ctx as *const FiberCtx };
    unsafe { logos_fiber_switch(from, to); }

    // Resumed by a sender that wrote into the ring.
    return chan_ring_read::<T>(ch);
}
