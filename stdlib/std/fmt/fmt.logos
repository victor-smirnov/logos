// Logos standard library — logos.std.fmt
//
// Macro shells (`format!`, `print!`, `println!`, `eprint!`, `eprintln!`,
// `panic!`, `assert!`, `assert_eq!`, `assert_ne!`) and the runtime
// `format_args_str` fallback. Per-trait free-fn dispatchers
// (`fmt_display`/`fmt_debug`/`fmt_lower_hex`/etc.) bridge sema's
// metacall lowering to the `mem.fmt` traits over `Formatter`.
//
// The actual `Display`/`Debug`/`LowerHex`/... traits + impls live in
// `mem.fmt`; this module exists only to plumb the macros + provide
// shells callable as `format!(...)` from user code.
//
// Usage:
//   use logos.std.fmt;
//   let s: String = format!("n={}, ok={}", 42, true);
//   println!(s);

package logos.std.fmt;

use logos.mem.string;
use logos.lang.str;
use logos.lang.panic;
use logos.lang.cmp;
use logos.lang.option;
use logos.lang.result;
use logos.mem.collections.vec;
pub use logos.mem.fmt;
use logos.std.compiler.metaprog;
use logos.std.io;

// ── Per-trait dispatch helpers (sema-resident lowering hook) ──────────────
//
// Sema's `lower_method_call` short-circuits dot-method dispatch on slice
// and str receivers (returns "slice has no method '<name>'"). Generic-
// context dispatch through a trait bound still works, so the metacall
// lowering routes every placeholder through one of these thin wrappers
// instead of emitting `(arg).fmt(&mut __f)` directly.
//
// Each helper takes the arg by value (matching the metacall call-site
// shape); the trait methods then take `&self`, so the wrapper bridges
// by borrowing internally. For slice/str/primitive types this is a
// fat-ptr or scalar copy; for owned types it consumes — same semantics
// as the legacy variadic `format_args_str` had.

// The single-trait dispatcher free fns (`fmt_display` / `fmt_debug` / ...)
// live in `logos.mem.fmt` alongside the traits + Formatter (and are
// re-exported here via `pub use logos.mem.fmt`). They bind one fmt trait
// through a generic bound so a bare `.fmt()` — ambiguous now that every
// fmt-family trait declares `fmt` — resolves unambiguously. The format-family
// metacall lowering emits calls to them by bare name.

// ── Runtime format-args fallback (dynamic-pattern path) ───────────────────
//
// For compile-time format strings the sema-resident metacall lowering
// rewrites directly to a Formatter pipeline (see sema_expr.cpp's
// format-family handler), so this code path only fires for the
// dynamic-pattern shape `format!(s, args)` where `s` is not a string
// literal. Limited to `{}` / `{:?}` placeholders — full spec parsing
// at runtime would duplicate the sema-time parser; not worth the
// complexity until a real use-case surfaces.

unsafe fn fmt_into(pat: str, fi: i64, flen: i64, f: &mut Formatter) {
    let mut i: i64 = fi;
    while i < flen { unsafe { { let _ = (*f.w).write_char(pat[i]); } } i = i + 1; }
}

unsafe fn fmt_into<H: Display + Debug, T...>(pat: str, fi: i64, flen: i64,
                                                   f: &mut Formatter,
                                                   first: H, rest: T...) {
    let mut i: i64 = fi;
    while i < flen {
        let c: i32 = pat[i] as i32;
        if c == 123 && i + 1 < flen && (pat[i + 1] as i32) == 123 {
            unsafe { { let _ = (*f.w).write_char(pat[i]); } }
            i = i + 2;
            continue;
        }
        if c == 125 && i + 1 < flen && (pat[i + 1] as i32) == 125 {
            unsafe { { let _ = (*f.w).write_char(pat[i]); } }
            i = i + 2;
            continue;
        }
        if c == 123 && i + 1 < flen {
            // `{}` — Display.
            if (pat[i + 1] as i32) == 125 {
                f.reset_spec();
                // `H: Display + Debug` makes a bare `.fmt()` ambiguous; route
                // through the single-trait dispatcher to select Display.
                let _ = fmt_display::<H>(&first, f);
                fmt_into(pat, i + 2, flen, f, rest...);
                return;
            }
            // `{:?}` — Debug.
            if i + 3 < flen
                && (pat[i + 1] as i32) == 58       // ':'
                && (pat[i + 2] as i32) == 63       // '?'
                && (pat[i + 3] as i32) == 125 {    // '}'
                f.reset_spec();
                // Debug placeholder `{:?}` — select Debug via its dispatcher.
                let _ = fmt_debug::<H>(&first, f);
                fmt_into(pat, i + 4, flen, f, rest...);
                return;
            }
        }
        unsafe { { let _ = (*f.w).write_char(pat[i]); } }
        i = i + 1;
    }
}

// format_args_str::<T...>(pattern, args...) -> String
//
// Runtime fn that `format!` and the variadic `format` alias both lower
// to when sema-resident lowering can't fire (dynamic pattern). Owns
// the buffer + Formatter; returns the assembled String (Drop frees).
/// Formats `args` into a new `String` per the `{}`/`{:?}` placeholders in `pat`.
/// Runtime fallback for dynamic (non-literal) patterns; handles only `{}` (Display),
/// `{:?}` (Debug), and `{{`/`}}` escapes — no format-spec parsing.
pub fn format_args_str<T...: Display + Debug>(pat: str, args: T...) -> String {
    let mut buf: String = String::new();
    let mut f: Formatter = Formatter::new(&mut buf);
    unsafe { fmt_into(pat, 0i64, pat.len(), &mut f, args...); }
    return buf;
}

// Back-compat alias. Some pre-macro test code wrote `format::<T...>("...", a, b)`.
/// Returns `format_args_str(pat, args...)`; back-compat alias for plain fn-call sites.
pub fn format<T...: Display + Debug>(pat: str, args: T...) -> String {
    return format_args_str(pat, args...);
}

// ── Macro shells ──────────────────────────────────────────────────────────
//
// `format!("pat", args...)` and friends — Rust-style metacall shells.
// The macro receives every `(args)` element as `ExprBlob` and splices
// them back into a single call. Element types and arity of the
// underlying `format_args_str` are inferred from the spliced AST at
// the expansion site (same path that lets `format_args_str("...", a, b)`
// work without turbofish in plain fn-call form).

/// Implements the `format!` macro: expands to a `format_args_str(...)` call yielding `String`.
/// Invocation: `let s: String = format!("n={}, ok={}", 42, true);`.
#[fn_macro]
pub fn format(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! { format_args_str(#(#args),*) };
}

// Thin re-exports of logos.std.io print/println so the macro splices resolve
// at the user's call-site without forcing a separate `use logos.std.io;`.
// Marked pub so the spliced expression sees them. Inline-trivial — the
// optimizer collapses the wrapper.
/// Writes `s` to stdout; `pub` only so `print!` expansions resolve it.
pub fn __fmt_print(s: str)    { print(s); }
/// Writes `s` and a newline to stdout; `pub` only so `println!` expansions resolve it.
pub fn __fmt_println(s: str)  { println(s); }
/// Writes `s` to stderr; `pub` only so `eprint!` expansions resolve it.
pub fn __fmt_eprint(s: str)   { eprint(s); }
/// Writes `s` and a newline to stderr; `pub` only so `eprintln!` expansions resolve it.
pub fn __fmt_eprintln(s: str) { eprintln(s); }

/// Implements the `print!` macro: formats and writes to stdout, no trailing newline.
/// Invocation: `print!("n={}", 42);`.
#[fn_macro]
pub fn print(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_print(__s.as_str()); }
    };
}

/// Implements the `println!` macro: formats and writes a newline-terminated line to stdout.
/// Invocation: `println!("n={}", 42);`.
#[fn_macro]
pub fn println(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_println(__s.as_str()); }
    };
}

/// Implements the `eprint!` macro: formats and writes to stderr, no trailing newline.
/// Invocation: `eprint!("n={}", 42);`.
#[fn_macro]
pub fn eprint(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_eprint(__s.as_str()); }
    };
}

/// Implements the `eprintln!` macro: formats and writes a newline-terminated line to stderr.
/// Invocation: `eprintln!("n={}", 42);`.
#[fn_macro]
pub fn eprintln(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_eprintln(__s.as_str()); }
    };
}

// write!(sink, "fmt", args…) / writeln!(…) — format into a String then flush
// to the Write sink via `sink.write_str(…)`, returning the sink's
// Result<(), Error>. The common literal-format-string case is intercepted by
// sema's format-family lowering (sema_expr.cpp), which applies per-placeholder
// specs directly; this `#[fn_macro]` body is the non-literal fallback (and the
// registration that makes `write!`/`writeln!` callable). The sink is args[0];
// the format string + value args follow.
/// Implements the `write!` macro: formats and writes to a sink via `write_str`, yielding its
/// `Result<(), Error>`. Invocation: `write!(f, "({}, {})", self.x, self.y)`.
#[fn_macro]
pub fn write(args: Vec<ExprBlob>) -> ExprBlob {
    let sink: ExprBlob = args.get(0i64);
    let mut rest: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let n: i64 = args.length();
    let mut i: i64 = 1i64;
    while i < n { rest.push(args.get(i)); i = i + 1i64; }
    return quote_expr! {
        { let __s: String = format_args_str(#(#rest),*); (#sink).write_str(__s.as_str()) }
    };
}

/// Implements the `writeln!` macro: like `write!` with a trailing newline appended.
/// Invocation: `writeln!(sink, "m={}", 7)`.
#[fn_macro]
pub fn writeln(args: Vec<ExprBlob>) -> ExprBlob {
    let sink: ExprBlob = args.get(0i64);
    let mut rest: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let n: i64 = args.length();
    let mut i: i64 = 1i64;
    while i < n { rest.push(args.get(i)); i = i + 1i64; }
    return quote_expr! {
        { let mut __s: String = format_args_str(#(#rest),*); __s.push_str("\n"); (#sink).write_str(__s.as_str()) }
    };
}

// ── Assertion macros (Rust-compatible surface) ───────────────────────────
//
// `assert!(cond)` / `assert!(cond, fmt, args...)` and
// `assert_eq!(a, b)` panic on assertion failure with a Debug-rendered
// message. Both go through `__fmt_panic` so the splice site only needs
// `use logos.std.fmt;` — std.lang.panic doesn't have to be in the caller's
// scope.

// `-> !`: panic never returns, and the Never return type is what makes a
// `panic!(...)` expansion type as `!` in expression position (match-arm /
// if-arm / let unifiers all key off `is_divergent_call_node`).
/// Panics with `msg`; `-> !` makes `panic!` expansions type as `!` in expression position.
pub fn __fmt_panic(msg: str) -> ! { panic(msg); }

// `panic!(...)` macro — formats per Rust's panic! and aborts.
// Bodies emit `format!(...)` (not `format_args_str(...)`) so sema's
// format-family interception fires on the per-placeholder dispatch and
// the variadic bound `T...: Display + Debug` on the runtime fn
// never has to bind to non-Display types (Result<i32, str>, tuples
// with only Debug, etc.).
/// Implements the `panic!` macro: formats a message and aborts; the expansion types as `!`.
/// Invocation: `panic!("bad state: {}", x);`.
#[fn_macro]
pub fn panic(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __m: String = format!(#(#args),*); __fmt_panic(__m.as_str()); }
    };
}

// All three assertion macros lower to a unit-typed if-expression with
// non-empty `()`-tailed branches: Logos rejects empty branches in
// block-as-expression position and the macro emits its block as the
// invocation's value. `panic` aborts, so the `()` tail in the panic
// branch is unreachable — type-checker only sees that both branches
// produce ().
/// Implements the `assert!` macro: panics if the condition is false.
/// Invocation: `assert!(a < b)` or `assert!(ok, "bad n={}", n)` (custom formatted message).
#[fn_macro]
pub fn assert(args: Vec<ExprBlob>) -> ExprBlob {
    let n: i64 = args.length();
    if n == 1i64 {
        let cond: ExprBlob = args.get(0i64);
        return quote_expr! {
            if !(#cond) { __fmt_panic("assertion failed"); () } else { () }
        };
    }
    let cond: ExprBlob = args.get(0i64);
    let mut tail: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut i: i64 = 1i64;
    while i < n {
        tail.push(args.get(i));
        i = i + 1i64;
    }
    return quote_expr! {
        if !(#cond) {
            let __m: String = format!(#(#tail),*);
            __fmt_panic(__m.as_str());
            ()
        } else { () }
    };
}

/// Implements the `assert_eq!` macro: panics with both values Debug-rendered when `a != b`.
/// Invocation: `assert_eq!(2 + 2, 4);`.
/// The RHS is re-evaluated for the message on failure (at most one extra eval, failure-only).
#[fn_macro]
pub fn assert_eq(args: Vec<ExprBlob>) -> ExprBlob {
    // Bind only `__a` up-front; inline `#b` into the comparison so
    // IntLit on the b side stays IntLit through the BinOp site, where
    // sema's IntLit-vs-concrete-int coercion fires. With the earlier
    // `let __b = #b;` form, an IntLit `#b` got defaulted to i32 before
    // the comparison saw it, so `assert_eq!(isize_val, 90)` and any
    // other "literal RHS, sized LHS" shape failed type-check.
    //
    // The format path stays inside the failure branch with its own
    // local `__b` binding (`#b` re-evaluated only when the assertion
    // actually fails). Pure value RHS double-evals are cheap; side-
    // effectful RHS still gets at-most one extra eval (failure-only).
    let a: ExprBlob = args.get(0i64);
    let b: ExprBlob = args.get(1i64);
    return quote_expr! {
        {
            let __a = #a;
            if __a != (#b) {
                let __b = #b;
                let __m: String = format!(
                    "assertion failed: {:?} != {:?}", __a, __b);
                __fmt_panic(__m.as_str());
                ()
            } else { () }
        }
    };
}

/// Implements the `assert_ne!` macro: panics with both values Debug-rendered when `a == b`.
/// Invocation: `assert_ne!(id, 0);`.
/// The RHS is re-evaluated for the message on failure (at most one extra eval, failure-only).
#[fn_macro]
pub fn assert_ne(args: Vec<ExprBlob>) -> ExprBlob {
    let a: ExprBlob = args.get(0i64);
    let b: ExprBlob = args.get(1i64);
    return quote_expr! {
        {
            let __a = #a;
            if __a == (#b) {
                let __b = #b;
                let __m: String = format!(
                    "assertion failed: {:?} == {:?}", __a, __b);
                __fmt_panic(__m.as_str());
                ()
            } else { () }
        }
    };
}

// §6.11 marker macros — `unreachable!(...)`, `todo!(...)`,
// `unimplemented!(...)` — are wired as compiler built-ins in
// `sema_expr.cpp::lower_builtin_macro` (they re-parse to
// `panic!(...)` so the format-family fast-path types the call as
// Never in any position — arm, tail, expression). Keeping the
// expansion in C++ avoids re-implementing the per-callee fast-path
// in stdlib metaprog form, which would require a way to route a
// fn_macro return through the format-family inlining.
