// SPDX-License-Identifier: Apache-2.0
// Logos standard library — std.fmt
//
// format() — build a String from a pattern with {} placeholders.
// Uses the Display trait from std.string for type-to-string conversion.
//
// Usage:
//   use std.fmt;
//   let s: String = format::<i32, bool>("n={}, ok={}", 42, true);
//   println(s);
//   // s freed automatically by Drop

package std.fmt;

use std.lang.text;
use std.compiler.metaprog;
use std.collections.vec;
use std.io;

// ── Debug trait ───────────────────────────────────────────────────────────
//
// `Debug` mirrors `Display` (same `fn fmt(self, &mut String)` shape) but
// is a separate trait so that derive-Debug-style metaprograms can target
// it without colliding with user-written Display impls. Method renamed
// to `dbg` to avoid two-trait `x.fmt(buf)` ambiguity.

trait Debug {
    fn dbg(self: Self, buf: &mut String);
}

impl Debug for i32 { fn dbg(self: i32, buf: &mut String) { self.fmt(buf); } }
impl Debug for i64 { fn dbg(self: i64, buf: &mut String) { self.fmt(buf); } }
impl Debug for u64 { fn dbg(self: u64, buf: &mut String) { self.fmt(buf); } }
impl Debug for bool { fn dbg(self: bool, buf: &mut String) { self.fmt(buf); } }

// Debug for str wraps the content in double quotes (Rust-style). Direct
// dot-call `"x".dbg(buf)` still trips sema_expr.cpp's slice/str method
// short-circuit — but trait-bound dispatch from a generic context (the
// `T...: Debug` bound on `format_args_str`) goes through trait_bound_resolution
// and works.
impl Debug for str {
    fn dbg(self: str, buf: &mut String) {
        buf.push_u8(34u8);     // "
        buf.push_str(self);
        buf.push_u8(34u8);     // "
    }
}

// ── Format engine (variadic) ──────────────────────────────────────────────

// Base case: no more args — copy remaining format string into buf.
unsafe fn fmt_into(fmt: str, fi: i64, flen: i64, buf: &mut String) {
    let mut i: i64 = fi;
    while i < flen {
        buf.push_u8(fmt[i]);
        i = i + 1;
    }
}

// Recursive case: find next `{}` or `{:?}`, format one arg via
// Display or Debug accordingly, recurse on rest. `{{` and `}}`
// escape one literal brace each.
unsafe fn fmt_into<H: Display + Debug, T...>(fmt: str, fi: i64, flen: i64,
                                              buf: &mut String,
                                              first: H, rest: T...) {
    let mut i: i64 = fi;
    while i < flen {
        let c: i32 = fmt[i] as i32;
        // Escaped `{{` / `}}` — emit one literal brace and skip ahead.
        if c == 123 && i + 1 < flen && (fmt[i + 1] as i32) == 123 {
            buf.push_u8(fmt[i]);
            i = i + 2;
            continue;
        }
        if c == 125 && i + 1 < flen && (fmt[i + 1] as i32) == 125 {
            buf.push_u8(fmt[i]);
            i = i + 2;
            continue;
        }
        if c == 123 && i + 1 < flen {
            // `{}` — Display.
            if (fmt[i + 1] as i32) == 125 {
                first.fmt(buf);
                fmt_into(fmt, i + 2, flen, buf, rest...);
                return;
            }
            // `{:?}` — Debug.
            if i + 3 < flen
                && (fmt[i + 1] as i32) == 58       // ':'
                && (fmt[i + 2] as i32) == 63       // '?'
                && (fmt[i + 3] as i32) == 125 {    // '}'
                first.dbg(buf);
                fmt_into(fmt, i + 4, flen, buf, rest...);
                return;
            }
        }
        buf.push_u8(fmt[i]);
        i = i + 1;
    }
}

// ── Public API ────────────────────────────────────────────────────────────

// format_args_str::<T...>(pattern, args...) -> String
// Runtime fn that the `format!()` macro lowers to. Returns an owned
// String. Drop frees it automatically. Variadic type-arg inference
// means callers usually write `format_args_str("n={}", n)` without
// turbofish; the macro shell takes care of any remaining ergonomics.
pub fn format_args_str<T...: Display + Debug>(pattern: str, args: T...) -> String {
    let flen: i64 = pattern.len();
    let mut buf: String = String::new();
    unsafe { fmt_into(pattern, 0 as i64, flen, &mut buf, args...); }
    return buf;
}

// Back-compat alias: existing callers wrote `format::<T...>("...", args)`
// before the `format!` macro shell landed. Keep the bare name working
// so we don't churn unrelated tests on this slice.
pub fn format<T...: Display + Debug>(pattern: str, args: T...) -> String {
    return format_args_str(pattern, args...);
}

// ── Macro shells (slice 4.1 of fn-macros) ─────────────────────────────────
//
// `format!("pat", args...)` — Rust-style shorthand around `format_args_str`.
// The macro callee receives every `(args)` element as an `ExprBlob` and
// splices them back into a single call. Element type and arity of the
// underlying `format_args_str` are inferred from the spliced AST at the
// expansion site — same path that lets `format_args_str("...", a, b)`
// already work without turbofish.

#[fn_macro]
pub fn format(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! { format_args_str(#(#args),*) };
}

// Thin re-exports of std.io print/println so the macro splices resolve
// at the user's call-site without forcing a separate `use std.io;`.
// Marked pub so the spliced expression sees them. Inline-trivial — the
// optimizer collapses the wrapper.
pub fn __fmt_print(s: str)    { print(s); }
pub fn __fmt_println(s: str)  { println(s); }
pub fn __fmt_eprint(s: str)   { eprint(s); }
pub fn __fmt_eprintln(s: str) { eprintln(s); }

#[fn_macro]
pub fn print(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_print(__s.as_str()); }
    };
}

#[fn_macro]
pub fn println(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_println(__s.as_str()); }
    };
}

#[fn_macro]
pub fn eprint(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_eprint(__s.as_str()); }
    };
}

#[fn_macro]
pub fn eprintln(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_eprintln(__s.as_str()); }
    };
}
