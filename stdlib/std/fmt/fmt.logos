// SPDX-License-Identifier: Apache-2.0
// Logos standard library — std.fmt
//
// format() — build a String from a pattern with {} placeholders.
// Uses the Display trait from std.string for type-to-string conversion.
//
// Usage:
//   use std.fmt;
//   let s: String = format::<i32, bool>("n={}, ok={}", 42, true);
//   println(s);
//   // s freed automatically by Drop

package std.fmt;

use std.lang.text;

// ── Debug trait ───────────────────────────────────────────────────────────
//
// `Debug` mirrors `Display` (same `fn fmt(self, &mut String)` shape) but
// is a separate trait so that derive-Debug-style metaprograms can target
// it without colliding with user-written Display impls. Method renamed
// to `dbg` to avoid two-trait `x.fmt(buf)` ambiguity.

trait Debug {
    fn dbg(self: Self, buf: &mut String);
}

impl Debug for i32 { fn dbg(self: i32, buf: &mut String) { self.fmt(buf); } }
impl Debug for i64 { fn dbg(self: i64, buf: &mut String) { self.fmt(buf); } }
impl Debug for u64 { fn dbg(self: u64, buf: &mut String) { self.fmt(buf); } }
impl Debug for bool { fn dbg(self: bool, buf: &mut String) { self.fmt(buf); } }

// NOTE: `impl Debug for str` is intentionally not provided here. Direct
// method-call dispatch on slice/str types short-circuits trait impls in
// sema_expr.cpp::lower_method_call — `"x".dbg(&mut s)` errors with
// "slice has no method 'dbg'". Generic-context dispatch (T: Debug) works
// fine, so this trait is usable inside generic code today. Direct dot-
// call for str is a separate sema fix (planned slice).

// ── Format engine (variadic) ──────────────────────────────────────────────

// Base case: no more args — copy remaining format string into buf.
unsafe fn fmt_into(fmt: str, fi: i64, flen: i64, buf: &mut String) {
    let mut i: i64 = fi;
    while i < flen {
        buf.push_u8(fmt[i]);
        i = i + 1;
    }
}

// Recursive case: find next {}, format one arg via Display, recurse on rest.
unsafe fn fmt_into<H: Display, T...>(fmt: str, fi: i64, flen: i64,
                                     buf: &mut String,
                                     first: H, rest: T...) {
    let mut i: i64 = fi;
    while i < flen {
        if (fmt[i] as i32) == 123 {
            if i + 1 as i64 < flen {
                if (fmt[i + 1 as i64] as i32) == 125 {
                    first.fmt(buf);
                    fmt_into(fmt, i + 2 as i64, flen, buf, rest...);
                    return;
                }
            }
        }
        buf.push_u8(fmt[i]);
        i = i + 1;
    }
}

// ── Public API ────────────────────────────────────────────────────────────

// format::<T...>(pattern, args...) -> String
// Returns an owned String. Drop frees it automatically.
pub unsafe fn format<T...: Display>(pattern: str, args: T...) -> String {
    let flen: i64 = pattern.len();
    let mut buf: String = String::new();
    fmt_into(pattern, 0 as i64, flen, &mut buf, args...);
    return buf;
}
