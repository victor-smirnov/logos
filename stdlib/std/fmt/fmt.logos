// Logos standard library — std.fmt
//
// format() — build a String from a pattern with {} placeholders.
// Uses the Display trait from std.string for type-to-string conversion.
//
// Usage:
//   use std.fmt;
//   let s: String = format::<i32, bool>("n={}, ok={}", 42, true);
//   println(s);
//   // s freed automatically by Drop

package std.fmt;

use std.lang.text;
use std.lang.panic;
use std.compiler.metaprog;
use std.collections.vec;
use std.io;

// ── Debug trait ───────────────────────────────────────────────────────────
//
// `Debug` mirrors `Display` (same `fn fmt(self, &mut String)` shape) but
// is a separate trait so that derive-Debug-style metaprograms can target
// it without colliding with user-written Display impls. Method renamed
// to `dbg` to avoid two-trait `x.fmt(buf)` ambiguity.

trait Debug {
    fn dbg(self: Self, buf: &mut String);
}

impl Debug for i32 { fn dbg(self: i32, buf: &mut String) { self.fmt(buf); } }
impl Debug for i64 { fn dbg(self: i64, buf: &mut String) { self.fmt(buf); } }
impl Debug for u64 { fn dbg(self: u64, buf: &mut String) { self.fmt(buf); } }
impl Debug for u32 { fn dbg(self: u32, buf: &mut String) { self.fmt(buf); } }
impl Debug for u16 { fn dbg(self: u16, buf: &mut String) { self.fmt(buf); } }
impl Debug for u8 { fn dbg(self: u8, buf: &mut String) { self.fmt(buf); } }
impl Debug for i16 { fn dbg(self: i16, buf: &mut String) { self.fmt(buf); } }
impl Debug for i8 { fn dbg(self: i8, buf: &mut String) { self.fmt(buf); } }
impl Debug for usize { fn dbg(self: usize, buf: &mut String) { self.fmt(buf); } }
impl Debug for isize { fn dbg(self: isize, buf: &mut String) { self.fmt(buf); } }
impl Debug for bool { fn dbg(self: bool, buf: &mut String) { self.fmt(buf); } }

// Float Debug — full-precision round-trippable text via libc snprintf
// "%.17g" (f64) / "%.9g" (f32). Differs from Display ("%g") which
// drops trailing precision for compactness.
extern fn logos_fmt_f64_dbg(buf: *mut u8, cap: i32, x: f64) -> i32;
extern fn logos_fmt_f32_dbg(buf: *mut u8, cap: i32, x: f32) -> i32;

impl Debug for f64 {
    fn dbg(self: f64, buf: &mut String) {
        let cap: i32 = 32i32;
        let ptr: *mut u8 = buf.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_dbg(ptr, cap, self) };
        buf.advance_len(n as i64);
    }
}

impl Debug for f32 {
    fn dbg(self: f32, buf: &mut String) {
        let cap: i32 = 32i32;
        let ptr: *mut u8 = buf.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_dbg(ptr, cap, self) };
        buf.advance_len(n as i64);
    }
}

// Debug for str wraps the content in double quotes (Rust-style). Direct
// dot-call `"x".dbg(buf)` still trips sema_expr.cpp's slice/str method
// short-circuit — but trait-bound dispatch from a generic context (the
// `T...: Debug` bound on `format_args_str`) goes through trait_bound_resolution
// and works.
impl Debug for str {
    fn dbg(self: str, buf: &mut String) {
        buf.push_u8(34u8);     // "
        buf.push_str(self);
        buf.push_u8(34u8);     // "
    }
}

// ── Format engine (variadic) ──────────────────────────────────────────────

// Base case: no more args — copy remaining format string into buf.
unsafe fn fmt_into(fmt: str, fi: i64, flen: i64, buf: &mut String) {
    let mut i: i64 = fi;
    while i < flen {
        buf.push_u8(fmt[i]);
        i = i + 1;
    }
}

// Recursive case: find next `{}` or `{:?}`, format one arg via
// Display or Debug accordingly, recurse on rest. `{{` and `}}`
// escape one literal brace each.
unsafe fn fmt_into<H: Display + Debug, T...>(fmt: str, fi: i64, flen: i64,
                                              buf: &mut String,
                                              first: H, rest: T...) {
    let mut i: i64 = fi;
    while i < flen {
        let c: i32 = fmt[i] as i32;
        // Escaped `{{` / `}}` — emit one literal brace and skip ahead.
        if c == 123 && i + 1 < flen && (fmt[i + 1] as i32) == 123 {
            buf.push_u8(fmt[i]);
            i = i + 2;
            continue;
        }
        if c == 125 && i + 1 < flen && (fmt[i + 1] as i32) == 125 {
            buf.push_u8(fmt[i]);
            i = i + 2;
            continue;
        }
        if c == 123 && i + 1 < flen {
            // `{}` — Display.
            if (fmt[i + 1] as i32) == 125 {
                first.fmt(buf);
                fmt_into(fmt, i + 2, flen, buf, rest...);
                return;
            }
            // `{:?}` — Debug.
            if i + 3 < flen
                && (fmt[i + 1] as i32) == 58       // ':'
                && (fmt[i + 2] as i32) == 63       // '?'
                && (fmt[i + 3] as i32) == 125 {    // '}'
                first.dbg(buf);
                fmt_into(fmt, i + 4, flen, buf, rest...);
                return;
            }
        }
        buf.push_u8(fmt[i]);
        i = i + 1;
    }
}

// ── Public API ────────────────────────────────────────────────────────────

// format_args_str::<T...>(pattern, args...) -> String
// Runtime fn that the `format!()` macro lowers to. Returns an owned
// String. Drop frees it automatically. Variadic type-arg inference
// means callers usually write `format_args_str("n={}", n)` without
// turbofish; the macro shell takes care of any remaining ergonomics.
pub fn format_args_str<T...: Display + Debug>(pattern: str, args: T...) -> String {
    let flen: i64 = pattern.len();
    let mut buf: String = String::new();
    unsafe { fmt_into(pattern, 0 as i64, flen, &mut buf, args...); }
    return buf;
}

// Back-compat alias: existing callers wrote `format::<T...>("...", args)`
// before the `format!` macro shell landed. Keep the bare name working
// so we don't churn unrelated tests on this slice.
pub fn format<T...: Display + Debug>(pattern: str, args: T...) -> String {
    return format_args_str(pattern, args...);
}

// ── Numeric format traits (slice 4.4c) ───────────────────────────────────
//
// LowerHex / UpperHex / Octal / Binary — Rust-shaped traits, one method
// each. Per-type impl funnels through one of the four `write_*` helpers
// below. Signed types cast to their unsigned bit-width counterpart
// first so the rendered width matches Rust's behaviour
// (`format!("{:x}", -1i32)` → "ffffffff", not "ffffffffffffffff").

trait LowerHex { fn fmt_lower_hex(self: Self, buf: &mut String); }
trait UpperHex { fn fmt_upper_hex(self: Self, buf: &mut String); }
trait Octal    { fn fmt_octal(self: Self, buf: &mut String); }
trait Binary   { fn fmt_binary(self: Self, buf: &mut String); }

fn write_radix_u64(buf: &mut String, n: u64, radix: u64, upper: bool) {
    if n == 0u64 { buf.push_u8(48u8); return; }
    let mut tmp: [u8; 64] = [0u8; 64];
    let mut pos: i64 = 0i64;
    let mut m: u64 = n;
    while m > 0u64 {
        let d: u64 = m % radix;
        let c: u8 =
            if d < 10u64 {
                (d as u8) + 48u8
            } else if upper {
                (d as u8) - 10u8 + 65u8
            } else {
                (d as u8) - 10u8 + 97u8
            };
        tmp[pos] = c;
        pos = pos + 1i64;
        m = m / radix;
    }
    let mut i: i64 = pos - 1i64;
    while i >= 0i64 {
        buf.push_u8(tmp[i]);
        i = i - 1i64;
    }
}

impl LowerHex for u64   { fn fmt_lower_hex(self: u64,   buf: &mut String) { write_radix_u64(buf, self, 16u64, false); } }
impl LowerHex for u32   { fn fmt_lower_hex(self: u32,   buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, false); } }
impl LowerHex for i64   { fn fmt_lower_hex(self: i64,   buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, false); } }
impl LowerHex for i32   { fn fmt_lower_hex(self: i32,   buf: &mut String) { write_radix_u64(buf, self as u32 as u64, 16u64, false); } }
impl LowerHex for usize { fn fmt_lower_hex(self: usize, buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, false); } }
impl LowerHex for isize { fn fmt_lower_hex(self: isize, buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, false); } }
impl LowerHex for u16   { fn fmt_lower_hex(self: u16,   buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, false); } }
impl LowerHex for u8    { fn fmt_lower_hex(self: u8,    buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, false); } }
impl LowerHex for i16   { fn fmt_lower_hex(self: i16,   buf: &mut String) { write_radix_u64(buf, self as u16 as u64, 16u64, false); } }
impl LowerHex for i8    { fn fmt_lower_hex(self: i8,    buf: &mut String) { write_radix_u64(buf, self as u8 as u64, 16u64, false); } }

impl UpperHex for u64   { fn fmt_upper_hex(self: u64,   buf: &mut String) { write_radix_u64(buf, self, 16u64, true); } }
impl UpperHex for u32   { fn fmt_upper_hex(self: u32,   buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, true); } }
impl UpperHex for i64   { fn fmt_upper_hex(self: i64,   buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, true); } }
impl UpperHex for i32   { fn fmt_upper_hex(self: i32,   buf: &mut String) { write_radix_u64(buf, self as u32 as u64, 16u64, true); } }
impl UpperHex for usize { fn fmt_upper_hex(self: usize, buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, true); } }
impl UpperHex for isize { fn fmt_upper_hex(self: isize, buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, true); } }
impl UpperHex for u16   { fn fmt_upper_hex(self: u16,   buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, true); } }
impl UpperHex for u8    { fn fmt_upper_hex(self: u8,    buf: &mut String) { write_radix_u64(buf, self as u64, 16u64, true); } }
impl UpperHex for i16   { fn fmt_upper_hex(self: i16,   buf: &mut String) { write_radix_u64(buf, self as u16 as u64, 16u64, true); } }
impl UpperHex for i8    { fn fmt_upper_hex(self: i8,    buf: &mut String) { write_radix_u64(buf, self as u8 as u64, 16u64, true); } }

impl Octal for u64   { fn fmt_octal(self: u64,   buf: &mut String) { write_radix_u64(buf, self, 8u64, false); } }
impl Octal for u32   { fn fmt_octal(self: u32,   buf: &mut String) { write_radix_u64(buf, self as u64, 8u64, false); } }
impl Octal for i64   { fn fmt_octal(self: i64,   buf: &mut String) { write_radix_u64(buf, self as u64, 8u64, false); } }
impl Octal for i32   { fn fmt_octal(self: i32,   buf: &mut String) { write_radix_u64(buf, self as u32 as u64, 8u64, false); } }
impl Octal for usize { fn fmt_octal(self: usize, buf: &mut String) { write_radix_u64(buf, self as u64, 8u64, false); } }
impl Octal for isize { fn fmt_octal(self: isize, buf: &mut String) { write_radix_u64(buf, self as u64, 8u64, false); } }
impl Octal for u16   { fn fmt_octal(self: u16,   buf: &mut String) { write_radix_u64(buf, self as u64, 8u64, false); } }
impl Octal for u8    { fn fmt_octal(self: u8,    buf: &mut String) { write_radix_u64(buf, self as u64, 8u64, false); } }
impl Octal for i16   { fn fmt_octal(self: i16,   buf: &mut String) { write_radix_u64(buf, self as u16 as u64, 8u64, false); } }
impl Octal for i8    { fn fmt_octal(self: i8,    buf: &mut String) { write_radix_u64(buf, self as u8 as u64, 8u64, false); } }

impl Binary for u64   { fn fmt_binary(self: u64,   buf: &mut String) { write_radix_u64(buf, self, 2u64, false); } }
impl Binary for u32   { fn fmt_binary(self: u32,   buf: &mut String) { write_radix_u64(buf, self as u64, 2u64, false); } }
impl Binary for i64   { fn fmt_binary(self: i64,   buf: &mut String) { write_radix_u64(buf, self as u64, 2u64, false); } }
impl Binary for i32   { fn fmt_binary(self: i32,   buf: &mut String) { write_radix_u64(buf, self as u32 as u64, 2u64, false); } }
impl Binary for usize { fn fmt_binary(self: usize, buf: &mut String) { write_radix_u64(buf, self as u64, 2u64, false); } }
impl Binary for isize { fn fmt_binary(self: isize, buf: &mut String) { write_radix_u64(buf, self as u64, 2u64, false); } }
impl Binary for u16   { fn fmt_binary(self: u16,   buf: &mut String) { write_radix_u64(buf, self as u64, 2u64, false); } }
impl Binary for u8    { fn fmt_binary(self: u8,    buf: &mut String) { write_radix_u64(buf, self as u64, 2u64, false); } }
impl Binary for i16   { fn fmt_binary(self: i16,   buf: &mut String) { write_radix_u64(buf, self as u16 as u64, 2u64, false); } }
impl Binary for i8    { fn fmt_binary(self: i8,    buf: &mut String) { write_radix_u64(buf, self as u8 as u64, 2u64, false); } }

// LowerExp / UpperExp — scientific notation (`{:e}` / `{:E}`). Floats
// only; libc snprintf "%e" / "%E" do the conversion.
trait LowerExp { fn fmt_lower_exp(self: Self, buf: &mut String); }
trait UpperExp { fn fmt_upper_exp(self: Self, buf: &mut String); }

extern fn logos_fmt_f64_e(buf: *mut u8, cap: i32, x: f64) -> i32;
extern fn logos_fmt_f64_E(buf: *mut u8, cap: i32, x: f64) -> i32;
extern fn logos_fmt_f32_e(buf: *mut u8, cap: i32, x: f32) -> i32;
extern fn logos_fmt_f32_E(buf: *mut u8, cap: i32, x: f32) -> i32;

impl LowerExp for f64 {
    fn fmt_lower_exp(self: f64, buf: &mut String) {
        let cap: i32 = 32i32;
        let ptr: *mut u8 = buf.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_e(ptr, cap, self) };
        buf.advance_len(n as i64);
    }
}
impl LowerExp for f32 {
    fn fmt_lower_exp(self: f32, buf: &mut String) {
        let cap: i32 = 32i32;
        let ptr: *mut u8 = buf.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_e(ptr, cap, self) };
        buf.advance_len(n as i64);
    }
}
impl UpperExp for f64 {
    fn fmt_upper_exp(self: f64, buf: &mut String) {
        let cap: i32 = 32i32;
        let ptr: *mut u8 = buf.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_E(ptr, cap, self) };
        buf.advance_len(n as i64);
    }
}
impl UpperExp for f32 {
    fn fmt_upper_exp(self: f32, buf: &mut String) {
        let cap: i32 = 32i32;
        let ptr: *mut u8 = buf.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_E(ptr, cap, self) };
        buf.advance_len(n as i64);
    }
}

// ── Per-trait dispatch helpers (slice 4.4b) ──────────────────────────────
//
// Sema's lower_method_call short-circuits dot-method dispatch on slice
// and str receivers (returns "slice has no method '<name>'"). Generic-
// context dispatch through trait bounds still works, so format-family
// lowering routes every placeholder through one of these thin generic
// wrappers instead of emitting `(arg).fmt(&mut __buf)` directly.
//
// Each helper is by-value in the arg (matching the underlying trait's
// `self: Self` signature). For slice/str this is free (fat-ptr copy);
// for owned types it consumes — same semantics the variadic
// `format_args_str` already had.
pub fn fmt_display<T: Display>(arg: T, buf: &mut String)     { arg.fmt(buf); }
pub fn fmt_debug<T: Debug>(arg: T, buf: &mut String)         { arg.dbg(buf); }
pub fn fmt_lower_hex<T: LowerHex>(arg: T, buf: &mut String)  { arg.fmt_lower_hex(buf); }
pub fn fmt_upper_hex<T: UpperHex>(arg: T, buf: &mut String)  { arg.fmt_upper_hex(buf); }
pub fn fmt_octal<T: Octal>(arg: T, buf: &mut String)         { arg.fmt_octal(buf); }
pub fn fmt_binary<T: Binary>(arg: T, buf: &mut String)       { arg.fmt_binary(buf); }
pub fn fmt_lower_exp<T: LowerExp>(arg: T, buf: &mut String)  { arg.fmt_lower_exp(buf); }
pub fn fmt_upper_exp<T: UpperExp>(arg: T, buf: &mut String)  { arg.fmt_upper_exp(buf); }

// Slice 4.4d / 4.4e — full format-spec post-processor. Macro lowering
// routes every spec'd placeholder through a scratch String, then this
// helper composes prefix + sign + content (precision-truncated) +
// padding according to the spec parameters:
//
//   precision >= 0    — truncate content to N bytes (str-Display) or
//                       N digits (numeric kinds) before any padding.
//   prefix            — alt-form prefix ("0x"/"0o"/"0b") for hex/oct/
//                       bin when `#` is set; empty string otherwise.
//   sign_plus         — prepend '+' on positive content (`{:+}`).
//   width, fill,      — width / fill char / align (0=None→Right,
//   align_code           1=Left, 2=Right, 3=Center). When fill is '0'
//                       and align defaults to Right, the zero digits
//                       appear AFTER the sign and prefix — matching
//                       Rust's `{:05x}` → "000ff" / `{:#05x}` → "0x0ff".
pub fn fmt_pad(out: &mut String, content: str, prefix: str,
               sign_plus: bool, precision: i64,
               width: i64, fill: i32, align_code: i32) {
    let n_full: i64 = content.len();
    let n_eff: i64 =
        if precision >= 0i64 && n_full > precision { precision } else { n_full };

    let mut emit_sign: bool = false;
    if sign_plus && n_eff > 0i64 {
        let c0: u8 = content[0i64];
        if c0 != 45u8 && c0 != 43u8 {  // not '-' or '+'
            emit_sign = true;
        }
    }
    let body: i64 =
        (if emit_sign { 1i64 } else { 0i64 }) + prefix.len() + n_eff;
    let mut left_pad:  i64 = 0i64;
    let mut right_pad: i64 = 0i64;
    if width > body {
        let pad: i64 = width - body;
        if align_code == 1i32 {
            right_pad = pad;
        } else if align_code == 3i32 {
            left_pad  = pad / 2i64;
            right_pad = pad - left_pad;
        } else {
            left_pad = pad;
        }
    }

    // Zero-pad shape: sign / prefix / zero-fill / content. Otherwise:
    // fill-left / sign / prefix / content / fill-right.
    let is_zero_pad: bool = (fill == 48i32) && (align_code != 1i32);
    let mut i: i64 = 0i64;
    if !is_zero_pad {
        while i < left_pad { out.push_u8(fill as u8); i = i + 1i64; }
    }
    if emit_sign { out.push_u8(43u8); }
    out.push_str(prefix);
    if is_zero_pad {
        i = 0i64;
        while i < left_pad { out.push_u8(48u8); i = i + 1i64; }
    }
    // Truncated content.
    i = 0i64;
    while i < n_eff { out.push_u8(content[i]); i = i + 1i64; }
    if !is_zero_pad {
        i = 0i64;
        while i < right_pad { out.push_u8(fill as u8); i = i + 1i64; }
    } else {
        // Left-aligned zero-pad is rare/weird — push right pad with
        // fill (`0`) to keep numeric semantics consistent.
        i = 0i64;
        while i < right_pad { out.push_u8(48u8); i = i + 1i64; }
    }
}

// Back-compat shim for slice 4.4d call sites. Drops to fmt_pad with
// no prefix / no sign / no precision. Sema-resident lowering has
// already migrated to fmt_pad directly; kept here only to avoid
// churning external callers (none in tree).
pub fn pad_into(out: &mut String, content: str, width: i64,
                fill: i32, align_code: i32) {
    fmt_pad(out, content, "", false, -1i64, width, fill, align_code);
}

// ── Macro shells (slice 4.1 of fn-macros) ─────────────────────────────────
//
// `format!("pat", args...)` — Rust-style shorthand around `format_args_str`.
// The macro callee receives every `(args)` element as an `ExprBlob` and
// splices them back into a single call. Element type and arity of the
// underlying `format_args_str` are inferred from the spliced AST at the
// expansion site — same path that lets `format_args_str("...", a, b)`
// already work without turbofish.

#[fn_macro]
pub fn format(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! { format_args_str(#(#args),*) };
}

// Thin re-exports of std.io print/println so the macro splices resolve
// at the user's call-site without forcing a separate `use std.io;`.
// Marked pub so the spliced expression sees them. Inline-trivial — the
// optimizer collapses the wrapper.
pub fn __fmt_print(s: str)    { print(s); }
pub fn __fmt_println(s: str)  { println(s); }
pub fn __fmt_eprint(s: str)   { eprint(s); }
pub fn __fmt_eprintln(s: str) { eprintln(s); }

#[fn_macro]
pub fn print(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_print(__s.as_str()); }
    };
}

#[fn_macro]
pub fn println(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_println(__s.as_str()); }
    };
}

#[fn_macro]
pub fn eprint(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_eprint(__s.as_str()); }
    };
}

#[fn_macro]
pub fn eprintln(args: Vec<ExprBlob>) -> ExprBlob {
    return quote_expr! {
        { let __s: String = format_args_str(#(#args),*); __fmt_eprintln(__s.as_str()); }
    };
}

// ── Assertion macros (Rust-compatible surface) ───────────────────────────
//
// `assert!(cond)` / `assert!(cond, fmt, args...)` and
// `assert_eq!(a, b)` panic on assertion failure with a Debug-rendered
// message. Both go through `__fmt_panic` so the splice site only needs
// `use std.fmt;` — std.lang.panic doesn't have to be in the caller's
// scope.

pub fn __fmt_panic(msg: str) { panic(msg); }

// All three assertion macros lower to a unit-typed if-expression with
// non-empty `()`-tailed branches: Logos rejects empty branches in
// block-as-expression position and the macro emits its block as the
// invocation's value. `panic` aborts, so the `()` tail in the panic
// branch is unreachable — type-checker only sees that both branches
// produce ().

#[fn_macro]
pub fn assert(args: Vec<ExprBlob>) -> ExprBlob {
    let n: i64 = args.length();
    if n == 1i64 {
        let cond: ExprBlob = args.get(0i64);
        return quote_expr! {
            if !(#cond) { __fmt_panic("assertion failed"); () } else { () }
        };
    }
    let cond: ExprBlob = args.get(0i64);
    let mut tail: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut i: i64 = 1i64;
    while i < n {
        tail.push(args.get(i));
        i = i + 1i64;
    }
    return quote_expr! {
        if !(#cond) {
            let __m: String = format_args_str(#(#tail),*);
            __fmt_panic(__m.as_str());
            ()
        } else { () }
    };
}

#[fn_macro]
pub fn assert_eq(args: Vec<ExprBlob>) -> ExprBlob {
    let a: ExprBlob = args.get(0i64);
    let b: ExprBlob = args.get(1i64);
    return quote_expr! {
        {
            let __a = #a;
            let __b = #b;
            if __a != __b {
                let __m: String = format_args_str(
                    "assertion failed: {:?} != {:?}", __a, __b);
                __fmt_panic(__m.as_str());
                ()
            } else { () }
        }
    };
}

#[fn_macro]
pub fn assert_ne(args: Vec<ExprBlob>) -> ExprBlob {
    let a: ExprBlob = args.get(0i64);
    let b: ExprBlob = args.get(1i64);
    return quote_expr! {
        {
            let __a = #a;
            let __b = #b;
            if __a == __b {
                let __m: String = format_args_str(
                    "assertion failed: {:?} == {:?}", __a, __b);
                __fmt_panic(__m.as_str());
                ()
            } else { () }
        }
    };
}
