// Logos standard library -- std.process
//
// Process spawning: fork + execvp + waitpid.
// Pipe-based stdin/stdout/stderr redirect via std.pipe.

package logos.std.process;

use logos.std.io.pipe;
use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.iter;
use logos.lang.ops;

extern fn fork() -> i32;
extern fn execvp(file: *const u8, argv: *const *const u8) -> i32;
extern fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
extern fn _exit(code: i32);
extern fn dup2(oldfd: i32, newfd: i32) -> i32;
extern fn close(fd: i32) -> i32;
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;
extern fn read(fd: i32, buf: *mut u8, n: i64) -> i64;

// ---- ExitStatus -------------------------------------------------------------

/// Exit status of a terminated child process, wrapping the raw `waitpid` status word.
pub struct ExitStatus {
    raw: i32,  // raw waitpid status word
}

impl ExitStatus {
    /// Returns `true` if the process exited normally with exit code 0.
    pub fn success(self: &ExitStatus) -> bool {
        // WIFEXITED: (status & 0x7f) == 0
        return (self.raw & 127) == 0 && self.code() == 0;
    }

    /// Returns `true` if the process exited normally (was not killed by a signal).
    pub fn exited(self: &ExitStatus) -> bool {
        return (self.raw & 127) == 0;
    }

    /// Returns the exit code when `exited()` is true; 0 otherwise.
    pub fn code(self: &ExitStatus) -> i32 {
        // WEXITSTATUS: (status >> 8) & 0xff
        return (self.raw >> 8) & 255;
    }

    /// Returns the terminating signal number if killed by a signal; 0 otherwise.
    pub fn signal(self: &ExitStatus) -> i32 {
        // WTERMSIG: status & 0x7f
        return self.raw & 127;
    }
}

// ---- Child ------------------------------------------------------------------

/// Handle to a spawned child process; owns the parent-side pipe fds.
pub struct Child {
    pid:    i32,
    stdin:  i32,  // write end of stdin pipe (-1 if not piped)
    stdout: i32,  // read end of stdout pipe (-1 if not piped)
    stderr: i32,  // read end of stderr pipe (-1 if not piped)
}

impl Child {
    /// Returns the child's OS process id (-1 if `spawn` failed to fork).
    pub fn pid(self: &Child) -> i32 { return self.pid; }

    /// Writes up to `len` bytes from `buf` to the child's stdin pipe.
    /// Returns bytes written, or -1 if stdin was not piped at spawn time.
    pub fn write_stdin(self: &Child, buf: *const u8, len: i64) -> i64 {
        unsafe {
            if self.stdin < 0 { return 0 - 1 as i64; }
            return write(self.stdin, buf, len);
        }
    }

    /// Reads up to `len` bytes from the child's stdout pipe into `buf`.
    /// Returns bytes read (0 at EOF), or -1 if stdout was not piped at spawn time.
    pub fn read_stdout(self: &Child, buf: *mut u8, len: i64) -> i64 {
        unsafe {
            if self.stdout < 0 { return 0 - 1 as i64; }
            return read(self.stdout, buf, len);
        }
    }

    /// Closes the child's stdin pipe, signaling EOF to the child. No-op if already closed.
    pub fn close_stdin(self: &mut Child) {
        unsafe {
            if self.stdin >= 0 { close(self.stdin); self.stdin = 0 - 1; }
        }
    }

    /// Closes the child's stdout pipe. No-op if already closed.
    pub fn close_stdout(self: &mut Child) {
        unsafe {
            if self.stdout >= 0 { close(self.stdout); self.stdout = 0 - 1; }
        }
    }

    /// Closes the child's stderr pipe. No-op if already closed.
    pub fn close_stderr(self: &mut Child) {
        unsafe {
            if self.stderr >= 0 { close(self.stderr); self.stderr = 0 - 1; }
        }
    }

    /// Blocks until the child exits and returns its `ExitStatus`.
    /// Closes any still-open stdin/stdout/stderr pipes before returning.
    pub fn wait(self: &mut Child) -> ExitStatus {
        unsafe {
            let mut status: i32 = 0;
            waitpid(self.pid, &mut status, 0);
            self.close_stdin();
            self.close_stdout();
            self.close_stderr();
            return ExitStatus { raw: status };
        }
    }
}

// ---- spawn ------------------------------------------------------------------

/// Spawns a child process via `fork` + `execvp`.
/// `argv` must be a null-terminated array of NUL-terminated C strings; `argv[0]` is the program.
/// Each `pipe_*` flag redirects that child fd through a pipe held open on the returned `Child`.
/// On fork failure returns a `Child` with pid -1; if exec fails the child exits with code 127.
pub fn spawn(argv: *const *const u8,
             pipe_stdin: bool, pipe_stdout: bool, pipe_stderr: bool) -> Child {
    unsafe {
        // Create pipes as needed before fork.
        let mut in_pipe:  Pipe = if pipe_stdin  { pipe_new() } else { Pipe { read_fd: 0 - 1, write_fd: 0 - 1 } };
        let mut out_pipe: Pipe = if pipe_stdout { pipe_new() } else { Pipe { read_fd: 0 - 1, write_fd: 0 - 1 } };
        let mut err_pipe: Pipe = if pipe_stderr { pipe_new() } else { Pipe { read_fd: 0 - 1, write_fd: 0 - 1 } };

        let pid: i32 = fork();

        if pid < 0 {
            // fork failed
            in_pipe.close();
            out_pipe.close();
            err_pipe.close();
            return Child { pid: 0 - 1, stdin: 0 - 1, stdout: 0 - 1, stderr: 0 - 1 };
        }

        if pid == 0 {
            // Child process
            if pipe_stdin {
                close(in_pipe.write_fd);
                dup2(in_pipe.read_fd, 0);
                close(in_pipe.read_fd);
            }
            if pipe_stdout {
                close(out_pipe.read_fd);
                dup2(out_pipe.write_fd, 1);
                close(out_pipe.write_fd);
            }
            if pipe_stderr {
                close(err_pipe.read_fd);
                dup2(err_pipe.write_fd, 2);
                close(err_pipe.write_fd);
            }
            execvp(argv[0 as i64], argv);
            _exit(127);
            // unreachable
            return Child { pid: 0, stdin: 0, stdout: 0, stderr: 0 };
        }

        // Parent process: close child-side ends.
        if pipe_stdin  { close(in_pipe.read_fd);   in_pipe.read_fd  = 0 - 1; }
        if pipe_stdout { close(out_pipe.write_fd);  out_pipe.write_fd = 0 - 1; }
        if pipe_stderr { close(err_pipe.write_fd);  err_pipe.write_fd = 0 - 1; }

        return Child {
            pid:    pid,
            stdin:  in_pipe.write_fd,
            stdout: out_pipe.read_fd,
            stderr: err_pipe.read_fd,
        };
    }
}

/// Spawns a child with no pipes; the child inherits the parent's stdio fds.
pub fn spawn_simple(argv: *const *const u8) -> Child {
    return spawn(argv, false, false, false);
}

// ---- Line streaming ---------------------------------------------------------
//
// LineReader buffers raw bytes from a pipe fd and yields one line at a time
// (newline-terminated, terminator stripped). Trailing partial line at EOF is
// also yielded.
//
// Currently uses blocking read(). This is fine for batch-mode build orchestration
// where the parent doesn't need to multitask while a single child runs. When
// reactor pipe-poll integration lands, this will be upgraded to register the
// fd with io_uring and yield the fiber on empty buffer (instead of blocking).
// API shape stays the same.

/// Buffered line iterator over a pipe fd, yielding lines with the `\n` terminator stripped.
/// A trailing partial line at EOF is also yielded. Reads block (no reactor integration yet).
pub struct LineReader {
    fd:        i32,
    buf:       *mut u8,
    cap:       i64,    // allocation size
    head:      i64,    // start of unread bytes
    tail:      i64,    // end of unread bytes
    eof:       bool,
}

impl Iterator<String> for LineReader {
    fn next(self: &mut LineReader) -> Option<String> {
        unsafe {
            loop {
                // Scan current buffer [head..tail) for '\n'.
                let mut i: i64 = self.head;
                while i < self.tail {
                    if self.buf[i] == 10 as u8 {  // '\n'
                        let line_len: i64 = i - self.head;
                        let mut s: String = String::new();
                        if line_len > 0 as i64 {
                            let p: *const u8 = (self.buf as i64 + self.head) as *const u8;
                            s.push_bytes(p, line_len);
                        }
                        self.head = i + 1 as i64;
                        return Option::Some(s);
                    }
                    i = i + 1 as i64;
                }
                // No newline. If EOF already, drain tail as a final line (if any).
                if self.eof {
                    let rem: i64 = self.tail - self.head;
                    if rem <= 0 as i64 { return Option::None; }
                    let mut s: String = String::new();
                    let p: *const u8 = (self.buf as i64 + self.head) as *const u8;
                    s.push_bytes(p, rem);
                    self.head = self.tail;
                    return Option::Some(s);
                }
                // Compact unread bytes to start of buf, then read more.
                let rem: i64 = self.tail - self.head;
                if self.head > 0 as i64 {
                    let mut k: i64 = 0 as i64;
                    while k < rem {
                        self.buf[k] = self.buf[self.head + k];
                        k = k + 1 as i64;
                    }
                    self.head = 0 as i64;
                    self.tail = rem;
                }
                // Grow if buffer is full (long line, no newline yet).
                if self.tail >= self.cap {
                    let new_cap: i64 = self.cap * 2 as i64;
                    let new_buf: *mut u8 = realloc_buf(self.buf, new_cap);
                    if new_buf == 0 as *mut u8 {
                        // Allocation failed: treat as EOF, surface what we have.
                        self.eof = true;
                        continue;
                    }
                    self.buf = new_buf;
                    self.cap = new_cap;
                }
                let space: i64 = self.cap - self.tail;
                let dst: *mut u8 = (self.buf as i64 + self.tail) as *mut u8;
                let n: i64 = read(self.fd, dst, space);
                if n <= 0 as i64 {
                    // 0 = EOF, <0 = error (treat as EOF).
                    self.eof = true;
                } else {
                    self.tail = self.tail + n;
                }
            }
        }
        return Option::None;
    }
}

impl Drop for LineReader {
    fn drop(self: LineReader) {
        if self.buf != 0 as *mut u8 {
            unsafe { dealloc(self.buf); }
        }
    }
}

fn line_reader_new(fd: i32) -> LineReader {
    let cap: i64 = 4096 as i64;
    let buf: *mut u8 = unsafe { alloc(cap) };
    return LineReader { fd: fd, buf: buf, cap: cap, head: 0 as i64, tail: 0 as i64, eof: false };
}

impl Child {
    /// Returns a `LineReader` iterating lines from the child's stdout.
    /// Requires stdout to have been piped at spawn time (`pipe_stdout = true`).
    pub fn stdout_lines(self: &mut Child) -> LineReader {
        return line_reader_new(self.stdout);
    }

    /// Returns a `LineReader` over the child's stderr lines; same semantics as `stdout_lines`.
    pub fn stderr_lines(self: &mut Child) -> LineReader {
        return line_reader_new(self.stderr);
    }
}
