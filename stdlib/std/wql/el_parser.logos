const ElNULLP: *const u8 = 0i64 as *const u8;
// Intern a str into the arena; return the raw WString pointer (0 never).
fn wstr_p(doc: &Writ, s: str) -> *const u8 {
    let ws: &WString = doc.wstring(s);
    return ws as *const WString as *const u8;
}
// Schema-view handle currency: node.as_ref() word ↔ *const u8 / WAny.
fn hand_any(w: *const u8) -> WAny { return WAny::ref_to(w); }
// A captured WString ptr (from wstr_p) → &str for a schema `str` field write.
fn wstr_as_str<'a>(p: *const u8) -> &'a str {
    if (p as i64) == 0i64 { return ""; }
    let ws: &WString = unsafe { &*(p as *const WString) };
    return ws.as_str();
}
// Decode a captured INTEGER token (a WString ptr from wstr_p over the
// matched digits) into its i64 VALUE — the token->i64 hook the schema
// action uses to fill a numeric literal field (mirrors el.logos parse_int).
fn wstr_decode_i64(p: *const u8) -> i64 {
    let s: &str = wstr_as_str(p);
    let n: i64 = s.len();
    let mut v: i64 = 0i64;
    let mut i: i64 = 0i64;
    let mut ovf: bool = false;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        if c < 48u8 || c > 57u8 { break; }
        // Error-returning integer-literal policy: a literal exceeding
        // i64::MAX is a COMPILE error downstream — not a clamp, not a
        // trap. Manual guard (no checked_*/Option imports here):
        // i64::MAX/10 = 922337203685477580 rem 7. On overflow return
        // the POISON sentinel i64::MIN (== el_lit_poison(), spelled as
        // a literal so non-wql grammars need no ir import); a
        // non-negative decimal token can never produce it legitimately.
        let d: i64 = (c as i64) - 48i64;
        if v > 922337203685477580i64 || (v == 922337203685477580i64 && d > 7i64) {
            ovf = true;
            break;
        }
        v = v * 10i64 + d;
        i = i + 1i64;
    }
    if ovf { return (-9223372036854775807i64) - 1i64; }
    return v;
}
// Decode a captured FLOAT token (digits '.' digits) into its f64 VALUE —
// the token->f64 hook for float literal fields. Parses the mantissa as an
// integer and divides by 10^k (k = fraction digits): exact powers of ten
// give the correctly-rounded double for short decimal literals.
fn wstr_decode_f64(p: *const u8) -> f64 {
    let s: &str = wstr_as_str(p);
    let n: i64 = s.len();
    let mut mant: i64 = 0i64;
    let mut frac: i64 = 0i64;
    let mut in_frac: bool = false;
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        if c == 46u8 && !in_frac { in_frac = true; i = i + 1i64; continue; }
        if c < 48u8 || c > 57u8 { break; }
        if mant < 922337203685477580i64 {
            mant = mant * 10i64 + ((c as i64) - 48i64);
            if in_frac { frac = frac + 1i64; }
