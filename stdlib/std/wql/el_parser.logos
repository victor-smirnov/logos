    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    if lex.peek().kind != ElTK_IDENT { lex.reset(sp, sln); return ElNULLP; }
    let tk1: Token = lex.next();
    let cap1: *const u8 = wstr_p(doc, tk1.text(lex.src));
    let node: RScan = doc.make::<RScan>();
    node.src_name = wstr_as_str(cap1);
    return node.as_ref().raw() as *const u8;
}

fn rule_comp_source(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_comp_source_0(lex, doc); if r != ElNULLP { return r; } }
    return ElNULLP;
}

// ── Public entry points (one per %export rule) ─────────────────────────────

pub fn parse_expr(src: str, doc: &Writ) -> WAny {
    let mut lex: Lexer = lexer_new(src);
    let root: *const u8 = rule_expr(&mut lex, doc);
    if !lex.at_eof() { return WAny::ref_to(ElNULLP); }
    return WAny::ref_to(root);
}
pub fn parse_expr_far(src: str, doc: &Writ, far_line: &mut i64) -> WAny {
    let mut lex: Lexer = lexer_new(src);
    let root: *const u8 = rule_expr(&mut lex, doc);
    *far_line = lex.far.line;
    if !lex.at_eof() { return WAny::ref_to(ElNULLP); }
    return WAny::ref_to(root);
}

