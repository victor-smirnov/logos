                let gfoldtmp0_2_1_t: Token = lex.next();
                let gfoldtmp0_2_1: *const u8 = wstr_p(doc, gfoldtmp0_2_1_t.text(lex.src));
                let gnode: SField = doc.make::<SField>();
                gnode.base = WRef::<SExpr>::from_any(hand_any(foldacc0));
                gnode.name = wstr_as_str(gfoldtmp0_2_1);
                foldtmp0 = gnode.as_ref().raw() as *const u8;
