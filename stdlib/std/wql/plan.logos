// logos.std.wql.plan — the wql! QUERY PLAN, expressed as Writ schemas (ADR 0012
// §2 relational surface, dogfooding ADR 0011). This is the AST the wql.peg
// grammar BUILDS and the walker-emitter CONSUMES.
//
// The wql! surface has four shapes, modelled here as a `schema enum` family
// `RQuery` with one variant per shape (params come from the `wql!(<params>)`
// paren list — see wql.logos; there is NO `with` clause and NO inline `:[Ty]`
// source typing any more):
//
//   • RQSimple — `from src var [where P] select S [order/limit/…] [: RTy]`
//   • RQJoin   — `… ( [anti] join b y on ON )+ [where P] select S [: RTy]`
//                (N-way chain: base + a fan-out of RQJoinStep nodes)
//   • RQAggr   — `… ( [anti] join … )* [where P] group by K aggregate a=fn(e),…
//                select S [: RTy]` (steps optional — aggregate over a joined stream)
//   • RQFind   — `from src var find P` (single-row borrow — Option<&Ty>)
//
// Every plan node is a first-class Writ schema view (no plain Logos structs/enums
// for plan nodes — SCHEMA MANDATE). The embedded EL clause bodies (where / select
// / on / group-key / aggregate-args) are the SExpr IR (`logos.std.wql.ir`),
// referenced through `WRef<SExpr>` edges — the exact edge primitive ir.logos uses,
// resolved by the walker via `.any().view::<SExpr>()`.
//
// SELF-DESCRIBING (Option B, like ir.logos): source names + the loop var + the
// result type + aggregate column names all live on the node as `str` fields;
// the walker reads them directly (no side tables). Row TYPES (`row_ty` /
// `a_ty` / `b_ty`) are NOT grammar-captured: the HANDLER stamps them after the
// parse from the `wql!(<params>)` slice-param element types (plan_walker::
// walk_query_params). Optionality is tracked with explicit `has_*` bool flags
// rather than sentinel edges — strict + unambiguous.
//
// Category allocation: 0x0012 (the "WQL type descriptors" slot the impl-seam ADR
// dropped — free to reuse for the query-PLAN tier, distinct from SExpr 0x0010 /
// RExpr 0x0011).
package logos.std.wql.plan;

use logos.lang.writ.container;
use logos.lang.writ.allocator;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;
use logos.std.wql.ir;      // SExpr, WRef<S>, the embedded-EL edges

// ── Aggregate column — one `name = fn(arg)` item of a `group by` query ────────
// `fn_name` is the aggregate function NAME (count/sum/min/max/avg — self-describing,
// Option B; the walker maps it to the AGG_* id via `agg_of_name`); `name` is the
// bound column name the projection references; `arg` is the WRef<SExpr> inner
// expression (absent / unused for `count()`, flagged by `has_arg`).
pub schema RQAgg : code(0x0012_0000_0000_0010) {
    name:    str          = 0,
    fn_name: str          = 1,
    arg:     WRef<SExpr>  = 2,
    has_arg: bool         = 3,
}

impl RQAgg {
    // The inner argument expression as an SExpr view (only valid when has_arg).
    pub fn arg_expr(self: &RQAgg) -> SExpr { return self.arg.any().view::<SExpr>(); }
    pub fn as_ref(self: &RQAgg) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// The materialized aggregate-column list — a fan-out of up to `RQAGG_MAX` RQAgg
// edges at fixed slots (the SExprArr pattern from ir.logos). `count` = the arity.
pub schema RQAggArr : code(0x0012_0000_0000_0011) {
    count: i32         = 0,
    c0: WRef<RQAgg> = 1,
    c1: WRef<RQAgg> = 2,
    c2: WRef<RQAgg> = 3,
    c3: WRef<RQAgg> = 4,
    c4: WRef<RQAgg> = 5,
    c5: WRef<RQAgg> = 6,
    c6: WRef<RQAgg> = 7,
    c7: WRef<RQAgg> = 8,
}

pub fn RQAGG_MAX() -> i64 { return 8i64; }

impl RQAggArr {
    pub fn len(self: &RQAggArr) -> i64 { return self.count as i64; }

    pub fn agg_at(self: &RQAggArr, i: i64) -> RQAgg {
        if i == 0i64 { return self.c0.any().view::<RQAgg>(); }
        if i == 1i64 { return self.c1.any().view::<RQAgg>(); }
        if i == 2i64 { return self.c2.any().view::<RQAgg>(); }
        if i == 3i64 { return self.c3.any().view::<RQAgg>(); }
        if i == 4i64 { return self.c4.any().view::<RQAgg>(); }
        if i == 5i64 { return self.c5.any().view::<RQAgg>(); }
        if i == 6i64 { return self.c6.any().view::<RQAgg>(); }
        return self.c7.any().view::<RQAgg>();
    }

    pub fn set_agg(self: &mut RQAggArr, i: i64, h: WAny) {
        let r: WRef<RQAgg> = WRef::<RQAgg>::from_any(h);
        if i == 0i64 { self.c0 = r; return; }
        if i == 1i64 { self.c1 = r; return; }
        if i == 2i64 { self.c2 = r; return; }
        if i == 3i64 { self.c3 = r; return; }
        if i == 4i64 { self.c4 = r; return; }
        if i == 5i64 { self.c5 = r; return; }
        if i == 6i64 { self.c6 = r; return; }
        self.c7 = r;
    }

    pub fn set_len(self: &mut RQAggArr, n: i64) { self.count = n as i32; }
    pub fn as_ref(self: &RQAggArr) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// ── RQSimple — scan / filter / project (the simple query shape) ───────────────
//   from src var [where P] select S [order/limit/…] [: result_ty]
//
// `has_where` / `where` — the optional predicate edge (WRef<SExpr>).
// `select` — the required projection edge.
// `has_result_ty` — false ⇒ INFER the result element type from `select`.
// `row_ty` — the row TYPE name: stamped by the HANDLER from the slice param
// `src_name: &[row_ty]` in the wql!(…) list (not grammar-captured).
// SELECT-TAIL MODIFIERS (simple/join/aggregate shapes): `distinct` dedups the
// projected values; `has_order`/`order_key`/`order_desc` = `order by O [desc]`
// (the key ranges over the row vars for simple/join, over the group key +
// aggregate output names for the aggregate shape); `has_limit` + (`limit_n` XOR
// `limit_is_param`/`limit_param`) = `limit N|p` (p = a scalar param name);
// `sel_first` = `select first S` — SINGLE-ROW mode: the generated fn returns
// Option<ElemTy> (the first projected value, honoring `order by`); excludes
// distinct/limit (walker diagnoses the combination).
pub schema RQSimple : code(0x0012_0000_0000_0000) {
    fn_name:       str            = 0,
    src_name:      str            = 1,
    row_ty:        str            = 2,
    var_name:      str            = 3,
    has_where:     bool           = 4,
    where_pred:         WRef<SExpr>    = 5,
    select:        WRef<SExpr>    = 6,
    has_result_ty: bool           = 7,
    result_ty:     str            = 8,
    distinct:       bool          = 9,
    has_order:      bool          = 10,
    order_key:      WRef<SExpr>   = 11,
    order_desc:     bool          = 12,
    has_limit:      bool          = 13,
    limit_n:        i64           = 14,
    limit_is_param: bool          = 15,
    limit_param:    str           = 16,
    sel_first:      bool          = 17,
}

// ── RQJoinStep — ONE join step of a chain, in TWO forms ───────────────────────
// CLASSIC (`[anti] join <src> <var> on <pred>`, is_edge = false):
//   `src_name`/`var_name` — captured IDENTs (the source names a SLICE param or
//   a rel; the var is the step's row binding). `row_ty` — handler-stamped from
//   the slice param's element type (like RQSimple.row_ty). `on` REQUIRED
//   (has_on always true).
// TRAVERSAL (`[anti] join <base>.<f>[.<g>…] <var> [on P]`, is_edge = true —
// slice D, collection-field join):
//   `base_var` — the already-bound row var the path starts at; `path` — the
//   grammar-captured segment fan-out; `on` OPTIONAL (has_on — containment IS
//   the join; P is a residual filter). The WALKER validates the path against
//   the base var's row type (intermediate segments singular, final segment a
//   collection: Vec<T> / &[T] / [T;N]), then REWRITES `src_name` to the full
//   source EXPRESSION text (`d.emps`) and stamps `row_ty` to the ELEMENT type
//   — so the emitters scan `(src_name)` uniformly for both forms.
// `is_anti` — per-step anti flag (an anti step's var binds ONLY inside its own
// `on`; downstream clauses see only the non-anti vars). A non-anti `on` may
// reference ALL vars bound so far (base + earlier non-anti steps) + scalar
// params.
pub schema RQJoinStep : code(0x0012_0000_0000_0012) {
    src_name: str          = 0,
    var_name: str          = 1,
    row_ty:   str          = 2,
    is_anti:  bool         = 3,
    on:       WRef<SExpr>  = 4,
    is_edge:  bool         = 5,
    has_on:   bool         = 6,
    base_var: str          = 7,
    path:     WRef<RQPathSegArr> = 8,
}

impl RQJoinStep {
    pub fn on_expr(self: &RQJoinStep) -> SExpr { return self.on.any().view::<SExpr>(); }
    pub fn path_arr(self: &RQJoinStep) -> RQPathSegArr { return self.path.any().view::<RQPathSegArr>(); }
    pub fn as_ref(self: &RQJoinStep) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// ── RQPathSeg — one `.field` segment of a traversal step's field path ─────────
pub schema RQPathSeg : code(0x0012_0000_0000_001A) {
    name: str = 0,
}

impl RQPathSeg {
    pub fn as_ref(self: &RQPathSeg) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// The materialized segment list — fan-out of up to RQPSEG_MAX RQPathSeg edges
// (the RQJoinStepArr pattern). `count` = the path depth (≥ 1).
pub schema RQPathSegArr : code(0x0012_0000_0000_001B) {
    count: i32           = 0,
    p0: WRef<RQPathSeg> = 1,
    p1: WRef<RQPathSeg> = 2,
    p2: WRef<RQPathSeg> = 3,
    p3: WRef<RQPathSeg> = 4,
    p4: WRef<RQPathSeg> = 5,
    p5: WRef<RQPathSeg> = 6,
    p6: WRef<RQPathSeg> = 7,
    p7: WRef<RQPathSeg> = 8,
}

pub fn RQPSEG_MAX() -> i64 { return 8i64; }

impl RQPathSegArr {
    pub fn len(self: &RQPathSegArr) -> i64 { return self.count as i64; }

    pub fn seg_at(self: &RQPathSegArr, i: i64) -> RQPathSeg {
        if i == 0i64 { return self.p0.any().view::<RQPathSeg>(); }
        if i == 1i64 { return self.p1.any().view::<RQPathSeg>(); }
        if i == 2i64 { return self.p2.any().view::<RQPathSeg>(); }
        if i == 3i64 { return self.p3.any().view::<RQPathSeg>(); }
        if i == 4i64 { return self.p4.any().view::<RQPathSeg>(); }
        if i == 5i64 { return self.p5.any().view::<RQPathSeg>(); }
        if i == 6i64 { return self.p6.any().view::<RQPathSeg>(); }
        return self.p7.any().view::<RQPathSeg>();
    }

    pub fn set_seg(self: &mut RQPathSegArr, i: i64, h: WAny) {
        let r: WRef<RQPathSeg> = WRef::<RQPathSeg>::from_any(h);
        if i == 0i64 { self.p0 = r; return; }
        if i == 1i64 { self.p1 = r; return; }
        if i == 2i64 { self.p2 = r; return; }
        if i == 3i64 { self.p3 = r; return; }
        if i == 4i64 { self.p4 = r; return; }
        if i == 5i64 { self.p5 = r; return; }
        if i == 6i64 { self.p6 = r; return; }
        self.p7 = r;
    }

    pub fn set_len(self: &mut RQPathSegArr, n: i64) { self.count = n as i32; }
    pub fn as_ref(self: &RQPathSegArr) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// The materialized join-step list — a fan-out of up to `RQJSTEP_MAX` RQJoinStep
// edges at fixed slots (the RQAggArr pattern). `count` = the chain length.
pub schema RQJoinStepArr : code(0x0012_0000_0000_0013) {
    count: i32              = 0,
    s0: WRef<RQJoinStep> = 1,
    s1: WRef<RQJoinStep> = 2,
    s2: WRef<RQJoinStep> = 3,
    s3: WRef<RQJoinStep> = 4,
    s4: WRef<RQJoinStep> = 5,
    s5: WRef<RQJoinStep> = 6,
    s6: WRef<RQJoinStep> = 7,
    s7: WRef<RQJoinStep> = 8,
}

pub fn RQJSTEP_MAX() -> i64 { return 8i64; }

impl RQJoinStepArr {
    pub fn len(self: &RQJoinStepArr) -> i64 { return self.count as i64; }

    // The i-th step's raw edge handle (feeds the walker's allocator-carrying
    // fat-view rewrap for the handler's row_ty stamp). The raw()/ref_to round
    // trip launders the field-temp provenance (the WAny targets the step's TOM
    // in the arena, which outlives the view — the as_ref idiom).
    pub fn step_any(self: &RQJoinStepArr, i: i64) -> WAny {
        if i == 0i64 { return WAny::ref_to(self.s0.any().raw() as *const u8); }
        if i == 1i64 { return WAny::ref_to(self.s1.any().raw() as *const u8); }
        if i == 2i64 { return WAny::ref_to(self.s2.any().raw() as *const u8); }
        if i == 3i64 { return WAny::ref_to(self.s3.any().raw() as *const u8); }
        if i == 4i64 { return WAny::ref_to(self.s4.any().raw() as *const u8); }
        if i == 5i64 { return WAny::ref_to(self.s5.any().raw() as *const u8); }
        if i == 6i64 { return WAny::ref_to(self.s6.any().raw() as *const u8); }
        return WAny::ref_to(self.s7.any().raw() as *const u8);
    }

    pub fn step_at(self: &RQJoinStepArr, i: i64) -> RQJoinStep {
        return self.step_any(i).view::<RQJoinStep>();
    }

    pub fn set_step(self: &mut RQJoinStepArr, i: i64, h: WAny) {
        let r: WRef<RQJoinStep> = WRef::<RQJoinStep>::from_any(h);
        if i == 0i64 { self.s0 = r; return; }
        if i == 1i64 { self.s1 = r; return; }
        if i == 2i64 { self.s2 = r; return; }
        if i == 3i64 { self.s3 = r; return; }
        if i == 4i64 { self.s4 = r; return; }
        if i == 5i64 { self.s5 = r; return; }
        if i == 6i64 { self.s6 = r; return; }
        self.s7 = r;
    }

    pub fn set_len(self: &mut RQJoinStepArr, n: i64) { self.count = n as i32; }
    pub fn as_ref(self: &RQJoinStepArr) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// ── RQJoin — an N-way join CHAIN over a base source ───────────────────────────
//   from a x ( [anti] join b y on ON )+ [where P] select S [: result_ty]
// Base + steps: `a_name`/`a_ty`/`x_var` bind the base scan (a_ty handler-
// stamped); `steps` is the RQJoinStep fan-out (≥ 1, grammar-enforced), each
// step folded LEFT-DEEP onto the base by the lowering. `has_result_ty` — false
// ⇒ INFER the result element type from `select` (every bound source schema is
// reflected, so projections over any row var type).
pub schema RQJoin : code(0x0012_0000_0000_0001) {
    fn_name:    str             = 0,
    a_name:     str             = 1,
    a_ty:       str             = 2,
    x_var:      str             = 3,
    steps:      WRef<RQJoinStepArr> = 4,
    has_where:  bool            = 5,
    where_pred:      WRef<SExpr>     = 6,
    select:     WRef<SExpr>     = 7,
    has_result_ty: bool         = 8,
    result_ty:  str             = 9,
    distinct:       bool        = 10,
    has_order:      bool        = 11,
    order_key:      WRef<SExpr> = 12,
    order_desc:     bool        = 13,
    has_limit:      bool        = 14,
    limit_n:        i64         = 15,
    limit_is_param: bool        = 16,
    limit_param:    str         = 17,
    sel_first:      bool        = 18,
}

// ── RQAggr — group-by + aggregate ─────────────────────────────────────────────
//   from a x [where P] group by key aggregate a=fn(e),… select S [: result_ty]
// `has_result_ty` — false ⇒ INFER from `select` (the group-key + each aggregate
// column are bound as i64 locals, so the projection types over an i64 lattice).
// `has_having`/`having_pred` — the aggregate-only `having H` clause: a filter
// over the group rows (key + aggregate outputs), applied AFTER aggregation and
// BEFORE order/project/distinct/limit. `a_ty` — handler-stamped (see RQSimple).
// `steps` — an OPTIONAL RQJoinStep fan-out (null edge when absent): the
// aggregate then ranges over the JOINED row stream (group key / where /
// aggregate args may reference every bound row var).
pub schema RQAggr : code(0x0012_0000_0000_0002) {
    fn_name:    str             = 0,
    a_name:     str             = 1,
    a_ty:       str             = 2,
    x_var:      str             = 3,
    has_where:  bool            = 4,
    where_pred:      WRef<SExpr>     = 5,
    key:        WRef<SExpr>     = 6,
    aggs:       WRef<RQAggArr>  = 7,
    select:     WRef<SExpr>     = 8,
    has_result_ty: bool         = 9,
    result_ty:  str             = 10,
    distinct:       bool        = 11,
    has_order:      bool        = 12,
    order_key:      WRef<SExpr> = 13,
    order_desc:     bool        = 14,
    has_limit:      bool        = 15,
    limit_n:        i64         = 16,
    limit_is_param: bool        = 17,
    limit_param:    str         = 18,
    has_having:     bool        = 19,
    having_pred:    WRef<SExpr> = 20,
    sel_first:      bool        = 21,
    steps:          WRef<RQJoinStepArr> = 22,
}

// ── RQFind — single-row borrow: `from src var find P` ─────────────────────────
// REPLACES where+select (SIMPLE shape only): the generated fn returns
// Option<&row_ty> — a borrow of the FIRST row matching `pred` (early-exit scan;
// zero-copy, the emit_identity accessor-collapse precedent), None when no row
// matches. NO other clause (select/order/limit/distinct) exists on this
// shape — the grammar admits only the predicate. `row_ty` — handler-stamped.
pub schema RQFind : code(0x0012_0000_0000_0003) {
    fn_name:  str         = 0,
    src_name: str         = 1,
    row_ty:   str         = 2,
    var_name: str         = 3,
    pred:     WRef<SExpr> = 4,
}

// ── The RQuery family — one variant per surface shape ─────────────────────────
// The rel/program tier (RQRel* / RQProgram below) is deliberately NOT part of
// this enum: RQuery stays the four QUERY shapes (rel bodies and the entry are
// RQuery values); the program is the ENVELOPE the parser export returns, bound
// as a plain `RQProgram` view by the walker.
pub schema enum RQuery : category(0x0012_0000_0000_0000) {
    Simple(RQSimple),
    Join(RQJoin),
    Aggr(RQAggr),
    Find(RQFind),
}

// ── REL blocks (slices B/C — named derived relations, recursion supported) ───
// `rel NAME ( col: ty, … ) { body; body; … }` — a named derived relation with
// SET semantics (structural-equality dedup on insert). Columns are restricted
// to i64/str/bool (f64 kills Eq — walker-diagnosed). Bodies are RQuery values
// (Simple/Join only — walker-enforced) and may reference ANY rel (self /
// forward / mutual = recursion, realized by the semi-naïve SCC fixpoint);
// the entry query + other rels scan the materialized relation. The walker
// builds the rel DEPENDENCY EDGE LIST explicitly, condenses it (SCC + topo
// order), and stratifies negation/aggregation over it.

// One declared column: `name: ty`.
pub schema RQRelCol : code(0x0012_0000_0000_0014) {
    name:    str = 0,
    ty_name: str = 1,
}

impl RQRelCol {
    pub fn as_ref(self: &RQRelCol) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// The materialized column list — fan-out of up to RQRELCOL_MAX RQRelCol edges.
pub schema RQRelColArr : code(0x0012_0000_0000_0015) {
    count: i32           = 0,
    c0: WRef<RQRelCol> = 1,
    c1: WRef<RQRelCol> = 2,
    c2: WRef<RQRelCol> = 3,
    c3: WRef<RQRelCol> = 4,
    c4: WRef<RQRelCol> = 5,
    c5: WRef<RQRelCol> = 6,
    c6: WRef<RQRelCol> = 7,
    c7: WRef<RQRelCol> = 8,
}

pub fn RQRELCOL_MAX() -> i64 { return 8i64; }

impl RQRelColArr {
    pub fn len(self: &RQRelColArr) -> i64 { return self.count as i64; }

    pub fn col_at(self: &RQRelColArr, i: i64) -> RQRelCol {
        if i == 0i64 { return self.c0.any().view::<RQRelCol>(); }
        if i == 1i64 { return self.c1.any().view::<RQRelCol>(); }
        if i == 2i64 { return self.c2.any().view::<RQRelCol>(); }
        if i == 3i64 { return self.c3.any().view::<RQRelCol>(); }
        if i == 4i64 { return self.c4.any().view::<RQRelCol>(); }
        if i == 5i64 { return self.c5.any().view::<RQRelCol>(); }
        if i == 6i64 { return self.c6.any().view::<RQRelCol>(); }
        return self.c7.any().view::<RQRelCol>();
    }

    pub fn set_col(self: &mut RQRelColArr, i: i64, h: WAny) {
        let r: WRef<RQRelCol> = WRef::<RQRelCol>::from_any(h);
        if i == 0i64 { self.c0 = r; return; }
        if i == 1i64 { self.c1 = r; return; }
        if i == 2i64 { self.c2 = r; return; }
        if i == 3i64 { self.c3 = r; return; }
        if i == 4i64 { self.c4 = r; return; }
        if i == 5i64 { self.c5 = r; return; }
        if i == 6i64 { self.c6 = r; return; }
        self.c7 = r;
    }

    pub fn set_len(self: &mut RQRelColArr, n: i64) { self.count = n as i32; }
    pub fn as_ref(self: &RQRelColArr) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// The materialized body list — fan-out of up to RQBODY_MAX RQuery edges (each
// body is a full query shape node; the walker matches the variant).
pub schema RQBodyArr : code(0x0012_0000_0000_0018) {
    count: i32        = 0,
    b0: WRef<RQuery> = 1,
    b1: WRef<RQuery> = 2,
    b2: WRef<RQuery> = 3,
    b3: WRef<RQuery> = 4,
    b4: WRef<RQuery> = 5,
    b5: WRef<RQuery> = 6,
    b6: WRef<RQuery> = 7,
    b7: WRef<RQuery> = 8,
}

pub fn RQBODY_MAX() -> i64 { return 8i64; }

impl RQBodyArr {
    pub fn len(self: &RQBodyArr) -> i64 { return self.count as i64; }

    // The i-th body's raw edge handle (raw()/ref_to provenance laundering —
    // the step_any idiom; feeds the walker's fat-view rewrap for stamping).
    pub fn body_any(self: &RQBodyArr, i: i64) -> WAny {
        if i == 0i64 { return WAny::ref_to(self.b0.any().raw() as *const u8); }
        if i == 1i64 { return WAny::ref_to(self.b1.any().raw() as *const u8); }
        if i == 2i64 { return WAny::ref_to(self.b2.any().raw() as *const u8); }
        if i == 3i64 { return WAny::ref_to(self.b3.any().raw() as *const u8); }
        if i == 4i64 { return WAny::ref_to(self.b4.any().raw() as *const u8); }
        if i == 5i64 { return WAny::ref_to(self.b5.any().raw() as *const u8); }
        if i == 6i64 { return WAny::ref_to(self.b6.any().raw() as *const u8); }
        return WAny::ref_to(self.b7.any().raw() as *const u8);
    }

    pub fn set_body(self: &mut RQBodyArr, i: i64, h: WAny) {
        let r: WRef<RQuery> = WRef::<RQuery>::from_any(h);
        if i == 0i64 { self.b0 = r; return; }
        if i == 1i64 { self.b1 = r; return; }
        if i == 2i64 { self.b2 = r; return; }
        if i == 3i64 { self.b3 = r; return; }
        if i == 4i64 { self.b4 = r; return; }
        if i == 5i64 { self.b5 = r; return; }
        if i == 6i64 { self.b6 = r; return; }
        self.b7 = r;
    }

    pub fn set_len(self: &mut RQBodyArr, n: i64) { self.count = n as i32; }
    pub fn as_ref(self: &RQBodyArr) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// One rel block: name + declared columns + producing bodies.
pub schema RQRel : code(0x0012_0000_0000_0016) {
    name:   str                = 0,
    cols:   WRef<RQRelColArr>  = 1,
    bodies: WRef<RQBodyArr>    = 2,
}

impl RQRel {
    pub fn cols_arr(self: &RQRel)   -> RQRelColArr { return self.cols.any().view::<RQRelColArr>(); }
    pub fn bodies_arr(self: &RQRel) -> RQBodyArr   { return self.bodies.any().view::<RQBodyArr>(); }
    pub fn as_ref(self: &RQRel) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// The materialized rel list — fan-out of up to RQREL_MAX RQRel edges,
// DECLARATION ORDER (the scoping + materialization order).
pub schema RQRelArr : code(0x0012_0000_0000_0017) {
    count: i32      = 0,
    r0: WRef<RQRel> = 1,
    r1: WRef<RQRel> = 2,
    r2: WRef<RQRel> = 3,
    r3: WRef<RQRel> = 4,
    r4: WRef<RQRel> = 5,
    r5: WRef<RQRel> = 6,
    r6: WRef<RQRel> = 7,
    r7: WRef<RQRel> = 8,
}

pub fn RQREL_MAX() -> i64 { return 8i64; }

impl RQRelArr {
    pub fn len(self: &RQRelArr) -> i64 { return self.count as i64; }

    pub fn rel_at(self: &RQRelArr, i: i64) -> RQRel {
        if i == 0i64 { return self.r0.any().view::<RQRel>(); }
        if i == 1i64 { return self.r1.any().view::<RQRel>(); }
        if i == 2i64 { return self.r2.any().view::<RQRel>(); }
        if i == 3i64 { return self.r3.any().view::<RQRel>(); }
        if i == 4i64 { return self.r4.any().view::<RQRel>(); }
        if i == 5i64 { return self.r5.any().view::<RQRel>(); }
        if i == 6i64 { return self.r6.any().view::<RQRel>(); }
        return self.r7.any().view::<RQRel>();
    }

    pub fn set_rel(self: &mut RQRelArr, i: i64, h: WAny) {
        let r: WRef<RQRel> = WRef::<RQRel>::from_any(h);
        if i == 0i64 { self.r0 = r; return; }
        if i == 1i64 { self.r1 = r; return; }
        if i == 2i64 { self.r2 = r; return; }
        if i == 3i64 { self.r3 = r; return; }
        if i == 4i64 { self.r4 = r; return; }
        if i == 5i64 { self.r5 = r; return; }
        if i == 6i64 { self.r6 = r; return; }
        self.r7 = r;
    }

    pub fn set_len(self: &mut RQRelArr, n: i64) { self.count = n as i32; }
    pub fn as_ref(self: &RQRelArr) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// ── RQProgram — the program ENVELOPE the parser export returns ────────────────
// {rels[], entry}: the (possibly NULL) rel fan-out + the ONE entry query.
pub schema RQProgram : code(0x0012_0000_0000_0019) {
    rels:  WRef<RQRelArr> = 0,
    entry: WRef<RQuery>   = 1,
}

impl RQProgram {
    // True iff the block declared ≥ 1 rel (the rels edge is non-null).
    pub fn has_rels(self: &RQProgram) -> bool { return !self.rels.any().is_null(); }
    pub fn rels_arr(self: &RQProgram) -> RQRelArr { return self.rels.any().view::<RQRelArr>(); }
    // The entry query's raw edge handle (provenance-laundered — the walker
    // fat-wraps it per shape for the fn_name / row_ty stamps).
    pub fn entry_any(self: &RQProgram) -> WAny { return WAny::ref_to(self.entry.any().raw() as *const u8); }
    pub fn as_ref(self: &RQProgram) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); }
}

// ── Fat (allocator-carrying) view wrappers ────────────────────────────────────
// Writing a `str` schema field BOXES the bytes into the arena, which needs the
// view's z (allocator). A plain `node.view::<T>()` binds a READ-ONLY view
// (z = null) — boxing through it would deref null. These rebuild an ALLOCATOR-
// CARRYING view over the SAME node: `WSchemaH { m: <node ptr>, z: <arena> }` is
// layout-identical to a compiler schema view (ADR 0011 §Increment-6), so the
// transmute to the concrete variant view is sound. Shared by the program
// walker (fn_name / row_ty / src_name stamping) and the semi-naïve emitter
// (per-delta-variant src_name rewrites).
pub fn rq_fat_simple(node: WAny, h: &Writ) -> RQSimple {
    let hh: WSchemaH = WSchemaH { m: node.resolve() as *const WMap<Wu6, WAny>, z: h.allocator.get() as *mut u8 };
    return unsafe { *(&hh as *const WSchemaH as *const RQSimple) };
}
pub fn rq_fat_join(node: WAny, h: &Writ) -> RQJoin {
    let hh: WSchemaH = WSchemaH { m: node.resolve() as *const WMap<Wu6, WAny>, z: h.allocator.get() as *mut u8 };
    return unsafe { *(&hh as *const WSchemaH as *const RQJoin) };
}
pub fn rq_fat_aggr(node: WAny, h: &Writ) -> RQAggr {
    let hh: WSchemaH = WSchemaH { m: node.resolve() as *const WMap<Wu6, WAny>, z: h.allocator.get() as *mut u8 };
    return unsafe { *(&hh as *const WSchemaH as *const RQAggr) };
}
pub fn rq_fat_find(node: WAny, h: &Writ) -> RQFind {
    let hh: WSchemaH = WSchemaH { m: node.resolve() as *const WMap<Wu6, WAny>, z: h.allocator.get() as *mut u8 };
    return unsafe { *(&hh as *const WSchemaH as *const RQFind) };
}
pub fn rq_fat_step(node: WAny, h: &Writ) -> RQJoinStep {
    let hh: WSchemaH = WSchemaH { m: node.resolve() as *const WMap<Wu6, WAny>, z: h.allocator.get() as *mut u8 };
    return unsafe { *(&hh as *const WSchemaH as *const RQJoinStep) };
}

// ── Edge handles (same provenance-laundering rationale as ir.logos) ───────────
impl RQSimple { pub fn as_ref(self: &RQSimple) -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }
impl RQJoin   { pub fn as_ref(self: &RQJoin)   -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }
impl RQAggr   { pub fn as_ref(self: &RQAggr)   -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }
impl RQFind   { pub fn as_ref(self: &RQFind)   -> WAny { return WAny::ref_to((self.m as i64) as *const u8); } }

// ── Typed edge RESOLVERS (the walker's convenience API) ───────────────────────
impl RQSimple {
    pub fn where_expr(self: &RQSimple)  -> SExpr { return self.where_pred.any().view::<SExpr>(); }
    pub fn select_expr(self: &RQSimple) -> SExpr { return self.select.any().view::<SExpr>(); }
    pub fn order_expr(self: &RQSimple)  -> SExpr { return self.order_key.any().view::<SExpr>(); }
}
impl RQJoin {
    pub fn steps_arr(self: &RQJoin)   -> RQJoinStepArr { return self.steps.any().view::<RQJoinStepArr>(); }
    pub fn where_expr(self: &RQJoin)  -> SExpr { return self.where_pred.any().view::<SExpr>(); }
    pub fn select_expr(self: &RQJoin) -> SExpr { return self.select.any().view::<SExpr>(); }
    pub fn order_expr(self: &RQJoin)  -> SExpr { return self.order_key.any().view::<SExpr>(); }
}
impl RQFind {
    pub fn pred_expr(self: &RQFind) -> SExpr { return self.pred.any().view::<SExpr>(); }
}
impl RQAggr {
    pub fn where_expr(self: &RQAggr)  -> SExpr { return self.where_pred.any().view::<SExpr>(); }
    pub fn key_expr(self: &RQAggr)    -> SExpr { return self.key.any().view::<SExpr>(); }
    pub fn aggs_arr(self: &RQAggr)    -> RQAggArr { return self.aggs.any().view::<RQAggArr>(); }
    pub fn select_expr(self: &RQAggr) -> SExpr { return self.select.any().view::<SExpr>(); }
    pub fn order_expr(self: &RQAggr)  -> SExpr { return self.order_key.any().view::<SExpr>(); }
    pub fn having_expr(self: &RQAggr) -> SExpr { return self.having_pred.any().view::<SExpr>(); }
    // True iff the aggregate ranges over a JOINED stream (`steps` edge non-null).
    pub fn has_steps(self: &RQAggr)   -> bool { return !self.steps.any().is_null(); }
    pub fn steps_arr(self: &RQAggr)   -> RQJoinStepArr { return self.steps.any().view::<RQJoinStepArr>(); }
}
