fn alt_agg_list_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    let rcap: &mut WArray<WAny> = doc.array(4i64);
    let cap1: *const u8 = rule_agg_item(lex, doc);
    if cap1 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    rcap.push(WAny::ref_to(cap1));
    let arr0: &mut WArray<WAny> = doc.array(4i64);
    let mut cnt0: i64 = 0i64;
    loop {
        let rsp: i64 = lex.save_pos(); let rsln: i64 = lex.save_line();
        let mut rep0: *const u8 = WqNULLP;
        let mut rep0_ok: bool = false;
        if !rep0_ok {
            let gsp: i64 = lex.save_pos(); let gsln: i64 = lex.save_line();
            loop {
                if lex.peek().kind != WqTK_COMMA { lex.reset(gsp, gsln); break; }
                let grep0_1_1_t: Token = lex.next();
                let grep0_1_1: *const u8 = wstr_p(doc, grep0_1_1_t.text(lex.src));
                let grep0_2_1: *const u8 = rule_agg_item(lex, doc);
                if grep0_2_1 == WqNULLP { lex.reset(gsp, gsln); break; }
                rcap.push(WAny::ref_to(grep0_2_1));
                rep0 = grep0_2_1;
                rep0_ok = true;
                break;
            }
        }
        if !rep0_ok { lex.reset(rsp, rsln); break; }
        if rep0 != WqNULLP { arr0.push(WAny::ref_to(rep0)); }
        if lex.save_pos() == rsp { break; }
        cnt0 = cnt0 + 1i64;
    }
    let cap2: *const u8 = arr0 as *const WArray<WAny> as *const u8;
    let mut node: RQAggArr = doc.make::<RQAggArr>();
    let mut afi: i64 = 0i64;
    let alen: i64 = rcap.len();
    while afi < alen && afi < RQAGG_MAX() { node.set_agg(afi, rcap.get(afi)); afi = afi + 1i64; }
    node.set_len(afi);
    return node.as_ref().raw() as *const u8;
}

fn rule_agg_list(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_agg_list_0(lex, doc); if r != WqNULLP { return r; } }
    return WqNULLP;
}

fn alt_agg_item_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk1: Token = lex.next();
    let cap1: *const u8 = wstr_p(doc, tk1.text(lex.src));
    if lex.peek().kind != WqTK_EQ { lex.reset(sp, sln); return WqNULLP; }
    let tk2: Token = lex.next();
    let cap2: *const u8 = wstr_p(doc, tk2.text(lex.src));
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk3: Token = lex.next();
    let cap3: *const u8 = wstr_p(doc, tk3.text(lex.src));
    if lex.peek().kind != WqTK_LPAREN { lex.reset(sp, sln); return WqNULLP; }
    let tk4: Token = lex.next();
    let cap4: *const u8 = wstr_p(doc, tk4.text(lex.src));
    if lex.peek().kind != WqTK_RPAREN { lex.reset(sp, sln); return WqNULLP; }
    let tk5: Token = lex.next();
    let cap5: *const u8 = wstr_p(doc, tk5.text(lex.src));
    let node: RQAgg = doc.make::<RQAgg>();
    node.has_arg = false;
    node.fn_name = wstr_as_str(cap3);
    node.name = wstr_as_str(cap1);
    return node.as_ref().raw() as *const u8;
}

fn alt_agg_item_1(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk1: Token = lex.next();
    let cap1: *const u8 = wstr_p(doc, tk1.text(lex.src));
    if lex.peek().kind != WqTK_EQ { lex.reset(sp, sln); return WqNULLP; }
    let tk2: Token = lex.next();
    let cap2: *const u8 = wstr_p(doc, tk2.text(lex.src));
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk3: Token = lex.next();
    let cap3: *const u8 = wstr_p(doc, tk3.text(lex.src));
    if lex.peek().kind != WqTK_LPAREN { lex.reset(sp, sln); return WqNULLP; }
    let tk4: Token = lex.next();
    let cap4: *const u8 = wstr_p(doc, tk4.text(lex.src));
    let cap5: *const u8 = rule_agg_body(lex, doc);
    if cap5 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    if lex.peek().kind != WqTK_RPAREN { lex.reset(sp, sln); return WqNULLP; }
    let tk6: Token = lex.next();
    let cap6: *const u8 = wstr_p(doc, tk6.text(lex.src));
    let node: RQAgg = doc.make::<RQAgg>();
    node.has_arg = true;
    node.fn_name = wstr_as_str(cap3);
    node.name = wstr_as_str(cap1);
    node.arg = WRef::<SExpr>::from_any(hand_any(cap5));
    return node.as_ref().raw() as *const u8;
}

fn rule_agg_item(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_agg_item_0(lex, doc); if r != WqNULLP { return r; } }
    { let r: *const u8 = alt_agg_item_1(lex, doc); if r != WqNULLP { return r; } }
    return WqNULLP;
}

// ── Public entry points (one per %export rule) ─────────────────────────────

pub fn parse_program(src: str, doc: &Writ) -> WAny {
    let mut lex: Lexer = lexer_new(src);
    let root: *const u8 = rule_program(&mut lex, doc);
    if !lex.at_eof() { return WAny::ref_to(WqNULLP); }
    return WAny::ref_to(root);
}
pub fn parse_program_far(src: str, doc: &Writ, out_root: &mut WAny) -> i64 {
    let mut lex: Lexer = lexer_new(src);
    let root: *const u8 = rule_program(&mut lex, doc);
    if !lex.at_eof() { *out_root = WAny::ref_to(WqNULLP); return lex.far.line; }
    *out_root = WAny::ref_to(root);
    return lex.far.line;
}

pub fn parse_rel_list(src: str, doc: &Writ) -> WAny {
    let mut lex: Lexer = lexer_new(src);
    let root: *const u8 = rule_rel_list(&mut lex, doc);
    if !lex.at_eof() { return WAny::ref_to(WqNULLP); }
    return WAny::ref_to(root);
}
pub fn parse_rel_list_far(src: str, doc: &Writ, out_root: &mut WAny) -> i64 {
    let mut lex: Lexer = lexer_new(src);
    let root: *const u8 = rule_rel_list(&mut lex, doc);
    if !lex.at_eof() { *out_root = WAny::ref_to(WqNULLP); return lex.far.line; }
    *out_root = WAny::ref_to(root);
    return lex.far.line;
}

