            break;
        }
        v = v * 10i64 + d;
        i = i + 1i64;
    }
    if ovf { return (-9223372036854775807i64) - 1i64; }
    return v;
}
// Decode a captured FLOAT token (digits '.' digits) into its f64 VALUE —
// the token->f64 hook for float literal fields. Parses the mantissa as an
// integer and divides by 10^k (k = fraction digits): exact powers of ten
// give the correctly-rounded double for short decimal literals.
fn wstr_decode_f64(p: *const u8) -> f64 {
    let s: &str = wstr_as_str(p);
    let n: i64 = s.len();
    let mut mant: i64 = 0i64;
    let mut frac: i64 = 0i64;
    let mut in_frac: bool = false;
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        if c == 46u8 && !in_frac { in_frac = true; i = i + 1i64; continue; }
        if c < 48u8 || c > 57u8 { break; }
        if mant < 922337203685477580i64 {
            mant = mant * 10i64 + ((c as i64) - 48i64);
            if in_frac { frac = frac + 1i64; }
        }
        i = i + 1i64;
    }
    let mut p10: f64 = 1.0f64;
    let mut k: i64 = 0i64;
    while k < frac { p10 = p10 * 10.0f64; k = k + 1i64; }
    return (mant as f64) / p10;
}
// Re-intern a captured STRING token WITHOUT its surrounding quotes: the
// token text is `"..."`; a string literal's VALUE is the inner content
// (matches el.logos parse_string, which stores str_from_range between the
// quotes). Returns the raw WString ptr of the unquoted, arena-interned
// content. (No escape processing — MVP EL, as in the hand parser.)
fn wstr_unquote(doc: &Writ, p: *const u8) -> *const u8 {
    let s: &str = wstr_as_str(p);
    let n: i64 = s.len();
    if n < 2i64 { return wstr_p(doc, s); }
    let inner: str = unsafe { str_from_raw((s.as_ptr() as i64 + 1i64) as *const u8, n - 2i64) };
    return wstr_p(doc, inner);
}

// Is a structural keyword at byte `p` (word boundary on both sides)? The
// keyword-delimited embed's stop set — every alpha-keyword token.
fn embed_at_kw(src: str, p: i64, len: i64) -> bool {
    let before: u8 = if p > 0i64 { str_byte_at(src, p - 1i64) } else { 32u8 };
    if lx_is_alnum(before) { return false; }
    if p + 3i64 <= len && str_byte_at(src, p + 0i64) == 114u8 && str_byte_at(src, p + 1i64) == 101u8 && str_byte_at(src, p + 2i64) == 108u8 && (p + 3i64 >= len || !lx_is_alnum(str_byte_at(src, p + 3i64))) { return true; }
    if p + 4i64 <= len && str_byte_at(src, p + 0i64) == 102u8 && str_byte_at(src, p + 1i64) == 114u8 && str_byte_at(src, p + 2i64) == 111u8 && str_byte_at(src, p + 3i64) == 109u8 && (p + 4i64 >= len || !lx_is_alnum(str_byte_at(src, p + 4i64))) { return true; }
    if p + 5i64 <= len && str_byte_at(src, p + 0i64) == 119u8 && str_byte_at(src, p + 1i64) == 104u8 && str_byte_at(src, p + 2i64) == 101u8 && str_byte_at(src, p + 3i64) == 114u8 && str_byte_at(src, p + 4i64) == 101u8 && (p + 5i64 >= len || !lx_is_alnum(str_byte_at(src, p + 5i64))) { return true; }
    if p + 6i64 <= len && str_byte_at(src, p + 0i64) == 115u8 && str_byte_at(src, p + 1i64) == 101u8 && str_byte_at(src, p + 2i64) == 108u8 && str_byte_at(src, p + 3i64) == 101u8 && str_byte_at(src, p + 4i64) == 99u8 && str_byte_at(src, p + 5i64) == 116u8 && (p + 6i64 >= len || !lx_is_alnum(str_byte_at(src, p + 6i64))) { return true; }
    if p + 4i64 <= len && str_byte_at(src, p + 0i64) == 97u8 && str_byte_at(src, p + 1i64) == 110u8 && str_byte_at(src, p + 2i64) == 116u8 && str_byte_at(src, p + 3i64) == 105u8 && (p + 4i64 >= len || !lx_is_alnum(str_byte_at(src, p + 4i64))) { return true; }
    if p + 4i64 <= len && str_byte_at(src, p + 0i64) == 106u8 && str_byte_at(src, p + 1i64) == 111u8 && str_byte_at(src, p + 2i64) == 105u8 && str_byte_at(src, p + 3i64) == 110u8 && (p + 4i64 >= len || !lx_is_alnum(str_byte_at(src, p + 4i64))) { return true; }
    if p + 2i64 <= len && str_byte_at(src, p + 0i64) == 111u8 && str_byte_at(src, p + 1i64) == 110u8 && (p + 2i64 >= len || !lx_is_alnum(str_byte_at(src, p + 2i64))) { return true; }
    if p + 5i64 <= len && str_byte_at(src, p + 0i64) == 103u8 && str_byte_at(src, p + 1i64) == 114u8 && str_byte_at(src, p + 2i64) == 111u8 && str_byte_at(src, p + 3i64) == 117u8 && str_byte_at(src, p + 4i64) == 112u8 && (p + 5i64 >= len || !lx_is_alnum(str_byte_at(src, p + 5i64))) { return true; }
    if p + 2i64 <= len && str_byte_at(src, p + 0i64) == 98u8 && str_byte_at(src, p + 1i64) == 121u8 && (p + 2i64 >= len || !lx_is_alnum(str_byte_at(src, p + 2i64))) { return true; }
    if p + 9i64 <= len && str_byte_at(src, p + 0i64) == 97u8 && str_byte_at(src, p + 1i64) == 103u8 && str_byte_at(src, p + 2i64) == 103u8 && str_byte_at(src, p + 3i64) == 114u8 && str_byte_at(src, p + 4i64) == 101u8 && str_byte_at(src, p + 5i64) == 103u8 && str_byte_at(src, p + 6i64) == 97u8 && str_byte_at(src, p + 7i64) == 116u8 && str_byte_at(src, p + 8i64) == 101u8 && (p + 9i64 >= len || !lx_is_alnum(str_byte_at(src, p + 9i64))) { return true; }
    if p + 6i64 <= len && str_byte_at(src, p + 0i64) == 104u8 && str_byte_at(src, p + 1i64) == 97u8 && str_byte_at(src, p + 2i64) == 118u8 && str_byte_at(src, p + 3i64) == 105u8 && str_byte_at(src, p + 4i64) == 110u8 && str_byte_at(src, p + 5i64) == 103u8 && (p + 6i64 >= len || !lx_is_alnum(str_byte_at(src, p + 6i64))) { return true; }
    if p + 8i64 <= len && str_byte_at(src, p + 0i64) == 100u8 && str_byte_at(src, p + 1i64) == 105u8 && str_byte_at(src, p + 2i64) == 115u8 && str_byte_at(src, p + 3i64) == 116u8 && str_byte_at(src, p + 4i64) == 105u8 && str_byte_at(src, p + 5i64) == 110u8 && str_byte_at(src, p + 6i64) == 99u8 && str_byte_at(src, p + 7i64) == 116u8 && (p + 8i64 >= len || !lx_is_alnum(str_byte_at(src, p + 8i64))) { return true; }
    if p + 5i64 <= len && str_byte_at(src, p + 0i64) == 102u8 && str_byte_at(src, p + 1i64) == 105u8 && str_byte_at(src, p + 2i64) == 114u8 && str_byte_at(src, p + 3i64) == 115u8 && str_byte_at(src, p + 4i64) == 116u8 && (p + 5i64 >= len || !lx_is_alnum(str_byte_at(src, p + 5i64))) { return true; }
    if p + 4i64 <= len && str_byte_at(src, p + 0i64) == 102u8 && str_byte_at(src, p + 1i64) == 105u8 && str_byte_at(src, p + 2i64) == 110u8 && str_byte_at(src, p + 3i64) == 100u8 && (p + 4i64 >= len || !lx_is_alnum(str_byte_at(src, p + 4i64))) { return true; }
    if p + 5i64 <= len && str_byte_at(src, p + 0i64) == 111u8 && str_byte_at(src, p + 1i64) == 114u8 && str_byte_at(src, p + 2i64) == 100u8 && str_byte_at(src, p + 3i64) == 101u8 && str_byte_at(src, p + 4i64) == 114u8 && (p + 5i64 >= len || !lx_is_alnum(str_byte_at(src, p + 5i64))) { return true; }
    if p + 4i64 <= len && str_byte_at(src, p + 0i64) == 100u8 && str_byte_at(src, p + 1i64) == 101u8 && str_byte_at(src, p + 2i64) == 115u8 && str_byte_at(src, p + 3i64) == 99u8 && (p + 4i64 >= len || !lx_is_alnum(str_byte_at(src, p + 4i64))) { return true; }
    if p + 5i64 <= len && str_byte_at(src, p + 0i64) == 108u8 && str_byte_at(src, p + 1i64) == 105u8 && str_byte_at(src, p + 2i64) == 109u8 && str_byte_at(src, p + 3i64) == 105u8 && str_byte_at(src, p + 4i64) == 116u8 && (p + 5i64 >= len || !lx_is_alnum(str_byte_at(src, p + 5i64))) { return true; }
    return false;
}

// Keyword-delimited embed scan (the wql! surface): the embedded EL clause
// body ends at the next STRUCTURAL STOP — a top-level structural keyword, a
// top-level result-type `:` (ternary `?:` balanced), a top-level `,`/`)`
// (an aggregate arg list), or a top-level `;`/`}` (a rel-body terminator /
// rel-block close). `(`/`[` nesting is tracked so punctuation/keywords
// INSIDE a call / comprehension are NOT stops. EOI is a valid stop (the last
// clause). Mirrors the hand QLexer's take_until_kw / take_until_colon /
// take_until_any3 / aggregate-arg depth-balancing, unified into one scan.
fn embed_find_close(src: str, pos: i64, len: i64) -> i64 {
    let mut p: i64 = pos;
    let mut depth: i64 = 0i64;   // () and [] nesting
    let mut tern: i64 = 0i64;    // '?' opened, closed by ':'
    while p < len {
        let c: u8 = str_byte_at(src, p);
        // A string literal is skipped WHOLE — a stop byte inside it
        // (`select "a,b"`) must not end the clause. Same for `//`.
        if c == 34u8 || c == 39u8 {                                 // " '
            let q: u8 = c;
            p = p + 1i64;
            while p < len {
                let e: u8 = str_byte_at(src, p);
                if e == 92u8 { p = p + 2i64; continue; }            // escape
                if e == q { break; }
                p = p + 1i64;
            }
            p = p + 1i64;
            continue;
        }
        if c == 47u8 && p + 1i64 < len && str_byte_at(src, p + 1i64) == 47u8 {
            while p < len && str_byte_at(src, p) != 10u8 { p = p + 1i64; }
            continue;
        }
        if c == 40u8 || c == 91u8 { depth = depth + 1i64; }         // ( [
        else if c == 41u8 || c == 93u8 {                            // ) ]
            if depth == 0i64 { return p; }   // top-level close → stop
            depth = depth - 1i64;
        }
        else if depth == 0i64 {
            if c == 63u8 { tern = tern + 1i64; }                    // ?
            else if c == 58u8 {                                     // :
                if tern > 0i64 { tern = tern - 1i64; }  // ternary colon
                else { return p; }                      // result-type colon
            }
            else if c == 44u8 { return p; }                         // , (arg sep)
            else if c == 59u8 { return p; }                         // ; (rel-body terminator)
            else if c == 125u8 { return p; }                        // } (rel-block close)
            else if embed_at_kw(src, p, len) { return p; }          // keyword stop
        }
        p = p + 1i64;
    }
    return len;   // EOI — the last clause runs to end of input
}

// ── Grammar rules ──────────────────────────────────────────────────────────

fn alt_program_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    let cap1: *const u8 = rule_rel_list(lex, doc);
    if cap1 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    let cap2: *const u8 = rule_query(lex, doc);
    if cap2 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    let node: RQProgram = doc.make::<RQProgram>();
    node.entry = WRef::<RQuery>::from_any(hand_any(cap2));
    node.rels = WRef::<RQRelArr>::from_any(hand_any(cap1));
    return node.as_ref().raw() as *const u8;
}

fn alt_program_1(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    let cap1: *const u8 = rule_query(lex, doc);
    if cap1 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    let node: RQProgram = doc.make::<RQProgram>();
    node.entry = WRef::<RQuery>::from_any(hand_any(cap1));
    return node.as_ref().raw() as *const u8;
}

fn rule_program(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_program_0(lex, doc); if r != WqNULLP { return r; } }
    { let r: *const u8 = alt_program_1(lex, doc); if r != WqNULLP { return r; } }
    return WqNULLP;
}

fn alt_rel_block_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    if lex.peek().kind != WqTK_KW_REL { lex.reset(sp, sln); return WqNULLP; }
    let tk1: Token = lex.next();
    let cap1: *const u8 = wstr_p(doc, tk1.text(lex.src));
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk2: Token = lex.next();
    let cap2: *const u8 = wstr_p(doc, tk2.text(lex.src));
    if lex.peek().kind != WqTK_LPAREN { lex.reset(sp, sln); return WqNULLP; }
    let tk3: Token = lex.next();
    let cap3: *const u8 = wstr_p(doc, tk3.text(lex.src));
    let cap4: *const u8 = rule_rel_cols(lex, doc);
    if cap4 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    if lex.peek().kind != WqTK_RPAREN { lex.reset(sp, sln); return WqNULLP; }
    let tk5: Token = lex.next();
    let cap5: *const u8 = wstr_p(doc, tk5.text(lex.src));
    if lex.peek().kind != WqTK_LBRACE { lex.reset(sp, sln); return WqNULLP; }
    let tk6: Token = lex.next();
    let cap6: *const u8 = wstr_p(doc, tk6.text(lex.src));
    let cap7: *const u8 = rule_rel_bodies(lex, doc);
    if cap7 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    if lex.peek().kind != WqTK_RBRACE { lex.reset(sp, sln); return WqNULLP; }
    let tk8: Token = lex.next();
    let cap8: *const u8 = wstr_p(doc, tk8.text(lex.src));
    let node: RQRel = doc.make::<RQRel>();
    node.bodies = WRef::<RQBodyArr>::from_any(hand_any(cap7));
    node.name = wstr_as_str(cap2);
    node.cols = WRef::<RQRelColArr>::from_any(hand_any(cap4));
    return node.as_ref().raw() as *const u8;
}

fn rule_rel_block(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_rel_block_0(lex, doc); if r != WqNULLP { return r; } }
    return WqNULLP;
}

fn alt_rel_list_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    let rcap: &mut WArray<WAny> = doc.array(4i64);
    let cap1: *const u8 = rule_rel_block(lex, doc);
    if cap1 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    rcap.push(WAny::ref_to(cap1));
    let arr0: &mut WArray<WAny> = doc.array(4i64);
    let mut cnt0: i64 = 0i64;
    loop {
        let rsp: i64 = lex.save_pos(); let rsln: i64 = lex.save_line();
        let rep0: *const u8 = rule_rel_block(lex, doc);
        if rep0 == WqNULLP { lex.reset(rsp, rsln); break; }
        rcap.push(WAny::ref_to(rep0));
        if rep0 != WqNULLP { arr0.push(WAny::ref_to(rep0)); }
        if lex.save_pos() == rsp { break; }
        cnt0 = cnt0 + 1i64;
    }
    let cap2: *const u8 = arr0 as *const WArray<WAny> as *const u8;
    let mut node: RQRelArr = doc.make::<RQRelArr>();
    let mut afi: i64 = 0i64;
    let alen: i64 = rcap.len();
    while afi < alen && afi < RQREL_MAX() { node.set_rel(afi, rcap.get(afi)); afi = afi + 1i64; }
    node.set_len(afi);
    return node.as_ref().raw() as *const u8;
}

fn rule_rel_list(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_rel_list_0(lex, doc); if r != WqNULLP { return r; } }
    return WqNULLP;
}

fn alt_rel_col_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk1: Token = lex.next();
    let cap1: *const u8 = wstr_p(doc, tk1.text(lex.src));
    if lex.peek().kind != WqTK_COLON { lex.reset(sp, sln); return WqNULLP; }
    let tk2: Token = lex.next();
    let cap2: *const u8 = wstr_p(doc, tk2.text(lex.src));
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk3: Token = lex.next();
    let cap3: *const u8 = wstr_p(doc, tk3.text(lex.src));
    let node: RQRelCol = doc.make::<RQRelCol>();
    node.ty_name = wstr_as_str(cap3);
    node.name = wstr_as_str(cap1);
    return node.as_ref().raw() as *const u8;
}

fn rule_rel_col(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_rel_col_0(lex, doc); if r != WqNULLP { return r; } }
    return WqNULLP;
}

fn alt_rel_cols_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    let rcap: &mut WArray<WAny> = doc.array(4i64);
    let cap1: *const u8 = rule_rel_col(lex, doc);
    if cap1 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    rcap.push(WAny::ref_to(cap1));
    let arr0: &mut WArray<WAny> = doc.array(4i64);
    let mut cnt0: i64 = 0i64;
    loop {
        let rsp: i64 = lex.save_pos(); let rsln: i64 = lex.save_line();
        let mut rep0: *const u8 = WqNULLP;
        let mut rep0_ok: bool = false;
        if !rep0_ok {
            let gsp: i64 = lex.save_pos(); let gsln: i64 = lex.save_line();
            loop {
                if lex.peek().kind != WqTK_COMMA { lex.reset(gsp, gsln); break; }
                let grep0_1_1_t: Token = lex.next();
                let grep0_1_1: *const u8 = wstr_p(doc, grep0_1_1_t.text(lex.src));
                let grep0_2_1: *const u8 = rule_rel_col(lex, doc);
                if grep0_2_1 == WqNULLP { lex.reset(gsp, gsln); break; }
                rcap.push(WAny::ref_to(grep0_2_1));
                rep0 = grep0_2_1;
                rep0_ok = true;
                break;
            }
        }
        if !rep0_ok { lex.reset(rsp, rsln); break; }
        if rep0 != WqNULLP { arr0.push(WAny::ref_to(rep0)); }
        if lex.save_pos() == rsp { break; }
        cnt0 = cnt0 + 1i64;
    }
    let cap2: *const u8 = arr0 as *const WArray<WAny> as *const u8;
    let mut node: RQRelColArr = doc.make::<RQRelColArr>();
    let mut afi: i64 = 0i64;
    let alen: i64 = rcap.len();
    while afi < alen && afi < RQRELCOL_MAX() { node.set_col(afi, rcap.get(afi)); afi = afi + 1i64; }
    node.set_len(afi);
    return node.as_ref().raw() as *const u8;
}

fn rule_rel_cols(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_rel_cols_0(lex, doc); if r != WqNULLP { return r; } }
    return WqNULLP;
}

fn alt_rel_bodies_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    let rcap: &mut WArray<WAny> = doc.array(4i64);
    let cap1: *const u8 = rule_query(lex, doc);
    if cap1 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    rcap.push(WAny::ref_to(cap1));
    if lex.peek().kind != WqTK_SEMI { lex.reset(sp, sln); return WqNULLP; }
    let tk2: Token = lex.next();
    let cap2: *const u8 = wstr_p(doc, tk2.text(lex.src));
    let arr0: &mut WArray<WAny> = doc.array(4i64);
    let mut cnt0: i64 = 0i64;
    loop {
        let rsp: i64 = lex.save_pos(); let rsln: i64 = lex.save_line();
        let mut rep0: *const u8 = WqNULLP;
        let mut rep0_ok: bool = false;
        if !rep0_ok {
            let gsp: i64 = lex.save_pos(); let gsln: i64 = lex.save_line();
            loop {
                let grep0_1_1: *const u8 = rule_query(lex, doc);
                if grep0_1_1 == WqNULLP { lex.reset(gsp, gsln); break; }
                rcap.push(WAny::ref_to(grep0_1_1));
                if lex.peek().kind != WqTK_SEMI { lex.reset(gsp, gsln); break; }
                let grep0_2_1_t: Token = lex.next();
                let grep0_2_1: *const u8 = wstr_p(doc, grep0_2_1_t.text(lex.src));
                rep0 = grep0_1_1;
                rep0_ok = true;
                break;
            }
        }
        if !rep0_ok { lex.reset(rsp, rsln); break; }
        if rep0 != WqNULLP { arr0.push(WAny::ref_to(rep0)); }
        if lex.save_pos() == rsp { break; }
        cnt0 = cnt0 + 1i64;
    }
    let cap3: *const u8 = arr0 as *const WArray<WAny> as *const u8;
    let mut node: RQBodyArr = doc.make::<RQBodyArr>();
    let mut afi: i64 = 0i64;
