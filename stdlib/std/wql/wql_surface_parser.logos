fn rule_query(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let mk: i64 = lex.save_pos() * 1024i64 + 6i64;
    let mut hok: bool = false; let mut hr: *const u8 = WqNULLP; let mut hep: i64 = 0i64; let mut hel: i64 = 0i64;
    unsafe {
        let mp: *mut HashMap<i64, WqMemoCell> = &mut lex.memo;
        let hp: *const WqMemoCell = mp.get(&mk);
        if hp != (0i64 as *const WqMemoCell) { hok = true; hr = (*hp).res; hep = (*hp).endpos; hel = (*hp).endline; }
    }
    if hok { lex.reset(hep, hel); return hr; }
    let r: *const u8 = rule_query_impl(lex, doc);
    let ep: i64 = lex.save_pos(); let el: i64 = lex.save_line();
    unsafe { let mp: *mut HashMap<i64, WqMemoCell> = &mut lex.memo; mp.insert(mk, WqMemoCell { res: r, endpos: ep, endline: el }); }
    return r;
}

