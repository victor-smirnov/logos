    if cap4 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk5: Token = lex.next();
    let cap5: *const u8 = wstr_p(doc, tk5.text(lex.src));
    let mut cap6: *const u8 = WqNULLP;
    {
        let osp: i64 = lex.save_pos(); let osln: i64 = lex.save_line();
        let sub_r: *const u8 = rule_on_clause(lex, doc);
        if sub_r != WqNULLP { cap6 = sub_r; } else { lex.reset(osp, osln); }
    }
    let node: RQJoinStep = doc.make::<RQJoinStep>();
    node.on = WRef::<SExpr>::from_any(hand_any(cap6));
    node.path = WRef::<RQPathSegArr>::from_any(hand_any(cap4));
    node.is_edge = true;
    node.var_name = wstr_as_str(cap5);
    node.is_anti = cap1 != WqNULLP;
    node.has_on = cap6 != WqNULLP;
    node.base_var = wstr_as_str(cap3);
    return node.as_ref().raw() as *const u8;
}

