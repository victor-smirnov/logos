    let tk2: Token = lex.next();
    let cap2: *const u8 = wstr_p(doc, tk2.text(lex.src));
    let mut cap3: *const u8 = WqNULLP;
    {
        let osp: i64 = lex.save_pos(); let osln: i64 = lex.save_line();
        if lex.peek().kind == WqTK_IDENT { let t: Token = lex.next(); cap3 = wstr_p(doc, t.text(lex.src)); }
    }
    let node: RQGStep = doc.make::<RQGStep>();
    node.has_binder = cap3 != WqNULLP;
    node.binder = wstr_as_str(cap3);
    node.is_key = true;
    node.key = wstr_as_str(cap2);
    return node.as_ref().raw() as *const u8;
}

