    { let r: *const u8 = alt_query_1(lex, doc); if r != WqNULLP { return r; } }
    { let r: *const u8 = alt_query_2(lex, doc); if r != WqNULLP { return r; } }
    return WqNULLP;
}

fn alt_simple_query_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    if lex.peek().kind != WqTK_KW_FROM { lex.reset(sp, sln); return WqNULLP; }
    let tk1: Token = lex.next();
    let cap1: *const u8 = wstr_p(doc, tk1.text(lex.src));
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk2: Token = lex.next();
    let cap2: *const u8 = wstr_p(doc, tk2.text(lex.src));
    if lex.peek().kind != WqTK_COLON { lex.reset(sp, sln); return WqNULLP; }
    let tk3: Token = lex.next();
    let cap3: *const u8 = wstr_p(doc, tk3.text(lex.src));
    if lex.peek().kind != WqTK_LBRACKET { lex.reset(sp, sln); return WqNULLP; }
    let tk4: Token = lex.next();
    let cap4: *const u8 = wstr_p(doc, tk4.text(lex.src));
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk5: Token = lex.next();
    let cap5: *const u8 = wstr_p(doc, tk5.text(lex.src));
    if lex.peek().kind != WqTK_RBRACKET { lex.reset(sp, sln); return WqNULLP; }
    let tk6: Token = lex.next();
    let cap6: *const u8 = wstr_p(doc, tk6.text(lex.src));
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk7: Token = lex.next();
    let cap7: *const u8 = wstr_p(doc, tk7.text(lex.src));
    let mut cap8: *const u8 = WqNULLP;
    {
        let osp: i64 = lex.save_pos(); let osln: i64 = lex.save_line();
        let sub_r: *const u8 = rule_where_clause(lex, doc);
        if sub_r != WqNULLP { cap8 = sub_r; } else { lex.reset(osp, osln); }
    }
    if lex.peek().kind != WqTK_KW_SELECT { lex.reset(sp, sln); return WqNULLP; }
    let tk9: Token = lex.next();
    let cap9: *const u8 = wstr_p(doc, tk9.text(lex.src));
    let cap10: *const u8 = rule_sel_body(lex, doc);
    if cap10 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    let mut cap11: *const u8 = WqNULLP;
    {
        let osp: i64 = lex.save_pos(); let osln: i64 = lex.save_line();
        let sub_r: *const u8 = rule_result_clause(lex, doc);
        if sub_r != WqNULLP { cap11 = sub_r; } else { lex.reset(osp, osln); }
    }
    let mut cap12: *const u8 = WqNULLP;
    {
        let osp: i64 = lex.save_pos(); let osln: i64 = lex.save_line();
        let sub_r: *const u8 = rule_with_opt(lex, doc);
        if sub_r != WqNULLP { cap12 = sub_r; } else { lex.reset(osp, osln); }
    }
    let node: RQSimple = doc.make::<RQSimple>();
    node.result_ty = wstr_as_str(cap11);
    node.row_ty = wstr_as_str(cap5);
    node.where_pred = WRef::<SExpr>::from_any(hand_any(cap8));
    node.var_name = wstr_as_str(cap7);
    node.src_name = wstr_as_str(cap2);
    node.with_decls = WRef::<RQWithArr>::from_any(hand_any(cap12));
    node.select = WRef::<SExpr>::from_any(hand_any(cap10));
    node.has_result_ty = cap11 != WqNULLP;
    node.has_where = cap8 != WqNULLP;
    return node.as_ref().raw() as *const u8;
}

