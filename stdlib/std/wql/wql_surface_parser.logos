fn alt_where_body_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    // ── embedded cross-grammar parse (T2): scan raw sub-range + sub-parse ──
    let est_cap1: i64 = lex.save_pos();
    let ecl_cap1: i64 = embed_find_close(lex.src, est_cap1, lex.src.len());
    if ecl_cap1 < 0i64 { lex.reset(sp, sln); return WqNULLP; }
    let mut eend_cap1: i64 = ecl_cap1;
    if eend_cap1 > est_cap1 && str_byte_at(lex.src, eend_cap1 - 1i64) == 45u8 { eend_cap1 = eend_cap1 - 1i64; }
    let esub_cap1: str = unsafe { str_from_raw((lex.src.as_ptr() as i64 + est_cap1) as *const u8, eend_cap1 - est_cap1) };
    let eroot_cap1: WAny = logos.std.wql.el_parser::parse_expr(esub_cap1, doc);
    lex.reset(eend_cap1, lex.save_line());
    let cap1: *const u8 = if eroot_cap1.is_null() { WqNULLP } else { eroot_cap1.raw() as *const u8 };
    if cap1 == WqNULLP { lex.reset(sp, sln); return WqNULLP; }
    return cap1;
}

