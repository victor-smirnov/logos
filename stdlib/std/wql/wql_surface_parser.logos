// quotes). Returns the raw WString ptr of the unquoted, arena-interned
// content. (No escape processing — MVP EL, as in the hand parser.)
fn wstr_unquote(doc: &Writ, p: *const u8) -> *const u8 {
    let s: &str = wstr_as_str(p);
    let n: i64 = s.len();
