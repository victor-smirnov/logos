    let mut cap1: *const u8 = WqNULLP;
    {
        let osp: i64 = lex.save_pos(); let osln: i64 = lex.save_line();
        if lex.peek().kind == WqTK_KW_ANTI { let t: Token = lex.next(); cap1 = wstr_p(doc, t.text(lex.src)); }
    }
    if lex.peek().kind != WqTK_KW_JOIN { lex.reset(sp, sln); return WqNULLP; }
    let tk2: Token = lex.next();
    let cap2: *const u8 = wstr_p(doc, tk2.text(lex.src));
    if lex.peek().kind != WqTK_IDENT { lex.reset(sp, sln); return WqNULLP; }
    let tk3: Token = lex.next();
