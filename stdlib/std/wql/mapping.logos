// logos.std.wql.mapping — the `mapping!` packaging macro (ADR 0016 M2b v1).
//
// A MAPPING is a named, typed, reusable set of domain relations over a
// source shape (ADR 0016 §1) — the first concrete rule-module. This v1
// packages the declared rels as one generated PUBLIC FUNCTION per relation:
//
//   resource Services = mapping!(g: &Writ) {
//       rel engine(owner: i64, name: str) {
//           from g ** .engine e select (e.parent, e.vs);
//       }
//       rel port(svc: i64, p: i64) {
//           from g .ports [*] q select (q.parent, q.vi);
//       }
//   };
//
//   → pub fn Services_engine(g: &Writ) -> Result<Vec<(i64, str)>, ElError>
//     pub fn Services_port(g: &Writ)   -> Result<Vec<(i64, i64)>, ElError>
//
// MECHANICS: pure reuse. Per declared rel R(c1, …, cn) the handler compiles
// the FULL mapping body (so rels may reference each other) plus a synthesized
// entry `from R x select (x.c1, …, x.cn)` through the SAME pipeline as deem!
// (parse_program → graph-path desugar → walk_program_params), stamped with
// the fn name `<Mapping>_<R>`. Graph-path sugar, `**`/reach injection,
// recursion, stratification — everything a deem! body can do, a mapping rel
// can do (design decision: mappings are UNRESTRICTED rule modules).
//
// Cost note (v1): each generated fn materializes its dependency rels per
// call. The `deem!(g: Services)` consumption form (mapping rels as native
// rels inside one query) and demand-driven bodies are later slices (M2b-2 /
// M6).
package logos.std.wql.mapping;

use logos.std.compiler.metaprog;         // ItemList, item_list_new, error
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.std.wql.params;                // MacroParams / parse_macro_params
use logos.std.wql.wql_surface_parser;    // parse_program
use logos.std.wql.plan_walker;           // walk_program_params
use logos.std.wql.lower;                 // desugar_program_gpaths
use logos.lang.str;
use logos.mem.string;

fn ms(s: &String) -> str {
    return unsafe { str_from_raw(s.as_ptr(), s.len()) };
}

fn is_sp(c: u8) -> bool { return c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8; }
fn is_al(c: u8) -> bool {
    return (c >= 97u8 && c <= 122u8) || (c >= 65u8 && c <= 90u8) || c == 95u8;
}
fn is_an(c: u8) -> bool { return is_al(c) || (c >= 48u8 && c <= 57u8); }

// One declared rel: its name and column names (for the entry projection).
struct MRel { pub name: str, pub cols: [str; 8], pub ncols: i64 }

// Scan the body text for `rel NAME ( col : ty , … )` heads (top level; the
// full grammar validates later — this only needs names + column names to
// synthesize the per-rel entry queries).
fn scan_rels(body: str, out: &mut [MRel; 8]) -> i64 {
    let n: i64 = body.len();
    let mut nr: i64 = 0i64;
    let mut i: i64 = 0i64;
    let mut depth: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(body, i);
        if c == 123u8 { depth = depth + 1i64; i = i + 1i64; continue; }   // {
        if c == 125u8 { depth = depth - 1i64; i = i + 1i64; continue; }   // }
        // top-level `rel` keyword
        if depth == 0i64 && c == 114u8 && i + 3i64 <= n
        && str_byte_at(body, i + 1i64) == 101u8      // e
        && str_byte_at(body, i + 2i64) == 108u8      // l
        && (i == 0i64 || !is_an(str_byte_at(body, i - 1i64)))
        && (i + 3i64 >= n || !is_an(str_byte_at(body, i + 3i64))) {
            let mut p: i64 = i + 3i64;
            while p < n && is_sp(str_byte_at(body, p)) { p = p + 1i64; }
            let ns: i64 = p;
            while p < n && is_an(str_byte_at(body, p)) { p = p + 1i64; }
            if p > ns && nr < 8i64 {
                out[nr].name = unsafe { str_from_raw(((body.as_ptr() as i64) + ns) as *const u8, p - ns) };
                // columns: `( col : ty , col : ty … )`
                while p < n && is_sp(str_byte_at(body, p)) { p = p + 1i64; }
                let mut nc: i64 = 0i64;
                if p < n && str_byte_at(body, p) == 40u8 {                // (
                    p = p + 1i64;
                    loop {
                        while p < n && is_sp(str_byte_at(body, p)) { p = p + 1i64; }
                        let cs: i64 = p;
                        while p < n && is_an(str_byte_at(body, p)) { p = p + 1i64; }
                        if p > cs && nc < 8i64 {
                            out[nr].cols[nc] = unsafe { str_from_raw(((body.as_ptr() as i64) + cs) as *const u8, p - cs) };
                            nc = nc + 1i64;
                        }
                        // skip `: ty` to the next `,` or `)`
                        while p < n && str_byte_at(body, p) != 44u8
                              && str_byte_at(body, p) != 41u8 { p = p + 1i64; }
                        if p >= n || str_byte_at(body, p) == 41u8 { break; }
                        p = p + 1i64;   // ','
                    }
                }
                out[nr].ncols = nc;
                nr = nr + 1i64;
            }
            i = p;
            continue;
        }
        i = i + 1i64;
    }
    return nr;
}

/// Handler behind `mapping!{}` — a named set of domain relations over a
/// source shape, emitted as one generated function per relation (see the
/// module doc). Invoked as `resource <Name> = mapping!(<params>) { rel …; … }`.
#[token_macro]
pub fn mapping(name: str, params: str, body: str) -> ItemList {
    let out: ItemList = item_list_new();
    if name.len() == 0i64 {
        error("mapping!: needs a binding name — write `resource <Name> = mapping!(<params>){ rel …(…){ …; } … }`");
        return out;
    }
    let mut prm0: MacroParams = macro_params_new();
    parse_macro_params(params, &mut prm0);
    if prm0.n == 0i64 {
        error("mapping!: needs at least one parameter — the source shape (e.g. `g: &Writ`)");
        return out;
    }
    let mut rels: [MRel; 8] = [
        MRel { name: "", cols: ["", "", "", "", "", "", "", ""], ncols: 0i64 },
        MRel { name: "", cols: ["", "", "", "", "", "", "", ""], ncols: 0i64 },
        MRel { name: "", cols: ["", "", "", "", "", "", "", ""], ncols: 0i64 },
        MRel { name: "", cols: ["", "", "", "", "", "", "", ""], ncols: 0i64 },
        MRel { name: "", cols: ["", "", "", "", "", "", "", ""], ncols: 0i64 },
        MRel { name: "", cols: ["", "", "", "", "", "", "", ""], ncols: 0i64 },
        MRel { name: "", cols: ["", "", "", "", "", "", "", ""], ncols: 0i64 },
        MRel { name: "", cols: ["", "", "", "", "", "", "", ""], ncols: 0i64 },
    ];
    let nr: i64 = scan_rels(body, &mut rels);
    if nr == 0i64 {
        error("mapping!: no `rel` declarations found — a mapping is a set of rels (`rel name(col: ty, …){ body; }`)");
        return out;
    }
    // Per rel: full body + synthesized entry, through the deem! pipeline,
    // stamped `<Name>_<rel>`.
    let mut r: i64 = 0i64;
    while r < nr {
        let mut prog: String = String::new();
        prog.push_str(body);
        prog.push_str("\nfrom ");
        prog.push_str(rels[r].name);
        prog.push_str(" __mx select ");
        if rels[r].ncols == 1i64 {
            prog.push_str("__mx.");
            prog.push_str(rels[r].cols[0]);
        } else {
            prog.push_str("(");
            let mut c: i64 = 0i64;
            while c < rels[r].ncols {
                if c > 0i64 { prog.push_str(", "); }
                prog.push_str("__mx.");
                prog.push_str(rels[r].cols[c]);
                c = c + 1i64;
            }
            prog.push_str(")");
        }
        let mut fname: String = String::new();
        fname.push_str(name);
        fname.push_str("_");
        fname.push_str(rels[r].name);

        let h: Writ = writ_new(8192i64);
        let root: WAny = parse_program(ms(&prog), &h);
        if root.is_null() {
            error("mapping!: malformed rel body (each body is a full deem! query: `from … select …`)");
            return out;
        }
        let mut gperr: String = String::new();
        if !desugar_program_gpaths(root, &h, &mut gperr) {
            error(ms(&gperr));
            return out;
        }
        let mut prm: MacroParams = macro_params_new();
        parse_macro_params(params, &mut prm);
        if !walk_program_params(root, ms(&fname), params, &mut prm, &h) {
            return out;
        }
        r = r + 1i64;
    }
    return out;
}
