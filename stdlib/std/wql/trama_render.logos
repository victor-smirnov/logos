// logos.std.wql.trama_render — the `trama!{ … }` RESOURCE surface (ADR 0012
// §6/§10.2, queue-1 STATIC lowering). A `#[token_macro]` handler receives the
// raw block bytes at compile time, parses the MVP surface + the template into
// the Trama AST (Phase-3 schema'd `TStmt` tree, whose `{{ … }}` / tag expressions
// are SExpr edges), WALKS that AST, and EMITS a native Logos `render` function
// (via `logos_emit_source`) that builds and returns the woven `String`.
//
// MVP surface (explicit-typed data context, per the ADR static model):
//
//   resource <name> = trama! {
//       data <ctx>:<CtxTy>
//       " <template> "
//   };
//
// The render-fn NAME is the `resource <name> =` binding (ADR 0012 §6), NOT an
// `fn <name>` line inside the block; the handler receives it as the `name` arg
// and the block body starts at `data`.
//
//   →  pub fn <name>(<ctx>: &<CtxTy>) -> String {
//          let mut __out: String = String::new();
//          … walk the Trama AST …
//          return __out;
//      }
//
// Template constructs lowered:
//   • literal text run        → __out.push_str("<bytes>");
//   • {{ expr }}              → __out.push_i64(<expr>);   (MVP: i64 interpolation)
//   • {% if expr %}…{% else %}…{% endif %}  → if (<expr>) { … } else { … }
//   • {% for v in expr %}…{% endfor %}      → indexed while-loop over (<expr>)
//   • {% set v = expr %}      → let v: i64 = <expr>;
//
// The embedded `{{ … }}` / tag expressions are the Trama AST's `WRef<SExpr>`
// edges (the ONE coupling, ADR 0012 §seam); they are emitted by the SHARED
// SExpr codegen (`logos.std.wql.codegen::emit_sexpr`), exactly as the `wql!`
// where/select clauses are. Field/loop-var NAMES are read off the self-describing
// IR (Option B); value-TYPES come from the `ElTypes` dict the handler builds from
// schema reflection + the `with` clause (loop/set var type names from `TVarTys`).
//
// The template is parsed by the peg_gen_logos-GENERATED parser
// (`logos.std.wql.trama_parser::parse_tpl`), which yields the `tpl` as a WArray of
// TStmt handles; the handler stitches the `next`-linked chain the renderer walks
// (the T3 post-pass `chain_array`, below). The hand-written Trama parser is retired.
package logos.std.wql.trama_render;

use logos.std.compiler.metaprog;     // Emitter, ItemList, item_list_new, error
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;
use logos.lang.writ.wstring;
use logos.lang.writ.array;        // WArray — the generated `tpl` statement array
use logos.std.wql.ir;
use logos.std.wql.el;             // ElTypes / el_types_new / el_ty_of_name / EL_TY_* (type dict)
use logos.std.wql.trama;          // TStmt schema family (TText/TVar/TFor/TIf/TSet)
use logos.std.wql.trama_parser;   // parse_tpl — the GENERATED Trama parser (self-describing IR)
use logos.std.wql.codegen;
use logos.std.wql.reflect;   // stamp_types_from_schema — context field-type reflection
use logos.mem.string;
use logos.lang.str;

// ── Surface lexer (clause carving) ─────────────────────────────────────────
struct TLexer {
    src: str,
    pos: i64,
    len: i64,
}

fn tl_is_space(c: u8) -> bool { return c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8; }
fn tl_is_alpha(c: u8) -> bool {
    return (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) || c == 95u8;
}
fn tl_is_digit(c: u8) -> bool { return c >= 48u8 && c <= 57u8; }
fn tl_is_alnum(c: u8) -> bool { return tl_is_alpha(c) || tl_is_digit(c); }

impl TLexer {
    fn cur(self: &TLexer) -> u8 {
        if self.pos >= self.len { return 0u8; }
        return str_byte_at(self.src, self.pos);
    }
    fn bump(self: &mut TLexer) { self.pos = self.pos + 1i64; }
    fn skip_ws(self: &mut TLexer) {
        while self.pos < self.len && tl_is_space(self.cur()) { self.bump(); }
    }
    fn eat_kw(self: &mut TLexer, kw: str) -> bool {
        self.skip_ws();
        let n: i64 = kw.len();
        if self.pos + n > self.len { return false; }
        let mut i: i64 = 0i64;
        while i < n {
            if str_byte_at(self.src, self.pos + i) != str_byte_at(kw, i) { return false; }
            i = i + 1i64;
        }
        let after: u8 = if self.pos + n < self.len { str_byte_at(self.src, self.pos + n) } else { 0u8 };
        if tl_is_alnum(after) { return false; }
        self.pos = self.pos + n;
        return true;
    }
    // Scan a bare identifier at the cursor → its byte length (cursor advances).
    fn scan_ident(self: &mut TLexer) -> i64 {
        self.skip_ws();
        if !tl_is_alpha(self.cur()) { return 0i64; }
        let start: i64 = self.pos;
        while self.pos < self.len && tl_is_alnum(self.cur()) { self.bump(); }
        return self.pos - start;
    }
    // Scan a TYPE name (an identifier; the `with`-clause types are simple names
    // — `str`, `bool`, `i64`, or a struct name — in the MVP). Cursor advances.
    fn scan_type(self: &mut TLexer) -> i64 {
        return self.scan_ident();
    }
    // Scan an identifier at the cursor → its slice (advances).
    fn scan_ident_str(self: &mut TLexer) -> str {
        self.skip_ws();
        let start: i64 = self.pos;
        if !tl_is_alpha(self.cur()) { return ""; }
        while self.pos < self.len && tl_is_alnum(self.cur()) { self.bump(); }
        return unsafe { tl_str_range(self.src, start, self.pos - start) };
    }
    // The template body, delimited by either `"…"` or backticks `` `…` ``.
    // Backtick delimiters let the template contain bare `"` string literals
    // (e.g. `{{ "(" + city + ")" }}` / `{% if x == "NYC" %}`) WITHOUT escaping —
    // the recommended form when embedded EL string literals are used. The
    // double-quote form stays for simple templates (no inner quotes). Returns
    // the inner [start,end) slice; advances past the closing delimiter. Empty on
    // a missing/mismatched delimiter.
    fn scan_template(self: &mut TLexer) -> str {
        self.skip_ws();
        let delim: u8 = self.cur();
        if delim != 34u8 && delim != 96u8 { return ""; }  // '"' or '`'
        self.bump();
        let start: i64 = self.pos;
        while self.pos < self.len && self.cur() != delim { self.bump(); }
        let end: i64 = self.pos;
        if self.cur() == delim { self.bump(); }
        return unsafe { tl_str_range(self.src, start, end - start) };
    }
}

unsafe fn tl_str_range(src: str, start: i64, len: i64) -> str {
    let l: i64 = if len < 0i64 { 0i64 } else { len };
    return str_from_raw((src.as_ptr() as i64 + start) as *const u8, l);
}

// ── Text-run escaping ──────────────────────────────────────────────────────
// Emit a literal text run as a Logos string literal body, escaping `"` and `\`
// and newlines so the generated `__out.push_str("…")` parses.
fn emit_escaped(em: &mut Emitter, s: str) {
    let n: i64 = s.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        if c == 34u8 { em.push_text("\\\""); }
        else if c == 92u8 { em.push_text("\\\\"); }
        else if c == 10u8 { em.push_text("\\n"); }
        else if c == 13u8 { em.push_text("\\r"); }
        else if c == 9u8  { em.push_text("\\t"); }
        else {
            // push the single byte verbatim
            let one: str = unsafe { str_from_raw((s.as_ptr() as i64 + i) as *const u8, 1i64) };
            em.push_text(one);
        }
        i = i + 1i64;
    }
}

// ── Declared loop/set var TYPE NAMES (name → Logos type-name) ──────────────
// A tiny association list over `str` slices, built from the `with` clause. Used
// to emit a loop var's element binding type (`let v: <ty>`); an undeclared var
// defaults to the i64 baseline. Replaces the retired TrParser.var_ty_of table.
struct TVarTys {
    names: [str; 64],
    tys:   [str; 64],
    n:     i64,
}
fn tvartys_new() -> TVarTys {
    return TVarTys {
        names: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        tys:   ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        n: 0i64,
    };
}
impl TVarTys {
    fn declare(self: &mut TVarTys, name: str, ty: str) {
        if self.n < 64i64 { self.names[self.n] = name; self.tys[self.n] = ty; self.n = self.n + 1i64; }
    }
    fn ty_name(self: &TVarTys, name: str) -> str {
        let mut i: i64 = 0i64;
        while i < self.n { if str_eq(self.names[i], name) { return self.tys[i]; } i = i + 1i64; }
        return "";
    }
}

// ── Read a TText node's literal bytes as a `str` ───────────────────────────
// TText.text is a WAny Ref → WString boxed at parse time; recover its bytes.
fn ttext_str(t: &TText) -> str {
    let w: WAny = t.text;
    if !w.is_string() { return ""; }
    return w.as_wstr();
}

// ── T3 post-pass: WArray-of-statements → `next`-linked TStmt chain ──────────
// The GENERATED `parse_tpl` returns a `tpl` as a WArray of per-statement TStmt
// handles (the grammar `tpl <- stmt*`); bodies (`TFor.body`, `TIf.body`, and the
// else edge `TIf.alt`) are likewise WArray handles. The renderer walks a `next`-
// linked chain, so the handler STITCHES the chain here (ADR 0012 §T3): link each
// array element to its successor, and recurse into every for/if body + else edge.
// The elif chain is already NESTED TIf (grammar-desugared), so `TIf.alt` may be a
// TIf node (elif) rather than a WArray — that node is left as its own head.
//
// Returns the HEAD chain-word (0 = empty), and rewrites each node's `body`/`alt`
// WArray edge in place to the head of the linked sub-chain.

// Rebind a TStmt node's `next` edge to a raw chain-word.
fn set_next_w(next_of: i64, next: i64) {
    let e: TStmt = WAny::ref_to(next_of as *const u8).view::<TStmt>();
    let nref: WRef<TStmt> = WRef::<TStmt>::from_any(WAny::ref_to(next as *const u8));
    match e {
        TStmt::Text(t) => { t.next = nref; }
        TStmt::Var(v)  => { v.next = nref; }
        TStmt::For(f)  => { f.next = nref; }
        TStmt::If(i)   => { i.next = nref; }
        TStmt::Set(s)  => { s.next = nref; }
    }
}

// Rebind a TFor's `body` edge (WArray → chain head).
fn set_for_body(node_w: i64, head: i64) {
    let e: TStmt = WAny::ref_to(node_w as *const u8).view::<TStmt>();
    match e { TStmt::For(f) => { f.body = WRef::<TStmt>::from_any(WAny::ref_to(head as *const u8)); } _ => { } }
}
// Rebind a TIf's `body` edge.
fn set_if_body(node_w: i64, head: i64) {
    let e: TStmt = WAny::ref_to(node_w as *const u8).view::<TStmt>();
    match e { TStmt::If(i) => { i.body = WRef::<TStmt>::from_any(WAny::ref_to(head as *const u8)); } _ => { } }
}
// Rebind a TIf's `alt` edge.
fn set_if_alt(node_w: i64, head: i64) {
    let e: TStmt = WAny::ref_to(node_w as *const u8).view::<TStmt>();
    match e { TStmt::If(i) => { i.alt = WRef::<TStmt>::from_any(WAny::ref_to(head as *const u8)); } _ => { } }
}

// Convert a body/alt edge word into a `next`-linked chain HEAD word. The edge is
// either: null (→ 0), a WArray of statements (→ link them, recurse), or a single
// TStmt node (an elif TIf → treat as a one-element chain: recurse its bodies).
fn chain_edge(edge_w: i64) -> i64 {
    if edge_w == 0i64 { return 0i64; }
    let a: WAny = WAny::ref_to(edge_w as *const u8);
    if a.is_array() {
        let arr: &WArray<WAny> = a.as_array();
        return chain_array(arr);
    }
    // A single node (grammar-desugared elif TIf): recurse into its sub-edges and
    // return it as the chain head (its own `next` stays null unless the caller sets it).
    chain_node(edge_w);
    return edge_w;
}

// Recurse into a node's for/if bodies + else edge, rewriting them to chain heads.
fn chain_node(node_w: i64) {
    let e: TStmt = WAny::ref_to(node_w as *const u8).view::<TStmt>();
    match e {
        TStmt::For(f) => {
            let b: i64 = f.body.any().raw();
            set_for_body(node_w, chain_edge(b));
        }
        TStmt::If(i) => {
            let b: i64 = i.body.any().raw();
            set_if_body(node_w, chain_edge(b));
            let a: i64 = i.alt.any().raw();
            set_if_alt(node_w, chain_edge(a));
        }
        _ => { }
    }
}

// Link a WArray of statement handles into a `next`-linked chain; recurse into each
// node's bodies. Returns the head word (0 = empty).
fn chain_array(arr: &WArray<WAny>) -> i64 {
    let n: i64 = arr.len();
    if n == 0i64 { return 0i64; }
    let mut head: i64 = 0i64;
    let mut prev: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < n {
        let w: i64 = arr.get(i).raw();
        chain_node(w);                       // stitch this node's own bodies first
        if head == 0i64 { head = w; } else { set_next_w(prev, w); }
        prev = w;
        i = i + 1i64;
    }
    return head;
}

// ── Trama AST → render-fn body ─────────────────────────────────────────────
// Walk a TStmt chain (the singly-linked body), emitting render statements into
// `em`. The type dict `ty` holds field/param/var value-types (reflection + `with`);
// `vtys` resolves a `for`/`set` var's declared Logos TYPE NAME. `depth`
// disambiguates nested loop counters (`__i0`, `__i1`, …); the walk follows `next`.
fn emit_stmts(em: &mut Emitter, head: i64, ty: &ElTypes, vtys: &TVarTys, ctx: str, depth: i64) {
    let mut cur: i64 = head;
    while cur != 0i64 {
        let e: TStmt = WAny::ref_to(cur as *const u8).view::<TStmt>();
        let nxt: i64 = emit_one(em, e, ty, vtys, ctx, depth);
        cur = nxt;
    }
}

// Emit ONE statement; return the `next`-link word (0 = end of chain).
fn emit_one(em: &mut Emitter, e: TStmt, ty: &ElTypes, vtys: &TVarTys, ctx: str, depth: i64) -> i64 {
    match e {
        TStmt::Text(t) => {
            let s: str = ttext_str(&t);
            em.push_text("    __out.push_str(\"");
            emit_escaped(em, s);
            em.push_text("\");\n");
            return next_word(&t.next);
        }
        TStmt::Var(v) => {
            // {{ expr }} → append the expression's value to the buffer, routed
            // by its inferred value-type: a STRING expr (field/literal/concat)
            // is pushed via push_str (concat flattened to successive pushes); a
            // BOOL renders as the words true/false; otherwise the i64 value.
            let se: SExpr = v.expr_expr();
            let vt: i32 = infer_ty(se, ty);
            if vt == EL_TY_STR() {
                let mut tmp: String = String::new();
                emit_push_str(&mut tmp, "    ", "__out", se, ty, ctx);
                em.push_text(string_as_str(&tmp));
            } else if vt == EL_TY_BOOL() {
                let mut body: String = String::new();
                emit_sexpr(&mut body, se, ty, ctx);
                em.push_text("    if (");
                em.push_text(string_as_str(&body));
                em.push_text(") { __out.push_str(\"true\"); } else { __out.push_str(\"false\"); }\n");
            } else {
                let mut body: String = String::new();
                emit_sexpr(&mut body, se, ty, ctx);
                em.push_text("    __out.push_i64(");
                em.push_text(string_as_str(&body));
                em.push_text(");\n");
            }
            return next_word(&v.next);
        }
        TStmt::Set(s) => {
            // {% set var = expr %} → a typed let binding whose type follows the
            // assigned expression (str / bool / i64). A str `set` binds a `str`
            // (single value) or, when the RHS is a concat, a built `String`.
            let vname: str = s.var;
            let se: SExpr = s.expr_expr();
            let vt: i32 = infer_ty(se, ty);
            let mut body: String = String::new();
            emit_sexpr(&mut body, se, ty, ctx);
            em.push_text("    let ");
            em.push_text(vname);
            if vt == EL_TY_STR() {
                em.push_text(": str = ");
            } else if vt == EL_TY_BOOL() {
                em.push_text(": bool = ");
            } else {
                em.push_text(": i64 = ");
            }
            em.push_text(string_as_str(&body));
            em.push_text(";\n");
            return next_word(&s.next);
        }
        TStmt::If(i) => {
            // {% if expr %} then [ {% else %} alt ] {% endif %}
            // The condition is coerced to a `bool` by jinja truthiness rules
            // (`emit_truthy`): a bool stays bare, an i64 becomes `!= 0`, a str
            // becomes non-empty. `elif` is desugared at PARSE time into a nested
            // TIf in the else-body (so the walk here is uniform).
            let mut cond: String = String::new();
            let se: SExpr = i.expr_expr();
            emit_truthy(&mut cond, se, ty, ctx);
            em.push_text("    if (");
            em.push_text(string_as_str(&cond));
            em.push_text(") {\n");
            emit_stmts(em, body_word(&i.body), ty, vtys, ctx, depth + 1i64);
            let altw: i64 = alt_word(&i.alt);
            if altw != 0i64 {
                em.push_text("    } else {\n");
                emit_stmts(em, altw, ty, vtys, ctx, depth + 1i64);
            }
            em.push_text("    }\n");
            return next_word(&i.next);
        }
        TStmt::For(f) => {
            // {% for v in expr %} body {% endfor %} → indexed while-loop.
            let vname: str = f.var;
            let mut iter: String = String::new();
            let se: SExpr = f.expr_expr();
            emit_sexpr(&mut iter, se, ty, ctx);
            let iter_s: str = string_as_str(&iter);
            em.push_text("    let mut __i");
            em.push_num(depth as u64);
            em.push_text(": i64 = 0i64;\n");
            em.push_text("    while __i");
            em.push_num(depth as u64);
            em.push_text(" < (");
            em.push_text(iter_s);
            em.push_text(").len() {\n");
            // Element type of the loop var: the declared `with` type if any,
            // else the i64 default (queue-1 numeric baseline).
            let vty: str = vtys.ty_name(f.var);
            em.push_text("        let ");
            em.push_text(vname);
            em.push_text(": ");
            if vty.len() > 0i64 { em.push_text(vty); } else { em.push_text("i64"); }
            em.push_text(" = (");
            em.push_text(iter_s);
            em.push_text(")[__i");
            em.push_num(depth as u64);
            em.push_text("];\n");
            emit_stmts(em, body_word(&f.body), ty, vtys, ctx, depth + 1i64);
            em.push_text("        __i");
            em.push_num(depth as u64);
            em.push_text(" = __i");
            em.push_num(depth as u64);
            em.push_text(" + 1i64;\n");
            em.push_text("    }\n");
            return next_word(&f.next);
        }
    }
}

// Edge-word readers (launder WRef<TStmt> → raw chain word, no borrow carried).
fn next_word(r: &WRef<TStmt>) -> i64 { return r.any().raw(); }
fn body_word(r: &WRef<TStmt>) -> i64 { return r.any().raw(); }
fn alt_word(r: &WRef<TStmt>)  -> i64 { return r.any().raw(); }

// ── The resource handler ───────────────────────────────────────────────────
#[token_macro]
pub fn trama(name: str, s: str) -> ItemList {
    let out: ItemList = item_list_new();

    if name.len() == 0i64 {
        error("trama!: needs a binding name — write `resource <name> = trama!{ data … \"template\" }`");
        return out;
    }
    // The generated render-fn NAME is the `resource <name> =` binding (ADR 0012
    // §6), NOT an `fn <name>` line inside the block; the block body starts at `data`.
    let fn_name: str = name;

    let mut lx: TLexer = TLexer { src: s, pos: 0i64, len: s.len() };

    // data <ctx>:<CtxTy>
    if !lx.eat_kw("data") { error("trama!: expected `data <ctx>:<CtxTy>`"); return out; }
    let ctx_name: str = lx.scan_ident_str();
    lx.skip_ws();
    if lx.cur() != 58u8 { error("trama!: expected `:` after data name"); return out; }  // ':'
    lx.bump();
    let ctx_ty: str = lx.scan_ident_str();

    // optional `with <name>:<ty> (, <name>:<ty>)*` — DECLARED value types for
    // the template's loop/set vars + fields (the static type seam: chooses
    // str/bool/i64 rendering + the loop-var binding's element type). Collected
    // as (name,ty) slice pairs over the surface text `s`; applied AFTER the
    // template parse (so the vars/fields are interned).
    let mut dn: i64 = 0i64;
    let mut d_name_start: [i64; 32] = [0i64; 32];
    let mut d_name_len:   [i64; 32] = [0i64; 32];
    let mut d_ty_start:   [i64; 32] = [0i64; 32];
    let mut d_ty_len:     [i64; 32] = [0i64; 32];
    if lx.eat_kw("with") {
        loop {
            lx.skip_ws();
            let ns: i64 = lx.pos;
            let nl: i64 = lx.scan_ident();
            if nl == 0i64 { error("trama!: `with` expects <name>:<type>"); return out; }
            lx.skip_ws();
            if lx.cur() != 58u8 { error("trama!: `with` expects `:` after name"); return out; }  // ':'
            lx.bump();
            lx.skip_ws();
            let ts: i64 = lx.pos;
            let tl: i64 = lx.scan_type();
            if tl == 0i64 { error("trama!: `with` expects a type name"); return out; }
            if dn < 32i64 {
                d_name_start[dn] = ns; d_name_len[dn] = nl;
                d_ty_start[dn] = ts;   d_ty_len[dn] = tl;
                dn = dn + 1i64;
            }
            lx.skip_ws();
            if lx.cur() == 44u8 { lx.bump(); continue; }  // ','
            break;
        }
    }

    // " template "
    let tmpl: str = lx.scan_template();
    if tmpl.len() == 0i64 { error("trama!: empty or missing \"template\""); return out; }

    // ── Parse the template → Trama AST via the GENERATED parser ──────────
    // `parse_tpl` yields the `tpl` as a WArray of per-statement TStmt handles
    // (bodies are likewise WArray edges); the T3 post-pass `chain_array` stitches
    // the `next`-linked chain the renderer walks (elif is already grammar-desugared
    // into nested TIf). The self-describing IR carries every name (Option B), so
    // no parser side tables are needed — the type dict is built from reflection +
    // `with`, exactly like the `wql!` handler.
    let h: Writ = writ_new(4096i64);
    let tpl_any: WAny = parse_tpl(tmpl, &h);
    if !tpl_any.is_array() { error("trama!: malformed template"); return out; }
    let tpl_arr: &WArray<WAny> = tpl_any.as_array();
    let head_word: i64 = chain_array(tpl_arr);
    if head_word == 0i64 { error("trama!: empty template"); return out; }

    // Build the name→value-type dict. Reflect the DATA-CONTEXT schema (`ctx_ty`) so
    // `{{ c.name }}` / `{% if c.flag %}` type correctly from the struct WITHOUT a
    // `with` clause (unknown context type ⇒ silent no-op); `with` overrides below.
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, ctx_ty);

    // Apply the `with` type declarations. Each `<name>:<Ty>` seeds the value-type
    // lattice (str/bool/int) in the dict AND records the loop/set var's Logos type
    // name for its binding. Type-name slices live in `s`.
    let mut vtys: TVarTys = tvartys_new();
    let mut di: i64 = 0i64;
    while di < dn {
        let nm: str = unsafe { tl_str_range(s, d_name_start[di], d_name_len[di]) };
        let tn: str = unsafe { tl_str_range(s, d_ty_start[di], d_ty_len[di]) };
        ty.set_ty(nm, el_ty_of_name(tn));
        vtys.declare(nm, tn);
        di = di + 1i64;
    }

    // ── Emit the render function ──────────────────────────────────────────
    let mut em: Emitter = Emitter::new();
    em.emit_into("test");
    em.push_text("pub fn ");
    em.push_text(fn_name);
    em.push_text("(");
    em.push_text(ctx_name);
    em.push_text(": &");
    em.push_text(ctx_ty);
    em.push_text(") -> String {\n");
    em.push_text("    let mut __out: String = String::new();\n");
    emit_stmts(&mut em, head_word, &ty, &vtys, ctx_name, 0i64);
    em.push_text("    return __out;\n");
    em.push_text("}\n");
    em.commit();

    return out;
}
