// logos.std.wql.codegen — the shared STATIC-backend codegen helper: walk the
// SExpr Writ-schema IR and emit a Logos expression as source text (ADR 0012
// §10.2 — "metacall walks the schema'd IR → source"). Used by BOTH resource
// frontends: `wql!` (where/select clauses) and `trama!` (`{{ … }}` / `{% if %}`
// / `{% for in %}` embedded expressions). One lowering, two consumers.
//
// SELF-DESCRIBING IR (ADR 0012 peg-frontend §5, Option B): the codegen reads
// field/param/var NAMES directly off the IR nodes (`f.name`, `pp.name`,
// `c.fn_name`, …) — NOT from an `ElParser` dense side table. Value-TYPES come
// from a name→type dictionary (`ElTypes`) the handler builds from schema
// reflection + the `wql!(…)`/`trama!(…)` parameter list. So the codegen depends
// only on the IR + a type dict, never on the parser — which is what makes a
// peg-generated parser a drop-in producer of the same IR.
package logos.std.wql.codegen;

use logos.std.compiler.metaprog;  // Emitter, OView — begin_chunk
use logos.lang.writ.anyval;
use logos.lang.writ.wstring;   // WAny::as_wstr (string-literal payloads)
use logos.std.wql.ir;
use logos.std.wql.el;          // ElTypes, EL_TY_*, OP_*
use logos.mem.string;
use logos.lang.str;
// The join-strategy containers the emitted chunks `use` (hashmap / set /
// btree). A CHUNK can only import modules already in the compile's transitive
// load closure — the module loader follows `use`-deps from the ENTRY file, and
// late-appended metaprog chunks cannot pull new archives. Importing them HERE
// (begin_chunk's owner) guarantees every wql!-consuming compile has them
// loaded. hashmap is also a real dependency of the generated parsers; set and
// btree exist in emitted text only.
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.btree;

// ── Chunk prologue (shared by all wql!/trama! emitters) ───────────────────
// A generated-code chunk is a SEPARATE AST doc: it does NOT inherit the
// trigger module's `use` list, and when the CONSUMER is the stdlib itself
// (in-package macro use — no implicit prelude there) unqualified `String`/
// `Vec` would not resolve at all. So every chunk carries its own imports,
// the same convention the metacall thunk chunks follow. Package = the
// TRIGGER module's (emit_target_pkg), so the generated fn lands next to
// its callsite and sees the trigger package's types (row schemas etc.).
pub fn begin_chunk(em: &mut Emitter, view: &OView) {
    em.emit_target_pkg(view);
    // logos.lang.option covers the single-row query modes (`select first` /
    // `find` return Option<E> / Option<&Row>). hashmap/set/btree cover the
    // join-strategy tiers (hash join buckets / anti-join key sets / tree join)
    // — a chunk is a SEPARATE AST and needs its own use-decls.
    em.push_text("use logos.mem.string; use logos.mem.collections.vec; use logos.lang.option; ");
    em.push_text("use logos.mem.collections.hashmap; use logos.mem.collections.set; use logos.mem.collections.btree; ");
}

// ── Builtin function registry (CEL canon + common Trama filters) ──────────
// `SCall.fn_name` carries the call NAME directly (self-describing IR); we map it
// to one of these builtin ids. The id table is small + stable; unknown names
// latch an error in the caller.
//
// Each builtin lowers to a fully-qualified stdlib call (qualified-path form, so
// the generated function compiles regardless of the user module's `use`s):
//   len(s)            → ((s).len())                                  : INT
//   upper(s)          → logos.std.wql.codegen::wql_upper(s)          : STR
//   lower(s)          → logos.std.wql.codegen::wql_lower(s)          : STR
//   contains(s,n)     → logos.lang.str::str_contains((s),(n))        : BOOL
//   starts_with(s,p)  → logos.lang.str::str_starts_with((s),(p))     : BOOL
pub fn BFN_UNKNOWN()     -> i32 { return 0i32; }
pub fn BFN_LEN()         -> i32 { return 1i32; }
pub fn BFN_UPPER()       -> i32 { return 2i32; }
pub fn BFN_LOWER()       -> i32 { return 3i32; }
pub fn BFN_CONTAINS()    -> i32 { return 4i32; }
pub fn BFN_STARTS_WITH() -> i32 { return 5i32; }

// Resolve a call name → builtin id (BFN_*). Unknown ⇒ BFN_UNKNOWN.
pub fn builtin_of_name(name: str) -> i32 {
    if str_eq(name, "len")         { return BFN_LEN(); }
    if str_eq(name, "upper")       { return BFN_UPPER(); }
    if str_eq(name, "lower")       { return BFN_LOWER(); }
    if str_eq(name, "contains")    { return BFN_CONTAINS(); }
    if str_eq(name, "starts_with") { return BFN_STARTS_WITH(); }
    return BFN_UNKNOWN();
}

// The arity each builtin expects (used to validate the materialized arg list).
pub fn builtin_arity(bfn: i32) -> i64 {
    if bfn == BFN_LEN() || bfn == BFN_UPPER() || bfn == BFN_LOWER() { return 1i64; }
    if bfn == BFN_CONTAINS() || bfn == BFN_STARTS_WITH()           { return 2i64; }
    return 0i64;
}

// The EL value-type a builtin RETURNS (drives push_str vs push_i64 + result ty).
pub fn builtin_ret_ty(bfn: i32) -> i32 {
    if bfn == BFN_LEN()         { return EL_TY_INT(); }
    if bfn == BFN_UPPER()       { return EL_TY_STR(); }
    if bfn == BFN_LOWER()       { return EL_TY_STR(); }
    if bfn == BFN_CONTAINS()    { return EL_TY_BOOL(); }
    if bfn == BFN_STARTS_WITH() { return EL_TY_BOOL(); }
    return EL_TY_INT();
}

// ASCII upper/lowercase a `str` into a fresh `String` (the `upper`/`lower`
// builtins). Byte-wise, UTF-8-agnostic (ASCII-only case folding — the CEL
// string fns are byte oriented in the MVP). Returned by value (owns its buffer).
pub fn wql_upper(s: str) -> String {
    let mut out: String = String::new();
    let n: i64 = s.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        let u: u8 = if c >= 97u8 && c <= 122u8 { c - 32u8 } else { c };
        out.push_u8(u);
        i = i + 1i64;
    }
    return out;
}
pub fn wql_lower(s: str) -> String {
    let mut out: String = String::new();
    let n: i64 = s.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        let l: u8 = if c >= 65u8 && c <= 90u8 { c + 32u8 } else { c };
        out.push_u8(l);
        i = i + 1i64;
    }
    return out;
}

// ── Value-type inference (codegen type detection) ─────────────────────────
// Compute the EL value-type (EL_TY_*) of an SExpr, the signal the static
// backend uses to choose `push_str` vs `push_i64`, emit a string literal, and
// route the row/projection element type. Sources of type:
//   • SLit          — the WAny payload (string / bool / float / int);
//   • SParam / field — the type DICTIONARY (`ElTypes`, params + reflection);
//   • SBin           — compare/logical ⇒ BOOL; `+` with a STR operand ⇒ STR
//                      (string concatenation); arithmetic with a FLT operand ⇒
//                      FLT (INT promotes to FLT), else INT;
//   • SUn            — `!` ⇒ BOOL, `-` ⇒ the argument's numeric type (FLT/INT);
//   • SCond          — the then-branch's type (both arms agree under strict typing).
// Unknown / out-of-MVP nodes default to INT.
pub fn infer_ty(e: SExpr, t: &ElTypes) -> i32 {
    match e {
        SExpr::Lit(l) => {
            let v: WAny = l.val;
            if v.is_string() { return EL_TY_STR(); }
            if v.is_bool()   { return EL_TY_BOOL(); }
            if v.is_float()  { return EL_TY_FLT(); }
            return EL_TY_INT();
        }
        SExpr::Param(pp) => { return t.ty_of(pp.name); }
        SExpr::Var(vv)   => { return t.ty_of(vv.name); }
        SExpr::Field(f)  => {
            // Rel-sourced column (`s.a` over a rel-bound var): the (var, col)
            // pair types off the rel-binding table — precise per-var (the flat
            // name dict can collide across same-named struct fields).
            let base_ref: WRef<SExpr> = f.base;
            if !base_ref.any().is_null() {
                let rn: str = root_ident_name(f.base_expr());
                if rn.len() > 0i64 {
                    let rt: i32 = t.rel_col_ty(rn, f.name);
                    if rt >= 0i32 { return rt; }
                }
            }
            return t.ty_of(f.name);
        }
        SExpr::Bin(b) => {
            let op: i32 = b.op;
            if op == OP_OR() || op == OP_AND()
               || op == OP_EQ() || op == OP_NE()
               || op == OP_LT() || op == OP_LE()
               || op == OP_GT() || op == OP_GE() { return EL_TY_BOOL(); }
            let lt: i32 = infer_ty(b.lhs_expr(), t);
            let rt: i32 = infer_ty(b.rhs_expr(), t);
            if op == OP_ADD() {
                if lt == EL_TY_STR() || rt == EL_TY_STR() { return EL_TY_STR(); }
            }
            // Arithmetic (+ - * / %) with a FLT operand promotes to FLT.
            if lt == EL_TY_FLT() || rt == EL_TY_FLT() { return EL_TY_FLT(); }
            return EL_TY_INT();
        }
        SExpr::Un(u) => {
            if u.op == OP_NOT() { return EL_TY_BOOL(); }
            // Unary minus keeps the argument's numeric type (FLT stays FLT).
            if infer_ty(u.arg_expr(), t) == EL_TY_FLT() { return EL_TY_FLT(); }
            return EL_TY_INT();
        }
        SExpr::Cond(c) => { return infer_ty(c.then_expr(), t); }
        SExpr::Call(c) => {
            let bfn: i32 = builtin_of_name(c.fn_name);
            if bfn != BFN_UNKNOWN() { return builtin_ret_ty(bfn); }
            // Non-builtin → the reflected UDF table (builtins shadow UDFs).
            let ui: i64 = t.udf_find(c.fn_name);
            if ui >= 0i64 {
                let r: i32 = t.udf_ret[ui];
                if r >= 0i32 { return r; }
            }
            return EL_TY_INT();
        }
        SExpr::Comp(_) => { return EL_TY_INT(); }   // list value (element ty = INT in the scalar lattice)
        SExpr::Tuple(_) => { return EL_TY_INT(); }  // OUT of the scalar lattice — projection paths
                                                    // special-case tuples via tuple_ty_text BEFORE
                                                    // consulting the EL_TY_* tag (never meaningful here)
        _ => { return EL_TY_INT(); }
    }
}

// The bare-identifier ROOT name of `e` — the name when `e` is a root-shaped
// leaf (a null-base SField — the EL parser's bare-ident node — or an SVar /
// SParam), "" otherwise. The rel-binding lookups key off this (a rel row var
// is always a direct scan binding, never a nested path).
pub fn root_ident_name(e: SExpr) -> str {
    match e {
        SExpr::Field(f) => {
            let br: WRef<SExpr> = f.base;
            if br.any().is_null() { return f.name; }
            return "";
        }
        SExpr::Var(v)   => { return v.name; }
        SExpr::Param(p) => { return p.name; }
        _ => { return ""; }
    }
}

// ── Tuple projections (`select (a, b, …)`) ─────────────────────────────────
// True iff `e`'s ROOT is a tuple expression — the multi-column projection form.
// A tuple is only meaningful as the `select` body; every other clause site
// rejects it via `reject_tuple`.
pub fn is_tuple_root(e: SExpr) -> bool {
    match e {
        SExpr::Tuple(_) => { return true; }
        _ => { return false; }
    }
}

// Diagnose a tuple expression at a NON-select clause site (`where`, `on`,
// `group by`, `having`, `order by`, aggregate args, `find`, trama contexts).
// Returns false + surfaces the error when `e` is tuple-rooted.
pub fn reject_tuple(e: SExpr, ctx: str) -> bool {
    if !is_tuple_root(e) { return true; }
    let mut m: String = String::new();
    m.push_str(ctx);
    m.push_str(": a tuple expression `(a, b, …)` is only supported as the `select` projection");
    error(string_as_str(&m));
    return false;
}

// Append the NATIVE Logos tuple TYPE text `(T1, T2, …)` of a tuple projection:
// per-component EL lattice type name, with the owned-String promotion for
// String-returning calls (a borrowed `str` view of the call's temporary would
// dangle) and recursion for nested tuples.
pub fn push_tuple_ty(out: &mut String, tp: STuple, t: &ElTypes) {
    let items: SExprArr = tp.items_arr();
    let n: i64 = items.len();
    out.push_str("(");
    let mut i: i64 = 0i64;
    while i < n {
        if i > 0i64 { out.push_str(", "); }
        let c: SExpr = items.arg_at(i);
        match c {
            SExpr::Tuple(nt) => { push_tuple_ty(out, nt, t); }
            _ => {
                if returns_string(c, t) { out.push_str("String"); }
                else { out.push_str(el_ty_name(infer_ty(c, t))); }
            }
        }
        i = i + 1i64;
    }
    out.push_str(")");
}

// True iff ANY component of the tuple projection is FLT-typed (f64) — tuple
// structural `==` routes through `variadic__eq`, which requires `Eq`; f64 is
// PartialEq only, so `distinct` over such a tuple is diagnosed (probe-verified).
pub fn tuple_has_flt(tp: STuple, t: &ElTypes) -> bool {
    let items: SExprArr = tp.items_arr();
    let n: i64 = items.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: SExpr = items.arg_at(i);
        match c {
            SExpr::Tuple(nt) => { if tuple_has_flt(nt, t) { return true; } }
            _ => { if infer_ty(c, t) == EL_TY_FLT() { return true; } }
        }
        i = i + 1i64;
    }
    return false;
}

// Walk the SExpr schema'd IR (`match` over the family enum), emitting a Logos
// expression into `out`:
//   • SLit (int/bool)            → the literal verbatim;
//   • SParam                     → the generated-fn argument name (node's name);
//   • a bare field-root (SField, base = null) → the field/loop-var NAME (the
//     row var, a `for` var, or a context field — resolved at the call site);
//   • a field STEP (SField, base ≠ null)      → `<base>.<name>`;
//   • SBin / SUn                 → parenthesised operator application.
// `t` is the type dictionary; `var` is a fallback name for a comprehension SVar.
pub fn emit_sexpr(out: &mut String, e: SExpr, t: &ElTypes, var: str) {
    match e {
        SExpr::Lit(l) => {
            let v: WAny = l.val;
            if v.is_string() {
                // A boxed WString literal → a Logos string literal "…" (escaped).
                out.push_str("\"");
                emit_str_escaped(out, v.as_wstr());
                out.push_str("\"");
            } else if v.is_bool() {
                if v.as_bool() { out.push_str("true"); } else { out.push_str("false"); }
            } else if v.is_float() {
                // A float literal → a Logos f64 literal (`2.5f64`): the shortest
                // round-trip decimal, forced to carry a `.` so it parses as float.
                push_f64_lit(out, v.as_f64());
            } else {
                out.push_i64(v.as_i64());
                out.push_str("i64");
            }
        }
        SExpr::Param(pp) => {
            out.push_str(pp.name);
        }
        SExpr::Var(vv) => {
            // A comprehension-bound row variable: emit its own name, falling back
            // to the caller's `var` (the wql!/trama! row/loop binding) if empty.
            let nm: str = vv.name;
            if nm.len() > 0i64 { out.push_str(nm); } else { out.push_str(var); }
        }
        SExpr::Field(f) => {
            let name: str = f.name;
            let base_ref: WRef<SExpr> = f.base;
            let base: WAny = base_ref.any();
            let is_root: bool = base.is_null();
            if is_root {
                out.push_str(name);
            } else {
                let be: SExpr = f.base_expr();
                // Rel-sourced column: `s.a` over a rel-bound row var emits the
                // POSITIONAL tuple access `s.0` (the rel row is a native tuple;
                // the column map lives in the ElTypes rel-binding table). A
                // 1-COLUMN rel stores SCALAR rows — its (only) column reads the
                // whole row through the binding: `(*s)`.
                let rn: str = root_ident_name(be);
                if rn.len() > 0i64 {
                    if t.rel_col_ty(rn, name) >= 0i32 {
                        let k: i64 = t.rel_col_of(rn, name);
                        if k >= 0i64 {
                            out.push_str(rn);
                            out.push_str(".");
                            out.push_i64(k);
                        } else {
                            out.push_str("(*");
                            out.push_str(rn);
                            out.push_str(")");
                        }
                        return;
                    }
                }
                emit_sexpr(out, be, t, var);
                out.push_str(".");
                out.push_str(name);
            }
        }
        SExpr::Bin(b) => {
            let op: i32 = b.op;
            let lhs: SExpr = b.lhs_expr();
            let rhs: SExpr = b.rhs_expr();
            // INT→FLT promotion: Logos has NO implicit int→float, so when one
            // operand is FLT and the other INT (arithmetic OR comparison), the
            // INT side gets an explicit `as f64` cast so the emitted source
            // type-checks. Logical ops never mix (both sides BOOL).
            let lt: i32 = infer_ty(lhs, t);
            let rt: i32 = infer_ty(rhs, t);
            let cast_l: bool = lt == EL_TY_INT() && rt == EL_TY_FLT();
            let cast_r: bool = rt == EL_TY_INT() && lt == EL_TY_FLT();
            out.push_str("(");
            if cast_l { out.push_str("(("); }
            emit_sexpr(out, lhs, t, var);
            if cast_l { out.push_str(") as f64)"); }
            out.push_str(emit_binop(op));
            if cast_r { out.push_str("(("); }
            emit_sexpr(out, rhs, t, var);
            if cast_r { out.push_str(") as f64)"); }
            out.push_str(")");
        }
        SExpr::Un(u) => {
            let op: i32 = u.op;
            let arg: SExpr = u.arg_expr();
            out.push_str("(");
            if op == OP_NOT() { out.push_str("!"); } else { out.push_str("-"); }
            emit_sexpr(out, arg, t, var);
            out.push_str(")");
        }
        SExpr::Call(c) => { emit_call(out, c, t, var); }
        SExpr::Cond(c) => {
            // ternary `cond ? then : else` → Logos `if` EXPRESSION.
            out.push_str("(if (");
            emit_sexpr(out, c.cond_expr(), t, var);
            out.push_str(") { ");
            emit_sexpr(out, c.then_expr(), t, var);
            out.push_str(" } else { ");
            emit_sexpr(out, c.else_expr(), t, var);
            out.push_str(" })");
        }
        SExpr::Comp(cp) => { emit_comp(out, cp, t, var); }
        SExpr::Tuple(tp) => {
            // Native tuple literal `(c0, c1, …)` — the multi-column projection.
            let items: SExprArr = tp.items_arr();
            let n: i64 = items.len();
            out.push_str("(");
            let mut i: i64 = 0i64;
            while i < n {
                if i > 0i64 { out.push_str(", "); }
                emit_sexpr(out, items.arg_at(i), t, var);
                i = i + 1i64;
            }
            out.push_str(")");
        }
        _ => {
            out.push_str("0i64");
        }
    }
}

// Emit a builtin call. `c` is the SCall; the call NAME is read off the node
// (`c.fn_name`) and mapped to a builtin id (`builtin_of_name`). Each builtin
// emits a fully-qualified stdlib call over its materialized args (`SExprArr`).
// An unknown name or wrong arity emits a `0i64` placeholder (the wql!/trama!
// handler reports the error at the block site via `call_diagnostic`).
pub fn emit_call(out: &mut String, c: SCall, t: &ElTypes, var: str) {
    let name: str = c.fn_name;
    let bfn: i32 = builtin_of_name(name);
    let args: SExprArr = c.args_arr();
    let argc: i64 = args.len();
    if bfn == BFN_UNKNOWN() {
        // Not a builtin → a UDF candidate (the reflected user-fn table).
        emit_udf_call(out, name, args, argc, t, var);
        return;
    }
    if argc != builtin_arity(bfn) {
        out.push_str("0i64");
        return;
    }
    if bfn == BFN_LEN() {
        out.push_str("((");
        emit_sexpr(out, args.arg_at(0i64), t, var);
        out.push_str(").len())");
        return;
    }
    if bfn == BFN_UPPER() || bfn == BFN_LOWER() {
        if bfn == BFN_UPPER() { out.push_str("logos.std.wql.codegen::wql_upper("); }
        else                  { out.push_str("logos.std.wql.codegen::wql_lower("); }
        emit_sexpr(out, args.arg_at(0i64), t, var);
        out.push_str(")");
        return;
    }
    // contains / starts_with : two str args → bool.
    if bfn == BFN_CONTAINS() { out.push_str("logos.lang.str::str_contains("); }
    else                     { out.push_str("logos.lang.str::str_starts_with("); }
    out.push_str("(");
    emit_sexpr(out, args.arg_at(0i64), t, var);
    out.push_str("), (");
    emit_sexpr(out, args.arg_at(1i64), t, var);
    out.push_str("))");
}

// Emit a USER-FUNCTION call as a PLAIN call `name(<args>)` — the generated
// chunk lives in the trigger module's package, so the name resolves naturally
// against the module's own top-level fns; NON-pub fns work too (verified: the
// spliced chunk shares the trigger package's visibility scope), so no `pub`
// gate is imposed on the reflection lookup. UDF ground rules:
//   • BUILTINS take precedence over a same-named user fn (lookup order);
//   • only ARITY + return type are checked at metacall time — PARAM types are
//     NOT deep-checked here: the emitted chunk is compiled by the real
//     compiler, so an argument-type mismatch still fails the build (with the
//     compiler's own arg-type diagnostic against the generated call);
//   • only the TRIGGER module's top-level fns are visible (oview_module_ast
//     scope) — imported fns diagnose as unknown (documented MVP limit).
// Two return-normalization casts keep the emitted expression in the EL
// lattice baseline (the surrounding expression / result Vec is typed
// i64 / f64):
//   • an INT-family return NARROWER than i64 (i32/u32/…): `((f(x)) as i64)`
//     (u64/u128/i128 values beyond i64 TRUNCATE — documented MVP semantics);
//   • an `f32` return:                                    `((f(x)) as f64)`.
// str / bool / String / f64 / i64 returns emit bare. Unknown names, arity
// mismatches, and out-of-lattice returns emit the safe `0i64` placeholder —
// the handler surfaces the REAL diagnostic via `check_calls` beforehand.
fn emit_udf_call(out: &mut String, name: str, args: SExprArr, argc: i64,
                 t: &ElTypes, var: str) {
    let ui: i64 = t.udf_find(name);
    if ui < 0i64 || argc != t.udf_arity[ui] || t.udf_ret[ui] < 0i32 {
        out.push_str("0i64");
        return;
    }
    let rn: str = t.udf_rets[ui];
    let mut cast: str = "";
    if t.udf_ret[ui] == EL_TY_INT() && !str_eq(rn, "i64") { cast = " as i64)"; }
    if t.udf_ret[ui] == EL_TY_FLT() && str_eq(rn, "f32")  { cast = " as f64)"; }
    if cast.len() > 0i64 { out.push_str("(("); }
    out.push_str(name);
    out.push_str("(");
    let mut i: i64 = 0i64;
    while i < argc {
        if i > 0i64 { out.push_str(", "); }
        emit_sexpr(out, args.arg_at(i), t, var);
        i = i + 1i64;
    }
    out.push_str(")");
    if cast.len() > 0i64 {
        out.push_str(")");
        out.push_str(cast);
    }
}

// True iff `e` is (or contains at its root) a call to an unknown function or one
// with the wrong arity — the wql!/trama! handlers use this to surface a compile
// error at the block site (the codegen itself emits a safe `0i64` placeholder).
// UDF-aware: a non-builtin name resolving in the reflected user-fn table with
// matching arity and an in-lattice return is NOT diagnostic. Prefer
// `check_calls` at handler level — it names the offending fn in the error.
pub fn call_diagnostic(e: SExpr, t: &ElTypes) -> bool {
    match e {
        SExpr::Call(c) => {
            let bfn: i32 = builtin_of_name(c.fn_name);
            let args: SExprArr = c.args_arr();
            if bfn == BFN_UNKNOWN() {
                let ui: i64 = t.udf_find(c.fn_name);
                if ui < 0i64 { return true; }
                if args.len() != t.udf_arity[ui] { return true; }
                if t.udf_ret[ui] < 0i32 { return true; }
            } else {
                if args.len() != builtin_arity(bfn) { return true; }
            }
            let mut i: i64 = 0i64;
            while i < args.len() {
                if call_diagnostic(args.arg_at(i), t) { return true; }
                i = i + 1i64;
            }
            return false;
        }
        SExpr::Bin(b)  => { return call_diagnostic(b.lhs_expr(), t) || call_diagnostic(b.rhs_expr(), t); }
        SExpr::Un(u)   => { return call_diagnostic(u.arg_expr(), t); }
        SExpr::Cond(c) => {
            return call_diagnostic(c.cond_expr(), t)
                || call_diagnostic(c.then_expr(), t)
                || call_diagnostic(c.else_expr(), t);
        }
        SExpr::Comp(cp) => { return call_diagnostic(cp.head_expr(), t); }
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let mut i: i64 = 0i64;
            while i < items.len() {
                if call_diagnostic(items.arg_at(i), t) { return true; }
                i = i + 1i64;
            }
            return false;
        }
        _ => { return false; }
    }
}

// Validate every call in `e` and surface a NAMED diagnostic on the first
// offense (unknown fn / wrong arity / out-of-lattice UDF return). `ctx`
// prefixes the message with the macro + clause site (e.g. "wql!: `where`").
// Returns false when an error was reported (the handler aborts emission).
// The message spells the UDF ground rules: builtin list, the declared-in-the-
// trigger-module requirement (imported fns are outside `oview_module_ast`'s
// reach), and — on arity — the expected/got counts.
pub fn check_calls(e: SExpr, t: &ElTypes, ctx: str) -> bool {
    match e {
        SExpr::Call(c) => {
            let name: str = c.fn_name;
            let bfn: i32 = builtin_of_name(name);
            let args: SExprArr = c.args_arr();
            let argc: i64 = args.len();
            if bfn == BFN_UNKNOWN() {
                let ui: i64 = t.udf_find(name);
                if ui < 0i64 {
                    let mut m: String = String::new();
                    m.push_str(ctx);
                    m.push_str(": unknown function '");
                    m.push_str(name);
                    m.push_str("' — EL builtins are len/upper/lower/contains/starts_with; a user function must be a top-level fn declared in the module containing the query (imported fns are not visible to reflection)");
                    error(string_as_str(&m));
                    return false;
                }
                if argc != t.udf_arity[ui] {
                    let mut m2: String = String::new();
                    m2.push_str(ctx);
                    m2.push_str(": function '");
                    m2.push_str(name);
                    m2.push_str("' expects ");
                    m2.push_i64(t.udf_arity[ui]);
                    m2.push_str(" argument(s), got ");
                    m2.push_i64(argc);
                    error(string_as_str(&m2));
                    return false;
                }
                if t.udf_ret[ui] < 0i32 {
                    let mut m3: String = String::new();
                    m3.push_str(ctx);
                    m3.push_str(": user function '");
                    m3.push_str(name);
                    m3.push_str("' returns `");
                    m3.push_str(t.udf_rets[ui]);
                    m3.push_str("` — an EL-callable fn must return an integer, f64/f32, bool, str, or String value");
                    error(string_as_str(&m3));
                    return false;
                }
            } else {
                if argc != builtin_arity(bfn) {
                    let mut m4: String = String::new();
                    m4.push_str(ctx);
                    m4.push_str(": builtin '");
                    m4.push_str(name);
                    m4.push_str("' expects ");
                    m4.push_i64(builtin_arity(bfn));
                    m4.push_str(" argument(s), got ");
                    m4.push_i64(argc);
                    error(string_as_str(&m4));
                    return false;
                }
            }
            let mut i: i64 = 0i64;
            while i < argc {
                if !check_calls(args.arg_at(i), t, ctx) { return false; }
                i = i + 1i64;
            }
            return true;
        }
        SExpr::Bin(b)  => { return check_calls(b.lhs_expr(), t, ctx) && check_calls(b.rhs_expr(), t, ctx); }
        SExpr::Un(u)   => { return check_calls(u.arg_expr(), t, ctx); }
        SExpr::Cond(c) => {
            return check_calls(c.cond_expr(), t, ctx)
                && check_calls(c.then_expr(), t, ctx)
                && check_calls(c.else_expr(), t, ctx);
        }
        SExpr::Comp(cp) => { return check_calls(cp.head_expr(), t, ctx); }
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let mut i: i64 = 0i64;
            while i < items.len() {
                if !check_calls(items.arg_at(i), t, ctx) { return false; }
                i = i + 1i64;
            }
            return true;
        }
        _ => { return true; }
    }
}

// Map an EL value-type tag → the Logos type NAME for an emitted binding /
// Vec element (str → `str`, bool → `bool`, flt → `f64`, else the i64 baseline).
pub fn el_ty_name(ty: i32) -> str {
    if ty == EL_TY_STR()  { return "str"; }
    if ty == EL_TY_BOOL() { return "bool"; }
    if ty == EL_TY_FLT()  { return "f64"; }
    return "i64";
}

// ── f64 formatting (shared by literal emission + the render value path) ─────
// Deterministic f64 → decimal text via the stdlib's `%g` bridge (`f64
// ::to_string`, `logos_fmt_f64_g` — shortest round-trippable form, Rust-Display
// convention). Runtime helper the generated render code calls (qualified).
pub fn wql_f64_to_str(x: f64) -> String {
    return x.to_string();
}

// Append `v` as a LOGOS f64 LITERAL (`2.5f64`): the shortest round-trip decimal
// (%g), forced to carry a `.0` when it prints as a bare integer (e.g. `2` →
// `2.0`) so the emitted token is unambiguously float-shaped, plus the `f64`
// suffix. `%g` may print an exponent form (`1e+20`) — a valid Logos float
// literal shape as well.
fn push_f64_lit(out: &mut String, v: f64) {
    let s: String = v.to_string();
    let sv: str = string_as_str(&s);
    out.push_str(sv);
    // Bare-integer print (no '.', no exponent) → force the decimal point.
    let n: i64 = sv.len();
    let mut has_mark: bool = false;
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(sv, i);
        if c == 46u8 || c == 101u8 || c == 69u8 || c == 110u8 { has_mark = true; }  // . e E n(an/inf)
        i = i + 1i64;
    }
    if !has_mark { out.push_str(".0"); }
    out.push_str("f64");
}

// Emit a comprehension `[head for v in src (if guard)?]` as a Logos BLOCK
// EXPRESSION yielding a `Vec<HeadTy>` (ADR 0012 §10.4 — a Source-driven loop
// collecting into a Vec, NOT the stdlib list-comprehension desugar). The plan is
// `RScan(src)` or `RFilter(RScan(src), guard)`; the source resolves to a `&[_]`
// parameter (its name off the RScan). The loop var binds each element by value;
// `head`/`guard` reference it via bare field-roots (emitted by name).
//
//   ({ let mut __cv: Vec<T> = Vec::<T>::new();
//      let mut __ci: i64 = 0i64;
//      while __ci < (SRC).len() {
//          let V = (SRC)[__ci];
//          if GUARD { __cv.push(HEAD); }     // guard omitted when absent
//          __ci = __ci + 1i64;
//      }
//      __cv })
pub fn emit_comp(out: &mut String, cp: SComp, t: &ElTypes, var: str) {
    let head: SExpr = cp.head_expr();
    // A tuple comprehension head is out of the scalar comprehension lattice
    // (Vec<HeadTy> is typed off EL_TY_*) — clean diagnostic, not a broken chunk.
    if !reject_tuple(head, "wql!/trama!: comprehension head") { out.push_str("0i64"); return; }
    let plan: RExpr = cp.plan_expr();
    // Decompose the plan into (scan, optional guard).
    let mut src_name: str = "";
    let mut has_guard: bool = false;
    match plan {
        RExpr::Scan(sc) => { src_name = sc.src_name; }
        RExpr::Filter(fl) => {
            has_guard = true;
            match fl.input_expr() {
                RExpr::Scan(sc2) => { src_name = sc2.src_name; }
                _ => { }
            }
        }
        _ => { }
    }
    let head_ty: str = el_ty_name(infer_ty(head, t));
    // The comprehension var name — off the SComp node (self-describing IR).
    let vname: str = cp.var;

    out.push_str("({ let mut __cv: Vec<");
    out.push_str(head_ty);
    out.push_str("> = Vec::<");
    out.push_str(head_ty);
    out.push_str(">::new(); let mut __ci: i64 = 0i64; while __ci < (");
    out.push_str(src_name);
    out.push_str(").len() { let ");
    out.push_str(vname);
    // Bind the element BY VALUE — the comprehension scalar lattice (i64/str/bool)
    // is Copy, so `head`/`guard` over the loop var get the element directly (and
    // a `Vec<T>` push takes `T`, not `&T`).
    out.push_str(" = (");
    out.push_str(src_name);
    out.push_str(")[__ci]; ");
    if has_guard {
        match plan {
            RExpr::Filter(fl2) => {
                out.push_str("if (");
                emit_sexpr(out, fl2.pred_expr(), t, var);
                out.push_str(") { __cv.push(");
                emit_sexpr(out, head, t, var);
                out.push_str("); } ");
            }
            _ => { }
        }
    } else {
        out.push_str("__cv.push(");
        emit_sexpr(out, head, t, var);
        out.push_str("); ");
    }
    out.push_str("__ci = __ci + 1i64; } __cv })");
}

// Emit an expression in BOOLEAN (condition) context, coercing a non-bool value
// to a `bool` the way a dynamic template language treats "truthiness" (Trama
// `{% if %}` / `{% elif %}`). A Logos `if` demands a `bool`, but a template
// author writes `{% if count %}` / `{% if name %}` expecting the jinja rule:
//   • BOOL expr  → emitted verbatim (already a condition);
//   • INT  expr  → `((e) != 0i64)`  (non-zero is truthy);
//   • STR  expr  → `((e).len() != 0i64)` (non-empty is truthy).
// The value-type is the codegen `infer_ty` (schema-reflected fields included), so
// `{% if c.flag %}` over a `bool` field stays bare while `{% if c.n %}` over an
// `i64` field gets the `!= 0` guard — no annotation needed.
pub fn emit_truthy(out: &mut String, e: SExpr, t: &ElTypes, var: str) {
    let ty: i32 = infer_ty(e, t);
    if ty == EL_TY_BOOL() {
        emit_sexpr(out, e, t, var);
        return;
    }
    if ty == EL_TY_STR() {
        out.push_str("((");
        emit_sexpr(out, e, t, var);
        out.push_str(").len() != 0i64)");
        return;
    }
    if ty == EL_TY_FLT() {
        // FLT: non-zero is truthy (typed 0.0 comparison — no implicit int→float).
        out.push_str("((");
        emit_sexpr(out, e, t, var);
        out.push_str(") != 0.0f64)");
        return;
    }
    // INT (the numeric baseline): non-zero is truthy.
    out.push_str("((");
    emit_sexpr(out, e, t, var);
    out.push_str(") != 0i64)");
}

// SBin op id (el.logos CEL canon) → Logos infix operator text (spaces padded).
pub fn emit_binop(op: i32) -> str {
    if op == OP_OR()  { return " || "; }
    if op == OP_AND() { return " && "; }
    if op == OP_EQ()  { return " == "; }
    if op == OP_NE()  { return " != "; }
    if op == OP_LT()  { return " < "; }
    if op == OP_LE()  { return " <= "; }
    if op == OP_GT()  { return " > "; }
    if op == OP_GE()  { return " >= "; }
    if op == OP_ADD() { return " + "; }
    if op == OP_SUB() { return " - "; }
    if op == OP_MUL() { return " * "; }
    if op == OP_DIV() { return " / "; }
    return " % ";
}

// Borrow a `String`'s bytes as a `str` view (valid while the String is alive
// and unmodified). Shared spelling for the emit handlers.
pub fn string_as_str(s: &String) -> str {
    return unsafe { str_from_raw(s.as_ptr(), s.len()) };
}

// Escape a `str` into the body of a Logos string literal (between the quotes):
// `"` `\` and the control bytes, so the emitted `"…"` parses back. Shared by
// the SLit string case and the Trama literal-text runs.
pub fn emit_str_escaped(out: &mut String, s: str) {
    let n: i64 = s.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        if c == 34u8 { out.push_str("\\\""); }
        else if c == 92u8 { out.push_str("\\\\"); }
        else if c == 10u8 { out.push_str("\\n"); }
        else if c == 13u8 { out.push_str("\\r"); }
        else if c == 9u8  { out.push_str("\\t"); }
        else {
            let one: str = unsafe { str_from_raw((s.as_ptr() as i64 + i) as *const u8, 1i64) };
            out.push_str(one);
        }
        i = i + 1i64;
    }
}

// Emit a sequence of `<target>.push_str(<part>);` statements that APPEND the
// value of a STRING-typed expression `e` to the render buffer named `target`.
// String concatenation `a + b` is FLATTENED into successive pushes (sound, no
// intermediate `String` temporary / borrow): `{{ a + b }}` → push(a); push(b).
// A non-concat str expression is pushed whole. `indent` prefixes each line.
pub fn emit_push_str(out: &mut String, indent: str, target: str,
                     e: SExpr, t: &ElTypes, var: str) {
    match e {
        SExpr::Bin(b) => {
            // str `+` str → flatten to two appends (the only str-producing op).
            if b.op == OP_ADD() && infer_ty(e, t) == EL_TY_STR() {
                emit_push_str(out, indent, target, b.lhs_expr(), t, var);
                emit_push_str(out, indent, target, b.rhs_expr(), t, var);
                return;
            }
            emit_push_str_one(out, indent, target, e, t, var);
        }
        _ => { emit_push_str_one(out, indent, target, e, t, var); }
    }
}

// Emit one `<target>.push_str(<expr>);` for a single (non-flattened) str expr.
// An `upper`/`lower` call yields an OWNED `String`, so it is borrowed via
// `.as_str()` to feed `push_str(str)`; all other str exprs push verbatim.
fn emit_push_str_one(out: &mut String, indent: str, target: str,
                     e: SExpr, t: &ElTypes, var: str) {
    out.push_str(indent);
    out.push_str(target);
    out.push_str(".push_str(");
    if returns_string(e, t) {
        out.push_str("(");
        emit_sexpr(out, e, t, var);
        out.push_str(").as_str()");
    } else {
        emit_sexpr(out, e, t, var);
    }
    out.push_str(");\n");
}

// True iff `e`'s root is a call that returns an OWNED `String` — a builtin
// (`upper`/`lower`) or a String-returning UDF (the reflected table). Such a
// value is `.as_str()`-borrowed before `push_str` (trama render), or promotes
// the query result element to an OWNED `String` (wql projection — a borrowed
// `str` view of the call's temporary would dangle).
pub fn returns_string(e: SExpr, t: &ElTypes) -> bool {
    match e {
        SExpr::Call(c) => {
            let bfn: i32 = builtin_of_name(c.fn_name);
            if bfn != BFN_UNKNOWN() { return bfn == BFN_UPPER() || bfn == BFN_LOWER(); }
            return t.udf_returns_string(c.fn_name);
        }
        _ => { return false; }
    }
}
