// logos.std.wql.el — the EL (Expression Language) frontend: a minimal
// recursive-descent parser that consumes EL source text and PRODUCES the
// Phase-1 SExpr / RExpr Writ-schema IR (ADR 0012 §"EL = CEL semantics + Logos
// comprehension syntax").
//
// This is dir2 / queue-1 (static) MVP. The grammar implemented here:
//
//   expr     := ternary
//   ternary  := or ( '?' expr ':' expr )?        // CEL conditional
//   or       := and ( '||' and )*
//   and      := equality ( '&&' equality )*
//   equality := compare ( ('=='|'!=') compare )*
//   compare  := add ( ('<'|'<='|'>'|'>=') add )*
//   add      := mul ( ('+'|'-') mul )*
//   mul      := unary ( ('*'|'/'|'%') unary )*
//   unary    := ('!'|'-') unary | postfix
//   postfix  := primary ( '.' ident | '(' args ')' )*   // field access / call
//   primary  := int | bool | string | '$' ident | ident
//              | '(' expr ')'
//              | '[' expr 'for' ident 'in' postfix ( 'if' expr )? ']'   // comprehension
//
// CEL operator semantics + STRICT typing assumptions (D4): no implicit
// optionality — field access is `SField` regardless (resolution against the
// bound schema, and any "missing key" error, happens later at the metacall).
//
// SELF-DESCRIBING IR (ADR 0012 peg-frontend §5, Option B): every leaf node
// carries the textual NAME it references directly (a `str` schema field) — a
// field access `SField.name`, a `$name` param `SParam.name`, a `for v` loop var
// `SVar.name`, a call `SCall.fn_name`, a comprehension source `RScan.src_name`.
// There is NO parser-side dense-id interning table any more; the IR is fully
// self-contained. This is (a) exactly what a peg-generated parser produces (a
// captured IDENT → a `str` field), which is why this refactor is the load-bearing
// pre-step to swapping in the generated parser, and (b) faithful to ADR-0011's
// "the schema IS the typed view" + the seam's "backends trust the IR" (ADR
// 0012-impl-seam §5). Value-TYPES (str/bool/int) are supplied separately by a
// name→type dictionary (`ElTypes`) the handler builds from schema reflection +
// the `with` clause, keeping the parser purely syntactic.
//
// The parser builds nodes into a live `Writ` arena `h`; each parse routine
// returns the child node's edge handle (`WAny`, via the node's `as_ref()`),
// which a parent wires into a `WRef<S>` field. A node's WAny ref targets the
// TOM in the arena (which outlives the local view), so returning the handle
// after the view goes out of scope is sound (same pattern as ir.logos).
package logos.std.wql.el;

use logos.lang.writ.container;
use logos.lang.writ.allocator;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;
use logos.lang.writ.wstring;
use logos.std.wql.ir;
use logos.lang.str;

// ── Operator ids (CEL canon; stable across backends) ──────────────────────
// SBin op ids.
pub fn OP_OR()  -> i32 { return 1i32; }   // ||
pub fn OP_AND() -> i32 { return 2i32; }   // &&
pub fn OP_EQ()  -> i32 { return 3i32; }   // ==
pub fn OP_NE()  -> i32 { return 4i32; }   // !=
pub fn OP_LT()  -> i32 { return 5i32; }   // <
pub fn OP_LE()  -> i32 { return 6i32; }   // <=
pub fn OP_GT()  -> i32 { return 7i32; }   // >
pub fn OP_GE()  -> i32 { return 8i32; }   // >=
pub fn OP_ADD() -> i32 { return 9i32; }   // +
pub fn OP_SUB() -> i32 { return 10i32; }  // -
pub fn OP_MUL() -> i32 { return 11i32; }  // *
pub fn OP_DIV() -> i32 { return 12i32; }  // /
pub fn OP_MOD() -> i32 { return 13i32; }  // %
// SUn op ids.
pub fn OP_NOT() -> i32 { return 1i32; }   // !
pub fn OP_NEG() -> i32 { return 2i32; }   // unary -

// ── EL value-type lattice (codegen type detection) ────────────────────────
// A coarse 3-valued type tag for static codegen: choose `push_str` vs
// `push_i64`, emit string literals, and route the row/projection element type.
// Defaults to INT (the queue-1 numeric baseline); STR/BOOL are inferred from
// literals/operators or DECLARED via the surface (`$x:str`, typed fields).
pub fn EL_TY_INT()  -> i32 { return 0i32; }
pub fn EL_TY_STR()  -> i32 { return 1i32; }
pub fn EL_TY_BOOL() -> i32 { return 2i32; }

// Map a Logos type NAME (as written in the surface) to an EL value-type tag.
// `str`/`String` → STR, `bool` → BOOL, everything else → INT (the integer
// family is rendered identically by `push_i64`). Unknown names default to INT.
pub fn el_ty_of_name(name: str) -> i32 {
    if str_eq(name, "str")    { return EL_TY_STR(); }
    if str_eq(name, "String") { return EL_TY_STR(); }
    if str_eq(name, "bool")   { return EL_TY_BOOL(); }
    return EL_TY_INT();
}

// ── ElTypes — the name→value-type dictionary (the type seam, Option B) ─────
// The self-describing IR carries NAMES, not declared value-types; the codegen
// still needs each field/param/var's EL value-type (str/bool/int) to route
// push_str vs push_i64 and choose the result element type. `ElTypes` is that
// mapping, built by the wql!/trama! HANDLER from (a) schema reflection over the
// source/context struct and (b) the `with` clause — the exact two sources the
// old parser dense tables were stamped from — and passed to the codegen instead
// of the parser. It is a small association list over borrowed `str` name views
// (the names live in the surface text / interned WStrings, which outlive the
// codegen), plus a per-name "is comprehension source" flag (a `&[Elem]` slice
// param vs a scalar).
pub struct ElTypes {
    pub names:  [str; 64],
    pub tys:    [i32; 64],
    pub is_src: [bool; 64],
    pub n:      i64,
    // Ordered list of PARAM names (a `$x` reference), in first-seen order — the
    // generated fn's argument list. Populated by `note_param`.
    pub params:   [str; 64],
    pub param_n:  i64,
}

pub fn el_types_new() -> ElTypes {
    return ElTypes {
        names:  ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                 "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                 "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                 "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        tys:    [0i32; 64],
        is_src: [false; 64],
        n:      0i64,
        params: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                 "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                 "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                 "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        param_n: 0i64,
    };
}

impl ElTypes {
    // The recorded value-type for `name` (EL_TY_*), or INT if unknown.
    pub fn ty_of(self: &ElTypes, name: str) -> i32 {
        let mut i: i64 = 0i64;
        while i < self.n {
            if str_eq(self.names[i], name) { return self.tys[i]; }
            i = i + 1i64;
        }
        return EL_TY_INT();
    }

    // Is `name` a comprehension SOURCE (a `&[Elem]` slice param)?
    pub fn is_source(self: &ElTypes, name: str) -> bool {
        let mut i: i64 = 0i64;
        while i < self.n {
            if str_eq(self.names[i], name) { return self.is_src[i]; }
            i = i + 1i64;
        }
        return false;
    }

    // Record / overwrite `name`'s value-type (idempotent by name). The `with`
    // clause + reflection call this; last write wins (`with` after reflection).
    pub fn set_ty(self: &mut ElTypes, name: str, ty: i32) {
        let mut i: i64 = 0i64;
        while i < self.n {
            if str_eq(self.names[i], name) { self.tys[i] = ty; return; }
            i = i + 1i64;
        }
        if self.n >= 64i64 { return; }
        self.names[self.n] = name;
        self.tys[self.n]   = ty;
        self.is_src[self.n] = false;
        self.n = self.n + 1i64;
    }

    // Flag `name` as a comprehension source (`&[Elem]`), recording it if new.
    pub fn set_source(self: &mut ElTypes, name: str) {
        let mut i: i64 = 0i64;
        while i < self.n {
            if str_eq(self.names[i], name) { self.is_src[i] = true; return; }
            i = i + 1i64;
        }
        if self.n >= 64i64 { return; }
        self.names[self.n]  = name;
        self.tys[self.n]    = EL_TY_INT();
        self.is_src[self.n] = true;
        self.n = self.n + 1i64;
    }

    // Note a `$param` reference in first-seen order (the generated-fn arg list).
    // Deduplicates by name.
    pub fn note_param(self: &mut ElTypes, name: str) {
        let mut i: i64 = 0i64;
        while i < self.param_n {
            if str_eq(self.params[i], name) { return; }
            i = i + 1i64;
        }
        if self.param_n >= 64i64 { return; }
        self.params[self.param_n] = name;
        self.param_n = self.param_n + 1i64;
    }

    pub fn param_count(self: &ElTypes) -> i64 { return self.param_n; }
    pub fn param_name(self: &ElTypes, i: i64) -> str { return self.params[i]; }
}

// ── Parser state ──────────────────────────────────────────────────────────
// Holds only the lexer cursor + an error latch. Names are written straight into
// the IR nodes (Option B) — no parser-side interning tables. The `Writ` arena is
// passed per call (not stored) to keep lifetimes trivial. `ok` latches a parse
// error (MVP: a single failure bit; on error the produced IR is unspecified and
// `parse_el` returns is_null). `params` accumulates the DISTINCT `$param` names
// in first-seen order so the handler can build the generated-fn arg list without
// re-walking the tree (the one small ordered side channel the surface needs).
pub struct ElParser {
    pub src: str,
    pub pos: i64,
    pub len: i64,
    pub ok:  bool,

    // Distinct `$param` names in first-seen order (the arg list). Slices over
    // `src` (the parser's source text), valid for the parser's lifetime.
    pub param_starts: [i64; 64],
    pub param_lens:   [i64; 64],
    pub param_n:      i64,

    // The most-recent comprehension loop-var name (start,len into `src`); 0 len
    // = no comprehension parsed. The one small side channel the emitter reads to
    // recover the `for v` binding name (the loop var otherwise parses as a bare
    // field-root and is disambiguated by name at codegen).
    pub comp_var_start: i64,
    pub comp_var_len:   i64,
}

pub fn el_parser_new(src: str) -> ElParser {
    return ElParser {
        src: src, pos: 0i64, len: src.len(), ok: true,
        param_starts: [0i64; 64], param_lens: [0i64; 64], param_n: 0i64,
        comp_var_start: 0i64, comp_var_len: 0i64,
    };
}

impl ElParser {
    // How many distinct params were referenced (the prepared-stmt arg arity).
    pub fn param_count(self: &ElParser) -> i64 { return self.param_n; }

    // Recover the NAME (a `str` view over `src`) of the i-th distinct param.
    pub fn param_name(self: &ElParser, i: i64) -> str {
        if i < 0i64 || i >= self.param_n { return ""; }
        return unsafe { str_from_range(self.src, self.param_starts[i], self.param_lens[i]) };
    }

    // Record a `$param` reference (deduplicated) in first-seen order.
    fn note_param(self: &mut ElParser, start: i64, len: i64) {
        let mut i: i64 = 0i64;
        while i < self.param_n {
            if range_eq(self.src, self.param_starts[i], self.param_lens[i], start, len) { return; }
            i = i + 1i64;
        }
        if self.param_n >= 64i64 { self.ok = false; return; }
        self.param_starts[self.param_n] = start;
        self.param_lens[self.param_n]   = len;
        self.param_n = self.param_n + 1i64;
    }
}

// ── Lexer primitives ──────────────────────────────────────────────────────
fn is_space(c: u8) -> bool { return c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8; }
fn is_digit(c: u8) -> bool { return c >= 48u8 && c <= 57u8; }
fn is_alpha(c: u8) -> bool {
    return (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) || c == 95u8;
}
fn is_alnum(c: u8) -> bool { return is_alpha(c) || is_digit(c); }

impl ElParser {
    // The byte at the cursor (0 past end).
    fn cur(self: &ElParser) -> u8 {
        if self.pos >= self.len { return 0u8; }
        return str_byte_at(self.src, self.pos);
    }
    fn bump(self: &mut ElParser) { self.pos = self.pos + 1i64; }

    // Skip whitespace (no comments in the MVP grammar).
    fn skip_ws(self: &mut ElParser) {
        while self.pos < self.len && is_space(self.cur()) { self.bump(); }
    }

    // If the upcoming non-ws bytes equal `lit`, consume them and return true.
    // `lit` must be ASCII; used for keywords (`for`/`in`/`if`) and multi-char
    // punctuation. Keyword matches require a non-alnum boundary after.
    fn eat(self: &mut ElParser, lit: str, word: bool) -> bool {
        self.skip_ws();
        let n: i64 = lit.len();
        if self.pos + n > self.len { return false; }
        let mut i: i64 = 0i64;
        while i < n {
            if str_byte_at(self.src, self.pos + i) != str_byte_at(lit, i) { return false; }
            i = i + 1i64;
        }
        if word {
            let after: u8 = if self.pos + n < self.len { str_byte_at(self.src, self.pos + n) } else { 0u8 };
            if is_alnum(after) { return false; }
        }
        self.pos = self.pos + n;
        return true;
    }

    // Peek: does the upcoming non-ws input start with `lit` (no consume)?
    fn at(self: &mut ElParser, lit: str) -> bool {
        self.skip_ws();
        let n: i64 = lit.len();
        if self.pos + n > self.len { return false; }
        let mut i: i64 = 0i64;
        while i < n {
            if str_byte_at(self.src, self.pos + i) != str_byte_at(lit, i) { return false; }
            i = i + 1i64;
        }
        return true;
    }
}

// Byte-range equality against a stored (start,len) name.
fn range_eq(src: str, a_start: i64, a_len: i64, b_start: i64, b_len: i64) -> bool {
    if a_len != b_len { return false; }
    let mut i: i64 = 0i64;
    while i < a_len {
        if str_byte_at(src, a_start + i) != str_byte_at(src, b_start + i) { return false; }
        i = i + 1i64;
    }
    return true;
}

// ── Handle currency ───────────────────────────────────────────────────────
// A node EDGE HANDLE is threaded up the recursive descent as a bare `i64` — the
// raw 8-byte word of the node's `as_ref()` (an absolute, low-bit-0 Ref). A plain
// `i64` carries NO borrow, so it flows freely through the `&mut self` parse
// chain; `WAny` itself is `#[borrow_carrying]` (it ties to the receiver whose
// `&self`/arena it was read from), which would (correctly, by its rules) keep
// `self` borrowed for the whole sub-parse. Laundering through the raw word is the
// in-tree pattern (ir.logos `as_ref` casts the view ptr through `i64` for the
// same provenance reason). The handle round-trips losslessly: every node ref is a
// Ref (absolute ptr), so `WAny::ref_to(word as *const u8)` reconstructs it.
fn hand_of(w: WAny) -> i64 { return w.raw(); }
fn hand_any(w: i64) -> WAny { return WAny::ref_to(w as *const u8); }
fn hand_null() -> i64 { return 0i64; }

// A `str` view over a (start,len) sub-range of `src` — the field/param/var NAME
// to write into a schema `str` field. The schema `str`-field WRITE copies the
// bytes into the arena (`wstring_in_alloc`), so the stored name outlives both the
// parse and the surface text; this view only needs to be valid at the write.
fn name_slice(src: str, start: i64, len: i64) -> str {
    return unsafe { str_from_range(src, start, len) };
}

// ── Node constructors (build into the arena, return the edge handle word) ──
fn mk_lit(h: &Writ, v: WAny) -> i64 {
    let n: SLit = h.make::<SLit>();
    n.val = v;
    return hand_of(n.as_ref());
}
fn mk_param(h: &Writ, name: str) -> i64 {
    let n: SParam = h.make::<SParam>();
    n.name = name;
    return hand_of(n.as_ref());
}
fn mk_var(h: &Writ, name: str) -> i64 {
    let n: SVar = h.make::<SVar>();
    n.name = name;
    return hand_of(n.as_ref());
}
fn mk_field(h: &Writ, base: i64, name: str) -> i64 {
    let n: SField = h.make::<SField>();
    n.base = WRef::<SExpr>::from_any(hand_any(base));
    n.name = name;
    return hand_of(n.as_ref());
}
fn mk_un(h: &Writ, op: i32, arg: i64) -> i64 {
    let n: SUn = h.make::<SUn>();
    n.op  = op;
    n.arg = WRef::<SExpr>::from_any(hand_any(arg));
    return hand_of(n.as_ref());
}
fn mk_bin(h: &Writ, op: i32, lhs: i64, rhs: i64) -> i64 {
    let n: SBin = h.make::<SBin>();
    n.op  = op;
    n.lhs = WRef::<SExpr>::from_any(hand_any(lhs));
    n.rhs = WRef::<SExpr>::from_any(hand_any(rhs));
    return hand_of(n.as_ref());
}
fn mk_cond(h: &Writ, c: i64, t: i64, e: i64) -> i64 {
    let n: SCond = h.make::<SCond>();
    n.c = WRef::<SExpr>::from_any(hand_any(c));
    n.t = WRef::<SExpr>::from_any(hand_any(t));
    n.e = WRef::<SExpr>::from_any(hand_any(e));
    return hand_of(n.as_ref());
}
fn mk_call(h: &Writ, fn_name: str, args: i64) -> i64 {
    let n: SCall = h.make::<SCall>();
    n.fn_name = fn_name;
    n.args    = WRef::<SExprArr>::from_any(hand_any(args));
    return hand_of(n.as_ref());
}
fn mk_comp(h: &Writ, plan: i64, head: i64, var: str) -> i64 {
    let n: SComp = h.make::<SComp>();
    n.plan = WRef::<RExpr>::from_any(hand_any(plan));
    n.head = WRef::<SExpr>::from_any(hand_any(head));
    n.var  = var;
    return hand_of(n.as_ref());
}
// Relational nodes the comprehension lowers to.
fn mk_scan(h: &Writ, src_name: str) -> i64 {
    let n: RScan = h.make::<RScan>();
    n.src_name = src_name;    // node_code resolved at the metacall against the bound schema
    return hand_of(n.as_ref());
}
fn mk_filter(h: &Writ, input: i64, pred: i64) -> i64 {
    let n: RFilter = h.make::<RFilter>();
    n.input = WRef::<RExpr>::from_any(hand_any(input));
    n.pred  = WRef::<SExpr>::from_any(hand_any(pred));
    return hand_of(n.as_ref());
}

// ── Recursive-descent expression grammar ──────────────────────────────────
impl ElParser {
    // expr := ternary
    fn parse_expr(self: &mut ElParser, h: &Writ) -> i64 {
        return self.parse_ternary(h);
    }

    // ternary := or ( '?' expr ':' expr )?
    fn parse_ternary(self: &mut ElParser, h: &Writ) -> i64 {
        let c: i64 = self.parse_or(h);
        if self.eat("?", false) {
            let t: i64 = self.parse_expr(h);
            if !self.eat(":", false) { self.ok = false; return c; }
            let e: i64 = self.parse_expr(h);
            return mk_cond(h, c, t, e);
        }
        return c;
    }

    // or := and ( '||' and )*
    fn parse_or(self: &mut ElParser, h: &Writ) -> i64 {
        let mut lhs: i64 = self.parse_and(h);
        while self.eat("||", false) {
            let rhs: i64 = self.parse_and(h);
            lhs = mk_bin(h, OP_OR(), lhs, rhs);
        }
        return lhs;
    }

    // and := equality ( '&&' equality )*
    fn parse_and(self: &mut ElParser, h: &Writ) -> i64 {
        let mut lhs: i64 = self.parse_equality(h);
        while self.eat("&&", false) {
            let rhs: i64 = self.parse_equality(h);
            lhs = mk_bin(h, OP_AND(), lhs, rhs);
        }
        return lhs;
    }

    // equality := compare ( ('=='|'!=') compare )*
    fn parse_equality(self: &mut ElParser, h: &Writ) -> i64 {
        let mut lhs: i64 = self.parse_compare(h);
        loop {
            let op: i32 = if self.eat("==", false) { OP_EQ() }
                          else if self.eat("!=", false) { OP_NE() }
                          else { 0i32 };
            if op == 0i32 { break; }
            let rhs: i64 = self.parse_compare(h);
            lhs = mk_bin(h, op, lhs, rhs);
        }
        return lhs;
    }

    // compare := add ( ('<='|'>='|'<'|'>') add )*   (two-char ops first)
    fn parse_compare(self: &mut ElParser, h: &Writ) -> i64 {
        let mut lhs: i64 = self.parse_add(h);
        loop {
            let op: i32 = if self.eat("<=", false) { OP_LE() }
                          else if self.eat(">=", false) { OP_GE() }
                          else if self.eat("<", false)  { OP_LT() }
                          else if self.eat(">", false)  { OP_GT() }
                          else { 0i32 };
            if op == 0i32 { break; }
            let rhs: i64 = self.parse_add(h);
            lhs = mk_bin(h, op, lhs, rhs);
        }
        return lhs;
    }

    // add := mul ( ('+'|'-') mul )*
    fn parse_add(self: &mut ElParser, h: &Writ) -> i64 {
        let mut lhs: i64 = self.parse_mul(h);
        loop {
            let op: i32 = if self.eat("+", false) { OP_ADD() }
                          else if self.eat("-", false) { OP_SUB() }
                          else { 0i32 };
            if op == 0i32 { break; }
            let rhs: i64 = self.parse_mul(h);
            lhs = mk_bin(h, op, lhs, rhs);
        }
        return lhs;
    }

    // mul := unary ( ('*'|'/'|'%') unary )*
    fn parse_mul(self: &mut ElParser, h: &Writ) -> i64 {
        let mut lhs: i64 = self.parse_unary(h);
        loop {
            let op: i32 = if self.eat("*", false) { OP_MUL() }
                          else if self.eat("/", false) { OP_DIV() }
                          else if self.eat("%", false) { OP_MOD() }
                          else { 0i32 };
            if op == 0i32 { break; }
            let rhs: i64 = self.parse_unary(h);
            lhs = mk_bin(h, op, lhs, rhs);
        }
        return lhs;
    }

    // unary := ('!'|'-') unary | postfix
    fn parse_unary(self: &mut ElParser, h: &Writ) -> i64 {
        if self.eat("!", false) {
            let a: i64 = self.parse_unary(h);
            return mk_un(h, OP_NOT(), a);
        }
        if self.eat("-", false) {
            let a: i64 = self.parse_unary(h);
            return mk_un(h, OP_NEG(), a);
        }
        return self.parse_postfix(h);
    }

    // postfix := primary ( '.' ident )*
    //
    // Field access `a.b.c` lowers to a left-nested SField chain
    // (`SField(name=c, base=SField(name=b, base=<a>))`), the bounded edge-walk
    // (ADR 0012-impl-seam §1). Function calls `f(args)` are handled at the
    // primary level (an identifier immediately followed by `(`), so a bare
    // `.method()` postfix-call is intentionally NOT in the MVP grammar.
    fn parse_postfix(self: &mut ElParser, h: &Writ) -> i64 {
        let mut e: i64 = self.parse_primary(h);
        while self.eat(".", false) {
            self.skip_ws();
            let start: i64 = self.pos;
            let len: i64 = self.scan_ident();
            if len == 0i64 { self.ok = false; return e; }
            let nm: str = name_slice(self.src, start, len);
            e = mk_field(h, e, nm);
        }
        return e;
    }

    // Scan an identifier starting at the cursor; returns its byte length (the
    // cursor advances past it). 0 if the cursor is not at an identifier start.
    fn scan_ident(self: &mut ElParser) -> i64 {
        if !is_alpha(self.cur()) { return 0i64; }
        let start: i64 = self.pos;
        while self.pos < self.len && is_alnum(self.cur()) { self.bump(); }
        return self.pos - start;
    }

    // primary := int | bool | string | '$' ident | ident ( '(' args ')' )?
    //          | '(' expr ')' | comprehension
    fn parse_primary(self: &mut ElParser, h: &Writ) -> i64 {
        self.skip_ws();
        let c: u8 = self.cur();

        // parenthesised
        if c == 40u8 {  // '('
            self.bump();
            let e: i64 = self.parse_expr(h);
            if !self.eat(")", false) { self.ok = false; }
            return e;
        }
        // comprehension
        if c == 91u8 { return self.parse_comp(h); }  // '['
        // string literal
        if c == 34u8 { return self.parse_string(h); }  // '"'
        // parameter
        if c == 36u8 {  // '$'
            self.bump();
            let start: i64 = self.pos;
            let len: i64 = self.scan_ident();
            if len == 0i64 { self.ok = false; return hand_null(); }
            self.note_param(start, len);
            let nm: str = name_slice(self.src, start, len);
            return mk_param(h, nm);
        }
        // integer literal
        if is_digit(c) { return self.parse_int(h); }
        // identifier: keyword literal (true/false), a function call, or a bare
        // field root. (A comprehension loop var also parses as a bare field root
        // and is disambiguated at codegen time by name against the loop binding.)
        if is_alpha(c) {
            let start: i64 = self.pos;
            let len: i64 = self.scan_ident();
            // bool literals
            if range_lit_eq(self.src, start, len, "true")  { return mk_lit(h, WAny::from(true)); }
            if range_lit_eq(self.src, start, len, "false") { return mk_lit(h, WAny::from(false)); }
            // function call: ident '(' args ')'
            if self.at("(") {
                let nm: str = name_slice(self.src, start, len);
                let args: i64 = self.parse_arglist(h);
                return mk_call(h, nm, args);
            }
            // Otherwise a bare field-root identifier. In the static profile a
            // bare name denotes a field of the implicit data context / source
            // root resolved at the metacall — modelled as an SField step off a
            // NULL base handle (`base = WAny::Ref(0)`); the metacall binds that
            // root to the data context. A comprehension loop-var reference also
            // lands here and is emitted as its own name by the codegen.
            let nm: str = name_slice(self.src, start, len);
            return mk_field(h, hand_null(), nm);
        }
        self.ok = false;
        return hand_null();
    }

    // int := [0-9]+
    fn parse_int(self: &mut ElParser, h: &Writ) -> i64 {
        let mut v: i64 = 0i64;
        while self.pos < self.len && is_digit(self.cur()) {
            v = v * 10i64 + ((self.cur() as i64) - 48i64);
            self.bump();
        }
        return mk_lit(h, h.int(v));
    }

    // string := '"' chars '"'   (no escapes in the MVP)
    fn parse_string(self: &mut ElParser, h: &Writ) -> i64 {
        self.bump();  // opening quote
        let start: i64 = self.pos;
        while self.pos < self.len && self.cur() != 34u8 { self.bump(); }
        let len: i64 = self.pos - start;
        if self.cur() != 34u8 { self.ok = false; } else { self.bump(); }  // closing quote
        // Box the string bytes into the arena and store a Ref WAny.
        let s: str = unsafe { str_from_range(self.src, start, len) };
        let w: WAny = unsafe {
            WAny::ref_to(wstring_in_alloc(h.allocator.get(), s) as *const u8)
        };
        return mk_lit(h, w);
    }

    // arglist := '(' ( expr ( ',' expr )* )? ')'  →  SExprArr backing
    // Phase 3: materialize the FULL argument list. Every arg is parsed into the
    // arena and its edge handle stashed; then ONE `SExprArr` node is built and
    // all handles are stored into its fixed slots (`set_arg`) with the count
    // (`set_len`). Args beyond `SEXPRARR_MAX` overflow the parse-error latch.
    // Parsing happens BEFORE the SExprArr view is made, so the parse's `&mut
    // self` chain never overlaps a live arena view.
    fn parse_arglist(self: &mut ElParser, h: &Writ) -> i64 {
        if !self.eat("(", false) { self.ok = false; }
        let mut argw: [i64; 8] = [0i64; 8];
        let mut n: i64 = 0i64;
        if !self.at(")") {
            loop {
                let a: i64 = self.parse_expr(h);
                if n < SEXPRARR_MAX() { argw[n] = a; n = n + 1i64; }
                else { self.ok = false; }   // arity overflow
                if !self.eat(",", false) { break; }
            }
        }
        if !self.eat(")", false) { self.ok = false; }
        let mut arr: SExprArr = h.make::<SExprArr>();
        arr.set_len(n);
        let mut i: i64 = 0i64;
        while i < n {
            arr.set_arg(i, hand_any(argw[i]));
            i = i + 1i64;
        }
        return hand_of(arr.as_ref());
    }

    // comprehension := '[' expr 'for' ident 'in' postfix ( 'if' guard )? ']'
    //   →  SComp{ plan = RFilter(RScan(src), guard)?  |  RScan(src),
    //            head = expr }
    fn parse_comp(self: &mut ElParser, h: &Writ) -> i64 {
        self.eat("[", false);
        // The grammar is `[ head for v in src (if guard)? ]`: the head/guard
        // reference the loop var `v` (parsed as bare field-roots, emitted by
        // name). No prescan/binding is needed any more — names carry through the
        // IR directly, so the head is just parsed and the `for v` name is stored
        // on the loop-var side channel below for the emitter.
        let head: i64 = self.parse_expr(h);
        if !self.eat("for", true) { self.ok = false; }
        // the loop variable name
        self.skip_ws();
        let vstart: i64 = self.pos;
        let vlen: i64 = self.scan_ident();
        if vlen == 0i64 { self.ok = false; }
        let vname: str = name_slice(self.src, vstart, vlen);
        if !self.eat("in", true) { self.ok = false; }
        // source: a bare identifier stored as the RScan source name
        let src_name: str = self.parse_source(h);
        let scan: i64 = mk_scan(h, src_name);

        let plan: i64 = if self.eat("if", true) {
            let guard: i64 = self.parse_expr(h);
            mk_filter(h, scan, guard)
        } else {
            scan
        };
        if !self.eat("]", false) { self.ok = false; }
        // The loop-var name is stored self-describingly on the SComp node, so the
        // emitter reads it off the IR (no parser side channel needed).
        self.comp_var_start = vstart;
        self.comp_var_len   = vlen;
        return mk_comp(h, plan, head, vname);
    }

    // Comprehension source: a bare identifier stored as the RScan source name.
    // Also recorded as a PARAM (in first-seen syntactic order) so the generated
    // fn's argument list places the source at its natural position; the handler
    // flags it as a `&[Elem]` source separately (walking the IR).
    fn parse_source(self: &mut ElParser, h: &Writ) -> str {
        self.skip_ws();
        let start: i64 = self.pos;
        let len: i64 = self.scan_ident();
        if len == 0i64 { self.ok = false; return ""; }
        self.note_param(start, len);
        return name_slice(self.src, start, len);
    }
}

// Compare a (start,len) byte range in `src` against an ASCII literal.
fn range_lit_eq(src: str, start: i64, len: i64, lit: str) -> bool {
    if len != lit.len() { return false; }
    let mut i: i64 = 0i64;
    while i < len {
        if str_byte_at(src, start + i) != str_byte_at(lit, i) { return false; }
        i = i + 1i64;
    }
    return true;
}

// Build a `str` view over a (start,len) byte range of `src`. The returned `str`
// shares `src`'s buffer (no copy); valid for `src`'s lifetime. UNSAFE: forms a
// fat str pointer from src.as_ptr()+start with the given length.
unsafe fn str_from_range(src: str, start: i64, len: i64) -> str {
    return str_from_raw((src.as_ptr() as i64 + start) as *const u8, len);
}

// ── Public entry point ────────────────────────────────────────────────────
// Parse EL source `text` into the SExpr/RExpr IR built in arena `h`. Returns
// the ROOT node's edge handle (a `WAny` ref to view via `.view::<SExpr>()`).
// On a parse error the returned handle is null (`WAny::is_null`).
pub fn parse_el(h: &Writ, text: str) -> WAny {
    let mut p: ElParser = el_parser_new(text);
    let root: i64 = p.parse_expr(h);
    p.skip_ws();
    let bad: bool = !p.ok || p.pos < p.len;   // error or unconsumed trailing input
    if bad { return WAny::ref_to(0i64 as *const u8); }
    return hand_any(root);
}

impl ElParser {
    // Parse this parser's `src` (a full EL expression) into the SExpr IR built
    // in arena `h`. Returns the root SExpr edge handle, or null on a parse error
    // / trailing input. The IR carries all names self-describingly (Option B),
    // so the caller needs no name tables — only the parser's `param_*` side
    // channel (for the ordered arg list) survives, read via `param_name`.
    pub fn parse_root(self: &mut ElParser, h: &Writ) -> WAny {
        let root: i64 = self.parse_expr(h);
        self.skip_ws();
        if !self.ok || self.pos < self.len { return WAny::ref_to(0i64 as *const u8); }
        return hand_any(root);
    }

    // The comprehension loop-var name recorded by the last `parse_comp` (empty
    // if none). Slices over `src`.
    pub fn comp_var(self: &ElParser) -> str {
        if self.comp_var_len <= 0i64 { return ""; }
        return unsafe { str_from_range(self.src, self.comp_var_start, self.comp_var_len) };
    }
}
