// logos.std.wql.wql — the `wql!{ … }` RESOURCE surface (ADR 0012 §6 / §10.2,
// queue-1 STATIC lowering). A `#[token_macro]` handler receives the raw block
// text at compile time, parses the MVP query surface, lowers the `where` /
// `select` expressions to the SExpr Writ-schema IR (Phase 1/2), then WALKS that
// schema'd IR to EMIT a native Logos function (via `logos_emit_source`) that
// iterates the source, filters, and collects the projected rows — the
// "prepared statement" model (no runtime-string queries; ADR 0012 §queues).
//
// MVP surface (explicit-typed, per the ADR static model — schema/types always
// known at compile time, params/sources flow as generated-fn arguments):
//
//   wql! {
//       fn <name>
//       from <src>:[<RowTy>] <var>
//       [ where <predicate-EL> ]
//       select <projection-EL> : <ResultTy>
//   }
//
//   →  pub fn <name>(<src>: &[<RowTy>], <$param>: <PTy>, …) -> Vec<ResultTy> {
//          let mut __out: Vec<ResultTy> = Vec::<ResultTy>::new();
//          let mut __i: i64 = 0;
//          while __i < (<src>).len() {
//              let <var>: &<RowTy> = &(<src>)[__i];
//              if <predicate> { __out.push(<projection>); }
//              __i = __i + 1;
//          }
//          return __out;
//      }
//
// The `where` / `select` expressions are parsed by the EL frontend
// (`logos.std.wql.el`) into the SExpr IR, and the codegen below walks that IR
// (the schema-enum tree, via `match`) emitting Logos expression text. Field
// access `var.f` and `$param` resolve through the parser's name tables
// (`field_name` / `param_name`). This is the ONE lowering: SExpr schema → Logos
// source (ADR 0012 §10.2 — generate source, don't hand-build LIR).
//
// Runtime params `$x:Ty` flow as generated-fn ARGUMENTS (sqlx model, ADR
// §10.3); the source `<src>` is the first argument (an explicit `&[RowTy]`
// slice). The data is supplied by the caller at the `<name>(…)` call site.
package logos.std.wql.wql;

use logos.std.compiler.metaprog;     // Emitter, ItemList, item_list_new, error, OView
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;
use logos.std.wql.ir;
use logos.std.wql.el;
use logos.std.wql.codegen;   // emit_sexpr / emit_binop / string_as_str / infer_ty / el_ty_name
use logos.std.wql.reflect;   // stamp_types_from_schema — schema field-type reflection
use logos.mem.string;
use logos.lang.str;

// ── Surface lexer ──────────────────────────────────────────────────────────
// A tiny cursor over the raw block text that carves the query into its
// keyword-delimited clauses. The clause BODIES (`where` / `select` expressions)
// are handed to the EL parser verbatim; only the structural keywords
// (`fn`/`from`/`where`/`select`) and the typed annotations are lexed here.
struct QLexer {
    src: str,
    pos: i64,
    len: i64,
}

fn ql_is_space(c: u8) -> bool { return c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8; }
fn ql_is_alpha(c: u8) -> bool {
    return (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) || c == 95u8;
}
fn ql_is_digit(c: u8) -> bool { return c >= 48u8 && c <= 57u8; }
fn ql_is_alnum(c: u8) -> bool { return ql_is_alpha(c) || ql_is_digit(c); }

impl QLexer {
    fn cur(self: &QLexer) -> u8 {
        if self.pos >= self.len { return 0u8; }
        return str_byte_at(self.src, self.pos);
    }
    fn bump(self: &mut QLexer) { self.pos = self.pos + 1i64; }
    fn skip_ws(self: &mut QLexer) {
        while self.pos < self.len && ql_is_space(self.cur()) { self.bump(); }
    }
    // Consume keyword `kw` at the cursor (word-boundary). Returns true on match.
    fn eat_kw(self: &mut QLexer, kw: str) -> bool {
        self.skip_ws();
        let n: i64 = kw.len();
        if self.pos + n > self.len { return false; }
        let mut i: i64 = 0i64;
        while i < n {
            if str_byte_at(self.src, self.pos + i) != str_byte_at(kw, i) { return false; }
            i = i + 1i64;
        }
        let after: u8 = if self.pos + n < self.len { str_byte_at(self.src, self.pos + n) } else { 0u8 };
        if ql_is_alnum(after) { return false; }
        self.pos = self.pos + n;
        return true;
    }
    // Scan an identifier at the cursor → (start,len); advances. len 0 on miss.
    fn scan_ident(self: &mut QLexer) -> i64 {
        self.skip_ws();
        if !ql_is_alpha(self.cur()) { return 0i64; }
        let start: i64 = self.pos;
        while self.pos < self.len && ql_is_alnum(self.cur()) { self.bump(); }
        return self.pos - start;
    }
    // Consume bytes until (but not including) the next occurrence of keyword
    // `kw` at a word boundary, or EOI; returns the [start,end) slice (trimmed).
    fn take_until_kw(self: &mut QLexer, kw: str) -> str {
        self.skip_ws();
        let start: i64 = self.pos;
        let mut end: i64 = self.pos;
        loop {
            if self.pos >= self.len { end = self.pos; break; }
            if self.at_kw(kw) { end = self.pos; break; }
            self.bump();
        }
        // right-trim whitespace
        while end > start && ql_is_space(str_byte_at(self.src, end - 1i64)) { end = end - 1i64; }
        return unsafe { wql_str_range(self.src, start, end - start) }
    }
    // Consume bytes until (but not including) the next occurrence of ANY of the
    // keywords `a`/`b`/`c` at a word boundary, or EOI; returns the [start,end)
    // slice (right-trimmed). An empty keyword string is treated as "never match"
    // so callers can pass fewer than three stops. The Phase-4 clause carver: a
    // `where`/`on` predicate ends at the next structural keyword regardless of
    // which clause follows (`join` / `group` / `select`).
    fn take_until_any3(self: &mut QLexer, a: str, b: str, c: str) -> str {
        self.skip_ws();
        let start: i64 = self.pos;
        let mut end: i64 = self.pos;
        loop {
            if self.pos >= self.len { end = self.pos; break; }
            if a.len() > 0i64 && self.at_kw(a) { end = self.pos; break; }
            if b.len() > 0i64 && self.at_kw(b) { end = self.pos; break; }
            if c.len() > 0i64 && self.at_kw(c) { end = self.pos; break; }
            self.bump();
        }
        while end > start && ql_is_space(str_byte_at(self.src, end - 1i64)) { end = end - 1i64; }
        return unsafe { wql_str_range(self.src, start, end - start) }
    }

    // Scan forward from the cursor (WITHOUT moving it) for the first top-level
    // structural keyword that selects the query shape — `join` / `anti` / `group`
    // — appearing before `select`. Returns 1=join, 2=group, 0=simple. The leading
    // optional `where` predicate may sit between `from` and these keywords, so the
    // dispatch cannot just peek the immediate next token (a `where … group by …`
    // query starts with `where`). The where/on EL bodies do not contain bare
    // `join`/`anti`/`group`/`select` tokens (reserved in the MVP surface), so a
    // simple word-boundary scan up to `select` is unambiguous.
    fn detect_kind(self: &mut QLexer) -> i64 {
        let save: i64 = self.pos;
        let mut kind: i64 = 0i64;
        loop {
            self.skip_ws();
            if self.pos >= self.len { break; }
            if self.at_kw("select") { break; }
            if self.at_kw("join") || self.at_kw("anti") { kind = 1i64; break; }
            if self.at_kw("group") { kind = 2i64; break; }
            self.bump();
        }
        self.pos = save;
        return kind;
    }

    // Peek: is keyword `kw` at the cursor (word boundary)? No consume.
    fn at_kw(self: &mut QLexer, kw: str) -> bool {
        let save: i64 = self.pos;
        self.skip_ws();
        let n: i64 = kw.len();
        if self.pos + n > self.len { self.pos = save; return false; }
        let mut i: i64 = 0i64;
        while i < n {
            if str_byte_at(self.src, self.pos + i) != str_byte_at(kw, i) { self.pos = save; return false; }
            i = i + 1i64;
        }
        let after: u8 = if self.pos + n < self.len { str_byte_at(self.src, self.pos + n) } else { 0u8 };
        let hit: bool = !ql_is_alnum(after);
        self.pos = save;
        return hit;
    }
}

unsafe fn wql_str_range(src: str, start: i64, len: i64) -> str {
    let l: i64 = if len < 0i64 { 0i64 } else { len };
    return str_from_raw((src.as_ptr() as i64 + start) as *const u8, l);
}


// ── The resource handler ───────────────────────────────────────────────────
// `#[token_macro]`: receives the raw `wql!{ … }` block bytes as a single `str`,
// emits the generated query function, and returns an (empty) ItemList — the
// emitted source is spliced by the host's `logos_emit_source` (ADR 0012 §10.2).
#[token_macro]
pub fn wql(s: str) -> ItemList {
    let out: ItemList = item_list_new();

    let mut lx: QLexer = QLexer { src: s, pos: 0i64, len: s.len() };

    // fn <name>
    if !lx.eat_kw("fn") { error("wql!: expected `fn <name>`"); return out; }
    let fn_name: str = lx.scan_ident_str();

    // from <src>:[<RowTy>] <var>
    if !lx.eat_kw("from") { error("wql!: expected `from <src>:[<Ty>] <var>`"); return out; }
    let src_name: str = lx.scan_ident_str();
    lx.skip_ws();
    if lx.cur() != 58u8 { error("wql!: expected `:` after source name"); return out; }  // ':'
    lx.bump();
    lx.skip_ws();
    if lx.cur() != 91u8 { error("wql!: expected `[` row-type"); return out; }  // '['
    lx.bump();
    let row_ty: str = lx.scan_ident_str();
    lx.skip_ws();
    if lx.cur() != 93u8 { error("wql!: expected `]` after row-type"); return out; }  // ']'
    lx.bump();
    let var_name: str = lx.scan_ident_str();

    // ── Phase 4 dispatch — relational query shapes off the SAME `from` prefix.
    // After the first source, the next structural keyword selects the lowering:
    //   • `join` / `anti join` → inner / anti nested-loop join (two sources);
    //   • `group`              → group-by + aggregates (count/sum/min/max/avg);
    //   • otherwise            → the simple scan/filter/project path (below).
    let kind: i64 = lx.detect_kind();
    if kind == 1i64 {
        emit_join(&mut lx, s, fn_name, src_name, row_ty, var_name);
        return out;
    }
    if kind == 2i64 {
        emit_aggregate(&mut lx, s, fn_name, src_name, row_ty, var_name);
        return out;
    }

    // [ where <pred> ]
    let mut where_text: str = "";
    let mut has_where: bool = false;
    if lx.eat_kw("where") {
        where_text = lx.take_until_kw("select");
        has_where = true;
    }

    // select <proj> [ : <ResultTy> ]
    // The `: <ResultTy>` annotation is now OPTIONAL (Phase 5a): when omitted, the
    // result element type is INFERRED from the projection's value-type, itself
    // typed from the SOURCE SCHEMA via reflection (a `select p.name` over a
    // `name: str` field infers `Vec<str>`). An explicit `: Ty` still overrides.
    if !lx.eat_kw("select") { error("wql!: expected `select <expr> [: <Ty>]`"); return out; }
    // projection bytes up to the depth-0 `:` that introduces the result type
    // (ternary `?:` colons are balanced out), or to EOI / the `with` clause.
    let proj_text: str = lx.take_until_colon();
    lx.skip_ws();
    let mut result_ty: str = "";
    let mut infer_result: bool = true;
    if lx.cur() == 58u8 {   // explicit `: <ResultTy>`
        lx.bump();
        result_ty = lx.scan_ident_str();
        infer_result = false;
    }

    // optional `with [$]<name>:<ty> (, …)*` — DECLARED value types for params
    // (`$q:str`) and fields (`name:str`). `$`-prefixed names type a PARAM; bare
    // names type a FIELD. Applied to both clause parsers after parsing (so the
    // names are interned). Collected as (is_param, name, ty) slice triples.
    let mut dn: i64 = 0i64;
    let mut d_is_param: [bool; 32] = [false; 32];
    let mut d_name_start: [i64; 32] = [0i64; 32];
    let mut d_name_len:   [i64; 32] = [0i64; 32];
    let mut d_ty_start:   [i64; 32] = [0i64; 32];
    let mut d_ty_len:     [i64; 32] = [0i64; 32];
    if lx.eat_kw("with") {
        loop {
            lx.skip_ws();
            let is_param: bool = lx.cur() == 36u8;  // '$'
            if is_param { lx.bump(); }
            let ns: i64 = lx.pos;
            let nl: i64 = lx.scan_ident();
            if nl == 0i64 { error("wql!: `with` expects [$]<name>:<type>"); return out; }
            lx.skip_ws();
            if lx.cur() != 58u8 { error("wql!: `with` expects `:` after name"); return out; }  // ':'
            lx.bump();
            lx.skip_ws();
            let ts: i64 = lx.pos;
            let tl: i64 = lx.scan_ident();
            if tl == 0i64 { error("wql!: `with` expects a type name"); return out; }
            if dn < 32i64 {
                d_is_param[dn] = is_param;
                d_name_start[dn] = ns; d_name_len[dn] = nl;
                d_ty_start[dn] = ts;   d_ty_len[dn] = tl;
                dn = dn + 1i64;
            }
            lx.skip_ws();
            if lx.cur() == 44u8 { lx.bump(); continue; }  // ','
            break;
        }
    }

    // ── Parse the EL clauses → SExpr IR; keep the parsers for the param list ──
    let h: Writ = writ_new(2048i64);

    // Projection (required).
    let mut pp: ElParser = el_parser_new(proj_text);
    // Launder the root handle through a raw word: `parse_root` returns a
    // `#[borrow_carrying]` WAny conservatively tied to `&mut pp`, which would
    // keep `pp` mutably borrowed across the later `&pp` codegen reads. The
    // handle is a plain absolute ref into `h`, so round-tripping through `raw()`
    // drops the spurious parser borrow (same currency trick el.logos uses).
    let proj_word: i64 = pp.parse_root(&h).raw();
    if proj_word == 0i64 { error("wql!: malformed `select` expression"); return out; }

    // Predicate (optional).
    let mut wp: ElParser = el_parser_new(where_text);
    let mut pred_word: i64 = 0i64;
    if has_where {
        pred_word = wp.parse_root(&h).raw();
        if pred_word == 0i64 { error("wql!: malformed `where` expression"); return out; }
    }

    // ── Build the name→value-type dictionary (Option B type seam) ─────────
    // Reflect the SOURCE SCHEMA (`row_ty`) and record each field's value-type;
    // then apply `with`; then merge each clause's `$param` names into the dict's
    // ordered arg list. The self-describing IR carries names, so codegen reads
    // types from this ONE dict — not from parser dense tables.
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, row_ty);

    // Apply the `with` type declarations. `$`-prefixed names type a PARAM (and
    // seed the ordered param list); bare names type a FIELD. Overrides reflection.
    let mut di: i64 = 0i64;
    while di < dn {
        let nm: str = unsafe { wql_str_range(s, d_name_start[di], d_name_len[di]) };
        let tn: str = unsafe { wql_str_range(s, d_ty_start[di], d_ty_len[di]) };
        ty.set_ty(nm, el_ty_of_name(tn));
        di = di + 1i64;
    }
    // Merge the ordered param names from both clause parsers (dedup by name).
    merge_params(&mut ty, &pp);
    merge_params(&mut ty, &wp);

    // Register comprehension SOURCES (an `RScan.src_name` under an SComp) as
    // `&[Elem]` slice params — replaces the parser's old `param_is_src` flag
    // (the source name is on the IR node now, so walk the IR to find them).
    let proj_any: WAny = WAny::ref_to(proj_word as *const u8);
    let proj_sexpr: SExpr = proj_any.view::<SExpr>();
    register_comp_sources(proj_sexpr, &mut ty);
    if has_where {
        let pred_any0: WAny = WAny::ref_to(pred_word as *const u8);
        register_comp_sources(pred_any0.view::<SExpr>(), &mut ty);
    }

    // ── Emit the generated function source ────────────────────────────────
    let mut body: String = String::new();
    // Surface a call-site error for an unknown / wrong-arity builtin BEFORE
    // emitting (the codegen otherwise emits a safe `0i64` placeholder).
    if call_diagnostic(proj_sexpr, &ty) {
        error("wql!: `select` calls an unknown or wrong-arity function");
        return out;
    }
    emit_sexpr(&mut body, proj_sexpr, &ty, var_name);
    // INFER the result element type from the projection's value-type when no
    // explicit `: <ResultTy>` was given (Phase 5a). The projection's fields are
    // now schema-typed (reflection above), so `infer_ty` resolves `select p.name`
    // → STR → `str`, `select p.age` → INT → `i64`, a `> / ==` predicate-style
    // projection → BOOL → `bool`, etc. An explicit annotation still wins.
    if infer_result {
        result_ty = el_ty_name(infer_ty(proj_sexpr, &ty));
    }
    // A comprehension projection pushes a `Vec<Elem>` per row, so the generated
    // function returns `Vec<Vec<Elem>>`. Detect the SComp root and build the
    // (nested) element type the `Vec<…>` machinery below wraps. Under inference a
    // comprehension's inner `result_ty` is the HEAD expression's type (the
    // `infer_ty` of an SComp root collapses to the scalar baseline, so probe the
    // head directly for the precise inner element type).
    let is_comp: bool = is_comp_root(proj_sexpr);
    if infer_result && is_comp {
        result_ty = el_ty_name(comp_head_ty(proj_sexpr, &ty));
    }
    let mut elem_ty: String = String::new();
    if is_comp {
        elem_ty.push_str("Vec<");
        elem_ty.push_str(result_ty);
        elem_ty.push_str(">");
    } else {
        elem_ty.push_str(result_ty);
    }
    let result_elem: str = string_as_str(&elem_ty);
    let mut pred_body: String = String::new();
    if has_where {
        let pred_any: WAny = WAny::ref_to(pred_word as *const u8);
        let pred_sexpr: SExpr = pred_any.view::<SExpr>();
        if call_diagnostic(pred_sexpr, &ty) {
            error("wql!: `where` calls an unknown or wrong-arity function");
            return out;
        }
        emit_sexpr(&mut pred_body, pred_sexpr, &ty, var_name);
    }

    let mut em: Emitter = Emitter::new();
    em.emit_into("test");
    em.push_text("pub fn ");
    em.push_text(fn_name);
    em.push_text("(");
    em.push_text(src_name);
    em.push_text(": &[");
    em.push_text(row_ty);
    em.push_text("]");
    // params (merged, deduped, ordered), as fn args.
    emit_params(&mut em, &ty);
    em.push_text(") -> Vec<");
    em.push_text(result_elem);
    em.push_text("> {\n");
    em.push_text("    let mut __out: Vec<");
    em.push_text(result_elem);
    em.push_text("> = Vec::<");
    em.push_text(result_elem);
    em.push_text(">::new();\n");
    em.push_text("    let mut __i: i64 = 0i64;\n");
    em.push_text("    while __i < (");
    em.push_text(src_name);
    em.push_text(").len() {\n");
    em.push_text("        let ");
    em.push_text(var_name);
    em.push_text(": &");
    em.push_text(row_ty);
    em.push_text(" = &(");
    em.push_text(src_name);
    em.push_text(")[__i];\n");
    if has_where {
        em.push_text("        if ");
        em.push_text(string_as_str(&pred_body));
        em.push_text(" {\n");
        em.push_text("            __out.push(");
        em.push_text(string_as_str(&body));
        em.push_text(");\n");
        em.push_text("        }\n");
    } else {
        em.push_text("        __out.push(");
        em.push_text(string_as_str(&body));
        em.push_text(");\n");
    }
    em.push_text("        __i = __i + 1i64;\n");
    em.push_text("    }\n");
    em.push_text("    return __out;\n");
    em.push_text("}\n");
    em.commit();

    return out;
}

// ── Phase 4: shared `with` type-declaration parsing ───────────────────────
// The `with [$]<name>:<ty> (, …)*` tail declares value-types for params (`$q`)
// and fields (bare). Phase 4 reuses it across join (3 parsers) / aggregate.
// `WithDecls` collects (is_param, name-slice, ty-slice) triples into the raw
// block text `s`; `apply_with` stamps them onto a parser after parsing.
struct WithDecls {
    n: i64,
    is_param:   [bool; 32],
    name_start: [i64; 32],
    name_len:   [i64; 32],
    ty_start:   [i64; 32],
    ty_len:     [i64; 32],
}

fn with_decls_new() -> WithDecls {
    return WithDecls {
        n: 0i64,
        is_param:   [false; 32],
        name_start: [0i64; 32], name_len: [0i64; 32],
        ty_start:   [0i64; 32], ty_len:   [0i64; 32],
    };
}

// Parse an optional `with …` clause at the cursor into `d`. Returns false on a
// malformed clause (caller surfaces the error). A missing `with` is success.
fn parse_with(lx: &mut QLexer, d: &mut WithDecls) -> bool {
    if !lx.eat_kw("with") { return true; }
    loop {
        lx.skip_ws();
        let is_param: bool = lx.cur() == 36u8;  // '$'
        if is_param { lx.bump(); }
        let ns: i64 = lx.pos;
        let nl: i64 = lx.scan_ident();
        if nl == 0i64 { return false; }
        lx.skip_ws();
        if lx.cur() != 58u8 { return false; }  // ':'
        lx.bump();
        lx.skip_ws();
        let ts: i64 = lx.pos;
        let tl: i64 = lx.scan_ident();
        if tl == 0i64 { return false; }
        if d.n < 32i64 {
            d.is_param[d.n]   = is_param;
            d.name_start[d.n] = ns; d.name_len[d.n] = nl;
            d.ty_start[d.n]   = ts; d.ty_len[d.n]   = tl;
            d.n = d.n + 1i64;
        }
        lx.skip_ws();
        if lx.cur() == 44u8 { lx.bump(); continue; }  // ','
        break;
    }
    return true;
}

// Apply the collected `with` declarations to the type dictionary `t` (`s` = the
// raw block text the name/type slices index into). Both param and field names
// map into the ONE name→type dict (Option B: names are self-describing in the
// IR, so param vs field distinction is only used for the source/scalar shape,
// handled separately). Overrides reflection.
fn apply_with_types(t: &mut ElTypes, d: &WithDecls, s: str) {
    let mut i: i64 = 0i64;
    while i < d.n {
        let nm: str = unsafe { wql_str_range(s, d.name_start[i], d.name_len[i]) };
        let tn: str = unsafe { wql_str_range(s, d.ty_start[i], d.ty_len[i]) };
        t.set_ty(nm, el_ty_of_name(tn));
        i = i + 1i64;
    }
}

// Merge one parser's ordered `$param` names into the type dict's arg list.
fn merge_params(t: &mut ElTypes, p: &ElParser) {
    let n: i64 = p.param_count();
    let mut i: i64 = 0i64;
    while i < n {
        t.note_param(p.param_name(i));
        i = i + 1i64;
    }
}

// ── Phase 4: RJoin / RAnti — nested-loop (anti-)join over two sources ──────
// Surface (continuing past the first `from <a>:[A] x`):
//
//   [anti] join <b>:[B] y on <onPred> [ where <wherePred> ]
//   select <proj> : <ResultTy> [ with … ]
//
// INNER JOIN  → for each (x in a, y in b) with `on` true (and `where` true),
//               push the projection — the relational RJoin lowered to native
//               nested loops (ADR 0012 §2, queue-1).
// ANTI JOIN   → for each x in a, push the projection iff NO y in b satisfies
//               `on` (and `where` true) — RAnti, the semijoin complement.
//
// Both loop variables `x`/`y` are emitted by the codegen as bare field roots
// (`x.age`, `y.dept`), so the generated loops simply bind locals of those names.
fn emit_join(lx: &mut QLexer, s: str, fn_name: str,
             a_name: str, a_ty: str, x_var: str) {
    let is_anti: bool = lx.eat_kw("anti");
    if !lx.eat_kw("join") { error("wql!: expected `join <src>:[<Ty>] <var>`"); return; }

    // join <b>:[B] y
    let b_name: str = lx.scan_ident_str();
    lx.skip_ws();
    if lx.cur() != 58u8 { error("wql!: join expects `:` after source name"); return; }
    lx.bump();
    lx.skip_ws();
    if lx.cur() != 91u8 { error("wql!: join expects `[` row-type"); return; }
    lx.bump();
    let b_ty: str = lx.scan_ident_str();
    lx.skip_ws();
    if lx.cur() != 93u8 { error("wql!: join expects `]` after row-type"); return; }
    lx.bump();
    let y_var: str = lx.scan_ident_str();

    // on <onPred>
    if !lx.eat_kw("on") { error("wql!: join expects `on <predicate>`"); return; }
    let on_text: str = lx.take_until_any3("where", "select", "");

    // [ where <wherePred> ]
    let mut where_text: str = "";
    let mut has_where: bool = false;
    if lx.eat_kw("where") {
        where_text = lx.take_until_any3("select", "", "");
        has_where = true;
    }

    // select <proj> : <ResultTy>
    if !lx.eat_kw("select") { error("wql!: join expects `select <expr> : <Ty>`"); return; }
    let proj_text: str = lx.take_until_colon();
    lx.skip_ws();
    if lx.cur() != 58u8 { error("wql!: join `select` needs a `: <ResultTy>`"); return; }
    lx.bump();
    let result_ty: str = lx.scan_ident_str();

    // optional `with`
    let mut d: WithDecls = with_decls_new();
    if !parse_with(lx, &mut d) { error("wql!: malformed `with` clause"); return; }

    let h: Writ = writ_new(4096i64);

    // Parse on / where / select into the SExpr IR (keep parsers for name tables).
    let mut op: ElParser = el_parser_new(on_text);
    let on_word: i64 = op.parse_root(&h).raw();
    if on_word == 0i64 { error("wql!: malformed join `on` predicate"); return; }

    let mut wp: ElParser = el_parser_new(where_text);
    let mut where_word: i64 = 0i64;
    if has_where {
        where_word = wp.parse_root(&h).raw();
        if where_word == 0i64 { error("wql!: malformed join `where` predicate"); return; }
    }

    let mut pp: ElParser = el_parser_new(proj_text);
    let proj_word: i64 = pp.parse_root(&h).raw();
    if proj_word == 0i64 { error("wql!: malformed join `select` expression"); return; }

    // Build the type dict: reflect BOTH row schemas (a/b), apply `with`, merge
    // params. Codegen reads names off the IR + types from this dict.
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, a_ty);
    stamp_types_from_schema(&view, &mut ty, b_ty);
    apply_with_types(&mut ty, &d, s);
    merge_params(&mut ty, &op);
    merge_params(&mut ty, &wp);
    merge_params(&mut ty, &pp);

    // Lower the three clause bodies to Logos expression text.
    let on_e: SExpr = WAny::ref_to(on_word as *const u8).view::<SExpr>();
    let proj_e: SExpr = WAny::ref_to(proj_word as *const u8).view::<SExpr>();
    let mut on_body: String = String::new();
    emit_sexpr(&mut on_body, on_e, &ty, x_var);
    let mut proj_body: String = String::new();
    emit_sexpr(&mut proj_body, proj_e, &ty, x_var);
    let mut where_body: String = String::new();
    if has_where {
        let where_e: SExpr = WAny::ref_to(where_word as *const u8).view::<SExpr>();
        emit_sexpr(&mut where_body, where_e, &ty, x_var);
    }

    let mut em: Emitter = Emitter::new();
    em.emit_into("test");
    em.push_text("pub fn ");
    em.push_text(fn_name);
    em.push_text("(");
    em.push_text(a_name);
    em.push_text(": &[");
    em.push_text(a_ty);
    em.push_text("], ");
    em.push_text(b_name);
    em.push_text(": &[");
    em.push_text(b_ty);
    em.push_text("]");
    emit_params(&mut em, &ty);
    em.push_text(") -> Vec<");
    em.push_text(result_ty);
    em.push_text("> {\n");
    em.push_text("    let mut __out: Vec<");
    em.push_text(result_ty);
    em.push_text("> = Vec::<");
    em.push_text(result_ty);
    em.push_text(">::new();\n");
    em.push_text("    let mut __i: i64 = 0i64;\n");
    em.push_text("    while __i < (");
    em.push_text(a_name);
    em.push_text(").len() {\n");
    em.push_text("        let ");
    em.push_text(x_var);
    em.push_text(": &");
    em.push_text(a_ty);
    em.push_text(" = &(");
    em.push_text(a_name);
    em.push_text(")[__i];\n");
    if is_anti {
        // ANTI: scan b for ANY match; push x's projection iff none matched.
        em.push_text("        let mut __matched: bool = false;\n");
        em.push_text("        let mut __j: i64 = 0i64;\n");
        em.push_text("        while __j < (");
        em.push_text(b_name);
        em.push_text(").len() {\n");
        em.push_text("            let ");
        em.push_text(y_var);
        em.push_text(": &");
        em.push_text(b_ty);
        em.push_text(" = &(");
        em.push_text(b_name);
        em.push_text(")[__j];\n");
        em.push_text("            if (");
        em.push_text(string_as_str(&on_body));
        em.push_text(") { __matched = true; }\n");
        em.push_text("            __j = __j + 1i64;\n");
        em.push_text("        }\n");
        em.push_text("        if (!__matched) {\n");
        if has_where {
            em.push_text("            if (");
            em.push_text(string_as_str(&where_body));
            em.push_text(") { __out.push(");
            em.push_text(string_as_str(&proj_body));
            em.push_text("); }\n");
        } else {
            em.push_text("            __out.push(");
            em.push_text(string_as_str(&proj_body));
            em.push_text(");\n");
        }
        em.push_text("        }\n");
    } else {
        // INNER: emit the projection for each matching (x, y) pair.
        em.push_text("        let mut __j: i64 = 0i64;\n");
        em.push_text("        while __j < (");
        em.push_text(b_name);
        em.push_text(").len() {\n");
        em.push_text("            let ");
        em.push_text(y_var);
        em.push_text(": &");
        em.push_text(b_ty);
        em.push_text(" = &(");
        em.push_text(b_name);
        em.push_text(")[__j];\n");
        em.push_text("            if (");
        em.push_text(string_as_str(&on_body));
        em.push_text(") {\n");
        if has_where {
            em.push_text("                if (");
            em.push_text(string_as_str(&where_body));
            em.push_text(") { __out.push(");
            em.push_text(string_as_str(&proj_body));
            em.push_text("); }\n");
        } else {
            em.push_text("                __out.push(");
            em.push_text(string_as_str(&proj_body));
            em.push_text(");\n");
        }
        em.push_text("            }\n");
        em.push_text("            __j = __j + 1i64;\n");
        em.push_text("        }\n");
    }
    em.push_text("        __i = __i + 1i64;\n");
    em.push_text("    }\n");
    em.push_text("    return __out;\n");
    em.push_text("}\n");
    em.commit();
}

// Emit `, <pname>: <ty>` for each interned param, where `<ty>` follows the
// param's DECLARED value-type (surface `with $x:str`): str → `str`, bool →
// `bool`, otherwise the i64 default. Params flow as generated-fn arguments
// (the sqlx prepared-statement model, ADR §10.3).
// True iff the projection's ROOT SExpr is a comprehension (→ the row push value
// is a `Vec<Elem>`, so the query returns `Vec<Vec<Elem>>`).
fn is_comp_root(e: SExpr) -> bool {
    match e {
        SExpr::Comp(_) => { return true; }
        _ => { return false; }
    }
}

// The EL value-type of a comprehension projection's HEAD expression (the element
// type of the produced list) — used to infer the inner `result_ty` of a
// `select [ h for v in xs ]` query when no explicit annotation is given.
fn comp_head_ty(e: SExpr, t: &ElTypes) -> i32 {
    match e {
        SExpr::Comp(cp) => { return infer_ty(cp.head_expr(), t); }
        _ => { return EL_TY_INT(); }
    }
}

// ── Phase 4: RAggr — group-by + aggregates (count/sum/min/max/avg) ────────
// Surface (continuing past the first `from <a>:[A] x`):
//
//   [ where <pred> ] group by <keyExpr>
//   aggregate <name1> = <fn>(<expr>?) , <name2> = <fn>(<expr>?) , …
//   select <proj> : <ResultTy> [ with … ]
//
// Lowered to a native two-pass nested loop over the source slice (the corpus is
// small literal slices — queue-1 does NOT yet build a hash table): the OUTER
// pass walks rows to discover each DISTINCT group key; for each new key an INNER
// pass folds the aggregates over all rows in that group. The group key is bound
// in the projection scope as the local `key`; each aggregate as a local of its
// declared `<name>`. The projection (an EL expr) references `key` / `<name>` as
// bare identifiers (emitted as plain locals), so `select key + total : i64`
// composes the grouped row. `<fn>` ∈ count / sum / min / max / avg (i64 MVP;
// avg = integer `sum / count`).
//
// Aggregate fn ids.
fn AGG_COUNT() -> i32 { return 1i32; }
fn AGG_SUM()   -> i32 { return 2i32; }
fn AGG_MIN()   -> i32 { return 3i32; }
fn AGG_MAX()   -> i32 { return 4i32; }
fn AGG_AVG()   -> i32 { return 5i32; }

fn agg_of_name(name: str) -> i32 {
    if str_eq(name, "count") { return AGG_COUNT(); }
    if str_eq(name, "sum")   { return AGG_SUM(); }
    if str_eq(name, "min")   { return AGG_MIN(); }
    if str_eq(name, "max")   { return AGG_MAX(); }
    if str_eq(name, "avg")   { return AGG_AVG(); }
    return 0i32;
}

// Max distinct aggregate columns a single `group by` query materializes.
fn AGG_MAX_COLS() -> i64 { return 8i64; }

fn emit_aggregate(lx: &mut QLexer, s: str, fn_name: str,
                  a_name: str, a_ty: str, x_var: str) {
    // [ where <pred> ]  (filter rows BEFORE grouping)
    let mut where_text: str = "";
    let mut has_where: bool = false;
    if lx.eat_kw("where") {
        where_text = lx.take_until_any3("group", "", "");
        has_where = true;
    }

    // group by <keyExpr>
    if !lx.eat_kw("group") { error("wql!: aggregate expects `group by <key>`"); return; }
    if !lx.eat_kw("by")    { error("wql!: aggregate expects `by <key>`"); return; }
    let key_text: str = lx.take_until_any3("aggregate", "select", "");

    // aggregate <name> = <fn>(<expr>?) , …
    // Collect each item's NAME slice (into `s`), fn id, and inner-expr text.
    let mut acount: i64 = 0i64;
    let mut a_name_start: [i64; 8] = [0i64; 8];
    let mut a_name_len:   [i64; 8] = [0i64; 8];
    let mut a_fn:         [i32; 8] = [0i32; 8];
    let mut a_expr_start: [i64; 8] = [0i64; 8];
    let mut a_expr_len:   [i64; 8] = [0i64; 8];
    if !lx.eat_kw("aggregate") { error("wql!: aggregate expects `aggregate <name>=<fn>(…)`"); return; }
    loop {
        lx.skip_ws();
        let ns: i64 = lx.pos;
        let nl: i64 = lx.scan_ident();
        if nl == 0i64 { error("wql!: aggregate expects `<name> = <fn>(…)`"); return; }
        lx.skip_ws();
        if lx.cur() != 61u8 { error("wql!: aggregate expects `=` after column name"); return; }  // '='
        lx.bump();
        lx.skip_ws();
        let fs: i64 = lx.pos;
        let fl: i64 = lx.scan_ident();
        let fname: str = unsafe { wql_str_range(s, fs, fl) };
        let fnid: i32 = agg_of_name(fname);
        if fnid == 0i32 { error("wql!: aggregate fn must be count/sum/min/max/avg"); return; }
        lx.skip_ws();
        if lx.cur() != 40u8 { error("wql!: aggregate fn expects `(`"); return; }  // '('
        lx.bump();
        let es: i64 = lx.pos;
        // inner expr text up to the matching ')' (depth-balanced).
        let mut depth: i64 = 0i64;
        loop {
            let c: u8 = lx.cur();
            if c == 0u8 { error("wql!: aggregate fn `(` unterminated"); return; }
            if c == 40u8 { depth = depth + 1i64; }
            else if c == 41u8 {
                if depth == 0i64 { break; }
                depth = depth - 1i64;
            }
            lx.bump();
        }
        let ee: i64 = lx.pos;
        lx.bump();  // consume ')'
        if acount < AGG_MAX_COLS() {
            a_name_start[acount] = ns; a_name_len[acount] = nl;
            a_fn[acount]         = fnid;
            a_expr_start[acount] = es; a_expr_len[acount] = ee - es;
            acount = acount + 1i64;
        } else { error("wql!: too many aggregate columns"); return; }
        lx.skip_ws();
        if lx.cur() == 44u8 { lx.bump(); continue; }  // ','
        break;
    }

    // select <proj> : <ResultTy>
    if !lx.eat_kw("select") { error("wql!: aggregate expects `select <expr> : <Ty>`"); return; }
    let proj_text: str = lx.take_until_colon();
    lx.skip_ws();
    if lx.cur() != 58u8 { error("wql!: aggregate `select` needs `: <ResultTy>`"); return; }
    lx.bump();
    let result_ty: str = lx.scan_ident_str();

    let mut d: WithDecls = with_decls_new();
    if !parse_with(lx, &mut d) { error("wql!: malformed `with` clause"); return; }

    let h: Writ = writ_new(4096i64);

    // Parse the key, where, projection, and each aggregate inner-expr.
    let mut kp: ElParser = el_parser_new(key_text);
    let key_word: i64 = kp.parse_root(&h).raw();
    if key_word == 0i64 { error("wql!: malformed `group by` key"); return; }

    let mut wp: ElParser = el_parser_new(where_text);
    let mut where_word: i64 = 0i64;
    if has_where {
        where_word = wp.parse_root(&h).raw();
        if where_word == 0i64 { error("wql!: malformed aggregate `where` predicate"); return; }
    }

    let mut pp: ElParser = el_parser_new(proj_text);
    let proj_word: i64 = pp.parse_root(&h).raw();
    if proj_word == 0i64 { error("wql!: malformed aggregate `select` expression"); return; }

    // Build the type dict: reflect the source schema, apply `with`, merge params.
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, a_ty);
    apply_with_types(&mut ty, &d, s);
    merge_params(&mut ty, &kp);
    merge_params(&mut ty, &wp);
    merge_params(&mut ty, &pp);

    let key_e: SExpr = WAny::ref_to(key_word as *const u8).view::<SExpr>();
    let mut key_body: String = String::new();
    emit_sexpr(&mut key_body, key_e, &ty, x_var);
    let mut where_body: String = String::new();
    if has_where {
        let where_e: SExpr = WAny::ref_to(where_word as *const u8).view::<SExpr>();
        emit_sexpr(&mut where_body, where_e, &ty, x_var);
    }
    let proj_e: SExpr = WAny::ref_to(proj_word as *const u8).view::<SExpr>();
    let mut proj_body: String = String::new();
    emit_sexpr(&mut proj_body, proj_e, &ty, x_var);

    // Lower each aggregate inner-expr to text (count() has none).
    let mut agg_body: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut ai: i64 = 0i64;
    while ai < acount {
        if a_fn[ai] != AGG_COUNT() {
            let etext: str = unsafe { wql_str_range(s, a_expr_start[ai], a_expr_len[ai]) };
            let mut ep: ElParser = el_parser_new(etext);
            let ew: i64 = ep.parse_root(&h).raw();
            if ew == 0i64 { error("wql!: malformed aggregate fn argument"); return; }
            merge_params(&mut ty, &ep);
            let ee_e: SExpr = WAny::ref_to(ew as *const u8).view::<SExpr>();
            emit_sexpr(&mut agg_body[ai], ee_e, &ty, x_var);
        }
        ai = ai + 1i64;
    }

    // ── Emit the grouped two-pass loop ────────────────────────────────────
    let mut em: Emitter = Emitter::new();
    em.emit_into("test");
    em.push_text("pub fn ");
    em.push_text(fn_name);
    em.push_text("(");
    em.push_text(a_name);
    em.push_text(": &[");
    em.push_text(a_ty);
    em.push_text("]");
    emit_params(&mut em, &ty);
    em.push_text(") -> Vec<");
    em.push_text(result_ty);
    em.push_text("> {\n");
    em.push_text("    let mut __out: Vec<");
    em.push_text(result_ty);
    em.push_text("> = Vec::<");
    em.push_text(result_ty);
    em.push_text(">::new();\n");
    em.push_text("    let mut __seen: Vec<i64> = Vec::<i64>::new();\n");
    em.push_text("    let mut __i: i64 = 0i64;\n");
    em.push_text("    while __i < (");
    em.push_text(a_name);
    em.push_text(").len() {\n");
    em.push_text("        let ");
    em.push_text(x_var);
    em.push_text(": &");
    em.push_text(a_ty);
    em.push_text(" = &(");
    em.push_text(a_name);
    em.push_text(")[__i];\n");
    // Skip rows filtered out by `where` before they seed a group.
    if has_where {
        em.push_text("        if (");
        em.push_text(string_as_str(&where_body));
        em.push_text(") {\n");
    }
    em.push_text("        let __k: i64 = (");
    em.push_text(string_as_str(&key_body));
    em.push_text(");\n");
    // Dedup: only process each distinct key once (first occurrence).
    em.push_text("        let mut __f: bool = false;\n");
    em.push_text("        let mut __s: i64 = 0i64;\n");
    em.push_text("        while __s < __seen.len() { if __seen.get(__s) == __k { __f = true; } __s = __s + 1i64; }\n");
    em.push_text("        if (!__f) {\n");
    em.push_text("            __seen.push(__k);\n");
    // Aggregate accumulators.
    let mut c0: i64 = 0i64;
    while c0 < acount {
        let aname: str = unsafe { wql_str_range(s, a_name_start[c0], a_name_len[c0]) };
        em.push_text("            let mut __agg_");
        em.push_text(aname);
        if a_fn[c0] == AGG_MIN() {
            em.push_text(": i64 = 9223372036854775807i64;\n");  // i64::MAX seed for min
        } else if a_fn[c0] == AGG_MAX() {
            em.push_text(": i64 = -9223372036854775808i64;\n"); // i64::MIN seed for max
        } else {
            em.push_text(": i64 = 0i64;\n");
        }
        c0 = c0 + 1i64;
    }
    em.push_text("            let mut __cnt: i64 = 0i64;\n");
    // Inner fold pass over the group.
    em.push_text("            let mut __j: i64 = 0i64;\n");
    em.push_text("            while __j < (");
    em.push_text(a_name);
    em.push_text(").len() {\n");
    em.push_text("                let ");
    em.push_text(x_var);
    em.push_text(": &");
    em.push_text(a_ty);
    em.push_text(" = &(");
    em.push_text(a_name);
    em.push_text(")[__j];\n");
    // Re-apply `where` inside the inner pass so filtered rows never accumulate.
    if has_where {
        em.push_text("                if (");
        em.push_text(string_as_str(&where_body));
        em.push_text(") {\n");
    }
    em.push_text("                if ((");
    em.push_text(string_as_str(&key_body));
    em.push_text(") == __k) {\n");
    em.push_text("                    __cnt = __cnt + 1i64;\n");
    let mut c1: i64 = 0i64;
    while c1 < acount {
        let aname2: str = unsafe { wql_str_range(s, a_name_start[c1], a_name_len[c1]) };
        let fnid2: i32 = a_fn[c1];
        if fnid2 == AGG_COUNT() {
            em.push_text("                    __agg_");
            em.push_text(aname2);
            em.push_text(" = __agg_");
            em.push_text(aname2);
            em.push_text(" + 1i64;\n");
        } else if fnid2 == AGG_SUM() || fnid2 == AGG_AVG() {
            em.push_text("                    __agg_");
            em.push_text(aname2);
            em.push_text(" = __agg_");
            em.push_text(aname2);
            em.push_text(" + (");
            em.push_text(string_as_str(&agg_body[c1]));
            em.push_text(");\n");
        } else if fnid2 == AGG_MIN() {
            em.push_text("                    { let __v: i64 = (");
            em.push_text(string_as_str(&agg_body[c1]));
            em.push_text("); if __v < __agg_");
            em.push_text(aname2);
            em.push_text(" { __agg_");
            em.push_text(aname2);
            em.push_text(" = __v; } }\n");
        } else {  // AGG_MAX
            em.push_text("                    { let __v: i64 = (");
            em.push_text(string_as_str(&agg_body[c1]));
            em.push_text("); if __v > __agg_");
            em.push_text(aname2);
            em.push_text(" { __agg_");
            em.push_text(aname2);
            em.push_text(" = __v; } }\n");
        }
        c1 = c1 + 1i64;
    }
    em.push_text("                }\n");
    if has_where { em.push_text("                }\n"); }
    em.push_text("                __j = __j + 1i64;\n");
    em.push_text("            }\n");
    // Bind the grouped row's locals for the projection: `key` + each agg name.
    em.push_text("            let key: i64 = __k;\n");
    let mut c2: i64 = 0i64;
    while c2 < acount {
        let aname3: str = unsafe { wql_str_range(s, a_name_start[c2], a_name_len[c2]) };
        em.push_text("            let ");
        em.push_text(aname3);
        em.push_text(": i64 = ");
        if a_fn[c2] == AGG_AVG() {
            em.push_text("(if __cnt > 0i64 { __agg_");
            em.push_text(aname3);
            em.push_text(" / __cnt } else { 0i64 });\n");
        } else {
            em.push_text("__agg_");
            em.push_text(aname3);
            em.push_text(";\n");
        }
        c2 = c2 + 1i64;
    }
    em.push_text("            __out.push(");
    em.push_text(string_as_str(&proj_body));
    em.push_text(");\n");
    em.push_text("        }\n");        // close if(!__f)
    if has_where { em.push_text("        }\n"); }  // close where guard
    em.push_text("        __i = __i + 1i64;\n");
    em.push_text("    }\n");
    em.push_text("    return __out;\n");
    em.push_text("}\n");
    em.commit();
}

// Emit `, <pname>: <ty>` for each param in the dict's ordered arg list, where
// `<ty>` follows the param's value-type (from `with`/reflection): str → `str`,
// bool → `bool`, otherwise the i64 default; a comprehension SOURCE param flows as
// a `&[Elem]` slice. Params flow as generated-fn arguments (the sqlx model).
fn emit_params(em: &mut Emitter, t: &ElTypes) {
    let n: i64 = t.param_count();
    let mut i: i64 = 0i64;
    while i < n {
        let pname: str = t.param_name(i);
        em.push_text(", ");
        em.push_text(pname);
        let pty: i32 = t.ty_of(pname);
        if t.is_source(pname) {
            // A comprehension source flows as a `&[Elem]` slice argument; the
            // element type follows the param's declared value-type (`with`).
            em.push_text(": &[");
            if pty == EL_TY_STR()       { em.push_text("str"); }
            else if pty == EL_TY_BOOL() { em.push_text("bool"); }
            else                        { em.push_text("i64"); }
            em.push_text("]");
        }
        else if pty == EL_TY_STR()  { em.push_text(": str"); }
        else if pty == EL_TY_BOOL() { em.push_text(": bool"); }
        else                        { em.push_text(": i64"); }
        i = i + 1i64;
    }
}

impl QLexer {
    // Scan an identifier at the cursor and RETURN its slice directly (do NOT
    // stash it in a field — a `str` field aliases and every later read sees the
    // most-recent scan, which silently collapsed all four clause names to the
    // last one). Returns an empty `str` if the cursor is not at an identifier.
    fn scan_ident_str(self: &mut QLexer) -> str {
        self.skip_ws();
        let start: i64 = self.pos;
        let _len: i64 = self.scan_ident();
        return unsafe { wql_str_range(self.src, start, self.pos - start) };
    }
    // Take projection bytes up to the result-type `:` separator, the `with`
    // clause, or EOI. A `select` may contain a TERNARY (`c ? t : e`), whose `:`
    // must NOT be mistaken for the type separator — so balance `?`/`:`: each `?`
    // opens a ternary that the next `:` closes; the FIRST `:` at depth 0 is the
    // (optional) result-type annotation. Phase 5a made `: <Ty>` optional, so the
    // projection can run straight into `with …` (no result colon) or to EOI — we
    // also stop at a depth-0 `with` keyword so `select p.name with name:str` does
    // not swallow the `with`-clause's own `:` as the result separator. (String
    // literals in the projection cannot contain a bare `:`/`with` outside quotes.)
    fn take_until_colon(self: &mut QLexer) -> str {
        self.skip_ws();
        let start: i64 = self.pos;
        let mut end: i64 = self.len;
        let mut q: i64 = self.pos;
        let mut depth: i64 = 0i64;
        while q < self.len {
            let c: u8 = str_byte_at(self.src, q);
            if c == 63u8 { depth = depth + 1i64; }            // '?'
            else if c == 58u8 {                               // ':'
                if depth == 0i64 { end = q; break; }
                depth = depth - 1i64;
            }
            else if depth == 0i64 && qlex_at_word(self.src, self.len, q, "with") {
                end = q; break;
            }
            q = q + 1i64;
        }
        self.pos = end;
        while end > start && ql_is_space(str_byte_at(self.src, end - 1i64)) { end = end - 1i64; }
        return unsafe { wql_str_range(self.src, start, end - start) }
    }
}

// Is keyword `kw` at byte index `q` in `src` (word boundary on both sides)? A
// free helper (no cursor) for the projection carver's `with`-stop scan.
fn qlex_at_word(src: str, len: i64, q: i64, kw: str) -> bool {
    let n: i64 = kw.len();
    if q + n > len { return false; }
    let mut i: i64 = 0i64;
    while i < n {
        if str_byte_at(src, q + i) != str_byte_at(kw, i) { return false; }
        i = i + 1i64;
    }
    let before: u8 = if q > 0i64 { str_byte_at(src, q - 1i64) } else { 32u8 };
    let after: u8 = if q + n < len { str_byte_at(src, q + n) } else { 0u8 };
    return !ql_is_alnum(before) && !ql_is_alnum(after);
}
