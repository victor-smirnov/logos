// logos.std.wql.wql — the `wql!{ … }` RESOURCE surface (ADR 0012 §6 / §10.2,
// queue-1 STATIC lowering). A `#[token_macro]` handler receives the raw block
// text at compile time, PARSES it via the peg-GENERATED surface parser
// (`wql_surface_parser::parse_query` → an `RQuery` query-PLAN, itself Writ
// schemas — ADR 0011 dogfood), then WALKS that schema'd plan to EMIT a native
// Logos function (`plan_walker::walk_query`) that iterates the source, filters,
// and collects the projected rows — the "prepared statement" model (no
// runtime-string queries; ADR 0012 §queues).
//
// This is the "peg + Writ-schemas all the way" frontend: the hand-written
// QLexer clause carver + the procedural cursor-driven emit are GONE (retired in
// Phase 4). Clause STRUCTURE lives in the grammar (`grammars/wql.peg`); the
// embedded EL clause bodies (`where` / `select` / `on` / group-key /
// aggregate-args) are parsed by the generated EL parser (`el_parser::parse_expr`,
// %imported by the surface grammar) into the SExpr IR and hang off the plan node
// as `WRef<SExpr>` edges; all emit logic is the walker (`plan_walker.logos`).
//
// MVP surface (explicit-typed, per the ADR static model — schema/types always
// known at compile time, params/sources flow as generated-fn arguments):
//
//   resource <name> = wql! {
//       from <src>:[<RowTy>] <var>
//       [ where <predicate-EL> ]
//       select <projection-EL> [ : <ResultTy> ]
//       [ with [$]<name>:<ty>, … ]
//   };
//
//   →  pub fn <name>(<src>: &[<RowTy>], <$param>: <PTy>, …) -> Vec<ResultTy> { … }
//
// The generated fn NAME is the `resource <name> =` binding (ADR 0012 §6), NOT an
// `fn <name>` line inside the block; the handler receives it as the `name` arg.
//
// plus the relational shapes off the same `from` prefix:
//   • `[anti] join <b>:[<BTy>] <y> on <onPred>` → inner / anti nested-loop join;
//   • `[where …] group by <key> aggregate <a>=<fn>(<e>),…` → group-by + aggregate;
// and the SINGLE-ROW forms:
//   • `select first <S>` (simple/join) → Option<ElemTy>, the first projected
//     value (scan order, or ORDER BY order); excludes distinct/limit;
//   • `from <src>:[<Ty>] <v> find <P>` → Option<&Ty>, a borrow of the first
//     matching row (early-exit, zero-copy); takes no other clause.
// The RQuery plan family (`logos.std.wql.plan`) has one schema variant per shape;
// the walker (`plan_walker.logos`) dispatches on it via `match`.
//
// Runtime params `$x:Ty` flow as generated-fn ARGUMENTS (sqlx model, ADR
// §10.3); the source `<src>` is the first argument (an explicit `&[RowTy]`
// slice). The data is supplied by the caller at the `<name>(…)` call site.
package logos.std.wql.wql;

use logos.std.compiler.metaprog;         // ItemList, item_list_new, error
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.std.wql.wql_surface_parser;    // parse_query — the GENERATED surface parser
use logos.std.wql.plan_walker;           // walk_query_any — the plan walker-emitter

// ── The resource handler ───────────────────────────────────────────────────
// `#[token_macro]`: receives the raw `wql!{ … }` block bytes as a single `str`.
// PARSE (peg-generated surface parser → RQuery plan) then WALK (plan_walker →
// emitted native fn). The emitted source is spliced by the host's Emitter/
// `logos_emit_source` (ADR 0012 §10.2); the handler returns an (empty) ItemList.
#[token_macro]
pub fn wql(name: str, body: str) -> ItemList {
    let out: ItemList = item_list_new();
    if name.len() == 0i64 {
        error("wql!: needs a binding name — write `resource <name> = wql!{ from … select … }`");
        return out;
    }
    let h: Writ = writ_new(4096i64);
    let root: WAny = parse_query(body, &h);
    if root.is_null() { error("wql!: malformed query (expected `from <src>:[<Ty>] <var> … select …`)"); return out; }
    let _ok: bool = walk_query_any_named(root, name, &h);
    return out;
}
