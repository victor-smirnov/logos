// Embedded-expression scan (cross-grammar EL seam): find the first
// close-tag delimiter (}} / %}) at/after `pos`; -1 if none. The embedded
// expression occupies [pos, close) (a trailing `-` trim marker excluded
// by the caller). Mirrors the hand TrParser's find_close_expr/stmt.
fn embed_find_close(src: str, pos: i64, len: i64) -> i64 {
    let mut p: i64 = pos;
    while p + 1i64 < len {
        if (str_byte_at(src, p) == 125u8 && str_byte_at(src, p + 1i64) == 125u8) || (str_byte_at(src, p) == 37u8 && str_byte_at(src, p + 1i64) == 125u8) { return p; }
