}

fn alt_stmt_close_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    if lex.peek().kind != TrTK_RSTMT { lex.reset(sp, sln); return TrNULLP; }
    let tk1: Token = lex.next();
    let cap1: *const u8 = wstr_p(doc, tk1.text(lex.src));
    return cap1;
}

fn alt_stmt_close_1(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    if lex.peek().kind != TrTK_RSTMT_TRIM { lex.reset(sp, sln); return TrNULLP; }
    let tk1: Token = lex.next();
    let cap1: *const u8 = wstr_p(doc, tk1.text(lex.src));
    return cap1;
}

fn rule_stmt_close(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_stmt_close_0(lex, doc); if r != TrNULLP { return r; } }
    { let r: *const u8 = alt_stmt_close_1(lex, doc); if r != TrNULLP { return r; } }
    return TrNULLP;
}

fn alt_expr_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    // ── embedded cross-grammar parse (T2): scan raw sub-range + sub-parse ──
    let est_cap1: i64 = lex.save_pos();
    let ecl_cap1: i64 = embed_find_close(lex.src, est_cap1, lex.src.len());
    if ecl_cap1 < 0i64 { lex.reset(sp, sln); return TrNULLP; }
    let mut eend_cap1: i64 = ecl_cap1;
    if eend_cap1 > est_cap1 && str_byte_at(lex.src, eend_cap1 - 1i64) == 45u8 { eend_cap1 = eend_cap1 - 1i64; }
    let esub_cap1: str = unsafe { str_from_raw((lex.src.as_ptr() as i64 + est_cap1) as *const u8, eend_cap1 - est_cap1) };
    let eroot_cap1: WAny = logos.std.wql.el_parser::parse_expr(esub_cap1, doc);
    lex.reset(eend_cap1, lex.save_line());
    let cap1: *const u8 = if eroot_cap1.is_null() { TrNULLP } else { eroot_cap1.raw() as *const u8 };
    if cap1 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    return cap1;
}

fn rule_expr_impl(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_expr_0(lex, doc); if r != TrNULLP { return r; } }
    return TrNULLP;
}
fn rule_expr(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let mk: i64 = lex.save_pos() * 1024i64 + 9i64;
    let mut hok: bool = false; let mut hr: *const u8 = TrNULLP; let mut hep: i64 = 0i64; let mut hel: i64 = 0i64;
    unsafe {
        let mp: *mut HashMap<i64, TrMemoCell> = &mut lex.memo;
        let hp: *const TrMemoCell = mp.get(&mk);
        if hp != (0i64 as *const TrMemoCell) { hok = true; hr = (*hp).res; hep = (*hp).endpos; hel = (*hp).endline; }
    }
    if hok { lex.reset(hep, hel); return hr; }
    let r: *const u8 = rule_expr_impl(lex, doc);
    let ep: i64 = lex.save_pos(); let el: i64 = lex.save_line();
    unsafe { let mp: *mut HashMap<i64, TrMemoCell> = &mut lex.memo; mp.insert(mk, TrMemoCell { res: r, endpos: ep, endline: el }); }
    return r;
}

// ── Public entry points (one per %export rule) ─────────────────────────────

pub fn parse_tpl(src: str, doc: &Writ) -> WAny {
    let mut lex: Lexer = lexer_new(src);
    let root: *const u8 = rule_tpl(&mut lex, doc);
    if !lex.at_eof() { return WAny::ref_to(TrNULLP); }
    return WAny::ref_to(root);
}

