        if rep0 != TrNULLP { arr0.push(WAny::ref_to(rep0)); }
        if lex.save_pos() == rsp { break; }
        cnt0 = cnt0 + 1i64;
    }
    let cap1: *const u8 = arr0 as *const WArray<WAny> as *const u8;
    return cap1;
}

