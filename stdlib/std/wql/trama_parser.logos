fn rule_stmt_open(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_stmt_open_0(lex, doc); if r != TrNULLP { return r; } }
    { let r: *const u8 = alt_stmt_open_1(lex, doc); if r != TrNULLP { return r; } }
