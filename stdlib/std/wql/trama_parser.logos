fn alt_set_stmt_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    let cap1: *const u8 = rule_stmt_open(lex, doc);
    if cap1 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    if lex.peek().kind != TrTK_KW_SET { lex.reset(sp, sln); return TrNULLP; }
    let tk2: Token = lex.next();
    let cap2: *const u8 = wstr_p(doc, tk2.text(lex.src));
    if lex.peek().kind != TrTK_IDENT { lex.reset(sp, sln); return TrNULLP; }
    let tk3: Token = lex.next();
    let cap3: *const u8 = wstr_p(doc, tk3.text(lex.src));
    if lex.peek().kind != TrTK_EQ { lex.reset(sp, sln); return TrNULLP; }
    let tk4: Token = lex.next();
    let cap4: *const u8 = wstr_p(doc, tk4.text(lex.src));
    let cap5: *const u8 = rule_expr(lex, doc);
    if cap5 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    let cap6: *const u8 = rule_stmt_close(lex, doc);
    if cap6 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    let node: TSet = doc.make::<TSet>();
    node.var = wstr_as_str(cap3);
    node.expr = WRef::<SExpr>::from_any(hand_any(cap5));
    return node.as_ref().raw() as *const u8;
}

fn rule_set_stmt(lex: &mut Lexer, doc: &Writ) -> *const u8 {
