    if lex.peek().kind != TrTK_LMUST { lex.reset(sp, sln); return TrNULLP; }
    let tk1: Token = lex.next();
    let cap1: *const u8 = wstr_p(doc, tk1.text(lex.src));
    let cap2: *const u8 = rule_expr(lex, doc);
    if cap2 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    if lex.peek().kind != TrTK_RMUST { lex.reset(sp, sln); return TrNULLP; }
    let tk3: Token = lex.next();
    let cap3: *const u8 = wstr_p(doc, tk3.text(lex.src));
    let node: TVar = doc.make::<TVar>();
    node.expr = WRef::<SExpr>::from_any(hand_any(cap2));
    return node.as_ref().raw() as *const u8;
}

