}

fn alt_for_stmt_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    let cap1: *const u8 = rule_stmt_open(lex, doc);
    if cap1 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    if lex.peek().kind != TrTK_KW_FOR { lex.reset(sp, sln); return TrNULLP; }
    let tk2: Token = lex.next();
    let cap2: *const u8 = wstr_p(doc, tk2.text(lex.src));
    if lex.peek().kind != TrTK_IDENT { lex.reset(sp, sln); return TrNULLP; }
    let tk3: Token = lex.next();
    let cap3: *const u8 = wstr_p(doc, tk3.text(lex.src));
    if lex.peek().kind != TrTK_KW_IN { lex.reset(sp, sln); return TrNULLP; }
    let tk4: Token = lex.next();
    let cap4: *const u8 = wstr_p(doc, tk4.text(lex.src));
    let cap5: *const u8 = rule_expr(lex, doc);
    if cap5 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    let cap6: *const u8 = rule_stmt_close(lex, doc);
    if cap6 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    let cap7: *const u8 = rule_tpl(lex, doc);
    let cap8: *const u8 = rule_stmt_open(lex, doc);
    if cap8 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    if lex.peek().kind != TrTK_KW_ENDFOR { lex.reset(sp, sln); return TrNULLP; }
    let tk9: Token = lex.next();
    let cap9: *const u8 = wstr_p(doc, tk9.text(lex.src));
    let cap10: *const u8 = rule_stmt_close(lex, doc);
    if cap10 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    let node: TFor = doc.make::<TFor>();
    node.body = WRef::<TStmt>::from_any(hand_any(cap7));
    node.var = wstr_as_str(cap3);
    node.expr = WRef::<SExpr>::from_any(hand_any(cap5));
    return node.as_ref().raw() as *const u8;
}

fn rule_for_stmt(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_for_stmt_0(lex, doc); if r != TrNULLP { return r; } }
    return TrNULLP;
}

fn alt_if_stmt_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    let cap1: *const u8 = rule_stmt_open(lex, doc);
    if cap1 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    if lex.peek().kind != TrTK_KW_IF { lex.reset(sp, sln); return TrNULLP; }
    let tk2: Token = lex.next();
    let cap2: *const u8 = wstr_p(doc, tk2.text(lex.src));
    let cap3: *const u8 = rule_expr(lex, doc);
    if cap3 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    let cap4: *const u8 = rule_stmt_close(lex, doc);
    if cap4 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    let cap5: *const u8 = rule_tpl(lex, doc);
    let cap6: *const u8 = rule_if_tail(lex, doc);
    let cap7: *const u8 = rule_stmt_open(lex, doc);
    if cap7 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    if lex.peek().kind != TrTK_KW_ENDIF { lex.reset(sp, sln); return TrNULLP; }
    let tk8: Token = lex.next();
    let cap8: *const u8 = wstr_p(doc, tk8.text(lex.src));
    let cap9: *const u8 = rule_stmt_close(lex, doc);
    if cap9 == TrNULLP { lex.reset(sp, sln); return TrNULLP; }
    let node: TIf = doc.make::<TIf>();
    node.body = WRef::<TStmt>::from_any(hand_any(cap5));
    node.expr = WRef::<SExpr>::from_any(hand_any(cap3));
    node.alt = WRef::<TStmt>::from_any(hand_any(cap6));
    return node.as_ref().raw() as *const u8;
}

fn rule_if_stmt(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_if_stmt_0(lex, doc); if r != TrNULLP { return r; } }
    return TrNULLP;
}

fn alt_if_tail_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    let mut cap1: *const u8 = TrNULLP;
    let mut gdone0: bool = false;
    if !gdone0 {
        let gsp: i64 = lex.save_pos(); let gsln: i64 = lex.save_line();
        loop {
            let gcap1_1_1: *const u8 = rule_stmt_open(lex, doc);
            if gcap1_1_1 == TrNULLP { lex.reset(gsp, gsln); break; }
            if lex.peek().kind != TrTK_KW_ELIF { lex.reset(gsp, gsln); break; }
            let gcap1_2_1_t: Token = lex.next();
            let gcap1_2_1: *const u8 = wstr_p(doc, gcap1_2_1_t.text(lex.src));
            let gcap1_3_1: *const u8 = rule_expr(lex, doc);
            if gcap1_3_1 == TrNULLP { lex.reset(gsp, gsln); break; }
            let gcap1_4_1: *const u8 = rule_stmt_close(lex, doc);
            if gcap1_4_1 == TrNULLP { lex.reset(gsp, gsln); break; }
            let gcap1_5_1: *const u8 = rule_tpl(lex, doc);
            let gcap1_6_1: *const u8 = rule_if_tail(lex, doc);
            let gnode: TIf = doc.make::<TIf>();
            gnode.body = WRef::<TStmt>::from_any(hand_any(gcap1_5_1));
            gnode.expr = WRef::<SExpr>::from_any(hand_any(gcap1_3_1));
            gnode.alt = WRef::<TStmt>::from_any(hand_any(gcap1_6_1));
            cap1 = gnode.as_ref().raw() as *const u8;
            gdone0 = true;
            break;
        }
    }
    if !gdone0 { lex.reset(sp, sln); return TrNULLP; }
    return cap1;
}

fn alt_if_tail_1(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    let mut cap1: *const u8 = TrNULLP;
    {
        let osp: i64 = lex.save_pos(); let osln: i64 = lex.save_line();
        let mut ogdone2: bool = false;
        if !ogdone2 {
            let gsp: i64 = lex.save_pos(); let gsln: i64 = lex.save_line();
            loop {
                let gcap1_1_3: *const u8 = rule_stmt_open(lex, doc);
                if gcap1_1_3 == TrNULLP { lex.reset(gsp, gsln); break; }
                if lex.peek().kind != TrTK_KW_ELSE { lex.reset(gsp, gsln); break; }
                let gcap1_2_3_t: Token = lex.next();
                let gcap1_2_3: *const u8 = wstr_p(doc, gcap1_2_3_t.text(lex.src));
                let gcap1_3_3: *const u8 = rule_stmt_close(lex, doc);
                if gcap1_3_3 == TrNULLP { lex.reset(gsp, gsln); break; }
                let gcap1_4_3: *const u8 = rule_tpl(lex, doc);
                cap1 = gcap1_4_3;
                ogdone2 = true;
                break;
            }
        }
    }
    return cap1;
}

fn rule_if_tail_impl(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    { let r: *const u8 = alt_if_tail_0(lex, doc); if r != TrNULLP { return r; } }
    { let r: *const u8 = alt_if_tail_1(lex, doc); if r != TrNULLP { return r; } }
    return TrNULLP;
}
fn rule_if_tail(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let mk: i64 = lex.save_pos() * 1024i64 + 6i64;
    let mut hok: bool = false; let mut hr: *const u8 = TrNULLP; let mut hep: i64 = 0i64; let mut hel: i64 = 0i64;
    unsafe {
        let mp: *mut HashMap<i64, TrMemoCell> = &mut lex.memo;
        let hp: *const TrMemoCell = mp.get(&mk);
        if hp != (0i64 as *const TrMemoCell) { hok = true; hr = (*hp).res; hep = (*hp).endpos; hel = (*hp).endline; }
    }
    if hok { lex.reset(hep, hel); return hr; }
    let r: *const u8 = rule_if_tail_impl(lex, doc);
    let ep: i64 = lex.save_pos(); let el: i64 = lex.save_line();
    unsafe { let mp: *mut HashMap<i64, TrMemoCell> = &mut lex.memo; mp.insert(mk, TrMemoCell { res: r, endpos: ep, endline: el }); }
    return r;
}

fn alt_stmt_open_0(lex: &mut Lexer, doc: &Writ) -> *const u8 {
    let sp: i64 = lex.save_pos();
    let sln: i64 = lex.save_line();
    let fline: i64 = lex.peek().line;
    if lex.peek().kind != TrTK_LSTMT { lex.reset(sp, sln); return TrNULLP; }
    let tk1: Token = lex.next();
    let cap1: *const u8 = wstr_p(doc, tk1.text(lex.src));
    return cap1;
}

fn alt_stmt_open_1(lex: &mut Lexer, doc: &Writ) -> *const u8 {
