// logos.std.wql.wql_walk — a `wql_walk!` alias of the peg + WALKER spine:
// parse the block via the peg-GENERATED surface parser (`wql_surface_parser::
// parse_query` → an `RQuery` plan), then WALK that schema'd plan to emit the
// native fn (`plan_walker::walk_query_params`). This is the exact same
// peg-all-the-way path the primary `wql!` handler (`wql.logos`) uses — kept as
// a distinct `wql_walk!` entry so the plan-walker spine can be exercised
// directly.
//
// The handler is deliberately tiny: parse params → parse query → walk. All the
// clause structure lives in the grammar (wql.peg), all the emit logic in the
// walker (plan_walker/rexpr_walk), and the embedded-EL clause bodies are
// already SExpr edges on the plan (parsed by the generated EL parser at
// surface-parse time). No cursor, no re-lex.
package logos.std.wql.wql_walk;

use logos.std.compiler.metaprog;         // ItemList, item_list_new, error
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.std.wql.plan;
use logos.std.wql.params;                // MacroParams / parse_macro_params — SHARED with trama!
use logos.std.wql.wql_surface_parser;    // parse_program — the GENERATED surface parser
use logos.std.wql.plan_walker;           // walk_program_params — the program walker-emitter

#[token_macro]
pub fn wql_walk(name: str, params: str, body: str) -> ItemList {
    let out: ItemList = item_list_new();
    if name.len() == 0i64 {
        error("wql_walk!: needs a binding name — write `resource <name> = wql_walk!(<params>){ from … select … }`");
        return out;
    }
    let mut prm: MacroParams = macro_params_new();
    parse_macro_params(params, &mut prm);
    if prm.n == 0i64 {
        error("wql_walk!: needs at least one parameter — write `resource <name> = wql_walk!(<src>: &[RowTy], …){ from <src> <var> … }`");
        return out;
    }
    let h: Writ = writ_new(4096i64);
    let root: WAny = parse_program(body, &h);
    if root.is_null() { error("wql_walk!: malformed query (expected `from <src> <var> … select …`)"); return out; }
    let _ok: bool = walk_program_params(root, name, params, &mut prm, &h);
    return out;
}
