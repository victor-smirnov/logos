// Logos project — https://github.com/victor-smirnov/logos
//
// el.peg — the EL (Expression Language) grammar for peg_gen_logos, in
// SCHEMA-EMISSION mode (ADR 0012 peg-frontend, §6). It specifies construction
// of the EXISTING WQL scalar/relational IR (SExpr / RExpr, `logos.std.wql.ir`)
// as first-class Writ schema views — `doc.make::<S>()` + typed schema field
// writes + `WRef<S>` edges — dogfooding ADR 0011. It is the peg-generated
// replacement for the hand-written recursive-descent `ElParser` in
// `stdlib/std/wql/el.logos`.
//
// The grammar is a FAITHFUL transcription of the EL grammar documented in
// el.logos:9-21 (the CEL-precedence expression chain + the one comprehension
// form):
//
//   expr     := ternary
//   ternary  := or ( '?' expr ':' expr )?            // CEL conditional  → SCond
//   or       := and ( '||' and )*                    // → SBin(OP_OR)
//   and      := equality ( '&&' equality )*          // → SBin(OP_AND)
//   equality := compare ( ('=='|'!=') compare )*     // → SBin(OP_EQ/OP_NE)
//   compare  := add ( ('<='|'>='|'<'|'>') add )*     // → SBin(OP_LT..OP_GE)
//   add      := mul ( ('+'|'-') mul )*               // → SBin(OP_ADD/OP_SUB)
//   mul      := unary ( ('*'|'/'|'%') unary )*       // → SBin(OP_MUL/DIV/MOD)
//   unary    := ('!'|'-') unary | postfix            // → SUn(OP_NOT/OP_NEG)
//   postfix  := primary ( '.' ident )*               // field access → SField
//   primary  := float | int | bool | string | '$' ident | ident ( '(' args ')' )?
//             | '(' expr ',' expr ( ',' expr )* ')'  // TUPLE (≥1 comma) → STuple
//             | '(' expr ')'                         // grouping (no comma)
//             | '[' expr 'for' ident 'in' postfix ( 'if' expr )? ']'  // SComp
//
// LEFT-ASSOCIATIVITY is expressed with fold-mode `$0` (the fold accumulator =
// the running LHS), matching the demo grammar and logos.peg's `add_expr`. Each
// operator gets its OWN fold sub-alternative so it can stamp the correct CEL
// operator id (SBin.op / SUn.op) as an INT_LIT — the op-id table below mirrors
// el.logos's OP_* constants exactly (CEL canon, stable across backends):
//
//   SBin.op: OR=1 AND=2 EQ=3 NE=4 LT=5 LE=6 GT=7 GE=8 ADD=9 SUB=10 MUL=11 DIV=12 MOD=13
//   SUn.op : NOT=1 NEG=2
//
// ── GENERATOR CAPABILITIES (all former gaps CLOSED, 2026-07-01) ─────────────
// The three schema-emission gaps that once forced this grammar to emit
// placeholders are now closed in peg_gen_logos's schema-emission mode; the
// generated el_parser produces the SAME self-describing IR the hand parser does:
//
//   (G1/G3) NAME interning → Option B (self-describing IR). Leaf nodes carry the
//        textual NAME as a `str` field (SField.name / SParam.name / SVar.name /
//        SCall.fn_name / RScan.src_name / SComp.var), populated from the captured
//        IDENT via `wstr_as_str`. No dense ids, no ElParser side tables.
//
//   (G2) SLit.val INTEGER value → a token->i64 decode hook: a captured INTEGER
//        token into a WAny/scalar field is DECODED (`doc.int(wstr_decode_i64($1))`)
//        rather than stored as a WString ref (`emit_schema_field`, guarded by
//        `capture_is_token_named(..,"INTEGER")`). STRING literals stay interned
//        refs; BOOL literals stay exact.
//
//   (G-args) SExprArr FAN-OUT → the `args: "argfan"` schema field spreads an
//        ARRAY_CAPTURE ($...) of arg edges into the fixed slots a0..a7 (set_arg +
//        set_len). Multi-arg calls like `contains(a,b)` carry every arg.
//
//   (G-plan) COMPREHENSION PLAN → assembled by the grammar (comp_plan): the
//        source ident builds an RScan; an optional `if guard` folds it into an
//        RFilter (fold-mode $0 = the running scan). No handler-side assembly.
//
// The head's references to the loop var still parse as SField/SCall by NAME and
// are rebound to SVar at the metacall (the seam's "FE emits symbolic names;
// metacall resolves" contract) — a semantic pass, not a parser concern.

%meta {
    name:      "el"
    version:   "1.0"
    namespace: "logos::wql::el"
    output:    "el_parser"
    package:   "logos.std.wql.el_parser"
    prefix:    "El"
}

// The EL entry rule: a full expression → an SExpr root edge handle.
%export { expr }

// ── SCHEMA-EMISSION binding ────────────────────────────────────────────────
// Each `S { field: "type", ... }` names a grammar node (`=> { CODE: "S", ... }`)
// built as the schema `S` (code = `S::CODE`) with typed field writes. Types MUST
// match the field types in ir.logos exactly so the emitted write is correct:
//   "ref T"  → WRef::<T>::from_any(hand_any(<capture>))   (graph edge)
//   "WAny"   → verbatim dynamic value (literal or captured handle)
//   "str"    → interned string field (captured IDENT / STR_LIT)
//   scalar   → <INT_LIT/BOOL> as <type>
// `arena: external` makes the generated `parse_expr(src, doc: &Writ) -> WAny`
// take the caller's Writ arena (the wql!/trama! handler passes its own `h`).
// `ref_wrap: "WRef"` is the ir.logos edge wrapper (also the default).
%schema {
    use:      "logos.std.wql.ir"
    arena:    external
    ref_wrap: "WRef"

    // Scalar tier — SExpr (ir.logos). SELF-DESCRIBING IR (Option B): leaf nodes
    // carry NAMES as `str` fields, populated from the captured IDENT token — the
    // generator DOES support captured-token → `str` field (`wstr_as_str`). This
    // closes the former GAP:key/GAP:idx: `SField.name`/`SParam.name`/`SCall.fn_name`
    // hold the real identifier text now.
    // Each decl MIRRORS its ADR-0011 `schema` item in ir.logos ONE-FOR-ONE — the
    // `code(...)` type code and the per-field `= KEY` included. The Logos backend
    // ignores both (logosc resolves the field→key map from the schema item, and
    // `doc.make::<S>()` stamps the type code); the C++ backend has no second pass
    // and must bake them in. Carrying them HERE is what makes this file the single
    // source of truth for both backends, instead of a hand-checked mirror.
    SLit   : code(0x0010_0000_0000_0000) { val: "WAny" = 0 }    // GAP:val for INT still (STRING/BOOL exact); int-value decode TBD
    SParam : code(0x0010_0000_0000_0001) { name: "str" = 0 }    // $name — captured IDENT
    SVar   : code(0x0010_0000_0000_0002) { name: "str" = 0 }    // loop var — captured IDENT
    SField : code(0x0010_0000_0000_0003) { base: "ref SExpr" = 0, name: "str" = 1 }   // field NAME — captured IDENT
    SBin   : code(0x0010_0000_0000_0004) { op: "i32" = 0, lhs: "ref SExpr" = 1, rhs: "ref SExpr" = 2 }
    SUn    : code(0x0010_0000_0000_0005) { op: "i32" = 0, arg: "ref SExpr" = 1 }
    SCall  : code(0x0010_0000_0000_0006) { fn_name: "str" = 0, args: "ref SExprArr" = 1 }   // call NAME — captured IDENT
    SCond  : code(0x0010_0000_0000_0007) { c: "ref SExpr" = 0, t: "ref SExpr" = 1, e: "ref SExpr" = 2 }
    SComp  : code(0x0010_0000_0000_0008) { plan: "ref RExpr" = 0, head: "ref SExpr" = 1, var: "str" = 2 }
    STuple : code(0x0010_0000_0000_0009) { items: "ref SExprArr" = 0 }   // tuple projection `(a, b, …)`

    // The materialized argument list. A fan-out field spreads an ARRAY_CAPTURE
    // ($...) of parsed arg edges into the node's fixed slots — multi-arg calls
    // like contains(a,b) carry EVERY arg.
    //
    // `fan <setter> <maxfn> <cap>`: the Logos backend uses <setter>/<maxfn> and
    // emits `node.set_arg(i, …)` + `node.set_len(n)`, capped by `<maxfn>()`. The
    // C++ backend has no such methods, so it writes TOM slots directly and needs
    // the layout spelled out: the fan's `= KEY` is the FIRST SLOT key, `<cap>` is
    // the slot count, and the node's length lives in its declared `count` field.
    // (Both backends stop reading <maxfn> at the space, so <cap> is inert there.)
    // Layout mirrors ir.logos:69 — `count: i32 = 0, a0..a7 = 1..8` — a convention
    // every array schema in ir.logos/plan.logos follows.
    SExprArr : code(0x0010_0000_0000_000A) {
        count: "i32" = 0,
        args:  "fan set_arg SEXPRARR_MAX 8" = 1
    }

    // Relational tier — RExpr (ir.logos). The comprehension lowers to a scan
    // (+ optional filter) plan; the source is a captured IDENT name. Only the
    // fields this grammar WRITES are declared — RScan also has row_ty/var_name.
    RScan   : code(0x0011_0000_0000_0000) { node_code: "i56" = 0, src_name: "str" = 1 }   // source NAME — captured IDENT
    RFilter : code(0x0011_0000_0000_0002) { input: "ref RExpr" = 0, pred: "ref SExpr" = 1 }
}

// ── Tokens ─────────────────────────────────────────────────────────────────
%tokens {
    // Two-char operators FIRST (PEG first-match; the lexer is longest-literal by
    // convention, but keep them ahead for clarity).
    OROR     = "||"
    ANDAND   = "&&"
    EQEQ     = "=="
    NE       = "!="
    LE       = "<="
    GE       = ">="

    // One-char operators / punctuation.
    QUESTION = "?"
    COLON    = ":"
    LT       = "<"
    GT       = ">"
    PLUS     = "+"
    MINUS    = "-"
    STAR     = "*"
    SLASH    = "/"
    PERCENT  = "%"
    BANG     = "!"
    DOT      = "."
    COMMA    = ","
    LPAREN   = "("
    RPAREN   = ")"
    LBRACKET = "["
    RBRACKET = "]"
    DOLLAR   = "$"

    // Keywords (matched as literals; IDENT must come AFTER so `for`/`in`/`if`/
    // `true`/`false` win — PEG orders alternatives, and keyword-vs-ident is
    // resolved at the rule level via ordered choice, so declare them as tokens).
    KW_FOR   = "for"
    KW_IN    = "in"
    KW_IF    = "if"
    TRUE     = "true"
    FALSE    = "false"

    // Literals + identifier. FLOAT is ordered BEFORE INTEGER (PEG first-match;
    // the generated combined number matcher tags a digit run containing `.` as
    // FLOAT, so `2.5` never lexes as INTEGER `2` + junk).
    FLOAT    = /[0-9]+\.[0-9]+/
    INTEGER  = /[0-9]+/
    STRING   = /"([^"\\]|\\.)*"/
    IDENT    = /[a-zA-Z_][a-zA-Z0-9_]*/

    // Skip whitespace + comments.
    %skip    = /[ \t\r\n]+/
    %skip    = /\/\/[^\n]*/
}

// ── Rules ──────────────────────────────────────────────────────────────────
%rules {
    // expr := ternary
    expr <- ternary

    // ternary := or ( '?' expr ':' expr )?    → SCond (CEL conditional)
    // The optional tail folds the condition ($0) into an SCond with then/else.
    ternary <- or ( QUESTION expr COLON expr
                        => { CODE: "SCond", c: $0, t: $2, e: $4 } )?

    // or := and ( '||' and )*                 → SBin(OP_OR = 1)
    or <- and ( OROR and => { CODE: "SBin", op: 1, lhs: $0, rhs: $2 } )*

    // and := equality ( '&&' equality )*      → SBin(OP_AND = 2)
    and <- equality ( ANDAND equality => { CODE: "SBin", op: 2, lhs: $0, rhs: $2 } )*

    // equality := compare ( ('=='|'!=') compare )*   → SBin(OP_EQ=3 / OP_NE=4)
    equality <- compare
                ( EQEQ compare => { CODE: "SBin", op: 3, lhs: $0, rhs: $2 }
                / NE   compare => { CODE: "SBin", op: 4, lhs: $0, rhs: $2 }
                )*

    // compare := add ( ('<='|'>='|'<'|'>') add )*    → SBin(OP_LT=5..OP_GE=8)
    // Two-char ops (<=, >=) are distinct tokens and ordered before <, > anyway.
    compare <- add
               ( LE add => { CODE: "SBin", op: 6, lhs: $0, rhs: $2 }
               / GE add => { CODE: "SBin", op: 8, lhs: $0, rhs: $2 }
               / LT add => { CODE: "SBin", op: 5, lhs: $0, rhs: $2 }
               / GT add => { CODE: "SBin", op: 7, lhs: $0, rhs: $2 }
               )*

    // add := mul ( ('+'|'-') mul )*           → SBin(OP_ADD=9 / OP_SUB=10)
    add <- mul
           ( PLUS  mul => { CODE: "SBin", op: 9,  lhs: $0, rhs: $2 }
           / MINUS mul => { CODE: "SBin", op: 10, lhs: $0, rhs: $2 }
           )*

    // mul := unary ( ('*'|'/'|'%') unary )*   → SBin(OP_MUL=11 / DIV=12 / MOD=13)
    mul <- unary
           ( STAR    unary => { CODE: "SBin", op: 11, lhs: $0, rhs: $2 }
           / SLASH   unary => { CODE: "SBin", op: 12, lhs: $0, rhs: $2 }
           / PERCENT unary => { CODE: "SBin", op: 13, lhs: $0, rhs: $2 }
           )*

    // unary := ('!'|'-') unary | postfix      → SUn(OP_NOT=1 / OP_NEG=2)
    unary <- BANG  unary => { CODE: "SUn", op: 1, arg: $2 }
           / MINUS unary => { CODE: "SUn", op: 2, arg: $2 }
           / postfix

    // postfix := primary ( '.' ident )*       → SField (left-nested edge chain)
    // Each `.ident` step folds the running base ($0) into an SField whose `name`
    // is the captured field-name IDENT ($2) — self-describing (Option B).
    postfix <- primary
               ( DOT IDENT => { CODE: "SField", base: $0, name: $2 } )*

    // primary := literals | param | call | var/field-root | paren | tuple | comprehension
    //
    // Ordered choice (PEG first-match): keyword literals + comprehension +
    // parenthesised before the bare-identifier field-root fallback. The TUPLE
    // alternative is tried BEFORE plain grouping: `(a, b)` (≥ 1 top-level comma)
    // builds an STuple over an SExprArr fan-out; `(a)` fails tuple_body at the
    // COMMA and backtracks to grouping — existing semantics untouched.
    //   $1=LPAREN $2=tuple_body $3=RPAREN
    primary <- comprehension
             / LPAREN tuple_body RPAREN => { CODE: "STuple", items: $2 }
             / LPAREN expr RPAREN                     // grouping (value passes through)
             / TRUE    => { CODE: "SLit", val: true }
             / FALSE   => { CODE: "SLit", val: false }
             / STRING  => { CODE: "SLit", val: $1 }   // faithful: interned WString ref
             / FLOAT   => { CODE: "SLit", val: $1 }    // token->f64 decode: doc.float(wstr_decode_f64($1))
             / INTEGER => { CODE: "SLit", val: $1 }    // token->i64 decode: doc.int(wstr_decode_i64($1))
             / DOLLAR IDENT => { CODE: "SParam", name: $2 }            // $name — captured IDENT
             / IDENT LPAREN arglist RPAREN => { CODE: "SCall", fn_name: $1, args: $3 }  // call NAME — captured IDENT
             / IDENT   => { CODE: "SField", base: NULLBASE, name: $1 } // bare field-root; captured IDENT
             // Note: a bound comprehension variable also parses as this IDENT
             // field-root and is rebound to SVar at the metacall (header G4).

    // arglist := ( expr ( ',' expr )* )?  →  SExprArr backing (multi-arg call)
    // The array capture `$...` collects EVERY parsed arg edge (the first expr + the
    // comma-repeated ones); the `args: "argfan"` schema field spreads them into the
    // SExprArr's fixed slots (set_arg/set_len). Full multi-arg support.
    arglist <- ( expr ( COMMA expr )* )?
                => { CODE: "SExprArr", args: $... }

    // tuple_body := expr ',' expr ( ',' expr )*  →  SExprArr backing (STuple items)
    // ≥ 2 components REQUIRED (the leading `expr COMMA expr`): `(e)` never reaches
    // here (grouping), `()` fails the parse. Same argfan spread as arglist.
    tuple_body <- expr COMMA expr ( COMMA expr )*
                => { CODE: "SExprArr", args: $... }

    // comprehension := '[' expr 'for' ident 'in' comp_plan ']'
    //   →  SComp{ plan = RFilter(RScan(src), guard)? | RScan(src),
    //            head = expr, var = loop-var NAME }
    // The plan (RScan + optional RFilter) is assembled BY THE GRAMMAR (comp_plan
    // below): the source ident builds the RScan; an optional `if guard` folds it
    // into an RFilter. `var: $4` stores the loop-var name self-describingly on the
    // SComp node (Option B) — the metacall rebinds `var`-references to SVar.
    comprehension <- LBRACKET expr KW_FOR IDENT KW_IN comp_plan RBRACKET
                        => { CODE: "SComp", plan: $6, head: $2, var: $4 }

    // comp_plan := comp_source ( 'if' expr )?   → RFilter(RScan(src), guard) or RScan(src).
    // Fold-mode: the RScan (from comp_source) is the accumulator ($0); the optional
    // guard folds it into an RFilter whose input IS the scan ($0) and pred the guard.
    comp_plan <- comp_source
                 ( KW_IF expr => { CODE: "RFilter", input: $0, pred: $2 } )?

    // comp_source := ident   → RScan over that named source (node_code resolved at
    // the metacall against the bound schema; the parser only carries the NAME).
    comp_source <- IDENT => { CODE: "RScan", src_name: $1 }
}
