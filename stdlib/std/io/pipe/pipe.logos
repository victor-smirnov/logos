// Logos standard library — std.pipe
//
// Unix pipe: create a connected read/write fd pair.
// Uses synchronous read(2)/write(2) — same style as logos.std.io.

package logos.std.io.pipe;

use logos.std.io.read;
use logos.std.io.write;  // Write trait, IoSlice

extern fn pipe2(fds: *mut i32, flags: i32) -> i32;
extern fn read(fd: i32, buf: *mut u8, n: i64) -> i64;
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;
extern fn writev(fd: i32, iov: *const u8, iovcnt: i32) -> i64;
extern fn readv(fd: i32, iov: *mut u8, iovcnt: i32) -> i64;
extern fn close(fd: i32) -> i32;

// ── Pipe ──────────────────────────────────────────────────────────────────

/// Unix pipe: a connected read/write file-descriptor pair.
/// Descriptors are NOT closed on drop; call `close` (or `close_read`/`close_write`) explicitly.
pub struct Pipe {
    /// Read end of the pipe; `-1` when closed or on creation failure.
    pub read_fd:  i32,
    /// Write end of the pipe; `-1` when closed or on creation failure.
    pub write_fd: i32,
}

/// Creates a pipe via `pipe2(2)`. Returns a `Pipe` with both ends open, or `Pipe{-1,-1}` on error.
pub fn pipe_new() -> Pipe {
    unsafe {
        let mut fds: [i32; 2] = [0, 0];
        let rc: i32 = pipe2(&mut fds[0], 0);
        if rc < 0 {
            return Pipe { read_fd: 0 - 1, write_fd: 0 - 1 };
        }
        return Pipe { read_fd: fds[0], write_fd: fds[1] };
    }
}

/// Creates a pipe with both ends in `O_NONBLOCK` mode. Returns `Pipe{-1,-1}` on error.
pub fn pipe_new_nonblock() -> Pipe {
    unsafe {
        let mut fds: [i32; 2] = [0, 0];
        // O_NONBLOCK = 0x800 on Linux
        let rc: i32 = pipe2(&mut fds[0], 2048);
        if rc < 0 {
            return Pipe { read_fd: 0 - 1, write_fd: 0 - 1 };
        }
        return Pipe { read_fd: fds[0], write_fd: fds[1] };
    }
}

impl Pipe {
    /// Returns `true` if both pipe ends hold open (non-negative) descriptors.
    pub fn is_valid(self: &Pipe) -> bool {
        return self.read_fd >= 0 && self.write_fd >= 0;
    }

    /// Closes the read end and sets `read_fd` to `-1`; no-op if already closed.
    pub fn close_read(self: &mut Pipe) {
        unsafe {
            if self.read_fd >= 0 {
                close(self.read_fd);
                self.read_fd = 0 - 1;
            }
        }
    }

    /// Closes the write end and sets `write_fd` to `-1`; no-op if already closed.
    pub fn close_write(self: &mut Pipe) {
        unsafe {
            if self.write_fd >= 0 {
                close(self.write_fd);
                self.write_fd = 0 - 1;
            }
        }
    }

    /// Closes both ends of the pipe; idempotent.
    pub fn close(self: &mut Pipe) {
        self.close_read();
        self.close_write();
    }

    /// Performs a vectored write (`writev`) to the pipe's write end.
    /// Returns total bytes written (>= 0) or negative on error.
    /// `IoSlice` layout matches `struct iovec`.
    pub fn write_vectored(self: &mut Pipe,
                          iovs: *const IoSlice, nvecs: i32) -> i64 {
        unsafe { return writev(self.write_fd, iovs as *const u8, nvecs); }
    }

    /// Performs a vectored read (`readv`) from the pipe's read end.
    /// Returns bytes read (0 = EOF) or negative on error.
    pub fn read_vectored(self: &mut Pipe,
                         iovs: *mut IoSlice, nvecs: i32) -> i64 {
        unsafe { return readv(self.read_fd, iovs as *mut u8, nvecs); }
    }
}

impl Read for Pipe {
    fn read(self: &mut Pipe, buf: *mut u8, len: i64) -> i64 {
        unsafe { return read(self.read_fd, buf, len); }
    }
}

impl Write for Pipe {
    fn write(self: &mut Pipe, buf: *const u8, len: i64) -> i64 {
        unsafe { return write(self.write_fd, buf, len); }
    }
    fn flush(self: &mut Pipe) -> i64 { return 0; }
}
