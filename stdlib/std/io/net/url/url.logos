// Logos standard library -- std.url
//
// URL percent-encoding (RFC 3986).  Two variants:
//  * url_encode_component — encodes everything that isn't unreserved.
//                           Suitable for path segments and query values.
//  * url_encode_query_form — application/x-www-form-urlencoded style:
//                           space → '+'; otherwise like encode_component.

package logos.std.io.net.url;

use logos.mem.string;
use logos.lang.str;
use logos.lang.option;

// unreserved: A-Z a-z 0-9 '-' '.' '_' '~'
fn is_unreserved(c: u8) -> bool {
    let ci: i32 = c as i32;
    if ci >= 65 && ci <= 90  { return true; }  // A-Z
    if ci >= 97 && ci <= 122 { return true; }  // a-z
    if ci >= 48 && ci <= 57  { return true; }  // 0-9
    if ci == 45 { return true; }               // '-'
    if ci == 46 { return true; }               // '.'
    if ci == 95 { return true; }               // '_'
    if ci == 126 { return true; }              // '~'
    return false;
}

fn hex_digit(n: u8) -> u8 {
    let ni: i32 = n as i32;
    if ni < 10 { return (ni + 48) as u8; }     // '0'..'9'
    return (ni - 10 + 65) as u8;               // 'A'..'F' (uppercase per RFC 3986 §2.1)
}

fn nibble_of(c: u8) -> i32 {
    let ci: i32 = c as i32;
    if ci >= 48 && ci <= 57  { return ci - 48; }
    if ci >= 65 && ci <= 70  { return ci - 65 + 10; }
    if ci >= 97 && ci <= 102 { return ci - 97 + 10; }
    return 0 - 1;
}

/// Percent-encodes bytes `[src, src+len)`, appending to `out`.
/// Bytes outside the RFC 3986 unreserved set (`A-Za-z0-9-._~`) become uppercase `%XX`.
pub fn url_encode_component(src: *const u8, len: i64, out: &mut String) {
    unsafe {
        let mut i: i64 = 0 as i64;
        while i < len {
            let b: u8 = src[i];
            if is_unreserved(b) {
                out.push_u8(b);
            } else {
                out.push_u8(37 as u8);            // '%'
                out.push_u8(hex_digit((b >> 4 as u8) & 15 as u8));
                out.push_u8(hex_digit(b & 15 as u8));
            }
            i = i + 1 as i64;
        }
    }
}

/// Percent-encodes `src`, appending to `out` (see `url_encode_component`).
pub fn url_encode_component_str(src: str, out: &mut String) {
    unsafe { url_encode_component(src.as_ptr(), src.len(), out); }
}

/// Encodes bytes `[src, src+len)` as `application/x-www-form-urlencoded`, appending to `out`.
/// Same as `url_encode_component` except space (0x20) becomes `+`.
pub fn url_encode_query_form(src: *const u8, len: i64, out: &mut String) {
    unsafe {
        let mut i: i64 = 0 as i64;
        while i < len {
            let b: u8 = src[i];
            if b == 32 as u8 {
                out.push_u8(43 as u8);            // '+'
            } else if is_unreserved(b) {
                out.push_u8(b);
            } else {
                out.push_u8(37 as u8);
                out.push_u8(hex_digit((b >> 4 as u8) & 15 as u8));
                out.push_u8(hex_digit(b & 15 as u8));
            }
            i = i + 1 as i64;
        }
    }
}

/// Form-urlencodes `src`, appending to `out` (see `url_encode_query_form`).
pub fn url_encode_query_form_str(src: str, out: &mut String) {
    unsafe { url_encode_query_form(src.as_ptr(), src.len(), out); }
}

/// Decodes percent-encoded bytes `[src, src+len)`, appending to `out`.
/// If `plus_is_space` is true, `+` decodes to a space (form-urlencoded mode).
/// Returns the number of bytes appended, or -1 on malformed input (truncated `%`
/// escape, non-hex digit); on error `out` may already hold partially decoded bytes.
pub fn url_decode(src: *const u8, len: i64, out: &mut String, plus_is_space: bool) -> i64 {
    unsafe {
        let mut i: i64 = 0 as i64;
        let mut produced: i64 = 0 as i64;
        while i < len {
            let b: u8 = src[i];
            if b == 37 as u8 {                     // '%'
                if (i + 2 as i64) >= len { return 0 - 1 as i64; }
                let hi: i32 = nibble_of(src[i + 1 as i64]);
                let lo: i32 = nibble_of(src[i + 2 as i64]);
                if hi < 0 { return 0 - 1 as i64; }
                if lo < 0 { return 0 - 1 as i64; }
                out.push_u8(((hi << 4) | lo) as u8);
                i = i + 3 as i64;
            } else if plus_is_space && b == 43 as u8 {
                out.push_u8(32 as u8);
                i = i + 1 as i64;
            } else {
                out.push_u8(b);
                i = i + 1 as i64;
            }
            produced = produced + 1 as i64;
        }
        return produced;
    }
}

/// Decodes percent-encoded `src` into `out`; returns bytes appended, or -1 on malformed input.
/// `+` passes through unchanged (component mode).
pub fn url_decode_str(src: str, out: &mut String) -> i64 {
    unsafe { return url_decode(src.as_ptr(), src.len(), out, false); }
}

/// Decodes form-urlencoded `src` into `out`, with `+` decoded as space.
/// Returns the number of bytes appended, or -1 on malformed input.
pub fn url_decode_form_str(src: str, out: &mut String) -> i64 {
    unsafe { return url_decode(src.as_ptr(), src.len(), out, true); }
}

// ── URL parsing ─────────────────────────────────────────────────────────────
//
// Format: scheme "://" host [":" port] [path] ["?" query] ["#" fragment]
// Fragment is parsed off and discarded (v1 has no use for it).
// `port` is -1 when unspecified — callers pick a scheme default.
// `path` is either empty (absent) or starts with '/'.

/// Parsed absolute URL: `scheme "://" host [":" port] [path] ["?" query]`.
/// Components are stored raw (not percent-decoded); the fragment is not retained.
pub struct Url {
    /// Scheme, without the `://` separator (e.g. `http`).
    pub scheme: String,
    /// Host component, without the port.
    pub host:   String,
    /// Port, or -1 when unspecified — callers pick the scheme default.
    pub port:   i32,
    /// Path; empty when absent, otherwise starts with `/`.
    pub path:   String,
    /// Query string without the leading `?`; empty when absent.
    pub query:  String,
}

// Find byte `b` in [ptr, ptr+len) starting at `from`.  Returns -1 if absent.
fn find_byte(ptr: *const u8, len: i64, b: u8, from: i64) -> i64 {
    unsafe {
        let mut i: i64 = from;
        while i < len {
            if ptr[i] == b { return i; }
            i = i + 1 as i64;
        }
    }
    return 0 - 1 as i64;
}

// Match the 3-byte literal "://" at position `i` inside [ptr, ptr+len).
fn matches_scheme_sep(ptr: *const u8, len: i64, i: i64) -> bool {
    if (i + 3 as i64) > len { return false; }
    unsafe {
        if ptr[i]             != 58 as u8 { return false; }   // ':'
        if ptr[i + 1 as i64]  != 47 as u8 { return false; }   // '/'
        if ptr[i + 2 as i64]  != 47 as u8 { return false; }   // '/'
    }
    return true;
}

// scheme      = ALPHA *( ALPHA / DIGIT / '+' / '-' / '.' )   [RFC 3986 §3.1]
fn is_scheme_head(c: u8) -> bool {
    let ci: i32 = c as i32;
    if ci >= 65 && ci <= 90  { return true; }
    if ci >= 97 && ci <= 122 { return true; }
    return false;
}

fn is_scheme_tail(c: u8) -> bool {
    if is_scheme_head(c) { return true; }
    let ci: i32 = c as i32;
    if ci >= 48 && ci <= 57 { return true; }
    if ci == 43 { return true; }   // '+'
    if ci == 45 { return true; }   // '-'
    if ci == 46 { return true; }   // '.'
    return false;
}

fn push_range(dst: &mut String, ptr: *const u8, lo: i64, hi: i64) {
    if hi > lo {
        unsafe {
            let base: i64 = ptr as i64;
            dst.push_bytes((base + lo) as *const u8, hi - lo);
        }
    }
}

fn parse_port_digits(ptr: *const u8, lo: i64, hi: i64) -> i32 {
    if hi <= lo { return 0 - 1; }
    let mut n: i32 = 0;
    let mut i: i64 = lo;
    unsafe {
        while i < hi {
            let c: u8 = ptr[i];
            let ci: i32 = c as i32;
            if ci < 48 || ci > 57 { return 0 - 1; }
            n = n * 10 + (ci - 48);
            if n > 65535 { return 0 - 1; }
            i = i + 1 as i64;
        }
    }
    return n;
}

/// Parses an absolute URL of the form `scheme://host[:port][path][?query][#fragment]`.
/// Returns `None` on malformed input (bad scheme, empty host, non-numeric or >65535 port).
/// The fragment is parsed off and discarded; components are not percent-decoded.
pub fn url_parse(s: str) -> Option<Url> {
    let ptr: *const u8 = unsafe { s.as_ptr() };
    let len: i64       = unsafe { s.len() };
    if len <= 0 as i64 { return Option::None; }

    // scheme — must start with ALPHA, end at "://"
    if !is_scheme_head(unsafe { ptr[0 as i64] }) { return Option::None; }
    let mut i: i64 = 1 as i64;
    while i < len {
        let c: u8 = unsafe { ptr[i] };
        if c == 58 as u8 { break; }                // ':'
        if !is_scheme_tail(c) { return Option::None; }
        i = i + 1 as i64;
    }
    if !matches_scheme_sep(ptr, len, i) { return Option::None; }
    let scheme_end: i64 = i;
    let host_start: i64 = i + 3 as i64;

    // authority end = first '/' '?' '#' after host_start, or len
    let mut auth_end: i64 = len;
    let mut j: i64 = host_start;
    while j < len {
        let c: u8 = unsafe { ptr[j] };
        if c == 47 as u8 || c == 63 as u8 || c == 35 as u8 {
            auth_end = j;
            break;
        }
        j = j + 1 as i64;
    }
    if auth_end == host_start { return Option::None; }

    // Split authority on ':' for port.  Reject empty host.
    let colon: i64 = find_byte(ptr, auth_end, 58 as u8, host_start);
    let mut host_end: i64 = auth_end;
    let mut port: i32     = 0 - 1;
    if colon >= 0 as i64 {
        host_end = colon;
        port = parse_port_digits(ptr, colon + 1 as i64, auth_end);
        if port < 0 { return Option::None; }
    }
    if host_end == host_start { return Option::None; }

    // path — from auth_end up to '?' or '#' or len
    let mut path_end: i64 = len;
    let mut k: i64 = auth_end;
    while k < len {
        let c: u8 = unsafe { ptr[k] };
        if c == 63 as u8 || c == 35 as u8 { path_end = k; break; }
        k = k + 1 as i64;
    }
    let path_start: i64 = auth_end;

    // query — between '?' and '#' (or len); fragment is discarded
    let mut query_start: i64 = path_end;
    let mut query_end:   i64 = path_end;
    if path_end < len && unsafe { ptr[path_end] } == 63 as u8 {
        query_start = path_end + 1 as i64;
        query_end   = len;
        let hash: i64 = find_byte(ptr, len, 35 as u8, query_start);
        if hash >= 0 as i64 { query_end = hash; }
    }

    let mut scheme: String = String::new();
    let mut host:   String = String::new();
    let mut path:   String = String::new();
    let mut query:  String = String::new();
    push_range(&mut scheme, ptr, 0 as i64,    scheme_end);
    push_range(&mut host,   ptr, host_start,  host_end);
    push_range(&mut path,   ptr, path_start,  path_end);
    push_range(&mut query,  ptr, query_start, query_end);
    return Option::Some(Url {
        scheme: scheme,
        host:   host,
        port:   port,
        path:   path,
        query:  query,
    });
}

/// Returns the default port for a well-known scheme (`http` = 80, `https` = 443), or -1 if unknown.
pub fn url_default_port_s(scheme: &String) -> i32 {
    let p: *const u8 = scheme.as_ptr();
    let n: i64       = scheme.len();
    if n == 4 as i64 {
        if unsafe { p[0 as i64] } == 104 as u8     // 'h'
           && unsafe { p[1 as i64] } == 116 as u8
           && unsafe { p[2 as i64] } == 116 as u8
           && unsafe { p[3 as i64] } == 112 as u8  // 'p'
        { return 80; }
    }
    if n == 5 as i64 {
        if unsafe { p[0 as i64] } == 104 as u8
           && unsafe { p[1 as i64] } == 116 as u8
           && unsafe { p[2 as i64] } == 116 as u8
           && unsafe { p[3 as i64] } == 112 as u8
           && unsafe { p[4 as i64] } == 115 as u8  // 's'
        { return 443; }
    }
    return 0 - 1;
}

/// Serializes `u`, appending to `out`.
/// Port is omitted when -1 or equal to the scheme's default; `?` appears only when
/// `query` is non-empty.  Path is emitted verbatim — caller supplies the leading `/`.
pub fn url_format(u: &Url, out: &mut String) {
    out.push_bytes(u.scheme.as_ptr(), u.scheme.len());
    out.push_str("://");
    out.push_bytes(u.host.as_ptr(), u.host.len());
    let default_port: i32 = url_default_port_s(&u.scheme);
    if u.port >= 0 && u.port != default_port {
        out.push_u8(58 as u8);                     // ':'
        out.push_i64(u.port as i64);
    }
    if u.path.len() > 0 as i64 {
        out.push_bytes(u.path.as_ptr(), u.path.len());
    }
    if u.query.len() > 0 as i64 {
        out.push_u8(63 as u8);                     // '?'
        out.push_bytes(u.query.as_ptr(), u.query.len());
    }
}
