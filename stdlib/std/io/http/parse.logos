// Logos standard library — std.http: HTTP/1.1 buffer parsers.
//
// Iterative — one cursor walks [src, src+len).  Errors surface as
// Result::Err(HttpError::Parse); callers using streaming I/O must ensure the
// buffer holds a full message before parsing (partial != malformed, but we
// do not distinguish).

package logos.std.io.http;

use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.lang.option;
use logos.lang.result;
use logos.std.io.net.url;
use logos.lcm.io.read;
use logos.std.io.buffered;

// ── RFC 7230 character classes ───────────────────────────────────────────────

// tchar per RFC 7230 §3.2.6: DIGIT / ALPHA / "!#$%&'*+-.^_`|~"
fn is_tchar(c: u8) -> bool {
    let x: i32 = c as i32;
    if x >= 48 && x <= 57  { return true; }
    if x >= 65 && x <= 90  { return true; }
    if x >= 97 && x <= 122 { return true; }
    if x == 33 { return true; }
    if x == 35 { return true; }
    if x == 36 { return true; }
    if x == 37 { return true; }
    if x == 38 { return true; }
    if x == 39 { return true; }
    if x == 42 { return true; }
    if x == 43 { return true; }
    if x == 45 { return true; }
    if x == 46 { return true; }
    if x == 94 { return true; }
    if x == 95 { return true; }
    if x == 96 { return true; }
    if x == 124 { return true; }
    if x == 126 { return true; }
    return false;
}

// field-value byte per RFC 7230 §3.2: HTAB / SP / VCHAR (0x21-0x7E) / obs-text
// (0x80-0xFF).  Rejects NUL, CR, LF, other CTLs, and DEL.
fn is_header_value_byte(c: u8) -> bool {
    let x: i32 = c as i32;
    if x == 9 { return true; }
    if x == 32 { return true; }
    if x >= 33 && x <= 126 { return true; }
    if x >= 128 { return true; }
    return false;
}

// Request-target per RFC 7230 §5.3: VCHAR only (0x21-0x7E), no SP / HTAB /
// CTL / DEL.  Additionally restricted here to origin-form (starts with `/`)
// or asterisk-form (exactly `*`).  Absolute-URI and authority-form are
// rejected: we don't handle proxying and we don't speak CONNECT.
fn validate_request_target(p: *const u8, n: i64) -> bool {
    if n <= 0 as i64 { return false; }
    let mut i: i64 = 0 as i64;
    unsafe {
        while i < n {
            let b: u8 = p[i];
            if b < 33 as u8 || b > 126 as u8 { return false; }
            i = i + 1 as i64;
        }
        let first: u8 = p[0];
        if first == 47 as u8 { return true; }                         // '/'
        if n == 1 as i64 && first == 42 as u8 { return true; }        // '*'
    }
    return false;
}

fn validate_token(p: *const u8, n: i64) -> bool {
    if n <= 0 { return false; }
    let mut i: i64 = 0;
    unsafe {
        while i < n {
            if !is_tchar(p[i]) { return false; }
            i = i + 1;
        }
    }
    return true;
}

fn validate_header_value(p: *const u8, n: i64) -> bool {
    let mut i: i64 = 0;
    unsafe {
        while i < n {
            if !is_header_value_byte(p[i]) { return false; }
            i = i + 1;
        }
    }
    return true;
}

// ── Byte-level scanners ──────────────────────────────────────────────────────

/// Returns the index of the first CRLF's CR in `[from, len)`, or -1 if absent.
pub fn find_crlf(src: *const u8, len: i64, from: i64) -> i64 {
    let mut i: i64 = from;
    unsafe {
        while (i + 1) < len {
            if src[i] == 13 as u8 && src[i + 1] == 10 as u8 { return i; }
            i = i + 1;
        }
    }
    return 0 - 1;
}

// Parse an ASCII decimal integer from [src+from, src+end).  -1 on invalid.
fn parse_decimal(src: *const u8, from: i64, end: i64) -> i64 {
    if from >= end { return 0 - 1; }
    let mut n: i64 = 0;
    let mut i: i64 = from;
    unsafe {
        while i < end {
            let c: i32 = src[i] as i32;
            if c < 48 || c > 57 { return 0 - 1; }
            n = n * 10 + (c - 48) as i64;
            i = i + 1;
        }
    }
    return n;
}

fn trim_ows_left(src: *const u8, from: i64, end: i64) -> i64 {
    let mut i: i64 = from;
    unsafe {
        while i < end {
            let c: u8 = src[i];
            if c != 32 as u8 && c != 9 as u8 { return i; }
            i = i + 1;
        }
    }
    return end;
}

fn trim_ows_right(src: *const u8, from: i64, end: i64) -> i64 {
    let mut j: i64 = end;
    unsafe {
        while j > from {
            let c: u8 = src[j - 1];
            if c != 32 as u8 && c != 9 as u8 { return j; }
            j = j - 1;
        }
    }
    return from;
}

fn copy_body(src: *const u8, from: i64, end: i64, dst: &mut Vec<u8>) {
    let mut i: i64 = from;
    unsafe {
        while i < end {
            vec_push_u8(dst, src[i]);
            i = i + 1;
        }
    }
}

// ── Header block parser ──────────────────────────────────────────────────────

/// Parses header lines from `[pos, len)` into `h`, appending each field.
/// Returns the position just past the empty-CRLF terminator, or -1 on malformed
/// input.  Names must be RFC 7230 tokens; values are OWS-trimmed.
pub fn parse_headers(src: *const u8, len: i64, pos: i64, h: &mut Headers) -> i64 {
    let mut p: i64 = pos;
    unsafe {
        while true {
            let eol: i64 = find_crlf(src, len, p);
            if eol < 0 { return 0 - 1; }
            if eol == p { return p + 2; }                // empty line = end
            // find ':' within [p, eol)
            let mut colon: i64 = 0 - 1;
            let mut i: i64 = p;
            while i < eol {
                if src[i] == 58 as u8 { colon = i; i = eol; } else { i = i + 1; }
            }
            if colon < 0 { return 0 - 1; }
            let name_start: i64 = p;
            let name_end:   i64 = colon;
            // RFC 7230 §3.2.4: no whitespace between name and ':'.
            // validate_token implicitly rejects empty names and any byte that
            // is not a tchar (SP/HTAB included).
            if !validate_token(src.byte_add(name_start), name_end - name_start) {
                return 0 - 1;
            }
            let v0: i64 = trim_ows_left(src, colon + 1, eol);
            let v1: i64 = trim_ows_right(src, v0, eol);
            if !validate_header_value(src.byte_add(v0), v1 - v0) {
                return 0 - 1;
            }
            let name:  String = String::from_bytes(
                src.byte_add(name_start), name_end - name_start);
            let value: String = String::from_bytes(
                src.byte_add(v0), v1 - v0);
            h.append(s2str(&name), s2str(&value));
            p = eol + 2;
        }
    }
    return 0 - 1;
}

/// Returns the body-framing decision for headers `h`.
/// `>= 0`: Content-Length bytes; `-1`: no framing (caller decides; response →
/// read to EOF, request → empty); `-2`: chunked; `-3`: malformed (invalid or
/// conflicting Content-Length, non-`chunked` Transfer-Encoding, or TE with CL).
pub fn body_length(h: &Headers) -> i64 {
    let mut has_chunked: bool = false;
    let mut bad_te:      bool = false;
    match h.get("transfer-encoding") {
        Option::Some(te) => {
            // RFC 7230 §3.3.3 rule 3: for requests, if Transfer-Encoding is
            // present and the final coding is not `chunked`, the message
            // length can't be determined reliably → reject.  We only
            // implement the exact-`chunked` case; every other value
            // (identity, gzip, comma-lists) is a hard error.
            if (&te).eq_str("chunked") { has_chunked = true; }
            else                       { bad_te      = true; }
        }
        Option::None => {}
    }
    if bad_te { return 0 - 3; }
    // RFC 9112 §6.3: multiple Content-Length headers (or single CL with
    // comma-separated list) are a smuggling vector unless every value parses
    // to the same integer.  Scan all entries, not just the first.
    let mut cl_seen: bool = false;
    let mut cl_val:  i64  = 0 - 1;
    let total: i64 = (&h.entries).length();
    let mut ei: i64 = 0;
    unsafe {
        let ep: *mut Vec<Header> =
            &h.entries as *const Vec<Header> as *mut Vec<Header>;
        let bp: *const u8 = (&h.buf).as_ptr();
        let cl_name: str = "content-length";
        let cln: i64 = cl_name.len();
        let clp: *const u8 = cl_name.as_ptr();
        while ei < total {
            let hdr: Header = ep.get(ei);
            let np: *const u8 = bp.byte_add(hdr.name_off as i64);
            if ascii_ieq(np, hdr.name_len as i64, clp, cln) {
                let vp: *const u8 = bp.byte_add(hdr.value_off as i64);
                let vn: i64 = hdr.value_len as i64;
                let v: i64 = parse_decimal(vp, 0, vn);
                if v < 0 { return 0 - 3; }
                if cl_seen {
                    if v != cl_val { return 0 - 3; }
                } else {
                    cl_seen = true;
                    cl_val  = v;
                }
            }
            ei = ei + 1;
        }
    }
    if cl_seen {
        // RFC 9112 §6.1: both TE and CL present MUST be rejected as a
        // smuggling vector rather than silently preferring one.
        if has_chunked { return 0 - 3; }
        return cl_val;
    }
    if has_chunked { return 0 - 2; }
    return 0 - 1;
}

// ── Request / Response message parsers ──────────────────────────────────────

/// Parses a complete HTTP request (request-line, headers, body) from `[src, src+len)`.
/// Body framing follows `body_length`: Content-Length is copied, chunked is decoded,
/// no framing yields an empty body.  Partial input is `HttpError::Parse` — the buffer
/// must hold the whole message.
pub fn parse_request_buf(src: *const u8, len: i64) -> Result<Request, HttpError> {
    let line_end: i64 = find_crlf(src, len, 0);
    if line_end < 0 { return Result::Err(HttpError::Parse); }

    // Request-line: METHOD SP TARGET SP HTTP/VERSION
    let mut sp1: i64 = 0 - 1;
    let mut sp2: i64 = 0 - 1;
    let mut i: i64 = 0;
    unsafe {
        while i < line_end {
            if src[i] == 32 as u8 {
                if sp1 < 0 { sp1 = i; } else if sp2 < 0 { sp2 = i; }
            }
            i = i + 1;
        }
    }
    if sp1 < 0 || sp2 < 0 { return Result::Err(HttpError::Parse); }
    if !validate_token(src, sp1) { return Result::Err(HttpError::Parse); }

    let method_str: String = unsafe { String::from_bytes(src, sp1) };
    let target:     String = unsafe {
        String::from_bytes(src.byte_add(sp1 + 1), sp2 - sp1 - 1)
    };

    let method: Method = method_parse(s2str(&method_str));
    // url_parse accepts absolute-form; origin-form "/path?q" stays verbatim.
    let url: Url = match url_parse(s2str(&target)) {
        Option::Some(u) => u,
        Option::None    => {
            let tp: *const u8 = (&target).as_ptr();
            let tn: i64 = (&target).len();
            let mut qpos: i64 = 0 - 1;
            let mut k: i64 = 0;
            unsafe {
                while k < tn {
                    if tp[k] == 63 as u8 { qpos = k; k = tn; } else { k = k + 1; }
                }
            }
            let path_end: i64 = if qpos < 0 { tn } else { qpos };
            let path_s:  String = unsafe { String::from_bytes(tp, path_end) };
            let mut query_s: String = String::new();
            if qpos >= 0 {
                query_s = unsafe {
                    String::from_bytes(tp.byte_add(qpos + 1), tn - qpos - 1)
                };
            }
            Url {
                scheme: String::new(),
                host:   String::new(),
                port:   0,
                path:   path_s,
                query:  query_s,
            }
        }
    };

    let mut req: Request = Request::new(method, url);
    let hdr_end: i64 = parse_headers(src, len, line_end + 2, &mut req.headers);
    if hdr_end < 0 { return Result::Err(HttpError::Parse); }

    let blen: i64 = body_length(&req.headers);
    if blen == 0 - 3 { return Result::Err(HttpError::Parse); }
    if blen == 0 - 2 {
        let tail_ptr: *const u8 = (src as i64 + hdr_end) as *const u8;
        let consumed: i64 = chunked_decode(tail_ptr, len - hdr_end, &mut req.body);
        if consumed < 0 { return Result::Err(HttpError::Parse); }
    } else if blen > 0 {
        if hdr_end + blen > len { return Result::Err(HttpError::Parse); }
        copy_body(src, hdr_end, hdr_end + blen, &mut req.body);
    }
    return Result::Ok(req);
}

/// Parses a complete HTTP response (status-line, headers, body) from `[src, src+len)`.
/// Body framing follows `body_length`: with no framing, the remainder of the buffer
/// becomes the body (read-to-EOF semantics).
pub fn parse_response_buf(src: *const u8, len: i64) -> Result<Response, HttpError> {
    let line_end: i64 = find_crlf(src, len, 0);
    if line_end < 0 { return Result::Err(HttpError::Parse); }

    // Status-line: HTTP/1.1 SP STATUS SP REASON
    let mut sp1: i64 = 0 - 1;
    let mut sp2: i64 = 0 - 1;
    let mut i: i64 = 0;
    unsafe {
        while i < line_end {
            if src[i] == 32 as u8 {
                if sp1 < 0 { sp1 = i; } else if sp2 < 0 { sp2 = i; }
            }
            i = i + 1;
        }
    }
    if sp1 < 0 { return Result::Err(HttpError::Parse); }
    let status_end: i64 = if sp2 < 0 { line_end } else { sp2 };
    let status: i64 = parse_decimal(src, sp1 + 1, status_end);
    if status < 0 { return Result::Err(HttpError::Parse); }

    let reason_start: i64 = if sp2 < 0 { line_end } else { sp2 + 1 };
    let reason: String = unsafe {
        String::from_bytes(src.byte_add(reason_start),
                           line_end - reason_start)
    };

    let mut resp: Response = Response::new(status as i32);
    resp.reason.clear();
    resp.reason.push_str(s2str(&reason));

    let hdr_end: i64 = parse_headers(src, len, line_end + 2, &mut resp.headers);
    if hdr_end < 0 { return Result::Err(HttpError::Parse); }

    let blen: i64 = body_length(&resp.headers);
    if blen == 0 - 3 { return Result::Err(HttpError::Parse); }
    if blen == 0 - 2 {
        let tail_ptr: *const u8 = (src as i64 + hdr_end) as *const u8;
        let consumed: i64 = chunked_decode(tail_ptr, len - hdr_end, &mut resp.body);
        if consumed < 0 { return Result::Err(HttpError::Parse); }
    } else if blen > 0 {
        if hdr_end + blen > len { return Result::Err(HttpError::Parse); }
        copy_body(src, hdr_end, hdr_end + blen, &mut resp.body);
    } else if blen == 0 - 1 {
        // No framing: read to end of buffer.
        if hdr_end < len {
            copy_body(src, hdr_end, len, &mut resp.body);
        }
    }
    return Result::Ok(resp);
}

// ── Streaming parsers over BufReader<R> ─────────────────────────────────────
// Head-only.  On success the returned Request/Response carries method/url
// (or status/reason) and headers; body Vec<u8> is empty.  Caller constructs
// a body reader (ChunkedReader or ContentLengthReader) over the same
// BufReader based on body_length(&msg.headers).
//
// Reads up to (and including) the empty CRLF that terminates the header
// block and nothing beyond, so the BufReader is positioned at the first
// body byte after this call returns.

// Resolve a URL from an HTTP request target.  Mirrors the fallback logic
// in parse_request_buf for origin-form ("/path?q") targets.
fn resolve_request_target(tp: *const u8, tn: i64) -> Url {
    let target_str: String = unsafe { String::from_bytes(tp, tn) };
    match url_parse(s2str(&target_str)) {
        Option::Some(u) => { return u; }
        Option::None    => {}
    }
    let mut qpos: i64 = 0 - 1;
    let mut k: i64 = 0;
    unsafe {
        while k < tn {
            if tp[k] == 63 as u8 { qpos = k; k = tn; } else { k = k + 1; }
        }
    }
    let path_end: i64 = if qpos < 0 { tn } else { qpos };
    let path_s:  String = unsafe { String::from_bytes(tp, path_end) };
    let mut query_s: String = String::new();
    if qpos >= 0 {
        query_s = unsafe {
            String::from_bytes(tp.byte_add(qpos + 1), tn - qpos - 1)
        };
    }
    return Url {
        scheme: String::new(),
        host:   String::new(),
        port:   0,
        path:   path_s,
        query:  query_s,
    };
}

// Parse "Name: OWS value OWS" into headers, appending.
// Line has CRLF already stripped from the caller.  Returns true on success.
fn parse_header_line(hp: *const u8, hn: i64, out: &mut Headers) -> bool {
    let mut colon: i64 = 0 - 1;
    let mut k: i64 = 0;
    unsafe {
        while k < hn {
            if hp[k] == 58 as u8 { colon = k; k = hn; } else { k = k + 1; }
        }
    }
    if colon < 0 { return false; }
    unsafe {
        if !validate_token(hp, colon) { return false; }
    }
    let v0: i64 = trim_ows_left(hp, colon + 1, hn);
    let v1: i64 = trim_ows_right(hp, v0, hn);
    unsafe {
        if !validate_header_value(hp.byte_add(v0), v1 - v0) { return false; }
    }
    let name_s: String = unsafe { String::from_bytes(hp, colon) };
    let value_s: String = unsafe { String::from_bytes(hp.byte_add(v0), v1 - v0) };
    out.append(s2str(&name_s), s2str(&value_s));
    return true;
}

// Read a CRLF-terminated line from `br` into a fresh String.  Returns the
// line contents with the trailing CRLF stripped, or Err on EOF/IO/malformed.
fn read_http_line<R: Read>(br: &mut BufReader<R>) -> Result<String, HttpError> {
    let mut s: String = String::new();
    let n: i64 = br.read_line(&mut s);
    if n < 0 as i64 { return Result::Err(HttpError::Io); }
    if n == 0 as i64 { return Result::Err(HttpError::Io); }   // clean EOF
    // Expect terminating \r\n (RFC 7230 §3.5 permits bare LF leniency,
    // but we require CRLF for simplicity).
    if n < 2 as i64 { return Result::Err(HttpError::Parse); }
    unsafe {
        let p: *const u8 = (&s).as_ptr();
        if p[n - 2 as i64] != 13 as u8 || p[n - 1 as i64] != 10 as u8 {
            return Result::Err(HttpError::Parse);
        }
    }
    // Logical length is n-2; leave the trailing CRLF in the buffer but
    // callers use (&s).len() - 2 as the effective length.
    return Result::Ok(s);
}

/// Reads and parses a request head (request-line + headers) from `br`; no body is read.
/// Leaves `br` at the first body byte; the returned `Request.body` is empty — frame it
/// via `body_length(&req.headers)`.  Stricter than `parse_request_buf`: requires
/// HTTP/1.0|1.1, origin-/asterisk-form target, Host on 1.1, and no Transfer-Encoding on 1.0.
pub fn parse_request_stream<R: Read>(br: &mut BufReader<R>)
        -> Result<Request, HttpError> {
    // Request-line.
    let line1: String = match read_http_line::<R>(br) {
        Result::Ok(v)  => v,
        Result::Err(e) => { return Result::Err(e); }
    };
    let lp: *const u8 = (&line1).as_ptr();
    let ln: i64 = (&line1).len() - 2 as i64;
    let mut sp1: i64 = 0 - 1;
    let mut sp2: i64 = 0 - 1;
    let mut i: i64 = 0 as i64;
    unsafe {
        while i < ln {
            if lp[i] == 32 as u8 {
                if sp1 < 0 { sp1 = i; } else if sp2 < 0 { sp2 = i; }
            }
            i = i + 1 as i64;
        }
    }
    if sp1 < 0 || sp2 < 0 { return Result::Err(HttpError::Parse); }
    // RFC 7230 §3.1.1: exactly one SP between method/target/version, and all
    // three tokens must be non-empty.  Reject empty method (sp1 == 0), empty
    // target (adjacent SPs), and empty version (trailing SP).
    if sp1 == 0 as i64 { return Result::Err(HttpError::Parse); }
    if sp2 - sp1 <= 1 as i64 { return Result::Err(HttpError::Parse); }
    if sp2 + 1 as i64 >= ln { return Result::Err(HttpError::Parse); }
    // HTTP-version must be exactly HTTP/1.0 or HTTP/1.1.
    let ver_len: i64 = ln - (sp2 + 1 as i64);
    if ver_len != 8 as i64 { return Result::Err(HttpError::Parse); }
    let mut ver_minor: i32 = 1 as i32;
    unsafe {
        let vp: *const u8 = lp.byte_add(sp2 + 1 as i64);
        if vp[0] != 72 as u8 { return Result::Err(HttpError::Parse); } // H
        if vp[1] != 84 as u8 { return Result::Err(HttpError::Parse); } // T
        if vp[2] != 84 as u8 { return Result::Err(HttpError::Parse); } // T
        if vp[3] != 80 as u8 { return Result::Err(HttpError::Parse); } // P
        if vp[4] != 47 as u8 { return Result::Err(HttpError::Parse); } // /
        if vp[5] != 49 as u8 { return Result::Err(HttpError::Parse); } // 1
        if vp[6] != 46 as u8 { return Result::Err(HttpError::Parse); } // .
        if vp[7] == 48 as u8 {
            ver_minor = 0 as i32;
        } else if vp[7] != 49 as u8 {
            return Result::Err(HttpError::Parse);
        }
    }
    unsafe {
        if !validate_token(lp, sp1) { return Result::Err(HttpError::Parse); }
    }
    let method_str: String = unsafe { String::from_bytes(lp, sp1) };
    let target_ptr: *const u8 = unsafe { lp.byte_add(sp1 + 1 as i64) };
    let target_len: i64 = sp2 - sp1 - 1 as i64;
    unsafe {
        if !validate_request_target(target_ptr, target_len) {
            return Result::Err(HttpError::Parse);
        }
    }

    let method: Method = method_parse(s2str(&method_str));
    let url:    Url    = resolve_request_target(target_ptr, target_len);

    let mut req: Request = Request::new(method, url);
    req.version_minor = ver_minor;

    // Header block terminated by an empty CRLF line.
    while true {
        let line: String = match read_http_line::<R>(br) {
            Result::Ok(v)  => v,
            Result::Err(e) => { return Result::Err(e); }
        };
        let total: i64 = (&line).len();
        if total == 2 as i64 { break; }                 // empty line = end
        let hp: *const u8 = (&line).as_ptr();
        if !parse_header_line(hp, total - 2 as i64, &mut req.headers) {
            return Result::Err(HttpError::Parse);
        }
    }

    // RFC 7230 §5.4: HTTP/1.1 requests MUST include a Host header.
    // HTTP/1.0 has no such requirement.
    if ver_minor == 1 as i32 && !(&req.headers).contains("Host") {
        return Result::Err(HttpError::Parse);
    }

    // RFC 9112 §7: chunked transfer-coding is defined only for HTTP/1.1+.
    // HTTP/1.0 + Transfer-Encoding is a smuggling vector behind a 1.1 proxy.
    if ver_minor == 0 as i32 && (&req.headers).contains("Transfer-Encoding") {
        return Result::Err(HttpError::Parse);
    }

    return Result::Ok(req);
}

/// Reads and parses a response head (status-line + headers) from `br`; no body is read.
/// Leaves `br` at the first body byte; the returned `Response.body` is empty — frame it
/// via `body_length(&resp.headers)`.
pub fn parse_response_stream<R: Read>(br: &mut BufReader<R>)
        -> Result<Response, HttpError> {
    // Status-line.
    let line1: String = match read_http_line::<R>(br) {
        Result::Ok(v)  => v,
        Result::Err(e) => { return Result::Err(e); }
    };
    let lp: *const u8 = (&line1).as_ptr();
    let ln: i64 = (&line1).len() - 2 as i64;
    let mut sp1: i64 = 0 - 1;
    let mut sp2: i64 = 0 - 1;
    let mut i: i64 = 0 as i64;
    unsafe {
        while i < ln {
            if lp[i] == 32 as u8 {
                if sp1 < 0 { sp1 = i; } else if sp2 < 0 { sp2 = i; }
            }
            i = i + 1 as i64;
        }
    }
    if sp1 < 0 { return Result::Err(HttpError::Parse); }
    let status_end:   i64 = if sp2 < 0 { ln } else { sp2 };
    let status:       i64 = parse_decimal(lp, sp1 + 1 as i64, status_end);
    if status < 0 { return Result::Err(HttpError::Parse); }
    let reason_start: i64 = if sp2 < 0 { ln } else { sp2 + 1 as i64 };
    let reason: String = unsafe {
        String::from_bytes(lp.byte_add(reason_start), ln - reason_start)
    };

    let mut resp: Response = Response::new(status as i32);
    resp.reason.clear();
    resp.reason.push_str(s2str(&reason));

    while true {
        let line: String = match read_http_line::<R>(br) {
            Result::Ok(v)  => v,
            Result::Err(e) => { return Result::Err(e); }
        };
        let total: i64 = (&line).len();
        if total == 2 as i64 { break; }
        let hp: *const u8 = (&line).as_ptr();
        if !parse_header_line(hp, total - 2 as i64, &mut resp.headers) {
            return Result::Err(HttpError::Parse);
        }
    }
    return Result::Ok(resp);
}
