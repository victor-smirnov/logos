// Logos standard library — std.http: server API (fiber-based).
//
// Requires a Reactor installed on the current thread.  `serve_n` accepts
// `count` connections serially and closes each after a single request.
// v1 — no keep-alive, no per-connection spawn.

package std.io.http;

use std.collections.vec;
use logos.lang.option;
use logos.lang.result;
use std.lang.text;
use std.io.net;
use std.io.read;
use std.io.write;
use std.io.buffered;
use logos.std.rt.fiber;
use logos.mem.mem;

// Drain a full HTTP/1.1 request message from `s` into `buf`.  Reads until
// headers are complete AND the entire Content-Length body (or chunked
// terminator) has arrived, or the peer closes.  Returns Ok(bytes_in_buf) or
// Err on IO / framing failure.
pub fn read_request_message(s: &TcpStream, buf: &mut Vec<u8>) -> Result<i64, HttpError> {
    let mut chunk: [u8; 2048] = [0 as u8; 2048];
    let mut hdr_end: i64 = 0 - 1;
    let mut want:    i64 = 0 - 1;                              // -1 = unknown yet
    loop {
        let n: i64 = s.async_recv(&mut chunk[0 as i64], 2048 as i64);
        if n < 0 { return Result::Err(HttpError::Io); }
        if n == 0 { break; }
        let mut k: i64 = 0;
        while k < n { vec_push_u8(buf, chunk[k]); k = k + 1; }

        if hdr_end < 0 {
            let total: i64 = vec_len_u8(buf);
            let mut i: i64 = 0;
            while i + 3 < total {
                if vec_get_u8(buf, i)     == 13 as u8 && vec_get_u8(buf, i + 1) == 10 as u8 &&
                   vec_get_u8(buf, i + 2) == 13 as u8 && vec_get_u8(buf, i + 3) == 10 as u8 {
                    hdr_end = i + 4; i = total;
                } else {
                    i = i + 1;
                }
            }
        }
        if hdr_end >= 0 && want < 0 {
            // Re-parse headers block alone to compute body framing.
            let base: *const u8 = vec_at_const_u8(buf, 0 as i64);
            let total: i64 = vec_len_u8(buf);
            let mut h: Headers = Headers::new();
            let first_eol: i64 = find_crlf(base, total, 0);
            if first_eol < 0 { return Result::Err(HttpError::Parse); }
            let he: i64 = parse_headers(base, total, first_eol + 2, &mut h);
            if he < 0 { return Result::Err(HttpError::Parse); }
            let bl: i64 = body_length(&h);
            if bl == 0 - 3 { return Result::Err(HttpError::Parse); }
            if bl == 0 - 2       { want = 0 - 2; }            // chunked
            else if bl < 0       { want = hdr_end; }
            else                 { want = hdr_end + bl; }
        }
        let cur: i64 = vec_len_u8(buf);
        if want >= 0 && cur >= want { break; }
        if want == 0 - 2 {
            // chunked — look for "0\r\n\r\n"
            if cur >= hdr_end + 5 {
                let mut i: i64 = hdr_end;
                let mut done: bool = false;
                while i + 4 < cur && !done {
                    if vec_get_u8(buf, i)     == 48 as u8 &&
                       vec_get_u8(buf, i + 1) == 13 as u8 && vec_get_u8(buf, i + 2) == 10 as u8 &&
                       vec_get_u8(buf, i + 3) == 13 as u8 && vec_get_u8(buf, i + 4) == 10 as u8 {
                        done = true;
                    } else {
                        i = i + 1;
                    }
                }
                if done { return Result::Ok(vec_len_u8(buf)); }
            }
        }
    }
    return Result::Ok(vec_len_u8(buf));
}

// Emit a minimal error response (status + empty body + Connection: close)
// to `sink`.  Used by serve_connection to answer malformed requests before
// closing the connection, per RFC 7230 §3.1.1.
fn send_error_response(sink: &mut AsyncTcpStream, status: i32) -> i64 {
    let mut resp: Response = Response::new(status);
    (&mut resp.headers).append("Content-Length", "0");
    (&mut resp.headers).append("Connection", "close");
    return serialize_response_stream::<AsyncTcpStream>(&resp, sink);
}

// ── serve_connection — per-connection loop with keep-alive ─────────────────
// Parse one HTTP/1.1 request from `stream`, dispatch it to `svc`, serialize
// and write the response, then loop.  Keep-alive is on by default (per
// RFC 7230 §6.3 for HTTP/1.1); the connection closes when:
//   • the peer sent `Connection: close` on the request,
//   • the handler set `Connection: close` on the response,
//   • the request used `Transfer-Encoding: chunked` (not yet supported for
//     framed request bodies — dropped for now, P1.12 adds it),
//   • a framing / I/O error occurs.
// The TcpStream is always closed before return.
pub fn serve_connection<S: Service>(stream: TcpStream, svc: &mut S) -> i64 {
    let astream: AsyncTcpStream = async_tcp_stream(stream);
    let mut br: BufReader<AsyncTcpStream> =
        buf_reader_wrap::<AsyncTcpStream>(astream, 4096 as i64);
    let mut keep: bool = true;
    while keep {
        let mut req: Request = match parse_request_stream::<AsyncTcpStream>(&mut br) {
            Result::Ok(v)  => v,
            Result::Err(e) => {
                // Reply 4xx before closing.  Distinguish a clean client
                // hangup (EOF before any bytes) — avoid writing back in
                // that case; we'd just get EPIPE.
                match e {
                    HttpError::Io => { }                    // EOF / peer gone
                    _             => {
                        let sink: &mut AsyncTcpStream =
                            buf_reader_inner_mut::<AsyncTcpStream>(&mut br);
                        let _: i64 = send_error_response(sink, 400 as i32);
                    }
                }
                keep = false;
                break;
            }
        };

        // RFC 7231 §5.1.1: if the client signalled Expect: 100-continue we
        // must acknowledge with an interim 100 response before reading the
        // body.  Value match is case-insensitive on both the header name
        // (Headers::get) and the expectation token.
        match (&req.headers).get("expect") {
            Option::Some(v) => {
                let vp: *const u8 = (&v).as_ptr();
                let vn: i64       = (&v).len();
                if ascii_ieq(vp, vn, "100-continue".as_ptr(), 12 as i64) {
                    let reply: str = "HTTP/1.1 100 Continue\r\n\r\n";
                    let sink: &mut AsyncTcpStream =
                        buf_reader_inner_mut::<AsyncTcpStream>(&mut br);
                    let _: i64 = write_all::<AsyncTcpStream>(
                        sink, reply.as_ptr(), reply.len());
                }
            }
            Option::None => { }
        }

        // Drain the request body so the buffered reader is positioned on the
        // first byte of the next request.
        let bl: i64 = body_length(&req.headers);
        if bl > 0 as i64 {
            let mut tmp: [u8; 2048] = [0 as u8; 2048];
            let mut taken: i64 = 0 as i64;
            while taken < bl && keep {
                let mut want: i64 = 2048 as i64;
                if bl - taken < want { want = bl - taken; }
                let dst: *mut u8 = &mut tmp[0 as i64] as *mut u8;
                let n: i64 = br.read(dst, want);
                if n <= 0 as i64 { keep = false; }
                else {
                    let mut i: i64 = 0 as i64;
                    unsafe {
                        while i < n {
                            vec_push_u8(&mut req.body, dst[i]);
                            i = i + 1;
                        }
                    }
                    taken = taken + n;
                }
            }
        } else if bl == 0 - 2 as i64 {
            // Chunked request body — decode into req.body via the shared
            // BufReader (so the next pipelined request stays accessible).
            let nr: i64 = read_chunked_body::<BufReader<AsyncTcpStream>>(
                &mut br, &mut req.body);
            if nr < 0 as i64 {
                let sink: &mut AsyncTcpStream =
                    buf_reader_inner_mut::<AsyncTcpStream>(&mut br);
                let _: i64 = send_error_response(sink, 400 as i32);
                keep = false;
            }
        } else if bl == 0 - 3 as i64 {
            // Malformed Content-Length — reply 400 before closing.
            let sink: &mut AsyncTcpStream =
                buf_reader_inner_mut::<AsyncTcpStream>(&mut br);
            let _: i64 = send_error_response(sink, 400 as i32);
            keep = false;
        }
        if !keep { break; }

        // Request-level keep-alive signal.
        match (&req.headers).get("connection") {
            Option::Some(v) => { if (&v).eq_str("close") { keep = false; } }
            Option::None    => { }
        }

        let resp: Response = svc.call(&req);

        // Handler may also request close.
        match (&resp.headers).get("connection") {
            Option::Some(v) => { if (&v).eq_str("close") { keep = false; } }
            Option::None    => { }
        }

        let inner: &mut AsyncTcpStream =
            buf_reader_inner_mut::<AsyncTcpStream>(&mut br);
        let rs: i64 = serialize_response_stream::<AsyncTcpStream>(&resp, inner);
        if rs < 0 as i64 { keep = false; }
    }

    let s: &mut AsyncTcpStream = buf_reader_inner_mut::<AsyncTcpStream>(&mut br);
    s.close();
    br.close();
    return 0 as i64;
}

// ── Accept loop + graceful shutdown ─────────────────────────────────────────
// serve_bounded accepts up to `count` connections serially and runs each
// through serve_connection (so keep-alive works per connection).  Returns
// after `count` connections have been served or accept fails.  Use this in
// tests and in "single request batch" scenarios.
pub fn serve_bounded<S: Service>(port: u16, count: i64, svc: &mut S)
    -> Result<(), HttpError>
{
    let mut listener: TcpListener = tcp_listen(inaddr_any(), port, 4096 as i32);
    if !(&listener).is_valid() { return Result::Err(HttpError::Connect); }
    let mut i: i64 = 0 as i64;
    while i < count {
        let stream: TcpStream = (&listener).async_accept();
        if !(&stream).is_valid() { break; }
        let _: i64 = serve_connection::<S>(stream, svc);
        i = i + 1;
    }
    listener.close();
    return Result::Ok(());
}

// serve_until accepts connections until `*stop_flag != 0`.  The stop flag
// must be an i64 cell the caller mutates from another fiber / signal
// handler — checked between accepts.  Returns Ok(()) on clean stop or
// Err(Connect) if bind fails.
pub fn serve_until<S: Service>(port: u16, svc: &mut S, stop_flag: *mut i64)
    -> Result<(), HttpError>
{
    let mut listener: TcpListener = tcp_listen(inaddr_any(), port, 4096 as i32);
    if !(&listener).is_valid() { return Result::Err(HttpError::Connect); }
    unsafe {
        while stop_flag[0 as i64] == 0 as i64 {
            let stream: TcpStream = (&listener).async_accept();
            if !(&stream).is_valid() { break; }
            let _: i64 = serve_connection::<S>(stream, svc);
        }
    }
    listener.close();
    return Result::Ok(());
}

// Bind, accept `count` connections serially, invoke `handler` for each,
// serialize the response, write it back, close.  Returns Ok(()) once `count`
// connections have been served, or Err on fatal bind/accept failure.
pub fn serve_n(port: u16, count: i64, handler: fn(&Request) -> Response) -> Result<(), HttpError> {
    let mut listener: TcpListener = tcp_listen(inaddr_any(), port, 16 as i32);
    if !(&listener).is_valid() { return Result::Err(HttpError::Connect); }

    let mut served: i64 = 0;
    while served < count {
        let mut s: TcpStream = (&listener).async_accept();
        if !(&s).is_valid() {
            listener.close();
            return Result::Err(HttpError::Connect);
        }
        let mut rx: Vec<u8> = vec_new::<u8>();
        let read_ok: bool = match read_request_message(&s, &mut rx) {
            Result::Ok(_)  => { true }
            Result::Err(_) => { false }
        };
        if read_ok {
            let rx_ptr: *const u8 = vec_at_const_u8(&rx, 0 as i64);
            let rx_len: i64 = vec_len_u8(&rx);
            match parse_request_buf(rx_ptr, rx_len) {
                Result::Ok(req) => {
                    let resp: Response = handler(&req);
                    let mut tx: Vec<u8> = vec_new::<u8>();
                    serialize_response(&resp, &mut tx);
                    let tlen: i64 = vec_len_u8(&tx);
                    let mut off: i64 = 0;
                    while off < tlen {
                        let p: *const u8 = vec_at_const_u8(&tx, off);
                        let nw: i64 = (&s).async_send(p, tlen - off);
                        if nw <= 0 { off = tlen; }
                        else        { off = off + nw; }
                    }
                }
                Result::Err(_) => { }
            }
        }
        s.close();
        served = served + 1;
    }
    listener.close();
    return Result::Ok(());
}

// ── serve_mt — multi-worker (Phase 2) ───────────────────────────────────────
// ConnTask packs a connection fd + type-erased service pointer for handoff
// across an SPSC inbox.  Heap-allocated by the acceptor, freed by the worker
// fiber after it is consumed.
pub struct ConnTask {
    pub fd:  i32,
    pub pad: i32,
    pub svc: i64,
}

// Worker-side fiber entry: reconstruct a TcpStream from the handed-off fd,
// cast the service pointer back to its concrete type, run serve_connection.
// Monomorphized per S at the call site inside serve_mt.
// NOTE: taking a fn pointer to a generic function does not yet monomorphize
// via turbofish (linker gets `undefined <name>__g__i64`).  Until that is
// fixed, serve_mt_bounded specializes on FnService — the only Service impl
// callable today.  When trait-object dispatch lands, restore the generic
// serve_mt_conn_fiber<S: Service> form.
fn serve_mt_conn_fnservice(arg: i64) {
    let t: *mut ConnTask = arg as *mut ConnTask;
    let fd: i32 = unsafe { t.fd };
    let svc_raw: i64 = unsafe { t.svc };
    dealloc(t as *mut u8);
    let stream: TcpStream = tcp_stream_from_fd(fd);
    let svc: &mut FnService = unsafe { &mut *(svc_raw as *mut FnService) };
    let _: i64 = serve_connection::<FnService>(stream, svc);
}

// Multi-worker server: bind on the calling thread's reactor, accept in a
// loop, hand each connection round-robin to one of `n_workers` worker
// threads.  Stops when *stop_flag != 0 or accept fails.  The caller supplies
// a reactor+scheduler on the calling thread (same as serve_until).
//
// Safety: `svc` is shared by raw pointer across all worker threads.  For
// stateless services (FnService, etc.) this is trivially safe.  Stateful
// services must provide their own Sync via atomics or locks.
pub fn serve_mt(port: u16, n_workers: i32, svc: &mut FnService,
                 stop_flag: *mut i64) -> Result<(), HttpError> {
    if n_workers < 1 as i32 { return Result::Err(HttpError::Connect); }
    let mut listener: TcpListener = tcp_listen(inaddr_any(), port, 4096 as i32);
    if !(&listener).is_valid() { return Result::Err(HttpError::Connect); }

    let pool: *mut ThreadPool = thread_pool_new(n_workers);
    thread_pool_start(pool);

    let svc_raw: i64 = svc as *mut FnService as i64;
    let mut rr: i32 = 0 as i32;
    unsafe {
        while stop_flag[0 as i64] == 0 as i64 {
            let stream: TcpStream = (&listener).async_accept();
            if !(&stream).is_valid() { break; }
            let task: *mut ConnTask =
                alloc(sizeof::<ConnTask>()) as *mut ConnTask;
            task.fd  = (&stream).raw_fd();
            task.pad = 0 as i32;
            task.svc = svc_raw;
            let fp: fn(i64) -> () = serve_mt_conn_fnservice;
            thread_submit(pool, rr, fp, task as i64);
            rr = rr + 1 as i32;
            if rr >= n_workers { rr = 0 as i32; }
        }
    }
    listener.close();
    thread_pool_signal_done(pool);
    thread_pool_join(pool);
    thread_pool_free(pool);
    return Result::Ok(());
}

// Bounded multi-worker variant: accept exactly `count` connections, hand
// them round-robin to `n_workers` workers, then signal shutdown and RETURN
// the pool to the caller.  Caller must thread_pool_join + thread_pool_free
// AFTER its reactor has drained — doing that inside the fiber would block
// the OS thread and deadlock client fibers sharing its scheduler.
pub fn serve_mt_bounded(port: u16, n_workers: i32, count: i64,
                         svc: &mut FnService) -> *mut ThreadPool {
    if n_workers < 1 as i32 { return 0 as *mut ThreadPool; }
    let mut listener: TcpListener = tcp_listen(inaddr_any(), port, 4096 as i32);
    if !(&listener).is_valid() { return 0 as *mut ThreadPool; }

    let pool: *mut ThreadPool = thread_pool_new(n_workers);
    thread_pool_start(pool);

    let svc_raw: i64 = svc as *mut FnService as i64;
    let mut rr: i32 = 0 as i32;
    let mut served: i64 = 0 as i64;
    while served < count {
        let stream: TcpStream = (&listener).async_accept();
        if !(&stream).is_valid() { break; }
        let task: *mut ConnTask =
            alloc(sizeof::<ConnTask>()) as *mut ConnTask;
        unsafe {
            task.fd  = (&stream).raw_fd();
            task.pad = 0 as i32;
            task.svc = svc_raw;
        }
        let fp: fn(i64) -> () = serve_mt_conn_fnservice;
        thread_submit(pool, rr, fp, task as i64);
        rr = rr + 1 as i32;
        if rr >= n_workers { rr = 0 as i32; }
        served = served + 1 as i64;
    }
    listener.close();
    thread_pool_signal_done(pool);
    return pool;
}
