// Logos standard library — std.http: core types (Method, Headers, Request,
// Response, HttpError) and small internal helpers shared across the package.
//
// Vec<T> methods currently take `*mut self`; until that moves to `&mut self`
// we contain the raw-pointer dance in a single helper and otherwise keep
// signatures safe.

package logos.std.io.http;

use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.lang.option;
use logos.lang.result;
use logos.std.io.net.url;

// ── Internal helpers (package-private) ───────────────────────────────────────

/// Pushes byte `b` onto `v`.
// Push a u8 into a Vec<u8> via a &mut Vec<u8>. The cast is the current
// workaround for Vec::push taking *mut self; centralising it here keeps the
// rest of the package free of inline raw-pointer casts.
pub fn vec_push_u8(v: &mut Vec<u8>, b: u8) {
    unsafe {
        let p: *mut Vec<u8> = v;
        p.push(b);
    }
}

/// Returns the number of bytes in `v`.
pub fn vec_len_u8(v: &Vec<u8>) -> i64 {
    unsafe {
        let p: *mut Vec<u8> = v as *const Vec<u8> as *mut Vec<u8>;
        return p.length();
    }
}

/// Returns the byte at index `i` of `v`.
pub fn vec_get_u8(v: &Vec<u8>, i: i64) -> u8 {
    unsafe {
        let p: *mut Vec<u8> = v as *const Vec<u8> as *mut Vec<u8>;
        return p.get(i);
    }
}

/// Returns a raw const pointer to the byte at index `i` of `v`.
pub fn vec_at_const_u8(v: &Vec<u8>, i: i64) -> *const u8 {
    unsafe {
        let p: *mut Vec<u8> = v as *const Vec<u8> as *mut Vec<u8>;
        return p.at_const(i) as *const u8;
    }
}

/// Borrows a `String`'s contents as a `str` (no copy).
// Borrow a String as str (no copy).  Free function because methods returning
// `str` currently hit a codegen corner around sret.
pub fn s2str(s: &String) -> str {
    return unsafe { str_from_raw((s).as_ptr(), (s).len()) };
}

/// Compares two byte ranges exactly (ASCII, case-sensitive).
pub fn bytes_eq(a: *const u8, an: i64, b: *const u8, bn: i64) -> bool {
    if an != bn { return false; }
    let mut i: i64 = 0;
    while i < an {
        unsafe { if a[i] != b[i] { return false; } }
        i = i + 1;
    }
    return true;
}

/// Compares two byte ranges case-insensitively (ASCII only).
pub fn ascii_ieq(a: *const u8, an: i64, b: *const u8, bn: i64) -> bool {
    if an != bn { return false; }
    let mut i: i64 = 0;
    while i < an {
        unsafe {
            let mut ca: i32 = a[i] as i32;
            let mut cb: i32 = b[i] as i32;
            if ca >= 65 && ca <= 90 { ca = ca + 32; }
            if cb >= 65 && cb <= 90 { cb = cb + 32; }
            if ca != cb { return false; }
        }
        i = i + 1;
    }
    return true;
}

// ── Method ───────────────────────────────────────────────────────────────────
// Small integer code plus literal token. Unknown / extension methods share
// code == 7 and preserve the token verbatim in `name`.

/// HTTP request method: a small integer `code` plus the literal token.
pub struct Method {
    /// Method code; known methods use 0–6, unknown/extension methods share 7.
    pub code: i32,
    /// Method token verbatim (e.g. `"GET"`).
    pub name: String,
}

fn method_with(code: i32, s: str) -> Method {
    let mut n: String = String::new();
    n.push_str(s);
    return Method { code: code, name: n };
}

impl Method {
    /// Returns the `GET` method.
    pub static fn get()     -> Method { return method_with(0, "GET");     }
    /// Returns the `POST` method.
    pub static fn post()    -> Method { return method_with(1, "POST");    }
    /// Returns the `PUT` method.
    pub static fn put()     -> Method { return method_with(2, "PUT");     }
    /// Returns the `DELETE` method.
    pub static fn delete()  -> Method { return method_with(3, "DELETE");  }
    /// Returns the `HEAD` method.
    pub static fn head()    -> Method { return method_with(4, "HEAD");    }
    /// Returns the `OPTIONS` method.
    pub static fn options() -> Method { return method_with(5, "OPTIONS"); }
    /// Returns the `PATCH` method.
    pub static fn patch()   -> Method { return method_with(6, "PATCH");   }

    /// Returns `true` if the method token equals `s` exactly (case-sensitive).
    pub fn eq_str(&self, s: str) -> bool {
        return self.name.eq_str(s);
    }
}

/// Parses a method token (ASCII, case-sensitive per RFC 7230).
/// Unknown tokens return `code == 7` with the original name preserved.
pub fn method_parse(s: str) -> Method {
    let p: *const u8 = s.as_ptr();
    let n: i64 = s.len();
    if bytes_eq(p, n, "GET"    .as_ptr(), 3) { return Method::get();     }
    if bytes_eq(p, n, "PUT"    .as_ptr(), 3) { return Method::put();     }
    if bytes_eq(p, n, "POST"   .as_ptr(), 4) { return Method::post();    }
    if bytes_eq(p, n, "HEAD"   .as_ptr(), 4) { return Method::head();    }
    if bytes_eq(p, n, "PATCH"  .as_ptr(), 5) { return Method::patch();   }
    if bytes_eq(p, n, "DELETE" .as_ptr(), 6) { return Method::delete();  }
    if bytes_eq(p, n, "OPTIONS".as_ptr(), 7) { return Method::options(); }
    let mut name: String = String::new();
    name.push_str(s);
    return Method { code: 7, name: name };
}

// ── Headers ──────────────────────────────────────────────────────────────────
// Ordered list of (name, value) pairs; duplicates allowed (e.g. Set-Cookie).
// Lookup is case-insensitive per RFC 7230 §3.2.
//
// Storage: one `buf` blob with every name+value back-to-back, NUL-separated.
// `entries` is a parallel Vec<Header> of (name_off, name_len, value_off,
// value_len) quads. This sidesteps the current Vec-of-struct-with-Drop
// limitation.

/// Offset/length quad locating one header's name and value inside `Headers::buf`.
pub struct Header {
    /// Byte offset of the name within `Headers::buf`.
    pub name_off:  i32,
    /// Byte length of the name.
    pub name_len:  i32,
    /// Byte offset of the value within `Headers::buf`.
    pub value_off: i32,
    /// Byte length of the value.
    pub value_len: i32,
}

impl Copy for Header {}

/// Ordered list of HTTP header `(name, value)` pairs; duplicates allowed.
/// Name lookup is ASCII case-insensitive (RFC 7230 §3.2).
pub struct Headers {
    /// Backing storage: every name and value back-to-back, NUL-separated.
    pub buf:     String,
    /// Per-header offset/length quads indexing into `buf`.
    pub entries: Vec<Header>,
}

impl Headers {
    /// Creates an empty header list.
    pub static fn new() -> Headers {
        return Headers {
            buf:     String::new(),
            entries: vec_new::<Header>(),
        };
    }

    /// Returns the number of header entries.
    pub fn len(&self) -> i64 {
        return (&self.entries).length();
    }

    unsafe fn name_ptr(&self, h: Header) -> *const u8 {
        return (&self.buf).as_ptr().byte_add(h.name_off as i64);
    }

    unsafe fn value_ptr(&self, h: Header) -> *const u8 {
        return (&self.buf).as_ptr().byte_add(h.value_off as i64);
    }

    /// Appends a `(name, value)` pair unconditionally (preserves duplicates).
    pub fn append(&mut self, name: str, value: str) {
        let name_off: i32 = (&self.buf).len() as i32;
        let name_len: i32 = name.len() as i32;
        self.buf.push_str(name);
        self.buf.push_u8(0 as u8);
        let value_off: i32 = (&self.buf).len() as i32;
        let value_len: i32 = value.len() as i32;
        self.buf.push_str(value);
        self.buf.push_u8(0 as u8);
        let h: Header = Header {
            name_off:  name_off,
            name_len:  name_len,
            value_off: value_off,
            value_len: value_len,
        };
        unsafe {
            let p: *mut Vec<Header> = &mut self.entries;
            p.push(h);
        }
    }

    /// Returns `true` if any header matches `name` (ASCII case-insensitive).
    pub fn contains(&self, name: str) -> bool {
        let nptr: *const u8 = name.as_ptr();
        let nlen: i64 = name.len();
        let total: i64 = (&self.entries).length();
        let mut i: i64 = 0;
        unsafe {
            let ep: *mut Vec<Header> = &self.entries as *const Vec<Header> as *mut Vec<Header>;
            while i < total {
                let h: Header = ep.get(i);
                if ascii_ieq(self.name_ptr(h), h.name_len as i64, nptr, nlen) {
                    return true;
                }
                i = i + 1;
            }
        }
        return false;
    }

    /// Returns the value of the first header matching `name`, or `None`.
    pub fn get(&self, name: str) -> Option<String> {
        let nptr: *const u8 = name.as_ptr();
        let nlen: i64 = name.len();
        let total: i64 = (&self.entries).length();
        let mut i: i64 = 0;
        unsafe {
            let ep: *mut Vec<Header> = &self.entries as *const Vec<Header> as *mut Vec<Header>;
            while i < total {
                let h: Header = ep.get(i);
                if ascii_ieq(self.name_ptr(h), h.name_len as i64, nptr, nlen) {
                    let s: String = String::from_bytes(
                        self.value_ptr(h), h.value_len as i64);
                    return Option::Some(s);
                }
                i = i + 1;
            }
        }
        return Option::None;
    }

    /// Replaces the first header matching `name` with `value`, or appends if none matches.
    /// Later duplicates of `name` are left in place.
    pub fn set(&mut self, name: str, value: str) {
        let nptr: *const u8 = name.as_ptr();
        let nlen: i64 = name.len();
        let total: i64 = (&self.entries).length();
        let mut i: i64 = 0;
        unsafe {
            let ep: *mut Vec<Header> = &mut self.entries;
            while i < total {
                let h: Header = ep.get(i);
                if ascii_ieq(self.name_ptr(h), h.name_len as i64, nptr, nlen) {
                    let buf_ref: &mut String = &mut self.buf;
                    let name_off: i32 = buf_ref.len() as i32;
                    buf_ref.push_str(name);
                    buf_ref.push_u8(0 as u8);
                    let value_off: i32 = buf_ref.len() as i32;
                    buf_ref.push_str(value);
                    buf_ref.push_u8(0 as u8);
                    ep.set(i, Header {
                        name_off:  name_off,
                        name_len:  name.len() as i32,
                        value_off: value_off,
                        value_len: value.len() as i32,
                    });
                    return;
                }
                i = i + 1;
            }
        }
        self.append(name, value);
    }

    /// Removes all headers matching `name`; returns the number removed.
    pub fn remove(&mut self, name: str) -> i64 {
        let nptr: *const u8 = name.as_ptr();
        let nlen: i64 = name.len();
        let mut removed: i64 = 0;
        let mut i: i64 = 0;
        unsafe {
            let ep: *mut Vec<Header> = &mut self.entries;
            while i < ep.length() {
                let h: Header = ep.get(i);
                if ascii_ieq(self.name_ptr(h), h.name_len as i64, nptr, nlen) {
                    ep.remove(i);
                    removed = removed + 1;
                } else {
                    i = i + 1;
                }
            }
        }
        return removed;
    }
}

// ── Request / Response ───────────────────────────────────────────────────────

/// HTTP request: method, target URL, headers, and body.
pub struct Request {
    /// Request method.
    pub method:  Method,
    /// Target URL.
    pub url:     Url,
    /// Request headers.
    pub headers: Headers,
    /// Request body bytes.
    pub body:    Vec<u8>,
    /// HTTP version minor digit from the request line: 0 for HTTP/1.0, 1 for HTTP/1.1.
    /// Major is always 1 (higher majors are rejected by the parser).
    pub version_minor: i32,
}

/// HTTP response: status code, reason phrase, headers, and body.
pub struct Response {
    /// Status code (e.g. `200`).
    pub status:  i32,
    /// Reason phrase for the status line.
    pub reason:  String,
    /// Response headers.
    pub headers: Headers,
    /// Response body bytes.
    pub body:    Vec<u8>,
}

impl Request {
    /// Creates a request with empty headers and body; `version_minor` defaults to 1.
    pub static fn new(method: Method, u: Url) -> Request {
        return Request {
            method:        method,
            url:           u,
            headers:       Headers::new(),
            body:          vec_new::<u8>(),
            version_minor: 1 as i32,
        };
    }
}

impl Response {
    /// Creates a response with the canonical reason phrase for `status`, empty headers and body.
    pub static fn new(status: i32) -> Response {
        let mut r: String = String::new();
        r.push_str(http_reason_phrase(status));
        return Response {
            status:  status,
            reason:  r,
            headers: Headers::new(),
            body:    vec_new::<u8>(),
        };
    }
}

// ── HttpError ────────────────────────────────────────────────────────────────

/// Errors produced by HTTP client and server operations.
pub enum HttpError {
    /// TCP connect / listen / accept failed.
    Connect,        // TCP connect / listen / accept failed
    /// Send / recv failed mid-exchange.
    Io,             // send / recv failed mid-exchange
    /// Malformed request or response bytes.
    Parse,          // malformed request/response bytes
    /// Response status rejected by a caller; carries the status code.
    BadStatus(i32), // response whose status was rejected by a caller
    /// `url_parse` failed or the host was not numeric IPv4.
    BadUrl,         // url_parse failed or host wasn't numeric-IPv4
}

/// Returns the standard reason phrase for `status`; unknown codes yield `""`.
pub fn http_reason_phrase(status: i32) -> str {
    if status == 200 { return "OK"; }
    if status == 201 { return "Created"; }
    if status == 204 { return "No Content"; }
    if status == 301 { return "Moved Permanently"; }
    if status == 302 { return "Found"; }
    if status == 304 { return "Not Modified"; }
    if status == 400 { return "Bad Request"; }
    if status == 401 { return "Unauthorized"; }
    if status == 403 { return "Forbidden"; }
    if status == 404 { return "Not Found"; }
    if status == 405 { return "Method Not Allowed"; }
    if status == 408 { return "Request Timeout"; }
    if status == 411 { return "Length Required"; }
    if status == 413 { return "Payload Too Large"; }
    if status == 500 { return "Internal Server Error"; }
    if status == 501 { return "Not Implemented"; }
    if status == 502 { return "Bad Gateway"; }
    if status == 503 { return "Service Unavailable"; }
    return "";
}
