// Logos standard library — std.http: chunked transfer-encoding codec
// (RFC 7230 §4.1).

package std.io.http;

use std.collections.vec;
use std.io.read;
use std.io.write;

fn hex_digit_value(b: u8) -> i32 {
    if b >= 48 as u8 && b <= 57 as u8  { return (b as i32) - 48; }
    if b >= 97 as u8 && b <= 102 as u8 { return (b as i32) - 97 + 10; }
    if b >= 65 as u8 && b <= 70 as u8  { return (b as i32) - 65 + 10; }
    return 0 - 1;
}

fn write_hex_len(n: i64, out: &mut Vec<u8>) {
    if n == 0 { vec_push_u8(out, 48 as u8); return; }
    let mut buf: [u8; 32] = [0 as u8; 32];
    let mut v: i64 = n;
    let mut k: i64 = 0;
    while v > 0 {
        let d: i64 = v & 15 as i64;
        if d < 10 { buf[k] = (d + 48) as u8; }
        else      { buf[k] = (d - 10 + 97) as u8; }    // lowercase a-f
        v = v >> 1 >> 1 >> 1 >> 1;                     // v / 16
        k = k + 1;
    }
    while k > 0 { k = k - 1; vec_push_u8(out, buf[k]); }
}

// Append one chunk (hex-length + CRLF + data + CRLF) to `out`.
pub fn chunked_write_chunk(data: *const u8, n: i64, out: &mut Vec<u8>) {
    write_hex_len(n, out);
    vec_push_u8(out, 13 as u8); vec_push_u8(out, 10 as u8);
    let mut i: i64 = 0;
    while i < n {
        unsafe { vec_push_u8(out, data[i]); }
        i = i + 1;
    }
    vec_push_u8(out, 13 as u8); vec_push_u8(out, 10 as u8);
}

// Append the terminator ("0\r\n\r\n") to `out`.
pub fn chunked_finalize(out: &mut Vec<u8>) {
    vec_push_u8(out, 48 as u8);                        // "0"
    vec_push_u8(out, 13 as u8); vec_push_u8(out, 10 as u8);
    vec_push_u8(out, 13 as u8); vec_push_u8(out, 10 as u8); // trailer CRLF
}

// Encode a body as a single chunk followed by the zero-length terminator.
// Suitable for "encode my whole body"; callers wanting streaming call
// chunked_write_chunk repeatedly then chunked_finalize.
pub fn chunked_encode(data: *const u8, n: i64, out: &mut Vec<u8>) {
    if n > 0 { chunked_write_chunk(data, n, out); }
    chunked_finalize(out);
}

// Decode chunked bytes [src, src+len) into `out`.
// Returns total input bytes consumed on success (through final trailer CRLF),
// or -1 on malformed input.  Trailer headers are parsed and skipped.
pub fn chunked_decode(src: *const u8, len: i64, out: &mut Vec<u8>) -> i64 {
    let mut pos: i64 = 0;
    unsafe {
        while true {
            let mut size: i64 = 0;
            let mut seen_digit: bool = false;
            while pos < len {
                let b: u8 = src[pos];
                if b == 13 as u8 || b == 59 as u8 { break; }   // CR or ';'
                let d: i32 = hex_digit_value(b);
                if d < 0 { return 0 - 1; }
                size = (size << 1 << 1 << 1 << 1) + (d as i64);
                seen_digit = true;
                pos = pos + 1;
            }
            if !seen_digit { return 0 - 1; }
            // Skip chunk-ext up to CRLF.
            while pos < len && src[pos] != 13 as u8 { pos = pos + 1; }
            if pos + 1 >= len || src[pos] != 13 as u8 || src[pos + 1] != 10 as u8 {
                return 0 - 1;
            }
            pos = pos + 2;
            if size == 0 {
                // Skip optional trailer headers until an empty line.
                while true {
                    // inlined find_crlf
                    let mut le: i64 = 0 - 1;
                    let mut j: i64 = pos;
                    while (j + 1) < len {
                        if src[j] == 13 as u8 && src[j + 1] == 10 as u8 {
                            le = j; j = len;
                        } else {
                            j = j + 1;
                        }
                    }
                    if le < 0 { return 0 - 1; }
                    if le == pos { pos = le + 2; return pos; }
                    pos = le + 2;
                }
            }
            if pos + size + 2 > len { return 0 - 1; }
            let mut i: i64 = 0;
            while i < size {
                vec_push_u8(out, src[pos + i]);
                i = i + 1;
            }
            pos = pos + size;
            if src[pos] != 13 as u8 || src[pos + 1] != 10 as u8 { return 0 - 1; }
            pos = pos + 2;
        }
    }
    return pos;
}

// ── Streaming decoder: ChunkedReader<R: Read> ───────────────────────────────
// Wraps a Read source that is delivering chunked-encoded bytes (typically a
// BufReader<...>) and exposes the decoded body as a plain Read.
//
// State values:
//   0 = reading chunk-size line
//   1 = reading chunk data (remaining bytes to deliver)
//   2 = consuming CRLF after chunk data
//   3 = consuming optional trailer headers until empty line
//   4 = done (EOF)
//   5 = error (permanent)

pub struct ChunkedReader<R> {
    reader:    R,
    state:     i32,
    remaining: i64,
}

pub fn chunked_reader_wrap<R: Read>(r: R) -> ChunkedReader<R> {
    return ChunkedReader { reader: r, state: 0 as i32, remaining: 0 as i64 };
}

impl<R: Read> ChunkedReader<R> {
    // Internal: read exactly one byte from the underlying reader.
    // Returns byte as i32 in [0,255], or negative on EOF/error.
    fn read_one(self: &mut ChunkedReader<R>) -> i32 {
        unsafe {
            let mut b: u8 = 0 as u8;
            let n: i64 = self.reader.read(&mut b as *mut u8, 1 as i64);
            if n == 1 as i64 { return b as i32; }
            if n == 0 as i64 { return 0 - 1; }
            return 0 - 2;
        }
    }

    // Parse hex chunk-size terminated by CRLF (chunk extensions after ';'
    // are tolerated and skipped).  Returns size, or <0 on error.
    fn read_chunk_size(self: &mut ChunkedReader<R>) -> i64 {
        let mut size: i64 = 0;
        let mut seen: bool = false;
        let mut in_ext: bool = false;
        while true {
            let c: i32 = self.read_one();
            if c < 0 { return 0 - 1 as i64; }
            if c == 13 {                               // CR
                let lf: i32 = self.read_one();
                if lf != 10 { return 0 - 1 as i64; }   // require LF
                if !seen { return 0 - 1 as i64; }
                return size;
            }
            if in_ext { continue; }
            if c == 59 { in_ext = true; continue; }    // ';' begins ext
            let b: u8 = c as u8;
            let d: i32 = hex_digit_value(b);
            if d < 0 { return 0 - 1 as i64; }
            size = (size << 1 << 1 << 1 << 1) + (d as i64);
            seen = true;
        }
        return 0 - 1 as i64;
    }

    // Consume CRLF after a chunk body.
    fn consume_crlf(self: &mut ChunkedReader<R>) -> bool {
        let a: i32 = self.read_one();
        let b: i32 = self.read_one();
        return a == 13 && b == 10;
    }

    // Consume trailer headers until an empty line is seen.
    fn skip_trailer(self: &mut ChunkedReader<R>) -> bool {
        while true {
            let c: i32 = self.read_one();
            if c < 0 { return false; }
            if c == 13 {
                let lf: i32 = self.read_one();
                if lf != 10 { return false; }
                // Empty line closes the trailer section.
                return true;
            }
            // Header line — skip up to CRLF.
            while true {
                let k: i32 = self.read_one();
                if k < 0 { return false; }
                if k == 13 {
                    let lf: i32 = self.read_one();
                    if lf != 10 { return false; }
                    break;
                }
            }
        }
        return false;
    }
}

impl<R: Read> Read for ChunkedReader<R> {
    fn read(self: &mut ChunkedReader<R>, buf: *mut u8, len: i64) -> i64 {
        if len <= 0 as i64 { return 0 as i64; }
        // Drive the state machine until we produce bytes or reach EOF/error.
        while true {
            if self.state == 4 as i32 { return 0 as i64; }
            if self.state == 5 as i32 { return 0 - 1 as i64; }

            if self.state == 0 as i32 {
                let sz: i64 = self.read_chunk_size();
                if sz < 0 as i64 { self.state = 5 as i32; return 0 - 1 as i64; }
                if sz == 0 as i64 {
                    self.state = 3 as i32;
                } else {
                    self.remaining = sz;
                    self.state = 1 as i32;
                }
                continue;
            }

            if self.state == 1 as i32 {
                let mut take: i64 = self.remaining;
                if len < take { take = len; }
                unsafe {
                    let n: i64 = self.reader.read(buf, take);
                    if n <= 0 as i64 { self.state = 5 as i32; return 0 - 1 as i64; }
                    self.remaining = self.remaining - n;
                    if self.remaining == 0 as i64 { self.state = 2 as i32; }
                    return n;
                }
            }

            if self.state == 2 as i32 {
                if !self.consume_crlf() { self.state = 5 as i32; return 0 - 1 as i64; }
                self.state = 0 as i32;
                continue;
            }

            if self.state == 3 as i32 {
                if !self.skip_trailer() { self.state = 5 as i32; return 0 - 1 as i64; }
                self.state = 4 as i32;
                return 0 as i64;
            }
        }
        return 0 as i64;
    }
}

// ── ContentLengthReader<R: Read> ────────────────────────────────────────────
// Caps reads from a Read source at a fixed byte budget.  Used to frame a
// body that came with a `Content-Length: N` header.  Returns 0 (EOF) once
// the budget is exhausted; never reads past it from the underlying reader.

pub struct ContentLengthReader<R> {
    reader:    R,
    remaining: i64,
}

pub fn content_length_reader_wrap<R: Read>(r: R, n: i64) -> ContentLengthReader<R> {
    let mut capped: i64 = n;
    if capped < 0 as i64 { capped = 0 as i64; }
    return ContentLengthReader { reader: r, remaining: capped };
}

impl<R: Read> Read for ContentLengthReader<R> {
    fn read(self: &mut ContentLengthReader<R>, buf: *mut u8, len: i64) -> i64 {
        if self.remaining == 0 as i64 { return 0 as i64; }
        if len <= 0 as i64 { return 0 as i64; }
        let mut want: i64 = len;
        if self.remaining < want { want = self.remaining; }
        unsafe {
            let n: i64 = self.reader.read(buf, want);
            if n > 0 as i64 { self.remaining = self.remaining - n; }
            return n;
        }
    }
}

// ── ChunkedWriter<W: Write> ─────────────────────────────────────────────────
// Wraps a Write sink and frames each write() call as one chunked-encoded
// record (hex size + CRLF + data + CRLF).  Call finish() to emit the
// zero-length terminator.  For chatty producers, wrap the underlying sink
// in a BufWriter first so small chunks are coalesced at the transport.
//
// finish() must be called exactly once; after that, further writes are
// rejected with -1.  Dropping without finish() leaves the stream malformed
// — callers own this.

pub struct ChunkedWriter<W> {
    writer:   W,
    finished: bool,
}

pub fn chunked_writer_wrap<W: Write>(w: W) -> ChunkedWriter<W> {
    return ChunkedWriter { writer: w, finished: false };
}

// Write ASCII hex representation of `n` through the underlying writer.
// Returns 0 on success, <0 on write error.
fn cw_write_hex_len<W: Write>(w: &mut W, n: i64) -> i64 {
    if n == 0 as i64 {
        let zero: u8 = 48 as u8;
        unsafe { return w.write(&zero as *const u8, 1 as i64); }
    }
    let mut buf: [u8; 32] = [0 as u8; 32];
    let mut v: i64 = n;
    let mut k: i64 = 0;
    while v > 0 as i64 {
        let d: i64 = v & 15 as i64;
        if d < 10 as i64 { buf[k] = (d + 48 as i64) as u8; }
        else             { buf[k] = (d - 10 as i64 + 97 as i64) as u8; }
        v = v >> 1 >> 1 >> 1 >> 1;
        k = k + 1 as i64;
    }
    // Reverse into a second buffer so bytes come out high-order first.
    let mut out: [u8; 32] = [0 as u8; 32];
    let mut i: i64 = 0;
    while i < k {
        out[i] = buf[k - 1 as i64 - i];
        i = i + 1 as i64;
    }
    unsafe { return w.write(&out[0] as *const u8, k); }
}

fn cw_write_crlf<W: Write>(w: &mut W) -> i64 {
    let crlf: [u8; 2] = [13 as u8, 10 as u8];
    unsafe { return w.write(&crlf[0] as *const u8, 2 as i64); }
}

impl<W: Write> ChunkedWriter<W> {
    // Emit the zero-length terminator "0\r\n\r\n".  Idempotent-safe:
    // subsequent calls return 0 without re-emitting.
    pub fn finish(self: &mut ChunkedWriter<W>) -> i64 {
        if self.finished { return 0 as i64; }
        self.finished = true;
        let term: [u8; 5] = [48 as u8, 13 as u8, 10 as u8, 13 as u8, 10 as u8];
        unsafe {
            let n: i64 = self.writer.write(&term[0] as *const u8, 5 as i64);
            if n < 0 as i64 { return n; }
            return self.writer.flush();
        }
    }
}

impl<W: Write> Write for ChunkedWriter<W> {
    // Emit one chunk carrying the full [buf, buf+len) payload.  Empty
    // writes (len==0) are ignored so callers don't accidentally emit the
    // zero-length terminator ahead of finish().  Returns `len` on success,
    // <0 on underlying write error.
    fn write(self: &mut ChunkedWriter<W>, buf: *const u8, len: i64) -> i64 {
        if self.finished { return 0 - 1 as i64; }
        if len <= 0 as i64 { return 0 as i64; }
        let r1: i64 = cw_write_hex_len::<W>(&mut self.writer, len);
        if r1 < 0 as i64 { return r1; }
        let r2: i64 = cw_write_crlf::<W>(&mut self.writer);
        if r2 < 0 as i64 { return r2; }
        unsafe {
            let r3: i64 = self.writer.write(buf, len);
            if r3 < 0 as i64 { return r3; }
        }
        let r4: i64 = cw_write_crlf::<W>(&mut self.writer);
        if r4 < 0 as i64 { return r4; }
        return len;
    }

    fn flush(self: &mut ChunkedWriter<W>) -> i64 {
        unsafe { return self.writer.flush(); }
    }
}
