// Logos standard library — std.io_uring
//
// Thin wrapper over liburing (via thread_uring.c C shims).
//
// Design: "submit-and-wait" mode — every op submits one SQE and blocks
// until the kernel posts the corresponding CQE.  This gives correct,
// synchronous-looking semantics without a separate event loop.  The fiber
// scheduler layer (fiber/thread.logos) builds the async reactor on top of
// the same ring using the raw prep/peek/seen helpers.
//
// Usage:
//   let mut ring: IoRing = IoRing::new(32)?;
//   let fd: i32 = ring.openat(AT_FDCWD(), path, O_RDONLY(), 0)?;
//   let n:  i64 = ring.read(fd, buf, len, 0)?;
//   ring.close(fd)?;
//   // ring is dropped implicitly when it goes out of scope.

package logos.std.io.linux.uring;

use logos.lang.mem;
use logos.lang.result;
use logos.lang.drop;

// ── C shims ───────────────────────────────────────────────────────────────

extern fn logos_io_uring_sizeof()                                       -> i32;
extern fn logos_io_uring_init(entries: i32, ring: *mut u8)             -> i32;
extern fn logos_io_uring_exit(ring: *mut u8);
extern fn logos_io_uring_get_sqe(ring: *mut u8)                        -> *mut u8;
extern fn logos_io_uring_prep_read(sqe: *mut u8, fd: i32, buf: *mut u8,
                                    nbytes: i32, offset: i64);
extern fn logos_io_uring_prep_write(sqe: *mut u8, fd: i32, buf: *const u8,
                                     nbytes: i32, offset: i64);
extern fn logos_io_uring_prep_openat(sqe: *mut u8, dirfd: i32,
                                      path: *const u8, flags: i32, mode: i32);
extern fn logos_io_uring_prep_close(sqe: *mut u8, fd: i32);
extern fn logos_io_uring_submit_and_wait(ring: *mut u8, wait_nr: i32)  -> i32;
extern fn logos_io_uring_wait_cqe2(ring: *mut u8, cqe_out: *mut *mut u8) -> i32;
extern fn logos_io_uring_cqe_result(cqe: *mut u8)                      -> i32;
extern fn logos_io_uring_cqe_advance(ring: *mut u8, cqe: *mut u8);

// ── IoUringError ──────────────────────────────────────────────────────────

/// Represents an `IoRing` failure; one variant per logical failure class.
pub enum IoUringError {
    /// Failure from `queue_init` or a completion-queue entry; payload is the negative errno.
    Errno(i32),    // queue_init failure or CQE reported failure; payload = -errno
    /// Submission queue full (`get_sqe` returned null).
    RingFull,      // submission queue is full (get_sqe returned null)
}

/// Collapses an `IoUringError` to a negative-errno `i32`; `RingFull` maps to `-EAGAIN` (-11).
// Free function because enum method dispatch is not yet supported.
pub fn io_err_errno(e: IoUringError) -> i32 {
    match e {
        IoUringError::Errno(r)  => { return r; }
        IoUringError::RingFull => { return 0 - 11; }
    }
}

// ── IoRing ────────────────────────────────────────────────────────────────

/// Wraps liburing's `struct io_uring` in submit-and-wait mode: each op submits one SQE and
/// blocks until the kernel posts its CQE.
/// The ring bytes are heap-allocated and non-null once constructed; `Drop` releases them.
pub struct IoRing {
    ring: *mut u8,
}

impl IoRing {
    /// Creates an `IoRing` with `entries` SQ/CQ slots.
    /// On kernel init failure returns `Errno` carrying the negative errno.
    pub static fn new(entries: i32) -> Result<IoRing, IoUringError> {
        unsafe {
            let sz:   i32     = logos_io_uring_sizeof();
            let ring: *mut u8 = alloc(sz as i64);
            zero_bytes(ring, sz as i64);
            let rc: i32 = logos_io_uring_init(entries, ring);
            if rc < 0 {
                dealloc(ring);
                return Result::Err(IoUringError::Errno(rc));
            }
            return Result::Ok(IoRing { ring: ring });
        }
    }

    // Submit the next SQE and block until its CQE arrives.
    fn submit_and_collect(self: &mut IoRing) -> i32 {
        unsafe {
            let _submitted: i32 = logos_io_uring_submit_and_wait(self.ring, 1);
            let mut cqe_slot: *mut u8 = 0 as *mut u8;
            let cqe_ptr: *mut *mut u8 = &mut cqe_slot;
            let rc: i32 = logos_io_uring_wait_cqe2(self.ring, cqe_ptr);
            if rc < 0 { return rc; }
            let res: i32 = logos_io_uring_cqe_result(cqe_slot);
            logos_io_uring_cqe_advance(self.ring, cqe_slot);
            return res;
        }
    }

    // Shared "validate sqe + submit_and_collect + classify" flow.
    fn finish(self: &mut IoRing, sqe: *mut u8) -> Result<i64, IoUringError> {
        if sqe == 0 as *mut u8 { return Result::Err(IoUringError::RingFull); }
        let res: i32 = self.submit_and_collect();
        if res < 0 { return Result::Err(IoUringError::Errno(res)); }
        return Result::Ok(res as i64);
    }

    /// Reads up to `len` bytes from `fd` into `buf` at file offset `offset`; returns bytes read.
    /// Pass `offset = -1` to use the file's current position.
    pub fn read(self: &mut IoRing, fd: i32, buf: *mut u8, len: i64, offset: i64)
        -> Result<i64, IoUringError>
    {
        unsafe {
            let sqe: *mut u8 = logos_io_uring_get_sqe(self.ring);
            if sqe != 0 as *mut u8 {
                logos_io_uring_prep_read(sqe, fd, buf, len as i32, offset);
            }
            return self.finish(sqe);
        }
    }

    /// Writes up to `len` bytes from `buf` to `fd` at file offset `offset`.
    /// Returns the number of bytes written.
    pub fn write(self: &mut IoRing, fd: i32, buf: *const u8, len: i64, offset: i64)
        -> Result<i64, IoUringError>
    {
        unsafe {
            let sqe: *mut u8 = logos_io_uring_get_sqe(self.ring);
            if sqe != 0 as *mut u8 {
                logos_io_uring_prep_write(sqe, fd, buf, len as i32, offset);
            }
            return self.finish(sqe);
        }
    }

    /// Opens `path` relative to `dirfd` and returns the new fd; `AT_FDCWD()` (-100) resolves
    /// relative to the cwd.
    /// Common `flags` (fcntl.h, Linux x86-64): `O_RDONLY`=0, `O_WRONLY`=1, `O_RDWR`=2,
    /// `O_CREAT`=64, `O_TRUNC`=512, `O_APPEND`=1024.
    pub fn openat(self: &mut IoRing, dirfd: i32, path: *const u8, flags: i32, mode: i32)
        -> Result<i32, IoUringError>
    {
        unsafe {
            let sqe: *mut u8 = logos_io_uring_get_sqe(self.ring);
            if sqe != 0 as *mut u8 {
                logos_io_uring_prep_openat(sqe, dirfd, path, flags, mode);
            }
            match self.finish(sqe) {
                Result::Ok(v)  => { return Result::Ok(v as i32); }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
    }

    /// Closes file descriptor `fd`.
    pub fn close(self: &mut IoRing, fd: i32) -> Result<(), IoUringError> {
        unsafe {
            let sqe: *mut u8 = logos_io_uring_get_sqe(self.ring);
            if sqe != 0 as *mut u8 {
                logos_io_uring_prep_close(sqe, fd);
            }
            match self.finish(sqe) {
                Result::Ok(_)  => { return Result::Ok(()); }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
    }
}

// Destructor: tear down the ring and release the backing allocation.
impl Drop for IoRing {
    fn drop(self: IoRing) {
        unsafe {
            if self.ring == 0 as *mut u8 { return; }
            logos_io_uring_exit(self.ring);
            dealloc(self.ring);
        }
    }
}

// ── Convenience constants (O_* flags, Linux x86-64) ──────────────────────
// Note: `pub const` is not yet supported; expose as zero-overhead fns.

/// Returns the `O_RDONLY` flag (0): open read-only.
pub fn O_RDONLY()   -> i32 { return 0; }
/// Returns the `O_WRONLY` flag (1): open write-only.
pub fn O_WRONLY()   -> i32 { return 1; }
/// Returns the `O_RDWR` flag (2): open read-write.
pub fn O_RDWR()     -> i32 { return 2; }
/// Returns the `O_CREAT` flag (64): create the file if it does not exist.
pub fn O_CREAT()    -> i32 { return 64; }
/// Returns the `O_TRUNC` flag (512): truncate to length 0 on open.
pub fn O_TRUNC()    -> i32 { return 512; }
/// Returns the `O_APPEND` flag (1024): append on every write.
pub fn O_APPEND()   -> i32 { return 1024; }
/// Returns the `O_NONBLOCK` flag (2048): open in non-blocking mode.
pub fn O_NONBLOCK() -> i32 { return 2048; }
/// Returns `AT_FDCWD` (-100): resolve `openat` paths relative to the current directory.
pub fn AT_FDCWD()   -> i32 { return 0 - 100; }
