// Logos standard library — std.fs
//
// High-level file I/O built on std.io_uring.
// Errors returned as Result<T, i32> where i32 is -errno.

package logos.std.io.fs;

use logos.std.io.linux.uring;
use logos.lang.mem;
use logos.mem.string;
use logos.lang.str;
use logos.lang.result;

// ── File ──────────────────────────────────────────────────────────────────

/// Open file handle paired with its own `IoRing`; all I/O is issued through io_uring.
pub struct File {
    fd:   i32,
    ring: IoRing,
}

impl File {
    /// Returns `true` if the handle holds a valid file descriptor (not yet closed).
    pub fn is_open(self: &File) -> bool {
        return self.fd >= 0;
    }

    /// Reads up to `len` bytes at absolute `offset` into `buf`.
    /// Returns bytes read (0 = EOF) or a negative errno on failure.
    pub fn read_at(self: &mut File, buf: *mut u8, len: i64, offset: i64) -> i32 {
        match (&mut self.ring).read(self.fd, buf, len, offset) {
            Result::Ok(n)  => { return n as i32; }
            Result::Err(e) => { return io_err_errno(e); }
        }
    }

    /// Writes `len` bytes from `buf` at absolute `offset`.
    /// Returns bytes written (may be short) or a negative errno on failure.
    pub fn write_at(self: &mut File, buf: *const u8, len: i64, offset: i64) -> i32 {
        match (&mut self.ring).write(self.fd, buf, len, offset) {
            Result::Ok(n)  => { return n as i32; }
            Result::Err(e) => { return io_err_errno(e); }
        }
    }

    /// Closes the file descriptor and marks the handle closed; idempotent.
    /// Returns 0 on success (or if already closed), a negative errno on failure.
    pub fn close(self: &mut File) -> i32 {
        if self.fd < 0 { return 0; }
        let rc: i32 = match (&mut self.ring).close(self.fd) {
            Result::Ok(())  => { 0 }
            Result::Err(e)  => { io_err_errno(e) }
        };
        self.fd = 0 - 1;
        return rc;
    }
}

// ── Open helpers ─────────────────────────────────────────────────────────

fn ring_open(path: *const u8, flags: i32, mode: i32) -> Result<File, i32> {
    let mut ring: IoRing = match IoRing::new(8) {
        Result::Ok(r)  => { r }
        Result::Err(e) => { return Result::Err(io_err_errno(e)); }
    };
    match (&mut ring).openat(AT_FDCWD(), path, flags, mode) {
        Result::Ok(fd) => { return Result::Ok(File { fd: fd, ring: ring }); }
        Result::Err(e) => { return Result::Err(io_err_errno(e)); }
    }
}

/// Opens NUL-terminated `path` read-only (`O_RDONLY`); `Err` carries a negative errno.
pub fn open(path: *const u8) -> Result<File, i32> {
    return ring_open(path, 0, 0);
}

/// Creates or truncates NUL-terminated `path` (`O_RDWR|O_CREAT|O_TRUNC`, mode 0666).
pub fn create(path: *const u8) -> Result<File, i32> {
    return ring_open(path, 578, 438);   // O_RDWR|O_CREAT|O_TRUNC, 0666
}

/// Opens NUL-terminated `path` for append (`O_WRONLY|O_CREAT|O_APPEND`, mode 0666).
pub fn open_append(path: *const u8) -> Result<File, i32> {
    return ring_open(path, 1089, 438);  // O_WRONLY|O_CREAT|O_APPEND, 0666
}

// ── Convenience: read entire file into a String ───────────────────────────

/// Reads the entire file at NUL-terminated `path` into a `String` (4 KiB chunks until EOF).
/// No UTF-8 validation; bytes are appended verbatim. `Err` carries a negative errno.
pub fn read_to_string(path: *const u8) -> Result<String, i32> {
    let mut f: File = match ring_open(path, 0, 0) {
        Result::Ok(f)  => { f }
        Result::Err(e) => { return Result::Err(e); }
    };

    let chunk: i64 = 4096 as i64;
    let buf: *mut u8 = unsafe { alloc(chunk) };
    let mut out: String = String::new();
    let mut offset: i64 = 0 as i64;
    let mut err: i32 = 0;
    let mut going: bool = true;

    while going {
        let n: i32 = match (&mut f.ring).read(f.fd, buf, chunk, offset) {
            Result::Ok(r)  => { r as i32 }
            Result::Err(e) => { io_err_errno(e) }
        };
        if n < 0 {
            err = n;
            going = false;
        } else if n == 0 {
            going = false;
        } else {
            unsafe { out.push_bytes(buf, n as i64); }
            offset = offset + n as i64;
        }
    }

    unsafe { dealloc(buf); }
    f.close();
    if err < 0 { return Result::Err(err); }
    return Result::Ok(out);
}

/// Reads the entire file into a `String`; safe `str` overload that null-terminates `path`.
pub fn read_to_string(path: str) -> Result<String, i32> {
    let mut c: String = String::new();
    c.push_str(path); c.push_u8(0 as u8);
    return read_to_string(c.as_ptr());
}

// ── Convenience: write String to file (overwrite) ────────────────────────

/// Creates or truncates the file at NUL-terminated `path`, then writes `s` with one `write`.
/// Returns bytes written; a short write is possible. `Err` carries a negative errno.
pub fn write_string(path: *const u8, s: &String) -> Result<i32, i32> {
    let mut f: File = match ring_open(path, 578, 438) {
        Result::Ok(f)  => { f }
        Result::Err(e) => { return Result::Err(e); }
    };
    let nw: i32 = match (&mut f.ring).write(f.fd, s.as_ptr(), s.len(), 0 as i64) {
        Result::Ok(r)  => { r as i32 }
        Result::Err(e) => { io_err_errno(e) }
    };
    f.close();
    if nw < 0 { return Result::Err(nw); }
    return Result::Ok(nw);
}

/// Overwrites the file with `s`; safe `str` overload that null-terminates `path`.
pub fn write_string(path: str, s: &String) -> Result<i32, i32> {
    let mut c: String = String::new();
    c.push_str(path); c.push_u8(0 as u8);
    return write_string(c.as_ptr(), s);
}
