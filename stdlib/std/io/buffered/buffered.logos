// SPDX-License-Identifier: Apache-2.0
// Logos standard library -- std.bufio
//
// Buffered I/O over raw fds.  Reduces syscall count for small reads/writes.
//
// BufWriter: accumulates writes in a heap buffer; flushes on demand, on
// close, or when the buffer fills.
// BufReader: reads chunks from fd; hands out bytes/lines from the buffer.
//
// Both take a raw fd; they do not own it (caller closes it).

package std.io.buffered;

use std.mem;
use std.lang.text;

extern fn read(fd: i32, buf: *mut u8, n: i64) -> i64;
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;

// ---- BufWriter -------------------------------------------------------------

pub struct BufWriter {
    fd:  i32,
    buf: *mut u8,
    pos: i64,
    cap: i64,
}

pub fn buf_writer_new(fd: i32, cap: i64) -> BufWriter {
    let buf: *mut u8 = alloc(cap);
    return BufWriter { fd: fd, buf: buf, pos: 0 as i64, cap: cap };
}

// 8 KiB default — matches the typical page/disk sector balance.
pub fn buf_writer_default(fd: i32) -> BufWriter {
    return buf_writer_new(fd, 8192 as i64);
}

impl BufWriter {
    pub fn fd(self: &BufWriter) -> i32 { return self.fd; }

    // Flush any buffered bytes to the underlying fd.
    // Returns bytes flushed (== pos on success), or <0 on error.
    pub fn flush(self: &mut BufWriter) -> i64 {
        unsafe {
            if self.pos == 0 as i64 { return 0 as i64; }
            let n: i64 = write(self.fd, self.buf, self.pos);
            if n < 0 as i64 { return n; }
            self.pos = 0 as i64;
            return n;
        }
    }

    // Write `len` bytes.  Flushes first if the chunk won't fit; for chunks
    // larger than cap, writes directly (bypassing the buffer).
    pub fn write_bytes(self: &mut BufWriter, src: *const u8, len: i64) -> i64 {
        unsafe {
            if len <= 0 as i64 { return 0 as i64; }
            // Large writes: flush and write through.
            if len >= self.cap {
                let fr: i64 = self.flush();
                if fr < 0 as i64 { return fr; }
                return write(self.fd, src, len);
            }
            // Won't fit in remaining space: flush first.
            if self.pos + len > self.cap {
                let fr: i64 = self.flush();
                if fr < 0 as i64 { return fr; }
            }
            // Copy into buffer.
            let dst: *mut u8 = (self.buf as i64 + self.pos) as *mut u8;
            mem_copy(dst, 0 as i64, src, len);
            self.pos = self.pos + len;
            return len;
        }
    }

    pub fn write_str(self: &mut BufWriter, s: str) -> i64 {
        unsafe { return self.write_bytes(s.as_ptr(), s.len()); }
    }

    pub fn write_byte(self: &mut BufWriter, b: u8) -> i64 {
        unsafe {
            if self.pos >= self.cap {
                let fr: i64 = self.flush();
                if fr < 0 as i64 { return fr; }
            }
            let dst: *mut u8 = (self.buf as i64 + self.pos) as *mut u8;
            dst[0 as i64] = b;
            self.pos = self.pos + 1 as i64;
            return 1 as i64;
        }
    }

    // Flush then free the buffer.  fd is NOT closed — caller owns it.
    pub fn close(self: &mut BufWriter) -> i64 {
        let r: i64 = self.flush();
        unsafe {
            if self.buf as i64 != 0 as i64 {
                dealloc(self.buf);
                self.buf = 0 as *mut u8;
            }
        }
        return r;
    }
}

// ---- BufReader -------------------------------------------------------------

pub struct BufReader {
    fd:    i32,
    buf:   *mut u8,
    start: i64,  // next unread byte
    end:   i64,  // one past last valid byte
    cap:   i64,
}

pub fn buf_reader_new(fd: i32, cap: i64) -> BufReader {
    let buf: *mut u8 = alloc(cap);
    return BufReader { fd: fd, buf: buf, start: 0 as i64, end: 0 as i64, cap: cap };
}

pub fn buf_reader_default(fd: i32) -> BufReader {
    return buf_reader_new(fd, 8192 as i64);
}

impl BufReader {
    pub fn fd(self: &BufReader) -> i32 { return self.fd; }

    // Internal: refill the buffer from fd.  Returns bytes read (0 on EOF, <0 on error).
    fn refill(self: &mut BufReader) -> i64 {
        unsafe {
            self.start = 0 as i64;
            self.end   = 0 as i64;
            let n: i64 = read(self.fd, self.buf, self.cap);
            if n > 0 as i64 { self.end = n; }
            return n;
        }
    }

    // Read one byte.  Returns byte value as i32 in [0,255], or -1 on EOF/error.
    pub fn read_byte(self: &mut BufReader) -> i32 {
        unsafe {
            if self.start >= self.end {
                let n: i64 = self.refill();
                if n <= 0 as i64 { return 0 - 1; }
            }
            let ptr: *const u8 = (self.buf as i64 + self.start) as *const u8;
            let b: u8 = ptr[0 as i64];
            self.start = self.start + 1 as i64;
            return b as i32;
        }
    }

    // Fill `dst[0..len]` with bytes; returns bytes read, 0 on EOF, <0 on error.
    pub fn read_bytes(self: &mut BufReader, dst: *mut u8, len: i64) -> i64 {
        unsafe {
            let mut have: i64 = self.end - self.start;
            if have == 0 as i64 {
                // Large requests bypass the buffer.
                if len >= self.cap {
                    return read(self.fd, dst, len);
                }
                let n: i64 = self.refill();
                if n <= 0 as i64 { return n; }
                have = self.end - self.start;
            }
            let mut take: i64 = have;
            if len < have { take = len; }
            let src: *const u8 = (self.buf as i64 + self.start) as *const u8;
            mem_copy(dst, 0 as i64, src, take);
            self.start = self.start + take;
            return take;
        }
    }

    // Read until '\n' (inclusive).  Appends bytes to `out`.
    // Returns bytes appended (0 on EOF at start, <0 on error).
    pub fn read_line(self: &mut BufReader, out: &mut String) -> i64 {
        unsafe {
            let mut total: i64 = 0 as i64;
            let mut done: bool = false;
            while !done {
                if self.start >= self.end {
                    let n: i64 = self.refill();
                    if n < 0 as i64 { return n; }
                    if n == 0 as i64 { done = true; }
                }
                if !done {
                    // Scan for '\n' in the available slice.
                    let mut i: i64 = self.start;
                    let mut found: i64 = 0 - 1 as i64;
                    while i < self.end && found < 0 as i64 {
                        let ptr: *const u8 = (self.buf as i64 + i) as *const u8;
                        if (ptr[0 as i64] as i32) == 10 { found = i; }
                        i = i + 1 as i64;
                    }
                    let mut upto: i64 = self.end;
                    if found >= 0 as i64 { upto = found + 1 as i64; }
                    let chunk_ptr: *const u8 = (self.buf as i64 + self.start) as *const u8;
                    let chunk_len: i64 = upto - self.start;
                    out.push_bytes(chunk_ptr, chunk_len);
                    total = total + chunk_len;
                    self.start = upto;
                    if found >= 0 as i64 { done = true; }
                }
            }
            return total;
        }
    }

    pub fn close(self: &mut BufReader) {
        unsafe {
            if self.buf as i64 != 0 as i64 {
                dealloc(self.buf);
                self.buf = 0 as *mut u8;
            }
        }
    }
}
