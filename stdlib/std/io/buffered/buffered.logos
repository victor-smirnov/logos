// Logos standard library -- std.io.buffered
//
// Buffered I/O generic over Read/Write traits.  Reduces syscall count for
// small reads/writes; adapts any Read/Write impl (TcpStream, Pipe, a
// ChunkedReader, a Bytes cursor, ...).
//
// For raw fds, use FdReader/FdWriter adapters or the convenience
// constructors buf_reader_new(fd, cap) / buf_writer_new(fd, cap) that wrap
// a fd in an FdReader/FdWriter for you.

package std.io.buffered;

use logos.mem.mem;
use std.lang.text;
use std.io.read;
use std.io.write;

extern fn read(fd: i32, buf: *mut u8, n: i64) -> i64;
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;

// ---- Fd adapters -----------------------------------------------------------

pub struct FdReader { pub fd: i32 }
pub struct FdWriter { pub fd: i32 }

pub fn fd_reader(fd: i32) -> FdReader { return FdReader { fd: fd }; }
pub fn fd_writer(fd: i32) -> FdWriter { return FdWriter { fd: fd }; }

impl Read for FdReader {
    fn read(self: &mut FdReader, buf: *mut u8, len: i64) -> i64 {
        unsafe { return read(self.fd, buf, len); }
    }
}

impl Write for FdWriter {
    fn write(self: &mut FdWriter, buf: *const u8, len: i64) -> i64 {
        unsafe { return write(self.fd, buf, len); }
    }
    fn flush(self: &mut FdWriter) -> i64 { return 0; }
}

// ---- BufWriter -------------------------------------------------------------

pub struct BufWriter<W> {
    writer: W,
    buf:    *mut u8,
    pos:    i64,
    cap:    i64,
}

// Wrap any Write sink.
pub fn buf_writer_wrap<W: Write>(w: W, cap: i64) -> BufWriter<W> {
    let buf: *mut u8 = alloc(cap);
    return BufWriter { writer: w, buf: buf, pos: 0 as i64, cap: cap };
}

// Convenience: buffer over a raw fd.
pub fn buf_writer_new(fd: i32, cap: i64) -> BufWriter<FdWriter> {
    return buf_writer_wrap::<FdWriter>(fd_writer(fd), cap);
}

// 8 KiB default — matches the typical page/disk sector balance.
pub fn buf_writer_default(fd: i32) -> BufWriter<FdWriter> {
    return buf_writer_new(fd, 8192 as i64);
}

// Flush (free function) — avoids clashing with the trait-method name
// `flush` when BufWriter<W> also impls Write below.  Returns bytes
// flushed (== pos on success), <0 on error.
fn buf_writer_flush_inner<W: Write>(w: &mut BufWriter<W>) -> i64 {
    unsafe {
        if w.pos == 0 as i64 { return 0 as i64; }
        let n: i64 = w.writer.write(w.buf, w.pos);
        if n < 0 as i64 { return n; }
        w.pos = 0 as i64;
        return n;
    }
}

impl<W: Write> BufWriter<W> {
    // Write `len` bytes.  Flushes first if the chunk won't fit; for chunks
    // larger than cap, writes directly (bypassing the buffer).
    pub fn write_bytes(self: &mut BufWriter<W>, src: *const u8, len: i64) -> i64 {
        unsafe {
            if len <= 0 as i64 { return 0 as i64; }
            if len >= self.cap {
                let fr: i64 = buf_writer_flush_inner::<W>(self);
                if fr < 0 as i64 { return fr; }
                return self.writer.write(src, len);
            }
            if self.pos + len > self.cap {
                let fr: i64 = buf_writer_flush_inner::<W>(self);
                if fr < 0 as i64 { return fr; }
            }
            let dst: *mut u8 = (self.buf as i64 + self.pos) as *mut u8;
            mem_copy(dst, 0 as i64, src, len);
            self.pos = self.pos + len;
            return len;
        }
    }

    pub fn write_str(self: &mut BufWriter<W>, s: str) -> i64 {
        unsafe { return self.write_bytes(s.as_ptr(), s.len()); }
    }

    pub fn write_byte(self: &mut BufWriter<W>, b: u8) -> i64 {
        unsafe {
            if self.pos >= self.cap {
                let fr: i64 = buf_writer_flush_inner::<W>(self);
                if fr < 0 as i64 { return fr; }
            }
            let dst: *mut u8 = (self.buf as i64 + self.pos) as *mut u8;
            dst[0 as i64] = b;
            self.pos = self.pos + 1 as i64;
            return 1 as i64;
        }
    }

    // Flush then free the buffer.  The wrapped writer is NOT closed —
    // caller owns it.
    pub fn close(self: &mut BufWriter<W>) -> i64 {
        let r: i64 = buf_writer_flush_inner::<W>(self);
        unsafe {
            if self.buf as i64 != 0 as i64 {
                dealloc(self.buf);
                self.buf = 0 as *mut u8;
            }
        }
        return r;
    }
}

// ---- BufReader -------------------------------------------------------------

pub struct BufReader<R> {
    reader: R,
    buf:    *mut u8,
    start:  i64,  // next unread byte
    end:    i64,  // one past last valid byte
    cap:    i64,
}

pub fn buf_reader_wrap<R: Read>(r: R, cap: i64) -> BufReader<R> {
    let buf: *mut u8 = alloc(cap);
    return BufReader { reader: r, buf: buf, start: 0 as i64, end: 0 as i64, cap: cap };
}

pub fn buf_reader_new(fd: i32, cap: i64) -> BufReader<FdReader> {
    return buf_reader_wrap::<FdReader>(fd_reader(fd), cap);
}

pub fn buf_reader_default(fd: i32) -> BufReader<FdReader> {
    return buf_reader_new(fd, 8192 as i64);
}

impl<R: Read> BufReader<R> {
    // Internal: refill the buffer from the underlying reader.
    // Returns bytes read (0 on EOF, <0 on error).
    fn refill(self: &mut BufReader<R>) -> i64 {
        unsafe {
            self.start = 0 as i64;
            self.end   = 0 as i64;
            let n: i64 = self.reader.read(self.buf, self.cap);
            if n > 0 as i64 { self.end = n; }
            return n;
        }
    }

    // Read one byte.  Returns byte value as i32 in [0,255], or -1 on EOF/error.
    pub fn read_byte(self: &mut BufReader<R>) -> i32 {
        unsafe {
            if self.start >= self.end {
                let n: i64 = self.refill();
                if n <= 0 as i64 { return 0 - 1; }
            }
            let ptr: *const u8 = (self.buf as i64 + self.start) as *const u8;
            let b: u8 = ptr[0 as i64];
            self.start = self.start + 1 as i64;
            return b as i32;
        }
    }

    // Fill `dst[0..len]` with bytes; returns bytes read, 0 on EOF, <0 on error.
    pub fn read_bytes(self: &mut BufReader<R>, dst: *mut u8, len: i64) -> i64 {
        unsafe {
            let mut have: i64 = self.end - self.start;
            if have == 0 as i64 {
                // Large requests bypass the buffer.
                if len >= self.cap {
                    return self.reader.read(dst, len);
                }
                let n: i64 = self.refill();
                if n <= 0 as i64 { return n; }
                have = self.end - self.start;
            }
            let mut take: i64 = have;
            if len < have { take = len; }
            let src: *const u8 = (self.buf as i64 + self.start) as *const u8;
            mem_copy(dst, 0 as i64, src, take);
            self.start = self.start + take;
            return take;
        }
    }

    // Read until '\n' (inclusive).  Appends bytes to `out`.
    // Returns bytes appended (0 on EOF at start, <0 on error).
    pub fn read_line(self: &mut BufReader<R>, out: &mut String) -> i64 {
        unsafe {
            let mut total: i64 = 0 as i64;
            let mut done: bool = false;
            while !done {
                if self.start >= self.end {
                    let n: i64 = self.refill();
                    if n < 0 as i64 { return n; }
                    if n == 0 as i64 { done = true; }
                }
                if !done {
                    let mut i: i64 = self.start;
                    let mut found: i64 = 0 - 1 as i64;
                    while i < self.end && found < 0 as i64 {
                        let ptr: *const u8 = (self.buf as i64 + i) as *const u8;
                        if (ptr[0 as i64] as i32) == 10 { found = i; }
                        i = i + 1 as i64;
                    }
                    let mut upto: i64 = self.end;
                    if found >= 0 as i64 { upto = found + 1 as i64; }
                    let chunk_ptr: *const u8 = (self.buf as i64 + self.start) as *const u8;
                    let chunk_len: i64 = upto - self.start;
                    out.push_bytes(chunk_ptr, chunk_len);
                    total = total + chunk_len;
                    self.start = upto;
                    if found >= 0 as i64 { done = true; }
                }
            }
            return total;
        }
    }

    pub fn close(self: &mut BufReader<R>) {
        unsafe {
            if self.buf as i64 != 0 as i64 {
                dealloc(self.buf);
                self.buf = 0 as *mut u8;
            }
        }
    }
}

// Borrow the inner reader/writer.  Useful when the caller needs to feed
// bytes back to the underlying sink (e.g. HTTP server reads requests via
// BufReader<TcpStream> and writes responses directly to the same stream).
pub fn buf_reader_inner_mut<R>(br: &mut BufReader<R>) -> &mut R {
    return &mut br.reader;
}

pub fn buf_writer_inner_mut<W>(bw: &mut BufWriter<W>) -> &mut W {
    return &mut bw.writer;
}

// BufReader<R> itself implements Read — useful for chaining
// (e.g. ChunkedReader<BufReader<TcpStream>>).
impl<R: Read> Read for BufReader<R> {
    fn read(self: &mut BufReader<R>, buf: *mut u8, len: i64) -> i64 {
        return self.read_bytes(buf, len);
    }
}

// BufWriter<W> itself implements Write — enables wrapping (e.g.
// ChunkedWriter<BufWriter<FdWriter>>).  Delegates to write_bytes and
// inlines the flush logic to avoid ambiguity with the inherent flush()
// (same name).
impl<W: Write> Write for BufWriter<W> {
    fn write(self: &mut BufWriter<W>, buf: *const u8, len: i64) -> i64 {
        return self.write_bytes(buf, len);
    }
    fn flush(self: &mut BufWriter<W>) -> i64 {
        return buf_writer_flush_inner::<W>(self);
    }
}
