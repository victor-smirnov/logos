// Logos Hermes stdlib — hermes.objectmap
//
// Phase 12: ObjectMap — open-addressing string-keyed hash map over a Hermes zone.
//
// MapEntry (8 bytes): key_off (u32, 0 = empty) + val (u32 = AnyVal.raw).
//   key_off stores the zone-relative offset to the HermesString key.
//   val stores the AnyVal payload (raw field).
//
// ObjectMap (16 bytes):
//   entries_off (u32) — zone-relative offset to MapEntry array
//   capacity    (u32) — number of slots (must be power of 2)
//   count       (u32) — occupied slots
//   reserved    (u32) — zero, reserved for future use
//
// All methods that access entries take an explicit base: *mut u8 (the zone base).
// This follows the same pattern as TinyObjectMap / ObjectArray in hermes.map.
//
// Empty-slot sentinel: key_off == 0 (zone offset 0 = DocumentHeader, never a string).
//
// Hash function: FNV-1a (hermes_fnv1a from hermes.string).
// Collision resolution: linear probing (slot wraps at capacity).

package std.hermes.objectmap;

use logos.lang.hermes.anyval;
use logos.lang.hermes.tags;
use std.hermes.array;
use std.hermes.map;
use logos.lang.hermes.typed_value;
use logos.lang.hermes.view;
use std.hermes.string;
use logos.lang.hermes.relptr;

// ---------------------------------------------------------------------------
// MapEntry — one slot in the hash table (8 bytes)
// ---------------------------------------------------------------------------

#[zoned] pub struct MapEntry {
    pub key_off: RelPtr<HermesString>,  // zone-relative byte offset to HermesString (0 = empty slot)
    pub val:     u32,                    // AnyVal.raw
}

// ---------------------------------------------------------------------------
// ObjectMap — the hash table header (16 bytes, all primitives)
// ---------------------------------------------------------------------------

// Concrete genos specialization carrying the Hermes wire-format type_code
// for the open-addressing hash map (was `ObjectMap`, type_code=101).
// The Map<K, V> trait itself lives in `hermes.map`.
#[type_code = HermesTag::ObjectMap]
pub trait Map<Varchar, AnyVal>;

// Full specialization (no partial over V — this layout is AnyVal-specific).
#[zoned] pub struct Map<Varchar, AnyVal> {
    pub entries_off: RelPtr<MapEntry>,  // zone-relative offset to the MapEntry array
    pub capacity:    u32,  // number of slots (power of 2)
    pub count:       u32,  // number of occupied slots
    pub reserved:    u32,  // zero
}

// Back-compat alias.
pub type ObjectMap = Map<Varchar, AnyVal>;

impl Map<Varchar, AnyVal> for Map<Varchar, AnyVal> {
    unsafe fn size(self: *const Map<Varchar, AnyVal>) -> u32 { return self.count; }
}

impl Map<Varchar, AnyVal> {
    // Initialize an ObjectMap at pre-allocated memory.
    //   raw          — pointer to ≥ 16 bytes (zone-allocated ObjectMap header)
    //   base         — zone base pointer
    //   entries_buf  — pointer to ≥ capacity * 8 bytes (for the entry array)
    //   capacity     — number of hash slots (must be a power of 2)
    // Returns *mut Map<Varchar, AnyVal> = raw (typed).
    pub unsafe fn init(raw: *mut u8, base: *mut u8,
                       entries_buf: *mut u8, capacity: u32) -> *mut Map<Varchar, AnyVal> {
        let off: u32 = (entries_buf as *const u8).byte_offset_from(base as *const u8) as u32;
        let m: *mut Map<Varchar, AnyVal> = raw as *mut Map<Varchar, AnyVal>;
        m.entries_off.offset = off;
        m.capacity    = capacity;
        m.count       = 0;
        m.reserved    = 0;
        // Zero-initialize all entry slots (key_off = 0 → empty).
        let total: i64 = capacity as i64 * 8;
        let mut i: i64 = 0;
        while i < total {
            let p: *mut u8 = entries_buf.byte_add(i);
            *p = 0;
            i = i + 1;
        }
        return m;
    }

    // Insert or update a key→value mapping.
    //   base    — zone base pointer
    //   key_off — zone-relative offset to the HermesString key object
    //   key_ptr — pointer to the raw UTF-8 bytes of the key (for comparison)
    //   key_len — byte length of the key
    //   val     — the AnyVal to store
    // If the table is full and the key is new, the insert is silently dropped.
    pub unsafe fn set(self: *mut Map<Varchar, AnyVal>, base: *mut u8, key_off: u32,
                      key_ptr: *const u8, key_len: u64, val: AnyVal) {
        let cap: u64   = self.capacity as u64;
        let h: u64     = hermes_fnv1a(key_ptr, key_len);
        let ent_base: *mut MapEntry =
            base.byte_add(self.entries_off.offset) as *mut MapEntry;
        let mut slot: u64 = h & (cap - 1);
        let mut done: bool = false;
        let mut probed: u64 = 0;
        while done == false && probed < cap {
            let ep: *mut MapEntry = ent_base.add(slot as i64);
            if ep.key_off.offset == 0 {
                // Empty slot — insert new entry.
                ep.key_off.offset = key_off;
                ep.val     = val.raw;
                self.count = self.count + 1;
                done = true;
            } else {
                let ks: *const HermesString =
                    base.byte_add(ep.key_off.offset) as *const HermesString;
                if ks.equals_bytes(key_ptr, key_len) {
                    // Key already present — update value.
                    ep.val = val.raw;
                    done = true;
                } else {
                    slot = slot + 1;
                    if slot >= cap {
                        slot = 0;
                    }
                    probed = probed + 1;
                }
            }
        }
        // If done == false here, the table is full and the key is new: silently drop.
    }

    // Look up a key. Returns AnyVal::null_ptr() if not found.
    pub unsafe fn get(self: *const Map<Varchar, AnyVal>, base: *const u8,
                      key_ptr: *const u8, key_len: u64) -> AnyVal {
        let cap: u64      = self.capacity as u64;
        let h: u64        = hermes_fnv1a(key_ptr, key_len);
        let ent_base: *const MapEntry =
            base.byte_add(self.entries_off.offset) as *const MapEntry;
        let mut slot: u64 = h & (cap - 1);
        let mut probed: u64 = 0;
        while probed < cap {
            let ep: *const MapEntry = ent_base.add(slot as i64);
            if ep.key_off.offset == 0 {
                return AnyVal::null_ptr();
            }
            let ks: *const HermesString =
                base.byte_add(ep.key_off.offset) as *const HermesString;
            if ks.equals_bytes(key_ptr, key_len) {
                return AnyVal { raw: ep.val };
            }
            slot = slot + 1;
            if slot >= cap {
                slot = 0;
            }
            probed = probed + 1;
        }
        return AnyVal::null_ptr();
    }

    // True if the map contains the given key.
    pub unsafe fn contains(self: *const Map<Varchar, AnyVal>, base: *const u8,
                           key_ptr: *const u8, key_len: u64) -> bool {
        let cap: u64      = self.capacity as u64;
        let h: u64        = hermes_fnv1a(key_ptr, key_len);
        let ent_base: *const MapEntry =
            base.byte_add(self.entries_off.offset) as *const MapEntry;
        let mut slot: u64 = h & (cap - 1);
        let mut probed: u64 = 0;
        while probed < cap {
            let ep: *const MapEntry = ent_base.add(slot as i64);
            if ep.key_off.offset == 0 {
                return false;
            }
            let ks: *const HermesString =
                base.byte_add(ep.key_off.offset) as *const HermesString;
            if ks.equals_bytes(key_ptr, key_len) {
                return true;
            }
            slot = slot + 1;
            if slot >= cap {
                slot = 0;
            }
            probed = probed + 1;
        }
        return false;
    }

}
