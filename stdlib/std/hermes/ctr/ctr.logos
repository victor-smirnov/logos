                bi = bi + 1;
            }
            let hdr_raw: *mut u8 = zone_m_alloc_tagged(&mut ctr.zone,
                                       sizeof::<Map<i64, AnyVal>>() as i64,
                                       hermes_tag_map_i64_anyval());
            if hdr_raw != 0 as *mut u8 {
                let m: *mut Map<i64, AnyVal> = hdr_raw as *mut Map<i64, AnyVal>;
                m.size     = len as u32;
                m.capacity = len as u32;
                m.keys.offset = keys_off;
                m.vals.offset = vals_off;
                let map_off: u32 = (hdr_raw as i64 - ctr.zone.holder.base as i64) as u32;
                let doc: *mut DocumentHeader = ctr.zone.holder.base as *mut DocumentHeader;
