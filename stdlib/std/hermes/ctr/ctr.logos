// ── C6: Logos-struct → Hermes Map<i32, AnyVal> builder ───────────────────────────

// Source type for `as <I32, AnyVal>{}` cast: parallel key and value slices.
// Len is derived from keys.len at the cast site; both slices must be the same length.
pub struct MapSliceI32 {
    pub keys: &[i32],
    pub vals: &[AnyVal],
}

pub struct MapSliceU32 {
    pub keys: &[u32],
    pub vals: &[AnyVal],
}

pub struct MapSliceI64 {
    pub keys: &[i64],
    pub vals: &[AnyVal],
}

pub struct MapSliceU64 {
    pub keys: &[u64],
    pub vals: &[AnyVal],
}

// Builds a Map<i32, AnyVal> Hermes from parallel key and value arrays (len entries).
// Layout: keys buffer (4 bytes/elem), vals buffer (4 bytes/elem), then tagged header.
// The document root is set to the resulting Map<i32, AnyVal> AnyVal.
pub unsafe fn hermes_build_map_i32_anyval(keys: *const i32, vals: *const AnyVal, len: i64) -> Hermes {
    if len <= 0 { return Hermes::builder(8); }
    // fix2: guard u32 overflow — Map<i32, AnyVal>.size/capacity are u32.
    if len > 4294967295 { return Hermes::builder(8); }
    let key_bytes: i64 = len * 4;
    let val_bytes: i64 = len * 4;
    let cap: i64 = 8 + key_bytes + val_bytes + sizeof::<Map<i32, AnyVal>>() as i64 + 64;
    let mut ctr: Hermes = Hermes::builder(cap);
    let keys_raw: *mut u8 = zone_m_alloc_raw(&mut ctr.zone, key_bytes);
    if keys_raw != 0 as *mut u8 {
        // fix1: compute keys_off immediately after allocation — keys_raw is valid relative to
        // current base now; a subsequent alloc (vals_raw) could trigger zone realloc, after
        // which keys_raw would point to old (freed) memory and keys_raw - new_base = garbage.
        let keys_off: u32 = (keys_raw as i64 - ctr.zone.holder.base as i64) as u32;
        // Bug fix: copy key bytes BEFORE allocating vals_raw.
        // The second alloc may trigger zone realloc, invalidating keys_raw.
        // Write through the offset-based pointer instead to be safe after any grow.
        let mut bk: i64 = 0;
        while bk < key_bytes {
            *((keys_raw as i64 + bk) as *mut u8) = *((keys as i64 + bk) as *const u8);
            bk = bk + 1;
        }
        let vals_raw: *mut u8 = zone_m_alloc_raw(&mut ctr.zone, val_bytes);
        if vals_raw != 0 as *mut u8 {
            let vals_off: u32 = (vals_raw as i64 - ctr.zone.holder.base as i64) as u32;
            let mut bi: i64 = 0;
            while bi < val_bytes {
                *((vals_raw as i64 + bi) as *mut u8) = *((vals as i64 + bi) as *const u8);
                bi = bi + 1;
            }
            let hdr_raw: *mut u8 = zone_m_alloc_tagged(&mut ctr.zone,
                                       sizeof::<Map<i32, AnyVal>>() as i64,
                                       hermes_tag_map_i32_anyval());
            if hdr_raw != 0 as *mut u8 {
                let m: *mut Map<i32, AnyVal> = hdr_raw as *mut Map<i32, AnyVal>;
                m.size     = len as u32;
                m.capacity = len as u32;
                m.keys.offset = keys_off;
                m.vals.offset = vals_off;
                let map_off: u32 = (hdr_raw as i64 - ctr.zone.holder.base as i64) as u32;
                let doc: *mut DocumentHeader = ctr.zone.holder.base as *mut DocumentHeader;
                document_set_root(doc, AnyVal::from_offset(map_off));
            }
        }
    }
    return ctr;
}

// Builds a Map<u32, AnyVal> Hermes from parallel key and value arrays.
pub unsafe fn hermes_build_map_u32_anyval(keys: *const u32, vals: *const AnyVal, len: i64) -> Hermes {
    if len <= 0 { return Hermes::builder(8); }
    if len > 4294967295 { return Hermes::builder(8); }
    let key_bytes: i64 = len * 4;
    let val_bytes: i64 = len * 4;
    let cap: i64 = 8 + key_bytes + val_bytes + sizeof::<Map<u32, AnyVal>>() as i64 + 64;
    let mut ctr: Hermes = Hermes::builder(cap);
    let keys_raw: *mut u8 = zone_m_alloc_raw(&mut ctr.zone, key_bytes);
    if keys_raw != 0 as *mut u8 {
        let keys_off: u32 = (keys_raw as i64 - ctr.zone.holder.base as i64) as u32;
        let mut bk: i64 = 0;
        while bk < key_bytes {
            *((keys_raw as i64 + bk) as *mut u8) = *((keys as i64 + bk) as *const u8);
            bk = bk + 1;
        }
        let vals_raw: *mut u8 = zone_m_alloc_raw(&mut ctr.zone, val_bytes);
        if vals_raw != 0 as *mut u8 {
            let vals_off: u32 = (vals_raw as i64 - ctr.zone.holder.base as i64) as u32;
            let mut bi: i64 = 0;
            while bi < val_bytes {
                *((vals_raw as i64 + bi) as *mut u8) = *((vals as i64 + bi) as *const u8);
                bi = bi + 1;
            }
            let hdr_raw: *mut u8 = zone_m_alloc_tagged(&mut ctr.zone,
                                       sizeof::<Map<u32, AnyVal>>() as i64,
                                       hermes_tag_map_u32_anyval());
            if hdr_raw != 0 as *mut u8 {
                let m: *mut Map<u32, AnyVal> = hdr_raw as *mut Map<u32, AnyVal>;
                m.size     = len as u32;
                m.capacity = len as u32;
                m.keys.offset = keys_off;
                m.vals.offset = vals_off;
                let map_off: u32 = (hdr_raw as i64 - ctr.zone.holder.base as i64) as u32;
                let doc: *mut DocumentHeader = ctr.zone.holder.base as *mut DocumentHeader;
                document_set_root(doc, AnyVal::from_offset(map_off));
            }
        }
    }
    return ctr;
}

