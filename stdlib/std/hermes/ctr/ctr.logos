                let m: *mut Map<u64, AnyVal> = hdr_raw as *mut Map<u64, AnyVal>;
                m.size     = len as u32;
                m.capacity = len as u32;
                m.keys.offset = keys_off;
                m.vals.offset = vals_off;
                let map_off: u32 = (hdr_raw as i64 - ctr.zone.holder.base as i64) as u32;
                let doc: *mut DocumentHeader = ctr.zone.holder.base as *mut DocumentHeader;
                document_set_root(doc, AnyVal::from_offset(map_off));
            }
        }
    }
    return ctr;
}

// Patches PARAM slots in a zone that was populated via hermes_template_ctr_new.
// resolved[i] = AnyVal.raw for capture value i; slots is the ParamSlot table
// (interleaved u32 pairs: blob_offset, value_idx).
// The template starts at zone.holder.base (offset 0 in the zone).
pub unsafe fn hermes_template_patch(
        ctr: *mut Hermes,
        slots: *const u32, n_slots: i64,
        resolved: *const u32, n_values: i64) {
    if n_slots <= 0 || slots == 0 as *const u32 { return; }
    if n_values > 0 && resolved == 0 as *const u32 { return; }
    let base: *mut u8 = ctr.zone.holder.base;
    let zone_used: i64 = ctr.zone.holder.used;
    let mut si: i64 = 0;
    while si < n_slots {
        let off: u32  = *((slots as i64 + si * 8) as *const u32);
        let vidx: u32 = *((slots as i64 + si * 8 + 4) as *const u32)
                        & 0xFFFFFF;
        if (vidx as i64) < n_values && (off as i64) + 4 <= zone_used {
            let av_raw: u32 = *((resolved as i64 + vidx as i64 * 4) as *const u32);
            let slot_ptr: *mut u32 = (base as i64 + off as i64) as *mut u32;
            *slot_ptr = av_raw;
        }
        si = si + 1;
    }
}

// ---------------------------------------------------------------------------
// List / map comprehension runtime helpers
// ---------------------------------------------------------------------------
//
// `@[expr for x in iter (if g)?]` desugars to:
//     { let mut c = hermes_list_comp_new(cap);
//       for x in iter { [if g] hermes_list_comp_push(&mut c, expr); }
//       c }
//
// The element expression must already produce `AnyVal` (wrap scalars with
// `AnyVal::embed_i24(...)` etc.).  Implicit coercion is a future extension.

pub fn hermes_list_comp_new(cap: i64) -> Hermes {
    let mut c: Hermes = Hermes::builder(cap);
    let arr: AnyVal = c.build_array(8);
    c.set_root(arr);
    return c;
}

pub fn hermes_list_comp_push(c: &mut Hermes, v: AnyVal) {
    let arr: AnyVal = c.root();
    c.array_push(arr, v);
}

// Map comprehension: @{kexpr: vexpr for x in iter (if guard)?}
// v1: string keys only; values must be AnyVal.

pub fn hermes_map_comp_new(cap: i64, slot_hint: i64) -> Hermes {
    let mut c: Hermes = Hermes::builder(cap);
    // Round slot_hint up to next power of two (min 8).  ObjectMap::set relies
    // on cap being a power of two for `slot & (cap-1)` masking.
    let mut slots: u32 = 8;
    let mut want: i64 = slot_hint * 2;
    if want < 8 { want = 8; }
    while (slots as i64) < want { slots = slots * 2; }
    let m: AnyVal = c.build_map(slots);
    c.set_root(m);
    return c;
}

pub fn hermes_map_comp_put(c: &mut Hermes, k: str, v: AnyVal) {
    let m: AnyVal = c.root();
    c.map_set(m, k, v);
}

// Scalar → AnyVal coercion helpers for comprehension values.
// Compiler auto-wraps the element expression in one of these based on its
// Logos type.  AnyVal values bypass coercion entirely.

pub fn hermes_coerce_i8(v: i8)   -> AnyVal { return AnyVal::embed_i8(v); }
pub fn hermes_coerce_i16(v: i16) -> AnyVal { return AnyVal::embed_i16(v); }
pub fn hermes_coerce_i32(v: i32) -> AnyVal { return AnyVal::embed_i24(v); }
pub fn hermes_coerce_i64(v: i64) -> AnyVal { return AnyVal::embed_i24(v as i32); }
pub fn hermes_coerce_u8(v: u8)   -> AnyVal { return AnyVal::embed_u8(v); }
pub fn hermes_coerce_u16(v: u16) -> AnyVal { return AnyVal::embed_u16(v); }
pub fn hermes_coerce_u32(v: u32) -> AnyVal { return AnyVal::embed_u24(v); }
pub fn hermes_coerce_u64(v: u64) -> AnyVal { return AnyVal::embed_u24(v as u32); }
pub fn hermes_coerce_bool(v: bool) -> AnyVal { return AnyVal::embed_bool(v); }
pub fn hermes_coerce_str(c: &mut Hermes, s: str) -> AnyVal {
    return c.build_str(s);
}
