// Logos Hermes stdlib — hermes.match
//
// Runtime helpers for @{...} and @[...] match patterns.  These navigate
// AnyVal scrutinees into ObjectMap / ObjectArray and return the AnyVal at
// the requested position (null AnyVal on miss / wrong type).

package std.hermes.pat;

use std.hermes.anyval;
use std.hermes.typetag;
use std.hermes.string;
use std.hermes.objectmap;
use std.hermes.array;
use std.hermes.map;
use std.hermes.typed_value;

// True iff scrutinee is a map (ObjectMap or TinyObjectMap).
pub unsafe fn hermes_pat_is_map(av: *const AnyVal, base: *const u8) -> bool {
    if av.is_null() { return false; }
    return av.is_map(base);
}

// Map slot lookup for @{"k": pat} patterns.
pub unsafe fn hermes_pat_map_slot(av: *const AnyVal, base: *const u8,
                                  key: str) -> AnyVal {
    if av.is_null() { return AnyVal::null_ptr(); }
    if !av.is_map(base) { return AnyVal::null_ptr(); }
    let obj: *const u8 = base.byte_add(av.as_offset() as i64);
    let tag: u64 = read_type_code(obj);
    if tag == hermes_tag_tiny_map() { return AnyVal::null_ptr(); }
    let omap: *const Map<Varchar, AnyVal> = obj as *const Map<Varchar, AnyVal>;
    return omap.get(base, key.as_ptr(), key.len() as u64);
}

pub unsafe fn hermes_pat_array_slot(av: *const AnyVal, base: *const u8,
                                    idx: u64) -> AnyVal {
    if av.is_null() { return AnyVal::null_ptr(); }
    if !av.is_array(base) { return AnyVal::null_ptr(); }
    let arr: *const Array<AnyVal> =
        base.byte_add(av.as_offset() as i64) as *const Array<AnyVal>;
    return arr.get(base, idx);
}

pub unsafe fn hermes_pat_array_len_eq(av: *const AnyVal, base: *const u8,
                                      n: u64) -> bool {
    if av.is_null() { return false; }
    if !av.is_array(base) { return false; }
    let arr: *const Array<AnyVal> =
        base.byte_add(av.as_offset() as i64) as *const Array<AnyVal>;
    return arr.size == n;
}

// True iff scrutinee points to a Hermes object whose type_code equals `tc`.
pub unsafe fn hermes_pat_has_type_code(av: *const AnyVal, base: *const u8,
                                       tc: u64) -> bool {
    if av.is_null() { return false; }
    if !av.is_ptr() { return false; }
    let obj: *const u8 = base.byte_add(av.as_offset() as i64);
    return read_type_code(obj) == tc;
}

pub unsafe fn hermes_pat_array_len_ge(av: *const AnyVal, base: *const u8,
                                      n: u64) -> bool {
    if av.is_null() { return false; }
    if !av.is_array(base) { return false; }
    let arr: *const Array<AnyVal> =
        base.byte_add(av.as_offset() as i64) as *const Array<AnyVal>;
    return arr.size >= n;
}
