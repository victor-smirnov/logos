// Logos Hermes stdlib — hermes.array
//
// Array<T> — dynamic zone-allocated array of T (24-byte header).
//
// Layout (24 bytes, 8-byte aligned):
//   size:     u64 — number of elements currently in the array
//   capacity: u64 — allocated capacity (in elements)
//   data:     u32 — zone-relative offset to the T[] element buffer
//   (4 bytes implicit trailing padding)
//
// Type codes:
//   Array<AnyVal>   — ObjectArray, historically the default (no explicit code)
//   Array<i32>      — type_code=104
//   Array<u64>      — type_code=108

package std.hermes.array;

use std.hermes.anyval;
use logos.lang.hermes.tags;
use std.hermes.mem_holder;
use logos.lang.hermes.relptr;

// Canonical operation on any Array #[zoned] struct: the current element count.
#[type_code = HermesTag::Array]
pub trait Array {
    unsafe fn len(self: *const Self) -> u64;
}

// Generic array #[zoned] struct: header + zone-relative offset to a T[] buffer.
#[zoned] pub struct Array<T> {
    pub size:     u64,
    pub capacity: u64,
    pub data:     RelPtr<T>,
}

// Back-compat alias — keeps existing callers working after templatization.
pub type ObjectArray = Array<AnyVal>;

// Generic inherent API for Array<T>.  Concrete `impl Array<AnyVal>` below
// overrides these via the inherent-spec rule.
impl<T> Array<T> {
    // Initialize Array<T> header at pre-allocated memory.  Buffer is left
    // uninitialized; `push` is the only way to add valid elements.
    pub unsafe fn init(arr_raw: *mut u8, buf_raw: *mut u8,
                       base: *mut u8, capacity: u64) -> *mut Array<T> {
        let buf_off: u32  = (buf_raw as *const u8).byte_offset_from(base as *const u8) as u32;
        let arr: *mut Array<T> = arr_raw as *mut Array<T>;
        arr.size     = 0;
        arr.capacity = capacity;
        arr.data.offset     = buf_off;
        return arr;
    }

    // Append a T via a value pointer.  Caller must ensure self.size < self.capacity.
    pub unsafe fn push_ptr(self: *mut Array<T>, base: *mut u8, val_ptr: *const T) {
        let buf: *mut T = base.byte_add(self.data.offset) as *mut T;
        let ep: *mut T = buf.add(self.size as i64);
        *ep = *val_ptr;
        self.size = self.size + 1;
    }

    // Dynamic push with 2× growth via MemHolder.  On grow, `self` may be
    // invalidated by the realloc — callers must re-resolve through the
    // zone base afterwards if they kept a pointer.
    pub unsafe fn push(self: *mut Array<T>, holder: *mut MemHolder, val: T) {
        let elem_sz: i64 = sizeof::<T>() as i64;
        let arr_off: u32 = (self as *const u8).byte_offset_from(holder.base) as u32;
        if self.size >= self.capacity {
            let old_cap: u64 = self.capacity;
            let new_cap: u64 = if old_cap == 0 { 8 }
                               else { old_cap * 2 };
            let new_bytes: i64 = (new_cap as i64) * elem_sz;
            let new_buf: *mut u8 = memholder_alloc(holder, new_bytes);
            if new_buf == 0 as *mut u8 { return; }
            let base2: *mut u8 = holder.base;
            let arr2: *mut Array<T> = base2.byte_add(arr_off) as *mut Array<T>;
            let old_size: u64 = arr2.size;
            let old_data_off: u32 = arr2.data.offset;
            let old_bytes: i64 = (old_size as i64) * elem_sz;
            let old_buf: *mut u8 = base2.byte_add(old_data_off);
            let mut i: i64 = 0;
            while i < old_bytes {
                *new_buf.byte_add(i) = *old_buf.byte_add(i);
                i = i + 1;
            }
            arr2.data.offset     = new_buf.byte_offset_from(base2 as *const u8) as u32;
            arr2.capacity = new_cap;
            let buf2: *mut T = new_buf as *mut T;
            let ep2: *mut T = buf2.add(arr2.size as i64);
            *ep2 = val;
            arr2.size = arr2.size + 1;
            return;
        }
        let base: *mut u8 = holder.base;
        let buf: *mut T = base.byte_add(self.data.offset) as *mut T;
        let ep: *mut T = buf.add(self.size as i64);
        *ep = val;
        self.size = self.size + 1;
    }

    // Returns a pointer to the element at idx, or null on OOB.
    pub unsafe fn get_ptr(self: *const Array<T>, base: *const u8, idx: u64) -> *const T {
        if idx >= self.size { return 0 as *const T; }
        let buf: *const T = base.byte_add(self.data.offset) as *const T;
        return buf.add(idx as i64);
    }
}

impl Array for Array<AnyVal> {
    unsafe fn len(self: *const Array<AnyVal>) -> u64 { return self.size; }
}

impl Array<AnyVal> {
    // Initialize an Array<AnyVal> at pre-allocated memory.
    //   arr_raw  — pointer to ≥sizeof(Array<AnyVal>) bytes
    //   buf_raw  — pointer to ≥ capacity*4 bytes for the element buffer
    //   base     — zone base pointer
    //   capacity — initial allocated capacity
    pub unsafe fn init(arr_raw: *mut u8, buf_raw: *mut u8,
                       base: *mut u8, capacity: u64) -> *mut Array<AnyVal> {
        let buf_off: u32   = (buf_raw as *const u8).byte_offset_from(base as *const u8) as u32;
        let arr_ptr: *mut Array<AnyVal> = arr_raw as *mut Array<AnyVal>;
        arr_ptr.size     = 0;
        arr_ptr.capacity = capacity;
        arr_ptr.data.offset     = buf_off;
        let buf: *mut AnyVal = buf_raw as *mut AnyVal;
        let mut i: u64 = 0;
        while i < capacity {
            let ep: *mut AnyVal = buf.add(i as i64);
            ep.raw = 0;
            i = i + 1;
        }
        return arr_ptr;
    }

    // Get element by index. Returns AnyVal::null_ptr() if out of bounds.
    pub unsafe fn get(self: *const Array<AnyVal>, base: *const u8, idx: u64) -> AnyVal {
        if idx >= self.size { return AnyVal::null_ptr(); }
        let buf: *const AnyVal = base.byte_add(self.data.offset) as *const AnyVal;
        let ep: *const AnyVal = buf.add(idx as i64);
        return AnyVal { raw: ep.raw };
    }
}

// ---------------------------------------------------------------------------
// Pre-materialized typed primitive array: <I32>[...]
// Dense contiguous i32 storage.
// ---------------------------------------------------------------------------

#[type_code = HermesTag::ArrayI32]
#[zoned] pub struct Array<i32>;

pub type ArrayI32 = Array<i32>;

// ---------------------------------------------------------------------------
// Pre-materialized typed primitive array: <U64>[...]
// Dense contiguous u64 storage.
// ---------------------------------------------------------------------------

#[type_code = HermesTag::ArrayU64]
#[zoned] pub struct Array<u64>;

pub type ArrayU64 = Array<u64>;

#[type_code = HermesTag::ArrayI8]
#[zoned] pub struct Array<i8>;

pub type ArrayI8 = Array<i8>;

#[type_code = HermesTag::ArrayU8]
#[zoned] pub struct Array<u8>;

pub type ArrayU8 = Array<u8>;

#[type_code = HermesTag::ArrayI16]
#[zoned] pub struct Array<i16>;

pub type ArrayI16 = Array<i16>;

#[type_code = HermesTag::ArrayU16]
#[zoned] pub struct Array<u16>;

pub type ArrayU16 = Array<u16>;

#[type_code = HermesTag::ArrayU32]
#[zoned] pub struct Array<u32>;

pub type ArrayU32 = Array<u32>;

#[type_code = HermesTag::ArrayI64]
#[zoned] pub struct Array<i64>;

pub type ArrayI64 = Array<i64>;

#[type_code = HermesTag::ArrayF32]
#[zoned] pub struct Array<f32>;

pub type ArrayF32 = Array<f32>;

#[type_code = HermesTag::ArrayF64]
#[zoned] pub struct Array<f64>;

pub type ArrayF64 = Array<f64>;
