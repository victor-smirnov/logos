// Logos Hermes stdlib — hermes.equal
//
// Structural equality for Hermes zone documents.
//
// `HermesEqual` dispatches via HermesTypeTagSystem, same tier-1 table as
// HermesStringify. Two AnyVals are equal when:
//   - both null, OR
//   - both inline with identical type_hash and raw bits, OR
//   - both pointers whose zone objects share the same type_code AND whose
//     per-type HermesEqual impl returns true.
//
// `EqualCtx` carries both zone bases so cross-zone comparison works.

package std.hermes.equal;

use logos.lang.hermes.anyval;
use logos.lang.hermes.view;
use std.hermes.string;
use logos.lang.hermes.typetag;
use std.hermes.tag_system;
use std.hermes.array;
use std.hermes.map;
use logos.lang.hermes.typed_value;
use std.hermes.objectmap;
use std.hermes.document;
use logos.lang.hermes.scalar;
use std.hermes.decimal;

pub struct EqualCtx {
    pub base_self:  *const u8,
    pub base_other: *const u8,
}

#[tag_dispatch(HermesTypeTagSystem)]
pub trait HermesEqual {
    fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool;
}

// ── AnyVal-level equality dispatcher (mutual recursion with impls below) ──

pub unsafe fn anyval_equal(a: AnyVal, b: AnyVal, ctx: *mut EqualCtx) -> bool {
    if a.is_null() && b.is_null() { return true; }
    if a.is_null() != b.is_null() { return false; }
    if a.is_ptr() != b.is_ptr()   { return false; }

    if !a.is_ptr() {
        // Inline: raw bits carry type_hash + payload; direct compare is enough.
        return a.raw == b.raw;
    }

    // Pointer mode: resolve both offsets, match tags, dispatch.
    let obj_a: *const u8 = ctx.base_self.byte_add(a.as_offset() as i64);
    let obj_b: *const u8 = ctx.base_other.byte_add(b.as_offset() as i64);
    // Bug fix: use TagSystem::read_tag instead of manual byte reading to support variable-length tags.
    let ts: HermesTypeTagSystem = HermesTypeTagSystem {};
    let tag_a: u64 = ts.read_tag(obj_a);
    let tag_b: u64 = ts.read_tag(obj_b);
    if tag_a != tag_b { return false; }

    let tagged_a: &tagged<HermesTypeTagSystem> HermesEqual = obj_a;
    return tagged_a.equal(obj_b, ctx);
}

// ── HermesString (28): byte-wise equality ─────────────────────────────────

impl HermesEqual for HermesString {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe {
            let a: *const HermesString = self;
            let b: *const HermesString = other as *const HermesString;
            let la: u64 = a.len();
            let lb: u64 = b.len();
            if la != lb { return false; }
            let pa: *const u8 = a.bytes();
            let pb: *const u8 = b.bytes();
            let mut i: u64 = 0;
            while i < la {
                let ca: u8 = *pa.byte_add(i as i64);
                let cb: u8 = *pb.byte_add(i as i64);
                if ca != cb { return false; }
                i = i + 1;
            }
            return true;
        }
    }
}

// ── Raw primitive scalars (used by Array<T> blanket when T is known) ───────

impl HermesEqual for i8 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe { return *self == *(other as *const i8); }
    }
}

impl HermesEqual for u8 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe { return *self == *other; }
    }
}

impl HermesEqual for i16 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe { return *self == *(other as *const i16); }
    }
}

impl HermesEqual for u16 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe { return *self == *(other as *const u16); }
    }
}

impl HermesEqual for i32 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe { return *self == *(other as *const i32); }
    }
}

impl HermesEqual for u32 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe { return *self == *(other as *const u32); }
    }
}

impl HermesEqual for i64 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe { return *self == *(other as *const i64); }
    }
}

impl HermesEqual for u64 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe { return *self == *(other as *const u64); }
    }
}

impl HermesEqual for f32 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe { return *self == *(other as *const f32); }
    }
}

impl HermesEqual for f64 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe { return *self == *(other as *const f64); }
    }
}

// ── I64 (26) / U64 (27): byte-identical payload ────────────────────────────

impl HermesEqual for I64 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe {
            let a: *const I64 = self;
            let b: *const I64 = other as *const I64;
            return a.value() == b.value();
        }
    }
}

impl HermesEqual for U64 {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe {
            let a: *const U64 = self;
            let b: *const U64 = other as *const U64;
            return a.value() == b.value();
        }
    }
}

impl HermesEqual for Decimal {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe {
            let a: *const Decimal = self;
            let b: *const Decimal = other as *const Decimal;
            if a.spec_and_len != b.spec_and_len { return false; }
            let n: u32 = a.len();
            let mut i: u32 = 0;
            while i < n {
                if a.limb_at(i) != b.limb_at(i) { return false; }
                i = i + 1;
            }
            return true;
        }
    }
}

// ── AnyVal (inline — internal dispatch through tag bits / zone pointer) ───

impl HermesEqual for AnyVal {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe {
            let ob: *const AnyVal = other as *const AnyVal;
            return anyval_equal(AnyVal { raw: (self).raw },
                                AnyVal { raw: ob.raw }, ctx);
        }
    }
}

// ── Array<T>: element-wise equality for any T: HermesEqual ────────────────

impl<T: HermesEqual> HermesEqual for Array<T> {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe {
            let a: *const Array<T> = self as *const Array<T>;
            let b: *const Array<T> = other as *const Array<T>;
            if a.size != b.size { return false; }
            let buf_a: *const T = ctx.base_self.byte_add(a.data.offset) as *const T;
            let buf_b: *const T = ctx.base_other.byte_add(b.data.offset) as *const T;
            let mut i: u64 = 0;
            while i < a.size {
                let ea: *const T = buf_a.add(i as i64);
                let eb: *const T = buf_b.add(i as i64);
                if !ea.equal(eb as *const u8, ctx) { return false; }
                i = i + 1;
            }
            return true;
        }
    }
}

// ── Map<Bitmap, V> blanket — same 52-key bitmap + per-key value equality ──

impl<V: HermesEqual> HermesEqual for Map<Bitmap, V> {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe {
            let a: *const Map<Bitmap, V> = self as *const Map<Bitmap, V>;
            let b: *const Map<Bitmap, V> = other as *const Map<Bitmap, V>;
            let mask: u64 = 0x000FFFFFFFFFFFFF;
            let ba: u64 = a.header & mask;
            let bb: u64 = b.header & mask;
            if ba != bb { return false; }
            let buf_a: *const V = ctx.base_self.byte_add(a.data.offset) as *const V;
            let buf_b: *const V = ctx.base_other.byte_add(b.data.offset) as *const V;
            let mut key: u8 = 0;
            while key < 52 {
                let key_bit: u64 = 1 << key as u64;
                if (ba & key_bit) != 0 {
                    let m: u64 = key_bit - 1;
                    let pos: u32 = popcount_u64(ba & m);
                    let va: *const V = buf_a.add(pos as i64);
                    let vb: *const V = buf_b.add(pos as i64);
                    if !va.equal(vb as *const u8, ctx) { return false; }
                }
                key = key + 1;
            }
            return true;
        }
    }
}

// ── ObjectMap (101): same keyset + per-key value equality ─────────────────

impl HermesEqual for ObjectMap {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe {
            let a: *const ObjectMap = self;
            let b: *const ObjectMap = other as *const ObjectMap;
            if a.count != b.count { return false; }
            // For each occupied slot in `a`, find the matching key in `b` and
            // compare values. Lookup handles open-addressing details.
            let cap_a: u32 = a.capacity;
            let base_a_ent: *const MapEntry =
                ctx.base_self.byte_add(a.entries_off.offset as i64) as *const MapEntry;
            let mut slot: u32 = 0;
            while slot < cap_a {
                let ep_a: *const MapEntry = base_a_ent.add(slot as i64);
                if ep_a.key_off.offset != 0 {
                    let hs_a: *const HermesString =
                        ctx.base_self.byte_add(ep_a.key_off.offset as i64) as *const HermesString;
                    let kb: *const u8 = hs_a.bytes();
                    let klen: u64 = hs_a.len();
                    // Bug fix: check key presence explicitly. get() returns null
                    // for both "absent key" and "key → null value"; without this
                    // guard {x:null} and {y:null} would compare equal (same count,
                    // both lookups return null).
                    if !b.contains(ctx.base_other, kb, klen) { return false; }
                    let vb_raw: u32 = b.get(ctx.base_other, kb, klen).raw;
                    let va: AnyVal = AnyVal { raw: ep_a.val };
                    let vb: AnyVal = AnyVal { raw: vb_raw };
                    if !anyval_equal(va, vb, ctx) { return false; }
                }
                slot = slot + 1;
            }
            return true;
        }
    }
}

// ── MapKeyEq — bridge trait for Map<K, AnyVal> equality ───────────────────
//
// K must support byte-level equality comparison via a typed pointer.
pub trait MapKeyEq {
    unsafe fn key_eq(a: *const Self, b: *const Self) -> bool;
}

impl MapKeyEq for i32 { pub unsafe fn key_eq(a: *const i32, b: *const i32) -> bool { return *a == *b; } }
impl MapKeyEq for u32 { pub unsafe fn key_eq(a: *const u32, b: *const u32) -> bool { return *a == *b; } }
impl MapKeyEq for i64 { pub unsafe fn key_eq(a: *const i64, b: *const i64) -> bool { return *a == *b; } }
impl MapKeyEq for u64 { pub unsafe fn key_eq(a: *const u64, b: *const u64) -> bool { return *a == *b; } }

// ── Map<K, AnyVal>: same key set + same value per key ─────────────────────

impl<K: MapKeyEq> HermesEqual for Map<K, AnyVal> {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe {
            let a: *const Map<K, AnyVal> = self as *const Map<K, AnyVal>;
            let b: *const Map<K, AnyVal> = other as *const Map<K, AnyVal>;
            if a.size != b.size { return false; }
            let ka: *const K = ctx.base_self.byte_add(a.keys.offset) as *const K;
            let va: *const AnyVal = ctx.base_self.byte_add(a.vals.offset) as *const AnyVal;
            let kb: *const K = ctx.base_other.byte_add(b.keys.offset) as *const K;
            let vb: *const AnyVal = ctx.base_other.byte_add(b.vals.offset) as *const AnyVal;
            let mut i: u32 = 0;
            while i < a.size {
                let kap: *const K = ka.add(i as i64);
                let av: AnyVal = AnyVal { raw: (va.add(i as i64)).raw };
                let mut j: u32 = 0;
                let mut found: bool = false;
                while j < b.size {
                    if K::key_eq(kap, kb.add(j as i64)) {
                        let bv: AnyVal = AnyVal { raw: (vb.add(j as i64)).raw };
                        if !anyval_equal(av, bv, ctx) { return false; }
                        found = true;
                        j = b.size;
                    } else {
                        j = j + 1;
                    }
                }
                if !found { return false; }
                i = i + 1;
            }
            return true;
        }
    }
}

// ── TypedValue (106): same type name + params + initializer ───────────────

impl HermesEqual for TypedValue {
    pub fn equal(&self, other: *const u8, ctx: *mut EqualCtx) -> bool {
        unsafe {
            let a: *const TypedValue = self;
            let b: *const TypedValue = other as *const TypedValue;

            let sa: *const HermesString =
                ctx.base_self.byte_add(a.type_off.offset as i64) as *const HermesString;
            let sb: *const HermesString =
                ctx.base_other.byte_add(b.type_off.offset as i64) as *const HermesString;
            if sa.len() != sb.len() { return false; }
            let mut i: u64 = 0;
            while i < sa.len() {
                let ca: u8 = *sa.bytes().byte_add(i as i64);
                let cb: u8 = *sb.bytes().byte_add(i as i64);
                if ca != cb { return false; }
                i = i + 1;
            }

            let pa: AnyVal = AnyVal { raw: a.params_raw };
            let pb: AnyVal = AnyVal { raw: b.params_raw };
            if !anyval_equal(pa, pb, ctx) { return false; }

            let ia: AnyVal = AnyVal { raw: a.init_raw };
            let ib: AnyVal = AnyVal { raw: b.init_raw };
            if !anyval_equal(ia, ib, ctx) { return false; }

            return true;
        }
    }
}
