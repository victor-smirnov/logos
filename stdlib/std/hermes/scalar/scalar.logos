// Logos Hermes stdlib — hermes.scalar
//
// Primitive scalar genera and their zone-allocated eide.  Each genus is
// identified by its Hermes type_code (see openspec/specs/hermes-wire-format.md
// §"Core Type Codes" for the canonical registry).  Generic code can work
// against the genos trait directly; concrete zone code deals with the #[zoned] struct
// struct.
//
// Genus / #[zoned] struct pairs in this module:
//   TinyInt   / I8       (type_code=20, i8)
//   UTinyInt  / U8       (type_code=21, u8)
//   SmallInt  / I16      (type_code=22, i16)
//   Integer   / I24      (type_code=23, i24  — also inline-representable)
//   USmallInt / U16      (type_code=24, u16)
//   UInteger  / U24      (type_code=25, u24  — also inline-representable)
//   Int64     / I64      (type_code=26, i64)
//   UInt64    / U64      (type_code=27, u64)
//   Real      / F32      (type_code=30, f32)
//   Double    / F64      (type_code=31, f64)
//   Boolean   / Bool     (type_code=37, bool)

package std.hermes.scalar;

use std.lang.datatypes;
use std.hermes.tags;

// ── TinyInt (i8) ─────────────────────────────────────────────────────────

#[type_code = HermesTag::I8]
pub trait TinyInt {
    unsafe fn value(self: *const Self) -> i8;
}

#[zoned] pub struct I8 { pub v: i8, }

impl TinyInt for I8 {
    unsafe fn value(self: *const I8) -> i8 { return self.v; }
}

impl I8 {
    pub unsafe fn init(raw: *mut u8, value: i8) -> *mut I8 {
        let p: *mut I8 = raw as *mut I8;
        p.v = value;
        return p;
    }
}

