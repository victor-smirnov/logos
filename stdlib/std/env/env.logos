// Logos standard library — std.env

package logos.std.env;

use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.mem;

extern fn logos_argc() -> i32;
extern fn logos_argv() -> *const *const u8;
extern fn getenv(name: *const u8) -> *const u8;
extern fn readlink(path: *const u8, buf: *mut u8, bufsiz: u64) -> i64;

// Number of command-line arguments (including argv[0]).
pub fn args_count() -> i32 {
    unsafe { return logos_argc(); }
}

// Return argument `i` as a str.  Returns "" if out of range.
pub fn arg(i: i32) -> str {
    unsafe {
        let argc: i32 = logos_argc();
        if i < 0 { return ""; }
        if i >= argc { return ""; }
        let argv: *const *const u8 = logos_argv();
        // Index the pointer array: argv[i] is at *(argv + i*8).
        let ptr_ptr: *const *const u8 = (argv as i64 + i as i64 * 8 as i64) as *const *const u8;
        let s_ptr: *const u8 = ptr_ptr[0];
        return str_from_cstr(s_ptr);
    }
}

// Look up an environment variable by name. Safe ergonomic form: takes a `str`,
// returns an OWNED copy of the value (the C environ string is copied, so it
// survives later setenv). The unsafe C interop is encapsulated here.
pub fn var(name: str) -> Option<String> {
    let mut c: String = String::new();
    c.push_str(name);
    c.push_u8(0 as u8);                       // null-terminate for getenv
    unsafe {
        let v: *const u8 = getenv(c.as_ptr());
        if v == 0 as *const u8 { return Option::None; }
        let mut out: String = String::new();
        out.push_str(str_from_cstr(v));
        return Option::Some(out);
    }
}

// True if the environment variable `name` is set.
pub fn var_is_set(name: str) -> bool {
    let mut c: String = String::new();
    c.push_str(name);
    c.push_u8(0 as u8);
    unsafe { return getenv(c.as_ptr()) != 0 as *const u8; }
}

// Path of the running executable, resolved through /proc/self/exe (follows the
// symlink chain to the real file). None if it can't be read.
pub fn current_exe() -> Option<String> {
    let mut p: String = String::new();
    p.push_str("/proc/self/exe");
    p.push_u8(0 as u8);
    unsafe {
        let cap: i64 = 4096 as i64;
        let buf: *mut u8 = alloc(cap);
        let n: i64 = readlink(p.as_ptr(), buf, (cap - 1 as i64) as u64);
        if n <= 0 as i64 { dealloc(buf); return Option::None; }
        let mut out: String = String::new();
        out.push_bytes(buf as *const u8, n);
        dealloc(buf);
        return Option::Some(out);
    }
}

// Look up an environment variable by null-terminated C name.
// Returns Some(value) or None.
pub fn var(name: *const u8) -> Option<str> {
    unsafe {
        let v: *const u8 = getenv(name);
        if v == 0 as *const u8 { return Option::None; }
        return Option::Some(str_from_cstr(v));
    }
}

// Returns true if the environment variable is set.
pub fn var_is_set(name: *const u8) -> bool {
    unsafe {
        return getenv(name) != 0 as *const u8;
    }
}
