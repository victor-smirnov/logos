// Logos standard library — std.env

package logos.std.env;

use logos.mem.string;
use logos.lang.str;
use logos.lang.option;
use logos.lang.mem;

extern fn logos_argc() -> i32;
extern fn logos_argv() -> *const *const u8;
extern fn getenv(name: *const u8) -> *const u8;
extern fn readlink(path: *const u8, buf: *mut u8, bufsiz: u64) -> i64;
extern fn chdir(path: *const u8) -> i32;
extern fn getcwd(buf: *mut u8, size: u64) -> *mut u8;

/// Returns the number of command-line arguments, including `argv[0]`.
///
/// Returns `0` if `/proc/self/cmdline` could not be read at startup (e.g. in a sandbox).
pub fn args_count() -> i32 {
    unsafe { return logos_argc(); }
}

/// Returns command-line argument `i` as a `str`, or `""` if `i` is out of range.
pub fn arg(i: i32) -> str {
    unsafe {
        let argc: i32 = logos_argc();
        if i < 0 { return ""; }
        if i >= argc { return ""; }
        let argv: *const *const u8 = logos_argv();
        // Index the pointer array: argv[i] is at *(argv + i*8).
        let ptr_ptr: *const *const u8 = (argv as i64 + i as i64 * 8 as i64) as *const *const u8;
        let s_ptr: *const u8 = ptr_ptr[0];
        return str_from_cstr(s_ptr);
    }
}

/// Returns the value of the environment variable `name` as an owned copy, or `None` if unset.
///
/// The C environ string is copied, so the result survives a later `setenv`.
pub fn var(name: str) -> Option<String> {
    let mut c: String = String::new();
    c.push_str(name);
    c.push_u8(0 as u8);                       // null-terminate for getenv
    unsafe {
        let v: *const u8 = getenv(c.as_ptr());
        if v == 0 as *const u8 { return Option::None; }
        let mut out: String = String::new();
        out.push_str(str_from_cstr(v));
        return Option::Some(out);
    }
}

/// Returns `true` if the environment variable `name` is set.
pub fn var_is_set(name: str) -> bool {
    let mut c: String = String::new();
    c.push_str(name);
    c.push_u8(0 as u8);
    unsafe { return getenv(c.as_ptr()) != 0 as *const u8; }
}

/// Returns the path of the running executable, or `None` if it cannot be determined.
///
/// Resolved through `/proc/self/exe`, following the symlink chain to the real file.
pub fn current_exe() -> Option<String> {
    let mut p: String = String::new();
    p.push_str("/proc/self/exe");
    p.push_u8(0 as u8);
    unsafe {
        let cap: i64 = 4096 as i64;
        let buf: *mut u8 = alloc(cap);
        let n: i64 = readlink(p.as_ptr(), buf, (cap - 1 as i64) as u64);
        if n <= 0 as i64 { dealloc(buf); return Option::None; }
        let mut out: String = String::new();
        out.push_bytes(buf as *const u8, n);
        dealloc(buf);
        return Option::Some(out);
    }
}

/// Returns the current working directory as an owned `String`, or `None` on error.
pub fn current_dir() -> Option<String> {
    unsafe {
        let cap: i64 = 4096 as i64;
        let buf: *mut u8 = alloc(cap);
        let r: *mut u8 = getcwd(buf, cap as u64);
        if r == 0 as *mut u8 { dealloc(buf); return Option::None; }
        let mut out: String = String::new();
        out.push_str(str_from_cstr(r as *const u8));
        dealloc(buf);
        return Option::Some(out);
    }
}

/// Changes the process working directory to `path`.
///
/// Returns the raw libc `chdir` result: `0` on success, `-1` on failure.
pub fn set_current_dir(path: str) -> i32 {
    let mut c: String = String::new();
    c.push_str(path);
    c.push_u8(0 as u8);
    return unsafe { chdir(c.as_ptr()) };
}

/// Returns the value of the environment variable named by NUL-terminated C string `name`,
/// or `None` if unset.
///
/// The returned `str` borrows libc environ storage; a later `setenv` may invalidate it.
pub fn var(name: *const u8) -> Option<str> {
    unsafe {
        let v: *const u8 = getenv(name);
        if v == 0 as *const u8 { return Option::None; }
        return Option::Some(str_from_cstr(v));
    }
}

/// Returns `true` if the environment variable named by NUL-terminated C string `name` is set.
pub fn var_is_set(name: *const u8) -> bool {
    unsafe {
        return getenv(name) != 0 as *const u8;
    }
}
