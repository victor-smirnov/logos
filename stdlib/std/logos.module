module logos-std
id logos-std
version 0.1
root stdlib/std/
tier std
depends logos-mem
depends logos-lang

# Metaprog plumbing references host externs defined inside logosc for JIT'd
# hooks. ast_only embeds their .hermes0 AST (the metacall JIT recompiles them)
# while skipping codegen (the externs aren't linkable into user binaries).
ast_only compiler/metaprog
