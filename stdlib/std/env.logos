// Logos standard library — std.env

package std.env;

use std.string;
use std.option;

extern fn logos_argc() -> i32;
extern fn logos_argv() -> *const *const u8;
extern fn getenv(name: *const u8) -> *const u8;

// Number of command-line arguments (including argv[0]).
pub fn args_count() -> i32 {
    unsafe { return logos_argc(); }
}

// Return argument `i` as a str.  Returns "" if out of range.
pub fn arg(i: i32) -> str {
    unsafe {
        let argc: i32 = logos_argc();
        if i < 0 { return ""; }
        if i >= argc { return ""; }
        let argv: *const *const u8 = logos_argv();
        // Index the pointer array: argv[i] is at *(argv + i*8).
        let ptr_ptr: *const *const u8 = (argv as i64 + i as i64 * 8 as i64) as *const *const u8;
        let s_ptr: *const u8 = ptr_ptr[0];
        return str_from_cstr(s_ptr);
    }
}

// Look up an environment variable by null-terminated C name.
// Returns Some(value) or None.
pub fn var(name: *const u8) -> Option<str> {
    unsafe {
        let v: *const u8 = getenv(name);
        if v == 0 as *const u8 { return Option::None; }
        return Option::Some(str_from_cstr(v));
    }
}

// Returns true if the environment variable is set.
pub fn var_is_set(name: *const u8) -> bool {
    unsafe {
        return getenv(name) != 0 as *const u8;
    }
}
