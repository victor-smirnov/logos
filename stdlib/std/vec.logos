// Logos standard library — std.vec
//
// Vec<T> — growable heap-allocated generic array.
// Uses malloc/realloc/free from std.mem.

package std.vec;

use std.mem;

struct Vec<T> {
    ptr: *mut T;
    len: i64;
    cap: i64;
}

fn vec_new<T>() -> Vec<T> {
    let init_cap: i64 = 8;
    let byte_size: i64 = init_cap * sizeof::<T>();
    let raw: *mut u8 = malloc(byte_size);
    let ptr: *mut T = raw as *mut T;
    return Vec { ptr: ptr, len: 0, cap: init_cap };
}

impl<T> Vec<T> {
    fn push(self: *mut Vec<T>, val: T) {
        if self.len == self.cap {
            self.cap = self.cap * 2;
            let byte_size: i64 = self.cap * sizeof::<T>();
            let raw: *mut u8 = realloc(self.ptr as *mut u8, byte_size);
            self.ptr = raw as *mut T;
        }
        self.ptr[self.len] = val;
        self.len = self.len + 1;
    }

    fn get(self: *mut Vec<T>, i: i64) -> T {
        return self.ptr[i];
    }

    fn length(self: *mut Vec<T>) -> i64 {
        return self.len;
    }
}

fn vec_free<T>(v: *mut Vec<T>) {
    free(v.ptr as *mut u8);
}
