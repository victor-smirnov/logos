// SPDX-License-Identifier: Apache-2.0
// Logos standard library — std.http
//
// HTTP/1.1 types for client and server. Phase E: types only.
// Parsers, codecs, client/server implementations arrive in later phases.
//
// No TLS. No HPACK. No connection pooling. Buffered bodies.

package std.http;

use std.string;
use std.vec;
use std.option;
use std.url;

// ── Method ───────────────────────────────────────────────────────────────────
// Represented as a small integer code plus its literal token. Unknown /
// extension methods share code == 7 (METHOD_OTHER) and preserve the token
// verbatim in `name`.

pub struct Method {
    pub code: i32,
    pub name: String,
}

fn method_with(code: i32, s: str) -> Method {
    let mut n: String = String::new();
    n.push_str(s);
    return Method { code: code, name: n };
}

impl Method {
    pub static fn get()     -> Method { return method_with(0, "GET");     }
    pub static fn post()    -> Method { return method_with(1, "POST");    }
    pub static fn put()     -> Method { return method_with(2, "PUT");     }
    pub static fn delete()  -> Method { return method_with(3, "DELETE");  }
    pub static fn head()    -> Method { return method_with(4, "HEAD");    }
    pub static fn options() -> Method { return method_with(5, "OPTIONS"); }
    pub static fn patch()   -> Method { return method_with(6, "PATCH");   }

    pub fn eq_str(&self, s: str) -> bool {
        return self.name.eq_str(s);
    }
}

// Borrow a String as str (no copy). Free function — methods returning `str`
// currently have a codegen issue around sret.
fn s2str(s: &String) -> str {
    return unsafe { str_from_raw((s).as_ptr(), (s).len()) };
}

// Compare two byte ranges exactly (ASCII, case-sensitive).
fn bytes_eq(a: *const u8, an: i64, b: *const u8, bn: i64) -> bool {
    if an != bn { return false; }
    let mut i: i64 = 0;
    while i < an {
        unsafe {
            if a[i] != b[i] { return false; }
        }
        i = i + 1;
    }
    return true;
}

// Parse a method token (ASCII, case-sensitive per RFC 7230). Unknown tokens
// return code == 7 (METHOD_OTHER) with the original name preserved.
pub fn method_parse(s: str) -> Method {
    let p: *const u8 = s.as_ptr();
    let n: i64 = s.len();
    if bytes_eq(p, n, "GET"    .as_ptr(), 3) { return Method::get();     }
    if bytes_eq(p, n, "PUT"    .as_ptr(), 3) { return Method::put();     }
    if bytes_eq(p, n, "POST"   .as_ptr(), 4) { return Method::post();    }
    if bytes_eq(p, n, "HEAD"   .as_ptr(), 4) { return Method::head();    }
    if bytes_eq(p, n, "PATCH"  .as_ptr(), 5) { return Method::patch();   }
    if bytes_eq(p, n, "DELETE" .as_ptr(), 6) { return Method::delete();  }
    if bytes_eq(p, n, "OPTIONS".as_ptr(), 7) { return Method::options(); }
    let mut name: String = String::new();
    name.push_str(s);
    return Method { code: 7, name: name };
}

// ── Headers ──────────────────────────────────────────────────────────────────
// Ordered list of (name, value) pairs. Duplicates are allowed (e.g.
// Set-Cookie). Lookup is case-insensitive per RFC 7230 §3.2.
//
// Layout: one `buf` blob holds every name+value back-to-back, each NUL-
// terminated. `entries` is a parallel array of (name_off, name_len,
// value_off, value_len) quadruples, each field i32. This sidesteps the
// current Vec-of-struct-with-Drop limitation (struct fields with __drop
// aren't cleaned up when a Vec slot is overwritten/dropped).

pub struct Header {
    pub name_off:  i32,
    pub name_len:  i32,
    pub value_off: i32,
    pub value_len: i32,
}

pub struct Headers {
    pub buf:     String,
    pub entries: Vec<Header>,
}

// ASCII-only case-insensitive compare of two byte ranges; returns true on match.
fn ascii_ieq(a: *const u8, an: i64, b: *const u8, bn: i64) -> bool {
    if an != bn { return false; }
    let mut i: i64 = 0;
    while i < an {
        unsafe {
            let mut ca: i32 = a[i] as i32;
            let mut cb: i32 = b[i] as i32;
            if ca >= 65 && ca <= 90 { ca = ca + 32; }
            if cb >= 65 && cb <= 90 { cb = cb + 32; }
            if ca != cb { return false; }
        }
        i = i + 1;
    }
    return true;
}

impl Headers {
    pub static fn new() -> Headers {
        return Headers {
            buf:     String::new(),
            entries: vec_new::<Header>(),
        };
    }

    pub fn len(&self) -> i64 {
        return (&self.entries).length();
    }

    // Pointer to the first byte of the `i`-th header's name (in `buf`).
    unsafe fn name_ptr(&self, h: Header) -> *const u8 {
        return ((&self.buf).as_ptr() as i64 + h.name_off as i64) as *const u8;
    }

    unsafe fn value_ptr(&self, h: Header) -> *const u8 {
        return ((&self.buf).as_ptr() as i64 + h.value_off as i64) as *const u8;
    }

    // Append a (name, value) pair unconditionally (preserves duplicates).
    pub fn append(&mut self, name: str, value: str) {
        let name_off: i32 = (&self.buf).len() as i32;
        let name_len: i32 = name.len() as i32;
        self.buf.push_str(name);
        self.buf.push_u8(0 as u8);
        let value_off: i32 = (&self.buf).len() as i32;
        let value_len: i32 = value.len() as i32;
        self.buf.push_str(value);
        self.buf.push_u8(0 as u8);
        let h: Header = Header {
            name_off:  name_off,
            name_len:  name_len,
            value_off: value_off,
            value_len: value_len,
        };
        unsafe {
            let p: *mut Vec<Header> = &mut self.entries;
            p.push(h);
        }
    }

    // True if a header with the given name exists (case-insensitive).
    pub fn contains(&self, name: str) -> bool {
        let nptr: *const u8 = name.as_ptr();
        let nlen: i64 = name.len();
        let total: i64 = (&self.entries).length();
        let mut i: i64 = 0;
        unsafe {
            let ep: *mut Vec<Header> = &self.entries as *const Vec<Header> as *mut Vec<Header>;
            while i < total {
                let h: Header = ep.get(i);
                if ascii_ieq(self.name_ptr(h), h.name_len as i64, nptr, nlen) {
                    return true;
                }
                i = i + 1;
            }
        }
        return false;
    }

    // Return the first value for `name` (case-insensitive), or Option::None.
    pub fn get(&self, name: str) -> Option<String> {
        let nptr: *const u8 = name.as_ptr();
        let nlen: i64 = name.len();
        let total: i64 = (&self.entries).length();
        let mut i: i64 = 0;
        unsafe {
            let ep: *mut Vec<Header> = &self.entries as *const Vec<Header> as *mut Vec<Header>;
            while i < total {
                let h: Header = ep.get(i);
                if ascii_ieq(self.name_ptr(h), h.name_len as i64, nptr, nlen) {
                    let s: String = String::from_bytes(
                        self.value_ptr(h), h.value_len as i64);
                    return Option::Some(s);
                }
                i = i + 1;
            }
        }
        return Option::None;
    }

    // Replace the value of the first matching header (case-insensitive), or
    // append if none exists. Storage note: we can't shrink/expand entries
    // already in `buf`; the simplest, correct approach is to append fresh
    // name+value bytes and retarget the existing Header record.
    pub fn set(&mut self, name: str, value: str) {
        let nptr: *const u8 = name.as_ptr();
        let nlen: i64 = name.len();
        let total: i64 = (&self.entries).length();
        let mut i: i64 = 0;
        unsafe {
            let ep: *mut Vec<Header> = &mut self.entries;
            while i < total {
                let h: Header = ep.get(i);
                if ascii_ieq(self.name_ptr(h), h.name_len as i64, nptr, nlen) {
                    let buf_ref: &mut String = &mut self.buf;
                    let name_off: i32 = buf_ref.len() as i32;
                    buf_ref.push_str(name);
                    buf_ref.push_u8(0 as u8);
                    let value_off: i32 = buf_ref.len() as i32;
                    buf_ref.push_str(value);
                    buf_ref.push_u8(0 as u8);
                    ep.set(i, Header {
                        name_off:  name_off,
                        name_len:  name.len() as i32,
                        value_off: value_off,
                        value_len: value.len() as i32,
                    });
                    return;
                }
                i = i + 1;
            }
        }
        self.append(name, value);
    }

    // Remove all headers matching `name` (case-insensitive). Returns the
    // number of entries removed. Their backing bytes in `buf` are leaked
    // until the whole Headers is dropped — this is fine for typical
    // request/response lifetimes.
    pub fn remove(&mut self, name: str) -> i64 {
        let nptr: *const u8 = name.as_ptr();
        let nlen: i64 = name.len();
        let mut removed: i64 = 0;
        let mut i: i64 = 0;
        unsafe {
            let ep: *mut Vec<Header> = &mut self.entries;
            while i < ep.length() {
                let h: Header = ep.get(i);
                if ascii_ieq(self.name_ptr(h), h.name_len as i64, nptr, nlen) {
                    ep.remove(i);
                    removed = removed + 1;
                } else {
                    i = i + 1;
                }
            }
        }
        return removed;
    }
}

// ── Request / Response ───────────────────────────────────────────────────────

pub struct Request {
    pub method:  Method,
    pub url:     Url,
    pub headers: Headers,
    pub body:    Vec<u8>,
}

pub struct Response {
    pub status:  i32,
    pub reason:  String,
    pub headers: Headers,
    pub body:    Vec<u8>,
}

impl Request {
    pub static fn new(method: Method, u: Url) -> Request {
        return Request {
            method:  method,
            url:     u,
            headers: Headers::new(),
            body:    vec_new::<u8>(),
        };
    }
}

impl Response {
    pub static fn new(status: i32) -> Response {
        let mut r: String = String::new();
        r.push_str(http_reason_phrase(status));
        return Response {
            status:  status,
            reason:  r,
            headers: Headers::new(),
            body:    vec_new::<u8>(),
        };
    }
}

// ── HttpError ────────────────────────────────────────────────────────────────

pub enum HttpError {
    Connect,
    Io,
    Parse,
    BadStatus(i32),
    BadUrl,
}

// Minimal reason-phrase table. Unknown codes → empty.
pub fn http_reason_phrase(status: i32) -> str {
    if status == 200 { return "OK"; }
    if status == 201 { return "Created"; }
    if status == 204 { return "No Content"; }
    if status == 301 { return "Moved Permanently"; }
    if status == 302 { return "Found"; }
    if status == 304 { return "Not Modified"; }
    if status == 400 { return "Bad Request"; }
    if status == 401 { return "Unauthorized"; }
    if status == 403 { return "Forbidden"; }
    if status == 404 { return "Not Found"; }
    if status == 405 { return "Method Not Allowed"; }
    if status == 408 { return "Request Timeout"; }
    if status == 411 { return "Length Required"; }
    if status == 413 { return "Payload Too Large"; }
    if status == 500 { return "Internal Server Error"; }
    if status == 501 { return "Not Implemented"; }
    if status == 502 { return "Bad Gateway"; }
    if status == 503 { return "Service Unavailable"; }
    return "";
}

// ── Parser ───────────────────────────────────────────────────────────────────
// Buffer-based HTTP/1.1 parser. Iterative — one cursor walking [src, src+len).
// Socket-driven parsing (Phase I) will slurp into a buffer and call these.
//
// All parsers return Option::None on malformed input. They do not distinguish
// between "incomplete" and "malformed"; callers using streaming I/O must
// ensure the buffer holds a full message before parsing.

// Scan for CRLF starting at `from`. Returns the index of CR, or -1 if absent.
fn find_crlf(src: *const u8, len: i64, from: i64) -> i64 {
    let mut i: i64 = from;
    unsafe {
        while (i + 1) < len {
            if src[i] == 13 as u8 && src[i + 1] == 10 as u8 { return i; }
            i = i + 1;
        }
    }
    return 0 - 1;
}

// Parse an ASCII decimal integer from [src+from, src+end). Returns -1 on
// empty/invalid input.
fn parse_decimal(src: *const u8, from: i64, end: i64) -> i64 {
    if from >= end { return 0 - 1; }
    let mut n: i64 = 0;
    let mut i: i64 = from;
    unsafe {
        while i < end {
            let c: i32 = src[i] as i32;
            if c < 48 || c > 57 { return 0 - 1; }
            n = n * 10 + (c - 48) as i64;
            i = i + 1;
        }
    }
    return n;
}

// Trim leading SP/HTAB from [from, end). Returns new start index.
fn trim_ows_left(src: *const u8, from: i64, end: i64) -> i64 {
    let mut i: i64 = from;
    unsafe {
        while i < end {
            let c: u8 = src[i];
            if c != 32 as u8 && c != 9 as u8 { return i; }
            i = i + 1;
        }
    }
    return end;
}

// Trim trailing SP/HTAB from [from, end). Returns new end index.
fn trim_ows_right(src: *const u8, from: i64, end: i64) -> i64 {
    let mut j: i64 = end;
    unsafe {
        while j > from {
            let c: u8 = src[j - 1];
            if c != 32 as u8 && c != 9 as u8 { return j; }
            j = j - 1;
        }
    }
    return from;
}

// Copy bytes [from, end) of src into dst Vec<u8>.
unsafe fn copy_body(src: *const u8, from: i64, end: i64, dst: *mut Vec<u8>) {
    let mut i: i64 = from;
    while i < end {
        dst.push(src[i]);
        i = i + 1;
    }
}

// Parse headers from [pos, len). Returns the position just past the empty
// CRLF terminator, or -1 on malformed input. Each header line is
// `name: value CRLF`; OWS around value is trimmed.
fn parse_headers(src: *const u8, len: i64, pos: i64, h: &mut Headers) -> i64 {
    let mut p: i64 = pos;
    unsafe {
        while true {
            let eol: i64 = find_crlf(src, len, p);
            if eol < 0 { return 0 - 1; }
            if eol == p {
                // empty line — end of headers
                return p + 2;
            }
            // find ':' within [p, eol)
            let mut colon: i64 = 0 - 1;
            let mut i: i64 = p;
            while i < eol {
                if src[i] == 58 as u8 { colon = i; i = eol; } else { i = i + 1; }
            }
            if colon < 0 { return 0 - 1; }
            let name_start: i64 = p;
            let name_end:   i64 = colon;
            let v0: i64 = trim_ows_left(src, colon + 1, eol);
            let v1: i64 = trim_ows_right(src, v0, eol);
            // materialize name / value as temporary strs via from_bytes
            let name:  String = String::from_bytes(
                (src as i64 + name_start) as *const u8, name_end - name_start);
            let value: String = String::from_bytes(
                (src as i64 + v0) as *const u8, v1 - v0);
            h.append(s2str(&name), s2str(&value));
            p = eol + 2;
        }
    }
    return 0 - 1;
}

// Decide body length from headers. Returns:
//   >= 0: exact byte count (Content-Length)
//   -1:   no body framing (GET/HEAD/204/304 semantics — caller decides)
//   -2:   chunked (Phase G)
//   -3:   malformed Content-Length
fn body_length(h: &Headers) -> i64 {
    match h.get("transfer-encoding") {
        Option::Some(te) => {
            if (&te).eq_str("chunked") { return 0 - 2; }
        }
        Option::None => {}
    }
    match h.get("content-length") {
        Option::Some(cl) => {
            let p: *const u8 = (&cl).as_ptr();
            let n: i64 = (&cl).len();
            let v: i64 = parse_decimal(p, 0, n);
            if v < 0 { return 0 - 3; }
            return v;
        }
        Option::None => {}
    }
    return 0 - 1;
}

// ── Chunked transfer codec (RFC 7230 §4.1) ──────────────────────────────────

fn hex_digit_value(b: u8) -> i32 {
    if b >= 48 as u8 && b <= 57 as u8 { return (b as i32) - 48; }
    if b >= 97 as u8 && b <= 102 as u8 { return (b as i32) - 97 + 10; }
    if b >= 65 as u8 && b <= 70 as u8 { return (b as i32) - 65 + 10; }
    return 0 - 1;
}

unsafe fn write_hex_len(n: i64, out: *mut Vec<u8>) {
    if n == 0 { out.push(48 as u8); return; }
    let mut buf: [u8; 32] = [0 as u8; 32];
    let mut v: i64 = n;
    let mut k: i64 = 0;
    while v > 0 {
        let d: i64 = v & 15 as i64;
        if d < 10 { buf[k] = (d + 48) as u8; }
        else      { buf[k] = (d - 10 + 97) as u8; }     // lowercase a-f
        v = v >> 1 >> 1 >> 1 >> 1;                       // v / 16
        k = k + 1;
    }
    while k > 0 { k = k - 1; out.push(buf[k]); }
}

// Encode a body as a single chunk followed by the zero-length terminator.
// Suitable for simple "here is my whole body" use; callers wanting streaming
// can invoke chunked_write_chunk repeatedly and finish with chunked_finalize.
pub fn chunked_encode(data: *const u8, n: i64, out: &mut Vec<u8>) {
    unsafe {
        let op: *mut Vec<u8> = out;
        if n > 0 { chunked_write_chunk(data, n, op); }
        chunked_finalize(op);
    }
}

pub unsafe fn chunked_write_chunk(data: *const u8, n: i64, out: *mut Vec<u8>) {
    write_hex_len(n, out);
    out.push(13 as u8); out.push(10 as u8);
    let mut i: i64 = 0;
    while i < n { out.push(data[i]); i = i + 1; }
    out.push(13 as u8); out.push(10 as u8);
}

pub unsafe fn chunked_finalize(out: *mut Vec<u8>) {
    out.push(48 as u8);                                  // "0"
    out.push(13 as u8); out.push(10 as u8);
    out.push(13 as u8); out.push(10 as u8);              // trailer CRLF
}

// Decode chunked bytes [src, src+len) into `out`. Returns total input bytes
// consumed on success (up to and including final trailer CRLF), or -1 on
// malformed input. Trailer headers are ignored.
pub fn chunked_decode(src: *const u8, len: i64, out: &mut Vec<u8>) -> i64 {
    let mut pos: i64 = 0;
    unsafe {
        while true {
            // Parse hex size. Stop at CRLF or ';' (chunk-ext, ignored).
            let mut size: i64 = 0;
            let mut seen_digit: bool = false;
            while pos < len {
                let b: u8 = src[pos];
                if b == 13 as u8 || b == 59 as u8 { break; }
                let d: i32 = hex_digit_value(b);
                if d < 0 { return 0 - 1; }
                size = (size << 1 << 1 << 1 << 1) + (d as i64);
                seen_digit = true;
                pos = pos + 1;
            }
            if !seen_digit { return 0 - 1; }
            // Skip chunk-ext up to CRLF.
            while pos < len && src[pos] != 13 as u8 { pos = pos + 1; }
            if pos + 1 >= len || src[pos] != 13 as u8 || src[pos + 1] != 10 as u8 {
                return 0 - 1;
            }
            pos = pos + 2;
            if size == 0 {
                // Skip optional trailer headers until empty line.
                while true {
                    let le: i64 = find_crlf(src, len, pos);
                    if le < 0 { return 0 - 1; }
                    if le == pos { pos = le + 2; return pos; }
                    pos = le + 2;
                }
            }
            if pos + size + 2 > len { return 0 - 1; }
            let mut i: i64 = 0;
            while i < size {
                out.push(src[pos + i]);
                i = i + 1;
            }
            pos = pos + size;
            if src[pos] != 13 as u8 || src[pos + 1] != 10 as u8 { return 0 - 1; }
            pos = pos + 2;
        }
    }
    return pos;
}

// Parse an HTTP/1.1 request from [src, src+len). Body framing follows
// Content-Length, else Transfer-Encoding: chunked, else empty body.
pub fn parse_request_buf(src: *const u8, len: i64) -> Option<Request> {
    let line_end: i64 = find_crlf(src, len, 0);
    if line_end < 0 { return Option::None; }

    // Split request-line: METHOD SP TARGET SP HTTP/VERSION
    let mut sp1: i64 = 0 - 1;
    let mut sp2: i64 = 0 - 1;
    let mut i: i64 = 0;
    unsafe {
        while i < line_end {
            if src[i] == 32 as u8 {
                if sp1 < 0 { sp1 = i; } else if sp2 < 0 { sp2 = i; }
            }
            i = i + 1;
        }
    }
    if sp1 < 0 || sp2 < 0 { return Option::None; }

    let method_str: String = unsafe { String::from_bytes(src, sp1) };
    let target:     String = unsafe {
        String::from_bytes((src as i64 + sp1 + 1) as *const u8, sp2 - sp1 - 1)
    };

    let method: Method = method_parse(s2str(&method_str));
    // For now, wrap target in a minimal Url (scheme/host empty). Real clients
    // see absolute-form URIs only through proxies; origin-form "/path?q" is
    // typical. url_parse accepts absolute-form; for origin-form we store it
    // verbatim in `path`.
    let url: Url = match url_parse(s2str(&target)) {
        Option::Some(u) => u,
        Option::None    => {
            let tp: *const u8 = (&target).as_ptr();
            let tn: i64 = (&target).len();
            let mut qpos: i64 = 0 - 1;
            let mut k: i64 = 0;
            unsafe {
                while k < tn {
                    if tp[k] == 63 as u8 { qpos = k; k = tn; } else { k = k + 1; }
                }
            }
            let path_end: i64 = if qpos < 0 { tn } else { qpos };
            let path_s:  String = unsafe { String::from_bytes(tp, path_end) };
            let mut query_s: String = String::new();
            if qpos >= 0 {
                query_s = unsafe {
                    String::from_bytes((tp as i64 + qpos + 1) as *const u8, tn - qpos - 1)
                };
            }
            Url {
                scheme: String::new(),
                host:   String::new(),
                port:   0,
                path:   path_s,
                query:  query_s,
            }
        }
    };

    let mut req: Request = Request::new(method, url);
    let hdr_end: i64 = parse_headers(src, len, line_end + 2, &mut req.headers);
    if hdr_end < 0 { return Option::None; }

    let blen: i64 = body_length(&req.headers);
    if blen == 0 - 3 { return Option::None; }    // malformed CL
    if blen == 0 - 2 {
        // Chunked transfer-encoding.
        let tail_ptr: *const u8 = (src as i64 + hdr_end) as *const u8;
        let consumed: i64 = chunked_decode(tail_ptr, len - hdr_end, &mut req.body);
        if consumed < 0 { return Option::None; }
    } else if blen > 0 {
        if hdr_end + blen > len { return Option::None; }
        unsafe {
            copy_body(src, hdr_end, hdr_end + blen, &mut req.body);
        }
    }
    return Option::Some(req);
}

// Parse an HTTP/1.1 response from [src, src+len).
pub fn parse_response_buf(src: *const u8, len: i64) -> Option<Response> {
    let line_end: i64 = find_crlf(src, len, 0);
    if line_end < 0 { return Option::None; }

    // Status-line: "HTTP/1.1" SP STATUS SP REASON
    let mut sp1: i64 = 0 - 1;
    let mut sp2: i64 = 0 - 1;
    let mut i: i64 = 0;
    unsafe {
        while i < line_end {
            if src[i] == 32 as u8 {
                if sp1 < 0 { sp1 = i; } else if sp2 < 0 { sp2 = i; }
            }
            i = i + 1;
        }
    }
    if sp1 < 0 { return Option::None; }
    // sp2 may be absent if reason-phrase is empty (RFC allows it).
    let status_end: i64 = if sp2 < 0 { line_end } else { sp2 };
    let status: i64 = parse_decimal(src, sp1 + 1, status_end);
    if status < 0 { return Option::None; }

    let reason_start: i64 = if sp2 < 0 { line_end } else { sp2 + 1 };
    let reason: String = unsafe {
        String::from_bytes((src as i64 + reason_start) as *const u8,
                           line_end - reason_start)
    };

    let mut resp: Response = Response::new(status as i32);
    // Overwrite default reason with the parsed one.
    resp.reason.clear();
    resp.reason.push_str(s2str(&reason));

    let hdr_end: i64 = parse_headers(src, len, line_end + 2, &mut resp.headers);
    if hdr_end < 0 { return Option::None; }

    let blen: i64 = body_length(&resp.headers);
    if blen == 0 - 3 { return Option::None; }    // malformed CL
    if blen == 0 - 2 {
        let tail_ptr: *const u8 = (src as i64 + hdr_end) as *const u8;
        let consumed: i64 = chunked_decode(tail_ptr, len - hdr_end, &mut resp.body);
        if consumed < 0 { return Option::None; }
    } else if blen > 0 {
        if hdr_end + blen > len { return Option::None; }
        unsafe {
            copy_body(src, hdr_end, hdr_end + blen, &mut resp.body);
        }
    } else if blen == 0 - 1 {
        // No framing: read until end of buffer.
        if hdr_end < len {
            unsafe { copy_body(src, hdr_end, len, &mut resp.body); }
        }
    }
    return Option::Some(resp);
}

// ── Serialization ────────────────────────────────────────────────────────────

unsafe fn write_headers(h: &Headers, out: *mut Vec<u8>) {
    let ep: *mut Vec<Header> = &h.entries as *const Vec<Header> as *mut Vec<Header>;
    let total: i64 = ep.length();
    let mut i: i64 = 0;
    while i < total {
        let e: Header = ep.get(i);
        let np: *const u8 = ((&h.buf).as_ptr() as i64 + e.name_off as i64) as *const u8;
        let vp: *const u8 = ((&h.buf).as_ptr() as i64 + e.value_off as i64) as *const u8;
        let mut k: i64 = 0;
        while k < e.name_len as i64 { out.push(np[k]); k = k + 1; }
        out.push(58 as u8); out.push(32 as u8);          // ": "
        k = 0;
        while k < e.value_len as i64 { out.push(vp[k]); k = k + 1; }
        out.push(13 as u8); out.push(10 as u8);          // CRLF
        i = i + 1;
    }
    out.push(13 as u8); out.push(10 as u8);              // terminator CRLF
}

unsafe fn write_str_bytes(s: str, out: *mut Vec<u8>) {
    let p: *const u8 = s.as_ptr();
    let n: i64 = s.len();
    let mut i: i64 = 0;
    while i < n { out.push(p[i]); i = i + 1; }
}

unsafe fn write_i64_decimal(v: i64, out: *mut Vec<u8>) {
    if v == 0 { out.push(48 as u8); return; }
    let mut buf: [u8; 24] = [0 as u8; 24];
    let mut n: i64 = v;
    let mut k: i64 = 0;
    while n > 0 {
        buf[k] = ((n % 10) + 48) as u8;
        n = n / 10;
        k = k + 1;
    }
    while k > 0 {
        k = k - 1;
        out.push(buf[k]);
    }
}

// Serialize request in origin-form: "METHOD /path?query HTTP/1.1\r\n..."
pub fn serialize_request(req: &Request, out: &mut Vec<u8>) {
    unsafe {
        let op: *mut Vec<u8> = out;
        write_str_bytes(s2str(&req.method.name), op);
        op.push(32 as u8);                               // SP
        // origin-form target
        if (&req.url.path).len() == 0 {
            op.push(47 as u8);                           // '/'
        } else {
            write_str_bytes(s2str(&req.url.path), op);
        }
        if (&req.url.query).len() > 0 {
            op.push(63 as u8);                           // '?'
            write_str_bytes(s2str(&req.url.query), op);
        }
        op.push(32 as u8);
        write_str_bytes("HTTP/1.1", op);
        op.push(13 as u8); op.push(10 as u8);
        write_headers(&req.headers, op);
        // body
        let bp: *mut Vec<u8> = &req.body as *const Vec<u8> as *mut Vec<u8>;
        let bl: i64 = bp.length();
        let mut i: i64 = 0;
        while i < bl { op.push(bp.get(i)); i = i + 1; }
    }
}

pub fn serialize_response(resp: &Response, out: &mut Vec<u8>) {
    unsafe {
        let op: *mut Vec<u8> = out;
        write_str_bytes("HTTP/1.1 ", op);
        write_i64_decimal(resp.status as i64, op);
        op.push(32 as u8);
        write_str_bytes(s2str(&resp.reason), op);
        op.push(13 as u8); op.push(10 as u8);
        write_headers(&resp.headers, op);
        let bp: *mut Vec<u8> = &resp.body as *const Vec<u8> as *mut Vec<u8>;
        let bl: i64 = bp.length();
        let mut i: i64 = 0;
        while i < bl { op.push(bp.get(i)); i = i + 1; }
    }
}
