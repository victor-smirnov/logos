// Logos standard library — std.panic
//
// panic() — unrecoverable error: aborts execution (does not return).

package std.panic;

extern fn abort();

pub fn panic(msg: str) {
    // Call abort to halt execution.
    // In a real implementation, we would print the message first.
    abort();
}
