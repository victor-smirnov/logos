// Logos standard library -- std.url
//
// URL percent-encoding (RFC 3986).  Two variants:
//  * url_encode_component — encodes everything that isn't unreserved.
//                           Suitable for path segments and query values.
//  * url_encode_query_form — application/x-www-form-urlencoded style:
//                           space → '+'; otherwise like encode_component.

package std.url;

use std.string;

// unreserved: A-Z a-z 0-9 '-' '.' '_' '~'
fn is_unreserved(c: u8) -> bool {
    let ci: i32 = c as i32;
    if ci >= 65 && ci <= 90  { return true; }  // A-Z
    if ci >= 97 && ci <= 122 { return true; }  // a-z
    if ci >= 48 && ci <= 57  { return true; }  // 0-9
    if ci == 45 { return true; }               // '-'
    if ci == 46 { return true; }               // '.'
    if ci == 95 { return true; }               // '_'
    if ci == 126 { return true; }              // '~'
    return false;
}

fn hex_digit(n: u8) -> u8 {
    let ni: i32 = n as i32;
    if ni < 10 { return (ni + 48) as u8; }     // '0'..'9'
    return (ni - 10 + 65) as u8;               // 'A'..'F' (uppercase per RFC 3986 §2.1)
}

fn nibble_of(c: u8) -> i32 {
    let ci: i32 = c as i32;
    if ci >= 48 && ci <= 57  { return ci - 48; }
    if ci >= 65 && ci <= 70  { return ci - 65 + 10; }
    if ci >= 97 && ci <= 102 { return ci - 97 + 10; }
    return 0 - 1;
}

// Encode bytes [src, src+len) appending to `out` (percent-encoded where needed).
pub fn url_encode_component(src: *const u8, len: i64, out: &mut String) {
    unsafe {
        let mut i: i64 = 0 as i64;
        while i < len {
            let b: u8 = src[i];
            if is_unreserved(b) {
                out.push_u8(b);
            } else {
                out.push_u8(37 as u8);            // '%'
                out.push_u8(hex_digit((b >> 4 as u8) & 15 as u8));
                out.push_u8(hex_digit(b & 15 as u8));
            }
            i = i + 1 as i64;
        }
    }
}

pub fn url_encode_component_str(src: str, out: &mut String) {
    unsafe { url_encode_component(src.as_ptr(), src.len(), out); }
}

// form-urlencoded: same as component but space (0x20) becomes '+'.
pub fn url_encode_query_form(src: *const u8, len: i64, out: &mut String) {
    unsafe {
        let mut i: i64 = 0 as i64;
        while i < len {
            let b: u8 = src[i];
            if b == 32 as u8 {
                out.push_u8(43 as u8);            // '+'
            } else if is_unreserved(b) {
                out.push_u8(b);
            } else {
                out.push_u8(37 as u8);
                out.push_u8(hex_digit((b >> 4 as u8) & 15 as u8));
                out.push_u8(hex_digit(b & 15 as u8));
            }
            i = i + 1 as i64;
        }
    }
}

pub fn url_encode_query_form_str(src: str, out: &mut String) {
    unsafe { url_encode_query_form(src.as_ptr(), src.len(), out); }
}

// Decode percent-encoded bytes.  If `plus_is_space` is true, '+' becomes ' '
// (form-urlencoded mode).  Returns number of bytes appended, or -1 on
// malformed input (stray '%', non-hex digit).
pub fn url_decode(src: *const u8, len: i64, out: &mut String, plus_is_space: bool) -> i64 {
    unsafe {
        let mut i: i64 = 0 as i64;
        let mut produced: i64 = 0 as i64;
        while i < len {
            let b: u8 = src[i];
            if b == 37 as u8 {                     // '%'
                if (i + 2 as i64) >= len { return 0 - 1 as i64; }
                let hi: i32 = nibble_of(src[i + 1 as i64]);
                let lo: i32 = nibble_of(src[i + 2 as i64]);
                if hi < 0 { return 0 - 1 as i64; }
                if lo < 0 { return 0 - 1 as i64; }
                out.push_u8(((hi << 4) | lo) as u8);
                i = i + 3 as i64;
            } else if plus_is_space && b == 43 as u8 {
                out.push_u8(32 as u8);
                i = i + 1 as i64;
            } else {
                out.push_u8(b);
                i = i + 1 as i64;
            }
            produced = produced + 1 as i64;
        }
        return produced;
    }
}

pub fn url_decode_str(src: str, out: &mut String) -> i64 {
    unsafe { return url_decode(src.as_ptr(), src.len(), out, false); }
}

pub fn url_decode_form_str(src: str, out: &mut String) -> i64 {
    unsafe { return url_decode(src.as_ptr(), src.len(), out, true); }
}
