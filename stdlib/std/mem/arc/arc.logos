// Logos standard library — std.arc
//
// Arc<T: Send + Sync> — atomically reference-counted smart pointer.
// Safe to clone and share across threads; T must be Send + Sync.
//
// The strong counter is an AtomicI32 using LOCK XADD / LOCK CMPXCHG.
// When the last handle drops (fetch_sub returns 1), the inner block is freed.
//
// No weak references in this version.
//
// Usage:
//   let a1: Arc<i32> = arc_new::<i32>(0);
//   let a2: Arc<i32> = a1.clone_arc();
//   // share a2 with another thread via FutureSlot / channel ...
//   let v: *const i32 = a1.get();
//   a1.drop_arc();   // does NOT free (a2 still alive)
//   a2.drop_arc();   // frees inner block

package std.mem.arc;

use std.mem;
use std.sync.atomic;
use std.lang.marker;
use std.lang.drop;

// ── Internal heap block ───────────────────────────────────────────────────────

struct ArcInner<T> {
    val:    T,
    strong: AtomicI32,
}

// ── Arc<T: Send + Sync> ───────────────────────────────────────────────────────

pub struct Arc<T> {
    inner: *mut ArcInner<T>,
}

pub fn arc_new<T: Send + Sync>(val: T) -> Arc<T> {
    let inner: *mut ArcInner<T> = alloc(sizeof::<ArcInner<T>>()) as *mut ArcInner<T>;
    unsafe {
        inner.val    = val;
        inner.strong = atomic_i32_new(1);
    }
    return Arc { inner: inner };
}

impl<T: Send + Sync> Arc<T> {
    // Immutable access to the contained value.
    pub unsafe fn get(self: *mut Arc<T>) -> *const T {
        return &self.inner.val as *const T;
    }

    // Reference-returning accessors. The inner block is heap-stable
    // for the lifetime of any Arc handle; mirror the `&self`/`&mut self`
    // shape Rc<T> already exposes so callers don't have to launder
    // through raw-pointer self.
    pub fn deref(&self) -> &T {
        unsafe { return &self.inner.val; }
    }

    // NOTE: `&mut self` access through an Arc is sound only because
    // we don't hand out concurrent &mut references — Arc is meant for
    // shared ownership across threads, and any cross-thread interior
    // mutation should use the proper sync primitives on T (Mutex,
    // atomics) which take &T. Here, `deref_mut` is the convenient
    // single-thread escape hatch used by stdlib (mostly the persistent
    // store handle code) where the caller has exclusive use.
    pub fn deref_mut(&mut self) -> &mut T {
        unsafe { return &mut self.inner.val; }
    }

    pub unsafe fn strong_count(self: *mut Arc<T>) -> i32 {
        return (&self.inner.strong).load();
    }

    pub unsafe fn is_null(self: *mut Arc<T>) -> bool {
        return self.inner == 0 as *mut ArcInner<T>;
    }

    // Atomically increment the strong count; return a second handle.
    pub unsafe fn clone_arc(self: *mut Arc<T>) -> Arc<T> {
        (&mut self.inner.strong).fetch_add(1);
        return Arc { inner: self.inner };
    }

    // Same, taking `&mut self` instead of raw self pointer. Modern
    // call sites prefer this — same semantics, no caller-side raw
    // cast.
    pub fn clone_ref(&mut self) -> Arc<T> {
        unsafe {
            let p: *mut Arc<T> = self as *mut Arc<T>;
            return p.clone_arc();
        }
    }

    // Atomically decrement; free the inner block when the count reaches zero.
    pub unsafe fn drop_arc(self: *mut Arc<T>) {
        if self.inner == 0 as *mut ArcInner<T> { return; }
        // fetch_sub returns the OLD value; old == 1 means we went 1 → 0.
        let prev: i32 = (&mut self.inner.strong).fetch_sub(1);
        if prev == 1 {
            dealloc(self.inner as *mut u8);
        }
        self.inner = 0 as *mut ArcInner<T>;
    }
}

