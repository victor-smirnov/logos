// logos.std.compiler.metaprog — owning view over the user's AST document.
//
// HERMES2 PORT (cut-over step 4): the AST the compiler now hands metaprog hooks
// is a writ2 document — 8-byte SELF-RELATIVE HAny slots inside HMap<Hu6,HAny>
// TinyObjectMaps — NOT the old Writ1 4-byte base-relative AnyVal. So the read
// layer is rebuilt on the writ2 Logos containers (HAny / HMap / HArray / HString)
// and the `WritRead` trait + base-relative `AnyVal{raw:u32}` are dropped.
//
// Navigation model: the dispatcher hands a hook a flat `item_offset` into the AST
// doc's single segment; `node_at(offset)` turns it into a node HANDLE
// (`HAny::Ref(base + offset)`). From there every step is `HAny::resolve()`
// (position-independent, no base) → the child object's absolute pointer. So a node
// handle is just a value-form HAny Ref; reading a field is resolve → HMap.get.
//
// OView still owns a retained ref to the host MemHolder (released on Drop); the
// host layout is opaque (atomic RC + Arena), reached only via the two extern fns.

package logos.std.compiler.metaprog;

use logos.lang.writ.anyval;     // HAny
use logos.lang.writ.hmap;       // HMap<Hu6, HAny>
use logos.lang.writ.array;      // HArray<HAny>
use logos.lang.writ.hstring;    // HString
use logos.mem.string;
use logos.lang.str;

// ── Host runtime hooks ─────────────────────────────────────────────────────
//
// `logos_get_module_ast_oview` fills (holder, base, size) from the trigger's
// AST document and bumps the holder RC by one (OView Drop releases it).

extern fn logos_get_module_ast_oview(out_holder: *mut *mut u8,
                                     out_base:   *mut *const u8,
                                     out_size:   *mut u64) -> ();

extern fn logos_holder_release(holder: *mut u8) -> ();

// ── Borrowed string bytes (was logos.lang.writ.view::SView) ──────────
pub struct SView {
    pub ptr: *const u8,
    pub len: u64,
}

impl Copy for SView {}

// ── OView ─────────────────────────────────────────────────────────────────

pub struct OView {
    pub holder: *mut u8,
    pub base:   *const u8,
    pub size:   u64,
}

// Acquire a retained view of the trigger's AST document. `holder` is null when
// no document is loaded — callers branch on that before using `base`.
pub fn oview_module_ast() -> OView {
    let mut holder: *mut u8   = 0 as *mut u8;
    let mut base:   *const u8 = 0 as *const u8;
    let mut size:   u64       = 0;
    unsafe {
        logos_get_module_ast_oview(&mut holder as *mut *mut u8,
                                   &mut base   as *mut *const u8,
                                   &mut size   as *mut u64);
    }
    return OView { holder: holder, base: base, size: size };
}

impl Drop for OView {
    fn drop(self: OView) {
        if self.holder != (0 as *mut u8) {
            unsafe { logos_holder_release(self.holder); }
        }
    }
}

// ── writ2 read primitives ─────────────────────────────────────────────────
//
// A node handle is a value-form HAny whose resolve() is the node's absolute
// address. `node_at` builds one from a flat arena offset (dispatcher / root walk);
// every other accessor follows Refs via resolve(), never `base + offset`.
impl OView {
    pub fn base_ptr(self: &OView) -> *const u8 { return self.base; }

    // Wrap a flat arena offset (the only base+offset step) into a node handle.
    pub fn node_at(self: &OView, offset: u32) -> HAny {
        return HAny::Ref((self.base as i64 + offset as i64) as *const u8);
    }

    // The document root HAny. DocumentHeader = { HAny root } at base+0; the at-rest
    // root word is self-relative to base, so materialize it: Ref → base + delta,
    // Pod → verbatim, 0 → null.
    pub fn root(self: &OView) -> HAny {
        let w: i64 = unsafe { *(self.base as *const i64) };
        if w == 0i64 { return HAny::Ref(0i64 as *const u8); }
        if (w & 1i64) == 1i64 {
            return HAny::Pod(w as u64);
        }
        return HAny::Ref((self.base as i64 + w) as *const u8);
    }

    // TinyObjectMap field read: `node` (Ref to a HMap<Hu6,HAny>) → key → HAny.
    // Null/non-ref node, or absent key, yields a null HAny.
    pub fn tiny_map_get(self: &OView, node: HAny, key: u8) -> HAny {
        if !node.is_ref() { return HAny::Ref(0i64 as *const u8); }
        let p: *const u8 = node.resolve();
        if p == (0 as *const u8) { return HAny::Ref(0i64 as *const u8); }
        return unsafe { (&*(p as *const HMap<Hu6, HAny>)).get(key) };
    }

    // Borrowed UTF-8 bytes of a string node (Ref to HString). Empty view if `v`
    // is null/non-ref.
    pub fn get_str_view(self: &OView, v: HAny) -> SView {
        if !v.is_ref() { return SView { ptr: 0 as *const u8, len: 0 as u64 }; }
        let p: *const u8 = v.resolve();
        if p == (0 as *const u8) { return SView { ptr: 0 as *const u8, len: 0 as u64 }; }
        let s: str = unsafe { (&*(p as *const HString)).as_str() };
        return SView { ptr: s.as_ptr(), len: s.len() as u64 };
    }

    // Array length / element. `v` is a Ref to HArray<HAny>; null/non-ref → 0 / null.
    pub fn array_len(self: &OView, v: HAny) -> u64 {
        if !v.is_ref() { return 0 as u64; }
        let p: *const u8 = v.resolve();
        if p == (0 as *const u8) { return 0 as u64; }
        return unsafe { (&*(p as *const HArray<HAny>)).len() as u64 };
    }

    pub fn array_get(self: &OView, v: HAny, idx: u64) -> HAny {
        if !v.is_ref() { return HAny::Ref(0i64 as *const u8); }
        let p: *const u8 = v.resolve();
        if p == (0 as *const u8) { return HAny::Ref(0i64 as *const u8); }
        return unsafe { (&*(p as *const HArray<HAny>)).get(idx as i64) };
    }

    // Inline scalar reads (Pod HAny). Non-pod → 0 / false.
    pub fn get_int(self: &OView, v: HAny) -> i64 {
        if v.is_pod() { return v.as_i56(); }
        return 0i64;
    }
    pub fn get_i64(self: &OView, v: HAny) -> i64 { return self.get_int(v); }
    pub fn get_u64(self: &OView, v: HAny) -> u64 { return self.get_int(v) as u64; }
    pub fn get_bool(self: &OView, v: HAny) -> bool {
        if v.is_pod() { return v.as_bool(); }
        return false;
    }
}
