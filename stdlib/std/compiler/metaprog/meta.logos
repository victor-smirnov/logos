// SPDX-License-Identifier: Apache-2.0
// std.compiler.metaprog.meta — B-side metafunctions over runtime Type lists.
//
// Pure Logos library on top of the introspection intrinsics
// (`type_refs_of::<T...>()`, `type_of::<T>()`). Each function takes a
// pack `<T...>` and a `fn(Type) -> ?` predicate / mapper, materializes
// the pack as `[Type; N]`, and folds via index-based iteration bounded
// by `sizeof...(T)`.
//
// Generic-N iteration uses `sizeof...(T)` as the loop bound rather than
// a `[Type; N]`-method `len()` (fixed-size arrays don't carry a runtime
// length API; the bound is a compile-time constant per instantiation).

package std.compiler.metaprog;

// ── Kind predicates (over the `t.kind` tag) ────────────────────────────
//
// Kind tag values mirror `LogosType::Kind` from
// `include/logos/compiler/sema.hpp`:
//   Void=0, I32=1, I64=2, F64=3, F32=4, Bool=5, U8=6,
//   I8=7, I16=8, U16=9, U32=10, U64=11,
//   I24=12, U24=13, I56=14, U56=15, I128=16, U128=17,
//   Ptr=18, Ref=19, MutRef=20, Array=21,
//   Struct=22, ZonedStruct=23, Enum=24, ...
//
// Exposing them as `fn(Type) -> bool` lets user code feed predicates into
// any of the B-folds above without re-deriving magic numbers each time.

pub fn is_void(t: Type) -> bool { return t.kind == (0 as u32); }

pub fn is_bool_kind(t: Type) -> bool { return t.kind == (5 as u32); }

pub fn is_integer(t: Type) -> bool {
    let k: u32 = t.kind;
    return k == (1 as u32)  || k == (2 as u32)  || k == (6 as u32)
        || k == (7 as u32)  || k == (8 as u32)  || k == (9 as u32)
        || k == (10 as u32) || k == (11 as u32)
        || k == (12 as u32) || k == (13 as u32)
        || k == (14 as u32) || k == (15 as u32)
        || k == (16 as u32) || k == (17 as u32);
}

pub fn is_float_kind(t: Type) -> bool {
    return t.kind == (3 as u32) || t.kind == (4 as u32);
}

pub fn is_primitive_kind(t: Type) -> bool {
    let k: u32 = t.kind;
    return k == (1 as u32)  || k == (2 as u32)  || k == (3 as u32)
        || k == (4 as u32)  || k == (5 as u32)  || k == (6 as u32)
        || k == (7 as u32)  || k == (8 as u32)  || k == (9 as u32)
        || k == (10 as u32) || k == (11 as u32)
        || k == (12 as u32) || k == (13 as u32)
        || k == (14 as u32) || k == (15 as u32)
        || k == (16 as u32) || k == (17 as u32);
}

pub fn is_struct(t: Type) -> bool {
    return t.kind == (22 as u32) || t.kind == (23 as u32);
}

pub fn is_enum(t: Type) -> bool { return t.kind == (24 as u32); }

pub fn is_pointer(t: Type) -> bool {
    let k: u32 = t.kind;
    return k == (18 as u32) || k == (19 as u32) || k == (20 as u32);
}

pub fn is_array(t: Type) -> bool { return t.kind == (21 as u32); }

// Count pack members for which `pred` returns true.
pub fn count_if<T...>(pred: fn(Type) -> bool) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut c: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        if pred(arr[i]) { c = c + (1 as i64); }
        i = i + (1 as i64);
    }
    return c;
}

// True iff every pack member satisfies `pred` (vacuously true on empty pack).
pub fn all<T...>(pred: fn(Type) -> bool) -> bool {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut i: i64 = 0;
    while i < n {
        if !pred(arr[i]) { return false; }
        i = i + (1 as i64);
    }
    return true;
}

// True iff any pack member satisfies `pred` (false on empty pack).
pub fn any<T...>(pred: fn(Type) -> bool) -> bool {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut i: i64 = 0;
    while i < n {
        if pred(arr[i]) { return true; }
        i = i + (1 as i64);
    }
    return false;
}

// Sum of `proj(t)` over the pack — handy for total size, alignment, etc.
pub fn sum_by<T...>(proj: fn(Type) -> i64) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        s = s + proj(arr[i]);
        i = i + (1 as i64);
    }
    return s;
}

// Index of the first pack member satisfying `pred`, or -1 if none.
pub fn find_index<T...>(pred: fn(Type) -> bool) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut i: i64 = 0;
    while i < n {
        if pred(arr[i]) { return i; }
        i = i + (1 as i64);
    }
    return -1 as i64;
}

// Index of the pack member maximising `proj`, or -1 on empty pack.
// Ties resolve to the lowest index.
pub fn argmax_by<T...>(proj: fn(Type) -> i64) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    if n == (0 as i64) { return -1 as i64; }
    let mut best: i64 = 0;
    let mut best_v: i64 = proj(arr[0]);
    let mut i: i64 = 1;
    while i < n {
        let v: i64 = proj(arr[i]);
        if v > best_v { best_v = v; best = i; }
        i = i + (1 as i64);
    }
    return best;
}

// Index of the pack member minimising `proj`, or -1 on empty pack.
// Ties resolve to the lowest index.
pub fn argmin_by<T...>(proj: fn(Type) -> i64) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    if n == (0 as i64) { return -1 as i64; }
    let mut best: i64 = 0;
    let mut best_v: i64 = proj(arr[0]);
    let mut i: i64 = 1;
    while i < n {
        let v: i64 = proj(arr[i]);
        if v < best_v { best_v = v; best = i; }
        i = i + (1 as i64);
    }
    return best;
}
