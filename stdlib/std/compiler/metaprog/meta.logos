// SPDX-License-Identifier: Apache-2.0
// std.compiler.metaprog.meta — B-side metafunctions over runtime Type lists.
//
// Pure Logos library on top of the introspection intrinsics
// (`type_refs_of::<T...>()`, `type_of::<T>()`). Each function takes a
// pack `<T...>` and a `fn(Type) -> ?` predicate / mapper, materializes
// the pack as `[Type; N]`, and folds via index-based iteration bounded
// by `sizeof...(T)`.
//
// Generic-N iteration uses `sizeof...(T)` as the loop bound rather than
// a `[Type; N]`-method `len()` (fixed-size arrays don't carry a runtime
// length API; the bound is a compile-time constant per instantiation).

package std.compiler.metaprog;

// ── Kind tag → printable name ──────────────────────────────────────────
//
// Diagnostic aid for metaprograms: turn a `t.kind` tag into a short
// printable string. Mirrors `LogosType::Kind` enum order from
// `include/logos/compiler/sema.hpp`. Unknown tags → "?".
pub fn kind_name(k: u32) -> &[u8] {
    if k == (0 as u32)  { return "Void"; }
    if k == (1 as u32)  { return "i32"; }
    if k == (2 as u32)  { return "i64"; }
    if k == (3 as u32)  { return "f64"; }
    if k == (4 as u32)  { return "f32"; }
    if k == (5 as u32)  { return "bool"; }
    if k == (6 as u32)  { return "u8"; }
    if k == (7 as u32)  { return "i8"; }
    if k == (8 as u32)  { return "i16"; }
    if k == (9 as u32)  { return "u16"; }
    if k == (10 as u32) { return "u32"; }
    if k == (11 as u32) { return "u64"; }
    if k == (12 as u32) { return "i24"; }
    if k == (13 as u32) { return "u24"; }
    if k == (14 as u32) { return "i56"; }
    if k == (15 as u32) { return "u56"; }
    if k == (16 as u32) { return "i128"; }
    if k == (17 as u32) { return "u128"; }
    if k == (18 as u32) { return "Ptr"; }
    if k == (19 as u32) { return "Ref"; }
    if k == (20 as u32) { return "MutRef"; }
    if k == (21 as u32) { return "Array"; }
    if k == (22 as u32) { return "Struct"; }
    if k == (23 as u32) { return "ZonedStruct"; }
    if k == (24 as u32) { return "Enum"; }
    return "?";
}

// ── Byte-slice equality (used by name lookups) ─────────────────────────
//
// Stand-alone so callers don't pull a heavier dep just for "is this
// field named X". Bound to the specific shape (`a == b` byte-wise).
pub fn name_eq(a: &[u8], b: &[u8]) -> bool {
    let na = a.len();
    let nb = b.len();
    if na != nb { return false; }
    let mut i: i64 = 0;
    while i < na {
        if a[i] != b[i] { return false; }
        i = i + (1 as i64);
    }
    return true;
}

// ── A-side typelist ops (length / head) ────────────────────────────────
//
// Free-fn wrappers exposing `length` / `head` directly over a `<T...>`
// pack — the taxonomy calls these "A-layer" (structural) ops, in
// contrast to the B-layer `count_if`/`all`/`any`/etc above which take a
// runtime `[Type; N]` and a closure. Both layers coexist in the
// Hana/MP11 design.
//
// Implementation: these wrap the B-side primitives `sizeof...(T)` and
// `type_refs_of::<T...>()[0]` rather than the `typelist_*::<L>` keyword
// intrinsics — pack-`T...` substitution into a nested generic position
// (e.g. `typelist_len::<TypeList<T...>>()` inside a generic wrapper)
// doesn't fully expand at the moment; the wrapper would see a 1-arg
// TypeList. Closing that gap is a separate compiler fix; until then
// these direct-pack wrappers are the stable A-side surface.
//
// `nth` is intentionally not wrapped: the keyword form
// `typelist_nth::<L>(i)` requires `i` to be a *literal* int (a wrapper
// parameter becomes a VarRef). `tail` is also not wrapped: its
// return type `[Type; N-1]` is retyped at the call site by mono and
// a free-fn signature would freeze it to a fixed-size placeholder.
// Use the keyword forms directly for those.

// Pack length (compile-time constant; folds to a `lit_int`).
pub fn length<T...>() -> i64 {
    return sizeof...(T) as i64;
}

// First pack element. Calling on an empty pack hits the array
// out-of-range path of the B-side intrinsic.
pub fn head<T...>() -> Type {
    let arr = type_refs_of::<T...>();
    return arr[0];
}

// Left fold over the pack: starting from `init`, apply
// `f(acc, T_i)` for each pack member in declaration order. Returns
// the final accumulated `Type`. Useful for "build a type by reducing
// over a pack" style metafunctions — e.g. picking a wider numeric
// kind, or combining tag bits.
//
// Map `f` over the pack and return the resulting `[Type; sizeof...(T)]`
// array. The result-length parameter rides on the `sizeof...(T)` size
// form admitted by `arr_type` (see memory feat_arr_type_sizeof_pack_gap),
// so each instantiation gets a concrete-length array. Pairs naturally
// with `type_refs_of` and the per-pack-element folds below.
pub fn transform<T...>(f: fn(Type) -> Type) -> [Type; sizeof...(T)] {
    let mut arr: [Type; sizeof...(T)] = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut i: i64 = 0;
    while i < n {
        arr[i] = f(arr[i]);
        i = i + (1 as i64);
    }
    return arr;
}

// `filter<T...>` would also return a Type-array but its length depends
// on the predicate's runtime result; that needs const generics for the
// result-length parameter and remains pending.
pub fn fold_to_type<T...>(init: Type, f: fn(Type, Type) -> Type) -> Type {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut acc: Type = init;
    let mut i: i64 = 0;
    while i < n {
        acc = f(acc, arr[i]);
        i = i + (1 as i64);
    }
    return acc;
}

// ── Kind predicates (over the `t.kind` tag) ────────────────────────────
//
// Kind tag values mirror `LogosType::Kind` from
// `include/logos/compiler/sema.hpp`:
//   Void=0, I32=1, I64=2, F64=3, F32=4, Bool=5, U8=6,
//   I8=7, I16=8, U16=9, U32=10, U64=11,
//   I24=12, U24=13, I56=14, U56=15, I128=16, U128=17,
//   Ptr=18, Ref=19, MutRef=20, Array=21,
//   Struct=22, ZonedStruct=23, Enum=24, ...
//
// Exposing them as `fn(Type) -> bool` lets user code feed predicates into
// any of the B-folds above without re-deriving magic numbers each time.

pub fn is_void(t: Type) -> bool { return t.kind == (0 as u32); }

pub fn is_bool_kind(t: Type) -> bool { return t.kind == (5 as u32); }

pub fn is_integer(t: Type) -> bool {
    let k: u32 = t.kind;
    return k == (1 as u32)  || k == (2 as u32)  || k == (6 as u32)
        || k == (7 as u32)  || k == (8 as u32)  || k == (9 as u32)
        || k == (10 as u32) || k == (11 as u32)
        || k == (12 as u32) || k == (13 as u32)
        || k == (14 as u32) || k == (15 as u32)
        || k == (16 as u32) || k == (17 as u32);
}

pub fn is_float_kind(t: Type) -> bool {
    return t.kind == (3 as u32) || t.kind == (4 as u32);
}

pub fn is_primitive_kind(t: Type) -> bool {
    let k: u32 = t.kind;
    return k == (1 as u32)  || k == (2 as u32)  || k == (3 as u32)
        || k == (4 as u32)  || k == (5 as u32)  || k == (6 as u32)
        || k == (7 as u32)  || k == (8 as u32)  || k == (9 as u32)
        || k == (10 as u32) || k == (11 as u32)
        || k == (12 as u32) || k == (13 as u32)
        || k == (14 as u32) || k == (15 as u32)
        || k == (16 as u32) || k == (17 as u32);
}

pub fn is_struct(t: Type) -> bool {
    return t.kind == (22 as u32) || t.kind == (23 as u32);
}

pub fn is_enum(t: Type) -> bool { return t.kind == (24 as u32); }

pub fn is_pointer(t: Type) -> bool {
    let k: u32 = t.kind;
    return k == (18 as u32) || k == (19 as u32) || k == (20 as u32);
}

pub fn is_array(t: Type) -> bool { return t.kind == (21 as u32); }

// Count pack members for which `pred` returns true.
pub fn count_if<T...>(pred: fn(Type) -> bool) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut c: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        if pred(arr[i]) { c = c + (1 as i64); }
        i = i + (1 as i64);
    }
    return c;
}

// True iff every pack member satisfies `pred` (vacuously true on empty pack).
pub fn all<T...>(pred: fn(Type) -> bool) -> bool {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut i: i64 = 0;
    while i < n {
        if !pred(arr[i]) { return false; }
        i = i + (1 as i64);
    }
    return true;
}

// True iff any pack member satisfies `pred` (false on empty pack).
pub fn any<T...>(pred: fn(Type) -> bool) -> bool {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut i: i64 = 0;
    while i < n {
        if pred(arr[i]) { return true; }
        i = i + (1 as i64);
    }
    return false;
}

// Sum of `proj(t)` over the pack — handy for total size, alignment, etc.
pub fn sum_by<T...>(proj: fn(Type) -> i64) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        s = s + proj(arr[i]);
        i = i + (1 as i64);
    }
    return s;
}

// Generic fold over the pack with an i64 accumulator. Polymorphic-S
// fold awaits closure-arg generics; i64 covers the common cases
// (counts, sums, max, layout offsets) directly.
pub fn fold_i64<T...>(init: i64, step: fn(i64, Type) -> i64) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut acc: i64 = init;
    let mut i: i64 = 0;
    while i < n {
        acc = step(acc, arr[i]);
        i = i + (1 as i64);
    }
    return acc;
}

// Largest `proj(t)` over the pack (i64::MIN on empty pack).
pub fn max_by<T...>(proj: fn(Type) -> i64) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    if n == (0 as i64) { return -9223372036854775808 as i64; }
    let mut best: i64 = proj(arr[0]);
    let mut i: i64 = 1;
    while i < n {
        let v: i64 = proj(arr[i]);
        if v > best { best = v; }
        i = i + (1 as i64);
    }
    return best;
}

// Smallest `proj(t)` over the pack (i64::MAX on empty pack).
pub fn min_by<T...>(proj: fn(Type) -> i64) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    if n == (0 as i64) { return 9223372036854775807 as i64; }
    let mut best: i64 = proj(arr[0]);
    let mut i: i64 = 1;
    while i < n {
        let v: i64 = proj(arr[i]);
        if v < best { best = v; }
        i = i + (1 as i64);
    }
    return best;
}

// Index of the first pack member satisfying `pred`, or -1 if none.
pub fn find_index<T...>(pred: fn(Type) -> bool) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    let mut i: i64 = 0;
    while i < n {
        if pred(arr[i]) { return i; }
        i = i + (1 as i64);
    }
    return -1 as i64;
}

// Index of the pack member maximising `proj`, or -1 on empty pack.
// Ties resolve to the lowest index.
pub fn argmax_by<T...>(proj: fn(Type) -> i64) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    if n == (0 as i64) { return -1 as i64; }
    let mut best: i64 = 0;
    let mut best_v: i64 = proj(arr[0]);
    let mut i: i64 = 1;
    while i < n {
        let v: i64 = proj(arr[i]);
        if v > best_v { best_v = v; best = i; }
        i = i + (1 as i64);
    }
    return best;
}

// Index of the pack member minimising `proj`, or -1 on empty pack.
// Ties resolve to the lowest index.
pub fn argmin_by<T...>(proj: fn(Type) -> i64) -> i64 {
    let arr = type_refs_of::<T...>();
    let n: i64 = sizeof...(T) as i64;
    if n == (0 as i64) { return -1 as i64; }
    let mut best: i64 = 0;
    let mut best_v: i64 = proj(arr[0]);
    let mut i: i64 = 1;
    while i < n {
        let v: i64 = proj(arr[i]);
        if v < best_v { best_v = v; best = i; }
        i = i + (1 as i64);
    }
    return best;
}
