// SPDX-License-Identifier: Apache-2.0
// std.compiler.metaprog — derive(BranchNodeMP) — slice-1d.
//
// Hook for `#[derive_branch_node]` on a LeafNode-shaped struct. Emits
// a sibling `BranchNodeMP<K, STORE_CFG, CFG>` whose layout mirrors the
// existing hand-written std.data.persistent.cow.BranchNode plus one
// aggregate column per supported op.
//
// Slice-1d: the op-list is READ from a user-declared const named
// `BRANCH_OPS`, an array of `str` alternating field-name / elem-type:
//
//   pub const BRANCH_OPS: [str; 2] = ["sizes", "u64"];
//
//   #[derive_branch_node]
//   pub struct LeafNode<...> { ... }
//
// → emit `BranchNodeMP<...> { ..., pub sizes: PrimVec<u64> }`.
//
// Adding an op = appending two strings to BRANCH_OPS, no handler edit.
// Slice 1e will promote the const-name discovery to an attribute arg
// (`#[derive_branch_node(ops = "BRANCH_OPS")]`) and explore the move
// to nested HermesStatic for richer op specs (leaf-reduce / branch-
// reduce fn names).

package std.compiler.metaprog;

use std.collections.vec;
use std.hermes.view;
use std.hermes.anyval;
use std.hermes.string;
use std.lang.datatypes;
use std.data.persistent.node;

#[metaprog_handler("derive_branch_node")]
fn derive_branch_node_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: AnyVal = AnyVal::from_offset(target_offset);
    let nm_sv: StringView = view.ast_node_name(item);
    if nm_sv.len == (0 as u64) { return; }

    // Read leaf type-param names. Convention: [K, V, STORE_CFG, CFG].
    let np: u64 = view.ast_type_param_count(item);
    if np < (4 as u64) { return; }

    let k_sv:    StringView = view.ast_type_param_name(item, 0 as u64);
    let scfg_sv: StringView = view.ast_type_param_name(item, 2 as u64);
    let cfg_sv:  StringView = view.ast_type_param_name(item, 3 as u64);

    let k:    Ident = Ident { ptr: k_sv.ptr,    len: k_sv.len };
    let scfg: Ident = Ident { ptr: scfg_sv.ptr, len: scfg_sv.len };
    let cfg:  Ident = Ident { ptr: cfg_sv.ptr,  len: cfg_sv.len };

    // Op-list discovery: look up user's BRANCH_OPS const by name and
    // walk its ARR_LIT VALUE. Each pair of strings (field, elem-type)
    // becomes one aggregate column.
    let mut col_names: Vec<Ident> = vec_new::<Ident>();
    let mut col_types: Vec<Ident> = vec_new::<Ident>();

    let ops_name: [u8; 10] = [
        66u8, 82u8, 65u8, 78u8, 67u8, 72u8, 95u8, 79u8, 80u8, 83u8,
    ];                       // "BRANCH_OPS"
    let ops_const: AnyVal = view.find_template_decl(&ops_name);
    if ops_const.raw != 0 {
        let arr_lit: AnyVal = view.tiny_map_get(ops_const, 7 as u8);   // VALUE
        if arr_lit.raw != 0 {
            let items: AnyVal = view.tiny_map_get(arr_lit, 2 as u8);   // ITEMS
            if items.raw != 0 {
                let n: u64 = view.array_len(items);
                let mut i: u64 = 0u64;
                while i < n {
                    let elem: AnyVal = view.array_get(items, i);
                    let s_av: AnyVal = view.tiny_map_get(elem, 7 as u8);  // VALUE of HERMES_STR
                    let sv: StringView = view.get_str_view(s_av);
                    // HERMES_STR.VALUE captures the STRING token with surrounding
                    // quotes; sema's C++ consumers strip them. Replicate here:
                    // ptr+1 / len-2 yields the unquoted byte view (zero escape
                    // handling for slice 1d — op specs are ascii ident-like).
                    if sv.len >= (2 as u64) {
                        let id: Ident = Ident {
                            ptr: (sv.ptr as i64 + 1i64) as *const u8,
                            len: sv.len - (2 as u64),
                        };
                        unsafe {
                            if i % (2 as u64) == (0 as u64) {
                                (&mut col_names as *mut Vec<Ident>).push(id);
                            } else {
                                (&mut col_types as *mut Vec<Ident>).push(id);
                            }
                        }
                    }
                    i = i + (1 as u64);
                }
            }
        }
    }

    let blob: QuoteItemBlob = quote_item! {
        pub struct BranchNodeMP<#k: Container + ContainerOrd, const #scfg: HermesStatic, const #cfg: HermesStatic> {
            pub base:     NodeBase<#scfg>,
            pub keys:     Buffer<#k>,
            pub children: Vec<NodeARC<#scfg>>,
            #( pub #col_names: PrimVec<#col_types> ),*
        }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}
