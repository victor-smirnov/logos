// logos.std.compiler.metaprog — untyped-AST helpers for hook handlers.
//
// HERMES2 PORT (cut-over step 4): node handles are hermes2 `HAny` (8-byte
// self-relative; value-form holds the resolved absolute ptr), read through the
// OView primitives in oview.logos (tiny_map_get / get_str_view / array_* on
// HMap<Hu6,HAny> / HArray<HAny> / HString). The old Hermes1 4-byte AnyVal{raw}
// + base-relative `base + offset` model is gone.
//
// Hooks fire pre-sema: the AST is freshly parsed TinyObjectMap nodes keyed by
// integer codes from include/logos/compiler/ast.hpp. Schema keys are inlined u8s.

package logos.std.compiler.metaprog;

use logos.lang.hermes.hstatic;    // HermesStatic — the quote/metacall splice handle ({ptr})
use logos.lang.hermes.anyval;     // HAny
use logos.lang.hermes.hmap;       // HMap<Hu6,HAny> (for schema_type_code on type_from_anyval)
use logos.lang.hermes.hstring;
use logos.mem.string;
use logos.lang.str;

// ── AST handle types ──────────────────────────────────────────────
//
// Typed wrappers over HAny that distinguish AST node kinds at the type level.
// `raw` is a value-form HAny Ref to the node TOM (resolve() = its absolute ptr).

pub struct Item {
    pub raw: HAny,
}

// `Type` — typelevel value-handle (from `type_of::<T>()`). `kind` mirrors
// LogosType::Kind (Void=0, I32=1, ...). name/size/align/uid filled by the
// compiler when materialising a Type literal.
pub struct Type {
    pub kind: u32,
    pub name: &[u8],
    pub size: i64,
    pub align: i64,
    pub uid: u64,
}

impl Type {
    pub fn is_void(&self) -> bool { return self.kind == (0 as u32); }
    pub fn is_bool(&self) -> bool { return self.kind == (5 as u32); }

    pub fn is_integer(&self) -> bool {
        let k: u32 = self.kind;
        return k == (1 as u32)  || k == (2 as u32)  || k == (6 as u32)
            || k == (7 as u32)  || k == (8 as u32)  || k == (9 as u32)
            || k == (10 as u32) || k == (11 as u32)
            || k == (12 as u32) || k == (13 as u32)
            || k == (14 as u32) || k == (15 as u32)
            || k == (16 as u32) || k == (17 as u32);
    }

    pub fn is_float(&self) -> bool {
        return self.kind == (3 as u32) || self.kind == (4 as u32);
    }

    pub fn is_primitive(&self) -> bool {
        let k: u32 = self.kind;
        return k == (1 as u32)  || k == (2 as u32)  || k == (3 as u32)
            || k == (4 as u32)  || k == (5 as u32)  || k == (6 as u32)
            || k == (7 as u32)  || k == (8 as u32)  || k == (9 as u32)
            || k == (10 as u32) || k == (11 as u32)
            || k == (12 as u32) || k == (13 as u32)
            || k == (14 as u32) || k == (15 as u32)
            || k == (16 as u32) || k == (17 as u32);
    }

    pub fn is_struct(&self) -> bool {
        return self.kind == (22 as u32) || self.kind == (23 as u32);
    }

    pub fn is_enum(&self)    -> bool { return self.kind == (24 as u32); }
    pub fn is_array(&self)   -> bool { return self.kind == (21 as u32); }

    pub fn is_pointer(&self) -> bool {
        let k: u32 = self.kind;
        return k == (18 as u32) || k == (19 as u32) || k == (20 as u32);
    }

    pub fn ident(&self) -> Ident {
        return Ident {
            ptr: self.name.as_ptr(),
            len: self.name.len() as u64,
        };
    }
}

// `Template` — declaration-as-data handle (struct/enum/fn/trait/impl carrying
// type params). `raw` is the underlying AST node; inspection goes through OView.
pub struct Template {
    pub raw: HAny,
}

// Compiler-intrinsic target: `template_of::<X>()` lowers to a call of this with
// the resolved item's arena offset (the hook-side OView supplies the base).
pub fn template_of_at(off: u32) -> Template {
    let view: OView = oview_module_ast();
    // Raw-pointer anchor (the AST arena outlives the hook) — a borrow-typed
    // HAny here would dangle-flag against the local `view`.
    let p: *const u8 = view.base_ptr();
    return Template { raw: HAny::Ref((p as i64 + off as i64) as *const u8) };
}

impl Template {
    pub fn name(self: &Template, view: &OView) -> Ident {
        let nm: HAny = view.tiny_map_get(self.raw, 1 as u8);  // NAME = 1
        let sv: SView = view.get_str_view(nm);
        return Ident { ptr: sv.ptr, len: sv.len };
    }

    pub fn type_param_count(self: &Template, view: &OView) -> u64 {
        return view.ast_type_param_count(self.raw);
    }

    pub fn type_param_name(self: &Template, view: &OView, idx: u64) -> Ident {
        let sv: SView = view.ast_type_param_name(self.raw, idx);
        return Ident { ptr: sv.ptr, len: sv.len };
    }

    pub fn body(self: &Template) -> Item {
        return Item { raw: self.raw };
    }
}

// `TypeList<T...>` — A-layer pack-carrier (zero-sized).
pub struct TypeList<T...> {}

// `Ident` — borrowed identifier bytes (ptr borrows the source arena).
pub struct Ident {
    pub ptr: *const u8,
    pub len: u64,
}

impl Copy for Ident {}

extern fn logos_metaprog_gensym(pref_ptr: *const u8, pref_len: u64,
                                out_len: *mut u64) -> *const u8;

extern fn logos_macro_arg(site_id: u64, arg_idx: u64) -> *const u8;

pub fn gensym(prefix: str) -> Ident {
    let mut len: u64 = 0u64;
    let p: *const u8 = unsafe {
        logos_metaprog_gensym(prefix.as_ptr(), prefix.len() as u64,
                              &mut len as *mut u64)
    };
    return Ident { ptr: p, len: len };
}

// `QuoteItemBlob` — bundle returned by `quote_item! { ... }`. Unchanged by the
// hermes2 port (it carries rodata blob ptrs + packed ident/blob/cursor payloads,
// all *const u8 — no AnyVal).
pub struct QuoteItemBlob {
    pub template_ptr: *const u8,
    pub template_size: u64,
    pub idents_blob: *const u8,
    pub blobs_blob: *const u8,
    pub cursors_blob: *const u8,
}

// `ExprBlob` — marker return type (ABI = HermesStatic; a single *const u8).
pub struct ExprBlob {
    pub ptr: *const u8,
}

impl Item {
    pub fn name(self: &Item, view: &OView) -> Ident {
        let nm: HAny = view.tiny_map_get(self.raw, 1 as u8);  // NAME = 1
        let sv: SView = view.get_str_view(nm);
        return Ident { ptr: sv.ptr, len: sv.len };
    }

    pub fn field_count(self: &Item, view: &OView) -> u64 {
        return view.ast_struct_field_count(self.raw);
    }

    pub fn field(self: &Item, view: &OView, idx: u64) -> Item {
        return Item { raw: view.ast_struct_field(self.raw, idx) };
    }
}

impl Ident {
    pub fn eq(self: &Ident, other: &Ident) -> bool {
        if self.len != other.len { return false; }
        if self.len == (0 as u64) { return true; }
        let mut i: u64 = 0 as u64;
        while i < self.len {
            unsafe {
                let pa: *const u8 = (self.ptr as i64 + i as i64) as *const u8;
                let pb: *const u8 = (other.ptr as i64 + i as i64) as *const u8;
                let a: u8 = *pa;
                let b: u8 = *pb;
                if a != b { return false; }
            }
            i = i + (1 as u64);
        }
        return true;
    }
}

// ── `<type:T>` decode (schema_type_code=107 TOM) — hermes2 ──────────
//
// `val` is a node handle (HAny Ref to the TOM). Returns a zero-filled Type if
// `val` isn't a Ref to a schema-107 TinyObjectMap.
pub fn type_from_anyval(val: HAny) -> Type {
    unsafe {
        if !val.is_ref() || val.is_null() {
            return Type { kind: 0 as u32, name: "", size: 0, align: 0, uid: 0 as u64 };
        }
        let obj: *const u8 = val.resolve();
        if obj == (0 as *const u8) {
            return Type { kind: 0 as u32, name: "", size: 0, align: 0, uid: 0 as u64 };
        }
        let tom: *const HMap<Hu6, HAny> = obj as *const HMap<Hu6, HAny>;
        if (&*tom).schema_type_code() != (107 as u64) {
            return Type { kind: 0 as u32, name: "", size: 0, align: 0, uid: 0 as u64 };
        }

        let kind_av: HAny = (&*tom).get(0 as u8);
        let uid_av:  HAny = (&*tom).get(1 as u8);

        let mut kind: u32 = 0 as u32;
        if kind_av.is_pod() {
            kind = kind_av.as_u24() as u32;
        }

        let mut uid: u64 = 0 as u64;
        if uid_av.is_ref() && !uid_av.is_null() {
            // uid is a zone-boxed u64 record; resolve + read the 8-byte payload.
            let uobj: *const u64 = uid_av.resolve() as *const u64;
            uid = *uobj;
        }

        // name (key 2) intentionally left empty — synthesising a &[u8] slice with
        // stable storage from user code needs the fat-ptr-inline ABI (see the
        // Hermes1 note); compiler-built Type literals emit name into rodata.
        return Type { kind: kind, name: "", size: 0, align: 0, uid: uid };
    }
}

// ── OView convenience accessors (hermes2) ─────────────────────────────────
//
// All take/return HAny node handles via the oview.logos primitives.

impl OView {
    pub fn ast_node_name(self: &OView, node: HAny) -> SView {
        let nm: HAny = self.tiny_map_get(node, 1 as u8);
        return self.get_str_view(nm);
    }

    pub fn ast_struct_field_count(self: &OView, node: HAny) -> u64 {
        let fields: HAny = self.tiny_map_get(node, 22 as u8);
        if fields.is_null() { return 0 as u64; }
        return self.array_len(fields);
    }

    pub fn ast_struct_field(self: &OView, node: HAny, idx: u64) -> HAny {
        let fields: HAny = self.tiny_map_get(node, 22 as u8);
        return self.array_get(fields, idx);
    }

    pub fn ast_field_name(self: &OView, field_def: HAny) -> SView {
        let nm: HAny = self.tiny_map_get(field_def, 1 as u8);
        return self.get_str_view(nm);
    }

    pub fn ast_field_type_name(self: &OView, field_def: HAny) -> SView {
        let ty: HAny = self.tiny_map_get(field_def, 3 as u8);   // TYPE
        if ty.is_null() {
            return SView { ptr: 0 as *const u8, len: 0 as u64 };
        }
        let nm: HAny = self.tiny_map_get(ty, 1 as u8);          // NAME
        return self.get_str_view(nm);
    }

    pub fn ast_type_param_count(self: &OView, node: HAny) -> u64 {
        let tps: HAny = self.tiny_map_get(node, 27 as u8);
        if tps.is_null() { return 0 as u64; }
        let inner: HAny = self.tiny_map_get(tps, 2 as u8);  // ITEMS
        if inner.is_null() { return 0 as u64; }
        return self.array_len(inner);
    }

    pub fn ast_type_param_name(self: &OView, node: HAny, idx: u64) -> SView {
        let tps: HAny = self.tiny_map_get(node, 27 as u8);
        if tps.is_null() { return SView { ptr: 0 as *const u8, len: 0 as u64 }; }
        let inner: HAny = self.tiny_map_get(tps, 2 as u8);
        if inner.is_null() { return SView { ptr: 0 as *const u8, len: 0 as u64 }; }
        let item: HAny = self.array_get(inner, idx);
        return self.ast_node_name(item);
    }

    // ── ENUM helpers ──────────────────────────────────────────────
    pub fn ast_enum_variant_count(self: &OView, node: HAny) -> u64 {
        let outer: HAny = self.tiny_map_get(node, 2 as u8);
        if outer.is_null() { return 0 as u64; }
        let inner: HAny = self.tiny_map_get(outer, 2 as u8);
        if inner.is_null() { return 0 as u64; }
        return self.array_len(inner);
    }

    pub fn ast_enum_variant(self: &OView, node: HAny, idx: u64) -> HAny {
        let outer: HAny = self.tiny_map_get(node, 2 as u8);
        let inner: HAny = self.tiny_map_get(outer, 2 as u8);
        return self.array_get(inner, idx);
    }

    pub fn ast_variant_arity(self: &OView, variant: HAny) -> u64 {
        let outer: HAny = self.tiny_map_get(variant, 2 as u8);
        if outer.is_null() { return 0 as u64; }
        let inner: HAny = self.tiny_map_get(outer, 2 as u8);
        if inner.is_null() { return 1 as u64; }
        return self.array_len(inner);
    }

    // First MODULE item whose NAME matches `name` byte-for-byte; null HAny if none.
    pub fn find_template_decl(self: &OView, name: &[u8]) -> HAny {
        let root: HAny = self.root();
        let items: HAny = self.tiny_map_get(root, 2 as u8);  // ITEMS
        if items.is_null() { return HAny::Ref(0i64 as *const u8); }
        let n: u64 = self.array_len(items);
        let nlen: i64 = name.len();
        let mut i: u64 = 0 as u64;
        while i < n {
            let item: HAny = self.array_get(items, i);
            let nm: SView = self.ast_node_name(item);
            if nm.len == (nlen as u64) {
                let mut j: i64 = 0;
                let mut eq: bool = true;
                while j < nlen {
                    unsafe {
                        let a: u8 = *((nm.ptr as i64 + j) as *const u8);
                        if a != name[j] { eq = false; }
                    }
                    j = j + (1 as i64);
                }
                if eq { return item; }
            }
            i = i + (1 as u64);
        }
        return HAny::Ref(0i64 as *const u8);
    }

    // STRING-token literal byte view minus surrounding quotes. Empty if absent.
    pub fn ast_lit_str_view(self: &OView, lit: HAny) -> SView {
        let s_av: HAny = self.tiny_map_get(lit, 7 as u8);   // VALUE
        let raw: SView = self.get_str_view(s_av);
        if raw.len < (2 as u64) { return SView { ptr: 0 as *const u8, len: 0 }; }
        return SView {
            ptr: (raw.ptr as i64 + 1i64) as *const u8,
            len: raw.len - (2 as u64),
        };
    }

    // Decode a `<type:T>` Hermes value (schema_type_code=107 TOM) into a Type.
    pub fn as_type(self: &OView, val: HAny) -> Type {
        return type_from_anyval(val);
    }

    // Append the user-root MODULE's dotted package name to `buf`.
    pub fn module_package_append(self: &OView, buf: &mut String) {
        let root: HAny = self.root();
        let head: SView = self.ast_node_name(root);
        if head.len == (0 as u64) { return; }
        unsafe { buf.push_bytes(head.ptr, head.len as i64); }
        let parts: HAny = self.tiny_map_get(root, 16 as u8);
        if parts.is_null() { return; }
        let n: u64 = self.array_len(parts);
        let mut i: u64 = 0 as u64;
        while i < n {
            let part: HAny = self.array_get(parts, i);
            let pn: SView = self.ast_node_name(part);
            buf.push_u8(46 as u8);  // '.'
            unsafe { buf.push_bytes(pn.ptr, pn.len as i64); }
            i = i + (1 as u64);
        }
    }
}
