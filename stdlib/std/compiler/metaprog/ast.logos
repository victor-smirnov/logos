// SPDX-License-Identifier: Apache-2.0
// std.compiler.metaprog — untyped-AST helpers for hook handlers.
//
// Hooks fire pre-sema (slice 17), so the AST they walk is freshly
// parsed: TinyObjectMap nodes keyed by integer codes from
// `include/logos/compiler/ast.hpp`. The handler receives a target
// offset and an OView; these helpers turn the raw key/code layout
// into named accessors (struct name, field iteration, type name).
//
// Schema constants mirror ast.hpp directly. They're inlined u8s so
// the const-fn argument shape of tiny_map_get works without ceremony.

package std.compiler.metaprog;

use std.hermes.view;
use std.hermes.anyval;
use std.hermes.string;
use std.lang.text;

// ── AST handle types ──────────────────────────────────────────────
//
// Typed wrappers over AnyVal that distinguish AST node kinds at the
// type level. Slice 2 of the metaprog quote epic
// (~/.claude/plans/metaprog-quote.md): `quote_item! { ... }` returns
// `Item`; later slices add `Expr`, `Stmt`, `Pat`, `Type`, `Ident` for
// the remaining quote forms and `#name` anti-quotation.
//
// Holder/lifetime is intentionally NOT part of the type for the MVP:
// quote literals lower to HermesStatic blobs (rodata), so `raw` points
// into static memory and no retain count is needed. Once metafunctions
// start mutating items or stashing them across iterations, Item can
// grow a holder field without breaking the type identity.

pub struct Item {
    pub raw: AnyVal,
}

// `Ident` — borrowed identifier bytes. Slice 5/6 of metaprog-quote:
// produced by `Item::name()`/`OView::ast_node_ident()` and consumed
// at `#name` antiquot positions inside `quote_item! { ... }`. The
// pointer borrows from whatever arena owned the source string —
// callers must not let that arena outlive the Ident's use.
pub struct Ident {
    pub ptr: *const u8,
    pub len: u64,
}

// `QuoteItemBlob` — bundle returned by `quote_item! { ... }` post-
// Slice 5a.1. `template_ptr/size` is the rodata Hermes blob with
// `NAME_VAR` placeholders carrying integer indices; `idents_ptr` is
// a runtime-collected array of pointers to per-site `Ident` values
// (one entry per `#name` site, in the order they appear in the quote
// body). Pointer-of-pointer because Logos arrays-of-struct aren't
// laid out inline at MLIR level; an array of `*const Ident` is the
// portable representation. The host shim `logos_emit_item_blob_subst`
// walks the template, substitutes each placeholder with `*idents[idx]`,
// and forwards to the regular item-blob emit path.
pub struct QuoteItemBlob {
    pub template_ptr: *const u8,
    pub template_size: u64,
    pub idents_ptr: *const *const Ident,
    pub idents_count: u64,
}

impl Item {
    // Read the item's NAME field as an `Ident`. Works for STRUCT,
    // ENUM, FN, etc.; for nodes without a NAME key the returned
    // Ident has `ptr=null, len=0`. The Ident borrows from the AST
    // arena owned by `view`.
    pub fn name(self: &Item, view: &OView) -> Ident {
        let nm: AnyVal = view.tiny_map_get(self.raw, 1 as u8);  // NAME = 1
        let sv: StringView = view.get_str_view(nm);
        return Ident { ptr: sv.ptr, len: sv.len };
    }
}

// ── AST schema (mirrors include/logos/compiler/ast.hpp) ────────────
//
// AST keys (TinyObjectMap field discriminators) are inlined as u8
// literals at each call site.  `pub const` at module scope is not
// yet supported end-to-end, and the helpers are few enough that the
// magic numbers are easier to read than imported names anyway.
//
//   NAME   = 1
//   TYPE   = 3
//   FIELDS = 22

// ── OView convenience methods ─────────────────────────────────────

impl OView {
    // Read the struct's NAME as a borrowed StringView. `node` must be
    // a STRUCT (or any node with a NAME key).  Empty view if missing.
    pub fn ast_node_name(self: &OView, node: AnyVal) -> StringView {
        let nm: AnyVal = self.tiny_map_get(node, 1 as u8);
        return self.get_str_view(nm);
    }

    // Number of fields in a STRUCT node. Zero for empty structs or
    // when FIELDS is absent.
    pub fn ast_struct_field_count(self: &OView, node: AnyVal) -> u64 {
        let fields: AnyVal = self.tiny_map_get(node, 22 as u8);
        if fields.raw == 0 { return 0 as u64; }
        return self.array_len(fields);
    }

    // Get the i-th FIELD_DEF node from a STRUCT. Caller is responsible
    // for staying within ast_struct_field_count() — out-of-range
    // returns null AnyVal, behaviour after that is undefined.
    pub fn ast_struct_field(self: &OView, node: AnyVal, idx: u64) -> AnyVal {
        let fields: AnyVal = self.tiny_map_get(node, 22 as u8);
        return self.array_get(fields, idx);
    }

    // Field's declared name. Borrows from the AST zone.
    pub fn ast_field_name(self: &OView, field_def: AnyVal) -> StringView {
        let nm: AnyVal = self.tiny_map_get(field_def, 1 as u8);
        return self.get_str_view(nm);
    }

    // Number of type parameters on a STRUCT/ENUM (zero for plain types).
    // Reads TYPE_PARAMS(27) → ITEMS array length.
    pub fn ast_type_param_count(self: &OView, node: AnyVal) -> u64 {
        let tps: AnyVal = self.tiny_map_get(node, 27 as u8);
        if tps.raw == 0 { return 0 as u64; }
        let inner: AnyVal = self.tiny_map_get(tps, 2 as u8);  // ITEMS
        if inner.raw == 0 { return 0 as u64; }
        return self.array_len(inner);
    }

    // i-th type parameter's NAME (e.g. "T"). Empty view if out of range.
    // Lifetime params (LIFETIME_PARAM) and const params share the index
    // space; for derive purposes we read NAME unconditionally and let
    // the synthesised header place every name into `impl<...>` — bounds
    // and lifetime markers are caller's concern.
    pub fn ast_type_param_name(self: &OView, node: AnyVal, idx: u64) -> StringView {
        let tps: AnyVal = self.tiny_map_get(node, 27 as u8);
        if tps.raw == 0 { return StringView { ptr: 0 as *const u8, len: 0 as u64 }; }
        let inner: AnyVal = self.tiny_map_get(tps, 2 as u8);
        if inner.raw == 0 { return StringView { ptr: 0 as *const u8, len: 0 as u64 }; }
        let item: AnyVal = self.array_get(inner, idx);
        return self.ast_node_name(item);
    }

    // ── ENUM helpers ──────────────────────────────────────────────
    //
    // ENUM AST shape (mirrors logos.peg): `node.ITEMS` (key 2) is a
    // wrapper TinyObjectMap whose own ITEMS key holds the array of
    // VARIANT_DEF nodes. Inner variant payloads follow the same
    // wrapper pattern (so `variant.ITEMS` → wrapper → array of type_ref
    // maps), except for variadic variants where ITEMS is a single
    // type_ref node — those are out of scope here.

    // Number of variants in an ENUM node. Zero if ITEMS is missing.
    pub fn ast_enum_variant_count(self: &OView, node: AnyVal) -> u64 {
        let outer: AnyVal = self.tiny_map_get(node, 2 as u8);
        if outer.raw == 0 { return 0 as u64; }
        let inner: AnyVal = self.tiny_map_get(outer, 2 as u8);
        if inner.raw == 0 { return 0 as u64; }
        return self.array_len(inner);
    }

    // i-th VARIANT_DEF node from an ENUM. Caller stays within
    // ast_enum_variant_count(); out-of-range yields a null AnyVal.
    pub fn ast_enum_variant(self: &OView, node: AnyVal, idx: u64) -> AnyVal {
        let outer: AnyVal = self.tiny_map_get(node, 2 as u8);
        let inner: AnyVal = self.tiny_map_get(outer, 2 as u8);
        return self.array_get(inner, idx);
    }

    // Arity (number of payload types) for a VARIANT_DEF. Zero for
    // unit variants. Variadic variants (T...) report 1 here but
    // callers should check IS_VARIADIC if it matters.
    pub fn ast_variant_arity(self: &OView, variant: AnyVal) -> u64 {
        let outer: AnyVal = self.tiny_map_get(variant, 2 as u8);
        if outer.raw == 0 { return 0 as u64; }
        let inner: AnyVal = self.tiny_map_get(outer, 2 as u8);
        if inner.raw == 0 { return 1 as u64; }
        return self.array_len(inner);
    }

    // Append the user-root MODULE's dotted package name to `buf`.
    // For `package main;` writes `main`; for `package std.lang.text;`
    // writes `std.lang.text`. Reads NAME(1) (first identifier) plus
    // each PATH_PARTS(16)[i].NAME (subsequent dotted parts).
    pub fn module_package_append(self: &OView, buf: &mut String) {
        let root: AnyVal = self.root();
        let head: StringView = self.ast_node_name(root);
        if head.len == (0 as u64) { return; }
        unsafe { buf.push_bytes(head.ptr, head.len as i64); }
        let parts: AnyVal = self.tiny_map_get(root, 16 as u8);
        if parts.raw == 0 { return; }
        let n: u64 = self.array_len(parts);
        let mut i: u64 = 0 as u64;
        while i < n {
            let part: AnyVal = self.array_get(parts, i);
            let pn: StringView = self.ast_node_name(part);
            buf.push_u8(46 as u8);  // '.'
            unsafe { buf.push_bytes(pn.ptr, pn.len as i64); }
            i = i + (1 as u64);
        }
    }
}
