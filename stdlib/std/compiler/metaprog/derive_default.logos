// logos.std.compiler.metaprog — derive(Default) for plain and
// generic structs.
//
// Hook for `#[derive_default]`. Emits
//
//   impl<T1: Default, ...> Default for Name<T1, ...> {
//       fn default() -> Name<T1, ...> {
//           unsafe {
//               return MaybeUninit::<Name<T1, ...>>::zeroed()
//                       .assume_init();
//           }
//       }
//   }
//
// Zero-initialization model: every field is bitwise-zero. For
// POD struct types (primitives + nested POD), this matches Rust's
// per-field `Default::default()` chain — i32::default() = 0,
// bool::default() = false, etc. all yield bitwise-zero.
// Non-POD field types (Vec / Box / etc. with non-zero defaults)
// will get a zero bitmask, which differs from Rust's per-field
// init — that requires the `quote_expr` type-position antiquot
// extension (Wave 9 follow-up) to dispatch `T::default()` per
// field. Slice 1 covers the common port shape (POD structs).
//
// §6.10 sub-deliverable 7/8.

package logos.std.compiler.metaprog;

use logos.mem.collections.vec;
use logos.lang.hermes2.anyval;
use logos.lang.default;
use logos.mem.uninit;

#[metaprog_handler("derive_default")]
fn derive_default_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: HAny = view.node_at(target_offset);
    let nm_sv: SView = view.ast_node_name(item);
    if nm_sv.len == (0 as u64) { return; }
    let nm: Ident = Ident { ptr: nm_sv.ptr, len: nm_sv.len };

    let np: u64 = view.ast_type_param_count(item);
    let mut tparams: Vec<Ident> = vec_new::<Ident>();
    let mut k: u64 = 0 as u64;
    while k < np {
        let tp: SView = view.ast_type_param_name(item, k);
        unsafe {
            (&mut tparams as *mut Vec<Ident>).push(
                Ident { ptr: tp.ptr, len: tp.len });
        }
        k = k + (1 as u64);
    }

    if np == (0 as u64) {
        let blob: QuoteItemBlob = quote_item! {
            impl Default for #(nm) {
                fn default() -> #(nm) {
                    unsafe {
                        return MaybeUninit::<#(nm)>::zeroed().assume_init();
                    }
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&blob); }
    } else {
        let blob2: QuoteItemBlob = quote_item! {
            impl<#( #tparams: Default ),*> Default for #nm<#( #tparams ),*> {
                fn default() -> #nm<#( #tparams ),*> {
                    unsafe {
                        return MaybeUninit::<#nm<#( #tparams ),*>>::zeroed().assume_init();
                    }
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&blob2); }
    }
    return;
}
