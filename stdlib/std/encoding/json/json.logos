// SPDX-License-Identifier: Apache-2.0
// Logos standard library -- std.json
//
// JSON utilities:
//   * json_escape_string       — write a JSON string literal (quoted, escaped)
//   * json_unescape_string     — decode a JSON string literal into bytes
//   * JsonWriter               — structured builder that emits well-formed JSON
//   * json_validate            — syntactic validator, returns bytes consumed
//
// This module does NOT build an AST — parsing is left to callers who can
// traverse with `json_validate` as a skip primitive.

package std.encoding.json;

use std.lang.text;

// ── String escape ─────────────────────────────────────────────────────────
// Append a JSON string literal (including the surrounding double quotes) that
// encodes the bytes [src, src+len).  Non-ASCII bytes are passed through as-is
// (valid per RFC 8259 for UTF-8 input).
pub fn json_escape_string(src: *const u8, len: i64, out: &mut String) {
    unsafe {
        out.push_u8(34 as u8);          // '"'
        let mut i: i64 = 0 as i64;
        while i < len {
            let b: u8 = src[i];
            if b == 34 as u8 {                                // '"'
                out.push_u8(92 as u8); out.push_u8(34 as u8);
            } else if b == 92 as u8 {                         // '\'
                out.push_u8(92 as u8); out.push_u8(92 as u8);
            } else if b == 8 as u8 {                          // \b
                out.push_u8(92 as u8); out.push_u8(98 as u8);
            } else if b == 12 as u8 {                         // \f
                out.push_u8(92 as u8); out.push_u8(102 as u8);
            } else if b == 10 as u8 {                         // \n
                out.push_u8(92 as u8); out.push_u8(110 as u8);
            } else if b == 13 as u8 {                         // \r
                out.push_u8(92 as u8); out.push_u8(114 as u8);
            } else if b == 9 as u8 {                          // \t
                out.push_u8(92 as u8); out.push_u8(116 as u8);
            } else if (b as i32) < 32 {                       // other control → \u00XX
                out.push_u8(92 as u8); out.push_u8(117 as u8);
                out.push_u8(48 as u8); out.push_u8(48 as u8);
                out.push_u8(hex_upper((b >> 4 as u8) & 15 as u8));
                out.push_u8(hex_upper(b & 15 as u8));
            } else {
                out.push_u8(b);
            }
            i = i + 1 as i64;
        }
        out.push_u8(34 as u8);          // '"'
    }
}

pub fn json_escape_str(s: str, out: &mut String) {
    unsafe { json_escape_string(s.as_ptr(), s.len(), out); }
}

// ── String unescape ──────────────────────────────────────────────────────
// `src` must point at the opening '"'.  On success, appends the decoded
// bytes to `out` and returns the number of bytes consumed from `src`
// (including both quotes).  On malformed input, returns -1.
pub fn json_unescape_string(src: *const u8, len: i64, out: &mut String) -> i64 {
    unsafe {
        if len < 2 as i64 { return 0 - 1 as i64; }
        if src[0 as i64] != 34 as u8 { return 0 - 1 as i64; }
        let mut i: i64 = 1 as i64;
        while i < len {
            let b: u8 = src[i];
            if b == 34 as u8 {                 // closing '"'
                return i + 1 as i64;
            }
            if b == 92 as u8 {                 // '\'
                if (i + 1 as i64) >= len { return 0 - 1 as i64; }
                let e: u8 = src[i + 1 as i64];
                if      e == 34 as u8  { out.push_u8(34 as u8);  i = i + 2 as i64; }
                else if e == 92 as u8  { out.push_u8(92 as u8);  i = i + 2 as i64; }
                else if e == 47 as u8  { out.push_u8(47 as u8);  i = i + 2 as i64; }
                else if e == 98 as u8  { out.push_u8(8 as u8);   i = i + 2 as i64; }
                else if e == 102 as u8 { out.push_u8(12 as u8);  i = i + 2 as i64; }
                else if e == 110 as u8 { out.push_u8(10 as u8);  i = i + 2 as i64; }
                else if e == 114 as u8 { out.push_u8(13 as u8);  i = i + 2 as i64; }
                else if e == 116 as u8 { out.push_u8(9 as u8);   i = i + 2 as i64; }
                else if e == 117 as u8 {                         // \uXXXX
                    if (i + 5 as i64) >= len { return 0 - 1 as i64; }
                    let cp: i32 = parse_hex4(src, i + 2 as i64);
                    if cp < 0 { return 0 - 1 as i64; }
                    // Surrogate pair handling.
                    if cp >= 0xD800 && cp <= 0xDBFF {
                        if (i + 11 as i64) >= len { return 0 - 1 as i64; }
                        if src[i + 6 as i64] != 92 as u8  { return 0 - 1 as i64; }
                        if src[i + 7 as i64] != 117 as u8 { return 0 - 1 as i64; }
                        let lo: i32 = parse_hex4(src, i + 8 as i64);
                        if lo < 0xDC00 || lo > 0xDFFF { return 0 - 1 as i64; }
                        let cu: u32 = (0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)) as u32;
                        out.push_char(cu);
                        i = i + 12 as i64;
                    } else if cp >= 0xDC00 && cp <= 0xDFFF {
                        return 0 - 1 as i64;                     // stray low surrogate
                    } else {
                        out.push_char(cp as u32);
                        i = i + 6 as i64;
                    }
                } else {
                    return 0 - 1 as i64;
                }
            } else if (b as i32) < 32 {
                return 0 - 1 as i64;             // unescaped control byte
            } else {
                out.push_u8(b);
                i = i + 1 as i64;
            }
        }
        return 0 - 1 as i64;                     // no closing quote
    }
}

// ── Validator ─────────────────────────────────────────────────────────────
// Returns number of bytes consumed for the first valid JSON value in
// [src, src+len), skipping leading whitespace.  -1 on malformed input.
pub fn json_validate(src: *const u8, len: i64) -> i64 {
    unsafe {
        let start: i64 = skip_ws(src, len, 0 as i64);
        let end: i64 = parse_value(src, len, start);
        if end < 0 as i64 { return 0 - 1 as i64; }
        return end - start;
    }
}

pub fn json_validate_str(s: str) -> i64 {
    unsafe { return json_validate(s.as_ptr(), s.len()); }
}

// ── JsonWriter ────────────────────────────────────────────────────────────
// Emits well-formed JSON into an owned String.  Tracks a small stack of
// container states (object/array) so commas and key/value alternation are
// inserted automatically.  Max nesting depth: 64.
//
// State per frame:
//   kind:   0 = root, 1 = array, 2 = object
//   count:  number of values already emitted in this frame
//   expect_key: (object only) whether next `push_*` must be a key
pub struct JsonWriter {
    buf: String,
    stack_kind: [u8; 64],
    stack_count: [i32; 64],
    depth: i32,
    object_expecting_key: [bool; 64],
}

impl JsonWriter {
    pub static fn new() -> JsonWriter {
        let s: String = String::new();
        let k: [u8; 64] = [0 as u8; 64];
        let c: [i32; 64] = [0; 64];
        let e: [bool; 64] = [false; 64];
        return JsonWriter {
            buf: s,
            stack_kind: k,
            stack_count: c,
            depth: 0,
            object_expecting_key: e,
        };
    }

    pub fn as_str(&self) -> *const u8 { return self.buf.as_ptr(); }
    pub fn len(&self) -> i64 { return self.buf.len(); }

    pub fn append_into(&self, out: &mut String) {
        unsafe { out.push_bytes(self.buf.as_ptr(), self.buf.len()); }
    }

    fn before_value(&mut self) {
        let d: i32 = self.depth;
        let k: u8 = self.stack_kind[d];
        if k == 1 as u8 {                        // in array
            if self.stack_count[d] > 0 { self.buf.push_u8(44 as u8); }  // ','
            self.stack_count[d] = self.stack_count[d] + 1;
        } else if k == 2 as u8 {                 // in object
            // must be called only after a key has been emitted and ':' printed
        }
    }

    fn after_value(&mut self) {
        let d: i32 = self.depth;
        if self.stack_kind[d] == 2 as u8 {
            self.object_expecting_key[d] = true;
            self.stack_count[d] = self.stack_count[d] + 1;
        }
    }

    pub fn begin_array(&mut self) {
        self.emit_separator_for_value();
        self.buf.push_u8(91 as u8);              // '['
        self.depth = self.depth + 1;
        self.stack_kind[self.depth] = 1 as u8;
        self.stack_count[self.depth] = 0;
        self.object_expecting_key[self.depth] = false;
    }

    pub fn end_array(&mut self) {
        self.buf.push_u8(93 as u8);              // ']'
        self.depth = self.depth - 1;
        self.after_value();
    }

    pub fn begin_object(&mut self) {
        self.emit_separator_for_value();
        self.buf.push_u8(123 as u8);             // '{'
        self.depth = self.depth + 1;
        self.stack_kind[self.depth] = 2 as u8;
        self.stack_count[self.depth] = 0;
        self.object_expecting_key[self.depth] = true;
    }

    pub fn end_object(&mut self) {
        self.buf.push_u8(125 as u8);             // '}'
        self.depth = self.depth - 1;
        self.after_value();
    }

    pub fn write_key(&mut self, k: str) {
        let d: i32 = self.depth;
        if self.stack_count[d] > 0 { self.buf.push_u8(44 as u8); }
        json_escape_str(k, &mut self.buf);
        self.buf.push_u8(58 as u8);              // ':'
        self.object_expecting_key[d] = false;
    }

    fn emit_separator_for_value(&mut self) {
        let d: i32 = self.depth;
        let k: u8 = self.stack_kind[d];
        if k == 1 as u8 {
            if self.stack_count[d] > 0 { self.buf.push_u8(44 as u8); }
            self.stack_count[d] = self.stack_count[d] + 1;
        }
        // object values: key() already emitted the ':'; no separator needed here
    }

    pub fn write_null(&mut self) {
        self.emit_separator_for_value();
        self.buf.push_u8(110 as u8); self.buf.push_u8(117 as u8);
        self.buf.push_u8(108 as u8); self.buf.push_u8(108 as u8);
        self.after_value();
    }

    pub fn write_bool(&mut self, v: bool) {
        self.emit_separator_for_value();
        if v {
            self.buf.push_u8(116 as u8); self.buf.push_u8(114 as u8);
            self.buf.push_u8(117 as u8); self.buf.push_u8(101 as u8);
        } else {
            self.buf.push_u8(102 as u8); self.buf.push_u8(97 as u8);
            self.buf.push_u8(108 as u8); self.buf.push_u8(115 as u8);
            self.buf.push_u8(101 as u8);
        }
        self.after_value();
    }

    pub fn write_i64(&mut self, n: i64) {
        self.emit_separator_for_value();
        self.buf.push_i64(n);
        self.after_value();
    }

    pub fn write_u64(&mut self, n: u64) {
        self.emit_separator_for_value();
        self.buf.push_u64(n);
        self.after_value();
    }

    pub fn write_str(&mut self, s: str) {
        self.emit_separator_for_value();
        json_escape_str(s, &mut self.buf);
        self.after_value();
    }

    // Caller-supplied raw JSON fragment (e.g. a pre-formatted number).
    // No validation.
    pub fn write_raw(&mut self, s: str) {
        self.emit_separator_for_value();
        self.buf.push_str(s);
        self.after_value();
    }
}

// ── helpers ──────────────────────────────────────────────────────────────

fn hex_upper(n: u8) -> u8 {
    let ni: i32 = n as i32;
    if ni < 10 { return (ni + 48) as u8; }
    return (ni - 10 + 65) as u8;
}

unsafe fn parse_hex4(src: *const u8, off: i64) -> i32 {
    let mut v: i32 = 0;
    let mut i: i64 = 0 as i64;
    while i < 4 as i64 {
        let c: i32 = src[off + i] as i32;
        let d: i32 = nibble_of(c);
        if d < 0 { return 0 - 1; }
        v = (v << 4) | d;
        i = i + 1 as i64;
    }
    return v;
}

fn nibble_of(ci: i32) -> i32 {
    if ci >= 48 && ci <= 57  { return ci - 48; }
    if ci >= 65 && ci <= 70  { return ci - 65 + 10; }
    if ci >= 97 && ci <= 102 { return ci - 97 + 10; }
    return 0 - 1;
}

unsafe fn skip_ws(src: *const u8, len: i64, start: i64) -> i64 {
    let mut i: i64 = start;
    while i < len {
        let b: u8 = src[i];
        if b == 32 as u8 || b == 9 as u8 || b == 10 as u8 || b == 13 as u8 {
            i = i + 1 as i64;
        } else {
            return i;
        }
    }
    return i;
}

// Returns position of the first byte after the value, or -1 on error.
unsafe fn parse_value(src: *const u8, len: i64, i: i64) -> i64 {
    if i >= len { return 0 - 1 as i64; }
    let b: u8 = src[i];
    if b == 123 as u8 { return parse_object(src, len, i); }   // '{'
    if b == 91 as u8  { return parse_array(src, len, i); }    // '['
    if b == 34 as u8  { return parse_string_skip(src, len, i); }   // '"'
    if b == 116 as u8 { return match_literal(src, len, i, 116 as u8, 114 as u8, 117 as u8, 101 as u8, 0 as u8); } // true
    if b == 102 as u8 { return match_literal(src, len, i, 102 as u8, 97 as u8, 108 as u8, 115 as u8, 101 as u8); } // false
    if b == 110 as u8 { return match_literal(src, len, i, 110 as u8, 117 as u8, 108 as u8, 108 as u8, 0 as u8); }  // null
    if b == 45 as u8 { return parse_number(src, len, i); }    // '-'
    if (b as i32) >= 48 && (b as i32) <= 57 { return parse_number(src, len, i); }
    return 0 - 1 as i64;
}

unsafe fn match_literal(src: *const u8, len: i64, i: i64, a: u8, b: u8, c: u8, d: u8, e: u8) -> i64 {
    let n: i64 = if e == 0 as u8 { 4 as i64 } else { 5 as i64 };
    if i + n > len { return 0 - 1 as i64; }
    if src[i]          != a { return 0 - 1 as i64; }
    if src[i + 1 as i64] != b { return 0 - 1 as i64; }
    if src[i + 2 as i64] != c { return 0 - 1 as i64; }
    if src[i + 3 as i64] != d { return 0 - 1 as i64; }
    if e != 0 as u8 {
        if src[i + 4 as i64] != e { return 0 - 1 as i64; }
    }
    return i + n;
}

unsafe fn parse_string_skip(src: *const u8, len: i64, i: i64) -> i64 {
    if src[i] != 34 as u8 { return 0 - 1 as i64; }
    let mut j: i64 = i + 1 as i64;
    while j < len {
        let b: u8 = src[j];
        if b == 34 as u8 { return j + 1 as i64; }
        if b == 92 as u8 {
            if (j + 1 as i64) >= len { return 0 - 1 as i64; }
            let e: u8 = src[j + 1 as i64];
            if e == 117 as u8 {
                if (j + 5 as i64) >= len { return 0 - 1 as i64; }
                if parse_hex4(src, j + 2 as i64) < 0 { return 0 - 1 as i64; }
                j = j + 6 as i64;
            } else if e == 34 as u8 || e == 92 as u8 || e == 47 as u8
                  || e == 98 as u8 || e == 102 as u8
                  || e == 110 as u8 || e == 114 as u8 || e == 116 as u8 {
                j = j + 2 as i64;
            } else {
                return 0 - 1 as i64;
            }
        } else if (b as i32) < 32 {
            return 0 - 1 as i64;
        } else {
            j = j + 1 as i64;
        }
    }
    return 0 - 1 as i64;
}

unsafe fn parse_number(src: *const u8, len: i64, i: i64) -> i64 {
    let mut j: i64 = i;
    if j < len && src[j] == 45 as u8 { j = j + 1 as i64; }
    if j >= len { return 0 - 1 as i64; }
    if src[j] == 48 as u8 {
        j = j + 1 as i64;
    } else {
        let c: i32 = src[j] as i32;
        if c < 49 || c > 57 { return 0 - 1 as i64; }
        j = j + 1 as i64;
        while j < len {
            let d: i32 = src[j] as i32;
            if d < 48 || d > 57 { break; }
            j = j + 1 as i64;
        }
    }
    // fraction
    if j < len && src[j] == 46 as u8 {
        j = j + 1 as i64;
        if j >= len { return 0 - 1 as i64; }
        let c: i32 = src[j] as i32;
        if c < 48 || c > 57 { return 0 - 1 as i64; }
        while j < len {
            let d: i32 = src[j] as i32;
            if d < 48 || d > 57 { break; }
            j = j + 1 as i64;
        }
    }
    // exponent
    if j < len && (src[j] == 101 as u8 || src[j] == 69 as u8) {
        j = j + 1 as i64;
        if j < len && (src[j] == 43 as u8 || src[j] == 45 as u8) { j = j + 1 as i64; }
        if j >= len { return 0 - 1 as i64; }
        let c: i32 = src[j] as i32;
        if c < 48 || c > 57 { return 0 - 1 as i64; }
        while j < len {
            let d: i32 = src[j] as i32;
            if d < 48 || d > 57 { break; }
            j = j + 1 as i64;
        }
    }
    return j;
}

unsafe fn parse_array(src: *const u8, len: i64, i: i64) -> i64 {
    let mut j: i64 = i + 1 as i64;
    j = skip_ws(src, len, j);
    if j >= len { return 0 - 1 as i64; }
    if src[j] == 93 as u8 { return j + 1 as i64; }           // empty
    while true {
        j = skip_ws(src, len, j);
        let end: i64 = parse_value(src, len, j);
        if end < 0 as i64 { return 0 - 1 as i64; }
        j = skip_ws(src, len, end);
        if j >= len { return 0 - 1 as i64; }
        if src[j] == 93 as u8 { return j + 1 as i64; }
        if src[j] != 44 as u8 { return 0 - 1 as i64; }
        j = j + 1 as i64;
    }
    return 0 - 1 as i64;
}

unsafe fn parse_object(src: *const u8, len: i64, i: i64) -> i64 {
    let mut j: i64 = i + 1 as i64;
    j = skip_ws(src, len, j);
    if j >= len { return 0 - 1 as i64; }
    if src[j] == 125 as u8 { return j + 1 as i64; }          // empty
    while true {
        j = skip_ws(src, len, j);
        if j >= len { return 0 - 1 as i64; }
        if src[j] != 34 as u8 { return 0 - 1 as i64; }
        let after_key: i64 = parse_string_skip(src, len, j);
        if after_key < 0 as i64 { return 0 - 1 as i64; }
        j = skip_ws(src, len, after_key);
        if j >= len { return 0 - 1 as i64; }
        if src[j] != 58 as u8 { return 0 - 1 as i64; }       // ':'
        j = j + 1 as i64;
        j = skip_ws(src, len, j);
        let after_val: i64 = parse_value(src, len, j);
        if after_val < 0 as i64 { return 0 - 1 as i64; }
        j = skip_ws(src, len, after_val);
        if j >= len { return 0 - 1 as i64; }
        if src[j] == 125 as u8 { return j + 1 as i64; }
        if src[j] != 44 as u8 { return 0 - 1 as i64; }
        j = j + 1 as i64;
    }
    return 0 - 1 as i64;
}
