// SPDX-License-Identifier: Apache-2.0
// Logos standard library — std.rc
//
// Rc<T> — single-thread reference-counted smart pointer.
// NOT Send: Rc contains raw *mut pointers and uses a non-atomic counter.
//
// Layout: two heap allocations.
//   val    — the T value itself (sizeof::<T>() bytes)
//   strong — a single i32 reference count (4 bytes)
//
// The two-pointer layout sidesteps generic-struct field-offset issues with
// chain writes (`inner.field = ...` through a generic *mut pointer).

package std.rc;

use std.mem;

pub struct Rc<T> {
    val:    *mut T,
    strong: *mut i32,
}

pub fn rc_new<T>(val: T) -> Rc<T> {
    let vp: *mut T   = alloc(sizeof::<T>())  as *mut T;
    let sp: *mut i32 = alloc(4 as i64)       as *mut i32;
    unsafe {
        vp[0] = val;
        sp[0] = 1;
    }
    return Rc { val: vp, strong: sp };
}

impl<T> Rc<T> {
    pub unsafe fn get(self: *mut Rc<T>) -> *const T {
        return self.val as *const T;
    }

    pub unsafe fn get_mut(self: *mut Rc<T>) -> *mut T {
        return self.val;
    }

    pub unsafe fn strong_count(self: *mut Rc<T>) -> i32 {
        return self.strong[0];
    }

    pub unsafe fn is_null(self: *mut Rc<T>) -> bool {
        return self.val == 0 as *mut T;
    }

    // Increment strong count; return a second handle to the same data.
    pub unsafe fn clone_rc(self: *mut Rc<T>) -> Rc<T> {
        self.strong[0] = self.strong[0] + 1;
        return Rc { val: self.val, strong: self.strong };
    }

    // Decrement strong count; free both allocations when it reaches zero.
    pub unsafe fn drop_rc(self: *mut Rc<T>) {
        self.strong[0] = self.strong[0] - 1;
        if self.strong[0] == 0 {
            dealloc(self.val    as *mut u8);
            dealloc(self.strong as *mut u8);
        }
        self.val    = 0 as *mut T;
        self.strong = 0 as *mut i32;
    }
}
