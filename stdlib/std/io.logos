// Logos standard library — std.io

package std.io;

use std.string;

extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;

pub fn println(s: str) {
    unsafe {
        write(1, s.as_ptr(), s.len());
        let nl: str = "\n";
        write(1, nl.as_ptr(), 1);
    }
}

pub fn println_string(s: &String) {
    unsafe {
        write(1, s.as_ptr(), s.len());
        let nl: str = "\n";
        write(1, nl.as_ptr(), 1);
    }
}
