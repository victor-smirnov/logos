// Logos standard library -- std.math
//
// Thin wrappers over libm. f64 only; cast explicitly for f32.

package std.math;

// ---- constants (functions since Logos has no top-level consts) -------------

pub fn PI()     -> f64 { return 3.141592653589793; }
pub fn TAU()    -> f64 { return 6.283185307179586; }
pub fn E()      -> f64 { return 2.718281828459045; }
pub fn SQRT_2() -> f64 { return 1.4142135623730951; }
pub fn LN_2()   -> f64 { return 0.6931471805599453; }
pub fn LN_10()  -> f64 { return 2.302585092994046; }

// ---- libm ------------------------------------------------------------------

extern fn sqrt(x: f64)  -> f64;
extern fn cbrt(x: f64)  -> f64;
extern fn hypot(x: f64, y: f64) -> f64;

extern fn sin(x: f64)   -> f64;
extern fn cos(x: f64)   -> f64;
extern fn tan(x: f64)   -> f64;
extern fn asin(x: f64)  -> f64;
extern fn acos(x: f64)  -> f64;
extern fn atan(x: f64)  -> f64;
extern fn atan2(y: f64, x: f64) -> f64;

extern fn sinh(x: f64)  -> f64;
extern fn cosh(x: f64)  -> f64;
extern fn tanh(x: f64)  -> f64;

extern fn exp(x: f64)   -> f64;
extern fn exp2(x: f64)  -> f64;
extern fn expm1(x: f64) -> f64;

extern fn log(x: f64)   -> f64;  // natural log
extern fn log2(x: f64)  -> f64;
extern fn log10(x: f64) -> f64;
extern fn log1p(x: f64) -> f64;

extern fn pow(x: f64, y: f64) -> f64;

extern fn floor(x: f64) -> f64;
extern fn ceil(x: f64)  -> f64;
extern fn round(x: f64) -> f64;
extern fn trunc(x: f64) -> f64;

extern fn fabs(x: f64)  -> f64;
extern fn fmod(x: f64, y: f64) -> f64;
extern fn copysign(x: f64, y: f64) -> f64;

// ---- public wrappers -------------------------------------------------------

pub fn sqrt_f64(x: f64)  -> f64 { unsafe { return sqrt(x);  } }
pub fn cbrt_f64(x: f64)  -> f64 { unsafe { return cbrt(x);  } }
pub fn hypot_f64(x: f64, y: f64) -> f64 { unsafe { return hypot(x, y); } }

pub fn sin_f64(x: f64)   -> f64 { unsafe { return sin(x);   } }
pub fn cos_f64(x: f64)   -> f64 { unsafe { return cos(x);   } }
pub fn tan_f64(x: f64)   -> f64 { unsafe { return tan(x);   } }
pub fn asin_f64(x: f64)  -> f64 { unsafe { return asin(x);  } }
pub fn acos_f64(x: f64)  -> f64 { unsafe { return acos(x);  } }
pub fn atan_f64(x: f64)  -> f64 { unsafe { return atan(x);  } }
pub fn atan2_f64(y: f64, x: f64) -> f64 { unsafe { return atan2(y, x); } }

pub fn sinh_f64(x: f64)  -> f64 { unsafe { return sinh(x);  } }
pub fn cosh_f64(x: f64)  -> f64 { unsafe { return cosh(x);  } }
pub fn tanh_f64(x: f64)  -> f64 { unsafe { return tanh(x);  } }

pub fn exp_f64(x: f64)   -> f64 { unsafe { return exp(x);   } }
pub fn exp2_f64(x: f64)  -> f64 { unsafe { return exp2(x);  } }
pub fn expm1_f64(x: f64) -> f64 { unsafe { return expm1(x); } }

pub fn ln_f64(x: f64)    -> f64 { unsafe { return log(x);   } }
pub fn log2_f64(x: f64)  -> f64 { unsafe { return log2(x);  } }
pub fn log10_f64(x: f64) -> f64 { unsafe { return log10(x); } }
pub fn ln_1p_f64(x: f64) -> f64 { unsafe { return log1p(x); } }

pub fn pow_f64(x: f64, y: f64) -> f64 { unsafe { return pow(x, y); } }

pub fn floor_f64(x: f64) -> f64 { unsafe { return floor(x); } }
pub fn ceil_f64(x: f64)  -> f64 { unsafe { return ceil(x);  } }
pub fn round_f64(x: f64) -> f64 { unsafe { return round(x); } }
pub fn trunc_f64(x: f64) -> f64 { unsafe { return trunc(x); } }

pub fn abs_f64(x: f64)   -> f64 { unsafe { return fabs(x);  } }
pub fn fmod_f64(x: f64, y: f64) -> f64 { unsafe { return fmod(x, y); } }
pub fn copysign_f64(x: f64, y: f64) -> f64 { unsafe { return copysign(x, y); } }

// ---- integer helpers -------------------------------------------------------

pub fn abs_i64(x: i64) -> i64 { if x < 0 as i64 { return 0 as i64 - x; } return x; }
pub fn abs_i32(x: i32) -> i32 { if x < 0 { return 0 - x; } return x; }

pub fn min_i64(a: i64, b: i64) -> i64 { if a < b { return a; } return b; }
pub fn max_i64(a: i64, b: i64) -> i64 { if a > b { return a; } return b; }
pub fn min_i32(a: i32, b: i32) -> i32 { if a < b { return a; } return b; }
pub fn max_i32(a: i32, b: i32) -> i32 { if a > b { return a; } return b; }

pub fn min_f64(a: f64, b: f64) -> f64 { if a < b { return a; } return b; }
pub fn max_f64(a: f64, b: f64) -> f64 { if a > b { return a; } return b; }
