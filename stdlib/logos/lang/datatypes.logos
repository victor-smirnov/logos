// Logos stdlib — logos.lang.datatypes
//
// Datatype — the bridge between a datatype's *processing* format
// (what code sees and works with: `StringView`, `I64View`, …) and its
// *storage* format (how it lives in a typed homogeneous container like
// `Buffer<DT>`).

package logos.lang.datatypes;

use std.drop;
use std.mem;

// ---------------------------------------------------------------------------
// Storage hierarchy — three orthogonal axes factored into a trait hierarchy.
//
//   Storage            — base capability: length, element-type, indexed read.
//   OwningStorage      — holds its own lifetime; must be explicitly dropped.
//   DynamicStorage     — OwningStorage + grows (push, clear).
//   BorrowedStorage    — read-only view, no ownership, safe to discard.
//
// Concrete implementations pick one leaf:
//   PrimVec<T>         : DynamicStorage<Elem = T>            (Vec-like)
//   ZoneSlice<T>       : OwningStorage<Elem = T>             (zone-scoped)
//   MmapView<T>        : BorrowedStorage<Elem = T>           (read-only)
//
// A `Datatype` will select one of these leaves per context and derive its
// `View<S>` from the leaf's capabilities (see Datatype trait below).
// ---------------------------------------------------------------------------

pub trait Storage {
    type Elem;
    fn storage_len(s: *const Self) -> u64;
}

pub trait OwningStorage: Storage {
    fn storage_drop(s: *mut Self);
}

pub trait DynamicStorage: OwningStorage {
    fn storage_new()  -> Self;
    fn storage_push(s: *mut Self, v: Self::Elem);
    fn storage_clear(s: *mut Self);
}

pub trait BorrowedStorage: Storage {
    // Read-only view; no drop, no grow. Marker-like, relies on Storage.
}

// ---------------------------------------------------------------------------
// Datatype — View ↔ Storage bridge.
// ---------------------------------------------------------------------------

pub trait Datatype {
    type View;
    type Storage;

    fn storage_new() -> Self::Storage;
    fn storage_drop(s: *mut Self::Storage);
    fn storage_len(s: *const Self::Storage) -> u64;
    fn storage_push(s: *mut Self::Storage, v: Self::View);
    fn storage_get(s: *const Self::Storage, idx: u64) -> Self::View;
}

// ---------------------------------------------------------------------------
// Buffer<DT> — typed homogeneous container.
//
// Callers push/get `DT::View`.  Storage layout is `DT::Storage`.
// Drop releases heap memory via the per-type `storage_drop` hook.
// ---------------------------------------------------------------------------

pub struct Buffer<DT: Datatype> {
    storage: DT::Storage,
}

impl<DT: Datatype> Buffer<DT> {
    pub static fn new() -> Buffer<DT> {
        return Buffer { storage: DT::storage_new() };
    }

    pub fn len(&self) -> u64 {
        unsafe {
            let sp: *const DT::Storage = &self.storage as *const DT::Storage;
            return DT::storage_len(sp);
        }
    }

    pub fn push(&mut self, v: DT::View) {
        unsafe {
            let sp: *mut DT::Storage =
                (&self.storage as *const DT::Storage) as *mut DT::Storage;
            DT::storage_push(sp, v);
        }
    }

    pub fn get(&self, idx: u64) -> DT::View {
        unsafe {
            let sp: *const DT::Storage = &self.storage as *const DT::Storage;
            return DT::storage_get(sp, idx);
        }
    }
}

impl<DT: Datatype> Drop for Buffer<DT> {
    fn drop(self: Buffer<DT>) {
        unsafe {
            let sp: *mut DT::Storage =
                (&self.storage as *const DT::Storage) as *mut DT::Storage;
            DT::storage_drop(sp);
        }
    }
}

// ---------------------------------------------------------------------------
// Primitive — marker trait + inline-storage mapping.
//
// A datatype is `Primitive` iff its processing type IS its storage element —
// no struct view, no padding, no tag bytes.  `Prim` names the inline type
// (i64 for I64, u64 for U64, …).  The blanket `impl<DT: Primitive> Datatype`
// below handles the Vec-like `Buffer<DT>` machinery for all such types.
// ---------------------------------------------------------------------------

pub trait Primitive {
    type Prim;
}

// ---------------------------------------------------------------------------
// PrimVec<T> — generic Vec-like backing store for primitives.
//
// Own heap buffer, grow-on-push.  Used by the Primitive blanket impl below;
// also usable directly for typed arrays.
// ---------------------------------------------------------------------------

pub struct PrimVec<T> {
    pub data: *mut T,
    pub len:  u64,
    pub cap:  u64,
}

impl<T> PrimVec<T> {
    pub static fn empty() -> PrimVec<T> {
        return PrimVec { data: 0 as *mut T, len: 0 as u64, cap: 0 as u64 };
    }

    pub fn push(&mut self, v: T) {
        unsafe {
            let stride: i64 = sizeof::<T>();
            if self.len == self.cap {
                let new_cap: u64 = if self.cap == 0 as u64 { 4 as u64 } else { self.cap * 2 as u64 };
                let bytes: i64 = (new_cap as i64) * stride;
                let new_buf: *mut u8 = if self.data == 0 as *mut T {
                    alloc(bytes)
                } else {
                    realloc_buf(self.data as *mut u8, bytes)
                };
                if new_buf == 0 as *mut u8 { return; }
                self.data = new_buf as *mut T;
                self.cap  = new_cap;
            }
            let slot: *mut T = (self.data as i64 + (self.len as i64) * stride) as *mut T;
            *slot = v;
            self.len = self.len + 1 as u64;
        }
    }

    pub fn get(&self, idx: u64) -> T {
        unsafe {
            let stride: i64 = sizeof::<T>();
            let slot: *const T = (self.data as i64 + (idx as i64) * stride) as *const T;
            return *slot;
        }
    }

    pub fn clear(&mut self) {
        unsafe {
            if self.data != 0 as *mut T {
                dealloc(self.data as *mut u8);
                self.data = 0 as *mut T;
                self.len  = 0 as u64;
                self.cap  = 0 as u64;
            }
        }
    }
}

// PrimVec<T> plugs into the Storage hierarchy as a DynamicStorage<Elem=T>.
// This lets generic code request any dynamic backing store via the trait
// rather than naming PrimVec directly.

impl<T> Storage for PrimVec<T> {
    type Elem = T;
    fn storage_len(s: *const PrimVec<T>) -> u64 {
        unsafe { return s.len; }
    }
}

impl<T> OwningStorage for PrimVec<T> {
    fn storage_drop(s: *mut PrimVec<T>) {
        unsafe { s.clear(); }
    }
}

impl<T> DynamicStorage for PrimVec<T> {
    fn storage_new() -> PrimVec<T> {
        return PrimVec::<T>::empty();
    }
    fn storage_push(s: *mut PrimVec<T>, v: T) {
        unsafe { s.push(v); }
    }
    fn storage_clear(s: *mut PrimVec<T>) {
        unsafe { s.clear(); }
    }
}

// ---------------------------------------------------------------------------
// Blanket: every `Primitive` datatype gets `Datatype` for free.
// View = DT::Prim (the inline type); Storage = PrimVec<DT::Prim>.
// ---------------------------------------------------------------------------

impl<DT: Primitive> Datatype for DT {
    type View    = DT::Prim;
    type Storage = PrimVec<DT::Prim>;

    fn storage_new() -> PrimVec<DT::Prim> {
        return PrimVec::<DT::Prim>::empty();
    }
    fn storage_drop(s: *mut PrimVec<DT::Prim>) {
        unsafe { s.clear(); }
    }
    fn storage_len(s: *const PrimVec<DT::Prim>) -> u64 {
        unsafe { return s.len; }
    }
    fn storage_push(s: *mut PrimVec<DT::Prim>, v: DT::Prim) {
        unsafe { s.push(v); }
    }
    fn storage_get(s: *const PrimVec<DT::Prim>, idx: u64) -> DT::Prim {
        unsafe { return s.get(idx); }
    }
}
