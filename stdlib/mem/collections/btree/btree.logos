// Logos standard library — std.btree
//
// BTreeMap<K: Ord, V> — ordered map backed by a sorted parallel-array.
//
// Complexity:
//   get / contains_key : O(log n) — binary search
//   insert / remove    : O(n)     — element shift
//
// This is a sorted-vector map, not a proper B-tree, but it has the correct
// API and is simple enough to verify by inspection. A real B-tree can be
// swapped in later without changing callers.

package logos.mem.collections.btree;

use logos.lang.mem;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.ops;
use logos.lang.option;
use logos.lang.marker;
use logos.lang.default;
use logos.lang.stream;           // OrderedBy — the walk's order fact
use logos.std.wql.source;        // trait OrderedMapSource — the query plane's source vocabulary (#342)

/// Ordered map backed by a sorted parallel-array (not a real B-tree).
///
/// `get`/`contains_key` are `O(log n)` binary search; `insert`/`remove` are `O(n)`
/// due to element shifting.
///
/// The backing storage is freed on drop; `btreemap_free` does the same eagerly.
pub struct BTreeMap<K, V> {
    keys: *mut K,
    vals: *mut V,
    len:  i64,
    cap:  i64,
}

/// Creates a new, empty `BTreeMap` with initial capacity 8.
pub fn btreemap_new<K: Ord, V>() -> BTreeMap<K, V> {
    let init_cap: i64 = 8;
    let kraw: *mut u8 = alloc(init_cap * sizeof::<K>());
    let vraw: *mut u8 = alloc(init_cap * sizeof::<V>());
    return BTreeMap {
        keys: kraw as *mut K,
        vals: vraw as *mut V,
        len:  0 as i64,
        cap:  init_cap,
    };
}

impl<K: Ord, V> BTreeMap<K, V> {
    /// Returns the number of entries in the map.
    pub fn len(&self) -> i64 { return self.len; }

    /// Returns `true` if the map contains no entries.
    pub fn is_empty(&self) -> bool { return self.len == 0 as i64; }

    // Return index of the first element with key >= target (lower bound).
    unsafe fn lower_bound(&self, key: &K) -> i64 {
        let mut lo: i64 = 0;
        let mut hi: i64 = self.len;
        while lo < hi {
            let mid: i64 = lo + (hi - lo) / 2 as i64;
            match (&self.keys[mid]).cmp(key) {
                Ordering::Less => { lo = mid + 1 as i64; }
                _              => { hi = mid; }
            }
        }
        return lo;
    }

    /// Returns `true` if `key` is present in the map.
    pub fn contains_key(&self, key: &K) -> bool { unsafe {
        let pos: i64 = self.lower_bound(key);
        if pos >= self.len { return false; }
        match (&self.keys[pos]).cmp(key) {
            Ordering::Equal => { return true; }
            _               => { return false; }
        }
    } }

    /// Returns a pointer to the value for `key`, or a null `*const V` if absent.
    pub unsafe fn get(&self, key: &K) -> *const V {
        let pos: i64 = self.lower_bound(key);
        if pos >= self.len { return 0 as *const V; }
        match (&self.keys[pos]).cmp(key) {
            Ordering::Equal => { return &self.vals[pos] as *const V; }
            _               => { return 0 as *const V; }
        }
    }

    /// Returns a mutable pointer to the value for `key`, or a null `*mut V` if absent.
    pub unsafe fn get_mut(&mut self, key: &K) -> *mut V {
        let pos: i64 = self.lower_bound(key);
        if pos >= self.len { return 0 as *mut V; }
        match (&self.keys[pos]).cmp(key) {
            Ordering::Equal => { return &mut self.vals[pos]; }
            _               => { return 0 as *mut V; }
        }
    }

    /// Inserts `key`/`val`, overwriting the existing value if `key` is already present.
    /// Grows the backing storage (doubling capacity) when full.
    pub fn insert(&mut self, key: K, val: V) { unsafe {
        let pos: i64 = self.lower_bound(&key);
        // If key already present, update value in place.
        if pos < self.len {
            match (&self.keys[pos]).cmp(&key) {
                Ordering::Equal => {
                    let _old: V = self.vals[pos];   // the replaced value is dropped (and `key`)
                    self.vals[pos] = val;
                    return;
                }
                _ => { }
            }
        }
        // Grow if needed.
        if self.len == self.cap {
            self.cap = self.cap * 2 as i64;
            let new_kraw: *mut u8 = realloc_buf(self.keys as *mut u8, self.cap * sizeof::<K>());
            let new_vraw: *mut u8 = realloc_buf(self.vals as *mut u8, self.cap * sizeof::<V>());
            self.keys = new_kraw as *mut K;
            self.vals = new_vraw as *mut V;
        }
        // Shift elements at [pos..len) right by one to make room.
        let mut j: i64 = self.len;
        while j > pos {
            self.keys[j] = self.keys[j - 1 as i64];
            self.vals[j] = self.vals[j - 1 as i64];
            j = j - 1 as i64;
        }
        self.keys[pos] = key;
        self.vals[pos] = val;
        self.len = self.len + 1 as i64;
    } }

    /// Removes `key` from the map, returning its value if it was present (Rust's
    /// `BTreeMap::remove`); the stored key is dropped.
    pub fn remove(&mut self, key: &K) -> Option<V> { unsafe {
        let pos: i64 = self.lower_bound(key);
        if pos >= self.len { return Option::None; }
        match (&self.keys[pos]).cmp(key) {
            Ordering::Equal => { }
            _               => { return Option::None; }
        }
        let _k: K = self.keys[pos];      // the stored key: moved out, dropped here
        let v: V = self.vals[pos];
        let mut j: i64 = pos + 1 as i64;
        while j < self.len {
            self.keys[j - 1 as i64] = self.keys[j];
            self.vals[j - 1 as i64] = self.vals[j];
            j = j + 1 as i64;
        }
        self.len = self.len - 1 as i64;
        return Option::Some(v);
    } }

    /// Removes and drops every entry; the backing storage is kept.
    pub fn clear(&mut self) { unsafe {
        let mut i: i64 = 0;
        while i < self.len {
            let _k: K = self.keys[i];    // moved out and dropped
            let _v: V = self.vals[i];
            i = i + 1 as i64;
        }
        self.len = 0 as i64;
    } }

    /// Returns an iterator over `(&K, &V)` pairs in ascending key order.
    pub fn iter<'a>(&self) -> BTreeMapIter<'a, K, V> { unsafe {
        return BTreeMapIter {
            keys: self.keys as *const K,
            vals: self.vals as *const V,
            len:  self.len,
            idx:  0 as i64,
        };
    } }
}

// ── Iterator ─────────────────────────────────────────────────────────────────

/// Iterator over a `BTreeMap`'s entries in ascending key order, yielding `(&K, &V)`.
// `'a` is the map's borrow: items borrow the map, not the iterator.
pub struct BTreeMapIter<'a, K, V> {
    keys: *const K,
    vals: *const V,
    len:  i64,
    idx:  i64,
}

// Yields `(&K, &V)` (Rust-conformant: `BTreeMap::iter()` borrows entries). The
// keys/vals parallel arrays are stable during iteration, so `next()` returns
// references into them rather than copying.
impl<'a, K: Ord, V> Iterator for BTreeMapIter<'a, K, V> {
    type Item = (&'a K, &'a V);
    fn next(self: &mut BTreeMapIter<'a, K, V>) -> Option<(&'a K, &'a V)> {
        if self.idx >= self.len { return Option::None; }
        unsafe {
            // Through a raw pointer the references are unbounded: 'a.
            let kp: *const K = &self.keys[self.idx] as *const K;
            let vp: *const V = &self.vals[self.idx] as *const V;
            let k: &'a K = &*kp;
            let v: &'a V = &*vp;
            self.idx = self.idx + 1 as i64;
            return Option::Some((k, v));
        }
    }
}

/// Drops every entry, deallocates the `keys`/`vals` backing storage of `m` and nulls
/// both fields, so that the `Drop` impl below is a no-op afterwards.  Calling this is
/// optional: the map drops its entries and frees its storage on drop.
pub unsafe fn btreemap_free<K: Ord, V>(m: *mut BTreeMap<K, V>) {
    if m.keys as i64 != 0 as i64 { (*m).clear(); }
    if m.keys as i64 != 0 as i64 {
        dealloc(m.keys as *mut u8);
        m.keys = 0 as *mut K;
    }
    if m.vals as i64 != 0 as i64 {
        dealloc(m.vals as *mut u8);
        m.vals = 0 as *mut V;
    }
}

// The map owns its entries and its two parallel arrays: on drop every live key and
// value is dropped, then the arrays are released -- guarded as `btreemap_free`
// is, so free-then-scope-exit drops and frees exactly once.
impl<K, V> Drop for BTreeMap<K, V> {
    fn drop(self: &mut BTreeMap<K, V>) {
        unsafe {
            if self.keys as i64 != 0 as i64 {
                let mut i: i64 = 0;
                while i < self.len {
                    let _k: K = self.keys[i];
                    let _v: V = self.vals[i];
                    i = i + 1 as i64;
                }
                self.len = 0 as i64;
            }
            if self.keys as i64 != 0 as i64 {
                dealloc(self.keys as *mut u8);
                self.keys = 0 as *mut K;
            }
            if self.vals as i64 != 0 as i64 {
                dealloc(self.vals as *mut u8);
                self.vals = 0 as *mut V;
            }
        }
    }
}

// ── Rust's safe surface: new / iter_mut / values_mut / first / last / pop / into_iter ──

impl<K: Ord, V> BTreeMap<K, V> {
    /// Creates an empty map (Rust's `BTreeMap::new`).
    pub fn new() -> BTreeMap<K, V> { return btreemap_new::<K, V>(); }

    /// The entry with the smallest key, or `None` if empty.
    pub fn first_key_value(&self) -> Option<(&K, &V)> {
        if self.len == 0 as i64 { return Option::None; }
        unsafe {
            let kp: *const K = &self.keys[0 as i64] as *const K;
            let vp: *const V = &self.vals[0 as i64] as *const V;
            return Option::Some((&*kp, &*vp));
        }
    }

    /// The entry with the largest key, or `None` if empty.
    pub fn last_key_value(&self) -> Option<(&K, &V)> {
        if self.len == 0 as i64 { return Option::None; }
        unsafe {
            let i: i64 = self.len - 1 as i64;
            let kp: *const K = &self.keys[i] as *const K;
            let vp: *const V = &self.vals[i] as *const V;
            return Option::Some((&*kp, &*vp));
        }
    }

    /// Removes and returns the entry with the smallest key.
    pub fn pop_first(&mut self) -> Option<(K, V)> {
        if self.len == 0 as i64 { return Option::None; }
        unsafe {
            let p: *mut BTreeMap<K, V> = self as *mut BTreeMap<K, V>;
            let k: K = p.keys[0 as i64];
            let v: V = p.vals[0 as i64];
            let mut j: i64 = 1 as i64;
            while j < p.len {
                p.keys[j - 1 as i64] = p.keys[j];
                p.vals[j - 1 as i64] = p.vals[j];
                j = j + 1 as i64;
            }
            p.len = p.len - 1 as i64;
            return Option::Some((k, v));
        }
    }

    /// Removes and returns the entry with the largest key.
    pub fn pop_last(&mut self) -> Option<(K, V)> {
        if self.len == 0 as i64 { return Option::None; }
        unsafe {
            let p: *mut BTreeMap<K, V> = self as *mut BTreeMap<K, V>;
            p.len = p.len - 1 as i64;
            let k: K = p.keys[p.len];
            let v: V = p.vals[p.len];
            return Option::Some((k, v));
        }
    }

    /// Iterator yielding `(&K, &mut V)` in ascending key order.
    pub fn iter_mut<'a>(self: &'a mut BTreeMap<K, V>) -> BTreeMapIterMut<'a, K, V> {
        return BTreeMapIterMut { keys: self.keys as *const K, vals: self.vals, len: self.len,
                                 idx: 0 as i64, _inv: PhantomData::<&'a mut V> {} };
    }

    /// Iterator yielding `&mut V` in ascending key order.
    pub fn values_mut<'a>(self: &'a mut BTreeMap<K, V>) -> BTreeMapValuesMut<'a, K, V> {
        return BTreeMapValuesMut { vals: self.vals, len: self.len, idx: 0 as i64,
                                   _inv: PhantomData::<&'a mut V> {} };
    }
}

/// Iterator over `(&K, &mut V)` entries of a `BTreeMap`, ascending.
#[borrow_carrying]
pub struct BTreeMapIterMut<'a, K, V> {
    keys: *const K,
    vals: *mut V,
    len:  i64,
    idx:  i64,
    _inv: PhantomData<&'a mut V>,
}

impl<'a, K: Ord, V> Iterator for BTreeMapIterMut<'a, K, V> {
    type Item = (&'a K, &'a mut V);
    fn next(self: &mut BTreeMapIterMut<'a, K, V>) -> Option<(&'a K, &'a mut V)> {
        if self.idx >= self.len { return Option::None; }
        unsafe {
            let kp: *const K = &self.keys[self.idx] as *const K;
            let vp: *mut V = &mut self.vals[self.idx] as *mut V;
            self.idx = self.idx + 1 as i64;
            let k: &'a K = &*kp;
            let v: &'a mut V = &mut *vp;
            return Option::Some((k, v));
        }
    }
}

/// Iterator over `&mut V` values of a `BTreeMap`, ascending by key.
#[borrow_carrying]
pub struct BTreeMapValuesMut<'a, K, V> {
    vals: *mut V,
    len:  i64,
    idx:  i64,
    _inv: PhantomData<&'a mut V>,
}

impl<'a, K: Ord, V> Iterator for BTreeMapValuesMut<'a, K, V> {
    type Item = &'a mut V;
    fn next(self: &mut BTreeMapValuesMut<'a, K, V>) -> Option<&'a mut V> {
        if self.idx >= self.len { return Option::None; }
        unsafe {
            let vp: *mut V = &mut self.vals[self.idx] as *mut V;
            self.idx = self.idx + 1 as i64;
            let v: &'a mut V = &mut *vp;
            return Option::Some(v);
        }
    }
}

/// Owning iterator over a `BTreeMap` (`for (k, v) in map`); yields `(K, V)` ascending.
/// Un-yielded entries are dropped with the iterator, which frees the arrays.
pub struct BTreeMapIntoIter<K, V> {
    keys: *mut K,
    vals: *mut V,
    len:  i64,
    idx:  i64,
}

impl<K, V> Iterator for BTreeMapIntoIter<K, V> {
    type Item = (K, V);
    fn next(self: &mut BTreeMapIntoIter<K, V>) -> Option<(K, V)> {
        if self.idx >= self.len { return Option::None; }
        unsafe {
            let k: K = self.keys[self.idx];
            let v: V = self.vals[self.idx];
            self.idx = self.idx + 1 as i64;
            return Option::Some((k, v));
        }
    }
}

impl<K, V> Drop for BTreeMapIntoIter<K, V> {
    fn drop(self: &mut BTreeMapIntoIter<K, V>) {
        unsafe {
            if self.keys as i64 != 0 as i64 {
                while self.idx < self.len {
                    let _k: K = self.keys[self.idx];
                    let _v: V = self.vals[self.idx];
                    self.idx = self.idx + 1 as i64;
                }
                dealloc(self.keys as *mut u8);
                dealloc(self.vals as *mut u8);
                self.keys = 0 as *mut K;
            }
        }
    }
}

// `for (k, v) in map` — consumes the map: the arrays move to the iterator and the
// map's own drop becomes a no-op (null `keys`/`vals`).
impl<K: Ord, V> IntoIterator for BTreeMap<K, V> {
    type Item = (K, V);
    type IntoIter = BTreeMapIntoIter<K, V>;
    fn into_iter(self: BTreeMap<K, V>) -> BTreeMapIntoIter<K, V> {
        let it: BTreeMapIntoIter<K, V> = BTreeMapIntoIter {
            keys: self.keys, vals: self.vals, len: self.len, idx: 0 as i64,
        };
        let mut m: BTreeMap<K, V> = self;
        m.keys = 0 as *mut K;
        m.vals = 0 as *mut V;
        m.len = 0 as i64;
        return it;
    }
}

impl<K: Ord, V> Default for BTreeMap<K, V> {
    fn default() -> BTreeMap<K, V> { return btreemap_new::<K, V>(); }
}

// `iter.collect::<BTreeMap<K, V>>()` over `(K, V)` pairs; a later duplicate key
// replaces the earlier value.
impl<K: Ord, V> FromIterator<(K, V)> for BTreeMap<K, V> {
    fn from_iter<I: Iterator<Item = (K, V)>>(iter: I) -> BTreeMap<K, V> {
        let mut m: BTreeMap<K, V> = btreemap_new::<K, V>();
        let mut it: I = iter;
        loop {
            match it.next() {
                Option::None         => { return m; }
                Option::Some((k, v)) => { unsafe { m.insert(k, v); } }
            }
        }
    }
}

// ── the query plane (ADR 0024 S6) ───────────────────────────────────────────
//
// The ordered counterpart of the HashMap declaration, and the other half of the
// proof: same mechanism, different capabilities, no planner change. A sorted
// map can be probed AND positioned, so it declares three operations and
// implements `OrderedMapSource` — the trait that IS the order fact.
//
// All three are EXACT: the landing is a binary search and the walk stops on the
// bound, so each returns precisely the rows of its comparison and a query
// narrowed by one needs no residual filter. `upto` being exact is the case that
// makes exactness worth declaring rather than deriving — it is a RANGE, and the
// rule "range ⇒ superset" would have been wrong about it.

/// A window `[at, end)` of a map's entries, yielded as `(K, V)` rows in key
/// order — the one producer type of the four doors below. Reads the parallel
/// key/value arrays in place: no row is copied before the query asks for it.
// Raw pointers, as `BTreeMapIter`: the arrays are stable while the map is
// borrowed, and the query that holds the walk holds that borrow.
pub struct BTreeRows<K, V> {
    keys: *const K,
    vals: *const V,
    at:   i64,
    end:  i64,
}

impl<K: Ord + Copy, V: Copy> Iterator for BTreeRows<K, V> {
    type Item = (K, V);
    fn next(self: &mut BTreeRows<K, V>) -> Option<(K, V)> {
        if self.at >= self.end { return Option::None; }
        unsafe {
            let r: (K, V) = (self.keys[self.at], self.vals[self.at]);
            self.at = self.at + 1i64;
            return Option::Some(r);
        }
    }
}

// THE ORDER FACT (ADR 0026 F6): every window is a run of the sorted key array.
// Forward-only — no `Bidirectional`/`RandomAccess` — so an `order by … desc`
// keeps its Sort node.
impl<K: Ord + Copy, V: Copy> OrderedBy<K> for BTreeRows<K, V> { }

fn btree_window<K: Ord + Copy, V: Copy>(m: &BTreeMap<K, V>, at: i64, end: i64) -> BTreeRows<K, V> {
    return BTreeRows { keys: m.keys as *const K, vals: m.vals as *const V, at: at, end: end };
}

/// Every entry as a row, in key order.
pub fn btree_rows<K: Ord + Copy, V: Copy>(m: &BTreeMap<K, V>) -> BTreeRows<K, V> {
    return btree_window::<K, V>(m, 0i64, m.len);
}

/// The point probe — the row for `k`, or none. EXACT for `==`.
pub fn btree_at<K: Ord + Copy, V: Copy>(m: &BTreeMap<K, V>, k: K) -> BTreeRows<K, V> {
    unsafe {
        let pos: i64 = m.lower_bound(&k);
        let mut end: i64 = pos;
        if pos < m.len {
            match (&m.keys[pos]).cmp(&k) {
                Ordering::Equal => { end = pos + 1i64; }
                _               => { }
            }
        }
        return btree_window::<K, V>(m, pos, end);
    }
}

/// The suffix from `lo` — one binary search. EXACT for `>=`.
pub fn btree_from<K: Ord + Copy, V: Copy>(m: &BTreeMap<K, V>, lo: K) -> BTreeRows<K, V> {
    unsafe { return btree_window::<K, V>(m, m.lower_bound(&lo), m.len); }
}

/// The prefix up to `hi`, inclusive — the window ends past the last key `<= hi`,
/// which is what makes a RANGE exact. EXACT for `<=`.
pub fn btree_upto<K: Ord + Copy, V: Copy>(m: &BTreeMap<K, V>, hi: K) -> BTreeRows<K, V> {
    unsafe {
        let mut end: i64 = m.lower_bound(&hi);
        if end < m.len {
            match (&m.keys[end]).cmp(&hi) {
                Ordering::Equal => { end = end + 1i64; }
                _               => { }
            }
        }
        return btree_window::<K, V>(m, 0i64, end);
    }
}

/// How many rows the relation holds (ADR 0024 S4). A `mem` collection carries
/// its length, so reporting a size costs nothing — and the plan asks once.
///
/// ⚠ The DECLARATION a human writes and the one a factory generates are the same
/// object: this is `size entry = <fn>;` exactly as Canon's generated family
/// writes it, and that identity is the test that the plane is not Memoria-shaped.
pub fn btree_len<K: Ord + Copy, V: Copy>(m: &BTreeMap<K, V>) -> i64 {
    return m.len();
}

impl<K: Ord + Copy, V: Copy> OrderedMapSource<K, V> for BTreeMap<K, V> {
    rel entry = btree_rows;
    op entry.key eq = btree_at    exact;
    op entry.key ge = btree_from  exact;
    op entry.key le = btree_upto  exact;
    size entry = btree_len;
    unique entry = key;   // a map holds one value per key (#322, ADR 0026 F8)
    order entry = key;    // the walk is `OrderedBy<K>` (ADR 0026 F6)
}
