// Logos standard library — std.hashmap
//
// HashMap<K: Hash + Eq, V> — open addressing with linear probing.
// Load factor 0.75, x2 resize. Capacity is always a power of two so
// `hash & (cap - 1)` works as modulo.
//
// Slot state (parallel u8 array):
//   0 = empty, 1 = occupied, 2 = tombstone (deleted).

package logos.mem.collections.hashmap;

use logos.lang.mem;
use logos.lang.hash;
use logos.lang.cmp;
use logos.lang.option;
use logos.lang.iter;
use logos.lang.ops;
use logos.lang.marker;
use logos.lang.default;
use logos.mem.collections.vec;   // Vec — the relational projection's rows
use logos.mem.bt.map;            // trait MapSource — the query plane (ADR 0024 S6)

let SLOT_EMPTY:     u8 = 0 as u8;
let SLOT_OCCUPIED:  u8 = 1 as u8;
let SLOT_TOMBSTONE: u8 = 2 as u8;

struct Slot<K, V> {
    key: K,
    val: V,
}

/// Hash map with open addressing and linear probing; load factor 0.75, power-of-two capacity.
/// Mutating/lookup methods are `unsafe` and take raw `self` pointers; construct via
/// `hashmap_new` or `hashmap_with_capacity`.
pub struct HashMap<K, V> {
    states:  *mut u8,
    entries: *mut Slot<K, V>,
    len:     i64,
    cap:     i64,
}

/// Creates an empty `HashMap` with capacity 16.
pub fn hashmap_new<K: Hash + Eq, V>() -> HashMap<K, V> {
    return hashmap_with_capacity::<K, V>(16 as i64);
}

/// Creates an empty `HashMap` with `cap_hint` rounded up to a power of two (minimum 8).
pub fn hashmap_with_capacity<K: Hash + Eq, V>(cap_hint: i64) -> HashMap<K, V> {
    // Round up to next power of two, min 8.
    let mut cap: i64 = 8;
    while cap < cap_hint { cap = cap * 2; }
    let states_raw: *mut u8 = alloc(cap);
    unsafe {
        let mut i: i64 = 0;
        while i < cap { states_raw[i] = SLOT_EMPTY; i = i + 1; }
    }
    let entries_bytes: i64 = cap * sizeof::<Slot<K, V>>();
    let entries_raw: *mut u8 = alloc(entries_bytes);
    return HashMap {
        states:  states_raw,
        entries: entries_raw as *mut Slot<K, V>,
        len:     0 as i64,
        cap:     cap,
    };
}

impl<K: Hash + Eq, V> HashMap<K, V> {
    /// Returns the number of entries in the map.
    pub fn len(&self) -> i64 { return self.len; }

    /// Returns `true` if the map contains no entries.
    pub fn is_empty(&self) -> bool { return self.len == 0 as i64; }

    /// Returns the raw slot count of the table (always a power of two).
    pub fn capacity(&self) -> i64 { return self.cap; }

    // Compute starting slot index for a key: hash & (cap - 1).
    fn slot_index(&self, key: &K) -> i64 {
        let mut h: FxHasher = fx_hasher_new();
        key.hash(&mut h);
        let hv: u64 = h.finish();
        let mask: u64 = (self.cap - 1 as i64) as u64;
        return (hv & mask) as i64;
    }

    // Probe for the slot where `key` lives or where it would be inserted.
    // Returns (index, found) where found=true if the key is already there.
    unsafe fn probe(&mut self, key: &K) -> (i64, bool) {
        let mask: i64 = self.cap - 1 as i64;
        let mut idx: i64 = (*self).slot_index(key);
        let mut first_tomb: i64 = -1 as i64;
        loop {
            let st: u8 = self.states[idx];
            if st == SLOT_EMPTY {
                if first_tomb >= 0 as i64 { return (first_tomb, false); }
                return (idx, false);
            }
            if st == SLOT_TOMBSTONE {
                if first_tomb < 0 as i64 { first_tomb = idx; }
            } else {
                let e: *mut Slot<K, V> = &mut self.entries[idx];
                if key.eq(&e.key) { return (idx, true); }
            }
            idx = (idx + 1 as i64) & mask;
        }
    }

    /// Inserts `key` → `val`, overwriting the value if `key` is already present.
    /// Resizes (x2) when the post-insert load factor would exceed 0.75.
    pub unsafe fn insert(&mut self, key: K, val: V) -> Option<V> {
        // Resize when load factor exceeds 0.75.
        // (self.len + 1) * 4 > self.cap * 3  ⇔  load > 0.75 after insert.
        if (self.len + 1 as i64) * 4 as i64 > self.cap * 3 as i64 {
            self.resize(self.cap * 2 as i64);
        }
        let (idx, found) = self.probe(&key);
        let e: *mut Slot<K, V> = &mut self.entries[idx];
        if found {
            // Rust's `insert`: the old value is returned, the stored key kept (the
            // new `key` drops at the end of this call). A raw field write does not
            // drop, so the old value is moved out first — it leaked before.
            let old: V = logos.lang.ptr::read(&e.val as *const V);
            e.val = val;
            return Option::Some(old);
        }
        e.key = key;
        e.val = val;
        self.states[idx] = SLOT_OCCUPIED;
        self.len = self.len + 1 as i64;
        return Option::None;
    }

    /// Returns `true` if the map contains `key`.
    pub unsafe fn contains_key(&mut self, key: &K) -> bool {
        let (idx, found) = self.probe(key);
        return found;
    }

    /// Returns a pointer to the value for `key`, or null if absent.
    pub unsafe fn get(&mut self, key: &K) -> *const V {
        let (idx, found) = self.probe(key);
        if !found { return 0 as *const V; }
        let e: *mut Slot<K, V> = &mut self.entries[idx];
        return &e.val as *const V;
    }

    /// Returns a mutable pointer to the value for `key`, or null if absent.
    pub unsafe fn get_mut(&mut self, key: &K) -> *mut V {
        let (idx, found) = self.probe(key);
        if !found { return 0 as *mut V; }
        let e: *mut Slot<K, V> = &mut self.entries[idx];
        return &mut e.val as *mut V;
    }

    /// Returns a pointer to the value bound to `key`, inserting `default` if absent.
    /// Single-probe find-or-insert (Rust's `entry().or_insert()`): ONE probe + ONE hash vs
    /// get-then-insert's two of each — the idiomatic count/accumulate path
    /// (`*m.get_or_insert(k, 0) += 1`). If `key` is already present, `default` is dropped.
    pub unsafe fn get_or_insert(&mut self, key: K, default: V) -> *mut V {
        if (self.len + 1 as i64) * 4 as i64 > self.cap * 3 as i64 {
            self.resize(self.cap * 2 as i64);
        }
        let (idx, found) = self.probe(&key);
        let e: *mut Slot<K, V> = &mut self.entries[idx];
        if !found {
            e.key = key;
            e.val = default;
            self.states[idx] = SLOT_OCCUPIED;
            self.len = self.len + 1 as i64;
        }
        return &mut e.val as *mut V;
    }

    /// Removes `key` from the map, returning its value if it was present; the stored key is dropped.
    pub unsafe fn remove(&mut self, key: &K) -> Option<V> {
        // Rust's `remove`: the value is returned, the stored key dropped (both leaked before).
        let (idx, found) = self.probe(key);
        if !found { return Option::None; }
        let e: *mut Slot<K, V> = &mut self.entries[idx];
        let _k: K = logos.lang.ptr::read(&e.key as *const K);
        let v: V = logos.lang.ptr::read(&e.val as *const V);
        self.states[idx] = SLOT_TOMBSTONE;
        self.len = self.len - 1 as i64;
        return Option::Some(v);
    }

    /// Removes and drops all entries, resetting every slot (tombstones included) to empty.
    /// Capacity is retained.
    pub unsafe fn clear(&mut self) {
        let mut i: i64 = 0;
        while i < self.cap {
            if self.states[i] == SLOT_OCCUPIED {
                let e: *mut Slot<K, V> = &mut self.entries[i];
                let _k: K = logos.lang.ptr::read(&e.key as *const K);   // move-and-drop the live entry (#463)
                let _v: V = logos.lang.ptr::read(&e.val as *const V);
            }
            self.states[i] = SLOT_EMPTY;
            i = i + 1;
        }
        self.len = 0 as i64;
    }

    // Rebuild into a larger table (always a power of two).
    unsafe fn resize(&mut self, new_cap: i64) {
        let old_states:  *mut u8 = self.states;
        let old_entries: *mut Slot<K, V> = self.entries;
        let old_cap:     i64 = self.cap;

        let new_states: *mut u8 = alloc(new_cap);
        let mut i: i64 = 0;
        while i < new_cap { new_states[i] = SLOT_EMPTY; i = i + 1; }
        let new_entries_bytes: i64 = new_cap * sizeof::<Slot<K, V>>();
        let new_entries: *mut Slot<K, V> =
            alloc(new_entries_bytes) as *mut Slot<K, V>;

        self.states  = new_states;
        self.entries = new_entries;
        self.cap     = new_cap;
        self.len     = 0 as i64;

        let mut j: i64 = 0;
        while j < old_cap {
            if old_states[j] == SLOT_OCCUPIED {
                let e: *mut Slot<K, V> = &mut old_entries[j];
                self.insert(logos.lang.ptr::read(&e.key as *const K), logos.lang.ptr::read(&e.val as *const V));   // #463
            }
            j = j + 1 as i64;
        }

        dealloc(old_states);
        dealloc(old_entries as *mut u8);
    }
}

// ── Iteration ────────────────────────────────────────────────────────────────

/// Iterator over `(&K, &V)` entries of a `HashMap`; created by `iter()`.
/// Holds raw pointers into the table — inserting during iteration may resize and dangle them.
// `'a` is the map's borrow: items borrow the map, not the iterator.
pub struct HashMapIter<'a, K, V> {
    states:  *const u8,
    entries: *const Slot<K, V>,
    cap:     i64,
    idx:     i64,
}

// Yields `(&K, &V)` (Rust-conformant: `HashMap::iter()` borrows). The entries
// array is stable during iteration (resize only on insert), so `next()` returns
// references into the occupied slot rather than copying.
impl<'a, K: Hash + Eq, V> Iterator for HashMapIter<'a, K, V> {
    type Item = ZipPair<&'a K, &'a V>;
    fn next(self: &mut HashMapIter<'a, K, V>) -> Option<ZipPair<&'a K, &'a V>> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    let e: *const Slot<K, V> = &self.entries[i];
                    // Through a raw pointer the references are unbounded: 'a.
                    let kp: *const K = &e.key as *const K;
                    let vp: *const V = &e.val as *const V;
                    let k: &'a K = &*kp;
                    let v: &'a V = &*vp;
                    return Option::Some(ZipPair { first: k, second: v });
                }
            }
            return Option::None;
        }
    }
}

/// Iterator over `&K` keys of a `HashMap`; created by `keys()`.
pub struct HashMapKeys<'a, K, V> {
    states:  *const u8,
    entries: *const Slot<K, V>,
    cap:     i64,
    idx:     i64,
}

impl<'a, K: Hash + Eq, V> Iterator for HashMapKeys<'a, K, V> {
    type Item = &'a K;
    fn next(self: &mut HashMapKeys<'a, K, V>) -> Option<&'a K> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    let e: *const Slot<K, V> = &self.entries[i];
                    let kp: *const K = &e.key as *const K;
                    let k: &'a K = &*kp;
                    return Option::Some(k);
                }
            }
            return Option::None;
        }
    }
}

/// Iterator over `&V` values of a `HashMap`; created by `values()`.
pub struct HashMapValues<'a, K, V> {
    states:  *const u8,
    entries: *const Slot<K, V>,
    cap:     i64,
    idx:     i64,
}

impl<'a, K: Hash + Eq, V> Iterator for HashMapValues<'a, K, V> {
    type Item = &'a V;
    fn next(self: &mut HashMapValues<'a, K, V>) -> Option<&'a V> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    let e: *const Slot<K, V> = &self.entries[i];
                    let vp: *const V = &e.val as *const V;
                    let v: &'a V = &*vp;
                    return Option::Some(v);
                }
            }
            return Option::None;
        }
    }
}

impl<K: Hash + Eq, V> HashMap<K, V> {
    /// Returns an iterator yielding `ZipPair<&K, &V>` for each occupied entry.
    /// Order is arbitrary (table order). Do not insert while iterating.
    pub unsafe fn iter<'a>(&self) -> HashMapIter<'a, K, V> {
        return HashMapIter {
            states:  self.states as *const u8,
            entries: self.entries as *const Slot<K, V>,
            cap:     self.cap,
            idx:     0 as i64,
        };
    }

    /// Returns an iterator over the map's keys, in arbitrary order.
    pub unsafe fn keys<'a>(&self) -> HashMapKeys<'a, K, V> {
        return HashMapKeys {
            states:  self.states as *const u8,
            entries: self.entries as *const Slot<K, V>,
            cap:     self.cap,
            idx:     0 as i64,
        };
    }

    /// Returns an iterator over the map's values, in arbitrary order.
    pub unsafe fn values<'a>(&self) -> HashMapValues<'a, K, V> {
        return HashMapValues {
            states:  self.states as *const u8,
            entries: self.entries as *const Slot<K, V>,
            cap:     self.cap,
            idx:     0 as i64,
        };
    }
}

// Auto-Drop (Rust parity, mirrors Vec). On scope exit each occupied entry's key
// and value are moved out and dropped (firing K/V's Drop if any; no-op for
// POD/Copy), then the states + entries buffers are freed. No manual free. Drop
// needs no Hash/Eq bound — it only moves out, never probes.
impl<K, V> Drop for HashMap<K, V> {
    fn drop(self: &mut HashMap<K, V>) {
        unsafe {
            if self.states != 0 as *mut u8 {
                let mut i: i64 = 0;
                while i < self.cap {
                    if self.states[i] == SLOT_OCCUPIED {
                        let e: *mut Slot<K, V> = &mut self.entries[i];
                        let _k: K = logos.lang.ptr::read(&e.key as *const K);   // move-and-drop (#463)
                        let _v: V = logos.lang.ptr::read(&e.val as *const V);
                    }
                    i = i + 1 as i64;
                }
                dealloc(self.states);
                dealloc(self.entries as *mut u8);
            }
        }
    }
}

// ── Rust's safe surface: new / entry / iter_mut / values_mut / owning into_iter ──

impl<K: Hash + Eq, V> HashMap<K, V> {
    /// Creates an empty map (Rust's `HashMap::new`).
    pub fn new() -> HashMap<K, V> { return hashmap_new::<K, V>(); }

    /// The slot for `key`, occupied or vacant, for in-place manipulation (Rust's
    /// `HashMap::entry`). Room for one more entry is made up front, so a vacant
    /// entry's insert never resizes under the entry's borrow.
    pub fn entry<'a>(self: &'a mut HashMap<K, V>, key: K) -> Entry<'a, K, V> {
        unsafe {
            let p: *mut HashMap<K, V> = self as *mut HashMap<K, V>;
            if (p.len + 1 as i64) * 4 as i64 > p.cap * 3 as i64 {
                (*p).resize(p.cap * 2 as i64);
            }
            let (idx, found) = (*p).probe(&key);
            return Entry { map: p, idx: idx, found: found, key: key, _inv: PhantomData::<&'a mut V> {} };
        }
    }

    /// Iterator yielding `ZipPair<&K, &mut V>` for each entry, in table order.
    pub fn iter_mut<'a>(self: &'a mut HashMap<K, V>) -> HashMapIterMut<'a, K, V> {
        return HashMapIterMut { states: self.states as *const u8, entries: self.entries,
                                cap: self.cap, idx: 0 as i64, _inv: PhantomData::<&'a mut V> {} };
    }

    /// Iterator yielding `&mut V` for each entry, in table order.
    pub fn values_mut<'a>(self: &'a mut HashMap<K, V>) -> HashMapValuesMut<'a, K, V> {
        return HashMapValuesMut { states: self.states as *const u8, entries: self.entries,
                                  cap: self.cap, idx: 0 as i64, _inv: PhantomData::<&'a mut V> {} };
    }
}

/// A slot of a `HashMap`, occupied or vacant (Rust's `hash_map::Entry`), as a struct:
/// `or_insert`, `or_insert_with`, `or_default`, `and_modify`, `key`.
#[borrow_carrying]
pub struct Entry<'a, K, V> {
    map:   *mut HashMap<K, V>,
    idx:   i64,
    found: bool,
    key:   K,
    _inv:  PhantomData<&'a mut V>,
}

impl<'a, K: Hash + Eq, V> Entry<'a, K, V> {
    /// The entry's key.
    pub fn key(&self) -> &K { return &self.key; }

    /// The value, inserting `default` if vacant (a present `default` is dropped).
    pub fn or_insert(self: Entry<'a, K, V>, default: V) -> &'a mut V {
        let e: Entry<'a, K, V> = self;
        unsafe {
            let p: *mut HashMap<K, V> = e.map;
            let slot: *mut Slot<K, V> = &mut p.entries[e.idx];
            if !e.found {
                slot.key = e.key;
                slot.val = default;
                p.states[e.idx] = SLOT_OCCUPIED;
                p.len = p.len + 1 as i64;
            }
            let vp: *mut V = &mut slot.val as *mut V;
            return &mut *vp;
        }
    }

    /// The value, inserting `f()` if vacant (`f` runs only then).
    pub fn or_insert_with<F: FnOnce() -> V>(self: Entry<'a, K, V>, f: F) -> &'a mut V {
        let e: Entry<'a, K, V> = self;
        unsafe {
            let p: *mut HashMap<K, V> = e.map;
            let slot: *mut Slot<K, V> = &mut p.entries[e.idx];
            if !e.found {
                slot.key = e.key;
                slot.val = f();
                p.states[e.idx] = SLOT_OCCUPIED;
                p.len = p.len + 1 as i64;
            }
            let vp: *mut V = &mut slot.val as *mut V;
            return &mut *vp;
        }
    }

    /// Runs `f` on the value if occupied; the entry is handed back either way.
    pub fn and_modify<F: FnOnce(&mut V)>(self: Entry<'a, K, V>, f: F) -> Entry<'a, K, V> {
        let e: Entry<'a, K, V> = self;
        if e.found {
            unsafe {
                let p: *mut HashMap<K, V> = e.map;
                let slot: *mut Slot<K, V> = &mut p.entries[e.idx];
                f(&mut slot.val);
            }
        }
        return e;
    }
}

impl<'a, K: Hash + Eq, V: Default> Entry<'a, K, V> {
    /// The value, inserting `V::default()` if vacant.
    pub fn or_default(self: Entry<'a, K, V>) -> &'a mut V {
        let e: Entry<'a, K, V> = self;
        unsafe {
            let p: *mut HashMap<K, V> = e.map;
            let slot: *mut Slot<K, V> = &mut p.entries[e.idx];
            if !e.found {
                slot.key = e.key;
                slot.val = V::default();
                p.states[e.idx] = SLOT_OCCUPIED;
                p.len = p.len + 1 as i64;
            }
            let vp: *mut V = &mut slot.val as *mut V;
            return &mut *vp;
        }
    }
}

/// Iterator over `ZipPair<&K, &mut V>` entries of a `HashMap`; created by `iter_mut()`.
#[borrow_carrying]
pub struct HashMapIterMut<'a, K, V> {
    states:  *const u8,
    entries: *mut Slot<K, V>,
    cap:     i64,
    idx:     i64,
    _inv:    PhantomData<&'a mut V>,
}

impl<'a, K: Hash + Eq, V> Iterator for HashMapIterMut<'a, K, V> {
    type Item = ZipPair<&'a K, &'a mut V>;
    fn next(self: &mut HashMapIterMut<'a, K, V>) -> Option<ZipPair<&'a K, &'a mut V>> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    let e: *mut Slot<K, V> = &mut self.entries[i];
                    let kp: *const K = &e.key as *const K;
                    let vp: *mut V = &mut e.val as *mut V;
                    let k: &'a K = &*kp;
                    let v: &'a mut V = &mut *vp;
                    return Option::Some(ZipPair { first: k, second: v });
                }
            }
            return Option::None;
        }
    }
}

/// Iterator over `&mut V` values of a `HashMap`; created by `values_mut()`.
#[borrow_carrying]
pub struct HashMapValuesMut<'a, K, V> {
    states:  *const u8,
    entries: *mut Slot<K, V>,
    cap:     i64,
    idx:     i64,
    _inv:    PhantomData<&'a mut V>,
}

impl<'a, K: Hash + Eq, V> Iterator for HashMapValuesMut<'a, K, V> {
    type Item = &'a mut V;
    fn next(self: &mut HashMapValuesMut<'a, K, V>) -> Option<&'a mut V> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    let e: *mut Slot<K, V> = &mut self.entries[i];
                    let vp: *mut V = &mut e.val as *mut V;
                    let v: &'a mut V = &mut *vp;
                    return Option::Some(v);
                }
            }
            return Option::None;
        }
    }
}

/// Owning iterator over a `HashMap` (`for (k, v) in map`); yields `(K, V)` in table
/// order. Un-yielded entries are dropped with the iterator, which frees the table.
pub struct HashMapIntoIter<K, V> {
    states:  *mut u8,
    entries: *mut Slot<K, V>,
    cap:     i64,
    idx:     i64,
}

impl<K, V> Iterator for HashMapIntoIter<K, V> {
    type Item = (K, V);
    fn next(self: &mut HashMapIntoIter<K, V>) -> Option<(K, V)> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    self.states[i] = SLOT_EMPTY;
                    let e: *mut Slot<K, V> = &mut self.entries[i];
                    let k: K = logos.lang.ptr::read(&e.key as *const K);
                    let v: V = logos.lang.ptr::read(&e.val as *const V);
                    return Option::Some((k, v));
                }
            }
            return Option::None;
        }
    }
}

impl<K, V> Drop for HashMapIntoIter<K, V> {
    fn drop(self: &mut HashMapIntoIter<K, V>) {
        unsafe {
            if self.states != 0 as *mut u8 {
                let mut i: i64 = 0;
                while i < self.cap {
                    if self.states[i] == SLOT_OCCUPIED {
                        let e: *mut Slot<K, V> = &mut self.entries[i];
                        let _k: K = logos.lang.ptr::read(&e.key as *const K);
                        let _v: V = logos.lang.ptr::read(&e.val as *const V);
                    }
                    i = i + 1 as i64;
                }
                dealloc(self.states);
                dealloc(self.entries as *mut u8);
                self.states = 0 as *mut u8;
            }
        }
    }
}

// `for (k, v) in map` — consumes the map: the buffers move to the iterator and
// the map's own drop becomes a no-op (null `states`).
impl<K: Hash + Eq, V> IntoIterator for HashMap<K, V> {
    type Item = (K, V);
    type IntoIter = HashMapIntoIter<K, V>;
    fn into_iter(self: HashMap<K, V>) -> HashMapIntoIter<K, V> {
        let it: HashMapIntoIter<K, V> = HashMapIntoIter {
            states: self.states, entries: self.entries, cap: self.cap, idx: 0 as i64,
        };
        let mut m: HashMap<K, V> = self;
        m.states = 0 as *mut u8;
        return it;
    }
}

impl<K: Hash + Eq, V> Default for HashMap<K, V> {
    fn default() -> HashMap<K, V> { return hashmap_new::<K, V>(); }
}

// `iter.collect::<HashMap<K, V>>()` over `(K, V)` pairs; a later duplicate key
// replaces the earlier value (Rust's `impl FromIterator<(K, V)> for HashMap`).
impl<K: Hash + Eq, V> FromIterator<(K, V)> for HashMap<K, V> {
    fn from_iter<I: Iterator<Item = (K, V)>>(iter: I) -> HashMap<K, V> {
        let mut m: HashMap<K, V> = hashmap_new::<K, V>();
        let mut it: I = iter;
        loop {
            match it.next() {
                Option::None         => { return m; }
                Option::Some((k, v)) => { unsafe { m.insert(k, v); } }
            }
        }
    }
}

// ── the query plane (ADR 0024 S6) ───────────────────────────────────────────
//
// A HashMap joins Deem's query plane by DECLARING itself: the relation it
// projects, and what it can do with it. Nothing about the planner knows this
// type — it reads the declaration, the same one a generated Memoria family
// writes, which is the test that the planner is not container-shaped.
//
// What it declares is exactly what a hash table CAN do, and the shape of that
// is the point: a point probe on the key, and nothing else. No `ge`, no `le`,
// and `MapSource` rather than `OrderedMapSource` — a hash table has no order
// to offer, so a query that filters on a range gets a full scan and the plan
// says why. A model that had `can_seek` as one boolean could not express this.

/// Every entry as a row, in the table's internal order — which is to say, in
/// no order a caller may rely on.
pub fn hashmap_rows<K: Hash + Eq + Copy, V: Copy>(m: &HashMap<K, V>) -> Vec<(K, V)> {
    let mut out: Vec<(K, V)> = vec_new::<(K, V)>();
    unsafe {
        let mut it: HashMapIter<K, V> = (*(m as *const HashMap<K, V>)).iter();
        loop {
            match it.next() {
                Option::Some(p) => { out.push((*p.first, *p.second)); }
                Option::None    => { break; }
            }
        }
    }
    return out;
}

/// The point probe: the row for `k`, or none. EXACT — it returns precisely the
/// rows satisfying `key == k`, so a query narrowed by it needs no filter.
pub fn hashmap_at<K: Hash + Eq + Copy, V: Copy>(m: &HashMap<K, V>, k: K) -> Vec<(K, V)> {
    let mut out: Vec<(K, V)> = vec_new::<(K, V)>();
    unsafe {
        let p: *const V = (*(m as *const HashMap<K, V> as *mut HashMap<K, V>)).get(&k);
        if p != (0 as *const V) { out.push((k, *p)); }
    }
    return out;
}

/// How many rows the relation holds (ADR 0024 S4) — the map's own length, asked
/// once. Declared, not derived: the plane cannot read a size off a source's
/// shape without excluding the source that has none to read.
pub fn hashmap_len<K: Hash + Eq + Copy, V: Copy>(m: &HashMap<K, V>) -> i64 {
    return m.len();
}

impl<K: Hash + Eq + Copy, V: Copy> MapSource<K, V> for HashMap<K, V> {
    rel entry = hashmap_rows;
    op entry.key eq = hashmap_at  exact;
    size entry = hashmap_len;
}
