// Logos standard library — std.hashmap
//
// HashMap<K: Hash + Eq, V> — open addressing with linear probing.
// Load factor 0.75, x2 resize. Capacity is always a power of two so
// `hash & (cap - 1)` works as modulo.
//
// Slot state (parallel u8 array):
//   0 = empty, 1 = occupied, 2 = tombstone (deleted).

package logos.mem.collections.hashmap;

use logos.lang.mem;
use logos.lang.hash;
use logos.lang.cmp;
use logos.lang.option;
use logos.lang.iter;
use logos.lang.ops;
use logos.mem.collections.vec;   // Vec — the relational projection's rows
use logos.mem.bt.map;            // trait MapSource — the query plane (ADR 0024 S6)

let SLOT_EMPTY:     u8 = 0 as u8;
let SLOT_OCCUPIED:  u8 = 1 as u8;
let SLOT_TOMBSTONE: u8 = 2 as u8;

struct Entry<K, V> {
    key: K,
    val: V,
}

/// Hash map with open addressing and linear probing; load factor 0.75, power-of-two capacity.
/// Mutating/lookup methods are `unsafe` and take raw `self` pointers; construct via
/// `hashmap_new` or `hashmap_with_capacity`.
pub struct HashMap<K, V> {
    states:  *mut u8,
    entries: *mut Entry<K, V>,
    len:     i64,
    cap:     i64,
}

/// Creates an empty `HashMap` with capacity 16.
pub fn hashmap_new<K: Hash + Eq, V>() -> HashMap<K, V> {
    return hashmap_with_capacity::<K, V>(16 as i64);
}

/// Creates an empty `HashMap` with `cap_hint` rounded up to a power of two (minimum 8).
pub fn hashmap_with_capacity<K: Hash + Eq, V>(cap_hint: i64) -> HashMap<K, V> {
    // Round up to next power of two, min 8.
    let mut cap: i64 = 8;
    while cap < cap_hint { cap = cap * 2; }
    let states_raw: *mut u8 = alloc(cap);
    unsafe {
        let mut i: i64 = 0;
        while i < cap { states_raw[i] = SLOT_EMPTY; i = i + 1; }
    }
    let entries_bytes: i64 = cap * sizeof::<Entry<K, V>>();
    let entries_raw: *mut u8 = alloc(entries_bytes);
    return HashMap {
        states:  states_raw,
        entries: entries_raw as *mut Entry<K, V>,
        len:     0 as i64,
        cap:     cap,
    };
}

impl<K: Hash + Eq, V> HashMap<K, V> {
    /// Returns the number of entries in the map.
    pub fn len(&self) -> i64 { return self.len; }

    /// Returns `true` if the map contains no entries.
    pub fn is_empty(&self) -> bool { return self.len == 0 as i64; }

    /// Returns the raw slot count of the table (always a power of two).
    pub fn capacity(&self) -> i64 { return self.cap; }

    // Compute starting slot index for a key: hash & (cap - 1).
    fn slot_index(&self, key: &K) -> i64 {
        let mut h: FxHasher = fx_hasher_new();
        key.hash(&mut h);
        let hv: u64 = h.finish();
        let mask: u64 = (self.cap - 1 as i64) as u64;
        return (hv & mask) as i64;
    }

    // Probe for the slot where `key` lives or where it would be inserted.
    // Returns (index, found) where found=true if the key is already there.
    unsafe fn probe(self: *mut HashMap<K, V>, key: &K) -> (i64, bool) {
        let mask: i64 = self.cap - 1 as i64;
        let mut idx: i64 = self.slot_index(key);
        let mut first_tomb: i64 = -1 as i64;
        loop {
            let st: u8 = self.states[idx];
            if st == SLOT_EMPTY {
                if first_tomb >= 0 as i64 { return (first_tomb, false); }
                return (idx, false);
            }
            if st == SLOT_TOMBSTONE {
                if first_tomb < 0 as i64 { first_tomb = idx; }
            } else {
                let e: *mut Entry<K, V> = &mut self.entries[idx];
                if key.eq(&e.key) { return (idx, true); }
            }
            idx = (idx + 1 as i64) & mask;
        }
    }

    /// Inserts `key` → `val`, overwriting the value if `key` is already present.
    /// Resizes (x2) when the post-insert load factor would exceed 0.75.
    pub unsafe fn insert(self: *mut HashMap<K, V>, key: K, val: V) {
        // Resize when load factor exceeds 0.75.
        // (self.len + 1) * 4 > self.cap * 3  ⇔  load > 0.75 after insert.
        if (self.len + 1 as i64) * 4 as i64 > self.cap * 3 as i64 {
            self.resize(self.cap * 2 as i64);
        }
        let (idx, found) = self.probe(&key);
        let e: *mut Entry<K, V> = &mut self.entries[idx];
        if found {
            e.val = val;
        } else {
            e.key = key;
            e.val = val;
            self.states[idx] = SLOT_OCCUPIED;
            self.len = self.len + 1 as i64;
        }
    }

    /// Returns `true` if the map contains `key`.
    pub unsafe fn contains_key(self: *mut HashMap<K, V>, key: &K) -> bool {
        let (idx, found) = self.probe(key);
        return found;
    }

    /// Returns a pointer to the value for `key`, or null if absent.
    pub unsafe fn get(self: *mut HashMap<K, V>, key: &K) -> *const V {
        let (idx, found) = self.probe(key);
        if !found { return 0 as *const V; }
        let e: *mut Entry<K, V> = &mut self.entries[idx];
        return &e.val as *const V;
    }

    /// Returns a mutable pointer to the value for `key`, or null if absent.
    pub unsafe fn get_mut(self: *mut HashMap<K, V>, key: &K) -> *mut V {
        let (idx, found) = self.probe(key);
        if !found { return 0 as *mut V; }
        let e: *mut Entry<K, V> = &mut self.entries[idx];
        return &mut e.val as *mut V;
    }

    /// Returns a pointer to the value bound to `key`, inserting `default` if absent.
    /// Single-probe find-or-insert (Rust's `entry().or_insert()`): ONE probe + ONE hash vs
    /// get-then-insert's two of each — the idiomatic count/accumulate path
    /// (`*m.get_or_insert(k, 0) += 1`). If `key` is already present, `default` is dropped.
    pub unsafe fn get_or_insert(self: *mut HashMap<K, V>, key: K, default: V) -> *mut V {
        if (self.len + 1 as i64) * 4 as i64 > self.cap * 3 as i64 {
            self.resize(self.cap * 2 as i64);
        }
        let (idx, found) = self.probe(&key);
        let e: *mut Entry<K, V> = &mut self.entries[idx];
        if !found {
            e.key = key;
            e.val = default;
            self.states[idx] = SLOT_OCCUPIED;
            self.len = self.len + 1 as i64;
        }
        return &mut e.val as *mut V;
    }

    /// Removes `key` from the map; returns `true` if it was present.
    /// Tombstones the slot without moving out or dropping the entry's key/value.
    pub unsafe fn remove(self: *mut HashMap<K, V>, key: &K) -> bool {
        let (idx, found) = self.probe(key);
        if !found { return false; }
        self.states[idx] = SLOT_TOMBSTONE;
        self.len = self.len - 1 as i64;
        return true;
    }

    /// Removes and drops all entries, resetting every slot (tombstones included) to empty.
    /// Capacity is retained.
    pub unsafe fn clear(self: *mut HashMap<K, V>) {
        let mut i: i64 = 0;
        while i < self.cap {
            if self.states[i] == SLOT_OCCUPIED {
                let e: *mut Entry<K, V> = &mut self.entries[i];
                let _k: K = e.key;   // move-and-drop the live entry
                let _v: V = e.val;
            }
            self.states[i] = SLOT_EMPTY;
            i = i + 1;
        }
        self.len = 0 as i64;
    }

    // Rebuild into a larger table (always a power of two).
    unsafe fn resize(self: *mut HashMap<K, V>, new_cap: i64) {
        let old_states:  *mut u8 = self.states;
        let old_entries: *mut Entry<K, V> = self.entries;
        let old_cap:     i64 = self.cap;

        let new_states: *mut u8 = alloc(new_cap);
        let mut i: i64 = 0;
        while i < new_cap { new_states[i] = SLOT_EMPTY; i = i + 1; }
        let new_entries_bytes: i64 = new_cap * sizeof::<Entry<K, V>>();
        let new_entries: *mut Entry<K, V> =
            alloc(new_entries_bytes) as *mut Entry<K, V>;

        self.states  = new_states;
        self.entries = new_entries;
        self.cap     = new_cap;
        self.len     = 0 as i64;

        let mut j: i64 = 0;
        while j < old_cap {
            if old_states[j] == SLOT_OCCUPIED {
                let e: *mut Entry<K, V> = &mut old_entries[j];
                self.insert(e.key, e.val);
            }
            j = j + 1 as i64;
        }

        dealloc(old_states);
        dealloc(old_entries as *mut u8);
    }
}

// ── Iteration ────────────────────────────────────────────────────────────────

/// Iterator over `(&K, &V)` entries of a `HashMap`; created by `iter()`.
/// Holds raw pointers into the table — inserting during iteration may resize and dangle them.
pub struct HashMapIter<K, V> {
    states:  *const u8,
    entries: *const Entry<K, V>,
    cap:     i64,
    idx:     i64,
}

// Yields `(&K, &V)` (Rust-conformant: `HashMap::iter()` borrows). The entries
// array is stable during iteration (resize only on insert), so `next()` returns
// references into the occupied slot rather than copying.
impl<K: Hash + Eq, V> Iterator<ZipPair<&K, &V>> for HashMapIter<K, V> {
    fn next(self: &mut HashMapIter<K, V>) -> Option<ZipPair<&K, &V>> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    let e: *const Entry<K, V> = &self.entries[i];
                    return Option::Some(ZipPair { first: &e.key, second: &e.val });
                }
            }
            return Option::None;
        }
    }
}

/// Iterator over `&K` keys of a `HashMap`; created by `keys()`.
pub struct HashMapKeys<K, V> {
    states:  *const u8,
    entries: *const Entry<K, V>,
    cap:     i64,
    idx:     i64,
}

impl<K: Hash + Eq, V> Iterator<&K> for HashMapKeys<K, V> {
    fn next(self: &mut HashMapKeys<K, V>) -> Option<&K> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    let e: *const Entry<K, V> = &self.entries[i];
                    return Option::Some(&e.key);
                }
            }
            return Option::None;
        }
    }
}

/// Iterator over `&V` values of a `HashMap`; created by `values()`.
pub struct HashMapValues<K, V> {
    states:  *const u8,
    entries: *const Entry<K, V>,
    cap:     i64,
    idx:     i64,
}

impl<K: Hash + Eq, V> Iterator<&V> for HashMapValues<K, V> {
    fn next(self: &mut HashMapValues<K, V>) -> Option<&V> {
        unsafe {
            while self.idx < self.cap {
                let i: i64 = self.idx;
                self.idx = self.idx + 1 as i64;
                if self.states[i] == SLOT_OCCUPIED {
                    let e: *const Entry<K, V> = &self.entries[i];
                    return Option::Some(&e.val);
                }
            }
            return Option::None;
        }
    }
}

impl<K: Hash + Eq, V> HashMap<K, V> {
    /// Returns an iterator yielding `ZipPair<&K, &V>` for each occupied entry.
    /// Order is arbitrary (table order). Do not insert while iterating.
    pub unsafe fn iter(self: *const HashMap<K, V>) -> HashMapIter<K, V> {
        return HashMapIter {
            states:  self.states as *const u8,
            entries: self.entries as *const Entry<K, V>,
            cap:     self.cap,
            idx:     0 as i64,
        };
    }

    /// Returns an iterator over the map's keys, in arbitrary order.
    pub unsafe fn keys(self: *const HashMap<K, V>) -> HashMapKeys<K, V> {
        return HashMapKeys {
            states:  self.states as *const u8,
            entries: self.entries as *const Entry<K, V>,
            cap:     self.cap,
            idx:     0 as i64,
        };
    }

    /// Returns an iterator over the map's values, in arbitrary order.
    pub unsafe fn values(self: *const HashMap<K, V>) -> HashMapValues<K, V> {
        return HashMapValues {
            states:  self.states as *const u8,
            entries: self.entries as *const Entry<K, V>,
            cap:     self.cap,
            idx:     0 as i64,
        };
    }
}

// Auto-Drop (Rust parity, mirrors Vec). On scope exit each occupied entry's key
// and value are moved out and dropped (firing K/V's Drop if any; no-op for
// POD/Copy), then the states + entries buffers are freed. No manual free. Drop
// needs no Hash/Eq bound — it only moves out, never probes.
impl<K, V> Drop for HashMap<K, V> {
    fn drop(self: HashMap<K, V>) {
        unsafe {
            if self.states != 0 as *mut u8 {
                let mut i: i64 = 0;
                while i < self.cap {
                    if self.states[i] == SLOT_OCCUPIED {
                        let e: *mut Entry<K, V> = &mut self.entries[i];
                        let _k: K = e.key;   // move-and-drop
                        let _v: V = e.val;
                    }
                    i = i + 1 as i64;
                }
                dealloc(self.states);
                dealloc(self.entries as *mut u8);
            }
        }
    }
}

// ── the query plane (ADR 0024 S6) ───────────────────────────────────────────
//
// A HashMap joins Deem's query plane by DECLARING itself: the relation it
// projects, and what it can do with it. Nothing about the planner knows this
// type — it reads the declaration, the same one a generated Memoria family
// writes, which is the test that the planner is not container-shaped.
//
// What it declares is exactly what a hash table CAN do, and the shape of that
// is the point: a point probe on the key, and nothing else. No `ge`, no `le`,
// and `MapSource` rather than `OrderedMapSource` — a hash table has no order
// to offer, so a query that filters on a range gets a full scan and the plan
// says why. A model that had `can_seek` as one boolean could not express this.

/// Every entry as a row, in the table's internal order — which is to say, in
/// no order a caller may rely on.
pub fn hashmap_rows<K: Hash + Eq + Copy, V: Copy>(m: &HashMap<K, V>) -> Vec<(K, V)> {
    let mut out: Vec<(K, V)> = vec_new::<(K, V)>();
    unsafe {
        let mut it: HashMapIter<K, V> = (m as *const HashMap<K, V>).iter();
        loop {
            match it.next() {
                Option::Some(p) => { out.push((*p.first, *p.second)); }
                Option::None    => { break; }
            }
        }
    }
    return out;
}

/// The point probe: the row for `k`, or none. EXACT — it returns precisely the
/// rows satisfying `key == k`, so a query narrowed by it needs no filter.
pub fn hashmap_at<K: Hash + Eq + Copy, V: Copy>(m: &HashMap<K, V>, k: K) -> Vec<(K, V)> {
    let mut out: Vec<(K, V)> = vec_new::<(K, V)>();
    unsafe {
        let p: *const V = (m as *const HashMap<K, V> as *mut HashMap<K, V>).get(&k);
        if p != (0 as *const V) { out.push((k, *p)); }
    }
    return out;
}

impl<K: Hash + Eq + Copy, V: Copy> MapSource<K, V> for HashMap<K, V> {
    rel entry = hashmap_rows;
    op entry.key eq = hashmap_at  exact;
}
