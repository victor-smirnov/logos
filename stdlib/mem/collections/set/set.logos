// Logos standard library — std.set
//
// HashSet<K: Hash + Eq> — unordered set backed by HashMap<K, u8>.
// The u8 dummy value wastes 1 byte per slot; this is acceptable for now.

package logos.mem.collections.set;

use logos.mem.collections.hashmap;
use logos.lang.hash;
use logos.lang.cmp;
use logos.lang.iter;
use logos.lang.ops;
use logos.lang.option;
use logos.lang.default;
use logos.mem.collections.vec;

/// Unordered set of unique keys, backed by `HashMap<K, u8>`.
pub struct HashSet<K> {
    inner: HashMap<K, u8>,
}

/// Creates an empty `HashSet` with capacity 16.
pub fn hashset_new<K: Hash + Eq>() -> HashSet<K> {
    return HashSet { inner: hashmap_new::<K, u8>() };
}

/// Creates an empty `HashSet` with `cap_hint` rounded up to a power of two (minimum 8).
pub fn hashset_with_capacity<K: Hash + Eq>(cap_hint: i64) -> HashSet<K> {
    return HashSet { inner: hashmap_with_capacity::<K, u8>(cap_hint) };
}

impl<K: Hash + Eq> HashSet<K> {
    /// Returns the number of elements in the set.
    pub fn len(&self) -> i64 { return self.inner.len(); }

    /// Returns `true` if the set contains no elements.
    pub fn is_empty(&self) -> bool { return self.inner.is_empty(); }

    /// Inserts `key`; returns `true` if it was newly added, `false` if it already existed.
    pub unsafe fn insert(self: *mut HashSet<K>, key: K) -> bool {
        let already: bool = self.inner.contains_key(&key);
        self.inner.insert(key, 0 as u8);
        return !already;
    }

    /// Returns `true` if `key` is present in the set.
    pub unsafe fn contains(self: *mut HashSet<K>, key: &K) -> bool {
        return self.inner.contains_key(key);
    }

    /// Removes `key`; returns `true` if it was present.
    pub unsafe fn remove(self: *mut HashSet<K>, key: &K) -> bool {
        return self.inner.remove(key).is_some();
    }

    /// Removes all elements from the set.
    pub unsafe fn clear(self: *mut HashSet<K>) {
        self.inner.clear();
    }

    /// Returns an iterator over the set's elements, yielding `&K`.
    pub unsafe fn iter<'a>(self: *const HashSet<K>) -> HashSetIter<'a, K> {
        return HashSetIter { inner: self.inner.keys() };
    }
}

// ── HashSetIter<K> ────────────────────────────────────────────────────────────

/// Iterator over a `HashSet`'s elements, yielding `&K`.
pub struct HashSetIter<'a, K> {
    inner: HashMapKeys<'a, K, u8>,
}

// Yields `&K` (Rust-conformant: `HashSet::iter()` borrows) — follows the
// underlying `HashMapKeys` which now yields `&K`.
impl<'a, K: Hash + Eq> Iterator<&'a K> for HashSetIter<'a, K> {
    fn next(self: &mut HashSetIter<'a, K>) -> Option<&'a K> {
        return self.inner.next();
    }
}

// No manual free (Rust parity): a HashSet auto-drops via its `inner` HashMap
// field, whose Drop drops each live key and frees the buffers.

// ── Rust's safe surface: new / set algebra / owning into_iter ────────────────
// The set operations yield `&K` like Rust's `Union`/`Intersection`/… iterators
// (collected up front into a Vec of references, in table order).

impl<K: Hash + Eq> HashSet<K> {
    /// Creates an empty set (Rust's `HashSet::new`).
    pub fn new() -> HashSet<K> { return hashset_new::<K>(); }

    // Membership through a shared borrow (the probe does not mutate).
    fn has(&self, key: &K) -> bool {
        unsafe {
            let p: *mut HashSet<K> = self as *const HashSet<K> as *mut HashSet<K>;
            return p.contains(key);
        }
    }

    /// The elements of `self` or `other`, each once.
    pub fn union<'a>(self: &'a HashSet<K>, other: &'a HashSet<K>) -> VecIntoIter<&'a K> {
        let mut out: Vec<&'a K> = Vec::new();
        unsafe {
            for k in (self as *const HashSet<K>).iter() { out.push(k); }
            for k in (other as *const HashSet<K>).iter() { if !self.has(k) { out.push(k); } }
        }
        return out.into_iter();
    }

    /// The elements of both `self` and `other`.
    pub fn intersection<'a>(self: &'a HashSet<K>, other: &'a HashSet<K>) -> VecIntoIter<&'a K> {
        let mut out: Vec<&'a K> = Vec::new();
        unsafe {
            for k in (self as *const HashSet<K>).iter() { if other.has(k) { out.push(k); } }
        }
        return out.into_iter();
    }

    /// The elements of `self` not in `other`.
    pub fn difference<'a>(self: &'a HashSet<K>, other: &'a HashSet<K>) -> VecIntoIter<&'a K> {
        let mut out: Vec<&'a K> = Vec::new();
        unsafe {
            for k in (self as *const HashSet<K>).iter() { if !other.has(k) { out.push(k); } }
        }
        return out.into_iter();
    }

    /// The elements in exactly one of `self` and `other`.
    pub fn symmetric_difference<'a>(self: &'a HashSet<K>, other: &'a HashSet<K>) -> VecIntoIter<&'a K> {
        let mut out: Vec<&'a K> = Vec::new();
        unsafe {
            for k in (self as *const HashSet<K>).iter() { if !other.has(k) { out.push(k); } }
            for k in (other as *const HashSet<K>).iter() { if !self.has(k) { out.push(k); } }
        }
        return out.into_iter();
    }

    /// `true` if every element of `self` is in `other`.
    pub fn is_subset(&self, other: &HashSet<K>) -> bool {
        unsafe {
            for k in (self as *const HashSet<K>).iter() { if !other.has(k) { return false; } }
        }
        return true;
    }

    /// `true` if every element of `other` is in `self`.
    pub fn is_superset(&self, other: &HashSet<K>) -> bool { return other.is_subset(self); }

    /// `true` if `self` and `other` share no element.
    pub fn is_disjoint(&self, other: &HashSet<K>) -> bool {
        unsafe {
            for k in (self as *const HashSet<K>).iter() { if other.has(k) { return false; } }
        }
        return true;
    }
}

/// Owning iterator over a `HashSet` (`for k in set`); yields `K` in table order.
pub struct HashSetIntoIter<K> {
    inner: HashMapIntoIter<K, u8>,
}

impl<K> Iterator<K> for HashSetIntoIter<K> {
    fn next(self: &mut HashSetIntoIter<K>) -> Option<K> {
        match self.inner.next() {
            Option::Some(kv) => { let (k, _v) = kv; return Option::Some(k); }
            Option::None     => { return Option::None; }
        }
    }
}

// The un-yielded tail belongs to `inner` (a HashMapIntoIter, whose own Drop
// reconciles its cursor); the field glue after this Drop drops it once.
impl<K> Drop for HashSetIntoIter<K> {
    fn drop(self: &mut HashSetIntoIter<K>) { }
}

impl<K: Hash + Eq> IntoIterator<K> for HashSet<K> {
    type Iter = HashSetIntoIter<K>;
    fn into_iter(self: HashSet<K>) -> HashSetIntoIter<K> {
        let s: HashSet<K> = self;
        return HashSetIntoIter { inner: s.inner.into_iter() };
    }
}

impl<K: Hash + Eq> Default for HashSet<K> {
    fn default() -> HashSet<K> { return hashset_new::<K>(); }
}

// `iter.collect::<HashSet<K>>()`; a duplicate element is dropped.
impl<K: Hash + Eq> FromIterator<K> for HashSet<K> {
    fn from_iter<I: Iterator<K>>(iter: I) -> HashSet<K> {
        let mut s: HashSet<K> = hashset_new::<K>();
        let mut it: I = iter;
        loop {
            match it.next() {
                Option::None    => { return s; }
                Option::Some(k) => { unsafe { s.insert(k); } }
            }
        }
    }
}

