// Logos standard library — std.vec
//
// Vec<T> — growable heap-allocated generic array.
// Uses malloc/realloc/free from std.mem.

package logos.mem.collections.vec;

use logos.lang.mem;
use logos.lang.marker;
use logos.lang.slice;
use logos.lang.option;
use logos.lang.iter;
use logos.lang.ops;
use logos.lang.cmp;
use logos.lang.panic;
use logos.lang.result;

/// Growable heap-allocated array of `T`, contiguous in memory (Rust `Vec` analog).
/// On drop, each live element is dropped and the buffer is freed.
pub struct Vec<T> {
    ptr: *mut T,
    len: i64,
    cap: i64,
}

// Vec owns its buffer exclusively — Send/Sync follow the element type
// (Rust: `unsafe impl<T: Send> Send for Vec<T>` / `<T: Sync> Sync`).
unsafe impl<T: Send> Send for Vec<T> {}
unsafe impl<T: Sync> Sync for Vec<T> {}

/// Creates an empty `Vec<T>`; allocates an initial capacity of 8 up front.
pub fn vec_new<T>() -> Vec<T> {
    let init_cap: i64 = 8;
    let byte_size: i64 = init_cap * sizeof::<T>();
    let raw: *mut u8 = alloc(byte_size);
    let ptr: *mut T = raw as *mut T;
    return Vec { ptr: ptr, len: 0, cap: init_cap };
}

/// Builds a `Vec` from a fixed-size array, inferring element type and length from the
/// argument shape (no turbofish). `vec!(1, 2, 3)` lowers to exactly this call.
pub fn vec_from_arr<T: Copy, const N: i64>(arr: [T; N]) -> Vec<T> {
    let mut v: Vec<T> = vec_new::<T>();
    let mut i: i64 = 0i64;
    while i < N {
        v.push(arr[i]);
        i = i + 1i64;
    }
    return v;
}

impl<T> Vec<T> {
    /// Appends `val` to the end, doubling capacity when full.
    /// Growth reallocates the buffer, invalidating outstanding raw pointers.
    pub fn push(&mut self, val: T) {
        unsafe {
            if self.len == self.cap {
                self.cap = self.cap * 2;
                let byte_size: i64 = self.cap * sizeof::<T>();
                let raw: *mut u8 = realloc_buf(self.ptr as *mut u8, byte_size);
                self.ptr = raw as *mut T;
            }
            self.ptr[self.len] = val;
            self.len = self.len + 1;
        }
    }

    /// Returns the element at index `i` by value. Panics on out-of-bounds.
    pub fn get(&self, i: i64) -> T {
        if i < 0 || i >= self.len {
            panic("Vec::get: index out of bounds");
        }
        unsafe { return self.ptr[i]; }
    }

    /// Returns a raw mutable pointer to the `i`-th element (no copy, no bounds check).
    /// Caller must keep the `Vec` alive and un-resized while the pointer is used.
    /// Rust's `vec.as_mut_ptr().add(i)` idiom.
    pub unsafe fn at(&mut self, i: i64) -> *mut T {
        return &mut self.ptr[i];
    }

    /// Returns a raw const pointer to the `i`-th element; bounds check is the caller's job.
    pub unsafe fn at_const(&self, i: i64) -> *const T {
        return &self.ptr[i];
    }

    /// Borrows the `i`-th element without copying (Rust's `&vec[i]`).
    /// Panics on out-of-bounds.
    pub fn borrow(&self, i: i64) -> &T {
        if i < 0 || i >= self.len {
            panic("Vec::borrow: index out of bounds");
        }
        unsafe { return &self.ptr[i]; }
    }

    /// Mutably borrows the `i`-th element (Rust's `&mut vec[i]`). Panics on out-of-bounds.
    pub fn borrow_mut(&mut self, i: i64) -> &mut T {
        if i < 0 || i >= self.len {
            panic("Vec::borrow_mut: index out of bounds");
        }
        unsafe { return &mut self.ptr[i]; }
    }

    /// Returns `Some(&T)` for an in-bounds index, `None` otherwise (Rust's `vec.get(i)`).
    pub fn try_borrow(&self, i: i64) -> Option<&T> {
        if i < 0 || i >= self.len { return Option::None; }
        unsafe { return Option::Some(&self.ptr[i]); }
    }

    /// Returns `Some(&mut T)` for an in-bounds index, `None` otherwise (Rust's `vec.get_mut(i)`).
    pub fn try_borrow_mut(&mut self, i: i64) -> Option<&mut T> {
        if i < 0 || i >= self.len { return Option::None; }
        unsafe { return Option::Some(&mut self.ptr[i]); }
    }

    /// Writes `val` at index `i`. Panics on out-of-bounds.
    pub fn set(&mut self, i: i64, val: T) {
        if i < 0 || i >= self.len {
            panic("Vec::set: index out of bounds");
        }
        unsafe { self.ptr[i] = val; }
    }

    /// Returns the number of elements. Logos-specific alias of `len`.
    pub fn length(&self) -> i64 {
        return self.len;
    }

    /// Returns a raw const pointer to the contiguous element buffer (Rust's `Vec::as_ptr`).
    /// Safe to obtain, unsafe to dereference; valid until the next growth/realloc.
    pub fn as_ptr(&self) -> *const T {
        return self.ptr as *const T;
    }

    /// Returns a raw mutable pointer to the element buffer; valid until the next growth/realloc.
    pub fn as_mut_ptr(&mut self) -> *mut T {
        return self.ptr;
    }

    // §2 Wave 9 — Rust API parity: `len()` is the canonical name. The
    // existing `length()` stays as a Logos-specific alias.
    /// Returns the number of elements.
    pub fn len(&self) -> i64 {
        return self.len;
    }

    /// Returns `true` if the vector contains no elements.
    pub fn is_empty(&self) -> bool {
        return self.len == 0 as i64;
    }

    // §2 Wave 9 — Rust API parity additions.
    /// Returns a reference to the first element, or `None` if empty.
    pub fn first(&self) -> Option<&T> {
        if self.len == 0i64 { return Option::None; }
        unsafe { return Option::Some(&self.ptr[0i64]); }
    }
    /// Returns a reference to the last element, or `None` if empty.
    pub fn last(&self) -> Option<&T> {
        if self.len == 0i64 { return Option::None; }
        unsafe { return Option::Some(&self.ptr[self.len - 1i64]); }
    }
    /// Creates an empty `Vec<T>`; delegates to `vec_new` (preallocates capacity 8).
    pub fn new() -> Vec<T> {
        return vec_new::<T>();
    }
    /// Swaps the elements at indices `i` and `j`. Panics if either index is out of bounds.
    pub fn swap(&mut self, i: i64, j: i64) {
        if i < 0i64 || i >= self.len || j < 0i64 || j >= self.len {
            panic("Vec::swap: index out of bounds");
        }
        if i == j { return; }
        unsafe {
            let tmp: T = self.ptr[i];
            self.ptr[i] = self.ptr[j];
            self.ptr[j] = tmp;
        }
    }

    /// Removes and returns the last element, or `None` if empty.
    pub fn pop(&mut self) -> Option<T> {
        if self.len == 0 as i64 { 
            return Option::None; 
        }
        unsafe {
            self.len = self.len - 1 as i64;
            let val: T = self.ptr[self.len];
            return Option::Some(val);
        }
    }

    /// Removes and returns the element at index `i`, shifting later elements left (O(n)).
    /// Panics if `i` is out of bounds.
    pub fn remove(&mut self, i: i64) -> T {
        if i < 0 || i >= self.len {
            panic("Vec::remove: index out of bounds");
        }
        unsafe {
            let val: T = self.ptr[i];
            let mut j: i64 = i + 1;
            while j < self.len {
                self.ptr[j - 1] = self.ptr[j];
                j = j + 1;
            }
            self.len = self.len - 1;
            return val;
        }
    }

    /// Reverses the order of elements in place.
    pub fn reverse(&mut self) {
        unsafe {
            if self.len < 2i64 { return; }
            let mut i: i64 = 0i64;
            let mut j: i64 = self.len - 1i64;
            while i < j {
                let tmp: T = self.ptr[i];
                self.ptr[i] = self.ptr[j];
                self.ptr[j] = tmp;
                i = i + 1i64;
                j = j - 1i64;
            }
        }
    }

    /// Clears the vector, dropping every element; capacity is preserved for reuse.
    pub fn clear(&mut self) {
        unsafe {
            let p: *mut T = self.ptr;
            if p != 0 as *mut T {
                let mut i: i64 = 0;
                while i < self.len {
                    let _x: T = p[i];   // move-and-drop on scope exit
                    i = i + 1;
                }
            }
        }
        self.len = 0i64;
    }

    /// Borrows the whole vector as `&[T]` (Rust's `Vec::as_slice`).
    pub fn as_slice(&self) -> &[T] {
        unsafe { return slice_from_raw::<T>(self.ptr as *const T, self.len); }
    }

    /// Returns a borrowing iterator yielding `&T`.
    pub fn iter(&self) -> VecIter<T> {
        return VecIter {
            data: self.ptr as *const T, len: self.len,
            idx: 0i64, back_idx: self.len,
        };
    }

    /// Returns a mutable iterator yielding `&mut T`.
    pub fn iter_mut(&mut self) -> VecIterMut<T> {
        return VecIterMut { data: self.ptr, len: self.len, idx: 0 };
    }
}

// `v[i]` / `v[i] = x` (Rust parity). `Index`/`IndexMut` route to the existing
// bounds-checked `borrow` / `borrow_mut`; the `a[i]` lowering derefs the
// returned `&T` (read) or writes through the `&mut T` place.
impl<T> Index<i64, T> for Vec<T> {
    fn index(&self, idx: i64) -> &T { return self.borrow(idx); }
}
impl<T> IndexMut<i64, T> for Vec<T> {
    fn index_mut(&mut self, idx: i64) -> &mut T { return self.borrow_mut(idx); }
}

// ── VecIter<T> ────────────────────────────────────────────────────────────────

/// Borrowing iterator over a `Vec<T>` (`Vec::iter()` / `for x in &v`); yields `&T`.
/// Owns nothing; `Drop` is a no-op. Mirrors Rust's `slice::Iter`.
#[borrow_carrying]
pub struct VecIter<T> {
    data: *const T,
    len:  i64,
    idx:  i64,
    back_idx: i64,
}

impl<T> Iterator<&T> for VecIter<T> {
    fn next(self: &mut VecIter<T>) -> Option<&T> {
        if self.idx >= self.back_idx {
            return Option::None;
        }
        unsafe {
            let r: &T = &self.data[self.idx];
            self.idx = self.idx + 1;
            return Option::Some(r);
        }
    }
}

impl<T> DoubleEndedIterator<&T> for VecIter<T> {
    fn next_back(self: &mut VecIter<T>) -> Option<&T> {
        if self.idx >= self.back_idx {
            return Option::None;
        }
        unsafe {
            self.back_idx = self.back_idx - 1;
            let r: &T = &self.data[self.back_idx];
            return Option::Some(r);
        }
    }
}

impl<T> ExactSizeIterator<&T> for VecIter<T> {
    fn len(&self) -> i64 { return self.back_idx - self.idx; }
}

// ── VecIntoIter<T> — owning iterator (`Vec::into_iter` / `for x in v`) ─────────
// Yields `T` by value and OWNS the buffer: Drop walks un-yielded elements
// (firing T's Drop on each, mirroring Vec::drop) and deallocates. Mirrors
// Rust's `vec::IntoIter`.
/// Owning iterator over a `Vec<T>` (`into_iter` / `for x in v`); yields `T` by value.
/// On drop, un-yielded elements are dropped and the buffer is deallocated.
pub struct VecIntoIter<T> {
    data: *const T,
    len:  i64,
    idx:  i64,
    back_idx: i64,
}

impl<T> Iterator<T> for VecIntoIter<T> {
    fn next(self: &mut VecIntoIter<T>) -> Option<T> {
        if self.idx >= self.back_idx {
            return Option::None;
        }
        unsafe {
            let val: T = self.data[self.idx];
            self.idx = self.idx + 1;
            return Option::Some(val);
        }
    }
}

impl<T> DoubleEndedIterator<T> for VecIntoIter<T> {
    fn next_back(self: &mut VecIntoIter<T>) -> Option<T> {
        if self.idx >= self.back_idx {
            return Option::None;
        }
        unsafe {
            self.back_idx = self.back_idx - 1;
            let val: T = self.data[self.back_idx];
            return Option::Some(val);
        }
    }
}

impl<T> ExactSizeIterator<T> for VecIntoIter<T> {
    fn len(&self) -> i64 { return self.back_idx - self.idx; }
}

impl<T> Drop for VecIntoIter<T> {
    fn drop(self: VecIntoIter<T>) {
        unsafe {
            let p: *mut T = self.data as *mut T;
            if p != 0 as *mut T {
                let mut i: i64 = self.idx;
                while i < self.back_idx {
                    let _x: T = p[i];   // move-and-drop on scope exit
                    i = i + 1i64;
                }
                dealloc(p as *mut u8);
            }
        }
    }
}

// ── VecIterMut<T> ─────────────────────────────────────────────────────────────

/// Mutable borrowing iterator over a `Vec<T>` (`Vec::iter_mut()`); yields `&mut T`.
#[borrow_carrying]
pub struct VecIterMut<T> {
    data: *mut T,
    len:  i64,
    idx:  i64,
}

impl<T> Iterator<&mut T> for VecIterMut<T> {
    fn next(self: &mut VecIterMut<T>) -> Option<&mut T> {
        if self.idx >= self.len {
            return Option::None;
        }
        unsafe {
            let r: &mut T = &mut self.data[self.idx];
            self.idx = self.idx + 1;
            return Option::Some(r);
        }
    }
}

// ── IntoIterator impls ────────────────────────────────────────────────────────

// `for x in v` — consumes the Vec, yields T by value (Rust parity).
impl<T> IntoIterator<T> for Vec<T> {
    type Iter = VecIntoIter<T>;
    fn into_iter(self: Vec<T>) -> VecIntoIter<T> {
        // Transfer buffer ownership to the iterator: its Drop frees the heap.
        // Suppress self's auto-Drop by zeroing self.ptr through unsafe pointer
        // aliasing — Vec::drop's null-ptr guard then no-ops, avoiding a
        // double-free.
        let it: VecIntoIter<T> = VecIntoIter {
            data: self.ptr as *const T, len: self.len,
            idx: 0i64, back_idx: self.len,
        };
        unsafe {
            let pp: *mut *mut T = (&self.ptr) as *const *mut T as *mut *mut T;
            *pp = 0 as *mut T;
        }
        return it;
    }
}

// `for x in &v` — borrows, yields &T by reference (Rust parity).
impl<T> IntoIterator<&T> for &Vec<T> {
    type Iter = VecIter<T>;
    fn into_iter(self: &Vec<T>) -> VecIter<T> {
        return VecIter {
            data: self.ptr as *const T, len: self.len,
            idx: 0i64, back_idx: self.len,
        };
    }
}

// ── FromIterator impl ─────────────────────────────────────────────────────────

impl<T> FromIterator<T> for Vec<T> {
    fn from_iter<I: Iterator<T>>(iter: I) -> Vec<T> {
        let mut v: Vec<T> = vec_new::<T>();
        let mut it: I = iter;
        loop {
            match it.next() {
                Option::None    => { return v; }
                Option::Some(x) => { v.push(x); }
            }
        }
    }
}

// Rust's `impl<T, E, V: FromIterator<T>> FromIterator<Result<T, E>>
// for Result<V, E>` specialised to V = Vec<T>. The impl-target pattern
// is `Result<Vec<T>, E>` (partial spec — T appears inside Vec, not as
// the receiver's first type-arg directly). Mono unifies the pattern
// against the concrete receiver `Result<Vec<i32>, i32>` to bind T=i32
// (CP-cm-16 follow-up). Driven end-to-end by result::test_collect via
// `vec.into_iter().collect::<Result<Vec<i32>, i32>>()`.
impl<T, E> FromIterator<Result<T, E>> for Result<Vec<T>, E> {
    fn from_iter<I: Iterator<Result<T, E>>>(iter: I) -> Result<Vec<T>, E> {
        let mut it: I = iter;
        let mut out: Vec<T> = vec_new::<T>();
        loop {
            match it.next() {
                Option::None    => { return Result::Ok(out); }
                Option::Some(r) => {
                    match r {
                        Result::Ok(x)  => { out.push(x); }
                        Result::Err(e) => { return Result::Err(e); }
                    }
                }
            }
        }
    }
}

/// Returns `true` if `v` contains an element equal to `val` — linear scan, requires `T: Eq`.
/// Free-fn form keeps the base `impl<T> Vec<T>` bound-free; see also `Vec::contains`.
pub fn vec_contains<T: Eq>(v: &Vec<T>, val: &T) -> bool {
    let mut i: i64 = 0;
    unsafe {
        while i < v.len {
            let item: T = v.ptr[i];
            if (&item).eq(val) {
                return true;
            }
            i = i + 1;
        }
    }
    return false;
}

// §2 Wave 9 — `vec.contains(&val)` method-call shape (Rust API parity).
// Bound `T: Eq` keyed on a separate impl block so the bare `impl<T> Vec<T>`
// stays bound-free for other methods.
impl<T: Eq> Vec<T> {
    /// Returns `true` if the vector contains an element equal to `val` (linear scan).
    pub fn contains(&self, val: &T) -> bool {
        return vec_contains::<T>(self, val);
    }
}

// Auto-Drop (Rust parity). On scope exit:
//   • each live element [0 .. len) is moved out and dropped (firing T's
//     Drop if it has one; no-op for POD/Copy T);
//   • the heap storage is freed.
// No manual free — like Rust, a Vec just drops. (`VecIter`/`into_iter` transfer
// buffer ownership by nulling `ptr`, which the null-guard below honors; it was
// also the shallow `vec_free`'s job, now gone — Drop frees elements too.)
impl<T> Drop for Vec<T> {
    fn drop(self: Vec<T>) {
        unsafe {
            let p: *mut T = self.ptr;
            if p != 0 as *mut T {
                let mut i: i64 = 0;
                while i < self.len {
                    let _x: T = p[i];   // move-and-drop on scope exit
                    i = i + 1;
                }
                dealloc(p as *mut u8);
            }
        }
    }
}

// SL-sl-05: drain an iterator of `Result<T, E>` into `Result<Vec<T>, E>`,
// short-circuiting on the first Err (matches Rust's
// `collect::<Result<Vec<T>, E>>()`).
/// Collects an iterator of `Result<T, E>` into `Result<Vec<T>, E>`,
/// short-circuiting on the first `Err`.
pub fn iter_collect_result_vec<I: Iterator<Result<T, E>>, T, E>(iter: I) -> Result<Vec<T>, E> {
    let mut it: I = iter;
    let mut out: Vec<T> = vec_new::<T>();
    loop {
        match it.next() {
            Option::None    => { return Ok(out); }
            Option::Some(r) => {
                match r {
                    Result::Ok(v)  => { out.push(v); }
                    Result::Err(e) => { return Err(e); }
                }
            }
        }
    }
}

// SL-sl-05: drain an iterator into a fresh Vec<T>. Free-fn form because
// the standard `.collect::<Vec<T>>()` Rust path needs FromIterator infra
// (and turbofish on a method-generic call) that isn't wired up yet. Lives
// in this package — `iter` can't depend on `vec` (cycle).
/// Drains an iterator into a new `Vec<T>`.
pub fn iter_collect_vec<I: Iterator<T>, T>(iter: I) -> Vec<T> {
    let mut it: I = iter;
    let mut out: Vec<T> = vec_new::<T>();
    loop {
        match it.next() {
            Option::None    => { return out; }
            Option::Some(v) => { out.push(v); }
        }
    }
    return out;
}

/// Splits an iterator into two `Vec`s by a predicate: items where `pred` is true go to
/// `first`, the rest to `second`. Rust's `Iterator::partition::<Vec<T>>` in free-fn form.
pub fn iter_partition_vec<I: Iterator<T>, T>(
    iter: I, pred: fn(T) -> bool,
) -> ZipPair<Vec<T>, Vec<T>> {
    let mut it: I = iter;
    let mut yes: Vec<T> = vec_new::<T>();
    let mut no:  Vec<T> = vec_new::<T>();
    loop {
        match it.next() {
            Option::None    => { return ZipPair { first: yes, second: no }; }
            Option::Some(v) => {
                unsafe {
                    let v_copy: T = *((&v) as *const T);
                    let take_yes: bool = pred(v_copy);
                    if take_yes {
                        (&mut yes as *mut Vec<T>).push(v);
                    } else {
                        (&mut no as *mut Vec<T>).push(v);
                    }
                }
            }
        }
    }
}

// Cross-package skip-codegen probe: pre-instantiate Vec<i32> in this package.
// Downstream users of Vec<i32> link against these symbols and skip body emission.
pub instantiate Vec<i32>;
