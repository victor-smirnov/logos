// Logos standard library — logos.mem.stream
//
// `Buffer<R>` — the DEGENERATE batch stream of ADR 0025 §4: today's `Vec`,
// read as a stream that hands out its whole contents as ONE packet.
//
// "A Vec is an eagerly-drained stream, never the reverse" stops being a
// comment here and becomes the type lattice: `Buffer` is what `Drain` /
// `Sort` / `Arrange` (§4) produce, and it implements every capability a
// materialized relation actually has — `Rewind` (the rows are still there),
// `SizedStream` (the length is a field), and the traversal chain
// `Bidirectional`/`RandomAccess` (ADR §3: heap slices and `Buffer` are
// trivially random-access — position is field arithmetic, not a descent).
// It does NOT implement `OrderedBy<K>`:
// a plain `Vec` carries no order fact, and faking one would put the lie the
// trait exists to prevent right into the vocabulary. The `Sort` adapter's
// output type — a sorted buffer — is what will carry `OrderedBy`, when Sort
// lands (§4, S2).
//
// WHY IT IS HERE AND NOT NEXT TO THE TRAITS: the vocabulary is language tier
// (`logos.lang.stream`, ADR §11), but the lang tier is no-alloc/no-OS and
// `Vec` is `logos.mem.collections.vec`. The traits and the borrowed batch view
// stay above the allocator; the one implementation that OWNS heap rows lives
// at mem tier.

package logos.mem.stream;

use logos.lang.option;
use logos.lang.slice;         // slice_get_range — the packet is a suffix after a seek
use logos.lang.stream;
use logos.mem.collections.vec;

// OWNERSHIP: `Buffer<R>` OWNS its `Vec<R>` — it is not `#[borrow_carrying]`.
// That is the right default for the degenerate stream because a Buffer is the
// RESULT of a materialization: `Drain` exists precisely to end a borrow (the
// source was read-once, or its leaf pin must be released before the next
// pass), so a Buffer that borrowed its rows from somewhere else would not have
// materialized anything. Owning also makes it the one shape that can outlive
// the source scope — the `buffered` output form of §12 returns exactly this.
//
// The BATCH it hands out does borrow: `next()` returns `RowsBatch<R>` = `&[R]`
// pointing into the owned buffer, tied by the compiler to the `&mut self` of
// the call. That is rung 1 of the pin ladder (§7) with nothing to pin: no
// counter, and a `push` while a batch lives is a borrow-check error, not a
// convention.

/// The degenerate batch stream (ADR 0025 §4): an owned `Vec<R>` served as ONE packet.
///
/// Yields the whole buffer as a single `RowsBatch<R>`, then `None`. This is what the
/// `Drain`/`Sort`/`Arrange` adapters produce and what a `Vec`-shaped source becomes,
/// so the "is it a slice or a stream?" branch disappears: it is always a stream, and
/// a `Vec` is the one-packet case.
///
/// z⁻¹ / THE ARRANGED INPUT (ADR 0025 §10). A `Buffer` KEPT ACROSS EPOCHS is DBSP's
/// unit delay: state carried from epoch n to epoch n+1, replayable because it is
/// `Rewind` and materialized because a delay must survive the borrow that produced it
/// (which is why this type OWNS — see the ownership note above; `Epoch<R>`, the delta
/// itself, borrows and does NOT own, and that asymmetry IS the seam). With `Weighted<R>`
/// (`logos.lang.stream`) the same type is a delta stream that mixes signs:
/// `Buffer<Weighted<R>>` is DBSP's arranged input with no new type — pinned by
/// `stream_weighted_epoch_seam`, which folds one mixed-sign packet against the two
/// constant-weight epochs it replaces and asserts the two agree.
///
/// Implements `Rewind`, `SizedStream`, and the whole TRAVERSAL chain of §3
/// (`Bidirectional` + `RandomAccess`) — an array nothing consumes is random-access by
/// construction. Not `OrderedBy<K>`: an unsorted buffer has no order fact to declare.
pub struct Buffer<R> {
    /// The materialized rows. Owned: a Buffer is the result of a materialization (§4).
    rows: Vec<R>,
    /// False until the single packet has been handed out; `rewind` clears it.
    sent: bool,
    /// The POSITION inside the landing: the first row of the packet `next()` hands
    /// out (`RandomAccess::seek_nth`, ADR §3). `0` for every Buffer that was never
    /// seeked, which is why `size()` — the LANDING's total — is untouched by it.
    at: u64,
}

impl<R> Buffer<R> {
    /// Wraps materialized rows as a one-packet stream, positioned at the start.
    pub fn from_vec(rows: Vec<R>) -> Buffer<R> {
        return Buffer { rows: rows, sent: false, at: 0u64 };
    }

    /// An empty buffer — the stream that yields one empty batch, then `None`.
    pub fn new() -> Buffer<R> {
        // `Vec::<R>::new()`, not `Vec::new()`: the bare form infers the element
        // type from nothing here and lands on the impl's own parameter name
        // ("return type mismatch — expected Buffer<R>, got Buffer<T>").
        return Buffer { rows: Vec::<R>::new(), sent: false, at: 0u64 };
    }

    /// Appends a row. Producer-side surface: the `buffered` output form (§12) fills a
    /// Buffer with the emitted push-shaped body, then serves it through `BatchStream`.
    pub fn push(&mut self, row: R) {
        self.rows.push(row);
    }

    /// Borrows all rows at once, independent of the stream position (`Rewind` + `SizedStream`
    /// already say the rows stay put). The random-access face of the same storage.
    pub fn as_slice(&self) -> &[R] {
        return self.rows.as_slice();
    }

    // ── THE MATERIALIZED-RELATION FACE (ADR 0025 R-H (b′)) ──────────────────
    //
    // `len` and `get` exist so that the QUERY-OUTPUT LANDING can be a `Buffer`
    // without re-spelling the 18 emitted sites that READ it (`rexpr_walk`: 17
    // limit guards `__out.len() < (N)` and one `distinct` rescan, which is the
    // tree's only `__out.get(`). ⚠ NOT a convenience: the same emitted quote
    // FRAGMENTS are shared with the fixpoint/DRed plane, where `__out` is a
    // `&mut Vec<R>` ALIAS onto `__rout`/`__nd_<m>` (381 bindings, unmoved by
    // (b′)). A fragment that read `__out.as_slice().len()` would work over both
    // — and would also break two pinned literals (`order_desc_pair_gate.sh`,
    // `order_elision_pair_gate.sh` pin the TEXT `__out.len() < (3i64)`), for
    // nothing. Naming the two methods here keeps ONE spelling valid over BOTH
    // landing types, which is what makes the fragments shareable at all.
    //
    // `i64` and not `u64`: these mirror `Vec::len`/`Vec::get` exactly, because
    // the whole point is that the emitted text does not know which of the two
    // types it is standing on. `SizedStream::size` (u64) is the STREAM's length
    // and stays what it was.

    /// The number of rows in the landing — `Vec::len`'s spelling, so an emitted
    /// fragment reads a `Buffer` landing and a `&mut Vec` alias identically.
    pub fn len(&self) -> i64 {
        return self.rows.len();
    }

    // ⚠ THERE IS NO `get`, AND THE REASON IS A MEASUREMENT, NOT A CHOICE.
    // `pub fn get(&self, i: i64) -> R { return self.rows.get(i); }` is REFUSED
    // here — `Vec::get` moves the element out by value and `R` is a bare type
    // parameter, so the borrow checker answers (measured, this file, line 131):
    //   "cannot move a non-Copy element out of `Vec` via `get` (element type
    //    `R` is not `Copy`) … Use `.borrow(i)` for a `&R` reference".
    // `Vec::get` is usable in the EMITTED text only because each emitted query
    // instantiates it at a concrete `Copy` row type; a generic wrapper has no
    // such instantiation to hide behind. So the ONE emitted site that read the
    // landing by index (`push_guarded_frag`'s `distinct` rescan, the tree's
    // only `__out.get(`) reads `__out.as_slice()` instead — a spelling valid
    // over BOTH this type and the `&mut Vec` aliases, which is the same
    // constraint that put `len` here.

    /// The packet as of the current position: `rows[at..]`. ONE spelling for all four
    /// pulls (`next`, `prev`, and both after a `seek_nth`) — the position lives in a
    /// field, so the packet is derived, never a second slicing rule per door.
    fn packet(&self) -> &[R] {
        return slice_get_range::<R>(self.rows.as_slice(), self.at as i64, self.rows.len());
    }

    /// Pulls the single packet — THE INHERENT DOOR, the one the query plane calls.
    ///
    /// ADR 0025 S6. `rexpr_walk::batch_scan_frag` (§1's one scan shape) spells the
    /// outer pull as `next_batch()`, an INHERENT method, with its own ground: a
    /// generated chunk's import list is derived from the natspec, and
    /// `Iterator::next` / `BatchStream::next` share name and receiver shape, which
    /// is why `logos.lang.stream` is out of the prelude. The generated container
    /// family has carried this door since S0 (`container_item.logos`, `next_batch`
    /// + a `BatchStream::next` that delegates); `Buffer` — the DEGENERATE stream,
    /// the form every prebuilt `Vec` source takes — carried only the trait method,
    /// so it implemented the protocol and could not be consumed BY it. Measured,
    /// before this method existed, on a user source whose producer returns a
    /// `Buffer`: sema accepted the declaration, the natspec carried `b`, the plan
    /// said "streamed", and codegen died with
    /// `'Buffer$…$G1$tup$2$i64$i64' has no method 'next_batch'`.
    ///
    /// Same body as `BatchStream::next` — which now delegates here, so the two
    /// doors cannot drift.
    pub fn next_batch(&mut self) -> Option<RowsBatch<R>> {
        if self.sent { return Option::None; }
        self.sent = true;
        return Option::Some(self.packet());
    }

    /// Gives the rows back as a `Vec`, consuming the stream.
    // `self: Self`, not the Rust-style bare `self`: bare by-value `self` is a
    // syntax error here ("syntax error near 'self'"); the by-value receiver is
    // spelled explicitly, as in `logos.lang.ops` (`fn add(self: Self, …)`).
    pub fn into_vec(self: Self) -> Vec<R> {
        return self.rows;
    }
}

// One packet: the whole buffer, then exhaustion. An EMPTY buffer still yields
// one `Some(empty)` before `None` — §1 says an empty batch is a legal tick, and
// making the empty case yield nothing at all would make "no rows" indistinguishable
// from a stream that never ran.
impl<R> BatchStream<RowsBatch<R>> for Buffer<R> {
    fn next(&mut self) -> Option<RowsBatch<R>> { return self.next_batch(); }
}

// The batches are `RowsBatch<R>` = `&[R]` — row-major (ADR 0025 §2). The marker is
// what makes the emitter spell `bb[j]` instead of the columnar `bb.<col>_at(j)`; see
// `logos.lang.stream::RowMajor` for why the layout is a trait and not a declaration.
impl<R> RowMajor for Buffer<R> {}

// Re-landing a materialized buffer is free: the rows were never given up.
// `rewind` re-LANDS, so it clears the seek position too — that is the whole
// difference from `seek_nth(0)`, which only re-positions.
impl<R> Rewind for Buffer<R> {
    fn rewind(&mut self) {
        self.sent = false;
        self.at = 0u64;
    }
}

// The length is a field — no drain, no walk. NOT reduced by `seek_nth`: `size`
// is the LANDING's total (ADR §3), and seeking moves a position inside it.
impl<R> SizedStream for Buffer<R> {
    fn size(&self) -> u64 {
        return self.rows.len() as u64;
    }
}

// ── The traversal axis (ADR 0025 §3) ────────────────────────────────────────
//
// A `Buffer` is trivially RANDOM-ACCESS: its rows are a contiguous array that
// nothing consumes, so both `prev` and `seek_nth` are field arithmetic — there
// is no descent to pay and no re-materialization. That is why §3 puts heap
// slices and `Buffer` at the TOP of the chain while a btree walk sits in the
// middle: the degenerate stream is degenerate in this axis too.

/// `prev` UN-CONSUMES the single packet: after `next()` handed it out, `prev()` hands
/// out the same packet and leaves the stream at the start, so a further `prev()` is
/// `None`. Exactly the mirror of `next`, on a stream whose whole content is one batch.
impl<R> Bidirectional<RowsBatch<R>> for Buffer<R> {
    fn prev(&mut self) -> Option<RowsBatch<R>> {
        if !self.sent { return Option::None; }
        self.sent = false;
        return Option::Some(self.packet());
    }
}

/// One packet means one position: `seek_nth(n)` makes the packet the SUFFIX from row
/// `n` and un-sends it, so the next `next()` yields `rows[n..]`. `n` past the end is
/// the empty suffix — one legal empty tick, then `None` — never a panic (§3).
impl<R> RandomAccess<RowsBatch<R>> for Buffer<R> {
    fn seek_nth(&mut self, n: u64) {
        let len: u64 = self.rows.len() as u64;
        self.at = if n > len { len } else { n };
        self.sent = false;
    }
}
