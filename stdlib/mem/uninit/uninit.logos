// Logos standard library — std.mem.uninit
//
// MaybeUninit<T> — wrapper for memory that may be uninitialized.
//
// Mirrors `core::mem::MaybeUninit` for porting purposes. Common shape:
//
//   let mut x: MaybeUninit<i32> = MaybeUninit::<i32>::uninit();
//   x.write(42i32);
//   let v: i32 = unsafe { x.assume_init() };
//
// Surface ported: `new` / `uninit` / `zeroed` / `write` / `as_ptr` /
// `as_mut_ptr` / `assume_init` / `assume_init_read` / `assume_init_ref` /
// `assume_init_mut`.
//
// Lives in mem-tier (not lang) because `zeroed`/`uninit` use the
// allocator (alloc + zero_bytes + dealloc) to produce a zero-filled
// value of type `T` without taking a `T` by-value first — Logos has no
// "leave bytes undef" primitive at the type level.
//
// Divergence from Rust:
//   - Storage is the inner `value: T` field, not a `union { uninit, T }`.
//     `uninit()` returns memory zero-filled via the workaround above; the
//     contract is identical (caller MUST initialize before reading).
//   - If `T: Drop`, MaybeUninit<T> still has a droppable `value` field;
//     Logos's auto-field-drop would call drop on the zero-shaped value
//     if MaybeUninit goes out of scope without `assume_init`. Workaround
//     for the initial port: use only with `T: Copy`, OR explicitly
//     consume via `assume_init` before drop. A byte-storage form (no
//     droppable field) would need per-instantiation const-array sizing
//     that the language doesn't currently support.

package logos.mem.uninit;

use logos.lang.mem;

/// Wraps a possibly-uninitialized `T`; mirrors `core::mem::MaybeUninit`.
/// Storage is an inner `value: T` field, not a union: `uninit()` zero-fills, so reads are
/// defined-but-meaningless rather than UB. Caller must still initialize before reading as `T`.
/// If `T: Drop`, going out of scope without `assume_init` runs drop on the zero-shaped value.
pub struct MaybeUninit<T> {
    value: T,
}

impl<T> MaybeUninit<T> {
    /// Wraps an already-initialized value.
    pub fn new(val: T) -> MaybeUninit<T> {
        return MaybeUninit { value: val };
    }

    /// Creates zero-filled storage.
    /// Always sound to read as bytes; reading as `T` is sound only when zero is a valid
    /// bit-pattern for `T` (integer/pointer primitives yes; not generally enums/refs).
    pub fn zeroed() -> MaybeUninit<T> {
        unsafe {
            let sz: i64 = sizeof::<MaybeUninit<T>>();
            let raw: *mut u8 = alloc(sz);
            zero_bytes(raw, sz);
            let m: MaybeUninit<T> = *(raw as *const MaybeUninit<T>);
            dealloc(raw);
            return m;
        }
    }

    /// Creates storage the caller promises to write before reading.
    /// Identical to `zeroed()` in Logos (no "true undef" representation); the safety
    /// contract is inherited from Rust.
    pub fn uninit() -> MaybeUninit<T> {
        return MaybeUninit::<T>::zeroed();
    }

    /// Initializes the slot with `val` and returns a `&mut T` for further mutation.
    /// Subsequent `assume_init*` calls are safe (provided no intervening uninit-write).
    pub fn write(self: &mut MaybeUninit<T>, val: T) -> &mut T {
        self.value = val;
        return &mut self.value;
    }

    /// Returns a const pointer to the underlying storage.
    /// Safe to call; using the pointer before initialization is the caller's responsibility.
    pub fn as_ptr(&self) -> *const T {
        unsafe { return (&self.value) as *const T; }
    }

    /// Returns a mutable pointer to the underlying storage; same contract as `as_ptr`.
    pub fn as_mut_ptr(self: &mut MaybeUninit<T>) -> *mut T {
        unsafe { return (&mut self.value) as *mut T; }
    }

    /// Consumes the wrapper and returns the inner value.
    /// Caller MUST have written a valid `T` first (via `write`, `new`, or ptr-write
    /// through `as_mut_ptr`). Reading a freshly-uninited value is UB by Rust's contract;
    /// in Logos the bytes are zero, so the result is whatever zero means for `T`.
    pub unsafe fn assume_init(self: MaybeUninit<T>) -> T {
        return self.value;
    }

    /// Reads the inner value through `&self` without consuming the wrapper.
    /// Same contract as `assume_init`; duplicates the value, so intended for `T: Copy`
    /// (Rust permits any `T`; Logos shadows the same shape).
    pub unsafe fn assume_init_read(&self) -> T {
        unsafe {
            return *((&self.value) as *const T);
        }
    }

    /// Returns a shared reference to the inner value; same contract as `assume_init`.
    pub unsafe fn assume_init_ref(&self) -> &T {
        return &self.value;
    }

    /// Returns a mutable reference to the inner value; same contract as `assume_init`.
    pub unsafe fn assume_init_mut(self: &mut MaybeUninit<T>) -> &mut T {
        return &mut self.value;
    }
}
