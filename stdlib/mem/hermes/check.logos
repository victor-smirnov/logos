// logos.mem.hermes.check — structural validation of a hermes2 value tree.
//
// hermes2_check(v) walks the reachable graph and verifies the structural
// invariants every reader relies on:
//   - Pod codes are known (bool/int/i24-family/PARAM);
//   - Refs resolve to objects with a KNOWN type tag;
//   - container metadata is sane (len <= cap, sizes non-negative);
//   - children validate recursively.
//
// Direct-walker foundation (stringify/equal/hashing/clone siblings); the
// Hermes1 HermesCheck dispatch table is retired.

package logos.mem.hermes.check;

use logos.lang.hermes.anyval;     // HAny, h2_type_code
use logos.lang.hermes.array;      // HArray<HVal>
use logos.lang.hermes.hmap;       // HMap<HString, HVal>
use logos.lang.hermes.hstring;    // HString

pub fn hermes2_check(v: HAny) -> bool {
    if v.is_null() { return true; }
    if v.is_pod() {
        let c: u8 = v.pod_code();
        // Known inline codes: i56(1), bool(2), i8..u32 family, i24(23), PARAM(127).
        if c == 1 as u8 || c == 2 as u8 || c == 23 as u8 || c == 127 as u8 { return true; }
        if c >= 16 as u8 && c <= 22 as u8 { return true; }   // small-int family
        return v.is_int() || v.is_bool();                    // accessor-known fallback
    }
    unsafe {
        let p: *const u8 = v.resolve();
        if p == (0 as *const u8) { return false; }
        let tc: u64 = h2_type_code(p);
        if tc == 0u64 { return false; }                      // unset / corrupt tag

        if v.is_string() {
            let s: &HString = &*(p as *const HString);
            return s.len() >= 0i64;
        }
        if v.is_array() {
            let a: &HArray<HVal> = &*(p as *const HArray<HVal>);
            let n: i64 = a.len();
            if n < 0i64 { return false; }
            let mut i: i64 = 0;
            while i < n {
                if !hermes2_check(a.get(i)) { return false; }
                i = i + 1;
            }
            return true;
        }
        if v.is_map() {
            let m: &HMap<HString, HVal> = &*(p as *const HMap<HString, HVal>);
            if m.len() < 0i64 || m.len() > m.slots() { return false; }
            let cap: i64 = m.slots();
            let mut i: i64 = 0;
            while i < cap {
                let k: HAny = m.key_at(i);
                if !k.is_null() {
                    if !k.is_string() { return false; }      // keys must be strings
                    if !hermes2_check(m.val_at(i)) { return false; }
                }
                i = i + 1;
            }
            return true;
        }
        // Boxed wide scalars: 8-byte payload, nothing further to walk.
        if tc == H2_I64 || tc == H2_U64 || tc == H2_F32 || tc == H2_F64 { return true; }
        // Typed dense arrays: size <= capacity.
        if tc >= 2101u64 && tc <= 2110u64 {
            let sz: u64 = *(p as *const u64);
            let cap: u64 = *(((p as i64) + 8) as *const u64);
            return sz <= cap;
        }
        // Typed dense maps: size <= capacity + valid value slots.
        if tc >= 3101u64 && tc <= 3104u64 {
            let sz: i64 = *(p as *const i64);
            let cap: i64 = *(((p as i64) + 8) as *const i64);
            if sz < 0i64 || sz > cap { return false; }
            let vf: i64 = (p as i64) + 24;
            let vals: i64 = vf + *(vf as *const i64);
            let mut i: i64 = 0;
            while i < sz {
                if !hermes2_check(h2k_at(vals + i * 8)) { return false; }
                i = i + 1;
            }
            return true;
        }
        // TypedValue: three checked fields.
        if tc == 4115u64 {
            let mut f: i64 = 0;
            while f < 3 {
                if !hermes2_check(h2k_at((p as i64) + f * 8)) { return false; }
                f = f + 1;
            }
            return true;
        }
        // TinyObjectMap reached as a bare ref (schema'd AST nodes).
        if tc == H2_TINYMAP { return true; }
        // User datatype tags (#[type_code] >= 129) are opaque but legal.
        return tc >= 129u64;
    }
}

// Materialize the at-rest HAny word at `slot_addr`.
unsafe fn h2k_at(slot_addr: i64) -> HAny {
    let w: i64 = *(slot_addr as *const i64);
    if w == 0i64 { return HAny::Ref(0i64 as *const u8); }
    if (w & 1i64) == 1i64 { return HAny::Pod(w as u64); }
    return HAny::Ref((slot_addr + w) as *const u8);
}
