// Logos Hermes stdlib — hermes.parser
//
// Recursive-descent parser for the Hermes text format.
//
// Supported grammar subset:
//   value   := null | true | false | number | float | string | array | map
//   number  := [-] (0x hex | decimal) suffix?
//   float   := [-] decimal '.' decimal (('e'|'E') ['+'|'-'] decimal)?
//   suffix  := _u8 | _u16 | _u32 | _s8 | _s16 | _s32 | _s64 | _u64
//   string  := '"' (char | escape)* '"'
//   escape  := \" | \\ | \/ | \n | \r | \t | \b | \f
//   array   := '[' (value (',' value)* ','?)? ']'
//   map     := '{' (entry (',' entry)* ','?)? '}'
//   entry   := (ident | string) ':' value
//   skipper := (space | tab | newline | '//' to-eol)*
//
// Not supported: raw strings ('...'), Unicode escapes (\uXXXX),
//   type declarations, type directory (#{...}).
// Supported: $N positional PARAM placeholders (embed_param, type_hash=127).
//
// Array capacity: 64 elements.  Map capacity: 64 slots (power-of-2).
// Strings: max 1023 UTF-8 bytes (scratch buffer limit).
//
// Entry point:
//   pub unsafe fn hermes_parse(text: str, zone: &mut Zone<Mutable>) -> bool
//
// On success:   zone[0..7] holds DocumentHeader with root set.
// On failure:   returns false; zone state is undefined.

package logos.mem.hermes.parser;

use logos.lang.hermes.zone;
use logos.lang.hermes.anyval;
use logos.lang.hermes.view;
use logos.lang.hermes.string;
use logos.lang.hermes.typetag;
use logos.lang.hermes.datatag;
use logos.lang.hermes.array;
use logos.lang.hermes.map;
use logos.lang.hermes.typed_value;
use logos.lang.hermes.objectmap;
use logos.lang.hermes.document;
use logos.lang.hermes.scalar;
use logos.mem.hermes.decimal;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

// ---------------------------------------------------------------------------
// Float helpers
// ---------------------------------------------------------------------------

// Reinterpret the bit pattern of an f32 value as u32.
// This is the standard "type-punning via pointer" trick.
unsafe fn f32_to_bits(v: f32) -> u32 {
    let mut tmp: f32 = v;
    let p: *const f32 = &tmp as *const f32;
    let q: *const u32 = p as *const u32;
    return *q;
}

// Return 10^n as f32 for small non-negative n (n <= 38).
// Uses a simple multiplication loop.
fn pow10_f32(n: i64) -> f32 {
    let mut result: f32 = 1.0;
    let mut i: i64 = 0;
    while i < n {
        result = result * 10.0;
        i = i + 1;
    }
    return result;
}

// ---------------------------------------------------------------------------
// HermesParser — recursive-descent parser state
// ---------------------------------------------------------------------------

pub struct HermesParser {
    pub text: str,                       // input (not owned)
    pub pos:  i64,                       // current read position
    pub zone:    *mut Zone<Mutable>,     // output zone (not owned)
    pub base:    *mut u8,                // zone.holder.base cached
    pub scratch: *mut u8,                // 1 KiB malloc buffer for string building
    pub ok:      bool,                   // false → parse error
}

pub struct TypedContainerSpec {
    pub ok: bool,
    pub next: u8,         // '[' or '{'
    pub arg_count: i64,
    pub a0_start: i64,
    pub a0_end: i64,
    pub a1_start: i64,
    pub a1_end: i64,
    pub key_atom: u8,     // for map key or array element
    pub val_atom: u8,     // for map value
    pub mat: u8,          // selected pre-materialization
}

impl TypedContainerSpec {
    pub static fn invalid() -> TypedContainerSpec {
        return TypedContainerSpec {
            ok: false,
            next: 0,
            arg_count: 0,
            a0_start: 0,
            a0_end: 0,
            a1_start: 0,
            a1_end: 0,
            key_atom: 0,
            val_atom: 0,
            mat: 0,
        };
    }
}

impl HermesParser {

    pub unsafe fn create(text: str,
                         zone: *mut Zone<Mutable>) -> HermesParser {
        let sc: *mut u8 = malloc(1024);
        // If scratch allocation fails, mark the parser failed immediately so
        // parse_value returns early before any string path touches scratch.
        let ok: bool = sc != 0 as *mut u8;
        let base: *mut u8 = zone.holder.base;
        return HermesParser {
            text: text,
            pos:  0,
            zone:    zone,
            base:    base,
            scratch: sc,
            ok:      ok,
        };
    }

    pub unsafe fn destroy(&mut self) {
        free(self.scratch);
        self.scratch = 0 as *mut u8;
    }

    // ── Character access ─────────────────────────────────────────────────────

    pub unsafe fn at_end(&mut self) -> bool {
        return self.pos >= self.text.len();
    }

    pub unsafe fn peek(&mut self) -> u8 {
        if self.at_end() { return 0; }
        return *((self.text.as_ptr() as i64 + self.pos) as *const u8);
    }

    // Peek at current position + off (0-indexed from pos).
    pub unsafe fn peek_at(&mut self, off: i64) -> u8 {
        let p: i64 = self.pos + off;
        if p >= self.text.len() { return 0; }
        return *((self.text.as_ptr() as i64 + p) as *const u8);
    }

    pub unsafe fn advance(&mut self) -> u8 {
        let c: u8 = self.peek();
        self.pos = self.pos + 1;
        return c;
    }

    // ── Whitespace + line-comment skipping ───────────────────────────────────

    pub unsafe fn skip(&mut self) {
        let mut going: bool = true;
        while going == true && !self.at_end() {
            let c: u8 = self.peek();
            // space=32, tab=9, LF=10, CR=13
            if c == 32 || c == 9 || c == 10 || c == 13 {
                self.pos = self.pos + 1;
            } else if c == 47 && self.peek_at(1) == 47 {
                // '//' comment: skip to end of line
                self.pos = self.pos + 2;
                while !self.at_end() && self.peek() != 10 {
                    self.pos = self.pos + 1;
                }
            } else {
                going = false;
            }
        }
    }

    // ── Character classification ──────────────────────────────────────────────

    pub unsafe fn is_digit(&mut self, c: u8) -> bool {
        return c >= 48 && c <= 57;
    }
    pub unsafe fn is_ident_start(&mut self, c: u8) -> bool {
        return (c >= 65 && c <= 90)
            || (c >= 97 && c <= 122)
            || c == 95;
    }
    pub unsafe fn is_ident_char(&mut self, c: u8) -> bool {
        return self.is_ident_start(c) || self.is_digit(c);
    }

    // Parse one identifier token used in datatype names.
    pub unsafe fn parse_type_ident(&mut self) -> bool {
        self.skip();
        if self.at_end() { return false; }
        let c0: u8 = self.peek();
        if !self.is_ident_start(c0) { return false; }
        self.pos = self.pos + 1;
        while !self.at_end() {
            let c: u8 = self.peek();
            if !self.is_ident_char(c) { break; }
            self.pos = self.pos + 1;
        }
        return true;
    }

    // Parse integer literal for non-type generic args (e.g. Vec<16>).
    pub unsafe fn parse_type_int_lit(&mut self) -> bool {
        self.skip();
        if self.at_end() { return false; }

        // Optional leading '-'
        if self.peek() == 45 {  // '-'
            self.pos = self.pos + 1;
            if self.at_end() || !self.is_digit(self.peek()) {
                return false;
            }
        }

        // Hex integer: 0x[0-9a-fA-F]+
        if self.peek() == 48 && (self.peek_at(1) == 120 || self.peek_at(1) == 88) {
            self.pos = self.pos + 2;  // 0x / 0X
            let mut n_hex: i64 = 0;
            while !self.at_end() {
                let c: u8 = self.peek();
                let is_hex: bool =
                    (c >= 48 && c <= 57)   // 0-9
                    || (c >= 97 && c <= 102)  // a-f
                    || (c >= 65 && c <= 70);  // A-F
                if is_hex == false { break; }
                self.pos = self.pos + 1;
                n_hex = n_hex + 1;
            }
            return n_hex > 0;
        }

        // Decimal integer: [0-9]+
        let mut n_dec: i64 = 0;
        while !self.at_end() && self.is_digit(self.peek()) {
            self.pos = self.pos + 1;
            n_dec = n_dec + 1;
        }
        return n_dec > 0;
    }

    // Parse one type argument in a generic argument list:
    // either a datatype expression or an integer literal.
    pub unsafe fn parse_type_arg(&mut self) -> bool {
        self.skip();
        if self.at_end() { return false; }
        let c: u8 = self.peek();
        if self.is_ident_start(c) {
            return self.parse_datatype_expr();
        }
        if self.is_digit(c) || (c == 45 && self.is_digit(self.peek_at(1))) {
            return self.parse_type_int_lit();
        }
        return false;
    }

    // Parse one datatype expression:
    //   Ident
    //   Ident<Arg, Arg, ...>
    // where Arg := Datatype | IntegerLiteral
    pub unsafe fn parse_datatype_expr(&mut self) -> bool {
        if self.parse_type_ident() == false { return false; }
        self.skip();
        if self.at_end() || self.peek() != 60 {  // '<'
            return true;
        }
        self.pos = self.pos + 1;

        let mut expect_arg: bool = true;
        while true {
            self.skip();
            if self.at_end() { return false; }
            let ch: u8 = self.peek();
            if expect_arg == true {
                if ch == 62 {       // '>'
                    return false;         // empty arg list or trailing comma
                }
                if self.parse_type_arg() == false { return false; }
                expect_arg = false;
            } else {
                if ch == 44 {       // ','
                    self.pos = self.pos + 1;
                    expect_arg = true;
                } else if ch == 62 { // '>'
                    self.pos = self.pos + 1;
                    return true;
                } else {
                    return false;
                }
            }
        }
        return false;
    }

    pub unsafe fn is_ws(&mut self, c: u8) -> bool {
        return c == 32 || c == 9 || c == 10 || c == 13;
    }

    pub unsafe fn type_expr_is_i32(&mut self, start: i64, end: i64) -> bool {
        let mut ts: i64 = start;
        let mut te: i64 = end;
        while ts < te && self.is_ws(*((self.text.as_ptr() as i64 + ts) as *const u8)) {
            ts = ts + 1;
        }
        while te > ts && self.is_ws(*((self.text.as_ptr() as i64 + te - 1) as *const u8)) {
            te = te - 1;
        }
        if te - ts != 3 { return false; }
        let c0: u8 = *((self.text.as_ptr() as i64 + ts + 0) as *const u8);
        let c1: u8 = *((self.text.as_ptr() as i64 + ts + 1) as *const u8);
        let c2: u8 = *((self.text.as_ptr() as i64 + ts + 2) as *const u8);
        return (c0 == 105 || c0 == 73)  // i / I
            && c1 == 51 && c2 == 50;    // 3 2
    }

    pub unsafe fn ident_eq_span(&mut self, start: i64, end: i64, lit: str) -> bool {
        let n: i64 = lit.len();
        if end - start != n { return false; }
        let lp: *const u8 = lit.as_ptr();
        let mut i: i64 = 0;
        while i < n {
            let a: u8 = *((self.text.as_ptr() as i64 + start + i) as *const u8);
            let b: u8 = *((lp as i64 + i) as *const u8);
            if a != b { return false; }
            i = i + 1;
        }
        return true;
    }

    pub unsafe fn atom_unknown(&mut self) -> u8 { return 0; }
    pub unsafe fn atom_i32(&mut self) -> u8 { return 1; }
    pub unsafe fn atom_varchar(&mut self) -> u8 { return 2; }
    pub unsafe fn atom_anyval(&mut self) -> u8 { return 3; }

    pub unsafe fn mat_unknown(&mut self) -> u8 { return 0; }
    pub unsafe fn mat_default_map(&mut self) -> u8 { return 1; }
    pub unsafe fn mat_i32_anyval_map(&mut self) -> u8 { return 2; }
    pub unsafe fn mat_i32_array(&mut self) -> u8 { return 3; }

    // Typed-container materialization registry.
    // Add new pre-materializations by appending rules here, not in parser flow.
    pub unsafe fn resolve_array_materialization(&mut self, argc: i64, elem_atom: u8) -> u8 {
        // Rule: <I32>[...] -> dense Array<i32>
        if argc == 1 && elem_atom == self.atom_i32() {
            return self.mat_i32_array();
        }
        return self.mat_unknown();
    }

    pub unsafe fn resolve_map_materialization(&mut self, argc: i64, key_atom: u8, val_atom: u8) -> u8 {
        // Rule: <Varchar>{...} -> Map<Varchar,AnyVal>
        if argc == 1 && key_atom == self.atom_varchar() {
            return self.mat_default_map();
        }
        // Rule: <I32>{...} -> Map<I32,AnyVal>
        if argc == 1 && key_atom == self.atom_i32() {
            return self.mat_i32_anyval_map();
        }
        // Rule: <Varchar,AnyVal>{...}
        if argc == 2 && key_atom == self.atom_varchar() && val_atom == self.atom_anyval() {
            return self.mat_default_map();
        }
        // Rule: <I32,AnyVal>{...}
        if argc == 2 && key_atom == self.atom_i32() && val_atom == self.atom_anyval() {
            return self.mat_i32_anyval_map();
        }
        return self.mat_unknown();
    }

    pub unsafe fn infer_map_value_atom(&mut self, mat: u8, current: u8) -> u8 {
        if current != self.atom_unknown() { return current; }
        if mat == self.mat_default_map() || mat == self.mat_i32_anyval_map() {
            return self.atom_anyval();
        }
        return current;
    }

    pub unsafe fn parse_type_atom(&mut self, start: i64, end: i64) -> u8 {
        let mut ts: i64 = start;
        let mut te: i64 = end;
        while ts < te && self.is_ws(*((self.text.as_ptr() as i64 + ts) as *const u8)) {
            ts = ts + 1;
        }
        while te > ts && self.is_ws(*((self.text.as_ptr() as i64 + te - 1) as *const u8)) {
            te = te - 1;
        }
        if ts >= te { return self.atom_unknown(); }
        if !self.is_ident_start(*((self.text.as_ptr() as i64 + ts) as *const u8)) {
            return self.atom_unknown();
        }
        let mut i: i64 = ts + 1;
        while i < te && self.is_ident_char(*((self.text.as_ptr() as i64 + i) as *const u8)) {
            i = i + 1;
        }
        while i < te && self.is_ws(*((self.text.as_ptr() as i64 + i) as *const u8)) {
            i = i + 1;
        }
        if i != te { return self.atom_unknown(); }

        if self.type_expr_is_i32(ts, te) { return self.atom_i32(); }
        if self.ident_eq_span(ts, te, "Varchar") { return self.atom_varchar(); }
        if self.ident_eq_span(ts, te, "AnyVal") { return self.atom_anyval(); }
        return self.atom_unknown();
    }

    pub unsafe fn alloc_string_span(&mut self, start: i64, end: i64) -> u32 {
        let mut s: i64 = start;
        let mut e: i64 = end;
        while s < e && self.is_ws(*((self.text.as_ptr() as i64 + s) as *const u8)) {
            s = s + 1;
        }
        while e > s && self.is_ws(*((self.text.as_ptr() as i64 + e - 1) as *const u8)) {
            e = e - 1;
        }
        if e < s { return 0; }
        let n: i64 = e - s;
        let pfx: i64 = vlen_encode_size(n as u64) as i64;
        let raw: *mut u8 = zone_m_alloc_tagged(self.zone, pfx + n,
                               hermes_tag_string());
        if raw == 0 as *mut u8 { return 0; }
        vlen_write(raw, n as u64);
        let body: *mut u8 = (raw as i64 + pfx) as *mut u8;
        let mut i: i64 = 0;
        while i < n {
            let sp: *const u8 = (self.text.as_ptr() as i64 + s + i) as *const u8;
            let dp: *mut u8 = (body as i64 + i) as *mut u8;
            *dp = *sp;
            i = i + 1;
        }
        return (raw as i64 - self.base as i64) as u32;
    }

    // Parse optional associated const-data list after a type expression:
    //   Type            -> null_ptr
    //   Type(a,b,c)     -> Array<AnyVal>[a,b,c]
    pub unsafe fn parse_optional_type_assoc_params(&mut self) -> AnyVal {
        self.skip();
        if self.peek() != 40 {  // '('
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 1;

        self.skip();
        if self.peek() == 41 {  // ')'
            self.pos = self.pos + 1;
            return AnyVal::null_ptr();  // canonical: no subtype data
        }

        let cap: u64 = 32;
        let oa_sz: i64 = sizeof::<ObjectArray>() as i64;
        let oa_raw: *mut u8 = zone_m_alloc_tagged(self.zone, oa_sz,
                                  hermes_tag_array());
        let oa_buf: *mut u8 = zone_m_alloc_raw(self.zone, cap as i64 * 4);
        if oa_raw == 0 as *mut u8 || oa_buf == 0 as *mut u8 {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let arr: *mut ObjectArray = ObjectArray::init(oa_raw, oa_buf, self.base, cap);

        let mut going: bool = true;
        while going == true {
            let v: AnyVal = self.parse_value();
            if self.ok == false { return AnyVal::null_ptr(); }
            if arr.size >= arr.capacity {
                self.ok = false;
                return AnyVal::null_ptr();
            }
            arr.push(self.zone.holder, v);
            self.base = self.zone.holder.base;
            self.skip();
            if self.peek() == 41 {       // ')'
                self.pos = self.pos + 1;
                going = false;
            } else if self.peek() == 44 { // ','
                self.pos = self.pos + 1;
                self.skip();
                if self.peek() == 41 {    // trailing comma is invalid
                    self.ok = false;
                    return AnyVal::null_ptr();
                }
            } else {
                self.ok = false;
                return AnyVal::null_ptr();
            }
        }

        let off: u32 = (oa_raw as i64 - self.base as i64) as u32;
        return AnyVal::from_offset(off);
    }

    pub unsafe fn make_typed_value(&mut self, type_off: u32, params: AnyVal, initv: AnyVal) -> AnyVal {
        let tv_sz: i64 = sizeof::<TypedValue>() as i64;
        let tv_raw: *mut u8 = zone_m_alloc_tagged(self.zone, tv_sz,
                                  hermes_tag_typed_value());
        if tv_raw == 0 as *mut u8 {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        TypedValue::init(tv_raw, type_off, params, initv);
        let off: u32 = (tv_raw as i64 - self.base as i64) as u32;
        return AnyVal::from_offset(off);
    }

    pub unsafe fn type_name_eq(&mut self, type_off: u32, lit: str) -> bool {
        if type_off == 0 { return false; }
        let hs: *const HermesString =
            (self.base as i64 + type_off as i64) as *const HermesString;
        let n: i64 = lit.len();
        if hs.len() as i64 != n { return false; }
        let b: *const u8 = hs.bytes();
        let lp: *const u8 = lit.as_ptr();
        let mut i: i64 = 0;
        while i < n {
            let c0: u8 = *((b as i64 + i) as *const u8);
            let c1: u8 = *((lp as i64 + i) as *const u8);
            if c0 != c1 { return false; }
            i = i + 1;
        }
        return true;
    }

    // Validate Decimal(P,S) typed value.
    // Rules:
    //   - params required and must be exactly two integer-like values
    //   - P > 0
    //   - S >= 0
    //   - S <= P
    //   - P <= 1143 (current Decimal limb encoding budget: 127*9)
    //   - initializer must be string (for from_string pipeline)
    pub unsafe fn validate_decimal_typed_value(&mut self, params: AnyVal, initv: AnyVal) -> bool {
        if !initv.is_string(self.base) {
            self.ok = false;
            return false;
        }
        if params.is_null() || !params.is_ptr() {
            self.ok = false;
            return false;
        }
        let pobj: *const u8 = (self.base as i64 + params.as_offset() as i64) as *const u8;
        if read_type_code(pobj) != hermes_tag_array() {
            self.ok = false;
            return false;
        }
        let arr: *const ObjectArray = pobj as *const ObjectArray;
        if arr.size != 2 {
            self.ok = false;
            return false;
        }
        let p_raw: AnyVal = arr.get(self.base, 0);
        let s_raw: AnyVal = arr.get(self.base, 1);
        let p: i32 = self.anyval_to_i32(p_raw);
        if self.ok == false { return false; }
        let s: i32 = self.anyval_to_i32(s_raw);
        if self.ok == false { return false; }
        if p <= 0 { self.ok = false; return false; }
        if s < 0 { self.ok = false; return false; }
        if s > p { self.ok = false; return false; }
        if p > 1143 { self.ok = false; return false; }
        return true;
    }

    pub unsafe fn validate_typed_value(&mut self, type_off: u32, params: AnyVal, initv: AnyVal) -> bool {
        // Decimal is currently string-initialized only.
        if self.type_name_eq(type_off, "Decimal") {
            return self.validate_decimal_typed_value(params, initv);
        }
        return true;
    }

    // Decimal typed-value materialization path:
    //   @Decimal(P,S)="..."
    //   "..."@Decimal(P,S)
    // Returns null_ptr when no special materialization applies.
    pub unsafe fn try_materialize_typed_value(&mut self, type_off: u32,
                                              params: AnyVal, initv: AnyVal) -> AnyVal {
        if !self.type_name_eq(type_off, "Decimal") {
            return AnyVal::null_ptr();
        }

        let pobj: *const u8 = (self.base as i64 + params.as_offset() as i64) as *const u8;
        let arr: *const ObjectArray = pobj as *const ObjectArray;
        let p_raw: AnyVal = arr.get(self.base, 0);
        let s_raw: AnyVal = arr.get(self.base, 1);
        let p: i32 = self.anyval_to_i32(p_raw);
        if self.ok == false { return AnyVal::null_ptr(); }
        let s: i32 = self.anyval_to_i32(s_raw);
        if self.ok == false { return AnyVal::null_ptr(); }

        let hs: *const HermesString = (self.base as i64 + initv.as_offset() as i64) as *const HermesString;
        let dv: AnyVal = decimal_from_string_in_zone(self.zone, p, s, hs.bytes(), hs.len() as i64);
        if dv.is_null() {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        return dv;
    }

    // Prefix form: @Type(params?) = initializer
    pub unsafe fn parse_typed_value_prefix(&mut self) -> AnyVal {
        if self.peek() != 64 {  // '@'
            self.ok = false;
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 1;
        self.skip();
        let t0: i64 = self.pos;
        if self.parse_datatype_expr() == false {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let t1: i64 = self.pos;
        let type_off: u32 = self.alloc_string_span(t0, t1);
        if type_off == 0 {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let params: AnyVal = self.parse_optional_type_assoc_params();
        if self.ok == false { return AnyVal::null_ptr(); }
        self.skip();
        if self.peek() != 61 {   // '='
            self.ok = false;
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 1;
        let initv: AnyVal = self.parse_value();
        if self.ok == false { return AnyVal::null_ptr(); }
        if !self.validate_typed_value(type_off, params, initv) {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let mat: AnyVal = self.try_materialize_typed_value(type_off, params, initv);
        if self.ok == false { return AnyVal::null_ptr(); }
        if !mat.is_null() { return mat; }
        return self.make_typed_value(type_off, params, initv);
    }

    // Postfix short form for string-initialized datatypes:
    //   "..." @Type(params?)
    pub unsafe fn parse_typed_value_postfix(&mut self, initv: AnyVal) -> AnyVal {
        self.skip();
        if self.peek() != 64 { return initv; }  // no postfix
        self.pos = self.pos + 1;
        self.skip();
        let t0: i64 = self.pos;
        if self.parse_datatype_expr() == false {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let t1: i64 = self.pos;
        let type_off: u32 = self.alloc_string_span(t0, t1);
        if type_off == 0 {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let params: AnyVal = self.parse_optional_type_assoc_params();
        if self.ok == false { return AnyVal::null_ptr(); }
        if !self.validate_typed_value(type_off, params, initv) {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let mat: AnyVal = self.try_materialize_typed_value(type_off, params, initv);
        if self.ok == false { return AnyVal::null_ptr(); }
        if !mat.is_null() { return mat; }
        return self.make_typed_value(type_off, params, initv);
    }

    // Parse `<...>` and resolve pre-materialization policy.
    // On success returns a fully resolved spec with the next container token
    // (`[` or `{`) still unconsumed for payload parser.
    pub unsafe fn parse_typed_container_spec(&mut self) -> TypedContainerSpec {
        if self.peek() != 60 {  // '<'
            return TypedContainerSpec::invalid();
        }
        self.pos = self.pos + 1;

        let mut count: i64 = 0;
        let mut a0s: i64 = 0;
        let mut a0e: i64 = 0;
        let mut a1s: i64 = 0;
        let mut a1e: i64 = 0;

        while true {
            self.skip();
            if self.at_end() { return TypedContainerSpec::invalid(); }
            if self.peek() == 62 { return TypedContainerSpec::invalid(); } // empty header

            let arg_start: i64 = self.pos;
            if self.parse_datatype_expr() == false { return TypedContainerSpec::invalid(); }
            let arg_end: i64 = self.pos;
            count = count + 1;
            if count == 1 { a0s = arg_start; a0e = arg_end; }
            if count == 2 { a1s = arg_start; a1e = arg_end; }

            self.skip();
            if self.at_end() { return TypedContainerSpec::invalid(); }
            let ch: u8 = self.peek();
            if ch == 44 {  // ','
                self.pos = self.pos + 1;
            } else if ch == 62 {  // '>'
                self.pos = self.pos + 1;
                break;
            } else {
                return TypedContainerSpec::invalid();
            }
        }

        self.skip();
        if self.at_end() { return TypedContainerSpec::invalid(); }
        let next: u8 = self.peek();
        if next != 91 && next != 123 {  // '[' / '{'
            return TypedContainerSpec::invalid();
        }

        let key_atom: u8 = self.parse_type_atom(a0s, a0e);
        let mut val_atom: u8 = if count >= 2 { self.parse_type_atom(a1s, a1e) } else { self.atom_unknown() };
        let mat: u8 = if next == 91 {
            self.resolve_array_materialization(count, key_atom)
        } else {
            self.resolve_map_materialization(count, key_atom, val_atom)
        };
        if mat == self.mat_unknown() { return TypedContainerSpec::invalid(); }
        val_atom = self.infer_map_value_atom(mat, val_atom);

        return TypedContainerSpec {
            ok: true,
            next: next,
            arg_count: count,
            a0_start: a0s,
            a0_end: a0e,
            a1_start: a1s,
            a1_end: a1e,
            key_atom: key_atom,
            val_atom: val_atom,
            mat: mat,
        };
    }

    pub unsafe fn anyval_to_i32(&mut self, v: AnyVal) -> i32 {
        let mut n: i64 = 0;
        if v.is_ptr() {
            if v.is_null() {
                self.ok = false;
                return 0;
            }
            let obj: *const u8 = (self.base as i64 + v.as_offset() as i64) as *const u8;
            let th: u64 = read_type_code(obj);
            if th == hermes_tag_i64() {
                let p: *const I64 = obj as *const I64;
                n = p.v;
            } else if th == hermes_tag_u64() {
                let p: *const U64 = obj as *const U64;
                if p.v > 2147483647 {
                    self.ok = false;
                    return 0;
                }
                n = p.v as i64;
            } else {
                self.ok = false;
                return 0;
            }
        } else if v.is_int() {
            n = v.as_i24() as i64;
        } else if v.is_uint() {
            n = v.as_u24() as i64;
        } else {
            self.ok = false;
            return 0;
        }
        if n < -2147483648 || n > 2147483647 {
            self.ok = false;
            return 0;
        }
        return n as i32;
    }

    pub unsafe fn alloc_i64_anyval(&mut self, v: i64) -> AnyVal {
        let sz: i64 = sizeof::<I64>() as i64;
        let raw: *mut u8 = zone_m_alloc_tagged(self.zone, sz,
                               hermes_tag_i64());
        if raw == 0 as *mut u8 {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        I64::init(raw, v);
        let off: u32 = (raw as i64 - self.base as i64) as u32;
        return AnyVal::from_offset(off);
    }

    pub unsafe fn alloc_u64_anyval(&mut self, v: u64) -> AnyVal {
        let sz: i64 = sizeof::<U64>() as i64;
        let raw: *mut u8 = zone_m_alloc_tagged(self.zone, sz,
                               hermes_tag_u64());
        if raw == 0 as *mut u8 {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        U64::init(raw, v);
        let off: u32 = (raw as i64 - self.base as i64) as u32;
        return AnyVal::from_offset(off);
    }

    pub unsafe fn parse_typed_array_i32(&mut self) -> AnyVal {
        if self.peek() != 91 {  // '['
            self.ok = false;
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 1;

        let cap: u64 = 64;
        let arr_sz: i64 = sizeof::<Array<i32>>() as i64;
        let arr_raw: *mut u8 = zone_m_alloc_tagged(self.zone, arr_sz,
                                  hermes_tag_array_i32());
        let buf_raw: *mut u8 = zone_m_alloc_raw(self.zone, cap as i64 * 4);
        if arr_raw == 0 as *mut u8 || buf_raw == 0 as *mut u8 {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let arr: *mut Array<i32> = arr_raw as *mut Array<i32>;
        arr.size     = 0;
        arr.capacity = cap;
        arr.data.offset = (buf_raw as i64 - self.base as i64) as u32;

        self.skip();
        if self.peek() == 93 {  // ']'
            self.pos = self.pos + 1;
            let off0: u32 = (arr_raw as i64 - self.base as i64) as u32;
            return AnyVal::from_offset(off0);
        }

        let mut going: bool = true;
        while going == true {
            let elem: AnyVal = self.parse_value();
            if self.ok == false { return AnyVal::null_ptr(); }
            let n32: i32 = self.anyval_to_i32(elem);
            if self.ok == false { return AnyVal::null_ptr(); }

            if arr.size >= arr.capacity {
                self.ok = false;
                return AnyVal::null_ptr();
            }
            let ep: *mut i32 =
                (self.base as i64 + arr.data.offset + (arr.size as i64) * 4) as *mut i32;
            *ep = n32;
            arr.size = arr.size + 1;

            self.skip();
            if self.peek() == 93 {        // ']'
                self.pos = self.pos + 1;
                going = false;
            } else if self.peek() == 44 { // ','
                self.pos = self.pos + 1;
                self.skip();
                if self.peek() == 93 {    // trailing comma
                    self.pos = self.pos + 1;
                    going = false;
                }
            } else {
                self.ok = false;
                return AnyVal::null_ptr();
            }
        }

        let off: u32 = (arr_raw as i64 - self.base as i64) as u32;
        return AnyVal::from_offset(off);
    }

    pub unsafe fn parse_typed_map_i32_anyval(&mut self) -> AnyVal {
        if self.peek() != 123 {  // '{'
            self.ok = false;
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 1;

        let cap: u32 = 64;
        let map_sz: i64 = sizeof::<Map<i32, AnyVal>>() as i64;
        let map_raw: *mut u8 = zone_m_alloc_tagged(self.zone, map_sz,
                                   hermes_tag_map_i32_anyval());
        let keys_raw: *mut u8 = zone_m_alloc_raw(self.zone, cap as i64 * 4);
        let vals_raw: *mut u8 = zone_m_alloc_raw(self.zone, cap as i64 * 4);
        if map_raw == 0 as *mut u8 || keys_raw == 0 as *mut u8 || vals_raw == 0 as *mut u8 {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let m: *mut Map<i32, AnyVal> = Map::<i32, AnyVal>::init(map_raw, keys_raw, vals_raw, self.base, cap);

        self.skip();
        if self.peek() == 125 {  // '}'
            self.pos = self.pos + 1;
            let off0: u32 = (map_raw as i64 - self.base as i64) as u32;
            return AnyVal::from_offset(off0);
        }

        let mut going: bool = true;
        while going == true {
            self.skip();

            if !(self.is_digit(self.peek()) || self.peek() == 45) {
                self.ok = false;
                return AnyVal::null_ptr();
            }
            let key_val: AnyVal = self.parse_number();
            if self.ok == false { return AnyVal::null_ptr(); }
            let key_i32: i32 = self.anyval_to_i32(key_val);
            if self.ok == false { return AnyVal::null_ptr(); }

            self.skip();
            if self.peek() != 58 {  // ':'
                self.ok = false;
                return AnyVal::null_ptr();
            }
            self.pos = self.pos + 1;

            let val: AnyVal = self.parse_value();
            if self.ok == false { return AnyVal::null_ptr(); }

            m.set(self.base, key_i32, val);

            self.skip();
            if self.peek() == 125 {       // '}'
                self.pos = self.pos + 1;
                going = false;
            } else if self.peek() == 44 { // ','
                self.pos = self.pos + 1;
                self.skip();
                if self.peek() == 125 {   // trailing comma
                    self.pos = self.pos + 1;
                    going = false;
                }
            } else {
                self.ok = false;
                return AnyVal::null_ptr();
            }
        }

        let off: u32 = (map_raw as i64 - self.base as i64) as u32;
        return AnyVal::from_offset(off);
    }

    // ── Value dispatch ────────────────────────────────────────────────────────

    pub unsafe fn parse_value(&mut self) -> AnyVal {
        self.skip();
        if self.ok == false || self.at_end() {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let c: u8 = self.peek();

        if c == 110 { return self.parse_null(); }     // 'n'
        if c == 116 { return self.parse_true_kw(); }  // 't'
        if c == 102 { return self.parse_false_kw(); } // 'f'
        if c == 34  {
            let s: AnyVal = self.parse_string();            // '"'
            if self.ok == false { return AnyVal::null_ptr(); }
            return self.parse_typed_value_postfix(s);
        }
        if c == 91  { return self.parse_array(); }    // '['
        if c == 123 { return self.parse_map(); }      // '{'
        if c == 60  { return self.parse_typed_container(); }  // '<'
        if c == 64  { return self.parse_typed_value_prefix(); }  // '@'
        if c == 36  { return self.parse_param_val(); }          // '$'

        // Number: digit or '-' followed by digit
        if self.is_digit(c)
        || (c == 45 && self.is_digit(self.peek_at(1))) {
            return self.parse_number();
        }

        self.ok = false;
        return AnyVal::null_ptr();
    }

    // ── $N — positional PARAM placeholder ────────────────────────────────────
    // Syntax: '$' followed immediately by a non-negative decimal integer.
    // Produces AnyVal::embed_param(N).  Used in document templates.

    pub unsafe fn parse_param_val(&mut self) -> AnyVal {
        if self.peek() != 36 {  // '$'
            self.ok = false;
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 1;

        if self.at_end() || !self.is_digit(self.peek()) {
            self.ok = false;
            return AnyVal::null_ptr();
        }

        let mut idx: u32 = 0;
        while !self.at_end() && self.is_digit(self.peek()) {
            let d: u32 = (self.peek() - 48) as u32;
            if idx > (16777215 - d) / 10 {
                self.ok = false;
                return AnyVal::null_ptr();
            }
            idx = idx * 10 + d;
            self.pos = self.pos + 1;
        }

        // Must not be followed by an identifier character
        if !self.at_end() && self.is_ident_char(self.peek()) {
            self.ok = false;
            return AnyVal::null_ptr();
        }

        return AnyVal::embed_param(idx);
    }

    // ── Typed container: `<T>[...]` or `<K, V>{...}` ────────────────────────
    // Header is parsed into TypedContainerSpec, then dispatched by selected
    // pre-materialization policy.
    pub unsafe fn parse_typed_container(&mut self) -> AnyVal {
        let spec: TypedContainerSpec = self.parse_typed_container_spec();
        if spec.ok == false {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        if spec.mat == self.mat_i32_array() { return self.parse_typed_array_i32(); }
        if spec.mat == self.mat_default_map() { return self.parse_map(); }
        if spec.mat == self.mat_i32_anyval_map() { return self.parse_typed_map_i32_anyval(); }
        self.ok = false;
        return AnyVal::null_ptr();
    }

    // ── null ─────────────────────────────────────────────────────────────────

    pub unsafe fn parse_null(&mut self) -> AnyVal {
        // n=110 u=117 l=108 l=108
        if self.peek_at(0) != 110 || self.peek_at(1) != 117
        || self.peek_at(2) != 108 || self.peek_at(3) != 108
        || self.is_ident_char(self.peek_at(4)) {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 4;
        return AnyVal::null_ptr();
    }

    // ── true / false ─────────────────────────────────────────────────────────

    pub unsafe fn parse_true_kw(&mut self) -> AnyVal {
        // t=116 r=114 u=117 e=101
        if self.peek_at(0) != 116 || self.peek_at(1) != 114
        || self.peek_at(2) != 117 || self.peek_at(3) != 101
        || self.is_ident_char(self.peek_at(4)) {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 4;
        return AnyVal::embed_bool(true);
    }

    pub unsafe fn parse_false_kw(&mut self) -> AnyVal {
        // f=102 a=97 l=108 s=115 e=101
        if self.peek_at(0) != 102 || self.peek_at(1) != 97
        || self.peek_at(2) != 108 || self.peek_at(3) != 115
        || self.peek_at(4) != 101
        || self.is_ident_char(self.peek_at(5)) {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 5;
        return AnyVal::embed_bool(false);
    }

    // ── Number ────────────────────────────────────────────────────────────────
    // Supports: optional '-', optional '0x'/'0X' prefix, suffix.
    // Also handles floating-point: digits '.' digits (exponent)?
    //   e.g. 3.14, 1.5e10, 2.0E-3, -0.5

    pub unsafe fn parse_number(&mut self) -> AnyVal {
        let mut neg: bool = false;
        if self.peek() == 45 {  // '-'
            neg = true;
            self.pos = self.pos + 1;
        }

        // Hex prefix 0x / 0X
        let mut hex: bool = false;
        if self.peek() == 48
        && (self.peek_at(1) == 120 || self.peek_at(1) == 88) {
            hex = true;
            self.pos = self.pos + 2;
        }

        // Accumulate unsigned magnitude
        let mut uval: u64 = 0;
        let digits_start: i64 = self.pos;
        let mut going: bool = true;
        while going == true && !self.at_end() {
            let c: u8 = self.peek();
            if c >= 48 && c <= 57 {
                let base: u64 = if hex { 16 } else { 10 };
                let digit: u64 = (c - 48) as u64;
                if uval > (18446744073709551615 - digit) / base {
                    self.ok = false;
                    return AnyVal::null_ptr();
                }
                uval = uval * base + digit;
                self.pos = self.pos + 1;
            } else if hex && c >= 97 && c <= 102 {
                // a-f
                let digit: u64 = (c - 97 + 10) as u64;
                if uval > (18446744073709551615 - digit) / 16 {
                    self.ok = false;
                    return AnyVal::null_ptr();
                }
                uval = uval * 16 + digit;
                self.pos = self.pos + 1;
            } else if hex && c >= 65 && c <= 70 {
                // A-F
                let digit: u64 = (c - 65 + 10) as u64;
                if uval > (18446744073709551615 - digit) / 16 {
                    self.ok = false;
                    return AnyVal::null_ptr();
                }
                uval = uval * 16 + digit;
                self.pos = self.pos + 1;
            } else {
                going = false;
            }
        }

        if self.pos == digits_start {
            self.ok = false;
            return AnyVal::null_ptr();
        }

        // Detect float: '.' followed by a digit (not hex, not a suffix like ull)
        if hex == false && self.peek() == 46 && self.is_digit(self.peek_at(1)) {
            return self.parse_float_tail(uval, neg);
        }

        return self.apply_int_suffix(uval, neg);
    }

    // ── Float tail ────────────────────────────────────────────────────────────
    // f32 embedding is dropped in the 4-byte AnyVal format.
    // This function consumes the float literal from the input stream (to avoid
    // parse errors) but always returns null_ptr(). Float support will be
    // re-added when zone-pointer floats are implemented.
    pub unsafe fn parse_float_tail(&mut self, uval: u64, neg: bool) -> AnyVal {
        // Consume '.'
        self.pos = self.pos + 1;

        // Read fractional digits
        while !self.at_end() && self.is_digit(self.peek()) {
            self.pos = self.pos + 1;
        }

        // Optional exponent: e or E, optional sign, digits
        if !self.at_end()
        && (self.peek() == 101 || self.peek() == 69) {  // 'e' or 'E'
            self.pos = self.pos + 1;
            if !self.at_end() && (self.peek() == 45 || self.peek() == 43) {
                self.pos = self.pos + 1;
            }
            // Must have at least one exponent digit
            if self.at_end() || !self.is_digit(self.peek()) {
                self.ok = false;
                return AnyVal::null_ptr();
            }
            while !self.at_end() && self.is_digit(self.peek()) {
                self.pos = self.pos + 1;
            }
        }

        // f32 embedding is not supported in the 4-byte AnyVal format.
        let _u: u64 = uval;
        let _n: bool = neg;
        return AnyVal::null_ptr();
    }

    // Match and consume a suffix, return AnyVal with appropriate type.
    // Suffixes are checked longest-first to avoid partial matches.
    pub unsafe fn apply_int_suffix(&mut self, uval: u64, neg: bool) -> AnyVal {
        let c0: u8 = self.peek();
        let c1: u8 = self.peek_at(1);
        let c2: u8 = self.peek_at(2);
        let c3: u8 = self.peek_at(3);
        let c4: u8 = self.peek_at(4);

        // '_' prefix suffixes
        if c0 == 95 {
            // _u64  (_=95 u=117 6=54 4=52)
            if c1 == 117 && c2 == 54 && c3 == 52
            && !self.is_ident_char(c4) {
                self.pos = self.pos + 4;
                // u64 not embeddable — store as u24 (lower 24 bits)
                return AnyVal::embed_u24(uval as u32);
            }
            // _u32  (_=95 u=117 3=51 2=50)
            if c1 == 117 && c2 == 51 && c3 == 50
            && !self.is_ident_char(c4) {
                self.pos = self.pos + 4;
                return AnyVal::embed_u24(uval as u32);
            }
            // _u16  (_=95 u=117 1=49 6=54)
            if c1 == 117 && c2 == 49 && c3 == 54
            && !self.is_ident_char(c4) {
                self.pos = self.pos + 4;
                return AnyVal::embed_u16(uval as u16);
            }
            // _u8   (_=95 u=117 8=56)
            if c1 == 117 && c2 == 56
            && !self.is_ident_char(c3) {
                self.pos = self.pos + 3;
                return AnyVal::embed_u8(uval as u8);
            }
            // _s64  (_=95 s=115 6=54 4=52)
            if c1 == 115 && c2 == 54 && c3 == 52
            && !self.is_ident_char(c4) {
                self.pos = self.pos + 4;
                // s64 not embeddable — store as i24 (lower 24 bits).
                let mut v: i32 = uval as i32;
                if neg { v = 0 - v; }
                return AnyVal::embed_i24(v);
            }
            // _s32  (_=95 s=115 3=51 2=50)
            if c1 == 115 && c2 == 51 && c3 == 50
            && !self.is_ident_char(c4) {
                self.pos = self.pos + 4;
                let mut v: i32 = uval as i32;
                if neg { v = 0 - v; }
                return AnyVal::embed_i24(v);
            }
            // _s16  (_=95 s=115 1=49 6=54)
            if c1 == 115 && c2 == 49 && c3 == 54
            && !self.is_ident_char(c4) {
                self.pos = self.pos + 4;
                let mut v: i16 = uval as i16;
                if neg { v = 0 - v; }
                return AnyVal::embed_i16(v);
            }
            // _s8   (_=95 s=115 8=56)
            if c1 == 115 && c2 == 56
            && !self.is_ident_char(c3) {
                self.pos = self.pos + 3;
                let mut v: i8 = uval as i8;
                if neg { v = 0 - v; }
                return AnyVal::embed_i8(v);
            }
        }

        // Default (no suffix):
        // - keep i24 inline when it fits
        // - otherwise allocate i64/u64 object instead of truncating to 24 bits
        if neg {
            if uval <= 8388608 {
                let mut v: i32 = uval as i32;
                v = 0 - v;
                return AnyVal::embed_i24(v);
            }
            if uval > 9223372036854775808 {
                self.ok = false;
                return AnyVal::null_ptr();
            }
            if uval == 9223372036854775808 {
                return self.alloc_i64_anyval(-9223372036854775807 - 1);
            }
            let iv: i64 = 0 - uval as i64;
            return self.alloc_i64_anyval(iv);
        }

        if uval <= 8388607 {
            return AnyVal::embed_i24(uval as i32);
        }
        if uval <= 9223372036854775807 {
            return self.alloc_i64_anyval(uval as i64);
        }
        return self.alloc_u64_anyval(uval);
    }

    // ── String ────────────────────────────────────────────────────────────────
    // Double-quoted string with basic escape sequences.
    // Decoded bytes are staged in scratch (max 1023), then written to the zone
    // as an alloc_tagged HermesString (vlen prefix + UTF-8 bytes).

    pub unsafe fn parse_string(&mut self) -> AnyVal {
        if self.peek() != 34 {  // '"'
            self.ok = false;
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 1;

        let mut slen: i64 = 0;
        let mut going: bool = true;
        while going == true && !self.at_end() {
            let c: u8 = self.peek();
            if c == 34 {  // closing '"'
                going = false;
            } else if c == 92 {  // '\'
                self.pos = self.pos + 1;
                if self.at_end() { self.ok = false; return AnyVal::null_ptr(); }
                let esc: u8 = self.advance();
                let mut byte: u8 = 0;
                let mut valid: bool = true;
                if esc == 34  { byte = 34; }   // \" → "
                else if esc == 92  { byte = 92; }   // \\ → \
                else if esc == 47  { byte = 47; }   // \/ → /
                else if esc == 110 { byte = 10; }   // \n → LF
                else if esc == 114 { byte = 13; }   // \r → CR
                else if esc == 116 { byte = 9;  }   // \t → TAB
                else if esc == 98  { byte = 8;  }   // \b → BS
                else if esc == 102 { byte = 12; }   // \f → FF
                else { valid = false; }
                if valid == false { self.ok = false; return AnyVal::null_ptr(); }
                if slen < 1023 {
                    let dst: *mut u8 = (self.scratch as i64 + slen) as *mut u8;
                    *dst = byte;
                }
                slen = slen + 1;
            } else {
                if slen < 1023 {
                    let dst: *mut u8 = (self.scratch as i64 + slen) as *mut u8;
                    *dst = c;
                }
                slen = slen + 1;
                self.pos = self.pos + 1;
            }
        }
        if self.at_end() { self.ok = false; return AnyVal::null_ptr(); }
        self.pos = self.pos + 1;  // consume closing '"'

        if slen > 1023 { self.ok = false; return AnyVal::null_ptr(); }

        // Allocate zone object: tagged HermesString
        let prefix_sz: i64 = vlen_encode_size(slen as u64) as i64;
        let total:     i64 = prefix_sz + slen;
        let raw: *mut u8 = zone_m_alloc_tagged(self.zone, total,
                               hermes_tag_string());
        if raw == 0 as *mut u8 { self.ok = false; return AnyVal::null_ptr(); }

        vlen_write(raw, slen as u64);
        let body: *mut u8 = (raw as i64 + prefix_sz) as *mut u8;
        let mut i: i64 = 0;
        while i < slen {
            let src: *const u8 = (self.scratch as i64 + i) as *const u8;
            let dst: *mut u8   = (body as i64 + i) as *mut u8;
            *dst = *src;
            i = i + 1;
        }

        let off: u32 = (raw as i64 - self.base as i64) as u32;
        return AnyVal::from_offset(off);
    }

    // ── Array ─────────────────────────────────────────────────────────────────
    // Pre-allocates ObjectArray with capacity 64. Elements beyond that are lost.

    pub unsafe fn parse_array(&mut self) -> AnyVal {
        if self.peek() != 91 {  // '['
            self.ok = false;
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 1;

        let cap: u64 = 64;
        let oa_sz:  i64 = sizeof::<ObjectArray>() as i64;
        let oa_raw: *mut u8 = zone_m_alloc_tagged(self.zone, oa_sz,
                                  hermes_tag_array());
        let oa_buf: *mut u8 = zone_m_alloc_raw(self.zone, cap as i64 * 4);
        if oa_raw == 0 as *mut u8 || oa_buf == 0 as *mut u8 {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let arr: *mut ObjectArray = ObjectArray::init(oa_raw, oa_buf, self.base, cap);

        self.skip();
        if self.peek() == 93 {  // ']' empty array
            self.pos = self.pos + 1;
            let off: u32 = (oa_raw as i64 - self.base as i64) as u32;
            return AnyVal::from_offset(off);
        }

        let mut going: bool = true;
        while going == true {
            let elem: AnyVal = self.parse_value();
            if self.ok == false { return AnyVal::null_ptr(); }
            arr.push(self.zone.holder, elem);
            self.base = self.zone.holder.base;

            self.skip();
            if self.peek() == 93 {       // ']'
                self.pos = self.pos + 1;
                going = false;
            } else if self.peek() == 44 { // ','
                self.pos = self.pos + 1;
                self.skip();
                if self.peek() == 93 {   // trailing comma
                    self.pos = self.pos + 1;
                    going = false;
                }
            } else {
                self.ok = false;
                return AnyVal::null_ptr();
            }
        }

        let off: u32 = (oa_raw as i64 - self.base as i64) as u32;
        return AnyVal::from_offset(off);
    }

    // ── Map ───────────────────────────────────────────────────────────────────
    // Keys: bare identifiers or double-quoted strings.
    // Pre-allocates ObjectMap with 64 slots.

    pub unsafe fn parse_map(&mut self) -> AnyVal {
        if self.peek() != 123 {  // '{'
            self.ok = false;
            return AnyVal::null_ptr();
        }
        self.pos = self.pos + 1;

        let cap: u32 = 64;
        let om_sz:  i64 = sizeof::<ObjectMap>() as i64;
        let om_raw: *mut u8 = zone_m_alloc_tagged(self.zone, om_sz,
                                  hermes_tag_map());
        // 64 × 8-byte MapEntry
        let om_ent: *mut u8 = zone_m_alloc_raw(self.zone, cap as i64 * 8);
        if om_raw == 0 as *mut u8 || om_ent == 0 as *mut u8 {
            self.ok = false;
            return AnyVal::null_ptr();
        }
        let omap: *mut ObjectMap = ObjectMap::init(om_raw, self.base, om_ent, cap);

        self.skip();
        if self.peek() == 125 {  // '}' empty map
            self.pos = self.pos + 1;
            let off: u32 = (om_raw as i64 - self.base as i64) as u32;
            return AnyVal::from_offset(off);
        }

        let mut going: bool = true;
        while going == true {
            self.skip();

            // ── key ──────────────────────────────────────────────────────────
            let mut key_off: u32 = 0;
            let mut key_ptr: *const u8 = 0 as *const u8;
            let mut key_len: u64 = 0;

            if self.peek() == 34 {
                // Quoted string key
                let kv: AnyVal = self.parse_string();
                if self.ok == false { return AnyVal::null_ptr(); }
                key_off = kv.as_offset();
                let hs: *const HermesString =
                    (self.base as i64 + key_off as i64) as *const HermesString;
                key_ptr = hs.bytes();
                key_len = hs.len();
            } else if self.is_ident_start(self.peek()) {
                // Bare identifier key — allocate as HermesString in zone
                let id_start: i64 = self.pos;
                while !self.at_end() && self.is_ident_char(self.peek()) {
                    self.pos = self.pos + 1;
                }
                let id_len: i64 = self.pos - id_start;
                let id_src: *const u8 =
                    (self.text.as_ptr() as i64 + id_start) as *const u8;
                let pfx: i64 = vlen_encode_size(id_len as u64) as i64;
                let raw: *mut u8 = zone_m_alloc_tagged(self.zone, pfx + id_len,
                                       hermes_tag_string());
                if raw == 0 as *mut u8 {
                    self.ok = false;
                    return AnyVal::null_ptr();
                }
                vlen_write(raw, id_len as u64);
                let body: *mut u8 = (raw as i64 + pfx) as *mut u8;
                let mut ci: i64 = 0;
                while ci < id_len {
                    let sp: *const u8 = (id_src as i64 + ci) as *const u8;
                    let dp: *mut u8   = (body as i64 + ci) as *mut u8;
                    *dp = *sp;
                    ci = ci + 1;
                }
                key_off = (raw as i64 - self.base as i64) as u32;
                key_ptr = body as *const u8;
                key_len = id_len as u64;
            } else {
                self.ok = false;
                return AnyVal::null_ptr();
            }

            // ── ':' ──────────────────────────────────────────────────────────
            self.skip();
            if self.peek() != 58 {  // ':'
                self.ok = false;
                return AnyVal::null_ptr();
            }
            self.pos = self.pos + 1;

            // ── value ─────────────────────────────────────────────────────────
            let val: AnyVal = self.parse_value();
            if self.ok == false { return AnyVal::null_ptr(); }

            omap.set(self.base, key_off, key_ptr, key_len, val);

            // ── separator / terminator ────────────────────────────────────────
            self.skip();
            if self.peek() == 125 {       // '}'
                self.pos = self.pos + 1;
                going = false;
            } else if self.peek() == 44 { // ','
                self.pos = self.pos + 1;
                self.skip();
                if self.peek() == 125 {   // trailing comma
                    self.pos = self.pos + 1;
                    going = false;
                }
            } else {
                self.ok = false;
                return AnyVal::null_ptr();
            }
        }

        let off: u32 = (om_raw as i64 - self.base as i64) as u32;
        return AnyVal::from_offset(off);
    }
}

// ---------------------------------------------------------------------------
// Public entry point
// ---------------------------------------------------------------------------

// Primary entry point — takes a str (fat pointer, no C-string required).
// Zone offset 0 is reserved for DocumentHeader.
// Returns true on success; zone contains DocumentHeader with root set.
pub unsafe fn hermes_parse(text: str,
                           zone: &mut Zone<Mutable>) -> bool {
    let zone_ptr: *mut Zone<Mutable> = zone as *mut Zone<Mutable>;
    let hdr_raw: *mut u8 = zone_m_alloc_raw(zone_ptr, 8);
    let doc: *mut DocumentHeader = document_create(hdr_raw);

    let mut p: HermesParser = HermesParser::create(text, zone_ptr);

    p.skip();
    if p.at_end() {
        p.ok = false;
        p.destroy();
        return false;
    }
    let root: AnyVal = p.parse_value();
    if p.ok == true { p.skip(); if !p.at_end() { p.ok = false; } }
    if p.ok == true { document_set_root(doc, root); }
    let success: bool = p.ok;
    p.destroy();
    return success;
}

// Overload for callers that already have a (*const u8, len) pair.
pub unsafe fn hermes_parse(text: *const u8, len: i64,
                           zone: &mut Zone<Mutable>) -> bool {
    let zone_ptr: *mut Zone<Mutable> = zone as *mut Zone<Mutable>;
    let hdr_raw: *mut u8 = zone_m_alloc_raw(zone_ptr, 8);
    let doc: *mut DocumentHeader = document_create(hdr_raw);

    let sc: *mut u8 = malloc(1024);
    let mut p: HermesParser = HermesParser {
        text: str_from_raw(text, len),
        pos:  0,
        zone: zone_ptr,
        base: zone_ptr.holder.base,
        scratch: sc,
        ok:   sc != 0 as *mut u8,
    };

    p.skip();
    if p.at_end() {
        p.ok = false;
        p.destroy();
        return false;
    }
    let root: AnyVal = p.parse_value();
    if p.ok == true { p.skip(); if !p.at_end() { p.ok = false; } }
    if p.ok == true { document_set_root(doc, root); }
    let success: bool = p.ok;
    p.destroy();
    return success;
}

