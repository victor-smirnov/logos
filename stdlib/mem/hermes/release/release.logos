// Logos Hermes stdlib — hermes.release
//
// Per-type release hook for Hermes zone objects.
//
// For zone-allocated objects whose storage is owned entirely by the zone,
// `release` is a no-op — destroying the zone frees everything. This trait
// exists so that user-defined Hermes datatypes holding external resources
// (file descriptors, OS handles, mmap'd regions) can opt into cleanup
// without affecting core types.

package logos.mem.hermes.release;

use logos.lang.hermes.view;
use logos.mem.hermes.string;
use logos.lang.hermes.anyval;
use logos.lang.hermes.typetag;
use logos.mem.hermes.tag_system;
use logos.mem.hermes.array;
use logos.mem.hermes.map;
use logos.lang.hermes.typed_value;
use logos.mem.hermes.objectmap;
use logos.mem.hermes.document;
use logos.lang.hermes.scalar;
use logos.mem.hermes.decimal;

#[tag_dispatch(HermesTypeTagSystem)]
pub trait HermesRelease {
    fn release(&self);
}

impl HermesRelease for HermesString    { pub fn release(&self) {} }
impl HermesRelease for AnyVal          { pub fn release(&self) {} }
impl<T: HermesRelease> HermesRelease for Array<T> { pub fn release(&self) {} }
impl<V: HermesRelease> HermesRelease for Map<Bitmap, V> { pub fn release(&self) {} }
impl<K> HermesRelease for Map<K, AnyVal> { pub fn release(&self) {} }
impl HermesRelease for ObjectMap       { pub fn release(&self) {} }
impl HermesRelease for TypedValue      { pub fn release(&self) {} }
impl HermesRelease for DocumentHeader  { pub fn release(&self) {} }
impl HermesRelease for I64             { pub fn release(&self) {} }
impl HermesRelease for U64             { pub fn release(&self) {} }
impl HermesRelease for Decimal         { pub fn release(&self) {} }
impl HermesRelease for i8              { pub fn release(&self) {} }
impl HermesRelease for u8              { pub fn release(&self) {} }
impl HermesRelease for i16             { pub fn release(&self) {} }
impl HermesRelease for u16             { pub fn release(&self) {} }
impl HermesRelease for i32             { pub fn release(&self) {} }
impl HermesRelease for u32             { pub fn release(&self) {} }
impl HermesRelease for i64             { pub fn release(&self) {} }
impl HermesRelease for u64             { pub fn release(&self) {} }
impl HermesRelease for f32             { pub fn release(&self) {} }
impl HermesRelease for f64             { pub fn release(&self) {} }
