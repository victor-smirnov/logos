// Logos standard library — std.box
//
// Box<T> — sole-ownership heap allocation (Rust parity: move-only, RAII).
// On scope exit the boxed value's destructor runs and the heap block is freed
// (`impl Drop` below). No manual free — like Rust, a Box just drops.

package logos.mem.boxed;

use logos.lang.mem;
use logos.lang.ops;

pub struct Box<T> {
    ptr: *mut T,
}

pub fn box_new<T>(val: T) -> Box<T> {
    let p: *mut T = alloc(sizeof::<T>()) as *mut T;
    unsafe { p[0] = val; }
    return Box { ptr: p };
}

impl<T> Box<T> {
    // Immutable access to the boxed value.
    pub unsafe fn get(self: *mut Box<T>) -> *const T {
        return self.ptr as *const T;
    }

    // Mutable access to the boxed value.
    pub unsafe fn get_mut(self: *mut Box<T>) -> *mut T {
        return self.ptr;
    }
}

// Deref / DerefMut (Rust parity): `*b`, and auto-deref `b.field` / `b.method()`
// route through these. Box hides the unsafe raw-pointer load behind the trait,
// so use sites need no `unsafe`. Same surface as Rc/Arc — the compiler's deref
// machinery dispatches uniformly (no Box-specific path).
impl<T> Deref<T> for Box<T> {
    fn deref(&self) -> &T {
        unsafe { return &*self.ptr; }
    }
}

impl<T> DerefMut<T> for Box<T> {
    fn deref_mut(&mut self) -> &mut T {
        unsafe { return &mut *self.ptr; }
    }
}

// Auto-Drop (Rust parity). On scope exit: move the boxed value out (firing T's
// Drop if any; no-op for POD/Copy T), then free the heap block. Null-guarded
// (defensive — a moved-from box is not dropped, and box_new of a 0-byte alloc
// could yield null).
impl<T> Drop for Box<T> {
    fn drop(self: Box<T>) {
        unsafe {
            let p: *mut T = self.ptr;
            if p != 0 as *mut T {
                // Move the boxed value out and drop it in an INNER scope, so
                // its destructor runs BEFORE the heap block is freed. This
                // matters when T's drop reads through the value's own storage
                // (e.g. a closure whose env-drop reads `{fn,env}` still held in
                // *p): dropping after dealloc(p) would be a use-after-free.
                { let _inner: T = p[0]; }
                dealloc(p as *mut u8);
            }
        }
    }
}
