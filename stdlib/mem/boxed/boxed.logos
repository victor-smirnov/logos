// Logos standard library — std.box
//
// Box<T> — sole-ownership heap allocation (Rust parity: move-only, RAII).
// On scope exit the boxed value's destructor runs and the heap block is freed
// (`impl Drop` below). No manual free — like Rust, a Box just drops.

package logos.mem.boxed;

use logos.lang.mem;
use logos.lang.marker;
use logos.lang.ops;
use logos.mem.manually_drop;

#[non_null]
pub struct Box<T: ?Sized> {
    ptr: *mut T,
}

// Box owns its allocation exclusively — Send/Sync follow the pointee
// (Rust: `unsafe impl<T: ?Sized + Send> Send for Box<T>` / Sync alike).
unsafe impl<T: ?Sized + Send> Send for Box<T> {}
unsafe impl<T: ?Sized + Sync> Sync for Box<T> {}

pub fn box_new<T>(val: T) -> Box<T> {
    let p: *mut T = alloc(sizeof::<T>()) as *mut T;
    unsafe { p[0] = val; }
    return Box { ptr: p };
}

// Consume the Box and return its raw heap pointer WITHOUT running Box's Drop
// (the heap block is NOT freed — ownership of the allocation transfers to the
// caller, who must eventually reconstitute a Box via `box_from_raw` or free it
// manually). Rust parity: `Box::into_raw`. Implemented exactly as Rust does —
// wrap the Box in ManuallyDrop to suppress its destructor, then read the ptr.
pub fn box_into_raw<T>(b: Box<T>) -> *mut T {
    let md: ManuallyDrop<Box<T>> = manually_drop_new::<Box<T>>(b);
    return md.value.ptr;
}

// Box DerefMove primitive: consume the Box, MOVE its contents out (no Drop of
// the contents — ownership transfers to the caller), and free the heap block.
// This is what Rust's built-in `*b` move (`let x = *b`) does. The compiler
// desugars `let x = *b` over a move-typed Box to this; `box_into_raw` suppresses
// Box's destructor, the raw read moves the value out (bit-copy, no drop), and
// `dealloc` frees only the block.
pub fn box_take<T>(b: Box<T>) -> T {
    let p: *mut T = box_into_raw::<T>(b);
    unsafe {
        let v: T = p[0];
        dealloc(p as *mut u8);
        return v;
    }
}

// Reconstitute a Box from a raw pointer previously produced by `box_into_raw`
// (or any pointer to a heap block allocated with the matching layout). The Box
// re-takes ownership: its Drop will run T's destructor and free the block.
// Unsafe — caller guarantees `raw` is a live, uniquely-owned allocation of T.
// Rust parity: `Box::from_raw`.
pub unsafe fn box_from_raw<T>(raw: *mut T) -> Box<T> {
    return Box { ptr: raw };
}

// Consume the Box and leak its contents, returning a `&mut T` that lives for
// the rest of the program (the allocation is never freed). Rust parity:
// `Box::leak`. Built on `box_into_raw` — same ownership give-up, just exposed
// as a reference instead of a raw pointer.
pub fn box_leak<T>(b: Box<T>) -> &mut T {
    let p: *mut T = box_into_raw::<T>(b);
    unsafe { return &mut *p; }
}

impl<T> Box<T> {
    // §6 Wave 9 — Rust API parity: `Box::new(v)` is the canonical
    // constructor. Delegates to the existing free-fn `box_new` so
    // both styles are usable.
    pub fn new(val: T) -> Box<T> {
        return box_new::<T>(val);
    }

    // Immutable access to the boxed value.
    pub unsafe fn get(self: *mut Box<T>) -> *const T {
        return self.ptr as *const T;
    }

    // Mutable access to the boxed value.
    pub unsafe fn get_mut(self: *mut Box<T>) -> *mut T {
        return self.ptr;
    }
}

// Deref / DerefMut (Rust parity): `*b`, and auto-deref `b.field` / `b.method()`
// route through these. Box hides the unsafe raw-pointer load behind the trait,
// so use sites need no `unsafe`. Same surface as Rc/Arc — the compiler's deref
// machinery dispatches uniformly (no Box-specific path).
impl<T> Deref<T> for Box<T> {
    fn deref(&self) -> &T {
        unsafe { return &*self.ptr; }
    }
}

impl<T> DerefMut<T> for Box<T> {
    fn deref_mut(&mut self) -> &mut T {
        unsafe { return &mut *self.ptr; }
    }
}

// Auto-Drop (Rust parity). On scope exit: move the boxed value out (firing T's
// Drop if any; no-op for POD/Copy T), then free the heap block. Null-guarded
// (defensive — a moved-from box is not dropped, and box_new of a 0-byte alloc
// could yield null).
impl<T> Drop for Box<T> {
    fn drop(self: Box<T>) {
        unsafe {
            let p: *mut T = self.ptr;
            if p != 0 as *mut T {
                // Move the boxed value out and drop it in an INNER scope, so
                // its destructor runs BEFORE the heap block is freed. This
                // matters when T's drop reads through the value's own storage
                // (e.g. a closure whose env-drop reads `{fn,env}` still held in
                // *p): dropping after dealloc(p) would be a use-after-free.
                { let _inner: T = p[0]; }
                dealloc(p as *mut u8);
            }
        }
    }
}
