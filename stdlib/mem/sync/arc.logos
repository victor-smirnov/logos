// Logos standard library — std.arc
//
// Arc<T: Send + Sync> — atomically reference-counted smart pointer.
// Safe to clone and share across threads; T must be Send + Sync.
//
// The strong counter is an AtomicI32 using LOCK XADD / LOCK CMPXCHG.
// When the last handle drops (fetch_sub returns 1), the inner block is freed.
//
// No weak references in this version.
//
// Usage:
//   let a1: Arc<i32> = arc_new::<i32>(0);
//   let a2: Arc<i32> = a1.clone_arc();
//   // share a2 with another thread via FutureSlot / channel ...
//   let v: *const i32 = a1.get();
//   a1.drop_arc();   // does NOT free (a2 still alive)
//   a2.drop_arc();   // frees inner block

package logos.mem.sync;

use logos.lang.mem;
use logos.lang.atomic;
use logos.lang.marker;
use logos.lang.drop;
use logos.lang.clone;
use logos.lang.option;

// ── Internal heap block ───────────────────────────────────────────────────────

// Layout MUST match RcInner ({ strong, weak, val }) so the compiler's
// Rc/Arc<dyn> unsize cast + drop recover `val` at the same offset
// (round_up(8, align(T)) — two atomic i32 counters) for both — one uniform
// rule. `weak` = live Weak handles + one implicit weak owned collectively by
// the strong handles; T drops at strong→0, the block frees at weak→0.
struct ArcInner<T> {
    strong: AtomicI32,
    weak:   AtomicI32,
    val:    T,
}

// ── Arc<T: Send + Sync> ───────────────────────────────────────────────────────

pub struct Arc<T> {
    inner: *mut ArcInner<T>,
}

// Weak<T> — a non-owning, thread-safe handle to an Arc allocation. `upgrade()`
// yields `Some(Arc)` only while a strong reference survives. Breaks Arc cycles.
pub struct Weak<T> {
    inner: *mut ArcInner<T>,
}

// logos-core 2.4 (b): `Arc<T>` carries a raw `*mut ArcInner<T>` field that
// would otherwise make the structural derivation reject it from `Send` /
// `Sync` (raw pointers are conservatively `!Send`/`!Sync`). The atomic
// refcount + immutable payload guarantee the strict aliasing rules Rust
// requires, so the safety promise lives at the API surface (only `&T`
// access through the handle, atomic clone/drop). Bound `T: Send + Sync`
// — mirrors Rust's `impl<T: Sync + Send + ?Sized> {Send,Sync} for Arc<T>`.
unsafe impl<T: Send + Sync> Send for Arc<T> {}
unsafe impl<T: Send + Sync> Sync for Arc<T> {}
unsafe impl<T: Send + Sync> Send for Weak<T> {}
unsafe impl<T: Send + Sync> Sync for Weak<T> {}

pub fn arc_new<T: Send + Sync>(val: T) -> Arc<T> {
    let inner: *mut ArcInner<T> = alloc(sizeof::<ArcInner<T>>()) as *mut ArcInner<T>;
    unsafe {
        inner.val    = val;
        inner.strong = atomic_i32_new(1);
        inner.weak   = atomic_i32_new(1);   // implicit weak held by strong refs
    }
    return Arc { inner: inner };
}

impl<T: Send + Sync> Arc<T> {
    // Immutable access to the contained value.
    pub unsafe fn get(self: *mut Arc<T>) -> *const T {
        return &self.inner.val as *const T;
    }

    pub unsafe fn strong_count(self: *mut Arc<T>) -> i32 {
        return (&self.inner.strong).load();
    }

    pub unsafe fn is_null(self: *mut Arc<T>) -> bool {
        return self.inner == 0 as *mut ArcInner<T>;
    }

    // Atomically increment the strong count; return a second handle.
    pub unsafe fn clone_arc(self: *mut Arc<T>) -> Arc<T> {
        (&mut self.inner.strong).fetch_add(1);
        return Arc { inner: self.inner };
    }

    // Same, taking `&mut self` instead of raw self pointer. Modern
    // call sites prefer this — same semantics, no caller-side raw
    // cast.
    pub fn clone_ref(&mut self) -> Arc<T> {
        unsafe {
            let p: *mut Arc<T> = self as *mut Arc<T>;
            return p.clone_arc();
        }
    }

    pub unsafe fn weak_count(self: *mut Arc<T>) -> i32 {
        return (&self.inner.weak).load() - 1;
    }

    // Atomically decrement strong; at the last strong reference run T's
    // destructor, then release the implicit weak — freeing the block only once
    // no Weak remains (Rust parity). Value drops at strong→0, block at weak→0.
    pub unsafe fn drop_arc(self: *mut Arc<T>) {
        if self.inner == 0 as *mut ArcInner<T> { return; }
        // fetch_sub returns the OLD value; old == 1 means we went 1 → 0.
        let prev: i32 = (&mut self.inner.strong).fetch_sub(1);
        if prev == 1 {
            { let _v: T = self.inner.val; }   // move-out → fires T's Drop
            let pw: i32 = (&mut self.inner.weak).fetch_sub(1);
            if pw == 1 {
                dealloc(self.inner as *mut u8);
            }
        }
        self.inner = 0 as *mut ArcInner<T>;
    }

    // Create a non-owning Weak handle (atomically bumps the weak count).
    pub unsafe fn downgrade_arc(self: *mut Arc<T>) -> Weak<T> {
        (&mut self.inner.weak).fetch_add(1);
        return Weak { inner: self.inner };
    }
    pub fn downgrade(&self) -> Weak<T> {
        unsafe {
            let p: *mut Arc<T> = self as *const Arc<T> as *mut Arc<T>;
            return p.downgrade_arc();
        }
    }
}

impl<T: Send + Sync> Weak<T> {
    // Attempt to obtain a strong Arc. Returns None if no strong reference
    // remains. NOTE: not yet a full lock-free CAS loop (load-then-bump) — a
    // strong-count race with a concurrent last-drop is possible; sufficient for
    // single-producer upgrade patterns. Full CAS is a follow-up.
    pub fn upgrade(&self) -> Option<Arc<T>> {
        unsafe {
            let p: *mut Weak<T> = self as *const Weak<T> as *mut Weak<T>;
            if p.inner == 0 as *mut ArcInner<T> { return Option::<Arc<T>>::None; }
            if (&p.inner.strong).load() == 0 { return Option::<Arc<T>>::None; }
            (&mut p.inner.strong).fetch_add(1);
            return Option::<Arc<T>>::Some(Arc { inner: p.inner });
        }
    }

    pub unsafe fn drop_weak(self: *mut Weak<T>) {
        if self.inner == 0 as *mut ArcInner<T> { return; }
        let pw: i32 = (&mut self.inner.weak).fetch_sub(1);
        if pw == 1 {
            dealloc(self.inner as *mut u8);
        }
        self.inner = 0 as *mut ArcInner<T>;
    }
}

impl<T: Send + Sync> Drop for Weak<T> {
    fn drop(self: Weak<T>) {
        unsafe {
            let p: *mut Weak<T> = &self as *const Weak<T> as *mut Weak<T>;
            p.drop_weak();
        }
    }
}

impl<T: Send + Sync> Clone for Weak<T> {
    fn clone(&self) -> Weak<T> {
        unsafe {
            let p: *mut Weak<T> = self as *const Weak<T> as *mut Weak<T>;
            if p.inner != 0 as *mut ArcInner<T> {
                (&mut p.inner.weak).fetch_add(1);
            }
            return Weak { inner: p.inner };
        }
    }
}

// Auto-Drop. Mirrors Rc's contract: decrements + frees if last,
// without calling T's destructor.
impl<T: Send + Sync> Drop for Arc<T> {
    fn drop(self: Arc<T>) {
        unsafe {
            let p: *mut Arc<T> = &self as *const Arc<T> as *mut Arc<T>;
            p.drop_arc();
        }
    }
}

// Clone (Rust parity): atomically bumps the strong count and returns a second
// handle (shared ownership), NOT a deep copy. Standard `Clone` trait so
// `.clone()` and generic `T: Clone` dispatch uniformly with Rc/Box.
impl<T: Send + Sync> Clone for Arc<T> {
    fn clone(&self) -> Arc<T> {
        unsafe {
            let p: *mut Arc<T> = self as *const Arc<T> as *mut Arc<T>;
            return p.clone_arc();
        }
    }
}

// Deref / DerefMut (Rust parity): `*arc`, auto-deref `arc.field`/`arc.method()`.
// The inner block is heap-stable for any Arc handle. `deref_mut` is a
// single-thread escape hatch (cross-thread mutation must use Mutex/atomics on
// T, which take &T). Standard trait surface — uniform with Box/Rc.
impl<T: Send + Sync> Deref<T> for Arc<T> {
    fn deref(&self) -> &T {
        unsafe { return &self.inner.val; }
    }
}

impl<T: Send + Sync> DerefMut<T> for Arc<T> {
    fn deref_mut(&mut self) -> &mut T {
        unsafe { return &mut self.inner.val; }
    }
}
