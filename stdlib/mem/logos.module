module logos-mem
id logos-mem
version 0.1
root stdlib/mem/
tier mem
depends logos-lang

# Metaprog plumbing references host externs defined inside logosc for JIT'd
# hooks. ast_only embeds their .writ0 AST (the metacall JIT recompiles them)
# while skipping codegen (the externs aren't linkable into user binaries).
# metaprog's floor is mem — it depends only on lang + mem, and lives here so it
# serves as a build-time codegen provider to every tier above (lcm, std).
ast_only compiler/metaprog
