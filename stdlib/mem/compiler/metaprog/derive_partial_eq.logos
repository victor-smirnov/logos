// logos.std.compiler.metaprog — derive(PartialEq).
//
// Hook for `#[derive_partial_eq]`. Emits rustc's expansion: a match over
// `(self, other)` that pairs up the SAME shape on both sides and compares the
// payloads field by field in declaration order (short-circuit, like `&&`);
// two different enum variants compare unequal.
//
//   impl<const N: usize, T: PartialEq> PartialEq for Name<N, T> {
//       fn eq(&self, other: &Name<N, T>) -> bool {
//           match (self, other) {
//               (Self::U, Self::U) => { return true; }
//               (Self::T(__self_0), Self::T(__arg1_0)) => {
//                   if !(*__self_0 == *__arg1_0) { return false; }
//                   return true;
//               }
//               …
//               _ => { return false; }
//           }
//       }
//   }
//
// Shapes (named / tuple / unit struct, enum variants of every shape) come
// from `derive_shape_of`; see derive_shape.logos.

package logos.std.compiler.metaprog;

use logos.mem.collections.vec;
use logos.lang.writ.anyval;
use logos.lang.cmp;

#[metaprog_handler("derive_partial_eq")]
fn derive_partial_eq_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: WAny = view.node_at(target_offset);
    if view.ast_node_name(item).len == (0 as u64) { return; }
    let sh: DeriveShape = derive_shape_of(&view, item);
    let nm: Ident = sh.nm;
    let tparams: Vec<Ident> = sh.tparams;
    let cparams: Vec<Ident> = sh.cparams;
    let ctypes: Vec<Ident> = sh.ctypes;
    let gargs: Vec<Ident> = sh.gargs;
    let unit_v: Vec<Ident> = sh.unit_v;
    let tup_v: Vec<Ident> = sh.tup_v;
    let tup_a: Vec<Vec<Ident>> = sh.tup_a;
    let tup_b: Vec<Vec<Ident>> = sh.tup_b;
    let st_v: Vec<Ident> = sh.st_v;
    let st_f: Vec<Vec<Ident>> = sh.st_f;
    let st_a: Vec<Vec<Ident>> = sh.st_a;
    let st_b: Vec<Vec<Ident>> = sh.st_b;
    let sn: Vec<Ident> = sh.sn;
    let sn_f: Vec<Vec<Ident>> = sh.sn_f;
    let sn_a: Vec<Vec<Ident>> = sh.sn_a;
    let sn_b: Vec<Vec<Ident>> = sh.sn_b;
    let tn: Vec<Ident> = sh.tn;
    let tn_a: Vec<Vec<Ident>> = sh.tn_a;
    let tn_b: Vec<Vec<Ident>> = sh.tn_b;

    let blob: QuoteItemBlob = quote_item! {
        impl<#( const #cparams: #ctypes ),*, #( #tparams: PartialEq ),*> PartialEq for #nm<#( #gargs ),*> {
            fn eq(&self, other: &#nm<#( #gargs ),*>) -> bool {
                match (self, other) {
                    #( (Self::#unit_v, Self::#unit_v) => { return true; } )*
                    #( (Self::#tup_v( #( #tup_a ),* ), Self::#tup_v( #( #tup_b ),* )) => {
                        #( if !(*#tup_a == *#tup_b) { return false; } )*
                        return true;
                    } )*
                    #( (Self::#st_v { #( #st_f: #st_a ),* }, Self::#st_v { #( #st_f: #st_b ),* }) => {
                        #( if !(*#st_a == *#st_b) { return false; } )*
                        return true;
                    } )*
                    #( (#sn { #( #sn_f: #sn_a ),* }, #sn { #( #sn_f: #sn_b ),* }) => {
                        #( if !(*#sn_a == *#sn_b) { return false; } )*
                        return true;
                    } )*
                    #( (#tn( #( #tn_a ),* ), #tn( #( #tn_b ),* )) => {
                        #( if !(*#tn_a == *#tn_b) { return false; } )*
                        return true;
                    } )*
                    _ => { return false; }
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}
