// logos.std.compiler.metaprog — derive(Ord).
//
// Hook for `#[derive_ord]`. Emits lexicographic Rust-derive(Ord): pair up
// the fields of both sides by pattern and compare them in declaration order,
// early-returning the first non-Equal —
//
//   impl<const N: usize, T: Ord> Ord for Name<N, T> {
//       fn cmp(&self, other: &Name<N, T>) -> Ordering {
//           match (self, other) {
//               (Name { f1: __self_0, … }, Name { f1: __arg1_0, … }) => {
//                   { let __o: Ordering = __self_0.cmp(__arg1_0); if !__o.is_eq() { return __o; } }
//                   …
//                   return Ordering::Equal;
//               }
//           }
//       }
//   }
//
// Named, tuple and unit structs (unit: Equal). An ENUM is refused with a
// diagnostic: rustc orders variants by declaration and `impl Ord for` an enum
// does not compile yet (the default methods it inherits lose `Self` after the
// first — interaction cluster derive-ord-enum-self), so emitting one would only
// move the failure into generated code. Shapes: see derive_shape.logos.
//
// §6.10 sub-deliverable 5/8.

package logos.std.compiler.metaprog;

use logos.mem.collections.vec;
use logos.lang.writ.anyval;
use logos.lang.cmp;

#[metaprog_handler("derive_ord")]
fn derive_ord_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: WAny = view.node_at(target_offset);
    if view.ast_node_name(item).len == (0 as u64) { return; }
    if (view.ast_node_code(item) & (0xFFFF as u64)) == (80 as u64) {
        error_at(target_offset, "#[derive_ord] on an enum is not supported yet: `impl Ord` for an enum does not compile (derive-ord-enum-self)");
        return;
    }
    let sh: DeriveShape = derive_shape_of(&view, item);
    let nm: Ident = sh.nm;
    let tparams: Vec<Ident> = sh.tparams;
    let cparams: Vec<Ident> = sh.cparams;
    let ctypes: Vec<Ident> = sh.ctypes;
    let gargs: Vec<Ident> = sh.gargs;
    let sn: Vec<Ident> = sh.sn;
    let sn_f: Vec<Vec<Ident>> = sh.sn_f;
    let sn_a: Vec<Vec<Ident>> = sh.sn_a;
    let sn_b: Vec<Vec<Ident>> = sh.sn_b;
    let tn: Vec<Ident> = sh.tn;
    let tn_a: Vec<Vec<Ident>> = sh.tn_a;
    let tn_b: Vec<Vec<Ident>> = sh.tn_b;

    let blob: QuoteItemBlob = quote_item! {
        impl<#( const #cparams: #ctypes ),*, #( #tparams: Ord ),*> Ord for #nm<#( #gargs ),*> {
            fn cmp(&self, other: &#nm<#( #gargs ),*>) -> Ordering {
                match (self, other) {
                    #( (#sn { #( #sn_f: #sn_a ),* }, #sn { #( #sn_f: #sn_b ),* }) => {
                        #( {
                            let __o: Ordering = #sn_a.cmp(#sn_b);
                            if !__o.is_eq() { return __o; }
                        } )*
                        return Ordering::Equal;
                    } )*
                    #( (#tn( #( #tn_a ),* ), #tn( #( #tn_b ),* )) => {
                        #( {
                            let __o: Ordering = #tn_a.cmp(#tn_b);
                            if !__o.is_eq() { return __o; }
                        } )*
                        return Ordering::Equal;
                    } )*
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}
