// logos.std.compiler.metaprog — derive(Ord) for plain and generic
// structs.
//
// Hook for `#[derive_ord]`. Emits lexicographic Rust-derive(Ord)
// DIRECTLY: a per-field statement FOLD, each iteration comparing one
// field and early-returning the first non-Equal —
//
//   impl<T1: Ord, ...> Ord for Name<T1, ...> {
//       fn cmp(&self, other: &Name<T1, ...>) -> Ordering {
//           { let __o = self.f1.cmp(&other.f1); if !__o.is_eq() { return __o; } }
//           { let __o = self.f2.cmp(&other.f2); if !__o.is_eq() { return __o; } }
//           …
//           return Ordering::Equal;
//       }
//   }
//
// (The historical form accumulated a RUNTIME Vec<Ordering> and scanned
// it — a heap allocation per cmp sidestepping the then-missing
// statement folds. Empty-field structs degenerate to Equal.)
//
// §6.10 sub-deliverable 5/8.

package logos.std.compiler.metaprog;

use logos.mem.collections.vec;
use logos.lang.writ.anyval;
use logos.lang.cmp;

#[metaprog_handler("derive_ord")]
fn derive_ord_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: WAny = view.node_at(target_offset);
    let nm_sv: SView = view.ast_node_name(item);
    if nm_sv.len == (0 as u64) { return; }
    let nm: Ident = Ident { ptr: nm_sv.ptr, len: nm_sv.len };

    let nf: u64 = view.ast_struct_field_count(item);
    let mut fnames: Vec<Ident> = vec_new::<Ident>();
    let mut i: u64 = 0 as u64;
    while i < nf {
        let fld: WAny = view.ast_struct_field(item, i);
        let fsv: SView = view.ast_field_name(fld);
        fnames.push(Ident { ptr: fsv.ptr, len: fsv.len });
        i = i + (1 as u64);
    }

    let np: u64 = view.ast_type_param_count(item);
    let mut tparams: Vec<Ident> = vec_new::<Ident>();
    let mut k: u64 = 0 as u64;
    while k < np {
        let tp: SView = view.ast_type_param_name(item, k);
        tparams.push(Ident { ptr: tp.ptr, len: tp.len });
        k = k + (1 as u64);
    }

    if np == (0 as u64) {
        let blob: QuoteItemBlob = quote_item! {
            impl Ord for #(nm) {
                fn cmp(&self, other: &#(nm)) -> Ordering {
                    #( {
                        let __o: Ordering = self.#fnames.cmp(&other.#fnames);
                        if !__o.is_eq() { return __o; }
                    } )*
                    return Ordering::Equal;
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&blob); }
    } else {
        let blob2: QuoteItemBlob = quote_item! {
            impl<#( #tparams: Ord ),*> Ord for #nm<#( #tparams ),*> {
                fn cmp(&self, other: &#nm<#( #tparams ),*>) -> Ordering {
                    #( {
                        let __o: Ordering = self.#fnames.cmp(&other.#fnames);
                        if !__o.is_eq() { return __o; }
                    } )*
                    return Ordering::Equal;
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&blob2); }
    }
    return;
}
