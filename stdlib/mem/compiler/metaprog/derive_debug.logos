// logos.std.compiler.metaprog — derive(Debug).
//
// Hook for `#[derive_debug]`. Emits rustc's expansion, byte-identical output:
//
//   unit variant / unit struct   `A`            f.write_str("A")
//   tuple variant / tuple struct `B(1, true)`   f.debug_tuple("B") + .field(..)
//   struct variant / struct      `C { x: 1 }`   f.debug_struct("C") + .field("x", ..)
//
// (`D {}` and `struct S {}` print the bare name, as the `DebugStruct` builder
// with no fields does.) Names come from `##ident` str-position antiquots. One
// `match self` covers every shape; see derive_shape.logos.

package logos.std.compiler.metaprog;

use logos.mem.collections.vec;
use logos.lang.writ.anyval;
use logos.lang.result;
use logos.mem.fmt;

#[metaprog_handler("derive_debug", "logos.mem.fmt::Debug")]
fn derive_debug_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: WAny = view.node_at(target_offset);
    if view.ast_node_name(item).len == (0 as u64) { return; }
    let sh: DeriveShape = derive_shape_of(&view, item);
    let nm: Ident = sh.nm;
    let tparams: Vec<Ident> = sh.tparams;
    let cparams: Vec<Ident> = sh.cparams;
    let ctypes: Vec<Ident> = sh.ctypes;
    let gargs: Vec<Ident> = sh.gargs;
    let unit_v: Vec<Ident> = sh.unit_v;
    let tup_v: Vec<Ident> = sh.tup_v;
    let tup_a: Vec<Vec<Ident>> = sh.tup_a;
    let st_v: Vec<Ident> = sh.st_v;
    let st_f: Vec<Vec<Ident>> = sh.st_f;
    let st_a: Vec<Vec<Ident>> = sh.st_a;
    let sn: Vec<Ident> = sh.sn;
    let sn_f: Vec<Vec<Ident>> = sh.sn_f;
    let sn_a: Vec<Vec<Ident>> = sh.sn_a;
    let tn: Vec<Ident> = sh.tn;
    let tn_a: Vec<Vec<Ident>> = sh.tn_a;

    let blob: QuoteItemBlob = quote_item! {
        impl<#( const #cparams: #ctypes ),*, #( #tparams: Debug ),*> Debug for #nm<#( #gargs ),*> {
            fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
                match self {
                    #( Self::#unit_v => { return f.write_str(##unit_v); } )*
                    #( Self::#tup_v( #( #tup_a ),* ) => {
                        let mut __dt: DebugTuple = f.debug_tuple(##tup_v);
                        #( { let _ = __dt.field(#tup_a); } )*
                        return __dt.finish();
                    } )*
                    #( Self::#st_v { #( #st_f: #st_a ),* } => {
                        let mut __ds: DebugStruct = f.debug_struct(##st_v);
                        #( { let _ = __ds.field(##st_f, #st_a); } )*
                        return __ds.finish();
                    } )*
                    #( #sn { #( #sn_f: #sn_a ),* } => {
                        let mut __ds: DebugStruct = f.debug_struct(##sn);
                        #( { let _ = __ds.field(##sn_f, #sn_a); } )*
                        return __ds.finish();
                    } )*
                    #( #tn( #( #tn_a ),* ) => {
                        let mut __dt: DebugTuple = f.debug_tuple(##tn);
                        #( { let _ = __dt.field(#tn_a); } )*
                        return __dt.finish();
                    } )*
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}
