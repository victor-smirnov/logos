// logos.std.compiler.metaprog — derive(BranchNodeMP) — slice-1e.
//
// Hook for `#[derive_branch_node(ops = "<CONST_NAME>")]` on a LeafNode-
// shaped struct. Emits a sibling `BranchNodeMP<K, STORE_CFG, CFG>`
// whose layout mirrors the existing hand-written
// logos.lcm.deem.data.bt.cow.BranchNode plus one aggregate column per
// supported op.
//
// Slice-1e: the const-name carrying the op-list is READ from the
// annotation's `ops = "..."` keyword arg. The user declares:
//
//   pub const MY_OPS: WritStatic = @["sizes", "u64"];
//
//   #[derive_branch_node(ops = "MY_OPS")]
//   pub struct LeafNode<...> { ... }
//
// → emit `BranchNodeMP<...> { ..., pub sizes: PrimVec<u64> }`.
//
// The op-list itself is still a flat alternating-pair string array
// (slice 2 will promote to nested WritStatic for richer per-op
// specs: leaf-reduce / branch-reduce fn-name / etc.).

package logos.std.compiler.metaprog;

use logos.mem.collections.vec;
use logos.lang.writ.anyval;
use logos.mem.string;
use logos.lang.str;
// Note (debt #13 closure): the handler used to import
// `std.lang.datatypes`, `logos.lcm.deem.data.bt.node` and
// `logos.lcm.deem.data.bt.shuttle` to make NodeBase / Buffer / NodeARC /
// PrimVec / ShuttleResult resolvable in the emit context. With the
// emit now inheriting the originating user module's USES, those types
// resolve through the user's own imports — this handler no longer
// needs to know about the persistent stack at all.
use logos.lang.mem;

// Walk module ITEMS to find the ANNOTATION immediately preceding the
// target item whose NAME matches `trigger`. Returns the ANNOTATION
// AnyVal or null if not found. The walk is bounded — we stop on the
// first non-ANNOTATION item before the target so we don't pick up an
// earlier struct's annotations.
unsafe fn find_my_annotation(view: &OView, target_offset: u32, trigger: str) -> WAny {
    let root: WAny = view.root();
    let items: WAny = view.tiny_map_get(root, 2 as u8);
    if items.is_null() { return WAny::Ref(0i64 as *const u8); }
    let n: u64 = view.array_len(items);

    // Find target index.
    let mut tgt_idx: i64 = -1i64;
    let mut i: u64 = 0u64;
    while i < n {
        let it: WAny = view.array_get(items, i);
        if !it.is_null() && ((it.resolve() as i64 - view.base as i64) as u32) == target_offset {
            tgt_idx = i as i64;
            break;
        }
        i = i + (1 as u64);
    }
    if tgt_idx < 0 { return WAny::Ref(0i64 as *const u8); }

    // Walk back collecting ANNOTATION nodes; return one whose NAME
    // matches `trigger`. Bail at the first non-ANNOTATION item.
    let trig_len: u64 = trigger.len() as u64;
    let mut k: i64 = tgt_idx - (1 as i64);
    while k >= 0 {
        let it: WAny = view.array_get(items, k as u64);
        let code_av: WAny = view.tiny_map_get(it, 0 as u8);     // CODE
        if code_av.is_null() { break; }
        let code_val: i32 = code_av.as_i24();
        if code_val != (150 as i32) { break; }                    // !ANNOTATION
        let nm_sv: SView = view.ast_node_name(it);
        if nm_sv.len == trig_len {
            let mut j: u64 = 0u64;
            let mut eq: bool = true;
            unsafe {
                while j < trig_len {
                    let a: u8 = *((nm_sv.ptr as i64 + j as i64) as *const u8);
                    let b: u8 = *((trigger.as_ptr() as i64 + j as i64) as *const u8);
                    if a != b { eq = false; break; }
                    j = j + (1 as u64);
                }
            }
            if eq { return it; }
        }
        k = k - (1 as i64);
    }
    return WAny::Ref(0i64 as *const u8);
}

// In an ANNOTATION's ARGS list, find the ANNOT_KV with NAME=`key`
// and return its VALUE AnyVal. Null if no such entry.
unsafe fn annot_kv_value(view: &OView, ann: WAny, key: str) -> WAny {
    let args: WAny = view.tiny_map_get(ann, 15 as u8);          // ARGS
    if args.is_null() { return WAny::Ref(0i64 as *const u8); }
    let items: WAny = view.tiny_map_get(args, 2 as u8);         // ITEMS
    if items.is_null() { return WAny::Ref(0i64 as *const u8); }
    let n: u64 = view.array_len(items);
    let klen: u64 = key.len() as u64;
    let mut i: u64 = 0u64;
    while i < n {
        let entry: WAny = view.array_get(items, i);
        let code_av: WAny = view.tiny_map_get(entry, 0 as u8);
        let code_val: i32 = code_av.as_i24();
        if !code_av.is_null() && code_val == (192 as i32) {       // ANNOT_KV
            let nm_sv: SView = view.ast_node_name(entry);
            if nm_sv.len == klen {
                let mut j: u64 = 0u64;
                let mut eq: bool = true;
                unsafe {
                    while j < klen {
                        let a: u8 = *((nm_sv.ptr as i64 + j as i64) as *const u8);
                        let b: u8 = *((key.as_ptr() as i64 + j as i64) as *const u8);
                        if a != b { eq = false; break; }
                        j = j + (1 as u64);
                    }
                }
                if eq { return view.tiny_map_get(entry, 7 as u8); }   // VALUE
            }
        }
        i = i + (1 as u64);
    }
    return WAny::Ref(0i64 as *const u8);
}

// In a WRIT_MAP node (AST shape: { CODE: WRIT_MAP, ITEMS: [WRIT_ENTRY{KEY,VALUE},...] }),
// find the entry whose KEY matches `key` byte-for-byte and return its
// VALUE AnyVal. KEY is a STRING token captured with surrounding quotes.
fn writ_map_get(view: &OView, wmap: WAny, key: str) -> WAny {
    let items: WAny = view.tiny_map_get(wmap, 2 as u8);          // ITEMS
    if items.is_null() { return WAny::Ref(0i64 as *const u8); }
    let n: u64 = view.array_len(items);
    let klen: u64 = key.len() as u64;
    let mut i: u64 = 0u64;
    while i < n {
        let entry: WAny = view.array_get(items, i);
        // entry has KEY (field 18) and VALUE (field 7); KEY is a STRING-
        // captured token with quotes around it, same as LIT_STR/WRIT_STR.
        let key_av: WAny = view.tiny_map_get(entry, 51 as u8);   // KEY
        let raw: SView = view.get_str_view(key_av);
        if raw.len >= (2 as u64) {
            let inner_len: u64 = raw.len - (2 as u64);
            if inner_len == klen {
                let mut j: u64 = 0u64;
                let mut eq: bool = true;
                unsafe {
                    while j < klen {
                        let a: u8 = *((raw.ptr as i64 + 1i64 + j as i64) as *const u8);
                        let b: u8 = *((key.as_ptr() as i64 + j as i64) as *const u8);
                        if a != b { eq = false; break; }
                        j = j + (1 as u64);
                    }
                }
                if eq { return view.tiny_map_get(entry, 7 as u8); }
            }
        }
        i = i + (1 as u64);
    }
    return WAny::Ref(0i64 as *const u8);
}

#[metaprog_handler("derive_branch_node")]
fn derive_branch_node_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: WAny = view.node_at(target_offset);
    let nm_sv: SView = view.ast_node_name(item);
    if nm_sv.len == (0 as u64) { return; }

    // Read leaf type-param names. Convention: [K, V, STORE_CFG, CFG].
    let np: u64 = view.ast_type_param_count(item);
    if np < (4 as u64) { return; }

    let k_sv:    SView = view.ast_type_param_name(item, 0 as u64);
    let scfg_sv: SView = view.ast_type_param_name(item, 2 as u64);
    let cfg_sv:  SView = view.ast_type_param_name(item, 3 as u64);

    let k:    Ident = Ident { ptr: k_sv.ptr,    len: k_sv.len };
    let scfg: Ident = Ident { ptr: scfg_sv.ptr, len: scfg_sv.len };
    let cfg:  Ident = Ident { ptr: cfg_sv.ptr,  len: cfg_sv.len };

    // Resolve `ops` (op-list const name) and `branch` (emitted struct
    // name) from the annotation's keyword args. Defaults preserve the
    // pre-1f behaviour: ops="BRANCH_OPS", branch="BranchNodeMP".
    let mut ops_name_ptr:    *const u8 = 0 as *const u8;
    let mut ops_name_len:    u64       = 0 as u64;
    let mut branch_name_ptr: *const u8 = 0 as *const u8;
    let mut branch_name_len: u64       = 0 as u64;
    let ann: WAny = unsafe { find_my_annotation(&view, target_offset, "derive_branch_node") };
    if !ann.is_null() {
        let kv_ops: WAny = unsafe { annot_kv_value(&view, ann, "ops") };
        if !kv_ops.is_null() {
            let sv: SView = view.ast_lit_str_view(kv_ops);
            ops_name_ptr = sv.ptr;
            ops_name_len = sv.len;
        }
        let kv_branch: WAny = unsafe { annot_kv_value(&view, ann, "branch") };
        if !kv_branch.is_null() {
            let sv: SView = view.ast_lit_str_view(kv_branch);
            branch_name_ptr = sv.ptr;
            branch_name_len = sv.len;
        }
    }
    let ops_name: str = if ops_name_len > (0 as u64) {
        unsafe { str_from_raw(ops_name_ptr, ops_name_len as i64) }
    } else {
        "BRANCH_OPS"
    };
    let branch_id: Ident = if branch_name_len > (0 as u64) {
        Ident { ptr: branch_name_ptr, len: branch_name_len }
    } else {
        let s: str = "BranchNodeMP";
        Ident::new(s)
    };

    // Op-list discovery. Each op is a WRIT_MAP with keys
    // "field" (col name), "type" (elem type), "kind" ("SUM" or "MAX").
    // Three parallel cursors drive both struct-field emission and
    // shuttle-wrapper emission below.
    let mut col_names:    Vec<Ident> = vec_new::<Ident>();
    let mut col_types:    Vec<Ident> = vec_new::<Ident>();
    let mut shuttle_fns:  Vec<Ident> = vec_new::<Ident>();   // stdlib templ name
    let mut shuttle_syms: Vec<Ident> = vec_new::<Ident>();   // emitted wrapper

    let ops_const: WAny = view.find_template_decl(ops_name);
    if !ops_const.is_null() {
        let arr_lit: WAny = view.tiny_map_get(ops_const, 7 as u8);   // VALUE
        if !arr_lit.is_null() {
            let items: WAny = view.tiny_map_get(arr_lit, 2 as u8);   // ITEMS
            if !items.is_null() {
                let n: u64 = view.array_len(items);
                let mut i: u64 = 0u64;
                while i < n {
                    let op_map: WAny = view.array_get(items, i);
                    let f_sv: SView = view.ast_lit_str_view(
                        writ_map_get(&view, op_map, "field"));
                    let t_sv: SView = view.ast_lit_str_view(
                        writ_map_get(&view, op_map, "type"));
                    let k_sv: SView = view.ast_lit_str_view(
                        writ_map_get(&view, op_map, "kind"));
                    if f_sv.len > (0 as u64) && t_sv.len > (0 as u64) && k_sv.len > (0 as u64) {
                        let f_id: Ident = Ident { ptr: f_sv.ptr, len: f_sv.len };
                        let t_id: Ident = Ident { ptr: t_sv.ptr, len: t_sv.len };
                        // Pick stdlib template: shuttle_sum_<type> / shuttle_max_<type>.
                        // Slice 2 ships only u64 instantiations, so we hardcode the
                        // suffix; richer types come with monomorphisation work.
                        let mut tmpl_name: String = String::new();
                        unsafe {
                            let mut p: i64 = k_sv.ptr as i64;
                            let mut left: u64 = k_sv.len;
                            tmpl_name.push_str("shuttle_");
                            while left > (0 as u64) {
                                let b: u8 = *(p as *const u8);
                                // Lowercase ASCII A-Z → a-z.
                                let lo: u8 = if b >= (65u8) && b <= (90u8) { b + (32u8) } else { b };
                                tmpl_name.push_u8(lo);
                                p = p + (1 as i64);
                                left = left - (1 as u64);
                            }
                            tmpl_name.push_str("_u64");
                        }
                        let tmpl_len: u64 = tmpl_name.len() as u64;
                        let tmpl_ptr: *const u8 = unsafe {
                            leak_str_bytes(tmpl_name.as_str())
                        };
                        let tmpl_id: Ident = Ident { ptr: tmpl_ptr, len: tmpl_len };

                        // Wrapper symbol name: branchnode_<field>_shuttle.
                        let mut sym_name: String = String::new();
                        unsafe {
                            sym_name.push_str("branchnode_");
                            let mut p: i64 = f_sv.ptr as i64;
                            let mut left: u64 = f_sv.len;
                            while left > (0 as u64) {
                                sym_name.push_u8(*(p as *const u8));
                                p = p + (1 as i64);
                                left = left - (1 as u64);
                            }
                            sym_name.push_str("_shuttle");
                        }
                        let sym_len: u64 = sym_name.len() as u64;
                        let sym_ptr: *const u8 = unsafe {
                            leak_str_bytes(sym_name.as_str())
                        };
                        let sym_id: Ident = Ident { ptr: sym_ptr, len: sym_len };

                        unsafe {
                            col_names.push(f_id);
                            col_types.push(t_id);
                            shuttle_fns.push(tmpl_id);
                            shuttle_syms.push(sym_id);
                        }
                    }
                    i = i + (1 as u64);
                }
            }
        }
    }

    let blob: QuoteItemBlob = quote_item! {
        pub struct #branch_id<#k: Container + ContainerOrd, const #scfg: WritStatic, const #cfg: WritStatic> {
            pub base:     NodeBase<#scfg>,
            pub keys:     Buffer<#k>,
            pub children: Vec<NodeARC<#scfg>>,
            #( pub #col_names: PrimVec<#col_types> ),*
        }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }

    // Per-op shuttle wrapper. One thin fn per op that calls the stdlib
    // shuttle template against the right column. Signature is uniform
    // over op kinds (target=u64, returns ShuttleResult) so the descent
    // composer can dispatch by name.
    //
    // REPEAT_GROUP at item-list position inside quote_item! is not yet
    // supported — emit one quote_item! per op via a Logos loop instead.
    let m: i64 = shuttle_syms.length();
    let mut idx: i64 = 0i64;
    while idx < m {
        let sym:  Ident = unsafe { *shuttle_syms.at_const(idx) };
        let tmpl: Ident = unsafe { *shuttle_fns.at_const(idx) };
        let cn:   Ident = unsafe { *col_names.at_const(idx) };
        let ct:   Ident = unsafe { *col_types.at_const(idx) };
        let one: QuoteItemBlob = quote_item! {
            pub fn #(sym)<#k: Container + ContainerOrd, const #scfg: WritStatic, const #cfg: WritStatic>(
                br: *const #branch_id<#k, #scfg, #cfg>, target: u64,
            ) -> ShuttleResult {
                unsafe {
                    return #(tmpl)(&br.#cn as *const PrimVec<#ct>, target);
                }
            }
        };
        unsafe { logos_emit_item_blob_subst(&one); }
        idx = idx + 1i64;
    }
    return;
}

// Copy the string's bytes into a fresh heap allocation that we never
// free. Used for Ident backings whose bytes the quote_item!
// placeholders need to read at substitution time — placeholder reads
// happen after the local String would have been dropped, so a non-
// owning Ident view into the local would dangle. The leak's lifetime
// is one metafn invocation; cleanup later via a host-side gensym-
// equivalent that rents bytes for the metafn lifetime.
unsafe fn leak_str_bytes(s: str) -> *const u8 {
    let n: i64 = s.len();
    let p: *mut u8 = alloc(n);
    let mut i: i64 = 0i64;
    while i < n {
        p[i] = s.as_ptr()[i];
        i = i + 1i64;
    }
    return p as *const u8;
}
