// logos.std.compiler.metaprog — derive(Clone).
//
// Hook for `#[derive_clone]`. Emits rustc's expansion: rebuild the same shape
// from each field's `Clone::clone(&field)` (rustc's expansion: a `&'a T` field clones the reference, not the T), in declaration order.
//
//   impl<const N: usize, T: Clone> Clone for Name<N, T> {
//       fn clone(&self) -> Name<N, T> {
//           match self {
//               Self::U => { return Self::U; }
//               Self::T(__self_0) => { return Self::T(Clone::clone(__self_0)); }
//               Self::S { x: __self_0 } => { return Self::S { x: Clone::clone(__self_0) }; }
//               Name { x: __self_0 } => { return Name { x: Clone::clone(__self_0) }; }
//               Name(__self_0) => { return Name(Clone::clone(__self_0)); }
//           }
//       }
//   }
//
// Each field dispatches through its own Clone impl (primitive impls live in
// `stdlib/lang/clone/clone.logos`). Shapes: see derive_shape.logos.

package logos.std.compiler.metaprog;

use logos.mem.collections.vec;
use logos.lang.writ.anyval;
use logos.lang.clone;

#[metaprog_handler("derive_clone", "logos.lang.clone::Clone")]
fn derive_clone_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: WAny = view.node_at(target_offset);
    if view.ast_node_name(item).len == (0 as u64) { return; }
    let sh: DeriveShape = derive_shape_of(&view, item);
    let nm: Ident = sh.nm;
    let lparams: Vec<Ident> = sh.lparams;
    let tparams: Vec<Ident> = sh.tparams;
    let cparams: Vec<Ident> = sh.cparams;
    let ctypes: Vec<Ident> = sh.ctypes;
    let gargs: Vec<Ident> = sh.gargs;
    let unit_v: Vec<Ident> = sh.unit_v;
    let tup_v: Vec<Ident> = sh.tup_v;
    let tup_a: Vec<Vec<Ident>> = sh.tup_a;
    let st_v: Vec<Ident> = sh.st_v;
    let st_f: Vec<Vec<Ident>> = sh.st_f;
    let st_a: Vec<Vec<Ident>> = sh.st_a;
    let sn: Vec<Ident> = sh.sn;
    let sn_f: Vec<Vec<Ident>> = sh.sn_f;
    let sn_a: Vec<Vec<Ident>> = sh.sn_a;
    let tn: Vec<Ident> = sh.tn;
    let tn_a: Vec<Vec<Ident>> = sh.tn_a;

    let blob: QuoteItemBlob = quote_item! {
        impl<#( #lparams ),*, #( const #cparams: #ctypes ),*, #( #tparams: Clone ),*> Clone for #nm<#( #gargs ),*> {
            fn clone(&self) -> #nm<#( #gargs ),*> {
                match self {
                    #( Self::#unit_v => { return Self::#unit_v; } )*
                    #( Self::#tup_v( #( #tup_a ),* ) => {
                        return Self::#tup_v( #( Clone::clone(#tup_a) ),* );
                    } )*
                    #( Self::#st_v { #( #st_f: #st_a ),* } => {
                        return Self::#st_v { #( #st_f: Clone::clone(#st_a) ),* };
                    } )*
                    #( #sn { #( #sn_f: #sn_a ),* } => {
                        return #sn { #( #sn_f: Clone::clone(#sn_a) ),* };
                    } )*
                    #( #tn( #( #tn_a ),* ) => {
                        return #tn( #( Clone::clone(#tn_a) ),* );
                    } )*
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}
