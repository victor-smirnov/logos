// logos.std.compiler.metaprog — derive(PartialOrd).
//
// Hook for `#[derive_partial_ord]`. Emits rustc's lexicographic derive: pair up
// the fields of both sides by pattern and compare them in declaration order,
// returning the first `partial_cmp` that is not `Some(Equal)` (a `None` — an
// incomparable field — included) —
//
//   impl<const N: usize, T: PartialOrd> PartialOrd for Name<N, T> {
//       fn partial_cmp(&self, other: &Name<N, T>) -> Option<Ordering> {
//           match (self, other) {
//               (Name { f1: __self_0, … }, Name { f1: __arg1_0, … }) => {
//                   { let __o: Option<Ordering> = __self_0.partial_cmp(__arg1_0);
//                     match __o { Option::Some(Ordering::Equal) => {} _ => { return __o; } } }
//                   …
//                   return Option::Some(Ordering::Equal);
//               }
//           }
//       }
//   }
//
// Named, tuple and unit structs, and enums: an enum compares the variants'
// declaration order first (`en_v`), then the fields of one variant as a struct's.
// Shapes: see derive_shape.logos.
//
// §6.10 sub-deliverable 6/8.

package logos.std.compiler.metaprog;

use logos.mem.collections.vec;
use logos.lang.writ.anyval;
use logos.lang.cmp;

#[metaprog_handler("derive_partial_ord", "logos.lang.cmp::PartialOrd")]
fn derive_partial_ord_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: WAny = view.node_at(target_offset);
    if view.ast_node_name(item).len == (0 as u64) { return; }
    let sh: DeriveShape = derive_shape_of(&view, item);
    let nm: Ident = sh.nm;
    let lparams: Vec<Ident> = sh.lparams;
    let tparams: Vec<Ident> = sh.tparams;
    let cparams: Vec<Ident> = sh.cparams;
    let ctypes: Vec<Ident> = sh.ctypes;
    let gargs: Vec<Ident> = sh.gargs;
    let sn: Vec<Ident> = sh.sn;
    let sn_f: Vec<Vec<Ident>> = sh.sn_f;
    let sn_a: Vec<Vec<Ident>> = sh.sn_a;
    let sn_b: Vec<Vec<Ident>> = sh.sn_b;
    let tn: Vec<Ident> = sh.tn;
    let tn_a: Vec<Vec<Ident>> = sh.tn_a;
    let tn_b: Vec<Vec<Ident>> = sh.tn_b;
    let unit_v: Vec<Ident> = sh.unit_v;
    let tup_v: Vec<Ident> = sh.tup_v;
    let tup_a: Vec<Vec<Ident>> = sh.tup_a;
    let tup_b: Vec<Vec<Ident>> = sh.tup_b;
    let st_v: Vec<Ident> = sh.st_v;
    let st_f: Vec<Vec<Ident>> = sh.st_f;
    let st_a: Vec<Vec<Ident>> = sh.st_a;
    let st_b: Vec<Vec<Ident>> = sh.st_b;
    let en_v: Vec<Vec<Ident>> = sh.en_v;

    let blob: QuoteItemBlob = quote_item! {
        impl<#( #lparams ),*, #( const #cparams: #ctypes ),*, #( #tparams: PartialOrd ),*> PartialOrd for #nm<#( #gargs ),*> {
            fn partial_cmp(&self, other: &#nm<#( #gargs ),*>) -> Option<Ordering> {
                #( {
                    let mut __ra: u64 = 0; let mut __rb: u64 = 0; let mut __k: u64 = 0;
                    #( {
                        if let Self::#en_v { .. } = self { __ra = __k; }
                        if let Self::#en_v { .. } = other { __rb = __k; }
                        __k = __k + 1;
                    } )*
                    if __ra != __rb { return __ra.partial_cmp(&__rb); }
                } )*
                match (self, other) {
                    #( (Self::#unit_v, Self::#unit_v) => { return Option::Some(Ordering::Equal); } )*
                    #( (Self::#tup_v( #( #tup_a ),* ), Self::#tup_v( #( #tup_b ),* )) => {
                        #( {
                            let __o: Option<Ordering> = #tup_a.partial_cmp(#tup_b);
                            match __o { Option::Some(Ordering::Equal) => {} _ => { return __o; } }
                        } )*
                        return Option::Some(Ordering::Equal);
                    } )*
                    #( (Self::#st_v { #( #st_f: #st_a ),* }, Self::#st_v { #( #st_f: #st_b ),* }) => {
                        #( {
                            let __o: Option<Ordering> = #st_a.partial_cmp(#st_b);
                            match __o { Option::Some(Ordering::Equal) => {} _ => { return __o; } }
                        } )*
                        return Option::Some(Ordering::Equal);
                    } )*
                    #( (#sn { #( #sn_f: #sn_a ),* }, #sn { #( #sn_f: #sn_b ),* }) => {
                        #( {
                            let __o: Option<Ordering> = #sn_a.partial_cmp(#sn_b);
                            match __o { Option::Some(Ordering::Equal) => {} _ => { return __o; } }
                        } )*
                        return Option::Some(Ordering::Equal);
                    } )*
                    #( (#tn( #( #tn_a ),* ), #tn( #( #tn_b ),* )) => {
                        #( {
                            let __o: Option<Ordering> = #tn_a.partial_cmp(#tn_b);
                            match __o { Option::Some(Ordering::Equal) => {} _ => { return __o; } }
                        } )*
                        return Option::Some(Ordering::Equal);
                    } )*
                    _ => { return Option::Some(Ordering::Equal); }
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}
