// logos.std.compiler.metaprog — derive(Copy).
//
// Hook for `#[derive_copy]`. Emits the marker
//
//   impl<const N: usize, T: Copy> Copy for Name<N, T> {}
//
// `Copy` is a no-method marker trait (Logos parity with Rust); the
// sema-side auto-Copy rule already requires every field to be Copy
// when an `impl Copy` lands, so the handler doesn't have to check
// field-Copy-ness explicitly. Type params get a `T: Copy` bound (Rust
// parity); const params are carried unbounded. Header: derive_shape.logos.
//
// §6.10 sub-deliverable 2/8.

package logos.std.compiler.metaprog;

use logos.mem.collections.vec;
use logos.lang.writ.anyval;

#[metaprog_handler("derive_copy")]
fn derive_copy_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: WAny = view.node_at(target_offset);
    if view.ast_node_name(item).len == (0 as u64) { return; }
    let sh: DeriveShape = derive_shape_of(&view, item);
    let nm: Ident = sh.nm;
    let tparams: Vec<Ident> = sh.tparams;
    let cparams: Vec<Ident> = sh.cparams;
    let ctypes: Vec<Ident> = sh.ctypes;
    let gargs: Vec<Ident> = sh.gargs;

    let blob: QuoteItemBlob = quote_item! {
        impl<#( const #cparams: #ctypes ),*, #( #tparams: Copy ),*> Copy for #nm<#( #gargs ),*> {}
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}
