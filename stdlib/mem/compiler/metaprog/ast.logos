// logos.std.compiler.metaprog — untyped-AST helpers for hook handlers.
//
// Writ PORT (cut-over step 4): node handles are writ `WAny` (8-byte
// self-relative; value-form holds the resolved absolute ptr), read through the
// OView primitives in oview.logos (tiny_map_get / get_str_view / array_* on
// WMap<Wu6,WAny> / WArray<WAny> / WString). The old legacy 4-byte AnyVal{raw}
// + base-relative `base + offset` model is gone.
//
// Hooks fire pre-sema: the AST is freshly parsed TinyObjectMap nodes keyed by
// integer codes from include/logos/compiler/ast.hpp. Schema keys are inlined u8s.

package logos.std.compiler.metaprog;

use logos.lang.writ.wstatic;    // WritStatic — the quote/metacall splice handle ({ptr})
use logos.lang.writ.anyval;     // WAny
use logos.lang.writ.wmap;       // WMap<Wu6,WAny> (for schema_type_code on type_from_anyval)
use logos.lang.writ.wstring;
use logos.mem.string;
use logos.lang.str;

// ── AST handle types ──────────────────────────────────────────────
//
// Typed wrappers over WAny that distinguish AST node kinds at the type level.
// `raw` is a value-form WAny Ref to the node TOM (resolve() = its absolute ptr).

/// Handle to an untyped AST item node (struct/enum/fn/... declaration).
pub struct Item {
    /// Value-form `WAny` Ref to the item's TinyObjectMap node.
    pub raw: WAny,
}

/// Type-level value handle produced by `type_of::<T>()`.
///
/// `kind` mirrors `LogosType::Kind` (Void=0, I32=1, ...); `name`/`size`/`align`/`uid`
/// are filled by the compiler when materialising a `Type` literal.
pub struct Type {
    /// Numeric `LogosType::Kind` discriminant (Void=0, I32=1, ...).
    pub kind: u32,
    /// Type name bytes (rodata-backed; empty on values decoded by `type_from_anyval`).
    pub name: &[u8],
    /// Size of the type in bytes.
    pub size: i64,
    /// Alignment of the type in bytes.
    pub align: i64,
    /// Compiler-assigned unique type id.
    pub uid: u64,
}

impl Type {
    /// Returns `true` if the kind is `Void`.
    pub fn is_void(&self) -> bool { return self.kind == (0 as u32); }
    /// Returns `true` if the kind is `Bool`.
    pub fn is_bool(&self) -> bool { return self.kind == (5 as u32); }

    /// Returns `true` for fixed-width integer kinds (i8..i128, u8..u128, incl. 24/56-bit).
    ///
    /// `usize`/`isize`/`char` are separate kinds and NOT included.
    pub fn is_integer(&self) -> bool {
        let k: u32 = self.kind;
        return k == (1 as u32)  || k == (2 as u32)  || k == (6 as u32)
            || k == (7 as u32)  || k == (8 as u32)  || k == (9 as u32)
            || k == (10 as u32) || k == (11 as u32)
            || k == (12 as u32) || k == (13 as u32)
            || k == (14 as u32) || k == (15 as u32)
            || k == (16 as u32) || k == (17 as u32);
    }

    /// Returns `true` if the kind is `F32` or `F64`.
    pub fn is_float(&self) -> bool {
        return self.kind == (3 as u32) || self.kind == (4 as u32);
    }

    /// Returns `true` for bool, float, and fixed-width integer kinds (kinds 1..=17).
    ///
    /// Excludes `Void`, `usize`/`isize`, `char`, and all compound kinds.
    pub fn is_primitive(&self) -> bool {
        let k: u32 = self.kind;
        return k == (1 as u32)  || k == (2 as u32)  || k == (3 as u32)
            || k == (4 as u32)  || k == (5 as u32)  || k == (6 as u32)
            || k == (7 as u32)  || k == (8 as u32)  || k == (9 as u32)
            || k == (10 as u32) || k == (11 as u32)
            || k == (12 as u32) || k == (13 as u32)
            || k == (14 as u32) || k == (15 as u32)
            || k == (16 as u32) || k == (17 as u32);
    }

    /// Returns `true` if the kind is `Struct` or `ZonedStruct`.
    pub fn is_struct(&self) -> bool {
        return self.kind == (22 as u32) || self.kind == (23 as u32);
    }

    /// Returns `true` if the kind is `Enum`.
    pub fn is_enum(&self)    -> bool { return self.kind == (24 as u32); }
    /// Returns `true` if the kind is `Array` (`[T; N]`).
    pub fn is_array(&self)   -> bool { return self.kind == (21 as u32); }

    /// Returns `true` if the kind is `Ptr`, `Ref`, or `MutRef`.
    pub fn is_pointer(&self) -> bool {
        let k: u32 = self.kind;
        return k == (18 as u32) || k == (19 as u32) || k == (20 as u32);
    }

    /// Returns the type's name as a borrowed `Ident`.
    pub fn ident(&self) -> Ident {
        return Ident::new(self.name);
    }
}

/// Declaration-as-data handle: a struct/enum/fn/trait/impl declaration carrying type params.
///
/// Inspection goes through `OView`.
pub struct Template {
    /// Value-form `WAny` Ref to the declaration's AST node.
    pub raw: WAny,
}

/// Creates a `Template` from a module-AST arena byte offset.
///
/// Compiler-intrinsic target: `template_of::<X>()` lowers to a call of this with
/// the resolved item's arena offset (the hook-side `OView` supplies the base).
pub fn template_of_at(off: u32) -> Template {
    let view: OView = oview_module_ast();
    // Raw-pointer anchor (the AST arena outlives the hook) — a borrow-typed
    // WAny here would dangle-flag against the local `view`.
    let p: *const u8 = view.base_ptr();
    return Template { raw: WAny::Ref((p as i64 + off as i64) as *const u8) };
}

impl Template {
    /// Returns the declaration's name (NAME key) as borrowed identifier bytes.
    pub fn name(self: &Template, view: &OView) -> Ident {
        let nm: WAny = view.tiny_map_get(self.raw, 1 as u8);  // NAME = 1
        let sv: SView = view.get_str_view(nm);
        return Ident { ptr: sv.ptr, len: sv.len };
    }

    /// Returns the number of generic type parameters (0 if none).
    pub fn type_param_count(self: &Template, view: &OView) -> u64 {
        return view.ast_type_param_count(self.raw);
    }

    /// Returns the name of the `idx`-th generic type parameter.
    pub fn type_param_name(self: &Template, view: &OView, idx: u64) -> Ident {
        let sv: SView = view.ast_type_param_name(self.raw, idx);
        return Ident { ptr: sv.ptr, len: sv.len };
    }

    /// Returns the same underlying node viewed as an `Item` (for field/variant inspection).
    pub fn body(self: &Template) -> Item {
        return Item { raw: self.raw };
    }
}

/// Zero-sized A-layer carrier for a variadic type pack.
pub struct TypeList<T...> {}

/// Borrowed identifier bytes; `ptr` borrows the source arena.
pub struct Ident {
    /// Pointer to the identifier bytes (borrowed, not owned).
    pub ptr: *const u8,
    /// Byte length.
    pub len: u64,
}

impl Copy for Ident {}

extern fn logos_metaprog_gensym(pref_ptr: *const u8, pref_len: u64,
                                out_len: *mut u64) -> *const u8;

extern fn logos_macro_arg(site_id: u64, arg_idx: u64) -> *const u8;

/// Returns a fresh hygienic identifier `<prefix>__hyg_<N>`, unique across the whole compile.
///
/// The bytes are host-owned and stay valid for the rest of the compilation.
pub fn gensym(prefix: str) -> Ident {
    let mut len: u64 = 0u64;
    let p: *const u8 = unsafe {
        logos_metaprog_gensym(prefix.as_ptr(), prefix.len() as u64,
                              &mut len as *mut u64)
    };
    return Ident { ptr: p, len: len };
}

// `QuoteItemBlob` — unchanged by the writ port (it carries rodata blob ptrs +
// packed ident/blob/cursor payloads, all *const u8 — no AnyVal).
/// Bundle returned by `quote_item! { ... }` and consumed by the compiler's item-splice path.
///
/// Carries the serialized item template plus packed ident/blob/cursor payloads.
pub struct QuoteItemBlob {
    /// Pointer to the serialized item-template blob (rodata).
    pub template_ptr: *const u8,
    /// Template blob size in bytes.
    pub template_size: u64,
    /// Null or `[u64 N][N x {ptr,len}][bytes]` payload of `$ident` substitutions.
    pub idents_blob: *const u8,
    /// Null or `[u64 N][N x {offset,size}][bytes]` payload of spliced sub-blobs.
    pub blobs_blob: *const u8,
    /// Null or packed repeat-cursor payload driving `$x...` repeat expansion.
    pub cursors_blob: *const u8,
}

/// Marker return type for quoted expressions (ABI = `WritStatic`; a single `*const u8`).
pub struct ExprBlob {
    /// `WritStatic`-shaped blob pointer.
    pub ptr: *const u8,
}

/// A blob is a borrowed view for splicing: QIB packing memcpy's the bytes and
/// nothing frees `ptr` (the buffer lives out the metaprog run), so Copy is
/// sound — one parsed fragment can splice at N sites (`#(rt)` … `#(rt)`).
impl Copy for ExprBlob {}

impl Item {
    /// Returns the item's name (NAME key) as borrowed identifier bytes.
    pub fn name(self: &Item, view: &OView) -> Ident {
        let nm: WAny = view.tiny_map_get(self.raw, 1 as u8);  // NAME = 1
        let sv: SView = view.get_str_view(nm);
        return Ident { ptr: sv.ptr, len: sv.len };
    }

    /// Returns the number of struct fields (0 if the node has no FIELDS array).
    pub fn field_count(self: &Item, view: &OView) -> u64 {
        return view.ast_struct_field_count(self.raw);
    }

    /// Returns the `idx`-th field-def node wrapped as an `Item`.
    pub fn field(self: &Item, view: &OView, idx: u64) -> Item {
        return Item { raw: view.ast_struct_field(self.raw, idx) };
    }
}

impl Ident {
    /// Borrows `s`'s bytes as an identifier. The caller keeps the backing
    /// storage (a literal, a `String`, …) alive through the splice/emission
    /// that consumes the `Ident`.
    pub static fn new(s: str) -> Ident {
        return Ident { ptr: s.as_ptr(), len: s.len() as u64 };
    }

    /// Returns `true` if the two identifiers have identical byte content.
    pub fn eq(self: &Ident, other: &Ident) -> bool {
        if self.len != other.len { return false; }
        if self.len == (0 as u64) { return true; }
        let mut i: u64 = 0 as u64;
        while i < self.len {
            unsafe {
                let pa: *const u8 = (self.ptr as i64 + i as i64) as *const u8;
                let pb: *const u8 = (other.ptr as i64 + i as i64) as *const u8;
                let a: u8 = *pa;
                let b: u8 = *pb;
                if a != b { return false; }
            }
            i = i + (1 as u64);
        }
        return true;
    }
}

// ── `<type:T>` decode (schema_type_code=107 TOM) — writ ──────────

/// Decodes a `<type:T>` node handle (`WAny` Ref to a schema-107 TOM) into a `Type`.
///
/// Returns a zero-filled `Type` if `val` is not a Ref to a schema-107 TinyObjectMap.
/// Only `kind` and `uid` are decoded; `name`/`size`/`align` stay empty/zero.
pub fn type_from_anyval(val: WAny) -> Type {
    unsafe {
        if !val.is_ref() || val.is_null() {
            return Type { kind: 0 as u32, name: "", size: 0, align: 0, uid: 0 as u64 };
        }
        let obj: *const u8 = val.resolve();
        if obj == (0 as *const u8) {
            return Type { kind: 0 as u32, name: "", size: 0, align: 0, uid: 0 as u64 };
        }
        let tom: *const WMap<Wu6, WAny> = obj as *const WMap<Wu6, WAny>;
        if (&*tom).schema_type_code() != (107 as u64) {
            return Type { kind: 0 as u32, name: "", size: 0, align: 0, uid: 0 as u64 };
        }

        let kind_av: WAny = (&*tom).get(0 as u8);
        let uid_av:  WAny = (&*tom).get(1 as u8);

        let mut kind: u32 = 0 as u32;
        if kind_av.is_pod() {
            kind = kind_av.as_u24() as u32;
        }

        let mut uid: u64 = 0 as u64;
        if uid_av.is_ref() && !uid_av.is_null() {
            // uid is a zone-boxed u64 record; resolve + read the 8-byte payload.
            let uobj: *const u64 = uid_av.resolve() as *const u64;
            uid = *uobj;
        }

        // name (key 2) intentionally left empty — synthesising a &[u8] slice with
        // stable storage from user code needs the fat-ptr-inline ABI (see the
        // legacy note); compiler-built Type literals emit name into rodata.
        return Type { kind: kind, name: "", size: 0, align: 0, uid: uid };
    }
}

// ── OView convenience accessors (writ) ─────────────────────────────────
//
// All take/return WAny node handles via the oview.logos primitives.

impl OView {
    /// Returns the node's NAME (key 1) as a string view.
    pub fn ast_node_name(self: &OView, node: WAny) -> SView {
        let nm: WAny = self.tiny_map_get(node, 1 as u8);
        return self.get_str_view(nm);
    }

    /// Returns the node's AST code (`la::Code` — e.g. ARR_TYPE=64, SLICE_TYPE=111).
    ///
    /// Read from the TOM's `schema_type_code`; 0 for a null/non-ref node.
    pub fn ast_node_code(self: &OView, node: WAny) -> u64 {
        if !node.is_ref() { return 0 as u64; }
        let p: *const u8 = node.resolve();
        if p == (0 as *const u8) { return 0 as u64; }
        return unsafe { (&*(p as *const WMap<Wu6, WAny>)).schema_type_code() };
    }

    /// Returns the TYPE (key 3) child of a field-def / type node.
    ///
    /// The element type of an array/slice, or the pointee of a ref; null `WAny` if absent.
    pub fn ast_type_child(self: &OView, node: WAny) -> WAny {
        return self.tiny_map_get(node, 3 as u8);   // TYPE = 3
    }

    /// Returns the length of the node's FIELDS (key 22) array; 0 if absent.
    pub fn ast_struct_field_count(self: &OView, node: WAny) -> u64 {
        let fields: WAny = self.tiny_map_get(node, 22 as u8);
        if fields.is_null() { return 0 as u64; }
        return self.array_len(fields);
    }

    /// Returns the `idx`-th field-def node from the node's FIELDS (key 22) array.
    pub fn ast_struct_field(self: &OView, node: WAny, idx: u64) -> WAny {
        let fields: WAny = self.tiny_map_get(node, 22 as u8);
        return self.array_get(fields, idx);
    }

    /// Returns a field-def node's NAME as a string view.
    pub fn ast_field_name(self: &OView, field_def: WAny) -> SView {
        let nm: WAny = self.tiny_map_get(field_def, 1 as u8);
        return self.get_str_view(nm);
    }

    /// Returns the NAME of a field-def's TYPE child; empty `SView` if the field has no TYPE.
    pub fn ast_field_type_name(self: &OView, field_def: WAny) -> SView {
        let ty: WAny = self.tiny_map_get(field_def, 3 as u8);   // TYPE
        if ty.is_null() {
            return SView { ptr: 0 as *const u8, len: 0 as u64 };
        }
        let nm: WAny = self.tiny_map_get(ty, 1 as u8);          // NAME
        return self.get_str_view(nm);
    }

    /// Returns the NAME of a field-def's type's FIRST type argument (`Vec<T>` → "T");
    /// empty `SView` when the type is not a generic instantiation. ARGS = key 15,
    /// items = TYPE nodes whose NAME sits at key 1 (same shape ast_field_type_name reads).
    pub fn ast_field_type_arg0_name(self: &OView, field_def: WAny) -> SView {
        let none: SView = SView { ptr: 0 as *const u8, len: 0 as u64 };
        let ty: WAny = self.tiny_map_get(field_def, 3 as u8);   // TYPE
        if ty.is_null() { return none; }
        // GENERIC_INST collects its type args as a FLAT array in ITEMS (key 2)
        // — `{ CODE: GENERIC_INST, NAME: $1, ITEMS: $... }` (logos.peg).
        let inner: WAny = self.tiny_map_get(ty, 2 as u8);       // ITEMS
        if inner.is_null() { return none; }
        if self.array_len(inner) == (0 as u64) { return none; }
        let a0: WAny = self.array_get(inner, 0 as u64);
        if a0.is_null() { return none; }
        let nm: WAny = self.tiny_map_get(a0, 1 as u8);          // NAME
        return self.get_str_view(nm);
    }

    /// Returns the node's generic type-parameter count (TYPE_PARAMS key 27); 0 if absent.
    pub fn ast_type_param_count(self: &OView, node: WAny) -> u64 {
        let tps: WAny = self.tiny_map_get(node, 27 as u8);
        if tps.is_null() { return 0 as u64; }
        let inner: WAny = self.tiny_map_get(tps, 2 as u8);  // ITEMS
        if inner.is_null() { return 0 as u64; }
        return self.array_len(inner);
    }

    /// Returns the `idx`-th generic type-parameter name; empty `SView` if the list is absent.
    pub fn ast_type_param_name(self: &OView, node: WAny, idx: u64) -> SView {
        let tps: WAny = self.tiny_map_get(node, 27 as u8);
        if tps.is_null() { return SView { ptr: 0 as *const u8, len: 0 as u64 }; }
        let inner: WAny = self.tiny_map_get(tps, 2 as u8);
        if inner.is_null() { return SView { ptr: 0 as *const u8, len: 0 as u64 }; }
        let item: WAny = self.array_get(inner, idx);
        return self.ast_node_name(item);
    }

    // ── ENUM helpers ──────────────────────────────────────────────
    /// Returns an enum node's variant count; 0 if the variant list is absent.
    pub fn ast_enum_variant_count(self: &OView, node: WAny) -> u64 {
        let outer: WAny = self.tiny_map_get(node, 2 as u8);
        if outer.is_null() { return 0 as u64; }
        let inner: WAny = self.tiny_map_get(outer, 2 as u8);
        if inner.is_null() { return 0 as u64; }
        return self.array_len(inner);
    }

    /// Returns the `idx`-th variant node of an enum node.
    pub fn ast_enum_variant(self: &OView, node: WAny, idx: u64) -> WAny {
        let outer: WAny = self.tiny_map_get(node, 2 as u8);
        let inner: WAny = self.tiny_map_get(outer, 2 as u8);
        return self.array_get(inner, idx);
    }

    /// Returns a variant node's payload arity.
    ///
    /// 0 for a unit variant; 1 for a single unwrapped payload; else the payload-list length.
    pub fn ast_variant_arity(self: &OView, variant: WAny) -> u64 {
        let outer: WAny = self.tiny_map_get(variant, 2 as u8);
        if outer.is_null() { return 0 as u64; }
        let inner: WAny = self.tiny_map_get(outer, 2 as u8);
        if inner.is_null() { return 1 as u64; }
        return self.array_len(inner);
    }

    /// Returns the first MODULE item whose NAME matches `name` byte-for-byte; null `WAny` if none.
    pub fn find_template_decl(self: &OView, name: &[u8]) -> WAny {
        let root: WAny = self.root();
        let items: WAny = self.tiny_map_get(root, 2 as u8);  // ITEMS
        if items.is_null() { return WAny::Ref(0i64 as *const u8); }
        let n: u64 = self.array_len(items);
        let nlen: i64 = name.len();
        let mut i: u64 = 0 as u64;
        while i < n {
            let item: WAny = self.array_get(items, i);
            let nm: SView = self.ast_node_name(item);
            if nm.len == (nlen as u64) {
                let mut j: i64 = 0;
                let mut eq: bool = true;
                while j < nlen {
                    unsafe {
                        let a: u8 = *((nm.ptr as i64 + j) as *const u8);
                        if a != name[j] { eq = false; }
                    }
                    j = j + (1 as i64);
                }
                if eq { return item; }
            }
            i = i + (1 as u64);
        }
        return WAny::Ref(0i64 as *const u8);
    }

    /// Returns a STRING-token literal's byte view minus the surrounding quotes; empty if absent.
    pub fn ast_lit_str_view(self: &OView, lit: WAny) -> SView {
        let s_av: WAny = self.tiny_map_get(lit, 7 as u8);   // VALUE
        let raw: SView = self.get_str_view(s_av);
        if raw.len < (2 as u64) { return SView { ptr: 0 as *const u8, len: 0 }; }
        return SView {
            ptr: (raw.ptr as i64 + 1i64) as *const u8,
            len: raw.len - (2 as u64),
        };
    }

    /// Decodes a `<type:T>` Writ value (schema-107 TOM) into a `Type` via `type_from_anyval`.
    pub fn as_type(self: &OView, val: WAny) -> Type {
        return type_from_anyval(val);
    }

    /// Appends the user-root MODULE's dotted package name (e.g. `a.b.c`) to `buf`.
    pub fn module_package_append(self: &OView, buf: &mut String) {
        let root: WAny = self.root();
        let head: SView = self.ast_node_name(root);
        if head.len == (0 as u64) { return; }
        unsafe { buf.push_bytes(head.ptr, head.len as i64); }
        let parts: WAny = self.tiny_map_get(root, 16 as u8);
        if parts.is_null() { return; }
        let n: u64 = self.array_len(parts);
        let mut i: u64 = 0 as u64;
        while i < n {
            let part: WAny = self.array_get(parts, i);
            let pn: SView = self.ast_node_name(part);
            buf.push_u8(46 as u8);  // '.'
            unsafe { buf.push_bytes(pn.ptr, pn.len as i64); }
            i = i + (1 as u64);
        }
    }
}
