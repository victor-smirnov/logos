// logos.std.compiler.metaprog — derive(Hash).
//
// Hook for `#[derive_hash]`. Emits rustc's expansion shape: an enum first
// feeds which variant it is, then every payload field in declaration order; a
// struct feeds its fields in declaration order.
//
//   impl<const N: usize, T: Hash> Hash for Name<N, T> {
//       fn hash<H: Hasher>(&self, state: &mut H) {
//           match self {
//               Self::T(__self_0) => { "T".hash(state); __self_0.hash(state); }
//               Name { x: __self_0 } => { __self_0.hash(state); }
//               …
//           }
//       }
//   }
//
// The variant is identified by its NAME (rustc feeds the discriminant as an
// `isize`; Logos has no discriminant intrinsic). Either way equal values feed
// equal streams and distinct variants distinct ones — the only contract `Hash`
// makes; the hashed bytes are not portable across implementations anyway.
// Shapes: see derive_shape.logos.

package logos.std.compiler.metaprog;

use logos.mem.collections.vec;
use logos.lang.writ.anyval;
use logos.lang.hash;

#[metaprog_handler("derive_hash")]
fn derive_hash_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: WAny = view.node_at(target_offset);
    if view.ast_node_name(item).len == (0 as u64) { return; }
    let sh: DeriveShape = derive_shape_of(&view, item);
    let nm: Ident = sh.nm;
    let tparams: Vec<Ident> = sh.tparams;
    let cparams: Vec<Ident> = sh.cparams;
    let ctypes: Vec<Ident> = sh.ctypes;
    let gargs: Vec<Ident> = sh.gargs;
    let unit_v: Vec<Ident> = sh.unit_v;
    let tup_v: Vec<Ident> = sh.tup_v;
    let tup_a: Vec<Vec<Ident>> = sh.tup_a;
    let st_v: Vec<Ident> = sh.st_v;
    let st_f: Vec<Vec<Ident>> = sh.st_f;
    let st_a: Vec<Vec<Ident>> = sh.st_a;
    let sn: Vec<Ident> = sh.sn;
    let sn_f: Vec<Vec<Ident>> = sh.sn_f;
    let sn_a: Vec<Vec<Ident>> = sh.sn_a;
    let tn: Vec<Ident> = sh.tn;
    let tn_a: Vec<Vec<Ident>> = sh.tn_a;

    let blob: QuoteItemBlob = quote_item! {
        impl<#( const #cparams: #ctypes ),*, #( #tparams: Hash ),*> Hash for #nm<#( #gargs ),*> {
            fn hash<H: Hasher>(&self, state: &mut H) {
                match self {
                    #( Self::#unit_v => { ##unit_v.hash(state); } )*
                    #( Self::#tup_v( #( #tup_a ),* ) => {
                        ##tup_v.hash(state);
                        #( #tup_a.hash(state); )*
                    } )*
                    #( Self::#st_v { #( #st_f: #st_a ),* } => {
                        ##st_v.hash(state);
                        #( #st_a.hash(state); )*
                    } )*
                    #( #sn { #( #sn_f: #sn_a ),* } => {
                        #( #sn_a.hash(state); )*
                    } )*
                    #( #tn( #( #tn_a ),* ) => {
                        #( #tn_a.hash(state); )*
                    } )*
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}
