// logos.std.compiler.metaprog — derive(Default) for plain and
// generic structs.
//
// Hook for `#[derive_default]`. Emits
//
//   impl<const N: usize, T1: Default, ...> Default for Name<N, T1, ...> {
//       fn default() -> Name<N, T1, ...> {
//           unsafe {
//               return MaybeUninit::<Name<T1, ...>>::zeroed()
//                       .assume_init();
//           }
//       }
//   }
//
// Zero-initialization model: every field is bitwise-zero. For
// POD struct types (primitives + nested POD), this matches Rust's
// per-field `Default::default()` chain — i32::default() = 0,
// bool::default() = false, etc. all yield bitwise-zero.
// Non-POD field types (Vec / Box / etc. with non-zero defaults)
// will get a zero bitmask, which differs from Rust's per-field
// init — that requires the `quote_expr` type-position antiquot
// extension (Wave 9 follow-up) to dispatch `T::default()` per
// field. Slice 1 covers the common port shape (POD structs).
//
// §6.10 sub-deliverable 7/8.

package logos.std.compiler.metaprog;

use logos.mem.collections.vec;
use logos.lang.writ.anyval;
use logos.lang.default;
use logos.mem.uninit;

#[metaprog_handler("derive_default", "logos.lang.default::Default")]
fn derive_default_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: WAny = view.node_at(target_offset);
    if view.ast_node_name(item).len == (0 as u64) { return; }
    // rustc: `#[derive(Default)]` on an enum needs a `#[default]` unit variant
    // ("no default declared"), and a variant cannot carry an attribute here —
    // so every enum is refused, as rustc refuses one without `#[default]`. The
    // zero fill below would otherwise pick whichever variant has tag 0.
    if (view.ast_node_code(item) & (0xFFFF as u64)) == (80 as u64) {
        error_at(target_offset, "#[derive_default] on an enum: no default declared (rustc needs a `#[default]` unit variant)");
        return;
    }
    let sh: DeriveShape = derive_shape_of(&view, item);
    let nm: Ident = sh.nm;
    let tparams: Vec<Ident> = sh.tparams;
    let cparams: Vec<Ident> = sh.cparams;
    let ctypes: Vec<Ident> = sh.ctypes;
    let gargs: Vec<Ident> = sh.gargs;

    let blob: QuoteItemBlob = quote_item! {
        impl<#( const #cparams: #ctypes ),*, #( #tparams: Default ),*> Default for #nm<#( #gargs ),*> {
            fn default() -> #nm<#( #gargs ),*> {
                unsafe {
                    return MaybeUninit::<#nm<#( #gargs ),*>>::zeroed().assume_init();
                }
            }
        }
    };
    unsafe { logos_emit_item_blob_subst(&blob); }
    return;
}
