// logos.std.compiler.metaprog — typed Emitter over logos_emit_source.
//
// An Emitter buffers a single Logos compilation unit (one `package
// <name>; ...` chunk) in `self.buf` and flushes it via `commit()`,
// which calls into the host's `logos_emit_source`. Multiple emits
// per hook are fine — the runtime parser wants exactly one `package`
// statement per chunk, so each item gets its own flush.
//
//   let mut em: Emitter = Emitter::new();
//   em.emit_target_pkg(&view);              // package <user-pkg>;
//   em.emit_raw("use logos.std.fmt;");
//   em.buf.push_str("pub fn marker_");      // arbitrary text
//   unsafe { em.buf.push_bytes(p, n); }
//   em.buf.push_str("() -> i32 { return 1; }");
//   em.commit();

package logos.std.compiler.metaprog;

use logos.mem.string;
use logos.lang.str;
use logos.mem.collections.vec;

extern fn logos_emit_source(src: *const u8) -> i32;

// Slice 3 of metaprog-quote: receive a complete Writ-arena snapshot
// (one module document) and splice it into the entry-file ast list.
// Slice 4's `quote_item!` will produce these bytes; for now they come
// from logos_metaprog_test_module_blob which parses an inline source.
extern fn logos_emit_item_blob(data: *const u8, size: u64) -> i32;

// Slice 5a.1: substitution variant. Reads QuoteItemBlob fields, copies
// the template into a fresh arena, replaces `NAME_VAR=idx` placeholders
// with NAME strings drawn from `idents[idx]`, then forwards to the
// regular item-blob path.
extern fn logos_emit_item_blob_subst(blob: *const QuoteItemBlob) -> i32;

// UnitGraph §1.2 — declare which compile UNIT the items emitted from here on
// belong to. A generator that knows it is producing ONE container family says
// so once, around its whole run; the build system then gets one object file per
// family, schedulable in parallel and cacheable on the family's own content
// hash. Without the declaration the items are unattributed and land in the
// module's Common unit — correct, just not independently schedulable.
//
// PAIRED. Push/pop nest, and the compiler clears the stack around every hook
// invocation, so a metaprogram that returns between them mis-attributes only
// its OWN items. `key` must be NUL-terminated (`String::c_str()`).
extern fn logos_emit_unit_push(key: *const u8);
extern fn logos_emit_unit_pop();

// QIB ident-blob lifecycle. `qib_pack_idents` snapshots the stack-local
// `[*const Ident; N]` array into a single owned heap allocation that
// travels with the QuoteItemBlob (so the QIB is safe to return through
// Vec/struct without dangling stack pointers). `qib_free_idents` releases
// that allocation; callers free after the QIB has been emitted/spliced.
// Layout written by the host:
//   [u64 N] [N × Ident{ptr,len}] [packed bytes...]
// where each Ident.ptr points into the bytes section of the same blob.
extern fn logos_qib_pack_idents(arr: *const *const Ident, n: u64) -> *const u8;
extern fn logos_qib_free_idents(blob: *const u8);

// Pack `[*const u8; N]` of ExprBlob.ptr values into an owned heap blob.
// Each input pointer points past an 8-byte length prefix; pack_blobs
// snapshots `*(p-8)` bytes so the QIB owns its blob lifetimes. Layout:
//   [u64 N] [N × {offset:u64, size:u64}] [concatenated bodies]
extern fn logos_qib_pack_blobs(arr: *const *const u8, n: u64) -> *const u8;
extern fn logos_qib_free_blobs(blob: *const u8);

// Pack `[*const Vec<Ident>; N]` into an owned heap blob. Each input is
// a pointer to a Vec<Ident>; pack reads its `ptr` and `len` and
// snapshots all idents (including their byte content). Layout:
//   [u64 N_cursors]
//   [N_cursors × {count: u64, pods_offset: u64}]
//   [pods + ident bytes...]
// Sites in the template are encoded as `NAME_VAR=int(idx | 0x40000000)`.
// `depths[i]` = nesting depth of cursor i (1 = Vec<Ident>, 2 = Vec<Vec<Ident>>
// for T2-30 nested `#(…)*`). The compiler emits this call directly.
extern fn logos_qib_pack_cursors(arr: *const *const u8, depths: *const u8, n: u64) -> *const u8;
extern fn logos_qib_free_cursors(blob: *const u8);

// Slice 5c+8: substitution + repetition shim for `quote_expr!`.
// `kind` discriminates the substitution mode:
//   0 — Ident (scalar or [Ident; N] cursor). `ptr` is a *const Ident
//       pointer-array (one slot for scalar, M slots for cursor); `count`
//       is 1 or M. The shim substitutes NAME_VAR(idx) → NAME(string)
//       and, inside REPEAT_GROUP bodies, iterates by cursor index.
//   1 — ExprBlob splice (Step 5c Option B). `ptr` aliases the blob's
//       data pointer (cast from *const u8 — past the 8-byte size
//       prefix); `count` is unused (shim reads size from `ptr - 8`)
//       and substitutes the blob's root expr in place of the
//       placeholder VAR_REF.
// Cursor (count > 1) is only meaningful for kind=0.
/// Describes one substitution binding passed to the `quote_expr!` host shim.
pub struct IdentSpan {
    /// Pointer to an `Ident` slot array (kind 0) or to `ExprBlob` data past its 8-byte
    /// size prefix (kind 1).
    pub ptr: *const Ident,
    /// Slot count at `ptr` for kind 0 (1 = scalar, M = cursor); unused for kind 1.
    pub count: u64,
    /// Substitution mode: 0 = `Ident` (scalar or cursor), 1 = `ExprBlob` splice.
    pub kind: u64,
}

extern fn logos_quote_expr_subst(tpl: *const u8, tpl_size: u64,
                                 idents_ptr: *const IdentSpan,
                                 idents_count: u64) -> *const u8;

// parse_as — reify a runtime STRING into a spliceable AST fragment (an ExprBlob
// carrying a serialized grammar-nonterminal parse). The result splices into a
// quote_item! template at the matching `#(blob)` position via the existing
// ExprBlob path: `type_param_list` → an impl/fn generics header, `type_ref` →
// any type slot. Lets an emitter keep BUILDING fragments as strings (its
// strength) while splicing them HYGIENICALLY into a structured quote — instead
// of raw push_text for the whole item. Returns an ExprBlob whose `ptr` is null
// on parse error (malformed / trailing input); the splice then fails loudly.
//   rule 0 = type_param_list ("<T: Ord + CanonCol>"); 1 = type_ref ("VecCtr<T>");
//   2 = expr ("0x1f3cu64"); 3 = wstatic_lit_type ("@{...}" → LIT_WSTATIC).
extern fn logos_parse_as(s: *const u8, len: u64, rule_id: u32) -> *const u8;

/// Parse a generics header string ("<T: Ord + CanonCol>") into a spliceable
/// `type_param_list` fragment. Splice at an impl/fn generics position: `#(gp)`.
pub fn parse_type_params(s: str) -> ExprBlob {
    return ExprBlob { ptr: unsafe { logos_parse_as(s.as_ptr(), s.len() as u64, 0u32) } };
}

/// Parse a type string ("VecCtr<T>", "i64", "&[u8]") into a spliceable
/// `type_ref` fragment. Splice at any type position: `#(ty)`.
pub fn parse_type(s: str) -> ExprBlob {
    return ExprBlob { ptr: unsafe { logos_parse_as(s.as_ptr(), s.len() as u64, 1u32) } };
}

/// Parse an expression string ("0x1f3cu64", "a + b", "Foo::bar()") into a
/// spliceable `expr` fragment. Splice at any expression position: `#(e)`. Lets
/// an emitter reify a value known only at metaprog time (e.g. a content-hash
/// integer literal) as a first-class AST node instead of raw push_text.
pub fn parse_expr(s: str) -> ExprBlob {
    return ExprBlob { ptr: unsafe { logos_parse_as(s.as_ptr(), s.len() as u64, 2u32) } };
}

/// Parse a WritStatic literal string ("@{...}") into a spliceable
/// `wstatic_lit_type` (LIT_WSTATIC) fragment for TYPE-ARG position:
/// `CtrClass<#(cfg)>`. `@{...}` is a WritStatic *value*, not a general type, so
/// it is deliberately absent from `type_ref`; this dedicated entry point reifies
/// a runtime CFG-doc string verbatim into the type-arg the demanded
/// `CtrClass<@hs>` instance requires (byte-identical @hs by construction).
pub fn parse_wstatic(s: str) -> ExprBlob {
    return ExprBlob { ptr: unsafe { logos_parse_as(s.as_ptr(), s.len() as u64, 3u32) } };
}

/// Parse a BRACED STATEMENT LIST ("{ let a = 1i64; f(a); }") into a spliceable
/// `block` fragment. Splice where a block belongs: `fn f() -> R #(body)`.
///
/// This is the entry point an EMITTER needs (ADR 0024 S5). A generated fn's
/// body can be a loop nest whose DEPTH is a runtime value — a join chain of N
/// steps — and no fixed quote template expresses that. `#( … )*` does not
/// either: a repeat produces a flat SEQUENCE, and a nest is not flat. So the
/// emitter keeps assembling the body as text, which is what it is good at, and
/// the ITEM around it becomes a real quote instead of raw push_text.
///
/// A BLOCK-rooted fragment (this, or `quote_block!`) has TWO splice positions
/// and they mean different things — the semicolon is the discriminator:
///   • `fn f() -> R #(body)`  — a BODY slot: the fragment IS the block.
///   • `#(body);` / `#body;`  — a STATEMENT slot: the fragment's statements are
///     INLINED into the enclosing block, so a run can export the bindings the
///     statements after it read. This is what makes a body a SEQUENCE of
///     runtime-many runs (a rel prelude, then one build phase per join step)
///     rather than something that can only ever be wrapped.
///   • `{ #(body); }`         — the scope, spelled. Inline is the primitive and
///     the scope is the wrapper; that way round composes, the other does not.
///
/// ⚠ Do NOT write `fn f() { #(body) }` expecting the body: with no semicolon
/// that is a tail expression, so the fragment nests a second scope and any
/// `let` inside it stops being visible to what follows.
pub fn parse_block(s: str) -> ExprBlob {
    return ExprBlob { ptr: unsafe { logos_parse_as(s.as_ptr(), s.len() as u64, 4u32) } };
}

/// Parse a PARAMETER LIST ("a: &Foo, b: i64") into a spliceable `param_list`
/// fragment. Splice inside a quoted fn's parens: `fn f(#(ps)) -> R { … }`.
///
/// With this and `parse_block`, a whole emitted fn can be a quote: generics,
/// parameters, return type and body all arrive as reified fragments and the
/// item around them is structured rather than concatenated (ADR 0024 S5).
///
/// ⚠ An EMPTY list is not expressible — `param_list` requires at least one
/// param — so a no-argument fn needs a template without the splice.
pub fn parse_params(s: str) -> ExprBlob {
    return ExprBlob { ptr: unsafe { logos_parse_as(s.as_ptr(), s.len() as u64, 5u32) } };
}

// Test fixture for Slice 3. Parses `src` (NUL-terminated) and writes the
// resulting Writ arena's base+size into out-params. The blob keepalive
// lives on the host side, valid through the rest of compilation.
extern fn logos_metaprog_test_module_blob(src: *const u8, src_len: u64,
                                          out_data: *mut *const u8,
                                          out_size: *mut u64) -> i32;

// Phase 7 diagnostics: report a structured error from a metaprog hook.
// The host attributes the message to the originating hook and fails
// compilation after the hook returns. Hooks may report multiple
// errors per invocation; all surface together.
extern fn logos_metaprog_error(msg: *const u8) -> ();
extern fn logos_metaprog_error_at(target_offset: u32, msg: *const u8) -> ();
extern fn logos_metaprog_error_located(msg: *const u8) -> ();

// Push a NUL-terminated copy of `msg` to the host diag channel.
// Allocates a small heap buffer (str isn't NUL-terminated by default).
/// Reports `msg` as a metaprog-hook error; the host fails compilation after the hook returns.
/// A hook may report several errors per invocation; all surface together.
pub fn error(msg: str) {
    let mut buf: String = String::new();
    buf.push_str(msg);
    buf.push_u8(0);
    unsafe { logos_metaprog_error(buf.as_ptr() as *const u8); }
}

// Like error(), but attributes the diag to the user-AST node at
// `target_offset` — typically the offset received by a
// #[metaprog_handler] hook. Host prefixes the message with
// <file>:<line>: read from the node's SRC_LINE field.
/// Reports `msg` ALREADY LOCATED by the caller — the host adds no site prefix.
/// For reporters that know their position better than the site does (a query
/// resolves offsets against its own text); using plain `error` there prints the
/// location twice, the coarse one first.
pub fn error_located(msg: str) {
    let mut buf: String = String::new();
    buf.push_str(msg);
    buf.push_u8(0);
    unsafe { logos_metaprog_error_located(buf.as_ptr() as *const u8); }
}

/// Reports `msg` like `error`, attributed to the user-AST node at `target_offset`.
/// The host prefixes the message with `<file>:<line>:` from the node's `SRC_LINE` field.
pub fn error_at(target_offset: u32, msg: str) {
    let mut buf: String = String::new();
    buf.push_str(msg);
    buf.push_u8(0);
    unsafe { logos_metaprog_error_at(target_offset, buf.as_ptr() as *const u8); }
}

/// Buffers one Logos compilation unit (a `package <name>; ...` chunk) for the host compiler.
/// Fill via `emit_*`/`push_*`/`tpl*` (or `buf` directly), then flush with `commit`; the host
/// parser wants exactly one `package` statement per committed chunk.
pub struct Emitter {
    /// Buffered source text of the current chunk; cleared by `commit`.
    pub buf: String,
}

impl Emitter {
    /// Creates an `Emitter` with an empty buffer.
    pub static fn new() -> Emitter {
        return Emitter { buf: String::new() };
    }

    /// Appends `src` to the buffer followed by a newline.
    pub fn emit_raw(&mut self, src: str) {
        self.buf.push_str(src);
        self.buf.push_u8(10);
    }

    // Begin a new chunk in package `pkg`: writes `package <pkg>; ` to
    // the buffer. Caller appends the rest (use decls, item source) and
    // calls commit(). Sugar so hooks don't hard-code `package main;`.
    /// Begins a new chunk by writing `package <pkg>; ` to the buffer.
    pub fn emit_into(&mut self, pkg: str) {
        self.buf.push_str("package ");
        self.buf.push_str(pkg);
        self.buf.push_str("; ");
    }

    // Same as emit_into, but the package name is auto-detected from
    // the user's root MODULE node via `view.module_package_append`.
    // Exactly what most `#[metaprog_handler]` hooks want — the synth
    // lands in the same package as the trigger.
    /// Begins a new chunk in the user's own package, read from `view`'s root MODULE node.
    pub fn emit_target_pkg(&mut self, view: &OView) {
        self.buf.push_str("package ");
        view.module_package_append(&mut self.buf);
        self.buf.push_str("; ");
    }

    // Flush buffered source to the host compiler. Idempotent in the
    // sense that the host dedupes by source-string equality, so a
    // double-commit is harmless but wasteful — Emitter clears its
    // buffer after a successful commit.
    /// Flushes buffered source to the host compiler and clears the buffer; no-op when empty.
    pub fn commit(&mut self) {
        if self.buf.len() == 0 { return; }
        self.buf.push_u8(0);
        unsafe { logos_emit_source(self.buf.as_ptr() as *const u8); }
        self.buf.clear();
    }

    // ── ergonomic shortcuts ───────────────────────────────────────────────
    //
    // Push raw text (str) without trailing newline — the difference from
    // emit_raw which adds one. Useful inside tighter expressions.
    /// Appends `s` to the buffer without a trailing newline (unlike `emit_raw`).
    pub fn push_text(&mut self, s: str) {
        self.buf.push_str(s);
    }

    // Push the bytes of a SView verbatim, hiding the unsafe push_bytes
    // ceremony that hooks otherwise repeat per AST-name reference.
    /// Appends the bytes of `v` verbatim.
    pub fn push_view(&mut self, v: SView) {
        unsafe { self.buf.push_bytes(v.ptr, v.len as i64); }
    }

    // Push a u64 in decimal — direct shortcut over self.buf.push_u64.
    /// Appends `n` in decimal.
    pub fn push_num(&mut self, n: u64) {
        self.buf.push_u64(n);
    }

    // ── string-tmpl substitution ──────────────────────────────────────
    //
    // tpl1/tpl2/tpl3 scan `tmpl` and replace `$<ident>` occurrences
    // whose ident matches one of the supplied keys with the corresponding
    // value bytes. Rules:
    //   * `$$`     → literal `$`
    //   * `$ident` known   → value bytes spliced
    //   * `$ident` unknown → left as-is (`$ident` literal)
    //   * `$<non-ident>`   → literal `$` then continue
    //
    // ident chars: [A-Za-z_][A-Za-z0-9_]*. Values are SView so they can
    // come from AST nodes directly (`view.ast_node_name(item)`); use
    // view_of_str() to bind a literal str.
    /// Renders `tmpl` into the buffer, replacing `$k1` with the bytes of `v1`.
    /// `$$` emits a literal `$`; an unmatched `$ident` passes through unchanged.
    pub fn tpl1(&mut self, tmpl: str, k1: str, v1: SView) {
        unsafe {
            tpl_render_into(&mut self.buf, tmpl,
                k1, v1,
                str_empty(), view_empty(),
                str_empty(), view_empty());
        }
    }

    /// Renders `tmpl` into the buffer, substituting two `$key` bindings; same rules as `tpl1`.
    pub fn tpl2(&mut self, tmpl: str,
                k1: str, v1: SView,
                k2: str, v2: SView) {
        unsafe {
            tpl_render_into(&mut self.buf, tmpl,
                k1, v1,
                k2, v2,
                str_empty(), view_empty());
        }
    }

    /// Renders `tmpl` into the buffer, substituting three `$key` bindings; same rules as `tpl1`.
    pub fn tpl3(&mut self, tmpl: str,
                k1: str, v1: SView,
                k2: str, v2: SView,
                k3: str, v3: SView) {
        unsafe {
            tpl_render_into(&mut self.buf, tmpl,
                k1, v1,
                k2, v2,
                k3, v3);
        }
    }
}

// Wrap a str as a SView for use as a tpl* binding value.
/// Wraps a `str` as an `SView`, e.g. to bind a literal as a `tpl*` value.
pub fn view_of_str(s: str) -> SView {
    return SView { ptr: s.as_ptr(), len: s.len() as u64 };
}

// Wrap a String as a SView (borrows the string's buffer; valid only
// while the source String is alive and unmodified).
/// Wraps a `String`'s buffer as an `SView`.
/// Borrows: the view is valid only while the source `String` is alive and unmodified.
pub fn view_of_string(s: &String) -> SView {
    return SView { ptr: s.as_ptr(), len: s.len() as u64 };
}

fn view_empty() -> SView {
    return SView { ptr: 0 as *const u8, len: 0 };
}

fn str_empty() -> str {
    return "";
}

unsafe fn bytes_eq(a: *const u8, b: *const u8, n: i64) -> bool {
    let mut i: i64 = 0;
    while i < n {
        let ca: u8 = *((a as i64 + i) as *const u8);
        let cb: u8 = *((b as i64 + i) as *const u8);
        if ca != cb { return false; }
        i = i + 1;
    }
    return true;
}

fn is_ident_start(c: u8) -> bool {
    if c >= 65u8 && c <= 90u8 { return true; }    // A..Z
    if c >= 97u8 && c <= 122u8 { return true; }   // a..z
    if c == 95u8 { return true; }                  // _
    return false;
}

fn is_ident_cont(c: u8) -> bool {
    if is_ident_start(c) { return true; }
    if c >= 48u8 && c <= 57u8 { return true; }    // 0..9
    return false;
}

unsafe fn match_key(p: *const u8, n: i64, k: str, v: SView,
                    out_buf: &mut String) -> bool {
    let kn: i64 = k.len();
    if kn != n { return false; }
    if kn == 0 { return false; }
    if !bytes_eq(p, k.as_ptr(), n) { return false; }
    out_buf.push_bytes(v.ptr, v.len as i64);
    return true;
}

// Internal: render `tmpl` into `out`, substituting up to three
// (key, value) bindings. Empty keys (k.len() == 0) are skipped.
unsafe fn tpl_render_into(out: &mut String, tmpl: str,
                          k1: str, v1: SView,
                          k2: str, v2: SView,
                          k3: str, v3: SView) {
    let p: *const u8 = tmpl.as_ptr();
    let len: i64 = tmpl.len();
    let dollar: u8 = 36u8;   // '$'
    let mut i: i64 = 0;
    while i < len {
        let c: u8 = *((p as i64 + i) as *const u8);
        if c != dollar {
            out.push_u8(c);
            i = i + 1;
            continue;
        }
        // c == '$'
        if i + 1 >= len {
            out.push_u8(dollar);
            i = i + 1;
            continue;
        }
        let c2: u8 = *((p as i64 + i + 1) as *const u8);
        if c2 == dollar {
            out.push_u8(dollar);
            i = i + 2;
            continue;
        }
        if !is_ident_start(c2) {
            out.push_u8(dollar);
            i = i + 1;
            continue;
        }
        // collect ident [i+1, j)
        let mut j: i64 = i + 1;
        while j < len {
            let cj: u8 = *((p as i64 + j) as *const u8);
            if !is_ident_cont(cj) { break; }
            j = j + 1;
        }
        let id_ptr: *const u8 = (p as i64 + i + 1) as *const u8;
        let id_len: i64 = j - (i + 1);
        let matched: bool =
            match_key(id_ptr, id_len, k1, v1, out) ||
            match_key(id_ptr, id_len, k2, v2, out) ||
            match_key(id_ptr, id_len, k3, v3, out);
        if !matched {
            out.push_u8(dollar);
            out.push_bytes(id_ptr, id_len);
        }
        i = j;
    }
}
