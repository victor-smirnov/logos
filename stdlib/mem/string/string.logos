// Logos mem-tier standard library — logos.mem.string
//
// String — owned, heap-allocated, growable byte buffer.
// Analogous to Rust's String / C++'s std::string.
//
// Always keeps a null terminator past the last byte, so as_ptr()
// returns a valid C string without extra copying.
//
// Drop: String implements Drop — backing buffer is freed automatically
// when the value goes out of scope.
//
// Usage:
//   let mut s: String = String::new();
//   s.push_str("hello, ");
//   s.push_str("world");
//   write(1, s.as_ptr(), s.len());
//
// Also defines the Display + ToString traits with primitive impls.
// Read-only `str` helpers (str_eq, str_trim, etc.) live in lang-tier
// [logos.lang.str](../../lang/str/str.logos).

package logos.mem.string;

use logos.mem.mem;
use logos.lang.drop;
use logos.lang.str;

// ── String ─────────────────────────────────────────────────────────────────

// Owned, heap-allocated, growable byte string.
// Invariant: data[nbytes] == 0 (null terminator always present when cap > 0).
pub struct String {
    data:   *mut u8,   // heap buffer (or null when cap == 0)
    nbytes: i64,       // number of content bytes (not counting null terminator)
    cap:    i64,       // allocated bytes (always > nbytes when data != null)
}

impl String {
    // Empty string, no heap allocation.
    pub static fn new() -> String {
        return String { data: 0 as *mut u8, nbytes: 0, cap: 0 };
    }

    // Empty string with pre-allocated capacity (avoids early reallocations).
    pub static fn with_capacity(cap: i64) -> String {
        let buf: *mut u8 = alloc(cap + 1);
        // Bug 5 guard: alloc can return null on OOM; writing buf[0] = 0 without
        // checking crashes. Fall back to String::new() state on OOM.
        if buf == 0 as *mut u8 {
            return String { data: 0 as *mut u8, nbytes: 0, cap: 0 };
        }
        unsafe { buf[0] = 0 as u8; }
        return String { data: buf, nbytes: 0, cap: cap };
    }

    // Copy from a null-terminated C string.
    pub static fn from_cstr(s: *const u8) -> String {
        let mut out: String = String::new();
        out.push_cstr(s);
        return out;
    }

    // Copy from a byte slice (ptr + length).
    pub static fn from_bytes(s: *const u8, n: i64) -> String {
        let mut out: String = String::new();
        out.push_bytes(s, n);
        return out;
    }

    // Copy from a `str` slice (Rust-style `String::from("...")`).
    pub static fn from(s: str) -> String {
        unsafe { return String::from_bytes(s.as_ptr(), s.len()); }
    }

    // Ensure capacity for `needed` additional bytes (+ null terminator).
    pub fn grow(&mut self, needed: i64) {
        if needed < 0 as i64 { return; }
        let required: i64 = self.nbytes + needed + 1;
        if required < 0 as i64 { return; }  // overflow guard
        if required <= self.cap + 1 {
            return;
        }
        let new_cap: i64 = (self.cap + needed + 1) * 2;
        if new_cap <= needed { return; }     // overflow guard
        if self.data == 0 as *mut u8 {
            // Bug 4 guard (alloc branch): alloc can return null on OOM.
            // Writing self.data[0] = 0 without the null check is a null-ptr dereference.
            self.data = alloc(new_cap);
            if self.data == 0 as *mut u8 { return; }
            unsafe { self.data[0] = 0 as u8; }
        } else {
            // Bug 4 guard (realloc branch): realloc returns null on OOM but does NOT
            // free the original buffer. Assigning directly would leak the original
            // pointer and corrupt self.cap. Use a temporary to preserve both on failure.
            let tmp: *mut u8 = realloc_buf(self.data, new_cap);
            if tmp == 0 as *mut u8 { return; }
            self.data = tmp;
        }
        self.cap = new_cap - 1;
    }

    // Append a single byte.
    pub fn push_u8(&mut self, c: u8) {
        self.grow(1);
        unsafe {
            self.data[self.nbytes] = c;
            self.nbytes = self.nbytes + 1;
            self.data[self.nbytes] = 0 as u8;
        }
    }

    // Append `n` bytes from `s`.
    pub fn push_bytes(&mut self, s: *const u8, n: i64) {
        // Bug 1 guard: n=0 on String::new() (data=null, cap=0) would skip grow
        // (required=1 == cap+1=1) and then write null[0]=0 — a null-ptr dereference.
        // n<0 would also underflow nbytes and corrupt the buffer.
        if n <= 0 { return; }
        self.grow(n);
        mem_copy(self.data, self.nbytes, s, n);
        self.nbytes = self.nbytes + n;
        unsafe { self.data[self.nbytes] = 0 as u8; }
    }

    // Append a null-terminated C string.
    pub fn push_cstr(&mut self, s: *const u8) {
        let n: i64 = str_len(s);
        self.push_bytes(s, n);
    }

    // Append a str slice.
    pub fn push_str(&mut self, s: str) {
        self.push_bytes(s.as_ptr(), s.len());
    }

    // Read-only pointer to the bytes. Always null-terminated.
    pub fn as_ptr(&self) -> *const u8 {
        return self.data as *const u8;
    }

    // Read-only str view of the String's bytes. Safe wrapper over
    // `str_from_raw(self.as_ptr(), self.len())` — the raw ptr is
    // guaranteed valid because it came from this String.
    pub fn as_str(&self) -> str {
        unsafe { return str_from_raw(self.data as *const u8, self.nbytes); }
    }

    // Number of content bytes (not counting null terminator).
    pub fn len(&self) -> i64 {
        return self.nbytes;
    }

    // Allocated capacity (not counting null terminator slot).
    pub fn capacity(&self) -> i64 {
        return self.cap;
    }

    // True if no bytes have been written.
    pub fn is_empty(&self) -> bool {
        return self.nbytes == 0;
    }

    // Reset length to zero, keep the allocation.
    pub fn clear(&mut self) {
        self.nbytes = 0;
        if self.data != 0 as *mut u8 {
            unsafe { self.data[0] = 0 as u8; }
        }
    }

    // Truncate length to `new_len` bytes. No-op if new_len >= current len.
    // Negative values are clamped to 0. Allocation is preserved.
    pub fn truncate(&mut self, new_len: i64) {
        if new_len < 0 as i64 { self.clear(); return; }
        if new_len >= self.nbytes { return; }
        self.nbytes = new_len;
        if self.data != 0 as *mut u8 {
            unsafe { self.data[self.nbytes] = 0 as u8; }
        }
    }

    // Ensure `reserve` spare bytes, return pointer to first spare byte.
    // Used by Display impls to write directly into the buffer.
    pub fn spare_ptr(&mut self, reserve: i64) -> *mut u8 {
        self.grow(reserve);
        unsafe {
            let p: i64 = self.data as i64 + self.nbytes;
            return p as *mut u8;
        }
    }

    // Advance the content length by `n` bytes and null-terminate.
    // Call after writing into spare_ptr().
    pub fn advance_len(&mut self, n: i64) {
        self.nbytes = self.nbytes + n;
        unsafe { self.data[self.nbytes] = 0 as u8; }
    }

    // Append the decimal representation of a signed 64-bit integer.
    pub fn push_i64(&mut self, v: i64) {
        let ptr: *mut u8 = self.spare_ptr(22);
        let n: i64 = write_i64(ptr, 0, v);
        self.advance_len(n);
    }

    // Append the decimal representation of an unsigned 64-bit integer.
    pub fn push_u64(&mut self, v: u64) {
        let ptr: *mut u8 = self.spare_ptr(22);
        let n: i64 = write_u64(ptr, 0, v);
        self.advance_len(n);
    }

    // True if the string content equals another String.
    pub fn eq_string(&self, other: &String) -> bool {
        return self.eq_cstr(other.as_ptr());
    }

    // True if the string content equals the str slice `s`.
    pub fn eq_str(&self, s: str) -> bool {
        let n: i64 = s.len();
        if self.nbytes != n { return false; }
        let sp: *const u8 = s.as_ptr();
        let mut i: i64 = 0;
        while i < n {
            unsafe {
                let ap: *const u8 = (self.data as i64 + i) as *const u8;
                let bp: *const u8 = (sp as i64 + i) as *const u8;
                if *ap != *bp { return false; }
            }
            i = i + 1;
        }
        return true;
    }

    // True if the string content equals the null-terminated C string `s`.
    pub fn eq_cstr(&self, s: *const u8) -> bool {
        let n: i64 = str_len(s);
        if self.nbytes != n { return false; }
        let mut i: i64 = 0;
        while i < n {
            unsafe {
                let ap: *const u8 = (self.data as i64 + i) as *const u8;
                let bp: *const u8 = (s as i64 + i) as *const u8;
                if *ap != *bp { return false; }
            }
            i = i + 1;
        }
        return true;
    }
}

impl Drop for String {
    fn drop(self: String) {
        if self.data != 0 as *mut u8 {
            dealloc(self.data);
        }
    }
}

// ── Display trait ──────────────────────────────────────────────────────────

// Display: convert a value to its human-readable string representation.
// Implement for types that can be formatted as text.
//
// Usage:
//   let mut s: String = String::new();
//   42.fmt(&mut s);                 // writes "42"
//   let s: String = to_string(42); // shorthand

trait Display {
    fn fmt(self: Self, buf: &mut String);
}

impl Display for i32 {
    fn fmt(self: i32, buf: &mut String) {
        let ptr: *mut u8 = buf.spare_ptr(12);
        let n: i64 = write_i32(ptr, 0, self);
        buf.advance_len(n);
    }
}

impl Display for i64 {
    fn fmt(self: i64, buf: &mut String) {
        let ptr: *mut u8 = buf.spare_ptr(22);
        let n: i64 = write_i64(ptr, 0, self);
        buf.advance_len(n);
    }
}

impl Display for bool {
    fn fmt(self: bool, buf: &mut String) {
        if self {
            buf.push_str("true");
        } else {
            buf.push_str("false");
        }
    }
}

impl Display for u64 {
    fn fmt(self: u64, buf: &mut String) {
        buf.push_u64(self);
    }
}

impl Display for u32 {
    fn fmt(self: u32, buf: &mut String) {
        buf.push_u64(self as u64);
    }
}

impl Display for u16 {
    fn fmt(self: u16, buf: &mut String) {
        buf.push_u64(self as u64);
    }
}

impl Display for u8 {
    fn fmt(self: u8, buf: &mut String) {
        buf.push_u64(self as u64);
    }
}

impl Display for i16 {
    fn fmt(self: i16, buf: &mut String) {
        let ptr: *mut u8 = buf.spare_ptr(8);
        let n: i64 = write_i32(ptr, 0, self as i32);
        buf.advance_len(n);
    }
}

impl Display for i8 {
    fn fmt(self: i8, buf: &mut String) {
        let ptr: *mut u8 = buf.spare_ptr(6);
        let n: i64 = write_i32(ptr, 0, self as i32);
        buf.advance_len(n);
    }
}

impl Display for usize {
    fn fmt(self: usize, buf: &mut String) {
        buf.push_u64(self as u64);
    }
}

impl Display for isize {
    fn fmt(self: isize, buf: &mut String) {
        let ptr: *mut u8 = buf.spare_ptr(22);
        let n: i64 = write_i64(ptr, 0, self as i64);
        buf.advance_len(n);
    }
}

// Display for null-terminated C strings.
impl Display for *const u8 {
    fn fmt(self: *const u8, buf: &mut String) {
        let n: i64 = str_len(self);
        buf.push_bytes(self, n);
    }
}

// Display for str slices.
impl Display for str {
    fn fmt(self: str, buf: &mut String) {
        buf.push_str(self);
    }
}

// ── Float Display ─────────────────────────────────────────────────────────
//
// Float-to-decimal correctness is a pile of code (Ryu / Grisu); we
// forward to libc's snprintf via fmt_native.c — same dependency
// surface as malloc/free/memcpy that the rest of stdlib already
// extern's. snprintf's "%g" gives the shortest round-trippable
// representation, which matches Rust's f64 / f32 default Display.
extern fn logos_fmt_f64_g(buf: *mut u8, cap: i32, x: f64) -> i32;
extern fn logos_fmt_f32_g(buf: *mut u8, cap: i32, x: f32) -> i32;

impl Display for f64 {
    fn fmt(self: f64, buf: &mut String) {
        let cap: i32 = 32i32;
        let ptr: *mut u8 = buf.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_g(ptr, cap, self) };
        buf.advance_len(n as i64);
    }
}

impl Display for f32 {
    fn fmt(self: f32, buf: &mut String) {
        let cap: i32 = 32i32;
        let ptr: *mut u8 = buf.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_g(ptr, cap, self) };
        buf.advance_len(n as i64);
    }
}

// ── ToString ──────────────────────────────────────────────────────────────

// Convert any Display value to an owned String.
pub fn to_string<T: Display>(val: T) -> String {
    let mut s: String = String::new();
    val.fmt(&mut s);
    return s;
}

// SL-sl-07: Rust-style `.to_string()` method form.
//
// Rust's `ToString` is auto-implemented for every `T: Display` via a
// blanket impl. We mirror that here for STRUCT receivers (the blanket
// dispatches via Logos's per-trait blanket lookup). Primitive method
// dispatch doesn't try blanket impls, so we also enumerate explicit
// `impl ToString for <prim>` per built-in type below.
//
// Method shape uses `self: Self` (by value) instead of Rust's `&self`
// because Display.fmt's existing shape is by-value — switching to
// `&self` would force every Display impl to handle both. Primitives
// are Copy so the by-value shape is fine.
pub trait ToString {
    fn to_string(self: Self) -> String;
}
impl<T: Display> ToString for T {
    fn to_string(self: T) -> String {
        let mut s: String = String::new();
        self.fmt(&mut s);
        return s;
    }
}
// Explicit primitive impls (Logos's primitive method dispatch path
// looks up `<type>__to_string` directly and doesn't try blanket impls).
impl ToString for bool { fn to_string(self: bool) -> String { let mut s: String = String::new(); self.fmt(&mut s); return s; } }
impl ToString for i8   { fn to_string(self: i8)   -> String { let mut s: String = String::new(); self.fmt(&mut s); return s; } }
impl ToString for i16  { fn to_string(self: i16)  -> String { let mut s: String = String::new(); self.fmt(&mut s); return s; } }
impl ToString for i32  { fn to_string(self: i32)  -> String { let mut s: String = String::new(); self.fmt(&mut s); return s; } }
impl ToString for i64  { fn to_string(self: i64)  -> String { let mut s: String = String::new(); self.fmt(&mut s); return s; } }
impl ToString for u8   { fn to_string(self: u8)   -> String { let mut s: String = String::new(); self.fmt(&mut s); return s; } }
impl ToString for u16  { fn to_string(self: u16)  -> String { let mut s: String = String::new(); self.fmt(&mut s); return s; } }
impl ToString for u32  { fn to_string(self: u32)  -> String { let mut s: String = String::new(); self.fmt(&mut s); return s; } }
impl ToString for u64  { fn to_string(self: u64)  -> String { let mut s: String = String::new(); self.fmt(&mut s); return s; } }
impl ToString for usize { fn to_string(self: usize) -> String { let mut s: String = String::new(); self.fmt(&mut s); return s; } }
impl ToString for isize { fn to_string(self: isize) -> String { let mut s: String = String::new(); self.fmt(&mut s); return s; } }

// ── UTF-8 helpers on String ────────────────────────────────────────────────

// Encode a Unicode codepoint as UTF-8 and append to the String.
// Invalid codepoints append U+FFFD.
impl String {
    pub fn push_char(&mut self, cp: u32) {
        self.grow(4);
        unsafe {
            let p: *mut u8 = (self.data as i64 + self.nbytes) as *mut u8;
            let n: i64 = std_utf8_encode(cp, p);
            self.nbytes = self.nbytes + n;
            self.data[self.nbytes] = 0 as u8;
        }
    }
}

// Encode one codepoint into buf, return bytes written.  Wrapper so string.logos
// does not need to import std.utf8 (which would create a cycle via str_chars).
unsafe fn std_utf8_encode(cp: u32, buf: *mut u8) -> i64 {
    if cp < 0x80 as u32 {
        buf[0] = cp as u8;
        return 1;
    }
    if cp < 0x800 as u32 {
        buf[0] = (0xC0 | (cp >> 6))  as u8;
        buf[1] = (0x80 | (cp & 0x3F)) as u8;
        return 2;
    }
    if cp < 0x10000 as u32 {
        if cp >= 0xD800 as u32 && cp <= 0xDFFF as u32 {
            buf[0] = 0xEF as u8; buf[1] = 0xBF as u8; buf[2] = 0xBD as u8;
            return 3;
        }
        buf[0] = (0xE0 | (cp >> 12))         as u8;
        buf[1] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
        buf[2] = (0x80 | (cp & 0x3F))         as u8;
        return 3;
    }
    if cp <= 0x10FFFF as u32 {
        buf[0] = (0xF0 | (cp >> 18))          as u8;
        buf[1] = (0x80 | ((cp >> 12) & 0x3F)) as u8;
        buf[2] = (0x80 | ((cp >> 6)  & 0x3F)) as u8;
        buf[3] = (0x80 | (cp & 0x3F))          as u8;
        return 4;
    }
    buf[0] = 0xEF as u8; buf[1] = 0xBF as u8; buf[2] = 0xBD as u8;
    return 3;
}
