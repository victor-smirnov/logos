// Logos mem-tier standard library — logos.mem.string
//
// String — owned, heap-allocated, growable byte buffer.
// Analogous to Rust's String / C++'s std::string.
//
// Always keeps a null terminator past the last byte, so as_ptr()
// returns a valid C string without extra copying.
//
// Drop: String implements Drop — backing buffer is freed automatically
// when the value goes out of scope.
//
// Usage:
//   let mut s: String = String::new();
//   s.push_str("hello, ");
//   s.push_str("world");
//   write(1, s.as_ptr(), s.len());
//
// Also defines the ToString trait with primitive impls. The Display
// trait (Rust-shape `fn fmt(&self, &mut Formatter) -> Result<(), Error>`)
// lives in `mem.fmt` (named `Display` pending the cross-pkg trait
// registry collision fix), with format-macro plumbing in `logos.std.fmt`.
// Read-only `str` helpers (str_eq, str_trim, etc.) live in lang-tier
// [logos.lang.str](../../lang/str/str.logos).

package logos.mem.string;

use logos.lang.mem;
use logos.lang.marker;
use logos.lang.drop;
use logos.lang.str;
use logos.lang.cmp;
use logos.lang.writ.dview;       // Datum / DView (capture into a runtime-typed container)
use logos.lang.writ.anyval;      // W_STRING

// ── String ─────────────────────────────────────────────────────────────────

/// Owned, heap-allocated, growable byte string.
/// Invariant: `data[nbytes] == 0` (null terminator always present when `cap > 0`).
pub struct String {
    data:   *mut u8,   // heap buffer (or null when cap == 0)
    nbytes: i64,       // number of content bytes (not counting null terminator)
    cap:    i64,       // allocated bytes (always > nbytes when data != null)
}

// String OWNS its heap buffer exclusively (the raw `data` ptr never
// aliases), so moving it across threads / sharing `&String` is safe —
// mirrors Rust's `unsafe impl {Send,Sync} for String`. Without these the
// auto-trait engine sees the `*mut u8` field and rejects `T: Send`.
unsafe impl Send for String {}
unsafe impl Sync for String {}

impl String {
    /// Creates an empty `String` with no heap allocation.
    pub static fn new() -> String {
        return String { data: 0 as *mut u8, nbytes: 0, cap: 0 };
    }

    /// Creates an empty `String` with capacity for `cap` content bytes.
    /// On allocation failure, returns the unallocated `String::new()` state.
    pub static fn with_capacity(cap: i64) -> String {
        let buf: *mut u8 = alloc(cap + 1);
        // Bug 5 guard: alloc can return null on OOM; writing buf[0] = 0 without
        // checking crashes. Fall back to String::new() state on OOM.
        if buf == 0 as *mut u8 {
            return String { data: 0 as *mut u8, nbytes: 0, cap: 0 };
        }
        unsafe { buf[0] = 0 as u8; }
        return String { data: buf, nbytes: 0, cap: cap };
    }

    /// Creates a `String` by copying a null-terminated C string.
    pub static fn from_cstr(s: *const u8) -> String {
        let mut out: String = String::new();
        out.push_cstr(s);
        return out;
    }

    /// Creates a `String` by copying `n` bytes from `s`.
    pub static fn from_bytes(s: *const u8, n: i64) -> String {
        let mut out: String = String::new();
        out.push_bytes(s, n);
        return out;
    }

    /// Creates a `String` by copying a `str` slice (Rust-style `String::from("...")`).
    pub static fn from(s: str) -> String {
        unsafe { return String::from_bytes(s.as_ptr(), s.len()); }
    }

    /// Ensures capacity for `needed` additional content bytes plus the null terminator.
    /// No-op (buffer and length preserved) on `needed < 0`, overflow, or allocation failure.
    pub fn grow(&mut self, needed: i64) {
        if needed < 0 as i64 { return; }
        let required: i64 = self.nbytes + needed + 1;
        if required < 0 as i64 { return; }  // overflow guard
        if required <= self.cap + 1 {
            return;
        }
        let new_cap: i64 = (self.cap + needed + 1) * 2;
        if new_cap <= needed { return; }     // overflow guard
        if self.data == 0 as *mut u8 {
            // Bug 4 guard (alloc branch): alloc can return null on OOM.
            // Writing self.data[0] = 0 without the null check is a null-ptr dereference.
            self.data = alloc(new_cap);
            if self.data == 0 as *mut u8 { return; }
            unsafe { self.data[0] = 0 as u8; }
        } else {
            // Bug 4 guard (realloc branch): realloc returns null on OOM but does NOT
            // free the original buffer. Assigning directly would leak the original
            // pointer and corrupt self.cap. Use a temporary to preserve both on failure.
            let tmp: *mut u8 = realloc_buf(self.data, new_cap);
            if tmp == 0 as *mut u8 { return; }
            self.data = tmp;
        }
        self.cap = new_cap - 1;
    }

    /// Appends a single byte.
    pub fn push_u8(&mut self, c: u8) {
        self.grow(1);
        unsafe {
            self.data[self.nbytes] = c;
            self.nbytes = self.nbytes + 1;
            self.data[self.nbytes] = 0 as u8;
        }
    }

    /// Appends `n` bytes from `s`; no-op if `n <= 0`.
    pub fn push_bytes(&mut self, s: *const u8, n: i64) {
        // Bug 1 guard: n=0 on String::new() (data=null, cap=0) would skip grow
        // (required=1 == cap+1=1) and then write null[0]=0 — a null-ptr dereference.
        // n<0 would also underflow nbytes and corrupt the buffer.
        if n <= 0 { return; }
        self.grow(n);
        mem_copy(self.data, self.nbytes, s, n);
        self.nbytes = self.nbytes + n;
        unsafe { self.data[self.nbytes] = 0 as u8; }
    }

    /// Appends a null-terminated C string.
    pub fn push_cstr(&mut self, s: *const u8) {
        let n: i64 = str_len(s);
        self.push_bytes(s, n);
    }

    /// Appends a `str` slice.
    pub fn push_str(&mut self, s: str) {
        self.push_bytes(s.as_ptr(), s.len());
    }

    /// Returns a read-only pointer to the null-terminated bytes; null if never allocated.
    pub fn as_ptr(&self) -> *const u8 {
        return self.data as *const u8;
    }

    /// Returns a read-only `str` view of the content bytes.
    // Safe wrapper over `str_from_raw(self.as_ptr(), self.len())` — the raw ptr is
    // guaranteed valid because it came from this String.
    pub fn as_str(&self) -> str {
        unsafe { return str_from_raw(self.data as *const u8, self.nbytes); }
    }

    /// Returns the number of content bytes, excluding the null terminator.
    pub fn len(&self) -> i64 {
        return self.nbytes;
    }

    /// Returns the allocated capacity in bytes, excluding the null-terminator slot.
    pub fn capacity(&self) -> i64 {
        return self.cap;
    }

    /// Returns `true` if the length is zero.
    pub fn is_empty(&self) -> bool {
        return self.nbytes == 0;
    }

    /// Resets the length to zero, keeping the allocation.
    pub fn clear(&mut self) {
        self.nbytes = 0;
        if self.data != 0 as *mut u8 {
            unsafe { self.data[0] = 0 as u8; }
        }
    }

    /// Truncates the length to `new_len` bytes; no-op if `new_len >= len()`.
    /// Negative values clamp to 0. The allocation is preserved.
    pub fn truncate(&mut self, new_len: i64) {
        if new_len < 0 as i64 { self.clear(); return; }
        if new_len >= self.nbytes { return; }
        self.nbytes = new_len;
        if self.data != 0 as *mut u8 {
            unsafe { self.data[self.nbytes] = 0 as u8; }
        }
    }

    /// Ensures `reserve` spare bytes and returns a pointer to the first spare byte.
    /// Write directly into the buffer, then call `advance_len`.
    pub fn spare_ptr(&mut self, reserve: i64) -> *mut u8 {
        self.grow(reserve);
        unsafe {
            let p: i64 = self.data as i64 + self.nbytes;
            return p as *mut u8;
        }
    }

    /// Advances the content length by `n` bytes and writes the null terminator.
    /// Call after writing into the buffer returned by `spare_ptr`.
    pub fn advance_len(&mut self, n: i64) {
        self.nbytes = self.nbytes + n;
        unsafe { self.data[self.nbytes] = 0 as u8; }
    }

    /// Appends the decimal representation of a signed 64-bit integer.
    pub fn push_i64(&mut self, v: i64) {
        let ptr: *mut u8 = self.spare_ptr(22);
        let n: i64 = write_i64(ptr, 0, v);
        self.advance_len(n);
    }

    /// Appends the decimal representation of an unsigned 64-bit integer.
    pub fn push_u64(&mut self, v: u64) {
        let ptr: *mut u8 = self.spare_ptr(22);
        let n: i64 = write_u64(ptr, 0, v);
        self.advance_len(n);
    }

    /// Returns `true` if the content bytes equal `other`'s.
    // True if the string content equals another String. Compares by length +
    // bytes directly (NOT via eq_cstr, which calls str_len on the buffer): an
    // empty String has a NULL backing buffer, so the cstr path dereferenced
    // null and SIGSEGV'd (G153-5). Length-equal-zero short-circuits before any
    // buffer access, so empty-vs-empty / empty-vs-nonempty are safe.
    pub fn eq_string(&self, other: &String) -> bool {
        if self.nbytes != other.nbytes { return false; }
        if self.nbytes == 0 { return true; }
        let mut i: i64 = 0;
        while i < self.nbytes {
            unsafe {
                let ap: *const u8 = (self.data as i64 + i) as *const u8;
                let bp: *const u8 = (other.data as i64 + i) as *const u8;
                if *ap != *bp { return false; }
            }
            i = i + 1;
        }
        return true;
    }

    /// Returns `true` if the content equals the `str` slice `s`.
    pub fn eq_str(&self, s: str) -> bool {
        let n: i64 = s.len();
        if self.nbytes != n { return false; }
        let sp: *const u8 = s.as_ptr();
        let mut i: i64 = 0;
        while i < n {
            unsafe {
                let ap: *const u8 = (self.data as i64 + i) as *const u8;
                let bp: *const u8 = (sp as i64 + i) as *const u8;
                if *ap != *bp { return false; }
            }
            i = i + 1;
        }
        return true;
    }

    /// Returns `true` if the content equals the null-terminated C string `s`.
    pub fn eq_cstr(&self, s: *const u8) -> bool {
        let n: i64 = str_len(s);
        if self.nbytes != n { return false; }
        let mut i: i64 = 0;
        while i < n {
            unsafe {
                let ap: *const u8 = (self.data as i64 + i) as *const u8;
                let bp: *const u8 = (s as i64 + i) as *const u8;
                if *ap != *bp { return false; }
            }
            i = i + 1;
        }
        return true;
    }
}

impl Drop for String {
    fn drop(self: String) {
        if self.data != 0 as *mut u8 {
            dealloc(self.data);
        }
    }
}

// ── ToString + float bridge ───────────────────────────────────────────────

// Float-to-decimal extern bridge (used by Display for f32/f64 in
// mem.fmt and by `f64`/`f32` ToString impls below). Forwards to
// libc's snprintf via fmt_native.c — same dependency surface as
// malloc/free/memcpy that the rest of stdlib already extern's.
// "%g" gives the shortest round-trippable representation, which
// matches Rust's f64 / f32 default Display.
extern fn logos_fmt_f64_g(buf: *mut u8, cap: i32, x: f64) -> i32;
extern fn logos_fmt_f32_g(buf: *mut u8, cap: i32, x: f32) -> i32;

// ── ToString ──────────────────────────────────────────────────────────────
//
// Rust-style `.to_string()` method form. Rust auto-implements
// `ToString` for every `T: Display` via a blanket impl in alloc; we
// declare the trait here in mem.string (so callers can invoke
// `.to_string()` without pulling `mem.fmt`) and provide direct
// per-primitive impls below. The auto-deriving blanket
// `impl<T: Display> ToString for T` lives in `mem.fmt` (Display
// is defined there; mem.string sits below mem.fmt in the import order).
//
// Method shape uses `self: Self` (by value) — primitives are Copy, so
// the move semantics don't bite; user types that want `&self` can
// implement ToString directly.
/// Converts a value to an owned `String` (Rust-style `.to_string()`).
/// Takes `self` by value; the blanket `impl<T: Display> ToString for T` lives in `mem.fmt`.
pub trait ToString {
    /// Returns the value's string representation.
    fn to_string(self: Self) -> String;
}

// Explicit primitive impls — Logos's primitive method dispatch looks
// up `<type>__to_string` directly and doesn't try blanket impls.
// Bodies write through String's push_i64 / push_u64 / push_str / push_bytes
// helpers — no dependency on a Display trait.
impl ToString for bool {
    fn to_string(self: bool) -> String {
        let mut s: String = String::new();
        if self { s.push_str("true"); } else { s.push_str("false"); }
        return s;
    }
}
impl ToString for i8 {
    fn to_string(self: i8) -> String {
        let mut s: String = String::new();
        s.push_i64(self as i64);
        return s;
    }
}
impl ToString for i16 {
    fn to_string(self: i16) -> String {
        let mut s: String = String::new();
        s.push_i64(self as i64);
        return s;
    }
}
impl ToString for i32 {
    fn to_string(self: i32) -> String {
        let mut s: String = String::new();
        s.push_i64(self as i64);
        return s;
    }
}
impl ToString for i64 {
    fn to_string(self: i64) -> String {
        let mut s: String = String::new();
        s.push_i64(self);
        return s;
    }
}
impl ToString for u8 {
    fn to_string(self: u8) -> String {
        let mut s: String = String::new();
        s.push_u64(self as u64);
        return s;
    }
}
impl ToString for u16 {
    fn to_string(self: u16) -> String {
        let mut s: String = String::new();
        s.push_u64(self as u64);
        return s;
    }
}
impl ToString for u32 {
    fn to_string(self: u32) -> String {
        let mut s: String = String::new();
        s.push_u64(self as u64);
        return s;
    }
}
impl ToString for u64 {
    fn to_string(self: u64) -> String {
        let mut s: String = String::new();
        s.push_u64(self);
        return s;
    }
}
impl ToString for usize {
    fn to_string(self: usize) -> String {
        let mut s: String = String::new();
        s.push_u64(self as u64);
        return s;
    }
}
impl ToString for isize {
    fn to_string(self: isize) -> String {
        let mut s: String = String::new();
        s.push_i64(self as i64);
        return s;
    }
}
impl ToString for f32 {
    fn to_string(self: f32) -> String {
        let mut s: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = s.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_g(ptr, cap, self) };
        s.advance_len(n as i64);
        return s;
    }
}
impl ToString for f64 {
    fn to_string(self: f64) -> String {
        let mut s: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = s.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_g(ptr, cap, self) };
        s.advance_len(n as i64);
        return s;
    }
}
impl ToString for str {
    fn to_string(self: str) -> String {
        let mut s: String = String::new();
        s.push_str(self);
        return s;
    }
}

// ── UTF-8 helpers on String ────────────────────────────────────────────────

// Encode a Unicode codepoint as UTF-8 and append to the String.
// Invalid codepoints append U+FFFD.
impl String {
    /// Encodes the Unicode codepoint `cp` as UTF-8 and appends it.
    /// Invalid codepoints (surrogates, above U+10FFFF) append U+FFFD.
    pub fn push_char(&mut self, cp: u32) {
        self.grow(4);
        unsafe {
            let p: *mut u8 = (self.data as i64 + self.nbytes) as *mut u8;
            let n: i64 = std_utf8_encode(cp, p);
            self.nbytes = self.nbytes + n;
            self.data[self.nbytes] = 0 as u8;
        }
    }
}

// Encode one codepoint into buf, return bytes written.  Wrapper so string.logos
// does not need to import std.utf8 (which would create a cycle via str_chars).
unsafe fn std_utf8_encode(cp: u32, buf: *mut u8) -> i64 {
    if cp < 0x80 as u32 {
        buf[0] = cp as u8;
        return 1;
    }
    if cp < 0x800 as u32 {
        buf[0] = (0xC0 | (cp >> 6))  as u8;
        buf[1] = (0x80 | (cp & 0x3F)) as u8;
        return 2;
    }
    if cp < 0x10000 as u32 {
        if cp >= 0xD800 as u32 && cp <= 0xDFFF as u32 {
            buf[0] = 0xEF as u8; buf[1] = 0xBF as u8; buf[2] = 0xBD as u8;
            return 3;
        }
        buf[0] = (0xE0 | (cp >> 12))         as u8;
        buf[1] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
        buf[2] = (0x80 | (cp & 0x3F))         as u8;
        return 3;
    }
    if cp <= 0x10FFFF as u32 {
        buf[0] = (0xF0 | (cp >> 18))          as u8;
        buf[1] = (0x80 | ((cp >> 12) & 0x3F)) as u8;
        buf[2] = (0x80 | ((cp >> 6)  & 0x3F)) as u8;
        buf[3] = (0x80 | (cp & 0x3F))          as u8;
        return 4;
    }
    buf[0] = 0xEF as u8; buf[1] = 0xBF as u8; buf[2] = 0xBD as u8;
    return 3;
}

// String total equality (Rust: `impl Eq for String`). Enables `String == String`
// and, transitively, `Option<String> == …` / `Vec<String> == …` through the
// generic `impl<T: Eq> Eq for …` blanket impls in logos.lang.cmp.
impl Eq for String {
    fn eq(self: &Self, other: &Self) -> bool {
        return self.eq_string(other);
    }
}

// Datum: present a heap String as a runtime-typed cell (datatype String,
// W_STRING). Its STORAGE form is the UTF-8 CONTENT, not the {ptr,len,cap}
// struct — so override as_datum (the default would capture the struct bytes).
// Lives here, in String's own tier, per the "impl where the type is declared"
// rule (mem depends on lang ⇒ sees Datum/DView). Lets `DView::from(&s)` /
// Buffer<DView> / Map<DView,…> accept a heap String as a key/value.
impl Datum for String {
    fn datum_tag(self: *const String) -> u64 { return W_STRING; }
    /// Captures the UTF-8 content bytes (not the `{ptr,len,cap}` struct) as a `W_STRING` view.
    fn as_datum(&self) -> DView {
        return DView::from_parts(self.as_ptr(), self.len() as u64, W_STRING, 0u64);
    }
    /// Materializes an owned `String` by copying the content bytes out of `d`.
    // READ: materialize an OWNED heap String from the stored content bytes
    // (override — the default's by-value POD read would misread the bytes as a
    // {ptr,len,cap} struct). The copy is independent of the view's source.
    fn from_datum(self: *const String, d: DView) -> String {
        return unsafe { String::from_bytes(d.obj_ptr(), d.obj_len() as i64) };
    }
}
