// Logos standard library — std.rc
//
// Rc<T> — single-thread reference-counted smart pointer.
// NOT Send: Rc contains raw *mut pointers and uses a non-atomic counter.
//
// Single allocation: the strong counter and the T value live in one
// heap block (`RcInner<T>` — like std::make_shared's control block).
// Layout:
//   strong: i32
//   val:    T
//
// `Rc<T>` is a single fat pointer over `RcInner<T>`. Cloning and
// dropping mutate the inner.strong counter; the last drop releases
// the whole block in one dealloc.

package logos.mem.rc;

use logos.lang.mem;
use logos.lang.drop;
use logos.lang.clone;

pub struct RcInner<T> {
    pub strong: i32,
    pub val:    T,
}

pub struct Rc<T> {
    inner: *mut RcInner<T>,
}

pub fn rc_new<T>(val: T) -> Rc<T> {
    let p: *mut RcInner<T> = alloc(sizeof::<RcInner<T>>()) as *mut RcInner<T>;
    unsafe {
        p.strong = 1;
        p.val    = val;
    }
    return Rc { inner: p };
}

impl<T> Rc<T> {
    pub unsafe fn get(self: *mut Rc<T>) -> *const T {
        return &self.inner.val as *const T;
    }

    pub unsafe fn get_mut(self: *mut Rc<T>) -> *mut T {
        return &mut self.inner.val as *mut T;
    }

    // Reference-returning accessors. The inner block is heap-stable
    // for the lifetime of any Rc handle, so a `&T` / `&mut T` borrowed
    // from the inner is well-defined as long as the Rc itself lives.
    // Prefer these over `get`/`get_mut` — they hand the value back as
    // a normal Logos reference instead of a raw pointer that callers
    // have to launder through `unsafe { … }` blocks.
    pub fn deref(&self) -> &T {
        unsafe { return &self.inner.val; }
    }

    pub fn deref_mut(&mut self) -> &mut T {
        unsafe { return &mut self.inner.val; }
    }

    pub unsafe fn strong_count(self: *mut Rc<T>) -> i32 {
        return self.inner.strong;
    }

    pub unsafe fn is_null(self: *mut Rc<T>) -> bool {
        return self.inner == 0 as *mut RcInner<T>;
    }

    // Increment strong count; return a second handle to the same data.
    pub unsafe fn clone_rc(self: *mut Rc<T>) -> Rc<T> {
        self.inner.strong = self.inner.strong + 1;
        return Rc { inner: self.inner };
    }

    // Same as clone_rc but with a `&mut self` signature — modern call
    // sites prefer this; raw-pointer self is kept for back-compat.
    pub fn clone_ref(&mut self) -> Rc<T> {
        unsafe {
            let p: *mut Rc<T> = self as *mut Rc<T>;
            return p.clone_rc();
        }
    }

    // Decrement strong count; when it reaches zero run T's destructor and free
    // the inner block (Rust parity — the owned value is dropped at the last Rc).
    pub unsafe fn drop_rc(self: *mut Rc<T>) {
        if self.inner == 0 as *mut RcInner<T> { return; }
        self.inner.strong = self.inner.strong - 1;
        if self.inner.strong == 0 {
            let _v: T = self.inner.val;   // move-out → fires T's Drop at scope exit
            dealloc(self.inner as *mut u8);
        }
        self.inner = 0 as *mut RcInner<T>;
    }
}

// Auto-Drop. Compiler emits a call to `Rc__drop` whenever a Rc<T>
// goes out of scope unmoved. At the last strong reference, T's destructor
// runs (the inner `val` is moved out and dropped) before the block is freed.
impl<T> Drop for Rc<T> {
    fn drop(self: Rc<T>) {
        unsafe {
            let p: *mut Rc<T> = &self as *const Rc<T> as *mut Rc<T>;
            p.drop_rc();
        }
    }
}

// Clone (Rust parity): `rc.clone()` bumps the strong count and hands back a
// second handle to the same allocation — NOT a deep copy. Mirrors clone_ref,
// but as the standard `Clone` trait so generic `T: Clone` code and `.clone()`
// dispatch uniformly (same surface as a future Box/Arc Clone).
impl<T> Clone for Rc<T> {
    fn clone(&self) -> Rc<T> {
        unsafe {
            let p: *mut Rc<T> = self as *const Rc<T> as *mut Rc<T>;
            return p.clone_rc();
        }
    }
}
