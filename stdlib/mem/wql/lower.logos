// logos.std.wql.lower — the PLAN → ALGEBRA lowering: surface query plan
// (`RQuery`, logos.std.wql.plan) → real `RExpr` algebra tree (logos.std.wql.ir).
//
// MOVED OUT of rexpr_walk (queue-2 slice I2): the lowering is a PURE IR→IR
// function over Writ schemas — no Emitter, no reflection, no metaprog — and the
// DYNAMIC interpreter (logos.std.deem, ADR 0012-queue2) reuses it verbatim at
// RUNTIME (`Query::compile`). rexpr_walk (metaprog-tainted: Emitter/error) keeps
// the STATIC emitters and imports this module; logos.std.deem imports it
// without dragging compiler hooks into a runtime link.
//
// Shapes produced (identical to the pre-move rexpr_walk Part 1):
//   simple    → RLimit?( RDistinct?( RProj( RSort?( RFilter?( RScan )), sel )))
//   join/anti → the same wrappers over a LEFT-DEEP RJoin/RAnti/REdge chain
//   aggregate → … RProj( RSort?( RFilter_having?( RAggr( … ))), sel ) …
//   find      → RProj( RFilter( RScan ), identity )
package logos.std.wql.lower;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.std.wql.ir;
use logos.std.wql.plan;
use logos.std.wql.el;         // OP_* ids — graph-path predicate synthesis
use logos.std.wql.optimize;   // make_int_lit — graph-path residuals
use logos.lang.writ.wstring;  // h.wstring — string-literal synthesis
use logos.mem.string;

// &String → borrowed str view (local copy of the codegen string_as_str shape —
// this package must stay metaprog-free).
fn lw_str(s: &String) -> str {
    return unsafe { str_from_raw(s.as_ptr(), s.len()) };
}

// A null SExpr / RExpr edge (the "absent" edge — e.g. no `where` predicate).
pub fn null_sref() -> WRef<SExpr> {
    let z: WAny = WAny::Ref(0i64 as *const u8);
    return WRef::<SExpr>::from_any(z);
}
pub fn null_rref() -> WRef<RExpr> {
    let z: WAny = WAny::Ref(0i64 as *const u8);
    return WRef::<RExpr>::from_any(z);
}

// Build an RScan leaf carrying the full source binding (self-describing IR).
pub fn make_scan(h: &Writ, src_name: str, row_ty: str, var_name: str) -> WRef<RExpr> {
    let n: RScan = h.make::<RScan>();
    n.src_name = src_name;
    n.row_ty   = row_ty;
    n.var_name = var_name;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// Wrap `input` in an RFilter over `pred`.
pub fn make_filter(h: &Writ, input: WRef<RExpr>, pred: WRef<SExpr>) -> WRef<RExpr> {
    let n: RFilter = h.make::<RFilter>();
    n.input = input;
    n.pred  = pred;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// Wrap `input` in an RProj over the projection `sel`.
pub fn make_proj(h: &Writ, input: WRef<RExpr>, sel: WRef<SExpr>) -> WRef<RExpr> {
    let n: RProj = h.make::<RProj>();
    n.input = input;
    n.sel   = sel;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// Wrap `input` in an RSort by `key` (asc; `desc` flips).
pub fn make_sort(h: &Writ, input: WRef<RExpr>, key: WRef<SExpr>, desc: bool) -> WRef<RExpr> {
    let n: RSort = h.make::<RSort>();
    n.input = input;
    n.key   = key;
    n.desc  = desc;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// Wrap `input` in an RLimit (first-n; literal or scalar-param name).
pub fn make_limit(h: &Writ, input: WRef<RExpr>, n0: i64, is_param: bool, param: str) -> WRef<RExpr> {
    let n: RLimit = h.make::<RLimit>();
    n.input    = input;
    n.n        = n0;
    n.is_param = is_param;
    n.param    = param;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// Wrap `input` in an RDistinct (dedup the projected values).
pub fn make_distinct(h: &Writ, input: WRef<RExpr>) -> WRef<RExpr> {
    let n: RDistinct = h.make::<RDistinct>();
    n.input = input;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// An IDENTITY projection selector — a bare identifier naming the loop var (the
// exact node shape the EL parser builds for a bare ident: SField, NULL base).
// `find P` lowers with this selector so the tree stays a well-formed RProj and
// the Phase-3 identity peephole recognizes it (find + const-true pred → head
// row without a filter loop).
pub fn make_ident_sel(h: &Writ, name: str) -> WRef<SExpr> {
    let n: SField = h.make::<SField>();
    n.base = null_sref();
    n.name = name;
    return WRef::<SExpr>::from_any(n.as_ref());
}

// Lower an RQSimple → RLimit?( RDistinct?( RProj( RSort?( RFilter?( RScan ) ), select ) ) ).
// Pipeline order: where → order → project → distinct → limit. RSort sits UNDER
// the projection (its key ranges over the row var); RDistinct/RLimit sit ABOVE
// it (they act on the projected values).
fn lower_simple(s: RQSimple, h: &Writ) -> WRef<RExpr> {
    let scan: WRef<RExpr> = make_scan(h, s.src_name, s.row_ty, s.var_name);
    let mut input: WRef<RExpr> = scan;
    if s.has_where {
        input = make_filter(h, input, s.where_pred);
    }
    if s.has_order {
        input = make_sort(h, input, s.order_key, s.order_desc);
    }
    let mut root: WRef<RExpr> = make_proj(h, input, s.select);
    if s.distinct {
        root = make_distinct(h, root);
    }
    if s.has_limit {
        root = make_limit(h, root, s.limit_n, s.limit_is_param, s.limit_param);
    }
    return root;
}

// Fold a join-step fan-out LEFT-DEEP onto a base input: step k wraps the
// accumulated tree in RJoin(acc, RScan_k, on_k) — or RAnti at an anti step —
// so an N-way chain is ordinary composition of the EXISTING binary algebra:
// RJoin(RJoin(RScan a, RScan b, on1), RScan c, on2).
// A TRAVERSAL step (is_edge, slice D) wraps the accumulated tree in the UNARY
// graph step REdge{input, src, base_var, path, var_name, row_ty, on, has_on,
// is_anti} — containment joins have no right scan (the source is a field path
// of an outer-bound row var, walker-validated + stamped).
pub fn fold_join_steps(input0: WRef<RExpr>, steps: RQJoinStepArr, h: &Writ) -> WRef<RExpr> {
    let mut cur: WRef<RExpr> = input0;
    let ns: i64 = steps.len();
    let mut i: i64 = 0i64;
    while i < ns {
        let st: RQJoinStep = steps.step_at(i);
        if st.is_edge {
            let n: REdge = h.make::<REdge>();
            n.input    = cur;
            n.src      = st.src_name;   // walker-stamped full expression text
            n.base_var = st.base_var;
            // Join the grammar's segment fan-out into the dotted path text
            // (self-describing IR — queue-2 re-resolves base_var + path).
            let mut pb: String = String::new();
            let segs: RQPathSegArr = st.path_arr();
            let np: i64 = segs.len();
            let mut k: i64 = 0i64;
            while k < np {
                if k > 0i64 { pb.push_str("."); }
                pb.push_str(segs.seg_at(k).name);
                k = k + 1i64;
            }
            n.path     = lw_str(&pb);
            n.var_name = st.var_name;
            n.row_ty   = st.row_ty;
            n.has_on   = st.has_on;
            n.on       = st.on;
            n.is_anti  = st.is_anti;
            cur = WRef::<RExpr>::from_any(n.as_ref());
        } else if st.is_anti {
            let right: WRef<RExpr> = make_scan(h, st.src_name, st.row_ty, st.var_name);
            let n: RAnti = h.make::<RAnti>();
            n.left = cur; n.right = right; n.on = st.on;
            // The plan's decision rides along (ADR 0024 S4) — lowering is a
            // change of representation, not of plan.
            n.jstrat = st.jstrat; n.jkey = st.jkey; n.jsel = st.jsel; n.jwhy = st.jwhy;
            cur = WRef::<RExpr>::from_any(n.as_ref());
        } else {
            let right: WRef<RExpr> = make_scan(h, st.src_name, st.row_ty, st.var_name);
            let n: RJoin = h.make::<RJoin>();
            n.left = cur; n.right = right; n.on = st.on;
            n.jstrat = st.jstrat; n.jkey = st.jkey; n.jsel = st.jsel; n.jwhy = st.jwhy;
            cur = WRef::<RExpr>::from_any(n.as_ref());
        }
        i = i + 1i64;
    }
    return cur;
}

// Lower an RQJoin → RLimit?( RDistinct?( RProj( RSort?( RFilter?( join-chain ) ), select ) ) ).
fn lower_join(j: RQJoin, h: &Writ) -> WRef<RExpr> {
    let base: WRef<RExpr> = make_scan(h, j.a_name, j.a_ty, j.x_var);
    let jn: WRef<RExpr> = fold_join_steps(base, j.steps_arr(), h);
    let mut input: WRef<RExpr> = jn;
    if j.has_where {
        input = make_filter(h, input, j.where_pred);
    }
    if j.has_order {
        input = make_sort(h, input, j.order_key, j.order_desc);
    }
    let mut root: WRef<RExpr> = make_proj(h, input, j.select);
    if j.distinct {
        root = make_distinct(h, root);
    }
    if j.has_limit {
        root = make_limit(h, root, j.limit_n, j.limit_is_param, j.limit_param);
    }
    return root;
}

// Lower an RQAggr →
//   RLimit?( RDistinct?( RProj( RSort?( RFilter_having?( RAggr( RFilter?( RScan ), key, aggSpecs ) ) ), select ) ) ).
// Each surface `RQAgg` spec is copied to a relational `RAgg` (out/fn_name/arg).
// `having` gets NO node of its own — it is an ordinary RFilter over the RAggr
// output (the predicate ranges over the group key + aggregate output names).
fn lower_aggr(g: RQAggr, h: &Writ) -> WRef<RExpr> {
    let scan: WRef<RExpr> = make_scan(h, g.a_name, g.a_ty, g.x_var);
    let mut input: WRef<RExpr> = scan;
    // Optional join steps: the aggregate ranges over the JOINED stream (the
    // same left-deep fold as the join shape; where filters ABOVE the chain).
    if g.has_steps() {
        input = fold_join_steps(input, g.steps_arr(), h);
    }
    if g.has_where {
        input = make_filter(h, input, g.where_pred);
    }
    // Copy the surface aggregate-column list → relational RAgg specs.
    let src_aggs: RQAggArr = g.aggs_arr();
    let acount: i64 = src_aggs.len();
    let mut ra: RAggArr = h.make::<RAggArr>();
    ra.set_len(acount);
    let mut i: i64 = 0i64;
    while i < acount {
        let sa: RQAgg = src_aggs.agg_at(i);
        let mut rg: RAgg = h.make::<RAgg>();
        rg.out     = sa.name;
        rg.fn_name = sa.fn_name;
        rg.has_arg = sa.has_arg;
        rg.arg     = sa.arg;
        ra.set_agg(i, rg.as_ref());
        i = i + 1i64;
    }
    let n: RAggr = h.make::<RAggr>();
    n.input = input;
    n.key   = g.key;
    n.aggs  = WRef::<RAggArr>::from_any(ra.as_ref());
    let mut top: WRef<RExpr> = WRef::<RExpr>::from_any(n.as_ref());
    if g.has_having {
        top = make_filter(h, top, g.having_pred);
    }
    if g.has_order {
        top = make_sort(h, top, g.order_key, g.order_desc);
    }
    let mut root: WRef<RExpr> = make_proj(h, top, g.select);
    if g.distinct {
        root = make_distinct(h, root);
    }
    if g.has_limit {
        root = make_limit(h, root, g.limit_n, g.limit_is_param, g.limit_param);
    }
    return root;
}

// Lower an RQFind → RProj( RFilter( RScan ), identity ) — the RFilter(RScan)
// shape with an IDENTITY projection; the single-row discipline is the SELM_FIND
// envelope mode, not an algebra node. The Phase-3 peepholes apply unchanged:
// const-false pred → empty (constant None), const-true pred → identity (head
// row, no filter loop).
fn lower_find(f: RQFind, h: &Writ) -> WRef<RExpr> {
    let scan: WRef<RExpr> = make_scan(h, f.src_name, f.row_ty, f.var_name);
    let flt: WRef<RExpr> = make_filter(h, scan, f.pred);
    return make_proj(h, flt, make_ident_sel(h, f.var_name));
}

// The lowering entry: surface PLAN → real RExpr algebra tree.

// ═══════════════════════════════════════════════════════════════════════════
// ADR 0016 M2a — GRAPH-PATH DESUGAR (plan → plan, SHARED by the static macro
// and the runtime compiler).
//
// `from g <step>* v …` over a graph source rewrites into the CLASSIC join
// chain over the generic edge relation BEFORE validation/lowering, so both
// hosts consume ordinary plans (one implementation, two binding times):
//
//   base    scan g __ga            anchored at the VIRTUAL ROOT EDGE
//                                  (__ga.parent == 0 — see writ_graph)
//   step i  join g v_i on v_i.parent == prev.child
//
// Step residuals AND into the WHERE predicate:
//   .key  → v.key == "key"      [*] → v.idx >= 0      [N] → v.idx == N
//   {k}   → v.kind == "k"       *   → (none)
// A step's BINDER names its edge row (unnamed steps get __g<i>); the LAST
// step must carry one — it is the query's row variable. `**` (descent via
// the native reach relation) is the next slice — a named error for now.
// ═══════════════════════════════════════════════════════════════════════════

// Generated step-var names (unnamed steps; the anchor scan is __ga).
fn gp_var(i: i64) -> str {
    if i == 0i64 { return "__g0"; }
    if i == 1i64 { return "__g1"; }
    if i == 2i64 { return "__g2"; }
    if i == 3i64 { return "__g3"; }
    if i == 4i64 { return "__g4"; }
    if i == 5i64 { return "__g5"; }
    if i == 6i64 { return "__g6"; }
    return "__g7";
}

// Generated reach-hop var names (one per ** step).
fn gp_rvar(i: i64) -> str {
    if i == 0i64 { return "__r0"; }
    if i == 1i64 { return "__r1"; }
    if i == 2i64 { return "__r2"; }
    if i == 3i64 { return "__r3"; }
    if i == 4i64 { return "__r4"; }
    if i == 5i64 { return "__r5"; }
    if i == 6i64 { return "__r6"; }
    return "__r7";
}

// (e1, e2) tuple projection node.
fn gp_tuple2(h: &Writ, e1: WRef<SExpr>, e2: WRef<SExpr>) -> WRef<SExpr> {
    let arr: SExprArr = h.make::<SExprArr>();
    arr.a0 = e1;
    arr.a1 = e2;
    arr.count = 2i32;
    let t: STuple = h.make::<STuple>();
    t.items = WRef::<SExprArr>::from_any(arr.as_ref());
    return WRef::<SExpr>::from_any(t.as_ref());
}

// root.fld as SField(SField(null, root), fld) — the surface spelling's IR.
fn gp_field(h: &Writ, root: str, fld: str) -> WRef<SExpr> {
    let b: SField = h.make::<SField>();
    b.base = null_sref();
    b.name = root;
    let f: SField = h.make::<SField>();
    f.base = WRef::<SExpr>::from_any(b.as_ref());
    f.name = fld;
    return WRef::<SExpr>::from_any(f.as_ref());
}

fn gp_str_lit(h: &Writ, sv: str) -> WRef<SExpr> {
    let n: SLit = h.make::<SLit>();
    n.val = WAny::from(h.wstring(sv));
    return WRef::<SExpr>::from_any(n.as_ref());
}

fn gp_bin(h: &Writ, op: i32, l: WRef<SExpr>, r: WRef<SExpr>) -> WRef<SExpr> {
    let n: SBin = h.make::<SBin>();
    n.op = op;
    n.lhs = l;
    n.rhs = r;
    return WRef::<SExpr>::from_any(n.as_ref());
}

// AND-fold with an absent accumulator.
fn gp_and(h: &Writ, acc: WRef<SExpr>, p: WRef<SExpr>) -> WRef<SExpr> {
    if acc.any().is_null() { return p; }
    return gp_bin(h, OP_AND(), acc, p);
}

// gp_build result: the chain is in `starr`; `extra` is the ANDed residual
// predicate (anchor included, never null on ok); `last` = the row var.
struct GpRes { pub ok: bool, pub extra: WRef<SExpr>, pub last: str, pub err: str }

fn gp_fail(msg: str) -> GpRes {
    return GpRes { ok: false, extra: null_sref(), last: "", err: msg };
}

// ── `**` support: the REACH relation, injected as an ORDINARY Datalog rel ───
// reach_<src>(a, b): b is a-or-any-descendant NODE of a (descendant-or-self
// over node ids). Injected into the PROGRAM on first use (found by name on
// re-use), so BOTH engines evaluate it with their existing rel machinery —
// no new evaluator code. Naive materialization (closure of the document);
// demand-driven bodies are the M6 slice.
//   rel __reach_<src>(a: i64, b: i64) {
//       from <src> e select (e.parent, e.parent);   -- self (parents)
//       from <src> e select (e.child, e.child);     -- self (children)
//       from __reach_<src> r join <src> e on e.parent == r.b
//           select (r.a, e.child);                  -- step
//   }
fn gp_mk_col(h: &Writ, nm: str) -> i64 {
    let c: RQRelCol = h.make::<RQRelCol>();
    c.name = nm;
    c.ty_name = "i64";
    return c.as_ref().raw();
}

// Build one `from <src> e select (e.<f1>, e.<f2>)` rel body.
fn gp_mk_self_body(h: &Writ, src: str, f1: str, f2: str) -> i64 {
    let b: RQSimple = h.make::<RQSimple>();
    b.src_name = src;
    b.var_name = "__re";
    b.has_where = false;
    b.select = gp_tuple2(h, gp_field(h, "__re", f1), gp_field(h, "__re", f2));
    b.sel_first = false;
    b.distinct = false;
    b.has_order = false;
    b.has_limit = false;
    b.has_result_ty = false;
    b.has_gpath = false;
    return b.as_ref().raw();
}

// Find the program's reach rel for `src`, injecting it on first use.
// Returns the rel NAME (arena-interned) or "" when the rel cap is full.
fn gp_reach_rel(prog_root: WAny, src: str, h: &Writ) -> str {
    let mut nm: String = String::new();
    nm.push_str("__reach_");
    nm.push_str(src);
    let prog: RQProgram = prog_root.view::<RQProgram>();
    // already injected? (per-program dedup by name)
    if prog.has_rels() {
        let rels0: RQRelArr = prog.rels_arr();
        let n0: i64 = rels0.len();
        let mut i0: i64 = 0i64;
        while i0 < n0 {
            if str_eq(rels0.rel_at(i0).name, lw_str(&nm)) { return rels0.rel_at(i0).name; }
            i0 = i0 + 1i64;
        }
    }
    // the rel node (name interned by the schema str-field write)
    let rel: RQRel = h.make::<RQRel>();
    rel.name = lw_str(&nm);
    let cols: RQRelColArr = h.make::<RQRelColArr>();
    let mut colsm: RQRelColArr = cols;
    colsm.set_col(0i64, WAny::ref_to(gp_mk_col(h, "a") as *const u8));
    colsm.set_col(1i64, WAny::ref_to(gp_mk_col(h, "b") as *const u8));
    colsm.set_len(2i64);
    rel.cols = WRef::<RQRelColArr>::from_any(colsm.as_ref());
    let bodies: RQBodyArr = h.make::<RQBodyArr>();
    let mut bm: RQBodyArr = bodies;
    bm.set_body(0i64, WAny::ref_to(gp_mk_self_body(h, src, "parent", "parent") as *const u8));
    bm.set_body(1i64, WAny::ref_to(gp_mk_self_body(h, src, "child", "child") as *const u8));
    // the transitive step body
    let b3: RQJoin = h.make::<RQJoin>();
    b3.a_name = rel.name;
    b3.x_var = "__rr";
    let st3: RQJoinStep = h.make::<RQJoinStep>();
    st3.is_anti = false;
    st3.is_edge = false;
    st3.has_on = true;
    st3.src_name = src;
    st3.var_name = "__re";
    st3.on = gp_bin(h, OP_EQ(), gp_field(h, "__re", "parent"), gp_field(h, "__rr", "b"));
    let sarr3: RQJoinStepArr = h.make::<RQJoinStepArr>();
    let mut sm3: RQJoinStepArr = sarr3;
    sm3.set_step(0i64, st3.as_ref());
    sm3.set_len(1i64);
    b3.steps = WRef::<RQJoinStepArr>::from_any(sm3.as_ref());
    b3.has_where = false;
    b3.select = gp_tuple2(h, gp_field(h, "__rr", "a"), gp_field(h, "__re", "child"));
    b3.sel_first = false;
    b3.distinct = false;
    b3.has_order = false;
    b3.has_limit = false;
    b3.has_result_ty = false;
    b3.has_gpath = false;
    bm.set_body(2i64, b3.as_ref());
    bm.set_len(3i64);
    rel.bodies = WRef::<RQBodyArr>::from_any(bm.as_ref());
    // append to the program (create the rel list when absent)
    let fp: RQProgram = rq_fat_program(prog_root, h);
    if !prog.has_rels() {
        let ra: RQRelArr = h.make::<RQRelArr>();
        let mut ram: RQRelArr = ra;
        ram.set_rel(0i64, rel.as_ref());
        ram.set_len(1i64);
        fp.rels = WRef::<RQRelArr>::from_any(ram.as_ref());
        return rel.name;
    }
    let rels: RQRelArr = prog.rels_arr();
    let n: i64 = rels.len();
    if n >= RQREL_MAX() { return ""; }
    let mut relsm: RQRelArr = rq_fat_rels(fp.rels.any(), h);
    relsm.set_rel(n, rel.as_ref());
    relsm.set_len(n + 1i64);
    return rel.name;
}

// Build the classic join-step chain for one gpath (into `starr`, which must
// be a FRESH fat RQJoinStepArr) + the residual predicate. `prog_root` — the
// program node (`**` injects its reach rel there on first use).
fn gp_build(src: str, gp: RQGStepArr, h: &Writ, starr: &mut RQJoinStepArr,
            prog_root: WAny) -> GpRes {
    let n: i64 = gp.len();
    if n < 1i64 { return gp_fail("wql!: a graph path needs at least one step"); }
    // anchor: the virtual root edge
    let mut extra: WRef<SExpr> = gp_bin(h, OP_EQ(),
        gp_field(h, "__ga", "parent"), make_int_lit(h, 0i64));
    let mut prev: str = "__ga";
    let mut hop: str = "";             // pending ** reach var ("" = none)
    let mut last_user: bool = false;   // the current row var is user-named
    let mut si: i64 = 0i64;            // emitted join steps
    let mut i: i64 = 0i64;
    while i < n {
        let st: RQGStep = gp.gstep_at(i);
        // {kind} is a FILTER on the CURRENT step's edge — no movement, no join.
        if st.is_kind {
            if st.has_binder {
                return gp_fail("wql!: a {kind} filter cannot carry a binder — name the step it filters instead (`from g * s {map} select …`)");
            }
            if hop.len() > 0i64 {
                return gp_fail("wql!: a {kind} filter cannot follow `**` directly — filter the stepped edge (`** * v {kind}` or `** .key v {kind}`)");
            }
            extra = gp_and(h, extra, gp_bin(h, OP_EQ(), gp_field(h, prev, "kind"), gp_str_lit(h, st.key)));
            i = i + 1i64;
            continue;
        }
        // `**` — a REACH HOP: reposition the join origin to any descendant-or-
        // self node; the FOLLOWING movement step scans from there. A binder on
        // `**` is the trailing form — an implicit `*` movement binding it.
        if st.is_desc {
            if hop.len() > 0i64 {
                return gp_fail("wql!: consecutive `**` — one descent suffices");
            }
            let rn: str = gp_reach_rel(prog_root, src, h);
            if rn.len() == 0i64 {
                return gp_fail("wql!: too many rels — `**` needs a free rel slot for its reach relation");
            }
            let rv: str = gp_rvar(i);
            let hj: RQJoinStep = h.make::<RQJoinStep>();
            hj.is_anti = false;
            hj.is_edge = false;
            hj.has_on = true;
            hj.src_name = rn;
            hj.var_name = rv;
            hj.on = gp_bin(h, OP_EQ(), gp_field(h, rv, "a"), gp_field(h, prev, "child"));
            starr.set_step(si, hj.as_ref());
            si = si + 1i64;
            if st.has_binder {
                // trailing `** v`: implicit any-step off the hop
                let v0: str = st.binder;
                let js0: RQJoinStep = h.make::<RQJoinStep>();
                js0.is_anti = false;
                js0.is_edge = false;
                js0.has_on = true;
                js0.src_name = src;
                js0.var_name = v0;
                js0.on = gp_bin(h, OP_EQ(), gp_field(h, v0, "parent"), gp_field(h, rv, "b"));
                starr.set_step(si, js0.as_ref());
                si = si + 1i64;
                prev = v0;
                last_user = true;
            } else {
                hop = rv;
            }
            i = i + 1i64;
            continue;
        }
        let v: str = if st.has_binder { st.binder } else { gp_var(i) };
        let js: RQJoinStep = h.make::<RQJoinStep>();
        js.is_anti = false;
        js.is_edge = false;
        js.has_on = true;
        js.src_name = src;
        js.var_name = v;
        if hop.len() > 0i64 {
            js.on = gp_bin(h, OP_EQ(), gp_field(h, v, "parent"), gp_field(h, hop, "b"));
            hop = "";
        } else {
            js.on = gp_bin(h, OP_EQ(), gp_field(h, v, "parent"), gp_field(h, prev, "child"));
        }
        starr.set_step(si, js.as_ref());
        si = si + 1i64;
        if st.is_key {
            extra = gp_and(h, extra, gp_bin(h, OP_EQ(), gp_field(h, v, "key"), gp_str_lit(h, st.key)));
        } else if st.is_at {
            extra = gp_and(h, extra, gp_bin(h, OP_EQ(), gp_field(h, v, "idx"), make_int_lit(h, st.idx)));
        } else if st.is_elem {
            extra = gp_and(h, extra, gp_bin(h, OP_GE(), gp_field(h, v, "idx"), make_int_lit(h, 0i64)));
        }
        prev = v;
        last_user = st.has_binder;
        i = i + 1i64;
    }
    if hop.len() > 0i64 {
        return gp_fail("wql!: `**` must be followed by a step (or carry the binder itself: `** v`)");
    }
    if si < 1i64 {
        return gp_fail("wql!: a graph path needs at least one movement step ({kind} alone only filters)");
    }
    if !last_user {
        return gp_fail("wql!: the last graph-path step must bind the row variable — `from g .a .b v select …`");
    }
    starr.set_len(si);
    return GpRes { ok: true, extra: extra, last: prev, err: "" };
}

// Desugar ONE query node. Returns the REPLACEMENT node's raw handle word
// (0 = unchanged / rewritten in place), and sets `err` on failure. The i64
// return launders arena provenance (no borrow ties to the params).
fn gp_desugar_query(qany: WAny, prog_root: WAny, h: &Writ, err: &mut String) -> i64 {
    let none: i64 = 0i64;
    let q: RQuery = qany.view::<RQuery>();
    match q {
        RQuery::Simple(s0) => {
            if !s0.has_gpath { return none; }
            let s: RQSimple = rq_fat_simple(qany, h);
            let mut sa: RQJoinStepArr = h.make::<RQJoinStepArr>();
            let res: GpRes = gp_build(s.src_name, s.gpath_arr(), h, &mut sa, prog_root);
            if !res.ok { err.push_str(res.err); return none; }
            let j: RQJoin = h.make::<RQJoin>();
            j.fn_name = s.fn_name;
            j.a_name = s.src_name;
            j.x_var = "__ga";
            j.steps = WRef::<RQJoinStepArr>::from_any(sa.as_ref());
            let mut w: WRef<SExpr> = res.extra;
            if s.has_where { w = gp_and(h, w, s.where_pred); }
            j.has_where = true;
            j.where_pred = w;
            j.select = s.select;
            j.sel_first = s.sel_first;
            j.distinct = s.distinct;
            j.has_order = s.has_order;
            j.order_key = s.order_key;
            j.order_desc = s.order_desc;
            j.has_limit = s.has_limit;
            j.limit_n = s.limit_n;
            j.limit_is_param = s.limit_is_param;
            j.limit_param = s.limit_param;
            j.has_result_ty = s.has_result_ty;
            j.result_ty = s.result_ty;
            return j.as_ref().raw();
        }
        RQuery::Join(j0) => {
            if !j0.has_gpath { return none; }
            let jo: RQJoin = rq_fat_join(qany, h);
            let mut sa: RQJoinStepArr = h.make::<RQJoinStepArr>();
            let res: GpRes = gp_build(jo.a_name, jo.gpath_arr(), h, &mut sa, prog_root);
            if !res.ok { err.push_str(res.err); return none; }
            // append the ORIGINAL classic steps after the gpath chain
            let orig: RQJoinStepArr = jo.steps_arr();
            let gn: i64 = sa.len();
            let on_: i64 = orig.len();
            if gn + on_ > RQJSTEP_MAX() {
                err.push_str("wql!: too many join steps (graph path + joins exceed the chain cap)");
                return none;
            }
            let mut k: i64 = 0i64;
            while k < on_ {
                sa.set_step(gn + k, orig.step_any(k));
                k = k + 1i64;
            }
            sa.set_len(gn + on_);
            jo.x_var = "__ga";
            jo.steps = WRef::<RQJoinStepArr>::from_any(sa.as_ref());
            let mut w2: WRef<SExpr> = res.extra;
            if jo.has_where { w2 = gp_and(h, w2, jo.where_pred); }
            jo.has_where = true;
            jo.where_pred = w2;
            jo.has_gpath = false;
            return none;   // rewritten IN PLACE (same node kind)
        }
        RQuery::Aggr(g0) => {
            if !g0.has_gpath { return none; }
            let ga: RQAggr = rq_fat_aggr(qany, h);
            let mut sa: RQJoinStepArr = h.make::<RQJoinStepArr>();
            let res: GpRes = gp_build(ga.a_name, ga.gpath_arr(), h, &mut sa, prog_root);
            if !res.ok { err.push_str(res.err); return none; }
            let gn2: i64 = sa.len();
            if !ga.steps.any().is_null() {
                let orig2: RQJoinStepArr = ga.steps_arr();
                let on2: i64 = orig2.len();
                if gn2 + on2 > RQJSTEP_MAX() {
                    err.push_str("wql!: too many join steps (graph path + joins exceed the chain cap)");
                    return none;
                }
                let mut k2: i64 = 0i64;
                while k2 < on2 {
                    sa.set_step(gn2 + k2, orig2.step_any(k2));
                    k2 = k2 + 1i64;
                }
                sa.set_len(gn2 + on2);
            }
            ga.x_var = "__ga";
            ga.steps = WRef::<RQJoinStepArr>::from_any(sa.as_ref());
            let mut w3: WRef<SExpr> = res.extra;
            if ga.has_where { w3 = gp_and(h, w3, ga.where_pred); }
            ga.has_where = true;
            ga.where_pred = w3;
            ga.has_gpath = false;
            return none;   // rewritten IN PLACE
        }
        RQuery::Find(_f) => { return none; }   // no gpath in the find grammar
    }
}

/// Desugar every graph path in the program (rel bodies + the entry query).
/// Returns false with `err` filled on a malformed path; the plan is otherwise
/// rewritten in place (entry replacement via the program's entry edge).
pub fn desugar_program_gpaths(root: WAny, h: &Writ, err: &mut String) -> bool {
    let prog: RQProgram = root.view::<RQProgram>();
    if prog.has_rels() {
        let rels: RQRelArr = prog.rels_arr();
        let nr: i64 = rels.len();
        let mut i: i64 = 0i64;
        while i < nr {
            let rel: RQRel = rels.rel_at(i);
            let bodies: RQBodyArr = rel.bodies_arr();
            let nb: i64 = bodies.len();
            let mut b: i64 = 0i64;
            while b < nb {
                let nq: i64 = gp_desugar_query(bodies.body_any(b), root, h, err);
                if err.len() > 0i64 { return false; }
                if nq != 0i64 {
                    let mut fb: RQBodyArr = rq_fat_bodies(rel.bodies.any(), h);
                    fb.set_body(b, WAny::ref_to(nq as *const u8));
                }
                b = b + 1i64;
            }
            i = i + 1i64;
        }
    }
    let ne: i64 = gp_desugar_query(prog.entry_any(), root, h, err);
    if err.len() > 0i64 { return false; }
    if ne != 0i64 {
        let mut fp: RQProgram = rq_fat_program(root, h);
        fp.entry = WRef::<RQuery>::from_any(WAny::ref_to(ne as *const u8));
    }
    return true;
}

pub fn lower_rquery_to_rexpr(plan: RQuery, h: &Writ) -> WRef<RExpr> {
    match plan {
        RQuery::Simple(s) => { return lower_simple(s, h); }
        RQuery::Join(j)   => { return lower_join(j, h); }
        RQuery::Aggr(g)   => { return lower_aggr(g, h); }
        RQuery::Find(f)   => { return lower_find(f, h); }
    }
}

// ── Mapping fusion (ADR 0016 M2b-2): source-param rename ──────────────────────
// A mapping's rel bodies reference the mapping's OWN source param (`from w …`).
// When those rels are spliced into a consumer program (`deem!(g: Services)`),
// the source must become the CONSUMER's param. The compiler prepends the
// mapping's rels and hands the handler `old=new@lo-hi;` — this pass rewrites
// `src_name`/`a_name` == old → new across rels [lo, hi) ONLY (a consumer rel
// or another mapping's rel may legitimately use the old name for its own
// source). Runs BEFORE the gpath desugar, so injected `__reach_*` rels are
// derived from the NEW name and need no renaming of their own. Writes go
// through fat views, so the new name is interned into `h` — after this pass
// the plan is byte-for-byte what the user would have written by hand.
fn rn_step_arr(sa: WAny, old: str, new_name: str, h: &Writ) {
    if sa.is_null() { return; }
    let steps: RQJoinStepArr = sa.view::<RQJoinStepArr>();
    let n: i64 = steps.len();
    let mut i: i64 = 0i64;
    while i < n {
        let st0: RQJoinStep = steps.step_at(i);
        // Edge steps traverse a bound var's field path — no source name.
        if !st0.is_edge && str_eq(st0.src_name, old) {
            let st: RQJoinStep = rq_fat_step(steps.step_any(i), h);
            st.src_name = new_name;
        }
        i = i + 1i64;
    }
}

fn rn_query(qany: WAny, old: str, new_name: str, h: &Writ) {
    let q: RQuery = qany.view::<RQuery>();
    match q {
        RQuery::Simple(s0) => {
            if str_eq(s0.src_name, old) {
                let s: RQSimple = rq_fat_simple(qany, h);
                s.src_name = new_name;
            }
        }
        RQuery::Join(j0) => {
            if str_eq(j0.a_name, old) {
                let j: RQJoin = rq_fat_join(qany, h);
                j.a_name = new_name;
            }
            rn_step_arr(j0.steps.any(), old, new_name, h);
        }
        RQuery::Aggr(g0) => {
            if str_eq(g0.a_name, old) {
                let g: RQAggr = rq_fat_aggr(qany, h);
                g.a_name = new_name;
            }
            if g0.has_steps() { rn_step_arr(g0.steps.any(), old, new_name, h); }
        }
        RQuery::Find(f0) => {
            if str_eq(f0.src_name, old) {
                let f: RQFind = rq_fat_find(qany, h);
                f.src_name = new_name;
            }
        }
    }
}

/// Rename source `old` → `new_name` inside the bodies of rels [lo, hi).
pub fn rename_rel_sources(root: WAny, lo: i64, hi: i64,
                          old: str, new_name: str, h: &Writ) {
    if str_eq(old, new_name) { return; }
    let prog: RQProgram = root.view::<RQProgram>();
    if !prog.has_rels() { return; }
    let rels: RQRelArr = prog.rels_arr();
    let n: i64 = rels.len();
    let mut i: i64 = lo;
    while i < hi && i < n {
        let rel: RQRel = rels.rel_at(i);
        let bodies: RQBodyArr = rel.bodies_arr();
        let nb: i64 = bodies.len();
        let mut b: i64 = 0i64;
        while b < nb {
            rn_query(bodies.body_any(b), old, new_name, h);
            b = b + 1i64;
        }
        i = i + 1i64;
    }
}
