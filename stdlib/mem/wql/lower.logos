// logos.std.wql.lower — the PLAN → ALGEBRA lowering: surface query plan
// (`RQuery`, logos.std.wql.plan) → real `RExpr` algebra tree (logos.std.wql.ir).
//
// MOVED OUT of rexpr_walk (queue-2 slice I2): the lowering is a PURE IR→IR
// function over Writ schemas — no Emitter, no reflection, no metaprog — and the
// DYNAMIC interpreter (logos.std.deem, ADR 0012-queue2) reuses it verbatim at
// RUNTIME (`Query::compile`). rexpr_walk (metaprog-tainted: Emitter/error) keeps
// the STATIC emitters and imports this module; logos.std.deem imports it
// without dragging compiler hooks into a runtime link.
//
// Shapes produced (identical to the pre-move rexpr_walk Part 1):
//   simple    → RLimit?( RDistinct?( RProj( RSort?( RFilter?( RScan )), sel )))
//   join/anti → the same wrappers over a LEFT-DEEP RJoin/RAnti/REdge chain
//   aggregate → … RProj( RSort?( RFilter_having?( RAggr( … ))), sel ) …
//   find      → RProj( RFilter( RScan ), identity )
package logos.std.wql.lower;

use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.std.wql.ir;
use logos.std.wql.plan;
use logos.std.wql.el;         // OP_* ids — graph-path predicate synthesis
use logos.std.wql.optimize;   // make_int_lit — graph-path residuals
use logos.std.wql.oracle_rt;  // wql_oracle_* — what an oracle build's facade calls (loaded here, like unit)
use logos.std.wql.unit;       // wql_unit_rows — the `__unit` materializer a fact's chunk calls; imported here so every
                              // deem user loads the package (UNIT_NATSPEC names it)
use logos.std.wql.params;     // MacroParams::is_scalar — which bare names may seed a demand
use logos.std.wql.why;        // MS_* — the demand rewrite's decision vocabulary
use logos.std.wql.writ_graph; // WG_ROOT_PARENT — the graph-path anchor compares
                              // against the coordinate the producers emit
use logos.lang.writ.wstring;  // h.wstring — string-literal synthesis
use logos.mem.string;

// &String → borrowed str view (local copy of the codegen string_as_str shape —
// this package must stay metaprog-free).
fn lw_str(s: &String) -> str {
    return unsafe { str_from_raw(s.as_ptr(), s.len()) };
}

// A null SExpr / RExpr edge (the "absent" edge — e.g. no `where` predicate).
pub fn null_sref() -> WRef<SExpr> {
    let z: WAny = WAny::null();
    return WRef::<SExpr>::from_any(z);
}
pub fn null_rref() -> WRef<RExpr> {
    let z: WAny = WAny::null();
    return WRef::<RExpr>::from_any(z);
}

// Build an RScan leaf carrying the full source binding (self-describing IR).
pub fn make_scan(h: &Writ, src_name: str, row_ty: str, var_name: str) -> WRef<RExpr> {
    let n: RScan = h.make::<RScan>();
    n.src_name = src_name;
    n.row_ty   = row_ty;
    n.var_name = var_name;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// Wrap `input` in an RFilter over `pred`.
pub fn make_filter(h: &Writ, input: WRef<RExpr>, pred: WRef<SExpr>) -> WRef<RExpr> {
    let n: RFilter = h.make::<RFilter>();
    n.input = input;
    n.pred  = pred;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// Wrap `input` in an RProj over the projection `sel`.
pub fn make_proj(h: &Writ, input: WRef<RExpr>, sel: WRef<SExpr>) -> WRef<RExpr> {
    let n: RProj = h.make::<RProj>();
    n.input = input;
    n.sel   = sel;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// Wrap `input` in an RSort by `key` (asc; `desc` flips).
pub fn make_sort(h: &Writ, input: WRef<RExpr>, key: WRef<SExpr>, desc: bool) -> WRef<RExpr> {
    let n: RSort = h.make::<RSort>();
    n.input = input;
    n.key   = key;
    n.desc  = desc;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// Wrap `input` in an RLimit (first-n; literal or scalar-param name).
pub fn make_limit(h: &Writ, input: WRef<RExpr>, n0: i64, is_param: bool, param: str) -> WRef<RExpr> {
    let n: RLimit = h.make::<RLimit>();
    n.input    = input;
    n.n        = n0;
    n.is_param = is_param;
    n.param    = param;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// Wrap `input` in an RDistinct (dedup the projected values).
pub fn make_distinct(h: &Writ, input: WRef<RExpr>) -> WRef<RExpr> {
    let n: RDistinct = h.make::<RDistinct>();
    n.input = input;
    return WRef::<RExpr>::from_any(n.as_ref());
}

// An IDENTITY projection selector — a bare identifier naming the loop var (the
// exact node shape the EL parser builds for a bare ident: SField, NULL base).
// `find P` lowers with this selector so the tree stays a well-formed RProj and
// the Phase-3 identity peephole recognizes it (find + const-true pred → head
// row without a filter loop).
pub fn make_ident_sel(h: &Writ, name: str) -> WRef<SExpr> {
    let n: SField = h.make::<SField>();
    n.base = null_sref();
    n.name = name;
    return WRef::<SExpr>::from_any(n.as_ref());
}

// Lower an RQSimple → RLimit?( RDistinct?( RProj( RSort?( RFilter?( RScan ) ), select ) ) ).
// Pipeline order: where → order → project → distinct → limit. RSort sits UNDER
// the projection (its key ranges over the row var); RDistinct/RLimit sit ABOVE
// it (they act on the projected values).

// Fold a join-step fan-out LEFT-DEEP onto a base input: step k wraps the
// accumulated tree in RJoin(acc, RScan_k, on_k) — or RAnti at an anti step —
// so an N-way chain is ordinary composition of the EXISTING binary algebra:
// RJoin(RJoin(RScan a, RScan b, on1), RScan c, on2).
// A TRAVERSAL step (is_edge, slice D) wraps the accumulated tree in the UNARY
// graph step REdge{input, src, base_var, path, var_name, row_ty, on, has_on,
// is_anti} — containment joins have no right scan (the source is a field path
// of an outer-bound row var, walker-validated + stamped).
pub fn fold_join_steps(input0: WRef<RExpr>, steps: RQJoinStepArr, h: &Writ) -> WRef<RExpr> {
    let mut cur: WRef<RExpr> = input0;
    let ns: i64 = steps.len();
    let mut i: i64 = 0i64;
    while i < ns {
        let st: RQJoinStep = steps.step_at(i);
        if st.is_edge {
            let n: REdge = h.make::<REdge>();
            n.input    = cur;
            n.src      = st.src_name;   // walker-stamped full expression text
            n.base_var = st.base_var;
            // Join the grammar's segment fan-out into the dotted path text
            // (self-describing IR — queue-2 re-resolves base_var + path).
            let mut pb: String = String::new();
            let segs: RQPathSegArr = st.path_arr();
            let np: i64 = segs.len();
            let mut k: i64 = 0i64;
            while k < np {
                if k > 0i64 { pb.push_str("."); }
                pb.push_str(segs.seg_at(k).name);
                k = k + 1i64;
            }
            n.path     = lw_str(&pb);
            n.var_name = st.var_name;
            n.row_ty   = st.row_ty;
            n.has_on   = st.has_on;
            n.on       = st.on;
            n.is_anti  = st.is_anti;
            cur = WRef::<RExpr>::from_any(n.as_ref());
        } else if st.is_anti {
            let right: WRef<RExpr> = make_scan(h, st.src_name, st.row_ty, st.var_name);
            let n: RAnti = h.make::<RAnti>();
            n.left = cur; n.right = right; n.on = st.on;
            // The plan's decision rides along (ADR 0024 S4) — lowering is a
            // change of representation, not of plan.
            n.jstrat = st.jstrat; n.jsel = st.jsel; n.jground = st.jground;
            cur = WRef::<RExpr>::from_any(n.as_ref());
        } else {
            let right: WRef<RExpr> = make_scan(h, st.src_name, st.row_ty, st.var_name);
            let n: RJoin = h.make::<RJoin>();
            n.left = cur; n.right = right; n.on = st.on;
            n.jstrat = st.jstrat; n.jsel = st.jsel; n.jground = st.jground;
            cur = WRef::<RExpr>::from_any(n.as_ref());
        }
        i = i + 1i64;
    }
    return cur;
}

// Lower an RQJoin → RLimit?( RDistinct?( RProj( RSort?( RFilter?( join-chain ) ), select ) ) ).

// Lower an RQAggr →
//   RLimit?( RDistinct?( RProj( RSort?( RFilter_having?( RAggr( RFilter?( RScan ), key, aggSpecs ) ) ), select ) ) ).
// Each surface `RQAgg` spec is copied to a relational `RAgg` (out/fn_name/arg).
// `having` gets NO node of its own — it is an ordinary RFilter over the RAggr
// output (the predicate ranges over the group key + aggregate output names).
fn lower_aggr(g: RQAggr, h: &Writ) -> WRef<RExpr> {
    let scan: WRef<RExpr> = make_scan(h, g.a_name, g.a_ty, g.x_var);
    let mut input: WRef<RExpr> = scan;
    // Optional join steps: the aggregate ranges over the JOINED stream (the
    // same left-deep fold as the join shape; where filters ABOVE the chain).
    if g.has_steps() {
        input = fold_join_steps(input, g.steps_arr(), h);
    }
    if g.has_where {
        input = make_filter(h, input, g.where_pred);
    }
    // Copy the surface aggregate-column list → relational RAgg specs.
    let src_aggs: RQAggArr = g.aggs_arr();
    let acount: i64 = src_aggs.len();
    let mut ra: RAggArr = h.make::<RAggArr>();
    ra.set_len(acount);
    let mut i: i64 = 0i64;
    while i < acount {
        let sa: RQAgg = src_aggs.agg_at(i);
        let mut rg: RAgg = h.make::<RAgg>();
        rg.out     = sa.name;
        rg.fn_name = sa.fn_name;
        rg.has_arg = sa.has_arg;
        rg.arg     = sa.arg;
        ra.set_agg(i, rg.as_ref());
        i = i + 1i64;
    }
    let n: RAggr = h.make::<RAggr>();
    n.input = input;
    n.key   = g.key;
    n.aggs  = WRef::<RAggArr>::from_any(ra.as_ref());
    let mut top: WRef<RExpr> = WRef::<RExpr>::from_any(n.as_ref());
    if g.has_having {
        top = make_filter(h, top, g.having_pred);
    }
    if g.has_order {
        top = make_sort(h, top, g.order_key, g.order_desc);
    }
    let mut root: WRef<RExpr> = make_proj(h, top, g.select);
    if g.distinct {
        root = make_distinct(h, root);
    }
    if g.has_limit {
        root = make_limit(h, root, g.limit_n, g.limit_is_param, g.limit_param);
    }
    return root;
}

// Lower an RQFind → RProj( RFilter( RScan ), identity ) — the RFilter(RScan)
// shape with an IDENTITY projection; the single-row discipline is the SELM_FIND
// envelope mode, not an algebra node. The Phase-3 peepholes apply unchanged:
// const-false pred → empty (constant None), const-true pred → identity (head
// row, no filter loop).

// The lowering entry: surface PLAN → real RExpr algebra tree.

// ═══════════════════════════════════════════════════════════════════════════
// ADR 0016 M2a — GRAPH-PATH DESUGAR (plan → plan, SHARED by the static macro
// and the runtime compiler).
//
// `from g <step>* v …` over a graph source rewrites into the CLASSIC join
// chain over the generic edge relation BEFORE validation/lowering, so both
// hosts consume ordinary plans (one implementation, two binding times):
//
//   base    scan g __ga            anchored at the VIRTUAL ROOT EDGE
//                                  (__ga.parent == 0 — see writ_graph)
//   step i  join g v_i on v_i.parent == prev.child
//
// Step residuals AND into the WHERE predicate:
//   .key  → v.key == "key"      [*] → v.idx >= 0      [N] → v.idx == N
//   {k}   → v.kind == "k"       *   → (none)
// A step's BINDER names its edge row (unnamed steps get __g<i>); the LAST
// step must carry one — it is the query's row variable. `**` is a hop
// through the injected, demand-driven reach relation (below).
// ═══════════════════════════════════════════════════════════════════════════

// Generated step-var names (unnamed steps; the anchor scan is __ga).
fn gp_var(i: i64) -> str {
    if i == 0i64 { return "__g0"; }
    if i == 1i64 { return "__g1"; }
    if i == 2i64 { return "__g2"; }
    if i == 3i64 { return "__g3"; }
    if i == 4i64 { return "__g4"; }
    if i == 5i64 { return "__g5"; }
    if i == 6i64 { return "__g6"; }
    return "__g7";
}

// Generated reach-hop var names (one per ** step).
fn gp_rvar(i: i64) -> str {
    if i == 0i64 { return "__r0"; }
    if i == 1i64 { return "__r1"; }
    if i == 2i64 { return "__r2"; }
    if i == 3i64 { return "__r3"; }
    if i == 4i64 { return "__r4"; }
    if i == 5i64 { return "__r5"; }
    if i == 6i64 { return "__r6"; }
    return "__r7";
}

// (e1, e2) tuple projection node.
fn gp_tuple2(h: &Writ, e1: WRef<SExpr>, e2: WRef<SExpr>) -> WRef<SExpr> {
    let mut arr: SExprArr = h.make::<SExprArr>();
    arr.set_arg(0i64, e1.any());
    arr.set_arg(1i64, e2.any());
    arr.count = 2i32;
    let t: STuple = h.make::<STuple>();
    t.items = WRef::<SExprArr>::from_any(arr.as_ref());
    return WRef::<SExpr>::from_any(t.as_ref());
}

// root.fld as SField(SField(null, root), fld) — the surface spelling's IR.
fn gp_field(h: &Writ, root: str, fld: str) -> WRef<SExpr> {
    let b: SField = h.make::<SField>();
    b.base = null_sref();
    b.name = root;
    let f: SField = h.make::<SField>();
    f.base = WRef::<SExpr>::from_any(b.as_ref());
    f.name = fld;
    return WRef::<SExpr>::from_any(f.as_ref());
}

fn gp_str_lit(h: &Writ, sv: str) -> WRef<SExpr> {
    let n: SLit = h.make::<SLit>();
    n.val = WAny::from(h.wstring(sv));
    return WRef::<SExpr>::from_any(n.as_ref());
}

fn gp_bin(h: &Writ, op: i32, l: WRef<SExpr>, r: WRef<SExpr>) -> WRef<SExpr> {
    let n: SBin = h.make::<SBin>();
    n.op = op;
    n.lhs = l;
    n.rhs = r;
    return WRef::<SExpr>::from_any(n.as_ref());
}

// AND-fold with an absent accumulator.
fn gp_and(h: &Writ, acc: WRef<SExpr>, p: WRef<SExpr>) -> WRef<SExpr> {
    if acc.any().is_null() { return p; }
    return gp_bin(h, OP_AND(), acc, p);
}

// gp_build result: the chain is in `starr`; `extra` is the ANDed residual
// predicate (anchor included, never null on ok); `last` = the row var.
struct GpRes { pub ok: bool, pub extra: WRef<SExpr>, pub last: str, pub err: str }

fn gp_fail(msg: str) -> GpRes {
    return GpRes { ok: false, extra: null_sref(), last: "", err: msg };
}

// ── `**` support: the REACH relation, injected as an ORDINARY Datalog rel ───
// reach_<src>(a, b): b is a-or-any-descendant NODE of a (descendant-or-self
// over node ids). Injected into the PROGRAM on first use (found by name on
// re-use), so BOTH engines evaluate it with their existing rel machinery —
// no new evaluator code.
//
// DEMAND-DRIVEN (ADR 0016 M6, #349): every `**` site joins reach on
// `a == <the node it stands on>`, so the site's adornment is `reach^bf` and
// only the `a` values some site can bind are ever asked about. This is the
// magic-sets rewrite as Soufflé's MST does it: ONE magic predicate per
// adorned predicate, ONE magic rule per occurrence. The occurrence's sideways
// information is the path prefix to its left (anchor, steps, their key/idx/
// kind residuals); the user's WHERE is not pushed in, which only widens the
// demand and never changes an answer.
//   rel __mreach_<src>(c: i64) {
//       <prefix of site 1> select <its last var>.child;   -- one per site
//       …
//   }
//   rel __reach_<src>(a: i64, b: i64) {
//       from __mreach_<src> m select (m.c, m.c);           -- self (seeds)
//       from __reach_<src> r join <src> e on e.parent == r.b
//           select (r.a, e.child);                         -- step
//   }
// The step body keeps `a`, so every derived row's `a` is a seed: reach is
// the naive closure restricted to `a ∈ __mreach_<src>`, which is all a site
// reads. A prefix that crosses an earlier `**` reads `__reach_<src>` in its
// seed body, so the two rels are one SCC — positive recursion, no stratum
// boundary.
fn gp_mk_col(h: &Writ, nm: str) -> i64 {
    let c: RQRelCol = h.make::<RQRelCol>();
    c.name = nm;
    c.ty_name = "i64";
    return c.as_ref().raw();
}

// Index of the program's rel named `nm`, or −1.
fn gp_rel_find(prog_root: WAny, nm: str) -> i64 {
    let prog: RQProgram = prog_root.view::<RQProgram>();
    if !prog.has_rels() { return -1i64; }
    let rels: RQRelArr = prog.rels_arr();
    let n: i64 = rels.len();
    let mut i: i64 = 0i64;
    while i < n {
        if str_eq(rels.rel_at(i).name, nm) { return i; }
        i = i + 1i64;
    }
    return -1i64;
}

// Append `rel` to the program (creating the rel list when absent).
fn gp_rel_append(prog_root: WAny, rel: RQRel, h: &Writ) {
    let prog: RQProgram = prog_root.view::<RQProgram>();
    let fp: RQProgram = rq_fat_program(prog_root, h);
    if !prog.has_rels() {
        let ra: RQRelArr = h.make::<RQRelArr>();
        let mut ram: RQRelArr = ra;
        ram.set_rel(0i64, rel.as_ref());
        ram.set_len(1i64);
        fp.rels = WRef::<RQRelArr>::from_any(ram.as_ref());
        return;
    }
    let rels: RQRelArr = prog.rels_arr();
    let n: i64 = rels.len();
    let mut relsm: RQRelArr = rq_fat_rels(fp.rels.any(), h);
    relsm.set_rel(n, rel.as_ref());
    relsm.set_len(n + 1i64);
}

// Add one seed body (raw handle) to `__mreach_<src>`, injecting the magic rel
// on first use.
fn gp_magic_seed(prog_root: WAny, src: str, body: i64, h: &Writ) {
    let mut nm: String = String::new();
    nm.push_str("__mreach_");
    nm.push_str(src);
    let at: i64 = gp_rel_find(prog_root, lw_str(&nm));
    if at >= 0i64 {
        let rel0: RQRel = prog_root.view::<RQProgram>().rels_arr().rel_at(at);
        let nb: i64 = rel0.bodies_arr().len();
        let mut fb: RQBodyArr = rq_fat_bodies(rel0.bodies.any(), h);
        fb.set_body(nb, unsafe { WAny::ref_to(body as *const u8) });
        fb.set_len(nb + 1i64);
        return;
    }
    let rel: RQRel = h.make::<RQRel>();
    rel.name = lw_str(&nm);
    let cols: RQRelColArr = h.make::<RQRelColArr>();
    let mut colsm: RQRelColArr = cols;
    colsm.set_col(0i64, unsafe { WAny::ref_to(gp_mk_col(h, "c") as *const u8) });
    colsm.set_len(1i64);
    rel.cols = WRef::<RQRelColArr>::from_any(colsm.as_ref());
    let bodies: RQBodyArr = h.make::<RQBodyArr>();
    let mut bm: RQBodyArr = bodies;
    bm.set_body(0i64, unsafe { WAny::ref_to(body as *const u8) });
    bm.set_len(1i64);
    rel.bodies = WRef::<RQBodyArr>::from_any(bm.as_ref());
    gp_rel_append(prog_root, rel, h);
}

// The seed body of one `**` site: the path prefix as its own query,
// projecting the node the `**` stands on. `starr`/`extra`/`prev` are the
// prefix built by a gp_build run stopped at the site.
fn gp_mk_seed_body(src: str, h: &Writ, sa: RQJoinStepArr, extra: WRef<SExpr>,
                   prev: str) -> i64 {
    if sa.len() == 0i64 {
        let s: RQSimple = h.make::<RQSimple>();
        s.src_name = src;
        s.var_name = "__ga";
        s.has_where = true;
        s.where_pred = extra;
        s.select = gp_field(h, prev, "child");
        s.sel_first = false;
        s.distinct = false;
        s.has_order = false;
        s.has_limit = false;
        s.has_result_ty = false;
        s.has_gpath = false;
        return s.as_ref().raw();
    }
    let j: RQJoin = h.make::<RQJoin>();
    j.a_name = src;
    j.x_var = "__ga";
    j.steps = WRef::<RQJoinStepArr>::from_any(sa.as_ref());
    j.has_where = true;
    j.where_pred = extra;
    j.select = gp_field(h, prev, "child");
    j.sel_first = false;
    j.distinct = false;
    j.has_order = false;
    j.has_limit = false;
    j.has_result_ty = false;
    j.has_gpath = false;
    return j.as_ref().raw();
}

// Find the program's reach rel for `src`, injecting it on first use (its
// seed body reads `__mreach_<src>`, which gp_magic_seed injects).
// Returns the rel NAME (arena-interned).
fn gp_reach_rel<'a>(prog_root: WAny, src: str, h: &'a Writ) -> &'a str {
    let mut nm: String = String::new();
    nm.push_str("__reach_");
    nm.push_str(src);
    let at: i64 = gp_rel_find(prog_root, lw_str(&nm));
    if at >= 0i64 { return prog_root.view::<RQProgram>().rels_arr().rel_at(at).name; }
    let mut mn: String = String::new();
    mn.push_str("__mreach_");
    mn.push_str(src);
    // the rel node (name interned by the schema str-field write)
    let rel: RQRel = h.make::<RQRel>();
    rel.name = lw_str(&nm);
    let cols: RQRelColArr = h.make::<RQRelColArr>();
    let mut colsm: RQRelColArr = cols;
    colsm.set_col(0i64, unsafe { WAny::ref_to(gp_mk_col(h, "a") as *const u8) });
    colsm.set_col(1i64, unsafe { WAny::ref_to(gp_mk_col(h, "b") as *const u8) });
    colsm.set_len(2i64);
    rel.cols = WRef::<RQRelColArr>::from_any(colsm.as_ref());
    let bodies: RQBodyArr = h.make::<RQBodyArr>();
    let mut bm: RQBodyArr = bodies;
    // self over the seeds
    let b1: RQSimple = h.make::<RQSimple>();
    b1.src_name = lw_str(&mn);
    b1.var_name = "__rm";
    b1.has_where = false;
    b1.select = gp_tuple2(h, gp_field(h, "__rm", "c"), gp_field(h, "__rm", "c"));
    b1.sel_first = false;
    b1.distinct = false;
    b1.has_order = false;
    b1.has_limit = false;
    b1.has_result_ty = false;
    b1.has_gpath = false;
    bm.set_body(0i64, b1.as_ref());
    // the transitive step body
    let b3: RQJoin = h.make::<RQJoin>();
    b3.a_name = rel.name;
    b3.x_var = "__rr";
    let st3: RQJoinStep = h.make::<RQJoinStep>();
    st3.is_anti = false;
    st3.is_edge = false;
    st3.has_on = true;
    st3.src_name = src;
    st3.var_name = "__re";
    st3.on = gp_bin(h, OP_EQ(), gp_field(h, "__re", "parent"), gp_field(h, "__rr", "b"));
    let sarr3: RQJoinStepArr = h.make::<RQJoinStepArr>();
    let mut sm3: RQJoinStepArr = sarr3;
    sm3.set_step(0i64, st3.as_ref());
    sm3.set_len(1i64);
    b3.steps = WRef::<RQJoinStepArr>::from_any(sm3.as_ref());
    b3.has_where = false;
    b3.select = gp_tuple2(h, gp_field(h, "__rr", "a"), gp_field(h, "__re", "child"));
    b3.sel_first = false;
    b3.distinct = false;
    b3.has_order = false;
    b3.has_limit = false;
    b3.has_result_ty = false;
    b3.has_gpath = false;
    bm.set_body(1i64, b3.as_ref());
    bm.set_len(2i64);
    rel.bodies = WRef::<RQBodyArr>::from_any(bm.as_ref());
    gp_rel_append(prog_root, rel, h);
    return rel.name;
}

// Build the classic join-step chain for one gpath (into `starr`, which must
// be a FRESH fat RQJoinStepArr) + the residual predicate. `prog_root` — the
// program node (`**` injects its demand and reach rels there on first use).
// `stop` ≥ 0 builds only the PREFIX [0, stop) — a `**` site's seed body; the
// prefix's own `**` hops then join reach without seeding it again (the outer
// build seeded them when it passed them).
fn gp_build(src: str, gp: RQGStepArr, h: &Writ, starr: &mut RQJoinStepArr,
            prog_root: WAny, stop: i64) -> GpRes {
    let n: i64 = if stop >= 0i64 { stop } else { gp.len() };
    if gp.len() < 1i64 { return gp_fail("wql!: a graph path needs at least one step"); }
    // anchor: the virtual root edge. THE ONLY READER of the root coordinate —
    // the three producers (writ_graph_edges, deem's ts_scan, the
    // #[derive_graph_source] materializer) all emit WG_ROOT_PARENT, and this
    // compares against it. A literal here is the same drift one step later: the
    // query would compile and answer zero rows.
    let mut extra: WRef<SExpr> = gp_bin(h, OP_EQ(),
        gp_field(h, "__ga", "parent"), make_int_lit(h, WG_ROOT_PARENT));
    let mut prev: str = "__ga";
    let mut hop: str = "";             // pending ** reach var ("" = none)
    let mut last_user: bool = false;   // the current row var is user-named
    let mut si: i64 = 0i64;            // emitted join steps
    let mut i: i64 = 0i64;
    while i < n {
        let st: RQGStep = gp.gstep_at(i);
        // {kind} is a FILTER on the CURRENT step's edge — no movement, no join.
        if st.is_kind {
            if st.has_binder {
                return gp_fail("wql!: a {kind} filter cannot carry a binder — name the step it filters instead (`from g * s {map} select …`)");
            }
            if hop.len() > 0i64 {
                return gp_fail("wql!: a {kind} filter cannot follow `**` directly — filter the stepped edge (`** * v {kind}` or `** .key v {kind}`)");
            }
            extra = gp_and(h, extra, gp_bin(h, OP_EQ(), gp_field(h, prev, "kind"), gp_str_lit(h, st.key)));
            i = i + 1i64;
            continue;
        }
        // `**` — a REACH HOP: reposition the join origin to any descendant-or-
        // self node; the FOLLOWING movement step scans from there. A binder on
        // `**` is the trailing form — an implicit `*` movement binding it.
        if st.is_desc {
            if hop.len() > 0i64 {
                return gp_fail("wql!: consecutive `**` — one descent suffices");
            }
            if stop < 0i64 {
                // the site's magic rule: the prefix, projecting where `**` stands
                let mut pa: RQJoinStepArr = h.make::<RQJoinStepArr>();
                let pr: GpRes = gp_build(src, gp, h, &mut pa, prog_root, i);
                if !pr.ok { return pr; }
                gp_magic_seed(prog_root, src, gp_mk_seed_body(src, h, pa, pr.extra, pr.last), h);
            }
            let rn: str = gp_reach_rel(prog_root, src, h);
            let rv: str = gp_rvar(i);
            let hj: RQJoinStep = h.make::<RQJoinStep>();
            hj.is_anti = false;
            hj.is_edge = false;
            hj.has_on = true;
            hj.src_name = rn;
            hj.var_name = rv;
            hj.on = gp_bin(h, OP_EQ(), gp_field(h, rv, "a"), gp_field(h, prev, "child"));
            starr.set_step(si, hj.as_ref());
            si = si + 1i64;
            if st.has_binder {
                // trailing `** v`: implicit any-step off the hop
                let v0: str = st.binder;
                let js0: RQJoinStep = h.make::<RQJoinStep>();
                js0.is_anti = false;
                js0.is_edge = false;
                js0.has_on = true;
                js0.src_name = src;
                js0.var_name = v0;
                js0.on = gp_bin(h, OP_EQ(), gp_field(h, v0, "parent"), gp_field(h, rv, "b"));
                starr.set_step(si, js0.as_ref());
                si = si + 1i64;
                prev = v0;
                last_user = true;
            } else {
                hop = rv;
            }
            i = i + 1i64;
            continue;
        }
        let v: str = if st.has_binder { st.binder } else { gp_var(i) };
        let js: RQJoinStep = h.make::<RQJoinStep>();
        js.is_anti = false;
        js.is_edge = false;
        js.has_on = true;
        js.src_name = src;
        js.var_name = v;
        if hop.len() > 0i64 {
            js.on = gp_bin(h, OP_EQ(), gp_field(h, v, "parent"), gp_field(h, hop, "b"));
            hop = "";
        } else {
            js.on = gp_bin(h, OP_EQ(), gp_field(h, v, "parent"), gp_field(h, prev, "child"));
        }
        starr.set_step(si, js.as_ref());
        si = si + 1i64;
        if st.is_key {
            extra = gp_and(h, extra, gp_bin(h, OP_EQ(), gp_field(h, v, "key"), gp_str_lit(h, st.key)));
        } else if st.is_at {
            extra = gp_and(h, extra, gp_bin(h, OP_EQ(), gp_field(h, v, "idx"), make_int_lit(h, st.idx)));
        } else if st.is_elem {
            extra = gp_and(h, extra, gp_bin(h, OP_GE(), gp_field(h, v, "idx"), make_int_lit(h, 0i64)));
        }
        prev = v;
        last_user = st.has_binder;
        i = i + 1i64;
    }
    if stop >= 0i64 {
        starr.set_len(si);
        return GpRes { ok: true, extra: extra, last: prev, err: "" };
    }
    if hop.len() > 0i64 {
        return gp_fail("wql!: `**` must be followed by a step (or carry the binder itself: `** v`)");
    }
    if si < 1i64 {
        return gp_fail("wql!: a graph path needs at least one movement step ({kind} alone only filters)");
    }
    if !last_user {
        return gp_fail("wql!: the last graph-path step must bind the row variable — `from g .a .b v select …`");
    }
    starr.set_len(si);
    return GpRes { ok: true, extra: extra, last: prev, err: "" };
}

// Desugar ONE query node. Returns the REPLACEMENT node's raw handle word
// (0 = unchanged / rewritten in place), and sets `err` on failure. The i64
// return launders arena provenance (no borrow ties to the params).
fn gp_desugar_query(qany: WAny, prog_root: WAny, h: &Writ, err: &mut String) -> i64 {
    let none: i64 = 0i64;
    let q: RQuery = qany.view::<RQuery>();
    match q {
        RQuery::Simple(s0) => {
            if !s0.has_gpath { return none; }
            let s: RQSimple = rq_fat_simple(qany, h);
            let mut sa: RQJoinStepArr = h.make::<RQJoinStepArr>();
            let res: GpRes = gp_build(s.src_name, s.gpath_arr(), h, &mut sa, prog_root, -1i64);
            if !res.ok { err.push_str(res.err); return none; }
            let j: RQJoin = h.make::<RQJoin>();
            j.fn_name = s.fn_name;
            j.a_name = s.src_name;
            j.x_var = "__ga";
            j.steps = WRef::<RQJoinStepArr>::from_any(sa.as_ref());
            let mut w: WRef<SExpr> = res.extra;
            if s.has_where { w = gp_and(h, w, s.where_pred); }
            j.has_where = true;
            j.where_pred = w;
            j.select = s.select;
            j.sel_first = s.sel_first;
            j.distinct = s.distinct;
            j.has_order = s.has_order;
            j.order_key = s.order_key;
            j.order_desc = s.order_desc;
            j.has_limit = s.has_limit;
            j.limit_n = s.limit_n;
            j.limit_is_param = s.limit_is_param;
            j.limit_param = s.limit_param;
            j.has_result_ty = s.has_result_ty;
            j.result_ty = s.result_ty;
            return j.as_ref().raw();
        }
        RQuery::Join(j0) => {
            if !j0.has_gpath { return none; }
            let jo: RQJoin = rq_fat_join(qany, h);
            let mut sa: RQJoinStepArr = h.make::<RQJoinStepArr>();
            let res: GpRes = gp_build(jo.a_name, jo.gpath_arr(), h, &mut sa, prog_root, -1i64);
            if !res.ok { err.push_str(res.err); return none; }
            // append the ORIGINAL classic steps after the gpath chain
            let orig: RQJoinStepArr = jo.steps_arr();
            let gn: i64 = sa.len();
            let on_: i64 = orig.len();
            let mut k: i64 = 0i64;
            while k < on_ {
                sa.set_step(gn + k, orig.step_any(k));
                k = k + 1i64;
            }
            sa.set_len(gn + on_);
            jo.x_var = "__ga";
            jo.steps = WRef::<RQJoinStepArr>::from_any(sa.as_ref());
            let mut w2: WRef<SExpr> = res.extra;
            if jo.has_where { w2 = gp_and(h, w2, jo.where_pred); }
            jo.has_where = true;
            jo.where_pred = w2;
            jo.has_gpath = false;
            return none;   // rewritten IN PLACE (same node kind)
        }
        RQuery::Aggr(g0) => {
            if !g0.has_gpath { return none; }
            let ga: RQAggr = rq_fat_aggr(qany, h);
            let mut sa: RQJoinStepArr = h.make::<RQJoinStepArr>();
            let res: GpRes = gp_build(ga.a_name, ga.gpath_arr(), h, &mut sa, prog_root, -1i64);
            if !res.ok { err.push_str(res.err); return none; }
            let gn2: i64 = sa.len();
            if !ga.steps.any().is_null() {
                let orig2: RQJoinStepArr = ga.steps_arr();
                let on2: i64 = orig2.len();
                let mut k2: i64 = 0i64;
                while k2 < on2 {
                    sa.set_step(gn2 + k2, orig2.step_any(k2));
                    k2 = k2 + 1i64;
                }
                sa.set_len(gn2 + on2);
            }
            ga.x_var = "__ga";
            ga.steps = WRef::<RQJoinStepArr>::from_any(sa.as_ref());
            let mut w3: WRef<SExpr> = res.extra;
            if ga.has_where { w3 = gp_and(h, w3, ga.where_pred); }
            ga.has_where = true;
            ga.where_pred = w3;
            ga.has_gpath = false;
            return none;   // rewritten IN PLACE
        }
        RQuery::Find(_f) => { return none; }   // no gpath in the find grammar
    }
}

// ── FACTS: a FROM-less `select` reads the one-row `__unit` ──────────────────
// Point one fact query at `__unit __u`. True iff it was a fact.
fn fact_desugar_query(qany: WAny, h: &Writ) -> bool {
    let q: RQuery = qany.view::<RQuery>();
    match q {
        RQuery::Simple(s0) => {
            if s0.src_name.len() > 0i64 { return false; }
            let s: RQSimple = rq_fat_simple(qany, h);
            s.src_name = "__unit";
            s.var_name = "__u";
            return true;
        }
        _ => { return false; }
    }
}

/// Desugar every FACT body (`select S` with no source) in the program, rel
/// bodies and entry alike, to a scan of `__unit`. Returns true iff any was
/// found: the handler then registers `__unit` as a native source
/// (`logos.std.wql.unit::wql_unit_rows`, one row), so nothing downstream
/// needs an arm for a sourceless query.
pub fn desugar_program_facts(root: WAny, h: &Writ) -> bool {
    let prog: RQProgram = root.view::<RQProgram>();
    let mut any: bool = false;
    if prog.has_rels() {
        let rels: RQRelArr = prog.rels_arr();
        let nr: i64 = rels.len();
        let mut i: i64 = 0i64;
        while i < nr {
            let bodies: RQBodyArr = rels.rel_at(i).bodies_arr();
            let nb: i64 = bodies.len();
            let mut b: i64 = 0i64;
            while b < nb {
                if fact_desugar_query(bodies.body_any(b), h) { any = true; }
                b = b + 1i64;
            }
            i = i + 1i64;
        }
    }
    if fact_desugar_query(prog.entry_any(), h) { any = true; }
    return any;
}

/// The natspec entry that registers `__unit` (see `desugar_program_facts`).
pub fn UNIT_NATSPEC() -> str { return "__unit=wql_unit_rows@logos.std.wql.unit:(u i64);"; }

// ── DEMAND FOR A USER REL: magic sets (ADR 0016 M6, #349) ───────────────────
// The entry reads rel R as its BASE source with a column bound to one value:
//   from R x where … x.c == K …        (K a literal or a scalar parameter)
// Only rows with c == K can reach the answer, so R is evaluated on demand —
// Soufflé's magic-sets transformation (MST), adornment = that one column:
//   rel __m_R(c: ty) { select K; }                  -- the seed (a fact)
//   base body of R    → … join __m_R __mm on __mm.c == <its column c>
//   recursive body    → unchanged, when it passes column c through from its
//                       one occurrence of R (`select (r.c, …)` over `R r`)
// By induction every derived row of R keeps c ∈ __m_R, and every row of the
// naive R with c ∈ __m_R is still derived (its derivation's base row has the
// same c). The entry's own predicate stays, so the answer is unchanged.
// Declined, with the rule that decided it, when R has another reader, a body
// negates or aggregates, a body reads R twice, a recursive body moves the
// column, a base body computes it, or a slot is missing. Runs after the gpath
// desugar (bodies are classic) and before the fact desugar (the seed is a
// fact).

// How many times query `qany` reads `nm` as a source.
fn ms_reads(qany: WAny, nm: str) -> i64 {
    let q: RQuery = qany.view::<RQuery>();
    let mut n: i64 = 0i64;
    match q {
        RQuery::Simple(s) => { if str_eq(s.src_name, nm) { n = 1i64; } }
        RQuery::Join(j) => {
            if str_eq(j.a_name, nm) { n = 1i64; }
            n = n + ms_step_reads(j.steps.any(), nm);
        }
        RQuery::Aggr(g) => {
            if str_eq(g.a_name, nm) { n = 1i64; }
            if g.has_steps() { n = n + ms_step_reads(g.steps.any(), nm); }
        }
        RQuery::Find(f) => { if str_eq(f.src_name, nm) { n = 1i64; } }
    }
    return n;
}

fn ms_step_reads(sa: WAny, nm: str) -> i64 {
    if sa.is_null() { return 0i64; }
    let steps: RQJoinStepArr = sa.view::<RQJoinStepArr>();
    let mut n: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < steps.len() {
        let st: RQJoinStep = steps.step_at(i);
        if !st.is_edge && str_eq(st.src_name, nm) { n = n + 1i64; }
        i = i + 1i64;
    }
    return n;
}

// Does `e` contain an operation that can return an `ElError`: integer
// arithmetic is checked (`el_add(..)?`, `el_div(..)?`, `el_neg(..)?`), and the
// types are not known before the walk, so every arithmetic node counts. A
// comprehension carries a plan of its own and counts too.
fn ms_fallible(w: WRef<SExpr>) -> bool {
    if w.any().is_null() { return false; }
    let e: SExpr = w.any().view::<SExpr>();
    match e {
        SExpr::Bin(b) => {
            let op: i32 = b.op;
            if op == OP_ADD() || op == OP_SUB() || op == OP_MUL() || op == OP_DIV() || op == OP_MOD() {
                return true;
            }
            return ms_fallible(b.lhs) || ms_fallible(b.rhs);
        }
        SExpr::Un(u) => {
            if u.op == OP_NEG() { return true; }
            return ms_fallible(u.arg);
        }
        SExpr::Field(f) => { return ms_fallible(f.base); }
        SExpr::Call(c) => { return ms_fallible_arr(c.args); }
        SExpr::Tuple(t) => { return ms_fallible_arr(t.items); }
        SExpr::Cond(c) => { return ms_fallible(c.c) || ms_fallible(c.t) || ms_fallible(c.e); }
        SExpr::Cast(c) => { return ms_fallible(c.arg); }
        SExpr::Comp(_c) => { return true; }
        _ => { return false; }
    }
}

fn ms_fallible_arr(a: WRef<SExprArr>) -> bool {
    if a.any().is_null() { return false; }
    let arr: SExprArr = a.any().view::<SExprArr>();
    let mut k: i64 = 0i64;
    while k < arr.len() {
        if ms_fallible(WRef::<SExpr>::from_any(arr.arg_any(k))) { return true; }
        k = k + 1i64;
    }
    return false;
}

fn ms_steps_fallible(sa: WAny) -> bool {
    if sa.is_null() { return false; }
    let steps: RQJoinStepArr = sa.view::<RQJoinStepArr>();
    let mut i: i64 = 0i64;
    while i < steps.len() {
        let st: RQJoinStep = steps.step_at(i);
        if st.has_on && ms_fallible(st.on) { return true; }
        i = i + 1i64;
    }
    return false;
}

// A rel body's fallibility: its select, WHERE and every ON.
fn ms_body_fallible(qany: WAny) -> bool {
    let q: RQuery = qany.view::<RQuery>();
    match q {
        RQuery::Simple(s) => { return ms_fallible(s.select) || (s.has_where && ms_fallible(s.where_pred)); }
        RQuery::Join(j) => {
            return ms_fallible(j.select) || (j.has_where && ms_fallible(j.where_pred))
                || ms_steps_fallible(j.steps.any());
        }
        _ => { return true; }
    }
}

// The entry's filter side: its WHERE and every ON (the select runs only on
// rows that passed, so it sees the same rows either way).
fn ms_entry_fallible(qany: WAny) -> bool {
    let q: RQuery = qany.view::<RQuery>();
    match q {
        RQuery::Simple(s) => { return s.has_where && ms_fallible(s.where_pred); }
        RQuery::Join(j) => { return (j.has_where && ms_fallible(j.where_pred)) || ms_steps_fallible(j.steps.any()); }
        RQuery::Aggr(g) => {
            let mut f: bool = g.has_where && ms_fallible(g.where_pred);
            if g.has_steps() && ms_steps_fallible(g.steps.any()) { f = true; }
            return f;
        }
        RQuery::Find(_f) => { return true; }
    }
}

// The select expression of a body (Simple / Join).
fn ms_select(qany: WAny) -> WRef<SExpr> {
    let q: RQuery = qany.view::<RQuery>();
    match q {
        RQuery::Simple(s) => { return s.select; }
        RQuery::Join(j) => { return j.select; }
        _ => { return null_sref(); }
    }
}

// Component `ci` of a select over `ncols` columns.
fn ms_sel_item(sel: WRef<SExpr>, ci: i64, ncols: i64) -> SExpr {
    let e: SExpr = sel.any().view::<SExpr>();
    if ncols == 1i64 { return e; }
    match e {
        SExpr::Tuple(t) => { return t.items.any().view::<SExprArr>().arg_at(ci); }
        _ => { return e; }
    }
}

// `v.f` → (v, f); anything else → ("", "").
struct MsCol { pub var: str, pub fld: str }
fn ms_col_ref(e: SExpr) -> MsCol {
    match e {
        SExpr::Field(f) => {
            let br: WRef<SExpr> = f.base;
            if br.any().is_null() { return MsCol { var: "", fld: "" }; }
            let b: SExpr = br.any().view::<SExpr>();
            match b {
                SExpr::Field(bf) => {
                    let bb: WRef<SExpr> = bf.base;
                    if bb.any().is_null() { return MsCol { var: bf.name, fld: f.name }; }
                    return MsCol { var: "", fld: "" };
                }
                _ => { return MsCol { var: "", fld: "" }; }
            }
        }
        _ => { return MsCol { var: "", fld: "" }; }
    }
}

// Is `e` a value fixed before the query runs: a literal, a parameter, or a
// bare name that is one of the deem's SCALAR parameters? A bare name the
// entry may also resolve (a module constant: Canon's `OP_SCAN`) does not
// qualify — a rel body would refuse it in the seed.
fn ms_is_const(e: SExpr, var: str, prm: &MacroParams) -> bool {
    match e {
        SExpr::Lit(l) => { return !l.val.is_null(); }
        SExpr::Param(_p) => { return true; }
        SExpr::Field(f) => {
            let br: WRef<SExpr> = f.base;
            return br.any().is_null() && !str_eq(f.name, var) && prm.is_scalar(f.name);
        }
        _ => { return false; }
    }
}

// The rel the entry demands with one bound column, and where its seed comes
// from: a constant (`from R x where x.c == K` → `select K`), or a join key
// (`from S y join R x on x.c == y.f …` → `from S y select y.f`, the sideways
// information the entry's base passes to its first step — Soufflé's MST with a
// left-to-right SIPS does the same).

/// The decisions of one rewrite, in the order they were taken.
pub struct MsDecisions { pub n: i64, pub rel: Vec<str>, pub col: Vec<str>, pub rule: Vec<i32> }

fn ms_note(d: &mut MsDecisions, rel: str, col: str, rule: i32) {
    d.rel.push(rel); d.col.push(col); d.rule.push(rule);
    d.n = d.n + 1i64;
}

// One occurrence of a rel S inside a demanded rel's body, bound or not.

// ── DEMAND BY SIPS: THE MAGIC-SETS TRANSFORMATION (Soufflé's MST) ───────────
// (2026-10-05, #349). A rel R read with some columns bound gets an ADORNED
// COPY R_β (β = the bound columns) whose bodies are R's bodies restricted to
// the demanded values, kept in a magic rel __m_R_β. Inside a body the atoms
// are visited left to right (the sideways-information-passing order is the
// chain's own); a column of an atom is bound when a conjunct of the clause
// (its WHERE, or the ON of a positive step) equates it to a constant, a
// scalar parameter, a column of an atom to its left, or a bound column of the
// head. Every user-rel atom that has a bound column is read through ITS
// adorned copy, and gets one magic rule:
//     __m_S_γ(the bound values) :- __m_R_β, the positive atoms to its left,
//                                   the conjuncts over those atoms.
// The entry query is a clause with no head: its seeds are facts (constants
// and parameters) or the atoms to the left of the occurrence.
//
// What this replaces is a set of recognized shapes (one rel, one column, two
// atoms, demand passed only when every occurrence agreed); what it covers in
// addition is non-linear recursion, mutual recursion, bodies of any width,
// several bound columns, and a rel read both bound and free (the free reader
// keeps reading R, the bound one reads R_β).
//
// Soundness limits, each a refusal of the REL (its readers read it whole):
//   - a body that aggregates or finds (MS_NEG_AGG): Soufflé ignores such
//     relations too; an anti join's atom is never adorned (it is read whole)
//     and a magic rule never contains one, which only widens the demand;
//   - checked arithmetic in a body (MS_FALLIBLE): restricting the rows could
//     turn the naive program's `Err` into an `Ok` (Soufflé excludes
//     order-dependent functors for the same reason).
// A binding is a constant, a parameter or a plain column — never computed —
// so every magic set is a set of values the program already holds (the
// termination argument Soufflé gives for weakly bound head variables).

// `base` is a traversal step's base row var ("" for every other atom).
struct MtAtom { pub src: str, pub var: str, pub anti: bool, pub edge: bool, pub base: str }

// The atoms of a clause in SIPS order: the base, then each step.
fn mt_atoms(qany: WAny) -> Vec<MtAtom> {
    let mut out: Vec<MtAtom> = Vec::<MtAtom>::new();
    match qany.view::<RQuery>() {
        RQuery::Simple(s) => { out.push(MtAtom { src: s.src_name, var: s.var_name, anti: false, edge: false, base: "" }); }
        RQuery::Join(j) => {
            out.push(MtAtom { src: j.a_name, var: j.x_var, anti: false, edge: false, base: "" });
            mt_step_atoms(j.steps.any(), &mut out);
        }
        RQuery::Aggr(g) => {
            out.push(MtAtom { src: g.a_name, var: g.x_var, anti: false, edge: false, base: "" });
            if g.has_steps() { mt_step_atoms(g.steps.any(), &mut out); }
        }
        RQuery::Find(f) => { out.push(MtAtom { src: f.src_name, var: f.var_name, anti: false, edge: false, base: "" }); }
    }
    return out;
}

fn mt_step_atoms(sa: WAny, out: &mut Vec<MtAtom>) {
    if sa.is_null() { return; }
    let st: RQJoinStepArr = sa.view::<RQJoinStepArr>();
    let mut i: i64 = 0i64;
    while i < st.len() {
        let x: RQJoinStep = st.step_at(i);
        let base: str = if x.is_edge { x.base_var } else { "" };
        out.push(MtAtom { src: x.src_name, var: x.var_name, anti: x.is_anti, edge: x.is_edge, base: base });
        i = i + 1i64;
    }
}

// Split `w` on AND into raw conjunct words.
fn mt_split(w: WRef<SExpr>, out: &mut Vec<i64>) {
    if w.any().is_null() { return; }
    match w.any().view::<SExpr>() {
        SExpr::Bin(b) => {
            if b.op == OP_AND() { mt_split(b.lhs, out); mt_split(b.rhs, out); return; }
        }
        _ => { }
    }
    out.push(w.any().raw() as i64);
}

// The conjuncts of a clause: its WHERE and the ON of every POSITIVE step (an
// anti join's ON is the inside of a negation, not a conjunct of the clause).
fn mt_conjuncts(qany: WAny) -> Vec<i64> {
    let mut out: Vec<i64> = Vec::<i64>::new();
    let mut sa: WAny = WAny::null();
    match qany.view::<RQuery>() {
        RQuery::Simple(s) => { if s.has_where { mt_split(s.where_pred, &mut out); } }
        RQuery::Join(j) => { if j.has_where { mt_split(j.where_pred, &mut out); } sa = j.steps.any(); }
        RQuery::Aggr(g) => { if g.has_where { mt_split(g.where_pred, &mut out); } if g.has_steps() { sa = g.steps.any(); } }
        RQuery::Find(_f) => { }
    }
    if !sa.is_null() {
        let st: RQJoinStepArr = sa.view::<RQJoinStepArr>();
        let mut i: i64 = 0i64;
        while i < st.len() {
            let x: RQJoinStep = st.step_at(i);
            if x.has_on && !x.is_anti { mt_split(x.on, &mut out); }
            i = i + 1i64;
        }
    }
    return out;
}

fn mt_sref(w: i64) -> WRef<SExpr> { return WRef::<SExpr>::from_any(unsafe { WAny::ref_to(w as *const u8) }); }

// The atom whose row var is `v` (−1 = none).
fn mt_atom_of(atoms: &Vec<MtAtom>, v: str) -> i64 {
    let mut i: i64 = 0i64;
    while i < atoms.len() { if str_eq(atoms[i].var, v) { return i; } i = i + 1i64; }
    return -1i64;
}

// Every row var `e` reads is one of the atoms in `inc` (a flag per atom), and
// `e` reads nothing else that varies per row (a bare name is a constant: a
// scalar parameter or a module item).
fn mt_reads_only(e: SExpr, atoms: &Vec<MtAtom>, inc: &Vec<bool>) -> bool {
    match e {
        SExpr::Field(f) => {
            let br: WRef<SExpr> = f.base;
            if br.any().is_null() {
                let k: i64 = mt_atom_of(atoms, f.name);
                return k < 0i64 || inc[k];
            }
            return mt_reads_only(br.any().view::<SExpr>(), atoms, inc);
        }
        SExpr::Var(v) => { let k2: i64 = mt_atom_of(atoms, v.name); return k2 < 0i64 || inc[k2]; }
        SExpr::Bin(b) => { return mt_reads_only(b.lhs.any().view::<SExpr>(), atoms, inc) && mt_reads_only(b.rhs.any().view::<SExpr>(), atoms, inc); }
        SExpr::Un(u) => { return mt_reads_only(u.arg.any().view::<SExpr>(), atoms, inc); }
        SExpr::Cast(c) => { return mt_reads_only(c.arg.any().view::<SExpr>(), atoms, inc); }
        SExpr::Cond(c) => {
            return mt_reads_only(c.c.any().view::<SExpr>(), atoms, inc) && mt_reads_only(c.t.any().view::<SExpr>(), atoms, inc)
                && mt_reads_only(c.e.any().view::<SExpr>(), atoms, inc);
        }
        SExpr::Call(c) => {
            let a: SExprArr = c.args.any().view::<SExprArr>();
            let mut i: i64 = 0i64;
            while i < a.len() { if !mt_reads_only(a.arg_at(i), atoms, inc) { return false; } i = i + 1i64; }
            return true;
        }
        SExpr::Tuple(t) => {
            let a2: SExprArr = t.items.any().view::<SExprArr>();
            let mut i2: i64 = 0i64;
            while i2 < a2.len() { if !mt_reads_only(a2.arg_at(i2), atoms, inc) { return false; } i2 = i2 + 1i64; }
            return true;
        }
        SExpr::Comp(_c) => { return false; }
        _ => { return true; }
    }
}

// A column binding found for an atom: how the value is known.
//   kind 1: a constant / parameter (`e` its expression)
//   kind 2: a column of an atom to the left (`e` the `v.f` expression)
//   kind 3: the head's bound column number `hi` (its value is __m_R_β.c<hi>)
struct MtBind { pub kind: i32, pub e: i64, pub hi: i64 }

// The adornment state of one rewrite.
struct MtCtx {
    pub key: Vec<String>,       // "<rel>/<c,c,…>"
    pub src: Vec<i64>,          // the original rel's index
    pub cols: Vec<Vec<i64>>,    // its bound columns, ascending
    pub arel: Vec<String>,      // the adorned copy's name
    pub mrel: Vec<String>,      // its magic rel's name
    pub mbody: Vec<Vec<i64>>,   // the magic rel's bodies (raw), one per occurrence
    pub refuse: Vec<i32>,       // per ORIGINAL rel: MS_DEMAND if adornable, else why not
    pub created: i64,           // copies already built
}

// Can rel `ri` be adorned at all? Only a RECURSIVE rel is: the magic join
// restricts its fixpoint, every round. A non-recursive rel's body is
// evaluated whole before the join filters it — the restriction saves no
// evaluation, and the reader's own filter already applies — while the copy
// doubles its code and the magic rules over adorned siblings create recursion
// the program did not have (measured on Canon: 2x the generated code, 9 SCC
// fns where there were none, compile 8.6 s -> 69 s). A body that aggregates or
// finds, checked arithmetic, or no free step for the magic join keeps a
// recursive rel whole too.
fn mt_rel_verdict(root: WAny, ri: i64) -> i32 {
    let rel: RQRel = root.view::<RQProgram>().rels_arr().rel_at(ri);
    let bj: RQBodyArr = rel.bodies_arr();
    let mut rec: bool = false;
    let mut b0: i64 = 0i64;
    while b0 < bj.len() { if body_reads_its_head(root, bj.body_any(b0), rel.name) { rec = true; } b0 = b0 + 1i64; }
    if !rec { return MS_NONREC(); }
    let mut b: i64 = 0i64;
    while b < bj.len() {
        let ba: WAny = bj.body_any(b);
        match ba.view::<RQuery>() {
            RQuery::Aggr(_g) => { return MS_NEG_AGG(); }
            RQuery::Find(_f) => { return MS_NEG_AGG(); }
            _ => { }
        }
        if ms_body_fallible(ba) { return MS_FALLIBLE(); }
        b = b + 1i64;
    }
    return MS_DEMAND();
}

fn mt_key(name: str, cols: &Vec<i64>) -> String {
    let mut k: String = String::new();
    k.push_str(name);
    k.push_str("/");
    let mut i: i64 = 0i64;
    while i < cols.len() { if i > 0i64 { k.push_str(","); } k.push_i64(cols[i]); i = i + 1i64; }
    return k;
}

// The adornment of rel `ri` on `cols` (ascending): its index in `ctx`, queued
// (named, no bodies yet) on first request.
fn mt_get(ctx: &mut MtCtx, root: WAny, ri: i64, cols: &Vec<i64>) -> i64 {
    let rel: RQRel = root.view::<RQProgram>().rels_arr().rel_at(ri);
    let key: String = mt_key(rel.name, cols);
    let mut i: i64 = 0i64;
    while i < ctx.key.len() {
        if str_eq(lw_str(&ctx.key[i]), lw_str(&key)) { return i; }
        i = i + 1i64;
    }
    let mut an: String = String::new();
    an.push_str(rel.name);
    an.push_str("__b");
    let mut c: i64 = 0i64;
    while c < cols.len() { if c > 0i64 { an.push_str("_"); } an.push_i64(cols[c]); c = c + 1i64; }
    let mut mn: String = String::new();
    mn.push_str("__m_");
    mn.push_str(lw_str(&an));
    let mut cc: Vec<i64> = Vec::<i64>::new();
    let mut k: i64 = 0i64;
    while k < cols.len() { cc.push(cols[k]); k = k + 1i64; }
    ctx.key.push(key);
    ctx.src.push(ri);
    ctx.cols.push(cc);
    ctx.arel.push(an);
    ctx.mrel.push(mn);
    ctx.mbody.push(Vec::<i64>::new());
    return ctx.key.len() - 1i64;
}

// How column `col` of the atom bound to `var` is known at this point of the
// clause (kind 0 = not bound). `hv`/`hf`/`hi` are the head's bound columns
// that are plain columns of the body (`hv.hf` is the head's column hi).
fn mt_bind(var: str, col: str, conj: &Vec<i64>, atoms: &Vec<MtAtom>, inc: &Vec<bool>,
           hv: &Vec<str>, hf: &Vec<str>, hi: &Vec<i64>, prm: &MacroParams) -> MtBind {
    let mut h: i64 = 0i64;
    while h < hv.len() {
        if str_eq(hv[h], var) && str_eq(hf[h], col) { return MtBind { kind: 3i32, e: 0i64, hi: hi[h] }; }
        h = h + 1i64;
    }
    let mut i: i64 = 0i64;
    while i < conj.len() {
        let w: WRef<SExpr> = mt_sref(conj[i]);
        match w.any().view::<SExpr>() {
            SExpr::Bin(b) => {
                if b.op == OP_EQ() {
                    let mut side: i64 = 0i64;
                    while side < 2i64 {
                        let me: WRef<SExpr> = if side == 0i64 { b.lhs } else { b.rhs };
                        let ot: WRef<SExpr> = if side == 0i64 { b.rhs } else { b.lhs };
                        let mc: MsCol = ms_col_ref(me.any().view::<SExpr>());
                        if str_eq(mc.var, var) && str_eq(mc.fld, col) {
                            let oe: SExpr = ot.any().view::<SExpr>();
                            if ms_is_const(oe, var, prm) { return MtBind { kind: 1i32, e: ot.any().raw() as i64, hi: -1i64 }; }
                            let oc: MsCol = ms_col_ref(oe);
                            if oc.var.len() > 0i64 {
                                let k: i64 = mt_atom_of(atoms, oc.var);
                                if k >= 0i64 && inc[k] { return MtBind { kind: 2i32, e: ot.any().raw() as i64, hi: -1i64 }; }
                                let mut h2: i64 = 0i64;
                                while h2 < hv.len() {
                                    if str_eq(hv[h2], oc.var) && str_eq(hf[h2], oc.fld) { return MtBind { kind: 3i32, e: 0i64, hi: hi[h2] }; }
                                    h2 = h2 + 1i64;
                                }
                            }
                        }
                        side = side + 1i64;
                    }
                }
            }
            _ => { }
        }
        i = i + 1i64;
    }
    return MtBind { kind: 0i32, e: 0i64, hi: -1i64 };
}

fn mt_col_name(i: i64) -> String {
    let mut c: String = String::new();
    c.push_str("c");
    c.push_i64(i);
    return c;
}

// A select over `items`: the item itself when there is one, else a tuple.
fn mt_select(h: &Writ, items: &Vec<i64>) -> WRef<SExpr> {
    if items.len() == 1i64 { return mt_sref(items[0]); }
    let mut arr: SExprArr = h.make::<SExprArr>();
    let mut i: i64 = 0i64;
    while i < items.len() { arr.set_arg(i, unsafe { WAny::ref_to(items[i] as *const u8) }); i = i + 1i64; }
    arr.set_len(items.len());
    let t: STuple = h.make::<STuple>();
    t.items = WRef::<SExprArr>::from_any(arr.as_ref());
    return WRef::<SExpr>::from_any(t.as_ref());
}

// A fresh step reading `src` as `var` (no planner fields yet).
fn mt_step(h: &Writ, src: str, var: str, on: WRef<SExpr>) -> RQJoinStep {
    let st: RQJoinStep = h.make::<RQJoinStep>();
    st.is_anti = false; st.is_edge = false; st.has_on = true;
    st.src_name = src; st.var_name = var; st.on = on;
    return st;
}

fn mt_copy_step(h: &Writ, x: RQJoinStep) -> RQJoinStep {
    let st: RQJoinStep = h.make::<RQJoinStep>();
    st.src_name = x.src_name; st.var_name = x.var_name;
    st.is_anti = x.is_anti; st.is_edge = x.is_edge; st.has_on = x.has_on;
    st.on = x.on; st.base_var = x.base_var; st.path = x.path;
    return st;
}

fn mt_join(h: &Writ, a: str, x: str, sel: WRef<SExpr>) -> RQJoin {
    let j: RQJoin = h.make::<RQJoin>();
    j.a_name = a; j.x_var = x; j.select = sel; j.has_where = false;
    j.sel_first = false; j.distinct = false; j.has_order = false;
    j.has_limit = false; j.has_result_ty = false; j.has_gpath = false;
    return j;
}

// A head column as an expression of the body: `v.f`, or the bare `v` (f = "").
fn mt_head_ref(h: &Writ, v: str, f: str) -> WRef<SExpr> {
    if f.len() > 0i64 { return gp_field(h, v, f); }
    let b: SField = h.make::<SField>();
    b.base = null_sref();
    b.name = v;
    return WRef::<SExpr>::from_any(b.as_ref());
}

// The magic rule body for an occurrence whose SIPS visit came after the
// atoms `order[0..upto)`: those atoms in that order, each conjunct of the
// clause placed on the step of the last atom it reads (the base's go to the
// WHERE), and the head's magic rel when a head column links in or is a value;
// it selects the bound values.
fn mt_magic_body(qany: WAny, atoms: &Vec<MtAtom>, order: &Vec<i64>, upto: i64, inc: &Vec<bool>,
                 conj: &Vec<i64>, binds: &Vec<MtBind>, hmrel: str,
                 hv: &Vec<str>, hf: &Vec<str>, hi: &Vec<i64>, h: &Writ) -> i64 {
    let mut link: WRef<SExpr> = null_sref();
    let mut k: i64 = 0i64;
    while k < hv.len() {
        let a: i64 = mt_atom_of(atoms, hv[k]);
        if a >= 0i64 && inc[a] {
            let c: String = mt_col_name(hi[k]);
            link = gp_and(h, link, gp_bin(h, OP_EQ(), gp_field(h, "__mm", lw_str(&c)), mt_head_ref(h, hv[k], hf[k])));
        }
        k = k + 1i64;
    }
    let mut need_m: bool = !link.any().is_null();
    let mut items: Vec<i64> = Vec::<i64>::new();
    let mut b: i64 = 0i64;
    while b < binds.len() {
        if binds[b].kind == 3i32 {
            let mut done: bool = false;
            let mut q: i64 = 0i64;
            while q < hv.len() && !done {
                if hi[q] == binds[b].hi {
                    let a2: i64 = mt_atom_of(atoms, hv[q]);
                    if a2 >= 0i64 && inc[a2] { items.push(mt_head_ref(h, hv[q], hf[q]).any().raw() as i64); done = true; }
                }
                q = q + 1i64;
            }
            if !done {
                let c2: String = mt_col_name(binds[b].hi);
                items.push(gp_field(h, "__mm", lw_str(&c2)).any().raw() as i64);
                need_m = true;
            }
        } else {
            items.push(binds[b].e);
        }
        b = b + 1i64;
    }
    let sel: WRef<SExpr> = mt_select(h, &items);
    if upto == 0i64 {
        let s: RQSimple = h.make::<RQSimple>();
        s.has_where = false;
        if need_m && hmrel.len() > 0i64 { s.src_name = hmrel; s.var_name = "__mm"; }
        s.select = sel;
        s.sel_first = false; s.distinct = false; s.has_order = false;
        s.has_limit = false; s.has_result_ty = false; s.has_gpath = false;
        return s.as_ref().raw() as i64;
    }
    // each conjunct over included atoms goes to the visit position of the
    // last atom it reads (−1: it reads none of them — a WHERE term)
    let mut cpos: Vec<i64> = Vec::<i64>::new();
    let mut c3: i64 = 0i64;
    while c3 < conj.len() {
        let e: SExpr = mt_sref(conj[c3]).any().view::<SExpr>();
        if mt_reads_only(e, atoms, inc) {
            let mut last: i64 = -1i64;
            let mut t: i64 = 0i64;
            while t < upto {
                if (refs_mask(e, atoms[order[t]].var) & 1i32) != 0i32 { last = t; }
                t = t + 1i64;
            }
            cpos.push(last);
        } else {
            cpos.push(-2i64);
        }
        c3 = c3 + 1i64;
    }
    let j: RQJoin = mt_join(h, mt_src_at(qany, order[0]), atoms[order[0]].var, sel);
    let mut sa: RQJoinStepArr = h.make::<RQJoinStepArr>();
    let mut n: i64 = 0i64;
    let mut t2: i64 = 1i64;
    while t2 < upto {
        let mut on: WRef<SExpr> = null_sref();
        let mut c4: i64 = 0i64;
        while c4 < conj.len() { if cpos[c4] == t2 { on = gp_and(h, on, mt_sref(conj[c4])); } c4 = c4 + 1i64; }
        if atoms[order[t2]].edge {
            // the traversal itself, its `on` the conjuncts placed here (none:
            // containment is the join)
            let es: RQJoinStep = mt_copy_step(h, mt_step_view(qany, order[t2]));
            es.has_on = !on.any().is_null();
            es.on = on;
            sa.set_step(n, es.as_ref());
        } else {
            if on.any().is_null() { on = make_bool_lit(h, true); }
            sa.set_step(n, mt_step(h, mt_src_at(qany, order[t2]), atoms[order[t2]].var, on).as_ref());
        }
        n = n + 1i64;
        t2 = t2 + 1i64;
    }
    if need_m && hmrel.len() > 0i64 {
        let on2: WRef<SExpr> = if link.any().is_null() { make_bool_lit(h, true) } else { link };
        sa.set_step(n, mt_step(h, hmrel, "__mm", on2).as_ref());
        n = n + 1i64;
    }
    sa.set_len(n);
    j.steps = WRef::<RQJoinStepArr>::from_any(sa.as_ref());
    let mut wacc: WRef<SExpr> = null_sref();
    let mut c5: i64 = 0i64;
    while c5 < conj.len() { if cpos[c5] == 0i64 || cpos[c5] == -1i64 { wacc = gp_and(h, wacc, mt_sref(conj[c5])); } c5 = c5 + 1i64; }
    if !wacc.any().is_null() { j.has_where = true; j.where_pred = wacc; }
    return j.as_ref().raw() as i64;
}

// The SIPS of one clause, without touching it: the visit order (next, the
// positive atom with the most bound columns — Soufflé's max-bound — ties in
// the written order, so a body bound on a later atom, `from tc t join es e on
// e.src == t.b` with the head's column from `e`, binds `tc` through `es`), and
// for each atom reading a program rel of index < nrel0, its bound columns and
// how each is bound. A TRAVERSAL step's rows are a function of its base row,
// so it is visited right after its base (it binds its row var's fields for
// nothing) and never before it; it reads no rel and is never adorned. An anti
// atom, or a traversal off one, is never visited.
struct MtPlan { pub order: Vec<i64>, pub sri: Vec<i64>, pub cols: Vec<Vec<i64>>, pub binds: Vec<Vec<MtBind>> }

fn mt_sips(root: WAny, atoms: &Vec<MtAtom>, conj: &Vec<i64>, hv: &Vec<str>, hf: &Vec<str>, hi: &Vec<i64>,
           nrel0: i64, prm: &MacroParams) -> MtPlan {
    let mut pl: MtPlan = MtPlan { order: Vec::<i64>::new(), sri: Vec::<i64>::new(),
                                  cols: Vec::<Vec<i64>>::new(), binds: Vec::<Vec<MtBind>>::new() };
    let mut z: i64 = 0i64;
    while z < atoms.len() {
        pl.sri.push(-1i64); pl.cols.push(Vec::<i64>::new()); pl.binds.push(Vec::<MtBind>::new());
        z = z + 1i64;
    }
    let mut inc: Vec<bool> = Vec::<bool>::new();
    let mut seen: Vec<bool> = Vec::<bool>::new();
    let mut z2: i64 = 0i64;
    while z2 < atoms.len() { inc.push(false); seen.push(atoms[z2].anti || (atoms[z2].src.len() == 0i64 && !atoms[z2].edge)); z2 = z2 + 1i64; }
    loop {
        let mut best: i64 = -1i64;
        let mut bestn: i64 = -1i64;
        let mut q: i64 = 0i64;
        while q < atoms.len() {
            if !seen[q] {
                if atoms[q].edge {
                    let bq: i64 = mt_atom_of(atoms, atoms[q].base);
                    if bq >= 0i64 && inc[bq] && bestn < 1000000000i64 { best = q; bestn = 1000000000i64; }
                } else {
                    let nb: i64 = mt_bound_count(root, atoms[q].src, atoms[q].var, conj, atoms, &inc, hv, hf, hi, prm);
                    if nb > bestn { best = q; bestn = nb; }
                }
            }
            q = q + 1i64;
        }
        if best < 0i64 { break; }
        let p: i64 = best;
        seen[p] = true;
        if !str_starts_with(atoms[p].src, "__") {
            let sri: i64 = gp_rel_find(root, atoms[p].src);
            if sri >= 0i64 && sri < nrel0 {
                pl.sri[p] = sri;
                let scols: RQRelColArr = root.view::<RQProgram>().rels_arr().rel_at(sri).cols_arr();
                let mut c: i64 = 0i64;
                while c < scols.len() {
                    let bd: MtBind = mt_bind(atoms[p].var, scols.col_at(c).name, conj, atoms, &inc, hv, hf, hi, prm);
                    if bd.kind > 0i32 { pl.cols[p].push(c); pl.binds[p].push(bd); }
                    c = c + 1i64;
                }
            }
        }
        inc[p] = true;
        pl.order.push(p);
    }
    return pl;
}

// The head's bound columns that are plain columns of the body: `hv.hf` is the
// head's bound column number `hi` (its position in the adornment). A bare name
// (`select (u.x, k)`, `k` a traversal over a scalar collection) is the whole
// value of that atom: `hf` is "".
struct MtHead { pub hv: Vec<str>, pub hf: Vec<str>, pub hi: Vec<i64> }
fn mt_head(qany: WAny, cols: Vec<i64>, ncols: i64) -> MtHead {
    let mut hd: MtHead = MtHead { hv: Vec::<str>::new(), hf: Vec::<str>::new(), hi: Vec::<i64>::new() };
    let sel: WRef<SExpr> = ms_select(qany);
    let mut k: i64 = 0i64;
    while k < cols.len() {
        let ie: SExpr = ms_sel_item(sel, cols[k], ncols);
        let item: MsCol = ms_col_ref(ie);
        if item.var.len() > 0i64 { hd.hv.push(item.var); hd.hf.push(item.fld); hd.hi.push(k); }
        else {
            match ie {
                SExpr::Field(f) => { if f.base.any().is_null() { hd.hv.push(f.name); hd.hf.push(""); hd.hi.push(k); } }
                _ => { }
            }
        }
        k = k + 1i64;
    }
    return hd;
}

// Adorn one clause IN PLACE: each atom whose rel is adornable and bound reads
// its adorned copy and contributes a magic rule. `hk` is the head's adornment
// (−1 = the entry).
fn mt_clause(root: WAny, qany: WAny, hk: i64, nrel0: i64, ctx: &mut MtCtx, prm: &MacroParams,
             h: &Writ, out: &mut MsDecisions) {
    let atoms: Vec<MtAtom> = mt_atoms(qany);
    let conj: Vec<i64> = mt_conjuncts(qany);
    let mut hd: MtHead = MtHead { hv: Vec::<str>::new(), hf: Vec::<str>::new(), hi: Vec::<i64>::new() };
    let mut hms: String = String::new();
    if hk >= 0i64 {
        let ncols: i64 = root.view::<RQProgram>().rels_arr().rel_at(ctx.src[hk]).cols_arr().len();
        let mut hc: Vec<i64> = Vec::<i64>::new();
        let mut k0: i64 = 0i64;
        while k0 < ctx.cols[hk].len() { hc.push(ctx.cols[hk][k0]); k0 = k0 + 1i64; }
        hd = mt_head(qany, hc, ncols);
        hms.push_str(lw_str(&ctx.mrel[hk]));
    }
    let hmrel: str = lw_str(&hms);
    let pl: MtPlan = mt_sips(root, &atoms, &conj, &hd.hv, &hd.hf, &hd.hi, nrel0, prm);
    let mut inc: Vec<bool> = Vec::<bool>::new();
    let mut z: i64 = 0i64;
    while z < atoms.len() { inc.push(false); z = z + 1i64; }
    let mut prefix: Vec<i64> = Vec::<i64>::new();
    let mut t: i64 = 0i64;
    while t < pl.order.len() {
        let p: i64 = pl.order[t];
        let sri: i64 = pl.sri[p];
        if sri >= 0i64 && pl.cols[p].len() > 0i64 {
            if ctx.refuse[sri] == MS_DEMAND() {
                let k2: i64 = mt_get(ctx, root, sri, &pl.cols[p]);
                let mb: i64 = mt_magic_body(qany, &atoms, &prefix, t, &inc, &conj, &pl.binds[p], hmrel, &hd.hv, &hd.hf, &hd.hi, h);
                ctx.mbody[k2].push(mb);
                mt_rename(qany, p, lw_str(&ctx.arel[k2]), h);
            } else if ctx.refuse[sri] > 0i32 {
                let srel: RQRel = root.view::<RQProgram>().rels_arr().rel_at(sri);
                ms_note(out, srel.name, "", ctx.refuse[sri]);
                ctx.refuse[sri] = 0i32 - ctx.refuse[sri];   // noted once
            }
        }
        inc[p] = true;
        prefix.push(p);
        t = t + 1i64;
    }
}

// Which rels some EVALUATED clause reads whole: the entry, the bodies of each
// adorned copy reached, and the bodies of each rel reached whole — simulated
// over the current verdicts, without rewriting anything.
fn mt_free_rels(root: WAny, nrel0: i64, refuse: &Vec<i32>, prm: &MacroParams) -> Vec<bool> {
    let mut free: Vec<bool> = Vec::<bool>::new();
    let mut z: i64 = 0i64;
    while z < nrel0 { free.push(false); z = z + 1i64; }
    // pending clauses: (rel −1 = the entry, its adornment)
    let mut qr: Vec<i64> = Vec::<i64>::new();
    let mut qc: Vec<Vec<i64>> = Vec::<Vec<i64>>::new();
    let mut seen: Vec<String> = Vec::<String>::new();
    qr.push(-1i64); qc.push(Vec::<i64>::new());
    let mut w: i64 = 0i64;
    while w < qr.len() {
        let ri: i64 = qr[w];
        let mut clauses: Vec<i64> = Vec::<i64>::new();
        let mut ncols: i64 = 0i64;
        if ri < 0i64 { clauses.push(root.view::<RQProgram>().entry_any().raw() as i64); }
        else {
            let rel: RQRel = root.view::<RQProgram>().rels_arr().rel_at(ri);
            ncols = rel.cols_arr().len();
            let bj: RQBodyArr = rel.bodies_arr();
            let mut b: i64 = 0i64;
            while b < bj.len() { clauses.push(bj.body_any(b).raw() as i64); b = b + 1i64; }
        }
        let mut c: i64 = 0i64;
        while c < clauses.len() {
            let qany: WAny = unsafe { WAny::ref_to(clauses[c] as *const u8) };
            let atoms: Vec<MtAtom> = mt_atoms(qany);
            let conj: Vec<i64> = mt_conjuncts(qany);
            let mut qcw: Vec<i64> = Vec::<i64>::new();
            let mut k9: i64 = 0i64;
            while k9 < qc[w].len() { qcw.push(qc[w][k9]); k9 = k9 + 1i64; }
            let hd: MtHead = mt_head(qany, qcw, ncols);
            let pl: MtPlan = mt_sips(root, &atoms, &conj, &hd.hv, &hd.hf, &hd.hi, nrel0, prm);
            let mut p: i64 = 0i64;
            while p < atoms.len() {
                let mut sr2: i64 = pl.sri[p];
                if atoms[p].anti && atoms[p].src.len() > 0i64 {
                    let f2: i64 = gp_rel_find(root, atoms[p].src);
                    if f2 >= 0i64 && f2 < nrel0 { sr2 = f2; }
                }
                if sr2 >= 0i64 {
                    let bound: bool = !atoms[p].anti && pl.cols[p].len() > 0i64 && refuse[sr2] == MS_DEMAND();
                    let mut key: String = String::new();
                    key.push_i64(sr2);
                    key.push_str(":");
                    if bound {
                        let mut k: i64 = 0i64;
                        while k < pl.cols[p].len() { key.push_i64(pl.cols[p][k]); key.push_str(","); k = k + 1i64; }
                    } else {
                        key.push_str("free");
                        free[sr2] = true;
                    }
                    let mut known: bool = false;
                    let mut s2: i64 = 0i64;
                    while s2 < seen.len() { if str_eq(lw_str(&seen[s2]), lw_str(&key)) { known = true; } s2 = s2 + 1i64; }
                    if !known {
                        seen.push(key);
                        qr.push(sr2);
                        let mut cc: Vec<i64> = Vec::<i64>::new();
                        if bound { let mut k2: i64 = 0i64; while k2 < pl.cols[p].len() { cc.push(pl.cols[p][k2]); k2 = k2 + 1i64; } }
                        qc.push(cc);
                    }
                }
                p = p + 1i64;
            }
            c = c + 1i64;
        }
        w = w + 1i64;
    }
    return free;
}

// How many columns of the atom bound to `var` are bound now — for ANY atom (a
// native source or a slice parameter binds like a rel): the head's bound
// columns it holds, and each distinct field a conjunct equates to a value
// known here.
fn mt_bound_count(root: WAny, src: str, var: str, conj: &Vec<i64>, atoms: &Vec<MtAtom>, inc: &Vec<bool>,
                  hv: &Vec<str>, hf: &Vec<str>, hi: &Vec<i64>, prm: &MacroParams) -> i64 {
    let mut flds: Vec<str> = Vec::<str>::new();
    let mut h: i64 = 0i64;
    while h < hv.len() { if str_eq(hv[h], var) { mt_add_fld(&mut flds, hf[h]); } h = h + 1i64; }
    let mut i: i64 = 0i64;
    while i < conj.len() {
        match mt_sref(conj[i]).any().view::<SExpr>() {
            SExpr::Bin(b) => {
                if b.op == OP_EQ() {
                    let l: MsCol = ms_col_ref(b.lhs.any().view::<SExpr>());
                    let r: MsCol = ms_col_ref(b.rhs.any().view::<SExpr>());
                    if str_eq(l.var, var) && mt_bind(var, l.fld, conj, atoms, inc, hv, hf, hi, prm).kind > 0i32 { mt_add_fld(&mut flds, l.fld); }
                    if str_eq(r.var, var) && mt_bind(var, r.fld, conj, atoms, inc, hv, hf, hi, prm).kind > 0i32 { mt_add_fld(&mut flds, r.fld); }
                }
            }
            _ => { }
        }
        i = i + 1i64;
    }
    return flds.len();
}

fn mt_add_fld(flds: &mut Vec<str>, f: str) {
    let mut i: i64 = 0i64;
    while i < flds.len() { if str_eq(flds[i], f) { return; } i = i + 1i64; }
    flds.push(f);
}

// The join step of atom `q` (>= 1) of a clause.
fn mt_step_view(qany: WAny, q: i64) -> RQJoinStep {
    let mut sa: WAny = WAny::null();
    match qany.view::<RQuery>() {
        RQuery::Join(j) => { sa = j.steps.any(); }
        RQuery::Aggr(g) => { if g.has_steps() { sa = g.steps.any(); } }
        _ => { }
    }
    if sa.is_null() { logos.lang.panic::panic("mt_step_view: an atom past the base of a clause with no steps"); }
    return sa.view::<RQJoinStepArr>().step_at(q - 1i64);
}

// The source atom `q` of a clause reads, as its node says now.
fn mt_src_at(qany: WAny, q: i64) -> str {
    if q == 0i64 { return mt_base_src(qany); }
    match qany.view::<RQuery>() {
        RQuery::Join(j) => { return j.steps_arr().step_at(q - 1i64).src_name; }
        RQuery::Aggr(g) => { return g.steps_arr().step_at(q - 1i64).src_name; }
        _ => { return ""; }
    }
}

// The source the clause's base atom reads, as its node says now.
fn mt_base_src(qany: WAny) -> str {
    match qany.view::<RQuery>() {
        RQuery::Simple(s) => { return s.src_name; }
        RQuery::Join(j) => { return j.a_name; }
        RQuery::Aggr(g) => { return g.a_name; }
        RQuery::Find(f) => { return f.src_name; }
    }
}

// Point atom `p` of a clause at `name`.
fn mt_rename(qany: WAny, p: i64, name: str, h: &Writ) {
    match qany.view::<RQuery>() {
        RQuery::Simple(_s) => { let fs: RQSimple = rq_fat_simple(qany, h); fs.src_name = name; }
        RQuery::Join(_j) => {
            let fj: RQJoin = rq_fat_join(qany, h);
            if p == 0i64 { fj.a_name = name; }
            else { let st: RQJoinStep = rq_fat_step(fj.steps_arr().step_any(p - 1i64), h); st.src_name = name; }
        }
        RQuery::Aggr(_g) => {
            let fg: RQAggr = rq_fat_aggr(qany, h);
            if p == 0i64 { fg.a_name = name; }
            else { let st2: RQJoinStep = rq_fat_step(fg.steps_arr().step_any(p - 1i64), h); st2.src_name = name; }
        }
        RQuery::Find(_f) => { let ff: RQFind = rq_fat_find(qany, h); ff.src_name = name; }
    }
}

// A copy of a rel body (fresh query and step nodes; the expressions shared).
fn mt_copy_body(qany: WAny, h: &Writ) -> WAny {
    match qany.view::<RQuery>() {
        RQuery::Simple(s) => {
            let c: RQSimple = h.make::<RQSimple>();
            c.src_name = s.src_name; c.var_name = s.var_name; c.has_where = s.has_where;
            c.where_pred = s.where_pred; c.select = s.select;
            c.sel_first = false; c.distinct = false; c.has_order = false;
            c.has_limit = false; c.has_result_ty = false; c.has_gpath = false;
            return c.as_ref();
        }
        RQuery::Join(j) => {
            let c2: RQJoin = mt_join(h, j.a_name, j.x_var, j.select);
            c2.has_where = j.has_where; c2.where_pred = j.where_pred;
            let os: RQJoinStepArr = j.steps_arr();
            let mut sa: RQJoinStepArr = h.make::<RQJoinStepArr>();
            let mut i: i64 = 0i64;
            while i < os.len() { sa.set_step(i, mt_copy_step(h, os.step_at(i)).as_ref()); i = i + 1i64; }
            sa.set_len(os.len());
            c2.steps = WRef::<RQJoinStepArr>::from_any(sa.as_ref());
            return c2.as_ref();
        }
        _ => { return qany; }
    }
}

// Restrict an adorned body to its magic rel: `join __m_R_β __mm on
// __mm.c<k> == <head column k's select item>` for every bound column.
fn mt_restrict(qany: WAny, cols: &Vec<i64>, ncols: i64, mrel: str, h: &Writ) -> WAny {
    let sel: WRef<SExpr> = ms_select(qany);
    let mut on: WRef<SExpr> = null_sref();
    let mut k: i64 = 0i64;
    while k < cols.len() {
        let c: String = mt_col_name(k);
        on = gp_and(h, on, gp_bin(h, OP_EQ(), gp_field(h, "__mm", lw_str(&c)), WRef::<SExpr>::from_any(unsafe { WAny::ref_to(mt_item_raw(sel, cols[k], ncols) as *const u8) })));
        k = k + 1i64;
    }
    let st: RQJoinStep = mt_step(h, mrel, "__mm", on);
    match qany.view::<RQuery>() {
        RQuery::Simple(s) => {
            let j: RQJoin = mt_join(h, s.src_name, s.var_name, s.select);
            j.has_where = s.has_where; j.where_pred = s.where_pred;
            let mut sa: RQJoinStepArr = h.make::<RQJoinStepArr>();
            sa.set_step(0i64, st.as_ref());
            sa.set_len(1i64);
            j.steps = WRef::<RQJoinStepArr>::from_any(sa.as_ref());
            return j.as_ref();
        }
        RQuery::Join(_j) => {
            let fj: RQJoin = rq_fat_join(qany, h);
            let os: RQJoinStepArr = fj.steps_arr();
            let n: i64 = os.len();
            let mut sa: RQJoinStepArr = h.make::<RQJoinStepArr>();
            let mut i: i64 = 0i64;
            while i < n { sa.set_step(i, os.step_any(i)); i = i + 1i64; }
            sa.set_step(n, st.as_ref());
            sa.set_len(n + 1i64);
            fj.steps = WRef::<RQJoinStepArr>::from_any(sa.as_ref());
            return qany;
        }
        _ => { return qany; }
    }
}

// Component `ci` of a select over `ncols` columns, as a raw edge word.
fn mt_item_raw(sel: WRef<SExpr>, ci: i64, ncols: i64) -> i64 {
    if ncols == 1i64 { return sel.any().raw() as i64; }
    match sel.any().view::<SExpr>() {
        SExpr::Tuple(t) => { return t.items.any().view::<SExprArr>().arg_any(ci).raw() as i64; }
        _ => { return sel.any().raw() as i64; }
    }
}

/// The magic-sets transformation of the program (see the header above).
/// Returns the number of decisions written to `out`.
pub fn magic_program(root: WAny, h: &Writ, prm: &MacroParams, out: &mut MsDecisions) -> i64 {
    let prog: RQProgram = root.view::<RQProgram>();
    if !prog.has_rels() { return 0i64; }
    let nrel0: i64 = prog.rels_arr().len();
    let mut ctx: MtCtx = MtCtx { key: Vec::<String>::new(), src: Vec::<i64>::new(), cols: Vec::<Vec<i64>>::new(),
                                 arel: Vec::<String>::new(), mrel: Vec::<String>::new(),
                                 mbody: Vec::<Vec<i64>>::new(), refuse: Vec::<i32>::new(), created: 0i64 };
    let mut r: i64 = 0i64;
    while r < nrel0 { ctx.refuse.push(mt_rel_verdict(root, r)); r = r + 1i64; }
    // A rel some evaluated clause reads whole is evaluated whole anyway: an
    // adorned copy for its bound readers would be extra work. Narrow until no
    // verdict changes (each change can only add whole readers).
    loop {
        let free: Vec<bool> = mt_free_rels(root, nrel0, &ctx.refuse, prm);
        let mut changed: bool = false;
        let mut r2: i64 = 0i64;
        while r2 < nrel0 {
            if free[r2] && ctx.refuse[r2] == MS_DEMAND() { ctx.refuse[r2] = MS_SHARED(); changed = true; }
            r2 = r2 + 1i64;
        }
        if !changed { break; }
    }
    if ms_entry_fallible(prog.entry_any()) {
        // a demand would restrict rows the entry's checked arithmetic reads
        let ea: Vec<MtAtom> = mt_atoms(prog.entry_any());
        if ea.len() > 0i64 && gp_rel_find(root, ea[0].src) >= 0i64 { ms_note(out, ea[0].src, "", MS_FALLIBLE()); }
        return out.n;
    }
    mt_clause(root, prog.entry_any(), -1i64, nrel0, &mut ctx, prm, h, out);
    // the adorned copies, as the worklist grows
    let mut w: i64 = 0i64;
    while w < ctx.key.len() {
        let orig: RQRel = root.view::<RQProgram>().rels_arr().rel_at(ctx.src[w]);
        let ncols: i64 = orig.cols_arr().len();
        let nr: RQRel = h.make::<RQRel>();
        nr.name = lw_str(&ctx.arel[w]);
        nr.cols = orig.cols;
        let ob: RQBodyArr = orig.bodies_arr();
        let mut nb: RQBodyArr = h.make::<RQBodyArr>();
        let mut b: i64 = 0i64;
        while b < ob.len() {
            let cb: WAny = mt_copy_body(ob.body_any(b), h);
            mt_clause(root, cb, w, nrel0, &mut ctx, prm, h, out);
            let rb: WAny = mt_restrict(cb, &ctx.cols[w], ncols, lw_str(&ctx.mrel[w]), h);
            nb.set_body(b, rb);
            b = b + 1i64;
        }
        nb.set_len(ob.len());
        nr.bodies = WRef::<RQBodyArr>::from_any(nb.as_ref());
        gp_rel_append(root, nr, h);
        let mut cn: String = String::new();
        let mut c: i64 = 0i64;
        while c < ctx.cols[w].len() {
            if c > 0i64 { cn.push_str(","); }
            cn.push_str(orig.cols_arr().col_at(ctx.cols[w][c]).name);
            c = c + 1i64;
        }
        let nm: RQRel = h.make::<RQRel>();   // a str home for the decision's column list
        nm.name = lw_str(&cn);
        ms_note(out, orig.name, nm.name, MS_DEMAND());
        w = w + 1i64;
    }
    // the magic rels: one column per bound column, one body per occurrence
    let mut m: i64 = 0i64;
    while m < ctx.key.len() {
        let orig2: RQRel = root.view::<RQProgram>().rels_arr().rel_at(ctx.src[m]);
        let mr: RQRel = h.make::<RQRel>();
        mr.name = lw_str(&ctx.mrel[m]);
        let mut mc: RQRelColArr = h.make::<RQRelColArr>();
        let mut k: i64 = 0i64;
        while k < ctx.cols[m].len() {
            let col: RQRelCol = h.make::<RQRelCol>();
            let cnm: String = mt_col_name(k);
            col.name = lw_str(&cnm);
            col.ty_name = orig2.cols_arr().col_at(ctx.cols[m][k]).ty_name;
            mc.set_col(k, col.as_ref());
            k = k + 1i64;
        }
        mc.set_len(ctx.cols[m].len());
        mr.cols = WRef::<RQRelColArr>::from_any(mc.as_ref());
        let mut mb: RQBodyArr = h.make::<RQBodyArr>();
        let mut q: i64 = 0i64;
        while q < ctx.mbody[m].len() {
            mb.set_body(q, unsafe { WAny::ref_to(ctx.mbody[m][q] as *const u8) });
            q = q + 1i64;
        }
        mb.set_len(ctx.mbody[m].len());
        mr.bodies = WRef::<RQBodyArr>::from_any(mb.as_ref());
        gp_rel_append(root, mr, h);
        m = m + 1i64;
    }
    return out.n;
}

// ── LIVE RELS (Soufflé's RemoveRedundantRelations) ──────────────────────────
// A rel is LIVE when the entry reads it or a live rel's body does — positive,
// anti and aggregate reads alike (Soufflé's precedence graph, walked back from
// the outputs). A dead rel computes nothing the answer reads, yet every deem
// over a mapping received ALL of the mapping's rels and materialized them in
// `_run` (Canon: `canon_proj_direct` reads two of eight). It stays in the
// program — its bodies are still checked, as dead code is — and the prelude
// does not evaluate it. A rel with a FALLIBLE body (`ms_body_fallible`:
// checked arithmetic, a comprehension, an aggregate or find body) is a seed:
// the naive program would evaluate it and could return its `Err`, so leaving
// it out could turn an `Err` into an `Ok` (MS_FALLIBLE's argument).
// Returns a mask by rel position; `fal` receives the fallible seeds that no
// reader reaches.
pub fn live_rel_mask(root: WAny, fal: &mut RelSet) -> RelSet {
    let prog: RQProgram = root.view::<RQProgram>();
    if !prog.has_rels() { *fal = relset_new(0i64); return relset_new(0i64); }
    let rels: RQRelArr = prog.rels_arr();
    let n: i64 = rels.len();
    *fal = relset_new(n);
    let mut live: RelSet = relset_new(n);
    let mut i: i64 = 0i64;
    while i < n {
        if ms_reads(prog.entry_any(), rels.rel_at(i).name) > 0i64 { live.add(i); }
        i = i + 1i64;
    }
    let mut pass: i64 = 0i64;
    while pass < 2i64 {
        let mut changed: bool = true;
        while changed {
            changed = false;
            let mut r: i64 = 0i64;
            while r < n {
                if live.has(r) {
                    let bj: RQBodyArr = rels.rel_at(r).bodies_arr();
                    let mut b: i64 = 0i64;
                    while b < bj.len() {
                        let mut t: i64 = 0i64;
                        while t < n {
                            if !live.has(t) && ms_reads(bj.body_any(b), rels.rel_at(t).name) > 0i64 {
                                live.add(t);
                                changed = true;
                            }
                            t = t + 1i64;
                        }
                        b = b + 1i64;
                    }
                }
                r = r + 1i64;
            }
        }
        if pass == 0i64 {
            // the fallible seeds, then their own readers' closure
            let mut f: i64 = 0i64;
            while f < n {
                if !live.has(f) {
                    let bj2: RQBodyArr = rels.rel_at(f).bodies_arr();
                    let mut b2: i64 = 0i64;
                    while b2 < bj2.len() {
                        if ms_body_fallible(bj2.body_any(b2)) { fal.add(f); }
                        b2 = b2 + 1i64;
                    }
                }
                f = f + 1i64;
            }
            live.union_with(fal);
        }
        pass = pass + 1i64;
    }
    return live;
}

// Is the body `qany` of rel `head` RECURSIVE: does it read a rel that reads
// `head` (or `head` itself), through any chain of rel reads?
pub fn body_reads_its_head(root: WAny, qany: WAny, head: str) -> bool {
    let prog: RQProgram = root.view::<RQProgram>();
    if !prog.has_rels() { return false; }
    let rels: RQRelArr = prog.rels_arr();
    let n: i64 = rels.len();
    // seen: the rels this body reaches
    let mut seen: RelSet = relset_new(n);
    let mut i: i64 = 0i64;
    while i < n {
        if ms_reads(qany, rels.rel_at(i).name) > 0i64 { seen.add(i); }
        i = i + 1i64;
    }
    let mut changed: bool = true;
    while changed {
        changed = false;
        let mut r: i64 = 0i64;
        while r < n {
            if seen.has(r) {
                let bj: RQBodyArr = rels.rel_at(r).bodies_arr();
                let mut b: i64 = 0i64;
                while b < bj.len() {
                    let mut t: i64 = 0i64;
                    while t < n {
                        if !seen.has(t) && ms_reads(bj.body_any(b), rels.rel_at(t).name) > 0i64 {
                            seen.add(t);
                            changed = true;
                        }
                        t = t + 1i64;
                    }
                    b = b + 1i64;
                }
            }
            r = r + 1i64;
        }
    }
    let mut h: i64 = 0i64;
    while h < n {
        if str_eq(rels.rel_at(h).name, head) && seen.has(h) { return true; }
        h = h + 1i64;
    }
    return false;
}

// The program's rel count and the name at a position, for the caller's trace.
pub fn prog_rel_count(root: WAny) -> i64 {
    let prog: RQProgram = root.view::<RQProgram>();
    if !prog.has_rels() { return 0i64; }
    return prog.rels_arr().len();
}
pub fn prog_rel_name(root: WAny, i: i64) -> str {
    return root.view::<RQProgram>().rels_arr().rel_at(i).name;
}

/// Desugar every graph path in the program (rel bodies + the entry query).
/// Returns false with `err` filled on a malformed path; the plan is otherwise
/// rewritten in place (entry replacement via the program's entry edge).
pub fn desugar_program_gpaths(root: WAny, h: &Writ, err: &mut String) -> bool {
    let prog: RQProgram = root.view::<RQProgram>();
    if prog.has_rels() {
        let rels: RQRelArr = prog.rels_arr();
        let nr: i64 = rels.len();
        let mut i: i64 = 0i64;
        while i < nr {
            let rel: RQRel = rels.rel_at(i);
            let bodies: RQBodyArr = rel.bodies_arr();
            let nb: i64 = bodies.len();
            let mut b: i64 = 0i64;
            while b < nb {
                let nq: i64 = gp_desugar_query(bodies.body_any(b), root, h, err);
                if err.len() > 0i64 { return false; }
                if nq != 0i64 {
                    let mut fb: RQBodyArr = rq_fat_bodies(rel.bodies.any(), h);
                    fb.set_body(b, unsafe { WAny::ref_to(nq as *const u8) });
                }
                b = b + 1i64;
            }
            i = i + 1i64;
        }
    }
    let ne: i64 = gp_desugar_query(prog.entry_any(), root, h, err);
    if err.len() > 0i64 { return false; }
    if ne != 0i64 {
        let mut fp: RQProgram = rq_fat_program(root, h);
        fp.entry = WRef::<RQuery>::from_any(unsafe { WAny::ref_to(ne as *const u8) });
    }
    return true;
}

/// The `Aggr` shape only: single-source and join-chain entries are emitted
/// from the plan (`dplan::plan_entry_simple` / `plan_entry_chain`, ADR 0031 R6.2/R6.4).
pub fn lower_rquery_to_rexpr(plan: RQuery, h: &Writ) -> WRef<RExpr> {
    match plan {
        RQuery::Simple(_s) => { logos.lang.panic::panic("ICE: a `Simple` entry reached the relational lowering — it is emitted from the plan (ADR 0031 R6.2)"); return null_rref(); }
        RQuery::Join(_j)  => { logos.lang.panic::panic("ICE: a `Join` entry reached the relational lowering — it is emitted from the plan (ADR 0031 R6.4)"); return null_rref(); }
        RQuery::Aggr(g)   => { return lower_aggr(g, h); }
        RQuery::Find(_f) => { logos.lang.panic::panic("ICE: a `find` entry reached the relational lowering — it is emitted from the plan (ADR 0031 R6.2)"); return null_rref(); }
    }
}

// ── Mapping fusion (ADR 0016 M2b-2): source-param rename ──────────────────────
// A mapping's rel bodies reference the mapping's OWN source param (`from w …`).
// When those rels are spliced into a consumer program (`deem!(g: Services)`),
// the source must become the CONSUMER's param. The compiler prepends the
// mapping's rels and hands the handler `old=new@lo-hi;` — this pass rewrites
// `src_name`/`a_name` == old → new across rels [lo, hi) ONLY (a consumer rel
// or another mapping's rel may legitimately use the old name for its own
// source). Runs BEFORE the gpath desugar, so injected `__reach_*` rels are
// derived from the NEW name and need no renaming of their own. Writes go
// through fat views, so the new name is interned into `h` — after this pass
// the plan is byte-for-byte what the user would have written by hand.
fn rn_step_arr(sa: WAny, old: str, new_name: str, h: &Writ) {
    if sa.is_null() { return; }
    let steps: RQJoinStepArr = sa.view::<RQJoinStepArr>();
    let n: i64 = steps.len();
    let mut i: i64 = 0i64;
    while i < n {
        let st0: RQJoinStep = steps.step_at(i);
        // Edge steps traverse a bound var's field path — no source name.
        if !st0.is_edge && str_eq(st0.src_name, old) {
            let st: RQJoinStep = rq_fat_step(steps.step_any(i), h);
            st.src_name = new_name;
        }
        i = i + 1i64;
    }
}

fn rn_query(qany: WAny, old: str, new_name: str, h: &Writ) {
    let q: RQuery = qany.view::<RQuery>();
    match q {
        RQuery::Simple(s0) => {
            if str_eq(s0.src_name, old) {
                let s: RQSimple = rq_fat_simple(qany, h);
                s.src_name = new_name;
            }
        }
        RQuery::Join(j0) => {
            if str_eq(j0.a_name, old) {
                let j: RQJoin = rq_fat_join(qany, h);
                j.a_name = new_name;
            }
            rn_step_arr(j0.steps.any(), old, new_name, h);
        }
        RQuery::Aggr(g0) => {
            if str_eq(g0.a_name, old) {
                let g: RQAggr = rq_fat_aggr(qany, h);
                g.a_name = new_name;
            }
            if g0.has_steps() { rn_step_arr(g0.steps.any(), old, new_name, h); }
        }
        RQuery::Find(f0) => {
            if str_eq(f0.src_name, old) {
                let f: RQFind = rq_fat_find(qany, h);
                f.src_name = new_name;
            }
        }
    }
}

/// Rename source `old` → `new_name` inside the bodies of rels [lo, hi).
pub fn rename_rel_sources(root: WAny, lo: i64, hi: i64,
                          old: str, new_name: str, h: &Writ) {
    if str_eq(old, new_name) { return; }
    let prog: RQProgram = root.view::<RQProgram>();
    if !prog.has_rels() { return; }
    let rels: RQRelArr = prog.rels_arr();
    let n: i64 = rels.len();
    let mut i: i64 = lo;
    while i < hi && i < n {
        let rel: RQRel = rels.rel_at(i);
        let bodies: RQBodyArr = rel.bodies_arr();
        let nb: i64 = bodies.len();
        let mut b: i64 = 0i64;
        while b < nb {
            rn_query(bodies.body_any(b), old, new_name, h);
            b = b + 1i64;
        }
        i = i + 1i64;
    }
}
