// logos.std.wql.mapping_item — the `mapping` ITEM lowering backend (ADR 0016).
//
// A MAPPING is a PURE RULE MODULE: a named, typed, reusable set of domain
// relations over a source shape — a vocabulary DEFINITION, never an
// executable. You query THROUGH a mapping (the OBDA/R2RML posture), you do
// not call it:
//
//   pub mapping Services(g: &Writ) {
//       pub rel engine(owner: i64, name: str) { from g ** .engine e select (e.parent, e.vs); }
//   }
//   pub deem engines(w: Services) { from engine e select (e.owner, e.name) }   // static
//   Query::compile_with_mapping(text, &cat, "w", Services__rules(), Services__src())  // dynamic
//
// HISTORY: v1 emitted one fn per rel (`Services::engine(&doc)`) because
// fusion did not exist yet; those direct calls conflated definition with
// query, re-materialized dependency rels per call, and made concrete and
// generic mappings different animals (generics never emitted fns). RETIRED —
// all mappings are uniformly pure now.
//
// The handler therefore does two things only:
//   1. sanity-checks the seam inputs (the compiler already parsed and
//      validated signatures; rel BODIES are validated at first consumption,
//      like generics and templates);
//   2. emits the mapping's RUNTIME ARTIFACTS — `<M>__rules() -> str` (the
//      canonical rel-list text) and `<M>__src() -> str` (its source-param
//      name) — which Query::compile_with_mapping consumes (mappings are
//      STATIC-ONLY items; the dynamic side only consumes them).
//
// Per-rel `pub` is retained in the surface: its meaning is now "this rel is
// part of the mapping's consumer-visible vocabulary" (enforcement at the
// consumption seam is a named follow-up; non-pub rels are internals).
package logos.std.wql.mapping_item;

use logos.std.compiler.metaprog;         // ItemList, item_list_new, error
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.std.wql.params;                // MacroParams / parse_macro_params
use logos.lang.str;
use logos.mem.string;

/// Lowering handler behind the `mapping` ITEM (ADR 0016). Invoked by the
/// COMPILER (sema lower_mapping_def) through the token-macro item seam: `ir`
/// points at the RQRelArr the compiler already parsed, `pubs` carries the
/// per-rel visibility the query grammar cannot express. Not a user-facing macro.
#[token_macro]
pub fn __mapping_item(name: str, params: str, pubs: str, natspec: str, rules: str, ir: *const u8) -> ItemList {
    let out: ItemList = item_list_new();
    if name.len() == 0i64 {
        error("mapping item: empty mapping name (compiler seam regression?)");
        return out;
    }
    let mut prm0: MacroParams = macro_params_new();
    parse_macro_params(params, &mut prm0);
    if prm0.n == 0i64 {
        error("mapping item: needs at least one parameter — the source shape (e.g. `g: &Writ`)");
        return out;
    }
    // `ir` (the parsed RQRelArr) and `natspec` arrive for ABI uniformity with
    // the deem handler; a pure rule module consumes neither — the compiler's
    // parse already syntax-checked the bodies, and their SEMANTIC validation
    // happens at first consumption (fusion), uniformly with generic mappings.
    let _ = ir;
    let _ = natspec;
    let _ = pubs;

    // ── the mapping's RUNTIME artifacts (mappings are STATIC-ONLY items; the
    // dynamic side only CONSUMES them): `<M>__rules() -> str` returns the
    // canonical rel-list text, which Query::compile_with_mapping parses with
    // the SAME generated parser and fuses into a dynamically-compiled query;
    // `<M>__src() -> str` names the source param the fusion renames.
    // ── the two artifacts are a QUOTE (ADR 0024 S5) ───────────────────────
    // Both items are the same shape — `pub fn <M>__<what>() -> str { return
    // <literal>; }` — and the only runtime content is the NAME and the
    // literal's CONTENT. So the items are structure and each body is one
    // spliced expression.
    //
    // ⚠ A STRING LITERAL IS THE ONE THING THAT STAYS TEXT, and not for want of
    // a quote: there is no reifier that turns runtime BYTES into a LIT_STR
    // node (logos_parse_as rules are type_param_list / type_ref / expr /
    // wstatic / block / param_list — six, none of them "a literal from these
    // bytes"). Escaping is intrinsic to the literal FORM, so the escape loop
    // builds the literal's source and `parse_expr` reifies it ONCE, the way
    // rexpr_walk reifies a computed integer literal. The loop writes into a
    // String rather than into an Emitter, so nothing here is a chunk.
    //
    // ⚠ The escape set is `"`/`\`/newline — the three bytes that would end or
    // re-open the literal. `prm0.names[0]` needs none (it is an identifier the
    // grammar already accepted), so it is wrapped, not escaped.
    {
        let mut rlit: String = String::new();
        rlit.push_u8(34u8);
        let n2: i64 = rules.len();
        let mut i2: i64 = 0i64;
        while i2 < n2 {
            let c: u8 = str_byte_at(rules, i2);
            if c == 34u8 { rlit.push_str("\\\""); }
            else if c == 92u8 { rlit.push_str("\\\\"); }
            else if c == 10u8 { rlit.push_str("\\n"); }
            else { rlit.push_u8(c); }
            i2 = i2 + 1i64;
        }
        rlit.push_u8(34u8);

        let mut slit: String = String::new();
        slit.push_u8(34u8);
        slit.push_str(prm0.names[0]);
        slit.push_u8(34u8);

        let mut rname: String = String::new();
        rname.push_str(name);
        rname.push_str("__rules");
        let mut sname: String = String::new();
        sname.push_str(name);
        sname.push_str("__src");

        let rid: Ident    = Ident::new(rname.as_str());
        let sid: Ident    = Ident::new(sname.as_str());
        let rl: ExprBlob  = parse_expr(rlit.as_str());
        let sl: ExprBlob  = parse_expr(slit.as_str());
        let q: QuoteItemBlob = quote_item! {
            pub fn #rid() -> str { return #(rl); }
            pub fn #sid() -> str { return #(sl); }
        };
        unsafe { logos_emit_item_blob_subst(&q); }
    }
    return out;
}
