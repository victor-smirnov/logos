// logos.std.wql.join_sel — THE JOIN-STEP STRATEGY DECISION (ADR 0024 S4).
//
// A join step is executed in one of three shapes, and which one is a DECISION:
//
//   HASH — index the step's source by the equi-key ONCE, probe per bound row;
//   TREE — the same, over an ordered index (an Ord-only key type);
//   LOOP — rescan the step's source for every bound row.
//
// Two of the three read the step's source EXACTLY ONCE. That is not a detail of
// how they are emitted, it is the whole difference between a step that can
// stream its source and one that cannot — so the fact has to be available to
// the PLANNER, which decides materialize-vs-stream before any code exists.
// While the cascade lived inside the emitter it ran after the prelude had
// already been built, and the plan could only answer "a join step's source is
// built or rescanned by a strategy the plan does not own yet".
//
// So the decision moved here, ahead of both consumers, and it is made ONCE:
// `plan_walker` decides and records the answer on the step's IR node, and the
// emitter READS it. That ordering is what makes the widening safe. Re-deriving
// the same rule in the emitter would look equivalent and is not — the two sides
// build their type environments separately, and a key that types differently on
// the two sides would select LOOP against a source the plan had already turned
// into a consumed iterator. A plan that reads a spent iterator does not run
// slowly; it silently returns fewer rows.
//
// What lives here is the RULE, in one copy:
//   • `step_terms`   — the step predicate's top-level `&&` conjunction, after
//     const folding. Both sides call it, so a term INDEX means the same thing
//     to both, which is how the emitter can be told WHICH term is the key
//     rather than looking for one itself.
//   • `step_equi_key` — which term supplies the join key.
//   • `step_cascade`  — the key's capabilities select the strategy.
//
// `join_key_caps` remains the single capability seam: the structural-key
// version (ADR 0024 S1/S6) swaps its body for metaprog `has_trait` queries
// without touching anything that reads it.
package logos.std.wql.join_sel;

use logos.std.compiler.metaprog;  // error
use logos.lang.writ.container;    // Writ
use logos.lang.writ.anyval;       // WAny
use logos.std.wql.ir;             // SExpr / SBin / WRef
use logos.std.wql.el;             // ElTypes, EL_TY_*, OP_EQ
use logos.std.wql.codegen;        // infer_ty
use logos.std.wql.optimize;       // TermList / split_and_terms / refs_mask / simplify_sexpr
use logos.std.wql.params;         // MacroParams — the rel registry, for NAMING the node's subject
use logos.std.wql.access_plan;    // MG_JOIN_BUILD — the Arrange node's ground (ADR 0025 §4, S2d)
use logos.mem.string;             // String — the key-vector line's why is composed
use logos.lang.str;

// ── The three shapes ──────────────────────────────────────────────────────
// 0 is NOT one of them: it is "undecided", the value an IR node carries before
// a planner has looked at it. A sentinel distinct from every real answer is
// what lets the emitter tell "the plan chose LOOP" from "no plan ran here",
// and those two must never be confused — the first permits a rescan, the
// second forbids assuming anything at all.
pub fn JS_NONE() -> i32 { return 0i32; }
pub fn JS_HASH() -> i32 { return 1i32; }
pub fn JS_TREE() -> i32 { return 2i32; }
pub fn JS_LOOP() -> i32 { return 3i32; }

pub fn js_name(s: i32) -> str {
    if s == JS_HASH() { return "hash join"; }
    if s == JS_TREE() { return "tree join"; }
    if s == JS_LOOP() { return "loop join"; }
    return "undecided";
}

/// Does this strategy read the step's source exactly once?
///
/// HASH and TREE both build their index in a single pass over the source and
/// then probe the INDEX, never the source again. LOOP is the one that rescans.
/// The planner's single-read proof for a step is this predicate and nothing
/// else, which is why it is written here rather than restated at the caller.
pub fn js_reads_once(s: i32) -> bool {
    return s == JS_HASH() || s == JS_TREE();
}

// ── The key-capability table — THE selector seam ──────────────────────────
// ONE function maps an EL value-type to its {hash, ord, eq} capability row;
// the strategy cascade reads ONLY this. The future structural-key version
// swaps the body for metaprog has_trait queries (Hash / Ord / PartialEq over
// the key's schema type) without touching the cascade.
pub struct KeyCaps { pub hash: bool, pub ord: bool, pub eq: bool }

// ⚠ THE ROWS ARE NOT WRITTEN HERE ANY MORE — they are READ OFF THE TYPE. This
// was a fourth hand-written copy of the identity fact (`i64/str/bool` yes, `f64`
// no), and a fourth thing to remember to edit. `hash` is `ElTy.ident` (the EL's
// normalization is injective, so `==` and a hash agree with the source type's
// equality); `ord` is `ElTy.ord == EL_ORD_OK` (the emitted comparison realizes
// the type's own order); `eq` is admission (`==` is meaningful at all — true for
// f64, which is PartialEq).
//
// ⚠ AND IT IS NOW ASKED OF THE KEY'S OWN TYPE. It used to be asked of the CLASS'S
// REPRESENTATIVE because the caller only held a class, so `join_key_caps(EL_TY_INT)`
// answered about `i64` even when the key was a `u64` — and the join-order licence
// had to re-ask `el_order_faithful` with the NAME to catch it. The key's emitted
// type travels on `StepKey` now (`ktn`), so the capability row is the type's own:
// `hash` is `self_ident` (the map is keyed IN this type — `==` there is the type's
// own equality) AND the backend having a `Hash`/`Eq` instance for it; `ord` is
// `self_ord` AND THE SAME SECOND CONJUNCT; `eq` is admission to the lattice.
//
// ⚠ `hash` HAS TWO CONJUNCTS AND THE SECOND IS NOT ABOUT THE TYPE'S SEMANTICS —
// it is what the stdlib provides. Keeping it as its own conjunct is what lets the
// cascade fall to a lower tier instead of refusing, and what made admitting the
// 128-bit and packed widths (2026-08-05, once their `Hash`/`Eq`/`Ord` impls
// landed) a widening of `el_index_key_ok` rather than a re-derivation here.
//
// ⚠ `ord` CARRIES THAT SECOND CONJUNCT TOO, AND THE LINE ABOVE USED TO DENY IT.
// It read "`ord` is `self_ord`" while the code has always been
// `self_ord && el_index_key_ok(name)` — so a widening of a predicate documented
// as "does the stdlib have Hash+Eq" also admits the ORD tier. Nothing has ever
// caught the mismatch because the two populations coincide over the lattice:
// every row `el_index_key_ok` admits also has an `Ord` instance, before this
// change (12 rows) and after it (18). WHETHER THE TWO SHOULD BE ONE PREDICATE
// IS OPEN — an
// Ord-key predicate and a Hash-key predicate are different questions and would
// diverge the moment a type gains one instance without the other. Recorded here
// as a mismatch now REMOVED FROM THE COMMENT rather than silently kept; splitting
// them is a design decision, not a bug fix.
pub fn join_key_caps_named(name: str) -> KeyCaps {
    let t: ElTy = el_ty(name);
    if t.cls < 0i32 {
        // DEFAULT-DENY on a name this lattice does not enumerate.
        return KeyCaps { hash: false, ord: false, eq: false };
    }
    return KeyCaps { hash: t.self_ident == EL_ID_OK() && el_index_key_ok(name),
                     ord:  t.self_ord   == EL_ORD_OK() && el_index_key_ok(name),
                     eq:   true };
}

/// The CLASS-keyed view, kept for the callers that hold only a class (the
/// dynamic tier's rel validation). Answers about the class's representative,
/// which is exactly what those callers emit.
pub fn join_key_caps(cls: i32) -> KeyCaps {
    if cls == EL_TY_INT() || cls == EL_TY_STR()
       || cls == EL_TY_BOOL() || cls == EL_TY_FLT() {
        return join_key_caps_named(el_class_repr(cls));
    }
    return KeyCaps { hash: false, ord: false, eq: false };
}

// DEV toggle: force the TREE tier for Hash-capable keys — compiles + runs the
// (today unreachable) Ord-only tier end-to-end during development. MUST stay
// false in committed code.
pub fn join_force_tree() -> bool { return false; }

// ── The predicate's terms ─────────────────────────────────────────────────
/// The step predicate, const-folded, and its top-level `&&` conjunction.
///
/// Both the planner and the emitter call this on the same node, so term index
/// `i` denotes the same term on both sides. That identity is load-bearing: the
/// plan records WHICH term it took as the key, and the emitter composes the
/// residual out of the others — neither has to re-run the selection rule.
pub struct StepTerms { pub opt: WRef<SExpr>, pub tl: TermList }

pub fn step_terms(on: WRef<SExpr>, h: &Writ) -> StepTerms {
    let o: WRef<SExpr> = simplify_sexpr(on.any().view::<SExpr>(), h);
    let mut tl: TermList = term_list_new();
    split_and_terms(o, &mut tl);
    return StepTerms { opt: o, tl: tl };
}

// ── The equi-key selection rule — ONE copy ────────────────────────────────
/// An EQUI-TERM is `<bound-side> == <new-side>` (either order) where one side
/// references ONLY already-bound vars / scalar params / constants and the other
/// ONLY the step's NEW row var, AND both sides infer to the SAME value type —
/// a mixed-type `==` (int vs float) would have to hash across a promotion, so
/// it stays residual. The FIRST usable term wins; the rest join the residual
/// (COMPOSITE KEYS DEFERRED — one key column per step today).
///
/// `sel < 0` means no term qualifies, which is the honest form of "this step
/// has no join key" and is what forces LOOP.
pub struct StepKey { pub sel: i64, pub bw: i64, pub pw: i64, pub kty: i32, pub ktn: str }

/// Split ONE candidate term into its BUILD side (the half referencing only the
/// step's new row var) and its PROBE side (the half referencing only already-
/// bound names). `bw == 0` ⇒ the term is not an equi-term of this step.
///
/// The emitter needs this answer too — it is handed the term INDEX by the plan
/// and must still know which half is which — so it is a function rather than
/// two lines inside the selection loop. Which half is which is not a detail of
/// emission: it is the same fact that made the term selectable.
pub struct EquiSides { pub bw: i64, pub pw: i64 }

pub fn equi_term_sides(te: SExpr, new_var: str) -> EquiSides {
    match te {
        SExpr::Bin(b) => {
            if b.op == OP_EQ() {
                let lm: i32 = refs_mask(b.lhs_expr(), new_var);
                let rm: i32 = refs_mask(b.rhs_expr(), new_var);
                if lm == 1i32 && (rm & 1i32) == 0i32 {
                    return EquiSides { bw: b.lhs.any().raw(), pw: b.rhs.any().raw() };
                }
                if rm == 1i32 && (lm & 1i32) == 0i32 {
                    return EquiSides { bw: b.rhs.any().raw(), pw: b.lhs.any().raw() };
                }
            }
        }
        _ => { }
    }
    return EquiSides { bw: 0i64, pw: 0i64 };
}

pub fn step_equi_key(tl: &TermList, new_var: str, t: &ElTypes) -> StepKey {
    let mut i: i64 = 0i64;
    while i < tl.n {
        let te: SExpr = WAny::ref_to(tl.w[i] as *const u8).view::<SExpr>();
        let sd: EquiSides = equi_term_sides(te, new_var);
        if sd.bw != 0i64 {
            let be: SExpr = WAny::ref_to(sd.bw as *const u8).view::<SExpr>();
            let pe: SExpr = WAny::ref_to(sd.pw as *const u8).view::<SExpr>();
            let kb: i32 = infer_ty(be, t);
            let kp: i32 = infer_ty(pe, t);
            if kb == kp {
                return StepKey { sel: i, bw: sd.bw, pw: sd.pw, kty: kb,
                                 ktn: step_key_ty_of(be, pe, t, kb) };
            }
        }
        i = i + 1i64;
    }
    return StepKey { sel: -1i64, bw: 0i64, pw: 0i64, kty: EL_TY_INT(),
                     ktn: el_class_repr(EL_TY_INT()) };
}

/// The type the emitter must PRINT for a step's index map and its two key
/// expressions — the EMITTED type of the term's two halves when they agree, and
/// the class's representative when they do not.
///
/// ⚠ THE DISAGREEMENT CASE IS NOT A FALLBACK, IT IS THE ANSWER. `x.a == y.b` with
/// `a: u32` and `b: i64` is one key only through the EL's normalization, so the
/// map must hold the type that normalization lands in — and each side reaches it
/// by the value-preserving cast `key_norm_body` emits. Printing either side's own
/// type would have declared a map neither expression can be inserted into.
pub fn step_key_ty_of(be: SExpr, pe: SExpr, t: &ElTypes, cls: i32) -> str {
    let bt: str = infer_emit_ty(be, t);
    let pt: str = infer_emit_ty(pe, t);
    if str_eq(bt, pt) { return bt; }
    let r: str = el_class_repr(cls);
    if el_key_reaches(bt, r) && el_key_reaches(pt, r) { return r; }
    // No common type either side can be converted into. Returned as the BUILD
    // side's type so the capability row is asked about a real type and the step
    // degrades to the LOOP tier, whose comparison is the language's own `==`.
    return bt;
}

// ── The cascade ───────────────────────────────────────────────────────────
/// A join step's chosen strategy AND what entailed it. The cascade always
/// produced the choice; recording the ground alongside it is what makes a plan
/// explainable instead of merely reproducible — and now the ground travels ON
/// the plan, so the emitter's trace and the planner's are the same sentence.
pub struct StepSel { pub strat: i32, pub key_ty: i32, pub key_tn: str, pub sel: i64, pub why: str }

pub fn step_cascade(k: StepKey) -> StepSel {
    if k.sel < 0i64 {
        return StepSel { strat: JS_LOOP(), key_ty: k.kty, key_tn: k.ktn, sel: -1i64,
                         why: "no equi-join key — a nested loop is the only shape left" };
    }
    let caps: KeyCaps = join_key_caps_named(k.ktn);
    if caps.hash && !join_force_tree() {
        return StepSel { strat: JS_HASH(), key_ty: k.kty, key_tn: k.ktn, sel: k.sel,
                         why: "the key type is hashable — build once, probe per row" };
    }
    if caps.ord {
        return StepSel { strat: JS_TREE(), key_ty: k.kty, key_tn: k.ktn, sel: k.sel,
                         why: if join_force_tree()
                              { "the tree tier is forced (LOGOS_JOIN_TREE) — the key is hashable but ordered access is being exercised" }
                              else { "the key type is ordered but not hashable — a sorted index, not a hash one" } };
    }
    if caps.eq {
        return StepSel { strat: JS_LOOP(), key_ty: k.kty, key_tn: k.ktn, sel: k.sel,
                         why: "the key type has equality only — no index can be built, so every pair is tested" };
    }
    error("wql!: join key type supports neither Hash, Ord, nor equality — cannot execute this join step (scalar i64/str/bool/f64 keys only today)");
    return StepSel { strat: JS_LOOP(), key_ty: k.kty, key_tn: k.ktn, sel: -1i64,
                     why: "the key type has no usable capability" };
}

/// The whole decision for one classic (non-traversal) step.
pub fn decide_join_step(on: WRef<SExpr>, new_var: str, t: &ElTypes, h: &Writ) -> StepSel {
    let st: StepTerms = step_terms(on, h);
    return step_cascade(step_equi_key(&st.tl, new_var, t));
}

/// The decision for a TRAVERSAL step (`join d.emps e`). Containment has no key
/// and the source expression depends on outer row vars, so no build-once index
/// can exist — it is a nested loop by construction, not by cascade. Stated as a
/// decision anyway so that "why is this a loop" has an answer on the plan
/// rather than only in a comment.
pub fn traversal_step_sel() -> StepSel {
    return StepSel { strat: JS_LOOP(), key_ty: EL_TY_INT(), key_tn: "", sel: -1i64,
                     why: "a traversal step ranges over a field path of an outer row — the source is re-derived per bound row, so no index can be built over it" };
}

/// THE ARRANGE NODE, AUTHORED WHERE THE INDEX IS EMITTED (ADR 0025 §4, S2d).
///
/// It used to be authored by the planner — `AccessPlan::arrange`, one entry per
/// join STEP, keyed by the REL REGISTRY index. Two facts refuted that, and both
/// are measurements rather than opinions:
///
///   • THE MULTIPLICITY IS NOT KNOWN WHERE THE PLAN IS MADE. `decide_join_orders`
///     runs HERE, at emission, after `plan_insert_drains` has finished, and
///     the emitter writes one build phase per step PER CARRIED NEST
///     (`cand_branch` × `chain_nest_frag`). Corpus-measured under the planner-side
///     form: 141 arrange nodes against 594 emitted index bindings. A node that
///     cannot count what is built is not a node layer.
///
///   • THE REGISTRY IS NOT THE SET OF SOURCES. `rel_find_name` resolves only rels
///     — parse-side `rel` blocks and `reg_native` natspec params — so a query
///     whose sources are wql! PARAMS (`&[T]`) registered ZERO rels and the whole
///     plan said nothing: `wql_key_spelling_e2e` traced 0 node lines while its
///     artifact built 44 indexes. Registering those params AS rels was probed and
///     refused: the registry is a CONTRACT that the source has a producer fn
///     (`emit_prelude_oneshot` emits `__wql_<fn>_rel_<r>(…)`), and 97 of 175
///     corpus fixtures stopped compiling. The step's SOURCE VAR is the name that
///     always exists, so the node is keyed by it.
///
/// ⚠ IT LIVES HERE, NOT BESIDE `build_phase_frag`, AND THE REASON IS THE EMITTED
/// TEXT. A generated module inherits the EMITTING module's `use` list verbatim —
/// measured: adding `use logos.std.wql.access_plan;` to `rexpr_walk` put one new
/// `use` line into all 159 corpus dumps. `join_sel` is already on that list and
/// already owns the strategy vocabulary this predicate reads (`JS_LOOP`,
/// `js_reads_once`), so the node's author sits with the decision it reports and
/// the artifact does not move.
///
/// Fires under exactly `build_phase_frag`'s own emitting condition — `JS_LOOP`
/// builds no index — so the count IS the artifact's count by construction. That
/// is stated rather than hidden: the independent oracle for this clause is the
/// per-fixture literal in `plan_nodes_gate.sh` (`d` arranged 3 times, `h` once)
/// and the corpus census, not a second reading of this call.
/// THE NODE'S SUBJECT, and why it is not simply the row var.
///
/// The emitter holds two names for a step's input: the EMITTED source name
/// (`__rel_d_sl` for a rel, the param's own identifier for a slice) and the row
/// VAR the chain binds (`e`, `f` — a self-join names one source under two vars).
/// A node keyed by the var would report "one index over `e` and one over `f`"
/// where the artifact builds two indexes over ONE source `d`, which is the
/// counting claim `plan_nodes_gate` pins. So the registry answers first and the
/// source name is the fallback — which is exactly the blind class, where the
/// registry has no answer and the param's own name is the only name there is.
pub fn node_subject(prm: &MacroParams, src: str, var: str) -> str {
    let ri: i64 = prm.rel_find_src(src);
    if ri >= 0i64 { return prm.rel_names[ri]; }
    if src.len() > 0i64 { return src; }
    return var;
}

pub fn arrange_node(prm: &MacroParams, src: str, var: str, strat: i32) {
    if strat == JS_LOOP() { return; }
    plan_trace(node_subject(prm, src, var), "arrange", MG_JOIN_BUILD(),
        "arranged: the join builds a keyed index over this source's rows before probing it — one per emitted nest, which is what the artifact builds");
}

/// THE SORT NODE'S KEY COLLECTION, RECORDED WHERE IT IS BUILT (ADR 0025 §4, S2d).
///
/// `__ks` is the sort-key vector emitted beside the `__ix<k>` permutations at the
/// three `order by` scaffolding sites. Corpus-measured: 119 of them across 48
/// fixtures, and only 3 of those fixtures' sorts had ANY plan line — the other 46
/// sort a wql! PARAM source, which the rel registry does not resolve, so the
/// plan had nothing to hang a Sort node on.
///
/// ⚠ IT IS NOT A NODE KIND, AND THAT IS A DECISION WITH A MEASUREMENT BEHIND IT.
/// A key vector is not a second materialization: `deem_batch_scan_drain` builds 2
/// `__ks` against 2 Sort nodes and 3 `__ix0` — the third permutation is the
/// aggregate's group-row one, which has NO key vector, which is exactly why `__ks`
/// witnesses a sort scaffolding EXACTLY where `__ix0` over-counts. So `__ks` is
/// the Sort's own FIELD — the key type it collects and the arity of the index
/// vectors it permutes — and it is reported as that field rather than as a kind.
///
/// ⚠ AND IT IS NOT THE PRELUDE SORT. Two different things were called "sort": the
/// prelude's ordered drain of a SOURCE (plan-authored, `MAT_SORT`, what
/// `emit_prelude_oneshot` reads, 4 drain + 3 sort == the 7 `__it_` bindings) and
/// this scaffolding over the MATCHED rows inside the walk. Conflating them is how
/// 119 key vectors sat unclassed against 3 nodes. The verdict word is therefore
/// `key vector`, not `sort`: a line whose fourth field read `sort` would be
/// counted as a node by every reader of this trace.
pub fn sort_key_vector(prm: &MacroParams, src: str, var: str, key_ty: str, nb: i64) {
    if !plan_trace_on() { return; }
    let mut w: String = String::new();
    w.push_str("the sort collects one key per matched row into `__ks` and permutes ");
    w.push_i64(nb);
    w.push_str(" index vector(s) by it — the Sort node's key collection, not a second materialization");
    plan_trace(node_subject(prm, src, var), "key vector", key_ty, string_as_str(&w));
}

// ── THE GROUP FRAME, RECORDED WHERE IT IS DECLARED (ADR 0025 §8, S4-naming) ───
//
// Four columns families, four grounds (`access_plan::AG_*`), four verdict words
// that are FIELDS and not node kinds — the `key vector` precedent above, for the
// same reason: a line whose verdict read `arrange` would be counted as a node by
// every reader of this trace, and the artifact builds no index for a group.
//
// ⚠ THEY LIVE HERE FOR THE REASON `arrange_node` DOES, AND IT IS AN ARTIFACT
// MEASUREMENT, NOT A FILING PREFERENCE. A generated module inherits the EMITTING
// module's `use` list verbatim: putting `use logos.std.wql.access_plan;` into
// `rexpr_walk` (where the group columns are declared) adds one `use` line to
// every corpus dump. `join_sel` is already on `rexpr_walk`'s use list and
// already owns `MG_JOIN_BUILD`, so the grounds travel to the declaration site
// without moving a byte of emitted text — which is this stage's control (the
// corpus snapshot is asserted BYTE-IDENTICAL across it).
//
// ⚠ EACH FIRES INSIDE THE BRANCH THAT DECLARES ITS COLUMN, so the trace count IS
// the artifact's binding count BY CONSTRUCTION rather than by a second
// derivation — and the census gate compares the two per fixture, so a call that
// drifted out of its branch is red rather than merely wrong.

/// `__g_key` — one per emitted batch aggregate. `nagg` is the number of
/// accumulator columns that hang off it, which is the group frame's WIDTH and
/// the one number a reader needs to price the state from a single line.
pub fn group_table_field(prm: &MacroParams, src: str, var: str, key_ty: str, nagg: i64) {
    if !plan_trace_on() { return; }
    let mut w: String = String::new();
    w.push_str("the fold finds a row's group by a linear `==` scan over `__g_key: Vec<");
    w.push_str(key_ty);
    w.push_str(">` (no index is built — this is the group frame's dedup, not an Arrange) and carries ");
    w.push_i64(nagg);
    w.push_str(" accumulator column(s) beside it");
    plan_trace(node_subject(prm, src, var), "group frame", AG_GROUPS(),
               string_as_str(&w));
}

/// `__g_cnt`, and ONLY where an `avg` reads it (S4b).
pub fn group_count_field(prm: &MacroParams, src: str, var: str) {
    plan_trace(node_subject(prm, src, var), "group count", AG_COUNT(),
        "a `Vec<i64>` bumped once per folded row in the INNERMOST loop, declared because some aggregate here is an `avg` and reads it as its denominator — a group table with no `avg` does not declare it and does not pay the bump");
}

/// `__ga_<out>` — one per aggregate, named by its OUTPUT and typed by its
/// accumulator type, because those are the two facts that differ between two
/// cells of the same frame.
pub fn group_accum_field(prm: &MacroParams, src: str, var: str, out: str, acc_ty: str) {
    if !plan_trace_on() { return; }
    let mut w: String = String::new();
    w.push_str("one accumulator cell per group for output `");
    w.push_str(out);
    w.push_str("` in the ACCUMULATOR type `");
    w.push_str(acc_ty);
    w.push_str("` (which is not the output type wherever a finalize step exists — `avg`, a UDA's `fin`), folded in the row loop and finalized AT THE READ in the output phase: a single pass, no finalize copy");
    plan_trace(node_subject(prm, src, var), "accumulator", AG_ACCUM(),
               string_as_str(&w));
}

/// `__g_row` — the representative class's column and nobody else's (S4c).
pub fn group_rep_row_field(prm: &MacroParams, src: str, var: str) {
    plan_trace(node_subject(prm, src, var), "representative row", AG_REP_ROW(),
        "a clause above the group names a source row, so each group records the base-row ordinal of the row that created it and the output phase re-binds that row by index — the one thing in this frame a batch pull cannot supply, and the reason this query's base is drained");
}
