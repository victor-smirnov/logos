// logos.std.wql.reflect — schema field-type REFLECTION at metaprog time
// (ADR 0012 §10.3, Phase 5 ergonomics). The static `wql!` / `trama!` backends
// know the SOURCE / context type by NAME (e.g. `from xs:[Person] x`), but the
// EL parser interns every field key with the i64 default — so until now the
// author had to RESTATE each field's type via a `with name:str, …` clause.
//
// This module closes that gap by READING the named struct's declaration out of
// the user-module AST (the compiler hands metaprog hooks an owning view, the
// same `OView` the derive macros walk) and STAMPING each field's true value-type
// onto the parser. The source type is explicit in the block, so the lookup is a
// pure compile-time reflection — no runtime cost, no extra surface.
//
//   schema field `name: str`  →  set_field_ty("name", EL_TY_STR)
//   schema field `age:  i64`  →  set_field_ty("age",  EL_TY_INT)
//
// Field/struct names are matched with `str` semantics directly (we do NOT route
// through `OView::find_template_decl`, whose `&[u8]` signature would force a
// slice round-trip); the walk mirrors `find_template_decl` over the module's
// top-level ITEMS array, comparing each item's NAME to the wanted struct name.
package logos.std.wql.reflect;

use logos.std.compiler.metaprog;   // OView, SView, oview_module_ast
use logos.lang.writ.anyval;        // WAny
use logos.std.wql.el;              // ElTypes, EL_TY_*, el_ty_of_name, EL_TY_CAP
use logos.lang.str;
use logos.mem.string;              // String — the overflow diagnostic's buffer

// Byte-equality of an `SView` (borrowed AST bytes) against a `str`.
fn sview_eq_str(sv: SView, name: str) -> bool {
    if sv.len != (name.len() as u64) { return false; }
    let n: i64 = name.len();
    let mut i: i64 = 0i64;
    while i < n {
        let a: u8 = unsafe { *((sv.ptr as i64 + i) as *const u8) };
        if a != str_byte_at(name, i) { return false; }
        i = i + 1i64;
    }
    return true;
}

// Materialise an `SView`'s borrowed bytes as a `str` view (shares the AST arena;
// valid for the OView's lifetime). Empty `str` for a null view.
fn sview_str(sv: SView) -> str {
    if sv.ptr == (0 as *const u8) || sv.len == (0 as u64) { return ""; }
    return unsafe { str_from_raw(sv.ptr, sv.len as i64) };
}

// Find the top-level MODULE item whose NAME equals `struct_name` — ANY item, of any
// kind: a struct, a schema, a `type` alias, an enum. Returns its AST node handle (a
// `WAny` Ref), or a null WAny if not found. Walks the module ITEMS array directly
// (the `find_template_decl` shape, but `str`-keyed).
//
// ⚠ THIS IS THE RAW ITEM LOOKUP AND IT IS NOT WHAT A CALLER WANTING A ROW SCHEMA
// SHOULD ASK. It matches on the name alone, so `type Prec = Rec;` answers to `Prec`
// with the ALIAS node — whose field count is 0, which reads to every caller as "a
// struct with no fields" and not as "you asked the wrong question". Use
// `find_struct_decl`, which resolves the spelling first and then requires the answer
// to BE a schema. `resolve_alias_name` is the one legitimate caller of this raw form:
// it needs the alias node itself.
pub fn find_decl_by_name(view: &OView, struct_name: str) -> WAny {
    let root: WAny = view.root();
    let items: WAny = view.tiny_map_get(root, 2 as u8);   // ITEMS = 2
    if items.is_null() { return WAny::Ref(0i64 as *const u8); }
    let n: u64 = view.array_len(items);
    let mut i: u64 = 0 as u64;
    while i < n {
        let item: WAny = view.array_get(items, i);
        let nm: SView = view.ast_node_name(item);
        if sview_eq_str(nm, struct_name) { return item; }
        i = i + (1 as u64);
    }
    return WAny::Ref(0i64 as *const u8);
}

// ── A SPELLING IS NOT A TYPE ────────────────────────────────────────────────
// `type Score = i64;` and `i64` are ONE type written two ways, and everything the
// query stack asks about a declared type — is this key's emitted comparison its
// own order (`el::el_order_faithful`), does this value survive the EL's `as i64`
// (`el::el_int_fits_i64`), is this column's class in the lattice at all
// (`el::el_class_lookup`) — is a question about the TYPE. Every one of them was
// answered from the spelling the author happened to use.
//
// ⚠ MEASURED, AND IT COST A CORRECT PLAN ITS LICENCE. `pub s: Score` with
// `pub type Score = i64;`, sorted over a 3-source join: `considered() == 0`, with
// the plan's own ground saying the key is "outside the EL scalar lattice … nothing
// is known about the comparison the backend would emit for it" — one line below the
// code that resolved the same key to `Vec<i64>` and emitted the i64 comparison.
// Changing ONE token, `Score` → `i64`, restored all four candidates. The refusal
// was the DEFAULT-DENY branch, which is right for a type nobody has checked and
// wrong for a name that denotes one that has been.
//
// ⚠ SO THE RESOLUTION HAPPENS AT THE REFLECTION BOUNDARY, ONCE, and not at each
// question. `el` sits below this module and holds no module view, so a name that
// reaches it must already BE the type: `stamp_types_from_schema` (struct fields),
// `stamp_udfs_from_module` (UDF return types) and `rexpr_walk`'s rel-column and
// scalar-param stamping all pass what they read through here before it is recorded
// on an `ElTypes`. A spelling that survives that far is one this compiler genuinely
// cannot resolve, and default-deny is then the honest answer.
//
// TYPE_ALIAS is la::Code 72 — `{ CODE: TYPE_ALIAS, NAME: $2, TYPE_PARAMS: $3,
// TYPE: $5 }` (logos.peg) — so the alias's target is the node's TYPE(3) child and
// its NAME(1) is the name to ask about next.
fn LA_TYPE_ALIAS() -> u64 { return 72 as u64; }

// The two item kinds that HAVE a FIELDS(22) array a row schema can be read out of:
// `struct` (la::Code 50) and `schema` (la::Code 256, ADR 0011).
fn LA_STRUCT() -> u64     { return 50 as u64; }
fn LA_SCHEMA_DEF() -> u64 { return 256 as u64; }

// ── AN ELEMENT TYPE IS A SPELLING TOO ───────────────────────────────────────
/// THE ROW-SCHEMA LOOKUP: the declaration whose fields describe the rows of a source
/// spelled `name`. Empty when `name` denotes nothing this module declares, or denotes
/// something that is not a schema.
///
/// ⚠⚠ MEASURED, ONE TOKEN APART, AND IT MISCOMPILED. `as_: &[Rec]` over
/// `Rec { k: i64, s: f64 }` with `order by a.s` is refused correctly (`WG_KEY_ORDER`,
/// key `f64`, `considered()` 0). Change the parameter to `as_: &[Prec]` with
/// `pub type Prec = Rec;` — nothing else — and the plan reported `WG_ADMITTED`,
/// carried four nests, and the build then failed with `expected i64, got f64`,
/// because `stamp_types_from_schema` had passed the spelling `Prec` to
/// `find_decl_by_name`, got the TYPE_ALIAS node back, read 0 fields off it, and left
/// every field at the i64 baseline. The previous round installed exactly this
/// resolution for a struct's FIELD types and stopped there; the ELEMENT type naming
/// the struct went unresolved, so the fields were never reached to be resolved.
///
/// ⚠ SO THE RULE IS: A SPELLING IS RESOLVED WHERE IT IS READ, and reading a schema
/// off a name happens HERE — one function, so a new call site cannot forget it. The
/// kind test is an ALLOWLIST, not a TYPE_ALIAS blocklist: after resolution the answer
/// must be an item that HAS fields, and anything else (an enum, a fn, an unresolvable
/// alias to `[i64; 4]`) is "no schema" rather than "a schema with no fields".
pub fn find_struct_decl(view: &OView, name: str) -> WAny {
    let none: WAny = WAny::Ref(0i64 as *const u8);
    if view.holder == (0 as *mut u8) { return none; }
    let decl: WAny = find_decl_by_name(view, resolve_alias_name(view, name));
    if decl.is_null() { return none; }
    let code: u64 = view.ast_node_code(decl) & (0xFFFF as u64);
    if code != LA_STRUCT() && code != LA_SCHEMA_DEF() { return none; }
    return decl;
}

// Does `nm` name one of `decl`'s OWN type parameters? The question that separates
// `type Ph<T> = i64` (resolvable — the arguments cannot change the answer) from
// `type El<T> = T` (not — the answer IS an argument, and this module does not have
// it). Asked of the declaration rather than guessed from the shape of the name.
fn names_own_param(view: &OView, decl: WAny, nm: str) -> bool {
    let np: u64 = view.ast_type_param_count(decl);
    let mut i: u64 = 0 as u64;
    while i < np {
        if sview_eq_str(view.ast_type_param_name(decl, i), nm) { return true; }
        i = i + (1 as u64);
    }
    return false;
}

// THE resolver: the type `name` denotes, after following this module's `type`
// aliases. Returns `name` itself when there is nothing to follow.
//
// ⚠ FOUR SPELLINGS REACH IT AND IT ANSWERS FOR EACH, deliberately rather than by
// falling through:
//   • an admitted scalar (`i64`, `str`, …) — returned untouched without a walk. No
//     module item can shadow a primitive, so the lookup would be wasted work on the
//     overwhelmingly common case;
//   • an alias chain (`type A = B; type B = i64;`) — followed to the type, bounded
//     at 8 hops and stopped by a self-reference, because a metaprogram that loops
//     is a compiler that hangs and the AST here is not known to be acyclic;
//   • a GENERIC alias — followed only when its target does NOT name one of its own
//     parameters. A field's declared type reaches this module as the bare NAME(1)
//     of its type node with the ARGUMENTS ALREADY DROPPED, so `Ph<i64>` arrives as
//     `Ph`: for `type Ph<T> = i64` the target is a fixed type and the arguments
//     could not have changed it, and denying that key its licence would be denying
//     it for how it was spelled; for `type El<T> = T` the target IS the parameter,
//     whose argument this module cannot see, and answering from `T` would be
//     answering from data it does not have. The parameter list is on the alias node
//     (TYPE_PARAMS = 27), so the two cases are separated by asking it rather than by
//     refusing both;
//   • an alias to a type with no name of its own (`type Buf = [i64; 4]`, `&T`) —
//     the target node carries no NAME, so the walk stops and returns the last name
//     it had. Neither name is in the lattice and neither should be.
pub fn resolve_alias_name(view: &OView, name: str) -> str {
    if view.holder == (0 as *mut u8) { return name; }
    if name.len() == 0i64 { return name; }
    if el_class_lookup(name) >= 0i32 { return name; }
    let mut cur: str = name;
    let mut hops: i64 = 0i64;
    while hops < 8i64 {
        let decl: WAny = find_decl_by_name(view, cur);
        if decl.is_null() { return cur; }
        if (view.ast_node_code(decl) & (0xFFFF as u64)) != LA_TYPE_ALIAS() { return cur; }
        let tgt: WAny = view.ast_type_child(decl);
        if tgt.is_null() { return cur; }
        let nm: str = sview_str(view.ast_node_name(tgt));
        if nm.len() == 0i64 { return cur; }
        if str_eq(nm, cur) { return cur; }
        if names_own_param(view, decl, nm) { return cur; }
        cur = nm;
        if el_class_lookup(cur) >= 0i32 { return cur; }
        hops = hops + 1i64;
    }
    return cur;
}

// Look up the declared Logos TYPE NAME of field `field_name` within the struct
// node `decl` (an AST item handle from `find_decl_by_name`). Returns an empty
// `str` if the field is absent. This is the per-field reflection primitive.
pub fn field_type_name(view: &OView, decl: WAny, field_name: str) -> str {
    if decl.is_null() { return ""; }
    let nf: u64 = view.ast_struct_field_count(decl);
    let mut i: u64 = 0 as u64;
    while i < nf {
        let fld: WAny = view.ast_struct_field(decl, i);
        let fnm: SView = view.ast_field_name(fld);
        if sview_eq_str(fnm, field_name) {
            return sview_str(view.ast_field_type_name(fld));
        }
        i = i + (1 as u64);
    }
    return "";
}

// AST type-node codes (la::Code, include/logos/compiler/ast.hpp). A field whose
// TYPE node is one of these is a COLLECTION whose ELEMENT type drives a `for`
// loop var's binding: `[T; N]` (ARR_TYPE), `&[T]` (SLICE_TYPE), `[T]`
// (UNSIZED_SLICE_TYPE). The element type is the node's TYPE(3) child.
fn LA_ARR_TYPE()           -> u64 { return 64 as u64; }
fn LA_SLICE_TYPE()         -> u64 { return 111 as u64; }
fn LA_UNSIZED_SLICE_TYPE() -> u64 { return 236 as u64; }

// Is `code` one of the collection type-node codes (array / slice / unsized slice)?
// The AST TOM's `schema_type_code` packs the la::Code in the low bits with a
// high-bit namespace tag (e.g. `[Item;3]` = 0x1_0000_0000_0040 = tag<<48 | 64),
// so mask to the low 16 bits (la codes are all < 256) before comparing.
fn is_collection_type_code(code: u64) -> bool {
    let c: u64 = code & (0xFFFF as u64);
    return c == LA_ARR_TYPE()
        || c == LA_SLICE_TYPE()
        || c == LA_UNSIZED_SLICE_TYPE();
}

// The declared ELEMENT type NAME of field `field_name` within struct node `decl`,
// IF that field's type is a collection (`[T; N]` / `&[T]` / `[T]`) — else empty.
// This is the loop-var reflection primitive: `for v in ctx.field` binds `v` to
// this element type (and its fields are reflected in turn). A scalar/struct field
// (not a collection) returns "" (nothing to iterate over element-wise).
pub fn field_element_type_name(view: &OView, decl: WAny, field_name: str) -> str {
    if decl.is_null() { return ""; }
    let nf: u64 = view.ast_struct_field_count(decl);
    let mut i: u64 = 0 as u64;
    while i < nf {
        let fld: WAny = view.ast_struct_field(decl, i);
        let fnm: SView = view.ast_field_name(fld);
        if sview_eq_str(fnm, field_name) {
            let tynode: WAny = view.ast_type_child(fld);          // TYPE(3) node
            if tynode.is_null() { return "Dtynull"; }
            let code: u64 = view.ast_node_code(tynode);
            if !is_collection_type_code(code) { return ""; }
            // The element type is the collection node's own TYPE(3) child; its
            // NAME(1) is the element struct/type name.
            let elem: WAny = view.ast_type_child(tynode);
            if elem.is_null() { return "Delemnull"; }
            let en: str = sview_str(view.ast_node_name(elem));
            if en.len() == 0i64 { return "Dennull"; }
            return en;
        }
        i = i + (1 as u64);
    }
    return "";
}

// Does struct node `decl` declare a field named `field_name`? (Existence test —
// `field_type_name`'s "" conflates absent-field with a nameless type node like
// `&[T]`'s SLICE_TYPE, so path validation needs the explicit probe.)
pub fn has_field(view: &OView, decl: WAny, field_name: str) -> bool {
    if decl.is_null() { return false; }
    let nf: u64 = view.ast_struct_field_count(decl);
    let mut i: u64 = 0 as u64;
    while i < nf {
        let fld: WAny = view.ast_struct_field(decl, i);
        if sview_eq_str(view.ast_field_name(fld), field_name) { return true; }
        i = i + (1 as u64);
    }
    return false;
}

// AST type-node code for a generic instantiation in type position (`Vec<T>` —
// NAME(1) = the head name, ITEMS(2) = the type-arg array).
fn LA_GENERIC_INST() -> u64 { return 92 as u64; }

// The declared ELEMENT type NAME of field `field_name` within struct node `decl`,
// IF that field's type is a TRAVERSABLE collection — the wql! edge-step (slice D)
// reflection primitive. Covers:
//   • the slice/array family (`[T; N]` / `&[T]` / `[T]`) — element = the
//     collection node's TYPE(3) child's name (field_element_type_name's rule);
//   • `Vec<T>` — a GENERIC_INST whose head NAME is `Vec` with exactly one
//     type-arg — element = ITEMS(2)[0]'s name.
// Everything else (scalar / plain struct / &T / Box<T> / non-Vec generics)
// returns "" — the caller diagnoses with the field's declared type text.
//
// KIND companion (`field_traversal_kind`): 1 = Vec<T> — the wql! emitter must
// hoist a `.as_slice()` view (a Vec field is indexed through the Index-trait
// call, whose fat-element deref the backend does not yet lower — the slice
// spelling is the native, verified path); 2 = the slice/array family —
// natively indexable in place; 0 = not traversable.
pub fn field_traversal_kind(view: &OView, decl: WAny, field_name: str) -> i32 {
    if decl.is_null() { return 0i32; }
    let nf: u64 = view.ast_struct_field_count(decl);
    let mut i: u64 = 0 as u64;
    while i < nf {
        let fld: WAny = view.ast_struct_field(decl, i);
        if sview_eq_str(view.ast_field_name(fld), field_name) {
            let tynode: WAny = view.ast_type_child(fld);
            if tynode.is_null() { return 0i32; }
            let code: u64 = view.ast_node_code(tynode);
            if is_collection_type_code(code) { return 2i32; }
            if (code & (0xFFFF as u64)) == LA_GENERIC_INST() {
                if str_eq(sview_str(view.ast_node_name(tynode)), "Vec") { return 1i32; }
            }
            return 0i32;
        }
        i = i + (1 as u64);
    }
    return 0i32;
}

pub fn field_traversal_elem(view: &OView, decl: WAny, field_name: str) -> str {
    if decl.is_null() { return ""; }
    let nf: u64 = view.ast_struct_field_count(decl);
    let mut i: u64 = 0 as u64;
    while i < nf {
        let fld: WAny = view.ast_struct_field(decl, i);
        let fnm: SView = view.ast_field_name(fld);
        if sview_eq_str(fnm, field_name) {
            let tynode: WAny = view.ast_type_child(fld);          // TYPE(3) node
            if tynode.is_null() { return ""; }
            let code: u64 = view.ast_node_code(tynode);
            if is_collection_type_code(code) {
                let elem: WAny = view.ast_type_child(tynode);
                if elem.is_null() { return ""; }
                return sview_str(view.ast_node_name(elem));
            }
            if (code & (0xFFFF as u64)) == LA_GENERIC_INST() {
                let head: str = sview_str(view.ast_node_name(tynode));
                if !str_eq(head, "Vec") { return ""; }
                let args: WAny = view.tiny_map_get(tynode, 2 as u8);   // ITEMS = 2
                if args.is_null() { return ""; }
                if view.array_len(args) != (1 as u64) { return ""; }
                let a0: WAny = view.array_get(args, 0 as u64);
                return sview_str(view.ast_node_name(a0));
            }
            return "";
        }
        i = i + (1 as u64);
    }
    return "";
}

// ── FN-declaration reflection (UDF / UDA — ADR 0012 user functions) ─────────
// The wql!/trama! EL resolves non-builtin call names against the TRIGGER
// module's top-level `fn` items. These readers mirror the struct walk above:
// find the FN item by name, read its arity (PARAMS(4).ITEMS(2) length) and its
// declared RETURN type NAME (RET_TYPE(6).NAME(1)). Only top-level `fn` items
// participate (code FN=10 — extern fns, methods, and nested fns excluded;
// IMPORTED fns are invisible here: `oview_module_ast` sees the trigger
// module's AST only, which is the documented UDF visibility rule).
fn LA_FN() -> u64 { return 10 as u64; }

// Find the top-level `fn` item named `fn_name` (code-checked: a same-named
// struct does NOT match). Null WAny when absent.
pub fn find_fn_decl(view: &OView, fn_name: str) -> WAny {
    let root: WAny = view.root();
    let items: WAny = view.tiny_map_get(root, 2 as u8);   // ITEMS = 2
    if items.is_null() { return WAny::Ref(0i64 as *const u8); }
    let n: u64 = view.array_len(items);
    let mut i: u64 = 0 as u64;
    while i < n {
        let item: WAny = view.array_get(items, i);
        if (view.ast_node_code(item) & (0xFFFF as u64)) == LA_FN() {
            let nm: SView = view.ast_node_name(item);
            if sview_eq_str(nm, fn_name) { return item; }
        }
        i = i + (1 as u64);
    }
    return WAny::Ref(0i64 as *const u8);
}

// Declared parameter COUNT of fn item `decl` (0 for a null/param-less decl).
pub fn fn_param_count(view: &OView, decl: WAny) -> i64 {
    if decl.is_null() { return 0i64; }
    let params: WAny = view.tiny_map_get(decl, 4 as u8);   // PARAMS = 4
    if params.is_null() { return 0i64; }
    let inner: WAny = view.tiny_map_get(params, 2 as u8);  // ITEMS = 2
    if inner.is_null() { return 0i64; }
    return view.array_len(inner) as i64;
}

// Declared RETURN type NAME of fn item `decl` ("" when the fn returns unit or
// the return type is not a named type — both out of the EL lattice anyway).
pub fn fn_ret_type_name(view: &OView, decl: WAny) -> str {
    if decl.is_null() { return ""; }
    let rt: WAny = view.tiny_map_get(decl, 6 as u8);       // RET_TYPE = 6
    if rt.is_null() { return ""; }
    return sview_str(view.ast_node_name(rt));
}

// Register EVERY top-level `fn` of the trigger module as a UDF-table entry
// (name → {return EL class, return type name, arity}) so the shared codegen
// (emit_call / infer_ty / returns_string / check_calls) can resolve
// non-builtin call names. Eager module-wide registration keeps the emit paths
// signature-stable (they already thread &ElTypes); builtins shadow same-named
// entries at LOOKUP time (emit_call checks the builtin registry first).
pub fn stamp_udfs_from_module(view: &OView, t: &mut ElTypes) {
    if view.holder == (0 as *mut u8) { return; }
    let root: WAny = view.root();
    let items: WAny = view.tiny_map_get(root, 2 as u8);    // ITEMS = 2
    if items.is_null() { return; }
    let n: u64 = view.array_len(items);
    let mut i: u64 = 0 as u64;
    while i < n {
        let item: WAny = view.array_get(items, i);
        if (view.ast_node_code(item) & (0xFFFF as u64)) == LA_FN() {
            let nm: str = sview_str(view.ast_node_name(item));
            if nm.len() > 0i64 {
                // Through the alias table first: a UDF declared `-> Score` returns
                // an i64, and `el_ret_class` on the spelling would have reported an
                // out-of-lattice return and refused the call at its use site.
                let rn: str = resolve_alias_name(view, fn_ret_type_name(view, item));
                t.udf_add(nm, el_ret_class(rn), rn, fn_param_count(view, item));
            }
        }
        i = i + (1 as u64);
    }
}

// Populate the name→value-type dictionary `t` with the value-type the named
// struct declares for EACH of its fields (Option B: the IR carries names, so we
// type every field of the bound schema — the codegen queries only the names it
// actually references, so typing all fields is harmless and matches the old
// stamp-what-was-interned behavior). A struct that cannot be found (unknown name,
// or no AST loaded) is a no-op: the dict keeps the i64 baseline (scalar params
// from the macro param list are seeded separately and still type their names).
//
// `view` is a fresh module-AST view; `t` the type dictionary the handler passes
// to the codegen.
pub fn stamp_types_from_schema(view: &OView, t: &mut ElTypes, struct_name: str,
                               row_var: str) {
    if view.holder == (0 as *mut u8) { return; }
    // ⚠ THROUGH THE ALIAS TABLE, exactly as the field type below is. `struct_name` is
    // an ELEMENT TYPE SPELLING — `&[Prec]` reaches here as `Prec` — and the raw item
    // lookup answers a `type Prec = Rec;` with the alias node, whose field count is
    // 0: the loop body then never runs and every field silently keeps the i64
    // baseline. That is the miscompile recorded on `find_struct_decl`.
    let decl: WAny = find_struct_decl(view, struct_name);
    if decl.is_null() { return; }
    let nf: u64 = view.ast_struct_field_count(decl);
    let mut i: u64 = 0 as u64;
    while i < nf {
        let fld: WAny = view.ast_struct_field(decl, i);
        let fnm: str = sview_str(view.ast_field_name(fld));
        // The DECLARED name resolved through the module's aliases: a `u64` field
        // must not come back out of the emitter as `i64` (ADR 0024 S3), and a
        // `Score` field must not be a type nothing is known about when `Score` IS
        // i64 (see `resolve_alias_name`).
        let tyname: str = resolve_alias_name(view, sview_str(view.ast_field_type_name(fld)));
        if fnm.len() > 0i64 && tyname.len() > 0i64 {
            // KEYED ON THE BINDING. `row_var` is the row variable this schema
            // was bound to at the scan (`from as a` → "a"); the pair (a, n) is
            // what a field step asks about, and it is unique where the bare
            // name "n" is not: a second joined source declaring `n` used to
            // overwrite the first's type in the flat dict and re-type BOTH.
            if row_var.len() > 0i64 { t.field_bind_named(row_var, fnm, tyname); }
            // The flat entry is what a name with NO owner resolves through — a
            // scalar param, the group key, an aggregate output. A column lands
            // here too, but only as the answer of last resort: it is ambiguous
            // by construction, and every field step that HAS an owner (a row
            // var, or its base's declared type) reads a keyed table instead.
            t.set_ty_named(fnm, tyname);
        }
        i = i + (1 as u64);
    }
    // The SAME fields, keyed by the STRUCT — what a nested path resolves
    // against, and it walks the schema graph so `a.b.c.d` resolves too.
    stamp_schema_by_type(view, t, struct_name);
    report_ty_overflow(t);
}

/// Record struct `sname`'s fields under the TYPE, and recurse into every field
/// whose own type is a struct.
///
/// ⚠ A NESTED PATH HAS NO ROW VAR. `codegen::root_ident_name` reports "" for
/// `a.b.c` — a field whose base is itself a field — so before this existed the
/// only key left for `c` was the bare name, and `Inner { c: u64 }` reached the
/// emitter as `Other { c: i64 }`'s type whenever some other source declared a
/// `c`. Measured: `select a.b.c` over those two structs failed with "expected
/// i64, got u64". The type of `a.b` IS a struct name, so (that name, `c`) is a
/// key as precise as (row var, column), and the resolution is the same one step
/// deeper.
///
/// ⚠ THE WALK IS KEYED BY TYPE, NOT BY PATH, and that is what bounds it: a
/// struct is stamped once however many paths reach it, so the table grows with
/// the schema graph and not with the number of routes through it. The fields are
/// written BEFORE the recursion, so `type_stamped` is already true when a cycle
/// comes back around — a self-referential schema terminates.
fn stamp_schema_by_type(view: &OView, t: &mut ElTypes, sname: str) {
    let ty_of: str = resolve_alias_name(view, sname);
    if ty_of.len() == 0i64 { return; }
    if t.type_stamped(ty_of) { return; }
    let decl: WAny = find_struct_decl(view, ty_of);
    if decl.is_null() { return; }
    let nf: u64 = view.ast_struct_field_count(decl);
    let mut i: u64 = 0 as u64;
    while i < nf {
        let fld: WAny = view.ast_struct_field(decl, i);
        let fnm: str = sview_str(view.ast_field_name(fld));
        let tyname: str = resolve_alias_name(view, sview_str(view.ast_field_type_name(fld)));
        if fnm.len() > 0i64 && tyname.len() > 0i64 { t.type_bind_named(ty_of, fnm, tyname); }
        i = i + (1 as u64);
    }
    let mut k: u64 = 0 as u64;
    while k < nf {
        let fld2: WAny = view.ast_struct_field(decl, k);
        let tn2: str = resolve_alias_name(view, sview_str(view.ast_field_type_name(fld2)));
        if tn2.len() > 0i64 && el_class_lookup(tn2) < 0i32 {
            stamp_schema_by_type(view, t, tn2);
        }
        k = k + (1 as u64);
    }
}

/// Turn a recorded binding-table overflow into ONE readable diagnostic.
///
/// `el` records the drop where it happens and deliberately imports no metaprog
/// channel; this is the other half. Called from every stamper — `claim_overflow`
/// makes the message appear once no matter how many stampers run.
///
/// ⚠ NOT a warning. A dropped binding types its column `i64`, which is a WRONG
/// TYPE with no other symptom — a silent miscompile on a wide query. The build
/// fails instead.
pub fn report_ty_overflow(t: &mut ElTypes) {
    if !t.claim_overflow() { return; }
    let mut m: String = String::new();
    m.push_str("wql!: type-dictionary capacity (");
    m.push_i64(EL_TY_CAP());
    m.push_str(" bindings) exhausted — the binding `");
    if t.overflow_var().len() > 0i64 {
        m.push_str(t.overflow_var());
        m.push_str(".");
    }
    m.push_str(t.overflow_key());
    m.push_str("` and ");
    m.push_i64(t.overflow_count() - 1i64);
    m.push_str(" further one(s) were dropped, and a dropped binding would be emitted with the `i64` baseline instead of its declared type. Reduce the number of columns the query's sources declare, or raise `el::EL_TY_CAP`.");
    error(unsafe { str_from_raw(m.as_ptr(), m.len()) });
}
