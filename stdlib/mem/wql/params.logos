// logos.std.wql.params — the SHARED macro parameter-list parser (ADR 0012 §6,
// parameterized-resource surface). Both `trama!(<params>){ … }` and
// `deem!(<params>){ … }` carry a GENUINE Logos parameter list in the parens: the
// handler re-emits it VERBATIM into the generated fn signature (the compiler
// parses + type-checks it), and ALSO parses it here to drive schema reflection
// + value-typing. ONE mechanism, two consumers.
//
// Per param we record:
//   • name       — the parameter name (borrowed surface slice);
//   • ty         — the CORE type name: any leading `&` / `&mut` and a slice
//                  wrapper are stripped (`&Order` → `Order`, `&[Emp]` → `Emp`,
//                  `str` → `str`) — enough for scalar/schema classification,
//                  `el_ty_of_name`, and the wql! source row type;
//   • is_slice   — the type was a slice/array collection (`&[T]` / `[T]` /
//                  `[T; N]`): a wql! query SOURCE (`from <name> <var>`).
//
// Robust to trailing commas + arbitrary interior whitespace; balanced
// brackets/parens/angles inside a type (`[T; N]`, `Foo<Bar>`) don't split on
// their internal commas (a nesting depth is tracked).
package logos.std.wql.params;

use logos.lang.str;
use logos.lang.writ.anyval;   // WAny — the parsed query root (ADR 0024 S0)
use logos.mem.string;   // String — native_use_text builds the chunk's use-decl text
use logos.mem.collections.vec;   // per-module use-decl dedup

fn mp_is_space(c: u8) -> bool { return c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8; }
fn mp_is_alpha(c: u8) -> bool {
    return (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) || c == 95u8;
}
fn mp_is_digit(c: u8) -> bool { return c >= 48u8 && c <= 57u8; }
fn mp_is_alnum(c: u8) -> bool { return mp_is_alpha(c) || mp_is_digit(c); }

unsafe fn mp_str_range(src: str, start: i64, len: i64) -> str {
    let l: i64 = if len < 0i64 { 0i64 } else { len };
    return str_from_raw((src.as_ptr() as i64 + start) as *const u8, l);
}

// ── ADR 0016: generated-fn visibility marker ────────────────────────────────
// A leading `-` on a generated fn name marks it NON-pub (a private mapping
// rel — `rel r(…)` without `pub` in a `mapping` item). The marker travels
// inside the fn_name thread through the walk/emit pipeline; every site that
// EMBEDS the name into emitted text strips it via `vis_strip`, and
// `emit_fn_quote_blob` (rexpr_walk) — the shared fn SHELL every Deem emitter
// goes through — chooses the `fn` or the `pub fn` quote from `vis_is_priv`. `-`
// cannot begin a Logos identifier, so the marker is unambiguous. Deem's rel
// helpers BUILD a name with that prefix rather than writing `"fn "`: since
// ADR 0024 S5 the visibility of a generated item is decided in exactly one
// place.
pub fn vis_is_priv(fn_name: str) -> bool {
    return fn_name.len() > 0i64 && str_byte_at(fn_name, 0i64) == 45u8;
}
pub fn vis_strip(fn_name: str) -> str {
    if vis_is_priv(fn_name) {
        return unsafe { mp_str_range(fn_name, 1i64, fn_name.len() - 1i64) };
    }
    return fn_name;
}

// ── RelSet — a set of rel registry indices, of any size (2026-10-05) ─────────
// The rel masks were `i64` with `1i64 << r`, which bounded a program at 63
// rels. Words of 64 bits, grown on demand. `n` is the domain the set was
// built over: a position at or past it is outside the set's knowledge (a rel
// added later, e.g. a magic rel), and a reader asks `covers` before `has`.
pub struct RelSet { pub w: Vec<i64>, pub n: i64 }

pub fn relset_new(n: i64) -> RelSet { return RelSet { w: Vec::<i64>::new(), n: n }; }

impl RelSet {
    pub fn has(self: &RelSet, i: i64) -> bool {
        if i < 0i64 { return false; }
        let k: i64 = i / 64i64;
        if k >= self.w.len() { return false; }
        return (self.w[k] & (1i64 << (i % 64i64))) != 0i64;
    }
    pub fn covers(self: &RelSet, i: i64) -> bool { return i >= 0i64 && i < self.n; }
    pub fn add(self: &mut RelSet, i: i64) {
        if i < 0i64 { return; }
        let k: i64 = i / 64i64;
        while self.w.len() <= k { self.w.push(0i64); }
        self.w[k] = self.w[k] | (1i64 << (i % 64i64));
        if i >= self.n { self.n = i + 1i64; }
    }
    pub fn union_with(self: &mut RelSet, o: &RelSet) {
        let mut k: i64 = 0i64;
        while k < o.w.len() {
            while self.w.len() <= k { self.w.push(0i64); }
            self.w[k] = self.w[k] | o.w[k];
            k = k + 1i64;
        }
        if o.n > self.n { self.n = o.n; }
    }
    pub fn is_empty(self: &RelSet) -> bool {
        let mut k: i64 = 0i64;
        while k < self.w.len() { if self.w[k] != 0i64 { return false; } k = k + 1i64; }
        return true;
    }
}

// ── The parsed parameter list ──────────────────────────────────────────────
// The REL REGISTRY section (`rel_*` / `relc_*`) is filled by the wql! PROGRAM
// walker (plan_walker) when the block declares `rel` blocks (slice B): the
// rels are query SOURCES exactly like slice params, so they ride on the same
// threaded struct — the emitters resolve a scan's src_name against this
// registry to stamp rel COLUMN types + positional bindings (trama! ignores
// it). Per rel: the declared NAME, the emitted slice-local/param NAME
// (`__rel_<name>_sl` — the plan nodes' src_name is REWRITTEN to this), the
// emitted DELTA slice name (`__dl_<name>_sl` — the semi-naïve fixpoint's
// per-round delta view, slice C; a plan node's src_name is TEMPORARILY
// rewritten to it while a delta-variant body is emitted), the native ROW TYPE
// text (`(i64, str)` / scalar `i64` for a 1-column rel), and the column
// window [coff, coff+ccnt) into the flat relc_* arrays.
pub struct MacroParams {
    pub names:    Vec<str>,
    pub tys:      Vec<str>,     // CORE type name (deref/slice-stripped)
    pub is_slice: Vec<bool>,    // `&[T]`-family — a query SOURCE param
    pub n:        i64,
    // ── rel registry (wql! rel blocks — slices B/C) ──
    pub rel_names: Vec<str>,    // declared rel name ("step")
    pub rel_srcs: Vec<String>,    // emitted source name ("__rel_step_sl")  // OWNED — the registry OUTLIVES the frame
                                // whose Strings backed this view, and has no region
                                // parameter to say so.
    pub rel_dsrcs: Vec<String>, // emitted DELTA source name ("__dl_step_sl") — OWNED:
                                // it used to be a view into a String held by the
                                // walker's FRAME, which outlives nothing the registry
                                // can name (the registry has no region parameter).
    pub rel_rowty: Vec<String>,    // native row type text ("(i64, i64)" / "i64")  // OWNED — the registry OUTLIVES the frame
                                // whose Strings backed this view, and has no region
                                // parameter to say so.
    pub rel_coff: Vec<i64>,    // column window offset (flat relc_* arrays)
    pub rel_ccnt: Vec<i64>,    // column count
    pub relc_name: Vec<str>,   // flat column names
    pub relc_ty:   Vec<str>,   // flat column type names ("i64"/"str"/"bool")
    pub rel_n:     i64,
    // ── recursive-aggregate rels (semilattice min/max — the fixpoint lattice) ──
    // Finalized by the stratification check when a rel's aggregate body closes a
    // self-cycle AND its aggregate is an idempotent SEMILATTICE (min/max). Such a
    // rel materializes via a best-per-key MAP absorb (not the set shadow), so the
    // emitter branches on `rel_is_agg`. `rel_agg_dir` is the AGG_* id (min/max) —
    // the lattice order (`<` for min, `>` for max) the absorb gate uses.
    pub rel_is_agg: Vec<bool>,
    pub rel_agg_dir: Vec<i32>,
    // ── THE REL'S SCC, FLATTENED ONTO THE REGISTRY (P3b) ──────────────────
    // `RelScc` is computed by the program walker and threaded to the WALKER's
    // emitters, but `emit_incremental` is reached from the ENTRY query's
    // lowering and never sees it — the blocker P3b's scope stage named. Two
    // rel-registry FACTS close it without threading a sixth signature: the
    // rel's SCC id (which names the emitted fixpoint fn) and one derived
    // predicate saying whether that SCC has the shape whose CROSS-EPOCH driver
    // is emitted at all.
    //
    // ⚠ `rel_incr_ok` IS A DERIVATION WITH ONE HOME, and that is the point: the
    // fn-emission side (`emit_rel_fns`) and the admission side
    // (`incr_eligible`) must not answer it twice. `stamp_rel_incr_shape` writes
    // it once, right where `compute_rel_scc` returns; a rel whose flag is false
    // has NO `_i` fn in the artifact, so an admission that disagreed would name
    // a function that does not exist and fail to compile rather than answer.
    ///
    /// ⚠ `rel_incr_why` IS PART OF THE SAME WRITE, not a second opinion about
    /// it. The admission site needs a GROUND that names the antecedent that
    /// actually failed — a refusal reworded into "not supported yet" is the one
    /// nobody revisits — and re-deriving that ground beside the flag is exactly
    /// the "one cell, two opinions" shape this file has been bitten by. One
    /// loop writes the flag and the sentence that explains it; `""` ⇔ admitted.
    pub rel_sccid: Vec<i64>,
    pub rel_incr_ok: Vec<bool>,
    pub rel_incr_why: Vec<str>,
    // ── NATIVE rels (ADR 0016 M1a): sources with an ENGINE-SUPPLIED
    // materialization instead of query bodies. Today: `<p>: &Writ` params —
    // the generic graph-edge relation (writ_graph_edges). A native rel has
    // no parse-side RQRel (skipped by body passes + fn emission); its
    // prelude line calls the native helper directly.
    pub rel_native: Vec<bool>,
    /// ADR 0024 S4 — the rel's own producer returns an ITERATOR, and the rel is
    /// bound to the STREAM name rather than a slice. `rel_iter` is what the
    /// source offers; `rel_stream` is what the PLAN decided (a rel scanned more
    /// than once must still be drained, so the offer is not the decision).
    pub rel_iter: Vec<bool>,
    pub rel_stream: Vec<bool>,
    /// ADR 0025 §4 / S2b — THE PRELUDE'S MATERIALIZATION NODE for this rel, as
    /// the plan decided it: `MAT_DRAIN`/`MAT_SORT` when a buffer is built before
    /// the walk, `AD_NONE` when the rows stream, `AD_BUFFER` when the producer
    /// handed back a container and nothing is built.
    ///
    /// ⚠ THIS IS WHAT THE PRELUDE EMITTER READS — not `rel_stream`/`rel_iter`.
    /// The two booleans stay, and stay DIFFERENT things (the S1 gate's
    /// correction: `rel_iter` is the SOURCE'S OFFER, `rel_stream` the PLAN'S
    /// DECISION, and "a rel scanned twice must still be drained" is exactly the
    /// gap between them) — but a SHAPE is no longer read off them. The shape is
    /// a node the plan wrote down, with a ground and a sentence that `explain()`
    /// prints; before this field, the emitted `Vec` and its drain loop were a
    /// consequence of a boolean and the justification hung off the boolean.
    ///
    /// Written by `plan_apply_access` from `AccessPlan::prelude_node`, so the
    /// text that is emitted and the node that is explained cannot disagree:
    /// they are one lookup.
    pub rel_node: Vec<i32>,
    /// ADR 0025 §1 — the PULL UNIT of this rel's producer is a BATCH, not a
    /// row: the consumer pulls with `next_batch()` and runs the inner index
    /// loop over the batch. Set from the natspec's `b` flag, which the
    /// compiler writes when the producer's return type implements
    /// `BatchStream` (`producer_batches_`). ORTHOGONAL to `rel_stream`: `b`
    /// says HOW rows arrive from this producer, `rel_stream` says whether the
    /// plan may consume it in place — a batch producer the plan cannot read
    /// once is DRAINED by batch, which is still a batch pull.
    pub rel_batch: Vec<bool>,
    /// ADR 0025 §2/S6 — the BATCH LAYOUT of this rel's producer: `true` =
    /// ROW-MAJOR (`RowsBatch<R>` = `&[R]`, rows indexed with `bb[j]`), `false`
    /// = COLUMNAR (`ColsBatch`, cells read with `<col>_at(j)`). Set from the
    /// natspec's `m` flag, which the compiler writes when the producer's
    /// return type implements `logos.lang.stream::RowMajor`.
    ///
    /// Only meaningful where `rel_batch[r]` is true — a non-batch producer has
    /// no batch whose layout could be asked. Read ONLY by `batch_row_text` and
    /// `batch_len_text`, which is the §2 rule made structural: a layout is a
    /// ROW IN THOSE TWO FUNCTIONS, never a branch in a consumer.
    pub rel_rowmaj: Vec<bool>,
    /// The producer's RETURN TYPE, as text. The emitted binding is annotated
    /// with it rather than inferring: a generated producer's signature is not
    /// always resolvable in the round its consumer is compiled, and an inferred
    /// `let` then carries an unresolved type var into the loop.
    pub rel_itty: Vec<str>,
    // ── ADR 0025 S3 — THE ORDER FACTS ────────────────────────────────────
    // Three axes the compiler measured on the producer's RETURN TYPE (natspec
    // flags `o` / `r` / `n`) plus one the type could not carry (`^<col>`).
    // Held apart rather than folded into one "sorted" bool because they answer
    // different questions and a plan that conflates them is wrong in a
    // direction that changes ANSWERS: `o` says the rows arrive sorted, `r` says
    // they can be pulled backward, `n` says an ordinal is one descent away.
    // DESC elision needs `o` AND `r` AND `n` — a fresh walk sits at its base
    // and `retreat()` refuses, so backward iteration must first LAND at the end
    // and only `n` can put it there.
    /// The producer's return type implements `OrderedBy<K>` — the rows arrive
    /// sorted. Says nothing about BY WHICH COLUMN; that is `rel_ordcol`.
    pub rel_ordered: Vec<bool>,
    /// `Bidirectional<B>` — batches can be pulled backward (`prev_batch`).
    pub rel_bidir: Vec<bool>,
    /// `RandomAccess<B>` — `seek_nth(n)`, one descent to an ordinal.
    pub rel_randacc: Vec<bool>,
    /// WHICH column the rows are sorted by, from the source's `order <rel> =
    /// <col>;` declaration. Empty = the source declared none, and an `order by`
    /// over this rel keeps its Sort node. Non-empty implies `rel_ordered` — the
    /// compiler refuses the declaration when the type disagrees — so a reader
    /// may test this field alone for "is there a usable order fact here".
    pub rel_ordcol: Vec<str>,
    /// ADR 0025 S3 — THE PLAN'S ANSWER, not a fact about the source: this
    /// query's `order by` is already true of this rel's rows, so the emitter
    /// must not build the sort phase. Written by `plan_apply_access` from
    /// `AccessPlan.ord_noop`, exactly as `rel_node` is written from
    /// `prelude_node`, so the plan that EXPLAINS the absent Sort node and the
    /// emitter that omits it read one decision.
    pub rel_ord_noop: Vec<bool>,
    /// ADR 0025 S3-desc — WHICH DIRECTION the elided order runs in. Only
    /// meaningful when `rel_ord_noop` is set; `false` = ascending (pull forward
    /// with `next_batch`), `true` = descending (land at the end with ONE
    /// `land_end()` = `seek_nth(size())`, then pull backward with
    /// `prev_batch`).
    ///
    /// ⚠ A SECOND BOOL AND NOT A SECOND `ord_noop` VARIANT, because the two
    /// answer different questions and the emitter asks them in that order: "is
    /// there a sort phase?" (no) and only then "which way does the walk run?".
    /// Folded into one tri-state the `false` case would have had to be spelled
    /// at every reader that only cares whether the Buffer is built.
    pub rel_ord_rev: Vec<bool>,
    /// The un-sliced binding name (`__rel_<r>`), used when the rel streams —
    /// carrying a name that ends in `_sl` for something that is not a slice
    /// would make generated code lie to whoever reads it.
    pub rel_ssrc: Vec<String>,  // OWNED — the registry OUTLIVES the frame
                                // whose Strings backed this view, and has no region
                                // parameter to say so.
    // ADR 0016 §6 (sources as relational interfaces): a native rel's
    // materializer fn name, the param it is applied to, and the module the
    // materializer lives in ("" = the consuming package — no import needed).
    // All three arrive in the compiler's natspec, backed by the natspec str
    // for the duration of the walk. The prelude prints `<mat>(<marg>)`; the
    // chunk imports each distinct non-empty rel_mod. This replaces the old
    // rel_nkind flavor switch — the walker no longer knows ANY source type.
    pub rel_mat: Vec<String>,   // OWNED — fed from the AccessPlan, which is
                                // itself a frame value; a view here would
                                // outlive what it points at.
    pub rel_marg: Vec<str>,
    /// A NARROWING argument the materializer takes beyond the source itself —
    /// the constant a pushdown reads from (`__ctr_bat_Hs…(c, 42u64)`).
    /// Empty for the plain full-scan binding. The capability belongs to the
    /// FAMILY, which publishes one narrowing producer per shape; a plan only
    /// chooses which and supplies the constant.
    pub rel_marg2: Vec<String>, // OWNED — fed from the AccessPlan, a frame
                                // value; a view here would make the registry
                                // borrow the plan it outlives.
    pub rel_mod: Vec<str>,
    // ── the item's TYPE-PARAM list, verbatim (`<V: Bound, …>`; "" = concrete) ──
    // A generic `deem q<V: …>(…)` re-emits it onto EVERY generated fn head; the
    // calls between those fns infer their args from the source param, so no
    // turbofish is ever printed. Set by the deem handler from the compiler's
    // slot-4 blob; trama!/catalog leave it empty.
    // ── the source's DECLARED ACCESS OPERATIONS (ADR 0024 S6) ────────────
    // Flat, rel-indexed like the column table: `op_off`/`op_cnt` slice into
    // the shared arrays. What each entry says is what the source declared —
    // the column, the comparison it answers, what implements it, and whether
    // its rows are EXACTLY the matches of that comparison (a `ge` operation is
    // exact for `>=` and a superset when it answers `>`).
    // ── the source's declared SIZE operation (ADR 0024 S4) ───────────────
    // `rel_size_fn` = the fn reporting how many rows the relation holds ("" =
    // the source reports none, and the plan says so); `rel_size_ty` = its
    // return type, so the emitted binding is ANNOTATED for the same reason the
    // producer's is; `rel_size_at` = the binding the measured number lands in.
    //
    // ⚠ A SIZE IS NOT A CARDINALITY CLASS. `AccessPlan.card` stays an ordinal —
    // it is what orders two access choices at expansion time, when there is no
    // container to count. A measured number REFINES that ordinal at run time and
    // replaces nothing: the ordinal is what a static comparison consumes, the
    // number is what a plan built against real data will.
    pub rel_size_fn: Vec<str>,
    pub rel_size_ty: Vec<str>,
    pub rel_size_at: Vec<String>,  // OWNED — the registry OUTLIVES the frame
                                // whose Strings backed this view, and has no region
                                // parameter to say so.
    // ── the source's declared DISTINCT-VALUE counts (#726) ──────────────────
    // `distinct <rel>.<col> = <fn>;` — per rel, `ndv_off`/`ndv_cnt` slice into
    // (column, reporter fn, its return type): the number of distinct values of
    // the column, asked at run time, for the join cost model's selectivity.
    // ── mapping fusion VISIBILITY (#352) ─────────────────────────────────
    // Per parse-side rel index: the mapping a spliced rel came from ("" = the
    // consumer's own), and whether it is that mapping's internal (not `pub`)
    // — set only for a mapping consumed from another package. A hidden rel is
    // queryable by its own mapping's rels and by nothing the consumer wrote.
    pub fused_mapping: Vec<str>,
    pub fused_hidden: Vec<bool>,
    // Parse rels the entry cannot reach (`lower::live_rel_mask`), by position =
    // registry index: the prelude does not evaluate them.
    pub rel_dead:      RelSet,
    pub ndv_off: Vec<i64>,
    pub ndv_cnt: Vec<i64>,
    pub ndvc_col: Vec<str>,
    pub ndvc_fn: Vec<str>,
    pub ndvc_ty: Vec<str>,
    pub ndv_n:    i64,
    pub op_off: Vec<i64>,
    pub op_cnt: Vec<i64>,
    pub opc_col: Vec<str>,
    pub opc_cmp: Vec<str>,
    pub opc_fn: Vec<str>,
    pub opc_exact: Vec<bool>,
    pub opc_iter: Vec<bool>,
    /// The `b` flag of an OPERATION's producer (ADR 0025 §1) — the narrowing
    /// landings of a batch family return batch streams too, and the chosen op
    /// replaces the rel's own producer, so the flag has to travel with it or
    /// a pushdown would silently fall back to the row pull.
    pub opc_batch: Vec<bool>,
    pub opc_itty: Vec<str>,
    pub op_n:     i64,
    pub tparams:     str,
    // ── the query as a SOURCE (ADR 0024 S0) ──────────────────────────────
    // The parsed root, carried so that ANY diagnostic reached from the walk can
    // locate itself. A position is useless if it is only available where it was
    // produced; the walker's context is what every check already has in hand.
    // Null for surfaces that have no query root (trama!/catalog).
    pub src_root:    WAny,
    // ── the Soufflé oracle (LOGOS_DEEM_ORACLE builds only) ───────────────
    // The statements the facade runs after `_run` to dump the query's inputs
    // and its answer for `/usr/bin/souffle` (`dl_export::dl_export` builds them
    // beside the `.dl` text). Empty in every ordinary build, and then nothing
    // is emitted and `native_use_at` lists no oracle module.
    pub oracle_dump: String,
    // The incremental tier's log (an oracle build of a deem with ONE slice
    // param): the directory, the statements that write the param's rows to
    // `__od` each prefixed by `__osg` ("+" / "-"), and those that write a
    // snapshot `__ov`'s rows. Empty otherwise.
    pub oracle_dir: String,
    pub oracle_inc_rows: String,
    pub oracle_inc_snap: String,
}

pub fn macro_params_new() -> MacroParams {
    let nul: WAny = WAny::null();
    return MacroParams {
        names: Vec::<str>::new(),
        tys:   Vec::<str>::new(),
        is_slice: Vec::<bool>::new(),
        n: 0i64,
        rel_names: Vec::<str>::new(),
        rel_srcs:  Vec::<String>::new(),
        rel_dsrcs: Vec::<String>::new(),
        rel_rowty: Vec::<String>::new(),
        rel_coff:  Vec::<i64>::new(),
        rel_ccnt:  Vec::<i64>::new(),
        relc_name: Vec::<str>::new(),
        relc_ty:   Vec::<str>::new(),
        rel_n: 0i64,
        rel_is_agg:  Vec::<bool>::new(),
        rel_agg_dir: Vec::<i32>::new(),
        rel_sccid:   Vec::<i64>::new(),
        rel_incr_ok: Vec::<bool>::new(),
        rel_incr_why: Vec::<str>::new(),
        rel_native:  Vec::<bool>::new(),
        rel_iter:    Vec::<bool>::new(),
        rel_stream:  Vec::<bool>::new(),
        // AD_NONE: a params record nobody planned over builds nothing. The
        // spelled literal (not `AD_NONE()`) keeps `params.logos` free of a
        // dependency on `access_plan.logos`, whose plan reads THIS.
        rel_node:    Vec::<i32>::new(),
        rel_batch:   Vec::<bool>::new(),
        rel_rowmaj:  Vec::<bool>::new(),
        rel_itty:    Vec::<str>::new(),
        rel_ordered: Vec::<bool>::new(),
        rel_bidir:   Vec::<bool>::new(),
        rel_randacc: Vec::<bool>::new(),
        rel_ordcol:  Vec::<str>::new(),
        rel_ord_noop: Vec::<bool>::new(),
        rel_ord_rev:  Vec::<bool>::new(),
        rel_ssrc:    Vec::<String>::new(),
        rel_mat:     Vec::<String>::new(),
        rel_marg:    Vec::<str>::new(),
        rel_marg2:   Vec::<String>::new(),
        rel_mod:     Vec::<str>::new(),
        rel_size_fn: Vec::<str>::new(),
        rel_size_ty: Vec::<str>::new(),
        rel_size_at: Vec::<String>::new(),
        fused_mapping: Vec::<str>::new(),
        fused_hidden:  Vec::<bool>::new(),
        rel_dead:      relset_new(0i64),
        ndv_off:  Vec::<i64>::new(),
        ndv_cnt:  Vec::<i64>::new(),
        ndvc_col: Vec::<str>::new(),
        ndvc_fn:  Vec::<str>::new(),
        ndvc_ty:  Vec::<str>::new(),
        ndv_n:    0i64,
        op_off:   Vec::<i64>::new(),
        op_cnt:   Vec::<i64>::new(),
        opc_col:  Vec::<str>::new(),
        opc_cmp:  Vec::<str>::new(),
        opc_fn:   Vec::<str>::new(),
        opc_exact:Vec::<bool>::new(),
        opc_iter: Vec::<bool>::new(),
        opc_batch:Vec::<bool>::new(),
        opc_itty: Vec::<str>::new(),
        op_n:     0i64,
        tparams:     "",
        src_root:    nul,
        oracle_dump: String::new(),
        oracle_dir: String::new(),
        oracle_inc_rows: String::new(),
        oracle_inc_snap: String::new(),
    };
}

impl MacroParams {
    // Index of the param named `name`, or -1.
    pub fn index_of(self: &MacroParams, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.n {
            if str_eq(self.names[i], name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }

    // Is `name` a declared SLICE param (a wql! query source)?
    pub fn is_source(self: &MacroParams, name: str) -> bool {
        let i: i64 = self.index_of(name);
        if i < 0i64 { return false; }
        return self.is_slice[i];
    }

    // Is `name` a declared SCALAR (non-slice) param?
    pub fn is_scalar(self: &MacroParams, name: str) -> bool {
        let i: i64 = self.index_of(name);
        if i < 0i64 { return false; }
        return !self.is_slice[i];
    }

    // ⚠ THIS COMMENT NAMED A CAPABILITY THAT NO LONGER EXISTS, AND IT WAS ALSO
    // WRONG ABOUT THE MODULE. It read: "Any `IncrRec` engine-source param
    // present? (drives the emitted chunk's conditional `use logos.lcm.deem;` —
    // ADR 0016 M5.)". P5 deleted `IncrRec`, so ENGINE-AS-A-SOURCE (ADR 0016 M5,
    // case S) is withdrawn — a static `deem` item can no longer take the dynamic
    // incremental engine as its source type. The MECHANISM below is generic
    // (natspec `rel_mod` data, see the doc comment) and did not change; only the
    // vocabulary did. The module the seed actually wrote was `logos.mem.deem`,
    // never `logos.lcm.deem`, so the parenthesis was stale before the deletion.
    /// The extra `use` decls a generated chunk needs for its native-source
    /// materializers — one per DISTINCT non-empty rel_mod. Replaces the old
    /// has_engine_param flag: which modules a chunk needs is now data carried
    /// by the natspec, not a type the walker knows about.
    /// The k-th DISTINCT module a native rel's materializer needs, or "" past
    /// the end — the same list `native_use_text` renders, reachable by index.
    ///
    /// Text and idents are two RENDERINGS of one list. A quote carries its
    /// imports as `Ident`s (`#( use #us; )*`), a text chunk carries them as
    /// source; a second copy of the dedup walk would drift the moment either
    /// changed, which is the failure this whole audit keeps finding.
    pub fn native_use_at(self: &MacroParams, k: i64) -> str {
        let mut seen: i64 = 0i64;
        let mut emitted: Vec<str> = Vec::<str>::new();
        let mut i: i64 = 0i64;
        while i < self.rel_n {
            if self.rel_native[i] && self.rel_mod[i].len() > 0i64 {
                let m: str = self.rel_mod[i];
                let ml: i64 = m.len();
                let mut a: i64 = 0i64;
                while a < ml {
                    let mut b: i64 = a;
                    while b < ml && str_byte_at(m, b) != 44u8 { b = b + 1i64; }
                    if b > a {
                        let one: str = unsafe {
                            str_from_raw(((m.as_ptr() as i64) + a) as *const u8,
                                         b - a)
                        };
                        let mut dup: bool = false;
                        let mut j: i64 = 0i64;
                        while j < emitted.len() {
                            if str_eq(emitted.get(j), one) { dup = true; break; }
                            j = j + 1i64;
                        }
                        if !dup {
                            if seen == k { return one; }
                            emitted.push(one);
                            seen = seen + 1i64;
                        }
                    }
                    a = b + 1i64;
                }
            }
            i = i + 1i64;
        }
        // A streaming or drained source calls `next()`, which is a TRAIT
        // method: without the trait in scope the generated fn cannot resolve
        // it, and the failure surfaces as the item type escaping as a bare
        // type var — a diagnostic that names neither the trait nor the missing
        // import. It is the LAST entry of the same list, not a second list.
        // ⚠ A SURVIVOR OF ADR 0025 S2f/S2g/S2h, and it reads the OFFER on
        // purpose. S1's gate correction: the plan's node would be the WRONG
        // predicate here — a DRAINED source needs `logos.lang.iter` exactly as a
        // streamed one does, because the drain loop is itself a `next()` cascade,
        // and a container source needs it under neither. `rel_iter` is the only
        // reading that separates those three, which is why the paragraph above
        // says "streaming or drained".
        let mut it: i64 = 0i64;
        while it < self.rel_n {
            if self.rel_iter[it] {
                let iter_mod: str = "logos.lang.iter";
                let mut dup2: bool = false;
                let mut j2: i64 = 0i64;
                while j2 < emitted.len() {
                    if str_eq(emitted.get(j2), iter_mod) { dup2 = true; break; }
                    j2 = j2 + 1i64;
                }
                if !dup2 {
                    if seen == k { return iter_mod; }
                    seen = seen + 1i64;
                }
                it = self.rel_n;
            } else { it = it + 1i64; }
        }
        // The oracle's runtime helpers, last, and only in an oracle build.
        if self.oracle_dump.len() > 0i64 && seen == k { return "logos.std.wql.oracle_rt"; }
        return "";
    }

    /// The SAME list `native_use_at` indexes, rendered as chunk source text.
    /// ⚠ Derived, not re-walked. The two used to be independent walks and had
    /// already drifted — the text one imported the iterator trait and the
    /// indexed one did not, so a converted emitter's generated fn lost an
    /// import the text chunk had.
    pub fn native_use_text(self: &MacroParams, out: &mut String) {
        let mut k: i64 = 0i64;
        loop {
            let one: str = self.native_use_at(k);
            if one.len() == 0i64 { break; }
            out.push_str("use ");
            out.push_str(one);
            out.push_str("; ");
            k = k + 1i64;
        }
    }

    // The CORE type name of the param named `name` ("" if absent).
    pub fn ty_of(self: &MacroParams, name: str) -> str {
        let i: i64 = self.index_of(name);
        if i < 0i64 { return ""; }
        return self.tys[i];
    }

    // ── rel registry (filled by the wql! program walker; slices B/C) ────────

    // Register a rel (declaration order). Returns the rel index (-1 = full).
    pub fn rel_add(self: &mut MacroParams, name: str, src: str, dsrc: str, rowty: str) -> i64 {
        let i: i64 = self.rel_n;
        // One entry per rel in every per-rel registry (`AD_NONE` for the node).
        self.rel_names.push("");
        self.rel_srcs.push(String::new());
        self.rel_dsrcs.push(String::new());
        self.rel_rowty.push(String::new());
        self.rel_coff.push(0i64);
        self.rel_ccnt.push(0i64);
        self.rel_is_agg.push(false);
        self.rel_agg_dir.push(0i32);
        self.rel_sccid.push(0i64);
        self.rel_incr_ok.push(false);
        self.rel_incr_why.push("");
        self.rel_native.push(false);
        self.rel_iter.push(false);
        self.rel_stream.push(false);
        self.rel_node.push(-1i32);
        self.rel_batch.push(false);
        self.rel_rowmaj.push(false);
        self.rel_itty.push("");
        self.rel_ordered.push(false);
        self.rel_bidir.push(false);
        self.rel_randacc.push(false);
        self.rel_ordcol.push("");
        self.rel_ord_noop.push(false);
        self.rel_ord_rev.push(false);
        self.rel_ssrc.push(String::new());
        self.rel_mat.push(String::new());
        self.rel_marg.push("");
        self.rel_marg2.push(String::new());
        self.rel_mod.push("");
        self.rel_size_fn.push("");
        self.rel_size_ty.push("");
        self.rel_size_at.push(String::new());
        self.ndv_off.push(0i64);
        self.ndv_cnt.push(0i64);
        self.op_off.push(0i64);
        self.op_cnt.push(0i64);
        self.rel_names[i] = name;
        self.rel_srcs[i]  = String::from_str(src);
        self.rel_dsrcs[i] = String::from_str(dsrc);
        self.rel_rowty[i] = String::from_str(rowty);
        // Columns append at the current flat top.
        let mut off: i64 = 0i64;
        if i > 0i64 { off = self.rel_coff[i - 1i64] + self.rel_ccnt[i - 1i64]; }
        self.rel_coff[i] = off;
        self.rel_ccnt[i] = 0i64;
        self.rel_n = i + 1i64;
        return i;
    }

    // Mark registry position `i` as a rel of the fused mapping `m` (written
    // before the walk registers the rels, so the lists grow to reach `i`).
    pub fn set_fused(self: &mut MacroParams, i: i64, m: str, hidden: bool) {
        while self.fused_mapping.len() <= i { self.fused_mapping.push(""); self.fused_hidden.push(false); }
        self.fused_mapping[i] = m;
        self.fused_hidden[i] = hidden;
    }

    // Append one column to the LAST registered rel.
    /// Record one declared operation for the rel most recently registered.
    /// Record a distinct-value reporter for a column of the LAST registered rel (#726).
    pub fn rel_add_ndv(self: &mut MacroParams, col: str, fn_name: str, ty: str) {
        let r: i64 = self.rel_n - 1i64;
        if r < 0i64 { return; }
        if self.ndv_cnt[r] == 0i64 { self.ndv_off[r] = self.ndv_n; }
        self.ndvc_col.push(col);
        self.ndvc_fn.push(fn_name);
        self.ndvc_ty.push(ty);
        self.ndv_n = self.ndv_n + 1i64;
        self.ndv_cnt[r] = self.ndv_cnt[r] + 1i64;
    }

    /// The distinct-value reporter rel `r` declared for column `col`, "" = none (#726).
    pub fn rel_ndv_fn(self: &MacroParams, r: i64, col: str) -> str {
        if r < 0i64 || r >= self.rel_n { return ""; }
        let mut k: i64 = self.ndv_off[r];
        let end: i64 = self.ndv_off[r] + self.ndv_cnt[r];
        while k < end {
            if str_eq(self.ndvc_col[k], col) { return self.ndvc_fn[k]; }
            k = k + 1i64;
        }
        return "";
    }

    pub fn rel_add_op(self: &mut MacroParams, col: str, cmp: str, fn_name: str,
                      exact: bool, iter: bool, batch: bool, ity: str) {
        let r: i64 = self.rel_n - 1i64;
        if r < 0i64 { return; }
        if self.op_cnt[r] == 0i64 { self.op_off[r] = self.op_n; }
        self.opc_col.push(col);
        self.opc_cmp.push(cmp);
        self.opc_fn.push(fn_name);
        self.opc_exact.push(exact);
        self.opc_iter.push(iter);
        self.opc_batch.push(batch);
        self.opc_itty.push(ity);
        self.op_n = self.op_n + 1i64;
        self.op_cnt[r] = self.op_cnt[r] + 1i64;
    }

    /// Does the source EMITTED under this name stream? Safe for a name that is
    /// no rel at all (a slice param), which is why the emitters ask this rather
    /// than indexing `rel_stream` by a lookup that can return -1.
    pub fn rel_src_streams(self: &MacroParams, src: str) -> bool {
        let i: i64 = self.rel_find_src(src);
        if i < 0i64 { return false; }
        return self.rel_stream[i];
    }

    /// ADR 0025 S2f — THE MATERIALIZATION NODE over the source EMITTED under
    /// this name, for the emitters that key on a source's TEXT rather than on a
    /// registry index. Same lookup as `rel_src_streams`, answering with the
    /// plan's node instead of the plan's boolean.
    ///
    /// ⚠ A NAME THAT IS NO REL ANSWERS `AD_BUFFER`, NOT `AD_NONE`. A slice
    /// param IS a buffer — the caller handed one in and the plan built nothing
    /// — so "no rel here" is the container absence, never the streamed one.
    /// `AD_NONE` from this fn means the PLAN said the rows stream; that is the
    /// only way to get it, and reading a missing entry as `AD_NONE` would hand
    /// an indexed scan an iterator it cannot subscript.
    ///
    /// EQUIVALENCE with the shape reading it replaces, stated so it can be
    /// checked rather than trusted: `plan_apply_access` walks `ri < ap.n` with
    /// `ap.n == prm.rel_n` (`plan_walker:1890`, `access_plan_new(prm.rel_n)`),
    /// runs on EVERY emission path after the last `rel_add`, and writes
    /// `rel_node[ri] = AD_NONE()` under exactly the `ap.stream[ri]` that also
    /// sets `rel_stream[ri] = true`. So `rel_src_node(s) == AD_NONE()` and
    /// `rel_src_streams(s)` are the same predicate over every rel a plan
    /// registered — and they differ on a name that is no rel, where the node is
    /// the honest answer and the boolean's `false` was an accident of the
    /// default.
    ///
    /// The `-2` is spelled, not called: same reason as the `-1i32`
    /// initializer above — `params.logos` must not depend on
    /// `access_plan.logos`, which reads THIS. `AD_BUFFER()` is that literal.
    pub fn rel_src_node(self: &MacroParams, src: str) -> i32 {
        let i: i64 = self.rel_find_src(src);
        if i < 0i64 { return -2i32; }
        return self.rel_node[i];
    }

    /// THE SCAN ARM, as a question about the PLAN: did the plan put NO
    /// materialization over this source? Then the scan pulls from the iterator;
    /// otherwise a buffer exists — drained, sorted, or handed in already built —
    /// and the scan subscripts it. `AD_NONE()` is `-1`, spelled for the same
    /// no-dependency reason as above.
    ///
    /// ⚠ THE PREDICATE LIVES HERE, NOT AT THE EMITTER, for a mechanical reason
    /// worth recording: the emitters' enclosing `use` list is COPIED INTO EVERY
    /// GENERATED MODULE (measured — importing `access_plan` into
    /// `rexpr_walk.logos` to spell `AD_NONE()` at the call site moved 156 of the
    /// 159 corpus dumps and +85,994 bytes, all of them one added use-decl line).
    /// A text-preserving stage may not add an import to an emitter module, so
    /// the node question is asked through the registry that owns the field.
    pub fn rel_src_unmaterialized(self: &MacroParams, src: str) -> bool {
        return self.rel_src_node(src) == -1i32;
    }

    /// ADR 0025 S3 — did the plan ELIDE this query's sort over this source?
    ///
    /// Asked by SOURCE BINDING, like `rel_src_node`, because that is the name
    /// the emitter holds: the walk keys its decision by rel index, and by the
    /// time `emit_simple` runs it has `RScan.src_name`, which is the emitted
    /// binding. The lookup lives here for the reason `rel_src_unmaterialized`
    /// does — an emitter module may not gain an import (measured: adding one
    /// moved 156 of 159 corpus dumps).
    ///
    /// A name that is no rel answers `false`, which is the safe direction: the
    /// sort is emitted.
    pub fn rel_src_ord_noop(self: &MacroParams, src: str) -> bool {
        let i: i64 = self.rel_find_src(src);
        if i < 0i64 { return false; }
        return self.rel_ord_noop[i];
    }

    /// ADR 0025 S3-desc — does the elided order run BACKWARD over this source?
    ///
    /// Asked by source binding for the same reason `rel_src_ord_noop` is, and
    /// answering `false` for a name that is no rel is the safe direction here
    /// too: a forward walk under a `desc` query that was never admitted as a
    /// no-op cannot happen, because the emitter only asks this AFTER
    /// `rel_src_ord_noop` said yes.
    pub fn rel_src_ord_rev(self: &MacroParams, src: str) -> bool {
        let i: i64 = self.rel_find_src(src);
        if i < 0i64 { return false; }
        return self.rel_ord_rev[i];
    }

    // The op that answers a demand is no longer FOUND here. A search whose
    // order is the choice cannot be costed, and the two weakenings this used to
    // hardcode (`ge` for `gt`, `le` for `lt`) were not the only ones that hold.
    // The covering relation is `access_plan::ap_covers`, written once, and the
    // choice among covering ops is a comparison of cardinality — ADR 0024 S4.

    /// True when the operation at `oi` answers `cmp` EXACTLY — the query's
    /// residual filter is then redundant. False for a superset, where it is
    /// what keeps the answer correct.
    pub fn rel_op_is_exact(self: &MacroParams, oi: i64, cmp: str) -> bool {
        if oi < 0i64 || oi >= self.op_n { return false; }
        if !self.opc_exact[oi] { return false; }
        return str_eq(self.opc_cmp[oi], cmp);
    }

    pub fn rel_add_col(self: &mut MacroParams, col_name: str, col_ty: str) {
        if self.rel_n == 0i64 { return; }
        let i: i64 = self.rel_n - 1i64;
        let k: i64 = self.rel_coff[i] + self.rel_ccnt[i];
        // Columns append at the flat top: `k` is the table's length.
        if k != self.relc_name.len() { logos.lang.panic::panic("wql!: a rel column appended away from the flat table's top"); }
        self.relc_name.push(col_name);
        self.relc_ty.push(col_ty);
        self.rel_ccnt[i]  = self.rel_ccnt[i] + 1i64;
    }

    // Rel index by DECLARED name ("step"), or -1.
    pub fn rel_find_name(self: &MacroParams, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.rel_n {
            if str_eq(self.rel_names[i], name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }

    // Rel index by EMITTED source name ("__rel_step_sl") OR delta source name
    // ("__dl_step_sl"), or -1 — the emit-side lookup (plan nodes' src_name is
    // rewritten to the emitted name; the semi-naïve delta-variant emission
    // temporarily rewrites an in-SCC occurrence to the delta name, and the
    // column stamping must resolve BOTH spellings to the same rel).
    pub fn rel_find_src(self: &MacroParams, src: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.rel_n {
            if str_eq(string_as_str(&self.rel_srcs[i]), src) { return i; }
            if str_eq(string_as_str(&self.rel_dsrcs[i]), src) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
}

/// `let <size_at>: <size_ty> = <size_fn>(<marg>);` — the rel's SIZE, obtained
/// ONCE (ADR 0024 S4g). Nothing when the source declared no reporter.
///
/// ⚠ ONE COPY, because the statement is now needed in TWO bodies: the query's
/// own prelude (plan_walker) and the PREPARE fn's measurement (rexpr_walk,
/// S4i) — and a prepared plan that spelled the reporter call differently from
/// the query would compare a number to one obtained another way. It lives here
/// for the same reason `RelScc` does: params.logos is the module both sides
/// already share.
///
/// ⚠ ANNOTATED from the DECLARED return type, inferred only when none
/// travelled: the reporter of a factory-generated family lands in the same
/// round its query lowers, and an inferred `let` then carries an unresolved
/// type var out of the prelude.
pub fn size_binding_text(out: &mut String, prm: &MacroParams, r: i64) {
    if prm.rel_size_fn[r].len() == 0i64 { return; }
    out.push_str("    let ");
    out.push_str(string_as_str(&prm.rel_size_at[r]));
    if prm.rel_size_ty[r].len() > 0i64 {
        out.push_str(": ");
        out.push_str(prm.rel_size_ty[r]);
    }
    out.push_str(" = ");
    out.push_str(prm.rel_size_fn[r]);
    out.push_str("(");
    out.push_str(prm.rel_marg[r]);
    out.push_str(");\n");
}

/// ADR 0025 §1/§2 — THE ROW, SPELLED OFF A BATCH. One copy, here, because BOTH
/// consumers of a batch producer need it: the §1 scan shape (`rexpr_walk`,
/// quoted) and the DRAIN prelude (`plan_walker`, text). Two spellings of the
/// row projection is exactly how a drained relation would come to differ from
/// a scanned one — the defect class this whole audit keeps finding.
///
/// THE ACCESSOR NAME IS THE DECLARED COLUMN NAME PLUS `_at`. That is a
/// convention on the producer side of the SAME declaration the column names
/// arrive in (`rel entry(key: K, val: V)` ⇒ `key_at(i)` / `val_at(i)`), so the
/// emitter stays declaration-driven and knows no source type — a third layout
/// is a row in this function, not a branch in every consumer. The point-read
/// cell is read through the column's HOISTED view, `<bvar>_c<k>.at(i)`, bound
/// above the row loop by `batch_hoist_text_at` from the family's `col_<c>()` —
/// §2's resolve-once (#341): one slot resolve per column per BATCH, not per
/// cell. A caller that spells this row text must spell that hoist in the same
/// batch scope; a missing hoist is an unknown name at compile time, not a
/// silent per-cell re-resolve.
///
/// A single-column rel's row is the BARE value, not a 1-tuple — the same rule
/// `register_native_rels` applies when it builds `rel_rowty`.
///
/// ⚠ TWO ENTRY POINTS, ONE BODY (R-A). `batch_row_text` reads the layout off the
/// REL REGISTRY (`rel_rowmaj[r]`), which every batch producer has because the
/// natspec gave it one. A `SliceStream` wrap over a `deem` SLICE PARAM has NO
/// rel index at all (`rel_find_src` → −1: no `impl Src`, no natspec, no rel),
/// and its layout is nevertheless KNOWN STATICALLY — `SliceStream<R>`
/// implements `RowMajor` by construction. So the layout arrives as an ARGUMENT
/// through `batch_row_text_at`, and the two entry points share this body. NOT a
/// second copy of the row spelling: §2's rule is that a layout is a row in ONE
/// function, and it still is — `r` is simply not consulted on the row-major arm,
/// which is why `r = -1` is legal there and only there.
pub fn batch_row_text_at(out: &mut String, prm: &MacroParams, r: i64,
                         rowmaj: bool, bvar: str, ivar: str) {
    // ── ROW-MAJOR (ADR 0025 §2, S6): the batch IS the rows. ────────────────
    // `RowsBatch<R>` = `&[R]`, so the row is one index and the column names are
    // not spelled at all — the projection back out of the row is the caller's
    // ordinary tuple access, exactly as it is on the slice path. THE INDEX IS
    // CAST: the pull counter is `u64` (one counter for both layouts, because
    // `ColsBatch::len` is `u64`) while slice indexing takes `i64`.
    //
    // This arm is the whole reason `Buffer`-shaped sources can be scanned. The
    // columnar arm below emitted `bb.<col>_at(j)` unconditionally, which on a
    // slice batch is `slice has no method 'a_at'` — measured, on the probe that
    // opened S6.
    if rowmaj {
        out.push_str("(");
        out.push_str(bvar);
        out.push_str(")[");
        out.push_str(ivar);
        out.push_str(" as i64]");
        return;
    }
    // Columnar: the rel index is REQUIRED here and only here — and that is an
    // ASSERTED precondition, not a doc sentence. The direct round (#74's
    // measurement) reached this arm with r = -1 from a caller that had no rel,
    // and the result was a SILENTLY EMPTY row expression
    // (`let __brow0: (u64,u64) = ();`) — a permissive defect invisible to a
    // green corpus. The doc comment above says "-1 is legal there and only
    // there"; this is the "only there" made loud (verify miss M5).
    if r < 0i64 {
        logos.lang.panic::panic("wql!: batch_row_text_at reached the COLUMNAR arm with a rel-less source (r = -1) — only the row-major arm may take r = -1; a -1 here renders an empty row expression silently");
    }
    let off: i64 = prm.rel_coff[r];
    let nc: i64  = prm.rel_ccnt[r];
    if nc != 1i64 { out.push_str("("); }
    let mut c: i64 = 0i64;
    while c < nc {
        if c > 0i64 { out.push_str(", "); }
        out.push_str(bvar);
        out.push_str("_c");
        out.push_i64(c);
        out.push_str(".at(");
        out.push_str(ivar);
        out.push_str(")");
        c = c + 1i64;
    }
    if nc != 1i64 { out.push_str(")"); }
}

/// ADR 0025 §2 (#341) — THE COLUMN HOIST of a columnar batch: one statement per
/// declared column, `let <bvar>_c<k> = <bvar>.col_<c>();`, spelled where the
/// batch is bound and BEFORE its row loop; `batch_row_text_at` reads the cells
/// through these. Empty on the row-major arm, whose row is one index.
pub fn batch_hoist_text_at(out: &mut String, prm: &MacroParams, r: i64,
                           rowmaj: bool, bvar: str) {
    if rowmaj { return; }
    if r < 0i64 {
        logos.lang.panic::panic("wql!: batch_hoist_text_at reached the COLUMNAR arm with a rel-less source (r = -1)");
    }
    let off: i64 = prm.rel_coff[r];
    let nc: i64  = prm.rel_ccnt[r];
    let mut c: i64 = 0i64;
    while c < nc {
        out.push_str("let ");
        out.push_str(bvar);
        out.push_str("_c");
        out.push_i64(c);
        out.push_str(" = ");
        out.push_str(bvar);
        out.push_str(".col_");
        out.push_str(prm.relc_name[off + c]);
        out.push_str("(); ");
        c = c + 1i64;
    }
}

/// The REL-KEYED entry point (see `batch_row_text`).
pub fn batch_hoist_text(out: &mut String, prm: &MacroParams, r: i64, bvar: str) {
    batch_hoist_text_at(out, prm, r, prm.rel_rowmaj[r], bvar);
}

/// The REL-KEYED entry point: the layout is the registry's (`rel_rowmaj[r]`).
/// `r` must be a real rel index — every caller that has one uses this.
pub fn batch_row_text(out: &mut String, prm: &MacroParams, r: i64,
                      bvar: str, ivar: str) {
    batch_row_text_at(out, prm, r, prm.rel_rowmaj[r], bvar, ivar);
}

/// ADR 0025 §2/S6 — THE BATCH'S LENGTH, spelled per LAYOUT. The pull counter is
/// `u64` in all three emitters (`batch_scan_frag`, `batch_scan_rev_frag`, the
/// DRAIN prelude) because that is what `ColsBatch::len` returns; a row-major
/// batch is a slice, whose `len()` is `i64`. One cast, in the one place the
/// layout is known, rather than a `u64`/`i64` question at three quote sites —
/// the same rule as `batch_row_text`, whose companion this is.
///
/// ⚠ Same TWO-ENTRY-POINT split as `batch_row_text_at`, and for the same
/// reason: a `SliceStream` wrap has no rel index to read the layout from.
pub fn batch_len_text_at(out: &mut String, rowmaj: bool, bvar: str) {
    out.push_str(bvar);
    out.push_str(".len()");
    if rowmaj { out.push_str(" as u64"); }
}

/// The REL-KEYED entry point (see `batch_row_text`).
pub fn batch_len_text(out: &mut String, prm: &MacroParams, r: i64, bvar: str) {
    batch_len_text_at(out, prm.rel_rowmaj[r], bvar);
}

// ── RelScc — the rel dependency CONDENSATION (slice C — recursive rels) ──────
// Computed by the program walker (plan_walker::compute_rel_scc) from the
// RelDeps edge list; consumed by BOTH the walker (stratification validation +
// entry-prelude materialization order) and the emitter (rexpr_walk::
// emit_rel_fns — one helper fn per non-recursive rel, one semi-naïve fixpoint
// fn per recursive SCC). Lives here because params.logos is the module both
// sides already share (the rel registry's home).
//   comp[r]     — rel index → SCC id (ids assigned in declaration order);
//   rec[c]      — SCC id → RECURSIVE? (size > 1, or a self-loop member);
//   order[k]    — topo position → SCC id (dependencies-first — the
//                 materialization/evaluation order of the condensation DAG);
//   nscc        — SCC count;
//   dep_mask[r] — rel index → bitmask of DIRECT out-of-SCC rel dependencies
//                 (bit j ⇔ some body of r scans rel j, comp[j] != comp[r]) —
//                 the helper-fn extra-parameter set (in-SCC edges are the
//                 fixpoint's own state, not parameters).
pub struct RelScc {
    pub comp:     Vec<i64>,
    pub rec:      Vec<bool>,
    pub order:    Vec<i64>,
    pub nscc:     i64,
    pub dep_mask: Vec<RelSet>,
}

/// P3b — FLATTEN the condensation onto the rel registry, and DERIVE, once, the
/// one predicate both the fn-emission side and the admission side ask.
///
/// `rel_incr_ok[r]` = "rel `r`'s SCC has a CROSS-EPOCH semi-naïve driver". Every
/// clause names the piece that is missing rather than saying "not yet", and the
/// narrowness is deliberate: this is the FIRST slice in which a handle owns a
/// whole derived relation, so the shape it owns is the one shape a fixture in
/// this slice runs at every epoch on cyclic data.
///
///   • RECURSIVE — a NON-recursive rel materializes through the one-shot helper
///     (`__wql_<q>_rel_<r>`), which has no total to extend and no shadow set to
///     seed; its epoch would have to CLEAR and re-fold the group state, a
///     different mechanism with its own failure modes. It keeps its refusal, and
///     the second measured wrong answer (a rel is a SET; the same edge twice
///     counted twice) stays REFUSED rather than becoming wrong.
///   • NO AGGREGATE MEMBER — a recursive min/max member's state is a
///     best-per-key MAP plus a distinct-key roster plus a round counter, and its
///     total is MATERIALIZED after the loop rather than appended during it, so
///     "the rows added this epoch" is not a suffix of the total. That is a
///     strictly harder promotion and it is not this slice's.
///   • NO OUT-OF-SCC REL DEPENDENCY (`dep_mask == 0`) — a lower-stratum rel is
///     itself derived, so maintaining this one across epochs means maintaining
///     THAT one too, and the entry query would need both totals on the handle.
///   • NO NATIVE / NO STREAMING MEMBER — a native rel is a pure function of a
///     caller-owned `&Writ` with no parse-side bodies at all, and a streaming
///     rel is bound to an iterator rather than to a slice the driver can total.
///   • EVERY REL IN THE PROGRAM IS A MEMBER OF THIS SCC — with a rel OUTSIDE it
///     the entry prelude has more than one materialization step and `<q>_epoch`
///     would have to reproduce the ORDER of them; one SCC covering the whole
///     registry makes the epoch body derivable from the registry alone, which is
///     what removes the threaded second prelude.
///
/// ══ P3c — THE CLAUSES ARE PER-SCC, NOT PER-REL, AND THAT IS THE WIDENING ═══
///
/// P3b asked every clause of the rel `r` ALONE, which was indistinguishable from
/// asking it of the SCC because `nmem != 1` had already refused everything else.
/// Widening to mutual recursion makes the difference load-bearing: the `_i`
/// driver emitted for an SCC contains the state of EVERY member, so an SCC whose
/// members are {plain, aggregate} would get a driver in which one member's total
/// is appended during the loop and the other's is MATERIALIZED after it — and
/// the `_i` seeding path (`__rs_<m>` walked out of `__tot_<m>`) exists only on
/// the plain branch, so the aggregate member would enter every epoch after the
/// first with an EMPTY best-per-key map and re-derive its extremum from the
/// delta alone. Hence `any_agg`, `any_native`, `any_stream` and the UNION of the
/// dep masks: a clause that held for the selected member but not for its
/// co-member would have admitted exactly that.
///
/// ⚠ NO CAPACITY CLAUSE, and the reason is a bound rather than an oversight:
/// `rel_add` refuses past 8 (`rel_n >= 8` → -1), so `nmem <= rel_n <= 8` and
/// `emit_scc_fn`'s `mem` list and the handle's total-name
/// array cannot be overrun. If `rel_add`'s bound ever moves, both move with it.
pub fn stamp_rel_incr_shape(prm: &mut MacroParams, scc: &RelScc) {
    let mut r: i64 = 0i64;
    while r < prm.rel_n {
        let c: i64 = scc.comp[r];
        prm.rel_sccid[r] = c;
        let mut nmem: i64 = 0i64;
        // ── THE SCC'S PROPERTIES, NOT THE REL'S — see the P3c note above ────
        let mut any_agg:    bool = false;
        let mut any_native: bool = false;
        let mut any_stream: bool = false;
        let mut mask_u:     RelSet = relset_new(0i64);
        let mut k: i64 = 0i64;
        while k < prm.rel_n {
            if scc.comp[k] == c {
                nmem = nmem + 1i64;
                if prm.rel_is_agg[k] { any_agg = true; }
                if prm.rel_native[k] { any_native = true; }
                // ⚠ A SURVIVOR OF ADR 0025 S2f/S2g/S2h — a DECISION, not a shape.
                // S1's gate correction: this asks whether any member of the SCC
                // is a source the caller could not re-present across epochs, and
                // both halves are needed — `rel_iter` is the offer (an iterator
                // yields once whatever the plan does with it) and `rel_stream` is
                // the plan's verdict. The emitted scan's shape is not the
                // question, so this does not follow the readings that moved to
                // `rel_src_unmaterialized`.
                if prm.rel_iter[k] || prm.rel_stream[k] { any_stream = true; }
                mask_u.union_with(&scc.dep_mask[k]);
            }
            k = k + 1i64;
        }
        // ⚠ ORDER MATTERS ONLY FOR THE SENTENCE, NOT FOR THE FLAG: the flag is
        // the conjunction and is written last, from the same `why`. A clause
        // added to one and not the other cannot happen — there is one `if`.
        let mut why: str = "";
        if !scc.rec[c] {
            why = "the source is a NON-RECURSIVE declared `rel` — it materializes through the one-shot helper, which has no fixpoint TOTAL to extend and no shadow set to seed, so maintaining it across epochs means CLEARING and re-folding the group state rather than extending it (the dedup defect this refusal closes is still real: a rel is a SET and the same fact twice is one row)";
        } else if nmem != prm.rel_n {
            // ⚠ P3c REPLACED `prm.rel_n != 1` WITH THIS, AND THE OLD CLAUSE'S
            // GROUND IS WHY. That ground was "the entry prelude then has several
            // materialization steps in a condensation order". It evaporates
            // exactly when EVERY declared rel is a member of THIS SCC:
            // `emit_prelude_scc` then emits ONE step and there is no order to
            // reproduce. It does NOT evaporate for a rel outside the SCC, and
            // that is the case this clause still refuses — which is also the
            // `dep_mask` clause's neighbour, but not its duplicate: a rel
            // outside the SCC that this SCC does NOT scan still has to be
            // materialized by the entry, in an order `<q>_epoch` cannot derive.
            why = "the program declares a `rel` OUTSIDE this recursive SCC — the entry prelude then has several materialization steps in a condensation order, and `<q>_epoch` would have to reproduce that order rather than derive its whole body from the registry";
        } else if any_agg {
            why = "a member of the recursive SCC is an AGGREGATE rel (a min/max semilattice head) — its state is a best-per-key MAP plus a distinct-key roster plus a convergence counter, and its total is MATERIALIZED after the loop rather than appended during it, so `the rows added this epoch` is not a suffix of the total; the `_i` variant seeds a shadow set from the total and there is no such seeding for a map";
        } else if any_native {
            why = "a member of the SCC is NATIVE (`&Writ`) — it has no parse-side bodies and no fixpoint at all; it is a pure function of one caller-owned container";
        } else if any_stream {
            why = "a member of the SCC STREAMS — it is bound to an iterator rather than to a slice, and a total the handle owns must be a materialized Vec";
        } else if !mask_u.is_empty() {
            why = "the recursive SCC DEPENDS ON A LOWER-STRATUM `rel` — that rel is itself derived, so maintaining this one across epochs means maintaining that one too and the handle would have to own both totals";
        }
        prm.rel_incr_why[r] = why;
        prm.rel_incr_ok[r]  = why.len() == 0i64;
        r = r + 1i64;
    }
}

pub fn rel_scc_new() -> RelScc {
    return RelScc {
        comp:     Vec::<i64>::new(),
        rec:      Vec::<bool>::new(),
        order:    Vec::<i64>::new(),
        nscc:     0i64,
        dep_mask: Vec::<RelSet>::new(),
    };
}

// ── RelDeps — the EXPLICIT rel dependency edge list ──────────────────────────
// One edge per rel→rel source reference: `efrom[k]` (the referencing rel's
// declaration index) → `eto[k]` (the referenced rel). The condensation
// (compute_rel_scc) consumes this list to find the recursive SCCs; the
// stratification check additionally consumes the NEGATED (anti-join) and
// AGGREGATED sub-lists — a cycle through either is non-stratifiable.
// MOVED here from plan_walker (queue-2 slice I3): the graph half is PURE
// (no metaprog) and is now shared by the static walker AND the runtime
// interpreter (logos.std.deem) — the same layering move as lower.logos.
pub struct RelDeps {
    pub efrom: Vec<i64>,
    pub eto: Vec<i64>,
    pub n:     i64,
    // Anti-join rel edges: rel `afrom[k]`'s body `anti join`s rel `ato[k]`.
    pub afrom: Vec<i64>,
    pub ato: Vec<i64>,
    pub an:    i64,
    // Aggregate-body rel-source edges: rel `gfrom[k]` has an AGGREGATE body
    // scanning rel `gto[k]` (aggregate bodies are themselves rejected — this
    // list only selects WHICH diagnostic: in-SCC ⇒ the non-stratified cycle
    // error, else the plain "aggregate bodies are not allowed" one).
    pub gfrom: Vec<i64>,
    pub gto: Vec<i64>,
    pub gn:    i64,
    // First rel with an aggregate body (-1 = none) — the deferred plain reject.
    pub agg_head: i64,
    // Per rel: the AGG_* id of its aggregate body's aggregate (0 = no aggregate
    // body). Set by the STATIC walker only (the runtime interpreter's add_agg
    // callers leave it 0). The stratification check reads it to decide whether an
    // in-cycle aggregate is an admissible SEMILATTICE (min/max) recursive head or
    // a non-stratifiable GROUP (sum/count/avg) one.
    pub head_agg_dir: Vec<i32>,
}

pub fn rel_deps_new() -> RelDeps {
    return RelDeps { efrom: Vec::<i64>::new(), eto: Vec::<i64>::new(), n: 0i64,
                     afrom: Vec::<i64>::new(), ato: Vec::<i64>::new(), an: 0i64,
                     gfrom: Vec::<i64>::new(), gto: Vec::<i64>::new(), gn: 0i64,
                     agg_head: -1i64, head_agg_dir: Vec::<i32>::new() };
}

impl RelDeps {
    pub fn add(self: &mut RelDeps, f: i64, t: i64) {
        self.efrom.push(f);
        self.eto.push(t);
        self.n = self.n + 1i64;
    }

    pub fn add_anti(self: &mut RelDeps, f: i64, t: i64) {
        self.afrom.push(f);
        self.ato.push(t);
        self.an = self.an + 1i64;
    }

    pub fn add_agg(self: &mut RelDeps, f: i64, t: i64) {
        self.gfrom.push(f);
        self.gto.push(t);
        self.gn = self.gn + 1i64;
    }

    // Record rel `f`'s aggregate-body aggregate id (AGG_* — min/max/sum/…). The
    // static walker calls this from the aggregate-body check; consumed by the
    // stratification check to classify the cycle. Idempotent per rel.
    pub fn set_head_agg_dir(self: &mut RelDeps, f: i64, dir: i32) {
        if f < 0i64 { return; }
        while self.head_agg_dir.len() <= f { self.head_agg_dir.push(0i32); }
        self.head_agg_dir[f] = dir;
    }

    // The recursive-aggregate direction recorded for rel `f` (0 = none).
    pub fn head_agg_dir_of(self: &RelDeps, f: i64) -> i32 {
        if f < 0i64 || f >= self.head_agg_dir.len() { return 0i32; }
        return self.head_agg_dir[f];
    }
}

// ── SCC condensation over RelDeps ────────────────────────────────────────────
// Rel counts are tiny (≤ 8), so the CLEAN quadratic-closure formulation wins
// over Tarjan bookkeeping: Warshall transitive closure (path length ≥ 1), then
//   same SCC    ⇔ mutual reachability;
//   RECURSIVE   ⇔ SCC size > 1, or reach[i][i] (a cycle through i — covers the
//                 plain self-edge);
//   topo order  ⇔ Kahn over the condensation, dependencies FIRST (an SCC is
//                 placed once every SCC it depends on is placed; smallest id
//                 first — deterministic);
//   dep_mask[r] ⇔ DIRECT out-of-SCC dependencies (the helper-fn extra-param
//                 set; in-SCC edges are the fixpoint's own state).
pub fn compute_rel_scc(deps: &RelDeps, nr: i64) -> RelScc {
    let mut scc: RelScc = rel_scc_new();
    // One entry per rel (`order`/`rec` are indexed by SCC, at most nr).
    let mut z: i64 = 0i64;
    while z < nr {
        scc.comp.push(-1i64); scc.rec.push(false); scc.order.push(0i64); scc.dep_mask.push(relset_new(nr));
        z = z + 1i64;
    }
    // Transitive closure (flat nr×nr; reach[i*nr+j] ⇔ a path of length ≥ 1).
    let mut reach: Vec<bool> = Vec::<bool>::new();
    let mut zr: i64 = 0i64;
    while zr < nr * nr { reach.push(false); zr = zr + 1i64; }
    let mut e: i64 = 0i64;
    while e < deps.n {
        reach[deps.efrom[e] * nr + deps.eto[e]] = true;
        e = e + 1i64;
    }
    let mut k: i64 = 0i64;
    while k < nr {
        let mut i: i64 = 0i64;
        while i < nr {
            if reach[i * nr + k] {
                let mut j: i64 = 0i64;
                while j < nr {
                    if reach[k * nr + j] { reach[i * nr + j] = true; }
                    j = j + 1i64;
                }
            }
            i = i + 1i64;
        }
        k = k + 1i64;
    }
    // Components (mutual reachability), ids in declaration order.
    let mut i0: i64 = 0i64;
    while i0 < nr { scc.comp[i0] = -1i64; i0 = i0 + 1i64; }
    let mut nscc: i64 = 0i64;
    let mut a: i64 = 0i64;
    while a < nr {
        if scc.comp[a] < 0i64 {
            let c: i64 = nscc;
            nscc = nscc + 1i64;
            scc.comp[a] = c;
            let mut sz: i64 = 1i64;
            let mut b: i64 = a + 1i64;
            while b < nr {
                if scc.comp[b] < 0i64 && reach[a * nr + b] && reach[b * nr + a] {
                    scc.comp[b] = c;
                    sz = sz + 1i64;
                }
                b = b + 1i64;
            }
            if sz > 1i64 || reach[a * nr + a] { scc.rec[c] = true; }
        }
        a = a + 1i64;
    }
    scc.nscc = nscc;
    // Direct out-of-SCC dependency masks.
    let mut e2: i64 = 0i64;
    while e2 < deps.n {
        let f: i64 = deps.efrom[e2];
        let t: i64 = deps.eto[e2];
        if scc.comp[f] != scc.comp[t] {
            scc.dep_mask[f].add(t);
        }
        e2 = e2 + 1i64;
    }
    // Kahn over the condensation (a DAG by construction — the inner scan
    // always finds a placeable SCC).
    let mut placed: Vec<bool> = Vec::<bool>::new();
    let mut zp: i64 = 0i64;
    while zp < nscc { placed.push(false); zp = zp + 1i64; }
    let mut pos: i64 = 0i64;
    while pos < nscc {
        let mut c2: i64 = 0i64;
        while c2 < nscc {
            if !placed[c2] {
                let mut okc: bool = true;
                let mut e3: i64 = 0i64;
                while e3 < deps.n {
                    if scc.comp[deps.efrom[e3]] == c2 {
                        let tc: i64 = scc.comp[deps.eto[e3]];
                        if tc != c2 && !placed[tc] { okc = false; }
                    }
                    e3 = e3 + 1i64;
                }
                if okc {
                    scc.order[pos] = c2;
                    placed[c2] = true;
                    break;
                }
            }
            c2 = c2 + 1i64;
        }
        pos = pos + 1i64;
    }
    return scc;
}

// Parse a fn-style parameter list `name: type (, name: type)*` off `p`, filling
// `out` with each param's name + CORE (deref/slice-stripped) type name + the
// slice flag. The type text between the `:` and the next top-level `,` (or end)
// is scanned; a leading `&` or `&mut ` is skipped, then a `[`-wrapped collection
// (`&[T]` / `[T]` / `[T; N]`) unwraps to its ELEMENT type name with `is_slice`
// set — so a wql! source param `emps: &[Emp]` classifies as (emps, Emp, slice)
// and a trama! context param `o: &Order` as (o, Order, scalar-shaped).
// Empty `p` = zero params. A malformed param stops the scan (the compiler
// re-reports on the verbatim re-emit).
pub fn parse_macro_params(p: str, out: &mut MacroParams) {
    let len: i64 = p.len();
    let mut pos: i64 = 0i64;
    loop {
        while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
        if pos >= len { break; }
        // Param name.
        if !mp_is_alpha(str_byte_at(p, pos)) { break; }
        let nstart: i64 = pos;
        while pos < len && mp_is_alnum(str_byte_at(p, pos)) { pos = pos + 1i64; }
        let nm: str = unsafe { mp_str_range(p, nstart, pos - nstart) };
        while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
        if pos >= len || str_byte_at(p, pos) != 58u8 { break; }   // ':'
        pos = pos + 1i64;
        while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
        // Leading reference marker: `&mut ` or `&`.
        if pos < len && str_byte_at(p, pos) == 38u8 {             // '&'
            pos = pos + 1i64;
            while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
            if pos + 3i64 <= len
               && str_byte_at(p, pos) == 109u8            // 'm'
               && str_byte_at(p, pos + 1i64) == 117u8     // 'u'
               && str_byte_at(p, pos + 2i64) == 116u8 {   // 't'
                let after: u8 = if pos + 3i64 < len { str_byte_at(p, pos + 3i64) } else { 0u8 };
                if !mp_is_alnum(after) {
                    pos = pos + 3i64;
                    while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
                }
            }
        }
        // Slice/array wrapper: `[T]` / `[T; N]` → unwrap to the element head.
        let mut is_sl: bool = false;
        if pos < len && str_byte_at(p, pos) == 91u8 {             // '['
            is_sl = true;
            pos = pos + 1i64;
            while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
        }
        // The core type name = the identifier head of the (possibly compound)
        // type — enough for scalar/schema classification + el_ty_of_name.
        let tstart: i64 = pos;
        while pos < len && mp_is_alnum(str_byte_at(p, pos)) { pos = pos + 1i64; }
        let ty: str = unsafe { mp_str_range(p, tstart, pos - tstart) };
        out.names.push(nm);
        out.tys.push(ty);
        out.is_slice.push(is_sl);
        out.n = out.n + 1i64;
        // Advance past the rest of this param's type to the next top-level comma,
        // honoring bracket/paren/angle nesting so compound types don't mis-split.
        // (The slice `[` already consumed above counts as one open level.)
        let mut depth: i64 = if is_sl { 1i64 } else { 0i64 };
        loop {
            if pos >= len { break; }
            let c: u8 = str_byte_at(p, pos);
            if c == 40u8 || c == 91u8 || c == 60u8 { depth = depth + 1i64; }        // ( [ <
            else if c == 41u8 || c == 93u8 || c == 62u8 { depth = depth - 1i64; }   // ) ] >
            else if c == 44u8 && depth <= 0i64 { break; }                            // ','
            pos = pos + 1i64;
        }
        if pos < len && str_byte_at(p, pos) == 44u8 { pos = pos + 1i64; continue; }  // ','
        break;
    }
}
