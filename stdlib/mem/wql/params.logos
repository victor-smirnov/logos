// logos.std.wql.params — the SHARED macro parameter-list parser (ADR 0012 §6,
// parameterized-resource surface). Both `trama!(<params>){ … }` and
// `deem!(<params>){ … }` carry a GENUINE Logos parameter list in the parens: the
// handler re-emits it VERBATIM into the generated fn signature (the compiler
// parses + type-checks it), and ALSO parses it here to drive schema reflection
// + value-typing. ONE mechanism, two consumers.
//
// Per param we record:
//   • name       — the parameter name (borrowed surface slice);
//   • ty         — the CORE type name: any leading `&` / `&mut` and a slice
//                  wrapper are stripped (`&Order` → `Order`, `&[Emp]` → `Emp`,
//                  `str` → `str`) — enough for scalar/schema classification,
//                  `el_ty_of_name`, and the wql! source row type;
//   • is_slice   — the type was a slice/array collection (`&[T]` / `[T]` /
//                  `[T; N]`): a wql! query SOURCE (`from <name> <var>`).
//
// Robust to trailing commas + arbitrary interior whitespace; balanced
// brackets/parens/angles inside a type (`[T; N]`, `Foo<Bar>`) don't split on
// their internal commas (a nesting depth is tracked).
package logos.std.wql.params;

use logos.lang.str;
use logos.lang.writ.anyval;   // WAny — the parsed query root (ADR 0024 S0)
use logos.mem.string;   // String — native_use_text builds the chunk's use-decl text
use logos.mem.collections.vec;   // per-module use-decl dedup

fn mp_is_space(c: u8) -> bool { return c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8; }
fn mp_is_alpha(c: u8) -> bool {
    return (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) || c == 95u8;
}
fn mp_is_digit(c: u8) -> bool { return c >= 48u8 && c <= 57u8; }
fn mp_is_alnum(c: u8) -> bool { return mp_is_alpha(c) || mp_is_digit(c); }

unsafe fn mp_str_range(src: str, start: i64, len: i64) -> str {
    let l: i64 = if len < 0i64 { 0i64 } else { len };
    return str_from_raw((src.as_ptr() as i64 + start) as *const u8, l);
}

// ── ADR 0016: generated-fn visibility marker ────────────────────────────────
// A leading `-` on a generated fn name marks it NON-pub (a private mapping
// rel — `rel r(…)` without `pub` in a `mapping` item). The marker travels
// inside the fn_name thread through the walk/emit pipeline; every site that
// EMBEDS the name into emitted text strips it via `vis_strip`, and
// `emit_fn_quote_blob` (rexpr_walk) — the shared fn SHELL every Deem emitter
// goes through — chooses the `fn` or the `pub fn` quote from `vis_is_priv`. `-`
// cannot begin a Logos identifier, so the marker is unambiguous. Deem's rel
// helpers BUILD a name with that prefix rather than writing `"fn "`: since
// ADR 0024 S5 the visibility of a generated item is decided in exactly one
// place.
pub fn vis_is_priv(fn_name: str) -> bool {
    return fn_name.len() > 0i64 && str_byte_at(fn_name, 0i64) == 45u8;
}
pub fn vis_strip(fn_name: str) -> str {
    if vis_is_priv(fn_name) {
        return unsafe { mp_str_range(fn_name, 1i64, fn_name.len() - 1i64) };
    }
    return fn_name;
}

// ── The parsed parameter list ──────────────────────────────────────────────
// The REL REGISTRY section (`rel_*` / `relc_*`) is filled by the wql! PROGRAM
// walker (plan_walker) when the block declares `rel` blocks (slice B): the
// rels are query SOURCES exactly like slice params, so they ride on the same
// threaded struct — the emitters resolve a scan's src_name against this
// registry to stamp rel COLUMN types + positional bindings (trama! ignores
// it). Per rel: the declared NAME, the emitted slice-local/param NAME
// (`__rel_<name>_sl` — the plan nodes' src_name is REWRITTEN to this), the
// emitted DELTA slice name (`__dl_<name>_sl` — the semi-naïve fixpoint's
// per-round delta view, slice C; a plan node's src_name is TEMPORARILY
// rewritten to it while a delta-variant body is emitted), the native ROW TYPE
// text (`(i64, str)` / scalar `i64` for a 1-column rel), and the column
// window [coff, coff+ccnt) into the flat relc_* arrays.
pub struct MacroParams {
    pub names:    [str; 64],
    pub tys:      [str; 64],    // CORE type name (deref/slice-stripped)
    pub is_slice: [bool; 64],   // `&[T]`-family — a query SOURCE param
    pub n:        i64,
    // ── rel registry (wql! rel blocks — slices B/C) ──
    pub rel_names: [str; 8],    // declared rel name ("step")
    pub rel_srcs:  [str; 8],    // emitted source name ("__rel_step_sl")
    pub rel_dsrcs: [str; 8],    // emitted DELTA source name ("__dl_step_sl")
    pub rel_rowty: [str; 8],    // native row type text ("(i64, i64)" / "i64")
    pub rel_coff:  [i64; 8],    // column window offset (flat relc_* arrays)
    pub rel_ccnt:  [i64; 8],    // column count
    pub relc_name: [str; 64],   // flat column names
    pub relc_ty:   [str; 64],   // flat column type names ("i64"/"str"/"bool")
    pub rel_n:     i64,
    // ── recursive-aggregate rels (semilattice min/max — the fixpoint lattice) ──
    // Finalized by the stratification check when a rel's aggregate body closes a
    // self-cycle AND its aggregate is an idempotent SEMILATTICE (min/max). Such a
    // rel materializes via a best-per-key MAP absorb (not the set shadow), so the
    // emitter branches on `rel_is_agg`. `rel_agg_dir` is the AGG_* id (min/max) —
    // the lattice order (`<` for min, `>` for max) the absorb gate uses.
    pub rel_is_agg:  [bool; 8],
    pub rel_agg_dir: [i32; 8],
    // ── THE REL'S SCC, FLATTENED ONTO THE REGISTRY (P3b) ──────────────────
    // `RelScc` is computed by the program walker and threaded to the WALKER's
    // emitters, but `emit_incremental` is reached from the ENTRY query's
    // lowering and never sees it — the blocker P3b's scope stage named. Two
    // rel-registry FACTS close it without threading a sixth signature: the
    // rel's SCC id (which names the emitted fixpoint fn) and one derived
    // predicate saying whether that SCC has the shape whose CROSS-EPOCH driver
    // is emitted at all.
    //
    // ⚠ `rel_incr_ok` IS A DERIVATION WITH ONE HOME, and that is the point: the
    // fn-emission side (`emit_rel_fns`) and the admission side
    // (`incr_eligible`) must not answer it twice. `stamp_rel_incr_shape` writes
    // it once, right where `compute_rel_scc` returns; a rel whose flag is false
    // has NO `_i` fn in the artifact, so an admission that disagreed would name
    // a function that does not exist and fail to compile rather than answer.
    ///
    /// ⚠ `rel_incr_why` IS PART OF THE SAME WRITE, not a second opinion about
    /// it. The admission site needs a GROUND that names the antecedent that
    /// actually failed — a refusal reworded into "not supported yet" is the one
    /// nobody revisits — and re-deriving that ground beside the flag is exactly
    /// the "one cell, two opinions" shape this file has been bitten by. One
    /// loop writes the flag and the sentence that explains it; `""` ⇔ admitted.
    pub rel_sccid:   [i64; 8],
    pub rel_incr_ok: [bool; 8],
    pub rel_incr_why: [str; 8],
    // ── NATIVE rels (ADR 0016 M1a): sources with an ENGINE-SUPPLIED
    // materialization instead of query bodies. Today: `<p>: &Writ` params —
    // the generic graph-edge relation (writ_graph_edges). A native rel has
    // no parse-side RQRel (skipped by body passes + fn emission); its
    // prelude line calls the native helper directly.
    pub rel_native:  [bool; 8],
    /// ADR 0024 S4 — the rel's own producer returns an ITERATOR, and the rel is
    /// bound to the STREAM name rather than a slice. `rel_iter` is what the
    /// source offers; `rel_stream` is what the PLAN decided (a rel scanned more
    /// than once must still be drained, so the offer is not the decision).
    pub rel_iter:    [bool; 8],
    pub rel_stream:  [bool; 8],
    /// The producer's RETURN TYPE, as text. The emitted binding is annotated
    /// with it rather than inferring: a generated producer's signature is not
    /// always resolvable in the round its consumer is compiled, and an inferred
    /// `let` then carries an unresolved type var into the loop.
    pub rel_itty:    [str; 8],
    /// The un-sliced binding name (`__rel_<r>`), used when the rel streams —
    /// carrying a name that ends in `_sl` for something that is not a slice
    /// would make generated code lie to whoever reads it.
    pub rel_ssrc:    [str; 8],
    // ADR 0016 §6 (sources as relational interfaces): a native rel's
    // materializer fn name, the param it is applied to, and the module the
    // materializer lives in ("" = the consuming package — no import needed).
    // All three arrive in the compiler's natspec, backed by the natspec str
    // for the duration of the walk. The prelude prints `<mat>(<marg>)`; the
    // chunk imports each distinct non-empty rel_mod. This replaces the old
    // rel_nkind flavor switch — the walker no longer knows ANY source type.
    pub rel_mat:     [str; 8],
    pub rel_marg:    [str; 8],
    /// A NARROWING argument the materializer takes beyond the source itself —
    /// the constant a pushdown reads from (`__ctr_rows_at_Hs…(c, 42u64)`).
    /// Empty for the plain full-scan binding. The capability belongs to the
    /// FAMILY, which publishes one narrowing producer per shape; a plan only
    /// chooses which and supplies the constant.
    pub rel_marg2:   [str; 8],
    pub rel_mod:     [str; 8],
    // ── the item's TYPE-PARAM list, verbatim (`<V: Bound, …>`; "" = concrete) ──
    // A generic `deem q<V: …>(…)` re-emits it onto EVERY generated fn head; the
    // calls between those fns infer their args from the source param, so no
    // turbofish is ever printed. Set by the deem handler from the compiler's
    // slot-4 blob; trama!/catalog leave it empty.
    // ── the source's DECLARED ACCESS OPERATIONS (ADR 0024 S6) ────────────
    // Flat, rel-indexed like the column table: `op_off`/`op_cnt` slice into
    // the shared arrays. What each entry says is what the source declared —
    // the column, the comparison it answers, what implements it, and whether
    // its rows are EXACTLY the matches of that comparison (a `ge` operation is
    // exact for `>=` and a superset when it answers `>`).
    // ── the source's declared SIZE operation (ADR 0024 S4) ───────────────
    // `rel_size_fn` = the fn reporting how many rows the relation holds ("" =
    // the source reports none, and the plan says so); `rel_size_ty` = its
    // return type, so the emitted binding is ANNOTATED for the same reason the
    // producer's is; `rel_size_at` = the binding the measured number lands in.
    //
    // ⚠ A SIZE IS NOT A CARDINALITY CLASS. `AccessPlan.card` stays an ordinal —
    // it is what orders two access choices at expansion time, when there is no
    // container to count. A measured number REFINES that ordinal at run time and
    // replaces nothing: the ordinal is what a static comparison consumes, the
    // number is what a plan built against real data will.
    pub rel_size_fn: [str; 8],
    pub rel_size_ty: [str; 8],
    pub rel_size_at: [str; 8],
    pub op_off:   [i64; 8],
    pub op_cnt:   [i64; 8],
    pub opc_col:  [str; 32],
    pub opc_cmp:  [str; 32],
    pub opc_fn:   [str; 32],
    pub opc_exact:[bool; 32],
    pub opc_iter: [bool; 32],
    pub opc_itty: [str; 32],
    pub op_n:     i64,
    pub tparams:     str,
    // ── the query as a SOURCE (ADR 0024 S0) ──────────────────────────────
    // The parsed root, carried so that ANY diagnostic reached from the walk can
    // locate itself. A position is useless if it is only available where it was
    // produced; the walker's context is what every check already has in hand.
    // Null for surfaces that have no query root (trama!/catalog).
    pub src_root:    WAny,
}

pub fn macro_params_new() -> MacroParams {
    let nul: WAny = WAny::Ref(0i64 as *const u8);
    return MacroParams {
        names: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        tys:   ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        is_slice: [false; 64],
        n: 0i64,
        rel_names: ["", "", "", "", "", "", "", ""],
        rel_srcs:  ["", "", "", "", "", "", "", ""],
        rel_dsrcs: ["", "", "", "", "", "", "", ""],
        rel_rowty: ["", "", "", "", "", "", "", ""],
        rel_coff:  [0i64; 8],
        rel_ccnt:  [0i64; 8],
        relc_name: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                    "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                    "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                    "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        relc_ty:   ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                    "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                    "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                    "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        rel_n: 0i64,
        rel_is_agg:  [false; 8],
        rel_agg_dir: [0i32; 8],
        rel_sccid:   [0i64; 8],
        rel_incr_ok: [false; 8],
        rel_incr_why: [""; 8],
        rel_native:  [false; 8],
        rel_iter:    [false; 8],
        rel_stream:  [false; 8],
        rel_itty:    [""; 8],
        rel_ssrc:    [""; 8],
        rel_mat:     [""; 8],
        rel_marg:    [""; 8],
        rel_marg2:   [""; 8],
        rel_mod:     [""; 8],
        rel_size_fn: [""; 8],
        rel_size_ty: [""; 8],
        rel_size_at: [""; 8],
        op_off:   [0i64; 8],
        op_cnt:   [0i64; 8],
        opc_col:  [""; 32],
        opc_cmp:  [""; 32],
        opc_fn:   [""; 32],
        opc_exact:[false; 32],
        opc_iter: [false; 32],
        opc_itty: [""; 32],
        op_n:     0i64,
        tparams:     "",
        src_root:    nul,
    };
}

impl MacroParams {
    // Index of the param named `name`, or -1.
    pub fn index_of(self: &MacroParams, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.n {
            if str_eq(self.names[i], name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }

    // Is `name` a declared SLICE param (a wql! query source)?
    pub fn is_source(self: &MacroParams, name: str) -> bool {
        let i: i64 = self.index_of(name);
        if i < 0i64 { return false; }
        return self.is_slice[i];
    }

    // Is `name` a declared SCALAR (non-slice) param?
    pub fn is_scalar(self: &MacroParams, name: str) -> bool {
        let i: i64 = self.index_of(name);
        if i < 0i64 { return false; }
        return !self.is_slice[i];
    }

    // Any `IncrRec` engine-source param present? (drives the emitted chunk's
    // conditional `use logos.lcm.deem;` — ADR 0016 M5.)
    /// The extra `use` decls a generated chunk needs for its native-source
    /// materializers — one per DISTINCT non-empty rel_mod. Replaces the old
    /// has_engine_param flag: which modules a chunk needs is now data carried
    /// by the natspec, not a type the walker knows about.
    /// The k-th DISTINCT module a native rel's materializer needs, or "" past
    /// the end — the same list `native_use_text` renders, reachable by index.
    ///
    /// Text and idents are two RENDERINGS of one list. A quote carries its
    /// imports as `Ident`s (`#( use #us; )*`), a text chunk carries them as
    /// source; a second copy of the dedup walk would drift the moment either
    /// changed, which is the failure this whole audit keeps finding.
    pub fn native_use_at(self: &MacroParams, k: i64) -> str {
        let mut seen: i64 = 0i64;
        let mut emitted: Vec<str> = Vec::<str>::new();
        let mut i: i64 = 0i64;
        while i < self.rel_n {
            if self.rel_native[i] && self.rel_mod[i].len() > 0i64 {
                let m: str = self.rel_mod[i];
                let ml: i64 = m.len();
                let mut a: i64 = 0i64;
                while a < ml {
                    let mut b: i64 = a;
                    while b < ml && str_byte_at(m, b) != 44u8 { b = b + 1i64; }
                    if b > a {
                        let one: str = unsafe {
                            str_from_raw(((m.as_ptr() as i64) + a) as *const u8,
                                         b - a)
                        };
                        let mut dup: bool = false;
                        let mut j: i64 = 0i64;
                        while j < emitted.len() {
                            if str_eq(emitted.get(j), one) { dup = true; break; }
                            j = j + 1i64;
                        }
                        if !dup {
                            if seen == k { return one; }
                            emitted.push(one);
                            seen = seen + 1i64;
                        }
                    }
                    a = b + 1i64;
                }
            }
            i = i + 1i64;
        }
        // A streaming or drained source calls `next()`, which is a TRAIT
        // method: without the trait in scope the generated fn cannot resolve
        // it, and the failure surfaces as the item type escaping as a bare
        // type var — a diagnostic that names neither the trait nor the missing
        // import. It is the LAST entry of the same list, not a second list.
        let mut it: i64 = 0i64;
        while it < self.rel_n {
            if self.rel_iter[it] {
                let iter_mod: str = "logos.lang.iter";
                let mut dup2: bool = false;
                let mut j2: i64 = 0i64;
                while j2 < emitted.len() {
                    if str_eq(emitted.get(j2), iter_mod) { dup2 = true; break; }
                    j2 = j2 + 1i64;
                }
                if !dup2 && seen == k { return iter_mod; }
                it = self.rel_n;
            } else { it = it + 1i64; }
        }
        return "";
    }

    /// The SAME list `native_use_at` indexes, rendered as chunk source text.
    /// ⚠ Derived, not re-walked. The two used to be independent walks and had
    /// already drifted — the text one imported the iterator trait and the
    /// indexed one did not, so a converted emitter's generated fn lost an
    /// import the text chunk had.
    pub fn native_use_text(self: &MacroParams, out: &mut String) {
        let mut k: i64 = 0i64;
        loop {
            let one: str = self.native_use_at(k);
            if one.len() == 0i64 { break; }
            out.push_str("use ");
            out.push_str(one);
            out.push_str("; ");
            k = k + 1i64;
        }
    }

    // The CORE type name of the param named `name` ("" if absent).
    pub fn ty_of(self: &MacroParams, name: str) -> str {
        let i: i64 = self.index_of(name);
        if i < 0i64 { return ""; }
        return self.tys[i];
    }

    // ── rel registry (filled by the wql! program walker; slices B/C) ────────

    // Register a rel (declaration order). Returns the rel index (-1 = full).
    pub fn rel_add(self: &mut MacroParams, name: str, src: str, dsrc: str, rowty: str) -> i64 {
        if self.rel_n >= 8i64 { return -1i64; }
        let i: i64 = self.rel_n;
        self.rel_names[i] = name;
        self.rel_srcs[i]  = src;
        self.rel_dsrcs[i] = dsrc;
        self.rel_rowty[i] = rowty;
        // Columns append at the current flat top.
        let mut off: i64 = 0i64;
        if i > 0i64 { off = self.rel_coff[i - 1i64] + self.rel_ccnt[i - 1i64]; }
        self.rel_coff[i] = off;
        self.rel_ccnt[i] = 0i64;
        self.rel_n = i + 1i64;
        return i;
    }

    // Append one column to the LAST registered rel.
    /// Record one declared operation for the rel most recently registered.
    pub fn rel_add_op(self: &mut MacroParams, col: str, cmp: str, fn_name: str,
                      exact: bool, iter: bool, ity: str) {
        if self.op_n >= 32i64 { return; }
        let r: i64 = self.rel_n - 1i64;
        if r < 0i64 { return; }
        if self.op_cnt[r] == 0i64 { self.op_off[r] = self.op_n; }
        self.opc_col[self.op_n]   = col;
        self.opc_cmp[self.op_n]   = cmp;
        self.opc_fn[self.op_n]    = fn_name;
        self.opc_exact[self.op_n] = exact;
        self.opc_iter[self.op_n]  = iter;
        self.opc_itty[self.op_n]  = ity;
        self.op_n = self.op_n + 1i64;
        self.op_cnt[r] = self.op_cnt[r] + 1i64;
    }

    /// Does the source EMITTED under this name stream? Safe for a name that is
    /// no rel at all (a slice param), which is why the emitters ask this rather
    /// than indexing `rel_stream` by a lookup that can return -1.
    pub fn rel_src_streams(self: &MacroParams, src: str) -> bool {
        let i: i64 = self.rel_find_src(src);
        if i < 0i64 { return false; }
        return self.rel_stream[i];
    }

    // The op that answers a demand is no longer FOUND here. A search whose
    // order is the choice cannot be costed, and the two weakenings this used to
    // hardcode (`ge` for `gt`, `le` for `lt`) were not the only ones that hold.
    // The covering relation is `access_plan::ap_covers`, written once, and the
    // choice among covering ops is a comparison of cardinality — ADR 0024 S4.

    /// True when the operation at `oi` answers `cmp` EXACTLY — the query's
    /// residual filter is then redundant. False for a superset, where it is
    /// what keeps the answer correct.
    pub fn rel_op_is_exact(self: &MacroParams, oi: i64, cmp: str) -> bool {
        if oi < 0i64 || oi >= self.op_n { return false; }
        if !self.opc_exact[oi] { return false; }
        return str_eq(self.opc_cmp[oi], cmp);
    }

    pub fn rel_add_col(self: &mut MacroParams, col_name: str, col_ty: str) {
        if self.rel_n == 0i64 { return; }
        let i: i64 = self.rel_n - 1i64;
        let k: i64 = self.rel_coff[i] + self.rel_ccnt[i];
        if k >= 64i64 { return; }
        self.relc_name[k] = col_name;
        self.relc_ty[k]   = col_ty;
        self.rel_ccnt[i]  = self.rel_ccnt[i] + 1i64;
    }

    // Rel index by DECLARED name ("step"), or -1.
    pub fn rel_find_name(self: &MacroParams, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.rel_n {
            if str_eq(self.rel_names[i], name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }

    // Rel index by EMITTED source name ("__rel_step_sl") OR delta source name
    // ("__dl_step_sl"), or -1 — the emit-side lookup (plan nodes' src_name is
    // rewritten to the emitted name; the semi-naïve delta-variant emission
    // temporarily rewrites an in-SCC occurrence to the delta name, and the
    // column stamping must resolve BOTH spellings to the same rel).
    pub fn rel_find_src(self: &MacroParams, src: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.rel_n {
            if str_eq(self.rel_srcs[i], src) { return i; }
            if str_eq(self.rel_dsrcs[i], src) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
}

/// `let <size_at>: <size_ty> = <size_fn>(<marg>);` — the rel's SIZE, obtained
/// ONCE (ADR 0024 S4g). Nothing when the source declared no reporter.
///
/// ⚠ ONE COPY, because the statement is now needed in TWO bodies: the query's
/// own prelude (plan_walker) and the PREPARE fn's measurement (rexpr_walk,
/// S4i) — and a prepared plan that spelled the reporter call differently from
/// the query would compare a number to one obtained another way. It lives here
/// for the same reason `RelScc` does: params.logos is the module both sides
/// already share.
///
/// ⚠ ANNOTATED from the DECLARED return type, inferred only when none
/// travelled: the reporter of a factory-generated family lands in the same
/// round its query lowers, and an inferred `let` then carries an unresolved
/// type var out of the prelude.
pub fn size_binding_text(out: &mut String, prm: &MacroParams, r: i64) {
    if prm.rel_size_fn[r].len() == 0i64 { return; }
    out.push_str("    let ");
    out.push_str(prm.rel_size_at[r]);
    if prm.rel_size_ty[r].len() > 0i64 {
        out.push_str(": ");
        out.push_str(prm.rel_size_ty[r]);
    }
    out.push_str(" = ");
    out.push_str(prm.rel_size_fn[r]);
    out.push_str("(");
    out.push_str(prm.rel_marg[r]);
    out.push_str(");\n");
}

// ── RelScc — the rel dependency CONDENSATION (slice C — recursive rels) ──────
// Computed by the program walker (plan_walker::compute_rel_scc) from the
// RelDeps edge list; consumed by BOTH the walker (stratification validation +
// entry-prelude materialization order) and the emitter (rexpr_walk::
// emit_rel_fns — one helper fn per non-recursive rel, one semi-naïve fixpoint
// fn per recursive SCC). Lives here because params.logos is the module both
// sides already share (the rel registry's home).
//   comp[r]     — rel index → SCC id (ids assigned in declaration order);
//   rec[c]      — SCC id → RECURSIVE? (size > 1, or a self-loop member);
//   order[k]    — topo position → SCC id (dependencies-first — the
//                 materialization/evaluation order of the condensation DAG);
//   nscc        — SCC count;
//   dep_mask[r] — rel index → bitmask of DIRECT out-of-SCC rel dependencies
//                 (bit j ⇔ some body of r scans rel j, comp[j] != comp[r]) —
//                 the helper-fn extra-parameter set (in-SCC edges are the
//                 fixpoint's own state, not parameters).
pub struct RelScc {
    pub comp:     [i64; 8],
    pub rec:      [bool; 8],
    pub order:    [i64; 8],
    pub nscc:     i64,
    pub dep_mask: [i64; 8],
}

/// P3b — FLATTEN the condensation onto the rel registry, and DERIVE, once, the
/// one predicate both the fn-emission side and the admission side ask.
///
/// `rel_incr_ok[r]` = "rel `r`'s SCC has a CROSS-EPOCH semi-naïve driver". Every
/// clause names the piece that is missing rather than saying "not yet", and the
/// narrowness is deliberate: this is the FIRST slice in which a handle owns a
/// whole derived relation, so the shape it owns is the one shape a fixture in
/// this slice runs at every epoch on cyclic data.
///
///   • RECURSIVE — a NON-recursive rel materializes through the one-shot helper
///     (`__wql_<q>_rel_<r>`), which has no total to extend and no shadow set to
///     seed; its epoch would have to CLEAR and re-fold the group state, a
///     different mechanism with its own failure modes. It keeps its refusal, and
///     the second measured wrong answer (a rel is a SET; the same edge twice
///     counted twice) stays REFUSED rather than becoming wrong.
///   • NO AGGREGATE MEMBER — a recursive min/max member's state is a
///     best-per-key MAP plus a distinct-key roster plus a round counter, and its
///     total is MATERIALIZED after the loop rather than appended during it, so
///     "the rows added this epoch" is not a suffix of the total. That is a
///     strictly harder promotion and it is not this slice's.
///   • NO OUT-OF-SCC REL DEPENDENCY (`dep_mask == 0`) — a lower-stratum rel is
///     itself derived, so maintaining this one across epochs means maintaining
///     THAT one too, and the entry query would need both totals on the handle.
///   • NO NATIVE / NO STREAMING MEMBER — a native rel is a pure function of a
///     caller-owned `&Writ` with no parse-side bodies at all, and a streaming
///     rel is bound to an iterator rather than to a slice the driver can total.
///   • EVERY REL IN THE PROGRAM IS A MEMBER OF THIS SCC — with a rel OUTSIDE it
///     the entry prelude has more than one materialization step and `<q>_epoch`
///     would have to reproduce the ORDER of them; one SCC covering the whole
///     registry makes the epoch body derivable from the registry alone, which is
///     what removes the threaded second prelude.
///
/// ══ P3c — THE CLAUSES ARE PER-SCC, NOT PER-REL, AND THAT IS THE WIDENING ═══
///
/// P3b asked every clause of the rel `r` ALONE, which was indistinguishable from
/// asking it of the SCC because `nmem != 1` had already refused everything else.
/// Widening to mutual recursion makes the difference load-bearing: the `_i`
/// driver emitted for an SCC contains the state of EVERY member, so an SCC whose
/// members are {plain, aggregate} would get a driver in which one member's total
/// is appended during the loop and the other's is MATERIALIZED after it — and
/// the `_i` seeding path (`__rs_<m>` walked out of `__tot_<m>`) exists only on
/// the plain branch, so the aggregate member would enter every epoch after the
/// first with an EMPTY best-per-key map and re-derive its extremum from the
/// delta alone. Hence `any_agg`, `any_native`, `any_stream` and the UNION of the
/// dep masks: a clause that held for the selected member but not for its
/// co-member would have admitted exactly that.
///
/// ⚠ NO CAPACITY CLAUSE, and the reason is a bound rather than an oversight:
/// `rel_add` refuses past 8 (`rel_n >= 8` → -1), so `nmem <= rel_n <= 8` and
/// `emit_scc_fn`'s `mem: [i64; 8]` and the handle's `[String; 8]` total-name
/// array cannot be overrun. If `rel_add`'s bound ever moves, both move with it.
pub fn stamp_rel_incr_shape(prm: &mut MacroParams, scc: &RelScc) {
    let mut r: i64 = 0i64;
    while r < prm.rel_n {
        let c: i64 = scc.comp[r];
        prm.rel_sccid[r] = c;
        let mut nmem: i64 = 0i64;
        // ── THE SCC'S PROPERTIES, NOT THE REL'S — see the P3c note above ────
        let mut any_agg:    bool = false;
        let mut any_native: bool = false;
        let mut any_stream: bool = false;
        let mut mask_u:     i64  = 0i64;
        let mut k: i64 = 0i64;
        while k < prm.rel_n {
            if scc.comp[k] == c {
                nmem = nmem + 1i64;
                if prm.rel_is_agg[k] { any_agg = true; }
                if prm.rel_native[k] { any_native = true; }
                if prm.rel_iter[k] || prm.rel_stream[k] { any_stream = true; }
                mask_u = mask_u | scc.dep_mask[k];
            }
            k = k + 1i64;
        }
        // ⚠ ORDER MATTERS ONLY FOR THE SENTENCE, NOT FOR THE FLAG: the flag is
        // the conjunction and is written last, from the same `why`. A clause
        // added to one and not the other cannot happen — there is one `if`.
        let mut why: str = "";
        if !scc.rec[c] {
            why = "the source is a NON-RECURSIVE declared `rel` — it materializes through the one-shot helper, which has no fixpoint TOTAL to extend and no shadow set to seed, so maintaining it across epochs means CLEARING and re-folding the group state rather than extending it (the dedup defect this refusal closes is still real: a rel is a SET and the same fact twice is one row)";
        } else if nmem != prm.rel_n {
            // ⚠ P3c REPLACED `prm.rel_n != 1` WITH THIS, AND THE OLD CLAUSE'S
            // GROUND IS WHY. That ground was "the entry prelude then has several
            // materialization steps in a condensation order". It evaporates
            // exactly when EVERY declared rel is a member of THIS SCC:
            // `emit_prelude_scc` then emits ONE step and there is no order to
            // reproduce. It does NOT evaporate for a rel outside the SCC, and
            // that is the case this clause still refuses — which is also the
            // `dep_mask` clause's neighbour, but not its duplicate: a rel
            // outside the SCC that this SCC does NOT scan still has to be
            // materialized by the entry, in an order `<q>_epoch` cannot derive.
            why = "the program declares a `rel` OUTSIDE this recursive SCC — the entry prelude then has several materialization steps in a condensation order, and `<q>_epoch` would have to reproduce that order rather than derive its whole body from the registry";
        } else if any_agg {
            why = "a member of the recursive SCC is an AGGREGATE rel (a min/max semilattice head) — its state is a best-per-key MAP plus a distinct-key roster plus a convergence counter, and its total is MATERIALIZED after the loop rather than appended during it, so `the rows added this epoch` is not a suffix of the total; the `_i` variant seeds a shadow set from the total and there is no such seeding for a map";
        } else if any_native {
            why = "a member of the SCC is NATIVE (`&Writ`) — it has no parse-side bodies and no fixpoint at all; it is a pure function of one caller-owned container";
        } else if any_stream {
            why = "a member of the SCC STREAMS — it is bound to an iterator rather than to a slice, and a total the handle owns must be a materialized Vec";
        } else if mask_u != 0i64 {
            why = "the recursive SCC DEPENDS ON A LOWER-STRATUM `rel` — that rel is itself derived, so maintaining this one across epochs means maintaining that one too and the handle would have to own both totals";
        }
        prm.rel_incr_why[r] = why;
        prm.rel_incr_ok[r]  = why.len() == 0i64;
        r = r + 1i64;
    }
}

pub fn rel_scc_new() -> RelScc {
    return RelScc {
        comp:     [0i64; 8],
        rec:      [false; 8],
        order:    [0i64; 8],
        nscc:     0i64,
        dep_mask: [0i64; 8],
    };
}

// ── RelDeps — the EXPLICIT rel dependency edge list ──────────────────────────
// One edge per rel→rel source reference: `efrom[k]` (the referencing rel's
// declaration index) → `eto[k]` (the referenced rel). The condensation
// (compute_rel_scc) consumes this list to find the recursive SCCs; the
// stratification check additionally consumes the NEGATED (anti-join) and
// AGGREGATED sub-lists — a cycle through either is non-stratifiable.
// MOVED here from plan_walker (queue-2 slice I3): the graph half is PURE
// (no metaprog) and is now shared by the static walker AND the runtime
// interpreter (logos.std.deem) — the same layering move as lower.logos.
pub struct RelDeps {
    pub efrom: [i64; 64],
    pub eto:   [i64; 64],
    pub n:     i64,
    // Anti-join rel edges: rel `afrom[k]`'s body `anti join`s rel `ato[k]`.
    pub afrom: [i64; 16],
    pub ato:   [i64; 16],
    pub an:    i64,
    // Aggregate-body rel-source edges: rel `gfrom[k]` has an AGGREGATE body
    // scanning rel `gto[k]` (aggregate bodies are themselves rejected — this
    // list only selects WHICH diagnostic: in-SCC ⇒ the non-stratified cycle
    // error, else the plain "aggregate bodies are not allowed" one).
    pub gfrom: [i64; 16],
    pub gto:   [i64; 16],
    pub gn:    i64,
    // First rel with an aggregate body (-1 = none) — the deferred plain reject.
    pub agg_head: i64,
    // Per rel: the AGG_* id of its aggregate body's aggregate (0 = no aggregate
    // body). Set by the STATIC walker only (the runtime interpreter's add_agg
    // callers leave it 0). The stratification check reads it to decide whether an
    // in-cycle aggregate is an admissible SEMILATTICE (min/max) recursive head or
    // a non-stratifiable GROUP (sum/count/avg) one.
    pub head_agg_dir: [i32; 8],
}

pub fn rel_deps_new() -> RelDeps {
    return RelDeps { efrom: [0i64; 64], eto: [0i64; 64], n: 0i64,
                     afrom: [0i64; 16], ato: [0i64; 16], an: 0i64,
                     gfrom: [0i64; 16], gto: [0i64; 16], gn: 0i64,
                     agg_head: -1i64, head_agg_dir: [0i32; 8] };
}

impl RelDeps {
    pub fn add(self: &mut RelDeps, f: i64, t: i64) {
        if self.n >= 64i64 { return; }
        self.efrom[self.n] = f;
        self.eto[self.n]   = t;
        self.n = self.n + 1i64;
    }

    pub fn add_anti(self: &mut RelDeps, f: i64, t: i64) {
        if self.an >= 16i64 { return; }
        self.afrom[self.an] = f;
        self.ato[self.an]   = t;
        self.an = self.an + 1i64;
    }

    pub fn add_agg(self: &mut RelDeps, f: i64, t: i64) {
        if self.gn >= 16i64 { return; }
        self.gfrom[self.gn] = f;
        self.gto[self.gn]   = t;
        self.gn = self.gn + 1i64;
    }

    // Record rel `f`'s aggregate-body aggregate id (AGG_* — min/max/sum/…). The
    // static walker calls this from the aggregate-body check; consumed by the
    // stratification check to classify the cycle. Idempotent per rel.
    pub fn set_head_agg_dir(self: &mut RelDeps, f: i64, dir: i32) {
        if f >= 0i64 && f < 8i64 { self.head_agg_dir[f] = dir; }
    }
}

// ── SCC condensation over RelDeps ────────────────────────────────────────────
// Rel counts are tiny (≤ 8), so the CLEAN quadratic-closure formulation wins
// over Tarjan bookkeeping: Warshall transitive closure (path length ≥ 1), then
//   same SCC    ⇔ mutual reachability;
//   RECURSIVE   ⇔ SCC size > 1, or reach[i][i] (a cycle through i — covers the
//                 plain self-edge);
//   topo order  ⇔ Kahn over the condensation, dependencies FIRST (an SCC is
//                 placed once every SCC it depends on is placed; smallest id
//                 first — deterministic);
//   dep_mask[r] ⇔ DIRECT out-of-SCC dependencies (the helper-fn extra-param
//                 set; in-SCC edges are the fixpoint's own state).
pub fn compute_rel_scc(deps: &RelDeps, nr: i64) -> RelScc {
    let mut scc: RelScc = rel_scc_new();
    // Transitive closure (flat 8×8; reach[i*8+j] ⇔ a path of length ≥ 1).
    let mut reach: [bool; 64] = [false; 64];
    let mut e: i64 = 0i64;
    while e < deps.n {
        reach[deps.efrom[e] * 8i64 + deps.eto[e]] = true;
        e = e + 1i64;
    }
    let mut k: i64 = 0i64;
    while k < nr {
        let mut i: i64 = 0i64;
        while i < nr {
            if reach[i * 8i64 + k] {
                let mut j: i64 = 0i64;
                while j < nr {
                    if reach[k * 8i64 + j] { reach[i * 8i64 + j] = true; }
                    j = j + 1i64;
                }
            }
            i = i + 1i64;
        }
        k = k + 1i64;
    }
    // Components (mutual reachability), ids in declaration order.
    let mut i0: i64 = 0i64;
    while i0 < nr { scc.comp[i0] = -1i64; i0 = i0 + 1i64; }
    let mut nscc: i64 = 0i64;
    let mut a: i64 = 0i64;
    while a < nr {
        if scc.comp[a] < 0i64 {
            let c: i64 = nscc;
            nscc = nscc + 1i64;
            scc.comp[a] = c;
            let mut sz: i64 = 1i64;
            let mut b: i64 = a + 1i64;
            while b < nr {
                if scc.comp[b] < 0i64 && reach[a * 8i64 + b] && reach[b * 8i64 + a] {
                    scc.comp[b] = c;
                    sz = sz + 1i64;
                }
                b = b + 1i64;
            }
            if sz > 1i64 || reach[a * 8i64 + a] { scc.rec[c] = true; }
        }
        a = a + 1i64;
    }
    scc.nscc = nscc;
    // Direct out-of-SCC dependency masks.
    let mut e2: i64 = 0i64;
    while e2 < deps.n {
        let f: i64 = deps.efrom[e2];
        let t: i64 = deps.eto[e2];
        if scc.comp[f] != scc.comp[t] {
            scc.dep_mask[f] = scc.dep_mask[f] | (1i64 << t);
        }
        e2 = e2 + 1i64;
    }
    // Kahn over the condensation (a DAG by construction — the inner scan
    // always finds a placeable SCC).
    let mut placed: [bool; 8] = [false; 8];
    let mut pos: i64 = 0i64;
    while pos < nscc {
        let mut c2: i64 = 0i64;
        while c2 < nscc {
            if !placed[c2] {
                let mut okc: bool = true;
                let mut e3: i64 = 0i64;
                while e3 < deps.n {
                    if scc.comp[deps.efrom[e3]] == c2 {
                        let tc: i64 = scc.comp[deps.eto[e3]];
                        if tc != c2 && !placed[tc] { okc = false; }
                    }
                    e3 = e3 + 1i64;
                }
                if okc {
                    scc.order[pos] = c2;
                    placed[c2] = true;
                    break;
                }
            }
            c2 = c2 + 1i64;
        }
        pos = pos + 1i64;
    }
    return scc;
}

// Parse a fn-style parameter list `name: type (, name: type)*` off `p`, filling
// `out` with each param's name + CORE (deref/slice-stripped) type name + the
// slice flag. The type text between the `:` and the next top-level `,` (or end)
// is scanned; a leading `&` or `&mut ` is skipped, then a `[`-wrapped collection
// (`&[T]` / `[T]` / `[T; N]`) unwraps to its ELEMENT type name with `is_slice`
// set — so a wql! source param `emps: &[Emp]` classifies as (emps, Emp, slice)
// and a trama! context param `o: &Order` as (o, Order, scalar-shaped).
// Empty `p` = zero params. A malformed param stops the scan (the compiler
// re-reports on the verbatim re-emit).
pub fn parse_macro_params(p: str, out: &mut MacroParams) {
    let len: i64 = p.len();
    let mut pos: i64 = 0i64;
    loop {
        while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
        if pos >= len { break; }
        // Param name.
        if !mp_is_alpha(str_byte_at(p, pos)) { break; }
        let nstart: i64 = pos;
        while pos < len && mp_is_alnum(str_byte_at(p, pos)) { pos = pos + 1i64; }
        let nm: str = unsafe { mp_str_range(p, nstart, pos - nstart) };
        while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
        if pos >= len || str_byte_at(p, pos) != 58u8 { break; }   // ':'
        pos = pos + 1i64;
        while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
        // Leading reference marker: `&mut ` or `&`.
        if pos < len && str_byte_at(p, pos) == 38u8 {             // '&'
            pos = pos + 1i64;
            while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
            if pos + 3i64 <= len
               && str_byte_at(p, pos) == 109u8            // 'm'
               && str_byte_at(p, pos + 1i64) == 117u8     // 'u'
               && str_byte_at(p, pos + 2i64) == 116u8 {   // 't'
                let after: u8 = if pos + 3i64 < len { str_byte_at(p, pos + 3i64) } else { 0u8 };
                if !mp_is_alnum(after) {
                    pos = pos + 3i64;
                    while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
                }
            }
        }
        // Slice/array wrapper: `[T]` / `[T; N]` → unwrap to the element head.
        let mut is_sl: bool = false;
        if pos < len && str_byte_at(p, pos) == 91u8 {             // '['
            is_sl = true;
            pos = pos + 1i64;
            while pos < len && mp_is_space(str_byte_at(p, pos)) { pos = pos + 1i64; }
        }
        // The core type name = the identifier head of the (possibly compound)
        // type — enough for scalar/schema classification + el_ty_of_name.
        let tstart: i64 = pos;
        while pos < len && mp_is_alnum(str_byte_at(p, pos)) { pos = pos + 1i64; }
        let ty: str = unsafe { mp_str_range(p, tstart, pos - tstart) };
        if out.n < 64i64 {
            out.names[out.n]    = nm;
            out.tys[out.n]      = ty;
            out.is_slice[out.n] = is_sl;
            out.n = out.n + 1i64;
        }
        // Advance past the rest of this param's type to the next top-level comma,
        // honoring bracket/paren/angle nesting so compound types don't mis-split.
        // (The slice `[` already consumed above counts as one open level.)
        let mut depth: i64 = if is_sl { 1i64 } else { 0i64 };
        loop {
            if pos >= len { break; }
            let c: u8 = str_byte_at(p, pos);
            if c == 40u8 || c == 91u8 || c == 60u8 { depth = depth + 1i64; }        // ( [ <
            else if c == 41u8 || c == 93u8 || c == 62u8 { depth = depth - 1i64; }   // ) ] >
            else if c == 44u8 && depth <= 0i64 { break; }                            // ','
            pos = pos + 1i64;
        }
        if pos < len && str_byte_at(p, pos) == 44u8 { pos = pos + 1i64; continue; }  // ','
        break;
    }
}
