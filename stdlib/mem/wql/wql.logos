// logos.std.wql.wql — the `deem!(<params>){ … }` RESOURCE surface (ADR 0012 §6 /
// §10.2, queue-1 STATIC lowering). A `#[token_macro]` handler receives the raw
// params source text + the raw query block bytes at compile time, PARSES the
// query via the peg-GENERATED surface parser (`wql_surface_parser::parse_query`
// → an `RQuery` query-PLAN, itself Writ schemas — ADR 0011 dogfood), then WALKS
// that schema'd plan to EMIT a native Logos function (`plan_walker::
// walk_query_params`) that iterates the source, filters, and collects the
// projected rows — the "prepared statement" model (no runtime-string queries;
// ADR 0012 §queues).
//
// Surface (PARAMETERIZED form — a REAL fn-style parameter list in the parens,
// exactly trama!'s model; the old inline `:[Ty]` source typing, the `$` param
// sigil, and the `with` clause are GONE):
//
//   pub deem <name>(<params>) { from <src> <var> [ where P ] select S [: RTy] }
//     e.g.  pub deem top(emps: &[Emp], n: i64) {
//               from emps e where e.salary > 50.0 select e.name limit n }
//
//   →  pub fn top(emps: &[Emp], n: i64) -> Result<Vec<str>, ElError> { … }
//        (error-returning: an integer overflow / division-by-zero in an EL
//         expression becomes `Err(ElError)`, never a host trap — call with `?`
//         or `match`; f64 arithmetic stays IEEE, string concat is unchanged.)
//
// The PARENS carry a genuine Logos parameter list — parsed + TYPE-CHECKED by
// the compiler because the handler re-emits it VERBATIM into the generated fn
// signature (param ORDER = the paren-list order):
//   • SLICE params (`emps: &[Emp]`) are the query SOURCES: a `from`/`join`
//     clause names one by its param name (`from emps e`); the row type is the
//     slice ELEMENT type and its fields reflect automatically (reflect.logos).
//     A source ident that does not match a slice param is a compile error.
//   • SCALAR params (i64 / f64 / str / bool) are referenced BARE in the EL
//     clause bodies (`e.salary > min_sal`, `limit n`) — typed off the list.
//
// The generated fn NAME is the `resource <name> =` binding (ADR 0012 §6); the
// handler receives it as the `name` arg.
//
// REL BLOCKS (slices B/C — static Datalog, RECURSION SUPPORTED): zero or more
//   rel NAME ( col: ty, … ) { body; body; … }
// blocks may precede the entry query. Each rel is a named derived relation
// with SET semantics (structural-equality dedup; columns i64/str/bool — f64
// kills Eq); bodies are from/join/where/select producers over slice params +
// ANY rel (self/forward/mutual references are legal — recursive SCCs run as
// ONE shared semi-naïve fixpoint; negation/aggregation against a rel of the
// SAME SCC is the named non-stratifiable error, against an earlier stratum
// it composes). Termination is the standard Datalog contract: guaranteed
// unless a recursive head MINTS values (arithmetic) — not capped. The entry
// query scans rels like sources (all modifiers compose; `find`/whole-row
// select are gated — rels are fn-locals, rows cannot be borrowed out).
//
// Relational shapes off the same `from` prefix:
//   • `[anti] join <b> <y> on <onPred>` → inner / anti nested-loop join;
//   • `[where …] group by <key> aggregate <a>=<fn>(<e>),…` → group-by + aggregate;
// and the SINGLE-ROW forms:
//   • `select first <S>` (simple/join) → Option<ElemTy>, the first projected
//     value (scan order, or ORDER BY order); excludes distinct/limit;
//   • `from <src> <v> find <P>` → Option<&Ty>, a borrow of the first matching
//     row (early-exit, zero-copy); takes no other clause; P may reference
//     scalar params bare.
// The RQuery plan family (`logos.std.wql.plan`) has one schema variant per shape;
// the walker (`plan_walker.logos`) dispatches on it via `match`.
package logos.std.wql.wql;

use logos.std.compiler.metaprog;         // ItemList, item_list_new, error
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.std.wql.params;                // MacroParams / parse_macro_params — SHARED with trama!
use logos.std.wql.wql_surface_parser;    // parse_program — the GENERATED surface parser
use logos.std.wql.plan_walker;           // walk_program_params — the program walker-emitter
use logos.std.wql.lower;                 // desugar_program_gpaths — graph-path sugar (M2a)
use logos.std.wql.codegen;               // plan_trace — the demand decision on the [plan] channel
use logos.std.wql.dl_export;             // dl_export — the Soufflé oracle's program text
use logos.std.wql.core;                  // the Deem core (ADR 0031): lowered once, verified
use logos.std.wql.crewrite;              // the core rewrites (ADR 0031 R3)
use logos.std.wql.check;                 // the checks over the core (ADR 0031 R2)
use logos.std.wql.dplan;                 // the plan as data (ADR 0031 R5)
use logos.std.wql.why;                   // ms_render / ms_name — the demand decision's words
use logos.mem.string;                    // String — the desugar error buffer
use logos.lang.str;                      // str_from_raw — error-text view
// PAIR-HALF (ADR 0025 S3a). Not used by any name in THIS file — it is here to
// put `logos.mem.stream` in the TRIGGER module's import closure, because a
// spliced item's own `use P;` makes P's names VISIBLE but does not LOAD P. The
// other half is the `use logos.mem.stream;` literal in both `quote_item!`s of
// `rexpr_walk::emit_fn_quote_blob`; each alone is measurably insufficient, so
// neither is the redundant one. Pinned by `wql_drain_import_pair` (probe pair).
use logos.mem.stream;                    // Buffer<R> — the Drain node's landing (S3b)
// PAIR-HALF, R-A. Same rule, second package: `logos.mem.stream` (mem tier) does
// not carry `SliceStream<R>` — the borrowed batch view lives at LANG tier
// (`stdlib/lang/stream/stream.logos`), so the wrap's package needs its own
// trigger-module load beside the `use logos.lang.stream;` literal in
// `emit_fn_quote_blob`'s two quotes.
use logos.lang.stream;                   // SliceStream<R> — the slice param's batch door (R-A)

extern fn getenv(name: *const u8) -> *const u8;   // LOGOS_DEEM_NO_DEMAND

// ── The resource handler ───────────────────────────────────────────────────
// `#[token_macro]` 3-arg form: receives the `resource` binding name, the raw
// params source text, and the raw `{ … }` block bytes. PARSE (peg-generated
// surface parser → RQuery plan), STAMP (fn name + row types off the slice
// params), then WALK (plan_walker → emitted native fn). The emitted source is
// spliced by the host's Emitter/`logos_emit_source` (ADR 0012 §10.2); the
// handler returns an (empty) ItemList.
/// Handler behind the `deem!{}` macro — Logos's Datalog/query DSL over `Writ` data.
///
/// Invoked by the `deem` ITEM lowering (`pub deem <name>(<params>) { <query> }`); `name` is the
/// `resource` binding, `params` is the raw parenthesized fn-parameter-list source
/// (slice params are query sources, scalar params are bare-referenced in clauses),
/// and `body` is the raw `{ … }` query-block text. Splices a generated native fn
/// named `name` back into the caller's module (this handler itself returns an
/// empty `ItemList`); the generated fn's shape depends on the query's terminal
/// clause:
///   - `select <expr> : <ty>` → `pub fn name(<params>) -> Result<Vec<ty>, ElError>`,
///     one row per match (error-returning: overflow/div-by-zero in the EL
///     expression is `Err`, never a host trap);
///   - `from <src> <v> find <P>` → `pub fn name(<params>) -> Result<Option<&Ty>, ElError>`,
///     a borrow of the first row matching `P` (early-exit, zero-copy; `find`
///     takes no other clause).
/// Reports a compiler `error` (not a panic) and returns an empty `ItemList` on a
/// missing binding name, an empty/malformed `params` list, or a query that fails
/// to parse.
// &String → str view (metaprog error() takes str).
fn gp_err_str(s: &String) -> str {
    return unsafe { str_from_raw(s.as_ptr(), s.len()) };
}

// ADR 0016 body lift: the third argument is NOT the query text — it is a raw
// pointer into the COMPILER's Writ arena, at the root of the RQProgram the
// compiler already parsed, with the C++ parser generated from the same wql.peg
// this module's runtime parser comes from. We walk that tree in place.
//
// Nothing is copied and nothing is deserialised: `WAny::Ref` resolves to an
// absolute address and `.view::<S>()` is a compiler builtin that casts. Nodes
// we synthesise go into our OWN `h: Writ`; a self-relative edge is computed from
// its slot's own address, so a foreign slot may point at a local node and vice
// versa. Both arenas are never-move for the duration of the dispatch loop.
#[token_macro]
pub fn deem(name: str, params: str, enrich: str, natspec: str, tparams: str,
            ir: *const u8) -> ItemList {
    let out: ItemList = item_list_new();
    if name.len() == 0i64 {
        error("deem: needs a name — write `pub deem <name>(<params>) { from … select … }`");
        return out;
    }
    // Parse the REAL parameter list (shared mechanism with trama!). The params
    // are re-emitted VERBATIM as the generated fn signature; here we ALSO parse
    // them locally to bind sources (slice params) + type scalar params.
    let mut prm: MacroParams = macro_params_new();
    // `<V: Bound, …>` verbatim from the item head — every generated fn head
    // (the query fn and its per-rel/SCC helpers) re-emits it, and every CALL
    // between them infers the args from the source param. Empty for a
    // concrete query, which is the whole of the pre-generic behaviour.
    prm.tparams = tparams;
    parse_macro_params(params, &mut prm);
    if prm.n == 0i64 {
        error("deem: needs at least one parameter — write `pub deem <name>(<src>: &[RowTy], …) { from <src> <var> … }`");
        return out;
    }
    // Our OWN arena — only for nodes the desugar/walk passes synthesise. The
    // program itself lives in the compiler's arena; malformed input never gets
    // this far, since the compiler's parse is what failed.
    let h: Writ = writ_new(4096i64);
    let root: WAny = unsafe { WAny::ref_to(ir) };
    // ── mapping fusion (ADR 0016 M2b-2): `deem!(g: Services)` ────────────
    // The compiler prepended the mapping's rels to this program and encoded
    // `old=new@lo-hi;` per mapping param — rename each mapping's own source
    // param to the consumer's inside JUST that mapping's rels. Must run
    // BEFORE the gpath desugar, so `__reach_*` injection derives from the
    // new name. After this the spliced rels are indistinguishable from
    // hand-written ones: SCC, recursion and `**` all apply.
    if enrich.len() > 0i64 {
        let en: i64 = enrich.len();
        let mut i: i64 = 0i64;
        while i < en {
            let s0: i64 = i;                                       // old name
            while i < en && str_byte_at(enrich, i) != 61u8 { i = i + 1i64; }   // '='
            let old_name: str = unsafe { str_from_raw(((enrich.as_ptr() as i64) + s0) as *const u8, i - s0) };
            i = i + 1i64;
            let s1: i64 = i;                                       // new name
            while i < en && str_byte_at(enrich, i) != 64u8 { i = i + 1i64; }   // '@'
            let new_name: str = unsafe { str_from_raw(((enrich.as_ptr() as i64) + s1) as *const u8, i - s1) };
            i = i + 1i64;
            let mut lo: i64 = 0i64;                                // lo
            while i < en && str_byte_at(enrich, i) != 45u8 {       // '-'
                lo = lo * 10i64 + ((str_byte_at(enrich, i) as i64) - 48i64);
                i = i + 1i64;
            }
            i = i + 1i64;
            let mut hi: i64 = 0i64;                                // hi
            while i < en && str_byte_at(enrich, i) != 59u8 && str_byte_at(enrich, i) != 47u8 {  // ';'|'/'
                hi = hi * 10i64 + ((str_byte_at(enrich, i) as i64) - 48i64);
                i = i + 1i64;
            }
            // `/<pub-mask>/<mapping>` — a mapping consumed from another package
            // (#352): its non-`pub` rels are internals.
            if i < en && str_byte_at(enrich, i) == 47u8 {          // '/'
                i = i + 1i64;
                let m0: i64 = i;
                while i < en && str_byte_at(enrich, i) != 47u8 { i = i + 1i64; }
                let mask: str = unsafe { str_from_raw(((enrich.as_ptr() as i64) + m0) as *const u8, i - m0) };
                i = i + 1i64;
                let n0: i64 = i;
                while i < en && str_byte_at(enrich, i) != 59u8 { i = i + 1i64; }
                let mname: str = unsafe { str_from_raw(((enrich.as_ptr() as i64) + n0) as *const u8, i - n0) };
                let mut k: i64 = 0i64;
                while k < hi - lo {
                    prm.set_fused(lo + k, mname, k < mask.len() && str_byte_at(mask, k) == 48u8);   // '0'
                    k = k + 1i64;
                }
            }
            i = i + 1i64;
            rename_rel_sources(root, lo, hi, old_name, new_name, &h);
        }
    }
    // ADR 0016 M2a: graph paths desugar to classic join chains (the SHARED
    // plan→plan pass — one implementation for both binding times).
    let mut gperr: String = String::new();
    if !desugar_program_gpaths(root, &h, &mut gperr) {
        error(gp_err_str(&gperr));
        return out;
    }
    // ADR 0031 R0 — THE CORE: the program in one clause form, lowered ONCE
    // (entry and rel bodies alike) and verified; a broken invariant is an ICE.
    // Nothing reads it yet; `LOGOS_DEEM_DUMP=core` prints it.
    let core: CProgram = core_build(root, name);
    // ADR 0031 R2 — the user's names, checked on the core as written: before
    // the demand rewrite or the fact desugar invent a rel or a clause.
    if !core_rules_ok(&core) { return out; }
    if !core_scope_ok(&core, &prm) { return out; }
    // DEMAND (#349): the rel the entry reads with a bound column is evaluated
    // on demand (magic sets, `crewrite::core_magic`). Before the fact
    // desugar: a seed can be a fact. `LOGOS_DEEM_NO_DEMAND` (any value) turns
    // it off: the rewrite never changes an answer (MS_FALLIBLE keeps it so),
    // so the switch is for measuring it.
    // ORACLE: `LOGOS_DEEM_ORACLE=<dir>` writes the program as Soufflé text,
    // before any rewrite of ours (the oracle checks what the user wrote).
    dl_export(&core, name, natspec, &mut prm);
    let mut msd: MsDecisions = ms_decisions_new();
    let mut nd: String = String::new();
    nd.push_str("LOGOS_DEEM_NO_DEMAND");
    nd.push_u8(0u8);
    let demand_off: bool = unsafe { getenv(nd.as_ptr()) } != 0 as *const u8;
    // ADR 0031 R3 — the program the walker plans: lowered once the surface
    // rewrites that are still surface passes have run; from here on it is
    // analysed and rewritten on the core.
    let mut pc: CProgram = lower_program(root);
    if !demand_off && core_magic(&mut pc, &h, &prm, &mut msd) > 0i64 {
        let mut di: i64 = 0i64;
        while di < msd.n {
            plan_trace("demand", ms_verdict(msd.rule[di]), string_as_str(&msd.rel[di]), ms_render(msd.rule[di]));
            if plan_trace_facts_on() {
                let mut fl: String = String::new();
                fl.push_str("[facts] "); fl.push_str(string_as_str(&msd.rel[di])); fl.push_str(" demand col=");
                fl.push_str(string_as_str(&msd.col[di])); fl.push_str(" rule="); fl.push_str(ms_name(msd.rule[di]));
                fl.push_str("\n");
                plan_trace_raw(unsafe { str_from_raw(fl.as_ptr(), fl.len()) });
            }
            di = di + 1i64;
        }
    }
    // LIVE RELS: a rel no reader reaches from the entry is not evaluated
    // (`crewrite::core_live_rels`) — computed AFTER the demand rewrite, so an
    // original every reader of which now reads an adorned copy is dead too.
    // `LOGOS_DEEM_NO_PRUNE` (at compile time) evaluates every rel, to measure it.
    let mut fal: RelSet = relset_new(0i64);
    let mut live: RelSet = core_live_rels(&pc, &mut fal);
    let mut np: String = String::new();
    np.push_str("LOGOS_DEEM_NO_PRUNE");
    np.push_u8(0u8);
    let nrel0: i64 = pc.rels.len();
    let all: bool = unsafe { getenv(np.as_ptr()) } != 0 as *const u8;
    prm.rel_dead = relset_new(nrel0);
    let mut pd: i64 = 0i64;
    while pd < nrel0 {
        if all { live.add(pd); } else if !live.has(pd) { prm.rel_dead.add(pd); }
        pd = pd + 1i64;
    }
    let mut pi: i64 = 0i64;
    while pi < nrel0 {
        let rn: str = pc.rels.as_slice()[pi].name;
        let dead: bool = prm.rel_dead.has(pi);
        let kept: bool = fal.has(pi);
        if dead {
            plan_trace("live rels", "not evaluated", rn, "no reader reaches the entry: neither the entry nor a rel it reads (positively, under `anti join`, or in an aggregate) reads this rel, so its rows cannot reach the answer — its bodies are checked, and `_run` does not compute it (Soufflé's RemoveRedundantRelations)");
        } else if kept {
            plan_trace("live rels", "evaluated though unread", rn, "no reader reaches the entry, but a body evaluates checked arithmetic, a comprehension or an aggregate, which can return an `Err` the naive program returns; leaving it out could turn that `Err` into an `Ok`");
        }
        if (dead || kept) && plan_trace_facts_on() {
            let mut fl0: String = String::new();
            fl0.push_str("[facts] "); fl0.push_str(rn); fl0.push_str(" live rule=");
            if dead { fl0.push_str("dead"); } else { fl0.push_str("fallible_kept"); }
            fl0.push_str("\n");
            plan_trace_raw(unsafe { str_from_raw(fl0.as_ptr(), fl0.len()) });
        }
        pi = pi + 1i64;
    }
    // FACTS: a FROM-less `select` reads the one-row `__unit` relation, which
    // registers as one more native source.
    let mut nat: String = String::new();
    nat.push_str(natspec);
    if core_desugar_facts(&mut pc) { nat.push_str(UNIT_NATSPEC()); }
    let natspec2: str = unsafe { str_from_raw(nat.as_ptr(), nat.len()) };
    prm.plan_group_pure = plan_group_pure(&core.entry);
    let _ok: bool = walk_program_params(root, pc, name, params, natspec2, &mut prm, &h);
    return out;
}
