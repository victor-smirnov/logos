// logos.std.wql.el — EL (Expression Language) SHARED TYPES: the CEL operator ids
// (`OP_*`), the value-type lattice (`EL_TY_*` / `el_ty_of_name`), and the
// name→value-type dictionary (`ElTypes`) the wql!/trama! handlers build from
// schema reflection + the `deem!(…)`/`trama!(…)` parameter list.
//
// The hand-written recursive-descent EL PARSER that used to live here is RETIRED
// (ADR 0012 peg-frontend Phase 4). EL parsing is now done by the peg_gen_logos-
// GENERATED parser `logos.std.wql.el_parser::parse_expr`, which produces the same
// self-describing SExpr/RExpr IR (Option B: every leaf carries its textual NAME
// as a `str` schema field — `SField.name`, `SParam.name`, `SVar.name`,
// `SCall.fn_name`, `RScan.src_name`). Value-TYPES (str/bool/int) are supplied
// separately by `ElTypes`, keeping the parser purely syntactic. What remains here
// is consumed by `codegen.logos` (operator ids + type lattice) and by the handlers
// (`ElTypes`).
package logos.std.wql.el;

use logos.lang.str;
use logos.mem.string;   // String — wql_upper/wql_lower/wql_f64_to_str results
use logos.lang.option;  // Option — checked_* return type (el_add/…/el_neg)
use logos.lang.result;  // Result — the error-returning el_* arithmetic
use logos.lang.cmp;     // i64 checked_add/sub/mul/div/rem/neg

// ── Operator ids (CEL canon; stable across backends) ──────────────────────
// SBin op ids.
pub fn OP_OR()  -> i32 { return 1i32; }   // ||
pub fn OP_AND() -> i32 { return 2i32; }   // &&
pub fn OP_EQ()  -> i32 { return 3i32; }   // ==
pub fn OP_NE()  -> i32 { return 4i32; }   // !=
pub fn OP_LT()  -> i32 { return 5i32; }   // <
pub fn OP_LE()  -> i32 { return 6i32; }   // <=
pub fn OP_GT()  -> i32 { return 7i32; }   // >
pub fn OP_GE()  -> i32 { return 8i32; }   // >=
pub fn OP_ADD() -> i32 { return 9i32; }   // +
pub fn OP_SUB() -> i32 { return 10i32; }  // -
pub fn OP_MUL() -> i32 { return 11i32; }  // *
pub fn OP_DIV() -> i32 { return 12i32; }  // /
pub fn OP_MOD() -> i32 { return 13i32; }  // %
// SUn op ids.
pub fn OP_NOT() -> i32 { return 1i32; }   // !
pub fn OP_NEG() -> i32 { return 2i32; }   // unary -

// ── EL math-error type + error-returning integer arithmetic ────────────────
// EL scripts (deem!/trama!) are ERROR-RETURNING on a math fault: an integer
// overflow or a division/remainder by zero becomes a RETURNED error, never a
// host trap (compiled Logos traps on overflow by default; EL scripts do not).
// This is the STATIC mirror of the dynamic interpreter's `RtVal::Error` policy
// (logos.std.deem): both `div`/`rem` treat a zero divisor as `DivByZero` and a
// `checked_* == None` (i64::MIN / -1) as `Overflow`. ONE math-error type is
// shared by the static emitted fns AND the incremental engine's error channel.
pub enum ElError { Overflow, DivByZero }

// i64 checked arithmetic returning ElError. `checked_add/sub/mul/div/rem/neg`
// (Option<i64>) already exist in logos.lang.cmp.ord. The generated static
// resource/render fns call these with `?` so a fault propagates to the fn's
// `Result<_, ElError>` return.
pub fn el_add(a: i64, b: i64) -> Result<i64, ElError> {
    match a.checked_add(b) { Option::Some(v) => { return Result::Ok(v); } Option::None => { return Result::Err(ElError::Overflow); } }
}
pub fn el_sub(a: i64, b: i64) -> Result<i64, ElError> {
    match a.checked_sub(b) { Option::Some(v) => { return Result::Ok(v); } Option::None => { return Result::Err(ElError::Overflow); } }
}
pub fn el_mul(a: i64, b: i64) -> Result<i64, ElError> {
    match a.checked_mul(b) { Option::Some(v) => { return Result::Ok(v); } Option::None => { return Result::Err(ElError::Overflow); } }
}
pub fn el_div(a: i64, b: i64) -> Result<i64, ElError> {
    if b == 0i64 { return Result::Err(ElError::DivByZero); }
    match a.checked_div(b) { Option::Some(v) => { return Result::Ok(v); } Option::None => { return Result::Err(ElError::Overflow); } }
}
pub fn el_rem(a: i64, b: i64) -> Result<i64, ElError> {
    if b == 0i64 { return Result::Err(ElError::DivByZero); }
    match a.checked_rem(b) { Option::Some(v) => { return Result::Ok(v); } Option::None => { return Result::Err(ElError::Overflow); } }
}
pub fn el_neg(a: i64) -> Result<i64, ElError> {
    match a.checked_neg() { Option::Some(v) => { return Result::Ok(v); } Option::None => { return Result::Err(ElError::Overflow); } }
}

/// `el_add`'s SIBLING FOR A `u64` ACCUMULATOR — the same shape, the same error
/// value, the other overflow predicate.
///
/// ⚠ THIS IS WHAT REPLACES A CARRIED FLAG, AND THAT IS THE WHOLE POINT OF ITS
/// EXISTENCE. `el_wrap_add` above takes two `i64` PAYLOADS and reinterprets them,
/// because the accumulator it serves is an `i64` cell holding a `u64` value and
/// the only thing that knows better is a `bool` the checker stamped on the node
/// (`SBin.ordw`, `IncrJoin.agg_argu`). Here the CELL is a `u64`, so the predicate
/// is the host's `u64::checked_add` and nothing has to be told which one to use:
/// the emitter picks the function by the accumulator's TYPE (`agg_acc_ty`) and
/// there is no per-row flag on the path at all.
///
/// It is deliberately NOT a generic over a `CheckedAdd` trait: the two callers
/// are emitted text, the choice is made at compile time by name, and a trait
/// bound would put the same decision one level further from the emitter that
/// takes it.
pub fn el_addu(a: u64, b: u64) -> Result<u64, ElError> {
    match a.checked_add(b) { Option::Some(v) => { return Result::Ok(v); } Option::None => { return Result::Err(ElError::Overflow); } }
}

// ── THE SUBTRACTION SIBLINGS — a RETRACTION's half of the same discipline ──
//
// ⚠ THE OVERFLOW PREDICATE CORRECTED AT `752f89af` IS AN *ADD* PREDICATE, AND A
// RETRACTION SUBTRACTS. `el_addu` was the whole u64 family: `el_add`/`el_sub`/
// `el_mul` above are i64's complete set, and their u64 counterparts did not
// exist because nothing emitted ever took an unsigned value AWAY. A weighted
// delta does, and a u64 running total driven below zero is an UNDERFLOW — the
// exact mirror of the false-negative that `752f89af` fixed in the other
// direction, and it must ERR rather than wrap for the same reason: the i64
// reinterpretation of a u64 total is a different number, and a silent wrap
// hands a caller that different number as an answer.
//
// This is also what the DYNAMIC engine already does, so the two tiers agree by
// construction rather than by coincidence: `logos.mem.deem.incr`'s ag_run takes
// `el_wrap_sub(cur, prod)` for `w < 0` over an `agg_argu` column and latches
// `math_err` on `Option::None`. The static tier's convention is error-as-VALUE,
// so the same fact comes back as `Err(Overflow)` at the call that caused it.
pub fn el_subu(a: u64, b: u64) -> Result<u64, ElError> {
    match a.checked_sub(b) { Option::Some(v) => { return Result::Ok(v); } Option::None => { return Result::Err(ElError::Overflow); } }
}
pub fn el_mulu(a: u64, b: u64) -> Result<u64, ElError> {
    match a.checked_mul(b) { Option::Some(v) => { return Result::Ok(v); } Option::None => { return Result::Err(ElError::Overflow); } }
}

/// |w| AS A `u64`, TOTAL EXCEPT AT ONE VALUE — the magnitude of a Z-set weight,
/// for the u64 accumulator that must add or subtract that many copies of an
/// unsigned addend.
///
/// ⚠ IT RETURNS A `Result` BECAUSE `-i64::MIN` IS NOT AN `i64`, and answering
/// that with a wrap would put 2^63 copies of an addend into a total by way of a
/// weight nobody could have meant. `checked_neg` is the same guard the dynamic
/// engine takes at the same point (`incr.logos`, `w.checked_neg()` → latch), so
/// the two tiers refuse the same weight.
pub fn el_wmag(w: i64) -> Result<u64, ElError> {
    if w < 0i64 {
        match w.checked_neg() { Option::Some(m) => { return Result::Ok(m as u64); } Option::None => { return Result::Err(ElError::Overflow); } }
    }
    return Result::Ok(w as u64);
}

// ── Builtin function registry (CEL canon + common Trama filters) ──────────
// `SCall.fn_name` carries the call NAME directly (self-describing IR); the
// backends map it to one of these builtin ids. The id table is small + stable;
// unknown names diagnose in the caller. Lives HERE (not codegen) because it is
// shared by the STATIC emitters (logos.std.wql.codegen) and the DYNAMIC
// interpreter (logos.std.deem) — this package is metaprog-free, so the
// runtime side imports it without dragging compiler hooks into the link.
pub fn BFN_UNKNOWN()     -> i32 { return 0i32; }
pub fn BFN_LEN()         -> i32 { return 1i32; }
pub fn BFN_UPPER()       -> i32 { return 2i32; }
pub fn BFN_LOWER()       -> i32 { return 3i32; }
pub fn BFN_CONTAINS()    -> i32 { return 4i32; }
pub fn BFN_STARTS_WITH() -> i32 { return 5i32; }

// Resolve a call name → builtin id (BFN_*). Unknown ⇒ BFN_UNKNOWN.
pub fn builtin_of_name(name: str) -> i32 {
    if str_eq(name, "len")         { return BFN_LEN(); }
    if str_eq(name, "upper")       { return BFN_UPPER(); }
    if str_eq(name, "lower")       { return BFN_LOWER(); }
    if str_eq(name, "contains")    { return BFN_CONTAINS(); }
    if str_eq(name, "starts_with") { return BFN_STARTS_WITH(); }
    return BFN_UNKNOWN();
}

// The arity each builtin expects (used to validate the materialized arg list).
pub fn builtin_arity(bfn: i32) -> i64 {
    if bfn == BFN_LEN() || bfn == BFN_UPPER() || bfn == BFN_LOWER() { return 1i64; }
    if bfn == BFN_CONTAINS() || bfn == BFN_STARTS_WITH()           { return 2i64; }
    return 0i64;
}

// The EL value-type a builtin RETURNS (drives push_str vs push_i64 + result ty).
pub fn builtin_ret_ty(bfn: i32) -> i32 {
    if bfn == BFN_LEN()         { return EL_TY_INT(); }
    if bfn == BFN_UPPER()       { return EL_TY_STR(); }
    if bfn == BFN_LOWER()       { return EL_TY_STR(); }
    if bfn == BFN_CONTAINS()    { return EL_TY_BOOL(); }
    if bfn == BFN_STARTS_WITH() { return EL_TY_BOOL(); }
    return EL_TY_INT();
}

// ASCII upper/lowercase a `str` into a fresh `String` (the `upper`/`lower`
// builtins). Byte-wise, UTF-8-agnostic (ASCII-only case folding — the CEL
// string fns are byte oriented in the MVP). Returned by value (owns its buffer).
// RUNTIME helpers: the static backends emit qualified calls to these; the
// dynamic interpreter calls them directly.
pub fn wql_upper(s: str) -> String {
    let mut out: String = String::new();
    let n: i64 = s.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        let u: u8 = if c >= 97u8 && c <= 122u8 { c - 32u8 } else { c };
        out.push_u8(u);
        i = i + 1i64;
    }
    return out;
}
pub fn wql_lower(s: str) -> String {
    let mut out: String = String::new();
    let n: i64 = s.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        let l: u8 = if c >= 65u8 && c <= 90u8 { c + 32u8 } else { c };
        out.push_u8(l);
        i = i + 1i64;
    }
    return out;
}

// ── f64 formatting (shared by literal emission + the render value path) ─────
// Deterministic f64 → decimal text via the stdlib's `%g` bridge (`f64
// ::to_string`, `logos_fmt_f64_g` — shortest round-trippable form, Rust-Display
// convention). Runtime helper the generated render code calls (qualified) and
// the dynamic renderer calls directly.
pub fn wql_f64_to_str(x: f64) -> String {
    return x.to_string();
}

// ── EL value-type lattice (codegen type detection) ────────────────────────
// A coarse 4-valued type tag for static codegen: choose `push_str` vs
// `push_i64` vs the f64 fmt path, emit typed literals, and route the
// row/projection element type. Defaults to INT (the queue-1 numeric baseline);
// STR/BOOL/FLT are inferred from literals/operators or DECLARED via the
// surface (`x: str` params, typed fields). FLT is the f64 family (f64/f32 fields);
// INT promotes to FLT in mixed arithmetic (with an explicit `as f64` cast in
// the emitted source — Logos is Rust-like, no implicit int→float).
pub fn EL_TY_INT()  -> i32 { return 0i32; }
pub fn EL_TY_STR()  -> i32 { return 1i32; }
pub fn EL_TY_BOOL() -> i32 { return 2i32; }
pub fn EL_TY_FLT()  -> i32 { return 3i32; }

// Map a Logos type NAME (as written in the surface) to an EL value-type tag.
// `str`/`String` → STR, `bool` → BOOL, `f64`/`f32` → FLT, everything else →
// INT (the integer family is rendered identically by `push_i64`). Unknown
// names default to INT.
pub fn el_ty_of_name(name: str) -> i32 {
    // LENIENT policy over the same table: an unknown FIELD name is a nested
    // struct the EL never reads scalars from, so INT is the harmless default.
    // The strict policy (`el_ret_class`) reports instead — see there.
    let c: i32 = el_class_lookup(name);
    if c < 0i32 { return EL_TY_INT(); }
    return c;
}

// STRICT return-type classification for user-defined fns callable from the EL
// (UDF returns / UDA finalizer results). Unlike `el_ty_of_name` (which defaults
// unknown names to INT — right for FIELD types, whose unknowns are nested
// structs the EL never reads scalars from), a CALL's return value flows
// directly into the emitted expression, so an out-of-lattice return (a struct,
// a reference, unit) must be a clean diagnostic, not a silent i64. Returns the
// EL_TY_* tag, or -1 for an unsupported return type. The full integer family
// maps to INT (the i64 lattice baseline; narrower ints get an explicit
// `as i64` widening cast at the emit site).
//
// ⚠ THE CLASS SAYS NOTHING ABOUT THE WIDTH, and the widths that do NOT survive
// that cast used to be a sentence in this comment ("u64/u128/i128 truncate,
// documented MVP semantics") and nothing in the artifact. They are now
// `el_int_fits_i64` below, and a call whose result cannot survive the
// normalization is REFUSED at its use site rather than reinterpreted.
// The representative type NAME of a class — the answer when no declared name
// was recorded. NOT "the type name": a class has many types, and picking one
// is exactly how column widths were lost before `infer_ty_name` existed.
// THE definition: `el` sits below `codegen`, and a second copy up there is
// what this replaced.
pub fn el_class_repr(ty: i32) -> str {
    if ty == EL_TY_STR()  { return "str"; }
    if ty == EL_TY_BOOL() { return "bool"; }
    if ty == EL_TY_FLT()  { return "f64"; }
    return "i64";
}

// ══ THE VALUE TYPE IS A RECORD, NOT A TAG (ADR 0024 S6, stage 1) ══════════
//
// The query compiler's value domain used to BE the four-class tag: a column, a
// key and an expression each carried an `EL_TY_*`, and every fact anyone needed
// about the type had to be recovered from a four-valued number. It cannot be:
// `u64` and `i64` are one class and their orders differ above 2^63, `u128` and
// `i64` are one class and their identities differ. What followed is on record —
// the reorder licence had to be keyed on the type's SPELLING (a side table of
// names beside a domain that could not carry the fact), `el_int_fits_i64` was a
// second list of names, `plan_walker::rel_col_ty_ok` a third, `Query::compile`'s
// rel validation a fourth, and `emit_udf_call`'s widening cast a fifth. Five
// tables answering questions about ONE type, each free to drift from the others.
//
// `ElTy` is that type, resolved: ONE row per admitted Logos type, and every fact
// DERIVED FROM THE TYPE'S OWN PROPERTIES rather than listed per fact.
//
// ⚠ WHAT IS STORED AND WHAT IS DERIVED, and why the split falls there. Stored:
// the CLASS, the WIDTH IN BITS, the SIGNEDNESS, and the type's OWN ORDER AND
// IDENTITY (`self_ord` / `self_ident`) — five independent properties, none
// recoverable from the others. The last two are stored because they are claims
// about THE INSTRUCTIONS THE BACKEND SELECTS, and no property of a type entails
// those: `usize` is an unsigned 64-bit integer whose `<` lowered to `slt` for the
// whole life of this table. Derived: everything that is a consequence of the EL's
// normalization COMPOSED WITH THE REPR'S OWN STORED COMPARISON, because those are
// theorems about a two's-complement conversion, not opinions:
//
//   repr   the type the emitted EL expression actually computes in — the class's
//          representative (`el_class_repr`). A `u32` column is READ as u32 and
//          COMPUTED as i64;
//   canon  the type IS its own repr (no normalization happens at all). This is
//          the fact four separate spelling whitelists were standing in for;
//   fits   every value survives the conversion to `repr` — signed ⇒ bits ≤ 64,
//          unsigned ⇒ bits ≤ 63. `u64` fails, `u32` passes, `u56` passes, and a
//          `u48` added tomorrow passes without anyone editing a second list;
//   ident  whether `==` plus a hash agree with the source type's equality, and
//          WHEN NOT, WHICH WAY IT FAILS — an `EL_ID_*` code, not a bool, for the
//          same reason `ord` is one: "no identity" is two distinguishable states
//          with two different remedies, and a bool makes a caller compose the
//          difference back out of prose. `EL_ID_OK` for every integer of ≤ 64
//          bits (u64 → i64 is a BIJECTION: reinterpretation moves the order and
//          leaves equality alone), `EL_ID_NO_INJ` for i128/u128 (bits are
//          dropped, so two different values arrive equal), `EL_ID_NO_EQ` for
//          f64/f32 (NaN != NaN — equality is not even reflexive);
//   ord    how faithfully a comparison realizes the type's own order AFTER the
//          value has been normalized into `repr` — the `EL_ORD_*` codes below;
//   self_ord / self_ident
//          the same two questions asked of a comparison IN THE TYPE ITSELF, with
//          no normalization in between. THE TWO STORED ROWS, and the two a gate
//          keeps honest: `tests/logos/pass/wql_el_cmp_measured.logos` RUNS `<`,
//          `>`, `==` and the `Hash`/`Eq` instances on values of every type this
//          table names, at the extremes that separate a right lowering from a
//          wrong one (above the signed ceiling for the unsigned types, the
//          minimum for the signed ones, a NaN for the floats, the empty string
//          and multi-byte content for `str`), and refuses any row whose stored
//          answer differs from what the language did.
//
// ⚠ `ord` AND `self_ord` ARE TWO FIELDS BECAUSE THEY ARE TWO STATES, and this is
// the whole of what stage 2 fixes. One field answered both, so "does the emitted
// comparison realize this type's order" had exactly one answer per type — and it
// was the answer for ONE emission strategy, the one that normalized every key
// into the class's representative. A `u64` key was refused not because u64 has a
// defective order but because THAT vector held i64. The strategy is a property of
// the emitter, not of the type, so it cannot live in a per-type field that
// callers read as if it were about the type. `self_ord` is the type's own answer;
// `ord` is the answer under normalization; `el_cmp_fidelity(named, emitted)`
// composes the two and names WHICH antecedent failed.
//
// ⚠ THE WIDTH OF `usize`/`isize` IS THE HOST'S. 64 here is the LP64 assumption
// every Logos target makes today; it is a stored number precisely so that a
// target where it is false changes one row and not five predicates.
//
// ⚠ `bits` = 0 means WIDTH IS NOT A PROPERTY of this type (`str`, `String`), not
// "zero bits". No derivation reads `bits` for a non-numeric class.
pub struct ElTy {
    pub name:   str,    // the resolved Logos spelling — this type's identity
    pub cls:    i32,    // EL_TY_* — the coarse VIEW, -1 = outside the lattice
    pub bits:   i64,    // width of the SOURCE type (0 = not a width-bearing type)
    pub signed: bool,
    pub repr:   str,    // the type the emitted EL expression computes in
    pub canon:  bool,   // name == repr: the EL computes in this type itself
    pub fits:   bool,   // every value survives the conversion to `repr`
    pub ident:  i32,    // EL_ID_*  — identity under that conversion
    pub ord:    i32,    // EL_ORD_* — order fidelity AFTER normalization into repr
    pub self_ord:   i32, // EL_ORD_* — order fidelity of `<` on the type ITSELF
    pub self_ident: i32, // EL_ID_*  — identity of `==` on the type ITSELF
}

// ── IDENTITY: does `==` plus a hash agree with the source type's equality? ─
// Ranking and identity are different properties with different failures, and
// each failure has its own remedy — so each is its own code.
pub fn EL_ID_OK()      -> i32 { return 0i32; }  // the conversion is injective
pub fn EL_ID_NO_EQ()   -> i32 { return 1i32; }  // equality is not reflexive (NaN)
pub fn EL_ID_NO_INJ()  -> i32 { return 2i32; }  // the conversion DROPS bits
pub fn EL_ID_UNNAMED() -> i32 { return 3i32; }  // outside the lattice — deny

/// The bool VIEW of the identity code, for the consumers that only branch.
pub fn el_ty_has_ident(t: ElTy) -> bool { return t.ident == EL_ID_OK(); }

/// THE lattice table: the resolved value type of a Logos type NAME. A name
/// outside the lattice comes back with `cls = -1` and every fact denied — the
/// DEFAULT-DENY that keeps a type added later from inheriting a licence resting
/// on a comparison nobody has checked.
///
/// ⚠ `el` sits BELOW the reflection boundary and holds no module view: `name`
/// must already BE a type, not an alias for one. Alias resolution happens at the
/// READ sites (`reflect::resolve_alias_name`).
pub fn el_ty(name: str) -> ElTy { return el_ty_complete(el_ty_stored_of(name)); }

/// The type admitted at index `i`, complete. The enumeration `el_ty` scans.
pub fn el_ty_at(i: i64) -> ElTy { return el_ty_complete(el_ty_stored(i)); }

/// HOW MANY TYPES THE LATTICE ADMITS. Not a second list — `el_ty_stored` returns
/// the denied row past the end, and the fixture pins `arity` against that boundary
/// (`el_ty_at(arity - 1)` is admitted, `el_ty_at(arity)` is not), so this number
/// cannot drift from the cases below without a gate failing.
pub fn el_ty_arity() -> i64 { return 21i64; }

/// The STORED row of a NAME — THE one place a name is admitted, by scan over the
/// enumeration. Nothing here derives anything, which is what keeps completion
/// (whose composition reads the REPRESENTATIVE's stored row) from recurring.
fn el_ty_stored_of(name: str) -> ElTy {
    let n: i64 = el_ty_arity();
    let mut i: i64 = 0i64;
    while i < n {
        let s: ElTy = el_ty_stored(i);
        if str_eq(s.name, name) { return s; }
        i = i + 1i64;
    }
    return el_ty_denied(name);
}

/// THE LATTICE, ENUMERATED — and it is enumerated rather than looked up because
/// the per-type comparison facts below are PINNED BY A TEST THAT RUNS THE
/// COMPARISON IN THE LANGUAGE (`tests/logos/pass/wql_el_cmp_measured.logos`), and
/// a table a test cannot walk is a table whose new row arrives unmeasured. The
/// name lookup is a scan over this, so there is exactly one place a type is
/// admitted.
///
/// ⚠ THE LAST TWO ARGUMENTS ARE STORED, NOT DERIVED, AND THAT IS THE WHOLE POINT.
/// `self_ord` / `self_ident` are claims about the code THE BACKEND EMITS for this
/// type's own `<` and `==`. They used to be computed from the four-value class tag
/// (`cls == EL_TY_FLT()` ? PARTIAL : OK), which is a claim about the LANGUAGE
/// inferred from how this compiler happens to bucket types — and the inference was
/// FALSE while `usize` lowered `<` to `slt` (fixed in `0684b185`; the inference was
/// unfounded before the defect and stayed unfounded after it). A fact about the
/// emitted comparison is stored where the type is admitted and MEASURED by a gate
/// that compares two values of that type at the extremes. If the lowering changes,
/// the gate fails. That is what a class tag could never do.
fn el_ty_stored(i: i64) -> ElTy {
    // Integer family — (bits, signed) is the whole of what distinguishes them,
    // and every one of them has a total `<` and an exact `==` in the language.
    if i == 0i64  { return el_ty_raw("i8",    EL_TY_INT(), 8i64,   true,  EL_ORD_OK(), EL_ID_OK()); }
    if i == 1i64  { return el_ty_raw("i16",   EL_TY_INT(), 16i64,  true,  EL_ORD_OK(), EL_ID_OK()); }
    if i == 2i64  { return el_ty_raw("i32",   EL_TY_INT(), 32i64,  true,  EL_ORD_OK(), EL_ID_OK()); }
    if i == 3i64  { return el_ty_raw("i64",   EL_TY_INT(), 64i64,  true,  EL_ORD_OK(), EL_ID_OK()); }
    if i == 4i64  { return el_ty_raw("i128",  EL_TY_INT(), 128i64, true,  EL_ORD_OK(), EL_ID_OK()); }
    if i == 5i64  { return el_ty_raw("u8",    EL_TY_INT(), 8i64,   false, EL_ORD_OK(), EL_ID_OK()); }
    if i == 6i64  { return el_ty_raw("u16",   EL_TY_INT(), 16i64,  false, EL_ORD_OK(), EL_ID_OK()); }
    if i == 7i64  { return el_ty_raw("u32",   EL_TY_INT(), 32i64,  false, EL_ORD_OK(), EL_ID_OK()); }
    if i == 8i64  { return el_ty_raw("u64",   EL_TY_INT(), 64i64,  false, EL_ORD_OK(), EL_ID_OK()); }
    if i == 9i64  { return el_ty_raw("u128",  EL_TY_INT(), 128i64, false, EL_ORD_OK(), EL_ID_OK()); }
    if i == 10i64 { return el_ty_raw("isize", EL_TY_INT(), 64i64,  true,  EL_ORD_OK(), EL_ID_OK()); }
    if i == 11i64 { return el_ty_raw("usize", EL_TY_INT(), 64i64,  false, EL_ORD_OK(), EL_ID_OK()); }
    // Writ's packed widths. u56's maximum is 2^56-1, well inside i64 — and that
    // is now DERIVED from the 56 rather than asserted in a list of names.
    if i == 12i64 { return el_ty_raw("i56",   EL_TY_INT(), 56i64,  true,  EL_ORD_OK(), EL_ID_OK()); }
    if i == 13i64 { return el_ty_raw("u56",   EL_TY_INT(), 56i64,  false, EL_ORD_OK(), EL_ID_OK()); }
    // 24-bit, the other pair of packed widths. They were MISSING from the
    // lattice while 56 was present, so an `i24` column fell to the lenient
    // default (the i64 baseline) and `select s.k` over one emitted `Vec<i64>`
    // against a caller's `Vec<i24>` — a type mismatch on the LET, for a column
    // the language has and the lattice simply did not list.
    if i == 19i64 { return el_ty_raw("i24",   EL_TY_INT(), 24i64,  true,  EL_ORD_OK(), EL_ID_OK()); }
    if i == 20i64 { return el_ty_raw("u24",   EL_TY_INT(), 24i64,  false, EL_ORD_OK(), EL_ID_OK()); }
    // The float class: a NaN compares false against every value INCLUDING ITSELF,
    // so the order is partial and the equality is not reflexive. Measured, not
    // assumed — the fixture builds a NaN and asks.
    if i == 14i64 { return el_ty_raw("f32",   EL_TY_FLT(), 32i64,  true,  EL_ORD_PARTIAL(), EL_ID_NO_EQ()); }
    if i == 15i64 { return el_ty_raw("f64",   EL_TY_FLT(), 64i64,  true,  EL_ORD_PARTIAL(), EL_ID_NO_EQ()); }
    if i == 16i64 { return el_ty_raw("bool",  EL_TY_BOOL(), 1i64,  false, EL_ORD_OK(), EL_ID_OK()); }
    // `str` relationals are lowered to `str_cmp` — byte-lexicographic, total.
    if i == 17i64 { return el_ty_raw("str",   EL_TY_STR(), 0i64,   false, EL_ORD_OK(), EL_ID_OK()); }
    // `String` is in the lattice and is NOT its own repr: an owned String is
    // compared and stored through its `str` view. That single fact is what four
    // whitelists spelled out by excluding the name.
    //
    // ⚠ AND ITS OWN `<` DOES NOT EXIST. The class-derived rule said OK here — a
    // claim that the backend emits a faithful `String` comparison — and the
    // backend emits none at all (`String__lt` is unresolved at mlir_gen). It is
    // unreachable today only because `el_vec_key_ok` denies `String` a key vector
    // one antecedent earlier; the row still asserted something false, in the
    // dangerous direction. `==` IS emitted and IS exact, so identity stays OK:
    // this is exactly why order and identity are two fields.
    if i == 18i64 { return el_ty_raw("String", EL_TY_STR(), 0i64,  false, EL_ORD_NO_CMP(), EL_ID_OK()); }
    return el_ty_denied("");
}

/// The row for a name the lattice does not admit: every fact DENIED. The
/// default-deny that keeps a type added later from inheriting a licence resting
/// on a comparison nobody has checked.
fn el_ty_denied(name: str) -> ElTy {
    return ElTy { name: name, cls: -1i32, bits: 0i64, signed: false, repr: "",
                  canon: false, fits: false, ident: EL_ID_UNNAMED(),
                  ord: EL_ORD_UNNAMED(), self_ord: EL_ORD_UNNAMED(),
                  self_ident: EL_ID_UNNAMED() };
}

/// A STORED row: the five properties nothing derives, and nothing else. The
/// derived fields are left DENIED so that a row read before completion cannot be
/// mistaken for an answer.
fn el_ty_raw(name: str, cls: i32, bits: i64, signed: bool,
             self_ord: i32, self_ident: i32) -> ElTy {
    return ElTy { name: name, cls: cls, bits: bits, signed: signed,
                  repr: "", canon: false, fits: false, ident: EL_ID_UNNAMED(),
                  ord: EL_ORD_UNNAMED(), self_ord: self_ord, self_ident: self_ident };
}

/// Complete a lattice row: the five stored properties in, the derived facts out.
/// THE place the consequences of the EL's normalization are written down.
///
/// ⚠ WHAT MAY BE DERIVED HERE AND WHAT MAY NOT. Derived: `fits`, `ident`, `ord`,
/// `canon`, `repr` — theorems about a two's-complement `as` conversion, GIVEN the
/// comparison at each end. Stored: `self_ord` / `self_ident` — facts about the
/// instructions the backend selects, which no property of the type entails.
fn el_ty_complete(s: ElTy) -> ElTy {
    if s.cls < 0i32 { return s; }
    let repr: str = el_class_repr(s.cls);
    // Every value survives the conversion to `repr`. For the integer family that
    // is the i64 range: a signed type of ≤ 64 bits fits exactly, an unsigned one
    // needs its top bit free. f32 → f64 is exact; str/bool are not converted.
    let fits: bool = if s.cls == EL_TY_INT() {
        if s.signed { s.bits <= 64i64 } else { s.bits <= 63i64 }
    } else { true };
    // ⚠ THE COMPARISON AFTER THE CONVERSION IS THE REPR'S, AND IT IS READ OFF THE
    // REPR'S ROW. `ord`/`ident` used to end at `cls == EL_TY_FLT() → PARTIAL`,
    // which is the same inference one level down: "the emitted comparison is
    // partial" derived from a class tag. The composition is (the value survives
    // the conversion) ∘ (the comparison in `repr` realizes `repr`'s order), and
    // the second half is `repr`'s own STORED fact. It is read from the STORED row
    // — completing it would recur, and it has nothing this needs.
    let canon: bool = str_eq(s.name, repr);
    let mut r_ord: i32   = s.self_ord;
    let mut r_ident: i32 = s.self_ident;
    if !canon {
        let rr: ElTy = el_ty_stored_of(repr);
        r_ord   = rr.self_ord;
        r_ident = rr.self_ident;
    }
    // Is the conversion injective? u64 → i64 is a BIJECTION, so identity holds
    // where order does not; i128/u128 drop bits, so it fails; f64/f32 have no
    // reflexive equality to preserve in the first place — and that last fact is
    // the SOURCE type's own, so it is read off the stored `self_ident` rather
    // than re-derived from the class.
    let ident: i32 = if s.self_ident != EL_ID_OK() { s.self_ident }
                     else if s.cls == EL_TY_INT() && s.bits > 64i64 { EL_ID_NO_INJ() }
                     else { r_ident };
    return ElTy {
        name: s.name, cls: s.cls, bits: s.bits, signed: s.signed,
        repr: repr, canon: canon, fits: fits, ident: ident,
        ord: el_ord_of(s.cls, s.bits, fits, r_ord),
        self_ord: s.self_ord, self_ident: s.self_ident,
    };
}

/// The order-fidelity consequence: what the CONVERSION into `repr` does to the
/// value, composed with what `repr`'s OWN comparison does (`r_ord`, the stored
/// fact off the representative's row — never re-derived from the class here).
fn el_ord_of(cls: i32, bits: i64, fits: bool, r_ord: i32) -> i32 {
    if cls == EL_TY_INT() && !fits {
        if bits <= 64i64 { return EL_ORD_WRAP(); }     // u64/usize: reinterpreted
        return EL_ORD_TRUNC();                         // i128/u128: bits dropped
    }
    // The value arrived intact, so the only question left is `repr`'s own order:
    // `i64`/`bool`/`str` are faithful, `f64` is partial, and each says so itself.
    return r_ord;
}

/// The scalar-lattice class of a type NAME, or -1 when the name is outside the
/// lattice. The coarse VIEW of `el_ty` — kept because a join strategy and a
/// literal-emission route genuinely want a four-way answer, but no longer the
/// place any fact LIVES.
pub fn el_class_lookup(name: str) -> i32 { return el_ty(name).cls; }

/// STRICT classification: an out-of-lattice name is reported, not guessed.
pub fn el_ret_class(name: str) -> i32 { return el_class_lookup(name); }

// ── THE NUMERIC NORMALIZATION, in one place ───────────────────────────────
/// The cast the emitter must wrap a value of type `name` in so it lands in the
/// EL's computation type — `""` when none is needed. THE rule behind two
/// separately-written pairs of spelling tests (`codegen::emit_udf_call`'s
/// `INT && != "i64"` / `FLT && == "f32"`, and `rexpr_walk::uda_fin_cast`'s copy
/// of the same): a value is normalized exactly when its type is NOT its own
/// repr, and only for the numeric classes — `String` is also non-canon and is
/// converted by borrowing, not by casting.
pub fn el_norm_cast(name: str) -> str {
    let t: ElTy = el_ty(name);
    if t.cls != EL_TY_INT() && t.cls != EL_TY_FLT() { return ""; }
    if t.canon { return ""; }
    return t.repr;
}

/// Does the HOST LANGUAGE carry a value of type `name` into a position that
/// expects `want` with NO written conversion? The antecedent of an emit position
/// that prints a sub-expression VERBATIM into a typed slot.
///
/// ⚠ THIS IS A CLAIM ABOUT THE HOST COMPILER, NOT ABOUT THE VALUE, and that is
/// the whole reason it is a separate function. `ElTy.fits` answers "does every
/// value survive the conversion into `repr`" — a fact about arithmetic, and it
/// says YES for `isize` and for `f32`. Neither of those is carried: the host
/// widens an integer only from a NARROWER width, and it widens no float at all.
///
/// ⚠⚠ IT IS NO LONGER THE AGGREGATE ARGUMENT'S ANTECEDENT, AND THE MOVE IS THE
/// POINT. The two questions were conflated at exactly that seam, which asked
/// THIS one and then printed the argument verbatim — so `isize`, a signed 64-bit
/// type every one of whose values reaches `i64` unmoved, was refused because the
/// HOST would not widen it, at a position that could simply have written the
/// cast. `check_agg_operand` now asks `el_agg_arg_reaches` and
/// `compute_agg_bodies` writes `el_norm_cast`'s conversion through
/// `emit_norm_operand`, so no admitted aggregate argument rides an implicit
/// coercion any more.
///
/// ⚠ WHAT STILL PRINTS VERBATIM INTO A TYPED SLOT — the seam this predicate is
/// kept FOR — is a UDA's argument, which `compute_agg_bodies` prints into the
/// user's `<name>_step` without consulting the declared parameter type at all.
/// That seam is OPEN and its bad diagnostic is pinned by
/// `tests/logos/fail/wql_agg_uda_f32_arg_fail`; closing it needs a reflected
/// `fn_param_type_name`, and this is the question it will have to ask.
///
/// ⚠ UNTIL THEN THIS FUNCTION HAS NO CALLER, AND THAT IS RECORDED RATHER THAN
/// HIDDEN. It is kept because the fact is true and this is the only place in the
/// tree it is written down; it is NOT kept for ABI reasons — `stdlib/mem/wql` is
/// metaprogram code and appears nowhere in `abi/logos.abi` (measured: 0 hits for
/// either predicate, and `scripts/abi-check.sh` reports ADDED 0 across this
/// change). And with no caller it carries NO GATE: `wql_agg_arg_seam_e2e` used
/// to be its measurement and now measures `el_agg_arg_reaches` instead. Do not
/// read this as a measured claim until something asks it again.
pub fn el_host_carries(name: str, want: str) -> bool {
    if str_eq(name, want) { return true; }
    let t: ElTy = el_ty(name);
    if t.cls != EL_TY_INT() { return false; }        // no float is widened
    if !str_eq(want, "i64") { return false; }
    // Value-preserving INTEGER widening, and the width is the whole of it:
    // i8..i32 / u8..u32 / i24 / u24 / i56 / u56 reach i64, while `isize`,
    // `usize` and `u64` are 64-bit types with nothing to widen and `i128` /
    // `u128` are wider than the destination.
    return t.bits < 64i64;
}

/// MAY AN AGGREGATE ARGUMENT OF TYPE `name` REACH AN ACCUMULATOR OF TYPE `want`?
/// The question every OTHER EL operand position asks — arithmetic operands
/// (`check_arith_operand` + `emit_norm_operand`), UDF results (`check_calls` +
/// `emit_udf_call`), sort keys (`key_norm_ok` + `key_norm_body`) and UDA
/// finalizers (`uda_fin_cast`) each admit what SURVIVES the normalization and
/// WRITE the cast that performs it. The aggregate argument was the one position
/// that did neither half; it now does both, and this is its half of the rule.
///
/// ⚠ IT IS ASKED ABOUT `want`, THE ACCUMULATOR IT IS ACTUALLY BEING GIVEN, and
/// that is the whole of the 2026-08-06 change. It used to be defined through
/// `el_norm_cast(name)` — the cast into the CLASS REPRESENTATIVE — which was the
/// right question only while every integer accumulator WAS the representative.
/// It is not: `agg_acc_ty` gives an `EL_ORD_WRAP` column a `u64` accumulator, and
/// asking whether the argument survives `as i64` decided nothing about a cell
/// that is not an i64. `emit_norm_operand` writes `as <want>` and never consulted
/// `el_norm_cast` at all, so asking about `want` is also the CLOSER of the two
/// readings of "the rule and the emitter read one function".
///
/// ⚠ AND NOTHING WAS RELAXED AT THE ACCUMULATOR THAT DID NOT MOVE. For
/// `want = "i64"`, `el_int_widens` is `ElTy.fits` restated at the destination and
/// admits exactly the same set: i8..i32 / u8..u32 / i24 / u24 / i56 / u56 /
/// isize / i64, and NOT `u64`, `usize` (REINTERPRET), `u128` or `i128`
/// (TRUNCATE). The i64-accumulator refusals — `wql_arith_wide_int_fail`,
/// `wql_udf_wide_int_ret_fail`, `wql_agg_nonnumeric_arg_fail` — are untouched.
/// What is newly admitted is `usize` INTO A `u64` ACCUMULATOR, which is the same
/// row of the rule as `u64` itself (same width, same order, same overflow
/// predicate) and whose cast `as u64` moves neither a bit nor a value.
///
/// ⚠ THE FLOAT SIDE IS WITHHELD ON PURPOSE, AND IT IS NOT AN OVERSIGHT.
/// `el_norm_cast("f32")` is `f64` and the conversion is exact, so this seam
/// COULD write it. What it may not do is decide, as a side effect of a type
/// check, that a float aggregate accumulates in a width other than its
/// argument's: that changes what a long `sum` answers and the caller cannot undo
/// it. So a float argument is admitted only when it already IS the accumulator's
/// type, and `tests/logos/fail/wql_agg_f32_arg_fail` keeps that refusal visible
/// with a diagnostic that names the remedy (`sum(s.x * 1.0f64)` — the widening
/// requested by the query, at the arithmetic seam, where it is the query's).
pub fn el_agg_arg_reaches(name: str, want: str) -> bool {
    if str_eq(name, want) { return true; }
    let t: ElTy = el_ty(name);
    if t.cls != EL_TY_INT() { return false; }
    return el_int_widens(name, want);
}

/// DOES EVERY VALUE OF INTEGER TYPE `name` SURVIVE THE HOST CONVERSION
/// `as want`? `ElTy.fits` generalized from the class REPRESENTATIVE to an
/// arbitrary integer destination — and it is the same theorem, because `fits` IS
/// this predicate with `want` pinned to `repr`:
///
///   destination SIGNED, W bits   — a signed source needs `bits ≤ W`
///                                  (the range nests), an unsigned one needs
///                                  `bits < W` (its top bit must stay free, which
///                                  is `fits`' `bits ≤ 63` for `repr = i64`);
///   destination UNSIGNED, W bits — a signed source NEVER survives (negatives
///                                  have no image at all), an unsigned one needs
///                                  `bits ≤ W`.
///
/// ⚠ IT IS A CLAIM ABOUT THE VALUE, NOT ABOUT THE ORDER OR THE PREDICATE, and
/// keeping those apart is why `agg_acc_ty` is a separate function. `u64 as u64`
/// preserves the value trivially; what makes a `u64` accumulator RIGHT is that
/// its `<` and its `checked_add` are also u64's, and that is `agg_acc_ty`'s
/// answer and `agg_acc_least`/`el_addu`'s job. This predicate only says the
/// argument arrives intact.
///
/// ⚠ NOT ASKED OF A FLOAT. Both classes are checked so the answer is total, but
/// `el_agg_arg_reaches` refuses a float above this call for a reason that is
/// neither the value's nor the position's — see its header.
pub fn el_int_widens(name: str, want: str) -> bool {
    let s: ElTy = el_ty(name);
    let d: ElTy = el_ty(want);
    if s.cls != EL_TY_INT() || d.cls != EL_TY_INT() { return false; }
    if d.signed {
        if s.signed { return s.bits <= d.bits; }
        return s.bits < d.bits;
    }
    if s.signed { return false; }
    return s.bits <= d.bits;
}

// ── MAY THIS TYPE BE A COLUMN OF A SET-VALUED RELATION? ───────────────────
// A `rel` is a SET: rows are deduplicated, so a column type needs an identity;
// and the row is stored as a NATIVE tuple of the DECLARED types while the EL
// computes in `repr`, so a column whose type is not its own repr would have the
// emitted body mixing the two. Both tiers ask this — the static `wql!` handler
// (`plan_walker::rel_col_ty_ok`) and the dynamic `Query::compile` — and each
// used to carry its own copy of the answer as the spelling list i64/str/bool.
// ONE predicate, and the code it returns NAMES THE FAILED ANTECEDENT so the
// caller reports a remedy rather than a verdict.
pub fn EL_COL_OK()       -> i32 { return 0i32; }
pub fn EL_COL_UNKNOWN()  -> i32 { return 1i32; }   // outside the lattice
pub fn EL_COL_NO_EQ()    -> i32 { return 2i32; }   // equality is not reflexive
pub fn EL_COL_NO_INJ()   -> i32 { return 3i32; }   // two values arrive equal
pub fn EL_COL_NOT_REPR() -> i32 { return 4i32; }   // the EL computes in another type

pub fn el_set_col_admit(name: str) -> i32 {
    let t: ElTy = el_ty(name);
    if t.cls < 0i32                { return EL_COL_UNKNOWN(); }
    if t.ident == EL_ID_NO_EQ()    { return EL_COL_NO_EQ(); }
    if t.ident == EL_ID_NO_INJ()   { return EL_COL_NO_INJ(); }
    if t.ident != EL_ID_OK()       { return EL_COL_UNKNOWN(); }
    if !t.canon                    { return EL_COL_NOT_REPR(); }
    return EL_COL_OK();
}

/// The GROUND for a refused set column — the failed antecedent in its own
/// vocabulary, with the remedy. Empty for an admitted type.
///
/// ⚠ ONE ANTECEDENT PER GROUND. An earlier draft of this text named both ways an
/// identity can fail and left the reader to work out which one applied — which is
/// prose composed at report time wearing a record's clothes.
pub fn el_set_col_why(name: str) -> str {
    let a: i32 = el_set_col_admit(name);
    if a == EL_COL_UNKNOWN() {
        return "this type is outside the EL scalar lattice (`el_ty`), so nothing is known about the comparison, the hash or the storage the backend would emit for it — and a type is not assumed to have an identity until it is admitted there. The remedy is a column of an admitted scalar type — `i64`, `str` or `bool`";
    }
    if a == EL_COL_NO_EQ() {
        return "a rel is a SET — rows are deduplicated by `==` and a hash — and this type's equality is not even REFLEXIVE: an f64/f32 NaN compares false against every value including itself, so a row containing one is equal to nothing, not even to a copy of itself. The remedy is a column whose equality is meaningful — `i64`, `str` or `bool`";
    }
    if a == EL_COL_NO_INJ() {
        return "a rel is a SET — rows are deduplicated by `==` and a hash — and the EL's normalization of this type is NOT INJECTIVE: a value wider than 64 bits arrives with its high bits dropped, so two different rows collapse into one. The remedy is a column that fits the i64 the EL computes in";
    }
    if a == EL_COL_NOT_REPR() {
        return "the rel row STORES this type and the EL COMPUTES in another one, so the emitted body would mix the two: the normalization is not the identity here. The remedy is to declare the column as the type the EL computes in — `i64` for the integer family, `str` for `String`";
    }
    return "";
}

// ── DOES THE EMITTED COMPARISON REALIZE THE ORDER THE QUERY NAMED? ────────
// THE answer, in one place, keyed on the TYPE NAME, to a question two consumers
// ask and one of them used to ask of the four-value CLASS TAG — which cannot
// carry it.
//
// ⚠ THE AXIS THIS REPLACED WAS NAMED WRONG, and that is the whole substance of
// the table. It asked "is this class TOTALLY ORDERED", admitted the integer
// family on the ground "two's complement", and was right about u64: the emitted
// comparison for a u64 key IS total. It is simply not the order the query asked
// for. `order by` names an order over a LOGOS TYPE; what the backends emit is a
// key vector of the class's representative (`el_class_repr` — i64 / str / bool /
// f64) compared with the language's `<` / `>`. Those are the same order only
// while the key reaches that vector INTACT, and the class tag cannot tell:
// `u64` and `i64` are ONE class and their orders differ above 2^63. MEASURED:
// `order by ukey(a.v)` with `fn ukey(i64) -> u64` over values 1, 2^64-1, 5,
// 2^63 emitted `__ks.push(((ukey(a.v)) as i64))` and ranked them 2^63, 2^64-1,
// 1, 5 — total, nest-independent, and not the query's order.
//
// So totality is ONE of the conditions, not the question. This table names which
// condition each type fails:
//
//   EL_ORD_OK       the key reaches the comparison intact and `<`/`>` on the
//                   emitted type IS this type's own order;
//   EL_ORD_PARTIAL  it reaches the comparison intact and the comparison is
//                   PARTIAL — f64/f32, where a NaN compares false against every
//                   value including itself;
//   EL_ORD_WRAP     the EL's `as i64` normalization REINTERPRETS the value:
//                   u64/usize at or above 2^63 arrive negative, so the order
//                   inverts across that boundary. Total, and not this order;
//   EL_ORD_TRUNC    the normalization DROPS BITS (u128/i128 outside the i64
//                   range): the emitted key is not even injective, so two
//                   different values can arrive equal;
//   EL_ORD_UNNAMED  outside the lattice — nothing is known, so nothing is
//                   licensed (DEFAULT-DENY, below).
//
// ⚠ FIDELITY IS NOT SIGNEDNESS. u8/u16/u32 widen into i64 without moving a
// value, so the signed compare IS their unsigned order and they are OK. What
// decides is whether the VALUE SURVIVES the widening — a fact about the WIDTH.
//
// Who asks, and what each one loses when the answer is wrong:
//   • the JOIN-ORDER LICENCE (`join_order` C1, ADR 0024 S4/S4k) — via
//     `el_order_faithful` — which carries more than one nest solely because the
//     sort's row-index TIEBREAK, guarded by an EQUAL compare and hence reached
//     only under a total comparison, makes every nest yield the same sequence.
//     Measured on an f64 key with a NaN: four carried orders, four DIFFERENT row
//     sequences from the same data. Measured on a u64 key: one sequence, every
//     nest agreeing, and 2^63 ranked below 0;
//   • the EL's CALL SITE (`codegen::check_calls`) — via `el_int_fits_i64` and
//     `el_order_why` — which refuses a result whose value cannot survive the i64
//     normalization instead of reinterpreting it. That is a question about the
//     VALUE, so it is asked once for `select`/`where`/`group by`/`order by`
//     together rather than per clause.
//
// ⚠ DEFAULT-DENY is the substance of the UNNAMED row, not an omission from it.
// The lattice is four classes today and this compiler's stated direction is the
// whole Logos type system; a type added later must not inherit a licence resting
// on a comparison nobody has checked.
//
// ⚠ WHICH ROWS EACH CALLER CAN REACH, because a row nobody reaches is a claim
// nobody can check, and stating it is what keeps this a FACT TABLE rather than a
// pile of guards:
//   • `el_order_faithful` has ONE caller, the join-order licence. On a query
//     that BUILDS it can see OK, PARTIAL (an f64/f32 key) and UNNAMED (a key
//     whose declared name is out of the lattice — `ElTypes`' flat field dict is
//     keyed on the field NAME, so a same-named non-scalar field of another
//     source is recorded there and arrives verbatim). WRAP/TRUNC reach the
//     licence only from a DECLARED u64/u128 column or field, and such a query
//     cannot build at all: the emitted key vector is the class representative
//     (`Vec<i64>`) and will not accept the value. The one path that did produce
//     an i64-normalized wide integer — a UDF call — is refused at its use site;
//   • `el_order_why` is reached on all four non-OK rows: PARTIAL and UNNAMED
//     from the licence, WRAP and TRUNC from the call site;
//   • the recursive aggregate's value column is NOT a caller. It looks like one
//     and it used to be one; every body-declared rel column has already passed
//     `plan_walker::rel_col_ty_ok`, whose admitted set is i64/str/bool — now as a
//     DERIVATION from `el_set_col_admit` rather than a spelling list — so the
//     question was already answered upstream. See the note there.
pub fn EL_ORD_OK()      -> i32 { return 0i32; }
pub fn EL_ORD_PARTIAL() -> i32 { return 1i32; }
pub fn EL_ORD_WRAP()    -> i32 { return 2i32; }
pub fn EL_ORD_TRUNC()   -> i32 { return 3i32; }
pub fn EL_ORD_UNNAMED() -> i32 { return 4i32; }
// ⚠ A SIXTH STATE, AND IT IS NOT "UNNAMED": the type is IN the lattice and the
// backend emits NO `<` FOR IT AT ALL. `String` is the one row that is in this
// state today — `logos.mem.string` declares no `lt`, so `a < b` over two
// `String`s reaches mlir_gen and dies there ("'logos.mem.string.String__lt' does
// not reference a valid function"). UNNAMED would have been the wrong code and
// its ground the wrong sentence: it says "this type is outside the lattice", and
// `String` is not — its equality, its width story and its normalization are all
// admitted and all correct. Only the ORDER does not exist.
pub fn EL_ORD_NO_CMP()  -> i32 { return 5i32; }

/// Does every value of this INTEGER type survive the EL's `as i64`
/// normalization? THE width fact — asked by the call-site check that refuses a
/// lossy integer result (`codegen::check_calls`), which is a question about the
/// VALUE and therefore not only about sorting. False for a name outside the
/// integer family: callers ask it about a name they have already classified as
/// `EL_TY_INT`, and the class conjunct keeps the answer honest for the rest.
///
/// ⚠ THIS USED TO BE A SECOND LIST OF NAMES beside the lattice table, so a type
/// admitted there and forgotten here would have been silently treated as fitting.
/// It is now the type's own width.
pub fn el_int_fits_i64(name: str) -> bool {
    let t: ElTy = el_ty(name);
    return t.cls == EL_TY_INT() && t.fits;
}

/// How faithfully does the emitted comparison realize `name`'s own order? One of
/// the `EL_ORD_*` codes — a stored field of the resolved type.
pub fn el_order_fidelity(name: str) -> i32 { return el_ty(name).ord; }

/// The licence predicate: the emitted comparison realizes THIS type's order, so
/// a decision resting on "the sort determines the sequence" may be taken.
pub fn el_order_faithful(name: str) -> bool {
    return el_order_fidelity(name) == EL_ORD_OK();
}

/// The GROUND for a type whose emitted comparison does not realize its order —
/// the failed condition in the vocabulary of the comparison that fails, so a
/// caller's refusal can name a remedy instead of a verdict. Empty for a faithful
/// type.
///
/// ⚠ THE NORMALIZATION QUESTION, AND ITS THREE CALLERS ARE ALL EMIT POSITIONS:
/// an arithmetic operand, a UDF result, an aggregate argument. Each has already
/// established that the value is normalized `as i64` where it stands. It is NOT
/// the sort's question, and while the two shared one sentence this rendered a
/// claim about the sort at a site that is not the sort — see `el_ord_why_code`.
pub fn el_order_why(name: str) -> str {
    return el_ord_why_code(el_order_fidelity(name), EL_WHY_NORM());
}

// ══ THE REMEDY FOR `EL_ORD_WRAP`, WRITTEN ONCE ════════════════════════════
//
// `EL_ORD_WRAP` names one specific failure and no other: the value reached the
// EL's `i64` INTACT (the conversion is a bijection — `ElTy.ident` is `EL_ID_OK`
// for every integer of ≤ 64 bits) and only the ORDER moved, because the top bit
// that was a magnitude bit in the source type is the SIGN bit in `i64`. A
// failure that precise has an exact inverse, and this is it: flipping that one
// bit maps the unsigned order onto the signed order, monotonically and
// bijectively, so for u64 values a,b — `a <ᵤ b` ⟺ `key(a) <ₛ key(b)`.
//
// ⚠ THIS IS A KEY, NOT A CONVERSION, and the distinction is the same one
// `f64_data_key` makes (`stdlib/lang/num/float.logos`, and the arc that put it
// at the comparison seams is the model for this one): the key is for COMPARING,
// never for storing or emitting. The cell a query hands back is the argument's
// own `i64` — the bits are the bits — so nothing here may reach a value the
// caller reads back. `agg_val_key` in `deem/incr.logos` keys min/max IDENTITY on
// the raw value for exactly the same reason.
//
// ⚠ WHY IT LIVES HERE AND NOT AT THE THREE COMPARISON SITES. `el` is where the
// fact "this type's order moved" is DERIVED (`el_ord_of`), so it is where its
// inverse belongs; a copy at each site is the shape this file's own header calls
// out — five tables answering questions about one type, each free to drift.
// Consumers: `rt_cmp` and the min/max fold in `deem/exec.logos`, `agg_ord_key`
// in `deem/incr.logos`. The STATIC tier needs none of it: its key vector is
// typed with the key's OWN type (`Vec<u64>`), so the language lowers `<` to
// `ult` and no normalization ever happens — which is why the static tier was
// already right, and why `key_ord_frag` is untouched by this.
pub fn el_wrap_ord_key(x: i64) -> i64 { return x ^ (-9223372036854775807i64 - 1i64); }

/// Does a value of type `name` need `el_wrap_ord_key` before an ORDERED
/// comparison in the EL's `i64`? The type's own `ord`, asked rather than a list
/// of spellings: true for `u64`/`usize` and for any unsigned 64-bit type added
/// later, false for every width that fits (u8..u32/u24/u56 arrive non-negative
/// and their order survives) and for `i128`/`u128`, whose failure is TRUNC — bits
/// dropped, no key can repair that, and their refusal is a different site's job.
pub fn el_ord_wraps(name: str) -> bool { return el_ty(name).ord == EL_ORD_WRAP(); }

// The two EXTREMA of the wrapped order, as RAW `i64` payloads — the seeds a
// fold over an `EL_ORD_WRAP` column must use, DERIVED here rather than restated
// at each fold. `el_wrap_ord_key` is `x ^ i64::MIN`, so it attains its minimum
// at raw 0 and its maximum at raw −1: read as u64 those are 0 and 2^64−1, the
// identity elements of `max` and `min` over an unsigned column.
//
// ⚠ THE SIGNED SEEDS ARE WRONG HERE AND THE FAILURE IS THE ONE `6440e565` FIXED
// FOR f64: seeding `max` with `i64::MIN` puts the seed's KEY in the MIDDLE of
// the wrapped order — key(i64::MIN) = 0, an interior key — so `max` over a
// single row holding 5 would answer i64::MIN, i.e. u64 2^63, A VALUE PRESENT IN
// NO ROW, because key(5) = i64::MIN+5 is LESS than 0. MEASURED: with the compare
// fixed and the signed seeds left in place, `wql_domain_u64_order_seams` exits
// 25 on exactly that arm while every end-to-end fixture stays green. A seed is
// only sound when it is outside the key range, and that is a property of the
// KEY, not of the payload type.
pub fn el_wrap_ord_least()    -> i64 { return 0i64; }
pub fn el_wrap_ord_greatest() -> i64 { return -1i64; }

// ══ THE SAME ANTECEDENT, ASKED OF THE OVERFLOW PREDICATE ══════════════════
//
// `EL_ORD_WRAP` moves TWO total functions on the type, not one. The ORDER is
// the one the key above repairs. The other is the OVERFLOW PREDICATE, and it
// moved for exactly the same reason and at exactly the same values: a `u64`
// sum overflows when it passes 2^64−1, an `i64` sum when it passes 2^63−1, and
// between those two bounds the two predicates disagree in BOTH directions.
//
// ⚠ THIS IS NOT "WRAPPING", AND THE WORD MATTERS BECAUSE IT NAMES THE WRONG
// FIX. Both runtime accumulators already implement A13's discipline in the
// form Deem's convention requires — `checked_add`, error-as-VALUE, never a
// trap (`docs/DIVERGENCES.md` A13; the caller is a running program). Nothing
// wrapped. The addition simply asked the i64 predicate about a u64 sum, and
// two predicates that disagree produce two failures, not one:
//
//   FALSE NEGATIVE  the true u64 sum EXCEEDS u64, the i64 add does not
//     overflow, and a wrong number is returned with no error at all.
//     MEASURED: sum over { 5, 2^63, 2^64−1 } = 27670116110564327428, and the
//     i64 payloads 5 + (−2^63) + (−1) = −9223372036854775804 with no i64
//     overflow. That number was PINNED as correct by the corpus.
//   FALSE POSITIVE  the true u64 sum FITS u64, the i64 add overflows, and a
//     query with a representable right answer is REFUSED. MEASURED: sum over
//     { 2^62, 2^62 } = 2^63, inside u64 by a factor of two, error in both
//     tiers. This is the sharper of the two — there is no value to inspect.
//
// ⚠ AND THIS IS WHY A NARROWER FIX WOULD LOOK RIGHT. Two's-complement addition
// is the SAME BIT OPERATION signed and unsigned, so wherever the i64 add does
// NOT overflow its bits are already the u64 answer — `sum` over
// { 2^63, 2^63−2 } answers −2, which IS 18446744073709551614, and is correct
// today. Every defect lives at a disagreement between the two predicates, so
// only the predicate changes here and never the arithmetic.
//
// ⚠ WHY NOT A WIDER ACCUMULATOR. "Widen the integer sum" has no honest reading
// for a 64-bit unsigned column without a 128-bit carrier, and `RtVal` is not
// widened (D3, untaken). Nor is it "add in the column's own TYPE": `sum(u8)`
// over { 200, 100, 0 } answers 300 today and must keep doing so, because a u8
// widens into i64 LOSSLESSLY and the i64 predicate IS that column's predicate
// on the widened value. What is right is one step weaker and is exactly the
// bit the catalog already carries: ADD UNDER THE COLUMN'S OWN OVERFLOW
// PREDICATE — i64's for every `el_int_fits_i64` width, u64's for EL_ORD_WRAP.
//
// ⚠ UNLIKE `el_wrap_ord_key` THESE RETURN A VALUE, NOT A KEY. The key above is
// for COMPARING and never reaches a cell; these ARE the arithmetic, and their
// `i64` result is the u64 answer in the same bits the column already used —
// `get_i64` spells a u64 at or above 2^63 as a negative, which is the
// convention the corpus already accepts (`max(u64) == −1`).
//
// Consumers: the `sum` accumulator in `deem/exec.logos` and `deem/incr.logos`,
// and the scalar arithmetic tier of `deem/eval.logos` under an aggregate
// argument the checker typed unsigned.
pub fn el_wrap_add(a: i64, b: i64) -> Option<i64> {
    match (a as u64).checked_add(b as u64) {
        Option::Some(v) => { return Option::Some(v as i64); }
        Option::None    => { return Option::None; }
    }
}
pub fn el_wrap_sub(a: i64, b: i64) -> Option<i64> {
    match (a as u64).checked_sub(b as u64) {
        Option::Some(v) => { return Option::Some(v as i64); }
        Option::None    => { return Option::None; }
    }
}
pub fn el_wrap_mul(a: i64, b: i64) -> Option<i64> {
    match (a as u64).checked_mul(b as u64) {
        Option::Some(v) => { return Option::Some(v as i64); }
        Option::None    => { return Option::None; }
    }
}
pub fn el_wrap_div(a: i64, b: i64) -> Option<i64> {
    match (a as u64).checked_div(b as u64) {
        Option::Some(v) => { return Option::Some(v as i64); }
        Option::None    => { return Option::None; }
    }
}
pub fn el_wrap_rem(a: i64, b: i64) -> Option<i64> {
    match (a as u64).checked_rem(b as u64) {
        Option::Some(v) => { return Option::Some(v as i64); }
        Option::None    => { return Option::None; }
    }
}
// ⚠ THERE IS NO `el_wrap_neg`, AND ITS ABSENCE IS THE RULE, NOT AN OMISSION.
// Negating an unsigned value leaves that type's domain — `0 − x` is a u64 only
// at x = 0 — so the checker gives a unary minus `ordw: false` and the evaluator
// passes `false` into its operand. A helper here would be a fifth arm nothing
// calls, i.e. a claim about the semantics that no gate can bite on.

// ── WHICH QUESTION THE GROUND IS BEING ASKED FROM ────────────────────────────
// The `EL_ORD_*` code names WHAT the conversion did to the value. What that
// COSTS is a fact about the position that performs it, and the two positions
// are different questions with different costs — so the code alone does not
// determine the sentence, and rendering it as though it did is how one of them
// came to assert the other's mechanism.
//
// ⚠ THIS IS A MEASURED SPLIT, NOT A WORDING CHOICE. EL_ORD_WRAP's single
// sentence ended "an `order by` over such a key ranks the largest values below
// zero … so no plan decision downstream can detect it", and it was rendered by
// `check_agg_operand` / `check_arith_operand` / `check_calls` — all three in the
// STATIC tier. MEASURED at 85c9433d in that same tier: `order by s.v` over a
// `u64` column COMPILES and answers 5, 2^63, 2^64-1 in the CORRECT order,
// because the key vector holds the key's own type and compares in it (the
// conjunction at `el_cmp_fidelity`, and `key_norm_body` emits no cast at all
// when `tn == kv`). The clause described a static code path that was retired
// when key vectors stopped being `Vec<i64>`; it stayed true only of the DYNAMIC
// tier, which never renders this string. A refusal whose ground names a
// mechanism that no longer exists teaches the reader a false model of the
// compiler and is exactly the drift this file's ONE-renderer rule exists to
// prevent — the rule was right and the unit was wrong: one renderer per (code,
// QUESTION), not per code.
pub fn EL_WHY_NORM() -> i32 { return 0i32; }   // a value normalized `as i64` at an emit position
pub fn EL_WHY_SORT() -> i32 { return 1i32; }   // a key collected into a vector of another type

/// The ground for an `EL_ORD_*` CODE, asked from a named QUESTION — still ONE
/// renderer, and the unit it renders is a PAIR now: the type-level fact and the
/// remedy are the code's, the consequence clause between them is the question's.
///
/// ⚠ WHY THE PAIR IS SPELLED OUT INSTEAD OF COMPOSED, WHICH IS THE ONE THING A
/// READER WILL WANT TO CHANGE. Every arm is a STRING LITERAL because the return
/// value has to outlive the call: `join_order` stores it in `Why.keywhy` (a
/// `str` field of a record that travels into the plan), so a `String` built here
/// and viewed with `string_as_str` would be a borrow of a dead local — the
/// dangling-view defect this codebase has already paid for once. The cost is
/// that the FACT and the REMEDY appear twice per split code, and that cost is
/// MECHANIZED rather than trusted: `wql_el_ord_why_split` asserts that the two
/// renderings of each split code still share a long common prefix and a long
/// common suffix, so a copy edited alone goes red while the two edited together
/// stay green.
///
/// ⚠ WHICH (code, question) PAIRS ARE REACHABLE, because a pair nobody reaches is
/// a claim nobody can check — and here the derivation is exact rather than a
/// survey of callers. All three NORM callers refuse on the same antecedent: the
/// type is INT-family and `!fits` (`el_arith_ok` returns `t.fits` for INT and
/// true otherwise; `check_agg_operand` reaches the shared ground only inside
/// `!ty.fits`, and f32/f64 have `fits == true`; `check_calls` guards on
/// `EL_TY_INT() && !el_int_fits_i64`). `el_ord_of` maps exactly that antecedent
/// to WRAP (bits ≤ 64) or TRUNC (bits > 64). So NORM reaches WRAP and TRUNC and
/// NOTHING ELSE, and PARTIAL / UNNAMED / NO_CMP are SORT-reachable only — their
/// consequence clauses are the sort's and are written as such. If a fourth
/// normalization position ever reaches one of them, the sentence it gets is the
/// sort's and will read wrong; that is the same defect one row over, and the
/// derivation above is what makes it visible instead of silent.
pub fn el_ord_why_code(f: i32, q: i32) -> str {
    if f == EL_ORD_PARTIAL() {
        return "an f64/f32 key is only PARTIALLY ordered — a NaN compares false against every value including itself, so on a NaN row BOTH disjuncts of `prev > cur || (prev == cur && tiebreak)` are false and the tiebreak is never reached. The remedy is a key whose comparison is total: an integer within the i64 range, a `str`, or a `bool`";
    }
    if f == EL_ORD_WRAP() {
        if q == EL_WHY_SORT() {
            return "a `u64`/`usize` value is normalized to i64 by the EL, and that cast REINTERPRETS rather than converts: every value at or above 2^63 comes back NEGATIVE, so the number the query goes on to use is not the number the type held — an `order by` over such a key ranks the largest values below zero with a comparison that is TOTAL and identical in every nest, so no plan decision downstream can detect it. The remedy is a value that fits i64 (u32 and narrower widen losslessly), or the i64 it was computed from";
        }
        return "a `u64`/`usize` value is normalized to i64 by the EL, and that cast REINTERPRETS rather than converts: every value at or above 2^63 comes back NEGATIVE, so the number the query goes on to use is not the number the type held — and nothing after this position can tell that number from one the column genuinely held: what leaves here is a plain i64 and every later comparison is a total i64 order, so the query does not fail, it answers something else. The COLUMN is not the problem and is refused nowhere else — ordering by it, grouping by it, comparing it and projecting it all carry `u64` itself; it is this position that must make it an i64 and cannot do so faithfully. The remedy is a value that fits i64 (u32 and narrower widen losslessly), or the i64 it was computed from";
    }
    if f == EL_ORD_TRUNC() {
        if q == EL_WHY_SORT() {
            return "a `u128`/`i128` value is normalized to i64 by the EL, which DROPS the high bits: the normalization is not injective, so two different values arrive EQUAL — an `order by` then ranks them by the row-index tiebreak and a `group by` puts them in one bucket. The remedy is a value that fits i64";
        }
        return "a `u128`/`i128` value is normalized to i64 by the EL, which DROPS the high bits: the normalization is not injective, so two different values arrive EQUAL — and nothing after this position can tell the two apart: one i64 is what it accumulates, compares and returns, so the query does not fail, it answers something else. The remedy is a value that fits i64";
    }
    if f == EL_ORD_UNNAMED() {
        return "this type is outside the EL scalar lattice (`el_class_lookup`), so nothing is known about the comparison the backend would emit for it — and a type is not assumed to be ordered until it is admitted there. The default is deny, so that a type added later cannot inherit a licence resting on a comparison nobody has checked. The remedy is a key of an admitted scalar type (an integer within the i64 range, `str`, `bool`)";
    }
    if f == EL_ORD_NO_CMP() {
        return "the backend emits NO `<` for this type: `String` has no `lt`, so a comparison between two `String`s is accepted by sema and then fails in mlir_gen with an unresolved `String__lt`. This is not a defective order, it is the absence of one — the bytes are perfectly ordered, nothing compares them. The remedy is the `str` VIEW of the value (`as_str()`), whose comparison is the byte order and is emitted";
    }
    return "";
}

// ══ THE COMPARISON THE BACKEND EMITS IS OVER A TYPE, NOT OVER A CLASS ═══════
//
// A key reaches a comparison through a VECTOR (or a map), and the element type of
// that vector is what the emitter prints. Two names are therefore in play at every
// key site and they are NOT the same question:
//
//   named    the type the QUERY gave the key expression (`infer_ty_name`);
//   emitted  the type the EMITTER prints for the vector and for the body
//            (`infer_emit_ty`) — the same rule the projection's element type uses.
//
// While every key vector held `el_class_repr(class)`, `named != emitted` was the
// normal case and `ElTy.ord` — order fidelity UNDER the normalization — was the
// whole answer. It is not any more: a vector may hold the key's own type, and then
// the conversion step does not happen at all. So the question is a CONJUNCTION and
// each conjunct is a separate fact:
//
//   1. the value must REACH the comparison: `named == emitted` (nothing happens),
//      or `emitted` is `named`'s repr and `ElTy.fits` (the EL normalized it and
//      every value survived);
//   2. the comparison over `emitted` must be `emitted`'s own order / equality
//      (`self_ord` / `self_ident`).
//
// The returned code names WHICH conjunct failed, in the vocabulary that conjunct
// speaks: WRAP/TRUNC when the conversion lost the value, PARTIAL when the emitted
// comparison is not total, UNNAMED when either type is outside the lattice or the
// two are related by no conversion this table knows.
pub fn el_cmp_fidelity(named: str, emitted: str) -> i32 {
    let n: ElTy = el_ty(named);
    let e: ElTy = el_ty(emitted);
    if n.cls < 0i32 || e.cls < 0i32 { return EL_ORD_UNNAMED(); }
    if str_eq(named, emitted)       { return e.self_ord; }
    if !str_eq(emitted, n.repr)     { return EL_ORD_UNNAMED(); }
    if !n.fits                      { return n.ord; }
    return e.self_ord;
}

/// The IDENTITY counterpart of `el_cmp_fidelity`, for the sites that need `==`
/// plus a hash rather than a ranking — a `group by` bucket, an equi-join key.
/// Same two conjuncts, same "which one failed" discipline.
pub fn el_cmp_ident(named: str, emitted: str) -> i32 {
    let n: ElTy = el_ty(named);
    let e: ElTy = el_ty(emitted);
    if n.cls < 0i32 || e.cls < 0i32 { return EL_ID_UNNAMED(); }
    if str_eq(named, emitted)       { return e.self_ident; }
    if !str_eq(emitted, n.repr)     { return EL_ID_UNNAMED(); }
    if n.ident != EL_ID_OK()        { return n.ident; }
    return e.self_ident;
}

/// The ground for a key whose emitted comparison does not realize its order.
pub fn el_cmp_why(named: str, emitted: str) -> str {
    let f: i32 = el_cmp_fidelity(named, emitted);
    if f == EL_ORD_OK() { return ""; }
    if f == EL_ORD_UNNAMED() && el_ty(named).cls >= 0i32 && el_ty(emitted).cls >= 0i32 {
        return "the key vector the backend emits holds neither this type nor the type the EL normalizes it into, so no conversion this table knows carries the value into the comparison. The remedy is a key whose type IS the emitted element type";
    }
    return el_ord_why_code(f, EL_WHY_SORT());
}

/// The ground for a key whose emitted `==` does not realize its equality.
pub fn el_cmp_ident_why(named: str, emitted: str) -> str {
    let i: i32 = el_cmp_ident(named, emitted);
    if i == EL_ID_OK() { return ""; }
    if i == EL_ID_NO_EQ() {
        return "this key's equality is not even REFLEXIVE: an f64/f32 NaN compares false against every value including itself, so such a row is equal to nothing, not even to a copy of itself, and no bucket can hold it. The remedy is a key whose equality is meaningful — an integer, a `str` or a `bool`";
    }
    if i == EL_ID_NO_INJ() {
        return "the EL's normalization of this key is NOT INJECTIVE: a value wider than 64 bits arrives with its high bits dropped, so two different keys collapse into one bucket. The remedy is a key that fits the i64 the EL computes in";
    }
    return "this key's type is outside the EL scalar lattice (`el_ty`), so nothing is known about the `==` and the hash the backend would emit for it — and a type is not assumed to have an identity until it is admitted there. The remedy is a key of an admitted scalar type";
}

/// Can a value of type `n` be collected into a key vector / index of type `kv`
/// WITHOUT losing anything — either because it is already that type, or because
/// the EL's normalization takes it there and every value survives?
///
/// THE shared antecedent of `key_norm_ok` and `step_key_ty_of`: one asks it to
/// admit, the other to pick a common type for two sides of an equi-term.
pub fn el_key_reaches(n: str, kv: str) -> bool {
    let t: ElTy = el_ty(n);
    if t.cls < 0i32   { return false; }
    if str_eq(n, kv)  { return true; }
    return str_eq(kv, t.repr) && t.fits
        && (t.cls == EL_TY_INT() || t.cls == EL_TY_FLT());
}

/// Can the emitted KEY VECTOR hold this type — `Vec<K>` filled per row, read back
/// by value with `get`, compared with `<` and `==`?
///
/// ⚠ A DIFFERENT QUESTION FROM `el_index_key_ok`, AND THE ANSWERS DIFFER. The
/// vector path uses the LANGUAGE's `<`/`==` on the element, so it works for every
/// scalar including the 128-bit ones (measured: a `Vec<u128>` sort ranks
/// u128::MAX last). What it cannot do is hold a NON-`Copy` element: `Vec::get`
/// refuses to move a `String` out, and the `str` view that would avoid the move
/// borrows the row var, which dies with the loop body. So `String` is the one
/// lattice type this denies — and it is denied HERE rather than in the identity
/// or order tables, because its equality and its order are both perfectly fine.
pub fn el_vec_key_ok(name: str) -> bool {
    let t: ElTy = el_ty(name);
    if t.cls < 0i32          { return false; }
    if t.cls == EL_TY_STR()  { return str_eq(name, "str"); }   // `String` is not Copy
    return true;
}

// ── CAN THE BACKEND BUILD AN INDEX KEYED IN THIS TYPE? ────────────────────
// A DIFFERENT KIND OF FACT from everything above it, and that is why it is its
// own function rather than a clause inside one. Every other row here is a
// THEOREM about a conversion — it follows from the width, the signedness and the
// class, and no amount of stdlib work can change it. This one is a fact about
// what the STDLIB CURRENTLY PROVIDES: `HashMap<K, V>` requires `K: Hash + Eq`,
// and `logos.lang.hash` / `logos.lang.cmp` enumerate their instances.
//
// ⚠ SO IT IS THE ONE ROW THAT IS ALLOWED TO BE A LIST — it is a list of impls
// that exist, read off the two files that declare them, and a type gains its
// entry by gaining the impl. Deriving it from the width instead would be exactly
// the mistake this table was built to stop: a claim about the emitted code
// inferred from a property of the type.
//
// The instances, as of `logos.lang.hash` + `logos.lang.cmp`: EVERY INTEGER TYPE
// THE LATTICE ENUMERATES — i8/i16/i32/i64, u8/u16/u32/u64, isize/usize, the
// packed i24/u24/i56/u56, the 128-bit i128/u128 — plus bool and str.
//
// ⚠ THE 128-BIT AND PACKED EXCLUSIONS ARE GONE AND SO ARE THE TWO REASONS THAT
// KEPT THEM. This function used to say "128-bit is excluded and the reason is a
// MEASURED SIGSEGV" (`impl Eq for u128` dying at the call) and, on the width
// heuristic below, "Writ's packed widths are a storage encoding, not a Logos
// type a `HashMap` can be instantiated over". RE-MEASURED 2026-08-05 at c6c212c7,
// before any impl was written: neither reproduces. The claimed segfault does not
// fire — not user-placed, not stdlib-placed, and not from the probe the comment
// itself named — and `HashMap<u56, i64>` / `<i24, i64>` / `<u128, i64>` all
// instantiate, deduplicate on overwrite and retrieve at the width extremes. Two
// independent name lists, each wearing a reason that did not hold.
//
// ⚠ AND THE PREDICATE IS NO LONGER A WIDTH HEURISTIC. It asked
// `(bits & (bits-1)) == 0 && bits <= 64`, which is an arithmetic re-derivation of
// a list of impls — precisely the shape this table exists to refuse. It asks the
// lattice's own class rows now, so nothing here can drift from the impls except
// by an impl being deleted, and `logos_09_el_hashable_agreement` (tier 1 = the
// LANGUAGE, via the rel-column check; tier 2 = this function) fails naming the
// type on the next run if one is.
//
// ⚠ THE FLOATS GET NO CLAUSE OF THEIR OWN HERE, and the comment that used to sit
// on this line said they were "not excluded", which the code below contradicts:
// `f64` is neither BOOL nor STR nor INT, so the class test denies it. Both facts
// are true and the sentence had collapsed them — `logos.lang.hash` declares NO
// `impl Hash for f64`, so the honest answer here IS false, and separately the
// reason a float key is refused (a NaN is equal to nothing) lives in
// `self_ident` / `self_ord` where the ground is stated. What must not happen is a
// float-specific clause here restating that ground a second time.
//
// ⚠ `String` IS EXCLUDED, and this is the honest half of the String story. An
// index keyed in `String` would have to OWN each key; the emitted shape borrows
// the row's bytes, and the borrow does not outlive the loop body the row var is
// bound in (measured: E0597, `'s' does not live long enough`). So a `String`
// equi-key falls to the LOOP tier, where the comparison is `String == String`
// through `impl Eq for String` and is exact. No index, correct answer, and the
// cascade says which capability was missing.
//
// ⚠ WHAT WOULD DELETE THESE TWO REFUSALS, stated because a refusal that cannot
// say that is a name list again — which is what the 128-bit and packed rows had
// become. `f32`/`f64`: an `impl Hash`/`impl Eq` for a float, which cannot be
// written while `NaN != NaN` (their ground is in `self_ident`, not here).
// `String`: an index that OWNS its keys, at which point the E0597 above stops
// being a fact about the emitted shape. Both are EXERCISED, not merely asserted —
// `logos_09_el_hashable_agreement` asks the LANGUAGE for a `rel` column of each
// name on every run, and fails naming the type the moment either side moves.
pub fn el_index_key_ok(name: str) -> bool {
    let t: ElTy = el_ty(name);
    if t.cls == EL_TY_BOOL() { return true; }
    if t.cls == EL_TY_STR()  { return str_eq(name, "str"); }   // not `String` — see above
    // EVERY INTEGER ROW. `logos.lang.hash` + `logos.lang.cmp` carry `Hash`/`Eq`
    // for all of them, so there is no width test left to write: a new integer
    // row added to the lattice without its impls is caught by the agreement gate
    // rather than by an arithmetic guess made here.
    return t.cls == EL_TY_INT();
}

// ── MAY THE EL COMPUTE ARITHMETIC IN THIS TYPE? ───────────────────────────
// The EL's integer arithmetic is `el_add`/`el_sub`/… — i64 in, i64 out, checked.
// So the RESULT of an integer arithmetic node is i64 whatever the operands were
// named, and each operand is normalized into i64 to reach the call. That is the
// same `as i64` the call site refuses when the value cannot survive it, and it is
// refused here for the same reason and by the same fact (`ElTy.fits`): u8..u32,
// i8..i32, u56/i56 and isize normalize without moving a value, `u64`/`usize`
// REINTERPRET and `u128`/`i128` TRUNCATE.
//
// ⚠ THIS IS NOT A NEW RESTRICTION, IT IS A NEW DIAGNOSTIC. MEASURED at HEAD:
// `select s.v + 1` over a `u64` column emitted `el_add((s.v), (1u64))` and failed
// as `call to 'el_add' arg 1: expected i64, got u64` — inside a generated chunk,
// naming neither the column nor the reason. The same query over `u32` failed the
// same way; it is ADMITTED now, with its operands normalized, because the u32
// normalization keeps every value.
pub fn el_arith_ok(name: str) -> bool {
    let t: ElTy = el_ty(name);
    if t.cls < 0i32 { return true; }           // lenient: the host compiler decides
    if t.cls != EL_TY_INT() { return true; }   // float arithmetic is infix, no i64
    return t.fits;
}

/// THE answer to the NEIGHBOURING question, kept next to the order table because
/// the two are confusable and have different answers: may this class serve as an
/// IDENTITY — `==` plus a hash — so that grouping and deduplication put equal
/// values in one bucket? Ranking and identity are different properties; f64 fails
/// both but for different reasons, and a class added later could easily have one
/// without the other.
///
/// ⚠ THIS ONE IS ASKED OF THE CLASS, and the class is not where the answer
/// lives: it is `ElTy.ident`, and this function reads it off the class's
/// REPRESENTATIVE. So the answer here is "does the type the EL actually computes
/// in have an identity" — true for the i64/str/bool representatives, false for
/// f64 (NaN != NaN, so equality is not even reflexive). A caller holding the real
/// type NAME should read `el_ty(name).ident` instead and get the sharper answer:
/// `u128` is EL_TY_INT and has no identity, because its normalization drops bits.
///
/// Default-DENY on a class this lattice does not enumerate — the group-by key's
/// guard used to be a hand-written `== EL_TY_FLT()`, exhaustive only as long as
/// the lattice has four classes.
pub fn el_eq_hash(ty: i32) -> bool {
    if ty == EL_TY_INT() || ty == EL_TY_STR()
       || ty == EL_TY_BOOL() || ty == EL_TY_FLT() {
        return el_ty_has_ident(el_ty(el_class_repr(ty)));
    }
    return false;
}

// ── The GENERIC aggregate rule table (ADR 0012-queue2 §6) ──────────────────
// ONE `agg_result_ty(fn, arg_ty) -> ty` map shared by every backend tier:
//   count : ()  → INT
//   sum   : T   → T          (numeric T)
//   min   : T   → T          (numeric T)
//   max   : T   → T          (numeric T)
//   avg   : T   → Quot(T)    (Quot(INT) = Quot(FLT) = Quot(BOOL) = FLT under
//                             the current numeric tower — the exact mean, f64
//                             division)
// Lives HERE (metaprog-free, IR-level shared code) so the DYNAMIC interpreter
// (logos.std.deem) consults it now and the STATIC emitter (rexpr_walk's
// agg_flt/act computation) MIGRATES to consult the same table later — one
// rule source, two consumers.

// Quot(T) — the quotient type of the aggregate mean. INT/FLT/BOOL → FLT;
// anything else is out of the numeric tower (-1).
//
// ⚠ `bool` IS ADMITTED HERE AND NOWHERE ELSE (Victor's ruling, option (c) of
// three). `avg` over a bool column is the FRACTION TRUE, under the value rule
// true→1.0 / false→0.0; `sum`/`min`/`max` keep refusing bool below, so this is
// "avg admits bool", NOT "bool is numeric". `wql_agg_nonnumeric_arg_fail`
// (`min` over a bool column) is the load-bearing check that the two did not get
// conflated: it must stay red-on-compile.
//
// ⚠ THE VALUE RULE IS NOT INVENTED HERE — IT IS WHAT `as f64` ALREADY MEANS.
// mlir-gen zero-extends i1 before the conversion deliberately (`sitofp(i1(1))`
// = -1.0 is wrong, `uitofp(i1(1))` = 1.0 is right), the static fold emitter
// writes exactly that `as f64`, and the incremental tier already folds a bool
// through `rt_i`, which maps true→1. What this line changes is only what the
// FRONT END admits; the arithmetic underneath was already the ruling's.
//
// ⚠ THE OTHER TWO OPTIONS AND WHY THEY LOST: refusing bool as well breaks
// programs that compile and answer today; leaving the rule alone lets
// `avg(str)` keep compiling (it did — rc=0, with the backend printing
// "unsupported cast" and the object file written anyway).
//
// THE OTHER DIRECTION IS THE POINT OF THIS FILE: three tiers read this one
// table — the static `deem!` emitter (rexpr_walk::compute_agg_reprs), the
// dynamic `Query::compile` checker (deem/check.logos) and, through the same
// `check_rexpr`, the incremental engine (deem/incr.logos). One edit moves all
// three, which is why `wql_agg_avg_bool_three_engines` asserts all three.
pub fn el_quot_ty(t: i32) -> i32 {
    if t == EL_TY_INT() || t == EL_TY_FLT() || t == EL_TY_BOOL() { return EL_TY_FLT(); }
    return -1i32;
}

// True iff `name` is a builtin aggregate function.
pub fn is_builtin_agg(name: str) -> bool {
    return str_eq(name, "count") || str_eq(name, "sum") || str_eq(name, "min")
        || str_eq(name, "max")   || str_eq(name, "avg");
}

// Does the builtin aggregate take an argument? (count is the sole nullary.)
pub fn agg_takes_arg(name: str) -> bool {
    return is_builtin_agg(name) && !str_eq(name, "count");
}

// THE rule table: the EL result type of `fn(arg: arg_ty)`. `arg_ty` is ignored
// for `count` (pass anything). Returns -1 for an unknown aggregate name or an
// argument outside the rule's domain (sum/min/max/avg need numeric INT/FLT).
pub fn agg_result_ty(fn_name: str, arg_ty: i32) -> i32 {
    if str_eq(fn_name, "count") { return EL_TY_INT(); }
    if str_eq(fn_name, "sum") || str_eq(fn_name, "min") || str_eq(fn_name, "max") {
        if arg_ty == EL_TY_INT() || arg_ty == EL_TY_FLT() { return arg_ty; }
        return -1i32;
    }
    if str_eq(fn_name, "avg") { return el_quot_ty(arg_ty); }
    return -1i32;
}

// ══ THE ACCUMULATOR'S TYPE, WHICH IS A DIFFERENT QUESTION FROM THE RESULT'S ══
//
// `agg_result_ty` answers what a group's COLUMN holds. This answers what the
// RUNNING TOTAL is carried in while the fold is still going — and the two are
// not the same question, because a fold has an overflow predicate and a column
// does not.
//
// ⚠ IT IS NOT "THE COLUMN'S OWN TYPE", AND THE LITERAL READING IS REFUTED BY A
// FIXTURE THAT ALREADY EXISTS. `tests/logos/pass/wql_u64_sum_accumulator.logos`
// block 6 pins `sum` over a `u8` column of { 200, 100, 0 } at 300 — a number no
// u8 can hold — so accumulating in the column's own type would call a correct
// query an overflow. The rule is one step weaker and is the one the header of
// `el_wrap_add` above derives in full: ADD UNDER THE COLUMN'S OWN OVERFLOW
// PREDICATE. A width that widens into i64 losslessly HAS i64's predicate, so
// i64 is its accumulator; `EL_ORD_WRAP` is the one class whose predicate moved
// with its order, and u64 is that class's accumulator.
//
// So, per row of the lattice:
//   INT  && fits   → "i64"   every signed width, u8/u16/u32/u24/u56 — the
//                            widening keeps the value, so it keeps the predicate
//   INT  && WRAP   → "u64"   u64/usize — value intact, ORDER and OVERFLOW both
//                            moved; `u64::checked_add` is the host's own
//                            predicate and NO `el_wrap_*` helper is reached
//   FLT            → "f64"   the type the EL computes floats in; `f32` is
//                            refused at the operand check rather than widened
//                            here, deliberately — see `check_agg_operand`
//   anything else  → "i64"   the class representative, which is what the
//                            operand check is holding when it refuses
//
// ⚠ THE LAST ROW IS NOT A FALLBACK, IT IS THE STATUS QUO WRITTEN DOWN. A
// `u128`/`i128` argument (`EL_ORD_TRUNC`) and a non-numeric one both come back
// "i64" so that `check_agg_operand` refuses them with exactly the ground it
// renders today: this function moves WHICH type the accumulator is, never
// WHETHER a type is admitted. A caller that swapped its hardcoded "i64" for
// this call changes no admission at any row but WRAP.
//
// ⚠ ASK IT ONLY WHERE THE RULE TABLE SAID THE ACCUMULATOR IS THE ARGUMENT'S.
// `count` accumulates a row count (i64 whatever the argument) and `avg`
// accumulates an f64 sum for EVERY admitted argument class (`el_quot_ty`), so
// neither is this function's question; `sum`/`min`/`max` are.
//
// Consumers: BOTH static emitters, through the single `acc` array
// `rexpr_walk::compute_acc_tys` fills — the accumulator declaration, the seeds,
// the fold's overflow predicate, the finalized column type and the aggregate
// output name's recorded type all read it. The BATCH fold used to hardcode
// "i64"/"f64" and therefore refused a `u64` sum; that cell closed on 2026-08-06
// and its answers are `tests/logos/pass/wql_agg_wide_int_arg_e2e` and
// `tests/logos/pass/deem_incr_static_minmax_u64_e2e`.
pub fn agg_acc_ty(arg_ty_name: str) -> str {
    let t: ElTy = el_ty(arg_ty_name);
    if t.cls == EL_TY_FLT() { return "f64"; }
    if t.cls == EL_TY_INT() && t.ord == EL_ORD_WRAP() { return "u64"; }
    return "i64";
}

/// The IDENTITY element of an ordered fold in accumulator type `acc` — the seed
/// `min` and `max` start from, spelled as a LITERAL of `acc` itself.
///
/// ⚠ A SEED IS ONLY SOUND WHEN IT IS OUTSIDE THE VALUE RANGE OR AT ITS EDGE, and
/// that is a property of the ACCUMULATOR, not of the column: the header of
/// `el_wrap_ord_least` records the measurement where signed seeds put `max`'s
/// seed in the MIDDLE of a u64 column's order and `max` over a single row of 5
/// answered 2^63. Typed accumulators make the question trivial again — u64's
/// extrema are 0 and 2^64-1 and they are writable as u64 literals — which is
/// exactly the "right by construction" the typing is for. `greatest` is the seed
/// for `min` and `least` is the seed for `max`.
pub fn agg_acc_least(acc: str) -> str {
    if str_eq(acc, "u64") { return "0u64"; }
    return "-9223372036854775808i64";
}
pub fn agg_acc_greatest(acc: str) -> str {
    if str_eq(acc, "u64") { return "18446744073709551615u64"; }
    return "9223372036854775807i64";
}
/// The ZERO of `acc` — `sum`'s seed and `count`'s.
pub fn agg_acc_zero(acc: str) -> str {
    if str_eq(acc, "u64") { return "0u64"; }
    if str_eq(acc, "f64") { return "0.0f64"; }
    return "0i64";
}

// ── ElTypes — the name→value-type dictionary (the type seam, Option B) ─────
// The self-describing IR carries NAMES, not declared value-types; the codegen
// still needs each field/param/var's EL value-type (str/bool/int) to route
// push_str vs push_i64 and choose the result element type. `ElTypes` is that
// mapping, built by the wql!/trama! HANDLER from (a) schema reflection over the
// source/context struct and (b) the `deem!(…)`/`trama!(…)` PARAM LIST (scalar
// params seed their declared value-type) — and passed to the codegen instead
// of the parser. It is a small association list over borrowed `str` name views
// (the names live in the surface text / interned WStrings, which outlive the
// codegen). The generated fn's argument list is NOT tracked here any more: the
// signature is the paren param list re-emitted VERBATIM (the trama! model).
// The UDF section (`udf_*`): the metacall-time USER-FUNCTION registry (ADR 0012
// UDF/UDA). The wql!/trama! handlers reflect every top-level `fn` of the
// TRIGGER module (`reflect::stamp_udfs_from_module`) into this table; the
// codegen (emit_call / infer_ty / returns_string / check_calls) consults it
// AFTER the builtin registry (builtins shadow a same-named UDF). Per entry:
// the fn NAME, its return's EL lattice tag (`el_ret_class`; -1 = out-of-lattice
// return, diagnosed on use), the DECLARED return type name verbatim (drives
// the `as i64`/`as f64` widening casts + the returns-String treatment), and
// the declared ARITY. Capacity 32 top-level fns; entries beyond that are
// dropped (such a fn then diagnoses as unknown — reflection-capacity MVP).
// NOTE (queue-2): this table is metacall-time DATA only — the IR still carries
// just the call NAME (`SCall.fn_name`); a future interpreter re-resolves the
// same names against its own registry.
// The COLUMN-BINDING section (`rb_*`): THE table a `var.col` step types
// against. Per entry: the bound ROW VAR, the column NAME, the ACCESS code, and
// the column's declared LOGOS TYPE. Filled per emitted query by
// `rexpr_walk::stamp_rel_columns` (rel sources) and
// `reflect::stamp_types_from_schema` (struct sources); consulted by the codegen
// (emit_sexpr / infer_ty / infer_ty_name) BEFORE the flat name dictionary.
//
// ⚠ IT IS KEYED ON THE BINDING, NOT ON THE SPELLING OF A FIELD. The flat dict
// below is keyed on a bare column name, so two joined sources declaring the
// same column name overwrite each other and the LAST one stamped types both:
// `from as a join bs b … order by a.n` with `A { n: i64 }` and `B { n: u32 }`
// emitted `a.n` as u32. The type error that produced was the mild half — the
// PLANNER reads the same dict, so `A { n: f64 }` beside `B { n: i64 }` granted
// the reorder licence over an f64 key, which `24141965` exists to refuse. Both
// were measured. A struct source stamps here now for exactly the same reason a
// rel one always did.
pub struct ElTypes {
    // ── the flat name dictionary ──
    // What has NO owner at all: scalar params, the `group by` key, an aggregate
    // output column, a by-value element binding, a trama `{% set %}` — names
    // bound in their own right rather than reached through anything. Column
    // names are stamped here too, but nothing that HAS an owner reads them: a
    // field step resolves against `rb_*` (a row var for `a.n`, a struct type for
    // `a.b.c`) and reaches this table only when neither key is bound, where the
    // answer is the `i64` baseline either way.
    pub names:  [str; 256],
    // The LOGOS TYPE of each binding — THE column (ADR 0024 S3/S6). It used to
    // sit BESIDE a four-value classification, and a binding recorded through the
    // class-only setter left this empty: `ty_name_of` then invented the class's
    // representative, so a `u64` column produced `i64` literals and an `i64` row
    // type. The class is a VIEW now (`ty_of` = `el_ty_of_name` of this), so there
    // is no second column to disagree with.
    pub tns:    [str; 256],
    pub n:      i64,
    pub udf_names: [str; 32],
    pub udf_ret:   [i32; 32],
    pub udf_rets:  [str; 32],
    pub udf_arity: [i64; 32],
    pub udf_n:     i64,
    pub rb_var: [str; 256],
    pub rb_col: [str; 256],
    // How the column is REACHED off its row var — k ≥ 0 (`var.k`, a native
    // rel's tuple component), `COL_WHOLE` (`(*var)`, the scalar row of a
    // 1-column rel), `COL_FIELD` (`var.col`, a struct field).
    pub rb_idx: [i64; 256],
    // The column's DECLARED type, per binding (ADR 0024 S3/S6).
    pub rb_tn:  [str; 256],
    // WHAT `rb_var` NAMES — `CB_VAR` a query ROW VAR, `CB_TYPE` a declared
    // STRUCT. The second kind is what resolves a NESTED path: `a.b.c` has no row
    // var (`root_ident_name` reports "" for it), so the type of `a.b` — which the
    // row-var binding holds, and which IS a struct name — is the key its `c` is
    // looked up under. Two kinds on one table rather than two tables: the entries
    // are the same shape, and a `kind` column cannot drift from a parallel array.
    pub rb_kind: [i64; 256],
    pub rb_n:   i64,
    // ── capacity overflow: RECORDED, never silent ──
    // A dropped binding used to be a silent fall-back to the `i64` baseline —
    // a wrong type with no diagnostic, which is how this plane's worst bugs
    // begin. The drop is recorded WHERE IT IS DECIDED (the setter); the
    // stampers, which hold the metaprog `error` channel `el` deliberately does
    // not import, turn it into a message naming the first key lost.
    pub ovf_n:        i64,
    pub ovf_var:      str,   // "" when the dropped key had no row var
    pub ovf_key:      str,
    pub ovf_reported: bool,
}

/// Access codes for `ElTypes.rb_idx`. A tuple component is its own index, so
/// the two non-positional forms take negative codes.
pub fn COL_WHOLE() -> i64 { return -1i64; }   // `(*var)` — 1-column rel's scalar row
pub fn COL_FIELD() -> i64 { return -2i64; }   // `var.col` — a struct field

/// What the first column of a binding NAMES (`ElTypes.rb_kind`).
pub fn CB_VAR()  -> i64 { return 0i64; }      // a query row var
pub fn CB_TYPE() -> i64 { return 1i64; }      // a declared struct type

/// The binding-table / dictionary capacity, stated once.
///
/// GROUND: a query's sources are parameters (`MacroParams` caps them at 64) or
/// rels (capped at 8, with a 64-entry flat column window); a source contributes
/// one binding per COLUMN. 256 admits eight sources of thirty-two columns —
/// four times the rel-column window this plane already states — and past it the
/// compiler NAMES what it dropped instead of typing it `i64`.
pub fn EL_TY_CAP() -> i64 { return 256i64; }

pub fn el_types_new() -> ElTypes {
    return ElTypes {
        tns:    [""; 256],
        names:  [""; 256],
        n:      0i64,
        udf_names: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                    "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        udf_ret:   [0i32; 32],
        udf_rets:  ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                    "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        udf_arity: [0i64; 32],
        udf_n:     0i64,
        rb_var: [""; 256],
        rb_col: [""; 256],
        rb_idx: [0i64; 256],
        rb_tn:  [""; 256],
        rb_kind: [0i64; 256],
        rb_n:   0i64,
        ovf_n:        0i64,
        ovf_var:      "",
        ovf_key:      "",
        ovf_reported: false,
    };
}

impl ElTypes {
    // The recorded value-type for `name` (EL_TY_*), or INT if unknown.
    //
    // ⚠ DERIVED, not stored. The class used to be a second column beside the
    // name, and a binding recorded through the class-only setter left the name
    // EMPTY — so `ty_name_of` INVENTED the class's representative and a `u64`
    // column came back out as `i64`. There is now one column, the TYPE, and the
    // class is a view of it.
    pub fn ty_of(self: &ElTypes, name: str) -> i32 {
        return el_ty_of_name(self.ty_name_of(name));
    }

    // Record / overwrite `name` by CLASS (idempotent by name). The recorded type
    // is the class's representative — which is not a fallback here but the truth:
    // the callers that reach this hold a value the EL has already normalized (a
    // group key vector, an aggregate output column), and the representative IS
    // what the emitted code holds.
    pub fn set_ty(self: &mut ElTypes, name: str, ty: i32) {
        self.set_ty_named(name, el_class_repr(ty));
    }

    // Record `name` with its LOGOS TYPE NAME. THE setter: everything a consumer
    // needs about the binding is derivable from the type, so the type is what is
    // kept. Reflection over a struct's fields, a native rel's columns, the
    // parameter list and every by-value element binding come through here.
    pub fn set_ty_named(self: &mut ElTypes, name: str, ty_name: str) {
        let mut i: i64 = 0i64;
        while i < self.n {
            if str_eq(self.names[i], name) { self.tns[i] = ty_name; return; }
            i = i + 1i64;
        }
        if self.n >= EL_TY_CAP() { self.note_overflow("", name); return; }
        self.names[self.n] = name;
        self.tns[self.n]   = ty_name;
        self.n = self.n + 1i64;
    }

    /// Record that a binding could NOT be stored — the fact kept where it is
    /// decided, so the stampers can report it instead of the emitter silently
    /// typing the name `i64`. The FIRST key lost is the one named; the count
    /// says how many followed.
    fn note_overflow(self: &mut ElTypes, var: str, key: str) {
        if self.ovf_n == 0i64 { self.ovf_var = var; self.ovf_key = key; }
        self.ovf_n = self.ovf_n + 1i64;
    }

    /// The first dropped key (row var, column — the var is "" for a flat name),
    /// and how many were dropped in total.
    pub fn overflow_var(self: &ElTypes) -> str { return self.ovf_var; }
    pub fn overflow_key(self: &ElTypes) -> str { return self.ovf_key; }
    pub fn overflow_count(self: &ElTypes) -> i64 { return self.ovf_n; }

    /// True the FIRST time an overflow is claimed for reporting — the stampers
    /// run many times per query and the drop must produce ONE message, not one
    /// per stamping site.
    pub fn claim_overflow(self: &mut ElTypes) -> bool {
        if self.ovf_n == 0i64 { return false; }
        if self.ovf_reported { return false; }
        self.ovf_reported = true;
        return true;
    }

    // The LOGOS TYPE NAME for `name` — what the emitter must print: a type, a
    // literal suffix, a row-tuple component. `i64` for a name never recorded (the
    // lattice baseline, the same answer the class view has always given).
    pub fn ty_name_of(self: &ElTypes, name: str) -> str {
        let mut i: i64 = 0i64;
        while i < self.n {
            if str_eq(self.names[i], name) { return self.tns[i]; }
            i = i + 1i64;
        }
        return "i64";
    }

    // The UDF-table index of the fn named `name`, or -1 when unregistered.
    pub fn udf_find(self: &ElTypes, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.udf_n {
            if str_eq(self.udf_names[i], name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }

    // Register a reflected user fn (first registration wins — module items are
    // walked in declaration order and names are unique per module anyway).
    pub fn udf_add(self: &mut ElTypes, name: str, ret_el: i32, ret_name: str, arity: i64) {
        if self.udf_find(name) >= 0i64 { return; }
        if self.udf_n >= 32i64 { return; }
        self.udf_names[self.udf_n] = name;
        self.udf_ret[self.udf_n]   = ret_el;
        self.udf_rets[self.udf_n]  = ret_name;
        self.udf_arity[self.udf_n] = arity;
        self.udf_n = self.udf_n + 1i64;
    }

    // True iff `name` resolves to a UDF returning an OWNED `String` (the
    // returns-String treatment: `.as_str()` borrow / owned result element).
    pub fn udf_returns_string(self: &ElTypes, name: str) -> bool {
        let i: i64 = self.udf_find(name);
        if i < 0i64 { return false; }
        return str_eq(self.udf_rets[i], "String");
    }

    // ── column bindings — THE (row var, column) key ────────────────────────
    // `idx` ≥ 0 — tuple component index (`var.idx`, a native rel row);
    // `COL_WHOLE` — the WHOLE scalar row of a 1-COLUMN rel (`Vec<i64>` rows, no
    // tuple: access emits `(*var)`); `COL_FIELD` — a named struct field
    // (`var.col`, the access the emitter would have printed anyway). Existence
    // tests go through `rel_col_ty` (≥ 0 iff bound); `rel_col_of`'s negative
    // codes are only meaningful under a bound (var, col).

    /// Bind (var, col) → access `idx` of DECLARED type `ty_name`.
    ///
    /// ⚠ THE CLASS IS NOT STORED HERE EITHER. The class-only `rel_bind` that used
    /// to sit beside this one recorded an empty name, which is how a rel column's
    /// width could be lost between binding it and emitting it.
    ///
    /// Re-binding the same (var, col) OVERWRITES — the same idempotence
    /// `set_ty_named` has. A source is stamped more than once per query (the
    /// planner stamps to decide, the emitter stamps to emit), and appending
    /// would have exhausted the table on a re-walk rather than on a wide query.
    pub fn rel_bind_named(self: &mut ElTypes, var: str, col: str, idx: i64,
                          ty_name: str) {
        self.bind_col(CB_VAR(), var, col, idx, ty_name);
    }

    /// THE binding write. `kind` says whether `owner` names a row var or a type.
    fn bind_col(self: &mut ElTypes, kind: i64, owner: str, col: str, idx: i64,
                ty_name: str) {
        let e: i64 = self.find_col(kind, owner, col);
        if e >= 0i64 {
            self.rb_idx[e] = idx;
            self.rb_tn[e]  = ty_name;
            return;
        }
        if self.rb_n >= EL_TY_CAP() { self.note_overflow(owner, col); return; }
        self.rb_var[self.rb_n]  = owner;
        self.rb_col[self.rb_n]  = col;
        self.rb_idx[self.rb_n]  = idx;
        self.rb_tn[self.rb_n]   = ty_name;
        self.rb_kind[self.rb_n] = kind;
        self.rb_n = self.rb_n + 1i64;
    }

    /// THE binding lookup — the entry index, or -1.
    fn find_col(self: &ElTypes, kind: i64, owner: str, col: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.rb_n {
            if self.rb_kind[i] == kind && str_eq(self.rb_var[i], owner)
               && str_eq(self.rb_col[i], col) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }

    /// Bind (var, col) → the NAMED FIELD `var.col` of declared type `ty_name` —
    /// what a STRUCT source's row var offers. The flat dict cannot key this: two
    /// joined structs declaring the same field name overwrite each other there,
    /// and the surviving type was applied to BOTH.
    pub fn field_bind_named(self: &mut ElTypes, var: str, col: str, ty_name: str) {
        self.bind_col(CB_VAR(), var, col, COL_FIELD(), ty_name);
    }

    /// Bind (STRUCT TYPE, col) → the field's declared type. What a NESTED path
    /// resolves against: `a.b.c` has no row var of its own, but `a.b`'s type is a
    /// struct NAME, and that name plus `c` is a key as precise as (var, col).
    pub fn type_bind_named(self: &mut ElTypes, ty_of: str, col: str, ty_name: str) {
        self.bind_col(CB_TYPE(), ty_of, col, COL_FIELD(), ty_name);
    }

    /// The declared type NAME of field `col` of STRUCT `ty_of`, or "".
    pub fn type_col_ty_name(self: &ElTypes, ty_of: str, col: str) -> str {
        let e: i64 = self.find_col(CB_TYPE(), ty_of, col);
        if e < 0i64 { return ""; }
        return self.rb_tn[e];
    }

    /// True iff struct `ty_of`'s fields have already been stamped — the guard
    /// that terminates the reflection walk on a self-referential schema.
    pub fn type_stamped(self: &ElTypes, ty_of: str) -> bool {
        let mut i: i64 = 0i64;
        while i < self.rb_n {
            if self.rb_kind[i] == CB_TYPE() && str_eq(self.rb_var[i], ty_of) { return true; }
            i = i + 1i64;
        }
        return false;
    }

    /// The declared type NAME of `var.col`, or "" when this is not a rel binding.
    pub fn rel_col_ty_name(self: &ElTypes, var: str, col: str) -> str {
        let e: i64 = self.find_col(CB_VAR(), var, col);
        if e < 0i64 { return ""; }
        return self.rb_tn[e];
    }

    // The ACCESS code of `var.col` (`COL_*` or a tuple index), or `COL_WHOLE`
    // when unbound — meaningless unless `rel_col_ty` has said the pair is bound.
    pub fn rel_col_of(self: &ElTypes, var: str, col: str) -> i64 {
        let e: i64 = self.find_col(CB_VAR(), var, col);
        if e < 0i64 { return -1i64; }
        return self.rb_idx[e];
    }

    // The EL value-type of `var.col`, or -1 (not a rel binding) — the class VIEW
    // of the bound type, and also the existence test the callers use.
    pub fn rel_col_ty(self: &ElTypes, var: str, col: str) -> i32 {
        let e: i64 = self.find_col(CB_VAR(), var, col);
        if e < 0i64 { return -1i32; }
        return el_ty_of_name(self.rb_tn[e]);
    }

    // True iff `var` is a rel-bound row var (any column bound under it).
    pub fn rel_var_bound(self: &ElTypes, var: str) -> bool {
        let mut i: i64 = 0i64;
        while i < self.rb_n {
            if self.rb_kind[i] == CB_VAR() && str_eq(self.rb_var[i], var) { return true; }
            i = i + 1i64;
        }
        return false;
    }
}
