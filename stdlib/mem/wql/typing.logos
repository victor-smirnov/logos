// logos.std.wql.typing — ONE typing of a clause's variables (ADR 0031).
//
// Every emitter used to assemble its `ElTypes` by hand — the base's schema and
// registry columns, each step's, a by-value element's own type, the scalar
// parameters, the comprehension variables, the module's UDFs — seven copies of
// one sequence. `type_chain` is that sequence, once; the helpers it calls moved
// here from the emitter so the planner can type a clause too.
package logos.std.wql.typing;

use logos.std.compiler.metaprog;  // OView
use logos.lang.writ.anyval;
use logos.lang.str;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.std.wql.ir;             // SExpr, RExpr
use logos.std.wql.el;             // ElTypes
use logos.std.wql.params;         // MacroParams
use logos.std.wql.core;           // CProgram, CClause, CLit (ADR 0031 R4.0)
use logos.std.wql.reflect;        // stamp_types_from_schema, resolve_alias_name, stamp_udfs_from_module

// Shared: when `src_name` names a REL (slice B — the emitted `__rel_<r>_sl`
// source, resolved against the MacroParams rel registry), stamp its COLUMN
// value-types into the flat dict AND bind (var, col) → tuple-component-index
// entries so `emit_sexpr`/`infer_ty` emit the positional `var.k` access with
// the right type. A non-rel source is a no-op (returns false). This is the
// rel counterpart of `stamp_types_from_schema` — called right beside it at
// every scan-source stamping site.
//
// ⚠ `view` IS HERE FOR THE SAME REASON IT IS IN `stamp_types_from_schema`: a
// declared type NAME is a SPELLING until it is resolved through the module's
// aliases, and `el` — which answers every question asked about it — holds no
// module view. Every name recorded on an `ElTypes` goes through
// `reflect::resolve_alias_name` at the point it is read, so a rel column declared
// `Score` is an i64 to the licence, the width check and the lattice alike.
pub fn stamp_rel_source(ty: &mut ElTypes, view: &OView, prm: &MacroParams,
                        src_name: str, var_name: str) -> bool {
    let ri: i64 = prm.rel_find_src(src_name);
    if ri < 0i64 { return false; }
    return stamp_rel_columns(ty, view, prm, ri, var_name);
}

/// The same stamping, by rel INDEX. The planner reaches a rel before its
/// source name has been written onto the query node, so it has the index and
/// not the name; splitting the lookup off the stamping is what lets one copy of
/// the column binding serve both.
pub fn stamp_rel_columns(ty: &mut ElTypes, view: &OView, prm: &MacroParams,
                         ri: i64, var_name: str) -> bool {
    if ri < 0i64 { return false; }
    let off: i64 = prm.rel_coff[ri];
    let nc: i64  = prm.rel_ccnt[ri];
    if nc == 1i64 {
        // 1-column rel: SCALAR rows (`Vec<i64>` etc. — no 1-tuple exists), so
        // the column binds the WHOLE row (idx -1 → the codegen emits `(*var)`).
        let cn0: str = prm.relc_name[off];
        // The column's DECLARED type, which for a native source came from the
        // impl's trait args (ADR 0024 S2/S3) — not just its four-value class.
        let tn0: str = resolve_alias_name(view, prm.relc_ty[off]);
        ty.set_ty_named(cn0, tn0);
        ty.rel_bind_named(var_name, cn0, COL_WHOLE(), tn0);
        return true;
    }
    let mut k: i64 = 0i64;
    while k < nc {
        let cn: str = prm.relc_name[off + k];
        let tnk: str = resolve_alias_name(view, prm.relc_ty[off + k]);
        ty.set_ty_named(cn, tnk);
        ty.rel_bind_named(var_name, cn, k, tnk);
        k = k + 1i64;
    }
    return true;
}

// Shared: seed the type dict with each SCALAR param's declared value-type off
// the parsed `deem!(…)` list — the replacement for the retired `with` overlay.
// Slice params are SOURCES (their row schemas are reflected separately); a
// scalar param referenced BARE in EL (`e.salary > min_sal`, `limit n`) types
// through this seeding — resolved through the module's aliases first, for the
// reason stated on `stamp_rel_source`.
pub fn apply_scalar_params(ty: &mut ElTypes, view: &OView, prm: &MacroParams) {
    let mut i: i64 = 0i64;
    while i < prm.n {
        if !prm.is_slice[i] {
            ty.set_ty_named(prm.names[i], resolve_alias_name(view, prm.tys[i]));
        }
        i = i + 1i64;
    }
}

/// A comprehension's loop variable has the ELEMENT type of the slice it ranges
/// over (`n` in `[n * 2 for n in nums]` with `nums: &[u8]` is a `u8`). Slice
/// params are not in the binding table (only scalar ones are), so without this
/// the variable typed as the `i64` baseline and the head's arithmetic with it
/// (E4.4). Recorded in the same table the emitter reads.
pub fn stamp_comp_vars(e: SExpr, ty: &mut ElTypes, prm: &MacroParams) {
    match e {
        SExpr::Comp(cp) => {
            let mut src: str = "";
            match cp.plan_expr() {
                RExpr::Scan(sc) => { src = sc.src_name; }
                RExpr::Filter(fl) => {
                    match fl.input_expr() {
                        RExpr::Scan(sc2) => { src = sc2.src_name; }
                        _ => { }
                    }
                }
                _ => { }
            }
            let pi: i64 = prm.index_of(src);
            if pi >= 0i64 && prm.is_slice[pi] { ty.set_ty_named(cp.var, prm.tys[pi]); }
            stamp_comp_vars(cp.head_expr(), ty, prm);
        }
        _ => { }
    }
}

/// The variables of a chain — the base, then each step (a by-value element
/// typed as its own type) — the scalar parameters, the comprehension variables
/// of `comp_sel` (null = none), and the module's UDFs.
pub fn type_chain(view: &OView, prm: &MacroParams, base_src: str, base_ty: str, base_var: str,
                  srcs: &Vec<str>, tys: &Vec<str>, vars: &Vec<str>, byval: &Vec<bool>, n: i64,
                  comp_sel: WAny) -> ElTypes {
    let mut ty: ElTypes = el_types_new();
    stamp_types_from_schema(view, &mut ty, base_ty, base_var);
    stamp_rel_source(&mut ty, view, prm, base_src, base_var);
    let mut si: i64 = 0i64;
    while si < n {
        stamp_types_from_schema(view, &mut ty, tys.get(si), vars.get(si));
        stamp_rel_source(&mut ty, view, prm, srcs.get(si), vars.get(si));
        if byval.get(si) { ty.set_ty_named(vars.get(si), resolve_alias_name(view, tys.get(si))); }
        si = si + 1i64;
    }
    apply_scalar_params(&mut ty, view, prm);
    if !comp_sel.is_null() { stamp_comp_vars(comp_sel.view::<SExpr>(), &mut ty, prm); }
    stamp_udfs_from_module(view, &mut ty);
    return ty;
}

// ── ADR 0031 R4.0 — atoms resolved and typed from the DECLARATIONS ──────────
//
// The walker stamps every source of the parse tree (`resolve_source`,
// `stamp_edge_step`) and the planned core read those stamps back. Everything a
// stamp says is a function of the declarations — the parameter list, the rel
// registry, the module's struct declarations — so it is computed here, on the
// core, once the registry is complete and before the planner's first pass.
// What it does NOT do is diagnose: a source this cannot resolve stays as
// lowered, and the walker's resolution reports it.

/// One atom: a slice parameter takes its element type; a rel (a program rel
/// or a native source, by name or by its emitted name) takes its registry
/// index and row type.
fn resolve_atom(a: &mut CAtom, nrels: i64, prm: &MacroParams) {
    let n: str = a.name;
    if n.len() == 0i64 { return; }
    let pi: i64 = prm.index_of(n);
    if pi >= 0i64 && prm.is_slice[pi] {
        a.reg = -1i64;
        a.row_ty = prm.tys[pi];
        return;
    }
    let mut ri: i64 = prm.rel_find_name(n);
    if ri < 0i64 { ri = prm.rel_find_src(n); }
    if ri < 0i64 { return; }
    // The atom keeps the name as WRITTEN: the spelling the emitter scans is
    // the plan's (a streamed native rel binds `__rel_<r>`, not `__rel_<r>_sl`,
    // and the access plan decides that after this runs) — `atom_src` reads it.
    a.reg = ri;
    a.row_ty = string_as_str(&prm.rel_rowty[ri]);
    a.src = if ri < nrels { CSrc::Rel(ri) } else { CSrc::Param(n) };
}

/// One traversal: the element type along the path from the base variable's
/// row type, and the source expression the emitters scan (`d.emps`, a Vec
/// field through `.as_slice()`). `bvars`/`btys` — the variables bound before
/// it and their row types.
fn resolve_trav(t: &mut CTrav, bvars: &Vec<str>, btys: &Vec<str>, view: &OView, strs: &mut Vec<String>) {
    let mut cur: str = "";
    let mut found: bool = false;
    let mut k: i64 = 0i64;
    while k < bvars.len() {
        if str_eq(bvars.get(k), t.base) { cur = btys.get(k); found = true; }
        k = k + 1i64;
    }
    let np: i64 = t.path.len();
    if !found || np < 1i64 { return; }
    let mut kind: i32 = 0i32;
    let mut elem: str = "";
    let mut i: i64 = 0i64;
    while i < np {
        let seg: str = t.path.get(i);
        let decl: WAny = find_struct_decl(view, cur);
        if decl.is_null() || !has_field(view, decl, seg) { return; }
        if i < np - 1i64 {
            cur = field_type_name(view, decl, seg);
            if cur.len() == 0i64 { return; }
        } else {
            elem = field_traversal_elem(view, decl, seg);
            if elem.len() == 0i64 { return; }
            kind = field_traversal_kind(view, decl, seg);
        }
        i = i + 1i64;
    }
    let mut buf: String = String::new();
    buf.push_str(t.base);
    let mut j: i64 = 0i64;
    while j < np { buf.push_str("."); buf.push_str(t.path.get(j)); j = j + 1i64; }
    if kind == 1i32 { buf.push_str(".as_slice()"); }
    // The String's heap buffer does not move when `strs` grows, so the view
    // stays valid for the program's life; built raw so it does not hold `strs`.
    let bp: *const u8 = buf.as_ptr();
    let bn: i64 = buf.len();
    strs.push(buf);
    t.name = unsafe { str_from_raw(bp, bn) };
    t.row_ty = elem;
}

fn resolve_clause(cl: &mut CClause, nrels: i64, view: &OView, prm: &MacroParams, strs: &mut Vec<String>) {
    let mut bvars: Vec<str> = Vec::<str>::new();
    let mut btys: Vec<str> = Vec::<str>::new();
    let mut i: i64 = 0i64;
    while i < cl.body.len() {
        match &mut cl.body[i] {
            CLit::Atom(a) => {
                resolve_atom(a, nrels, prm);
                if !a.neg { bvars.push(a.var); btys.push(a.row_ty); }
            }
            CLit::Trav(t) => {
                resolve_trav(t, &bvars, &btys, view, strs);
                if !t.neg { bvars.push(t.var); btys.push(t.row_ty); }
            }
            CLit::Cond(_c) => { }
        }
        i = i + 1i64;
    }
}

/// Resolve and type every atom and traversal of `p` from the declarations.
pub fn core_resolve(p: &mut CProgram, view: &OView, prm: &MacroParams) {
    let nrels: i64 = p.rels.len();
    let mut strs: Vec<String> = Vec::<String>::new();
    let mut r: i64 = 0i64;
    while r < nrels {
        let mut b: i64 = 0i64;
        while b < p.rels[r].rules.len() {
            resolve_clause(&mut p.rels[r].rules[b].clause, nrels, view, prm, &mut strs);
            b = b + 1i64;
        }
        r = r + 1i64;
    }
    resolve_clause(&mut p.entry.clause, nrels, view, prm, &mut strs);
    while strs.len() > 0i64 { p.strs.push(strs.remove(0i64)); }
}

/// The source an atom scans as the plan spells it: a rel's CURRENT emitted
/// name in the registry, a parameter's own.
pub fn atom_src<'a>(prm: &'a MacroParams, a: &'a CAtom) -> &'a str {
    if a.reg >= 0i64 { return string_as_str(&prm.rel_srcs[a.reg]); }
    return a.name;
}

// SHADOW (R4.0 step 2): the resolution must agree with the walker's stamping,
// literal by literal; a disagreement is an ICE naming the first one.
fn shadow_ice(what: str, a: str, b: str) {
    let mut m: String = String::new();
    m.push_str("ICE: deem core_resolve disagrees with the walker's stamping: ");
    m.push_str(what);
    m.push_str(": declarations `");
    m.push_str(a);
    m.push_str("`, stamped `");
    m.push_str(b);
    m.push_str("`");
    logos.lang.panic::panic(string_as_str(&m));
}

fn shadow_clause(x: &CClause, y: &CClause, prm: &MacroParams) {
    if x.body.len() != y.body.len() { shadow_ice("literal count", "", ""); }
    let xs: &[CLit] = x.body.as_slice();
    let ys: &[CLit] = y.body.as_slice();
    let mut i: i64 = 0i64;
    while i < x.body.len() {
        match &xs[i] {
            CLit::Atom(a) => {
                match &ys[i] {
                    CLit::Atom(b) => {
                        if !str_eq(atom_src(prm, a), b.name) { shadow_ice("atom name", atom_src(prm, a), b.name); }
                        if !str_eq(a.row_ty, b.row_ty) { shadow_ice("atom row type", a.row_ty, b.row_ty); }
                        if a.reg != b.reg { shadow_ice("atom registry index", a.name, b.name); }
                        let sa: i64 = match &a.src { CSrc::Rel(r) => *r, CSrc::Param(_n) => -2i64, CSrc::Unit => -3i64 };
                        let sb: i64 = match &b.src { CSrc::Rel(r2) => *r2, CSrc::Param(_n2) => -2i64, CSrc::Unit => -3i64 };
                        if sa != sb { shadow_ice("atom source kind", a.name, b.name); }
                    }
                    _ => { shadow_ice("literal kind", "atom", ""); }
                }
            }
            CLit::Trav(t) => {
                match &ys[i] {
                    CLit::Trav(u) => {
                        if !str_eq(t.name, u.name) { shadow_ice("traversal source", t.name, u.name); }
                        if !str_eq(t.row_ty, u.row_ty) { shadow_ice("traversal row type", t.row_ty, u.row_ty); }
                    }
                    _ => { shadow_ice("literal kind", "traversal", ""); }
                }
            }
            CLit::Cond(_c) => { }
        }
        i = i + 1i64;
    }
}

pub fn core_resolve_shadow(x: &CProgram, y: &CProgram, prm: &MacroParams) {
    if x.rels.len() != y.rels.len() { shadow_ice("rel count", "", ""); }
    let xr: &[CRel] = x.rels.as_slice();
    let yr: &[CRel] = y.rels.as_slice();
    let mut r: i64 = 0i64;
    while r < x.rels.len() {
        if xr[r].rules.len() != yr[r].rules.len() { shadow_ice("rule count", xr[r].name, yr[r].name); }
        let xs: &[CRule] = xr[r].rules.as_slice();
        let ys: &[CRule] = yr[r].rules.as_slice();
        let mut b: i64 = 0i64;
        while b < xr[r].rules.len() { shadow_clause(&xs[b].clause, &ys[b].clause, prm); b = b + 1i64; }
        r = r + 1i64;
    }
    shadow_clause(&x.entry.clause, &y.entry.clause, prm);
}
