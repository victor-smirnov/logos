// logos.std.wql.rexpr_walk — the UNIFIED relational-algebra layer (ADR 0012
// Phase 2 consolidation). Two responsibilities, both making `RExpr` the REAL
// executable algebra (resolving the RQuery-vs-RExpr duplication):
//
//   1. `lower_rquery_to_rexpr(RQuery, &Writ) -> WRef<RExpr>` — build a REAL
//      `RExpr` tree from the surface query PLAN (`logos.std.wql.plan`):
//        • simple    → RProj( RFilter?( RScan ), select )
//        • join/anti → RProj( RFilter?( RJoin|RAnti( RScan, RScan, on ) ), select )
//        • aggregate → RProj( RAggr( RFilter?( RScan ), key, aggSpecs ), select )
//      RFilter is DROPPED when there is no `where`. The embedded clause bodies
//      (where / select / on / group-key / aggregate-arg) stay `WRef<SExpr>`
//      edges — the exact edge primitive the plan carries; the lowering just
//      re-parents them onto the algebra nodes.
//
//   2. `emit_rexpr(...)` — ONE walker (`match` over `RExpr`) that emits the SAME
//      native source shape the per-shape `plan_walker` emitters produced (scan/
//      filter/project loop; nested-loop [anti-]join; two-pass group-by). The
//      wql! handler routes `parse → RQuery → lower_rquery_to_rexpr → simplify
//      (Phase-1, on the embedded SExpr edges) → emit_rexpr`.
//
// The fn envelope (name, the VERBATIM `deem!(…)` param list, result-type
// inference) rides beside the RExpr tree — `RScan` carries the source binding
// (name + row-type + loop var) and `RProj.sel` the projection. The generated fn
// SIGNATURE is `pub fn <name>(<params verbatim>) -> Ret` (the trama! model);
// scalar params are typed into ElTypes off the parsed param list (MacroParams).
// The scalar clauses reuse `codegen.logos` (emit_sexpr / infer_ty / reflection):
// ONE lowering, SExpr schema → Logos source text.
//
// SCHEMA MANDATE: consumes/produces ONLY Writ schema views (RQuery / RExpr /
// RAgg + the WRef edges). No plain Logos structs for algebra nodes.
package logos.std.wql.rexpr_walk;

use logos.std.compiler.metaprog;  // quote_item!/quote_block!, Ident, ExprBlob, parse_*, error, OView
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;
use logos.std.wql.ir;
use logos.std.wql.plan;
use logos.std.wql.el;         // ElTypes, el_types_new, el_ty_of_name, EL_TY_*
use logos.std.wql.params;     // MacroParams — the parsed deem!(…) param list
use logos.std.wql.codegen;    // emit_sexpr / infer_ty / el_ty_name / …
use logos.std.wql.optimize;   // simplify_sexpr + TermList/split_and_terms/refs_mask (shared IR-level analysis)
use logos.std.wql.join_sel;   // JS_* / StepSel / step_terms / decide_join_step — THE join-step decision
use logos.std.wql.join_order; // JoinOrder / decide_join_orders / JCh — WHICH ORDER DRIVES
use logos.std.wql.join_cost;  // JCTable / jc_* — THE cost function, one copy
use logos.std.wql.prepared;   // Prepared / prep_* — THE PLAN AS A RUNTIME VALUE
use logos.std.wql.why;        // Why / why_render — THE JUSTIFICATION AS A RECORD, and its ONE renderer
use logos.mem.collections.vec;  // Vec<Ident> — a quote's runtime-sized import list
use logos.std.wql.lower;      // lower_rquery_to_rexpr + make_*/null_* (the metaprog-free PLAN→ALGEBRA lowering)
use logos.std.wql.reflect;    // stamp_types_from_schema
use logos.mem.string;
use logos.lang.str;

// ── Aggregate fn ids (mirror plan_walker) ────────────────────────────────────
pub fn AGG_COUNT() -> i32 { return 1i32; }
pub fn AGG_SUM()   -> i32 { return 2i32; }
pub fn AGG_MIN()   -> i32 { return 3i32; }
pub fn AGG_MAX()   -> i32 { return 4i32; }
pub fn AGG_AVG()   -> i32 { return 5i32; }

// The algebraic-structure class of an aggregate — the load-bearing column that
// decides in-fixpoint admissibility (recursive-aggregation design §1):
//   • SEMILATTICE (min/max) — idempotent meet/join; the absorb gate IS the
//     lattice order, so a recursive head stays monotone ⇒ fixpoint-SAFE.
//   • GROUP (sum/count/avg) — abelian group; the very inverse that makes it
//     O(1)-incremental breaks fixpoint monotonicity (counting paths in a cycle
//     diverges) ⇒ recursion is a NAMED compile error; stratified-only.
// Defaults to GROUP/unknown for any unclassified id — reject-in-recursion, never
// default-allow (design §7 critique #1).
pub fn AGG_CLASS_SEMILATTICE() -> i32 { return 1i32; }
pub fn AGG_CLASS_GROUP()       -> i32 { return 2i32; }
pub fn agg_algebra(fnid: i32) -> i32 {
    if fnid == AGG_MIN() || fnid == AGG_MAX() { return AGG_CLASS_SEMILATTICE(); }
    return AGG_CLASS_GROUP();
}

pub fn agg_of_name(name: str) -> i32 {
    if str_eq(name, "count") { return AGG_COUNT(); }
    if str_eq(name, "sum")   { return AGG_SUM(); }
    if str_eq(name, "min")   { return AGG_MIN(); }
    if str_eq(name, "max")   { return AGG_MAX(); }
    if str_eq(name, "avg")   { return AGG_AVG(); }
    return 0i32;
}

// ── SELECT-MODE ids — the single-row emit-envelope modes ────────────────────
// `first`/`find` are NOT algebra nodes: they change the generated fn's RETURN
// TYPE (Vec<E> → Option<E> / Option<&Row>) + the loop's exit discipline (early
// return on the first hit), so they ride on the emit ENVELOPE next to
// fn_name/result_ty. The relational tree is unchanged (the same RProj/RFilter/
// RScan shape), which keeps every Phase-3 peephole (empty/identity) applicable.
//   SELM_ALL   — multi-row (Vec) — the default;
//   SELM_FIRST — `select first S` → Option<ElemTy>, first projected value;
//   SELM_FIND  — `find P`         → Option<&Row>, borrow of the first match.
pub fn SELM_ALL()   -> i32 { return 0i32; }
pub fn SELM_FIRST() -> i32 { return 1i32; }
pub fn SELM_FIND()  -> i32 { return 2i32; }

// ══════════════════════════════════════════════════════════════════════════
// PART 1 — lower_rquery_to_rexpr : surface PLAN → real RExpr algebra
// ══════════════════════════════════════════════════════════════════════════

// The full PLAN → RExpr → simplify → emit pipeline (Phase 3): LOWER the surface
// plan to the RExpr algebra, run the RELATIONAL peephole pass `simplify_rexpr`
// (filter folding, identity-projection collapse, projection composition) with
// the embedded scalar clauses const-folded inside it, then EMIT the (possibly
// thinner) form. `fn_name` / `result_ty` come off the surface plan envelope;
// `params_text` is the RAW `deem!(…)` paren text (re-emitted VERBATIM as the
// generated fn signature) and `prm` its parsed form (scalar-param typing +
// limit-param validation); the relational STRUCTURE + clause bodies live on
// the RExpr tree.
// `prelude` — statements spliced right after the generated fn's opening brace
// ("" when absent). The wql! REL path (slice B) uses it to materialize the
// derived relations (`let __rel_X: Vec<Row> = __wql_<fn>_rel_X(…); let
// __rel_X_sl: &[Row] = __rel_X.as_slice();`) before the entry query's loops.
pub fn lower_simplify_emit(plan: RQuery, fn_name: str,
                           params_text: str, prm: &MacroParams,
                           result_ty: str, has_result_ty: bool,
                           sel_mode: i32, prelude: str, h: &Writ) -> bool {
    let root: WRef<RExpr> = lower_rquery_to_rexpr(plan, h);
    let sig: RSimplified = simplify_rexpr_ref(root, root.any().view::<RExpr>(), h);
    let rx: RExpr = sig.root.any().view::<RExpr>();
    return emit_rexpr_opt(rx, sig.empty, sig.identity,
                          fn_name, params_text, prm, result_ty, has_result_ty, sel_mode, prelude, h);
}

// ══════════════════════════════════════════════════════════════════════════
// PART 2 — emit_rexpr : the ONE walker (RExpr → native source)
// ══════════════════════════════════════════════════════════════════════════

// Shared: when `src_name` names a REL (slice B — the emitted `__rel_<r>_sl`
// source, resolved against the MacroParams rel registry), stamp its COLUMN
// value-types into the flat dict AND bind (var, col) → tuple-component-index
// entries so `emit_sexpr`/`infer_ty` emit the positional `var.k` access with
// the right type. A non-rel source is a no-op (returns false). This is the
// rel counterpart of `stamp_types_from_schema` — called right beside it at
// every scan-source stamping site.
//
// ⚠ `view` IS HERE FOR THE SAME REASON IT IS IN `stamp_types_from_schema`: a
// declared type NAME is a SPELLING until it is resolved through the module's
// aliases, and `el` — which answers every question asked about it — holds no
// module view. Every name recorded on an `ElTypes` goes through
// `reflect::resolve_alias_name` at the point it is read, so a rel column declared
// `Score` is an i64 to the licence, the width check and the lattice alike.
pub fn stamp_rel_source(ty: &mut ElTypes, view: &OView, prm: &MacroParams,
                        src_name: str, var_name: str) -> bool {
    let ri: i64 = prm.rel_find_src(src_name);
    if ri < 0i64 { return false; }
    return stamp_rel_columns(ty, view, prm, ri, var_name);
}

/// The same stamping, by rel INDEX. The planner reaches a rel before its
/// source name has been written onto the query node, so it has the index and
/// not the name; splitting the lookup off the stamping is what lets one copy of
/// the column binding serve both.
pub fn stamp_rel_columns(ty: &mut ElTypes, view: &OView, prm: &MacroParams,
                         ri: i64, var_name: str) -> bool {
    if ri < 0i64 { return false; }
    let off: i64 = prm.rel_coff[ri];
    let nc: i64  = prm.rel_ccnt[ri];
    if nc == 1i64 {
        // 1-column rel: SCALAR rows (`Vec<i64>` etc. — no 1-tuple exists), so
        // the column binds the WHOLE row (idx -1 → the codegen emits `(*var)`).
        let cn0: str = prm.relc_name[off];
        // The column's DECLARED type, which for a native source came from the
        // impl's trait args (ADR 0024 S2/S3) — not just its four-value class.
        let tn0: str = resolve_alias_name(view, prm.relc_ty[off]);
        ty.set_ty_named(cn0, tn0);
        ty.rel_bind_named(var_name, cn0, COL_WHOLE(), tn0);
        report_ty_overflow(ty);
        return true;
    }
    let mut k: i64 = 0i64;
    while k < nc {
        let cn: str = prm.relc_name[off + k];
        let tnk: str = resolve_alias_name(view, prm.relc_ty[off + k]);
        ty.set_ty_named(cn, tnk);
        ty.rel_bind_named(var_name, cn, k, tnk);
        k = k + 1i64;
    }
    report_ty_overflow(ty);
    return true;
}

// Shared: seed the type dict with each SCALAR param's declared value-type off
// the parsed `deem!(…)` list — the replacement for the retired `with` overlay.
// Slice params are SOURCES (their row schemas are reflected separately); a
// scalar param referenced BARE in EL (`e.salary > min_sal`, `limit n`) types
// through this seeding — resolved through the module's aliases first, for the
// reason stated on `stamp_rel_source`.
pub fn apply_scalar_params(ty: &mut ElTypes, view: &OView, prm: &MacroParams) {
    let mut i: i64 = 0i64;
    while i < prm.n {
        if !prm.is_slice[i] {
            ty.set_ty_named(prm.names[i], resolve_alias_name(view, prm.tys[i]));
        }
        i = i + 1i64;
    }
    report_ty_overflow(ty);
}

// Validate a `limit <ident>` reference: the ident must name a SCALAR param
// declared in the deem!(…) list. Surfaces an `error` (build failure) otherwise.
fn check_limit_param(mods: &QMods, prm: &MacroParams) -> bool {
    if !mods.has_limit { return true; }
    if !mods.limit_is_param {
        // Literal limit: reject an out-of-range value (tokenizer poison i64::MIN).
        if mods.limit_n == el_lit_poison() {
            error("wql!: `limit` integer literal out of range — exceeds i64::MAX (9223372036854775807)");
            return false;
        }
        return true;
    }
    if prm.is_scalar(mods.limit_param) { return true; }
    error("wql!: `limit <ident>` must name a scalar (i64) parameter declared in the deem!(…) parameter list");
    return false;
}

// Emit the generated fn signature head: `pub fn <name><tps>(<params verbatim>`.
// The paren text is the REAL Logos parameter list from the deem!(…) surface —
// the compiler parses + type-checks it when the emitted chunk compiles, and
// the generated-fn param ORDER is the paren-list order, verbatim.
// ADR 0016: a leading `-` on fn_name (vis_is_priv, params.logos) marks a
// NON-pub generated fn — a private mapping rel; the marker is consumed here.
// `tps` is the item's type-param list, also verbatim (`<V: Bound>`, "" for a
// concrete query): a generic `deem` puts it on EVERY head it emits, and the
// calls between those fns infer their args from the source param.
// ── the generated fn, as a QUOTE (ADR 0024 S5) ────────────────────────────
//
// Every emitter produces the same ITEM shape — visibility, name, generics,
// parameters, return type, body — and differs only in the body, whose shape is
// a runtime value. So the shell is written ONCE, here, and an emitter hands it
// five fragments, the body among them.
//
// ⚠ TWO variants, not a `pub(#v)` antiquote: a private fn has no visibility
// node at all, so there is nothing for an antiquote to substitute into. Deem
// already carries the marker — a leading `-` on the fn name.
//
// ⚠ The RETURN TYPE arrives as ONE fragment, not as a template with holes.
// `Result<Option<X>, ElError>` and `Result<Vec<X>, ElError>` are two strings an
// emitter already knows how to build; parsing the whole thing keeps this to one
// quote shape instead of one per result flavour.
//
// (A `str`-body overload lived here, reifying a body with `parse_block`. It has
// no callers: every emitter in this file, the four constant-body peepholes
// included, now hands over a fragment it BUILT. A text overload is the seam a
// new text body would come back through, so it is gone rather than unused.)
fn emit_fn_quote_blob(fn_name: str, params_text: str, tps: str, ret_ty: str,
                      body: ExprBlob, prm: &MacroParams) {
    // The imports a native source's materializer needs are a RUNTIME list —
    // one module per source the query binds — carried by a repeat rather than
    // by a row of slots sized for the worst case.
    let mut uses: Vec<Ident> = vec_new::<Ident>();
    let mut uk: i64 = 0i64;
    loop {
        let um: str = prm.native_use_at(uk);
        if um.len() == 0i64 { break; }
        uses.push(Ident::new(um));
        uk = uk + 1i64;
    }
    let nm: Ident      = Ident::new(vis_strip(fn_name));
    let ps: ExprBlob   = parse_params(params_text);
    let tp: ExprBlob   = parse_type_params(tps);
    let rt: ExprBlob   = parse_type(ret_ty);
    if vis_is_priv(fn_name) {
        let q: QuoteItemBlob = quote_item! {
            use logos.mem.string; use logos.mem.collections.vec; use logos.lang.option;
            use logos.mem.collections.hashmap; use logos.mem.collections.set;
            use logos.mem.collections.btree; use logos.lang.result;
            use logos.std.wql.el; use logos.lang.writ.container;
            use logos.std.wql.join_cost;
            // `f64_data_key` / `f32_data_key` — the sort's comparator for a
            // float key (see key_ord_frag). A spliced item is its own AST doc
            // and inherits none of the trigger module's imports.
            use logos.lang.num.float;
            #( use #uses; )*
            fn #nm #(tp) (#(ps)) -> #(rt) #(body)
        };
        unsafe { logos_emit_item_blob_subst(&q); }
    } else {
        let q: QuoteItemBlob = quote_item! {
            use logos.mem.string; use logos.mem.collections.vec; use logos.lang.option;
            use logos.mem.collections.hashmap; use logos.mem.collections.set;
            use logos.mem.collections.btree; use logos.lang.result;
            use logos.std.wql.el; use logos.lang.writ.container;
            use logos.std.wql.join_cost;
            // `f64_data_key` / `f32_data_key` — the sort's comparator for a
            // float key (see key_ord_frag). A spliced item is its own AST doc
            // and inherits none of the trigger module's imports.
            use logos.lang.num.float;
            #( use #uses; )*
            pub fn #nm #(tp) (#(ps)) -> #(rt) #(body)
        };
        unsafe { logos_emit_item_blob_subst(&q); }
    }
}

// (`emit_fn_head` lived here — the hand-written `"fn "`/`"pub fn "` + name +
// generics + `"("` prefix every emitter used to open its item with. It has no
// callers: `emit_fn_quote_blob` above is the only thing in this file that
// writes a fn's HEAD, and it writes it as structure. Reintroducing a text head
// would reintroduce the class of failure this arc removed — a missing `>` or a stray
// space surfacing as a syntax error inside generated source, at a position no
// reader can use.)

// ── THE PREPARED SURFACE (ADR 0024 S4i) ──────────────────────────────────────
// The plan type and its methods. Non-generic ON PURPOSE even when the query is:
// a plan holds the DECISION and the numbers it rested on, never a row and never
// a source, so nothing in it is parameterized by the query's element types —
// which is also what lets `_run` take it beside sources it knows nothing about.
//
// `agrees` is EXPLAIN addressed to the program. It asks the question a caller
// actually has ("is the plan I am holding still the right one for this data?")
// and it answers from THIS plan's decision against the OTHER's facts, so the
// rule lives in exactly one place — the emitted `prepare` — and the check cannot
// drift from the choice. A plan with no run-time decision agrees with everything,
// because there was nothing about the data for it to be wrong about.
//
// `margin` is what the facts are FOR beyond the answer: the distance to the flip.
// A plan decided on 1000-vs-999 is right and fragile; one decided on 10-vs-10000
// is right and robust, and only the numbers say which.
//
// ── THE TWO DECISION POINTS ON ONE OBJECT (ADR 0024 S4j) ─────────────────────
// `defer_order` is the DEFERRED half: the plan holds the rule but not the answer,
// because the two numbers only become free inside `run` (past the prelude's
// unavoidable materializations, before the join's index). It is a separate field
// from `dyn_order` and not a third value of it, because the two say different
// things to a caller — `dyn_order` means "I decided, and here are the facts I
// decided on"; `defer_order` means "this is decided again on every call, and
// there is nothing here for you to re-check".
//
// ⚠ `agrees` AND `margin` COVER ONLY THE PREPARED HALF, and `settled` is what
// says so instead of leaving it silently true. A plan whose order is deferred
// agrees with every set of fresh facts — correctly, since none of them can make
// it stale — and a caller who read that as "my order is fixed" would be wrong.
// One accessor is cheaper than the misreading.
//
// ── THE ORDER SET (ADR 0024 S4k) ─────────────────────────────────────────────
// `swap` was a bit because the axis was a pair. It is not: `order_ix` names WHICH
// of the candidate orders the plan chose, `considered()` how many were carried, and
// `cost_of(ix)` what any one of them would have cost on the plan's own facts. That
// last one is the point — "on what ground did each loser lose" becomes a question
// the PROGRAM can answer, not a sentence the compiler printed once and threw away.
// `swap` stays as `order_ix == 1`, which for a two-candidate plan is exactly what
// it always meant.
//
// ⚠ THE COST FUNCTION IS NOT HERE AND NOT PER QUERY. It is
// `logos.std.wql.join_cost::jc_order_cost`, one stdlib function that interprets the
// `JCTable` a plan carries; every method below delegates to it and so does the
// emitted `prepare`. Emitting the arithmetic per query would have been the same rule
// spelled once per query — N chances to drift from the account the trace gives, in
// the place where drift is silent.
//
// ── WHAT THIS SURFACE ANSWERS ON A DEFERRED PLAN (ADR 0024 S4m) ──────────────
// S4k added `order_ix` and `cost_of` and did not ask what they say about the half
// S4j had just deferred. They answered — confidently, in the prepared vocabulary,
// on a plan that measured nothing: `order_ix` 0 ("the query's own order won"),
// `cost_of(ix)` 0 for EVERY ix, because the plan's facts are -1 and `jc_cap` clamped
// each -1 to 0, so a caller re-deriving the decision read a tie and concluded order
// 0 — while the nest that ran was candidate 1 (measured, 2-row rel vs 5-row param).
//
// ⚠ A METHOD THAT ANSWERS OUTSIDE ITS DOMAIN IS A GATE THAT RETURNS 0 WHEN IT COULD
// NOT LOOK. So the domain is now visible in the ANSWERS and not only in `settled()`:
//
//   `proved()`  the CENSUS, on both shapes: how many orders the derivation proved
//               legal, carried or not. A compile-time constant, so it costs no
//               field and no store — and it is what stops `considered() == 0`
//               meaning both "the axis was never entered" and "entered, proved
//               eight, carried none" (ADR 0024 S4n).
//   `order_ix`  -1 on a deferred plan — no order is named, `run` names one
//   `cost_of`   `JC_NOFACT()` (-2), and -1 stays "there is no such candidate"
//   `margin`    `JC_NOFACT()`, from the same test inside `jc_margin`
//   `agrees`    unconditionally true, and `defer_not_held()` says why that is not
//               a claim about the order
//
// and NOT ONE OF THEM IS A BRANCH ON `defer_order` in the emitted method. `cost_of`
// and `margin` hand the plan's facts to the model and the MODEL refuses, because
// "-1 is not a size" is a statement about the cost function's inputs and belongs
// where the cost function is. The emitter's only contribution is writing -1 rather
// than 0 into `order_ix`, which is the same "not held" every fact field on that
// line already carries.
//
// ⚠ `base_n`/`step_n`/`n2`/`n3` ARE THE FACT TABLE, four wide because a plan holds
// facts for at most four floatable sources (`JC_MAX_FL`). The first two keep their
// pair-era names: they still mean the first and second source's size, and the
// fixtures that read them read the same numbers.
//
// ── A PLAN WITHOUT CANDIDATES CARRIES NO CANDIDATE TABLE (ADR 0024 S4l) ──────
// `has_tbl` is the emitter's own predicate: TRUE exactly when the derivation handed
// this query a table (`Prepared.tbl` non-empty — the prepared half and the deferred
// half both have one; `run` prices the deferred candidates through the plan). Where
// it is FALSE nothing was considered, and the plan used to say so by carrying 272
// bytes of zeros fetched by an out-of-line `jc_table_none()` — measured on
// `wql_prepared_plan_e2e::evens`: the direct fn's frame went 32 → 312 bytes and its
// call count 1 → 2 for a field it cannot read. 249 of the corpus's 266 `prepare`
// bodies were that case.
//
// So the field is CONDITIONAL and the four table questions still have answers, from
// `join_cost` itself (`jc_none_*`), where they are pinned equal to the general
// function applied to `jc_table_none()`. Nothing about the surface is conditional:
// both shapes carry the same ten-or-nine fields and the SAME TEN METHODS with the
// same signatures, so one loop over a caller's queries is still one loop.
//
// ⚠ THIS IS PER CALL, NOT PER ROW. The per-row body never touched `tbl`; what was
// paid was one plan construction per invocation — which is exactly what hurts a
// point-get query called in an application loop.
fn emit_prepared_type(tyn: str, is_priv: bool, has_tbl: bool, w: &Why, why_text: str) {
    let nm: Ident = Ident::new(tyn);
    // The census is a COMPILE-TIME number, so it is emitted as a constant-returning
    // method and not as a field: a plan pays nothing per call to carry it, which is
    // the same rule `has_tbl` follows for the table itself.
    let na: ExprBlob = i64_lit(w.nadm);
    let np: ExprBlob = i64_lit(w.nperm);
    // ── THE JUSTIFICATION, AS VALUES A PROGRAM READS (ADR 0024 S4o) ─────────
    // `axis()` / `ground()` / `operand()` / `refused(code)` are what stop a reader
    // having to PARSE `explain()` to learn what the decision rested on — and what
    // stop the census being one number that meant three things. Every one of them is
    // a compile-time constant emitted as a method body, so the plan gains no field,
    // `prepare` gains no store, and a query with no choice pays nothing for the
    // apparatus of justifying a choice (the finding `156ead4e` closed).
    let ax: ExprBlob = i32_lit(why_axis(w));
    let gr: ExprBlob = i32_lit(w.ground);
    let mut opb: String = String::new();
    push_str_lit(&mut opb, why_operand(w));
    let op: ExprBlob = parse_expr(string_as_str(&opb));
    let rf: ExprBlob = refused_body(w);
    // ── AND THE PROSE IS A CONSTANT TOO (ADR 0024 S4q) ──────────────────────
    // ⚠ IT USED TO BE A FIELD, AND THAT MADE EVERY CALLER PAY FOR IT. `prepare`
    // STORED the rendered justification into the plan, so the literal was reachable
    // from the constructor of every plan whether or not anything ever asked for it —
    // which is why `f5688fb8`'s claim that `--gc-sections` absorbed the growth could
    // not be true: the linker cannot drop a string a live constructor writes. Measured
    // at -O0 (the level the suite compiles at), on the LOADED IMAGE (`size`,
    // text+data+bss) rather than the file: that round cost +1168 bytes on
    // `wql_deferred_plan_e2e` and +784 on `wql_join_order_multi_e2e`, not the +8 it
    // asserted from total file size at -O2.
    //
    // ⚠ THE ANSWER IS NOT A SHORTER JUSTIFICATION. Victor's bar is a DL reasoner's
    // justification UX and the text is the deliverable; what was never a stated
    // design choice is that a caller who never asks should carry it. As a constant
    // returned BY `explain()` the text is byte-identical and always available, the
    // plan loses a `str` field (16 bytes per plan VALUE, per call), `prepare` loses a
    // store, and the literal is reachable only through `explain` — so a program that
    // does not explain its plans links none of it. `tests/logos/why_size_gate.sh`
    // measures that difference and fails if it stops holding.
    let mut wb: String = String::new();
    push_str_lit(&mut wb, why_text);
    let ex: ExprBlob = parse_expr(string_as_str(&wb));
    if !has_tbl {
        emit_prepared_type_no_tbl(tyn, is_priv, np, na, ax, gr, op, rf, ex);
        return;
    }
    if is_priv {
        let q: QuoteItemBlob = quote_item! {
            use logos.std.wql.join_cost;
            use logos.std.wql.why;
            struct #nm {
                pub dyn_order:   bool,
                pub defer_order: bool,
                pub swap:        bool,
                pub order_ix:    i64,
                pub base_n:      i64,
                pub step_n:      i64,
                pub n2:          i64,
                pub n3:          i64,
                pub tbl:         JCTable,
            }
            impl #nm {
                // ⚠ EVERY ONE OF THESE DELEGATES. The cost model is one function in
                // `logos.std.wql.join_cost`, so `agrees`, `margin`, `cost_of` and the
                // decision itself cannot come to different conclusions from the same
                // table — and the model is readable in one place instead of being
                // spelled once per emitted query.
                pub fn order_pick(&self, n0: i64, n1: i64, n2: i64, n3: i64) -> i64 {
                    return jc_order_pick(&self.tbl, n0, n1, n2, n3);
                }
                pub fn cost_of(&self, ix: i64) -> i64 {
                    return jc_order_cost(&self.tbl, ix, self.base_n, self.step_n, self.n2, self.n3);
                }
                pub fn considered(&self) -> i64 { return self.tbl.ncand; }
                // ⚠ THE SEARCH'S CENSUS, THE SAME TRIPLE THE TRACE PRINTS.
                // `enumerated()` how many permutations were walked, `proved()`
                // how many were proved LEGAL (carried or not), `considered()`
                // how many are carried as candidates. Three numbers because two
                // could not tell "the axis was never entered" (enumerated 0)
                // from "entered and admitted nothing" (enumerated > 0, proved 0)
                // — the conflation this replaces, one level down. Both are
                // compile-time constants: a plan pays no field and no store.
                pub fn enumerated(&self) -> i64 { return #(np); }
                pub fn proved(&self) -> i64 { return #(na); }
                // ⚠ THE CENSUS'S FIRST NUMBER, AND THE ONE A COUNT COULD NOT BE.
                // 0 the axis was never entered, 1 entered and refused BEFORE
                // enumeration, 2 searched. `enumerated()` is 0 in the first TWO,
                // which is exactly why "the order axis was never entered" was
                // asserted for 59 of 259 plans whose own ground said an anti join or
                // a traversal had refused them. `ground()` names the antecedent
                // (`why::WG_*`), `operand()` the value it failed on, `refused(code)`
                // how many permutations each `why::RJ_*` constraint turned down.
                pub fn axis(&self) -> i32 { return #(ax); }
                pub fn ground(&self) -> i32 { return #(gr); }
                pub fn operand(&self) -> str { return #(op); }
                pub fn refused(&self, code: i32) -> i64 { #(rf) }
                pub fn agrees(&self, fresh: &#nm) -> bool {
                    if !self.dyn_order { return true; }
                    return self.order_ix == self.order_pick(fresh.base_n, fresh.step_n, fresh.n2, fresh.n3);
                }
                // ⚠ NO EARLY RETURN, AND THAT IS THE WHOLE FIX. `if !self.dyn_order
                // { return 0 }` was the pair era's shorthand for "a plan with no
                // decision has no distance to a flip" — and a DEFERRED plan is also
                // `!dyn_order`, so it reported 0: "the runner-up costs the same",
                // which is a real answer and the wrong one. Every plan that reaches
                // THIS shape carries a table (`has_tbl`), so it is dynamic or
                // deferred and nothing else, and `jc_margin` distinguishes them from
                // the facts alone: a measured plan gets its distance, an unmeasured
                // one gets `JC_NOFACT()`. The model answers; this method does not
                // second-guess it.
                pub fn margin(&self) -> i64 {
                    return jc_margin(&self.tbl, self.order_ix, self.base_n, self.step_n, self.n2, self.n3);
                }
                pub fn settled(&self) -> bool { return !self.defer_order; }
                pub fn explain(&self) -> str { return #(ex); }
            }
        };
        unsafe { logos_emit_item_blob_subst(&q); }
    } else {
        let q: QuoteItemBlob = quote_item! {
            use logos.std.wql.join_cost;
            use logos.std.wql.why;
            pub struct #nm {
                pub dyn_order:   bool,
                pub defer_order: bool,
                pub swap:        bool,
                pub order_ix:    i64,
                pub base_n:      i64,
                pub step_n:      i64,
                pub n2:          i64,
                pub n3:          i64,
                pub tbl:         JCTable,
            }
            impl #nm {
                // ⚠ EVERY ONE OF THESE DELEGATES. The cost model is one function in
                // `logos.std.wql.join_cost`, so `agrees`, `margin`, `cost_of` and the
                // decision itself cannot come to different conclusions from the same
                // table — and the model is readable in one place instead of being
                // spelled once per emitted query.
                pub fn order_pick(&self, n0: i64, n1: i64, n2: i64, n3: i64) -> i64 {
                    return jc_order_pick(&self.tbl, n0, n1, n2, n3);
                }
                pub fn cost_of(&self, ix: i64) -> i64 {
                    return jc_order_cost(&self.tbl, ix, self.base_n, self.step_n, self.n2, self.n3);
                }
                pub fn considered(&self) -> i64 { return self.tbl.ncand; }
                // ⚠ THE SEARCH'S CENSUS, THE SAME TRIPLE THE TRACE PRINTS.
                // `enumerated()` how many permutations were walked, `proved()`
                // how many were proved LEGAL (carried or not), `considered()`
                // how many are carried as candidates. Three numbers because two
                // could not tell "the axis was never entered" (enumerated 0)
                // from "entered and admitted nothing" (enumerated > 0, proved 0)
                // — the conflation this replaces, one level down. Both are
                // compile-time constants: a plan pays no field and no store.
                pub fn enumerated(&self) -> i64 { return #(np); }
                pub fn proved(&self) -> i64 { return #(na); }
                // ⚠ THE CENSUS'S FIRST NUMBER, AND THE ONE A COUNT COULD NOT BE.
                // 0 the axis was never entered, 1 entered and refused BEFORE
                // enumeration, 2 searched. `enumerated()` is 0 in the first TWO,
                // which is exactly why "the order axis was never entered" was
                // asserted for 59 of 259 plans whose own ground said an anti join or
                // a traversal had refused them. `ground()` names the antecedent
                // (`why::WG_*`), `operand()` the value it failed on, `refused(code)`
                // how many permutations each `why::RJ_*` constraint turned down.
                pub fn axis(&self) -> i32 { return #(ax); }
                pub fn ground(&self) -> i32 { return #(gr); }
                pub fn operand(&self) -> str { return #(op); }
                pub fn refused(&self, code: i32) -> i64 { #(rf) }
                pub fn agrees(&self, fresh: &#nm) -> bool {
                    if !self.dyn_order { return true; }
                    return self.order_ix == self.order_pick(fresh.base_n, fresh.step_n, fresh.n2, fresh.n3);
                }
                // ⚠ NO EARLY RETURN, AND THAT IS THE WHOLE FIX. `if !self.dyn_order
                // { return 0 }` was the pair era's shorthand for "a plan with no
                // decision has no distance to a flip" — and a DEFERRED plan is also
                // `!dyn_order`, so it reported 0: "the runner-up costs the same",
                // which is a real answer and the wrong one. Every plan that reaches
                // THIS shape carries a table (`has_tbl`), so it is dynamic or
                // deferred and nothing else, and `jc_margin` distinguishes them from
                // the facts alone: a measured plan gets its distance, an unmeasured
                // one gets `JC_NOFACT()`. The model answers; this method does not
                // second-guess it.
                pub fn margin(&self) -> i64 {
                    return jc_margin(&self.tbl, self.order_ix, self.base_n, self.step_n, self.n2, self.n3);
                }
                pub fn settled(&self) -> bool { return !self.defer_order; }
                pub fn explain(&self) -> str { return #(ex); }
            }
        };
        unsafe { logos_emit_item_blob_subst(&q); }
    }
}

/// The plan of a query with NO CANDIDATE SET: the same surface, minus the field
/// there was nothing to put in.
///
/// ⚠ THE ANSWERS ARE NOT SPELLED HERE. `jc_none_*` are four `join_cost` functions
/// whose values are what `jc_order_cost`/`jc_order_pick`/`jc_margin`/`ncand` return
/// for `jc_table_none()`, and a fixture evaluates both sides. Writing `0i64` and
/// `-1i64` in this quote instead would have put the cost function's boundary
/// behaviour in a second place — one that no test compares to the first — which is
/// the drift this whole module is arranged to prevent.
///
/// ⚠ `dyn_order` AND `defer_order` STAY, both literally false. They are not dead
/// weight: fixtures read them (`np.dyn_order`, `p5.dyn_order`) and a caller
/// distinguishing "nothing to decide" from "decided per call" reads them, so they
/// are the plan's answer, not its scaffolding. `agrees` and `settled` are then
/// unconditional — the constant-folded form of the general bodies, which for
/// `dyn_order == false` / `defer_order == false` return exactly these.
fn emit_prepared_type_no_tbl(tyn: str, is_priv: bool, np: ExprBlob, na: ExprBlob,
                             ax: ExprBlob, gr: ExprBlob, op: ExprBlob, rf: ExprBlob,
                             ex: ExprBlob) {
    let nm: Ident = Ident::new(tyn);
    if is_priv {
        let q: QuoteItemBlob = quote_item! {
            use logos.std.wql.join_cost;
            use logos.std.wql.why;
            struct #nm {
                pub dyn_order:   bool,
                pub defer_order: bool,
                pub swap:        bool,
                pub order_ix:    i64,
                pub base_n:      i64,
                pub step_n:      i64,
                pub n2:          i64,
                pub n3:          i64,
            }
            impl #nm {
                pub fn order_pick(&self, n0: i64, n1: i64, n2: i64, n3: i64) -> i64 {
                    return jc_none_pick();
                }
                pub fn cost_of(&self, ix: i64) -> i64 { return jc_none_cost(); }
                pub fn considered(&self) -> i64 { return jc_none_ncand(); }
                pub fn enumerated(&self) -> i64 { return #(np); }
                pub fn proved(&self) -> i64 { return #(na); }
                pub fn axis(&self) -> i32 { return #(ax); }
                pub fn ground(&self) -> i32 { return #(gr); }
                pub fn operand(&self) -> str { return #(op); }
                pub fn refused(&self, code: i32) -> i64 { #(rf) }
                pub fn agrees(&self, fresh: &#nm) -> bool { return true; }
                pub fn margin(&self) -> i64 { return jc_none_margin(); }
                pub fn settled(&self) -> bool { return true; }
                pub fn explain(&self) -> str { return #(ex); }
            }
        };
        unsafe { logos_emit_item_blob_subst(&q); }
    } else {
        let q: QuoteItemBlob = quote_item! {
            use logos.std.wql.join_cost;
            use logos.std.wql.why;
            pub struct #nm {
                pub dyn_order:   bool,
                pub defer_order: bool,
                pub swap:        bool,
                pub order_ix:    i64,
                pub base_n:      i64,
                pub step_n:      i64,
                pub n2:          i64,
                pub n3:          i64,
            }
            impl #nm {
                pub fn order_pick(&self, n0: i64, n1: i64, n2: i64, n3: i64) -> i64 {
                    return jc_none_pick();
                }
                pub fn cost_of(&self, ix: i64) -> i64 { return jc_none_cost(); }
                pub fn considered(&self) -> i64 { return jc_none_ncand(); }
                pub fn enumerated(&self) -> i64 { return #(np); }
                pub fn proved(&self) -> i64 { return #(na); }
                pub fn axis(&self) -> i32 { return #(ax); }
                pub fn ground(&self) -> i32 { return #(gr); }
                pub fn operand(&self) -> str { return #(op); }
                pub fn refused(&self, code: i32) -> i64 { #(rf) }
                pub fn agrees(&self, fresh: &#nm) -> bool { return true; }
                pub fn margin(&self) -> i64 { return jc_none_margin(); }
                pub fn settled(&self) -> bool { return true; }
                pub fn explain(&self) -> str { return #(ex); }
            }
        };
        unsafe { logos_emit_item_blob_subst(&q); }
    }
}

/// One `let <pfx><k>: i64 = <size expr>;` per floatable source, then `-1i64` for the
/// slots the query does not use. Four bindings always, because the cost function
/// takes four and a plan's fact table is four wide — `jc_order_cost` never reads
/// past `nfl`, so an unused slot's value is arbitrary and -1 says "not asked" for
/// anything that prints it.
///
/// ⚠ THE SAME SIZE FACT IS OBTAINED ONCE. Two candidate positions may be the SAME
/// SOURCE — a self-join is the obvious case (`q3self` here reads `as_` at two
/// positions) and so is a rel supplying two positions' numbers. The identity check
/// is on the EXPRESSION TEXT, which is the only thing this layer has and is exactly
/// the right granularity: two positions whose size is spelled the same way ask the
/// same question of the same source, so the second slot aliases the first binding.
///
/// ⚠ TEXT IS WHY THIS CATCHES WHAT THE REPORTER DEDUP MISSED. `prepare` also dedups
/// the declared reporter CALLS (by reporter index, in `chain_frag`), but a source
/// with no declared reporter falls back to `(<src>).len()` and has no index to
/// compare — measured: `q3self_prepare` read `(as_).len()` twice, and the deferred
/// path had no dedup at all (`db_i64_leaves_run` read `(__rel_g_sl).len()` three
/// times). Both points now come through here, so there is ONE answer to "how is a
/// size fact bound" rather than one per decision point.
///
/// ⚠ WHAT THIS DOES NOT DECIDE is what a single `len()` COSTS — see
/// `join_order::run_size_expr_of`, which states the bound the deferral rests on.
/// Deduplication removes the REPEATS; it does not license an expensive one.
fn push_size_bindings_4(out: &mut String, pfx: str, nfl: i64,
                        s0: str, s1: str, s2: str, s3: str) {
    let mut k: i64 = 0i64;
    while k < 4i64 {
        out.push_str("    let ");
        out.push_str(pfx);
        out.push_i64(k);
        out.push_str(": i64 = ");
        if k >= nfl { out.push_str("-1i64"); }
        else {
            let mut e: str = s0;
            if k == 1i64      { e = s1; }
            else if k == 2i64 { e = s2; }
            else if k == 3i64 { e = s3; }
            // The first slot whose expression is the same text. `dup == k` means
            // this one is the first, so it evaluates the expression.
            let mut dup: i64 = 0i64;
            while dup < k {
                let mut p: str = s0;
                if dup == 1i64      { p = s1; }
                else if dup == 2i64 { p = s2; }
                else if dup == 3i64 { p = s3; }
                if str_eq(p, e) { break; }
                dup = dup + 1i64;
            }
            if dup < k {
                out.push_str(pfx);
                out.push_i64(dup);
            } else {
                out.push_str(e);
            }
        }
        out.push_str(";\n");
        k = k + 1i64;
    }
}

fn push_size_bindings(out: &mut String, pfx: str, prep: &Prepared) {
    push_size_bindings_4(out, pfx, prep.nfl, prep.sz0, prep.sz1, prep.sz2, prep.sz3);
}

// ── THE JUSTIFICATION'S CONSTANTS, AS EXPRESSIONS THE QUOTE SPLICES ──────────
// `push_no_table_why` and `push_size_list` stood here. Both composed prose the plan
// would carry, and both were APPENDED to the emitter's own copy of a ground the
// decision had already composed — which is how `q5`'s plan came to say "nothing was
// considered" one string away from a trace reporting eight proved orders, and how 59
// of 259 plans came to assert that an axis which had refused them was never entered.
// The sentences are in `why::why_render` now, selected by `why::why_axis`, and there
// is one copy of them for both channels.

/// An `i64` / `i32` literal as an expression blob. The census and the ground are
/// COMPILE-TIME numbers and they are emitted as constant-returning method bodies, so
/// a plan carries its own justification without a field and without a store.
fn i64_lit(v: i64) -> ExprBlob {
    let mut b: String = String::new();
    b.push_i64(v);
    b.push_str("i64");
    return parse_expr(string_as_str(&b));
}

fn i32_lit(v: i32) -> ExprBlob {
    let mut b: String = String::new();
    b.push_i64(v as i64);
    b.push_str("i32");
    return parse_expr(string_as_str(&b));
}

/// THE BODY OF `refused(code)`: one call to `why::rj_at` with this query's census
/// spliced in as eight literals.
///
/// ⚠ IT IS A CALL AND NOT A BRANCH CHAIN because a quote has no antiquote slot where
/// a fn's BODY goes (ADR 0024 S5, still open), so what can be spliced is an
/// EXPRESSION. That constraint pushed the selection rule into stdlib, where it is one
/// copy for every query — which is where it belonged anyway, and is the same argument
/// `join_cost` rests on.
fn refused_body(w: &Why) -> ExprBlob {
    let mut b: String = String::new();
    b.push_str("rj_at(code");
    let mut k: i64 = 0i64;
    while k < RJ_N() {
        b.push_str(", ");
        b.push_i64(w.rjn[k]);
        b.push_str("i64");
        k = k + 1i64;
    }
    b.push_str(")");
    return parse_expr(string_as_str(&b));
}

/// A query's four items: the plan type, `prepare`, `run`, and the direct fn as
/// prepare-then-run. `body` — the query's real body — goes into `run` and
/// nowhere else, so per-row code is emitted exactly once and the direct fn is
/// two statements.
///
/// ⚠ THE DIRECT FN'S BEHAVIOUR IS UNCHANGED, and it is worth being precise about
/// why: it prepares over the very sources it is about to run against, so the
/// decision is taken from the same numbers the inline comparison used to read.
/// What changes is that the decision became an OBJECT a caller may hoist.
///
/// ⚠ `prepare` MAY NOT MATERIALIZE ANYTHING. Its whole body is the declared size
/// reporters (`measure`, one call per side that has one) and the comparison — no
/// prelude, no rel fixpoint, no source drained. Anything else and re-preparing to
/// check a plan would cost as much as running the query, and `agrees` would be
/// advice nobody can afford to take.
///
/// ⚠ The two SMALL bodies here are built as text and reified with `parse_block`,
/// the same route `prelude_frag` takes — not a text push. A quote cannot spell
/// them: both are a STRUCT LITERAL whose type name is a runtime value, and
/// `struct_lit` has no `HASH IDENT` alternative (the `deem_def`-name blocker, ADR
/// 0024 S5). The per-row body, which is the part that matters, is a quote
/// throughout and passes through here untouched.
fn emit_prepared_fns(fn_name: str, params_text: str, tps: str, ret_ty: str,
                     body: ExprBlob, prm: &MacroParams, prep: Prepared) {
    let bare: str = vis_strip(fn_name);
    let is_priv: bool = vis_is_priv(fn_name);
    let mut tyb: String = String::new();
    prep_type_name(bare, &mut tyb);
    let tyn: str = string_as_str(&tyb);
    // ⚠ ONE PREDICATE, ASKED ONCE: does the derivation have a table to give this
    // plan? `Prepared.tbl` IS the answer — the prepared and deferred halves both
    // fill it, `prep_fixed` and `prep_off` leave it empty — so the field's presence
    // on the type and its presence in the struct literal cannot disagree.
    let has_tbl: bool = prep.tbl.len() > 0i64;
    // ⚠ ONE RENDER, THREE DESTINATIONS, ONE FUNCTION — and the buffer outlives all
    // three. `why_render` is the same call `join_order::jo_report` makes over the
    // same record, so `explain()`'s constant, the `[plan]` trace line and the
    // deferred appendix are the SAME TEXT. Declared here because `push_str_lit`
    // escapes a view of it inside `emit_prepared_type` and `plan_trace` reads it at
    // the bottom of this fn: one frame, whole fn, which is the lifetime discipline
    // this module has carried since a composed ground was printed from freed memory.
    let mut whyb: String = String::new();
    why_render(&prep.w, &mut whyb);
    emit_prepared_type(tyn, is_priv, has_tbl, &prep.w, string_as_str(&whyb));

    // The derived fns keep the query's own visibility marker where they are
    // EMITTED and drop it where they are CALLED: the marker is a directive to
    // the item emitter, not part of the identifier.
    let mut prepnm: String = String::new();
    let mut runnm:  String = String::new();
    let mut prepc:  String = String::new();
    let mut runc:   String = String::new();
    prep_derived_name(fn_name, "_prepare", &mut prepnm);
    prep_derived_name(fn_name, "_run", &mut runnm);
    prep_derived_name(bare, "_prepare", &mut prepc);
    prep_derived_name(bare, "_run", &mut runc);

    // ── prepare ────────────────────────────────────────────────────────────
    // ⚠ A DEFERRED PLAN'S `prepare` IS THE SAME SHAPE AS A REFUSED ONE — no
    // measurement, no decision, facts -1 — and that is the honest artifact: at
    // point (1) there was nothing to know. The single field that differs,
    // `defer_order`, is what stops a caller reading "nothing decided" as "nothing
    // to decide". So the deferred half costs `prepare` exactly nothing, which is
    // what keeps `agrees` affordable for every plan.
    //
    // ⚠ ONE GROUND, TWO DESTINATIONS. The composed `why` becomes both the string
    // literal on the plan (`explain()`) and the `plan_trace` line at the bottom of
    // this fn, so a reader of the trace and a caller holding the object are told the
    // same thing. Declared HERE because the trace call is below the emissions and
    // the buffer must outlive both — Phase 1 of this slice lost a composed ground to
    // exactly that (a `String` local to the deciding fn, printed from freed memory).
    // ⚠ ONE RENDER, TWO DESTINATIONS, ONE FUNCTION. `why_render` is the same call
    // `join_order::jo_report` makes over the same record, so the string literal this
    // plan carries and the `[plan]` line a reader sees are the SAME TEXT. Before this
    // they were two texts from two composers, and they disagreed (`q5`).
    //
    // ⚠ AND `prepare` DOES NOT WRITE IT ANY MORE (ADR 0024 S4q). The render is done
    // once at the top of this fn and reaches the artifact through `explain()`'s
    // constant body; what `prepare` builds is the FACTS. A store of ~200 bytes of
    // prose per plan construction was the one part of the justification apparatus a
    // caller paid for without asking — see `emit_prepared_type`.
    let mut pb: String = String::new();
    pb.push_str("{\n");
    if prep.dynamic {
        pb.push_str(prep.measure);
        push_size_bindings(&mut pb, "__n", &prep);
        pb.push_str("    let __tb: JCTable = ");
        pb.push_str(prep.tbl);
        pb.push_str(";\n    let __ix: i64 = jc_order_pick(&__tb, __n0, __n1, __n2, __n3);\n");
        pb.push_str("    return ");
        pb.push_str(tyn);
        pb.push_str(" { dyn_order: true, defer_order: false, swap: (__ix == 1i64), order_ix: __ix, base_n: __n0, step_n: __n1, n2: __n2, n3: __n3, tbl: __tb };\n");
    } else {
        // No fact was measured, so none is reported: -1 is "not asked", which a
        // caller can tell apart from an empty source.
        //
        // ⚠ A DEFERRED PLAN STILL CARRIES THE TABLE. `run` has to price the
        // candidates and it prices them through the plan, so the table is the one
        // part of a deferred decision that IS fixed when the plan is made — the rule
        // without the answer, which is exactly what "deferred" means here.
        pb.push_str("    return ");
        pb.push_str(tyn);
        pb.push_str(" { dyn_order: false, defer_order: ");
        if prep.deferred { pb.push_str("true"); } else { pb.push_str("false"); }
        // ⚠ `order_ix` IS -1 ON A DEFERRED PLAN AND 0 ON A FIXED ONE, and the two are
        // different answers to the same question. A fixed plan HAS an order and it is
        // the query's own: 0 is a fact. A deferred plan names no order — `run` names
        // one, per call — so 0 would be the plan claiming a decision it did not take,
        // which is what a caller reading `order_ix` to reproduce the choice was told
        // (measured: `order_ix` 0 and `cost_of` 0 for both candidates, while the nest
        // that ran was candidate 1). -1 is this compiler's spelling of "not held",
        // already carried by every fact field on this same line.
        if prep.deferred { pb.push_str(", swap: false, order_ix: -1i64"); }
        else             { pb.push_str(", swap: false, order_ix: 0i64"); }
        pb.push_str(", base_n: -1i64, step_n: -1i64, n2: -1i64, n3: -1i64");
        // ⚠ NO TABLE FIELD AND NO `jc_table_none()` CALL WHERE THERE ARE NO
        // CANDIDATES. This line used to read `tbl: jc_table_none()` for 249 of the
        // corpus's 266 `prepare` bodies: 272 bytes of the empty set written out and
        // an out-of-line cross-module call to fetch them, per invocation of a query
        // that cannot read the field. The type omits it in the same case (`has_tbl`),
        // from the same predicate.
        if prep.deferred {
            pb.push_str(", tbl: ");
            pb.push_str(prep.tbl);
        }
        // ⚠ NOTHING IS APPENDED TO THE RENDERED GROUND ANYWHERE — not the deferred
        // size list, not the table's absence. Both used to be this emitter's own
        // additions to its own copy, which is precisely why the plan and the
        // `[plan] … -> drive …` line disagreed on 66 of 81 join-order decisions.
        // `why_render` produces the whole justification and every channel prints it.
        //
        // ⚠ AND THE ABSENCE OF A TABLE IS NOT ASSERTED FROM A COUNT ANY MORE. That suffix was
        // this emitter's own sentence about a search this emitter did not run, keyed
        // on a count — and it asserted "the order axis was never entered" for every
        // table-less plan, including 59 whose ground said the axis had refused them
        // and one (`q5`) whose ground said eight orders were proved legal. The census
        // clause is inside `why_render`, selected by `why_axis`, so the state and the
        // ground come out of one record and cannot contradict each other.
        pb.push_str(" };\n");
    }
    pb.push_str("}\n");
    emit_fn_quote_blob(string_as_str(&prepnm), params_text, tps, tyn,
                       parse_block(string_as_str(&pb)), prm);

    // ── run: the query's body, with the plan in front of the sources ───────
    let mut rps: String = String::new();
    rps.push_str("__pl: &");
    rps.push_str(tyn);
    if params_text.len() > 0i64 {
        rps.push_str(", ");
        rps.push_str(params_text);
    }
    emit_fn_quote_blob(string_as_str(&runnm), string_as_str(&rps), tps, ret_ty, body, prm);

    // ── the direct fn: prepare, then run ───────────────────────────────────
    // The plan is a NAMED local rather than `&<prepare>(…)`: a plan is a value
    // with a lifetime, and taking a reference to a temporary is the shape that
    // reads as an accident.
    let mut db: String = String::new();
    db.push_str("{\n    let __pl: ");
    db.push_str(tyn);
    db.push_str(" = ");
    db.push_str(string_as_str(&prepc));
    db.push_str("(");
    push_param_args(&mut db, prm);
    db.push_str(");\n    return ");
    db.push_str(string_as_str(&runc));
    db.push_str("(&__pl");
    if prm.n > 0i64 {
        db.push_str(", ");
        push_param_args(&mut db, prm);
    }
    db.push_str(");\n}\n");
    emit_fn_quote_blob(fn_name, params_text, tps, ret_ty,
                       parse_block(string_as_str(&db)), prm);

    // The one decision channel, like every other plan decision — and the SAME
    // composed ground the plan carries, so the trace and `explain()` cannot say
    // different things about the same plan.
    plan_trace(bare, "prepared plan", tyn, string_as_str(&whyb));
}

/// The query's parameter NAMES as a call argument list (no parens) — the direct
/// fn forwarding to `prepare`/`run`. The generated head's parameters are the
/// `deem!(…)` paren list verbatim and `MacroParams` is that list parsed, so the
/// two orders are the same by construction.
fn push_param_args(out: &mut String, prm: &MacroParams) {
    let mut a: i64 = 0i64;
    while a < prm.n {
        if a > 0i64 { out.push_str(", "); }
        out.push_str(prm.names[a]);
        a = a + 1i64;
    }
}

// THE GROUND A SINGLE-SOURCE PLAN RECORDS is `why::WG_SCAN`, and its sentence lives
// with the rest of the vocabulary (`why::wg_words`). Stated once because it is the
// same argument for a scan and for a find, and because it is the argument this whole
// slice rests on: the ACCESS axis is where a run-time decision is nearly always the
// same answer (a narrowing over an ordered source costs one descent against zero and
// never returns more rows; `upto` walks from the start and merely stops), so a plan
// built around it would be a mechanism with no consumer. JOIN ORDER is the axis where
// the data changes the answer.

/// The ONE item-emitting entry every query emitter goes through: either the
/// single direct fn (a generated HELPER — a rel's own fn, an SCC driver: an
/// internal of one query's body, not a query an application holds) or the
/// prepared surface of four.
fn emit_query_fn(fn_name: str, params_text: str, tps: str, ret_ty: str,
                 body: ExprBlob, prm: &MacroParams, prep: Prepared) {
    if !prep.on {
        emit_fn_quote_blob(fn_name, params_text, tps, ret_ty, body, prm);
        return;
    }
    emit_prepared_fns(fn_name, params_text, tps, ret_ty, body, prm, prep);
}

fn is_comp_root(e: SExpr) -> bool {
    match e {
        SExpr::Comp(_) => { return true; }
        _ => { return false; }
    }
}

// ── Tuple-projection envelope (shared by every projecting emitter) ───────────
// When `proj` is tuple-rooted (`select (a, b, …)` — multi-column rows), validate
// the modifier combination and fill `tt` with the NATIVE tuple TYPE text
// `(T1, T2, …)` (per-component EL inference + owned-String promotion). Returns:
//   1  — tuple projection (tt filled; the result element type IS the tuple type);
//   0  — not a tuple projection (tt untouched);
//  -1  — error surfaced (`: RTy` annotation clash, or distinct over an f64
//         component — tuple `==` routes through variadic__eq which requires Eq,
//         and f64 is PartialEq only).
fn tuple_result(proj: SExpr, t: &ElTypes, has_result_ty: bool, distinct: bool,
                tt: &mut String) -> i32 {
    if !is_tuple_root(proj) { return 0i32; }
    match proj {
        SExpr::Tuple(tp) => {
            if tp.items_arr().len() < 2i64 {
                // Unreachable via the grammar (tuple_body demands ≥ 2 components;
                // `(e)` parses as grouping) — kept as a defensive diagnostic.
                error("wql!: a tuple projection needs at least two components — `(e)` is grouping, not a 1-tuple");
                return -1i32;
            }
            if has_result_ty {
                error("wql!: a `: ResultTy` annotation cannot be combined with a tuple projection — the element type is the tuple type itself");
                return -1i32;
            }
            if distinct && tuple_has_flt(tp, t) {
                error("wql!: `distinct` over a tuple projection with an f64 component is not supported — tuple equality requires Eq and f64 is not Eq");
                return -1i32;
            }
            push_tuple_ty(tt, tp, t);
        }
        _ => { }
    }
    return 1i32;
}

fn comp_head_ty(e: SExpr, t: &ElTypes) -> i32 {
    match e {
        SExpr::Comp(cp) => { return infer_ty(cp.head_expr(), t); }
        _ => { return EL_TY_INT(); }
    }
}

// ── RExpr shape decomposition helpers ────────────────────────────────────────
// The top of a lowered plan is `RLimit?( RDistinct?( RProj( RSort?( body ), sel ) ) )`;
// `body` is a scan/filter/join/anti/aggr sub-tree (with an optional HAVING
// RFilter directly over an RAggr). These peel the wrapping to route to the
// right emitter — the walker's `match` over the algebra.

// Peel an optional RFilter: returns (inner, pred_ref, has_pred).
struct Peeled { inner: RExpr, pred: WRef<SExpr>, has_pred: bool }

fn peel_filter(e: RExpr) -> Peeled {
    match e {
        RExpr::Filter(f) => {
            return Peeled { inner: f.input_expr(), pred: f.pred, has_pred: true };
        }
        _ => {
            return Peeled { inner: e, pred: null_sref(), has_pred: false };
        }
    }
}

// ── QMods — the peeled ORDER/DISTINCT/LIMIT modifier envelope ────────────────
// Collected off the RSort / RDistinct / RLimit wrappers around the projection
// root and threaded to the per-shape emitters (which weave sort / dedup / first-n
// into the generated loop nest).
struct QMods {
    has_sort:       bool,
    sort_key:       WRef<SExpr>,
    sort_desc:      bool,
    distinct:       bool,
    has_limit:      bool,
    limit_n:        i64,
    limit_is_param: bool,
    limit_param:    str,
}

fn qmods_none() -> QMods {
    return QMods { has_sort: false, sort_key: null_sref(), sort_desc: false,
                   distinct: false,
                   has_limit: false, limit_n: 0i64, limit_is_param: false, limit_param: "" };
}

// Peel a root RLimit wrapper into `mods` (identity otherwise).
fn peel_limit(e: RExpr, mods: &mut QMods) -> RExpr {
    match e {
        RExpr::Limit(l) => {
            mods.has_limit      = true;
            mods.limit_n        = l.n;
            mods.limit_is_param = l.is_param;
            mods.limit_param    = l.param;
            return l.input_expr();
        }
        _ => { return e; }
    }
}

// Peel a root RDistinct wrapper into `mods` (identity otherwise).
fn peel_distinct(e: RExpr, mods: &mut QMods) -> RExpr {
    match e {
        RExpr::Distinct(d) => {
            mods.distinct = true;
            return d.input_expr();
        }
        _ => { return e; }
    }
}

// Peel an RSort under the projection into `mods` (identity otherwise).
fn peel_sort(e: RExpr, mods: &mut QMods) -> RExpr {
    match e {
        RExpr::Sort(s) => {
            mods.has_sort  = true;
            mods.sort_key  = s.key;
            mods.sort_desc = s.desc;
            return s.input_expr();
        }
        _ => { return e; }
    }
}

// ══════════════════════════════════════════════════════════════════════════
// FRAGMENT helpers — the emitters' vocabulary now that a BODY is a quote too.
// ══════════════════════════════════════════════════════════════════════════

// The generated-name spelling `prefix` + decimal `k` (`__pk3`, `__hm2`).
//
// ⚠ Returns the STRING, not the Ident. `Ident::new` BORROWS its bytes, so the
// backing storage has to be a local of the frame that builds the quote; a
// helper handing back an Ident would hand back a pointer into its own dead
// frame, and that failure surfaces far away as "ExprBlob splice — null ptr".
fn nk_str(prefix: str, k: i64) -> String {
    let mut s: String = String::new();
    s.push_str(prefix);
    s.push_i64(k);
    return s;
}

// The `limit` BOUND as an expression fragment — the literal or the param name.
// Only called when `mods.has_limit`.
//
// ⚠ The integer literal goes through `parse_expr` on a three-character string
// because metaprog has no "reify this i64 as a literal node" constructor. That
// is the one leaf here that is still text, and it is a missing primitive, not a
// shape the emitter chose.
fn limit_expr(mods: &QMods) -> ExprBlob {
    if mods.limit_is_param { return parse_expr(mods.limit_param); }
    let mut s: String = String::new();
    s.push_i64(mods.limit_n);
    s.push_str("i64");
    return parse_expr(string_as_str(&s));
}

// The rel PRELUDE as a statement-list fragment (empty block when absent).
//
// ⚠ It arrives as TEXT from `plan_walker` — the rel materializer statements are
// built there, and converting THAT is a different arc — so `parse_block`
// reifies it. It splices at a STATEMENT slot (`#(pre);`), which inlines: the
// prelude declares `__rel_X` for the loops that follow, so a nested scope would
// lose exactly the bindings it exists to publish.
fn prelude_frag(prelude: str) -> ExprBlob {
    if prelude.len() == 0i64 { return parse_block("{ }"); }
    let mut s: String = String::new();
    s.push_str("{\n");
    s.push_str(prelude);
    s.push_str("}\n");
    return parse_block(string_as_str(&s));
}

// One guarded output push as a statement list: plain `__out.push(v)` without
// `distinct`, else bind the projected value and push only when not already in
// `__out` (linear scan — O(n²) MVP dedup; `==` covers i64/f64/str natively).
// The INDENT parameter is gone with the text: a fragment has no column.
fn push_guarded_frag(val_ty: str, body: ExprBlob, distinct: bool) -> ExprBlob {
    if !distinct {
        return quote_block! { __out.push(#(body)); };
    }
    let vt: ExprBlob = parse_type(val_ty);
    return quote_block! {
        let __pv: #(vt) = (#(body));
        let mut __dup: bool = false;
        let mut __d: i64 = 0i64;
        while __d < __out.len() { if __out.get(__d) == __pv { __dup = true; } __d = __d + 1i64; }
        if !__dup { __out.push(__pv); }
    };
}

// The row-INDEX TUPLE as a TIEBREAK — lexicographic, in QUERY source order.
//
// True when the tuple sitting at `__b - 1` is lexicographically GREATER, from
// component `k` on, than the tuple saved in `__iv*` — i.e. the two are out of
// query order and the shift must continue. Ascending in BOTH sort directions:
// `desc` reverses the KEY comparison, and reversing the tiebreak with it would
// make a descending sort's ties come out backwards from an ascending one's,
// which is not what a stable sort did.
//
// ⚠ WHY A TOTAL ORDER IS REQUIRED AND NOT MERELY TIDIER. Equal keys used to keep
// COLLECTION order (a stable sort, and collection order is base-major then
// step-order = lexicographic in the index tuple). That made the emitted row
// sequence a fact about WHICH NEST produced it, so a join order the plan chose
// at run time would have changed the answer. With the tuple as the tiebreak the
// order is total in (key, tuple) and the sorted sequence is the same whichever
// nest collected it — which is the whole licence for `join_order` to offer a
// second order at all.
//
// ⚠ AND IT IS A NO-OP EVERYWHERE ELSE, by construction rather than by luck: for
// every collection whose tuples ARE ascending (a simple scan, an aggregate's
// group column, a join nest in query order) the tiebreak is false at every
// comparison, so it decides nothing and the permutation is the one the stable
// sort already produced.
fn ix_lex_gt_frag(k: i64, nidx: i64) -> ExprBlob {
    let sx: String = nk_str("__ix", k);
    let sv: String = nk_str("__iv", k);
    let ix: Ident = Ident::new(string_as_str(&sx));
    let iv: Ident = Ident::new(string_as_str(&sv));
    if k + 1i64 >= nidx {
        return quote_expr! { #ix.get(__b - 1i64) > #iv };
    }
    let rest: ExprBlob = ix_lex_gt_frag(k + 1i64, nidx);
    return quote_expr! {
        #ix.get(__b - 1i64) > #iv
            || (#ix.get(__b - 1i64) == #iv && (#(rest)))
    };
}

// The in-place insertion sort over the parallel (key, index) vecs `__ks` +
// `__ix0`..`__ix{nidx-1}` (one index vec per BOUND source — 1 for a simple/
// aggregate sort, 1 + non-anti steps for a join chain) — O(n²) MVP codegen;
// `desc` flips the KEY comparison. str keys compare with the native `<`/`>`
// (sema lowers str relationals to byte-lexicographic `str_cmp`).
//
// Equal keys are ordered by the row-index tuple in query source order
// (`ix_lex_gt_frag`), so WHEN THE KEY'S COMPARISON IS TOTAL the result does not
// depend on the order the tuples were collected in — see that function for why the
// plan needs that and why it changes no existing permutation.
//
// ⚠ THAT CONDITION IS NOT SPELLED HERE, AND IT IS NOT ASSUMED EITHER. The tiebreak
// sits behind an EQUAL compare, so for a key whose comparison is partial (f64: a
// NaN is not `>`, not `<` and not `==`) it is never reached and the collection
// order becomes visible in the answer. `el::el_order_faithful` is the one answer to
// which TYPES qualify, and the LICENCE that depends on it — carrying more than one
// nest — is refused at the decision (`join_order` C1) with its ground on the plan
// trace. This fragment is deliberately NOT the enforcement point: a single-nest
// sort over an f64 key is a capability, its comparison is the language's `>` on
// f64, and this codegen does not get to redefine it.
//
// ⚠ AND THIS FRAGMENT IS WHY THE ANSWER IS KEYED ON THE TYPE NAME, NOT THE CLASS.
// `key_ty` here is the type the EMITTER PRINTS for the key (`infer_emit_ty`), which
// for a column read is the COLUMN'S OWN TYPE and for an arithmetic node or a UDF
// call is the class's representative (those normalize at their own site). So the
// comparison this loop emits is `<` on the key's own type wherever the key IS a
// value of a named type — and a `u64` key is compared as u64, in u64's order.
// Where a normalization did happen the value is refused at the site that performs
// it (`codegen::check_calls`) rather than sorted by its reinterpretation: this loop
// compares whatever reaches it, and it is not the place that decides what may.
//
// The per-index statements are RUNTIME-many, so they ride three Vec<ExprBlob>
// cursors and splice flat — the shape that replaced `push_ixn` writing `__ix`
// and a decimal into the middle of a half-written line.
// ── THE KEY VECTOR HOLDS THE CLASS'S REPRESENTATIVE, SO THE KEY IS NORMALIZED ─
// `__ks` / `__k` / `__g_key` are typed `el_class_repr(class)` — i64 / f64 / str /
// bool — while the key EXPRESSION has whatever type the query gave it. Those are
// the same type only when the key type is its own repr (`ElTy.canon`). They were
// not checked to be, and the mismatch surfaced as a raw `Vec__push arg 1: expected
// i64, got u64` inside the GENERATED chunk — a diagnostic pointing at a line
// nobody wrote. MEASURED before this seam existed, on `order by s.v` over a `u64`
// column.
//
// Three outcomes, decided by the type and nothing else:
//   • canon                  → the body is already the key vector's type;
//   • not canon but `fits`   → the normalization is VALUE-PRESERVING, so it is
//                              EMITTED (`el_norm_cast`): u8..u32, i8..i32, u56,
//                              isize and f32 keys work, and they compare in their
//                              own order because a value that survives the
//                              widening carries its order with it (`ElTy.ord`);
//   • not canon and !fits    → the normalization REINTERPRETS (u64/usize) or
//                              TRUNCATES (u128/i128). REFUSED, with the ground
//                              `el_order_why` already states — never sorted by a
//                              reinterpretation.
// ⚠ AN OUT-OF-LATTICE KEY IS NOT REFUSED HERE, and the difference matters. The
// lattice's LENIENT default (`el_ty_of_name`: an unknown name is the i64 baseline)
// is what lets a key whose declared type this layer cannot resolve — a generic
// alias to its own parameter, `type El<T> = T`, is the pinned case — still emit,
// with the HOST compiler as the oracle for whether the push type-checks. Refusing
// it here would turn a documented lenient default into a hard error and break a
// query that compiles and runs correctly. MEASURED: three fixtures, including
// wql_key_spelling_e2e claim 5, which asserts exactly that such a key keeps
// working while being refused the reorder LICENCE.
//
// So this seam refuses only what it KNOWS is lossy — the ORDER question's
// default-deny stays where it belongs, on the licence (`el_order_faithful`), which
// denies an unresolvable name without denying the query.
fn key_norm_ok(tn: str, kv: str, ctx: str) -> bool {
    let t: ElTy = el_ty(tn);
    if t.cls < 0i32           { return true; }   // lenient — the host is the oracle
    // ⚠ THE VECTOR MUST BE ABLE TO HOLD THE TYPE, and that is a SECOND antecedent,
    // not a consequence of the first. `String` passes every conversion test in the
    // table — it is its own emitted type, its equality is exact, its order is the
    // byte order — and a `Vec<String>` key vector still cannot be sorted or
    // scanned: `Vec::get` refuses to move a non-`Copy` element out, and the `str`
    // view that would avoid the move borrows the row var, which dies with the loop
    // body while the vector outlives it. MEASURED, both halves, on
    // `order by s.name` over a `String` column. Deriving the answer from the
    // conversion alone is what let this through as an admit-then-miscompile.
    if !el_vec_key_ok(kv) {
        let mut mk: String = String::new();
        mk.push_str(ctx);
        mk.push_str(": a key of type `");
        mk.push_str(kv);
        mk.push_str("` cannot be held by the key vector the backend emits: the sort and the bucket scan read keys back out of a `Vec` by value, and this type is not `Copy` — a borrowed `str` view of the row would not outlive the loop that binds it. The remedy is a `str` column (a borrowed view stored in the row itself), or a scalar key");
        error(string_as_str(&mk));
        return false;
    }
    if str_eq(tn, kv)         { return true; }   // the vector IS the key's type
    if str_eq(kv, t.repr) && t.fits { return true; }   // value-preserving
    let mut m: String = String::new();
    m.push_str(ctx);
    m.push_str(": a key of type `");
    m.push_str(tn);
    m.push_str("` cannot be collected into the key vector the backend emits (`");
    m.push_str(kv);
    m.push_str("`) — ");
    m.push_str(el_cmp_why(tn, kv));
    error(string_as_str(&m));
    return false;
}

/// The emitted key body, normalized into the key vector's element type `kv`.
/// Call ONLY after `key_norm_ok` has admitted the pair.
///
/// ⚠ NOTHING IS EMITTED WHEN THE VECTOR HOLDS THE KEY'S OWN TYPE, which is now the
/// common case: the cast exists to bridge a type to its REPR, so it is derived from
/// the pair rather than from the key alone. `el_norm_cast(tn)` alone would have
/// wrapped a `u32` key in `as i64` while the vector was declared `Vec<u32>`.
fn key_norm_body(body: str, tn: str, kv: str) -> String {
    let mut out: String = String::new();
    if str_eq(tn, kv) { out.push_str(body); return out; }
    let cast: str = el_norm_cast(tn);
    if cast.len() == 0i64 || !str_eq(cast, kv) { out.push_str(body); return out; }
    out.push_str("(("); out.push_str(body);
    out.push_str(") as "); out.push_str(cast); out.push_str(")");
    return out;
}

// ── THE SORT'S COMPARATOR MUST BE A TOTAL ORDER, AND `<` ON f64 IS NOT ONE ──
// A NaN is neither `<`, `>` nor `==` anything, so an insertion sort keyed on the
// language's `>` simply STOPS SHIFTING when it meets one and leaves every row
// before it in collection order. MEASURED on six rows with one NaN: `order by
// s.k` returned the rows in QUERY order and the answer was neither sorted nor
// flagged. This was previously written down here as a documented consequence of
// "this codegen does not get to redefine `>` on f64" — but a sort is not a
// redefinition of `>`: it is an algorithm that is only DEFINED over a total
// order, and choosing which one is the sort's own job.
//
// So a float key is compared through `f64_data_key` / `f32_data_key` — the
// order over VALUES, which is PostgreSQL's for a float column: all NaNs equal
// and sorting LAST, −0.0 equal to +0.0, IEEE order everywhere else. Every other
// key type compares with its own `<`, which is already total. `order by` on a
// float is now a permutation whose keys read back monotone — the property the
// enumerating harness checks, and the one the old fixture could not see because
// its oracle was a sort written beside the emitter with the same partial
// comparator.
//
// ⚠ NOT `f64_total_key`, which is the faithful IEEE primitive and distinguishes
// every bit pattern. Two rows holding −0.0 and +0.0 are `==` and must not land
// in different groups; and the sign of a NaN PRODUCED BY ARITHMETIC is chosen by
// the optimiser, so keying on it lets the inliner move rows. Both reasons are
// spelled out at `f64_data_key` in `logos.lang.num.float`.
//
// ⚠ The reorder LICENCE (`el::el_order_faithful`, refused at `join_order` C1)
// is NOT widened here. It denies a second nest over a float key, and that
// denial now costs only an optimization rather than covering a wrong answer;
// widening it is a decision about the plan, taken where the plan is decided.
fn key_ord_frag(key_ty: str, e: ExprBlob) -> ExprBlob {
    if str_eq(key_ty, "f64") { return quote_expr! { f64_data_key(#(e)) }; }
    if str_eq(key_ty, "f32") { return quote_expr! { f32_data_key(#(e)) }; }
    return e;
}

fn sort_perm_frag(key_ty: str, desc: bool, nidx: i64) -> ExprBlob {
    let mut saves: Vec<ExprBlob>  = vec_new::<ExprBlob>();
    let mut shifts: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut lands: Vec<ExprBlob>  = vec_new::<ExprBlob>();
    let mut k: i64 = 0i64;
    while k < nidx {
        let sx: String = nk_str("__ix", k);
        let sv: String = nk_str("__iv", k);
        let ix: Ident = Ident::new(string_as_str(&sx));
        let iv: Ident = Ident::new(string_as_str(&sv));
        saves.push(quote_block!  { let #iv: i64 = #ix.get(__a); });
        shifts.push(quote_block! { #ix.set(__b, #ix.get(__b - 1i64)); });
        lands.push(quote_block!  { #ix.set(__b, #iv); });
        k = k + 1i64;
    }
    let kt: ExprBlob = parse_type(key_ty);
    let tie: ExprBlob = ix_lex_gt_frag(0i64, nidx);
    // Four fragments, not two reused: a spliced blob is consumed by its splice.
    let pa: ExprBlob = key_ord_frag(key_ty, quote_expr! { __ks.get(__b - 1i64) });
    let ca: ExprBlob = key_ord_frag(key_ty, quote_expr! { __kv });
    let pe: ExprBlob = key_ord_frag(key_ty, quote_expr! { __ks.get(__b - 1i64) });
    let ce: ExprBlob = key_ord_frag(key_ty, quote_expr! { __kv });
    if desc {
        return quote_block! {
            let mut __a: i64 = 1i64;
            while __a < __ks.len() {
                let __kv: #(kt) = __ks.get(__a);
                #( #saves; )*
                let mut __b: i64 = __a;
                while __b > 0i64 && ((#(pa)) < (#(ca))
                                     || ((#(pe)) == (#(ce)) && (#(tie)))) {
                    __ks.set(__b, __ks.get(__b - 1i64));
                    #( #shifts; )*
                    __b = __b - 1i64;
                }
                __ks.set(__b, __kv);
                #( #lands; )*
                __a = __a + 1i64;
            }
        };
    }
    return quote_block! {
        let mut __a: i64 = 1i64;
        while __a < __ks.len() {
            let __kv: #(kt) = __ks.get(__a);
            #( #saves; )*
            let mut __b: i64 = __a;
            while __b > 0i64 && ((#(pa)) > (#(ca))
                                 || ((#(pe)) == (#(ce)) && (#(tie)))) {
                __ks.set(__b, __ks.get(__b - 1i64));
                #( #shifts; )*
                __b = __b - 1i64;
            }
            __ks.set(__b, __kv);
            #( #lands; )*
            __a = __a + 1i64;
        }
    };
}

// ══════════════════════════════════════════════════════════════════════════
// Phase-3 THIN emitters — the two peephole collapses `simplify_rexpr` signals.
// ══════════════════════════════════════════════════════════════════════════

// (a·false) EMPTY plan — a const-false `where` proved the query yields NO rows.
// Emit a fn with the same signature that returns an empty `Vec` DIRECTLY: no scan
// loop, no per-row work. The verbatim params still shape the signature (the
// caller's call site is unchanged) but the body is a single empty-Vec return.
// `first` (SELM_FIRST) narrows the return to `Option<E>` + a constant
// `Option::None` — the single-row mode's empty collapse.
fn emit_empty(scan_e: RExpr, sel: WRef<SExpr>,
              fn_name: str, params_text: str, prm: &MacroParams,
              result_ty0: str, has_result_ty: bool, first: bool, h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    let row_ty: str   = sc.row_ty;

    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, row_ty, sc.var_name);
    stamp_rel_source(&mut ty, &view, prm, sc.src_name, sc.var_name);
    apply_scalar_params(&mut ty, &view, prm);
    stamp_udfs_from_module(&view, &mut ty);

    let proj_sexpr: SExpr = sel.any().view::<SExpr>();

    let proj_opt: SExpr = simplify_sexpr(proj_sexpr, h).any().view::<SExpr>();
    let mut result_ty: str = result_ty0;
    if !has_result_ty {
        result_ty = infer_emit_ty(proj_opt, &ty);
        // A String-returning call projects an OWNED element (Vec<String>).
        if returns_string(proj_opt, &ty) { result_ty = "String"; }
    }
    // Tuple projection: the element type is the native tuple type text.
    let mut tuple_tt: String = String::new();
    let tres: i32 = tuple_result(proj_opt, &ty, has_result_ty, false, &mut tuple_tt);
    if tres < 0i32 { return false; }
    if tres > 0i32 { result_ty = string_as_str(&tuple_tt); }
    let is_comp: bool = is_comp_root(proj_opt);
    if !has_result_ty && is_comp {
        result_ty = el_class_repr(comp_head_ty(proj_opt, &ty));
    }
    let mut elem_ty: String = String::new();
    if is_comp {
        elem_ty.push_str("Vec<"); elem_ty.push_str(result_ty); elem_ty.push_str(">");
    } else {
        elem_ty.push_str(result_ty);
    }
    let result_elem: str = string_as_str(&elem_ty);

    // ── the item is a QUOTE (ADR 0024 S5), BODY INCLUDED ──────────────────
    // Both collapses are a return type plus a one-line constant body, and the
    // two differ ONLY in the type and that one line — so the branch chooses
    // both and the item is emitted once. The element type is the only runtime
    // content, and it rides a TYPE slot rather than a `Vec::<` … `>::new()`
    // string whose angle brackets had to be matched by hand.
    let mut rty: String = String::new();
    let bt: ExprBlob = if first {
        // Single-row mode: constant None (no scan loop).
        rty.push_str("Result<Option<");
        rty.push_str(result_elem);
        rty.push_str(">, ElError>");
        quote_block! { return Result::Ok(Option::None); }
    } else {
        rty.push_str("Result<Vec<");
        rty.push_str(result_elem);
        rty.push_str(">, ElError>");
        // The const-false filter proved emptiness: return the empty Vec directly.
        let et: ExprBlob = parse_type(result_elem);
        quote_block! { return Result::Ok(Vec::<#(et)>::new()); }
    };
    emit_query_fn(fn_name, params_text, prm.tparams, rty.as_str(), bt, prm,
                  prep_ground(WG_FALSE_FILTER(), input_axis(scan_e)));
    return true;
}

// (a·false, FIND mode) — a const-false `find` predicate: constant None with the
// borrow-returning signature (`Option<&Row>`), no scan loop.
fn emit_none_find(scan_e: RExpr, fn_name: str, params_text: str,
                  prm: &MacroParams, h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    // ── the item is a QUOTE (ADR 0024 S5), BODY INCLUDED ──────────────────
    // The body is a CONSTANT here, and a constant is the one body with no
    // excuse to travel as text at all.
    let mut rty: String = String::new();
    rty.push_str("Result<Option<&");
    rty.push_str(sc.row_ty);
    rty.push_str(">, ElError>");
    // ⚠ The chunk route passed NO natspec uses here ("find/first fast paths
    // scan plain slices only"), but the source is not the only thing a
    // signature names: `params_text` is VERBATIM, so any param type defined in
    // a factory package needs that package imported. `prm` supplies exactly
    // the list the chunk route builds for every other emitter.
    emit_query_fn(fn_name, params_text, prm.tparams, rty.as_str(),
                  quote_block! { return Result::Ok(Option::None); }, prm,
                  prep_ground(WG_FALSE_PRED(), input_axis(scan_e)));
    return true;
}

// (b, single-row modes) HEAD ROW — the identity peephole under SELM_FIRST/
// SELM_FIND: an identity selection over an UNFILTERED scan (`select first v`,
// or `find P` whose predicate const-folded to true). The first row IS the
// answer, so BORROW it: `Option<&Row>` = Some(&src[0]) when non-empty, None
// otherwise — zero loop, zero copy (the emit_identity precedent, narrowed to
// one row).
fn emit_head_row(scan_e: RExpr, fn_name: str, params_text: str,
                 prm: &MacroParams, h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    let src_name: str = sc.src_name;
    let row_ty: str   = sc.row_ty;
    // ── the item is a QUOTE (ADR 0024 S5) ─────────────────────────────────
    let mut rty: String = String::new();
    rty.push_str("Result<Option<&");
    rty.push_str(row_ty);
    rty.push_str(">, ElError>");
    // ⚠ ONE blob per SLOT: a spliced fragment is consumed where it lands, so
    // the two occurrences of the source expression need two reifications.
    let s1: ExprBlob = parse_expr(src_name);
    let s2: ExprBlob = parse_expr(src_name);
    let bt: ExprBlob = quote_block! {
        if (#(s1)).len() > 0i64 { return Result::Ok(Option::Some(&(#(s2))[0i64])); }
        return Result::Ok(Option::None);
    };
    emit_query_fn(fn_name, params_text, prm.tparams, rty.as_str(), bt, prm,
                  prep_ground(WG_HEAD(), input_axis(scan_e)));
    return true;
}

// (b) IDENTITY PROJECTION over an UNFILTERED scan — `from src v select v`.
// The result set IS the source, so BORROW it: emit a fn returning `&[T]` that
// returns the source slice unchanged — zero loop, zero `Vec`, zero copy (the
// accessor-collapse peephole). The return TYPE narrows from `Vec<T>` to `&[T]`
// (a genuinely thinner form; there is no per-row materialization).
fn emit_identity(scan_e: RExpr,
                 fn_name: str, params_text: str, prm: &MacroParams, h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    let src_name: str = sc.src_name;
    let row_ty: str   = sc.row_ty;

    // ── the item is a QUOTE (ADR 0024 S5) ─────────────────────────────────
    // The return type is where this peephole's whole content lives: `&[Row]`
    // rather than `Vec<Row>` is the collapse. It is now ONE type string handed
    // to the shell, not four raw text pushes whose `[`/`]` had to match.
    let mut rty: String = String::new();
    rty.push_str("Result<&[");
    rty.push_str(row_ty);
    rty.push_str("], ElError>");
    let s1: ExprBlob = parse_expr(src_name);
    emit_query_fn(fn_name, params_text, prm.tparams, rty.as_str(),
                  quote_block! { return Result::Ok(#(s1)); }, prm,
                  prep_ground(WG_IDENTITY(), input_axis(scan_e)));
    return true;
}

// ══════════════════════════════════════════════════════════════════════════
// The unified walker entry: match RExpr, dispatch to the per-shape emitter.
// `params_text`/`prm` (envelope) supply the VERBATIM signature + the parsed
// param list (scalar typing / limit validation); `fn_name` the generated fn
// name; `result_ty`/`has_result_ty` the explicit-result override.
// `sig` carries the Phase-3 peephole signals (empty / identity); when either is
// set the thin emitter above runs INSTEAD of the loop-nest walker.
// ══════════════════════════════════════════════════════════════════════════
pub fn emit_rexpr_opt(root: RExpr, empty: bool, identity: bool,
                      fn_name: str, params_text: str, prm: &MacroParams,
                      result_ty: str, has_result_ty: bool, sel_mode: i32,
                      prelude: str, h: &Writ) -> bool {
    // Phase-3 thin collapses (the root is always an RProj; peel it to reach the
    // scan for the signature). The single-row modes get their own thin forms:
    // empty → constant None; identity → head-row borrow. The THIN emitters do
    // NOT take the rel prelude: an empty collapse never reads a rel, and the
    // identity / head-row / find borrows are gated OFF rel sources upstream
    // (the program walker diagnoses whole-row selects + `find` over a rel).
    if empty || identity {
        match root {
            RExpr::Proj(p) => {
                let scan_e: RExpr = p.input_expr();
                if empty {
                    if sel_mode == SELM_FIND() {
                        return emit_none_find(scan_e, fn_name, params_text, prm, h);
                    }
                    return emit_empty(scan_e, p.sel, fn_name, params_text, prm, result_ty,
                                      has_result_ty, sel_mode == SELM_FIRST(), h);
                }
                if sel_mode != SELM_ALL() {
                    return emit_head_row(scan_e, fn_name, params_text, prm, h);
                }
                return emit_identity(scan_e, fn_name, params_text, prm, h);
            }
            _ => { }
        }
    }
    return emit_rexpr(root, fn_name, params_text, prm, result_ty, has_result_ty, sel_mode, prelude, h);
}

pub fn emit_rexpr(root: RExpr, fn_name: str,
                  params_text: str, prm: &MacroParams,
                  result_ty: str, has_result_ty: bool, sel_mode: i32,
                  prelude: str, h: &Writ) -> bool {
    // Peel the post-projection wrappers (RLimit over RDistinct — the lowering
    // order) and the RSort under the projection into the QMods envelope.
    let mut mods: QMods = qmods_none();
    let r1: RExpr = peel_limit(root, &mut mods);
    let r2: RExpr = peel_distinct(r1, &mut mods);
    // `limit <ident>` must reference a declared SCALAR param (build error else).
    if !check_limit_param(&mods, prm) { return false; }
    match r2 {
        RExpr::Proj(p) => {
            let body0: RExpr = p.input_expr();
            let body: RExpr = peel_sort(body0, &mut mods);
            let sel: WRef<SExpr> = p.sel;
            // FIND mode — the body is a (possibly filtered) scan; the selector is
            // the identity, so the emitter returns the row BORROW directly.
            if sel_mode == SELM_FIND() {
                let pl: Peeled = peel_filter(body);
                return emit_find(pl.inner, pl.pred, pl.has_pred, fn_name, params_text, prm, prelude, h);
            }
            let first: bool = sel_mode == SELM_FIRST();
            match body {
                RExpr::Join(jn) => { return emit_join_chain(jn.as_ref().view::<RExpr>(),
                                                      null_sref(), false, sel, mods,
                                                      fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                RExpr::Anti(an) => { return emit_join_chain(an.as_ref().view::<RExpr>(),
                                                      null_sref(), false, sel, mods,
                                                      fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                RExpr::Edge(ed) => { return emit_join_chain(ed.as_ref().view::<RExpr>(),
                                                      null_sref(), false, sel, mods,
                                                      fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                RExpr::Aggr(ag) => {
                    if first { error("wql!: `select first` is not supported on aggregate queries"); return false; }
                    let pl: Peeled = peel_filter(ag.input_expr());
                    return emit_aggregate(pl.inner, ag.key, ag.aggs_arr(), pl.pred, pl.has_pred,
                                          null_sref(), false, sel, mods,
                                          fn_name, params_text, prm, result_ty, has_result_ty, prelude, h);
                }
                RExpr::Filter(f) => {
                    // RFilter over a join/anti (the `where` sits above the join), over
                    // an aggregate (the HAVING filter over the group rows), or over a
                    // scan (simple with `where`).
                    match f.input_expr() {
                        RExpr::Join(jn) => { return emit_join_chain(jn.as_ref().view::<RExpr>(),
                                                              f.pred, true, sel, mods,
                                                              fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                        RExpr::Anti(an) => { return emit_join_chain(an.as_ref().view::<RExpr>(),
                                                              f.pred, true, sel, mods,
                                                              fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                        RExpr::Edge(ed) => { return emit_join_chain(ed.as_ref().view::<RExpr>(),
                                                              f.pred, true, sel, mods,
                                                              fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                        RExpr::Aggr(ag) => {
                            if first { error("wql!: `select first` is not supported on aggregate queries"); return false; }
                            let pl: Peeled = peel_filter(ag.input_expr());
                            return emit_aggregate(pl.inner, ag.key, ag.aggs_arr(), pl.pred, pl.has_pred,
                                                  f.pred, true, sel, mods,
                                                  fn_name, params_text, prm, result_ty, has_result_ty, prelude, h);
                        }
                        _ => {
                            return emit_simple(f.input_expr(), f.pred, true, sel, mods,
                                               fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h);
                        }
                    }
                }
                _ => {
                    // Bare RScan — simple, no `where`.
                    return emit_simple(body, null_sref(), false, sel, mods,
                                       fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h);
                }
            }
        }
        _ => { error("wql!: unexpected relational algebra root (expected a projection)"); return false; }
    }
}

// The RScan bound under a (possibly wrapped) input. TOTAL over the algebra
// (every compound node recurses into its input / left child) — an unexpected
// shape resolves to SOME scan rather than diverging.
fn scan_of(e: RExpr) -> RScan {
    match e {
        RExpr::Scan(sc)     => { return sc; }
        RExpr::Filter(f)    => { return scan_of(f.input_expr()); }
        RExpr::Sort(s)      => { return scan_of(s.input_expr()); }
        RExpr::Proj(p)      => { return scan_of(p.input_expr()); }
        RExpr::Limit(l)     => { return scan_of(l.input_expr()); }
        RExpr::Distinct(d)  => { return scan_of(d.input_expr()); }
        RExpr::Aggr(ag)     => { return scan_of(ag.input_expr()); }
        RExpr::Join(jn)     => { return scan_of(jn.left_expr()); }
        RExpr::Anti(an)     => { return scan_of(an.left_expr()); }
        RExpr::Edge(ed)     => { return scan_of(ed.input_expr()); }
        RExpr::Fix(fx)      => { return scan_of(fx.base.any().view::<RExpr>()); }
    }
}

// ── emit_simple — scan / filter / [sort] / project / [distinct/limit] ─────────
// Base shape mirrors walk_simple; with an `order by` the matching row INDICES +
// their keys are materialized and insertion-sorted (stable, O(n²) MVP codegen)
// before the projection loop; `distinct` dedups the projected values (linear
// scan); `limit` caps the output via the loop condition.
// `first` (SELM_FIRST) — single-row mode: `-> Option<E>`; without `order by`
// the scan loop EARLY-RETURNS `Option::Some(proj)` on the first match (genuinely
// lazy, no Vec); with `order by` the (key, index) permutation is sorted first
// and only the HEAD row is projected. distinct/limit are diagnosed away
// upstream, so `mods` carries only the sort here.
fn emit_simple(scan_e: RExpr, pred: WRef<SExpr>, has_where: bool, sel: WRef<SExpr>,
               mods: QMods,
               fn_name: str, params_text: str, prm: &MacroParams,
               result_ty0: str, has_result_ty: bool, first: bool,
               prelude: str, h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    let src_name: str = sc.src_name;
    let row_ty: str   = sc.row_ty;
    let var_name: str = sc.var_name;

    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, row_ty, var_name);
    stamp_rel_source(&mut ty, &view, prm, src_name, var_name);
    apply_scalar_params(&mut ty, &view, prm);
    stamp_udfs_from_module(&view, &mut ty);

    let proj_sexpr: SExpr = sel.any().view::<SExpr>();

    if !check_calls(proj_sexpr, &ty, "wql!: `select`") { return false; }

    let proj_opt: SExpr = simplify_sexpr(proj_sexpr, h).any().view::<SExpr>();
    let mut body: String = String::new();
    emit_proj_value(&mut body, proj_opt, &ty, var_name);

    let mut result_ty: str = result_ty0;
    if !has_result_ty {
        result_ty = infer_emit_ty(proj_opt, &ty);
        // A String-returning call (upper/lower or a String UDF) projects an
        // OWNED element: Vec<String> / Option<String> — a borrowed `str` view
        // of the call's temporary would dangle.
        if returns_string(proj_opt, &ty) { result_ty = "String"; }
    }
    // Tuple projection (`select (a, b, …)`): multi-column rows — the element
    // type is the native tuple type text (Vec<(T1,T2)> / Option<(T1,T2)>).
    let mut tuple_tt: String = String::new();
    let tres: i32 = tuple_result(proj_opt, &ty, has_result_ty, mods.distinct, &mut tuple_tt);
    if tres < 0i32 { return false; }
    if tres > 0i32 { result_ty = string_as_str(&tuple_tt); }
    let is_comp: bool = is_comp_root(proj_opt);
    if !has_result_ty && is_comp {
        result_ty = el_class_repr(comp_head_ty(proj_opt, &ty));
    }
    let mut elem_ty: String = String::new();
    if is_comp {
        elem_ty.push_str("Vec<");
        elem_ty.push_str(result_ty);
        elem_ty.push_str(">");
    } else {
        elem_ty.push_str(result_ty);
    }
    let result_elem: str = string_as_str(&elem_ty);

    let mut pred_body: String = String::new();
    if has_where {
        let pred_sexpr: SExpr = pred.any().view::<SExpr>();
        if !reject_tuple(pred_sexpr, "wql!: `where`") { return false; }
        if !check_calls(pred_sexpr, &ty, "wql!: `where`") { return false; }
        let pred_opt: SExpr = simplify_sexpr(pred_sexpr, h).any().view::<SExpr>();
        emit_sexpr(&mut pred_body, pred_opt, &ty, var_name);
    }

    // The optional `order by` key: emitted body + its EL value type (i64/f64/str).
    let mut key_body: String = String::new();
    let mut key_ty: str = "i64";
    if mods.has_sort {
        let key_e: SExpr = mods.sort_key.any().view::<SExpr>();
        if !reject_tuple(key_e, "wql!: `order by`") { return false; }
        if !check_calls(key_e, &ty, "wql!: `order by`") { return false; }
        let key_opt: SExpr = simplify_sexpr(key_e, h).any().view::<SExpr>();
        let key_tn: str = infer_ty_name(key_opt, &ty);
        key_ty = infer_emit_ty(key_opt, &ty);
        if !key_norm_ok(key_tn, key_ty, "wql!: `order by`") { return false; }
        let mut kb0: String = String::new();
        emit_sexpr(&mut kb0, key_opt, &ty, var_name);
        key_body = key_norm_body(string_as_str(&kb0), key_tn, key_ty);
    }

    // ══ the BODY is a QUOTE too (ADR 0024 S5) ═════════════════════════════
    // Only the SCALAR clauses arrive as text: `emit_sexpr` renders a `where` /
    // `select` / `order by` body and `parse_expr` reifies it, because that
    // lowering lives in codegen.logos and is a different arc. Everything this
    // emitter itself decides — the loop, the guard, the binding names, the
    // element type, which of the three scan shapes runs — is STRUCTURE.
    //
    // ⚠ WHAT BLOCKED THIS was recorded as TIMING — "a factory-generated handle
    // (`Hs…` in `logos.gen`) is registered a round after a spliced item is
    // checked". It was not. The chunk route imported `logos.gen` all along (the
    // natspec carries the source type's defining package, and `native_use_text`
    // renders it); the quote route did not, because the runtime-sized import
    // list `#( use #us; )*` was a NO-OP — the quote's USES array was never
    // numbered by the lowering, so every antiquoted import was dropped at
    // splice time. Once imports actually travel, the signature resolves in the
    // round it is checked and no round has to move.
    let pre_f:  ExprBlob = prelude_frag(prelude);
    let src_f:  ExprBlob = parse_expr(src_name);
    let row_f:  ExprBlob = parse_type(row_ty);
    let elem_f: ExprBlob = parse_type(result_elem);
    let proj_f: ExprBlob = parse_expr(string_as_str(&body));
    let vnm:    Ident    = Ident::new(var_name);

    let mut rty: String = String::new();
    if first {
        rty.push_str("Result<Option<");
        rty.push_str(result_elem);
        rty.push_str(">, ElError>");
    } else {
        rty.push_str("Result<Vec<");
        rty.push_str(result_elem);
        rty.push_str(">, ElError>");
    }

    // The per-row TAIL — what happens once a row is bound and the filter
    // passed. `first` early-returns the projection; otherwise the guarded push.
    let mut hit_f: ExprBlob = quote_block! { };
    if first {
        hit_f = quote_block! { return Result::Ok(Option::Some(#(proj_f))); };
    } else {
        hit_f = push_guarded_frag(result_elem, proj_f, mods.distinct);
    }
    let mut row_f2: ExprBlob = hit_f;
    if has_where {
        let pred_f: ExprBlob = parse_expr(string_as_str(&pred_body));
        row_f2 = quote_block! { if #(pred_f) #(hit_f) };
    }

    let mut scan_f: ExprBlob = quote_block! { };
    if mods.has_sort {
        // Phase 1: collect matching row indices + sort keys.
        let key_f:  ExprBlob = parse_expr(string_as_str(&key_body));
        let keyt_f: ExprBlob = parse_type(key_ty);
        let mut coll_f: ExprBlob = quote_block! {
            __ix0.push(__i);
            __ks.push(#(key_f));
        };
        if has_where {
            let pred_f: ExprBlob = parse_expr(string_as_str(&pred_body));
            coll_f = quote_block! { if #(pred_f) #(coll_f) };
        }
        // Phase 2: stable insertion sort of the (key, index) permutation.
        let sort_f: ExprBlob = sort_perm_frag(key_ty, mods.sort_desc, 1i64);
        // Phase 3: project in sorted order — the HEAD row only under `first`,
        // else every row (distinct dedups; limit caps).
        let mut proj_phase: ExprBlob = quote_block! { };
        if first {
            proj_phase = quote_block! {
                if __ix0.len() > 0i64 {
                    let #vnm: &#(row_f) = &(#(src_f))[__ix0.get(0i64)];
                    return Result::Ok(Option::Some(#(proj_f)));
                }
            };
        } else {
            let push_f: ExprBlob = push_guarded_frag(result_elem, proj_f, mods.distinct);
            let mut ocond: ExprBlob = quote_expr! { __o < __ix0.len() };
            if mods.has_limit {
                let lim_f: ExprBlob = limit_expr(&mods);
                ocond = quote_expr! { __o < __ix0.len() && __out.len() < (#(lim_f)) };
            }
            proj_phase = quote_block! {
                let mut __o: i64 = 0i64;
                while #(ocond) {
                    let #vnm: &#(row_f) = &(#(src_f))[__ix0.get(__o)];
                    #(push_f);
                    __o = __o + 1i64;
                }
            };
        }
        scan_f = quote_block! {
            let mut __ix0: Vec<i64> = Vec::<i64>::new();
            let mut __ks: Vec<#(keyt_f)> = Vec::<#(keyt_f)>::new();
            let mut __i: i64 = 0i64;
            while __i < (#(src_f)).len() {
                let #vnm: &#(row_f) = &(#(src_f))[__i];
                #(coll_f);
                __i = __i + 1i64;
            }
            #(sort_f);
            #(proj_phase);
        };
    } else if prm.rel_src_streams(src_name) {
        // STREAMED (ADR 0024 S4). The plan proved this source is read exactly
        // once, so no Vec is built: rows arrive from `next()` and the loop ends
        // when the iterator does. With `first` this is the whole point — the
        // walk stops at the first match instead of materializing every row that
        // could have matched and then taking one.
        let mut brk_f: ExprBlob = quote_block! { };
        if mods.has_limit {
            let lim_f: ExprBlob = limit_expr(&mods);
            brk_f = quote_block! { if !(__out.len() < (#(lim_f))) { break; } };
        }
        // The row type is ANNOTATED, not inferred. `next()` is a trait method
        // whose result type is the trait's parameter, so inferring it means
        // selecting the impl — and where the source is spelled as an associated
        // type (`&<typeof(C) as CtrFamily>::Handle`) that selection has not
        // happened yet and the type var escapes. The plan knows the row type;
        // withholding it would be the emitter pretending it does not.
        scan_f = quote_block! {
            loop {
                #(brk_f);
                let __opt: Option<#(row_f)> = (#(src_f)).next();
                if __opt.is_none() { break; }
                let __row: #(row_f) = __opt.unwrap();
                let #vnm: &#(row_f) = &__row;
                #(row_f2);
            }
        };
    } else {
        let mut cond: ExprBlob = quote_expr! { __i < (#(src_f)).len() };
        if mods.has_limit {
            let lim_f: ExprBlob = limit_expr(&mods);
            cond = quote_expr! { __i < (#(src_f)).len() && __out.len() < (#(lim_f)) };
        }
        scan_f = quote_block! {
            let mut __i: i64 = 0i64;
            while #(cond) {
                let #vnm: &#(row_f) = &(#(src_f))[__i];
                #(row_f2);
                __i = __i + 1i64;
            }
        };
    }

    let mut head_f: ExprBlob = quote_block! {
        let mut __out: Vec<#(elem_f)> = Vec::<#(elem_f)>::new();
    };
    let mut tail_f: ExprBlob = quote_block! { return Result::Ok(__out); };
    if first {
        head_f = quote_block! { };
        tail_f = quote_block! { return Result::Ok(Option::None); };
    }
    let body_f: ExprBlob = quote_block! {
        #(pre_f);
        #(head_f);
        #(scan_f);
        #(tail_f);
    };
    emit_query_fn(fn_name, params_text, prm.tparams, rty.as_str(), body_f, prm,
                  prep_ground(WG_SCAN(), input_axis(scan_e)));
    return true;
}

// ── emit_find — single-row BORROW scan (`from src v find P`) ──────────────────
// The generated fn returns `Option<&Ty>` — a borrow of the FIRST row matching
// the predicate (zero-copy; the emit_identity accessor-collapse precedent shows
// returning borrows of the slice param works), `Option::None` when no row
// matches. Early-exit loop — no Vec, no materialization. Scalar params from the
// deem!(…) list may be referenced BARE in the predicate (typed off the list).
fn emit_find(scan_e: RExpr, pred: WRef<SExpr>, has_pred: bool,
             fn_name: str, params_text: str, prm: &MacroParams,
             prelude: str, h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    let src_name: str = sc.src_name;
    let row_ty: str   = sc.row_ty;
    let var_name: str = sc.var_name;

    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, row_ty, var_name);
    stamp_rel_source(&mut ty, &view, prm, src_name, var_name);
    apply_scalar_params(&mut ty, &view, prm);
    stamp_udfs_from_module(&view, &mut ty);

    let mut pred_body: String = String::new();
    if has_pred {
        let pred_sexpr: SExpr = pred.any().view::<SExpr>();
        if !reject_tuple(pred_sexpr, "wql!: `find`") { return false; }
        if !check_calls(pred_sexpr, &ty, "wql!: `find`") { return false; }
        let pred_opt: SExpr = simplify_sexpr(pred_sexpr, h).any().view::<SExpr>();
        emit_sexpr(&mut pred_body, pred_opt, &ty, var_name);
    }

    // ── the item AND the body are a QUOTE (ADR 0024 S5) ───────────────────
    // The predicate is the only text: it comes from `emit_sexpr` (codegen.logos,
    // a different arc) and `parse_expr` reifies it. What this replaces is a fn
    // assembled by concatenation, where a missing `>` or a stray space failed
    // as a syntax error inside generated source with no position a reader
    // could use.
    let pre_f: ExprBlob = prelude_frag(prelude);
    let src_f: ExprBlob = parse_expr(src_name);
    let row_f: ExprBlob = parse_type(row_ty);
    let vnm:   Ident    = Ident::new(var_name);

    let mut hit_f: ExprBlob = quote_block! { return Result::Ok(Option::Some(#vnm)); };
    if has_pred {
        let pred_f: ExprBlob = parse_expr(string_as_str(&pred_body));
        hit_f = quote_block! { if #(pred_f) #(hit_f) };
    }
    let body_f: ExprBlob = quote_block! {
        #(pre_f);
        let mut __i: i64 = 0i64;
        while __i < (#(src_f)).len() {
            let #vnm: &#(row_f) = &(#(src_f))[__i];
            #(hit_f);
            __i = __i + 1i64;
        }
        return Result::Ok(Option::None);
    };

    // The imports a native source's materializer needs are a RUNTIME list —
    // one module per source the query binds — carried by a repeat rather than
    // by a row of slots sized for the worst case.
    let mut rty: String = String::new();
    rty.push_str("Result<Option<&");
    rty.push_str(row_ty);
    rty.push_str(">, ElError>");
    emit_query_fn(fn_name, params_text, prm.tparams, rty.as_str(), body_f, prm,
                  prep_ground(WG_SCAN(), input_axis(scan_e)));
    return true;
}

// ══════════════════════════════════════════════════════════════════════════
// JOIN CHAINS + the per-step JOIN-STRATEGY CASCADE (hash / tree / loop).
// ══════════════════════════════════════════════════════════════════════════
//
// The lowered join body is a LEFT-DEEP tree of binary RJoin/RAnti nodes over
// RScan leaves — `RJoin(RJoin(RScan a, RScan b, on1), RScan c, on2)`.
// `collect_chain` linearizes it back to base + steps; the emitter walks the
// steps LEFT-TO-RIGHT emitting one nested per-source probe/loop level each,
// with ONE shared inner body (where-filter → sort collection / early-return
// `first` / guarded distinct/limit push) at the innermost level — so every
// select-tail modifier composes over joined rows exactly as it does over a
// single source.
//
// Per step the on-predicate is analyzed at METACALL time (`analyze_step`):
//   1. the top-level `&&` conjunction splits into terms;
//   2. an EQUI-TERM is `<bound-side> == <new-side>` (either order) where one
//      side references ONLY already-bound vars / scalar params (or consts)
//      and the other ONLY the step's NEW row var. Everything else — non-`==`
//      terms, same-side terms, mixed-type `==` (int vs float) — is RESIDUAL,
//      checked after the probe. The FIRST usable equi-term supplies the key;
//      any remaining equi-terms simply join the residual (COMPOSITE KEYS
//      DEFERRED — one key column per step today);
//   3. the key's EL value-type selects the strategy BY CAPABILITY
//      (`join_key_caps` — the single seam a future structural-key version
//      swaps for metaprog has_trait queries).
//
// ⚠ STEPS 1-3 ARE NOT THIS FILE'S ANY MORE (ADR 0024 S4). They live in
// `logos.std.wql.join_sel` and run in the PLANNER, before the prelude decides
// whether each source materializes or streams — because hash and tree read the
// step's source exactly once and loop does not, which is precisely the fact
// materialize-vs-stream needs. The emitter READS `RJoin.jstrat`/`jkey`/`jsel`
// off the node and composes text from them. It re-decides only for a node no
// planner reached (`JS_NONE`), and a step whose source STREAMS must carry a
// decision that reads once — asserted below, because getting that wrong emits
// a rescan of a consumed iterator, which loses rows in silence.
//
// The tiers the decision selects:
//        Hash+Eq (i64/str/bool) → HASH — HashMap<K, Vec<i64>> (key → row
//                                 indices) built ONCE over the new source,
//                                 probed per bound-row; residual checked per
//                                 bucket hit. anti + no residual → HashSet<K>
//                                 absence test; anti + residual → bucket scan,
//                                 absent-or-all-fail.
//        Ord only               → TREE — the same shape over BTreeMap<K,
//                                 Vec<i64>>. UNREACHABLE with today's scalar
//                                 lattice (every Hash-able scalar is Ord and
//                                 vice versa, except f64 which is neither);
//                                 kept LIVE for future Ord-only key types.
//        PartialEq only (f64)   → NESTED LOOP over the FULL predicate (NaN
//                                 kills Hash and total Ord; `==` on the key
//                                 is still meaningful).
//        none                   → error() (unreachable today; the branch
//                                 exists for future structural keys).
//   No equi-term at all → nested loop on the full step predicate.
//
// Bucket payloads are row INDICES in scan order over an INDEXABLE source, so
// probe hits replay in source order and the joined-row ordering matches the
// nested-loop baseline exactly (order-sensitive e2e expectations are
// preserved). A STREAMED step has no indexable source at all: its build phase
// drains the iterator and the buckets hold the ROWS themselves, in arrival
// order — the same replay order, one structure instead of two.

// ── JChain — the linearized join chain (base + steps) ────────────────────────
// `edge[i]` — TRAVERSAL step (slice D): `src[i]` is the full field-path source
// EXPRESSION (`d.emps`, walker-stamped) rather than a slice-param name; the
// strategy cascade is BYPASSED (always nested-loop — the source depends on
// outer row vars, so no build-once index exists) and `onw[i]` may be 0 (no
// `on` — containment IS the join). `byval[i]` — the step binds a SCALAR
// element (Vec<str> → `let s: str = (e.skills)[j]`) by VALUE (Copy lattice),
// not by reference.
// `jstrat`/`jkey`/`jsel`/`jwhy` — the PLAN'S DECISION, carried off the node
// (`JS_NONE` = no planner reached it; see analyze_chain).
struct JChain {
    base_src: str,
    base_ty:  str,
    base_var: str,
    n:    i64,
    src:  [str; 8],
    ty:   [str; 8],
    var:  [str; 8],
    anti: [bool; 8],
    onw:  [i64; 8],     // raw arena words of the per-step on-pred edges (0 = none)
    edge:  [bool; 8],
    byval: [bool; 8],
    jstrat: [i32; 8],
    jkey:   [i32; 8],
    jsel:   [i64; 8],
    jwhy:   [str; 8],
}

fn jchain_new() -> JChain {
    return JChain { base_src: "", base_ty: "", base_var: "", n: 0i64,
                    src:  ["", "", "", "", "", "", "", ""],
                    ty:   ["", "", "", "", "", "", "", ""],
                    var:  ["", "", "", "", "", "", "", ""],
                    anti: [false; 8],
                    onw:  [0i64; 8],
                    edge:  [false; 8],
                    byval: [false; 8],
                    jstrat: [0i32; 8],
                    jkey:   [0i32; 8],
                    jsel:   [-1i64; 8],
                    jwhy:   ["", "", "", "", "", "", "", ""] };
}

// ── WAS THERE AN ORDER AXIS AT ALL? (ADR 0024 S4p) ───────────────────────────
/// THE CENSUS STATE OF A SHAPE THAT NEVER CALLS `decide_join_orders`. `AX_REFUSED`
/// where the query has at least one join step — the axis exists and the emitter's
/// ground is what refused it — and `AX_NONE` where it has none.
///
/// ⚠⚠ THIS EXISTS BECAUSE THE STATE WAS READ OFF THE GROUND CODE'S RANGE FOR A ROUND
/// AND THE READING WAS WRONG. Three of the grounds these emitters record — `WG_AGG`,
/// `WG_FALSE_FILTER`, `WG_FALSE_PRED` — apply to a bare scan and to a join chain
/// alike, so no assignment of them to a band can be right for both, and the band they
/// were in said "no axis": `wql_join_group_e2e::region_totals` and eight more corpus
/// plans announced "this query has no join whose order a plan could choose" one trace
/// line under their own `[plan] d -> hash join on i64`, two of them while carrying an
/// `order by`. The shape emitter holds the chain and is the only thing that knows.
fn chain_axis(n: i64) -> i32 {
    if n > 0i64 { return AX_REFUSED(); }
    return AX_NONE();
}

/// The same question asked of an un-linearized input. `emit_aggregate` and
/// `emit_join_chain` already hold a `JChain` and pass `ch.n` to `chain_axis`
/// directly; the thin emitters do not, so they walk the spine once here.
fn input_axis(e: RExpr) -> i32 {
    let mut ch: JChain = jchain_new();
    collect_chain(e, &mut ch);
    return chain_axis(ch.n);
}

// Walk the left spine of the binary join tree: the recursion bottoms out at
// the base scan, then each unwind appends one step (source order preserved).
fn collect_chain(e: RExpr, ch: &mut JChain) {
    match e {
        RExpr::Join(jn) => {
            collect_chain(jn.left_expr(), ch);
            let rs: RScan = scan_of(jn.right_expr());
            if ch.n < 8i64 {
                ch.src[ch.n] = rs.src_name;
                ch.ty[ch.n]  = rs.row_ty;
                ch.var[ch.n] = rs.var_name;
                ch.anti[ch.n] = false;
                ch.onw[ch.n]  = jn.on.any().raw();
                ch.jstrat[ch.n] = jn.jstrat;
                ch.jkey[ch.n]   = jn.jkey;
                ch.jsel[ch.n]   = jn.jsel as i64;
                ch.jwhy[ch.n]   = jn.jwhy;
                ch.n = ch.n + 1i64;
            }
            return;
        }
        RExpr::Anti(an) => {
            collect_chain(an.left_expr(), ch);
            let rs: RScan = scan_of(an.right_expr());
            if ch.n < 8i64 {
                ch.src[ch.n] = rs.src_name;
                ch.ty[ch.n]  = rs.row_ty;
                ch.var[ch.n] = rs.var_name;
                ch.anti[ch.n] = true;
                ch.onw[ch.n]  = an.on.any().raw();
                ch.jstrat[ch.n] = an.jstrat;
                ch.jkey[ch.n]   = an.jkey;
                ch.jsel[ch.n]   = an.jsel as i64;
                ch.jwhy[ch.n]   = an.jwhy;
                ch.n = ch.n + 1i64;
            }
            return;
        }
        RExpr::Edge(ed) => {
            // TRAVERSAL step (slice D): unary — recurse into the input, then
            // append one edge step (src = the field-path expression text).
            collect_chain(ed.input_expr(), ch);
            if ch.n < 8i64 {
                ch.src[ch.n]   = ed.src;
                ch.ty[ch.n]    = ed.row_ty;
                ch.var[ch.n]   = ed.var_name;
                ch.anti[ch.n]  = ed.is_anti;
                ch.edge[ch.n]  = true;
                ch.byval[ch.n] = el_ret_class(ed.row_ty) >= 0i32;
                if ed.has_on { ch.onw[ch.n] = ed.on.any().raw(); }
                else         { ch.onw[ch.n] = 0i64; }
                ch.n = ch.n + 1i64;
            }
            return;
        }
        _ => {
            let sc: RScan = scan_of(e);
            ch.base_src = sc.src_name;
            ch.base_ty  = sc.row_ty;
            ch.base_var = sc.var_name;
        }
    }
}

// Rebuild an SExpr view from a raw arena word (the provenance-laundering idiom).
fn sexpr_of_word(w: i64) -> SExpr { return WAny::ref_to(w as *const u8).view::<SExpr>(); }

// Compose ONE step's emitted TEXT from the decision the plan already made.
// This function no longer CHOOSES anything: `sel` is the index, in the split of
// the const-folded `on` conjunction, of the term the planner took as the equi-
// key (-1 = none). `build`/`probe` receive that term's new-side and bound-side
// halves; `resid` receives the AND of every other term; `pred` always receives
// the FULL simplified predicate (the nested-loop tier's condition). Returns
// whether a residual exists.
//
// The split is `join_sel::step_terms`, the same call the planner made, so term
// index `sel` denotes the same term here as it did there.
fn emit_step_texts(on_ref: WRef<SExpr>, new_var: str, sel: i64, ktn: str,
                   t: &ElTypes, var0: str, h: &Writ,
                   build: &mut String, probe: &mut String,
                   resid: &mut String, pred: &mut String) -> bool {
    let st: StepTerms = step_terms(on_ref, h);
    emit_sexpr(pred, st.opt.any().view::<SExpr>(), t, var0);
    if sel < 0i64 { return false; }
    let tl: TermList = st.tl;
    // Which half of the key term is the build side is `equi_term_sides` — the
    // same function that made the term selectable, asked again rather than
    // re-derived.
    //
    // ⚠ BOTH HALVES ARE NORMALIZED INTO THE INDEX'S KEY TYPE, by the same
    // function the sort key uses. The index is declared `HashMap<ktn, …>`, and
    // when a side's own type is narrower (`x.a: u32` probing an `i64` build)
    // inserting it raw is a `let '__k1': expected i64, got u32` inside a
    // generated chunk. `key_norm_body` emits nothing when the side already IS
    // `ktn`, which is the common case now that `ktn` is the sides' own type.
    let sd: EquiSides = equi_term_sides(sexpr_of_word(tl.w[sel]), new_var);
    let mut b0: String = String::new();
    let mut p0: String = String::new();
    emit_sexpr(&mut b0, sexpr_of_word(sd.bw), t, var0);
    emit_sexpr(&mut p0, sexpr_of_word(sd.pw), t, var0);
    let bn: String = key_norm_body(string_as_str(&b0),
                                   infer_ty_name(sexpr_of_word(sd.bw), t), ktn);
    let pn: String = key_norm_body(string_as_str(&p0),
                                   infer_ty_name(sexpr_of_word(sd.pw), t), ktn);
    build.push_str(string_as_str(&bn));
    probe.push_str(string_as_str(&pn));
    let mut k: i64 = 0i64;
    let mut none_yet: bool = true;
    while k < tl.n {
        if k != sel {
            if !none_yet { resid.push_str(" && "); }
            resid.push_str("(");
            emit_sexpr(resid, sexpr_of_word(tl.w[k]), t, var0);
            resid.push_str(")");
            none_yet = false;
        }
        k = k + 1i64;
    }
    return !none_yet;
}

// Analyze EVERY step of a chain into the caller's parallel arrays.
//
// The STRATEGY is READ, not chosen: `ch.jstrat[i]` came off the IR node, where
// the planner recorded it before the prelude decided materialize-vs-stream.
// A node the planner never reached carries `JS_NONE` — today that is a rel
// body's own join chain, which is emitted from a program that has rel blocks,
// and a rel block already forces every source to materialize. Such a node is
// decided here, by the SAME rule, and the assertion below is what keeps that
// fallback from ever meeting a streamed source.
//
// TRAVERSAL steps (edge) are nested loops by construction: containment has no
// key and the source expression is re-derived per bound row.
//
// ⚠ THE ASSERTION. A streamed source is an iterator that yields its rows once.
// A LOOP step rescans its source per bound row, so pairing the two produces a
// join that silently drops every row after the first bound one. The plan
// promises this cannot happen (it only marks a step read-once when its
// strategy reads once); the check is here because the cost of the promise
// being broken is silence rather than a crash.
fn analyze_chain(ch: &JChain, t: &ElTypes, var0: str, h: &Writ, prm: &MacroParams,
                 st_build: &mut [String; 8], st_probe: &mut [String; 8],
                 st_resid: &mut [String; 8], st_pred: &mut [String; 8],
                 st_strat: &mut [i32; 8], st_ktn: &mut [str; 8],
                 st_hasres: &mut [bool; 8], st_equi: &mut [bool; 8],
                 st_stream: &mut [bool; 8]) -> bool {
    let mut i: i64 = 0i64;
    while i < ch.n {
        st_stream[i] = prm.rel_src_streams(ch.src[i]);
        if ch.edge[i] {
            st_strat[i]  = JS_LOOP();
            st_ktn[i]    = "";
            st_hasres[i] = false;
            st_equi[i]   = false;
            if ch.onw[i] != 0i64 {
                let on_opt: WRef<SExpr> = simplify_sexpr(sexpr_of_word(ch.onw[i]), h);
                emit_sexpr(&mut st_pred[i], on_opt.any().view::<SExpr>(), t, var0);
            } else {
                st_pred[i].push_str("true");
            }
        } else {
            let onr: WRef<SExpr> = WRef::<SExpr>::from_any(WAny::ref_to(ch.onw[i] as *const u8));
            let mut strat: i32 = ch.jstrat[i];
            let mut kty: i32   = ch.jkey[i];
            let mut sel: i64   = ch.jsel[i];
            // The key's EMITTED type — the index map's key type and the type both
            // key expressions must reach. Re-derived from the SAME term index the
            // plan recorded, so the pre-decided path and the decide-here path
            // cannot disagree: `step_key_ty_of` is a function of that term.
            let mut ktn: str = el_class_repr(kty);
            if strat == JS_NONE() {
                let ss: StepSel = decide_join_step(onr, ch.var[i], t, h);
                strat = ss.strat; kty = ss.key_ty; sel = ss.sel; ktn = ss.key_tn;
                // Traced HERE because this is where it was decided. A step the
                // planner decided was already traced there, and echoing it
                // would put the same decision in the log twice.
                plan_trace(ch.var[i], js_name(strat), ktn, ss.why);
            } else if sel >= 0i64 {
                let stt: StepTerms = step_terms(onr, h);
                if sel < stt.tl.n {
                    let sd2: EquiSides = equi_term_sides(sexpr_of_word(stt.tl.w[sel]), ch.var[i]);
                    if sd2.bw != 0i64 {
                        ktn = step_key_ty_of(sexpr_of_word(sd2.bw), sexpr_of_word(sd2.pw), t, kty);
                    }
                }
            }
            if st_stream[i] && !js_reads_once(strat) {
                let mut m: String = String::new();
                m.push_str("wql!: internal — join step over `");
                m.push_str(ch.src[i]);
                m.push_str("` is streamed but its strategy rescans the source; the plan proved a single read that the emitted shape does not have");
                error(string_as_str(&m));
                return false;
            }
            st_strat[i]  = strat;
            st_hasres[i] = emit_step_texts(onr, ch.var[i], sel, ktn, t, var0, h,
                                           &mut st_build[i], &mut st_probe[i],
                                           &mut st_resid[i], &mut st_pred[i]);
            st_ktn[i]    = ktn;
            st_equi[i]   = sel >= 0i64;
        }
        i = i + 1i64;
    }
    return true;
}

// ── Build phase (once per hash/tree step, before the loop nest) ──────────────
// Index the step's source by the NEW-side key: HashMap<K, Vec<Payload>> — or
// HashSet<K> for anti-without-residual (pure absence test) — or BTreeMap<K,
// Vec<Payload>> on the (today unreachable) Ord-only tier. NOTE: BTreeMap has no
// auto-Drop yet (btreemap_free is manual), so the tree index leaks at fn exit —
// acceptable for the unreachable tier; revisit when a real Ord-only key type
// lands.
//
// THE PAYLOAD depends on whether the source can be revisited:
//
//   INDEXABLE source (a slice) — the payload is the row INDEX. The rows already
//     live somewhere addressable, so storing anything else would copy them.
//   STREAMED source (`streams`) — the payload is the ROW. There is no index to
//     store: the iterator yields each row once and the plan proved this build is
//     that one reading, so the bucket IS where the rows live from here on. That
//     is the whole win — before, a streamable step source was drained into a
//     `Vec` in the prelude AND indexed into a HashMap here, two structures for
//     one pass; now the hash index is the only one.
//
// Both keep arrival order within a bucket, so probe hits replay in source order
// exactly as the nested-loop baseline does.
fn payload_ty_frag(streams: bool, ty: str) -> ExprBlob {
    if streams { return parse_type(ty); }
    return parse_type("i64");
}

fn build_phase_frag(s: i64, strat: i32, anti: bool, has_resid: bool,
                    ktn: str, src: str, ty: str, var: str, build_key: str,
                    streams: bool) -> ExprBlob {
    if strat == JS_LOOP() { return quote_block! { }; }
    let set_form: bool = strat == JS_HASH() && anti && !has_resid;

    // ⚠ Every generated name is a String LOCAL of this frame: `Ident::new`
    // borrows, so the storage has to outlive the quote that packs it.
    let s_hs: String = nk_str("__hs", s);   let n_hs: Ident = Ident::new(string_as_str(&s_hs));
    let s_sp: String = nk_str("__sp", s);   let n_sp: Ident = Ident::new(string_as_str(&s_sp));
    let s_hm: String = nk_str("__hm", s);   let n_hm: Ident = Ident::new(string_as_str(&s_hm));
    let s_mp: String = nk_str("__mp", s);   let n_mp: Ident = Ident::new(string_as_str(&s_mp));
    let s_bt: String = nk_str("__bt", s);   let n_bt: Ident = Ident::new(string_as_str(&s_bt));
    let s_tp: String = nk_str("__tp", s);   let n_tp: Ident = Ident::new(string_as_str(&s_tp));
    let s_bo: String = nk_str("__bo", s);   let n_bo: Ident = Ident::new(string_as_str(&s_bo));
    let s_br: String = nk_str("__br", s);   let n_br: Ident = Ident::new(string_as_str(&s_br));
    let s_b:  String = nk_str("__b",  s);   let n_b:  Ident = Ident::new(string_as_str(&s_b));
    let s_k:  String = nk_str("__k",  s);   let n_k:  Ident = Ident::new(string_as_str(&s_k));
    let s_vp: String = nk_str("__vp", s);   let n_vp: Ident = Ident::new(string_as_str(&s_vp));
    let s_nv: String = nk_str("__nv", s);   let n_nv: Ident = Ident::new(string_as_str(&s_nv));

    let kt:    ExprBlob = parse_type(ktn);
    let rowt:  ExprBlob = parse_type(ty);
    let src_f: ExprBlob = parse_expr(src);
    let key_f: ExprBlob = parse_expr(build_key);
    let vnm:   Ident    = Ident::new(var);

    // Container + ONE raw pointer to it, taken at the declaration (the
    // std_hashmap_full idiom): all build/probe access goes through the pointer,
    // so the `&mut` borrow is taken exactly once — bc-clean across the fn.
    let mut decl: ExprBlob = quote_block! { };
    if set_form {
        decl = quote_block! {
            let mut #n_hs: HashSet<#(kt)> = hashset_new::<#(kt)>();
            let #n_sp: *mut HashSet<#(kt)> = &mut #n_hs;
        };
    } else if strat == JS_HASH() {
        let p1: ExprBlob = payload_ty_frag(streams, ty);
        let p2: ExprBlob = payload_ty_frag(streams, ty);
        let p3: ExprBlob = payload_ty_frag(streams, ty);
        decl = quote_block! {
            let mut #n_hm: HashMap<#(kt), Vec<#(p1)>> = hashmap_new::<#(kt), Vec<#(p2)>>();
            let #n_mp: *mut HashMap<#(kt), Vec<#(p3)>> = &mut #n_hm;
        };
    } else {
        let p1: ExprBlob = payload_ty_frag(streams, ty);
        let p2: ExprBlob = payload_ty_frag(streams, ty);
        let p3: ExprBlob = payload_ty_frag(streams, ty);
        decl = quote_block! {
            let mut #n_bt: BTreeMap<#(kt), Vec<#(p1)>> = btreemap_new::<#(kt), Vec<#(p2)>>();
            let #n_tp: *mut BTreeMap<#(kt), Vec<#(p3)>> = &mut #n_bt;
        };
    }

    // The per-row INSERT — the payload is the row index, or the row itself
    // when the source streams.
    let mut ins: ExprBlob = quote_block! { };
    if set_form {
        ins = quote_block! { unsafe { let _nb: bool = #n_sp.insert(#n_k); } };
    } else if strat == JS_HASH() {
        let p1: ExprBlob = payload_ty_frag(streams, ty);
        let p2: ExprBlob = payload_ty_frag(streams, ty);
        if streams {
            ins = quote_block! {
                unsafe {
                    let #n_vp: *mut Vec<#(p1)> = #n_mp.get_or_insert(#n_k, Vec::<#(p2)>::new());
                    (&mut *#n_vp).push(#n_br);
                }
            };
        } else {
            ins = quote_block! {
                unsafe {
                    let #n_vp: *mut Vec<#(p1)> = #n_mp.get_or_insert(#n_k, Vec::<#(p2)>::new());
                    (&mut *#n_vp).push(#n_b);
                }
            };
        }
    } else {
        let p1: ExprBlob = payload_ty_frag(streams, ty);
        let p2: ExprBlob = payload_ty_frag(streams, ty);
        let p3: ExprBlob = payload_ty_frag(streams, ty);
        let p4: ExprBlob = payload_ty_frag(streams, ty);
        if streams {
            ins = quote_block! {
                unsafe {
                    let #n_vp: *mut Vec<#(p1)> = #n_tp.get_mut(&#n_k);
                    if #n_vp == (0i64 as *mut Vec<#(p2)>) {
                        let mut #n_nv: Vec<#(p3)> = Vec::<#(p4)>::new();
                        #n_nv.push(#n_br);
                        #n_tp.insert(#n_k, #n_nv);
                    } else {
                        (&mut *#n_vp).push(#n_br);
                    }
                }
            };
        } else {
            ins = quote_block! {
                unsafe {
                    let #n_vp: *mut Vec<#(p1)> = #n_tp.get_mut(&#n_k);
                    if #n_vp == (0i64 as *mut Vec<#(p2)>) {
                        let mut #n_nv: Vec<#(p3)> = Vec::<#(p4)>::new();
                        #n_nv.push(#n_b);
                        #n_tp.insert(#n_k, #n_nv);
                    } else {
                        (&mut *#n_vp).push(#n_b);
                    }
                }
            };
        }
    }

    let body: ExprBlob = quote_block! {
        let #n_k: #(kt) = (#(key_f));
        #(ins);
    };
    if streams {
        // ONE pass over the iterator, and the only one. The row type is
        // ANNOTATED for the same reason the scan loop annotates it: `next()`'s
        // result type is the trait's parameter, and an associated-type source
        // spelling leaves it unselected.
        return quote_block! {
            #(decl);
            {
                loop {
                    let #n_bo: Option<#(rowt)> = (#(src_f)).next();
                    if #n_bo.is_none() { break; }
                    let #n_br: #(rowt) = #n_bo.unwrap();
                    let #vnm: &#(rowt) = &#n_br;
                    #(body);
                }
            }
        };
    }
    return quote_block! {
        #(decl);
        {
            let mut #n_b: i64 = 0i64;
            while #n_b < (#(src_f)).len() {
                let #vnm: &#(rowt) = &(#(src_f))[#n_b];
                #(body);
                #n_b = #n_b + 1i64;
            }
        }
    };
}

// The probe-side bucket LOOKUP through the once-taken container pointer.
// TREE probes via `get_mut` (the *mut-receiver accessor) cast to *const — one
// pointer serves build + probe, keeping the borrow single.
fn bucket_lookup_frag(s: i64, strat: i32, streams: bool, ty: str) -> ExprBlob {
    let s_bp: String = nk_str("__bp", s);   let n_bp: Ident = Ident::new(string_as_str(&s_bp));
    let s_mp: String = nk_str("__mp", s);   let n_mp: Ident = Ident::new(string_as_str(&s_mp));
    let s_tp: String = nk_str("__tp", s);   let n_tp: Ident = Ident::new(string_as_str(&s_tp));
    let s_pk: String = nk_str("__pk", s);   let n_pk: Ident = Ident::new(string_as_str(&s_pk));
    if strat == JS_HASH() {
        return quote_block! { unsafe { #n_bp = #n_mp.get(&#n_pk); } };
    }
    let p1: ExprBlob = payload_ty_frag(streams, ty);
    return quote_block! { unsafe { #n_bp = #n_tp.get_mut(&#n_pk) as *const Vec<#(p1)>; } };
}

// ── One step of the nest: WRAP the inner body ────────────────────────────────
// ⚠ This is the open/close PAIR collapsed into one function, and that is the
// whole reason the bodies could not be quotes before. `emit_step_open` wrote
// `{` and `emit_step_close` wrote the matching `}`, separated by the entire
// inner body and by a LEVEL COUNTER threaded between them. A quote fragment is
// a whole construct, so a fragment that is only an opening brace cannot exist —
// the pair has to become "take a complete inner fragment, return the wrapped
// one", and the counter becomes the recursion depth of this call chain.
//
// `byval` — bind the row var BY VALUE (`let s: str = (src)[j];`) instead of by
// reference: scalar-element traversal steps (the Copy lattice — a `&str` local
// would not compose with the EL clauses, which reference the element bare).
// Only meaningful on the JS_LOOP tier (traversal is always nested-loop).
// `streams` — the step's source was consumed by the build phase and the bucket
// holds the ROWS, so a hit binds out of the bucket instead of indexing `src`.
// It never combines with JS_LOOP: a rescan of a spent iterator is exactly the
// shape `analyze_chain` refuses to emit.
fn step_wrap(inner: ExprBlob, s: i64, strat: i32, anti: bool,
             has_resid: bool, ktn: str, src: str, ty: str, var: str, byval: bool,
             probe_key: str, residual: str, pred: str,
             lim: ExprBlob, has_lim: bool, streams: bool) -> ExprBlob {
    let s_pk: String = nk_str("__pk", s);   let n_pk: Ident = Ident::new(string_as_str(&s_pk));
    let s_m:  String = nk_str("__m",  s);   let n_m:  Ident = Ident::new(string_as_str(&s_m));
    let s_j:  String = nk_str("__j",  s);   let n_j:  Ident = Ident::new(string_as_str(&s_j));
    let s_bp: String = nk_str("__bp", s);   let n_bp: Ident = Ident::new(string_as_str(&s_bp));
    let s_bv: String = nk_str("__bv", s);   let n_bv: Ident = Ident::new(string_as_str(&s_bv));
    let s_p:  String = nk_str("__p",  s);   let n_p:  Ident = Ident::new(string_as_str(&s_p));
    let s_ri: String = nk_str("__ri", s);   let n_ri: Ident = Ident::new(string_as_str(&s_ri));
    let s_sp: String = nk_str("__sp", s);   let n_sp: Ident = Ident::new(string_as_str(&s_sp));
    let s_tp: String = nk_str("__tp", s);   let n_tp: Ident = Ident::new(string_as_str(&s_tp));

    let kt:    ExprBlob = parse_type(ktn);
    let rowt:  ExprBlob = parse_type(ty);
    let src_f: ExprBlob = parse_expr(src);
    let vnm:   Ident    = Ident::new(var);

    // The probe key (hash/tree tiers) — over the ALREADY-BOUND vars/params.
    let mut pk_decl: ExprBlob = quote_block! { };
    if strat != JS_LOOP() {
        let pk_f: ExprBlob = parse_expr(probe_key);
        pk_decl = quote_block! { let #n_pk: #(kt) = (#(pk_f)); };
    }

    if anti {
        // ANTI: compute the matched flag flat, then guard the inner body with
        // `if (!__m{s})` — the step's var binds only inside its own probe/scan.
        let mut matched: ExprBlob = quote_block! { };
        if strat == JS_LOOP() {
            let pred_f: ExprBlob = parse_expr(pred);
            if byval {
                matched = quote_block! {
                    {
                        let mut #n_j: i64 = 0i64;
                        while #n_j < (#(src_f)).len() {
                            let #vnm: #(rowt) = (#(src_f))[#n_j];
                            if (#(pred_f)) { #n_m = true; }
                            #n_j = #n_j + 1i64;
                        }
                    }
                };
            } else {
                matched = quote_block! {
                    {
                        let mut #n_j: i64 = 0i64;
                        while #n_j < (#(src_f)).len() {
                            let #vnm: &#(rowt) = &(#(src_f))[#n_j];
                            if (#(pred_f)) { #n_m = true; }
                            #n_j = #n_j + 1i64;
                        }
                    }
                };
            }
        } else if !has_resid {
            // Pure absence test: HashSet contains / BTreeMap keyed lookup
            // (through the once-taken container pointer).
            if strat == JS_HASH() {
                matched = quote_block! { unsafe { #n_m = #n_sp.contains(&#n_pk); } };
            } else {
                // The null sentinel must be typed by the BUCKET, and the
                // bucket's payload is the ROW when the source streams — the
                // one site the payload generalization missed. Unreachable
                // today (the tree tier needs an Ord-only key, which no scalar
                // is), so a wrong type here fails only under `join_force_tree`
                // — which is exactly what that toggle exists to catch.
                let p1: ExprBlob = payload_ty_frag(streams, ty);
                matched = quote_block! {
                    unsafe { #n_m = #n_tp.get_mut(&#n_pk) != (0i64 as *mut Vec<#(p1)>); }
                };
            }
        } else {
            // Bucket scan: matched ⇔ SOME bucket row passes the residual
            // (absent bucket or all-fail ⇒ the anti row survives).
            let resid_f: ExprBlob = parse_expr(residual);
            let lookup: ExprBlob = bucket_lookup_frag(s, strat, streams, ty);
            let p1: ExprBlob = payload_ty_frag(streams, ty);
            let p2: ExprBlob = payload_ty_frag(streams, ty);
            let p3: ExprBlob = payload_ty_frag(streams, ty);
            let p4: ExprBlob = payload_ty_frag(streams, ty);
            let mut bind: ExprBlob = quote_block! {
                let #vnm: &#(rowt) = &(#(src_f))[#n_bv.get(#n_p)];
            };
            if streams {
                bind = quote_block! { let #vnm: &#(rowt) = #n_bv.borrow(#n_p); };
            }
            matched = quote_block! {
                {
                    let mut #n_bp: *const Vec<#(p1)> = 0i64 as *const Vec<#(p2)>;
                    #(lookup);
                    if #n_bp != (0i64 as *const Vec<#(p3)>) {
                        let #n_bv: &Vec<#(p4)> = unsafe { &*#n_bp };
                        let mut #n_p: i64 = 0i64;
                        while #n_p < #n_bv.len() {
                            #(bind);
                            if (#(resid_f)) { #n_m = true; }
                            #n_p = #n_p + 1i64;
                        }
                    }
                }
            };
        }
        return quote_block! {
            #(pk_decl);
            let mut #n_m: bool = false;
            #(matched);
            if (!#n_m) #(inner)
        };
    }

    // NON-ANTI.
    if strat == JS_LOOP() {
        let pred_f: ExprBlob = parse_expr(pred);
        let mut cond: ExprBlob = quote_expr! { #n_j < (#(src_f)).len() };
        if has_lim { cond = quote_expr! { #n_j < (#(src_f)).len() && __out.len() < (#(lim)) }; }
        if byval {
            return quote_block! {
                let mut #n_j: i64 = 0i64;
                while #(cond) {
                    let #vnm: #(rowt) = (#(src_f))[#n_j];
                    if (#(pred_f)) #(inner)
                    #n_j = #n_j + 1i64;
                }
            };
        }
        return quote_block! {
            let mut #n_j: i64 = 0i64;
            while #(cond) {
                let #vnm: &#(rowt) = &(#(src_f))[#n_j];
                if (#(pred_f)) #(inner)
                #n_j = #n_j + 1i64;
            }
        };
    }

    // HASH / TREE probe: bucket lookup → row loop → (residual guard).
    let lookup: ExprBlob = bucket_lookup_frag(s, strat, streams, ty);
    let p1: ExprBlob = payload_ty_frag(streams, ty);
    let p2: ExprBlob = payload_ty_frag(streams, ty);
    let p3: ExprBlob = payload_ty_frag(streams, ty);
    let p4: ExprBlob = payload_ty_frag(streams, ty);
    let mut guarded: ExprBlob = inner;
    if has_resid {
        let resid_f: ExprBlob = parse_expr(residual);
        guarded = quote_block! { if (#(resid_f)) #(guarded) };
    }
    // The bucket holds the rows themselves when the source streams — there is
    // no index and no source left to index into.
    let mut bind: ExprBlob = quote_block! {
        let #n_ri: i64 = #n_bv.get(#n_p);
        let #vnm: &#(rowt) = &(#(src_f))[#n_ri];
    };
    if streams {
        bind = quote_block! { let #vnm: &#(rowt) = #n_bv.borrow(#n_p); };
    }
    let mut pcond: ExprBlob = quote_expr! { #n_p < #n_bv.len() };
    if has_lim { pcond = quote_expr! { #n_p < #n_bv.len() && __out.len() < (#(lim)) }; }
    return quote_block! {
        #(pk_decl);
        let mut #n_bp: *const Vec<#(p1)> = 0i64 as *const Vec<#(p2)>;
        #(lookup);
        if #n_bp != (0i64 as *const Vec<#(p3)>) {
            let #n_bv: &Vec<#(p4)> = unsafe { &*#n_bp };
            let mut #n_p: i64 = 0i64;
            while #(pcond) {
                #(bind);
                #(guarded);
                #n_p = #n_p + 1i64;
            }
        }
    };
}

// ── The chain, REORDERED — one candidate order as a chain ────────────────────
// The nest below is built from a JChain and from nothing else, so a second join
// ORDER is a second chain rather than a second emitter. What actually differs
// between one order and another is FOUR things, and only the first is a swap of
// names:
//
//   1. the SOURCE of the outermost loop (`base_*`) and of each step;
//   2. WHICH HALF of an equi-term is the build key: `equi_term_sides` splits the
//      term by the step's NEW row var, so exchanging the vars exchanges build and
//      probe — the index is built over the other side;
//   3. therefore the STRATEGY itself is a different decision (a direction may have
//      no usable equi-key at all), which is why the strategy triple arrives from
//      the planner's candidate table instead of being re-derived here;
//   4. the PREDICATES move. `on` is stored on a step, but it constrains the PAIR:
//      in a candidate order each floating predicate attaches to the LAST of the
//      vars it reads, and the base — whichever source that is — carries none. The
//      derivation computed that placement and `conw` carries it.
//
// ⚠ PINNED STEPS ARE RE-INSERTED, NOT PERMUTED. An anti join and a traversal keep
// their depth in the bound stream (`join_order` C3), so this function walks the
// candidate's floatable order and drops each pinned step back in after exactly as
// many floatable sources as preceded it in the query. Their whole row — predicate,
// strategy, byval flag — comes off the ORIGINAL chain: nothing about a pinned step
// was a candidate's decision to make.
//
// ⚠ CANDIDATE 0 REPRODUCES THE QUERY'S CHAIN EXACTLY, and it is built through this
// same function rather than being passed through untouched. The identity
// permutation with the derivation's own predicate placement and the planner's own
// recorded strategies has to come out as the chain that was collected — and the
// derivation ASSERTS that (`RJ_SHAPE` when the placement disagrees), so a shape
// this reconstruction cannot express refuses instead of emitting a wrong nest.
fn chain_reorder(ch: &JChain, jo: &JoinOrder, cix: i64) -> JChain {
    let m: i64 = ch.n + 1i64;
    let mut fl: [i64; 4] = [0i64; 4];
    let mut nfl: i64 = 0i64;
    let mut pin: [i64; 8] = [0i64; 8];
    let mut pbc: [i64; 8] = [0i64; 8];
    let mut npin: i64 = 0i64;
    let mut s: i64 = 0i64;
    while s < m {
        if s > 0i64 && (ch.anti[s - 1i64] || ch.edge[s - 1i64]) {
            pin[npin] = s;
            pbc[npin] = nfl;
            npin = npin + 1i64;
        } else {
            if nfl < 4i64 { fl[nfl] = s; }
            nfl = nfl + 1i64;
        }
        s = s + 1i64;
    }
    let b: i64 = cix * JC_MAX_FL();
    let mut o: JChain = jchain_new();
    let bs: i64 = fl[jo.cslot[b]];
    o.base_src = jch_src(ch, bs);
    o.base_ty  = jch_ty(ch, bs);
    o.base_var = jch_var(ch, bs);
    let mut k: i64 = 0i64;
    let mut j: i64 = 0i64;
    while j < nfl {
        if j > 0i64 {
            let sl: i64 = fl[jo.cslot[b + j]];
            o.src[k]  = jch_src(ch, sl);
            o.ty[k]   = jch_ty(ch, sl);
            o.var[k]  = jch_var(ch, sl);
            o.anti[k]  = false;
            o.edge[k]  = false;
            o.byval[k] = false;
            o.onw[k]    = jo.conw[b + j];
            o.jstrat[k] = jo.cstrat[b + j];
            o.jkey[k]   = jo.ckey[b + j];
            o.jsel[k]   = jo.csel[b + j];
            o.jwhy[k]   = jo.cwhy[b + j];
            k = k + 1i64;
        }
        let mut pi: i64 = 0i64;
        while pi < npin {
            if pbc[pi] == j + 1i64 {
                let q: i64 = pin[pi] - 1i64;
                o.src[k]  = ch.src[q];
                o.ty[k]   = ch.ty[q];
                o.var[k]  = ch.var[q];
                o.anti[k]  = ch.anti[q];
                o.edge[k]  = ch.edge[q];
                o.byval[k] = ch.byval[q];
                o.onw[k]    = ch.onw[q];
                o.jstrat[k] = ch.jstrat[q];
                o.jkey[k]   = ch.jkey[q];
                o.jsel[k]   = ch.jsel[q];
                o.jwhy[k]   = ch.jwhy[q];
                k = k + 1i64;
            }
            pi = pi + 1i64;
        }
        j = j + 1i64;
    }
    o.n = k;
    return o;
}

// SLOT 0 is the base and slot i+1 the i-th step. One index space over the whole
// nest is what lets a permutation be a permutation of numbers; the three accessors
// are the only place the base's separate fields and the step arrays meet.
fn jch_src(ch: &JChain, s: i64) -> str {
    if s == 0i64 { return ch.base_src; }
    return ch.src[s - 1i64];
}
fn jch_ty(ch: &JChain, s: i64) -> str {
    if s == 0i64 { return ch.base_ty; }
    return ch.ty[s - 1i64];
}
fn jch_var(ch: &JChain, s: i64) -> str {
    if s == 0i64 { return ch.base_var; }
    return ch.var[s - 1i64];
}

/// The chain as the join-order derivation sees it: one index space, the two pin
/// flags, and the strategy the planner recorded. Copied rather than shared, so
/// `join_order` cannot come to depend on an emitter detail.
fn jch_of(ch: &JChain) -> JCh {
    let mut c: JCh = jch_new();
    c.n = ch.n;
    let m: i64 = ch.n + 1i64;
    let mut s: i64 = 0i64;
    while s < m {
        c.src[s] = jch_src(ch, s);
        c.var[s] = jch_var(ch, s);
        if s > 0i64 {
            c.onw[s]   = ch.onw[s - 1i64];
            c.anti[s]  = ch.anti[s - 1i64];
            c.edge[s]  = ch.edge[s - 1i64];
            c.strat[s] = ch.jstrat[s - 1i64];
            c.key[s]   = ch.jkey[s - 1i64];
            c.sel[s]   = ch.jsel[s - 1i64];
            c.swhy[s]  = ch.jwhy[s - 1i64];
        }
        s = s + 1i64;
    }
    return c;
}

/// The `JCTable` a plan carries, as a struct-literal text. All sixteen cells are
/// written even though `jc_order_cost` never reads past `ncand * JC_MAX_FL`: an
/// array literal has a fixed length and a partially-written one would be a shape
/// that depends on the query.
fn push_jctable(out: &mut String, jo: &JoinOrder) {
    out.push_str("JCTable { ncand: ");
    out.push_i64(jo.ncand);
    out.push_str("i64, nfl: ");
    out.push_i64(jo.nfl);
    out.push_str("i64, slot: [");
    let mut i: i64 = 0i64;
    while i < 16i64 {
        if i > 0i64 { out.push_str(", "); }
        out.push_i64(jo.cslot[i]);
        out.push_str("i64");
        i = i + 1i64;
    }
    out.push_str("], role: [");
    let mut r: i64 = 0i64;
    while r < 16i64 {
        if r > 0i64 { out.push_str(", "); }
        out.push_i64(jo.crole[r]);
        out.push_str("i64");
        r = r + 1i64;
    }
    out.push_str("] }");
}

/// ONE CANDIDATE's whole branch: its build phases and its nest, as a single block.
/// A function because `ncand` of them are needed and a nest spelled twice would be
/// two chances to diverge in exactly the place where divergence is silent — a
/// mis-collected index tuple is a wrong row, not a crash.
fn cand_branch(ch: &JChain, jo: &JoinOrder, cix: i64, ty: &ElTypes, prm: &MacroParams,
               h: &Writ, has_sort: bool, first: bool, distinct: bool, has_where: bool,
               where_body: str, key_body: str, proj_f: ExprBlob, result_ty: str,
               lim_f: ExprBlob, has_lim_use: bool, qvars: &[str; 9], nq: i64,
               out: &mut ExprBlob) -> bool {
    let cch: JChain = chain_reorder(ch, jo, cix);
    let mut bps: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut nst: ExprBlob = quote_block! { };
    if !chain_nest_frag(&cch, ty, prm, h, has_sort, first, distinct, has_where,
                        where_body, key_body, proj_f, result_ty, lim_f, has_lim_use,
                        qvars, nq, &mut bps, &mut nst) { return false; }
    *out = quote_block! { #( #bps; )* #(nst); };
    return true;
}

// Which `__ix` slot does the source bound to `v` own? The QUERY position, not
// the nest position: the sort phase's index tuples are read back by a rebind
// list in query order, and the tiebreak that makes the sorted sequence
// order-independent is lexicographic in that same order. A tuple must therefore
// mean the same thing whichever nest pushed it.
fn qslot_of(qvars: &[str; 9], nq: i64, v: str) -> i64 {
    let mut i: i64 = 0i64;
    while i < nq {
        if str_eq(qvars[i], v) { return i; }
        i = i + 1i64;
    }
    return 0i64;
}

// ── ONE ORDER's build phases + loop nest ─────────────────────────────────────
// The whole order-dependent half of a join body: per-step analysis (the plan's
// decisions, READ off the chain), the shared inner body, the nest built
// inside-out, and one build phase per indexed step. Called once per emitted
// order — the caller composes the result(s) with the order-INDEPENDENT parts
// (prelude, output vec, sort declarations, sort/output phase, return).
//
// It is a function because a second join order is a second nest, and two nests
// spelled twice would be two chances to diverge in exactly the place where
// divergence is silent (a mis-collected tuple is a wrong row, not a crash).
fn chain_nest_frag(ch: &JChain, ty: &ElTypes, prm: &MacroParams, h: &Writ,
                   has_sort: bool, first: bool, distinct: bool,
                   has_where: bool, where_body: str, key_body: str,
                   proj_f: ExprBlob, result_ty: str,
                   lim_f: ExprBlob, has_lim_use: bool,
                   qvars: &[str; 9], nq: i64,
                   bps: &mut Vec<ExprBlob>, out: &mut ExprBlob) -> bool {
    // Per-step strategy analysis (Part 2) — chosen by the plan, read here.
    let mut st_build: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_probe: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_resid: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_pred:  [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_strat:  [i32; 8]  = [0i32; 8];
    let mut st_ktn:    [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut st_hasres: [bool; 8] = [false; 8];
    let mut st_equi:   [bool; 8] = [false; 8];
    let mut st_stream: [bool; 8] = [false; 8];
    if !analyze_chain(ch, ty, ch.base_var, h, prm,
                      &mut st_build, &mut st_probe, &mut st_resid, &mut st_pred,
                      &mut st_strat, &mut st_ktn, &mut st_hasres, &mut st_equi,
                      &mut st_stream) { return false; }

    // The bound sources of THIS order: the generated row-index expression each
    // one contributes to the sort's tuple, and the query slot it belongs in.
    let mut bidx: [String; 9] = [String::new(), String::new(), String::new(), String::new(),
                                 String::new(), String::new(), String::new(), String::new(),
                                 String::new()];
    let mut bslot: [i64; 9] = [0i64; 9];
    bidx[0].push_str("__i0");
    bslot[0] = qslot_of(qvars, nq, ch.base_var);
    let mut nb: i64 = 1i64;
    let mut bi: i64 = 0i64;
    while bi < ch.n {
        if !ch.anti[bi] {
            if st_strat[bi] == JS_LOOP() { bidx[nb].push_str("__j"); }
            else                         { bidx[nb].push_str("__ri"); }
            bidx[nb].push_i64(bi + 1i64);
            bslot[nb] = qslot_of(qvars, nq, ch.var[bi]);
            nb = nb + 1i64;
        }
        bi = bi + 1i64;
    }

    // The SHARED inner body — sort collection / `first` early return / guarded
    // distinct-limit push — then the `where` guard around it.
    let mut inner: ExprBlob = quote_block! { };
    if has_sort {
        let mut coll: Vec<ExprBlob> = vec_new::<ExprBlob>();
        let mut pk: i64 = 0i64;
        while pk < nb {
            let sx: String = nk_str("__ix", bslot[pk]);
            let nx: Ident = Ident::new(string_as_str(&sx));
            let ix_f: ExprBlob = parse_expr(string_as_str(&bidx[pk]));
            coll.push(quote_block! { #nx.push(#(ix_f)); });
            pk = pk + 1i64;
        }
        let key_f: ExprBlob = parse_expr(key_body);
        inner = quote_block! {
            #( #coll; )*
            __ks.push(#(key_f));
        };
    } else if first {
        inner = quote_block! { return Result::Ok(Option::Some(#(proj_f))); };
    } else {
        inner = push_guarded_frag(result_ty, proj_f, distinct);
    }
    if has_where {
        let where_f: ExprBlob = parse_expr(where_body);
        inner = quote_block! { if (#(where_f)) #(inner) };
    }

    // Wrap one step at a time, innermost step LAST-bound first.
    let mut ki: i64 = ch.n - 1i64;
    while ki >= 0i64 {
        inner = step_wrap(inner, ki + 1i64, st_strat[ki], ch.anti[ki],
                          st_hasres[ki], st_ktn[ki], ch.src[ki], ch.ty[ki],
                          ch.var[ki], ch.byval[ki], string_as_str(&st_probe[ki]),
                          string_as_str(&st_resid[ki]), string_as_str(&st_pred[ki]),
                          lim_f, has_lim_use, st_stream[ki]);
        ki = ki - 1i64;
    }

    // The base loop. The DRIVING side may stream: it is the outermost loop of a
    // left-deep nest, so it is read once by construction — which is the fact the
    // plan records (`AccessPlan.once`). The steps are not, and say so; whether a
    // step's source is built once or rescanned per bound row is the join
    // strategy's business, decided on the plan before this fragment exists.
    let base_streams: bool = prm.rel_src_streams(ch.base_src);
    let base_src_f: ExprBlob = parse_expr(ch.base_src);
    let base_ty_f: ExprBlob = parse_type(ch.base_ty);
    let base_vnm: Ident = Ident::new(ch.base_var);
    let mut nest: ExprBlob = quote_block! { };
    if base_streams {
        let mut brk: ExprBlob = quote_block! { };
        if has_lim_use { brk = quote_block! { if !(__out.len() < (#(lim_f))) { break; } }; }
        nest = quote_block! {
            loop {
                #(brk);
                let __opt0: Option<#(base_ty_f)> = (#(base_src_f)).next();
                if __opt0.is_none() { break; }
                let __row0: #(base_ty_f) = __opt0.unwrap();
                let #base_vnm: &#(base_ty_f) = &__row0;
                #(inner);
            }
        };
    } else {
        let mut bcond: ExprBlob = quote_expr! { __i0 < (#(base_src_f)).len() };
        if has_lim_use {
            bcond = quote_expr! { __i0 < (#(base_src_f)).len() && __out.len() < (#(lim_f)) };
        }
        nest = quote_block! {
            let mut __i0: i64 = 0i64;
            while #(bcond) {
                let #base_vnm: &#(base_ty_f) = &(#(base_src_f))[__i0];
                #(inner);
                __i0 = __i0 + 1i64;
            }
        };
    }

    // Build phases — one per hash/tree step, spliced by the caller BEFORE the
    // nest (at body level for one order, inside the branch for two).
    let mut bpi: i64 = 0i64;
    while bpi < ch.n {
        bps.push(build_phase_frag(bpi + 1i64, st_strat[bpi], ch.anti[bpi], st_hasres[bpi],
                                  st_ktn[bpi], ch.src[bpi], ch.ty[bpi], ch.var[bpi],
                                  string_as_str(&st_build[bpi]), st_stream[bpi]));
        bpi = bpi + 1i64;
    }
    *out = nest;
    return true;
}

// ── emit_join_chain — the RECURSIVE-over-the-join-tree emitter ───────────────
// `body` is the RJoin/RAnti root of a left-deep chain. Emits nested per-source
// loops binding the row vars LEFT-TO-RIGHT (per-step strategy from the Part-2
// cascade) with ONE shared inner body: where-filter → sort-index collection /
// `first` early-return / guarded distinct-limit push. With `order by` the
// matched BOUND-row index tuples (one Vec per bound source) + keys are
// materialized and insertion-sorted before the projection loop — all existing
// modifiers compose over joined rows unchanged.
//
// THE JOIN ORDER IS A DECISION OVER A SET (ADR 0024 S4/S4k). The nest is a
// function of the chain (`chain_nest_frag`), so another join order is another chain
// (`chain_reorder`) and not another emitter. `logos.std.wql.join_order` DERIVES the
// admissible set from the constraints the emitter actually imposes; every carried
// order is emitted as its own nest, and one discriminant — computed once in
// `prepare`, or once in the prelude's scope when the numbers are only free there —
// selects the cheapest by `logos.std.wql.join_cost`. When the derivation admits one
// order, only the query's own is emitted and the refusal carries its ground.
fn emit_join_chain(body: RExpr, where_ref: WRef<SExpr>, has_where: bool, sel: WRef<SExpr>,
                   mods: QMods,
                   fn_name: str, params_text: str, prm: &MacroParams,
                   result_ty0: str, has_result_ty: bool, first: bool,
                   prelude: str, h: &Writ) -> bool {
    // 1. Linearize the left-deep tree into base + steps.
    let mut ch: JChain = jchain_new();
    collect_chain(body, &mut ch);

    // 2. Type dict: EVERY bound source's row schema + the scalar params.
    // Rel-sourced scans (slice B) stamp their COLUMN types + the positional
    // (var, col) → tuple-index bindings instead of a schema reflection.
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, ch.base_ty, ch.base_var);
    stamp_rel_source(&mut ty, &view, prm, ch.base_src, ch.base_var);
    let mut si: i64 = 0i64;
    while si < ch.n {
        stamp_types_from_schema(&view, &mut ty, ch.ty[si], ch.var[si]);
        stamp_rel_source(&mut ty, &view, prm, ch.src[si], ch.var[si]);
        // Scalar-element traversal var: the VAR NAME itself carries the
        // element's value type (referenced bare in the EL clauses).
        // ⚠ THROUGH THE ALIAS TABLE. A traversal step's element type is a DECLARED
        // SPELLING off a field's type node, so `type Cel = f64;` reaches `el` as an
        // unknown name and takes its INT default — the same class of defect as the
        // element type of a source parameter (see `reflect::find_struct_decl`).
        if ch.byval[si] { ty.set_ty_named(ch.var[si], resolve_alias_name(&view, ch.ty[si])); }
        si = si + 1i64;
    }
    apply_scalar_params(&mut ty, &view, prm);
    stamp_udfs_from_module(&view, &mut ty);

    // Validate every clause's calls (select / where / order / per-step on).
    if !check_calls(sel.any().view::<SExpr>(), &ty, "wql!: `select`") { return false; }
    if has_where {
        if !reject_tuple(where_ref.any().view::<SExpr>(), "wql!: `where`") { return false; }
        if !check_calls(where_ref.any().view::<SExpr>(), &ty, "wql!: `where`") { return false; }
    }
    if mods.has_sort {
        if !reject_tuple(mods.sort_key.any().view::<SExpr>(), "wql!: `order by`") { return false; }
        if !check_calls(mods.sort_key.any().view::<SExpr>(), &ty, "wql!: `order by`") { return false; }
    }
    let mut ci0: i64 = 0i64;
    while ci0 < ch.n {
        if ch.onw[ci0] != 0i64 {
            let on_e: SExpr = WAny::ref_to(ch.onw[ci0] as *const u8).view::<SExpr>();
            if !reject_tuple(on_e, "wql!: `on`") { return false; }
            if !check_calls(on_e, &ty, "wql!: `on`") { return false; }
        }
        ci0 = ci0 + 1i64;
    }

    // 3. Clause bodies (const-folded).
    let proj_opt: SExpr = simplify_sexpr(sel.any().view::<SExpr>(), h).any().view::<SExpr>();
    let mut result_ty: str = result_ty0;
    if !has_result_ty {
        result_ty = infer_emit_ty(proj_opt, &ty);
        // Owned-String projection (String-returning call at the select root).
        if returns_string(proj_opt, &ty) { result_ty = "String"; }
    }
    // Tuple projection (components may range across ALL bound join vars): the
    // result element type is the native tuple type text.
    let mut tuple_tt: String = String::new();
    let tres: i32 = tuple_result(proj_opt, &ty, has_result_ty, mods.distinct, &mut tuple_tt);
    if tres < 0i32 { return false; }
    if tres > 0i32 { result_ty = string_as_str(&tuple_tt); }
    let mut proj_body: String = String::new();
    emit_proj_value(&mut proj_body, proj_opt, &ty, ch.base_var);
    let mut where_body: String = String::new();
    if has_where {
        let where_opt: SExpr = simplify_sexpr(where_ref.any().view::<SExpr>(), h).any().view::<SExpr>();
        emit_sexpr(&mut where_body, where_opt, &ty, ch.base_var);
    }
    let mut key_body: String = String::new();
    let mut key_ty: str = "i64";
    // ⚠ THE DECLARED TYPE NAME, not the class: the sort key's Logos type is half of
    // the join-order licence (C1 — a sort licenses a second nest only if the
    // comparison the backend emits for the key REALIZES the order the query named),
    // and the four-value class cannot answer that. `u64` and `i64` are one class
    // and their orders differ above 2^63, so the class-keyed antecedent granted a
    // u64 key a licence over its own signed reinterpretation. BOTH names travel to
    // the decision: `key_tn` is what the query NAMED and `key_ty` is what the
    // emitter PRINTS for the key vector, and the licence is a claim about the
    // relation between them — see `el::el_cmp_fidelity`.
    let mut key_tn: str = "i64";
    if mods.has_sort {
        let key_opt: SExpr = simplify_sexpr(mods.sort_key.any().view::<SExpr>(), h).any().view::<SExpr>();
        key_tn = infer_ty_name(key_opt, &ty);
        key_ty = infer_emit_ty(key_opt, &ty);
        if !key_norm_ok(key_tn, key_ty, "wql!: `order by`") { return false; }
        let mut kb1: String = String::new();
        emit_sexpr(&mut kb1, key_opt, &ty, ch.base_var);
        key_body = key_norm_body(string_as_str(&kb1), key_tn, key_ty);
    }
    let has_sort: bool = mods.has_sort;

    // 4. Bound sources (base + non-anti steps) in QUERY order: the rebind
    // targets for the sort / output phases, and the slot each one's row index
    // occupies in a collected tuple. A traversal step's rebind source is its
    // FIELD-PATH expression — its base var rebinds at an EARLIER slot (chain
    // order), so `&(d.emps)[ix]` is well-scoped in the output phase; byval steps
    // rebind by value.
    //
    // ⚠ QUERY order, not nest order, and that distinction is what lets a second
    // nest exist: the output phase reads the tuples back through this list, so a
    // tuple's k-th component must mean the same source however it was collected
    // (`chain_nest_frag` maps its own bound sources onto these slots by var
    // name). The per-source row-index EXPRESSION is the one thing that is a
    // property of the nest, and it moved there with it.
    let mut bnd_src: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    let mut bnd_ty:  [str; 9] = ["", "", "", "", "", "", "", "", ""];
    let mut bnd_var: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    let mut bnd_byval: [bool; 9] = [false; 9];
    bnd_src[0] = ch.base_src;
    bnd_ty[0]  = ch.base_ty;
    bnd_var[0] = ch.base_var;
    let mut nb: i64 = 1i64;
    let mut bi: i64 = 0i64;
    while bi < ch.n {
        if !ch.anti[bi] {
            bnd_src[nb] = ch.src[bi];
            bnd_ty[nb]  = ch.ty[bi];
            bnd_var[nb] = ch.var[bi];
            bnd_byval[nb] = ch.byval[bi];
            nb = nb + 1i64;
        }
        bi = bi + 1i64;
    }

    // 6. Body: the whole thing is a QUOTE now (ADR 0024 S5).
    //
    // ⚠ The nest is built INSIDE-OUT. `emit_step_open`/`emit_step_close` were
    // a PAIR — one wrote `{`, the other the matching `}`, with the entire inner
    // body and a level counter between them — and a quote fragment is a whole
    // construct, so an opening brace can never be one. `step_wrap` takes the
    // complete inner fragment and returns the wrapped one; the level counter is
    // now the recursion depth of that fold, and the indentation bookkeeping
    // (`push_ind`, `ind_string`) has no subject left.
    //
    // ⚠ The `// join strategy: …` trace line is GONE. It never reached
    // generated code: the body went through `parse_block`, which drops
    // comments, so no --gen-dir dump has ever contained it, and
    // `LOGOS_TRACE_EMIT` traces the emit_source channel this file stopped using
    // when the item became a quote. Keeping it would have meant keeping a raw
    // text push whose output nothing can observe.
    let has_lim_use: bool = mods.has_limit && !has_sort;
    let mut lim_f: ExprBlob = parse_expr("0i64");
    if mods.has_limit { lim_f = limit_expr(&mods); }

    let proj_f: ExprBlob = parse_expr(string_as_str(&proj_body));

    let mut rty: String = String::new();
    if first {
        rty.push_str("Result<Option<");
        rty.push_str(result_ty);
        rty.push_str(">, ElError>");
    } else {
        rty.push_str("Result<Vec<");
        rty.push_str(result_ty);
        rty.push_str(">, ElError>");
    }

    // 7. THE JOIN ORDER — one nest, or a set of them under a discriminant.
    //
    // The plan is asked FIRST, because what it answers is how many nests the body
    // has. Every admissible order becomes its own chain and its own nest, and they
    // sit under a test of the PLAN's own field; all of them fill the same `__out` /
    // `__ix*` / `__ks` bindings, declared outside them, so nothing downstream of
    // the nest knows which one ran.
    //
    // ⚠ THE DISCRIMINANT IS NOT AN EXPRESSION IN THIS BODY (ADR 0024 S4i). It is
    // `__pl.order_ix` — a field of the prepared plan the `_run` fn was handed — so
    // the cost function ran ONCE, in `prepare`, and not on every call. The per-row
    // shape is untouched however many candidates there are: ONE branch chain,
    // outside every loop.
    //
    // ⚠ UNLESS THE DECISION IS DEFERRED (ADR 0024 S4j), in which case it is
    // `__defer_ix` — a local bound in the PRELUDE REGION, between the
    // materializations and the join's index build, from `len()` reads on bindings
    // the prelude already made. The shape is identical to the prepared one where it
    // matters: `nfl + 1` statements at body level, one branch chain above every
    // loop, nothing per row. What differs is only WHERE the numbers came from, and
    // therefore whether the choice is reusable.
    //
    // ⚠ The build phases stay at BODY level in the one-nest case. A join body was
    // flat before this and must stay flat: an extra scope is not cosmetic here
    // (ADR 0024 S5 records a stdlib build failing on "use of moved variable
    // `__out`" from exactly one), so the multi-nest form is the only one that
    // introduces a block, and there it is the branch itself.
    let mut szs: [String; 4] = [String::new(), String::new(), String::new(), String::new()];
    let mut ats: [i64; 4] = [-1i64; 4];
    let jc: JCh = jch_of(&ch);
    // ⚠ NO GROUND BUFFER TRAVELS WITH THIS CALL ANY MORE (ADR 0024 S4o). It used to
    // take one, declared here rather than inside the decision, because the verdict's
    // ground was composed text and the plan's string literal is written far below —
    // a `str` view that had to outlive two frames, which is exactly the shape one
    // round shipped a use-after-free in. The decision returns a `Why`; the text is
    // composed once, at the emission site, from the record.
    let jo: JoinOrder = decide_join_orders(&jc, has_sort, key_tn, key_ty, &ty, prm, h,
                                           &mut szs, &mut ats);

    // The measurement `prepare` needs: the declared reporters the size expressions
    // call, and ONLY those — a plan does not measure what it will not compare. The
    // same rel may supply two positions' numbers, so a reporter already bound is
    // not bound twice.
    //
    // ⚠ NOTHING IS MEASURED FOR A DEFERRED DECISION. Every `ats` entry comes back
    // -1 and the deferred expressions are `len()` reads, not reporter calls — a plan
    // that emitted a reporter call it would not compare, or a call whose cost it
    // could not account for, is exactly what point (2) exists to avoid.
    let mut meas: String = String::new();
    if jo.dynamic && !jo.deferred {
        let mut mi: i64 = 0i64;
        while mi < jo.nfl {
            if ats[mi] >= 0i64 {
                let mut seen: bool = false;
                let mut mj: i64 = 0i64;
                while mj < mi {
                    if ats[mj] == ats[mi] { seen = true; }
                    mj = mj + 1i64;
                }
                if !seen { size_binding_text(&mut meas, prm, ats[mi]); }
            }
            mi = mi + 1i64;
        }
    }
    let mut tblb: String = String::new();
    if jo.dynamic { push_jctable(&mut tblb, &jo); }

    // THE CENSUS OF CARRIED ORDERS, one line per join nest. A gate that forces
    // each order in turn has to know how many there are, and it must be able to
    // tell "one nest" from "several" — a fixture with a single candidate is an
    // EXCLUDED case with a stated ground, not a silent pass.
    if jo.dynamic { order_census(fn_name, jo.ncand, jo.deferred); }
    else          { order_census(fn_name, 1i64, false); }

    let mut top_bps: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut nest_all: ExprBlob = quote_block! { };
    let mut defer_f: ExprBlob = quote_block! { };
    if jo.dynamic {
        // The DISCRIMINANT, and for a deferred decision the statements that bind it.
        // They go where the plan's field read would have gone — at body level, above
        // the nest — and the rule is the PLAN's method, which is `join_cost`'s one
        // function, so the two decision points cannot answer differently from the
        // same numbers.
        let mut disc: str = "__pl.order_ix";
        if jo.deferred {
            // ⚠ THE SAME BINDER AS `prepare`, deliberately: one answer to "how is a
            // size fact bound", including the identity check. Before this the
            // deferred path had none, and `db_i64_leaves_run` read
            // `(__rel_g_sl).len()` three times for what is one number.
            let mut dfb: String = String::new();
            dfb.push_str("{\n");
            push_size_bindings_4(&mut dfb, "__defer_n", jo.nfl,
                                 string_as_str(&szs[0]), string_as_str(&szs[1]),
                                 string_as_str(&szs[2]), string_as_str(&szs[3]));
            dfb.push_str("    let __defer_ix: i64 = __pl.order_pick(__defer_n0, __defer_n1, __defer_n2, __defer_n3);\n}\n");
            defer_f = parse_block(string_as_str(&dfb));
            disc = "__defer_ix";
        }
        // ⚠ THE PLAN-INDEPENDENCE SEAM (ADR 0024 S4r). `LOGOS_WQL_FORCE_ORDER=k`
        // replaces the discriminant with the CONSTANT `k mod ncand`, so the nest
        // that runs is the gate's choice rather than the data's. The original read
        // is KEPT (`(…) * 0 +`): whatever `run` would have measured it still
        // measures, and only the branch that reading feeds is overridden — a
        // deferred plan's prelude `len()` reads are part of what is under test.
        //
        // The buffer is declared in this scope because `disc` becomes a view of it
        // and the view is consumed by the branch chain below, in the same block.
        let mut fdb: String = String::new();
        let fix: i64 = force_order_ix();
        if fix >= 0i64 && jo.ncand > 0i64 {
            fdb.push_str("((");
            fdb.push_str(disc);
            fdb.push_str(") * 0i64 + ");
            fdb.push_i64(fix % jo.ncand);
            fdb.push_str("i64)");
            disc = string_as_str(&fdb);
        }
        // Candidate 0 is the query's own order and is the final `else`, so a plan
        // that somehow reports an index it did not carry runs the order the query
        // wrote rather than nothing at all.
        let mut acc: ExprBlob = quote_block! { };
        if !cand_branch(&ch, &jo, 0i64, &ty, prm, h, has_sort, first, mods.distinct,
                        has_where, string_as_str(&where_body), string_as_str(&key_body),
                        proj_f, result_ty, lim_f, has_lim_use, &bnd_var, nb,
                        &mut acc) { return false; }
        let mut ci: i64 = 1i64;
        while ci < jo.ncand {
            let mut br: ExprBlob = quote_block! { };
            if !cand_branch(&ch, &jo, ci, &ty, prm, h, has_sort, first, mods.distinct,
                            has_where, string_as_str(&where_body), string_as_str(&key_body),
                            proj_f, result_ty, lim_f, has_lim_use, &bnd_var, nb,
                            &mut br) { return false; }
            let mut cb: String = String::new();
            cb.push_str(disc);
            cb.push_str(" == ");
            cb.push_i64(ci);
            cb.push_str("i64");
            let cond: ExprBlob = parse_expr(string_as_str(&cb));
            acc = quote_block! { if (#(cond)) #(br) else #(acc) };
            ci = ci + 1i64;
        }
        nest_all = acc;
    } else {
        if !chain_nest_frag(&ch, &ty, prm, h, has_sort, first, mods.distinct,
                            has_where, string_as_str(&where_body), string_as_str(&key_body),
                            proj_f, result_ty, lim_f, has_lim_use,
                            &bnd_var, nb, &mut top_bps, &mut nest_all) { return false; }
    }

    // 8. The sort scaffolding — order-INDEPENDENT: the tuple slots are query
    // positions, and the comparison over them is total.
    let mut sortdecl: ExprBlob = quote_block! { };
    let mut sortout:  ExprBlob = quote_block! { };
    if has_sort {
        // Phase 1 collects matched bound-row index tuples + sort keys.
        let mut ixd: Vec<ExprBlob> = vec_new::<ExprBlob>();
        let mut dk: i64 = 0i64;
        while dk < nb {
            let sx: String = nk_str("__ix", dk);
            let nx: Ident = Ident::new(string_as_str(&sx));
            ixd.push(quote_block! { let mut #nx: Vec<i64> = Vec::<i64>::new(); });
            dk = dk + 1i64;
        }
        let keyt_f: ExprBlob = parse_type(key_ty);
        sortdecl = quote_block! {
            #( #ixd; )*
            let mut __ks: Vec<#(keyt_f)> = Vec::<#(keyt_f)>::new();
        };
        // Phase 2/3: order the index tuples, re-bind every bound source, project.
        let sortp: ExprBlob = sort_perm_frag(key_ty, mods.sort_desc, nb);
        if first {
            let mut rb: Vec<ExprBlob> = vec_new::<ExprBlob>();
            let mut rk: i64 = 0i64;
            while rk < nb {
                let sx: String = nk_str("__ix", rk);
                let nx: Ident = Ident::new(string_as_str(&sx));
                let bs: ExprBlob = parse_expr(bnd_src[rk]);
                let bt: ExprBlob = parse_type(bnd_ty[rk]);
                let bv: Ident = Ident::new(bnd_var[rk]);
                if bnd_byval[rk] {
                    rb.push(quote_block! { let #bv: #(bt) = (#(bs))[#nx.get(0i64)]; });
                } else {
                    rb.push(quote_block! { let #bv: &#(bt) = &(#(bs))[#nx.get(0i64)]; });
                }
                rk = rk + 1i64;
            }
            sortout = quote_block! {
                #(sortp);
                if __ix0.len() > 0i64 {
                    #( #rb; )*
                    return Result::Ok(Option::Some(#(proj_f)));
                }
            };
        } else {
            let mut rb: Vec<ExprBlob> = vec_new::<ExprBlob>();
            let mut rk2: i64 = 0i64;
            while rk2 < nb {
                let sx: String = nk_str("__ix", rk2);
                let nx: Ident = Ident::new(string_as_str(&sx));
                let bs: ExprBlob = parse_expr(bnd_src[rk2]);
                let bt: ExprBlob = parse_type(bnd_ty[rk2]);
                let bv: Ident = Ident::new(bnd_var[rk2]);
                if bnd_byval[rk2] {
                    rb.push(quote_block! { let #bv: #(bt) = (#(bs))[#nx.get(__o)]; });
                } else {
                    rb.push(quote_block! { let #bv: &#(bt) = &(#(bs))[#nx.get(__o)]; });
                }
                rk2 = rk2 + 1i64;
            }
            let push_f: ExprBlob = push_guarded_frag(result_ty, proj_f, mods.distinct);
            let mut ocond: ExprBlob = quote_expr! { __o < __ix0.len() };
            if mods.has_limit {
                ocond = quote_expr! { __o < __ix0.len() && __out.len() < (#(lim_f)) };
            }
            sortout = quote_block! {
                #(sortp);
                let mut __o: i64 = 0i64;
                while #(ocond) {
                    #( #rb; )*
                    #(push_f);
                    __o = __o + 1i64;
                }
            };
        }
    }

    let pre_f: ExprBlob = prelude_frag(prelude);
    let elem_f: ExprBlob = parse_type(result_ty);
    let mut head_f: ExprBlob = quote_block! {
        let mut __out: Vec<#(elem_f)> = Vec::<#(elem_f)>::new();
    };
    let mut tail_f: ExprBlob = quote_block! { return Result::Ok(__out); };
    if first {
        head_f = quote_block! { };
        tail_f = quote_block! { return Result::Ok(Option::None); };
    }
    // ⚠ `defer_f` SITS IMMEDIATELY AFTER THE PRELUDE, and its position is the
    // whole argument for the slice: the prelude has just materialized every rel
    // this query needs, and nothing has been built yet. One statement earlier the
    // lengths do not exist; one loop later the read would be per-row. Empty for
    // every plan that is not deferred, so the one-nest and prepared shapes are
    // byte-for-byte what they were.
    let body_f: ExprBlob = quote_block! {
        #(pre_f);
        #(defer_f);
        #(head_f);
        #( #top_bps; )*
        #(sortdecl);
        #(nest_all);
        #(sortout);
        #(tail_f);
    };
    // ⚠ THE CENSUS TRAVELS WITH THE PLAN, NOT ONLY WITH THE TRACE, and it travels ON
    // THE RECORD rather than through a second call. This is the one site where the
    // order axis was ENTERED, so it is the one site that can tell "nothing to permute"
    // from "24 permuted, 8 legal, none carried" — and the plan object is the only
    // artifact of the two that survives the compile. `prep_set_search` existed to
    // write those two numbers here, after the fact, on every path; a record carries
    // them wherever it goes and there is nothing left to remember.
    let mut prp: Prepared = prep_fixed(jo.w);
    if jo.dynamic {
        if jo.deferred {
            prp = prep_deferred(jo.nfl, jo.ncand,
                                string_as_str(&szs[0]), string_as_str(&szs[1]),
                                string_as_str(&szs[2]), string_as_str(&szs[3]),
                                string_as_str(&tblb), jo.w);
        } else {
            prp = prep_dyn(jo.nfl, jo.ncand,
                           string_as_str(&szs[0]), string_as_str(&szs[1]),
                           string_as_str(&szs[2]), string_as_str(&szs[3]),
                           string_as_str(&meas), string_as_str(&tblb), jo.w);
        }
    }
    emit_query_fn(fn_name, params_text, prm.tparams, rty.as_str(), body_f, prm, prp);
    return true;
}

// ── emit_aggregate — group-by + aggregate (mirror walk_aggregate) ─────────────
// ONE emitter for BOTH aggregate inputs. A bare scan is the DEGENERATE join
// chain — `ch.n == 0` — not a second shape: `collect_chain` linearizes the
// input, every per-step loop below (strategy trace, build phase, nest open,
// nest close) then runs zero times, and what is left standing is exactly the
// single-pass group fold over the base loop.
//
// The emitted shape, in order:
//   • one BUILD PHASE per join step (the Part-2 strategy cascade, unchanged);
//   • the joined-row NEST — no `limit` on the match loops, grouping needs
//     every row;
//   • the inner FOLD — find/insert the row's group by a linear `__g_key` scan
//     (the MVP dedup), bump `__g_cnt`, fold each accumulator column
//     incrementally (count/sum/min/max direct; avg = f64 sum + count, divided
//     at finalization; a UDA threads its own `A` through `<name>_step`);
//   • the FINALIZE pass — `__ga_*` (accumulator type `A`) → `__gf_*` (the
//     finalized column type `R`), with `having` gating the group row;
//   • the group-row OUTPUT phase — order / project / distinct / limit.
//
// ⚠ The two emitters this replaces were NOT equivalent, so the merge had to
// pick: the scan shape accumulated an i64 `sum` through `el_add(…)?` (overflow
// ⇒ `Err`, pinned by `query_agg_sum_overflow_e2e`) while the join shape used a
// plain `+` that traps on the same input. The CHECKED add is what survives, so
// an aggregate over a joined stream now reports an overflowing sum instead of
// dying on it.
//
// ⚠ Also gone with the scan shape: its no-modifier fast path pushed the
// projection straight from the group loop and skipped the group columns. The
// merged shape always materializes `__gf_*` and always runs the output phase.
// Same rows in the same order (group columns are in first-occurrence order and
// the identity permutation preserves it) — more emitted lines, one fewer pass
// over the source (the scan shape rescanned every row once PER GROUP).
fn emit_aggregate(scan_e: RExpr, key_ref: WRef<SExpr>, aggs: RAggArr,
                  where_ref: WRef<SExpr>, has_where: bool,
                  having_ref: WRef<SExpr>, has_having: bool, sel: WRef<SExpr>,
                  mods: QMods,
                  fn_name: str, params_text: str, prm: &MacroParams,
                  result_ty0: str, has_result_ty: bool, prelude: str, h: &Writ) -> bool {
    // The input as a linearized chain: base + `ch.n` steps. `ch.n == 0` IS the
    // bare scan — the degenerate chain, not a special case.
    let mut ch: JChain = jchain_new();
    collect_chain(scan_e, &mut ch);
    let acount: i64 = aggs.len();

    // Types: every bound source's row schema + scalar params + key/outputs.
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, ch.base_ty, ch.base_var);
    stamp_rel_source(&mut ty, &view, prm, ch.base_src, ch.base_var);
    let mut si: i64 = 0i64;
    while si < ch.n {
        stamp_types_from_schema(&view, &mut ty, ch.ty[si], ch.var[si]);
        stamp_rel_source(&mut ty, &view, prm, ch.src[si], ch.var[si]);
        // Scalar-element traversal var: name → element value type (bare refs).
        // ⚠ THROUGH THE ALIAS TABLE. A traversal step's element type is a DECLARED
        // SPELLING off a field's type node, so `type Cel = f64;` reaches `el` as an
        // unknown name and takes its INT default — the same class of defect as the
        // element type of a source parameter (see `reflect::find_struct_decl`).
        if ch.byval[si] { ty.set_ty_named(ch.var[si], resolve_alias_name(&view, ch.ty[si])); }
        si = si + 1i64;
    }
    apply_scalar_params(&mut ty, &view, prm);
    stamp_udfs_from_module(&view, &mut ty);
    // ── P3b: THE REL'S OWN INPUT TYPE, STAMPED BY TYPE ONLY ────────────────
    // A rel-backed entry scans the REL, so the struct feeding the rel's BODIES
    // is nowhere in this dict — the walk above stamps only the ENTRY's sources.
    // The incremental arm needs it: the handle accumulates that struct's rows,
    // and the presence gate is a field-by-field `==` spelled from the binding
    // table (`incr_row_eq_text`), which cannot be written for a type the dict
    // has never seen. Measured before this call existed: the admission declined
    // with "INPUT ROW TYPE is not OWNABLE", which is a TRUE sentence about a
    // dict that was never asked rather than about the type.
    //
    // ⚠ TYPE-ONLY, AND GATED ON THE ENTRY'S BASE BEING A REL. `stamp_types_from_schema`
    // would also write FLAT name bindings (`a` → i64) that every expression in
    // this query resolves through, which is a change to name resolution for a
    // population far wider than the one that needs it. `stamp_type_fields`
    // writes the (TYPE, field) keys and nothing else, and the gate keeps even
    // that confined to queries whose base source is a declared rel.
    if prm.rel_find_src(ch.base_src) >= 0i64 {
        let mut pj: i64 = 0i64;
        while pj < prm.n {
            if prm.is_slice[pj] { stamp_type_fields(&view, &mut ty, prm.tys[pj]); }
            pj = pj + 1i64;
        }
    }
    // Group KEY: infer + stamp. A group key needs an IDENTITY (`==` + a hash), and
    // which classes have one is `el::el_eq_hash` — the same one-place, default-deny
    // shape as the ORDER question next to it, and for the same reason: this used to
    // be a hand-written `== EL_TY_FLT()`, which is exhaustive only while the lattice
    // has four classes. The two questions are kept apart because they are different
    // properties (ranking vs identity) that a class can have one of.
    // `key_ty` types __k / __g_key / __gf_key / the group binds below.
    let key_e: SExpr = key_ref.any().view::<SExpr>();
    if !reject_tuple(key_e, "wql!: `group by`") { return false; }
    if !check_calls(key_e, &ty, "wql!: `group by`") { return false; }
    let key_opt: SExpr = simplify_sexpr(key_e, h).any().view::<SExpr>();
    let key_ety: i32 = infer_ty(key_opt, &ty);
    // ⚠ ASKED OF THE TYPE FIRST, then of the class. `el_eq_hash` answers about the
    // class's REPRESENTATIVE, so it admits every EL_TY_INT — including a `u128`,
    // whose normalization drops bits and puts two different keys in one bucket.
    // The type knows better (`ElTy.ident`), and the ground it gives names which
    // way the identity failed.
    // OWNED: the inferred name is a view into `ty`'s table and the group path
    // writes `ty` (the "key" binding) before the body is emitted.
    let mut key_tn3s: String = String::new();
    key_tn3s.push_str(infer_ty_name(key_opt, &ty));
    // ⚠ THE IDENTITY IS ASKED OF THE PAIR (named, emitted), not of either alone.
    // The group's buckets are a linear `==` scan over `__g_key`, whose element type
    // is what the emitter PRINTS for the key — the key's own type wherever the key
    // is a named value. So a `u64` key groups in u64: `==` there is u64's equality,
    // exact, and the `key` column comes back OUT as a u64 rather than as the -1 an
    // i64 vector would have made of `u64::MAX`. What is refused is the case where a
    // NORMALIZATION stands between the two, and `el_cmp_ident` names which
    // antecedent failed — NO_INJ for the wide integers the EL truncates, NO_EQ for
    // the floats whose equality is not reflexive in any type.
    // OWNED for the same reason `key_tn3s` is: the inferred name is a view into
    // `ty`'s table and `set_ty("key", …)` below writes that table.
    let mut key_tys: String = String::new();
    key_tys.push_str(infer_emit_ty(key_opt, &ty));
    let key_ty: str = string_as_str(&key_tys);
    let ki: i32 = el_cmp_ident(string_as_str(&key_tn3s), key_ty);
    if el_ty(string_as_str(&key_tn3s)).cls >= 0i32 && ki != EL_ID_OK() {
        let mut mni: String = String::new();
        mni.push_str("wql!: a `group by` key of type `");
        mni.push_str(string_as_str(&key_tn3s));
        mni.push_str("` has no identity to group by (the emitted bucket key is `");
        mni.push_str(key_ty);
        mni.push_str("`) — ");
        mni.push_str(el_cmp_ident_why(string_as_str(&key_tn3s), key_ty));
        error(string_as_str(&mni));
        return false;
    }
    if !key_norm_ok(string_as_str(&key_tn3s), key_ty, "wql!: `group by`") { return false; }
    if el_ty(string_as_str(&key_tn3s)).cls < 0i32 && !el_eq_hash(key_ety) {
        // The out-of-lattice fallback: no NAME to ask, so the class is all there is.
        // The DECISION is the shared table; only the WORDING branches, because the
        // f64 case has a named mechanism worth stating and an unadmitted class does
        // not have one yet.
        if key_ety == EL_TY_FLT() {
            error("wql!: a `group by` key cannot be f64 (floats have no Eq/Hash) — cast to an integral type or group by an i64/str/bool key");
        } else {
            error("wql!: a `group by` key needs an identity (`==` and a hash) and this key's type is not admitted as having one (`el_eq_hash`) — group by an i64/str/bool key");
        }
        return false;
    }
    ty.set_ty_named("key", key_ty);
    report_ty_overflow(&mut ty);
    let mut agg_flt:  [bool; 8] = [false; 8];
    let mut agg_cast: [bool; 8] = [false; 8];
    compute_agg_reprs(&aggs, acount, &ty, &mut agg_flt, &mut agg_cast);
    // UDA resolution (naming-convention triple) + finalized column types.
    let mut uda:     [bool; 8] = [false; 8];
    let mut uda_fin: [bool; 8] = [false; 8];
    let mut uda_acc: [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut uda_ret: [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut aret:    [i32; 8]  = [0i32; 8];
    if !resolve_aggs(&view, &aggs, acount, &mut uda, &mut uda_fin,
                     &mut uda_acc, &mut uda_ret, &mut aret) { return false; }
    // ── THE ACCUMULATOR'S TYPE, DECIDED ONCE AND ABOVE EVERYTHING THAT READS IT
    // ⚠ THIS CALL USED TO SIT 70 LINES BELOW, BESIDE THE BATCH FOLD, AND THAT
    // POSITION IS WHAT MADE THE `u64` CELL LOOK LIKE A ONE-LINE FIX. Three
    // things downstream of it are DERIVED from the accumulator and all three are
    // decided here: the finalized COLUMN type (`compute_agg_col_tys` — the
    // `__gf_*` vectors, the finalize `let`, the group-row rebind), the aggregate
    // OUTPUT NAME's recorded type (`stamp_agg_out_types` — which `select`,
    // `having` and `order by` all read, and which `infer_emit_ty` turns into the
    // result element type), and the fold itself. Computing the accumulator after
    // them left `Vec<u64>` cells read through `let t: i64 = …` inside the
    // generated blob. Its inputs are all available the moment `resolve_aggs`
    // returns, so the hoist costs nothing.
    //
    // ⚠ AND THERE IS NOW ONE ARRAY, NOT TWO. `compute_acc_tys` used to take a
    // `typed` flag whose FALSE arm answered the class representative for the
    // batch and whose TRUE arm answered `el::agg_acc_ty` for the incremental —
    // two emitters holding two different opinions about one cell, which is
    // exactly the disagreement `compute_agg_bodies`' header warns about one
    // level down. The flag is deleted and the array is passed into
    // `emit_incremental` rather than recomputed there.
    let mut acc: [str; 8] = ["", "", "", "", "", "", "", ""];
    compute_acc_tys(&aggs, acount, &ty, h, &uda, &agg_flt, &mut acc);
    stamp_agg_out_types(&aggs, acount, &agg_flt, &uda, &aret, &acc, &mut ty);
    let mut act: [str; 8] = ["", "", "", "", "", "", "", ""];
    compute_agg_col_tys(acount, &agg_flt, &uda, &aret, &acc, &mut act);

    // Validate clause calls (select / where / on preds; the key is validated above).
    if !check_calls(sel.any().view::<SExpr>(), &ty, "wql!: `select`") { return false; }
    if has_where {
        if !reject_tuple(where_ref.any().view::<SExpr>(), "wql!: `where`") { return false; }
        if !check_calls(where_ref.any().view::<SExpr>(), &ty, "wql!: `where`") { return false; }
    }
    let mut ci0: i64 = 0i64;
    while ci0 < ch.n {
        if ch.onw[ci0] != 0i64 {
            if !reject_tuple(sexpr_of_word(ch.onw[ci0]), "wql!: `on`") { return false; }
            if !check_calls(sexpr_of_word(ch.onw[ci0]), &ty, "wql!: `on`") { return false; }
        }
        ci0 = ci0 + 1i64;
    }

    // Clause bodies (`key_opt` is already simplified above).
    let proj_opt: SExpr = simplify_sexpr(sel.any().view::<SExpr>(), h).any().view::<SExpr>();
    let mut result_ty: str = result_ty0;
    if !has_result_ty {
        result_ty = infer_emit_ty(proj_opt, &ty);
        // Owned-String projection (String-returning call at the select root).
        if returns_string(proj_opt, &ty) { result_ty = "String"; }
    }
    // Tuple projection over the group row (join-aggregate shape).
    let mut tuple_tt: String = String::new();
    let tres: i32 = tuple_result(proj_opt, &ty, has_result_ty, mods.distinct, &mut tuple_tt);
    if tres < 0i32 { return false; }
    if tres > 0i32 { result_ty = string_as_str(&tuple_tt); }
    let mut kb3: String = String::new();
    emit_sexpr(&mut kb3, key_opt, &ty, ch.base_var);
    let key_body: String = key_norm_body(string_as_str(&kb3), string_as_str(&key_tn3s), key_ty);
    let mut where_body: String = String::new();
    if has_where {
        let where_opt: SExpr = simplify_sexpr(where_ref.any().view::<SExpr>(), h).any().view::<SExpr>();
        emit_sexpr(&mut where_body, where_opt, &ty, ch.base_var);
    }
    let mut proj_body: String = String::new();
    emit_proj_value(&mut proj_body, proj_opt, &ty, ch.base_var);
    let mut having_body: String = String::new();
    if has_having {
        let hav_e: SExpr = having_ref.any().view::<SExpr>();
        if !reject_tuple(hav_e, "wql!: `having`") { return false; }
        if !check_calls(hav_e, &ty, "wql!: `having`") { return false; }
        let hav_opt: SExpr = simplify_sexpr(hav_e, h).any().view::<SExpr>();
        emit_sexpr(&mut having_body, hav_opt, &ty, ch.base_var);
    }
    let mut okey_body: String = String::new();
    let mut okey_ty: str = "i64";
    if mods.has_sort {
        if !reject_tuple(mods.sort_key.any().view::<SExpr>(), "wql!: `order by`") { return false; }
        if !check_calls(mods.sort_key.any().view::<SExpr>(), &ty, "wql!: `order by`") { return false; }
        let okey_opt: SExpr = simplify_sexpr(mods.sort_key.any().view::<SExpr>(), h).any().view::<SExpr>();
        let okey_tn: str = infer_ty_name(okey_opt, &ty);
        okey_ty = infer_emit_ty(okey_opt, &ty);
        if !key_norm_ok(okey_tn, okey_ty, "wql!: `order by`") { return false; }
        let mut okb: String = String::new();
        emit_sexpr(&mut okb, okey_opt, &ty, ch.base_var);
        okey_body = key_norm_body(string_as_str(&okb), okey_tn, okey_ty);
    }

    let mut agg_body: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    // The BATCH fold's accumulator types are `acc`, computed above and shared
    // with the incremental emitter — see the note at `compute_acc_tys`' call.
    if !compute_agg_bodies(&aggs, acount, &ty, ch.base_var, h, &uda,
                           &agg_flt, &agg_cast, &acc, &mut agg_body) { return false; }

    // Per-step strategy analysis (the same Part-2 cascade as the join shape).
    let mut st_build: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_probe: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_resid: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_pred:  [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_strat:  [i32; 8]  = [0i32; 8];
    let mut st_ktn:    [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut st_hasres: [bool; 8] = [false; 8];
    let mut st_equi:   [bool; 8] = [false; 8];
    let mut st_stream: [bool; 8] = [false; 8];
    if !analyze_chain(&ch, &ty, ch.base_var, h, prm,
                      &mut st_build, &mut st_probe, &mut st_resid, &mut st_pred,
                      &mut st_strat, &mut st_ktn, &mut st_hasres, &mut st_equi,
                      &mut st_stream) { return false; }

    // ══ the BODY is a QUOTE too (ADR 0024 S5) ═════════════════════════════
    // This emitter carries BOTH runtime-shaped dimensions at once — a nest
    // whose depth is `ch.n` and a column set sized by the aggregate count. The
    // nest is built INSIDE-OUT by `step_wrap` (the open/close pair is gone with
    // the level counter it threaded) and every column list rides a
    // Vec<ExprBlob> cursor that splices flat.
    let pre_f:      ExprBlob = prelude_frag(prelude);
    let elem_f:     ExprBlob = parse_type(result_ty);
    let keyt_f:     ExprBlob = parse_type(key_ty);
    let base_src_f: ExprBlob = parse_expr(ch.base_src);
    let base_ty_f:  ExprBlob = parse_type(ch.base_ty);
    let base_vnm:   Ident    = Ident::new(ch.base_var);
    let proj_f:     ExprBlob = parse_expr(string_as_str(&proj_body));

    let mut rty: String = String::new();
    rty.push_str("Result<Vec<");
    rty.push_str(result_ty);
    rty.push_str(">, ElError>");

    // ⚠ The `// join strategy: …` trace line is GONE — see emit_join_chain.
    let mut bps: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut bpi: i64 = 0i64;
    while bpi < ch.n {
        bps.push(build_phase_frag(bpi + 1i64, st_strat[bpi], ch.anti[bpi], st_hasres[bpi],
                                  st_ktn[bpi], ch.src[bpi], ch.ty[bpi], ch.var[bpi],
                                  string_as_str(&st_build[bpi]), st_stream[bpi]));
        bpi = bpi + 1i64;
    }

    // Accumulator columns: one Vec per aggregate, plus the group key, the row
    // count, and the group's REPRESENTATIVE base row.
    //
    // ⚠ `__g_row` USED to be unnecessary in exactly one shape: the scan
    // emitter's no-modifier fast path projected inside the row loop, where the
    // row var was still in scope, and adding `order by` to the same query broke
    // it with an `undefined variable` on GENERATED code. Carrying the index
    // makes the rule the same in every shape instead of deleting the capability.
    let mut acols: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut seeds: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut folds: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut fcols: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut freads: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut fpush: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut gd: i64 = 0i64;
    while gd < acount {
        let a: RAgg = aggs.agg_at(gd);
        let fnid: i32 = agg_of_name(a.fn_name);
        let s_ga: String = ga_name(a.out);
        let s_gf: String = gf_name(a.out);
        let n_ga: Ident = Ident::new(string_as_str(&s_ga));
        let n_gf: Ident = Ident::new(string_as_str(&s_gf));
        let n_out: Ident = Ident::new(a.out);
        let act_f: ExprBlob = parse_type(act[gd]);
        let arg_f: ExprBlob = parse_expr(string_as_str(&agg_body[gd]));

        // — the accumulator column's declaration —
        if uda[gd] {
            // UDA accumulator column: the user's A type, threaded verbatim
            // (a struct accumulator must be Copy — Vec.get/set fold cells).
            let uacc: ExprBlob = parse_type(uda_acc[gd]);
            let uacc2: ExprBlob = parse_type(uda_acc[gd]);
            acols.push(quote_block! { let mut #n_ga: Vec<#(uacc)> = Vec::<#(uacc2)>::new(); });
        } else if agg_flt[gd] {
            acols.push(quote_block! { let mut #n_ga: Vec<f64> = Vec::<f64>::new(); });
        } else {
            // ⚠ THE CELL'S TYPE IS `acc[gd]`, NOT THE LITERAL `i64` THAT USED TO
            // BE HERE. `Vec<i64>` was the decision that made every one of this
            // fold's refusals: `check_agg_operand` was told the accumulator is an
            // i64 and correctly refused a `u64` argument, because the only route
            // into an i64 cell REINTERPRETS. With the column's own type in the
            // cell there is nothing to refuse.
            let bacc_f:  ExprBlob = parse_type(acc[gd]);
            let bacc_f2: ExprBlob = parse_type(acc[gd]);
            acols.push(quote_block! { let mut #n_ga: Vec<#(bacc_f)> = Vec::<#(bacc_f2)>::new(); });
        }

        // — the group-creation SEED —
        if uda[gd] {
            let s_init: String = suffixed(a.fn_name, "_init");
            let n_init: Ident = Ident::new(string_as_str(&s_init));
            seeds.push(quote_block! { #n_ga.push(#n_init()); });
        } else if agg_flt[gd] {
            // ⚠ The seed is the DATA ORDER's own extremum, not `f64::MAX`.
            // `f64::MAX` is not the largest f64 — ±inf and NaN all lie beyond
            // it — so seeding there made `min` over `{ +inf }` answer
            // 1.797…e308, a value present in NO row. Under `f64_data_key`
            // (PostgreSQL's order: all NaNs one value and the greatest) the top
            // is the canonical NaN and the bottom is −inf, so any row value
            // displaces the seed — a group in `group by` is never empty.
            // `f64::MAX` as a datum answers normally again: it is a value, not
            // a marker.
            if fnid == AGG_MIN() {
                seeds.push(quote_block! { #n_ga.push(f64_from_bits(0x7FF8000000000000u64)); });
            } else if fnid == AGG_MAX() {
                seeds.push(quote_block! { #n_ga.push(f64_from_bits(0xFFF0000000000000u64)); });
            } else {
                seeds.push(quote_block! { #n_ga.push(0.0f64); });
            }
        } else if fnid == AGG_MIN() {
            // ⚠ THE SEED IS THE ACCUMULATOR'S OWN EXTREMUM, and the literals
            // 9223372036854775807i64 / -9223372036854775808i64 that stood here
            // were the SIGNED order's. Under a `u64` cell those are not extrema
            // at all — i64::MIN's bits read as u64 are 2^63, the MIDDLE of the
            // range — so `max` over a single row holding 5 would answer 2^63, a
            // value present in no row. That is the measurement
            // `el_wrap_ord_least`'s header records, and it is the reason the
            // seeds move with the cell rather than beside it. `greatest` seeds
            // `min` and `least` seeds `max`; the incremental fold uses the same
            // pair with the same polarity.
            let sd: ExprBlob = parse_expr(agg_acc_greatest(acc[gd]));
            seeds.push(quote_block! { #n_ga.push(#(sd)); });
        } else if fnid == AGG_MAX() {
            let sd2: ExprBlob = parse_expr(agg_acc_least(acc[gd]));
            seeds.push(quote_block! { #n_ga.push(#(sd2)); });
        } else {
            let sz: ExprBlob = parse_expr(agg_acc_zero(acc[gd]));
            seeds.push(quote_block! { #n_ga.push(#(sz)); });
        }

        // — the per-row FOLD step —
        if uda[gd] {
            let s_step: String = suffixed(a.fn_name, "_step");
            let n_step: Ident = Ident::new(string_as_str(&s_step));
            folds.push(quote_block! {
                #n_ga.set(__gi, #n_step(#n_ga.get(__gi), (#(arg_f))));
            });
        } else if fnid == AGG_COUNT() {
            folds.push(quote_block! { #n_ga.set(__gi, #n_ga.get(__gi) + 1i64); });
        } else if fnid == AGG_SUM() && !agg_flt[gd] {
            // i64 `sum` ACCUMULATOR is error-returning: a running-total overflow
            // becomes Err(ElError) via el_add(…)?, never a trap — the sibling of
            // EL scalar arithmetic and of the dynamic/incremental sum
            // accumulators.
            //
            // ⚠ THE ARG IS CHECKED — by `check_agg_operand`, in
            // `compute_agg_bodies`. This comment used to say "the arg is already
            // checked" and nothing checked it: `el_add(acc, (s.v))` over a `u64`
            // column reached the host compiler as `arg 2: expected i64, got u64`.
            //
            // ⚠⚠ AND THE OVERFLOW PREDICATE IS CHOSEN BY THE ACCUMULATOR'S TYPE
            // AND BY NOTHING ELSE — the same rule the incremental fold takes.
            // `el_add` unconditional was the OTHER half of the u64 refusal, and
            // the half that made a naive fix strictly worse than the refusal:
            // a `u64` cell added through i64's predicate answers `{2^62, 2^62}`
            // with an Err it should not raise and `{5, 2^63, 2^64-1}` with a
            // quiet wrong number and no Err at all. Both directions are pinned
            // by `wql_agg_wide_int_arg_e2e`.
            if str_eq(acc[gd], "u64") {
                folds.push(quote_block! { #n_ga.set(__gi, el_addu(#n_ga.get(__gi), (#(arg_f)))?); });
            } else {
                folds.push(quote_block! { #n_ga.set(__gi, el_add(#n_ga.get(__gi), (#(arg_f)))?); });
            }
        } else if fnid == AGG_SUM() || fnid == AGG_AVG() {
            if agg_cast[gd] {
                folds.push(quote_block! { #n_ga.set(__gi, #n_ga.get(__gi) + ((#(arg_f)) as f64)); });
            } else {
                folds.push(quote_block! { #n_ga.set(__gi, #n_ga.get(__gi) + (#(arg_f))); });
            }
        } else if fnid == AGG_MIN() {
            // ⚠ f64 folds through `f64_data_key`, not `<`. `<` is PARTIAL: a NaN
            // is neither less nor greater than anything, so `max` over
            // { NaN, 1.0 } answered 1.0 where the order says NaN is the greatest.
            // The comparison is STRICT, so among values with the same key the
            // FIRST in row order wins. The seed therefore survives only when the
            // whole group is NaN — and then the answer is the canonical NaN,
            // which under this order IS the value the group holds: all NaNs are
            // one value. The i64 arms keep `<`/`>` — that order is already total
            // and i64::MAX/MIN really are its extrema.
            if agg_flt[gd] {
                folds.push(quote_block! {
                    { let __v: f64 = (#(arg_f)); if f64_data_key(__v) < f64_data_key(#n_ga.get(__gi)) { #n_ga.set(__gi, __v); } }
                });
            } else {
                // ⚠ THE BINDING'S TYPE IS THE CELL'S. `let __v: i64` hardcoded
                // here is what produced `let '__v': type mismatch — expected
                // i64, got u64` from inside the generated blob; the comparison
                // that follows is then the CELL's `<`, which for a u64 cell is
                // u64's order and is exactly the order the column asked for.
                let vt: ExprBlob = parse_type(acc[gd]);
                folds.push(quote_block! {
                    { let __v: #(vt) = (#(arg_f)); if __v < #n_ga.get(__gi) { #n_ga.set(__gi, __v); } }
                });
            }
        } else {
            if agg_flt[gd] {
                folds.push(quote_block! {
                    { let __v: f64 = (#(arg_f)); if f64_data_key(__v) > f64_data_key(#n_ga.get(__gi)) { #n_ga.set(__gi, __v); } }
                });
            } else {
                let vt2: ExprBlob = parse_type(acc[gd]);
                folds.push(quote_block! {
                    { let __v: #(vt2) = (#(arg_f)); if __v > #n_ga.get(__gi) { #n_ga.set(__gi, __v); } }
                });
            }
        }

        // — the FINALIZED column (typed by the finalized column type; a UDA
        //   column narrows from A to R's lattice type here, via <name>_fin) —
        let act_f2: ExprBlob = parse_type(act[gd]);
        fcols.push(quote_block! { let mut #n_gf: Vec<#(act_f)> = Vec::<#(act_f2)>::new(); });
        if uda[gd] {
            let acc_read: ExprBlob = quote_expr! { #n_ga.get(__r0) };
            let fin: ExprBlob = uda_finalize_frag(a.fn_name, acc_read, uda_fin[gd],
                                                  uda_fin_cast(uda_ret[gd]));
            let act_f3: ExprBlob = parse_type(act[gd]);
            freads.push(quote_block! { let #n_out: #(act_f3) = #(fin); });
        } else if fnid == AGG_AVG() {
            let act_f3: ExprBlob = parse_type(act[gd]);
            freads.push(quote_block! {
                let #n_out: #(act_f3) =
                    (if __g_cnt.get(__r0) > 0i64 { #n_ga.get(__r0) / (__g_cnt.get(__r0) as f64) }
                     else { 0.0f64 });
            });
        } else {
            let act_f3: ExprBlob = parse_type(act[gd]);
            freads.push(quote_block! { let #n_out: #(act_f3) = #n_ga.get(__r0); });
        }
        fpush.push(quote_block! { #n_gf.push(#n_out); });
        gd = gd + 1i64;
    }

    // The inner FOLD — find/insert the row's group by a linear `__g_key` scan
    // (the MVP dedup), bump `__g_cnt`, fold each accumulator column.
    let key_f: ExprBlob = parse_expr(string_as_str(&key_body));
    let mut inner: ExprBlob = quote_block! {
        let __k: #(keyt_f) = (#(key_f));
        let mut __gi: i64 = -1i64;
        let mut __s: i64 = 0i64;
        while __s < __g_key.len() { if __g_key.get(__s) == __k { __gi = __s; } __s = __s + 1i64; }
        if __gi < 0i64 {
            __g_key.push(__k);
            __g_cnt.push(0i64);
            __g_row.push(__i0);
            #( #seeds; )*
            __gi = __g_key.len() - 1i64;
        }
        __g_cnt.set(__gi, __g_cnt.get(__gi) + 1i64);
        #( #folds; )*
    };
    if has_where {
        let where_f: ExprBlob = parse_expr(string_as_str(&where_body));
        inner = quote_block! { if (#(where_f)) #(inner) };
    }

    // The joined-stream nest (NO limit on the match loops — grouping needs
    // every row; `limit` caps the group-row OUTPUT phase below).
    let no_lim: ExprBlob = parse_expr("0i64");
    let mut ki2: i64 = ch.n - 1i64;
    while ki2 >= 0i64 {
        inner = step_wrap(inner, ki2 + 1i64, st_strat[ki2], ch.anti[ki2],
                          st_hasres[ki2], st_ktn[ki2], ch.src[ki2], ch.ty[ki2],
                          ch.var[ki2], ch.byval[ki2], string_as_str(&st_probe[ki2]),
                          string_as_str(&st_resid[ki2]), string_as_str(&st_pred[ki2]),
                          no_lim, false, st_stream[ki2]);
        ki2 = ki2 - 1i64;
    }
    let nest: ExprBlob = quote_block! {
        let mut __i0: i64 = 0i64;
        while __i0 < (#(base_src_f)).len() {
            let #base_vnm: &#(base_ty_f) = &(#(base_src_f))[__i0];
            #(inner);
            __i0 = __i0 + 1i64;
        }
    };

    // FINALIZE pass — `__ga_*` (accumulator type A) → `__gf_*` (the finalized
    // column type R), with `having` gating the group row.
    let rep_idx: ExprBlob = quote_expr! { __g_row.get(__r0) };
    let rebind: ExprBlob = row_rebind_frag(ch.base_var, ch.base_ty, ch.base_src, rep_idx);
    let mut keep: ExprBlob = quote_block! {
        __gf_key.push(key);
        __gf_row.push(__g_row.get(__r0));
        #( #fpush; )*
    };
    if has_having {
        let hav_f: ExprBlob = parse_expr(string_as_str(&having_body));
        keep = quote_block! { if (#(hav_f)) #(keep) };
    }
    let finalize: ExprBlob = quote_block! {
        let mut __gf_key: Vec<#(keyt_f)> = Vec::<#(keyt_f)>::new();
        let mut __gf_row: Vec<i64> = Vec::<i64>::new();
        #( #fcols; )*
        let mut __r0: i64 = 0i64;
        while __r0 < __g_key.len() {
            #(rebind);
            let key: #(keyt_f) = __g_key.get(__r0);
            #( #freads; )*
            #(keep);
            __r0 = __r0 + 1i64;
        }
    };

    // Group-row OUTPUT phase: order → project → distinct → limit.
    let mut collect: ExprBlob = quote_block! { __ix0.push(__r); };
    let mut ksdecl: ExprBlob = quote_block! { };
    let mut sortp:  ExprBlob = quote_block! { };
    if mods.has_sort {
        let okeyt_f: ExprBlob = parse_type(okey_ty);
        let okey_f:  ExprBlob = parse_expr(string_as_str(&okey_body));
        let binds_r: ExprBlob = group_binds_frag(quote_expr! { __r }, &aggs, acount, &act,
                                                 key_ty, ch.base_var, ch.base_ty, ch.base_src);
        ksdecl = quote_block! { let mut __ks: Vec<#(okeyt_f)> = Vec::<#(okeyt_f)>::new(); };
        collect = quote_block! {
            #(binds_r);
            __ix0.push(__r);
            __ks.push(#(okey_f));
        };
        sortp = sort_perm_frag(okey_ty, mods.sort_desc, 1i64);
    }
    let binds_o: ExprBlob = group_binds_frag(quote_expr! { __ix0.get(__o) }, &aggs, acount, &act,
                                             key_ty, ch.base_var, ch.base_ty, ch.base_src);
    let push_f: ExprBlob = push_guarded_frag(result_ty, proj_f, mods.distinct);
    let mut ocond: ExprBlob = quote_expr! { __o < __ix0.len() };
    if mods.has_limit {
        let lim_f: ExprBlob = limit_expr(&mods);
        ocond = quote_expr! { __o < __ix0.len() && __out.len() < (#(lim_f)) };
    }
    let output: ExprBlob = quote_block! {
        let mut __ix0: Vec<i64> = Vec::<i64>::new();
        #(ksdecl);
        let mut __r: i64 = 0i64;
        while __r < __gf_key.len() {
            #(collect);
            __r = __r + 1i64;
        }
        #(sortp);
        let mut __o: i64 = 0i64;
        while #(ocond) {
            #(binds_o);
            #(push_f);
            __o = __o + 1i64;
        }
    };

    let body_f: ExprBlob = quote_block! {
        #(pre_f);
        let mut __out: Vec<#(elem_f)> = Vec::<#(elem_f)>::new();
        #( #bps; )*
        let mut __g_key: Vec<#(keyt_f)> = Vec::<#(keyt_f)>::new();
        let mut __g_cnt: Vec<i64> = Vec::<i64>::new();
        let mut __g_row: Vec<i64> = Vec::<i64>::new();
        #( #acols; )*
        #(nest);
        #(finalize);
        #(output);
        return Result::Ok(__out);
    };
    emit_query_fn(fn_name, params_text, prm.tparams, rty.as_str(), body_f, prm,
                  prep_ground(WG_AGG(), chain_axis(ch.n)));
    // ── AND, WHEN THE SHAPE ADMITS IT, THE INCREMENTAL FORM (P1) ────────────
    // ⚠ AFTER THE BATCH FN AND NOT BEFORE, WHICH IS A SEMANTIC ORDER AND NOT A
    // TIDINESS ONE. Everything this call reads — the stamped types, the key, the
    // aggregate reprs, the projection body — was computed and CHECKED above, so
    // a query the batch emitter refuses never reaches here and the incremental
    // form cannot admit what the batch form refused.
    //
    // ── THE `u64` CELL, CLOSED 2026-08-06, AND WHAT IT ACTUALLY COST ──────────
    // It used to be that `check_agg_operand` refused a `u64` `sum` for the BATCH
    // accumulator and the item failed before this line, so `agg_acc_ty`'s `u64`
    // row was reachable from `compute_acc_tys` and from no query. The comment
    // here once said closing it was "one call site (`compute_acc_tys(...,
    // true, ...)` for the batch too) plus two fixture moves". That was WRONG in
    // both directions and it is worth recording which:
    //   * flipping the flag ALONE gave a `u64` cell added through `el_add`, the
    //     SIGNED predicate — a wrong answer where there had been a refusal;
    //   * and the four emitter sites it then named (flag, fold branch, vector
    //     element type, seeds) were still only four of SEVEN. The three it
    //     missed are the ones that are not arithmetic at all: the min/max
    //     binding's `let __v: i64`, the finalized COLUMN type
    //     (`compute_agg_col_tys`), and the aggregate OUTPUT NAME's recorded type
    //     (`stamp_agg_out_types`, which decides the result element type through
    //     `infer_emit_ty`). The last two are also what forced the accumulator to
    //     be computed ABOVE them rather than beside this call.
    // The control is `{2^62, 2^62}` ANSWERING 2^63 and `{5, 2^63, 2^64-1}`
    // ERRING, end to end through a query — `wql_agg_wide_int_arg_e2e`.
    //
    // ⚠ WHAT REMAINS NARROWER THAN THE INTERPRETER HERE IS `f32` `sum`, and it
    // is withheld deliberately rather than missed: widening a float accumulator
    // past its argument's width decides what a long `sum` answers and the caller
    // cannot undo it (`el_agg_arg_reaches`' header, `wql_agg_f32_arg_fail`).
    if !emit_incremental(&ch, &ty, &aggs, acount, &uda, &agg_flt, &agg_cast, &act, &acc,
                         key_ty, string_as_str(&key_body), result_ty, tres,
                         string_as_str(&proj_body), string_as_str(&having_body),
                         has_having, proj_opt, having_ref, has_where, mods,
                         fn_name, params_text, prm, prelude, h) { return false; }
    return true;
}

// ══ THE INCREMENTAL FORM OF AN AGGREGATE `deem!` (ADR 0024 / P1) ════════════
//
// A handle that keeps the group state BETWEEN calls, so a caller who appends
// rows pays for the appended rows and not for the whole source again:
//
//     let mut h: <Q>Incr = <q>_incremental();
//     <q>_epoch(&mut h, &rows_1)?;          // fold a batch of rows in
//     <q>_epoch(&mut h, &rows_2)?;          // …and another
//     let out: Vec<R> = <q>_snapshot(&h)?;  // the group rows, as `<q>()` returns them
//
// ── WHY THIS SHAPE, AND WHAT IT DELIBERATELY IS NOT ─────────────────────────
//
// ⚠ NO NEW SYNTAX, AND NONE IS AVAILABLE. The `deem` item head has no attribute
// slot (`pub_deem_def` in tools/peg_gen_cpp/grammars/logos.peg) and the query DSL
// has no modifier slot (stdlib/mem/wql/grammars/wql.peg — four shapes, no
// modifiers), so EVERY opt-in spelling is a grammar change and therefore a
// language-surface decision. What is emitter-only is UNCONDITIONAL-WHEN-ELIGIBLE,
// with eligibility DERIVED from the plan rather than listed by a caller — and it
// is what `deem!` already does for `<q>_prepare` / `<q>_run`, which nobody asks
// for by name either.
//
// ⚠ THREE FREE FNS AND NOT AN `impl`, AND THE REASON IS A MEASURED QUOTE GAP.
// `pub fn epoch(&mut self, #(ps))` — a method whose parameter list is spliced —
// is a SYNTAX ERROR in the quote grammar today ("syntax error near '#'"), while
// the same `#(ps)` splice in a free fn and a fixed-parameter method both parse.
// So the surface follows the `<q>_prepare` / `<q>_run` convention, which is the
// one this emitter already uses and which needs no antiquote the grammar lacks.
// The gap is real and worth closing; the workaround here is not a text push.
//
// ⚠ THE DELTA IS THE SOURCE'S OWN ELEMENT TYPE, not a `ZBatch` of erased values.
// `<q>_epoch` takes the query's parameter list VERBATIM — the same one `<q>()`
// takes — so the rows going in are typed exactly as the batch form's are. Typing
// the accumulator while leaving the input erased would have left `RtVal` at the
// door.
//
// ⚠ THERE IS NO `had_error()`. The dynamic engine latches a fault on the handle
// and answers it later; the static tier's convention is error-as-VALUE through
// `Result<_, ElError>` and `?`, so an overflowing epoch RETURNS the error at the
// epoch that overflowed. A latch would put the fault and its cause in different
// calls.
//
// ⚠ THE HANDLE BORROWS NOTHING. `IncrJoin` must hold `envp: *const QEnv` because
// it re-evaluates the query's SExprs against the catalog every epoch, which pins
// the env AND its sources alive for the handle's whole life. A typed handle has
// nothing left to re-evaluate: it owns its group key vector and its accumulators
// by value, so the caller may grow, move or drop the source between epochs. That
// is a strict capability gain and it FALLS OUT of the typing rather than being
// designed in — and it is also what forces the eligibility rule below, because a
// handle that owns its state cannot keep a group's representative ROW.
//
// ── WHAT INSERT-ONLY BUYS, AND WHAT IT DEFERS ───────────────────────────────
// The dynamic engine's per-(group, column) `vmap: HashMap<i64,i64>` (value →
// live multiplicity) and its RE-MIN/RE-MAX rescan exist SOLELY to serve a w = -1
// addend. With inserts only there is no inverse to take: `min`/`max` is an O(1)
// improve against one cached extremum and `sum`/`count`/`avg` are a plain
// monoid, so the whole map disappears and the state is typed SCALARS. That is a
// real saving and also a warning — the map comes back with `min`/`max`
// retraction, so this state shape is not final.
//
// ── P2: THE DELTA CARRIES (SOURCE, WEIGHT, ROWS) ────────────────────────────
//
// `<q>_apply(&mut h, __src: i32, __w: i64, <params VERBATIM>)` is now the ONE
// primitive, and `<q>_epoch` / `<q>_retract` are pure forwarders into it at
// (0, +1) and (0, −1). Three things about that shape were decided rather than
// fallen into, and each is a cost paid once:
//
// ⚠ THE SOURCE TAG IS IN THE SIGNATURE FROM THE OUTSET THOUGH ONLY ONE SOURCE
// EXISTS. `incr_eligible` refuses a join chain with the ground "a delta would
// have to name which source it belongs to" — the tag IS the retirement of that
// refusal, so it belongs in the signature the moment the refusal is written
// down and not after. It is the chain POSITION (`JChain`'s base is 0, step i is
// i+1), which is a number this file already has, so nothing new is derived.
//
// ⚠⚠ P3 MADE THE TAG LIVE AND STRICT, AND THE OLD BEHAVIOUR WAS A TRAP. It used
// to read "a delta tagged with a source this operator does not read contributes
// NOTHING and returns `Ok(0)`", which is honest only while a tag cannot be
// wrong. With two sources it is a caller mistake that folds nothing and answers
// SUCCESS — the one shape a fixture cannot tell from a working epoch. An
// out-of-range tag is now `Err(ElError::SrcUnknown)` on BOTH shapes, including
// the one-source one where it had been silent.
//
// ── P3: A JOIN OF ONE STEP, MAINTAINED ──────────────────────────────────────
//
// `incr_eligible` admits `ch.n == 1` — two distinct, non-streaming, non-anti,
// non-edge, by-reference sources whose row types are self-contained field by
// field — and the handle grows a `Vec<RowTy>` + `Vec<i64>` Z-set per side. The
// algebraic form, the integrate order, the cost and the "every other source
// parameter is UNREAD" rule are all stated at the two sites a reader hits them:
// the field declarations and the fold. Three consequences belong up here:
//
// ⚠ `<q>_epoch` / `<q>_retract` ARE NOT EMITTED FOR A JOIN QUERY. They forward
// at tag 0 and tag 0 is the base source, so their names would read as "an epoch
// of the query" while meaning "a delta on the left relation". `<q>_apply` is the
// whole surface there.
//
// ⚠ `Ok(__n)` COUNTS FOLDS, WHICH ON A JOIN IS MATCHED PAIRS AND NOT DELTA ROWS.
// On a bare scan every row folds, so the number is unchanged and every P1/P2
// fixture still reads it as "rows". On a join a delta row with no partner folds
// nothing and creates NO GROUP — which is what agrees with the batch fn, where
// an unmatched row never reaches the aggregate — so `Ok(0)` from a join apply
// means "accepted, matched nothing", not "did nothing".
//
// ⚠ FIRST-OCCURRENCE ORDER IS THE ORDER GROUPS ARE FIRST *MATCHED*. On a bare
// scan that is source order and `<q>_snapshot` is elementwise-equal to `<q>()`;
// on a join it depends on how the caller split the input into epochs and on
// which side arrived first, and it coincides with `<q>()`'s order only when the
// whole of one side is applied before the other. A join fixture must therefore
// compare against the batch fn BY KEY, not elementwise — see
// `deem_incr_join_e2e`, which says so where it does it.
//
// ⚠ THE NON-TRANSACTIONALITY WINDOW WIDENED, BY A FACTOR THAT CAN BE NAMED. The
// contract below still holds — on `Err` the handle is UNSPECIFIED — and no gate
// pins it. What changed: one delta ROW used to touch one group, so a mid-batch
// `Err` left at most `|delta|` folds half-applied. Under a join one delta row
// touches one group PER MATCHING ROW ON THE STORED SIDE, so the bound is
// `|delta| × |matches|`, and the source-side push happens after the whole inner
// loop — so an `Err` inside the nest leaves the delta row folded against some
// partners and NOT integrated into `__s<k>` at all. Not made atomic here;
// recorded so the next slice prices it rather than rediscovers it.
//
// ⚠ THE WEIGHT IS A SCALAR PER BATCH, NOT A PARALLEL SLICE, AND THAT LOSES NO
// EXPRESSIVENESS. A Z-set row of weight k IS k copies of that row, so any
// mixed-weight bag is one `<q>_apply` call per distinct weight over a
// sub-batch. A `&[i64]` running alongside the row slice would be a fifth
// parallel cursor that can fall out of step with the rows — the defect class
// the four cursors below already carry a warning about — bought for nothing.
//
// ⚠ THE SURFACE'S SHAPE DEPENDS ON THE AGGREGATE LIST, AND THAT IS THE POINT.
// `<q>_retract` and the weight parameter are emitted ONLY for a query whose
// every aggregate can run backwards (`incr_retract_eligible`). A query with an
// f64 `sum`/`avg` keeps P1's surface unchanged — `<q>_epoch` with no weight — so
// a caller cannot express a retraction that the fold cannot answer. The
// alternative (emit the weight always, `Err` at run time) makes the SAME refusal
// a run-time surprise, and the ONE thing being refused is `(S+x)-x` over floats,
// which is an OPEN decision (D4) rather than a bug: a compile-time absence
// cannot answer it by accident, a run-time branch can.
//
// ⚠ `min`/`max` ARE ADMITTED, AT EVERY TYPE INCLUDING f64, AND THEY DO NOT
// INVERT — they RESCAN. A retract-eligible `min`/`max` carries a typed
// value→multiplicity map beside its cached extremum and re-derives the best from
// the map's live keys when the best itself is retracted. That computes no
// inverse, so it does not touch D4 at all.
//
// ── THE ERROR CONTRACT, AND WHAT IT DOES *NOT* PROMISE ──────────────────────
//
// ⚠⚠ `<q>_apply` IS NOT TRANSACTIONAL. On `Err` the handle is in an UNSPECIFIED
// INTERMEDIATE STATE and a caller must DISCARD it or replay from a known epoch —
// it must not read `<q>_snapshot` and treat the answer as either the pre-call or
// the post-call multiset. This is not an oversight being papered over, it is the
// contract this slice ships: `__gk`/`__gc` are written BEFORE the folds and the
// row loop returns at the first fault, so a mid-batch `Err` leaves earlier rows
// folded, this row's group count already moved, and possibly one of several
// aggregates updated. Under strict retraction (below) an `Err` is DESIGNED to be
// hit rather than exceptional, which makes the partial-state path ordinary.
//
// A bounded rollback was priced and NOT taken here: undoing one row means
// restoring `__gk`/`__gc`, un-inserting or re-inserting a map entry, and
// restoring a cached best that a rescan may already have overwritten — three
// undo logs across state the emitter builds per aggregate. Stating the contract
// costs nothing and does not foreclose it; a later slice that makes `_apply`
// atomic STRENGTHENS this promise and breaks no caller.
fn emit_incremental(ch: &JChain, ty: &ElTypes, aggs: &RAggArr, acount: i64,
                    uda: &[bool; 8], agg_flt: &[bool; 8], agg_cast: &[bool; 8],
                    act: &[str; 8], acc: &[str; 8], key_ty: str, key_body: str,
                    result_ty: str, tres: i32, proj_body: str, having_body: str,
                    has_having: bool, proj_e: SExpr, having_ref: WRef<SExpr>,
                    has_where: bool, mods: QMods,
                    fn_name: str, params_text: str, prm: &MacroParams,
                    prelude: str, h: &Writ) -> bool {
    let bare0: str = vis_strip(fn_name);
    // P3b — is the ENTRY's base source a declared `rel`? Asked here, ahead of
    // eligibility, because it decides the SURFACE (`incr_retract_eligible`) as
    // well as the shape, and one answer for both is what stops the emitted
    // signature and the state it owns from disagreeing. -1 = not rel-backed.
    // ⚠ Only meaningful once eligibility has ADMITTED it: the checks that make
    // it usable (single-member recursive SCC, one slice param, ownable rows) all
    // live in `incr_eligible`, which runs immediately below.
    let rel_m0: i64 = prm.rel_find_src(ch.base_src);
    // ⚠ THE RETRACT PREDICATE IS READ BEFORE ELIGIBILITY AND WITHOUT TRACING.
    // A JOIN chain is admitted only on the RETRACTING surface (the source tag
    // lives in `<q>_apply`'s signature and nothing else emits one), so the
    // shape question needs this answer — but the `retraction` axis is TRACED
    // exactly once per query that gets a handle, and `incr_eligibility_gate.sh`
    // asserts that identity as a derived count. `retract_ok` is the untraced
    // derivation both callers read, so the two cannot disagree.
    if !incr_eligible(ch, ty, aggs, acount, uda, act, key_ty, result_ty, tres,
                      has_having, proj_e, having_ref, has_where, mods, prm,
                      retract_ok(aggs, acount, acc) && rel_m0 < 0i64, bare0) {
        return true;
    }

    let mut iarg: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                 String::new(), String::new(), String::new(), String::new()];
    // ⚠ THE ACCUMULATORS ARE THE BATCH'S, PASSED IN. This used to call
    // `compute_acc_tys(..., true, ...)` and derive a SECOND array, because the
    // batch asked the same function with `false` and got the class
    // representative — one cell, two opinions, and the header above this call
    // used to argue at length that the incremental answer was a safe SUPERSET of
    // the batch's. There is no superset to argue about now: one array is
    // computed once, above `stamp_agg_out_types`, and both emitters read it. If
    // this call fails, the check and the admission disagree about an argument the
    // batch form already accepted — a defect in the compiler, not in the query,
    // and surfacing it loudly is the point.
    if !compute_agg_bodies(aggs, acount, ty, ch.base_var, h, uda,
                           agg_flt, agg_cast, acc, &mut iarg) { return false; }

    let bare: str = vis_strip(fn_name);
    let is_priv: bool = vis_is_priv(fn_name);
    let mut tyb: String = String::new();
    prep_type_name_sfx(bare, "Incr", &mut tyb);
    let tyn: str = string_as_str(&tyb);

    // ⚠ ASKED ONCE, HERE, AND IT DECIDES FOUR THINGS AT ONCE: which fold each
    // aggregate gets, whether `<q>_apply` carries a weight at all, whether
    // `<q>_retract` is emitted, and whether a `min`/`max` carries its
    // multiplicity MAP. One predicate for all four is what stops the emitted
    // signature, the state it owns and the arithmetic inside it from disagreeing
    // about what this query can do.
    let retr: bool = incr_retract_eligible(aggs, acount, acc, rel_m0 >= 0i64, bare);
    // From here the rel index is the ADMITTED one: eligibility has run and, if
    // it returned true with `rel_m0 >= 0`, every clause the rel arm depends on
    // holds. The slice parameter's index is re-found by the same walk the
    // admission used (`prm.is_slice`, exactly one).
    let rel_m: i64 = rel_m0;
    let mut rel_sp: i64 = -1i64;
    if rel_m >= 0i64 {
        let mut pk0: i64 = 0i64;
        while pk0 < prm.n {
            if prm.is_slice[pk0] { rel_sp = pk0; }
            pk0 = pk0 + 1i64;
        }
    }

    // ── the handle's FIELDS, its INITIALIZERS, the SEEDS and the FOLDS ──────
    // One pass, four parallel cursors, because every one of them is indexed by
    // the same aggregate and a second loop is a second thing to fall out of step.
    let mut fnames: Vec<Ident>    = vec_new::<Ident>();
    let mut ftys:   Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut seeds:  Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut folds:  Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut freads: Vec<ExprBlob> = vec_new::<ExprBlob>();
    // ⚠ THE FIELD NAMES LIVE IN THIS FRAME, NOT IN THE LOOP'S. `Ident::new`
    // BORROWS its bytes and these Idents are pushed into a Vec that outlives the
    // iteration that built them, so a `String` local to the loop body is a
    // dangling view by the time the quote is expanded. MEASURED before this
    // array existed: the handle type came out with its two fixed fields and NONE
    // of its accumulator fields, and the diagnostic was `struct 'QIncr' has no
    // field '__ga_a'` from inside the generated blob — the same class of defect
    // this file already carries a warning about above `ga_name`. The batch
    // emitter gets away with the loop-local String because it expands its quote
    // in the same iteration; this one does not.
    let mut ganm: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                 String::new(), String::new(), String::new(), String::new()];
    // The MULTIPLICITY MAP's field name, under the same frame-lifetime rule as
    // `ganm`, and the ONE decision about whether that field exists at all.
    let mut gmnm: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                 String::new(), String::new(), String::new(), String::new()];
    let mut wmap: [bool; 8] = [false, false, false, false, false, false, false, false];

    // ── THE SCC'S MEMBERS, IN THE ORDER `emit_scc_fn` PUTS THEM IN ITS ─────
    // ── SIGNATURE, AND THAT ORDER IS THE WHOLE CONTRACT — P3c ──────────────
    //
    // `emit_scc_fn` appends one `__tot_<m>: &mut Vec<RowTy>` out-param per
    // member by scanning the registry with `r` ASCENDING and taking every rel
    // whose `scc.comp[r]` is this SCC. The epoch body below builds the CALL, so
    // it must produce the same members in the same order or the totals bind to
    // the wrong parameters — and with two members of the SAME row type (the
    // odd/even pair is exactly that) the compiler would not catch it: it would
    // typecheck and answer with the members SWAPPED.
    //
    // ⚠ THE MEMBERSHIP TEST IS `rel_sccid`, NOT `scc`, because `scc` is not in
    // scope here — `stamp_rel_incr_shape` flattened `comp` onto the registry for
    // exactly this reason. Same array, same scan direction, one derivation.
    let mut tmem: [i64; 8] = [0i64; 8];
    let mut ntm:  i64      = 0i64;
    if rel_m >= 0i64 {
        let mut tk: i64 = 0i64;
        while tk < prm.rel_n {
            if prm.rel_sccid[tk] == prm.rel_sccid[rel_m] {
                if ntm < 8i64 { tmem[ntm] = tk; ntm = ntm + 1i64; }
            }
            tk = tk + 1i64;
        }
    }
    // The rel TOTAL fields' names — ONE PER SCC MEMBER (P3c), under the SAME
    // frame-lifetime rule `ganm` carries above: `Ident::new` BORROWS, and these
    // Idents are pushed into a Vec that outlives any block-local String that
    // built them. This was a single `String` while only one member could be
    // admitted; the array is what makes it survive N.
    let mut totnm: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                  String::new(), String::new(), String::new(), String::new()];
    let mut tn0: i64 = 0i64;
    while tn0 < ntm {
        totnm[tn0] = suffixed("__tot_", prm.rel_names[tmem[tn0]]);
        tn0 = tn0 + 1i64;
    }

    fnames.push(Ident::new("__gk"));
    ftys.push(parse_type_of_vec(key_ty));
    fnames.push(Ident::new("__gc"));
    ftys.push(parse_type_of_vec("i64"));

    // ══ THE JOINED SIDES' STATE — P3, AND IT *IS* THE PRODUCT RULE ═════════
    //
    // ⚠⚠ THE ALGEBRAIC FORM, STATED WHERE THE READER MEETS IT: this emitter
    // uses the PER-CALL SINGLE-DELTA form
    //
    //        ∆J  =  ∆S_k  ⋈  (every other side at its CURRENT stored contents)
    //
    // and INTEGRATES ∆S_k into `__s<k>` only AFTER the fold has run. It is not
    // the two-term form and it is not the three-term form, and the reason is the
    // SURFACE rather than a preference: `<q>_apply(&mut h, __src, __w, …)` names
    // exactly ONE source per call, so ∆B is identically zero while ∆A is being
    // applied. The three-term rule's cross term ∆A⋈∆B is not a term inside one
    // call at all — it is what the NEXT call computes when it reads A at its
    // post-integration contents. Compute-then-integrate is therefore the ENTIRE
    // content of the rule here, and getting the order backwards is exactly the
    // classic double count:
    //
    //     A={a1}, B={b1}, both matching. Same-epoch: apply(0,+1,{a2}) then
    //     apply(1,+1,{b2}). Correct is |A|·|B| = 2·2 = 4.
    //       compute-then-integrate : 1 (a2⋈{b1}) + 2 ({a1,a2}⋈b2) = 3, over the
    //                                1 already there  →  4   ✓
    //       integrate-then-compute : 2 + 2 = 4 over 1          →  5   ✗ (double)
    //       reading A PRE-delta    : 1 + 1 = 2 over 1          →  3   ✗ (loses
    //                                the cross term entirely)
    //     One number separates all three, which is why the fixture asserts it.
    //
    // ── WHAT THE HANDLE STORES, AND WHAT THAT COSTS ────────────────────────
    // Per joined side: `__s<k>: Vec<RowTy>` and `__s<k>w: Vec<i64>` — the side
    // as a Z-set IN NORMAL FORM: one entry per DISTINCT ROW, carrying that row's
    // multiplicity, and every multiplicity is ≥ 0.
    //
    // ⚠⚠ NORMAL FORM IS NOT AN OPTIMIZATION — IT IS WHAT MAKES THE STRICT GUARDS
    // SOUND, AND THE APPEND-ONLY ALTERNATIVE WAS DERIVED AND REJECTED FOR CAUSE.
    // Appending `(row, −1)` instead of decrementing needs no row identity at all
    // (a +1 and a −1 entry cancel in every product they enter), and the NET
    // answer is the same. But the folds are not applied net: `<q>_apply` walks
    // the pairs ONE AT A TIME, and every one of P2's strict guards — the group
    // count and, inside the semilattice fold, the per-VALUE multiplicity — fires
    // on an INTERMEDIATE state. WORKED THROUGH, on the fixture's own rows:
    // with `__s0 = a1:+1, a2:+1, a2:−1` and a delta `−1` on the other side, the
    // three pair folds carry weights −1, −1, +1; the middle one drives `min`'s
    // map entry for `a2.x` to −1 and returns `Err(RetractAbsent)` for a batch
    // that is perfectly legal. Normal form removes the case at the root: every
    // stored multiplicity is ≥ 0, so all pair weights in ONE call carry the sign
    // of `__wd` and the intermediate states are MONOTONE. Guards that fire only
    // on a genuine caller mistake are the whole of P2's contract.
    //
    // ⚠ THE PRICE OF NORMAL FORM IS ROW IDENTITY, WHICH IS WHY THE ELIGIBILITY
    // CLAUSE REFUSES A FLOAT FIELD. Finding the stored entry is a field-by-field
    // `==` over the row, and `==` on `f64` is not identity: NaN ≠ NaN would make
    // a row carrying a NaN un-retractable, and −0.0 == +0.0 would let a
    // retraction of one cancel an insert of the other. That is exactly the
    // question Victor reserved on 2026-08-07 for the multiplicity map's key, and
    // an emitter must not answer it by accident. Integers and `bool` only.
    //
    // ⚠ THE COST, STATED AS WHAT IT IS A FUNCTION OF RATHER THAN AS A BYTE
    // COUNT. `__s<k>` holds one entry per DISTINCT row ever applied to side k;
    // a row driven to multiplicity 0 keeps its slot (the same tombstone rule
    // `__gk` follows, and for the same reason — the alternative renumbers) but
    // nothing else accumulates. Per apply call: O(|delta| × |stored other side|)
    // for the fold plus O(|delta| × |stored own side|) for the identity search,
    // both UNINDEXED. A maintained arrangement (`HashMap<K, Vec<i64>>`, which is
    // what the interpreter keeps at `incr.logos:1162`) buys O(matches) instead,
    // and is NOT built here: it must itself be maintained under retraction,
    // which doubles the state that can go wrong while the correctness question
    // this slice answers lives entirely in the unindexed form. Named follow-up.
    //
    // ⚠⚠ NO BYTE FIGURE IS QUOTED, ON PURPOSE. The `want_map` comment above this
    // one records what happens when a construction FLOOR gets written down as a
    // FOOTPRINT: it understated memory by ~4 orders of magnitude and no gate
    // caught it. `sizeof(RowTy) + 8` per DISTINCT stored row is the SHAPE; the
    // number for any particular query is a paired maxRSS measurement on a named
    // row count and row type, and this arc has not made one.
    // ══ THE REL-BACKED HANDLE'S STATE — P3b ════════════════════════════════
    //
    // TWO fields, and their SIZE CLASS is a capability change worth stating
    // where a reader meets it rather than in a footnote. P1's handle held per
    // GROUP cells; P3's added the two joined sides. This one holds
    //
    //   `__edb`      — every input fact ever applied, deduplicated;
    //   `__tot_<m>`  — the rel's fixpoint TOTAL over that input,
    //
    // so it is O(|input| + |derived relation|). For a transitive closure the
    // second term is quadratic in the node count by nature of the answer, not by
    // anything this emitter chose. That is the price of the capability: the
    // fixpoint is a function of the ACCUMULATED input and of nothing smaller, so
    // a handle that answers correctly across epochs must own the accumulation.
    //
    // ⚠⚠ THE INBOUND COLLAPSE BOUNDARY IS `__edb`, AND IT IS THE ABSENCE OF A
    // FIELD THAT ENFORCES IT. P3's stored sides are `__s<k>` PLUS `__s<k>w` — a
    // Z-set with multiplicities. `__edb` has NO weight vector, deliberately:
    // there is no `Vec<i64>` beside it for a multiplicity to live in, so "the
    // same edge twice is one fact" is structural rather than a rule somebody
    // must remember. Counting derivations through a cycle DIVERGES
    // (`path(a,b) :- path(a,c), edge(c,b)` has unboundedly many derivations of
    // one fact), so a weight must not cross into the SCC — and it cannot, since
    // nothing here can express one.
    //
    // ⚠ NO BYTE FIGURE IS QUOTED. Nothing here has been measured at any size,
    // and this file already records what happened the last time a construction
    // floor was written down as a footprint (understated by ~4 orders of
    // magnitude, no gate caught it).
    if rel_m >= 0i64 {
        fnames.push(Ident::new("__edb"));
        ftys.push(parse_type_of_vec(prm.tys[rel_sp]));
        // ⚠ ONE TOTAL FIELD PER SCC MEMBER — P3c — AND `__edb` STAYS ONE.
        // The size class is stated because it is the capability's price and a
        // reader will ask: every member of the SCC reads the SAME single slice
        // parameter (the one-slice-param clause below is what guarantees it), so
        // there is exactly ONE accumulated input no matter how many members
        // there are, and the handle grows by one `Vec` per ADDITIONAL member's
        // relation. O(|input| + Σ_m |member m's relation|), counted in ROWS.
        // For the odd/even pair over a chain of n edges that sum is n(n+1)/2 —
        // the same total as the single transitive-closure rel over the same
        // chain, split across two Vecs, not N× that. NO BYTE FIGURE IS QUOTED:
        // this file's `want_map` note records a construction floor written down
        // as a footprint, wrong by ~4 orders of magnitude with no gate to catch
        // it, and nothing here has been weighed.
        let mut tf: i64 = 0i64;
        while tf < ntm {
            fnames.push(Ident::new(string_as_str(&totnm[tf])));
            ftys.push(parse_type_of_vec(prm.rel_rowty[tmem[tf]]));
            tf = tf + 1i64;
        }
    }
    let joined: bool = ch.n == 1i64;
    // ══ THE BARE SCAN'S RETRACT SENSOR, AND WHY IT IS NOT THE JOIN'S ═════════
    //
    // ⚠⚠ THIS CLOSES A SHIPPING SILENT WRONG ANSWER, MEASURED ON 360b2761 AND
    // REPRODUCED HERE BEFORE ANYTHING WAS EDITED:
    //
    //     pub deem sums(rs: &[R]) { from rs r group by r.g
    //                               aggregate s = sum(r.v) select (key, s) }
    //     insert (1,10) and (1,5)  → the group reads 15
    //     sums_retract(&mut h, [(1,999)])  → **Ok(1)**, and the group reads −984
    //
    // A public fn returned a number no input produces, on a live handle, and
    // said it succeeded. The reason NO sensor fired is structural rather than an
    // oversight, and it is worth naming because it is what decides the shape of
    // the fix: `core`'s guard 1 catches a key never seen and guard 2 catches a
    // group's ROW COUNT driven below zero — the count here goes 2 → 1, which is
    // LEGAL — and the only VALUE-level sensor in the whole handle is the
    // multiplicity map, which `want_map` builds for a `min`/`max` and for
    // nothing else. A sum-only or count-only handle carries no state that can
    // see "this row was never here". Adding `min(r.v)` to the same query does
    // return `Err(RetractAbsent)` — from guard 3, at line ~4982, which is NOT a
    // peer of guards 1 and 2: it lives INSIDE one element of `#folds`, and
    // `#folds` is spliced in AGGREGATE DECLARATION ORDER, so the `sum` declared
    // before it has already committed −984 by the time it speaks.
    //
    // ── WHAT IS STORED, AND WHY IT IS *NOT* THE ROW ─────────────────────────
    // The join arm stores whole ROWS (`__s0`), and lifting that verbatim was the
    // first plan. It does not survive contact with the corpus: row storage drags
    // `incr_row_ty_ok` with it — the clause that refuses a `str` field (the
    // handle would hold a view of source bytes it does not own) and an `f64`
    // field (`==` is not identity) — and MEASURED over `tests/logos/pass`, that
    // clause refuses `wql_incr_eligibility_matrix.ok_basic` (its row carries
    // `nm: str`) and `deem_incr_diff_harness.q5_icnt` (its row carries
    // `xf: f64`), BOTH of which call `<q>_retract` today. Lifting it would have
    // deleted a capability two green fixtures exercise.
    //
    // So what is stored is the FOLD'S FOOTPRINT: the group KEY, followed by
    // every aggregate ARGUMENT. That is not a compromise, it is the exact set
    // the bare-scan fold READS from a delta row — `core` computes `__k` from
    // `key_body` and each `#folds` element from its `iarg`, and eligibility has
    // already barred `where`, `order by`, `limit` and any `select` reaching a
    // source row, so nothing else of the row can reach the handle. Two rows
    // agreeing on the footprint are therefore INDISTINGUISHABLE to this handle:
    // folding one and retracting the other leaves it in exactly the state a
    // correct retraction would.
    //
    // ⚠ AND THAT IS ALSO EXACTLY WHAT IT DOES **NOT** CATCH, stated where a
    // caller hits it rather than left to be found. Identity is up to the fields
    // the fold reads, so on `struct S { g, v, nm: str }` grouped by `g` and
    // summing `v`, retracting `(1, 5, "x")` when only `(1, 5, "y")` was inserted
    // is ACCEPTED. The handle's answers are unmoved by the difference, so no
    // observation of it can disagree — but a caller who believes `_retract`
    // policies whole-row provenance is wrong, and the corpus pins this as a
    // DEFECT rather than as a property (`wql_incr_retract_footprint_identity`).
    // A count-only query has an EMPTY argument list, so its footprint is the key
    // alone and its sensor degenerates into guard 2; that is the same statement
    // at its limit (a `count` reads nothing but presence) and is pinned there.
    //
    // ⚠ THE FLOAT COMPONENT IS KEYED ON `f64_to_bits`, WHICH IS NOT A NEW
    // DECISION — it is the SAME function the multiplicity map beside it already
    // keys on (see `kv_e`, below), for the same reason: `f64_to_bits` is
    // injective, so it is identity, while `f64_data_key` collapses both zeros
    // and every NaN. When Victor's scheduled f64/f32 KEY task lands (all zeros
    // one element, all NaNs one element) it must move BOTH — this line and
    // `kv_e` — and that is why it is spelled the same way here.
    // A float can also reach the footprint through the group KEY, where the
    // comparison is `keyt_f`'s own `==`; that is not this clause's choice
    // either, it is the identical relation `core`'s `__gk` scan has always used
    // to find a group, inherited unchanged so the two cannot disagree.
    //
    // ⚠ GATED ON `retr`, NOT EMITTED UNCONDITIONALLY. The join arm's `__s0` is
    // the JOIN's state and is needed whatever the surface; this one is a
    // RETRACTION sensor and an insert-only query must not pay a scan and a Vec
    // for a capability it does not have. That is the opposite of the mistake
    // `want_map`'s note above records (a map built from ELIGIBILITY and paid for
    // by insert-only callers) only because `retr` IS the surface here: a query
    // that cannot retract cannot reach the refusal.
    let sens: bool = retr && !joined;
    // `(KeyTy, A0, A1, …)` and `((key_body), (arg0), (arg1), …)` — ONE walk
    // writes both, so a component whose type is declared here can never be
    // missing from the value, which is the `accw`/`compute_acc_tys` antipattern
    // this file already carries two warnings about.
    let mut fpty: String = String::new();
    let mut fpex: String = String::new();
    if sens {
        fpty.push_str("(");
        fpty.push_str(key_ty);
        fpex.push_str("((");
        fpex.push_str(key_body);
        fpex.push_str(")");
        let mut fi: i64 = 0i64;
        while fi < acount {
            // `count()` HAS NO ARGUMENT — `compute_agg_bodies` leaves `iarg`
            // EMPTY for it, so this is not an optimisation, it is the only
            // spelling that parses.
            if agg_of_name(aggs.agg_at(fi).fn_name) != AGG_COUNT() {
                fpty.push_str(", ");
                fpex.push_str(", ");
                if agg_flt[fi] {
                    // Reachable only through `min`/`max`: a float `sum` and
                    // every `avg` lost the retracting surface to D4, so no other
                    // aggregate can present a float argument on this path.
                    fpty.push_str("u64");
                    fpex.push_str("f64_to_bits(");
                    fpex.push_str(string_as_str(&iarg[fi]));
                    fpex.push_str(")");
                } else {
                    fpty.push_str(acc[fi]);
                    fpex.push_str("(");
                    fpex.push_str(string_as_str(&iarg[fi]));
                    fpex.push_str(")");
                }
            }
            fi = fi + 1i64;
        }
        fpty.push_str(")");
        fpex.push_str(")");
    }
    if joined {
        fnames.push(Ident::new("__s0"));
        ftys.push(parse_type_of_vec(ch.base_ty));
        fnames.push(Ident::new("__s0w"));
        ftys.push(parse_type_of_vec("i64"));
        fnames.push(Ident::new("__s1"));
        ftys.push(parse_type_of_vec(ch.ty[0]));
        fnames.push(Ident::new("__s1w"));
        ftys.push(parse_type_of_vec("i64"));
    }
    if sens {
        fnames.push(Ident::new("__s0"));
        ftys.push(parse_type_of_vec(string_as_str(&fpty)));
        fnames.push(Ident::new("__s0w"));
        ftys.push(parse_type_of_vec("i64"));
    }

    let mut gi: i64 = 0i64;
    while gi < acount {
        let a: RAgg = aggs.agg_at(gi);
        let fnid: i32 = agg_of_name(a.fn_name);
        let acct: str = acc[gi];
        ganm[gi] = ga_name(a.out);
        let n_ga: Ident = Ident::new(string_as_str(&ganm[gi]));
        let n_out: Ident = Ident::new(a.out);
        let arg_f: ExprBlob = parse_expr(string_as_str(&iarg[gi]));

        fnames.push(Ident::new(string_as_str(&ganm[gi])));
        ftys.push(parse_type_of_vec(acct));

        // ── THE MULTIPLICITY MAP, AND WHY IT IS ONE FIELD PER min/max ───────
        // `count` and `sum` have INVERSES; `min` and `max` do not. Retract the
        // current minimum and the new minimum is a fact about every OTHER row
        // still present, which a scalar cell cannot hold — so a min/max on a
        // retract-eligible query carries a value→live-multiplicity map beside
        // its cached extremum, exactly the pair the dynamic engine keeps
        // (`AggState.vmap` / `AggState.vbest`) and exactly the pair P1 deleted
        // on purpose with a comment saying this slice would put it back.
        //
        // ⚠⚠ IT IS EMITTED WHEREVER THE WEIGHT IS, SO AN INSERT-ONLY CALLER PAYS
        // FOR IT, AND "PAYS NOTHING" WAS MEASURED AND IS FALSE. `want_map`
        // derives from ELIGIBILITY, not from USE: nothing in the surface
        // declares that a query will ever retract, so every retract-eligible
        // `min`/`max` query builds and maintains the map even if only
        // `<q>_epoch` is ever called. MEASURED on this box, 2026-08-06, over an
        // insert-only `min`+`max` on a u64 column, 200 000 rows × 20 epochs =
        // 4 M rows, 4 groups so the O(rows × groups) key scan is not the
        // denominator, same binary and same data with only `want_map` flipped:
        //
        //     scalar cells (P1's shape) : 0.113 s     handle 96 bytes
        //     with the map              : 0.608 s     handle 144 bytes
        //
        // 5.4× on the fold — ≈62 ns added per aggregate per row — plus 4
        // mallocs and 544 bytes of heap per GROUP (two `hashmap_new`s, each
        // `alloc(16)` for the state bytes and `alloc(16 × 16)` for the
        // `Entry<u64,i64>` table at the default capacity of 16), all for a
        // capability the caller never uses.
        //
        // ⚠⚠ THAT 544 BYTES IS THE FLOOR AT CONSTRUCTION, NOT THE FOOTPRINT,
        // AND READING IT AS THE FOOTPRINT UNDERSTATES MEMORY BY ~4 ORDERS OF
        // MAGNITUDE. The map is keyed by DISTINCT VALUE, so it grows with the
        // column's cardinality and not with the group count: an independent
        // paired measurement on a high-cardinality column (~50 000 distinct
        // values per group, FOUR groups) read 23.2 MB maxRSS against 4.6 MB
        // with `want_map` off — +18.5 MB where this paragraph's arithmetic
        // predicts about 2 KB. The per-group number above is what the two
        // `hashmap_new`s cost BEFORE a single row is folded.
        //
        // ⚠ THE FOLD FACTOR DOES NOT REPLICATE EITHER, and both numbers stand
        // because neither run has been bisected. Same box, only `want_map`
        // flipped: this paragraph's 5.4× against 2.9× high-cardinality and
        // 2.1× low-cardinality measured separately, ~2.3–3.1× once the common
        // 200k-row build is subtracted. The DIRECTION agrees, the MAGNITUDE
        // does not. The second run's query carries `count()` beside min+max,
        // which is one candidate denominator and is not the measured one.
        // ⚠ NO GATE PINS ANY OF THESE NUMBERS — they are prose, and the first
        // reader to need one must re-measure rather than cite.
        //
        // ⚠ AND THE SAME MEASUREMENT AT 500 GROUPS SHOWS +2.3%, NOT 5.4× — the
        // linear key scan swamps it there. So the cost is invisible on wide-group
        // queries and glaring on narrow ones, which is exactly the shape a single
        // benchmark reports as "negligible" if it happens to pick wide groups.
        //
        // NOT FIXED HERE, and deliberately: the repair is a surface that lets a
        // query DECLARE that it retracts, which is a design fork belonging to
        // whoever owns the surface — and taking it inside this emitter would be
        // the same "decide an open question by accident" this file refuses to do
        // for D4. The number is recorded so the fork is taken on a measurement
        // rather than on this comment's predecessor, which asserted the opposite.
        let is_mm: bool = fnid == AGG_MIN() || fnid == AGG_MAX();
        let want_map: bool = retr && is_mm;
        // ⚠ RECORDED, NOT RE-DERIVED DOWNSTREAM. The constructor a hundred lines
        // below has to initialize exactly the fields declared here, and asking
        // the same question again from `aggs` + `acc` is one cell with two
        // opinions, free to disagree — the antipattern this file already carries
        // two warnings about (`accw`, `compute_acc_tys`). MEASURED in the
        // candidate this was ported from: a control revert on the predicate made
        // the field vanish and left the initializer standing, and the diagnostic
        // was `struct literal 'UqIncr': unknown field '__gm_mn'` from inside the
        // generated blob rather than a wrong answer.
        wmap[gi] = want_map;
        let is_fl: bool = str_eq(acct, "f64");
        // K of the map, and the type `min`/`max` COMPARE in. For i64 and u64 the
        // cell already compares under its own order (P1's whole thesis) so both
        // are the accumulator itself and `el_wrap_ord_key` never appears; for
        // f64 the key is the bit pattern and the order key is an i64.
        //
        // ⚠ THE f64 KEY IS IDENTITY, NOT ORDER, AND THE TWO MUST NOT BE THE SAME
        // FUNCTION. `impl Hash for f64` does not exist, so a float map MUST key
        // on `f64_to_bits` — which is also the RIGHT key: it is injective and
        // invertible, so −0.0 comes back −0.0 and a NaN payload survives.
        // `f64_data_key` is NEITHER injective nor invertible — it maps both
        // zeros and every NaN onto one key — so keying on it would collapse
        // −0.0 into +0.0, a defect this tree has a fix for and must not
        // reintroduce. `f64_data_key` is the COMPARATOR and only that.
        let mkt:  str = if is_fl { "u64" } else { acct };
        let ordt: str = if is_fl { "i64" } else { acct };
        let t_map_v: str = if str_eq(mkt, "u64") { "Vec<HashMap<u64, i64>>" } else { "Vec<HashMap<i64, i64>>" };
        let t_map_p: str = if str_eq(mkt, "u64") { "*mut HashMap<u64, i64>" } else { "*mut HashMap<i64, i64>" };
        let t_map_c: str = if str_eq(mkt, "u64") { "*const HashMap<u64, i64>" } else { "*const HashMap<i64, i64>" };
        let t_keys:  str = if str_eq(mkt, "u64") { "HashMapKeys<u64, i64>" }  else { "HashMapKeys<i64, i64>" };
        let hm_new:  str = if str_eq(mkt, "u64") { "hashmap_new::<u64, i64>()" } else { "hashmap_new::<i64, i64>()" };
        gmnm[gi] = gm_name(a.out);
        let n_gm: Ident = Ident::new(string_as_str(&gmnm[gi]));
        if want_map {
            fnames.push(Ident::new(string_as_str(&gmnm[gi])));
            ftys.push(parse_type(t_map_v));
        }

        // — the group-creation SEED, SPELLED IN THE ACCUMULATOR'S OWN TYPE —
        // ⚠ THIS IS WHERE THE TYPING PAYS FIRST. The batch emitter writes the
        // literals 9223372036854775807i64 / -9223372036854775808i64 because its
        // cell IS an i64; for a `u64` cell those are not the extrema of the
        // order the cell compares under — `el_wrap_ord_least`'s header records
        // the measurement where a signed seed put `max`'s seed in the MIDDLE of
        // a u64 column's order and `max` over a single row of 5 answered 2^63.
        // `agg_acc_least` / `agg_acc_greatest` are the accumulator's own extrema
        // and there is no key, no flag and no reinterpretation on the path.
        if fnid == AGG_MIN() {
            if agg_flt[gi] {
                seeds.push(quote_block! { __h.#n_ga.push(f64_from_bits(0x7FF8000000000000u64)); });
            } else {
                let sd: ExprBlob = parse_expr(agg_acc_greatest(acct));
                seeds.push(quote_block! { __h.#n_ga.push(#(sd)); });
            }
        } else if fnid == AGG_MAX() {
            if agg_flt[gi] {
                seeds.push(quote_block! { __h.#n_ga.push(f64_from_bits(0xFFF0000000000000u64)); });
            } else {
                let sd2: ExprBlob = parse_expr(agg_acc_least(acct));
                seeds.push(quote_block! { __h.#n_ga.push(#(sd2)); });
            }
        } else {
            let sz: ExprBlob = parse_expr(agg_acc_zero(acct));
            seeds.push(quote_block! { __h.#n_ga.push(#(sz)); });
        }
        // ⚠ AND THE SEED ABOVE IS A PLACEHOLDER ONCE A MAP EXISTS, NOT AN
        // IDENTITY. Under insert-only the first row always displaces it. Under
        // retraction a group can EMPTY and the cell then holds a stale best, so
        // the next insert would compare against a value present in no row —
        // which is the seed defect this arc has already paid for twice (once for
        // floats, once for u64). The `__ml == 1` arm in the fold below is what
        // replaces the seed compare: when the map holds exactly one live key,
        // that key IS the extremum, no comparison and no sentinel involved. The
        // seed survives only for the window before a brand-new group's first row.
        if want_map {
            let hm0: ExprBlob = parse_expr(hm_new);
            seeds.push(quote_block! { __h.#n_gm.push(#(hm0)); });
        }

        // — the per-row FOLD step —
        if fnid == AGG_COUNT() {
            // ⚠ `count` INTEGRATES THE WEIGHT AND CHECKS ONLY ITS OVERFLOW HERE.
            // The SIGN question — may a count go below zero — is not this fold's
            // to answer, because the answer belongs to the GROUP: `<q>_apply`'s
            // `__gn < 0` guard is asked once per row for the whole group, before
            // any fold runs, and a `count()` aggregate's cell tracks exactly that
            // group multiplicity. Asking it twice would be one cell with two
            // opinions. (The dynamic engine does a bare `gcount += w` with no
            // guard at all; see the ⚠⚠ at `apply_body` for why its silence is
            // not the answer "no error".)
            if retr {
                folds.push(quote_block! { __h.#n_ga.set(__gi, el_add(__h.#n_ga.get(__gi), __w)?); });
            } else {
                folds.push(quote_block! { __h.#n_ga.set(__gi, __h.#n_ga.get(__gi) + 1i64); });
            }
        } else if fnid == AGG_SUM() && !agg_flt[gi] {
            // ⚠ THE OVERFLOW PREDICATE IS CHOSEN BY THE ACCUMULATOR'S TYPE AND BY
            // NOTHING ELSE. `el_add` is i64's, `el_addu` is u64's, and no
            // signedness flag reaches the fold: the dynamic engine's `agg_argu`
            // (and the `el_wrap_add` it guards) exists precisely because its cell
            // cannot answer this question about itself.
            //
            // ⚠ AND THE SUBTRACTION SIBLING IS PICKED AT THE SAME SEAM BY THE
            // SAME RULE. `el_sub`/`el_subu` are not a second decision: a fold
            // that could take `el_addu` and `el_sub` in one query would be the
            // `752f89af` defect (one predicate answering about the other's
            // number) reintroduced on the retraction side.
            //
            // i64 needs no branch — `acc + w·arg` is exact for either sign and
            // `el_mul`/`el_add` check both steps. u64 has no signed product, so
            // the MAGNITUDE multiplies and the SIGN of `w` picks add or subtract,
            // which is the same decomposition the dynamic engine makes.
            if str_eq(acct, "u64") {
                if retr {
                    folds.push(quote_block! {
                        { let __p: u64 = el_mulu(__wm, (#(arg_f)))?;
                          if __wneg { __h.#n_ga.set(__gi, el_subu(__h.#n_ga.get(__gi), __p)?); }
                          else      { __h.#n_ga.set(__gi, el_addu(__h.#n_ga.get(__gi), __p)?); } }
                    });
                } else {
                    folds.push(quote_block! { __h.#n_ga.set(__gi, el_addu(__h.#n_ga.get(__gi), (#(arg_f)))?); });
                }
            } else {
                if retr {
                    folds.push(quote_block! { __h.#n_ga.set(__gi, el_add(__h.#n_ga.get(__gi), el_mul(__w, (#(arg_f)))?)?); });
                } else {
                    folds.push(quote_block! { __h.#n_ga.set(__gi, el_add(__h.#n_ga.get(__gi), (#(arg_f)))?); });
                }
            }
        } else if fnid == AGG_SUM() || fnid == AGG_AVG() {
            // ⚠ UNREACHABLE WITH A WEIGHT, BY CONSTRUCTION. This arm is the f64
            // accumulator — a float `sum`, and EVERY `avg` including `avg` over
            // an integer column, whose running total is an f64 the moment it is
            // divided at snapshot. `incr_retract_eligible` is false for both, so
            // no `__w` exists in the fn this fold lands in and `(S+x)-x` cannot
            // be emitted. That is decision D4 left OPEN, not answered.
            if agg_cast[gi] {
                folds.push(quote_block! { __h.#n_ga.set(__gi, __h.#n_ga.get(__gi) + ((#(arg_f)) as f64)); });
            } else {
                folds.push(quote_block! { __h.#n_ga.set(__gi, __h.#n_ga.get(__gi) + (#(arg_f))); });
            }
        } else if want_map {
            // ── THE SEMILATTICE FOLD: map + cached best + rescan-on-retract ──
            // The dynamic engine's shape (incr.logos, `fnid == 3 || fnid == 4`),
            // TYPED: no `RtVal`, no `agg_argu` flag, no `el_wrap_ord_key`. K is
            // the accumulator's own type for an integer and the bit pattern for
            // a float; the comparison is the accumulator's own `<`/`>` for an
            // integer and `f64_data_key`'s total order for a float.
            //
            // ⚠ THE FLOAT ORDER IS `f64_data_key`'s AND IT IS COMMITTED TO HERE,
            // deliberately and consistently with the batch tier: every NaN is
            // one value and is the GREATEST, −0.0 and +0.0 TIE. The improve is
            // STRICT (`<` / `>`), so among tied values the FIRST ARRIVAL wins
            // the cached best — and the rescan below inherits the same rule from
            // the same comparator, so a retraction cannot silently reorder a tie.
            // That is `design_fp_as_data_postgres_semantics`'s order, which the
            // batch `min`/`max` on the arm just below already uses.
            //
            // ⚠ THE FOLD IS DRIVEN BY THE RAW `__w`, NOT BY `el_wmag(__w)`. A
            // weight of +3 puts THREE copies of the value into the multiset and
            // −3 takes three out; `__cur + __w` is that statement, and it is why
            // the map holds a COUNT rather than a presence bit. `el_wmag`
            // discards the SIGN — feeding it here would turn every retraction
            // into an insert — so its use stays confined to the u64 `sum` arm
            // above, where the cell has no signed product to multiply by.
            let vt0:  ExprBlob = parse_type(acct);
            let mkty: ExprBlob = parse_type(mkt);
            let orty: ExprBlob = parse_type(ordt);
            let pmap: ExprBlob = parse_type(t_map_p);
            let cmap: ExprBlob = parse_type(t_map_c);
            let kits: ExprBlob = parse_type(t_keys);
            // IDENTITY (the map key) and ORDER (the comparator) — two functions,
            // each applied only to locals this emitter itself named.
            let kv_e:  ExprBlob = parse_expr(if is_fl { "f64_to_bits(__v)" }   else { "__v" });
            let kb_e:  ExprBlob = parse_expr(if is_fl { "f64_to_bits(__b)" }   else { "__b" });
            let vo_e:  ExprBlob = parse_expr(if is_fl { "f64_data_key(__v)" }  else { "__v" });
            let bo_e:  ExprBlob = parse_expr(if is_fl { "f64_data_key(__b)" }  else { "__b" });
            let vok_e: ExprBlob = parse_expr(if is_fl { "f64_from_bits(*__kp)" } else { "*__kp" });
            let ko_e:  ExprBlob = parse_expr(if is_fl { "f64_data_key(__kv)" } else { "__kv" });
            let impr:  ExprBlob = parse_expr(if fnid == AGG_MIN() { "__vo < __bo" }  else { "__vo > __bo" });
            let rcmp:  ExprBlob = parse_expr(if fnid == AGG_MIN() { "__ko < __nbo" } else { "__ko > __nbo" });
            // Dead initializers: `__f1` guards every read of them, and the first
            // live key writes both. Spelled in the right types because the
            // language wants an initializer, NOT because anything compares
            // against them — that distinction is the seed defect this arc paid
            // for twice.
            let zv: ExprBlob = parse_expr(agg_acc_zero(acct));
            let zo: ExprBlob = parse_expr(agg_acc_zero(ordt));
            folds.push(quote_block! {
                {
                    let __v: #(vt0) = (#(arg_f));
                    let __mk: #(mkty) = (#(kv_e));
                    let __b: #(vt0) = __h.#n_ga.get(__gi);
                    let __bk: #(mkty) = (#(kb_e));
                    let __mp: #(pmap) = unsafe { __h.#n_gm.at(__gi) };
                    let __cp: *const i64 = unsafe { __mp.get(&__mk) };
                    let __cur: i64 = if (__cp as i64) == 0i64 { 0i64 } else { unsafe { *__cp } };
                    let __nc: i64 = __cur + __w;
                    // ⚠ STRICTLY `< 0`, AND THE STRICTNESS IS THE WHOLE CONTENT.
                    // `__nc == 0` with `__cur > 0` is the LEGITIMATE removal of
                    // the last copy of a value and must fall through to the
                    // `<= 0` arm below. `__nc < 0` can only mean the caller
                    // retracted more copies of this VALUE than the multiset
                    // holds — including the adjacent case where the GROUP exists
                    // but this value was never inserted (`__cur == 0`, `__w < 0`),
                    // where the map's `remove` would otherwise be a silent no-op
                    // and the retraction would vanish. One guard decides both,
                    // because they are the same mistake.
                    //
                    // ⚠ REACHABLE ONLY IN A NARROW WINDOW, so it has a
                    // purpose-built witness rather than a hoped-for one: the
                    // GROUP-COUNT guard in `<q>_apply` runs first and catches the
                    // common double-retraction. This arm needs a row whose group
                    // count stays legal while its VALUE goes below zero — insert
                    // (k,5) twice, then retract (k,7).
                    if __nc < 0i64 { return Result::Err(ElError::RetractAbsent); }
                    let mut __rb: bool = false;
                    if __nc <= 0i64 {
                        unsafe { __mp.remove(&__mk); }
                        if __bk == __mk { __rb = true; }
                    } else {
                        unsafe { __mp.insert(__mk, __nc); }
                    }
                    if __nc > 0i64 && __cur <= 0i64 {
                        let __mc0: #(cmap) = unsafe { __h.#n_gm.at_const(__gi) };
                        let __ml: i64 = unsafe { (&*__mc0).len() };
                        if __ml == 1i64 {
                            __h.#n_ga.set(__gi, __v);
                        } else {
                            let __vo: #(orty) = (#(vo_e));
                            let __bo: #(orty) = (#(bo_e));
                            if #(impr) { __h.#n_ga.set(__gi, __v); }
                        }
                    }
                    if __rb {
                        let __mc: #(cmap) = unsafe { __h.#n_gm.at_const(__gi) };
                        if unsafe { (&*__mc).len() } > 0i64 {
                            let mut __nb: #(vt0) = #(zv);
                            let mut __nbo: #(orty) = #(zo);
                            let mut __f1: bool = true;
                            let mut __it: #(kits) = unsafe { __mc.keys() };
                            loop {
                                match __it.next() {
                                    Option::Some(__kp) => {
                                        let __kv: #(vt0) = (#(vok_e));
                                        let __ko: #(orty) = (#(ko_e));
                                        if __f1 { __nb = __kv; __nbo = __ko; __f1 = false; }
                                        else { if #(rcmp) { __nb = __kv; __nbo = __ko; } }
                                    }
                                    Option::None => { break; }
                                }
                            }
                            __h.#n_ga.set(__gi, __nb);
                        }
                    }
                }
            });
        } else if fnid == AGG_MIN() {
            // ⚠ THE SCALAR min/max ARMS ARE THE `!want_map` FALLBACK AND STAY
            // EXACTLY AS P1 WROTE THEM. They are reached only when this query is
            // NOT retract-eligible — an f64 `sum`/`avg` elsewhere in the same
            // list took the weight away — so there is no `__w` in scope, the
            // cached extremum is never asked to go backwards, and the O(1)
            // improve against one cell is the whole state a `min` needs. Keeping
            // the two shapes side by side is what makes the map a COST paid for
            // a capability rather than an unconditional change of state shape.
            if agg_flt[gi] {
                folds.push(quote_block! {
                    { let __v: f64 = (#(arg_f)); if f64_data_key(__v) < f64_data_key(__h.#n_ga.get(__gi)) { __h.#n_ga.set(__gi, __v); } }
                });
            } else {
                let vt: ExprBlob = parse_type(acct);
                folds.push(quote_block! {
                    { let __v: #(vt) = (#(arg_f)); if __v < __h.#n_ga.get(__gi) { __h.#n_ga.set(__gi, __v); } }
                });
            }
        } else {
            if agg_flt[gi] {
                folds.push(quote_block! {
                    { let __v: f64 = (#(arg_f)); if f64_data_key(__v) > f64_data_key(__h.#n_ga.get(__gi)) { __h.#n_ga.set(__gi, __v); } }
                });
            } else {
                let vt2: ExprBlob = parse_type(acct);
                folds.push(quote_block! {
                    { let __v: #(vt2) = (#(arg_f)); if __v > __h.#n_ga.get(__gi) { __h.#n_ga.set(__gi, __v); } }
                });
            }
        }

        // — the group row's READ of one accumulator, at snapshot time —
        // ⚠ `avg` DIVIDES AT SNAPSHOT, NOT AT FOLD, and that is what makes the
        // handle's `avg` exact under ANY split of the rows into epochs: what is
        // carried is the f64 sum and the i64 count, both of which are monoids, so
        // `snapshot()` after N epochs reads the same pair as after one.
        if fnid == AGG_AVG() {
            let ract: ExprBlob = parse_type(act[gi]);
            freads.push(quote_block! {
                let #n_out: #(ract) =
                    (if __h.__gc.get(__r0) > 0i64 { __h.#n_ga.get(__r0) / (__h.__gc.get(__r0) as f64) }
                     else { 0.0f64 });
            });
        } else {
            let rat2: ExprBlob = parse_type(acct);
            freads.push(quote_block! { let #n_out: #(rat2) = __h.#n_ga.get(__r0); });
        }
        gi = gi + 1i64;
    }

    // ── the HANDLE TYPE ─────────────────────────────────────────────────────
    let n_ty: Ident = Ident::new(tyn);
    if is_priv {
        let qs: QuoteItemBlob = quote_item! {
            use logos.mem.collections.vec;
            use logos.mem.collections.hashmap;
            struct #n_ty { #( pub #fnames: #ftys, )* }
        };
        unsafe { logos_emit_item_blob_subst(&qs); }
    } else {
        let qs2: QuoteItemBlob = quote_item! {
            use logos.mem.collections.vec;
            use logos.mem.collections.hashmap;
            pub struct #n_ty { #( pub #fnames: #ftys, )* }
        };
        unsafe { logos_emit_item_blob_subst(&qs2); }
    }

    // ── <q>_incremental() — the EMPTY handle ────────────────────────────────
    // ⚠ IT DOES NOT BASE-FILL, AND THE DIFFERENCE FROM `IncrJoin` IS DELIBERATE.
    // The dynamic engine builds a +1 batch over every element of every bound
    // source at construction and runs it through the same accumulate path, so
    // `snapshot()` immediately after `incremental()` already equals `run()`. Here
    // the constructor takes no sources at all — a caller reproduces that by
    // calling `<q>_epoch` once with the whole source, which is the SAME code
    // path. One fold instead of two is what makes the differential against
    // `<q>()` meaningful: if construction had its own fold, agreeing with the
    // batch fn would only say that two folds written by one author agree.
    // ⚠ THE STRUCT LITERAL IS BUILT AS TEXT AND PARSED, WHICH IS WHAT THE
    // PREPARED EMITTER IN THIS SAME FILE ALREADY DOES FOR ITS OWN CONSTRUCTOR
    // (`emit_prepared_fns`'s `pb`) — not a text push invented here. It is also a
    // MEASURED quote gap and worth recording as one: `quote_expr! { #n_ty { #(
    // #fnam2: #finit ),* } }` — a repeat in a struct-literal FIELD-VALUE position
    // with an `ExprBlob` cursor — expands to nothing, and the only symptom is
    // `logos_emit_item_blob_subst: blob[0] empty` followed by an undefined
    // function at the call site. The same repeat in a struct FIELD-DECLARATION
    // list (`#( pub #fnames: #ftys, )*`, used just above) works.
    let mut inm: String = String::new();
    prep_derived_name(fn_name, "_incremental", &mut inm);
    let mut cb: String = String::new();
    cb.push_str("{\n    return ");
    cb.push_str(tyn);
    cb.push_str(" { __gk: ");
    push_vec_new(&mut cb, key_ty);
    cb.push_str(", __gc: ");
    push_vec_new(&mut cb, "i64");
    // The stored sides' initializers, under THE SAME `joined` the fields were
    // declared under — one variable, read twice, never re-derived. (A control
    // revert on the field push with this initializer left standing is the
    // `unknown field` diagnostic the `wmap` comment above records.)
    // The rel-backed state's initializers, under THE SAME `rel_m` the fields
    // were declared under — one variable, read twice, never re-derived.
    if rel_m >= 0i64 {
        cb.push_str(", __edb: ");
        push_vec_new(&mut cb, prm.tys[rel_sp]);
        // ⚠ THE SAME `ntm`/`tmem`/`totnm` THE FIELDS WERE DECLARED FROM — P3c.
        // One derivation read twice, never re-scanned: a second scan here that
        // disagreed with the field push is precisely the `unknown field`
        // diagnostic the `wmap` comment above records, and with N members there
        // are N chances to get it wrong instead of one.
        let mut ti: i64 = 0i64;
        while ti < ntm {
            cb.push_str(", ");
            cb.push_str(string_as_str(&totnm[ti]));
            cb.push_str(": ");
            push_vec_new(&mut cb, prm.rel_rowty[tmem[ti]]);
            ti = ti + 1i64;
        }
    }
    if joined {
        cb.push_str(", __s0: ");
        push_vec_new(&mut cb, ch.base_ty);
        cb.push_str(", __s0w: ");
        push_vec_new(&mut cb, "i64");
        cb.push_str(", __s1: ");
        push_vec_new(&mut cb, ch.ty[0]);
        cb.push_str(", __s1w: ");
        push_vec_new(&mut cb, "i64");
    }
    // The bare scan's sensor, under THE SAME `sens` and THE SAME `fpty` the
    // fields were declared from — one derivation read twice. Re-deriving the
    // footprint type here is the `unknown field` diagnostic the `wmap` note
    // records, with the added twist that a type that merely DIFFERED would
    // typecheck and store a footprint the lookup can never match.
    if sens {
        cb.push_str(", __s0: ");
        push_vec_new(&mut cb, string_as_str(&fpty));
        cb.push_str(", __s0w: ");
        push_vec_new(&mut cb, "i64");
    }
    let mut ci: i64 = 0i64;
    while ci < acount {
        cb.push_str(", ");
        cb.push_str(string_as_str(&ganm[ci]));
        cb.push_str(": ");
        push_vec_new(&mut cb, acc[ci]);
        // The multiplicity map's initializer, under THE SAME DECISION the field
        // was declared under — `wmap[ci]`, written once by the loop above, not a
        // second derivation from `aggs` + `acc` that is free to answer
        // differently. The key type follows the SAME rule the field's did: the
        // accumulator's own type for an integer, `u64` (the bit pattern) for a
        // float, which is why this reads `acc[ci] == "i64"` and defaults to u64
        // rather than testing for "f64" — an f64 accumulator's MAP is a u64 map.
        if wmap[ci] {
            cb.push_str(", ");
            cb.push_str(string_as_str(&gmnm[ci]));
            cb.push_str(": ");
            if str_eq(acc[ci], "i64") { cb.push_str("Vec::<HashMap<i64, i64>>::new()"); }
            else                      { cb.push_str("Vec::<HashMap<u64, i64>>::new()"); }
        }
        ci = ci + 1i64;
    }
    cb.push_str(" };\n}\n");
    // ⚠ NOT THROUGH `emit_fn_quote_blob`, AND THE REASON IS A HOST-SIDE RULE
    // WORTH KNOWING: `parse_params("")` FAILS. `logos_parse_as` special-cases an
    // empty/whitespace-only input for rule 0 (`type_param_list`) only — every
    // other rule, `param_list` included, reports "parse failed" and yields a null
    // blob, and the ONLY symptom downstream is
    // `logos_emit_item_blob_subst: blob[0] empty` plus an undefined function at
    // the call site, with nothing naming the empty parameter list. This
    // constructor is the first emitter in this file to want a genuinely
    // parameterless fn, so it writes its own item instead of asking for one.
    let n_ctor: Ident = Ident::new(vis_strip(string_as_str(&inm)));
    let n_ty2: Ident = Ident::new(tyn);
    let ctor_b: ExprBlob = parse_block(string_as_str(&cb));
    if is_priv {
        let qc: QuoteItemBlob = quote_item! {
            use logos.mem.collections.vec;
            use logos.mem.collections.hashmap;
            fn #n_ctor() -> #n_ty2 #(ctor_b)
        };
        unsafe { logos_emit_item_blob_subst(&qc); }
    } else {
        let qc2: QuoteItemBlob = quote_item! {
            use logos.mem.collections.vec;
            use logos.mem.collections.hashmap;
            pub fn #n_ctor() -> #n_ty2 #(ctor_b)
        };
        unsafe { logos_emit_item_blob_subst(&qc2); }
    }

    // ── <q>_apply(&mut h, src, w, …) — fold a WEIGHTED delta in ────────────
    let pre_f: ExprBlob = prelude_frag(prelude);
    let key_f: ExprBlob = parse_expr(key_body);
    let keyt_f: ExprBlob = parse_type(key_ty);
    let base_src_f: ExprBlob = parse_expr(ch.base_src);
    let base_ty_f: ExprBlob = parse_type(ch.base_ty);
    let base_vnm: Ident = Ident::new(ch.base_var);
    // ⚠ THE GROUP INDEX IS THE BATCH EMITTER'S LINEAR `==` SCAN, ON PURPOSE. It
    // is O(rows × groups) and a `HashMap<K, i64>` would be the right structure —
    // but the fold's CORRECTNESS is what this slice is about, the batch emitter
    // carries the same MVP dedup, and a differential between two shapes that
    // share a bucket rule is a sharper instrument than one between two that do
    // not. Replacing both together is the follow-up, and `K: Eq + Hash` is
    // already the predicate `el_eq_hash` asks of the group key here.
    // ⚠ TWO BODIES AND NOT ONE WITH A SPLICED PRELUDE, and the reason is a
    // SCOPE rule this file has already been bitten by: `#(frag)` in statement
    // position splices a BLOCK, so any `let` inside it dies at that block's
    // closing brace and is invisible to the loop below (which is why
    // `prelude_frag` carries only items).
    // ⚠ AND THAT SAME RULE IS WHAT SHAPES THE FOLD CORE BELOW. `#(core)` is a
    // BLOCK, so everything the core must SEE — `__w`, and the row bindings the
    // key and the aggregate arguments read — is declared by whatever splices it,
    // and everything the core declares (`__k`, `__gi`, `__wneg`, `__wm`) dies at
    // its own closing brace. `__wneg` / `__wm` used to be bindings of the fn's
    // own body; they moved INTO the core when the join made them functions of a
    // PAIR weight rather than of the call's.
    let mut eps: String = String::new();
    let mut enm: String = String::new();
    if retr {
        // ⚠⚠ A MULTIPLICITY THAT WOULD GO NEGATIVE IS AN ERROR, AND THE
        // INTERPRETER IS NOT THE ORACLE FOR THIS CELL. `logos.mem.deem.incr`
        // runs `aggstate_ensure` BEFORE `w`'s sign is looked at, and its count
        // update is a plain `gcount.set(slot, gcount.get(slot) + w)` with NO
        // ERROR PATH AT ALL. An engine with no branch for a case does not answer
        // "no error" — it answers "I was never asked", and citing that silence
        // as agreement is how a decision gets taken by accident. (It is also
        // deleted at P5, so it cannot be made to agree either.)
        //
        // So: STRICT. A negative multiplicity is an UNREPRESENTABLE state for a
        // multiset, this arc's goal is a type-safe incremental Datalog, and
        // strict → lax is a compatible relaxation later while lax → strict
        // breaks every caller. The reversible direction is the one to take.
        //
        // THREE guards, all dead under `+1` and load-bearing under a negative
        // weight, all returning `ElError::RetractAbsent` — one name for one
        // caller mistake, "you took out what was never put in":
        //   1. a retraction into a key NEVER SEEN (here, before the group is
        //      created — so no phantom group is created either, which is what
        //      `__w == 0` and the tombstone growth would otherwise compound);
        //   2. a group's ROW COUNT driven below zero (below);
        //   3. a VALUE's multiplicity driven below zero, inside the semilattice
        //      fold — a case guard 2 does not reach, because the group count can
        //      stay legal while the retracted value was never in the map.
        // `ElError::Overflow` would LIE about all three: nothing overflowed.
        //
        // ── ONE FOLD CORE, TWO (OR THREE) PLACES IT IS REACHED FROM ─────────
        // ⚠ THE WEIGHT THE FOLD SEES IS `__w`, WHICH IS *NOT* THE PARAMETER.
        // The parameter is `__wd`, the DELTA's weight; `__w` is the weight of
        // the thing actually being folded, and the two differ exactly where the
        // product rule lives. On a bare scan the folded thing IS the delta row,
        // so `__w == __wd`. On a join the folded thing is a PAIR, and a pair of
        // a weight-`__wd` delta row with a stored row of weight `__sw` has
        // weight `__wd · __sw` — that product is the whole of ∆(A⋈B) restricted
        // to one changing side. Naming them apart is what stops a reader (or an
        // editor) from folding a pair at the delta's weight, which for |w| = 1
        // inputs is invisible and for anything else is silently wrong.
        //
        // ⚠ `__wneg` / `__wm` MOVED INSIDE THE CORE, and that is a real (small)
        // cost paid for one property: on a join they are functions of the PAIR
        // weight and cannot be hoisted, and having one spelling for both shapes
        // is worth an `el_wmag` per row on the bare-scan path. Every P1/P2
        // fixture is the control on that move — same body, same answers.
        let core: ExprBlob = quote_block! {
            let __wneg: bool = __w < 0i64;
            let __wm: u64 = el_wmag(__w)?;
            let __k: #(keyt_f) = (#(key_f));
            let mut __gi: i64 = -1i64;
            let mut __s: i64 = 0i64;
            while __s < __h.__gk.len() { if __h.__gk.get(__s) == __k { __gi = __s; } __s = __s + 1i64; }
            if __gi < 0i64 {
                if __w < 0i64 { return Result::Err(ElError::RetractAbsent); }
                __h.__gk.push(__k);
                __h.__gc.push(0i64);
                #( #seeds; )*
                __gi = __h.__gk.len() - 1i64;
            }
            let __gn: i64 = el_add(__h.__gc.get(__gi), __w)?;
            if __gn < 0i64 { return Result::Err(ElError::RetractAbsent); }
            __h.__gc.set(__gi, __gn);
            #( #folds; )*
            __n = __n + 1i64;
        };
        let mut apply_body: ExprBlob = quote_block! { };
        if joined {
            // The step's `on` predicate as ONE boolean over BOTH row vars — the
            // same text `analyze_chain` hands a `JS_LOOP` step, taken from the
            // same `step_terms` simplification, so the incremental nest and the
            // batch nest test the identical condition. No equi-split, no build
            // key, no residual: with one step there is nothing to place.
            //
            // ⚠ THE NEST IS UNINDEXED IN BOTH DIRECTIONS AND THE PLAN'S CHOSEN
            // STRATEGY IS NOT CONSULTED. `ch.jstrat[0]` describes the BATCH
            // nest, whose build side is fixed by the chain order; a delta can
            // arrive on either side, so half the calls would want the index on
            // the other half's key. Rebuilding per call is what the cost note on
            // the handle's fields prices, and reading a strategy that was chosen
            // for the other direction is how a plan silently stops describing
            // the emitted code.
            let src1_f: ExprBlob = parse_expr(ch.src[0]);
            let ty1_f:  ExprBlob = parse_type(ch.ty[0]);
            let var1:   Ident    = Ident::new(ch.var[0]);
            let mut ptxt: String = String::new();
            if ch.onw[0] != 0i64 {
                let onr: WRef<SExpr> = WRef::<SExpr>::from_any(WAny::ref_to(ch.onw[0] as *const u8));
                let stt: StepTerms = step_terms(onr, h);
                emit_sexpr(&mut ptxt, stt.opt.any().view::<SExpr>(), ty, ch.base_var);
            } else {
                ptxt.push_str("true");
            }
            let pred_f: ExprBlob = parse_expr(string_as_str(&ptxt));
            // ROW IDENTITY, one text per side, over the SAME field list the
            // eligibility clause admitted the type on.
            let mut e0t: String = String::new();
            incr_row_eq_text(ty, ch.base_ty, "__c", ch.base_var, &mut e0t);
            let mut e1t: String = String::new();
            incr_row_eq_text(ty, ch.ty[0], "__c", ch.var[0], &mut e1t);
            let eq0_f: ExprBlob = parse_expr(string_as_str(&e0t));
            let eq1_f: ExprBlob = parse_expr(string_as_str(&e1t));
            // ⚠ THE STORED SIDE IS BOUND BY VALUE (`Vec::get` copies), THE DELTA
            // SIDE BY REFERENCE. Not a style choice: the fold MUTATES `__h`, so
            // a `&` into `__h.__s<k>` held across it is a live shared borrow of
            // the thing being written. A copy costs `sizeof(RowTy)` per pair and
            // is available precisely because eligibility already proved every
            // field of the row is a self-contained scalar.
            //
            // ⚠⚠ EVERY SOURCE PARAMETER OTHER THAN THE ONE `__src` NAMES IS
            // UNREAD IN THIS FN, AND THAT IS A RULE RATHER THAN AN ACCIDENT.
            // `<q>_apply` keeps the query's parameter list VERBATIM, so a
            // two-source query is handed BOTH slices on every call while only
            // one of them is the delta. The joined side comes from the HANDLE
            // and only from the handle. Reading it from the parameter instead —
            // where the natural thing for a caller to pass is that side's full
            // CURRENT contents — would fold ∆A against B_new on one call and
            // A_new against ∆B on the next, and the cross term would be counted
            // TWICE. That is the same-epoch double count, and it would be the
            // DEFAULT behaviour rather than a bug to hunt.
            apply_body = quote_block! {
                #(pre_f);
                let mut __n: i64 = 0i64;
                if __src == 0i32 {
                    let mut __i0: i64 = 0i64;
                    while __i0 < (#(base_src_f)).len() {
                        let #base_vnm: &#(base_ty_f) = &(#(base_src_f))[__i0];
                        // ── REFUSE BEFORE FOLDING ──────────────────────────
                        // The identity search is SPLIT: the lookup and the
                        // refusal run BEFORE the fold nest, the mutation stays
                        // after it. ⚠ THIS ORDER IS THE FIX FOR A MEASURED
                        // DEFECT, not a preference. With the whole block below
                        // the nest, retracting a row this relation never held
                        // folded every matching pair at a NEGATIVE weight and
                        // only then returned `Err`: on A={(2,5),(2,6)},
                        // B={(2,30),(2,40)}, group 2 = (n 4, sv 22, sm 140), a
                        // `-1` delta carrying a value 999 that is in no row
                        // answered `Err(RetractAbsent)` and left the group
                        // reading (n 2, sv -1976, sm 70). The caller's mistake
                        // is detectable with no fold at all, so it is detected
                        // with no fold at all.
                        // ⚠ THE NARROW CLAIM, so nobody reads more into it: this
                        // makes a delta ROW that is refused leave the handle
                        // untouched. It does NOT make `<q>_apply` transactional
                        // — earlier rows of the same multi-row delta are already
                        // folded and integrated, and a fault raised INSIDE the
                        // nest still leaves that row folded against some
                        // partners. Those remain the contract's UNSPECIFIED.
                        let mut __f: i64 = -1i64;
                        let mut __q: i64 = 0i64;
                        while __q < __h.__s0.len() {
                            let __c: #(base_ty_f) = __h.__s0.get(__q);
                            if (#(eq0_f)) { __f = __q; }
                            __q = __q + 1i64;
                        }
                        if __f < 0i64 {
                            // A retraction of a row this relation has never held
                            // is the SAME caller mistake the group guards name.
                            if __wd < 0i64 { return Result::Err(ElError::RetractAbsent); }
                        } else {
                            let __chk: i64 = el_add(__h.__s0w.get(__f), __wd)?;
                            if __chk < 0i64 { return Result::Err(ElError::RetractAbsent); }
                        }
                        let mut __j1: i64 = 0i64;
                        while __j1 < __h.__s1.len() {
                            let #var1: #(ty1_f) = __h.__s1.get(__j1);
                            let __sw: i64 = __h.__s1w.get(__j1);
                            if __sw != 0i64 {
                                if (#(pred_f)) {
                                    let __w: i64 = el_mul(__wd, __sw)?;
                                    #(core);
                                }
                            }
                            __j1 = __j1 + 1i64;
                        }
                        // INTEGRATE AFTER THE FOLD. ⚠ THE OLD COMMENT HERE SAID
                        // "NEVER BEFORE — moving this block above the inner loop
                        // is the double count", AND THAT WAS FALSE: a control
                        // moved exactly this block above the nest and every
                        // fixture stayed green, because within one `__src` arm
                        // the fold READS `__h.__s1` while the integration WRITES
                        // `__h.__s0` — disjoint state, so the statement order is
                        // not observable. The real constraint is ACROSS CALLS:
                        // `∆J = ∆S_k ⋈ (other sides at their CURRENT contents)`,
                        // and the other side must not yet carry this call's own
                        // delta. `__f` is computed above and stays valid because
                        // the nest does not touch `__s0`.
                        // Integrate INTO NORMAL FORM: move this row's entry by
                        // identity, so every stored weight stays ≥ 0 and every
                        // pair weight in one call carries the sign of `__wd`.
                        if __f < 0i64 {
                            __h.__s0.push((#(base_src_f))[__i0]);
                            __h.__s0w.push(__wd);
                        } else {
                            __h.__s0w.set(__f, el_add(__h.__s0w.get(__f), __wd)?);
                        }
                        __i0 = __i0 + 1i64;
                    }
                    return Result::Ok(__n);
                }
                if __src == 1i32 {
                    let mut __i1: i64 = 0i64;
                    while __i1 < (#(src1_f)).len() {
                        let #var1: &#(ty1_f) = &(#(src1_f))[__i1];
                        // REFUSE BEFORE FOLDING — the mirror of the `__src == 0`
                        // arm; the same measured defect lives on both sides and
                        // fixing one would have left the other corrupting.
                        let mut __f: i64 = -1i64;
                        let mut __q: i64 = 0i64;
                        while __q < __h.__s1.len() {
                            let __c: #(ty1_f) = __h.__s1.get(__q);
                            if (#(eq1_f)) { __f = __q; }
                            __q = __q + 1i64;
                        }
                        if __f < 0i64 {
                            if __wd < 0i64 { return Result::Err(ElError::RetractAbsent); }
                        } else {
                            let __chk: i64 = el_add(__h.__s1w.get(__f), __wd)?;
                            if __chk < 0i64 { return Result::Err(ElError::RetractAbsent); }
                        }
                        let mut __j0: i64 = 0i64;
                        while __j0 < __h.__s0.len() {
                            let #base_vnm: #(base_ty_f) = __h.__s0.get(__j0);
                            let __sw: i64 = __h.__s0w.get(__j0);
                            if __sw != 0i64 {
                                if (#(pred_f)) {
                                    let __w: i64 = el_mul(__wd, __sw)?;
                                    #(core);
                                }
                            }
                            __j0 = __j0 + 1i64;
                        }
                        if __f < 0i64 {
                            __h.__s1.push((#(src1_f))[__i1]);
                            __h.__s1w.push(__wd);
                        } else {
                            __h.__s1w.set(__f, el_add(__h.__s1w.get(__f), __wd)?);
                        }
                        __i1 = __i1 + 1i64;
                    }
                    return Result::Ok(__n);
                }
                return Result::Err(ElError::SrcUnknown);
            };
        } else {
            // ── REFUSE BEFORE FOLDING, ON THE BARE SCAN ────────────────────
            // The SAME three-block order the join arm uses — lookup+refuse
            // BEFORE the fold, the normal-form integration AFTER it — and the
            // order is the fix for the second half of the measured defect, not
            // a preference: with the refusal after `#(core)` the sum-plus-min
            // query still answers `Err(RetractAbsent)` from guard 3 and still
            // leaves the group reading −984, because `__gc.set` and every fold
            // declared before the `min` have already committed. Moving it above
            // `#(core)` puts it above guards 1 and 2 as well, so a delta ROW
            // that is refused leaves the handle untouched.
            //
            // ⚠ THE NARROW CLAIM, VERBATIM FROM THE JOIN ARM BECAUSE IT IS THE
            // SAME CLAIM: this makes a refused delta ROW leave the handle
            // untouched. It does NOT make `<q>_apply` transactional. Earlier
            // rows of the same multi-row delta are already folded and
            // integrated, and an `el_add`/`el_mul` OVERFLOW raised inside a fold
            // still leaves this row's group count moved and possibly some of its
            // aggregates updated. That remains the contract's UNSPECIFIED, it is
            // stated in this fn's header, and `deem_incr_static_retract_e2e`
            // block G3 now ASSERTS the state a refusal leaves rather than
            // documenting it — "documented and unasserted" is what let the −984
            // survive from P2 until now.
            //
            // ⚠ THE PRICE, IN THE UNITS A READER WILL ASK IN: one linear scan of
            // `__s0` per DELTA ROW, so O(|Δ| · D) with D the number of DISTINCT
            // footprints ever presented, plus O(D) memory of (footprint, i64).
            // Identical asymptotics to what the join arm already pays and this
            // tree already accepted. NO ns/byte FIGURE IS QUOTED — nothing here
            // has been weighed, and this file records what happened the last time
            // a construction floor was written down as a footprint.
            let mut sen0: ExprBlob = quote_block! { };
            let mut sen1: ExprBlob = quote_block! { };
            if sens {
                let fpty_f: ExprBlob = parse_type(string_as_str(&fpty));
                let fpex_f: ExprBlob = parse_expr(string_as_str(&fpex));
                sen0 = quote_block! {
                    let __fp: #(fpty_f) = #(fpex_f);
                    let mut __f: i64 = -1i64;
                    let mut __q: i64 = 0i64;
                    while __q < __h.__s0.len() {
                        if __h.__s0.get(__q) == __fp { __f = __q; }
                        __q = __q + 1i64;
                    }
                    if __f < 0i64 {
                        // Retracting a footprint this query has never been
                        // handed is the SAME caller mistake the group guards
                        // name, so it wears the SAME name.
                        if __wd < 0i64 { return Result::Err(ElError::RetractAbsent); }
                    } else {
                        let __chk: i64 = el_add(__h.__s0w.get(__f), __wd)?;
                        if __chk < 0i64 { return Result::Err(ElError::RetractAbsent); }
                    }
                };
                // INTEGRATE INTO NORMAL FORM, AFTER THE FOLD. `__f` is computed
                // above and stays valid because `#(core)` touches `__gk`, `__gc`
                // and the accumulators and never `__s0` — disjoint state, so the
                // statement order is not observable WITHIN one call. It is
                // placed after the fold anyway, so that the bare scan and the
                // join arm read as one shape rather than two.
                sen1 = quote_block! {
                    if __f < 0i64 {
                        __h.__s0.push(__fp);
                        __h.__s0w.push(__wd);
                    } else {
                        __h.__s0w.set(__f, el_add(__h.__s0w.get(__f), __wd)?);
                    }
                };
            }
            apply_body = quote_block! {
                #(pre_f);
                let mut __n: i64 = 0i64;
                // ⚠ AN UNKNOWN TAG IS AN ERROR AND NO LONGER `Ok(0)`. This query
                // has exactly one relation, so 0 is the only tag that names
                // anything; every other value names no source of this query and
                // there is no delta to fold. It USED to answer `Ok(__n)` with
                // `__n == 0` — "a delta for a source this operator does not read
                // contributes nothing" — which was honest while a tag could not
                // be wrong and became a silent success that folded nothing the
                // moment a second source existed. See `ElError::SrcUnknown`.
                if __src != 0i32 { return Result::Err(ElError::SrcUnknown); }
                let mut __i0: i64 = 0i64;
                while __i0 < (#(base_src_f)).len() {
                    let #base_vnm: &#(base_ty_f) = &(#(base_src_f))[__i0];
                    #(sen0);
                    let __w: i64 = __wd;
                    #(core);
                    #(sen1);
                    __i0 = __i0 + 1i64;
                }
                return Result::Ok(__n);
            };
        }
        eps.push_str("__h: &mut ");
        eps.push_str(tyn);
        eps.push_str(", __src: i32, __wd: i64");
        if params_text.len() > 0i64 {
            eps.push_str(", ");
            eps.push_str(params_text);
        }
        prep_derived_name(fn_name, "_apply", &mut enm);
        emit_fn_quote_blob(string_as_str(&enm), string_as_str(&eps), "",
                           "Result<i64, ElError>", apply_body, prm);

        // ── <q>_epoch / <q>_retract — PURE FORWARDERS ──────────────────────
        // ⚠ `<q>_epoch` KEEPS P1'S SIGNATURE BYTE FOR BYTE, which makes every
        // P1 fixture a control on this refactor: if forwarding through the
        // weighted primitive moved any answer, they say so before P2's own
        // arithmetic is trusted at all.
        //
        // ⚠⚠ AND THEY ARE NOT EMITTED AT ALL FOR A JOIN QUERY. They forward at
        // tag 0, and tag 0 is the BASE source: on a two-relation query the name
        // `<q>_epoch` would read as "an epoch of the query" while the meaning is
        // "a delta on the LEFT relation", which is a lie a caller cannot see.
        // Three answers were available — keep them at tag 0 and say so; emit one
        // per source (`<q>_epoch_<var>`); or emit neither and require the
        // explicit `<q>_apply(&mut h, src, w, …)`. THE THIRD IS TAKEN: it names
        // no source it cannot justify, and it costs no existing fixture anything
        // because every query that had a handle before this slice has `ch.n == 0`
        // and still gets both forwarders unchanged.
        if !joined {
            let mut fps: String = String::new();
            fps.push_str("__h: &mut ");
            fps.push_str(tyn);
            if params_text.len() > 0i64 {
                fps.push_str(", ");
                fps.push_str(params_text);
            }
            let mut applyc: String = String::new();
            prep_derived_name(bare, "_apply", &mut applyc);
            let mut epnm: String = String::new();
            prep_derived_name(fn_name, "_epoch", &mut epnm);
            let mut rtnm: String = String::new();
            prep_derived_name(fn_name, "_retract", &mut rtnm);
            let mut eb: String = String::new();
            eb.push_str("{\n    return ");
            eb.push_str(string_as_str(&applyc));
            eb.push_str("(__h, 0i32, 1i64");
            if prm.n > 0i64 { eb.push_str(", "); push_param_args(&mut eb, prm); }
            eb.push_str(");\n}\n");
            emit_fn_quote_blob(string_as_str(&epnm), string_as_str(&fps), "",
                               "Result<i64, ElError>", parse_block(string_as_str(&eb)), prm);
            let mut rb: String = String::new();
            rb.push_str("{\n    return ");
            rb.push_str(string_as_str(&applyc));
            rb.push_str("(__h, 0i32, -1i64");
            if prm.n > 0i64 { rb.push_str(", "); push_param_args(&mut rb, prm); }
            rb.push_str(");\n}\n");
            emit_fn_quote_blob(string_as_str(&rtnm), string_as_str(&fps), "",
                               "Result<i64, ElError>", parse_block(string_as_str(&rb)), prm);
        }
    } else {
        // ── INSERT-ONLY: P1'S SURFACE, UNCHANGED ───────────────────────────
        // No `__w`, no `__src`, no `<q>_retract`. A caller that reaches for a
        // retraction on a float-accumulator or `min`/`max` query fails to
        // COMPILE, which is the honest signal and the one that cannot answer D4
        // by accident.
        let mut epoch_body: ExprBlob = quote_block! { };
        if rel_m >= 0i64 {
            // ══ THE REL-BACKED EPOCH — P3b ═════════════════════════════════
            //
            // ⚠ `#(pre_f)` IS ABSENT HERE, AND ITS ABSENCE IS THE WHOLE SLICE.
            // The batch prelude declares a FRESH total and runs the fixpoint
            // from scratch; splicing it is exactly what made every epoch
            // re-materialize the rel over the delta alone and answer wrong. This
            // body calls the CROSS-EPOCH driver instead, on state the handle
            // owns.
            //
            // ── WHAT IS ATOMIC, STATED BECAUSE `<q>_apply` IS NOT ───────────
            // The accumulated input and the fixpoint total are both built in
            // LOCALS and committed to `__h` only after the driver RETURNS. So a
            // fault inside the fixpoint (an `el_add` in a rel body, the
            // aggregate convergence guard) leaves the handle EXACTLY as it was —
            // this half is transactional, which `<q>_apply`'s row loop is not,
            // and it matters more here because the state at risk is the whole
            // relation rather than one group's cells. What remains UNSPECIFIED
            // is the same window P1-P3 already document: a fault inside the
            // GROUP FOLD below leaves the total committed and some rows folded.
            // Priced and not taken: containing that too means either a second
            // copy of the group state per epoch or a `__poisoned` bit plus an
            // `ElError` variant for reads to report — the bit is the cheaper of
            // the two and is the named follow-up.
            //
            // ── THE COST, AS WHAT IT IS A FUNCTION OF ──────────────────────
            // Per epoch: O(|delta| x |accumulated input|) for the presence gate
            // (a LINEAR `==` scan, the same unindexed shape `__s<k>` uses — a
            // `HashSet` would be O(1) amortized but demands `Hash` of a caller's
            // row struct, which nothing in the admission proves), plus one copy
            // of the input and one of the total, plus the driver's own naive
            // round 0. NOT MEASURED at any size; no number is quoted.
            let mut pt: String = String::new();
            let ety: str = prm.tys[rel_sp];
            let rty: str = prm.rel_rowty[rel_m];
            let mut eqt: String = String::new();
            incr_row_eq_text(ty, ety, "__c", "__dv", &mut eqt);
            // ── INBOUND COLLAPSE BOUNDARY: a 0→positive PRESENCE crossing ───
            // ⚠ THIS IS THE ONLY PLACE A CALLER'S DELTA ENTERS, AND IT ENTERS AS
            // A BIT. No weight is read, no multiplicity is stored, and there is
            // no field for one — see the note on the handle's fields. The same
            // edge presented twice is one fact, which is what a `rel` MEANS.
            pt.push_str("let mut __ecp: Vec<"); pt.push_str(ety); pt.push_str("> = Vec::<"); pt.push_str(ety); pt.push_str(">::new();\n");
            pt.push_str("let mut __ck: i64 = 0i64;\n");
            pt.push_str("while __ck < __h.__edb.len() { __ecp.push(__h.__edb.get(__ck)); __ck = __ck + 1i64; }\n");
            // ⚠ THE PREFIX MARK THE `|__edb|` BOUND BELOW IS CHECKED AGAINST.
            // Taken HERE, before a single delta row is merged, so it is exactly
            // `|__h.__edb|` — the size the PREVIOUS epoch certified.
            pt.push_str("let __eb0: i64 = __ecp.len();\n");
            pt.push_str("let mut __di: i64 = 0i64;\n");
            pt.push_str("while __di < ("); pt.push_str(prm.names[rel_sp]); pt.push_str(").len() {\n");
            pt.push_str("    let __dv: "); pt.push_str(ety); pt.push_str(" = ("); pt.push_str(prm.names[rel_sp]); pt.push_str(")[__di];\n");
            pt.push_str("    let mut __dup: bool = false;\n");
            pt.push_str("    let mut __dq: i64 = 0i64;\n");
            pt.push_str("    while __dq < __ecp.len() {\n");
            pt.push_str("        let __c: "); pt.push_str(ety); pt.push_str(" = __ecp.get(__dq);\n");
            pt.push_str("        if ("); pt.push_str(string_as_str(&eqt)); pt.push_str(") { __dup = true; }\n");
            pt.push_str("        __dq = __dq + 1i64;\n");
            pt.push_str("    }\n");
            pt.push_str("    if !__dup { __ecp.push(__dv); }\n");
            pt.push_str("    __di = __di + 1i64;\n");
            pt.push_str("}\n");
            // ══ THE |__edb| BOUND, CHECKED BY THE PROGRAM — P3c ════════════
            //
            // ⚠ THE GATE ABOVE WAS PINNED BY NOTHING, AND THAT WAS MEASURED,
            // NOT SUSPECTED. `wql_incr_rel_rec_epochs` records it: defeat the
            // `==` gate — push every delta row, duplicates included — and NO
            // ANSWER MOVES anywhere in the tree, because dedup is re-imposed
            // DOWNSTREAM by the driver's shadow-set presence bit on the DERIVED
            // rows. The gate is a COST filter: round 0 is a full naive pass over
            // `__edb` every epoch, so an unbounded `__edb` makes epochs
            // quadratic in the number of times a caller re-presents a fact. A
            // cost claim that no gate pins is a claim this arc has learned to
            // distrust.
            //
            // So the bound is stated as something the PROGRAM checks:
            //
            //     |__edb|  ==  |distinct facts ever presented|
            //
            // and it is checked on the SUFFIX — every row merged this epoch
            // against every row that precedes it — rather than by a full
            // pairwise sweep. That is not a shortcut; it is the whole invariant,
            // BY INDUCTION: the prefix `[0 .. __eb0)` is `__h.__edb` as the
            // PREVIOUS epoch committed it, and the previous epoch ran this same
            // check before committing, so it is already distinct. The base case
            // is the empty `__edb` a fresh handle carries. Checking the suffix
            // against everything therefore establishes distinctness of the
            // whole, and a duplicate inside the delta itself is caught too
            // because `__eb` ranges over the new rows as well.
            //
            // It is INDEPENDENT of the gate rather than a second call into it:
            // its own loop, its own cursors, its own instantiation of the row
            // equality (`__xa`/`__xb`, not the gate's `__c`/`__dv`), so deleting
            // the gate does not delete the check with it — it makes the check
            // FIRE, on the first repeated fact, instead of the handle silently
            // doubling.
            //
            // ⚠ IT PANICS RATHER THAN RETURNING AN `ElError`, and that is a
            // decision about WHOSE fault it is. No caller can provoke it — the
            // gate stands between every caller and this check — so it is the
            // same class as the recursive aggregate's convergence guard fifty
            // lines from here, and it takes the same answer. The `ElError`
            // variant was written FIRST and reverted: it made five exhaustive
            // `match`es across the corpus non-exhaustive at once, charging every
            // caller an arm for a condition no caller can cause. See the note on
            // `ElError` in el.logos.
            //
            // ⚠ MEASURED CONTROL, 2026-08-07: remove the `if !__dup` guard,
            // drop the archives, rebuild the stdlib. `wql_incr_rel_mutrec_epochs`
            // and `wql_incr_rel_rec_epochs` BOTH red, each at the epoch that
            // re-presents an edge. (Measured against the `Err` form, at exit 201
            // and 131 respectively; the panic form reds the same epoch with the
            // message above instead of a code — re-measured below.) Before this
            // check, that same edit moved NO answer anywhere in the tree.
            //
            // ⚠ AND THE COST IS THE GATE'S OWN CLASS, WHICH IS WHY THE SUFFIX
            // FORM WAS CHOSEN. The gate already pays O(|delta| × |__edb|) with
            // this same unindexed `==`; the check pays O(|delta| × |__edb|) too,
            // so the epoch's complexity is unchanged and what is added is one
            // constant factor. The full pairwise sweep was written first and
            // REJECTED on measurement of its shape rather than its runtime: it
            // is O(|__edb|²), which for the single-row deltas every fixture here
            // uses is a genuine new asymptote (per-epoch O(n) → O(n²)), and
            // "no new asymptote" would have been a false sentence in the exact
            // place this arc has twice been burned for writing one. A
            // counter-based form (`|__edb| <= Σ|delta|`) was rejected for the
            // opposite reason: it stays TRUE with the gate deleted, so it would
            // not bite — "a control that changes nothing".
            let mut eqt2: String = String::new();
            incr_row_eq_text(ty, ety, "__xa", "__xb", &mut eqt2);
            pt.push_str("let mut __ea: i64 = __eb0;\n");
            pt.push_str("while __ea < __ecp.len() {\n");
            pt.push_str("    let __xa: "); pt.push_str(ety); pt.push_str(" = __ecp.get(__ea);\n");
            pt.push_str("    let mut __eb: i64 = 0i64;\n");
            pt.push_str("    while __eb < __ea {\n");
            pt.push_str("        let __xb: "); pt.push_str(ety); pt.push_str(" = __ecp.get(__eb);\n");
            pt.push_str("        if ("); pt.push_str(string_as_str(&eqt2));
            pt.push_str(") { logos.lang.panic::panic(\"wql!: <q>_epoch's accumulated input `__edb` is NOT DISTINCT — the presence gate in front of it let a repeated fact through, so round 0's per-epoch pass over the accumulated input is no longer bounded by the number of DISTINCT facts ever presented\"); }\n");
            pt.push_str("        __eb = __eb + 1i64;\n");
            pt.push_str("    }\n");
            pt.push_str("    __ea = __ea + 1i64;\n");
            pt.push_str("}\n");
            // ── THE TOTALS, ONE PER SCC MEMBER — P3c ───────────────────────
            // Each seeded from the handle into a LOCAL: the driver extends them
            // in place and a fault anywhere in the fixpoint leaves the handle
            // EXACTLY as it was, which is the transactional half this body has
            // and `<q>_apply` does not. With N members that property is now N
            // writes that must all land after the driver returns, and they do —
            // the commits are below the call, not interleaved with it.
            //
            // ⚠ `__tt<i>` IS INDEXED BY POSITION IN `tmem`, WHICH IS THE ORDER
            // `emit_scc_fn` PUT THE OUT-PARAMS IN. The two members of a mutually
            // recursive pair usually share a row type, so a swapped pair
            // TYPECHECKS and answers with the relations exchanged. The single
            // scan in `tmem`'s construction is what makes the order one fact.
            let mut fi: i64 = -1i64;
            let mut t0: i64 = 0i64;
            while t0 < ntm {
                let mrt: str = prm.rel_rowty[tmem[t0]];
                if tmem[t0] == rel_m { fi = t0; }
                pt.push_str("let mut __tt"); pt.push_i64(t0);
                pt.push_str(": Vec<"); pt.push_str(mrt); pt.push_str("> = Vec::<"); pt.push_str(mrt); pt.push_str(">::new();\n");
                pt.push_str("let mut __tk"); pt.push_i64(t0); pt.push_str(": i64 = 0i64;\n");
                pt.push_str("while __tk"); pt.push_i64(t0); pt.push_str(" < __h."); pt.push_str(string_as_str(&totnm[t0]));
                pt.push_str(".len() { __tt"); pt.push_i64(t0); pt.push_str(".push(__h."); pt.push_str(string_as_str(&totnm[t0]));
                pt.push_str(".get(__tk"); pt.push_i64(t0); pt.push_str(")); __tk"); pt.push_i64(t0);
                pt.push_str(" = __tk"); pt.push_i64(t0); pt.push_str(" + 1i64; }\n");
                pt.push_str("let __b0"); pt.push_i64(t0); pt.push_str(": i64 = __tt"); pt.push_i64(t0); pt.push_str(".len();\n");
                t0 = t0 + 1i64;
            }
            // ⚠ THE CALL IS IN ITS OWN BLOCK so the `&[..]` view of `__ecp` dies
            // before `__ecp` is MOVED into the handle two statements later.
            pt.push_str("{\n");
            pt.push_str("let __ecs: &["); pt.push_str(ety); pt.push_str("] = __ecp.as_slice();\n");
            pt.push_str("__wql_");
            pt.push_str(bare);
            pt.push_str("_scc");
            pt.push_i64(prm.rel_sccid[rel_m]);
            pt.push_str("_i(");
            let mut ai: i64 = 0i64;
            while ai < prm.n {
                if ai > 0i64 { pt.push_str(", "); }
                if ai == rel_sp { pt.push_str("__ecs"); } else { pt.push_str(prm.names[ai]); }
                ai = ai + 1i64;
            }
            let mut t1: i64 = 0i64;
            while t1 < ntm {
                if prm.n > 0i64 || t1 > 0i64 { pt.push_str(", "); }
                pt.push_str("&mut __tt"); pt.push_i64(t1);
                t1 = t1 + 1i64;
            }
            pt.push_str(")?;\n");
            pt.push_str("}\n");
            // ── COMMIT, then take THIS EPOCH'S NEW ROWS as a suffix ─────────
            // `promote` only ever APPENDS to the total, so the rows derived this
            // epoch are exactly `[__b0<i> .. len)` — no extra vector had to be
            // maintained to know which they are, and that stays true PER MEMBER
            // because `promote` is per member.
            //
            // ⚠ ONLY ONE MEMBER IS FOLDED, AND THAT IS NOT AN OVERSIGHT — P3c.
            // The entry query selects from exactly one rel (`rel_m`, found by
            // `rel_find_src(ch.base_src)`), so the group state it maintains is a
            // function of THAT member's rows alone. The co-members are
            // MAINTAINED — their totals are seeded, extended and committed —
            // because the fixpoint needs them, and they are never folded because
            // nothing asked about them. A second query over the other member
            // gets its own handle with its own group state.
            pt.push_str("__h.__edb = __ecp;\n");
            pt.push_str("let mut __nw: Vec<"); pt.push_str(rty); pt.push_str("> = Vec::<"); pt.push_str(rty); pt.push_str(">::new();\n");
            pt.push_str("let mut __rk: i64 = __b0"); pt.push_i64(fi); pt.push_str(";\n");
            pt.push_str("while __rk < __tt"); pt.push_i64(fi); pt.push_str(".len() { __nw.push(__tt");
            pt.push_i64(fi); pt.push_str(".get(__rk)); __rk = __rk + 1i64; }\n");
            // ⚠ THE COMMITS COME AFTER THE FOLD'S COPY, because committing MOVES
            // `__tt<i>` into the handle — the selected member's rows would be
            // gone. All N land here, together, below the driver call.
            let mut t2: i64 = 0i64;
            while t2 < ntm {
                pt.push_str("__h."); pt.push_str(string_as_str(&totnm[t2]));
                pt.push_str(" = __tt"); pt.push_i64(t2); pt.push_str(";\n");
                t2 = t2 + 1i64;
            }
            pt.push_str("let __nws: &["); pt.push_str(rty); pt.push_str("] = __nw.as_slice();\n");
            // ⚠ SPLICED WITH A REPETITION (`#( #pro; )*`) AND NOT AS `#(pro)`.
            // The two are not the same construct: `#(x)` in statement position
            // embeds a BLOCK, so every `let` above would die at its closing brace
            // and `__nws` would be invisible to the fold loop — the exact scope
            // rule that makes `prelude_frag` items-only. A repetition splices the
            // statement list FLAT.
            let mut prow: String = String::new();
            prow.push_str("{\n");
            prow.push_str(string_as_str(&pt));
            prow.push_str("}\n");
            let mut pro: Vec<ExprBlob> = vec_new::<ExprBlob>();
            pro.push(parse_block(string_as_str(&prow)));
            // ── OUTBOUND COLLAPSE BOUNDARY: +1 PER DERIVED ROW, NEVER `__wd` ─
            // ⚠ AND `__wd` DOES NOT EXIST IN THIS SCOPE. A rel-backed query
            // takes the INSERT-ONLY surface (`incr_retract_eligible` refuses
            // first, with recursion as its ground), so there is no weight
            // parameter anywhere in the emitted signature and folding at a
            // weight is not expressible rather than merely wrong. The rows
            // folded are `__nws` — the ones this epoch ADDED — so an unchanged
            // saturated fixpoint folds nothing and the answer does not move.
            epoch_body = quote_block! {
                #( #pro; )*
                let mut __n: i64 = 0i64;
                let mut __i0: i64 = 0i64;
                while __i0 < __nws.len() {
                    let #base_vnm: &#(base_ty_f) = &__nws[__i0];
                    let __k: #(keyt_f) = (#(key_f));
                    let mut __gi: i64 = -1i64;
                    let mut __s: i64 = 0i64;
                    while __s < __h.__gk.len() { if __h.__gk.get(__s) == __k { __gi = __s; } __s = __s + 1i64; }
                    if __gi < 0i64 {
                        __h.__gk.push(__k);
                        __h.__gc.push(0i64);
                        #( #seeds; )*
                        __gi = __h.__gk.len() - 1i64;
                    }
                    __h.__gc.set(__gi, __h.__gc.get(__gi) + 1i64);
                    #( #folds; )*
                    __n = __n + 1i64;
                    __i0 = __i0 + 1i64;
                }
                return Result::Ok(__n);
            };
        } else {
        epoch_body = quote_block! {
            #(pre_f);
            let mut __n: i64 = 0i64;
            let mut __i0: i64 = 0i64;
            while __i0 < (#(base_src_f)).len() {
                let #base_vnm: &#(base_ty_f) = &(#(base_src_f))[__i0];
                let __k: #(keyt_f) = (#(key_f));
                let mut __gi: i64 = -1i64;
                let mut __s: i64 = 0i64;
                while __s < __h.__gk.len() { if __h.__gk.get(__s) == __k { __gi = __s; } __s = __s + 1i64; }
                if __gi < 0i64 {
                    __h.__gk.push(__k);
                    __h.__gc.push(0i64);
                    #( #seeds; )*
                    __gi = __h.__gk.len() - 1i64;
                }
                __h.__gc.set(__gi, __h.__gc.get(__gi) + 1i64);
                #( #folds; )*
                __n = __n + 1i64;
                __i0 = __i0 + 1i64;
            }
            return Result::Ok(__n);
        };
        }
        eps.push_str("__h: &mut ");
        eps.push_str(tyn);
        if params_text.len() > 0i64 {
            eps.push_str(", ");
            eps.push_str(params_text);
        }
        prep_derived_name(fn_name, "_epoch", &mut enm);
        emit_fn_quote_blob(string_as_str(&enm), string_as_str(&eps), "",
                           "Result<i64, ElError>", epoch_body, prm);
    }

    // ── <q>_snapshot(&h) — the group rows, in first-occurrence order ────────
    // ⚠ FIRST-OCCURRENCE ORDER IS THE SAME ORDER `<q>()` PRODUCES, and it is the
    // same order for the same REASON: groups are appended to `__gk` as they are
    // first seen and nothing permutes them afterwards. That is what makes the
    // metamorphic property assertable element-by-element — for any split of one
    // row multiset into epochs, snapshot equals `<q>()` over the concatenation —
    // rather than only as a set.
    //
    // ── AN EMPTIED GROUP IS TOMBSTONED, NOT DELETED — AND THAT IS MEASURED ──
    // The dynamic engine keeps the slot (`keyv`/`gcount`/`gsum`/`vmap` all
    // persist) and merely sets `live = false` when the multiplicity reaches 0,
    // so the row leaves the output while first-occurrence order and the slot a
    // re-inserted key finds are both untouched. The static tier gets the same
    // behaviour from a GUARD here: `__gk` keeps its entry, `<q>_snapshot` skips
    // any group whose multiplicity is not positive.
    //
    // The two alternatives were priced and both cost a property the harness
    // rests on. DELETING the `__gk` entry breaks first-occurrence order, so the
    // metamorphic law stops being assertable element-by-element and becomes a
    // set comparison. KEEPING AND EMITTING the empty group diverges from batch
    // recompute, which the harness names as the correctness spec. Tombstoning
    // satisfies both; its price is that `__gk` grows monotonically under
    // insert/retract churn with no reclamation, and there is no free compaction
    // — a pass that removed dead slots would renumber nothing but would break
    // the order it exists to protect.
    //
    // ⚠ THE GUARD IS EMITTED UNCONDITIONALLY, INCLUDING FOR AN INSERT-ONLY
    // QUERY WHERE IT IS INERT. That is deliberate: under inserts every created
    // group has multiplicity ≥ 1, so the P1 fixtures prove the guard changes no
    // answer they already pin, which is what makes them a control on it.
    let elem_f: ExprBlob = parse_type(result_ty);
    let proj_f: ExprBlob = parse_expr(proj_body);
    let mut keep: ExprBlob = quote_block! { __out.push(#(proj_f)); };
    if has_having {
        let hav_f: ExprBlob = parse_expr(having_body);
        keep = quote_block! { if (#(hav_f)) #(keep) };
    }
    keep = quote_block! { if __h.__gc.get(__r0) > 0i64 #(keep) };
    let snap_body: ExprBlob = quote_block! {
        let mut __out: Vec<#(elem_f)> = Vec::<#(elem_f)>::new();
        let mut __r0: i64 = 0i64;
        while __r0 < __h.__gk.len() {
            let key: #(keyt_f) = __h.__gk.get(__r0);
            #( #freads; )*
            #(keep);
            __r0 = __r0 + 1i64;
        }
        return Result::Ok(__out);
    };
    let mut sps: String = String::new();
    sps.push_str("__h: &");
    sps.push_str(tyn);
    let mut srty: String = String::new();
    srty.push_str("Result<Vec<");
    srty.push_str(result_ty);
    srty.push_str(">, ElError>");
    let mut snm: String = String::new();
    prep_derived_name(fn_name, "_snapshot", &mut snm);
    emit_fn_quote_blob(string_as_str(&snm), string_as_str(&sps), "",
                       string_as_str(&srty), snap_body, prm);
    return true;
}

// `Vec<T>` as a TYPE fragment and `Vec::<T>::new()` as constructor TEXT — the two
// spellings the handle's field list and its constructor need, composed from the
// element type's name rather than from a per-type table.
fn parse_type_of_vec(t: str) -> ExprBlob {
    let mut s: String = String::new();
    s.push_str("Vec<");
    s.push_str(t);
    s.push_str(">");
    return parse_type(string_as_str(&s));
}
fn push_vec_new(out: &mut String, t: str) {
    out.push_str("Vec::<");
    out.push_str(t);
    out.push_str(">::new()");
}

// ══ IS THIS QUERY'S SHAPE EXPRESSIBLE ON A PERSISTED HANDLE? ════════════════
//
// DERIVED from the plan, never listed by a caller — which is what keeps the
// population of incremental queries a property of the ARTIFACT rather than of
// somebody's list. Every clause below states WHICH fact about a handle it rests
// on, because a refusal whose ground is "not supported yet" is the one that
// never gets revisited.
//
// ⚠ THE FLOOR IS THE DYNAMIC ENGINE'S OWN, AND THAT IS A CHOICE WITH A PAYOFF.
// `IncrJoin` admits exactly `RDistinct?( RProj( RFilter?( RAggr( RScan ) ) ) )`
// — one bare-scan source, `having` above the group, no `order by` / `limit` /
// `edge` / `fix` / `rel`. The static `emit_aggregate` is strictly richer (it
// takes a join chain and a pre-group `where`), so restricting P1 to the same
// floor costs nothing that is not already deferred and buys a DIFFERENTIAL
// against a genuinely separate implementation for every fixture — an asset that
// stops existing when the interpreter is removed.
// ⚠ EVERY DECISION IS TRACED WITH ITS GROUND, ON THE SAME CHANNEL AND IN THE
// SAME SHAPE AS THE JOIN-ORDER DECISION (`LOGOS_TRACE_PLAN`, `plan_trace`). A
// query that does NOT gain the incremental form gains it silently otherwise, and
// "why did my query not get a handle" is then answerable only by reading this
// function — which is the class of unobservable derived decision this compiler
// has already paid for once at the join-order axis.
fn incr_eligible(ch: &JChain, ty: &ElTypes, aggs: &RAggArr, acount: i64,
                 uda: &[bool; 8], act: &[str; 8], key_ty: str,
                 result_ty: str, tres: i32, has_having: bool, proj_e: SExpr,
                 having_ref: WRef<SExpr>, has_where: bool, mods: QMods,
                 prm: &MacroParams, retr: bool, qn: str) -> bool {
    // ── A DECLARED `rel` IS A SET, AND A HANDLE OVER ONE ANSWERS WRONG ──────
    //
    // ⚠⚠ THIS CLAUSE CLOSES A SILENT WRONG ANSWER, NOT A MISSING FEATURE, AND
    // THE FLOOR THIS FUNCTION'S OWN HEADER STATES ALREADY EXCLUDED `rel` —
    // "one bare-scan source … no `order by` / `limit` / `edge` / `fix` / `rel`"
    // — it was written down and never mechanized, so it got re-made. Until now
    // NO clause here asked whether a source was a rel, and every consequence
    // below was MEASURED on aaf16585 against the query's own batch fn:
    //
    //   • RECURSIVE rel (transitive closure), edges {(1,2),(2,3)} split into two
    //     one-edge epochs: batch says group 1 has count 2 (it derives (1,3)),
    //     the handle says 1. The closure of a union is not the union of the
    //     closures.
    //   • NON-RECURSIVE rel, the SAME edge presented in two epochs: batch says
    //     1 (the rel dedups), the handle says 2. So the hole is EVERY declared
    //     rel, not only a recursive one — dedup alone is enough to break it.
    //   • one `_apply(h, 0, +2, …)`: a Z-set row of weight 2 is two copies, but
    //     the rel is a SET, so the closure is unchanged and batch says 1 while
    //     the handle says 2.
    //   • a retraction through recursion: batch over the survivor has NO group 1
    //     at all, the handle reports group 1 with count 1 — and returns `Ok`.
    //
    // THE MECHANISM, because a ground that does not name one is the ground that
    // never gets revisited: `emit_incremental` splices the rel PRELUDE verbatim
    // at the top of `<q>_apply` (the `prelude_frag` call below), exactly as the
    // batch emitters do. That prelude declares `let mut __rel_<m> = Vec::new();`
    // and runs the whole SCC fixpoint — so every call re-materializes the rel
    // FROM AN EMPTY TOTAL over THE DELTA ALONE, then folds each resulting row at
    // the delta's weight. Both properties a rel has are properties of the
    // ACCUMULATED input: set-semantics dedup (`rel_push_frag`'s shadow-set gate)
    // and the recursive closure. The handle stores neither the rel's rows nor
    // the input they were derived from, so neither survives the epoch boundary.
    //
    // THE SUCCESSOR IS NAMED, NOT VAGUE. Insert-only maintenance means seeding
    // the semi-naive loop with the EDB delta instead of the whole relation, and
    // it needs: the per-member total `__tot_<m>` and shadow set `__rs_<m>`
    // promoted from fn locals onto the handle; the accumulated EDB kept as
    // handle state in Z-set normal form; a round-0 variant in `body_scc_occs`
    // binding the EDB occurrence to the delta and the in-SCC occurrence to the
    // existing total; and a SECOND prelude threaded through `walk_query` →
    // `emit_incremental`, which today receives the prelude only as opaque text
    // and never sees `RelScc` at all. RETRACTION through recursion is a further
    // slice again — a fact may support ITSELF through a cycle, so "subtract what
    // it added" is wrong; the answer is DRed (over-delete, compact, re-derive),
    // which the dynamic engine already implements at `incr_rec.logos:776-910`
    // and which degrades to full recompute for a lattice member.
    //
    // ⚠ WEIGHTS MAY NEVER FLOW NAIVELY INTO AN SCC, and that is why the fix is
    // not "carry `__wd` through". Counting derivations through a cycle DIVERGES:
    // `path(a,b) :- path(a,c), edge(c,b)` has unboundedly many derivations of
    // one fact, and set semantics is exactly what makes the existing fixpoint
    // terminate. Any successor collapses the inbound weight to a 0→positive
    // PRESENCE crossing and folds each derived row at +1, never at `__wd`.
    //
    // ⚠ NATIVE rels are NOT refused, and that is MEASURED rather than assumed.
    // A native rel (`<p>: &Writ`, materialized by `writ_graph_edges`) has no
    // dedup and no recursion: it is a pure function of one caller-owned
    // container, so folding each epoch's rows at their weight IS the multiset
    // union a bare scan means. Measured on aaf16585: one epoch over a document
    // equals the batch over that document. The accumulated input of several
    // `&Writ`s is not expressible as a batch call at all, so there is no
    // cross-epoch spec here to violate in the way a derived rel violates one.
    // ── P3b: THE REFUSAL BECOMES AN ANSWER, FOR ONE SHAPE ──────────────────
    //
    // What replaced the blanket refusal is NOT "rels are fine now". The handle
    // now OWNS the accumulated input and the rel's fixpoint TOTAL, and
    // `<q>_epoch` extends that total by re-entering a cross-epoch semi-naïve
    // driver rather than re-running the fixpoint from an empty one. That is the
    // whole of the change, and everything the old ground said about a shape the
    // handle does NOT own is still true and still refused below, with the
    // specific antecedent named.
    //
    // ⚠ A REL IN JOIN POSITION IS STILL REFUSED, AND THE REFUSAL IS NOW PINNED.
    // The previous round left this loop pinned by NOTHING — both matrix rel
    // queries put the rel in BASE position, so deleting the loop left every gate
    // green. `no_rel_join` in `wql_incr_eligibility_matrix.logos` is a rel in
    // JOIN position and the gate asserts its ground, so this clause now bites.
    // It is not a formality: the handle's join arm stores the joined side as a
    // weighted Z-set (`__s1`/`__s1w`), and a rel side has no weight to store —
    // its rows come out of a fixpoint that has already deduped them.
    let mut rsi: i64 = 0i64;
    while rsi < ch.n {
        if incr_src_is_derived_rel(prm, ch.src[rsi]) {
            return incr_decline(qn, "a JOIN-POSITION source is a DECLARED `rel` — the handle's joined side is stored as a weighted Z-set (`__s<k>`/`__s<k>w`) and a derived rel has no multiplicity to store: its rows come out of a set-semantics fixpoint over the ACCUMULATED input, which is state the join arm does not own");
        }
        rsi = rsi + 1i64;
    }
    let rel_m: i64 = prm.rel_find_src(ch.base_src);
    if rel_m >= 0i64 {
        // A rel in BASE position AND a join step: the epoch would have to
        // maintain the fixpoint total AND a weighted Z-set side in one call.
        if ch.n > 0i64 {
            return incr_decline(qn, "the BASE source is a declared `rel` and the query also JOINS — one epoch would have to extend a set-semantics fixpoint total and integrate a weighted Z-set side, and the source TAG that tells them apart lives on `<q>_apply`, which a rel-backed query does not emit");
        }
        // THE SHAPE, DERIVED ONCE, IN `stamp_rel_incr_shape`. The ground travels
        // with the flag — see the note on `rel_incr_why`. ⚠ This is also what
        // keeps the admission and the ARTIFACT in step: `emit_rel_fns` emits the
        // `_i` driver under the same flag, so an admission that disagreed would
        // call a function that does not exist.
        if !prm.rel_incr_ok[rel_m] { return incr_decline(qn, prm.rel_incr_why[rel_m]); }
        // ── THE ACCUMULATED INPUT MUST BE OWNABLE AND IDENTIFIABLE ──────────
        // The handle keeps the rel's EDB — every fact ever applied — because the
        // fixpoint is a function of the ACCUMULATED input and nothing else. That
        // makes the input's row type subject to exactly the question P3 asks of a
        // joined side: `str` is a borrow of caller bytes, and `f64` has no `==`
        // that is identity for the presence gate to search on.
        //
        // ⚠ AND THERE MUST BE EXACTLY ONE OF THEM. `<q>_epoch` keeps the query's
        // parameter list VERBATIM, so with two slice params a caller would pass
        // both on every call and the emitter could not tell which one is the
        // delta — the same ambiguity the join arm answers with a source TAG, and
        // a rel-backed query has no `<q>_apply` to carry one. Scalar params ride
        // through untouched (they are not input to accumulate).
        let mut nsl: i64 = 0i64;
        let mut spi: i64 = -1i64;
        let mut pk: i64 = 0i64;
        while pk < prm.n {
            if prm.is_slice[pk] { nsl = nsl + 1i64; spi = pk; }
            pk = pk + 1i64;
        }
        if nsl != 1i64 {
            return incr_decline(qn, "a rel-backed query must have EXACTLY ONE slice parameter — `<q>_epoch` keeps the parameter list verbatim, so with two the caller passes both on every call and nothing says which is the delta; the join arm answers that with a source TAG on `<q>_apply`, which a rel-backed query does not emit");
        }
        if !incr_row_ty_ok(ty, prm.tys[spi]) {
            return incr_decline(qn, "the rel's INPUT ROW TYPE is not OWNABLE AND IDENTIFIABLE field by field — the handle accumulates every fact ever applied, so a `str` field is a borrow of source bytes it does not own and an `f64` field has no `==` that is identity (NaN != NaN, -0.0 == +0.0) for the insert presence gate to search on");
        }
        // The rel's own ROW type is stored too (the fixpoint total). Its columns
        // are the rel's DECLARED ones, so the question is asked of the column
        // list rather than of a stamped struct — a rel row is a tuple and has no
        // binding table to walk.
        let coff: i64 = prm.rel_coff[rel_m];
        let mut ci2: i64 = 0i64;
        while ci2 < prm.rel_ccnt[rel_m] {
            let ct: str = prm.relc_ty[coff + ci2];
            if !incr_ty_ok(ct) || el_class_lookup(ct) == EL_TY_FLT() || el_class_lookup(ct) < 0i32 {
                return incr_decline(qn, "a rel COLUMN is `str` or `f64` — the handle owns the fixpoint TOTAL, and a `str` column is a borrow while an `f64` column has no `==` that is identity for the shadow set that makes the fixpoint terminate");
            }
            ci2 = ci2 + 1i64;
        }
    }
    // ── THE JOIN, P3: ONE STEP IS ADMITTED AND EVERY OTHER SHAPE IS NAMED ────
    // The old ground was "COMBINING per-source deltas is the DBSP product rule
    // and needs the joined side's state on the handle". That is still exactly
    // right — so the handle now KEEPS the joined side's state, and the refusal
    // retires for the shape where keeping it is derivable. What is left is a
    // list, and every entry names the piece that is missing rather than saying
    // "not supported yet".
    //
    // ⚠ TWO OR MORE STEPS IS THE ROTATION PROBLEM AND IT IS NOT THE FOLD'S. A
    // delta at chain slot s makes s the OUTERMOST source, and re-rooting a nest
    // changes four things at once — `chain_reorder`'s own header enumerates them
    // — of which the emitter here can derive only the first: the outer source,
    // WHICH HALF of each equi-term is the build key (`equi_term_sides` splits by
    // the step's NEW row var, so exchanging the vars exchanges build and probe),
    // therefore the STRATEGY (a direction may have no usable equi-key at all),
    // and the PLACEMENT of every floating predicate. `chain_reorder` does all
    // four but consumes a `JoinOrder` candidate table produced by the planner's
    // `decide_join_orders`, and this emitter never runs it. With exactly ONE
    // step there is ONE `on` predicate and NO placement question, and the nest
    // is two loops in either direction — which is why the line falls here and
    // not at "arbitrary chain".
    if ch.n > 1i64 { return incr_decline(qn, "the input is a JOIN CHAIN OF TWO OR MORE STEPS — rooting the nest at a step other than the base re-splits every equi-term's build/probe halves and re-places every floating predicate, which is `decide_join_orders`' derivation and this emitter does not run it"); }
    if ch.n == 1i64 {
        // A delta must name its SOURCE, and the tag lives in `<q>_apply`'s
        // signature — which exists only on the RETRACTING surface. The two axes
        // are independent (the tag says WHICH relation, the weight says WHICH
        // DIRECTION) and only their combination is unbuilt: an insert-only join
        // would need a THIRD emitted signature, `<q>_apply(&mut h, __src, …)`
        // with no weight. Named, not hidden — and it is reached only by a query
        // whose aggregate list already lost retraction to D4.
        if !retr { return incr_decline(qn, "the query JOINS and keeps the INSERT-ONLY surface (an aggregate accumulates in `f64` — decision D4), and the source TAG a join delta must carry lives on `<q>_apply`, which only the retracting surface emits"); }
        // An ANTI step is a MATCHCOUNT, not a product: a base row's membership
        // in the output flips when its match count crosses 0, so a delta on the
        // anti side must EMIT A RETRACTION of a row that itself did not change.
        // That is a second state machine (the dynamic engine spends
        // `incr.logos:1149-1251` on it) and it is not this fold.
        if ch.anti[0] { return incr_decline(qn, "the join step is ANTI — anti is a MATCHCOUNT whose 0↔positive crossing must emit a retraction of a row that never changed, which is a second state machine and not the product rule"); }
        // A TRAVERSAL step's source is a field-path expression re-derived per
        // BOUND ROW (`a.children`), so there is no standalone relation for the
        // handle to own and no tag that could name one.
        if ch.edge[0] { return incr_decline(qn, "the join step is a TRAVERSAL (`edge`) — its source is re-derived per bound row, so there is no standalone relation for the handle to own or for a source tag to name"); }
        // A BY-VALUE binding is the streamed/iterator shape's; the stored side is
        // a `Vec` this emitter indexes by reference.
        if ch.byval[0] { return incr_decline(qn, "the join step binds its row BY VALUE — the handle's stored side is a `Vec` this emitter binds by reference, and the two spellings are not interchangeable in the emitted predicate"); }
        // A STREAMED source yields its rows ONCE. The handle would have to be
        // that single reader and would then own a relation the caller can no
        // longer re-present as a delta.
        if prm.rel_src_streams(ch.base_src) || prm.rel_src_streams(ch.src[0]) {
            return incr_decline(qn, "a join source STREAMS — an iterator yields its rows once, so the handle would have to be its only reader and the caller could never re-present it as a delta");
        }
        // A SELF-JOIN puts ONE relation in TWO chain positions, so one tag would
        // have to feed both — and integrating the delta once while folding it
        // against a state that must also already contain it is exactly the
        // same-epoch double count this slice's fixture exists to catch. The
        // dynamic engine refuses it too (`incr.logos:1780`).
        if str_eq(ch.base_src, ch.src[0]) {
            return incr_decline(qn, "the join is a SELF-JOIN — one relation in two chain positions, so one source tag would feed both, and folding a delta against a state that must already contain it is the double count this rule exists to avoid");
        }
        // THE HANDLE OWNS ITS STORED SIDES, ROW BY ROW AND FIELD BY FIELD.
        // ⚠⚠ THIS CLAUSE IS NOT A FORMALITY AND THE COMPILER DOES NOT ENFORCE
        // IT. MEASURED (2026-08-07, prebuilt logosc): a row struct carrying a
        // `str` field copies into a handle-owned `Vec<Row>` and COMPILES CLEAN
        // — the handle then holds a view of source bytes it does not own, which
        // silently destroys the capability this emitter's header states in
        // capitals ("THE HANDLE BORROWS NOTHING … the caller may grow, move or
        // drop the source between epochs"). `incr_ty_ok` was already asked of
        // the group key, of every accumulator column and of every projected
        // component — and never of the ROW, because until now no row was stored.
        if !incr_row_ty_ok(ty, ch.base_ty) || !incr_row_ty_ok(ty, ch.ty[0]) {
            return incr_decline(qn, "a join source's ROW TYPE is not OWNABLE AND IDENTIFIABLE field by field — the handle stores whole rows of both sides, so a `str` field is a borrow of source bytes it does not own, a struct field is an ownership question this clause does not walk, and an `f64` field has no `==` that is identity (NaN != NaN, -0.0 == +0.0) for the Z-set's normal form to search on");
        }
    }
    // A PRE-GROUP `where` is admissible in principle and is refused here for the
    // same reason the dynamic engine refuses it: it has never been folded through
    // the incremental path, so admitting it would be an untested arm. `having`
    // sits ABOVE the group and IS admitted — it is re-evaluated per snapshot.
    if has_where { return incr_decline(qn, "a PRE-GROUP `where` filters rows before the fold, and that arm has never been folded incrementally — `having`, which sits above the group, IS admitted"); }
    // `order by` / `limit` / `distinct` all act on the SNAPSHOT rather than on
    // the fold, so they are cheap to add later and are excluded now only to keep
    // the emitted surface to what a fixture in this slice actually asserts.
    if mods.has_sort || mods.has_limit || mods.distinct { return incr_decline(qn, "`order by` / `limit` / `distinct` act on the SNAPSHOT rather than on the fold — cheap to add, excluded here so the emitted surface stays what a fixture asserts"); }
    // A generic `deem` would need the handle TYPE to carry the same type
    // parameters, which is a second emitted-surface question (they would ride
    // every one of the three fns as well). Named deferral.
    if prm.tparams.len() > 0i64 { return incr_decline(qn, "the query is GENERIC — the handle type would have to carry the same type parameters and so would all three derived fns"); }
    let mut i: i64 = 0i64;
    while i < acount {
        // A UDA threads the user's `A` and its own `_step`; its accumulator is
        // outside `agg_acc_ty`'s domain by construction, and the dynamic engine's
        // algebra gate refuses it too.
        if uda[i] { return incr_decline(qn, "a USER AGGREGATE threads its own accumulator type through `_step`, which is outside `agg_acc_ty`'s domain"); }
        // THE HANDLE OWNS ITS CELLS. A `str` accumulator column would be a BORROW
        // of a source row, and the source is exactly what a handle does not keep.
        if !incr_ty_ok(act[i]) { return incr_decline(qn, "an aggregate COLUMN is `str`/`String` — a handle owns its cells and a `str` cell is a borrow of a source row it does not keep"); }
        i = i + 1i64;
    }
    // The group KEY is stored by value for the handle's whole life, so the same
    // question is asked of it — and `str` keys are the named deferral this makes,
    // not an oversight: the dynamic engine solves it by interning every string
    // into its own Writ arena, which would put a Writ back into a path whose
    // whole thesis is that it needs none.
    if !incr_ty_ok(key_ty) { return incr_decline(qn, "the GROUP KEY is `str`/`String` — the dynamic engine solves this by interning into its own Writ, which is the one thing a typed handle exists not to need"); }
    if tres == 0i32 && !incr_ty_ok(result_ty) { return incr_decline(qn, "the RESULT element type is `str`/`String`"); }
    // `select` and `having` must be evaluable from the GROUP ROW alone — no
    // source row (its index is meaningless across epochs) and no scalar
    // parameter (it is a per-call value, and `<q>_snapshot` takes none).
    let mut onames: [str; 8] = ["", "", "", "", "", "", "", ""];
    let mut j: i64 = 0i64;
    while j < acount { onames[j] = aggs.agg_at(j).out; j = j + 1i64; }
    if !sexpr_over_group_names(proj_e, &onames, acount) {
        return incr_decline(qn, "`select` reaches a name that is neither `key` nor an aggregate output — a source row (its index means nothing across epochs) or a scalar parameter (`<q>_snapshot` takes none)");
    }
    if has_having && !sexpr_over_group_names(having_ref.any().view::<SExpr>(), &onames, acount) {
        return incr_decline(qn, "`having` reaches a name that is neither `key` nor an aggregate output");
    }
    // Every projected COMPONENT must be a value the handle can hand back without
    // borrowing anything it does not own.
    if !incr_proj_ty_ok(proj_e, ty) {
        return incr_decline(qn, "a projected COMPONENT is a `str`/`String` value, which the handle cannot hand back without borrowing something it does not own");
    }
    if ch.n == 1i64 {
        plan_trace("incremental", "EMITTED", qn, "one join step over two owned relations, group by, weighted aggregates over self-contained types");
        return true;
    }
    if rel_m >= 0i64 {
        plan_trace("incremental", "EMITTED", qn, "one bare scan over a RECURSIVE `rel`, group by, insert-only aggregates — the handle owns the accumulated input and the fixpoint TOTAL, and each epoch EXTENDS that total through the cross-epoch semi-naive driver");
        return true;
    }
    plan_trace("incremental", "EMITTED", qn, "one bare scan, group by, insert-only aggregates over self-contained types");
    return true;
}

/// May a whole ROW of this type be OWNED by a handle? The question `incr_ty_ok`
/// asks of ONE type, asked of every FIELD of a stored source row.
///
/// ⚠ IT REFUSES WHAT IT COULD NOT READ, and that direction is the whole point.
/// `type_stamped` false means the reflection walk never reached this struct — an
/// unknown name, an alias this module cannot follow, no module AST loaded — and
/// an unread struct is not an empty one. Answering `true` there would admit
/// exactly the rows whose fields nobody looked at.
///
/// ⚠ A FIELD WHOSE OWN TYPE IS A STRUCT IS REFUSED RATHER THAN WALKED. `el_ty`
/// answers the `i64` baseline for a name outside the lattice, so a nested struct
/// would pass `incr_ty_ok` while carrying a `str` two levels down — the silent
/// wrong answer this clause exists to stop. Ownership is transitive and this
/// function is not; refusing is the direction that cannot be wrong, and widening
/// it later breaks no caller.
///
/// ⚠⚠ A FLOAT FIELD IS REFUSED TOO, AND THAT IS THE *SECOND* QUESTION THIS
/// FUNCTION ANSWERS. Storing rows in Z-set NORMAL FORM means finding the entry a
/// delta row is a copy of, and that search is a field-by-field `==`. On `f64`,
/// `==` IS NOT IDENTITY — NaN ≠ NaN makes a row carrying one impossible to
/// retract, and −0.0 == +0.0 lets a retraction of one cancel an insert of the
/// other. That is Victor's open 2026-08-07 decision about the multiplicity map's
/// key wearing a different hat, and an emitter may not answer it in passing.
fn incr_row_ty_ok(t: &ElTypes, row_ty: str) -> bool {
    if row_ty.len() == 0i64 { return false; }
    if !t.type_stamped(row_ty) { return false; }
    let mut i: i64 = 0i64;
    while true {
        let e: i64 = t.type_field_at(row_ty, i);
        if e < 0i64 { return true; }
        let ftn: str = t.binding_ty_name_at(e);
        if ftn.len() == 0i64 { return false; }
        if el_class_lookup(ftn) < 0i32 { return false; }
        if !incr_ty_ok(ftn) { return false; }
        if el_class_lookup(ftn) == EL_TY_FLT() { return false; }
        if t.binding_col_at(e).len() == 0i64 { return false; }
        i = i + 1i64;
    }
    return true;
}

/// `<stored>.f == <delta>.f && …` over every stamped field of `row_ty` — the ROW
/// IDENTITY the Z-set's normal form searches on, spelled from the SAME field
/// list `incr_row_ty_ok` admitted the type on. One walk of the binding table
/// decides the type and one writes the test, so a field the check never saw can
/// never end up outside the comparison.
///
/// `sv` is the stored copy's local name, `dv` the delta row's binding.
fn incr_row_eq_text(t: &ElTypes, row_ty: str, sv: str, dv: str, out: &mut String) {
    let mut i: i64 = 0i64;
    while true {
        let e: i64 = t.type_field_at(row_ty, i);
        if e < 0i64 {
            // A struct with no stamped field cannot be told apart from another
            // instance of itself, so `true` here would make every row identical
            // and silently merge the relation into one entry. `incr_row_ty_ok`
            // admits only a `type_stamped` type, and a stamped type has at least
            // one binding — so this is unreachable, and it is spelled `false`
            // (nothing matches, every delta row becomes its own entry) rather
            // than `true` so that an unreachable case that becomes reachable
            // wastes memory instead of losing rows.
            if i == 0i64 { out.push_str("false"); }
            return;
        }
        if i > 0i64 { out.push_str(" && "); }
        out.push_str(sv);
        out.push_str(".");
        out.push_str(t.binding_col_at(e));
        out.push_str(" == ");
        out.push_str(dv);
        out.push_str(".");
        out.push_str(t.binding_col_at(e));
        i = i + 1i64;
    }
}

/// One declined incremental form, traced with its GROUND, then `false`.
/// Is this chain source a DECLARED, DERIVED `rel` — one materialized by query
/// BODIES rather than by an engine helper?
///
/// ⚠ `rel_find_src` resolves BOTH spellings a rel source wears (the emitted
/// `__rel_<m>_sl` and the semi-naive delta's `__dl_<m>_sl`), which is why the
/// question is asked of it rather than of `rel_names`: by the time a chain
/// reaches `incr_eligible` the plan node's `src_name` has been rewritten to the
/// emitted form, and matching the DECLARED name would silently answer "no rel
/// here" for every query in the population this predicate exists to catch.
///
/// ⚠ NATIVE is excluded deliberately and the ground is in `incr_eligible`: a
/// native rel has neither dedup nor recursion, so it carries no property of the
/// accumulated input for an epoch boundary to lose.
fn incr_src_is_derived_rel(prm: &MacroParams, src: str) -> bool {
    let i: i64 = prm.rel_find_src(src);
    if i < 0i64 { return false; }
    return !prm.rel_native[i];
}

fn incr_decline(qn: str, why: str) -> bool {
    plan_trace("incremental", "declined", qn, why);
    return false;
}

// ══ MAY THIS QUERY'S HANDLE BE RUN BACKWARDS? ══════════════════════════════
//
// The question `<q>_apply`'s WEIGHT and `<q>_retract` rest on, asked of the SAME
// aggregate array the folds are built from and traced on the SAME channel as
// every other derived decision — because a query that silently loses its
// retraction is exactly the unobservable derived decision `incr_eligible`'s
// header already argues about.
//
// ⚠ THE LIST IS THE UNIT, NOT THE AGGREGATE. A retraction retracts a ROW, and a
// row feeds every aggregate in the list at once. There is no shape in which
// `min` runs backwards and the `sum` beside it does not — so ONE aggregate that
// cannot take a negative weight takes the whole retracting surface away, and the
// batch fn, `<q>_epoch` and `<q>_snapshot` are untouched by the refusal.
//
// ⚠ EXACTLY ONE THING IS REFUSED, AND IT IS A FORK RATHER THAN A GAP:
//
//   `count`   — the multiplicity is an integer and `+w` inverts `+(-w)`.
//   `sum` over a NON-float accumulator — `i64` and `u64` both invert under
//               their own checked predicates, with no representable value lost.
//   `min`/`max`, AT EVERY TYPE INCLUDING f64 — these do NOT invert, and they do
//               not have to. Retracting the current best is answered by RESCAN
//               over a per-(group, aggregate) value→multiplicity map (see the
//               semilattice fold in `emit_incremental`), which computes no
//               inverse at all: an extremum is a value SELECTED from the
//               multiset, never a value COMPUTED from it, so nothing rounds and
//               f64 is admitted on the same footing as the integers.
//   `sum`/`avg` over an f64 accumulator — REFUSED. `(S+x)-x != S`. That is
//               decision D4, it is OPEN and reserved, and it is not this
//               emitter's to take. Note this catches `avg` over an INTEGER
//               column too: `avg` divides at snapshot out of an f64 running
//               total, so its accumulator is a float whatever the column is.
//
// ⚠ THE PREDICATE READS `acc`, THE ACCUMULATOR ARRAY, AND NOT `agg_flt`. The two
// axes answer the same cell — `compute_acc_tys` sets `acc[i] == "f64"` exactly
// when `agg_flt[i]`, and `agg_flt` is unconditionally true for `avg` — but the
// GROUND is about the accumulator, so the test that carries the ground should be
// the one that names it. (A UDA is the only place the two could part, with
// `acc[i] == ""`; `incr_eligible` declines a UDA one axis out, so this predicate
// is never asked about one.)
/// THE PREDICATE ITSELF, WITH NO TRACE — because ONE of its consumers has to ask
/// it BEFORE the query is known to be eligible at all, and tracing a `retraction`
/// verdict for a query that never gets a handle would break the derived count
/// `incr_eligibility_gate.sh` asserts (the retract axis is traced exactly once
/// per EMITTED handle, and that identity is the gate's second table).
///
/// ⚠ ONE DERIVATION, TWO CALLERS — not one decision asked twice. `incr_eligible`
/// needs the answer because a JOIN chain on the INSERT-ONLY surface has no place
/// to put a source tag (see the clause there); `incr_retract_eligible` needs it
/// to trace and to shape the emitted fns. Both read THIS function, so they cannot
/// answer differently — the `accw`/`compute_acc_tys` failure mode this file
/// already carries two warnings about.
fn retract_ok(aggs: &RAggArr, acount: i64, acc: &[str; 8]) -> bool {
    let mut i: i64 = 0i64;
    while i < acount {
        let fnid: i32 = agg_of_name(aggs.agg_at(i).fn_name);
        if (fnid == AGG_SUM() || fnid == AGG_AVG()) && str_eq(acc[i], "f64") { return false; }
        i = i + 1i64;
    }
    return true;
}

fn incr_retract_eligible(aggs: &RAggArr, acount: i64, acc: &[str; 8],
                         rel_backed: bool, qn: str) -> bool {
    // ── RETRACTION THROUGH RECURSION IS REFUSED, AND THE GROUND IS A FACT ───
    //
    // ⚠ ASKED FIRST, AHEAD OF THE AGGREGATE LIST, because it is the STRONGER
    // refusal: an f64 `sum` is an open DECISION, this one is a property of
    // recursion. A fact may support ITSELF through a cycle (`path(a,b)` derived
    // from `path(a,c)`), so "subtract what it added" is not merely imprecise —
    // there is no well-defined amount to subtract. The mechanism that IS correct
    // is DRed (over-delete every consequence, compact, re-derive from surviving
    // support), which the dynamic engine implements at `incr_rec.logos:776-910`;
    // it is a second state machine over provenance, not an inverse fold.
    //
    // ⚠⚠ AND THE REFUSAL IS STRUCTURAL, NOT ADVISORY. Returning `false` here
    // selects the INSERT-ONLY surface: `<q>_apply` and `<q>_retract` are not
    // emitted at all and `__wd` does not exist in any scope this query emits, so
    // folding a derived row at a weight is not expressible rather than merely
    // wrong. `fail/wql_incr_rel_no_retract.logos` calls `<q>_retract` and
    // requires the compile to FAIL on the missing name — flip this clause and
    // that fixture goes green, which is a red gate on the per-commit path.
    // ⚠ AND THAT `fail/` DOOR IS NOT THE LOAD-BEARING ONE — a missing name is
    // true under every refusal that reaches the query. The gate that pins THIS
    // clause by its GROUND is `logos_09_incr_mutrec_refusal` (tier_commit),
    // which asserts `retraction -> declined` carrying the phrase "support ITSELF
    // through a cycle" while the handle itself is EMITTED. CONTROL, MEASURED
    // 2026-08-07: `if rel_backed` weakened to `if false`, archives dropped, full
    // stdlib rebuild → that gate goes RED.
    //
    // ⚠⚠ DRed'S PHASE 1 IS NOW EMITTED AND THIS CLAUSE STILL SAYS NO, ON PURPOSE.
    // `emit_scc_od_fns` emits `__wql_<q>_scc<c>_od` / `_odp` beside the insert
    // driver, and `pass/wql_incr_rel_od_phase1.logos` proves the over-delete set
    // against a from-scratch oracle — but phase 2 (COMPACT) and phase 3
    // (RE-DERIVE) do not exist, nothing calls the two new fns outside that
    // fixture, and the handle has no signed-diff group fold. Admitting the
    // retraction surface on a phase-1-only engine would answer `Ok` with an
    // OVER-DELETED relation, which is strictly worse than refusing. The ground
    // below is unchanged for the same reason: what is missing is still the
    // mechanism, not a preference.
    if rel_backed {
        return incr_no_retract(qn, "the query is backed by a RECURSIVE `rel` — a derived fact may support ITSELF through a cycle, so there is no amount to subtract; the correct mechanism is DRed (over-delete, compact, re-derive), a provenance state machine and not an inverse fold");
    }
    if !retract_ok(aggs, acount, acc) {
        return incr_no_retract(qn, "an aggregate accumulates in `f64` (a float `sum`, or ANY `avg` — it divides at snapshot out of a float running total), and `(S+x)-x != S` is an OPEN decision rather than an emitter's to take");
    }
    plan_trace("retraction", "EMITTED", qn, "every aggregate in the list runs backwards exactly — `count` and integer `sum` invert exactly under their own checked predicate, `min`/`max` rescan a typed value→multiplicity map");
    return true;
}

/// One query that keeps the INSERT-ONLY surface, traced with its GROUND.
/// A separate channel name from `incr_decline`'s because it is a different
/// answer: the query DOES get a handle, it does not get a `<q>_retract`.
fn incr_no_retract(qn: str, why: str) -> bool {
    plan_trace("retraction", "declined", qn, why);
    return false;
}

/// May a value of this type be OWNED by a handle that outlives the call that
/// produced it? `str` is a VIEW — of a source row, of a Writ, of a literal — and
/// the first two are exactly what a persisted handle does not keep alive; a
/// `String` is owned but its `Vec<String>` snapshot would then differ from
/// `<q>()`'s `Vec<str>`, which is a surface question (two return types for one
/// query) rather than an emitter one. Both are DEFERRED, and pinned as refused
/// by the eligibility fixture so that they cannot become silently mishandled.
/// Everything else the EL lattice admits — the integer family, `bool`, `f64` —
/// is a self-contained value.
fn incr_ty_ok(t: str) -> bool {
    if str_eq(t, "String") { return false; }
    return el_ty(t).cls != EL_TY_STR();
}

/// The same question, asked of every component a tuple projection hands back.
/// A `String`-returning call at a component root is caught by `returns_string`
/// rather than by the component's inferred type, which is the same split
/// `push_tuple_ty` makes when it decides an element type.
fn incr_proj_ty_ok(e: SExpr, t: &ElTypes) -> bool {
    match e {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let mut i: i64 = 0i64;
            while i < items.len() {
                if !incr_proj_ty_ok(items.arg_at(i), t) { return false; }
                i = i + 1i64;
            }
            return true;
        }
        _ => {
            if returns_string(e, t) { return false; }
            return incr_ty_ok(infer_emit_ty(e, t));
        }
    }
}

// `__ga_<out>` / `__gf_<out>` / `<name><suffix>` — the generated-name spellings.
// ⚠ Each returns the STRING: `Ident::new` borrows, so the caller keeps it.
fn ga_name(out: str) -> String {
    let mut s: String = String::new();
    s.push_str("__ga_");
    s.push_str(out);
    return s;
}
// `__gm_<out>` — the min/max multiplicity map's field on the incremental
// handle. Same borrowing rule as `ga_name`: the caller keeps the String.
fn gm_name(out: str) -> String {
    let mut s: String = String::new();
    s.push_str("__gm_");
    s.push_str(out);
    return s;
}
fn gf_name(out: str) -> String {
    let mut s: String = String::new();
    s.push_str("__gf_");
    s.push_str(out);
    return s;
}
fn suffixed(name: str, suffix: str) -> String {
    let mut s: String = String::new();
    s.push_str(name);
    s.push_str(suffix);
    return s;
}

// Bind the base row var to a group's REPRESENTATIVE row: `let <var>: &<ty> =
// &(<src>)[<idx expr>];`. Emitted wherever the group columns are bound, so a
// clause over a group row may name the row var as well as `key`.
fn row_rebind_frag(base_var: str, base_ty: str, base_src: str, idx: ExprBlob) -> ExprBlob {
    let bv: Ident    = Ident::new(base_var);
    let bt: ExprBlob = parse_type(base_ty);
    let bs: ExprBlob = parse_expr(base_src);
    return quote_block! { let #bv: &#(bt) = &(#(bs))[#(idx)]; };
}

// The group-column re-binds for one FINALIZED group row (the representative
// base row + `key` + each aggregate output as a local of its declared name,
// read from the parallel `__gf_*` Vecs at index expression `idx`). Used twice
// by the output phase: once to evaluate the `order by` key, once to project.
fn group_binds_frag(idx: ExprBlob, aggs: &RAggArr, acount: i64, act: &[str; 8],
                    key_ty: str, base_var: str, base_ty: str, base_src: str) -> ExprBlob {
    let ridx: ExprBlob = quote_expr! { __gf_row.get(#(idx)) };
    let rebind: ExprBlob = row_rebind_frag(base_var, base_ty, base_src, ridx);
    let keyt_f: ExprBlob = parse_type(key_ty);
    let mut binds: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut gi: i64 = 0i64;
    while gi < acount {
        let a: RAgg = aggs.agg_at(gi);
        let s_gf: String = gf_name(a.out);
        let n_gf: Ident = Ident::new(string_as_str(&s_gf));
        let n_out: Ident = Ident::new(a.out);
        let act_f: ExprBlob = parse_type(act[gi]);
        binds.push(quote_block! { let #n_out: #(act_f) = #n_gf.get(#(idx)); });
        gi = gi + 1i64;
    }
    return quote_block! {
        #(rebind);
        let key: #(keyt_f) = __gf_key.get(#(idx));
        #( #binds; )*
    };
}

// ── Aggregate-spec computation ───────────────────────────────────────────────
// Per-aggregate OUTPUT value-type + accumulator width:
//   • count → INT (always an i64 row count);
//   • avg   → FLT ALWAYS (exact mean, f64 accumulator + f64 division — no
//             integer truncation), for EVERY argument class the rule table
//             admits: int, float and — under Victor's ruling — bool;
//   • sum/min/max → the ARGUMENT's type: an f64-typed arg gets an f64
//             accumulator + f64 result column, an int arg stays i64.
// `agg_flt[i]`  — this aggregate's accumulator/result is f64;
// `agg_cast[i]` — the fold step must cast the arg to f64 ITSELF (only avg over
//                 an ADMITTED non-float argument: int, or — under the ruling —
//                 bool). Row-field types are already stamped (schema + scalar
//                 params), so the arg infer here is well-typed.
//
// ⚠ IT HANDS THE TABLE THE ARGUMENT'S REAL CLASS. It used to compute
// `let aty = if arg_is_flt { FLT } else { INT }` and ask `agg_result_ty` about
// THAT — a question whose answer had already been decided. The shared rule table
// was therefore structurally unable to refuse anything on the static side: BOOL
// and STR arrived at it spelled INT, `avg` answered FLT for both, `agg_cast`
// came out true, and `compute_agg_bodies` skips `check_agg_operand` exactly
// there. MEASURED at the parent commit: `avg` over a `str` column compiled
// rc=0 while mlir-gen printed "unsupported cast", and the object file was
// written. The exemption at the call site was the symptom; the fabricated class
// was the defect, and only the class fix generalizes — a future non-numeric EL
// class is refused here without anyone remembering this arc.
//
// ⚠ AND `agg_cast` NOW KEYS ON "THE TABLE ADMITTED THE ARGUMENT", NOT ON "THE
// ARGUMENT IS NOT A FLOAT". Those coincide for every numeric argument (an int
// column of any width, `avg` included, still skips the check because
// `((s.v) as f64)` is what the fold emitter writes) and differ for exactly the
// arguments the table refuses — which is the whole of the hole.
fn compute_agg_reprs(aggs: &RAggArr, acount: i64, t: &ElTypes,
                     agg_flt: &mut [bool; 8], agg_cast: &mut [bool; 8]) {
    let mut ki: i64 = 0i64;
    while ki < acount {
        let ka: RAgg = aggs.agg_at(ki);
        let kfn: i32 = agg_of_name(ka.fn_name);
        // `count` is nullary and the table ignores `arg_ty` for it; INT is the
        // documented "pass anything" placeholder.
        let acls: i32 = if ka.has_arg { infer_ty(ka.arg_expr(), t) } else { EL_TY_INT() };
        let arg_is_flt: bool = acls == EL_TY_FLT();
        // THE SHARED RULE TABLE (el::agg_result_ty — one source for static +
        // dynamic tiers): FLT result ⇔ f64 accumulator/column. count → INT,
        // sum/min/max → arg type, avg → Quot(T) = FLT (T ∈ {INT, FLT, BOOL});
        // an argument outside the rule's domain, and every UDA / unknown name,
        // returns -1 (a UDA's repr is decided by the UDA machinery).
        let rty: i32 = agg_result_ty(ka.fn_name, acls);
        let admitted: bool = rty >= 0i32;
        // The accumulator must still be NAMED when the argument is refused —
        // `check_agg_operand`'s diagnostic says which accumulator the value
        // failed to reach. So ask the SAME table what this aggregate would
        // accumulate in for an argument it does admit (INT, the tower's base):
        // `avg` answers FLT unconditionally, `sum`/`min`/`max` answer INT, and a
        // UDA still answers -1, which keeps its repr where it belongs.
        let is_f: bool = if admitted { rty == EL_TY_FLT() }
                         else { agg_result_ty(ka.fn_name, EL_TY_INT()) == EL_TY_FLT() };
        if ki < 8i64 {
            agg_flt[ki]  = is_f;
            agg_cast[ki] = admitted && is_f && !arg_is_flt && kfn != AGG_COUNT();
        }
        ki = ki + 1i64;
    }
}

// Stamp each aggregate OUTPUT name's EL value-type into `ty` (the having /
// order / select clauses reference the outputs by name). A UDA output carries
// its reflected finalizer-result class (`aret`); a builtin stays on the
// agg_flt-driven FLT/INT split.
// ⚠ AN INTEGER OUTPUT IS RECORDED BY NAME, NOT BY CLASS, and the difference is
// a whole class of miscompile. `set_ty` stores the class REPRESENTATIVE, i.e.
// the literal name "i64" — so a `sum` accumulating in `u64` was announced to
// `select`, `having` and `order by` as an i64, `infer_emit_ty` made the result
// element type `Vec<i64>`, and the emitted push was `Vec<i64>::push(u64)`: the
// exact defect class `infer_emit_ty`'s own header records. The group KEY has
// carried its own type name since key vectors stopped being `Vec<i64>`
// (`ty.set_ty_named("key", key_ty)`), and this is the same move for the
// aggregate outputs. A UDA and a float still go by class: `aret` is a reflected
// CLASS with no name to carry, and `f64` IS the float representative.
fn stamp_agg_out_types(aggs: &RAggArr, acount: i64, agg_flt: &[bool; 8],
                       uda: &[bool; 8], aret: &[i32; 8], acc: &[str; 8],
                       ty: &mut ElTypes) {
    let mut i: i64 = 0i64;
    while i < acount {
        let a: RAgg = aggs.agg_at(i);
        if uda[i] {
            ty.set_ty(a.out, aret[i]);
        } else if agg_flt[i] {
            ty.set_ty(a.out, EL_TY_FLT());
        } else {
            ty.set_ty_named(a.out, acc[i]);
        }
        i = i + 1i64;
    }
    report_ty_overflow(ty);
}

// Validate each aggregate spec (known fn / resolved UDA, arg presence, arg-
// expression calls, and THE ARGUMENT'S ROUTE INTO THE ACCUMULATOR) and emit its
// ARG expression text. False (error surfaced) on a bad spec. `uda` marks the
// specs `resolve_aggs` accepted as user aggregates (a UDA REQUIRES an argument —
// the zero-arg `m = myagg()` form is out of scope and diagnosed via the shared
// arg-presence error).
//
// ⚠ THE LAST OF THOSE IS WHY `agg_flt` / `agg_cast` ARE PARAMETERS. The emitted
// text lands in an accumulator whose type this function does not otherwise need
// to know (`Vec<i64>` / `Vec<f64>`, decided by `compute_agg_reprs`), and the
// only thing that ever checked the two agreed was the HOST COMPILER, reporting
// from a generated line. See `check_agg_operand`.
// ── THE ACCUMULATOR'S TYPE, PER AGGREGATE, IN ONE PLACE ─────────────────────
// Fills `acc[i]` with the Logos type the i-th aggregate's RUNNING TOTAL is
// carried in. Read by `compute_agg_bodies` (the operand check + the normalizing
// cast) and by the fold emitter (the `Vec<A>` declaration, the seed and the
// arithmetic), so those three cannot come to different conclusions.
//
// The answer is `el::agg_acc_ty` of the ARGUMENT's own emitted type — "add under
// the column's own overflow predicate": `f64` for a float accumulator, `i64` for
// every integer width that widens losslessly, `u64` for the `EL_ORD_WRAP` class.
//
// ⚠ THERE USED TO BE A `typed` FLAG HERE AND ITS FALSE ARM ANSWERED THE CLASS
// REPRESENTATIVE FOR THE BATCH EMITTER. That is deleted. Two emitters holding
// two opinions about one cell is the disagreement the header below warns about
// one level down, and the disagreement was load-bearing: the batch's `Vec<i64>`
// declaration, its i64::MAX/MIN seeds and its unconditional `el_add` were the
// three places that made `false` the only answer it could survive. All three
// now take this array, so there is one answer and it is this one.
//
// ⚠ A UDA's CELL IS EMPTY AND IS NEVER READ. Its accumulator is the user's
// declared `A`, threaded verbatim through `uda_acc`, and its argument is printed
// into the user's `_step` rather than into an EL accumulator — so an answer here
// would be a claim about a seam this array does not describe. Empty is the
// honest value and `compute_agg_bodies` reaches the cell only under `!uda[ai]`.
//
// ⚠ `count` IS `i64` FROM THE FIRST BRANCH, NOT FROM A SPECIAL CASE. It has no
// argument (`agg_takes_arg`), `compute_agg_reprs` gives it `agg_flt = false`,
// and the `!has_arg` guard below keeps the argument inference from being asked
// about an argument that is not there.
//
// ⚠ THE INFERENCE IS `infer_emit_ty`, THE SAME ONE `check_agg_operand` ASKS.
// Asking `infer_ty_name` instead would be a second inference over the same node
// and a `u64` column could arrive spelled two ways at the check and at the
// accumulator; they read one answer.
fn compute_acc_tys(aggs: &RAggArr, acount: i64, t: &ElTypes, h: &Writ,
                   uda: &[bool; 8], agg_flt: &[bool; 8],
                   acc: &mut [str; 8]) {
    let mut i: i64 = 0i64;
    while i < acount {
        if uda[i] {
            acc[i] = "";
        } else if agg_flt[i] {
            acc[i] = "f64";
        } else {
            let a: RAgg = aggs.agg_at(i);
            if !a.has_arg {
                acc[i] = "i64";
            } else {
                let ae: SExpr = simplify_sexpr(a.arg_expr(), h).any().view::<SExpr>();
                acc[i] = agg_acc_ty(infer_emit_ty(ae, t));
            }
        }
        i = i + 1i64;
    }
}

// ⚠ `accw` — THE ACCUMULATOR'S TYPE, PASSED IN RATHER THAN RE-DECIDED HERE.
// This used to compute `if agg_flt[ai] { "f64" } else { "i64" }` on the line
// below, which is the same decision the FOLD EMITTER takes when it writes
// `Vec<i64>` / `Vec<f64>` and the seeds — two places deciding one thing, free to
// disagree, and the disagreement would be silent because `check_agg_operand`
// only ever sees this copy. It is one array now, computed by `compute_acc_tys`
// and read by the check, by the cast and by the accumulator declaration.
//
// ⚠ AND BOTH EMITTERS NOW READ THE SAME CELL, WHICH IS THE POINT. There was a
// period when they did not: the batch asked `compute_acc_tys` for the i64/f64
// pair verbatim and the incremental asked it for `el::agg_acc_ty`, so one
// emitter refused a `u64` argument the other would have accepted. The flag that
// expressed that is deleted; `accw` is one array, computed once and passed to
// the check, to the cast, to the accumulator declaration, to the seeds and to
// the fold's overflow predicate.
fn compute_agg_bodies(aggs: &RAggArr, acount: i64, t: &ElTypes, var0: str, h: &Writ,
                      uda: &[bool; 8], agg_flt: &[bool; 8], agg_cast: &[bool; 8],
                      accw: &[str; 8], agg_body: &mut [String; 8]) -> bool {
    let mut ai: i64 = 0i64;
    while ai < acount {
        let a: RAgg = aggs.agg_at(ai);
        let fnid: i32 = agg_of_name(a.fn_name);
        if fnid == 0i32 && !uda[ai] { error("wql!: aggregate fn must be count/sum/min/max/avg or a user aggregate (X_init/X_step[/X_fin])"); return false; }
        if fnid != AGG_COUNT() {
            if !a.has_arg { error("wql!: aggregate fn expects an argument (zero-argument user aggregates are not supported)"); return false; }
            if !reject_tuple(a.arg_expr(), "wql!: `aggregate`") { return false; }
            if !check_calls(a.arg_expr(), t, "wql!: `aggregate`") { return false; }
            let ae_opt: SExpr = simplify_sexpr(a.arg_expr(), h).any().view::<SExpr>();
            // THE ARGUMENT MUST REACH THE ACCUMULATOR (`check_agg_operand`), and
            // the simplified form is what is asked because that is what is
            // emitted one line below. Two spec shapes are exempt and both are
            // exempt BY THEIR EMITTER: a UDA's argument is printed into the
            // user's `_step`, whose declared T is the contract, and `avg` over an
            // argument THE RULE TABLE ADMITS but that is not already f64
            // (`agg_cast` — an int of any width, or a bool) is wrapped in
            // `as f64` by the fold emitter itself.
            //
            // ⚠ THE SECOND EXEMPTION IS ONLY SOUND BECAUSE `agg_cast` ASKS THE
            // TABLE. It used to mean "the argument is not a float", which is a
            // different set: it included `str`, for which the fold emitter's
            // `as f64` is not a conversion but the "unsupported cast" the
            // backend printed while returning 0. See `compute_agg_reprs`.
            //
            // ⚠ THE UDA EXEMPTION IS STILL UNCHECKED, AND IT IS NOT THE SAME
            // SEAM. Its argument is not emitted into an EL accumulator at all —
            // it is printed into the user's `_step`, and nothing here reads
            // `_step`'s declared param-1 type. MEASURED: an f32 argument against
            // an `i64` step reports `<metaprog-blob-subst>:NNNN: error [fn
            // q_run]: call to 'myag_step' arg 2: expected i64, got f32` — the
            // host compiler, from a generated line, rc=1, no object file. So it
            // is a BAD DIAGNOSTIC, not a soundness or exit-code defect, and it
            // is pinned as such by `wql_agg_uda_f32_arg_fail`. Closing it needs
            // a reflected `fn_param_type_name` and a ruling on whether this
            // check may refuse programs the host accepts today.
            // ⚠ AND THE ARGUMENT'S TYPE MUST BE IN THE LATTICE AT ALL, ASKED
            // FIRST AND SEPARATELY. Both branches below consult a rule table or
            // an emitted-type inference, and BOTH of those launder an unknown
            // type NAME into `EL_TY_INT` / `i64` before anyone can refuse it —
            // `el_ty_of_name`'s default arm and `infer_emit_ty`'s fallback. So a
            // struct-typed column arrived spelled `i64` at whichever of the two
            // it reached, and the only thing that refused it was the HOST
            // COMPILER, from a line inside the generated blob. `check_agg_arg_
            // in_lattice` asks `infer_ty_name`, whose unresolvable answer stays
            // unresolvable, and it runs ABOVE both routes because the defect was
            // in both. See wql_agg_avg_struct_arg_fail (skip route) and
            // wql_agg_sum_struct_arg_fail (laundering route).
            if !uda[ai] {
                if !check_agg_arg_in_lattice(ae_opt, t, a.fn_name, "wql!: `aggregate`") { return false; }
            }
            // ⚠⚠ AND IT IS EMITTED THROUGH THE SAME CAST THE CHECK ADMITTED IT
            // BY. `check_agg_operand` asks `el_int_widens(name, want)` — "does a
            // value of `name` reach the accumulator `want` unmoved" — and
            // `emit_norm_operand` WRITES `as want`.
            //
            // ⚠ THIS PARAGRAPH USED TO NAME `el_norm_cast` FOR BOTH HALVES, and
            // both halves were false once the accumulator stopped being the i64
            // representative: the question is no longer "which single cast does
            // this type get" but "does it reach THIS accumulator", and the answer
            // depends on the pair. The invariant the paragraph exists to state is
            // unchanged and is the point — rule and emitter read ONE function, so
            // they cannot disagree about which conversion exists. Rule and emitter therefore read one function and cannot
            // disagree about which conversion exists — which is exactly how the
            // two used to disagree: the check admitted only what the HOST widens
            // unwritten (`el_host_carries`, `bits < 64`) because this line wrote
            // nothing, so `isize` — signed, 64-bit, every value reaching `i64`
            // unmoved — was refused by a position that could have cast it, and
            // said so in its own diagnostic. It is `wql_agg_isize_arg_e2e` now.
            //
            // ⚠ THE TWO EXEMPT SHAPES KEEP THE VERBATIM EMISSION, AND MUST. A
            // UDA's argument goes to the user's `_step`, whose declared T is the
            // contract — normalizing it here would silently retype a user's
            // parameter. And `avg` over an admitted non-float argument
            // (`agg_cast`) has its own `as f64` written by the fold emitter; that
            // one is a GENUINE unsigned conversion for a `u64`/`u128` column and
            // is the reason `avg` answers correctly at widths `sum` refuses.
            // Wrapping it in `as i64` first would destroy exactly that.
            if !uda[ai] && !agg_cast[ai] {
                let want: str = accw[ai];
                if !check_agg_operand(ae_opt, t, want, a.fn_name, "wql!: `aggregate`") { return false; }
                emit_norm_operand(&mut agg_body[ai], ae_opt, t, var0, want);
            } else {
                emit_sexpr(&mut agg_body[ai], ae_opt, t, var0);
            }
        }
        ai = ai + 1i64;
    }
    return true;
}

// ── UDA resolution (user-defined aggregates — the naming-convention triple) ──
// `aggregate m = myagg(e.x)` with a NON-builtin fn name resolves against the
// trigger module's top-level fns by NAMING CONVENTION:
//   myagg_init() -> A                — accumulator creation (arity 0);
//   myagg_step(acc: A, x: T) -> A    — per-row fold (arity 2);
//   myagg_fin(acc: A) -> R           — OPTIONAL finalize (arity 1); absent ⇒ R = A.
// A (the accumulator type) is threaded VERBATIM through the generated code
// (any user type — struct accumulators included); only R must map into the EL
// lattice (`el_ret_class`; narrower ints widen `as i64`, f32 `as f64`). An
// R of `String` is REJECTED for now: aggregate outputs are materialized into
// group COLUMNS + rebound as locals, and a borrowed `str` view of an owned
// String column has no sound owner in that shape (deferred).
// All of this is METACALL-TIME data only — the IR keeps just `RAgg.fn_name`
// (queue-2: an interpreter re-resolves the same names against its registry).
// Outputs (parallel to the spec list): `uda` (is-UDA), `uda_fin` (has _fin),
// `uda_acc` (A, verbatim), `uda_ret` (R, verbatim), `aret` (R's EL class).
// False (error surfaced) on a convention violation.
fn resolve_aggs(view: &OView, aggs: &RAggArr, acount: i64,
                uda: &mut [bool; 8], uda_fin: &mut [bool; 8],
                uda_acc: &mut [str; 8], uda_ret: &mut [str; 8],
                aret: &mut [i32; 8]) -> bool {
    let mut i: i64 = 0i64;
    while i < acount {
        let a: RAgg = aggs.agg_at(i);
        let name: str = a.fn_name;
        if agg_of_name(name) != 0i32 {
            // Builtin aggregates SHADOW a same-named UDA triple.
            i = i + 1i64;
        } else {
            let mut nm_init: String = String::new();
            nm_init.push_str(name);
            nm_init.push_str("_init");
            let d_init: WAny = find_fn_decl(view, string_as_str(&nm_init));
            let mut nm_step: String = String::new();
            nm_step.push_str(name);
            nm_step.push_str("_step");
            let d_step: WAny = find_fn_decl(view, string_as_str(&nm_step));
            if d_init.is_null() || d_step.is_null() {
                let mut m: String = String::new();
                m.push_str("wql!: unknown aggregate '");
                m.push_str(name);
                m.push_str("' — builtin aggregates are count/sum/min/max/avg; a user aggregate requires top-level fns `");
                m.push_str(name);
                m.push_str("_init() -> A` and `");
                m.push_str(name);
                m.push_str("_step(acc: A, x: T) -> A` (plus optional `");
                m.push_str(name);
                m.push_str("_fin(acc: A) -> R`) declared in the module containing the query");
                if d_init.is_null() && !d_step.is_null() {
                    m.push_str(" (missing: `");
                    m.push_str(name);
                    m.push_str("_init`)");
                }
                if d_step.is_null() && !d_init.is_null() {
                    m.push_str(" (missing: `");
                    m.push_str(name);
                    m.push_str("_step`)");
                }
                error(string_as_str(&m));
                return false;
            }
            if fn_param_count(view, d_init) != 0i64 {
                let mut m1: String = String::new();
                m1.push_str("wql!: user aggregate '");
                m1.push_str(name);
                m1.push_str("': `");
                m1.push_str(name);
                m1.push_str("_init` must take no parameters (`");
                m1.push_str(name);
                m1.push_str("_init() -> A`)");
                error(string_as_str(&m1));
                return false;
            }
            let acc_ty: str = fn_ret_type_name(view, d_init);
            if acc_ty.len() == 0i64 {
                let mut m2: String = String::new();
                m2.push_str("wql!: user aggregate '");
                m2.push_str(name);
                m2.push_str("': `");
                m2.push_str(name);
                m2.push_str("_init` must declare a named accumulator return type (`-> A`)");
                error(string_as_str(&m2));
                return false;
            }
            if fn_param_count(view, d_step) != 2i64 {
                let mut m3: String = String::new();
                m3.push_str("wql!: user aggregate '");
                m3.push_str(name);
                m3.push_str("': `");
                m3.push_str(name);
                m3.push_str("_step` must take exactly (acc: A, x: T)");
                error(string_as_str(&m3));
                return false;
            }
            // Optional finalize: absent ⇒ R = A, no finalize call emitted.
            let mut nm_fin: String = String::new();
            nm_fin.push_str(name);
            nm_fin.push_str("_fin");
            let d_fin: WAny = find_fn_decl(view, string_as_str(&nm_fin));
            let mut has_fin: bool = false;
            let mut ret_ty: str = acc_ty;
            if !d_fin.is_null() {
                if fn_param_count(view, d_fin) != 1i64 {
                    let mut m4: String = String::new();
                    m4.push_str("wql!: user aggregate '");
                    m4.push_str(name);
                    m4.push_str("': `");
                    m4.push_str(name);
                    m4.push_str("_fin` must take exactly (acc: A)");
                    error(string_as_str(&m4));
                    return false;
                }
                has_fin = true;
                ret_ty = fn_ret_type_name(view, d_fin);
            }
            let cls: i32 = el_ret_class(ret_ty);
            if cls < 0i32 || str_eq(ret_ty, "String") {
                let mut m5: String = String::new();
                m5.push_str("wql!: user aggregate '");
                m5.push_str(name);
                m5.push_str("' result type `");
                m5.push_str(ret_ty);
                m5.push_str("` is outside the EL lattice — ");
                m5.push_str(name);
                if has_fin { m5.push_str("_fin"); } else { m5.push_str("_init (no _fin declared)"); }
                m5.push_str(" must return an integer, f64/f32, bool, or str value");
                error(string_as_str(&m5));
                return false;
            }
            if i < 8i64 {
                uda[i]     = true;
                uda_fin[i] = has_fin;
                uda_acc[i] = acc_ty;
                uda_ret[i] = ret_ty;
                aret[i]    = cls;
            }
            i = i + 1i64;
        }
    }
    return true;
}

// Per-aggregate finalized COLUMN type name (`act`): the Logos type of the
// aggregate's OUTPUT value — drives the materialized group-column Vecs, the
// finalize `let` bindings, and the group-row rebinds. Builtins keep the
// agg_flt-driven f64/i64 split; a UDA takes its reflected R class's lattice
// name (i64 / f64 / bool / str).
// ⚠ AN INTEGER COLUMN IS THE ACCUMULATOR'S TYPE, NOT "i64". The column is READ
// OUT OF the accumulator (`let #n_out: #act = #n_ga.get(__r0)`) and pushed into
// a `Vec<#act>`, so any answer here other than the cell's own type is a host
// type mismatch inside the generated blob. ⚠⚠ AND IT MUST BE THE TYPE AND NOT A
// CAST: `2^63 as i64` is negative, so casting the read instead of retyping the
// column would turn the answer `sum{2^62, 2^62} = 2^63` — the very value the
// widening exists to produce — back into a wrong number.
fn compute_agg_col_tys(acount: i64, agg_flt: &[bool; 8], uda: &[bool; 8],
                       aret: &[i32; 8], acc: &[str; 8], act: &mut [str; 8]) {
    let mut i: i64 = 0i64;
    while i < acount {
        if i < 8i64 {
            if uda[i] { act[i] = el_class_repr(aret[i]); }
            else if agg_flt[i] { act[i] = "f64"; }
            else { act[i] = acc[i]; }
        }
        i = i + 1i64;
    }
}

// The finalize-expression CAST TARGET for a UDA output: R narrower than the
// i64 lattice baseline widens to `i64`; an f32 R widens to `f64`; everything
// else needs none. Empty string = no cast.
// ⚠ This used to return the SUFFIX text (`" as i64)"`, closing a paren its
// caller had opened) — a half-expression that only made sense inside a
// particular concatenation. A fragment builder takes the TYPE and shapes the
// cast itself.
// ⚠ AND IT IS THE SAME RULE `codegen::emit_udf_call` APPLIES, which is why it is
// no longer written twice: a value is normalized exactly when its type is not the
// type the EL computes in (`el::el_norm_cast`). `col_ty` was never a second
// condition — it is `el_class_repr` of `ret_ty`'s own class by construction
// (`compute_agg_col_tys`), so testing it tested the consequent.
fn uda_fin_cast(ret_ty: str) -> str {
    return el_norm_cast(ret_ty);
}

// The finalize EXPRESSION for a UDA spec, over the accumulator fragment `acc`
// (a local name or a Vec-cell read): `<name>_fin(<acc>)` when the triple
// declares a finalizer, the bare accumulator otherwise — wrapped in the
// widening cast when R is narrower than its lattice column type.
fn uda_finalize_frag(name: str, acc: ExprBlob, has_fin: bool, cast_ty: str) -> ExprBlob {
    let mut e: ExprBlob = acc;
    if has_fin {
        let s_fin: String = suffixed(name, "_fin");
        let n_fin: Ident = Ident::new(string_as_str(&s_fin));
        e = quote_expr! { #n_fin(#(e)) };
    }
    if cast_ty.len() > 0i64 {
        let ct: ExprBlob = parse_type(cast_ty);
        e = quote_expr! { ((#(e)) as #(ct)) };
    }
    return e;
}

// ══════════════════════════════════════════════════════════════════════════
// PART 3 — REL blocks: named derived relations (slice B one-shot + slice C
// RECURSIVE semi-naïve fixpoint).
//
// A NON-recursive rel (singleton SCC, no self-edge) materializes as ONE
// emitted helper fn
//
//   fn __wql_<query>_rel_<NAME>(<wql! params verbatim>
//                               [, __rel_<dep>_sl: &[RowTy]]*) -> Vec<RowTy>
//
// with SET semantics: dedup on insert via a SHADOW HashSet<RowTy> (see
// emit_rel_push — O(1) membership; tuple rows hash through the per-arity
// tuple Hash impls in logos.lang.hash). Bodies run through
// the EXISTING scan / join-chain machinery (strategy cascade included); their
// projection PUSHES into the rel Vec instead of returning. Rel dependencies
// ride in as slices (the walker's dep masks — materialization follows the
// condensation topo order, so a dep is always ready first), and a rel body
// scans them exactly like a slice param.
//
// A RECURSIVE SCC materializes as ONE fn for the WHOLE component —
// `__wql_<query>_scc<c>` (see emit_scc_fn): member totals as `&mut Vec`
// out-params, per-member delta Vecs + shadow sets, seed bodies once, then the
// semi-naïve delta-variant loop to the least fixpoint.
//
// The ENTRY fn's prelude (built by the walker) materializes the SCCs in topo
// order and takes an `as_slice()` view per rel; entry scans then reference
// `__rel_<NAME>_sl`. Each body's loop nest is wrapped in its own `{ … }`
// block so per-step generated names (`__hm1`, `__j1`, …) cannot collide
// across bodies (or across the delta variants of one body).
// ══════════════════════════════════════════════════════════════════════════

// Build a JChain directly from an RQJoin PLAN node (the rel bodies skip the
// RExpr lowering — they are restricted to scan/join+where+select, so the plan
// node IS the chain description; row types were stamped by the walker).
fn jchain_from_plan(j: RQJoin, ch: &mut JChain) {
    ch.base_src = j.a_name;
    ch.base_ty  = j.a_ty;
    ch.base_var = j.x_var;
    let steps: RQJoinStepArr = j.steps_arr();
    let ns: i64 = steps.len();
    let mut i: i64 = 0i64;
    while i < ns {
        let st: RQJoinStep = steps.step_at(i);
        if ch.n < 8i64 {
            ch.src[ch.n]  = st.src_name;   // traversal steps: the walker-stamped field-path expr
            ch.ty[ch.n]   = st.row_ty;
            ch.var[ch.n]  = st.var_name;
            ch.anti[ch.n] = st.is_anti;
            ch.edge[ch.n]  = st.is_edge;
            ch.byval[ch.n] = st.is_edge && el_ret_class(st.row_ty) >= 0i32;
            if st.is_edge && !st.has_on { ch.onw[ch.n] = 0i64; }
            else                        { ch.onw[ch.n] = st.on.any().raw(); }
            ch.n = ch.n + 1i64;
        }
        i = i + 1i64;
    }
}

// Is `name` one of the body's bound row vars?
fn is_bound_var(name: str, vars: &[str; 9], nvars: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < nvars {
        if str_eq(vars[i], name) { return true; }
        i = i + 1i64;
    }
    return false;
}

// Validate a rel body's SELECT against the declared columns (rel `ri` in the
// registry): width (tuple of exactly ncols / single expr for a 1-column rel),
// per-component TYPE equality with the declared column type, no whole-row
// (bare row-var) components, no owned-String components (a str column stores
// a borrowed view; the call's String temporary would dangle). Errors are
// NAMED per rel/column. Returns false with the error surfaced.
fn rel_select_ok(proj: SExpr, ri: i64, prm: &MacroParams, view: &OView, t: &ElTypes,
                 vars: &[str; 9], nvars: i64) -> bool {
    let rel_name: str = prm.rel_names[ri];
    let nc: i64  = prm.rel_ccnt[ri];
    let off: i64 = prm.rel_coff[ri];
    if nc >= 2i64 {
        match proj {
            SExpr::Tuple(tp) => {
                let items: SExprArr = tp.items_arr();
                if items.len() != nc {
                    let mut m: String = String::new();
                    m.push_str("wql!: rel '");
                    m.push_str(rel_name);
                    m.push_str("': select tuple width ");
                    m.push_i64(items.len());
                    m.push_str(" does not match the declared column count ");
                    m.push_i64(nc);
                    error(string_as_str(&m));
                    return false;
                }
                let mut k: i64 = 0i64;
                while k < nc {
                    let comp: SExpr = items.arg_at(k);
                    if !rel_select_comp_ok(comp, rel_name, prm.relc_name[off + k],
                                           prm.relc_ty[off + k], view, t, vars, nvars) { return false; }
                    k = k + 1i64;
                }
            }
            _ => {
                let mut m2: String = String::new();
                m2.push_str("wql!: rel '");
                m2.push_str(rel_name);
                m2.push_str("' declares ");
                m2.push_i64(nc);
                m2.push_str(" columns — the body select must be a tuple of exactly that many components");
                error(string_as_str(&m2));
                return false;
            }
        }
        return true;
    }
    // 1-column rel: a single (non-tuple) expression.
    if is_tuple_root(proj) {
        let mut m3: String = String::new();
        m3.push_str("wql!: rel '");
        m3.push_str(rel_name);
        m3.push_str("' declares 1 column — the body select must be a single expression (`(e)` is grouping, not a 1-tuple)");
        error(string_as_str(&m3));
        return false;
    }
    return rel_select_comp_ok(proj, rel_name, prm.relc_name[off],
                              prm.relc_ty[off], view, t, vars, nvars);
}

// One select component vs its declared column: whole-row / String / type.
fn rel_select_comp_ok(comp: SExpr, rel_name: str, col_name: str, col_ty: str,
                      view: &OView, t: &ElTypes, vars: &[str; 9], nvars: i64) -> bool {
    let rn: str = root_ident_name(comp);
    if rn.len() > 0i64 && is_bound_var(rn, vars, nvars) {
        let mut m: String = String::new();
        m.push_str("wql!: rel '");
        m.push_str(rel_name);
        m.push_str("': select projects the whole row var `");
        m.push_str(rn);
        m.push_str("` — project explicit columns/fields (e.g. `select (");
        m.push_str(rn);
        m.push_str(".a, ");
        m.push_str(rn);
        m.push_str(".b)`)");
        error(string_as_str(&m));
        return false;
    }
    if returns_string(comp, t) {
        let mut m1: String = String::new();
        m1.push_str("wql!: rel '");
        m1.push_str(rel_name);
        m1.push_str("' column '");
        m1.push_str(col_name);
        m1.push_str("': an owned-String-returning expression cannot feed a rel column (str columns store borrowed views)");
        error(string_as_str(&m1));
        return false;
    }
    let got: i32  = infer_ty(comp, t);
    // ⚠ THE DECLARED COLUMN TYPE IS A SPELLING, and `infer_ty` answers from an
    // `ElTypes` whose names went through `resolve_alias_name` at stamping time — so
    // comparing the two without resolving this one compares a resolved answer with
    // an unresolved question. `type Ratio = f64;` on a column would take
    // `el_ty_of_name`'s INT default and admit an i64 component.
    let want: i32 = el_ty_of_name(resolve_alias_name(view, col_ty));
    if got != want {
        let mut m2: String = String::new();
        m2.push_str("wql!: rel '");
        m2.push_str(rel_name);
        m2.push_str("' column '");
        m2.push_str(col_name);
        m2.push_str("': select component has type ");
        m2.push_str(el_class_repr(got));
        m2.push_str(", declared ");
        m2.push_str(col_ty);
        error(string_as_str(&m2));
        return false;
    }
    return true;
}

// The set-dedup push (Datalog SET semantics): bind the projected row, probe
// the SHADOW HashSet through `__rsp` — insert returns true only for a NEW
// row, gating the `__out` push. O(1) amortized per insert; tuple rows hash
// via the per-arity `impl Hash for (…)` in logos.lang.hash, scalar rows
// (i64/str/bool) via their primitive impls. (f64 columns are rejected up
// front — set semantics require Eq.) `__out`/`__rsp` bind CONTEXTUALLY: the
// one-shot helper fn declares them over its result Vec; the semi-naïve SCC
// driver lexically rebinds them per member block onto that member's
// next-delta Vec + shadow set (which is total ∪ next-delta — exactly the
// "new w.r.t. the total" probe semi-naïve needs).
fn rel_push_frag(row_ty: str, proj: ExprBlob) -> ExprBlob {
    let rt: ExprBlob = parse_type(row_ty);
    return quote_block! {
        let __rv: #(rt) = (#(proj));
        if unsafe { __rsp.insert(__rv) } { __out.push(__rv); }
    };
}

// The SEMILATTICE-ABSORB push (recursive min/max aggregation — the generalization
// of the set-insert). A candidate `(key, arg)` is absorbed against the persistent
// per-key best-map `__bp_<rel>`: kept iff it STRICTLY improves the running best
// (`<` for min, `>` for max). The improvement gate IS the ⊓/⊔ meet/join — this is
// exactly why min/max are incrementalizable in a fixpoint and sum/count/avg are
// not (design §2). A NEW key seeds the best and records its key in `__keys_<rel>`
// (the distinct-key roster the post-loop materializes the argmin/argmax total
// from); an improved key overwrites the best. Every improvement pushes the row
// into `__out` (the round's improvement delta) — semi-naïve re-derivation.
fn rel_push_agg_frag(ri: i64, prm: &MacroParams,
                     key: ExprBlob, val: ExprBlob) -> ExprBlob {
    let rn:  str = prm.rel_names[ri];
    let off: i64 = prm.rel_coff[ri];
    let kty: ExprBlob = parse_type(prm.relc_ty[off]);
    let vty: ExprBlob = parse_type(prm.relc_ty[off + 1i64]);
    let vty2: ExprBlob = parse_type(prm.relc_ty[off + 1i64]);
    let s_bp: String = suffixed("__bp_", rn);   let n_bp: Ident = Ident::new(string_as_str(&s_bp));
    let s_ks: String = suffixed("__keys_", rn); let n_ks: Ident = Ident::new(string_as_str(&s_ks));
    let mut cmp: ExprBlob = quote_expr! { __av < *__cp };
    if prm.rel_agg_dir[ri] == AGG_MAX() { cmp = quote_expr! { __av > *__cp }; }
    return quote_block! {
        let __ak: #(kty) = (#(key));
        let __av: #(vty) = (#(val));
        unsafe {
            let __cp: *const #(vty2) = (#n_bp).get(&__ak);
            let mut __imp: bool = false;
            if __cp == (0i64 as *const #(vty2)) { __imp = true; #n_ks.push(__ak); }
            else { if #(cmp) { __imp = true; } }
            if __imp { (#n_bp).insert(__ak, __av); __out.push((__ak, __av)); }
        }
    };
}

// Emit the (key, arg) split of an aggregate MEMBER's body select tuple into the
// `key_out`/`val_out` strings, for the seed / plain-body absorb path. The select
// of an aggregate member is always `(key…, aggout)` (walker-validated against the
// two declared columns), so component 0 is the group key and component 1 the
// value the lattice folds. Returns false (error surfaced) if not a 2-tuple.
fn split_agg_proj(proj: SExpr, ri: i64, prm: &MacroParams, t: &ElTypes, var0: str,
                  key_out: &mut String, val_out: &mut String) -> bool {
    match proj {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            if items.len() != 2i64 {
                error("wql!: a recursive-aggregate rel select must be `(key, aggout)` — exactly two components (slice-1)");
                return false;
            }
            emit_sexpr(key_out, items.arg_at(0i64), t, var0);
            emit_sexpr(val_out, items.arg_at(1i64), t, var0);
            return true;
        }
        _ => {
            error("wql!: a recursive-aggregate rel select must be a `(key, aggout)` tuple (slice-1)");
            return false;
        }
    }
}

// One SIMPLE rel body: scan + optional where + dedup-push projection.
fn rel_body_simple_frag(s: RQSimple, ri: i64,
                        prm: &MacroParams, out: &mut ExprBlob, h: &Writ) -> bool {
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, s.row_ty, s.var_name);
    stamp_rel_source(&mut ty, &view, prm, s.src_name, s.var_name);
    apply_scalar_params(&mut ty, &view, prm);
    stamp_udfs_from_module(&view, &mut ty);

    let mut vars: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    vars[0] = s.var_name;

    let proj_opt: SExpr = simplify_sexpr(s.select_expr(), h).any().view::<SExpr>();
    if !check_calls(proj_opt, &ty, "wql!: rel `select`") { return false; }
    if !rel_select_ok(proj_opt, ri, prm, &view, &ty, &vars, 1i64) { return false; }
    // Aggregate MEMBER (recursive min/max): its bodies — including seed scans —
    // absorb `(key, val)` into the best-map, not the set shadow. Split the select
    // tuple into the two lattice operands.
    let is_agg: bool = prm.rel_is_agg[ri];
    let mut proj_body: String = String::new();
    let mut key_body: String = String::new();
    let mut val_body: String = String::new();
    if is_agg {
        if !split_agg_proj(proj_opt, ri, prm, &ty, s.var_name, &mut key_body, &mut val_body) { return false; }
    } else {
        emit_proj_value(&mut proj_body, proj_opt, &ty, s.var_name);
    }

    let mut pred_body: String = String::new();
    if s.has_where {
        let pe: SExpr = s.where_expr();
        if !reject_tuple(pe, "wql!: rel `where`") { return false; }
        if !check_calls(pe, &ty, "wql!: rel `where`") { return false; }
        let pe_opt: SExpr = simplify_sexpr(pe, h).any().view::<SExpr>();
        emit_sexpr(&mut pred_body, pe_opt, &ty, s.var_name);
    }

    // The body is a FRAGMENT: the caller collects one per rel body and splices
    // the run into its fn. ⚠ The braces stay — a rel body owns a SCOPE, so its
    // `__i` cannot collide with a sibling body's.
    let mut push_f: ExprBlob = quote_block! { };
    if is_agg {
        push_f = rel_push_agg_frag(ri, prm, parse_expr(string_as_str(&key_body)),
                                            parse_expr(string_as_str(&val_body)));
    } else {
        push_f = rel_push_frag(prm.rel_rowty[ri], parse_expr(string_as_str(&proj_body)));
    }
    if s.has_where {
        let pred_f: ExprBlob = parse_expr(string_as_str(&pred_body));
        push_f = quote_block! { if (#(pred_f)) #(push_f) };
    }
    let src_f: ExprBlob = parse_expr(s.src_name);
    let row_f: ExprBlob = parse_type(s.row_ty);
    let vnm:   Ident    = Ident::new(s.var_name);
    *out = quote_block! {
        {
            let mut __i: i64 = 0i64;
            while __i < (#(src_f)).len() {
                let #vnm: &#(row_f) = &(#(src_f))[__i];
                #(push_f);
                __i = __i + 1i64;
            }
        }
    };
    return true;
}

// ── jchain_from_aggr — a JChain over an aggregate body's base + join steps ──
// The recursive-aggregate body (`from rel x join edges e … group by … aggregate
// …`) has the SAME base-scan + join-step-fan-out shape as a join body; only the
// PUSH differs (lattice absorb vs set insert). Mirror jchain_from_plan.
fn jchain_from_aggr(g: RQAggr, ch: &mut JChain) {
    ch.base_src = g.a_name;
    ch.base_ty  = g.a_ty;
    ch.base_var = g.x_var;
    if !g.has_steps() { return; }
    let steps: RQJoinStepArr = g.steps_arr();
    let ns: i64 = steps.len();
    let mut i: i64 = 0i64;
    while i < ns {
        let st: RQJoinStep = steps.step_at(i);
        if ch.n < 8i64 {
            ch.src[ch.n]  = st.src_name;
            ch.ty[ch.n]   = st.row_ty;
            ch.var[ch.n]  = st.var_name;
            ch.anti[ch.n] = st.is_anti;
            ch.edge[ch.n]  = st.is_edge;
            ch.byval[ch.n] = st.is_edge && el_ret_class(st.row_ty) >= 0i32;
            if st.is_edge && !st.has_on { ch.onw[ch.n] = 0i64; }
            else                        { ch.onw[ch.n] = st.on.any().raw(); }
            ch.n = ch.n + 1i64;
        }
        i = i + 1i64;
    }
}

// One JOIN-CHAIN rel body: build phases + nested probes (the existing per-step
// strategy cascade — rel-sourced sides included) + optional where + dedup push.
fn rel_body_join_frag(j: RQJoin, ri: i64,
                      prm: &MacroParams, out: &mut ExprBlob, h: &Writ) -> bool {
    let mut ch: JChain = jchain_new();
    jchain_from_plan(j, &mut ch);
    let se: SExpr = j.select_expr();
    // A JOIN-shaped SEED of an aggregate member projects `(key, val)` — split it
    // so the absorb folds the two lattice operands (not the whole tuple twice).
    if prm.rel_is_agg[ri] {
        match se {
            SExpr::Tuple(tp) => {
                let items: SExprArr = tp.items_arr();
                if items.len() != 2i64 {
                    error("wql!: a recursive-aggregate rel body must project `(key, aggout)` — exactly two components (slice-1)");
                    return false;
                }
                return chain_body_frag(&ch, ri, prm, se, items.arg_at(0i64), items.arg_at(1i64),
                                       j.has_where, j.where_expr(), out, h);
            }
            _ => {
                error("wql!: a recursive-aggregate rel body must project a `(key, aggout)` tuple (slice-1)");
                return false;
            }
        }
    }
    return chain_body_frag(&ch, ri, prm, se, se, se,
                           j.has_where, j.where_expr(), out, h);
}

// One RECURSIVE-AGGREGATE rel body: same chain nest as a join body, but the inner
// push is the semilattice absorb over `(group-key, aggregate-arg)` into the
// best-map (min/max fixpoint). The surface `select (key, aggout)` is structural
// only — the emitted operands are the group KEY and the aggregate's ARG expr.
fn rel_body_agg_frag(g: RQAggr, ri: i64,
                     prm: &MacroParams, out: &mut ExprBlob, h: &Writ) -> bool {
    if !g.has_steps() {
        error("wql!: a recursive-aggregate rel body must JOIN the rel with an edge/relation slice (e.g. `from dist x join edges e on e.src == x.node …`) — a bare self-scan cannot propagate the fixpoint");
        return false;
    }
    let aggs: RQAggArr = g.aggs_arr();
    let a0: RQAgg = aggs.agg_at(0i64);
    if !a0.has_arg {
        error("wql!: a recursive min/max aggregate needs an argument (e.g. `min(x.d + e.w)`) — `count()` is a group aggregate and cannot recurse");
        return false;
    }
    let mut ch: JChain = jchain_new();
    jchain_from_aggr(g, &mut ch);
    let key_e: SExpr = g.key_expr();
    let val_e: SExpr = a0.arg_expr();
    let we: SExpr = if g.has_where { g.where_expr() } else { key_e };
    return chain_body_frag(&ch, ri, prm, key_e, key_e, val_e,
                           g.has_where, we, out, h);
}

// The shared CHAIN-BODY emitter (join bodies + recursive-aggregate bodies). For a
// non-aggregate member `proj_e` is the select projection (dedup-push); for an
// aggregate member (`prm.rel_is_agg[ri]`) `key_e`/`val_e` are the group key + the
// aggregate argument (semilattice absorb). `where_e` is valid only if `has_where`.
fn chain_body_frag(ch: &JChain, ri: i64, prm: &MacroParams,
                   proj_e: SExpr, key_e: SExpr, val_e: SExpr,
                   has_where: bool, where_e: SExpr, out: &mut ExprBlob, h: &Writ) -> bool {
    let is_agg: bool = prm.rel_is_agg[ri];
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, ch.base_ty, ch.base_var);
    stamp_rel_source(&mut ty, &view, prm, ch.base_src, ch.base_var);
    let mut si: i64 = 0i64;
    while si < ch.n {
        stamp_types_from_schema(&view, &mut ty, ch.ty[si], ch.var[si]);
        stamp_rel_source(&mut ty, &view, prm, ch.src[si], ch.var[si]);
        // Scalar-element traversal var: name → element value type (bare refs).
        // ⚠ THROUGH THE ALIAS TABLE. A traversal step's element type is a DECLARED
        // SPELLING off a field's type node, so `type Cel = f64;` reaches `el` as an
        // unknown name and takes its INT default — the same class of defect as the
        // element type of a source parameter (see `reflect::find_struct_decl`).
        if ch.byval[si] { ty.set_ty_named(ch.var[si], resolve_alias_name(&view, ch.ty[si])); }
        si = si + 1i64;
    }
    apply_scalar_params(&mut ty, &view, prm);
    stamp_udfs_from_module(&view, &mut ty);

    // The whole-row-projection gate's var set. SCALAR-element traversal vars
    // (byval) are EXCLUDED: they bind a scalar VALUE (Vec<i64> → i64), which
    // is a legitimate select component — only struct/tuple ROWS are barred.
    let mut vars: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    vars[0] = ch.base_var;
    let mut nv: i64 = 1i64;
    let mut vi: i64 = 0i64;
    while vi < ch.n {
        if nv < 9i64 && !ch.byval[vi] { vars[nv] = ch.var[vi]; nv = nv + 1i64; }
        vi = vi + 1i64;
    }

    // Clause validation + push-operand emission (select / key+arg / where).
    let mut proj_body: String = String::new();
    let mut key_body: String = String::new();
    let mut val_body: String = String::new();
    if is_agg {
        // Recursive-aggregate: the value column carries an ORDER (the lattice); a
        // single-key group (slice-1).
        //
        // ⚠ THE ORDER REQUIREMENT IS NOT CHECKED HERE ANY MORE, AND THAT IS A
        // DELETION, NOT AN OMISSION. This site used to ask `el_total_order_name`
        // about the value column's type, described as "the same question the
        // join-order licence asks". It is the same question — and this caller
        // CANNOT ASK IT: a recursive aggregate lives in a BODY-DECLARED rel, and
        // every body-declared rel column has already been through
        // `plan_walker::rel_col_ty_ok`, whose admitted set is exactly i64 / str /
        // bool — derived now (`el::el_set_col_admit`: a set column needs an
        // identity and must be the type the EL computes in), not listed. So
        // `vcty` is one of three names here, all of them faithfully
        // ordered, and the guard could not fire on any input. A guard that cannot
        // fire while its comment says it protects you is worse than no guard: it is
        // a claim nobody can check. The live decision about this column's order is
        // `rel_col_ty_ok` (which refuses f64 for the neighbouring Eq reason and
        // everything else by whitelist, both with named diagnostics and both
        // pinned by fixtures) plus the i64 requirement below.
        //
        // ⚠ IF THAT WHITELIST EVER WIDENS — a u64 or f64 rel column — THE ORDER
        // QUESTION COMES BACK HERE, because a min/max fixpoint converges to the
        // extremum of whatever order the emitted comparison realizes: over a
        // PARTIAL comparison it has no least upper bound to converge to, and over a
        // u64 reinterpreted as i64 it converges to the wrong end. The answer to ask
        // then is `el::el_order_faithful` — the same one the join-order licence
        // asks, still in one place.
        //
        // What remains is the requirement this seam does own: the value column must
        // be i64. `str` is faithfully ordered and still out of slice-1, because the
        // emitted lattice join is the i64 baseline.
        let voff: i64 = prm.rel_coff[ri];
        let vcty: str = prm.relc_ty[voff + 1i64];
        if !str_eq(vcty, "i64") {
            error("wql!: a recursive min/max aggregate value column must be i64 (the ordered lattice; a str column is totally ordered but the emitted lattice join is the i64 baseline — out of slice-1)");
            return false;
        }
        let key_opt: SExpr = simplify_sexpr(key_e, h).any().view::<SExpr>();
        let val_opt: SExpr = simplify_sexpr(val_e, h).any().view::<SExpr>();
        if !reject_tuple(key_opt, "wql!: rel aggregate `group by`") { return false; }
        if !check_calls(key_opt, &ty, "wql!: rel aggregate `group by`") { return false; }
        if !check_calls(val_opt, &ty, "wql!: rel aggregate argument") { return false; }
        emit_sexpr(&mut key_body, key_opt, &ty, ch.base_var);
        emit_sexpr(&mut val_body, val_opt, &ty, ch.base_var);
    } else {
        let proj_opt: SExpr = simplify_sexpr(proj_e, h).any().view::<SExpr>();
        if !check_calls(proj_opt, &ty, "wql!: rel `select`") { return false; }
        if !rel_select_ok(proj_opt, ri, prm, &view, &ty, &vars, nv) { return false; }
        emit_proj_value(&mut proj_body, proj_opt, &ty, ch.base_var);
    }
    let mut where_body: String = String::new();
    if has_where {
        let we: SExpr = where_e;
        if !reject_tuple(we, "wql!: rel `where`") { return false; }
        if !check_calls(we, &ty, "wql!: rel `where`") { return false; }
        let we_opt: SExpr = simplify_sexpr(we, h).any().view::<SExpr>();
        emit_sexpr(&mut where_body, we_opt, &ty, ch.base_var);
    }
    let mut ci0: i64 = 0i64;
    while ci0 < ch.n {
        if ch.onw[ci0] != 0i64 {
            let on_e: SExpr = sexpr_of_word(ch.onw[ci0]);
            if !reject_tuple(on_e, "wql!: rel `on`") { return false; }
            if !check_calls(on_e, &ty, "wql!: rel `on`") { return false; }
        }
        ci0 = ci0 + 1i64;
    }

    // Per-step strategy analysis (the same cascade as the query join shape).
    let mut st_build: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_probe: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_resid: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_pred:  [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_strat:  [i32; 8]  = [0i32; 8];
    let mut st_ktn:    [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut st_hasres: [bool; 8] = [false; 8];
    let mut st_equi:   [bool; 8] = [false; 8];
    let mut st_stream: [bool; 8] = [false; 8];
    if !analyze_chain(ch, &ty, ch.base_var, h, prm,
                      &mut st_build, &mut st_probe, &mut st_resid, &mut st_pred,
                      &mut st_strat, &mut st_ktn, &mut st_hasres, &mut st_equi,
                      &mut st_stream) { return false; }

    // The body block: builds + nest + shared inner push. A FRAGMENT — the
    // caller collects one per rel body and splices the run into its fn.
    //
    // ⚠ The nest is built INSIDE-OUT by `step_wrap`; the open/close pair and
    // the level counter it threaded are gone (see emit_join_chain). The braces
    // stay because a rel body owns a SCOPE — its `__i0` must not collide with
    // a sibling body's.
    //
    // ⚠ The `// join strategy: …` trace line is GONE — see emit_join_chain.
    let mut push_f: ExprBlob = quote_block! { };
    if is_agg {
        push_f = rel_push_agg_frag(ri, prm, parse_expr(string_as_str(&key_body)),
                                            parse_expr(string_as_str(&val_body)));
    } else {
        push_f = rel_push_frag(prm.rel_rowty[ri], parse_expr(string_as_str(&proj_body)));
    }
    if has_where {
        let where_f: ExprBlob = parse_expr(string_as_str(&where_body));
        push_f = quote_block! { if (#(where_f)) #(push_f) };
    }
    let no_lim: ExprBlob = parse_expr("0i64");
    let mut ki: i64 = ch.n - 1i64;
    while ki >= 0i64 {
        push_f = step_wrap(push_f, ki + 1i64, st_strat[ki], ch.anti[ki],
                           st_hasres[ki], st_ktn[ki], ch.src[ki], ch.ty[ki],
                           ch.var[ki], ch.byval[ki], string_as_str(&st_probe[ki]),
                           string_as_str(&st_resid[ki]), string_as_str(&st_pred[ki]),
                           no_lim, false, st_stream[ki]);
        ki = ki - 1i64;
    }
    let mut bps: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut bpi: i64 = 0i64;
    while bpi < ch.n {
        bps.push(build_phase_frag(bpi + 1i64, st_strat[bpi], ch.anti[bpi], st_hasres[bpi],
                                  st_ktn[bpi], ch.src[bpi], ch.ty[bpi], ch.var[bpi],
                                  string_as_str(&st_build[bpi]), st_stream[bpi]));
        bpi = bpi + 1i64;
    }
    let base_src_f: ExprBlob = parse_expr(ch.base_src);
    let base_ty_f:  ExprBlob = parse_type(ch.base_ty);
    let base_vnm:   Ident    = Ident::new(ch.base_var);
    *out = quote_block! {
        {
            #( #bps; )*
            let mut __i0: i64 = 0i64;
            while __i0 < (#(base_src_f)).len() {
                let #base_vnm: &#(base_ty_f) = &(#(base_src_f))[__i0];
                #(push_f);
                __i0 = __i0 + 1i64;
            }
        }
    };
    return true;
}

// Emit the extra `, __rel_<j>_sl: &[RowJ]` PARAMS selected by `mask` (ascending
// rel index) — the helper-fn dependency-slice parameters; the walker's prelude
// builds the matching call-argument list from the SAME masks (plan_walker::
// push_call_args), so signature and call site cannot drift.
// It appends to the PARAM-LIST text, not to an item buffer: the rel fns are
// quotes now, and their parameter list is one string the shell parses.
fn push_dep_params(out: &mut String, prm: &MacroParams, mask: i64) {
    let mut j: i64 = 0i64;
    while j < prm.rel_n {
        if (mask & (1i64 << j)) != 0i64 {
            out.push_str(", ");
            out.push_str(prm.rel_srcs[j]);
            out.push_str(": &[");
            out.push_str(prm.rel_rowty[j]);
            out.push_str("]");
        }
        j = j + 1i64;
    }
}

// Emit one rel body (fat-wrapped per shape — the emitters read edge methods
// and the SCC driver rewrites src_name fields, both of which want the
// allocator-carrying view). Shared by the one-shot path and the SCC driver.
fn rel_body_frag(body_any: WAny, ri: i64,
                 prm: &MacroParams, out: &mut ExprBlob, h: &Writ) -> bool {
    let q: RQuery = body_any.view::<RQuery>();
    match q {
        RQuery::Simple(_) => {
            return rel_body_simple_frag(rq_fat_simple(body_any, h), ri, prm, out, h);
        }
        RQuery::Join(_) => {
            return rel_body_join_frag(rq_fat_join(body_any, h), ri, prm, out, h);
        }
        RQuery::Aggr(_) => {
            // Only reachable for a FINALIZED recursive-aggregate member (the
            // walker's stratification check sets rel_is_agg); any other aggregate
            // body was rejected there.
            if prm.rel_is_agg[ri] {
                return rel_body_agg_frag(rq_fat_aggr(body_any, h), ri, prm, out, h);
            }
            error("wql!: rel body must be a scan or join query (from/join/where/select)");
            return false;
        }
        _ => {
            // Unreachable — the walker rejects find bodies.
            error("wql!: rel body must be a scan or join query (from/join/where/select)");
            return false;
        }
    }
}

// ── ONE-SHOT rel fn (singleton SCC, no self-edge — the slice-B path) ─────────
// `fn __wql_<fn>_rel_<name>(<params verbatim>[, dep slices]) -> Vec<Row>`:
// out Vec + shadow HashSet (O(1) dedup membership, see emit_rel_push; the raw
// pointer rides alongside because HashSet's mutators take `*mut self`), then
// every body's loop nest, dedup-pushing into the shared pair.
fn emit_rel_fn_oneshot(rel: RQRel, ri: i64, fn_name: str,
                       params_text: str, prm: &MacroParams, scc: &RelScc,
                       h: &Writ) -> bool {
    let row_ty: str = prm.rel_rowty[ri];
    // ── the item is a QUOTE (ADR 0024 S5) ─────────────────────────────────
    // ⚠ The leading `-` is the PRIVATE marker `vis_is_priv` reads: a rel helper
    // is not part of the resource's surface, and the shell decides `fn` vs
    // `pub fn` from the name it is handed. Writing `"fn "` by hand is what that
    // marker exists to replace.
    let mut hn: String = String::new();
    hn.push_str("-__wql_");
    hn.push_str(vis_strip(fn_name));
    hn.push_str("_rel_");
    hn.push_str(prm.rel_names[ri]);
    // The dependency slices are PARAMS, so they join the param-list text.
    let mut ps: String = String::new();
    ps.push_str(params_text);
    push_dep_params(&mut ps, prm, scc.dep_mask[ri]);
    let mut rty: String = String::new();
    rty.push_str("Result<Vec<");
    rty.push_str(row_ty);
    rty.push_str(">, ElError>");
    // ── the BODY is a QUOTE too (ADR 0024 S5) ─────────────────────────────
    let rt: ExprBlob  = parse_type(row_ty);
    let rt2: ExprBlob = parse_type(row_ty);
    let rt3: ExprBlob = parse_type(row_ty);
    let rt4: ExprBlob = parse_type(row_ty);
    let rt5: ExprBlob = parse_type(row_ty);
    let bodies: RQBodyArr = rel.bodies_arr();
    let nbod: i64 = bodies.len();
    let mut runs: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut b: i64 = 0i64;
    while b < nbod {
        let mut f: ExprBlob = quote_block! { };
        if !rel_body_frag(bodies.body_any(b), ri, prm, &mut f, h) { return false; }
        runs.push(f);
        b = b + 1i64;
    }
    let body_f: ExprBlob = quote_block! {
        let mut __out: Vec<#(rt)> = Vec::<#(rt2)>::new();
        let mut __rs: HashSet<#(rt3)> = hashset_new::<#(rt4)>();
        let __rsp: *mut HashSet<#(rt5)> = &mut __rs;
        #( #runs; )*
        return Result::Ok(__out);
    };
    emit_fn_quote_blob(hn.as_str(), ps.as_str(), prm.tparams, rty.as_str(), body_f, prm);
    return true;
}

// ── In-SCC source OCCURRENCES of one body (semi-naïve variant expansion) ─────
// `pos` = -1 for the base scan, else the join-step index; `rel` = the source's
// rel registry index. A body with ZERO occurrences is a SEED (runs once,
// before the loop); k occurrences ⇒ k delta variants per round — variant v
// reads occurrence v from the rel's DELTA slice and every other in-SCC
// occurrence from the TOTAL slice (the standard semi-naïve rewriting).
struct OccList { pos: [i64; 9], rel: [i64; 9], n: i64 }

fn occ_new() -> OccList { return OccList { pos: [0i64; 9], rel: [0i64; 9], n: 0i64 }; }

fn occ_push(o: &mut OccList, pos: i64, rel: i64) {
    if o.n >= 9i64 { return; }
    o.pos[o.n] = pos;
    o.rel[o.n] = rel;
    o.n = o.n + 1i64;
}

// Scan a (walker-rewritten) body for sources landing in SCC `c`.
fn body_scc_occs(body_any: WAny, prm: &MacroParams, scc: &RelScc, c: i64,
                 h: &Writ) -> OccList {
    let mut o: OccList = occ_new();
    let q: RQuery = body_any.view::<RQuery>();
    match q {
        RQuery::Simple(_) => {
            let s: RQSimple = rq_fat_simple(body_any, h);
            let ri: i64 = prm.rel_find_src(s.src_name);
            if ri >= 0i64 && scc.comp[ri] == c { occ_push(&mut o, -1i64, ri); }
        }
        RQuery::Join(_) => {
            let j: RQJoin = rq_fat_join(body_any, h);
            let ri0: i64 = prm.rel_find_src(j.a_name);
            if ri0 >= 0i64 && scc.comp[ri0] == c { occ_push(&mut o, -1i64, ri0); }
            let steps: RQJoinStepArr = j.steps_arr();
            let ns: i64 = steps.len();
            let mut i: i64 = 0i64;
            while i < ns {
                let st: RQJoinStep = rq_fat_step(steps.step_any(i), h);
                let ri1: i64 = prm.rel_find_src(st.src_name);
                if ri1 >= 0i64 && scc.comp[ri1] == c { occ_push(&mut o, i, ri1); }
                i = i + 1i64;
            }
        }
        RQuery::Aggr(_) => {
            // A recursive-aggregate body (min/max): its base + join-step sources
            // participate in the SCC exactly like a join body's — the self-ref to
            // the aggregate rel is the in-SCC occurrence the semi-naïve driver
            // binds to the improvement delta.
            let g: RQAggr = rq_fat_aggr(body_any, h);
            let rig: i64 = prm.rel_find_src(g.a_name);
            if rig >= 0i64 && scc.comp[rig] == c { occ_push(&mut o, -1i64, rig); }
            if g.has_steps() {
                let gsteps: RQJoinStepArr = g.steps_arr();
                let gns: i64 = gsteps.len();
                let mut gi: i64 = 0i64;
                while gi < gns {
                    let gst: RQJoinStep = rq_fat_step(gsteps.step_any(gi), h);
                    let rig1: i64 = prm.rel_find_src(gst.src_name);
                    if rig1 >= 0i64 && scc.comp[rig1] == c { occ_push(&mut o, gi, rig1); }
                    gi = gi + 1i64;
                }
            }
        }
        _ => { }
    }
    return o;
}

// Point occurrence `w` of a body at `name` (the total `__rel_<r>_sl` or delta
// `__dl_<r>_sl` slice) — the per-variant source rebinding. Fat views: a
// src_name write boxes the bytes into the arena.
fn set_occ_src(body_any: WAny, o: &OccList, w: i64, name: str, h: &Writ) {
    if o.pos[w] < 0i64 {
        let q: RQuery = body_any.view::<RQuery>();
        match q {
            RQuery::Simple(_) => { let s: RQSimple = rq_fat_simple(body_any, h); s.src_name = name; }
            RQuery::Join(_)   => { let j: RQJoin = rq_fat_join(body_any, h); j.a_name = name; }
            RQuery::Aggr(_)   => { let g: RQAggr = rq_fat_aggr(body_any, h); g.a_name = name; }
            _ => { }
        }
        return;
    }
    let q2: RQuery = body_any.view::<RQuery>();
    match q2 {
        RQuery::Aggr(_) => {
            let g2: RQAggr = rq_fat_aggr(body_any, h);
            let st2: RQJoinStep = rq_fat_step(g2.steps_arr().step_any(o.pos[w]), h);
            st2.src_name = name;
        }
        _ => {
            let j2: RQJoin = rq_fat_join(body_any, h);
            let st: RQJoinStep = rq_fat_step(j2.steps_arr().step_any(o.pos[w]), h);
            st.src_name = name;
        }
    }
}

// ── The SEMI-NAÏVE fixpoint fn — one per RECURSIVE SCC (slice C) ─────────────
// `fn __wql_<fn>_scc<c>(<params verbatim>[, dep slices], __tot_<m>: &mut
// Vec<RowM>, …)` — the member TOTAL Vecs are caller-owned out-params (the
// prelude declares them and takes the entry's `as_slice()` views after the
// call); per member the fn keeps a shadow HashSet `__rs_<m>` (= total ∪
// next-delta at all times — the O(1) membership emit_rel_push probes), the
// current delta `__dl_<m>` and the next delta `__nd_<m>`.
//
//   seed:  every body with NO in-SCC source runs once, dedup-pushing into
//          `__nd_<m>` (sources: params + earlier strata — fn params);
//   loop:  PROMOTE  — `__dl = __nd; __nd = fresh; total ∪= __dl` (the shadow
//          set already holds the rows, so the promote is a plain append);
//          EXIT     — every member delta empty ⇒ least fixpoint reached;
//          BIND     — `__rel_<m>_sl` = total slice, `__dl_<m>_sl` = delta
//          slice (fresh each round);
//          VARIANTS — every recursive body of every member runs once per
//          in-SCC occurrence, that occurrence's src_name TEMPORARILY rewritten
//          to the delta slice (the others read totals), new rows dedup-pushing
//          into `__nd_<m>` via the block-shadowed `__out`/`__rsp` pair.
//
// TERMINATION: guaranteed for non-generative programs (set semantics over a
// finite universe); recursive heads that MINT values (arithmetic) can diverge
// — the standard Datalog-with-arithmetic caveat, deliberately NOT capped.
// Body emitters are reused UNCHANGED: `__out`/`__rsp` are lexically rebound
// per member block, source slices per round/variant — the emission is
// parameterized by NAMES only.
// ══ THE CROSS-EPOCH MODE (`incr`), AND WHY IT IS A SECOND FN AND NOT A FLAG ══
//
// `incr == false` emits exactly what this fn has always emitted, BYTE FOR BYTE:
// the caller declares empty totals and the fixpoint runs from scratch. That is
// not a courtesy — it makes every existing rel query in the corpus a CONTROL on
// this change, so a regression anywhere in the rel tier is attributable.
//
// `incr == true` emits a SIBLING `__wql_<q>_scc<c>_i` whose caller hands it a
// total that ALREADY HOLDS the previous epoch's fixpoint, and which extends that
// total to the fixpoint over the accumulated input. Two things differ, and both
// are defects if omitted — each was derived from the body this fn already emits:
//
//  (1) THE SHADOW SET IS SEEDED FROM THE TOTAL. `__rs_<m>` is declared FRESH,
//      and `rel_push_frag`'s gate is `if __rsp.insert(row) { __out.push(row) }`
//      while `promote` appends `__dl` into `__tot` UNCONDITIONALLY. Re-entering
//      with a non-empty total and an empty set therefore re-admits every row the
//      previous epoch already derived and appends a SECOND COPY — and a rel is a
//      SET, so the answer is wrong on the first re-entry and compounds. Seeding
//      is O(|total|) per epoch, which is dominated by (2).
//
//  (2) ROUND 0 IS A FULL NAÏVE PASS, NOT A DELTA PASS, AND THAT IS A NAMED
//      CHOICE WITH A COST. The loop's variant expansion makes only IN-SCC
//      occurrences read a delta, because `body_scc_occs` records only sources
//      whose `comp` is this SCC. A new derivation can come from an OLD IDB row
//      joined with a NEW EDB row — `path(x,z) :- path(x,y), edge(y,z)` with an
//      old `path` and a new `edge` — and that combination has NO in-SCC delta
//      occurrence, so a from-empty-delta re-entry MISSES IT. The exact fix is a
//      round-0 variant per EDB occurrence binding that occurrence to the EDB
//      DELTA; the fix TAKEN here binds every occurrence to its FULL current
//      value and runs every body once. It is a SUPERSET of the exact set —
//      complete for the same reason, and safe because set semantics makes
//      over-derivation free (the seeded shadow set drops every row already in
//      the total). What it costs is one naïve pass over the accumulated input
//      per epoch instead of one pass over the delta. NOT MEASURED at any size,
//      and no number is quoted: the EDB-delta occurrence list is the named
//      follow-up, and it changes this fn only.
//
//      COMPLETENESS, since "generous" must not mean "hopeful". ⚠ THIS PROOF IS
//      STATED AS A HYPOTHESIS ITS CALLERS DISCHARGE, NOT AS A CLAIM ABOUT THE
//      INPUT, because THE INPUT NO LONGER ONLY GROWS. It used to read "let E' ⊇ E
//      be the accumulated input; T ⊆ lfp(E') by monotonicity" — and that premise
//      is FALSE for the second caller, whose input SHRINKS. A header that proves
//      the wrong theorem is worse than no header, so:
//
//        HYPOTHESIS.  Let T₀ be the total this fn is entered with and E' the
//        input it is handed. The induction below needs EXACTLY  T₀ ⊆ lfp(E')
//        and nothing else about how T₀ and E' are related.
//
//        DISCHARGE, CALLER 1 — INSERT (the epoch driver). T₀ = lfp(E) for the
//        previous input E, and E' = E ∪ (the epoch's new rows) ⊇ E. Then
//        T₀ = lfp(E) ⊆ lfp(E') by MONOTONICITY of the immediate-consequence
//        operator in its input. This is the old premise, now local to the caller
//        that actually has it.
//
//        DISCHARGE, CALLER 2 — DRed PHASE 3 (re-derive). E' = PRES = ALL ∖ DE,
//        which is a STRICT SUBSET of the input T₀'s ancestors were computed
//        over, so monotonicity says NOTHING here and citing it would be a
//        falsehood. What holds instead is the SURVIVOR LEMMA, and it comes
//        straight out of phase 1's specification of the over-delete set
//        (`emit_scc_od_fns`'s header):
//              OD = { f ∈ T : SOME derivation of f uses a row of DE }.
//        Contrapositive: f ∈ S = T ∖ OD ⇒ NO derivation of f uses a row of DE
//        ⇒ f has a derivation all of whose rows are in ALL ∖ DE = PRES ⇒
//        f ∈ lfp(PRES). Hence S ⊆ lfp(PRES), i.e. T₀ ⊆ lfp(E') with T₀ = S.
//        ⚠ The lemma is a property of PHASES 1 AND 2 TOGETHER — it fails the
//        moment phase 2 KEEPS a row it should have dropped, and phase 3 only
//        ADDS, so such a row is unrepairable forever. It is therefore asserted
//        as its own check by the phase-3 fixture (`S ⊆ closure(PRES)`, walked
//        row by row against an independent closure), not inferred from the
//        cardinality latches and not inferred from the final answer.
//
//        INDUCTION (unchanged, and input-monotonicity-free). Round 0 computes
//        F(T₀, E') and keeps what is not in T₀, so every fact derivable from
//        T₀-facts alone is found; every other fact of lfp(E') ∖ T₀ needs a fact
//        of some earlier round's delta and is found by the in-SCC delta
//        variants, by induction on rounds. The iteration is the standard one
//        from a LOWER BOUND of the fixpoint — and "lower bound" is precisely
//        what the hypothesis supplies, which is why nothing below it reads
//        E ⊆ E'.
//
//        ⚠ WHAT THE HYPOTHESIS DOES NOT BUY: soundness in the other direction.
//        `lfp(E') ⊇ T₀` says every entry row is still derivable; it does NOT say
//        the fn removes a row that ISN'T. This fn never removes anything. A
//        caller whose input shrank must have already deleted the unsupported
//        rows before entering — which is what phases 1+2 are.
//
// TERMINATION ON CYCLIC DATA IS THE SAME PROPERTY AND THE SAME MECHANISM: the
// shadow set gates every insert, so the deltas empty once the closure saturates.
// ⚠ NO WEIGHT ENTERS HERE. The only crossing into the SCC is `rel_push_frag`'s
// PRESENCE bit; there is no multiplicity vector beside `__tot_<m>` to carry one,
// which is what makes "weights may not flow into an SCC" structural rather than
// disciplinary — counting derivations through a cycle diverges.
fn emit_scc_fn(rels: RQRelArr, c: i64, fn_name: str,
               params_text: str, prm: &MacroParams, scc: &RelScc,
               incr: bool, h: &Writ) -> bool {
    // Members (declaration order) + the union out-of-SCC dep mask.
    let mut mem: [i64; 8] = [0i64; 8];
    let mut nm: i64 = 0i64;
    let mut mask: i64 = 0i64;
    let mut r: i64 = 0i64;
    while r < prm.rel_n {
        if scc.comp[r] == c {
            if nm < 8i64 { mem[nm] = r; nm = nm + 1i64; }
            mask = mask | scc.dep_mask[r];
        }
        r = r + 1i64;
    }
    // ── Signature (structure) ── the item is a QUOTE (ADR 0024 S5).
    // ⚠ Leading `-` = the PRIVATE marker `vis_is_priv` reads; the shell writes
    // `fn` vs `pub fn` from it. The member TOTAL out-params are PARAMS, so they
    // join the param-list text next to the dependency slices — one string, one
    // `parse_params`, instead of the fn's punctuation being interleaved with
    // the driver's state.
    let mut hn: String = String::new();
    hn.push_str("-__wql_");
    hn.push_str(vis_strip(fn_name));
    hn.push_str("_scc");
    hn.push_i64(c);
    if incr { hn.push_str("_i"); }
    let mut ps: String = String::new();
    ps.push_str(params_text);
    push_dep_params(&mut ps, prm, mask);
    let mut m0: i64 = 0i64;
    while m0 < nm {
        ps.push_str(", __tot_");
        ps.push_str(prm.rel_names[mem[m0]]);
        ps.push_str(": &mut Vec<");
        ps.push_str(prm.rel_rowty[mem[m0]]);
        ps.push_str(">");
        m0 = m0 + 1i64;
    }
    // ── the BODY is a QUOTE too (ADR 0024 S5) ─────────────────────────────
    // The semi-naïve driver's shape is a runtime value TWICE over: one state
    // block per SCC member, and one delta VARIANT per in-SCC source occurrence
    // per body. Both are Vec<ExprBlob> runs that splice flat.
    //
    // ── Per-member state ──
    // Plain (set-semantics) member: a shadow HashSet + current/next delta Vecs.
    // AGGREGATE member (recursive min/max): a best-per-key MAP + its raw pointer
    // (the map mutators take `*mut self`), a distinct-KEY roster (the post-loop
    // argmin/argmax materialization of the total), the improvement deltas, and a
    // round counter (the runtime convergence guard — termination is sacred).
    let mut state: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m1: i64 = 0i64;
    while m1 < nm {
        let rn: str = prm.rel_names[mem[m1]];
        let rt: ExprBlob  = parse_type(prm.rel_rowty[mem[m1]]);
        let rt2: ExprBlob = parse_type(prm.rel_rowty[mem[m1]]);
        let rt3: ExprBlob = parse_type(prm.rel_rowty[mem[m1]]);
        let rt4: ExprBlob = parse_type(prm.rel_rowty[mem[m1]]);
        let s_dl: String = suffixed("__dl_", rn);  let n_dl: Ident = Ident::new(string_as_str(&s_dl));
        let s_nd: String = suffixed("__nd_", rn);  let n_nd: Ident = Ident::new(string_as_str(&s_nd));
        if prm.rel_is_agg[mem[m1]] {
            let off: i64 = prm.rel_coff[mem[m1]];
            let kty:  ExprBlob = parse_type(prm.relc_ty[off]);
            let kty2: ExprBlob = parse_type(prm.relc_ty[off]);
            let kty3: ExprBlob = parse_type(prm.relc_ty[off]);
            let kty4: ExprBlob = parse_type(prm.relc_ty[off]);
            let kty5: ExprBlob = parse_type(prm.relc_ty[off]);
            let kty6: ExprBlob = parse_type(prm.relc_ty[off]);
            let vty:  ExprBlob = parse_type(prm.relc_ty[off + 1i64]);
            let vty2: ExprBlob = parse_type(prm.relc_ty[off + 1i64]);
            let vty3: ExprBlob = parse_type(prm.relc_ty[off + 1i64]);
            let vty4: ExprBlob = parse_type(prm.relc_ty[off + 1i64]);
            let s_be: String = suffixed("__best_", rn);   let n_be: Ident = Ident::new(string_as_str(&s_be));
            let s_bp: String = suffixed("__bp_", rn);     let n_bp: Ident = Ident::new(string_as_str(&s_bp));
            let s_ks: String = suffixed("__keys_", rn);   let n_ks: Ident = Ident::new(string_as_str(&s_ks));
            let s_ro: String = suffixed("__rounds_", rn); let n_ro: Ident = Ident::new(string_as_str(&s_ro));
            state.push(quote_block! {
                let mut #n_be: HashMap<#(kty), #(vty)> = hashmap_new::<#(kty2), #(vty2)>();
                let #n_bp: *mut HashMap<#(kty3), #(vty3)> = &mut #n_be;
                let mut #n_ks: Vec<#(kty4)> = Vec::<#(kty5)>::new();
                let mut #n_ro: i64 = 0i64;
                let mut #n_dl: Vec<#(rt)> = Vec::<#(rt2)>::new();
                let mut #n_nd: Vec<#(rt3)> = Vec::<#(rt4)>::new();
            });
        } else {
            let rt5: ExprBlob = parse_type(prm.rel_rowty[mem[m1]]);
            let rt6: ExprBlob = parse_type(prm.rel_rowty[mem[m1]]);
            let s_rs: String = suffixed("__rs_", rn);  let n_rs: Ident = Ident::new(string_as_str(&s_rs));
            if incr {
                // ⚠ SEEDED FROM THE TOTAL — see (1) in this fn's header. The set
                // is a fn LOCAL and stays one: keeping it on the HANDLE would
                // save this O(|total|) walk, but it would put a `HashSet` of the
                // whole relation beside the `Vec` of it, and the walk is
                // dominated by the naïve round-0 pass that follows anyway.
                let rt7: ExprBlob = parse_type(prm.rel_rowty[mem[m1]]);
                let s_tt1: String = suffixed("__tot_", rn); let n_tt1: Ident = Ident::new(string_as_str(&s_tt1));
                state.push(quote_block! {
                    let mut #n_rs: HashSet<#(rt5)> = hashset_new::<#(rt6)>();
                    {
                        let __sp: *mut HashSet<#(rt7)> = &mut #n_rs;
                        let mut __sk: i64 = 0i64;
                        while __sk < #n_tt1.len() {
                            unsafe { (__sp).insert(#n_tt1.get(__sk)); }
                            __sk = __sk + 1i64;
                        }
                    }
                    let mut #n_dl: Vec<#(rt)> = Vec::<#(rt2)>::new();
                    let mut #n_nd: Vec<#(rt3)> = Vec::<#(rt4)>::new();
                });
            } else {
                state.push(quote_block! {
                    let mut #n_rs: HashSet<#(rt5)> = hashset_new::<#(rt6)>();
                    let mut #n_dl: Vec<#(rt)> = Vec::<#(rt2)>::new();
                    let mut #n_nd: Vec<#(rt3)> = Vec::<#(rt4)>::new();
                });
            }
        }
        m1 = m1 + 1i64;
    }

    // ── Seeds: bodies with no in-SCC source, once, into __nd ──
    let mut seeds: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m2: i64 = 0i64;
    while m2 < nm {
        let ri: i64 = mem[m2];
        let bodies: RQBodyArr = rels.rel_at(ri).bodies_arr();
        let nb: i64 = bodies.len();
        let mut runs: Vec<ExprBlob> = vec_new::<ExprBlob>();
        let mut b1: i64 = 0i64;
        while b1 < nb {
            let oc1: OccList = body_scc_occs(bodies.body_any(b1), prm, scc, c, h);
            // FROM SCRATCH: a seed is a body with NO in-SCC source. CROSS-EPOCH:
            // EVERY body runs, at its canonical (total) source names — round 0 is
            // a full naïve pass, see (2) in this fn's header.
            if incr || oc1.n == 0i64 {
                let mut f: ExprBlob = quote_block! { };
                if !rel_body_frag(bodies.body_any(b1), ri, prm, &mut f, h) { return false; }
                runs.push(f);
            }
            b1 = b1 + 1i64;
        }
        if runs.len() > 0i64 { seeds.push(member_block_frag(runs, prm, ri)); }
        m2 = m2 + 1i64;
    }
    // ⚠ ROUND 0 IS ONE BLOCK, AND THE BRACES ARE THE POINT. Its bodies read the
    // member TOTALS through `__rel_<m>_sl`, an immutable view of a `&mut Vec`
    // param that the fixpoint loop below APPENDS to. Spliced flat, that view
    // would still be live across the loop; inside a block it dies before the
    // first `promote`. (The loop binds its own `__rel_<m>_sl` per round.)
    if incr && seeds.len() > 0i64 {
        let mut r0: Vec<ExprBlob> = vec_new::<ExprBlob>();
        let mut mb: i64 = 0i64;
        while mb < nm {
            let rnb: str = prm.rel_names[mem[mb]];
            if !prm.rel_is_agg[mem[mb]] {
                let rtb: ExprBlob = parse_type(prm.rel_rowty[mem[mb]]);
                let n_ssb: Ident = Ident::new(prm.rel_srcs[mem[mb]]);
                let s_ttb: String = suffixed("__tot_", rnb); let n_ttb: Ident = Ident::new(string_as_str(&s_ttb));
                r0.push(quote_block! { let #n_ssb: &[#(rtb)] = #n_ttb.as_slice(); });
            }
            mb = mb + 1i64;
        }
        let mut sk: i64 = 0i64;
        while sk < seeds.len() { r0.push(seeds.get(sk)); sk = sk + 1i64; }
        seeds = vec_new::<ExprBlob>();
        seeds.push(quote_block! { { #( #r0; )* } });
    }

    // ── The fixpoint loop ──
    // PROMOTE: dl ← nd, nd ← fresh, total ∪= dl (rows already in the set).
    let mut promote: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m3: i64 = 0i64;
    while m3 < nm {
        let rn3: str = prm.rel_names[mem[m3]];
        let rt3:  ExprBlob = parse_type(prm.rel_rowty[mem[m3]]);
        let rt3b: ExprBlob = parse_type(prm.rel_rowty[mem[m3]]);
        let s_dl: String = suffixed("__dl_", rn3);  let n_dl: Ident = Ident::new(string_as_str(&s_dl));
        let s_nd: String = suffixed("__nd_", rn3);  let n_nd: Ident = Ident::new(string_as_str(&s_nd));
        let s_tt: String = suffixed("__tot_", rn3); let n_tt: Ident = Ident::new(string_as_str(&s_tt));
        // Plain member: total ∪= dl (the shadow set already holds the rows). An
        // AGGREGATE member's total is the argmin/argmax MAP — materialized ONCE
        // after the fixpoint (the per-round best is the map, not an append-union),
        // so its promote is just the delta swap.
        if prm.rel_is_agg[mem[m3]] {
            promote.push(quote_block! {
                #n_dl = #n_nd;
                #n_nd = Vec::<#(rt3)>::new();
            });
        } else {
            promote.push(quote_block! {
                #n_dl = #n_nd;
                #n_nd = Vec::<#(rt3)>::new();
                {
                    let __ps: &[#(rt3b)] = #n_dl.as_slice();
                    let mut __pk: i64 = 0i64;
                    while __pk < __ps.len() {
                        #n_tt.push(__ps[__pk]);
                        __pk = __pk + 1i64;
                    }
                }
            });
        }
        m3 = m3 + 1i64;
    }
    // EXIT: all deltas empty ⇒ least fixpoint.
    let mut exitc: ExprBlob = parse_expr("true");
    let mut m4: i64 = 0i64;
    while m4 < nm {
        let s_dl: String = suffixed("__dl_", prm.rel_names[mem[m4]]);
        let n_dl: Ident = Ident::new(string_as_str(&s_dl));
        if m4 == 0i64 { exitc = quote_expr! { #n_dl.len() == 0i64 }; }
        else          { exitc = quote_expr! { #(exitc) && #n_dl.len() == 0i64 }; }
        m4 = m4 + 1i64;
    }
    // CONVERGENCE GUARD (aggregate members): a monotone min/max fixpoint over a
    // finite reachable key set converges in ≤ |keys|−1 improvement waves (each
    // wave extends the frontier by one hop; a shortest/widest path is simple).
    // A MINTING head (additive SSSP) over a NEGATIVE-weight cycle (min) / a
    // POSITIVE-weight cycle (max) has no least fixpoint and would improve
    // forever — capped generously (never false-fires on a valid graph; the
    // execution ABORTS with a diagnostic rather than hanging — termination is
    // sacred, design §5).
    let mut guard: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut mg: i64 = 0i64;
    while mg < nm {
        if prm.rel_is_agg[mem[mg]] {
            let rng: str = prm.rel_names[mem[mg]];
            let s_ro: String = suffixed("__rounds_", rng); let n_ro: Ident = Ident::new(string_as_str(&s_ro));
            let s_be: String = suffixed("__best_", rng);   let n_be: Ident = Ident::new(string_as_str(&s_be));
            // ⚠ The message names the rel, so it is a RUNTIME string literal —
            // `##m` reifies an Ident as one. Assembling `"…'" + rn + "'…"` as
            // text would have to escape its own quoting.
            let mut ms: String = String::new();
            ms.push_str("wql!: recursive aggregate '");
            ms.push_str(rng);
            ms.push_str("' did not converge — a negative-weight cycle (min) or positive-weight cycle (max) has no least fixpoint");
            let msg: Ident = Ident::new(string_as_str(&ms));
            guard.push(quote_block! {
                #n_ro = #n_ro + 1i64;
                if #n_ro > (#n_be.len() as i64) * 4i64 + 16i64 { logos.lang.panic::panic(##msg); }
            });
        }
        mg = mg + 1i64;
    }
    // BIND the round's slices. A plain member binds BOTH total + delta; an
    // AGGREGATE member's recursive body reads only the improvement DELTA (the
    // total is materialized post-loop), so bind the delta only.
    let mut binds: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m5: i64 = 0i64;
    while m5 < nm {
        let rn5: str = prm.rel_names[mem[m5]];
        let rt5:  ExprBlob = parse_type(prm.rel_rowty[mem[m5]]);
        let rt5b: ExprBlob = parse_type(prm.rel_rowty[mem[m5]]);
        let s_dl: String = suffixed("__dl_", rn5);  let n_dl: Ident = Ident::new(string_as_str(&s_dl));
        let s_tt: String = suffixed("__tot_", rn5); let n_tt: Ident = Ident::new(string_as_str(&s_tt));
        let n_ds: Ident = Ident::new(prm.rel_dsrcs[mem[m5]]);
        if prm.rel_is_agg[mem[m5]] {
            binds.push(quote_block! { let #n_ds: &[#(rt5)] = #n_dl.as_slice(); });
        } else {
            let n_ss: Ident = Ident::new(prm.rel_srcs[mem[m5]]);
            binds.push(quote_block! {
                let #n_ss: &[#(rt5)] = #n_tt.as_slice();
                let #n_ds: &[#(rt5b)] = #n_dl.as_slice();
            });
        }
        m5 = m5 + 1i64;
    }
    // VARIANTS: every recursive body × its in-SCC occurrences.
    let mut variants: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m6: i64 = 0i64;
    while m6 < nm {
        let ri6: i64 = mem[m6];
        let bodies6: RQBodyArr = rels.rel_at(ri6).bodies_arr();
        let nb6: i64 = bodies6.len();
        let mut runs6: Vec<ExprBlob> = vec_new::<ExprBlob>();
        let mut b3: i64 = 0i64;
        while b3 < nb6 {
            let body_any: WAny = bodies6.body_any(b3);
            let oc: OccList = body_scc_occs(body_any, prm, scc, c, h);
            if oc.n > 0i64 {
                let mut v: i64 = 0i64;
                while v < oc.n {
                    let mut w: i64 = 0i64;
                    while w < oc.n {
                        let nm_w: str = if w == v { prm.rel_dsrcs[oc.rel[w]] }
                                        else      { prm.rel_srcs[oc.rel[w]] };
                        set_occ_src(body_any, &oc, w, nm_w, h);
                        w = w + 1i64;
                    }
                    let mut f6: ExprBlob = quote_block! { };
                    if !rel_body_frag(body_any, ri6, prm, &mut f6, h) { return false; }
                    runs6.push(f6);
                    v = v + 1i64;
                }
                // Restore the canonical (total) source names.
                let mut w2: i64 = 0i64;
                while w2 < oc.n {
                    set_occ_src(body_any, &oc, w2, prm.rel_srcs[oc.rel[w2]], h);
                    w2 = w2 + 1i64;
                }
            }
            b3 = b3 + 1i64;
        }
        if runs6.len() > 0i64 { variants.push(member_block_frag(runs6, prm, ri6)); }
        m6 = m6 + 1i64;
    }
    // ── Materialize each AGGREGATE member's total = argmin/argmax per key ──
    // The fixpoint left the best value per key in the map; walk the distinct-key
    // roster and emit one `(key, best)` row into the caller's total Vec (the
    // entry/later strata scan its `as_slice()`, unchanged contract).
    let mut matz: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut mt: i64 = 0i64;
    while mt < nm {
        if prm.rel_is_agg[mem[mt]] {
            let rnt: str = prm.rel_names[mem[mt]];
            let offt: i64 = prm.rel_coff[mem[mt]];
            let ktyt: ExprBlob = parse_type(prm.relc_ty[offt]);
            let vtyt: ExprBlob = parse_type(prm.relc_ty[offt + 1i64]);
            let s_ks: String = suffixed("__keys_", rnt); let n_ks: Ident = Ident::new(string_as_str(&s_ks));
            let s_bp: String = suffixed("__bp_", rnt);   let n_bp: Ident = Ident::new(string_as_str(&s_bp));
            let s_tt: String = suffixed("__tot_", rnt);  let n_tt: Ident = Ident::new(string_as_str(&s_tt));
            matz.push(quote_block! {
                {
                    let mut __mk: i64 = 0i64;
                    while __mk < #n_ks.len() {
                        let __kk: #(ktyt) = #n_ks[__mk];
                        unsafe {
                            let __vp: *const #(vtyt) = (#n_bp).get(&__kk);
                            #n_tt.push((__kk, *__vp));
                        }
                        __mk = __mk + 1i64;
                    }
                }
            });
        }
        mt = mt + 1i64;
    }

    let body_f: ExprBlob = quote_block! {
        #( #state; )*
        #( #seeds; )*
        loop {
            #( #promote; )*
            if #(exitc) { break; }
            #( #guard; )*
            #( #binds; )*
            #( #variants; )*
        }
        #( #matz; )*
        return Result::Ok(());
    };
    emit_fn_quote_blob(hn.as_str(), ps.as_str(), prm.tparams, "Result<(), ElError>",
                       body_f, prm);
    return true;
}

// A member's push-target BLOCK: lexically rebind the body emitters' fixed
// `__out`/`__rsp` names onto THIS member's next-delta Vec + shadow set
// (sibling blocks scope-isolate the rebinding per member).
//
// An AGGREGATE member binds `__out` only — the semilattice absorb pushes
// improved rows there, and the best-map pointer `__bp_<rel>` + distinct-key
// roster `__keys_<rel>` are named per rel in the fn's state, so
// `rel_push_agg_frag` references them directly with no shadow-set rebind.
//
// ⚠ This was `emit_member_block_open`, which wrote `{` and left the caller to
// write the matching `}`. A fragment is a whole construct, so the block TAKES
// its contents.
fn member_block_frag(runs: Vec<ExprBlob>, prm: &MacroParams, ri: i64) -> ExprBlob {
    let rn: str = prm.rel_names[ri];
    let rt:  ExprBlob = parse_type(prm.rel_rowty[ri]);
    let rt2: ExprBlob = parse_type(prm.rel_rowty[ri]);
    let s_nd: String = suffixed("__nd_", rn); let n_nd: Ident = Ident::new(string_as_str(&s_nd));
    if prm.rel_is_agg[ri] {
        return quote_block! {
            {
                let __out: &mut Vec<#(rt)> = &mut #n_nd;
                #( #runs; )*
            }
        };
    }
    let s_rs: String = suffixed("__rs_", rn); let n_rs: Ident = Ident::new(string_as_str(&s_rs));
    return quote_block! {
        {
            let __out: &mut Vec<#(rt)> = &mut #n_nd;
            let __rsp: *mut HashSet<#(rt2)> = &mut #n_rs;
            #( #runs; )*
        }
    };
}

// ══ DRed PHASE 1 — THE OVER-DELETE SIBLINGS `_od` (seed) AND `_odp` (propagate)
//
// ── WHAT THIS IS, AND EXACTLY WHAT IT IS NOT ────────────────────────────────
// Retraction through a recursive `rel` is DELETE-AND-REDERIVE: (1) OVER-DELETE
// every fact that has ANY derivation through a retracted row, (2) COMPACT the
// total to `old ∖ OD`, (3) RE-DERIVE, which puts back exactly the facts with an
// alternative all-survivor derivation. THIS SLICE EMITS PHASE 1 AND NOTHING
// ELSE. There is no compact, no re-derive, no epoch body, and — deliberately —
// NO SURFACE CHANGE: `incr_retract_eligible` still refuses every rel-backed
// query, `<q>_apply` / `<q>_retract` / `__wd` are still not emitted for one, and
// `fail/wql_incr_rel_no_retract.logos` still pins that refusal. A caller cannot
// present a retraction to a recursive query today and that is unchanged here.
// What lands is the one piece of EMISSION phase 1 needs and nothing has: the
// over-delete driver, provable on its own against a from-scratch oracle.
//
// ── WHY IT IS TWO NEW FNS AND NOT A FLAG ON `_i` — MEASURED, NOT ASSUMED ────
// The interpreter (`stdlib/mem/deem/incr_rec.logos`, `fn dred`) gets phase 1 by
// switching a RUNTIME WRITE POINTER: `RelCtx` carries `rowsp`/`hmp` (read)
// beside `wr_rowsp`/`wr_hmp` (write) and `qrel_push_out` picks between them with
// an `if whm != 0`. THE EMITTED SIDE HAS NO SUCH INDIRECTION AT ALL, and that is
// not an oversight: `emit_scc_fn` is parameterized BY NAMES ONLY — the read
// slice is `#n_ss = __tot_<m>.as_slice()`, the write is `__out.push` / the
// promote's `__tot_<m>.push`, and `member_block_frag` LEXICALLY REBINDS `__out`
// and `__rsp`. Storage identity is fixed at emission by name. Putting a runtime
// `if` under every push to buy the redirect would tax the insert path forever
// for a retraction feature; emitting the split costs nothing at run time and is
// the same relationship `_i` already has to the from-scratch fn.
//
// ⚠ AND `_i` CANNOT SERVE AS PHASE 1b, WHICH THE PLAN FOR THIS SLICE ASSUMED IT
// COULD. The plan read phase 1b as "`_i` with `__tot := __od` and the EDB bound
// to PRES", because 1b is a fixpoint with read==write==od. It is not: `_i`'s
// round 0 runs EVERY body, BASE BODIES INCLUDED, so with the EDB bound to PRES
// it would inject every surviving base fact into OD. OD would become
// `closure(PRES) ∪ (the real over-delete set)`, phase 2 would then compact the
// relation to nothing, and phase 3 would recompute the whole closure from
// scratch — an answer that is still CORRECT and no longer INCREMENTAL, i.e. a
// defect no correctness oracle can see. The interpreter runs `rec_body` ONLY in
// its 1b loop; `_odp` is that loop, and the base bodies are the difference.
// ⚠ MEASURED, NOT ARGUED: run the base bodies in `_odp` too (the one edit that
// makes it behave like `_i`), drop the archives, rebuild the stdlib —
// `pass/wql_incr_rel_od_phase1.logos` exits 36 on the CHAIN cell, OD carrying
// the surviving base edges (1,2) and (3,4). Six rows where four are correct.
//
// ── THE TWO FNS ────────────────────────────────────────────────────────────
//  `__wql_<q>_scc<c>_od(<params = DE>, <dep slices>, __rd_<m>: &[Row]…,
//                       __od_<m>: &mut Vec<Row>…)`
//      PHASE 1a, ROUND 0 ONLY, NO LOOP. Every body of every member runs once
//      with the EDB params bound to the DELETED rows and every in-SCC source
//      bound to `__rd_<m>` — the PREVIOUS total, read-only. New rows land in a
//      FRESH per-member shadow set + next-delta and are appended to `__od_<m>`.
//      That is both of the interpreter's seed terms at once: the base bodies
//      give `base ⋈ DE`, and the recursive bodies reading the full previous
//      total give `existing-rel[0,ptot) ⋈ DE` — the term whose absence
//      UNDER-DELETES every fact derived THROUGH a deleted row rather than
//      directly FROM it.
//      ⚠ THE SHADOW SET IS FRESH, NOT SEEDED FROM `__rd`. It gates membership of
//      OD, which starts empty; seeding it from the previous total (the thing
//      `_i` must do) would gate every over-deleted row out and make OD empty.
//
//  `__wql_<q>_scc<c>_odp(<params = PRES>, <dep slices>, __od_<m>: &mut Vec<Row>)`
//      PHASE 1b. Semi-naive fixpoint with read==write==`__od_<m>`, EDB bound to
//      the SURVIVING rows, RECURSIVE BODIES ONLY (a body with no in-SCC
//      occurrence contributes nothing — propagation extends over-deleted facts
//      along survivor edges, it does not re-seed from the EDB). The initial
//      delta is the whole seed OD and the shadow set IS seeded from it.
//
// ── THE SPECIFICATION OF `OD`, WHICH IS NOT "THE ANSWER GOT SMALLER" ───────
// With T = the previous total = lfp(ALL), DE the retracted rows and PRES =
// ALL ∖ DE, phases 1a+1b compute
//
//     OD = { f ∈ T : SOME derivation of f uses a row of DE }
//
// and for transitive closure that is exactly the set of pairs joined by a walk
// through at least one deleted edge — decompose any such walk at its LAST
// deleted edge and the prefix is an arbitrary walk in ALL (= `__rd`), the edge
// is in DE (= 1a), and the suffix is all survivors (= 1b). OD is a SUPERSET of
// `closure(ALL) ∖ closure(PRES)` and the containment is STRICT whenever a fact
// has a second, surviving derivation — which is what makes phase 3 load-bearing
// rather than decorative, and is asserted as such in
// `pass/wql_incr_rel_od_phase1.logos` on a diamond.
//
// ══ DRed PHASE 2 — `_cpt`, THE COMPACT ═════════════════════════════════════
//  `__wql_<q>_scc<c>_cpt(__od_<m>: &[Row]…, __tot_<m>: &mut Vec<Row>…,
//                        __rm_<m>: &mut Vec<Row>…, __lat: &mut Vec<i64>)`
//      Replaces each member's total with `T ∖ OD`, IN PLACE, and hands back the
//      rows it removed (`OD ∩ T`, in T's order) in `__rm_<m>`.
//
// ── THE FORK, AND WHAT THE CHOICE COSTS ────────────────────────────────────
// The interpreter (`incr_rec.logos`, `fn dred`) REBUILDS: a fresh `new_rows`
// beside a fresh `new_rhm`, survivors copied cell by cell, then `self.rows =
// new_rows`. ⚠ ITS REASON DOES NOT TRANSFER, and that is the whole fork. `rhm`
// maps a row to a PACKED INDEX `(ni << 3) | ri` into a cell-flat `Vec<RtVal>`,
// so compacting in place would invalidate every entry the map holds; the map
// must be rebuilt whatever happens, and rebuilding the rows beside it is then
// free. THE EMITTED SIDE HAS NO INDEX-KEYED MAP: `__tot_<m>` is a `Vec<RowTy>`
// of typed rows and every shadow set in this file is keyed BY VALUE. The
// forcing constraint is absent, so the cheaper form is available and is taken:
// a write-index retain followed by `pop` to the write index. O(|T|) time, no
// second Vec, peak memory unchanged (the rebuild's is 2×|T| rows live at once).
//
// ⚠ AND THE PRICE, WHICH IS AN ORDER PROPERTY AND IS OBSERVABLE. `__tot_<m>` is
// in FIRST-DERIVATION order — round 0's rows, then round 1's, and so on — and a
// caller can see that order through a snapshot. Retain-in-place preserves the
// relative order OF THE SURVIVORS exactly, so after phase 2 the total is
// "first-derivation order with the over-deleted rows cut out". It is NOT
// "first-derivation order over the new input": a row that phase 3 later
// re-derives is APPENDED, so it lands after rows it originally preceded. That
// consequence is pinned by name in `pass/wql_incr_rel_od_phase1.logos`, on the
// chain and on the diamond, as an exact row SEQUENCE — not as a set — because
// the moment phase 3 exists there is no longer any way to tell which of the two
// phases moved a row.
//
// ── TWO PASSES, AND WHY THE SECOND ONE CANNOT FAIL ─────────────────────────
// `OD ⊆ T` is an INVARIANT, not a convenience: `_od`'s recursive bodies read
// `__rd` = T and so cannot leave it, but its BASE bodies read the deleted rows
// directly, so a caller that retracts a row IT NEVER INSERTED seeds OD with a
// fact the total never held. Nothing in the tree checks `DE ⊆ EDB` today (there
// is no retraction surface to check it at), so phase 2 is where the violation
// first becomes visible — as a survivor count that does not add up.
// `_cpt` therefore runs a READ-ONLY counting pass first and returns
// `ElError::RetractAbsent` from it, BEFORE a single row has moved. The compact
// is consequently TRANSACTIONAL BY CONSTRUCTION: on the refusing input the
// total is left byte-identical, in content AND in order, and there is no
// half-compacted state for anything downstream to inherit.
// COST: one extra O(|T|) scan per retraction, paid on every retraction whether
// or not it faults. The alternative — one pass, discovering the mismatch after
// `set` has already overwritten the front of the Vec — is CHEAPER AND
// UNRECOVERABLE, because the rows `set` overwrote are gone.
// ⚠ THE REFUSAL IS NOT A CHEAP ONE. It fires after phases 1a and 1b have run to
// their fixpoints over the whole graph and after a full scan of T, so the
// "total untouched" assertion in the fixture is made about a total that a
// one-pass implementation would already have destroyed.
//
// ── THE LATCHES, AND WHY THEY ARE AN OUT-PARAM AND NOT HANDLE FIELDS ───────
// An answer oracle is BLIND to this arc — measured twice: delete phase 1a's
// existing-rel⋈DE seed term and the diamond's final answer is byte-for-byte
// correct while OD, S and RD all move. So the INTERMEDIATE sets have to be
// assertable, which is what `incr_rec.logos`'s `od_last` / `cpt_n` / `rdv_n`
// latches do for the interpreter. `__lat` is their emitted counterpart: cleared
// on entry, then three i64 per member in SIGNATURE ORDER — |OD|, |S|, |RD|.
// ⚠ NOT HANDLE FIELDS, AND THE REASON IS AN ORDERING FACT RATHER THAN A TASTE.
// `emit_rel_fns` runs BEFORE the entry query is lowered (see its own note), so
// the rel tier does not know the handle struct exists and cannot name its type.
// Beyond that, there is no retract DRIVER in this slice: OD, S and RD are the
// CALLER's own locals here, so a handle field would be written by nobody and a
// reader would have to trust a dead field. When the driver lands it will hide
// these three quantities inside itself and they will have to move onto the
// handle at that point; `__lat` is the shape they will move in.
// ⚠ |OD| IS THE DISTINCT COUNT — `__os_<m>.len()`, not `__od_<m>.len()`. The
// two agree because `_od` and `_odp` both gate every push on a shadow set, and
// the latch reporting the SET's cardinality is what would make a regression in
// that gating visible here instead of silently inflating a count.
//
// ══ DRed PHASE 3 — RE-DERIVE. THERE IS NO FOURTH SIBLING, AND THAT IS THE
// ══ ANSWER, NOT AN OMISSION ════════════════════════════════════════════════
// PHASE 3 IS `_i`. Not "`_i` adapted", not "`_i`'s body copied" — the SAME
// emitted item `__wql_<q>_scc<c>_i`, re-entered with two substitutions:
//
//     __wql_<q>_scc<c>_i( <PRES, the survivor edb, where the epoch driver
//                          passes the accumulated edb>,
//                         &mut __tot_<m>  ← EXACTLY AS `_cpt` LEFT IT )
//
// and the epoch's re-derived rows are then the suffix `[__b0_<m> .. len)` with
// `__b0_<m>` captured AFTER `_cpt` returns, because `promote` only ever appends.
//
// ── `__tot := S`, NOT `__tot := ∅` ─────────────────────────────────────────
// ⚠ THE PLAN FOR THIS PHASE SAID "tot = 0, shadow set pre-populated with S",
// AND WRITING THAT WOULD BE A BUG HERE. In `_i` THE SHADOW SET AND THE TOTAL ARE
// THE SAME VARIABLE: the incr state block seeds a FRESH `__rs_<m>` by walking
// `__tot_<m>` element by element (see `emit_scc_fn`, the `if incr` state arm).
// `tot = 0` therefore means an EMPTY shadow set, which means every surviving
// fact is "new" and the whole closure is recomputed — right answer, zero
// incrementality, and no assertion about the ANSWER could ever see it.
// The interpreter's `rctx.tot[0] = 0` (`incr_rec.logos`) is a DIFFERENT
// MECHANISM and does not transfer: `dred`'s rows and its dedup map `rhm` are
// separate objects, so it can hold S in `rhm` while telling the driver the delta
// starts at 0. `_i` has no such split. The plan described `dred`'s data layout.
//
// ── WHY `_odp` NEEDED A SIBLING AND `_i` DOES NOT ──────────────────────────
// The two look symmetric and are not, and the asymmetry is the BASE bodies.
// `_odp`'s shadow set is OD and starts near-empty, so running `_i`'s round 0
// there would inject every surviving base fact INTO OD — the measured
// "1b re-seeding from the EDB" control, `pass/wql_incr_rel_od_phase1.logos`,
// exit 36. In phase 3 the shadow set is S, and a surviving base fact
// re-derivable from PRES is either ALREADY IN S (dropped by the dedup gate, for
// free) or was over-deleted and MUST come back. THE BASE BODIES ARE WANTED HERE
// AND POISON THERE, which is why one of the two reuses is legitimate.
//
// ── COMPLETENESS ──────────────────────────────────────────────────────────
// `_i` extends a total to the fixpoint over its input PROVIDED the total is a
// lower bound of that fixpoint. For an insert that is monotonicity; here the
// input SHRINKS and monotonicity is FALSE. The hypothesis is discharged instead
// by the SURVIVOR LEMMA `S = T ∖ OD ⊆ lfp(PRES)`, read off the OD spec above.
// The proof is written where it belongs — in `emit_scc_fn`'s header, restated as
// a hypothesis with one discharge per caller, because a header that proves the
// wrong theorem is worse than no header.
//
// ── ROUND 0 IS A FULL NAÏVE PASS AND PHASE 3 INHERITS THAT ─────────────────
// `_i`'s round 0 runs every body of every member at FULL slices, so a retraction
// costs one naïve pass over (PRES × S) before any delta round. The answer is
// right; the COST is the thing that is wrong, and it is invisible to every
// oracle in this arc — every assertion here is about a SET.
// ⚠ MEASURED 2026-08-08, UNSHARDED, box otherwise idle. Chain of n edges with
// the LAST edge retracted, so |RD| = 0 AT EVERY SIZE and a true delta pass would
// be FLAT in n. `_i` alone, best of four runs:
//        n=40   |S|=780     102 us     131 ns/surviving row
//        n=80   |S|=3160    412 us     130 ns/surviving row
//        n=160  |S|=12720  2008 us     158 ns/surviving row
// i.e. phase 3 is LINEAR IN |S| WHILE RE-DERIVING NOTHING — ~20x the work at 4x
// the relation, for zero rows of output. (Whole retraction, phases 1+2+3:
// 173 / 699 / 3101 us; the other phases are the same shape, each a scan of T.)
// ⚠ NOT GATED, and deliberately: a wall-clock assertion in the corpus is a flake
// generator. The number is recorded here and in the round's commit message.
// THE FOLLOW-UP is the EDB-delta occurrence list named in `emit_scc_fn`'s
// header, and it changes that fn only.
//
// ── OUT OF FENCE HERE, AND THE REFUSAL THAT KEEPS IT OUT ───────────────────
// THERE IS NO RETRACTION SURFACE AND NO EPOCH DRIVER. `incr_retract_eligible`
// still refuses every rel-backed query, `<q>_retract` / `<q>_apply` / `__wd`
// still do not exist for one, and `fail/wql_incr_rel_no_retract.logos` plus
// `fail/wql_incr_mutrec_no_retract_{odd,even}.logos` still pin that refusal —
// ALL THREE UNCHANGED IN THIS SLICE, deliberately and not by omission. They are
// NAME-ABSENT doors (they assert `tc_retract` / `oddq_retract` / `evenq_retract`
// do not exist), which is true under EVERY refusal that reaches the query, so
// they pin no particular ground; splitting them and replacing them with positive
// fixtures is the FIRST work of the surface round, and half-splitting them now
// would leave the tree with doors that pin even less. What pins the ground today
// is `logos_09_incr_mutrec_refusal` (`tier_commit`), also untouched.
// CONSEQUENCE: the `|RD| = -1` latch STAYS. Phase 3 exists as a call sequence a
// FIXTURE performs, not as anything the compiler emits, so no emitted code is in
// a position to fill that slot; see the `-1` push in `_cpt` for who retires it
// and when.
// ⚠ WHAT IS NOT DECIDED HERE: the ERROR CONTRACT for a retraction that faults
// PART WAY (transactional vs poisoned handle) is a contract about the DRIVER,
// and there is no driver. `_cpt`'s own refusal is transactional, which is the
// strongest of the two and forecloses nothing; a fault arising inside phase 3's
// arithmetic is a different question and is not answered by this slice.
//
// An AGGREGATE (lattice) member gets NO od siblings — the fn returns having
// emitted nothing the moment it sees one. Retraction of a recursive aggregate
// needs the interpreter's degrade-to-recompute, D4 (float `sum`/`avg`) is
// Victor's open decision, and neither is in this slice; the entry-side refusal
// (`incr_retract_eligible`) is what actually withholds the capability, and it
// stands untouched.
fn emit_scc_od_fns(rels: RQRelArr, c: i64, fn_name: str,
                   params_text: str, prm: &MacroParams, scc: &RelScc,
                   h: &Writ) -> bool {
    let mut mem: [i64; 8] = [0i64; 8];
    let mut nm: i64 = 0i64;
    let mut mask: i64 = 0i64;
    let mut r: i64 = 0i64;
    while r < prm.rel_n {
        if scc.comp[r] == c {
            // OUT OF FENCE — see the header. Nothing is emitted for an SCC with
            // a lattice member, so there is no half-built path to mistake for a
            // capability.
            if prm.rel_is_agg[r] { return true; }
            if nm < 8i64 { mem[nm] = r; nm = nm + 1i64; }
            mask = mask | scc.dep_mask[r];
        }
        r = r + 1i64;
    }

    // ══ PHASE 1a — `_od` ══════════════════════════════════════════════════
    let mut hn: String = String::new();
    hn.push_str("-__wql_");
    hn.push_str(vis_strip(fn_name));
    hn.push_str("_scc");
    hn.push_i64(c);
    hn.push_str("_od");
    let mut ps: String = String::new();
    ps.push_str(params_text);
    push_dep_params(&mut ps, prm, mask);
    let mut m0: i64 = 0i64;
    while m0 < nm {
        ps.push_str(", __rd_");
        ps.push_str(prm.rel_names[mem[m0]]);
        ps.push_str(": &[");
        ps.push_str(prm.rel_rowty[mem[m0]]);
        ps.push_str("]");
        m0 = m0 + 1i64;
    }
    let mut m0b: i64 = 0i64;
    while m0b < nm {
        ps.push_str(", __od_");
        ps.push_str(prm.rel_names[mem[m0b]]);
        ps.push_str(": &mut Vec<");
        ps.push_str(prm.rel_rowty[mem[m0b]]);
        ps.push_str(">");
        m0b = m0b + 1i64;
    }

    // State: a FRESH shadow set (OD starts empty — see the header) + next-delta.
    let mut state: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m1: i64 = 0i64;
    while m1 < nm {
        let rn: str = prm.rel_names[mem[m1]];
        let at1: ExprBlob = parse_type(prm.rel_rowty[mem[m1]]);
        let at2: ExprBlob = parse_type(prm.rel_rowty[mem[m1]]);
        let at3: ExprBlob = parse_type(prm.rel_rowty[mem[m1]]);
        let at4: ExprBlob = parse_type(prm.rel_rowty[mem[m1]]);
        let s_rs: String = suffixed("__rs_", rn); let n_rs: Ident = Ident::new(string_as_str(&s_rs));
        let s_nd: String = suffixed("__nd_", rn); let n_nd: Ident = Ident::new(string_as_str(&s_nd));
        state.push(quote_block! {
            let mut #n_rs: HashSet<#(at1)> = hashset_new::<#(at2)>();
            let mut #n_nd: Vec<#(at3)> = Vec::<#(at4)>::new();
        });
        m1 = m1 + 1i64;
    }
    // BIND every in-SCC source to the READ-ONLY previous total `__rd_<m>`.
    let mut binds: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m2: i64 = 0i64;
    while m2 < nm {
        let rnb: str = prm.rel_names[mem[m2]];
        let bt: ExprBlob = parse_type(prm.rel_rowty[mem[m2]]);
        let n_ss: Ident = Ident::new(prm.rel_srcs[mem[m2]]);
        let s_rd: String = suffixed("__rd_", rnb); let n_rd: Ident = Ident::new(string_as_str(&s_rd));
        binds.push(quote_block! { let #n_ss: &[#(bt)] = #n_rd; });
        m2 = m2 + 1i64;
    }
    // RUNS: every body of every member, once, at its canonical source names.
    let mut runs: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m3: i64 = 0i64;
    while m3 < nm {
        let ri: i64 = mem[m3];
        let bodies: RQBodyArr = rels.rel_at(ri).bodies_arr();
        let nb: i64 = bodies.len();
        let mut rr: Vec<ExprBlob> = vec_new::<ExprBlob>();
        let mut b1: i64 = 0i64;
        while b1 < nb {
            let mut f: ExprBlob = quote_block! { };
            if !rel_body_frag(bodies.body_any(b1), ri, prm, &mut f, h) { return false; }
            rr.push(f);
            b1 = b1 + 1i64;
        }
        if rr.len() > 0i64 { runs.push(member_block_frag(rr, prm, ri)); }
        m3 = m3 + 1i64;
    }
    // PROMOTE (once): append the seed rows into the caller's OD store.
    let mut prom: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m4: i64 = 0i64;
    while m4 < nm {
        let rnp: str = prm.rel_names[mem[m4]];
        let pt: ExprBlob = parse_type(prm.rel_rowty[mem[m4]]);
        let s_nd: String = suffixed("__nd_", rnp); let n_nd: Ident = Ident::new(string_as_str(&s_nd));
        let s_od: String = suffixed("__od_", rnp); let n_od: Ident = Ident::new(string_as_str(&s_od));
        prom.push(quote_block! {
            {
                let __ps: &[#(pt)] = #n_nd.as_slice();
                let mut __pk: i64 = 0i64;
                while __pk < __ps.len() {
                    #n_od.push(__ps[__pk]);
                    __pk = __pk + 1i64;
                }
            }
        });
        m4 = m4 + 1i64;
    }
    // ⚠ THE ROUND-0 BLOCK'S BRACES ARE THE POINT, exactly as in `emit_scc_fn`:
    // `__rd_<m>` is a `&[Row]` param so it does not alias `__od_<m>`, but the
    // per-member `__nd_<m>` is borrowed MUTABLY by `member_block_frag` and read
    // by the promote, so the runs live in their own scope.
    let od_body: ExprBlob = quote_block! {
        #( #state; )*
        {
            #( #binds; )*
            #( #runs; )*
        }
        #( #prom; )*
        return Result::Ok(());
    };
    emit_fn_quote_blob(hn.as_str(), ps.as_str(), prm.tparams, "Result<(), ElError>",
                       od_body, prm);

    // ══ PHASE 1b — `_odp` ═════════════════════════════════════════════════
    let mut pn: String = String::new();
    pn.push_str("-__wql_");
    pn.push_str(vis_strip(fn_name));
    pn.push_str("_scc");
    pn.push_i64(c);
    pn.push_str("_odp");
    let mut pps: String = String::new();
    pps.push_str(params_text);
    push_dep_params(&mut pps, prm, mask);
    let mut m5: i64 = 0i64;
    while m5 < nm {
        pps.push_str(", __od_");
        pps.push_str(prm.rel_names[mem[m5]]);
        pps.push_str(": &mut Vec<");
        pps.push_str(prm.rel_rowty[mem[m5]]);
        pps.push_str(">");
        m5 = m5 + 1i64;
    }
    // State: shadow set SEEDED from the seed OD (it is already in the store),
    // and the first delta IS that seed — the interpreter's `pctx.tot[0] = 0`
    // followed by a promote over `[0, len)`.
    let mut pstate: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m6: i64 = 0i64;
    while m6 < nm {
        let rn6: str = prm.rel_names[mem[m6]];
        let ct1: ExprBlob = parse_type(prm.rel_rowty[mem[m6]]);
        let ct2: ExprBlob = parse_type(prm.rel_rowty[mem[m6]]);
        let ct3: ExprBlob = parse_type(prm.rel_rowty[mem[m6]]);
        let ct4: ExprBlob = parse_type(prm.rel_rowty[mem[m6]]);
        let ct5: ExprBlob = parse_type(prm.rel_rowty[mem[m6]]);
        let ct6: ExprBlob = parse_type(prm.rel_rowty[mem[m6]]);
        let ct7: ExprBlob = parse_type(prm.rel_rowty[mem[m6]]);
        let s_rs: String = suffixed("__rs_", rn6); let n_rs: Ident = Ident::new(string_as_str(&s_rs));
        let s_dl: String = suffixed("__dl_", rn6); let n_dl: Ident = Ident::new(string_as_str(&s_dl));
        let s_nd: String = suffixed("__nd_", rn6); let n_nd: Ident = Ident::new(string_as_str(&s_nd));
        let s_od: String = suffixed("__od_", rn6); let n_od: Ident = Ident::new(string_as_str(&s_od));
        pstate.push(quote_block! {
            let mut #n_rs: HashSet<#(ct1)> = hashset_new::<#(ct2)>();
            let mut #n_dl: Vec<#(ct3)> = Vec::<#(ct4)>::new();
            let mut #n_nd: Vec<#(ct5)> = Vec::<#(ct6)>::new();
            {
                let __sp: *mut HashSet<#(ct7)> = &mut #n_rs;
                let mut __sk: i64 = 0i64;
                while __sk < #n_od.len() {
                    unsafe { (__sp).insert(#n_od.get(__sk)); }
                    #n_dl.push(#n_od.get(__sk));
                    __sk = __sk + 1i64;
                }
            }
        });
        m6 = m6 + 1i64;
    }
    // EXIT: every member's delta empty ⇒ the OD fixpoint is reached.
    let mut pexit: ExprBlob = parse_expr("true");
    let mut m7: i64 = 0i64;
    while m7 < nm {
        let s_dl: String = suffixed("__dl_", prm.rel_names[mem[m7]]);
        let n_dl: Ident = Ident::new(string_as_str(&s_dl));
        if m7 == 0i64 { pexit = quote_expr! { #n_dl.len() == 0i64 }; }
        else          { pexit = quote_expr! { #(pexit) && #n_dl.len() == 0i64 }; }
        m7 = m7 + 1i64;
    }
    // BIND: total = the OD store, delta = this round's OD delta.
    let mut pbinds: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m8: i64 = 0i64;
    while m8 < nm {
        let rn8: str = prm.rel_names[mem[m8]];
        let dt1: ExprBlob = parse_type(prm.rel_rowty[mem[m8]]);
        let dt2: ExprBlob = parse_type(prm.rel_rowty[mem[m8]]);
        let n_ss: Ident = Ident::new(prm.rel_srcs[mem[m8]]);
        let n_ds: Ident = Ident::new(prm.rel_dsrcs[mem[m8]]);
        let s_dl: String = suffixed("__dl_", rn8); let n_dl: Ident = Ident::new(string_as_str(&s_dl));
        let s_od: String = suffixed("__od_", rn8); let n_od: Ident = Ident::new(string_as_str(&s_od));
        pbinds.push(quote_block! {
            let #n_ss: &[#(dt1)] = #n_od.as_slice();
            let #n_ds: &[#(dt2)] = #n_dl.as_slice();
        });
        m8 = m8 + 1i64;
    }
    // VARIANTS: every RECURSIVE body × its in-SCC occurrences. A body with no
    // in-SCC occurrence is a base body and does NOT run here — see the header.
    let mut pvars: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut m9: i64 = 0i64;
    while m9 < nm {
        let ri9: i64 = mem[m9];
        let bodies9: RQBodyArr = rels.rel_at(ri9).bodies_arr();
        let nb9: i64 = bodies9.len();
        let mut runs9: Vec<ExprBlob> = vec_new::<ExprBlob>();
        let mut b9: i64 = 0i64;
        while b9 < nb9 {
            let body_any: WAny = bodies9.body_any(b9);
            let oc: OccList = body_scc_occs(body_any, prm, scc, c, h);
            if oc.n > 0i64 {
                let mut v: i64 = 0i64;
                while v < oc.n {
                    let mut w: i64 = 0i64;
                    while w < oc.n {
                        let nm_w: str = if w == v { prm.rel_dsrcs[oc.rel[w]] }
                                        else      { prm.rel_srcs[oc.rel[w]] };
                        set_occ_src(body_any, &oc, w, nm_w, h);
                        w = w + 1i64;
                    }
                    let mut f9: ExprBlob = quote_block! { };
                    if !rel_body_frag(body_any, ri9, prm, &mut f9, h) { return false; }
                    runs9.push(f9);
                    v = v + 1i64;
                }
                let mut w2: i64 = 0i64;
                while w2 < oc.n {
                    set_occ_src(body_any, &oc, w2, prm.rel_srcs[oc.rel[w2]], h);
                    w2 = w2 + 1i64;
                }
            }
            b9 = b9 + 1i64;
        }
        if runs9.len() > 0i64 { pvars.push(member_block_frag(runs9, prm, ri9)); }
        m9 = m9 + 1i64;
    }
    // PROMOTE: delta ← next-delta, OD ∪= delta (the shadow set already holds it).
    let mut pprom: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut ma: i64 = 0i64;
    while ma < nm {
        let rna: str = prm.rel_names[mem[ma]];
        let et1: ExprBlob = parse_type(prm.rel_rowty[mem[ma]]);
        let et2: ExprBlob = parse_type(prm.rel_rowty[mem[ma]]);
        let s_dl: String = suffixed("__dl_", rna); let n_dl: Ident = Ident::new(string_as_str(&s_dl));
        let s_nd: String = suffixed("__nd_", rna); let n_nd: Ident = Ident::new(string_as_str(&s_nd));
        let s_od: String = suffixed("__od_", rna); let n_od: Ident = Ident::new(string_as_str(&s_od));
        pprom.push(quote_block! {
            #n_dl = #n_nd;
            #n_nd = Vec::<#(et1)>::new();
            {
                let __qs: &[#(et2)] = #n_dl.as_slice();
                let mut __qk: i64 = 0i64;
                while __qk < __qs.len() {
                    #n_od.push(__qs[__qk]);
                    __qk = __qk + 1i64;
                }
            }
        });
        ma = ma + 1i64;
    }
    // ⚠ THE EXIT IS AT THE LOOP TOP AND THE PROMOTE AT THE BOTTOM, which is the
    // MIRROR of `emit_scc_fn` and forced by the same borrow fact from the other
    // side: here the seed delta is already in `__od_<m>` when the fn is entered,
    // so a promote-first loop would append it a second time. The binds/variants
    // therefore sit in their own block, so the `__od_<m>.as_slice()` view dies
    // before the promote pushes into it.
    let odp_body: ExprBlob = quote_block! {
        #( #pstate; )*
        loop {
            if #(pexit) { break; }
            {
                #( #pbinds; )*
                #( #pvars; )*
            }
            #( #pprom; )*
        }
        return Result::Ok(());
    };
    emit_fn_quote_blob(pn.as_str(), pps.as_str(), prm.tparams, "Result<(), ElError>",
                       odp_body, prm);

    // ══ PHASE 2 — `_cpt`, THE COMPACT ═════════════════════════════════════
    // See the `emit_scc_od_fns` header section "DRed PHASE 2" for the three
    // decisions this block implements (in place, two passes, latches as an
    // out-param) and what each of them costs.
    if nm == 0i64 { return true; }
    let mut cn: String = String::new();
    cn.push_str("-__wql_");
    cn.push_str(vis_strip(fn_name));
    cn.push_str("_scc");
    cn.push_i64(c);
    cn.push_str("_cpt");
    // ⚠ NO `params_text` AND NO DEP SLICES, UNLIKE ITS TWO SIBLINGS. Phase 2
    // runs no body: it is a set difference over rows the caller already holds,
    // and it is INDEPENDENT OF THE EDB. Giving it an `es`/dep parameter for
    // signature symmetry would invite exactly the misreading that phase 2 cares
    // whether it is handed ALL or PRES — it does not, and cannot, because it
    // never looks at one. The type parameters still come from `prm.tparams`;
    // for a generic query they are inferable from the row types of the `__od_`
    // / `__tot_` params whenever the row type mentions them, and `_cpt` has no
    // caller today for which that could fail.
    let mut cs: String = String::new();
    let mut c0: i64 = 0i64;
    while c0 < nm {
        if c0 > 0i64 { cs.push_str(", "); }
        cs.push_str("__od_");
        cs.push_str(prm.rel_names[mem[c0]]);
        cs.push_str(": &[");
        cs.push_str(prm.rel_rowty[mem[c0]]);
        cs.push_str("]");
        c0 = c0 + 1i64;
    }
    let mut c1: i64 = 0i64;
    while c1 < nm {
        cs.push_str(", __tot_");
        cs.push_str(prm.rel_names[mem[c1]]);
        cs.push_str(": &mut Vec<");
        cs.push_str(prm.rel_rowty[mem[c1]]);
        cs.push_str(">");
        c1 = c1 + 1i64;
    }
    // ── THE REMOVED SET, AS AN OUT-PARAM — `__rm_<m>` ─────────────────────
    // ⚠ THIS IS THE NEGATIVE DELTA AND NOTHING ELSE CAN RECOVER IT. The compact
    // retains survivors at a write index and `pop`s the tail: the rows it drops
    // are OVERWRITTEN IN PLACE, so after `_cpt` returns there is no artifact
    // anywhere from which `OD ∩ T` could be reconstructed — the caller's copy of
    // T is the thing that was rewritten, and `__od_<m>` is a SUPERSET (it may
    // name rows T never held; that is exactly what the `OD ⊆ T` check refuses).
    // The counts in `__lat` say HOW MANY vanished, never WHICH.
    //
    // WHY A CALLER NEEDS THE WHICH. Phase 3 only ever APPENDS (`promote` pushes,
    // `emit_scc_fn`), so an epoch driver that folds the positive suffix
    // `[__b0 .. len)` into the entry query's per-group state folds it UP by |RD|
    // and never DOWN by `OD ∖ RD`. The rel TOTAL would be right and the
    // AGGREGATE cells silently stale — a defect no assertion about the relation
    // can see. Handing back the removed rows in T's order is what makes the −1
    // side of the fold nameable at all.
    //
    // ⚠ TRANSACTIONAL FOR THE SAME REASON THE TOTALS ARE. The pushes live in
    // PASS 2, after every member's check has run, and the `clear` below sits
    // beside `__lat.clear()` — after the checks. A refused compact therefore
    // leaves the caller's `__rm_<m>` exactly as the caller left it, seed and all,
    // which is the only input on which "a refusal reports nothing" is a claim
    // (see the `777` note on `__lat`: a FRESH empty Vec cannot tell a clear from
    // a no-op from a write).
    let mut c1b: i64 = 0i64;
    while c1b < nm {
        cs.push_str(", __rm_");
        cs.push_str(prm.rel_names[mem[c1b]]);
        cs.push_str(": &mut Vec<");
        cs.push_str(prm.rel_rowty[mem[c1b]]);
        cs.push_str(">");
        c1b = c1b + 1i64;
    }
    cs.push_str(", __lat: &mut Vec<i64>");

    // ── PASS 1, READ-ONLY: build the OD membership set, count the survivors,
    // and REFUSE BEFORE MUTATING ANYTHING if `OD ⊄ T`.
    let mut cchk: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut c2: i64 = 0i64;
    while c2 < nm {
        let rnc: str = prm.rel_names[mem[c2]];
        let kt1: ExprBlob = parse_type(prm.rel_rowty[mem[c2]]);
        let kt2: ExprBlob = parse_type(prm.rel_rowty[mem[c2]]);
        let kt3: ExprBlob = parse_type(prm.rel_rowty[mem[c2]]);
        let kt4: ExprBlob = parse_type(prm.rel_rowty[mem[c2]]);
        let kt5: ExprBlob = parse_type(prm.rel_rowty[mem[c2]]);
        let s_os:  String = suffixed("__os_",   rnc); let n_os:  Ident = Ident::new(string_as_str(&s_os));
        let s_odn: String = suffixed("__odn_",  rnc); let n_odn: Ident = Ident::new(string_as_str(&s_odn));
        let s_kp:  String = suffixed("__keep_", rnc); let n_kp:  Ident = Ident::new(string_as_str(&s_kp));
        let s_od:  String = suffixed("__od_",   rnc); let n_od:  Ident = Ident::new(string_as_str(&s_od));
        let s_tt:  String = suffixed("__tot_",  rnc); let n_tt:  Ident = Ident::new(string_as_str(&s_tt));
        cchk.push(quote_block! {
            let mut #n_os: HashSet<#(kt1)> = hashset_new::<#(kt2)>();
            {
                let __sp: *mut HashSet<#(kt3)> = &mut #n_os;
                let mut __k: i64 = 0i64;
                while __k < #n_od.len() {
                    unsafe { (__sp).insert(#n_od[__k]); }
                    __k = __k + 1i64;
                }
            }
            let #n_odn: i64 = #n_os.len();
            let mut #n_kp: i64 = 0i64;
            {
                let __sp2: *mut HashSet<#(kt4)> = &mut #n_os;
                let mut __r: i64 = 0i64;
                while __r < #n_tt.len() {
                    let __row: #(kt5) = #n_tt.get(__r);
                    let __hit: bool = unsafe { (__sp2).contains(&__row) };
                    if !__hit { #n_kp = #n_kp + 1i64; }
                    __r = __r + 1i64;
                }
            }
            if #n_tt.len() - #n_kp != #n_odn {
                return Result::Err(ElError::RetractAbsent);
            }
        });
        c2 = c2 + 1i64;
    }
    // ── PASS 2, THE WRITE: retain in place at a write index, then `pop` the
    // tail. Nothing here can fail, because pass 1 already refused every input
    // on which it could.
    let mut cdo: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut c3: i64 = 0i64;
    while c3 < nm {
        let rnd: str = prm.rel_names[mem[c3]];
        let lt1: ExprBlob = parse_type(prm.rel_rowty[mem[c3]]);
        let lt2: ExprBlob = parse_type(prm.rel_rowty[mem[c3]]);
        let s_os:  String = suffixed("__os_",   rnd); let n_os:  Ident = Ident::new(string_as_str(&s_os));
        let s_odn: String = suffixed("__odn_",  rnd); let n_odn: Ident = Ident::new(string_as_str(&s_odn));
        // `__keep_<m>` is deliberately NOT re-read here. It and `__w` are the
        // same count computed by the same predicate over the same rows; an
        // equality assertion between them would be a branch no input can take.
        let s_tt:  String = suffixed("__tot_",  rnd); let n_tt:  Ident = Ident::new(string_as_str(&s_tt));
        let s_rm:  String = suffixed("__rm_",   rnd); let n_rm:  Ident = Ident::new(string_as_str(&s_rm));
        cdo.push(quote_block! {
            {
                let __sp3: *mut HashSet<#(lt1)> = &mut #n_os;
                let mut __w: i64 = 0i64;
                let mut __r2: i64 = 0i64;
                while __r2 < #n_tt.len() {
                    let __row2: #(lt2) = #n_tt.get(__r2);
                    let __hit2: bool = unsafe { (__sp3).contains(&__row2) };
                    if !__hit2 {
                        #n_tt.set(__w, __row2);
                        __w = __w + 1i64;
                    } else {
                        // THE NEGATIVE DELTA, in T's own order — see the
                        // `__rm_<m>` note on the signature. It is emitted from
                        // THIS branch and not from a second walk over `__od_<m>`
                        // on purpose: `__od_<m>` may name rows T never held, and
                        // it carries the propagation's order, not T's. `OD ∩ T`
                        // in FIRST-DERIVATION order is what a fold has to undo,
                        // and this is the only place both facts are in hand.
                        #n_rm.push(__row2);
                    }
                    __r2 = __r2 + 1i64;
                }
                // THE TAIL IS STALE UNTIL THIS RUNS. `set` never shortens the
                // Vec, so the rows at `[__w, len)` are duplicates of survivors
                // that were moved down. Dropping this loop leaves a total that
                // is a strict SUPERSET of `T ∖ OD` and phase 3 would then
                // "re-derive" onto garbage.
                while #n_tt.len() > __w {
                    match #n_tt.pop() {
                        Option::Some(_x) => { }
                        Option::None     => { }
                    }
                }
                __lat.push(#n_odn);
                __lat.push(__w);
                // |RD| — the RE-DERIVE count, AND `_cpt` STRUCTURALLY CANNOT
                // FILL IT. Phase 3 exists now — it is `_i` re-entered over the
                // SURVIVOR edb with this very `__tot_<m>` as its total (see the
                // "DRed PHASE 3" section of `emit_scc_od_fns`'s header) — but it
                // runs AFTER `_cpt` has returned, so |RD| is not a fact in scope
                // here at any point. The latch therefore still carries the
                // interpreter's "never ran" sentinel (`incr_rec.logos`'s `-1`
                // init) rather than 0, because a 0 would read as "phase 3 ran and
                // re-derived nothing" — a CLAIM this fn cannot make.
                // ⚠ WHO RETIRES IT: the epoch DRIVER, with
                // `__lat.set(3m+2, __tot_<m>.len() - __lat.get(3m+1))` after the
                // `_i` call. THERE IS NO EMITTED DRIVER IN THIS SLICE — the
                // retraction surface is still refused for every rel-backed query
                // — so writing that line anywhere today would put it in the
                // FIXTURE, where it would assert the fixture's own arithmetic
                // against itself. The slice's phase-3 fixture instead computes
                // |RD| from `len(__tot) − __lat[3m+1]` and checks it against an
                // INDEPENDENT closure oracle, and asserts this `-1` unchanged.
                __lat.push(0i64 - 1i64);
            }
        });
        c3 = c3 + 1i64;
    }
    // ⚠ THE TWO REPEATS ARE SEPARATE FOR THE N-MEMBER CASE. Every member's
    // check runs before ANY member's compact, so a violation found on member 2
    // cannot leave member 1 already rewritten. Interleaving them would make the
    // refusal non-transactional at N ≥ 2 while looking identical at N = 1 —
    // and N = 1 is the only shape with a witness anywhere today.
    // ⚠ THE CLEAR RUNS AFTER THE CHECKS, AND THAT ORDER IS A FIX FOR A MEASURED
    // DEFECT IN THE FIRST VERSION OF THIS FN. With `__lat.clear()` first, a
    // REFUSED compact ERASED the caller's previous-epoch latches: seed `__lat`
    // with 777, call with an `OD ⊄ T`, and it comes back EMPTY. The commit that
    // introduced it claimed "a refused compact reports nothing, so a reader
    // cannot mistake a stale latch for a completed phase" — but it did not
    // merely fail to report, it DESTROYED THE PRIOR REPORT, which is the one
    // thing a caller cannot recover. That contradicted this fn's own headline
    // promise: the totals are transactional under a refusal, so the latch must
    // be too, or the two disagree about whether anything happened.
    // ⚠ AND NOTHING CAUGHT IT. Deleting `__lat.clear()` altogether left both
    // fixtures at 0, because the only assertion on it is asked of a FRESH,
    // EMPTY Vec — which passes identically whether the emitter clears, writes,
    // or does neither. The fixture now seeds the latch before the refused call.
    // The `__rm_<m>` clears sit WITH `__lat.clear()`, i.e. AFTER every member's
    // check — same transaction, same reason.
    let mut cclr: Vec<ExprBlob> = vec_new::<ExprBlob>();
    let mut c4: i64 = 0i64;
    while c4 < nm {
        let s_rmc: String = suffixed("__rm_", prm.rel_names[mem[c4]]);
        let n_rmc: Ident = Ident::new(string_as_str(&s_rmc));
        cclr.push(quote_block! { #n_rmc.clear(); });
        c4 = c4 + 1i64;
    }
    let cpt_body: ExprBlob = quote_block! {
        #( #cchk; )*
        __lat.clear();
        #( #cclr; )*
        #( #cdo; )*
        return Result::Ok(());
    };
    emit_fn_quote_blob(cn.as_str(), cs.as_str(), prm.tparams, "Result<(), ElError>",
                       cpt_body, prm);
    return true;
}

// ── The rel-tier emission entry ──────────────────────────────────────────────
// One chunk: per non-recursive rel a one-shot helper fn (slice B), per
// RECURSIVE SCC one semi-naïve fixpoint fn (slice C) — emitted in condensation
// topo order (cosmetic: top-level fns don't need it). The walker has already
// validated columns/shapes/modifiers, resolved + REWRITTEN every body source,
// and checked stratification. `fn_name` is the entry resource name — it
// prefixes the helper names so multiple wql! resources per module coexist.
pub fn emit_rel_fns(rels: RQRelArr, fn_name: str, params_text: str,
                    prm: &MacroParams, scc: &RelScc, h: &Writ) -> bool {
    // ── the items are QUOTES (ADR 0024 S5) ────────────────────────────────
    // ⚠ THE ONE MULTI-ITEM EMITTER. The chunk held every rel fn at once; a
    // `quote_item!` cannot, because there is no `parse_as` rule for an ITEM
    // LIST — `parse_block` reifies statements, and a fn is not a statement.
    // So this emits SEVERAL quotes, one per fn, rather than growing the shell
    // to take a list it would have to re-split anyway. Nothing depended on the
    // items sharing a chunk: they are siblings in one package, each complete,
    // and the topo order they are emitted in was already documented as
    // cosmetic (top-level fns do not need declaration order).
    let mut p: i64 = 0i64;
    while p < scc.nscc {
        let c: i64 = scc.order[p];
        if scc.rec[c] {
            if !emit_scc_fn(rels, c, fn_name, params_text, prm, scc, false, h) { return false; }
            // P3b — the CROSS-EPOCH sibling, emitted from the SHAPE and not from
            // a request. ⚠ It is emitted whenever the shape admits it, even if
            // the entry query then declines the handle for an unrelated reason
            // (a `str` group key, an `order by`, …) and the fn goes unused. The
            // alternative is to ask the entry query first — but `emit_rel_fns`
            // runs BEFORE the entry is lowered, and inverting that order to save
            // a dead private fn would make the rel tier depend on the entry's
            // aggregate list. `rel_incr_ok` is the SAME derivation `incr_eligible`
            // reads, so the fn exists exactly where an admission can name it.
            //
            // ⚠⚠ ONCE PER SCC, NOT ONCE PER ADMITTED MEMBER — P3c. This loop
            // used to CALL `emit_scc_fn` from inside the member scan, which was
            // indistinguishable from correct only because `nmem != 1` refused
            // every multi-member SCC: with one member the loop body ran once.
            // Widening the refusal would have made an N-member admitted SCC emit
            // the SAME item `__wql_<q>_scc<c>_i` N times — a duplicate-definition
            // error at best, and the reason this was found by reading rather
            // than by a gate is that no shape could reach it. `emit_scc_fn` takes
            // the SCC id `c` and derives its whole member list from it, so the
            // member index was never an argument; the scan only ever decided
            // WHETHER, never WHICH.
            let mut any_ok: bool = false;
            let mut mi: i64 = 0i64;
            while mi < prm.rel_n {
                if scc.comp[mi] == c && prm.rel_incr_ok[mi] { any_ok = true; }
                mi = mi + 1i64;
            }
            if any_ok {
                // ⚠ TRACED BECAUSE THE DUPLICATE WAS INVISIBLE. Restoring the
                // per-member loop (CONTROL, 2026-08-07: full stdlib rebuild)
                // emitted `__wql_<q>_scc<c>_i` TWICE for the two-member SCC and
                // EVERY fixture in the tree stayed GREEN — the compiler accepts
                // the second identical definition without a word, so nothing an
                // answer can see distinguishes one emission from two. The
                // artifact is therefore reported, and `incr_scc_driver_gate.sh`
                // asserts the COUNT: one line per recursive SCC, not one per
                // admitted member.
                plan_trace("rel incr driver", "EMITTED", vis_strip(fn_name),
                           "one cross-epoch semi-naive driver per admitted recursive SCC — its member totals are POSITIONAL out-params, so the SCC id is the whole argument and the member scan decides only WHETHER, never WHICH");
                if !emit_scc_fn(rels, c, fn_name, params_text, prm, scc, true, h) { return false; }
                // DRed PHASE 1 — the over-delete siblings. Emitted from the
                // SHAPE beside `_i`, on the same admission and once per SCC for
                // the same reason (the member scan decides WHETHER, never
                // WHICH). ⚠ NO SURFACE FOLLOWS FROM THIS: nothing calls them
                // yet, `incr_retract_eligible` still refuses every rel-backed
                // query, and phases 2 and 3 are NOT emitted. See
                // `emit_scc_od_fns` for what is in fence and what is not.
                plan_trace("rel od driver", "EMITTED", vis_strip(fn_name),
                           "DRed phases 1 and 2 — `_od` (seed: base+recursive bodies at the deleted rows over the previous total), `_odp` (propagate: recursive bodies only, over the survivors, read==write==od) and `_cpt` (compact: in-place retain+pop to T∖OD, handing back the removed rows in `__rm_<m>`, refusing before it writes if OD⊄T). PHASE 3 IS `_i` RE-ENTERED OVER THE SURVIVOR EDB WITH THE COMPACTED TOTAL — no fourth sibling is emitted for it, and no retraction surface follows.");
                if !emit_scc_od_fns(rels, c, fn_name, params_text, prm, scc, h) { return false; }
            }
        } else {
            let mut i: i64 = 0i64;
            while i < prm.rel_n {
                // NATIVE rels (ADR 0016 M1a) have no parse-side RQRel and no
                // emitted helper fn — their prelude calls the stdlib walk.
                // (Registry idx 0..nr-1 is parse-aligned; natives sit after.)
                if scc.comp[i] == c && !prm.rel_native[i] {
                    if !emit_rel_fn_oneshot(rels.rel_at(i), i, fn_name,
                                            params_text, prm, scc, h) { return false; }
                }
                i = i + 1i64;
            }
        }
        p = p + 1i64;
    }
    return true;
}
