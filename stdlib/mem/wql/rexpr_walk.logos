// logos.std.wql.rexpr_walk — the UNIFIED relational-algebra layer (ADR 0012
// Phase 2 consolidation). Two responsibilities, both making `RExpr` the REAL
// executable algebra (resolving the RQuery-vs-RExpr duplication):
//
//   1. `lower_rquery_to_rexpr(RQuery, &Writ) -> WRef<RExpr>` — build a REAL
//      `RExpr` tree from the surface query PLAN (`logos.std.wql.plan`):
//        • simple    → RProj( RFilter?( RScan ), select )
//        • join/anti → RProj( RFilter?( RJoin|RAnti( RScan, RScan, on ) ), select )
//        • aggregate → RProj( RAggr( RFilter?( RScan ), key, aggSpecs ), select )
//      RFilter is DROPPED when there is no `where`. The embedded clause bodies
//      (where / select / on / group-key / aggregate-arg) stay `WRef<SExpr>`
//      edges — the exact edge primitive the plan carries; the lowering just
//      re-parents them onto the algebra nodes.
//
//   2. `emit_rexpr(...)` — ONE walker (`match` over `RExpr`) that emits the SAME
//      native source shape the per-shape `plan_walker` emitters produced (scan/
//      filter/project loop; nested-loop [anti-]join; two-pass group-by). The
//      wql! handler routes `parse → RQuery → lower_rquery_to_rexpr → simplify
//      (Phase-1, on the embedded SExpr edges) → emit_rexpr`.
//
// The fn envelope (name, the VERBATIM `deem!(…)` param list, result-type
// inference) rides beside the RExpr tree — `RScan` carries the source binding
// (name + row-type + loop var) and `RProj.sel` the projection. The generated fn
// SIGNATURE is `pub fn <name>(<params verbatim>) -> Ret` (the trama! model);
// scalar params are typed into ElTypes off the parsed param list (MacroParams).
// The scalar clauses reuse `codegen.logos` (emit_sexpr / infer_ty / reflection):
// ONE lowering, SExpr schema → Logos source text.
//
// SCHEMA MANDATE: consumes/produces ONLY Writ schema views (RQuery / RExpr /
// RAgg + the WRef edges). No plain Logos structs for algebra nodes.
package logos.std.wql.rexpr_walk;

use logos.std.compiler.metaprog;  // Emitter, error, OView, oview_module_ast
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;
use logos.std.wql.ir;
use logos.std.wql.plan;
use logos.std.wql.el;         // ElTypes, el_types_new, el_ty_of_name, EL_TY_*
use logos.std.wql.params;     // MacroParams — the parsed deem!(…) param list
use logos.std.wql.codegen;    // emit_sexpr / infer_ty / el_ty_name / …
use logos.std.wql.optimize;   // simplify_sexpr + TermList/split_and_terms/refs_mask (shared IR-level analysis)
use logos.std.wql.lower;      // lower_rquery_to_rexpr + make_*/null_* (the metaprog-free PLAN→ALGEBRA lowering)
use logos.std.wql.reflect;    // stamp_types_from_schema
use logos.mem.string;
use logos.lang.str;

// ── Aggregate fn ids (mirror plan_walker) ────────────────────────────────────
pub fn AGG_COUNT() -> i32 { return 1i32; }
pub fn AGG_SUM()   -> i32 { return 2i32; }
pub fn AGG_MIN()   -> i32 { return 3i32; }
pub fn AGG_MAX()   -> i32 { return 4i32; }
pub fn AGG_AVG()   -> i32 { return 5i32; }

// The algebraic-structure class of an aggregate — the load-bearing column that
// decides in-fixpoint admissibility (recursive-aggregation design §1):
//   • SEMILATTICE (min/max) — idempotent meet/join; the absorb gate IS the
//     lattice order, so a recursive head stays monotone ⇒ fixpoint-SAFE.
//   • GROUP (sum/count/avg) — abelian group; the very inverse that makes it
//     O(1)-incremental breaks fixpoint monotonicity (counting paths in a cycle
//     diverges) ⇒ recursion is a NAMED compile error; stratified-only.
// Defaults to GROUP/unknown for any unclassified id — reject-in-recursion, never
// default-allow (design §7 critique #1).
pub fn AGG_CLASS_SEMILATTICE() -> i32 { return 1i32; }
pub fn AGG_CLASS_GROUP()       -> i32 { return 2i32; }
pub fn agg_algebra(fnid: i32) -> i32 {
    if fnid == AGG_MIN() || fnid == AGG_MAX() { return AGG_CLASS_SEMILATTICE(); }
    return AGG_CLASS_GROUP();
}

pub fn agg_of_name(name: str) -> i32 {
    if str_eq(name, "count") { return AGG_COUNT(); }
    if str_eq(name, "sum")   { return AGG_SUM(); }
    if str_eq(name, "min")   { return AGG_MIN(); }
    if str_eq(name, "max")   { return AGG_MAX(); }
    if str_eq(name, "avg")   { return AGG_AVG(); }
    return 0i32;
}

// ── SELECT-MODE ids — the single-row emit-envelope modes ────────────────────
// `first`/`find` are NOT algebra nodes: they change the generated fn's RETURN
// TYPE (Vec<E> → Option<E> / Option<&Row>) + the loop's exit discipline (early
// return on the first hit), so they ride on the emit ENVELOPE next to
// fn_name/result_ty. The relational tree is unchanged (the same RProj/RFilter/
// RScan shape), which keeps every Phase-3 peephole (empty/identity) applicable.
//   SELM_ALL   — multi-row (Vec) — the default;
//   SELM_FIRST — `select first S` → Option<ElemTy>, first projected value;
//   SELM_FIND  — `find P`         → Option<&Row>, borrow of the first match.
pub fn SELM_ALL()   -> i32 { return 0i32; }
pub fn SELM_FIRST() -> i32 { return 1i32; }
pub fn SELM_FIND()  -> i32 { return 2i32; }

// ══════════════════════════════════════════════════════════════════════════
// PART 1 — lower_rquery_to_rexpr : surface PLAN → real RExpr algebra
// ══════════════════════════════════════════════════════════════════════════

// The full PLAN → RExpr → simplify → emit pipeline (Phase 3): LOWER the surface
// plan to the RExpr algebra, run the RELATIONAL peephole pass `simplify_rexpr`
// (filter folding, identity-projection collapse, projection composition) with
// the embedded scalar clauses const-folded inside it, then EMIT the (possibly
// thinner) form. `fn_name` / `result_ty` come off the surface plan envelope;
// `params_text` is the RAW `deem!(…)` paren text (re-emitted VERBATIM as the
// generated fn signature) and `prm` its parsed form (scalar-param typing +
// limit-param validation); the relational STRUCTURE + clause bodies live on
// the RExpr tree.
// `prelude` — statements spliced right after the generated fn's opening brace
// ("" when absent). The wql! REL path (slice B) uses it to materialize the
// derived relations (`let __rel_X: Vec<Row> = __wql_<fn>_rel_X(…); let
// __rel_X_sl: &[Row] = __rel_X.as_slice();`) before the entry query's loops.
pub fn lower_simplify_emit(plan: RQuery, fn_name: str,
                           params_text: str, prm: &MacroParams,
                           result_ty: str, has_result_ty: bool,
                           sel_mode: i32, prelude: str, h: &Writ) -> bool {
    let root: WRef<RExpr> = lower_rquery_to_rexpr(plan, h);
    let sig: RSimplified = simplify_rexpr_ref(root, root.any().view::<RExpr>(), h);
    let rx: RExpr = sig.root.any().view::<RExpr>();
    return emit_rexpr_opt(rx, sig.empty, sig.identity,
                          fn_name, params_text, prm, result_ty, has_result_ty, sel_mode, prelude, h);
}

// ══════════════════════════════════════════════════════════════════════════
// PART 2 — emit_rexpr : the ONE walker (RExpr → native source)
// ══════════════════════════════════════════════════════════════════════════

// Shared: when `src_name` names a REL (slice B — the emitted `__rel_<r>_sl`
// source, resolved against the MacroParams rel registry), stamp its COLUMN
// value-types into the flat dict AND bind (var, col) → tuple-component-index
// entries so `emit_sexpr`/`infer_ty` emit the positional `var.k` access with
// the right type. A non-rel source is a no-op (returns false). This is the
// rel counterpart of `stamp_types_from_schema` — called right beside it at
// every scan-source stamping site.
pub fn stamp_rel_source(ty: &mut ElTypes, prm: &MacroParams,
                        src_name: str, var_name: str) -> bool {
    let ri: i64 = prm.rel_find_src(src_name);
    if ri < 0i64 { return false; }
    let off: i64 = prm.rel_coff[ri];
    let nc: i64  = prm.rel_ccnt[ri];
    if nc == 1i64 {
        // 1-column rel: SCALAR rows (`Vec<i64>` etc. — no 1-tuple exists), so
        // the column binds the WHOLE row (idx -1 → the codegen emits `(*var)`).
        let cn0: str = prm.relc_name[off];
        let ct0: i32 = el_ty_of_name(prm.relc_ty[off]);
        // The column's DECLARED type, which for a native source came from the
        // impl's trait args (ADR 0024 S2/S3) — not just its four-value class.
        ty.set_ty_named(cn0, prm.relc_ty[off]);
        ty.rel_bind_named(var_name, cn0, -1i64, ct0, prm.relc_ty[off]);
        return true;
    }
    let mut k: i64 = 0i64;
    while k < nc {
        let cn: str = prm.relc_name[off + k];
        let ct: i32 = el_ty_of_name(prm.relc_ty[off + k]);
        ty.set_ty_named(cn, prm.relc_ty[off + k]);
        ty.rel_bind_named(var_name, cn, k, ct, prm.relc_ty[off + k]);
        k = k + 1i64;
    }
    return true;
}

// Shared: seed the type dict with each SCALAR param's declared value-type off
// the parsed `deem!(…)` list — the replacement for the retired `with` overlay.
// Slice params are SOURCES (their row schemas are reflected separately); a
// scalar param referenced BARE in EL (`e.salary > min_sal`, `limit n`) types
// through this seeding.
fn apply_scalar_params(ty: &mut ElTypes, prm: &MacroParams) {
    let mut i: i64 = 0i64;
    while i < prm.n {
        if !prm.is_slice[i] {
            ty.set_ty_named(prm.names[i], prm.tys[i]);
        }
        i = i + 1i64;
    }
}

// Validate a `limit <ident>` reference: the ident must name a SCALAR param
// declared in the deem!(…) list. Surfaces an `error` (build failure) otherwise.
fn check_limit_param(mods: &QMods, prm: &MacroParams) -> bool {
    if !mods.has_limit { return true; }
    if !mods.limit_is_param {
        // Literal limit: reject an out-of-range value (tokenizer poison i64::MIN).
        if mods.limit_n == el_lit_poison() {
            error("wql!: `limit` integer literal out of range — exceeds i64::MAX (9223372036854775807)");
            return false;
        }
        return true;
    }
    if prm.is_scalar(mods.limit_param) { return true; }
    error("wql!: `limit <ident>` must name a scalar (i64) parameter declared in the deem!(…) parameter list");
    return false;
}

// Emit the generated fn signature head: `pub fn <name><tps>(<params verbatim>`.
// The paren text is the REAL Logos parameter list from the deem!(…) surface —
// the compiler parses + type-checks it when the emitted chunk compiles, and
// the generated-fn param ORDER is the paren-list order, verbatim.
// ADR 0016: a leading `-` on fn_name (vis_is_priv, params.logos) marks a
// NON-pub generated fn — a private mapping rel; the marker is consumed here.
// `tps` is the item's type-param list, also verbatim (`<V: Bound>`, "" for a
// concrete query): a generic `deem` puts it on EVERY head it emits, and the
// calls between those fns infer their args from the source param.
fn emit_fn_head(em: &mut Emitter, fn_name: str, params_text: str, tps: str) {
    if vis_is_priv(fn_name) {
        em.push_text("fn ");
    } else {
        em.push_text("pub fn ");
    }
    em.push_text(vis_strip(fn_name));
    em.push_text(tps);
    em.push_text("(");
    em.push_text(params_text);
}

fn is_comp_root(e: SExpr) -> bool {
    match e {
        SExpr::Comp(_) => { return true; }
        _ => { return false; }
    }
}

// ── Tuple-projection envelope (shared by every projecting emitter) ───────────
// When `proj` is tuple-rooted (`select (a, b, …)` — multi-column rows), validate
// the modifier combination and fill `tt` with the NATIVE tuple TYPE text
// `(T1, T2, …)` (per-component EL inference + owned-String promotion). Returns:
//   1  — tuple projection (tt filled; the result element type IS the tuple type);
//   0  — not a tuple projection (tt untouched);
//  -1  — error surfaced (`: RTy` annotation clash, or distinct over an f64
//         component — tuple `==` routes through variadic__eq which requires Eq,
//         and f64 is PartialEq only).
fn tuple_result(proj: SExpr, t: &ElTypes, has_result_ty: bool, distinct: bool,
                tt: &mut String) -> i32 {
    if !is_tuple_root(proj) { return 0i32; }
    match proj {
        SExpr::Tuple(tp) => {
            if tp.items_arr().len() < 2i64 {
                // Unreachable via the grammar (tuple_body demands ≥ 2 components;
                // `(e)` parses as grouping) — kept as a defensive diagnostic.
                error("wql!: a tuple projection needs at least two components — `(e)` is grouping, not a 1-tuple");
                return -1i32;
            }
            if has_result_ty {
                error("wql!: a `: ResultTy` annotation cannot be combined with a tuple projection — the element type is the tuple type itself");
                return -1i32;
            }
            if distinct && tuple_has_flt(tp, t) {
                error("wql!: `distinct` over a tuple projection with an f64 component is not supported — tuple equality requires Eq and f64 is not Eq");
                return -1i32;
            }
            push_tuple_ty(tt, tp, t);
        }
        _ => { }
    }
    return 1i32;
}

fn comp_head_ty(e: SExpr, t: &ElTypes) -> i32 {
    match e {
        SExpr::Comp(cp) => { return infer_ty(cp.head_expr(), t); }
        _ => { return EL_TY_INT(); }
    }
}

// ── RExpr shape decomposition helpers ────────────────────────────────────────
// The top of a lowered plan is `RLimit?( RDistinct?( RProj( RSort?( body ), sel ) ) )`;
// `body` is a scan/filter/join/anti/aggr sub-tree (with an optional HAVING
// RFilter directly over an RAggr). These peel the wrapping to route to the
// right emitter — the walker's `match` over the algebra.

// Peel an optional RFilter: returns (inner, pred_ref, has_pred).
struct Peeled { inner: RExpr, pred: WRef<SExpr>, has_pred: bool }

fn peel_filter(e: RExpr) -> Peeled {
    match e {
        RExpr::Filter(f) => {
            return Peeled { inner: f.input_expr(), pred: f.pred, has_pred: true };
        }
        _ => {
            return Peeled { inner: e, pred: null_sref(), has_pred: false };
        }
    }
}

// ── QMods — the peeled ORDER/DISTINCT/LIMIT modifier envelope ────────────────
// Collected off the RSort / RDistinct / RLimit wrappers around the projection
// root and threaded to the per-shape emitters (which weave sort / dedup / first-n
// into the generated loop nest).
struct QMods {
    has_sort:       bool,
    sort_key:       WRef<SExpr>,
    sort_desc:      bool,
    distinct:       bool,
    has_limit:      bool,
    limit_n:        i64,
    limit_is_param: bool,
    limit_param:    str,
}

fn qmods_none() -> QMods {
    return QMods { has_sort: false, sort_key: null_sref(), sort_desc: false,
                   distinct: false,
                   has_limit: false, limit_n: 0i64, limit_is_param: false, limit_param: "" };
}

// Peel a root RLimit wrapper into `mods` (identity otherwise).
fn peel_limit(e: RExpr, mods: &mut QMods) -> RExpr {
    match e {
        RExpr::Limit(l) => {
            mods.has_limit      = true;
            mods.limit_n        = l.n;
            mods.limit_is_param = l.is_param;
            mods.limit_param    = l.param;
            return l.input_expr();
        }
        _ => { return e; }
    }
}

// Peel a root RDistinct wrapper into `mods` (identity otherwise).
fn peel_distinct(e: RExpr, mods: &mut QMods) -> RExpr {
    match e {
        RExpr::Distinct(d) => {
            mods.distinct = true;
            return d.input_expr();
        }
        _ => { return e; }
    }
}

// Peel an RSort under the projection into `mods` (identity otherwise).
fn peel_sort(e: RExpr, mods: &mut QMods) -> RExpr {
    match e {
        RExpr::Sort(s) => {
            mods.has_sort  = true;
            mods.sort_key  = s.key;
            mods.sort_desc = s.desc;
            return s.input_expr();
        }
        _ => { return e; }
    }
}

// The `&& __out.len() < (N)` loop-condition suffix enforcing `limit` on every
// output-producing loop ("" when no limit). N is the literal or the param name.
fn limit_cond_text(mods: &QMods) -> String {
    let mut s: String = String::new();
    if mods.has_limit {
        s.push_str(" && __out.len() < (");
        if mods.limit_is_param {
            s.push_str(mods.limit_param);
        } else {
            s.push_i64(mods.limit_n);
            s.push_str("i64");
        }
        s.push_str(")");
    }
    return s;
}

// Emit one guarded output push at `indent`: plain `__out.push(v)` without
// `distinct`, else bind the projected value and push only when not already in
// `__out` (linear scan — O(n²) MVP dedup; `==` covers i64/f64/str natively).
fn emit_push_guarded(em: &mut Emitter, indent: str, val_ty: str, body: str, distinct: bool) {
    if !distinct {
        em.push_text(indent);
        em.push_text("__out.push(");
        em.push_text(body);
        em.push_text(");\n");
        return;
    }
    em.push_text(indent);
    em.push_text("let __pv: ");
    em.push_text(val_ty);
    em.push_text(" = (");
    em.push_text(body);
    em.push_text(");\n");
    em.push_text(indent);
    em.push_text("let mut __dup: bool = false;\n");
    em.push_text(indent);
    em.push_text("let mut __d: i64 = 0i64;\n");
    em.push_text(indent);
    em.push_text("while __d < __out.len() { if __out.get(__d) == __pv { __dup = true; } __d = __d + 1i64; }\n");
    em.push_text(indent);
    em.push_text("if !__dup { __out.push(__pv); }\n");
}

// Emit the stable in-place insertion sort over the parallel (key, index) vecs
// `__ks` + `__ix0`..`__ix{nidx-1}` (one index vec per BOUND source — 1 for a
// simple/aggregate sort, 1 + non-anti steps for a join chain) — O(n²) MVP
// codegen (strict compare keeps equal keys in source order = stable); `desc`
// flips the comparison. str keys compare with the native `<`/`>` (sema lowers
// str relationals to byte-lexicographic `str_cmp`).
fn push_ixn(em: &mut Emitter, k: i64) {
    let mut s: String = String::new();
    s.push_str("__ix");
    s.push_i64(k);
    em.push_text(string_as_str(&s));
}
fn emit_sort_perm(em: &mut Emitter, key_ty: str, desc: bool, nidx: i64) {
    em.push_text("    let mut __a: i64 = 1i64;\n");
    em.push_text("    while __a < __ks.len() {\n");
    em.push_text("        let __kv: ");
    em.push_text(key_ty);
    em.push_text(" = __ks.get(__a);\n");
    let mut k0: i64 = 0i64;
    while k0 < nidx {
        em.push_text("        let __iv");
        { let mut s: String = String::new(); s.push_i64(k0); em.push_text(string_as_str(&s)); }
        em.push_text(": i64 = ");
        push_ixn(em, k0);
        em.push_text(".get(__a);\n");
        k0 = k0 + 1i64;
    }
    em.push_text("        let mut __b: i64 = __a;\n");
    if desc {
        em.push_text("        while __b > 0i64 && __ks.get(__b - 1i64) < __kv {\n");
    } else {
        em.push_text("        while __b > 0i64 && __ks.get(__b - 1i64) > __kv {\n");
    }
    em.push_text("            __ks.set(__b, __ks.get(__b - 1i64));\n");
    let mut k1: i64 = 0i64;
    while k1 < nidx {
        em.push_text("            ");
        push_ixn(em, k1);
        em.push_text(".set(__b, ");
        push_ixn(em, k1);
        em.push_text(".get(__b - 1i64));\n");
        k1 = k1 + 1i64;
    }
    em.push_text("            __b = __b - 1i64;\n");
    em.push_text("        }\n");
    em.push_text("        __ks.set(__b, __kv);\n");
    let mut k2: i64 = 0i64;
    while k2 < nidx {
        em.push_text("        ");
        push_ixn(em, k2);
        em.push_text(".set(__b, __iv");
        { let mut s: String = String::new(); s.push_i64(k2); em.push_text(string_as_str(&s)); }
        em.push_text(");\n");
        k2 = k2 + 1i64;
    }
    em.push_text("        __a = __a + 1i64;\n");
    em.push_text("    }\n");
}

// ══════════════════════════════════════════════════════════════════════════
// Phase-3 THIN emitters — the two peephole collapses `simplify_rexpr` signals.
// ══════════════════════════════════════════════════════════════════════════

// (a·false) EMPTY plan — a const-false `where` proved the query yields NO rows.
// Emit a fn with the same signature that returns an empty `Vec` DIRECTLY: no scan
// loop, no per-row work. The verbatim params still shape the signature (the
// caller's call site is unchanged) but the body is a single empty-Vec return.
// `first` (SELM_FIRST) narrows the return to `Option<E>` + a constant
// `Option::None` — the single-row mode's empty collapse.
fn emit_empty(scan_e: RExpr, sel: WRef<SExpr>,
              fn_name: str, params_text: str, prm: &MacroParams,
              result_ty0: str, has_result_ty: bool, first: bool, h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    let row_ty: str   = sc.row_ty;

    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, row_ty);
    stamp_rel_source(&mut ty, prm, sc.src_name, sc.var_name);
    apply_scalar_params(&mut ty, prm);
    stamp_udfs_from_module(&view, &mut ty);

    let proj_sexpr: SExpr = sel.any().view::<SExpr>();

    let proj_opt: SExpr = simplify_sexpr(proj_sexpr, h).any().view::<SExpr>();
    let mut result_ty: str = result_ty0;
    if !has_result_ty {
        result_ty = infer_ty_name(proj_opt, &ty);
        // A String-returning call projects an OWNED element (Vec<String>).
        if returns_string(proj_opt, &ty) { result_ty = "String"; }
    }
    // Tuple projection: the element type is the native tuple type text.
    let mut tuple_tt: String = String::new();
    let tres: i32 = tuple_result(proj_opt, &ty, has_result_ty, false, &mut tuple_tt);
    if tres < 0i32 { return false; }
    if tres > 0i32 { result_ty = string_as_str(&tuple_tt); }
    let is_comp: bool = is_comp_root(proj_opt);
    if !has_result_ty && is_comp {
        result_ty = el_ty_name(comp_head_ty(proj_opt, &ty));
    }
    let mut elem_ty: String = String::new();
    if is_comp {
        elem_ty.push_str("Vec<"); elem_ty.push_str(result_ty); elem_ty.push_str(">");
    } else {
        elem_ty.push_str(result_ty);
    }
    let result_elem: str = string_as_str(&elem_ty);

    let mut em: Emitter = Emitter::new();
    let mut __uses: String = String::new();
    prm.native_use_text(&mut __uses);
    begin_chunk(&mut em, &view, string_as_str(&__uses));
    emit_fn_head(&mut em, fn_name, params_text, prm.tparams);
    if first {
        // Single-row mode: constant None (no scan loop).
        em.push_text(") -> Result<Option<");
        em.push_text(result_elem);
        em.push_text(">, ElError> {\n");
        em.push_text("    return Result::Ok(Option::None);\n");
    } else {
        em.push_text(") -> Result<Vec<");
        em.push_text(result_elem);
        em.push_text(">, ElError> {\n");
        // The const-false filter proved emptiness: return the empty Vec directly.
        em.push_text("    return Result::Ok(Vec::<");
        em.push_text(result_elem);
        em.push_text(">::new());\n");
    }
    em.push_text("}\n");
    em.commit();
    return true;
}

// (a·false, FIND mode) — a const-false `find` predicate: constant None with the
// borrow-returning signature (`Option<&Row>`), no scan loop.
fn emit_none_find(scan_e: RExpr, fn_name: str, params_text: str, tps: str,
                  h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    let view: OView = oview_module_ast();
    let mut em: Emitter = Emitter::new();
    // find/first fast paths scan plain slices only — no engine params here.
    begin_chunk(&mut em, &view, "");
    emit_fn_head(&mut em, fn_name, params_text, tps);
    em.push_text(") -> Result<Option<&");
    em.push_text(sc.row_ty);
    em.push_text(">, ElError> {\n");
    em.push_text("    return Result::Ok(Option::None);\n");
    em.push_text("}\n");
    em.commit();
    return true;
}

// (b, single-row modes) HEAD ROW — the identity peephole under SELM_FIRST/
// SELM_FIND: an identity selection over an UNFILTERED scan (`select first v`,
// or `find P` whose predicate const-folded to true). The first row IS the
// answer, so BORROW it: `Option<&Row>` = Some(&src[0]) when non-empty, None
// otherwise — zero loop, zero copy (the emit_identity precedent, narrowed to
// one row).
fn emit_head_row(scan_e: RExpr, fn_name: str, params_text: str, tps: str,
                 h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    let src_name: str = sc.src_name;
    let row_ty: str   = sc.row_ty;
    let view: OView = oview_module_ast();
    let mut em: Emitter = Emitter::new();
    begin_chunk(&mut em, &view, "");
    emit_fn_head(&mut em, fn_name, params_text, tps);
    em.push_text(") -> Result<Option<&");
    em.push_text(row_ty);
    em.push_text(">, ElError> {\n");
    em.push_text("    if (");
    em.push_text(src_name);
    em.push_text(").len() > 0i64 { return Result::Ok(Option::Some(&(");
    em.push_text(src_name);
    em.push_text(")[0i64])); }\n");
    em.push_text("    return Result::Ok(Option::None);\n");
    em.push_text("}\n");
    em.commit();
    return true;
}

// (b) IDENTITY PROJECTION over an UNFILTERED scan — `from src v select v`.
// The result set IS the source, so BORROW it: emit a fn returning `&[T]` that
// returns the source slice unchanged — zero loop, zero `Vec`, zero copy (the
// accessor-collapse peephole). The return TYPE narrows from `Vec<T>` to `&[T]`
// (a genuinely thinner form; there is no per-row materialization).
fn emit_identity(scan_e: RExpr,
                 fn_name: str, params_text: str, tps: str, h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    let src_name: str = sc.src_name;
    let row_ty: str   = sc.row_ty;

    let view: OView = oview_module_ast();
    let mut em: Emitter = Emitter::new();
    begin_chunk(&mut em, &view, "");
    emit_fn_head(&mut em, fn_name, params_text, tps);
    em.push_text(") -> Result<&[");
    em.push_text(row_ty);
    em.push_text("], ElError> {\n");
    em.push_text("    return Result::Ok(");
    em.push_text(src_name);
    em.push_text(");\n");
    em.push_text("}\n");
    em.commit();
    return true;
}

// ══════════════════════════════════════════════════════════════════════════
// The unified walker entry: match RExpr, dispatch to the per-shape emitter.
// `params_text`/`prm` (envelope) supply the VERBATIM signature + the parsed
// param list (scalar typing / limit validation); `fn_name` the generated fn
// name; `result_ty`/`has_result_ty` the explicit-result override.
// `sig` carries the Phase-3 peephole signals (empty / identity); when either is
// set the thin emitter above runs INSTEAD of the loop-nest walker.
// ══════════════════════════════════════════════════════════════════════════
pub fn emit_rexpr_opt(root: RExpr, empty: bool, identity: bool,
                      fn_name: str, params_text: str, prm: &MacroParams,
                      result_ty: str, has_result_ty: bool, sel_mode: i32,
                      prelude: str, h: &Writ) -> bool {
    // Phase-3 thin collapses (the root is always an RProj; peel it to reach the
    // scan for the signature). The single-row modes get their own thin forms:
    // empty → constant None; identity → head-row borrow. The THIN emitters do
    // NOT take the rel prelude: an empty collapse never reads a rel, and the
    // identity / head-row / find borrows are gated OFF rel sources upstream
    // (the program walker diagnoses whole-row selects + `find` over a rel).
    if empty || identity {
        match root {
            RExpr::Proj(p) => {
                let scan_e: RExpr = p.input_expr();
                if empty {
                    if sel_mode == SELM_FIND() {
                        return emit_none_find(scan_e, fn_name, params_text, prm.tparams, h);
                    }
                    return emit_empty(scan_e, p.sel, fn_name, params_text, prm, result_ty,
                                      has_result_ty, sel_mode == SELM_FIRST(), h);
                }
                if sel_mode != SELM_ALL() {
                    return emit_head_row(scan_e, fn_name, params_text, prm.tparams, h);
                }
                return emit_identity(scan_e, fn_name, params_text, prm.tparams, h);
            }
            _ => { }
        }
    }
    return emit_rexpr(root, fn_name, params_text, prm, result_ty, has_result_ty, sel_mode, prelude, h);
}

pub fn emit_rexpr(root: RExpr, fn_name: str,
                  params_text: str, prm: &MacroParams,
                  result_ty: str, has_result_ty: bool, sel_mode: i32,
                  prelude: str, h: &Writ) -> bool {
    // Peel the post-projection wrappers (RLimit over RDistinct — the lowering
    // order) and the RSort under the projection into the QMods envelope.
    let mut mods: QMods = qmods_none();
    let r1: RExpr = peel_limit(root, &mut mods);
    let r2: RExpr = peel_distinct(r1, &mut mods);
    // `limit <ident>` must reference a declared SCALAR param (build error else).
    if !check_limit_param(&mods, prm) { return false; }
    match r2 {
        RExpr::Proj(p) => {
            let body0: RExpr = p.input_expr();
            let body: RExpr = peel_sort(body0, &mut mods);
            let sel: WRef<SExpr> = p.sel;
            // FIND mode — the body is a (possibly filtered) scan; the selector is
            // the identity, so the emitter returns the row BORROW directly.
            if sel_mode == SELM_FIND() {
                let pl: Peeled = peel_filter(body);
                return emit_find(pl.inner, pl.pred, pl.has_pred, fn_name, params_text, prm, prelude, h);
            }
            let first: bool = sel_mode == SELM_FIRST();
            match body {
                RExpr::Join(jn) => { return emit_join_chain(jn.as_ref().view::<RExpr>(),
                                                      null_sref(), false, sel, mods,
                                                      fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                RExpr::Anti(an) => { return emit_join_chain(an.as_ref().view::<RExpr>(),
                                                      null_sref(), false, sel, mods,
                                                      fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                RExpr::Edge(ed) => { return emit_join_chain(ed.as_ref().view::<RExpr>(),
                                                      null_sref(), false, sel, mods,
                                                      fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                RExpr::Aggr(ag) => {
                    if first { error("wql!: `select first` is not supported on aggregate queries"); return false; }
                    let pl: Peeled = peel_filter(ag.input_expr());
                    return emit_aggregate(pl.inner, ag.key, ag.aggs_arr(), pl.pred, pl.has_pred,
                                          null_sref(), false, sel, mods,
                                          fn_name, params_text, prm, result_ty, has_result_ty, prelude, h);
                }
                RExpr::Filter(f) => {
                    // RFilter over a join/anti (the `where` sits above the join), over
                    // an aggregate (the HAVING filter over the group rows), or over a
                    // scan (simple with `where`).
                    match f.input_expr() {
                        RExpr::Join(jn) => { return emit_join_chain(jn.as_ref().view::<RExpr>(),
                                                              f.pred, true, sel, mods,
                                                              fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                        RExpr::Anti(an) => { return emit_join_chain(an.as_ref().view::<RExpr>(),
                                                              f.pred, true, sel, mods,
                                                              fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                        RExpr::Edge(ed) => { return emit_join_chain(ed.as_ref().view::<RExpr>(),
                                                              f.pred, true, sel, mods,
                                                              fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h); }
                        RExpr::Aggr(ag) => {
                            if first { error("wql!: `select first` is not supported on aggregate queries"); return false; }
                            let pl: Peeled = peel_filter(ag.input_expr());
                            return emit_aggregate(pl.inner, ag.key, ag.aggs_arr(), pl.pred, pl.has_pred,
                                                  f.pred, true, sel, mods,
                                                  fn_name, params_text, prm, result_ty, has_result_ty, prelude, h);
                        }
                        _ => {
                            return emit_simple(f.input_expr(), f.pred, true, sel, mods,
                                               fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h);
                        }
                    }
                }
                _ => {
                    // Bare RScan — simple, no `where`.
                    return emit_simple(body, null_sref(), false, sel, mods,
                                       fn_name, params_text, prm, result_ty, has_result_ty, first, prelude, h);
                }
            }
        }
        _ => { error("wql!: unexpected relational algebra root (expected a projection)"); return false; }
    }
}

// The RScan bound under a (possibly wrapped) input. TOTAL over the algebra
// (every compound node recurses into its input / left child) — an unexpected
// shape resolves to SOME scan rather than diverging.
fn scan_of(e: RExpr) -> RScan {
    match e {
        RExpr::Scan(sc)     => { return sc; }
        RExpr::Filter(f)    => { return scan_of(f.input_expr()); }
        RExpr::Sort(s)      => { return scan_of(s.input_expr()); }
        RExpr::Proj(p)      => { return scan_of(p.input_expr()); }
        RExpr::Limit(l)     => { return scan_of(l.input_expr()); }
        RExpr::Distinct(d)  => { return scan_of(d.input_expr()); }
        RExpr::Aggr(ag)     => { return scan_of(ag.input_expr()); }
        RExpr::Join(jn)     => { return scan_of(jn.left_expr()); }
        RExpr::Anti(an)     => { return scan_of(an.left_expr()); }
        RExpr::Edge(ed)     => { return scan_of(ed.input_expr()); }
        RExpr::Fix(fx)      => { return scan_of(fx.base.any().view::<RExpr>()); }
    }
}

// ── emit_simple — scan / filter / [sort] / project / [distinct/limit] ─────────
// Base shape mirrors walk_simple; with an `order by` the matching row INDICES +
// their keys are materialized and insertion-sorted (stable, O(n²) MVP codegen)
// before the projection loop; `distinct` dedups the projected values (linear
// scan); `limit` caps the output via the loop condition.
// `first` (SELM_FIRST) — single-row mode: `-> Option<E>`; without `order by`
// the scan loop EARLY-RETURNS `Option::Some(proj)` on the first match (genuinely
// lazy, no Vec); with `order by` the (key, index) permutation is sorted first
// and only the HEAD row is projected. distinct/limit are diagnosed away
// upstream, so `mods` carries only the sort here.
fn emit_simple(scan_e: RExpr, pred: WRef<SExpr>, has_where: bool, sel: WRef<SExpr>,
               mods: QMods,
               fn_name: str, params_text: str, prm: &MacroParams,
               result_ty0: str, has_result_ty: bool, first: bool,
               prelude: str, h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    let src_name: str = sc.src_name;
    let row_ty: str   = sc.row_ty;
    let var_name: str = sc.var_name;

    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, row_ty);
    stamp_rel_source(&mut ty, prm, src_name, var_name);
    apply_scalar_params(&mut ty, prm);
    stamp_udfs_from_module(&view, &mut ty);

    let proj_sexpr: SExpr = sel.any().view::<SExpr>();

    if !check_calls(proj_sexpr, &ty, "wql!: `select`") { return false; }

    let proj_opt: SExpr = simplify_sexpr(proj_sexpr, h).any().view::<SExpr>();
    let mut body: String = String::new();
    emit_sexpr(&mut body, proj_opt, &ty, var_name);

    let mut result_ty: str = result_ty0;
    if !has_result_ty {
        result_ty = el_ty_name(infer_ty(proj_opt, &ty));
        // A String-returning call (upper/lower or a String UDF) projects an
        // OWNED element: Vec<String> / Option<String> — a borrowed `str` view
        // of the call's temporary would dangle.
        if returns_string(proj_opt, &ty) { result_ty = "String"; }
    }
    // Tuple projection (`select (a, b, …)`): multi-column rows — the element
    // type is the native tuple type text (Vec<(T1,T2)> / Option<(T1,T2)>).
    let mut tuple_tt: String = String::new();
    let tres: i32 = tuple_result(proj_opt, &ty, has_result_ty, mods.distinct, &mut tuple_tt);
    if tres < 0i32 { return false; }
    if tres > 0i32 { result_ty = string_as_str(&tuple_tt); }
    let is_comp: bool = is_comp_root(proj_opt);
    if !has_result_ty && is_comp {
        result_ty = el_ty_name(comp_head_ty(proj_opt, &ty));
    }
    let mut elem_ty: String = String::new();
    if is_comp {
        elem_ty.push_str("Vec<");
        elem_ty.push_str(result_ty);
        elem_ty.push_str(">");
    } else {
        elem_ty.push_str(result_ty);
    }
    let result_elem: str = string_as_str(&elem_ty);

    let mut pred_body: String = String::new();
    if has_where {
        let pred_sexpr: SExpr = pred.any().view::<SExpr>();
        if !reject_tuple(pred_sexpr, "wql!: `where`") { return false; }
        if !check_calls(pred_sexpr, &ty, "wql!: `where`") { return false; }
        let pred_opt: SExpr = simplify_sexpr(pred_sexpr, h).any().view::<SExpr>();
        emit_sexpr(&mut pred_body, pred_opt, &ty, var_name);
    }

    // The optional `order by` key: emitted body + its EL value type (i64/f64/str).
    let mut key_body: String = String::new();
    let mut key_ty: str = "i64";
    if mods.has_sort {
        let key_e: SExpr = mods.sort_key.any().view::<SExpr>();
        if !reject_tuple(key_e, "wql!: `order by`") { return false; }
        if !check_calls(key_e, &ty, "wql!: `order by`") { return false; }
        let key_opt: SExpr = simplify_sexpr(key_e, h).any().view::<SExpr>();
        key_ty = el_ty_name(infer_ty(key_opt, &ty));
        emit_sexpr(&mut key_body, key_opt, &ty, var_name);
    }
    let lim_cond: String = limit_cond_text(&mods);

    let mut em: Emitter = Emitter::new();
    let mut __uses: String = String::new();
    prm.native_use_text(&mut __uses);
    begin_chunk(&mut em, &view, string_as_str(&__uses));
    emit_fn_head(&mut em, fn_name, params_text, prm.tparams);
    if first {
        em.push_text(") -> Result<Option<");
        em.push_text(result_elem);
        em.push_text(">, ElError> {\n");
        em.push_text(prelude);
    } else {
        em.push_text(") -> Result<Vec<");
        em.push_text(result_elem);
        em.push_text(">, ElError> {\n");
        em.push_text(prelude);
        em.push_text("    let mut __out: Vec<");
        em.push_text(result_elem);
        em.push_text("> = Vec::<");
        em.push_text(result_elem);
        em.push_text(">::new();\n");
    }
    if mods.has_sort {
        // Phase 1: collect matching row indices + sort keys.
        em.push_text("    let mut __ix0: Vec<i64> = Vec::<i64>::new();\n");
        em.push_text("    let mut __ks: Vec<");
        em.push_text(key_ty);
        em.push_text("> = Vec::<");
        em.push_text(key_ty);
        em.push_text(">::new();\n");
        em.push_text("    let mut __i: i64 = 0i64;\n");
        em.push_text("    while __i < (");
        em.push_text(src_name);
        em.push_text(").len() {\n");
        em.push_text("        let ");
        em.push_text(var_name);
        em.push_text(": &");
        em.push_text(row_ty);
        em.push_text(" = &(");
        em.push_text(src_name);
        em.push_text(")[__i];\n");
        if has_where {
            em.push_text("        if ");
            em.push_text(string_as_str(&pred_body));
            em.push_text(" {\n");
            em.push_text("            __ix0.push(__i);\n");
            em.push_text("            __ks.push(");
            em.push_text(string_as_str(&key_body));
            em.push_text(");\n");
            em.push_text("        }\n");
        } else {
            em.push_text("        __ix0.push(__i);\n");
            em.push_text("        __ks.push(");
            em.push_text(string_as_str(&key_body));
            em.push_text(");\n");
        }
        em.push_text("        __i = __i + 1i64;\n");
        em.push_text("    }\n");
        // Phase 2: stable insertion sort of the (key, index) permutation.
        emit_sort_perm(&mut em, key_ty, mods.sort_desc, 1i64);
        if first {
            // Phase 3 (single-row): project only the HEAD of the sorted order.
            em.push_text("    if __ix0.len() > 0i64 {\n");
            em.push_text("        let ");
            em.push_text(var_name);
            em.push_text(": &");
            em.push_text(row_ty);
            em.push_text(" = &(");
            em.push_text(src_name);
            em.push_text(")[__ix0.get(0i64)];\n");
            em.push_text("        return Result::Ok(Option::Some(");
            em.push_text(string_as_str(&body));
            em.push_text("));\n");
            em.push_text("    }\n");
        } else {
            // Phase 3: project in sorted order (distinct dedups; limit caps).
            em.push_text("    let mut __o: i64 = 0i64;\n");
            em.push_text("    while __o < __ix0.len()");
            em.push_text(string_as_str(&lim_cond));
            em.push_text(" {\n");
            em.push_text("        let ");
            em.push_text(var_name);
            em.push_text(": &");
            em.push_text(row_ty);
            em.push_text(" = &(");
            em.push_text(src_name);
            em.push_text(")[__ix0.get(__o)];\n");
            emit_push_guarded(&mut em, "        ", result_elem, string_as_str(&body), mods.distinct);
            em.push_text("        __o = __o + 1i64;\n");
            em.push_text("    }\n");
        }
    } else {
        em.push_text("    let mut __i: i64 = 0i64;\n");
        em.push_text("    while __i < (");
        em.push_text(src_name);
        em.push_text(").len()");
        em.push_text(string_as_str(&lim_cond));
        em.push_text(" {\n");
        em.push_text("        let ");
        em.push_text(var_name);
        em.push_text(": &");
        em.push_text(row_ty);
        em.push_text(" = &(");
        em.push_text(src_name);
        em.push_text(")[__i];\n");
        if has_where {
            em.push_text("        if ");
            em.push_text(string_as_str(&pred_body));
            em.push_text(" {\n");
            if first {
                // Early exit: the FIRST matching row's projection is the answer.
                em.push_text("            return Result::Ok(Option::Some(");
                em.push_text(string_as_str(&body));
                em.push_text("));\n");
            } else {
                emit_push_guarded(&mut em, "            ", result_elem, string_as_str(&body), mods.distinct);
            }
            em.push_text("        }\n");
        } else {
            if first {
                em.push_text("        return Result::Ok(Option::Some(");
                em.push_text(string_as_str(&body));
                em.push_text("));\n");
            } else {
                emit_push_guarded(&mut em, "        ", result_elem, string_as_str(&body), mods.distinct);
            }
        }
        em.push_text("        __i = __i + 1i64;\n");
        em.push_text("    }\n");
    }
    if first {
        em.push_text("    return Result::Ok(Option::None);\n");
    } else {
        em.push_text("    return Result::Ok(__out);\n");
    }
    em.push_text("}\n");
    em.commit();
    return true;
}

// ── emit_find — single-row BORROW scan (`from src v find P`) ──────────────────
// The generated fn returns `Option<&Ty>` — a borrow of the FIRST row matching
// the predicate (zero-copy; the emit_identity accessor-collapse precedent shows
// returning borrows of the slice param works), `Option::None` when no row
// matches. Early-exit loop — no Vec, no materialization. Scalar params from the
// deem!(…) list may be referenced BARE in the predicate (typed off the list).
fn emit_find(scan_e: RExpr, pred: WRef<SExpr>, has_pred: bool,
             fn_name: str, params_text: str, prm: &MacroParams,
             prelude: str, h: &Writ) -> bool {
    let sc: RScan = scan_of(scan_e);
    let src_name: str = sc.src_name;
    let row_ty: str   = sc.row_ty;
    let var_name: str = sc.var_name;

    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, row_ty);
    stamp_rel_source(&mut ty, prm, src_name, var_name);
    apply_scalar_params(&mut ty, prm);
    stamp_udfs_from_module(&view, &mut ty);

    let mut pred_body: String = String::new();
    if has_pred {
        let pred_sexpr: SExpr = pred.any().view::<SExpr>();
        if !reject_tuple(pred_sexpr, "wql!: `find`") { return false; }
        if !check_calls(pred_sexpr, &ty, "wql!: `find`") { return false; }
        let pred_opt: SExpr = simplify_sexpr(pred_sexpr, h).any().view::<SExpr>();
        emit_sexpr(&mut pred_body, pred_opt, &ty, var_name);
    }

    let mut em: Emitter = Emitter::new();
    let mut __uses: String = String::new();
    prm.native_use_text(&mut __uses);
    begin_chunk(&mut em, &view, string_as_str(&__uses));
    emit_fn_head(&mut em, fn_name, params_text, prm.tparams);
    em.push_text(") -> Result<Option<&");
    em.push_text(row_ty);
    em.push_text(">, ElError> {\n");
    em.push_text(prelude);
    em.push_text("    let mut __i: i64 = 0i64;\n");
    em.push_text("    while __i < (");
    em.push_text(src_name);
    em.push_text(").len() {\n");
    em.push_text("        let ");
    em.push_text(var_name);
    em.push_text(": &");
    em.push_text(row_ty);
    em.push_text(" = &(");
    em.push_text(src_name);
    em.push_text(")[__i];\n");
    if has_pred {
        em.push_text("        if ");
        em.push_text(string_as_str(&pred_body));
        em.push_text(" { return Result::Ok(Option::Some(");
        em.push_text(var_name);
        em.push_text(")); }\n");
    } else {
        em.push_text("        return Result::Ok(Option::Some(");
        em.push_text(var_name);
        em.push_text("));\n");
    }
    em.push_text("        __i = __i + 1i64;\n");
    em.push_text("    }\n");
    em.push_text("    return Result::Ok(Option::None);\n");
    em.push_text("}\n");
    em.commit();
    return true;
}

// ══════════════════════════════════════════════════════════════════════════
// JOIN CHAINS + the per-step JOIN-STRATEGY CASCADE (hash / tree / loop).
// ══════════════════════════════════════════════════════════════════════════
//
// The lowered join body is a LEFT-DEEP tree of binary RJoin/RAnti nodes over
// RScan leaves — `RJoin(RJoin(RScan a, RScan b, on1), RScan c, on2)`.
// `collect_chain` linearizes it back to base + steps; the emitter walks the
// steps LEFT-TO-RIGHT emitting one nested per-source probe/loop level each,
// with ONE shared inner body (where-filter → sort collection / early-return
// `first` / guarded distinct/limit push) at the innermost level — so every
// select-tail modifier composes over joined rows exactly as it does over a
// single source.
//
// Per step the on-predicate is analyzed at METACALL time (`analyze_step`):
//   1. the top-level `&&` conjunction splits into terms;
//   2. an EQUI-TERM is `<bound-side> == <new-side>` (either order) where one
//      side references ONLY already-bound vars / scalar params (or consts)
//      and the other ONLY the step's NEW row var. Everything else — non-`==`
//      terms, same-side terms, mixed-type `==` (int vs float) — is RESIDUAL,
//      checked after the probe. The FIRST usable equi-term supplies the key;
//      any remaining equi-terms simply join the residual (COMPOSITE KEYS
//      DEFERRED — one key column per step today);
//   3. the key's EL value-type selects the strategy BY CAPABILITY
//      (`join_key_caps` — the single seam a future structural-key version
//      swaps for metaprog has_trait queries):
//        Hash+Eq (i64/str/bool) → HASH — HashMap<K, Vec<i64>> (key → row
//                                 indices) built ONCE over the new source,
//                                 probed per bound-row; residual checked per
//                                 bucket hit. anti + no residual → HashSet<K>
//                                 absence test; anti + residual → bucket scan,
//                                 absent-or-all-fail.
//        Ord only               → TREE — the same shape over BTreeMap<K,
//                                 Vec<i64>>. UNREACHABLE with today's scalar
//                                 lattice (every Hash-able scalar is Ord and
//                                 vice versa, except f64 which is neither);
//                                 kept LIVE for future Ord-only key types.
//        PartialEq only (f64)   → NESTED LOOP over the FULL predicate (NaN
//                                 kills Hash and total Ord; `==` on the key
//                                 is still meaningful).
//        none                   → error() (unreachable today; the branch
//                                 exists for future structural keys).
//   No equi-term at all → nested loop on the full step predicate.
//
// Bucket payloads are row INDICES in scan order, so probe hits replay in
// source order and the joined-row ordering matches the nested-loop baseline
// exactly (order-sensitive e2e expectations are preserved).

fn JS_HASH() -> i32 { return 1i32; }
fn JS_TREE() -> i32 { return 2i32; }
fn JS_LOOP() -> i32 { return 3i32; }

// ── The key-capability table — THE selector seam ─────────────────────────────
// ONE function maps an EL value-type to its {hash, ord, eq} capability row;
// the strategy selector reads ONLY this. The future structural-key version
// swaps the body for metaprog has_trait queries (Hash / Ord / PartialEq over
// the key's schema type) without touching the selector logic.
pub struct KeyCaps { pub hash: bool, pub ord: bool, pub eq: bool }

pub fn join_key_caps(el_ty: i32) -> KeyCaps {
    // i64 / str / bool: Hash+Eq (also Ord — hash wins first in the cascade).
    if el_ty == EL_TY_INT() || el_ty == EL_TY_STR() || el_ty == EL_TY_BOOL() {
        return KeyCaps { hash: true, ord: true, eq: true };
    }
    // f64: PartialEq ONLY — NaN breaks the Hash key contract (NaN != NaN) and
    // the total order Ord demands; == on the key is still meaningful.
    if el_ty == EL_TY_FLT() {
        return KeyCaps { hash: false, ord: false, eq: true };
    }
    return KeyCaps { hash: false, ord: false, eq: false };
}

// DEV toggle: force the TREE tier for Hash-capable keys — compiles + runs the
// (today unreachable) Ord-only tier end-to-end during development. MUST stay
// false in committed code.
fn join_force_tree() -> bool { return false; }

// ── Small emission helpers ───────────────────────────────────────────────────
// Push `prefix` + decimal `k` — the generated-name spelling (`__pk3`, `__hm2`).
fn push_nk(em: &mut Emitter, prefix: str, k: i64) {
    let mut s: String = String::new();
    s.push_str(prefix);
    s.push_i64(k);
    em.push_text(string_as_str(&s));
}
// Push `lvl` four-space indent units.
fn push_ind(em: &mut Emitter, lvl: i64) {
    let mut i: i64 = 0i64;
    while i < lvl { em.push_text("    "); i = i + 1i64; }
}
// An indent STRING of `lvl` units (for helpers that take an indent str).
fn ind_string(lvl: i64) -> String {
    let mut s: String = String::new();
    let mut i: i64 = 0i64;
    while i < lvl { s.push_str("    "); i = i + 1i64; }
    return s;
}

// ── JChain — the linearized join chain (base + steps) ────────────────────────
// `edge[i]` — TRAVERSAL step (slice D): `src[i]` is the full field-path source
// EXPRESSION (`d.emps`, walker-stamped) rather than a slice-param name; the
// strategy cascade is BYPASSED (always nested-loop — the source depends on
// outer row vars, so no build-once index exists) and `onw[i]` may be 0 (no
// `on` — containment IS the join). `byval[i]` — the step binds a SCALAR
// element (Vec<str> → `let s: str = (e.skills)[j]`) by VALUE (Copy lattice),
// not by reference.
struct JChain {
    base_src: str,
    base_ty:  str,
    base_var: str,
    n:    i64,
    src:  [str; 8],
    ty:   [str; 8],
    var:  [str; 8],
    anti: [bool; 8],
    onw:  [i64; 8],     // raw arena words of the per-step on-pred edges (0 = none)
    edge:  [bool; 8],
    byval: [bool; 8],
}

fn jchain_new() -> JChain {
    return JChain { base_src: "", base_ty: "", base_var: "", n: 0i64,
                    src:  ["", "", "", "", "", "", "", ""],
                    ty:   ["", "", "", "", "", "", "", ""],
                    var:  ["", "", "", "", "", "", "", ""],
                    anti: [false; 8],
                    onw:  [0i64; 8],
                    edge:  [false; 8],
                    byval: [false; 8] };
}

// Walk the left spine of the binary join tree: the recursion bottoms out at
// the base scan, then each unwind appends one step (source order preserved).
fn collect_chain(e: RExpr, ch: &mut JChain) {
    match e {
        RExpr::Join(jn) => {
            collect_chain(jn.left_expr(), ch);
            let rs: RScan = scan_of(jn.right_expr());
            if ch.n < 8i64 {
                ch.src[ch.n] = rs.src_name;
                ch.ty[ch.n]  = rs.row_ty;
                ch.var[ch.n] = rs.var_name;
                ch.anti[ch.n] = false;
                ch.onw[ch.n]  = jn.on.any().raw();
                ch.n = ch.n + 1i64;
            }
            return;
        }
        RExpr::Anti(an) => {
            collect_chain(an.left_expr(), ch);
            let rs: RScan = scan_of(an.right_expr());
            if ch.n < 8i64 {
                ch.src[ch.n] = rs.src_name;
                ch.ty[ch.n]  = rs.row_ty;
                ch.var[ch.n] = rs.var_name;
                ch.anti[ch.n] = true;
                ch.onw[ch.n]  = an.on.any().raw();
                ch.n = ch.n + 1i64;
            }
            return;
        }
        RExpr::Edge(ed) => {
            // TRAVERSAL step (slice D): unary — recurse into the input, then
            // append one edge step (src = the field-path expression text).
            collect_chain(ed.input_expr(), ch);
            if ch.n < 8i64 {
                ch.src[ch.n]   = ed.src;
                ch.ty[ch.n]    = ed.row_ty;
                ch.var[ch.n]   = ed.var_name;
                ch.anti[ch.n]  = ed.is_anti;
                ch.edge[ch.n]  = true;
                ch.byval[ch.n] = el_ret_class(ed.row_ty) >= 0i32;
                if ed.has_on { ch.onw[ch.n] = ed.on.any().raw(); }
                else         { ch.onw[ch.n] = 0i64; }
                ch.n = ch.n + 1i64;
            }
            return;
        }
        _ => {
            let sc: RScan = scan_of(e);
            ch.base_src = sc.src_name;
            ch.base_ty  = sc.row_ty;
            ch.base_var = sc.var_name;
        }
    }
}

// Rebuild an SExpr view from a raw arena word (the provenance-laundering idiom).
fn sexpr_of_word(w: i64) -> SExpr { return WAny::ref_to(w as *const u8).view::<SExpr>(); }

// The per-step strategy decision (POD; the emitted TEXT lands in the caller's
// build/probe/resid/pred Strings).
pub struct StepSel { pub strat: i32, pub key_ty: i32, pub has_equi: bool, pub has_resid: bool }

// Analyze ONE step's on-predicate: simplify, split the conjunction, pick the
// FIRST usable equi-term (same EL type on both sides), compose the residual,
// and run the capability cascade. `pred` always receives the FULL simplified
// predicate (the nested-loop tier's condition).
fn analyze_step(on_ref: WRef<SExpr>, new_var: str, t: &ElTypes, var0: str, h: &Writ,
                build: &mut String, probe: &mut String,
                resid: &mut String, pred: &mut String) -> StepSel {
    let on_opt: WRef<SExpr> = simplify_sexpr(on_ref.any().view::<SExpr>(), h);
    emit_sexpr(pred, on_opt.any().view::<SExpr>(), t, var0);

    let mut tl: TermList = term_list_new();
    split_and_terms(on_opt, &mut tl);

    let mut sel_i: i64 = -1i64;
    let mut bw: i64 = 0i64;
    let mut pw: i64 = 0i64;
    let mut kt: i32 = EL_TY_INT();
    let mut i: i64 = 0i64;
    while i < tl.n {
        if sel_i < 0i64 {
            let te: SExpr = sexpr_of_word(tl.w[i]);
            match te {
                SExpr::Bin(b) => {
                    if b.op == OP_EQ() {
                        let lm: i32 = refs_mask(b.lhs_expr(), new_var);
                        let rm: i32 = refs_mask(b.rhs_expr(), new_var);
                        let mut cw: i64 = 0i64;
                        let mut cp: i64 = 0i64;
                        if lm == 1i32 && (rm & 1i32) == 0i32 { cw = b.lhs.any().raw(); cp = b.rhs.any().raw(); }
                        if rm == 1i32 && (lm & 1i32) == 0i32 { cw = b.rhs.any().raw(); cp = b.lhs.any().raw(); }
                        if cw != 0i64 {
                            // Usable key ⇔ both sides infer to the SAME EL type
                            // (no cross-type hashing through int→f64 promotion —
                            // a mixed-type == stays residual).
                            let kb: i32 = infer_ty(sexpr_of_word(cw), t);
                            let kp: i32 = infer_ty(sexpr_of_word(cp), t);
                            if kb == kp {
                                sel_i = i;
                                bw = cw;
                                pw = cp;
                                kt = kb;
                            }
                        }
                    }
                }
                _ => { }
            }
        }
        i = i + 1i64;
    }

    let mut ss: StepSel = StepSel { strat: JS_LOOP(), key_ty: kt, has_equi: false, has_resid: false };
    if sel_i >= 0i64 {
        ss.has_equi = true;
        emit_sexpr(build, sexpr_of_word(bw), t, var0);
        emit_sexpr(probe, sexpr_of_word(pw), t, var0);
        // Residual = AND of every non-selected term (checked after the probe).
        let mut k: i64 = 0i64;
        let mut none_yet: bool = true;
        while k < tl.n {
            if k != sel_i {
                if !none_yet { resid.push_str(" && "); }
                resid.push_str("(");
                emit_sexpr(resid, sexpr_of_word(tl.w[k]), t, var0);
                resid.push_str(")");
                none_yet = false;
            }
            k = k + 1i64;
        }
        ss.has_resid = !none_yet;
        // THE CASCADE — by key capability.
        let caps: KeyCaps = join_key_caps(kt);
        if caps.hash && !join_force_tree() { ss.strat = JS_HASH(); }
        else if caps.ord                   { ss.strat = JS_TREE(); }
        else if caps.eq                    { ss.strat = JS_LOOP(); }
        else {
            error("wql!: join key type supports neither Hash, Ord, nor equality — cannot execute this join step (scalar i64/str/bool/f64 keys only today)");
        }
    }
    return ss;
}

// Analyze EVERY step of a chain into the caller's parallel arrays.
// TRAVERSAL steps (edge) BYPASS the strategy cascade entirely: containment has
// no key and the source expression depends on outer row vars (a build-once
// index cannot exist), so the step is ALWAYS a nested loop — its optional `on`
// is just the loop's residual filter ("true" when absent).
fn analyze_chain(ch: &JChain, t: &ElTypes, var0: str, h: &Writ,
                 st_build: &mut [String; 8], st_probe: &mut [String; 8],
                 st_resid: &mut [String; 8], st_pred: &mut [String; 8],
                 st_strat: &mut [i32; 8], st_ktn: &mut [str; 8],
                 st_hasres: &mut [bool; 8], st_equi: &mut [bool; 8]) {
    let mut i: i64 = 0i64;
    while i < ch.n {
        if ch.edge[i] {
            st_strat[i]  = JS_LOOP();
            st_ktn[i]    = "";
            st_hasres[i] = false;
            st_equi[i]   = false;
            if ch.onw[i] != 0i64 {
                let on_opt: WRef<SExpr> = simplify_sexpr(sexpr_of_word(ch.onw[i]), h);
                emit_sexpr(&mut st_pred[i], on_opt.any().view::<SExpr>(), t, var0);
            } else {
                st_pred[i].push_str("true");
            }
        } else {
            let onr: WRef<SExpr> = WRef::<SExpr>::from_any(WAny::ref_to(ch.onw[i] as *const u8));
            let ss: StepSel = analyze_step(onr, ch.var[i], t, var0, h,
                                           &mut st_build[i], &mut st_probe[i],
                                           &mut st_resid[i], &mut st_pred[i]);
            st_strat[i]  = ss.strat;
            st_ktn[i]    = el_ty_name(ss.key_ty);
            st_hasres[i] = ss.has_resid;
            st_equi[i]   = ss.has_equi;
        }
        i = i + 1i64;
    }
}

// The `// join strategy: …` trace line (visible via LOGOS_TRACE_EMIT).
fn emit_strategy_comment(em: &mut Emitter, s: i64, strat: i32, anti: bool,
                         has_equi: bool, has_resid: bool, ktn: str, edge: bool) {
    em.push_text("    // join strategy: step ");
    { let mut t: String = String::new(); t.push_i64(s); em.push_text(string_as_str(&t)); }
    em.push_text(" = ");
    if edge {
        em.push_text("traversal (nested loop over the field path)");
        if anti { em.push_text(", anti"); }
        em.push_text("\n");
        return;
    }
    if strat == JS_HASH() {
        em.push_text("hash join (");
        em.push_text(ktn);
        em.push_text(" key)");
    } else if strat == JS_TREE() {
        em.push_text("tree join (");
        em.push_text(ktn);
        em.push_text(" key, Ord-only tier)");
    } else if has_equi {
        em.push_text("nested loop (");
        em.push_text(ktn);
        em.push_text(" key: PartialEq only — NaN kills Hash and total Ord)");
    } else {
        em.push_text("nested loop (no equi-term)");
    }
    if has_resid { em.push_text(" + residual"); }
    if anti { em.push_text(", anti"); }
    em.push_text("\n");
}

// ── Build phase (once per hash/tree step, before the loop nest) ──────────────
// Index the step's source by the NEW-side key: HashMap<K, Vec<i64>> (key → row
// indices) — or HashSet<K> for anti-without-residual (pure absence test) — or
// BTreeMap<K, Vec<i64>> on the (today unreachable) Ord-only tier. NOTE:
// BTreeMap has no auto-Drop yet (btreemap_free is manual), so the tree index
// leaks at fn exit — acceptable for the unreachable tier; revisit when a
// real Ord-only key type lands.
fn emit_build_phase(em: &mut Emitter, s: i64, strat: i32, anti: bool, has_resid: bool,
                    ktn: str, src: str, ty: str, var: str, build_key: str) {
    if strat == JS_LOOP() { return; }
    let set_form: bool = strat == JS_HASH() && anti && !has_resid;
    // Container + ONE raw pointer to it, taken at the declaration (the
    // std_hashmap_full idiom): all build/probe access goes through the pointer,
    // so the `&mut` borrow is taken exactly once — bc-clean across the fn.
    if set_form {
        em.push_text("    let mut ");
        push_nk(em, "__hs", s);
        em.push_text(": HashSet<");
        em.push_text(ktn);
        em.push_text("> = hashset_new::<");
        em.push_text(ktn);
        em.push_text(">();\n");
        em.push_text("    let ");
        push_nk(em, "__sp", s);
        em.push_text(": *mut HashSet<");
        em.push_text(ktn);
        em.push_text("> = &mut ");
        push_nk(em, "__hs", s);
        em.push_text(";\n");
    } else if strat == JS_HASH() {
        em.push_text("    let mut ");
        push_nk(em, "__hm", s);
        em.push_text(": HashMap<");
        em.push_text(ktn);
        em.push_text(", Vec<i64>> = hashmap_new::<");
        em.push_text(ktn);
        em.push_text(", Vec<i64>>();\n");
        em.push_text("    let ");
        push_nk(em, "__mp", s);
        em.push_text(": *mut HashMap<");
        em.push_text(ktn);
        em.push_text(", Vec<i64>> = &mut ");
        push_nk(em, "__hm", s);
        em.push_text(";\n");
    } else {
        em.push_text("    let mut ");
        push_nk(em, "__bt", s);
        em.push_text(": BTreeMap<");
        em.push_text(ktn);
        em.push_text(", Vec<i64>> = btreemap_new::<");
        em.push_text(ktn);
        em.push_text(", Vec<i64>>();\n");
        em.push_text("    let ");
        push_nk(em, "__tp", s);
        em.push_text(": *mut BTreeMap<");
        em.push_text(ktn);
        em.push_text(", Vec<i64>> = &mut ");
        push_nk(em, "__bt", s);
        em.push_text(";\n");
    }
    em.push_text("    {\n        let mut ");
    push_nk(em, "__b", s);
    em.push_text(": i64 = 0i64;\n        while ");
    push_nk(em, "__b", s);
    em.push_text(" < (");
    em.push_text(src);
    em.push_text(").len() {\n            let ");
    em.push_text(var);
    em.push_text(": &");
    em.push_text(ty);
    em.push_text(" = &(");
    em.push_text(src);
    em.push_text(")[");
    push_nk(em, "__b", s);
    em.push_text("];\n            let ");
    push_nk(em, "__k", s);
    em.push_text(": ");
    em.push_text(ktn);
    em.push_text(" = (");
    em.push_text(build_key);
    em.push_text(");\n");
    if set_form {
        em.push_text("            unsafe { let _nb: bool = ");
        push_nk(em, "__sp", s);
        em.push_text(".insert(");
        push_nk(em, "__k", s);
        em.push_text("); }\n");
    } else if strat == JS_HASH() {
        em.push_text("            unsafe {\n                let ");
        push_nk(em, "__vp", s);
        em.push_text(": *mut Vec<i64> = ");
        push_nk(em, "__mp", s);
        em.push_text(".get_or_insert(");
        push_nk(em, "__k", s);
        em.push_text(", Vec::<i64>::new());\n                (&mut *");
        push_nk(em, "__vp", s);
        em.push_text(").push(");
        push_nk(em, "__b", s);
        em.push_text(");\n            }\n");
    } else {
        em.push_text("            unsafe {\n                let ");
        push_nk(em, "__vp", s);
        em.push_text(": *mut Vec<i64> = ");
        push_nk(em, "__tp", s);
        em.push_text(".get_mut(&");
        push_nk(em, "__k", s);
        em.push_text(");\n                if ");
        push_nk(em, "__vp", s);
        em.push_text(" == (0i64 as *mut Vec<i64>) {\n                    let mut ");
        push_nk(em, "__nv", s);
        em.push_text(": Vec<i64> = Vec::<i64>::new();\n                    ");
        push_nk(em, "__nv", s);
        em.push_text(".push(");
        push_nk(em, "__b", s);
        em.push_text(");\n                    ");
        push_nk(em, "__tp", s);
        em.push_text(".insert(");
        push_nk(em, "__k", s);
        em.push_text(", ");
        push_nk(em, "__nv", s);
        em.push_text(");\n                } else {\n                    (&mut *");
        push_nk(em, "__vp", s);
        em.push_text(").push(");
        push_nk(em, "__b", s);
        em.push_text(");\n                }\n            }\n");
    }
    em.push_text("            ");
    push_nk(em, "__b", s);
    em.push_text(" = ");
    push_nk(em, "__b", s);
    em.push_text(" + 1i64;\n        }\n    }\n");
}

// Emit the probe-side bucket LOOKUP through the once-taken container pointer.
// TREE probes via `get_mut` (the *mut-receiver accessor) cast to *const — one
// pointer serves build + probe, keeping the borrow single.
fn emit_bucket_lookup(em: &mut Emitter, lvl: i64, s: i64, strat: i32, ktn: str) {
    push_ind(em, lvl);
    if strat == JS_HASH() {
        em.push_text("unsafe { ");
        push_nk(em, "__bp", s);
        em.push_text(" = ");
        push_nk(em, "__mp", s);
        em.push_text(".get(&");
        push_nk(em, "__pk", s);
        em.push_text("); }\n");
    } else {
        em.push_text("unsafe { ");
        push_nk(em, "__bp", s);
        em.push_text(" = ");
        push_nk(em, "__tp", s);
        em.push_text(".get_mut(&");
        push_nk(em, "__pk", s);
        em.push_text(") as *const Vec<i64>; }\n");
    }
}

// ── One step of the nest: OPEN (emit loops/guards; return levels opened) ─────
// `byval` — bind the row var BY VALUE (`let s: str = (src)[j];`) instead of by
// reference: scalar-element traversal steps (the Copy lattice — a `&str` local
// would not compose with the EL clauses, which reference the element bare).
// Only meaningful on the JS_LOOP tier (traversal is always nested-loop).
fn emit_step_open(em: &mut Emitter, lvl: i64, s: i64, strat: i32, anti: bool,
                  has_resid: bool, ktn: str, src: str, ty: str, var: str, byval: bool,
                  probe_key: str, residual: str, pred: str, lim: str) -> i64 {
    // The probe key (hash/tree tiers) — over the ALREADY-BOUND vars/params.
    if strat != JS_LOOP() {
        push_ind(em, lvl);
        em.push_text("let ");
        push_nk(em, "__pk", s);
        em.push_text(": ");
        em.push_text(ktn);
        em.push_text(" = (");
        em.push_text(probe_key);
        em.push_text(");\n");
    }
    if anti {
        // ANTI: compute the matched flag flat at `lvl`, then guard the nest
        // with `if (!__m{s})` — ONE level opened; the step's var binds only
        // inside its own probe/scan.
        push_ind(em, lvl);
        em.push_text("let mut ");
        push_nk(em, "__m", s);
        em.push_text(": bool = false;\n");
        if strat == JS_LOOP() {
            push_ind(em, lvl);
            em.push_text("{\n");
            push_ind(em, lvl + 1i64);
            em.push_text("let mut ");
            push_nk(em, "__j", s);
            em.push_text(": i64 = 0i64;\n");
            push_ind(em, lvl + 1i64);
            em.push_text("while ");
            push_nk(em, "__j", s);
            em.push_text(" < (");
            em.push_text(src);
            em.push_text(").len() {\n");
            push_ind(em, lvl + 2i64);
            em.push_text("let ");
            em.push_text(var);
            em.push_text(": ");
            if !byval { em.push_text("&"); }
            em.push_text(ty);
            em.push_text(" = ");
            if !byval { em.push_text("&"); }
            em.push_text("(");
            em.push_text(src);
            em.push_text(")[");
            push_nk(em, "__j", s);
            em.push_text("];\n");
            push_ind(em, lvl + 2i64);
            em.push_text("if (");
            em.push_text(pred);
            em.push_text(") { ");
            push_nk(em, "__m", s);
            em.push_text(" = true; }\n");
            push_ind(em, lvl + 2i64);
            push_nk(em, "__j", s);
            em.push_text(" = ");
            push_nk(em, "__j", s);
            em.push_text(" + 1i64;\n");
            push_ind(em, lvl + 1i64);
            em.push_text("}\n");
            push_ind(em, lvl);
            em.push_text("}\n");
        } else if !has_resid {
            // Pure absence test: HashSet contains / BTreeMap keyed lookup
            // (through the once-taken container pointer).
            push_ind(em, lvl);
            if strat == JS_HASH() {
                em.push_text("unsafe { ");
                push_nk(em, "__m", s);
                em.push_text(" = ");
                push_nk(em, "__sp", s);
                em.push_text(".contains(&");
                push_nk(em, "__pk", s);
                em.push_text("); }\n");
            } else {
                em.push_text("unsafe { ");
                push_nk(em, "__m", s);
                em.push_text(" = ");
                push_nk(em, "__tp", s);
                em.push_text(".get_mut(&");
                push_nk(em, "__pk", s);
                em.push_text(") != (0i64 as *mut Vec<i64>); }\n");
            }
        } else {
            // Bucket scan: matched ⇔ SOME bucket row passes the residual
            // (absent bucket or all-fail ⇒ the anti row survives).
            push_ind(em, lvl);
            em.push_text("{\n");
            push_ind(em, lvl + 1i64);
            em.push_text("let mut ");
            push_nk(em, "__bp", s);
            em.push_text(": *const Vec<i64> = 0i64 as *const Vec<i64>;\n");
            emit_bucket_lookup(em, lvl + 1i64, s, strat, ktn);
            push_ind(em, lvl + 1i64);
            em.push_text("if ");
            push_nk(em, "__bp", s);
            em.push_text(" != (0i64 as *const Vec<i64>) {\n");
            push_ind(em, lvl + 2i64);
            em.push_text("let ");
            push_nk(em, "__bv", s);
            em.push_text(": &Vec<i64> = unsafe { &*");
            push_nk(em, "__bp", s);
            em.push_text(" };\n");
            push_ind(em, lvl + 2i64);
            em.push_text("let mut ");
            push_nk(em, "__p", s);
            em.push_text(": i64 = 0i64;\n");
            push_ind(em, lvl + 2i64);
            em.push_text("while ");
            push_nk(em, "__p", s);
            em.push_text(" < ");
            push_nk(em, "__bv", s);
            em.push_text(".len() {\n");
            push_ind(em, lvl + 3i64);
            em.push_text("let ");
            em.push_text(var);
            em.push_text(": &");
            em.push_text(ty);
            em.push_text(" = &(");
            em.push_text(src);
            em.push_text(")[");
            push_nk(em, "__bv", s);
            em.push_text(".get(");
            push_nk(em, "__p", s);
            em.push_text(")];\n");
            push_ind(em, lvl + 3i64);
            em.push_text("if (");
            em.push_text(residual);
            em.push_text(") { ");
            push_nk(em, "__m", s);
            em.push_text(" = true; }\n");
            push_ind(em, lvl + 3i64);
            push_nk(em, "__p", s);
            em.push_text(" = ");
            push_nk(em, "__p", s);
            em.push_text(" + 1i64;\n");
            push_ind(em, lvl + 2i64);
            em.push_text("}\n");
            push_ind(em, lvl + 1i64);
            em.push_text("}\n");
            push_ind(em, lvl);
            em.push_text("}\n");
        }
        push_ind(em, lvl);
        em.push_text("if (!");
        push_nk(em, "__m", s);
        em.push_text(") {\n");
        return 1i64;
    }
    // NON-ANTI.
    if strat == JS_LOOP() {
        push_ind(em, lvl);
        em.push_text("let mut ");
        push_nk(em, "__j", s);
        em.push_text(": i64 = 0i64;\n");
        push_ind(em, lvl);
        em.push_text("while ");
        push_nk(em, "__j", s);
        em.push_text(" < (");
        em.push_text(src);
        em.push_text(").len()");
        em.push_text(lim);
        em.push_text(" {\n");
        push_ind(em, lvl + 1i64);
        em.push_text("let ");
        em.push_text(var);
        em.push_text(": ");
        if !byval { em.push_text("&"); }
        em.push_text(ty);
        em.push_text(" = ");
        if !byval { em.push_text("&"); }
        em.push_text("(");
        em.push_text(src);
        em.push_text(")[");
        push_nk(em, "__j", s);
        em.push_text("];\n");
        push_ind(em, lvl + 1i64);
        em.push_text("if (");
        em.push_text(pred);
        em.push_text(") {\n");
        return 2i64;
    }
    // HASH / TREE probe: bucket lookup → row loop → (residual guard).
    push_ind(em, lvl);
    em.push_text("let mut ");
    push_nk(em, "__bp", s);
    em.push_text(": *const Vec<i64> = 0i64 as *const Vec<i64>;\n");
    emit_bucket_lookup(em, lvl, s, strat, ktn);
    push_ind(em, lvl);
    em.push_text("if ");
    push_nk(em, "__bp", s);
    em.push_text(" != (0i64 as *const Vec<i64>) {\n");
    push_ind(em, lvl + 1i64);
    em.push_text("let ");
    push_nk(em, "__bv", s);
    em.push_text(": &Vec<i64> = unsafe { &*");
    push_nk(em, "__bp", s);
    em.push_text(" };\n");
    push_ind(em, lvl + 1i64);
    em.push_text("let mut ");
    push_nk(em, "__p", s);
    em.push_text(": i64 = 0i64;\n");
    push_ind(em, lvl + 1i64);
    em.push_text("while ");
    push_nk(em, "__p", s);
    em.push_text(" < ");
    push_nk(em, "__bv", s);
    em.push_text(".len()");
    em.push_text(lim);
    em.push_text(" {\n");
    push_ind(em, lvl + 2i64);
    em.push_text("let ");
    push_nk(em, "__ri", s);
    em.push_text(": i64 = ");
    push_nk(em, "__bv", s);
    em.push_text(".get(");
    push_nk(em, "__p", s);
    em.push_text(");\n");
    push_ind(em, lvl + 2i64);
    em.push_text("let ");
    em.push_text(var);
    em.push_text(": &");
    em.push_text(ty);
    em.push_text(" = &(");
    em.push_text(src);
    em.push_text(")[");
    push_nk(em, "__ri", s);
    em.push_text("];\n");
    if has_resid {
        push_ind(em, lvl + 2i64);
        em.push_text("if (");
        em.push_text(residual);
        em.push_text(") {\n");
        return 3i64;
    }
    return 2i64;
}

// ── One step of the nest: CLOSE (mirror the open; bump loop indices) ─────────
// `lvl` = the innermost CONTENT level the open left us at; returns the levels
// closed (== the matching open's return).
fn emit_step_close(em: &mut Emitter, lvl: i64, s: i64, strat: i32, anti: bool,
                   has_resid: bool) -> i64 {
    if anti {
        push_ind(em, lvl - 1i64);
        em.push_text("}\n");
        return 1i64;
    }
    if strat == JS_LOOP() {
        push_ind(em, lvl - 1i64);
        em.push_text("}\n");
        push_ind(em, lvl - 1i64);
        push_nk(em, "__j", s);
        em.push_text(" = ");
        push_nk(em, "__j", s);
        em.push_text(" + 1i64;\n");
        push_ind(em, lvl - 2i64);
        em.push_text("}\n");
        return 2i64;
    }
    let mut l: i64 = lvl;
    if has_resid {
        l = l - 1i64;
        push_ind(em, l);
        em.push_text("}\n");
    }
    push_ind(em, l);
    push_nk(em, "__p", s);
    em.push_text(" = ");
    push_nk(em, "__p", s);
    em.push_text(" + 1i64;\n");
    push_ind(em, l - 1i64);
    em.push_text("}\n");
    push_ind(em, l - 2i64);
    em.push_text("}\n");
    return lvl - (l - 2i64);
}

// ── emit_join_chain — the RECURSIVE-over-the-join-tree emitter ───────────────
// `body` is the RJoin/RAnti root of a left-deep chain. Emits nested per-source
// loops binding the row vars LEFT-TO-RIGHT (per-step strategy from the Part-2
// cascade) with ONE shared inner body: where-filter → sort-index collection /
// `first` early-return / guarded distinct-limit push. With `order by` the
// matched BOUND-row index tuples (one Vec per bound source) + keys are
// materialized and insertion-sorted before the projection loop — all existing
// modifiers compose over joined rows unchanged.
fn emit_join_chain(body: RExpr, where_ref: WRef<SExpr>, has_where: bool, sel: WRef<SExpr>,
                   mods: QMods,
                   fn_name: str, params_text: str, prm: &MacroParams,
                   result_ty0: str, has_result_ty: bool, first: bool,
                   prelude: str, h: &Writ) -> bool {
    // 1. Linearize the left-deep tree into base + steps.
    let mut ch: JChain = jchain_new();
    collect_chain(body, &mut ch);

    // 2. Type dict: EVERY bound source's row schema + the scalar params.
    // Rel-sourced scans (slice B) stamp their COLUMN types + the positional
    // (var, col) → tuple-index bindings instead of a schema reflection.
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, ch.base_ty);
    stamp_rel_source(&mut ty, prm, ch.base_src, ch.base_var);
    let mut si: i64 = 0i64;
    while si < ch.n {
        stamp_types_from_schema(&view, &mut ty, ch.ty[si]);
        stamp_rel_source(&mut ty, prm, ch.src[si], ch.var[si]);
        // Scalar-element traversal var: the VAR NAME itself carries the
        // element's value type (referenced bare in the EL clauses).
        if ch.byval[si] { ty.set_ty(ch.var[si], el_ty_of_name(ch.ty[si])); }
        si = si + 1i64;
    }
    apply_scalar_params(&mut ty, prm);
    stamp_udfs_from_module(&view, &mut ty);

    // Validate every clause's calls (select / where / order / per-step on).
    if !check_calls(sel.any().view::<SExpr>(), &ty, "wql!: `select`") { return false; }
    if has_where {
        if !reject_tuple(where_ref.any().view::<SExpr>(), "wql!: `where`") { return false; }
        if !check_calls(where_ref.any().view::<SExpr>(), &ty, "wql!: `where`") { return false; }
    }
    if mods.has_sort {
        if !reject_tuple(mods.sort_key.any().view::<SExpr>(), "wql!: `order by`") { return false; }
        if !check_calls(mods.sort_key.any().view::<SExpr>(), &ty, "wql!: `order by`") { return false; }
    }
    let mut ci0: i64 = 0i64;
    while ci0 < ch.n {
        if ch.onw[ci0] != 0i64 {
            let on_e: SExpr = WAny::ref_to(ch.onw[ci0] as *const u8).view::<SExpr>();
            if !reject_tuple(on_e, "wql!: `on`") { return false; }
            if !check_calls(on_e, &ty, "wql!: `on`") { return false; }
        }
        ci0 = ci0 + 1i64;
    }

    // 3. Clause bodies (const-folded).
    let proj_opt: SExpr = simplify_sexpr(sel.any().view::<SExpr>(), h).any().view::<SExpr>();
    let mut result_ty: str = result_ty0;
    if !has_result_ty {
        result_ty = el_ty_name(infer_ty(proj_opt, &ty));
        // Owned-String projection (String-returning call at the select root).
        if returns_string(proj_opt, &ty) { result_ty = "String"; }
    }
    // Tuple projection (components may range across ALL bound join vars): the
    // result element type is the native tuple type text.
    let mut tuple_tt: String = String::new();
    let tres: i32 = tuple_result(proj_opt, &ty, has_result_ty, mods.distinct, &mut tuple_tt);
    if tres < 0i32 { return false; }
    if tres > 0i32 { result_ty = string_as_str(&tuple_tt); }
    let mut proj_body: String = String::new();
    emit_sexpr(&mut proj_body, proj_opt, &ty, ch.base_var);
    let mut where_body: String = String::new();
    if has_where {
        let where_opt: SExpr = simplify_sexpr(where_ref.any().view::<SExpr>(), h).any().view::<SExpr>();
        emit_sexpr(&mut where_body, where_opt, &ty, ch.base_var);
    }
    let mut key_body: String = String::new();
    let mut key_ty: str = "i64";
    if mods.has_sort {
        let key_opt: SExpr = simplify_sexpr(mods.sort_key.any().view::<SExpr>(), h).any().view::<SExpr>();
        key_ty = el_ty_name(infer_ty(key_opt, &ty));
        emit_sexpr(&mut key_body, key_opt, &ty, ch.base_var);
    }
    let lim_cond: String = limit_cond_text(&mods);
    let has_sort: bool = mods.has_sort;
    // Sort mode: the match loops run in FULL (the cap applies to the OUTPUT
    // loop); otherwise the limit rides every output-driving loop condition.
    let mut lim_use: str = "";
    if !has_sort { lim_use = string_as_str(&lim_cond); }

    // 4. Per-step strategy analysis (Part 2).
    let mut st_build: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_probe: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_resid: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_pred:  [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_strat:  [i32; 8]  = [0i32; 8];
    let mut st_ktn:    [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut st_hasres: [bool; 8] = [false; 8];
    let mut st_equi:   [bool; 8] = [false; 8];
    analyze_chain(&ch, &ty, ch.base_var, h,
                  &mut st_build, &mut st_probe, &mut st_resid, &mut st_pred,
                  &mut st_strat, &mut st_ktn, &mut st_hasres, &mut st_equi);

    // 5. Bound sources (base + non-anti steps): rebind targets for the sort /
    // output phases; idx = the generated row-index expression per source. A
    // traversal step's rebind source is its FIELD-PATH expression — its base
    // var rebinds at an EARLIER slot (chain order), so `&(d.emps)[ix]` is
    // well-scoped in the output phase; byval steps rebind by value.
    let mut bnd_src: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    let mut bnd_ty:  [str; 9] = ["", "", "", "", "", "", "", "", ""];
    let mut bnd_var: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    let mut bnd_byval: [bool; 9] = [false; 9];
    let mut bnd_idx: [String; 9] = [String::new(), String::new(), String::new(), String::new(),
                                    String::new(), String::new(), String::new(), String::new(),
                                    String::new()];
    bnd_src[0] = ch.base_src;
    bnd_ty[0]  = ch.base_ty;
    bnd_var[0] = ch.base_var;
    bnd_idx[0].push_str("__i0");
    let mut nb: i64 = 1i64;
    let mut bi: i64 = 0i64;
    while bi < ch.n {
        if !ch.anti[bi] {
            bnd_src[nb] = ch.src[bi];
            bnd_ty[nb]  = ch.ty[bi];
            bnd_var[nb] = ch.var[bi];
            bnd_byval[nb] = ch.byval[bi];
            if st_strat[bi] == JS_LOOP() { bnd_idx[nb].push_str("__j"); }
            else                         { bnd_idx[nb].push_str("__ri"); }
            bnd_idx[nb].push_i64(bi + 1i64);
            nb = nb + 1i64;
        }
        bi = bi + 1i64;
    }

    // 6. Head + strategy trace + build phases.
    let mut em: Emitter = Emitter::new();
    let mut __uses: String = String::new();
    prm.native_use_text(&mut __uses);
    begin_chunk(&mut em, &view, string_as_str(&__uses));
    emit_fn_head(&mut em, fn_name, params_text, prm.tparams);
    if first {
        em.push_text(") -> Result<Option<");
        em.push_text(result_ty);
        em.push_text(">, ElError> {\n");
        em.push_text(prelude);
    } else {
        em.push_text(") -> Result<Vec<");
        em.push_text(result_ty);
        em.push_text(">, ElError> {\n");
        em.push_text(prelude);
        em.push_text("    let mut __out: Vec<");
        em.push_text(result_ty);
        em.push_text("> = Vec::<");
        em.push_text(result_ty);
        em.push_text(">::new();\n");
    }
    let mut ci: i64 = 0i64;
    while ci < ch.n {
        emit_strategy_comment(&mut em, ci + 1i64, st_strat[ci], ch.anti[ci],
                              st_equi[ci], st_hasres[ci], st_ktn[ci], ch.edge[ci]);
        ci = ci + 1i64;
    }
    let mut bpi: i64 = 0i64;
    while bpi < ch.n {
        emit_build_phase(&mut em, bpi + 1i64, st_strat[bpi], ch.anti[bpi], st_hasres[bpi],
                         st_ktn[bpi], ch.src[bpi], ch.ty[bpi], ch.var[bpi],
                         string_as_str(&st_build[bpi]));
        bpi = bpi + 1i64;
    }
    if has_sort {
        // Phase 1 collects matched bound-row index tuples + sort keys.
        let mut dk: i64 = 0i64;
        while dk < nb {
            em.push_text("    let mut ");
            push_nk(&mut em, "__ix", dk);
            em.push_text(": Vec<i64> = Vec::<i64>::new();\n");
            dk = dk + 1i64;
        }
        em.push_text("    let mut __ks: Vec<");
        em.push_text(key_ty);
        em.push_text("> = Vec::<");
        em.push_text(key_ty);
        em.push_text(">::new();\n");
    }

    // 7. The loop nest: base scan + one level per step.
    let mut lvl: i64 = 1i64;
    push_ind(&mut em, lvl);
    em.push_text("let mut __i0: i64 = 0i64;\n");
    push_ind(&mut em, lvl);
    em.push_text("while __i0 < (");
    em.push_text(ch.base_src);
    em.push_text(").len()");
    em.push_text(lim_use);
    em.push_text(" {\n");
    lvl = lvl + 1i64;
    push_ind(&mut em, lvl);
    em.push_text("let ");
    em.push_text(ch.base_var);
    em.push_text(": &");
    em.push_text(ch.base_ty);
    em.push_text(" = &(");
    em.push_text(ch.base_src);
    em.push_text(")[__i0];\n");
    let mut opens: [i64; 8] = [0i64; 8];
    let mut oi: i64 = 0i64;
    while oi < ch.n {
        opens[oi] = emit_step_open(&mut em, lvl, oi + 1i64, st_strat[oi], ch.anti[oi],
                                   st_hasres[oi], st_ktn[oi], ch.src[oi], ch.ty[oi],
                                   ch.var[oi], ch.byval[oi], string_as_str(&st_probe[oi]),
                                   string_as_str(&st_resid[oi]), string_as_str(&st_pred[oi]),
                                   lim_use);
        lvl = lvl + opens[oi];
        oi = oi + 1i64;
    }

    // 8. The SHARED inner body.
    if has_where {
        push_ind(&mut em, lvl);
        em.push_text("if (");
        em.push_text(string_as_str(&where_body));
        em.push_text(") {\n");
        lvl = lvl + 1i64;
    }
    if has_sort {
        let mut pk: i64 = 0i64;
        while pk < nb {
            push_ind(&mut em, lvl);
            push_nk(&mut em, "__ix", pk);
            em.push_text(".push(");
            em.push_text(string_as_str(&bnd_idx[pk]));
            em.push_text(");\n");
            pk = pk + 1i64;
        }
        push_ind(&mut em, lvl);
        em.push_text("__ks.push(");
        em.push_text(string_as_str(&key_body));
        em.push_text(");\n");
    } else if first {
        push_ind(&mut em, lvl);
        em.push_text("return Result::Ok(Option::Some(");
        em.push_text(string_as_str(&proj_body));
        em.push_text("));\n");
    } else {
        let inds: String = ind_string(lvl);
        emit_push_guarded(&mut em, string_as_str(&inds), result_ty,
                          string_as_str(&proj_body), mods.distinct);
    }
    if has_where {
        lvl = lvl - 1i64;
        push_ind(&mut em, lvl);
        em.push_text("}\n");
    }

    // 9. Close the nest (reverse order), bump the base index, close the base.
    let mut ki: i64 = ch.n - 1i64;
    while ki >= 0i64 {
        let closed: i64 = emit_step_close(&mut em, lvl, ki + 1i64, st_strat[ki],
                                          ch.anti[ki], st_hasres[ki]);
        lvl = lvl - closed;
        ki = ki - 1i64;
    }
    push_ind(&mut em, lvl);
    em.push_text("__i0 = __i0 + 1i64;\n");
    lvl = lvl - 1i64;
    push_ind(&mut em, lvl);
    em.push_text("}\n");

    // 10. Sort output phase: order the index tuples, re-bind, project.
    if has_sort {
        emit_sort_perm(&mut em, key_ty, mods.sort_desc, nb);
        if first {
            em.push_text("    if __ix0.len() > 0i64 {\n");
            let mut rk: i64 = 0i64;
            while rk < nb {
                em.push_text("        let ");
                em.push_text(bnd_var[rk]);
                em.push_text(": ");
                if !bnd_byval[rk] { em.push_text("&"); }
                em.push_text(bnd_ty[rk]);
                em.push_text(" = ");
                if !bnd_byval[rk] { em.push_text("&"); }
                em.push_text("(");
                em.push_text(bnd_src[rk]);
                em.push_text(")[");
                push_nk(&mut em, "__ix", rk);
                em.push_text(".get(0i64)];\n");
                rk = rk + 1i64;
            }
            em.push_text("        return Result::Ok(Option::Some(");
            em.push_text(string_as_str(&proj_body));
            em.push_text("));\n");
            em.push_text("    }\n");
        } else {
            em.push_text("    let mut __o: i64 = 0i64;\n");
            em.push_text("    while __o < __ix0.len()");
            em.push_text(string_as_str(&lim_cond));
            em.push_text(" {\n");
            let mut rk2: i64 = 0i64;
            while rk2 < nb {
                em.push_text("        let ");
                em.push_text(bnd_var[rk2]);
                em.push_text(": ");
                if !bnd_byval[rk2] { em.push_text("&"); }
                em.push_text(bnd_ty[rk2]);
                em.push_text(" = ");
                if !bnd_byval[rk2] { em.push_text("&"); }
                em.push_text("(");
                em.push_text(bnd_src[rk2]);
                em.push_text(")[");
                push_nk(&mut em, "__ix", rk2);
                em.push_text(".get(__o)];\n");
                rk2 = rk2 + 1i64;
            }
            emit_push_guarded(&mut em, "        ", result_ty,
                              string_as_str(&proj_body), mods.distinct);
            em.push_text("        __o = __o + 1i64;\n");
            em.push_text("    }\n");
        }
    }
    if first {
        em.push_text("    return Result::Ok(Option::None);\n");
    } else {
        em.push_text("    return Result::Ok(__out);\n");
    }
    em.push_text("}\n");
    em.commit();
    return true;
}

// ── emit_aggregate — group-by + aggregate (mirror walk_aggregate) ─────────────
// `having_ref`/`has_having` — the post-aggregation filter over the group rows
// (predicate over the group `key` + aggregate output names). With any of
// having / order / distinct / limit the group COLUMNS are materialized into
// parallel Vecs (key + one per aggregate) and the projection runs as a separate
// output phase (having filters at materialization; order sorts a group-row
// permutation — stable insertion sort, O(n²) MVP; distinct dedups projected
// values; limit caps via the output-loop condition). Without modifiers the
// original single-pass push shape is emitted unchanged.
//
// A JOIN-CHAIN input (the aggregate-over-joined-stream shape) routes to
// `emit_aggregate_join` — a single-pass fold over the joined rows with the
// same group-column output phase.
fn emit_aggregate(scan_e: RExpr, key_ref: WRef<SExpr>, aggs: RAggArr,
                  where_ref: WRef<SExpr>, has_where: bool,
                  having_ref: WRef<SExpr>, has_having: bool, sel: WRef<SExpr>,
                  mods: QMods,
                  fn_name: str, params_text: str, prm: &MacroParams,
                  result_ty0: str, has_result_ty: bool, prelude: str, h: &Writ) -> bool {
    // Decompose the input: a bare scan keeps the classic two-pass shape below;
    // a join chain (≥ 1 step) takes the joined-stream fold.
    let mut ch: JChain = jchain_new();
    collect_chain(scan_e, &mut ch);
    if ch.n > 0i64 {
        return emit_aggregate_join(&ch, key_ref, aggs, where_ref, has_where,
                                   having_ref, has_having, sel, mods,
                                   fn_name, params_text, prm, result_ty0, has_result_ty, prelude, h);
    }
    let a_name: str = ch.base_src;
    let a_ty: str   = ch.base_ty;
    let x_var: str  = ch.base_var;

    let acount: i64 = aggs.len();

    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, a_ty);
    stamp_rel_source(&mut ty, prm, a_name, x_var);
    apply_scalar_params(&mut ty, prm);
    stamp_udfs_from_module(&view, &mut ty);

    // Group KEY: infer its EL type from the row env (i64/str/bool; f64 has no
    // Eq/Hash — named diagnostic) and stamp `key` with it for the having/
    // order/select scope. `key_ty` also types __k / __seen / __g_key below.
    let key_e: SExpr = key_ref.any().view::<SExpr>();
    if !reject_tuple(key_e, "wql!: `group by`") { return false; }
    if !check_calls(key_e, &ty, "wql!: `group by`") { return false; }
    let key_opt: SExpr = simplify_sexpr(key_e, h).any().view::<SExpr>();
    let key_ety: i32 = infer_ty(key_opt, &ty);
    if key_ety == EL_TY_FLT() {
        error("wql!: a `group by` key cannot be f64 (floats have no Eq/Hash) — cast to an integral type or group by an i64/str/bool key");
        return false;
    }
    let key_ty: str = el_ty_name(key_ety);
    ty.set_ty("key", key_ety);
    let mut agg_flt:  [bool; 8] = [false; 8];
    let mut agg_cast: [bool; 8] = [false; 8];
    compute_agg_reprs(&aggs, acount, &ty, &mut agg_flt, &mut agg_cast);
    // UDA resolution (naming-convention triple) + finalized column types.
    let mut uda:     [bool; 8] = [false; 8];
    let mut uda_fin: [bool; 8] = [false; 8];
    let mut uda_acc: [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut uda_ret: [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut aret:    [i32; 8]  = [0i32; 8];
    if !resolve_aggs(&view, &aggs, acount, &mut uda, &mut uda_fin,
                     &mut uda_acc, &mut uda_ret, &mut aret) { return false; }
    stamp_agg_out_types(&aggs, acount, &agg_flt, &uda, &aret, &mut ty);
    let mut act: [str; 8] = ["", "", "", "", "", "", "", ""];
    compute_agg_col_tys(acount, &agg_flt, &uda, &aret, &mut act);

    let proj_e: SExpr = sel.any().view::<SExpr>();
    if !check_calls(proj_e, &ty, "wql!: `select`") { return false; }

    let proj_opt: SExpr = simplify_sexpr(proj_e, h).any().view::<SExpr>();

    let mut result_ty: str = result_ty0;
    if !has_result_ty {
        result_ty = el_ty_name(infer_ty(proj_opt, &ty));
        // Owned-String projection (String-returning call at the select root).
        if returns_string(proj_opt, &ty) { result_ty = "String"; }
    }
    // Tuple projection over the group row (`select (key, n, mean)` — group key +
    // aggregate outputs in ONE result row): element type = the tuple type text.
    let mut tuple_tt: String = String::new();
    let tres: i32 = tuple_result(proj_opt, &ty, has_result_ty, mods.distinct, &mut tuple_tt);
    if tres < 0i32 { return false; }
    if tres > 0i32 { result_ty = string_as_str(&tuple_tt); }

    let mut key_body: String = String::new();
    emit_sexpr(&mut key_body, key_opt, &ty, x_var);
    let mut where_body: String = String::new();
    if has_where {
        let where_sexpr: SExpr = where_ref.any().view::<SExpr>();
        if !reject_tuple(where_sexpr, "wql!: `where`") { return false; }
        if !check_calls(where_sexpr, &ty, "wql!: `where`") { return false; }
        let where_opt: SExpr = simplify_sexpr(where_sexpr, h).any().view::<SExpr>();
        emit_sexpr(&mut where_body, where_opt, &ty, x_var);
    }
    let mut proj_body: String = String::new();
    emit_sexpr(&mut proj_body, proj_opt, &ty, x_var);
    // The HAVING predicate + the `order by` key range over the group `key` +
    // aggregate OUTPUT names (typed above), not the row var.
    let mut having_body: String = String::new();
    if has_having {
        let hav_e: SExpr = having_ref.any().view::<SExpr>();
        if !reject_tuple(hav_e, "wql!: `having`") { return false; }
        if !check_calls(hav_e, &ty, "wql!: `having`") { return false; }
        let hav_opt: SExpr = simplify_sexpr(hav_e, h).any().view::<SExpr>();
        emit_sexpr(&mut having_body, hav_opt, &ty, x_var);
    }
    let mut okey_body: String = String::new();
    let mut okey_ty: str = "i64";
    if mods.has_sort {
        let okey_e: SExpr = mods.sort_key.any().view::<SExpr>();
        if !reject_tuple(okey_e, "wql!: `order by`") { return false; }
        if !check_calls(okey_e, &ty, "wql!: `order by`") { return false; }
        let okey_opt: SExpr = simplify_sexpr(okey_e, h).any().view::<SExpr>();
        okey_ty = el_ty_name(infer_ty(okey_opt, &ty));
        emit_sexpr(&mut okey_body, okey_opt, &ty, x_var);
    }
    let lim_cond: String = limit_cond_text(&mods);
    // Any modifier ⇒ materialize the group columns + separate output phase.
    let mods_any: bool = has_having || mods.has_sort || mods.distinct || mods.has_limit;

    let mut agg_body: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    if !compute_agg_bodies(&aggs, acount, &ty, x_var, h, &uda, &mut agg_body) { return false; }

    let mut em: Emitter = Emitter::new();
    let mut __uses: String = String::new();
    prm.native_use_text(&mut __uses);
    begin_chunk(&mut em, &view, string_as_str(&__uses));
    emit_fn_head(&mut em, fn_name, params_text, prm.tparams);
    em.push_text(") -> Result<Vec<");
    em.push_text(result_ty);
    em.push_text(">, ElError> {\n");
    em.push_text(prelude);
    em.push_text("    let mut __out: Vec<");
    em.push_text(result_ty);
    em.push_text("> = Vec::<");
    em.push_text(result_ty);
    em.push_text(">::new();\n");
    if mods_any {
        // Materialized group columns: `key` + one Vec per aggregate output
        // (typed by the finalized column type — UDA outputs carry R's lattice
        // type, builtins the f64/i64 split).
        em.push_text("    let mut __g_key: Vec<");
        em.push_text(key_ty);
        em.push_text("> = Vec::<");
        em.push_text(key_ty);
        em.push_text(">::new();\n");
        let mut gd: i64 = 0i64;
        while gd < acount {
            let a: RAgg = aggs.agg_at(gd);
            em.push_text("    let mut __g_");
            em.push_text(a.out);
            em.push_text(": Vec<");
            em.push_text(act[gd]);
            em.push_text("> = Vec::<");
            em.push_text(act[gd]);
            em.push_text(">::new();\n");
            gd = gd + 1i64;
        }
    }
    em.push_text("    let mut __seen: Vec<");
    em.push_text(key_ty);
    em.push_text("> = Vec::<");
    em.push_text(key_ty);
    em.push_text(">::new();\n");
    em.push_text("    let mut __i: i64 = 0i64;\n");
    em.push_text("    while __i < (");
    em.push_text(a_name);
    em.push_text(").len() {\n");
    em.push_text("        let ");
    em.push_text(x_var);
    em.push_text(": &");
    em.push_text(a_ty);
    em.push_text(" = &(");
    em.push_text(a_name);
    em.push_text(")[__i];\n");
    if has_where {
        em.push_text("        if (");
        em.push_text(string_as_str(&where_body));
        em.push_text(") {\n");
    }
    em.push_text("        let __k: ");
    em.push_text(key_ty);
    em.push_text(" = (");
    em.push_text(string_as_str(&key_body));
    em.push_text(");\n");
    em.push_text("        let mut __f: bool = false;\n");
    em.push_text("        let mut __s: i64 = 0i64;\n");
    em.push_text("        while __s < __seen.len() { if __seen.get(__s) == __k { __f = true; } __s = __s + 1i64; }\n");
    em.push_text("        if (!__f) {\n");
    em.push_text("            __seen.push(__k);\n");
    let mut c0: i64 = 0i64;
    while c0 < acount {
        let a: RAgg = aggs.agg_at(c0);
        let fnid: i32 = agg_of_name(a.fn_name);
        em.push_text("            let mut __agg_");
        em.push_text(a.out);
        if uda[c0] {
            // UDA accumulator: the user's A type, seeded by <name>_init().
            em.push_text(": ");
            em.push_text(uda_acc[c0]);
            em.push_text(" = ");
            em.push_text(a.fn_name);
            em.push_text("_init();\n");
        } else if agg_flt[c0] {
            // f64 accumulator: min/max seed with ±f64::MAX (finite extremes).
            if fnid == AGG_MIN() {
                em.push_text(": f64 = 1.7976931348623157e308f64;\n");
            } else if fnid == AGG_MAX() {
                em.push_text(": f64 = -1.7976931348623157e308f64;\n");
            } else {
                em.push_text(": f64 = 0.0f64;\n");
            }
        } else if fnid == AGG_MIN() {
            em.push_text(": i64 = 9223372036854775807i64;\n");
        } else if fnid == AGG_MAX() {
            em.push_text(": i64 = -9223372036854775808i64;\n");
        } else {
            em.push_text(": i64 = 0i64;\n");
        }
        c0 = c0 + 1i64;
    }
    em.push_text("            let mut __cnt: i64 = 0i64;\n");
    em.push_text("            let mut __j: i64 = 0i64;\n");
    em.push_text("            while __j < (");
    em.push_text(a_name);
    em.push_text(").len() {\n");
    em.push_text("                let ");
    em.push_text(x_var);
    em.push_text(": &");
    em.push_text(a_ty);
    em.push_text(" = &(");
    em.push_text(a_name);
    em.push_text(")[__j];\n");
    if has_where {
        em.push_text("                if (");
        em.push_text(string_as_str(&where_body));
        em.push_text(") {\n");
    }
    em.push_text("                if ((");
    em.push_text(string_as_str(&key_body));
    em.push_text(") == __k) {\n");
    em.push_text("                    __cnt = __cnt + 1i64;\n");
    let mut c1: i64 = 0i64;
    while c1 < acount {
        let a: RAgg = aggs.agg_at(c1);
        let aname2: str = a.out;
        let fnid2: i32 = agg_of_name(a.fn_name);
        if uda[c1] {
            // UDA fold: acc = <name>_step(acc, <arg>).
            em.push_text("                    __agg_");
            em.push_text(aname2);
            em.push_text(" = ");
            em.push_text(a.fn_name);
            em.push_text("_step(__agg_");
            em.push_text(aname2);
            em.push_text(", (");
            em.push_text(string_as_str(&agg_body[c1]));
            em.push_text("));\n");
        } else if fnid2 == AGG_COUNT() {
            em.push_text("                    __agg_");
            em.push_text(aname2);
            em.push_text(" = __agg_");
            em.push_text(aname2);
            em.push_text(" + 1i64;\n");
        } else if fnid2 == AGG_SUM() && !agg_flt[c1] {
            // i64 `sum` ACCUMULATOR is error-returning: a running-total overflow
            // becomes Err(ElError) via el_add(…)?, never a trap — the sibling of
            // EL scalar arithmetic (the arg is already checked) and of the
            // dynamic/incremental sum accumulators.
            em.push_text("                    __agg_");
            em.push_text(aname2);
            em.push_text(" = el_add(__agg_");
            em.push_text(aname2);
            em.push_text(", (");
            em.push_text(string_as_str(&agg_body[c1]));
            em.push_text("))?;\n");
        } else if fnid2 == AGG_SUM() || fnid2 == AGG_AVG() {
            em.push_text("                    __agg_");
            em.push_text(aname2);
            em.push_text(" = __agg_");
            em.push_text(aname2);
            // avg over an INT arg folds into an f64 accumulator: explicit cast
            // (Logos has no implicit int→float).
            if agg_cast[c1] { em.push_text(" + ((");  } else { em.push_text(" + ("); }
            em.push_text(string_as_str(&agg_body[c1]));
            if agg_cast[c1] { em.push_text(") as f64);\n"); } else { em.push_text(");\n"); }
        } else if fnid2 == AGG_MIN() {
            if agg_flt[c1] { em.push_text("                    { let __v: f64 = ("); }
            else           { em.push_text("                    { let __v: i64 = ("); }
            em.push_text(string_as_str(&agg_body[c1]));
            em.push_text("); if __v < __agg_");
            em.push_text(aname2);
            em.push_text(" { __agg_");
            em.push_text(aname2);
            em.push_text(" = __v; } }\n");
        } else {
            if agg_flt[c1] { em.push_text("                    { let __v: f64 = ("); }
            else           { em.push_text("                    { let __v: i64 = ("); }
            em.push_text(string_as_str(&agg_body[c1]));
            em.push_text("); if __v > __agg_");
            em.push_text(aname2);
            em.push_text(" { __agg_");
            em.push_text(aname2);
            em.push_text(" = __v; } }\n");
        }
        c1 = c1 + 1i64;
    }
    em.push_text("                }\n");
    if has_where { em.push_text("                }\n"); }
    em.push_text("                __j = __j + 1i64;\n");
    em.push_text("            }\n");
    em.push_text("            let key: ");
    em.push_text(key_ty);
    em.push_text(" = __k;\n");
    let mut c2: i64 = 0i64;
    while c2 < acount {
        let a: RAgg = aggs.agg_at(c2);
        let aname3: str = a.out;
        let fnid3: i32 = agg_of_name(a.fn_name);
        em.push_text("            let ");
        em.push_text(aname3);
        em.push_text(": ");
        em.push_text(act[c2]);
        em.push_text(" = ");
        if uda[c2] {
            // UDA finalize: <name>_fin(acc) (or the bare acc without _fin).
            let mut acc_txt: String = String::new();
            acc_txt.push_str("__agg_");
            acc_txt.push_str(aname3);
            emit_uda_finalize(&mut em, a.fn_name, string_as_str(&acc_txt),
                              uda_fin[c2], uda_fin_cast(act[c2], uda_ret[c2]));
            em.push_text(";\n");
        } else if fnid3 == AGG_AVG() {
            // avg is ALWAYS f64: an f64 accumulator divided by the (cast) count
            // — the exact mean, no integer truncation.
            em.push_text("(if __cnt > 0i64 { __agg_");
            em.push_text(aname3);
            em.push_text(" / (__cnt as f64) } else { 0.0f64 });\n");
        } else {
            em.push_text("__agg_");
            em.push_text(aname3);
            em.push_text(";\n");
        }
        c2 = c2 + 1i64;
    }
    if mods_any {
        // HAVING gates the group row at materialization; the projection runs in
        // the separate output phase below.
        if has_having {
            em.push_text("            if (");
            em.push_text(string_as_str(&having_body));
            em.push_text(") {\n");
        }
        em.push_text("            __g_key.push(key);\n");
        let mut gp: i64 = 0i64;
        while gp < acount {
            let a: RAgg = aggs.agg_at(gp);
            em.push_text("            __g_");
            em.push_text(a.out);
            em.push_text(".push(");
            em.push_text(a.out);
            em.push_text(");\n");
            gp = gp + 1i64;
        }
        if has_having { em.push_text("            }\n"); }
    } else {
        em.push_text("            __out.push(");
        em.push_text(string_as_str(&proj_body));
        em.push_text(");\n");
    }
    em.push_text("        }\n");
    if has_where { em.push_text("        }\n"); }
    em.push_text("        __i = __i + 1i64;\n");
    em.push_text("    }\n");
    if mods_any {
        // Output phase: order the group-row permutation (or keep discovery
        // order), then re-bind the group columns per row and project.
        em.push_text("    let mut __ix0: Vec<i64> = Vec::<i64>::new();\n");
        if mods.has_sort {
            em.push_text("    let mut __ks: Vec<");
            em.push_text(okey_ty);
            em.push_text("> = Vec::<");
            em.push_text(okey_ty);
            em.push_text(">::new();\n");
        }
        em.push_text("    let mut __r: i64 = 0i64;\n");
        em.push_text("    while __r < __g_key.len() {\n");
        if mods.has_sort {
            emit_group_binds(&mut em, "        ", "__r", &aggs, acount, &act, "__g_", key_ty);
            em.push_text("        __ix0.push(__r);\n");
            em.push_text("        __ks.push(");
            em.push_text(string_as_str(&okey_body));
            em.push_text(");\n");
        } else {
            em.push_text("        __ix0.push(__r);\n");
        }
        em.push_text("        __r = __r + 1i64;\n");
        em.push_text("    }\n");
        if mods.has_sort {
            emit_sort_perm(&mut em, okey_ty, mods.sort_desc, 1i64);
        }
        em.push_text("    let mut __o: i64 = 0i64;\n");
        em.push_text("    while __o < __ix0.len()");
        em.push_text(string_as_str(&lim_cond));
        em.push_text(" {\n");
        emit_group_binds(&mut em, "        ", "__ix0.get(__o)", &aggs, acount, &act, "__g_", key_ty);
        emit_push_guarded(&mut em, "        ", result_ty, string_as_str(&proj_body), mods.distinct);
        em.push_text("        __o = __o + 1i64;\n");
        em.push_text("    }\n");
    }
    em.push_text("    return Result::Ok(__out);\n");
    em.push_text("}\n");
    em.commit();
    return true;
}

// Emit the group-column re-binds for one materialized group row (`key` + each
// aggregate output as a local of its declared name, read from the parallel
// Vecs at index expression `idx`). `pfx` is the column-Vec name prefix —
// "__g_" for the classic two-pass shape, "__gf_" for the joined-stream fold's
// finalized columns.
fn emit_group_binds(em: &mut Emitter, indent: str, idx: str,
                    aggs: &RAggArr, acount: i64, act: &[str; 8], pfx: str,
                    key_ty: str) {
    em.push_text(indent);
    em.push_text("let key: ");
    em.push_text(key_ty);
    em.push_text(" = ");
    em.push_text(pfx);
    em.push_text("key.get(");
    em.push_text(idx);
    em.push_text(");\n");
    let mut gi: i64 = 0i64;
    while gi < acount {
        let a: RAgg = aggs.agg_at(gi);
        em.push_text(indent);
        em.push_text("let ");
        em.push_text(a.out);
        em.push_text(": ");
        em.push_text(act[gi]);
        em.push_text(" = ");
        em.push_text(pfx);
        em.push_text(a.out);
        em.push_text(".get(");
        em.push_text(idx);
        em.push_text(");\n");
        gi = gi + 1i64;
    }
}

// ── Shared aggregate-spec computation (classic + joined-stream paths) ────────
// Per-aggregate OUTPUT value-type + accumulator width:
//   • count → INT (always an i64 row count);
//   • avg   → FLT ALWAYS (exact mean, f64 accumulator + f64 division — no
//             integer truncation), for BOTH int and float arguments;
//   • sum/min/max → the ARGUMENT's type: an f64-typed arg gets an f64
//             accumulator + f64 result column, an int arg stays i64.
// `agg_flt[i]`  — this aggregate's accumulator/result is f64;
// `agg_cast[i]` — the fold step must cast the (INT-typed) arg to f64 (only
//                 avg over an int argument). Row-field types are already
//                 stamped (schema + scalar params), so the arg infer here is
//                 well-typed.
fn compute_agg_reprs(aggs: &RAggArr, acount: i64, t: &ElTypes,
                     agg_flt: &mut [bool; 8], agg_cast: &mut [bool; 8]) {
    let mut ki: i64 = 0i64;
    while ki < acount {
        let ka: RAgg = aggs.agg_at(ki);
        let kfn: i32 = agg_of_name(ka.fn_name);
        let mut arg_is_flt: bool = false;
        if ka.has_arg {
            if infer_ty(ka.arg_expr(), t) == EL_TY_FLT() { arg_is_flt = true; }
        }
        // THE SHARED RULE TABLE (el::agg_result_ty — one source for static +
        // dynamic tiers): FLT result ⇔ f64 accumulator/column. count → INT,
        // sum/min/max → arg type, avg → Quot(T) = FLT; UDA / out-of-domain
        // names return -1 (their repr is decided by the UDA machinery).
        let aty: i32 = if arg_is_flt { EL_TY_FLT() } else { EL_TY_INT() };
        let is_f: bool = agg_result_ty(ka.fn_name, aty) == EL_TY_FLT();
        if ki < 8i64 {
            agg_flt[ki]  = is_f;
            agg_cast[ki] = is_f && !arg_is_flt && kfn != AGG_COUNT();
        }
        ki = ki + 1i64;
    }
}

// Stamp each aggregate OUTPUT name's EL value-type into `ty` (the having /
// order / select clauses reference the outputs by name). A UDA output carries
// its reflected finalizer-result class (`aret`); a builtin stays on the
// agg_flt-driven FLT/INT split.
fn stamp_agg_out_types(aggs: &RAggArr, acount: i64, agg_flt: &[bool; 8],
                       uda: &[bool; 8], aret: &[i32; 8], ty: &mut ElTypes) {
    let mut i: i64 = 0i64;
    while i < acount {
        let a: RAgg = aggs.agg_at(i);
        if uda[i] {
            ty.set_ty(a.out, aret[i]);
        } else if agg_flt[i] {
            ty.set_ty(a.out, EL_TY_FLT());
        } else {
            ty.set_ty(a.out, EL_TY_INT());
        }
        i = i + 1i64;
    }
}

// Validate each aggregate spec (known fn / resolved UDA, arg presence, arg-
// expression calls) and emit its ARG expression text. False (error surfaced)
// on a bad spec. `uda` marks the specs `resolve_aggs` accepted as user
// aggregates (a UDA REQUIRES an argument — the zero-arg `m = myagg()` form is
// out of scope and diagnosed via the shared arg-presence error).
fn compute_agg_bodies(aggs: &RAggArr, acount: i64, t: &ElTypes, var0: str, h: &Writ,
                      uda: &[bool; 8], agg_body: &mut [String; 8]) -> bool {
    let mut ai: i64 = 0i64;
    while ai < acount {
        let a: RAgg = aggs.agg_at(ai);
        let fnid: i32 = agg_of_name(a.fn_name);
        if fnid == 0i32 && !uda[ai] { error("wql!: aggregate fn must be count/sum/min/max/avg or a user aggregate (X_init/X_step[/X_fin])"); return false; }
        if fnid != AGG_COUNT() {
            if !a.has_arg { error("wql!: aggregate fn expects an argument (zero-argument user aggregates are not supported)"); return false; }
            if !reject_tuple(a.arg_expr(), "wql!: `aggregate`") { return false; }
            if !check_calls(a.arg_expr(), t, "wql!: `aggregate`") { return false; }
            let ae_opt: SExpr = simplify_sexpr(a.arg_expr(), h).any().view::<SExpr>();
            emit_sexpr(&mut agg_body[ai], ae_opt, t, var0);
        }
        ai = ai + 1i64;
    }
    return true;
}

// ── UDA resolution (user-defined aggregates — the naming-convention triple) ──
// `aggregate m = myagg(e.x)` with a NON-builtin fn name resolves against the
// trigger module's top-level fns by NAMING CONVENTION:
//   myagg_init() -> A                — accumulator creation (arity 0);
//   myagg_step(acc: A, x: T) -> A    — per-row fold (arity 2);
//   myagg_fin(acc: A) -> R           — OPTIONAL finalize (arity 1); absent ⇒ R = A.
// A (the accumulator type) is threaded VERBATIM through the generated code
// (any user type — struct accumulators included); only R must map into the EL
// lattice (`el_ret_class`; narrower ints widen `as i64`, f32 `as f64`). An
// R of `String` is REJECTED for now: aggregate outputs are materialized into
// group COLUMNS + rebound as locals, and a borrowed `str` view of an owned
// String column has no sound owner in that shape (deferred).
// All of this is METACALL-TIME data only — the IR keeps just `RAgg.fn_name`
// (queue-2: an interpreter re-resolves the same names against its registry).
// Outputs (parallel to the spec list): `uda` (is-UDA), `uda_fin` (has _fin),
// `uda_acc` (A, verbatim), `uda_ret` (R, verbatim), `aret` (R's EL class).
// False (error surfaced) on a convention violation.
fn resolve_aggs(view: &OView, aggs: &RAggArr, acount: i64,
                uda: &mut [bool; 8], uda_fin: &mut [bool; 8],
                uda_acc: &mut [str; 8], uda_ret: &mut [str; 8],
                aret: &mut [i32; 8]) -> bool {
    let mut i: i64 = 0i64;
    while i < acount {
        let a: RAgg = aggs.agg_at(i);
        let name: str = a.fn_name;
        if agg_of_name(name) != 0i32 {
            // Builtin aggregates SHADOW a same-named UDA triple.
            i = i + 1i64;
        } else {
            let mut nm_init: String = String::new();
            nm_init.push_str(name);
            nm_init.push_str("_init");
            let d_init: WAny = find_fn_decl(view, string_as_str(&nm_init));
            let mut nm_step: String = String::new();
            nm_step.push_str(name);
            nm_step.push_str("_step");
            let d_step: WAny = find_fn_decl(view, string_as_str(&nm_step));
            if d_init.is_null() || d_step.is_null() {
                let mut m: String = String::new();
                m.push_str("wql!: unknown aggregate '");
                m.push_str(name);
                m.push_str("' — builtin aggregates are count/sum/min/max/avg; a user aggregate requires top-level fns `");
                m.push_str(name);
                m.push_str("_init() -> A` and `");
                m.push_str(name);
                m.push_str("_step(acc: A, x: T) -> A` (plus optional `");
                m.push_str(name);
                m.push_str("_fin(acc: A) -> R`) declared in the module containing the query");
                if d_init.is_null() && !d_step.is_null() {
                    m.push_str(" (missing: `");
                    m.push_str(name);
                    m.push_str("_init`)");
                }
                if d_step.is_null() && !d_init.is_null() {
                    m.push_str(" (missing: `");
                    m.push_str(name);
                    m.push_str("_step`)");
                }
                error(string_as_str(&m));
                return false;
            }
            if fn_param_count(view, d_init) != 0i64 {
                let mut m1: String = String::new();
                m1.push_str("wql!: user aggregate '");
                m1.push_str(name);
                m1.push_str("': `");
                m1.push_str(name);
                m1.push_str("_init` must take no parameters (`");
                m1.push_str(name);
                m1.push_str("_init() -> A`)");
                error(string_as_str(&m1));
                return false;
            }
            let acc_ty: str = fn_ret_type_name(view, d_init);
            if acc_ty.len() == 0i64 {
                let mut m2: String = String::new();
                m2.push_str("wql!: user aggregate '");
                m2.push_str(name);
                m2.push_str("': `");
                m2.push_str(name);
                m2.push_str("_init` must declare a named accumulator return type (`-> A`)");
                error(string_as_str(&m2));
                return false;
            }
            if fn_param_count(view, d_step) != 2i64 {
                let mut m3: String = String::new();
                m3.push_str("wql!: user aggregate '");
                m3.push_str(name);
                m3.push_str("': `");
                m3.push_str(name);
                m3.push_str("_step` must take exactly (acc: A, x: T)");
                error(string_as_str(&m3));
                return false;
            }
            // Optional finalize: absent ⇒ R = A, no finalize call emitted.
            let mut nm_fin: String = String::new();
            nm_fin.push_str(name);
            nm_fin.push_str("_fin");
            let d_fin: WAny = find_fn_decl(view, string_as_str(&nm_fin));
            let mut has_fin: bool = false;
            let mut ret_ty: str = acc_ty;
            if !d_fin.is_null() {
                if fn_param_count(view, d_fin) != 1i64 {
                    let mut m4: String = String::new();
                    m4.push_str("wql!: user aggregate '");
                    m4.push_str(name);
                    m4.push_str("': `");
                    m4.push_str(name);
                    m4.push_str("_fin` must take exactly (acc: A)");
                    error(string_as_str(&m4));
                    return false;
                }
                has_fin = true;
                ret_ty = fn_ret_type_name(view, d_fin);
            }
            let cls: i32 = el_ret_class(ret_ty);
            if cls < 0i32 || str_eq(ret_ty, "String") {
                let mut m5: String = String::new();
                m5.push_str("wql!: user aggregate '");
                m5.push_str(name);
                m5.push_str("' result type `");
                m5.push_str(ret_ty);
                m5.push_str("` is outside the EL lattice — ");
                m5.push_str(name);
                if has_fin { m5.push_str("_fin"); } else { m5.push_str("_init (no _fin declared)"); }
                m5.push_str(" must return an integer, f64/f32, bool, or str value");
                error(string_as_str(&m5));
                return false;
            }
            if i < 8i64 {
                uda[i]     = true;
                uda_fin[i] = has_fin;
                uda_acc[i] = acc_ty;
                uda_ret[i] = ret_ty;
                aret[i]    = cls;
            }
            i = i + 1i64;
        }
    }
    return true;
}

// Per-aggregate finalized COLUMN type name (`act`): the Logos type of the
// aggregate's OUTPUT value — drives the materialized group-column Vecs, the
// finalize `let` bindings, and the group-row rebinds. Builtins keep the
// agg_flt-driven f64/i64 split; a UDA takes its reflected R class's lattice
// name (i64 / f64 / bool / str).
fn compute_agg_col_tys(acount: i64, agg_flt: &[bool; 8], uda: &[bool; 8],
                       aret: &[i32; 8], act: &mut [str; 8]) {
    let mut i: i64 = 0i64;
    while i < acount {
        if i < 8i64 {
            if uda[i] { act[i] = el_ty_name(aret[i]); }
            else if agg_flt[i] { act[i] = "f64"; }
            else { act[i] = "i64"; }
        }
        i = i + 1i64;
    }
}

// The finalize-expression CAST suffix for a UDA output: R narrower than the
// i64 lattice baseline widens `as i64`; an f32 R widens `as f64`; everything
// else emits bare. Empty string = no cast.
fn uda_fin_cast(col_ty: str, ret_ty: str) -> str {
    if str_eq(col_ty, "i64") && !str_eq(ret_ty, "i64") { return " as i64)"; }
    if str_eq(col_ty, "f64") && str_eq(ret_ty, "f32")  { return " as f64)"; }
    return "";
}

// Emit the finalize EXPRESSION for UDA spec `i` reading accumulator text
// `acc_txt` (a local name or a Vec-cell read): `<name>_fin(<acc>)` when the
// triple declares a finalizer, the bare accumulator otherwise — wrapped in the
// widening cast when R is narrower than its lattice column type.
fn emit_uda_finalize(em: &mut Emitter, name: str, acc_txt: str,
                     has_fin: bool, cast: str) {
    if cast.len() > 0i64 { em.push_text("(("); }
    if has_fin {
        em.push_text(name);
        em.push_text("_fin(");
        em.push_text(acc_txt);
        em.push_text(")");
    } else {
        em.push_text(acc_txt);
    }
    if cast.len() > 0i64 {
        em.push_text(")");
        em.push_text(cast);
    }
}

// ── emit_aggregate_join — group-by + aggregate over a JOINED stream ──────────
// The join steps reuse the chain machinery (strategy cascade + build phases +
// nest open/close); the inner body is a SINGLE-PASS group fold: find/insert
// the row's group (linear __g_key scan — the MVP dedup), bump the fold count,
// fold each aggregate accumulator incrementally (count/sum/min/max direct;
// avg = f64 sum + count, divided at finalization). A finalize pass computes
// the output columns (+ HAVING filter), then the group-row OUTPUT phase —
// order / distinct / limit / project — runs exactly like the classic shape's
// materialized-columns phase.
fn emit_aggregate_join(ch: &JChain, key_ref: WRef<SExpr>, aggs: RAggArr,
                       where_ref: WRef<SExpr>, has_where: bool,
                       having_ref: WRef<SExpr>, has_having: bool, sel: WRef<SExpr>,
                       mods: QMods,
                       fn_name: str, params_text: str, prm: &MacroParams,
                       result_ty0: str, has_result_ty: bool, prelude: str, h: &Writ) -> bool {
    let acount: i64 = aggs.len();

    // Types: every bound source's row schema + scalar params + key/outputs.
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, ch.base_ty);
    stamp_rel_source(&mut ty, prm, ch.base_src, ch.base_var);
    let mut si: i64 = 0i64;
    while si < ch.n {
        stamp_types_from_schema(&view, &mut ty, ch.ty[si]);
        stamp_rel_source(&mut ty, prm, ch.src[si], ch.var[si]);
        // Scalar-element traversal var: name → element value type (bare refs).
        if ch.byval[si] { ty.set_ty(ch.var[si], el_ty_of_name(ch.ty[si])); }
        si = si + 1i64;
    }
    apply_scalar_params(&mut ty, prm);
    stamp_udfs_from_module(&view, &mut ty);
    // Group KEY: infer + stamp (mirror of the classic shape; f64 keys get the
    // same named diagnostic). `key_ty` types __k / __g_key / group binds below.
    let key_e: SExpr = key_ref.any().view::<SExpr>();
    if !reject_tuple(key_e, "wql!: `group by`") { return false; }
    if !check_calls(key_e, &ty, "wql!: `group by`") { return false; }
    let key_opt: SExpr = simplify_sexpr(key_e, h).any().view::<SExpr>();
    let key_ety: i32 = infer_ty(key_opt, &ty);
    if key_ety == EL_TY_FLT() {
        error("wql!: a `group by` key cannot be f64 (floats have no Eq/Hash) — cast to an integral type or group by an i64/str/bool key");
        return false;
    }
    let key_ty: str = el_ty_name(key_ety);
    ty.set_ty("key", key_ety);
    let mut agg_flt:  [bool; 8] = [false; 8];
    let mut agg_cast: [bool; 8] = [false; 8];
    compute_agg_reprs(&aggs, acount, &ty, &mut agg_flt, &mut agg_cast);
    // UDA resolution (naming-convention triple) + finalized column types.
    let mut uda:     [bool; 8] = [false; 8];
    let mut uda_fin: [bool; 8] = [false; 8];
    let mut uda_acc: [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut uda_ret: [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut aret:    [i32; 8]  = [0i32; 8];
    if !resolve_aggs(&view, &aggs, acount, &mut uda, &mut uda_fin,
                     &mut uda_acc, &mut uda_ret, &mut aret) { return false; }
    stamp_agg_out_types(&aggs, acount, &agg_flt, &uda, &aret, &mut ty);
    let mut act: [str; 8] = ["", "", "", "", "", "", "", ""];
    compute_agg_col_tys(acount, &agg_flt, &uda, &aret, &mut act);

    // Validate clause calls (select / where / on preds; the key is validated above).
    if !check_calls(sel.any().view::<SExpr>(), &ty, "wql!: `select`") { return false; }
    if has_where {
        if !reject_tuple(where_ref.any().view::<SExpr>(), "wql!: `where`") { return false; }
        if !check_calls(where_ref.any().view::<SExpr>(), &ty, "wql!: `where`") { return false; }
    }
    let mut ci0: i64 = 0i64;
    while ci0 < ch.n {
        if ch.onw[ci0] != 0i64 {
            if !reject_tuple(sexpr_of_word(ch.onw[ci0]), "wql!: `on`") { return false; }
            if !check_calls(sexpr_of_word(ch.onw[ci0]), &ty, "wql!: `on`") { return false; }
        }
        ci0 = ci0 + 1i64;
    }

    // Clause bodies (`key_opt` is already simplified above).
    let proj_opt: SExpr = simplify_sexpr(sel.any().view::<SExpr>(), h).any().view::<SExpr>();
    let mut result_ty: str = result_ty0;
    if !has_result_ty {
        result_ty = el_ty_name(infer_ty(proj_opt, &ty));
        // Owned-String projection (String-returning call at the select root).
        if returns_string(proj_opt, &ty) { result_ty = "String"; }
    }
    // Tuple projection over the group row (join-aggregate shape).
    let mut tuple_tt: String = String::new();
    let tres: i32 = tuple_result(proj_opt, &ty, has_result_ty, mods.distinct, &mut tuple_tt);
    if tres < 0i32 { return false; }
    if tres > 0i32 { result_ty = string_as_str(&tuple_tt); }
    let mut key_body: String = String::new();
    emit_sexpr(&mut key_body, key_opt, &ty, ch.base_var);
    let mut where_body: String = String::new();
    if has_where {
        let where_opt: SExpr = simplify_sexpr(where_ref.any().view::<SExpr>(), h).any().view::<SExpr>();
        emit_sexpr(&mut where_body, where_opt, &ty, ch.base_var);
    }
    let mut proj_body: String = String::new();
    emit_sexpr(&mut proj_body, proj_opt, &ty, ch.base_var);
    let mut having_body: String = String::new();
    if has_having {
        let hav_e: SExpr = having_ref.any().view::<SExpr>();
        if !reject_tuple(hav_e, "wql!: `having`") { return false; }
        if !check_calls(hav_e, &ty, "wql!: `having`") { return false; }
        let hav_opt: SExpr = simplify_sexpr(hav_e, h).any().view::<SExpr>();
        emit_sexpr(&mut having_body, hav_opt, &ty, ch.base_var);
    }
    let mut okey_body: String = String::new();
    let mut okey_ty: str = "i64";
    if mods.has_sort {
        if !reject_tuple(mods.sort_key.any().view::<SExpr>(), "wql!: `order by`") { return false; }
        if !check_calls(mods.sort_key.any().view::<SExpr>(), &ty, "wql!: `order by`") { return false; }
        let okey_opt: SExpr = simplify_sexpr(mods.sort_key.any().view::<SExpr>(), h).any().view::<SExpr>();
        okey_ty = el_ty_name(infer_ty(okey_opt, &ty));
        emit_sexpr(&mut okey_body, okey_opt, &ty, ch.base_var);
    }
    let lim_cond: String = limit_cond_text(&mods);

    let mut agg_body: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    if !compute_agg_bodies(&aggs, acount, &ty, ch.base_var, h, &uda, &mut agg_body) { return false; }

    // Per-step strategy analysis (the same Part-2 cascade as the join shape).
    let mut st_build: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_probe: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_resid: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_pred:  [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_strat:  [i32; 8]  = [0i32; 8];
    let mut st_ktn:    [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut st_hasres: [bool; 8] = [false; 8];
    let mut st_equi:   [bool; 8] = [false; 8];
    analyze_chain(ch, &ty, ch.base_var, h,
                  &mut st_build, &mut st_probe, &mut st_resid, &mut st_pred,
                  &mut st_strat, &mut st_ktn, &mut st_hasres, &mut st_equi);

    // Head + strategy trace + build phases + accumulator columns.
    let mut em: Emitter = Emitter::new();
    let mut __uses: String = String::new();
    prm.native_use_text(&mut __uses);
    begin_chunk(&mut em, &view, string_as_str(&__uses));
    emit_fn_head(&mut em, fn_name, params_text, prm.tparams);
    em.push_text(") -> Result<Vec<");
    em.push_text(result_ty);
    em.push_text(">, ElError> {\n");
    em.push_text(prelude);
    em.push_text("    let mut __out: Vec<");
    em.push_text(result_ty);
    em.push_text("> = Vec::<");
    em.push_text(result_ty);
    em.push_text(">::new();\n");
    let mut ci: i64 = 0i64;
    while ci < ch.n {
        emit_strategy_comment(&mut em, ci + 1i64, st_strat[ci], ch.anti[ci],
                              st_equi[ci], st_hasres[ci], st_ktn[ci], ch.edge[ci]);
        ci = ci + 1i64;
    }
    let mut bpi: i64 = 0i64;
    while bpi < ch.n {
        emit_build_phase(&mut em, bpi + 1i64, st_strat[bpi], ch.anti[bpi], st_hasres[bpi],
                         st_ktn[bpi], ch.src[bpi], ch.ty[bpi], ch.var[bpi],
                         string_as_str(&st_build[bpi]));
        bpi = bpi + 1i64;
    }
    em.push_text("    let mut __g_key: Vec<");
    em.push_text(key_ty);
    em.push_text("> = Vec::<");
    em.push_text(key_ty);
    em.push_text(">::new();\n");
    em.push_text("    let mut __g_cnt: Vec<i64> = Vec::<i64>::new();\n");
    let mut gd: i64 = 0i64;
    while gd < acount {
        let a: RAgg = aggs.agg_at(gd);
        em.push_text("    let mut __ga_");
        em.push_text(a.out);
        if uda[gd] {
            // UDA accumulator column: the user's A type, threaded verbatim
            // (a struct accumulator must be Copy — Vec.get/set fold cells).
            em.push_text(": Vec<");
            em.push_text(uda_acc[gd]);
            em.push_text("> = Vec::<");
            em.push_text(uda_acc[gd]);
            em.push_text(">::new();\n");
        }
        else if agg_flt[gd] { em.push_text(": Vec<f64> = Vec::<f64>::new();\n"); }
        else                { em.push_text(": Vec<i64> = Vec::<i64>::new();\n"); }
        gd = gd + 1i64;
    }

    // The joined-stream nest (NO limit on the match loops — grouping needs
    // every row; `limit` caps the group-row OUTPUT phase below).
    let mut lvl: i64 = 1i64;
    push_ind(&mut em, lvl);
    em.push_text("let mut __i0: i64 = 0i64;\n");
    push_ind(&mut em, lvl);
    em.push_text("while __i0 < (");
    em.push_text(ch.base_src);
    em.push_text(").len() {\n");
    lvl = lvl + 1i64;
    push_ind(&mut em, lvl);
    em.push_text("let ");
    em.push_text(ch.base_var);
    em.push_text(": &");
    em.push_text(ch.base_ty);
    em.push_text(" = &(");
    em.push_text(ch.base_src);
    em.push_text(")[__i0];\n");
    let mut opens: [i64; 8] = [0i64; 8];
    let mut oi: i64 = 0i64;
    while oi < ch.n {
        opens[oi] = emit_step_open(&mut em, lvl, oi + 1i64, st_strat[oi], ch.anti[oi],
                                   st_hasres[oi], st_ktn[oi], ch.src[oi], ch.ty[oi],
                                   ch.var[oi], ch.byval[oi], string_as_str(&st_probe[oi]),
                                   string_as_str(&st_resid[oi]), string_as_str(&st_pred[oi]),
                                   "");
        lvl = lvl + opens[oi];
        oi = oi + 1i64;
    }

    // Inner body: the single-pass group fold.
    if has_where {
        push_ind(&mut em, lvl);
        em.push_text("if (");
        em.push_text(string_as_str(&where_body));
        em.push_text(") {\n");
        lvl = lvl + 1i64;
    }
    push_ind(&mut em, lvl);
    em.push_text("let __k: ");
    em.push_text(key_ty);
    em.push_text(" = (");
    em.push_text(string_as_str(&key_body));
    em.push_text(");\n");
    push_ind(&mut em, lvl);
    em.push_text("let mut __gi: i64 = -1i64;\n");
    push_ind(&mut em, lvl);
    em.push_text("let mut __s: i64 = 0i64;\n");
    push_ind(&mut em, lvl);
    em.push_text("while __s < __g_key.len() { if __g_key.get(__s) == __k { __gi = __s; } __s = __s + 1i64; }\n");
    push_ind(&mut em, lvl);
    em.push_text("if __gi < 0i64 {\n");
    push_ind(&mut em, lvl + 1i64);
    em.push_text("__g_key.push(__k);\n");
    push_ind(&mut em, lvl + 1i64);
    em.push_text("__g_cnt.push(0i64);\n");
    let mut sd: i64 = 0i64;
    while sd < acount {
        let a: RAgg = aggs.agg_at(sd);
        let fnid: i32 = agg_of_name(a.fn_name);
        push_ind(&mut em, lvl + 1i64);
        em.push_text("__ga_");
        em.push_text(a.out);
        if uda[sd] {
            // UDA group creation: seed with <name>_init().
            em.push_text(".push(");
            em.push_text(a.fn_name);
            em.push_text("_init());\n");
        } else if agg_flt[sd] {
            if fnid == AGG_MIN()      { em.push_text(".push(1.7976931348623157e308f64);\n"); }
            else if fnid == AGG_MAX() { em.push_text(".push(-1.7976931348623157e308f64);\n"); }
            else                      { em.push_text(".push(0.0f64);\n"); }
        } else if fnid == AGG_MIN() {
            em.push_text(".push(9223372036854775807i64);\n");
        } else if fnid == AGG_MAX() {
            em.push_text(".push(-9223372036854775808i64);\n");
        } else {
            em.push_text(".push(0i64);\n");
        }
        sd = sd + 1i64;
    }
    push_ind(&mut em, lvl + 1i64);
    em.push_text("__gi = __g_key.len() - 1i64;\n");
    push_ind(&mut em, lvl);
    em.push_text("}\n");
    push_ind(&mut em, lvl);
    em.push_text("__g_cnt.set(__gi, __g_cnt.get(__gi) + 1i64);\n");
    let mut fd: i64 = 0i64;
    while fd < acount {
        let a: RAgg = aggs.agg_at(fd);
        let aname: str = a.out;
        let fnid: i32 = agg_of_name(a.fn_name);
        if uda[fd] {
            // UDA fold: cell = <name>_step(cell, <arg>).
            push_ind(&mut em, lvl);
            em.push_text("__ga_");
            em.push_text(aname);
            em.push_text(".set(__gi, ");
            em.push_text(a.fn_name);
            em.push_text("_step(__ga_");
            em.push_text(aname);
            em.push_text(".get(__gi), (");
            em.push_text(string_as_str(&agg_body[fd]));
            em.push_text(")));\n");
        } else if fnid == AGG_COUNT() {
            push_ind(&mut em, lvl);
            em.push_text("__ga_");
            em.push_text(aname);
            em.push_text(".set(__gi, __ga_");
            em.push_text(aname);
            em.push_text(".get(__gi) + 1i64);\n");
        } else if fnid == AGG_SUM() || fnid == AGG_AVG() {
            push_ind(&mut em, lvl);
            em.push_text("__ga_");
            em.push_text(aname);
            em.push_text(".set(__gi, __ga_");
            em.push_text(aname);
            if agg_cast[fd] { em.push_text(".get(__gi) + ((");  } else { em.push_text(".get(__gi) + ("); }
            em.push_text(string_as_str(&agg_body[fd]));
            if agg_cast[fd] { em.push_text(") as f64));\n"); } else { em.push_text("));\n"); }
        } else if fnid == AGG_MIN() {
            push_ind(&mut em, lvl);
            if agg_flt[fd] { em.push_text("{ let __v: f64 = ("); }
            else           { em.push_text("{ let __v: i64 = ("); }
            em.push_text(string_as_str(&agg_body[fd]));
            em.push_text("); if __v < __ga_");
            em.push_text(aname);
            em.push_text(".get(__gi) { __ga_");
            em.push_text(aname);
            em.push_text(".set(__gi, __v); } }\n");
        } else {
            push_ind(&mut em, lvl);
            if agg_flt[fd] { em.push_text("{ let __v: f64 = ("); }
            else           { em.push_text("{ let __v: i64 = ("); }
            em.push_text(string_as_str(&agg_body[fd]));
            em.push_text("); if __v > __ga_");
            em.push_text(aname);
            em.push_text(".get(__gi) { __ga_");
            em.push_text(aname);
            em.push_text(".set(__gi, __v); } }\n");
        }
        fd = fd + 1i64;
    }
    if has_where {
        lvl = lvl - 1i64;
        push_ind(&mut em, lvl);
        em.push_text("}\n");
    }

    // Close the nest + the base loop.
    let mut ki2: i64 = ch.n - 1i64;
    while ki2 >= 0i64 {
        let closed: i64 = emit_step_close(&mut em, lvl, ki2 + 1i64, st_strat[ki2],
                                          ch.anti[ki2], st_hasres[ki2]);
        lvl = lvl - closed;
        ki2 = ki2 - 1i64;
    }
    push_ind(&mut em, lvl);
    em.push_text("__i0 = __i0 + 1i64;\n");
    lvl = lvl - 1i64;
    push_ind(&mut em, lvl);
    em.push_text("}\n");

    // Finalize the group columns (+ HAVING filter) into __gf_* FINAL columns
    // (typed by the finalized column type — a UDA column narrows from the
    // accumulator's A to R's lattice type here, via <name>_fin when declared).
    em.push_text("    let mut __gf_key: Vec<");
    em.push_text(key_ty);
    em.push_text("> = Vec::<");
    em.push_text(key_ty);
    em.push_text(">::new();\n");
    let mut fg: i64 = 0i64;
    while fg < acount {
        let a: RAgg = aggs.agg_at(fg);
        em.push_text("    let mut __gf_");
        em.push_text(a.out);
        em.push_text(": Vec<");
        em.push_text(act[fg]);
        em.push_text("> = Vec::<");
        em.push_text(act[fg]);
        em.push_text(">::new();\n");
        fg = fg + 1i64;
    }
    em.push_text("    let mut __r0: i64 = 0i64;\n");
    em.push_text("    while __r0 < __g_key.len() {\n");
    em.push_text("        let key: ");
    em.push_text(key_ty);
    em.push_text(" = __g_key.get(__r0);\n");
    let mut fz: i64 = 0i64;
    while fz < acount {
        let a: RAgg = aggs.agg_at(fz);
        let fnid: i32 = agg_of_name(a.fn_name);
        em.push_text("        let ");
        em.push_text(a.out);
        em.push_text(": ");
        em.push_text(act[fz]);
        em.push_text(" = ");
        if uda[fz] {
            let mut acc_txt: String = String::new();
            acc_txt.push_str("__ga_");
            acc_txt.push_str(a.out);
            acc_txt.push_str(".get(__r0)");
            emit_uda_finalize(&mut em, a.fn_name, string_as_str(&acc_txt),
                              uda_fin[fz], uda_fin_cast(act[fz], uda_ret[fz]));
            em.push_text(";\n");
        } else if fnid == AGG_AVG() {
            em.push_text("(if __g_cnt.get(__r0) > 0i64 { __ga_");
            em.push_text(a.out);
            em.push_text(".get(__r0) / (__g_cnt.get(__r0) as f64) } else { 0.0f64 });\n");
        } else {
            em.push_text("__ga_");
            em.push_text(a.out);
            em.push_text(".get(__r0);\n");
        }
        fz = fz + 1i64;
    }
    let mut find2: str = "        ";
    if has_having {
        em.push_text("        if (");
        em.push_text(string_as_str(&having_body));
        em.push_text(") {\n");
        find2 = "            ";
    }
    em.push_text(find2);
    em.push_text("__gf_key.push(key);\n");
    let mut fp: i64 = 0i64;
    while fp < acount {
        let a: RAgg = aggs.agg_at(fp);
        em.push_text(find2);
        em.push_text("__gf_");
        em.push_text(a.out);
        em.push_text(".push(");
        em.push_text(a.out);
        em.push_text(");\n");
        fp = fp + 1i64;
    }
    if has_having { em.push_text("        }\n"); }
    em.push_text("        __r0 = __r0 + 1i64;\n");
    em.push_text("    }\n");

    // Group-row OUTPUT phase: order → project → distinct → limit.
    em.push_text("    let mut __ix0: Vec<i64> = Vec::<i64>::new();\n");
    if mods.has_sort {
        em.push_text("    let mut __ks: Vec<");
        em.push_text(okey_ty);
        em.push_text("> = Vec::<");
        em.push_text(okey_ty);
        em.push_text(">::new();\n");
    }
    em.push_text("    let mut __r: i64 = 0i64;\n");
    em.push_text("    while __r < __gf_key.len() {\n");
    if mods.has_sort {
        emit_group_binds(&mut em, "        ", "__r", &aggs, acount, &act, "__gf_", key_ty);
        em.push_text("        __ix0.push(__r);\n");
        em.push_text("        __ks.push(");
        em.push_text(string_as_str(&okey_body));
        em.push_text(");\n");
    } else {
        em.push_text("        __ix0.push(__r);\n");
    }
    em.push_text("        __r = __r + 1i64;\n");
    em.push_text("    }\n");
    if mods.has_sort {
        emit_sort_perm(&mut em, okey_ty, mods.sort_desc, 1i64);
    }
    em.push_text("    let mut __o: i64 = 0i64;\n");
    em.push_text("    while __o < __ix0.len()");
    em.push_text(string_as_str(&lim_cond));
    em.push_text(" {\n");
    emit_group_binds(&mut em, "        ", "__ix0.get(__o)", &aggs, acount, &act, "__gf_", key_ty);
    emit_push_guarded(&mut em, "        ", result_ty, string_as_str(&proj_body), mods.distinct);
    em.push_text("        __o = __o + 1i64;\n");
    em.push_text("    }\n");
    em.push_text("    return Result::Ok(__out);\n");
    em.push_text("}\n");
    em.commit();
    return true;
}

// ══════════════════════════════════════════════════════════════════════════
// PART 3 — REL blocks: named derived relations (slice B one-shot + slice C
// RECURSIVE semi-naïve fixpoint).
//
// A NON-recursive rel (singleton SCC, no self-edge) materializes as ONE
// emitted helper fn
//
//   fn __wql_<query>_rel_<NAME>(<wql! params verbatim>
//                               [, __rel_<dep>_sl: &[RowTy]]*) -> Vec<RowTy>
//
// with SET semantics: dedup on insert via a SHADOW HashSet<RowTy> (see
// emit_rel_push — O(1) membership; tuple rows hash through the per-arity
// tuple Hash impls in logos.lang.hash). Bodies run through
// the EXISTING scan / join-chain machinery (strategy cascade included); their
// projection PUSHES into the rel Vec instead of returning. Rel dependencies
// ride in as slices (the walker's dep masks — materialization follows the
// condensation topo order, so a dep is always ready first), and a rel body
// scans them exactly like a slice param.
//
// A RECURSIVE SCC materializes as ONE fn for the WHOLE component —
// `__wql_<query>_scc<c>` (see emit_scc_fn): member totals as `&mut Vec`
// out-params, per-member delta Vecs + shadow sets, seed bodies once, then the
// semi-naïve delta-variant loop to the least fixpoint.
//
// The ENTRY fn's prelude (built by the walker) materializes the SCCs in topo
// order and takes an `as_slice()` view per rel; entry scans then reference
// `__rel_<NAME>_sl`. Each body's loop nest is wrapped in its own `{ … }`
// block so per-step generated names (`__hm1`, `__j1`, …) cannot collide
// across bodies (or across the delta variants of one body).
// ══════════════════════════════════════════════════════════════════════════

// Build a JChain directly from an RQJoin PLAN node (the rel bodies skip the
// RExpr lowering — they are restricted to scan/join+where+select, so the plan
// node IS the chain description; row types were stamped by the walker).
fn jchain_from_plan(j: RQJoin, ch: &mut JChain) {
    ch.base_src = j.a_name;
    ch.base_ty  = j.a_ty;
    ch.base_var = j.x_var;
    let steps: RQJoinStepArr = j.steps_arr();
    let ns: i64 = steps.len();
    let mut i: i64 = 0i64;
    while i < ns {
        let st: RQJoinStep = steps.step_at(i);
        if ch.n < 8i64 {
            ch.src[ch.n]  = st.src_name;   // traversal steps: the walker-stamped field-path expr
            ch.ty[ch.n]   = st.row_ty;
            ch.var[ch.n]  = st.var_name;
            ch.anti[ch.n] = st.is_anti;
            ch.edge[ch.n]  = st.is_edge;
            ch.byval[ch.n] = st.is_edge && el_ret_class(st.row_ty) >= 0i32;
            if st.is_edge && !st.has_on { ch.onw[ch.n] = 0i64; }
            else                        { ch.onw[ch.n] = st.on.any().raw(); }
            ch.n = ch.n + 1i64;
        }
        i = i + 1i64;
    }
}

// Is `name` one of the body's bound row vars?
fn is_bound_var(name: str, vars: &[str; 9], nvars: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < nvars {
        if str_eq(vars[i], name) { return true; }
        i = i + 1i64;
    }
    return false;
}

// Validate a rel body's SELECT against the declared columns (rel `ri` in the
// registry): width (tuple of exactly ncols / single expr for a 1-column rel),
// per-component TYPE equality with the declared column type, no whole-row
// (bare row-var) components, no owned-String components (a str column stores
// a borrowed view; the call's String temporary would dangle). Errors are
// NAMED per rel/column. Returns false with the error surfaced.
fn rel_select_ok(proj: SExpr, ri: i64, prm: &MacroParams, t: &ElTypes,
                 vars: &[str; 9], nvars: i64) -> bool {
    let rel_name: str = prm.rel_names[ri];
    let nc: i64  = prm.rel_ccnt[ri];
    let off: i64 = prm.rel_coff[ri];
    if nc >= 2i64 {
        match proj {
            SExpr::Tuple(tp) => {
                let items: SExprArr = tp.items_arr();
                if items.len() != nc {
                    let mut m: String = String::new();
                    m.push_str("wql!: rel '");
                    m.push_str(rel_name);
                    m.push_str("': select tuple width ");
                    m.push_i64(items.len());
                    m.push_str(" does not match the declared column count ");
                    m.push_i64(nc);
                    error(string_as_str(&m));
                    return false;
                }
                let mut k: i64 = 0i64;
                while k < nc {
                    let comp: SExpr = items.arg_at(k);
                    if !rel_select_comp_ok(comp, rel_name, prm.relc_name[off + k],
                                           prm.relc_ty[off + k], t, vars, nvars) { return false; }
                    k = k + 1i64;
                }
            }
            _ => {
                let mut m2: String = String::new();
                m2.push_str("wql!: rel '");
                m2.push_str(rel_name);
                m2.push_str("' declares ");
                m2.push_i64(nc);
                m2.push_str(" columns — the body select must be a tuple of exactly that many components");
                error(string_as_str(&m2));
                return false;
            }
        }
        return true;
    }
    // 1-column rel: a single (non-tuple) expression.
    if is_tuple_root(proj) {
        let mut m3: String = String::new();
        m3.push_str("wql!: rel '");
        m3.push_str(rel_name);
        m3.push_str("' declares 1 column — the body select must be a single expression (`(e)` is grouping, not a 1-tuple)");
        error(string_as_str(&m3));
        return false;
    }
    return rel_select_comp_ok(proj, rel_name, prm.relc_name[off],
                              prm.relc_ty[off], t, vars, nvars);
}

// One select component vs its declared column: whole-row / String / type.
fn rel_select_comp_ok(comp: SExpr, rel_name: str, col_name: str, col_ty: str,
                      t: &ElTypes, vars: &[str; 9], nvars: i64) -> bool {
    let rn: str = root_ident_name(comp);
    if rn.len() > 0i64 && is_bound_var(rn, vars, nvars) {
        let mut m: String = String::new();
        m.push_str("wql!: rel '");
        m.push_str(rel_name);
        m.push_str("': select projects the whole row var `");
        m.push_str(rn);
        m.push_str("` — project explicit columns/fields (e.g. `select (");
        m.push_str(rn);
        m.push_str(".a, ");
        m.push_str(rn);
        m.push_str(".b)`)");
        error(string_as_str(&m));
        return false;
    }
    if returns_string(comp, t) {
        let mut m1: String = String::new();
        m1.push_str("wql!: rel '");
        m1.push_str(rel_name);
        m1.push_str("' column '");
        m1.push_str(col_name);
        m1.push_str("': an owned-String-returning expression cannot feed a rel column (str columns store borrowed views)");
        error(string_as_str(&m1));
        return false;
    }
    let got: i32  = infer_ty(comp, t);
    let want: i32 = el_ty_of_name(col_ty);
    if got != want {
        let mut m2: String = String::new();
        m2.push_str("wql!: rel '");
        m2.push_str(rel_name);
        m2.push_str("' column '");
        m2.push_str(col_name);
        m2.push_str("': select component has type ");
        m2.push_str(el_ty_name(got));
        m2.push_str(", declared ");
        m2.push_str(col_ty);
        error(string_as_str(&m2));
        return false;
    }
    return true;
}

// The set-dedup push (Datalog SET semantics): bind the projected row, probe
// the SHADOW HashSet through `__rsp` — insert returns true only for a NEW
// row, gating the `__out` push. O(1) amortized per insert; tuple rows hash
// via the per-arity `impl Hash for (…)` in logos.lang.hash, scalar rows
// (i64/str/bool) via their primitive impls. (f64 columns are rejected up
// front — set semantics require Eq.) `__out`/`__rsp` bind CONTEXTUALLY: the
// one-shot helper fn declares them over its result Vec; the semi-naïve SCC
// driver lexically rebinds them per member block onto that member's
// next-delta Vec + shadow set (which is total ∪ next-delta — exactly the
// "new w.r.t. the total" probe semi-naïve needs).
fn emit_rel_push(em: &mut Emitter, lvl: i64, row_ty: str, proj: str) {
    push_ind(em, lvl);
    em.push_text("let __rv: ");
    em.push_text(row_ty);
    em.push_text(" = (");
    em.push_text(proj);
    em.push_text(");\n");
    push_ind(em, lvl);
    em.push_text("if unsafe { __rsp.insert(__rv) } { __out.push(__rv); }\n");
}

// The SEMILATTICE-ABSORB push (recursive min/max aggregation — the generalization
// of the set-insert). A candidate `(key, arg)` is absorbed against the persistent
// per-key best-map `__bp_<rel>`: kept iff it STRICTLY improves the running best
// (`<` for min, `>` for max). The improvement gate IS the ⊓/⊔ meet/join — this is
// exactly why min/max are incrementalizable in a fixpoint and sum/count/avg are
// not (design §2). A NEW key seeds the best and records its key in `__keys_<rel>`
// (the distinct-key roster the post-loop materializes the argmin/argmax total
// from); an improved key overwrites the best. Every improvement pushes the row
// into `__out` (the round's improvement delta) — semi-naïve re-derivation.
fn emit_rel_push_agg(em: &mut Emitter, lvl: i64, ri: i64, prm: &MacroParams,
                     key_body: str, val_body: str) {
    let rn:  str = prm.rel_names[ri];
    let off: i64 = prm.rel_coff[ri];
    let kty: str = prm.relc_ty[off];
    let vty: str = prm.relc_ty[off + 1i64];
    let cmp: str = if prm.rel_agg_dir[ri] == AGG_MAX() { " > " } else { " < " };
    push_ind(em, lvl);
    em.push_text("let __ak: "); em.push_text(kty); em.push_text(" = (");
    em.push_text(key_body); em.push_text(");\n");
    push_ind(em, lvl);
    em.push_text("let __av: "); em.push_text(vty); em.push_text(" = (");
    em.push_text(val_body); em.push_text(");\n");
    push_ind(em, lvl);
    em.push_text("unsafe {\n");
    push_ind(em, lvl + 1i64);
    em.push_text("let __cp: *const "); em.push_text(vty);
    em.push_text(" = (__bp_"); em.push_text(rn); em.push_text(").get(&__ak);\n");
    push_ind(em, lvl + 1i64);
    em.push_text("let mut __imp: bool = false;\n");
    push_ind(em, lvl + 1i64);
    em.push_text("if __cp == (0i64 as *const "); em.push_text(vty);
    em.push_text(") { __imp = true; __keys_"); em.push_text(rn); em.push_text(".push(__ak); }\n");
    push_ind(em, lvl + 1i64);
    em.push_text("else { if __av"); em.push_text(cmp); em.push_text("*__cp { __imp = true; } }\n");
    push_ind(em, lvl + 1i64);
    em.push_text("if __imp { (__bp_"); em.push_text(rn);
    em.push_text(").insert(__ak, __av); __out.push((__ak, __av)); }\n");
    push_ind(em, lvl);
    em.push_text("}\n");
}

// Emit the (key, arg) split of an aggregate MEMBER's body select tuple into the
// `key_out`/`val_out` strings, for the seed / plain-body absorb path. The select
// of an aggregate member is always `(key…, aggout)` (walker-validated against the
// two declared columns), so component 0 is the group key and component 1 the
// value the lattice folds. Returns false (error surfaced) if not a 2-tuple.
fn split_agg_proj(proj: SExpr, ri: i64, prm: &MacroParams, t: &ElTypes, var0: str,
                  key_out: &mut String, val_out: &mut String) -> bool {
    match proj {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            if items.len() != 2i64 {
                error("wql!: a recursive-aggregate rel select must be `(key, aggout)` — exactly two components (slice-1)");
                return false;
            }
            emit_sexpr(key_out, items.arg_at(0i64), t, var0);
            emit_sexpr(val_out, items.arg_at(1i64), t, var0);
            return true;
        }
        _ => {
            error("wql!: a recursive-aggregate rel select must be a `(key, aggout)` tuple (slice-1)");
            return false;
        }
    }
}

// One SIMPLE rel body: scan + optional where + dedup-push projection.
fn emit_rel_body_simple(em: &mut Emitter, s: RQSimple, ri: i64,
                        prm: &MacroParams, h: &Writ) -> bool {
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, s.row_ty);
    stamp_rel_source(&mut ty, prm, s.src_name, s.var_name);
    apply_scalar_params(&mut ty, prm);
    stamp_udfs_from_module(&view, &mut ty);

    let mut vars: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    vars[0] = s.var_name;

    let proj_opt: SExpr = simplify_sexpr(s.select_expr(), h).any().view::<SExpr>();
    if !check_calls(proj_opt, &ty, "wql!: rel `select`") { return false; }
    if !rel_select_ok(proj_opt, ri, prm, &ty, &vars, 1i64) { return false; }
    // Aggregate MEMBER (recursive min/max): its bodies — including seed scans —
    // absorb `(key, val)` into the best-map, not the set shadow. Split the select
    // tuple into the two lattice operands.
    let is_agg: bool = prm.rel_is_agg[ri];
    let mut proj_body: String = String::new();
    let mut key_body: String = String::new();
    let mut val_body: String = String::new();
    if is_agg {
        if !split_agg_proj(proj_opt, ri, prm, &ty, s.var_name, &mut key_body, &mut val_body) { return false; }
    } else {
        emit_sexpr(&mut proj_body, proj_opt, &ty, s.var_name);
    }

    let mut pred_body: String = String::new();
    if s.has_where {
        let pe: SExpr = s.where_expr();
        if !reject_tuple(pe, "wql!: rel `where`") { return false; }
        if !check_calls(pe, &ty, "wql!: rel `where`") { return false; }
        let pe_opt: SExpr = simplify_sexpr(pe, h).any().view::<SExpr>();
        emit_sexpr(&mut pred_body, pe_opt, &ty, s.var_name);
    }

    em.push_text("    {\n");
    em.push_text("        let mut __i: i64 = 0i64;\n");
    em.push_text("        while __i < (");
    em.push_text(s.src_name);
    em.push_text(").len() {\n");
    em.push_text("            let ");
    em.push_text(s.var_name);
    em.push_text(": &");
    em.push_text(s.row_ty);
    em.push_text(" = &(");
    em.push_text(s.src_name);
    em.push_text(")[__i];\n");
    let mut lvl: i64 = 3i64;
    if s.has_where {
        push_ind(em, lvl);
        em.push_text("if (");
        em.push_text(string_as_str(&pred_body));
        em.push_text(") {\n");
        lvl = lvl + 1i64;
    }
    if is_agg {
        emit_rel_push_agg(em, lvl, ri, prm, string_as_str(&key_body), string_as_str(&val_body));
    } else {
        emit_rel_push(em, lvl, prm.rel_rowty[ri], string_as_str(&proj_body));
    }
    if s.has_where {
        lvl = lvl - 1i64;
        push_ind(em, lvl);
        em.push_text("}\n");
    }
    em.push_text("            __i = __i + 1i64;\n");
    em.push_text("        }\n");
    em.push_text("    }\n");
    return true;
}

// ── jchain_from_aggr — a JChain over an aggregate body's base + join steps ──
// The recursive-aggregate body (`from rel x join edges e … group by … aggregate
// …`) has the SAME base-scan + join-step-fan-out shape as a join body; only the
// PUSH differs (lattice absorb vs set insert). Mirror jchain_from_plan.
fn jchain_from_aggr(g: RQAggr, ch: &mut JChain) {
    ch.base_src = g.a_name;
    ch.base_ty  = g.a_ty;
    ch.base_var = g.x_var;
    if !g.has_steps() { return; }
    let steps: RQJoinStepArr = g.steps_arr();
    let ns: i64 = steps.len();
    let mut i: i64 = 0i64;
    while i < ns {
        let st: RQJoinStep = steps.step_at(i);
        if ch.n < 8i64 {
            ch.src[ch.n]  = st.src_name;
            ch.ty[ch.n]   = st.row_ty;
            ch.var[ch.n]  = st.var_name;
            ch.anti[ch.n] = st.is_anti;
            ch.edge[ch.n]  = st.is_edge;
            ch.byval[ch.n] = st.is_edge && el_ret_class(st.row_ty) >= 0i32;
            if st.is_edge && !st.has_on { ch.onw[ch.n] = 0i64; }
            else                        { ch.onw[ch.n] = st.on.any().raw(); }
            ch.n = ch.n + 1i64;
        }
        i = i + 1i64;
    }
}

// One JOIN-CHAIN rel body: build phases + nested probes (the existing per-step
// strategy cascade — rel-sourced sides included) + optional where + dedup push.
fn emit_rel_body_join(em: &mut Emitter, j: RQJoin, ri: i64,
                      prm: &MacroParams, h: &Writ) -> bool {
    let mut ch: JChain = jchain_new();
    jchain_from_plan(j, &mut ch);
    let se: SExpr = j.select_expr();
    // A JOIN-shaped SEED of an aggregate member projects `(key, val)` — split it
    // so the absorb folds the two lattice operands (not the whole tuple twice).
    if prm.rel_is_agg[ri] {
        match se {
            SExpr::Tuple(tp) => {
                let items: SExprArr = tp.items_arr();
                if items.len() != 2i64 {
                    error("wql!: a recursive-aggregate rel body must project `(key, aggout)` — exactly two components (slice-1)");
                    return false;
                }
                return emit_chain_body(em, &ch, ri, prm, se, items.arg_at(0i64), items.arg_at(1i64),
                                       j.has_where, j.where_expr(), h);
            }
            _ => {
                error("wql!: a recursive-aggregate rel body must project a `(key, aggout)` tuple (slice-1)");
                return false;
            }
        }
    }
    return emit_chain_body(em, &ch, ri, prm, se, se, se,
                           j.has_where, j.where_expr(), h);
}

// One RECURSIVE-AGGREGATE rel body: same chain nest as a join body, but the inner
// push is the semilattice absorb over `(group-key, aggregate-arg)` into the
// best-map (min/max fixpoint). The surface `select (key, aggout)` is structural
// only — the emitted operands are the group KEY and the aggregate's ARG expr.
fn emit_rel_body_agg(em: &mut Emitter, g: RQAggr, ri: i64,
                     prm: &MacroParams, h: &Writ) -> bool {
    if !g.has_steps() {
        error("wql!: a recursive-aggregate rel body must JOIN the rel with an edge/relation slice (e.g. `from dist x join edges e on e.src == x.node …`) — a bare self-scan cannot propagate the fixpoint");
        return false;
    }
    let aggs: RQAggArr = g.aggs_arr();
    let a0: RQAgg = aggs.agg_at(0i64);
    if !a0.has_arg {
        error("wql!: a recursive min/max aggregate needs an argument (e.g. `min(x.d + e.w)`) — `count()` is a group aggregate and cannot recurse");
        return false;
    }
    let mut ch: JChain = jchain_new();
    jchain_from_aggr(g, &mut ch);
    let key_e: SExpr = g.key_expr();
    let val_e: SExpr = a0.arg_expr();
    let we: SExpr = if g.has_where { g.where_expr() } else { key_e };
    return emit_chain_body(em, &ch, ri, prm, key_e, key_e, val_e,
                           g.has_where, we, h);
}

// The shared CHAIN-BODY emitter (join bodies + recursive-aggregate bodies). For a
// non-aggregate member `proj_e` is the select projection (dedup-push); for an
// aggregate member (`prm.rel_is_agg[ri]`) `key_e`/`val_e` are the group key + the
// aggregate argument (semilattice absorb). `where_e` is valid only if `has_where`.
fn emit_chain_body(em: &mut Emitter, ch: &JChain, ri: i64, prm: &MacroParams,
                   proj_e: SExpr, key_e: SExpr, val_e: SExpr,
                   has_where: bool, where_e: SExpr, h: &Writ) -> bool {
    let is_agg: bool = prm.rel_is_agg[ri];
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    stamp_types_from_schema(&view, &mut ty, ch.base_ty);
    stamp_rel_source(&mut ty, prm, ch.base_src, ch.base_var);
    let mut si: i64 = 0i64;
    while si < ch.n {
        stamp_types_from_schema(&view, &mut ty, ch.ty[si]);
        stamp_rel_source(&mut ty, prm, ch.src[si], ch.var[si]);
        // Scalar-element traversal var: name → element value type (bare refs).
        if ch.byval[si] { ty.set_ty(ch.var[si], el_ty_of_name(ch.ty[si])); }
        si = si + 1i64;
    }
    apply_scalar_params(&mut ty, prm);
    stamp_udfs_from_module(&view, &mut ty);

    // The whole-row-projection gate's var set. SCALAR-element traversal vars
    // (byval) are EXCLUDED: they bind a scalar VALUE (Vec<i64> → i64), which
    // is a legitimate select component — only struct/tuple ROWS are barred.
    let mut vars: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    vars[0] = ch.base_var;
    let mut nv: i64 = 1i64;
    let mut vi: i64 = 0i64;
    while vi < ch.n {
        if nv < 9i64 && !ch.byval[vi] { vars[nv] = ch.var[vi]; nv = nv + 1i64; }
        vi = vi + 1i64;
    }

    // Clause validation + push-operand emission (select / key+arg / where).
    let mut proj_body: String = String::new();
    let mut key_body: String = String::new();
    let mut val_body: String = String::new();
    if is_agg {
        // Recursive-aggregate: the value column carries an ORDER (the lattice); a
        // single-key group (slice-1). Require val col = i64 (total Ord, no f64
        // NaN hazard — design §7 critique #6).
        let voff: i64 = prm.rel_coff[ri];
        if !str_eq(prm.relc_ty[voff + 1i64], "i64") {
            error("wql!: a recursive min/max aggregate value column must be i64 (the ordered lattice; f64/str are out of slice-1)");
            return false;
        }
        let key_opt: SExpr = simplify_sexpr(key_e, h).any().view::<SExpr>();
        let val_opt: SExpr = simplify_sexpr(val_e, h).any().view::<SExpr>();
        if !reject_tuple(key_opt, "wql!: rel aggregate `group by`") { return false; }
        if !check_calls(key_opt, &ty, "wql!: rel aggregate `group by`") { return false; }
        if !check_calls(val_opt, &ty, "wql!: rel aggregate argument") { return false; }
        emit_sexpr(&mut key_body, key_opt, &ty, ch.base_var);
        emit_sexpr(&mut val_body, val_opt, &ty, ch.base_var);
    } else {
        let proj_opt: SExpr = simplify_sexpr(proj_e, h).any().view::<SExpr>();
        if !check_calls(proj_opt, &ty, "wql!: rel `select`") { return false; }
        if !rel_select_ok(proj_opt, ri, prm, &ty, &vars, nv) { return false; }
        emit_sexpr(&mut proj_body, proj_opt, &ty, ch.base_var);
    }
    let mut where_body: String = String::new();
    if has_where {
        let we: SExpr = where_e;
        if !reject_tuple(we, "wql!: rel `where`") { return false; }
        if !check_calls(we, &ty, "wql!: rel `where`") { return false; }
        let we_opt: SExpr = simplify_sexpr(we, h).any().view::<SExpr>();
        emit_sexpr(&mut where_body, we_opt, &ty, ch.base_var);
    }
    let mut ci0: i64 = 0i64;
    while ci0 < ch.n {
        if ch.onw[ci0] != 0i64 {
            let on_e: SExpr = sexpr_of_word(ch.onw[ci0]);
            if !reject_tuple(on_e, "wql!: rel `on`") { return false; }
            if !check_calls(on_e, &ty, "wql!: rel `on`") { return false; }
        }
        ci0 = ci0 + 1i64;
    }

    // Per-step strategy analysis (the same cascade as the query join shape).
    let mut st_build: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_probe: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_resid: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_pred:  [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut st_strat:  [i32; 8]  = [0i32; 8];
    let mut st_ktn:    [str; 8]  = ["", "", "", "", "", "", "", ""];
    let mut st_hasres: [bool; 8] = [false; 8];
    let mut st_equi:   [bool; 8] = [false; 8];
    analyze_chain(ch, &ty, ch.base_var, h,
                  &mut st_build, &mut st_probe, &mut st_resid, &mut st_pred,
                  &mut st_strat, &mut st_ktn, &mut st_hasres, &mut st_equi);

    // The body block: builds + nest + shared inner dedup-push.
    em.push_text("    {\n");
    let mut ci: i64 = 0i64;
    while ci < ch.n {
        emit_strategy_comment(em, ci + 1i64, st_strat[ci], ch.anti[ci],
                              st_equi[ci], st_hasres[ci], st_ktn[ci], ch.edge[ci]);
        ci = ci + 1i64;
    }
    let mut bpi: i64 = 0i64;
    while bpi < ch.n {
        emit_build_phase(em, bpi + 1i64, st_strat[bpi], ch.anti[bpi], st_hasres[bpi],
                         st_ktn[bpi], ch.src[bpi], ch.ty[bpi], ch.var[bpi],
                         string_as_str(&st_build[bpi]));
        bpi = bpi + 1i64;
    }
    let mut lvl: i64 = 2i64;
    push_ind(em, lvl);
    em.push_text("let mut __i0: i64 = 0i64;\n");
    push_ind(em, lvl);
    em.push_text("while __i0 < (");
    em.push_text(ch.base_src);
    em.push_text(").len() {\n");
    lvl = lvl + 1i64;
    push_ind(em, lvl);
    em.push_text("let ");
    em.push_text(ch.base_var);
    em.push_text(": &");
    em.push_text(ch.base_ty);
    em.push_text(" = &(");
    em.push_text(ch.base_src);
    em.push_text(")[__i0];\n");
    let mut opens: [i64; 8] = [0i64; 8];
    let mut oi: i64 = 0i64;
    while oi < ch.n {
        opens[oi] = emit_step_open(em, lvl, oi + 1i64, st_strat[oi], ch.anti[oi],
                                   st_hasres[oi], st_ktn[oi], ch.src[oi], ch.ty[oi],
                                   ch.var[oi], ch.byval[oi], string_as_str(&st_probe[oi]),
                                   string_as_str(&st_resid[oi]), string_as_str(&st_pred[oi]),
                                   "");
        lvl = lvl + opens[oi];
        oi = oi + 1i64;
    }
    if has_where {
        push_ind(em, lvl);
        em.push_text("if (");
        em.push_text(string_as_str(&where_body));
        em.push_text(") {\n");
        lvl = lvl + 1i64;
    }
    if is_agg {
        emit_rel_push_agg(em, lvl, ri, prm, string_as_str(&key_body), string_as_str(&val_body));
    } else {
        emit_rel_push(em, lvl, prm.rel_rowty[ri], string_as_str(&proj_body));
    }
    if has_where {
        lvl = lvl - 1i64;
        push_ind(em, lvl);
        em.push_text("}\n");
    }
    let mut ki: i64 = ch.n - 1i64;
    while ki >= 0i64 {
        let closed: i64 = emit_step_close(em, lvl, ki + 1i64, st_strat[ki],
                                          ch.anti[ki], st_hasres[ki]);
        lvl = lvl - closed;
        ki = ki - 1i64;
    }
    push_ind(em, lvl);
    em.push_text("__i0 = __i0 + 1i64;\n");
    lvl = lvl - 1i64;
    push_ind(em, lvl);
    em.push_text("}\n");
    em.push_text("    }\n");
    return true;
}

// Emit the extra `, __rel_<j>_sl: &[RowJ]` PARAMS selected by `mask` (ascending
// rel index) — the helper-fn dependency-slice parameters; the walker's prelude
// builds the matching call-argument list from the SAME masks (plan_walker::
// push_call_args), so signature and call site cannot drift.
fn push_dep_params(em: &mut Emitter, prm: &MacroParams, mask: i64) {
    let mut j: i64 = 0i64;
    while j < prm.rel_n {
        if (mask & (1i64 << j)) != 0i64 {
            em.push_text(", ");
            em.push_text(prm.rel_srcs[j]);
            em.push_text(": &[");
            em.push_text(prm.rel_rowty[j]);
            em.push_text("]");
        }
        j = j + 1i64;
    }
}

// Emit one rel body (fat-wrapped per shape — the emitters read edge methods
// and the SCC driver rewrites src_name fields, both of which want the
// allocator-carrying view). Shared by the one-shot path and the SCC driver.
fn emit_rel_body(em: &mut Emitter, body_any: WAny, ri: i64,
                 prm: &MacroParams, h: &Writ) -> bool {
    let q: RQuery = body_any.view::<RQuery>();
    match q {
        RQuery::Simple(_) => {
            return emit_rel_body_simple(em, rq_fat_simple(body_any, h), ri, prm, h);
        }
        RQuery::Join(_) => {
            return emit_rel_body_join(em, rq_fat_join(body_any, h), ri, prm, h);
        }
        RQuery::Aggr(_) => {
            // Only reachable for a FINALIZED recursive-aggregate member (the
            // walker's stratification check sets rel_is_agg); any other aggregate
            // body was rejected there.
            if prm.rel_is_agg[ri] {
                return emit_rel_body_agg(em, rq_fat_aggr(body_any, h), ri, prm, h);
            }
            error("wql!: rel body must be a scan or join query (from/join/where/select)");
            return false;
        }
        _ => {
            // Unreachable — the walker rejects find bodies.
            error("wql!: rel body must be a scan or join query (from/join/where/select)");
            return false;
        }
    }
}

// ── ONE-SHOT rel fn (singleton SCC, no self-edge — the slice-B path) ─────────
// `fn __wql_<fn>_rel_<name>(<params verbatim>[, dep slices]) -> Vec<Row>`:
// out Vec + shadow HashSet (O(1) dedup membership, see emit_rel_push; the raw
// pointer rides alongside because HashSet's mutators take `*mut self`), then
// every body's loop nest, dedup-pushing into the shared pair.
fn emit_rel_fn_oneshot(em: &mut Emitter, rel: RQRel, ri: i64, fn_name: str,
                       params_text: str, prm: &MacroParams, scc: &RelScc,
                       h: &Writ) -> bool {
    let row_ty: str = prm.rel_rowty[ri];
    em.push_text("fn __wql_");
    em.push_text(vis_strip(fn_name));
    em.push_text("_rel_");
    em.push_text(prm.rel_names[ri]);
    em.push_text(prm.tparams);
    em.push_text("(");
    em.push_text(params_text);
    push_dep_params(em, prm, scc.dep_mask[ri]);
    em.push_text(") -> Result<Vec<");
    em.push_text(row_ty);
    em.push_text(">, ElError> {\n");
    em.push_text("    let mut __out: Vec<");
    em.push_text(row_ty);
    em.push_text("> = Vec::<");
    em.push_text(row_ty);
    em.push_text(">::new();\n");
    em.push_text("    let mut __rs: HashSet<");
    em.push_text(row_ty);
    em.push_text("> = hashset_new::<");
    em.push_text(row_ty);
    em.push_text(">();\n");
    em.push_text("    let __rsp: *mut HashSet<");
    em.push_text(row_ty);
    em.push_text("> = &mut __rs;\n");
    let bodies: RQBodyArr = rel.bodies_arr();
    let nb: i64 = bodies.len();
    let mut b: i64 = 0i64;
    while b < nb {
        if !emit_rel_body(em, bodies.body_any(b), ri, prm, h) { return false; }
        b = b + 1i64;
    }
    em.push_text("    return Result::Ok(__out);\n");
    em.push_text("}\n");
    return true;
}

// ── In-SCC source OCCURRENCES of one body (semi-naïve variant expansion) ─────
// `pos` = -1 for the base scan, else the join-step index; `rel` = the source's
// rel registry index. A body with ZERO occurrences is a SEED (runs once,
// before the loop); k occurrences ⇒ k delta variants per round — variant v
// reads occurrence v from the rel's DELTA slice and every other in-SCC
// occurrence from the TOTAL slice (the standard semi-naïve rewriting).
struct OccList { pos: [i64; 9], rel: [i64; 9], n: i64 }

fn occ_new() -> OccList { return OccList { pos: [0i64; 9], rel: [0i64; 9], n: 0i64 }; }

fn occ_push(o: &mut OccList, pos: i64, rel: i64) {
    if o.n >= 9i64 { return; }
    o.pos[o.n] = pos;
    o.rel[o.n] = rel;
    o.n = o.n + 1i64;
}

// Scan a (walker-rewritten) body for sources landing in SCC `c`.
fn body_scc_occs(body_any: WAny, prm: &MacroParams, scc: &RelScc, c: i64,
                 h: &Writ) -> OccList {
    let mut o: OccList = occ_new();
    let q: RQuery = body_any.view::<RQuery>();
    match q {
        RQuery::Simple(_) => {
            let s: RQSimple = rq_fat_simple(body_any, h);
            let ri: i64 = prm.rel_find_src(s.src_name);
            if ri >= 0i64 && scc.comp[ri] == c { occ_push(&mut o, -1i64, ri); }
        }
        RQuery::Join(_) => {
            let j: RQJoin = rq_fat_join(body_any, h);
            let ri0: i64 = prm.rel_find_src(j.a_name);
            if ri0 >= 0i64 && scc.comp[ri0] == c { occ_push(&mut o, -1i64, ri0); }
            let steps: RQJoinStepArr = j.steps_arr();
            let ns: i64 = steps.len();
            let mut i: i64 = 0i64;
            while i < ns {
                let st: RQJoinStep = rq_fat_step(steps.step_any(i), h);
                let ri1: i64 = prm.rel_find_src(st.src_name);
                if ri1 >= 0i64 && scc.comp[ri1] == c { occ_push(&mut o, i, ri1); }
                i = i + 1i64;
            }
        }
        RQuery::Aggr(_) => {
            // A recursive-aggregate body (min/max): its base + join-step sources
            // participate in the SCC exactly like a join body's — the self-ref to
            // the aggregate rel is the in-SCC occurrence the semi-naïve driver
            // binds to the improvement delta.
            let g: RQAggr = rq_fat_aggr(body_any, h);
            let rig: i64 = prm.rel_find_src(g.a_name);
            if rig >= 0i64 && scc.comp[rig] == c { occ_push(&mut o, -1i64, rig); }
            if g.has_steps() {
                let gsteps: RQJoinStepArr = g.steps_arr();
                let gns: i64 = gsteps.len();
                let mut gi: i64 = 0i64;
                while gi < gns {
                    let gst: RQJoinStep = rq_fat_step(gsteps.step_any(gi), h);
                    let rig1: i64 = prm.rel_find_src(gst.src_name);
                    if rig1 >= 0i64 && scc.comp[rig1] == c { occ_push(&mut o, gi, rig1); }
                    gi = gi + 1i64;
                }
            }
        }
        _ => { }
    }
    return o;
}

// Point occurrence `w` of a body at `name` (the total `__rel_<r>_sl` or delta
// `__dl_<r>_sl` slice) — the per-variant source rebinding. Fat views: a
// src_name write boxes the bytes into the arena.
fn set_occ_src(body_any: WAny, o: &OccList, w: i64, name: str, h: &Writ) {
    if o.pos[w] < 0i64 {
        let q: RQuery = body_any.view::<RQuery>();
        match q {
            RQuery::Simple(_) => { let s: RQSimple = rq_fat_simple(body_any, h); s.src_name = name; }
            RQuery::Join(_)   => { let j: RQJoin = rq_fat_join(body_any, h); j.a_name = name; }
            RQuery::Aggr(_)   => { let g: RQAggr = rq_fat_aggr(body_any, h); g.a_name = name; }
            _ => { }
        }
        return;
    }
    let q2: RQuery = body_any.view::<RQuery>();
    match q2 {
        RQuery::Aggr(_) => {
            let g2: RQAggr = rq_fat_aggr(body_any, h);
            let st2: RQJoinStep = rq_fat_step(g2.steps_arr().step_any(o.pos[w]), h);
            st2.src_name = name;
        }
        _ => {
            let j2: RQJoin = rq_fat_join(body_any, h);
            let st: RQJoinStep = rq_fat_step(j2.steps_arr().step_any(o.pos[w]), h);
            st.src_name = name;
        }
    }
}

// ── The SEMI-NAÏVE fixpoint fn — one per RECURSIVE SCC (slice C) ─────────────
// `fn __wql_<fn>_scc<c>(<params verbatim>[, dep slices], __tot_<m>: &mut
// Vec<RowM>, …)` — the member TOTAL Vecs are caller-owned out-params (the
// prelude declares them and takes the entry's `as_slice()` views after the
// call); per member the fn keeps a shadow HashSet `__rs_<m>` (= total ∪
// next-delta at all times — the O(1) membership emit_rel_push probes), the
// current delta `__dl_<m>` and the next delta `__nd_<m>`.
//
//   seed:  every body with NO in-SCC source runs once, dedup-pushing into
//          `__nd_<m>` (sources: params + earlier strata — fn params);
//   loop:  PROMOTE  — `__dl = __nd; __nd = fresh; total ∪= __dl` (the shadow
//          set already holds the rows, so the promote is a plain append);
//          EXIT     — every member delta empty ⇒ least fixpoint reached;
//          BIND     — `__rel_<m>_sl` = total slice, `__dl_<m>_sl` = delta
//          slice (fresh each round);
//          VARIANTS — every recursive body of every member runs once per
//          in-SCC occurrence, that occurrence's src_name TEMPORARILY rewritten
//          to the delta slice (the others read totals), new rows dedup-pushing
//          into `__nd_<m>` via the block-shadowed `__out`/`__rsp` pair.
//
// TERMINATION: guaranteed for non-generative programs (set semantics over a
// finite universe); recursive heads that MINT values (arithmetic) can diverge
// — the standard Datalog-with-arithmetic caveat, deliberately NOT capped.
// Body emitters are reused UNCHANGED: `__out`/`__rsp` are lexically rebound
// per member block, source slices per round/variant — the emission is
// parameterized by NAMES only.
fn emit_scc_fn(em: &mut Emitter, rels: RQRelArr, c: i64, fn_name: str,
               params_text: str, prm: &MacroParams, scc: &RelScc,
               h: &Writ) -> bool {
    // Members (declaration order) + the union out-of-SCC dep mask.
    let mut mem: [i64; 8] = [0i64; 8];
    let mut nm: i64 = 0i64;
    let mut mask: i64 = 0i64;
    let mut r: i64 = 0i64;
    while r < prm.rel_n {
        if scc.comp[r] == c {
            if nm < 8i64 { mem[nm] = r; nm = nm + 1i64; }
            mask = mask | scc.dep_mask[r];
        }
        r = r + 1i64;
    }
    // ── Signature ──
    em.push_text("fn __wql_");
    em.push_text(vis_strip(fn_name));
    em.push_text("_scc");
    push_nk(em, "", c);
    em.push_text(prm.tparams);
    em.push_text("(");
    em.push_text(params_text);
    push_dep_params(em, prm, mask);
    let mut m0: i64 = 0i64;
    while m0 < nm {
        em.push_text(", __tot_");
        em.push_text(prm.rel_names[mem[m0]]);
        em.push_text(": &mut Vec<");
        em.push_text(prm.rel_rowty[mem[m0]]);
        em.push_text(">");
        m0 = m0 + 1i64;
    }
    em.push_text(") -> Result<(), ElError> {\n");
    // ── Per-member state ──
    // Plain (set-semantics) member: a shadow HashSet + current/next delta Vecs.
    // AGGREGATE member (recursive min/max): a best-per-key MAP + its raw pointer
    // (the map mutators take `*mut self`), a distinct-KEY roster (the post-loop
    // argmin/argmax materialization of the total), the improvement deltas, and a
    // round counter (the runtime convergence guard — termination is sacred).
    let mut m1: i64 = 0i64;
    while m1 < nm {
        let rn: str = prm.rel_names[mem[m1]];
        let rt: str = prm.rel_rowty[mem[m1]];
        if prm.rel_is_agg[mem[m1]] {
            let off: i64 = prm.rel_coff[mem[m1]];
            let kty: str = prm.relc_ty[off];
            let vty: str = prm.relc_ty[off + 1i64];
            em.push_text("    let mut __best_"); em.push_text(rn);
            em.push_text(": HashMap<"); em.push_text(kty); em.push_text(", "); em.push_text(vty);
            em.push_text("> = hashmap_new::<"); em.push_text(kty); em.push_text(", "); em.push_text(vty); em.push_text(">();\n");
            em.push_text("    let __bp_"); em.push_text(rn);
            em.push_text(": *mut HashMap<"); em.push_text(kty); em.push_text(", "); em.push_text(vty);
            em.push_text("> = &mut __best_"); em.push_text(rn); em.push_text(";\n");
            em.push_text("    let mut __keys_"); em.push_text(rn);
            em.push_text(": Vec<"); em.push_text(kty); em.push_text("> = Vec::<"); em.push_text(kty); em.push_text(">::new();\n");
            em.push_text("    let mut __rounds_"); em.push_text(rn); em.push_text(": i64 = 0i64;\n");
        } else {
            em.push_text("    let mut __rs_");
            em.push_text(rn);
            em.push_text(": HashSet<");
            em.push_text(rt);
            em.push_text("> = hashset_new::<");
            em.push_text(rt);
            em.push_text(">();\n");
        }
        em.push_text("    let mut __dl_");
        em.push_text(rn);
        em.push_text(": Vec<");
        em.push_text(rt);
        em.push_text("> = Vec::<");
        em.push_text(rt);
        em.push_text(">::new();\n");
        em.push_text("    let mut __nd_");
        em.push_text(rn);
        em.push_text(": Vec<");
        em.push_text(rt);
        em.push_text("> = Vec::<");
        em.push_text(rt);
        em.push_text(">::new();\n");
        m1 = m1 + 1i64;
    }
    // ── Seeds: bodies with no in-SCC source, once, into __nd ──
    let mut m2: i64 = 0i64;
    while m2 < nm {
        let ri: i64 = mem[m2];
        let bodies: RQBodyArr = rels.rel_at(ri).bodies_arr();
        let nb: i64 = bodies.len();
        // Any seed bodies at all? (skip the member block when none)
        let mut nseed: i64 = 0i64;
        let mut b0: i64 = 0i64;
        while b0 < nb {
            let oc0: OccList = body_scc_occs(bodies.body_any(b0), prm, scc, c, h);
            if oc0.n == 0i64 { nseed = nseed + 1i64; }
            b0 = b0 + 1i64;
        }
        if nseed > 0i64 {
            if prm.rel_is_agg[ri] { emit_member_block_open_agg(em, prm, ri); }
            else                  { emit_member_block_open(em, prm, ri); }
            let mut b1: i64 = 0i64;
            while b1 < nb {
                let oc1: OccList = body_scc_occs(bodies.body_any(b1), prm, scc, c, h);
                if oc1.n == 0i64 {
                    if !emit_rel_body(em, bodies.body_any(b1), ri, prm, h) { return false; }
                }
                b1 = b1 + 1i64;
            }
            em.push_text("    }\n");
        }
        m2 = m2 + 1i64;
    }
    // ── The fixpoint loop ──
    em.push_text("    loop {\n");
    // PROMOTE: dl ← nd, nd ← fresh, total ∪= dl (rows already in the set).
    let mut m3: i64 = 0i64;
    while m3 < nm {
        let rn3: str = prm.rel_names[mem[m3]];
        let rt3: str = prm.rel_rowty[mem[m3]];
        em.push_text("        __dl_");
        em.push_text(rn3);
        em.push_text(" = __nd_");
        em.push_text(rn3);
        em.push_text(";\n");
        em.push_text("        __nd_");
        em.push_text(rn3);
        em.push_text(" = Vec::<");
        em.push_text(rt3);
        em.push_text(">::new();\n");
        // Plain member: total ∪= dl (the shadow set already holds the rows). An
        // AGGREGATE member's total is the argmin/argmax MAP — materialized ONCE
        // after the fixpoint (the per-round best is the map, not an append-union),
        // so its promote is just the delta swap above.
        if !prm.rel_is_agg[mem[m3]] {
            em.push_text("        {\n");
            em.push_text("            let __ps: &[");
            em.push_text(rt3);
            em.push_text("] = __dl_");
            em.push_text(rn3);
            em.push_text(".as_slice();\n");
            em.push_text("            let mut __pk: i64 = 0i64;\n");
            em.push_text("            while __pk < __ps.len() {\n");
            em.push_text("                __tot_");
            em.push_text(rn3);
            em.push_text(".push(__ps[__pk]);\n");
            em.push_text("                __pk = __pk + 1i64;\n");
            em.push_text("            }\n");
            em.push_text("        }\n");
        }
        m3 = m3 + 1i64;
    }
    // EXIT: all deltas empty ⇒ least fixpoint.
    em.push_text("        if ");
    let mut m4: i64 = 0i64;
    while m4 < nm {
        if m4 > 0i64 { em.push_text(" && "); }
        em.push_text("__dl_");
        em.push_text(prm.rel_names[mem[m4]]);
        em.push_text(".len() == 0i64");
        m4 = m4 + 1i64;
    }
    em.push_text(" { break; }\n");
    // CONVERGENCE GUARD (aggregate members): a monotone min/max fixpoint over a
    // finite reachable key set converges in ≤ |keys|−1 improvement waves (each
    // wave extends the frontier by one hop; a shortest/widest path is simple).
    // A MINTING head (additive SSSP) over a NEGATIVE-weight cycle (min) / a
    // POSITIVE-weight cycle (max) has no least fixpoint and would improve
    // forever — capped generously (never false-fires on a valid graph; the
    // execution ABORTS with a diagnostic rather than hanging — termination is
    // sacred, design §5).
    let mut mg: i64 = 0i64;
    while mg < nm {
        if prm.rel_is_agg[mem[mg]] {
            let rng: str = prm.rel_names[mem[mg]];
            em.push_text("        __rounds_"); em.push_text(rng);
            em.push_text(" = __rounds_"); em.push_text(rng); em.push_text(" + 1i64;\n");
            em.push_text("        if __rounds_"); em.push_text(rng);
            em.push_text(" > (__best_"); em.push_text(rng);
            em.push_text(".len() as i64) * 4i64 + 16i64 { logos.lang.panic::panic(\"wql!: recursive aggregate '");
            em.push_text(rng);
            em.push_text("' did not converge — a negative-weight cycle (min) or positive-weight cycle (max) has no least fixpoint\"); }\n");
        }
        mg = mg + 1i64;
    }
    // BIND the round's slices. A plain member binds BOTH total + delta; an
    // AGGREGATE member's recursive body reads only the improvement DELTA (the
    // total is materialized post-loop), so bind the delta only.
    let mut m5: i64 = 0i64;
    while m5 < nm {
        let rn5: str = prm.rel_names[mem[m5]];
        let rt5: str = prm.rel_rowty[mem[m5]];
        if !prm.rel_is_agg[mem[m5]] {
            em.push_text("        let ");
            em.push_text(prm.rel_srcs[mem[m5]]);
            em.push_text(": &[");
            em.push_text(rt5);
            em.push_text("] = __tot_");
            em.push_text(rn5);
            em.push_text(".as_slice();\n");
        }
        em.push_text("        let ");
        em.push_text(prm.rel_dsrcs[mem[m5]]);
        em.push_text(": &[");
        em.push_text(rt5);
        em.push_text("] = __dl_");
        em.push_text(rn5);
        em.push_text(".as_slice();\n");
        m5 = m5 + 1i64;
    }
    // VARIANTS: every recursive body × its in-SCC occurrences.
    let mut m6: i64 = 0i64;
    while m6 < nm {
        let ri6: i64 = mem[m6];
        let bodies6: RQBodyArr = rels.rel_at(ri6).bodies_arr();
        let nb6: i64 = bodies6.len();
        let mut nrec: i64 = 0i64;
        let mut b2: i64 = 0i64;
        while b2 < nb6 {
            let oc2: OccList = body_scc_occs(bodies6.body_any(b2), prm, scc, c, h);
            if oc2.n > 0i64 { nrec = nrec + 1i64; }
            b2 = b2 + 1i64;
        }
        if nrec > 0i64 {
            if prm.rel_is_agg[ri6] { emit_member_block_open_agg(em, prm, ri6); }
            else                   { emit_member_block_open(em, prm, ri6); }
            let mut b3: i64 = 0i64;
            while b3 < nb6 {
                let body_any: WAny = bodies6.body_any(b3);
                let oc: OccList = body_scc_occs(body_any, prm, scc, c, h);
                if oc.n > 0i64 {
                    let mut v: i64 = 0i64;
                    while v < oc.n {
                        let mut w: i64 = 0i64;
                        while w < oc.n {
                            let nm_w: str = if w == v { prm.rel_dsrcs[oc.rel[w]] }
                                            else      { prm.rel_srcs[oc.rel[w]] };
                            set_occ_src(body_any, &oc, w, nm_w, h);
                            w = w + 1i64;
                        }
                        if !emit_rel_body(em, body_any, ri6, prm, h) { return false; }
                        v = v + 1i64;
                    }
                    // Restore the canonical (total) source names.
                    let mut w2: i64 = 0i64;
                    while w2 < oc.n {
                        set_occ_src(body_any, &oc, w2, prm.rel_srcs[oc.rel[w2]], h);
                        w2 = w2 + 1i64;
                    }
                }
                b3 = b3 + 1i64;
            }
            em.push_text("    }\n");
        }
        m6 = m6 + 1i64;
    }
    em.push_text("    }\n");
    // ── Materialize each AGGREGATE member's total = argmin/argmax per key ──
    // The fixpoint left the best value per key in the map; walk the distinct-key
    // roster and emit one `(key, best)` row into the caller's total Vec (the
    // entry/later strata scan its `as_slice()`, unchanged contract).
    let mut mt: i64 = 0i64;
    while mt < nm {
        if prm.rel_is_agg[mem[mt]] {
            let rnt: str = prm.rel_names[mem[mt]];
            let offt: i64 = prm.rel_coff[mem[mt]];
            let ktyt: str = prm.relc_ty[offt];
            let vtyt: str = prm.relc_ty[offt + 1i64];
            em.push_text("    {\n");
            em.push_text("        let mut __mk: i64 = 0i64;\n");
            em.push_text("        while __mk < __keys_"); em.push_text(rnt); em.push_text(".len() {\n");
            em.push_text("            let __kk: "); em.push_text(ktyt);
            em.push_text(" = __keys_"); em.push_text(rnt); em.push_text("[__mk];\n");
            em.push_text("            unsafe {\n");
            em.push_text("                let __vp: *const "); em.push_text(vtyt);
            em.push_text(" = (__bp_"); em.push_text(rnt); em.push_text(").get(&__kk);\n");
            em.push_text("                __tot_"); em.push_text(rnt); em.push_text(".push((__kk, *__vp));\n");
            em.push_text("            }\n");
            em.push_text("            __mk = __mk + 1i64;\n");
            em.push_text("        }\n");
            em.push_text("    }\n");
        }
        mt = mt + 1i64;
    }
    em.push_text("    return Result::Ok(());\n");
    em.push_text("}\n");
    return true;
}

// Open a member's push-target block: lexically rebind the body emitters'
// fixed `__out`/`__rsp` names onto THIS member's next-delta Vec + shadow set
// (sibling blocks scope-isolate the rebinding per member).
fn emit_member_block_open(em: &mut Emitter, prm: &MacroParams, ri: i64) {
    let rn: str = prm.rel_names[ri];
    let rt: str = prm.rel_rowty[ri];
    em.push_text("    {\n");
    em.push_text("    let __out: &mut Vec<");
    em.push_text(rt);
    em.push_text("> = &mut __nd_");
    em.push_text(rn);
    em.push_text(";\n");
    em.push_text("    let __rsp: *mut HashSet<");
    em.push_text(rt);
    em.push_text("> = &mut __rs_");
    em.push_text(rn);
    em.push_text(";\n");
}

// Open an AGGREGATE member's push-target block: bind `__out` onto this member's
// improvement-delta Vec (the semilattice absorb pushes improved rows there). The
// best-map pointer `__bp_<rel>` + distinct-key roster `__keys_<rel>` are named
// per rel in the fn's state, so the absorb (emit_rel_push_agg) references them
// directly — no shadow-set rebind.
fn emit_member_block_open_agg(em: &mut Emitter, prm: &MacroParams, ri: i64) {
    let rn: str = prm.rel_names[ri];
    let rt: str = prm.rel_rowty[ri];
    em.push_text("    {\n");
    em.push_text("    let __out: &mut Vec<");
    em.push_text(rt);
    em.push_text("> = &mut __nd_");
    em.push_text(rn);
    em.push_text(";\n");
}

// ── The rel-tier emission entry ──────────────────────────────────────────────
// One chunk: per non-recursive rel a one-shot helper fn (slice B), per
// RECURSIVE SCC one semi-naïve fixpoint fn (slice C) — emitted in condensation
// topo order (cosmetic: top-level fns don't need it). The walker has already
// validated columns/shapes/modifiers, resolved + REWRITTEN every body source,
// and checked stratification. `fn_name` is the entry resource name — it
// prefixes the helper names so multiple wql! resources per module coexist.
pub fn emit_rel_fns(rels: RQRelArr, fn_name: str, params_text: str,
                    prm: &MacroParams, scc: &RelScc, h: &Writ) -> bool {
    let view: OView = oview_module_ast();
    let mut em: Emitter = Emitter::new();
    let mut __uses: String = String::new();
    prm.native_use_text(&mut __uses);
    begin_chunk(&mut em, &view, string_as_str(&__uses));
    let mut p: i64 = 0i64;
    while p < scc.nscc {
        let c: i64 = scc.order[p];
        if scc.rec[c] {
            if !emit_scc_fn(&mut em, rels, c, fn_name, params_text, prm, scc, h) { return false; }
        } else {
            let mut i: i64 = 0i64;
            while i < prm.rel_n {
                // NATIVE rels (ADR 0016 M1a) have no parse-side RQRel and no
                // emitted helper fn — their prelude calls the stdlib walk.
                // (Registry idx 0..nr-1 is parse-aligned; natives sit after.)
                if scc.comp[i] == c && !prm.rel_native[i] {
                    if !emit_rel_fn_oneshot(&mut em, rels.rel_at(i), i, fn_name,
                                            params_text, prm, scc, h) { return false; }
                }
                i = i + 1i64;
            }
        }
        p = p + 1i64;
    }
    em.commit();
    return true;
}
