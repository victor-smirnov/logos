// logos.std.wql.core — the Deem CORE (ADR 0031): one normalised clause form
// between the surface (`RQuery`, four shapes, from wql.peg) and everything that
// plans, checks, rewrites or emits.
//
// The relational structure is LOGOS TYPES, not a Writ schema, so a `match` over
// a core node is checked for exhaustiveness by the compiler: a new literal kind
// reds every consumer at build time instead of falling into a default arm (the
// gap behind Soufflé's silent miscompile, ADR 0031 §2). Scalar expressions stay
// `SExpr` handles — that algebra is already one form for every shape.
//
// R0: the surface is LOWERED here once, for the entry and every rel body, and
// `core_verify` checks the result; nothing consumes it yet. `LOGOS_DEEM_DUMP=core`
// prints it.
package logos.std.wql.core;

use logos.lang.writ.anyval;
use logos.lang.str;
use logos.lang.option;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.std.wql.ir;      // SExpr and its nodes, WRef, list_get
use logos.std.wql.plan;    // RQuery and the program schemas
use logos.std.wql.el;      // OP_* codes

extern fn getenv(name: *const u8) -> *const u8;
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;

// ── the core ───────────────────────────────────────────────────────────────

/// What a positive or negated atom reads.
pub enum CSrc {
    /// A rel of the program, by its index in `CProgram.rels`.
    Rel(i64),
    /// A source parameter (slice, native source, mapping-bound param).
    Param(str),
    /// The one-row relation a FROM-less `select` reads.
    Unit,
}

/// A source atom: binds `var` to each row of `src`. A NEGATED atom binds
/// nothing visible outside it; its `conds` are the anti join's `on`, scoped to
/// the negation (`!exists var in src: conds`).
pub struct CAtom {
    pub src: CSrc,
    pub var: str,
    pub row_ty: str,
    pub neg: bool,
    pub conds: Vec<WAny>,
}

/// A traversal: binds `var` to each element reached from the row bound to
/// `base` along `path` (`join n.kids k`). Negated = an anti traversal.
pub struct CTrav {
    pub base: str,
    pub path: Vec<str>,
    pub var: str,
    pub row_ty: str,
    pub neg: bool,
    pub conds: Vec<WAny>,
}

pub enum CLit {
    Atom(CAtom),
    Trav(CTrav),
    /// A condition over the variables bound before it.
    Cond(WAny),
}

pub struct CAgg {
    pub name: str,
    pub func: str,
    pub arg: Option<WAny>,
}

/// `group by key`, the aggregates over each group, and `having` over the
/// group's row. At most one per clause; aggregates live only here.
pub struct CGroup {
    pub key: WAny,
    pub aggs: Vec<CAgg>,
    pub having: Option<WAny>,
}

pub struct CClause {
    /// The projected row (`select …`). Null only in `Find` mode, whose answer
    /// is the row bound by the first atom.
    pub head: WAny,
    pub body: Vec<CLit>,
    pub group: Option<CGroup>,
}

pub struct CCol {
    pub name: str,
    pub ty: str,
}

pub struct CRel {
    pub name: str,
    pub cols: Vec<CCol>,
    pub rules: Vec<CRule>,
}

pub enum CMode {
    All,
    /// `select first` — the first answer row, `Option`.
    First,
    /// `find` — the first source row satisfying the body.
    Find,
}

pub enum CLimit {
    None,
    N(i64),
    Param(str),
}

/// The OUTPUT ENVELOPE — what only the entry has: how its rows are delivered.
pub struct CEnvelope {
    pub mode: CMode,
    pub distinct: bool,
    pub order: Option<WAny>,
    pub desc: bool,
    pub limit: CLimit,
    pub result_ty: str,
}

/// A clause and how its rows are delivered. The ENTRY is a rule like any rel
/// body; only the checks differ — a rel body's envelope must be the default
/// one (a rel is a set: no order, no limit, no first), which is a refusal for
/// the checker to issue, so the core keeps what was written.
pub struct CRule {
    pub clause: CClause,
    pub env: CEnvelope,
}

pub struct CProgram {
    pub rels: Vec<CRel>,
    pub entry: CRule,
}

// ── lowering: the four surface shapes and the rel bodies, ONCE ─────────────

// The program's rel names, in order — a program with no rel has no rel array
// at all (`has_rels`), not an empty one.
fn prog_rel_names(root: WAny) -> Vec<str> {
    let mut out: Vec<str> = Vec::<str>::new();
    let prog: RQProgram = root.view::<RQProgram>();
    if !prog.has_rels() { return out; }
    let ra: RQRelArr = prog.rels_arr();
    let mut i: i64 = 0i64;
    while i < ra.len() { out.push(ra.rel_at(i).name); i = i + 1i64; }
    return out;
}

fn rel_index(rels: &Vec<str>, name: str) -> i64 {
    let mut i: i64 = 0i64;
    while i < rels.len() {
        if str_eq(rels.get(i), name) { return i; }
        i = i + 1i64;
    }
    return -1i64;
}

fn src_of(rels: &Vec<str>, name: str) -> CSrc {
    if name.len() == 0i64 { return CSrc::Unit; }
    let r: i64 = rel_index(rels, name);
    if r >= 0i64 { return CSrc::Rel(r); }
    return CSrc::Param(name);
}

fn opt(present: bool, e: WAny) -> Option<WAny> {
    if present && !e.is_null() { return Option::Some(e); }
    return Option::None;
}

fn base_atom(rels: &Vec<str>, src: str, var: str, row_ty: str) -> CLit {
    // A FROM-less `select` names no row; its one row is `__unit`'s, bound to
    // `__u` — the names `desugar_program_facts` gives the same rewrite.
    let v: str = if src.len() == 0i64 && var.len() == 0i64 { "__u" } else { var };
    return CLit::Atom(CAtom { src: src_of(rels, src), var: v, row_ty: row_ty,
                              neg: false, conds: Vec::<WAny>::new() });
}

// A join chain's steps, in order: each step an atom (or a traversal), and a
// positive step's `on` a condition right after it; an anti step keeps its
// `on` inside the negation.
fn lower_steps(rels: &Vec<str>, steps: WAny, body: &mut Vec<CLit>) {
    if steps.is_null() { return; }
    let sa: RQJoinStepArr = steps.view::<RQJoinStepArr>();
    let mut i: i64 = 0i64;
    while i < sa.len() {
        let st: RQJoinStep = sa.step_at(i);
        let mut conds: Vec<WAny> = Vec::<WAny>::new();
        let on: WAny = st.on.any();
        let has_on: bool = st.has_on && !on.is_null();
        if st.is_anti && has_on { conds.push(on); }
        if st.is_edge {
            let mut path: Vec<str> = Vec::<str>::new();
            let pa: RQPathSegArr = st.path_arr();
            let mut k: i64 = 0i64;
            while k < pa.len() { path.push(pa.seg_at(k).name); k = k + 1i64; }
            body.push(CLit::Trav(CTrav { base: st.base_var, path: path, var: st.var_name,
                                         row_ty: st.row_ty, neg: st.is_anti, conds: conds }));
        } else {
            body.push(CLit::Atom(CAtom { src: src_of(rels, st.src_name), var: st.var_name,
                                         row_ty: st.row_ty, neg: st.is_anti, conds: conds }));
        }
        if !st.is_anti && has_on { body.push(CLit::Cond(on)); }
        i = i + 1i64;
    }
}

fn limit_of(has: bool, n: i64, is_param: bool, param: str) -> CLimit {
    if !has { return CLimit::None; }
    if is_param { return CLimit::Param(param); }
    return CLimit::N(n);
}

/// One surface query → its clause and its envelope. A rel body's envelope is
/// read too: the walker refuses the modifiers a rel body may not carry, and
/// the core keeps what was written so that refusal has a single source.
pub fn lower_query(rels: &Vec<str>, q: WAny, env: &mut CEnvelope) -> CClause {
    let mut body: Vec<CLit> = Vec::<CLit>::new();
    match q.view::<RQuery>() {
        RQuery::Simple(s) => {
            body.push(base_atom(rels, s.src_name, s.var_name, s.row_ty));
            if s.has_where { body.push(CLit::Cond(s.where_pred.any())); }
            env.mode = if s.sel_first { CMode::First } else { CMode::All };
            env.distinct = s.distinct;
            env.order = opt(s.has_order, s.order_key.any());
            env.desc = s.order_desc;
            env.limit = limit_of(s.has_limit, s.limit_n, s.limit_is_param, s.limit_param);
            env.result_ty = if s.has_result_ty { s.result_ty } else { "" };
            return CClause { head: s.select.any(), body: body, group: Option::None };
        }
        RQuery::Join(j) => {
            body.push(base_atom(rels, j.a_name, j.x_var, j.a_ty));
            lower_steps(rels, j.steps.any(), &mut body);
            if j.has_where { body.push(CLit::Cond(j.where_pred.any())); }
            env.mode = if j.sel_first { CMode::First } else { CMode::All };
            env.distinct = j.distinct;
            env.order = opt(j.has_order, j.order_key.any());
            env.desc = j.order_desc;
            env.limit = limit_of(j.has_limit, j.limit_n, j.limit_is_param, j.limit_param);
            env.result_ty = if j.has_result_ty { j.result_ty } else { "" };
            return CClause { head: j.select.any(), body: body, group: Option::None };
        }
        RQuery::Aggr(g) => {
            body.push(base_atom(rels, g.a_name, g.x_var, g.a_ty));
            lower_steps(rels, g.steps.any(), &mut body);
            if g.has_where { body.push(CLit::Cond(g.where_pred.any())); }
            let mut aggs: Vec<CAgg> = Vec::<CAgg>::new();
            if !g.aggs.any().is_null() {
                let aa: RQAggArr = g.aggs_arr();
                let mut i: i64 = 0i64;
                while i < aa.len() {
                    let a: RQAgg = aa.agg_at(i);
                    aggs.push(CAgg { name: a.name, func: a.fn_name, arg: opt(a.has_arg, a.arg.any()) });
                    i = i + 1i64;
                }
            }
            let grp: CGroup = CGroup { key: g.key.any(), aggs: aggs,
                                       having: opt(g.has_having, g.having_pred.any()) };
            env.mode = if g.sel_first { CMode::First } else { CMode::All };
            env.distinct = g.distinct;
            env.order = opt(g.has_order, g.order_key.any());
            env.desc = g.order_desc;
            env.limit = limit_of(g.has_limit, g.limit_n, g.limit_is_param, g.limit_param);
            env.result_ty = if g.has_result_ty { g.result_ty } else { "" };
            return CClause { head: g.select.any(), body: body, group: Option::Some(grp) };
        }
        RQuery::Find(f) => {
            body.push(base_atom(rels, f.src_name, f.var_name, f.row_ty));
            body.push(CLit::Cond(f.pred.any()));
            env.mode = CMode::Find;
            return CClause { head: WAny::null(), body: body, group: Option::None };
        }
    }
}

fn envelope_new() -> CEnvelope {
    return CEnvelope { mode: CMode::All, distinct: false, order: Option::None, desc: false,
                       limit: CLimit::None, result_ty: "" };
}

/// The whole program: every rel's bodies, then the entry.
pub fn lower_program(root: WAny) -> CProgram {
    let names: Vec<str> = prog_rel_names(root);
    let prog: RQProgram = root.view::<RQProgram>();
    let mut rels: Vec<CRel> = Vec::<CRel>::new();
    let mut r: i64 = 0i64;
    while r < names.len() {
        let rq: RQRel = prog.rels_arr().rel_at(r);
        let mut cols: Vec<CCol> = Vec::<CCol>::new();
        if !rq.cols.any().is_null() {
            let ca: RQRelColArr = rq.cols_arr();
            let mut c: i64 = 0i64;
            while c < ca.len() {
                let col: RQRelCol = ca.col_at(c);
                cols.push(CCol { name: col.name, ty: col.ty_name });
                c = c + 1i64;
            }
        }
        let mut rules: Vec<CRule> = Vec::<CRule>::new();
        if !rq.bodies.any().is_null() {
            let ba: RQBodyArr = rq.bodies_arr();
            let mut b: i64 = 0i64;
            while b < ba.len() {
                let mut env: CEnvelope = envelope_new();
                let cl: CClause = lower_query(&names, ba.body_any(b), &mut env);
                rules.push(CRule { clause: cl, env: env });
                b = b + 1i64;
            }
        }
        rels.push(CRel { name: rq.name, cols: cols, rules: rules });
        r = r + 1i64;
    }
    let mut env: CEnvelope = envelope_new();
    let entry: CClause = lower_query(&names, prog.entry.any(), &mut env);
    return CProgram { rels: rels, entry: CRule { clause: entry, env: env } };
}

// ── verification: what the LOWERING guarantees, checked; a violation is an ICE ─
//
// R0 checks STRUCTURE only. A user's scope error (an unknown variable) is
// still the walker's to diagnose, after this point, so it must not become an
// ICE here; the binding invariants join this verifier when the scope checks
// move onto the core (ADR 0031 R2).

fn ice(what: str, rel: str) {
    let mut m: String = String::new();
    m.push_str("ICE: deem core_verify: ");
    m.push_str(what);
    m.push_str(" (in `");
    m.push_str(rel);
    m.push_str("`) — the lowering broke an invariant of the core (ADR 0031 §3.1)");
    logos.lang.panic::panic(unsafe { str_from_raw(m.as_ptr(), m.len()) });
}

fn verify_rule(p: &CProgram, ru: &CRule, rel: str) {
    let find: bool = match &ru.env.mode { CMode::Find => { true } CMode::All => { false } CMode::First => { false } };
    verify_clause(p, &ru.clause, rel, find);
    match &ru.env.limit {
        CLimit::N(n) => { if *n < 0i64 { ice("a negative limit", rel); } }
        CLimit::Param(n) => { if (*n).len() == 0i64 { ice("an unnamed limit parameter", rel); } }
        CLimit::None => { }
    }
}

fn verify_clause(p: &CProgram, cl: &CClause, rel: str, entry_find: bool) {
    if cl.body.len() == 0i64 { ice("a clause with an empty body", rel); }
    let bs: &[CLit] = cl.body.as_slice();
    match &bs[0i64] {
        CLit::Atom(a) => { if a.neg { ice("a clause whose first literal is negated", rel); } }
        CLit::Trav(_t) => { ice("a clause whose first literal is a traversal (no base row)", rel); }
        CLit::Cond(_c) => { ice("a clause whose first literal is a condition", rel); }
    }
    let mut i: i64 = 0i64;
    while i < cl.body.len() {
        match &bs[i] {
            CLit::Atom(a) => {
                if a.var.len() == 0i64 { ice("an atom binds no variable", rel); }
                match &a.src {
                    CSrc::Rel(r) => { if *r < 0i64 || *r >= p.rels.len() { ice("an atom reads a rel index out of range", rel); } }
                    CSrc::Param(n) => { if n.len() == 0i64 { ice("an atom reads an unnamed parameter", rel); } }
                    CSrc::Unit => { }
                }
                if !a.neg && a.conds.len() > 0i64 { ice("a positive atom carries scoped conditions", rel); }
            }
            CLit::Trav(t) => {
                if t.var.len() == 0i64 || t.base.len() == 0i64 { ice("a traversal without a base or a variable", rel); }
                if t.path.len() == 0i64 { ice("a traversal with an empty path", rel); }
                if !t.neg && t.conds.len() > 0i64 { ice("a positive traversal carries scoped conditions", rel); }
            }
            CLit::Cond(e) => { if (*e).is_null() { ice("a null condition", rel); } }
        }
        i = i + 1i64;
    }
    if cl.head.is_null() && !entry_find { ice("a clause with no head outside `find` mode", rel); }
    match &cl.group {
        Option::Some(g) => {
            let ag: &[CAgg] = g.aggs.as_slice();
            let mut k: i64 = 0i64;
            while k < g.aggs.len() {
                let a: &CAgg = &ag[k];
                if a.name.len() == 0i64 || a.func.len() == 0i64 { ice("an aggregate without a name or a function", rel); }
                k = k + 1i64;
            }
        }
        Option::None => { }
    }
}

pub fn core_verify(p: &CProgram) {
    let rs: &[CRel] = p.rels.as_slice();
    let mut r: i64 = 0i64;
    while r < p.rels.len() {
        let rel: &CRel = &rs[r];
        if rel.rules.len() == 0i64 { ice("a rel with no clause", rel.name); }
        let cs: &[CRule] = rel.rules.as_slice();
        let mut c: i64 = 0i64;
        while c < rel.rules.len() {
            verify_rule(p, &cs[c], rel.name);
            c = c + 1i64;
        }
        r = r + 1i64;
    }
    verify_rule(p, &p.entry, "<entry>");
}

// ── dump: `LOGOS_DEEM_DUMP=core` ────────────────────────────────────────────

fn op_sym(op: i32) -> str {
    if op == OP_OR()  { return "||"; }
    if op == OP_AND() { return "&&"; }
    if op == OP_EQ()  { return "=="; }
    if op == OP_NE()  { return "!="; }
    if op == OP_LT()  { return "<"; }
    if op == OP_LE()  { return "<="; }
    if op == OP_GT()  { return ">"; }
    if op == OP_GE()  { return ">="; }
    if op == OP_ADD() { return "+"; }
    if op == OP_SUB() { return "-"; }
    if op == OP_MUL() { return "*"; }
    if op == OP_DIV() { return "/"; }
    if op == OP_MOD() { return "%"; }
    return "?op";
}

fn expr_args(a: SExprArr, out: &mut String) {
    let mut i: i64 = 0i64;
    while i < a.len() {
        if i > 0i64 { out.push_str(", "); }
        expr_text(a.arg_at(i), out);
        i = i + 1i64;
    }
}

/// An SExpr as Deem source text (for the dump; not a code emitter).
pub fn expr_text(e: SExpr, out: &mut String) {
    match e {
        SExpr::Lit(l) => {
            if l.txt.len() > 0i64 { out.push_str(l.txt); }
            else if l.val.is_string() { out.push_str("\""); out.push_str(l.val.as_wstr()); out.push_str("\""); }
            else if l.val.is_bool() { if l.val.as_bool() { out.push_str("true"); } else { out.push_str("false"); } }
            else { out.push_i64(l.val.as_i64()); }
        }
        SExpr::Param(p) => { out.push_str("$"); out.push_str(p.name); }
        SExpr::Var(v) => { out.push_str(v.name); }
        SExpr::Field(f) => {
            if !f.base.any().is_null() { expr_text(f.base_expr(), out); out.push_str("."); }
            out.push_str(f.name);
        }
        SExpr::Bin(b) => {
            out.push_str("(");
            expr_text(b.lhs_expr(), out);
            out.push_str(" "); out.push_str(op_sym(b.op)); out.push_str(" ");
            expr_text(b.rhs_expr(), out);
            out.push_str(")");
        }
        SExpr::Un(u) => {
            if u.op == OP_NOT() { out.push_str("!"); } else { out.push_str("-"); }
            expr_text(u.arg_expr(), out);
        }
        SExpr::Call(c) => { out.push_str(c.fn_name); out.push_str("("); expr_args(c.args_arr(), out); out.push_str(")"); }
        SExpr::Cond(c) => {
            out.push_str("(if "); expr_text(c.cond_expr(), out);
            out.push_str(" then "); expr_text(c.then_expr(), out);
            out.push_str(" else "); expr_text(c.else_expr(), out); out.push_str(")");
        }
        SExpr::Comp(cp) => { out.push_str("[comprehension over "); out.push_str(cp.var); out.push_str("]"); }
        SExpr::Tuple(t) => { out.push_str("("); expr_args(t.items_arr(), out); out.push_str(")"); }
        SExpr::Cast(c) => { out.push_str("("); expr_text(c.arg_expr(), out); out.push_str(" as "); out.push_str(c.ty); out.push_str(")"); }
    }
}

fn any_text(e: WAny, out: &mut String) {
    if e.is_null() { out.push_str("<none>"); return; }
    expr_text(e.view::<SExpr>(), out);
}

fn conds_text(cs: &Vec<WAny>, out: &mut String) {
    if cs.len() == 0i64 { return; }
    out.push_str(" [");
    let mut i: i64 = 0i64;
    while i < cs.len() {
        if i > 0i64 { out.push_str(", "); }
        any_text(cs.get(i), out);
        i = i + 1i64;
    }
    out.push_str("]");
}

fn src_text(p: &CProgram, s: &CSrc, out: &mut String) {
    match s {
        CSrc::Rel(r) => { out.push_str(p.rels.as_slice()[*r].name); }
        CSrc::Param(n) => { out.push_str("param "); out.push_str(*n); }
        CSrc::Unit => { out.push_str("__unit"); }
    }
}

fn clause_text(p: &CProgram, cl: &CClause, out: &mut String) {
    out.push_str("    ");
    any_text(cl.head, out);
    out.push_str(" :-");
    let bs: &[CLit] = cl.body.as_slice();
    let mut i: i64 = 0i64;
    while i < cl.body.len() {
        out.push_str(if i == 0i64 { " " } else { ", " });
        match &bs[i] {
            CLit::Atom(a) => {
                if a.neg { out.push_str("!"); }
                src_text(p, &a.src, out);
                out.push_str("("); out.push_str(a.var); out.push_str(")");
                conds_text(&a.conds, out);
            }
            CLit::Trav(t) => {
                if t.neg { out.push_str("!"); }
                out.push_str(t.base);
                let mut k: i64 = 0i64;
                while k < t.path.len() { out.push_str("."); out.push_str(t.path.get(k)); k = k + 1i64; }
                out.push_str("("); out.push_str(t.var); out.push_str(")");
                conds_text(&t.conds, out);
            }
            CLit::Cond(e) => { any_text(*e, out); }
        }
        i = i + 1i64;
    }
    match &cl.group {
        Option::Some(g) => {
            out.push_str("\n      group "); any_text(g.key, out);
            let ag: &[CAgg] = g.aggs.as_slice();
            let mut k: i64 = 0i64;
            while k < g.aggs.len() {
                let a: &CAgg = &ag[k];
                out.push_str(if k == 0i64 { " { " } else { ", " });
                out.push_str(a.name); out.push_str(" = "); out.push_str(a.func); out.push_str("(");
                match &a.arg { Option::Some(x) => { any_text(*x, out); } Option::None => { } }
                out.push_str(")");
                k = k + 1i64;
            }
            if g.aggs.len() > 0i64 { out.push_str(" }"); }
            match &g.having { Option::Some(h) => { out.push_str(" having "); any_text(*h, out); } Option::None => { } }
        }
        Option::None => { }
    }
    out.push_str("\n");
}

// The envelope's non-default parts, each with a leading space.
fn env_text(e: &CEnvelope, out: &mut String) {
    match &e.mode { CMode::All => { } CMode::First => { out.push_str(" first"); } CMode::Find => { out.push_str(" find"); } }
    if e.distinct { out.push_str(" distinct"); }
    match &e.order {
        Option::Some(o) => { out.push_str(" order "); any_text(*o, out); if e.desc { out.push_str(" desc"); } }
        Option::None => { }
    }
    match &e.limit {
        CLimit::N(n) => { out.push_str(" limit "); out.push_i64(*n); }
        CLimit::Param(n) => { out.push_str(" limit $"); out.push_str(*n); }
        CLimit::None => { }
    }
    if e.result_ty.len() > 0i64 { out.push_str(" : "); out.push_str(e.result_ty); }
}

pub fn core_text(p: &CProgram, name: str, out: &mut String) {
    out.push_str("[core] deem "); out.push_str(name); out.push_str("\n");
    let rs: &[CRel] = p.rels.as_slice();
    let mut r: i64 = 0i64;
    while r < p.rels.len() {
        let rel: &CRel = &rs[r];
        out.push_str("  rel "); out.push_str(rel.name); out.push_str("(");
        let mut c: i64 = 0i64;
        while c < rel.cols.len() {
            if c > 0i64 { out.push_str(", "); }
            out.push_str(rel.cols.get(c).name); out.push_str(": "); out.push_str(rel.cols.get(c).ty);
            c = c + 1i64;
        }
        out.push_str(")\n");
        let cs: &[CRule] = rel.rules.as_slice();
        let mut k: i64 = 0i64;
        while k < rel.rules.len() {
            let mut et: String = String::new();
            env_text(&cs[k].env, &mut et);
            if et.len() > 0i64 { out.push_str("   ["); out.push_str(unsafe { str_from_raw(et.as_ptr(), et.len()) }); out.push_str(" ]\n"); }
            clause_text(p, &cs[k].clause, out);
            k = k + 1i64;
        }
        r = r + 1i64;
    }
    out.push_str("  entry");
    env_text(&p.entry.env, out);
    out.push_str("\n");
    clause_text(p, &p.entry.clause, out);
}

/// `LOGOS_DEEM_DUMP=core`: the core of every deem, on stderr.
pub fn core_dump_on() -> bool {
    let mut c: String = String::new();
    c.push_str("LOGOS_DEEM_DUMP");
    c.push_u8(0u8);
    unsafe {
        let v: *const u8 = getenv(c.as_ptr());
        if v == 0 as *const u8 { return false; }
        return str_eq(str_from_cstr(v), "core");
    }
}

/// Lower, verify, and dump when asked. The one entry point the handler calls.
pub fn core_build(root: WAny, name: str) -> CProgram {
    let p: CProgram = lower_program(root);
    core_verify(&p);
    if core_dump_on() {
        let mut s: String = String::new();
        core_text(&p, name, &mut s);
        unsafe { write(2i32, s.as_ptr(), s.len()); }
    }
    return p;
}
