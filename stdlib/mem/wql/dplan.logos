// logos.std.wql.dplan — the Deem PLAN as data (ADR 0031 R5).
//
// A decision the planner makes is a value of this module's types, made by a
// pure function of the facts it reads and RECORDED with its ground; an emitter
// reads the value and never re-derives it. R5 moves the decisions here one at a
// time, each move checked by a byte-identical snapshot of the emitted code and
// the plan traces of the whole corpus (ADR 0031 §4.1).
//
// R5.0 — the entry's SCAN: which of the seven scan shapes a single-source
// query runs, and whether its `order by` is elided by the source's own order.
package logos.std.wql.dplan;

use logos.lang.str;
use logos.mem.string;
use logos.std.wql.params;          // MacroParams: the source registry the decision reads
use logos.std.wql.core;            // the core: the clauses a decision reads
use logos.std.wql.ir;              // SExpr
use logos.lang.writ.anyval;        // WAny::view
use logos.std.wql.codegen;         // sexpr_over_group_names
use logos.std.wql.optimize;        // simplify_sexpr, sexpr_const, is_identity_sel
use logos.lang.writ.container;     // Writ
use logos.mem.collections.vec;
use logos.lang.option;
use logos.std.wql.el;              // el_ret_class — a by-value (scalar) element
use logos.std.wql.typing;          // type_clause — the clause typing every decision reads
use logos.std.wql.join_sel;        // decide_join_step, trace_step, JS_NONE — the join-step decision
use logos.std.wql.why;             // jg_pack — a decision's ground
use logos.std.compiler.metaprog;   // OView, oview_module_ast
use logos.std.wql.reflect;         // stamp_type_fields — a rel-backed entry's input row (R7.4b)

extern fn getenv(name: *const u8) -> *const u8;
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;

/// The shape a single-source scan runs. Exhaustive: an emitter `match`es it.
pub enum DScanArm {
    /// `order by` over a slice parameter: collect index + key over the
    /// `SliceStream` wrap, sort the permutation, project through it.
    SortSlice,
    /// `order by` over anything else: the same three phases over an indexed walk.
    SortIndexed,
    /// An unmaterialised batch producer read BACKWARD (`order by … desc` over
    /// its own order): `land_end`, `prev_batch`, a decrementing inner loop.
    BatchRev,
    /// An unmaterialised batch producer read forward: §1's one batch shape.
    BatchFwd,
    /// An unmaterialised row producer: `next()` until `None`.
    RowPull,
    /// A slice parameter with no registry identity: the `SliceStream` wrap.
    SliceWrap,
    /// Everything else (a materialised rel, a drained source): an indexed walk.
    Indexed,
}

pub struct DScan {
    /// The source as the query names it.
    pub src: str,
    /// Its registry index, or -1 (a slice parameter has none).
    pub rel: i64,
    pub arm: DScanArm,
    /// The source's rows already arrive in the `order by`'s order
    /// (`AccessPlan.ord_noop`), so the query's sort is dropped.
    pub sort_elided: bool,
    /// The source is a slice parameter read through a `SliceStream` wrap.
    pub slice: bool,
}

/// A slice parameter with no registry identity — read through a `SliceStream`
/// wrap (ADR 0025 R-A). THE one copy of this predicate.
pub fn dp_slice_stream_src(prm: &MacroParams, src: str) -> bool {
    if prm.rel_find_src(src) >= 0i64 { return false; }
    return prm.is_source(src);
}

/// The entry scan's shape, from the facts the access plan left on the
/// registry. `has_sort`: the query writes an `order by`.
pub fn plan_entry_scan(prm: &MacroParams, src: str, has_sort: bool) -> DScan {
    let elided: bool = has_sort && prm.rel_src_ord_noop(src);
    let sorts: bool = has_sort && !elided;
    let slice: bool = dp_slice_stream_src(prm, src);
    let rel: i64 = prm.rel_find_src(src);
    let mut arm: DScanArm = DScanArm::Indexed;
    if sorts {
        arm = if slice { DScanArm::SortSlice } else { DScanArm::SortIndexed };
    } else if prm.rel_src_unmaterialized(src) {
        if rel >= 0i64 && prm.rel_batch[rel] {
            arm = if prm.rel_src_ord_rev(src) { DScanArm::BatchRev } else { DScanArm::BatchFwd };
        } else {
            arm = DScanArm::RowPull;
        }
    } else if slice {
        arm = DScanArm::SliceWrap;
    }
    let d: DScan = DScan { src: src, rel: rel, arm: arm, sort_elided: elided, slice: slice };
    dplan_dump_scan(&d);
    return d;
}

/// THE GROUP-FRAME CLASS (ADR 0025 S4): TRUE iff every clause above the group —
/// `select`, `having`, `order by` — reads only `key` and the aggregate outputs,
/// so no group carries a representative base row. Decided ONCE, here: the
/// planner (single pass) and the emitter (`__g_row` or not) both read it — they
/// used to ask it separately, of two different trees.
pub fn plan_group_pure(ru: &CRule) -> bool {
    match &ru.clause.group {
        Option::None => { return false; }
        Option::Some(g) => {
            let mut onames: Vec<str> = Vec::<str>::new();
            let ags: &[CAgg] = g.aggs.as_slice();
            let mut j: i64 = 0i64;
            while j < g.aggs.len() { onames.push(ags[j].name); j = j + 1i64; }
            let n: i64 = onames.len();
            if !sexpr_over_group_names(ru.clause.head.view::<SExpr>(), &onames, n) { return false; }
            match &g.having {
                Option::Some(h) => { if !sexpr_over_group_names((*h).view::<SExpr>(), &onames, n) { return false; } }
                Option::None => { }
            }
            match &ru.env.order {
                Option::Some(o) => { if !sexpr_over_group_names((*o).view::<SExpr>(), &onames, n) { return false; } }
                Option::None => { }
            }
            return true;
        }
    }
}

/// What a single-source entry (the `Simple` and `find` shapes) is, once its
/// constant clauses are folded: no rows at all, the source itself (or its first
/// row), or a scan.
pub enum DForm {
    /// `where` folds to false, or `limit 0`: an empty answer, no scan.
    Empty,
    /// Nothing filters, sorts, dedups or limits, and the row IS the select
    /// (or `find` with nothing left to test): the source / its first row.
    Identity,
    Scan,
}

/// The single-source entry, its clauses folded (ADR 0031 R6.2): what the scan
/// emitter is handed. `pred` / `sort_key` null = none left.
pub struct DSimple {
    pub form: DForm,
    pub src: str,
    pub row_ty: str,
    pub var: str,
    pub pred: WAny,
    /// A group's `having`, folded (null = none left).
    pub having: WAny,
    pub sel: WAny,
    pub sort_key: WAny,
    pub sort_desc: bool,
    pub distinct: bool,
    pub has_limit: bool,
    pub limit_n: i64,
    pub limit_is_param: bool,
    pub limit_param: str,
}

// The entry's clauses folded as the relational simplifier folded them — the
// ONE copy, for every entry shape it serves: a constant `where` disappears
// (true) or empties the answer (false); a constant sort key drops the sort;
// `limit 0` empties it; identity needs a single bare source, no distinct or
// limit, and a select that is the row variable (or `find`). `cond` is the
// rule's one `where` (null = none).
fn dp_fold_entry(ru: &CRule, src: str, row_ty: str, var: str, cond: WAny, single: bool,
                 h: &Writ) -> DSimple {
    let find: bool = match &ru.env.mode { CMode::Find => { true } CMode::All => { false } CMode::First => { false } };
    let mut empty: bool = false;
    let mut pred: WAny = WAny::null();
    let mut having: WAny = WAny::null();
    let grouped: bool = match &ru.clause.group { Option::Some(_g) => { true } Option::None => { false } };
    if grouped {
        // Under a group the `where` is NOT folded — the simplifier never looked
        // inside the group node — and the `having` above it is.
        pred = cond;
        match &ru.clause.group {
            Option::Some(g) => {
                match &g.having {
                    Option::Some(hv) => {
                        let hh: WRef<SExpr> = simplify_sexpr((*hv).view::<SExpr>(), h);
                        let hc: ConstVal = sexpr_const(hh.any().view::<SExpr>());
                        if hc.is_bool() {
                            if !hc.b { empty = true; }
                        } else {
                            having = hh.any();
                        }
                    }
                    Option::None => { }
                }
            }
            Option::None => { }
        }
    } else if !cond.is_null() {
        let ph: WRef<SExpr> = simplify_sexpr(cond.view::<SExpr>(), h);
        let pc: ConstVal = sexpr_const(ph.any().view::<SExpr>());
        if pc.is_bool() {
            if !pc.b { empty = true; }
        } else {
            pred = ph.any();
        }
    }
    let mut sort_key: WAny = WAny::null();
    match &ru.env.order {
        Option::Some(o) => {
            if !empty {
                let kh: WRef<SExpr> = simplify_sexpr((*o).view::<SExpr>(), h);
                let mut lit: bool = false;
                match kh.any().view::<SExpr>() { SExpr::Lit(_l) => { lit = true; } _ => { } }
                if !lit { sort_key = kh.any(); }
            }
        }
        Option::None => { }
    }
    let mut has_limit: bool = false;
    let mut limit_n: i64 = 0i64;
    let mut limit_is_param: bool = false;
    let mut limit_param: str = "";
    match &ru.env.limit {
        CLimit::None => { }
        CLimit::N(n) => { has_limit = true; limit_n = *n; if *n == 0i64 { empty = true; } }
        CLimit::Param(q) => { has_limit = true; limit_is_param = true; limit_param = *q; }
    }
    let mut form: DForm = DForm::Scan;
    if empty {
        form = DForm::Empty;
    } else if single && !has_limit && !ru.env.distinct && sort_key.is_null() && pred.is_null()
              && (find || is_identity_sel(WRef::<SExpr>::from_any(ru.clause.head), var)) {
        form = DForm::Identity;
    }
    return DSimple { form: form, src: src, row_ty: row_ty, var: var, pred: pred, having: having,
                     sel: ru.clause.head, sort_key: sort_key, sort_desc: ru.env.desc,
                     distinct: ru.env.distinct, has_limit: has_limit, limit_n: limit_n,
                     limit_is_param: limit_is_param, limit_param: limit_param };
}

// The rule's base atom (positive, unconditioned), or None.
fn dp_base(ru: &CRule) -> Option<CAtomRef> {
    let bs: &[CLit] = ru.clause.body.as_slice();
    if ru.clause.body.len() < 1i64 { return Option::None; }
    match &bs[0i64] {
        CLit::Atom(a) => {
            if a.neg || a.conds.len() > 0i64 { return Option::None; }
            return Option::Some(CAtomRef { name: a.name, row_ty: a.row_ty, var: a.var });
        }
        CLit::Trav(_t) => { return Option::None; }
        CLit::Cond(_c) => { return Option::None; }
    }
}

struct CAtomRef { name: str, row_ty: str, var: str }

/// The planned core's entry as a single-source query, or None when it is not
/// one (a join, a traversal, a group). `where_retired`: an exact access op
/// answers the `where` (`plan_where_retired`; never for `find`).
pub fn plan_entry_simple(p: &CProgram, where_retired: bool, h: &Writ) -> Option<DSimple> {
    let ru: &CRule = &p.entry;
    match &ru.clause.group { Option::Some(_g) => { return Option::None; } Option::None => { } }
    let base: CAtomRef = match dp_base(ru) { Option::Some(b) => { b } Option::None => { return Option::None; } };
    let bs: &[CLit] = ru.clause.body.as_slice();
    let mut cond: WAny = WAny::null();
    let mut i: i64 = 1i64;
    while i < ru.clause.body.len() {
        match &bs[i] {
            CLit::Cond(c) => {
                match &c.site { CSite::Where => { } CSite::On => { return Option::None; } }
                if !cond.is_null() { return Option::None; }
                cond = c.e;
            }
            CLit::Atom(_a) => { return Option::None; }
            CLit::Trav(_t) => { return Option::None; }
        }
        i = i + 1i64;
    }
    let find: bool = match &ru.env.mode { CMode::Find => { true } CMode::All => { false } CMode::First => { false } };
    if where_retired && !find { cond = WAny::null(); }
    return Option::Some(dp_fold_entry(ru, base.name, base.row_ty, base.var, cond, true, h));
}

/// The planned core's entry as a GROUP (an aggregate over a base atom and any
/// steps), its `having` folded; None when it is not one.
pub fn plan_entry_group(p: &CProgram, h: &Writ) -> Option<DSimple> {
    let ru: &CRule = &p.entry;
    match &ru.clause.group { Option::Some(_g) => { } Option::None => { return Option::None; } }
    let base: CAtomRef = match dp_base(ru) { Option::Some(b) => { b } Option::None => { return Option::None; } };
    let bs: &[CLit] = ru.clause.body.as_slice();
    let mut cond: WAny = WAny::null();
    let mut i: i64 = 1i64;
    while i < ru.clause.body.len() {
        match &bs[i] {
            CLit::Cond(c) => {
                match &c.site {
                    CSite::Where => { if !cond.is_null() { return Option::None; } cond = c.e; }
                    CSite::On => { }
                }
            }
            CLit::Atom(_a) => { }
            CLit::Trav(_t) => { }
        }
        i = i + 1i64;
    }
    return Option::Some(dp_fold_entry(ru, base.name, base.row_ty, base.var, cond, false, h));
}

/// The planned core's entry as a JOIN CHAIN (a base atom and at least one
/// step: a join, an anti join or a traversal), its `where` folded; None when
/// it is not one. The chain itself is read off the rule by the emitter.
pub fn plan_entry_chain(p: &CProgram, h: &Writ) -> Option<DSimple> {
    let ru: &CRule = &p.entry;
    match &ru.clause.group { Option::Some(_g) => { return Option::None; } Option::None => { } }
    let base: CAtomRef = match dp_base(ru) { Option::Some(b) => { b } Option::None => { return Option::None; } };
    let bs: &[CLit] = ru.clause.body.as_slice();
    let mut steps: i64 = 0i64;
    let mut cond: WAny = WAny::null();
    let mut i: i64 = 1i64;
    while i < ru.clause.body.len() {
        match &bs[i] {
            CLit::Cond(c) => {
                match &c.site {
                    CSite::Where => { if !cond.is_null() { return Option::None; } cond = c.e; }
                    CSite::On => { }
                }
            }
            CLit::Atom(_a) => { steps = steps + 1i64; }
            CLit::Trav(_t) => { steps = steps + 1i64; }
        }
        i = i + 1i64;
    }
    if steps == 0i64 { return Option::None; }
    return Option::Some(dp_fold_entry(ru, base.name, base.row_ty, base.var, cond, false, h));
}

/// The arm runs the sort phases.
pub fn dscan_sorts(d: &DScan) -> bool {
    match &d.arm {
        DScanArm::SortSlice => { return true; }
        DScanArm::SortIndexed => { return true; }
        DScanArm::BatchRev => { return false; }
        DScanArm::BatchFwd => { return false; }
        DScanArm::RowPull => { return false; }
        DScanArm::SliceWrap => { return false; }
        DScanArm::Indexed => { return false; }
    }
}

/// The arm pulls an unmaterialised producer (batch or row).
pub fn dscan_pulls(d: &DScan) -> bool {
    match &d.arm {
        DScanArm::BatchRev => { return true; }
        DScanArm::BatchFwd => { return true; }
        DScanArm::RowPull => { return true; }
        DScanArm::SortSlice => { return false; }
        DScanArm::SortIndexed => { return false; }
        DScanArm::SliceWrap => { return false; }
        DScanArm::Indexed => { return false; }
    }
}

/// The arm pulls whole batches (forward or backward).
pub fn dscan_batches(d: &DScan) -> bool {
    match &d.arm {
        DScanArm::BatchRev => { return true; }
        DScanArm::BatchFwd => { return true; }
        DScanArm::RowPull => { return false; }
        DScanArm::SortSlice => { return false; }
        DScanArm::SortIndexed => { return false; }
        DScanArm::SliceWrap => { return false; }
        DScanArm::Indexed => { return false; }
    }
}

/// The arm reads its producer backward.
pub fn dscan_backward(d: &DScan) -> bool {
    match &d.arm {
        DScanArm::BatchRev => { return true; }
        DScanArm::BatchFwd => { return false; }
        DScanArm::RowPull => { return false; }
        DScanArm::SortSlice => { return false; }
        DScanArm::SortIndexed => { return false; }
        DScanArm::SliceWrap => { return false; }
        DScanArm::Indexed => { return false; }
    }
}

pub fn dscan_arm_name(d: &DScan) -> str {
    match &d.arm {
        DScanArm::SortSlice => { return "sort-slice"; }
        DScanArm::SortIndexed => { return "sort-indexed"; }
        DScanArm::BatchRev => { return "batch-rev"; }
        DScanArm::BatchFwd => { return "batch"; }
        DScanArm::RowPull => { return "row-pull"; }
        DScanArm::SliceWrap => { return "slice-wrap"; }
        DScanArm::Indexed => { return "indexed"; }
    }
}

/// `LOGOS_DEEM_DUMP=dplan`: each plan value as it is decided, on stderr.
pub fn dplan_dump_on() -> bool {
    let mut c: String = String::new();
    c.push_str("LOGOS_DEEM_DUMP");
    c.push_u8(0u8);
    unsafe {
        let v: *const u8 = getenv(c.as_ptr());
        if v == 0 as *const u8 { return false; }
        return str_eq(str_from_cstr(v), "dplan");
    }
}

fn dplan_dump_scan(d: &DScan) {
    if !dplan_dump_on() { return; }
    let mut s: String = String::new();
    s.push_str("[dplan] scan "); s.push_str(d.src);
    s.push_str(" arm="); s.push_str(dscan_arm_name(d));
    if d.sort_elided { s.push_str(" sort-elided"); }
    s.push_str("\n");
    unsafe { write(2i32, s.as_ptr(), s.len()); }
}

// ── ADR 0031 R6.7 — DNest: THE JOIN NEST (base + steps), a plan node ─────────
// Built by the planner from a core clause (`plan_nest`) and consumed by every
// nest emitter; it was the emitter's private `JChain`.
// `edge[i]` — TRAVERSAL step (slice D): `src[i]` is the full field-path source
// EXPRESSION (`d.emps`, walker-stamped) rather than a slice-param name; the
// strategy cascade is BYPASSED (always nested-loop — the source depends on
// outer row vars, so no build-once index exists) and `onw[i]` may be 0 (no
// `on` — containment IS the join). `byval[i]` — the step binds a SCALAR
// element (Vec<str> → `let s: str = (e.skills)[j]`) by VALUE (Copy lattice),
// not by reference.
// `jstrat`/`jkey`/`jsel`/`jground` — the PLAN'S DECISION, carried off the node
// (`JS_NONE` = no planner reached it; see analyze_chain).
pub struct DNest {
    pub base_src: str,
    pub base_ty:  str,
    pub base_var: str,
    pub n:    i64,
    pub src:  Vec<str>,
    pub ty:   Vec<str>,
    pub var:  Vec<str>,
    pub anti: Vec<bool>,
    pub onw:  Vec<i64>,     // raw arena words of the per-step on-pred edges (0 = none)
    pub edge:  Vec<bool>,
    pub byval: Vec<bool>,
    pub jstrat: Vec<i32>,
    pub jsel:   Vec<i64>,
    pub jground: Vec<i64>,
}

pub fn dnest_new() -> DNest {
    return DNest { base_src: "", base_ty: "", base_var: "", n: 0i64,
                    src: Vec::<str>::new(), ty: Vec::<str>::new(), var: Vec::<str>::new(),
                    anti: Vec::<bool>::new(), onw: Vec::<i64>::new(), edge: Vec::<bool>::new(),
                    byval: Vec::<bool>::new(), jstrat: Vec::<i32>::new(), jsel: Vec::<i64>::new(),
                    jground: Vec::<i64>::new() };
}

// Append one step (the decision fields as the plan left them on the node).
pub fn dn_push(ch: &mut DNest, src: str, ty: str, var: str, anti: bool, onw: i64, edge: bool,
           byval: bool, jstrat: i32, jsel: i64, jground: i64) {
    ch.src.push(src); ch.ty.push(ty); ch.var.push(var); ch.anti.push(anti); ch.onw.push(onw);
    ch.edge.push(edge); ch.byval.push(byval); ch.jstrat.push(jstrat); ch.jsel.push(jsel);
    ch.jground.push(jground);
    ch.n = ch.n + 1i64;
}

// The JOIN CHAIN of a core clause (ADR 0031 R6.4): the base atom, then each
// step in order — a positive step's `on` is the condition right after it, a
// negated step's lives inside it; a traversal reads its stamped collection
// expression.
pub fn plan_nest(cl: &CClause) -> DNest {
    let mut ch: DNest = dnest_new();
    let bs: &[CLit] = cl.body.as_slice();
    let n: i64 = cl.body.len();
    let mut i: i64 = 0i64;
    while i < n {
        // the `on` a positive step carries: the On condition right after it
        let mut next_on: i64 = 0i64;
        if i + 1i64 < n {
            match &bs[i + 1i64] {
                CLit::Cond(c) => { match &c.site { CSite::On => { next_on = c.e.raw(); } CSite::Where => { } } }
                CLit::Atom(_a) => { }
                CLit::Trav(_t) => { }
            }
        }
        match &bs[i] {
            CLit::Atom(a) => {
                if i == 0i64 {
                    ch.base_src = a.name; ch.base_ty = a.row_ty; ch.base_var = a.var;
                } else {
                    let onw: i64 = if a.neg { if a.conds.len() > 0i64 { a.conds.get(0i64).raw() } else { 0i64 } } else { next_on };
                    dn_push(&mut ch, a.name, a.row_ty, a.var, a.neg, onw, false, false,
                            a.strat, a.jsel as i64, a.ground);
                }
            }
            CLit::Trav(t) => {
                let eon: i64 = if t.neg { if t.conds.len() > 0i64 { t.conds.get(0i64).raw() } else { 0i64 } } else { next_on };
                dn_push(&mut ch, t.name, t.row_ty, t.var, t.neg, eon, true,
                        el_ret_class(t.row_ty) >= 0i32, 0i32, -1i64, 0i64);
            }
            CLit::Cond(_c) => { }
        }
        i = i + 1i64;
    }
    return ch;
}

// ── ADR 0031 R7.1 — THE FIXPOINT OF ONE SCC, AS A PLAN ─────────────────────
//
// A recursive SCC is evaluated by a semi-naïve driver (from scratch, `_scc<c>`,
// or across epochs, `_scc<c>_i`) and retracted by DRed (`_od` seeds from every
// body, `_odp` propagates through the recursive ones). What each driver runs is
// a property of the program and the condensation, not of the emitter: per
// member, its rules; which of them read no member (the seeds); and, for every
// rule that does, one VARIANT per in-SCC occurrence, which reads that
// occurrence's DELTA and every other occurrence's TOTAL. The translator below
// decides it; the drivers' emitters spell it.

/// One rule run: the rule, and the source each chain slot reads instead of its
/// own (slot 0 the base; "" = its own) — the semi-naïve delta rename.
pub struct DRun {
    pub rule: i64,
    pub ovr: Vec<str>,
    /// Per chain slot: the slot's source does not change while the SCC's loop
    /// runs — a parameter, or a rel outside the SCC (ADR 0031 R7.2: its index
    /// may be built once, before the loop). A traversal's source depends on its
    /// base row, so it never is.
    pub inv: Vec<bool>,
    /// The variant's own clause when it is not the rule's: the DELTA-FIRST
    /// reordering (R7.3), with its own join decisions. None = the rule as written.
    pub clause: Option<CClause>,
}

pub struct DSccMember {
    pub rel: i64,
    /// Every rule, at its canonical (total) sources.
    pub all: Vec<i64>,
    /// The rules that read no member of the SCC.
    pub seeds: Vec<i64>,
    /// Each recursive rule × each of its in-SCC occurrences.
    pub variants: Vec<DRun>,
}

pub struct DScc { pub scc: i64, pub members: Vec<DSccMember> }

/// Rule `ru`'s occurrences of SCC `c`'s rels, in chain order: (slot − 1, rel)
/// — slot 0 is the base, a traversal holds a slot and is never an occurrence.
fn scc_occurrences(ru: &CRule, scc: &RelScc, c: i64, pos: &mut Vec<i64>, rel: &mut Vec<i64>) {
    let bs: &[CLit] = ru.clause.body.as_slice();
    let mut slot: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < ru.clause.body.len() {
        match &bs[i] {
            CLit::Atom(a) => {
                if a.reg >= 0i64 && scc.comp[a.reg] == c { pos.push(slot - 1i64); rel.push(a.reg); }
                slot = slot + 1i64;
            }
            CLit::Trav(_t) => { slot = slot + 1i64; }
            CLit::Cond(_x) => { }
        }
        i = i + 1i64;
    }
}

// Per chain slot of a rule: does the slot's source stay fixed while SCC `c`'s
// loop runs?
fn slot_invariance(ru: &CRule, scc: &RelScc, c: i64) -> Vec<bool> {
    return clause_slot_invariance(&ru.clause, scc, c);
}

fn clause_slot_invariance(cl: &CClause, scc: &RelScc, c: i64) -> Vec<bool> {
    let mut v: Vec<bool> = Vec::<bool>::new();
    let bs: &[CLit] = cl.body.as_slice();
    let mut i: i64 = 0i64;
    while i < cl.body.len() {
        match &bs[i] {
            CLit::Atom(a) => { v.push(a.reg < 0i64 || scc.comp[a.reg] != c); }
            CLit::Trav(_t) => { v.push(false); }
            CLit::Cond(_x) => { }
        }
        i = i + 1i64;
    }
    return v;
}

/// The plan of SCC `c` over the planned core. Members in declaration order
/// (registry order); a member's rules in declaration order.
pub fn plan_scc(prm: &MacroParams, scc: &RelScc, c: i64, h: &Writ) -> DScc {
    let mut out: DScc = DScc { scc: c, members: Vec::<DSccMember>::new() };
    let rels: &[CRel] = prm.plan_core.rels.as_slice();
    let mut r: i64 = 0i64;
    while r < prm.rel_n {
        if scc.comp[r] == c && r < prm.plan_core.rels.len() {
            let mut m: DSccMember = DSccMember { rel: r, all: Vec::<i64>::new(), seeds: Vec::<i64>::new(),
                                                 variants: Vec::<DRun>::new() };
            let rules: &[CRule] = rels[r].rules.as_slice();
            let mut b: i64 = 0i64;
            while b < rels[r].rules.len() {
                m.all.push(b);
                let mut pos: Vec<i64> = Vec::<i64>::new();
                let mut orel: Vec<i64> = Vec::<i64>::new();
                scc_occurrences(&rules[b], scc, c, &mut pos, &mut orel);
                if pos.len() == 0i64 { m.seeds.push(b); }
                let mut v: i64 = 0i64;
                while v < pos.len() {
                    let mut ovr: Vec<str> = Vec::<str>::new();
                    let mut w: i64 = 0i64;
                    while w < pos.len() {
                        let nm_w: str = if w == v { string_as_str(&prm.rel_dsrcs[orel[w]]) }
                                        else      { string_as_str(&prm.rel_srcs[orel[w]]) };
                        let sl: i64 = pos[w] + 1i64;
                        while ovr.len() <= sl { ovr.push(""); }
                        ovr[sl] = nm_w;
                        w = w + 1i64;
                    }
                    // R7.3 — DELTA FIRST: a variant whose delta occurrence is a STEP
                    // reads the whole of every source before it each round; driving
                    // from the delta reads the delta and probes the rest (whose
                    // loop-invariant indexes R7.2 builds once). A rel body is a SET,
                    // so the order moves no answer. Aggregate (min/max) members keep
                    // their written order.
                    let mut reordered: Option<CClause> = Option::None;
                    if pos[v] >= 0i64 && !prm.rel_is_agg[r] && !env_on("LOGOS_DEEM_NO_DELTA_FIRST") {
                        reordered = delta_first(prm, &rules[b].clause, pos[v] + 1i64, h);
                    }
                    if reordered.is_some() {
                        let rc: CClause = reordered.unwrap();
                        let mut ovr2: Vec<str> = Vec::<str>::new();
                        let rinv: Vec<bool> = clause_slot_invariance(&rc, scc, c);
                        let rbs: &[CLit] = rc.body.as_slice();
                        let mut sl2: i64 = 0i64;
                        let mut q: i64 = 0i64;
                        while q < rc.body.len() {
                            match &rbs[q] {
                                CLit::Atom(a) => {
                                    let mut nm2: str = "";
                                    if a.reg >= 0i64 && scc.comp[a.reg] == c {
                                        nm2 = if sl2 == 0i64 { string_as_str(&prm.rel_dsrcs[a.reg]) } else { string_as_str(&prm.rel_srcs[a.reg]) };
                                    }
                                    ovr2.push(nm2);
                                    sl2 = sl2 + 1i64;
                                }
                                CLit::Trav(_t) => { ovr2.push(""); sl2 = sl2 + 1i64; }
                                CLit::Cond(_x) => { }
                            }
                            q = q + 1i64;
                        }
                        m.variants.push(DRun { rule: b, ovr: ovr2, inv: rinv, clause: Option::Some(rc) });
                    } else {
                        m.variants.push(DRun { rule: b, ovr: ovr, inv: slot_invariance(&rules[b], scc, c), clause: Option::None });
                    }
                    v = v + 1i64;
                }
                b = b + 1i64;
            }
            out.members.push(m);
        }
        r = r + 1i64;
    }
    return out;
}

// ── THE JOIN-STEP DECISION ON A CLAUSE (moved from the walker, ADR 0031 R7.3:
// the planner decides it for the program's rules and for the fixpoint's
// reordered variants alike) ────────────────────────────────────────────────

/// Decide every classic step of ONE clause and record the decision on its atoms.
///
/// The type dict is `typing::type_clause` over the core's atoms, resolved from
/// the declarations (ADR 0031 R4.0) — the function the emitter types with.
///
/// Traversal steps are nested loops by construction. They also STOP the walk,
/// and the dict stops at the first one: the decisions below were made, and
/// measured, without the traversal's element type in the dict, and a flat
/// column name a later traversal's struct also declares would type an earlier
/// key differently. Later steps are left `JS_NONE`; `plan_insert_drains` reads
/// that as "not proven read-once" and drains the step's source on
/// `MG_UNDECIDED`.
pub fn plan_decide_clause(prm: &MacroParams, view: &OView, cl: &mut CClause, h: &Writ, full: bool) {
    let t: ElTypes = type_clause(view, prm, cl, !full);
    let n: i64 = cl.body.len();
    let mut i: i64 = 1i64;
    while i < n {
        // the `on` a positive step carries: the On condition right after it
        let mut next_on: WAny = WAny::null();
        if i + 1i64 < n {
            match &cl.body[i + 1i64] {
                CLit::Cond(c) => { match &c.site { CSite::On => { next_on = c.e; } CSite::Where => { } } }
                CLit::Atom(_a) => { }
                CLit::Trav(_t) => { }
            }
        }
        match &mut cl.body[i] {
            CLit::Atom(a) => {
              if a.strat == JS_NONE() {
                let on: WAny = if a.neg { if a.conds.len() > 0i64 { a.conds.get(0i64) } else { WAny::null() } } else { next_on };
                let ss: StepSel = decide_join_step(WRef::<SExpr>::from_any(on), a.var, &t, h);
                a.strat = ss.strat;
                a.jsel  = ss.sel as i32;
                a.ground = jg_pack(&ss.g);
                // ⚠ THE TYPE ON THE TRACE IS THE ONE THE INDEX IS KEYED IN. It read
                // `el_class_repr(ss.key_ty)` — the class's representative — so a `u64`
                // key was announced as `hash join on i64` while the emitted map is
                // `HashMap<u64, …>`. A justification that names a type the code does not
                // use is not a justification of that code.
                trace_step(a.var, &ss);
              }
            }
            CLit::Trav(_t) => { if !full { return; } }   // pass 1: every step after it stays undecided
            CLit::Cond(_c) => { }
        }
        i = i + 1i64;
    }
}

// ── R7.3 — DELTA FIRST ──────────────────────────────────────────────────────

fn lit_copy(l: &CLit) -> CLit {
    match l {
        CLit::Atom(a) => {
            let mut cs: Vec<WAny> = Vec::<WAny>::new();
            let mut k: i64 = 0i64;
            while k < a.conds.len() { cs.push(a.conds.get(k)); k = k + 1i64; }
            let src: CSrc = match &a.src { CSrc::Rel(x) => CSrc::Rel(*x), CSrc::Param(n) => CSrc::Param(*n), CSrc::Unit => CSrc::Unit };
            return CLit::Atom(CAtom { src: src, reg: a.reg, name: a.name, var: a.var, row_ty: a.row_ty, neg: a.neg,
                                      conds: cs, strat: 0i32, jsel: -1i32, ground: 0i64 });
        }
        CLit::Trav(t) => {
            let mut cs2: Vec<WAny> = Vec::<WAny>::new();
            let mut k2: i64 = 0i64;
            while k2 < t.conds.len() { cs2.push(t.conds.get(k2)); k2 = k2 + 1i64; }
            let mut path: Vec<str> = Vec::<str>::new();
            let mut k3: i64 = 0i64;
            while k3 < t.path.len() { path.push(t.path.get(k3)); k3 = k3 + 1i64; }
            return CLit::Trav(CTrav { name: t.name, base: t.base, path: path, var: t.var, row_ty: t.row_ty, neg: t.neg, conds: cs2 });
        }
        CLit::Cond(c) => {
            let site: CSite = match &c.site { CSite::Where => CSite::Where, CSite::On => CSite::On };
            return CLit::Cond(CCond { e: c.e, site: site });
        }
    }
}

fn and_w(h: &Writ, acc: WAny, e: WAny) -> WAny {
    if acc.is_null() { return e; }
    let n: SBin = h.make::<SBin>();
    n.op = OP_AND();
    n.lhs = WRef::<SExpr>::from_any(acc);
    n.rhs = WRef::<SExpr>::from_any(e);
    return n.as_ref();
}

/// The clause with its source literal at chain slot `dslot` moved first and
/// every other source literal in its written order. Each step `on` attaches to
/// the last source (in the new order) whose row it reads — several landing on
/// one step are ANDed — and one that reads only the new base joins the WHERE.
/// Nothing bound before a literal is bound after it (only the moved atom went
/// earlier), so every traversal base and negation scope is still satisfied.
/// The steps' join strategies are decided anew, as the planner decides a rule's.
pub fn delta_first(prm: &MacroParams, cl: &CClause, dslot: i64, h: &Writ) -> Option<CClause> {
    let bs: &[CLit] = cl.body.as_slice();
    let mut srcs: Vec<i64> = Vec::<i64>::new();      // body indices of the source literals
    let mut ons: Vec<WAny> = Vec::<WAny>::new();
    let mut wh: WAny = WAny::null();
    let mut i: i64 = 0i64;
    while i < cl.body.len() {
        match &bs[i] {
            CLit::Atom(_a) => { srcs.push(i); }
            CLit::Trav(_t) => { srcs.push(i); }
            CLit::Cond(c) => { match &c.site { CSite::On => { ons.push(c.e); } CSite::Where => { wh = c.e; } } }
        }
        i = i + 1i64;
    }
    let mut order: Vec<i64> = Vec::<i64>::new();
    order.push(srcs[dslot]);
    let mut k: i64 = 0i64;
    while k < srcs.len() { if k != dslot { order.push(srcs[k]); } k = k + 1i64; }
    // the var each new position binds ("" for a negation: it binds nothing)
    let mut vars: Vec<str> = Vec::<str>::new();
    let mut p: i64 = 0i64;
    while p < order.len() {
        match &bs[order[p]] {
            CLit::Atom(a) => { vars.push(if a.neg { "" } else { a.var }); }
            CLit::Trav(t) => { vars.push(if t.neg { "" } else { t.var }); }
            CLit::Cond(_c) => { vars.push(""); }
        }
        p = p + 1i64;
    }
    let mut at: Vec<WAny> = Vec::<WAny>::new();
    let mut z: i64 = 0i64;
    while z < order.len() { at.push(WAny::null()); z = z + 1i64; }
    let mut base_conds: WAny = WAny::null();
    let mut q: i64 = 0i64;
    while q < ons.len() {
        let e: SExpr = ons.get(q).view::<SExpr>();
        let mut last: i64 = 0i64;
        let mut v: i64 = 0i64;
        while v < vars.len() {
            if vars.get(v).len() > 0i64 && (refs_mask(e, vars.get(v)) & 1i32) != 0i32 { last = v; }
            v = v + 1i64;
        }
        if last == 0i64 { base_conds = and_w(h, base_conds, ons.get(q)); }
        else { at[last] = and_w(h, at[last], ons.get(q)); }
        q = q + 1i64;
    }
    let mut body: Vec<CLit> = Vec::<CLit>::new();
    let mut n: i64 = 0i64;
    while n < order.len() {
        body.push(lit_copy(&bs[order[n]]));
        // ADMISSIBILITY: every positive JOIN step must keep a condition linking
        // it to the rows before it. A step left with none would join on `true`
        // — a nested loop over its whole source per delta row, worse than the
        // written order's single scan (the link ran through a traversal or a
        // later source). Such a variant keeps its written order.
        if at[n].is_null() && n > 0i64 {
            match &bs[order[n]] { CLit::Atom(a) => { if !a.neg { return Option::None; } } CLit::Trav(_t) => { } CLit::Cond(_c) => { } }
        }
        if !at[n].is_null() { body.push(CLit::Cond(CCond { e: at[n], site: CSite::On })); }
        n = n + 1i64;
    }
    let mut w2: WAny = wh;
    if !base_conds.is_null() { w2 = and_w(h, w2, base_conds); }
    if !w2.is_null() { body.push(CLit::Cond(CCond { e: w2, site: CSite::Where })); }
    let mut out: CClause = CClause { head: cl.head, body: body, group: Option::None, gpath: Option::None };
    let view: OView = oview_module_ast();
    plan_decide_clause(prm, &view, &mut out, h, true);
    return Option::Some(out);
}

/// The fixpoint plan of every SCC, indexed by SCC id (a non-recursive SCC's is
/// planned too; its drivers never run).
pub fn plan_sccs(prm: &MacroParams, scc: &RelScc, h: &Writ) -> Vec<DScc> {
    let mut v: Vec<DScc> = Vec::<DScc>::new();
    let mut c: i64 = 0i64;
    while c < scc.nscc { v.push(plan_scc(prm, scc, c, h)); c = c + 1i64; }
    return v;
}

/// A measurement switch: set (to anything) in the compiler's environment.
pub fn env_on(name: str) -> bool {
    let mut n: String = String::new();
    n.push_str(name);
    n.push_u8(0u8);
    return unsafe { getenv(n.as_ptr()) } != 0 as *const u8;
}

// ── ADR 0031 R7.4b — DOES THE QUERY GET A HANDLE, AND WHICH ONE ────────────
//
// The incremental entry's admission, its retraction surface and the DRed
// driver were decided INSIDE the group emitter, from values only it had
// computed. Every one of them is a plan fact (R4 typed the aggregates, the key
// and the result on the core), so the planner decides them here — with their
// grounds on the trace, once — and the emitter spells the `DIncr` it is handed.

/// The incremental handle a group entry gets: none (`admit` false), and if
/// one, whether it retracts and whether it is DRed-maintained.
pub struct DIncr {
    pub admit:   bool,
    pub retract: bool,
    pub dred:    bool,
}

pub fn dincr_none() -> DIncr { return DIncr { admit: false, retract: false, dred: false }; }

/// Decide the incremental handle of the group entry `ds` (form Scan). `qn` is
/// the query's bare name (the trace subject).
pub fn plan_incremental(ds: &DSimple, prm: &MacroParams, qn: str, h: &Writ) -> DIncr {
    let ru: &CRule = &prm.plan_core.entry;
    let cl: &CClause = &ru.clause;
    let g: &CGroup = match &cl.group { Option::Some(x) => { x } Option::None => { return dincr_none(); } };
    let ch: DNest = plan_nest(cl);
    let view: OView = oview_module_ast();
    let mut ty: ElTypes = el_types_clone(&prm.plan_tys.as_slice()[prm.plan_tys.len() - 1i64]);
    // A rel-backed entry's input row type, stamped by type only (the batch
    // emitter's P3b stamping, which the admission's row-type test reads).
    if prm.rel_find_src(ch.base_src) >= 0i64 {
        let mut pj: i64 = 0i64;
        while pj < prm.n {
            if prm.is_slice[pj] { stamp_type_fields(&view, &mut ty, prm.tys[pj]); }
            pj = pj + 1i64;
        }
    }
    let key_opt: SExpr = simplify_sexpr(g.key.view::<SExpr>(), h).any().view::<SExpr>();
    let mut key_tys: String = String::new();
    key_tys.push_str(infer_emit_ty(key_opt, &ty));
    ty.set_ty_named("key", key_tys.as_str());
    let mut gt: GroupTy = group_ty_new();
    if !type_aggs(&view, &g.aggs, &mut ty, h, &mut gt) { return dincr_none(); }
    let proj_opt: SExpr = simplify_sexpr(ds.sel.view::<SExpr>(), h).any().view::<SExpr>();
    let et: EntryTy = entry_result_ty(proj_opt, &ty, ru.env.result_ty, ru.env.result_ty.len() > 0i64);
    let tres: i32 = if et.tuple { 1i32 } else { 0i32 };
    let rel_m0: i64 = prm.rel_find_src(ch.base_src);
    if !incr_admit(&ch, &ty, &g.aggs, &gt.uda, &gt.act, key_tys.as_str(), et.elem.as_str(), tres,
                   !ds.having.is_null(), proj_opt, ds.having, !ds.pred.is_null(),
                   !ds.sort_key.is_null(), ds.has_limit, ds.distinct, prm,
                   retract_ok(&g.aggs, &gt.acc) && rel_m0 < 0i64, qn) {
        return dincr_none();
    }
    let retr: bool = incr_retract_eligible(&g.aggs, &gt.acc, rel_m0 >= 0i64, qn);
    let dred: bool = rel_m0 >= 0i64 && !retr && retract_ok(&g.aggs, &gt.acc) && !aggs_any_minmax(&g.aggs);
    if rel_m0 >= 0i64 && !retr {
        if dred {
            dred_trace(qn, "EMITTED", DR_EMIT());
        } else if !retract_ok(&g.aggs, &gt.acc) {
            dred_trace(qn, "declined", DR_FLOAT());
        } else {
            dred_trace(qn, "declined", DR_MINMAX());
        }
    }
    return DIncr { admit: true, retract: retr, dred: dred };
}

// ══ IS THIS QUERY'S SHAPE EXPRESSIBLE ON A PERSISTED HANDLE? ════════════════
//
// DERIVED from the plan, never listed by a caller — which is what keeps the
// population of incremental queries a property of the ARTIFACT rather than of
// somebody's list. Every clause below states WHICH fact about a handle it rests
// on, because a refusal whose ground is "not supported yet" is the one that
// never gets revisited.
//
// ⚠ THE FLOOR IS THE DYNAMIC ENGINE'S OWN, AND THAT IS A CHOICE WITH A PAYOFF.
// `IncrJoin` admits exactly `RDistinct?( RProj( RFilter?( RAggr( RScan ) ) ) )`
// — one bare-scan source, `having` above the group, no `order by` / `limit` /
// `edge` / `fix` / `rel`. The static `emit_aggregate` is strictly richer (it
// takes a join chain and a pre-group `where`), so restricting P1 to the same
// floor costs nothing that is not already deferred and buys a DIFFERENTIAL
// against a genuinely separate implementation for every fixture — an asset that
// stops existing when the interpreter is removed.
// ⚠ EVERY DECISION IS TRACED WITH ITS GROUND, ON THE SAME CHANNEL AND IN THE
// SAME SHAPE AS THE JOIN-ORDER DECISION (`LOGOS_TRACE_PLAN`, `plan_trace`). A
// query that does NOT gain the incremental form gains it silently otherwise, and
// "why did my query not get a handle" is then answerable only by reading this
// function — which is the class of unobservable derived decision this compiler
// has already paid for once at the join-order axis.
pub fn incr_admit(ch: &DNest, ty: &ElTypes, aggs: &Vec<CAgg>,
              uda: &Vec<bool>, act: &Vec<str>, key_ty: str,
              result_ty: str, tres: i32, has_having: bool, proj_e: SExpr,
              having: WAny, has_where: bool, has_sort: bool, has_limit: bool,
              distinct: bool, prm: &MacroParams, retr: bool, qn: str) -> bool {
    let acount: i64 = aggs.len();
    // ── A DECLARED `rel` IS A SET, AND A HANDLE OVER ONE ANSWERS WRONG ──────
    //
    // ⚠⚠ THIS CLAUSE CLOSES A SILENT WRONG ANSWER, NOT A MISSING FEATURE, AND
    // THE FLOOR THIS FUNCTION'S OWN HEADER STATES ALREADY EXCLUDED `rel` —
    // "one bare-scan source … no `order by` / `limit` / `edge` / `fix` / `rel`"
    // — it was written down and never mechanized, so it got re-made. Until now
    // NO clause here asked whether a source was a rel, and every consequence
    // below was MEASURED on aaf16585 against the query's own batch fn:
    //
    //   • RECURSIVE rel (transitive closure), edges {(1,2),(2,3)} split into two
    //     one-edge epochs: batch says group 1 has count 2 (it derives (1,3)),
    //     the handle says 1. The closure of a union is not the union of the
    //     closures.
    //   • NON-RECURSIVE rel, the SAME edge presented in two epochs: batch says
    //     1 (the rel dedups), the handle says 2. So the hole is EVERY declared
    //     rel, not only a recursive one — dedup alone is enough to break it.
    //   • one `_apply(h, 0, +2, …)`: a Z-set row of weight 2 is two copies, but
    //     the rel is a SET, so the closure is unchanged and batch says 1 while
    //     the handle says 2.
    //   • a retraction through recursion: batch over the survivor has NO group 1
    //     at all, the handle reports group 1 with count 1 — and returns `Ok`.
    //
    // THE MECHANISM, because a ground that does not name one is the ground that
    // never gets revisited: `emit_incremental` splices the rel PRELUDE verbatim
    // at the top of `<q>_apply` (the `prelude_frag` call below), exactly as the
    // batch emitters do. That prelude declares `let mut __rel_<m> = Vec::new();`
    // and runs the whole SCC fixpoint — so every call re-materializes the rel
    // FROM AN EMPTY TOTAL over THE DELTA ALONE, then folds each resulting row at
    // the delta's weight. Both properties a rel has are properties of the
    // ACCUMULATED input: set-semantics dedup (`rel_push_frag`'s shadow-set gate)
    // and the recursive closure. The handle stores neither the rel's rows nor
    // the input they were derived from, so neither survives the epoch boundary.
    //
    // THE SUCCESSOR IS NAMED, NOT VAGUE. Insert-only maintenance means seeding
    // the semi-naive loop with the EDB delta instead of the whole relation, and
    // it needs: the per-member total `__tot_<m>` and shadow set `__rs_<m>`
    // promoted from fn locals onto the handle; the accumulated EDB kept as
    // handle state in Z-set normal form; a round-0 variant in `dplan::plan_scc`
    // binding the EDB occurrence to the delta and the in-SCC occurrence to the
    // existing total; and a SECOND prelude threaded through `walk_query` →
    // `emit_incremental`, which today receives the prelude only as opaque text
    // and never sees `RelScc` at all. RETRACTION through recursion is a further
    // slice again — a fact may support ITSELF through a cycle, so "subtract what
    // it added" is wrong; the answer is DRed (over-delete, compact, re-derive),
    // which the dynamic engine already implements at `incr_rec.logos:776-910`
    // and which degrades to full recompute for a lattice member.
    //
    // ⚠ WEIGHTS MAY NEVER FLOW NAIVELY INTO AN SCC, and that is why the fix is
    // not "carry `__wd` through". Counting derivations through a cycle DIVERGES:
    // `path(a,b) :- path(a,c), edge(c,b)` has unboundedly many derivations of
    // one fact, and set semantics is exactly what makes the existing fixpoint
    // terminate. Any successor collapses the inbound weight to a 0→positive
    // PRESENCE crossing and folds each derived row at +1, never at `__wd`.
    //
    // ⚠ NATIVE rels are NOT refused, and that is MEASURED rather than assumed.
    // A native rel (`<p>: &Writ`, materialized by `writ_graph_edges`) has no
    // dedup and no recursion: it is a pure function of one caller-owned
    // container, so folding each epoch's rows at their weight IS the multiset
    // union a bare scan means. Measured on aaf16585: one epoch over a document
    // equals the batch over that document. The accumulated input of several
    // `&Writ`s is not expressible as a batch call at all, so there is no
    // cross-epoch spec here to violate in the way a derived rel violates one.
    // ── P3b: THE REFUSAL BECOMES AN ANSWER, FOR ONE SHAPE ──────────────────
    //
    // What replaced the blanket refusal is NOT "rels are fine now". The handle
    // now OWNS the accumulated input and the rel's fixpoint TOTAL, and
    // `<q>_epoch` extends that total by re-entering a cross-epoch semi-naïve
    // driver rather than re-running the fixpoint from an empty one. That is the
    // whole of the change, and everything the old ground said about a shape the
    // handle does NOT own is still true and still refused below, with the
    // specific antecedent named.
    //
    // ⚠ A REL IN JOIN POSITION IS STILL REFUSED, AND THE REFUSAL IS NOW PINNED.
    // The previous round left this loop pinned by NOTHING — both matrix rel
    // queries put the rel in BASE position, so deleting the loop left every gate
    // green. `no_rel_join` in `wql_incr_eligibility_matrix.logos` is a rel in
    // JOIN position and the gate asserts its ground, so this clause now bites.
    // It is not a formality: the handle's join arm stores the joined side as a
    // weighted Z-set (`__s1`/`__s1w`), and a rel side has no weight to store —
    // its rows come out of a fixpoint that has already deduped them.
    let mut rsi: i64 = 0i64;
    while rsi < ch.n {
        if incr_src_is_derived_rel(prm, ch.src[rsi]) {
            return incr_decline_r(qn, IR_JOIN_SRC_REL());
        }
        rsi = rsi + 1i64;
    }
    let rel_m: i64 = prm.rel_find_src(ch.base_src);
    if rel_m >= 0i64 {
        // A rel in BASE position AND a join step: the epoch would have to
        // maintain the fixpoint total AND a weighted Z-set side in one call.
        if ch.n > 0i64 {
            return incr_decline_r(qn, IR_BASE_REL_JOINS());
        }
        // THE SHAPE, DERIVED ONCE, IN `stamp_rel_incr_shape`. The ground travels
        // with the flag — see the note on `rel_incr_why`. ⚠ This is also what
        // keeps the admission and the ARTIFACT in step: `emit_rel_fns` emits the
        // `_i` driver under the same flag, so an admission that disagreed would
        // call a function that does not exist.
        if !prm.rel_incr_ok[rel_m] { return incr_decline_dyn(qn, IR_REL_NOT_INCR(), prm.rel_incr_why[rel_m]); }
        // ── THE ACCUMULATED INPUT MUST BE OWNABLE AND IDENTIFIABLE ──────────
        // The handle keeps the rel's EDB — every fact ever applied — because the
        // fixpoint is a function of the ACCUMULATED input and nothing else. That
        // makes the input's row type subject to exactly the question P3 asks of a
        // joined side: `str` is a borrow of caller bytes, and `f64` has no `==`
        // that is identity for the presence gate to search on.
        //
        // ⚠ AND THERE MUST BE EXACTLY ONE OF THEM. `<q>_epoch` keeps the query's
        // parameter list VERBATIM, so with two slice params a caller would pass
        // both on every call and the emitter could not tell which one is the
        // delta — the same ambiguity the join arm answers with a source TAG, and
        // a rel-backed query has no `<q>_apply` to carry one. Scalar params ride
        // through untouched (they are not input to accumulate).
        let mut nsl: i64 = 0i64;
        let mut spi: i64 = -1i64;
        let mut pk: i64 = 0i64;
        while pk < prm.n {
            if prm.is_slice[pk] { nsl = nsl + 1i64; spi = pk; }
            pk = pk + 1i64;
        }
        if nsl != 1i64 {
            return incr_decline_r(qn, IR_REL_SLICE_COUNT());
        }
        if !incr_row_ty_ok(ty, prm.tys[spi]) {
            return incr_decline_r(qn, IR_REL_ROW_TY());
        }
        // The rel's own ROW type is stored too (the fixpoint total). Its columns
        // are the rel's DECLARED ones, so the question is asked of the column
        // list rather than of a stamped struct — a rel row is a tuple and has no
        // binding table to walk.
        let coff: i64 = prm.rel_coff[rel_m];
        let mut ci2: i64 = 0i64;
        while ci2 < prm.rel_ccnt[rel_m] {
            let ct: str = prm.relc_ty[coff + ci2];
            if !incr_ty_ok(ct) || el_class_lookup(ct) == EL_TY_FLT() || el_class_lookup(ct) < 0i32 {
                return incr_decline_r(qn, IR_REL_COL_TY());
            }
            ci2 = ci2 + 1i64;
        }
    }
    // ── THE JOIN, P3: ONE STEP IS ADMITTED AND EVERY OTHER SHAPE IS NAMED ────
    // The old ground was "COMBINING per-source deltas is the DBSP product rule
    // and needs the joined side's state on the handle". That is still exactly
    // right — so the handle now KEEPS the joined side's state, and the refusal
    // retires for the shape where keeping it is derivable. What is left is a
    // list, and every entry names the piece that is missing rather than saying
    // "not supported yet".
    //
    // ⚠ TWO OR MORE STEPS IS THE ROTATION PROBLEM AND IT IS NOT THE FOLD'S. A
    // delta at chain slot s makes s the OUTERMOST source, and re-rooting a nest
    // changes four things at once — `chain_reorder`'s own header enumerates them
    // — of which the emitter here can derive only the first: the outer source,
    // WHICH HALF of each equi-term is the build key (`equi_term_sides` splits by
    // the step's NEW row var, so exchanging the vars exchanges build and probe),
    // therefore the STRATEGY (a direction may have no usable equi-key at all),
    // and the PLACEMENT of every floating predicate. `chain_reorder` does all
    // four but consumes a `JoinOrder` candidate table produced by the planner's
    // `decide_join_orders`, and this emitter never runs it. With exactly ONE
    // step there is ONE `on` predicate and NO placement question, and the nest
    // is two loops in either direction — which is why the line falls here and
    // not at "arbitrary chain".
    if ch.n > 1i64 { return incr_decline_r(qn, IR_CHAIN_LONG()); }
    if ch.n == 1i64 {
        // A delta must name its SOURCE, and the tag lives in `<q>_apply`'s
        // signature — which exists only on the RETRACTING surface. The two axes
        // are independent (the tag says WHICH relation, the weight says WHICH
        // DIRECTION) and only their combination is unbuilt: an insert-only join
        // would need a THIRD emitted signature, `<q>_apply(&mut h, __src, …)`
        // with no weight. Named, not hidden — and it is reached only by a query
        // whose aggregate list already lost retraction to D4.
        if !retr { return incr_decline_r(qn, IR_JOIN_INSERT_ONLY()); }
        // An ANTI step is a MATCHCOUNT, not a product: a base row's membership
        // in the output flips when its match count crosses 0, so a delta on the
        // anti side must EMIT A RETRACTION of a row that itself did not change.
        // That is a second state machine (the dynamic engine spends
        // `incr.logos:1149-1251` on it) and it is not this fold.
        if ch.anti[0] { return incr_decline_r(qn, IR_JOIN_ANTI()); }
        // A TRAVERSAL step's source is a field-path expression re-derived per
        // BOUND ROW (`a.children`), so there is no standalone relation for the
        // handle to own and no tag that could name one.
        if ch.edge[0] { return incr_decline_r(qn, IR_JOIN_EDGE()); }
        // A BY-VALUE binding is the streamed/iterator shape's; the stored side is
        // a `Vec` this emitter indexes by reference.
        if ch.byval[0] { return incr_decline_r(qn, IR_JOIN_BYVAL()); }
        // A STREAMED source yields its rows ONCE. The handle would have to be
        // that single reader and would then own a relation the caller can no
        // longer re-present as a delta.
        // ⚠ A SURVIVOR OF ADR 0025 S2f/S2g. This is the incremental fold's
        // DECLINE — a statement about who may READ the source, not about how the
        // scan is spelled. S1's gate correction applies verbatim: the shape
        // readings became `rel_src_unmaterialized` (the plan's node); this one
        // is a decision and stays on the decision's boolean.
        if prm.rel_src_streams(ch.base_src) || prm.rel_src_streams(ch.src[0]) {
            return incr_decline_r(qn, IR_JOIN_STREAMS());
        }
        // A SELF-JOIN puts ONE relation in TWO chain positions, so one tag would
        // have to feed both — and integrating the delta once while folding it
        // against a state that must also already contain it is exactly the
        // same-epoch double count this slice's fixture exists to catch. The
        // dynamic engine refuses it too (`incr.logos:1780`).
        if str_eq(ch.base_src, ch.src[0]) {
            return incr_decline_r(qn, IR_SELF_JOIN());
        }
        // THE HANDLE OWNS ITS STORED SIDES, ROW BY ROW AND FIELD BY FIELD.
        // ⚠⚠ THIS CLAUSE IS NOT A FORMALITY AND THE COMPILER DOES NOT ENFORCE
        // IT. MEASURED (2026-08-07, prebuilt logosc): a row struct carrying a
        // `str` field copies into a handle-owned `Vec<Row>` and COMPILES CLEAN
        // — the handle then holds a view of source bytes it does not own, which
        // silently destroys the capability this emitter's header states in
        // capitals ("THE HANDLE BORROWS NOTHING … the caller may grow, move or
        // drop the source between epochs"). `incr_ty_ok` was already asked of
        // the group key, of every accumulator column and of every projected
        // component — and never of the ROW, because until now no row was stored.
        if !incr_row_ty_ok(ty, ch.base_ty) || !incr_row_ty_ok(ty, ch.ty[0]) {
            return incr_decline_r(qn, IR_JOIN_ROW_TY());
        }
    }
    // A PRE-GROUP `where` is admissible in principle and is refused here for the
    // same reason the dynamic engine refuses it: it has never been folded through
    // the incremental path, so admitting it would be an untested arm. `having`
    // sits ABOVE the group and IS admitted — it is re-evaluated per snapshot.
    if has_where { return incr_decline_r(qn, IR_PRE_WHERE()); }
    // `order by` / `limit` / `distinct` all act on the SNAPSHOT rather than on
    // the fold, so they are cheap to add later and are excluded now only to keep
    // the emitted surface to what a fixture in this slice actually asserts.
    if has_sort || has_limit || distinct { return incr_decline_r(qn, IR_MODIFIERS()); }
    // A generic `deem` would need the handle TYPE to carry the same type
    // parameters, which is a second emitted-surface question (they would ride
    // every one of the three fns as well). Named deferral.
    if prm.tparams.len() > 0i64 { return incr_decline_r(qn, IR_GENERIC()); }
    let mut i: i64 = 0i64;
    while i < acount {
        // A UDA threads the user's `A` and its own `_step`; its accumulator is
        // outside `agg_acc_ty`'s domain by construction, and the dynamic engine's
        // algebra gate refuses it too.
        if uda[i] { return incr_decline_r(qn, IR_UDA()); }
        // THE HANDLE OWNS ITS CELLS. A `str` accumulator column would be a BORROW
        // of a source row, and the source is exactly what a handle does not keep.
        if !incr_ty_ok(act[i]) { return incr_decline_r(qn, IR_AGG_STR()); }
        i = i + 1i64;
    }
    // The group KEY is stored by value for the handle's whole life, so the same
    // question is asked of it — and `str` keys are the named deferral this makes,
    // not an oversight: the dynamic engine solves it by interning every string
    // into its own Writ arena, which would put a Writ back into a path whose
    // whole thesis is that it needs none.
    if !incr_ty_ok(key_ty) { return incr_decline_r(qn, IR_KEY_STR()); }
    if tres == 0i32 && !incr_ty_ok(result_ty) { return incr_decline_r(qn, IR_RESULT_STR()); }
    // `select` and `having` must be evaluable from the GROUP ROW alone — no
    // source row (its index is meaningless across epochs) and no scalar
    // parameter (it is a per-call value, and `<q>_snapshot` takes none).
    let mut onames: Vec<str> = Vec::<str>::new();
    let mut j: i64 = 0i64;
    while j < acount { onames.push(aggs.as_slice()[j].name); j = j + 1i64; }
    if !sexpr_over_group_names(proj_e, &onames, acount) {
        return incr_decline_r(qn, IR_SELECT_NAME());
    }
    if has_having && !sexpr_over_group_names(having.view::<SExpr>(), &onames, acount) {
        return incr_decline_r(qn, IR_HAVING_NAME());
    }
    // Every projected COMPONENT must be a value the handle can hand back without
    // borrowing anything it does not own.
    if !incr_proj_ty_ok(proj_e, ty) {
        return incr_decline_r(qn, IR_PROJ_STR());
    }
    if ch.n == 1i64 {
        incr_emit(qn, IR_EMIT_JOIN());
        return true;
    }
    if rel_m >= 0i64 {
        incr_emit(qn, IR_EMIT_REL());
        return true;
    }
    incr_emit(qn, IR_EMIT_SCAN());
    return true;
}

/// May a value of this type be OWNED by a handle that outlives the call that
/// produced it? `str` is a VIEW — of a source row, of a Writ, of a literal — and
/// the first two are exactly what a persisted handle does not keep alive; a
/// `String` is owned but its `Vec<String>` snapshot would then differ from
/// `<q>()`'s `Vec<str>`, which is a surface question (two return types for one
/// query) rather than an emitter one. Both are DEFERRED, and pinned as refused
/// by the eligibility fixture so that they cannot become silently mishandled.
/// Everything else the EL lattice admits — the integer family, `bool`, `f64` —
/// is a self-contained value.
pub fn incr_ty_ok(t: str) -> bool {
    if str_eq(t, "String") { return false; }
    return el_ty(t).cls != EL_TY_STR();
}

/// May a whole ROW of this type be OWNED by a handle? The question `incr_ty_ok`
/// asks of ONE type, asked of every FIELD of a stored source row.
///
/// ⚠ IT REFUSES WHAT IT COULD NOT READ, and that direction is the whole point.
/// `type_stamped` false means the reflection walk never reached this struct — an
/// unknown name, an alias this module cannot follow, no module AST loaded — and
/// an unread struct is not an empty one. Answering `true` there would admit
/// exactly the rows whose fields nobody looked at.
///
/// ⚠ A FIELD WHOSE OWN TYPE IS A STRUCT IS REFUSED RATHER THAN WALKED. `el_ty`
/// answers the `i64` baseline for a name outside the lattice, so a nested struct
/// would pass `incr_ty_ok` while carrying a `str` two levels down — the silent
/// wrong answer this clause exists to stop. Ownership is transitive and this
/// function is not; refusing is the direction that cannot be wrong, and widening
/// it later breaks no caller.
///
/// ⚠⚠ A FLOAT FIELD IS REFUSED TOO, AND THAT IS THE *SECOND* QUESTION THIS
/// FUNCTION ANSWERS. Storing rows in Z-set NORMAL FORM means finding the entry a
/// delta row is a copy of, and that search is a field-by-field `==`. On `f64`,
/// `==` IS NOT IDENTITY — NaN ≠ NaN makes a row carrying one impossible to
/// retract, and −0.0 == +0.0 lets a retraction of one cancel an insert of the
/// other. That is Victor's open 2026-08-07 decision about the multiplicity map's
/// key wearing a different hat, and an emitter may not answer it in passing.
pub fn incr_row_ty_ok(t: &ElTypes, row_ty: str) -> bool {
    if row_ty.len() == 0i64 { return false; }
    if !t.type_stamped(row_ty) { return false; }
    let mut i: i64 = 0i64;
    while true {
        let e: i64 = t.type_field_at(row_ty, i);
        if e < 0i64 { return true; }
        let ftn: str = t.binding_ty_name_at(e);
        if ftn.len() == 0i64 { return false; }
        if el_class_lookup(ftn) < 0i32 { return false; }
        if !incr_ty_ok(ftn) { return false; }
        if el_class_lookup(ftn) == EL_TY_FLT() { return false; }
        if t.binding_col_at(e).len() == 0i64 { return false; }
        i = i + 1i64;
    }
    return true;
}

/// The same question, asked of every component a tuple projection hands back.
/// A `String`-returning call at a component root is caught by `returns_string`
/// rather than by the component's inferred type, which is the same split
/// `push_tuple_ty` makes when it decides an element type.
pub fn incr_proj_ty_ok(e: SExpr, t: &ElTypes) -> bool {
    match e {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let mut i: i64 = 0i64;
            while i < items.len() {
                if !incr_proj_ty_ok(items.arg_at(i), t) { return false; }
                i = i + 1i64;
            }
            return true;
        }
        _ => {
            if returns_string(e, t) { return false; }
            return incr_ty_ok(infer_emit_ty(e, t));
        }
    }
}

/// One declined incremental form, traced with its GROUND, then `false`.
/// Is this chain source a DECLARED, DERIVED `rel` — one materialized by query
/// BODIES rather than by an engine helper?
///
/// ⚠ `rel_find_src` resolves BOTH spellings a rel source wears (the emitted
/// `__rel_<m>_sl` and the semi-naive delta's `__dl_<m>_sl`), which is why the
/// question is asked of it rather than of `rel_names`: by the time a chain
/// reaches `incr_eligible` the plan node's `src_name` has been rewritten to the
/// emitted form, and matching the DECLARED name would silently answer "no rel
/// here" for every query in the population this predicate exists to catch.
///
/// ⚠ NATIVE is excluded deliberately and the ground is in `incr_eligible`: a
/// native rel has neither dedup nor recursion, so it carries no property of the
/// accumulated input for an epoch boundary to lose.
pub fn incr_src_is_derived_rel(prm: &MacroParams, src: str) -> bool {
    let i: i64 = prm.rel_find_src(src);
    if i < 0i64 { return false; }
    return !prm.rel_native[i];
}

/// A refusal named by its RULE (why.logos `IR_*`): the sentence is the rule's
/// rendering, and `[facts]` names the rule — the antecedent that failed (E3).
pub fn incr_decline_r(qn: str, r: i32) -> bool {
    plan_trace("incremental", "declined", qn, ir_render(r));
    incr_facts(qn, r);
    return false;
}

/// The one refusal whose sentence is an OPERAND — the rel registry's own ground
/// for a rel that cannot be accumulated (`rel_incr_why`), under one rule.
pub fn incr_decline_dyn(qn: str, r: i32, why: str) -> bool {
    plan_trace("incremental", "declined", qn, why);
    incr_facts(qn, r);
    return false;
}

pub fn incr_emit(qn: str, r: i32) {
    plan_trace("incremental", "EMITTED", qn, ir_render(r));
    incr_facts(qn, r);
}

pub fn incr_facts(qn: str, r: i32) {
    if !plan_trace_facts_on() { return; }
    let mut fl: String = String::new();
    fl.push_str("[facts] "); fl.push_str(qn); fl.push_str(" incremental rule=");
    fl.push_str(ir_name(r)); fl.push_str("\n");
    plan_trace_raw(string_as_str(&fl));
}

pub fn retract_facts(qn: str, r: i32) {
    if !plan_trace_facts_on() { return; }
    let mut fl: String = String::new();
    fl.push_str("[facts] "); fl.push_str(qn); fl.push_str(" retraction rule=");
    fl.push_str(rt_name(r)); fl.push_str("\n");
    plan_trace_raw(string_as_str(&fl));
}

/// The refusal named by its rule (why.logos `RT_*`, E3).
pub fn incr_no_retract_r(qn: str, r: i32) -> bool {
    plan_trace("retraction", "declined", qn, rt_render(r));
    retract_facts(qn, r);
    return false;
}

/// One query that keeps the INSERT-ONLY surface, traced with its GROUND.
/// A separate channel name from `incr_decline`'s because it is a different
/// answer: the query DOES get a handle, it does not get a `<q>_retract`.
/// The DRed driver's verdict, named by its rule (why.logos `DR_*`, E3).
pub fn dred_trace(bare: str, verdict: str, r: i32) {
    plan_trace("rel dred driver", verdict, bare, dr_render(r));
    if !plan_trace_facts_on() { return; }
    let mut fl: String = String::new();
    fl.push_str("[facts] "); fl.push_str(bare); fl.push_str(" dred rule=");
    fl.push_str(dr_name(r)); fl.push_str("\n");
    plan_trace_raw(string_as_str(&fl));
}

// ══ MAY THIS QUERY'S HANDLE BE RUN BACKWARDS? ══════════════════════════════
//
// The question `<q>_apply`'s WEIGHT and `<q>_retract` rest on, asked of the SAME
// aggregate array the folds are built from and traced on the SAME channel as
// every other derived decision — because a query that silently loses its
// retraction is exactly the unobservable derived decision `incr_eligible`'s
// header already argues about.
//
// ⚠ THE LIST IS THE UNIT, NOT THE AGGREGATE. A retraction retracts a ROW, and a
// row feeds every aggregate in the list at once. There is no shape in which
// `min` runs backwards and the `sum` beside it does not — so ONE aggregate that
// cannot take a negative weight takes the whole retracting surface away, and the
// batch fn, `<q>_epoch` and `<q>_snapshot` are untouched by the refusal.
//
// ⚠ EXACTLY ONE THING IS REFUSED, AND IT IS A FORK RATHER THAN A GAP:
//
//   `count`   — the multiplicity is an integer and `+w` inverts `+(-w)`.
//   `sum` over a NON-float accumulator — `i64` and `u64` both invert under
//               their own checked predicates, with no representable value lost.
//   `min`/`max`, AT EVERY TYPE INCLUDING f64 — these do NOT invert, and they do
//               not have to. Retracting the current best is answered by RESCAN
//               over a per-(group, aggregate) value→multiplicity map (see the
//               semilattice fold in `emit_incremental`), which computes no
//               inverse at all: an extremum is a value SELECTED from the
//               multiset, never a value COMPUTED from it, so nothing rounds and
//               f64 is admitted on the same footing as the integers.
//   `sum`/`avg` over an f64 accumulator — REFUSED. `(S+x)-x != S`. That is
//               decision D4, it is OPEN and reserved, and it is not this
//               emitter's to take. Note this catches `avg` over an INTEGER
//               column too: `avg` divides at snapshot out of an f64 running
//               total, so its accumulator is a float whatever the column is.
//
// ⚠ THE PREDICATE READS `acc`, THE ACCUMULATOR ARRAY, AND NOT `agg_flt`. The two
// axes answer the same cell — `compute_acc_tys` sets `acc[i] == "f64"` exactly
// when `agg_flt[i]`, and `agg_flt` is unconditionally true for `avg` — but the
// GROUND is about the accumulator, so the test that carries the ground should be
// the one that names it. (A UDA is the only place the two could part, with
// `acc[i] == ""`; `incr_eligible` declines a UDA one axis out, so this predicate
// is never asked about one.)
/// THE PREDICATE ITSELF, WITH NO TRACE — because ONE of its consumers has to ask
/// it BEFORE the query is known to be eligible at all, and tracing a `retraction`
/// verdict for a query that never gets a handle would break the derived count
/// `incr_eligibility_gate.sh` asserts (the retract axis is traced exactly once
/// per EMITTED handle, and that identity is the gate's second table).
///
/// ⚠ ONE DERIVATION, TWO CALLERS — not one decision asked twice. `incr_eligible`
/// needs the answer because a JOIN chain on the INSERT-ONLY surface has no place
/// to put a source tag (see the clause there); `incr_retract_eligible` needs it
/// to trace and to shape the emitted fns. Both read THIS function, so they cannot
/// answer differently — the `accw`/`compute_acc_tys` failure mode this file
/// already carries two warnings about.
pub fn retract_ok(aggs: &Vec<CAgg>, acc: &Vec<str>) -> bool {
    let mut i: i64 = 0i64;
    while i < aggs.len() {
        let fnid: i32 = agg_of_name(aggs.as_slice()[i].func);
        if (fnid == AGG_SUM() || fnid == AGG_AVG()) && str_eq(acc[i], "f64") { return false; }
        i = i + 1i64;
    }
    return true;
}

/// Does the aggregate list contain a `min` or a `max`? Asked by the DRed
/// driver's admission (`dred` in `emit_incremental`) and by nothing else.
///
/// ⚠ IT IS A QUESTION ABOUT STATE, NOT ABOUT ARITHMETIC, and that is why it is a
/// SEPARATE predicate from `retract_ok` rather than a clause inside it.
/// `retract_ok` answers "does this aggregate run backwards", and `min`/`max` DO
/// — by rescanning the value→multiplicity map, exactly as its header says. What
/// the DRed driver lacks is the MAP: `want_map` builds `__gm_<out>` only under
/// `retr`, and a rel-backed query is on the insert-only surface, so the field
/// does not exist for the driver's −1 fold to rescan. Folding the two grounds
/// into one predicate would make `retract_ok` say something false about
/// `min`/`max` at its other two call sites.
pub fn aggs_any_minmax(aggs: &Vec<CAgg>) -> bool {
    let mut i: i64 = 0i64;
    while i < aggs.len() {
        let fnid: i32 = agg_of_name(aggs.as_slice()[i].func);
        if fnid == AGG_MIN() || fnid == AGG_MAX() { return true; }
        i = i + 1i64;
    }
    return false;
}

pub fn incr_retract_eligible(aggs: &Vec<CAgg>, acc: &Vec<str>,
                         rel_backed: bool, qn: str) -> bool {
    // ── RETRACTION THROUGH RECURSION IS REFUSED, AND THE GROUND IS A FACT ───
    //
    // ⚠ ASKED FIRST, AHEAD OF THE AGGREGATE LIST, because it is the STRONGER
    // refusal: an f64 `sum` is an open DECISION, this one is a property of
    // recursion. A fact may support ITSELF through a cycle (`path(a,b)` derived
    // from `path(a,c)`), so "subtract what it added" is not merely imprecise —
    // there is no well-defined amount to subtract. The mechanism that IS correct
    // is DRed (over-delete every consequence, compact, re-derive from surviving
    // support), which the dynamic engine implements at `incr_rec.logos:776-910`;
    // it is a second state machine over provenance, not an inverse fold.
    //
    // ⚠⚠ AND THE REFUSAL IS STRUCTURAL, NOT ADVISORY. Returning `false` here
    // selects the INSERT-ONLY *WEIGHTED* surface: `<q>_apply` is not emitted at
    // all and `__wd` does not exist in any scope this query emits, so folding a
    // derived row at a caller-supplied weight is not expressible rather than
    // merely wrong.
    // ⚠⚠ WHAT THIS NO LONGER MEANS, SINCE THE SURFACE ROUND: it does NOT mean
    // the query has no retraction. A rel-backed query that clears `dred` in
    // `emit_incremental` gets a PUBLIC `<q>_retract` forwarding to
    // `__wql_<q>_scc<c>_dred` — the DRed state machine this ground names as the
    // correct mechanism, now built. This clause's job is to keep that surface
    // off the INVERSE-FOLD path, not to withhold retraction. The doors that
    // assert a missing `<q>_retract` are now the shapes `dred` itself refuses
    // (`fail/wql_incr_rel_no_retract_minmax.logos`,
    // `fail/wql_incr_rel_no_retract_float.logos`).
    // Historically: `fail/wql_incr_rel_no_retract.logos` called `<q>_retract` and
    // required the compile to FAIL on the missing name — flip this clause and
    // that fixture goes green, which is a red gate on the per-commit path.
    // ⚠ AND THAT `fail/` DOOR IS NOT THE LOAD-BEARING ONE — a missing name is
    // true under every refusal that reaches the query. The gate that pins THIS
    // clause by its GROUND is `logos_09_incr_mutrec_refusal` (tier_commit),
    // which asserts `retraction -> declined` carrying the phrase "support ITSELF
    // through a cycle" while the handle itself is EMITTED. CONTROL, MEASURED
    // 2026-08-07: `if rel_backed` weakened to `if false`, archives dropped, full
    // stdlib rebuild → that gate goes RED.
    //
    // ⚠⚠ DRed'S PHASE 1 IS NOW EMITTED AND THIS CLAUSE STILL SAYS NO, ON PURPOSE.
    // `emit_scc_od_fns` emits `__wql_<q>_scc<c>_od` / `_odp` beside the insert
    // driver, and `pass/wql_incr_rel_od_phase1.logos` proves the over-delete set
    // against a from-scratch oracle — but phase 2 (COMPACT) and phase 3
    // (RE-DERIVE) do not exist, nothing calls the two new fns outside that
    // fixture, and the handle has no signed-diff group fold. Admitting the
    // retraction surface on a phase-1-only engine would answer `Ok` with an
    // OVER-DELETED relation, which is strictly worse than refusing. The ground
    // below is unchanged for the same reason: what is missing is still the
    // mechanism, not a preference.
    if rel_backed {
        return incr_no_retract_r(qn, RT_REC_REL());
    }
    if !retract_ok(aggs, acc) {
        return incr_no_retract_r(qn, RT_FLOAT_ACC());
    }
    plan_trace("retraction", "EMITTED", qn, rt_render(RT_EXACT()));
    retract_facts(qn, RT_EXACT());
    return true;
}

