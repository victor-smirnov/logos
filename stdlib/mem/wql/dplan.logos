// logos.std.wql.dplan — the Deem PLAN as data (ADR 0031 R5).
//
// A decision the planner makes is a value of this module's types, made by a
// pure function of the facts it reads and RECORDED with its ground; an emitter
// reads the value and never re-derives it. R5 moves the decisions here one at a
// time, each move checked by a byte-identical snapshot of the emitted code and
// the plan traces of the whole corpus (ADR 0031 §4.1).
//
// R5.0 — the entry's SCAN: which of the seven scan shapes a single-source
// query runs, and whether its `order by` is elided by the source's own order.
package logos.std.wql.dplan;

use logos.lang.str;
use logos.mem.string;
use logos.std.wql.params;          // MacroParams: the source registry the decision reads
use logos.std.wql.core;            // the core: the clauses a decision reads
use logos.std.wql.ir;              // SExpr
use logos.lang.writ.anyval;        // WAny::view
use logos.std.wql.codegen;         // sexpr_over_group_names
use logos.std.wql.optimize;        // simplify_sexpr, sexpr_const, is_identity_sel
use logos.lang.writ.container;     // Writ
use logos.mem.collections.vec;
use logos.lang.option;

extern fn getenv(name: *const u8) -> *const u8;
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;

/// The shape a single-source scan runs. Exhaustive: an emitter `match`es it.
pub enum DScanArm {
    /// `order by` over a slice parameter: collect index + key over the
    /// `SliceStream` wrap, sort the permutation, project through it.
    SortSlice,
    /// `order by` over anything else: the same three phases over an indexed walk.
    SortIndexed,
    /// An unmaterialised batch producer read BACKWARD (`order by … desc` over
    /// its own order): `land_end`, `prev_batch`, a decrementing inner loop.
    BatchRev,
    /// An unmaterialised batch producer read forward: §1's one batch shape.
    BatchFwd,
    /// An unmaterialised row producer: `next()` until `None`.
    RowPull,
    /// A slice parameter with no registry identity: the `SliceStream` wrap.
    SliceWrap,
    /// Everything else (a materialised rel, a drained source): an indexed walk.
    Indexed,
}

pub struct DScan {
    /// The source as the query names it.
    pub src: str,
    /// Its registry index, or -1 (a slice parameter has none).
    pub rel: i64,
    pub arm: DScanArm,
    /// The source's rows already arrive in the `order by`'s order
    /// (`AccessPlan.ord_noop`), so the query's sort is dropped.
    pub sort_elided: bool,
    /// The source is a slice parameter read through a `SliceStream` wrap.
    pub slice: bool,
}

/// A slice parameter with no registry identity — read through a `SliceStream`
/// wrap (ADR 0025 R-A). THE one copy of this predicate.
pub fn dp_slice_stream_src(prm: &MacroParams, src: str) -> bool {
    if prm.rel_find_src(src) >= 0i64 { return false; }
    return prm.is_source(src);
}

/// The entry scan's shape, from the facts the access plan left on the
/// registry. `has_sort`: the query writes an `order by`.
pub fn plan_entry_scan(prm: &MacroParams, src: str, has_sort: bool) -> DScan {
    let elided: bool = has_sort && prm.rel_src_ord_noop(src);
    let sorts: bool = has_sort && !elided;
    let slice: bool = dp_slice_stream_src(prm, src);
    let rel: i64 = prm.rel_find_src(src);
    let mut arm: DScanArm = DScanArm::Indexed;
    if sorts {
        arm = if slice { DScanArm::SortSlice } else { DScanArm::SortIndexed };
    } else if prm.rel_src_unmaterialized(src) {
        if rel >= 0i64 && prm.rel_batch[rel] {
            arm = if prm.rel_src_ord_rev(src) { DScanArm::BatchRev } else { DScanArm::BatchFwd };
        } else {
            arm = DScanArm::RowPull;
        }
    } else if slice {
        arm = DScanArm::SliceWrap;
    }
    let d: DScan = DScan { src: src, rel: rel, arm: arm, sort_elided: elided, slice: slice };
    dplan_dump_scan(&d);
    return d;
}

/// THE GROUP-FRAME CLASS (ADR 0025 S4): TRUE iff every clause above the group —
/// `select`, `having`, `order by` — reads only `key` and the aggregate outputs,
/// so no group carries a representative base row. Decided ONCE, here: the
/// planner (single pass) and the emitter (`__g_row` or not) both read it — they
/// used to ask it separately, of two different trees.
pub fn plan_group_pure(ru: &CRule) -> bool {
    match &ru.clause.group {
        Option::None => { return false; }
        Option::Some(g) => {
            let mut onames: Vec<str> = Vec::<str>::new();
            let ags: &[CAgg] = g.aggs.as_slice();
            let mut j: i64 = 0i64;
            while j < g.aggs.len() { onames.push(ags[j].name); j = j + 1i64; }
            let n: i64 = onames.len();
            if !sexpr_over_group_names(ru.clause.head.view::<SExpr>(), &onames, n) { return false; }
            match &g.having {
                Option::Some(h) => { if !sexpr_over_group_names((*h).view::<SExpr>(), &onames, n) { return false; } }
                Option::None => { }
            }
            match &ru.env.order {
                Option::Some(o) => { if !sexpr_over_group_names((*o).view::<SExpr>(), &onames, n) { return false; } }
                Option::None => { }
            }
            return true;
        }
    }
}

/// What a single-source entry (the `Simple` and `find` shapes) is, once its
/// constant clauses are folded: no rows at all, the source itself (or its first
/// row), or a scan.
pub enum DForm {
    /// `where` folds to false, or `limit 0`: an empty answer, no scan.
    Empty,
    /// Nothing filters, sorts, dedups or limits, and the row IS the select
    /// (or `find` with nothing left to test): the source / its first row.
    Identity,
    Scan,
}

/// The single-source entry, its clauses folded (ADR 0031 R6.2): what the scan
/// emitter is handed. `pred` / `sort_key` null = none left.
pub struct DSimple {
    pub form: DForm,
    pub src: str,
    pub row_ty: str,
    pub var: str,
    pub pred: WAny,
    pub sel: WAny,
    pub sort_key: WAny,
    pub sort_desc: bool,
    pub distinct: bool,
    pub has_limit: bool,
    pub limit_n: i64,
    pub limit_is_param: bool,
    pub limit_param: str,
}

// The entry's clauses folded as the relational simplifier folded them — the
// ONE copy, for every entry shape it serves: a constant `where` disappears
// (true) or empties the answer (false); a constant sort key drops the sort;
// `limit 0` empties it; identity needs a single bare source, no distinct or
// limit, and a select that is the row variable (or `find`). `cond` is the
// rule's one `where` (null = none).
fn dp_fold_entry(ru: &CRule, src: str, row_ty: str, var: str, cond: WAny, single: bool,
                 h: &Writ) -> DSimple {
    let find: bool = match &ru.env.mode { CMode::Find => { true } CMode::All => { false } CMode::First => { false } };
    let mut empty: bool = false;
    let mut pred: WAny = WAny::null();
    if !cond.is_null() {
        let ph: WRef<SExpr> = simplify_sexpr(cond.view::<SExpr>(), h);
        let pc: ConstVal = sexpr_const(ph.any().view::<SExpr>());
        if pc.is_bool() {
            if !pc.b { empty = true; }
        } else {
            pred = ph.any();
        }
    }
    let mut sort_key: WAny = WAny::null();
    match &ru.env.order {
        Option::Some(o) => {
            if !empty {
                let kh: WRef<SExpr> = simplify_sexpr((*o).view::<SExpr>(), h);
                let mut lit: bool = false;
                match kh.any().view::<SExpr>() { SExpr::Lit(_l) => { lit = true; } _ => { } }
                if !lit { sort_key = kh.any(); }
            }
        }
        Option::None => { }
    }
    let mut has_limit: bool = false;
    let mut limit_n: i64 = 0i64;
    let mut limit_is_param: bool = false;
    let mut limit_param: str = "";
    match &ru.env.limit {
        CLimit::None => { }
        CLimit::N(n) => { has_limit = true; limit_n = *n; if *n == 0i64 { empty = true; } }
        CLimit::Param(q) => { has_limit = true; limit_is_param = true; limit_param = *q; }
    }
    let mut form: DForm = DForm::Scan;
    if empty {
        form = DForm::Empty;
    } else if single && !has_limit && !ru.env.distinct && sort_key.is_null() && pred.is_null()
              && (find || is_identity_sel(WRef::<SExpr>::from_any(ru.clause.head), var)) {
        form = DForm::Identity;
    }
    return DSimple { form: form, src: src, row_ty: row_ty, var: var, pred: pred,
                     sel: ru.clause.head, sort_key: sort_key, sort_desc: ru.env.desc,
                     distinct: ru.env.distinct, has_limit: has_limit, limit_n: limit_n,
                     limit_is_param: limit_is_param, limit_param: limit_param };
}

// The rule's base atom (positive, unconditioned), or None.
fn dp_base(ru: &CRule) -> Option<CAtomRef> {
    let bs: &[CLit] = ru.clause.body.as_slice();
    if ru.clause.body.len() < 1i64 { return Option::None; }
    match &bs[0i64] {
        CLit::Atom(a) => {
            if a.neg || a.conds.len() > 0i64 { return Option::None; }
            return Option::Some(CAtomRef { name: a.name, row_ty: a.row_ty, var: a.var });
        }
        CLit::Trav(_t) => { return Option::None; }
        CLit::Cond(_c) => { return Option::None; }
    }
}

struct CAtomRef { name: str, row_ty: str, var: str }

/// The planned core's entry as a single-source query, or None when it is not
/// one (a join, a traversal, a group). `where_retired`: an exact access op
/// answers the `where` (`plan_where_retired`; never for `find`).
pub fn plan_entry_simple(p: &CProgram, where_retired: bool, h: &Writ) -> Option<DSimple> {
    let ru: &CRule = &p.entry;
    match &ru.clause.group { Option::Some(_g) => { return Option::None; } Option::None => { } }
    let base: CAtomRef = match dp_base(ru) { Option::Some(b) => { b } Option::None => { return Option::None; } };
    let bs: &[CLit] = ru.clause.body.as_slice();
    let mut cond: WAny = WAny::null();
    let mut i: i64 = 1i64;
    while i < ru.clause.body.len() {
        match &bs[i] {
            CLit::Cond(c) => {
                match &c.site { CSite::Where => { } CSite::On => { return Option::None; } }
                if !cond.is_null() { return Option::None; }
                cond = c.e;
            }
            CLit::Atom(_a) => { return Option::None; }
            CLit::Trav(_t) => { return Option::None; }
        }
        i = i + 1i64;
    }
    let find: bool = match &ru.env.mode { CMode::Find => { true } CMode::All => { false } CMode::First => { false } };
    if where_retired && !find { cond = WAny::null(); }
    return Option::Some(dp_fold_entry(ru, base.name, base.row_ty, base.var, cond, true, h));
}

/// The planned core's entry as a JOIN CHAIN (a base atom and at least one
/// step: a join, an anti join or a traversal), its `where` folded; None when
/// it is not one. The chain itself is read off the rule by the emitter.
pub fn plan_entry_chain(p: &CProgram, h: &Writ) -> Option<DSimple> {
    let ru: &CRule = &p.entry;
    match &ru.clause.group { Option::Some(_g) => { return Option::None; } Option::None => { } }
    let base: CAtomRef = match dp_base(ru) { Option::Some(b) => { b } Option::None => { return Option::None; } };
    let bs: &[CLit] = ru.clause.body.as_slice();
    let mut steps: i64 = 0i64;
    let mut cond: WAny = WAny::null();
    let mut i: i64 = 1i64;
    while i < ru.clause.body.len() {
        match &bs[i] {
            CLit::Cond(c) => {
                match &c.site {
                    CSite::Where => { if !cond.is_null() { return Option::None; } cond = c.e; }
                    CSite::On => { }
                }
            }
            CLit::Atom(_a) => { steps = steps + 1i64; }
            CLit::Trav(_t) => { steps = steps + 1i64; }
        }
        i = i + 1i64;
    }
    if steps == 0i64 { return Option::None; }
    return Option::Some(dp_fold_entry(ru, base.name, base.row_ty, base.var, cond, false, h));
}

/// The arm runs the sort phases.
pub fn dscan_sorts(d: &DScan) -> bool {
    match &d.arm {
        DScanArm::SortSlice => { return true; }
        DScanArm::SortIndexed => { return true; }
        DScanArm::BatchRev => { return false; }
        DScanArm::BatchFwd => { return false; }
        DScanArm::RowPull => { return false; }
        DScanArm::SliceWrap => { return false; }
        DScanArm::Indexed => { return false; }
    }
}

/// The arm pulls an unmaterialised producer (batch or row).
pub fn dscan_pulls(d: &DScan) -> bool {
    match &d.arm {
        DScanArm::BatchRev => { return true; }
        DScanArm::BatchFwd => { return true; }
        DScanArm::RowPull => { return true; }
        DScanArm::SortSlice => { return false; }
        DScanArm::SortIndexed => { return false; }
        DScanArm::SliceWrap => { return false; }
        DScanArm::Indexed => { return false; }
    }
}

/// The arm pulls whole batches (forward or backward).
pub fn dscan_batches(d: &DScan) -> bool {
    match &d.arm {
        DScanArm::BatchRev => { return true; }
        DScanArm::BatchFwd => { return true; }
        DScanArm::RowPull => { return false; }
        DScanArm::SortSlice => { return false; }
        DScanArm::SortIndexed => { return false; }
        DScanArm::SliceWrap => { return false; }
        DScanArm::Indexed => { return false; }
    }
}

/// The arm reads its producer backward.
pub fn dscan_backward(d: &DScan) -> bool {
    match &d.arm {
        DScanArm::BatchRev => { return true; }
        DScanArm::BatchFwd => { return false; }
        DScanArm::RowPull => { return false; }
        DScanArm::SortSlice => { return false; }
        DScanArm::SortIndexed => { return false; }
        DScanArm::SliceWrap => { return false; }
        DScanArm::Indexed => { return false; }
    }
}

pub fn dscan_arm_name(d: &DScan) -> str {
    match &d.arm {
        DScanArm::SortSlice => { return "sort-slice"; }
        DScanArm::SortIndexed => { return "sort-indexed"; }
        DScanArm::BatchRev => { return "batch-rev"; }
        DScanArm::BatchFwd => { return "batch"; }
        DScanArm::RowPull => { return "row-pull"; }
        DScanArm::SliceWrap => { return "slice-wrap"; }
        DScanArm::Indexed => { return "indexed"; }
    }
}

/// `LOGOS_DEEM_DUMP=dplan`: each plan value as it is decided, on stderr.
pub fn dplan_dump_on() -> bool {
    let mut c: String = String::new();
    c.push_str("LOGOS_DEEM_DUMP");
    c.push_u8(0u8);
    unsafe {
        let v: *const u8 = getenv(c.as_ptr());
        if v == 0 as *const u8 { return false; }
        return str_eq(str_from_cstr(v), "dplan");
    }
}

fn dplan_dump_scan(d: &DScan) {
    if !dplan_dump_on() { return; }
    let mut s: String = String::new();
    s.push_str("[dplan] scan "); s.push_str(d.src);
    s.push_str(" arm="); s.push_str(dscan_arm_name(d));
    if d.sort_elided { s.push_str(" sort-elided"); }
    s.push_str("\n");
    unsafe { write(2i32, s.as_ptr(), s.len()); }
}
