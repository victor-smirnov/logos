// logos.std.wql.codegen — the shared STATIC-backend codegen helper: walk the
// SExpr Writ-schema IR and emit a Logos expression as source text (ADR 0012
// §10.2 — "metacall walks the schema'd IR → source"). Used by BOTH resource
// frontends: `wql!` (where/select clauses) and `trama!` (`{{ … }}` / `{% if %}`
// / `{% for in %}` embedded expressions). One lowering, two consumers.
//
// SELF-DESCRIBING IR (ADR 0012 peg-frontend §5, Option B): the codegen reads
// field/param/var NAMES directly off the IR nodes (`f.name`, `pp.name`,
// `c.fn_name`, …) — NOT from an `ElParser` dense side table. Value-TYPES come
// from a name→type dictionary (`ElTypes`) the handler builds from schema
// reflection + the `deem!(…)`/`trama!(…)` parameter list. So the codegen depends
// only on the IR + a type dict, never on the parser — which is what makes a
// peg-generated parser a drop-in producer of the same IR.
package logos.std.wql.codegen;

use logos.std.compiler.metaprog;  // error — the clause writers' diag channel
use logos.lang.writ.anyval;
use logos.lang.writ.wstring;   // WAny::as_wstr (string-literal payloads)
use logos.std.wql.ir;
use logos.std.wql.el;          // ElTypes, EL_TY_*, OP_*
use logos.mem.string;
use logos.lang.str;
// ── LOAD-CLOSURE ANCHORS, not this module's own dependencies ──────────────
// The join-strategy containers a generated chunk `use`s (hashmap / set /
// btree). A CHUNK can only import modules already in the compile's transitive
// load closure — the module loader follows `use`-deps from the ENTRY file, and
// late-appended metaprog chunks cannot pull new archives. Importing them HERE
// guarantees every wql!/trama!-consuming compile has them loaded. hashmap is
// also a real dependency of the generated parsers; set and btree exist in
// emitted code only.
//
// ⚠ These `use` lines outlived `begin_chunk`, which is why they are labelled.
// The chunk's own import LIST moved into the quote templates that emit the
// items (rexpr_walk's emit_fn_quote_blob, trama_render's render-fn quote), but
// the load-closure requirement did not move — it is a property of the compile,
// not of the emitter, so deleting them here would make those quoted `use`s
// unresolvable in a consumer that imports nothing else.
use logos.mem.collections.hashmap;
use logos.mem.collections.set;
use logos.mem.collections.btree;
use logos.std.wql.writ_graph;     // writ_graph_edges — the NATIVE graph-source
                                  // materialization emitted for `<p>: &Writ`
                                  // params (ADR 0016 M1a); closure-pulled here
                                  // for the same reason as set/btree above.

// ── The chunk prologue is GONE — it was the last text in this file ────────
// (`begin_chunk(em, view, extra_uses)` lived here: `emit_target_pkg` plus six
// raw text pushes writing `package <pkg>; use …;` into an Emitter. It has no
// callers and no replacement of its own shape, because the thing it prefixed —
// a hand-concatenated item — no longer exists. Both consumers now emit their
// item as a `quote_item!`, and a quote states its imports AS IMPORTS:
// rexpr_walk's emit_fn_quote_blob for wql!, trama_render's render-fn quote for
// trama!. ADR 0024 S5.)
//
// The two halves of what begin_chunk did are now structural rather than lexical:
//
//   • the IMPORT LIST is a run of `use` decls inside each quote template, plus
//     `#( use #uses; )*` for the runtime-sized native-source part (ADR 0016 §6 —
//     one module per source the query binds, so a chunk imports
//     logos.std.wql.writ_graph only when a graph param exists and logos.std.deem
//     only when an engine param does; unconditional deem would demand the engine
//     in every consumer's load closure, and wql must not import deem — module
//     cycle). trama! binds no native source and so carries no repeat.
//
//   • the PACKAGE is no longer computed at all. `emit_target_pkg` read it off
//     the trigger module's root MODULE node because `logos_emit_source` takes
//     the package FROM THE TEXT; `logos_emit_item_blob_subst` instead stamps the
//     spliced module's NAME + PATH_PARTS from the metacall SITE's ast, which is
//     the same package by construction. ⚠ That equivalence is what makes the
//     quote channel usable here and is exactly what does NOT hold for
//     lcm/wql/deem_bind.logos, whose metacall is rendered into a
//     `package logos.gen;` driver chunk — see the note there.

// ── Builtin function registry ───────────────────────────────────────────────
// The registry (BFN_* ids, builtin_of_name/arity/ret_ty) and the RUNTIME helper
// fns (wql_upper / wql_lower / wql_f64_to_str) now live in logos.std.wql.el —
// shared with the DYNAMIC interpreter (logos.std.deem), which must not import
// this metaprog-tainted package. Imported here via `use logos.std.wql.el`.
//
// Each builtin lowers to a fully-qualified stdlib call (qualified-path form, so
// the generated function compiles regardless of the user module's `use`s):
//   len(s)            → ((s).len())                                  : INT
//   upper(s)          → logos.std.wql.el::wql_upper(s)               : STR
//   lower(s)          → logos.std.wql.el::wql_lower(s)               : STR
//   contains(s,n)     → logos.lang.str::str_contains((s),(n))        : BOOL
//   starts_with(s,p)  → logos.lang.str::str_starts_with((s),(p))     : BOOL

// ── Value-type inference (codegen type detection) ─────────────────────────
// Compute the EL value-type (EL_TY_*) of an SExpr, the signal the static
// backend uses to choose `push_str` vs `push_i64`, emit a string literal, and
// route the row/projection element type. Sources of type:
//   • SLit          — the WAny payload (string / bool / float / int);
//   • SParam / field — the type DICTIONARY (`ElTypes`, params + reflection);
//   • SBin           — compare/logical ⇒ BOOL; `+` with a STR operand ⇒ STR
//                      (string concatenation); arithmetic with a FLT operand ⇒
//                      FLT (INT promotes to FLT), else INT;
//   • SUn            — `!` ⇒ BOOL, `-` ⇒ the argument's numeric type (FLT/INT);
//   • SCond          — the then-branch's type (both arms agree under strict typing).
// Unknown / out-of-MVP nodes default to INT.
pub fn infer_ty(e: SExpr, t: &ElTypes) -> i32 {
    match e {
        SExpr::Lit(l) => {
            let v: WAny = l.val;
            if v.is_string() { return EL_TY_STR(); }
            if v.is_bool()   { return EL_TY_BOOL(); }
            if v.is_float()  { return EL_TY_FLT(); }
            return EL_TY_INT();
        }
        SExpr::Param(pp) => { return t.ty_of(pp.name); }
        SExpr::Var(vv)   => { return t.ty_of(vv.name); }
        SExpr::Field(f)  => {
            // THE CLASS IS THE VIEW OF THE NAME — one resolution, not two, so a
            // column cannot be one class here and another type there.
            let fn0: str = field_ty_name(f, t);
            if fn0.len() > 0i64 { return el_ty_of_name(fn0); }
            return t.ty_of(f.name);
        }
        SExpr::Bin(b) => {
            let op: i32 = b.op;
            if op == OP_OR() || op == OP_AND()
               || op == OP_EQ() || op == OP_NE()
               || op == OP_LT() || op == OP_LE()
               || op == OP_GT() || op == OP_GE() { return EL_TY_BOOL(); }
            let lt: i32 = infer_ty(b.lhs_expr(), t);
            let rt: i32 = infer_ty(b.rhs_expr(), t);
            if op == OP_ADD() {
                if lt == EL_TY_STR() || rt == EL_TY_STR() { return EL_TY_STR(); }
            }
            // Arithmetic (+ - * / %) with a FLT operand promotes to FLT.
            if lt == EL_TY_FLT() || rt == EL_TY_FLT() { return EL_TY_FLT(); }
            return EL_TY_INT();
        }
        SExpr::Un(u) => {
            if u.op == OP_NOT() { return EL_TY_BOOL(); }
            // Unary minus keeps the argument's numeric type (FLT stays FLT).
            if infer_ty(u.arg_expr(), t) == EL_TY_FLT() { return EL_TY_FLT(); }
            return EL_TY_INT();
        }
        SExpr::Cond(c) => { return infer_ty(c.then_expr(), t); }
        SExpr::Call(c) => {
            let bfn: i32 = builtin_of_name(c.fn_name);
            if bfn != BFN_UNKNOWN() { return builtin_ret_ty(bfn); }
            // Non-builtin → the reflected UDF table (builtins shadow UDFs).
            let ui: i64 = t.udf_find(c.fn_name);
            if ui >= 0i64 {
                let r: i32 = t.udf_ret[ui];
                if r >= 0i32 { return r; }
            }
            return EL_TY_INT();
        }
        SExpr::Comp(_) => { return EL_TY_INT(); }   // list value (element ty = INT in the scalar lattice)
        SExpr::Tuple(_) => { return EL_TY_INT(); }  // OUT of the scalar lattice — projection paths
                                                    // special-case tuples via tuple_ty_text BEFORE
                                                    // consulting the EL_TY_* tag (never meaningful here)
        _ => { return EL_TY_INT(); }
    }
}

// The LOGOS TYPE NAME of an expression — `infer_ty`'s answer, but as the type
// the emitter must actually PRINT (ADR 0024 S3).
//
// `infer_ty` returns a four-value class, which is what the join-strategy
// cascade wants and exactly the wrong thing to emit: every integer width
// collapses to INT, so a `u64` column printed `i64` and the row type of a
// query over it was wrong by construction. This walks the same cases and
// returns the DECLARED name wherever one was recorded, falling back to the
// class's representative where no name exists (a literal has no type of its
// own — it takes one from its context).
// ── the PLAN TRACE (ADR 0024 S4) ────────────────────────────────────────────
//
// ONE channel for every plan decision, so a trace is a record of what the
// planner concluded rather than a per-site debug print. Local externs rather
// than `logos.std.env`/`io`: this tier must not depend on those, and a trace is
// not worth a module edge.
extern fn getenv(name: *const u8) -> *const u8;
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;

/// `LOGOS_TRACE_PLAN=1`.
pub fn plan_trace_on() -> bool {
    let mut c: String = String::new();
    c.push_str("LOGOS_TRACE_PLAN");
    c.push_u8(0u8);
    unsafe { return getenv(c.as_ptr()) != 0 as *const u8; }
}

/// One decision: what was concluded, about what, and the antecedent that
/// decided it — which for a fallback is also the remedy.
pub fn plan_trace(subject: str, verdict: str, about: str, why: str) {
    if !plan_trace_on() { return; }
    let mut ln: String = String::new();
    ln.push_str("[plan] "); ln.push_str(subject);
    ln.push_str(" -> "); ln.push_str(verdict);
    if about.len() > 0i64 { ln.push_str(" on "); ln.push_str(about); }
    ln.push_str("   ("); ln.push_str(why); ln.push_str(")\n");
    unsafe { write(2i32, ln.as_ptr(), ln.len()); }
}

// ── THE PLAN-INDEPENDENCE SEAM (ADR 0024 S4r) ───────────────────────────────
//
// The Deem compiler carries several join orders and picks one at run time from
// the data. What must hold is that the ANSWER does not depend on that pick —
// same rows, same sequence, whichever nest runs. That is a property of every
// query with more than one candidate, and until this seam existed it was
// checked by the two or three fixtures that write `order_ix` by hand.
//
// `LOGOS_WQL_FORCE_ORDER=<k>` makes every multi-candidate nest in the compile
// run candidate `k mod ncand` instead of the one the cost function selected. It
// is a COMPILE-time knob because the discriminant is compiled in: a caller can
// write `order_ix` only on a plan it holds, and most of the corpus calls the
// direct fn, which prepares for itself. This is the only seam from which every
// carried nest of every fixture is reachable without editing the fixture.
//
// ⚠ THE PLAN OBJECT IS NOT TOUCHED. `prepare` still measures, still prices, and
// still writes the argmin into `order_ix`; `agrees`/`margin`/`cost_of` are
// unchanged. A fixture that asserts the DECISION goes on asserting the same
// decision while the nest beneath it changes — which is what makes the forced
// run a metamorphic transformation of the fixture rather than a different test.
//
// ⚠ UNSET ⇒ -1 ⇒ the emitter takes the path it took before this existed. The
// knob is read once per join nest, in `emit_join_chain`, and its only effect is
// the text of one discriminant expression.
pub fn force_order_ix() -> i64 {
    let mut c: String = String::new();
    c.push_str("LOGOS_WQL_FORCE_ORDER");
    c.push_u8(0u8);
    unsafe {
        let v: *const u8 = getenv(c.as_ptr());
        if v == 0 as *const u8 { return -1i64; }
        let s: str = str_from_cstr(v);
        if s.len() == 0i64 { return -1i64; }
        let mut acc: i64 = 0i64;
        let mut i: i64 = 0i64;
        while i < s.len() {
            let d: u8 = str_byte_at(s, i);
            if d < 48u8 || d > 57u8 { return -1i64; }   // not a number ⇒ not set
            acc = acc * 10i64 + ((d - 48u8) as i64);
            i = i + 1i64;
        }
        return acc;
    }
}

/// `LOGOS_WQL_ORDER_CENSUS=1` — one line per join nest naming how many
/// candidates it carries, so the driver of the gate knows how far to range `k`
/// and which fixtures carry more than one order AT ALL. Without it the gate
/// would be guessing the size of the space it claims to cover.
pub fn order_census_on() -> bool {
    let mut c: String = String::new();
    c.push_str("LOGOS_WQL_ORDER_CENSUS");
    c.push_u8(0u8);
    unsafe { return getenv(c.as_ptr()) != 0 as *const u8; }
}

/// `[wql-order] <query> ncand=<n> deferred=<0|1>` on stderr.
pub fn order_census(fn_name: str, ncand: i64, deferred: bool) {
    if !order_census_on() { return; }
    let mut ln: String = String::new();
    ln.push_str("[wql-order] ");
    ln.push_str(fn_name);
    ln.push_str(" ncand=");
    ln.push_i64(ncand);
    ln.push_str(" deferred=");
    if deferred { ln.push_str("1"); } else { ln.push_str("0"); }
    ln.push_str("\n");
    unsafe { write(2i32, ln.as_ptr(), ln.len()); }
}

pub fn infer_ty_name(e: SExpr, t: &ElTypes) -> str {
    match e {
        SExpr::Param(pp) => { return t.ty_name_of(pp.name); }
        SExpr::Var(vv)   => { return t.ty_name_of(vv.name); }
        SExpr::Field(f)  => {
            let nm: str = field_ty_name(f, t);
            if nm.len() > 0i64 { return nm; }
            return t.ty_name_of(f.name);
        }
        SExpr::Bin(b) => {
            let op: i32 = b.op;
            if op == OP_OR() || op == OP_AND()
               || op == OP_EQ() || op == OP_NE()
               || op == OP_LT() || op == OP_LE()
               || op == OP_GT() || op == OP_GE() { return "bool"; }
            // Arithmetic keeps the operands' type. A literal contributes no
            // name, so the named side wins — `e.n + 1` over a u64 column is
            // u64, which is also what the host compiler would infer.
            let ln: str = infer_ty_name(b.lhs_expr(), t);
            let rn2: str = infer_ty_name(b.rhs_expr(), t);
            if str_eq(ln, "f64") || str_eq(rn2, "f64") { return "f64"; }
            if str_eq(ln, "str") || str_eq(rn2, "str") { return "str"; }
            if !str_eq(ln, "i64") { return ln; }
            return rn2;
        }
        SExpr::Un(u) => {
            if u.op == OP_NOT() { return "bool"; }
            return infer_ty_name(u.arg_expr(), t);
        }
        SExpr::Cond(c) => { return infer_ty_name(c.then_expr(), t); }
        _ => { return el_class_repr(infer_ty(e, t)); }
    }
}

/// The type the EMITTER MUST PRINT for `e` — its resolved Logos type when that
/// type is one the EL admits, and the class's representative otherwise.
///
/// ⚠ TWO QUESTIONS, AND THEY HAVE DIFFERENT DEFAULTS. `infer_ty_name` answers
/// "what type did the query give this expression", and an unresolvable answer must
/// stay unresolvable — the reorder LICENCE denies on it, which is right: nothing is
/// known about that type's order. This one answers "what do I write in the
/// generated source", and there the domain's documented LENIENT policy applies: an
/// unknown name is the lattice baseline, and the HOST COMPILER is the oracle for
/// whether the emitted push type-checks.
///
/// ⚠ MEASURED, and it is not a hypothetical. `ElTypes`' flat dict is keyed on the
/// field NAME, so two sources with a same-named field share one entry and the last
/// write wins: in wql_join_order_key_fidelity_e2e claim 6, `E.n: i64` and `F.n: P`
/// collide and `n` resolves to the STRUCT `P`. Printing that name emits
/// `Vec<P>::push(i64)`. The class view was masking the collision by flattening `P`
/// to the baseline; keeping the leniency HERE and the strictness at the licence
/// keeps both answers right while the flat dict remains imprecise — which is its
/// own arc, not this one.
///
/// ⚠ AN ARITHMETIC NODE IS NOT ITS OPERANDS' TYPE, whatever the query named it.
/// The EL's checked integer arithmetic is `el_add`/`el_sub`/… — i64 in, i64 out —
/// and `-x` is `el_neg`, so the type the emitter prints for such a node is the
/// class's REPRESENTATIVE and nothing else. `infer_ty_name` says `u64` for
/// `s.v + 1` because that is what the query named; the generated line is
/// `el_add(((s.v) as i64), (1i64))?` and its type is i64. Keeping the operands'
/// name here is what made `select s.v + 1` over a `u64` column emit
/// `Vec<u64>::push(i64)`.
pub fn infer_emit_ty(e: SExpr, t: &ElTypes) -> str {
    if el_computes_in_repr(e) { return el_class_repr(infer_ty(e, t)); }
    let n: str = infer_ty_name(e, t);
    if el_class_lookup(n) >= 0i32 { return n; }
    return el_class_repr(infer_ty(e, t));
}

/// True iff the EL emits `e` through its own computation type rather than
/// through the operands' declared types — the arithmetic nodes, whose emitted
/// form is a call into `el.logos`'s i64 tower (or an IEEE infix on the f64 one).
/// THE predicate behind both the element type above and the operand
/// normalization in `emit_sexpr_as`; a second spelling of "is this arithmetic"
/// at either site is a second thing to drift.
pub fn el_computes_in_repr(e: SExpr) -> bool {
    match e {
        SExpr::Bin(b) => {
            let op: i32 = b.op;
            return op == OP_ADD() || op == OP_SUB() || op == OP_MUL()
                || op == OP_DIV() || op == OP_MOD();
        }
        SExpr::Un(u) => { return u.op == OP_NEG(); }
        _ => { return false; }
    }
}

// The bare-identifier ROOT name of `e` — the name when `e` is a root-shaped
// leaf (a null-base SField — the EL parser's bare-ident node — or an SVar /
// SParam), "" otherwise. The rel-binding lookups key off this (a rel row var
// is always a direct scan binding, never a nested path).
pub fn root_ident_name(e: SExpr) -> str {
    match e {
        SExpr::Field(f) => {
            let br: WRef<SExpr> = f.base;
            if br.any().is_null() { return f.name; }
            return "";
        }
        SExpr::Var(v)   => { return v.name; }
        SExpr::Param(p) => { return p.name; }
        _ => { return ""; }
    }
}

/// THE DECLARED TYPE OF A FIELD STEP, or "" when nothing is bound for it.
///
/// One resolution for both the class view (`infer_ty`) and the printed name
/// (`infer_ty_name`) — they used to walk the same cases twice, which is how a
/// column could be one class here and a different type there.
///
/// Two keys, both of them BINDINGS and neither of them a bare spelling:
///
///   `a.n`    the ROW VAR and the column. A struct source and a rel source
///            stamp the same table, so `n` means A's `n` under `a` and B's
///            under `b` even when both declare one.
///   `a.b.c`  a nested path has NO row var — `root_ident_name` reports "" for a
///            field whose base is a field — so the base's own DECLARED TYPE is
///            the key: `a.b` is an `Inner`, and (`Inner`, `c`) is as precise a
///            key as (`a`, `n`). `reflect::stamp_schema_by_type` fills it.
pub fn field_ty_name(f: SField, t: &ElTypes) -> str {
    let base_ref: WRef<SExpr> = f.base;
    if base_ref.any().is_null() { return ""; }   // a BARE name, not a step
    let be: SExpr = f.base_expr();
    let rn: str = root_ident_name(be);
    if rn.len() > 0i64 { return t.rel_col_ty_name(rn, f.name); }
    let bt: str = infer_ty_name(be, t);
    if bt.len() == 0i64 { return ""; }
    return t.type_col_ty_name(bt, f.name);
}

// ── Tuple projections (`select (a, b, …)`) ─────────────────────────────────
// True iff `e`'s ROOT is a tuple expression — the multi-column projection form.
// A tuple is only meaningful as the `select` body; every other clause site
// rejects it via `reject_tuple`.
pub fn is_tuple_root(e: SExpr) -> bool {
    match e {
        SExpr::Tuple(_) => { return true; }
        _ => { return false; }
    }
}

// Diagnose a tuple expression at a NON-select clause site (`where`, `on`,
// `group by`, `having`, `order by`, aggregate args, `find`, trama contexts).
// Returns false + surfaces the error when `e` is tuple-rooted.
pub fn reject_tuple(e: SExpr, ctx: str) -> bool {
    if !is_tuple_root(e) { return true; }
    let mut m: String = String::new();
    m.push_str(ctx);
    m.push_str(": a tuple expression `(a, b, …)` is only supported as the `select` projection");
    error(string_as_str(&m));
    return false;
}

// Append the NATIVE Logos tuple TYPE text `(T1, T2, …)` of a tuple projection:
// per-component EL lattice type name, with the owned-String promotion for
// String-returning calls (a borrowed `str` view of the call's temporary would
// dangle) and recursion for nested tuples.
pub fn push_tuple_ty(out: &mut String, tp: STuple, t: &ElTypes) {
    let items: SExprArr = tp.items_arr();
    let n: i64 = items.len();
    out.push_str("(");
    let mut i: i64 = 0i64;
    while i < n {
        if i > 0i64 { out.push_str(", "); }
        let c: SExpr = items.arg_at(i);
        match c {
            SExpr::Tuple(nt) => { push_tuple_ty(out, nt, t); }
            _ => {
                if returns_string(c, t) { out.push_str("String"); }
                else { out.push_str(infer_emit_ty(c, t)); }
            }
        }
        i = i + 1i64;
    }
    out.push_str(")");
}

// True iff ANY component of the tuple projection is FLT-typed (f64) — tuple
// structural `==` routes through `variadic__eq`, which requires `Eq`; f64 is
// PartialEq only, so `distinct` over such a tuple is diagnosed (probe-verified).
pub fn tuple_has_flt(tp: STuple, t: &ElTypes) -> bool {
    let items: SExprArr = tp.items_arr();
    let n: i64 = items.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: SExpr = items.arg_at(i);
        match c {
            SExpr::Tuple(nt) => { if tuple_has_flt(nt, t) { return true; } }
            _ => { if infer_ty(c, t) == EL_TY_FLT() { return true; } }
        }
        i = i + 1i64;
    }
    return false;
}

// Walk the SExpr schema'd IR (`match` over the family enum), emitting a Logos
// expression into `out`:
//   • SLit (int/bool)            → the literal verbatim;
//   • SParam                     → the generated-fn argument name (node's name);
//   • a bare field-root (SField, base = null) → the field/loop-var NAME (the
//     row var, a `for` var, or a context field — resolved at the call site);
//   • a field STEP (SField, base ≠ null)      → `<base>.<name>`;
//   • SBin / SUn                 → parenthesised operator application.
// `t` is the type dictionary; `var` is a fallback name for a comprehension SVar.
pub fn emit_sexpr(out: &mut String, e: SExpr, t: &ElTypes, var: str) {
    emit_sexpr_as(out, e, t, var, "");
}

/// Emit the PROJECTION value of `e` — the thing the generated loop pushes into
/// the result vector. Identical to `emit_sexpr` except for one case: a `String`
/// value read out of a BORROWED row is COPIED (`.as_str().to_string()`).
///
/// ⚠ THE ROW IS A `&T`, SO A `String` FIELD CANNOT BE MOVED OUT OF IT. MEASURED:
/// `from src s select s.name` over `name: String` emitted `__out.push(s.name)`
/// and failed as `cannot move out of a value behind a reference (E0507)` inside a
/// generated chunk. The alternative — pushing a `str` VIEW of the field — is not
/// available: the view borrows the row var, whose binding ends with the loop body,
/// and the result vector outlives it (E0597, measured on the same shape).
///
/// ⚠ NOT APPLIED TO A String-RETURNING CALL, which already produces an owned
/// temporary — `returns_string` is that case and copying it again would be a
/// second allocation for nothing.
pub fn emit_proj_value(out: &mut String, e: SExpr, t: &ElTypes, var: str) {
    if el_owned_copy_needed(e, t) {
        out.push_str("(");
        emit_sexpr(out, e, t, var);
        out.push_str(").as_str().to_string()");
        return;
    }
    emit_sexpr(out, e, t, var);
}

/// True iff `e`'s emitted value is a `String` the generated code does not own.
pub fn el_owned_copy_needed(e: SExpr, t: &ElTypes) -> bool {
    return str_eq(infer_emit_ty(e, t), "String") && !returns_string(e, t);
}

/// One operand of an arithmetic node must reach the EL's checked i64 tower, and
/// the cast that takes it there is the SAME `as i64` a UDF result gets — so it is
/// refused by the same fact, `ElTy.fits`, and gets the same ground.
///
/// ⚠ ASKED OF THE OPERAND'S NAMED TYPE (`infer_ty_name`), because the question is
/// about the VALUE the query put there. A nested arithmetic node or a UDF call has
/// already been normalized at its own site and answers `i64` here, so the check
/// lands exactly once, on the leaf that carries a width.
///
/// Non-arithmetic nodes are not operands of anything and pass unconditionally: a
/// `u64` column may be COMPARED (`s.v > 100u64` is emitted in u64 and is exact),
/// projected, sorted by and grouped by — the tower is the only place the value has
/// to become an i64.
pub fn check_arith_operand(parent: SExpr, e: SExpr, t: &ElTypes, ctx: str) -> bool {
    if !el_computes_in_repr(parent) { return true; }
    if infer_ty(parent, t) != EL_TY_INT() { return true; }
    let n: str = infer_ty_name(e, t);
    if el_arith_ok(n) { return true; }
    let mut m: String = String::new();
    m.push_str(ctx);
    m.push_str(": arithmetic over a value of type `");
    m.push_str(n);
    m.push_str("` — the EL's checked arithmetic (`el_add`/`el_sub`/…) computes in i64, and this type's values do not survive the normalization into it — ");
    m.push_str(el_order_why(n));
    error(string_as_str(&m));
    return false;
}

/// THE AGGREGATE ARGUMENT IS THE FIFTH EL OPERAND POSITION, and it is the one
/// that implements NEITHER half of the lattice's three-outcome rule. The other
/// four — arithmetic operands (`check_arith_operand` + `emit_norm_operand`), UDF
/// results (`check_calls` + `emit_udf_call`), sort keys (`key_norm_ok` +
/// `key_ord_frag`) and UDA finalizers (`uda_fin_cast`) — each normalize what
/// survives and refuse what does not. `compute_agg_bodies` prints the argument
/// VERBATIM into `let __v: i64 = …` / `el_add(acc, …)` / `acc + …`, so the host
/// compiler is the only thing that ever checked it.
///
/// ⚠ WHAT THIS REPLACES IS NOT A WEAKER CHECK, IT IS NO CHECK. MEASURED at the
/// parent commit, `aggregate t = sum(s.v)` over an `f32` column:
///   <metaprog-blob-subst>:3935: error [fn q_run]: operator '+':
///     type mismatch (f64 vs f32)
/// — a generated line, naming neither the column, nor the aggregate, nor the
/// reason. `u64`/`usize`/`u128`/`i128` produced `call to 'el_add' arg 2:
/// expected i64, got u64` at the same seam, and `isize` — a type whose values
/// the lattice admits into i64 without moving one — produced it too.
///
/// ⚠ IT ASKS `infer_emit_ty`, THE SAME QUESTION `emit_norm_operand` ASKS, and
/// not `infer_ty_name`: the fact needed here is what the emitted TEXT's type is,
/// and a nested arithmetic node has already normalized at its own site. Asking
/// the query's name instead would refuse `sum(s.a + s.b)` over two f32 columns —
/// which compiles today and answers in f64, because the arithmetic seam does its
/// half of the rule.
///
/// ⚠ THIS REFUSES; IT DOES NOT NORMALIZE. Emitting `el_norm_cast`'s conversion
/// here would ADMIT `f32` and `isize` aggregates, which is a change to what the
/// language accepts and belongs to Victor, not to this check. The message says
/// so, so that the restriction is legible as this position's rather than the
/// type's.
///
/// `want` is the accumulator's type (`i64` / `f64`), `fname` the aggregate's
/// name. NOT called for a UDA (its argument goes to a user `_step` whose
/// declared T is the contract) nor for the `avg`-over-an-int form (whose emitter
/// writes the `as f64` itself).
pub fn check_agg_operand(e: SExpr, t: &ElTypes, want: str, fname: str, ctx: str) -> bool {
    let et: str = infer_emit_ty(e, t);
    let ty: ElTy = el_ty(et);
    // Lenient on an out-of-lattice name, exactly as `el_arith_ok` is: nothing is
    // known about it, and the host compiler is the documented oracle there.
    if ty.cls < 0i32 { return true; }
    if el_host_carries(et, want) { return true; }
    let mut m: String = String::new();
    m.push_str(ctx);
    m.push_str(": `");
    m.push_str(fname);
    m.push_str("` over a value of type `");
    m.push_str(et);
    m.push_str("` — the aggregate accumulates in `");
    m.push_str(want);
    m.push_str("` and the argument is emitted into that accumulator VERBATIM, with no normalizing conversion — ");
    if ty.cls != EL_TY_INT() && ty.cls != EL_TY_FLT() {
        m.push_str("and this type is not numeric, so there is no conversion into the accumulator at all. The remedy is a numeric argument");
    } else if !ty.fits {
        // The SHARED ground, rendered once for all three sites that normalize
        // into the i64 tower (arithmetic operand, UDF result, aggregate
        // argument). A second copy of those sentences is a second thing to drift.
        m.push_str(el_order_why(et));
    } else {
        m.push_str("every value of `");
        m.push_str(et);
        m.push_str("` DOES survive the normalization into `");
        m.push_str(want);
        m.push_str("` (`el_norm_cast` gives `as ");
        m.push_str(want);
        m.push_str("`), and the arithmetic operands, the sort keys and the UDF results all apply it — this emit position does not. So the restriction is this position's, not the type's. The remedy is a column of type `");
        m.push_str(want);
        m.push_str("`, or an argument expression that already computes in `");
        m.push_str(want);
        m.push_str("`");
    }
    error(string_as_str(&m));
    return false;
}

/// Emit one operand of an arithmetic node into the EL's computation type `want`
/// (`i64` / `f64`), parenthesized, with the normalizing cast when the operand's
/// EMITTED type is not already that type.
///
/// ⚠ IT ASKS `infer_emit_ty`, NOT `infer_ty_name` — what the sub-expression's
/// generated text ACTUALLY has, which for a nested arithmetic node or a UDF call
/// is already the representative (both normalize at their own site) and for a
/// column read is the column's declared type. Asking the query's name here would
/// have wrapped an already-normalized call in a second, redundant cast.
pub fn emit_norm_operand(out: &mut String, e: SExpr, t: &ElTypes, var: str, want: str) {
    let et: str = infer_emit_ty(e, t);
    let ec: i32 = el_class_lookup(et);
    let wc: i32 = el_class_lookup(want);
    let numeric: bool = (ec == EL_TY_INT() || ec == EL_TY_FLT())
                     && (wc == EL_TY_INT() || wc == EL_TY_FLT());
    let need: bool = !str_eq(et, want) && numeric;
    out.push_str("(");
    if need { out.push_str("("); }
    emit_sexpr_as(out, e, t, var, want);
    if need { out.push_str(") as "); out.push_str(want); }
    out.push_str(")");
}

/// `emit_sexpr` with an EXPECTED type for integer literals (ADR 0024 S3).
///
/// A literal has no type of its own — it takes one from its context, exactly as
/// it does in Logos. `e.val > 100` over a `u64` column must print `100u64`;
/// printing `100i64` is how a widened column met `operator '>': type mismatch`.
/// `want` is advisory: it applies only to an integer literal, and only when it
/// names an integer type.
/// The emitted float TYPE NAME of `e` — `f32` when that is what its generated
/// text has, `f64` otherwise. The target of the int→float promotion beside it.
fn float_side_ty(e: SExpr, t: &ElTypes) -> str {
    let n: str = infer_emit_ty(e, t);
    if str_eq(n, "f32") { return "f32"; }
    return "f64";
}

pub fn emit_sexpr_as(out: &mut String, e: SExpr, t: &ElTypes, var: str, want: str) {
    match e {
        SExpr::Lit(l) => {
            let v: WAny = l.val;
            if v.is_string() {
                // A boxed WString literal → a Logos string literal "…" (escaped).
                out.push_str("\"");
                emit_str_escaped(out, v.as_wstr());
                out.push_str("\"");
            } else if v.is_bool() {
                if v.as_bool() { out.push_str("true"); } else { out.push_str("false"); }
            } else if v.is_float() {
                // A float literal → a Logos float literal (`2.5f64` / `2.5f32`):
                // the shortest round-trip decimal, forced to carry a `.` so it
                // parses as float, with the SUFFIX taken from the context.
                //
                // ⚠ THE CONTEXT RULE APPLIES TO BOTH LITERAL KINDS. This branch
                // used to hardcode `f64` while the integer branch below already
                // honoured `want` — the same fact ("a literal has no type of its
                // own; it takes one from its context") implemented once and
                // forgotten once. Over an `f32` column, `where s.k < 2.5`
                // therefore emitted `(s.k) < (2.5f64)` and the host compiler
                // answered `operator '<': type mismatch (f32 vs f64)` INSIDE the
                // generated chunk — a diagnostic pointing at a line nobody wrote.
                if want.len() > 0i64 && el_ret_class(want) == EL_TY_FLT() {
                    push_float_lit(out, v.as_f64(), want);
                } else {
                    push_float_lit(out, v.as_f64(), "f64");
                }
            } else {
                out.push_i64(v.as_i64());
                if want.len() > 0i64 && el_ret_class(want) == EL_TY_INT() {
                    out.push_str(want);
                } else {
                    out.push_str("i64");
                }
            }
        }
        SExpr::Param(pp) => {
            out.push_str(pp.name);
        }
        SExpr::Var(vv) => {
            // A comprehension-bound row variable: emit its own name, falling back
            // to the caller's `var` (the wql!/trama! row/loop binding) if empty.
            let nm: str = vv.name;
            if nm.len() > 0i64 { out.push_str(nm); } else { out.push_str(var); }
        }
        SExpr::Field(f) => {
            let name: str = f.name;
            let base_ref: WRef<SExpr> = f.base;
            let base: WAny = base_ref.any();
            let is_root: bool = base.is_null();
            if is_root {
                out.push_str(name);
            } else {
                let be: SExpr = f.base_expr();
                // Rel-sourced column: `s.a` over a rel-bound row var emits the
                // POSITIONAL tuple access `s.0` (the rel row is a native tuple;
                // the column map lives in the ElTypes rel-binding table). A
                // 1-COLUMN rel stores SCALAR rows — its (only) column reads the
                // whole row through the binding: `(*s)`.
                let rn: str = root_ident_name(be);
                if rn.len() > 0i64 {
                    if t.rel_col_ty(rn, name) >= 0i32 {
                        let k: i64 = t.rel_col_of(rn, name);
                        if k >= 0i64 {
                            out.push_str(rn);
                            out.push_str(".");
                            out.push_i64(k);
                            return;
                        }
                        if k == COL_WHOLE() {
                            out.push_str("(*");
                            out.push_str(rn);
                            out.push_str(")");
                            return;
                        }
                        // COL_FIELD — a STRUCT source's column. The binding is
                        // what TYPED it; the access is the ordinary named field
                        // step, so fall through to the generic emission below
                        // rather than duplicate it here.
                    }
                }
                emit_sexpr(out, be, t, var);
                out.push_str(".");
                out.push_str(name);
            }
        }
        SExpr::Bin(b) => {
            let op: i32 = b.op;
            let lhs: SExpr = b.lhs_expr();
            let rhs: SExpr = b.rhs_expr();
            // INT→FLT promotion: Logos has NO implicit int→float, so when one
            // operand is FLT and the other INT (arithmetic OR comparison), the
            // INT side gets an explicit `as f64` cast so the emitted source
            // type-checks. Logical ops never mix (both sides BOOL).
            let lt: i32 = infer_ty(lhs, t);
            let rt: i32 = infer_ty(rhs, t);
            // ERROR-RETURNING integer arithmetic (EL-script policy): an INT-typed
            // +,-,*,/,% emits a CHECKED call `el_op((L), (R))?` — an overflow or a
            // division/remainder by zero becomes a returned `ElError` propagated to
            // the generated fn's `Result` return, never a host trap. Result is INT
            // iff arithmetic op with neither operand FLT and (for +) neither STR
            // (string concat stays infix); FLT arithmetic is IEEE (infix, no trap).
            let is_arith: bool = op == OP_ADD() || op == OP_SUB() || op == OP_MUL()
                              || op == OP_DIV() || op == OP_MOD();
            let res_int: bool = is_arith && lt != EL_TY_FLT() && rt != EL_TY_FLT()
                && !(op == OP_ADD() && (lt == EL_TY_STR() || rt == EL_TY_STR()));
            // Each operand's literal takes the OTHER side's declared type: a
            // comparison or arithmetic between a column and a literal is where
            // the width actually matters, and the column is the side that has
            // a type to give.
            let want_l: str = infer_ty_name(rhs, t);
            let want_r: str = infer_ty_name(lhs, t);
            if res_int {
                // ⚠ THE OPERANDS OF THE CHECKED TOWER ARE i64, NOT THE COLUMN'S
                // TYPE. `el_add` takes i64, so a `u32` column reaches it through
                // the SAME normalization the call site applies, and a literal
                // beside it takes i64 rather than the column's spelling. Without
                // this the emitted line was `el_add((s.w), (1u32))` and the host
                // compiler reported an arg-1 mismatch in a generated chunk. The
                // types whose normalization does NOT preserve the value are
                // refused upstream (`check_calls` → `el_arith_ok`), so the cast
                // here is only ever applied where it is value-preserving.
                let ir: str = el_class_repr(EL_TY_INT());
                out.push_str(el_int_op_fn(op));
                out.push_str("(");
                emit_norm_operand(out, lhs, t, var, ir);
                out.push_str(", ");
                emit_norm_operand(out, rhs, t, var, ir);
                out.push_str(")?");
                return;
            }
            // FLOAT arithmetic is IEEE infix and computes in the class's
            // representative too, so an `f32` operand is widened exactly once,
            // here — `f32 * 2.5f64` does not type-check and never did.
            if is_arith && (lt == EL_TY_FLT() || rt == EL_TY_FLT()) {
                let fr: str = el_class_repr(EL_TY_FLT());
                out.push_str("(");
                emit_norm_operand(out, lhs, t, var, fr);
                out.push_str(emit_binop(op));
                emit_norm_operand(out, rhs, t, var, fr);
                out.push_str(")");
                return;
            }
            let cast_l: bool = lt == EL_TY_INT() && rt == EL_TY_FLT();
            let cast_r: bool = rt == EL_TY_INT() && lt == EL_TY_FLT();
            // The cast's TARGET is the float side's own emitted type — an `f32`
            // column compared against an integer is met at f32, not at f64.
            let ft_l: str = float_side_ty(rhs, t);
            let ft_r: str = float_side_ty(lhs, t);
            out.push_str("(");
            if cast_l { out.push_str("(("); }
            emit_sexpr_as(out, lhs, t, var, want_l);
            if cast_l { out.push_str(") as "); out.push_str(ft_l); out.push_str(")"); }
            out.push_str(emit_binop(op));
            if cast_r { out.push_str("(("); }
            emit_sexpr_as(out, rhs, t, var, want_r);
            if cast_r { out.push_str(") as "); out.push_str(ft_r); out.push_str(")"); }
            out.push_str(")");
        }
        SExpr::Un(u) => {
            let op: i32 = u.op;
            let arg: SExpr = u.arg_expr();
            // Error-returning unary minus on INT: `el_neg((arg))?` (i64::MIN
            // negation is an Overflow error, not a trap). `!` and FLT negation
            // stay infix (bool / IEEE, no trap).
            if op == OP_NEG() && infer_ty(arg, t) == EL_TY_INT() {
                out.push_str("el_neg(");
                emit_norm_operand(out, arg, t, var, el_class_repr(EL_TY_INT()));
                out.push_str(")?");
                return;
            }
            out.push_str("(");
            if op == OP_NOT() { out.push_str("!"); } else { out.push_str("-"); }
            emit_sexpr(out, arg, t, var);
            out.push_str(")");
        }
        SExpr::Call(c) => { emit_call(out, c, t, var); }
        SExpr::Cond(c) => {
            // ternary `cond ? then : else` → Logos `if` EXPRESSION.
            out.push_str("(if (");
            emit_sexpr(out, c.cond_expr(), t, var);
            out.push_str(") { ");
            emit_sexpr(out, c.then_expr(), t, var);
            out.push_str(" } else { ");
            emit_sexpr(out, c.else_expr(), t, var);
            out.push_str(" })");
        }
        SExpr::Comp(cp) => { emit_comp(out, cp, t, var); }
        SExpr::Tuple(tp) => {
            // Native tuple literal `(c0, c1, …)` — the multi-column projection.
            let items: SExprArr = tp.items_arr();
            let n: i64 = items.len();
            out.push_str("(");
            let mut i: i64 = 0i64;
            while i < n {
                if i > 0i64 { out.push_str(", "); }
                // A tuple is legal ONLY as the select projection (`reject_tuple`
                // guards every other clause), so its components are projection
                // values and a borrowed `String` component is copied here too —
                // `push_tuple_ty` already prints `String` for them.
                emit_proj_value(out, items.arg_at(i), t, var);
                i = i + 1i64;
            }
            out.push_str(")");
        }
        _ => {
            out.push_str("0i64");
        }
    }
}

// Emit a builtin call. `c` is the SCall; the call NAME is read off the node
// (`c.fn_name`) and mapped to a builtin id (`builtin_of_name`). Each builtin
// emits a fully-qualified stdlib call over its materialized args (`SExprArr`).
// An unknown name or wrong arity emits a `0i64` placeholder (the wql!/trama!
// handler reports the error at the block site via `call_diagnostic`).
pub fn emit_call(out: &mut String, c: SCall, t: &ElTypes, var: str) {
    let name: str = c.fn_name;
    let bfn: i32 = builtin_of_name(name);
    let args: SExprArr = c.args_arr();
    let argc: i64 = args.len();
    if bfn == BFN_UNKNOWN() {
        // Not a builtin → a UDF candidate (the reflected user-fn table).
        emit_udf_call(out, name, args, argc, t, var);
        return;
    }
    if argc != builtin_arity(bfn) {
        out.push_str("0i64");
        return;
    }
    if bfn == BFN_LEN() {
        out.push_str("((");
        emit_sexpr(out, args.arg_at(0i64), t, var);
        out.push_str(").len())");
        return;
    }
    if bfn == BFN_UPPER() || bfn == BFN_LOWER() {
        if bfn == BFN_UPPER() { out.push_str("logos.std.wql.el::wql_upper("); }
        else                  { out.push_str("logos.std.wql.el::wql_lower("); }
        emit_sexpr(out, args.arg_at(0i64), t, var);
        out.push_str(")");
        return;
    }
    // contains / starts_with : two str args → bool.
    if bfn == BFN_CONTAINS() { out.push_str("logos.lang.str::str_contains("); }
    else                     { out.push_str("logos.lang.str::str_starts_with("); }
    out.push_str("(");
    emit_sexpr(out, args.arg_at(0i64), t, var);
    out.push_str("), (");
    emit_sexpr(out, args.arg_at(1i64), t, var);
    out.push_str("))");
}

// Emit a USER-FUNCTION call as a PLAIN call `name(<args>)` — the generated
// chunk lives in the trigger module's package, so the name resolves naturally
// against the module's own top-level fns; NON-pub fns work too (verified: the
// spliced chunk shares the trigger package's visibility scope), so no `pub`
// gate is imposed on the reflection lookup. UDF ground rules:
//   • BUILTINS take precedence over a same-named user fn (lookup order);
//   • only ARITY + return type are checked at metacall time — PARAM types are
//     NOT deep-checked here: the emitted chunk is compiled by the real
//     compiler, so an argument-type mismatch still fails the build (with the
//     compiler's own arg-type diagnostic against the generated call);
//   • only the TRIGGER module's top-level fns are visible (oview_module_ast
//     scope) — imported fns diagnose as unknown (documented MVP limit).
// Two return-normalization casts keep the emitted expression in the EL
// lattice baseline (the surrounding expression / result Vec is typed
// i64 / f64):
//   • an INT-family return NARROWER than i64 (i32/u32/…): `((f(x)) as i64)`.
//     ⚠ Only widths that SURVIVE that cast reach here: `check_calls` refuses a
//     u64/usize/u128/i128 return at the use site (`el_int_fits_i64`), so this
//     cast is always value-preserving and no longer has "documented MVP
//     truncation" hiding behind it;
//   • an `f32` return:                                    `((f(x)) as f64)`.
// str / bool / String / f64 / i64 returns emit bare. Unknown names, arity
// mismatches, and out-of-lattice returns emit the safe `0i64` placeholder —
// the handler surfaces the REAL diagnostic via `check_calls` beforehand.
fn emit_udf_call(out: &mut String, name: str, args: SExprArr, argc: i64,
                 t: &ElTypes, var: str) {
    let ui: i64 = t.udf_find(name);
    if ui < 0i64 || argc != t.udf_arity[ui] || t.udf_ret[ui] < 0i32 {
        out.push_str("0i64");
        return;
    }
    // THE NORMALIZATION, asked of the type rather than spelled out here: a value
    // is cast exactly when its type is not the type the EL computes in
    // (`el_norm_cast` — `ElTy.canon` / `ElTy.repr`). The two hand-written tests
    // this replaces ("INT and not `i64`", "FLT and `f32`") were the same rule
    // enumerated, and `rexpr_walk::uda_fin_cast` held a second copy of it.
    let rn: str = t.udf_rets[ui];
    let cast: str = el_norm_cast(rn);
    if cast.len() > 0i64 { out.push_str("(("); }
    out.push_str(name);
    out.push_str("(");
    let mut i: i64 = 0i64;
    while i < argc {
        if i > 0i64 { out.push_str(", "); }
        emit_sexpr(out, args.arg_at(i), t, var);
        i = i + 1i64;
    }
    out.push_str(")");
    if cast.len() > 0i64 {
        out.push_str(") as ");
        out.push_str(cast);
        out.push_str(")");
    }
}

// True iff `e` is (or contains at its root) a call to an unknown function or one
// with the wrong arity — the wql!/trama! handlers use this to surface a compile
// error at the block site (the codegen itself emits a safe `0i64` placeholder).
// UDF-aware: a non-builtin name resolving in the reflected user-fn table with
// matching arity and an in-lattice return is NOT diagnostic. Prefer
// `check_calls` at handler level — it names the offending fn in the error.
pub fn call_diagnostic(e: SExpr, t: &ElTypes) -> bool {
    match e {
        SExpr::Call(c) => {
            let bfn: i32 = builtin_of_name(c.fn_name);
            let args: SExprArr = c.args_arr();
            if bfn == BFN_UNKNOWN() {
                let ui: i64 = t.udf_find(c.fn_name);
                if ui < 0i64 { return true; }
                if args.len() != t.udf_arity[ui] { return true; }
                if t.udf_ret[ui] < 0i32 { return true; }
            } else {
                if args.len() != builtin_arity(bfn) { return true; }
            }
            let mut i: i64 = 0i64;
            while i < args.len() {
                if call_diagnostic(args.arg_at(i), t) { return true; }
                i = i + 1i64;
            }
            return false;
        }
        SExpr::Bin(b)  => { return call_diagnostic(b.lhs_expr(), t) || call_diagnostic(b.rhs_expr(), t); }
        SExpr::Un(u)   => { return call_diagnostic(u.arg_expr(), t); }
        SExpr::Cond(c) => {
            return call_diagnostic(c.cond_expr(), t)
                || call_diagnostic(c.then_expr(), t)
                || call_diagnostic(c.else_expr(), t);
        }
        SExpr::Comp(cp) => { return call_diagnostic(cp.head_expr(), t); }
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let mut i: i64 = 0i64;
            while i < items.len() {
                if call_diagnostic(items.arg_at(i), t) { return true; }
                i = i + 1i64;
            }
            return false;
        }
        _ => { return false; }
    }
}

// Validate every call in `e` and surface a NAMED diagnostic on the first
// offense (unknown fn / wrong arity / out-of-lattice UDF return). `ctx`
// prefixes the message with the macro + clause site (e.g. "wql!: `where`").
// Returns false when an error was reported (the handler aborts emission).
// The message spells the UDF ground rules: builtin list, the declared-in-the-
// trigger-module requirement (imported fns are outside `oview_module_ast`'s
// reach), and — on arity — the expected/got counts.
pub fn check_calls(e: SExpr, t: &ElTypes, ctx: str) -> bool {
    match e {
        SExpr::Call(c) => {
            let name: str = c.fn_name;
            let bfn: i32 = builtin_of_name(name);
            let args: SExprArr = c.args_arr();
            let argc: i64 = args.len();
            if bfn == BFN_UNKNOWN() {
                let ui: i64 = t.udf_find(name);
                if ui < 0i64 {
                    let mut m: String = String::new();
                    m.push_str(ctx);
                    m.push_str(": unknown function '");
                    m.push_str(name);
                    m.push_str("' — EL builtins are len/upper/lower/contains/starts_with; a user function must be a top-level fn declared in the module containing the query (imported fns are not visible to reflection)");
                    error(string_as_str(&m));
                    return false;
                }
                if argc != t.udf_arity[ui] {
                    let mut m2: String = String::new();
                    m2.push_str(ctx);
                    m2.push_str(": function '");
                    m2.push_str(name);
                    m2.push_str("' expects ");
                    m2.push_i64(t.udf_arity[ui]);
                    m2.push_str(" argument(s), got ");
                    m2.push_i64(argc);
                    error(string_as_str(&m2));
                    return false;
                }
                if t.udf_ret[ui] < 0i32 {
                    let mut m3: String = String::new();
                    m3.push_str(ctx);
                    m3.push_str(": user function '");
                    m3.push_str(name);
                    m3.push_str("' returns `");
                    m3.push_str(t.udf_rets[ui]);
                    m3.push_str("` — an EL-callable fn must return an integer, f64/f32, bool, str, or String value");
                    error(string_as_str(&m3));
                    return false;
                }
                // THE WIDTH, which the class does not carry. An INT-family return
                // is normalized to the lattice baseline with `as i64` at the emit
                // site (`emit_udf_call`), and for u64/usize/u128/i128 that cast
                // REINTERPRETS or TRUNCATES: the number the fn returned is not the
                // number the query goes on to use. This used to be a sentence in a
                // doc comment ("documented MVP semantics") and a silently wrong
                // row — measured as an `order by` that ranked 2^63 below 0.
                //
                // ⚠ REFUSED HERE AND NOT AT THE SORT, because the normalization is
                // not the sort's: the same cast feeds `select`, `where`, `group by`
                // and an aggregate argument, and each of them would need its own
                // copy of this check. One use-site refusal closes all of them.
                if t.udf_ret[ui] == EL_TY_INT() && !el_int_fits_i64(t.udf_rets[ui]) {
                    let mut m5: String = String::new();
                    m5.push_str(ctx);
                    m5.push_str(": user function '");
                    m5.push_str(name);
                    m5.push_str("' returns `");
                    m5.push_str(t.udf_rets[ui]);
                    m5.push_str("`, whose values do not survive the EL's i64 normalization — ");
                    m5.push_str(el_order_why(t.udf_rets[ui]));
                    error(string_as_str(&m5));
                    return false;
                }
            } else {
                if argc != builtin_arity(bfn) {
                    let mut m4: String = String::new();
                    m4.push_str(ctx);
                    m4.push_str(": builtin '");
                    m4.push_str(name);
                    m4.push_str("' expects ");
                    m4.push_i64(builtin_arity(bfn));
                    m4.push_str(" argument(s), got ");
                    m4.push_i64(argc);
                    error(string_as_str(&m4));
                    return false;
                }
            }
            let mut i: i64 = 0i64;
            while i < argc {
                if !check_calls(args.arg_at(i), t, ctx) { return false; }
                i = i + 1i64;
            }
            return true;
        }
        SExpr::Bin(b)  => {
            if !check_arith_operand(e, b.lhs_expr(), t, ctx) { return false; }
            if !check_arith_operand(e, b.rhs_expr(), t, ctx) { return false; }
            return check_calls(b.lhs_expr(), t, ctx) && check_calls(b.rhs_expr(), t, ctx);
        }
        SExpr::Un(u)   => {
            if !check_arith_operand(e, u.arg_expr(), t, ctx) { return false; }
            return check_calls(u.arg_expr(), t, ctx);
        }
        SExpr::Cond(c) => {
            return check_calls(c.cond_expr(), t, ctx)
                && check_calls(c.then_expr(), t, ctx)
                && check_calls(c.else_expr(), t, ctx);
        }
        SExpr::Comp(cp) => { return check_calls(cp.head_expr(), t, ctx); }
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let mut i: i64 = 0i64;
            while i < items.len() {
                if !check_calls(items.arg_at(i), t, ctx) { return false; }
                i = i + 1i64;
            }
            return true;
        }
        SExpr::Lit(l) => {
            // Out-of-range integer literal: the tokenizer poisoned it to i64::MIN
            // (unrepresentable by a valid non-negative decimal token). Surface a
            // clean COMPILE error here — the one IR walk that already reports
            // per-clause diagnostics — instead of clamping or trapping.
            let v: WAny = l.val;
            if !v.is_string() && !v.is_bool() && !v.is_float() {
                if v.as_i64() == el_lit_poison() {
                    let mut m: String = String::new();
                    m.push_str(ctx);
                    m.push_str(": integer literal out of range — exceeds i64::MAX (9223372036854775807)");
                    error(string_as_str(&m));
                    return false;
                }
            }
            return true;
        }
        _ => { return true; }
    }
}


// Append `v` as a LOGOS f64 LITERAL (`2.5f64`): the shortest round-trip decimal
// (%g), forced to carry a `.0` when it prints as a bare integer (e.g. `2` →
// `2.0`) so the emitted token is unambiguously float-shaped, plus the `f64`
// suffix. `%g` may print an exponent form (`1e+20`) — a valid Logos float
// literal shape as well.
fn push_f64_lit(out: &mut String, v: f64) { push_float_lit(out, v, "f64"); }

fn push_float_lit(out: &mut String, v: f64, suffix: str) {
    let s: String = v.to_string();
    let sv: str = string_as_str(&s);
    out.push_str(sv);
    // Bare-integer print (no '.', no exponent) → force the decimal point.
    let n: i64 = sv.len();
    let mut has_mark: bool = false;
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(sv, i);
        if c == 46u8 || c == 101u8 || c == 69u8 || c == 110u8 { has_mark = true; }  // . e E n(an/inf)
        i = i + 1i64;
    }
    if !has_mark { out.push_str(".0"); }
    out.push_str(suffix);
}

// Emit a comprehension `[head for v in src (if guard)?]` as a Logos BLOCK
// EXPRESSION yielding a `Vec<HeadTy>` (ADR 0012 §10.4 — a Source-driven loop
// collecting into a Vec, NOT the stdlib list-comprehension desugar). The plan is
// `RScan(src)` or `RFilter(RScan(src), guard)`; the source resolves to a `&[_]`
// parameter (its name off the RScan). The loop var binds each element by value;
// `head`/`guard` reference it via bare field-roots (emitted by name).
//
//   ({ let mut __cv: Vec<T> = Vec::<T>::new();
//      let mut __ci: i64 = 0i64;
//      while __ci < (SRC).len() {
//          let V = (SRC)[__ci];
//          if GUARD { __cv.push(HEAD); }     // guard omitted when absent
//          __ci = __ci + 1i64;
//      }
//      __cv })
pub fn emit_comp(out: &mut String, cp: SComp, t: &ElTypes, var: str) {
    let head: SExpr = cp.head_expr();
    // A tuple comprehension head is out of the scalar comprehension lattice
    // (Vec<HeadTy> is typed off EL_TY_*) — clean diagnostic, not a broken chunk.
    if !reject_tuple(head, "wql!/trama!: comprehension head") { out.push_str("0i64"); return; }
    let plan: RExpr = cp.plan_expr();
    // Decompose the plan into (scan, optional guard).
    let mut src_name: str = "";
    let mut has_guard: bool = false;
    match plan {
        RExpr::Scan(sc) => { src_name = sc.src_name; }
        RExpr::Filter(fl) => {
            has_guard = true;
            match fl.input_expr() {
                RExpr::Scan(sc2) => { src_name = sc2.src_name; }
                _ => { }
            }
        }
        _ => { }
    }
    let head_ty: str = el_class_repr(infer_ty(head, t));
    // The comprehension var name — off the SComp node (self-describing IR).
    let vname: str = cp.var;

    out.push_str("({ let mut __cv: Vec<");
    out.push_str(head_ty);
    out.push_str("> = Vec::<");
    out.push_str(head_ty);
    out.push_str(">::new(); let mut __ci: i64 = 0i64; while __ci < (");
    out.push_str(src_name);
    out.push_str(").len() { let ");
    out.push_str(vname);
    // Bind the element BY VALUE — the comprehension scalar lattice (i64/str/bool)
    // is Copy, so `head`/`guard` over the loop var get the element directly (and
    // a `Vec<T>` push takes `T`, not `&T`).
    out.push_str(" = (");
    out.push_str(src_name);
    out.push_str(")[__ci]; ");
    if has_guard {
        match plan {
            RExpr::Filter(fl2) => {
                out.push_str("if (");
                emit_sexpr(out, fl2.pred_expr(), t, var);
                out.push_str(") { __cv.push(");
                emit_sexpr(out, head, t, var);
                out.push_str("); } ");
            }
            _ => { }
        }
    } else {
        out.push_str("__cv.push(");
        emit_sexpr(out, head, t, var);
        out.push_str("); ");
    }
    out.push_str("__ci = __ci + 1i64; } __cv })");
}

// Emit an expression in BOOLEAN (condition) context, coercing a non-bool value
// to a `bool` the way a dynamic template language treats "truthiness" (Trama
// `{% if %}` / `{% elif %}`). A Logos `if` demands a `bool`, but a template
// author writes `{% if count %}` / `{% if name %}` expecting the jinja rule:
//   • BOOL expr  → emitted verbatim (already a condition);
//   • INT  expr  → `((e) != 0i64)`  (non-zero is truthy);
//   • STR  expr  → `((e).len() != 0i64)` (non-empty is truthy).
// The value-type is the codegen `infer_ty` (schema-reflected fields included), so
// `{% if c.flag %}` over a `bool` field stays bare while `{% if c.n %}` over an
// `i64` field gets the `!= 0` guard — no annotation needed.
pub fn emit_truthy(out: &mut String, e: SExpr, t: &ElTypes, var: str) {
    let ty: i32 = infer_ty(e, t);
    if ty == EL_TY_BOOL() {
        emit_sexpr(out, e, t, var);
        return;
    }
    if ty == EL_TY_STR() {
        out.push_str("((");
        emit_sexpr(out, e, t, var);
        out.push_str(").len() != 0i64)");
        return;
    }
    if ty == EL_TY_FLT() {
        // FLT: non-zero is truthy (typed 0.0 comparison — no implicit int→float).
        out.push_str("((");
        emit_sexpr(out, e, t, var);
        out.push_str(") != 0.0f64)");
        return;
    }
    // INT (the numeric baseline): non-zero is truthy.
    out.push_str("((");
    emit_sexpr(out, e, t, var);
    out.push_str(") != 0i64)");
}

// SBin arithmetic op id → the error-returning i64 checked-op fn NAME (logos.std
// .wql.el, which every emitting quote imports as `use logos.std.wql.el;` — so
// the name is written BARE here). Emitted as `el_op((L),(R))?` so a math
// fault propagates to the generated fn's Result. Only the arithmetic ops map;
// callers gate on `is_arith` first.
pub fn el_int_op_fn(op: i32) -> str {
    if op == OP_ADD() { return "el_add"; }
    if op == OP_SUB() { return "el_sub"; }
    if op == OP_MUL() { return "el_mul"; }
    if op == OP_DIV() { return "el_div"; }
    return "el_rem";
}

// SBin op id (el.logos CEL canon) → Logos infix operator text (spaces padded).
pub fn emit_binop(op: i32) -> str {
    if op == OP_OR()  { return " || "; }
    if op == OP_AND() { return " && "; }
    if op == OP_EQ()  { return " == "; }
    if op == OP_NE()  { return " != "; }
    if op == OP_LT()  { return " < "; }
    if op == OP_LE()  { return " <= "; }
    if op == OP_GT()  { return " > "; }
    if op == OP_GE()  { return " >= "; }
    if op == OP_ADD() { return " + "; }
    if op == OP_SUB() { return " - "; }
    if op == OP_MUL() { return " * "; }
    if op == OP_DIV() { return " / "; }
    return " % ";
}

// Borrow a `String`'s bytes as a `str` view (valid while the String is alive
// and unmodified). Shared spelling for the emit handlers.
pub fn string_as_str(s: &String) -> str {
    return unsafe { str_from_raw(s.as_ptr(), s.len()) };
}

// Escape a `str` into the body of a Logos string literal (between the quotes):
// `"` `\` and the control bytes, so the emitted `"…"` parses back. Shared by
// the SLit string case and the Trama literal-text runs.
pub fn emit_str_escaped(out: &mut String, s: str) {
    let n: i64 = s.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        if c == 34u8 { out.push_str("\\\""); }
        else if c == 92u8 { out.push_str("\\\\"); }
        else if c == 10u8 { out.push_str("\\n"); }
        else if c == 13u8 { out.push_str("\\r"); }
        else if c == 9u8  { out.push_str("\\t"); }
        else {
            let one: str = unsafe { str_from_raw((s.as_ptr() as i64 + i) as *const u8, 1i64) };
            out.push_str(one);
        }
        i = i + 1i64;
    }
}

// Emit a sequence of `<target>.push_str(<part>);` statements that APPEND the
// value of a STRING-typed expression `e` to the render buffer named `target`.
// String concatenation `a + b` is FLATTENED into successive pushes (sound, no
// intermediate `String` temporary / borrow): `{{ a + b }}` → push(a); push(b).
// A non-concat str expression is pushed whole. `indent` prefixes each line.
pub fn emit_push_str(out: &mut String, indent: str, target: str,
                     e: SExpr, t: &ElTypes, var: str) {
    match e {
        SExpr::Bin(b) => {
            // str `+` str → flatten to two appends (the only str-producing op).
            if b.op == OP_ADD() && infer_ty(e, t) == EL_TY_STR() {
                emit_push_str(out, indent, target, b.lhs_expr(), t, var);
                emit_push_str(out, indent, target, b.rhs_expr(), t, var);
                return;
            }
            emit_push_str_one(out, indent, target, e, t, var);
        }
        _ => { emit_push_str_one(out, indent, target, e, t, var); }
    }
}

// Emit one `<target>.push_str(<expr>);` for a single (non-flattened) str expr.
// An `upper`/`lower` call yields an OWNED `String`, so it is borrowed via
// `.as_str()` to feed `push_str(str)`; all other str exprs push verbatim.
fn emit_push_str_one(out: &mut String, indent: str, target: str,
                     e: SExpr, t: &ElTypes, var: str) {
    out.push_str(indent);
    out.push_str(target);
    out.push_str(".push_str(");
    if returns_string(e, t) {
        out.push_str("(");
        emit_sexpr(out, e, t, var);
        out.push_str(").as_str()");
    } else {
        emit_sexpr(out, e, t, var);
    }
    out.push_str(");\n");
}

// True iff `e`'s root is a call that returns an OWNED `String` — a builtin
// (`upper`/`lower`) or a String-returning UDF (the reflected table). Such a
// value is `.as_str()`-borrowed before `push_str` (trama render), or promotes
// the query result element to an OWNED `String` (wql projection — a borrowed
// `str` view of the call's temporary would dangle).
pub fn returns_string(e: SExpr, t: &ElTypes) -> bool {
    match e {
        SExpr::Call(c) => {
            let bfn: i32 = builtin_of_name(c.fn_name);
            if bfn != BFN_UNKNOWN() { return bfn == BFN_UPPER() || bfn == BFN_LOWER(); }
            return t.udf_returns_string(c.fn_name);
        }
        _ => { return false; }
    }
}
