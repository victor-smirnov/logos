// logos.std.wql.plan_walker — the WALKER ENTRY (ADR 0012 Phase 3 → Phase 2
// consolidation): take the parsed wql! PROGRAM (`RQProgram` = zero or more
// `rel` blocks + ONE entry query — slice B static Datalog), validate + stamp
// it, and route the entry through the UNIFIED relational algebra.
//
// Phase 2 resolved the RQuery-vs-RExpr duplication: this module no longer emits
// the loop nest per plan-shape. Instead `walk_query` LOWERS the surface plan to
// a real `RExpr` algebra tree, runs the Phase-3 RELATIONAL peephole optimizer
// over it, and walks that ONE tree — all via `rexpr_walk::lower_simplify_emit`.
//
// ── REL BLOCKS (slice B non-recursive + slice C RECURSIVE static Datalog) ───
// The program walker:
//   • REGISTERS each rel (declaration order) in the MacroParams rel registry:
//     name, the emitted source name `__rel_<name>_sl` (+ the delta name
//     `__dl_<name>_sl` — the semi-naïve per-round view), the native row type
//     text (`(i64, str)` / scalar for 1 column), and the column name/type
//     window. Column types are restricted to i64/str/bool — rels are SETS
//     (structural-equality dedup on insert), and f64 kills Eq;
//   • VALIDATES each body: Simple/Join shape only (aggregate/find → named
//     error), no select-tail modifiers (first/distinct/order/limit/`: RTy` are
//     entry-query concerns; distinct is implicit — set semantics), select
//     width = the declared column count (tuple, or a single expr for 1 col);
//   • RESOLVES + REWRITES every source: a slice param keeps its name; a rel
//     reference rewrites `src_name` → `__rel_<r>_sl` + `row_ty` → the tuple
//     text, recording an explicit DEPENDENCY EDGE (RelDeps). Self / forward /
//     mutual references are LEGAL (slice C) — the registry is completed
//     before any body resolves, so every rel name is in scope everywhere;
//   • CONDENSES the dependency graph (compute_rel_scc — SCC + topo order of
//     the condensation). A singleton SCC without a self-edge materializes
//     one-shot (the slice-B helper-fn path, unchanged); a RECURSIVE SCC
//     (self-edge or multi-rel cycle) evaluates as ONE shared SEMI-NAÏVE
//     fixpoint fn for the whole SCC (mutual recursion supported);
//   • ENFORCES STRATIFICATION: `anti join R` / an aggregate body reading R
//     where R is in the SAME SCC as the body's head rel is non-stratifiable —
//     a named error listing the cycle members. Negation/aggregation against
//     an EARLIER stratum (fully materialized rel) is fine.
//     TERMINATION is the standard Datalog contract: finite iff the recursion
//     is not GENERATIVE. Recursive rules whose heads only recombine values
//     drawn from the sources reach a least fixpoint (set semantics — every
//     round either adds a new tuple from a finite universe or the deltas
//     empty out). Arithmetic in a recursive head (`select (p.a + 1, …)`)
//     mints NEW values each round and can diverge — the user's
//     responsibility, deliberately NOT capped (a silent iteration cap would
//     change semantics);
//   • GATES the borrow-outward forms OFF rel sources: `find` over a rel and a
//     whole-rel-row `select` are compile errors (rels are fn-locals — a
//     borrow of their rows cannot leave the generated fn);
//   • EMITS the helper fns (`rexpr_walk::emit_rel_fns` — one fn per
//     non-recursive rel, one semi-naïve fn per recursive SCC) + the entry-fn
//     PRELUDE that materializes each SCC in condensation-topo order and takes
//     the `as_slice()` views the entry scans reference.
//
// PARAMETERIZED surface (the trama! model): the handler passes the RAW
// `deem!(…)` paren text (re-emitted VERBATIM as the generated fn signature) +
// its parsed form (`MacroParams`). Row TYPES are stamped from the SLICE
// params' element types; rel row types from the declared columns.
//
// SCHEMA MANDATE: consumes ONLY Writ schema views — `RQProgram` / `RQuery` /
// `RExpr`.
package logos.std.wql.plan_walker;

use logos.std.compiler.metaprog;  // error, OView, oview_module_ast
use logos.lang.writ.container;    // Writ
use logos.lang.writ.anyval;       // WAny
use logos.std.wql.ir;             // RExpr, WRef
use logos.std.wql.plan;           // RQuery, RQProgram, RQRel*, rq_fat_* (allocator-carrying views)
use logos.std.wql.params;         // MacroParams — the parsed deem!(…) param list + rel registry
use logos.std.wql.rexpr_walk;     // lower_simplify_emit / emit_rel_fns
use logos.std.wql.codegen;        // string_as_str, root_ident_name
use logos.std.wql.el;             // el_ret_class — scalar-element classification (slice D)
use logos.std.wql.reflect;        // find_decl_by_name / has_field / field_traversal_elem (slice D)
use logos.std.wql.ward;           // WardProg / check_warded — Track A: warded Datalog± verdict
use logos.mem.string;
use logos.lang.str;
use logos.std.wql.srcloc;         // the query as a source — located diagnostics (ADR 0024 S0)
use logos.std.wql.access_plan;    // AccessPlan — the plan as an object (ADR 0024 S4)
use logos.std.wql.join_sel;       // the JOIN-STEP decision — decided here, read by the emitter

// ── The walker entry: entry RQuery plan → RExpr algebra → emitted native fn ──
// `prelude` — statements spliced after the generated fn's opening brace (the
// rel materialization lines; "" for a rel-less program).
pub fn walk_query(plan: RQuery, params_text: str, prm: &MacroParams,
                  prelude: str, h: &Writ) -> bool {
    // `select first` is a SINGLE-ROW mode: it subsumes/contradicts the multi-row
    // tail modifiers, so `distinct`/`limit` alongside it are compile-time errors
    // (and the aggregate shape rejects it outright — group-by emission is
    // multi-row by construction; kept out of scope, see wql.peg).
    match plan {
        RQuery::Simple(s) => {
            let mut mode: i32 = SELM_ALL();
            if s.sel_first {
                if s.distinct  { wql_error(prm, "`select first` cannot be combined with `distinct` — first returns a single value"); return false; }
                if s.has_limit { wql_error(prm, "`select first` cannot be combined with `limit` — first already returns at most one row"); return false; }
                mode = SELM_FIRST();
            }
            return lower_simplify_emit(plan, s.fn_name, params_text, prm, s.result_ty, s.has_result_ty, mode, prelude, h);
        }
        RQuery::Join(j) => {
            let mut mode: i32 = SELM_ALL();
            if j.sel_first {
                if j.distinct  { wql_error(prm, "`select first` cannot be combined with `distinct` — first returns a single value"); return false; }
                if j.has_limit { wql_error(prm, "`select first` cannot be combined with `limit` — first already returns at most one row"); return false; }
                mode = SELM_FIRST();
            }
            return lower_simplify_emit(plan, j.fn_name, params_text, prm, j.result_ty, j.has_result_ty, mode, prelude, h);
        }
        RQuery::Aggr(g) => {
            if g.sel_first { wql_error(prm, "`select first` is not supported on aggregate queries"); return false; }
            return lower_simplify_emit(plan, g.fn_name, params_text, prm, g.result_ty, g.has_result_ty, SELM_ALL(), prelude, h);
        }
        RQuery::Find(f) => {
            // `find P` — no result-type / tail modifiers exist on this shape
            // (the grammar admits only the predicate).
            return lower_simplify_emit(plan, f.fn_name, params_text, prm, "", false, SELM_FIND(), prelude, h);
        }
    }
}

// Fat (allocator-carrying) view wrappers — shared with the emitter, see
// plan.logos (`rq_fat_*`): str-field writes box into the arena and need z.
// The variant is chosen off a cheap read-only match first.

// ── RelDeps + compute_rel_scc — MOVED to logos.std.wql.params (queue-2 I3) ──
// The pure graph half (dependency edge list + Warshall/Kahn condensation) is
// metaprog-free and now shared with the runtime interpreter (logos.std.deem),
// which re-hosts the same semi-naïve algorithm as an interpreter loop. This
// module keeps only the metaprog-entangled validation/emission around it.

// "{p, q}" — the member list of SCC `c`, declaration order.
fn push_scc_members(out: &mut String, prm: &MacroParams, scc: &RelScc, c: i64) {
    out.push_str("{");
    let mut first: bool = true;
    let mut i: i64 = 0i64;
    while i < prm.rel_n {
        if scc.comp[i] == c {
            if !first { out.push_str(", "); }
            out.push_str(prm.rel_names[i]);
            first = false;
        }
        i = i + 1i64;
    }
    out.push_str("}");
}

// ── Stratification (slice C) ─────────────────────────────────────────────────
// Negation (`anti join`) and aggregation must read an EARLIER stratum: an
// anti/aggregate source in the SAME SCC as the body's head rel has no
// stratified semantics — a named error listing the cycle members. An
// aggregate body OUTSIDE any cycle still gets the slice-B shape reject
// (bodies are relation producers).
fn check_stratified(prm: &mut MacroParams, deps: &RelDeps, scc: &RelScc) -> bool {
    // ── Aggregate edges: min/max (semilattice) may recurse; group may not ──
    let mut k: i64 = 0i64;
    while k < deps.gn {
        let f: i64 = deps.gfrom[k];
        let t: i64 = deps.gto[k];
        if scc.comp[f] == scc.comp[t] {
            let dir: i32 = deps.head_agg_dir[f];
            if agg_algebra(dir) == AGG_CLASS_SEMILATTICE() {
                // ADMISSIBLE recursive aggregation — the absorb gate IS the
                // lattice order (monotone fixpoint). Slice-1 restricts the SCC to
                // the SINGLE aggregate rel (self-recursion): mutual plain↔agg
                // recursion has non-monotone interaction (design §7 critique #3).
                let mut nmem: i64 = 0i64;
                let mut r0: i64 = 0i64;
                while r0 < prm.rel_n {
                    if scc.comp[r0] == scc.comp[f] { nmem = nmem + 1i64; }
                    r0 = r0 + 1i64;
                }
                if nmem > 1i64 {
                    let mut mm: String = String::new();
                    mm.push_str("wql!: rel '");
                    mm.push_str(prm.rel_names[f]);
                    mm.push_str("': a recursive min/max aggregate must be its OWN recursive component — ");
                    push_scc_members(&mut mm, prm, scc, scc.comp[f]);
                    mm.push_str(" has multiple rels; mutual recursion through an aggregate is not supported (slice-1)");
                    error(string_as_str(&mm));
                    return false;
                }
                prm.rel_is_agg[f]  = true;
                prm.rel_agg_dir[f] = dir;
            } else {
                // GROUP aggregate (sum/count/avg) as a recursive head — the
                // abelian-group inverse that makes it O(1)-incremental is exactly
                // what breaks fixpoint monotonicity (counting paths in a cycle
                // diverges). Non-stratifiable; the message NAMES the cycle.
                let mut m: String = String::new();
                m.push_str("wql!: non-stratifiable aggregation — rel '");
                m.push_str(prm.rel_names[f]);
                m.push_str("' aggregates over rel '");
                m.push_str(prm.rel_names[t]);
                m.push_str("' of the same recursive component ");
                push_scc_members(&mut m, prm, scc, scc.comp[f]);
                m.push_str(" — sum/count/avg is an abelian-group aggregate and cannot appear as a recursive head; only min/max (idempotent semilattice) may recurse; aggregate over an earlier stratum");
                error(string_as_str(&m));
                return false;
            }
        }
        k = k + 1i64;
    }
    let mut k2: i64 = 0i64;
    while k2 < deps.an {
        if scc.comp[deps.afrom[k2]] == scc.comp[deps.ato[k2]] {
            let mut m2: String = String::new();
            m2.push_str("wql!: non-stratifiable negation — rel '");
            m2.push_str(prm.rel_names[deps.afrom[k2]]);
            m2.push_str("' `anti join`s rel '");
            m2.push_str(prm.rel_names[deps.ato[k2]]);
            m2.push_str("' of the same recursive component ");
            push_scc_members(&mut m2, prm, scc, scc.comp[deps.afrom[k2]]);
            m2.push_str(" — negation through recursion has no stratified semantics; anti join only rels from an earlier stratum");
            error(string_as_str(&m2));
            return false;
        }
        k2 = k2 + 1i64;
    }
    // ── Non-recursive aggregate bodies: deferred (out of slice-1) ──
    // A rel with an aggregate body that did NOT finalize as a recursive
    // semilattice head is a non-recursive aggregate rel (aggregate over a slice
    // param / earlier stratum). Recursive min/max is the only aggregate-body
    // form implemented; anything else is aggregated in the entry query.
    let mut r: i64 = 0i64;
    while r < prm.rel_n {
        if deps.head_agg_dir[r] != 0i32 && !prm.rel_is_agg[r] {
            let mut m3: String = String::new();
            m3.push_str("wql!: rel '");
            m3.push_str(prm.rel_names[r]);
            m3.push_str("': aggregate rel bodies are only supported as RECURSIVE min/max (an idempotent semilattice closing a self-cycle); a non-recursive aggregate rel is not yet supported — aggregate in the entry query or over an earlier stratum");
            error(string_as_str(&m3));
            return false;
        }
        r = r + 1i64;
    }
    return true;
}

// ── Source resolution (slice params + rels) ──────────────────────────────────
// `cur_rel` — the declaration index of the rel whose body is being resolved,
// or -1 for the ENTRY query. Every rel is in scope everywhere (the registry is
// completed before any body resolves), so self/forward/mutual references are
// LEGAL — a rel reference from a body records the dependency edge the SCC
// condensation consumes; recursion is realized by the semi-naïve fixpoint.
struct SrcRes { ok: bool, is_rel: bool, idx: i64, row_ty: str }

fn src_fail() -> SrcRes { return SrcRes { ok: false, is_rel: false, idx: -1i64, row_ty: "" }; }

fn resolve_source(prm: &MacroParams, src: str, cur_rel: i64, deps: &mut RelDeps) -> SrcRes {
    let i: i64 = prm.index_of(src);
    if i >= 0i64 {
        if prm.is_slice[i] {
            return SrcRes { ok: true, is_rel: false, idx: i, row_ty: prm.tys[i] };
        }
        // A NATIVE-source param (ADR 0016 §6: any type implementing a source
        // trait — Writ, IncrRec, user types) resolves through its native rel,
        // registered under the param's own name before bodies resolve. Fall
        // through to the rel lookup; a scalar param has no rel and reports
        // the not-a-source diagnostic below.
        if prm.rel_find_name(src) < 0i64 {
            let mut m1: String = String::new();
            m1.push_str("wql!: source `");
            m1.push_str(src);
            m1.push_str("` is not a slice — declare it as `");
            m1.push_str(src);
            m1.push_str(": &[RowTy]` (or a type implementing a source trait, e.g. `&Writ`) in the deem!(…) parameter list");
            error(string_as_str(&m1));
            return src_fail();
        }
    }
    let ri: i64 = prm.rel_find_name(src);
    if ri >= 0i64 {
        if cur_rel >= 0i64 {
            deps.add(cur_rel, ri);
        }
        return SrcRes { ok: true, is_rel: true, idx: ri, row_ty: prm.rel_rowty[ri] };
    }
    // A rel reference the walker has ALREADY resolved names its rel by the
    // emitted source name (`__rel_<r>_sl`) — the rewrite below is destructive.
    // Accepting that name as an alias makes the walk IDEMPOTENT, so one parsed
    // plan can be walked once per mapping rel instead of re-parsed each time.
    // Registration is deterministic from the rel names, so the alias is stable
    // across walks.
    let si: i64 = prm.rel_find_src(src);
    if si >= 0i64 {
        if cur_rel >= 0i64 {
            deps.add(cur_rel, si);
        }
        return SrcRes { ok: true, is_rel: true, idx: si, row_ty: prm.rel_rowty[si] };
    }
    let mut msg: String = String::new();
    msg.push_str("wql!: unknown source `");
    msg.push_str(src);
    msg.push_str("` — a from/join source must name a `&[RowTy]` parameter declared in the deem!(…) parameter list or a rel declared in the block");
    error(string_as_str(&msg));
    return src_fail();
}

// Resolve + REWRITE one scan source on a fat plan-node view: slice params keep
// their name (row_ty stamped from the element type); rels rewrite src_name →
// the emitted `__rel_<r>_sl` and row_ty → the tuple row type. On a rel hit the
// bound VAR is appended to `relvars` (the whole-row/find gating set).
// Returns the SrcRes (ok=false ⇒ error already surfaced).

// ── Rel-body modifier gate ────────────────────────────────────────────────────
// Bodies are RELATION PRODUCERS: from/join/where/select only. Every select-tail
// modifier is an entry-query concern; `distinct` is additionally IMPLICIT
// (set semantics dedup on insert).
fn rel_body_mods_ok(rel_name: str, first: bool, distinct: bool,
                    has_order: bool, has_limit: bool, has_resty: bool) -> bool {
    if first {
        let mut m: String = String::new();
        m.push_str("wql!: rel '"); m.push_str(rel_name);
        m.push_str("': `select first` is not allowed in a rel body — bodies produce relations (single-row modes are entry-query concerns)");
        error(string_as_str(&m));
        return false;
    }
    if distinct {
        let mut m1: String = String::new();
        m1.push_str("wql!: rel '"); m1.push_str(rel_name);
        m1.push_str("': `distinct` is not allowed in a rel body — rels are SETS, deduplication is implicit");
        error(string_as_str(&m1));
        return false;
    }
    if has_order {
        let mut m2: String = String::new();
        m2.push_str("wql!: rel '"); m2.push_str(rel_name);
        m2.push_str("': `order by` is not allowed in a rel body — rels are unordered sets (order in the entry query)");
        error(string_as_str(&m2));
        return false;
    }
    if has_limit {
        let mut m3: String = String::new();
        m3.push_str("wql!: rel '"); m3.push_str(rel_name);
        m3.push_str("': `limit` is not allowed in a rel body (an entry-query concern)");
        error(string_as_str(&m3));
        return false;
    }
    if has_resty {
        let mut m4: String = String::new();
        m4.push_str("wql!: rel '"); m4.push_str(rel_name);
        m4.push_str("': a `: ResultTy` annotation is not allowed in a rel body — the row type is the declared column list");
        error(string_as_str(&m4));
        return false;
    }
    return true;
}

// Resolve + rewrite a join-step fan-out (body OR entry: `cur_rel` = -1 for the
// entry) and check ROW-VAR UNIQUENESS across the whole chain. Rel-sourced step
// vars append to `relvars`. A BODY's rel-sourced ANTI step records a negation
// edge (afrom/ato) — the post-SCC stratification check errors when it lands
// inside the head rel's own SCC.
//
// TRAVERSAL steps (`is_edge`, slice D) skip source resolution entirely: the
// field path validates against the BASE var's row type via module-AST
// reflection (stamp_edge_step), `src_name` is REWRITTEN to the full source
// EXPRESSION text (`d.emps` — arena-boxed), and `row_ty` stamped to the
// ELEMENT type. Scalar-element vars (Vec<str> → str) append to `svars` — the
// callers reject field access rooted at them across every clause.
fn stamp_steps(steps: RQJoinStepArr, base_var: str, base_ty: str, prm: &MacroParams,
               cur_rel: i64, deps: &mut RelDeps,
               relvars: &mut [str; 9], nrelv: &mut i64,
               svars: &mut [str; 9], nsv: &mut i64, h: &Writ) -> bool {
    let n: i64 = steps.len();
    let mut vars: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    let mut vtys: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    let mut vanti: [bool; 9] = [false; 9];
    vars[0] = base_var;
    vtys[0] = base_ty;
    let mut nv: i64 = 1i64;
    let mut i: i64 = 0i64;
    while i < n {
        let st: RQJoinStep = rq_fat_step(steps.step_any(i), h);
        if st.is_edge {
            if !stamp_edge_step(st, &vars, &vtys, &vanti, nv,
                                relvars, *nrelv, svars, nsv) { return false; }
        } else {
            let sr: SrcRes = resolve_source(prm, st.src_name, cur_rel, deps);
            if !sr.ok { return false; }
            if sr.is_rel {
                st.src_name = prm.rel_srcs[sr.idx];
                if st.is_anti && cur_rel >= 0i64 { deps.add_anti(cur_rel, sr.idx); }
                if *nrelv < 9i64 { relvars[*nrelv] = st.var_name; *nrelv = *nrelv + 1i64; }
            }
            st.row_ty = sr.row_ty;
        }
        // Uniqueness against every var bound so far.
        let v: str = st.var_name;
        let mut k: i64 = 0i64;
        while k < nv {
            if str_eq(vars[k], v) {
                let mut m: String = String::new();
                m.push_str("wql!: duplicate row variable `");
                m.push_str(v);
                m.push_str("` in the join chain — every `from`/`join` row var must be unique");
                error(string_as_str(&m));
                return false;
            }
            k = k + 1i64;
        }
        if nv < 9i64 { vars[nv] = v; vtys[nv] = st.row_ty; vanti[nv] = st.is_anti; nv = nv + 1i64; }
        i = i + 1i64;
    }
    return true;
}

// ── Traversal-step validation + stamping (slice D) ───────────────────────────
// `[anti] join <base>.<f>[.<g>…] <var> [on P]` — containment IS the join. The
// base var must be a NON-ANTI struct-rowed var bound EARLIER in the chain (the
// from-var included); intermediate path segments must be SINGULAR plain struct
// fields; the FINAL segment must be a collection (Vec<E> / &[E] / [E; N] —
// single references `&T`/`Box<T>` are the named error below). On success the
// step's `src_name` becomes the full source expression text and `row_ty` the
// element type — the emitters then scan `(src_name)` uniformly.
fn stamp_edge_step(st: RQJoinStep,
                   vars: &[str; 9], vtys: &[str; 9], vanti: &[bool; 9], nv: i64,
                   relvars: &[str; 9], nrelv: i64,
                   svars: &mut [str; 9], nsv: &mut i64) -> bool {
    let bv: str = st.base_var;
    // 1. The base var: bound earlier, non-anti, not rel-rowed, not scalar.
    let mut bi: i64 = -1i64;
    let mut k0: i64 = 0i64;
    while k0 < nv {
        if str_eq(vars[k0], bv) { bi = k0; }
        k0 = k0 + 1i64;
    }
    if bi < 0i64 {
        let mut m: String = String::new();
        m.push_str("wql!: traversal `join ");
        m.push_str(bv);
        m.push_str(".…`: `");
        m.push_str(bv);
        m.push_str("` is not a bound row variable — the base of a field-path join must be the from-var or an earlier join var");
        error(string_as_str(&m));
        return false;
    }
    if vanti[bi] {
        let mut m1: String = String::new();
        m1.push_str("wql!: traversal `join ");
        m1.push_str(bv);
        m1.push_str(".…`: `");
        m1.push_str(bv);
        m1.push_str("` is an anti-join variable — it binds only inside its own `on` predicate and cannot seed a traversal");
        error(string_as_str(&m1));
        return false;
    }
    let mut r0: i64 = 0i64;
    while r0 < nrelv {
        if str_eq(relvars[r0], bv) {
            let mut m2: String = String::new();
            m2.push_str("wql!: traversal `join ");
            m2.push_str(bv);
            m2.push_str(".…`: `");
            m2.push_str(bv);
            m2.push_str("` binds a rel row — rel rows are native tuples and have no collection fields to traverse");
            error(string_as_str(&m2));
            return false;
        }
        r0 = r0 + 1i64;
    }
    if el_ret_class(vtys[bi]) >= 0i32 {
        let mut m3: String = String::new();
        m3.push_str("wql!: traversal `join ");
        m3.push_str(bv);
        m3.push_str(".…`: `");
        m3.push_str(bv);
        m3.push_str("` binds a scalar element (");
        m3.push_str(vtys[bi]);
        m3.push_str(") — scalars have no fields");
        error(string_as_str(&m3));
        return false;
    }
    // 2. Resolve the path against the base row type (module-AST reflection).
    let view: OView = oview_module_ast();
    let segs: RQPathSegArr = st.path_arr();
    let np: i64 = segs.len();
    if np < 1i64 { error("wql!: empty traversal path"); return false; }   // unreachable via grammar
    let mut cur_ty: str = vtys[bi];
    let mut fin_kind: i32 = 0i32;
    let mut k: i64 = 0i64;
    while k < np {
        let seg: str = segs.seg_at(k).name;
        // The traversal path walks TYPE SPELLINGS: `cur_ty` starts as a source's
        // declared element type and is then the declared type of each intermediate
        // field, either of which may be an alias. Resolved here, where it is read.
        let decl: WAny = find_struct_decl(&view, cur_ty);
        if decl.is_null() {
            let mut m4: String = String::new();
            m4.push_str("wql!: traversal path segment `.");
            m4.push_str(seg);
            m4.push_str("`: row type `");
            m4.push_str(cur_ty);
            m4.push_str("` is not a struct declared in this module — traversal paths resolve against module-local struct declarations");
            error(string_as_str(&m4));
            return false;
        }
        if !has_field(&view, decl, seg) {
            let mut m5: String = String::new();
            m5.push_str("wql!: traversal path: `");
            m5.push_str(cur_ty);
            m5.push_str("` has no field `");
            m5.push_str(seg);
            m5.push_str("`");
            error(string_as_str(&m5));
            return false;
        }
        let elem: str = field_traversal_elem(&view, decl, seg);
        if k < np - 1i64 {
            // INTERMEDIATE segment: must be a SINGULAR plain struct field.
            if elem.len() > 0i64 {
                let mut m6: String = String::new();
                m6.push_str("wql!: traversal path: intermediate segment `.");
                m6.push_str(seg);
                m6.push_str("` is a collection — only the FINAL segment may be; traverse it with its own `join ");
                m6.push_str(bv);
                m6.push_str(".");
                m6.push_str(seg);
                m6.push_str(" <var>` step first");
                error(string_as_str(&m6));
                return false;
            }
            let tn: str = field_type_name(&view, decl, seg);
            if tn.len() == 0i64 {
                let mut m7: String = String::new();
                m7.push_str("wql!: traversal path: intermediate segment `.");
                m7.push_str(seg);
                m7.push_str("` of `");
                m7.push_str(cur_ty);
                m7.push_str("` is not a plain named struct field");
                error(string_as_str(&m7));
                return false;
            }
            cur_ty = tn;
        } else {
            // FINAL segment: must be a collection field. The KIND drives the
            // emitted source spelling (Vec → hoist a `.as_slice()` view).
            fin_kind = field_traversal_kind(&view, decl, seg);
            if elem.len() == 0i64 {
                let tn2: str = field_type_name(&view, decl, seg);
                let mut m8: String = String::new();
                m8.push_str("wql!: `join ");
                m8.push_str(bv);
                m8.push_str(".");
                m8.push_str(seg);
                m8.push_str("`: field `");
                m8.push_str(seg);
                m8.push_str("` of `");
                m8.push_str(cur_ty);
                m8.push_str("`");
                if tn2.len() > 0i64 {
                    m8.push_str(" has type `");
                    m8.push_str(tn2);
                    m8.push_str("`");
                }
                m8.push_str(" — traverse a collection field (Vec<E>, &[E], or [E; N]; single references are not traversable)");
                error(string_as_str(&m8));
                return false;
            }
            st.row_ty = elem;
        }
        k = k + 1i64;
    }
    // 3. Rewrite src_name → the full source expression text (arena-boxed by
    // the fat-view str write; the local String may die). A Vec-typed final
    // segment takes a `.as_slice()` view — the emitters then index a SLICE
    // (the native fat-element path); slice/array fields index in place.
    // (Plain `vec[i]` on fat elements works too — the fat-element deref
    // class is fixed, see tests/logos/pass/fat_elem_{borrow_deref,
    // index_field}.logos — the `.as_slice()` spelling is kept as the more
    // explicit form, not as a workaround.)
    let mut buf: String = String::new();
    buf.push_str(bv);
    let mut k2: i64 = 0i64;
    while k2 < np {
        buf.push_str(".");
        buf.push_str(segs.seg_at(k2).name);
        k2 = k2 + 1i64;
    }
    if fin_kind == 1i32 { buf.push_str(".as_slice()"); }
    st.src_name = string_as_str(&buf);
    // 4. Scalar-element var (Vec<str> → str) → the no-fields diagnostic set.
    if el_ret_class(st.row_ty) >= 0i32 {
        if *nsv < 9i64 { svars[*nsv] = st.var_name; *nsv = *nsv + 1i64; }
    }
    return true;
}

// ── Scalar-element field-access guard (slice D) ──────────────────────────────
// A traversal var over a SCALAR collection (Vec<str> → `s: str`) has no fields
// — `s.foo` anywhere in a clause is a named error (referenced BARE it is the
// element value). Recursive over the SExpr family; no-op when no scalar vars.
fn no_scalar_field(e: SExpr, sv: &[str; 9], n: i64) -> bool {
    if n == 0i64 { return true; }
    match e {
        SExpr::Field(f) => {
            let bref: WRef<SExpr> = f.base;
            if bref.any().is_null() { return true; }
            let rn: str = root_ident_name(f.base_expr());
            if rn.len() > 0i64 {
                let mut i: i64 = 0i64;
                while i < n {
                    if str_eq(sv[i], rn) {
                        let mut m: String = String::new();
                        m.push_str("wql!: `");
                        m.push_str(rn);
                        m.push_str(".");
                        m.push_str(f.name);
                        m.push_str("` — `");
                        m.push_str(rn);
                        m.push_str("` binds a scalar collection element and has no fields; reference it bare");
                        error(string_as_str(&m));
                        return false;
                    }
                    i = i + 1i64;
                }
            }
            return no_scalar_field(f.base_expr(), sv, n);
        }
        SExpr::Bin(b)  => { return no_scalar_field(b.lhs_expr(), sv, n) && no_scalar_field(b.rhs_expr(), sv, n); }
        SExpr::Un(u)   => { return no_scalar_field(u.arg_expr(), sv, n); }
        SExpr::Cond(c) => {
            return no_scalar_field(c.cond_expr(), sv, n)
                && no_scalar_field(c.then_expr(), sv, n)
                && no_scalar_field(c.else_expr(), sv, n);
        }
        SExpr::Call(c) => {
            let args: SExprArr = c.args_arr();
            let mut i2: i64 = 0i64;
            while i2 < args.len() {
                if !no_scalar_field(args.arg_at(i2), sv, n) { return false; }
                i2 = i2 + 1i64;
            }
            return true;
        }
        SExpr::Comp(cp) => { return no_scalar_field(cp.head_expr(), sv, n); }
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let mut i3: i64 = 0i64;
            while i3 < items.len() {
                if !no_scalar_field(items.arg_at(i3), sv, n) { return false; }
                i3 = i3 + 1i64;
            }
            return true;
        }
        _ => { return true; }
    }
}

// The step fan-out's on-predicates through the scalar-field guard.
fn steps_scalar_ok(steps: RQJoinStepArr, sv: &[str; 9], n: i64) -> bool {
    if n == 0i64 { return true; }
    let ns: i64 = steps.len();
    let mut i: i64 = 0i64;
    while i < ns {
        let st: RQJoinStep = steps.step_at(i);
        if st.has_on {
            if !no_scalar_field(st.on_expr(), sv, n) { return false; }
        }
        i = i + 1i64;
    }
    return true;
}

// ── Whole-rel-row select gate ────────────────────────────────────────────────
// A rel row is a native tuple materialized in a fn-LOCAL Vec — projecting the
// whole row var (bare ident at the select root or as a tuple component) has no
// sound emission (identity would borrow a local out; a bare tuple var inside a
// projection defeats the EL scalar lattice). Diagnosed here, which also gates
// the identity/head-row thin collapses OFF rel sources (they only trigger on
// bare-var selects).
fn sel_whole_row_ok(sel: SExpr, relvars: &[str; 9], n: i64) -> bool {
    if n == 0i64 { return true; }
    let rn: str = root_ident_name(sel);
    if rn.len() > 0i64 {
        let mut i: i64 = 0i64;
        while i < n {
            if str_eq(relvars[i], rn) {
                let mut m: String = String::new();
                m.push_str("wql!: `select ");
                m.push_str(rn);
                m.push_str("` projects the whole rel row — a rel row cannot be borrowed or projected whole; select explicit columns (e.g. `select (");
                m.push_str(rn);
                m.push_str(".a, ");
                m.push_str(rn);
                m.push_str(".b)`)");
                error(string_as_str(&m));
                return false;
            }
            i = i + 1i64;
        }
    }
    match sel {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let mut k: i64 = 0i64;
            while k < items.len() {
                if !sel_whole_row_ok(items.arg_at(k), relvars, n) { return false; }
                k = k + 1i64;
            }
        }
        _ => { }
    }
    return true;
}

// ── One rel body: shape + modifier gate + source resolution/rewrite ─────────
fn check_rel_body(body_any: WAny, rel_name: str, cur_rel: i64,
                  prm: &MacroParams, deps: &mut RelDeps, h: &Writ) -> bool {
    if body_any.is_null() {
        error("wql!: empty rel body");
        return false;
    }
    let q: RQuery = body_any.view::<RQuery>();
    let mut relvars: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    let mut nrelv: i64 = 0i64;
    match q {
        RQuery::Simple(_) => {
            let s: RQSimple = rq_fat_simple(body_any, h);
            if !rel_body_mods_ok(rel_name, s.sel_first, s.distinct,
                                 s.has_order, s.has_limit, s.has_result_ty) { return false; }
            let sr: SrcRes = resolve_source(prm, s.src_name, cur_rel, deps);
            if !sr.ok { return false; }
            if sr.is_rel { s.src_name = prm.rel_srcs[sr.idx]; }
            s.row_ty = sr.row_ty;
            // Classify bare select idents (typo vs bound column / scalar param /
            // fresh() marker) — Track A.
            let mut bv: [str; 9] = ["", "", "", "", "", "", "", "", ""];
            bv[0] = s.var_name;
            if !ward_sel_idents_ok(s.select_expr(), &bv, 1i64, prm, rel_name) { return false; }
            return true;
        }
        RQuery::Join(_) => {
            let j: RQJoin = rq_fat_join(body_any, h);
            if !rel_body_mods_ok(rel_name, j.sel_first, j.distinct,
                                 j.has_order, j.has_limit, j.has_result_ty) { return false; }
            let sr: SrcRes = resolve_source(prm, j.a_name, cur_rel, deps);
            if !sr.ok { return false; }
            if sr.is_rel { j.a_name = prm.rel_srcs[sr.idx]; }
            j.a_ty = sr.row_ty;
            let mut svars: [str; 9] = ["", "", "", "", "", "", "", "", ""];
            let mut nsv: i64 = 0i64;
            if !stamp_steps(j.steps_arr(), j.x_var, sr.row_ty, prm, cur_rel, deps,
                            &mut relvars, &mut nrelv, &mut svars, &mut nsv, h) { return false; }
            // Scalar-element vars (traversal over Vec<str> etc.): no field
            // access rooted at them in any clause of this body.
            if nsv > 0i64 {
                if !no_scalar_field(j.select_expr(), &svars, nsv) { return false; }
                if j.has_where {
                    if !no_scalar_field(j.where_expr(), &svars, nsv) { return false; }
                }
                if !steps_scalar_ok(j.steps_arr(), &svars, nsv) { return false; }
            }
            // Classify bare select idents (Track A). Bound vars = base + every
            // non-anti step var (anti-step vars are scoped to their own `on`).
            let mut bv: [str; 9] = ["", "", "", "", "", "", "", "", ""];
            bv[0] = j.x_var;
            let mut nbv: i64 = 1i64;
            let jsteps: RQJoinStepArr = j.steps_arr();
            let mut sk: i64 = 0i64;
            while sk < jsteps.len() {
                let stp: RQJoinStep = jsteps.step_at(sk);
                if !stp.is_anti {
                    if nbv < 9i64 { bv[nbv] = stp.var_name; nbv = nbv + 1i64; }
                }
                sk = sk + 1i64;
            }
            if !ward_sel_idents_ok(j.select_expr(), &bv, nbv, prm, rel_name) { return false; }
            return true;
        }
        RQuery::Aggr(_) => {
            // An aggregate rel body. In slice-1 the ADMISSIBLE case is a
            // RECURSIVE min/max (idempotent semilattice) closing a self-cycle —
            // the fixpoint's per-key lattice. The classification (min/max vs
            // group) is recorded here (head_agg_dir) and the SOURCES are
            // resolved + REWRITTEN to the rel-slice spelling (recursion needs it;
            // the semi-naïve driver swaps in the per-round delta). The final
            // admit/reject decision is POST-SCC (check_stratified): an in-cycle
            // semilattice is accepted, an in-cycle group is the non-stratifiable
            // error, a non-recursive aggregate is deferred.
            let g: RQAggr = rq_fat_aggr(body_any, h);
            let sra: SrcRes = resolve_source(prm, g.a_name, cur_rel, deps);
            if !sra.ok { return false; }
            if sra.is_rel { g.a_name = prm.rel_srcs[sra.idx]; deps.add_agg(cur_rel, sra.idx); }
            g.a_ty = sra.row_ty;
            if g.has_steps() {
                let gsteps: RQJoinStepArr = g.steps_arr();
                let gn: i64 = gsteps.len();
                let mut gi: i64 = 0i64;
                while gi < gn {
                    let gst: RQJoinStep = rq_fat_step(gsteps.step_any(gi), h);
                    // Traversal steps have no SOURCE to resolve (field path of a
                    // bound var) — they cannot form rel dependency edges.
                    if !gst.is_edge {
                        let srs: SrcRes = resolve_source(prm, gst.src_name, cur_rel, deps);
                        if !srs.ok { return false; }
                        if srs.is_rel { gst.src_name = prm.rel_srcs[srs.idx]; deps.add_agg(cur_rel, srs.idx); }
                        gst.row_ty = srs.row_ty;
                    }
                    gi = gi + 1i64;
                }
            }
            // Slice-1: exactly one aggregate; classify it (min/max/sum/…).
            let gaggs: RQAggArr = g.aggs_arr();
            if gaggs.len() != 1i64 {
                let mut ma: String = String::new();
                ma.push_str("wql!: rel '");
                ma.push_str(rel_name);
                ma.push_str("': a recursive aggregate rel supports exactly ONE aggregate (slice-1); found ");
                ma.push_i64(gaggs.len());
                error(string_as_str(&ma));
                return false;
            }
            deps.set_head_agg_dir(cur_rel, agg_of_name(gaggs.agg_at(0i64).fn_name));
            if deps.agg_head < 0i64 { deps.agg_head = cur_rel; }
            return true;
        }
        RQuery::Find(_) => {
            let mut m1: String = String::new();
            m1.push_str("wql!: rel '");
            m1.push_str(rel_name);
            m1.push_str("': `find` is not allowed in a rel body — bodies produce relations (from/join/where/select only)");
            error(string_as_str(&m1));
            return false;
        }
    }
}

// Is `t` a supported rel column type? THE ANSWER IS NOT HERE any more: it is
// `el::el_set_col_admit`, because `Query::compile` (the dynamic tier) asks the
// same question and used to carry its own copy of the spelling list `i64 / str /
// bool`. Two lists for one fact is two things that can drift. What is left here
// is the wql!-flavoured MESSAGE around the shared verdict and its ground.
//
// The admitted set is unchanged and is now a derivation: a rel is a SET, so a
// column type needs an IDENTITY (`ElTy.ident` — f64 has none, and neither does a
// 128-bit integer, whose normalization drops bits); and the row is stored as a
// native tuple of the DECLARED types while the EL computes in `ElTy.repr`, so the
// type must be its own repr (`ElTy.canon` — which is what excludes `u64`, `u32`
// and `String` alike, each for the same stated reason instead of by absence from
// a list).
fn rel_col_ty_ok(rel_name: str, col_name: str, t: str) -> bool {
    let a: i32 = el_set_col_admit(t);
    if a == EL_COL_OK() { return true; }
    // The float wording belongs to the float FAILURE, and `EL_COL_NO_EQ` IS that
    // failure — the other way an identity can fail (a 128-bit normalization that
    // drops bits) is its own code and gets the general message. No class test is
    // needed to pick between them: the verdict already distinguishes them.
    if a == EL_COL_NO_EQ() {
        let mut m: String = String::new();
        m.push_str("wql!: rel column '");
        m.push_str(col_name);
        m.push_str("': f64 columns are not allowed (set semantics require Eq) — ");
        m.push_str(el_set_col_why(t));
        error(string_as_str(&m));
        return false;
    }
    let mut m1: String = String::new();
    m1.push_str("wql!: rel '");
    m1.push_str(rel_name);
    m1.push_str("' column '");
    m1.push_str(col_name);
    m1.push_str("': unsupported column type `");
    m1.push_str(t);
    m1.push_str("` — ");
    m1.push_str(el_set_col_why(t));
    error(string_as_str(&m1));
    return false;
}

// ═════════════════════════════════════════════════════════════════════════════
// TRACK A — warded Datalog± existential heads on the WQL surface.
//
// SURFACE: an existential head term is the reserved pseudo-call `fresh()` /
// `fresh(z)` inside a rel-body `select` (rides the existing EL `SCall` syntax —
// NO grammar change). `fresh()` = a unique invented null; `fresh(z)` = a NAMED
// existential (two `fresh(z)` in the same body's select denote the same witness).
// A rel with ≥1 `fresh(...)` in some body's select is an EXISTENTIAL (TGD) rel.
//
// PIPELINE: at the walk seam (after stratification, before emission) we scan for
// markers; if present we EXTRACT the rel program → a `WardProg` (ward.logos) and
// run the PURE-STATIC wardedness checker. Three outcomes, all fail the build
// (the only wql! diagnostic channel), differing only in message:
//   • WARDED    → "accepted (warded); execution not yet supported" (chase is
//                 blocked on the identity/Skolem-null foundation — ADR 0012) and
//                 lowering is GRACEFULLY REFUSED (return false before emission —
//                 no fn, no miscompile, no silent empty result);
//   • NON-WARDED→ the wardedness failure + named reason (SPLIT/SHARE);
//   • NO MARKER → fast path, emission UNCHANGED (a vanilla Datalog program has no
//                 existential positions, hence is trivially warded — never built).
//
// Value invention (the chase) is DELIBERATELY NOT attempted — only the SHAPE of
// the rules is read (ward.logos §What-this-is-and-is-NOT). The verdict is the
// deliverable.
// ─────────────────────────────────────────────────────────────────────────────

// A column reference `rv.col` decoded off an SExpr (SField over a simple root).
struct ColRef { pub ok: bool, pub rv: str, pub col: str }

// The per-program existential extractor state: a per-RULE union-find over
// (row-var, column) pairs (var identity = the union-find ROOT slot index, an id
// < WX_CAP hence disjoint from existential ids ≥ WX_EXBASE); per-rule
// existential-name table; a program-global EDB predicate registry; and the
// per-rule provenance (flat rule index → declaring rel + body index) used to
// point a non-warded diagnostic back at its source rule.
fn WX_CAP() -> i64 { return 48i64; }
fn WX_EXBASE() -> i64 { return 100000i64; }

struct WardX {
    pub vv:  [str; 48],   // union-find pair: row var
    pub vc:  [str; 48],   //               : column
    pub par: [i64; 48],   // union-find parent
    pub nvar: i64,
    pub exn:  [str; 12],  // per-rule existential names (fresh(z))
    pub exi:  [i64; 12],  // → assigned existential var id
    pub nexn: i64,
    pub exctr: i64,       // next existential id (reset per rule)
    pub esrc: [str; 16],  // program-global EDB source name
    pub epid: [i64; 16],  // → WardProg predicate id
    pub nedb: i64,
    pub prel: [i64; 16],  // rule r → declaring rel index
    pub pbod: [i64; 16],  // rule r → body index within that rel
}

fn wardx_new() -> WardX {
    return WardX {
        vv: [""; 48], vc: [""; 48], par: [0i64; 48], nvar: 0i64,
        exn: [""; 12], exi: [0i64; 12], nexn: 0i64, exctr: 100000i64,
        esrc: [""; 16], epid: [0i64; 16], nedb: 0i64,
        prel: [0i64; 16], pbod: [0i64; 16],
    };
}

// Reset the per-rule state (union-find + existential names); the EDB registry and
// provenance are program-global and persist.
fn wardx_reset(x: &mut WardX) {
    x.nvar = 0i64;
    x.nexn = 0i64;
    x.exctr = WX_EXBASE();
}

fn wx_find(x: &WardX, i: i64) -> i64 {
    let mut j: i64 = i;
    while x.par[j] != j { j = x.par[j]; }
    return j;
}

// Get-or-add the union-find slot for (rv, col); returns its slot index.
fn wx_slot(x: &mut WardX, rv: str, col: str) -> i64 {
    let mut i: i64 = 0i64;
    while i < x.nvar {
        if str_eq(x.vv[i], rv) && str_eq(x.vc[i], col) { return i; }
        i = i + 1i64;
    }
    if x.nvar >= WX_CAP() { return x.nvar - 1i64; }
    let s: i64 = x.nvar;
    x.vv[s] = rv; x.vc[s] = col; x.par[s] = s;
    x.nvar = x.nvar + 1i64;
    return s;
}

// The variable id (union-find root) of (rv, col).
fn wx_class(x: &mut WardX, rv: str, col: str) -> i64 {
    let s: i64 = wx_slot(x, rv, col);
    return wx_find(x, s);
}

fn wx_union(x: &mut WardX, ra: str, ca: str, rb: str, cb: str) {
    let a: i64 = wx_slot(x, ra, ca);
    let b: i64 = wx_slot(x, rb, cb);
    let fa: i64 = wx_find(x, a);
    let fb: i64 = wx_find(x, b);
    if fa != fb { x.par[fa] = fb; }
}

// Get-or-add an EDB predicate for source `src`; -1 on capacity overflow.
fn wx_edb_pid(x: &mut WardX, wp: &mut WardProg, src: str) -> i64 {
    let mut i: i64 = 0i64;
    while i < x.nedb {
        if str_eq(x.esrc[i], src) { return x.epid[i]; }
        i = i + 1i64;
    }
    if wp.npred >= 16i64 { return -1i64; }
    let pid: i64 = wp.add_pred(6i64);   // EDB positions are never affected → arity 6, unused slots CONST
    if x.nedb < 16i64 { x.esrc[x.nedb] = src; x.epid[x.nedb] = pid; x.nedb = x.nedb + 1i64; }
    return pid;
}

// ── SExpr shape probes (existential markers, column refs, bare idents) ────────
fn sx_is_fresh(e: SExpr) -> bool {
    match e {
        SExpr::Call(c) => { return str_eq(c.fn_name, "fresh"); }
        _ => { return false; }
    }
}

// True iff `e` CONTAINS a `fresh(...)` marker anywhere (used to (a) detect an
// existential program and (b) reject a marker buried in an arithmetic head term).
fn sx_has_fresh(e: SExpr) -> bool {
    match e {
        SExpr::Call(c) => {
            if str_eq(c.fn_name, "fresh") { return true; }
            let a: SExprArr = c.args_arr();
            let mut i: i64 = 0i64;
            while i < a.len() { if sx_has_fresh(a.arg_at(i)) { return true; } i = i + 1i64; }
            return false;
        }
        SExpr::Bin(b)  => { return sx_has_fresh(b.lhs_expr()) || sx_has_fresh(b.rhs_expr()); }
        SExpr::Un(u)   => { return sx_has_fresh(u.arg_expr()); }
        SExpr::Cond(c) => { return sx_has_fresh(c.cond_expr()) || sx_has_fresh(c.then_expr()) || sx_has_fresh(c.else_expr()); }
        SExpr::Tuple(tp) => {
            let it: SExprArr = tp.items_arr();
            let mut i: i64 = 0i64;
            while i < it.len() { if sx_has_fresh(it.arg_at(i)) { return true; } i = i + 1i64; }
            return false;
        }
        SExpr::Field(f) => {
            if f.base.any().is_null() { return false; }
            return sx_has_fresh(f.base_expr());
        }
        _ => { return false; }
    }
}

// Decode `rv.col` (an SField whose base is a simple root var); ok=false otherwise.
fn sx_colref(e: SExpr) -> ColRef {
    match e {
        SExpr::Field(f) => {
            if f.base.any().is_null() { return ColRef { ok: false, rv: "", col: "" }; }
            let base: SExpr = f.base_expr();
            let rv: str = root_ident_name(base);
            if rv.len() > 0i64 { return ColRef { ok: true, rv: rv, col: f.name }; }
            return ColRef { ok: false, rv: "", col: "" };
        }
        _ => { return ColRef { ok: false, rv: "", col: "" }; }
    }
}

// A bare identifier (null-base field or comprehension var), or "" if `e` is not one.
fn sx_bare_ident(e: SExpr) -> str {
    match e {
        SExpr::Field(f) => { if f.base.any().is_null() { return f.name; } return ""; }
        SExpr::Var(v)   => { return v.name; }
        _ => { return ""; }
    }
}

// The existential var id for a `fresh(...)` marker: `fresh(z)` reuses a per-rule
// id keyed by the name `z`; bare `fresh()` mints a unique id each occurrence.
fn wx_fresh_id(x: &mut WardX, c: SCall) -> i64 {
    let a: SExprArr = c.args_arr();
    if a.len() >= 1i64 {
        let nm: str = sx_bare_ident(a.arg_at(0i64));
        if nm.len() > 0i64 {
            let mut i: i64 = 0i64;
            while i < x.nexn { if str_eq(x.exn[i], nm) { return x.exi[i]; } i = i + 1i64; }
            let id: i64 = x.exctr; x.exctr = x.exctr + 1i64;
            if x.nexn < 12i64 { x.exn[x.nexn] = nm; x.exi[x.nexn] = id; x.nexn = x.nexn + 1i64; }
            return id;
        }
    }
    let id: i64 = x.exctr; x.exctr = x.exctr + 1i64;
    return id;
}

// Fold every `a == b` equality of a join `on` predicate (descending `&&`) into
// the union-find: shared Datalog variables come EXACTLY from the equi-`on` set
// (non-equi / arithmetic residuals contribute no unions — C2).
fn wx_collect_on(x: &mut WardX, e: SExpr) {
    match e {
        SExpr::Bin(b) => {
            let op: i32 = b.op;
            if op == OP_AND() { wx_collect_on(x, b.lhs_expr()); wx_collect_on(x, b.rhs_expr()); return; }
            if op == OP_EQ() {
                let l: ColRef = sx_colref(b.lhs_expr());
                let r: ColRef = sx_colref(b.rhs_expr());
                if l.ok && r.ok { wx_union(x, l.rv, l.col, r.rv, r.col); }
                return;
            }
        }
        _ => { }
    }
}

// ── Extraction diagnostics ────────────────────────────────────────────────────
fn ward_cap_err() {
    error("wql!: existential (warded) analysis capacity exceeded — the wardedness analyzer supports up to 16 predicates / 16 rules / 6 columns / 6 body atoms per rule");
}
fn ward_frag_err(rn: str) {
    let mut m: String = String::new();
    m.push_str("wql!: rel '");
    m.push_str(rn);
    m.push_str("': an existential (fresh) program cannot use anti-join / traversal / aggregate bodies — outside the positive-TGD fragment the wardedness checker covers");
    error(string_as_str(&m));
}
fn ward_freshpos_err(rn: str) {
    let mut m: String = String::new();
    m.push_str("wql!: rel '");
    m.push_str(rn);
    m.push_str("': fresh() inside an arithmetic head term mints a value — not a clean existential; value-minting in heads is gated separately (termination)");
    error(string_as_str(&m));
}

// One head projection item i → a WardProg head term. Returns 0 (ok), or 2 (a
// fresh buried in arithmetic — value-mint reject).
fn ward_head_item(x: &mut WardX, wp: &mut WardProg, prm: &MacroParams,
                  rel_i: i64, r: i64, i: i64, item: SExpr) -> i32 {
    if sx_is_fresh(item) {
        let mut id: i64 = x.exctr;
        match item { SExpr::Call(c) => { id = wx_fresh_id(x, c); } _ => { } }
        wp.set_head(r, i, id, true);
        return 0i32;
    }
    if sx_has_fresh(item) { ward_freshpos_err(prm.rel_names[rel_i]); return 2i32; }
    let cr: ColRef = sx_colref(item);
    if cr.ok { wp.set_head(r, i, wx_class(x, cr.rv, cr.col), false); }
    // literal / pure arithmetic over consts → CONST (the begin_rule default) — inert.
    return 0i32;
}

// The head of a rule = the body's `select` (a tuple, positionally → declared
// columns 0..arity-1; or a single expr → column 0). Runs AFTER all `on` unions.
fn ward_emit_head(x: &mut WardX, wp: &mut WardProg, prm: &MacroParams,
                  rel_i: i64, r: i64, sel: SExpr) -> i32 {
    let arity: i64 = prm.rel_ccnt[rel_i];
    match sel {
        SExpr::Tuple(tp) => {
            let it: SExprArr = tp.items_arr();
            let n: i64 = it.len();
            let mut i: i64 = 0i64;
            while i < n && i < arity && i < 6i64 {
                let st: i32 = ward_head_item(x, wp, prm, rel_i, r, i, it.arg_at(i));
                if st != 0i32 { return st; }
                i = i + 1i64;
            }
        }
        _ => {
            let st: i32 = ward_head_item(x, wp, prm, rel_i, r, 0i64, sel);
            if st != 0i32 { return st; }
        }
    }
    return 0i32;
}

// One body atom over source (rv, src). A REL source uses DECLARED column ordinals
// (canonical — the affected-position fixpoint keys on them, must line up with the
// existential heads defined for that rel elsewhere — critique C3); an EDB source
// uses first-seen ordinals (EDB positions are never affected). Returns 0 / 1 (cap).
fn ward_emit_atom(x: &mut WardX, wp: &mut WardProg, prm: &MacroParams,
                  r: i64, rv: str, ridx: i64, src: str) -> i32 {
    if wp.nbody[r] >= 6i64 { ward_cap_err(); return 1i32; }
    if ridx >= 0i64 {
        let k: i64 = wp.add_body(r, ridx);
        let coff: i64 = prm.rel_coff[ridx];
        let ccnt: i64 = prm.rel_ccnt[ridx];
        let mut i: i64 = 0i64;
        while i < ccnt && i < 6i64 {
            let cn: str = prm.relc_name[coff + i];
            wp.set_body(r, k, i, wx_class(x, rv, cn));
            i = i + 1i64;
        }
        return 0i32;
    }
    let pid: i64 = wx_edb_pid(x, wp, src);
    if pid < 0i64 { ward_cap_err(); return 1i32; }
    let k: i64 = wp.add_body(r, pid);
    // Fill positions for every (rv, col) already interned (from `on` + head) —
    // first-seen order. An EDB occurrence is an UNaffected witness for its var.
    let mut o: i64 = 0i64;
    let mut si: i64 = 0i64;
    while si < x.nvar {
        if str_eq(x.vv[si], rv) {
            if o >= 6i64 { ward_cap_err(); return 1i32; }
            wp.set_body(r, k, o, wx_find(x, si));
            o = o + 1i64;
        }
        si = si + 1i64;
    }
    return 0i32;
}

// A SIMPLE rel body → one rule (single body atom, no `on`).
fn ward_rule_simple(x: &mut WardX, wp: &mut WardProg, prm: &MacroParams,
                    rel_i: i64, s: RQSimple) -> i32 {
    let r: i64 = wp.begin_rule(rel_i);
    let hst: i32 = ward_emit_head(x, wp, prm, rel_i, r, s.select_expr());
    if hst != 0i32 { return hst; }
    let ridx0: i64 = prm.rel_find_src(s.src_name);
    return ward_emit_atom(x, wp, prm, r, s.var_name, ridx0, s.src_name);
}

// A JOIN rel body → one rule (base + step atoms; `on` equalities are the shared
// Datalog variables). Anti / traversal steps are outside the positive-TGD
// fragment → reject (returns 2).
fn ward_rule_join(x: &mut WardX, wp: &mut WardProg, prm: &MacroParams,
                  rel_i: i64, j: RQJoin) -> i32 {
    let r: i64 = wp.begin_rule(rel_i);
    let steps: RQJoinStepArr = j.steps_arr();
    let ns: i64 = steps.len();
    // 1) fragment guard + collect ALL `on` unions BEFORE any var id is read.
    let mut si: i64 = 0i64;
    while si < ns {
        let st: RQJoinStep = steps.step_at(si);
        if st.is_anti || st.is_edge { ward_frag_err(prm.rel_names[rel_i]); return 2i32; }
        if st.has_on { wx_collect_on(x, st.on_expr()); }
        si = si + 1i64;
    }
    // 2) head (needs final union roots).
    let hst: i32 = ward_emit_head(x, wp, prm, rel_i, r, j.select_expr());
    if hst != 0i32 { return hst; }
    // 3) base atom, then step atoms.
    let ridx0: i64 = prm.rel_find_src(j.a_name);
    let bst0: i32 = ward_emit_atom(x, wp, prm, r, j.x_var, ridx0, j.a_name);
    if bst0 != 0i32 { return bst0; }
    let mut sj: i64 = 0i64;
    while sj < ns {
        let st2: RQJoinStep = steps.step_at(sj);
        let ridxk: i64 = prm.rel_find_src(st2.src_name);
        let bstk: i32 = ward_emit_atom(x, wp, prm, r, st2.var_name, ridxk, st2.src_name);
        if bstk != 0i32 { return bstk; }
        sj = sj + 1i64;
    }
    return 0i32;
}

// Extract the whole rel program into `wp`. Predicate id == rel declaration index
// (so "rel k as a head" and "rel k as a body atom" share affected positions).
// Returns 0 (built), 1 (capacity), 2 (out-of-fragment) — errors already emitted.
fn ward_build(rels: RQRelArr, nr: i64, prm: &MacroParams,
              x: &mut WardX, wp: &mut WardProg, h: &Writ) -> i32 {
    let mut ri: i64 = 0i64;
    while ri < nr {
        let cc: i64 = prm.rel_ccnt[ri];
        if cc > 6i64 { ward_cap_err(); return 1i32; }
        wp.add_pred(cc);
        ri = ri + 1i64;
    }
    let mut rel_i: i64 = 0i64;
    while rel_i < nr {
        let rel: RQRel = rels.rel_at(rel_i);
        let bodies: RQBodyArr = rel.bodies_arr();
        let nb: i64 = bodies.len();
        let mut bi: i64 = 0i64;
        while bi < nb {
            if wp.nrule >= 16i64 { ward_cap_err(); return 1i32; }
            let r: i64 = wp.nrule;
            x.prel[r] = rel_i; x.pbod[r] = bi;
            wardx_reset(x);
            let body_any: WAny = bodies.body_any(bi);
            let q: RQuery = body_any.view::<RQuery>();
            let mut st: i32 = 0i32;
            match q {
                RQuery::Simple(s) => { st = ward_rule_simple(x, wp, prm, rel_i, s); }
                RQuery::Join(jj)  => { st = ward_rule_join(x, wp, prm, rel_i, jj); }
                RQuery::Aggr(_)   => { ward_frag_err(prm.rel_names[rel_i]); st = 2i32; }
                RQuery::Find(_)   => { ward_frag_err(prm.rel_names[rel_i]); st = 2i32; }
            }
            if st != 0i32 { return st; }
            bi = bi + 1i64;
        }
        rel_i = rel_i + 1i64;
    }
    return 0i32;
}

// ── Marker scan ───────────────────────────────────────────────────────────────
struct FreshScan { pub has: bool, pub rel: i64 }

fn program_fresh_scan(rels: RQRelArr, nr: i64) -> FreshScan {
    let mut ri: i64 = 0i64;
    while ri < nr {
        let rel: RQRel = rels.rel_at(ri);
        let bodies: RQBodyArr = rel.bodies_arr();
        let nb: i64 = bodies.len();
        let mut bi: i64 = 0i64;
        while bi < nb {
            let q: RQuery = bodies.body_any(bi).view::<RQuery>();
            let mut hf: bool = false;
            match q {
                RQuery::Simple(s) => { hf = sx_has_fresh(s.select_expr()); }
                RQuery::Join(jj)  => { hf = sx_has_fresh(jj.select_expr()); }
                RQuery::Aggr(g)   => { hf = sx_has_fresh(g.select_expr()); }
                RQuery::Find(_)   => { hf = false; }
            }
            if hf { return FreshScan { has: true, rel: ri }; }
            bi = bi + 1i64;
        }
        ri = ri + 1i64;
    }
    return FreshScan { has: false, rel: 0i64 - 1i64 };
}

// The whole program verdict (called at the walk seam once the registry + deps +
// SCC are complete). Returns true = "keep going / emit"; false = "stop, a
// diagnostic was raised" (both the warded-accept and non-warded cases stop —
// only the message differs; an accepted existential rule is NOT lowered because
// the chase is blocked on the identity foundation).
fn ward_verdict(rels: RQRelArr, nr: i64, prm: &MacroParams, h: &Writ) -> bool {
    let fs: FreshScan = program_fresh_scan(rels, nr);
    if !fs.has { return true; }   // vanilla Datalog → trivially warded, unchanged path.
    let mut wx: WardX = wardx_new();
    let mut wp: WardProg = ward_prog_new();
    let bst: i32 = ward_build(rels, nr, prm, &mut wx, &mut wp, h);
    if bst != 0i32 { return false; }   // capacity / out-of-fragment (already emitted).
    let res: WardResult = check_warded(&wp);
    if res.ok {
        let mut m: String = String::new();
        m.push_str("wql!: rel '");
        m.push_str(prm.rel_names[fs.rel]);
        m.push_str("': existential rule accepted (warded per Gottlob-Pieris); execution not yet supported — blocked on the identity/Skolem-null foundation (ADR 0012). The wardedness verdict is the deliverable; no runnable function is emitted.");
        error(string_as_str(&m));
        return false;
    }
    let mut m2: String = String::new();
    m2.push_str("wql!: rel '");
    m2.push_str(prm.rel_names[wx.prel[res.bad_rule]]);
    m2.push_str("' (body ");
    m2.push_i64(wx.pbod[res.bad_rule] + 1i64);
    m2.push_str("): ");
    m2.push_str(ward_reason_str(res.reason));
    error(string_as_str(&m2));
    return false;
}

// ── Rel-body select IDENT classifier (runs for EVERY rel body, marker or not) ──
// Closes the class where a BARE unbound identifier in a `select` (a typo, not an
// existential) silently fell through to codegen and produced an opaque downstream
// Logos error. A `fresh(...)` marker is NOT a bare ident (it is a Call) → never
// misclassified; the ward path owns markers.
fn ward_var_in(vars: &[str; 9], nv: i64, nm: str) -> bool {
    let mut i: i64 = 0i64;
    while i < nv { if str_eq(vars[i], nm) { return true; } i = i + 1i64; }
    return false;
}

fn ward_sel_idents_ok(sel: SExpr, vars: &[str; 9], nv: i64,
                      prm: &MacroParams, rel_name: str) -> bool {
    match sel {
        SExpr::Field(f) => {
            if !f.base.any().is_null() { return true; }   // `rv.col` — root validated by the emit path.
            let nm: str = f.name;
            if ward_var_in(vars, nv, nm) { return true; }  // whole-row (gated by sel_whole_row_ok).
            if prm.is_scalar(nm) { return true; }          // a bare scalar-param projection.
            let mut m: String = String::new();
            m.push_str("wql!: rel '");
            m.push_str(rel_name);
            m.push_str("': `select ");
            m.push_str(nm);
            m.push_str("`: '");
            m.push_str(nm);
            m.push_str("' is not a bound row column, scalar param, or fresh() marker — did you mean a column (`<var>.");
            m.push_str(nm);
            m.push_str("`) or an existential (`fresh()`)?");
            error(string_as_str(&m));
            return false;
        }
        SExpr::Var(v) => {
            let nm: str = v.name;
            if ward_var_in(vars, nv, nm) { return true; }
            if prm.is_scalar(nm) { return true; }
            let mut m: String = String::new();
            m.push_str("wql!: rel '");
            m.push_str(rel_name);
            m.push_str("': `select ");
            m.push_str(nm);
            m.push_str("`: '");
            m.push_str(nm);
            m.push_str("' is not a bound row column, scalar param, or fresh() marker — did you mean a column (`<var>.");
            m.push_str(nm);
            m.push_str("`) or an existential (`fresh()`)?");
            error(string_as_str(&m));
            return false;
        }
        SExpr::Tuple(tp) => {
            let it: SExprArr = tp.items_arr();
            let mut i: i64 = 0i64;
            while i < it.len() {
                if !ward_sel_idents_ok(it.arg_at(i), vars, nv, prm, rel_name) { return false; }
                i = i + 1i64;
            }
            return true;
        }
        SExpr::Bin(b)  => { return ward_sel_idents_ok(b.lhs_expr(), vars, nv, prm, rel_name) && ward_sel_idents_ok(b.rhs_expr(), vars, nv, prm, rel_name); }
        SExpr::Un(u)   => { return ward_sel_idents_ok(u.arg_expr(), vars, nv, prm, rel_name); }
        SExpr::Cond(c) => {
            return ward_sel_idents_ok(c.cond_expr(), vars, nv, prm, rel_name)
                && ward_sel_idents_ok(c.then_expr(), vars, nv, prm, rel_name)
                && ward_sel_idents_ok(c.else_expr(), vars, nv, prm, rel_name);
        }
        SExpr::Call(c) => {
            if str_eq(c.fn_name, "fresh") { return true; }   // marker — owned by the ward path.
            let a: SExprArr = c.args_arr();
            let mut i: i64 = 0i64;
            while i < a.len() {
                if !ward_sel_idents_ok(a.arg_at(i), vars, nv, prm, rel_name) { return false; }
                i = i + 1i64;
            }
            return true;
        }
        _ => { return true; }   // Lit / Param / Comp
    }
}

// ── The PROGRAM walker entry ─────────────────────────────────────────────────
// `root` is the RQProgram envelope the generated parser export returns. The
// String buffers backing the rel registry (emitted source names + row-type
// texts) and the prelude live in THIS frame — everything downstream is called
// from here, so the borrowed `str` views stay valid for the whole walk.
pub fn walk_program_params(root: WAny, name: str, params_text: str,
                           natspec: str, prm: &mut MacroParams, h: &Writ) -> bool {
    if root.is_null() { error("wql!: empty query plan"); return false; }
    let prog: RQProgram = root.view::<RQProgram>();
    // The query is a source, and every check downstream may need to say where
    // it is (ADR 0024 S0). Carried in the walker's context because that is what
    // a diagnostic has in hand, wherever it fires.
    prm.src_root = root;
    let mut deps: RelDeps = rel_deps_new();
    let mut scc: RelScc = rel_scc_new();
    let mut src_bufs: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    let mut dsrc_bufs: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                      String::new(), String::new(), String::new(), String::new()];
    let mut row_bufs: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                     String::new(), String::new(), String::new(), String::new()];
    // Frame-held name backing for NATIVE rels (ADR 0016 M1a) — same lifetime
    // discipline as src_bufs/dsrc_bufs above.
    let mut nat_src_bufs: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                         String::new(), String::new(), String::new(), String::new()];
    // Frame-held backing for a chosen narrowing's constant (ADR 0024 S6.3) —
    // same lifetime discipline as the buffers above.
    let mut pick_argb: String = String::new();
    let mut nat_dsrc_bufs: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                          String::new(), String::new(), String::new(), String::new()];
    let mut nat_name_bufs: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                          String::new(), String::new(), String::new(), String::new()];
    // The STREAM binding names (`__rel_<r>`), same discipline again.
    let mut nat_ssrc_bufs: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                          String::new(), String::new(), String::new(), String::new()];
    // The SIZE binding names (`__sz_<r>`) — where a measured size lands in the
    // generated fn (ADR 0024 S4). Built in ONE place, so the plan's record and
    // the emitted prelude cannot name it differently.
    let mut nat_szat_bufs: [String; 8] = [String::new(), String::new(), String::new(), String::new(),
                                          String::new(), String::new(), String::new(), String::new()];

    if prog.has_rels() {
        let rels: RQRelArr = prog.rels_arr();
        let nr: i64 = rels.len();
        // ── Pass 1: register every rel (names, columns, row types) ──────────
        let mut i: i64 = 0i64;
        while i < nr {
            let rel: RQRel = rels.rel_at(i);
            let rname: str = rel.name;
            if prm.index_of(rname) >= 0i64 {
                let mut m: String = String::new();
                m.push_str("wql!: rel '");
                m.push_str(rname);
                m.push_str("' collides with a wql! parameter of the same name");
                error(string_as_str(&m));
                return false;
            }
            if prm.rel_find_name(rname) >= 0i64 {
                let mut m1: String = String::new();
                m1.push_str("wql!: duplicate rel name '");
                m1.push_str(rname);
                m1.push_str("'");
                error(string_as_str(&m1));
                return false;
            }
            let cols: RQRelColArr = rel.cols_arr();
            let nc: i64 = cols.len();
            if nc < 1i64 { error("wql!: a rel needs at least one column"); return false; }
            // Validate columns (type whitelist + per-rel name uniqueness).
            let mut k: i64 = 0i64;
            while k < nc {
                let c: RQRelCol = cols.col_at(k);
                if !rel_col_ty_ok(rname, c.name, c.ty_name) { return false; }
                let mut k2: i64 = 0i64;
                while k2 < k {
                    if str_eq(cols.col_at(k2).name, c.name) {
                        let mut m2: String = String::new();
                        m2.push_str("wql!: rel '");
                        m2.push_str(rname);
                        m2.push_str("': duplicate column name '");
                        m2.push_str(c.name);
                        m2.push_str("'");
                        error(string_as_str(&m2));
                        return false;
                    }
                    k2 = k2 + 1i64;
                }
                k = k + 1i64;
            }
            // Emitted source + delta-source names + native row type text
            // (frame-held Strings back the registry's borrowed views).
            src_bufs[i].push_str("__rel_");
            src_bufs[i].push_str(rname);
            src_bufs[i].push_str("_sl");
            dsrc_bufs[i].push_str("__dl_");
            dsrc_bufs[i].push_str(rname);
            dsrc_bufs[i].push_str("_sl");
            if nc == 1i64 {
                row_bufs[i].push_str(cols.col_at(0i64).ty_name);
            } else {
                row_bufs[i].push_str("(");
                let mut k3: i64 = 0i64;
                while k3 < nc {
                    if k3 > 0i64 { row_bufs[i].push_str(", "); }
                    row_bufs[i].push_str(cols.col_at(k3).ty_name);
                    k3 = k3 + 1i64;
                }
                row_bufs[i].push_str(")");
            }
            let idx: i64 = prm.rel_add(rname, string_as_str(&src_bufs[i]),
                                       string_as_str(&dsrc_bufs[i]),
                                       string_as_str(&row_bufs[i]));
            if idx < 0i64 { error("wql!: too many rel blocks (max 8)"); return false; }
            let mut k4: i64 = 0i64;
            while k4 < nc {
                let c4: RQRelCol = cols.col_at(k4);
                prm.rel_add_col(c4.name, c4.ty_name);
                k4 = k4 + 1i64;
            }
            i = i + 1i64;
        }
        // ── NATIVE rels (ADR 0016 M1a): `<p>: &Writ` params register as the
        // generic graph-edge relation AFTER the parse-side rels (registry
        // idx 0..nr-1 must stay parse-aligned — emit_rel_fns indexes rel_at
        // by registry idx), BEFORE the body pass (bodies may reference them).
        if !register_native_rels(prm, natspec, &mut nat_src_bufs, &mut nat_dsrc_bufs, &mut nat_name_bufs, &mut nat_ssrc_bufs, &mut nat_szat_bufs) { return false; }
        let mut pick_ap: AccessPlan = plan_decide_access(prm, &mut pick_argb);
        plan_decide_joins(prm, h);
        plan_mark_single_pass(prm, &mut pick_ap);
        access_plan_decide_mode(&mut pick_ap, prm);
        access_plan_ask_size(&mut pick_ap, prm);
        plan_apply_access(prm, &pick_ap, h);
        // ── Pass 2: validate + resolve + rewrite every body ─────────────────
        // (The registry is complete, so self/forward/mutual references RESOLVE
        // — recursion is legal, realized by the SCC fixpoint. Dep edges + the
        // anti/aggregate sub-edges recorded for the condensation below.)
        let mut i2: i64 = 0i64;
        while i2 < nr {
            let rel2: RQRel = rels.rel_at(i2);
            let bodies: RQBodyArr = rel2.bodies_arr();
            let nb: i64 = bodies.len();
            if nb < 1i64 { error("wql!: a rel needs at least one body"); return false; }
            let mut b: i64 = 0i64;
            while b < nb {
                if !check_rel_body(bodies.body_any(b), rel2.name, i2, prm, &mut deps, h) {
                    return false;
                }
                b = b + 1i64;
            }
            i2 = i2 + 1i64;
        }
        // ── Condense + stratify (slice C) ───────────────────────────────────
        // (Over the FULL registry incl. native rels — they are body-less
        // singleton leaves, topo-ordered before their dependents.)
        scc = compute_rel_scc(&deps, prm.rel_n);
        if !check_stratified(prm, &deps, &scc) { return false; }
        // ── Track A: warded Datalog± existential-head verdict ───────────────
        // (Runs on the COMPLETE registry/deps/SCC, before any emission. Vanilla
        // Datalog — no `fresh(...)` marker — takes the fast path unchanged; an
        // existential program is classified and GRACEFULLY refuses lowering.)
        if !ward_verdict(rels, nr, prm, h) { return false; }
    } else {
        // No parse-side rels — native params may still register (an entry
        // query scanning `g` directly); condense the body-less registry so
        // the prelude loop below materializes them.
        if !register_native_rels(prm, natspec, &mut nat_src_bufs, &mut nat_dsrc_bufs, &mut nat_name_bufs, &mut nat_ssrc_bufs, &mut nat_szat_bufs) { return false; }
        let mut pick_ap: AccessPlan = plan_decide_access(prm, &mut pick_argb);
        plan_decide_joins(prm, h);
        plan_mark_single_pass(prm, &mut pick_ap);
        access_plan_decide_mode(&mut pick_ap, prm);
        access_plan_ask_size(&mut pick_ap, prm);
        plan_apply_access(prm, &pick_ap, h);
        if prm.rel_n > 0i64 {
            scc = compute_rel_scc(&deps, prm.rel_n);
        }
    }

    // ── The ENTRY query: stamp fn name + resolve/rewrite sources ────────────
    let entry_any: WAny = prog.entry_any();
    if entry_any.is_null() { error("wql!: missing entry query"); return false; }
    let eplan: RQuery = entry_any.view::<RQuery>();
    let mut relvars: [str; 9] = ["", "", "", "", "", "", "", "", ""];
    let mut nrelv: i64 = 0i64;
    match eplan {
        RQuery::Simple(_) => {
            let s: RQSimple = rq_fat_simple(entry_any, h);
            s.fn_name = name;
            let sr: SrcRes = resolve_source(prm, s.src_name, -1i64, &mut deps);
            if !sr.ok { return false; }
            if sr.is_rel {
                s.src_name = prm.rel_srcs[sr.idx];
                relvars[0] = s.var_name;
                nrelv = 1i64;
            }
            s.row_ty = sr.row_ty;
            if !sel_whole_row_ok(s.select_expr(), &relvars, nrelv) { return false; }
        }
        RQuery::Join(_) => {
            let j: RQJoin = rq_fat_join(entry_any, h);
            j.fn_name = name;
            let sr2: SrcRes = resolve_source(prm, j.a_name, -1i64, &mut deps);
            if !sr2.ok { return false; }
            if sr2.is_rel {
                j.a_name = prm.rel_srcs[sr2.idx];
                relvars[0] = j.x_var;
                nrelv = 1i64;
            }
            j.a_ty = sr2.row_ty;
            let mut svars: [str; 9] = ["", "", "", "", "", "", "", "", ""];
            let mut nsv: i64 = 0i64;
            if !stamp_steps(j.steps_arr(), j.x_var, sr2.row_ty, prm, -1i64, &mut deps,
                            &mut relvars, &mut nrelv, &mut svars, &mut nsv, h) { return false; }
            if !sel_whole_row_ok(j.select_expr(), &relvars, nrelv) { return false; }
            // Scalar-element traversal vars: no field access rooted at them.
            if nsv > 0i64 {
                if !no_scalar_field(j.select_expr(), &svars, nsv) { return false; }
                if j.has_where {
                    if !no_scalar_field(j.where_expr(), &svars, nsv) { return false; }
                }
                if j.has_order {
                    if !no_scalar_field(j.order_expr(), &svars, nsv) { return false; }
                }
                if !steps_scalar_ok(j.steps_arr(), &svars, nsv) { return false; }
            }
        }
        RQuery::Aggr(_) => {
            let g: RQAggr = rq_fat_aggr(entry_any, h);
            g.fn_name = name;
            let sr3: SrcRes = resolve_source(prm, g.a_name, -1i64, &mut deps);
            if !sr3.ok { return false; }
            if sr3.is_rel {
                g.a_name = prm.rel_srcs[sr3.idx];
                relvars[0] = g.x_var;
                nrelv = 1i64;
            }
            g.a_ty = sr3.row_ty;
            // Optional join steps — the aggregate over a JOINED stream.
            if g.has_steps() {
                let mut svars2: [str; 9] = ["", "", "", "", "", "", "", "", ""];
                let mut nsv2: i64 = 0i64;
                if !stamp_steps(g.steps_arr(), g.x_var, sr3.row_ty, prm, -1i64, &mut deps,
                                &mut relvars, &mut nrelv, &mut svars2, &mut nsv2, h) { return false; }
                if nsv2 > 0i64 {
                    if !no_scalar_field(g.select_expr(), &svars2, nsv2) { return false; }
                    if !no_scalar_field(g.key_expr(), &svars2, nsv2) { return false; }
                    if g.has_where {
                        if !no_scalar_field(g.where_expr(), &svars2, nsv2) { return false; }
                    }
                    if g.has_having {
                        if !no_scalar_field(g.having_expr(), &svars2, nsv2) { return false; }
                    }
                    if g.has_order {
                        if !no_scalar_field(g.order_expr(), &svars2, nsv2) { return false; }
                    }
                    let gaggs: RQAggArr = g.aggs_arr();
                    let mut ga: i64 = 0i64;
                    while ga < gaggs.len() {
                        let a: RQAgg = gaggs.agg_at(ga);
                        if a.has_arg {
                            if !no_scalar_field(a.arg_expr(), &svars2, nsv2) { return false; }
                        }
                        ga = ga + 1i64;
                    }
                    if !steps_scalar_ok(g.steps_arr(), &svars2, nsv2) { return false; }
                }
            }
        }
        RQuery::Find(_) => {
            let f: RQFind = rq_fat_find(entry_any, h);
            f.fn_name = name;
            let sr4: SrcRes = resolve_source(prm, f.src_name, -1i64, &mut deps);
            if !sr4.ok { return false; }
            if sr4.is_rel {
                // `find` returns Option<&Row> — a borrow of a fn-LOCAL rel row
                // would dangle at return. Gated with a diagnostic (the
                // by-value alternative is `select first (…columns…)`).
                let mut m: String = String::new();
                m.push_str("wql!: `find` over rel '");
                m.push_str(f.src_name);
                m.push_str("' is not supported — rels are locals of the generated fn, so borrowing a row out is unsound; use `select first (…columns…)` instead");
                error(string_as_str(&m));
                return false;
            }
            f.row_ty = sr4.row_ty;
        }
    }

    // ── Emit the rel helper fns + build the entry prelude ───────────────────
    // Materialization order = the condensation TOPO order (dependencies first
    // — declaration order no longer implies evaluability once forward/mutual
    // references are legal). One-shot SCCs call the slice-B per-rel helper;
    // recursive SCCs call the semi-naïve SCC fn (member Vecs as out-params).
    let mut prelude: String = String::new();
    if prm.rel_n > 0i64 {
        // helper fns exist only for PARSE-SIDE rels (native rels materialize
        // via their stdlib helper in the prelude — nothing to emit).
        if prog.has_rels() {
            if !emit_rel_fns(prog.rels_arr(), name, params_text, prm, &scc, h) { return false; }
        }
        let mut p: i64 = 0i64;
        while p < scc.nscc {
            let c: i64 = scc.order[p];
            if scc.rec[c] {
                emit_prelude_scc(&mut prelude, name, prm, &scc, c);
            } else {
                let mut r: i64 = 0i64;
                while r < prm.rel_n {
                    if scc.comp[r] == c { emit_prelude_oneshot(&mut prelude, name, prm, &scc, r); }
                    r = r + 1i64;
                }
            }
            p = p + 1i64;
        }
    }
    return walk_query(entry_any.view::<RQuery>(), params_text, prm,
                      string_as_str(&prelude), h);
}

// Push the wql! param names + the `__rel_<j>_sl` slices selected by `mask`
// (ascending rel index) as a call ARGUMENT list (no parens) — mirrors the
// helper-fn parameter lists emit_rel_fns builds from the same masks.
fn push_call_args(out: &mut String, prm: &MacroParams, mask: i64) {
    let mut first: bool = true;
    let mut a: i64 = 0i64;
    while a < prm.n {
        if !first { out.push_str(", "); }
        out.push_str(prm.names[a]);
        first = false;
        a = a + 1i64;
    }
    let mut j: i64 = 0i64;
    while j < prm.rel_n {
        if (mask & (1i64 << j)) != 0i64 {
            if !first { out.push_str(", "); }
            out.push_str(prm.rel_srcs[j]);
            first = false;
        }
        j = j + 1i64;
    }
}

// ── NATIVE rels (ADR 0016 M1a): register each `<p>: &Writ` param as the
// generic graph-edge relation of the writ_graph vocabulary. Registered AFTER
// the parse-side rels (registry idx 0..nr-1 stays parse-aligned) and BEFORE
// the body pass (bodies may scan them). Column names/types mirror
// logos.std.wql.writ_graph::WritEdgeRow.
// Register ONE native rel; returns its registry idx or −1 (cap/dup errors
// surfaced by the caller). `disp` = the rel's DECLARED name text (backed by
// the caller's frame Strings).
fn reg_native(prm: &mut MacroParams, disp: str, rowty: str,
              mat: str, marg: str, marg2: str, module: str, iter: bool,
              ity: str, szfn: str, szty: str,
              srcb: &mut String, dsrcb: &mut String, ssrcb: &mut String,
              szatb: &mut String) -> i64 {
    srcb.push_str("__rel_");
    srcb.push_str(disp);
    srcb.push_str("_sl");
    dsrcb.push_str("__dl_");
    dsrcb.push_str(disp);
    dsrcb.push_str("_sl");
    // The STREAM binding names the iterator itself — no `_sl`, because it is
    // not a slice and generated code that says otherwise misleads its reader.
    ssrcb.push_str("__rel_");
    ssrcb.push_str(disp);
    // The SIZE binding — a number, not rows, so it shares neither name.
    if szfn.len() > 0i64 {
        szatb.push_str("__sz_");
        szatb.push_str(disp);
    }
    let idx: i64 = prm.rel_add(disp, string_as_str(srcb), string_as_str(dsrcb), rowty);
    if idx >= 0i64 {
        prm.rel_native[idx] = true;
        prm.rel_iter[idx]   = iter;
        prm.rel_itty[idx]   = ity;
        prm.rel_ssrc[idx]   = string_as_str(ssrcb);
        prm.rel_size_fn[idx] = szfn;
        prm.rel_size_ty[idx] = szty;
        prm.rel_size_at[idx] = string_as_str(szatb);
        prm.rel_mat[idx] = mat;
        prm.rel_marg[idx] = marg;
        prm.rel_marg2[idx] = marg2;
        prm.rel_mod[idx] = module;
    }
    return idx;
}

// Register the NATIVE source rels described by the compiler's natspec
// (ADR 0016 §6). The walker knows NO source type any more — which params carry
// relations, their columns, and the materializer to call all arrive as data:
//   <regname>=<matfn>[@<module>]:<param>(<col> <ty>,…);
// The spec str outlives the walk (handler frame), so views into it are stable.
// rowty is BUILT here ("(ty1, ty2, …)") into the caller's frame buffers — the
// registry may borrow them for the walk's duration (plan writes intern, the
// registry is rebuilt per walk).
// ── the DEMAND ⋈ the source's DECLARED OPERATIONS (ADR 0024 S6.3) ───────────
//
// The planner is Deem's. What a source can do arrives as data (S6.2), and the
// choice is made HERE, against what the source declared — not by a name a
// planner knows by convention, and not inside the container's own handler.

/// The column named by a root-shaped field reference (`e.key`), or "".
fn pw_field_col(e: SExpr) -> str {
    match e {
        SExpr::Field(f) => {
            let br: WRef<SExpr> = f.base;
            if br.any().is_null() { return ""; }
            return f.name;
        }
        _ => { return ""; }
    }
}

/// The BARE NAME an expression refers to, or "" if it refers to none.
///
/// The mirror of `pw_field_col`, and the pair is the point: a bare identifier
/// reaches the IR as an `SField` whose base is NULL, so `pw_field_col` rejects it
/// by exactly the test this one requires. `SParam` and `SVar` are accepted too —
/// which node kind a name arrives as depends on how far resolution has got, and
/// guessing it is how the parameter case was missed twice. Whether the name is a
/// query PARAMETER is not decided here; `MacroParams::ty_of` is the authority.
fn pw_bare_name(e: SExpr) -> str {
    match e {
        SExpr::Field(f) => {
            let br: WRef<SExpr> = f.base;
            if br.any().is_null() { return f.name; }
            return "";
        }
        SExpr::Param(p) => { return p.name; }
        SExpr::Var(v)   => { return v.name; }
        _ => { return ""; }
    }
}

/// The comparison class name for an EL operator, read FROM the column's point
/// of view. `col_left = false` mirrors it: `42 > e.key` is `key < 42`.
fn pw_cmp_name(op: i32, col_left: bool) -> str {
    let mut o: i32 = op;
    if !col_left {
        if o == OP_LT() { o = OP_GT(); }
        else if o == OP_LE() { o = OP_GE(); }
        else if o == OP_GT() { o = OP_LT(); }
        else if o == OP_GE() { o = OP_LE(); }
    }
    if o == OP_EQ() { return "eq"; }
    if o == OP_GE() { return "ge"; }
    if o == OP_LE() { return "le"; }
    if o == OP_GT() { return "gt"; }
    if o == OP_LT() { return "lt"; }
    return "";
}

/// DECIDE the access for every rel, and change nothing.
///
/// The whole point of returning a plan instead of writing one is that this
/// function is READ-ONLY over `prm`: between deciding and applying there is now
/// a moment at which the plan exists and the query has not been rewritten, and
/// that moment is where cost, EXPLAIN, and any decision that depends on another
/// have to live.
///
/// The QUERY SHAPE is read here and nowhere below it. A filter is a filter: a
/// `where e.key >= 100` narrows the same way whether it sits in a simple scan,
/// a join or an aggregate, and matching on the shape at every level is how the
/// narrowing came to exist for one of the three. What the shape DOES decide is
/// whether the residual filter may be retired — see `plan_narrow_rel`.
// `argb` is FRAME-HELD by the caller: the narrowing constant's text outlives
// this call as `AccessPlan.arg` and then as `rel_marg2`, and a local String here
// would leave a dangling view the moment the frame goes — the same discipline
// nat_src_bufs follows.
fn plan_decide_access(prm: &MacroParams, argb: &mut String) -> AccessPlan {
    let mut ap: AccessPlan = access_plan_new(prm.rel_n);
    if prm.src_root.is_null() { return ap; }
    let prog: RQProgram = prm.src_root.view::<RQProgram>();
    match prog.entry_any().view::<RQuery>() {
        RQuery::Simple(sq) => {
            // A simple scan is the ONE shape whose `where` belongs entirely to
            // its single source, so an exact operation may retire it.
            plan_narrow_rel(prm, argb, &mut ap, sq.src_name, sq.has_where,
                            sq.where_expr(), true);
        }
        RQuery::Join(jq) => {
            // The BASE carries the query's `where`. Retiring it is NOT offered:
            // the predicate is checked once per JOINED row, over variables from
            // every side, and proving the base's narrowing subsumes it is a
            // different claim from the one exactness makes.
            plan_narrow_rel(prm, argb, &mut ap, jq.a_name, jq.has_where,
                            jq.where_expr(), false);
        }
        RQuery::Aggr(gq) => {
            plan_narrow_rel(prm, argb, &mut ap, gq.a_name, gq.has_where,
                            gq.where_expr(), false);
        }
        _ => { }
    }
    return ap;
}

/// Narrow ONE rel against ONE filter, recording the choice and its ground.
///
/// `may_drop` is the shape's contribution and the only one: whether an access
/// that is EXACT for the demand is allowed to retire the query's own filter.
fn plan_narrow_rel(prm: &MacroParams, argb: &mut String, ap: &mut AccessPlan,
                   src_name: str, has_where: bool, wexpr: SExpr,
                   may_drop: bool) {
    let ri: i64 = prm.rel_find_name(src_name);
    if ri < 0i64 { return; }
    if !has_where {
        ap.scan(ri, "the query asks for every row — no filter to narrow to");
        return;
    }
    if prm.op_cnt[ri] == 0i64 {
        ap.scan(ri, "the source declares no access operations");
        return;
    }
    match wexpr {
        SExpr::Bin(b) => {
            let mut col: str = pw_field_col(b.lhs_expr());
            let mut col_left: bool = col.len() > 0i64;
            if !col_left { col = pw_field_col(b.rhs_expr()); }
            if col.len() == 0i64 {
                ap.scan(ri, "neither side of the filter is a column");
                return;
            }
            // The column must belong to THIS rel. In a join the `where` ranges
            // over every bound variable, so a filter on another side names a
            // column this source may happen to have too — narrowing on it would
            // be answering a different question.
            let cti: i64 = prm.rel_coff[ri];
            let cn: i64 = prm.rel_ccnt[ri];
            let mut colty: str = "";
            let mut c0: i64 = 0i64;
            while c0 < cn {
                if str_eq(prm.relc_name[cti + c0], col) {
                    colty = prm.relc_ty[cti + c0];
                    c0 = cn;
                } else { c0 = c0 + 1i64; }
            }
            if colty.len() == 0i64 {
                ap.scan(ri, "the filter names a column this source does not have");
                return;
            }
            // The BOUND the column is compared against.
            //
            // ⚠ This used to demand a LITERAL, with a comment saying "a
            // narrowing needs the VALUE, not just the shape". That was an
            // assumption, not a requirement, and it cost every parameterised
            // range query its narrowing: a declared operation takes the bound as
            // an ARGUMENT, and an argument may be a query PARAMETER just as well
            // as a constant — `lo` is in scope in the generated fn exactly where
            // `100u64` would be. `from m e where e.key >= lo …` scanned the whole
            // container for no reason but this.
            //
            // 1 = a literal (emitted with the COLUMN's type, which is why the
            // column types had to stop being i64 first), 2 = a parameter
            // (emitted by name).
            let mut argk: i32 = 0i32;
            let mut lit: i64 = 0i64;
            let mut pnm: str = "";
            match b.rhs_expr() {
                SExpr::Lit(l) => {
                    let w: WAny = l.val;
                    if w.is_int() { argk = 1i32; lit = w.as_i64(); }
                }
                _ => { }
            }
            if argk == 0i32 {
                match b.lhs_expr() {
                    SExpr::Lit(l2) => {
                        let w2: WAny = l2.val;
                        if w2.is_int() { argk = 1i32; lit = w2.as_i64(); }
                    }
                    _ => { }
                }
            }
            // Not a literal — then a NAME, if the side opposite the column is
            // one. `pw_bare_name` is the mirror of `pw_field_col`: a bare
            // identifier is an `SField` with a NULL base, which is precisely
            // what makes it not a column.
            if argk == 0i32 {
                pnm = pw_bare_name(if col_left { b.rhs_expr() } else { b.lhs_expr() });
                if pnm.len() > 0i64 { argk = 2i32; }
            }
            if argk == 0i32 {
                ap.scan(ri, "the comparison carries no bound a source could be given");
                return;
            }
            // A PARAMETER is passed by name, so its type must BE the column's —
            // there is no literal here for the emitter to re-type. A mismatch
            // would reach the host compiler as a bad argument to a generated
            // call, which is the diagnostic this ADR exists to abolish.
            if argk == 2i32 {
                let pty: str = prm.ty_of(pnm);
                if pty.len() == 0i64 {
                    ap.scan(ri, "the bound is not a query parameter this fn takes");
                    return;
                }
                if !str_eq(pty, colty) {
                    ap.scan(ri, "the parameter's type is not the column's, so it cannot be passed as the bound");
                    return;
                }
            }
            let cmp: str = pw_cmp_name(b.op, col_left);
            if cmp.len() == 0i64 {
                ap.scan(ri, "the filter is not a comparison a source can answer");
                return;
            }
            // ENUMERATE, then CHOOSE. Every declared operation that covers the
            // demand is a candidate; the narrowest wins, and exactness breaks a
            // tie because an exact access also retires the filter. What this
            // replaces is a SEARCH whose order was the choice — first
            // exact-comparison hit, else one hardcoded weakening — which meant a
            // source could not improve its own plan by declaring more.
            let off: i64 = prm.op_off[ri];
            let cnt: i64 = prm.op_cnt[ri];
            let mut oi: i64 = -1i64;
            let mut best: i32 = CARD_ALL();
            let mut best_ex: bool = false;
            let mut k: i64 = 0i64;
            while k < cnt {
                let o: i64 = off + k;
                if str_eq(prm.opc_col[o], col) && ap_covers(prm.opc_cmp[o], cmp) {
                    let c: i32 = ap_card_of_cmp(prm.opc_cmp[o]);
                    let ex: bool = prm.rel_op_is_exact(o, cmp);
                    if oi < 0i64 || (c as i64) < (best as i64)
                        || ((c as i64) == (best as i64) && ex && !best_ex) {
                        oi = o; best = c; best_ex = ex;
                    }
                }
                k = k + 1i64;
            }
            if oi < 0i64 {
                ap.scan(ri, "the source declares no operation covering that comparison on that column");
                return;
            }
            // The constant is typed by the COLUMN, which is why the column
            // types had to stop being i64 first (S2/S3). A parameter carries its
            // own type and is passed by name.
            if argk == 1i32 {
                argb.push_i64(lit);
                argb.push_str(colty);
            } else {
                argb.push_str(pnm);
            }
            // EXACTNESS (ADR 0024 S6): when the operation returns precisely the
            // rows of THIS comparison, the query's own filter re-tests what the
            // source already decided. Retiring it is a REWRITE — the query said
            // "filter", the planner proved it redundant — and it is sound only
            // because the demand IS this comparison AND the filter belongs to
            // this source alone, which is what `may_drop` carries.
            let drops: bool = best_ex && may_drop;
            ap.choose(ri, oi, prm.opc_fn[oi], string_as_str(argb), col, cmp,
                      prm.opc_cmp[oi], best_ex,
                      if drops
                      { "an operation EXACT for that comparison — the residual filter is redundant and was dropped" }
                      else if best_ex
                      { "an operation exact for that comparison, but the filter ranges over more than this source, so it stays" }
                      else { "a covering operation; its rows are a superset, so the filter stays" });
            if drops { ap.drop_where = true; }
        }
        _ => { }
    }
}

// ── THE JOIN-STRATEGY DECISION (ADR 0024 S4) ──────────────────────────────
// Decide how each join step will read its source, and record the answer ON the
// step, BEFORE the prelude is built. Two of the three strategies (hash, tree)
// index the step's source in a single pass and then probe the index; only a
// nested loop rescans. That is the fact `plan_mark_single_pass` needs and could
// not have while the cascade ran inside the emitter, one phase too late.
//
// Deciding is read-only over the params and writes nothing but the decision.
//
// ⚠ The type environment must be the emitter's. The rule types the equi-key's
// two sides and rejects a mixed-type `==`, so a key that types differently on
// the two sides would select a different strategy — and since the emitter now
// READS this answer, a wrong one is not a slower plan but a hash index built
// with the wrong key type, or worse, a rescan promised as a single read. The
// stamping order below mirrors `emit_join_chain` exactly: per source, schema
// then rel columns, then the scalar params, then the module's UDF returns.

/// Seed one source's contribution to the type dict, from the UNSTAMPED query
/// node (`resolve_source` has not run yet, so the node still names the rel).
fn plan_stamp_src(t: &mut ElTypes, view: &OView, prm: &MacroParams, src: str, var: str) {
    let pi: i64 = prm.index_of(src);
    if pi >= 0i64 && prm.is_slice[pi] {
        stamp_types_from_schema(view, t, prm.tys[pi]);
        return;
    }
    let ri: i64 = prm.rel_find_name(src);
    if ri >= 0i64 { let _b: bool = stamp_rel_columns(t, view, prm, ri, var); return; }
    // An already-rewritten source name (the idempotent re-walk) or an unknown
    // one: the later resolve reports it. Nothing to stamp, and a step whose
    // sides do not type stays a nested loop, which is the safe answer.
    let si: i64 = prm.rel_find_src(src);
    if si >= 0i64 { let _b2: bool = stamp_rel_columns(t, view, prm, si, var); }
}

/// Decide every classic step of ONE chain and stamp the decision on the nodes.
///
/// Traversal (`is_edge`) steps are nested loops by construction. They also STOP
/// the walk: a traversal binds a row var whose element type the planner cannot
/// reflect before `stamp_edge_step` has run, so any later step's `on` may
/// reference a name this type dict does not have. Deciding it anyway would risk
/// a key typed here and typed differently there. Later steps are left
/// `JS_NONE`; `plan_mark_single_pass` reads that as "not proven read-once".
fn plan_decide_chain(prm: &MacroParams, view: &OView,
                     base_src: str, base_var: str,
                     steps: RQJoinStepArr, h: &Writ) {
    let mut t: ElTypes = el_types_new();
    plan_stamp_src(&mut t, view, prm, base_src, base_var);
    let ns: i64 = steps.len();
    let mut i: i64 = 0i64;
    while i < ns {
        let st0: RQJoinStep = steps.step_at(i);
        if st0.is_edge { i = ns; }
        else {
            plan_stamp_src(&mut t, view, prm, st0.src_name, st0.var_name);
            i = i + 1i64;
        }
    }
    apply_scalar_params(&mut t, view, prm);
    stamp_udfs_from_module(view, &mut t);
    let mut k: i64 = 0i64;
    while k < ns {
        let st: RQJoinStep = rq_fat_step(steps.step_any(k), h);
        if st.is_edge {
            let ts: StepSel = traversal_step_sel();
            st.jstrat = ts.strat; st.jkey = ts.key_ty;
            st.jsel = -1i32;      st.jwhy = ts.why;
            return;               // and every step after it stays undecided
        }
        let ss: StepSel = decide_join_step(st.on, st.var_name, &t, h);
        st.jstrat = ss.strat;
        st.jkey   = ss.key_ty;
        st.jsel   = ss.sel as i32;
        st.jwhy   = ss.why;
        // ⚠ THE TYPE ON THE TRACE IS THE ONE THE INDEX IS KEYED IN. It read
        // `el_class_repr(ss.key_ty)` — the class's representative — so a `u64`
        // key was announced as `hash join on i64` while the emitted map is
        // `HashMap<u64, …>`. A justification that names a type the code does not
        // use is not a justification of that code.
        plan_trace(st.var_name, js_name(ss.strat), ss.key_tn, ss.why);
        k = k + 1i64;
    }
}

/// Decide the join steps of the ENTRY query.
///
/// Rel BODIES are not visited: a program with rel blocks materializes every
/// source anyway (a body may scan a native rel any number of times), so no
/// decision of theirs could widen anything. Their nodes stay `JS_NONE` and the
/// emitter decides them by the same rule at emission — stated in `analyze_chain`.
fn plan_decide_joins(prm: &MacroParams, h: &Writ) {
    if prm.src_root.is_null() { return; }
    let prog: RQProgram = prm.src_root.view::<RQProgram>();
    let view: OView = oview_module_ast();
    match prog.entry_any().view::<RQuery>() {
        RQuery::Join(jq) => {
            plan_decide_chain(prm, &view, jq.a_name, jq.x_var, jq.steps_arr(), h);
        }
        RQuery::Aggr(gq) => {
            if gq.has_steps() {
                plan_decide_chain(prm, &view, gq.a_name, gq.x_var, gq.steps_arr(), h);
            }
        }
        _ => { }
    }
}

/// Which rels does this plan read EXACTLY ONCE?
///
/// The conservative direction is fixed by what a wrong answer costs: a wrong
/// `false` gives a slower plan, a wrong `true` gives a plan that reads a
/// consumed iterator. So every `true` here must be a fact about the emitted
/// shape, not an expectation about it.
///
///   • SIMPLE — the lone source is scanned once, unless `order by` revisits
///     rows by position after collecting them, or a graph path lowers it to a
///     join chain.
///   • JOIN — the BASE is the outermost loop of a left-deep nest, so it is read
///     once BY CONSTRUCTION. A STEP is read once exactly when the strategy the
///     plan chose for it reads once: hash and tree index the source in one pass
///     and then probe the index; a nested loop rescans. `order by` blocks both,
///     because the sort phase re-binds every joined row BY INDEX after
///     collecting the matches — an iterator has no index and is already spent.
///
/// A rel NAMED MORE THAN ONCE in one chain is read once per naming, whatever
/// each naming's strategy — so the count comes first and overrides everything.
/// (This generalizes the old base-vs-step self-join guard: two STEPS naming the
/// same rel are the same hazard, and were not checked while every step was
/// unconditionally materialized.)
fn plan_mark_single_pass(prm: &MacroParams, ap: &mut AccessPlan) {
    if prm.src_root.is_null() { return; }
    let prog: RQProgram = prm.src_root.view::<RQProgram>();
    // A parse-side rel body may scan a native rel any number of times, and the
    // body is not inspected here — so their presence blocks the whole question.
    if prog.has_rels() {
        let mut r0: i64 = 0i64;
        while r0 < ap.n {
            ap.read_once(r0, false,
                "materialized: a rel block may scan this source repeatedly");
            r0 = r0 + 1i64;
        }
        return;
    }
    match prog.entry_any().view::<RQuery>() {
        RQuery::Simple(sq) => {
            let ri: i64 = prm.rel_find_name(sq.src_name);
            if ri < 0i64 { return; }
            if sq.has_order {
                ap.read_once(ri, false,
                    "materialized: `order by` revisits rows by position after collecting them");
            } else if sq.has_gpath {
                ap.read_once(ri, false,
                    "materialized: a graph path lowers to a join chain, which rescans");
            } else {
                ap.read_once(ri, true, "");
            }
        }
        RQuery::Join(jq) => {
            let bi: i64 = prm.rel_find_name(jq.a_name);
            let steps: RQJoinStepArr = jq.steps_arr();
            let ns: i64 = steps.len();
            // How many times does the chain NAME each rel?
            let mut cnt: [i64; 8] = [0i64; 8];
            if bi >= 0i64 { cnt[bi] = cnt[bi] + 1i64; }
            let mut c: i64 = 0i64;
            while c < ns {
                let sc: i64 = prm.rel_find_name(steps.step_at(c).src_name);
                if sc >= 0i64 { cnt[sc] = cnt[sc] + 1i64; }
                c = c + 1i64;
            }
            let mut k: i64 = 0i64;
            while k < ns {
                let st: RQJoinStep = steps.step_at(k);
                let si: i64 = prm.rel_find_name(st.src_name);
                if si >= 0i64 {
                    if cnt[si] > 1i64 {
                        ap.read_once(si, false,
                            "materialized: the query names this source more than once in one join chain");
                    } else if jq.has_order {
                        ap.read_once(si, false,
                            "materialized: `order by` re-binds joined rows by index after collecting the matches");
                    } else if st.jstrat == JS_NONE() {
                        ap.read_once(si, false,
                            "materialized: no strategy was decided for this step — a traversal earlier in the chain binds a var the plan cannot type yet");
                    } else if js_reads_once(st.jstrat) {
                        ap.read_once(si, true, "");
                    } else {
                        ap.read_once(si, false,
                            "materialized: this step is a nested loop, which rescans its source once per bound row");
                    }
                }
                k = k + 1i64;
            }
            if bi < 0i64 { return; }
            if cnt[bi] > 1i64 {
                // The base is named again — a self-join reads it twice.
                ap.read_once(bi, false,
                    "materialized: the query names this source on both sides of a join");
                return;
            }
            if jq.has_order {
                ap.read_once(bi, false,
                    "materialized: `order by` revisits base rows by position after collecting them");
            } else if jq.has_gpath {
                ap.read_once(bi, false,
                    "materialized: a graph path adds join levels over this source");
            } else {
                ap.read_once(bi, true, "");
            }
        }
        RQuery::Aggr(gq) => {
            // The grouped scan collects per-group state and then finalizes over
            // it; the emitter's two aggregate paths index their source after
            // the grouping pass. Named explicitly so the trace never falls back
            // to "cannot prove", which says nothing a reader can act on.
            let ai: i64 = prm.rel_find_name(gq.a_name);
            if ai >= 0i64 {
                ap.read_once(ai, false,
                    "materialized: the aggregate revisits rows after grouping them");
            }
            // An aggregate's join STEPS carry a decided strategy too, but the
            // joined-stream fold re-binds matched rows by index in its finalize
            // pass exactly as the sort phase does, so none of them may stream
            // yet. Said out loud rather than left to the default.
            if gq.has_steps() {
                let gs: RQJoinStepArr = gq.steps_arr();
                let ng: i64 = gs.len();
                let mut gk: i64 = 0i64;
                while gk < ng {
                    let gi: i64 = prm.rel_find_name(gs.step_at(gk).src_name);
                    if gi >= 0i64 {
                        ap.read_once(gi, false,
                            "materialized: the aggregate's finalize pass re-binds joined rows by index");
                    }
                    gk = gk + 1i64;
                }
            }
        }
        _ => { }
    }
}

/// APPLY the plan: bind each rel to the access that was chosen, bind a streamed
/// rel to its iterator name, retire the residual filter if the plan retired it,
/// and read the plan back out.
///
/// Everything that mutates is here, and it consults nothing but the plan.
fn plan_apply_access(prm: &mut MacroParams, ap: &AccessPlan, h: &Writ) {
    let mut ri: i64 = 0i64;
    while ri < ap.n {
        if ap.op[ri] >= 0i64 {
            prm.rel_mat[ri]   = ap.fnm[ri];
            prm.rel_marg2[ri] = ap.arg[ri];
            // The chosen operation's producer type replaces the rel's own —
            // the binding is annotated with what will actually be called.
            prm.rel_iter[ri]  = prm.opc_iter[ap.op[ri]];
            prm.rel_itty[ri]  = prm.opc_itty[ap.op[ri]];
        }
        if ap.stream[ri] {
            prm.rel_stream[ri] = true;
            prm.rel_srcs[ri]   = prm.rel_ssrc[ri];
        }
        ri = ri + 1i64;
    }
    if ap.drop_where && !prm.src_root.is_null() {
        let fs: RQSimple = rq_fat_simple(prm.src_root.view::<RQProgram>().entry_any(), h);
        fs.has_where = false;
    }
    access_plan_explain(ap, prm);
}

fn register_native_rels(prm: &mut MacroParams, natspec: str,
                        srcb: &mut [String; 8], dsrcb: &mut [String; 8],
                        rowtyb: &mut [String; 8], ssrcb: &mut [String; 8],
                        szatb: &mut [String; 8]) -> bool {
    let n: i64 = natspec.len();
    let mut i: i64 = 0i64;
    let mut k: i64 = 0i64;
    while i < n {
        if k >= 8i64 || prm.rel_n >= 8i64 {
            error("wql!: too many rels (max 8, native source params included)");
            return false;
        }
        // <regname>=
        let s0: i64 = i;
        while i < n && str_byte_at(natspec, i) != 61u8 { i = i + 1i64; }     // '='
        let regname: str = pw_slice(natspec, s0, i);
        i = i + 1i64;
        // <matfn>[!<flags>][#<arg>][@<module>]:
        let s1: i64 = i;
        while i < n && str_byte_at(natspec, i) != 64u8
              && str_byte_at(natspec, i) != 35u8
              && str_byte_at(natspec, i) != 33u8
              && str_byte_at(natspec, i) != 58u8 { i = i + 1i64; } // '@'|'#'|'!'|':'
        let mat: str = pw_slice(natspec, s1, i);
        // `!<flags>` — properties of the BINDING. `i` = the producer returns an
        // iterator, so the plan MAY consume it in place (ADR 0024 S4).
        let mut mat_iter: bool = false;
        let mut mat_ity: str = "";
        if i < n && str_byte_at(natspec, i) == 33u8 {
            i = i + 1i64;
            let fl: i64 = i;
            while i < n && str_byte_at(natspec, i) != 64u8
                  && str_byte_at(natspec, i) != 35u8
                  && str_byte_at(natspec, i) != 37u8
                  && str_byte_at(natspec, i) != 58u8 { i = i + 1i64; }   // …|'%'
            mat_iter = pw_flag(pw_slice(natspec, fl, i), 105u8);              // 'i'
            // `%<ret-ty>` — the producer's return type, which the emitted
            // binding is ANNOTATED with rather than inferring.
            if i < n && str_byte_at(natspec, i) == 37u8 {
                i = i + 1i64;
                let ty0: i64 = i;
                while i < n && str_byte_at(natspec, i) != 64u8
                      && str_byte_at(natspec, i) != 35u8
                      && str_byte_at(natspec, i) != 58u8 { i = i + 1i64; }
                mat_ity = pw_slice(natspec, ty0, i);
            }
        }
        // `#<arg>` — the narrowing constant, when this binding takes one.
        let mut marg2: str = "";
        if i < n && str_byte_at(natspec, i) == 35u8 {
            i = i + 1i64;
            let sa: i64 = i;
            while i < n && str_byte_at(natspec, i) != 64u8
                  && str_byte_at(natspec, i) != 58u8 { i = i + 1i64; }
            marg2 = pw_slice(natspec, sa, i);
        }
        let mut module: str = "";
        if i < n && str_byte_at(natspec, i) == 64u8 {
            i = i + 1i64;
            let s2: i64 = i;
            while i < n && str_byte_at(natspec, i) != 58u8 { i = i + 1i64; } // ':'
            module = pw_slice(natspec, s2, i);
        }
        i = i + 1i64;
        // <param>(
        let s3: i64 = i;
        while i < n && str_byte_at(natspec, i) != 40u8 { i = i + 1i64; }     // '('
        let marg: str = pw_slice(natspec, s3, i);
        i = i + 1i64;
        // columns into rowty text, remembering (name, ty) pairs for rel_add_col.
        rowtyb[k].push_str("(");
        let mut cnames: [str; 8] = ["", "", "", "", "", "", "", ""];
        let mut ctys:   [str; 8] = ["", "", "", "", "", "", "", ""];
        let mut nc: i64 = 0i64;
        loop {
            let c0: i64 = i;
            while i < n && str_byte_at(natspec, i) != 32u8 { i = i + 1i64; } // ' '
            let cn: str = pw_slice(natspec, c0, i);
            i = i + 1i64;
            let t0: i64 = i;
            while i < n && str_byte_at(natspec, i) != 44u8
                  && str_byte_at(natspec, i) != 41u8 { i = i + 1i64; }       // ',' | ')'
            let ct: str = pw_slice(natspec, t0, i);
            if nc > 0i64 { rowtyb[k].push_str(", "); }
            rowtyb[k].push_str(ct);
            if nc < 8i64 { cnames[nc] = cn; ctys[nc] = ct; nc = nc + 1i64; }
            if i >= n || str_byte_at(natspec, i) == 41u8 { break; }
            i = i + 1i64;                                                    // ','
        }
        i = i + 1i64;                                                        // ')'
        // `{col cmp fn x,…}` — the source's DECLARED OPERATIONS (ADR 0024 S6).
        // Absent for a source that declares none, which is every hand-written
        // one until it says otherwise. Held in locals here and registered
        // after the rel itself is (rel_add_op keys off the LAST registered).
        let mut op_col: [str; 8] = ["", "", "", "", "", "", "", ""];
        let mut op_cmp: [str; 8] = ["", "", "", "", "", "", "", ""];
        let mut op_fn:  [str; 8] = ["", "", "", "", "", "", "", ""];
        let mut op_ex:  [bool; 8] = [false; 8];
        let mut op_it:  [bool; 8] = [false; 8];
        let mut op_ity: [str; 8] = [""; 8];
        let mut nops: i64 = 0i64;
        if i < n && str_byte_at(natspec, i) == 123u8 {                        // '{'
            i = i + 1i64;
            loop {
                if i >= n || str_byte_at(natspec, i) == 125u8 { break; }      // '}'
                let c0: i64 = i;
                while i < n && str_byte_at(natspec, i) != 32u8 { i = i + 1i64; }
                let ocol: str = pw_slice(natspec, c0, i);
                i = i + 1i64;
                let m0: i64 = i;
                while i < n && str_byte_at(natspec, i) != 32u8 { i = i + 1i64; }
                let ocmp: str = pw_slice(natspec, m0, i);
                i = i + 1i64;
                let f0: i64 = i;
                while i < n && str_byte_at(natspec, i) != 32u8 { i = i + 1i64; }
                let ofn: str = pw_slice(natspec, f0, i);
                i = i + 1i64;
                let x0: i64 = i;
                while i < n && str_byte_at(natspec, i) != 124u8
                      && str_byte_at(natspec, i) != 37u8
                      && str_byte_at(natspec, i) != 125u8 { i = i + 1i64; }
                let oex: str = pw_slice(natspec, x0, i);
                let mut oity: str = "";
                if i < n && str_byte_at(natspec, i) == 37u8 {                 // '%'
                    i = i + 1i64;
                    let t0: i64 = i;
                    while i < n && str_byte_at(natspec, i) != 124u8
                          && str_byte_at(natspec, i) != 125u8 { i = i + 1i64; }
                    oity = pw_slice(natspec, t0, i);
                }
                if nops < 8i64 {
                    op_col[nops] = ocol; op_cmp[nops] = ocmp; op_fn[nops] = ofn;
                    op_ex[nops] = pw_flag(oex, 101u8);                        // 'e'
                    op_it[nops] = pw_flag(oex, 105u8);                        // 'i'
                    op_ity[nops] = oity;
                    nops = nops + 1i64;
                }
                if i < n && str_byte_at(natspec, i) == 124u8 { i = i + 1i64; } // '|'
            }
            if i < n && str_byte_at(natspec, i) == 125u8 { i = i + 1i64; }    // '}'
        }
        // `$<fn>[%<ret-ty>]` — the source's declared SIZE operation (ADR 0024
        // S4). Absent for a source that reports no size, which stays perfectly
        // usable: the plan records that it could not ask.
        let mut szfn: str = "";
        let mut szty: str = "";
        if i < n && str_byte_at(natspec, i) == 36u8 {                          // '$'
            i = i + 1i64;
            let z0: i64 = i;
            while i < n && str_byte_at(natspec, i) != 37u8
                  && str_byte_at(natspec, i) != 59u8 { i = i + 1i64; }  // '%'|';'
            szfn = pw_slice(natspec, z0, i);
            if i < n && str_byte_at(natspec, i) == 37u8 {                      // '%'
                i = i + 1i64;
                let zt: i64 = i;
                while i < n && str_byte_at(natspec, i) != 59u8 { i = i + 1i64; } // ';'
                szty = pw_slice(natspec, zt, i);
            }
        }
        i = i + 1i64;                                                        // ';'
        rowtyb[k].push_str(")");
        // Single-column rows are the bare type, not a 1-tuple.
        let rowty: str = if nc == 1i64 { ctys[0] } else { string_as_str(&rowtyb[k]) };
        let idx: i64 = reg_native(prm, regname, rowty, mat, marg, marg2, module,
                                  mat_iter, mat_ity, szfn, szty,
                                  &mut srcb[k], &mut dsrcb[k],
                                  &mut ssrcb[k], &mut szatb[k]);
        if idx < 0i64 {
            error("wql!: too many rels (max 8, native source params included)");
            return false;
        }
        let mut c: i64 = 0i64;
        while c < nc {
            prm.rel_add_col(cnames[c], ctys[c]);
            c = c + 1i64;
        }
        let mut o: i64 = 0i64;
        while o < nops {
            prm.rel_add_op(op_col[o], op_cmp[o], op_fn[o], op_ex[o], op_it[o],
                           op_ity[o]);
            o = o + 1i64;
        }
        k = k + 1i64;
    }
    return true;
}

// natspec sub-view [a, b).
fn pw_slice(s: str, a: i64, b: i64) -> str {
    return unsafe { str_from_raw(((s.as_ptr() as i64) + a) as *const u8, b - a) };
}

// A natspec flag field is a SET of letters, not a single letter — `e`/`s` say
// what an operation's rows are, `i` says how they arrive, and the two are
// independent. Testing membership rather than comparing the whole field is what
// lets a third property be added without every reader changing.
fn pw_flag(flags: str, c: u8) -> bool {
    let mut i: i64 = 0i64;
    while i < flags.len() {
        if str_byte_at(flags, i) == c { return true; }
        i = i + 1i64;
    }
    return false;
}

// One-shot rel `r` (singleton SCC, no self-edge — the slice-B path):
//   let __rel_<r>: Vec<Row> = __wql_<fn>_rel_<r>(<params>[, dep slices]);
//   let __rel_<r>_sl: &[Row] = __rel_<r>.as_slice();
// NATIVE rel (ADR 0016 M1a): the materialization is the writ_graph helper —
//   let __rel_<p>: Vec<WritEdgeRow> = writ_graph_edges(<p>);
// (no `?` — the native walk has no EL fault path).
/// The rel's SIZE, obtained ONCE (ADR 0024 S4).
///
/// `let __sz_<r>: <ty> = <reporter>(<source>);` — a statement of the PRELUDE, so
/// it runs before the first row is read and cannot become a per-row cost however
/// the walk below it is shaped. Emitted only when the source declared a reporter;
/// otherwise nothing is emitted and the plan's trace says the size is unknown.
///
/// ⚠ ONE COPY, in params.logos (`size_binding_text`), because the PREPARE fn
/// (ADR 0024 S4i) needs the same statement in a body of its own: a prepared
/// plan measures before the query's prelude exists, and two spellings of the
/// same reporter call is how a plan comes to compare numbers obtained
/// differently.
fn emit_size_binding(prelude: &mut String, prm: &MacroParams, r: i64) {
    size_binding_text(prelude, prm, r);
}

fn emit_prelude_oneshot(prelude: &mut String, name: str, prm: &MacroParams,
                        scc: &RelScc, r: i64) {
    if prm.rel_native[r] {
        // Before the source's own binding: a size is a fact ABOUT the relation,
        // and reading it after landing a cursor would tie it to a walk.
        emit_size_binding(prelude, prm, r);
        // STREAMED (ADR 0024 S4): the producer's iterator is bound directly,
        // and nothing is collected. The type is INFERRED — the iterator's type
        // is the source's business, and naming it here would put a second copy
        // of that decision in the query compiler.
        if prm.rel_stream[r] {
            prelude.push_str("    let mut ");
            prelude.push_str(prm.rel_srcs[r]);
            prelude.push_str(": ");
            prelude.push_str(prm.rel_itty[r]);
            prelude.push_str(" = ");
            prelude.push_str(prm.rel_mat[r]);
            prelude.push_str("(");
            prelude.push_str(prm.rel_marg[r]);
            if prm.rel_marg2[r].len() > 0i64 {
                prelude.push_str(", ");
                prelude.push_str(prm.rel_marg2[r]);
            }
            prelude.push_str(");\n");
            return;
        }
        // DRAINED: the producer streams but this plan cannot read it once, so
        // the iterator is emptied into a Vec and everything downstream sees the
        // slice it always saw. This is what lets a source declare ONE producer
        // per operation instead of two — the general form is the iterator, and
        // materializing is a step the plan adds, not a second thing the source
        // must write.
        if prm.rel_iter[r] {
            prelude.push_str("    let mut __it_");
            prelude.push_str(prm.rel_names[r]);
            prelude.push_str(": ");
            prelude.push_str(prm.rel_itty[r]);
            prelude.push_str(" = ");
            prelude.push_str(prm.rel_mat[r]);
            prelude.push_str("(");
            prelude.push_str(prm.rel_marg[r]);
            if prm.rel_marg2[r].len() > 0i64 {
                prelude.push_str(", ");
                prelude.push_str(prm.rel_marg2[r]);
            }
            prelude.push_str(");\n");
            prelude.push_str("    let mut __rel_");
            prelude.push_str(prm.rel_names[r]);
            prelude.push_str(": Vec<");
            prelude.push_str(prm.rel_rowty[r]);
            prelude.push_str("> = Vec::<");
            prelude.push_str(prm.rel_rowty[r]);
            prelude.push_str(">::new();\n");
            // Annotated for the same reason the streaming loop annotates: the
            // item type of `next()` is the trait's parameter, and an associated-
            // type source spelling leaves it unselected.
            prelude.push_str("    loop { let __dr: Option<");
            prelude.push_str(prm.rel_rowty[r]);
            prelude.push_str("> = __it_");
            prelude.push_str(prm.rel_names[r]);
            prelude.push_str(".next(); if __dr.is_none() { break; } __rel_");
            prelude.push_str(prm.rel_names[r]);
            prelude.push_str(".push(__dr.unwrap()); }\n");
            prelude.push_str("    let ");
            prelude.push_str(prm.rel_srcs[r]);
            prelude.push_str(": &[");
            prelude.push_str(prm.rel_rowty[r]);
            prelude.push_str("] = __rel_");
            prelude.push_str(prm.rel_names[r]);
            prelude.push_str(".as_slice();\n");
            return;
        }
        prelude.push_str("    let __rel_");
        prelude.push_str(prm.rel_names[r]);
        prelude.push_str(": Vec<");
        prelude.push_str(prm.rel_rowty[r]);
        prelude.push_str("> = ");
        // The materializer + its param arrive in the natspec — the emitter
        // knows no source type (ADR 0016 §6).
        prelude.push_str(prm.rel_mat[r]);
        prelude.push_str("(");
        prelude.push_str(prm.rel_marg[r]);
        if prm.rel_marg2[r].len() > 0i64 {
            prelude.push_str(", ");
            prelude.push_str(prm.rel_marg2[r]);
        }
        prelude.push_str(");\n");
        prelude.push_str("    let ");
        prelude.push_str(prm.rel_srcs[r]);
        prelude.push_str(": &[");
        prelude.push_str(prm.rel_rowty[r]);
        prelude.push_str("] = __rel_");
        prelude.push_str(prm.rel_names[r]);
        prelude.push_str(".as_slice();\n");
        return;
    }
    prelude.push_str("    let __rel_");
    prelude.push_str(prm.rel_names[r]);
    prelude.push_str(": Vec<");
    prelude.push_str(prm.rel_rowty[r]);
    prelude.push_str("> = __wql_");
    prelude.push_str(vis_strip(name));
    prelude.push_str("_rel_");
    prelude.push_str(prm.rel_names[r]);
    prelude.push_str("(");
    push_call_args(prelude, prm, scc.dep_mask[r]);
    // Result-returning rel fn (error-returning EL arithmetic): unwrap with `?`
    // — a math fault in a rel body propagates to the entry fn's Result.
    prelude.push_str(")?;\n");
    prelude.push_str("    let ");
    prelude.push_str(prm.rel_srcs[r]);
    prelude.push_str(": &[");
    prelude.push_str(prm.rel_rowty[r]);
    prelude.push_str("] = __rel_");
    prelude.push_str(prm.rel_names[r]);
    prelude.push_str(".as_slice();\n");
}

// Recursive SCC `c`: declare each member's total Vec, run the semi-naïve
// fixpoint fn (members as `&mut Vec` out-params, earlier-stratum deps as
// slices), bind the `as_slice()` views the entry/later strata scan.
fn emit_prelude_scc(prelude: &mut String, name: str, prm: &MacroParams,
                    scc: &RelScc, c: i64) {
    let mut r: i64 = 0i64;
    while r < prm.rel_n {
        if scc.comp[r] == c {
            prelude.push_str("    let mut __rel_");
            prelude.push_str(prm.rel_names[r]);
            prelude.push_str(": Vec<");
            prelude.push_str(prm.rel_rowty[r]);
            prelude.push_str("> = Vec::<");
            prelude.push_str(prm.rel_rowty[r]);
            prelude.push_str(">::new();\n");
        }
        r = r + 1i64;
    }
    // Union of the members' out-of-SCC dep masks — the SCC fn's dep params.
    let mut mask: i64 = 0i64;
    let mut r2: i64 = 0i64;
    while r2 < prm.rel_n {
        if scc.comp[r2] == c { mask = mask | scc.dep_mask[r2]; }
        r2 = r2 + 1i64;
    }
    prelude.push_str("    __wql_");
    prelude.push_str(vis_strip(name));
    prelude.push_str("_scc");
    prelude.push_i64(c);
    prelude.push_str("(");
    push_call_args(prelude, prm, mask);
    let mut r3: i64 = 0i64;
    while r3 < prm.rel_n {
        if scc.comp[r3] == c {
            prelude.push_str(", &mut __rel_");
            prelude.push_str(prm.rel_names[r3]);
        }
        r3 = r3 + 1i64;
    }
    // Result-returning SCC driver: `?` propagates a rel-body math fault.
    prelude.push_str(")?;\n");
    let mut r4: i64 = 0i64;
    while r4 < prm.rel_n {
        if scc.comp[r4] == c {
            prelude.push_str("    let ");
            prelude.push_str(prm.rel_srcs[r4]);
            prelude.push_str(": &[");
            prelude.push_str(prm.rel_rowty[r4]);
            prelude.push_str("] = __rel_");
            prelude.push_str(prm.rel_names[r4]);
            prelude.push_str(".as_slice();\n");
        }
        r4 = r4 + 1i64;
    }
}
