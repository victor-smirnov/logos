// logos.std.wql.trama_render — the `trama!(…){ … }` RESOURCE surface (ADR 0012
// §6/§10.2, queue-1 STATIC lowering). A `#[token_macro]` handler receives the
// raw params source text + the raw block (template) bytes at compile time,
// parses the template into the Trama AST (Phase-3 schema'd `TStmt` tree, whose
// `{{ … }}` / tag expressions are SExpr edges), WALKS that AST, and EMITS a
// native Logos `render` function (via `logos_emit_source`) that builds and
// returns the woven `String`.
//
// Surface (Phase-2 PARAMETERIZED form — a REAL fn-style parameter list in the
// parens; the old `data`/`with` DSL header is GONE):
//
//   resource <name> = trama!(<params>){ <template> };
//     e.g.  resource r = trama!(o: &Order){ " … {{ o.total }} … " };
//     e.g.  resource g = trama!(u: &User, greeting: str){ " {{ greeting }}, {{ u.name }} " };
//
// The PARENS carry a genuine Logos parameter list — parsed + TYPE-CHECKED by the
// compiler because the handler re-emits it VERBATIM into the generated
// signature. The render-fn NAME is the `resource <name> =` binding (ADR 0012
// §6); the handler receives it as `name`, the raw params text as `params`, and
// the raw template body as `body`.
//
//   →  pub fn <name>(<params>) -> Result<String, ElError> {
//          let mut __out: String = String::new();
//          … walk the Trama AST …
//          return Result::Ok(__out);
//      }
//   (error-returning: an integer overflow / division-by-zero in an embedded
//    `{{ … }}` EL expression becomes `Err(ElError)`, never a host trap.)
//
// Each param whose type resolves to a schema struct (reflect.logos) is REFLECTED
// so its field accesses (`{{ o.total }}`) type automatically (NO `with` clause);
// a scalar/str param (`greeting: str`) is usable directly in the template (a
// bare param name = that param). The existing loop-var recursive reflection
// still applies (`{% for x in o.items %}` follows `Order.items`'s element type).
//
// Template constructs lowered:
//   • literal text run        → __out.push_str("<bytes>");
//   • {{ expr }}              → __out.push_i64(<expr>);   (MVP: i64 interpolation)
//   • {% if expr %}…{% else %}…{% endif %}  → if (<expr>) { … } else { … }
//   • {% for v in expr %}…{% endfor %}      → indexed while-loop over (<expr>)
//   • {% set v = expr %}      → let v: i64 = <expr>;
//
// The embedded `{{ … }}` / tag expressions are the Trama AST's `WRef<SExpr>`
// edges (the ONE coupling, ADR 0012 §seam); they are emitted by the SHARED
// SExpr codegen (`logos.std.wql.codegen::emit_sexpr`), exactly as the `wql!`
// where/select clauses are. Field/loop-var NAMES are read off the self-describing
// IR (Option B); value-TYPES come from the `ElTypes` dict the handler builds by
// RECURSIVE schema reflection (ADR 0012 Phase 2): the `data <ctx>:<Schema>`
// context is reflected AND `{% for v in ctx.field %}` loop vars FOLLOW the schema
// — `ctx.field`'s element type binds `v` and its fields reflect in turn, through
// NESTED loops — so a schema `data` context needs NO `with`. The optional `with`
// clause still OVERRIDES / supplies types for genuinely un-inferable names
// (loop/set var type names from `TVarTys`).
//
// The template is parsed by the peg_gen_logos-GENERATED parser
// (`logos.std.wql.trama_parser::parse_tpl`), which yields the `tpl` as a WArray of
// TStmt handles; the handler stitches the `next`-linked chain the renderer walks
// (the T3 post-pass `chain_array`, below). The hand-written Trama parser is retired.
package logos.std.wql.trama_render;

use logos.std.compiler.metaprog;     // ItemList/item_list_new/error, and the
                                     // quote channel the render fn travels on:
                                     // quote_item!/quote_block!, Ident, ExprBlob,
                                     // parse_params/parse_expr/parse_type/parse_block
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;
use logos.lang.writ.wstring;
use logos.lang.writ.array;        // WArray — the generated `tpl` statement array
use logos.std.wql.ir;
use logos.std.wql.el;             // ElTypes / el_types_new / el_ty_of_name / EL_TY_* (type dict)
use logos.std.wql.params;         // MacroParams / parse_macro_params — SHARED with wql!
use logos.std.wql.trama;          // TStmt schema family (TText/TVar/TFor/TIf/TSet)
use logos.std.wql.trama_parser;   // parse_tpl — the GENERATED Trama parser (self-describing IR)
use logos.std.wql.codegen;
use logos.std.wql.optimize;  // simplify_sexpr / sexpr_const — IR→IR const-fold + dead-branch
use logos.std.wql.reflect;   // stamp_types_from_schema — context field-type reflection
use logos.mem.string;
use logos.lang.str;

// ── Surface lexer (clause carving) ─────────────────────────────────────────
struct TLexer {
    src: str,
    pos: i64,
    len: i64,
}

fn tl_is_space(c: u8) -> bool { return c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8; }

impl TLexer {
    fn cur(self: &TLexer) -> u8 {
        if self.pos >= self.len { return 0u8; }
        return str_byte_at(self.src, self.pos);
    }
    fn bump(self: &mut TLexer) { self.pos = self.pos + 1i64; }
    fn skip_ws(self: &mut TLexer) {
        while self.pos < self.len && tl_is_space(self.cur()) { self.bump(); }
    }
    // The template body, delimited by either `"…"` or backticks `` `…` ``.
    // Backtick delimiters let the template contain bare `"` string literals
    // (e.g. `{{ "(" + city + ")" }}` / `{% if x == "NYC" %}`) WITHOUT escaping —
    // the recommended form when embedded EL string literals are used. The
    // double-quote form stays for simple templates (no inner quotes). Returns
    // the inner [start,end) slice; advances past the closing delimiter. Empty on
    // a missing/mismatched delimiter.
    fn scan_template(self: &mut TLexer) -> str {
        self.skip_ws();
        let delim: u8 = self.cur();
        // No inner delimiter (`"` or backtick): the WHOLE brace body IS the
        // template — `trama!(p){ … }` with no quoting. Leading/trailing whitespace
        // is trimmed (use the backtick/`"` form to preserve exact edge whitespace).
        // Template escapes (`\{` `\}` `` \` `` `\\`) are decoded downstream by the
        // escape-aware parser + `emit_escaped`, so a stray brace is `\{`-escaped.
        if delim != 34u8 && delim != 96u8 {
            let s0: i64 = self.pos;
            let mut e0: i64 = self.len;
            while e0 > s0 && tl_is_space(str_byte_at(self.src, e0 - 1i64)) { e0 = e0 - 1i64; }
            self.pos = self.len;
            if e0 <= s0 { return ""; }
            return unsafe { tl_str_range(self.src, s0, e0 - s0) };
        }
        self.bump();
        let start: i64 = self.pos;
        while self.pos < self.len && self.cur() != delim { self.bump(); }
        let end: i64 = self.pos;
        if self.cur() == delim { self.bump(); }
        return unsafe { tl_str_range(self.src, start, end - start) };
    }
}

unsafe fn tl_str_range(src: str, start: i64, len: i64) -> str {
    let l: i64 = if len < 0i64 { 0i64 } else { len };
    return str_from_raw((src.as_ptr() as i64 + start) as *const u8, l);
}

// ── Text-run escaping ──────────────────────────────────────────────────────
// A literal text run as a Logos STRING LITERAL (quotes included), escaping `"`,
// `\` and control bytes — the text `parse_expr` reifies into the `push_str`
// argument of the run's statement.
fn lit_of_text(s: str) -> String {
    let mut out: String = String::new();
    out.push_str("\"");
    let n: i64 = s.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        // Template BACKSLASH ESCAPE (`\{`, `\}`, `` \` ``, `\\`): the raw-body
        // capture + Trama lexer preserved the backslash; DE-ESCAPE it here to the
        // bare char so the template renders the literal `{`/`}`/`` ` ``/`\`. The
        // bare char is then re-escaped below as needed for the Logos string body.
        if c == 92u8 && i + 1i64 < n {
            let e: u8 = str_byte_at(s, i + 1i64);
            if e == 123u8 || e == 125u8 || e == 96u8 || e == 92u8 {
                if e == 92u8 { out.push_str("\\\\"); } else { out.push_u8(e); }
                i = i + 2i64;
                continue;
            }
        }
        if c == 34u8 { out.push_str("\\\""); }
        else if c == 92u8 { out.push_str("\\\\"); }
        else if c == 10u8 { out.push_str("\\n"); }
        else if c == 13u8 { out.push_str("\\r"); }
        else if c == 9u8  { out.push_str("\\t"); }
        else { out.push_u8(c); }
        i = i + 1i64;
    }
    out.push_str("\"");
    return out;
}

// ── Declared loop/set var TYPE NAMES (name → Logos type-name) ──────────────
// A tiny association list over `str` slices, built from the `with` clause. Used
// to emit a loop var's element binding type (`let v: <ty>`); an undeclared var
// defaults to the i64 baseline. Replaces the retired TrParser.var_ty_of table.
struct TVarTys {
    names: [str; 64],
    tys:   [str; 64],
    n:     i64,
}
fn tvartys_new() -> TVarTys {
    return TVarTys {
        names: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        tys:   ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        n: 0i64,
    };
}
impl TVarTys {
    fn declare(self: &mut TVarTys, name: str, ty: str) {
        if self.n < 64i64 { self.names[self.n] = name; self.tys[self.n] = ty; self.n = self.n + 1i64; }
    }
    fn ty_name(self: &TVarTys, name: str) -> str {
        let mut i: i64 = 0i64;
        while i < self.n { if str_eq(self.names[i], name) { return self.tys[i]; } i = i + 1i64; }
        return "";
    }
}

// ── Struct-type environment (var name → schema struct type name) ───────────
// The RECURSIVE-REFLECTION seam (ADR 0012 Phase 2): resolving a `{% for v in
// EXPR %}` loop var's element type needs to know the STRUCT type each in-scope
// name denotes, so a field chain (`o.items`) can be walked against the schema.
// Seeded with the data-context binding (`o → Order`); each loop var is added as
// its element type is discovered (`item → Item`), so NESTED loops resolve
// (`for line in item.lines` → element of `Item.lines`). A tiny (name,type-name)
// association list over borrowed `str` slices (names live in the IR / surface).
struct StructEnv {
    names: [str; 64],
    tys:   [str; 64],
    n:     i64,
}
fn struct_env_new() -> StructEnv {
    return StructEnv {
        names: ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        tys:   ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""],
        n: 0i64,
    };
}
impl StructEnv {
    fn bind(self: &mut StructEnv, name: str, ty: str) {
        // Last write wins (a nested loop var can shadow, though names are unique
        // in practice); overwrite an existing binding by name.
        let mut i: i64 = 0i64;
        while i < self.n { if str_eq(self.names[i], name) { self.tys[i] = ty; return; } i = i + 1i64; }
        if self.n < 64i64 { self.names[self.n] = name; self.tys[self.n] = ty; self.n = self.n + 1i64; }
    }
    fn type_of(self: &StructEnv, name: str) -> str {
        let mut i: i64 = 0i64;
        while i < self.n { if str_eq(self.names[i], name) { return self.tys[i]; } i = i + 1i64; }
        return "";
    }
}

// Resolve the STRUCT TYPE NAME an EL field-chain expression denotes, against the
// struct-type environment. A bare field-root (`SField{name=X, base=null}`) is a
// VAR reference — its type is `env[X]` (the ctx var or an outer loop var). A field
// STEP (`SField{name=f, base=B}`) is field `f`'s declared type WITHIN the struct
// `B` resolves to. Anything else (or an unknown/absent field) is "" (unresolvable
// — the loop var then falls back to the `with` override / the i64 baseline).
fn resolve_struct_type<'a>(view: &'a OView, e: SExpr, env: &'a StructEnv) -> &'a str {
    match e {
        SExpr::Field(f) => {
            let fname: str = f.name;
            let base_ref: WRef<SExpr> = f.base;
            let base: WAny = base_ref.any();
            if base.is_null() {
                return env.type_of(fname);           // bare root = a var reference
            }
            let be: SExpr = f.base_expr();
            let bt: str = resolve_struct_type(view, be, env);
            if bt.len() == 0i64 { return ""; }
            // ⚠ THE BASE TYPE IS A SPELLING. `find_struct_decl` resolves it through
            // the module's aliases and requires a schema back, so a ctx field declared
            // with an aliased struct type still reflects its members.
            let decl: WAny = find_struct_decl(view, bt);
            return field_type_name(view, decl, fname);
        }
        SExpr::Var(v) => { let vn: str = v.name; return env.type_of(vn); }
        _ => { return ""; }
    }
}

// Resolve a `{% for v in EXPR %}` collection expression to its ELEMENT struct
// type name (the type `v` binds to). EXPR is a field chain: its final field's
// declared type must be a collection (`[T;N]`/`&[T]`/`[T]`) whose element is `T`.
//   • `SField{name=f, base=B}` → element type of field `f` in struct(B);
//   • a bare root that is itself a collection VAR → env[X] (already an element ty).
// "" when unresolvable.
fn resolve_for_element_type<'a>(view: &'a OView, e: SExpr, env: &'a StructEnv) -> &'a str {
    match e {
        SExpr::Field(f) => {
            let fname: str = f.name;
            let base_ref: WRef<SExpr> = f.base;
            let base: WAny = base_ref.any();
            if base.is_null() {
                // `for v in xs` where `xs` is a bare var (a loop source bound as a
                // collection element type in env — uncommon in the ctx model, but
                // supported): its element type is env[xs] if present.
                return env.type_of(fname);
            }
            let be: SExpr = f.base_expr();
            let bt: str = resolve_struct_type(view, be, env);
            if bt.len() == 0i64 { return ""; }
            let decl: WAny = find_struct_decl(view, bt);
            return field_element_type_name(view, decl, fname);
        }
        SExpr::Var(v) => { let vn: str = v.name; return env.type_of(vn); }
        _ => { return ""; }
    }
}

// ── Recursive loop-var reflection (Phase 2) ────────────────────────────────
// Walk the Trama AST following loop variables: for each `{% for v in EXPR %}`,
// resolve EXPR's element type T from the data schema (via the struct-type env),
// then (a) record `v`'s Logos binding type (`vtys`, drives `let v: T`), (b) bind
// `v → T` in the env so v.member chains + NESTED loops resolve, and (c) reflect
// T's fields into the value-type dict `ty` so `v.member` typing is automatic —
// NO `with` clause needed. Recurses into for-bodies (with the extended env) and
// if-bodies/else (env unchanged). Idempotent-friendly: `with` is applied AFTER
// this, so an explicit declaration still OVERRIDES an inferred one.
fn reflect_loops(view: &OView, head: i64, ty: &mut ElTypes, vtys: &mut TVarTys, env: &StructEnv) {
    let mut cur: i64 = head;
    while cur != 0i64 {
        let e: TStmt = unsafe { WAny::ref_to(cur as *const u8) }.view::<TStmt>();
        match e {
            TStmt::For(f) => {
                let se: SExpr = f.expr_expr();
                let elem_ty: str = resolve_for_element_type(view, se, env);
                // Extend the env for the body: bind the loop var to its element
                // type (empty binding is harmless — resolves to "" downstream).
                let mut inner: StructEnv = struct_env_new();
                copy_env(&mut inner, env);
                if elem_ty.len() > 0i64 {
                    inner.bind(f.var, elem_ty);
                    vtys.declare(f.var, elem_ty);
                    // Value-type the loop VAR itself off its element type, so a
                    // bare `{{ v }}` over a PRIMITIVE-element collection (`[str;N]`,
                    // `[bool;N]`) renders with the right push (str/bool vs i64) —
                    // this is the typing the retired `with v:str` used to supply.
                    // A struct element maps to INT here (harmless: a struct loop
                    // var is only ever used via `v.field`, typed by the reflect
                    // below, never rendered bare).
                    // ⚠ Through the alias table, like every other name reaching `el`:
                    // `type Cell = str;` on a collection field would otherwise take
                    // `el_ty_of_name`'s INT default and render `push_i64` on a `str`.
                    ty.set_ty_named(f.var, resolve_alias_name(view, elem_ty));
                    // Reflect the element struct's fields so `v.member` types.
                    stamp_types_from_schema(view, ty, elem_ty, f.var);
                }
                reflect_loops(view, body_word(&f.body), ty, vtys, &inner);
            }
            TStmt::Set(s) => {
                // `{% set v = expr %}` BINDS v, so v needs a value-type in the
                // dict exactly as a loop var does — otherwise `infer_ty` on a
                // later `{{ v }}` falls through to its INT default and the
                // interpolation emits `push_i64` on a str/bool/f64 local. The
                // emit side already types the binding correctly (it writes
                // `let v: str`/`: bool`/`: f64`), which is why the mismatch was a
                // host type error on generated code and not a wrong result: the
                // declaration half was implemented and the use half was not.
                //
                // ⚠ THE PRE-PASS IS WHERE THIS BELONGS, not the emit walk. Chain
                // ORDER is what makes a set readable by the sets and
                // interpolations after it (`{% set b = a + 1 %}` must see `a`),
                // and this loop already walks `next` in order and already holds
                // `ty` mutably — the emit walk holds it by shared ref and would
                // have to thread `&mut` through every arm to do the same job
                // later and less correctly.
                //
                // No simplify_sexpr here (the emit side const-folds before
                // inferring): folding cannot change an EL type — a folded compare
                // is a bool literal and the unfolded SBin compare infers BOOL —
                // and the pre-pass has no arena to fold into.
                // The inferred name is READ OUT of `ty` and written back into
                // it, so the read must finish before the write begins — rustc
                // answers this exact shape with `cannot borrow *t as mutable
                // because it is also borrowed as immutable`. An owned copy
                // ends the shared borrow at the semicolon.
                let nm: String = String::from_str(infer_ty_name(s.expr_expr(), ty));
                ty.set_ty_named(s.var, string_as_str(&nm));
            }
            TStmt::If(i) => {
                // Conditionals don't bind vars; recurse both arms with the same env.
                // ⚠ A `{% set %}` inside an arm still lands in the FLAT dict, so a
                // conditionally-bound name is typed unconditionally. That matches
                // what the emit walk does with it (the `let` is emitted inside the
                // arm and the dict has no scopes), and it is the same looseness
                // `vtys` and the loop-var bindings already carry.
                reflect_loops(view, body_word(&i.body), ty, vtys, env);
                let altw: i64 = alt_word(&i.alt);
                if altw != 0i64 { reflect_loops(view, altw, ty, vtys, env); }
            }
            _ => { }
        }
        cur = next_of_stmt(cur);
    }
}

// Copy `src`'s bindings into `dst` (the body env starts as a snapshot of the
// enclosing scope, then adds the loop var — Logos has no clone/derive here).
fn copy_env(dst: &mut StructEnv, src: &StructEnv) {
    let mut i: i64 = 0i64;
    while i < src.n { dst.bind(src.names[i], src.tys[i]); i = i + 1i64; }
}

// The chain-stitch (T3 post-pass `chain_array`) + chain-walk primitives
// (`next_of_stmt` / `next_word` / `body_word` / `alt_word` / `ttext_str`) now
// live in logos.std.wql.trama — the ONE mechanism shared with the DYNAMIC
// `Tpl::compile` runtime (logos.std.deem), which must not import metaprog.

// ── Trama AST → render-fn body, as QUOTES (#370) ──────────────────────────
// Walk a TStmt chain (the singly-linked body) into ONE block of render
// statements. The type dict `ty` holds field/param/var value-types (reflection +
// `with`); `vtys` resolves a `for`/`set` var's declared Logos TYPE NAME. `depth`
// disambiguates nested loop counters (`__i0`, `__i1`, …); the walk follows `next`.
//
// ⚠ THE NEST IS BUILT BOTTOM-UP, NOT SPELLED BY ONE TEMPLATE. A template's
// statement shape is its own nesting, a runtime depth, so no fixed quote spells
// the whole body — but each statement IS a fixed shape, and a nested body is a
// block value spliced into its parent's quote (`#(body)`), the way the query
// emitter composes its join nests. Only the EL expressions inside a statement
// arrive as text (the shared clause writers `emit_sexpr`/`emit_truthy` are
// text-shaped) and are reified one expression at a time (`parse_expr`).
fn emit_stmts(head: i64, ty: &ElTypes, vtys: &TVarTys, ctx: str, depth: i64, h: &Writ) -> ExprBlob {
    let mut acc: ExprBlob = quote_block! { };
    let mut cur: i64 = head;
    while cur != 0i64 {
        let e: TStmt = unsafe { WAny::ref_to(cur as *const u8) }.view::<TStmt>();
        let mut st: ExprBlob = quote_block! { };
        let nxt: i64 = emit_one(e, ty, vtys, ctx, depth, h, &mut st);
        acc = quote_block! { #(acc); #(st); };
        cur = nxt;
    }
    return acc;
}

fn sexpr_blob(se: SExpr, ty: &ElTypes, ctx: str) -> ExprBlob {
    let mut t: String = String::new();
    emit_sexpr(&mut t, se, ty, ctx);
    return parse_expr(t.as_str());
}

// Emit ONE statement into `st`; return the `next`-link word (0 = end of chain).
fn emit_one(e: TStmt, ty: &ElTypes, vtys: &TVarTys, ctx: str, depth: i64, h: &Writ,
            st: &mut ExprBlob) -> i64 {
    match e {
        TStmt::Text(t) => {
            let lit: String = lit_of_text(ttext_str(&t));
            let lf: ExprBlob = parse_expr(lit.as_str());
            *st = quote_block! { __out.push_str(#(lf)); };
            return next_word(&t.next);
        }
        TStmt::Var(v) => {
            // {{ expr }} → append the expression's value to the buffer, routed by
            // its inferred TYPE: a string is pushed (a concat flattened to
            // successive pushes by the shared writer), a bool renders as the
            // words true/false, a float through the shared %g helper, an integer
            // by its own width (Rust typing: a `u8` is not an `i64`).
            let se: SExpr = simplify_sexpr(v.expr_expr(), h).any().view::<SExpr>();
            // Tuples are a WQL projection form — templates render TEXT, not rows.
            if !reject_tuple(se, "trama!: `{{ … }}`") { return next_word(&v.next); }
            if !check_calls(se, ty, "trama!") { }
            let vt: i32 = infer_ty(se, ty);
            if vt == EL_TY_STR() {
                // The shared writer emits one or more `__out.push_str(…);`
                // statements (a concat is flattened); reified as one block.
                let mut tmp: String = String::new();
                tmp.push_str("{\n");
                emit_push_str(&mut tmp, "    ", "__out", se, ty, ctx);
                tmp.push_str("}\n");
                let blk: ExprBlob = parse_block(tmp.as_str());
                *st = quote_block! { #(blk); };
            } else if vt == EL_TY_BOOL() {
                let ef: ExprBlob = sexpr_blob(se, ty, ctx);
                *st = quote_block! { if (#(ef)) { __out.push_str("true"); } else { __out.push_str("false"); } };
            } else if vt == EL_TY_FLT() {
                // The owned String temporary is `.as_str()`-borrowed for push_str.
                let ef: ExprBlob = sexpr_blob(se, ty, ctx);
                *st = quote_block! { __out.push_str((logos.std.wql.el::wql_f64_to_str((#(ef)) as f64)).as_str()); };
            } else {
                let tn: str = infer_emit_ty(se, ty);
                let it: ElTy = el_ty(tn);
                let ef: ExprBlob = sexpr_blob(se, ty, ctx);
                if it.cls == EL_TY_INT() && it.bits > 64i64 {
                    let mut m: String = String::new();
                    m.push_str("trama!: `{{ … }}` renders a value of type `");
                    m.push_str(tn);
                    m.push_str("` — a 128-bit integer has no text form the template writer emits; convert it with `as i64` / `as u64` where the value fits");
                    error(m.as_str());
                } else if it.cls == EL_TY_INT() && !it.signed {
                    *st = quote_block! { __out.push_u64((#(ef)) as u64); };
                } else {
                    *st = quote_block! { __out.push_i64((#(ef)) as i64); };
                }
            }
            return next_word(&v.next);
        }
        TStmt::Set(s) => {
            // {% set var = expr %} → a typed let binding of the expression's own
            // TYPE (Rust typing: it was `: i64` for every integer). A string
            // `set` binds a `str`.
            let vname: Ident = Ident::new(s.var);
            let se: SExpr = simplify_sexpr(s.expr_expr(), h).any().view::<SExpr>();
            if !reject_tuple(se, "trama!: `{% set %}`") { return next_word(&s.next); }
            if !check_calls(se, ty, "trama!") { }
            let vt: i32 = infer_ty(se, ty);
            let tn: str = if vt == EL_TY_STR() { "str" } else { infer_emit_ty(se, ty) };
            let tf: ExprBlob = parse_type(tn);
            let ef: ExprBlob = sexpr_blob(se, ty, ctx);
            *st = quote_block! { let #vname: #(tf) = #(ef); };
            return next_word(&s.next);
        }
        TStmt::If(i) => {
            // {% if expr %} then [ {% else %} alt ] {% endif %}
            // The condition is coerced to a `bool` by jinja truthiness rules
            // (`emit_truthy`). `elif` is desugared at PARSE time into a nested
            // TIf in the else-body (so the walk here is uniform).
            //
            // DEAD-BRANCH (Phase 1c): const-fold the condition; if it reduces to a
            // const bool, EMIT ONLY the taken branch's statements — no `if`
            // wrapper, the other branch is dropped entirely.
            let se: SExpr = simplify_sexpr(i.expr_expr(), h).any().view::<SExpr>();
            if !reject_tuple(se, "trama!: `{% if %}`") { return next_word(&i.next); }
            if !check_calls(se, ty, "trama!") { }
            let cc: ConstVal = sexpr_const(se);
            if cc.is_bool() {
                if cc.b {
                    let tb: ExprBlob = emit_stmts(body_word(&i.body), ty, vtys, ctx, depth + 1i64, h);
                    *st = quote_block! { #(tb); };
                } else {
                    let altw0: i64 = alt_word(&i.alt);
                    if altw0 != 0i64 {
                        let ab: ExprBlob = emit_stmts(altw0, ty, vtys, ctx, depth + 1i64, h);
                        *st = quote_block! { #(ab); };
                    }
                }
                return next_word(&i.next);
            }
            let mut cond: String = String::new();
            emit_truthy(&mut cond, se, ty, ctx);
            let cf: ExprBlob = parse_expr(cond.as_str());
            let tb2: ExprBlob = emit_stmts(body_word(&i.body), ty, vtys, ctx, depth + 1i64, h);
            let altw: i64 = alt_word(&i.alt);
            if altw != 0i64 {
                let ab2: ExprBlob = emit_stmts(altw, ty, vtys, ctx, depth + 1i64, h);
                *st = quote_block! { if (#(cf)) { #(tb2); } else { #(ab2); } };
            } else {
                *st = quote_block! { if (#(cf)) { #(tb2); } };
            }
            return next_word(&i.next);
        }
        TStmt::For(f) => {
            // {% for v in expr %} body {% endfor %} → indexed while-loop.
            let vname: Ident = Ident::new(f.var);
            let se: SExpr = simplify_sexpr(f.expr_expr(), h).any().view::<SExpr>();
            if !reject_tuple(se, "trama!: `{% for %}`") { return next_word(&f.next); }
            if !check_calls(se, ty, "trama!") { }
            let itf: ExprBlob = sexpr_blob(se, ty, ctx);
            let itf2: ExprBlob = sexpr_blob(se, ty, ctx);
            let si: String = nk_str_t("__i", depth);
            let ni: Ident = Ident::new(si.as_str());
            // Element type of the loop var: the reflected element type (Phase 2)
            // or the declared `with` type if any, else the i64 numeric baseline.
            // A STRUCT element (a schema type, not a primitive) is bound BY
            // REFERENCE — `let v: &Ty = &(iter)[__i];` — so field reads work
            // WITHOUT moving the element out of an index (E0507); a scalar element
            // (Copy) is bound by value.
            let vty: str = vtys.ty_name(f.var);
            let by_ref: bool = vty.len() > 0i64 && !is_primitive_ty(vty);
            let body: ExprBlob = emit_stmts(body_word(&f.body), ty, vtys, ctx, depth + 1i64, h);
            if by_ref {
                let vt: ExprBlob = parse_type(vty);
                *st = quote_block! {
                    let mut #ni: i64 = 0i64;
                    while #ni < (#(itf)).len() {
                        let #vname: &#(vt) = &(#(itf2))[#ni];
                        #(body);
                        #ni = #ni + 1i64;
                    }
                };
            } else {
                let vt2: ExprBlob = parse_type(if vty.len() > 0i64 { vty } else { "i64" });
                *st = quote_block! {
                    let mut #ni: i64 = 0i64;
                    while #ni < (#(itf)).len() {
                        let #vname: #(vt2) = (#(itf2))[#ni];
                        #(body);
                        #ni = #ni + 1i64;
                    }
                };
            }
            return next_word(&f.next);
        }
    }
}

/// `<stem><n>` — the per-depth loop counter's name.
fn nk_str_t(stem: str, n: i64) -> String {
    let mut s: String = String::new();
    s.push_str(stem);
    s.push_i64(n);
    return s;
}

// Is a Logos type NAME a primitive (Copy scalar rendered by value)? Struct/schema
// element types are everything else — bound by reference in the loop element.
fn is_primitive_ty(name: str) -> bool {
    // A scalar-lattice name is a primitive, with two corrections the lattice
    // cannot make: `String` OWNS its buffer, so binding it by value would move
    // it out of the row — it stays by-reference, as it was before this routed
    // through the shared table; `char` is a scalar the lattice has no class for.
    if str_eq(name, "String") { return false; }
    if el_class_lookup(name) >= 0i32 { return true; }
    return str_eq(name, "char");
}

// ── The resource handler ───────────────────────────────────────────────────
/// Handler behind the `trama!{}` macro: compiles a template into a render fn.
///
/// Invocation form:
/// ```text
/// resource render = trama!(c: &Ctx){ "template text" };
/// ```
/// emits `pub fn render(c: &Ctx) -> Result<String, ElError>`. The parens carry a
/// real Logos parameter list, re-emitted verbatim into the generated signature;
/// the braces hold the template body, quoted (`"…"`) or backtick-delimited
/// (backticks avoid escaping embedded `"` string literals in EL expressions).
///
/// Template syntax: `{{ expr }}` interpolation; `{% for x in coll %}…{% endfor %}`;
/// `{% if cond %}…{% else %}…{% endif %}`; `{% set x = expr %}`. Struct-typed
/// params are reflected (ADR 0012 Phase 2) so field/loop-var types — including
/// nested loop element types — are inferred with no `with` clause needed.
/// Arithmetic errors in an embedded expression (overflow, div-by-zero) surface as
/// `Err(ElError)`, never a host trap. `name`/`params`/`s` are the raw macro
/// input: the binding name, the parameter-list text, and the raw brace body.
#[token_macro]
pub fn trama(name: str, params: str, s: str) -> ItemList {
    let out: ItemList = item_list_new();

    if name.len() == 0i64 {
        error("trama!: needs a binding name — write `resource <name> = trama!(<params>){ \"template\" }`");
        return out;
    }
    // The generated render-fn NAME is the `resource <name> =` binding (ADR 0012
    // §6); the params come from the parens, the template body from the braces.
    let fn_name: str = name;

    // Parse the REAL parameter list (SHARED mechanism with wql! — params.logos).
    // The params are re-emitted VERBATIM below as the generated fn signature (so
    // the compiler parses + type-checks them); here we ALSO parse them locally
    // to drive schema reflection + value-typing.
    let mut prm: MacroParams = macro_params_new();
    parse_macro_params(params, &mut prm);
    if prm.n == 0i64 {
        error("trama!: needs at least one parameter — write `resource <name> = trama!(o: &Ty){ … }`");
        return out;
    }

    let mut lx: TLexer = TLexer { src: s, pos: 0i64, len: s.len() };

    // " template "
    let tmpl: str = lx.scan_template();
    if tmpl.len() == 0i64 { error("trama!: empty or missing \"template\""); return out; }

    // ── Parse the template → Trama AST via the GENERATED parser ──────────
    // `parse_tpl` yields the `tpl` as a WArray of per-statement TStmt handles
    // (bodies are likewise WArray edges); the T3 post-pass `chain_array` stitches
    // the `next`-linked chain the renderer walks (elif is already grammar-desugared
    // into nested TIf). The self-describing IR carries every name (Option B), so
    // no parser side tables are needed — the type dict is built from reflection +
    // `with`, exactly like the `wql!` handler.
    let h: Writ = writ_new(4096i64);
    let tpl_any: WAny = parse_tpl(tmpl, &h);
    if !tpl_any.is_array() { error("trama!: malformed template"); return out; }
    let tpl_arr: &WArray<WAny> = tpl_any.as_array();
    let head_word: i64 = chain_array(tpl_arr);
    if head_word == 0i64 { error("trama!: empty template"); return out; }

    // Build the name→value-type dict + the struct-type env by REFLECTING each
    // PARAM (ADR 0012 Phase 2). A struct param (its core type resolves to a
    // schema struct) is stamped so `{{ o.field }}` types automatically AND bound
    // in the env so field chains + `{% for v in o.field %}` loops resolve. A
    // scalar/str param (`greeting: str`) gets its value-type set directly so a
    // bare `{{ greeting }}` renders with the right push (str vs i64/bool). No
    // `with`/`data` clause exists any more — the params ARE the type source.
    let mut ty: ElTypes = el_types_new();
    let view: OView = oview_module_ast();
    let mut env0: StructEnv = struct_env_new();
    let mut pi: i64 = 0i64;
    while pi < prm.n {
        let pnm: str = prm.names[pi];
        let pty: str = prm.tys[pi];
        // Scalar/str value-type for the bare-param render path.
        ty.set_ty_named(pnm, resolve_alias_name(&view, pty));
        // If the core type names a schema struct, reflect its fields + bind the
        // env; a non-struct name (str/i64/…) is a no-op reflect + harmless bind.
        // A param type is a spelling too: `p: Prec` with `type Prec = Rec;` names a
        // schema, and the raw lookup would answer with the alias and reflect nothing.
        let decl: WAny = find_struct_decl(&view, pty);
        if !decl.is_null() {
            stamp_types_from_schema(&view, &mut ty, pty, pnm);
            env0.bind(pnm, pty);
        }
        pi = pi + 1i64;
    }
    // Register the module's top-level fns as UDFs — `{{ myfn(o.total) }}` /
    // `{% if myfn(x) %}` route through the SHARED emit_call path (zero
    // trama-specific lowering; builtins shadow same-named user fns).
    stamp_udfs_from_module(&view, &mut ty);
    report_ty_overflow(&mut ty);

    // ── RECURSIVE loop-var reflection (ADR 0012 Phase 2) ─────────────────────
    // FOLLOW loop variables: `{% for v in o.field %}` where `o.field` is a
    // schema'd collection binds `v` to the element type T (from the schema),
    // reflects T's fields so `v.member` types automatically, and recurses into
    // NESTED loops — so a schema struct param needs NO annotation.
    let mut vtys: TVarTys = tvartys_new();
    reflect_loops(&view, head_word, &mut ty, &mut vtys, &env0);
    report_ty_overflow(&mut ty);

    // The empty-Var-name fallback `ctx` for the codegen: the FIRST param name.
    let ctx0: str = prm.names[0i64];

    // ── Emit the render function, as a QUOTE (ADR 0024 S5, #370) ────────────
    // The whole fn is structure now: the HEAD (visibility, name, the surface
    // params through `parse_params`, the return type) and the BODY, built
    // bottom-up by `emit_stmts` — each Trama statement a fixed quote shape, a
    // nested body a block value spliced into its parent. Until #370 the body was
    // a text buffer reified once by `parse_block`, on the stated ground that a
    // runtime-depth nest has no fixed template; it does not need one, because
    // the nest is a composition of fixed shapes. The item travels on the blob
    // channel, whose package is the metacall SITE's, so the in-package stdlib
    // canary (trama_selfuse) lands where it did before.
    let stmts: ExprBlob = emit_stmts(head_word, &ty, &vtys, ctx0, 0i64, &h);
    let bd: ExprBlob = quote_block! {
        let mut __out: String = String::new();
        #(stmts);
        return Result::Ok(__out);
    };

    let nm: Ident    = Ident::new(fn_name);
    let ps: ExprBlob = parse_params(params);
    // The chunk's own `use` list: a spliced item is a SEPARATE AST doc and does
    // not inherit the trigger module's imports. `logos.lang.result` +
    // `logos.std.wql.el` carry the `Result<String, ElError>` return; the rest are
    // what a woven body may touch (String, and the collection tiers a
    // `{% for %}` over a schema'd container indexes). Trama binds no native
    // source, so there is no runtime-sized import repeat — unlike wql!.
    let q: QuoteItemBlob = quote_item! {
        use logos.mem.string; use logos.mem.collections.vec; use logos.lang.option;
        use logos.mem.collections.hashmap; use logos.mem.collections.set;
        use logos.mem.collections.btree; use logos.lang.result;
        use logos.std.wql.el; use logos.lang.writ.container;
        pub fn #nm(#(ps)) -> Result<String, ElError> #(bd)
    };
    unsafe { logos_emit_item_blob_subst(&q); }

    return out;
}
