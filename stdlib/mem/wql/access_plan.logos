// logos.std.wql.access_plan — the ACCESS PLAN, as an OBJECT (ADR 0024 S4).
//
// Until this module existed, a plan decision was indistinguishable from its
// effect. The picker wrote the chosen producer straight into
// `MacroParams.rel_mat` and dropped the query's residual filter in the same
// breath, so there was no moment at which a plan existed and had not yet been
// executed. Three things follow from that, and all three were true:
//
//   • cost had nowhere to live — there is no point costing a choice that has
//     already been made;
//   • one decision could not read another's, because the earlier one was
//     already baked into the params;
//   • EXPLAIN was not a thing that could be written, only a thing that could be
//     printed at the instant of deciding.
//
// So the plan is separated from its application. `AccessPlan` holds ONE record
// per rel — what will be called, with which constant, on which column, why, and
// how many rows the choice is expected to admit. Deciding fills it and mutates
// nothing; applying reads it and rewrites the query.
//
// The decision itself lives in `plan_walker` (it needs the query views); what
// lives here is the plan's SHAPE, the ordering that makes one access better
// than another, and the explanation.
package logos.std.wql.access_plan;

use logos.lang.str;
use logos.mem.string;
use logos.std.wql.params;    // MacroParams — rel names, the declared op table
use logos.std.wql.codegen;   // plan_trace / string_as_str — the ONE decision channel (S4a)

// ── Access kinds ──────────────────────────────────────────────────────────
// How the source will be read. A SCAN asks for every row; a POINT probe asks
// for the rows at one key; a RANGE asks for a contiguous window of the order.
// These are the shapes a source can DECLARE (ADR 0024 S6) — not a Memoria
// vocabulary: `HashMap` offers a point probe and no range, a vector offers both
// over its ordinal, and a hypothetical scan-only source offers neither.
pub fn ACC_SCAN() -> i32  { return 0i32; }
pub fn ACC_POINT() -> i32 { return 1i32; }
pub fn ACC_RANGE() -> i32 { return 2i32; }

// ── Cardinality class ─────────────────────────────────────────────────────
// An ORDINAL, not a row count: at macro-expansion time there is no container to
// count, and a plan that waited for one would never be made. What IS known is
// the shape of the answer, and the shapes are totally ordered — which is all
// "choose the narrower access" needs.
//
// ⚠ CARD_ONE says "the source answers at ONE key", not "one row": how many rows
// live at a key is the source's business, and nothing declares it yet. The
// ordering survives that gap, because a point probe cannot admit MORE rows than
// a range over the same column — so preferring it is sound without uniqueness.
// When multiplicity becomes declarable, this is the field it refines.
pub fn CARD_ONE() -> i32  { return 0i32; }
pub fn CARD_PART() -> i32 { return 1i32; }
pub fn CARD_ALL() -> i32  { return 2i32; }

pub fn ap_card_name(c: i32) -> str {
    if c == CARD_ONE()  { return "one key"; }
    if c == CARD_PART() { return "a range"; }
    return "every row";
}

/// The cardinality an operation answering `cmp` admits.
pub fn ap_card_of_cmp(cmp: str) -> i32 {
    if str_eq(cmp, "eq") { return CARD_ONE(); }
    if str_eq(cmp, "ge") || str_eq(cmp, "le")
        || str_eq(cmp, "gt") || str_eq(cmp, "lt") { return CARD_PART(); }
    return CARD_ALL();
}

pub fn ap_kind_of_cmp(cmp: str) -> i32 {
    if str_eq(cmp, "eq") { return ACC_POINT(); }
    if str_eq(cmp, "ge") || str_eq(cmp, "le")
        || str_eq(cmp, "gt") || str_eq(cmp, "lt") { return ACC_RANGE(); }
    return ACC_SCAN();
}

/// Does an operation declared for `have` ANSWER a demand for `want` — that is,
/// are the rows it returns a superset of the demand's matches?
///
/// This is the covering relation, written once. It used to be a two-step search
/// inside `rel_find_op` (exact match, then `ge` for `gt` / `le` for `lt`), which
/// silently encoded two claims: that the only useful weakening is strict→
/// non-strict, and that search ORDER is how a plan is chosen. Both were wrong.
/// A bound also covers equality — `key >= k` returns every row `key == k` does
/// and more — so a source declaring only `ge` can still answer `==` by a range
/// walk plus the query's own filter, which beats reading the whole container.
/// The rows it does not have are the rows it must not claim: `ge` says nothing
/// about `le`'s demand, and equality covers no bound at all.
pub fn ap_covers(have: str, want: str) -> bool {
    if str_eq(have, want) { return true; }
    if str_eq(want, "gt") { return str_eq(have, "ge"); }
    if str_eq(want, "lt") { return str_eq(have, "le"); }
    if str_eq(want, "eq") { return str_eq(have, "ge") || str_eq(have, "le"); }
    return false;
}

// ── MATERIALIZATION NODES (ADR 0025 §4) ───────────────────────────────────
//
// Until this section existed, every materialization in the emitted plane was a
// CONSEQUENCE of a boolean: a per-rel "reads it once" proof made `stream=false`
// made the prelude emit a `Vec` and a drain loop, and the sentence explaining it
// was attached to the boolean rather than to the thing that was built. Two facts
// about the plan could therefore not be stated at all:
//
//   • that a buffer was built where the plan STREAMS — a hash join reads its
//     build side exactly once and still materializes it, keyed, so the proof
//     said the opposite of what happens;
//   • that a materialization is a NODE with an operand and a result type,
//     rather than a mode flag on a rel.
//
// So a plan now carries a NODE LIST: what is built, over which rel, and on which
// ground. `Drain` empties a stream into a `Buffer`; `Sort` empties it into an
// ORDERED buffer (the `__ix0` permutation is its implementation, not a second
// mechanism); `Arrange` empties it into a keyed index (a join's build side).
//
// ⚠ AND THE NODE LIST IS NOW THE ONLY COPY (ADR 0025 §4, S2j). The layer landed
// DERIVED — computed from a boolean proof, changing no emitted byte, so that the
// derivation could be checked against the artifact before anything depended on
// it. That check passed, and the direction is now inverted: the walk that used to
// record the proof (`plan_walker::plan_insert_drains`) inserts the node, and the
// readers that used to ask the boolean ask the node list. There is no second
// representation left to disagree with it.
/// NO NODE — the plan builds nothing over this rel before the walk. Distinct
/// from `AD_BUFFER()` below, and the distinction is the whole of S2b: "nothing
/// is built because the rows stream" and "nothing is built because the producer
/// already handed back a buffer" are two different emitted preludes.
pub fn AD_NONE() -> i32     { return -1i32; }
/// ALREADY A BUFFER — the producer returns a container (`MG_CONTAINER`), so the
/// prelude names it rather than building it. Not a node: nothing is materialized.
pub fn AD_BUFFER() -> i32   { return -2i32; }
pub fn MAT_DRAIN() -> i32   { return 0i32; }
pub fn MAT_SORT() -> i32    { return 1i32; }
pub fn MAT_ARRANGE() -> i32 { return 2i32; }

pub fn mat_kind_name(k: i32) -> str {
    if k == MAT_SORT()    { return "sort"; }
    if k == MAT_ARRANGE() { return "arrange"; }
    return "drain";
}

/// THE PRELUDE LANDING'S BINDING NAME — ONE COMPOSER, AND IT SWITCHES ON THE
/// NODE (ADR 0025 R-F).
///
/// Until R-F every prelude landing was spelled `__rel_<r>`, whatever built it:
/// the Drain/Sort `Buffer` (12 in the corpus, OWNED by `drain` 7 + `sort` 5),
/// the SCC accumulator, the rel-fn one-shot result and the container binding
/// (205 `Vec`s, no owner). The criterion-1 instrument keys its ACC table on the
/// BINDING-NAME CLASS, so one name holding two identities can be credited only
/// by crediting all 217 or none — it credited none, and the recorded
/// `accounted` was a floor by 12. That is the same defect R-B1 paid off by
/// renaming the rel landing `__out` → `__rout`, and R-C3 by renaming the
/// `_run` dedup set `__rs` → `__rds`: A NAME IS AN IDENTITY OR IT IS NOTHING.
///
/// ⚠ TWO PREFIXES AND NOT ONE, because `drain` and `sort` are two heads and the
/// gate pins plan against artifact PER HEAD. `MAT_DRAIN` → `__rdb_<r>`,
/// `MAT_SORT` → `__rsb_<r>`. A landing under any other node keeps `__rel_<r>`:
/// the `Vec` arms are not this node and must not inherit its name — that is
/// exactly the collision being removed.
///
/// ⚠ THE NAME IS A FUNCTION OF THE PLAN NODE, so the composer lives beside the
/// node kinds rather than in `params.logos`. `params` holds `rel_srcs` (the
/// SLICE VIEW `__rel_<r>_sl`, the name every downstream reader resolves) and
/// `rel_ssrc` (`__rel_<r>`, the STREAMED producer's own binding) — neither is
/// this string, and routing the landing through either would move 9 reader
/// sites that have nothing to do with it. `params` also cannot see `MAT_*`:
/// this module imports `params`, not the reverse.
pub fn push_land_name(out: &mut String, node: i32, rname: str) {
    if node == MAT_DRAIN() { out.push_str("__rdb_"); }
    else if node == MAT_SORT() { out.push_str("__rsb_"); }
    else { out.push_str("__rel_"); }
    out.push_str(rname);
}

// ── The GROUNDS ────────────────────────────────────────────────────────────
// A ground is a TOKEN, not a sentence. The sentences stay exactly as they were
// and travel WITH the node (`nd_why`), because they are what a person reads;
// what the node layer needs beside them is a name that a gate can hold and that
// two grounds cannot accidentally share. ADR §4 names three verbatim — "drained:
// second use", "order by", "rel block" — and they are spelled here verbatim.
//
// ⚠ THE OTHERS ARE NOT FOLDED INTO THOSE THREE. `JS_NONE` is an UNDECIDED, not
// a proof of a second read; a nested loop is a proof of MANY reads; an aggregate
// regroups. Each keeps its own token, because a ground that gets rounded to the
// nearest ADR string is a justification that has drifted from its mechanism —
// which is the class this whole ADR exists to close.
pub fn MG_SECOND_USE() -> str { return "drained: second use"; }
pub fn MG_ORDER_BY() -> str   { return "order by"; }
pub fn MG_REL_BLOCK() -> str  { return "rel block"; }
pub fn MG_RESCAN() -> str     { return "rescanned: nested loop"; }
pub fn MG_UNDECIDED() -> str  { return "undecided: no join strategy"; }
pub fn MG_REGROUP() -> str    { return "regrouped: aggregate"; }
// ⚠ `MG_GPATH` ("lowered: graph path") WAS HERE AND IS DELETED (ADR 0025 §4,
// S2h). It was carried in the census as DEBT — a published sentence no corpus
// query reached — and the S2 rule was that the single-pass proof could not die
// until every such ground had a node fixture. Writing that fixture is what
// refuted the ground instead: `desugar_program_gpaths` (`wql.logos:177`) runs
// BEFORE the walk and clears `has_gpath` on every query kind, so the two arms
// that read it were unreachable, not merely unvisited. The distinction is the
// whole point — debt is a fixture someone owes, and a ground nothing can reach
// is a justification for a decision the compiler never makes. REFERENCE LIST at
// deletion, complete (grep over stdlib/ tests/ docs/, worktrees excluded): the
// two arms of the single-pass walk (deleted with it), the census gate's
// UNWITNESSED set, and ADR 0025 §4's debt paragraph. No emitter, no trace line
// and no artifact binding derived from it — corpus snapshot unchanged, 159 dumps
// / 6,776,657 bytes, `diff -rq` empty.
pub fn MG_JOIN_BUILD() -> str { return "join build side"; }
/// The drain pass's own fallback: the walk never reached this rel at all — a
/// source the entry query does not NAME, which the prelude materializes anyway —
/// so no ground was recorded and no single read was proven. Its own token for the
/// same reason `JS_NONE`
/// has one — "no proof" is not "proof of a second use", and a node that
/// borrowed the ADR's first ground here would claim a mechanism it never saw.
pub fn MG_UNPROVEN() -> str   { return "unproven: no single-read proof"; }
/// Not a ground for a node — the ground for the ABSENCE of one. A producer that
/// returns a container hands back a `Buffer` already; the prelude's `Vec` binding
/// is that value under a name, not a materialization the plan performed. ADR §4:
/// this ground dies with the node layer, and it dies by being recorded as "no
/// node" rather than by going quiet.
pub fn MG_CONTAINER() -> str  { return "already a buffer"; }
/// ADR 0025 S3 — THE SECOND GROUND FOR THE ABSENCE OF A NODE, and the one this
/// stage exists to make sayable. The query asked for `order by <c>`; the source
/// declared that its rows already ARRIVE sorted by `<c>` (`order <rel> = <c>;`,
/// admitted only because the producer's return type implements `OrderedBy`), so
/// the Sort node the previous stage would have inserted is not inserted.
///
/// ⚠ IT IS A GROUND, NOT A SILENCE, AND THAT IS THE WHOLE REQUIREMENT. An
/// elision is invisible in the artifact by construction — the emitted code
/// simply lacks a phase — so "no Sort node" and "the planner never considered
/// sorting" produce the SAME plan text and the SAME trace, and a reader cannot
/// tell an optimization from a bug that skipped a step. `MG_CONTAINER` set the
/// precedent (an absence recorded rather than gone quiet); this ground extends
/// it from "nothing was built because the producer handed one over" to "nothing
/// was built because the ORDER WAS ALREADY TRUE".
pub fn MG_ORDERED_SOURCE() -> str { return "ordered source: order by is a no-op"; }
/// ADR 0025 S3-desc — THE SAME ABSENCE, REACHED THE OTHER WAY ROUND, and it
/// gets its own ground rather than sharing the one above.
///
/// `order by <c> desc` over a source sorted by `<c>` also emits no Sort node —
/// but the emitted walk is NOT the same walk. The ascending case changes
/// nothing about traversal (the rows were already arriving in the wanted
/// order); the descending case LANDS AT THE END (one `land_end()` =
/// `seek_nth(size())`) and pulls backward with `prev_batch`. Two different
/// emitted shapes behind one ground would be a plan that says the same sentence
/// about two artifacts — and the reader who noticed the reversed answer
/// sequence would have no line to read it off. The traversal capability the
/// decision rests on differs too: this ground requires `Bidirectional` AND
/// `RandomAccess` of the producer's type, where the ascending one requires
/// neither.
pub fn MG_ORDERED_SOURCE_REV() -> str { return "ordered source, reversed: order by desc is a backward walk"; }

// ── THE GROUP FRAME (ADR 0025 §8, S4-naming) ─────────────────────────────────
//
// THE OBLIGATION, MEASURED: the aggregate emitter materializes a family of
// per-group columns and the plan named NOT ONE of them. `MG_REGROUP` names the
// aggregate's DRAIN of its base source and says nothing about the state the
// grouping itself builds — so `let mut (__g_key|__g_cnt|__g_row|__ga_*|__gf_*)`
// was the largest unnamed class in criterion 1: 1,122 bindings when the class
// was first counted, 380 on this tree (the S4 fold deleted `__gf_*` outright,
// 488 -> 0, and put `__g_cnt` and `__g_row` behind their consumers, 146 -> 13
// and 146 -> 7). A number that falls by two thirds is still a number no
// justification covers.
//
// ── WHY THESE ARE GROUNDS ON FIELDS AND NOT A NEW NODE KIND ──────────────────
// The plan's node kinds are ADAPTERS over a stream — `Drain`, `Sort`, `Arrange`
// — things that MATERIALIZE something a later phase reads back. A group table is
// not an adapter over a stream, it is the OPERATOR'S OWN STATE, exactly as a
// join's build side is; and §4 already models the join's build side as an
// `Arrange` rather than as a `Join` node. Adding a `GroupBy`/`Fold` KIND would
// put an operator into a vocabulary of adapters and make `explain()` print two
// different kinds of thing under one word. The γ operator is already in the plan
// (`RQuery::Aggr`, and its base drain carries `MG_REGROUP`); what was missing is
// not a node — it is the STATE'S PRICE and its GROUND.
//
// ⚠ AND THE DESIGN'S OWN FIRST ANSWER — "`Arrange` is the group table's kind" —
// IS REFUSED ON A MEASUREMENT, not on taste. The census pins `#(arrange nodes)
// == #(emitted `__hm`/`__hs`/`__bt` bindings)`, 598 == 598, per fixture and in
// total: an arrange node is the claim that the artifact BUILT AN INDEX. The
// group table is a linear `==` scan over `__g_key` (S4's MVP dedup) and builds
// no index at all, so 152 group tables spelled `arrange` would have made that
// identity false and forced it to be re-partitioned by ground — a sensor
// weakened to admit a claim the artifact does not support. The group table is
// therefore reported the way `sort_key_vector` reports `__ks` (`join_sel`): as a
// FIELD of an operator already in the plan, with its own verdict word, so that
// no reader counts it as a node and the 598 == 598 identity stays exact — and
// stays exact ACROSS this change, which is this stage's control.
//
// The four grounds are one per EMITTED COLUMN FAMILY, and each is separate
// because each has a different consumer and a different life:
pub fn AG_GROUPS() -> str   { return "group table: one row per distinct key"; }
/// `__g_cnt` — and it is NOT folded into `AG_GROUPS` even though the design
/// bracketed it there ("the group table `__g_key` (+ `__g_cnt` when live)"). A
/// column present in 13 of 152 group tables cannot be counted by a census that
/// counts ground lines if it shares a ground with the table itself, and its
/// sentence is a DIFFERENT sentence: S4b measured that `__g_cnt` has exactly one
/// reader, `avg`'s finalize denominator, and gated its declaration on that. A
/// ground rounded to the nearest neighbouring ground is the drift this whole
/// vocabulary exists to refuse.
pub fn AG_COUNT() -> str    { return "group rows: avg's denominator"; }
pub fn AG_ACCUM() -> str    { return "accumulated: one cell per group per aggregate"; }
/// `__g_row`. THE CLASS PREDICATE'S GROUND (S4c): emitted only where a clause
/// ABOVE the group — `select`, `having`, `order by` — names a SOURCE ROW, which
/// is also the only class whose base the plan still drains for the reason
/// `MG_REGROUP` gives. Its absence is what a single-pass fold IS.
pub fn AG_REP_ROW() -> str  { return "re-bound: the projection names a source row"; }

// ── The plan ──────────────────────────────────────────────────────────────
// One record per rel, indexed by the rel registry's index so the applier and
// the explainer agree with the params without a side table.
//
// `op < 0` IS the scan: no operation was chosen, and `why` says what stopped
// one from being chosen. That case carries as much information as the other —
// "this reads the whole container BECAUSE the source declares nothing for that
// column" is the answer a person debugging a slow query actually needs, and it
// is exactly the answer a decision recorded only on success cannot give.
pub struct AccessPlan {
    pub kind:  [i32; 8],
    pub card:  [i32; 8],
    pub op:    [i64; 8],   // index into the flat op table, or -1 = scan
    pub fnm:   [str; 8],   // the operation implementing it
    pub arg:   [str; 8],   // the narrowing constant, typed by the column
    pub col:   [str; 8],
    pub cmp:   [str; 8],   // the DEMAND this access answers
    pub exact: [bool; 8],  // its rows are precisely the demand's matches
    pub why:   [str; 8],
    /// STREAM instead of materialize (ADR 0024 S4). The producer hands back an
    /// iterator AND the plan consumes it exactly once, so no `Vec` is built at
    /// all: a `find` over a million rows stops at the first match, and a scan
    /// pays no allocation proportional to the answer.
    ///
    /// The two conjuncts are different KINDS of fact and must not be collapsed.
    /// "The source can stream" is the source's to declare. "This plan reads it
    /// once" is the planner's to know, and it is the one that can be wrong: a
    /// rel re-scanned by a join, revisited by a fixpoint, or indexed after a
    /// sort must be drained first. An iterator is the general form and a `Vec`
    /// is an eagerly-drained one — never the reverse — which is why draining is
    /// always available as the fallback.
    pub stream: [bool; 8],
    pub swhy:   [str; 8],
    /// ADR 0025 S3 — THE ELISION, decided by the walk and recorded ONCE. The
    /// query has an `order by` over exactly the column this source declares its
    /// rows already arrive sorted by, so no Sort node was inserted and the walk
    /// still counts as a single read.
    ///
    /// It lives on the PLAN and not on the params for the reason S2j gave for
    /// inverting the proof: the walk is the only pass that holds both the query
    /// (`RQSimple.order_key`, `order_desc`) and the registry (`rel_ordcol`), so
    /// it is the only place the two can be compared. `plan_apply_access` copies
    /// the answer to `MacroParams.rel_ord_noop` for the emitter, the same way
    /// `rel_node` is copied — one decision, carried, never re-derived. An
    /// emitter that re-ran the predicate would be a second representation, and
    /// the two would eventually disagree about whether a sort happened.
    pub ord_noop: [bool; 8],
    /// ADR 0025 S3-desc — the DIRECTION of the elided order, decided in the
    /// same place and by the same predicate. Only read when `ord_noop` is set.
    pub ord_rev: [bool; 8],
    /// ⚠ `once: [bool; 8]` AND `owhy: [str; 8]` WERE HERE AND ARE DELETED (ADR
    /// 0025 §4, the S2j INVERSION). They were the side channel: a per-rel proof
    /// of a single read, written by one pass, read by one other, and turned into
    /// a node by a third. The node list below already says everything they said
    /// and says it about the thing that is BUILT — so the walk that used to
    /// record the proof now inserts the node directly (`plan_insert_drains`),
    /// and "reads it once" is recovered where it is needed as "no drain node
    /// over this rel". One representation, no agreement to maintain.
    ///
    /// The ORTHOGONALITY those two fields could not state is why the direction
    /// is this one and not the reverse: a hash join reads its build side exactly
    /// once and still materializes it, so `once=true` and "a buffer is built"
    /// were simultaneously correct and read as contradictory.
    ///
    /// The ground for the ABSENCE of a node. Only ever `MG_CONTAINER()` — the
    /// producer hands back a container, so nothing is built and the prelude
    /// names the buffer it was given — or `""`, which reads as "no node because
    /// the rows stream". Written by `access_plan_decide_mode` alone; the grounds
    /// for nodes that DO exist live on the nodes, in `nd_gnd`.
    pub mgnd:   [str; 8],
    /// THE NODE LIST — one entry per materialization this plan performs, in the
    /// order the emitted code performs them (prelude first, then the build
    /// phase). `nd_rel` is the rel index the node consumes; `nd_gnd` the ground
    /// token; `nd_why` the sentence. Capacity is 2 per rel: a rel can be
    /// buffered by the prelude and arranged by a join, and nothing else in this
    /// plane builds a third.
    pub nd_kind: [i32; 16],
    pub nd_rel:  [i64; 16],
    pub nd_gnd:  [str; 16],
    pub nd_why:  [str; 16],
    pub nd_n:    i64,
    /// THE SOURCE'S SIZE, as a fact the plan ASKED FOR (ADR 0024 S4).
    ///
    /// `card` above is an ordinal because expansion time has nothing to count.
    /// This is the other half of that sentence: the number exists at RUN time,
    /// so what a compile-time plan can hold is the ASKING — which fn reports the
    /// size (`size_fn`), where the answer lands in generated code (`size_at`),
    /// and, when neither exists, why the plan could not ask (`size_why`).
    ///
    /// ⚠ IT DOES NOT REPLACE THE ORDINAL, and the two are consumed by different
    /// readers. `card` orders two candidate accesses in `plan_narrow_rel`, which
    /// runs before any container exists and must still choose; the measured
    /// number refines it for a decision made where the data is — a join's
    /// driving side, which is where a runtime fact changes the answer in
    /// multiples rather than confirming it. Nothing consumes `size_at` yet: this
    /// phase supplies the fact and records that it was obtained.
    ///
    /// ⚠ ASKED ONCE. A size is a property of the relation, not of a row, so it
    /// is read in the prelude beside the source's own binding and never inside a
    /// walk. `size_at` naming ONE binding per rel is what holds that.
    pub size_fn: [str; 8],
    pub size_at: [str; 8],
    pub size_why:[str; 8],
    pub n:     i64,
    /// The residual filter is redundant and will be dropped. A property of the
    /// QUERY, not of a rel: the filter belongs to the query node, and only an
    /// access exact for the whole demand may retire it.
    pub drop_where: bool,
}

pub fn access_plan_new(n: i64) -> AccessPlan {
    return AccessPlan {
        kind:  [ACC_SCAN(); 8],
        card:  [CARD_ALL(); 8],
        op:    [-1i64; 8],
        fnm:   ["", "", "", "", "", "", "", ""],
        arg:   ["", "", "", "", "", "", "", ""],
        col:   ["", "", "", "", "", "", "", ""],
        cmp:   ["", "", "", "", "", "", "", ""],
        exact: [false; 8],
        why:   ["", "", "", "", "", "", "", ""],
        stream: [false; 8],
        swhy:  ["", "", "", "", "", "", "", ""],
        ord_noop: [false; 8],
        ord_rev:  [false; 8],
        mgnd:  ["", "", "", "", "", "", "", ""],
        nd_kind: [0i32; 16],
        nd_rel:  [-1i64; 16],
        nd_gnd:  ["", "", "", "", "", "", "", "",
                  "", "", "", "", "", "", "", ""],
        nd_why:  ["", "", "", "", "", "", "", "",
                  "", "", "", "", "", "", "", ""],
        nd_n:    0i64,
        size_fn: ["", "", "", "", "", "", "", ""],
        size_at: ["", "", "", "", "", "", "", ""],
        size_why:["", "", "", "", "", "", "", ""],
        n: n,
        drop_where: false,
    };
}

impl AccessPlan {
    /// THE PRELUDE'S NODE FOR REL `ri` — its INDEX in the node list, or `-1`.
    ///
    /// ⚠ ARRANGE NODES ARE NOT PRELUDE NODES and are skipped here. A join's build
    /// side is filled by the step's build loop, not by the prelude, and a lookup
    /// that returned the first node over the rel would answer "a buffer is bound
    /// before the walk" for every arranged-but-streamed source — which is exactly
    /// the orthogonality ("read once" ⟂ "materializes") the node list exists to
    /// state, and which the deleted `once` boolean could not.
    pub fn prelude_ix(self: &AccessPlan, ri: i64) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.nd_n {
            if self.nd_rel[i] == ri && self.nd_kind[i] != MAT_ARRANGE() {
                return i;
            }
            i = i + 1i64;
        }
        return -1i64;
    }

    /// THE PRELUDE'S NODE KIND FOR REL `ri`, as the EMITTER must ask it (ADR 0025
    /// §4, S2b) — `MAT_DRAIN`/`MAT_SORT` when this plan builds a buffer over the
    /// rel before the walk, `AD_NONE()` when it does not build one.
    pub fn prelude_node(self: &AccessPlan, ri: i64) -> i32 {
        let ix: i64 = self.prelude_ix(ri);
        if ix < 0i64 { return AD_NONE(); }
        return self.nd_kind[ix];
    }

    fn push_node(self: &mut AccessPlan, kind: i32, ri: i64, gnd: str, why: str) {
        if self.nd_n >= 16i64 { return; }
        self.nd_kind[self.nd_n] = kind;
        self.nd_rel[self.nd_n]  = ri;
        self.nd_gnd[self.nd_n]  = gnd;
        self.nd_why[self.nd_n]  = why;
        self.nd_n = self.nd_n + 1i64;
    }
}

/// THE SOURCE'S OFFER for rel `ri`: does the producer that will actually run
/// hand back an ITERATOR — the chosen operation's, or the rel's own binding when
/// nothing narrowed?
///
/// ⚠ A SURVIVOR OF ADR 0025 S2f/S2g/S2h, AND THE ONE THE OTHERS ARE DEFINED
/// AGAINST — do not rewrite this to the plan's node. S1's gate correction,
/// verbatim: `rel_iter`/`opc_iter` is the SOURCE'S OFFER, and this fn is where
/// the offer is read. A node is the DECISION, so a node read here would be
/// circular: the two callers below are precisely "offer" and "offer AND no node".
///
/// It has TWO readers since the S2j inversion (`plan_insert_drains` and
/// `access_plan_decide_mode`) and is a fn rather than a line for that reason —
/// two spellings of the offer that drifted apart would put a drain node on a
/// container, which is the one combination `mgnd` cannot represent.
pub fn ap_offers(ap: &AccessPlan, prm: &MacroParams, ri: i64) -> bool {
    if ri < 0i64 || ri >= 8i64 { return false; }
    if ap.op[ri] >= 0i64 { return prm.opc_iter[ap.op[ri]]; }
    return prm.rel_iter[ri];
}

/// INSERT the prelude's materialization node over rel `ri` (ADR 0025 §4, S2j).
///
/// The one authored form of "this plan empties the source into a buffer before
/// the walk": `Sort` when the ground is `order by` (an ordered buffer is what the
/// sort phase builds, and the `__ix0` permutation is its implementation), `Drain`
/// otherwise. The kind is derived from the GROUND TOKEN and not from prose, which
/// is why the token is a parameter beside the sentence rather than recovered from
/// it — the sentences are meant to be rewritten.
///
/// ⚠ A CONTAINER PRODUCER GETS NO NODE, and the check is HERE rather than in the
/// walk. A source that hands back a container is a buffer already; nothing is
/// built, so there is nothing for a node to name, and `access_plan_decide_mode`
/// records that absence with `MG_CONTAINER`. Before the inversion this was the
/// mode pass overwriting a ground the walk had recorded; now the node is simply
/// never pushed, and "a drain node over a rel whose producer offers no iterator"
/// is unrepresentable rather than merely unwritten.
///
/// ⚠ ONE PRELUDE NODE PER REL, AND THE LAST GROUND WINS. A walk reaches one rel
/// from several positions — a self-join names it as base and as step, an
/// aggregate as its scan and as a step of its chain — and the boolean this pass
/// replaces was OVERWRITTEN on each visit, so the plan's answer was the last
/// one. Pushing a second node instead would make `explain()` report one
/// materialization twice and would spend the node list's capacity on repeats,
/// so a re-drain REWRITES the rel's prelude node in place. The prelude builds
/// one buffer per rel; the node list says one thing about it.
pub fn ap_drain(ap: &mut AccessPlan, prm: &MacroParams, ri: i64, gnd: str, why: str) {
    if ri < 0i64 || ri >= 8i64 { return; }
    if !ap_offers(ap, prm, ri) { return; }
    let k: i32 = if str_eq(gnd, MG_ORDER_BY()) { MAT_SORT() } else { MAT_DRAIN() };
    let ix: i64 = ap.prelude_ix(ri);
    if ix >= 0i64 {
        ap.nd_kind[ix] = k;
        ap.nd_gnd[ix]  = gnd;
        ap.nd_why[ix]  = why;
        return;
    }
    ap.push_node(k, ri, gnd, why);
}

/// Decide MATERIALIZE vs STREAM for every rel: the source's OFFER and the plan's
/// own NODE LIST, each of which is recorded by whoever owns it.
///
/// ── ADR 0025 §4, S2j — THE INVERSION ──────────────────────────────────────
/// This used to read `ap.once[ri]`, a per-rel boolean proof written by
/// `plan_mark_single_pass` and turned into a node afterwards by a third pass. The
/// proof is gone: `plan_insert_drains` inserts the node where the proof used to be
/// recorded, and "the plan reads this source exactly once" is recovered here as
/// THE ABSENCE OF A DRAIN NODE OVER IT. Same conjunction, one representation:
/// there is no longer a boolean that can disagree with the node list.
///
/// Note which direction the recovery runs. A node is a fact about what is BUILT;
/// "read once" is a conclusion about the walk. Deriving the conclusion from the
/// artifact is sound because every ground that blocks a single read now inserts a
/// node — deriving the artifact from the conclusion was what needed a third pass.
pub fn access_plan_decide_mode(ap: &mut AccessPlan, prm: &MacroParams) {
    let mut ri: i64 = 0i64;
    while ri < ap.n {
        let offers: bool = ap_offers(ap, prm, ri);
        let nx: i64 = ap.prelude_ix(ri);
        if !offers {
            ap.swhy[ri] = "materialized: the producer returns a container, not an iterator";
            // The node question is answered by the PRODUCER here, whatever the
            // walk concluded about second reads: a container is a buffer
            // already, so no node was inserted (`ap_drain` refuses one) and the
            // ground says which absence this is (ADR 0025 §4).
            ap.mgnd[ri] = MG_CONTAINER();
        } else if ap.ord_noop[ri] {
            // ADR 0025 S3 — STREAMED, and the `order by` did not stop it. Said
            // in the ACCESS line too and not only on the node line, because
            // this is the one case where the previous stage's answer was the
            // opposite: the same query drained this source before S3, so a
            // reader comparing two plans needs the access line to name the
            // reason it stopped.
            ap.stream[ri] = true;
            if ap.ord_rev[ri] {
                ap.swhy[ri] = "streamed BACKWARD: the producer is an iterator over the column the rows already arrive sorted by, the plan reads it once, and `desc` is one landing at the end plus a backward pull";
                ap.mgnd[ri] = MG_ORDERED_SOURCE_REV();
            } else {
                ap.swhy[ri] = "streamed: the producer is an iterator, the plan reads it once, and the `order by` is over the column the rows already arrive sorted by";
                ap.mgnd[ri] = MG_ORDERED_SOURCE();
            }
        } else if nx >= 0i64 {
            // THE NODE'S OWN SENTENCE, not a second copy of it. `swhy` and
            // `nd_why` used to be written from `owhy` independently and could
            // report a materialization two ways; now the per-rel line in
            // `explain()` and the node line quote one string.
            ap.swhy[ri] = ap.nd_why[nx];
        } else {
            ap.stream[ri] = true;
            ap.swhy[ri] = "streamed: the producer is an iterator and the plan reads it once";
        }
        ri = ri + 1i64;
    }
}

/// ASK every source for its SIZE, and record what was asked (ADR 0024 S4).
///
/// A separate pass for the same reason materialize-vs-stream is one: it answers a
/// different question from the access choice. The access says WHICH rows, the mode
/// says how they travel, this says HOW MANY there are — and it is the only one of
/// the three whose answer does not exist until the query runs.
///
/// Reads the source's declaration and nothing else. A size that were derived from
/// a source's shape would exclude the source that has neither a `measure count`
/// nor a `len`, and that source must stay usable — so the absence is a recorded
/// answer, not a gap.
pub fn access_plan_ask_size(ap: &mut AccessPlan, prm: &MacroParams) {
    let mut ri: i64 = 0i64;
    while ri < ap.n {
        if prm.rel_size_fn[ri].len() > 0i64 {
            ap.size_fn[ri]  = prm.rel_size_fn[ri];
            ap.size_at[ri]  = prm.rel_size_at[ri];
            ap.size_why[ri] = "measured: the source reports its size, read once before the first row";
        } else {
            ap.size_why[ri] = "unmeasured: the source declares no size operation, so the cardinality ORDINAL is all this plan has";
        }
        ri = ri + 1i64;
    }
}

impl AccessPlan {
    /// Record the chosen operation for rel `ri`.
    pub fn choose(self: &mut AccessPlan, ri: i64, oi: i64, fnm: str, arg: str,
                  col: str, cmp: str, op_cmp: str, exact: bool, why: str) {
        if ri < 0i64 || ri >= 8i64 { return; }
        self.op[ri]    = oi;
        self.fnm[ri]   = fnm;
        self.arg[ri]   = arg;
        self.col[ri]   = col;
        self.cmp[ri]   = cmp;
        self.kind[ri]  = ap_kind_of_cmp(op_cmp);
        self.card[ri]  = ap_card_of_cmp(op_cmp);
        self.exact[ri] = exact;
        self.why[ri]   = why;
    }

    /// Record that rel `ri` is read whole, and the antecedent that decided it.
    pub fn scan(self: &mut AccessPlan, ri: i64, why: str) {
        if ri < 0i64 || ri >= 8i64 { return; }
        self.why[ri] = why;
    }
}

/// The plan, read back — the seed of EXPLAIN. Every rel reports, including the
/// ones that were left alone: a plan that only speaks when it acted is a plan
/// whose silence has two meanings.
pub fn access_plan_explain(ap: &AccessPlan, prm: &MacroParams) {
    if !plan_trace_on() { return; }
    let mut ri: i64 = 0i64;
    while ri < ap.n {
        let mut vb: String = String::new();
        if ap.op[ri] < 0i64 { vb.push_str("scan"); }
        else { vb.push_str(ap.fnm[ri]); }
        vb.push_str(" ["); vb.push_str(ap_card_name(ap.card[ri])); vb.push_str("]");
        let w: str = if ap.why[ri].len() > 0i64 { ap.why[ri] }
                     else { "no filter reaches this rel" };
        plan_trace(prm.rel_names[ri], string_as_str(&vb), ap.col[ri], w);
        if ap.swhy[ri].len() > 0i64 {
            plan_trace(prm.rel_names[ri],
                       if ap.stream[ri] { "stream" } else { "materialize" },
                       "", ap.swhy[ri]);
        }
        // The SIZE the plan asked for, or the absence of one. Reported for every
        // rel, like the access: a plan that only speaks when it got a number
        // leaves "no line" meaning both "did not ask" and "asked and got none".
        if ap.size_why[ri].len() > 0i64 {
            let mut sb: String = String::new();
            if ap.size_fn[ri].len() > 0i64 {
                sb.push_str(ap.size_fn[ri]);
                if ap.size_at[ri].len() > 0i64 {
                    sb.push_str(" -> "); sb.push_str(ap.size_at[ri]);
                }
            }
            plan_trace(prm.rel_names[ri],
                       if ap.size_fn[ri].len() > 0i64 { "size" } else { "size unknown" },
                       string_as_str(&sb), ap.size_why[ri]);
        }
        // WHAT THIS PLAN BUILDS OVER THIS REL, or the fact that it builds
        // nothing (ADR 0025 §4). Reported per rel and POSITIVELY in both
        // directions, for the reason the access line is: a materialization
        // visible only when it happens leaves "no line" meaning both "nothing
        // was built" and "nobody looked".
        let mut nk: i64 = 0i64;
        let mut spoke: bool = false;
        while nk < ap.nd_n {
            if ap.nd_rel[nk] == ri {
                plan_trace(prm.rel_names[ri], mat_kind_name(ap.nd_kind[nk]),
                           ap.nd_gnd[nk], ap.nd_why[nk]);
                spoke = true;
            }
            nk = nk + 1i64;
        }
        if !spoke {
            // THREE absences now, each with its own ground, and the third is
            // the one S3 exists to make sayable: no Sort node was built because
            // the ORDER WAS ALREADY TRUE. Left as the shared "" ground it would
            // have read as "the query had no `order by`" — a plan that elides a
            // phase and then describes itself as a plan that never had one is
            // exactly the justification-drifted-from-mechanism class.
            let mut gnd0: str = "";
            let mut why0: str = "no node: the plan reads this source once and consumes it where it stands";
            if str_eq(ap.mgnd[ri], MG_CONTAINER()) {
                gnd0 = MG_CONTAINER();
                why0 = "no node: the producer hands back a container, which IS a buffer — nothing is built";
            } else if str_eq(ap.mgnd[ri], MG_ORDERED_SOURCE()) {
                gnd0 = MG_ORDERED_SOURCE();
                why0 = "no sort node: the query orders by the column this source declares its rows already arrive sorted by, so the permutation would be the identity — the walk streams in order";
            } else if str_eq(ap.mgnd[ri], MG_ORDERED_SOURCE_REV()) {
                // FOUR absences now. The sentence names the TRAVERSAL, because
                // that is the whole difference between this ground and the one
                // above and a reader comparing two elided plans has nothing
                // else to go on: both lack a Sort node, and only one of them
                // runs the walk backwards.
                gnd0 = MG_ORDERED_SOURCE_REV();
                why0 = "no sort node: the query orders by the column this source declares its rows already arrive sorted by, and `desc` reverses the WALK instead of the rows — one `seek_nth(size())` to land at the end, then a backward pull per leaf";
            }
            plan_trace(prm.rel_names[ri], "no materialization", gnd0, why0);
        }
        ri = ri + 1i64;
    }
}
