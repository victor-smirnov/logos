// logos.std.wql.ir — the WQL Intermediate Representation, expressed as Writ
// schemas (ADR 0012 §1/§2, dogfooding ADR 0011).
//
// Every IR node is a `schema` over a Writ TinyObjectMap; each family is a
// `schema enum` whose discriminant is read from the pointee's
// `schema_type_code` (no stored tag). Two tiers:
//
//   • SExpr  (category 0x0010) — the SCALAR algebra (CEL-class expressions).
//   • RExpr  (category 0x0011) — the RELATIONAL / GRAPH algebra (scan/edge/
//                                filter/project/join/anti/aggr/fix).
//
// Edges between nodes are `WRef<S>` fields: a `WRef` is a typed, erased Writ
// reference handle (a `WAny` carrying a self-relative ref), bound back to a
// concrete view via `WAny::resolve()` + `.view::<S>()` at consumption time
// (ADR 0012 §10.5). `WRef<S>` impls `WritField`, so a `lhs: WRef<SExpr>` field
// stores/loads exactly like any other schema field — the conversion is the
// identity over the underlying `WAny` handle (the typing is compile-time only;
// `S` is a phantom tag that documents the edge target).
//
// `RFix` is DECLARED here but is the sole inert node in the static queue-1
// backend (Datalog base; "not yet"). See ADR 0012-impl-seam §7.
package logos.std.wql.ir;

use logos.lang.writ.container;
use logos.lang.writ.allocator;   // Allocator (WritField::to_wany param)
use logos.lang.writ.anyval;
use logos.lang.writ.wmap;
use logos.lang.writ.array;   // WArray — a schema's list field

// ── Integer-literal overflow POISON sentinel ──────────────────────────────
// The three EL/surface/template tokenizers (`wstr_decode_i64`) accumulate an
// integer literal with CHECKED ops; a literal exceeding i64::MAX yields this
// sentinel (i64::MIN) instead of clamping or trapping. i64::MIN is
// unrepresentable by a valid (non-negative decimal) token, so the STATIC check
// phase (codegen::check_calls) and the DYNAMIC checker (deem check_expr/
// check_rexpr) detect it unambiguously and raise a clean COMPILE error. Spelled
// as `(i64::MAX-negated) - 1` so the stdlib source itself never writes the
// out-of-range literal `-9223372036854775808` (which would fail to parse).
pub fn el_lit_poison() -> i64 { return (-9223372036854775807i64) - 1i64; }

// ── WRef<S> — a typed edge handle ─────────────────────────────────────────
// A `WRef<S>` is the one graph-edge primitive (the bounded step). It carries a
// `WAny` ref handle; `S` is a phantom compile-time tag naming the target node
// family. Stored verbatim as the WAny (identity WritField conversion); resolved
// to a concrete view by the consumer via `h.resolve()` + `.view::<S>()`.
pub struct WRef<S> {
    pub h: WAny,
}

impl<S> WRef<S> {
    // Wrap an existing erased ref handle.
    pub fn from_any(h: WAny) -> WRef<S> { return WRef::<S> { h: h }; }
    // The erased handle (consumers call `.resolve()` then `.view::<S>()`).
    // BY VALUE: a `WRef` is an 8-byte handle wrapping the document's `WAny`,
    // and the handle it returns belongs to the DOCUMENT. Through `&self`,
    // elision gave the result the WRAPPER's region — so `prog.segs.any()`,
    // whose receiver is a field TEMPORARY, produced a WAny that died with
    // that temporary while the caller still held it.
    pub fn any(self: WRef<S>) -> WAny { return self.h; }
}

// `WRef<S>` is a schema field: the at-rest value IS the WAny handle (identity).
impl<S> WritField for WRef<S> {
    fn from_wany(v: WAny) -> Self { return WRef::<S> { h: v }; }
    fn to_wany(self: Self, z: *mut Allocator) -> WAny { return self.h; }
}

// `n` empty names. A plain loop rather than `vec![""; n]`: instantiated for
// `str` inside this module's own build, `vec_from_elem` is refused by the
// borrow checker (`borrowed data escapes outside of function: 'elem'`), while
// the same call in a user program compiles.
pub fn str_vec(n: i64) -> Vec<str> {
    let mut v: Vec<str> = Vec::<str>::new();
    let mut i: i64 = 0i64;
    while i < n { v.push(""); i = i + 1i64; }
    return v;
}

// `SExprArr` — the materialized arg / projection list (ADR 0012 §1): a `count`
// and the argument edges as one list field (below). `arg_at(i)` / `len()` are
// the backend's read API; `set_arg`/`set_len` the parser's write API.
// ── LIST FIELDS ───────────────────────────────────────────────────────────────
// A schema's dynamic fan-out: the items are one Writ array held in a `WAny`
// field. `list_set` writes item `i` through the view's arena allocator `z`
// (WSchemaH.z): it creates the array on the first write, replaces an item below
// the length and appends at it; a gap is a defect, so it panics.
pub fn list_get(items: WAny, i: i64) -> WAny {
    // Unchecked on purpose: a list field is written only by `list_set` and the
    // generated parsers, and this read is on every step / argument / rel
    // access of the compile (`as_array` re-checks the tag each time).
    return unsafe { array_get_unchecked(items.resolve() as *const WArray<WAny>, i) };
}

pub fn list_set(items: WAny, z: *mut u8, i: i64, v: WAny) -> WAny {
    if z == 0 as *mut u8 { logos.lang.panic::panic("a list field written through a view that carries no arena"); }
    let mut a: *mut WArray<WAny> = 0 as *mut WArray<WAny>;
    if items.is_null() || !items.is_array() {
        a = unsafe { warray_new_in(z, 4i64) };
    } else {
        a = items.resolve() as *mut WArray<WAny>;
    }
    let n: i64 = unsafe { warray_len(a as *const WArray<WAny>) };
    if i < n { unsafe { warray_set(a, i, v); } }
    else if i == n { unsafe { warray_push_in(a, z, v); } }
    else { logos.lang.panic::panic("a list field written past its end (a gap)"); }
    return unsafe { WAny::ref_to(a as *const u8) };
}

// A LIST node (2026-10-05): the items are one Writ array in `args`, written
// through the parser's `"list set_arg"` field or the setter below, and read
// through the accessors — there is no slot to run out of.
pub schema SExprArr : code(0x0010_0000_0000_000A) {
    count: i32 = 0,
    args: WAny = 1,
}

impl SExprArr {
    // The arg count (the prepared list arity).
    pub fn len(self: SExprArr) -> i64 { return self.count as i64; }

    // The i-th argument as an SExpr view (0-based). Out-of-range i is a caller
    // error.
    pub fn arg_at(self: SExprArr, i: i64) -> SExpr {
        return list_get(self.args, i).view::<SExpr>();
    }

    // The i-th argument's RAW edge handle (0-based) — for callers that need the
    // WAny edge itself (e.g. the optimizer's changed-child comparison) rather
    // than a bound view. Rebuilt through `raw()` (the step_any provenance-
    // laundering idiom) so no reference to the temporary WRef escapes.
    pub fn arg_any(self: SExprArr, i: i64) -> WAny {
        return unsafe { WAny::ref_to(list_get(self.args, i).raw() as *const u8) };
    }

    // Store the i-th argument edge (0-based). The parser fills slots 0..count-1.
    pub fn set_arg(self: &mut SExprArr, i: i64, h: WAny) {
        let z: *mut u8 = unsafe { (*(self as *const SExprArr as *const WSchemaH)).z };
        self.args = list_set(self.args, z, i, h);
    }

    pub fn set_len(self: &mut SExprArr, n: i64) { self.count = n as i32; }
}

// ── Scalar tier — SExpr (category 0x0010) ─────────────────────────────────
// SELF-DESCRIBING IR (ADR 0012 peg-frontend §5, Option B): leaf nodes carry the
// textual NAME they reference directly (a `str` schema field), not a dense id
// into a parser-side interning table. The IR is therefore self-contained — a
// backend reads `f.name` off the node, needing no `ElParser` and no side tables
// — which is (a) what a peg-generated parser produces natively (a captured IDENT
// → a `str` field), and (b) more faithful to ADR-0011's "the schema IS the typed
// view" + the seam's "backends trust the IR". A separate name→type dictionary
// (built by the handler from schema reflection + the macro param list)
// supplies value-types.
pub schema SLit   : code(0x0010_0000_0000_0000) { val: WAny = 0, soff: i64 = 1, txt: str = 2 }                                  // literal, value verbatim
pub schema SParam : code(0x0010_0000_0000_0001) { name: str = 0, soff: i64 = 1 }                                  // bound parameter (prepared-stmt arg) — by NAME
pub schema SVar   : code(0x0010_0000_0000_0002) { name: str = 0, soff: i64 = 1 }                                  // comprehension-bound row variable — by NAME
pub schema SField : code(0x0010_0000_0000_0003) { base: WRef<SExpr> = 0, name: str = 1, soff: i64 = 2 }           // ONE field / edge step — field NAME
// ⚠ `ordw` — THE CLAIM, WRITTEN ON THE NODE THAT CONSUMES IT.
// "The integer operation this node performs runs in the u64 domain": for an
// ARITHMETIC op (+ − * / %) the overflow predicate and, for `/` and `%`, the
// ANSWER; for an ORDERED compare (< <= > >=) the order the two payloads are
// ranked under. It is the checker's `ct_join_ordw` over the operands' `CTy`,
// stamped by `check_expr`'s Bin arm — one authority, computed once per compile,
// read per row with no join and no side table.
//
// It lives HERE, and not in a per-position table on `QPlan`, because two
// measurements say the claim is a property of the EXPRESSION and not of the
// relational node it sits under: `where s.u > 5 || s.v > 5` is ONE Filter node
// holding two comparisons whose claims differ, and `select (s.id, s.u/3, s.v/3)`
// is ONE Proj node whose cells' claims differ. A table keyed by relational node
// cannot express either; a table keyed by SExpr node has no bound and would
// degrade silently past its capacity. A schema field has neither problem — an
// unwritten TOM key reads the WritField default `false`, which is exactly the
// signed reading every position had before this existed, so a node the checker
// never reached loses nothing it had.
pub schema SBin   : code(0x0010_0000_0000_0004) { op: i32 = 0, lhs: WRef<SExpr> = 1, rhs: WRef<SExpr> = 2, soff: i64 = 3, ordw: bool = 4 }
pub schema SUn    : code(0x0010_0000_0000_0005) { op: i32 = 0, arg: WRef<SExpr> = 1, soff: i64 = 2 }
pub schema SCall  : code(0x0010_0000_0000_0006) { fn_name: str = 0, args: WRef<SExprArr> = 1, soff: i64 = 2 }     // function/filter call — call NAME
pub schema SCond  : code(0x0010_0000_0000_0007) { c: WRef<SExpr> = 0, t: WRef<SExpr> = 1, e: WRef<SExpr> = 2, soff: i64 = 3 }  // ternary
pub schema SComp  : code(0x0010_0000_0000_0008) { plan: WRef<RExpr> = 0, head: WRef<SExpr> = 1, var: str = 2, soff: i64 = 3 }   // comprehension → list value; `var` = loop-var NAME
pub schema STuple : code(0x0010_0000_0000_0009) { items: WRef<SExprArr> = 0, soff: i64 = 1 }                       // tuple projection `(a, b, …)` — ≥2 components
pub schema SCast  : code(0x0010_0000_0000_000B) { arg: WRef<SExpr> = 0, ty: str = 1, soff: i64 = 2 }        // `arg as ty` — Rust's numeric conversion; `ty` = the target type NAME

pub schema enum SExpr : category(0x0010_0000_0000_0000) {
    Lit(SLit), Param(SParam), Var(SVar), Field(SField),
    Bin(SBin), Un(SUn), Call(SCall), Cond(SCond), Comp(SComp),
    Tuple(STuple), Cast(SCast),
}

// Node → erased edge handle. A node's `as_ref` yields the `WAny` self-relative
// ref to its backing TOM — the value stored into a parent's `WRef<SExpr>` field
// (`b.lhs = WRef::<SExpr>::from_any(child.as_ref())`). The synthetic `m` ptr is
// package-private, so these accessors are the public seam for edge wiring.
// The cast through `i64` launders the pointer provenance: the WAny ref targets
// the TOM in the Writ arena (which outlives the view), so it is NOT a dangling
// reference to the local view — mirrors static_view.logos's WAny::Ref pattern.
impl SLit     { pub fn as_ref(self: SLit)     -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }

/// The type a NUMBER literal's suffix names — `5i32` → "i32", `1.0f64` → "f64" —
/// or "" when it has none (or is not a number, or was built by the optimizer,
/// which records no token). `txt` is the token as written (#724).
impl SLit {
    pub fn suffix(self: SLit) -> str {
        let v: WAny = self.val;
        if v.is_string() || v.is_bool() { return ""; }
        let tx: str = self.txt;
        if tx.len() == 0i64 { return ""; }
        // The INTEGER/FLOAT tokens admit exactly these suffixes (el.peg); the
        // longer ones are asked first so `i16` is not read as ending in `6`.
        if str_ends_with(tx, "usize") { return "usize"; }
        if str_ends_with(tx, "isize") { return "isize"; }
        if str_ends_with(tx, "i16") { return "i16"; }
        if str_ends_with(tx, "i32") { return "i32"; }
        if str_ends_with(tx, "i64") { return "i64"; }
        if str_ends_with(tx, "u16") { return "u16"; }
        if str_ends_with(tx, "u32") { return "u32"; }
        if str_ends_with(tx, "u64") { return "u64"; }
        if str_ends_with(tx, "f32") { return "f32"; }
        if str_ends_with(tx, "f64") { return "f64"; }
        if str_ends_with(tx, "i8") { return "i8"; }
        if str_ends_with(tx, "u8") { return "u8"; }
        return "";
    }
}
impl SParam   { pub fn as_ref(self: SParam)   -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl SVar     { pub fn as_ref(self: SVar)     -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl SField   { pub fn as_ref(self: SField)   -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl SBin     { pub fn as_ref(self: SBin)     -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl SUn      { pub fn as_ref(self: SUn)      -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl SCall    { pub fn as_ref(self: SCall)    -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl SCond    { pub fn as_ref(self: SCond)    -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl SComp    { pub fn as_ref(self: SComp)    -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl STuple   { pub fn as_ref(self: STuple)   -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl SCast    { pub fn as_ref(self: SCast)    -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl SExprArr { pub fn as_ref(self: SExprArr) -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }

// ── RAgg — one aggregate SPEC `out = fn(arg)` of an RAggr (ADR 0012 §2/§8) ────
// The relational aggregate spec, enriching the algebra so `RAggr` captures the
// SEMANTICS of each aggregate column — mirroring the surface `RQAgg` so the
// lowering from the query PLAN is field-for-field. `fn_name` is the aggregate
// function NAME (count/sum/min/max/avg — self-describing, Option B; the backend
// maps it to the AGG_* id); `out` is the bound column name the projection reads;
// `arg` is the inner `WRef<SExpr>` expression (absent for `count()`, `has_arg`).
pub schema RAgg : code(0x0011_0000_0000_0010) {
    out:     str          = 0,
    fn_name: str          = 1,
    arg:     WRef<SExpr>  = 2,
    has_arg: bool         = 3,
}

impl RAgg {
    // The inner argument expression as an SExpr view (only valid when has_arg).
    pub fn arg_expr(self: RAgg) -> SExpr { return self.arg.any().view::<SExpr>(); }
    pub fn as_ref(self: RAgg) -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; }
}

// The materialized aggregate-spec list (the SExprArr pattern). `count` = the
// arity. A LIST node (2026-10-05): the items are one Writ array in `aggs`.
pub schema RAggArr : code(0x0011_0000_0000_0011) {
    count: i32 = 0,
    aggs: WAny = 1,
}

impl RAggArr {
    pub fn len(self: &RAggArr) -> i64 { return self.count as i64; }

    pub fn agg_at(self: RAggArr, i: i64) -> RAgg {
        return list_get(self.aggs, i).view::<RAgg>();
    }

    pub fn set_agg(self: &mut RAggArr, i: i64, h: WAny) {
        let z: *mut u8 = unsafe { (*(self as *const RAggArr as *const WSchemaH)).z };
        self.aggs = list_set(self.aggs, z, i, h);
    }

    pub fn set_len(self: &mut RAggArr, n: i64) { self.count = n as i32; }
    pub fn as_ref(self: RAggArr) -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; }
}

// ── Relational / graph tier — RExpr (category 0x0011) ─────────────────────
// `RScan` now carries the SOURCE BINDING (source name + row-type name + loop-var
// name) so the executable algebra is self-sufficient to emit the scan loop — the
// query-PLAN's `from src:[Ty] var` recovered onto the leaf, self-describing IR.
pub schema RScan   : code(0x0011_0000_0000_0000) { node_code: i56 = 0, src_name: str = 1, row_ty: str = 2, var_name: str = 3 } // scan a source: name + row-type + loop var
// REdge — the GRAPH STEP (slice D, collection-field traversal): range a new row
// var over a COLLECTION FIELD PATH of an already-bound row var. Self-describing:
//   `base_var`/`path` — the semantic step (`d` + "emps.skills" — queue-2's
//   interpreter re-resolves these against its own row bindings);
//   `src` — the full source EXPRESSION text (`d.emps.skills`, walker-stamped) —
//   the static emitter's scan spelling (`while i < (src).len()`);
//   `var_name`/`row_ty` — the new binding + its ELEMENT type;
//   `on`/`has_on` — the OPTIONAL residual filter (containment IS the join);
//   `is_anti` — anti-traversal: keep the bound row iff NO element satisfies
//   `on` (no `on` ⇒ iff the collection is empty).
// Traversal is ALWAYS nested-loop (its source depends on outer row vars, so no
// build-once index exists) — the join-strategy cascade bypasses REdge steps.
pub schema REdge   : code(0x0011_0000_0000_0001) { input: WRef<RExpr> = 0, src: str = 1, base_var: str = 2, path: str = 3, var_name: str = 4, row_ty: str = 5, on: WRef<SExpr> = 6, has_on: bool = 7, is_anti: bool = 8 }
pub schema RFilter : code(0x0011_0000_0000_0002) { input: WRef<RExpr> = 0, pred: WRef<SExpr> = 1 }    // σ
pub schema RProj   : code(0x0011_0000_0000_0003) { input: WRef<RExpr> = 0, sel: WRef<SExpr> = 1 }     // π — the projection expr
// RJoin / RAnti carry the PLAN's decision for the step, not just its shape
// (ADR 0024 S4): `jstrat` — hash / tree / loop, `JS_NONE` when no planner has
// looked at this node; `jkey` — the equi-key's value class; `jsel` — WHICH term
// of the const-folded `on` conjunction supplies the key (-1 = none), so the
// emitter composes build/probe/residual without re-running the selection rule;
// `jground` — the ground (rule + facts, why.logos `jg_pack`), travelling with
// the decision; its sentence is rendered at the edge. Lowering copies these off
// the surface step; the relational peephole passes the join subtree through
// unchanged, so they survive to the emitter.
pub schema RJoin   : code(0x0011_0000_0000_0004) { left: WRef<RExpr> = 0, right: WRef<RExpr> = 1, on: WRef<SExpr> = 2, jstrat: i32 = 3, jsel: i32 = 5, jground: i64 = 6 }
pub schema RAnti   : code(0x0011_0000_0000_0005) { left: WRef<RExpr> = 0, right: WRef<RExpr> = 1, on: WRef<SExpr> = 2, jstrat: i32 = 3, jsel: i32 = 5, jground: i64 = 6 }
pub schema RAggr   : code(0x0011_0000_0000_0006) { input: WRef<RExpr> = 0, key: WRef<SExpr> = 1, aggs: WRef<RAggArr> = 2 } // γ — single group key + agg specs
pub schema RFix    : code(0x0011_0000_0000_0007) { base: WRef<RExpr> = 0, rec: WRef<RExpr> = 1 }      // fixpoint — DECLARED, NOT impl in queue 1
// ── ORDER/LIMIT/DISTINCT tier (`select [distinct] S [order by O [desc]] [limit …]`) ──
// RSort sits UNDER the projection (its key ranges over the input rows — the scan
// vars, or the group key + aggregate outputs); RDistinct / RLimit sit ABOVE the
// projection (they act on the PROJECTED values). `having` has NO node of its own:
// it lowers to an RFilter over the RAggr output (one filter mechanism).
pub schema RSort     : code(0x0011_0000_0000_0008) { input: WRef<RExpr> = 0, key: WRef<SExpr> = 1, desc: bool = 2 } // τ — ONE sort key, asc/desc
pub schema RLimit    : code(0x0011_0000_0000_0009) { input: WRef<RExpr> = 0, n: i64 = 1, is_param: bool = 2, param: str = 3 } // first-n (literal or scalar-param name)
pub schema RDistinct : code(0x0011_0000_0000_000A) { input: WRef<RExpr> = 0 }                          // δ — dedup projected values

pub schema enum RExpr : category(0x0011_0000_0000_0000) {
    Scan(RScan), Edge(REdge), Filter(RFilter), Proj(RProj),
    Join(RJoin), Anti(RAnti), Aggr(RAggr), Fix(RFix),
    Sort(RSort), Limit(RLimit), Distinct(RDistinct),
}

// Relational-node edge handles (same provenance-laundering rationale as the
// scalar `as_ref` above): the WAny ref targets the node's TOM in the arena.
impl RScan   { pub fn as_ref(self: RScan)   -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl REdge   { pub fn as_ref(self: REdge)   -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl RFilter { pub fn as_ref(self: RFilter) -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl RProj   { pub fn as_ref(self: RProj)   -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl RJoin   { pub fn as_ref(self: RJoin)   -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl RAnti   { pub fn as_ref(self: RAnti)   -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl RAggr   { pub fn as_ref(self: RAggr)   -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl RFix    { pub fn as_ref(self: RFix)    -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl RSort     { pub fn as_ref(self: RSort)     -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl RLimit    { pub fn as_ref(self: RLimit)    -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }
impl RDistinct { pub fn as_ref(self: RDistinct) -> WAny { return unsafe { WAny::ref_to((self.m as i64) as *const u8) }; } }

// ── Typed edge RESOLVERS (the IR-walking convenience API) ─────────────────
// Read a `WRef<S>` field → resolve the handle → bind the target view. These are
// a convenient, named way for a backend (interpreter / executor / metacall
// codegen) to walk one edge of the schema'd IR.
//
// They are NOT a linkage workaround: a downstream consumer in any compilation
// unit may read a `WRef<S>` field directly — `comp.plan.any().view::<RExpr>()` —
// without these helpers and without ever constructing a `WRef<S>`. The generic
// `WritField::from_wany` instance is materialized by the field-read codegen
// itself (mono enqueues `WRef<S>::from_wany` from the field's concrete type-args
// regardless of local construction; see sema_expr.cpp schema_wany_to_typed and
// tests/logos/pass/wql_wref_field_read.logos). The resolvers stay because the
// named `…_expr()` form is clearer at call sites, not because reads must route
// through this CU.
impl SField { pub fn base_expr(self: SField) -> SExpr { return self.base.any().view::<SExpr>(); } }
impl SUn    { pub fn arg_expr(self: SUn)      -> SExpr { return self.arg.any().view::<SExpr>(); } }
impl SCast  { pub fn arg_expr(self: SCast)    -> SExpr { return self.arg.any().view::<SExpr>(); } }
impl SBin   {
    pub fn lhs_expr(self: SBin) -> SExpr { return self.lhs.any().view::<SExpr>(); }
    pub fn rhs_expr(self: SBin) -> SExpr { return self.rhs.any().view::<SExpr>(); }
}
impl SCond  {
    pub fn cond_expr(self: SCond) -> SExpr { return self.c.any().view::<SExpr>(); }
    pub fn then_expr(self: SCond) -> SExpr { return self.t.any().view::<SExpr>(); }
    pub fn else_expr(self: SCond) -> SExpr { return self.e.any().view::<SExpr>(); }
}
impl SCall  {
    pub fn args_arr(self: SCall) -> SExprArr { return self.args.any().view::<SExprArr>(); }
}
impl SComp  {
    pub fn plan_expr(self: SComp) -> RExpr { return self.plan.any().view::<RExpr>(); }
    pub fn head_expr(self: SComp) -> SExpr { return self.head.any().view::<SExpr>(); }
}
impl STuple {
    pub fn items_arr(self: STuple) -> SExprArr { return self.items.any().view::<SExprArr>(); }
}
impl RFilter {
    pub fn input_expr(self: RFilter) -> RExpr { return self.input.any().view::<RExpr>(); }
    pub fn pred_expr(self: RFilter) -> SExpr { return self.pred.any().view::<SExpr>(); }
}
impl REdge {
    pub fn input_expr(self: REdge) -> RExpr { return self.input.any().view::<RExpr>(); }
    pub fn on_expr(self: REdge) -> SExpr { return self.on.any().view::<SExpr>(); }
}
impl RProj {
    pub fn input_expr(self: RProj) -> RExpr { return self.input.any().view::<RExpr>(); }
    pub fn sel_expr(self: RProj) -> SExpr { return self.sel.any().view::<SExpr>(); }
}
impl RJoin {
    pub fn left_expr(self: RJoin) -> RExpr { return self.left.any().view::<RExpr>(); }
    pub fn right_expr(self: RJoin) -> RExpr { return self.right.any().view::<RExpr>(); }
    pub fn on_expr(self: RJoin) -> SExpr { return self.on.any().view::<SExpr>(); }
}
impl RAnti {
    pub fn left_expr(self: RAnti) -> RExpr { return self.left.any().view::<RExpr>(); }
    pub fn right_expr(self: RAnti) -> RExpr { return self.right.any().view::<RExpr>(); }
    pub fn on_expr(self: RAnti) -> SExpr { return self.on.any().view::<SExpr>(); }
}
impl RAggr {
    pub fn input_expr(self: RAggr) -> RExpr   { return self.input.any().view::<RExpr>(); }
    pub fn key_expr(self: RAggr) -> SExpr   { return self.key.any().view::<SExpr>(); }
    pub fn aggs_arr(self: RAggr) -> RAggArr { return self.aggs.any().view::<RAggArr>(); }
}
impl RSort {
    pub fn input_expr(self: RSort) -> RExpr { return self.input.any().view::<RExpr>(); }
    pub fn key_expr(self: RSort) -> SExpr { return self.key.any().view::<SExpr>(); }
}
impl RLimit    { pub fn input_expr(self: RLimit) -> RExpr { return self.input.any().view::<RExpr>(); } }
impl RDistinct { pub fn input_expr(self: RDistinct) -> RExpr { return self.input.any().view::<RExpr>(); } }
