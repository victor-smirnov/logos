// logos.std.wql.catalog_macro — the `schema_catalog!` queue-1 metacall macro
// (ADR 0012-queue2 §5): queue-1 serving queue-2 over the DESIGNATED metadata
// channel — annotation/macro → metaprog hook → RODATA Writ blob → runtime view.
//
//   resource cat = schema_catalog!{ Emp, Team };
//   …
//   let c: SchemaCatalog = cat();
//
// The handler REFLECTS the named ADR-0011 `schema` declarations out of the
// trigger module's AST (SCHEMA_DEF items: name, `code(0x…)` clause, per-field
// name/type/`= key`) and emits a fn returning a `logos.std.deem::SchemaCatalog`
// built from a `@{…}` STATIC Writ blob in .rodata (content-deduped; zero heap,
// zero global registry — explicit-metacall house style). Blob envelope — the
// GENERIC typed-metadata-entry shape (fn-signature entries ride the same array
// in later slices):
//
//   { "v": 1, "entries": [
//       { "kind": "schema", "name": "Emp", "code": <u64>, "fields": [
//           { "name": "age",  "key": 1, "ty": "i64" },
//           { "name": "cap",  "key": 3, "ty": "i64", "src": "u64" },
//           { "name": "emps", "key": 2, "ty": "edge", "target": "Emp" } ] } ] }
//
// Field TYPE classification (catalog value-type names):
//   integer family (i8…i64/u8…u64/i56/u56/usize/isize) → "i64"
//   f64/f32 → "f64" · bool → "bool" · str/String → "str"
//   WRef<T> → "edge" + target T · anything else (incl. WAny) → "any" (erased)
//
// ⚠ AND THE FIELD'S OWN TYPE NAME BESIDE IT, in "src", when the class
// representative is not it. The classification above is a COLLAPSE — it is what
// the EL computes in — and the facts it discards are real: `u64` and `i64` map to
// one name and their ORDERS differ above 2^63, which is how the runtime tiers
// came to sort a u64 column as a signed one while the static tier, whose emitted
// key vector keeps the declared type, did not. "src" is the carrier; what is
// DERIVED from it lives with the lattice (`ElTy.ord`), not here.
//
// VISIBILITY (I1 MVP): reflection sees the TRIGGER module's AST only — the
// schemas must be declared in the module invoking `schema_catalog!`. Schemas
// declared in OTHER modules take the decl-site annotation route (a derive-style
// hook emitting the same per-schema blob entries) in a later slice.
package logos.std.wql.catalog_macro;

use logos.std.compiler.metaprog;
use logos.std.wql.el;             // el_class_lookup / el_class_repr — THE type table   // Emitter, ItemList, item_list_new, error, OView
use logos.lang.writ.anyval;        // WAny
use logos.std.wql.reflect;         // find_decl_by_name — the module-item walk
use logos.mem.string;
use logos.lang.str;

// AST node codes (la::Code, include/logos/compiler/ast.hpp) — low 16 bits of
// the AST TOM's schema_type_code (high bits are a namespace tag).
fn CM_SCHEMA_DEF()   -> u64 { return 256 as u64; }
fn CM_GENERIC_INST() -> u64 { return 92 as u64; }

// AST TOM keys used here (ast.hpp la::Key).
fn K_CODE_EXPR() -> u8 { return 6 as u8; }   // SCHEMA_DEF: the `code(expr)` clause
fn K_VALUE()     -> u8 { return 7 as u8; }   // clause → expr; LIT_INT → token text; field → key expr
fn K_ITEMS()     -> u8 { return 2 as u8; }   // GENERIC_INST: type-arg array

// SView (borrowed AST bytes) → str (shares the AST arena for the hook's life).
fn sv_str(sv: SView) -> str {
    if sv.ptr == (0 as *const u8) || sv.len == (0 as u64) { return ""; }
    return unsafe { str_from_raw(sv.ptr, sv.len as i64) };
}

// ── Integer-literal TOKEN decoding ─────────────────────────────────────────
// AST literal nodes carry the RAW TOKEN TEXT (LIT_INT.VALUE = "0x0A01_…" /
// "42" / "7u64"); decode decimal/hex with `_` separators, ignoring a trailing
// type suffix. `ok=false` when no digits were found (not an int literal).
struct U64Lit { ok: bool, v: u64 }

fn parse_u64_lit(t: str) -> U64Lit {
    let n: i64 = t.len();
    let mut i: i64 = 0i64;
    let mut hex: bool = false;
    if n >= 2i64 && str_byte_at(t, 0i64) == 48u8 {
        let x: u8 = str_byte_at(t, 1i64);
        if x == 120u8 || x == 88u8 { hex = true; i = 2i64; }
    }
    let mut v: u64 = 0u64;
    let mut any: bool = false;
    while i < n {
        let c: u8 = str_byte_at(t, i);
        if c == 95u8 { i = i + 1i64; continue; }           // '_'
        let mut d: i64 = -1i64;
        if c >= 48u8 && c <= 57u8 { d = (c as i64) - 48i64; }
        else if hex && c >= 97u8 && c <= 102u8 { d = (c as i64) - 87i64; }
        else if hex && c >= 65u8 && c <= 70u8  { d = (c as i64) - 55i64; }
        if d < 0i64 { break; }                              // suffix / junk
        if hex { v = v * 16u64 + (d as u64); } else { v = v * 10u64 + (d as u64); }
        any = true;
        i = i + 1i64;
    }
    return U64Lit { ok: any, v: v };
}

// Decode an AST const-expr node (a LIT_INT) → its u64 value.
fn expr_u64(view: &OView, expr: WAny) -> U64Lit {
    if expr.is_null() { return U64Lit { ok: false, v: 0u64 }; }
    let txt: str = sv_str(view.get_str_view(view.tiny_map_get(expr, K_VALUE())));
    return parse_u64_lit(txt);
}

// ── Field-type classification ───────────────────────────────────────────────
fn is_int_family(name: str) -> bool {
    return el_class_lookup(name) == EL_TY_INT();
}

// The catalog value-type name of a field's TYPE node; edges report "edge" and
// fill `target` (the WRef<T> type-arg name) into `tgt`.
//
// ⚠ `ty` IS THE CLASS REPRESENTATIVE AND `src` IS THE FIELD'S OWN TYPE NAME, and
// they are two entries because they answer two questions. `ty` is what the EL
// COMPUTES IN — every consumer downstream (the FK_SCALAR/FK_ANY decision, the
// CT_* tag, the accumulator layout) is built on it and must keep reading it.
// `src` is what the column IS, and it is the only place the facts that the class
// collapses — width, SIGNEDNESS — still exist. A `u64` column emitted only as
// `"ty":"i64"` destroyed its signedness one step before any runtime tier could
// see it, which is why the two runtime engines ordered it as a signed value
// while the static tier, whose emitted key vector keeps the declared type, did
// not. `src` is emitted only when it DIFFERS from `ty` (a blob written before
// this existed, or by hand, reads back as "" and every derived fact defaults to
// the class's — i.e. to exactly the old behaviour).
struct FieldTy { ty: str, target: str, src: str }

fn classify_field_type(view: &OView, fld: WAny) -> FieldTy {
    let tynode: WAny = view.ast_type_child(fld);
    if tynode.is_null() { return FieldTy { ty: "any", target: "", src: "" }; }
    let code: u64 = view.ast_node_code(tynode) & (0xFFFF as u64);
    if code == CM_GENERIC_INST() {
        if str_eq(sv_str(view.ast_node_name(tynode)), "WRef") {
            let args: WAny = view.tiny_map_get(tynode, K_ITEMS());
            if !args.is_null() && view.array_len(args) == (1 as u64) {
                let a0: WAny = view.array_get(args, 0 as u64);
                let tn: str = sv_str(view.ast_node_name(a0));
                if tn.len() > 0i64 { return FieldTy { ty: "edge", target: tn, src: "" }; }
            }
        }
        return FieldTy { ty: "any", target: "", src: "" };
    }
    let name: str = sv_str(view.ast_node_name(tynode));
    // ONE classification table (logos.std.wql.el), one representative per
    // class. The catalog's own copy of it had drifted — it knew `i56`/`u56`
    // and the canonical one did not.
    let cls: i32 = el_class_lookup(name);
    if cls >= 0i32 { return FieldTy { ty: el_class_repr(cls), target: "", src: name }; }
    return FieldTy { ty: "any", target: "", src: "" };
}

// ── Requested-schema list (idents in the macro body) ───────────────────────
struct NameList { names: [str; 16], n: i64 }

fn scan_names(s: str) -> NameList {
    let mut out: NameList = NameList { names: [""; 16], n: 0i64 };
    let n: i64 = s.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = str_byte_at(s, i);
        let alpha: bool = (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) || c == 95u8;
        if alpha {
            let start: i64 = i;
            while i < n {
                let c2: u8 = str_byte_at(s, i);
                let alnum: bool = (c2 >= 65u8 && c2 <= 90u8) || (c2 >= 97u8 && c2 <= 122u8)
                                || (c2 >= 48u8 && c2 <= 57u8) || c2 == 95u8;
                if !alnum { break; }
                i = i + 1i64;
            }
            if out.n < 16i64 {
                out.names[out.n] = unsafe { str_from_raw((s.as_ptr() as i64 + start) as *const u8, i - start) };
                out.n = out.n + 1i64;
            }
        } else {
            i = i + 1i64;
        }
    }
    return out;
}

// ── Blob emission — one "schema" entry per requested schema ────────────────
// Emits `{ "kind": "schema", "name": "…", "code": N, "fields": […] }` into the
// @-literal body. Returns false when a diagnostic was raised.
//
// ⚠ It writes into a `String`, NOT into an Emitter: what is being composed here
// is the WRIT DOCUMENT, which is reified whole (`parse_wstatic`) and spliced
// into a quoted item — so no part of this file is a source chunk. See the
// handler below for why the document itself cannot be quoted.
fn emit_schema_entry(buf: &mut String, view: &OView, nm: str) -> bool {
    let decl: WAny = find_decl_by_name(view, nm);
    if decl.is_null() {
        let mut m: String = String::new();
        m.push_str("schema_catalog!: unknown schema '");
        m.push_str(nm);
        m.push_str("' — declare it in the module invoking the macro (cross-module schemas take the decl-site annotation route)");
        error(str_of(&m));
        return false;
    }
    if (view.ast_node_code(decl) & (0xFFFF as u64)) != CM_SCHEMA_DEF() {
        let mut m2: String = String::new();
        m2.push_str("schema_catalog!: '");
        m2.push_str(nm);
        m2.push_str("' is not a `schema` declaration");
        error(str_of(&m2));
        return false;
    }
    // schema code: the `code(expr)` clause's VALUE, an integer literal.
    let clause: WAny = view.tiny_map_get(decl, K_CODE_EXPR());
    if clause.is_null() {
        let mut m3: String = String::new();
        m3.push_str("schema_catalog!: schema '");
        m3.push_str(nm);
        m3.push_str("' needs an explicit code(0x…) clause");
        error(str_of(&m3));
        return false;
    }
    let code: U64Lit = expr_u64(view, view.tiny_map_get(clause, K_VALUE()));
    if !code.ok {
        let mut m4: String = String::new();
        m4.push_str("schema_catalog!: schema '");
        m4.push_str(nm);
        m4.push_str("': code(…) must be an integer literal");
        error(str_of(&m4));
        return false;
    }

    buf.push_str("{\"kind\": \"schema\", \"name\": \"");
    buf.push_str(nm);
    buf.push_str("\", \"code\": ");
    buf.push_u64(code.v);
    buf.push_str(", \"fields\": [");
    let nf: u64 = view.ast_struct_field_count(decl);
    let mut i: u64 = 0 as u64;
    while i < nf {
        let fld: WAny = view.ast_struct_field(decl, i);
        let fname: str = sv_str(view.ast_field_name(fld));
        // field key: the `= N` const-expr; absent ⇒ positional index.
        let kexpr: WAny = view.tiny_map_get(fld, K_VALUE());
        let mut key: u64 = i;
        if !kexpr.is_null() {
            let kl: U64Lit = expr_u64(view, kexpr);
            if kl.ok { key = kl.v; }
        }
        let ft: FieldTy = classify_field_type(view, fld);
        if i > (0 as u64) { buf.push_str(", "); }
        buf.push_str("{\"name\": \"");
        buf.push_str(fname);
        buf.push_str("\", \"key\": ");
        buf.push_u64(key);
        buf.push_str(", \"ty\": \"");
        buf.push_str(ft.ty);
        buf.push_str("\"");
        if str_eq(ft.ty, "edge") {
            buf.push_str(", \"target\": \"");
            buf.push_str(ft.target);
            buf.push_str("\"");
        }
        // The field's OWN type name, when the class representative is not it.
        // See `FieldTy`: this is the only surviving carrier of the width and
        // the signedness the class collapses.
        if ft.src.len() > 0i64 && !str_eq(ft.src, ft.ty) {
            buf.push_str(", \"src\": \"");
            buf.push_str(ft.src);
            buf.push_str("\"");
        }
        buf.push_str("}");
        i = i + (1 as u64);
    }
    buf.push_str("]}");
    return true;
}

fn str_of(s: &String) -> str {
    return unsafe { str_from_raw(s.as_ptr(), s.len()) };
}

// ── The resource handler ────────────────────────────────────────────────────
//   resource <name> = schema_catalog!{ S1, S2, … };
// emits:
//   pub fn <name>() -> SchemaCatalog {
//       return SchemaCatalog::from_static(@{ …blob… });
//   }
/// Token-macro handler for `schema_catalog!{ S1, S2, … }` (see `resource` decls
/// like `resource cat = schema_catalog!{ Emp, Dept };` in `logos.std.deem` callers).
/// Reflects the named `schema` decls out of the trigger module's AST and emits a
/// `pub fn <name>() -> SchemaCatalog` returning a `SchemaCatalog::from_static` view
/// over a deduped `@{…}` Writ blob, for use by `Query::compile`/`Tpl::compile`.
/// Raises a diagnostic (via `error`) and returns an empty `ItemList` on a missing
/// binding name, an unknown/non-`schema` name, or a schema missing `code(0x…)`.
#[token_macro]
pub fn schema_catalog(name: str, s: str) -> ItemList {
    let out: ItemList = item_list_new();
    if name.len() == 0i64 {
        error("schema_catalog!: needs a binding name — write `resource <name> = schema_catalog!{ S1, S2 };`");
        return out;
    }
    let req: NameList = scan_names(s);
    if req.n == 0i64 {
        error("schema_catalog!: needs at least one schema name — `resource cat = schema_catalog!{ Emp };`");
        return out;
    }

    let view: OView = oview_module_ast();

    // ── the DOCUMENT, then the ITEM AROUND IT (ADR 0024 S5) ────────────────
    // The blob's SHAPE is a runtime value — N entries, each with M fields, and
    // an extra `"target"` on the edge ones — so it cannot ride a static `@{…}`
    // quote template. `emit_cfg_doc_multimap` (Canon's container_item) hit the
    // same wall first and set the shape this follows: compose the document
    // SOURCE, reify it ONCE with `parse_wstatic`, and splice the LIT_WSTATIC
    // into a quoted item.
    //
    // ⚠ WHY NOT A REPEAT INSIDE THE `@{…}`, since that is the obvious idea and
    // it does not work — both halves were probed, not assumed:
    //   * `@{"entries": [ #( #ns ),* ]}` in a quote → `syntax error near '['`.
    //   * even a scalar `@{"entries": #nm}` → `syntax error near ':'`.
    // A quoted `@{…}` admits exactly ONE antiquote position, the `<type:#(t)>`
    // TYPE slot container_item's fixed-shape cfg consts use; a VALUE inside the
    // document has no antiquote at all. So the document is data that travels as
    // its own source, the way mapping_item's string literal does — and the item
    // around it (name, return type, body, the `from_static` call) is structure.
    //
    // ⚠ A `use` inside the quote is NOT the chunk's old self-contained use-list
    // reappearing: `SchemaCatalog` and `WritStatic` are named by the emitted
    // body, and a quote's own imports are how a quote says that.
    let mut doc: String = String::new();
    doc.push_str("@{\"v\": 1, \"entries\": [");
    let mut i: i64 = 0i64;
    while i < req.n {
        if i > 0i64 { doc.push_str(", "); }
        if !emit_schema_entry(&mut doc, &view, req.names[i]) { return out; }
        i = i + 1i64;
    }
    doc.push_str("]}");

    let blob: ExprBlob = parse_wstatic(doc.as_str());
    if blob.ptr == (0 as *const u8) {
        // A null blob would otherwise splice as NOTHING and the item would
        // simply not appear — the silent-empty anti-diagnostic. Composed from
        // reflected identifiers, so this means a seam regression, not user error.
        error("schema_catalog!: the reflected catalog document did not parse (reflection seam regression?)");
        return out;
    }
    let nm: Ident = Ident::new(name);
    let q: QuoteItemBlob = quote_item! {
        use logos.mem.deem;
        use logos.lang.writ.wstatic;
        pub fn #nm() -> SchemaCatalog { return SchemaCatalog::from_static(#(blob)); }
    };
    unsafe { logos_emit_item_blob_subst(&q); }
    return out;
}
