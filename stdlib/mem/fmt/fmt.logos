// Logos standard library — std.mem.fmt
//
// Rust-shape formatting infrastructure: `Formatter`, `Write`,
// `Arguments`, `fmt::Error`. Mirrors `core::fmt`.
//
// Status: type surface declared, primitive operations on `Formatter`
// (write_str/write_char/pad) wired against a `&mut String` backing
// buffer. The full migration of stdlib `Display`/`Debug` impls (today
// in `std.fmt`, shaped as `fn fmt(self, &mut String)`) over to the
// Rust shape `fn fmt(&self, f: &mut Formatter) -> Result<(), Error>`
// is deferred — it touches every primitive and stdlib impl plus the
// `format!`/`println!` metacalls. New code that wants the Rust shape
// can use this module directly; new traits matching Rust names go in
// `std.fmt` to avoid splitting the Display/Debug namespace.

package logos.mem.fmt;

use logos.lang.result;
use logos.lang.option;
use logos.lang.cmp;
use logos.lang.str;
use logos.mem.string;
use logos.mem.collections.vec;

// f32/f64 extern decls — same symbols mem.string uses for legacy
// Display. The forward decls live up here so they precede the impl
// bodies that call them. (mem.string's identical decls don't
// re-export across pkg, so we re-declare locally; the linker
// dedupes since both bind the same C symbol.)
extern fn logos_fmt_f64_g(buf: *mut u8, cap: i32, x: f64) -> i32;
extern fn logos_fmt_f32_g(buf: *mut u8, cap: i32, x: f32) -> i32;

// ── fmt::Error / fmt::Result ─────────────────────────────────────────
//
// `fmt::Error` is the unit error returned by every formatter operation
// in Rust. In Logos it is similarly an empty struct — instances are
// only ever constructed to signal failure; the variant carries no
// payload. Most uses pattern-match it as the `Err` arm of
// `Result<(), Error>` (Rust's `fmt::Result`).

pub struct Error {}

pub fn ok() -> Result<(), Error> {
    return Result::<(), Error>::Ok(());
}

pub fn err() -> Result<(), Error> {
    return Result::<(), Error>::Err(Error {});
}

// ── Write trait ──────────────────────────────────────────────────────
//
// Mirrors `core::fmt::Write`: the abstract sink any formatter writes
// into. Implementors are typically buffers (String) or streams.
// `write_char` defaults to a single-byte `write_str` for ASCII; full
// UTF-8 char encoding lives at the call site for now (Logos `char`
// is byte-shaped pending Phase 1B-13 utf8 char ports).

// Named `FmtWrite` (not `Write`) because Logos's trait registry is
// flat across packages — `std.io.write::Write` already owns that
// name. Rust gets away with `core::fmt::Write` distinct from
// `std::io::Write` because the conflict resolves at import; the
// underlying B-mv-02 bug here forces the rename until the trait
// registry becomes package-aware.
pub trait FmtWrite {
    fn write_str(&mut self, s: str) -> Result<(), Error>;
    fn write_char(&mut self, c: u8) -> Result<(), Error>;
}

// ── Formatter ────────────────────────────────────────────────────────
//
// Mirrors `core::fmt::Formatter`. Holds a backing `*mut String` buffer
// plus the spec parameters Rust threads through the formatter (width,
// fill, alignment, precision, sign/alt/zero flags). Today's primitive
// implementations just call `Formatter::write_str` / `Formatter::pad`;
// the spec fields are populated by the eventual `format!`/`println!`
// metacall rewrite but ignored by the legacy `fmt_pad` path until the
// stdlib Display/Debug migration lands.
//
// Divergence from Rust: `Formatter` carries a raw `*mut String` rather
// than a `&mut dyn Write` because Logos doesn't yet have stable dyn-
// trait-objects-with-method-dispatch through the formatter machinery.
// Migrating to `&mut dyn Write` is straightforward once the dyn path
// is exercised.

pub struct Formatter {
    pub buf:        *mut String,
    pub fill:       u8,
    pub align_code: u8,    // 0=Unknown→Right, 1=Left, 2=Right, 3=Center
    pub sign_plus:  bool,
    pub alternate:  bool,
    pub zero_pad:   bool,
    pub width:      i64,   // -1 = unspecified
    pub precision:  i64,   // -1 = unspecified
}

pub fn formatter_for(buf: &mut String) -> Formatter {
    unsafe {
        return Formatter {
            buf:        buf as *mut String,
            fill:       32u8,   // ' '
            align_code: 0u8,
            sign_plus:  false,
            alternate:  false,
            zero_pad:   false,
            width:      -1i64,
            precision:  -1i64,
        };
    }
}

impl Formatter {
    pub fn write_str(&mut self, s: str) -> Result<(), Error> {
        unsafe { (*self.buf).push_str(s); }
        return ok();
    }
    pub fn write_char(&mut self, c: u8) -> Result<(), Error> {
        unsafe { (*self.buf).push_u8(c); }
        return ok();
    }

    // pad() — apply the Formatter's spec fields (width / fill / align /
    // precision / sign_plus / alternate / zero_pad) to `content`,
    // optionally prefixed by `prefix` (e.g. "0x" / "0o" / "0b" under
    // `alternate`). Mirrors Rust's `Formatter::pad` and replaces the
    // standalone `std.fmt::fmt_pad` driver. The migrated Display/Debug
    // impls funnel every value here so spec parsing only happens once
    // per `{...}` placeholder.
    //
    // Layout: zero-pad shape (fill='0' and align defaults to Right)
    // emits  sign / prefix / zero-fill / content;  otherwise
    //        fill-left / sign / prefix / content / fill-right.
    // Matches Rust's `{:05x}` → "000ff" / `{:#05x}` → "0x0ff".
    pub fn pad(&mut self, content: str, prefix: str) -> Result<(), Error> {
        unsafe {
            let n_full: i64 = content.len();
            let n_eff: i64 =
                if self.precision >= 0i64 && n_full > self.precision { self.precision }
                else { n_full };

            let mut emit_sign: bool = false;
            if self.sign_plus && n_eff > 0i64 {
                let c0: u8 = content[0i64];
                if c0 != 45u8 && c0 != 43u8 {  // not '-' or '+'
                    emit_sign = true;
                }
            }
            let body: i64 =
                (if emit_sign { 1i64 } else { 0i64 }) + prefix.len() + n_eff;
            let mut left_pad:  i64 = 0i64;
            let mut right_pad: i64 = 0i64;
            if self.width > body {
                let pad_n: i64 = self.width - body;
                if self.align_code == 1u8 {
                    right_pad = pad_n;
                } else if self.align_code == 3u8 {
                    left_pad  = pad_n / 2i64;
                    right_pad = pad_n - left_pad;
                } else {
                    left_pad = pad_n;
                }
            }

            let is_zero_pad: bool = (self.fill == 48u8) && (self.align_code != 1u8);
            let mut i: i64 = 0i64;
            if !is_zero_pad {
                while i < left_pad { (*self.buf).push_u8(self.fill); i = i + 1i64; }
            }
            if emit_sign { (*self.buf).push_u8(43u8); }
            (*self.buf).push_str(prefix);
            if is_zero_pad {
                i = 0i64;
                while i < left_pad { (*self.buf).push_u8(48u8); i = i + 1i64; }
            }
            i = 0i64;
            while i < n_eff { (*self.buf).push_u8(content[i]); i = i + 1i64; }
            if !is_zero_pad {
                i = 0i64;
                while i < right_pad { (*self.buf).push_u8(self.fill); i = i + 1i64; }
            } else {
                i = 0i64;
                while i < right_pad { (*self.buf).push_u8(48u8); i = i + 1i64; }
            }
        }
        return ok();
    }

    // Writes a signed-decimal integer through `pad()`. Renders to a
    // scratch String first so width/align/precision apply uniformly
    // (a sign-prefixed body counts toward the body width for centring).
    pub fn write_int_dec_i64(&mut self, n: i64) -> Result<(), Error> {
        let mut scratch: String = String::new();
        scratch.push_i64(n);
        return self.pad(scratch.as_str(), "");
    }
    pub fn write_int_dec_u64(&mut self, n: u64) -> Result<(), Error> {
        let mut scratch: String = String::new();
        scratch.push_u64(n);
        return self.pad(scratch.as_str(), "");
    }
    pub fn write_bool(&mut self, b: bool) -> Result<(), Error> {
        if b { return self.pad("true",  ""); }
        return self.pad("false", "");
    }
    // Signless radix render (base 2/8/16). Caller responsible for
    // sign-extension or u32-cast-via-mask for signed types — same
    // contract as Rust's `LowerHex`/`UpperHex`/`Octal`/`Binary` on
    // signed types (`format!("{:x}", -1i32)` → "ffffffff").
    pub fn write_int_radix_u64(&mut self, n: u64, radix: u64, upper: bool) -> Result<(), Error> {
        let mut scratch: String = String::new();
        if n == 0u64 {
            scratch.push_u8(48u8);
        } else {
            let mut tmp: [u8; 64] = [0u8; 64];
            let mut pos: i64 = 0i64;
            let mut m: u64 = n;
            while m > 0u64 {
                let d: u64 = m % radix;
                let c: u8 =
                    if d < 10u64 {
                        (d as u8) + 48u8
                    } else if upper {
                        (d as u8) - 10u8 + 65u8
                    } else {
                        (d as u8) - 10u8 + 97u8
                    };
                tmp[pos] = c;
                pos = pos + 1i64;
                m = m / radix;
            }
            let mut i: i64 = pos - 1i64;
            while i >= 0i64 { scratch.push_u8(tmp[i]); i = i - 1i64; }
        }
        // Pick the alt-form prefix when `#` (alternate) is set.
        let prefix: str =
            if self.alternate {
                if radix == 16u64 { if upper { "0x" } else { "0x" } }
                else if radix == 8u64  { "0o" }
                else if radix == 2u64  { "0b" }
                else                    { "" }
            } else { "" };
        return self.pad(scratch.as_str(), prefix);
    }
}

// ── Display / Debug — Rust-shape format traits ────────────────────────
//
// Sits ALONGSIDE the legacy `mem.string::Display` and `std.fmt::Debug`
// (which both take `&mut String` directly). Migration plan:
//
//   Session 1 (this commit): infrastructure — Formatter helpers above,
//     traits below, FmtDisplay impl for i32 as proof-of-shape.
//   Session 2: migrate every primitive (i8…i64, u8…u64, f32/f64, bool,
//     str, *const u8, tuples) to FmtDisplay/FmtDebug — bridge legacy
//     traits to delegate.
//   Session 3: migrate stdlib struct impls (Option, Result, Vec) and
//     the LowerHex/UpperHex/Octal/Binary/LowerExp/UpperExp families.
//   Session 4: rewrite `format!`/`println!`/`print!`/`eprintln!`/
//     `eprint!`/`panic!`/`assert*!` metacalls to spec-parse into a
//     Formatter then dispatch through FmtDisplay; drop fmt_pad +
//     fmt_display/fmt_debug helpers; rename FmtDisplay→Display once
//     legacy gone (and the cross-pkg trait-registry collision lifts).
//
// Traits named `FmtDisplay`/`FmtDebug` rather than `Display`/`Debug`
// for the same reason FmtWrite is — Logos's flat trait registry would
// clobber the legacy names cross-package (B-mv-02). The rename happens
// in Session 4 alongside the legacy delete.

// Method names `fmt_display` / `fmt_debug` (rather than the canonical
// Rust `fmt`) — Logos's method-mangling doesn't include the trait name
// so an `impl FmtDisplay for i32 { fn fmt(...) }` would clash with the
// legacy `impl Display for i32 { fn fmt(...) }` already in
// `mem.string`. After Session 4's legacy delete the trait registry is
// clean and the methods rename back to plain `fmt`.

pub trait FmtDisplay {
    fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error>;
}

pub trait FmtDebug {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error>;
}

// Render any FmtDisplay value to an owned String using a default-spec
// Formatter (no width/precision/sign). Equivalent to Rust's
// `format!("{}", v)` once the metacall migration lands.
pub fn fmt_display_to_string<T: FmtDisplay>(val: &T) -> String {
    let mut buf: String = String::new();
    let mut f: Formatter = formatter_for(&mut buf);
    let _ = val.fmt_display(&mut f);
    return buf;
}

pub fn fmt_debug_to_string<T: FmtDebug>(val: &T) -> String {
    let mut buf: String = String::new();
    let mut f: Formatter = formatter_for(&mut buf);
    let _ = val.fmt_debug(&mut f);
    return buf;
}

// ── Primitive impls ─────────────────────────────────────────────────
//
// Display and Debug for every integer/float/bool/str primitive +
// `*const u8` (C string) + unit `()`. For integer/float/bool/unit/str
// primitives Rust uses identical Display and Debug rendering (modulo
// `Debug for str` which quotes), so the impls below pair Display +
// Debug per type. Tuples ship below.
//
// All routes through Formatter helpers so the spec fields (width /
// fill / align / precision / sign / alt / zero) take effect uniformly.

// ── Signed integers ─────────────────────────────────────────────────
impl FmtDisplay for i8    { fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }
impl FmtDebug   for i8    { fn fmt_debug  (&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }
impl FmtDisplay for i16   { fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }
impl FmtDebug   for i16   { fn fmt_debug  (&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }
impl FmtDisplay for i32 {
    fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> {
        return f.write_int_dec_i64(*self as i64);
    }
}
impl FmtDebug for i32 {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error> {
        return f.write_int_dec_i64(*self as i64);
    }
}
impl FmtDisplay for i64   { fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self);        } }
impl FmtDebug   for i64   { fn fmt_debug  (&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self);        } }
impl FmtDisplay for isize { fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }
impl FmtDebug   for isize { fn fmt_debug  (&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }

// ── Unsigned integers ───────────────────────────────────────────────
impl FmtDisplay for u8    { fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl FmtDebug   for u8    { fn fmt_debug  (&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl FmtDisplay for u16   { fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl FmtDebug   for u16   { fn fmt_debug  (&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl FmtDisplay for u32   { fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl FmtDebug   for u32   { fn fmt_debug  (&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl FmtDisplay for u64   { fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self);        } }
impl FmtDebug   for u64   { fn fmt_debug  (&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self);        } }
impl FmtDisplay for usize { fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl FmtDebug   for usize { fn fmt_debug  (&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }

// ── bool ────────────────────────────────────────────────────────────
impl FmtDisplay for bool { fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_bool(*self); } }
impl FmtDebug   for bool { fn fmt_debug  (&self, f: &mut Formatter) -> Result<(), Error> { return f.write_bool(*self); } }

// ── str ─────────────────────────────────────────────────────────────
// Display = raw bytes through pad (width/precision apply).
// Debug   = '"' content '"' — minimal escape (no backslash-escaping
//   of control chars yet; matches `format!("{:?}", "x")` for the
//   non-control-char common case). Full Rust-style escape ladder
//   ('\\n'/'\\t'/'\\u{…}') is a follow-up alongside the Utf8/escape
//   work later in the roadmap.
impl FmtDisplay for str {
    fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> {
        return f.pad(*self, "");
    }
}
impl FmtDebug for str {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error> {
        let _ = f.write_char(34u8);  // '"'
        let _ = f.write_str(*self);
        return f.write_char(34u8);
    }
}

// ── *const u8 — Display of C strings ────────────────────────────────
// Mirrors the legacy `Display for *const u8` in mem.string: walks
// null-terminated bytes and writes them as one str chunk. Used by
// FFI surfaces returning `char *`. No Debug — Rust doesn't define
// it on raw pointers either; cast to *const () or use ptr::eq.
impl FmtDisplay for *const u8 {
    fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> {
        let p: *const u8 = *self;
        let n: i64 = str_len(p);
        let s: str = str_from_raw(p, n);
        return f.pad(s, "");
    }
}

// ── f32 / f64 ───────────────────────────────────────────────────────
// Same extern bridge the legacy Display impls use: `snprintf("%g", x)`
// gives the shortest round-trippable representation. Render into a
// scratch String, then route through pad.
impl FmtDisplay for f64 {
    fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_g(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl FmtDebug for f64 {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_g(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl FmtDisplay for f32 {
    fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_g(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl FmtDebug for f32 {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_g(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}

// ── unit `()` — deferred ─────────────────────────────────────────────
// `impl FmtDisplay for () { ... }` fails to parse — Logos doesn't yet
// accept `()` in impl-target position. Tuples-of-arity-1+ work below
// (per-arity hand-rolled until variadic-tuple-impl lands). Display
// for unit is rarely needed at user level since `()` has one
// inhabitant; metacall lowering for `format!("{}", ())` can be
// special-cased at Session 4. Filed as a follow-up.

// ── Tuples ──────────────────────────────────────────────────────────
// Tuples have Debug (not Display) in Rust. Per-arity hand-rolled
// impls until variadic-tuple-impl baghunt lands
// ([[baghunt-variadic-tuple-impl]]).

impl<A: FmtDebug> FmtDebug for (A,) {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error> {
        let _ = f.write_str("(");
        let _ = self.0.fmt_debug(f);
        return f.write_str(",)");
    }
}
impl<A: FmtDebug, B: FmtDebug> FmtDebug for (A, B) {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error> {
        let _ = f.write_str("(");
        let _ = self.0.fmt_debug(f);
        let _ = f.write_str(", ");
        let _ = self.1.fmt_debug(f);
        return f.write_str(")");
    }
}
impl<A: FmtDebug, B: FmtDebug, C: FmtDebug> FmtDebug for (A, B, C) {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error> {
        let _ = f.write_str("(");
        let _ = self.0.fmt_debug(f);
        let _ = f.write_str(", ");
        let _ = self.1.fmt_debug(f);
        let _ = f.write_str(", ");
        let _ = self.2.fmt_debug(f);
        return f.write_str(")");
    }
}
impl<A: FmtDebug, B: FmtDebug, C: FmtDebug, D: FmtDebug> FmtDebug for (A, B, C, D) {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error> {
        let _ = f.write_str("(");
        let _ = self.0.fmt_debug(f);
        let _ = f.write_str(", ");
        let _ = self.1.fmt_debug(f);
        let _ = f.write_str(", ");
        let _ = self.2.fmt_debug(f);
        let _ = f.write_str(", ");
        let _ = self.3.fmt_debug(f);
        return f.write_str(")");
    }
}

// ── stdlib struct impls (Session 3) ─────────────────────────────────
//
// Live in mem.fmt rather than each owning module so we can hold a
// FmtDisplay/FmtDebug supertrait bound on the payload type. The
// legacy `Debug for Option<T>` etc. similarly live in `std.fmt` for
// the same reason — Rust hand-rolls these in `core::fmt`.

// Option<T> + Result<T,E> FmtDebug — DEFERRED. Adding either
// triggers a generic-blanket cascade: lforge fails with
// `Vec$G1$ExternalLib__fmt_debug does not reference a valid
// function`. Root cause: when sema/mono checks the bound
// `T: FmtDebug` for some Vec<ExternalLib>, the trait engine
// looks up `satisfies("FmtDebug", "Vec")` (stripping type args)
// and returns TRUE because `impl<T: FmtDebug> FmtDebug for Vec<T>`
// is registered as a blanket — without recursing into the inner
// `T: FmtDebug` requirement against the concrete arg
// ExternalLib. So `Option<Vec<ExternalLib>>::fmt_debug` body
// emits and calls `Vec<ExternalLib>::fmt_debug` — which mono
// correctly DIDN'T emit (its own bound check on T=ExternalLib
// failed). Dangling-reference cascade.
//
// Vec<T> impl alone is safe: no caller asks "does Vec<X>: FmtDebug"
// through the leaky path.
//
// Real fix: trait_engine needs to track per-bound type-param
// mapping so blanket lookup can recurse. Filed as
// [[baghunt-mono-blanket-bound-recursion]].

impl<T: FmtDebug> FmtDebug for Vec<T> {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error> {
        let _ = f.write_str("[");
        let n: i64 = self.length();
        let mut i: i64 = 0i64;
        while i < n {
            if i > 0i64 { let _ = f.write_str(", "); }
            let v: T = self.get(i);
            let _ = v.fmt_debug(f);
            i = i + 1i64;
        }
        return f.write_str("]");
    }
}

// String — Display is content pass-through (with width/precision via
// pad), Debug is quoted (minimal — full Rust escape ladder is a
// follow-up alongside the str Debug story).

// Ordering — Display "Less"/"Equal"/"Greater", Debug same.

// ── Numeric format traits (Session 3) ───────────────────────────────
//
// Mirror of `core::fmt::{LowerHex, UpperHex, Octal, Binary, LowerExp,
// UpperExp}`. Same Rust-shape method as Display/Debug: take `&self`
// and a `&mut Formatter`, route through Formatter helpers.
//
// Trait names `FmtLowerHex` etc. — `LowerHex`/`Octal`/etc. already
// exist as legacy traits in std.fmt. Same B-mv-02 reason as
// FmtDisplay/FmtDebug. Renamed to plain `LowerHex` etc. in Session 4
// alongside the legacy delete.

pub trait FmtLowerHex {
    fn _fmt_lower_hex(&self, f: &mut Formatter) -> Result<(), Error>;
}
pub trait FmtUpperHex {
    fn _fmt_upper_hex(&self, f: &mut Formatter) -> Result<(), Error>;
}
pub trait FmtOctal {
    fn _fmt_octal(&self, f: &mut Formatter) -> Result<(), Error>;
}
pub trait FmtBinary {
    fn _fmt_binary(&self, f: &mut Formatter) -> Result<(), Error>;
}
pub trait FmtLowerExp {
    fn _fmt_lower_exp(&self, f: &mut Formatter) -> Result<(), Error>;
}
pub trait FmtUpperExp {
    fn _fmt_upper_exp(&self, f: &mut Formatter) -> Result<(), Error>;
}

// Per-primitive radix impls. Signed types u32-mask first so the
// rendered width matches Rust's `format!("{:x}", -1i32)` → "ffffffff"
// (rather than full-width "ffffffffffffffff"). u64/i64 pass through.

impl FmtLowerHex for u64   { fn _fmt_lower_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self,        16u64, false); } }
impl FmtLowerHex for u32   { fn _fmt_lower_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }
impl FmtLowerHex for u16   { fn _fmt_lower_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }
impl FmtLowerHex for u8    { fn _fmt_lower_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }
impl FmtLowerHex for usize { fn _fmt_lower_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }
impl FmtLowerHex for i64   { fn _fmt_lower_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }
impl FmtLowerHex for i32   { fn _fmt_lower_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u32 as u64, 16u64, false); } }
impl FmtLowerHex for i16   { fn _fmt_lower_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u16 as u64, 16u64, false); } }
impl FmtLowerHex for i8    { fn _fmt_lower_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u8  as u64, 16u64, false); } }
impl FmtLowerHex for isize { fn _fmt_lower_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }

impl FmtUpperHex for u64   { fn _fmt_upper_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self,        16u64, true); } }
impl FmtUpperHex for u32   { fn _fmt_upper_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }
impl FmtUpperHex for u16   { fn _fmt_upper_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }
impl FmtUpperHex for u8    { fn _fmt_upper_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }
impl FmtUpperHex for usize { fn _fmt_upper_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }
impl FmtUpperHex for i64   { fn _fmt_upper_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }
impl FmtUpperHex for i32   { fn _fmt_upper_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u32 as u64, 16u64, true); } }
impl FmtUpperHex for i16   { fn _fmt_upper_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u16 as u64, 16u64, true); } }
impl FmtUpperHex for i8    { fn _fmt_upper_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u8  as u64, 16u64, true); } }
impl FmtUpperHex for isize { fn _fmt_upper_hex(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }

impl FmtOctal for u64   { fn _fmt_octal(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self,        8u64, false); } }
impl FmtOctal for u32   { fn _fmt_octal(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 8u64, false); } }
impl FmtOctal for u16   { fn _fmt_octal(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 8u64, false); } }
impl FmtOctal for u8    { fn _fmt_octal(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 8u64, false); } }
impl FmtOctal for usize { fn _fmt_octal(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 8u64, false); } }
impl FmtOctal for i64   { fn _fmt_octal(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 8u64, false); } }
impl FmtOctal for i32   { fn _fmt_octal(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u32 as u64, 8u64, false); } }
impl FmtOctal for i16   { fn _fmt_octal(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u16 as u64, 8u64, false); } }
impl FmtOctal for i8    { fn _fmt_octal(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u8  as u64, 8u64, false); } }
impl FmtOctal for isize { fn _fmt_octal(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 8u64, false); } }

impl FmtBinary for u64   { fn _fmt_binary(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self,        2u64, false); } }
impl FmtBinary for u32   { fn _fmt_binary(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 2u64, false); } }
impl FmtBinary for u16   { fn _fmt_binary(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 2u64, false); } }
impl FmtBinary for u8    { fn _fmt_binary(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 2u64, false); } }
impl FmtBinary for usize { fn _fmt_binary(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 2u64, false); } }
impl FmtBinary for i64   { fn _fmt_binary(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 2u64, false); } }
impl FmtBinary for i32   { fn _fmt_binary(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u32 as u64, 2u64, false); } }
impl FmtBinary for i16   { fn _fmt_binary(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u16 as u64, 2u64, false); } }
impl FmtBinary for i8    { fn _fmt_binary(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u8  as u64, 2u64, false); } }
impl FmtBinary for isize { fn _fmt_binary(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 2u64, false); } }

// Float scientific — extern bridge to libc snprintf "%e"/"%E".
// Symbols pre-declared up top alongside the "%g" pair.
extern fn logos_fmt_f64_e(buf: *mut u8, cap: i32, x: f64) -> i32;
extern fn logos_fmt_f64_E(buf: *mut u8, cap: i32, x: f64) -> i32;
extern fn logos_fmt_f32_e(buf: *mut u8, cap: i32, x: f32) -> i32;
extern fn logos_fmt_f32_E(buf: *mut u8, cap: i32, x: f32) -> i32;

impl FmtLowerExp for f64 {
    fn _fmt_lower_exp(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_e(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl FmtUpperExp for f64 {
    fn _fmt_upper_exp(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_E(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl FmtLowerExp for f32 {
    fn _fmt_lower_exp(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_e(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl FmtUpperExp for f32 {
    fn _fmt_upper_exp(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_E(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}

// ── Arguments ────────────────────────────────────────────────────────
//
// Mirrors `core::fmt::Arguments` — the opaque carrier produced by
// `format_args!` and consumed by `write!`/`writeln!`/`println!`. In
// Rust it bundles the format string and a slice of argument pointers
// along with their formatter functions. Logos's `format!`/`println!`
// metacalls today expand the spec inline at the call site, so
// `Arguments` is currently a placeholder type — the field carries the
// already-formatted result string. Once the metacall is rewritten to
// produce a deferred `Arguments` instead of an immediate `String`,
// this struct will hold the spec + arg pointers and grow a
// `format()` method that writes through a `Formatter`.

pub struct Arguments {
    pub rendered: String,
}


impl FmtDisplay for String {
    fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> {
        return f.pad(self.as_str(), "");
    }
}
impl FmtDebug for String {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error> {
        let _ = f.write_char(34u8);
        let _ = f.write_str(self.as_str());
        return f.write_char(34u8);
    }
}

impl FmtDisplay for Ordering {
    fn fmt_display(&self, f: &mut Formatter) -> Result<(), Error> {
        let me: Ordering = *self;
        match me {
            Ordering::Less    => { return f.write_str("Less"); }
            Ordering::Equal   => { return f.write_str("Equal"); }
            Ordering::Greater => { return f.write_str("Greater"); }
        }
    }
}
impl FmtDebug for Ordering {
    fn fmt_debug(&self, f: &mut Formatter) -> Result<(), Error> {
        let me: Ordering = *self;
        match me {
            Ordering::Less    => { return f.write_str("Less"); }
            Ordering::Equal   => { return f.write_str("Equal"); }
            Ordering::Greater => { return f.write_str("Greater"); }
        }
    }
}
