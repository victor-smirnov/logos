// Logos standard library — std.mem.fmt
//
// Rust-shape formatting infrastructure: `Formatter`, `Write`,
// `Arguments`, `fmt::Error`. Mirrors `core::fmt`.
//
// Status: type surface declared, primitive operations on `Formatter`
// (write_str/write_char/pad) wired against a `&mut String` backing
// buffer. The full migration of stdlib `Display`/`Debug` impls (today
// in `logos.std.fmt`, shaped as `fn fmt(self, &mut String)`) over to the
// Rust shape `fn fmt(&self, f: &mut Formatter) -> Result<(), Error>`
// is deferred — it touches every primitive and stdlib impl plus the
// `format!`/`println!` metacalls. New code that wants the Rust shape
// can use this module directly; new traits matching Rust names go in
// `logos.std.fmt` to avoid splitting the Display/Debug namespace.

package logos.mem.fmt;

use logos.lang.result;
use logos.lang.option;
use logos.lang.cmp;
use logos.lang.str;
use logos.mem.string;
use logos.mem.collections.vec;

// f32/f64 extern decls — same symbols mem.string uses for legacy
// Display. The forward decls live up here so they precede the impl
// bodies that call them. (mem.string's identical decls don't
// re-export across pkg, so we re-declare locally; the linker
// dedupes since both bind the same C symbol.)
extern fn logos_fmt_f64_g(buf: *mut u8, cap: i32, x: f64) -> i32;
extern fn logos_fmt_f32_g(buf: *mut u8, cap: i32, x: f32) -> i32;

// ── fmt::Error / fmt::Result ─────────────────────────────────────────
//
// `fmt::Error` is the unit error returned by every formatter operation
// in Rust. In Logos it is similarly an empty struct — instances are
// only ever constructed to signal failure; the variant carries no
// payload. Most uses pattern-match it as the `Err` arm of
// `Result<(), Error>` (Rust's `fmt::Result`).

/// Unit error returned by failed formatter operations; carries no payload.
pub struct Error {}

/// Returns `Ok(())`, the success value of a formatter operation.
pub fn ok() -> Result<(), Error> {
    return Result::<(), Error>::Ok(());
}

/// Returns `Err(Error {})`, signalling formatter failure.
pub fn err() -> Result<(), Error> {
    return Result::<(), Error>::Err(Error {});
}

// ── Write trait ──────────────────────────────────────────────────────
//
// Mirrors `core::fmt::Write`: the abstract sink any formatter writes
// into. Implementors are typically buffers (String) or streams.
// `write_char` defaults to a single-byte `write_str` for ASCII; full
// UTF-8 char encoding lives at the call site for now (Logos `char`
// is byte-shaped pending Phase 1B-13 utf8 char ports).

// Named `FmtWrite` (not `Write`) because Logos's trait registry is
// flat across packages — `logos.std.io.write::Write` already owns that
// name. Rust gets away with `core::fmt::Write` distinct from
// `std::io::Write` because the conflict resolves at import; the
// underlying B-mv-02 bug here forces the rename until the trait
// registry becomes package-aware.
/// Byte/string sink that formatters write into; mirror of `core::fmt::Write`.
pub trait FmtWrite {
    /// Writes a string slice to the sink.
    fn write_str(&mut self, s: str) -> Result<(), Error>;
    /// Writes a single byte to the sink.
    fn write_char(&mut self, c: u8) -> Result<(), Error>;
    // Build a Formatter that streams straight into this sink. The write!/
    // writeln! lowering calls `(sink).as_formatter()` — a method call so the
    // sink auto-refs whether it's a value (`Collector`) or already a borrow
    // (`&mut Formatter` inside a Display::fmt). Default body wraps self.
    /// Returns a default-spec `Formatter` that streams directly into this sink.
    fn as_formatter(&mut self) -> Formatter { return formatter_for_sink(self); }
}

// String is the canonical FmtWrite sink: a Formatter backed by a String
// writes through this impl. (Lets `Formatter` hold a `*mut dyn FmtWrite`
// instead of a fixed `*mut String`, so format! renders into a String while
// write!(sink, …) streams straight to any FmtWrite — zero String intermediate.)
impl FmtWrite for String {
    fn write_str(&mut self, s: str) -> Result<(), Error> { self.push_str(s); return ok(); }
    fn write_char(&mut self, c: u8) -> Result<(), Error> { self.push_u8(c); return ok(); }
}

// ── Formatter ────────────────────────────────────────────────────────
//
// Mirrors `core::fmt::Formatter`. Holds a backing `*mut String` buffer
// plus the spec parameters Rust threads through the formatter (width,
// fill, alignment, precision, sign/alt/zero flags). Today's primitive
// implementations just call `Formatter::write_str` / `Formatter::pad`;
// the spec fields are populated by the eventual `format!`/`println!`
// metacall rewrite but ignored by the legacy `fmt_pad` path until the
// stdlib Display/Debug migration lands.
//
// Divergence from Rust: `Formatter` carries a raw `*mut String` rather
// than a `&mut dyn Write` because Logos doesn't yet have stable dyn-
// trait-objects-with-method-dispatch through the formatter machinery.
// Migrating to `&mut dyn Write` is straightforward once the dyn path
// is exercised.

/// Formatting state threaded through `Display`/`Debug` impls; mirror of `core::fmt::Formatter`.
/// Bundles the output sink with the parsed spec of the current `{...}` placeholder.
pub struct Formatter {
    /// Output sink all writes go through.
    pub w:          *mut dyn FmtWrite,   // sink (String for format!, any FmtWrite for write!)
    /// Fill byte used for width padding (default `' '`).
    pub fill:       u8,
    /// Alignment code.
    pub align_code: u8,    // 0=Unknown→Right, 1=Left, 2=Right, 3=Center
    /// Whether `+` was given: force a sign on non-negative numbers.
    pub sign_plus:  bool,
    /// Whether `#` (alternate form) was given.
    pub alternate:  bool,
    /// Whether `0` (zero padding) was given.
    pub zero_pad:   bool,
    /// Minimum field width.
    pub width:      i64,   // -1 = unspecified
    /// Maximum content length.
    pub precision:  i64,   // -1 = unspecified
    /// Pretty-print nesting depth; preserved across `reset_spec`.
    pub indent:     i64,   // pretty-print depth (alternate `{:#?}` only)
}

/// Creates a default-spec `Formatter` writing into `buf`.
pub fn formatter_for(buf: &mut String) -> Formatter {
    unsafe {
        return Formatter {
            w:          buf as *mut dyn FmtWrite,
            fill:       32u8,   // ' '
            align_code: 0u8,
            sign_plus:  false,
            alternate:  false,
            zero_pad:   false,
            width:      -1i64,
            precision:  -1i64,
            indent:     0i64,
        };
    }
}

// Build a Formatter that streams straight to an arbitrary FmtWrite sink
// (no String intermediate). The metacall lowering for write!/writeln! uses
// this so placeholders + their specs render directly into the sink.
/// Creates a default-spec `Formatter` streaming into an arbitrary `FmtWrite` sink.
pub fn formatter_for_sink(sink: &mut dyn FmtWrite) -> Formatter {
    unsafe {
        return Formatter {
            w:          sink as *mut dyn FmtWrite,
            fill:       32u8,
            align_code: 0u8,
            sign_plus:  false,
            alternate:  false,
            zero_pad:   false,
            width:      -1i64,
            precision:  -1i64,
            indent:     0i64,
        };
    }
}

impl Formatter {
    // Static constructor — used by the format! / println! / etc.
    // metacall lowering so the synthesized block doesn't need a
    // package-level `use logos.mem.fmt;`. Struct symbols are visible
    // globally even without the use, while free-fn names are not.
    /// Creates a default-spec `Formatter` over `buf`; static-call twin of `formatter_for`.
    pub static fn new(buf: &mut String) -> Formatter {
        return formatter_for(buf);
    }

    // Reset spec fields to no-format defaults (matches a placeholder
    // with no spec). Emitted by sema-resident before each placeholder
    // so the per-placeholder field writes start from a clean state.
    // `indent` is preserved across resets — it's nesting state, not
    // a per-placeholder flag.
    /// Resets spec fields to no-format defaults; `indent` (nesting state) is preserved.
    pub fn reset_spec(&mut self) {
        self.fill       = 32u8;     // ' '
        self.align_code = 0u8;
        self.sign_plus  = false;
        self.alternate  = false;
        self.zero_pad   = false;
        self.width      = -1i64;
        self.precision  = -1i64;
    }

    // Pretty-print helper: emit a newline followed by `indent * 4`
    // spaces. Used by DebugBuilders when `alternate` is true.
    /// Writes a newline followed by `indent * 4` spaces.
    pub fn write_indent(&mut self) -> Result<(), Error> {
        let _ = self.write_str("\n");
        let mut i: i64 = 0i64;
        while i < self.indent {
            let _ = self.write_str("    ");
            i = i + 1i64;
        }
        return Result::<(), Error>::Ok(());
    }

    /// Increments the pretty-print nesting depth.
    pub fn indent_inc(&mut self) { self.indent = self.indent + 1i64; }
    /// Decrements the pretty-print nesting depth.
    pub fn indent_dec(&mut self) { self.indent = self.indent - 1i64; }
}

// Formatter is itself a FmtWrite sink (delegating to its underlying sink), so
// `write!(f, …)` inside a Display/Debug impl can wrap the incoming Formatter.
// FmtWrite is the sole provider of write_str/write_char, so `f.write_str(…)`
// stays an unambiguous plain dispatch.
impl FmtWrite for Formatter {
    fn write_str(&mut self, s: str) -> Result<(), Error> {
        unsafe { return (*self.w).write_str(s); }
    }
    fn write_char(&mut self, c: u8) -> Result<(), Error> {
        unsafe { return (*self.w).write_char(c); }
    }
}

impl Formatter {

    // pad() — apply the Formatter's spec fields (width / fill / align /
    // precision / sign_plus / alternate / zero_pad) to `content`,
    // optionally prefixed by `prefix` (e.g. "0x" / "0o" / "0b" under
    // `alternate`). Mirrors Rust's `Formatter::pad` and replaces the
    // standalone `logos.std.fmt::fmt_pad` driver. The migrated Display/Debug
    // impls funnel every value here so spec parsing only happens once
    // per `{...}` placeholder.
    //
    // Layout: zero-pad shape (fill='0' and align defaults to Right)
    // emits  sign / prefix / zero-fill / content;  otherwise
    //        fill-left / sign / prefix / content / fill-right.
    // Matches Rust's `{:05x}` → "000ff" / `{:#05x}` → "0x0ff".
    /// Writes `prefix` then `content` applying the full spec: width, fill, alignment,
    /// precision, `sign_plus`, and zero padding; precision truncates `content` bytewise.
    /// Zero padding inserts `0`s between sign/prefix and content (`{:#05x}` → `0x0ff`).
    pub fn pad(&mut self, content: str, prefix: str) -> Result<(), Error> {
        unsafe {
            let n_full: i64 = content.len();
            let n_eff: i64 =
                if self.precision >= 0i64 && n_full > self.precision { self.precision }
                else { n_full };

            let mut emit_sign: bool = false;
            if self.sign_plus && n_eff > 0i64 {
                let c0: u8 = content[0i64];
                if c0 != 45u8 && c0 != 43u8 {  // not '-' or '+'
                    emit_sign = true;
                }
            }
            let body: i64 =
                (if emit_sign { 1i64 } else { 0i64 }) + prefix.len() + n_eff;
            let mut left_pad:  i64 = 0i64;
            let mut right_pad: i64 = 0i64;
            if self.width > body {
                let pad_n: i64 = self.width - body;
                if self.align_code == 1u8 {
                    right_pad = pad_n;
                } else if self.align_code == 3u8 {
                    left_pad  = pad_n / 2i64;
                    right_pad = pad_n - left_pad;
                } else {
                    left_pad = pad_n;
                }
            }

            let is_zero_pad: bool = (self.fill == 48u8) && (self.align_code != 1u8);
            let mut i: i64 = 0i64;
            if !is_zero_pad {
                while i < left_pad { let _ = (*self.w).write_char(self.fill); i = i + 1i64; }
            }
            if emit_sign { let _ = (*self.w).write_char(43u8); }
            let _ = (*self.w).write_str(prefix);
            if is_zero_pad {
                i = 0i64;
                while i < left_pad { let _ = (*self.w).write_char(48u8); i = i + 1i64; }
            }
            i = 0i64;
            while i < n_eff { let _ = (*self.w).write_char(content[i]); i = i + 1i64; }
            if !is_zero_pad {
                i = 0i64;
                while i < right_pad { let _ = (*self.w).write_char(self.fill); i = i + 1i64; }
            } else {
                i = 0i64;
                while i < right_pad { let _ = (*self.w).write_char(48u8); i = i + 1i64; }
            }
        }
        return ok();
    }

    // Writes a signed-decimal integer through `pad()`. Renders to a
    // scratch String first so width/align/precision apply uniformly
    // (a sign-prefixed body counts toward the body width for centring).
    /// Writes `n` in signed decimal through `pad` (spec applies).
    pub fn write_int_dec_i64(&mut self, n: i64) -> Result<(), Error> {
        let mut scratch: String = String::new();
        scratch.push_i64(n);
        return self.pad(scratch.as_str(), "");
    }
    /// Writes `n` in unsigned decimal through `pad` (spec applies).
    pub fn write_int_dec_u64(&mut self, n: u64) -> Result<(), Error> {
        let mut scratch: String = String::new();
        scratch.push_u64(n);
        return self.pad(scratch.as_str(), "");
    }
    /// Writes `"true"` or `"false"` through `pad` (spec applies).
    pub fn write_bool(&mut self, b: bool) -> Result<(), Error> {
        if b { return self.pad("true",  ""); }
        return self.pad("false", "");
    }
    // Signless radix render (base 2/8/16). Caller responsible for
    // sign-extension or u32-cast-via-mask for signed types — same
    // contract as Rust's `LowerHex`/`UpperHex`/`Octal`/`Binary` on
    // signed types (`format!("{:x}", -1i32)` → "ffffffff").
    /// Writes `n` in the given radix (2/8/16) through `pad`; `upper` selects `A-F` digits.
    /// Signless — callers mask signed values first. Alternate (`#`) adds `0x`/`0o`/`0b`.
    pub fn write_int_radix_u64(&mut self, n: u64, radix: u64, upper: bool) -> Result<(), Error> {
        let mut scratch: String = String::new();
        if n == 0u64 {
            scratch.push_u8(48u8);
        } else {
            let mut tmp: [u8; 64] = [0u8; 64];
            let mut pos: i64 = 0i64;
            let mut m: u64 = n;
            while m > 0u64 {
                let d: u64 = m % radix;
                let c: u8 =
                    if d < 10u64 {
                        (d as u8) + 48u8
                    } else if upper {
                        (d as u8) - 10u8 + 65u8
                    } else {
                        (d as u8) - 10u8 + 97u8
                    };
                tmp[pos] = c;
                pos = pos + 1i64;
                m = m / radix;
            }
            let mut i: i64 = pos - 1i64;
            while i >= 0i64 { scratch.push_u8(tmp[i]); i = i - 1i64; }
        }
        // Pick the alt-form prefix when `#` (alternate) is set.
        let prefix: str =
            if self.alternate {
                if radix == 16u64 { if upper { "0x" } else { "0x" } }
                else if radix == 8u64  { "0o" }
                else if radix == 2u64  { "0b" }
                else                    { "" }
            } else { "" };
        return self.pad(scratch.as_str(), prefix);
    }
}

// ── Display / Debug — Rust-shape format traits ────────────────────────
//
// Sits ALONGSIDE the legacy `mem.string::Display` and `logos.std.fmt::Debug`
// (which both take `&mut String` directly). Migration plan:
//
//   Session 1 (this commit): infrastructure — Formatter helpers above,
//     traits below, Display impl for i32 as proof-of-shape.
//   Session 2: migrate every primitive (i8…i64, u8…u64, f32/f64, bool,
//     str, *const u8, tuples) to Display/Debug — bridge legacy
//     traits to delegate.
//   Session 3: migrate stdlib struct impls (Option, Result, Vec) and
//     the LowerHex/UpperHex/Octal/Binary/LowerExp/UpperExp families.
//   Session 4: rewrite `format!`/`println!`/`print!`/`eprintln!`/
//     `eprint!`/`panic!`/`assert*!` metacalls to spec-parse into a
//     Formatter then dispatch through Display; drop fmt_pad +
//     fmt_display/fmt_debug helpers; rename Display→Display once
//     legacy gone (and the cross-pkg trait-registry collision lifts).
//
// Traits named `Display`/`Debug` rather than `Display`/`Debug`
// for the same reason FmtWrite is — Logos's flat trait registry would
// clobber the legacy names cross-package (B-mv-02). The rename happens
// in Session 4 alongside the legacy delete.

// Method names `fmt_display` / `fmt_debug` (rather than the canonical
// Rust `fmt`) — Logos's method-mangling doesn't include the trait name
// so an `impl Display for i32 { fn fmt(...) }` would clash with the
// legacy `impl Display for i32 { fn fmt(...) }` already in
// `mem.string`. After Session 4's legacy delete the trait registry is
// clean and the methods rename back to plain `fmt`.

/// User-facing formatting (`{}` placeholders); mirror of `core::fmt::Display`.
pub trait Display {
    /// Formats `self` into `f`.
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error>;
}

/// Developer-facing formatting (`{:?}` placeholders); mirror of `core::fmt::Debug`.
pub trait Debug {
    /// Formats `self` into `f`.
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error>;
}

// Render any Display value to an owned String using a default-spec
// Formatter (no width/precision/sign). Equivalent to Rust's
// `format!("{}", v)` once the metacall migration lands.
/// Renders `val` via `Display` into a new `String` using a default-spec `Formatter`.
pub fn fmt_display_to_string<T: Display>(val: &T) -> String {
    let mut buf: String = String::new();
    let mut f: Formatter = formatter_for(&mut buf);
    let _ = val.fmt(&mut f);
    return buf;
}

/// Renders `val` via `Debug` into a new `String` using a default-spec `Formatter`.
pub fn fmt_debug_to_string<T: Debug>(val: &T) -> String {
    let mut buf: String = String::new();
    let mut f: Formatter = formatter_for(&mut buf);
    let _ = val.fmt(&mut f);
    return buf;
}

// ── Single-trait dispatchers ────────────────────────────────────────
//
// Every fmt-family trait now declares the canonical method `fmt`, so a bare
// `x.fmt(f)` on a value that impls more than one of them is ambiguous (and a
// concrete receiver has no way to pick). These free fns bind exactly one trait
// through a generic bound, letting `fmt_display(&x, f)` etc. select it
// unambiguously. The format-family metacall lowering emits calls to these by
// bare name (see format_trait_dispatcher in sema_fmt.cpp).
/// Dispatches `arg.fmt(f)` through the `Display` bound (resolves the shared `fmt` name).
pub fn fmt_display<T: Display>(arg: &T, f: &mut Formatter) -> Result<(), Error> {
    return arg.fmt(f);
}
/// Dispatches `arg.fmt(f)` through the `Debug` bound (resolves the shared `fmt` name).
pub fn fmt_debug<T: Debug>(arg: &T, f: &mut Formatter) -> Result<(), Error> {
    return arg.fmt(f);
}
/// Dispatches `arg.fmt(f)` through the `LowerHex` bound (resolves the shared `fmt` name).
pub fn fmt_lower_hex<T: LowerHex>(arg: &T, f: &mut Formatter) -> Result<(), Error> {
    return arg.fmt(f);
}
/// Dispatches `arg.fmt(f)` through the `UpperHex` bound (resolves the shared `fmt` name).
pub fn fmt_upper_hex<T: UpperHex>(arg: &T, f: &mut Formatter) -> Result<(), Error> {
    return arg.fmt(f);
}
/// Dispatches `arg.fmt(f)` through the `Octal` bound (resolves the shared `fmt` name).
pub fn fmt_octal<T: Octal>(arg: &T, f: &mut Formatter) -> Result<(), Error> {
    return arg.fmt(f);
}
/// Dispatches `arg.fmt(f)` through the `Binary` bound (resolves the shared `fmt` name).
pub fn fmt_binary<T: Binary>(arg: &T, f: &mut Formatter) -> Result<(), Error> {
    return arg.fmt(f);
}
/// Dispatches `arg.fmt(f)` through the `LowerExp` bound (resolves the shared `fmt` name).
pub fn fmt_lower_exp<T: LowerExp>(arg: &T, f: &mut Formatter) -> Result<(), Error> {
    return arg.fmt(f);
}
/// Dispatches `arg.fmt(f)` through the `UpperExp` bound (resolves the shared `fmt` name).
pub fn fmt_upper_exp<T: UpperExp>(arg: &T, f: &mut Formatter) -> Result<(), Error> {
    return arg.fmt(f);
}

// ── Tuple-Debug step helpers ────────────────────────────────────────
//
// The variadic `impl<A...: Debug> Debug for (A...)` body defers to the
// `tuple_each_field_debug` intrinsic, which mono expands into a chain of these
// free fns: `fmt_seq(fmt_seq(… fmt_tuple_open(f), <field0>), fmt_tuple_sep(f)),
// <field1>) , … , fmt_tuple_close(f))`. Building the chain from free-fn calls
// (vs a block_expr / inline string writes) keeps the mono handler to the same
// primitives the eq handler uses. `fmt_seq` matches its first arg (so its
// write side effect isn't dead-code-eliminated) and short-circuits on Err
// like Rust's `write!(…)?`, otherwise returns the second.
/// Returns `a` if it is `Err`, else `b`; short-circuit step in mono-expanded tuple `Debug` chains.
pub fn fmt_seq(a: Result<(), Error>, b: Result<(), Error>) -> Result<(), Error> {
    match a {
        Result::Err(e) => { return Result::<(), Error>::Err(e); }
        Result::Ok(_)  => { return b; }
    }
}
/// Writes the tuple-`Debug` opener `(`.
pub fn fmt_tuple_open(f: &mut Formatter)   -> Result<(), Error> { return f.write_str("("); }
/// Writes the tuple-`Debug` separator `, `.
pub fn fmt_tuple_sep(f: &mut Formatter)    -> Result<(), Error> { return f.write_str(", "); }
/// Writes the tuple-`Debug` closer `)`.
pub fn fmt_tuple_close(f: &mut Formatter)  -> Result<(), Error> { return f.write_str(")"); }
/// Writes the 1-tuple closer `,)`.
pub fn fmt_tuple_close1(f: &mut Formatter) -> Result<(), Error> { return f.write_str(",)"); }

// ── Primitive impls ─────────────────────────────────────────────────
//
// Display and Debug for every integer/float/bool/str primitive +
// `*const u8` (C string) + unit `()`. For integer/float/bool/unit/str
// primitives Rust uses identical Display and Debug rendering (modulo
// `Debug for str` which quotes), so the impls below pair Display +
// Debug per type. Tuples ship below.
//
// All routes through Formatter helpers so the spec fields (width /
// fill / align / precision / sign / alt / zero) take effect uniformly.

// ── Signed integers ─────────────────────────────────────────────────
impl Display for i8    { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }
impl Debug   for i8    { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }
impl Display for i16   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }
impl Debug   for i16   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }
impl Display for i32 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        return f.write_int_dec_i64(*self as i64);
    }
}
impl Debug for i32 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        return f.write_int_dec_i64(*self as i64);
    }
}
impl Display for i64   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self);        } }
impl Debug   for i64   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self);        } }
impl Display for isize { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }
impl Debug   for isize { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_i64(*self as i64); } }

// ── Unsigned integers ───────────────────────────────────────────────
impl Display for u8    { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl Debug   for u8    { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl Display for u16   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl Debug   for u16   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl Display for u32   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl Debug   for u32   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl Display for u64   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self);        } }
impl Debug   for u64   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self);        } }
impl Display for usize { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }
impl Debug   for usize { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_dec_u64(*self as u64); } }

// ── bool ────────────────────────────────────────────────────────────
impl Display for bool { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_bool(*self); } }
impl Debug   for bool { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_bool(*self); } }

// ── str ─────────────────────────────────────────────────────────────
// Display = raw bytes through pad (width/precision apply).
// Debug   = '"' content '"' — minimal escape (no backslash-escaping
//   of control chars yet; matches `format!("{:?}", "x")` for the
//   non-control-char common case). Full Rust-style escape ladder
//   ('\\n'/'\\t'/'\\u{…}') is a follow-up alongside the Utf8/escape
//   work later in the roadmap.
impl Display for str {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        return f.pad(*self, "");
    }
}
// Rust `escape_debug`-style escaping shared by the `Debug` impls of `str`/`String`:
// wrap in `"` and escape `"`, `\`, `\n`, `\t`, `\r`, and other control bytes as
// `\u{XX}`, so the debug output is unambiguous and round-trips.
fn debug_write_escaped(s: str, f: &mut Formatter) -> Result<(), Error> {
    let _ = f.write_char(34u8);                    // opening "
    let p: *const u8 = s.as_ptr();
    let n: i64 = s.len();
    let mut i: i64 = 0i64;
    while i < n {
        let c: u8 = unsafe { *(p.add(i)) };
        if c == 34u8        { let _ = f.write_char(92u8); let _ = f.write_char(34u8); }   // \"
        else if c == 92u8   { let _ = f.write_char(92u8); let _ = f.write_char(92u8); }   // \\
        else if c == 10u8   { let _ = f.write_char(92u8); let _ = f.write_char(110u8); }  // \n
        else if c == 9u8    { let _ = f.write_char(92u8); let _ = f.write_char(116u8); }  // \t
        else if c == 13u8   { let _ = f.write_char(92u8); let _ = f.write_char(114u8); }  // \r
        else if c < 32u8 || c == 127u8 {                                                  // \u{XX}
            let _ = f.write_char(92u8); let _ = f.write_char(117u8); let _ = f.write_char(123u8);
            let hi: u8 = c / 16u8;
            let lo: u8 = c % 16u8;
            let _ = f.write_char(if hi < 10u8 { 48u8 + hi } else { 87u8 + hi });
            let _ = f.write_char(if lo < 10u8 { 48u8 + lo } else { 87u8 + lo });
            let _ = f.write_char(125u8);                                                  // }
        }
        else                { let _ = f.write_char(c); }
        i = i + 1i64;
    }
    return f.write_char(34u8);                      // closing "
}

impl Debug for str {
    /// Writes `self` in `"` quotes, escaping `"`, `\`, and control chars (Rust `escape_debug`).
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        return debug_write_escaped(*self, f);
    }
}

// ── *const u8 — Display of C strings ────────────────────────────────
// Mirrors the legacy `Display for *const u8` in mem.string: walks
// null-terminated bytes and writes them as one str chunk. Used by
// FFI surfaces returning `char *`. No Debug — Rust doesn't define
// it on raw pointers either; cast to *const () or use ptr::eq.
impl Display for *const u8 {
    /// Renders the pointed-to NUL-terminated C string; walks memory unchecked to the terminator.
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let p: *const u8 = *self;
        let n: i64 = str_len(p);
        let s: str = str_from_raw(p, n);
        return f.pad(s, "");
    }
}

// ── f32 / f64 ───────────────────────────────────────────────────────
// Same extern bridge the legacy Display impls use: `snprintf("%g", x)`
// gives the shortest round-trippable representation. Render into a
// scratch String, then route through pad.
impl Display for f64 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_g(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl Debug for f64 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_g(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl Display for f32 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_g(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl Debug for f32 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_g(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}

// ── unit `()` ────────────────────────────────────────────────────────
// Rust renders both Display and Debug as "()".
impl Display for () {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        return f.pad("()", "");
    }
}
impl Debug for () {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        return f.pad("()", "");
    }
}

// ── Tuples ──────────────────────────────────────────────────────────
// Tuples have Debug (not Display) in Rust. Per-arity hand-rolled
// impls until variadic-tuple-impl baghunt lands
// ([[baghunt-variadic-tuple-impl]]).

// Variadic-arity tuple Debug — single impl covering any tuple shape (replaces
// the former per-arity 1/2/3/4 hand-rolled impls). `tuple_each_field_debug::
// <Self>(self, f)` defers to mono-time expansion (mirrors the variadic Eq
// impl's `tuple_all_eq`): renders "(", each field's Debug interleaved with
// ", ", then ")" (or ",)" for the 1-tuple). Arity 0 keeps its own `()` impl.
impl<A...: Debug> Debug for (A...) {
    fn fmt(self: &Self, f: &mut Formatter) -> Result<(), Error> {
        return tuple_each_field_debug::<Self>(self, f);
    }
}

// ── stdlib struct impls (Session 3) ─────────────────────────────────
//
// Live in mem.fmt rather than each owning module so we can hold a
// Display/Debug supertrait bound on the payload type. The
// legacy `Debug for Option<T>` etc. similarly live in `logos.std.fmt` for
// the same reason — Rust hand-rolls these in `core::fmt`.

impl<T: Debug> Debug for Option<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        match self {
            Option::Some(v) => {
                let _ = f.write_str("Some(");
                let _ = v.fmt(f);
                return f.write_str(")");
            }
            Option::None => { return f.write_str("None"); }
        }
    }
}

impl<T: Debug, E: Debug> Debug for Result<T, E> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        match self {
            Result::Ok(v) => {
                let _ = f.write_str("Ok(");
                let _ = v.fmt(f);
                return f.write_str(")");
            }
            Result::Err(e) => {
                let _ = f.write_str("Err(");
                let _ = e.fmt(f);
                return f.write_str(")");
            }
        }
    }
}

impl<T: Debug> Debug for Vec<T> {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let _ = f.write_str("[");
        let n: i64 = self.length();
        let mut i: i64 = 0i64;
        while i < n {
            if i > 0i64 { let _ = f.write_str(", "); }
            let v: &T = self.borrow(i);
            let _ = v.fmt(f);
            i = i + 1i64;
        }
        return f.write_str("]");
    }
}

// String — Display is content pass-through (with width/precision via
// pad), Debug is quoted (minimal — full Rust escape ladder is a
// follow-up alongside the str Debug story).

// Ordering — Display "Less"/"Equal"/"Greater", Debug same.

// ── Numeric format traits (Session 3) ───────────────────────────────
//
// Mirror of `core::fmt::{LowerHex, UpperHex, Octal, Binary, LowerExp,
// UpperExp}`. Same Rust-shape method as Display/Debug: take `&self`
// and a `&mut Formatter`, route through Formatter helpers.
//
// Trait names `LowerHex` etc. — `LowerHex`/`Octal`/etc. already
// exist as legacy traits in logos.std.fmt. Same B-mv-02 reason as
// Display/Debug. Renamed to plain `LowerHex` etc. in Session 4
// alongside the legacy delete.

/// Lowercase hexadecimal formatting (`{:x}`); mirror of `core::fmt::LowerHex`.
pub trait LowerHex {
    /// Formats `self` into `f` as lowercase hex.
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error>;
}
/// Uppercase hexadecimal formatting (`{:X}`); mirror of `core::fmt::UpperHex`.
pub trait UpperHex {
    /// Formats `self` into `f` as uppercase hex.
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error>;
}
/// Octal formatting (`{:o}`); mirror of `core::fmt::Octal`.
pub trait Octal {
    /// Formats `self` into `f` as octal.
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error>;
}
/// Binary formatting (`{:b}`); mirror of `core::fmt::Binary`.
pub trait Binary {
    /// Formats `self` into `f` as binary.
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error>;
}
/// Lowercase scientific-notation formatting (`{:e}`); mirror of `core::fmt::LowerExp`.
pub trait LowerExp {
    /// Formats `self` into `f` in `1.5e3`-style notation.
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error>;
}
/// Uppercase scientific-notation formatting (`{:E}`); mirror of `core::fmt::UpperExp`.
pub trait UpperExp {
    /// Formats `self` into `f` in `1.5E3`-style notation.
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error>;
}

// Per-primitive radix impls. Signed types u32-mask first so the
// rendered width matches Rust's `format!("{:x}", -1i32)` → "ffffffff"
// (rather than full-width "ffffffffffffffff"). u64/i64 pass through.

impl LowerHex for u64   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self,        16u64, false); } }
impl LowerHex for u32   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }
impl LowerHex for u16   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }
impl LowerHex for u8    { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }
impl LowerHex for usize { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }
impl LowerHex for i64   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }
impl LowerHex for i32   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u32 as u64, 16u64, false); } }
impl LowerHex for i16   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u16 as u64, 16u64, false); } }
impl LowerHex for i8    { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u8  as u64, 16u64, false); } }
impl LowerHex for isize { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, false); } }

impl UpperHex for u64   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self,        16u64, true); } }
impl UpperHex for u32   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }
impl UpperHex for u16   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }
impl UpperHex for u8    { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }
impl UpperHex for usize { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }
impl UpperHex for i64   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }
impl UpperHex for i32   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u32 as u64, 16u64, true); } }
impl UpperHex for i16   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u16 as u64, 16u64, true); } }
impl UpperHex for i8    { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u8  as u64, 16u64, true); } }
impl UpperHex for isize { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 16u64, true); } }

impl Octal for u64   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self,        8u64, false); } }
impl Octal for u32   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 8u64, false); } }
impl Octal for u16   { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 8u64, false); } }
impl Octal for u8    { fn fmt(&self, f: &mut Formatter) -> Result<(), Error> { return f.write_int_radix_u64(*self as u64, 8u64, false); } }
