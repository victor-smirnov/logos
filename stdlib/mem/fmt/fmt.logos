// Float scientific — extern bridge to libc snprintf "%e"/"%E".
// Symbols pre-declared up top alongside the "%g" pair.
extern fn logos_fmt_f64_e(buf: *mut u8, cap: i32, x: f64) -> i32;
extern fn logos_fmt_f64_E(buf: *mut u8, cap: i32, x: f64) -> i32;
extern fn logos_fmt_f32_e(buf: *mut u8, cap: i32, x: f32) -> i32;
extern fn logos_fmt_f32_E(buf: *mut u8, cap: i32, x: f32) -> i32;

impl LowerExp for f64 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_e(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl UpperExp for f64 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f64_E(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl LowerExp for f32 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_e(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}
impl UpperExp for f32 {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let mut scratch: String = String::new();
        let cap: i32 = 32i32;
        let ptr: *mut u8 = scratch.spare_ptr(cap as i64);
        let n: i32 = unsafe { logos_fmt_f32_E(ptr, cap, *self) };
        scratch.advance_len(n as i64);
        return f.pad(scratch.as_str(), "");
    }
}

// ── Arguments ────────────────────────────────────────────────────────
//
// Mirrors `core::fmt::Arguments` — the opaque carrier produced by
// `format_args!` and consumed by `write!`/`writeln!`/`println!`. In
// Rust it bundles the format string and a slice of argument pointers
// along with their formatter functions. Logos's `format!`/`println!`
// metacalls today expand the spec inline at the call site, so
// `Arguments` is currently a placeholder type — the field carries the
// already-formatted result string. Once the metacall is rewritten to
// produce a deferred `Arguments` instead of an immediate `String`,
// this struct will hold the spec + arg pointers and grow a
// `format()` method that writes through a `Formatter`.

/// Placeholder mirror of `core::fmt::Arguments`; currently just carries the rendered text.
pub struct Arguments {
    /// The already-formatted result string.
    pub rendered: String,
}


impl Display for String {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        return f.pad(self.as_str(), "");
    }
}
impl Debug for String {
    /// Writes the content in `"` quotes, escaping `"`, `\`, and control chars (Rust `escape_debug`).
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        return debug_write_escaped(self.as_str(), f);
    }
}

impl Display for Ordering {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let me: Ordering = *self;
        match me {
            Ordering::Less    => { return f.write_str("Less"); }
            Ordering::Equal   => { return f.write_str("Equal"); }
            Ordering::Greater => { return f.write_str("Greater"); }
        }
    }
}
impl Debug for Ordering {
    fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
        let me: Ordering = *self;
        match me {
            Ordering::Less    => { return f.write_str("Less"); }
            Ordering::Equal   => { return f.write_str("Equal"); }
            Ordering::Greater => { return f.write_str("Greater"); }
        }
    }
}

// ── DebugBuilders ───────────────────────────────────────────────────
//
// Mirror `core::fmt::DebugStruct`/`DebugTuple`/`DebugList`/`DebugSet`/
// `DebugMap` — fluent helpers that custom `fmt_debug` impls compose
// the standard Debug output through. Each builder owns a `*mut
// Formatter`, threads a running `Result<(), Error>`, and tracks
// whether any item has been written so the comma logic Just Works.
//
// Single-line shape only — no pretty-print (Rust's `{:#?}` mode).
// Pretty-print is a follow-up: it needs Formatter-level indent state
// and per-builder split-line logic.
//
// Usage mirror of Rust:
//   impl Debug for Widget {
//       fn fmt(&self, f: &mut Formatter) -> Result<(), Error> {
//           let mut s: DebugStruct = f.debug_struct("Widget");
//           let _ = s.field::<i32>("x", &self.x);
//           let _ = s.field::<i32>("y", &self.y);
//           return s.finish();
//       }
//   }

/// Builder for struct-shape `Debug` output (`Foo { x: 1 }`); from `Formatter::debug_struct`.
pub struct DebugStruct {
    /// Backing formatter.
    pub f:           *mut Formatter,
    /// Running result returned by `finish`.
    pub result:      Result<(), Error>,
    /// Whether any field has been written (drives comma/brace emission).
    pub has_fields:  bool,
}

/// Builder for tuple-shape `Debug` output (`Foo(1, 2)`); from `Formatter::debug_tuple`.
pub struct DebugTuple {
    /// Backing formatter.
    pub f:        *mut Formatter,
    /// Running result returned by `finish`.
    pub result:   Result<(), Error>,
    /// Count of fields written so far.
    pub fields:   i64,
}

/// Builder for list-shape `Debug` output (`[a, b]`); from `Formatter::debug_list`.
pub struct DebugList {
    /// Backing formatter.
    pub f:        *mut Formatter,
    /// Running result returned by `finish`.
    pub result:   Result<(), Error>,
    /// Whether any entry has been written (drives comma emission).
    pub has_any:  bool,
}

/// Builder for set-shape `Debug` output (`{a, b}`); from `Formatter::debug_set`.
pub struct DebugSet {
    /// Backing formatter.
    pub f:        *mut Formatter,
    /// Running result returned by `finish`.
    pub result:   Result<(), Error>,
    /// Whether any entry has been written (drives comma emission).
    pub has_any:  bool,
}

/// Builder for map-shape `Debug` output (`{k: v}`); from `Formatter::debug_map`.
pub struct DebugMap {
    /// Backing formatter.
    pub f:         *mut Formatter,
    /// Running result returned by `finish`.
    pub result:    Result<(), Error>,
    /// Whether any entry has been written (drives comma emission).
    pub has_any:   bool,
}

impl Formatter {
    // Open a struct-shape Debug builder. Writes the name eagerly; the
    // first `.field()` call emits ` { name: value`. Empty finish keeps
    // just the name (Rust's `Foo` for unit struct, `Foo {}` only when
    // `.field()` was called).
    /// Creates a struct-shape `Debug` builder, writing `name` immediately.
    /// Braces appear only once `.field()` is called (unit structs render as bare `name`).
    pub fn debug_struct(&mut self, name: str) -> DebugStruct {
        let r: Result<(), Error> = self.write_str(name);
        unsafe {
            return DebugStruct {
                f:          self as *mut Formatter,
                result:     r,
                has_fields: false,
            };
        }
    }

    /// Creates a tuple-shape `Debug` builder, writing `name` immediately.
    pub fn debug_tuple(&mut self, name: str) -> DebugTuple {
        let r: Result<(), Error> = self.write_str(name);
        unsafe {
            return DebugTuple {
                f:      self as *mut Formatter,
                result: r,
                fields: 0i64,
            };
        }
    }

    /// Creates a list-shape `Debug` builder, writing the opening `[` immediately.
    pub fn debug_list(&mut self) -> DebugList {
        let r: Result<(), Error> = self.write_str("[");
        unsafe {
            return DebugList {
                f:       self as *mut Formatter,
                result:  r,
                has_any: false,
            };
        }
    }

    /// Creates a set-shape `Debug` builder, writing the opening `{` immediately.
    pub fn debug_set(&mut self) -> DebugSet {
        let r: Result<(), Error> = self.write_str("{");
        unsafe {
            return DebugSet {
                f:       self as *mut Formatter,
                result:  r,
                has_any: false,
            };
        }
    }

    /// Creates a map-shape `Debug` builder, writing the opening `{` immediately.
    pub fn debug_map(&mut self) -> DebugMap {
        let r: Result<(), Error> = self.write_str("{");
        unsafe {
            return DebugMap {
                f:       self as *mut Formatter,
                result:  r,
                has_any: false,
            };
        }
    }
}

impl DebugStruct {
    /// Appends one `name: value` field rendered via `value`'s `Debug`.
    pub fn field<T: Debug>(&mut self, name: str, value: &T) -> &mut DebugStruct {
        unsafe {
            let pretty: bool = (*self.f).alternate;
            if self.has_fields {
                if pretty {
                    let _ = (*self.f).write_str(",");
                    let _ = (*self.f).write_indent();
                } else {
                    let _ = (*self.f).write_str(", ");
                }
            } else {
                if pretty {
                    let _ = (*self.f).write_str(" {");
                    (*self.f).indent_inc();
                    let _ = (*self.f).write_indent();
                } else {
                    let _ = (*self.f).write_str(" { ");
                }
            }
            let _ = (*self.f).write_str(name);
            let _ = (*self.f).write_str(": ");
            let _ = value.fmt(&mut *self.f);
            self.has_fields = true;
        }
        return self;
    }

    /// Closes the struct body (only if fields were written) and returns the running result.
    pub fn finish(&mut self) -> Result<(), Error> {
        if self.has_fields {
            unsafe {
                if (*self.f).alternate {
                    (*self.f).indent_dec();
                    let _ = (*self.f).write_str(",");
                    let _ = (*self.f).write_indent();
                    let _ = (*self.f).write_str("}");
                } else {
                    let _ = (*self.f).write_str(" }");
                }
            }
        }
        return self.result;
    }

    // Mirror Rust's `finish_non_exhaustive` — emits `Foo { a: 1, .. }`
    // (or `Foo { .. }` with no prior fields) so the trailing `..` makes
    // it clear the struct has private fields not in the output.
    /// Closes the body with a trailing `..` marker (`Foo { a: 1, .. }` / `Foo { .. }`).
    pub fn finish_non_exhaustive(&mut self) -> Result<(), Error> {
        unsafe {
            if (*self.f).alternate {
                if self.has_fields {
                    let _ = (*self.f).write_str(",");
                    let _ = (*self.f).write_indent();
                    let _ = (*self.f).write_str("..");
                    (*self.f).indent_dec();
                    let _ = (*self.f).write_indent();
                    let _ = (*self.f).write_str("}");
                } else {
                    let _ = (*self.f).write_str(" { .. }");
                }
            } else {
                if self.has_fields {
                    let _ = (*self.f).write_str(", .. }");
                } else {
                    let _ = (*self.f).write_str(" { .. }");
                }
            }
        }
        return self.result;
    }
}

impl DebugTuple {
    /// Appends one tuple field rendered via `value`'s `Debug`.
    pub fn field<T: Debug>(&mut self, value: &T) -> &mut DebugTuple {
        unsafe {
            let pretty: bool = (*self.f).alternate;
            if self.fields == 0i64 {
                if pretty {
                    let _ = (*self.f).write_str("(");
                    (*self.f).indent_inc();
                    let _ = (*self.f).write_indent();
                } else {
                    let _ = (*self.f).write_str("(");
                }
            } else {
                if pretty {
                    let _ = (*self.f).write_str(",");
                    let _ = (*self.f).write_indent();
                } else {
                    let _ = (*self.f).write_str(", ");
                }
            }
            let _ = value.fmt(&mut *self.f);
            self.fields = self.fields + 1i64;
        }
        return self;
    }

    /// Closes with `)` (only if fields were written) and returns the running result.
    pub fn finish(&mut self) -> Result<(), Error> {
        if self.fields > 0i64 {
            unsafe {
                if (*self.f).alternate {
                    (*self.f).indent_dec();
                    let _ = (*self.f).write_str(",");
                    let _ = (*self.f).write_indent();
                    let _ = (*self.f).write_str(")");
                } else {
                    let _ = (*self.f).write_str(")");
                }
            }
        }
        return self.result;
    }
}

impl DebugList {
    /// Appends one entry rendered via `value`'s `Debug`.
    pub fn entry<T: Debug>(&mut self, value: &T) -> &mut DebugList {
        unsafe {
            let pretty: bool = (*self.f).alternate;
            if self.has_any {
                if pretty {
                    let _ = (*self.f).write_str(",");
                    let _ = (*self.f).write_indent();
                } else {
                    let _ = (*self.f).write_str(", ");
                }
            } else {
                if pretty {
                    (*self.f).indent_inc();
                    let _ = (*self.f).write_indent();
                }
            }
            let _ = value.fmt(&mut *self.f);
            self.has_any = true;
        }
        return self;
    }

    /// Closes with `]` and returns the running result.
    pub fn finish(&mut self) -> Result<(), Error> {
        unsafe {
            if (*self.f).alternate && self.has_any {
                (*self.f).indent_dec();
                let _ = (*self.f).write_str(",");
                let _ = (*self.f).write_indent();
            }
            let _ = (*self.f).write_str("]");
        }
        return self.result;
    }
}

impl DebugSet {
    /// Appends one entry rendered via `value`'s `Debug`.
    pub fn entry<T: Debug>(&mut self, value: &T) -> &mut DebugSet {
        unsafe {
            let pretty: bool = (*self.f).alternate;
            if self.has_any {
                if pretty {
                    let _ = (*self.f).write_str(",");
                    let _ = (*self.f).write_indent();
                } else {
                    let _ = (*self.f).write_str(", ");
                }
            } else {
                if pretty {
                    (*self.f).indent_inc();
                    let _ = (*self.f).write_indent();
                }
            }
            let _ = value.fmt(&mut *self.f);
            self.has_any = true;
        }
        return self;
    }

    /// Closes with `}` and returns the running result.
    pub fn finish(&mut self) -> Result<(), Error> {
        unsafe {
            if (*self.f).alternate && self.has_any {
                (*self.f).indent_dec();
                let _ = (*self.f).write_str(",");
                let _ = (*self.f).write_indent();
            }
            let _ = (*self.f).write_str("}");
        }
        return self.result;
    }
}

impl DebugMap {
    // Single-shot key-value entry. Most users want this over
    // separate `.key().value()` calls.
    /// Appends one `k: v` entry, rendering key and value via their `Debug` impls.
    pub fn entry<K: Debug, V: Debug>(&mut self, k: &K, v: &V) -> &mut DebugMap {
        unsafe {
            let pretty: bool = (*self.f).alternate;
            if self.has_any {
                if pretty {
                    let _ = (*self.f).write_str(",");
                    let _ = (*self.f).write_indent();
                } else {
                    let _ = (*self.f).write_str(", ");
                }
            } else {
                if pretty {
                    (*self.f).indent_inc();
                    let _ = (*self.f).write_indent();
                }
            }
            let _ = k.fmt(&mut *self.f);
            let _ = (*self.f).write_str(": ");
            let _ = v.fmt(&mut *self.f);
            self.has_any = true;
        }
        return self;
    }

    /// Closes with `}` and returns the running result.
    pub fn finish(&mut self) -> Result<(), Error> {
        unsafe {
            if (*self.f).alternate && self.has_any {
                (*self.f).indent_dec();
                let _ = (*self.f).write_str(",");
                let _ = (*self.f).write_indent();
            }
            let _ = (*self.f).write_str("}");
        }
        return self.result;
    }
}

// ── Auto-deriving ToString blanket ──────────────────────────────────
//
// Rust's `alloc::string::ToString` has a blanket `impl<T: Display> ToString
// for T`. The Logos analogue lives here (rather than in mem.string)
// because Display is declared in mem.fmt and mem.string sits below
// it in the import order. Users with `use logos.mem.fmt;` automatically
// get `.to_string()` on any Display-implementing type. Primitive
// to_string impls live directly in mem.string and don't go through
// this blanket.
impl<T: Display> ToString for T {
    fn to_string(self: T) -> String {
        return fmt_display_to_string::<T>(&self);
    }
}
