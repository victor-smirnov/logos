// logos.mem.pkd.pdtbuf — PdtBuf: the Logos EQUIVALENT of the C++ Memoria
// PackedDataTypeBuffer (the successor structure into which Victor folded
// PkdArray / PkdFQTree / PkdFMTree upstream). Ladder rungs P0 + P1 + P2 + P3:
// the runtime core — slot geometry, sizing, cell access, the
// ordering-dispatched search family — plus the recursive SUM span index that
// accelerates it, the start-relative and BACKWARD searches (both obtained as
// DERIVATIONS over that one forward descent rather than as walks of their
// own), and the TWO-PHASE MUTATION SURFACE that makes the exact-prepare law
// executable: prepare prices, commit consumes exactly that, and
// `prepared_bytes == consumed_bytes` is asserted at every mutation.
//
// C++ oracle sites (HEAD, /home/victor/cxx/memoria), mirrored one by one:
//   containers/include/memoria/core/packed/datatype_buffer/
//     packed_datatype_buffer.hpp
//       :33-40   PackedDataTypeBufferT<DataType, Indexed, Columns, Ordering>
//       :49-58   Dimensions / Columns / IndexSpan=32 / HasIndex
//       :67      enum {METADATA = 0, INDEX, LAST_HEADER_BLOCK_}
//       :69-79   DimensionsBlocksTotal + the dimension-struct list
//       :89-114  Metadata {size_, flags_}
//       :146-201 empty_size / base_size / compute_index_block_size /
//                compute_block_size (the RECURSIVE index pricing)
//       :65      using IndexType = MyType — the index is the RECURSIVE SELF-TYPE
//       :246-269 index() / has_index() / create_index() / remove_index()
//     packed_datatype_buffer_fse_tools.hpp
//       :35      FSE dimension Width = 1
//       :42-44   data_block_num() = DimensionsStart + Blocks*column + DataBlock
//                — THE slot formula
//       :56-67   empty_size_aligned() = 0, data_block_size(capacity)
//     packed_datatype_buffer_common_tools.hpp
//       :87-99   DimensionsListWidthBuilder — DimensionsBlocksTotal = Σ width
//     packed_datatype_buffer_so.hpp
//       :467-528 size/columns/span/access
//       :880-894 sum(column) / sum(column,row) / sum(column,start,end)
//       :1469-1493 find_{gt,ge}_fw_max — upper_bound / lower_bound
//       :1496-1573 find_{ge,gt}_fw_sum — the prefix-scan descent
//       :1496-1573 find_{ge,gt}_fw_sum — the index descent (P1)
//       :1599-1626 sum_sum — the index-accelerated prefix sum (P1)
//       :1649-1687 check_sum — index/content agreement (P1)
//       :1692-1737 reindex_sum — the recursive span index (P1)
//       :1387-1400 find_{gt,ge}_fw_sum(column, start, val) — the REBASE
//                  form: tgt = prefix(start) + val, answer sub_prefix'd (P2)
//       :1416-1460 find_{gt,ge}_bw_sum — the COMPLEMENT derivation, i.e.
//                  backward = forward at T - val with the strictness
//                  flipped. THE shape this rung mirrors (P2); the deleted
//                  flat-tree walk_index_bw is deliberately NOT mirrored.
//       :795-834  findGT/GE Forward/Backward — the public surface (P2)
//   containers/include/memoria/core/packed/tools/packed_allocator.hpp
//       :170-178 block_size(client_area, blocks) — our PkdAlloc::empty_size_for
//
// ── ORACLE DISCIPLINE ───────────────────────────────────────────────────────
// The C++ is a REFERENCE, NOT ground truth: the family it belongs to is
// dense with bugs (26 catalogued through rung P1, several in this very file
// pair), and the FQTree half of the lineage was deleted upstream WITHOUT
// ever being exercised by a test suite. Every behaviour below is DERIVED
// from the operation's semantics and gated by an independent materialized
// model plus algebraic laws (conuco tests/pdtbuf_core.logos); the C++
// fixtures are a divergence detector, not the definition of correct.
// Divergences we took deliberately are named DIVERGENCE below; upstream
// defects found by deriving rather than transcribing are numbered
// (#24 sum_gen suffix/prefix and #25 lossy capacity recovery from P0; #26
// find_*_fw_sum's index-miss short-circuit from P1 — see find_fw_sum; #27
// the val == 0 plateau class in the start-relative and backward SUM
// searches, found at THIS rung — see find_from and find_bw_sum). Each is
// pinned by a gate that fails if we adopt the C++ behaviour, so an upstream
// fix reports itself.
//
// ── P2: EVERY SEARCH IS THE ONE FORWARD DESCENT ─────────────────────────────
// The C++ carries four independent SUM search walks (forward, start-relative,
// backward, backward-from), and the deleted flat-tree half of this lineage
// carried four more; between them they hold most of the family's catalogued
// defects, because each walk re-derives boundary arithmetic on unsigned
// indices. This rung adds the four remaining forms and adds NO new walk:
// find_from is the forward descent at a SHIFTED target, find_bw_* is the
// forward descent at the COMPLEMENTED target with the strictness flipped,
// and the from-index backward form is that same thing over a shorter range.
// What the ladder buys by insisting on this:
//   * one loop is index-accelerated, so all six forms are — see hazard (b)
//     at find_bw_sum;
//   * there is no descending index walk, so the size_t-underflow class the
//     C++ backward walks live in (recon bugs #3, #4 — vacuous `start >= 0`
//     guards, `branch_end = (start & ~Mask) - 1` wrapping for start < 32)
//     cannot be expressed here at all;
//   * every not-found and boundary convention is derived once, in
//     find_fw_sum, and inherited — it cannot drift between directions.
// The two places the derivations are NOT mechanical are the val == 0 plateau
// clamps (bug #27, both faces) and the `start / 32` index clamp (bug #26, at
// a second site — hazard (a)); both are argued at their call sites and
// probed in conuco.
//
// ── SHAPE (general from line 1; ADR 0021 §1.2 placement rule) ───────────────
// Everything the C++ carries as TEMPLATE PARAMETERS is carried here as a
// RUNTIME DESCRIPTOR — `PdtDescr { dims: [PdtDim{kind, elem_size}], columns,
// ordering, indexed }` — and the descriptor is written INTO the block, so a
// handle is self-describing. No unrolled per-column fields, no per-config
// code: every loop runs over `columns` and over `dims`. This is the surface
// the eventual tier-1 PdtBuf metaprogram will INSTANTIATE (it generates the
// slot map, the accessor glue and the recursive index type; it does not
// re-derive these algorithms). The Bps-runtime precedent is logos.mem.pkd.sseq.
//
// Block layout (mirror of the C++ enum :67 + the slot formula :42-44):
//
//   slot 0                      METADATA  PdtMeta cell + the dims table (RAW)
//   slot 1                      INDEX     the recursive self-type (ALLOCATABLE)
//   slot 2 + dbt*col + dimoff   DATA      column-major dimension groups
//
//   dbt = dim_blocks_total = Σ pdt_dim_width(dim);  FSE width 1, VLE width 2.
//
// ── THE SPAN INDEX (P1; C++ `using IndexType = MyType` :65) ─────────────────
// The index is a PdtBuf carrying THE SAME DESCRIPTOR — same columns, same
// dimensions, same ordering, same `indexed` flag — over div_up(rows, 32)
// rows, nested in slot INDEX of its parent's own PkdAlloc. Index cell (c, k)
// holds the PER-SPAN PARTIAL sum Σ column c over rows [k*32, (k+1)*32) — NOT
// a prefix sum. Prefixes are recovered by summing index cells, which is the
// SAME query one level up, so the structure recurses until a level fits in a
// single span: a 32-ary tree of partial sums, general over depth AND over
// columns (every loop below runs over `columns`; there is no per-column or
// per-level code anywhere).
//
//   32769 rows → 1025 index cells → 33 → 2 → (2 <= 32, stop): 3 index levels.
//
// GEOMETRY vs CONTENT — the lockstep discipline. The index slot is sized from
// CAPACITY, the index CONTENT is keyed on SIZE, and mixing the two is how
// cells silently misalign. So the two are separated by construction:
//   * pdtbuf_reserve owns GEOMETRY. It prices the index slot at exactly
//     pdtbuf_index_block_size(descr, capacity), (re)formats the nested buffer
//     and reserves it to div_up(capacity, 32) rows — leaving it at SIZE 0.
//     Every reserve therefore leaves a well-defined EMPTY index, never a
//     stale one, and consumed == priced still holds byte-for-byte.
//   * pdtbuf_reindex owns CONTENT. It sets the index size to
//     div_up(size, 32), fills the cells, and recurses.
// A size-0 index is not a broken state: every query below degrades to the
// scan it would have done without an index, so "reserved but not reindexed"
// is SLOW, never WRONG.
//
// DIVERGENCE (index presence). The C++ keys index EXISTENCE on size — its
// reindex_sum (:1727/:1735) calls create_index()/remove_index() around the
// `size > IndexSpan` threshold — while compute_block_size (:186) prices the
// index from CAPACITY. The two disagree by construction, so the C++ block
// price is an over-estimate of what the block actually consumes, and the
// exact-prepare law P3 rests on cannot be stated there at all. We key
// existence on capacity (the same quantity that prices it) and let a
// below-threshold buffer carry a 0- or 1-cell index; the queries are correct
// either way (see the derivations at find_fw_sum / sum_prefix), and
// consumed == priced stays exact.
//
// ── EXACT-PREPARE CONTRACT (design_zero_copy_mutation_cow) ──────────────────
// P0 has no two-phase mutations, but its sizing functions ARE the pricing
// basis every later rung budgets against, so they are written to be exact,
// not conservative: `pdtbuf_compute_block_size(descr, capacity)` returns the
// byte total a buffer of that capacity occupies, and `pdtbuf_reserve` — the
// single fallible phase — consumes EXACTLY that many bytes. The law
//     pdtbuf_consumed_bytes(buf) == pdtbuf_compute_block_size(descr, capacity)
// is asserted by pdtbuf_check() and gated in conuco. P3 inherits it verbatim
// as `prepared_bytes == consumed_bytes`: an exact prepare makes commit
// infallible by construction, which is what lets the CoW clone BE the
// rollback buffer and removes the C++ copy-restore scratch entirely. The
// mutation surface that discharges it lives at "P3: the two-phase mutation
// surface" below, and every commit there ends in assert_consumed.
//
// ── LEDGER: axes NARROWED in P0 (recorded PAIR verdicts, not defaults) ──────
//   * cell width — u64 only (the typed accessors). The slot ARITHMETIC is
//     general over elem_size; only get/set/span pin 8 bytes.
//   * dimension kind — FSE implemented, VLE (width 2, offsets) is P4. The
//     descriptor, the width function and all slot math already carry kind,
//     so a VLE dim slots in without redesign.
//   * index — MATERIALIZED (P1), recursive and column-general. The P1
//     deferral of the targeted `_add`/`_sub` incremental update is CLOSED at
//     P3 (index_delta): a value replacement corrects one cell per level along
//     one path, while insert/remove/merge/split keep the full rebuild because
//     they shift the row->span mapping itself. MAX stays index-free BY
//     DESIGN — that is the has_index law, not a staging decision.
//   * capacity policy (P3) — CARRIED as an explicit runtime axis
//     (PDT_CAP_EXACT / PDT_CAP_KEEP), because "rows grew inside the paid-for
//     geometry" and "the geometry itself grew" are different budget questions
//     and the C++ FSE dimension cannot even ask the first one.
//   * mutation over VLE dimensions — NARROWED to P4 and REJECTED LOUDLY
//     (assert_fse_mutable), not approximated. The payload block prices as 0
//     today, so any VLE prepare would be inexact, and an inexact prepare with
//     a safety margin is precisely the copy-restore need coming back.
//   * optional-value column — a STATIC axis owned by the generator, not a
//     runtime flag (a runtime flag would be a dead branch on every access).
//     P0 merely does not preclude it: columns are uniform and addressed
//     through the formula, so a presence-bitmap column composes.
//   * ordering UNORDERED — accepted by the descriptor, search rejects it
//     (it is PkdArray; no ordering-bearing query is defined).
//   * direction (P2) — CARRIED, and carried as a derivation rather than as
//     an axis of code: forward, start-relative and backward are one descent.
//     NARROWED, recorded: the start-relative and backward forms are SUM-only.
//     That is not staging — it is the C++ surface's own reading (its `start`
//     overloads :800/:815 hardcode the SUM implementations, and its MAX
//     backward arms call member functions that do not exist, recon bug #9)
//     and it is what the semantics support: MAX has no accumulation, so
//     "the row where the running total reaches v, counting from here" is not
//     a question its ordering can answer. A MAX buffer's backward query IS
//     its forward bisection, which callers already have.
//   * op family (rank/select, EQ_NLT) — P5. The direction machinery this
//     rung lands is what those ops descend on, so they arrive as op-codes
//     over the same six entry points, not as further walks.
package logos.mem.pkd.pdtbuf;

use logos.mem.pkd;              // PkdAlloc, pkd_format, SlotKind, PkdError, round_up_bytes
use logos.lang.marker;          // Fst / StableLayout
use logos.lang.arith;           // wrapping_add / wrapping_sub (index deltas)
use logos.lang.result;
use logos.lang.panic;
use logos.lang.clone;
use logos.mem.collections.vec;

// ── the descriptor vocabulary ───────────────────────────────────────────────

/// Ordering policy (C++ `enum class DTOrdering` — core/datatypes/core.hpp:130).
/// Runtime u32 rather than a Logos enum because the value is STORED in the
/// block's metadata cell; the SSRLE op-code precedent (SSRLE_OP_*) is the
/// same choice for the same reason.
pub const PDT_ORD_SUM:       u32 = 0u32;
pub const PDT_ORD_MAX:       u32 = 1u32;
pub const PDT_ORD_UNORDERED: u32 = 2u32;

/// Dimension kind. FSE = one fixed-stride data block (C++ PDTDimension<const
/// T*> — fse_tools.hpp:27); VLE = data block + psize_t offsets table (P4).
pub const PDT_DIM_FSE: u32 = 0u32;
pub const PDT_DIM_VLE: u32 = 1u32;

/// C++ IndexSpan (packed_datatype_buffer.hpp:55): one index cell per 32 rows.
pub const PDT_INDEX_SPAN: u64 = 32u64;

/// Metadata flag bits (the C++ `flags_` field is write-only in the oracle;
/// we give it a meaning instead of dropping it — the descriptor has to
/// survive in-block for a handle to be self-describing).
pub const PDT_FLAG_INDEXED: u32 = 1u32;

/// One dimension of the datatype's physical decomposition. `elem_size` is
/// the FSE stride in bytes (VLE: the stride of the offsets' element type is
/// fixed at 4 — this field then carries the data-block element stride).
pub struct PdtDim {
    pub kind: u32,
    pub elem_size: u32,
}

impl Copy for PdtDim {}

impl Clone for PdtDim {
    fn clone(&self) -> PdtDim {
        return *self;
    }
}

/// An FSE dimension of `elem_size`-byte cells.
pub fn pdt_dim_fse(elem_size: u32) -> PdtDim {
    return PdtDim { kind: PDT_DIM_FSE, elem_size: elem_size };
}

/// A VLE dimension (P4): data block + offsets block.
pub fn pdt_dim_vle(elem_size: u32) -> PdtDim {
    return PdtDim { kind: PDT_DIM_VLE, elem_size: elem_size };
}

/// Allocator slots a dimension occupies (C++ PDTDimension::Width —
/// fse_tools.hpp:35 for FSE=1; the VLE dimension is the {data, offsets} pair).
pub fn pdt_dim_width(d: &PdtDim) -> u32 {
    if d.kind == PDT_DIM_VLE {
        return 2u32;
    }
    return 1u32;
}

/// Bytes the `sub`-th block of dimension `d` needs to hold `capacity` rows
/// (C++ PDTDimension::data_block_size — fse_tools.hpp:59-66: round_up_bytes
/// of capacity × sizeof(T)).
///
/// VLE (P4 hook, shaped now): sub 0 is the payload — its size is CONTENT
/// dependent, so it prices as 0 here and the P4 caller adds the encoded byte
/// count; sub 1 is the offsets table, exactly (capacity+1) psize_t cells.
pub fn pdt_dim_block_size(d: &PdtDim, sub: u32, capacity: u64) -> u32 {
    if d.kind == PDT_DIM_VLE {
        if sub == 0u32 {
            return 0u32;
        }
        return round_up_bytes(((capacity + 1u64) * 4u64) as u32);
    }
    return round_up_bytes((capacity * (d.elem_size as u64)) as u32);
}

/// The runtime descriptor: what the C++ spells as template parameters
/// `<DataType, Indexed, Columns, Ordering>` plus the datatype's dimension
/// decomposition. Lives OUT of block (sizing happens before the block
/// exists) and is written INTO the block by pdtbuf_format.
pub struct PdtDescr {
    pub dims: Vec<PdtDim>,
    pub columns: u32,
    pub ordering: u32,
    pub indexed: bool,
}

/// A descriptor with no dimensions yet — push them in physical order.
pub fn pdt_descr_new(columns: u32, ordering: u32, indexed: bool) -> PdtDescr {
    return PdtDescr {
        dims: vec_new::<PdtDim>(),
        columns: columns,
        ordering: ordering,
        indexed: indexed,
    };
}

/// The single-FSE-dimension descriptor: the shape every arithmetic datatype
/// takes (C++ DataDimensionsList = TL<const T*> — traits.hpp:199).
pub fn pdt_descr_fse(columns: u32, elem_size: u32, ordering: u32, indexed: bool) -> PdtDescr {
    let mut d: PdtDescr = pdt_descr_new(columns, ordering, indexed);
    d.dims.push(pdt_dim_fse(elem_size));
    return d;
}

impl PdtDescr {
    pub fn dim_count(self: &PdtDescr) -> u32 {
        return self.dims.length() as u32;
    }

    /// C++ DimensionsBlocksTotal (common_tools.hpp:87-99): Σ of dimension widths.
    pub fn dim_blocks_total(self: &PdtDescr) -> u32 {
        let n: i64 = self.dims.length();
        let mut total: u32 = 0u32;
        let mut i: i64 = 0i64;
        while i < n {
            let d: &PdtDim = self.dims.borrow(i);
            total = total + pdt_dim_width(d);
            i = i + 1i64;
        }
        return total;
    }

    /// Allocator slot count: LAST_HEADER_BLOCK_ + dbt × columns
    /// (packed_datatype_buffer.hpp:162).
    pub fn slots(self: &PdtDescr) -> u32 {
        return PDT_LAST_HEADER_BLOCK + self.dim_blocks_total() * self.columns;
    }

    /// The first allocator slot of dimension `dim` inside a column's group
    /// (the running `DataBlock` offset the C++ dimension list builder folds
    /// into each PDTDimension instantiation).
    pub fn dim_block_offset(self: &PdtDescr, dim: u32) -> u32 {
        let mut off: u32 = 0u32;
        let mut i: i64 = 0i64;
        while i < (dim as i64) {
            let d: &PdtDim = self.dims.borrow(i);
            off = off + pdt_dim_width(d);
            i = i + 1i64;
        }
        return off;
    }

    /// C++ HasIndex (packed_datatype_buffer.hpp:57): an index exists only for
    /// SUM ordering over an arithmetic datatype. `indexed` is our spelling of
    /// the arithmetic half (the datatype glue decides it); the ordering half
    /// is a law, not a configuration.
    pub fn has_index(self: &PdtDescr) -> bool {
        return self.indexed && self.ordering == PDT_ORD_SUM;
    }
}

/// C++ enum {METADATA = 0, INDEX, LAST_HEADER_BLOCK_} (packed_datatype_buffer.hpp:67).
pub const PDT_SLOT_METADATA:     u32 = 0u32;
pub const PDT_SLOT_INDEX:        u32 = 1u32;
pub const PDT_LAST_HEADER_BLOCK: u32 = 2u32;

// ── in-block metadata ───────────────────────────────────────────────────────

/// The METADATA cell. C++ Metadata (packed_datatype_buffer.hpp:89-114) holds
/// {size_, flags_} only and re-derives everything else from template
/// parameters; a runtime-descriptor port must persist the descriptor.
///
/// DIVERGENCE (`capacity`): the C++ recovers capacity by dividing a data
/// block's byte size by sizeof(T). That is LOSSY whenever elem_size does not
/// divide the 8-byte allocation granule (round_up_bytes(3×4)/4 = 4 ≠ 3), so
/// capacity is stored. It is also what makes the exact-prepare law checkable.
pub struct PdtMeta {
    pub size: u32,
    pub capacity: u32,
    pub columns: u32,
    pub ordering: u32,
    pub dim_count: u32,
    pub dim_blocks_total: u32,
    pub flags: u32,
    pub pad: u32,
}

impl Copy for PdtMeta {}

impl Clone for PdtMeta {
    fn clone(&self) -> PdtMeta {
        return *self;
    }
}

/// Bytes of the METADATA slot: the fixed header followed by the dims table.
/// (PdtDim is 8 bytes, so the table needs no interior padding.)
pub fn pdt_meta_bytes(dim_count: u32) -> u32 {
    return round_up_bytes(sizeof::<PdtMeta>() as u32)
        + round_up_bytes(dim_count * (sizeof::<PdtDim>() as u32));
}

// ── sizing (C++ empty_size :146 / base_size :155 / compute_block_size :186) ──

/// Block bytes for an EMPTY buffer: allocator header/layout/bitmap for all
/// slots plus the metadata cell. (The FSE dimension's empty_size_aligned() is
/// 0 — fse_tools.hpp:56 — so no data bytes are reserved.)
pub fn pdtbuf_empty_size(descr: &PdtDescr) -> u32 {
    return PkdAlloc::empty_size_for(descr.slots()) + pdt_meta_bytes(descr.dim_count());
}

/// Index cells covering `rows` parent rows: one cell per span, last one
/// partial (C++ div_up(size, IndexSpan) — so.hpp:1660/:1699).
pub fn pdtbuf_span_count(rows: u64) -> u64 {
    return (rows + PDT_INDEX_SPAN - 1u64) / PDT_INDEX_SPAN;
}

/// The recursive index pricing hook (C++ compute_block_size :186-201 inlines
/// exactly this recursion: the index IS a buffer of the same type over
/// div_up(capacity, IndexSpan) rows).
///
/// The recursion terminates because div_up(c, 32) < c for every c >= 2, and
/// the arm is skipped entirely at c <= 32 — so a buffer of capacity c carries
/// ceil(log32 c) - 1 index levels above it.
pub fn pdtbuf_index_block_size(descr: &PdtDescr, capacity: u64) -> u32 {
    if !descr.has_index() {
        return 0u32;
    }
    if capacity <= PDT_INDEX_SPAN {
        return 0u32;
    }
    return pdtbuf_compute_block_size(descr, pdtbuf_span_count(capacity));
}

/// Bytes a buffer holding `capacity` rows occupies, index included — THE
/// pricing function (C++ compute_block_size :186). Every fallible resize in
/// pdtbuf_reserve is covered by it EXACTLY, not conservatively; see the
/// exact-prepare contract in the module header.
pub fn pdtbuf_compute_block_size(descr: &PdtDescr, capacity: u64) -> u32 {
    let mut data: u32 = 0u32;
    let n: i64 = descr.dims.length();
    let mut i: i64 = 0i64;
    while i < n {
        let d: &PdtDim = descr.dims.borrow(i);
        let w: u32 = pdt_dim_width(d);
        let mut sub: u32 = 0u32;
        while sub < w {
            data = data + pdt_dim_block_size(d, sub, capacity);
            sub = sub + 1u32;
        }
        i = i + 1i64;
    }
    return pdtbuf_empty_size(descr)
        + data * descr.columns
        + pdtbuf_index_block_size(descr, capacity);
}

// ── search results ──────────────────────────────────────────────────────────

/// C++ FindResult (packed_datatype_buffer_so.hpp:114-147 for SUM, :65-82 for
/// MAX). `idx` = the hit row, `prefix` = the exclusive prefix sum accumulated
/// before it (0 for MAX ordering, which has no prefix notion — the C++ MAX
/// FindResult::prefix() likewise returns a default-constructed value).
///
/// NOT-FOUND convention (DERIVED, and it happens to agree with the C++
/// :1479/:1492/:1532/:1572): idx = size (one past the last row), prefix =
/// the total of the scanned column. Deriving it rather than copying matters
/// because it is exactly the class of convention the deleted-untested half of
/// this C++ lineage got wrong; the laws in conuco pin it independently
/// (find_ge(total) is a hit, find_gt(total) is not, and both agree with the
/// naive model).
pub struct PdtFind {
    pub idx: u64,
    pub prefix: u64,
}

impl Copy for PdtFind {}

impl Clone for PdtFind {
    fn clone(&self) -> PdtFind {
        return *self;
    }
}

// ── the update state (P3) ───────────────────────────────────────────────────

/// Which mutation an update state describes. Carried so a commit can assert
/// it was handed the state its OWN prepare produced — the C++ UpdateState is
/// op-agnostic and its commits trust the caller (`commit_remove(idx, size,
/// ss)` at :1138 constructs a default-initialised state on the spot).
pub const PDT_OP_INSERT: u32 = 0u32;
pub const PDT_OP_UPDATE: u32 = 1u32;
pub const PDT_OP_REMOVE: u32 = 2u32;
pub const PDT_OP_MERGE:  u32 = 3u32;
pub const PDT_OP_SPLIT:  u32 = 4u32;

/// Capacity policy — the axis that makes GAP (b) expressible (see the P3
/// contract in PdtBuf). EXACT tracks the row count byte for byte (bytes come
/// back on a shrink: the btree-node reading); KEEP honours an explicit
/// reservation, so rows may grow INSIDE the geometry at zero cost.
pub const PDT_CAP_EXACT: u32 = 0u32;
pub const PDT_CAP_KEEP:  u32 = 1u32;

/// The planned mutation and its BUDGET — the C++ UpdateState (so.hpp:343,
/// `PkdStructEmptyUpdate`, which carries only the shared allocator state's
/// allocated_/available_ pair) plus everything needed to make the commit
/// infallible AND checkable.
///
/// `prepared_bytes` is the whole POINT of the structure: it is
/// pdtbuf_compute_block_size(descr, new_capacity), evaluated before anything
/// is touched, and after the commit it must equal consumed_bytes() EXACTLY.
/// The `before_bytes`/`prepared_bytes` pair also states the budget in the
/// form the allocator understands, and their difference is what separates
/// "rows grew inside the capacity" (zero) from "the capacity itself grew".
pub struct PdtUpdate {
    pub op: u32,
    pub policy: u32,
    pub at: u64,
    pub count: u64,
    pub old_size: u64,
    pub new_size: u64,
    pub old_capacity: u64,
    pub new_capacity: u64,
    pub before_bytes: u32,
    pub prepared_bytes: u32,
}

impl Copy for PdtUpdate {}

impl Clone for PdtUpdate {
    fn clone(&self) -> PdtUpdate {
        return *self;
    }
}

impl PdtUpdate {
    /// Bytes the commit will ADD to the block (0 when the rows fit the
    /// capacity already, which is the whole of GAP (b)'s first case).
    pub fn grow_bytes(self: &PdtUpdate) -> u32 {
        if self.prepared_bytes <= self.before_bytes {
            return 0u32;
        }
        return self.prepared_bytes - self.before_bytes;
    }

    /// Bytes the commit will RELEASE back to the allocator.
    pub fn shrink_bytes(self: &PdtUpdate) -> u32 {
        if self.before_bytes <= self.prepared_bytes {
            return 0u32;
        }
        return self.before_bytes - self.prepared_bytes;
    }

    /// Does this plan leave the block geometry alone? True exactly when the
    /// rows move within the capacity that is already paid for.
    pub fn is_free(self: &PdtUpdate) -> bool {
        return self.new_capacity == self.old_capacity;
    }
}

/// The two budgets of a split — one verdict over both. `left` shrinks (and so
/// cannot fail), `right` grows (and so is the one that can).
pub struct PdtSplit {
    pub left: PdtUpdate,
    pub right: PdtUpdate,
}

impl Copy for PdtSplit {}

impl Clone for PdtSplit {
    fn clone(&self) -> PdtSplit {
        return *self;
    }
}

// ── the packed handle ───────────────────────────────────────────────────────

/// Non-owning handle over a formatted PdtBuf block (the VecCtr idiom of
/// sseq.logos: views are re-resolved through the allocator on every call —
/// a nested buffer's payload shifts when sibling slots resize).
pub struct PdtBuf {
    mem: *mut u8,
}

impl Copy for PdtBuf {}

impl Clone for PdtBuf {
    fn clone(&self) -> PdtBuf {
        return *self;
    }
}

/// Formats `mem[0..block_size)` as an EMPTY buffer carrying `descr`
/// (C++ init() — packed_datatype_buffer.hpp:207-220). All data slots are
/// stamped RAW at zero size, and so is INDEX: a zero-capacity buffer is below
/// the span threshold, so it has no index to carry (C++ has_index() is
/// likewise `!is_empty(INDEX)` :253). reserve() stamps INDEX Allocatable and
/// materializes the recursive self-type there once capacity exceeds the span.
pub unsafe fn pdtbuf_format(mem: *mut u8, block_size: u32, descr: &PdtDescr)
    -> Result<PdtBuf, PkdError> {
    assert(descr.columns > 0u32, "pdtbuf_format: columns must be >= 1");
    assert(descr.dim_count() > 0u32, "pdtbuf_format: at least one dimension");
    let slots: u32 = descr.slots();
    // PkdAlloc's bitmap is one u64 word — the substrate caps slot count at 64.
    assert(slots <= 64u32, "pdtbuf_format: slot count exceeds the PkdAlloc bitmap word");
    let a: *mut PkdAlloc = pkd_format(mem, block_size, slots);
    let dim_count: u32 = descr.dim_count();
    a.allocate(PDT_SLOT_METADATA, pdt_meta_bytes(dim_count), SlotKind::Raw)?;
    let mut flags: u32 = 0u32;
    if descr.indexed {
        flags = flags | PDT_FLAG_INDEXED;
    }
    let m: *mut PdtMeta = a.get::<PdtMeta>(PDT_SLOT_METADATA);
    *m = PdtMeta {
        size: 0u32,
        capacity: 0u32,
        columns: descr.columns,
        ordering: descr.ordering,
        dim_count: dim_count,
        dim_blocks_total: descr.dim_blocks_total(),
        flags: flags,
        pad: 0u32,
    };
    let table: *mut PdtDim = pdt_dims_table(a);
    let mut i: i64 = 0i64;
    while i < (dim_count as i64) {
        *table.add(i as u32) = *descr.dims.borrow(i);
        i = i + 1i64;
    }
    a.set_block_type(PDT_SLOT_INDEX, SlotKind::Raw);
    let mut s: u32 = PDT_LAST_HEADER_BLOCK;
    while s < slots {
        a.set_block_type(s, SlotKind::Raw);
        s = s + 1u32;
    }
    return Result::Ok(PdtBuf { mem: mem });
}

// The dims table lives in the METADATA slot right behind the fixed header.
unsafe fn pdt_dims_table(a: *mut PkdAlloc) -> *mut PdtDim {
    let base: *mut u8 = a.get::<u8>(PDT_SLOT_METADATA);
    return base.byte_add(round_up_bytes(sizeof::<PdtMeta>() as u32)) as *mut PdtDim;
}

/// Re-adopt an already formatted block as a handle (the sseq
/// pkd_ssrle_adopt idiom: a consumer embedding a PdtBuf inside a larger
/// PkdAlloc must re-resolve from the slot address after neighbouring slots
/// resize, never cache the handle across a mutation).
pub unsafe fn pdtbuf_adopt(mem: *mut u8) -> PdtBuf {
    return PdtBuf { mem: mem };
}

/// format + reserve + set_size in one step: a zero-filled buffer of `rows`
/// rows, ready for set(). The P0 creation path (P3 replaces the "fill by
/// set()" half with two-phase insert; the geometry below is unchanged).
pub unsafe fn pdtbuf_create(mem: *mut u8, block_size: u32, descr: &PdtDescr, rows: u64)
    -> Result<PdtBuf, PkdError> {
    let mut b: PdtBuf = pdtbuf_format(mem, block_size, descr)?;
    match b.reserve(rows) {
        Result::Ok(_) => {}
        Result::Err(e) => {
            return Result::Err(e);
        }
    }
    b.set_size(rows);
    return Result::Ok(b);
}

impl PdtBuf {
    // ── views (re-resolved per call; never cached) ────────────────────────

    fn alc(self: &PdtBuf) -> *mut PkdAlloc {
        return self.mem as *mut PkdAlloc;
    }

    unsafe fn meta(self: &PdtBuf) -> *mut PdtMeta {
        return self.alc().get::<PdtMeta>(PDT_SLOT_METADATA);
    }

    // ── descriptor read-back (the block is self-describing) ───────────────

    /// Logical row count (C++ SO size() :467).
    pub fn size(self: &PdtBuf) -> u64 {
        unsafe {
            return (*self.meta()).size as u64;
        }
    }

    /// Rows the data blocks are sized for (see the PdtMeta capacity divergence).
    pub fn capacity(self: &PdtBuf) -> u64 {
        unsafe {
            return (*self.meta()).capacity as u64;
        }
    }

    /// C++ SO columns() :471 — a runtime field here, a template parameter there.
    pub fn columns(self: &PdtBuf) -> u32 {
        unsafe {
            return (*self.meta()).columns;
        }
    }

    pub fn ordering(self: &PdtBuf) -> u32 {
        unsafe {
            return (*self.meta()).ordering;
        }
    }

    pub fn dim_count(self: &PdtBuf) -> u32 {
        unsafe {
            return (*self.meta()).dim_count;
        }
    }

    pub fn dim_blocks_total(self: &PdtBuf) -> u32 {
        unsafe {
            return (*self.meta()).dim_blocks_total;
        }
    }

    pub fn dim_at(self: &PdtBuf, dim: u32) -> PdtDim {
        assert(dim < self.dim_count(), "PdtBuf::dim_at: dimension out of range");
        unsafe {
            return *pdt_dims_table(self.alc()).add(dim);
        }
    }

    /// Does this buffer carry a MATERIALIZED span index? Three conjuncts, and
    /// each is load-bearing:
    ///   * the descriptor flag — our spelling of the C++ HasIndex's
    ///     `DataTypeTraits<DataType>::isArithmetic` half (:57), decided by the
    ///     datatype glue;
    ///   * SUM ordering — a LAW, not a configuration (the other half of :57).
    ///     MAX is index-free by design: its column is sorted, so its descent
    ///     is a bisection and a partial-sum index would answer no question it
    ///     asks;
    ///   * a NON-EMPTY index slot — the geometry half, exactly the C++
    ///     has_index() (`!is_empty(INDEX)`, :253), established by reserve().
    pub fn has_index(self: &PdtBuf) -> bool {
        unsafe {
            let flagged: bool = ((*self.meta()).flags & PDT_FLAG_INDEXED) != 0u32;
            if !flagged {
                return false;
            }
            if (*self.meta()).ordering != PDT_ORD_SUM {
                return false;
            }
            return self.alc().element_size(PDT_SLOT_INDEX) > 0u32;
        }
    }

    /// The nested span index — the RECURSIVE SELF-TYPE (C++ index() :246).
    /// RE-RESOLVED from the slot address on every call and never cached: the
    /// index payload SHIFTS whenever a sibling slot resizes, and the nested
    /// allocator's back-reference is healed at that moment by the allocator's
    /// bitmap walk. This is the pkd_ssrle_adopt idiom of sseq.logos, and the
    /// reason index() returns a fresh handle instead of storing one.
    pub fn index(self: &PdtBuf) -> PdtBuf {
        assert(self.has_index(), "PdtBuf::index: no index is materialized");
        unsafe {
            return pdtbuf_adopt(self.alc().get::<u8>(PDT_SLOT_INDEX));
        }
    }

    /// Index levels above this buffer (0 = index-free). Diagnostic: the gate
    /// asserts a genuinely MULTI-level tree gets built at deep sizes, so that
    /// "recursive" is a tested property and not a comment.
    pub fn index_levels(self: &PdtBuf) -> u32 {
        if !self.has_index() {
            return 0u32;
        }
        return 1u32 + self.index().index_levels();
    }

    /// Reconstruct the out-of-block descriptor from the block itself.
    pub fn descr(self: &PdtBuf) -> PdtDescr {
        let mut indexed: bool = false;
        unsafe {
            indexed = ((*self.meta()).flags & PDT_FLAG_INDEXED) != 0u32;
        }
        let mut d: PdtDescr = pdt_descr_new(self.columns(), self.ordering(), indexed);
        let n: u32 = self.dim_count();
        let mut i: u32 = 0u32;
        while i < n {
            d.dims.push(self.dim_at(i));
            i = i + 1u32;
        }
        return d;
    }

    // ── slot geometry (C++ data_block_num — fse_tools.hpp:42-44) ──────────

    /// The first slot of dimension `dim` within a column group.
    pub fn dim_block_offset(self: &PdtBuf, dim: u32) -> u32 {
        let mut off: u32 = 0u32;
        let mut i: u32 = 0u32;
        while i < dim {
            let d: PdtDim = self.dim_at(i);
            off = off + pdt_dim_width(&d);
            i = i + 1u32;
        }
        return off;
    }

    /// THE slot formula, verbatim from the C++:
    ///     block = LAST_HEADER_BLOCK_ + DimensionsBlocksTotal*column + DataBlock
    /// General over columns and dimensions — there is no per-column special
    /// case anywhere in this module, and the ≥3-column canary in conuco
    /// exists to keep it that way.
    pub fn block_of(self: &PdtBuf, column: u32, dim: u32, sub: u32) -> u32 {
        assert(column < self.columns(), "PdtBuf::block_of: column out of range");
        return PDT_LAST_HEADER_BLOCK
            + self.dim_blocks_total() * column
            + self.dim_block_offset(dim)
            + sub;
    }

    // ── sizing / capacity ─────────────────────────────────────────────────

    /// Bytes this buffer's allocator has handed out to its slots — the
    /// CONSUMED side of the exact-prepare law (the PREPARED side is
    /// pdtbuf_compute_block_size).
    pub fn consumed_bytes(self: &PdtBuf) -> u32 {
        unsafe {
            let a: *mut PkdAlloc = self.alc();
            return PkdAlloc::empty_size_for(a.elements()) + a.allocated();
        }
    }

    /// The whole block this buffer occupies, byte for byte — the CoW clone's
    /// unit and, at the gate, the substrate of the failed-prepare
    /// byte-identity law. `block_bytes` is what the allocator believes it
    /// owns; everything past `consumed_bytes()` inside it is free tail.
    ///
    /// Copying [block_ptr, block_ptr + block_bytes) produces a VALID
    /// independent buffer: every back-reference in the packed family is
    /// SELF-RELATIVE (PkdAllocatable::alc_off), so a flat byte copy needs no
    /// pointer fixing. That is what makes the CoW clone free — and it is the
    /// same property the store layer will rely on at P7.
    pub unsafe fn block_ptr(self: &PdtBuf) -> *mut u8 {
        return self.mem;
    }

    pub fn block_bytes(self: &PdtBuf) -> u32 {
        unsafe {
            return self.alc().block_size();
        }
    }

    /// Sizes every data block AND the index slot for `capacity` rows. THE
    /// fallible phase: on success the buffer has consumed exactly
    /// pdtbuf_compute_block_size(descr, capacity) bytes; on failure it is
    /// left at its previous capacity, untouched (every byte is probed before
    /// the first resize).
    ///
    /// Owns index GEOMETRY only: the nested index is (re)formatted and
    /// reserved to div_up(capacity, 32) rows at SIZE 0. Content is
    /// pdtbuf_reindex's job — see the header's geometry/content split. Every
    /// query is correct against an empty index, so the intermediate state is
    /// slow, not wrong.
    ///
    /// DERIVED FIX (the probe). P0 probed each block INDEPENDENTLY against
    /// the same unchanged free space, which answers "does the largest single
    /// grow fit", not "do all the grows fit". It could not fail in practice
    /// because every caller allocates exactly pdtbuf_compute_block_size — but
    /// an under-probe is precisely the defect the exact-prepare law exists to
    /// forbid, and P3 budgets against this function. The probe is now
    /// CUMULATIVE: sum the wanted bytes, sum the held bytes, and ask the
    /// allocator chain once for the difference.
    pub fn reserve(self: &mut PdtBuf, capacity: u64) -> Result<u32, PkdError> {
        let cols: u32 = self.columns();
        let dims: u32 = self.dim_count();
        let descr: PdtDescr = self.descr();
        let want_index: u32 = pdtbuf_index_block_size(&descr, capacity);
        unsafe {
            let a: *mut PkdAlloc = self.alc();
            // ── probe, cumulatively ───────────────────────────────────────
            let mut want_total: u32 = want_index;
            let mut have_total: u32 = a.element_size(PDT_SLOT_INDEX);
            let mut c: u32 = 0u32;
            while c < cols {
                let mut i: u32 = 0u32;
                while i < dims {
                    let d: PdtDim = self.dim_at(i);
                    let w: u32 = pdt_dim_width(&d);
                    let mut sub: u32 = 0u32;
                    while sub < w {
                        let blk: u32 = self.block_of(c, i, sub);
                        want_total = want_total
                            + round_up_bytes(pdt_dim_block_size(&d, sub, capacity));
                        have_total = have_total + a.element_size(blk);
                        sub = sub + 1u32;
                    }
                    i = i + 1u32;
                }
                c = c + 1u32;
            }
            if want_total > have_total {
                // Ask the whole parent chain for the WHOLE deficit in one
                // question, phrased against a real slot (try_allocation walks
                // the chain without mutating anything).
                let dlast: PdtDim = self.dim_at(dims - 1u32);
                let probe: u32 = self.block_of(cols - 1u32, dims - 1u32,
                                               pdt_dim_width(&dlast) - 1u32);
                let need: u32 = a.element_size(probe) + (want_total - have_total);
                if !a.try_allocation(probe, need) {
                    return Result::Err(PkdError::OutOfMem);
                }
            }
            // ── apply: shrinks first, then grows ──────────────────────────
            // Releasing space before asking for it keeps the peak demand at
            // the priced total, never above it. The INDEX slot rides the same
            // discipline as a data block.
            let mut pass: u32 = 0u32;
            while pass < 2u32 {
                let have_i: u32 = a.element_size(PDT_SLOT_INDEX);
                if want_index != have_i && (pass == 0u32) == (want_index < have_i) {
                    if want_index == 0u32 {
                        a.free_at(PDT_SLOT_INDEX);
                        a.set_block_type(PDT_SLOT_INDEX, SlotKind::Raw);
                    } else {
                        match a.resize_block_at(PDT_SLOT_INDEX, want_index) {
                            Result::Ok(_) => {}
                            Result::Err(e) => {
                                return Result::Err(e);
                            }
                        }
                    }
                }
                let mut c2: u32 = 0u32;
                while c2 < cols {
                    let mut i2: u32 = 0u32;
                    while i2 < dims {
                        let d2: PdtDim = self.dim_at(i2);
                        let w2: u32 = pdt_dim_width(&d2);
                        let mut sub2: u32 = 0u32;
                        while sub2 < w2 {
                            let blk2: u32 = self.block_of(c2, i2, sub2);
                            let want2: u32 = pdt_dim_block_size(&d2, sub2, capacity);
                            let have2: u32 = a.element_size(blk2);
                            let shrinking: bool = want2 < have2;
                            if (pass == 0u32) == shrinking && want2 != have2 {
                                match a.resize_block_at(blk2, want2) {
                                    Result::Ok(_) => {}
                                    Result::Err(e) => {
                                        return Result::Err(e);
                                    }
                                }
                            }
                            sub2 = sub2 + 1u32;
                        }
                        i2 = i2 + 1u32;
                    }
                    c2 = c2 + 1u32;
                }
                pass = pass + 1u32;
            }
            // ── (re)establish the nested index ────────────────────────────
            // Unconditional re-format: it is the only way to guarantee that a
            // reserve never leaves index CONTENT that no longer describes the
            // rows. The slot is stamped ALLOCATABLE first, so a later sibling
            // resize heals the nested allocator's back-reference (btfl's
            // leaf-symbol slot is the same idiom, one nesting level up).
            if want_index > 0u32 {
                a.set_block_type(PDT_SLOT_INDEX, SlotKind::Allocatable);
                let p: *mut u8 = a.get::<u8>(PDT_SLOT_INDEX);
                let bsz: u32 = a.element_size(PDT_SLOT_INDEX);
                match pdtbuf_format(p, bsz, &descr) {
                    Result::Ok(_) => {}
                    Result::Err(e) => {
                        return Result::Err(e);
                    }
                }
                let inner: *mut PkdAlloc = p as *mut PkdAlloc;
                inner.set_allocator(a as *const PkdAlloc);
                let mut ib: PdtBuf = pdtbuf_adopt(p);
                // Exact by construction: bsz was priced as
                // pdtbuf_compute_block_size(descr, spans), which is precisely
                // what a buffer of that capacity consumes — so this recursive
                // reserve never has to enlarge through the parent, and the
                // nested block ends with ZERO free space. Any drift here
                // shows up immediately as check() code 6 or 7.
                match ib.reserve(pdtbuf_span_count(capacity)) {
                    Result::Ok(_) => {}
                    Result::Err(e) => {
                        return Result::Err(e);
                    }
                }
            }
            (*self.meta()).capacity = capacity as u32;
            if (*self.meta()).size > (capacity as u32) {
                (*self.meta()).size = capacity as u32;
            }
        }
        return Result::Ok(self.consumed_bytes());
    }

    // ── the span index: content ───────────────────────────────────────────

    /// Rebuilds the span index from the live rows (C++ reindex_sum :1692).
    ///
    /// Index cell (column, k) = Σ column over rows [k*32, min((k+1)*32,
    /// size)) — PER-SPAN PARTIAL sums, NOT prefix sums. The distinction is
    /// the whole design: a prefix-sum index would have to be rewritten from
    /// the mutation point to the end on every insert, and — the reason it
    /// composes at all — a partial-sum index is ITSELF a sequence whose
    /// prefix query is the SAME query one level up, which is what makes the
    /// recursion below a fixed point rather than a special case.
    ///
    /// FULL rebuild (a recorded NARROWING). The C++ also carries targeted
    /// `_add`/`_sub` incremental updates; those belong with the P3 two-phase
    /// mutations that would drive them, and adding them here would be an
    /// untested path with no caller.
    pub fn reindex(self: &mut PdtBuf) {
        if !self.has_index() {
            return;
        }
        let n: u64 = self.size();
        let spans: u64 = pdtbuf_span_count(n);
        let cols: u32 = self.columns();
        let mut ix: PdtBuf = self.index();
        // Fits by construction: spans = div_up(size, 32) <= div_up(capacity,
        // 32) = the index capacity reserve() bought. This is the lockstep the
        // C++ loses by sizing the index slot from `size` while pricing it
        // from `capacity`.
        ix.set_size(spans);
        let mut c: u32 = 0u32;
        while c < cols {
            let mut s: u64 = 0u64;
            while s < spans {
                let base: u64 = s * PDT_INDEX_SPAN;
                let mut limit: u64 = base + PDT_INDEX_SPAN;
                if limit > n {
                    limit = n;
                }
                let acc: u64 = self.scan_range(c, base, limit);
                ix.set(c, s, acc);
                s = s + 1u64;
            }
            c = c + 1u32;
        }
        // The index is a PdtBuf: it indexes ITSELF, by the same rule, until a
        // level fits in one span. That is the 32-ary tree.
        ix.reindex();
    }

    /// Publishes `n` rows as live. INFALLIBLE by contract — the bytes were
    /// bought by reserve(); asking for more than capacity is a caller bug.
    pub fn set_size(self: &mut PdtBuf, n: u64) {
        assert(n <= self.capacity(), "PdtBuf::set_size: size exceeds reserved capacity");
        unsafe {
            (*self.meta()).size = n as u32;
        }
    }

    // ── cell access ───────────────────────────────────────────────────────

    /// Byte address of cell (column, row) in dimension `dim`. The GENERAL
    /// accessor: stride comes from the descriptor, so it is correct for any
    /// elem_size. The u64 accessors below are the narrowed exercise.
    pub unsafe fn cell_ptr(self: &PdtBuf, column: u32, dim: u32, row: u64) -> *mut u8 {
        let d: PdtDim = self.dim_at(dim);
        assert(d.kind == PDT_DIM_FSE, "PdtBuf::cell_ptr: VLE dimensions are P4");
        let blk: u32 = self.block_of(column, dim, 0u32);
        let base: *mut u8 = self.alc().get::<u8>(blk);
        return base.byte_add((row * (d.elem_size as u64)) as i64);
    }

    /// Column `column` of dimension 0 as a u64 slice of `size()` cells
    /// (C++ SO span(column) :480 — the FSE direct view).
    pub fn values(self: &PdtBuf, column: u32) -> &[u64] {
        let d: PdtDim = self.dim_at(0u32);
        assert(d.elem_size == 8u32, "PdtBuf::values: P0 narrows cells to u64");
        let blk: u32 = self.block_of(column, 0u32, 0u32);
        unsafe {
            return self.alc().cells::<u64>(blk);
        }
    }

    /// Value at (column, row) (C++ SO access(column,row) :495).
    pub fn get(self: &PdtBuf, column: u32, row: u64) -> u64 {
        assert(row < self.size(), "PdtBuf::get: row out of range");
        return self.values(column)[row as i64];
    }

    /// Writes (column, row). No resize, no reindex — the P0 fill path.
    pub fn set(self: &mut PdtBuf, column: u32, row: u64, v: u64) {
        assert(row < self.size(), "PdtBuf::set: row out of range");
        let d: PdtDim = self.dim_at(0u32);
        assert(d.elem_size == 8u32, "PdtBuf::set: P0 narrows cells to u64");
        let blk: u32 = self.block_of(column, 0u32, 0u32);
        unsafe {
            let base: *mut u64 = self.alc().get::<u64>(blk);
            *base.add(row as u32) = v;
        }
    }

    /// Fills row `row` across ALL columns from a per-column callback-free
    /// vector (the general shape: no per-column unrolling at any call site).
    pub fn set_row(self: &mut PdtBuf, row: u64, vals: &Vec<u64>) {
        let cols: u32 = self.columns();
        assert(vals.length() == (cols as i64), "PdtBuf::set_row: value count != columns");
        let mut c: u32 = 0u32;
        while c < cols {
            self.set(c, row, vals.get(c as i64));
            c = c + 1u32;
        }
    }

    // ── SUM ordering: prefix sums ─────────────────────────────────────────

    /// Exclusive prefix sum over rows [0, row) of `column`
    /// (C++ SO sum(column, row) :884 → sum_sum :1599).
    ///
    /// DIVERGENCE (derived, not copied): the C++ dispatches this through
    /// PkdDTBufOrderingDispatcher, and its non-SUM arm `sum_gen` (:1577)
    /// sums [idx, size) — a SUFFIX. That makes the very next function,
    /// `sum(column, start, end) = sum(end) - sum(start)` (:889), silently
    /// wrong for MAX/UNORDERED buffers (it computes the negation of the
    /// range). Prefix semantics are the only reading under which the
    /// documented identity holds, so prefix is what we implement for EVERY
    /// ordering. Upstream bug candidate.
    ///
    /// INDEXED (C++ sum_sum :1599): the index's own prefix over whole spans
    /// carries the answer up to the last span boundary at or below `row`, and
    /// only the < 32-row remainder is scanned. The index call is the SAME
    /// function on the index buffer, so the cost is 32 adds per level.
    ///
    /// DERIVED GUARD. The C++ computes `span = idx / index_span()` and
    /// indexes the index with it unchecked. That is safe only for an index
    /// whose size is exactly div_up(size, 32); against an index that covers
    /// FEWER spans — which is exactly the state its own create_index() leaves
    /// behind before insert_from_fn fills it — it reads past the index's live
    /// rows. Clamping `span` to the index size makes an under-covering index
    /// cost a longer scan instead of a wrong answer, and is what lets
    /// reserve() hand out an empty index safely.
    pub fn sum_prefix(self: &PdtBuf, column: u32, row: u64) -> u64 {
        assert(row <= self.size(), "PdtBuf::sum_prefix: row past end");
        let mut base: u64 = 0u64;
        let mut acc: u64 = 0u64;
        if self.has_index() {
            let ix: PdtBuf = self.index();
            let mut span: u64 = row / PDT_INDEX_SPAN;
            if span > ix.size() {
                span = ix.size();
            }
            if span > 0u64 {
                acc = ix.sum_prefix(column, span);
                base = span * PDT_INDEX_SPAN;
            }
        }
        return acc + self.scan_range(column, base, row);
    }

    // The index-FREE range sum: Σ column over [start, end). Ground truth for
    // both the index that is built from it and the check() that verifies it,
    // so it must never route through the fast path — that would be circular.
    fn scan_range(self: &PdtBuf, column: u32, start: u64, end: u64) -> u64 {
        let vals: &[u64] = self.values(column);
        let mut acc: u64 = 0u64;
        let mut i: u64 = start;
        while i < end {
            acc = acc + vals[i as i64];
            i = i + 1u64;
        }
        return acc;
    }

    /// Σ of `column` over rows [start, end) (C++ SO sum(column,start,end) :889).
    pub fn sum(self: &PdtBuf, column: u32, start: u64, end: u64) -> u64 {
        assert(start <= end, "PdtBuf::sum: inverted range");
        assert(end <= self.size(), "PdtBuf::sum: range past end");
        return self.sum_prefix(column, end) - self.sum_prefix(column, start);
    }

    /// Σ of the whole column (C++ SO sum(column) :880).
    pub fn sum_all(self: &PdtBuf, column: u32) -> u64 {
        return self.sum_prefix(column, self.size());
    }

    // ── the search family ─────────────────────────────────────────────────

    // SUM descent, derived from the definition rather than transcribed:
    //   find_ge(v) = min { i : prefix(i+1) >= v }
    //   find_gt(v) = min { i : prefix(i+1) >  v }
    // with prefix(k) = Σ_{j<k} col[j]. Both return (i, prefix(i)); if no such
    // i exists the answer is (size, prefix(size)) — the not-found convention.
    // `strict` selects > over >=.
    //
    // INDEXED DESCENT (C++ find_{ge,gt}_fw_sum :1496/:1536). Run the SAME
    // query on the index first: the index answer s = min{ s : prefix((s+1)*32)
    // >= val } brackets the true row, because prefix(s*32) < val (or no
    // earlier span would have been rejected) and prefix((s+1)*32) >= val. So
    // the row lies in [s*32, (s+1)*32) and the < 32-row scan from s*32 with
    // the index's reported prefix finds it. Recursion gives O(32 * levels).
    //
    // DERIVED, and it DIVERGES from the C++ (upstream bug candidate #26).
    // The C++ treats an index MISS as the final answer:
    //     if (res.local_pos() < index.size()) { idx = ...; prefix = ...; }
    //     else { res.set_local_pos(this->size()); return res; }
    // — it returns "not found over the whole buffer" without examining a
    // single row. That is only accidentally right, and only for an index
    // whose size is exactly div_up(size, 32): then index.size()*32 >= size,
    // so there is genuinely nothing left to scan. Against an index that
    // covers fewer spans it reports not-found over rows it never read.
    // The correct residual — which subsumes the C++ answer instead of
    // special-casing it — is "resume the scan at the first row the index does
    // not cover", i.e. idx = index.size()*32 clamped to size. Written that
    // way the hit and miss arms COLLAPSE into one expression (on a hit
    // r.idx < index.size(), on a miss r.idx == index.size()), and an empty
    // index degrades to the plain P0 scan with no branch at all.
    fn find_fw_sum(self: &PdtBuf, column: u32, val: u64, strict: bool) -> PdtFind {
        let n: u64 = self.size();
        let mut start: u64 = 0u64;
        let mut prefix: u64 = 0u64;
        if self.has_index() {
            let ix: PdtBuf = self.index();
            let r: PdtFind = ix.find_fw_sum(column, val, strict);
            start = r.idx * PDT_INDEX_SPAN;
            prefix = r.prefix;
            if start > n {
                start = n;
            }
        }
        let vals: &[u64] = self.values(column);
        let mut i: u64 = start;
        while i < n {
            let incl: u64 = prefix + vals[i as i64];
            let hit: bool = if strict { incl > val } else { incl >= val };
            if hit {
                return PdtFind { idx: i, prefix: prefix };
            }
            prefix = incl;
            i = i + 1u64;
        }
        return PdtFind { idx: n, prefix: prefix };
    }

    // MAX descent over a SORTED column — index-free BY DESIGN (the C++ HEAD
    // reached the same conclusion: HasIndex excludes MAX, so the search is a
    // bisection, mirror of fse_lower_bound_u64 in arr.logos:507).
    //   find_ge = lower_bound = min { i : col[i] >= val }
    //   find_gt = upper_bound = min { i : col[i] >  val }
    // `prefix` is meaningless for MAX and is reported as 0.
    fn find_fw_max(self: &PdtBuf, column: u32, val: u64, strict: bool) -> PdtFind {
        let vals: &[u64] = self.values(column);
        let mut lo: u64 = 0u64;
        let mut hi: u64 = self.size();
        while lo < hi {
            let mid: u64 = lo + (hi - lo) / 2u64;
            let v: u64 = vals[mid as i64];
            let below: bool = if strict { v <= val } else { v < val };
            if below {
                lo = mid + 1u64;
            } else {
                hi = mid;
            }
        }
        return PdtFind { idx: lo, prefix: 0u64 };
    }

    // The ordering dispatch (C++ PkdDTBufOrderingDispatcher, so.hpp:51-170 —
    // a partial-specialization lattice there, a runtime branch here).
    fn find_fw(self: &PdtBuf, column: u32, val: u64, strict: bool) -> PdtFind {
        let ord: u32 = self.ordering();
        if ord == PDT_ORD_SUM {
            return self.find_fw_sum(column, val, strict);
        }
        assert(ord == PDT_ORD_MAX,
               "PdtBuf::find: UNORDERED buffers define no ordered search");
        return self.find_fw_max(column, val, strict);
    }

    /// First row at which the column reaches `val`
    /// (SUM: cumulative >= val; MAX: cell >= val, i.e. lower_bound).
    /// C++ find_fw_ge :810 → find_ge_fw_sum :1496 / find_ge_fw_max :1483.
    pub fn find_ge(self: &PdtBuf, column: u32, val: u64) -> PdtFind {
        return self.find_fw(column, val, false);
    }

    /// First row at which the column EXCEEDS `val`
    /// (SUM: cumulative > val; MAX: cell > val, i.e. upper_bound).
    /// C++ find_fw_gt :795 → find_gt_fw_sum :1536 / find_gt_fw_max :1469.
    pub fn find_gt(self: &PdtBuf, column: u32, val: u64) -> PdtFind {
        return self.find_fw(column, val, true);
    }

    /// find_ge from a starting row: search the residual sequence [start, size)
    /// and report the answer with the prefix REBASED to `start`
    /// (C++ find_ge_fw_sum(column, start, val) :1394-1400).
    ///
    ///     find_ge_from(s, v) = min { i >= s : Σ_{j∈[s,i]} col[j] >= v }
    ///
    /// SUM ordering only — a relative prefix is meaningless otherwise, which
    /// is precisely why the C++ `start` overloads (:800, :815) hardcode the
    /// SUM implementations and are nonsense on a MAX buffer.
    pub fn find_ge_from(self: &PdtBuf, column: u32, start: u64, val: u64) -> PdtFind {
        return self.find_from(column, start, val, false);
    }

    /// find_gt from a starting row (see find_ge_from).
    pub fn find_gt_from(self: &PdtBuf, column: u32, start: u64, val: u64) -> PdtFind {
        return self.find_from(column, start, val, true);
    }

    // The REBASE derivation (P2), which is what makes the from-index forms
    // index-accelerated. Let p = prefix(start). Then for i >= start
    //     Σ_{j∈[start,i]} col[j] = prefix(i+1) - p,
    // so the residual query is the GLOBAL query at the shifted target
    //     tgt = p + val
    // and the reported relative prefix is prefix(i) - p. Both p and the
    // global descent go through the span index, so the whole form costs
    // O(32 * levels) instead of the O(size - start) scan P1 left here.
    //
    // DERIVED CLAMP — and this is C++ bug candidate #27, first face. The
    // global answer is only guaranteed to lie at or after `start` when it is
    // pinned there by p < tgt, i.e. by val > 0. At val == 0 the target lands
    // exactly ON the prefix plateau boundary p, and a NON-STRICT global
    // search resolves that plateau at its LEFT end: with leading zero rows
    // (col = [0,0,5], start = 2, val = 0) min{i : prefix(i+1) >= 0} is 0, and
    // the C++ returns idx 0 — an index BELOW the row the caller asked it to
    // start from — because neither find_ge_fw_sum(column,start,val) nor its
    // FindResult::sub_prefix clamps the delegated answer back into [start,
    // size]. The semantics admit exactly one answer there (a zero-valued
    // demand is met by the first row examined, i.e. `start` itself, having
    // accumulated nothing), so we clamp. The STRICT form needs no clamp —
    // prefix(i+1) > tgt >= p is unsatisfiable for i < start — but it costs
    // nothing to state once for both.
    //
    // DERIVED GUARD (residual miss). A demand larger than everything the
    // residual holds cannot be met by any row, so it is answered before the
    // arithmetic runs. That is a fast path, but it is written for a second
    // reason: it is what bounds tgt = p + val by the column total and so
    // makes the rebase addition unable to wrap. An unguarded rebase turns an
    // absurd query into a WRONG answer instead of a not-found — the same
    // shape of defect as the underflow class this rung is built to avoid,
    // one operator away.
    //
    // HAZARD (a) — the from-index descent and the index-miss clamp. There is
    // deliberately NO span arithmetic on `start` here: the only place `start`
    // meets the index is inside sum_prefix, which clamps `start / 32` against
    // index.size() (see its DERIVED GUARD). Routing through it is what keeps
    // C++ bug #26 from being re-imported at a second site — an index that
    // covers FEWER spans than the live rows (exactly the state C++
    // create_index() leaves before insert_from_fn fills it) costs a longer
    // scan here, never a wrong answer. conuco section 141 constructs that
    // under-covering state explicitly and drives every from-index and
    // backward form through it.
    fn find_from(self: &PdtBuf, column: u32, start: u64, val: u64, strict: bool) -> PdtFind {
        assert(self.ordering() == PDT_ORD_SUM,
               "PdtBuf::find_*_from: relative-prefix search is SUM-only");
        let n: u64 = self.size();
        assert(start <= n, "PdtBuf::find_*_from: start past end");
        let pfx: u64 = self.sum_prefix(column, start);
        let residual: u64 = self.sum_all(column) - pfx;
        let miss: bool = if strict { val >= residual } else { val > residual };
        if miss {
            return PdtFind { idx: n, prefix: residual };
        }
        let r: PdtFind = self.find_fw_sum(column, pfx + val, strict);
        if r.idx < start {
            return PdtFind { idx: start, prefix: 0u64 };
        }
        return PdtFind { idx: r.idx, prefix: r.prefix - pfx };
    }

    // ── the backward family (P2), DERIVED as forward over the complement ──
    //
    // A backward search walks rows downward from an exclusive end `e`,
    // accumulating as it goes, and stops at the FIRST row whose running total
    // meets the demand. Writing acc(i) = Σ_{j∈[i,e)} col[j] for the
    // accumulation that INCLUDES row i, the two queries are
    //
    //     find_bw_ge(e, v) = max { i < e : acc(i) >= v }
    //     find_bw_gt(e, v) = max { i < e : acc(i) >  v }
    //
    // (acc is non-increasing in i, so "the first row reached going down" and
    // "the largest qualifying index" are the same row.) The reported
    // `prefix` mirrors the forward one exactly — the accumulation reached
    // BEFORE the hit row was added, i.e. acc(idx+1) = Σ rows (idx, e).
    //
    // THE DERIVATION (C++ find_{ge,gt}_bw_sum, so.hpp:1416-1460 — HEAD's own
    // shape, and the reason we take it rather than the deleted flat-tree
    // walk_index_bw). With T = prefix(e) = acc(0):
    //
    //     acc(i) >= v  <=>  T - prefix(i) >= v  <=>  prefix(i) <= T - v
    //     acc(i) >  v  <=>  T - prefix(i) >  v  <=>  prefix(i) <  T - v
    //
    // and, prefix being monotone,
    //
    //     max { i : prefix(i) <= w } = find_gt(w).idx
    //     max { i : prefix(i) <  w } = find_ge(w).idx
    //
    // so the backward search IS the forward search at the complement target
    // T - v, WITH THE STRICTNESS FLIPPED:
    //
    //     find_bw_ge(e, v) = find_gt(T - v)   clamped into [0, e)
    //     find_bw_gt(e, v) = find_ge(T - v)   clamped into [0, e)
    //
    // WHY THIS KILLS THE UNDERFLOW CLASS STRUCTURALLY. The deleted
    // flat-layout family walked backward for real, and that is where its
    // unsigned-arithmetic bugs live: vacuous `if (start >= 0)` guards on a
    // size_t, and `branch_end = (start & ~Mask) - 1` wrapping to SIZE_MAX for
    // start < 32 (recon bugs #3, #4). There is no descending walk here at
    // all: every step of the backward query is a FORWARD query plus one
    // subtraction, and that subtraction is guarded by the not-found test
    // BEFORE it is evaluated, so `T - v` is never reached with v > T.
    //
    // HAZARD (b) — this only works because T is cheap. T = sum_prefix(e) and
    // the complement descent is find_fw_sum, and BOTH route through the span
    // index, so the whole backward family inherits P1's acceleration with no
    // backward index machinery of its own: O(32 * levels), same as forward.
    // If sum_all/sum_prefix ever stopped being index-accelerated, the
    // backward family would silently degrade to O(size) — the gate asserts
    // the index-level count is exercised on these paths so that a regression
    // there is visible; section 150 pins bw against the unindexed twin (which
    // reaches the same answers by pure scan) and 151 against the model.
    //
    // NOT-FOUND, DERIVED (it agrees with the C++ FindResult(start+1, total),
    // which matters only as a cross-check). The walk travels downward, so the
    // "one past the last row" marker the forward convention uses would be -1,
    // which u64 cannot hold — and reaching for a wrapping sentinel here is
    // precisely how this C++ lineage got into trouble. The defensible marker
    // is the one past the walk's ORIGIN in the direction that cannot wrap:
    // the exclusive end `e` itself, which is outside [0, e) and therefore
    // unambiguous. The reported prefix is everything the walk accumulated,
    // i.e. T — exactly parallel to the forward (size, total). Both
    // conventions then coincide at the full-buffer form, where e = size.
    //
    // SUM only, same reason as the from-index forms (the C++ MAX arm's
    // findGT/GEBackward are recon bug #9: they call member functions that are
    // nowhere defined — the MAX backward path has never been instantiated).
    fn find_bw_sum(self: &PdtBuf, column: u32, end: u64, val: u64, strict: bool) -> PdtFind {
        assert(self.ordering() == PDT_ORD_SUM,
               "PdtBuf::find_bw_*: backward search is SUM-only");
        assert(end <= self.size(), "PdtBuf::find_bw_*: end past end");
        if end == 0u64 {
            // An empty range holds no row, and accumulates nothing. Handled
            // first so that `end - 1` below is always well defined: the
            // size-0 buffer is where the C++ full-buffer entry points
            // (:1416, :1440) compute `size() - 1` and wrap to SIZE_MAX.
            return PdtFind { idx: 0u64, prefix: 0u64 };
        }
        let total: u64 = self.sum_prefix(column, end);
        let miss: bool = if strict { val >= total } else { val > total };
        if miss {
            return PdtFind { idx: end, prefix: total };
        }
        // Strictness FLIPS across the complement: >= over acc becomes > over
        // prefix, and vice versa.
        let r: PdtFind = self.find_fw_sum(column, total - val, !strict);
        let mut idx: u64 = r.idx;
        if idx >= end {
            // C++ bug candidate #27, second face. This is reachable only for
            // the NON-STRICT form at val == 0 (the strict one is pinned below
            // `end` by prefix(end) = total >= tgt), and there the complement
            // target is the plateau boundary T itself, which find_gt cannot
            // cross — it answers `size`, an index outside the backward range.
            // C++ find_ge_bw_sum takes that answer unclamped and then calls
            // sum_sum(column, res.local_pos() + 1), i.e. sum_sum(column,
            // size + 1), which trips its own MEMORIA_ASSERT(idx <= size)
            // (:1601). The semantics are unambiguous: a zero demand is met by
            // the first row the walk touches, having accumulated nothing.
            idx = end - 1u64;
        }
        return PdtFind {
            idx: idx,
            prefix: total - self.sum_prefix(column, idx + 1u64),
        };
    }

    /// Last row at which the backward accumulation reaches `val`
    /// (C++ findGEBackward :824 → find_ge_bw_sum :1440). Not found:
    /// (size, total) — the same convention as the forward family, which the
    /// derivation above shows is not a coincidence.
    pub fn find_bw_ge(self: &PdtBuf, column: u32, val: u64) -> PdtFind {
        return self.find_bw_sum(column, self.size(), val, false);
    }

    /// Last row at which the backward accumulation EXCEEDS `val`
    /// (C++ findGTBackward :814 → find_gt_bw_sum :1416).
    pub fn find_bw_gt(self: &PdtBuf, column: u32, val: u64) -> PdtFind {
        return self.find_bw_sum(column, self.size(), val, true);
    }

    /// find_bw_ge over rows [0, start] — `start` INCLUSIVE, mirroring the C++
    /// findGEBackward(column, start, val) :829. Not found: (start + 1, Σ rows
    /// [0, start]). Degenerates to find_bw_ge at start = size - 1, which is
    /// the backward reading of the from-index consistency law.
    pub fn find_bw_ge_from(self: &PdtBuf, column: u32, start: u64, val: u64) -> PdtFind {
        assert(start < self.size(), "PdtBuf::find_bw_ge_from: start past last row");
        return self.find_bw_sum(column, start + 1u64, val, false);
    }

    /// find_bw_gt over rows [0, start] — `start` INCLUSIVE (C++ :819).
    pub fn find_bw_gt_from(self: &PdtBuf, column: u32, start: u64, val: u64) -> PdtFind {
        assert(start < self.size(), "PdtBuf::find_bw_gt_from: start past last row");
        return self.find_bw_sum(column, start + 1u64, val, true);
    }

    // ── P3: the two-phase mutation surface ────────────────────────────────
    //
    // Contract (the C++ prepare_*/commit_* protocol, so.hpp:533-1060, WITHOUT
    // its defects — see the ORACLE note below):
    //
    //   prepare_*  is CONST. It computes the post-op geometry, PRICES it, and
    //              answers whether the allocator chain can supply the
    //              difference. It never writes a byte, so a FAILED prepare
    //              leaves the buffer byte-identical by CONSTRUCTION rather
    //              than by careful unwinding.
    //   commit_*   is INFALLIBLE by contract. It consumes EXACTLY the bytes
    //              the prepare priced, and asserts it did (assert_consumed).
    //
    // THE LAW — `prepared_bytes == consumed_bytes`, exactly:
    //
    //     us.prepared_bytes == pdtbuf_compute_block_size(descr, us.new_capacity)
    //                       == self.consumed_bytes()   AFTER commit
    //
    // This is not bookkeeping, it is the whole point of the rung
    // (design_zero_copy_mutation_cow). If prepare prices exactly what commit
    // will consume, commit cannot fail; if commit cannot fail, there is
    // nothing to roll back; and with nothing to roll back the CoW clone the
    // write path must take anyway IS the rollback buffer, so the C++
    // copy-node-to-scratch-and-restore-on-packed_oom machinery disappears
    // instead of being ported. Every commit below ends in assert_consumed,
    // and conuco re-asserts it externally after every single mutation; two
    // probes (price + 8, price - 8) must both fail the gate.
    //
    // THE PROBES THAT BITE (conuco tests/pdtbuf_core.logos; exit codes are
    // the gate's, 134 = the in-module assert firing first, which is stronger
    // than a test verdict because the library refuses to produce the state at
    // all):
    //   over-price the plan by 8 bytes                       -> 134
    //   under-price the plan by 8 bytes                      -> 134
    //   drop the incremental index recursion (upper levels)  -> 176
    //   perturb one incremental cell by 1                    -> 176
    //   commit an update WITHOUT correcting the index        -> 176
    //   price remove over column 0 only — the shape of C++
    //     do_prepare_remove's `for (column = 0; column < 1)`  -> 134
    //
    // C++ cannot even STATE this law: its index EXISTENCE keys on `size`
    // while its index PRICE comes from `capacity` (reindex_sum :1727/:1735 vs
    // compute_block_size :186), so its block price is a strict over-estimate
    // and prepared > consumed by design. P1 already diverged toward exactness
    // for this reason; this rung is what that divergence was for.
    //
    // ── ORACLE: the mutation neighbourhood is the most infected of the file ─
    // Mirrored for SHAPE only; every behaviour re-derived:
    //   * `prepare_remove` (dispatcher base :189) returns SUCCESS
    //     unconditionally for every FIXED-size buffer, and the real
    //     `do_prepare_remove` (:614) is consequently DEAD — which is lucky,
    //     because it loops `for (size_t column = 0; column < 1; column++)`,
    //     i.e. it would price column 0 only and under-price every
    //     multi-column buffer. We price remove for real, over all columns.
    //   * ~10 further dispatcher targets are dead-if-instantiated.
    //   * `split_to` (:533) is not two-phase at all: it inserts into `other`
    //     and only then removes from `self`, with no prepare and no budget —
    //     an OOM mid-way leaves BOTH nodes torn. Ours prepares both sides
    //     first and still orders the writes right-then-left, so the original
    //     is never destroyed before the new home exists.
    //   * `commit_remove` (:639) reindexes with a FULL rebuild even for a
    //     single-row delete (:1138), and so does the SUM update arm (:1025) —
    //     see commit_update, where the cost divergence is argued and gated.
    // No NEW upstream defect was proved at this rung: the mutation
    // neighbourhood was re-read site by site against the marker-4 traces and
    // the suspicions that did not survive checking are NOT recorded as bugs
    // (do_commit_update_fxd_sum was one — it reindexes after all).
    //
    // ── GAP (b), CLOSED: size growth vs CAPACITY growth are priced apart ────
    // The C++ FSE dimension has no capacity notion at all — `insert_space`
    // (fse_tools.hpp:100) resizes the data block to exactly `size + extra`
    // rows every time, so "grow the rows" and "grow the bytes" are the same
    // event there and the distinction cannot be expressed. We store capacity,
    // so they are DIFFERENT events and prepare must price both:
    //
    //   * rows grow INSIDE the existing capacity — geometry unchanged,
    //     prepared_bytes == before_bytes, delta ZERO, prepare cannot fail;
    //   * rows grow PAST the capacity — the data blocks and (recursively) the
    //     index slot are repriced at the new capacity, and the difference is
    //     what the allocator chain is asked for.
    //
    // Which one happens is the CAPACITY POLICY, an explicit axis rather than
    // a hidden default, because the two callers genuinely differ:
    //   PDT_CAP_EXACT — capacity := new_size. Bytes are released on shrink;
    //     this is the btree-node reading (space must return to the node's
    //     other streams) and it mirrors what the C++ does implicitly.
    //   PDT_CAP_KEEP  — capacity := max(capacity, new_size). An explicit
    //     reservation is honoured, so a fill loop pays for its geometry once.
    // Both are priced by the SAME formula, so exactness is policy-independent;
    // conuco runs every law under both.
    //
    // ── GAP (a), CLOSED: targeted incremental reindex ───────────────────────
    // See index_delta. P3 is the first rung with a caller for it.
    //
    // VLE payload pricing stays the P4 PAIR flag: pdt_dim_block_size prices a
    // VLE payload block as 0 (content dependent), so an exact prepare over a
    // VLE dimension is not expressible yet. The mutation surface REJECTS VLE
    // loudly (assert_fse_mutable) rather than pricing it approximately — a
    // safety margin here would silently reintroduce the copy-restore need.

    fn assert_fse_mutable(self: &PdtBuf) {
        let n: u32 = self.dim_count();
        let mut i: u32 = 0u32;
        while i < n {
            let d: PdtDim = self.dim_at(i);
            assert(d.kind == PDT_DIM_FSE,
                   "PdtBuf: two-phase mutation over a VLE dimension is P4 (payload pricing unresolved)");
            i = i + 1u32;
        }
    }

    /// Descriptor agreement between two buffers that are about to exchange
    /// rows. Checked field by field off the BLOCKS (both are self-describing),
    /// so a merge across mismatched geometry is a loud assert, never a
    /// silently misaligned memcpy.
    fn assert_compatible(self: &PdtBuf, other: &PdtBuf) {
        assert(self.columns() == other.columns(),
               "PdtBuf: row exchange between buffers of different column counts");
        assert(self.ordering() == other.ordering(),
               "PdtBuf: row exchange between buffers of different ordering");
        assert(self.dim_count() == other.dim_count(),
               "PdtBuf: row exchange between buffers of different dimension counts");
        let n: u32 = self.dim_count();
        let mut i: u32 = 0u32;
        while i < n {
            let a: PdtDim = self.dim_at(i);
            let b: PdtDim = other.dim_at(i);
            assert(a.kind == b.kind && a.elem_size == b.elem_size,
                   "PdtBuf: row exchange between buffers of different dimensions");
            i = i + 1u32;
        }
    }

    /// The capacity the policy asks for at `new_size` — see GAP (b) above.
    pub fn target_capacity(self: &PdtBuf, new_size: u64, policy: u32) -> u64 {
        if policy == PDT_CAP_KEEP {
            let cap: u64 = self.capacity();
            if cap > new_size {
                return cap;
            }
            return new_size;
        }
        assert(policy == PDT_CAP_EXACT, "PdtBuf: unknown capacity policy");
        return new_size;
    }

    // THE pricing step, shared by every prepare. It is deliberately the ONE
    // place a post-op byte total is computed, and it computes it with the
    // same function that priced the block in the first place — so
    // "prepared" and "consumed" are the same expression evaluated at two
    // different times, and they cannot drift apart operation by operation.
    fn price(self: &PdtBuf, op: u32, policy: u32, at: u64, count: u64, new_size: u64)
        -> PdtUpdate {
        let d: PdtDescr = self.descr();
        let new_cap: u64 = self.target_capacity(new_size, policy);
        return PdtUpdate {
            op: op,
            policy: policy,
            at: at,
            count: count,
            old_size: self.size(),
            new_size: new_size,
            old_capacity: self.capacity(),
            new_capacity: new_cap,
            before_bytes: self.consumed_bytes(),
            prepared_bytes: pdtbuf_compute_block_size(&d, new_cap),
        };
    }

    /// Can `commit(us)` succeed? The budget question, asked of the allocator
    /// chain exactly as the sseq precedent asks it (update_fits, sseq:1165):
    /// the priced total either fits the block we already have, or the PARENT
    /// chain holds the difference. Const — `total_free_space` walks the chain
    /// without mutating.
    ///
    /// This is sufficient because pdtbuf_reserve — the single fallible phase —
    /// releases before it acquires (shrinks pass, then grows pass), so its
    /// PEAK demand is exactly the priced total and never above it.
    pub fn update_fits(self: &PdtBuf, us: &PdtUpdate) -> bool {
        unsafe {
            let a: *mut PkdAlloc = self.alc();
            let bs: u32 = a.block_size();
            if us.prepared_bytes <= bs {
                return true;
            }
            if a.has_allocator() {
                // headroom of the PARENT chain only (our own free space is
                // already counted inside bs)
                let chain: u32 = a.total_free_space() - a.free_space();
                return chain >= us.prepared_bytes - bs;
            }
            return false;
        }
    }

    /// PLAN inserting `count` rows at row `at` (C++ prepare_insert :898).
    /// CONST: on Err the buffer is byte-identical, having never been written.
    pub fn prepare_insert(self: &PdtBuf, at: u64, count: u64, policy: u32)
        -> Result<PdtUpdate, PkdError> {
        self.assert_fse_mutable();
        assert(at <= self.size(), "PdtBuf::prepare_insert: position past end");
        let us: PdtUpdate = self.price(PDT_OP_INSERT, policy, at, count, self.size() + count);
        if !self.update_fits(&us) {
            return Result::Err(PkdError::OutOfMem);
        }
        return Result::Ok(us);
    }

    /// PLAN replacing the values of rows [at, at+count) (C++ prepare_update
    /// :976 — whose FIXED arm is the dispatcher base's unconditional SUCCESS,
    /// :185). For FSE dimensions that verdict is CORRECT and we derive the
    /// same one: a fixed-stride replacement moves no byte boundary, so the
    /// priced total is unchanged and the prepare cannot fail. It is priced
    /// through the same formula anyway, so the law is asserted here too
    /// rather than assumed.
    pub fn prepare_update(self: &PdtBuf, at: u64, count: u64)
        -> Result<PdtUpdate, PkdError> {
        self.assert_fse_mutable();
        assert(at + count <= self.size(), "PdtBuf::prepare_update: range past end");
        let us: PdtUpdate = self.price(PDT_OP_UPDATE, PDT_CAP_KEEP, at, count, self.size());
        if !self.update_fits(&us) {
            return Result::Err(PkdError::OutOfMem);
        }
        return Result::Ok(us);
    }

    /// PLAN removing rows [start, end) (C++ prepare_remove :608 — which for
    /// every FIXED-size buffer returns SUCCESS without looking, leaving
    /// do_prepare_remove :614 dead with a `column < 1` loop inside it. We
    /// price it for real, over ALL columns, through the shared formula).
    pub fn prepare_remove(self: &PdtBuf, start: u64, end: u64, policy: u32)
        -> Result<PdtUpdate, PkdError> {
        self.assert_fse_mutable();
        assert(start <= end, "PdtBuf::prepare_remove: inverted range");
        assert(end <= self.size(), "PdtBuf::prepare_remove: range past end");
        let us: PdtUpdate = self.price(PDT_OP_REMOVE, policy, start, end - start,
                                       self.size() - (end - start));
        if !self.update_fits(&us) {
            return Result::Err(PkdError::OutOfMem);
        }
        return Result::Ok(us);
    }

    /// PLAN absorbing every row of `other` after our own last row
    /// (C++ do_prepare_merge_with_fxd :558). DIRECTION NOTE: the C++ merges
    /// self INTO other; the pkd-family convention here — and in sseq
    /// (plan_merge, sseq:1148) — is merge_from, self <- self ++ other. The
    /// concatenation is the same either way; the budget is asked of the
    /// buffer that GROWS, which is the one that can fail.
    pub fn prepare_merge_with(self: &PdtBuf, other: &PdtBuf, policy: u32)
        -> Result<PdtUpdate, PkdError> {
        self.assert_fse_mutable();
        self.assert_compatible(other);
        let n: u64 = other.size();
        let us: PdtUpdate = self.price(PDT_OP_MERGE, policy, self.size(), n, self.size() + n);
        if !self.update_fits(&us) {
            return Result::Err(PkdError::OutOfMem);
        }
        return Result::Ok(us);
    }

    /// PLAN moving rows [at, size) out of self and into the FRONT of `other`
    /// (C++ split_to :533 — which is not two-phase at all: it inserts into
    /// `other` and then removes from `self` with no budget anywhere, so an
    /// OOM in the middle tears both nodes).
    ///
    /// TWO budgets, one verdict — the atomicity condition of the zero-copy
    /// design. `other` GROWS and is the side that can fail; self only ever
    /// shrinks, and a shrink cannot OOM, which is exactly why the commit can
    /// fill the sibling first and give up the original's rows afterwards.
    pub fn prepare_split_to(self: &PdtBuf, other: &PdtBuf, at: u64, policy: u32)
        -> Result<PdtSplit, PkdError> {
        self.assert_fse_mutable();
        self.assert_compatible(other);
        assert(at <= self.size(), "PdtBuf::prepare_split_to: position past end");
        let n: u64 = self.size() - at;
        let left: PdtUpdate = self.price(PDT_OP_SPLIT, policy, at, n, at);
        let right: PdtUpdate = other.price(PDT_OP_SPLIT, policy, 0u64, n, other.size() + n);
        if !other.update_fits(&right) {
            return Result::Err(PkdError::OutOfMem);
        }
        if !self.update_fits(&left) {
            return Result::Err(PkdError::OutOfMem);
        }
        return Result::Ok(PdtSplit { left: left, right: right });
    }

    // ── commit ────────────────────────────────────────────────────────────

    // THE law, asserted at the end of every commit. Externally re-asserted by
    // conuco after every mutation, and both mis-pricing probes (+8 / -8) must
    // trip it.
    fn assert_consumed(self: &PdtBuf, us: &PdtUpdate) {
        assert(self.consumed_bytes() == us.prepared_bytes,
               "PdtBuf: prepared_bytes != consumed_bytes — the exact-prepare law is broken");
    }

    // The state a commit was planned against must still be the state it finds.
    fn assert_planned(self: &PdtBuf, us: &PdtUpdate) {
        assert(us.old_size == self.size() && us.old_capacity == self.capacity(),
               "PdtBuf: the buffer changed between prepare and commit");
    }

    // Geometry, infallible BY CONTRACT: prepare already asked the chain the
    // same question reserve is about to ask it.
    fn apply_geometry(self: &mut PdtBuf, cap: u64) {
        match self.reserve(cap) {
            Result::Ok(_) => {}
            Result::Err(_) => {
                assert(false,
                       "PdtBuf: commit could not reserve — prepare was not consulted");
            }
        }
    }

    // Overlap-safe row move within one buffer, general over columns AND
    // dimensions: the stride comes from the descriptor, so there is no
    // per-column and no per-dimension code path here either.
    unsafe fn move_rows(self: &mut PdtBuf, from: u64, to: u64, n: u64) {
        if n == 0u64 || from == to {
            return;
        }
        let cols: u32 = self.columns();
        let dims: u32 = self.dim_count();
        let mut c: u32 = 0u32;
        while c < cols {
            let mut d: u32 = 0u32;
            while d < dims {
                let dim: PdtDim = self.dim_at(d);
                let src: *mut u8 = self.cell_ptr(c, d, from);
                let dst: *mut u8 = self.cell_ptr(c, d, to);
                move_bytes(dst, src as *const u8, (n * (dim.elem_size as u64)) as i64);
                d = d + 1u32;
            }
            c = c + 1u32;
        }
    }

    // Copy `n` rows out of `other` (C++ copyTo :under split_to/merge). Same
    // generality; the two blocks are disjoint but move_bytes is used anyway
    // so the helper has one behaviour, not two.
    unsafe fn copy_rows_from(self: &mut PdtBuf, other: &PdtBuf,
                             src_row: u64, dst_row: u64, n: u64) {
        if n == 0u64 {
            return;
        }
        let cols: u32 = self.columns();
        let dims: u32 = self.dim_count();
        let mut c: u32 = 0u32;
        while c < cols {
            let mut d: u32 = 0u32;
            while d < dims {
                let dim: PdtDim = self.dim_at(d);
                let src: *mut u8 = other.cell_ptr(c, d, src_row);
                let dst: *mut u8 = self.cell_ptr(c, d, dst_row);
                move_bytes(dst, src as *const u8, (n * (dim.elem_size as u64)) as i64);
                d = d + 1u32;
            }
            c = c + 1u32;
        }
    }

    // Row-major value block -> rows [at, at+count) across ALL columns.
    fn write_rows(self: &mut PdtBuf, at: u64, count: u64, vals: &Vec<u64>) {
        let cols: u32 = self.columns();
        assert(vals.length() == (count as i64) * (cols as i64),
               "PdtBuf: value block length != count * columns");
        let mut r: u64 = 0u64;
        while r < count {
            let mut c: u32 = 0u32;
            while c < cols {
                self.set(c, at + r, vals.get((r as i64) * (cols as i64) + (c as i64)));
                c = c + 1u32;
            }
            r = r + 1u64;
        }
    }

    /// COMMIT an insert. Infallible; consumes exactly `us.prepared_bytes`.
    ///
    /// ORDER, and it is not free choice: geometry FIRST (the tail cannot be
    /// shifted into bytes the block does not own yet), then publish the size,
    /// then shift, then fill. Reindex is a FULL rebuild here BY NECESSITY —
    /// an insert shifts the row->span mapping of every row after `at`, so no
    /// bounded set of cells describes the change (contrast commit_update).
    pub fn commit_insert(self: &mut PdtBuf, us: &PdtUpdate, vals: &Vec<u64>) {
        assert(us.op == PDT_OP_INSERT, "PdtBuf::commit_insert: update state is not an insert");
        self.assert_planned(us);
        let tail: u64 = us.old_size - us.at;
        if us.new_capacity != us.old_capacity {
            self.apply_geometry(us.new_capacity);
        }
        self.set_size(us.new_size);
        unsafe {
            self.move_rows(us.at, us.at + us.count, tail);
        }
        self.write_rows(us.at, us.count, vals);
        self.reindex();
        self.assert_consumed(us);
    }

    /// COMMIT a value replacement — the ONE mutation whose index update is
    /// TARGETED rather than a rebuild (GAP (a), the P1 deferral, closed here
    /// because P3 is its first caller).
    ///
    /// THE DERIVATION. The index invariant is
    ///     cell(c, k) = Σ_{r ∈ [32k, min(32(k+1), size))} col_c[r] ,
    /// a sum over a partition of the rows. Row `r` therefore appears in
    /// EXACTLY ONE cell of the level above it, namely k = r / 32, and in no
    /// other cell at that level. Replacing col_c[r] from `old` to `new`
    /// perturbs that single cell by exactly (new - old) and leaves every
    /// other cell of the level literally unchanged. The index is itself a
    /// PdtBuf obeying the same invariant, and its row k has just changed by
    /// that same delta — so the correction recurses along ONE path,
    /// r -> r/32 -> r/32² -> …, one cell per level: O(levels), against the
    /// O(size · levels) of a rebuild.
    ///
    /// WHY ONE FUNCTION, NOT `_add` AND `_sub`. The C++ carries a targeted
    /// pair; a signed delta carried in u64 with WRAPPING add/sub subsumes
    /// both, because every intermediate is congruent mod 2^64 and the true
    /// cell sums are representable — so the value that lands is the true one
    /// for either direction. That removes, rather than guards, the
    /// unsigned-underflow surface a separate `_sub` would have (`old > new`
    /// is the ordinary case, not an edge case), which is the same structural
    /// move P2 made against the backward walks.
    ///
    /// WHAT THE C++ DOES HERE, checked rather than assumed. Its SUM arm
    /// (do_commit_update_fxd_sum :1025) writes the rows through
    /// do_commit_update_fxd_max and then calls reindex() — a FULL rebuild,
    /// correct but O(size · levels) for a one-row change; its MAX arm (:1032)
    /// deliberately does not reindex, which is also correct, MAX being
    /// index-free. So this is a divergence in COST, not in behaviour, and
    /// that is exactly what the gate must prove: conuco (219..224) asserts
    /// the targeted result is CELL-IDENTICAL to a full rebuild at every level
    /// after every update in a long run, so the cheap path is not merely
    /// "good enough" but the same answer. A probe that skips the index
    /// correction — the shape a targeted update degenerates to if the
    /// recursion is dropped — fails that parity check, not merely a query.
    pub fn commit_update(self: &mut PdtBuf, us: &PdtUpdate, vals: &Vec<u64>) {
        assert(us.op == PDT_OP_UPDATE, "PdtBuf::commit_update: update state is not an update");
        self.assert_planned(us);
        let cols: u32 = self.columns();
        assert(vals.length() == (us.count as i64) * (cols as i64),
               "PdtBuf::commit_update: value block length != count * columns");
        let mut r: u64 = 0u64;
        while r < us.count {
            let row: u64 = us.at + r;
            let mut c: u32 = 0u32;
            while c < cols {
                let nv: u64 = vals.get((r as i64) * (cols as i64) + (c as i64));
                let ov: u64 = self.get(c, row);
                if nv != ov {
                    self.set(c, row, nv);
                    self.index_delta(c, row, wrapping_sub::<u64>(nv, ov));
                }
                c = c + 1u32;
            }
            r = r + 1u64;
        }
        self.assert_consumed(us);
    }

    // The targeted correction itself (C++ `_add`/`_sub`, folded into one
    // wrapping delta — see commit_update's derivation).
    //
    // The `k >= ix.size()` guard is the SAME weaker invariant P2 identified
    // and the queries already rely on: live index cells are complete span
    // sums of a PREFIX of the rows. A cell that does not exist yet (an index
    // reserved but not reindexed, or one deliberately covering fewer spans)
    // must not be conjured here — the rows past the covered prefix are read
    // by scan, and inventing a cell for them would make the index describe a
    // set of rows it does not cover. So the correction stops exactly where
    // the coverage stops, and the state stays coherent under the invariant
    // that matters.
    fn index_delta(self: &mut PdtBuf, column: u32, row: u64, delta: u64) {
        if !self.has_index() {
            return;
        }
        let mut ix: PdtBuf = self.index();
        let k: u64 = row / PDT_INDEX_SPAN;
        if k >= ix.size() {
            return;
        }
        let cur: u64 = ix.get(column, k);
        ix.set(column, k, wrapping_add::<u64>(cur, delta));
        ix.index_delta(column, k, delta);
    }

    /// COMMIT a removal. ORDER mirrors the insert, reversed: shift the
    /// survivors down INSIDE the old geometry, publish the smaller size, and
    /// only THEN release the bytes. Releasing first would shorten the data
    /// blocks under the rows still to be moved.
    pub fn commit_remove(self: &mut PdtBuf, us: &PdtUpdate) {
        assert(us.op == PDT_OP_REMOVE, "PdtBuf::commit_remove: update state is not a remove");
        self.assert_planned(us);
        let end: u64 = us.at + us.count;
        unsafe {
            self.move_rows(end, us.at, us.old_size - end);
        }
        self.set_size(us.new_size);
        if us.new_capacity != us.old_capacity {
            self.apply_geometry(us.new_capacity);
        }
        self.reindex();
        self.assert_consumed(us);
    }

    /// COMMIT self <- self ++ other (C++ commit_merge_with :591). `other` is
    /// left untouched; disposing of it is the node's move, as in sseq.
    pub fn commit_merge_with(self: &mut PdtBuf, us: &PdtUpdate, other: &PdtBuf) {
        assert(us.op == PDT_OP_MERGE, "PdtBuf::commit_merge_with: update state is not a merge");
        self.assert_planned(us);
        self.assert_compatible(other);
        if us.new_capacity != us.old_capacity {
            self.apply_geometry(us.new_capacity);
        }
        self.set_size(us.new_size);
        unsafe {
            self.copy_rows_from(other, 0u64, us.old_size, us.count);
        }
        self.reindex();
        self.assert_consumed(us);
    }

    /// COMMIT the split: rows [at, size) leave self and are PREPENDED to
    /// `other` (the btree reading the C++ takes at :533 — the right sibling
    /// receives our tail ahead of whatever it already holds).
    ///
    /// RIGHT SIDE FIRST, and that ordering is the zero-copy discipline itself
    /// (design_zero_copy_mutation_cow): the new home is fully built before the
    /// original gives anything up, so at no instant do the rows exist in
    /// neither buffer. The left side is then a PURE SHRINK, which cannot fail
    /// — which is why no rollback path is needed on either side and no scratch
    /// copy of the node is taken anywhere.
    pub fn commit_split_to(self: &mut PdtBuf, other: &mut PdtBuf, sp: &PdtSplit) {
        assert(sp.left.op == PDT_OP_SPLIT, "PdtBuf::commit_split_to: update state is not a split");
        self.assert_planned(&sp.left);
        other.assert_planned(&sp.right);
        self.assert_compatible(other);
        let n: u64 = sp.left.count;
        // ── the fresh home ────────────────────────────────────────────────
        if sp.right.new_capacity != sp.right.old_capacity {
            other.apply_geometry(sp.right.new_capacity);
        }
        other.set_size(sp.right.new_size);
        unsafe {
            other.move_rows(0u64, n, sp.right.old_size);
            other.copy_rows_from(self, sp.left.at, 0u64, n);
        }
        other.reindex();
        other.assert_consumed(&sp.right);
        // ── and only now does the original let go ─────────────────────────
        self.set_size(sp.left.new_size);
        if sp.left.new_capacity != sp.left.old_capacity {
            self.apply_geometry(sp.left.new_capacity);
        }
        self.reindex();
        self.assert_consumed(&sp.left);
    }

    // ── one-call conveniences (prepare + commit) ──────────────────────────
    //
    // PDT_CAP_EXACT is the default here — the btree-node reading, where bytes
    // released by a shrink must return to the node's other streams. A caller
    // that has reserved deliberately drives prepare_*/commit_* directly with
    // PDT_CAP_KEEP. Every one of these leaves the buffer UNCHANGED on Err,
    // because prepare is const and nothing has run before it fails. `?` is
    // deliberately not used in these paths (the sseq drop-gap-B discipline).

    /// Insert `count` rows of row-major values at `at`; Err leaves the buffer
    /// byte-identical.
    pub fn insert_rows(self: &mut PdtBuf, at: u64, count: u64, vals: &Vec<u64>)
        -> Result<(), PkdError> {
        let us: PdtUpdate = match self.prepare_insert(at, count, PDT_CAP_EXACT) {
            Result::Ok(u) => { u }
            Result::Err(e) => {
                return Result::Err(e);
            }
        };
        self.commit_insert(&us, vals);
        return Result::Ok(());
    }

    /// Replace the values of rows [at, at+count).
    pub fn update_rows(self: &mut PdtBuf, at: u64, count: u64, vals: &Vec<u64>)
        -> Result<(), PkdError> {
        let us: PdtUpdate = match self.prepare_update(at, count) {
            Result::Ok(u) => { u }
            Result::Err(e) => {
                return Result::Err(e);
            }
        };
        self.commit_update(&us, vals);
        return Result::Ok(());
    }

    /// Remove rows [start, end).
    pub fn remove_rows(self: &mut PdtBuf, start: u64, end: u64) -> Result<(), PkdError> {
        let us: PdtUpdate = match self.prepare_remove(start, end, PDT_CAP_EXACT) {
            Result::Ok(u) => { u }
            Result::Err(e) => {
                return Result::Err(e);
            }
        };
        self.commit_remove(&us);
        return Result::Ok(());
    }

    /// self <- self ++ other.
    pub fn merge_from(self: &mut PdtBuf, other: &PdtBuf) -> Result<(), PkdError> {
        let us: PdtUpdate = match self.prepare_merge_with(other, PDT_CAP_EXACT) {
            Result::Ok(u) => { u }
            Result::Err(e) => {
                return Result::Err(e);
            }
        };
        self.commit_merge_with(&us, other);
        return Result::Ok(());
    }

    /// Move rows [at, size) into the front of `other`.
    pub fn split_to(self: &mut PdtBuf, other: &mut PdtBuf, at: u64) -> Result<(), PkdError> {
        let sp: PdtSplit = match self.prepare_split_to(other, at, PDT_CAP_EXACT) {
            Result::Ok(s) => { s }
            Result::Err(e) => {
                return Result::Err(e);
            }
        };
        self.commit_split_to(other, &sp);
        return Result::Ok(());
    }

    // ── structural check ──────────────────────────────────────────────────

    /// Structural self-check (C++ SO check() :462). Verifies the slot
    /// geometry against the descriptor AND the exact-prepare law
    /// (consumed == priced). Returns 0 when sound, else a code identifying
    /// the broken invariant — the conuco mutation probe relies on this
    /// biting when the slot formula is perturbed.
    pub fn check(self: &PdtBuf) -> i32 {
        let cols: u32 = self.columns();
        let dims: u32 = self.dim_count();
        if cols == 0u32 || dims == 0u32 {
            return 1i32;
        }
        if self.size() > self.capacity() {
            return 2i32;
        }
        unsafe {
            let a: *mut PkdAlloc = self.alc();
            let mut expect_dbt: u32 = 0u32;
            let mut i: u32 = 0u32;
            while i < dims {
                let d: PdtDim = self.dim_at(i);
                expect_dbt = expect_dbt + pdt_dim_width(&d);
                i = i + 1u32;
            }
            if expect_dbt != self.dim_blocks_total() {
                return 3i32;
            }
            let mut c: u32 = 0u32;
            while c < cols {
                let mut j: u32 = 0u32;
                while j < dims {
                    let d2: PdtDim = self.dim_at(j);
                    let w: u32 = pdt_dim_width(&d2);
                    let mut sub: u32 = 0u32;
                    while sub < w {
                        let blk: u32 = self.block_of(c, j, sub);
                        if blk < PDT_LAST_HEADER_BLOCK || blk >= a.elements() {
                            return 4i32;
                        }
                        let want: u32 = pdt_dim_block_size(&d2, sub, self.capacity());
                        if a.element_size(blk) != want {
                            return 5i32;
                        }
                        sub = sub + 1u32;
                    }
                    j = j + 1u32;
                }
                c = c + 1u32;
            }
        }
        // The exact-prepare law: what the block consumed is exactly what
        // pdtbuf_compute_block_size priced. P3's `prepared == consumed`
        // mutation gate is this same assertion, one rung up.
        let d: PdtDescr = self.descr();
        if self.consumed_bytes() != pdtbuf_compute_block_size(&d, self.capacity()) {
            return 6i32;
        }
        // ── the span index (C++ check_sum :1649) ──────────────────────────
        // GEOMETRY: the slot holds exactly what the capacity prices — this is
        // the lockstep assertion. A slot sized from `size` while priced from
        // `capacity` (the C++ arrangement) fails here, which is the point.
        unsafe {
            if self.alc().element_size(PDT_SLOT_INDEX)
                != pdtbuf_index_block_size(&d, self.capacity()) {
                return 7i32;
            }
        }
        if self.has_index() {
            let ix: PdtBuf = self.index();
            if ix.capacity() != pdtbuf_span_count(self.capacity()) {
                return 8i32;
            }
            // Size 0 = reserved but not yet reindexed (a legal, correct-but-
            // slow state); anything else must cover the live rows EXACTLY.
            if ix.size() != 0u64 && ix.size() != pdtbuf_span_count(self.size()) {
                return 8i32;
            }
            // CONTENT: every cell is the per-span partial sum of its rows.
            // Recomputed from the index-free scan, so a fast path that agrees
            // with a wrong index cannot hide here.
            let n: u64 = self.size();
            let ns: u64 = ix.size();
            let cols2: u32 = self.columns();
            let mut c3: u32 = 0u32;
            while c3 < cols2 {
                let mut s: u64 = 0u64;
                while s < ns {
                    let base: u64 = s * PDT_INDEX_SPAN;
                    let mut limit: u64 = base + PDT_INDEX_SPAN;
                    if limit > n {
                        limit = n;
                    }
                    if ix.get(c3, s) != self.scan_range(c3, base, limit) {
                        return 9i32;
                    }
                    s = s + 1u64;
                }
                c3 = c3 + 1u32;
            }
            // ... and the index checks itself, by the same rules, all the way
            // up the tree. The +10 per level keeps the failing LEVEL visible.
            let rc: i32 = ix.check();
            if rc != 0i32 {
                return 10i32 + rc;
            }
        }
        return 0i32;
    }
}
