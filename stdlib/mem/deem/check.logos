// logos.std.deem — THE RELATIONAL STATIC CHECKER: QPlan, resolve_source, check_rexpr, analyze_join_step and the rel-field rewrite. Query-only, and dies with the interpreter (P5).
// The EL/template half (Chk/CBinds/check_root/check_expr/check_stmts/simplify_all/sx_of) now lives in tpl.logos — it is the TEMPLATE engine's checker and survives.
// One package across several files (see deem.logos for the module-level doc);
// private items are package-visible, so the split is layout-only.
package logos.mem.deem;


use logos.lang.writ.container;    // Writ / writ_new
use logos.lang.writ.anyval;       // WAny
use logos.lang.writ.wmap;         // WMap<Wu6, WAny> — TOM reads (schema field gets)
use logos.lang.writ.array;        // WArray — edge-field iteration
use logos.lang.writ.wstring;      // WString / as_wstr — string payloads + interning
use logos.lang.writ.wstatic;      // WritStatic — the rodata metadata-blob handle
use logos.lang.writ.static_view;  // WView2 — reader over rodata Writ blobs
use logos.lang.result;            // Result — the error-as-value carrier
use logos.lang.option;            // Option — HashMapKeys iterator item (SEMILATTICE rescan)
use logos.lang.panic;             // panic — recursive-aggregate convergence guard (slice-7)
use logos.mem.string;             // String
use logos.lang.mem;               // replace — FactStore::take_delta move-out
use logos.lang.num.float;         // f64_to_bits — FsKey f64 content-hash
use logos.lang.str;               // str_eq / str_cmp / str_contains / str_starts_with / …
use logos.lang.arith;             // wrapping_mul — the FNV mix wraps by design
use logos.std.wql.ir;             // SExpr family + WRef (the shared IR)
use logos.std.wql.el;             // EL_TY_* / OP_* / builtin registry / agg rule table
use logos.std.wql.optimize;       // simplify_sexpr / simplify_rexpr_ref + TermList analysis
use logos.std.wql.trama;          // TStmt family + chain_array / next_of_stmt / ttext_str
use logos.std.wql.trama_parser;   // parse_tpl — the reused generated template parser
use logos.std.wql.plan;           // RQuery / RQProgram — the surface query plan views
use logos.std.wql.wql_surface_parser;  // parse_program — the reused generated query parser
use logos.std.wql.lower;          // lower_rquery_to_rexpr — the reused PLAN→ALGEBRA lowering
use logos.std.wql.params;         // RelDeps / RelScc / compute_rel_scc — the SHARED
                                  // (metaprog-free) rel dependency-graph half (I3)
use logos.mem.collections.vec;    // Vec — row pipelines (unbounded)
use logos.mem.collections.hashmap;// HashMap — hash-join buckets / distinct sets


// Result-envelope modes (mirror rexpr_walk's SELM_* — first/find are not
// algebra nodes; they shape the result).
const QM_ALL:   i32 = 0i32;
const QM_FIRST: i32 = 1i32;
const QM_FIND:  i32 = 2i32;

// Join-strategy tiers (runtime edition of the static cascade; the TREE tier
// is unreachable over the scalar lattice — hash-able ⇔ ord-able here).
const QT_HASH: i32 = 1i32;
const QT_LOOP: i32 = 3i32;

// Builtin aggregate ids (local mirror; the TYPE rules live in the SHARED
// `el::agg_result_ty` table — one rule source for static + dynamic tiers).
fn qagg_id(name: str) -> i32 {
    if str_eq(name, "count") { return 1i32; }
    if str_eq(name, "sum")   { return 2i32; }
    if str_eq(name, "min")   { return 3i32; }
    if str_eq(name, "max")   { return 4i32; }
    if str_eq(name, "avg")   { return 5i32; }
    return 0i32;
}


// The RScan under a relational edge (join right sides are always scans).
fn rscan_of(e: RExpr) -> RScan {
    match e {
        RExpr::Scan(sc) => { return sc; }
        _ => {
            // Unreachable by construction (lowering invariant); a defensive
            // null-backed view would fault loudly on read.
            return WAny::ref_to(0i64 as *const u8).view::<RScan>();
        }
    }
}

// ── QPlan — the per-run node decisions, filled by the STRICT check walk ─────
// The cascade is decided ONCE per run from CHECKED types (never per row); the
// executor looks decisions up by node word. Capacities are metadata-sized:
// ≤ 24 join steps ACROSS the entry + every rel body (I3 — each ≤ 8 by the
// grammar cap), ONE aggregate node (entry-only), ≤ 8 output columns.
// `ncols`/`ckind` are per-Proj scratch: each body's check reads them right
// after its walk; the ENTRY is checked LAST, so the surviving values are the
// entry's (what QRows carries).
struct QPlan {
    // RJoin/RAnti step plans, keyed by node word
    jw:     [i64; 24],
    jtier:  [i32; 24],
    jequi:  [i64; 24],   // the selected equi-TERM word (0 = none)
    jbuild: [i64; 24],   // new-side key expr word
    jprobe: [i64; 24],   // bound-side key expr word
    jn:     i64,
    // the single RAggr plan
    agg_n:    i64,
    agg_fnid: [i32; 8],  // 1..5 builtin, 0 = UDA
    agg_uda:  [i64; 8],  // UDA registry index (fnid 0)
    agg_ret:  [i32; 8],  // column result tag (CT_* scalar tier)
    // The ARGUMENT's checked type tag (CT_* scalar tier), CT_UNKNOWN for
    // `count()` (nullary) and for an argument the check could not type.
    //
    // ⚠ IT IS NOT DERIVABLE FROM `agg_ret`, AND THAT IS THE WHOLE POINT.
    // `agg_ret` is what the SHARED rule table answers, and for `avg` the table
    // answers Quot(T) = FLT for every admitted T — so `agg_ret == CT_FLT` says
    // nothing about whether `avg` ranged over an i64 column or an f64 one.
    // `sum`/`min`/`max` return their argument's type and do not need this; `avg`
    // does, and the incremental engine's accumulator layout is chosen from it
    // (deem/incr.logos, `AggState`). Reading `agg_ret` there is what silently
    // truncated every f64 addend.
    agg_argt: [i32; 8],
    // The ARGUMENT's `CTy.ordw` — this aggregate ranges over a column whose
    // order moved under the EL's i64 normalization (u64/usize). `min`/`max`
    // read it for their COMPARISON and their SEEDS, and `sum` for its
    // OVERFLOW PREDICATE; `agg_argt` cannot answer any of them because the
    // whole integer family is CT_INT.
    //
    // ⚠ THIS COMMENT USED TO SAY "`sum`/`avg` deliberately ignore it — the
    // arithmetic is not on this axis", AND THAT SENTENCE WAS THE DEFECT. The
    // cast that moves the order moves the OVERFLOW PREDICATE with it, at the
    // same values and for the same reason: a u64 sum overflows at 2^64−1, an
    // i64 sum at 2^63−1, and between the two the predicates disagree in both
    // directions — silently accepting a sum that exceeds u64, and refusing one
    // that fits. Both were measured; see `el_wrap_add`. `avg` really is off
    // this axis (it returns an f64 quotient), and it is wrong over an unsigned
    // column for a different reason — `rt_f` reads the payload signed.
    agg_argu: [bool; 8],
    // ── `order by` decisions, keyed by node word (the `jw`/`jtier` shape) ──
    // ⚠ THERE WAS NO SORT TABLE AT ALL. The checker computed the sort key's
    // type and threw it away, so the executor's comparator had two RtVals and
    // nothing else — no plan, no catalog, no type — and its integer arm could
    // only compare `rt_i` directly. This is that fact given somewhere to live.
    sw:     [i64; 8],
    sordw:  [bool; 8],
    sn:     i64,
    // projection
    ncols: i64,
    ckind: [i32; 8],
}

fn qplan_new() -> QPlan {
    return QPlan {
        jw: [0i64; 24], jtier: [0i32; 24], jequi: [0i64; 24],
        jbuild: [0i64; 24], jprobe: [0i64; 24], jn: 0i64,
        agg_n: 0i64, agg_fnid: [0i32; 8], agg_uda: [0i64; 8], agg_ret: [0i32; 8],
        agg_argt: [CT_UNKNOWN; 8], agg_argu: [false; 8],
        sw: [0i64; 8], sordw: [false; 8], sn: 0i64,
        ncols: 0i64, ckind: [0i32; 8],
    };
}

fn qp_jfind(qp: &QPlan, w: i64) -> i64 {
    let mut i: i64 = 0i64;
    while i < qp.jn {
        if qp.jw[i] == w { return i; }
        i = i + 1i64;
    }
    return -1i64;
}

// The recorded `order by` decision for the Sort node at word `w`: does its key
// need `el_wrap_ord_key` before an ordered compare? A node the checker never
// reached (or one past the table's capacity) answers false, which is the signed
// compare — the behaviour before this table existed.
fn qp_sordw(qp: &QPlan, w: i64) -> bool {
    let mut i: i64 = 0i64;
    while i < qp.sn {
        if qp.sw[i] == w { return qp.sordw[i]; }
        i = i + 1i64;
    }
    return false;
}

// ── Path splitting (REdge `path` — "a.b.c" → segments) ──────────────────────
struct PathSegs { segs: [str; 8], n: i64 }

fn split_path(p: str) -> PathSegs {
    let mut out: PathSegs = PathSegs { segs: [""; 8], n: 0i64 };
    let n: i64 = p.len();
    let mut start: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i <= n {
        let dot: bool = if i < n { str_byte_at(p, i) == 46u8 } else { true };
        if dot {
            if i > start && out.n < 8i64 {
                out.segs[out.n] = unsafe {
                    str_from_raw((p.as_ptr() as i64 + start) as *const u8, i - start)
                };
                out.n = out.n + 1i64;
            }
            start = i + 1i64;
        }
        i = i + 1i64;
    }
    return out;
}

// ── Source resolution (query scans) ─────────────────────────────────────────
// A scan source must be a QB_SRC env binding; the element type resolves LIVE
// (empty array ⇒ UNKNOWN ⇒ zero rows, every dependent check defers — nothing
// is ever evaluated over it).
fn resolve_source(name: str, cat: &SchemaCatalog, env: &QEnv, strict: bool,
                  chk: &mut Chk) -> CTy {
    let ei: i64 = env.find(name);
    if ei < 0i64 {
        if strict {
            chk_fail(chk, "unknown source '", name,
                     "' — bind it on the QEnv with bind_source before run", "", "");
        }
        return ct(CT_UNKNOWN);
    }
    if env.kinds[ei] == QB_ESRC { return ct(CT_DYNSRC); }   // lenient source
    if env.kinds[ei] == QB_TSRC { return ct(CT_TREESRC); }  // virtual tree source
    if env.kinds[ei] == QB_EDGE { return ct(CT_TREESRC); }  // pre-materialized edge rows
                                                            // — SAME vocabulary/typing
    if env.kinds[ei] != QB_SRC {
        chk_fail(chk, "source '", name,
                 "' is not bound as a source — use bind_source", "", "");
        return ct(CT_UNKNOWN);
    }
    return src_elem_ty(name, env.words[ei], cat, chk);
}

// Bind a scan/traversal row var from its collection type.
fn bind_row_var(lb: &mut CBinds, var: str, coll: CTy) {
    if coll.t == CT_ARR          { lb.bind(var, CT_NODE, coll.code); }
    else if coll.t == CT_SARR    { lb.bind_o(var, coll.code as i32, 0u64, coll.ordw); }
    else if coll.t == CT_DYNSRC  { lb.bind(var, CT_DYN, 0u64); }     // lenient row
    else if coll.t == CT_TREESRC { lb.bind(var, CT_TREEROW, 0u64); } // edge row
    else                         { lb.bind(var, CT_UNKNOWN, 0u64); }
}

// ── The QUERY check walk (SExpr checks reuse check_expr verbatim) ───────────
// Walks the SIMPLIFIED RExpr tree binding row vars in scope order, checking
// every embedded scalar clause against (catalog + env + binds + rel
// registry), and — in the STRICT phase — deciding the join cascade +
// aggregate plan + projection column kinds into `qp`.
fn check_rexpr(e: RExpr, cat: &SchemaCatalog, env: &QEnv, strict: bool,
               lb: &mut CBinds, chk: &mut Chk, qp: &mut QPlan, reg: &QRelReg) {
    if chk.failed { return; }
    match e {
        RExpr::Scan(sc) => {
            // Rel names resolve FIRST (compile-known typed columns; a rel
            // shadows a same-named env binding — I3).
            let ri: i64 = qreg_find(reg, sc.src_name);
            if ri >= 0i64 {
                lb.bind(sc.var_name, CT_RELROW, ri as u64);
                return;
            }
            let st: CTy = resolve_source(sc.src_name, cat, env, strict, chk);
            if chk.failed { return; }
            bind_row_var(lb, sc.var_name, st);
        }
        RExpr::Filter(f) => {
            check_rexpr(f.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let pt: CTy = check_expr(f.pred_expr(), cat, env, strict, lb, chk, reg);
            if !chk.failed && pt.t != CT_BOOL && !ct_is_open(pt.t) {
                chk_fail(chk, "a where/having predicate must be a bool", "", "", "", "");
            }
        }
        RExpr::Sort(s) => {
            check_rexpr(s.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let kt: CTy = check_expr(s.key_expr(), cat, env, strict, lb, chk, reg);
            if !chk.failed && ct_is_obj(kt.t) {
                chk_fail(chk, "an `order by` key must be a scalar", "", "", "", "");
            }
            // Record the key's order fact against this node, for `rt_cmp`. The
            // compile phase walks first and the strict phase re-walks the same
            // nodes, so the table is keyed by node word and UPDATED in place
            // rather than appended twice.
            //
            // ⚠ `sx_is_origin` USED TO GUARD THIS LINE, AND ITS RETIREMENT
            // CONDITION IS THIS COMMIT. The guard existed because the evaluator
            // honoured the claim at ONE position — an aggregate argument — so a
            // COMPUTED key was ordered under one rule and computed under
            // another: MEASURED on {5, 2^63, 2^64-1}, `order by (s.u / 3)`
            // returned a permutation matching NEITHER the wholly-unsigned order
            // (ids 0,1,2) NOR the wholly-signed one (1,2,0), an answer no
            // consistent reading produces. Restricting the claim to a key that
            // IS the value bought consistency at the price of being wrong about
            // computed keys.
            //
            // The claim now rides on the EXPRESSION NODE (`SBin.ordw`), so a
            // computed key is COMPUTED under the same predicate it is ORDERED
            // under, and the restriction has nothing left to protect: `kt.ordw`
            // is used directly, exactly as this comment's earlier form promised.
            // Keeping the guard afterwards would be a false comment on top of a
            // completed carrier.
            let kordw: bool = kt.ordw;
            if !chk.failed {
                let sw0: i64 = s.as_ref().raw();
                let mut si0: i64 = 0i64;
                let mut hit: bool = false;
                while si0 < qp.sn {
                    if qp.sw[si0] == sw0 { qp.sordw[si0] = kordw; hit = true; break; }
                    si0 = si0 + 1i64;
                }
                if !hit {
                    if qp.sn < 8i64 {
                        qp.sw[qp.sn] = sw0;
                        qp.sordw[qp.sn] = kordw;
                        qp.sn = qp.sn + 1i64;
                    }
                    // ⚠ SLOT 9, AND WHAT HAPPENS THERE IS NOW A REFUSAL RATHER
                    // THAN A SIGNED COMPARE. This table is keyed by Sort node
                    // word and capped at 8; past the cap the record was silently
                    // dropped and `qp_sordw` answered `false`, i.e. the ninth
                    // `order by` in one plan ranked a u64 key under the signed
                    // order with no diagnostic at all — the exact "degrades
                    // silently to signed past capacity" this codebase keeps
                    // calling out. A dropped record only CHANGES an answer when
                    // the key actually claims the moved order, so that is the
                    // condition: a claim that cannot be stored is a refusal, and
                    // a key with nothing to claim keeps the `false` that was
                    // always right for it. (Not reachable from today's surface
                    // grammar — one `order by` per plan level — which is why it
                    // was survivable, not why it was correct.)
                    else if kordw {
                        chk_fail(chk, "too many `order by` keys in one plan (limit 8) for a key whose column's order wraps — the sort plan has no slot left to record it, and ordering it signed would be a wrong answer", "", "", "", "");
                    }
                }
            }
        }
        RExpr::Edge(ed) => {
            check_rexpr(ed.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            // base var → path walk over the catalog
            let bi: i64 = lb.find(ed.base_var);
            let mut cur: CTy = ct(CT_UNKNOWN);
            if bi >= 0i64 { cur = CTy { t: lb.tags[bi], code: lb.codes[bi], ordw: false, lit: false }; }
            else if strict {
                chk_fail(chk, "unknown traversal base '", ed.base_var,
                         "' — it must be a row variable bound earlier in the chain", "", "");
                return;
            }
            if cur.t == CT_RELROW {
                chk_fail(chk, "traversal base '", ed.base_var,
                         "' binds a rel row — rel rows are scalar tuples and have no edges to traverse",
                         "", "");
                return;
            }
            if cur.t == CT_DYN {
                chk_fail(chk, "traversal base '", ed.base_var,
                         "' binds a lenient (erased) row — traversal needs a cataloged schema",
                         "", "");
                return;
            }
            let ps: PathSegs = split_path(ed.path);
            let mut vt: CTy = ct(CT_UNKNOWN);   // the new var's ELEMENT type
            let mut i: i64 = 0i64;
            while i < ps.n && !chk.failed {
                if cur.t == CT_UNKNOWN { vt = ct(CT_UNKNOWN); break; }
                if cur.t != CT_NODE {
                    chk_fail(chk, "traversal segment '", ps.segs[i],
                             "' is read off a non-object value", "", "");
                    break;
                }
                let si: i64 = cat.sidx_of_code(cur.code);
                if si < 0i64 {
                    chk_fail(chk, "traversal segment '", ps.segs[i],
                             "': the base schema is not in the catalog", "", "");
                    break;
                }
                let fi: i64 = cat.fidx(si, ps.segs[i]);
                if fi < 0i64 {
                    chk_fail(chk, "unknown field '", ps.segs[i], "' on schema '",
                             cat.s_names.get(si), "' in a traversal path");
                    break;
                }
                let last: bool = i == ps.n - 1i64;
                if !last {
                    // intermediate hop: a SINGLE-NODE edge at runtime
                    if cat.f_kinds.get(fi) != (FK_EDGE as i64) || cat.f_targets.get(fi) == 0u64 {
                        chk_fail(chk, "intermediate traversal segment '", ps.segs[i],
                                 "' must be an edge field", "", "");
                        break;
                    }
                    cur = CTy { t: CT_NODE, code: cat.f_targets.get(fi), ordw: false, lit: false };
                } else {
                    if cat.f_kinds.get(fi) == (FK_EDGE as i64) {
                        if cat.f_targets.get(fi) == 0u64 {
                            chk_fail(chk, "edge field '", ps.segs[i],
                                     "' targets a schema missing from the catalog", "", "");
                            break;
                        }
                        vt = CTy { t: CT_NODE, code: cat.f_targets.get(fi), ordw: false, lit: false };
                    } else if cat.f_kinds.get(fi) == (FK_EARR as i64) {
                        vt = CTy { t: cat.f_tys.get(fi) as i32, code: 0u64, ordw: cat.f_ordw.get(fi), lit: false };
                    } else {
                        chk_fail(chk, "traversal path must end at an edge field '",
                                 ps.segs[i], "' (a collection or single-node edge)", "", "");
                        break;
                    }
                }
                i = i + 1i64;
            }
            if chk.failed { return; }
            let mark: i64 = lb.n;
            lb.bind_o(ed.var_name, vt.t, vt.code, vt.ordw);
            if ed.has_on {
                let ot: CTy = check_expr(ed.on_expr(), cat, env, strict, lb, chk, reg);
                if !chk.failed && ot.t != CT_BOOL && !ct_is_open(ot.t) {
                    chk_fail(chk, "a join `on` predicate must be a bool", "", "", "", "");
                }
            }
            // an anti step's var binds ONLY inside its own `on`
            if ed.is_anti { lb.n = mark; }
        }
        RExpr::Join(jn) => {
            check_rexpr(jn.left_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let rs: RScan = rscan_of(jn.right_expr());
            let ri: i64 = qreg_find(reg, rs.src_name);
            if ri >= 0i64 {
                lb.bind(rs.var_name, CT_RELROW, ri as u64);
            } else {
                let st: CTy = resolve_source(rs.src_name, cat, env, strict, chk);
                if chk.failed { return; }
                bind_row_var(lb, rs.var_name, st);
            }
            let ot: CTy = check_expr(jn.on_expr(), cat, env, strict, lb, chk, reg);
            if chk.failed { return; }
            if ot.t != CT_BOOL && !ct_is_open(ot.t) {
                chk_fail(chk, "a join `on` predicate must be a bool", "", "", "", "");
                return;
            }
            if strict {
                analyze_join_step(jn.on.any().raw(), rs.var_name,
                                  jn.as_ref().raw(), cat, env, lb, qp, reg);
            }
        }
        RExpr::Anti(an) => {
            check_rexpr(an.left_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let rs: RScan = rscan_of(an.right_expr());
            let mark: i64 = lb.n;
            let ri: i64 = qreg_find(reg, rs.src_name);
            if ri >= 0i64 {
                lb.bind(rs.var_name, CT_RELROW, ri as u64);
            } else {
                let st: CTy = resolve_source(rs.src_name, cat, env, strict, chk);
                if chk.failed { return; }
                bind_row_var(lb, rs.var_name, st);
            }
            let ot: CTy = check_expr(an.on_expr(), cat, env, strict, lb, chk, reg);
            if chk.failed { return; }
            if ot.t != CT_BOOL && !ct_is_open(ot.t) {
                chk_fail(chk, "a join `on` predicate must be a bool", "", "", "", "");
                return;
            }
            if strict {
                analyze_join_step(an.on.any().raw(), rs.var_name,
                                  an.as_ref().raw(), cat, env, lb, qp, reg);
            }
            lb.n = mark;   // anti var invisible downstream
        }
        RExpr::Aggr(g) => {
            let mark: i64 = lb.n;
            check_rexpr(g.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let kt: CTy = check_expr(g.key_expr(), cat, env, strict, lb, chk, reg);
            if chk.failed { return; }
            if ct_is_obj(kt.t) {
                chk_fail(chk, "a `group by` key must be a scalar", "", "", "", "");
                return;
            }
            // f64 keys have no total order / stable hash (rt_key_hash has no F
            // arm) — the static codegen and `distinct` reject them; the dynamic
            // group-by must too, else it silently mis-buckets f64 keys.
            // ⚠ "MIS-BUCKETS" IS MEASURED, NOT PREDICTED (2026-08-08). With this
            // arm disabled (`if false &&`) and the archives rebuilt, five rows
            // with rates {NaN_p, NaN_p, +0.0, −0.0, 1.5} grouped into FOUR
            // groups through `Query::run`. PostgreSQL semantics — the rule
            // Victor set for FsKey — demands THREE (all NaNs one group, all
            // zeros one group): `rt_eq`'s float arm is raw IEEE, so the two
            // identical NaNs split into two groups while the two zeros merged.
            // Both fences (this one and the `jtier != QT_HASH` guard in
            // `Query::incremental`) held independently in that run.
            if kt.t == CT_FLT {
                chk_fail(chk, "a `group by` key cannot be f64", "", "", "", "");
                return;
            }
            let aggs: RAggArr = g.aggs_arr();
            let an2: i64 = aggs.len();
            let mut rets: [i32; 8] = [0i32; 8];
            // Does the aggregate's RESULT carry the argument's signedness? Only
            // where the result IS one of the inputs — min and max return a row's
            // own value, so a u64 column's `max` is a u64. `sum` does not (it
            // accumulates, and what unsigned accumulation MEANS is the untaken
            // decision D1), `count` is a cardinality, `avg` is a quotient in f64.
            let mut rets_ordw: [bool; 8] = [false; 8];
            let mut ci: i64 = 0i64;
            while ci < an2 && ci < 8i64 {
                let a: RAgg = aggs.agg_at(ci);
                let fnid: i32 = qagg_id(a.fn_name);
                let mut rett: i32 = CT_UNKNOWN;
                let mut argt: i32 = CT_UNKNOWN;
                let mut argu: bool = false;
                let mut uidx: i64 = -1i64;
                if fnid == 1i32 {
                    if a.has_arg {
                        chk_fail(chk, "count() takes no argument", "", "", "", "");
                        return;
                    }
                    rett = CT_INT;
                } else if fnid != 0i32 {
                    if !a.has_arg {
                        chk_fail(chk, "aggregate '", a.fn_name, "' needs an argument", "", "");
                        return;
                    }
                    let at: CTy = check_expr(a.arg_expr(), cat, env, strict, lb, chk, reg);
                    if chk.failed { return; }
                    argt = at.t;
                    argu = at.ordw;
                    if at.t == CT_DYN {
                        // The accumulator layout is chosen from the CHECKED
                        // type — a runtime-typed lenient value has none.
                        chk_fail(chk, "aggregate '", a.fn_name,
                                 "' cannot range over a lenient (erased) value — bind the source strictly",
                                 "", "");
                        return;
                    }
                    if at.t == CT_UNKNOWN {
                        rett = CT_UNKNOWN;
                    } else {
                        // the SHARED rule table (avg: T→Quot(T), Quot=FLT)
                        let r: i32 = agg_result_ty(a.fn_name, at.t);
                        if r < 0i32 {
                            chk_fail(chk, "aggregate '", a.fn_name,
                                     "' needs a numeric argument", "", "");
                            return;
                        }
                        rett = r;
                    }
                } else {
                    // UDA via the env registry (builtin names shadow UDAs)
                    uidx = env.find_agg(a.fn_name);
                    if uidx >= 0i64 {
                        if !a.has_arg {
                            chk_fail(chk, "aggregate '", a.fn_name, "' needs an argument", "", "");
                            return;
                        }
                        let at2: CTy = check_expr(a.arg_expr(), cat, env, strict, lb, chk, reg);
                        if chk.failed { return; }
                        argt = at2.t;
                        argu = at2.ordw;
                        if !ct_is_open(at2.t) && at2.t != env.a_argty[uidx] {
                            chk_fail(chk, "argument type mismatch for aggregate '",
                                     a.fn_name, "' — the registered signature differs", "", "");
                            return;
                        }
                        rett = env.a_ret[uidx];
                    } else if strict {
                        chk_fail(chk, "unknown aggregate '", a.fn_name,
                                 "' — builtins are count/sum/min/max/avg; register a UDA on the QEnv (register_agg)",
                                 "", "");
                        return;
                    }
                }
                rets[ci] = rett;
                // ⚠ WHICH AGGREGATES PASS THE ARGUMENT'S CLAIM ON TO THEIR
                // OUT-NAME, and it is the rule from `5dc76347` applied rather
                // than a list: an operation that PRESERVES one of its inputs
                // carries the claim; one that computes a new value in another
                // domain drops it. `min`/`max` RETURN an input. `sum` returns a
                // value of the argument's own type and its arithmetic is now in
                // that type, so it preserves the claim too — before this, an
                // honest u64 sum was handed downstream stripped of it, and
                // `order by sum(u64)` over three singleton groups ranked them in
                // the SIGNED order while the same query with `max` ranked them
                // correctly. `count` returns a cardinality and `avg` an f64
                // quotient; neither is on this axis.
                rets_ordw[ci] = argu && (fnid == 2i32 || fnid == 3i32 || fnid == 4i32);
                qp.agg_fnid[ci] = fnid;
                qp.agg_uda[ci]  = uidx;
                qp.agg_ret[ci]  = rett;
                qp.agg_argt[ci] = argt;
                qp.agg_argu[ci] = argu;
                ci = ci + 1i64;
            }
            qp.agg_n = ci;
            // Above the aggregate only (key + outputs) are visible.
            lb.n = mark;
            lb.bind_o("key", kt.t, kt.code, kt.ordw);
            let mut co: i64 = 0i64;
            while co < ci {
                let a2: RAgg = aggs.agg_at(co);
                // ⚠ `bind_o`, not `bind`: an aggregate's OUT-NAME is the column's own
                // value for min/max, so `order by hi` over `hi = max(s.u)` sorts a
                // u64. This was the one carrier in CBinds left binding without the
                // signedness, and it sorted signed — measured over three one-row
                // groups. Every other carrier here already used bind_o.
                lb.bind_o(a2.out, rets[co], 0u64, rets_ordw[co]);
                co = co + 1i64;
            }
        }
        RExpr::Proj(p) => {
            check_rexpr(p.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let sel: SExpr = p.sel_expr();
            match sel {
                SExpr::Tuple(tp) => {
                    let items: SExprArr = tp.items_arr();
                    let nn: i64 = items.len();
                    let mut i2: i64 = 0i64;
                    while i2 < nn && i2 < 8i64 {
                        let it: CTy = check_expr(items.arg_at(i2), cat, env, strict, lb, chk, reg);
                        if chk.failed { return; }
                        if ct_is_obj(it.t) {
                            chk_fail(chk, "a tuple projection component must be a scalar", "", "", "", "");
                            return;
                        }
                        qp.ckind[i2] = it.t;
                        i2 = i2 + 1i64;
                    }
                    qp.ncols = i2;
                }
                _ => {
                    let st2: CTy = check_expr(sel, cat, env, strict, lb, chk, reg);
                    if chk.failed { return; }
                    if st2.t == CT_ARR || st2.t == CT_SARR || st2.t == CT_DYNSRC {
                        chk_fail(chk, "cannot select a collection edge — traverse it with a join step first",
                                 "", "", "", "");
                        return;
                    }
                    if st2.t == CT_RELROW {
                        // static parity: a rel row is a fn-local tuple — no
                        // whole-row projection (select explicit columns).
                        chk_fail(chk, "cannot select a whole rel row — select explicit columns", "", "", "", "");
                        return;
                    }
                    qp.ckind[0] = st2.t;   // CT_NODE allowed (identity / find)
                    qp.ncols = 1i64;
                }
            }
        }
        RExpr::Distinct(d) => {
            check_rexpr(d.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            let mut i3: i64 = 0i64;
            while i3 < qp.ncols {
                if qp.ckind[i3] == CT_FLT {
                    chk_fail(chk, "`distinct` over an f64 projection is not supported (set semantics require Eq)",
                             "", "", "", "");
                    return;
                }
                if qp.ckind[i3] == CT_NODE {
                    chk_fail(chk, "`distinct` over an object projection is not supported", "", "", "", "");
                    return;
                }
                i3 = i3 + 1i64;
            }
        }
        RExpr::Limit(l) => {
            check_rexpr(l.input_expr(), cat, env, strict, lb, chk, qp, reg);
            if chk.failed { return; }
            if l.is_param && strict {
                let ei: i64 = env.find(l.param);
                if ei < 0i64 || env.kinds[ei] != QB_I64 {
                    chk_fail(chk, "limit parameter '", l.param,
                             "' must be bound as i64 on the QEnv", "", "");
                }
            }
        }
        RExpr::Fix(_fx) => {
            // The lowering never produces RFix (rel recursion is realized by
            // the semi-naïve materializer, not an algebra node) — defensive.
            chk_fail(chk, "internal: unexpected fixpoint node in the plan", "", "", "", "");
        }
    }
}

// ── The equi/residual split + cascade decision (runtime edition) ────────────
// The IR-level decomposition (split_and_terms / refs_mask) is REUSED from the
// shared optimizer module — identical to the static analyzer's. The TYPE
// source differs by design: the static queue reads ElTypes; here the runtime
// checker (check_expr over catalog + env + binds) types each side. First
// same-typed equi-term wins; Hash+Eq keys (INT/STR/BOOL) go hash tier, an f64
// key (PartialEq only — NaN kills Hash and total Ord) or no equi-term at all
// goes nested-loop over the FULL predicate.
fn analyze_join_step(on_w: i64, new_var: str, node_w: i64,
                     cat: &SchemaCatalog, env: &QEnv, lb: &CBinds, qp: &mut QPlan,
                     reg: &QRelReg) {
    let onr: WRef<SExpr> = WRef::<SExpr>::from_any(WAny::ref_to(on_w as *const u8));
    let mut tl: TermList = term_list_new();
    split_and_terms(onr, &mut tl);

    let mut tier: i32 = QT_LOOP;
    let mut equi_w: i64 = 0i64;
    let mut build_w: i64 = 0i64;
    let mut probe_w: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < tl.n {
        if equi_w == 0i64 {
            let te: SExpr = sx_of(tl.w[i]);
            match te {
                SExpr::Bin(b) => {
                    if b.op == OP_EQ() {
                        let lm: i32 = refs_mask(b.lhs_expr(), new_var);
                        let rm: i32 = refs_mask(b.rhs_expr(), new_var);
                        let mut cw: i64 = 0i64;   // new-side (build)
                        let mut cp: i64 = 0i64;   // bound-side (probe)
                        if lm == 1i32 && (rm & 1i32) == 0i32 { cw = b.lhs.any().raw(); cp = b.rhs.any().raw(); }
                        if rm == 1i32 && (lm & 1i32) == 0i32 { cw = b.rhs.any().raw(); cp = b.lhs.any().raw(); }
                        if cw != 0i64 {
                            // Usable key ⇔ both sides check to the SAME scalar
                            // type (no cross-type hashing via promotion — a
                            // mixed-type == stays residual, static parity).
                            // A CT_DYN (lenient) side never qualifies: the key
                            // type is unknown at check time — loop tier.
                            let mut c2: Chk = chk_new();
                            let kb: CTy = check_expr(sx_of(cw), cat, env, true, lb, &mut c2, reg);
                            let kp: CTy = check_expr(sx_of(cp), cat, env, true, lb, &mut c2, reg);
                            if !c2.failed && kb.t == kp.t {
                                if kb.t == CT_INT || kb.t == CT_STR || kb.t == CT_BOOL {
                                    tier = QT_HASH;
                                    equi_w = tl.w[i];
                                    build_w = cw;
                                    probe_w = cp;
                                } else if kb.t == CT_FLT {
                                    // equi-term exists but the key is f64 —
                                    // loop tier over the full predicate.
                                    tier = QT_LOOP;
                                    equi_w = tl.w[i];
                                    build_w = 0i64;
                                    probe_w = 0i64;
                                }
                            }
                        }
                    }
                }
                _ => { }
            }
        }
        i = i + 1i64;
    }
    if qp.jn >= 24i64 { return; }
    qp.jw[qp.jn]     = node_w;
    qp.jtier[qp.jn]  = if build_w != 0i64 { tier } else { QT_LOOP };
    qp.jequi[qp.jn]  = if build_w != 0i64 { equi_w } else { 0i64 };
    qp.jbuild[qp.jn] = build_w;
    qp.jprobe[qp.jn] = probe_w;
    qp.jn = qp.jn + 1i64;
}

// ═══════════════════════════════════════════════════════════════════════════
// The REL-FIELD REWRITE (I3, compile-time, ONCE per Query) — `p.b` where `p`
// binds a rel row becomes ONE ident named "p.b" (rel rows are RtVal column
// groups, not Writ nodes — there is no object to field_read). The checker
// decodes the dotted name against the registry (check_root); the executor
// binds the dotted names as RowSet columns; refs_mask treats "p.b" as a
// reference to "p" (the shared-optimizer extension), so the join cascade
// works unchanged. The pass also collects each body's IN-SCC source
// OCCURRENCES (the semi-naïve delta variants) and gates the borrow-outward
// forms (whole-row select, traversal off a rel var) — static parity.
// ═══════════════════════════════════════════════════════════════════════════

// Rel vars in scope during the rewrite walk (var name → rel registry idx).
struct RwScope { vars: [str; 12], rel: [i64; 12], n: i64 }
fn rwscope_new() -> RwScope { return RwScope { vars: [""; 12], rel: [0i64; 12], n: 0i64 }; }
fn rw_find(sc: &RwScope, name: str) -> i64 {
    let mut i: i64 = 0i64;
    while i < sc.n {
        if str_eq(sc.vars[i], name) { return i; }
        i = i + 1i64;
    }
    return -1i64;
}

// The name of a BARE ident node ("" otherwise). The EL parser spells bare
// idents as SField with a NULL base; SVar covers hand-built IR.
fn sident_name(e: SExpr) -> str {
    match e {
        SExpr::Field(f) => {
            let bref: WRef<SExpr> = f.base;
            if bref.any().is_null() { return f.name; }
            return "";
        }
        SExpr::Var(v) => { return v.name; }
        _ => { return ""; }
    }
}

// Rewrite rel-column reads inside one scalar expression (in place; child
// edges are rebound — the simplify_all discipline). Returns the (possibly
// replaced) edge for the caller to rebind.
fn rw_expr(eref: WRef<SExpr>, sc: &RwScope, reg: &QRelReg, h: &Writ,
           chk: &mut Chk) -> WRef<SExpr> {
    if eref.any().is_null() || chk.failed { return eref; }
    let e: SExpr = eref.any().view::<SExpr>();
    match e {
        SExpr::Field(f) => {
            let bref: WRef<SExpr> = f.base;
            if bref.any().is_null() { return eref; }   // bare ident — no rewrite
            // `<relvar>.<col>` — the direct hit.
            let bn: str = sident_name(f.base_expr());
            if bn.len() > 0i64 {
                let vi: i64 = rw_find(sc, bn);
                if vi >= 0i64 {
                    let ri: i64 = sc.rel[vi];
                    let ci: i64 = qreg_col(reg, ri, f.name);
                    if ci < 0i64 {
                        chk_fail(chk, "unknown column '", f.name, "' on rel '",
                                 reg.names[ri], "'");
                        return eref;
                    }
                    let mut nm: String = String::new();
                    nm.push_str(bn);
                    nm.push_str(".");
                    nm.push_str(f.name);
                    // make_ident_sel boxes the name into the Query's doc.
                    return make_ident_sel(h, sstr(&nm));
                }
            }
            f.base = rw_expr(f.base, sc, reg, h, chk);
            if chk.failed { return eref; }
            // A rewritten base is a DOTTED ident ⇒ `p.col.x` — rel columns
            // are scalars, nothing deeper exists.
            let nb: str = sident_name(f.base_expr());
            if nb.len() > 0i64 && dotted_at(nb) > 0i64 {
                chk_fail(chk, "field '.", f.name,
                         "' is read off a rel column — rel columns are scalars", "", "");
            }
            return eref;
        }
        SExpr::Bin(b) => {
            b.lhs = rw_expr(b.lhs, sc, reg, h, chk);
            b.rhs = rw_expr(b.rhs, sc, reg, h, chk);
            return eref;
        }
        SExpr::Un(u) => {
            u.arg = rw_expr(u.arg, sc, reg, h, chk);
            return eref;
        }
        SExpr::Cond(c) => {
            c.c = rw_expr(c.c, sc, reg, h, chk);
            c.t = rw_expr(c.t, sc, reg, h, chk);
            c.e = rw_expr(c.e, sc, reg, h, chk);
            return eref;
        }
        SExpr::Call(cl) => {
            let mut args: SExprArr = cl.args_arr();
            let na: i64 = args.len();
            let mut i: i64 = 0i64;
            while i < na {
                let ar: WRef<SExpr> = WRef::<SExpr>::from_any(args.arg_any(i));
                let nr: WRef<SExpr> = rw_expr(ar, sc, reg, h, chk);
                if nr.any().raw() != ar.any().raw() { args.set_arg(i, nr.any()); }
                i = i + 1i64;
            }
            return eref;
        }
        SExpr::Tuple(tp) => {
            let mut items: SExprArr = tp.items_arr();
            let ni: i64 = items.len();
            let mut k: i64 = 0i64;
            while k < ni {
                let ir: WRef<SExpr> = WRef::<SExpr>::from_any(items.arg_any(k));
                let nr2: WRef<SExpr> = rw_expr(ir, sc, reg, h, chk);
                if nr2.any().raw() != ir.any().raw() { items.set_arg(k, nr2.any()); }
                k = k + 1i64;
            }
            return eref;
        }
        _ => { return eref; }
    }
}

// Whole-row projection gate: a bare rel var at the select root / as a tuple
// component has no sound projection (static parity — rel rows are column
// groups; select explicit columns).
fn rw_gate_comp(e: SExpr, sc: &RwScope, reg: &QRelReg, chk: &mut Chk) {
    let n: str = sident_name(e);
    if n.len() > 0i64 {
        let vi: i64 = rw_find(sc, n);
        if vi >= 0i64 {
            chk_fail(chk, "`select ", n, "` projects the whole rel row '",
                     reg.names[sc.rel[vi]], "' — select explicit columns instead");
        }
    }
}
fn rw_sel_gate(sel: SExpr, sc: &RwScope, reg: &QRelReg, chk: &mut Chk) {
    match sel {
        SExpr::Tuple(tp) => {
            let items: SExprArr = tp.items_arr();
            let mut i: i64 = 0i64;
            while i < items.len() && !chk.failed {
                rw_gate_comp(items.arg_at(i), sc, reg, chk);
                i = i + 1i64;
            }
        }
        _ => { rw_gate_comp(sel, sc, reg, chk); }
    }
}

// The RExpr rewrite walk: binds rel scan vars into the scope, rewrites every
// embedded scalar clause, gates the borrow-outward forms, and — when
// `occ_c >= 0` (a body of a RECURSIVE SCC) — collects the body's in-SCC scan
// occurrences (node word + rel idx): the semi-naïve delta variants.
fn rw_walk(rref: WRef<RExpr>, sc: &mut RwScope, reg: &QRelReg, h: &Writ,
           chk: &mut Chk, occ_c: i64,
           ow: &mut [i64; 9], orel: &mut [i64; 9], on_: &mut i64) {
    if rref.any().is_null() || chk.failed { return; }
    let e: RExpr = rref.any().view::<RExpr>();
    match e {
        RExpr::Scan(s) => {
            let ri: i64 = qreg_find(reg, s.src_name);
            if ri >= 0i64 {
                if sc.n < 12i64 {
                    sc.vars[sc.n] = s.var_name;
                    sc.rel[sc.n]  = ri;
                    sc.n = sc.n + 1i64;
                }
                if occ_c >= 0i64 && reg.comp[ri] == occ_c {
                    if *on_ >= 9i64 {
                        chk_fail(chk, "too many recursive source references in one rel body", "", "", "", "");
                    } else {
                        ow[*on_]   = s.as_ref().raw();
                        orel[*on_] = ri;
                        *on_ = *on_ + 1i64;
                    }
                }
            }
        }
        RExpr::Filter(f) => {
            rw_walk(f.input, sc, reg, h, chk, occ_c, ow, orel, on_);
            f.pred = rw_expr(f.pred, sc, reg, h, chk);
        }
        RExpr::Sort(s2) => {
            rw_walk(s2.input, sc, reg, h, chk, occ_c, ow, orel, on_);
            s2.key = rw_expr(s2.key, sc, reg, h, chk);
        }
        RExpr::Edge(ed) => {
            rw_walk(ed.input, sc, reg, h, chk, occ_c, ow, orel, on_);
            if chk.failed { return; }
            if rw_find(sc, ed.base_var) >= 0i64 {
                chk_fail(chk, "traversal base '", ed.base_var,
                         "' binds a rel row — rel rows are scalar tuples and have no edges to traverse",
                         "", "");
                return;
            }
            if ed.has_on { ed.on = rw_expr(ed.on, sc, reg, h, chk); }
        }
        RExpr::Join(j) => {
            rw_walk(j.left, sc, reg, h, chk, occ_c, ow, orel, on_);
            rw_walk(j.right, sc, reg, h, chk, occ_c, ow, orel, on_);
            j.on = rw_expr(j.on, sc, reg, h, chk);
        }
        RExpr::Anti(a) => {
            rw_walk(a.left, sc, reg, h, chk, occ_c, ow, orel, on_);
            let mark: i64 = sc.n;
            rw_walk(a.right, sc, reg, h, chk, occ_c, ow, orel, on_);
            a.on = rw_expr(a.on, sc, reg, h, chk);
            sc.n = mark;   // an anti var binds only inside its own `on`
        }
        RExpr::Aggr(g) => {
            rw_walk(g.input, sc, reg, h, chk, occ_c, ow, orel, on_);
            g.key = rw_expr(g.key, sc, reg, h, chk);
            let aggs: RAggArr = g.aggs_arr();
            let na: i64 = aggs.len();
            let mut i: i64 = 0i64;
            while i < na && !chk.failed {
                let a2: RAgg = aggs.agg_at(i);
                if a2.has_arg { a2.arg = rw_expr(a2.arg, sc, reg, h, chk); }
                i = i + 1i64;
            }
        }
        RExpr::Proj(p) => {
            rw_walk(p.input, sc, reg, h, chk, occ_c, ow, orel, on_);
            if chk.failed { return; }
            rw_sel_gate(p.sel_expr(), sc, reg, chk);
            if chk.failed { return; }
            p.sel = rw_expr(p.sel, sc, reg, h, chk);
        }
        RExpr::Distinct(d) => { rw_walk(d.input, sc, reg, h, chk, occ_c, ow, orel, on_); }
        RExpr::Limit(l)    => { rw_walk(l.input, sc, reg, h, chk, occ_c, ow, orel, on_); }
        RExpr::Fix(_fx)    => { }
    }
}
