// logos.std.deem — the PUBLIC runtime query/template API (ADR 0012-queue2 §3,
// slices I1–I3). Query/template TEXT arrives at RUNTIME, is parsed by the SAME
// peg-generated parsers the static queue uses, checked against a SchemaCatalog
// (queue-1-generated schema metadata), lowered/optimized by the SAME
// `lower_rquery_to_rexpr` / `simplify_*` IR passes, and executed by a
// tree-walk evaluator over the schema'd Writ IR. No metacall, no codegen.
//
// I3 adds: dynamic `rel` blocks with the SEMI-NAÏVE fixpoint re-hosted as an
// interpreter loop (SCC condensation + stratification at Query::compile —
// the SAME graph algorithm as the static walker, shared via
// logos.std.wql.params), and LENIENT mode (bind_node_erased /
// bind_source_erased + catalog FK_ANY fields): fields on erased sources
// resolve at runtime by NAME, misses yield RtVal::Null, and Null propagates
// CEL-style (see ADR 0012-queue2 §4 for the exact table).
//
//   let cat: SchemaCatalog = cat();          // resource cat = schema_catalog!{ Emp, … };
//   let t: Tpl = Tpl::compile("Hello {{ e.name }}", &cat)?;   // Result<Tpl, QError>
//   let mut env: QEnv = QEnv::new();
//   env.bind_node("e", emp_any);             // a schema'd Writ object (TOM)
//   let s: String = t.render(&env)?;         // Result<String, QError>
//
//   let q: Query = Query::compile("from emps e where e.age >= n select e.name", &cat)?;
//   env.bind_source("emps", emps_warray);    // a Writ ARRAY of schema'd rows
//   env.bind_i64("n", 40);
//   let rows: QRows = q.run(&env)?;          // compile-once / run-many
//
// DESIGN NOTES:
//   • This package is the ABI-carried stability surface (logos.std.wql.* stays
//     ABI-excluded engine internals). Public types: SchemaCatalog, QEnv, Tpl,
//     Query, QRows, QError, RtVal (+ the QFn/QAgg* fn-ptr aliases — the
//     UDF/UDA registration surface, ADR §6). The evaluator internals stay
//     private.
//   • ERRORS ARE VALUES (Result + message), never compile diagnostics — the
//     caller is a running program (ADR §3). `Tpl::compile` runs the
//     env-INDEPENDENT checks (parse, unknown fn/arity, comprehension/tuple
//     rejection, catalog-wide unknown-field, literal type conflicts) + the
//     optimizer; the FULL strict check (var→schema resolution, field types)
//     needs the env's declarations, so it runs at the top of every `render`
//     (a cheap IR walk) — the fixed compile(text,&cat)/render(&env) API puts
//     the env in scope only at render time.
//   • STRICT typing only (ADR §4): every template root name must resolve to a
//     QEnv binding; every field to a catalog entry. Lenient/erased mode lands
//     in a later slice.
//   • RtVal str OWNERSHIP: RtVal::S carries a `str` VIEW into (a) the Tpl's own
//     IR doc (literals), (b) the caller's data doc (field reads), or (c) a
//     per-render scratch Writ arena (computed strings: concat/upper/lower are
//     interned into the scratch, whose segments never move and outlive the
//     walk). The rendered String is built before the scratch drops.
//   • Unset schema fields read as their WritField defaults (0 / "" / false /
//     0.0 / null-edge) — the SAME semantics the static schema accessors
//     compile to. A null/non-array edge iterates as an EMPTY `{% for %}`.
//   • Integer `/`/`%` by zero traps at eval time, exactly like the static
//     queue's emitted code (documented I1 semantics; a checked value-error
//     path is an I2+ concern).
//   • CATALOG SEAM (cross-module schemas): the entry representation is the
//     `add_schema`/`add_field`/`add_edge` builder-call sequence, PUBLIC so a
//     future decl-site annotation (derive-style hook on the schema decl) can
//     emit the same per-schema entry calls for schemas declared in OTHER
//     modules than the schema_catalog! callsite (same-module reflection is
//     the I1 MVP).
package logos.mem.deem;

use logos.lang.writ.container;    // Writ / writ_new
use logos.lang.writ.anyval;       // WAny
use logos.lang.writ.wmap;         // WMap<Wu6, WAny> — TOM reads (schema field gets)
use logos.lang.writ.array;        // WArray — edge-field iteration
use logos.lang.writ.wstring;      // WString / as_wstr — string payloads + interning
use logos.lang.writ.wstatic;      // WritStatic — the rodata metadata-blob handle
use logos.lang.writ.static_view;  // WView2 — reader over rodata Writ blobs
use logos.lang.result;            // Result — the error-as-value carrier
use logos.lang.option;            // Option — HashMapKeys iterator item (SEMILATTICE rescan)
use logos.lang.panic;             // panic — recursive-aggregate convergence guard (slice-7)
use logos.mem.string;             // String
use logos.lang.mem;               // replace — FactStore::take_delta move-out
use logos.lang.num.float;         // f64_to_bits — FsKey f64 content-hash
use logos.lang.str;               // str_eq / str_cmp / str_contains / str_starts_with / …
use logos.lang.arith;             // wrapping_mul — the FNV mix wraps by design
use logos.std.wql.ir;             // SExpr family + WRef (the shared IR)
use logos.std.wql.el;             // EL_TY_* / OP_* / builtin registry / agg rule table
use logos.std.wql.optimize;       // simplify_sexpr / simplify_rexpr_ref + TermList analysis
use logos.std.wql.trama;          // TStmt family + chain_array / next_of_stmt / ttext_str
use logos.std.wql.trama_parser;   // parse_tpl — the reused generated template parser
use logos.std.wql.plan;           // RQuery / RQProgram — the surface query plan views
use logos.std.wql.wql_surface_parser;  // parse_program — the reused generated query parser
use logos.std.wql.lower;          // lower_rquery_to_rexpr — the reused PLAN→ALGEBRA lowering
use logos.std.wql.params;         // RelDeps / RelScc / compute_rel_scc — the SHARED
                                  // (metaprog-free) rel dependency-graph half (I3)
use logos.mem.collections.vec;    // Vec — row pipelines (unbounded)
use logos.mem.collections.hashmap;// HashMap — hash-join buckets / distinct sets

// ═══════════════════════════════════════════════════════════════════════════
// QError — a positioned runtime error VALUE.
// The generated parsers do not stamp source offsets into IR nodes (yet), so
// the position is carried as the OFFENDING NAME/OPERATOR inside the message.
// ═══════════════════════════════════════════════════════════════════════════
/// Runtime error value returned by the fallible Deem APIs (`compile`/`render`/`run`).
/// Carries the offending name/operator inside the message text; no source offsets.
pub struct QError {
    /// The owned error message text.
    pub msg: String,
}

impl QError {
    /// Returns the error text as a borrowed `str` view, valid while the `QError` lives.
    pub fn message(self: &QError) -> str {
        return unsafe { str_from_raw(self.msg.as_ptr(), self.msg.len()) };
    }
}

// Build a QError from a literal message.
fn qerr(m: str) -> QError {
    let mut s: String = String::new();
    s.push_str(m);
    return QError { msg: s };
}

// Build a QError from up to five message parts (the chk_fail shape, but as a
// DIRECT value — usable inside loops where moving a Chk out is awkward).
fn qfail(a: str, b: str, c: str, d: str, e: str) -> QError {
    let mut s: String = String::new();
    s.push_str(a);
    s.push_str(b);
    s.push_str(c);
    s.push_str(d);
    s.push_str(e);
    return QError { msg: s };
}

// &String → borrowed str view (the codegen string_as_str shape, local to keep
// this package free of metaprog-importing dependencies).
fn sstr(s: &String) -> str {
    return unsafe { str_from_raw(s.as_ptr(), s.len()) };
}

// SView2 (rodata-blob string view) → str.
fn sview2_str(v: SView2) -> str {
    if v.ptr == (0 as *const u8) { return ""; }
    return unsafe { str_from_raw(v.ptr, v.len as i64) };
}

// ═══════════════════════════════════════════════════════════════════════════
// SchemaCatalog — runtime schema metadata (ADR §5).
// schema code → { field name → (key code, value type, edge target) }.
// Filled by the queue-1 `schema_catalog!{ S1, S2, … }` macro (which reflects
// the schema decls and emits the add_* calls), or by any other emitter that
// speaks the same builder calls (the decl-site annotation seam).
// ═══════════════════════════════════════════════════════════════════════════

// Field kinds.
const FK_SCALAR: i32 = 0i32;   // i64/str/bool/f64 family — f_tys holds EL_TY_*
const FK_EDGE:   i32 = 1i32;   // WRef<S> — f_targets holds S's schema code
const FK_ANY:    i32 = 2i32;   // WAny — type-erased (strict mode rejects access)
const FK_EARR:   i32 = 3i32;   // WRef<scalar> — a SCALAR-ELEMENT array edge
                               // (WRef<str>/<i64>/…): f_tys holds the ELEMENT
                               // EL type. Emitted by the same catalog blob
                               // entry shape as a schema edge ({"ty":"edge",
                               // "target":"str"}) — the scalar target NAME is
                               // the discriminator (primitive names cannot
                               // name schemas). I2 extension per I1's note.

const CAT_SCHEMAS: i64 = 16i64;
const CAT_FIELDS:  i64 = 96i64;

// LAYOUT NOTE (I3): the tables are Vec-BACKED. A SchemaCatalog rides inside
// every Tpl/Query value; with inline fixed arrays the struct was ~3.6KB and
// every generic instantiation over Option<Tpl>/Result<Query,·> scalarized
// those kilobytes into unrolled per-word copies — minutes-long stdlib builds
// (the queue-2 I3 build-time incident). Vec-backing keeps the value a few
// words; the (tiny) CAT_* caps are kept for behavior parity.
pub struct SchemaCatalog {
    // schemas
    s_names: Vec<str>,
    pub s_codes: Vec<u64>,
    s_n:     i64,
    // fields (flat, owner-indexed)
    pub f_owner:   Vec<i64>,   // index into the schema tables
    pub f_names:   Vec<str>,
    pub f_keys:    Vec<i64>,   // TOM key code
    f_tys:     Vec<i64>,   // EL_TY_* (FK_SCALAR only)
    f_kinds:   Vec<i64>,   // FK_*
    f_targets: Vec<u64>,   // FK_EDGE: target schema code (0 = unresolved)
    f_tnames:  Vec<str>,   // FK_EDGE: target schema NAME (late resolution)
    pub f_n:       i64,
}

impl SchemaCatalog {
    pub fn new() -> SchemaCatalog {
        return SchemaCatalog {
            s_names: vec_new::<str>(), s_codes: vec_new::<u64>(), s_n: 0i64,
            f_owner: vec_new::<i64>(), f_names: vec_new::<str>(), f_keys: vec_new::<i64>(),
            f_tys: vec_new::<i64>(), f_kinds: vec_new::<i64>(), f_targets: vec_new::<u64>(),
            f_tnames: vec_new::<str>(), f_n: 0i64,
        };
    }

    // Internal: schema index by name / code (-1 = absent).
    pub fn sidx_of_name(self: &SchemaCatalog, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.s_n {
            if str_eq(self.s_names.get(i), name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
    fn sidx_of_code(self: &SchemaCatalog, code: u64) -> i64 {
        if code == 0u64 { return -1i64; }
        let mut i: i64 = 0i64;
        while i < self.s_n {
            if self.s_codes.get(i) == code { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
    // Internal: field index within schema `si` (-1 = absent).
    fn fidx(self: &SchemaCatalog, si: i64, fname: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.f_n {
            if self.f_owner.get(i) == si && str_eq(self.f_names.get(i), fname) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
    // ── Builder API (the catalog-entry representation; emitted by macros) ──
    // Register a schema (name + its `code(…)` value). Idempotent by name.
    // Backfills any edge fields whose target name matches (so multi-blob
    // aggregation — the decl-site annotation route — is order-independent).
    pub fn add_schema(self: &mut SchemaCatalog, name: str, code: u64) {
        if self.sidx_of_name(name) >= 0i64 { return; }
        if self.s_n >= CAT_SCHEMAS { return; }
        self.s_names.push(name);
        self.s_codes.push(code);
        self.s_n = self.s_n + 1i64;
        let mut i: i64 = 0i64;
        while i < self.f_n {
            if self.f_kinds.get(i) == (FK_EDGE as i64) && self.f_targets.get(i) == 0u64
               && str_eq(self.f_tnames.get(i), name) {
                self.f_targets.set(i, code);
            }
            i = i + 1i64;
        }
    }

    // Register a SCALAR (or erased) field: `ty` ∈ i64/f64/bool/str/any
    // (canonical value-type names; the integer/float families are already
    // collapsed by the emitter). Unknown ty names register as erased.
    pub fn add_field(self: &mut SchemaCatalog, sname: str, field: str, key: i64, ty: str) {
        let si: i64 = self.sidx_of_name(sname);
        if si < 0i64 { return; }
        if self.f_n >= CAT_FIELDS { return; }
        // ⚠ "CANONICAL value-type name" IS a fact about the type, not a list of
        // four spellings: `ElTy.canon` says the type is the one the EL actually
        // computes in. `u64` and `String` are in the lattice and are NOT their own
        // representation, so they register erased exactly as before — but now for
        // a stated reason rather than by absence from a chain of `str_eq`.
        let r: ElTy = el_ty(ty);
        let mut k: i32 = FK_SCALAR;
        let mut t: i32 = EL_TY_INT();
        if r.canon { t = r.cls; } else { k = FK_ANY; }
        self.f_owner.push(si);
        self.f_names.push(field);
        self.f_keys.push(key);
        self.f_tys.push(t as i64);
        self.f_kinds.push(k as i64);
        self.f_targets.push(0u64);
        self.f_tnames.push("");
        self.f_n = self.f_n + 1i64;
    }

    // Register an EDGE field (`WRef<Target>` — by convention holds a Writ
    // ARRAY of Target objects OR a SINGLE Target object; iteration adapts to
    // the runtime shape). A target not yet registered stays code 0 and is
    // BACKFILLED when its schema arrives (add_schema) — a target never
    // registered is diagnosed on use.
    // SCALAR-ELEMENT arrays (I2): a `target` naming a PRIMITIVE type
    // (str/i64 family/f64/bool — `el_ret_class`-classifiable) registers an
    // FK_EARR field instead: the value is a Writ array of SCALARS, and the
    // element EL type is recorded in `f_tys`. Both emission routes (the
    // schema_catalog! macro and the future decl-site annotation) use the SAME
    // blob entry shape — {"ty":"edge","target":"<name>"} — the name decides.
    pub fn add_edge(self: &mut SchemaCatalog, sname: str, field: str, key: i64, target: str) {
        let si: i64 = self.sidx_of_name(sname);
        if si < 0i64 { return; }
        if self.f_n >= CAT_FIELDS { return; }
        let scls: i32 = el_ret_class(target);
        if scls >= 0i32 {
            self.f_owner.push(si);
            self.f_names.push(field);
            self.f_keys.push(key);
            self.f_tys.push(scls as i64);
            self.f_kinds.push(FK_EARR as i64);
            self.f_targets.push(0u64);
            self.f_tnames.push(target);
            self.f_n = self.f_n + 1i64;
            return;
        }
        let ti: i64 = self.sidx_of_name(target);
        let tcode: u64 = if ti >= 0i64 { self.s_codes.get(ti) } else { 0u64 };
        self.f_owner.push(si);
        self.f_names.push(field);
        self.f_keys.push(key);
        self.f_tys.push(EL_TY_INT() as i64);
        self.f_kinds.push(FK_EDGE as i64);
        self.f_targets.push(tcode);
        self.f_tnames.push(target);
        self.f_n = self.f_n + 1i64;
    }

    // ── The RODATA channel (ADR queue-2 §5 — the designated metadata path) ──
    // annotation/macro → metaprog hook → rodata Writ blob → runtime view.
    // `schema_catalog!` emits a `@{…}` static Writ blob (content-deduped
    // rodata) with the GENERIC typed-metadata-entry envelope:
    //
    //   { "v": 1, "entries": [
    //       { "kind": "schema", "name": "Emp", "code": <u64>,
    //         "fields": [ { "name": "age", "key": 1, "ty": "i64" },
    //                     { "name": "emps", "key": 2, "ty": "edge", "target": "Emp" } ] },
    //       …                                    // "fn" entries etc. ride the
    //   ] }                                      // same array in later slices
    //
    // and this ctor INDEXES it (two passes: schemas, then fields — edge
    // targets resolve by name against pass 1). The `str` views point INTO the
    // rodata blob: zero-copy, 'static. Unknown entry kinds are skipped
    // (forward-compatible envelope).
    pub fn from_static(blob: WritStatic) -> SchemaCatalog {
        let mut c: SchemaCatalog = SchemaCatalog::new();
        c.merge_static(blob);
        return c;
    }

    // Aggregate ANOTHER metadata blob into this catalog (the decl-site
    // annotation route: one per-schema blob per decl, merged at the pickup
    // point). Order-independent: edge targets resolving to a schema merged
    // LATER are backfilled by add_schema.
    pub fn merge_static(self: &mut SchemaCatalog, blob: WritStatic) {
        let c: &mut SchemaCatalog = self;
        let vw: WView2 = wview2_from_ptr(blob.ptr);
        let root: WAny = vw.root();
        let ents: WAny = vw.map_get(root, "entries");
        let n: u64 = vw.array_len(ents);
        // pass 1 — schema entries
        let mut i: u64 = 0u64;
        while i < n {
            let e: WAny = vw.array_get(ents, i);
            if str_eq(sview2_str(vw.get_str_view(vw.map_get(e, "kind"))), "schema") {
                c.add_schema(sview2_str(vw.get_str_view(vw.map_get(e, "name"))),
                             vw.get_u64(vw.map_get(e, "code")));
            }
            i = i + 1u64;
        }
        // pass 2 — fields (edge targets now resolvable)
        let mut j: u64 = 0u64;
        while j < n {
            let e2: WAny = vw.array_get(ents, j);
            if str_eq(sview2_str(vw.get_str_view(vw.map_get(e2, "kind"))), "schema") {
                let sname: str = sview2_str(vw.get_str_view(vw.map_get(e2, "name")));
                let flds: WAny = vw.map_get(e2, "fields");
                let nf: u64 = vw.array_len(flds);
                let mut k: u64 = 0u64;
                while k < nf {
                    let f: WAny = vw.array_get(flds, k);
                    let fname: str = sview2_str(vw.get_str_view(vw.map_get(f, "name")));
                    let key: i64 = vw.get_int(vw.map_get(f, "key"));
                    let ty: str = sview2_str(vw.get_str_view(vw.map_get(f, "ty")));
                    if str_eq(ty, "edge") {
                        c.add_edge(sname, fname, key,
                                   sview2_str(vw.get_str_view(vw.map_get(f, "target"))));
                    } else {
                        c.add_field(sname, fname, key, ty);
                    }
                    k = k + 1u64;
                }
            }
            j = j + 1u64;
        }
    }

    // ── Probe API (tests / tooling) ────────────────────────────────────────
    // The registered code of schema `name` (0 = not in the catalog).
    pub fn schema_code(self: &SchemaCatalog, name: str) -> u64 {
        let si: i64 = self.sidx_of_name(name);
        if si < 0i64 { return 0u64; }
        return self.s_codes.get(si);
    }
    // The TOM key of `schema.field` (-1 = unknown).
    pub fn field_key(self: &SchemaCatalog, sname: str, field: str) -> i64 {
        let si: i64 = self.sidx_of_name(sname);
        if si < 0i64 { return -1i64; }
        let fi: i64 = self.fidx(si, field);
        if fi < 0i64 { return -1i64; }
        return self.f_keys.get(fi);
    }
    // The value-type name of `schema.field`: "i64"/"f64"/"bool"/"str" for
    // scalars, "edge" for WRef<S> fields, "arr:i64"/"arr:f64"/"arr:bool"/
    // "arr:str" for scalar-element array edges, "any" for erased, "" unknown.
    pub fn field_ty(self: &SchemaCatalog, sname: str, field: str) -> str {
        let si: i64 = self.sidx_of_name(sname);
        if si < 0i64 { return ""; }
        let fi: i64 = self.fidx(si, field);
        if fi < 0i64 { return ""; }
        if self.f_kinds.get(fi) == (FK_EDGE as i64) { return "edge"; }
        if self.f_kinds.get(fi) == (FK_EARR as i64) {
            let t2: i32 = self.f_tys.get(fi) as i32;
            if t2 == EL_TY_STR()  { return "arr:str"; }
            if t2 == EL_TY_BOOL() { return "arr:bool"; }
            if t2 == EL_TY_FLT()  { return "arr:f64"; }
            return "arr:i64";
        }
        if self.f_kinds.get(fi) == (FK_ANY as i64)  { return "any"; }
        let t: i32 = self.f_tys.get(fi) as i32;
        if t == EL_TY_STR()  { return "str"; }
        if t == EL_TY_BOOL() { return "bool"; }
        if t == EL_TY_FLT()  { return "f64"; }
        return "i64";
    }
}

// Element-wise copy (a Tpl owns its catalog snapshot; compile-once/run-many
// must not depend on the caller keeping the source catalog alive).
fn catalog_clone(src: &SchemaCatalog) -> SchemaCatalog {
    let mut c: SchemaCatalog = SchemaCatalog::new();
    let mut i: i64 = 0i64;
    while i < src.s_n {
        c.s_names.push(src.s_names.get(i));
        c.s_codes.push(src.s_codes.get(i));
        i = i + 1i64;
    }
    c.s_n = src.s_n;
    let mut j: i64 = 0i64;
    while j < src.f_n {
        c.f_owner.push(src.f_owner.get(j));
        c.f_names.push(src.f_names.get(j));
        c.f_keys.push(src.f_keys.get(j));
        c.f_tys.push(src.f_tys.get(j));
        c.f_kinds.push(src.f_kinds.get(j));
        c.f_targets.push(src.f_targets.get(j));
        c.f_tnames.push(src.f_tnames.get(j));
        j = j + 1i64;
    }
    c.f_n = src.f_n;
    return c;
}

// ═══════════════════════════════════════════════════════════════════════════
// QEnv — name → value/source bindings (ADR §3). Binds schema'd Writ objects
// (bind_node — the schema code is read off the object's TOM) and scalar
// params. `str` bindings are borrowed views: the caller keeps the source
// alive across `render` (string literals are 'static and always fine).
// ═══════════════════════════════════════════════════════════════════════════

const QB_I64:   i32 = 1i32;
const QB_F64:   i32 = 2i32;
const QB_BOOL:  i32 = 3i32;
const QB_STR:   i32 = 4i32;
const QB_NODE:  i32 = 5i32;
const QB_SRC:   i32 = 6i32;   // a query SOURCE: a Writ ARRAY of schema'd rows
const QB_ENODE: i32 = 7i32;   // an ERASED node (lenient, ADR §4): fields resolve
                              // at runtime by NAME; misses read as Null
const QB_ESRC:  i32 = 8i32;   // an ERASED source: a Writ array of lenient rows
const QB_TSRC:  i32 = 9i32;   // a TREE source (bind_source_tree): a Writ VALUE
                              // (map/array root) scanned VIRTUALLY — one row
                              // per EDGE of the tree, no materialization (the
                              // no-gratuitous-materialization rule). Columns
                              // are fixed: (parent, key, idx, child, kind,
                              // vi, vs) — see the checker's CT_TREEROW table.

const QB_EDGE:  i32 = 10i32;  // PRE-MATERIALIZED edge rows (bind_edge_rows):
                              // a Writ array of 8-element rows in the SAME
                              // graph-edge vocabulary as QB_TSRC — the runtime
                              // twin of a #[derive_graph_source] materializer.

const QENV_CAP: i64 = 24i64;
// UDF/UDA registry capacities (metadata tables — rows are Vec-backed).
const QENV_FNS:     i64 = 8i64;
const QENV_FN_ARGS: i64 = 4i64;   // max declared args per UDF
const QENV_AGGS:    i64 = 4i64;

/// Runtime binding environment for `Tpl::render` / `Query::run`: named scalar parameters,
/// data nodes/sources, and the UDF/UDA registry.
/// Holds at most 24 value/source bindings; binds past capacity are silently ignored.
/// Rebinding an existing name overwrites it (last write wins).
pub struct QEnv {
    names: [str; 24],
    kinds: [i32; 24],
    ivals: [i64; 24],
    fvals: [f64; 24],
    bvals: [bool; 24],
    svals: [str; 24],
    words: [i64; 24],   // node/source bindings: the WAny ref word
    codes: [u64; 24],   // node bindings: the object's schema code
    n:     i64,
    // ── UDF registry (ADR §6) — name + ptr + DECLARED signature ──────────
    f_names: [str; 8],
    f_ptrs:  [QFn; 8],
    f_arity: [i64; 8],
    f_args:  [i32; 32],   // flattened [fn][arg] EL types (QENV_FN_ARGS stride)
    f_ret:   [i32; 8],    // EL return type
    f_n:     i64,
    // ── UDA registry — init/step/fin triple + declared arg/ret EL types ──
    a_names: [str; 4],
    a_init:  [QAggInit; 4],
    a_step:  [QAggStep; 4],
    a_fin:   [QAggFin; 4],
    a_argty: [i32; 4],
    a_ret:   [i32; 4],
    a_n:     i64,
}

impl QEnv {
    /// Creates an empty environment with no bindings and no registered UDFs/UDAs.
    pub fn new() -> QEnv {
        let dfn: QFn      = qfn_nop;
        let din: QAggInit = qagg_init_nop;
        let dst: QAggStep = qagg_step_nop;
        let dfi: QAggFin  = qagg_fin_nop;
        return QEnv {
            names: [""; 24], kinds: [0i32; 24], ivals: [0i64; 24],
            fvals: [0.0f64; 24], bvals: [false; 24], svals: [""; 24],
            words: [0i64; 24], codes: [0u64; 24], n: 0i64,
            f_names: [""; 8], f_ptrs: [dfn; 8], f_arity: [0i64; 8],
            f_args: [0i32; 32], f_ret: [0i32; 8], f_n: 0i64,
            a_names: [""; 4], a_init: [din; 4], a_step: [dst; 4],
            a_fin: [dfi; 4], a_argty: [0i32; 4], a_ret: [0i32; 4], a_n: 0i64,
        };
    }

    fn find(self: &QEnv, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.n {
            if str_eq(self.names[i], name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
    // Rebind-aware slot allocation (last write wins per name).
    fn slot(self: &mut QEnv, name: str) -> i64 {
        let i: i64 = self.find(name);
        if i >= 0i64 { return i; }
        if self.n >= QENV_CAP { return -1i64; }
        self.names[self.n] = name;
        self.n = self.n + 1i64;
        return self.n - 1i64;
    }

    /// Binds `name` to a schema'd Writ object (a `WAny` ref to a schema-stamped TOM).
    /// The schema code is read off the object; a non-schema value binds with code 0 and is
    /// diagnosed by the strict checker on first use.
    pub fn bind_node(self: &mut QEnv, name: str, node: WAny) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_NODE;
        self.words[i] = node.raw();
        self.codes[i] = node_schema_code(node);
    }
    /// Binds `name` to an `i64` query/template parameter.
    pub fn bind_i64(self: &mut QEnv, name: str, v: i64) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_I64;
        self.ivals[i] = v;
    }
    /// Binds `name` to an `f64` query/template parameter.
    pub fn bind_f64(self: &mut QEnv, name: str, v: f64) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_F64;
        self.fvals[i] = v;
    }
    /// Binds `name` to a `bool` query/template parameter.
    pub fn bind_bool(self: &mut QEnv, name: str, v: bool) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_BOOL;
        self.bvals[i] = v;
    }
    /// Binds `name` to a `str` parameter; the view must stay valid across `render`/`run`.
    pub fn bind_str(self: &mut QEnv, name: str, v: str) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_STR;
        self.svals[i] = v;
    }

    /// Binds `name` to a query source: a Writ array of schema'd rows (`from <name> v` scans it).
    /// The element schema resolves live at `run` (off the first element's stamped code) — an
    /// empty array binds fine and yields no rows.
    /// The caller keeps the backing doc alive across `run`.
    pub fn bind_source(self: &mut QEnv, name: str, arr: WAny) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_SRC;
        self.words[i] = arr.raw();
        self.codes[i] = 0u64;
    }

    // ── LENIENT binds (ADR §4, the D4 queue-2 half) ─────────────────────────
    /// Binds `name` to an erased (lenient) node: `name.field` resolves at runtime by name.
    /// A string-keyed Writ map gets by key; a schema-stamped TOM whose schema is in the catalog
    /// gets by the cataloged key; anything else (missing key, unknown schema, non-object) reads
    /// as `RtVal::Null`, which propagates CEL-style through operators. No catalog entry needed.
    pub fn bind_node_erased(self: &mut QEnv, name: str, node: WAny) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_ENODE;
        self.words[i] = node.raw();
        self.codes[i] = 0u64;
    }

    /// Binds `name` to an erased source: a Writ array of lenient rows (string-keyed maps /
    /// arbitrary Writ values). Scans bind the row var leniently; field types are unknown at
    /// compile, so lenient rows never serve as hash-join keys (such joins take the loop tier).
    pub fn bind_source_erased(self: &mut QEnv, name: str, arr: WAny) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_ESRC;
        self.words[i] = arr.raw();
        self.codes[i] = 0u64;
    }

    /// Binds `name` to a GRAPH source: a Writ value (container root) scanned
    /// VIRTUALLY — the scan walks the object graph from the root, one row per
    /// EDGE, nothing materialized (the document IS the fact base). Writ is a
    /// generalized object graph (cycles legal): every edge emits; a node's
    /// children EXPAND exactly once (visited set) — DAGs don't duplicate,
    /// cycles terminate. Row columns are fixed: `parent`/`child` (i64 ids —
    /// containers carry their Writ handle, scalar leaves a synthetic
    /// FNV(parent, ordinal) id: a leaf's value word is not an identity),
    /// `idx` (array position / TOM field key code, −1 under a map), `key`
    /// (map key, "" otherwise), `kind` (friendly tag: map/arr/tom/str/i64/
    /// f64/bool/null, "obj" for other ref tags — open world), `tag` (the RAW
    /// type_code — user tags flow through), `vi` (the child's scalar payload:
    /// i64 value, bool as 0/1, f64 as IEEE-754 BITS; canonical 0 otherwise),
    /// `vs` (the child's string payload; canonical "" otherwise). vi/vs are
    /// TOTAL typed columns — `kind` discriminates which payload is meaningful
    /// (one vocabulary with the static walkers; no Nulls, set-dedup stays
    /// two-valued). Re-scan semantics: no deltas, not incrementally
    /// maintainable (use FactStore for the live-fact path).
    pub fn bind_source_tree(self: &mut QEnv, name: str, root: WAny) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_TSRC;
        self.words[i] = root.raw();
        self.codes[i] = 0u64;
    }

    /// Binds PRE-MATERIALIZED graph-edge rows under `name` — the runtime twin
    /// of a `#[derive_graph_source]` materializer: `rows` is a Writ ARRAY of
    /// 8-element rows in the edge vocabulary (parent, key, idx, child, kind,
    /// tag, vi, vs; see `edges_to_source`). Scanned like a tree source (the
    /// same dotted columns), but from the given rows instead of a walk.
    pub fn bind_edge_rows(self: &mut QEnv, name: str, rows: WAny) {
        let i: i64 = self.slot(name);
        if i < 0i64 { return; }
        self.kinds[i] = QB_EDGE;
        self.words[i] = rows.raw();
    }

    // ── UDF/UDA registration (ADR §6) ───────────────────────────────────────
    // I3: returns false instead of the I2 silent drop, which made the later
    // "unknown function" error misleading.
    /// Registers a scalar UDF with its declared signature: `args` are EL type names
    /// (`"i64"`/`"f64"`/`"bool"`/`"str"`, max 4), `ret` likewise. The checker resolves calls
    /// against builtins first, then this registry; re-registering a name overwrites it.
    /// Returns `false` (registers nothing) on a bad type name, >4 args, or a full registry.
    pub fn register_fn(self: &mut QEnv, name: str, f: QFn, args: &[str], ret: str) -> bool {
        let rc: i32 = el_ret_class(ret);
        if rc < 0i32 { return false; }
        let na: i64 = args.len();
        if na > QENV_FN_ARGS { return false; }
        let mut ats: [i32; 4] = [0i32; 4];
        let mut i: i64 = 0i64;
        while i < na {
            let ac: i32 = el_ret_class(args[i]);
            if ac < 0i32 { return false; }
            ats[i] = ac;
            i = i + 1i64;
        }
        let mut fi: i64 = self.find_fn(name);
        if fi < 0i64 {
            if self.f_n >= QENV_FNS { return false; }
            fi = self.f_n;
            self.f_n = self.f_n + 1i64;
        }
        self.f_names[fi] = name;
        self.f_ptrs[fi]  = f;
        self.f_arity[fi] = na;
        self.f_ret[fi]   = rc;
        let mut k: i64 = 0i64;
        while k < na { self.f_args[fi * QENV_FN_ARGS + k] = ats[k]; k = k + 1i64; }
        return true;
    }

    fn find_fn(self: &QEnv, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.f_n {
            if str_eq(self.f_names[i], name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }

    /// Registers a UDA: `init() -> acc`, `step(acc, arg) -> acc`, `fin(acc) -> result`.
    /// `arg_ty`/`ret_ty` are the declared EL types of the aggregate argument and the finalized
    /// result. Builtin aggregate names shadow UDAs. Returns `false` (nothing registered) on a
    /// bad type name or a full registry (same contract as `register_fn`).
    pub fn register_agg(self: &mut QEnv, name: str, init: QAggInit, step: QAggStep,
                        fin: QAggFin, arg_ty: str, ret_ty: str) -> bool {
        let ac: i32 = el_ret_class(arg_ty);
        let rc: i32 = el_ret_class(ret_ty);
        if ac < 0i32 || rc < 0i32 { return false; }
        let mut ai: i64 = self.find_agg(name);
        if ai < 0i64 {
            if self.a_n >= QENV_AGGS { return false; }
            ai = self.a_n;
            self.a_n = self.a_n + 1i64;
        }
        self.a_names[ai] = name;
        self.a_init[ai]  = init;
        self.a_step[ai]  = step;
        self.a_fin[ai]   = fin;
        self.a_argty[ai] = ac;
        self.a_ret[ai]   = rc;
        return true;
    }

    fn find_agg(self: &QEnv, name: str) -> i64 {
        let mut i: i64 = 0i64;
        while i < self.a_n {
            if str_eq(self.a_names[i], name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Writ TOM access — the SAME reads the static schema accessors compile to
// (WMap<Wu6,WAny>::get by key code + WritField conversions).
// ═══════════════════════════════════════════════════════════════════════════

// Bind a Ref WAny to its backing TOM (points into the owning arena, which
// outlives every view taken here — the ast.logos / make_schema idiom).
fn tom_at<'a>(w: WAny) -> &'a WMap<Wu6, WAny> {
    let p: *const u8 = w.resolve();
    return unsafe { &*(p as *const WMap<Wu6, WAny>) };
}

// The schema code stamped on a WAny's pointee TOM (0 = null / not a TOM).
fn node_schema_code(w: WAny) -> u64 {
    if w.is_null() { return 0u64; }
    if !w.is_ref() { return 0u64; }
    if !w.is_tinymap() { return 0u64; }
    let m: &WMap<Wu6, WAny> = tom_at(w);
    return m.schema_type_code();
}

// A WString pointee's bytes as a `str` view (provenance-laundering: the input
// is a RAW resolve()d pointer, so the view ties to the owning arena, not to a
// local WAny — the generated parsers' wstr_as_str idiom).
fn wstr_at<'a>(p: *const u8) -> str {
    if (p as i64) == 0i64 { return ""; }
    let ws: &WString = unsafe { &*(p as *const WString) };
    return ws.as_str();
}

// A string-typed WAny's payload ("" for null/non-string).
fn wany_str(v: WAny) -> str {
    if !v.is_string() { return ""; }
    return wstr_at(v.resolve());
}

// A WAny value → RtVal by VALUE SHAPE: scalars map to their scalar variants,
// anything else referencable becomes a Node handle. This is the ELEMENT
// conversion for iterated Writ arrays — it makes scalar-element arrays
// (WRef<str> etc., FK_EARR) and schema'd-node arrays iterate uniformly.
fn wany_to_rt(v: WAny) -> RtVal {
    if v.is_null()   { return RtVal::Null; }
    if v.is_string() { return RtVal::S(wstr_at(v.resolve())); }
    if v.is_bool()   { return RtVal::B(v.as_bool()); }
    if v.is_float()  { return RtVal::F(v.as_f64()); }
    if v.is_int()    { return RtVal::I(v.as_i64()); }
    return RtVal::Node(v);
}

// ═══════════════════════════════════════════════════════════════════════════
// RtVal — the runtime scalar (ADR §2). PUBLIC since I2: the UDF/UDA registry
// signature is RtVal-based (ADR §6 — `fn(&[RtVal]) -> RtVal`), so user
// functions match on / construct it directly. Cheap to copy (all payloads are
// word-sized views/handles). `S` carries a VIEW — a UDF returning `S` must
// return a view that outlives the call (a literal, or a view into an input).
// ═══════════════════════════════════════════════════════════════════════════
/// Runtime scalar value of the Deem evaluator — the argument/result type of UDFs and UDAs.
/// Cheap to copy (all payloads are word-sized views/handles).
pub enum RtVal {
    /// 64-bit integer.
    I(i64),
    /// 64-bit float.
    F(f64),
    /// Boolean.
    B(bool),
    /// Borrowed string view. A UDF returning `S` must return a view that outlives the call
    /// (a literal, or a view into an input).
    S(str),
    /// Handle to a Writ object (schema'd row / node) in the caller's data doc.
    Node(WAny),
    /// Absent value (lenient miss); propagates CEL-style through operators.
    Null,
    /// Math error (integer overflow / division-or-remainder by zero). Distinct from `Null`:
    /// it propagates through arithmetic like `Null` but aborts the query at the eval boundary
    /// as a `QError` rather than dropping the row.
    Error,
}
impl Copy for RtVal {}
fn rt_is_err(v: RtVal) -> bool { match v { RtVal::Error => { return true; } _ => { return false; } } }

// ── UDF/UDA function-pointer shapes (ADR §6, MVP) ───────────────────────────
// UDF: eval'd args in, one value out. UDA: init() seeds the accumulator,
// step(acc, arg) folds one row, fin(acc) finalizes (pass an identity fn when
// no finalization is needed).
/// Scalar UDF: evaluated argument values in, one value out.
pub type QFn      = fn(&[RtVal]) -> RtVal;
/// UDA initializer: seeds the accumulator.
pub type QAggInit = fn() -> RtVal;
/// UDA step: folds one row's value into the accumulator.
pub type QAggStep = fn(RtVal, RtVal) -> RtVal;
/// UDA finalizer: maps the accumulator to the result (pass an identity fn when unneeded).
pub type QAggFin  = fn(RtVal) -> RtVal;

// Registry no-op seeds (the fixed-slot tables need an initial value).
fn qfn_nop(_a: &[RtVal]) -> RtVal { return RtVal::Null; }
fn qagg_init_nop() -> RtVal { return RtVal::Null; }
fn qagg_step_nop(acc: RtVal, _v: RtVal) -> RtVal { return acc; }
fn qagg_fin_nop(acc: RtVal) -> RtVal { return acc; }

fn rt_kind(v: RtVal) -> i32 {
    match v {
        RtVal::I(_x)    => { return 1i32; }
        RtVal::F(_x)    => { return 2i32; }
        RtVal::B(_x)    => { return 3i32; }
        RtVal::S(_x)    => { return 4i32; }
        RtVal::Node(_x) => { return 5i32; }
        RtVal::Null     => { return 0i32; }
        RtVal::Error    => { return 6i32; }
    }
}
fn rt_i(v: RtVal) -> i64 {
    match v {
        RtVal::I(x) => { return x; }
        RtVal::F(x) => { return x as i64; }
        RtVal::B(b) => { if b { return 1i64; } return 0i64; }
        _ => { return 0i64; }
    }
}
// ⚠ THE `B` ARM IS NOT A SPECIAL CASE — ITS ABSENCE WAS THE ASYMMETRY. `rt_i`
// directly above already maps true→1 / false→0, so the SAME RtVal read as an
// integer answered 1 and read as a float answered 0.0, and nothing named which
// of the two a bool is worth. Under Victor's ruling (`avg` admits bool, true is
// 1.0) it is worth one, and it is worth one in BOTH spellings — a second answer
// living in the avg fold alone is the "two spellings of one rule" shape that
// produced this arc.
//
// ⚠ IT IS VISIBLE THROUGH `QRows::get_f64` (query.logos), the public accessor:
// a bool cell read as f64 answered 0.0 and now answers 1.0/0.0. Confirmed by
// control revert.
//
// ⚠⚠ AND THROUGH LENIENT ARITHMETIC — which an earlier version of this comment
// DENIED, on the ground that every other caller is EL arithmetic over operands
// `check_expr` has already typed as numeric, "so a bool cannot reach them".
// That denial is FALSE. `ct_is_open(t)` is `t == CT_UNKNOWN || t == CT_DYN`
// (below) and check.logos uses it to WAIVE the numeric-operand refusal for
// exactly the types that were not typed as numeric. An FK_ANY cell holding a
// bool is CT_DYN at check time and `RtVal::B` at run time, so it reaches here.
// MEASURED on `from rows e select (e.meta + 1.0)` with `meta = WAny::from(true)`:
// 2.0 with this arm, 1.0 without it.
//
// So lenient arithmetic changed its answer, and Victor's ruling did not cover
// that path — it covered `avg`. RATIFIED SINCE: a bool is worth ONE in every
// numeric spelling of a lenient value, which is now a stated rule
// (`deem.exec.lenient-bool-one`, docs/spec/deem.md) and not merely the
// behaviour a fixture happened to record. The grounds: `rt_i` has answered 1
// for a bool since c00b2888 (2026-07-02, the original queue-2 slice — a month
// older than this arm), so the two spellings agree rather than one conceding to
// the other; ratifying preserves every program that works today, the express
// ground the `avg` ruling gave; and a value that differs by which accessor
// reads it is not a value. `query_dyn_bool_arith_pinned` remains the end-to-end
// pin — it is now the rule's TEST rather than the rule's only record, and its
// numbers did not move, because the numbers were what got ratified.
//
// ⚠⚠⚠ METHOD, because this cost an hour and nearly entered the record inverted:
// the first attempt to check the two statements above ran `ctest` after editing
// but BEFORE rebuilding the stdlib. ctest runs PREBUILT archives, so both probes
// measured a tree without the arm and both statements came back "measured
// false". Edit, BUILD, then run — every time.
fn rt_f(v: RtVal) -> f64 {
    match v {
        RtVal::I(x) => { return x as f64; }
        RtVal::F(x) => { return x; }
        RtVal::B(b) => { if b { return 1.0f64; } return 0.0f64; }
        _ => { return 0.0f64; }
    }
}
fn rt_b(v: RtVal) -> bool {
    match v { RtVal::B(b) => { return b; } _ => { return false; } }
}
fn rt_s(v: RtVal) -> str {
    match v { RtVal::S(s) => { return s; } _ => { return ""; } }
}
fn rt_node(v: RtVal) -> WAny {
    match v { RtVal::Node(w) => { return w; } _ => { return WAny::Ref(0i64 as *const u8); } }
}

// Jinja truthiness (mirrors the static emit_truthy rules).
fn rt_truthy(v: RtVal) -> bool {
    match v {
        RtVal::B(b)     => { return b; }
        RtVal::I(x)     => { return x != 0i64; }
        RtVal::F(x)     => { return x != 0.0f64; }
        RtVal::S(s)     => { return s.len() != 0i64; }
        RtVal::Node(_w) => { return true; }
        RtVal::Null     => { return false; }
        RtVal::Error    => { return false; }
    }
}

// Value equality (post-check the operands are same-class; defensive false).
fn rt_eq(l: RtVal, r: RtVal) -> bool {
    let lk: i32 = rt_kind(l);
    let rk: i32 = rt_kind(r);
    if lk == 1i32 && rk == 1i32 { return rt_i(l) == rt_i(r); }
    if (lk == 1i32 || lk == 2i32) && (rk == 1i32 || rk == 2i32) { return rt_f(l) == rt_f(r); }
    if lk == 4i32 && rk == 4i32 { return str_eq(rt_s(l), rt_s(r)); }
    if lk == 3i32 && rk == 3i32 { return rt_b(l) == rt_b(r); }
    if lk == 0i32 && rk == 0i32 { return true; }
    return false;
}

// Append a value's rendered text ({{ … }} formatting: i64, %g f64, bare str,
// true/false — the static queue's conventions).
fn rt_push(out: &mut String, v: RtVal) {
    match v {
        RtVal::I(x) => { out.push_i64(x); }
        RtVal::F(x) => {
            let s: String = wql_f64_to_str(x);
            out.push_str(sstr(&s));
        }
        RtVal::B(b) => { if b { out.push_str("true"); } else { out.push_str("false"); } }
        RtVal::S(s) => { out.push_str(s); }
        _ => { }   // Node/Null — the checker rejects these in {{ … }}
    }
}

// Intern an owned String into the render scratch arena; the returned view
// stays valid for the rest of the render (Writ segments never move).
fn intern(scratch: &Writ, s: &String) -> str {
    let ws: &WString = scratch.wstring(sstr(s));
    return ws.as_str();
}

// Intern a borrowed view into an arena (QRows string materialization).
fn intern_str(arena: &Writ, s: str) -> str {
    let ws: &WString = arena.wstring(s);
    return ws.as_str();
}

// ═══════════════════════════════════════════════════════════════════════════
// The CHECKER (ADR §4, strict) — an SExpr/TStmt walk over (catalog + env
// declarations + template-local bindings). Two phases share this walker:
//   compile phase (strict=false): env is empty; unresolvable roots type as
//     UNKNOWN and every check that needs them is deferred;
//   render phase (strict=true): every root must resolve; full lattice rules.
// ═══════════════════════════════════════════════════════════════════════════

// Checked-type tags. CT_INT..CT_FLT deliberately EQUAL the EL_TY_* values so
// catalog scalar types and builtin return types map across directly.
const CT_INT:     i32 = 0i32;
const CT_STR:     i32 = 1i32;
const CT_BOOL:    i32 = 2i32;
const CT_FLT:     i32 = 3i32;
const CT_NODE:    i32 = 10i32;   // a schema'd object; code = schema code
const CT_ARR:     i32 = 11i32;   // a collection edge; code = element schema code
const CT_UNKNOWN: i32 = 12i32;   // compile phase only (root not yet bindable)
const CT_SARR:    i32 = 13i32;   // a SCALAR-element array edge; code = element
                                 // EL tag (CT_INT..CT_FLT) as u64 (FK_EARR)
const CT_RELROW:  i32 = 14i32;   // a rel row var (I3); code = rel registry idx.
                                 // Columns read as `<var>.<col>` DOTTED idents
                                 // (the compile-time rel-field rewrite).
const CT_DYN:     i32 = 15i32;   // a LENIENT value (ADR §4): type unknown at
                                 // check time; runtime value may be Null.
const CT_DYNSRC:  i32 = 16i32;   // an ERASED source/collection: rows bind DYN.
const CT_TREESRC: i32 = 17i32;   // a TREE source (bind_source_tree): scanned
                                 // virtually, one row per edge.
const CT_TREEROW: i32 = 18i32;   // a tree-source row var: fixed columns
                                 // (parent/child/idx: i64 · key/kind: str ·
                                 // vi/vs: dyn) — typed by the checker table.

struct CTy { t: i32, code: u64 }
impl Copy for CTy {}

fn ct(t: i32) -> CTy { return CTy { t: t, code: 0u64 }; }
fn ct_is_num(t: i32) -> bool { return t == CT_INT || t == CT_FLT; }
fn ct_is_obj(t: i32) -> bool {
    return t == CT_NODE || t == CT_ARR || t == CT_SARR
        || t == CT_RELROW || t == CT_DYNSRC;
}
// A tag every scalar-position check should wave through: the value is typed
// at RUNTIME (compile-phase unknown, or a lenient value).
fn ct_is_open(t: i32) -> bool { return t == CT_UNKNOWN || t == CT_DYN; }

// ═══════════════════════════════════════════════════════════════════════════
// QRelReg — the compile-time REL REGISTRY (I3): declared rel names + typed
// columns + the SCC condensation results. Owned by the Query (names/columns
// are str views into the Query's own IR doc). The runtime counterpart of the
// static walker's MacroParams rel section.
// ═══════════════════════════════════════════════════════════════════════════
const QREL_MAX:  i64 = 8i64;    // static parity (RQREL_MAX)
const QRELC_MAX: i64 = 64i64;   // flat column table (8 rels × 8 cols)

pub struct QRelReg {
    n:      i64,
    names:  [str; 8],
    ncols:  [i64; 8],
    coff:   [i64; 8],     // rel → first index into the flat column tables
    cnames: Vec<str>,     // flat, declaration order (Vec-backed: the Query
    ctys:   Vec<i64>,     // must stay SMALL — big by-value aggregates
                          // scalarize pathologically in codegen; CT_* tags)
    // SCC condensation (compute_rel_scc results, copied flat)
    nscc:  i64,
    comp:  [i64; 8],
    rec:   [bool; 8],
    order: [i64; 8],
    // RECURSIVE SEMILATTICE AGGREGATION (slice-7): per rel, the AGG_* id of its
    // recursive min/max aggregate head (3 = min, 4 = max; 0 = plain rel). Set by
    // the relaxed stratification check when a single-rel recursive component is an
    // admissible semilattice aggregate. Nonzero ⇒ qrel_push_out routes to the
    // semilattice-ABSORB push (qrel_push_agg) instead of set-dedup.
    rel_agg: [i32; 8],
}

fn qrelreg_new() -> QRelReg {
    return QRelReg {
        n: 0i64, names: [""; 8], ncols: [0i64; 8], coff: [0i64; 8],
        cnames: vec_new::<str>(), ctys: vec_new::<i64>(),
        nscc: 0i64, comp: [0i64; 8], rec: [false; 8], order: [0i64; 8],
        rel_agg: [0i32; 8],
    };
}

// Rel index by name (-1 = not a rel).
fn qreg_find(reg: &QRelReg, name: str) -> i64 {
    let mut i: i64 = 0i64;
    while i < reg.n {
        if str_eq(reg.names[i], name) { return i; }
        i = i + 1i64;
    }
    return -1i64;
}

// Column index WITHIN rel `ri` (-1 = unknown column).
fn qreg_col(reg: &QRelReg, ri: i64, col: str) -> i64 {
    let off: i64 = reg.coff[ri];
    let mut c: i64 = 0i64;
    while c < reg.ncols[ri] {
        if str_eq(reg.cnames.get(off + c), col) { return c; }
        c = c + 1i64;
    }
    return -1i64;
}

// "{p, q}" — the member list of SCC `c` (declaration order) appended to `out`
// (the stratification diagnostics — mirrors the static walker's).
fn qreg_push_scc_members(out: &mut String, reg: &QRelReg, c: i64) {
    out.push_str("{");
    let mut first: bool = true;
    let mut i: i64 = 0i64;
    while i < reg.n {
        if reg.comp[i] == c {
            if !first { out.push_str(", "); }
            out.push_str(reg.names[i]);
            first = false;
        }
        i = i + 1i64;
    }
    out.push_str("}");
}

// Split a DOTTED rel-column ident "<var>.<col>" (the rel-field rewrite's
// output; user idents cannot contain '.'). Returns the dot index, -1 if none.
fn dotted_at(name: str) -> i64 {
    let n: i64 = name.len();
    let mut i: i64 = 0i64;
    while i < n {
        if str_byte_at(name, i) == 46u8 { return i; }
        i = i + 1i64;
    }
    return -1i64;
}
fn str_prefix(s: str, n: i64) -> str {
    return unsafe { str_from_raw(s.as_ptr(), n) };
}
fn str_suffix(s: str, from: i64) -> str {
    return unsafe { str_from_raw((s.as_ptr() as i64 + from) as *const u8, s.len() - from) };
}

