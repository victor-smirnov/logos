// logos.mem.bt — B+tree over packed node blocks (ADR 0018 M2; C++ reference:
// prototypes/bt/{container,shuttles}, bt_ss).
//
// A NODE block IS the DST struct `BtNode` (below): the id + hot descent fields,
// then the PkdAlloc column region as the trailing unsized field — exactly
// Memoria's TreeNodeBase { ...; PackedAllocator allocator_; }
// (prototypes/bt/nodes/branch_node.hpp). The header fields are reached by
// struct-field access; the allocator is `&node.alc` (node->allocator()); the
// header size is offset_of!(BtNode, alc). Columns:
//   leaf:   slot 0 = keys (single-column PdtBuf, MAX-ordered) · slot 1 = vals
//   branch: slot 0 = keys (MAX key of each child — the Memoria convention) ·
//           slot 1 = children (block ids) — all single-column FSE64 PdtBufs
// (root_ / next_leaf_id_ join with the store + leaf-sibling chain; bt's
// path-driven cursor needs neither yet.)
//
// The M2 ARENA is a flat block table (id → bytes) — the real store replaces
// it in M3; every algorithm below addresses blocks ONLY by id through it.
//
// SHUTTLES (ADR §1.2.4): traversal is driven by stateful, task-specific
// shuttle objects — an OPEN set. A shuttle sees each BRANCH on the way down
// (choosing the child) and the LEAF at arrival (choosing the position);
// cursors and point ops ride shuttles, not ad-hoc loops. Bidirectional
// movement lives in the cursor's path walk (next/prev across leaves).
//
// STREAMING CREATION (ADR §1.2.3 — the killer feature): bulk_build consumes
// a sorted entry stream and builds the tree BOTTOM-UP — leaves fill left to
// right, then each branch level is assembled from the level below; no
// per-element descent.
package logos.mem.bt;

use logos.mem.pkd;
use logos.mem.pkd.pdtbuf;
use logos.lang.marker;   // SelfDescribing — BtNode is a DST ending in PkdAlloc
use logos.lang.mem;
use logos.lang.drop;
use logos.lang.option;
use logos.lang.result;
use logos.mem.collections.vec;

// ── node geometry ────────────────────────────────────────────────────────────

pub const BT_BLOCK: u32 = 4096u32;
const SLOT_KEYS: u32 = 0u32;
const SLOT_VALS: u32 = 1u32;   // leaf values / branch children

// The node block as a custom DST: the fixed header fields, then `alc` — the
// [u8]-tailed PkdAlloc — as the trailing unsized field. Mirrors Memoria's
// TreeNodeBase (id/leaf/level POD fields ahead of `PackedAllocator allocator_`).
// `#[self_describing]` keeps every `*mut BtNode` THIN (the tail length is
// in-band, via alc), so the arena stores a plain pointer; the allocator region
// starts at offset_of!(BtNode, alc).
#[self_describing]
struct BtNode {
    id:    u64,        // Header::id — the node's own block id
    leaf:  u32,        // leaf_  — 1 = leaf, 0 = branch
    level: u32,        // level_ — tree level (0 = leaf)
    alc:   PkdAlloc,   // allocator_ — the column region (the DST tail)
}
impl SelfDescribing for BtNode {
    fn dst_len(self: *const BtNode) -> i64 { return unsafe { (*self).alc.dst_len() }; }
}

// ── arena: id → block (M3 replaces this with the store) ─────────────────────

pub struct BtArena {
    blocks: Vec<i64>,            // *mut u8 as i64 (block id = index + 1)
}

pub fn arena_new() -> BtArena {
    return BtArena { blocks: vec_new::<i64>() };
}

impl BtArena {
    /// Allocates + formats a fresh node block; returns its nonzero id.
    pub fn alloc_node(self: &mut BtArena, is_leaf: bool, level: u32) -> u64 {
        unsafe {
            let id: u64 = (self.blocks.len() + 1i64) as u64;   // 1-based; stamped in-header
            let base: *mut u8 = alloc(offset_of!(BtNode, alc) + (BT_BLOCK as i64));
            let node: *mut BtNode = base as *mut BtNode;
            (*node).id = id;
            (*node).leaf = if is_leaf { 1u32 } else { 0u32 };
            (*node).level = level;
            let a: *mut PkdAlloc = pkd_format(bt_pkd(node) as *mut u8, BT_BLOCK, 2);
            if !bt_format_col(a, SLOT_KEYS, true) { return 0u64; }
            if !bt_format_col(a, SLOT_VALS, false) { return 0u64; }
            self.blocks.push(node as i64);
            return id;
        }
    }
    /// Node handle for `id` (the DST struct; reach the columns via bt_pkd).
    pub fn at(self: &BtArena, id: u64) -> *mut BtNode {
        return self.blocks.get((id as i64) - 1i64) as *mut BtNode;
    }
}

// The arena OWNS every node block it allocated (alloc_node → alloc). Free them
// on scope exit; the `blocks` Vec drops itself afterwards. M3 hands ownership
// to the store instead, at which point the arena no longer allocates.
impl Drop for BtArena {
    fn drop(self: BtArena) {
        let mut i: i64 = 0i64;
        while i < self.blocks.len() {
            let p: i64 = self.blocks.get(i);
            if p != 0i64 {
                unsafe { dealloc(p as *mut u8); }
            }
            i = i + 1i64;
        }
    }
}

// Format a node column as a single-column FSE64 PdtBuf (capacity-0 geometry,
// wired to the node's allocator — the nested-block discipline).
unsafe fn bt_format_col(a: *mut PkdAlloc, slot: u32, ordered: bool) -> bool {
    let mut ord: u32 = PDT_ORD_UNORDERED;
    if ordered {
        ord = PDT_ORD_MAX;
    }
    let d: PdtDescr = pdt_descr_fse(1u32, 8u32, ord, false);
    let zero: Vec<u64> = pdt_payload_zero(&d);
    let need: u32 = pdtbuf_compute_block_size(&d, 0u64, &zero);
    let p: *mut u8 = match a.allocate(slot, need, SlotKind::Allocatable) {
        Result::Ok(q) => q,
        Result::Err(_e) => { return false; }
    };
    let bsz: u32 = a.element_size(slot);
    match pdtbuf_format(p, bsz, &d) {
        Result::Ok(_b) => {}
        Result::Err(_e) => { return false; }
    }
    let inner: *mut PkdAlloc = p as *mut PkdAlloc;
    inner.set_allocator(a as *const PkdAlloc);
    return true;
}

// Column views of a node block (re-resolved per call, never cached).
unsafe fn nkeys(a: *mut PkdAlloc) -> PdtBuf { return pdtbuf_adopt(a.get::<u8>(SLOT_KEYS)); }
unsafe fn nvals(a: *mut PkdAlloc) -> PdtBuf { return pdtbuf_adopt(a.get::<u8>(SLOT_VALS)); }

// One (key, val) row fits both columns? Priced by the SAME prepares that
// commit (exact; both grows come from the one node block).
unsafe fn bt_fits_row(a: *mut PkdAlloc, pos: u32) -> bool {
    let kb: PdtBuf = nkeys(a);
    let uk: PdtUpdate = match kb.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
        Result::Ok(u) => u,
        Result::Err(_e) => { return false; }
    };
    let vb: PdtBuf = nvals(a);
    let uv: PdtUpdate = match vb.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
        Result::Ok(u) => u,
        Result::Err(_e) => { return false; }
    };
    return uk.grow_bytes() + uv.grow_bytes() <= a.free_space();
}

// Insert one (key, val) row at pos — priced by the caller via bt_fits_row.
unsafe fn bt_put_row(a: *mut PkdAlloc, pos: u32, key: u64, val: u64) {
    {
        let kb: PdtBuf = nkeys(a);
        let uk: PdtUpdate = match kb.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => { assert(false, "bt: priced key insert failed"); return; }
        };
        let mut kb2: PdtBuf = nkeys(a);
        let mut kr: Vec<u64> = vec_new::<u64>();
        kr.push(key);
        kb2.commit_insert(&uk, &kr);
    }
    {
        let vb: PdtBuf = nvals(a);
        let uv: PdtUpdate = match vb.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => { assert(false, "bt: priced val insert failed"); return; }
        };
        let mut vb2: PdtBuf = nvals(a);
        let mut vr: Vec<u64> = vec_new::<u64>();
        vr.push(val);
        vb2.commit_insert(&uv, &vr);
    }
}

// Remove the row at pos from both columns.
unsafe fn bt_del_row(a: *mut PkdAlloc, pos: u32) {
    {
        let kb: PdtBuf = nkeys(a);
        let uk: PdtUpdate = match kb.prepare_remove(pos as u64, (pos as u64) + 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => { assert(false, "bt: key remove prepare failed"); return; }
        };
        let mut kb2: PdtBuf = nkeys(a);
        kb2.commit_remove(&uk);
    }
    {
        let vb: PdtBuf = nvals(a);
        let uv: PdtUpdate = match vb.prepare_remove(pos as u64, (pos as u64) + 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => { assert(false, "bt: val remove prepare failed"); return; }
        };
        let mut vb2: PdtBuf = nvals(a);
        vb2.commit_remove(&uv);
    }
}

// Header access is now plain struct-field reads (no byte offsets); `bt_pkd`
// returns the trailing allocator — Memoria's node->allocator().
unsafe fn bt_pkd(node: *mut BtNode) -> *mut PkdAlloc { return &mut (*node).alc; }
unsafe fn node_id(node: *mut BtNode) -> u64 { return (*node).id; }
unsafe fn node_is_leaf(node: *mut BtNode) -> bool { return (*node).leaf == 1u32; }
unsafe fn node_level(node: *mut BtNode) -> u32 { return (*node).level; }

unsafe fn keys_count(a: *mut PkdAlloc) -> u32 { return nkeys(a).size() as u32; }

unsafe fn max_key(a: *mut PkdAlloc) -> u64 {
    let kb: PdtBuf = nkeys(a);
    return kb.get(0u32, kb.size() - 1u64);
}

// ── shuttles ─────────────────────────────────────────────────────────────────

/// One descent/arrival decision: `pos` = child index (branch) or entry
/// position (leaf); `found` per the shuttle's own task semantics.
pub struct ShuttleRes { pub pos: u32, pub found: bool }

/// A task-specific tree walker (ADR §1.2.4): sees each branch on the way
/// down and the leaf at arrival. Stateful by design — implementations
/// accumulate whatever their task needs (running ranks, budgets, …).
pub trait Shuttle {
    /// Choose the child to descend into. `node` = a BRANCH block.
    fn on_branch(self: *mut Self, node: *mut PkdAlloc) -> ShuttleRes;
    /// Position within the LEAF at arrival.
    fn on_leaf(self: *mut Self, node: *mut PkdAlloc) -> ShuttleRes;
}

/// Key search: lower_bound over branch max-keys, then over leaf keys.
pub struct FindShuttle { pub key: u64 }
impl Shuttle for FindShuttle {
    fn on_branch(self: *mut FindShuttle, node: *mut PkdAlloc) -> ShuttleRes {
        unsafe {
            let ks: PdtBuf = nkeys(node);
            let n: u32 = ks.size() as u32;
            let mut c: u32 = pdt_lower_bound_u64(&ks, 0u32, self.key);
            if c >= n { c = n - 1u32; }   // beyond every max → rightmost child
            return ShuttleRes { pos: c, found: true };
        }
    }
    fn on_leaf(self: *mut FindShuttle, node: *mut PkdAlloc) -> ShuttleRes {
        unsafe {
            let ks: PdtBuf = nkeys(node);
            let pos: u32 = pdt_lower_bound_u64(&ks, 0u32, self.key);
            let n: u32 = ks.size() as u32;
            let found: bool = pos < n && ks.get(0u32, pos as u64) == self.key;
            return ShuttleRes { pos: pos, found: found };
        }
    }
}

/// Rides `sh` from the root to a leaf, recording the descent path.
/// Returns (leaf id, leaf ShuttleRes); `path` gets (block id, child idx)
/// per branch visited, top-down.
pub fn bt_ride(arena: &BtArena, root: u64, sh: *mut dyn Shuttle,
               path: &mut Vec<(u64, u32)>) -> (u64, ShuttleRes) {
    unsafe {
        let mut cur: u64 = root;
        loop {
            let base: *mut BtNode = arena.at(cur);
            let p: *mut PkdAlloc = bt_pkd(base);
            if node_is_leaf(base) {
                return (cur, sh.on_leaf(p));
            }
            let r: ShuttleRes = sh.on_branch(p);
            path.push((cur, r.pos));
            cur = nvals(p).get(0u32, r.pos as u64);
        }
    }
}

// ── tree handle + point ops ──────────────────────────────────────────────────

pub struct BtTree { pub root: u64 }

/// Creates an empty tree (a single empty leaf).
pub fn bt_new(arena: &mut BtArena) -> BtTree {
    return BtTree { root: arena.alloc_node(true, 0u32) };
}

/// Number of entries (walks the leaf level; a size stream lands with M3).
pub fn bt_count(arena: &BtArena, t: &BtTree) -> u64 {
    let mut c: BtCursor = bt_first(arena, t);
    let mut n: u64 = 0u64;
    while c.valid() {
        n = n + (c.chunk_remaining(arena) as u64);
        c.next_chunk(arena);
    }
    return n;
}

/// Point lookup.
pub fn bt_find(arena: &BtArena, t: &BtTree, key: u64) -> Option<u64> {
    unsafe {
        let mut sh: FindShuttle = FindShuttle { key: key };
        let mut path: Vec<(u64, u32)> = vec_new::<(u64, u32)>();
        let (leaf, r) = bt_ride(arena, t.root, (&mut sh) as *mut dyn Shuttle, &mut path);
        if !r.found { return Option::None; }
        return Option::Some(nvals(bt_pkd(arena.at(leaf))).get(0u32, r.pos as u64));
    }
}

// Fix the max-key chain after a rightmost change in the node at the bottom
// of `path`: each ancestor's chosen-child key is refreshed bottom-up.
unsafe fn fix_maxes(arena: &BtArena, path: &Vec<(u64, u32)>, bottom: u64) {
    let mut child: u64 = bottom;
    let mut i: i64 = path.len() - 1i64;
    while i >= 0i64 {
        let (bid, idx) = path.get(i);
        let mut ks: PdtBuf = nkeys(bt_pkd(arena.at(bid)));
        let cm: u64 = max_key(bt_pkd(arena.at(child)));
        if ks.get(0u32, idx as u64) != cm { ks.set(0u32, idx as u64, cm); }
        child = bid;
        i = i - 1i64;
    }
}

// Split `node` at its midpoint into a fresh right sibling; returns its id.
unsafe fn split_node(arena: &mut BtArena, node: u64) -> u64 {
    let nb: *mut BtNode = arena.at(node);
    let leaf: bool = node_is_leaf(nb);
    let lvl: u32 = node_level(nb);
    let right: u64 = arena.alloc_node(leaf, lvl);
    let rp: *mut PkdAlloc = bt_pkd(arena.at(right));
    let p: *mut PkdAlloc = bt_pkd(arena.at(node));
    let mid: u32 = keys_count(p) / 2u32;
    // per-column two-phase split: reserve the right side through ITS OWN
    // nested chain, then prepare/commit (the btfl branch idiom).
    let mut c: u32 = SLOT_KEYS;
    while c <= SLOT_VALS {
        let mut lb: PdtBuf = pdtbuf_adopt(p.get::<u8>(c));
        let n_c: u64 = lb.size();
        let mut rb: PdtBuf = pdtbuf_adopt(rp.get::<u8>(c));
        match rb.reserve(n_c - (mid as u64)) {
            Result::Ok(_u) => {}
            Result::Err(_e) => { assert(false, "bt: split reserve failed"); }
        }
        let mut lb2: PdtBuf = pdtbuf_adopt(p.get::<u8>(c));
        let mut rb2: PdtBuf = pdtbuf_adopt(rp.get::<u8>(c));
        let sp: PdtSplit = match lb2.prepare_split_to(&rb2, mid as u64, PDT_CAP_KEEP) {
            Result::Ok(x) => x,
            Result::Err(_e) => { assert(false, "bt: split prepare failed"); return right; }
        };
        lb2.commit_split_to(&mut rb2, &sp);
        c = c + 1u32;
    }
    return right;
}

// After splitting `left` into `left`+`right`: fix left's key in its parent
// and wire `right` in after it. Splits the parent recursively when full;
// pi indexes the parent within `path` (−1 ⇒ left was the root).
unsafe fn wire_split(arena: &mut BtArena, t: &mut BtTree,
                     path: &Vec<(u64, u32)>, pi: i64, left: u64, right: u64) {
    let rmax: u64 = max_key(bt_pkd(arena.at(right)));
    let lmax: u64 = max_key(bt_pkd(arena.at(left)));
    if pi < 0i64 {
        let lvl: u32 = node_level(arena.at(left));
        let nr: u64 = arena.alloc_node(false, lvl + 1u32);
        let np: *mut PkdAlloc = bt_pkd(arena.at(nr));
        bt_put_row(np, 0u32, lmax, left);
        bt_put_row(np, 1u32, rmax, right);
        t.root = nr;
        return;
    }
    let (bid, idx) = path.get(pi);
    let bp: *mut PkdAlloc = bt_pkd(arena.at(bid));
    {
        let mut kb: PdtBuf = nkeys(bp);
        kb.set(0u32, idx as u64, lmax);           // left kept the low half
    }
    // Priced up front — no partial-insert recovery states (the two-phase
    // discipline replaces the try-then-undo PkdArray flow).
    if bt_fits_row(bp, idx + 1u32) {
        bt_put_row(bp, idx + 1u32, rmax, right);
        return;
    }
    // parent full: split it, wire ITS halves one level up, then place
    // (rmax, right) into whichever half now owns position idx+1
    let bright: u64 = split_node(arena, bid);
    wire_split(arena, t, path, pi - 1i64, bid, bright);
    let bp2: *mut PkdAlloc = bt_pkd(arena.at(bid));
    let lcnt: u32 = keys_count(bp2);
    if idx + 1u32 <= lcnt {
        bt_put_row(bp2, idx + 1u32, rmax, right);
    } else {
        let brp: *mut PkdAlloc = bt_pkd(arena.at(bright));
        bt_put_row(brp, (idx + 1u32) - lcnt, rmax, right);
    }
}

/// Inserts/overwrites `key → val`. Returns false only on block exhaustion.
pub fn bt_insert(arena: &mut BtArena, t: &mut BtTree, key: u64, val: u64) -> bool {
    unsafe {
        let mut sh: FindShuttle = FindShuttle { key: key };
        let mut path: Vec<(u64, u32)> = vec_new::<(u64, u32)>();
        let (leaf, r) = bt_ride(arena, t.root, (&mut sh) as *mut dyn Shuttle, &mut path);
        let lp: *mut PkdAlloc = bt_pkd(arena.at(leaf));
        if r.found {
            let mut vb: PdtBuf = nvals(lp);
            vb.set(0u32, r.pos as u64, val);
            return true;
        }
        let n0: u32 = keys_count(lp);
        if bt_fits_row(lp, r.pos) {
            bt_put_row(lp, r.pos, key, val);
            if r.pos == n0 { fix_maxes(arena, &path, leaf); }
            return true;
        }
        // leaf full → split, wire the right half in, then retry: the target
        // leaf (either half) now has room
        let right: u64 = split_node(arena, leaf);
        wire_split(arena, t, &path, path.len() - 1i64, leaf, right);
        return bt_insert(arena, t, key, val);
    }
}

/// Removes `key`; false when absent. v0 keeps structure simple: an emptied
/// leaf stays (merge/borrow rebalancing lands with the size stream).
pub fn bt_remove(arena: &mut BtArena, t: &mut BtTree, key: u64) -> bool {
    unsafe {
        let mut sh: FindShuttle = FindShuttle { key: key };
        let mut path: Vec<(u64, u32)> = vec_new::<(u64, u32)>();
        let (leaf, r) = bt_ride(arena, t.root, (&mut sh) as *mut dyn Shuttle, &mut path);
        if !r.found { return false; }
        let lp: *mut PkdAlloc = bt_pkd(arena.at(leaf));
        bt_del_row(lp, r.pos);
        let n: u32 = keys_count(lp);
        if n > 0u32 && r.pos == n {
            fix_maxes(arena, &path, leaf);   // removed the rightmost entry
        }
        return true;
    }
}

// ── streaming creation (the killer feature) ─────────────────────────────────

/// Builds a tree BOTTOM-UP from `n` sorted (keys[i], vals[i]) entries:
/// leaves fill left to right to `per_node`, then branch levels assemble
/// from the level below — no per-element descent. Sorted input is the
/// caller's contract.
pub fn bt_bulk_build(arena: &mut BtArena, keys: *const u64, vals: *const u64,
                     n: i64, per_node: u32) -> BtTree {
    unsafe {
        if n == 0i64 { return bt_new(arena); }
        let mut level_ids: Vec<u64> = vec_new::<u64>();
        let mut i: i64 = 0i64;
        while i < n {
            let leaf: u64 = arena.alloc_node(true, 0u32);
            let lp: *mut PkdAlloc = bt_pkd(arena.at(leaf));
            let mut k: u32 = 0u32;
            while k < per_node && i < n {
                bt_put_row(lp, k, *keys.add(i), *vals.add(i));
                k = k + 1u32;
                i = i + 1i64;
            }
            level_ids.push(leaf);
        }
        let mut lvl: u32 = 1u32;
        while level_ids.len() > 1i64 {
            let mut next: Vec<u64> = vec_new::<u64>();
            let mut j: i64 = 0i64;
            while j < level_ids.len() {
                let br: u64 = arena.alloc_node(false, lvl);
                let bp: *mut PkdAlloc = bt_pkd(arena.at(br));
                let mut k2: u32 = 0u32;
                while k2 < per_node && j < level_ids.len() {
                    let cid: u64 = level_ids.get(j);
                    bt_put_row(bp, k2, max_key(bt_pkd(arena.at(cid))), cid);
                    k2 = k2 + 1u32;
                    j = j + 1i64;
                }
                next.push(br);
            }
            level_ids = next;
            lvl = lvl + 1u32;
        }
        return BtTree { root: level_ids.get(0i64) };
    }
}

// ── chunk cursor (rides shuttles; leaf-granularity, bidirectional) ──────────

pub struct BtCursor {
    path: Vec<(u64, u32)>,       // branch descent trail
    leaf: u64,                   // 0 = invalid/end
    pos:  u32,
}

/// Cursor at the tree's first entry (invalid for an empty tree).
pub fn bt_first(arena: &BtArena, t: &BtTree) -> BtCursor {
    unsafe {
        let mut path: Vec<(u64, u32)> = vec_new::<(u64, u32)>();
        let mut cur: u64 = t.root;
        loop {
            let base: *mut BtNode = arena.at(cur);
            if node_is_leaf(base) { break; }
            path.push((cur, 0u32));
            cur = nvals(bt_pkd(base)).get(0u32, 0u64);
        }
        if keys_count(bt_pkd(arena.at(cur))) == 0u32 {
            return BtCursor { path: path, leaf: 0u64, pos: 0u32 };
        }
        return BtCursor { path: path, leaf: cur, pos: 0u32 };
    }
}

/// Cursor at `key`'s lower bound (find-shuttle positioning).
pub fn bt_seek(arena: &BtArena, t: &BtTree, key: u64) -> BtCursor {
    unsafe {
        let mut sh: FindShuttle = FindShuttle { key: key };
        let mut path: Vec<(u64, u32)> = vec_new::<(u64, u32)>();
        let (leaf, r) = bt_ride(arena, t.root, (&mut sh) as *mut dyn Shuttle, &mut path);
        let n: u32 = keys_count(bt_pkd(arena.at(leaf)));
        if r.pos >= n {
            // lower bound falls past this leaf → first entry of the next one
            let mut c: BtCursor = BtCursor { path: path, leaf: leaf,
                                             pos: if n == 0u32 { 0u32 } else { n - 1u32 } };
            c.next_chunk(arena);
            return c;
        }
        return BtCursor { path: path, leaf: leaf, pos: r.pos };
    }
}

impl BtCursor {
    pub fn valid(self: &BtCursor) -> bool { return self.leaf != 0u64; }
    pub fn key(self: &BtCursor, arena: &BtArena) -> u64 {
        return unsafe { nkeys(bt_pkd(arena.at(self.leaf))).get(0u32, self.pos as u64) };
    }
    pub fn val(self: &BtCursor, arena: &BtArena) -> u64 {
        return unsafe { nvals(bt_pkd(arena.at(self.leaf))).get(0u32, self.pos as u64) };
    }
    /// Entries remaining in the current chunk (leaf) from the cursor on.
    pub fn chunk_remaining(self: &BtCursor, arena: &BtArena) -> u32 {
        return unsafe { keys_count(bt_pkd(arena.at(self.leaf))) - self.pos };
    }

    /// Steps one entry forward, hopping leaves through the path.
    pub fn next(self: &mut BtCursor, arena: &BtArena) {
        unsafe {
            let n: u32 = keys_count(bt_pkd(arena.at(self.leaf)));
            if self.pos + 1u32 < n { self.pos = self.pos + 1u32; return; }
            self.next_chunk(arena);
        }
    }

    /// Hops to the first entry of the next leaf; invalidates at the end.
    pub fn next_chunk(self: &mut BtCursor, arena: &BtArena) {
        unsafe {
            loop {
                if self.path.len() == 0i64 { self.leaf = 0u64; return; }
                let (bid, idx) = self.path.get(self.path.len() - 1i64);
                let bp: *mut PkdAlloc = bt_pkd(arena.at(bid));
                if idx + 1u32 < keys_count(bp) {
                    self.path.set(self.path.len() - 1i64, (bid, idx + 1u32));
                    let mut cur: u64 = nvals(bp).get(0u32, (idx as u64) + 1u64);
                    loop {
                        let base: *mut BtNode = arena.at(cur);
                        if node_is_leaf(base) { break; }
                        self.path.push((cur, 0u32));
                        cur = nvals(bt_pkd(base)).get(0u32, 0u64);
                    }
                    self.leaf = cur;
                    self.pos = 0u32;
                    return;
                }
                let _ = self.path.pop();
            }
        }
    }

    /// Steps one entry backward (the bidirectional ride), hopping leaves.
    pub fn prev(self: &mut BtCursor, arena: &BtArena) {
        unsafe {
            if self.pos > 0u32 { self.pos = self.pos - 1u32; return; }
            loop {
                if self.path.len() == 0i64 { self.leaf = 0u64; return; }
                let (bid, idx) = self.path.get(self.path.len() - 1i64);
                if idx > 0u32 {
                    self.path.set(self.path.len() - 1i64, (bid, idx - 1u32));
                    let bp: *mut PkdAlloc = bt_pkd(arena.at(bid));
                    let mut cur: u64 = nvals(bp).get(0u32, (idx as u64) - 1u64);
                    loop {
                        let base: *mut BtNode = arena.at(cur);
                        if node_is_leaf(base) { break; }
                        let p: *mut PkdAlloc = bt_pkd(base);
                        let last: u32 = keys_count(p) - 1u32;
                        self.path.push((cur, last));
                        cur = nvals(p).get(0u32, last as u64);
                    }
                    self.leaf = cur;
                    self.pos = keys_count(bt_pkd(arena.at(cur))) - 1u32;
                    return;
                }
                let _ = self.path.pop();
            }
        }
    }
}

/// Stage marker: bumps as M2 slices land (1 = point ops + bulk + cursor).
pub fn bt_stage() -> i64 { return 1i64; }
