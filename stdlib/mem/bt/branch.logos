// logos.mem.bt.branch — BranchU64: a CONCRETE b+tree branch node over LeafU64
// children (ADR 0020 Track B, step 2c foundation). Concrete on purpose — the
// real branch is generated per instantiation; this is the validation vehicle
// and the generator's template, the height>1 companion to LeafU64/LeafKV.
//
// Layout: one owned block, THREE sibling FSE u64 columns —
//   slot 0 sep : the separator key of each child = the MAX key in that child's
//                subtree (the last, sorted, key). Search descends to the first
//                child whose separator is >= the sought key.
//   slot 1 sz  : the subtree SIZE (entry count) of each child. This is the SUM
//                measure column (ADR §3 measures): total_size folds it, and
//                rank() adds a prefix of it to a within-leaf offset — O(fanout)
//                order statistics without touching the leaves' payloads.
//   slot 2 ptr : the child's block address (a LeafU64, reached via adopt).
//
// Nodes are TREE-MANAGED (block-id/arena lifecycle, ADR NodeARC→block-id): the
// branch owns its child blocks; free_children releases them. Branch columns are
// all-FSE, so split is count-balanced (the leaf's volume path does not apply).
package logos.mem.bt.branch;

use logos.mem.pkd;          // PkdAlloc, PkdArray
use logos.mem.bt.leaf;      // LeafU64
use logos.mem.bt.node;      // node_alloc / node_pkd / node_free (16-byte header)
use logos.lang.result;

/// Branch block size (a container constant later; a fixed 4K for now).
const BR_MAX_BLOCK: u32 = 4096u32;

pub struct BranchU64 {
    mem: *mut u8,
    cap: u32,
}

impl BranchU64 {
    const SLOT_SEP: u32 = 0u32;
    const SLOT_SZ:  u32 = 1u32;
    const SLOT_PTR: u32 = 2u32;

    /// A fresh empty branch (no children yet), stamped snapshot id 0 (default).
    pub static fn new() -> BranchU64 { return BranchU64::new_in(0u64); }
    /// As `new`, stamping the block with snapshot id `snp` (the CoW skip key).
    pub static fn new_in(snp: u64) -> BranchU64 {
        unsafe {
            let base: *mut u8 = node_alloc(BR_MAX_BLOCK, 3u32, snp);
            let a: *mut PkdAlloc = node_pkd(base);
            match PkdArray::<u64>::format(a, 0u32) {
                Result::Ok(_p) => {} Result::Err(_e) => { assert(false, "BranchU64::new sep"); }
            }
            match PkdArray::<u64>::format(a, 1u32) {
                Result::Ok(_p) => {} Result::Err(_e) => { assert(false, "BranchU64::new sz"); }
            }
            match PkdArray::<u64>::format(a, 2u32) {
                Result::Ok(_p) => {} Result::Err(_e) => { assert(false, "BranchU64::new ptr"); }
            }
            return BranchU64 { mem: base, cap: BR_MAX_BLOCK };
        }
    }

    /// A non-owning handle over an existing branch block (tree-managed).
    pub static fn adopt(mem: *mut u8) -> BranchU64 {
        return BranchU64 { mem: mem, cap: unsafe { (*node_pkd(mem)).block_size() } };
    }
    pub fn block(self: &BranchU64) -> *mut u8 { return self.mem; }

    unsafe fn a(self: &BranchU64) -> *mut PkdAlloc { return node_pkd(self.mem); }
    unsafe fn sep(self: &BranchU64) -> *mut PkdArray<u64> { return self.a().get::<PkdArray<u64>>(BranchU64::SLOT_SEP); }
    unsafe fn szc(self: &BranchU64) -> *mut PkdArray<u64> { return self.a().get::<PkdArray<u64>>(BranchU64::SLOT_SZ); }
    unsafe fn ptrc(self: &BranchU64) -> *mut PkdArray<u64> { return self.a().get::<PkdArray<u64>>(BranchU64::SLOT_PTR); }

    pub fn child_count(self: &BranchU64) -> u32 { return unsafe { (*self.sep()).count() }; }
    pub fn sep_at(self: &BranchU64, i: u32) -> u64 { return unsafe { (*self.sep()).get(i) }; }
    pub fn size_at(self: &BranchU64, i: u32) -> u64 { return unsafe { (*self.szc()).get(i) }; }
    /// The child leaf at index i as a non-owning handle.
    pub fn child(self: &BranchU64, i: u32) -> LeafU64 {
        let p: u64 = unsafe { (*self.ptrc()).get(i) };
        return LeafU64::adopt(unsafe { p as *mut u8 });
    }
    /// The child's raw block address — for a height-tagged descent where the
    /// child may itself be a branch (the tree, not the node, knows the level).
    pub fn child_addr(self: &BranchU64, i: u32) -> *mut u8 {
        return unsafe { (*self.ptrc()).get(i) as *mut u8 };
    }
    /// Repoints child `i` at `ptr` (its sep/size via update_child). Used by CoW
    /// when a descended child is copied and the parent must reference the copy.
    pub fn set_child_addr(self: &mut BranchU64, i: u32, ptr: *mut u8) {
        unsafe { (*self.ptrc()).set(i, ptr as u64); }
    }
    /// This branch's separator (max key it routes) — the last child's separator.
    pub fn max_sep(self: &BranchU64) -> u64 {
        let n: u32 = self.child_count();
        assert(n > 0u32, "BranchU64::max_sep: empty branch");
        return self.sep_at(n - 1u32);
    }

    /// The SUM measure: total entries across all child subtrees (fold of the sz
    /// column). A cached summary later; the fold proves the column's purpose.
    pub fn total_size(self: &BranchU64) -> u64 {
        let n: u32 = self.child_count();
        let mut s: u64 = 0u64;
        let mut i: u32 = 0u32;
        while i < n { s = s + self.size_at(i); i = i + 1u32; }
        return s;
    }

    /// The first child whose separator is >= key (the subtree that holds key, or
    /// would); the rightmost child when key exceeds every separator.
    pub fn find_child(self: &BranchU64, key: u64) -> u32 {
        let n: u32 = self.child_count();
        let mut i: u32 = 0u32;
        while i < n {
            if self.sep_at(i) >= key { return i; }
            i = i + 1u32;
        }
        return if n > 0u32 { n - 1u32 } else { 0u32 };
    }

    /// Order statistic via the SUM column: the number of entries strictly before
    /// `key` in the whole subtree = Σ sizes of children fully before the target
    /// child + the key's lower_bound offset inside that child. O(fanout), no
    /// payload access on the skipped children.
    pub fn rank(self: &BranchU64, key: u64) -> u64 {
        let n: u32 = self.child_count();
        if n == 0u32 { return 0u64; }
        let ci: u32 = self.find_child(key);
        let mut base: u64 = 0u64;
        let mut i: u32 = 0u32;
        while i < ci { base = base + self.size_at(i); i = i + 1u32; }
        let leaf: LeafU64 = self.child(ci);
        return base + (leaf.lower_bound(key) as u64);
    }

    /// Point lookup: descend to the covering child and probe it. Returns the
    /// value, or `sentinel` when the key is absent.
    pub fn get_or(self: &BranchU64, key: u64, sentinel: u64) -> u64 {
        let n: u32 = self.child_count();
        if n == 0u32 { return sentinel; }
        let ci: u32 = self.find_child(key);
        let leaf: LeafU64 = self.child(ci);
        let p: u32 = leaf.lower_bound(key);
        if p < leaf.count() && leaf.key_at(p) == key { return leaf.val_at(p); }
        return sentinel;
    }

    /// Appends a child (its separator = max key, its size = entry count, its
    /// block address). Children must be pushed in ascending separator order.
    pub fn push_child(self: &mut BranchU64, sep: u64, sz: u64, ptr: *mut u8) {
        unsafe {
            let p: u64 = ptr as u64;
            let _ = (*self.sep()).push(&sep);
            let _ = (*self.szc()).push(&sz);
            let _ = (*self.ptrc()).push(&p);
        }
    }

    /// Inserts a child entry at position `pos` (keeps separator order). Used when
    /// a child split introduces a new right sibling between existing children.
    pub fn insert_child(self: &mut BranchU64, pos: u32, sep: u64, sz: u64, ptr: *mut u8) {
        unsafe {
            let p: u64 = ptr as u64;
            let _ = (*self.sep()).insert(pos, &sep);
            let _ = (*self.szc()).insert(pos, &sz);
            let _ = (*self.ptrc()).insert(pos, &p);
        }
    }

    /// Refreshes child `i`'s separator + size after the child itself mutated
    /// (an insert changed its max key / entry count). The pointer is unchanged.
    pub fn update_child(self: &mut BranchU64, i: u32, sep: u64, sz: u64) {
        unsafe {
            (*self.sep()).set(i, sep);
            (*self.szc()).set(i, sz);
        }
    }

    /// Would one more child entry (24 bytes across the three FSE columns) fit in
    /// this branch's block? The caller splits the branch first when it won't.
    pub fn can_insert_child(self: &BranchU64) -> bool {
        unsafe {
            let d0: u32 = (*self.sep()).estimate_insert(8u32) - self.a().element_size(BranchU64::SLOT_SEP);
            let d1: u32 = (*self.szc()).estimate_insert(8u32) - self.a().element_size(BranchU64::SLOT_SZ);
            let d2: u32 = (*self.ptrc()).estimate_insert(8u32) - self.a().element_size(BranchU64::SLOT_PTR);
            return d0 + d1 + d2 <= self.a().free_space();
        }
    }

    /// Splits the tail [at..count) of children into `dst`, truncating self to
    /// [0..at). All-FSE → count-balanced (at = count/2). Returns the promoted
    /// separator: self's new max, the routing key the parent stores between the
    /// two branches (max-of-child style: copied up, not removed).
    pub fn split_into(self: &mut BranchU64, dst: &mut BranchU64) -> u64 {
        let at: u32 = self.child_count() / 2u32;
        unsafe {
            let _ = (*self.sep()).split_into(&mut *dst.sep(), at);
            let _ = (*self.szc()).split_into(&mut *dst.szc(), at);
            let _ = (*self.ptrc()).split_into(&mut *dst.ptrc(), at);
        }
        return self.max_sep();
    }

    /// Releases every child leaf block, then this branch's own block. The owner
    /// calls this exactly once (tree-managed lifecycle). For a multi-level tree
    /// whose children are themselves branches, the tree walks recursively and
    /// frees each block via `free_block` instead.
    pub fn free_children(self: BranchU64) {
        let n: u32 = self.child_count();
        let mut i: u32 = 0u32;
        while i < n {
            self.child(i).free();
            i = i + 1u32;
        }
        unsafe { node_free(self.mem); }
    }

    /// Releases ONLY this branch's own block (its children are freed elsewhere,
    /// e.g. a recursive tree teardown). Call once.
    pub fn free_block(self: BranchU64) { unsafe { node_free(self.mem); } }

    /// A private copy of this branch on a fresh block stamped snapshot id `snp`
    /// (CoW duplication). Copies the child entries and BUMPS each child's rc —
    /// the copy and the original now SHARE the children (structural sharing).
    /// The caller owns the copy (rc = 1); it releases the original's pointer
    /// separately once it has switched to the copy.
    pub fn cow_clone(self: &BranchU64, snp: u64) -> BranchU64 {
        let mut c: BranchU64 = BranchU64::new_in(snp);
        let n: u32 = self.child_count();
        let mut i: u32 = 0u32;
        while i < n {
            let p: *mut u8 = self.child_addr(i);
            unsafe { node_inc_rc(p); }
            c.push_child(self.sep_at(i), self.size_at(i), p);
            i = i + 1u32;
        }
        return c;
    }
}
