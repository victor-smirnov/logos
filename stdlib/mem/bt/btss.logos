// logos.mem.bt.btss — the SINGLE-STREAM leaf substrate (Memoria bt_ss, S2b/B).
//
// The algorithms every Canon-generated single-stream leaf shares, extracted
// from the emitter blobs into ONE set of functions over the leaf's PkdAlloc:
// a leaf is two single-column PdtBufs (slot 0 = MAX-ordered FSE64 keys,
// slot 1 = FSE64 or VLE values; blocks self-describe). The generated node
// keeps only its TYPED surface (K/V casts at the boundary) and its header
// flavor; the algorithm bodies live here exactly once.
//
// SIGN DISCIPLINE: cells are u64 at rest. Functions here are either
// sign-AGNOSTIC (formatting, splitting, counting — byte/row moves) or come in
// signedness variants chosen by the emitter from the key type's verdict.
// Nothing in this module compares keys through a blind u64 cast.
package logos.mem.bt.btss;

use logos.mem.pkd;               // PkdAlloc, SlotKind
use logos.mem.pkd.pdtbuf;        // PdtBuf — the column store
use logos.mem.collections.vec;
use logos.lang.result;
use logos.lang.panic;
use logos.lang.slice;            // slice_from_raw — a row's bytes as a view
use logos.lang.mem;              // compare_bytes

/// The longest `str` key an ordered_map admits, in bytes — and so the
/// separator a bytes-keyed branch reserves room for per child row.
pub const STR_KEY_RESERVE: i64 = 255i64;

/// Format slot `slot` of a leaf as a single-column PdtBuf at the capacity-0
/// geometry, wired to the node allocator (the nested-block discipline).
/// `vle` picks the value shape; `ordered` marks the MAX-measure key column.
pub unsafe fn btss_fmt_slot(a: *mut PkdAlloc, slot: u32, vle: bool, ordered: bool) {
    let mut ord: u32 = PDT_ORD_UNORDERED;
    if ordered {
        ord = PDT_ORD_MAX;
    }
    let mut d: PdtDescr = pdt_descr_new(1u32, ord, false);
    if vle {
        d.dims.push(pdt_dim_vle(1u32));
    } else {
        d.dims.push(pdt_dim_fse(8u32));
    }
    let zero: Vec<u64> = pdt_payload_zero(&d);
    let need: u32 = pdtbuf_compute_block_size(&d, 0u64, &zero);
    let p: *mut u8 = match (*a).allocate(slot, need, SlotKind::Allocatable) {
        Result::Ok(q) => q,
        Result::Err(_e) => {
            assert(false, "btss: leaf col slot");
            return;
        }
    };
    let bsz: u32 = (*a).element_size(slot);
    match pdtbuf_format(p, bsz, &d) {
        Result::Ok(_b) => {}
        Result::Err(_e) => {
            assert(false, "btss: leaf col fmt");
        }
    }
    let inner: *mut PkdAlloc = p as *mut PkdAlloc;
    (*inner).set_allocator(a as *const PkdAlloc);
}

/// Two-phase split of column `slot` at row `at` into the (freshly formatted)
/// right leaf — a VLE column reserves the moving payload bytes through the
/// right side's own nested chain first (the P7 discipline).
pub unsafe fn btss_split_col(a: *mut PkdAlloc, ra: *mut PkdAlloc, slot: u32, at: u32) {
    let mut lb: PdtBuf = pdtbuf_adopt((*a).get::<u8>(slot));
    let n: u64 = lb.size();
    let mut rb: PdtBuf = pdtbuf_adopt((*ra).get::<u8>(slot));
    if rb.vle_dim_count() > 0u32 {
        let moving: u64 = lb.payload_used(0u32, 0u32)
                        - lb.row_offset(0u32, 0u32, at as u64);
        let mut pay: Vec<u64> = vec_new::<u64>();
        pay.push(moving);
        match rb.reserve_geom(n - (at as u64), &pay) {
            Result::Ok(_u) => {}
            Result::Err(_e) => {
                assert(false, "btss: leaf split reserve");
            }
        }
    } else {
        match rb.reserve(n - (at as u64)) {
            Result::Ok(_u) => {}
            Result::Err(_e) => {
                assert(false, "btss: leaf split reserve");
            }
        }
    }
    let mut lb2: PdtBuf = pdtbuf_adopt((*a).get::<u8>(slot));
    let mut rb2: PdtBuf = pdtbuf_adopt((*ra).get::<u8>(slot));
    let sp: PdtSplit = match lb2.prepare_split_to(&rb2, at as u64, PDT_CAP_KEEP) {
        Result::Ok(x) => x,
        Result::Err(_e) => {
            assert(false, "btss: leaf split prepare");
            return;
        }
    };
    lb2.commit_split_to(&mut rb2, &sp);
}

/// Entry count of a leaf (its key column's row count).
pub unsafe fn btss_count(a: *mut PkdAlloc) -> u32 {
    return pdtbuf_adopt((*a).get::<u8>(0u32)).size() as u32;
}

// btss_upsert_at / btss_upsert_vals_at died into the node stream-CRUD
// algebra (ADR 0023 S4): the factory now emits per-schema fused kernels
// (logos.lcm.canon.alg_kernel) and generated try_insert calls them; the
// reference semantics live in logos.mem.bt.interp.

/// The VOLUME-balanced split index: bisect for the row whose cumulative
/// byte weight (key cell or key bytes + value payload) crosses half the
/// total. Pure geometry — sign-free.
pub unsafe fn btss_split_index_volume(a: *mut PkdAlloc) -> u32 {
    let n: u32 = btss_count(a);
    if n <= 1u32 {
        return n;
    }
    let total: u32 = btss_key_weight(a, n) + btss_val_weight(a, n);
    let half: u32 = total / 2u32;
    let mut lo: u32 = 1u32;
    let mut hi: u32 = n - 1u32;
    let mut at: u32 = 1u32;
    while lo <= hi {
        let mid: u32 = lo + (hi - lo) / 2u32;
        let cv: u32 = btss_key_weight(a, mid) + btss_val_weight(a, mid);
        if cv <= half {
            at = mid;
            lo = mid + 1u32;
        } else {
            if mid == 1u32 {
                break;
            }
            hi = mid - 1u32;
        }
    }
    return at;
}

/// The byte weight of the first `m` keys: 8 per FSE cell, or the payload a
/// VLE (bytes) key column holds before row `m`.
pub unsafe fn btss_key_weight(a: *mut PkdAlloc, m: u32) -> u32 {
    let kb: PdtBuf = pdtbuf_adopt((*a).get::<u8>(0u32));
    if kb.vle_dim_count() > 0u32 { return kb.row_offset(0u32, 0u32, m as u64) as u32; }
    return m * 8u32;
}

/// The byte weight of the first `m` values: the VLE payload before row `m`,
/// or 8 per FSE cell (a `str`-keyed family is volume-split over FSE values).
pub unsafe fn btss_val_weight(a: *mut PkdAlloc, m: u32) -> u32 {
    let vb: PdtBuf = pdtbuf_adopt((*a).get::<u8>(1u32));
    if vb.vle_dim_count() > 0u32 { return vb.row_offset(0u32, 0u32, m as u64) as u32; }
    return m * 8u32;
}

/// Row `i` of the VLE column `slot`, as a view of its bytes inside the block.
/// Valid until the next write to that column.
pub unsafe fn btss_row_bytes<'a>(a: *mut PkdAlloc, slot: u32, i: u32) -> &'a [u8] {
    let b: PdtBuf = pdtbuf_adopt((*a).get::<u8>(slot));
    let off: u64 = b.row_offset(0u32, 0u32, i as u64);
    let len: u64 = b.row_len(0u32, 0u32, i as u64);
    return slice_from_raw::<u8>(b.payload(0u32, 0u32).byte_add(off as i64), len as i64);
}

/// The order of byte-string keys: lexicographic, a proper prefix first
/// (memcmp over the common length, then the shorter is less). <0, 0, >0.
pub fn bytes_cmp(x: &[u8], y: &[u8]) -> i32 {
    let n: i64 = if x.len() < y.len() { x.len() } else { y.len() };
    if n > 0i64 {
        let c: i32 = unsafe { compare_bytes(x.as_ptr(), y.as_ptr(), n) };
        if c != 0i32 { return c; }
    }
    if x.len() < y.len() { return -1i32; }
    if x.len() > y.len() { return 1i32; }
    return 0i32;
}

/// lower_bound over a BYTES key column (slot 0, VLE, formatted UNORDERED —
/// pdt LAW 4 admits only an FSE ordered dimension, so the order is kept by
/// the writers and searched here): the first row whose key is >= `key`.
pub unsafe fn btss_lower_bound_bytes(a: *mut PkdAlloc, key: &[u8]) -> u32 {
    let n: u32 = btss_count(a);
    let mut lo: u32 = 0u32;
    let mut hi: u32 = n;
    while lo < hi {
        let mid: u32 = lo + (hi - lo) / 2u32;
        if bytes_cmp(btss_row_bytes(a, 0u32, mid), key) < 0i32 { lo = mid + 1u32; } else { hi = mid; }
    }
    return lo;
}

/// lower_bound over the key column, UNSIGNED domain: first row whose key cell
/// is >= `key` as u64. The signedness VARIANT is chosen by the emitter from
/// the key type's verdict — a blind u64 compare would invert negative i64
/// keys, so the signed twin below exists and nothing here guesses.
pub unsafe fn btss_lower_bound_u64(a: *mut PkdAlloc, key: u64) -> u32 {
    let kb: PdtBuf = pdtbuf_adopt((*a).get::<u8>(0u32));
    let n: u32 = kb.size() as u32;
    let mut i: u32 = 0u32;
    while i < n {
        if kb.get(0u32, i as u64) >= key {
            return i;
        }
        i = i + 1u32;
    }
    return n;
}

/// lower_bound over the key column, SIGNED domain (cells reinterpreted i64).
pub unsafe fn btss_lower_bound_i64(a: *mut PkdAlloc, key: i64) -> u32 {
    let kb: PdtBuf = pdtbuf_adopt((*a).get::<u8>(0u32));
    let n: u32 = kb.size() as u32;
    let mut i: u32 = 0u32;
    while i < n {
        if (kb.get(0u32, i as u64) as i64) >= key {
            return i;
        }
        i = i + 1u32;
    }
    return n;
}

/// A one-cell two-phase append/insert into column `slot` (priced by the
/// caller — branch rows are inserted only after a fits check).
pub unsafe fn btss_put_cell(a: *mut PkdAlloc, slot: u32, pos: u32, v: u64) {
    let b: PdtBuf = pdtbuf_adopt((*a).get::<u8>(slot));
    let us: PdtUpdate = match b.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
        Result::Ok(u) => u,
        Result::Err(_e) => {
            assert(false, "btss: branch cell prepare");
            return;
        }
    };
    let mut b2: PdtBuf = pdtbuf_adopt((*a).get::<u8>(slot));
    let mut row: Vec<u64> = vec_new::<u64>();
    row.push(v);
    b2.commit_insert(&us, &row);
}

/// EXACT one-more-row admission over the first `slots` columns: every grow
/// priced by the same prepare that would commit it, summed against the one
/// block's free space (the estimate-free discipline).
pub unsafe fn btss_fits_row(a: *mut PkdAlloc, slots: u32) -> bool {
    let mut total: u32 = 0u32;
    let mut c: u32 = 0u32;
    while c < slots {
        let b: PdtBuf = pdtbuf_adopt((*a).get::<u8>(c));
        let us: PdtUpdate = match b.prepare_insert(b.size(), 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                return false;
            }
        };
        total = total + us.grow_bytes();
        c = c + 1u32;
    }
    return total <= (*a).free_space();
}

/// A one-row two-phase insert of `v`'s bytes into the VLE column `slot`
/// (priced by the caller, like `btss_put_cell`). The bytes are COPIED into the
/// carrier before the commit, so `v` may view another block — a child's
/// separator — or even this column.
pub unsafe fn btss_put_span(a: *mut PkdAlloc, slot: u32, pos: u32, v: &[u8]) {
    let mut vals: PdtVals = pdt_vals_new();
    vals.push_span(v);
    let b: PdtBuf = pdtbuf_adopt((*a).get::<u8>(slot));
    let us: PdtUpdate = match b.prepare_insert_vals(pos as u64, 1u64, PDT_CAP_KEEP, &vals) {
        Result::Ok(u) => u,
        Result::Err(_e) => {
            assert(false, "btss: VLE row insert does not fit (unpriced caller)");
            return;
        }
    };
    let mut b2: PdtBuf = pdtbuf_adopt((*a).get::<u8>(slot));
    b2.commit_insert_vals(&us, &vals);
}

/// Replace row `pos` of the VLE column `slot` with `v`'s bytes. Copied first,
/// as in `btss_put_span`. False (column untouched) when the new bytes do not fit.
pub unsafe fn btss_set_span(a: *mut PkdAlloc, slot: u32, pos: u32, v: &[u8]) -> bool {
    let mut vals: PdtVals = pdt_vals_new();
    vals.push_span(v);
    let b: PdtBuf = pdtbuf_adopt((*a).get::<u8>(slot));
    let us: PdtUpdate = match b.prepare_update_vals(pos as u64, 1u64, PDT_CAP_KEEP, &vals) {
        Result::Ok(u) => u,
        Result::Err(_e) => { return false; }
    };
    let mut b2: PdtBuf = pdtbuf_adopt((*a).get::<u8>(slot));
    b2.commit_update_vals(&us, &vals);
    return true;
}

/// `btss_fits_row` for a row whose column 0 is VLE carrying `k0` bytes (a
/// bytes-keyed branch: separator + count + child): every grow priced by the
/// prepare that would commit it.
pub unsafe fn btss_fits_row_span(a: *mut PkdAlloc, slots: u32, k0: &[u8]) -> bool {
    let mut vals: PdtVals = pdt_vals_new();
    vals.push_span(k0);
    let b0: PdtBuf = pdtbuf_adopt((*a).get::<u8>(0u32));
    let u0: PdtUpdate = match b0.prepare_insert_vals(b0.size(), 1u64, PDT_CAP_KEEP, &vals) {
        Result::Ok(u) => u,
        Result::Err(_e) => { return false; }
    };
    let mut total: u32 = u0.grow_bytes();
    let mut c: u32 = 1u32;
    while c < slots {
        let b: PdtBuf = pdtbuf_adopt((*a).get::<u8>(c));
        let us: PdtUpdate = match b.prepare_insert(b.size(), 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => { return false; }
        };
        total = total + us.grow_bytes();
        c = c + 1u32;
    }
    return total <= (*a).free_space();
}
