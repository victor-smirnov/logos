// logos.mem.bt.btss — the SINGLE-STREAM leaf substrate (Memoria bt_ss, S2b/B).
//
// The algorithms every Canon-generated single-stream leaf shares, extracted
// from the emitter blobs into ONE set of functions over the leaf's PkdAlloc:
// a leaf is two single-column PdtBufs (slot 0 = MAX-ordered FSE64 keys,
// slot 1 = FSE64 or VLE values; blocks self-describe). The generated node
// keeps only its TYPED surface (K/V casts at the boundary) and its header
// flavor; the algorithm bodies live here exactly once.
//
// SIGN DISCIPLINE: cells are u64 at rest. Functions here are either
// sign-AGNOSTIC (formatting, splitting, counting — byte/row moves) or come in
// signedness variants chosen by the emitter from the key type's verdict.
// Nothing in this module compares keys through a blind u64 cast.
package logos.mem.bt.btss;

use logos.mem.pkd;               // PkdAlloc, SlotKind
use logos.mem.pkd.pdtbuf;        // PdtBuf — the column store
use logos.mem.collections.vec;
use logos.lang.result;
use logos.lang.panic;

/// Format slot `slot` of a leaf as a single-column PdtBuf at the capacity-0
/// geometry, wired to the node allocator (the nested-block discipline).
/// `vle` picks the value shape; `ordered` marks the MAX-measure key column.
pub unsafe fn btss_fmt_slot(a: *mut PkdAlloc, slot: u32, vle: bool, ordered: bool) {
    let mut ord: u32 = PDT_ORD_UNORDERED;
    if ordered {
        ord = PDT_ORD_MAX;
    }
    let mut d: PdtDescr = pdt_descr_new(1u32, ord, false);
    if vle {
        d.dims.push(pdt_dim_vle(1u32));
    } else {
        d.dims.push(pdt_dim_fse(8u32));
    }
    let zero: Vec<u64> = pdt_payload_zero(&d);
    let need: u32 = pdtbuf_compute_block_size(&d, 0u64, &zero);
    let p: *mut u8 = match a.allocate(slot, need, SlotKind::Allocatable) {
        Result::Ok(q) => q,
        Result::Err(_e) => {
            assert(false, "btss: leaf col slot");
            return;
        }
    };
    let bsz: u32 = a.element_size(slot);
    match pdtbuf_format(p, bsz, &d) {
        Result::Ok(_b) => {}
        Result::Err(_e) => {
            assert(false, "btss: leaf col fmt");
        }
    }
    let inner: *mut PkdAlloc = p as *mut PkdAlloc;
    inner.set_allocator(a as *const PkdAlloc);
}

/// Two-phase split of column `slot` at row `at` into the (freshly formatted)
/// right leaf — a VLE column reserves the moving payload bytes through the
/// right side's own nested chain first (the P7 discipline).
pub unsafe fn btss_split_col(a: *mut PkdAlloc, ra: *mut PkdAlloc, slot: u32, at: u32) {
    let mut lb: PdtBuf = pdtbuf_adopt(a.get::<u8>(slot));
    let n: u64 = lb.size();
    let mut rb: PdtBuf = pdtbuf_adopt(ra.get::<u8>(slot));
    if rb.vle_dim_count() > 0u32 {
        let moving: u64 = lb.payload_used(0u32, 0u32)
                        - lb.row_offset(0u32, 0u32, at as u64);
        let mut pay: Vec<u64> = vec_new::<u64>();
        pay.push(moving);
        match rb.reserve_geom(n - (at as u64), &pay) {
            Result::Ok(_u) => {}
            Result::Err(_e) => {
                assert(false, "btss: leaf split reserve");
            }
        }
    } else {
        match rb.reserve(n - (at as u64)) {
            Result::Ok(_u) => {}
            Result::Err(_e) => {
                assert(false, "btss: leaf split reserve");
            }
        }
    }
    let mut lb2: PdtBuf = pdtbuf_adopt(a.get::<u8>(slot));
    let mut rb2: PdtBuf = pdtbuf_adopt(ra.get::<u8>(slot));
    let sp: PdtSplit = match lb2.prepare_split_to(&rb2, at as u64, PDT_CAP_KEEP) {
        Result::Ok(x) => x,
        Result::Err(_e) => {
            assert(false, "btss: leaf split prepare");
            return;
        }
    };
    lb2.commit_split_to(&mut rb2, &sp);
}

/// Entry count of a leaf (its key column's row count).
pub unsafe fn btss_count(a: *mut PkdAlloc) -> u32 {
    return pdtbuf_adopt(a.get::<u8>(0u32)).size() as u32;
}

/// The FSE upsert MECHANICS at a precomputed position: set-on-hit, else the
/// exact two-phase insert of one (key, val) cell pair — both grows priced
/// against the one block before either commits. The caller supplies `pos`
/// and `hit` from its own K-DOMAIN comparison (lower_bound stays with the
/// typed node — signedness lives there, not here).
pub unsafe fn btss_upsert_at(a: *mut PkdAlloc, pos: u32, hit: bool, key: u64, val: u64) -> bool {
    let kcb: PdtBuf = pdtbuf_adopt(a.get::<u8>(0u32));
    let _ = kcb;
    if hit {
        let mut vbs: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
        vbs.set(0u32, pos as u64, val);
        return true;
    }
    // exact two-phase pricing: both grows from the one block
    let dk: u32 = {
        let kb: PdtBuf = pdtbuf_adopt(a.get::<u8>(0u32));
        match kb.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u.grow_bytes(),
            Result::Err(_e) => {
                return false;
            }
        }
    };
    let dv: u32 = {
        let vb0: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
        match vb0.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u.grow_bytes(),
            Result::Err(_e) => {
                return false;
            }
        }
    };
    if dk + dv > a.free_space() {
        return false;
    }
    {
        let kb2: PdtBuf = pdtbuf_adopt(a.get::<u8>(0u32));
        let uk: PdtUpdate = match kb2.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "btss: priced key insert failed");
                return false;
            }
        };
        let mut kb3: PdtBuf = pdtbuf_adopt(a.get::<u8>(0u32));
        let mut kr: Vec<u64> = vec_new::<u64>();
        kr.push(key);
        kb3.commit_insert(&uk, &kr);
    }
    {
        let vb1: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
        let uv: PdtUpdate = match vb1.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "btss: priced val insert failed");
                return false;
            }
        };
        let mut vb2: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
        let mut vr: Vec<u64> = vec_new::<u64>();
        vr.push(val);
        vb2.commit_insert(&uv, &vr);
    }
    return true;
}

/// The VLE upsert MECHANICS at a precomputed position: replace-on-hit (priced
/// on the PRE-remove state — conservative, so the commit after the remove
/// cannot fail into a value-lost partial state), else the exact two-phase
/// (key cell, value span) pair insert. `pos`/`hit` come from the caller's
/// K-domain comparison, the span rides a single-row PdtVals.
pub unsafe fn btss_upsert_vals_at(a: *mut PkdAlloc, pos: u32, hit: bool, key: u64,
                                  pv: &PdtVals) -> bool {
    if hit {
        {
            let vb0: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
            let ui: PdtUpdate = match vb0.prepare_insert_vals(pos as u64, 1u64, PDT_CAP_KEEP, pv) {
                Result::Ok(u) => u,
                Result::Err(_e) => {
                    return false;
                }
            };
            if ui.grow_bytes() > a.free_space() {
                return false;
            }
        }
        {
            let vb1: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
            let ur: PdtUpdate = match vb1.prepare_remove(pos as u64, (pos as u64) + 1u64, PDT_CAP_KEEP) {
                Result::Ok(u) => u,
                Result::Err(_e) => {
                    return false;
                }
            };
            let mut vb2: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
            vb2.commit_remove(&ur);
        }
        {
            let vb3: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
            let ui2: PdtUpdate = match vb3.prepare_insert_vals(pos as u64, 1u64, PDT_CAP_KEEP, pv) {
                Result::Ok(u) => u,
                Result::Err(_e) => {
                    assert(false, "btss: priced VLE replace failed");
                    return false;
                }
            };
            let mut vb4: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
            vb4.commit_insert_vals(&ui2, pv);
        }
        return true;
    }
    // exact two-phase pricing: both grows from the one block
    let dk: u32 = {
        let kb: PdtBuf = pdtbuf_adopt(a.get::<u8>(0u32));
        match kb.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u.grow_bytes(),
            Result::Err(_e) => {
                return false;
            }
        }
    };
    let dv: u32 = {
        let vb5: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
        match vb5.prepare_insert_vals(pos as u64, 1u64, PDT_CAP_KEEP, pv) {
            Result::Ok(u) => u.grow_bytes(),
            Result::Err(_e) => {
                return false;
            }
        }
    };
    if dk + dv > a.free_space() {
        return false;
    }
    {
        let kb2: PdtBuf = pdtbuf_adopt(a.get::<u8>(0u32));
        let uk: PdtUpdate = match kb2.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "btss: priced key insert failed");
                return false;
            }
        };
        let mut kb3: PdtBuf = pdtbuf_adopt(a.get::<u8>(0u32));
        let mut kr: Vec<u64> = vec_new::<u64>();
        kr.push(key);
        kb3.commit_insert(&uk, &kr);
    }
    {
        let vb6: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
        let uv: PdtUpdate = match vb6.prepare_insert_vals(pos as u64, 1u64, PDT_CAP_KEEP, pv) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "btss: priced VLE insert failed");
                return false;
            }
        };
        let mut vb7: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
        vb7.commit_insert_vals(&uv, pv);
    }
    return true;
}

/// The VOLUME-balanced split index: bisect for the row whose cumulative
/// byte weight (8B key cell + value payload) crosses half the total. Pure
/// geometry — sign-free.
pub unsafe fn btss_split_index_volume(a: *mut PkdAlloc) -> u32 {
    let n: u32 = btss_count(a);
    if n <= 1u32 {
        return n;
    }
    let vb8: PdtBuf = pdtbuf_adopt(a.get::<u8>(1u32));
    let total: u32 = n * 8u32 + (vb8.row_offset(0u32, 0u32, n as u64) as u32);
    let half: u32 = total / 2u32;
    let mut lo: u32 = 1u32;
    let mut hi: u32 = n - 1u32;
    let mut at: u32 = 1u32;
    while lo <= hi {
        let mid: u32 = lo + (hi - lo) / 2u32;
        let cv: u32 = mid * 8u32 + (vb8.row_offset(0u32, 0u32, mid as u64) as u32);
        if cv <= half {
            at = mid;
            lo = mid + 1u32;
        } else {
            if mid == 1u32 {
                break;
            }
            hi = mid - 1u32;
        }
    }
    return at;
}
