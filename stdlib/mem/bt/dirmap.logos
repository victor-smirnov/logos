// logos.mem.bt.dirmap — the store DIRECTORY as a CoW container (Memoria's
// `Map<CtrID, BlockID>` allocator directory, self-hosted on the very node
// substrate the user containers run on).
//
// A snapshot's directory is a B-tree keyed by CtrID (u64), whose LEAF VALUES
// are the ROOTS of other containers — reference cells, not plain data. That one
// difference (declared in the node header as `value_ref_slot`) is what makes
// the directory participate in the same CoW + refcount machinery as everything
// else:
//   - fork  = share the directory root (one inc_rc), NOT an O(D) copy;
//   - lookup/update = O(log D) descent / CoW upsert, NOT an O(D) scan;
//   - drop  = ONE `release_block(dir_root)` that cascades to every container
//             root through the leaves' value-ref columns.
//
// BLOCK PLANE: every stored id is turned into a block handle THROUGH the store
// (`st.resolve(id)`, logos.mem.bt.blockptr) — this module never casts an id to
// an address itself. That is what lets the same code run over a disk store,
// where resolve is a cache lookup and disposal returns the page to the pool.
//
// NODE SHAPE (two FSE64 columns over the shared MemNode substrate):
//   LEAF   — slot 0 = keys (MAX-ordered), slot 1 = container-root refs
//            (declared value_ref_slot ⇒ tree_release cascades, cow_clone bumps).
//   BRANCH — slot 0 = separators (MAX = subtree max key), slot 1 = child refs
//            (declared child_slot ⇒ the ordinary structural spine).
//
// REFCOUNT DISCIPLINE (the store drives this; see logos.mem.bt.memstore):
//   - fork SHARES the directory root (one inc_rc); container roots are NOT
//     bumped eagerly. A snapshot acquires its own ownership of a container root
//     LAZILY, when it first PRIVATIZES the leaf that holds it (`dir_privatize`
//     / `dir_leaf_private` inc_rc's every ref on the cloned leaf).
//   - a container mutation goes: `dir_privatize(key)` (clone the path, bump the
//     roots, read the current root) → the container engine mutates + releases
//     the OLD root exactly as it always has (that release is balanced by the
//     privatize bump) → `dir_set(key, new_root)` repoints the slot WITHOUT
//     releasing (the engine already did). So `dir_set` never frees a container
//     root — the engines stay untouched.
//   - a child repoint during either walk releases the old child (its clone
//     bumped it); freeing a directory leaf cascades to its roots (node.logos
//     tree_release, via value_ref_slot).
//
// This split (privatize-then-repoint) is what lets the directory be a real CoW
// container while the container engines keep their flat-store root lifecycle.
package logos.mem.bt.dirmap;

use logos.mem.pkd;               // PkdAlloc — only for the raw region byte-copy
use logos.mem.bt.node;           // node_* header ops
use logos.mem.bt.blockptr;       // MemBlockPtr + trait BlockStore — the block plane
use logos.mem.bt.view;           // NodeView / ColRef — the borrow-checked column skin
use logos.mem.collections.vec;
use logos.lang.mem;              // copy_bytes — the region byte-copy on clone
use logos.lang.panic;

// Column slots (shared leaf/branch layout: key column, then ref column).
pub const DIR_KEY: u32 = 0u32;   // keys (leaf) / separators (branch)
pub const DIR_REF: u32 = 1u32;   // container roots (leaf) / child nodes (branch)
const DIR_NSLOTS: u32 = 2u32;

// Directory node block size. Few slots, small fixed cells (8B key + 8B ref) ⇒ a
// 4K node holds ~250 rows, so thousands of containers fit in a 2-level tree.
const DIR_BLOCK: u32 = 4096u32;

// ── node construction ────────────────────────────────────────────────────────

/// A fresh empty directory LEAF: two FSE64 columns, the ref column declared as
/// the value-ref slot (so a release cascades through it).
fn dir_leaf_new<S: BlockStore>(st: &S) -> MemBlockPtr {
    let b: MemBlockPtr = st.alloc_block(DIR_BLOCK, DIR_NSLOTS);
    let mut nv: NodeView = node_view(b);
    nv.fmt_slot(DIR_KEY, false, true);    // keys: FSE64, MAX-ordered
    nv.fmt_slot(DIR_REF, false, false);   // container roots: FSE64
    b.set_value_ref_slot(DIR_REF);
    b.set_level(0u32);
    return b;
}

/// A fresh empty directory BRANCH at `level`: separators + child refs, the ref
/// column declared as the ordinary child slot.
fn dir_branch_new<S: BlockStore>(st: &S, level: u32) -> MemBlockPtr {
    let b: MemBlockPtr = st.alloc_block(DIR_BLOCK, DIR_NSLOTS);
    let mut nv: NodeView = node_view(b);
    nv.fmt_slot(DIR_KEY, false, true);    // separators: FSE64, MAX-ordered
    nv.fmt_slot(DIR_REF, false, false);   // child nodes: FSE64
    b.set_child_slot(DIR_REF);
    b.set_level(level);
    return b;
}

/// The raw CoW-clone of a node: a fresh block, the column region byte-copied
/// (position-independent by the packed-family CoW-clone-unit law), and the
/// header ref-slot declarations + level carried over. Mirrors pk_private's
/// region copy; rc bumps are added by the leaf/branch privatize wrappers.
unsafe fn dir_clone_node<S: BlockStore>(st: &S, node: MemBlockPtr) -> MemBlockPtr {
    let sa: *mut PkdAlloc = node.pkd();
    let n: MemBlockPtr = st.alloc_block(node.block_size(), node.ncols());
    let da: *mut PkdAlloc = n.pkd();
    copy_bytes(da as *mut u8, sa as *const u8, sa.block_size() as i64);
    n.set_child_slot(node.child_slot());
    n.set_value_ref_slot(node.value_ref_slot());
    n.set_level(node.level());
    return n;
}

/// Make a LEAF privately writable under `cur`. If already private, unchanged;
/// otherwise clone it and inc_rc every container root it references (the clone's
/// value-ref slots each acquire ownership — the frozen original keeps its own).
fn dir_leaf_private<S: BlockStore>(st: &S, node: MemBlockPtr, cur: u64) -> MemBlockPtr {
    if node.snapshot() == cur { return node; }
    let n: MemBlockPtr = unsafe { dir_clone_node::<S>(st, node) };
    let nv: NodeView = node_view(n);
    let vb: ColRef = nv.col(DIR_REF);
    let m: u64 = vb.size();
    let mut j: u64 = 0u64;
    while j < m {
        st.resolve(vb.get(0u32, j)).inc_rc();
        j = j + 1u64;
    }
    return n;
}

/// Make a BRANCH privately writable under `cur`, inc_rc'ing every child (the
/// structural spine share). Mirrors bt_branch_private / pk_private.
fn dir_branch_private<S: BlockStore>(st: &S, node: MemBlockPtr, cur: u64) -> MemBlockPtr {
    if node.snapshot() == cur { return node; }
    let n: MemBlockPtr = unsafe { dir_clone_node::<S>(st, node) };
    let nv: NodeView = node_view(n);
    let cb: ColRef = nv.col(DIR_REF);
    let m: u64 = cb.size();
    let mut j: u64 = 0u64;
    while j < m {
        st.resolve(cb.get(0u32, j)).inc_rc();
        j = j + 1u64;
    }
    return n;
}

// ── column helpers ───────────────────────────────────────────────────────────

fn dir_max_key(nv: &NodeView) -> u64 {
    let kb: ColRef = nv.col(DIR_KEY);
    let n: u64 = kb.size();
    if n == 0u64 { return 0u64; }
    return kb.get(0u32, n - 1u64);
}

/// Which child a branch descends for `key`: the first separator >= key, clamped
/// to the last child when `key` exceeds every separator (MAX-separator routing).
fn dir_find_child(nv: &NodeView, key: u64) -> u32 {
    let n: u32 = nv.count();
    let mut i: u32 = nv.lower_bound_u64(key);
    if i >= n { i = n - 1u32; }
    return i;
}

/// Overwrite an existing FSE64 cell in place (no grow).
fn dir_set_cell(nv: &mut NodeView, slot: u32, pos: u32, v: u64) {
    nv.col_mut(slot).set(0u32, pos as u64, v);
}

/// The child handle at branch row `ci` — resolved THROUGH the store.
fn dir_child_at<S: BlockStore>(st: &S, nv: &NodeView, ci: u64) -> MemBlockPtr {
    return st.resolve(nv.col(DIR_REF).get(0u32, ci));
}

// ── read path ────────────────────────────────────────────────────────────────

/// The container root id mapped to `key`, or 0 if absent. O(log D) descent.
pub fn dir_get<S: BlockStore>(st: &S, root: MemBlockPtr, level: u32, key: u64) -> u64 {
    let mut node: MemBlockPtr = root;
    let mut lvl: u32 = level;
    while lvl > 0u32 {
        let nv: NodeView = node_view(node);
        let ci: u32 = dir_find_child(&nv, key);
        node = dir_child_at::<S>(st, &nv, ci as u64);
        lvl = lvl - 1u32;
    }
    let nv2: NodeView = node_view(node);
    let pos: u32 = nv2.lower_bound_u64(key);
    let kb: ColRef = nv2.col(DIR_KEY);
    if (pos as u64) < kb.size() && kb.get(0u32, pos as u64) == key {
        return nv2.col(DIR_REF).get(0u32, pos as u64);
    }
    return 0u64;
}

pub fn dir_has<S: BlockStore>(st: &S, root: MemBlockPtr, level: u32, key: u64) -> bool {
    return dir_get::<S>(st, root, level, key) != 0u64;
}

/// Collect every CtrID in key order (the container_names walk).
pub fn dir_keys<S: BlockStore>(st: &S, root: MemBlockPtr, level: u32, out: &mut Vec<u64>) {
    let nv: NodeView = node_view(root);
    if level == 0u32 {
        let kb: ColRef = nv.col(DIR_KEY);
        let n: u64 = kb.size();
        let mut i: u64 = 0u64;
        while i < n { out.push(kb.get(0u32, i)); i = i + 1u64; }
        return;
    }
    let n: u64 = nv.col(DIR_REF).size();
    let mut i: u64 = 0u64;
    while i < n {
        dir_keys::<S>(st, dir_child_at::<S>(st, &nv, i), level - 1u32, out);
        i = i + 1u64;
    }
}

/// Number of containers registered (the in-order key count).
pub fn dir_count<S: BlockStore>(st: &S, root: MemBlockPtr, level: u32) -> u64 {
    let nv: NodeView = node_view(root);
    if level == 0u32 {
        return nv.col(DIR_KEY).size();
    }
    let n: u64 = nv.col(DIR_REF).size();
    let mut total: u64 = 0u64;
    let mut i: u64 = 0u64;
    while i < n {
        total = total + dir_count::<S>(st, dir_child_at::<S>(st, &nv, i), level - 1u32);
        i = i + 1u64;
    }
    return total;
}

// ── CoW upsert ───────────────────────────────────────────────────────────────

/// The recursion's report: the (possibly new) node, plus a split's right
/// sibling and the two separators.
struct DirIns {
    node: MemBlockPtr,
    split: bool,
    sep_l: u64,
    sep_r: u64,
    right: MemBlockPtr,
}

/// The upsert's result: the container's (possibly new) directory root + level.
pub struct DirRoot { pub root: MemBlockPtr, pub level: u32 }

// Insert `(key, ref)` into a full leaf by splitting count-balanced; the new row
// lands in whichever half owns `key`.
fn dir_split_leaf<S: BlockStore>(st: &S, work: MemBlockPtr, key: u64,
                                 new_ref: u64) -> DirIns {
    let mut nv: NodeView = node_view(work);
    let right: MemBlockPtr = dir_leaf_new::<S>(st);
    let mut rv: NodeView = node_view(right);
    let at: u32 = nv.count() / 2u32;
    nv.split_col_to(&mut rv, DIR_KEY, at);
    nv.split_col_to(&mut rv, DIR_REF, at);
    if key <= dir_max_key(&nv) {
        let p: u32 = nv.lower_bound_u64(key);
        nv.put_cell(DIR_KEY, p, key);
        nv.put_cell(DIR_REF, p, new_ref);
    } else {
        let p: u32 = rv.lower_bound_u64(key);
        rv.put_cell(DIR_KEY, p, key);
        rv.put_cell(DIR_REF, p, new_ref);
    }
    return DirIns { node: work, split: true, sep_l: dir_max_key(&nv),
                    sep_r: dir_max_key(&rv), right: right };
}

fn dir_set_rec<S: BlockStore>(st: &S, node: MemBlockPtr, level: u32, key: u64,
                              new_ref: u64, cur: u64) -> DirIns {
    if level == 0u32 {
        let work: MemBlockPtr = dir_leaf_private::<S>(st, node, cur);
        let mut nv: NodeView = node_view(work);
        let pos: u32 = nv.lower_bound_u64(key);
        let cnt: u32 = nv.col(DIR_KEY).size() as u32;
        // the key-column read ENDS here: what follows may resize the region,
        // and the checker would reject holding the view across it.
        let mut hit: bool = false;
        if pos < cnt { hit = nv.col(DIR_KEY).get(0u32, pos as u64) == key; }
        if hit {
            // OVERWRITE (repoint): store the new root; DO NOT release the old
            // one — the container engine already released it (the flat-store
            // lifecycle), and the per-snapshot ownership was bumped at
            // dir_privatize. dir_set never frees a container root.
            dir_set_cell(&mut nv, DIR_REF, pos, new_ref);
            return DirIns { node: work, split: false, sep_l: dir_max_key(&nv),
                            sep_r: 0u64, right: block_null() };
        }
        // INSERT a new container.
        if nv.fits_row(DIR_NSLOTS) {
            nv.put_cell(DIR_KEY, pos, key);
            nv.put_cell(DIR_REF, pos, new_ref);
            return DirIns { node: work, split: false, sep_l: dir_max_key(&nv),
                            sep_r: 0u64, right: block_null() };
        }
        return dir_split_leaf::<S>(st, work, key, new_ref);
    }
    // BRANCH.
    let work: MemBlockPtr = dir_branch_private::<S>(st, node, cur);
    let mut nv: NodeView = node_view(work);
    let ci: u32 = dir_find_child(&nv, key);
    let old_child: MemBlockPtr = dir_child_at::<S>(st, &nv, ci as u64);
    let r: DirIns = dir_set_rec::<S>(st, old_child, level - 1u32, key, new_ref, cur);
    dir_set_cell(&mut nv, DIR_KEY, ci, r.sep_l);      // child's max may have grown
    if r.node.id() != old_child.id() {
        dir_set_cell(&mut nv, DIR_REF, ci, r.node.id());  // repoint to the private child
        st.release_block(old_child, level - 1u32);    // release the old child (clone bumped it)
    }
    if !r.split {
        return DirIns { node: work, split: false, sep_l: dir_max_key(&nv),
                        sep_r: 0u64, right: block_null() };
    }
    // Graft the new right child at ci+1.
    if nv.fits_row(DIR_NSLOTS) {
        nv.put_cell(DIR_KEY, ci + 1u32, r.sep_r);
        nv.put_cell(DIR_REF, ci + 1u32, r.right.id());
        return DirIns { node: work, split: false, sep_l: dir_max_key(&nv),
                        sep_r: 0u64, right: block_null() };
    }
    // Branch full → split, then insert (sep_r, right) into the owning half.
    let rb: MemBlockPtr = dir_branch_new::<S>(st, level);
    let mut rbv: NodeView = node_view(rb);
    let at: u32 = nv.count() / 2u32;
    nv.split_col_to(&mut rbv, DIR_KEY, at);
    nv.split_col_to(&mut rbv, DIR_REF, at);
    let lc: u32 = nv.count();
    if ci + 1u32 < lc {
        nv.put_cell(DIR_KEY, ci + 1u32, r.sep_r);
        nv.put_cell(DIR_REF, ci + 1u32, r.right.id());
    } else {
        rbv.put_cell(DIR_KEY, (ci + 1u32) - lc, r.sep_r);
        rbv.put_cell(DIR_REF, (ci + 1u32) - lc, r.right.id());
    }
    return DirIns { node: work, split: true, sep_l: dir_max_key(&nv),
                    sep_r: dir_max_key(&rbv), right: rb };
}

/// A fresh empty directory root (level 0). The store mints one per snapshot
/// history root; forks share it.
pub fn dir_new<S: BlockStore>(st: &S) -> DirRoot {
    return DirRoot { root: dir_leaf_new::<S>(st), level: 0u32 };
}

/// The privatize step of a container mutation: CoW-clone the path down to
/// `key`'s leaf (acquiring this snapshot's ownership — each cloned leaf inc_rc's
/// its container roots), and return the (possibly new) directory root/level plus
/// the container root currently mapped to `key` (0 if absent). The store calls
/// this BEFORE running the container engine, so the engine's own release of the
/// old root is balanced by the ownership acquired here.
pub struct DirPriv { pub root: MemBlockPtr, pub level: u32, pub val: u64 }

struct DirPrivRec { node: MemBlockPtr, val: u64 }

fn dir_privatize_rec<S: BlockStore>(st: &S, node: MemBlockPtr, level: u32,
                                    key: u64, cur: u64) -> DirPrivRec {
    if level == 0u32 {
        let work: MemBlockPtr = dir_leaf_private::<S>(st, node, cur);
        let nv: NodeView = node_view(work);
        let pos: u32 = nv.lower_bound_u64(key);
        let kb: ColRef = nv.col(DIR_KEY);
        let mut v: u64 = 0u64;
        if (pos as u64) < kb.size() && kb.get(0u32, pos as u64) == key {
            v = nv.col(DIR_REF).get(0u32, pos as u64);
        }
        return DirPrivRec { node: work, val: v };
    }
    let work: MemBlockPtr = dir_branch_private::<S>(st, node, cur);
    let mut nv: NodeView = node_view(work);
    let ci: u32 = dir_find_child(&nv, key);
    let old_child: MemBlockPtr = dir_child_at::<S>(st, &nv, ci as u64);
    let r: DirPrivRec = dir_privatize_rec::<S>(st, old_child, level - 1u32, key, cur);
    if r.node.id() != old_child.id() {
        dir_set_cell(&mut nv, DIR_REF, ci, r.node.id());
        st.release_block(old_child, level - 1u32);   // clone bumped it; release the old child
    }
    return DirPrivRec { node: work, val: r.val };
}

pub fn dir_privatize<S: BlockStore>(st: &S, root: MemBlockPtr, level: u32,
                                    key: u64, cur: u64) -> DirPriv {
    let r: DirPrivRec = dir_privatize_rec::<S>(st, root, level, key, cur);
    let mut nrt: MemBlockPtr = root;
    if r.node.id() != root.id() {
        nrt = r.node;
        st.release_block(root, level);
    }
    return DirPriv { root: nrt, level: level, val: r.val };
}

/// CoW-upsert `key → new_ref`. Returns the (possibly new) directory root/level.
/// The old directory root is released iff its identity changed (mirrors
/// bt_cow_insert's root repoint); on a root split it is grafted under a fresh
/// top. A displaced CONTAINER root is never freed here (see the rc discipline).
pub fn dir_set<S: BlockStore>(st: &S, root: MemBlockPtr, level: u32, key: u64,
                              new_ref: u64, cur: u64) -> DirRoot {
    let r: DirIns = dir_set_rec::<S>(st, root, level, key, new_ref, cur);
    let mut nrt: MemBlockPtr = r.node;
    let mut nlv: u32 = level;
    if r.node.id() != root.id() {
        st.release_block(root, level);
    }
    if r.split {
        let top: MemBlockPtr = dir_branch_new::<S>(st, level + 1u32);
        let mut tv: NodeView = node_view(top);
        tv.put_cell(DIR_KEY, 0u32, r.sep_l);
        tv.put_cell(DIR_REF, 0u32, r.node.id());
        tv.put_cell(DIR_KEY, 1u32, r.sep_r);
        tv.put_cell(DIR_REF, 1u32, r.right.id());
        nrt = top;
        nlv = level + 1u32;
    }
    return DirRoot { root: nrt, level: nlv };
}
