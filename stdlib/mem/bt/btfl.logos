// logos.mem.bt.btfl — the N-DataStream FREE-LAYOUT B+tree PROTOTYPE (Memoria
// bt_fl): `DataStreams` typed columns + a STRUCTURE stream that orders them
// relative to each other. This file is the PROTOTYPE only — generic ordered-bt
// mechanics over N streams (seek / select / rank / access / insert-entry /
// split / bulk / the key_stream projection). It carries NO container-level
// value semantics: the Multimap container (K → value sequences) is a THIN
// layer on top — the Canon-generated family, and, in tests, `btfl_key_stream`
// (find) + `btfl_insert_n` (insert). Just as in Memoria, multimap is bt_fl's
// only client today; bt_fl stays the reusable substrate (vector-of-structs,
// queue, table-rows sit on the same prototype without multimap baggage).
//
// LOGICAL MODEL: records of N streams ordered relative to each other. Stream 0
// is the ORDERED navigation key (MAX measure in branches — the B+tree key);
// streams 1..N-1 are unordered data. For each key in key order: one symbol-0
// entry followed by its associated per-stream runs. The layout is carried by a
// SYMBOL SEQUENCE (alphabet = N, SSRLE) kept as the LAST stream of every leaf;
// branch nodes carry per-symbol subtree counts + the stream-0 max-key measure.
// A cut at any structure position projects into each stream via rank_eq — THE
// rank projection is the whole trick.
//
// C++ ORACLE SITES MIRRORED (~/cxx/memoria/containers/include/memoria/...):
//   * structure stream = SSRLE over DataStreams symbols, kept as a dedicated
//     stream: prototypes/bt_fl/btfl_tools.hpp:28 (StructureStreamTF =
//     PkdSSRLESeqT<DataStreams, 256, true>); multimap stream list (keys,
//     values, structure LAST): containers/multimap/multimap_factory.hpp:143-172.
//   * branch columns for the structure stream = AlphabetSize SUM columns:
//     core/packed/sseq/packed_ssrle_seq.hpp:452-462 (PackedStructTraits:
//     Indexes = AlphabetSize, KeySearchType = SUM) routed through
//     containers/multimap/multimap_tools.hpp:64-77 (SUM/Indexes → sum
//     buffer); keys column → MAX measure (multimap_tools.hpp:37, :79-84);
//     values column → UNORDERED → NO branch column (multimap_tools.hpp:49-62).
//     Here: BtflBranch = MAXKEY (MAX) + CNT0/CNT1 (the two SUM columns; for
//     2 data streams the per-stream StreamSize sums coincide with them).
//   * select descent (the shuttle contract): bt/shuttles/
//     bt_select_shuttle.hpp:71-90 — each BRANCH runs find_for_select_fw over
//     the per-symbol sum tree with the rank remainder, accumulating the
//     skipped rank; :106-137 — the LEAF finishes with seq.select_fw. Here:
//     btfl_select walks CNT<sym> the same way and finishes with
//     PkdSsrle::select_fw_eq. (select_fw_eq_nlt degenerates to select_fw_eq
//     for sym = 0 at alphabet 2 — nothing is smaller than 0.)
//   * rank-projection of a symbol position into per-stream positions (the
//     multistream Position): containers/multimap/
//     multimap_keys_chunk_impl.hpp:312-319 — iter_leafrank() = {keys_pos,
//     rank_eq(sym_idx, 1), sym_idx}; inserts happen at that Position:
//     prototypes/bt_fl/container/btfl_c_insert.hpp:54-56.
//   * leaf split = split every substream at its projected position:
//     bt/container/bt_cw_leaf_common.hpp:41-57 (ctr_split_leaf dispatches
//     split_to(Position) over the node). Here: btfl_leaf_split picks the
//     key-aligned symbol position p = select_fw_eq(kmid, 0), projects
//     (kmid, rank_eq(p, 1), p) and splits keys / vals / symbol stream there
//     — the rank-projection IS the multistream split.
//   * key → values navigation: containers/multimap/
//     multimap_keys_chunk_impl.hpp:241-267 (values_chunk: key's symbol
//     position via select_fw_eq(idx, 0); span bounded by the NEXT symbol-0
//     position; first value = rank_eq(sym_idx + 1, 1) — the projection into
//     the values stream). Here: btfl_key_stream (find).
//
// V0 RESTRICTIONS (lifted by 8a2/8b):
//   * splits are KEY-ALIGNED (the split position is a key's symbol position)
//     ⇒ every leaf starts with a symbol-0 entry and a key's values never
//     straddle leaves. Spanning value runs (and the keyless leaves they
//     imply — C++ handles those via the OPTIONAL max buffer,
//     multimap_tools.hpp:82) arrive with the 8a2 batch input provider.
//   * one entry (key + its values) must fit a leaf after a split — asserted.
//   * inserting an EXISTING key is rejected (returns false); append/upsert
//     of values is 8a2 surface.
//   * bulk build / remove (btfl_c_leaf_common.hpp:43 ctr_remove_range) /
//     node merge / CoW insert are NOT in 8a.
//
// SUBSTRATE: memstore node blocks (logos.mem.bt.node / memstore) — the
// branch keeps child refs in slot 1 as a single-column PdtBuf, so
// the container-agnostic tree_release frees any btfl tree from (root, level).
// The leaf's symbol stream is a NESTED PkdSsrle block inside the leaf's
// PkdAlloc (Allocatable slot, back-ref healed on sibling shifts; growth
// through the parent chain) — the C++ nested-PackedAllocator discipline.
//
// POINTER DISCIPLINE (the VecCtr idiom): packed payloads shift when sibling
// slots resize — every PdtBuf / PkdSsrle view is re-resolved from the
// node's PkdAlloc AT THE POINT OF USE, never cached across a mutation.
package logos.mem.bt.btfl;

use logos.mem.pkd.ssrle;         // the run codec/algebra (SsrleRun, ssrle_runs_from_symbols)
use logos.mem.pkd.sseq;          // PkdSsrle — the packed symbol sequence
use logos.mem.pkd;               // PkdAlloc, SlotKind, PkdError
use logos.mem.pkd.pdtbuf;        // PdtBuf — the branch measure/count store (P7.3)
use logos.mem.bt.node;           // node_alloc / node_pkd (via snapshot) — node blocks
use logos.mem.bt.memstore;       // MemorySnapshot (allocation capability), tree_release
use logos.mem.bt.ops;            // BtInsRet / bt_ins_rec — THE bottom-up insert skeleton
use logos.mem.bt.map;            // BtBranch — the N-ary branch contract
use logos.mem.bt.node;           // NodeProfile — the node-form seam (Btfl<N, P>)
use logos.lang.panic;
use logos.std.io;
use logos.mem.string;
use logos.lang.result;
use logos.mem.collections.vec;

// ── node geometry ───────────────────────────────────────────────────────────
//
// 8a2.1: the NODE layer (leaf/branch creation, branch columns, summaries,
// splits, check) is generic over `const N: u32` — the stream count, a DESIGN
// constant of the container family. Leaf slots: stream s lives in slot s
// (0..N-1, single-column PdtBufs), the SSRLE symbol stream (alphabet = N)
// is the LAST slot, N. The FAMILY layer below (the 2-stream multimap: entry
// construction, key→values navigation, seek's stream-0 choice, the stage) is
// exercised at N=2 and instantiates the node layer with the literal `::<2>`
// (a package const cannot yet ride a const-generic argument — recorded in the
// const-array-length overhaul arc).

// The 2-stream multimap family's stream indices (slots 0/1; syms at slot 2=N).
const LF_KEYS: u32 = 0u32;
const LF_VALS: u32 = 1u32;
const LF_SYMS: u32 = 2u32;
const LF_SLOTS: u32 = 3u32;

// Branch slots: the max-key measure, then the per-symbol SUM columns
// CONTIGUOUSLY (so a symbol indexes them directly), then the child refs. The
// count columns are no longer split around a reserved slot 2: the child slot
// is declared in the node header, so this layout is the container's own.
// P7.3: the measure/count columns live in ONE nested PdtBuf (slot 0) —
// column 0 = MAXKEY, column 1+sym = CNT<sym> — with the recursive SUM index,
// so branch inserts get the same two-phase prepare/commit and exact pricing
// as leaves, seek's rank prefix and select's descent become index lookups,
// and widening the alphabet is a descr change, not a slot-layout change.
// Child refs are a single-column FSE64 PdtBuf in slot 1 (the declared child slot).
const BR_PDT:   u32 = 0u32;
const BR_CHILD: u32 = 1u32;
const BR_SLOTS: u32 = 2u32;
const BRC_MAX:  u32 = 0u32;   // PdtBuf column: max-key measure
const BRC_CNT0: u32 = 1u32;   // PdtBuf column: first per-symbol count

const BTFL_ALPHABET: u32 = 2u32;

// ── typed slot views (re-resolved per call; never cached) ───────────────────

// Stream s's data column — a SINGLE-COLUMN PdtBuf (8a2.3): the stream's kind
// (FSE cell width / VLE) is the column's DESCRIPTOR, stored in the block
// (self-describing — adopt needs no shape argument), and every mutation gets
// the two-phase prepare/commit with EXACT pricing. The slot index is the
// stream index (runtime; the stream COUNT is the const N).
unsafe fn lf_pdt(a: *mut PkdAlloc, s: u32) -> PdtBuf {
    return pdtbuf_adopt(a.get::<u8>(s));
}

// Stream KIND CODES (8a2.3): the per-stream entry kind, a DESIGN CONSTANT of
// the container family. 0 = FSE 8-byte cells (the u64 families); 1 = VLE byte
// spans. Stream 0 is always the ordered (MAX-measure) FSE stream — seek
// descends it; the rest are unordered (multimap_tools.hpp:37/:49). No leaf
// index — leaves answer by scan/binary search.
pub const BTFL_KIND_FSE64: u64 = 0u64;
pub const BTFL_KIND_VLE:   u64 = 1u64;

fn btfl_stream_descr(s: u32, code: u64) -> PdtDescr {
    if s == 0u32 {
        return pdt_descr_fse(1u32, 8u32, PDT_ORD_MAX, false);
    }
    if code == BTFL_KIND_VLE {
        let mut d: PdtDescr = pdt_descr_new(1u32, PDT_ORD_UNORDERED, false);
        d.dims.push(pdt_dim_vle(1u32));
        return d;
    }
    return pdt_descr_fse(1u32, 8u32, PDT_ORD_UNORDERED, false);
}

fn btfl_stream_descr_fse64(s: u32) -> PdtDescr {
    return btfl_stream_descr(s, BTFL_KIND_FSE64);
}

// Format leaf slot `s` as a stream column with descriptor `d` (Allocatable,
// wired to the node's allocator — the nested-block discipline).
unsafe fn btfl_leaf_format_slot(a: *mut PkdAlloc, s: u32, d: &PdtDescr) {
    // The capacity-0 GEOMETRY price, not the bare header: formatting a VLE
    // column also lands its offsets cell (offsets[0] = 0 must exist), which
    // pdtbuf_empty_size does not carry. compute_block_size(descr, 0, zero) is
    // byte-for-byte what pdtbuf_format allocates (its own contract).
    let zero: Vec<u64> = pdt_payload_zero(d);
    let dneed: u32 = pdtbuf_compute_block_size(d, 0u64, &zero);
    let dp: *mut u8 = match a.allocate(s, dneed, SlotKind::Allocatable) {
        Result::Ok(q) => q,
        Result::Err(_e) => {
            assert(false, "btfl: leaf stream slot allocation failed");
            return;
        }
    };
    let dbsz: u32 = a.element_size(s);
    match pdtbuf_format(dp, dbsz, d) {
        Result::Ok(_b) => {}
        Result::Err(_e) => {
            assert(false, "btfl: leaf stream column format failed");
        }
    }
    let dinner: *mut PkdAlloc = dp as *mut PkdAlloc;
    dinner.set_allocator(a as *const PkdAlloc);
}

// The symbol stream lives in slot N — the one geometry fact that needs the
// stream count at the type level.
unsafe fn lf_seq_n<const N: u32>(a: *mut PkdAlloc) -> PkdSsrle {
    return pkd_ssrle_adopt(a.get::<u8>(N));
}

unsafe fn lf_seq(a: *mut PkdAlloc) -> PkdSsrle {
    return pkd_ssrle_adopt(a.get::<u8>(LF_SYMS));
}

// The branch's measure/count store — re-resolved per call, never cached
// (the VecCtr idiom: the nested block moves when sibling slots resize).
unsafe fn br_pdt(a: *mut PkdAlloc) -> PdtBuf {
    return pdtbuf_adopt(a.get::<u8>(BR_PDT));
}

// The child-ref column — a single-column FSE64 PdtBuf like every other
// column (the PkdArray retirement): the uniform release contract reads it
// the same way (memstore tree_release adopts the declared child slot).
unsafe fn br_child(a: *mut PkdAlloc) -> PdtBuf {
    return pdtbuf_adopt(a.get::<u8>(BR_CHILD));
}

// The branch descriptor: MAXKEY + one SUM column per symbol, FSE u64 cells,
// SUM-indexed (the C++ PackedStructTraits Indexes=AlphabetSize, SUM).
// Widening the alphabet is exactly this — a descriptor change.
fn btfl_branch_descr<const N: u32>() -> PdtDescr {
    return pdt_descr_fse(1u32 + N, 8u32, PDT_ORD_SUM, true);
}

// Lower bound over the MAXKEY column — the shared pdtbuf helper (values are
// non-decreasing across children, so the binary search is exact).
unsafe fn pdt_lower_bound_max(b: &PdtBuf, key: u64) -> u32 {
    return pdt_lower_bound_u64(b, BRC_MAX, key);
}

// ── node creation ───────────────────────────────────────────────────────────

/// Fresh empty leaf: keys/vals columns + the nested SSRLE symbol stream.
/// The symbol slot is stamped ALLOCATABLE (its payload STARTS with the inner
/// PkdAlloc's PkdAllocatable back-ref, healed when earlier slots shift) and
/// wired to the leaf's allocator, so the sequence grows through the parent
/// chain exactly like the C++ nested PackedAllocator.
fn btfl_leaf_new<const N: u32, P: NodeProfile>(snap: &MemorySnapshot, leaf_bytes: u32) -> *mut u8 {
    unsafe {
        let node: *mut u8 = P::alloc(leaf_bytes, N + 1u32, snap.snapshot_id());
        let a: *mut PkdAlloc = P::pkd(node);
        let mut s: u32 = 0u32;
        while s < N {
            let d: PdtDescr = btfl_stream_descr_fse64(s);
            btfl_leaf_format_slot(a, s, &d);
            s = s + 1u32;
        }
        let need: u32 = pkd_ssrle_empty_size();
        let p: *mut u8 = match a.allocate(N, need, SlotKind::Allocatable) {
            Result::Ok(q) => q,
            Result::Err(_e) => {
                assert(false, "btfl: leaf syms slot allocation failed");
                return node;
            }
        };
        let bsz: u32 = a.element_size(N);
        match pkd_ssrle_format(p, bsz, N) {
            Result::Ok(_s) => {}
            Result::Err(_e) => {
                assert(false, "btfl: leaf syms format failed");
            }
        }
        let inner: *mut PkdAlloc = p as *mut PkdAlloc;
        inner.set_allocator(a as *const PkdAlloc);
        return node;
    }
}

// Fresh empty leaf with per-stream KIND CODES (stream 0 is always FSE64-MAX;
// codes[s-1] shapes stream s). The codes are the family's design constants —
// they exist only at creation; thereafter every block SELF-DESCRIBES.
fn btfl_leaf_new_shaped<const N: u32, P: NodeProfile>(snap: &MemorySnapshot, leaf_bytes: u32,
                                      codes: &Vec<u64>) -> *mut u8 {
    unsafe {
        let node: *mut u8 = P::alloc(leaf_bytes, N + 1u32, snap.snapshot_id());
        let a: *mut PkdAlloc = P::pkd(node);
        let mut s: u32 = 0u32;
        while s < N {
            let mut code: u64 = BTFL_KIND_FSE64;
            if s > 0u32 {
                code = codes.get((s - 1u32) as i64);
            }
            let d: PdtDescr = btfl_stream_descr(s, code);
            btfl_leaf_format_slot(a, s, &d);
            s = s + 1u32;
        }
        let need: u32 = pkd_ssrle_empty_size();
        let p: *mut u8 = match a.allocate(N, need, SlotKind::Allocatable) {
            Result::Ok(q) => q,
            Result::Err(_e) => {
                assert(false, "btfl: leaf syms slot allocation failed");
                return node;
            }
        };
        let bsz: u32 = a.element_size(N);
        match pkd_ssrle_format(p, bsz, N) {
            Result::Ok(_s) => {}
            Result::Err(_e) => {
                assert(false, "btfl: leaf syms format failed");
            }
        }
        let inner: *mut PkdAlloc = p as *mut PkdAlloc;
        inner.set_allocator(a as *const PkdAlloc);
        return node;
    }
}

// Fresh empty leaf SHAPED LIKE `like` — each stream column's descriptor is
// read from the existing node (blocks self-describe), so a split sibling
// inherits the family's kinds with no shape threading.
fn btfl_leaf_new_like<const N: u32, P: NodeProfile>(snp: u64, leaf_bytes: u32,
                                    like: *mut u8) -> *mut u8 {
    unsafe {
        let node: *mut u8 = P::alloc(leaf_bytes, N + 1u32, snp);
        let a: *mut PkdAlloc = P::pkd(node);
        let la: *mut PkdAlloc = P::pkd(like);
        let mut s: u32 = 0u32;
        while s < N {
            let d: PdtDescr = lf_pdt(la, s).descr();
            btfl_leaf_format_slot(a, s, &d);
            s = s + 1u32;
        }
        let need: u32 = pkd_ssrle_empty_size();
        let p: *mut u8 = match a.allocate(N, need, SlotKind::Allocatable) {
            Result::Ok(q) => q,
            Result::Err(_e) => {
                assert(false, "btfl: leaf syms slot allocation failed");
                return node;
            }
        };
        let bsz: u32 = a.element_size(N);
        match pkd_ssrle_format(p, bsz, N) {
            Result::Ok(_s) => {}
            Result::Err(_e) => {
                assert(false, "btfl: leaf syms format failed");
            }
        }
        let inner: *mut PkdAlloc = p as *mut PkdAlloc;
        inner.set_allocator(a as *const PkdAlloc);
        return node;
    }
}

/// Fresh empty branch: the nested PdtBuf (measure/count columns) + the child
/// ref column. The PdtBuf block is wired to the node's allocator so its
/// growth rides the parent chain — the same nested-block discipline as the
/// leaf's SSRLE stream.
fn btfl_branch_new<const N: u32, P: NodeProfile>(snap: &MemorySnapshot, branch_bytes: u32) -> *mut u8 {
    return btfl_branch_new_raw::<N, P>(snap.snapshot_id(), branch_bytes);
}

fn btfl_branch_new_raw<const N: u32, P: NodeProfile>(snp: u64, branch_bytes: u32) -> *mut u8 {
    unsafe {
        let node: *mut u8 = P::alloc(branch_bytes, BR_SLOTS, snp);
        P::set_child_slot(node, BR_CHILD);
        let a: *mut PkdAlloc = P::pkd(node);
        let d: PdtDescr = btfl_branch_descr::<N>();
        let need: u32 = pdtbuf_empty_size(&d);
        let p: *mut u8 = match a.allocate(BR_PDT, need, SlotKind::Allocatable) {
            Result::Ok(q) => q,
            Result::Err(_e) => {
                assert(false, "btfl: branch pdt slot allocation failed");
                return node;
            }
        };
        let bsz: u32 = a.element_size(BR_PDT);
        match pdtbuf_format(p, bsz, &d) {
            Result::Ok(_b) => {}
            Result::Err(_e) => {
                assert(false, "btfl: branch pdt format failed");
            }
        }
        let inner: *mut PkdAlloc = p as *mut PkdAlloc;
        inner.set_allocator(a as *const PkdAlloc);
        let cd: PdtDescr = pdt_descr_fse(1u32, 8u32, PDT_ORD_UNORDERED, false);
        btfl_leaf_format_slot(a, BR_CHILD, &cd);
        return node;
    }
}

// ── the tree handle ─────────────────────────────────────────────────────────

/// A btfl multistream tree: (root, level) + the node sizing the tree was
/// created with (splits allocate siblings of the same size). level 0 = root is
/// a leaf. N — the stream count, the family's DESIGN CONSTANT (8a2).
pub struct Btfl<const N: u32, P: NodeProfile> {
    pub root: *mut u8,
    pub level: u32,
    pub leaf_bytes: u32,
    pub branch_bytes: u32,
}

/// Creates an empty N-stream tree (a single empty leaf). Call sites spell the
/// stream count: `btfl_create::<2, P>(…)` (const-generic N is not inferable from
/// the value arguments).
pub fn btfl_create<const N: u32, P: NodeProfile>(snap: &MemorySnapshot, leaf_bytes: u32, branch_bytes: u32) -> Btfl<N, P> {
    let root: *mut u8 = btfl_leaf_new::<N, P>(snap, leaf_bytes);
    return Btfl::<N, P> {
        root: root,
        level: 0u32,
        leaf_bytes: leaf_bytes,
        branch_bytes: branch_bytes,
    };
}

/// Creates an empty N-stream tree with per-stream KIND CODES (stream 0 is
/// always the FSE64 ordered stream; `codes[s-1]` shapes stream s —
/// BTFL_KIND_FSE64 or BTFL_KIND_VLE).
pub fn btfl_create_shaped<const N: u32, P: NodeProfile>(snap: &MemorySnapshot, leaf_bytes: u32,
                                        branch_bytes: u32, codes: &Vec<u64>) -> Btfl<N, P> {
    let root: *mut u8 = btfl_leaf_new_shaped::<N, P>(snap, leaf_bytes, codes);
    return Btfl::<N, P> {
        root: root,
        level: 0u32,
        leaf_bytes: leaf_bytes,
        branch_bytes: branch_bytes,
    };
}

/// Releases the tree (rc-aware recursive release; branch child refs ride the
/// uniform slot 2, so the container-agnostic memstore walk applies).
pub fn btfl_drop<const N: u32, P: NodeProfile>(t: &Btfl<N, P>) {
    unsafe {
        tree_release(t.root, t.level);
    }
}

// ── per-symbol totals ───────────────────────────────────────────────────────

/// Total entries of stream `sym`. Branch root answers from the SUM columns;
/// leaf root from the sequence.
pub fn btfl_count<const N: u32, P: NodeProfile>(t: &Btfl<N, P>, sym: u64) -> u64 {
    unsafe {
        let a: *mut PkdAlloc = P::pkd(t.root);
        if t.level == 0u32 {
            return lf_seq_n::<N>(a).rank_eq_all(sym);
        }
        // The SUM index answers the root total directly.
        return br_pdt(a).sum_all(BRC_CNT0 + (sym as u32));
    }
}

// ── select descent (the shuttle contract) ───────────────────────────────────

/// Where a select landed: the leaf, the LOCAL symbol index in its sequence,
/// and the GLOBAL symbol position (prefix of skipped subtrees + local).
/// Not found ⇒ found = false, pos = total symbol count.
pub struct BtflLoc {
    pub found: bool,
    pub leaf: *mut u8,
    pub idx: u64,
    pub pos: u64,
}

/// Position of the (rank+1)-th `sym` entry — the SelectForwardShuttle walk
/// (bt_select_shuttle.hpp:71-90 branch step, :106-137 leaf finish): each
/// branch consumes the rank remainder against its per-symbol count column
/// and the leaf finishes with select_fw_eq.
pub fn btfl_select<const N: u32, P: NodeProfile>(t: &Btfl<N, P>, sym: u64, rank: u64) -> BtflLoc {
    unsafe {
        let mut node: *mut u8 = t.root;
        let mut lvl: u32 = t.level;
        let mut rem: u64 = rank;
        let mut prefix: u64 = 0u64;
        while lvl > 0u32 {
            let a: *mut PkdAlloc = P::pkd(node);
            let b: PdtBuf = br_pdt(a);
            // The C++ find_for_select_fw step, verbatim on the SUM index:
            // find_gt(rem) names the child whose count column crosses the
            // remainder and hands back the prefix consumed before it.
            let f: PdtFind = b.find_gt(BRC_CNT0 + (sym as u32), rem);
            if f.idx >= b.size() {
                let mut tot: u64 = prefix;
                let mut tsym: u32 = 0u32;
                while tsym < N {
                    tot = tot + b.sum_all(BRC_CNT0 + tsym);
                    tsym = tsym + 1u32;
                }
                return BtflLoc {
                    found: false,
                    leaf: node,
                    idx: 0u64,
                    pos: tot,
                };
            }
            rem = rem - f.prefix;
            let mut csym: u32 = 0u32;
            while csym < N {
                prefix = prefix + b.sum(BRC_CNT0 + csym, 0u64, f.idx);
                csym = csym + 1u32;
            }
            node = br_child(a).get(0u32, f.idx) as *mut u8;
            lvl = lvl - 1u32;
        }
        let a: *mut PkdAlloc = P::pkd(node);
        let seq: PkdSsrle = lf_seq_n::<N>(a);
        let res: SsrleSelect = seq.select_fw_eq(rem, sym);
        if res.idx >= seq.size() {
            return BtflLoc {
                found: false,
                leaf: node,
                idx: res.idx,
                pos: prefix + res.idx,
            };
        }
        return BtflLoc {
            found: true,
            leaf: node,
            idx: res.idx,
            pos: prefix + res.idx,
        };
    }
}

/// Symbol at GLOBAL position `pos` — descent by the summed count columns,
/// finished with the sequence access.
pub fn btfl_access<const N: u32, P: NodeProfile>(t: &Btfl<N, P>, pos: u64) -> u64 {
    unsafe {
        let mut node: *mut u8 = t.root;
        let mut lvl: u32 = t.level;
        let mut rem: u64 = pos;
        while lvl > 0u32 {
            let a: *mut PkdAlloc = P::pkd(node);
            let b: PdtBuf = br_pdt(a);
            let n: u64 = b.size();
            let mut i: u64 = 0u64;
            let mut descending: bool = false;
            while !descending && i < n {
                let mut v: u64 = 0u64;
                let mut csym: u32 = 0u32;
                while csym < N {
                    v = v + b.get(BRC_CNT0 + csym, i);
                    csym = csym + 1u32;
                }
                if rem < v {
                    descending = true;
                } else {
                    rem = rem - v;
                    i = i + 1u64;
                }
            }
            assert(descending, "btfl_access: position beyond the tree");
            node = br_child(a).get(0u32, i) as *mut u8;
            lvl = lvl - 1u32;
        }
        return lf_seq_n::<N>(P::pkd(node)).access(rem);
    }
}

// ── seek descent (max-key measure) ──────────────────────────────────────────

/// Where a key seek landed: hit flag, the key's GLOBAL stream-0 rank (= its
/// index in key order; for a miss, the rank the key WOULD take), the leaf and
/// the LOCAL key index (lower bound) within it.
pub struct BtflSeek {
    pub found: bool,
    pub rank: u64,
    pub leaf: *mut u8,
    pub kidx: u32,
}

// Child to descend into for `key`: lower bound over the max-key measure,
// clamped to the last child (the FindShuttle convention).
unsafe fn btfl_find_child(a: *mut PkdAlloc, key: u64) -> u32 {
    let b: PdtBuf = br_pdt(a);
    let n: u32 = b.size() as u32;
    let mut c: u32 = pdt_lower_bound_max(&b, key);
    if c >= n {
        c = n - 1u32;
    }
    return c;
}

/// Descend to `key`'s leaf position by the stream-0 max-key measure,
/// accumulating the global key rank from the CNT0 column prefixes.
pub fn btfl_seek<const N: u32, P: NodeProfile>(t: &Btfl<N, P>, key: u64) -> BtflSeek {
    unsafe {
        let mut node: *mut u8 = t.root;
        let mut lvl: u32 = t.level;
        let mut rank: u64 = 0u64;
        while lvl > 0u32 {
            let a: *mut PkdAlloc = P::pkd(node);
            let ci: u32 = btfl_find_child(a, key);
            // The key-rank prefix is one SUM-index lookup, not a scan.
            rank = rank + br_pdt(a).sum(BRC_CNT0, 0u64, ci as u64);
            node = br_child(a).get(0u32, ci as u64) as *mut u8;
            lvl = lvl - 1u32;
        }
        let a: *mut PkdAlloc = P::pkd(node);
        let kb: PdtBuf = lf_pdt(a, 0u32);
        let kc: u32 = kb.size() as u32;
        let i0: u32 = pdt_lower_bound_max(&kb, key);
        let mut hit: bool = false;
        if i0 < kc {
            if kb.get(0u32, i0 as u64) == key {
                hit = true;
            }
        }
        return BtflSeek {
            found: hit,
            rank: rank + (i0 as u64),
            leaf: node,
            kidx: i0,
        };
    }
}

// ── key → values navigation ─────────────────────────────────────────────────

/// LOCAL symbol position of the leaf's `kidx`-th key (test/introspection
/// surface; the multimap_keys_chunk select_fw_eq(idx, 0) step).
pub fn btfl_leaf_key_sympos<const N: u32, P: NodeProfile>(leaf: *mut u8, kidx: u32) -> u64 {
    unsafe {
        let seq: PkdSsrle = lf_seq_n::<N>(P::pkd(leaf));
        let res: SsrleSelect = seq.select_fw_eq(kidx as u64, 0u64);
        assert(res.idx < seq.size(), "btfl: key index beyond the leaf structure");
        return res.idx;
    }
}

pub fn btfl_leaf_key_count<P: NodeProfile>(leaf: *mut u8) -> u32 {
    unsafe {
        return lf_pdt(P::pkd(leaf), 0u32).size() as u32;
    }
}

pub fn btfl_leaf_key_at<P: NodeProfile>(leaf: *mut u8, i: u32) -> u64 {
    unsafe {
        return lf_pdt(P::pkd(leaf), 0u32).get(0u32, i as u64);
    }
}

/// Row count of stream `s` in a leaf (test/introspection surface).
pub fn btfl_leaf_stream_count<const N: u32, P: NodeProfile>(leaf: *mut u8, s: u32) -> u32 {
    unsafe {
        return lf_pdt(P::pkd(leaf), s).size() as u32;
    }
}

/// Stream `s`'s `i`-th row in a leaf (test/introspection surface).
pub fn btfl_leaf_stream_at<const N: u32, P: NodeProfile>(leaf: *mut u8, s: u32, i: u32) -> u64 {
    unsafe {
        return lf_pdt(P::pkd(leaf), s).get(0u32, i as u64);
    }
}

/// A VLE stream row's span length in a leaf (test/introspection surface).
pub fn btfl_leaf_stream_span_len<const N: u32, P: NodeProfile>(leaf: *mut u8, s: u32, row: u64) -> u64 {
    unsafe {
        return lf_pdt(P::pkd(leaf), s).row_len(0u32, 0u32, row);
    }
}

/// Byte `i` of a VLE stream row's span (test/introspection surface).
pub fn btfl_leaf_stream_span_at<const N: u32, P: NodeProfile>(leaf: *mut u8, s: u32, row: u64, i: u64) -> u8 {
    unsafe {
        let b: PdtBuf = lf_pdt(P::pkd(leaf), s);
        let sp: &[u8] = b.row_span(0u32, 0u32, row);
        return sp[i as i64];
    }
}

/// rank_eq over the leaf's symbol stream: `sym` entries before local position
/// `upto` — the rank projection exposed for the gate's inverse laws.
pub fn btfl_leaf_rank<const N: u32, P: NodeProfile>(leaf: *mut u8, upto: u64, sym: u64) -> u64 {
    unsafe {
        return lf_seq_n::<N>(P::pkd(leaf)).rank_eq(upto, sym);
    }
}

/// Looks `key` up and appends its value sequence to `out`. The
/// multimap_keys_chunk_impl.hpp:241-267 navigation: the key's symbol
/// position p via select_fw_eq(kidx, 0); the values are the symbol-1 run
/// (p, next symbol-0 position); the first value's index in the values
/// stream = rank_eq(p + 1, 1) — the rank-projection. Under the v0
/// key-aligned-split invariant the whole run lives in the key's leaf.
// Append the run of FSE stream `stream` associated with the entry keyed `key`
// (`key`'s symbol-0 structure slot, projected into `stream` via rank). A pure
// bt_fl PROTOTYPE op — generic over N and the stream index; the multimap
// container's `find(k)` is exactly this with stream = 1. (For a VLE stream use
// the span introspection instead — this yields u64 cells.)
pub fn btfl_key_stream<const N: u32, P: NodeProfile>(t: &Btfl<N, P>, key: u64, stream: u32, out: &mut Vec<u64>) -> bool {
    let sk: BtflSeek = btfl_seek::<N, P>(t, key);
    if !sk.found {
        return false;
    }
    unsafe {
        let a: *mut PkdAlloc = P::pkd(sk.leaf);
        let seq: PkdSsrle = lf_seq_n::<N>(a);
        let kc: u32 = lf_pdt(a, 0u32).size() as u32;
        let p: u64 = seq.select_fw_eq(sk.kidx as u64, 0u64).idx;
        let mut end: u64 = seq.size();
        if sk.kidx + 1u32 < kc {
            end = seq.select_fw_eq((sk.kidx as u64) + 1u64, 0u64).idx;
        }
        // rank projection: `stream`'s first entry of the run, and its count in
        // the run (the general form — counts only `stream`, for any N).
        let v0: u64 = seq.rank_eq(p + 1u64, stream as u64);
        let cnt: u64 = seq.rank_eq(end, stream as u64) - v0;
        let vb: PdtBuf = lf_pdt(a, stream);
        let mut j: u64 = 0u64;
        while j < cnt {
            out.push(vb.get(0u32, v0 + j));
            j = j + 1u64;
        }
        return true;
    }
}

// ── hierarchical entry seek (the stream-size feature, BTFL semantics) ───────
//
// A BTFL container is a NESTING tree marked by its symbol sequence: symbol 0
// = the top level after the root (multimap keys), symbol s+1 = the children
// of the preceding symbol-s entry. Seek is therefore TWO operations, not one:
// `ctr.seek(n)` finds the n-th symbol-0 entry (a KEY cursor), and
// `key_cur.seek(m)` finds the m-th entry of ITS run in the next stream (a
// VALUE cursor) — a RELATIVE address resolved inside the key's leaf. The
// branch descent rides the same per-symbol CNT columns every insert has
// maintained since S2b (one SUM-index find_gt per level, the C++
// find_for_select_fw step); the relative half is leaf-local under the v0
// key-aligned-split invariant — the cheap case the C++ shuttles optimize for
// (small m ⇒ the walk never leaves the node it started in).

/// A key cursor: the n-th symbol-0 entry — its leaf and LOCAL key index.
/// `found = false` ⇔ n >= the key count (kidx then = the local key count).
pub struct BtflEntryCur {
    pub found: bool,
    pub leaf: *mut u8,
    pub kidx: u32,
}

/// A value cursor: the m-th next-stream entry of one key's run — the leaf
/// and the LOCAL row index in that value stream's column.
pub struct BtflValCur {
    pub found: bool,
    pub leaf: *mut u8,
    pub vidx: u32,
}

/// `ctr.seek(n)`: cursor at the n-th KEY (symbol-0 entry) in symbol order.
pub fn btfl_seek_nth<const N: u32, P: NodeProfile>(t: &Btfl<N, P>, n: u64) -> BtflEntryCur {
    unsafe {
        let mut node: *mut u8 = t.root;
        let mut lvl: u32 = t.level;
        let mut rem: u64 = n;
        while lvl > 0u32 {
            let a: *mut PkdAlloc = P::pkd(node);
            let b: PdtBuf = br_pdt(a);
            // One SUM-index step: the child whose CNT0 column crosses the
            // remainder, and the prefix consumed before it.
            let f: PdtFind = b.find_gt(BRC_CNT0, rem);
            if f.idx >= b.size() {
                // n beyond the tree: land past-the-end of the LAST leaf.
                let last: u32 = (b.size() as u32) - 1u32;
                rem = b.get(BRC_CNT0, last as u64);
                node = br_child(a).get(0u32, last as u64) as *mut u8;
            } else {
                rem = rem - f.prefix;
                node = br_child(a).get(0u32, f.idx) as *mut u8;
            }
            lvl = lvl - 1u32;
        }
        let kc: u64 = lf_pdt(P::pkd(node), 0u32).size();
        if rem >= kc {
            return BtflEntryCur { found: false, leaf: node, kidx: kc as u32 };
        }
        return BtflEntryCur { found: true, leaf: node, kidx: rem as u32 };
    }
}

/// Row count of stream `s` under the key at `(leaf, kidx)` — the size of the
/// key's run projected into that stream (rank difference over the run's
/// symbol span; multimap value count for s = 1).
pub fn btfl_entry_stream_count<const N: u32, P: NodeProfile>(leaf: *mut u8, kidx: u32, s: u32) -> u64 {
    unsafe {
        let a: *mut PkdAlloc = P::pkd(leaf);
        let seq: PkdSsrle = lf_seq_n::<N>(a);
        let kc: u32 = lf_pdt(a, 0u32).size() as u32;
        let p: u64 = seq.select_fw_eq(kidx as u64, 0u64).idx;
        let mut end: u64 = seq.size();
        if kidx + 1u32 < kc {
            end = seq.select_fw_eq((kidx as u64) + 1u64, 0u64).idx;
        }
        return seq.rank_eq(end, s as u64) - seq.rank_eq(p + 1u64, s as u64);
    }
}

/// `key_cur.seek(m)`: cursor at the m-th stream-`s` entry of the key at
/// `(leaf, kidx)` — the RELATIVE seek. Leaf-local: the run's first stream-`s`
/// row is the rank projection of the key's symbol position; the m-th is m
/// rows after it (the v0 key-aligned-split invariant keeps the whole run in
/// the key's leaf).
pub fn btfl_entry_seek<const N: u32, P: NodeProfile>(leaf: *mut u8, kidx: u32, s: u32, m: u64) -> BtflValCur {
    unsafe {
        let a: *mut PkdAlloc = P::pkd(leaf);
        let seq: PkdSsrle = lf_seq_n::<N>(a);
        let v0: u64 = seq.rank_eq(seq.select_fw_eq(kidx as u64, 0u64).idx + 1u64, s as u64);
        let cnt: u64 = btfl_entry_stream_count::<N, P>(leaf, kidx, s);
        if m >= cnt {
            return BtflValCur { found: false, leaf: leaf, vidx: (v0 + cnt) as u32 };
        }
        return BtflValCur { found: true, leaf: leaf, vidx: (v0 + m) as u32 };
    }
}

// ── insert ──────────────────────────────────────────────────────────────────

// The insert reports ride the SHARED BtInsRet<u64, N> (logos.mem.bt.ops) —
// the btfl-private BtflInsRet died with the skeleton unification (S2b/A2):
// per-symbol counts are the report's [u64; N] sides, `ok` carries the
// duplicate-reject.

// Leaf summary (stream-0 count >= 1 required — callers only summarize
// non-empty leaves). A leaf's per-symbol counts ARE its per-stream row counts.
unsafe fn leaf_summary<const N: u32, P: NodeProfile>(node: *mut u8, split: bool, rnode: *mut u8) -> BtInsRet<u64, N> {
    let a: *mut PkdAlloc = P::pkd(node);
    let ka: PdtBuf = lf_pdt(a, 0u32);
    let kc: u64 = ka.size();
    let lmax: u64 = ka.get(0u32, kc - 1u64);
    let mut ret: BtInsRet<u64, N> = BtInsRet::<u64, N> {
        ok: true,
        addr: node,
        lsep: lmax,
        lcnt: [0u64; N],
        split: split,
        rsep: 0u64,
        rcnt: [0u64; N],
        rptr: rnode,
    };
    let mut s: u32 = 0u32;
    while s < N {
        ret.lcnt[s as i64] = lf_pdt(a, s).size();
        s = s + 1u32;
    }
    if split {
        let ra: *mut PkdAlloc = P::pkd(rnode);
        let rka: PdtBuf = lf_pdt(ra, 0u32);
        let rkc: u64 = rka.size();
        ret.rsep = rka.get(0u32, rkc - 1u64);
        let mut rs: u32 = 0u32;
        while rs < N {
            ret.rcnt[rs as i64] = lf_pdt(ra, rs).size();
            rs = rs + 1u32;
        }
    }
    return ret;
}

fn ret_reject<const N: u32>(node: *mut u8) -> BtInsRet<u64, N> {
    return BtInsRet::<u64, N> {
        ok: false,
        addr: node,
        lsep: 0u64,
        lcnt: [0u64; N],
        split: false,
        rsep: 0u64,
        rcnt: [0u64; N],
        rptr: node,
    };
}

// Copy spans [lo, lo+m) out of an entry carrier into a fresh single-stream
// PdtVals (the per-VLE-stream sub-carrier a column's prepare/commit takes).
fn btfl_vals_slice(spans: &PdtVals, lo: u64, m: u64) -> PdtVals {
    let mut v: PdtVals = pdt_vals_new();
    let mut off: i64 = spans.span_offset(lo as i64);
    let mut k: u64 = 0u64;
    while k < m {
        let l: u64 = spans.lens.get((lo + k) as i64);
        v.lens.push(l);
        let mut i: i64 = 0i64;
        while i < (l as i64) {
            v.bytes.push(spans.bytes.get(off + i));
            i = i + 1i64;
        }
        off = off + (l as i64);
        k = k + 1u64;
    }
    return v;
}

// Try to place one ENTRY into the leaf at stream-0 slot i0 — the two-phase
// discipline generalized to N streams (8a2.2) and to PdtBuf stream columns
// (8a2.3): one stream-0 row (`key`) plus, for each stream s in 1..N,
// `lens[s-1]` rows taken FLAT from `flat` in stream order. Position: the rank
// projection of the key's symbol position — stream s inserts at rank_eq(p, s).
// PRICING IS EXACT: each stream is priced by the same two-phase prepare that
// will commit it (grow_bytes rides the parent chain — the P7 branch law,
// brought down to the leaf; no estimate formula, no cell-width assumption),
// plus the symbol stream's plan. Commits are per-stream re-prepared (sibling
// slots shift as earlier streams grow; the geometry answer is identical).
// Returns false (leaf untouched) when the total does not fit.
unsafe fn btfl_leaf_try_insert_n<const N: u32, P: NodeProfile>(node: *mut u8, i0: u32, key: u64,
                                               flat: &Vec<u64>, lens: &Vec<u64>,
                                               spans: &PdtVals) -> bool {
    let a: *mut PkdAlloc = P::pkd(node);
    let kc: u32 = lf_pdt(a, 0u32).size() as u32;
    let seq: PkdSsrle = lf_seq_n::<N>(a);
    // the rank-projected insert Position
    let mut p: u64 = seq.size();
    if i0 < kc {
        let res: SsrleSelect = seq.select_fw_eq(i0 as u64, 0u64);
        p = res.idx;
    }
    // the inserted structure run: one stream-0 symbol + lens[s-1] of stream s
    let mut syms: Vec<u64> = vec_new::<u64>();
    syms.push(0u64);
    let mut s: u32 = 1u32;
    while s < N {
        let m: u64 = lens.get((s - 1u32) as i64);
        let mut j: u64 = 0u64;
        while j < m {
            syms.push(s as u64);
            j = j + 1u64;
        }
        s = s + 1u32;
    }
    let runs: Vec<SsrleRun> = ssrle_runs_from_symbols(seq.bps(), &syms);
    let us: SsrleUpdate = seq.plan_insert(p, &runs);
    // exact pricing
    let mut delta: u32 = 0u32;
    {
        let kb: PdtBuf = lf_pdt(a, 0u32);
        let us0: PdtUpdate = match kb.prepare_insert(i0 as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                return false;
            }
        };
        delta = delta + us0.grow_bytes();
    }
    let mut s2: u32 = 1u32;
    let mut price_vbase: u64 = 0u64;
    while s2 < N {
        let m2: u64 = lens.get((s2 - 1u32) as i64);
        let sb: PdtBuf = lf_pdt(a, s2);
        let is_vle: bool = sb.vle_dim_count() > 0u32;
        if m2 > 0u64 {
            let v0: u64 = lf_seq_n::<N>(a).rank_eq(p, s2 as u64);
            if is_vle {
                // VLE: geometry-aware prepare over this stream's span slice.
                let sv: PdtVals = btfl_vals_slice(spans, price_vbase, m2);
                let sb2: PdtBuf = lf_pdt(a, s2);
                let uss: PdtUpdate = match sb2.prepare_insert_vals(v0, m2, PDT_CAP_KEEP, &sv) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        return false;
                    }
                };
                delta = delta + uss.grow_bytes();
            } else {
                let uss: PdtUpdate = match sb.prepare_insert(v0, m2, PDT_CAP_KEEP) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        return false;
                    }
                };
                delta = delta + uss.grow_bytes();
            }
        }
        if is_vle {
            price_vbase = price_vbase + m2;
        }
        s2 = s2 + 1u32;
    }
    let syms_cur: u32 = a.element_size(N);
    if us.block_size > syms_cur {
        delta = delta + (us.block_size - syms_cur);
    }
    if delta > a.free_space() {
        return false;
    }
    // commit — priced above, so every grow is guaranteed
    {
        let kb2: PdtBuf = lf_pdt(a, 0u32);
        let usk: PdtUpdate = match kb2.prepare_insert(i0 as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "btfl: priced stream-0 prepare failed");
                return false;
            }
        };
        let mut kb3: PdtBuf = lf_pdt(a, 0u32);
        let mut krow: Vec<u64> = vec_new::<u64>();
        krow.push(key);
        kb3.commit_insert(&usk, &krow);
    }
    let mut off: u64 = 0u64;
    let mut vbase: u64 = 0u64;
    let mut s3: u32 = 1u32;
    while s3 < N {
        let m3: u64 = lens.get((s3 - 1u32) as i64);
        let cvle: bool = lf_pdt(a, s3).vle_dim_count() > 0u32;
        if m3 > 0u64 {
            // stream s3's insert position = the rank projection. The symbol
            // stream is untouched until the final commit, so the rank is
            // stable; every view is re-resolved (sibling slots shifted).
            let v0b: u64 = lf_seq_n::<N>(a).rank_eq(p, s3 as u64);
            if cvle {
                let sv: PdtVals = btfl_vals_slice(spans, vbase, m3);
                let sb2: PdtBuf = lf_pdt(a, s3);
                let uss2: PdtUpdate = match sb2.prepare_insert_vals(v0b, m3, PDT_CAP_KEEP, &sv) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "btfl: priced VLE stream prepare failed");
                        return false;
                    }
                };
                let mut sb3: PdtBuf = lf_pdt(a, s3);
                sb3.commit_insert_vals(&uss2, &sv);
            } else {
                let sb2: PdtBuf = lf_pdt(a, s3);
                let uss2: PdtUpdate = match sb2.prepare_insert(v0b, m3, PDT_CAP_KEEP) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "btfl: priced stream prepare failed");
                        return false;
                    }
                };
                let mut cells: Vec<u64> = vec_new::<u64>();
                let mut k: u64 = 0u64;
                while k < m3 {
                    cells.push(flat.get((off + k) as i64));
                    k = k + 1u64;
                }
                let mut sb3: PdtBuf = lf_pdt(a, s3);
                sb3.commit_insert(&uss2, &cells);
            }
        }
        if cvle {
            vbase = vbase + m3;
        } else {
            off = off + m3;
        }
        s3 = s3 + 1u32;
    }
    // the symbol slot shifted while the data streams grew — re-resolve, commit
    let mut seq2: PkdSsrle = lf_seq_n::<N>(a);
    seq2.commit(&us);
    return true;
}

// Split `node` at the KEY-ALIGNED symbol position of its middle stream-0
// entry and move the upper part into (empty, freshly formatted) `right`. THE
// RANK PROJECTION IS THE MULTISTREAM SPLIT: the cut position p projects into
// EVERY stream as rank_eq(p, s), and each stream column splits there via its
// own two-phase prepare_split_to/commit_split_to (the P7 branch discipline —
// the right side's capacity reserved through ITS OWN nested chain); the
// symbol stream splits at p itself, last.
unsafe fn btfl_leaf_split_n<const N: u32, P: NodeProfile>(node: *mut u8, right: *mut u8) {
    let a: *mut PkdAlloc = P::pkd(node);
    let ra: *mut PkdAlloc = P::pkd(right);
    let kc: u32 = lf_pdt(a, 0u32).size() as u32;
    let kmid: u32 = kc / 2u32;
    let seq: PkdSsrle = lf_seq_n::<N>(a);
    let p: u64 = seq.select_fw_eq(kmid as u64, 0u64).idx;
    let mut s: u32 = 0u32;
    while s < N {
        // stream 0 cuts at kmid (= rank_eq(p, 0) by construction); the rest at
        // their projections. Rank over the still-unsplit symbol stream.
        let mut r: u64 = kmid as u64;
        if s > 0u32 {
            r = lf_seq_n::<N>(a).rank_eq(p, s as u64);
        }
        let mut lb: PdtBuf = lf_pdt(a, s);
        let n_s: u64 = lb.size();
        let mut rb: PdtBuf = lf_pdt(ra, s);
        if rb.vle_dim_count() > 0u32 {
            // VLE: the right side must reserve the PAYLOAD BYTES of the rows
            // that move — the geometry rides the rank-projected cut exactly
            // like the row count does.
            let moving: u64 = lb.payload_used(0u32, 0u32) - lb.row_offset(0u32, 0u32, r);
            let mut pay: Vec<u64> = vec_new::<u64>();
            pay.push(moving);
            match rb.reserve_geom(n_s - r, &pay) {
                Result::Ok(_u) => {}
                Result::Err(_e) => {
                    assert(false, "btfl: right leaf VLE stream reserve failed");
                }
            }
        } else {
            match rb.reserve(n_s - r) {
                Result::Ok(_u) => {}
                Result::Err(_e) => {
                    assert(false, "btfl: right leaf stream reserve failed");
                }
            }
        }
        let mut lb2: PdtBuf = lf_pdt(a, s);
        let mut rb2: PdtBuf = lf_pdt(ra, s);
        let sp: PdtSplit = match lb2.prepare_split_to(&rb2, r, PDT_CAP_KEEP) {
            Result::Ok(x) => x,
            Result::Err(_e) => {
                assert(false, "btfl: leaf stream split prepare failed");
                return;
            }
        };
        lb2.commit_split_to(&mut rb2, &sp);
        s = s + 1u32;
    }
    // both symbol slots shifted (left: shrunk siblings; right: grown) —
    // re-resolve handles and split the structure stream at p
    let mut sl: PkdSsrle = lf_seq_n::<N>(a);
    let mut sr: PkdSsrle = lf_seq_n::<N>(ra);
    match sl.split_to(&mut sr, p) {
        Result::Ok(_u) => {}
        Result::Err(_e) => {
            assert(false, "btfl: structure stream split failed");
        }
    }
}

// Leaf-level insert: duplicate check, try-in-place, else key-aligned split +
// retry into the owning half (the bt_ins leaf step).
unsafe fn btfl_leaf_ins_n<const N: u32, P: NodeProfile>(snp: u64, leaf_bytes: u32, node: *mut u8,
                                        key: u64, flat: &Vec<u64>, lens: &Vec<u64>,
                                        spans: &PdtVals) -> BtInsRet<u64, N> {
    let a: *mut PkdAlloc = P::pkd(node);
    let kb: PdtBuf = lf_pdt(a, 0u32);
    let kc: u32 = kb.size() as u32;
    let i0: u32 = pdt_lower_bound_max(&kb, key);
    if i0 < kc {
        if kb.get(0u32, i0 as u64) == key {
            return ret_reject::<N>(node);
        }
    }
    if btfl_leaf_try_insert_n::<N, P>(node, i0, key, flat, lens, spans) {
        return leaf_summary::<N, P>(node, false, node);
    }
    assert(kc >= 2u32, "btfl v0: entry exceeds leaf capacity (spanning inserts land later in 8a2)");
    let right: *mut u8 = btfl_leaf_new_like::<N, P>(snp, leaf_bytes, node);
    btfl_leaf_split_n::<N, P>(node, right);
    let la: *mut PkdAlloc = P::pkd(node);
    let lk: PdtBuf = lf_pdt(la, 0u32);
    let lmax: u64 = lk.get(0u32, lk.size() - 1u64);
    let mut tgt: *mut u8 = right;
    if key <= lmax {
        tgt = node;
    }
    let ta: *mut PkdAlloc = P::pkd(tgt);
    let tkb: PdtBuf = lf_pdt(ta, 0u32);
    let ti: u32 = pdt_lower_bound_max(&tkb, key);
    let ok: bool = btfl_leaf_try_insert_n::<N, P>(tgt, ti, key, flat, lens, spans);
    assert(ok, "btfl v0: entry does not fit a half leaf (spanning inserts land later in 8a2)");
    return leaf_summary::<N, P>(node, true, right);
}

// One more (max, counts…, child) column row fits without a split?
unsafe fn btfl_branch_fits_one(a: *mut PkdAlloc) -> bool {
    // The pdt half is PRICED by the same two-phase prepare that will commit
    // it — not estimated by a parallel formula that can drift (the leaf's
    // exact-prepare law, now at branch level).
    let b: PdtBuf = br_pdt(a);
    let us: PdtUpdate = match b.prepare_insert(b.size(), 1u64, PDT_CAP_KEEP) {
        Result::Ok(u) => u,
        Result::Err(_e) => {
            return false;
        }
    };
    // grow_bytes is what commit will take FROM THE PARENT via the nested
    // chain (update_fits==true means the growth is possible, not absent) —
    // so it is priced unconditionally. The child half is priced the SAME
    // exact way — the last estimate died with PkdArray.
    let mut delta: u32 = us.grow_bytes();
    let ch: PdtBuf = br_child(a);
    let uc: PdtUpdate = match ch.prepare_insert(ch.size(), 1u64, PDT_CAP_KEEP) {
        Result::Ok(u) => u,
        Result::Err(_e) => {
            return false;
        }
    };
    delta = delta + uc.grow_bytes();
    return delta <= a.free_space();
}

// Insert a child row at `pos` (priced by the caller via btfl_branch_fits_one
// or a fresh half-branch's slack).
unsafe fn btfl_branch_insert_child<const N: u32>(a: *mut PkdAlloc, pos: u32,
                                                 maxk: u64, cnt: &[u64; N],
                                                 child: u64) {
    {
        let b: PdtBuf = br_pdt(a);
        let us: PdtUpdate = match b.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "btfl: branch pdt prepare failed");
                return;
            }
        };
        // commit_insert grows the nested block itself through the node's
        // allocator (the SSRLE discipline) — no manual resize, no re-resolve
        // hazard; the caller has already priced grow_bytes.
        let mut b2: PdtBuf = br_pdt(a);
        let mut row: Vec<u64> = vec_new::<u64>();
        row.push(maxk);
        let mut sym: u32 = 0u32;
        while sym < N {
            row.push(cnt[sym as i64]);
            sym = sym + 1u32;
        }
        b2.commit_insert(&us, &row);
    }
    {
        let cb: PdtBuf = br_child(a);
        let uc: PdtUpdate = match cb.prepare_insert(pos as u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "btfl: branch child prepare failed");
                return;
            }
        };
        let mut cb2: PdtBuf = br_child(a);
        let mut crow: Vec<u64> = vec_new::<u64>();
        crow.push(child);
        cb2.commit_insert(&uc, &crow);
    }
}

// Split `node`'s child rows at the midpoint into fresh `right`.
unsafe fn btfl_branch_split<P: NodeProfile>(node: *mut u8, right: *mut u8) {
    let a: *mut PkdAlloc = P::pkd(node);
    let ra: *mut PkdAlloc = P::pkd(right);
    let mut lb: PdtBuf = br_pdt(a);
    let n: u32 = lb.size() as u32;
    let mid: u32 = n / 2u32;
    // Reserve the right side's capacity through ITS OWN nested chain (a slot
    // resize would grow the slot but not the PdtBuf's notion of its block).
    let mut rb: PdtBuf = br_pdt(ra);
    match rb.reserve((n - mid) as u64) {
        Result::Ok(_u) => {}
        Result::Err(_e) => {
            assert(false, "btfl: right branch pdt reserve failed");
        }
    }
    let sp: PdtSplit = match lb.prepare_split_to(&rb, mid as u64, PDT_CAP_KEEP) {
        Result::Ok(x) => x,
        Result::Err(_e) => {
            assert(false, "btfl: branch pdt split prepare failed");
            return;
        }
    };
    lb.commit_split_to(&mut rb, &sp);
    {
        let mut lc: PdtBuf = br_child(a);
        let cn: u64 = lc.size();
        let mut rc: PdtBuf = br_child(ra);
        match rc.reserve(cn - (mid as u64)) {
            Result::Ok(_u) => {}
            Result::Err(_e) => {
                assert(false, "btfl: right branch child reserve failed");
            }
        }
        let mut lc2: PdtBuf = br_child(a);
        let mut rc2: PdtBuf = br_child(ra);
        let cp: PdtSplit = match lc2.prepare_split_to(&rc2, mid as u64, PDT_CAP_KEEP) {
            Result::Ok(x) => x,
            Result::Err(_e) => {
                assert(false, "btfl: branch child split prepare failed");
                return;
            }
        };
        lc2.commit_split_to(&mut rc2, &cp);
    }
}

// ── the multistream leaf STEP + branch wrapper (S2b/A2) ─────────────────────
//
// The bottom-up recursion itself lives ONCE in logos.mem.bt.ops::bt_ins_rec;
// btfl contributes exactly what differs — the LEAF STEP (duplicate-reject +
// rank-projected multistream insert + key-aligned split) and the BRANCH
// CONTRACT implementation over its own node form (the MAXKEY + per-symbol
// SUM columns + child column).

/// The N-stream entry carrier the step threads through the skeleton — raw
/// pointers on purpose (a Copy POD; the referents outlive the synchronous
/// insert).
pub struct BtflEntry {
    pub flat: *const Vec<u64>,
    pub lens: *const Vec<u64>,
    pub spans: *const PdtVals,
}

impl Copy for BtflEntry {}

/// The bt_fl leaf step: reject a duplicate key, else place the entry at its
/// rank projection (splitting key-aligned when full).
pub fn btfl_step<const N: u32, P: NodeProfile>(node: *mut u8, key: u64, e: BtflEntry, snp: u64) -> BtInsRet<u64, N> {
    unsafe {
        return btfl_leaf_ins_n::<N, P>(snp, P::block_size(node), node, key,
                                       &*e.flat, &*e.lens, &*e.spans);
    }
}

/// The bt_fl branch as a BtBranch<u64, N> — a thin typed view over the node
/// block (the PROTOTYPE's branch: MAXKEY measure + N SUM columns in one
/// nested PdtBuf, child refs in their declared slot).
pub struct BtflBranchRef<const N: u32, P: NodeProfile> {
    pub mem: *mut u8,
}

impl<const N: u32, P: NodeProfile> BtBranch<u64, N> for BtflBranchRef<N, P> {
    fn adopt(mem: *mut u8) -> BtflBranchRef<N, P> {
        return BtflBranchRef::<N, P> { mem: mem };
    }
    fn new_sibling(self: &BtflBranchRef<N, P>, snp: u64) -> BtflBranchRef<N, P> {
        let b: *mut u8 = btfl_branch_new_raw::<N, P>(snp, P::block_size(self.mem));
        return BtflBranchRef::<N, P> { mem: b };
    }
    fn block(self: &BtflBranchRef<N, P>) -> *mut u8 { return self.mem; }
    fn child_count(self: &BtflBranchRef<N, P>) -> u32 {
        unsafe { return br_pdt(P::pkd(self.mem)).size() as u32; }
    }
    fn sep_at(self: &BtflBranchRef<N, P>, i: u32) -> u64 {
        unsafe { return br_pdt(P::pkd(self.mem)).get(BRC_MAX, i as u64); }
    }
    fn child_addr(self: &BtflBranchRef<N, P>, i: u32) -> *mut u8 {
        unsafe { return br_child(P::pkd(self.mem)).get(0u32, i as u64) as *mut u8; }
    }
    fn set_child_addr(self: &mut BtflBranchRef<N, P>, i: u32, ptr: *mut u8) {
        unsafe {
            let mut cb: PdtBuf = br_child(P::pkd(self.mem));
            let mut row: Vec<u64> = vec_new::<u64>();
            row.push(ptr as u64);
            cb.set_row(i as u64, &row);
        }
    }
    fn max_sep(self: &BtflBranchRef<N, P>) -> u64 {
        return self.sep_at(self.child_count() - 1u32);
    }
    fn total_size(self: &BtflBranchRef<N, P>) -> u64 {
        unsafe { return br_pdt(P::pkd(self.mem)).sum_all(BRC_CNT0); }
    }
    fn totals(self: &BtflBranchRef<N, P>, out: &mut [u64; N]) {
        unsafe {
            let b: PdtBuf = br_pdt(P::pkd(self.mem));
            let mut sym: u32 = 0u32;
            while sym < N {
                out[sym as i64] = b.sum_all(BRC_CNT0 + sym);
                sym = sym + 1u32;
            }
        }
    }
    fn count_at(self: &BtflBranchRef<N, P>, i: u32, s: u32) -> u64 {
        unsafe { return br_pdt(P::pkd(self.mem)).get(BRC_CNT0 + s, i as u64); }
    }
    fn find_child(self: &BtflBranchRef<N, P>, key: u64) -> u32 {
        unsafe { return btfl_find_child(P::pkd(self.mem), key); }
    }
    fn push_row(self: &mut BtflBranchRef<N, P>, sep: u64, cnt: &[u64; N], ptr: *mut u8) {
        unsafe {
            let cc: u32 = self.child_count();
            btfl_branch_insert_child::<N>(P::pkd(self.mem), cc, sep, cnt, ptr as u64);
        }
    }
    fn insert_row(self: &mut BtflBranchRef<N, P>, pos: u32, sep: u64, cnt: &[u64; N], ptr: *mut u8) {
        unsafe { btfl_branch_insert_child::<N>(P::pkd(self.mem), pos, sep, cnt, ptr as u64); }
    }
    fn update_row(self: &mut BtflBranchRef<N, P>, i: u32, sep: u64, cnt: &[u64; N]) {
        unsafe {
            let mut ub: PdtBuf = br_pdt(P::pkd(self.mem));
            let mut row: Vec<u64> = vec_new::<u64>();
            row.push(sep);
            let mut sym: u32 = 0u32;
            while sym < N {
                row.push(cnt[sym as i64]);
                sym = sym + 1u32;
            }
            ub.set_row(i as u64, &row);
            ub.reindex();
        }
    }
    fn can_insert_child(self: &BtflBranchRef<N, P>) -> bool {
        unsafe { return btfl_branch_fits_one(P::pkd(self.mem)); }
    }
    fn split_into(self: &mut BtflBranchRef<N, P>, dst: &mut BtflBranchRef<N, P>) -> u64 {
        unsafe { btfl_branch_split::<P>(self.mem, dst.mem); }
        return self.max_sep();
    }
    fn cow_clone(self: &BtflBranchRef<N, P>, snp: u64) -> BtflBranchRef<N, P> {
        // btfl CoW-INSERT is 8b scope (v0 restriction block at the top of the
        // file) — the plain skeleton never calls this.
        assert(false, "btfl branch cow_clone: CoW insert lands with 8b");
        return BtflBranchRef::<N, P> { mem: self.mem };
    }
    fn free_block(self: BtflBranchRef<N, P>) {
        P::free(self.mem);
    }
}

/// Inserts one N-stream ENTRY: a stream-0 row (`key`, in key order) followed
/// by `lens[s-1]` rows of each stream s (taken flat from `flat`, stream-major).
/// Returns false iff the key already exists. Splits propagate bottom-up (the
/// SHARED bt_ins_rec skeleton — S2b/A2); a root split grows the tree by one
/// level here.
/// The FULL entry form (8a2.3): FSE streams take their cells FLAT from
/// `flat` (stream-major), VLE streams take their rows from `spans`
/// (stream-major across the VLE streams). Which is which comes from the
/// COLUMNS THEMSELVES — blocks self-describe their kind.
pub fn btfl_insert_entry<const N: u32, P: NodeProfile>(snap: &MemorySnapshot, t: &mut Btfl<N, P>, key: u64,
                                       flat: &Vec<u64>, lens: &Vec<u64>,
                                       spans: &PdtVals) -> bool {
    unsafe {
        let e: BtflEntry = BtflEntry {
            flat: flat as *const Vec<u64>,
            lens: lens as *const Vec<u64>,
            spans: spans as *const PdtVals,
        };
        let r: BtInsRet<u64, N> = bt_ins_rec::<u64, BtflEntry, BtflBranchRef<N, P>, N>(
            t.root, t.level, key, e, snap.snapshot_id(), btfl_step::<N, P>);
        if !r.ok {
            return false;
        }
        if r.split {
            let nb: *mut u8 = btfl_branch_new::<N, P>(snap, t.branch_bytes);
            let na: *mut PkdAlloc = P::pkd(nb);
            btfl_branch_insert_child::<N>(na, 0u32, r.lsep, &r.lcnt, r.addr as u64);
            btfl_branch_insert_child::<N>(na, 1u32, r.rsep, &r.rcnt, r.rptr as u64);
            t.root = nb;
            t.level = t.level + 1u32;
        }
        return true;
    }
}

/// The all-FSE entry form — every stream's rows ride `flat` (compat surface;
/// forwards with an empty span carrier).
pub fn btfl_insert_n<const N: u32, P: NodeProfile>(snap: &MemorySnapshot, t: &mut Btfl<N, P>, key: u64,
                                   flat: &Vec<u64>, lens: &Vec<u64>) -> bool {
    let ev: PdtVals = pdt_vals_new();
    return btfl_insert_entry::<N, P>(snap, t, key, flat, lens, &ev);
}

/// The 2-stream multimap entry insert: `key → vals` (a key entry followed by
/// its value entries). A thin wrapper over the N-generic core — vals pass
/// through as the flat stream-1 run, no copy.
// ── P6b: bulk build ─────────────────────────────────────────────────────────
//
// C++ shape (btfl_batch_input_provider.hpp:263-272 + :449-511): stage the
// input, then fill each leaf by bisecting in SYMBOL space and projecting the
// cut into per-stream row counts with
//
//     rank(idx) = symbols.rank_to(start.sum() + idx) - start
//
// THE PROJECTION IS THE IDEA, and it is what generalizes: a cut at structure
// position n becomes "how many rows of each stream" by ranking the symbol
// sequence, and the counts sum to n by construction. No arithmetic split of
// the streams can do this — they interleave arbitrarily, and only the symbol
// sequence knows how.
//
// THREE DERIVED DEPARTURES from the C++, each with its reason:
//
//   1. The stage keeps an ENTRY INDEX, not a packed symbol sequence. C++
//      stages into an IOSSRLEBuffer because its producer streams runs; ours is
//      built from whole entries, and for an entry-built batch the index IS the
//      symbol sequence in closed form: entry i starts at starts[i], so
//      rank(p, KEY) is a binary search, rank(p, VAL) is p minus that, access
//      is "is p a start", and select is starts[k] outright. Packing the stage
//      would buy nothing — leaves re-encode the runs on insert anyway — while
//      costing a size guess (block_size takes CODE UNITS, not symbols) and a
//      growth path for a block that has no parent allocator to grow through.
//
//   2. The fill bisects over a CONST pricing probe and commits ONCE (the P6a
//      discipline), where the C++ commits every successful probe.
//
//   3. Cuts are KEY-ALIGNED. A cut landing inside a value run would leave a
//      leaf whose first symbol is a value, breaking the v0 invariant that
//      every leaf starts with a key — which btfl_check enforces, so bulk
//      output stays shape-identical to what repeated single inserts produce.

/// A staged batch: entries in key order, held as the two data streams flat
/// plus the entry index that stands in for the symbol sequence.
pub struct BtflStage {
    pub keys: Vec<u64>,     // entry keys, strictly increasing
    pub vals: Vec<u64>,     // every value, entry-major
    pub starts: Vec<u64>,   // structure position where entry i begins
    total: u64,             // structure positions staged
}

pub fn btfl_stage_new() -> BtflStage {
    return BtflStage {
        keys: vec_new::<u64>(),
        vals: vec_new::<u64>(),
        starts: vec_new::<u64>(),
        total: 0u64,
    };
}

impl BtflStage {
    /// Append one entry: its key, then its values. Keys must arrive strictly
    /// increasing — the same contract single inserts hold, checked here so a
    /// bad producer fails at staging instead of as a corrupt tree.
    pub fn push_entry(self: &mut BtflStage, key: u64, vals: &Vec<u64>) {
        let n: i64 = self.keys.length();
        if n > 0i64 {
            assert(key > self.keys.get(n - 1i64),
                   "BtflStage::push_entry: keys must arrive strictly increasing");
        }
        self.starts.push(self.total);
        self.keys.push(key);
        let m: i64 = vals.length();
        let mut j: i64 = 0i64;
        while j < m {
            self.vals.push(vals.get(j));
            j = j + 1i64;
        }
        self.total = self.total + 1u64 + (m as u64);
    }

    /// Structure positions staged (keys + values).
    pub fn size(self: &BtflStage) -> u64 {
        return self.total;
    }

    /// Entries staged.
    pub fn entries(self: &BtflStage) -> u64 {
        return self.keys.length() as u64;
    }

    // rank of KEY symbols over [0, p): the number of entry starts below p.
    // Binary search over `starts`, which is strictly increasing.
    fn rank_key(self: &BtflStage, p: u64) -> u64 {
        let mut lo: i64 = 0i64;
        let mut hi: i64 = self.starts.length();
        while lo < hi {
            let mid: i64 = lo + (hi - lo) / 2i64;
            if self.starts.get(mid) < p {
                lo = mid + 1i64;
            } else {
                hi = mid;
            }
        }
        return lo as u64;
    }

    // rank of VALUE symbols over [0, p) — the complement, by construction.
    fn rank_val(self: &BtflStage, p: u64) -> u64 {
        return p - self.rank_key(p);
    }

    // Is structure position p a key symbol?
    fn is_key_at(self: &BtflStage, p: u64) -> bool {
        let k: u64 = self.rank_key(p);
        if k >= (self.starts.length() as u64) {
            return false;
        }
        return self.starts.get(k as i64) == p;
    }
}

/// The RANK PROJECTION of a cut: per-stream row counts for the `n` structure
/// positions starting at `from`, and where those rows begin in each stream.
/// `keys + vals == n` by construction — the property the batch path rests on.
pub struct BtflCut {
    pub keys: u64,
    pub vals: u64,
    pub key_at: u64,
    pub val_at: u64,
}

pub fn btfl_cut(st: &BtflStage, from: u64, n: u64) -> BtflCut {
    let k0: u64 = st.rank_key(from);
    let v0: u64 = st.rank_val(from);
    return BtflCut {
        keys: st.rank_key(from + n) - k0,
        vals: st.rank_val(from + n) - v0,
        key_at: k0,
        val_at: v0,
    };
}

// Align a cut DOWN to a whole number of entries: the length that ends exactly
// before an entry start (or at the end of the batch). 0 when not even one
// whole entry fits.
// Structure length of the first `e` staged entries starting at `from`.
// `from` is always an entry start, so this is exact: a cut is named by how
// many WHOLE entries it takes, never by a raw position.
fn btfl_entry_span(st: &BtflStage, e0: u64, e: u64) -> u64 {
    let from: u64 = st.starts.get(e0 as i64);
    if e0 + e >= st.entries() {
        return st.size() - from;
    }
    return st.starts.get((e0 + e) as i64) - from;
}

// Would a cut of `n` structure positions starting at `from` fit an EMPTY
// leaf? Priced, never attempted: the bisection asks this many times, and an
// attempted-and-rolled-back insert would be exactly the copy traffic the
// exact-prepare discipline exists to remove.
unsafe fn btfl_cut_fits<P: NodeProfile>(st: &BtflStage, from: u64, n: u64, leaf: *mut u8) -> bool {
    let c: BtflCut = btfl_cut(st, from, n);
    let a: *mut PkdAlloc = P::pkd(leaf);
    let seq: PkdSsrle = lf_seq(a);
    let syms: Vec<u64> = btfl_cut_symbols(st, from, n);
    let runs: Vec<SsrleRun> = ssrle_runs_from_symbols(seq.bps(), &syms);
    let us: SsrleUpdate = seq.plan_insert(0u64, &runs);
    // exact pricing: each stream priced by the same prepare that would commit
    // it into the (empty) leaf (8a2.3 — no cell-width formula).
    let mut delta: u32 = 0u32;
    if c.keys > 0u64 {
        let kb: PdtBuf = lf_pdt(a, LF_KEYS);
        let uk: PdtUpdate = match kb.prepare_insert(0u64, c.keys, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                return false;
            }
        };
        delta = delta + uk.grow_bytes();
    }
    if c.vals > 0u64 {
        let vb: PdtBuf = lf_pdt(a, LF_VALS);
        let uv: PdtUpdate = match vb.prepare_insert(0u64, c.vals, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                return false;
            }
        };
        delta = delta + uv.grow_bytes();
    }
    let syms_cur: u32 = a.element_size(LF_SYMS);
    if us.block_size > syms_cur {
        delta = delta + (us.block_size - syms_cur);
    }
    return delta <= a.free_space();
}

// The symbol run of a cut, materialized from the entry index.
fn btfl_cut_symbols(st: &BtflStage, from: u64, n: u64) -> Vec<u64> {
    let mut syms: Vec<u64> = vec_new::<u64>();
    let mut p: u64 = from;
    while p < from + n {
        if st.is_key_at(p) {
            syms.push(0u64);
        } else {
            syms.push(1u64);
        }
        p = p + 1u64;
    }
    return syms;
}

// Fill an EMPTY leaf with the largest key-aligned prefix of the staged rows
// that fits. Returns the structure positions consumed; 0 means not even one
// entry fits, which is the caller's error to report.
unsafe fn btfl_fill_leaf<P: NodeProfile>(st: &BtflStage, from: u64, leaf: *mut u8) -> u64 {
    let remaining: u64 = st.size() - from;
    if remaining == 0u64 {
        return 0u64;
    }
    // BISECT OVER ENTRY COUNT, never over structure positions. `fits` is
    // monotone in entries — e entries fit ⇒ e-1 entries fit — so bisection is
    // valid. Over raw positions it is NOT: a position below the first entry's
    // length aligns to a zero-length cut and reads as "does not fit", so the
    // predicate is false-then-true-then-false and the search collapses to 0
    // exactly when the tail holds one entry longer than half of it.
    let e0: u64 = st.rank_key(from + 1u64) - 1u64;
    let mut lo: u64 = 0u64;
    let mut hi: u64 = st.entries() - e0;
    while lo < hi {
        let mid: u64 = lo + (hi - lo + 1u64) / 2u64;
        let span: u64 = btfl_entry_span(st, e0, mid);
        if btfl_cut_fits::<P>(st, from, span, leaf) {
            lo = mid;
        } else {
            hi = mid - 1u64;
        }
    }
    if lo == 0u64 {
        return 0u64;
    }
    let take: u64 = btfl_entry_span(st, e0, lo);
    let c: BtflCut = btfl_cut(st, from, take);
    let a: *mut PkdAlloc = P::pkd(leaf);
    if c.keys > 0u64 {
        // ONE two-phase bulk insert per stream (8a2.3) — the pricing probe
        // above ran the same prepare, so the commit is guaranteed.
        let kb: PdtBuf = lf_pdt(a, LF_KEYS);
        let uk: PdtUpdate = match kb.prepare_insert(0u64, c.keys, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "btfl_fill_leaf: priced keys prepare failed");
                return 0u64;
            }
        };
        let mut cells: Vec<u64> = vec_new::<u64>();
        let mut i: u64 = 0u64;
        while i < c.keys {
            cells.push(st.keys.get((c.key_at + i) as i64));
            i = i + 1u64;
        }
        let mut kb2: PdtBuf = lf_pdt(a, LF_KEYS);
        kb2.commit_insert(&uk, &cells);
    }
    if c.vals > 0u64 {
        let vb: PdtBuf = lf_pdt(a, LF_VALS);
        let uv: PdtUpdate = match vb.prepare_insert(0u64, c.vals, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "btfl_fill_leaf: priced vals prepare failed");
                return 0u64;
            }
        };
        let mut vcells: Vec<u64> = vec_new::<u64>();
        let mut j: u64 = 0u64;
        while j < c.vals {
            vcells.push(st.vals.get((c.val_at + j) as i64));
            j = j + 1u64;
        }
        let mut vb2: PdtBuf = lf_pdt(a, LF_VALS);
        vb2.commit_insert(&uv, &vcells);
    }
    let syms: Vec<u64> = btfl_cut_symbols(st, from, take);
    let mut seq2: PkdSsrle = lf_seq(a);
    match seq2.insert_symbols(0u64, &syms) {
        Result::Ok(_u) => {}
        Result::Err(_e) => {
            assert(false, "btfl_fill_leaf: priced symbol insert failed");
        }
    }
    return take;
}

/// Build a whole tree from a staged batch, bottom-up: leaves filled by the
/// aligned bisection above, then branch levels over them until one node
/// remains. Every leaf but the last is filled to capacity — which is what a
/// bulk build is FOR: the single-insert path leaves nodes half full after each
/// split, and replaying a batch through it would too.
pub fn btfl_bulk_build<P: NodeProfile>(snap: &MemorySnapshot, st: &BtflStage,
                       leaf_bytes: u32, branch_bytes: u32) -> Btfl<2, P> {
    unsafe {
        if st.size() == 0u64 {
            return btfl_create::<2, P>(snap, leaf_bytes, branch_bytes);
        }
        let mut nodes: Vec<u64> = vec_new::<u64>();
        let mut consumed: u64 = 0u64;
        while consumed < st.size() {
            let leaf: *mut u8 = btfl_leaf_new::<2, P>(snap, leaf_bytes);
            let took: u64 = btfl_fill_leaf::<P>(st, consumed, leaf);
            assert(took > 0u64,
                   "btfl_bulk_build: one entry does not fit a leaf (spanning entries land in 8a2)");
            nodes.push(leaf as u64);
            consumed = consumed + took;
        }
        let mut level: u32 = 0u32;
        while nodes.length() > 1i64 {
            let mut parents: Vec<u64> = vec_new::<u64>();
            let mut cur: *mut u8 = btfl_branch_new::<2, P>(snap, branch_bytes);
            let mut cur_n: u32 = 0u32;
            let mut idx: i64 = 0i64;
            while idx < nodes.length() {
                let child: *mut u8 = nodes.get(idx) as *mut u8;
                // the (max, counts) row for this child — leaf: per-stream row
                // counts; branch: the wrapper's max_sep/totals (the
                // branch_summary helper died with the skeleton unification)
                let mut cmax: u64 = 0u64;
                let mut ccnt: [u64; 2] = [0u64; 2];
                if level == 0u32 {
                    let sm: BtInsRet<u64, 2> = leaf_summary::<2, P>(child, false, child);
                    cmax = sm.lsep;
                    ccnt[0] = sm.lcnt[0];
                    ccnt[1] = sm.lcnt[1];
                } else {
                    let bw: BtflBranchRef<2, P> = BtflBranchRef::<2, P> { mem: child };
                    cmax = bw.max_sep();
                    bw.totals(&mut ccnt);
                }
                if cur_n > 0u32 && !btfl_branch_fits_one(P::pkd(cur)) {
                    parents.push(cur as u64);
                    cur = btfl_branch_new::<2, P>(snap, branch_bytes);
                    cur_n = 0u32;
                }
                btfl_branch_insert_child::<2>(P::pkd(cur), cur_n, cmax, &ccnt,
                                              child as u64);
                cur_n = cur_n + 1u32;
                idx = idx + 1i64;
            }
            parents.push(cur as u64);
            nodes = parents;
            level = level + 1u32;
        }
        return Btfl::<2, P> {
            root: nodes.get(0i64) as *mut u8,
            level: level,
            leaf_bytes: leaf_bytes,
            branch_bytes: branch_bytes,
        };
    }
}

// ── structural self-check (the btfl_c_checks mirror) ────────────────────────

struct ChkRes<const N: u32> {
    ok: bool,
    max: u64,
    cnt: [u64; N],
}

// Recursive verification: every branch row equals its child's reality; leaf
// counts agree between the columns and the structure stream (per symbol);
// stream-0 keys strictly increase globally; every non-empty leaf starts with
// a symbol-0 entry (the v0 invariant).
unsafe fn btfl_chk_rec<const N: u32, P: NodeProfile>(node: *mut u8, level: u32,
                                     prev: &mut u64, any: &mut bool) -> ChkRes<N> {
    if level == 0u32 {
        let a: *mut PkdAlloc = P::pkd(node);
        let ka: PdtBuf = lf_pdt(a, 0u32);
        let seq: PkdSsrle = lf_seq_n::<N>(a);
        let kc: u64 = ka.size();
        let mut ok: bool = true;
        let mut cnt: [u64; N] = [0u64; N];
        let mut tot: u64 = 0u64;
        let mut s: u32 = 0u32;
        while s < N {
            let sc: u64 = lf_pdt(a, s).size();
            if seq.rank_eq_all(s as u64) != sc {
                ok = false;
            }
            cnt[s as i64] = sc;
            tot = tot + sc;
            s = s + 1u32;
        }
        if seq.size() != tot {
            ok = false;
        }
        if seq.size() > 0u64 {
            if seq.access(0u64) != 0u64 {
                ok = false;
            }
        }
        let mut i: u64 = 0u64;
        while i < kc {
            let k: u64 = ka.get(0u32, i);
            if *any {
                if k <= *prev {
                    ok = false;
                }
            }
            *prev = k;
            *any = true;
            i = i + 1u64;
        }
        let mut mx: u64 = 0u64;
        if kc > 0u64 {
            mx = ka.get(0u32, kc - 1u64);
        }
        return ChkRes::<N> {
            ok: ok,
            max: mx,
            cnt: cnt,
        };
    }
    let a: *mut PkdAlloc = P::pkd(node);
    let bb: PdtBuf = br_pdt(a);
    let ch: PdtBuf = br_child(a);
    let n: u32 = bb.size() as u32;
    let mut ok: bool = n > 0u32;
    if ch.size() as u32 != n {
        ok = false;
    }
    let mut sum: [u64; N] = [0u64; N];
    let mut mx: u64 = 0u64;
    let mut i: u32 = 0u32;
    while i < n {
        let sub: ChkRes<N> = btfl_chk_rec::<N, P>(ch.get(0u32, i as u64) as *mut u8, level - 1u32, prev, any);
        if !sub.ok {
            ok = false;
        }
        if bb.get(BRC_MAX, i as u64) != sub.max {
            ok = false;
        }
        let mut cs: u32 = 0u32;
        while cs < N {
            if bb.get(BRC_CNT0 + cs, i as u64) != sub.cnt[cs as i64] {
                ok = false;
            }
            sum[cs as i64] = sum[cs as i64] + sub.cnt[cs as i64];
            cs = cs + 1u32;
        }
        mx = sub.max;
        i = i + 1u32;
    }
    return ChkRes::<N> {
        ok: ok,
        max: mx,
        cnt: sum,
    };
}

/// Whole-tree structural check: branch sum/measure columns vs child reality,
/// leaf column/structure agreement, global key ordering, the v0 leaf-start
/// invariant (the C++ checks part, btfl_c_checks.hpp).
/// Root branch fanout — a test hook so the wide-branch gate scenario can
/// assert it actually crossed the SUM-index threshold.
pub unsafe fn br_pdt_size_for_test<P: NodeProfile>(root: *mut u8) -> u64 {
    return br_pdt(P::pkd(root)).size();
}

pub fn btfl_check<const N: u32, P: NodeProfile>(t: &Btfl<N, P>) -> bool {
    unsafe {
        let mut prev: u64 = 0u64;
        let mut any: bool = false;
        let res: ChkRes<N> = btfl_chk_rec::<N, P>(t.root, t.level, &mut prev, &mut any);
        return res.ok;
    }
}
