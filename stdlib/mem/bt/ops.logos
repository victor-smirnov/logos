// logos.mem.bt.ops — the generic B+tree OPS library (ADR 0020 Track B follow-on).
//
// Replaces the per-config metaprog-GENERATED ops (GenCow_cow_insert, GenCowTree_ins,
// GenCow_descend_get, GenCowTree_free, …) with ONE set of functions generic over the
// leaf/branch node shape. Only the node LAYOUT (the PkdArray<K>/PkdArray<V> column
// mix, block format, `adopt`/`new_in`/`cow_clone`) stays per-config generated; the
// tree ALGORITHMS (descend, insert-with-split, CoW-insert, free, size) are expressed
// here exactly once and instantiate over any `L: BtLeaf<K, VIn, VOut>` / `B: BtBranch<K, 1>`.
//
// Style/shape verified against a compiled-and-passing spike (trait_spike2.logos):
// self-less associated fns (`fn adopt(mem: *mut u8) -> Self;`) called as `L::adopt(node)`
// inside generic fns bounded `<K: Copy, VIn: Copy, VOut: Copy, L: BtLeaf<K, VIn, VOut>, B: BtBranch<K, 1>>`.
// Algorithms mirror the FAST GenCow family (ref_fast_all.logos) verbatim, field-for-
// field and branch-for-branch — only node-type names became `L`/`B` type params and
// `GenCow*` symbols became `bt_*`.
package logos.mem.bt.ops;

use logos.lang.option;      // Option — the WITH_ENTRY quad signature
use logos.mem.bt.node;      // NodeProfile — the node-form seam (P::snapshot)
use logos.mem.bt.memstore;  // tree_release — container-agnostic recursive rc-release
use logos.mem.bt.map;       // BtLeaf / BtBranch — the node contracts (declared in
                            // the import hub so generated `impl BtLeaf<…> for {N}Leaf`
                            // blocks pass the collect-time trait check via the
                            // declaring unit's existing `use logos.mem.bt.map;`)

// ── descend (read path) ───────────────────────────────────────────────────────

/// Point lookup from `(root, level)` down to the owning leaf; `sentinel` on miss.
/// Mirrors `GenCow_descend_get` / `GenCowTree::get_or` (same walk, both used it).
pub fn bt_descend_get<K: Copy, VIn: Copy, VOut: Copy, L: BtLeaf<K, VIn, VOut>, B: BtBranch<K, 1>>(
    root: *mut u8, level: u32, key: K, sentinel: VOut) -> VOut {
    let mut node: *mut u8 = root;
    let mut lvl: u32 = level;
    while lvl > 0u32 {
        let br: B = B::adopt(node);
        node = br.child_addr(br.find_child(key));
        lvl = lvl - 1u32;
    }
    let lf: L = L::adopt(node);
    let p: u32 = lf.lower_bound(key);
    if p < lf.count() && lf.key_at(p) == key { return lf.val_at(p); }
    return sentinel;
}

// ── insert result (shared by the plain and the CoW insert) ────────────────────

/// The bottom-up insert report: the (possibly still-`node`) left result plus an
/// optional split's right sibling. `addr` carries the (possibly new, under CoW)
/// block identity of the LEFT side — `bt_ins` always returns `addr == node`
/// (in-place mutation, no CoW); `bt_cow_insert` may return a freshly cow-cloned
/// block, which is how a parent detects "my child's identity changed" and
/// re-points its child ref (mirrors `GenCowCowRet`; `GenCowTreeIR` is the same
/// shape minus `addr` because the plain path never needs it — kept here as one
/// struct rather than two so `bt_ins`/`bt_cow_insert` share one report type).
/// S2b: the report is N-ARY — one count per stream per side (`[u64; N]`), the
/// multistream shape; a single-stream tree is `N = 1` (lcnt[0] = entry count).
/// One shape for both worlds — the two insert protocols stopped drifting.
pub struct BtInsRet<K, const N: u32> {
    /// `false` iff the insert was REJECTED (btfl: duplicate key) — the reject
    /// propagates up untouched; single-stream upsert always reports `true`.
    pub ok: bool,
    pub addr: *mut u8,
    pub lsep: K,
    pub lcnt: [u64; N],
    pub split: bool,
    pub rsep: K,
    pub rcnt: [u64; N],
    pub rptr: *mut u8,
}

// ── plain insert (no CoW — in-place mutation) ──────────────────────────────────

/// The LEAF STEP of an insert — the one part of the bottom-up protocol that
/// legitimately differs per family: a single-stream map UPSERTS (step_upsert
/// below); the multistream bt_fl REJECTS duplicates and rank-projects the
/// entry into every stream (its step lives in logos.mem.bt.btfl). Everything
/// above the leaf — descend, row update, split propagation, sibling insert —
/// is the SAME protocol and lives once in `bt_ins_rec`. The step is a plain
/// FN POINTER (not a trait static): a trait-static reached through a bound
/// whose trait ARGS need substitution is an open mono seam (the G156-1
/// class) — the fn-ptr form works today and swaps back when that lands.
///
/// THE bottom-up insert recursion — the one skeleton both the single-stream
/// and the multistream (bt_fl) plain inserts ride (S2b/A2; the CoW insert
/// interleaves privatization at every level and stays its own walk below
/// until the privatize hook lands). Descends by `find_child`, delegates the
/// leaf to `step`, updates the child row, and propagates a split by
/// inserting the right sibling into this branch (splitting IT if full).
pub fn bt_ins_rec<K: Copy, E: Copy, B: BtBranch<K, N>, const N: u32>(
    node: *mut u8, level: u32, key: K, e: E, snp: u64,
    step: fn(*mut u8, K, E, u64) -> BtInsRet<K, N>) -> BtInsRet<K, N> {
    if level == 0u32 {
        return step(node, key, e, snp);
    }
    let mut br: B = B::adopt(node);
    let ci: u32 = br.find_child(key);
    let r: BtInsRet<K, N> = bt_ins_rec::<K, E, B, N>(br.child_addr(ci), level - 1u32, key, e, snp, step);
    if !r.ok { return r; }
    br.update_row(ci, r.lsep, &r.lcnt);
    if !r.split {
        let mut t: [u64; N] = [0u64; N];
        br.totals(&mut t);
        return BtInsRet { ok: true, addr: node, lsep: br.max_sep(), lcnt: t, split: false, rsep: key, rcnt: [0u64; N], rptr: node };
    }
    if br.can_insert_child() {
        br.insert_row(ci + 1u32, r.rsep, &r.rcnt, r.rptr);
        let mut t: [u64; N] = [0u64; N];
        br.totals(&mut t);
        return BtInsRet { ok: true, addr: node, lsep: br.max_sep(), lcnt: t, split: false, rsep: key, rcnt: [0u64; N], rptr: node };
    }
    let mut rb: B = br.new_sibling(snp);
    let _ = br.split_into(&mut rb);
    let lc: u32 = br.child_count();
    if ci + 1u32 < lc { br.insert_row(ci + 1u32, r.rsep, &r.rcnt, r.rptr); } else {
        rb.insert_row((ci + 1u32) - lc, r.rsep, &r.rcnt, r.rptr);
    }
    let mut lt: [u64; N] = [0u64; N];
    br.totals(&mut lt);
    let mut rt2: [u64; N] = [0u64; N];
    rb.totals(&mut rt2);
    return BtInsRet { ok: true, addr: node, lsep: br.max_sep(), lcnt: lt, split: true, rsep: rb.max_sep(), rcnt: rt2, rptr: rb.block() };
}

/// The single-stream UPSERT leaf step: try in place, else split at the middle
/// and retry into the owning half.
pub fn step_upsert<K: Copy, VIn: Copy, VOut: Copy, L: BtLeaf<K, VIn, VOut>>(
    node: *mut u8, key: K, val: VIn, snp: u64) -> BtInsRet<K, 1> {
    let mut lf: L = L::adopt(node);
    if lf.try_insert(key, val) {
        return BtInsRet { ok: true, addr: node, lsep: lf.key_at(lf.count() - 1u32), lcnt: [lf.count() as u64], split: false, rsep: key, rcnt: [0u64], rptr: node };
    }
    let mut rt: L = lf.new_sibling(snp);
    lf.split_into(&mut rt);
    if key <= lf.key_at(lf.count() - 1u32) { let _ = lf.try_insert(key, val); } else { let _ = rt.try_insert(key, val); }
    return BtInsRet { ok: true, addr: node, lsep: lf.key_at(lf.count() - 1u32), lcnt: [lf.count() as u64], split: true, rsep: rt.key_at(rt.count() - 1u32), rcnt: [rt.count() as u64], rptr: rt.block() };
}

/// Bottom-up insert-with-split, mutating nodes in place — the single-stream
/// instantiation of `bt_ins_rec` over the upsert step. Mirrors `GenCowTree_ins`.
pub fn bt_ins<K: Copy, VIn: Copy, VOut: Copy, L: BtLeaf<K, VIn, VOut>, B: BtBranch<K, 1>>(
    node: *mut u8, level: u32, key: K, val: VIn) -> BtInsRet<K, 1> {
    return bt_ins_rec::<K, VIn, B, 1>(node, level, key, val, 0u64, step_upsert::<K, VIn, VOut, L>);
}

/// Recursively releases `(node, level)` — the non-CoW, non-refcounted teardown
/// (unconditional free, no rc check; use `tree_release` for the rc-aware CoW
/// teardown). Mirrors `GenCowTree_free`.
pub fn bt_tree_free<K: Copy, VIn: Copy, VOut: Copy, L: BtLeaf<K, VIn, VOut>, B: BtBranch<K, 1>>(node: *mut u8, level: u32) {
    if level == 0u32 {
        L::adopt(node).free();
        return;
    }
    let br: B = B::adopt(node);
    let n: u32 = br.child_count();
    let mut i: u32 = 0u32;
    while i < n {
        bt_tree_free::<K, VIn, VOut, L, B>(br.child_addr(i), level - 1u32);
        i = i + 1u32;
    }
    br.free_block();
}

// ── CoW insert ───────────────────────────────────────────────────────────────

/// "Make `node` privately writable under snapshot `cur`" — if it's already
/// stamped `cur` it's already private (return unchanged); otherwise `cow_clone`
/// it and return the fresh block. Mirrors `GenCow_leaf_private`.
pub unsafe fn bt_leaf_private<K: Copy, VIn: Copy, VOut: Copy, L: BtLeaf<K, VIn, VOut>, P: NodeProfile>(node: *mut u8, cur: u64) -> *mut u8 {
    if P::snapshot(node) == cur { return node; }
    return L::adopt(node).cow_clone(cur).block();
}

/// The branch analog of `bt_leaf_private`. Mirrors `GenCow_branch_private`.
pub unsafe fn bt_branch_private<K: Copy, B: BtBranch<K, 1>, P: NodeProfile>(node: *mut u8, cur: u64) -> *mut u8 {
    if P::snapshot(node) == cur { return node; }
    return B::adopt(node).cow_clone(cur).block();
}

/// Bottom-up insert-with-split under copy-on-write: every node on the path is
/// first made private to `cur` (`bt_leaf_private`/`bt_branch_private`), and a
/// child whose identity changed underneath a branch has its OLD block released
/// via `tree_release` (structural-sharing rc-drop, not an unconditional free —
/// the old block may still be referenced by a frozen sibling snapshot).
/// Mirrors `GenCow_cow_insert`.
pub unsafe fn bt_cow_insert<K: Copy, VIn: Copy, VOut: Copy, L: BtLeaf<K, VIn, VOut>, B: BtBranch<K, 1>, P: NodeProfile>(
    node: *mut u8, level: u32, key: K, val: VIn, cur: u64) -> BtInsRet<K, 1> {
    if level == 0u32 {
        let work: *mut u8 = bt_leaf_private::<K, VIn, VOut, L, P>(node, cur);
        let mut lf: L = L::adopt(work);
        if lf.try_insert(key, val) {
            return BtInsRet { ok: true, addr: work, lsep: lf.key_at(lf.count() - 1u32), lcnt: [lf.count() as u64], split: false, rsep: key, rcnt: [0u64], rptr: work };
        }
        let mut rt: L = lf.new_sibling(cur);
        lf.split_into(&mut rt);
        if key <= lf.key_at(lf.count() - 1u32) { let _ = lf.try_insert(key, val); } else { let _ = rt.try_insert(key, val); }
        return BtInsRet { ok: true, addr: work, lsep: lf.key_at(lf.count() - 1u32), lcnt: [lf.count() as u64], split: true, rsep: rt.key_at(rt.count() - 1u32), rcnt: [rt.count() as u64], rptr: rt.block() };
    }
    let work: *mut u8 = bt_branch_private::<K, B, P>(node, cur);
    let mut br: B = B::adopt(work);
    let ci: u32 = br.find_child(key);
    let old_child: *mut u8 = br.child_addr(ci);
    let r: BtInsRet<K, 1> = bt_cow_insert::<K, VIn, VOut, L, B, P>(old_child, level - 1u32, key, val, cur);
    br.update_row(ci, r.lsep, &r.lcnt);
    if r.addr != old_child {
        br.set_child_addr(ci, r.addr);
        tree_release(old_child, level - 1u32);
    }
    if !r.split {
        return BtInsRet { ok: true, addr: work, lsep: br.max_sep(), lcnt: [br.total_size()], split: false, rsep: key, rcnt: [0u64], rptr: work };
    }
    if br.can_insert_child() {
        br.insert_row(ci + 1u32, r.rsep, &r.rcnt, r.rptr);
        return BtInsRet { ok: true, addr: work, lsep: br.max_sep(), lcnt: [br.total_size()], split: false, rsep: key, rcnt: [0u64], rptr: work };
    }
    let mut rb: B = br.new_sibling(cur);
    let _ = br.split_into(&mut rb);
    let lc: u32 = br.child_count();
    if ci + 1u32 < lc { br.insert_row(ci + 1u32, r.rsep, &r.rcnt, r.rptr); } else {
        rb.insert_row((ci + 1u32) - lc, r.rsep, &r.rcnt, r.rptr);
    }
    return BtInsRet { ok: true, addr: work, lsep: br.max_sep(), lcnt: [br.total_size()], split: true, rsep: rb.max_sep(), rcnt: [rb.total_size()], rptr: rb.block() };
}

/// bt_cow_insert's WITH_ENTRY twin (ADR 0023 §Derived forms): the same
/// privatize/recurse/graft walk, with the leaf action being the quad —
/// `f: Option<VOut> → Option<VIn>` over the entry at `key`. Differences
/// from insert are confined to the leaf arm: a no-op/remove always "fits";
/// an insert/replace that does not fit splits the leaf and RETRIES on the
/// key's side (f runs again there — the BtLeaf contract asks it to be
/// pure). Removal does no underflow handling (merge is the separate
/// split/merge task); an emptied leaf remains a valid node.
pub unsafe fn bt_cow_with_entry<K: Copy, VIn: Copy, VOut: Copy, L: BtLeaf<K, VIn, VOut>, B: BtBranch<K, 1>, P: NodeProfile>(
    node: *mut u8, level: u32, key: K, f: fn(Option<VOut>) -> Option<VIn>, cur: u64) -> BtInsRet<K, 1> {
    if level == 0u32 {
        let work: *mut u8 = bt_leaf_private::<K, VIn, VOut, L, P>(node, cur);
        let mut lf: L = L::adopt(work);
        if lf.with_entry(key, f) {
            let mut sep: K = key;
            if lf.count() > 0u32 {
                sep = lf.key_at(lf.count() - 1u32);
            }
            return BtInsRet { ok: true, addr: work, lsep: sep, lcnt: [lf.count() as u64], split: false, rsep: key, rcnt: [0u64], rptr: work };
        }
        let mut rt: L = lf.new_sibling(cur);
        lf.split_into(&mut rt);
        if key <= lf.key_at(lf.count() - 1u32) { let _ = lf.with_entry(key, f); } else { let _ = rt.with_entry(key, f); }
        return BtInsRet { ok: true, addr: work, lsep: lf.key_at(lf.count() - 1u32), lcnt: [lf.count() as u64], split: true, rsep: rt.key_at(rt.count() - 1u32), rcnt: [rt.count() as u64], rptr: rt.block() };
    }
    let work: *mut u8 = bt_branch_private::<K, B, P>(node, cur);
    let mut br: B = B::adopt(work);
    let ci: u32 = br.find_child(key);
    let old_child: *mut u8 = br.child_addr(ci);
    let r: BtInsRet<K, 1> = bt_cow_with_entry::<K, VIn, VOut, L, B, P>(old_child, level - 1u32, key, f, cur);
    br.update_row(ci, r.lsep, &r.lcnt);
    if r.addr != old_child {
        br.set_child_addr(ci, r.addr);
        tree_release(old_child, level - 1u32);
    }
    if !r.split {
        return BtInsRet { ok: true, addr: work, lsep: br.max_sep(), lcnt: [br.total_size()], split: false, rsep: key, rcnt: [0u64], rptr: work };
    }
    if br.can_insert_child() {
        br.insert_row(ci + 1u32, r.rsep, &r.rcnt, r.rptr);
        return BtInsRet { ok: true, addr: work, lsep: br.max_sep(), lcnt: [br.total_size()], split: false, rsep: key, rcnt: [0u64], rptr: work };
    }
    let mut rb: B = br.new_sibling(cur);
    let _ = br.split_into(&mut rb);
    let lc: u32 = br.child_count();
    if ci + 1u32 < lc { br.insert_row(ci + 1u32, r.rsep, &r.rcnt, r.rptr); } else {
        rb.insert_row((ci + 1u32) - lc, r.rsep, &r.rcnt, r.rptr);
    }
    return BtInsRet { ok: true, addr: work, lsep: br.max_sep(), lcnt: [br.total_size()], split: true, rsep: rb.max_sep(), rcnt: [rb.total_size()], rptr: rb.block() };
}

// ── seek by entry NUMBER (the stream-size feature's read side) ───────────────
//
// Every container doubles as an ARRAY of its entries (Memoria's classic BTSS
// seek semantics): the branch rows already carry per-child subtree counts —
// maintained by every insert since S2b — so the N-th entry is a descent that
// subtracts child counts until the remainder falls inside one subtree, then
// indexes the leaf locally. O(height · fanout) with the linear column walk
// (matching lower_bound's discipline); flips to one SUM-index find_gt per
// level when the branch count column graduates to the SUM order.

/// Where a positional seek landed: the owning leaf and the LOCAL entry index.
/// `found = false` ⇔ `pos >= size()` (leaf/idx are then the past-the-end
/// position: the last leaf and its count). The v0 cursor is this pair — leaf
/// identity + local offset; movement (next/prev with a parent path) is the
/// cursors arc.
pub struct BtCur {
    pub found: bool,
    pub leaf: *mut u8,
    pub idx: u32,
}

/// Descend `(root, level)` to the entry at ordinal `pos` (0-based, stream 0).
pub fn bt_seek_at<K: Copy, VIn: Copy, VOut: Copy, L: BtLeaf<K, VIn, VOut>, B: BtBranch<K, 1>>(
    root: *mut u8, level: u32, pos: u64) -> BtCur {
    let mut node: *mut u8 = root;
    let mut lvl: u32 = level;
    let mut rem: u64 = pos;
    while lvl > 0u32 {
        let br: B = B::adopt(node);
        let n: u32 = br.child_count();
        let mut i: u32 = 0u32;
        let mut descending: bool = false;
        while !descending && i < n {
            let c: u64 = br.count_at(i, 0u32);
            if rem < c {
                descending = true;
            } else {
                rem = rem - c;
                i = i + 1u32;
            }
        }
        if !descending {
            // pos beyond the tree: land past-the-end of the LAST subtree.
            i = n - 1u32;
            rem = br.count_at(i, 0u32);
        }
        node = br.child_addr(i);
        lvl = lvl - 1u32;
    }
    let lf: L = L::adopt(node);
    let cnt: u32 = lf.count();
    if (rem as u32) >= cnt {
        return BtCur { found: false, leaf: node, idx: cnt };
    }
    return BtCur { found: true, leaf: node, idx: rem as u32 };
}

// ── size ─────────────────────────────────────────────────────────────────────

/// `(root, level)` shape (not the snapshot/`Ctr` shape) so it composes with
/// both a bare `GenCowTree`-style handle and a `DirEntry` read out of a
/// `MemorySnapshot`'s directory. Mirrors `GenCow_size` / `GenCowTree::size`.
pub fn bt_size<K: Copy, VIn: Copy, VOut: Copy, L: BtLeaf<K, VIn, VOut>, B: BtBranch<K, 1>>(root: *mut u8, level: u32) -> u64 {
    if level == 0u32 { return L::adopt(root).count() as u64; }
    return B::adopt(root).total_size();
}

// ── no generic BtTree<K, V, L, B> struct ────────────────────────────────────
//
// A `pub struct BtTree<K, V, L: BtLeaf<K,VIn,VOut>, B: BtBranch<K, 1>> { root: *mut u8,
// root_level: u32 }` was considered and dropped: none of its fields mention
// K/V/L/B, so all four type params would be UNCONSTRAINED (no PhantomData
// convention in this codebase to pin them, and adding one just to satisfy the
// struct's own type-param list is boilerplate with no runtime payoff — the
// fields are only ever `*mut u8`/`u32`). Every op above already takes `(root,
// level)` as plain arguments and reads L/B off the CALL's turbofish, which is
// exactly the shape a per-config generated `Tree { root, root_level }` wrapper
// (itself concrete, no dangling params) needs to forward into. That thin
// concrete wrapper — not a generic struct here — is where `insert`/`get_or`/
// `size`/`free` become one-line calls into `bt_*::<K, V, ConcreteLeaf,
// ConcreteBranch>`.
