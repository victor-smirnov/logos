// logos.mem.bt.interp — the node stream-CRUD algebra: the REFERENCE
// INTERPRETER (ADR 0023, S2). Dynamic KIND dispatch over the NodeSchema.
// This code DEFINES the algebra's semantics: it is the differential oracle
// for generated kernels (S3) and stays the execution path of
// interpreter-mode Deem. Where legacy hand-unrolled behavior disagrees with
// this interpreter, the legacy is discarded, not emulated.
package logos.mem.bt.interp;

use logos.mem.bt.alg;            // the description layer (S1)
use logos.mem.pkd;               // PkdAlloc, SlotKind, PkdError
use logos.mem.pkd.pdtbuf;        // PdtBuf — the FSE/VLE/CHILD two-phase
use logos.mem.pkd.sseq;          // PkdSsrle — the structure-stream plan/commit
use logos.mem.pkd.ssrle;         // ssrle_runs_from_symbols — the run codec
use logos.mem.collections.vec;
use logos.lang.result;
use logos.lang.panic;

// ── stream adoption (the VecCtr idiom: views re-resolved at EVERY use —
// sibling slots move when earlier streams grow) ─────────────────────────────

unsafe fn st_pdt(a: *mut PkdAlloc, s: u32) -> PdtBuf {
    return pdtbuf_adopt(a.get::<u8>(s));
}

unsafe fn st_seq(a: *mut PkdAlloc, s: u32) -> PkdSsrle {
    return pkd_ssrle_adopt(a.get::<u8>(s));
}

// ── node formatting ─────────────────────────────────────────────────────────

/// Format `a`'s slots per the schema: slot i ← stream i, capacity-0
/// geometry, Allocatable, wired to the node allocator (the nested-block
/// discipline). The generalization of btss_fmt_slot / btfl leaf formatting.
pub unsafe fn alg_fmt_node(a: *mut PkdAlloc, sch: &NodeSchema) {
    let mut s: u32 = 0u32;
    while (s as i64) < sch.streams.length() {
        let kind: u32 = sch.streams.borrow(s as i64).kind;
        if kind == SK_SSRLE {
            let need: u32 = pkd_ssrle_empty_size();
            let p: *mut u8 = match a.allocate(s, need, SlotKind::Allocatable) {
                Result::Ok(q) => q,
                Result::Err(_e) => {
                    assert(false, "alg: structure-stream slot allocation failed");
                    return;
                }
            };
            let bsz: u32 = a.element_size(s);
            match pkd_ssrle_format(p, bsz, sch.streams.borrow(s as i64).alphabet) {
                Result::Ok(_q) => {}
                Result::Err(_e) => {
                    assert(false, "alg: structure-stream format failed");
                }
            }
            let inner: *mut PkdAlloc = p as *mut PkdAlloc;
            inner.set_allocator(a as *const PkdAlloc);
        } else {
            let mut ord: u32 = PDT_ORD_UNORDERED;
            if sch.streams.borrow(s as i64).ordered {
                ord = PDT_ORD_MAX;
            }
            let mut dsc: PdtDescr = pdt_descr_new(1u32, ord, false);
            if kind == SK_VLE {
                dsc.dims.push(pdt_dim_vle(1u32));
            } else {
                // FSE and CHILD are both fixed cells; P0 narrows to u64
                assert(sch.streams.borrow(s as i64).width == 8u32,
                       "alg: FSE widths other than 8 await the width plane");
                dsc.dims.push(pdt_dim_fse(8u32));
            }
            let zero: Vec<u64> = pdt_payload_zero(&dsc);
            let need: u32 = pdtbuf_compute_block_size(&dsc, 0u64, &zero);
            let p: *mut u8 = match a.allocate(s, need, SlotKind::Allocatable) {
                Result::Ok(q) => q,
                Result::Err(_e) => {
                    assert(false, "alg: stream slot allocation failed");
                    return;
                }
            };
            let bsz: u32 = a.element_size(s);
            match pdtbuf_format(p, bsz, &dsc) {
                Result::Ok(_b) => {}
                Result::Err(_e) => {
                    assert(false, "alg: stream column format failed");
                }
            }
            let inner: *mut PkdAlloc = p as *mut PkdAlloc;
            inner.set_allocator(a as *const PkdAlloc);
        }
        s = s + 1u32;
    }
}

// ── pricing (law 1: exact — the SAME prepares that commit) ──────────────────

/// Price one atom against the CURRENT node state; Err = the atom cannot be
/// priced at all (malformed against the stream). Returns GROW bytes — the
/// parent-chain demand beyond the stream's own block.
unsafe fn alg_price_op(a: *mut PkdAlloc, sch: &NodeSchema, op: &NodeOp,
                       d: &LeafBatchDatum) -> Result<u32, PkdError> {
    let kind: u32 = sch.streams.borrow(op.stream as i64).kind;
    if kind == SK_SSRLE {
        let seq: PkdSsrle = st_seq(a, op.stream);
        let cur: u32 = a.element_size(op.stream);
        if op.op == OP_INS {
            let us: SsrleUpdate = seq.plan_insert(op.pos, &d.cols.borrow(op.datum as i64).runs);
            if us.block_size > cur {
                return Result::Ok(us.block_size - cur);
            }
            return Result::Ok(0u32);
        }
        if op.op == OP_DEL {
            // a remove can GROW the stream (mid-run splits) — priced, not assumed
            let us: SsrleUpdate = seq.plan_remove(op.pos, op.pos + op.n);
            if us.block_size > cur {
                return Result::Ok(us.block_size - cur);
            }
            return Result::Ok(0u32);
        }
        // UPD(SSRLE) = run edit. No consuming surface yet: structure streams
        // only ever GAIN/LOSE symbols (entry ins/del); lands with S3.
        assert(false, "alg: UPD on an SSRLE stream is not implemented");
        return Result::Err(PkdError::OutOfMem);
    }
    // FSE / VLE / CHILD all ride PdtBuf
    let pb: PdtBuf = st_pdt(a, op.stream);
    if op.op == OP_INS {
        if kind == SK_VLE {
            match pb.prepare_insert_vals(op.pos, op.n, PDT_CAP_KEEP,
                                         &d.cols.borrow(op.datum as i64).spans) {
                Result::Ok(u) => {
                    return Result::Ok(u.grow_bytes());
                }
                Result::Err(e) => {
                    return Result::Err(e);
                }
            }
        }
        match pb.prepare_insert(op.pos, op.n, PDT_CAP_KEEP) {
            Result::Ok(u) => {
                return Result::Ok(u.grow_bytes());
            }
            Result::Err(e) => {
                return Result::Err(e);
            }
        }
    }
    if op.op == OP_DEL {
        match pb.prepare_remove(op.pos, op.pos + op.n, PDT_CAP_KEEP) {
            Result::Ok(u) => {
                return Result::Ok(u.grow_bytes());
            }
            Result::Err(e) => {
                return Result::Err(e);
            }
        }
    }
    // UPD — the kind-optimal form (the algebra's UPD law):
    if kind == SK_VLE {
        // VLE replace: priced as an INSERT on the PRE-remove state — larger
        // than the post-remove insert the commit performs, so the commit
        // cannot fail into a value-lost partial state (law 2's discipline).
        match pb.prepare_insert_vals(op.pos, op.n, PDT_CAP_KEEP,
                                     &d.cols.borrow(op.datum as i64).spans) {
            Result::Ok(u) => {
                return Result::Ok(u.grow_bytes());
            }
            Result::Err(e) => {
                return Result::Err(e);
            }
        }
    }
    // FSE/CHILD: a cell set — O(1), no geometry motion, price 0
    return Result::Ok(0u32);
}

/// Price the whole batch (law 1). CONSERVATIVE composition: every atom is
/// priced against the PRE-batch state and the grows are summed. This bounds
/// the commit exactly when the batch has at most ONE growing atom per
/// stream — which the derived ENTRY_* forms guarantee; richer batches are
/// the builder's obligation until the kernel generator prices state chains.
pub unsafe fn alg_price(a: *mut PkdAlloc, sch: &NodeSchema, b: &NodeBatch,
                        d: &LeafBatchDatum) -> Result<u32, PkdError> {
    let mut total: u32 = 0u32;
    let mut i: i64 = 0i64;
    while i < b.ops.length() {
        match alg_price_op(a, sch, b.ops.borrow(i), d) {
            Result::Ok(g) => {
                total = total + g;
            }
            Result::Err(e) => {
                return Result::Err(e);
            }
        }
        i = i + 1i64;
    }
    return Result::Ok(total);
}

// ── commit ──────────────────────────────────────────────────────────────────

/// Commit one atom. Every prepare here was priced by alg_price against a
/// state at least as demanding, so failure is a builder-contract violation,
/// not a capacity condition — hence the asserts.
unsafe fn alg_commit_op(a: *mut PkdAlloc, sch: &NodeSchema, op: &NodeOp,
                        d: &LeafBatchDatum) {
    let kind: u32 = sch.streams.borrow(op.stream as i64).kind;
    if kind == SK_SSRLE {
        if op.op == OP_INS {
            let seq: PkdSsrle = st_seq(a, op.stream);
            let us: SsrleUpdate = seq.plan_insert(op.pos, &d.cols.borrow(op.datum as i64).runs);
            let mut seq2: PkdSsrle = st_seq(a, op.stream);
            seq2.commit(&us);
            return;
        }
        if op.op == OP_DEL {
            let seq: PkdSsrle = st_seq(a, op.stream);
            let us: SsrleUpdate = seq.plan_remove(op.pos, op.pos + op.n);
            let mut seq2: PkdSsrle = st_seq(a, op.stream);
            seq2.commit(&us);
            return;
        }
        assert(false, "alg: UPD on an SSRLE stream is not implemented");
        return;
    }
    if op.op == OP_INS {
        if kind == SK_VLE {
            let pb: PdtBuf = st_pdt(a, op.stream);
            let us: PdtUpdate = match pb.prepare_insert_vals(op.pos, op.n, PDT_CAP_KEEP,
                                                             &d.cols.borrow(op.datum as i64).spans) {
                Result::Ok(u) => u,
                Result::Err(_e) => {
                    assert(false, "alg: priced VLE insert failed at commit");
                    return;
                }
            };
            let mut pb2: PdtBuf = st_pdt(a, op.stream);
            pb2.commit_insert_vals(&us, &d.cols.borrow(op.datum as i64).spans);
            return;
        }
        let pb: PdtBuf = st_pdt(a, op.stream);
        let us: PdtUpdate = match pb.prepare_insert(op.pos, op.n, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "alg: priced FSE insert failed at commit");
                return;
            }
        };
        let mut pb2: PdtBuf = st_pdt(a, op.stream);
        pb2.commit_insert(&us, &d.cols.borrow(op.datum as i64).cells);
        return;
    }
    if op.op == OP_DEL {
        let pb: PdtBuf = st_pdt(a, op.stream);
        let us: PdtUpdate = match pb.prepare_remove(op.pos, op.pos + op.n, PDT_CAP_KEEP) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "alg: priced remove failed at commit");
                return;
            }
        };
        let mut pb2: PdtBuf = st_pdt(a, op.stream);
        pb2.commit_remove(&us);
        return;
    }
    // UPD
    if kind == SK_VLE {
        // remove THEN insert; the insert was priced on the PRE-remove state,
        // so it cannot fail here (the no-value-lost law)
        {
            let pb: PdtBuf = st_pdt(a, op.stream);
            let ur: PdtUpdate = match pb.prepare_remove(op.pos, op.pos + op.n, PDT_CAP_KEEP) {
                Result::Ok(u) => u,
                Result::Err(_e) => {
                    assert(false, "alg: VLE replace remove failed at commit");
                    return;
                }
            };
            let mut pb2: PdtBuf = st_pdt(a, op.stream);
            pb2.commit_remove(&ur);
        }
        let pb3: PdtBuf = st_pdt(a, op.stream);
        let ui: PdtUpdate = match pb3.prepare_insert_vals(op.pos, op.n, PDT_CAP_KEEP,
                                                          &d.cols.borrow(op.datum as i64).spans) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "alg: pre-remove-priced VLE insert failed at commit");
                return;
            }
        };
        let mut pb4: PdtBuf = st_pdt(a, op.stream);
        pb4.commit_insert_vals(&ui, &d.cols.borrow(op.datum as i64).spans);
        return;
    }
    // FSE/CHILD: the O(1) cell set — row j ← cells[j]
    let mut pb5: PdtBuf = st_pdt(a, op.stream);
    let mut j: u64 = 0u64;
    while j < op.n {
        pb5.set(0u32, op.pos + j, d.cols.borrow(op.datum as i64).cells.get(j as i64));
        j = j + 1u64;
    }
}

/// Apply a batch: price WHOLE → reject WHOLE if price exceeds the node's
/// free space (law 2 — no partial node states), else commit atoms in listed
/// order (law 3, the builder's order obligation), re-adopting every view at
/// every step (law 4). Returns false on rejection — the caller's cue to
/// split or to build subtrees.
pub unsafe fn alg_apply(a: *mut PkdAlloc, sch: &NodeSchema, b: &NodeBatch,
                        d: &LeafBatchDatum) -> bool {
    let price: u32 = match alg_price(a, sch, b, d) {
        Result::Ok(p) => p,
        Result::Err(_e) => {
            return false;
        }
    };
    if price > a.free_space() {
        return false;
    }
    let mut i: i64 = 0i64;
    while i < b.ops.length() {
        alg_commit_op(a, sch, b.ops.borrow(i), d);
        i = i + 1i64;
    }
    return true;
}

// ── derived forms: ENTRY space (ADR 0023 §Derived forms, law 5) ─────────────
//
// Batches below are specified at an ENTRY position i0 (a stream-0 row index)
// and LOWERED to per-stream positions by the structure stream's rank
// projection — the projection homomorphism made code, generalizing what
// btfl_step hand-rolled. A schema WITHOUT a structure stream is the
// single-stream degenerate case: every stream carries exactly one row per
// entry and the projection is the identity.

/// The schema's structure stream, or -1 if the node is single-stream.
fn alg_sseq_stream(sch: &NodeSchema) -> i64 {
    let mut s: i64 = 0i64;
    while s < sch.streams.length() {
        if sch.streams.borrow(s).kind == SK_SSRLE {
            return s;
        }
        s = s + 1i64;
    }
    return -1i64;
}

/// Rows datum column `col` carries for a stream of kind `kind`.
fn alg_col_rows(kind: u32, col: &DatumCol) -> u64 {
    if kind == SK_VLE {
        return col.spans.lens.length() as u64;
    }
    return col.cells.length() as u64;
}

/// Symbols `k` repeated rows[k] times, packed to runs — the entry's
/// structure segment from its per-data-stream row counts. Shared by the
/// entry forms here and by GENERATED kernels (the placement rule: runtime
/// ops live in the stdlib, generation is the wiring).
pub fn alg_runs_from_rows(bps: u32, rows: &Vec<u64>) -> Vec<SsrleRun> {
    let mut syms: Vec<u64> = vec_new::<u64>();
    let mut k: i64 = 0i64;
    while k < rows.length() {
        let m: u64 = rows.get(k);
        let mut j: u64 = 0u64;
        while j < m {
            syms.push(k as u64);
            j = j + 1u64;
        }
        k = k + 1i64;
    }
    return ssrle_runs_from_symbols(bps, &syms);
}

/// The structure position of entry `i0` (seq.size() when appending) — the
/// anchor every per-stream position projects from.
pub unsafe fn alg_entry_anchor(a: *mut PkdAlloc, ss: u32, i0: u64) -> u64 {
    let seq: PkdSsrle = st_seq(a, ss);
    let kc: u64 = seq.rank_eq_all(0u64);
    if i0 < kc {
        return seq.select_fw_eq(i0, 0u64).idx;
    }
    return seq.size();
}

/// ENTRY_INS: insert one logical entry at entry position `i0`. `d` carries
/// one column PER STREAM, positionally (op.datum = stream index); the
/// structure column's runs are DERIVED here from the data columns' row
/// counts and written into `d` — hence the &mut. Ops are ordered
/// data-first, structure LAST (law 3).
pub unsafe fn alg_entry_ins(a: *mut PkdAlloc, sch: &NodeSchema, i0: u64,
                            d: &mut LeafBatchDatum) -> bool {
    let ss: i64 = alg_sseq_stream(sch);
    let mut b: NodeBatch = node_batch_new();
    if ss < 0i64 {
        // single-stream: one row per stream at i0
        let mut s: i64 = 0i64;
        while s < sch.streams.length() {
            let kind: u32 = sch.streams.borrow(s).kind;
            assert(alg_col_rows(kind, d.cols.borrow(s)) == 1u64,
                   "alg: single-stream entry carries exactly one row per stream");
            b.ops.push(op_ins(s as u32, i0, 1u64, s as u32));
            s = s + 1i64;
        }
        return alg_apply(a, sch, &b, &(*d));
    }
    // multi-stream: project through the structure anchor, derive the runs
    let anchor: u64 = alg_entry_anchor(a, ss as u32, i0);
    let mut syms: Vec<u64> = vec_new::<u64>();
    let mut s2: i64 = 0i64;
    while s2 < sch.streams.length() {
        if s2 != ss {
            let kind2: u32 = sch.streams.borrow(s2).kind;
            let m: u64 = alg_col_rows(kind2, d.cols.borrow(s2));
            if s2 == 0i64 {
                assert(m == 1u64, "alg: entry stream 0 carries exactly one row");
                b.ops.push(op_ins(0u32, i0, 1u64, 0u32));
            } else if m > 0u64 {
                let v: u64 = st_seq(a, ss as u32).rank_eq(anchor, s2 as u64);
                b.ops.push(op_ins(s2 as u32, v, m, s2 as u32));
            }
            let mut j: u64 = 0u64;
            while j < m {
                syms.push(s2 as u64);
                j = j + 1u64;
            }
        }
        s2 = s2 + 1i64;
    }
    {
        let sc: &mut DatumCol = d.cols.borrow_mut(ss);
        sc.runs = ssrle_runs_from_symbols(st_seq(a, ss as u32).bps(), &syms);
    }
    b.ops.push(op_ins(ss as u32, anchor, syms.length() as u64, ss as u32));
    return alg_apply(a, sch, &b, &(*d));
}

/// ENTRY_DEL: remove the logical entry at entry position `i0` — every
/// stream's projected row window, the structure segment LAST.
pub unsafe fn alg_entry_del(a: *mut PkdAlloc, sch: &NodeSchema, i0: u64) -> bool {
    let ss: i64 = alg_sseq_stream(sch);
    let mut b: NodeBatch = node_batch_new();
    let dd: LeafBatchDatum = leaf_batch_datum_new();
    if ss < 0i64 {
        let mut s: i64 = 0i64;
        while s < sch.streams.length() {
            b.ops.push(op_del(s as u32, i0, 1u64));
            s = s + 1i64;
        }
        return alg_apply(a, sch, &b, &dd);
    }
    let p0: u64 = alg_entry_anchor(a, ss as u32, i0);
    let p1: u64 = alg_entry_anchor(a, ss as u32, i0 + 1u64);
    let mut s2: i64 = 0i64;
    while s2 < sch.streams.length() {
        if s2 != ss {
            let seq: PkdSsrle = st_seq(a, ss as u32);
            let v0: u64 = seq.rank_eq(p0, s2 as u64);
            let v1: u64 = seq.rank_eq(p1, s2 as u64);
            let mut m: u64 = v1 - v0;
            if s2 == 0i64 {
                m = 1u64;   // the entry's own stream-0 row
            }
            if m > 0u64 {
                b.ops.push(op_del(s2 as u32, v0, m));
            }
        }
        s2 = s2 + 1i64;
    }
    b.ops.push(op_del(ss as u32, p0, p1 - p0));
    return alg_apply(a, sch, &b, &dd);
}

/// ENTRY_SET: replace the entry's data rows in place — the same-arity form
/// (per stream, the datum's row count equals the entry's current window;
/// arity CHANGES are ENTRY_DEL + ENTRY_INS, the structure stream moves).
/// UPD's kind-optimal forms apply per stream.
pub unsafe fn alg_entry_set(a: *mut PkdAlloc, sch: &NodeSchema, i0: u64,
                            d: &LeafBatchDatum) -> bool {
    let ss: i64 = alg_sseq_stream(sch);
    let mut b: NodeBatch = node_batch_new();
    let mut s: i64 = 0i64;
    while s < sch.streams.length() {
        if s != ss {
            let kind: u32 = sch.streams.borrow(s).kind;
            let col: &DatumCol = d.cols.borrow(s);
            let m: u64 = alg_col_rows(kind, col);
            if m > 0u64 {
                let mut v: u64 = i0;
                if ss >= 0i64 && s != 0i64 {
                    let anchor: u64 = alg_entry_anchor(a, ss as u32, i0);
                    v = st_seq(a, ss as u32).rank_eq(anchor, s as u64);
                }
                let mut o: NodeOp = op_upd(s as u32, v, s as u32);
                o.n = m;
                b.ops.push(o);
            }
        }
        s = s + 1i64;
    }
    return alg_apply(a, sch, &b, d);
}

/// The WITH_ENTRY executor: commit one quad TRANSITION at entry position
/// `i0`. The user fn (Option<State> → Option<State>) runs ABOVE this, at
/// the typed surface that owns the views; here only its collapsed verdict
/// arrives. UPSERT = ET_INS on miss / ET_SET on hit.
pub unsafe fn alg_entry_apply(a: *mut PkdAlloc, sch: &NodeSchema, i0: u64,
                              et: u32, d: &mut LeafBatchDatum) -> bool {
    if et == ET_NOOP {
        return true;
    }
    if et == ET_INS {
        return alg_entry_ins(a, sch, i0, d);
    }
    if et == ET_SET {
        return alg_entry_set(a, sch, i0, &(*d));
    }
    if et == ET_DEL {
        return alg_entry_del(a, sch, i0);
    }
    assert(false, "alg: unknown entry transition");
    return false;
}
