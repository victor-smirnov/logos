// logos.mem.bt.pack — the batch-insert WEIGHT CALCULUS (slice 0 of the
// two-stage batch insert).
//
// The design (PAIR, 2026-07-24): batch insert = (1) encode application data
// into a STAGING buffer that is already the physical column format (PdtBuf
// columns + an SsrleRun list for the structure stream), then (2) cut the
// staging into leaf-sized fragments. The cut is chosen by PRE-ESTIMATION,
// never by trial insertion: this module answers "what does a fresh block
// holding staging range [i0, i0+k) cost, exactly, in bytes" from the
// staging's own prefix geometry — zero mutations, zero restores.
//
// WHY THIS IS SOUND (the proof obligation Victor set): the pricing law the
// substrate already enforces — `pdtbuf_compute_block_size` is the PREPARED
// side, `consumed_bytes` the CONSUMED side, and prepare/commit reach the
// priced geometry EXACTLY under both capacity policies (the P4 resolution:
// geometry is DERIVED, never estimated). This module adds no new knowledge:
// it evaluates the SAME pure pricing functions on range arguments. The
// restriction (where this breaks): stream encodings must have an
// O(1)-summarizable size state — FSE (row count), VLE (byte-offset prefix
// sums, P7), SSRLE (run list) all qualify; dictionary/adaptive-entropy
// codecs would not (their "summary" is the compressor state — for such a
// kind the packer falls back to clean-fail prepare, which the two-phase
// discipline makes restore-free anyway).
//
// The gate (conuco pack_weight) pins BYTE EQUALITY: weight(range) ==
// consumed bytes of the materialized block, across randomized content and
// cuts, for all three kinds. Any drift — even one byte — fails the gate.
//
// VLE entry bound (Victor): a single entry may not exceed 1/4 of the
// MAXIMUM block size; larger entries are rejected AT THE STAGING BOUNDARY
// (stage 1), so the packer may rely on the invariant. Blocks are 4K today,
// 4K..1M in the Memoria plan — the bound rides StoreCfg, not this module.
package logos.mem.bt.pack;

use logos.mem.pkd;               // PkdAlloc — slot rounding / region overhead
use logos.mem.pkd.pdtbuf;        // PdtBuf + pdtbuf_compute_block_size (the oracle)
use logos.mem.pkd.sseq;          // pkd_ssrle_block_size — structure-stream price
use logos.mem.pkd.ssrle;         // SsrleRun + ssrle_compute_size
use logos.mem.bt.node;           // NodeProfile — the map splice's node seam
use logos.mem.bt.memstore;       // MemorySnapshot + tree_release (CoW discipline)
use logos.mem.collections.vec;
use logos.lang.mem;              // alloc/dealloc/copy_bytes — staging + privatize
use logos.lang.slice;            // slice_from_raw — span reads without a local-borrow chain
use logos.lang.result;
use logos.lang.panic;

// ── PdtBuf columns (FSE / VLE) ──────────────────────────────────────────────

/// VLE payload geometry of staging rows [i0, i0+k): one entry per
/// (column, VLE dimension) in payload_slot order — byte-offset differences
/// (the P7 prefix sums). All-FSE descriptors yield the empty vector.
pub fn pack_range_payload(b: &PdtBuf, i0: u64, k: u64) -> Vec<u64> {
    let mut out: Vec<u64> = vec_new::<u64>();
    let cols: u32 = b.columns();
    let dims: u32 = b.dim_count();
    let mut c: u32 = 0u32;
    while c < cols {
        let mut d: u32 = 0u32;
        while d < dims {
            if b.dim_at(d).kind == PDT_DIM_VLE {
                out.push(b.row_offset(c, d, i0 + k) - b.row_offset(c, d, i0));
            }
            d = d + 1u32;
        }
        c = c + 1u32;
    }
    return out;
}

/// EXACT price (bytes) of a fresh block holding staging rows [i0, i0+k) at
/// capacity k — the same pure function the two-phase machinery prices
/// mutations with, evaluated on range arguments. O(1) beyond the payload
/// walk (row_offset reads on the staging's live offsets).
pub fn pack_col_weight(b: &PdtBuf, i0: u64, k: u64) -> u32 {
    assert(i0 + k <= b.size(), "pack: weight range beyond the staging buffer");
    let d: PdtDescr = b.descr();
    let pay: Vec<u64> = pack_range_payload(b, i0, k);
    return pdtbuf_compute_block_size(&d, k, &pay);
}

// ── the structure stream (SSRLE run list) ───────────────────────────────────

// Append `sym` × `n` to a run list, merging into the tail when the tail is a
// single-symbol run of the same symbol (the staging normal form: every run a
// single-symbol pattern — what alg_runs_from_rows produces entry by entry).
fn pack_runs_push(bps: u32, out: &mut Vec<SsrleRun>, sym: u64, n: u64) {
    if n == 0u64 {
        return;
    }
    let ln: i64 = out.length();
    if ln > 0i64 {
        // SsrleRun is Copy — take the tail by value so no shared borrow of
        // `out` survives into the set below.
        let last: SsrleRun = out.get(ln - 1i64);
        if last.pattern_length == 1u32 && last.symbol(bps, 0u64) == sym {
            let grown: u64 = last.run_length + n;
            if ssrle_is_fit(bps, 1u64, grown) {
                out.set(ln - 1i64, ssrle_run_new(bps, 1u32, sym, grown));
                return;
            }
        }
    }
    let mut rem: u64 = n;
    let cap: u64 = ssrle_max_run_length(bps, 1u32);
    while rem > 0u64 {
        let take: u64 = if rem > cap { cap } else { rem };
        out.push(ssrle_run_new(bps, 1u32, sym, take));
        rem = rem - take;
    }
}

/// Cut a SINGLE-SYMBOL-pattern run list at symbol range [p0, p0+k) — the
/// staging normal form (each run = one symbol repeated; multi-symbol
/// patterns are a later staging optimization and would extend the cut to
/// partial patterns). Boundary runs shrink; middle runs pass through.
pub fn pack_runs_cut(bps: u32, runs: &Vec<SsrleRun>, p0: u64, k: u64) -> Vec<SsrleRun> {
    let mut out: Vec<SsrleRun> = vec_new::<SsrleRun>();
    if k == 0u64 {
        return out;
    }
    let mut pos: u64 = 0u64;
    let mut i: i64 = 0i64;
    let end: u64 = p0 + k;
    while i < runs.length() && pos < end {
        let r: &SsrleRun = runs.borrow(i);
        assert(r.pattern_length == 1u32,
               "pack_runs_cut: staging runs must be single-symbol patterns");
        let len: u64 = r.full_run_length();
        let rend: u64 = pos + len;
        if rend > p0 {
            // Overlap [lo, hi) of this run with the cut window.
            let lo: u64 = if pos > p0 { pos } else { p0 };
            let hi: u64 = if rend < end { rend } else { end };
            pack_runs_push(bps, &mut out, r.symbol(bps, 0u64), hi - lo);
        }
        pos = rend;
        i = i + 1i64;
    }
    assert(pos >= end, "pack_runs_cut: symbol range beyond the staging run list");
    return out;
}

/// Total symbol count of a run list (the staging structure length).
pub fn pack_runs_len(runs: &Vec<SsrleRun>) -> u64 {
    let mut n: u64 = 0u64;
    let mut i: i64 = 0i64;
    while i < runs.length() {
        n = n + runs.borrow(i).full_run_length();
        i = i + 1i64;
    }
    return n;
}

/// EXACT price (bytes) of a fresh structure-stream block holding `runs` —
/// segment-aware code units through the same size function set_runs pins
/// (`writer diverged from compute_size` is its own internal assert), then
/// the block price incl. index layers.
pub fn pack_seq_weight(alphabet: u32, runs: &Vec<SsrleRun>) -> u32 {
    let bps: u32 = ssrle_bps_for_alphabet(alphabet);
    let units: u64 = ssrle_compute_size(bps, runs, 0u64);
    return pkd_ssrle_block_size(alphabet, units);
}

// ── the node region ─────────────────────────────────────────────────────────

/// Price of a node's PkdAlloc REGION holding slots of the given weights:
/// the allocator's own overhead plus each slot rounded to the 8-byte
/// granularity `allocate` actually hands out. The node HEADER (MemNode) is
/// the store's business — NodeProfile::alloc takes the TOTAL block size, so
/// the packer adds the profile's header size on top of this.
pub fn pack_region_weight(ws: &Vec<u32>) -> u32 {
    let mut total: u32 = PkdAlloc::empty_size_for(ws.length() as u32);
    let mut i: i64 = 0i64;
    while i < ws.length() {
        total = total + round_up_bytes(ws.get(i));
        i = i + 1i64;
    }
    return total;
}

// ════════════════════════════════════════════════════════════════════════════
// The MAP batch (the btss family: single-stream ordered K/V) — slice 2.
//
// Same two-stage shape as the Vector packer, plus the three things a sorted
// keyed container adds: (a) the insertion point comes from a KEY descent,
// not a position; (b) the batch must be strictly-ascending and must land
// WHOLE between two adjacent existing keys (checked read-only BEFORE any
// mutation — an interleaving batch is REJECTED, the general merge is a
// later op); (c) the walk is CoW — every touched node is privatized to the
// current snapshot first, the raw-region form of bt_leaf_private (the
// region bytes are position-independent by the packed-family discipline, so
// privatize = fresh node + region byte-copy + child rc bumps).
//
// Cells are u64 at rest; key COMPARISONS take the family's signedness
// verdict (a blind u64 compare would invert negative signed keys — the
// btss sign discipline). The generated family owns the K/V casts.

// sign-aware strict less-than over key cells
fn pk_lt(a: u64, b: u64, signed: bool) -> bool {
    if signed {
        return (a as i64) < (b as i64);
    }
    return a < b;
}

// ── the staging buffer ──────────────────────────────────────────────────────

/// The map staging: two heap columns in the leaf's physical format — keys
/// (FSE64) + values (FSE64 or VLE). The container's make_buffer product;
/// RAII-owned, grows by doubling.
pub struct BtssBuf {
    kmem: *mut u8,
    vmem: *mut u8,
    cap_rows: u64,
    vle: bool,
}

fn pk_key_descr() -> PdtDescr {
    let mut d: PdtDescr = pdt_descr_new(1u32, PDT_ORD_UNORDERED, false);
    d.dims.push(pdt_dim_fse(8u32));
    return d;
}

fn pk_val_descr(vle: bool) -> PdtDescr {
    let mut d: PdtDescr = pdt_descr_new(1u32, PDT_ORD_UNORDERED, false);
    if vle {
        d.dims.push(pdt_dim_vle(1u32));
    } else {
        d.dims.push(pdt_dim_fse(8u32));
    }
    return d;
}

fn pk_col_new(d: &PdtDescr, cap_rows: u64, payload: u64) -> *mut u8 {
    let mut pay: Vec<u64> = vec_new::<u64>();
    if d.vle_dim_count() > 0u32 {
        pay.push(payload);
    }
    let bytes: u32 = pdtbuf_compute_block_size(d, cap_rows, &pay);
    let mem: *mut u8 = alloc(bytes as i64);
    unsafe {
        match pdtbuf_format(mem, bytes, d) {
            Result::Ok(b0) => {
                let mut b: PdtBuf = b0;
                match b.reserve_geom(cap_rows, &pay) {
                    Result::Ok(_u) => {}
                    Result::Err(_e) => {
                        assert(false, "btss_buf: staging reserve failed");
                    }
                }
                // reserve_geom moves size; keep it a REServation, not rows
                let mut b2: PdtBuf = pdtbuf_adopt(mem);
                b2.set_size(0u64);
            }
            Result::Err(_e) => {
                assert(false, "btss_buf: staging format failed");
            }
        }
    }
    return mem;
}

/// A fresh map staging buffer (`vle` = the family's value-column verdict).
pub fn btss_buf_new(vle: bool, cap_rows: u64) -> BtssBuf {
    let mut cap: u64 = cap_rows;
    if cap < 16u64 {
        cap = 16u64;
    }
    let kd: PdtDescr = pk_key_descr();
    let vd: PdtDescr = pk_val_descr(vle);
    return BtssBuf {
        kmem: pk_col_new(&kd, cap, 0u64),
        vmem: pk_col_new(&vd, cap, if vle { cap * 16u64 } else { 0u64 }),
        cap_rows: cap,
        vle: vle,
    };
}

impl BtssBuf {
    unsafe fn kb(self: &BtssBuf) -> PdtBuf {
        return pdtbuf_adopt(self.kmem);
    }
    unsafe fn vb(self: &BtssBuf) -> PdtBuf {
        return pdtbuf_adopt(self.vmem);
    }
    pub fn len(self: &BtssBuf) -> u64 {
        return unsafe { self.kb().size() };
    }
    pub fn is_vle(self: &BtssBuf) -> bool {
        return self.vle;
    }
    pub fn key(self: &BtssBuf, i: u64) -> u64 {
        return unsafe { self.kb().get(0u32, i) };
    }
    pub fn val_cell(self: &BtssBuf, i: u64) -> u64 {
        return unsafe { self.vb().get(0u32, i) };
    }
    pub fn val_span(self: &BtssBuf, i: u64) -> &[u8] {
        // Built from raw parts: a row_span through the LOCAL PdtBuf view
        // would borrow the local (the dangling-view class the cursor hit);
        // the span's real provenance is the heap block self owns.
        unsafe {
            let b: PdtBuf = self.vb();
            let off: u64 = b.row_offset(0u32, 0u32, i);
            let len: u64 = b.row_len(0u32, 0u32, i);
            return slice_from_raw::<u8>(b.payload(0u32, 0u32).byte_add(off as i64), len as i64);
        }
    }

    fn push_key(self: &mut BtssBuf, k: u64) {
        unsafe {
            let n: u64 = self.kb().size();
            let us: PdtUpdate = match self.kb().prepare_insert(n, 1u64, PDT_CAP_KEEP) {
                Result::Ok(u) => u,
                Result::Err(_e) => {
                    assert(false, "btss_buf: key push prepare failed (grow contract)");
                    return;
                }
            };
            let mut row: Vec<u64> = vec_new::<u64>();
            row.push(k);
            let mut b: PdtBuf = self.kb();
            b.commit_insert(&us, &row);
        }
    }

    /// Append one (key, FSE value) row.
    pub fn push_cell(self: &mut BtssBuf, k: u64, v: u64) {
        assert(!self.vle, "btss_buf: push_cell on a VLE-valued buffer");
        unsafe {
            if self.kb().size() == self.cap_rows {
                self.grow(0u64);
            }
            self.push_key(k);
            let n: u64 = self.vb().size();
            let us: PdtUpdate = match self.vb().prepare_insert(n, 1u64, PDT_CAP_KEEP) {
                Result::Ok(u) => u,
                Result::Err(_e) => {
                    assert(false, "btss_buf: val push prepare failed (grow contract)");
                    return;
                }
            };
            let mut row: Vec<u64> = vec_new::<u64>();
            row.push(v);
            let mut b: PdtBuf = self.vb();
            b.commit_insert(&us, &row);
        }
    }

    /// Append one (key, VLE value) row.
    pub fn push_span(self: &mut BtssBuf, k: u64, v: &[u8]) {
        assert(self.vle, "btss_buf: push_span on an FSE-valued buffer");
        unsafe {
            if self.kb().size() == self.cap_rows {
                self.grow(v.len() as u64);
            }
            let n: u64 = self.vb().size();
            let mut vals: PdtVals = pdt_vals_new();
            vals.push_span(v);
            let mut committed: bool = false;
            while !committed {
                let vbv: PdtBuf = self.vb();
                match vbv.prepare_insert_vals(n, 1u64, PDT_CAP_KEEP, &vals) {
                    Result::Ok(us) => {
                        let mut b: PdtBuf = self.vb();
                        b.commit_insert_vals(&us, &vals);
                        committed = true;
                    }
                    Result::Err(_e) => {
                        // payload outgrew the value block — double and retry
                        self.grow(v.len() as u64);
                    }
                }
            }
            self.push_key(k);
        }
    }

    fn grow(self: &mut BtssBuf, extra_payload: u64) {
        unsafe {
            let kd: PdtDescr = pk_key_descr();
            let vd: PdtDescr = pk_val_descr(self.vle);
            let n: u64 = self.kb().size();
            let ncap: u64 = self.cap_rows * 2u64;
            let mut npay: u64 = 0u64;
            if self.vle {
                npay = self.vb().payload_used(0u32, 0u32) * 2u64 + extra_payload + 64u64;
            }
            // keys: rebuild into the doubled block
            let nk: *mut u8 = pk_col_new(&kd, ncap, 0u64);
            {
                let src: PdtBuf = self.kb();
                let dst: PdtBuf = pdtbuf_adopt(nk);
                let us: PdtUpdate = match dst.prepare_insert(0u64, n, PDT_CAP_KEEP) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "btss_buf: key grow prepare failed");
                        return;
                    }
                };
                let mut cells: Vec<u64> = vec_new::<u64>();
                let mut i: u64 = 0u64;
                while i < n {
                    cells.push(src.get(0u32, i));
                    i = i + 1u64;
                }
                let mut dst2: PdtBuf = pdtbuf_adopt(nk);
                dst2.commit_insert(&us, &cells);
            }
            // values: cells or spans
            let vn: u64 = self.vb().size();
            let nv: *mut u8 = pk_col_new(&vd, ncap, npay);
            if self.vle {
                let src: PdtBuf = self.vb();
                let mut vals: PdtVals = pdt_vals_new();
                let mut i: u64 = 0u64;
                while i < vn {
                    vals.push_span(src.row_span(0u32, 0u32, i));
                    i = i + 1u64;
                }
                let dst: PdtBuf = pdtbuf_adopt(nv);
                let us: PdtUpdate = match dst.prepare_insert_vals(0u64, vn, PDT_CAP_KEEP, &vals) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "btss_buf: val grow prepare failed");
                        return;
                    }
                };
                let mut dst2: PdtBuf = pdtbuf_adopt(nv);
                dst2.commit_insert_vals(&us, &vals);
            } else {
                let src: PdtBuf = self.vb();
                let dst: PdtBuf = pdtbuf_adopt(nv);
                let us: PdtUpdate = match dst.prepare_insert(0u64, vn, PDT_CAP_KEEP) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "btss_buf: val grow prepare failed");
                        return;
                    }
                };
                let mut cells: Vec<u64> = vec_new::<u64>();
                let mut i: u64 = 0u64;
                while i < vn {
                    cells.push(src.get(0u32, i));
                    i = i + 1u64;
                }
                let mut dst2: PdtBuf = pdtbuf_adopt(nv);
                dst2.commit_insert(&us, &cells);
            }
            dealloc(self.kmem);
            dealloc(self.vmem);
            self.kmem = nk;
            self.vmem = nv;
            self.cap_rows = ncap;
        }
    }

    /// Strictly-ascending key check under the sign verdict (the batch
    /// contract; O(m), run once per insert).
    pub fn is_sorted(self: &BtssBuf, signed: bool) -> bool {
        let n: u64 = self.len();
        let mut i: u64 = 1u64;
        while i < n {
            if !pk_lt(self.key(i - 1u64), self.key(i), signed) {
                return false;
            }
            i = i + 1u64;
        }
        return true;
    }
}

impl Drop for BtssBuf {
    fn drop(&mut self) {
        unsafe {
            dealloc(self.kmem);
            dealloc(self.vmem);
        }
    }
}

// ── raw node helpers (the btss uniform shapes) ──────────────────────────────

// leaf slots: 0 = keys (MAX-ordered), 1 = values; branch slots: 0 = sep
// (MAX), 1 = subtree count, 2 = child refs (declared in the header).
const PKB_SEP:   u32 = 0u32;
const PKB_CNT:   u32 = 1u32;
const PKB_CHILD: u32 = 2u32;

unsafe fn pk_slot(a: *mut PkdAlloc, s: u32) -> PdtBuf {
    return pdtbuf_adopt(a.get::<u8>(s));
}

// Format slot `s` of a node region from an explicit descriptor at the
// capacity-0 geometry (the donor-shape form of btss_fmt_slot).
unsafe fn pk_fmt_slot(a: *mut PkdAlloc, s: u32, d: &PdtDescr) {
    let zero: Vec<u64> = pdt_payload_zero(d);
    let need: u32 = pdtbuf_compute_block_size(d, 0u64, &zero);
    let p: *mut u8 = match a.allocate(s, need, SlotKind::Allocatable) {
        Result::Ok(q) => q,
        Result::Err(_e) => {
            assert(false, "pack: node slot allocation failed");
            return;
        }
    };
    let bsz: u32 = a.element_size(s);
    match pdtbuf_format(p, bsz, d) {
        Result::Ok(_b) => {}
        Result::Err(_e) => {
            assert(false, "pack: node slot format failed");
        }
    }
    let inner: *mut PkdAlloc = p as *mut PkdAlloc;
    inner.set_allocator(a as *const PkdAlloc);
}

// Fresh empty leaf shaped LIKE the donor (same block size, same column
// descriptors read off the self-describing donor slots).
fn pk_leaf_new_like<P: NodeProfile>(donor: *mut u8, snp: u64) -> *mut u8 {
    unsafe {
        let da: *mut PkdAlloc = P::pkd(donor);
        let kd: PdtDescr = pk_slot(da, 0u32).descr();
        let vd: PdtDescr = pk_slot(da, 1u32).descr();
        let node: *mut u8 = P::alloc(P::block_size(donor), 2u32, snp);
        let a: *mut PkdAlloc = P::pkd(node);
        pk_fmt_slot(a, 0u32, &kd);
        pk_fmt_slot(a, 1u32, &vd);
        return node;
    }
}

// Fresh empty 3-slot branch (the uniform btss branch shape).
fn pk_branch_new<P: NodeProfile>(snp: u64, branch_bytes: u32) -> *mut u8 {
    unsafe {
        let node: *mut u8 = P::alloc(branch_bytes, 3u32, snp);
        P::set_child_slot(node, PKB_CHILD);
        let a: *mut PkdAlloc = P::pkd(node);
        btss_fmt_slot(a, PKB_SEP, false, true);
        btss_fmt_slot(a, PKB_CNT, false, false);
        btss_fmt_slot(a, PKB_CHILD, false, false);
        return node;
    }
}

// "Make `node` privately writable under snapshot `cur`" — the RAW-region
// form of bt_leaf_private/bt_branch_private: fresh node, region byte-copy
// (the packed family's region is position-independent — the CoW-clone-unit
// law), child_slot restored, children rc-bumped for a branch. The fresh
// header (rc = 1, snap = cur) comes from P::alloc.
fn pk_private<P: NodeProfile>(node: *mut u8, cur: u64, is_branch: bool) -> *mut u8 {
    unsafe {
        if P::snapshot(node) == cur {
            return node;
        }
        let sa: *mut PkdAlloc = P::pkd(node);
        let n: *mut u8 = P::alloc(P::block_size(node), sa.elements(), cur);
        let da: *mut PkdAlloc = P::pkd(n);
        copy_bytes(da as *mut u8, sa as *const u8, sa.block_size() as i64);
        P::set_child_slot(n, P::child_slot(node));
        if is_branch {
            let cb: PdtBuf = pk_slot(P::pkd(n), PKB_CHILD);
            let cc: u64 = cb.size();
            let mut i: u64 = 0u64;
            while i < cc {
                P::inc_rc(cb.get(0u32, i) as *mut u8);
                i = i + 1u64;
            }
        }
        return n;
    }
}

// ── the merged read view: leaf prefix ++ staging ++ leaf suffix ─────────────

struct PkMerged {
    leaf: *mut u8,
    split: u64,
    lcount: u64,
    kbuf: *mut u8,
    vbuf: *mut u8,
    bcount: u64,
    vle: bool,
}

fn pk_merged_len(m: &PkMerged) -> u64 {
    return m.lcount + m.bcount;
}

fn pk_merged_key<P: NodeProfile>(m: &PkMerged, i: u64) -> u64 {
    unsafe {
        if i < m.split {
            return pk_slot(P::pkd(m.leaf), 0u32).get(0u32, i);
        }
        if i < m.split + m.bcount {
            return pdtbuf_adopt(m.kbuf).get(0u32, i - m.split);
        }
        return pk_slot(P::pkd(m.leaf), 0u32).get(0u32, i - m.bcount);
    }
}

fn pk_merged_val_cell<P: NodeProfile>(m: &PkMerged, i: u64) -> u64 {
    unsafe {
        if i < m.split {
            return pk_slot(P::pkd(m.leaf), 1u32).get(0u32, i);
        }
        if i < m.split + m.bcount {
            return pdtbuf_adopt(m.vbuf).get(0u32, i - m.split);
        }
        return pk_slot(P::pkd(m.leaf), 1u32).get(0u32, i - m.bcount);
    }
}

fn pk_merged_val_span<P: NodeProfile>(m: &PkMerged, i: u64) -> &[u8] {
    // Raw-parts construction (see BtssBuf::val_span) — the provenance is the
    // leaf block / staging block, not the local PdtBuf view.
    unsafe {
        let mut b: PdtBuf = pk_slot(P::pkd(m.leaf), 1u32);
        let mut r: u64 = i;
        if i >= m.split && i < m.split + m.bcount {
            b = pdtbuf_adopt(m.vbuf);
            r = i - m.split;
        } else if i >= m.split + m.bcount {
            r = i - m.bcount;
        }
        let off: u64 = b.row_offset(0u32, 0u32, r);
        let len: u64 = b.row_len(0u32, 0u32, r);
        return slice_from_raw::<u8>(b.payload(0u32, 0u32).byte_add(off as i64), len as i64);
    }
}

// VLE payload bytes of merged rows [i0, i0+r) — piecewise off the two
// sources' live byte-offset prefix sums (segment-additive: the A1 axiom).
fn pk_merged_payload<P: NodeProfile>(m: &PkMerged, i0: u64, r: u64) -> u64 {
    unsafe {
        let lb: PdtBuf = pk_slot(P::pkd(m.leaf), 1u32);
        let bb: PdtBuf = pdtbuf_adopt(m.vbuf);
        let e: u64 = i0 + r;
        let mut total: u64 = 0u64;
        // segment 1: leaf prefix rows [0, split)
        if i0 < m.split {
            let hi: u64 = if e < m.split { e } else { m.split };
            total = total + lb.row_offset(0u32, 0u32, hi) - lb.row_offset(0u32, 0u32, i0);
        }
        // segment 2: staging rows [split, split+bcount)
        let s2lo: u64 = if i0 > m.split { i0 } else { m.split };
        let s2hi: u64 = if e < m.split + m.bcount { e } else { m.split + m.bcount };
        if s2lo < s2hi {
            total = total + bb.row_offset(0u32, 0u32, s2hi - m.split)
                          - bb.row_offset(0u32, 0u32, s2lo - m.split);
        }
        // segment 3: leaf suffix rows [split+bcount, ...)
        let s3lo: u64 = if i0 > m.split + m.bcount { i0 } else { m.split + m.bcount };
        if s3lo < e {
            total = total + lb.row_offset(0u32, 0u32, e - m.bcount)
                          - lb.row_offset(0u32, 0u32, s3lo - m.bcount);
        }
        return total;
    }
}

// ── the splice ──────────────────────────────────────────────────────────────

// One parent row of the map splice report: (separator, count, child).
struct PkRow {
    sep: u64,
    cnt: u64,
    ptr: *mut u8,
}

// Max merged rows a fresh donor-shaped leaf admits within `budget` bytes,
// for the fragment starting at merged row `done` — binary search over the
// monotone range weight (keys FSE + values FSE/VLE via the merged payload).
fn pk_leaf_rows_cap<P: NodeProfile>(m: &PkMerged, done: u64, remaining: u64,
                                    kd: &PdtDescr, vd: &PdtDescr, budget: u32) -> u64 {
    let zero: Vec<u64> = pdt_payload_zero(kd);
    let mut lo: u64 = 1u64;
    let mut hi: u64 = remaining;
    while lo < hi {
        let mid: u64 = (lo + hi + 1u64) / 2u64;
        let kw: u32 = pdtbuf_compute_block_size(kd, mid, &zero);
        let mut vpay: Vec<u64> = vec_new::<u64>();
        if m.vle {
            vpay.push(pk_merged_payload::<P>(m, done, mid));
        }
        let vw: u32 = pdtbuf_compute_block_size(vd, mid, &vpay);
        let mut ws: Vec<u32> = vec_new::<u32>();
        ws.push(kw);
        ws.push(vw);
        if pack_region_weight(&ws) <= budget {
            lo = mid;
        } else {
            hi = mid - 1u64;
        }
    }
    return lo;
}

// Pack the merged sequence into fresh donor-shaped leaves at the 90% fill
// target; one two-phase bulk insert per column per fragment.
fn pk_pack_leaves<P: NodeProfile>(m: &PkMerged, donor: *mut u8, snp: u64,
                                  out: &mut Vec<PkRow>) {
    unsafe {
        let da: *mut PkdAlloc = P::pkd(donor);
        let kd: PdtDescr = pk_slot(da, 0u32).descr();
        let vd: PdtDescr = pk_slot(da, 1u32).descr();
        let total: u64 = pk_merged_len(m);
        let budget: u32 = (*da).block_size() * 9u32 / 10u32;
        let mut done: u64 = 0u64;
        while done < total {
            let cap: u64 = pk_leaf_rows_cap::<P>(m, done, total - done, &kd, &vd, budget);
            assert(cap > 0u64, "pack: a merged row exceeds the leaf budget (the 1/4 bound was not enforced upstream?)");
            let take: u64 = cap;
            let lf: *mut u8 = pk_leaf_new_like::<P>(donor, snp);
            let a: *mut PkdAlloc = P::pkd(lf);
            // keys
            {
                let kb: PdtBuf = pk_slot(a, 0u32);
                let us: PdtUpdate = match kb.prepare_insert(0u64, take, PDT_CAP_KEEP) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "pack: priced key fragment rejected (weight law broken?)");
                        return;
                    }
                };
                let mut cells: Vec<u64> = vec_new::<u64>();
                let mut i: u64 = 0u64;
                while i < take {
                    cells.push(pk_merged_key::<P>(m, done + i));
                    i = i + 1u64;
                }
                let mut kb2: PdtBuf = pk_slot(a, 0u32);
                kb2.commit_insert(&us, &cells);
            }
            // values
            if m.vle {
                let mut vals: PdtVals = pdt_vals_new();
                let mut i: u64 = 0u64;
                while i < take {
                    vals.push_span(pk_merged_val_span::<P>(m, done + i));
                    i = i + 1u64;
                }
                let vb: PdtBuf = pk_slot(a, 1u32);
                let us: PdtUpdate = match vb.prepare_insert_vals(0u64, take, PDT_CAP_KEEP, &vals) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "pack: priced VLE fragment rejected (weight law broken?)");
                        return;
                    }
                };
                let mut vb2: PdtBuf = pk_slot(a, 1u32);
                vb2.commit_insert_vals(&us, &vals);
            } else {
                let vb: PdtBuf = pk_slot(a, 1u32);
                let us: PdtUpdate = match vb.prepare_insert(0u64, take, PDT_CAP_KEEP) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "pack: priced val fragment rejected (weight law broken?)");
                        return;
                    }
                };
                let mut cells: Vec<u64> = vec_new::<u64>();
                let mut i: u64 = 0u64;
                while i < take {
                    cells.push(pk_merged_val_cell::<P>(m, done + i));
                    i = i + 1u64;
                }
                let mut vb2: PdtBuf = pk_slot(a, 1u32);
                vb2.commit_insert(&us, &cells);
            }
            out.push(PkRow {
                sep: pk_merged_key::<P>(m, done + take - 1u64),
                cnt: take,
                ptr: lf,
            });
            done = done + take;
        }
    }
}

// Pack a (sep, cnt, child) row list into fresh 3-slot branches at the 90%
// target. A branch's own separator = its last row's separator.
fn pk_pack_branches<P: NodeProfile>(rows: &Vec<PkRow>, snp: u64, branch_bytes: u32,
                                    out: &mut Vec<PkRow>) {
    unsafe {
        let probe: *mut u8 = pk_branch_new::<P>(snp, branch_bytes);
        let budget: u32 = (*P::pkd(probe)).block_size();
        let d: PdtDescr = pk_key_descr();
        let zero: Vec<u64> = pdt_payload_zero(&d);
        let mut lo: u64 = 1u64;
        let mut hi: u64 = (budget as u64) / 24u64 + 1u64;
        while lo < hi {
            let mid: u64 = (lo + hi + 1u64) / 2u64;
            let w: u32 = pdtbuf_compute_block_size(&d, mid, &zero);
            let mut ws: Vec<u32> = vec_new::<u32>();
            ws.push(w);
            ws.push(w);
            ws.push(w);
            if pack_region_weight(&ws) <= budget {
                lo = mid;
            } else {
                hi = mid - 1u64;
            }
        }
        let mut target: u64 = lo * 9u64 / 10u64;
        if target < 2u64 {
            target = 2u64;
        }
        let total: u64 = rows.length() as u64;
        let mut done: u64 = 0u64;
        let mut cur: *mut u8 = probe;
        while done < total {
            let mut take: u64 = target;
            if total - done < take {
                take = total - done;
            }
            let a: *mut PkdAlloc = P::pkd(cur);
            let mut sub: u64 = 0u64;
            let mut i: u64 = 0u64;
            while i < take {
                let rw: &PkRow = rows.borrow((done + i) as i64);
                btss_put_cell(a, PKB_SEP, i as u32, rw.sep);
                btss_put_cell(a, PKB_CNT, i as u32, rw.cnt);
                btss_put_cell(a, PKB_CHILD, i as u32, rw.ptr as u64);
                sub = sub + rw.cnt;
                i = i + 1u64;
            }
            out.push(PkRow {
                sep: rows.borrow((done + take - 1u64) as i64).sep,
                cnt: sub,
                ptr: cur,
            });
            done = done + take;
            if done < total {
                cur = pk_branch_new::<P>(snp, branch_bytes);
            }
        }
    }
}

// lower_bound over a MAX key/sep column in the raw u64 domain with the sign
// verdict (first row NOT less than `key`).
unsafe fn pk_lower_bound(b: &PdtBuf, key: u64, signed: bool) -> u64 {
    let n: u64 = b.size();
    let mut i: u64 = 0u64;
    while i < n {
        if !pk_lt(b.get(0u32, i), key, signed) {
            return i;
        }
        i = i + 1u64;
    }
    return n;
}

// The recursive CoW splice. OWNERSHIP: takes the parent's one ref to
// `node`; returns rows owning their ptrs. When the returned set does not
// contain `node`, the original ref was released inside (tree_release — the
// old block may still be shared with a frozen snapshot).
fn pk_splice_rec<P: NodeProfile>(node: *mut u8, level: u32, first: u64, signed: bool,
                                 buf: &BtssBuf, cur: u64, branch_bytes: u32) -> Vec<PkRow> {
    unsafe {
        if level == 0u32 {
            let work: *mut u8 = pk_private::<P>(node, cur, false);
            let a: *mut PkdAlloc = P::pkd(work);
            let m: u64 = buf.len();
            let kb0: PdtBuf = pk_slot(a, 0u32);
            let pos: u64 = pk_lower_bound(&kb0, first, signed);
            // in-place try: BOTH columns priced against the shared region
            // before either commits
            let mut fits: bool = false;
            {
                let kb: PdtBuf = pk_slot(a, 0u32);
                match kb.prepare_insert(pos, m, PDT_CAP_KEEP) {
                    Result::Ok(us_k) => {
                        if buf.vle {
                            let mut vals: PdtVals = pdt_vals_new();
                            let mut i: u64 = 0u64;
                            while i < m {
                                vals.push_span(buf.val_span(i));
                                i = i + 1u64;
                            }
                            let vb: PdtBuf = pk_slot(a, 1u32);
                            match vb.prepare_insert_vals(pos, m, PDT_CAP_KEEP, &vals) {
                                Result::Ok(us_v) => {
                                    fits = us_k.grow_bytes() + us_v.grow_bytes() <= a.free_space();
                                }
                                Result::Err(_e) => {}
                            }
                        } else {
                            let vb: PdtBuf = pk_slot(a, 1u32);
                            match vb.prepare_insert(pos, m, PDT_CAP_KEEP) {
                                Result::Ok(us_v) => {
                                    fits = us_k.grow_bytes() + us_v.grow_bytes() <= a.free_space();
                                }
                                Result::Err(_e) => {}
                            }
                        }
                    }
                    Result::Err(_e) => {}
                }
            }
            if fits {
                // keys
                {
                    let kb: PdtBuf = pk_slot(a, 0u32);
                    let us: PdtUpdate = match kb.prepare_insert(pos, m, PDT_CAP_KEEP) {
                        Result::Ok(u) => u,
                        Result::Err(_e) => {
                            assert(false, "pack: priced key insert failed at commit");
                            return vec_new::<PkRow>();
                        }
                    };
                    let mut cells: Vec<u64> = vec_new::<u64>();
                    let mut i: u64 = 0u64;
                    while i < m {
                        cells.push(buf.key(i));
                        i = i + 1u64;
                    }
                    let mut kb2: PdtBuf = pk_slot(a, 0u32);
                    kb2.commit_insert(&us, &cells);
                }
                // values
                if buf.vle {
                    let mut vals: PdtVals = pdt_vals_new();
                    let mut i: u64 = 0u64;
                    while i < m {
                        vals.push_span(buf.val_span(i));
                        i = i + 1u64;
                    }
                    let vb: PdtBuf = pk_slot(a, 1u32);
                    let us: PdtUpdate = match vb.prepare_insert_vals(pos, m, PDT_CAP_KEEP, &vals) {
                        Result::Ok(u) => u,
                        Result::Err(_e) => {
                            assert(false, "pack: priced VLE insert failed at commit");
                            return vec_new::<PkRow>();
                        }
                    };
                    let mut vb2: PdtBuf = pk_slot(a, 1u32);
                    vb2.commit_insert_vals(&us, &vals);
                } else {
                    let vb: PdtBuf = pk_slot(a, 1u32);
                    let us: PdtUpdate = match vb.prepare_insert(pos, m, PDT_CAP_KEEP) {
                        Result::Ok(u) => u,
                        Result::Err(_e) => {
                            assert(false, "pack: priced val insert failed at commit");
                            return vec_new::<PkRow>();
                        }
                    };
                    let mut cells: Vec<u64> = vec_new::<u64>();
                    let mut i: u64 = 0u64;
                    while i < m {
                        cells.push(buf.val_cell(i));
                        i = i + 1u64;
                    }
                    let mut vb2: PdtBuf = pk_slot(a, 1u32);
                    vb2.commit_insert(&us, &cells);
                }
                if work != node {
                    tree_release(node, 0u32);
                }
                let kbf: PdtBuf = pk_slot(a, 0u32);
                let cnt: u64 = kbf.size();
                let mut one: Vec<PkRow> = vec_new::<PkRow>();
                one.push(PkRow { sep: kbf.get(0u32, cnt - 1u64), cnt: cnt, ptr: work });
                return one;
            }
            // overflow: repack (prefix ++ staging ++ suffix) into fresh leaves
            let merged: PkMerged = PkMerged {
                leaf: work,
                split: pos,
                lcount: pk_slot(a, 0u32).size(),
                kbuf: buf.kmem,
                vbuf: buf.vmem,
                bcount: m,
                vle: buf.vle,
            };
            let mut rows: Vec<PkRow> = vec_new::<PkRow>();
            pk_pack_leaves::<P>(&merged, work, cur, &mut rows);
            if work != node {
                P::free(work);              // the private clone (leaf: no children)
                tree_release(node, 0u32);   // the original parent ref
            } else {
                P::free(node);
            }
            return rows;
        }
        let work: *mut u8 = pk_private::<P>(node, cur, true);
        let a: *mut PkdAlloc = P::pkd(work);
        let sb: PdtBuf = pk_slot(a, PKB_SEP);
        let n: u64 = sb.size();
        let mut ci: u64 = pk_lower_bound(&sb, first, signed);
        if ci >= n {
            ci = n - 1u64;                  // the FindShuttle clamp
        }
        let old_child: *mut u8 = pk_slot(a, PKB_CHILD).get(0u32, ci) as *mut u8;
        let sub: Vec<PkRow> = pk_splice_rec::<P>(old_child, level - 1u32, first, signed,
                                                 buf, cur, branch_bytes);
        // refresh row ci from the first sub row
        {
            let mut s2: PdtBuf = pk_slot(a, PKB_SEP);
            s2.set(0u32, ci, sub.borrow(0i64).sep);
            let mut c2: PdtBuf = pk_slot(a, PKB_CNT);
            c2.set(0u32, ci, sub.borrow(0i64).cnt);
            let mut p2: PdtBuf = pk_slot(a, PKB_CHILD);
            p2.set(0u32, ci, sub.borrow(0i64).ptr as u64);
        }
        if sub.length() > 1i64 {
            let extra: u64 = (sub.length() as u64) - 1u64;
            // admission: all three columns priced against the shared region
            let mut fits: bool = false;
            {
                let s3: PdtBuf = pk_slot(a, PKB_SEP);
                match s3.prepare_insert(ci + 1u64, extra, PDT_CAP_KEEP) {
                    Result::Ok(us_s) => {
                        let c3: PdtBuf = pk_slot(a, PKB_CNT);
                        match c3.prepare_insert(ci + 1u64, extra, PDT_CAP_KEEP) {
                            Result::Ok(us_c) => {
                                let p3: PdtBuf = pk_slot(a, PKB_CHILD);
                                match p3.prepare_insert(ci + 1u64, extra, PDT_CAP_KEEP) {
                                    Result::Ok(us_p) => {
                                        fits = us_s.grow_bytes() + us_c.grow_bytes()
                                             + us_p.grow_bytes() <= a.free_space();
                                    }
                                    Result::Err(_e) => {}
                                }
                            }
                            Result::Err(_e) => {}
                        }
                    }
                    Result::Err(_e) => {}
                }
            }
            if fits {
                let mut seps: Vec<u64> = vec_new::<u64>();
                let mut cnts: Vec<u64> = vec_new::<u64>();
                let mut ptrs: Vec<u64> = vec_new::<u64>();
                let mut q: i64 = 1i64;
                while q < sub.length() {
                    seps.push(sub.borrow(q).sep);
                    cnts.push(sub.borrow(q).cnt);
                    ptrs.push(sub.borrow(q).ptr as u64);
                    q = q + 1i64;
                }
                let s4: PdtBuf = pk_slot(a, PKB_SEP);
                let us1: PdtUpdate = match s4.prepare_insert(ci + 1u64, extra, PDT_CAP_KEEP) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "pack: priced sep insert failed at commit");
                        return vec_new::<PkRow>();
                    }
                };
                let mut s5: PdtBuf = pk_slot(a, PKB_SEP);
                s5.commit_insert(&us1, &seps);
                let c4: PdtBuf = pk_slot(a, PKB_CNT);
                let us2: PdtUpdate = match c4.prepare_insert(ci + 1u64, extra, PDT_CAP_KEEP) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "pack: priced cnt insert failed at commit");
                        return vec_new::<PkRow>();
                    }
                };
                let mut c5: PdtBuf = pk_slot(a, PKB_CNT);
                c5.commit_insert(&us2, &cnts);
                let p4: PdtBuf = pk_slot(a, PKB_CHILD);
                let us3: PdtUpdate = match p4.prepare_insert(ci + 1u64, extra, PDT_CAP_KEEP) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "pack: priced child insert failed at commit");
                        return vec_new::<PkRow>();
                    }
                };
                let mut p5: PdtBuf = pk_slot(a, PKB_CHILD);
                p5.commit_insert(&us3, &ptrs);
            } else {
                // recompose this branch's whole row list into fresh branches
                let mut rows: Vec<PkRow> = vec_new::<PkRow>();
                let sbx: PdtBuf = pk_slot(a, PKB_SEP);
                let cbx: PdtBuf = pk_slot(a, PKB_CNT);
                let pbx: PdtBuf = pk_slot(a, PKB_CHILD);
                let mut i: u64 = 0u64;
                while i < n {
                    if i == ci {
                        let mut q: i64 = 0i64;
                        while q < sub.length() {
                            rows.push(PkRow {
                                sep: sub.borrow(q).sep,
                                cnt: sub.borrow(q).cnt,
                                ptr: sub.borrow(q).ptr,
                            });
                            q = q + 1i64;
                        }
                    } else {
                        rows.push(PkRow {
                            sep: sbx.get(0u32, i),
                            cnt: cbx.get(0u32, i),
                            ptr: pbx.get(0u32, i) as *mut u8,
                        });
                    }
                    i = i + 1u64;
                }
                let mut out: Vec<PkRow> = vec_new::<PkRow>();
                pk_pack_branches::<P>(&rows, cur, branch_bytes, &mut out);
                // the refs moved into the fresh branches: drop the shells
                if work != node {
                    P::free(work);              // clone shell (no child walk)
                    tree_release(node, level);  // original ref (decs children)
                } else {
                    P::free(node);              // own shell, refs transferred
                }
                return out;
            }
        }
        if work != node {
            tree_release(node, level);
        }
        // recompute this node's total off its refreshed count column
        let cbt: PdtBuf = pk_slot(a, PKB_CNT);
        let nn: u64 = cbt.size();
        let mut tot: u64 = 0u64;
        let mut i2: u64 = 0u64;
        while i2 < nn {
            tot = tot + cbt.get(0u32, i2);
            i2 = i2 + 1u64;
        }
        let sbt: PdtBuf = pk_slot(a, PKB_SEP);
        let mut one: Vec<PkRow> = vec_new::<PkRow>();
        one.push(PkRow { sep: sbt.get(0u32, nn - 1u64), cnt: tot, ptr: work });
        return one;
    }
}

// ════════════════════════════════════════════════════════════════════════════
// The MAP removal (the deletion slice): delete one entry + PARENT-DRIVEN
// MERGE. The C++ protocol runs "remove, then try to merge the touched node
// with its neighbor"; here the merge DECISION is the weight calculus —
// `w(left rows + right rows) ≤ region budget` is exact and O(1) (FSE row
// counts, VLE byte-offset sums), so a merge either fits by proof or is not
// attempted. No trial, no restore — the same discipline as the packer.
//
// CoW: the walk privatizes the PATH (pk_private); a merge mutates ONLY the
// path child — the absorbed sibling is READ (legal on a block shared with a
// frozen snapshot) and then released via tree_release, its child refs (for
// a branch sibling) rc-bumped as they are copied over: the transfer nets
// correctly whether the sibling was shared or solely ours.

// remove one row from all three branch columns (bulk two-phase, CAP_EXACT so
// the freed bytes return to the shared region — the btree-node reading)
unsafe fn pk_branch_remove_row(a: *mut PkdAlloc, i: u64) {
    let mut s: u32 = 0u32;
    while s < 3u32 {
        let b: PdtBuf = pk_slot(a, s);
        let us: PdtUpdate = match b.prepare_remove(i, i + 1u64, PDT_CAP_EXACT) {
            Result::Ok(u) => u,
            Result::Err(_e) => {
                assert(false, "pack: branch row remove failed to prepare");
                return;
            }
        };
        let mut b2: PdtBuf = pk_slot(a, s);
        b2.commit_remove(&us);
        s = s + 1u32;
    }
}

// Can the leaves at rows (li, ri) of branch `a` merge into one leaf?
// EXACT admission off the two blocks' live geometry.
fn pk_leaves_mergeable<P: NodeProfile>(l: *mut u8, r: *mut u8) -> bool {
    unsafe {
        let la: *mut PkdAlloc = P::pkd(l);
        let ra: *mut PkdAlloc = P::pkd(r);
        let kd: PdtDescr = pk_slot(la, 0u32).descr();
        let vd: PdtDescr = pk_slot(la, 1u32).descr();
        let n: u64 = pk_slot(la, 0u32).size() + pk_slot(ra, 0u32).size();
        let kw: u32 = pdtbuf_compute_block_size(&kd, n, &pdt_payload_zero(&kd));
        let mut vpay: Vec<u64> = vec_new::<u64>();
        if vd.vle_dim_count() > 0u32 {
            vpay.push(pk_slot(la, 1u32).payload_used(0u32, 0u32)
                    + pk_slot(ra, 1u32).payload_used(0u32, 0u32));
        }
        let vw: u32 = pdtbuf_compute_block_size(&vd, n, &vpay);
        let mut ws: Vec<u32> = vec_new::<u32>();
        ws.push(kw);
        ws.push(vw);
        return pack_region_weight(&ws) <= (*la).block_size();
    }
}

// Append every row of leaf `src` (read-only — may be shared) to leaf `dst`
// (private). One bulk two-phase insert per column.
fn pk_leaf_absorb<P: NodeProfile>(dst: *mut u8, src: *mut u8, at_front: bool) {
    unsafe {
        let da: *mut PkdAlloc = P::pkd(dst);
        let sa: *mut PkdAlloc = P::pkd(src);
        let sn: u64 = pk_slot(sa, 0u32).size();
        if sn == 0u64 {
            return;
        }
        let pos: u64 = if at_front { 0u64 } else { pk_slot(da, 0u32).size() };
        // keys
        {
            let kb: PdtBuf = pk_slot(da, 0u32);
            let us: PdtUpdate = match kb.prepare_insert(pos, sn, PDT_CAP_KEEP) {
                Result::Ok(u) => u,
                Result::Err(_e) => {
                    assert(false, "pack: admitted leaf merge rejected keys (weight law broken?)");
                    return;
                }
            };
            let mut cells: Vec<u64> = vec_new::<u64>();
            let sb: PdtBuf = pk_slot(sa, 0u32);
            let mut i: u64 = 0u64;
            while i < sn {
                cells.push(sb.get(0u32, i));
                i = i + 1u64;
            }
            let mut kb2: PdtBuf = pk_slot(da, 0u32);
            kb2.commit_insert(&us, &cells);
        }
        // values
        let vb0: PdtBuf = pk_slot(da, 1u32);
        if vb0.vle_dim_count() > 0u32 {
            let mut vals: PdtVals = pdt_vals_new();
            let sv: PdtBuf = pk_slot(sa, 1u32);
            let mut i: u64 = 0u64;
            while i < sn {
                let off: u64 = sv.row_offset(0u32, 0u32, i);
                let len: u64 = sv.row_len(0u32, 0u32, i);
                vals.push_span(slice_from_raw::<u8>(sv.payload(0u32, 0u32).byte_add(off as i64),
                                                    len as i64));
                i = i + 1u64;
            }
            let vb: PdtBuf = pk_slot(da, 1u32);
            let us: PdtUpdate = match vb.prepare_insert_vals(pos, sn, PDT_CAP_KEEP, &vals) {
                Result::Ok(u) => u,
                Result::Err(_e) => {
                    assert(false, "pack: admitted leaf merge rejected VLE vals (weight law broken?)");
                    return;
                }
            };
            let mut vb2: PdtBuf = pk_slot(da, 1u32);
            vb2.commit_insert_vals(&us, &vals);
        } else {
            let vb: PdtBuf = pk_slot(da, 1u32);
            let us: PdtUpdate = match vb.prepare_insert(pos, sn, PDT_CAP_KEEP) {
                Result::Ok(u) => u,
                Result::Err(_e) => {
                    assert(false, "pack: admitted leaf merge rejected vals (weight law broken?)");
                    return;
                }
            };
            let mut cells: Vec<u64> = vec_new::<u64>();
            let sv: PdtBuf = pk_slot(sa, 1u32);
            let mut i: u64 = 0u64;
            while i < sn {
                cells.push(sv.get(0u32, i));
                i = i + 1u64;
            }
            let mut vb2: PdtBuf = pk_slot(da, 1u32);
            vb2.commit_insert(&us, &cells);
        }
    }
}

// Can the BRANCH nodes merge (3-col row admission)?
fn pk_branches_mergeable<P: NodeProfile>(l: *mut u8, r: *mut u8) -> bool {
    unsafe {
        let la: *mut PkdAlloc = P::pkd(l);
        let n: u64 = pk_slot(la, PKB_SEP).size() + pk_slot(P::pkd(r), PKB_SEP).size();
        let d: PdtDescr = pk_key_descr();
        let w: u32 = pdtbuf_compute_block_size(&d, n, &pdt_payload_zero(&d));
        let mut ws: Vec<u32> = vec_new::<u32>();
        ws.push(w);
        ws.push(w);
        ws.push(w);
        return pack_region_weight(&ws) <= (*la).block_size();
    }
}

// Append every (sep, cnt, child) row of branch `src` to branch `dst`
// (private). The copied child refs are NEW references: rc-bump each — the
// release of `src` afterwards nets the transfer for shared and owned alike.
fn pk_branch_absorb<P: NodeProfile>(dst: *mut u8, src: *mut u8, at_front: bool) {
    unsafe {
        let da: *mut PkdAlloc = P::pkd(dst);
        let sa: *mut PkdAlloc = P::pkd(src);
        let sn: u64 = pk_slot(sa, PKB_SEP).size();
        if sn == 0u64 {
            return;
        }
        let pos: u64 = if at_front { 0u64 } else { pk_slot(da, PKB_SEP).size() };
        let mut s: u32 = 0u32;
        while s < 3u32 {
            let b: PdtBuf = pk_slot(da, s);
            let us: PdtUpdate = match b.prepare_insert(pos, sn, PDT_CAP_KEEP) {
                Result::Ok(u) => u,
                Result::Err(_e) => {
                    assert(false, "pack: admitted branch merge rejected (weight law broken?)");
                    return;
                }
            };
            let mut cells: Vec<u64> = vec_new::<u64>();
            let sb: PdtBuf = pk_slot(sa, s);
            let mut i: u64 = 0u64;
            while i < sn {
                let v: u64 = sb.get(0u32, i);
                if s == PKB_CHILD {
                    P::inc_rc(v as *mut u8);
                }
                cells.push(v);
                i = i + 1u64;
            }
            let mut b2: PdtBuf = pk_slot(da, s);
            b2.commit_insert(&us, &cells);
            s = s + 1u32;
        }
    }
}

// After the path child at row `ci` changed, try to merge it with a NEIGHBOR
// (right first, then left). Mutates only the path child (`work_child`,
// already private); the sibling is read + released. Refreshes the branch
// rows. Children are leaves when `child_level == 0`.
fn pk_try_merge<P: NodeProfile>(a: *mut PkdAlloc, ci: u64, work_child: *mut u8,
                                child_level: u32) {
    unsafe {
        let n: u64 = pk_slot(a, PKB_SEP).size();
        // right neighbor: absorb it at the child's BACK
        if ci + 1u64 < n {
            let sib: *mut u8 = pk_slot(a, PKB_CHILD).get(0u32, ci + 1u64) as *mut u8;
            let can: bool = if child_level == 0u32 {
                pk_leaves_mergeable::<P>(work_child, sib)
            } else {
                pk_branches_mergeable::<P>(work_child, sib)
            };
            if can {
                if child_level == 0u32 {
                    pk_leaf_absorb::<P>(work_child, sib, false);
                } else {
                    pk_branch_absorb::<P>(work_child, sib, false);
                }
                // the merged row inherits the RIGHT sibling's separator
                let rsep: u64 = pk_slot(a, PKB_SEP).get(0u32, ci + 1u64);
                let rcnt: u64 = pk_slot(a, PKB_CNT).get(0u32, ci + 1u64);
                tree_release(sib, child_level);
                pk_branch_remove_row(a, ci + 1u64);
                let mut s2: PdtBuf = pk_slot(a, PKB_SEP);
                s2.set(0u32, ci, rsep);
                let oc: u64 = pk_slot(a, PKB_CNT).get(0u32, ci);
                let mut c2: PdtBuf = pk_slot(a, PKB_CNT);
                c2.set(0u32, ci, oc + rcnt);
                return;
            }
        }
        // left neighbor: absorb it at the child's FRONT
        if ci >= 1u64 {
            let sib: *mut u8 = pk_slot(a, PKB_CHILD).get(0u32, ci - 1u64) as *mut u8;
            let can: bool = if child_level == 0u32 {
                pk_leaves_mergeable::<P>(work_child, sib)
            } else {
                pk_branches_mergeable::<P>(work_child, sib)
            };
            if can {
                if child_level == 0u32 {
                    pk_leaf_absorb::<P>(work_child, sib, true);
                } else {
                    pk_branch_absorb::<P>(work_child, sib, true);
                }
                let lcnt: u64 = pk_slot(a, PKB_CNT).get(0u32, ci - 1u64);
                tree_release(sib, child_level);
                pk_branch_remove_row(a, ci - 1u64);
                // rows shifted left by one: the child now sits at ci-1;
                // its separator (own max) is unchanged, its count grows
                let at: u64 = ci - 1u64;
                let oc: u64 = pk_slot(a, PKB_CNT).get(0u32, at);
                let mut c2: PdtBuf = pk_slot(a, PKB_CNT);
                c2.set(0u32, at, oc + lcnt);
            }
        }
    }
}

// The recursive CoW removal. Same ownership contract as the splice: takes
// the parent's one ref to `node`; when the returned rows do not contain
// `node`, the original ref was released inside. ZERO rows = the subtree
// vanished (the parent removes its row).
fn pk_remove_rec<P: NodeProfile>(node: *mut u8, level: u32, key: u64, signed: bool,
                                 cur: u64) -> Vec<PkRow> {
    unsafe {
        if level == 0u32 {
            let work: *mut u8 = pk_private::<P>(node, cur, false);
            let a: *mut PkdAlloc = P::pkd(work);
            let kb: PdtBuf = pk_slot(a, 0u32);
            let pos: u64 = pk_lower_bound(&kb, key, signed);
            // the pre-checked key IS here (btss_remove verified read-only)
            {
                let b: PdtBuf = pk_slot(a, 0u32);
                let us: PdtUpdate = match b.prepare_remove(pos, pos + 1u64, PDT_CAP_EXACT) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "pack: key remove failed to prepare");
                        return vec_new::<PkRow>();
                    }
                };
                let mut b2: PdtBuf = pk_slot(a, 0u32);
                b2.commit_remove(&us);
            }
            {
                let b: PdtBuf = pk_slot(a, 1u32);
                let us: PdtUpdate = match b.prepare_remove(pos, pos + 1u64, PDT_CAP_EXACT) {
                    Result::Ok(u) => u,
                    Result::Err(_e) => {
                        assert(false, "pack: val remove failed to prepare");
                        return vec_new::<PkRow>();
                    }
                };
                let mut b2: PdtBuf = pk_slot(a, 1u32);
                b2.commit_remove(&us);
            }
            if work != node {
                tree_release(node, 0u32);
            }
            let kbf: PdtBuf = pk_slot(a, 0u32);
            let cnt: u64 = kbf.size();
            if cnt == 0u64 {
                P::free(work);                     // emptied — the parent drops the row
                return vec_new::<PkRow>();
            }
            let mut one: Vec<PkRow> = vec_new::<PkRow>();
            one.push(PkRow { sep: kbf.get(0u32, cnt - 1u64), cnt: cnt, ptr: work });
            return one;
        }
        let work: *mut u8 = pk_private::<P>(node, cur, true);
        let a: *mut PkdAlloc = P::pkd(work);
        let sb: PdtBuf = pk_slot(a, PKB_SEP);
        let n: u64 = sb.size();
        let mut ci: u64 = pk_lower_bound(&sb, key, signed);
        if ci >= n {
            ci = n - 1u64;
        }
        let old_child: *mut u8 = pk_slot(a, PKB_CHILD).get(0u32, ci) as *mut u8;
        let sub: Vec<PkRow> = pk_remove_rec::<P>(old_child, level - 1u32, key, signed, cur);
        if sub.length() == 0i64 {
            pk_branch_remove_row(a, ci);
        } else {
            let mut s2: PdtBuf = pk_slot(a, PKB_SEP);
            s2.set(0u32, ci, sub.borrow(0i64).sep);
            let mut c2: PdtBuf = pk_slot(a, PKB_CNT);
            c2.set(0u32, ci, sub.borrow(0i64).cnt);
            let mut p2: PdtBuf = pk_slot(a, PKB_CHILD);
            p2.set(0u32, ci, sub.borrow(0i64).ptr as u64);
            // the C++ step-4 analog: try to merge the touched child with a
            // neighbor — weight-admitted, path-child-mutating only
            pk_try_merge::<P>(a, ci, sub.borrow(0i64).ptr, level - 1u32);
        }
        if work != node {
            tree_release(node, level);
        }
        let nn: u64 = pk_slot(a, PKB_SEP).size();
        if nn == 0u64 {
            P::free(work);
            return vec_new::<PkRow>();
        }
        let cbt: PdtBuf = pk_slot(a, PKB_CNT);
        let mut tot: u64 = 0u64;
        let mut i: u64 = 0u64;
        while i < nn {
            tot = tot + cbt.get(0u32, i);
            i = i + 1u64;
        }
        let mut one: Vec<PkRow> = vec_new::<PkRow>();
        one.push(PkRow { sep: pk_slot(a, PKB_SEP).get(0u32, nn - 1u64), cnt: tot, ptr: work });
        return one;
    }
}

/// The map removal result: `found = false` = the key was absent and NOTHING
/// was mutated; on success root/level carry the (possibly collapsed) tree.
pub struct BtssRemRet {
    pub found: bool,
    pub root: *mut u8,
    pub level: u32,
}

/// Remove `key` from the btss map. Existence is checked READ-ONLY first (an
/// absent key mutates nothing); the mutating walk is CoW; merges follow the
/// C++ step-4 discipline under weight admission; the root collapses while it
/// is a one-child branch. An emptied container becomes a fresh empty leaf.
pub fn btss_remove<P: NodeProfile>(snap: &MemorySnapshot, root: *mut u8, level: u32,
                                   key: u64, signed: bool) -> BtssRemRet {
    // read-only existence check + leaf-shape capture (the fresh-empty-root donor)
    let mut kd: PdtDescr = pk_key_descr();
    let mut vd: PdtDescr = pk_key_descr();
    let mut leaf_bytes: u32 = 0u32;
    unsafe {
        let mut node: *mut u8 = root;
        let mut lvl: u32 = level;
        while lvl > 0u32 {
            let a: *mut PkdAlloc = P::pkd(node);
            let sb: PdtBuf = pk_slot(a, PKB_SEP);
            let mut ci: u64 = pk_lower_bound(&sb, key, signed);
            if ci >= sb.size() {
                ci = sb.size() - 1u64;
            }
            node = pk_slot(a, PKB_CHILD).get(0u32, ci) as *mut u8;
            lvl = lvl - 1u32;
        }
        let a: *mut PkdAlloc = P::pkd(node);
        let kb: PdtBuf = pk_slot(a, 0u32);
        let pos: u64 = pk_lower_bound(&kb, key, signed);
        if pos >= kb.size() || kb.get(0u32, pos) != key {
            return BtssRemRet { found: false, root: root, level: level };
        }
        kd = kb.descr();
        vd = pk_slot(a, 1u32).descr();
        leaf_bytes = P::block_size(node);
    }
    let cur: u64 = snap.snapshot_id();
    let rows: Vec<PkRow> = pk_remove_rec::<P>(root, level, key, signed, cur);
    if rows.length() == 0i64 {
        // the container emptied: a fresh empty leaf becomes the root
        unsafe {
            let lf: *mut u8 = P::alloc(leaf_bytes, 2u32, cur);
            let a: *mut PkdAlloc = P::pkd(lf);
            pk_fmt_slot(a, 0u32, &kd);
            pk_fmt_slot(a, 1u32, &vd);
            return BtssRemRet { found: true, root: lf, level: 0u32 };
        }
    }
    let mut nroot: *mut u8 = rows.borrow(0i64).ptr;
    let mut nlvl: u32 = level;
    // root collapse: a one-child branch hands the root to its child
    unsafe {
        let mut going: bool = nlvl > 0u32;
        while going {
            let a: *mut PkdAlloc = P::pkd(nroot);
            if pk_slot(a, PKB_SEP).size() == 1u64 {
                let child: *mut u8 = pk_slot(a, PKB_CHILD).get(0u32, 0u64) as *mut u8;
                P::free(nroot);            // the ref transfers to the root slot
                nroot = child;
                nlvl = nlvl - 1u32;
                going = nlvl > 0u32;
            } else {
                going = false;
            }
        }
    }
    return BtssRemRet { found: true, root: nroot, level: nlvl };
}

/// The map batch-insert result: `ok = false` = the batch was REJECTED
/// (unsorted, or its key range interleaves an existing key) and NOTHING was
/// mutated; on success root/level carry the (possibly repointed) tree top.
pub struct BtssBatchRet {
    pub ok: bool,
    pub root: *mut u8,
    pub level: u32,
}

/// Batch insert into the btss map: `buf` strictly ascending under `signed`,
/// landing whole between two adjacent existing keys (the sorted-run
/// contract; the general interleaving merge is a later op). Validation is
/// READ-ONLY and precedes any mutation — a rejected batch leaves the tree
/// untouched. The mutating walk is CoW: every touched node is privatized
/// to `cur` first.
pub fn btss_batch_insert<P: NodeProfile>(snap: &MemorySnapshot, root: *mut u8, level: u32,
                                         buf: &BtssBuf, signed: bool,
                                         branch_bytes: u32) -> BtssBatchRet {
    let m: u64 = buf.len();
    if m == 0u64 {
        return BtssBatchRet { ok: true, root: root, level: level };
    }
    if !buf.is_sorted(signed) {
        return BtssBatchRet { ok: false, root: root, level: level };
    }
    let first: u64 = buf.key(0u64);
    let last: u64 = buf.key(m - 1u64);
    // read-only pre-check: find the landing leaf, reject interleaving
    unsafe {
        let mut node: *mut u8 = root;
        let mut lvl: u32 = level;
        while lvl > 0u32 {
            let a: *mut PkdAlloc = P::pkd(node);
            let sb: PdtBuf = pk_slot(a, PKB_SEP);
            let mut ci: u64 = pk_lower_bound(&sb, first, signed);
            if ci >= sb.size() {
                ci = sb.size() - 1u64;
            }
            node = pk_slot(a, PKB_CHILD).get(0u32, ci) as *mut u8;
            lvl = lvl - 1u32;
        }
        let kb: PdtBuf = pk_slot(P::pkd(node), 0u32);
        let pos: u64 = pk_lower_bound(&kb, first, signed);
        if pos < kb.size() {
            if !pk_lt(last, kb.get(0u32, pos), signed) {
                return BtssBatchRet { ok: false, root: root, level: level };
            }
        }
    }
    let cur: u64 = snap.snapshot_id();
    let mut rows: Vec<PkRow> = pk_splice_rec::<P>(root, level, first, signed,
                                                  buf, cur, branch_bytes);
    let mut lvl: u32 = level;
    while rows.length() > 1i64 {
        let mut up: Vec<PkRow> = vec_new::<PkRow>();
        pk_pack_branches::<P>(&rows, cur, branch_bytes, &mut up);
        rows = up;
        lvl = lvl + 1u32;
    }
    return BtssBatchRet { ok: true, root: rows.borrow(0i64).ptr, level: lvl };
}
