// logos.mem.bt.memstore — the hand-written MemoryStore (ADR 0020 Track B,
// container⟂store split). The FIRST concrete store: blocks are heap allocations,
// a branch's `u64` child ref is the raw block ADDRESS, and there is NO direct
// block mapping — the id space materializes only on serialization (a handle↔ID
// transform lands with the disk stores). Containers are GENERATED against the
// storage capability (emitter-parameterized, ADR 0020 §5); this module is the
// hand-written half of the split — few stores, very different, each its own impl.
//
//   MemoryStore    — owns the snapshot-id sequence + the committed HEAD directory.
//   MemorySnapshot — a consistent version: the CoW skip key, the storage
//                    capability every generated container reaches through
//                    (node_alloc / rc / get_child), and a DIRECTORY mapping
//                    `ctr_id → (root, level)` so ONE snapshot spans MANY
//                    containers and commits them atomically (the Memoria model).
//
// A key division of labour makes the store CONTAINER-AGNOSTIC: every generated
// BRANCH has the uniform 3-slot shape (sep, subtree-size, single-column-PdtBuf child
// refs in slot 2) and every node carries the intrusive-rc header, so the store
// allocates, refcounts and RECURSIVELY RELEASES any tree from just `(root,
// level)` — walking slot 2 for children, never touching a leaf's typed columns.
// Only the key-typed / value-typed operations (leaf insert/split, branch
// routing, cow_clone) are container-specific and stay in the generated code.
package logos.mem.bt.memstore;

use logos.mem.pkd;               // PkdAlloc — the packed node substrate
use logos.mem.pkd.pdtbuf;        // PdtBuf — the uniform child column (single-column FSE64)
use logos.lang.panic;
use logos.mem.bt.node;           // node_alloc/_free/_inc_rc/_dec_rc/_rc/_snapshot — the rc header
use logos.mem.bt.map;            // trait Store, trait Snapshot — the capability contract
use logos.mem.sync;              // Arc — the cross-thread snapshot handle (S3)
use logos.lang.atomic;           // AtomicI32 — the wrapper counter (cross-thread)
use logos.mem.boxed;             // Box — stable SnapDesc storage
use logos.lang.option;
use logos.mem.collections.vec;   // Vec — the directory backing (few containers → linear scan)
use logos.mem.string;            // String — named-branch refs + snapshot branch tag
use logos.lang.str;              // str — branch-name views
use logos.mem.bt.dirmap;         // the directory is a CoW container (dir_set/get/…)
use logos.mem.bt.dump;           // node/tree dumper — debugging the node-data deltas
use logos.mem.bt.check;          // invariant checker — localize violations at scale

// tree_release (generic node lifecycle + the directory's value-ref cascade)
// lives in logos.mem.bt.node — pure node_* + column walk — so both this store
// and the directory container (dirmap) reach it without a dependency cycle.

// ── directory: ctr_id → (root, level), the snapshot's container registry ─────

/// One container's root, as `root_of` reports it to a generated handle. The
/// directory now STORES only `ctr_id → root` (a pure `Map<CtrID, BlockID>`,
/// logos.mem.bt.dirmap); `level` is recovered from the root node's own header
/// (`node_level`) and surfaced here so handles keep their `(root, level)` shape.
pub struct DirEntry { pub ctr_id: u64, pub root: *mut u8, pub level: u32 }

// The snapshot's container registry is a CoW container itself — a dirmap
// `Map<CtrID, root>` whose leaf VALUES are container roots (reference cells).
// A SnapDesc holds only its `dir_root` (the superblock): fork shares it with one
// inc_rc (O(1), not an O(D) copy), a lookup is an O(log D) descent, and drop is
// ONE `tree_release(dir_root)` that cascades to every container root through the
// leaves' value-ref columns. See logos.mem.bt.dirmap for the rc discipline.

// ── the snapshot DESCRIPTOR + WRAPPER split (Memoria memory_cow model) ──────
//
// The STORE owns the whole history: one `SnapDesc` per snapshot — the analog
// of Memoria's HistoryNode {status, references_, root}. What application code
// holds is a WRAPPER (`MemorySnapshot`) around a descriptor: `find()` mints
// one wrapper per call (one per thread in MT use), `Drop` of a wrapper only
// closes the wrapper — the history entry lives on, re-obtainable via
// `store.find(id)`. `remove()` MARKS the descriptor dropped; the physical
// release happens when the LAST wrapper for that id closes (the atomic
// wrapper counter hits zero) — mirroring ~ThreadsSnapshot in
// threads_snapshot_cow_impl.hpp. v1 = atomics + (documented) lock points;
// the bookkeeping-thread alternative stays open in project_storecfg_plane.

/// Snapshot lifecycle states (Memoria SnapshotStatus, the v1 subset).
pub const SNAP_ACTIVE:    u32 = 0u32;
pub const SNAP_COMMITTED: u32 = 1u32;
pub const SNAP_DROPPED:   u32 = 2u32;

/// The store-owned snapshot descriptor: the history entry itself. A NODE in
/// the snapshot DAG — `parent` links it to the version it forked from (0 = a
/// root, forked from the empty store), `branch` names the ref that `commit`
/// advances to this id (the git model: fork inherits its source's branch,
/// `set_as_branch` rebinds it). Committed descriptors are retained in the
/// store's history table forever (until `remove` + reclaim), so each holds its
/// OWN structural-sharing shares — a branch ref is then a pure id pointer, no
/// tree shares of its own.
pub struct SnapDesc {
    pub id: u64,
    parent: u64,             // the snapshot this one forked from (0 = root)
    branch: String,          // the branch commit() advances (default "master")
    dir_root: *mut u8,       // the directory container's root (a CoW dirmap tree)
    dir_level: u32,          // its level (grows as the directory splits)
    status: u32,
    wrappers: AtomicI32,     // open MemorySnapshot wrappers for this entry
}

/// A named branch: a mutable ref pointing at its head (tip) snapshot id, git's
/// `refs/heads/<name>`. `tip == 0` means the branch exists but is empty (no
/// commit yet — the state of "master" in a fresh store). Branch refs hold NO
/// tree shares: the committed descriptor at `tip` owns its trees.
pub struct BranchRef { name: String, tip: u64 }

/// The default branch name (git's `master`): every store is born with it.
pub const MASTER_BRANCH: str = "master";

/// A MemoryStore snapshot WRAPPER. `desc` points at the store-owned history
/// entry (Box-stable); the wrapper carries no state of its own. Dropping the
/// wrapper decrements the descriptor's counter and — only when it was the
/// LAST wrapper of an Active/Dropped entry — physically releases the entry's
/// trees and forgets the descriptor.
pub struct MemorySnapshot {
    desc: *mut SnapDesc,
    // The PARENT HOLD: every wrapper keeps the store alive (the C++
    // shared_from_this in snp_make_shared_init). EVERY snapshot belongs to a
    // store — with_id mints a private one. Guarantees store Drop runs only
    // after every wrapper closed — its history drain never races a live
    // wrapper.
    //
    // POOL RULE (symmetric with the Ctr handle's `snap` field): a wrapper is
    // either OWNED BY USER CODE or sits in the STORE's pool (when one lands);
    // pooled, this hold would cycle Store→pool→Snapshot→Store — the pool
    // design carries the reset mechanism.
    store: Arc<MemoryStore>,
}

// The STORAGE CAPABILITY — inherent methods the generated container reaches
// through (ADR 0020 Track B, emitter-parameterized: the generator emits concrete
// `snap.node_alloc(…)` calls, so the surface is inherent, not a consumed trait).
// The whole surface takes `&self`: the WRAPPER itself is never mutated — every
// write goes through the store-owned descriptor (`desc`), which is the one
// honest interior point. Shared wrapper over shared state LOOKS shared.
impl MemorySnapshot {
    unsafe fn d(self: &MemorySnapshot) -> *mut SnapDesc { return self.desc; }

    /// A snapshot with a PRIVATE store (library tests drive btfl/bt directly
    /// and only need an id + a directory): every snapshot belongs to a store —
    /// this one simply isn't shared. The wrapper's Drop releases the entry;
    /// the implicit store dies with the hold.
    pub static fn with_id(id: u64) -> MemorySnapshot {
        let mut st: Arc<MemoryStore> = store_new();
        {
            let g: &mut MemoryStore = &mut *st;
            g.next_id = id;
        }
        return store_fork(&mut st);
    }

    // — capability: node storage —

    /// Allocate a fresh node block — a `nslots`-slot PkdAlloc region of
    /// `pkd_bytes`, stamped with this snapshot's id (the CoW skip key) and rc=1.
    pub fn node_alloc(self: &MemorySnapshot, pkd_bytes: u32, nslots: u32) -> *mut u8 {
        return unsafe { node_alloc(pkd_bytes, nslots, (*self.d()).id) };
    }

    /// A BRANCH node: same block, plus the declaration of which slot carries
    /// its child refs. Every branch must go through this — a branch allocated
    /// as a plain node trips tree_release's assert rather than leaking.
    pub fn branch_alloc(self: &MemorySnapshot, pkd_bytes: u32, nslots: u32,
                        child_slot: u32) -> *mut u8 {
        unsafe {
            let b: *mut u8 = node_alloc(pkd_bytes, nslots, (*self.d()).id);
            node_set_child_slot(b, child_slot);
            return b;
        }
    }
    /// Release a node block (its children are released by the caller).
    pub fn node_free(self: &MemorySnapshot, h: *mut u8) { unsafe { node_free(h); } }

    /// Bump / drop a node's structural-sharing refcount; `dec_rc` returns the
    /// new value (0 = the caller must `node_free`).
    pub fn inc_rc(self: &MemorySnapshot, h: *mut u8) -> u32 {
        unsafe { node_inc_rc(h); return node_rc(h); }
    }
    pub fn dec_rc(self: &MemorySnapshot, h: *mut u8) -> u32 {
        return unsafe { node_dec_rc(h) };
    }

    // MemoryStore has no direct block mapping: a `u64` child ref IS the block
    // address, resolved by a plain cast (a disk store reads the same u64 column
    // as a BlockID through its block mapping instead).
    pub fn get_child(self: &MemorySnapshot, cref: u64) -> *mut u8 { return cref as *mut u8; }
    pub fn child_ref_of(self: &MemorySnapshot, h: *mut u8) -> u64 { return h as u64; }

    /// True iff `h` is shared with a frozen snapshot (its stamped id differs)
    /// and must be `cow_clone`d before an in-place write.
    pub fn cow_needed(self: &MemorySnapshot, h: *mut u8) -> bool {
        return unsafe { node_snapshot(h) != (*self.d()).id };
    }

    // — directory: container roots in this version (a CoW dirmap tree) —

    pub fn has_ctr(self: &MemorySnapshot, ctr_id: u64) -> bool {
        return unsafe { dir_has((*self.d()).dir_root, (*self.d()).dir_level, ctr_id) };
    }

    /// (root, level) for `ctr_id`; asserts the container is registered. `level`
    /// is read from the root node's own header. READ path — no CoW.
    pub fn root_of(self: &MemorySnapshot, ctr_id: u64) -> DirEntry {
        unsafe {
            let root: u64 = dir_get((*self.d()).dir_root, (*self.d()).dir_level, ctr_id);
            assert(root != 0u64, "directory: unknown container id");
            let rp: *mut u8 = root as *mut u8;
            return DirEntry { ctr_id: ctr_id, root: rp, level: node_level(rp) };
        }
    }

    /// The MUTATION-path root read: CoW-privatize this snapshot's directory path
    /// to `ctr_id`'s leaf FIRST (acquiring this snapshot's ownership of the
    /// container roots on the touched leaf), then return `(root, level)`. A
    /// generated handle calls this before running its engine, so the engine's
    /// own release of the old root is balanced by the ownership acquired here;
    /// the following `set_root` then only repoints the (now private) slot.
    pub fn root_of_mut(self: &MemorySnapshot, ctr_id: u64) -> DirEntry {
        unsafe {
            let cur: u64 = (*self.d()).id;
            let p: DirPriv = dir_privatize((*self.d()).dir_root, (*self.d()).dir_level, ctr_id, cur);
            (*self.d()).dir_root = p.root;
            (*self.d()).dir_level = p.level;
            assert(p.val != 0u64, "directory: unknown container id");
            let rp: *mut u8 = p.val as *mut u8;
            return DirEntry { ctr_id: ctr_id, root: rp, level: node_level(rp) };
        }
    }

    /// Register / repoint `ctr_id`'s root (CoW upsert on the directory tree).
    /// Stamps the root node's level into its header so the directory can release
    /// it later (`node_level`), then repoints the descriptor's `dir_root`. The
    /// directory OWNS the container root's refcount: the caller must leave the
    /// OLD root's rc untouched by the mutation (dir_set releases the displaced
    /// root); a root reused inside the NEW root's subtree is inc_rc'd by the
    /// caller's graft (see the generated handles).
    pub fn set_root(self: &MemorySnapshot, ctr_id: u64, root: *mut u8, level: u32) {
        unsafe {
            node_set_level(root, level);
            let cur: u64 = (*self.d()).id;
            let nr: DirRoot = dir_set((*self.d()).dir_root, (*self.d()).dir_level,
                                      ctr_id, root as u64, cur);
            (*self.d()).dir_root = nr.root;
            (*self.d()).dir_level = nr.level;
        }
    }

    /// The registered container ids (Memoria container_names), in key order.
    pub fn container_ids(self: &MemorySnapshot) -> Vec<u64> {
        let mut out: Vec<u64> = vec_new::<u64>();
        unsafe { dir_keys((*self.d()).dir_root, (*self.d()).dir_level, &mut out); }
        return out;
    }

    // — debugging: dump node data to structured text (Memoria dump_*) —

    /// A structured-text dump of container `ctr_id`'s whole tree in this
    /// snapshot (header + columns per node, children indented). Dump before and
    /// after an operation and compare to SEE what it changed.
    pub fn dump_ctr(self: &MemorySnapshot, ctr_id: u64) -> String {
        let e: DirEntry = self.root_of(ctr_id);
        return tree_dump_string(e.root, e.level);
    }

    /// A structured-text dump of the snapshot's DIRECTORY tree itself (the
    /// `CtrID → root` map); leaf value-refs are the container roots (hex).
    pub fn dump_dir(self: &MemorySnapshot) -> String {
        unsafe { return tree_dump_string((*self.d()).dir_root, (*self.d()).dir_level); }
    }

    /// The root→leaf SPINE toward `key` in container `ctr_id` (`keep` = leaf +
    /// keep-1 ancestors, 0 = whole path). The focused view for a mutation.
    pub fn dump_ctr_path(self: &MemorySnapshot, ctr_id: u64, key: u64, keep: u32) -> String {
        let e: DirEntry = self.root_of(ctr_id);
        return path_dump_string(e.root, e.level, key, keep);
    }

    /// The directory's root→leaf spine toward `ctr_id` (which dir leaf routes it).
    pub fn dump_dir_path(self: &MemorySnapshot, ctr_id: u64, keep: u32) -> String {
        unsafe { return path_dump_string((*self.d()).dir_root, (*self.d()).dir_level, ctr_id, keep); }
    }

    /// Verify container `ctr_id`'s tree invariants; returns a report string
    /// (leading line = violation count, then one line per violation, naming the
    /// node). Clean tree ⇒ "check: 0 violation(s)".
    pub fn check_ctr(self: &MemorySnapshot, ctr_id: u64) -> String {
        let e: DirEntry = self.root_of(ctr_id);
        return check_tree_report(e.root, e.level);
    }

    /// Verify the DIRECTORY tree's own invariants (the `CtrID → root` map).
    pub fn check_dir(self: &MemorySnapshot) -> String {
        unsafe { return check_tree_report((*self.d()).dir_root, (*self.d()).dir_level); }
    }

    /// The directory's violation COUNT (0 = well-formed) — for gating a check
    /// into a test without parsing the report.
    pub fn check_dir_count(self: &MemorySnapshot) -> u64 {
        let mut s: String = String::new();
        return unsafe { check_tree((*self.d()).dir_root, (*self.d()).dir_level, &mut s) };
    }

    /// Container `ctr_id`'s violation COUNT (0 = well-formed).
    pub fn check_ctr_count(self: &MemorySnapshot, ctr_id: u64) -> u64 {
        let e: DirEntry = self.root_of(ctr_id);
        let mut s: String = String::new();
        return unsafe { check_tree(e.root, e.level, &mut s) };
    }

    // — lifecycle lives on `impl Snapshot for MemorySnapshot` below (the PUBLIC
    //   tier: commit/remove/status ride the dyn vtable so a `dyn Snapshot`
    //   holder can call them). The PRIVILEGED capability above stays inherent.
}

// Closing the LAST wrapper of an Active or Dropped entry physically releases
// the entry (rc-release every tree, forget the descriptor). A Committed
// entry's wrappers close without touching it — `store.find(id)` re-mints.
impl Drop for MemorySnapshot {
    fn drop(self: &mut MemorySnapshot) {
        unsafe {
            if self.desc == (0 as *mut SnapDesc) { return; }
            let old: i32 = (&mut (*self.desc).wrappers as *mut AtomicI32).fetch_sub(1);
            if old != 1i32 { return; }              // not the last wrapper
            let st: u32 = (*self.desc).status;
            if st == SNAP_COMMITTED { return; }     // history entry lives on
            // Active (uncommitted dies with its last wrapper) or Dropped
            // (marked): release this version's directory tree — ONE cascade
            // that frees every container root through the leaves' value-refs.
            tree_release((*self.desc).dir_root, (*self.desc).dir_level);
            // LOCK POINT (v1): descriptor unlink vs concurrent find().
            let g: &mut MemoryStore = &mut *self.store;
            g.forget(self.desc);
        }
    }
}

// The PUBLIC tier (logos.mem.bt.map): the id plane + lifecycle. This vtable is
// the whole surface a `dyn Snapshot` holder (user/Deem code) sees — the
// privileged capability (node_alloc/root_of/set_root/…) is inherent above and
// deliberately NOT here.
impl Snapshot for MemorySnapshot {
    pub fn snapshot_id(self: &MemorySnapshot) -> u64 {
        return unsafe { (*self.desc).id };
    }

    /// Publishes THIS snapshot and marks its history entry COMMITTED: the
    /// branch it is bound to (`master` unless `set_as_branch` rebound it)
    /// advances its tip to this id. The wrapper reaches the store through its
    /// parent hold — the surface stays `&self` (the wrapper is never mutated;
    /// the store is the honest mutation point, reached via a local Arc hold).
    /// The wrapper stays open afterwards: store_find / open_ctr now resolve
    /// this snapshot's trees.
    pub fn commit(self: &MemorySnapshot) {
        // LOCK POINT (v1): branch-tip advance vs concurrent fork/find.
        let mut hold: Arc<MemoryStore> = self.store.clone_ref();
        let g: &mut MemoryStore = &mut *hold;
        g.commit(self);
    }

    pub fn snapshot_parent(self: &MemorySnapshot) -> u64 {
        return unsafe { (*self.d()).parent };
    }

    /// Rebinds this snapshot's branch (Memoria set_as_branch): stores the name
    /// on the descriptor AND materializes the branch ref now (pointing at this
    /// snapshot's current tip if already committed, else left for commit to
    /// advance). Reaches the store through the parent hold.
    pub fn set_as_branch(self: &MemorySnapshot, name: str) {
        unsafe {
            (*self.d()).branch.clear();
            (*self.d()).branch.push_str(name);
            let committed: bool = (*self.d()).status == SNAP_COMMITTED;
            let id: u64 = (*self.d()).id;
            let mut hold: Arc<MemoryStore> = self.store.clone_ref();
            let g: &mut MemoryStore = &mut *hold;
            // Ensure the branch exists; if this snapshot is already committed,
            // point the branch at it right away (a committed snapshot rebranded
            // becomes that branch's head).
            g.ensure_branch(name);
            if committed { g.set_branch_tip(name, id); }
        }
    }

    /// MARKS this history entry for deletion (Memoria snapshot drop()): the
    /// entry stays until the LAST wrapper for it closes; then its trees are
    /// rc-released and the descriptor is forgotten. The committed HEAD holds its
    /// OWN rc-shares, so removing a committed snapshot never pulls trees out
    /// from under HEAD.
    pub fn remove(self: &MemorySnapshot) {
        // LOCK POINT (v1 single-threaded): status write vs concurrent find().
        unsafe { (*self.d()).status = SNAP_DROPPED; }
    }

    pub fn status(self: &MemorySnapshot) -> u32 {
        return unsafe { (*self.d()).status };
    }
}

// ── MemoryStore: the snapshot DAG + named branches ──────────────────────────

/// Owns the monotonic snapshot-id sequence, the history table (the DAG's
/// nodes), and the named-branch refs (the DAG's mutable heads). `fork` opens a
/// mutable child of a branch tip (or any snapshot) sharing its trees; `commit`
/// advances the snapshot's branch to it — every container the snapshot touched
/// moves together (the Memoria multi-container guarantee). Committed snapshots
/// are RETAINED (findable by id), each holding its own structural shares, so
/// there is no single mutable HEAD: a branch ref is a pure id pointer.
pub struct MemoryStore {
    next_id: u64,
    snaps: Vec<u64>,           // live SnapDesc* (Box-stable), the history table
    branches: Vec<BranchRef>,  // named refs; `master` always present
}

impl MemoryStore {
    // (internal) the bare store value — the public constructor is store_new(),
    // which wraps it in the Arc every parent hold clones. Born with an empty
    // `master` branch (tip 0 = no commit yet).
    static fn new_guts() -> MemoryStore {
        let mut brs: Vec<BranchRef> = vec_new::<BranchRef>();
        brs.push(BranchRef { name: String::from(MASTER_BRANCH), tip: 0u64 });
        return MemoryStore { next_id: 1u64, snaps: vec_new::<u64>(), branches: brs };
    }

    // ── branch table (linear scan; branches are few) ──────────────────────

    fn branch_index(self: &MemoryStore, name: str) -> i64 {
        let n: i64 = self.branches.len();
        let mut i: i64 = 0i64;
        while i < n {
            if self.branches.borrow(i).name.eq_str(name) { return i; }
            i = i + 1i64;
        }
        return -1i64;
    }

    /// Branch tip id, or 0 if the branch is absent/empty.
    fn branch_tip(self: &MemoryStore, name: str) -> u64 {
        let i: i64 = self.branch_index(name);
        if i < 0i64 { return 0u64; }
        return self.branches.borrow(i).tip;
    }

    /// Create the branch if absent (tip 0).
    fn ensure_branch(self: &mut MemoryStore, name: str) {
        if self.branch_index(name) < 0i64 {
            self.branches.push(BranchRef { name: String::from(name), tip: 0u64 });
        }
    }

    /// Point a branch at `id` (creating it if absent).
    fn set_branch_tip(self: &mut MemoryStore, name: str, id: u64) {
        let i: i64 = self.branch_index(name);
        if i < 0i64 {
            self.branches.push(BranchRef { name: String::from(name), tip: id });
            return;
        }
        unsafe { (*self.branches.at(i)).tip = id; }
    }

    fn remove_branch(self: &mut MemoryStore, name: str) {
        let i: i64 = self.branch_index(name);
        if i >= 0i64 { let _ = self.branches.remove(i); }   // BranchRef move-drops its String
    }

    // (internal) locate a descriptor by id (any status), or null.
    fn desc_of(self: &MemoryStore, id: u64) -> *mut SnapDesc {
        let n: i64 = self.snaps.len();
        let mut i: i64 = 0i64;
        while i < n {
            let d: *mut SnapDesc = self.snaps.get(i) as *mut SnapDesc;
            if unsafe { (*d).id } == id { return d; }
            i = i + 1i64;
        }
        return 0 as *mut SnapDesc;
    }

    // (internal) allocate a fresh ACTIVE descriptor as a child of `parent`
    // (0 = root), on `branch`. A root gets a FRESH empty directory; a child
    // SHARES the parent's directory tree with one inc_rc (O(1) fork — the CoW
    // copy happens lazily, per touched leaf, on the first mutation). Returns it
    // with its first wrapper slot accounted.
    fn fork_desc(self: &mut MemoryStore, parent: u64, branch: str) -> *mut SnapDesc {
        let id: u64 = self.next_id;
        self.next_id = self.next_id + 1u64;
        let mut dr: *mut u8 = 0 as *mut u8;
        let mut dl: u32 = 0u32;
        let mut pd: *mut SnapDesc = 0 as *mut SnapDesc;
        if parent != 0u64 { pd = self.desc_of(parent); }
        if pd == (0 as *mut SnapDesc) {
            let dn: DirRoot = unsafe { dir_new(id) };
            dr = dn.root; dl = dn.level;
        } else {
            unsafe {
                dr = (*pd).dir_root;
                dl = (*pd).dir_level;
                node_inc_rc(dr);                 // share the parent's directory tree
            }
        }
        let d: *mut SnapDesc = box_into_raw(box_new(SnapDesc {
            id: id, parent: parent, branch: String::from(branch),
            dir_root: dr, dir_level: dl,
            status: SNAP_ACTIVE, wrappers: atomic_i32_new(1),
        }));
        // LOCK POINT (v1): history-table insert vs concurrent find().
        self.snaps.push(d as u64);
        return d;
    }

    // (internal) find a COMMITTED descriptor and account one more wrapper.
    fn find_desc(self: &mut MemoryStore, id: u64) -> *mut SnapDesc {
        // LOCK POINT (v1): table scan + counter bump vs a concurrent close.
        let n: i64 = self.snaps.len();
        let mut i: i64 = 0i64;
        while i < n {
            let d: *mut SnapDesc = self.snaps.get(i) as *mut SnapDesc;
            unsafe {
                if (*d).id == id {
                    if (*d).status != SNAP_COMMITTED {
                        return 0 as *mut SnapDesc;
                    }
                    let _ = (&mut (*d).wrappers as *mut AtomicI32).fetch_add(1);
                    return d;
                }
            }
            i = i + 1i64;
        }
        return 0 as *mut SnapDesc;
    }

    // Unlink + free a descriptor (the last wrapper of an Active/Dropped entry
    // just released its trees). Memoria forget_snapshot.
    fn forget(self: &mut MemoryStore, d: *mut SnapDesc) {
        let n: i64 = self.snaps.len();
        let mut i: i64 = 0i64;
        while i < n {
            if (self.snaps.get(i) as *mut SnapDesc) == d {
                self.snaps.remove(i);
                let _ = unsafe { box_from_raw(d) };   // Box drop frees the desc
                return;
            }
            i = i + 1i64;
        }
    }

    // (internal) Marks `snap` COMMITTED and advances its branch's tip to it.
    // No tree-share transfer: the committed descriptor already owns its own
    // structural shares (retained until the entry is reclaimed), so the branch
    // is a pure id pointer. The public surface is MemorySnapshot::commit().
    fn commit(self: &mut MemoryStore, snap: &MemorySnapshot) {
        unsafe {
            (*snap.desc).status = SNAP_COMMITTED;
            let id: u64 = (*snap.desc).id;
            let br: str = (*snap.desc).branch.as_str();
            self.set_branch_tip(br, id);
        }
    }

    /// Store END OF LIFE (the C++ ~store/free_memory analog) — run by Drop
    /// when the LAST Arc closes. The parent holds guarantee every wrapper is
    /// already gone, so the history drain only ever sees unwrapped entries
    /// (the DROPPED-marking branch is defensive). Every committed descriptor
    /// owns its trees, so draining the history table releases them all — there
    /// is no separate HEAD to unwind.
    fn eol_release(self: &mut MemoryStore) {
        // drain the history table
        let mut k: i64 = 0i64;
        while k < self.snaps.len() {
            let d: *mut SnapDesc = self.snaps.get(k) as *mut SnapDesc;
            unsafe {
                if (&mut (*d).wrappers as *mut AtomicI32).load() == 0i32 {
                    tree_release((*d).dir_root, (*d).dir_level);
                    self.snaps.remove(k);
                    let _ = box_from_raw(d);
                } else {
                    (*d).status = SNAP_DROPPED;   // last wrapper close cleans up
                    k = k + 1i64;
                }
            }
        }
    }
}

impl Drop for MemoryStore {
    fn drop(self: &mut MemoryStore) {
        self.eol_release();
    }
}

// ── the Arc plane of the STORE itself ───────────────────────────────────────
// The store is created INTO an Arc; snapshots (and, through them, containers)
// hold Arc clones of their PARENT, so the ownership chain
//     Ctr ──Arc→ Snapshot wrapper ──Arc→ Store
// keeps every parent alive exactly as long as any child lives. There is no
// manual store.release(): the LAST Arc drop runs the store's Drop (HEAD +
// history teardown), and the parent holds guarantee no wrapper outlives it.
// fork/find are free fns over &mut Arc — a method cannot clone the Arc that
// holds its own receiver (no shared_from_this; the C++ side uses exactly
// that in snp_make_shared_init).

pub fn store_new() -> Arc<MemoryStore> {
    return arc_new(MemoryStore::new_guts());
}

/// Opens a fresh mutable snapshot as a child of the `master` tip (the default
/// flow): a new history entry + its first wrapper, which HOLDS the store (an
/// Arc clone). On a fresh store master is empty (tip 0) → this is a root
/// snapshot with an empty directory.
pub fn store_fork(st: &mut Arc<MemoryStore>) -> MemorySnapshot {
    let hold: Arc<MemoryStore> = st.clone_ref();
    let g: &mut MemoryStore = &mut **st;
    let tip: u64 = g.branch_tip(MASTER_BRANCH);
    let d: *mut SnapDesc = g.fork_desc(tip, MASTER_BRANCH);
    return MemorySnapshot { desc: d, store: hold };
}

/// The cross-thread form: the wrapper rides an Arc, ERASED to `Arc<dyn Snapshot>`
/// — the public tier. Users and Deem code hold this; the id plane + lifecycle
/// are all the vtable exposes. The Canon-generated container recovers the
/// concrete `MemorySnapshot` internally for the privileged capability.
pub fn store_fork_arc(st: &mut Arc<MemoryStore>) -> Arc<dyn Snapshot> {
    return arc_new::<MemorySnapshot>(store_fork(st)) as Arc<dyn Snapshot>;
}

/// A NEW wrapper over an existing COMMITTED entry, erased to `Arc<dyn Snapshot>`
/// — one per call (one per thread in MT use); active/dropped entries are not
/// findable.
pub fn store_find(st: &mut Arc<MemoryStore>, id: u64) -> Option<Arc<dyn Snapshot>> {
    let g: &mut MemoryStore = &mut **st;
    let d: *mut SnapDesc = g.find_desc(id);
    if d == (0 as *mut SnapDesc) {
        return Option::None;
    }
    let hold: Arc<MemoryStore> = st.clone_ref();
    let snap: MemorySnapshot = MemorySnapshot { desc: d, store: hold };
    return Option::Some(arc_new::<MemorySnapshot>(snap) as Arc<dyn Snapshot>);
}

// ── named branches: fork / find / master ────────────────────────────────────

// (internal) mint a dyn-erased wrapper over an existing COMMITTED descriptor
// found by id, or None. Shared by find/master/find_branch.
fn wrap_committed(st: &mut Arc<MemoryStore>, id: u64) -> Option<Arc<dyn Snapshot>> {
    return store_find(st, id);
}

/// Forks a fresh mutable child of a NAMED branch's tip (Memoria
/// `find_branch(name)->branch()`). The child inherits the branch, so its commit
/// advances that branch. None if the branch does not exist. If the branch
/// exists but is empty (tip 0) the child is a root on that branch.
pub fn store_fork_branch(st: &mut Arc<MemoryStore>, name: str) -> Option<Arc<dyn Snapshot>> {
    let hold: Arc<MemoryStore> = st.clone_ref();
    let g: &mut MemoryStore = &mut **st;
    if g.branch_index(name) < 0i64 { return Option::None; }
    let tip: u64 = g.branch_tip(name);
    let d: *mut SnapDesc = g.fork_desc(tip, name);
    let snap: MemorySnapshot = MemorySnapshot { desc: d, store: hold };
    return Option::Some(arc_new::<MemorySnapshot>(snap) as Arc<dyn Snapshot>);
}

/// Forks a fresh mutable child of a SPECIFIC snapshot (Memoria
/// `snapshot->branch()`): the DAG grows a new node with `parent_id` as its
/// parent, inheriting that snapshot's branch tag. None if `parent_id` is
/// unknown or not committed (you branch off committed history).
pub fn store_fork_from(st: &mut Arc<MemoryStore>, parent_id: u64) -> Option<Arc<dyn Snapshot>> {
    let hold: Arc<MemoryStore> = st.clone_ref();
    let g: &mut MemoryStore = &mut **st;
    let pd: *mut SnapDesc = g.desc_of(parent_id);
    if pd == (0 as *mut SnapDesc) { return Option::None; }
    if unsafe { (*pd).status } != SNAP_COMMITTED { return Option::None; }
    let br: str = unsafe { (*pd).branch.as_str() };
    let d: *mut SnapDesc = g.fork_desc(parent_id, br);
    let snap: MemorySnapshot = MemorySnapshot { desc: d, store: hold };
    return Option::Some(arc_new::<MemorySnapshot>(snap) as Arc<dyn Snapshot>);
}

/// A read wrapper over a named branch's tip snapshot (Memoria `find_branch`).
/// None if the branch is absent or empty (tip 0).
pub fn store_find_branch(st: &mut Arc<MemoryStore>, name: str) -> Option<Arc<dyn Snapshot>> {
    let tip: u64 = { let g: &mut MemoryStore = &mut **st; g.branch_tip(name) };
    if tip == 0u64 { return Option::None; }
    return wrap_committed(st, tip);
}

/// A read wrapper over the `master` tip (Memoria `master()`). None if master
/// is empty (no commit yet).
pub fn store_master(st: &mut Arc<MemoryStore>) -> Option<Arc<dyn Snapshot>> {
    return store_find_branch(st, MASTER_BRANCH);
}

/// Points a named branch at a snapshot id (Memoria `set_branch`), creating the
/// branch if absent. Asserts the id names a committed snapshot.
pub fn store_set_branch(st: &mut Arc<MemoryStore>, name: str, id: u64) {
    let g: &mut MemoryStore = &mut **st;
    let d: *mut SnapDesc = g.desc_of(id);
    assert(d != (0 as *mut SnapDesc), "store_set_branch: unknown snapshot id");
    assert(unsafe { (*d).status } == SNAP_COMMITTED,
           "store_set_branch: a branch may only point at a committed snapshot");
    g.set_branch_tip(name, id);
}

/// Points `master` at a snapshot id (Memoria `set_master`).
pub fn store_set_master(st: &mut Arc<MemoryStore>, id: u64) {
    store_set_branch(st, MASTER_BRANCH, id);
}

/// Removes a named branch ref (Memoria `remove_named_branch`). The snapshots it
/// pointed at stay in history (findable by id) until dropped + packed. Removing
/// `master` is allowed but unusual.
pub fn store_remove_branch(st: &mut Arc<MemoryStore>, name: str) {
    let g: &mut MemoryStore = &mut **st;
    g.remove_branch(name);
}

/// Marks a COMMITTED snapshot for deletion BY ID, no wrapper required (the
/// store-level analog of `MemorySnapshot::remove`). Unlike the wrapper form —
/// which reclaims eagerly when its last wrapper closes (RAII) — this defers the
/// physical release to `store_pack`, matching Memoria's drop-marks / pack-frees
/// split. A dropped snapshot is no longer `store_find`-able. Asserts the id
/// names a committed snapshot; a snapshot with committed children or a live
/// branch ref survives pack until those clear.
pub fn store_drop(st: &mut Arc<MemoryStore>, id: u64) {
    let g: &mut MemoryStore = &mut **st;
    let d: *mut SnapDesc = g.desc_of(id);
    assert(d != (0 as *mut SnapDesc), "store_drop: unknown snapshot id");
    assert(unsafe { (*d).status } == SNAP_COMMITTED,
           "store_drop: only a committed snapshot can be dropped");
    unsafe { (*d).status = SNAP_DROPPED; }
}

/// All branch names (Memoria `branch_names`).
pub fn store_branches(st: &Arc<MemoryStore>) -> Vec<String> {
    let g: &MemoryStore = &**st;
    let mut out: Vec<String> = vec_new::<String>();
    let n: i64 = g.branches.len();
    let mut i: i64 = 0i64;
    while i < n {
        out.push(String::from(g.branches.borrow(i).name.as_str()));
        i = i + 1i64;
    }
    return out;
}

/// A branch's tip id, 0 if absent/empty (Memoria `branch_head`).
pub fn store_branch_head(st: &Arc<MemoryStore>, name: str) -> u64 {
    let g: &MemoryStore = &**st;
    return g.branch_tip(name);
}

/// Every branch's tip id (Memoria `branch_heads`).
pub fn store_branch_heads(st: &Arc<MemoryStore>) -> Vec<u64> {
    let g: &MemoryStore = &**st;
    let mut out: Vec<u64> = vec_new::<u64>();
    let n: i64 = g.branches.len();
    let mut i: i64 = 0i64;
    while i < n { out.push(g.branches.borrow(i).tip); i = i + 1i64; }
    return out;
}

// ── lineage: the snapshot DAG ────────────────────────────────────────────────

/// The parent of a snapshot (0 = a root / unknown id) — Memoria
/// `snapshot_parent`.
pub fn store_snapshot_parent(st: &Arc<MemoryStore>, id: u64) -> u64 {
    let g: &MemoryStore = &**st;
    let d: *mut SnapDesc = g.desc_of(id);
    if d == (0 as *mut SnapDesc) { return 0u64; }
    return unsafe { (*d).parent };
}

/// The direct children of a snapshot (Memoria `children_of`): every descriptor
/// whose parent is `id`.
pub fn store_children_of(st: &Arc<MemoryStore>, id: u64) -> Vec<u64> {
    let g: &MemoryStore = &**st;
    let mut out: Vec<u64> = vec_new::<u64>();
    let n: i64 = g.snaps.len();
    let mut i: i64 = 0i64;
    while i < n {
        let d: *mut SnapDesc = g.snaps.get(i) as *mut SnapDesc;
        if unsafe { (*d).parent } == id { out.push(unsafe { (*d).id }); }
        i = i + 1i64;
    }
    return out;
}

/// The first root snapshot's id (Memoria `root_shaphot_id`): the earliest
/// committed descriptor forked from the empty store. 0 if none committed yet.
pub fn store_root_id(st: &Arc<MemoryStore>) -> u64 {
    let g: &MemoryStore = &**st;
    let n: i64 = g.snaps.len();
    let mut i: i64 = 0i64;
    while i < n {
        let d: *mut SnapDesc = g.snaps.get(i) as *mut SnapDesc;
        unsafe {
            if (*d).parent == 0u64 && (*d).status == SNAP_COMMITTED { return (*d).id; }
        }
        i = i + 1i64;
    }
    return 0u64;
}

/// The DAG's committed leaves (Memoria `heads`): committed snapshots with no
/// committed child. Distinct from `store_branch_heads` — a leaf need not carry
/// a branch ref (a dangling head after a concurrent commit).
pub fn store_heads(st: &Arc<MemoryStore>) -> Vec<u64> {
    let g: &MemoryStore = &**st;
    let mut out: Vec<u64> = vec_new::<u64>();
    let n: i64 = g.snaps.len();
    let mut i: i64 = 0i64;
    while i < n {
        let d: *mut SnapDesc = g.snaps.get(i) as *mut SnapDesc;
        if unsafe { (*d).status } == SNAP_COMMITTED {
            let id: u64 = unsafe { (*d).id };
            let mut has_child: bool = false;
            let mut j: i64 = 0i64;
            while j < n {
                let e: *mut SnapDesc = g.snaps.get(j) as *mut SnapDesc;
                unsafe {
                    if (*e).parent == id && (*e).status == SNAP_COMMITTED { has_child = true; }
                }
                j = j + 1i64;
            }
            if !has_child { out.push(id); }
        }
        i = i + 1i64;
    }
    return out;
}

/// The linear ancestry from `start_id` to `stop_id` inclusive (Memoria
/// `linear_history`): walks `stop`'s parent chain until it reaches `start`,
/// returned oldest→newest. Empty if `start` is not an ancestor of `stop`.
pub fn store_linear_history(st: &Arc<MemoryStore>, start_id: u64, stop_id: u64) -> Vec<u64> {
    let g: &MemoryStore = &**st;
    let mut rev: Vec<u64> = vec_new::<u64>();
    let mut cur: u64 = stop_id;
    let mut reached: bool = false;
    loop {
        if cur == 0u64 { break; }
        let d: *mut SnapDesc = g.desc_of(cur);
        if d == (0 as *mut SnapDesc) { break; }
        rev.push(cur);
        if cur == start_id { reached = true; break; }
        cur = unsafe { (*d).parent };
    }
    let mut out: Vec<u64> = vec_new::<u64>();
    if !reached { return out; }              // start not on stop's ancestry
    let mut k: i64 = rev.len() - 1i64;
    while k >= 0i64 { out.push(rev.get(k)); k = k - 1i64; }
    return out;
}

/// A snapshot's lifecycle status (Memoria `snapshot_status`): ACTIVE /
/// COMMITTED / DROPPED, or DROPPED-as-absent for an unknown id.
pub fn store_snapshot_status(st: &Arc<MemoryStore>, id: u64) -> u32 {
    let g: &MemoryStore = &**st;
    let d: *mut SnapDesc = g.desc_of(id);
    if d == (0 as *mut SnapDesc) { return SNAP_DROPPED; }
    return unsafe { (*d).status };
}

/// The count of ACTIVE (uncommitted) snapshots (Memoria `active_snapshots`).
pub fn store_active_snapshots(st: &Arc<MemoryStore>) -> i64 {
    let g: &MemoryStore = &**st;
    let mut c: i64 = 0i64;
    let n: i64 = g.snaps.len();
    let mut i: i64 = 0i64;
    while i < n {
        let d: *mut SnapDesc = g.snaps.get(i) as *mut SnapDesc;
        if unsafe { (*d).status } == SNAP_ACTIVE { c = c + 1i64; }
        i = i + 1i64;
    }
    return c;
}

/// Reclaims DROPPED leaf snapshots (Memoria `pack`, v0): a descriptor marked
/// DROPPED, with no committed child, no branch ref pointing at it, and no open
/// wrapper, has its trees released and is forgotten. Returns the count
/// reclaimed. History compaction (collapsing single-child committed chains)
/// stays for a later increment.
pub fn store_pack(st: &mut Arc<MemoryStore>) -> i64 {
    let g: &mut MemoryStore = &mut **st;
    let mut reclaimed: i64 = 0i64;
    let mut progress: bool = true;
    // Iterate to a fixpoint: reclaiming a leaf can expose its parent as a leaf.
    while progress {
        progress = false;
        let mut k: i64 = 0i64;
        while k < g.snaps.len() {
            let d: *mut SnapDesc = g.snaps.get(k) as *mut SnapDesc;
            let mut reclaim: bool = false;
            unsafe {
                if (*d).status == SNAP_DROPPED
                    && (&mut (*d).wrappers as *mut AtomicI32).load() == 0i32 {
                    let id: u64 = (*d).id;
                    reclaim = !g.has_committed_child(id) && !g.is_branch_tip(id);
                }
            }
            if reclaim {
                unsafe {
                    tree_release((*d).dir_root, (*d).dir_level);
                    g.snaps.remove(k);
                    let _ = box_from_raw(d);
                }
                reclaimed = reclaimed + 1i64;
                progress = true;
            } else {
                k = k + 1i64;
            }
        }
    }
    return reclaimed;
}

impl MemoryStore {
    fn has_committed_child(self: &MemoryStore, id: u64) -> bool {
        let n: i64 = self.snaps.len();
        let mut i: i64 = 0i64;
        while i < n {
            let d: *mut SnapDesc = self.snaps.get(i) as *mut SnapDesc;
            unsafe {
                if (*d).parent == id && (*d).status == SNAP_COMMITTED { return true; }
            }
            i = i + 1i64;
        }
        return false;
    }

    fn is_branch_tip(self: &MemoryStore, id: u64) -> bool {
        let n: i64 = self.branches.len();
        let mut i: i64 = 0i64;
        while i < n {
            if self.branches.borrow(i).tip == id { return true; }
            i = i + 1i64;
        }
        return false;
    }
}

impl Store for MemoryStore {}
