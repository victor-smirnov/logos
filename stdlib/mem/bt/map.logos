// logos.mem.bt.map — the fundamental container interfaces (ADR 0020 Track B):
//
//   trait Store    — owns blocks + snapshot lifecycle (open/commit/reclaim)
//   trait Snapshot — a consistent version; the source of the CoW skip key
//   trait Ctr      — a container handle opened from a snapshot (Map/Vector/…)
//
// (Canonical Logos naming: no `I`-prefix — a trait IS the interface. `Container`
// is already the element contract, so the handle role is `Ctr`.)
//
// These are pure INTERFACES. The concrete CoW/snapshot machinery is no longer
// hand-written here: the Canon container generator (logos.lcm.canon) emits the
// whole leaf/branch/tree/CoW-map stack for any concrete key/value type and its
// generated CoW-map `impl`s these three traits — the declaring unit `use`s this
// module solely to bring the trait definitions into scope.
package logos.mem.bt.map;

// The generated CoW-map's body calls the intrusive-rc node primitives
// (node_snapshot/inc_rc/dec_rc/free). A metaprog-emitted `use` cannot itself
// load a module, so this hub module carries the edge: a consumer's single
// `use logos.mem.bt.map;` transitively brings logos.mem.bt.node into the
// generated unit's module graph.
use logos.mem.bt.node;
// S2b/B: the generated leaves call the btss single-stream substrate
// (btss_fmt_slot / btss_split_col / btss_count). Same hub rule as node above —
// a metaprog-emitted `use` cannot itself load a module, so this import
// carries the edge into every generated unit's module graph.
use logos.mem.bt.btss;
use logos.mem.collections.vec;   // Vec — the Multimap boundary signatures

/// Owns blocks and the snapshot lifecycle. The concrete factory methods
/// (`fork`, `commit`, …) live on the implementor — stores are FEW and very
/// different (MemoryStore / SWMRStore / OLTPStore), so `Store` stays a marker
/// and the lifecycle surface is hand-written per store, not generalized.
pub trait Store {}

/// A consistent version of a store; containers are opened from it. Its id is the
/// CoW skip key stamped into every node the snapshot writes.
///
/// This trait stays a minimal MARKER on purpose (ADR 0020 Track B,
/// container⟂store split — emitter-parameterized). The full STORAGE CAPABILITY a
/// container reaches through — node allocation, refcounting, `u64` child-ref
/// resolution, the CoW skip key — lives as INHERENT methods on each hand-written
/// snapshot (see `logos.mem.bt.memstore::MemorySnapshot`): the Canon container
/// generator emits store-specialized CONCRETE calls against it, so nothing
/// consumes the capability generically and it need not inflate this contract.
/// When a second store lands (SWMR/OLTP) and enforcing the surface across stores
/// starts to pay off, the capability graduates to required trait methods here.
pub trait Snapshot {
    fn snapshot_id(self: &Self) -> u64;
    /// The BOUNDARY form of the snapshot id (S3): the opaque 256-bit POD the
    /// compiled Deem plane holds regardless of the store's internal id type.
    /// The default lifts a u64 id (the MemoryStore case); a store with wide
    /// ids overrides. Object-safe — `&dyn Snapshot` is the Deem-facing plane.
    fn snapshot_uid(self: &Self) -> Uid256 {
        return uid256_from_u64(self.snapshot_id());
    }
}

/// A container handle bound to a snapshot's storage (Map/Vector/Queue/…).
/// The ROOT of the per-family boundary tower (S3): family traits refine it
/// (`trait Multimap: Ctr`), so Deem can hold a uniform `&dyn Ctr` plane
/// (directories, enumeration) and upcast-free family surfaces where it knows
/// the kind. Inside a trait object sits a concrete monomorphized family
/// handle for a concrete StoreCfg — virtual at the boundary, static within.
pub trait Ctr {
    fn size(self: &Self) -> u64;
}

/// The boundary IDENTITY type: an opaque 256-bit POD (fits a UID256). The
/// compiled Deem plane sees ONE layout for snapshot/block/container ids
/// regardless of the store's internal id types; a store maps its own ids in
/// and out at the boundary. Operations beyond copy/compare stay with the
/// store (the BlockID-datatype discipline) — nothing here peeks inside.
pub struct Uid256 {
    pub b: [u64; 4],
}

impl Copy for Uid256 {}

pub fn uid256_zero() -> Uid256 {
    return Uid256 { b: [0u64; 4] };
}

/// A u64-valued id lifted into the boundary form (the MemoryStore case).
pub fn uid256_from_u64(v: u64) -> Uid256 {
    let mut u: Uid256 = uid256_zero();
    u.b[0] = v;
    return u;
}

pub fn uid256_eq(x: &Uid256, y: &Uid256) -> bool {
    let mut i: i64 = 0i64;
    while i < 4i64 {
        if x.b[i] != y.b[i] {
            return false;
        }
        i = i + 1i64;
    }
    return true;
}

/// The 2-stream multimap FAMILY boundary (bt_fl's only client today):
/// key → value sequence. Refines Ctr; the generated family handle implements
/// it, and Deem drives inserts/lookups through `&mut dyn Multimap` without
/// knowing the store or its configuration.
pub trait Multimap: Ctr {
    /// Appends `key`'s value run to `out`; false when the key is absent.
    fn find(self: &Self, key: u64, out: &mut Vec<u64>) -> bool;
    /// Inserts `key → vals`; false when the key already exists.
    fn insert(self: &mut Self, key: u64, vals: &Vec<u64>) -> bool;
}

// ── b+tree node contracts (ADR 0021 ops-reshape) ─────────────────────────────
//
// The leaf/branch surface every Canon-generated node type implements. The
// concrete node stays generated (its PkdArray column layout is K/V-type-
// specific), but the tree ALGORITHMS (descend, insert-with-split, CoW insert,
// free, size) live ONCE in logos.mem.bt.ops as fns generic over these traits.
//
// The traits are DECLARED here (not in ops) deliberately: the generated
// `impl BtLeaf<…> for {N}Leaf` blocks are checked against the DECLARING
// unit's imports at collect time, and every declaring unit already carries
// `use logos.mem.bt.map;` (the same hub contract the generated `impl Ctr`
// rides). ops.logos pulls them from here.

/// A leaf node: a sorted `(K, V)` run in one packed block. `VIn`/`VOut` are
/// asymmetric on purpose — a fast (FSE) leaf has `VIn == VOut == V` (by
/// value), a volume (VLE) leaf takes `VIn = str` and yields `VOut = &[u8]`
/// (a view over the block's bytes).
pub trait BtLeaf<K, VIn, VOut> {
    /// Reinterpret an existing block as `Self` (no allocation).
    fn adopt(mem: *mut u8) -> Self;
    /// Allocate + format a fresh empty leaf shaped LIKE `self` (same geometry,
    /// same column descriptors), stamped with snapshot id `snp` — the split
    /// sibling. SELF-relative on purpose: a multistream leaf's shape is not
    /// recoverable from a static call (the single-stream generated nodes bake
    /// their shape and simply ignore `self`).
    fn new_sibling(self: &Self, snp: u64) -> Self;
    fn block(self: &Self) -> *mut u8;
    fn count(self: &Self) -> u32;
    fn key_at(self: &Self, i: u32) -> K;
    fn val_at(self: &Self, i: u32) -> VOut;
    /// First index whose key is `>= key` (or `count()` if none).
    fn lower_bound(self: &Self, key: K) -> u32;
    /// Upsert in place; `false` iff there is no room (caller must split).
    fn try_insert(self: &mut Self, key: K, val: VIn) -> bool;
    /// Move the upper half of `self`'s entries into `dst` (`dst` starts empty).
    fn split_into(self: &mut Self, dst: &mut Self);
    /// A deep copy of `self`'s entries into a fresh block stamped `snp` (CoW).
    fn cow_clone(self: &Self, snp: u64) -> Self;
    /// Release the block. Consumes `self` — no further use after this call.
    fn free(self: Self);
}

/// A branch node: `child_count()` separator/subtree-counts/child-ref rows,
/// uniformly `(K, [u64; N], *mut u8)` — every generated branch DECLARES which
/// slot holds its child refs in its own node header (`node_set_child_slot`),
/// which is what lets `tree_release` stay container-agnostic without
/// constraining any container's branch layout.
///
/// S2b: the contract is N-ARY — a child's subtree summary is one COUNT PER
/// STREAM (`&[u64; N]`), the multistream (bt_fl) branch shape. A single-stream
/// container is exactly `N = 1` (its one count = the subtree entry count), so
/// the single-stream and the multistream insert protocols share ONE report
/// shape and ONE branch contract instead of drifting as two copies. Counts
/// cross the boundary by reference (`&[u64; N]` / out-param), never by value —
/// the `[T; N]`-across-fn-boundary codegen gap is an open arc.
pub trait BtBranch<K, const N: u32> {
    fn adopt(mem: *mut u8) -> Self;
    /// A fresh empty branch shaped LIKE `self` (the split sibling) — see
    /// BtLeaf::new_sibling for why this is self-relative.
    fn new_sibling(self: &Self, snp: u64) -> Self;
    fn block(self: &Self) -> *mut u8;
    fn child_count(self: &Self) -> u32;
    fn sep_at(self: &Self, i: u32) -> K;
    fn child_addr(self: &Self, i: u32) -> *mut u8;
    fn set_child_addr(self: &mut Self, i: u32, ptr: *mut u8);
    /// The last (= largest) separator; the branch's own subtree-max key.
    fn max_sep(self: &Self) -> K;
    /// Sum of every child's stream-0 count (the entry count for N = 1).
    fn total_size(self: &Self) -> u64;
    /// Per-stream subtree totals, written into `out`.
    fn totals(self: &Self, out: &mut [u64; N]);
    /// Index of the child whose subtree may contain `key` (clamped to the last
    /// child when `key` exceeds every separator; `0` when the branch is empty).
    fn find_child(self: &Self, key: K) -> u32;
    fn push_row(self: &mut Self, sep: K, cnt: &[u64; N], ptr: *mut u8);
    fn insert_row(self: &mut Self, pos: u32, sep: K, cnt: &[u64; N], ptr: *mut u8);
    fn update_row(self: &mut Self, i: u32, sep: K, cnt: &[u64; N]);
    /// `true` iff one more `(sep, counts, ptr)` row fits without a split.
    /// (The *_row methods are DISTINCT names from the concrete nodes' inherent
    /// update_child/insert_child on purpose: an inherent method with the same
    /// name+arity shadows a trait method at mono dispatch — the
    /// method-resolution gap — and the scalar inherent would capture the
    /// N-ary trait call.)
    fn can_insert_child(self: &Self) -> bool;
    /// Move the upper half of `self`'s children into `dst`; returns `self`'s new `max_sep()`.
    fn split_into(self: &mut Self, dst: &mut Self) -> K;
    /// A shallow copy: fresh block, same children (CoW — caller inc_rc's each child).
    fn cow_clone(self: &Self, snp: u64) -> Self;
    /// Release just this block (children are NOT touched — the caller walks them,
    /// e.g. `bt_tree_free`'s explicit recursion or memstore's `tree_release`).
    fn free_block(self: Self);
}
