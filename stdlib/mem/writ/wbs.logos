// Logos Writ stdlib — mem.writ.wbs
//
// HBS2 — binary serialization of a Writ document: doc ⇄ bytes. The Writ
// port of writ.wbs_write / wbs_read, simplified to a self-contained value
// stream (no zone-id dedup yet — every reference is written by value).
//
// Each value = a lead byte + payload, dispatching on WAny::type_code:
//   0x00 null   0x01 false   0x02 true
//   0x10 i56    → 8-byte i64 LE
//   0x30 string → vlen(len) + UTF-8 bytes
//   0x40 array  → vlen(count) + count values
//   0x41 map    → vlen(count) + count × ( vlen(klen) + key bytes + value )
//
// write builds a Vec<u8>; read reconstructs into a caller-supplied Writ arena
// (new strings/arrays/maps are allocated there) and returns the root WAny.

package logos.mem.writ.wbs;

use logos.lang.writ.container;     // Writ, alloc_tagged, writ_alloc_bytes
use logos.lang.writ.allocator;     // Allocator
use logos.lang.writ.anyval;        // WAny, WA_I56, w_type_code
use logos.lang.writ.array;         // WArray<WAny>
use logos.lang.writ.wmap;          // WMap<WString, WAny>
use logos.lang.writ.wstring;       // WString
use logos.lang.writ.typed_value;   // WTypedValue (@Name(params)=init, wire 4115)
use logos.lang.str;                   // str, str_from_raw
use logos.lang.vlen;                  // vlen_read, vlen_prefix_size
use logos.lang.ptr;                   // byte_add
use logos.mem.collections.vec;        // Vec<u8>

// Maximum nesting depth for the recursive (de)serializers. Both walkers recurse
// once per array/map level; an untrusted HBS2 stream can encode a nested array
// in as little as 2 bytes per level (0x40 0x01 …), so byte-length bounds alone do
// NOT bound recursion depth — a ~400 KB "depth bomb" would exhaust the native C
// stack (SIGSEGV) despite every per-read bounds check passing. Past this cap the
// reader sets `err` (→ clean null) and the writer emits a `null` byte for the
// too-deep subtree, keeping both walks total on adversarial input. Mirrors the
// 4096 cap used by the compactify / clone / equal tree walkers; >> real nesting.
const WBS_MAX_DEPTH: i64 = 4096i64;

// ── write ──────────────────────────────────────────────────────────────────
unsafe fn put_vlen(out: &mut Vec<u8>, value: u64) {
    if value < 249u64 { out.push(value as u8); return; }
    let mut n: u32 = 0u32; let mut v: u64 = value;
    while v > 0u64 { v = v >> 8u64; n = n + 1u32; }
    if n > 7u32 { n = 7u32; }
    out.push((248u32 + n) as u8);
    let mut i: u32 = 0u32; let mut rem: u64 = value;
    while i < n { out.push((rem & 0xFFu64) as u8); rem = rem >> 8u64; i = i + 1u32; }
}
unsafe fn put_i64(out: &mut Vec<u8>, x: i64) {
    let mut i: i64 = 0i64;
    while i < 8i64 { out.push(((x >> (i * 8i64)) & 0xFFi64) as u8); i = i + 1i64; }
}
unsafe fn put_bytes(out: &mut Vec<u8>, p: *const u8, n: i64) {
    let mut i: i64 = 0i64;
    while i < n { out.push(*p.byte_add(i)); i = i + 1i64; }
}
unsafe fn put_f64(out: &mut Vec<u8>, x: f64) {
    let tmp: f64 = x;
    let p: *const u8 = &tmp as *const f64 as *const u8;   // reinterpret bytes (no bitcast)
    let mut i: i64 = 0i64;
    while i < 8i64 { out.push(*p.byte_add(i)); i = i + 1i64; }
}
unsafe fn put_str(out: &mut Vec<u8>, s: str) {
    put_vlen(out, s.len() as u64);
    put_bytes(out, s.as_ptr(), s.len());
}

// Element byte-width for a typed dense array wire code (2101..2110) — matches
// mem.writ.stringify::typed_elem_width / mem.writ.equal::elem_width.
unsafe fn typed_elem_width(tc: u64) -> i64 {
    if tc == 2101u64 || tc == 2105u64 { return 1i64; }                  // U8 / I8
    if tc == 2102u64 || tc == 2106u64 { return 2i64; }                  // U16 / I16
    if tc == 2103u64 || tc == 2107u64 || tc == 2109u64 { return 4i64; } // U32 / I32 / F32
    return 8i64;                                                        // U64 / I64 / F64
}

// Serialize a typed dense array {size_:u64@0, cap_:u64@8, data_:RelPtr@16} + its
// raw position-independent element blob: lead 0x50, tc(vlen), size(vlen), bytes.
unsafe fn write_typed_array(out: &mut Vec<u8>, p: *const u8, tc: u64) {
    let size: u64 = *(p as *const u64);
    let dfield: i64 = (p as i64) + 16i64;
    let elems: i64 = dfield + *(dfield as *const i64);   // RelativePtr: (&data_)+offset
    out.push(0x50u8);
    put_vlen(out, tc);
    put_vlen(out, size);
    put_bytes(out, elems as *const u8, (size as i64) * typed_elem_width(tc));
}

// Serialize a typed dense (int-keyed) map {size_:i64@0, cap_:i64@8, keys_:RelPtr@16,
// vals_:RelPtr@24}: lead 0x51, mtc(vlen), size(vlen), then per entry raw key bytes
// (kw) + the value written recursively (values are at-rest WAny words there).
unsafe fn write_typed_map(out: &mut Vec<u8>, p: *const u8, tc: u64, depth: i64) {
    let size: i64 = *(p as *const i64);
    let kfield: i64 = (p as i64) + 16i64;
    let keys: i64 = kfield + *(kfield as *const i64);
    let vfield: i64 = (p as i64) + 24i64;
    let vals: i64 = vfield + *(vfield as *const i64);
    let kw: i64 = if tc == 3101u64 || tc == 3102u64 { 4i64 } else { 8i64 };  // I32/U32 vs I64/U64
    out.push(0x51u8);
    put_vlen(out, tc);
    put_vlen(out, size as u64);
    let mut i: i64 = 0i64;
    while i < size {
        put_bytes(out, (keys + i * kw) as *const u8, kw);
        // value: at-rest WAny word at vals[i], self-relative to its slot → value form.
        let vslot: i64 = vals + i * 8i64;
        let w: i64 = *(vslot as *const i64);
        let vh: WAny =
            if w == 0i64 { WAny::Ref(0i64 as *const u8) }
            else if (w & 1i64) == 1i64 { WAny::Pod(w as u64) }
            else { WAny::Ref((vslot + w) as *const u8) };
        write_val(out, vh, depth + 1i64);
        i = i + 1i64;
    }
}

unsafe fn write_val(out: &mut Vec<u8>, v: WAny, depth: i64) {
    // Depth guard: past the cap, emit a `null` byte for the too-deep subtree
    // instead of recursing, so a pathologically deep tree serializes to bounded
    // bytes rather than overflowing the stack.
    if depth > WBS_MAX_DEPTH { out.push(0u8); return; }
    if v.is_null() { out.push(0u8); return; }
    if v.is_bool() { out.push(if v.as_bool() { 2u8 } else { 1u8 }); return; }
    if v.is_float() { out.push(0x18u8); put_f64(out, v.as_f64()); return; }
    if v.is_int()   { out.push(0x10u8); put_i64(out, v.as_i64()); return; }   // i56 Pod or boxed i64
    if v.is_string() {
        let hs: &WString = &*(v.resolve() as *const WString);
        out.push(0x30u8); put_str(out, hs.as_str()); return;
    }
    if v.is_array() {
        let a: &WArray<WAny> = &*(v.resolve() as *const WArray<WAny>);
        out.push(0x40u8); put_vlen(out, a.len() as u64);
        let mut i: i64 = 0i64;
        while i < a.len() { write_val(out, a.get(i), depth + 1i64); i = i + 1i64; }
        return;
    }
    if v.is_map() {
        let m: &WMap<WString, WAny> = &*(v.resolve() as *const WMap<WString, WAny>);
        out.push(0x41u8); put_vlen(out, m.len() as u64);
        let mut i: i64 = 0i64;
        while i < m.slots() {
            let k: WAny = m.key_at(i);
            if !k.is_null() {
                let ks: &WString = &*(k.resolve() as *const WString);
                put_str(out, ks.as_str());
                write_val(out, m.val_at(i), depth + 1i64);
            }
            i = i + 1i64;
        }
        return;
    }
    // Typed containers produced by `parse` / typed casts (and rendered faithfully
    // by stringify / compared structurally by writ_equal) — serialize with full
    // fidelity so the WRITE→READ cycle stays identity for them too. WITHOUT these
    // arms they reach the terminal `out.push(0u8)` below and silently corrupt to
    // `null` (round-trip data loss), including as subtrees of a supported map/array.
    if v.is_ref() {
        let p: *const u8 = v.resolve();
        let tcv: u64 = w_type_code(p);
        if tcv >= 2101u64 && tcv <= 2110u64 { write_typed_array(out, p, tcv); return; }
        if tcv >= 3101u64 && tcv <= 3104u64 { write_typed_map(out, p, tcv, depth); return; }
        if tcv == 4115u64 {                      // typed value: @Name(params)=init
            let tv: &WTypedValue = &*(p as *const WTypedValue);
            out.push(0x52u8);
            put_str(out, tv.type_name_str());
            write_val(out, tv.params(), depth + 1i64);
            write_val(out, tv.init(),   depth + 1i64);
            return;
        }
    }
    out.push(0u8);
}

// Serialize `v` (and its transitive references) to a fresh byte buffer.
pub fn wbs_write(v: WAny) -> Vec<u8> {
    let mut out: Vec<u8> = Vec::new();
    unsafe { write_val(&mut out, v, 0i64); }
    return out;
}

// ── read ───────────────────────────────────────────────────────────────────
// Every reader is BOUNDS-CHECKED against `end` (= the caller-supplied buffer
// length) and short-circuits via the shared `err` flag when a read would run
// past the buffer. This makes wbs_read total on truncated / hostile input: it
// returns a null WAny (clean error) instead of dereferencing off the end (OOB
// read / SIGSEGV). `err`, once set, is never cleared — read_val checks it up
// front so a poisoned stream unwinds without further reads or allocations.
unsafe fn rd_u8(data: *const u8, pos: *mut i64, end: i64, err: *mut bool) -> u8 {
    if *pos + 1i64 > end { *err = true; return 0u8; }
    let b: u8 = *data.byte_add(*pos); *pos = *pos + 1i64; return b;
}
unsafe fn rd_vlen(data: *const u8, pos: *mut i64, end: i64, err: *mut bool) -> u64 {
    // Need the marker byte before we can size the prefix.
    if *pos + 1i64 > end { *err = true; return 0u64; }
    let p: *const u8 = data.byte_add(*pos);
    let psize: i64 = vlen_prefix_size(p) as i64;
    if *pos + psize > end { *err = true; return 0u64; }
    let v: u64 = vlen_read(p);
    *pos = *pos + psize;
    return v;
}
unsafe fn rd_i64(data: *const u8, pos: *mut i64, end: i64, err: *mut bool) -> i64 {
    if *pos + 8i64 > end { *err = true; return 0i64; }
    let mut x: i64 = 0i64; let mut i: i64 = 0i64;
    while i < 8i64 { x = x | (((*data.byte_add(*pos + i)) as i64) << (i * 8i64)); i = i + 1i64; }
    *pos = *pos + 8i64; return x;
}
unsafe fn rd_f64(data: *const u8, pos: *mut i64, end: i64, err: *mut bool) -> f64 {
    if *pos + 8i64 > end { *err = true; return 0.0f64; }
    let mut tmp: f64 = 0.0f64;
    let dp: *mut u8 = &mut tmp as *mut f64 as *mut u8;
    let mut i: i64 = 0i64;
    while i < 8i64 { *dp.byte_add(i) = *data.byte_add(*pos + i); i = i + 1i64; }
    *pos = *pos + 8i64;
    return tmp;
}
unsafe fn rd_str(data: *const u8, pos: *mut i64, end: i64, err: *mut bool) -> str {
    let len: i64 = rd_vlen(data, pos, end, err) as i64;
    // A length taken straight from the stream is untrusted: reject negative
    // (from a >i63 vlen) or a payload that overruns the buffer BEFORE building
    // a str that would later be copied off the end.
    if *err || len < 0i64 || *pos + len > end { *err = true; return str_from_raw(data, 0i64); }
    let p: *const u8 = data.byte_add(*pos);
    *pos = *pos + len;
    return str_from_raw(p, len);
}

unsafe fn read_val(h: &Writ, data: *const u8, pos: *mut i64, end: i64, err: *mut bool, depth: i64) -> WAny {
    if *err { return WAny::ref_to(0i64 as *const u8); }
    // Depth guard: a deeply nested stream must not recurse without bound (byte
    // bounds alone don't cap depth — 2 bytes/level suffices). Past the cap, poison
    // the stream so it unwinds to a clean null instead of a stack overflow.
    if depth > WBS_MAX_DEPTH { *err = true; return WAny::ref_to(0i64 as *const u8); }
    let lead: u8 = rd_u8(data, pos, end, err);
    if *err { return WAny::ref_to(0i64 as *const u8); }
    if lead == 0u8    { return WAny::ref_to(0i64 as *const u8); }
    if lead == 1u8    { return WAny::from(false); }
    if lead == 2u8    { return WAny::from(true); }
    if lead == 0x10u8 {                                       // i64 (Pod if it fits, else boxed)
        let x: i64 = rd_i64(data, pos, end, err);
        if *err { return WAny::ref_to(0i64 as *const u8); }
        return h.int(x);
    }
    if lead == 0x18u8 {                                       // f64 (boxed)
        let x: f64 = rd_f64(data, pos, end, err);
        if *err { return WAny::ref_to(0i64 as *const u8); }
        return h.float(x);
    }
    if lead == 0x30u8 {
        let s: str = rd_str(data, pos, end, err);
        if *err { return WAny::ref_to(0i64 as *const u8); }
        return WAny::from(h.wstring(s));
    }
    if lead == 0x40u8 {
        let cnt: i64 = rd_vlen(data, pos, end, err) as i64;
        // Each element is >= 1 byte, so a count exceeding the remaining bytes
        // is malformed — reject before a huge (untrusted) arena allocation.
        if *err || cnt < 0i64 || cnt > end - *pos { *err = true; return WAny::ref_to(0i64 as *const u8); }
        let a: &mut WArray<WAny> = h.array(if cnt < 1i64 { 1i64 } else { cnt });
        let mut i: i64 = 0i64;
        while i < cnt {
            let ev: WAny = read_val(h, data, pos, end, err, depth + 1i64);
            if *err { return WAny::ref_to(0i64 as *const u8); }
            a.push(ev); i = i + 1i64;
        }
        return WAny::from(&*a);
    }
    if lead == 0x41u8 {
        let cnt: i64 = rd_vlen(data, pos, end, err) as i64;
        // Each entry is >= 2 bytes (key vlen + value lead); bound conservatively
        // by remaining bytes before allocating.
        if *err || cnt < 0i64 || cnt > end - *pos { *err = true; return WAny::ref_to(0i64 as *const u8); }
        let m: &mut WMap<WString, WAny> = h.map(if cnt < 1i64 { 1i64 } else { cnt });
        let mut i: i64 = 0i64;
        while i < cnt {
            let key: str = rd_str(data, pos, end, err);
            if *err { return WAny::ref_to(0i64 as *const u8); }
            let val: WAny = read_val(h, data, pos, end, err, depth + 1i64);
            if *err { return WAny::ref_to(0i64 as *const u8); }
            m.set(key, val);
            i = i + 1i64;
        }
        return WAny::from(&*m);
    }
    if lead == 0x50u8 {                                      // typed dense array (2101..2110)
        let tc: u64 = rd_vlen(data, pos, end, err);
        let size: i64 = rd_vlen(data, pos, end, err) as i64;
        if *err { return WAny::ref_to(0i64 as *const u8); }
        if tc < 2101u64 || tc > 2110u64 { *err = true; return WAny::ref_to(0i64 as *const u8); }
        let w: i64 = typed_elem_width(tc);
        // Each element is >= 1 byte, so `size` can't exceed the remaining bytes;
        // reject before a huge (untrusted) arena allocation and before size*w overflows.
        if size < 0i64 || size > end - *pos { *err = true; return WAny::ref_to(0i64 as *const u8); }
        let nbytes: i64 = size * w;
        if nbytes < 0i64 || *pos + nbytes > end { *err = true; return WAny::ref_to(0i64 as *const u8); }
        let hp: *mut Writ = h as *const Writ as *mut Writ;
        let ap: *mut Allocator = hp.allocator.get();
        let mut buf: i64 = 0i64;
        if nbytes > 0i64 {
            buf = writ_alloc_bytes(hp, nbytes) as i64;
            let mut j: i64 = 0i64;
            while j < nbytes { *((buf + j) as *mut u8) = *data.byte_add(*pos + j); j = j + 1i64; }
        }
        *pos = *pos + nbytes;
        let hdr: *mut u8 = alloc_tagged(ap, 24i64, tc);
        *(hdr as *mut u64) = size as u64;
        *(((hdr as i64) + 8i64) as *mut u64) = size as u64;
        let df: i64 = (hdr as i64) + 16i64;
        if buf == 0i64 { *(df as *mut i64) = 0i64; } else { *(df as *mut i64) = buf - df; }
        return WAny::ref_to(hdr as *const u8);
    }
    if lead == 0x51u8 {                                      // typed dense (int-keyed) map (3101..3104)
        let tc: u64 = rd_vlen(data, pos, end, err);
        let size: i64 = rd_vlen(data, pos, end, err) as i64;
        if *err { return WAny::ref_to(0i64 as *const u8); }
        if tc < 3101u64 || tc > 3104u64 { *err = true; return WAny::ref_to(0i64 as *const u8); }
        // Each entry is >= kw+1 bytes (raw key + value lead); bound `size` by
        // remaining bytes before allocating the key/value buffers.
        if size < 0i64 || size > end - *pos { *err = true; return WAny::ref_to(0i64 as *const u8); }
        let kw: i64 = if tc == 3101u64 || tc == 3102u64 { 4i64 } else { 8i64 };
        let hp: *mut Writ = h as *const Writ as *mut Writ;
        let ap: *mut Allocator = hp.allocator.get();
        // Writ segments never move (growth appends), so kbuf/vbuf stay valid across
        // the nested read_val allocations below — fill them incrementally.
        let mut kbuf: i64 = 0i64;
        let mut vbuf: i64 = 0i64;
        if size > 0i64 {
            kbuf = writ_alloc_bytes(hp, size * kw) as i64;
            vbuf = writ_alloc_bytes(hp, size * 8i64) as i64;
        }
        let mut i: i64 = 0i64;
        while i < size {
            let mut b: i64 = 0i64;
            while b < kw { *((kbuf + i * kw + b) as *mut u8) = rd_u8(data, pos, end, err); b = b + 1i64; }
            if *err { return WAny::ref_to(0i64 as *const u8); }
            let val: WAny = read_val(h, data, pos, end, err, depth + 1i64);
            if *err { return WAny::ref_to(0i64 as *const u8); }
            let slot: i64 = vbuf + i * 8i64;
            let vw: i64 = val.raw();
            if vw == 0i64 || (vw & 1i64) == 1i64 { *(slot as *mut i64) = vw; }
            else { *(slot as *mut i64) = vw - slot; }        // lower Ref → self-relative
            i = i + 1i64;
        }
        let hdr: *mut u8 = alloc_tagged(ap, 32i64, tc);
        *(hdr as *mut i64) = size;
        *(((hdr as i64) + 8i64) as *mut i64) = size;
        let kf: i64 = (hdr as i64) + 16i64;
        let vf: i64 = (hdr as i64) + 24i64;
        if kbuf == 0i64 { *(kf as *mut i64) = 0i64; *(vf as *mut i64) = 0i64; }
        else { *(kf as *mut i64) = kbuf - kf; *(vf as *mut i64) = vbuf - vf; }
        return WAny::ref_to(hdr as *const u8);
    }
    if lead == 0x52u8 {                                      // typed value: @Name(params)=init
        let name: str = rd_str(data, pos, end, err);
        if *err { return WAny::ref_to(0i64 as *const u8); }
        let params: WAny = read_val(h, data, pos, end, err, depth + 1i64);
        if *err { return WAny::ref_to(0i64 as *const u8); }
        let init: WAny = read_val(h, data, pos, end, err, depth + 1i64);
        if *err { return WAny::ref_to(0i64 as *const u8); }
        return h.typed_value(name, params, init);
    }
    // Unknown lead byte — malformed stream, not a value.
    *err = true;
    return WAny::ref_to(0i64 as *const u8);
}

// Reconstruct a document from `len` bytes at `data` into the arena `h`; returns
// the root WAny (strings/arrays/maps newly allocated in `h`). On a truncated or
// malformed stream (any read past `len`, an untrusted length/count that overruns
// the buffer, or an unknown lead byte) it returns a null WAny rather than reading
// out of bounds.
pub fn wbs_read(h: &Writ, data: *const u8, len: i64) -> WAny {
    let mut pos: i64 = 0i64;
    let mut err: bool = false;
    let v: WAny = unsafe { read_val(h, data, &mut pos as *mut i64, len, &mut err as *mut bool, 0i64) };
    if err { return WAny::ref_to(0i64 as *const u8); }
    return v;
}
