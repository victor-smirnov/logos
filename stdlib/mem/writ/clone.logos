// logos.mem.writ.clone — deep copy of a writ value tree into a fresh
// container (the Logos-level clone/compactify: only the live, reachable set
// is copied, so dead source space is dropped).
//
// writ_clone(v) -> Rc<Writ> with the copy as its root;
// writ_clone_into(h, v) -> WAny copies into an existing container.
//
// ── ONE WALKER (2026-08-06) ───────────────────────────────────────────────────
// This file used to carry its OWN copy of the recursive walk, a near-duplicate of
// `logos.lang.writ.compactify`. The two had DRIFTED: this one preserved a boxed
// wide scalar's tag bit-for-bit and knew the typed-array / int-keyed-map /
// TypedValue codes; the lang one re-encoded through `as_i64`/`as_f64` (destroying
// W_U64 and W_F32) and returned THE SOURCE POINTER for anything it did not know,
// planting a cross-arena alias. Two copies of one walk with divergent
// unknown-tag behaviour is the defect, not either behaviour.
//
// The walk now lives ONCE, in `logos.lang.writ.compactify` — every code this file
// used to know is handled there, plus a failing form (`try_clone` →
// `Result<WAny, CloneRefusal>`) so "too deep" and "unknown tag N" are
// distinguishable facts rather than one silent null. These two functions are thin
// delegators, kept for their callers and their `Rc<Writ>` convenience; they retain
// this layer's historical TOTAL signature, so a refusal still reads as null here.
// Prefer `logos.lang.writ.compactify::try_clone` when the caller can act on why.

package logos.mem.writ.clone;

use logos.lang.writ.anyval;       // WAny
use logos.lang.writ.container;    // Writ, writ_rc
use logos.lang.writ.compactify;   // clone — THE walker
use logos.lang.rc;                    // Rc

// Deep-copy `v` into container `h`; returns the value-form handle of the copy.
/// Deep-copies `v` into container `h`, returning the copy's value-form handle.
///
/// Delegates to `logos.lang.writ.compactify::clone`. TOTAL signature: a refusal
/// (nesting past the depth cap, an arena tag the walker does not know, OOM) reads
/// back as a NULL `WAny`, indistinguishable from a genuinely null `v` — use
/// `compactify::try_clone` when that difference matters.
pub unsafe fn writ_clone_into(h: &Writ, v: WAny) -> WAny {
    return clone(h, v);
}

// Deep-copy `v` into a fresh right-sized container (the compactify effect:
// only live objects come along).
/// Deep-copies `v` into a fresh container whose root is the copy (only the live,
/// reachable set comes along). See [writ_clone_into] for the refusal-as-null caveat.
pub unsafe fn writ_clone(v: WAny) -> Rc<Writ> {
    let rc: Rc<Writ> = writ_rc(16384);
    let h: &Writ = &*rc;
    let c: WAny = clone(h, v);
    h.set_root(c);
    return rc;
}
