// Logos Writ stdlib — mem.writ.parser
//
// Text → document: a recursive-descent JSON-ish reader that builds a Writ doc
// (WMap<WString, WAny> / Array / WString / i56 / bool / null) in a caller-supplied arena — the
// inverse of stringify, and the Writ port of writ.parser (much smaller: the
// grammar here is plain JSON-with-integers).
//
// Grammar:  value := object | array | string | number | 'true' | 'false' | 'null'
//   object := '{' [ string ':' value (',' string ':' value)* ] '}'
//   array  := '[' [ value (',' value)* ] ']'
//   string := '"' (char | '\' esc)* '"'        esc: " \ / n t r (others: literal)
//   number := '-'? digit+                       (integers → i56; no floats yet)
// Whitespace (space/tab/CR/LF) is skipped between tokens. Lenient: malformed
// input yields a best-effort partial doc rather than an error (error reporting is
// a later refinement).

package logos.mem.writ.parser;

use logos.lang.writ.allocator;   // Allocator
use logos.lang.writ.container;   // Writ, alloc_tagged, writ_alloc_bytes
use logos.lang.writ.anyval;      // WAny, WA_I56
use logos.lang.writ.array;       // WArray<WAny>
use logos.lang.writ.wmap;        // WMap<WString, WAny>
use logos.lang.writ.wstring;     // WString
use logos.lang.writ.typed_value; // WTypedValue (@Type annotations)
use logos.lang.writ.decimal;     // @Decimal validation
use logos.lang.str;                 // str
use logos.lang.cell;
use logos.lang.ptr;                 // byte_add
use logos.lang.num.parse;           // f64_from_str
use logos.mem.string;               // String (escape-decoded scratch)

// Parser cursor over the source bytes.
struct P { data: *const u8, len: i64, pos: i64 }

unsafe fn peek(p: *mut P) -> u8 {
    if (*p).pos >= (*p).len { return 0u8; }
    return *(*p).data.byte_add((*p).pos);
}
unsafe fn advance(p: *mut P) -> u8 { let c: u8 = peek(p); (*p).pos = (*p).pos + 1i64; return c; }
unsafe fn skip_ws(p: *mut P) {
    let mut c: u8 = peek(p);
    while c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8 { advance(p); c = peek(p); }
}
fn is_digit(c: u8) -> bool { return c >= 48u8 && c <= 57u8; }

// Decode a quoted string into a fresh String (handles backslash escapes).
unsafe fn parse_str_raw(p: *mut P) -> String {
    advance(p);                                  // opening "
    let mut s: String = String::new();
    let mut done: bool = false;
    while !done {
        let c: u8 = advance(p);
        if c == 34u8 || c == 0u8 { done = true; }
        else if c == 92u8 {                      // backslash escape
            let e: u8 = advance(p);
            if e == 110u8      { s.push_u8(10u8); }   // \n
            else if e == 116u8 { s.push_u8(9u8); }    // \t
            else if e == 114u8 { s.push_u8(13u8); }   // \r
            else               { s.push_u8(e); }      // \" \\ \/ → literal
        } else { s.push_u8(c); }
    }
    return s;
}

// Read a bare identifier (object key without quotes) into a fresh String.
unsafe fn parse_ident_raw(p: *mut P) -> String {
    let mut s: String = String::new();
    let mut c: u8 = peek(p);
    while (c >= 97u8 && c <= 122u8) || (c >= 65u8 && c <= 90u8)
       || (c >= 48u8 && c <= 57u8) || c == 95u8 {
        s.push_u8(advance(p));
        c = peek(p);
    }
    return s;
}

// Parse a number token. Integers (possibly wide) → `h.int`; anything with a
// fractional '.' or exponent 'e'/'E' → f64 via `h.float`.
unsafe fn parse_number(h: &Writ, p: *mut P) -> WAny {
    let start: i64 = (*p).pos;
    let neg: bool = peek(p) == 45u8;
    if neg { advance(p); }                                  // -
    let mut iv: i64 = 0i64;
    while is_digit(peek(p)) { iv = iv * 10i64 + ((advance(p) - 48u8) as i64); }
    let pc: u8 = peek(p);
    if pc == 46u8 || pc == 101u8 || pc == 69u8 {            // . e E → float
        if pc == 46u8 { advance(p); while is_digit(peek(p)) { advance(p); } }
        let ec: u8 = peek(p);
        if ec == 101u8 || ec == 69u8 {
            advance(p);
            let sg: u8 = peek(p); if sg == 43u8 || sg == 45u8 { advance(p); }
            while is_digit(peek(p)) { advance(p); }
        }
        let tok: str = str_from_raw((*p).data.byte_add(start), (*p).pos - start);
        return h.float(f64_from_str(tok).unwrap_or(0.0f64));
    }
    return h.int(if neg { 0i64 - iv } else { iv });
}

// Match a keyword at the cursor; advances past it when it matches.
unsafe fn kw(p: *mut P, s: str) -> bool {
    let n: i64 = s.len();
    if (*p).pos + n > (*p).len { return false; }
    let mut i: i64 = 0i64;
    while i < n {
        if *(*p).data.byte_add((*p).pos + i) != *((s.as_ptr() as i64 + i) as *const u8) { return false; }
        i = i + 1i64;
    }
    (*p).pos = (*p).pos + n;
    return true;
}

// `<T>[e,...]` typed dense array / `<K[,AnyVal]>{k: v,...}` typed dense map.
unsafe fn parse_typed(h: &Writ, p: *mut P) -> WAny {
    advance(p);                                   // '<'
    skip_ws(p);
    // <Varchar[,AnyVal]>{...} is the plain ObjectMap spelled with a key type.
    if kw(p, "Varchar") {
        skip_ws(p);
        if peek(p) == 44u8 { advance(p); skip_ws(p); let _ = kw(p, "AnyVal"); skip_ws(p); }
        if peek(p) == 62u8 { advance(p); }
        return parse_value(h, p);                 // expects '{' next
    }
    let tc: u64 =
        if kw(p, "I16") { 2106u64 } else if kw(p, "U16") { 2102u64 }
        else if kw(p, "I32") { 2107u64 } else if kw(p, "U32") { 2103u64 }
        else if kw(p, "I64") { 2108u64 } else if kw(p, "U64") { 2104u64 }
        else if kw(p, "I8") { 2105u64 } else if kw(p, "U8") { 2101u64 }
        else if kw(p, "F32") { 2109u64 } else if kw(p, "F64") { 2110u64 }
        else { 0u64 };
    if tc == 0u64 { return WAny::ref_to(0i64 as *const u8); }
    skip_ws(p);
    if peek(p) == 44u8 {                          // ',' AnyVal (map value type)
        advance(p); skip_ws(p);
        let _ = kw(p, "AnyVal");
        skip_ws(p);
    }
    if peek(p) == 62u8 { advance(p); }            // '>'
    skip_ws(p);
    let hp: *mut Writ = h as *const Writ as *mut Writ;
    let ap: *mut Allocator = hp.allocator.get();

    if peek(p) == 123u8 {                         // typed MAP
        let mtc: u64 =
            if tc == 2107u64 { 3101u64 } else if tc == 2103u64 { 3102u64 }
            else if tc == 2108u64 { 3103u64 } else if tc == 2104u64 { 3104u64 } else { 0u64 };
        advance(p);                               // '{'
        let mut keys: [i64; 64] = [0; 64];
        let mut vals: [i64; 64] = [0; 64];
        let mut n: i64 = 0i64;
        skip_ws(p);
        if peek(p) != 125u8 {
            let mut done: bool = false;
            while !done {
                skip_ws(p);
                let neg: bool = peek(p) == 45u8;
                if neg { advance(p); }
                if !is_digit(peek(p)) { return WAny::ref_to(0i64 as *const u8); }   // key must be an int
                let mut kv: i64 = 0i64;
                while is_digit(peek(p)) { kv = kv * 10i64 + ((advance(p) - 48u8) as i64); }
                if neg { kv = 0i64 - kv; }
                skip_ws(p);
                if peek(p) != 58u8 { return WAny::ref_to(0i64 as *const u8); }      // ':' required (rejects 1.5 keys)
                advance(p);
                let v: WAny = parse_value(h, p);
                if n < 64i64 { keys[n] = kv; vals[n] = v.raw(); n = n + 1i64; }
                skip_ws(p);
                if peek(p) == 44u8 { advance(p); } else { done = true; }
            }
        }
        skip_ws(p); if peek(p) == 125u8 { advance(p); } // '}'
        if mtc == 0u64 { return WAny::ref_to(0i64 as *const u8); }
        let kwid: i64 = if mtc == 3101u64 || mtc == 3102u64 { 4i64 } else { 8i64 };
        let mut kbuf: i64 = 0i64;
        let mut vbuf: i64 = 0i64;
        if n > 0i64 {
            kbuf = writ_alloc_bytes(hp, n * kwid) as i64;
            vbuf = writ_alloc_bytes(hp, n * 8i64) as i64;
            let mut i: i64 = 0i64;
            while i < n {
                if kwid == 4i64 { *((kbuf + i * 4i64) as *mut i32) = keys[i] as i32; }
                else { *((kbuf + i * 8i64) as *mut i64) = keys[i]; }
                let slot: i64 = vbuf + i * 8i64;
                let w: i64 = vals[i];
                if w == 0i64 || (w & 1i64) == 1i64 { *(slot as *mut i64) = w; }
                else { *(slot as *mut i64) = w - slot; }
                i = i + 1i64;
            }
        }
        let hdr: *mut u8 = alloc_tagged(ap, 32i64, mtc);
        *(hdr as *mut i64) = n;
        *(((hdr as i64) + 8i64) as *mut i64) = n;
        let kf: i64 = (hdr as i64) + 16i64;
        let vf: i64 = (hdr as i64) + 24i64;
        if kbuf == 0i64 { *(kf as *mut i64) = 0i64; *(vf as *mut i64) = 0i64; }
        else { *(kf as *mut i64) = kbuf - kf; *(vf as *mut i64) = vbuf - vf; }
        return WAny::ref_to(hdr as *const u8);
    }

    // typed ARRAY: '[' signed numerals (float for F32/F64) ']'
    if peek(p) == 91u8 { advance(p); }            // '['
    let mut elems: [i64; 64] = [0; 64];
    let mut fels: [f64; 64] = [0.0; 64];
    let mut n2: i64 = 0i64;
    skip_ws(p);
    if peek(p) != 93u8 {
        let mut done: bool = false;
        while !done {
            skip_ws(p);
            let neg: bool = peek(p) == 45u8;
            if neg { advance(p); }
            if !is_digit(peek(p)) { return WAny::ref_to(0i64 as *const u8); }   // numerals only
            let mut iv: i64 = 0i64;
            while is_digit(peek(p)) { iv = iv * 10i64 + ((advance(p) - 48u8) as i64); }
            let mut fv: f64 = iv as f64;
            if peek(p) == 46u8 {
                if tc != 2109u64 && tc != 2110u64 {
                    return WAny::ref_to(0i64 as *const u8);                     // no floats in int arrays
                }
                advance(p);
                let mut scale: f64 = 0.1;
                while is_digit(peek(p)) { fv = fv + ((advance(p) - 48u8) as f64) * scale; scale = scale * 0.1; }
            }
            if neg { iv = 0i64 - iv; fv = 0.0 - fv; }
            if n2 < 64i64 { elems[n2] = iv; fels[n2] = fv; n2 = n2 + 1i64; }
            skip_ws(p);
            if peek(p) == 44u8 { advance(p); } else { done = true; }
        }
    }
    skip_ws(p); if peek(p) == 93u8 { advance(p); } // ']'
    let w2: i64 = if tc == 2101u64 || tc == 2105u64 { 1i64 }
        else if tc == 2102u64 || tc == 2106u64 { 2i64 }
        else if tc == 2103u64 || tc == 2107u64 || tc == 2109u64 { 4i64 }
        else { 8i64 };
    let mut buf: i64 = 0i64;
    if n2 > 0i64 {
        buf = writ_alloc_bytes(hp, n2 * w2) as i64;
        let mut i: i64 = 0i64;
        while i < n2 {
            if tc == 2110u64      { *((buf + i * 8i64) as *mut f64) = fels[i]; }
            else if tc == 2109u64 { *((buf + i * 4i64) as *mut f32) = fels[i] as f32; }
            else if w2 == 1i64    { *((buf + i) as *mut u8) = elems[i] as u8; }
            else if w2 == 2i64    { *((buf + i * 2i64) as *mut u16) = elems[i] as u16; }
            else if w2 == 4i64    { *((buf + i * 4i64) as *mut u32) = elems[i] as u32; }
            else                  { *((buf + i * 8i64) as *mut i64) = elems[i]; }
            i = i + 1i64;
        }
    }
    let hdr2: *mut u8 = alloc_tagged(ap, 24i64, tc);
    *(hdr2 as *mut u64) = n2 as u64;
    *(((hdr2 as i64) + 8i64) as *mut u64) = n2 as u64;
    let df: i64 = (hdr2 as i64) + 16i64;
    if buf == 0i64 { *(df as *mut i64) = 0i64; }
    else { *(df as *mut i64) = buf - df; }
    return WAny::ref_to(hdr2 as *const u8);
}

// `@Name(params)? = value` typed-value prefix. Returns null WAny on malformed
// forms (trailing comma, >32 params, @Decimal rule violations).
unsafe fn parse_tv_prefix(h: &Writ, p: *mut P) -> WAny {
    advance(p);                                   // '@'
    let name: String = parse_ident_raw(p);
    if name.len() == 0i64 { return WAny::ref_to(0i64 as *const u8); }
    skip_ws(p);
    let mut params: WAny = WAny::ref_to(0i64 as *const u8);
    let mut n_params: i64 = 0i64;
    let mut params_arr: [i64; 32] = [0; 32];
    let mut had_parens: bool = false;
    if peek(p) == 40u8 {                          // '('
        had_parens = true;
        advance(p);
        skip_ws(p);
        if peek(p) != 41u8 {
            let mut done: bool = false;
            while !done {
                let v: WAny = parse_value(h, p);
                if n_params >= 32i64 { return WAny::ref_to(0i64 as *const u8); }   // overflow
                params_arr[n_params] = v.raw();
                n_params = n_params + 1i64;
                skip_ws(p);
                if peek(p) == 44u8 {
                    advance(p);
                    skip_ws(p);
                    if peek(p) == 41u8 { return WAny::ref_to(0i64 as *const u8); } // trailing comma
                } else { done = true; }
            }
        }
        if peek(p) != 41u8 { return WAny::ref_to(0i64 as *const u8); }
        advance(p);                               // ')'
        skip_ws(p);
    }
    if peek(p) != 61u8 { return WAny::ref_to(0i64 as *const u8); }   // '='
    advance(p);
    let init: WAny = parse_value(h, p);
    return tv_build(h, name.as_str(), params_arr, n_params, had_parens, init);
}

// Build + validate the WTypedValue (shared by prefix and postfix forms).
unsafe fn tv_build(h: &Writ, name: str, params_arr: [i64; 32], n_params: i64,
                   had_parens: bool, init: WAny) -> WAny {
    // @Decimal(P,S): exactly two canonical ints, S <= P, string init that
    // parses as a decimal with digits <= P and scale <= S.
    if str_eq(name, "Decimal") {
        if n_params != 2i64 { return WAny::ref_to(0i64 as *const u8); }
        let pv: WAny = WAny::Pod(params_arr[0] as u64);
        let sv: WAny = WAny::Pod(params_arr[1] as u64);
        if (params_arr[0] & 1i64) != 1i64 || (params_arr[1] & 1i64) != 1i64 {
            return WAny::ref_to(0i64 as *const u8);    // non-inline-int params
        }
        if !pv.is_int() || !sv.is_int() { return WAny::ref_to(0i64 as *const u8); }
        let prec: i64 = pv.as_i64();
        let scl:  i64 = sv.as_i64();
        if prec <= 0i64 || scl < 0i64 || scl > prec { return WAny::ref_to(0i64 as *const u8); }
        if !init.is_string() { return WAny::ref_to(0i64 as *const u8); }
        let istr: &WString = &*(init.resolve() as *const WString);
        let d: WAny = hdec_from_str(h, istr.as_str());
        if d.is_null() { return WAny::ref_to(0i64 as *const u8); }
        if (d.as_decimal().scale() as i64) > scl { return WAny::ref_to(0i64 as *const u8); }
    }
    let mut params: WAny = WAny::ref_to(0i64 as *const u8);
    if n_params > 0i64 {
        let pa: &mut WArray<WAny> = h.array(if n_params < 8i64 { 8i64 } else { n_params });
        let mut i: i64 = 0i64;
        while i < n_params {
            let w: i64 = params_arr[i];
            let hv: WAny = if w == 0i64 { WAny::ref_to(0i64 as *const u8) }
                           else if (w & 1i64) == 1i64 { WAny::Pod(w as u64) }
                           else { WAny::Ref(w as *const u8) };
            pa.push(hv);
            i = i + 1i64;
        }
        let pap: *const WArray<WAny> = pa as *const WArray<WAny>;
        params = WAny::ref_to(pap as *const u8);
    }
    return h.typed_value(name, params, init);
}

unsafe fn parse_value(h: &Writ, p: *mut P) -> WAny {
    skip_ws(p);
    let c: u8 = peek(p);
    if c == 60u8 { return parse_typed(h, p); }   // <  typed dense container
    if c == 64u8 { return parse_tv_prefix(h, p); }  // @  typed-value prefix
    if c == 123u8 {                              // {  object
        advance(p);
        let m: &mut WMap<WString, WAny> = h.map(8i64);
        skip_ws(p);
        if peek(p) == 125u8 { advance(p); return WAny::from(&*m); }   // {}
        let mut done: bool = false;
        while !done {
            skip_ws(p);
            // Key: "quoted" or a bare identifier (SDN allows {x: 55}).
            let key: String = if peek(p) == 34u8 { parse_str_raw(p) }
                              else { parse_ident_raw(p) };
            skip_ws(p);
            if peek(p) == 58u8 { advance(p); }   // :
            let val: WAny = parse_value(h, p);
            m.set(key.as_str(), val);
            skip_ws(p);
            if peek(p) == 44u8 { advance(p); } else { done = true; }
        }
        skip_ws(p); if peek(p) == 125u8 { advance(p); }              // }
        return WAny::from(&*m);
    }
    if c == 91u8 {                               // [  array
        advance(p);
        let a: &mut WArray<WAny> = h.array(8i64);
        skip_ws(p);
        if peek(p) == 93u8 { advance(p); return WAny::from(&*a); }   // []
        let mut done: bool = false;
        while !done {
            let val: WAny = parse_value(h, p);
            a.push(val);
            skip_ws(p);
            if peek(p) == 44u8 { advance(p); } else { done = true; }
        }
        skip_ws(p); if peek(p) == 93u8 { advance(p); }              // ]
        return WAny::from(&*a);
    }
    if c == 34u8 {                               // "  string
        let s: String = parse_str_raw(p);
        let sval: WAny = WAny::from(h.wstring(s.as_str()));
        skip_ws(p);
        if peek(p) == 64u8 {                     // "init"@Type(params) postfix
            advance(p);
            let name: String = parse_ident_raw(p);
            if name.len() == 0i64 { return WAny::ref_to(0i64 as *const u8); }
            skip_ws(p);
            let mut n_params: i64 = 0i64;
            let mut params_arr: [i64; 32] = [0; 32];
            let mut had_parens: bool = false;
            if peek(p) == 40u8 {
                had_parens = true;
                advance(p);
                skip_ws(p);
                if peek(p) != 41u8 {
                    let mut done2: bool = false;
                    while !done2 {
                        let v2: WAny = parse_value(h, p);
                        if n_params >= 32i64 { return WAny::ref_to(0i64 as *const u8); }
                        params_arr[n_params] = v2.raw();
                        n_params = n_params + 1i64;
                        skip_ws(p);
                        if peek(p) == 44u8 {
                            advance(p);
                            skip_ws(p);
                            if peek(p) == 41u8 { return WAny::ref_to(0i64 as *const u8); }
                        } else { done2 = true; }
                    }
                }
                if peek(p) != 41u8 { return WAny::ref_to(0i64 as *const u8); }
                advance(p);
            }
            return tv_build(h, name.as_str(), params_arr, n_params, had_parens, sval);
        }
        return sval;
    }
    if c == 116u8 { (*p).pos = (*p).pos + 4i64; return WAny::from(true); }   // true
    if c == 102u8 { (*p).pos = (*p).pos + 5i64; return WAny::from(false); }  // false
    if c == 110u8 { (*p).pos = (*p).pos + 4i64; return WAny::ref_to(0i64 as *const u8); } // null
    return parse_number(h, p);                   // number (int or float)
}

// Parse JSON-ish `text` into a fresh document rooted in `h`.
pub fn parse(h: &Writ, text: str) -> WAny {
    unsafe {
        let mut p: P = P { data: text.as_ptr(), len: text.len(), pos: 0i64 };
        return parse_value(h, &mut p as *mut P);
    }
}

// Parse `text` into a fresh, OWNED Writ container and stamp it as the root.
// The one-call form of `writ_new + parse + set_root`: the returned Writ owns
// the document (RAII-freed on drop) and you navigate straight from `h.root()` —
// no need to thread a separate WAny or hand-roll the container. On a parse error
// the root is null, so `h.root().is_null()` is the failure check.
pub fn parse_writ(text: str) -> Writ {
    let h: Writ = writ_new(4096i64);
    let root: WAny = parse(&h, text);
    h.set_root(root);
    return h;
}
