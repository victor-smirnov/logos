// logos.mem.writ.equal — structural equality over writ documents.
//
// Two WAny values are equal by VALUE SEMANTICS, walking the tree:
//   - both null;
//   - both ints (inline i24/i56 Pod OR boxed I64/U64) with equal as_i64();
//   - both bools / both floats with equal payloads;
//   - both strings with equal bytes;
//   - both arrays (ObjectArray) of equal length with pairwise-equal elements;
//   - both maps (ObjectMap) of equal size where every key of `a` maps to an
//     equal value in `b` (order- and capacity-independent);
//   - both typed arrays of the same element code with identical raw bytes;
//   - both TypedValues with equal {type_name, params, init}.
//
// Self-relative WAny needs no bases — works across documents (rodata blob vs
// runtime container alike). Follows the same direct-walker foundation as
// mem.writ.stringify (the legacy tag_dispatch table is retired).

package logos.mem.writ.equal;

use logos.lang.writ.anyval;     // WAny, h2_type_code
use logos.lang.writ.array;      // WArray<WAny>
use logos.lang.writ.wmap;       // WMap<WString, WAny>
use logos.lang.writ.wstring;    // WString
use logos.lang.str;

// Typed-array element width by wire code (2101..2110).
unsafe fn elem_width(tc: u64) -> i64 {
    if tc == 2101u64 || tc == 2105u64 { return 1i64; }
    if tc == 2102u64 || tc == 2106u64 { return 2i64; }
    if tc == 2103u64 || tc == 2107u64 || tc == 2109u64 { return 4i64; }
    return 8i64;
}

pub fn writ_equal(a: WAny, b: WAny) -> bool {
    if a.is_null() { return b.is_null(); }
    if b.is_null() { return false; }

    // Scalars by value semantics (inline Pod and boxed forms compare equal).
    if a.is_bool() || b.is_bool() {
        return a.is_bool() && b.is_bool() && a.as_bool() == b.as_bool();
    }
    if a.is_int() || b.is_int() {
        return a.is_int() && b.is_int() && a.as_i64() == b.as_i64();
    }
    if a.is_float() || b.is_float() {
        return a.is_float() && b.is_float() && a.as_f64() == b.as_f64();
    }
    if a.is_string() || b.is_string() {
        if !(a.is_string() && b.is_string()) { return false; }
        unsafe {
            let sa: &WString = &*(a.resolve() as *const WString);
            let sb: &WString = &*(b.resolve() as *const WString);
            return str_eq(sa.as_str(), sb.as_str());
        }
    }
    if a.is_array() || b.is_array() {
        if !(a.is_array() && b.is_array()) { return false; }
        unsafe {
            let aa: &WArray<WAny> = &*(a.resolve() as *const WArray<WAny>);
            let ab: &WArray<WAny> = &*(b.resolve() as *const WArray<WAny>);
            let n: i64 = aa.len();
            if n != ab.len() { return false; }
            let mut i: i64 = 0;
            while i < n {
                if !writ_equal(aa.get(i), ab.get(i)) { return false; }
                i = i + 1;
            }
            return true;
        }
    }
    if a.is_map() || b.is_map() {
        if !(a.is_map() && b.is_map()) { return false; }
        unsafe {
            let ma: &WMap<WString, WAny> = &*(a.resolve() as *const WMap<WString, WAny>);
            let mb: &WMap<WString, WAny> = &*(b.resolve() as *const WMap<WString, WAny>);
            if ma.len() != mb.len() { return false; }
            // Walk a's live entries; each key must map to an equal value in b.
            let cap: i64 = ma.slots();
            let mut i: i64 = 0;
            while i < cap {
                let k: WAny = ma.key_at(i);
                if !k.is_null() {
                    let ks: &WString = &*(k.resolve() as *const WString);
                    if !writ_equal(ma.val_at(i), mb.get(ks.as_str())) { return false; }
                }
                i = i + 1;
            }
            return true;
        }
    }

    // Remaining Ref kinds: dispatch on the type code.
    if !a.is_ref() || !b.is_ref() { return a.raw() == b.raw(); }
    unsafe {
        let pa: *const u8 = a.resolve();
        let pb: *const u8 = b.resolve();
        let ta: u64 = h2_type_code(pa);
        let tb: u64 = h2_type_code(pb);
        if ta != tb { return false; }
        // Typed dense arrays: {size,cap,data} + raw element bytes.
        if ta >= 2101u64 && ta <= 2110u64 {
            let na: u64 = *(pa as *const u64);
            if na != *(pb as *const u64) { return false; }
            let da: i64 = (pa as i64) + 16;
            let db: i64 = (pb as i64) + 16;
            let ea: i64 = da + *(da as *const i64);
            let eb: i64 = db + *(db as *const i64);
            let bytes: i64 = (na as i64) * elem_width(ta);
            let mut i: i64 = 0;
            while i < bytes {
                if *((ea + i) as *const u8) != *((eb + i) as *const u8) { return false; }
                i = i + 1;
            }
            return true;
        }
        // Typed dense maps (3101..3104): {size,cap,keys→K[],vals→AnyVal[]}.
        // Insertion-order independent: every (k,v) of `a` must be in `b`.
        if ta >= 3101u64 && ta <= 3104u64 {
            let na: i64 = *(pa as *const i64);
            if na != *(pb as *const i64) { return false; }
            let kw: i64 = if ta == 3101u64 || ta == 3102u64 { 4i64 } else { 8i64 };
            let ka: i64 = (pa as i64) + 16; let keys_a: i64 = ka + *(ka as *const i64);
            let va: i64 = (pa as i64) + 24; let vals_a: i64 = va + *(va as *const i64);
            let kb: i64 = (pb as i64) + 16; let keys_b: i64 = kb + *(kb as *const i64);
            let vb: i64 = (pb as i64) + 24; let vals_b: i64 = vb + *(vb as *const i64);
            let mut i: i64 = 0;
            while i < na {
                let key_i: i64 = if kw == 4 { *((keys_a + i * 4) as *const i32) as i64 }
                                 else       { *((keys_a + i * 8) as *const i64) };
                // find key_i in b
                let mut j: i64 = 0;
                let mut found: bool = false;
                while j < na {
                    let key_j: i64 = if kw == 4 { *((keys_b + j * 4) as *const i32) as i64 }
                                     else       { *((keys_b + j * 8) as *const i64) };
                    if key_j == key_i {
                        if !writ_equal(ha_at(vals_a + i * 8), ha_at(vals_b + j * 8)) { return false; }
                        found = true;
                        break;
                    }
                    j = j + 1;
                }
                if !found { return false; }
                i = i + 1;
            }
            return true;
        }
        // TypedValue (4115): three at-rest WAny words {type_name, params, init}.
        if ta == 4115u64 {
            let mut f: i64 = 0;
            while f < 3 {
                let sa: i64 = (pa as i64) + f * 8;
                let sb: i64 = (pb as i64) + f * 8;
                if !writ_equal(ha_at(sa), ha_at(sb)) { return false; }
                f = f + 1;
            }
            return true;
        }
        // Unknown tagged object: raw byte identity of the words is the best we can do.
        return pa == pb;
    }
}

// Materialize the at-rest WAny word at `slot_addr` (self-relative there).
unsafe fn ha_at(slot_addr: i64) -> WAny {
    let w: i64 = *(slot_addr as *const i64);
    if w == 0i64 { return WAny::Ref(0i64 as *const u8); }
    if (w & 1i64) == 1i64 { return WAny::Pod(w as u64); }
    return WAny::Ref((slot_addr + w) as *const u8);
}
