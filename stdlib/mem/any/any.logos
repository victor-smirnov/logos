//
// Typed wrappers over the WritStatic TypeInfo blobs emitted by reflect::<T>().
//
// Usage:
//   use std.reflect;
//   let info: TypeInfo = TypeInfo::of::<MyPoint>();
//   let name: StringView = info.name();
//   let fields: FieldsView = info.fields();
//   let i: u64 = 0;
//   while i < fields.len() {
//       let f: FieldInfo = fields.get(i);
//       ...
//       i = i + 1;
//   }
//
// STEP 5 (cut-over): reflect::<T>() emits the TypeInfo blob in Writ format, so
// the reads go through the writ reader WView2 (lang.writ.static_view) rather
// than the legacy WritView. The public API (WritStatic handle in, StringView
// out) is unchanged. The node handle is stashed in the view structs as the raw
// WAny word (i64) — a plain value, sidestepping the borrow-checker treating the
// Ref raw-ptr as a borrow of a local — and rebuilt via wany_from_word on use.
// (Mirrors the original arr_bits:u32 workaround, now i64 for the 8-byte WAny.)

package logos.mem.any;

use logos.lang.writ.wstatic;     // WritStatic (reflect::<T>() return type), StringView
use logos.lang.writ.static_view;  // WView2 / wview2_from_ptr / wany_from_word / SView2
use logos.lang.writ.anyval;       // WAny
use logos.lang.str;

// Convert a writ SView2 to the public StringView (same {ptr,len} shape).
fn sview2_to_stringview(sv: SView2) -> StringView {
    return StringView { ptr: sv.ptr, len: sv.len };
}

// ── TypeInfo ─────────────────────────────────────────────────────────────────

/// Typed view over the static reflection blob emitted by `reflect::<T>()`.
pub struct TypeInfo {
    inner: WritStatic,
}

impl TypeInfo {
    /// Creates the `TypeInfo` for type `_T` via `reflect::<_T>()`.
    // T appears only in the `reflect::<T>()` body call (turbofish), which
    // the unused-tparam check doesn't follow. Rename to `_T` to opt out.
    pub fn make<_T>() -> TypeInfo {
        return TypeInfo { inner: reflect::<_T>() };
    }

    /// Returns the type's unqualified name; the declaring package is read via `pkg`.
    pub fn name(self: &TypeInfo) -> StringView {
        let v: WView2 = wview2_from_ptr(self.inner.ptr);
        let av: WAny = v.map_get(v.root(), "name");
        return sview2_to_stringview(v.get_str_view(av));
    }

    /// Returns the name of the package the type is declared in.
    pub fn pkg(self: &TypeInfo) -> StringView {
        let v: WView2 = wview2_from_ptr(self.inner.ptr);
        let av: WAny = v.map_get(v.root(), "pkg");
        return sview2_to_stringview(v.get_str_view(av));
    }

    /// Returns the compiler-assigned unique type code for this type.
    pub fn type_code(self: &TypeInfo) -> u64 {
        let v: WView2 = wview2_from_ptr(self.inner.ptr);
        let av: WAny = v.map_get(v.root(), "type_code");
        return v.get_u64(av);
    }

    /// Returns the type-kind code: `1` = plain struct, `2` = datatype (zoned struct), `3` = trait.
    pub fn kind(self: &TypeInfo) -> i64 {
        let v: WView2 = wview2_from_ptr(self.inner.ptr);
        let av: WAny = v.map_get(v.root(), "kind");
        return v.get_int(av);
    }

    /// Returns `true` if the reflected type is a datatype (zoned struct), i.e. `kind() == 2`.
    pub fn is_datatype(self: &TypeInfo) -> bool {
        return self.kind() == 2;
    }

    /// Returns `true` for DataPlain types: no relative-pointer (zone-offset) fields,
    /// directly or transitively.
    pub fn is_data_plain(self: &TypeInfo) -> bool {
        let v: WView2 = wview2_from_ptr(self.inner.ptr);
        let av: WAny = v.map_get(v.root(), "is_data_plain");
        return v.get_bool(av);
    }

    /// Returns a view over the type's field descriptors.
    pub fn fields(self: &TypeInfo) -> FieldsView {
        let v: WView2 = wview2_from_ptr(self.inner.ptr);
        let av: WAny = v.map_get(v.root(), "fields");
        return FieldsView { info: self.inner, arr_bits: av.raw() };
    }

    /// Returns a view over the annotation instances attached to the type.
    pub fn annotations(self: &TypeInfo) -> AnnotationsView {
        let v: WView2 = wview2_from_ptr(self.inner.ptr);
        let av: WAny = v.map_get(v.root(), "annotations");
        return AnnotationsView { info: self.inner, arr_bits: av.raw() };
    }

    /// Returns the number of fields, without constructing a `FieldsView`.
    pub fn field_count(self: &TypeInfo) -> u64 {
        let v: WView2 = wview2_from_ptr(self.inner.ptr);
        let av: WAny = v.map_get(v.root(), "fields");
        return v.array_len(av);
    }

    /// Returns the number of annotation instances, without constructing an `AnnotationsView`.
    pub fn annotation_count(self: &TypeInfo) -> u64 {
        let v: WView2 = wview2_from_ptr(self.inner.ptr);
        let av: WAny = v.map_get(v.root(), "annotations");
        return v.array_len(av);
    }
}

// ── FieldsView ────────────────────────────────────────────────────────────────
//
// The array node is stashed as the raw WAny word (i64) and rebuilt on use.

/// Array view over a `TypeInfo`'s field descriptors, obtained via `TypeInfo::fields`.
pub struct FieldsView {
    info:     WritStatic,
    arr_bits: i64,
}

impl FieldsView {
    /// Returns the number of field descriptors.
    pub fn len(self: &FieldsView) -> u64 {
        let v: WView2 = wview2_from_ptr(self.info.ptr);
        return v.array_len(wany_from_word(self.arr_bits));
    }

    /// Returns the field descriptor at index `idx`.
    pub fn get(self: &FieldsView, idx: u64) -> FieldInfo {
        let v: WView2 = wview2_from_ptr(self.info.ptr);
        let elem: WAny = v.array_get(wany_from_word(self.arr_bits), idx);
        return FieldInfo { info: self.info, map_bits: elem.raw() };
    }
}

// ── FieldInfo ─────────────────────────────────────────────────────────────────

/// Descriptor of a single struct field: its name and the name of its type.
pub struct FieldInfo {
    info:     WritStatic,
    map_bits: i64,
}

impl FieldInfo {
    /// Returns the field's name.
    pub fn name(self: &FieldInfo) -> StringView {
        let v: WView2 = wview2_from_ptr(self.info.ptr);
        let av: WAny = v.map_get(wany_from_word(self.map_bits), "name");
        return sview2_to_stringview(v.get_str_view(av));
    }

    /// Returns the name of the field's type (primitives as spelled, named types by bare name);
    /// types the emitter cannot name read as `"?"`.
    pub fn type_name(self: &FieldInfo) -> StringView {
        let v: WView2 = wview2_from_ptr(self.info.ptr);
        let av: WAny = v.map_get(wany_from_word(self.map_bits), "type_name");
        return sview2_to_stringview(v.get_str_view(av));
    }
}

// ── AnnotationsView ───────────────────────────────────────────────────────────

/// Array view over a `TypeInfo`'s annotation instances, obtained via `TypeInfo::annotations`.
pub struct AnnotationsView {
    info:     WritStatic,
    arr_bits: i64,
}

impl AnnotationsView {
    /// Returns the number of annotation instances.
    pub fn len(self: &AnnotationsView) -> u64 {
        let v: WView2 = wview2_from_ptr(self.info.ptr);
        return v.array_len(wany_from_word(self.arr_bits));
    }

    /// Returns the annotation descriptor at index `idx`.
    pub fn get(self: &AnnotationsView, idx: u64) -> AnnotationInfo {
        let v: WView2 = wview2_from_ptr(self.info.ptr);
        let elem: WAny = v.array_get(wany_from_word(self.arr_bits), idx);
        return AnnotationInfo { info: self.info, map_bits: elem.raw() };
    }
}

// ── AnnotationInfo ────────────────────────────────────────────────────────────

/// Descriptor of a single annotation instance: its type name plus key/value arguments.
pub struct AnnotationInfo {
    info:     WritStatic,
    map_bits: i64,
}

impl AnnotationInfo {
    /// Returns the fully-qualified annotation type name (e.g. `"reflect_basic::Deprecated"`).
    pub fn type_name(self: &AnnotationInfo) -> StringView {
        let v: WView2 = wview2_from_ptr(self.info.ptr);
        let av: WAny = v.map_get(wany_from_word(self.map_bits), "type");
        return sview2_to_stringview(v.get_str_view(av));
    }

    /// Reads a string argument of the annotation by key; returns an empty view if absent.
    pub fn get_str(self: &AnnotationInfo, key: str) -> StringView {
        let v: WView2 = wview2_from_ptr(self.info.ptr);
        let av: WAny = v.map_get(wany_from_word(self.map_bits), key);
        if av.is_null() {
            return StringView { ptr: 0 as *const u8, len: 0 };
        }
        return sview2_to_stringview(v.get_str_view(av));
    }

    /// Reads an integer argument of the annotation by key; returns `0` if absent or non-integer.
    pub fn get_int(self: &AnnotationInfo, key: str) -> i64 {
        let v: WView2 = wview2_from_ptr(self.info.ptr);
        let av: WAny = v.map_get(wany_from_word(self.map_bits), key);
        return v.get_int(av);
    }
}
