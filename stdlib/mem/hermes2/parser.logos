// Logos Hermes2 stdlib — mem.hermes2.parser
//
// Text → document: a recursive-descent JSON-ish reader that builds a Hermes2 doc
// (HMap / Array / HString / i56 / bool / null) in a caller-supplied arena — the
// inverse of stringify, and the Hermes2 port of hermes.parser (much smaller: the
// grammar here is plain JSON-with-integers).
//
// Grammar:  value := object | array | string | number | 'true' | 'false' | 'null'
//   object := '{' [ string ':' value (',' string ':' value)* ] '}'
//   array  := '[' [ value (',' value)* ] ']'
//   string := '"' (char | '\' esc)* '"'        esc: " \ / n t r (others: literal)
//   number := '-'? digit+                       (integers → i56; no floats yet)
// Whitespace (space/tab/CR/LF) is skipped between tokens. Lenient: malformed
// input yields a best-effort partial doc rather than an error (error reporting is
// a later refinement).

package logos.mem.hermes2.parser;

use logos.lang.hermes2.container;   // Hermes2
use logos.lang.hermes2.anyval;      // HAny, HA_I56
use logos.lang.hermes2.array;       // Array<HAny>
use logos.lang.hermes2.hmap;        // HMap
use logos.lang.hermes2.hstring;     // HString
use logos.lang.str;                 // str
use logos.lang.ptr;                 // byte_add
use logos.mem.string;               // String (escape-decoded scratch)

// Parser cursor over the source bytes.
struct P { data: *const u8, len: i64, pos: i64 }

unsafe fn peek(p: *mut P) -> u8 {
    if (*p).pos >= (*p).len { return 0u8; }
    return *(*p).data.byte_add((*p).pos);
}
unsafe fn advance(p: *mut P) -> u8 { let c: u8 = peek(p); (*p).pos = (*p).pos + 1i64; return c; }
unsafe fn skip_ws(p: *mut P) {
    let mut c: u8 = peek(p);
    while c == 32u8 || c == 9u8 || c == 10u8 || c == 13u8 { advance(p); c = peek(p); }
}
fn is_digit(c: u8) -> bool { return c >= 48u8 && c <= 57u8; }

// Decode a quoted string into a fresh String (handles backslash escapes).
unsafe fn parse_str_raw(p: *mut P) -> String {
    advance(p);                                  // opening "
    let mut s: String = String::new();
    let mut done: bool = false;
    while !done {
        let c: u8 = advance(p);
        if c == 34u8 || c == 0u8 { done = true; }
        else if c == 92u8 {                      // backslash escape
            let e: u8 = advance(p);
            if e == 110u8      { s.push_u8(10u8); }   // \n
            else if e == 116u8 { s.push_u8(9u8); }    // \t
            else if e == 114u8 { s.push_u8(13u8); }   // \r
            else               { s.push_u8(e); }      // \" \\ \/ → literal
        } else { s.push_u8(c); }
    }
    return s;
}

unsafe fn parse_number(p: *mut P) -> i64 {
    let mut neg: bool = false;
    if peek(p) == 45u8 { neg = true; advance(p); }    // -
    let mut v: i64 = 0i64;
    while is_digit(peek(p)) { v = v * 10i64 + ((advance(p) - 48u8) as i64); }
    if neg { return 0i64 - v; }
    return v;
}

unsafe fn parse_value(h: &Hermes2, p: *mut P) -> HAny {
    skip_ws(p);
    let c: u8 = peek(p);
    if c == 123u8 {                              // {  object
        advance(p);
        let m: &mut HMap = h.map(8i64);
        skip_ws(p);
        if peek(p) == 125u8 { advance(p); return HAny::from(&*m); }   // {}
        let mut done: bool = false;
        while !done {
            skip_ws(p);
            let key: String = parse_str_raw(p);
            skip_ws(p);
            if peek(p) == 58u8 { advance(p); }   // :
            let val: HAny = parse_value(h, p);
            m.set(key.as_str(), val);
            skip_ws(p);
            if peek(p) == 44u8 { advance(p); } else { done = true; }
        }
        skip_ws(p); if peek(p) == 125u8 { advance(p); }              // }
        return HAny::from(&*m);
    }
    if c == 91u8 {                               // [  array
        advance(p);
        let a: &mut Array<HAny> = h.array(8i64);
        skip_ws(p);
        if peek(p) == 93u8 { advance(p); return HAny::from(&*a); }   // []
        let mut done: bool = false;
        while !done {
            let val: HAny = parse_value(h, p);
            a.push(val);
            skip_ws(p);
            if peek(p) == 44u8 { advance(p); } else { done = true; }
        }
        skip_ws(p); if peek(p) == 93u8 { advance(p); }              // ]
        return HAny::from(&*a);
    }
    if c == 34u8 {                               // "  string
        let s: String = parse_str_raw(p);
        return HAny::from(h.hstring(s.as_str()));
    }
    if c == 116u8 { (*p).pos = (*p).pos + 4i64; return HAny::from(true); }   // true
    if c == 102u8 { (*p).pos = (*p).pos + 5i64; return HAny::from(false); }  // false
    if c == 110u8 { (*p).pos = (*p).pos + 4i64; return HAny { raw: 0i64 }; } // null
    return HAny::pod(parse_number(p), HA_I56);   // number
}

// Parse JSON-ish `text` into a fresh document rooted in `h`.
pub fn parse(h: &Hermes2, text: str) -> HAny {
    unsafe {
        let mut p: P = P { data: text.as_ptr(), len: text.len(), pos: 0i64 };
        return parse_value(h, &mut p as *mut P);
    }
}
