// Logos standard library -- std.csv
//
// RFC 4180-style CSV reader and writer.
//
// Reader: stateful — construct a CsvReader over a byte buffer and call
//   read_field() repeatedly.  Each call appends one decoded field to `out`
//   and sets `is_row_end` to true when that was the last field in the row.
//   Returns false at EOF or on malformed input (unterminated quoted field).
//
// Writer: field-at-a-time helpers that quote when necessary (field contains
//   comma, quote, CR, or LF) and double embedded quotes.

package logos.mem.encoding.csv;

use logos.mem.string;
use logos.lang.str;

pub struct CsvReader {
    src: *const u8,
    pos: i64,
    end: i64,
}

impl CsvReader {
    pub static fn new(s: str) -> CsvReader {
        unsafe {
            return CsvReader {
                src: s.as_ptr(),
                pos: 0 as i64,
                end: s.len(),
            };
        }
    }

    pub fn eof(&self) -> bool {
        return self.pos >= self.end;
    }

    // Read the next field into `out`.  Sets `is_row_end` if this was the
    // last field on the line (a newline or EOF follows).  Returns true on
    // success, false on EOF-before-any-content or malformed quoted field.
    pub fn read_field(&mut self, out: &mut String, is_row_end: &mut bool) -> bool {
        *is_row_end = false;
        if self.pos >= self.end { return false; }
        unsafe {
            let b: u8 = self.src[self.pos];
            if b == 34 as u8 {                    // '"' → quoted field
                return self.read_quoted(out, is_row_end);
            }
            return self.read_unquoted(out, is_row_end);
        }
    }

    unsafe fn read_unquoted(&mut self, out: &mut String, is_row_end: &mut bool) -> bool {
        while self.pos < self.end {
            let b: u8 = self.src[self.pos];
            if b == 44 as u8 {                    // ','
                self.pos = self.pos + 1 as i64;
                *is_row_end = false;
                return true;
            }
            if b == 10 as u8 {                    // '\n'
                self.pos = self.pos + 1 as i64;
                *is_row_end = true;
                return true;
            }
            if b == 13 as u8 {                    // '\r'
                self.pos = self.pos + 1 as i64;
                if self.pos < self.end && self.src[self.pos] == 10 as u8 {
                    self.pos = self.pos + 1 as i64;
                }
                *is_row_end = true;
                return true;
            }
            out.push_u8(b);
            self.pos = self.pos + 1 as i64;
        }
        *is_row_end = true;
        return true;
    }

    unsafe fn read_quoted(&mut self, out: &mut String, is_row_end: &mut bool) -> bool {
        self.pos = self.pos + 1 as i64;            // consume opening '"'
        while self.pos < self.end {
            let b: u8 = self.src[self.pos];
            if b == 34 as u8 {                    // '"'
                self.pos = self.pos + 1 as i64;
                if self.pos < self.end && self.src[self.pos] == 34 as u8 {
                    // Doubled quote inside field → literal '"'.
                    out.push_u8(34 as u8);
                    self.pos = self.pos + 1 as i64;
                } else {
                    // End of quoted field: expect ',', newline, or EOF.
                    if self.pos >= self.end {
                        *is_row_end = true;
                        return true;
                    }
                    let n: u8 = self.src[self.pos];
                    if n == 44 as u8 {
                        self.pos = self.pos + 1 as i64;
                        *is_row_end = false;
                        return true;
                    }
                    if n == 10 as u8 {
                        self.pos = self.pos + 1 as i64;
                        *is_row_end = true;
                        return true;
                    }
                    if n == 13 as u8 {
                        self.pos = self.pos + 1 as i64;
                        if self.pos < self.end && self.src[self.pos] == 10 as u8 {
                            self.pos = self.pos + 1 as i64;
                        }
                        *is_row_end = true;
                        return true;
                    }
                    // Garbage after closing quote — reject.
                    return false;
                }
            } else {
                out.push_u8(b);
                self.pos = self.pos + 1 as i64;
            }
        }
        // Unterminated quoted field.
        return false;
    }
}

// ── Writer helpers ────────────────────────────────────────────────────────

fn field_needs_quoting(src: *const u8, len: i64) -> bool {
    let mut i: i64 = 0 as i64;
    unsafe {
        while i < len {
            let b: u8 = src[i];
            if b == 44 as u8 { return true; }      // ','
            if b == 34 as u8 { return true; }      // '"'
            if b == 10 as u8 { return true; }      // '\n'
            if b == 13 as u8 { return true; }      // '\r'
            i = i + 1 as i64;
        }
    }
    return false;
}

// Append one CSV field to `out`.  Quotes the field and doubles embedded
// quotes if any of the delimiter characters appear in it.
pub fn write_field(src: *const u8, len: i64, out: &mut String) {
    unsafe {
        if !field_needs_quoting(src, len) {
            out.push_bytes(src, len);
            return;
        }
        out.push_u8(34 as u8);
        let mut i: i64 = 0 as i64;
        while i < len {
            let b: u8 = src[i];
            if b == 34 as u8 {
                out.push_u8(34 as u8);
                out.push_u8(34 as u8);
            } else {
                out.push_u8(b);
            }
            i = i + 1 as i64;
        }
        out.push_u8(34 as u8);
    }
}

pub fn write_field_str(s: str, out: &mut String) {
    unsafe { write_field(s.as_ptr(), s.len(), out); }
}

// Write a separator (',').  Call between fields.
pub fn write_sep(out: &mut String) {
    out.push_u8(44 as u8);
}

// Write a row terminator (CRLF per RFC 4180).
pub fn write_newline(out: &mut String) {
    out.push_u8(13 as u8);
    out.push_u8(10 as u8);
}
