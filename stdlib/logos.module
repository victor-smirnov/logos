module stdlib
version 0.1
root stdlib/

# Three-layer split Phase 4 transition: the monolith deliberately
# ABSORBS the layer trees (stdlib/{lang,mem,std-new}/) via this
# recursive root. Migrated packages thus live in BOTH the monolith
# and their layer archive — link-order (monolith first; see
# tests/logos/run_test.sh + main.cpp is_jit_unsafe_archive) ensures
# the layer archive's duplicates aren't pulled in at consumer link
# time. Phase 7 removes the monolith and the layer archives become
# the canonical source.

# Metaprog plumbing references host externs (logos_emit_source,
# logos_get_module_ast_oview, ...) defined inside logosc itself for
# JIT'd hooks. The .o for these modules can't link into user binaries
# (the externs aren't resolvable), but the metacall JIT does need
# their AST at compile time. `ast_only` writes their .hermes0 into
# the archive while skipping codegen — single artifact, system path
# alone is enough to drive #[derive_clone] and friends.
ast_only std/compiler/metaprog
