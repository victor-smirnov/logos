module stdlib
version 0.1
root stdlib/

# Three-layer split Step 8 (2026-05-17): excludes activated. The
# monolith now ONLY indexes packages under stdlib/std/; the
# stdlib/lang/ and stdlib/mem/ subtrees are owned by liblogos-lang.a
# and liblogos-mem.a respectively. Consumers resolve lang/mem deps
# via the binary archives at compile-time.
#
# Build order: layer archives (lang → mem → std-new) build FIRST;
# monolith builds AFTER, consuming them. See lib/logos/CMakeLists.txt.
exclude lang
exclude mem
exclude std-new

# Metaprog plumbing references host externs (logos_emit_source,
# logos_get_module_ast_oview, ...) defined inside logosc itself for
# JIT'd hooks. The .o for these modules can't link into user binaries
# (the externs aren't resolvable), but the metacall JIT does need
# their AST at compile time. `ast_only` writes their .hermes0 into
# the archive while skipping codegen — single artifact, system path
# alone is enough to drive #[derive_clone] and friends.
ast_only std/compiler/metaprog
