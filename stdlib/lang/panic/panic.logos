// Logos standard library — std.panic
//
// panic() — unrecoverable error: aborts execution (does not return).
// catch_unwind() — run a fn-ptr under panic recovery; returns
//                  Ok on normal return, Err(msg) if the fn panicked.
// Location, PanicInfo — diagnostic structs for the panic surface.

package logos.lang.panic;

use logos.lang.result;
use logos.lang.option;
use logos.lang.str;

extern fn abort() -> !;
extern fn write(fd: i32, buf: *const u8, n: i64) -> i64;
// Hook into the test-recovery runtime: if a #[test] runner has installed
// a TLS jmp_buf via logos_run_with_recovery, this call captures `msg` and
// longjmps out (never returns). Otherwise it's a no-op and we fall through
// to the normal abort() path.
extern fn logos_panic_maybe_longjmp(msg: *const u8, n: i64);

// catch_unwind / Last-panic accessor primitives (defined in
// stdlib/rt/test_recovery.c). The recovery infra is the same one
// #[test] uses for assertion-failure isolation.
extern fn logos_run_with_recovery(fn_ptr: fn()) -> i32;
extern fn logos_panic_last_msg() -> *const u8;
extern fn logos_panic_last_msg_len() -> i64;

/// Aborts execution with an unrecoverable error, printing `panic: <msg>` to stderr.
/// If a recovery handler is installed (`catch_unwind` or the `#[test]` runner), control
/// longjmps to it instead of aborting the process.
pub fn panic(msg: str) -> ! {
    unsafe {
        let prefix: str = "panic: ";
        write(2, prefix.as_ptr(), 7);
        write(2, msg.as_ptr(), msg.len());
        let nl: str = "\n";
        write(2, nl.as_ptr(), 1);
        logos_panic_maybe_longjmp(msg.as_ptr(), msg.len());
        abort();
    }
}

/// Panics with `msg` if `cond` is false.
pub fn assert(cond: bool, msg: str) {
    if !cond { panic(msg); }
}

// ── Location ─────────────────────────────────────────────────────────────
//
// Mirrors `core::panic::Location`. Where in source a panic
// originated. Today populated only via explicit construction —
// `Location::caller()` (Rust's compiler-injected caller location)
// requires sema-side automatic threading of `#[track_caller]` which
// isn't yet wired. Use it as a diagnostic carrier in user panic
// helpers; rely on the `panic: <msg>` line printed by `panic()` for
// fallback context.

/// Identifies the source position (file, line, column) where a panic originated.
/// Mirror of `core::panic::Location`; populated only by explicit construction today —
/// there is no compiler-injected `caller()` yet.
pub struct Location {
    /// Source file path.
    pub file:   str,
    /// Line number within `file`.
    pub line:   u32,
    /// Column number within `line`.
    pub column: u32,
}

/// Creates a `Location` for the given source position.
pub fn location(file: str, line: u32, column: u32) -> Location {
    return Location { file: file, line: line, column: column };
}

// ── PanicInfo ────────────────────────────────────────────────────────────
//
// Mirrors `core::panic::PanicInfo`. Pair of message + location.
// Used by `catch_unwind` consumers that want both pieces; today
// the Location is `Option::None` because the panic hook doesn't
// capture call-site location (would need `#[track_caller]`).

/// Carries a panic's message plus its optional origin; mirror of `core::panic::PanicInfo`.
pub struct PanicInfo {
    /// The `str` that was passed to `panic()`.
    pub message:  str,
    /// Panic origin; currently always `None` — the hook does not capture call-site location.
    pub location: Option<Location>,
}

// ── catch_unwind ─────────────────────────────────────────────────────────
//
// Mirrors `core::panic::catch_unwind`. Runs `f` under panic
// recovery: returns Ok(()) on normal return, Err(msg) if `f`
// panicked. The captured message is the str passed to panic().
//
// Divergence: Rust's signature is `catch_unwind<F: FnOnce() -> R>(f: F)
// -> Result<R, Box<dyn Any + Send>>`. Logos uses fn-ptr (no closure
// captures), returns nothing on success, and captures the panic
// message as str instead of Any. Sufficient for test-harness-style
// isolation; richer Any-based capture waits on a Box<dyn Any> port.
/// Runs `f` under panic recovery: `Ok(())` on normal return, `Err(msg)` if `f` panicked.
/// The error is the `str` passed to `panic()`. Diverges from Rust: takes a plain fn-ptr
/// (no closure captures) and captures the message as `str`, not `Box<dyn Any>`.
pub fn catch_unwind(f: fn()) -> Result<(), str> {
    unsafe {
        let rv: i32 = logos_run_with_recovery(f);
        if rv == 0 {
            return Result::<(), str>::Ok(());
        }
        let p: *const u8 = logos_panic_last_msg();
        let n: i64       = logos_panic_last_msg_len();
        return Result::<(), str>::Err(str_from_raw(p, n));
    }
}

// ── UnwindSafe / RefUnwindSafe / AssertUnwindSafe ────────────────────────
//
// Mirrors Rust's `core::panic::{UnwindSafe, RefUnwindSafe,
// AssertUnwindSafe}`. UnwindSafe is the marker bound on closures passed
// to `catch_unwind`, asserting that an unwind cannot leave broken
// invariants visible to callers. RefUnwindSafe is the `&T` analogue.
//
// In Rust both are auto traits with explicit `impl !` for the unsafe
// shapes (UnsafeCell, &mut T, etc.). Logos doesn't auto-derive them
// today — the markers exist so port targets that name them parse and
// downstream code can opt in when the auto-derive lands.
//
// AssertUnwindSafe<T>(value) is the canonical escape hatch: a newtype
// that unconditionally asserts UnwindSafe (Rust uses tuple-struct
// `(pub T)`; Logos uses a named field for the same shape).

/// Marks a type as safe to observe after an unwind (`catch_unwind` bound).
/// Not auto-derived today — opt in with an explicit impl or `AssertUnwindSafe`.
pub trait UnwindSafe {}
/// Marks `&T` as unwind-safe — the shared-reference analogue of `UnwindSafe`.
/// Not auto-derived today.
pub trait RefUnwindSafe {}

/// Wraps a value to unconditionally assert `UnwindSafe`/`RefUnwindSafe` — the escape
/// hatch for types without the marker impls.
pub struct AssertUnwindSafe<T> {
    /// The wrapped value.
    pub value: T,
}

impl<T> UnwindSafe    for AssertUnwindSafe<T> {}
impl<T> RefUnwindSafe for AssertUnwindSafe<T> {}
