        if val > 127usize { return Result::Err(TryFromIntError::new(IntErrorKind::PosOverflow)); }
        return Result::Ok(val as i8);
    }
}
impl TryFrom<usize> for i16 {
    type Error = TryFromIntError;
    fn try_from(val: usize) -> Result<i16, TryFromIntError> {
        if val > 32767usize { return Result::Err(TryFromIntError::new(IntErrorKind::PosOverflow)); }
        return Result::Ok(val as i16);
    }
}
impl TryFrom<usize> for i32 {
    type Error = TryFromIntError;
    fn try_from(val: usize) -> Result<i32, TryFromIntError> {
        if val > 2147483647usize { return Result::Err(TryFromIntError::new(IntErrorKind::PosOverflow)); }
        return Result::Ok(val as i32);
    }
}
impl TryFrom<usize> for i64 {
    type Error = TryFromIntError;
    fn try_from(val: usize) -> Result<i64, TryFromIntError> {
        if val > 9223372036854775807usize { return Result::Err(TryFromIntError::new(IntErrorKind::PosOverflow)); }
        return Result::Ok(val as i64);
    }
}
impl TryFrom<usize> for isize {
    type Error = TryFromIntError;
    fn try_from(val: usize) -> Result<isize, TryFromIntError> {
        if val > 9223372036854775807usize { return Result::Err(TryFromIntError::new(IntErrorKind::PosOverflow)); }
        return Result::Ok(val as isize);
    }
}
impl TryFrom<usize> for u8 {
    type Error = TryFromIntError;
    fn try_from(val: usize) -> Result<u8, TryFromIntError> {
        if val > 255usize { return Result::Err(TryFromIntError::new(IntErrorKind::PosOverflow)); }
        return Result::Ok(val as u8);
    }
}
impl TryFrom<usize> for u16 {
    type Error = TryFromIntError;
    fn try_from(val: usize) -> Result<u16, TryFromIntError> {
        if val > 65535usize { return Result::Err(TryFromIntError::new(IntErrorKind::PosOverflow)); }
        return Result::Ok(val as u16);
    }
}
impl TryFrom<usize> for u32 {
    type Error = TryFromIntError;
    fn try_from(val: usize) -> Result<u32, TryFromIntError> {
        if val > 4294967295usize { return Result::Err(TryFromIntError::new(IntErrorKind::PosOverflow)); }
        return Result::Ok(val as u32);
    }
}
impl TryFrom<usize> for u64 {
    type Error = TryFromIntError;
    fn try_from(val: usize) -> Result<u64, TryFromIntError> {
        return Result::Ok(val as u64);
    }
}

// char ↔ integers: char widens to u32/u64, u8 widens to char; the
// narrowing directions are TryFrom.
impl From<char> for u32 { fn from(val: char) -> u32 { return val as u32; } }
impl From<char> for u64 { fn from(val: char) -> u64 { return val as u64; } }
impl From<u8> for char { fn from(val: u8) -> char { return val as char; } }

// bool → integer widening — matches Rust's `From<bool> for {i,u}*`.
impl From<bool> for i32 { fn from(val: bool) -> i32 { if val { return 1i32; } return 0i32; } }
impl From<bool> for i64 { fn from(val: bool) -> i64 { if val { return 1i64; } return 0i64; } }
impl From<bool> for u32 { fn from(val: bool) -> u32 { if val { return 1u32; } return 0u32; } }
impl From<bool> for u64 { fn from(val: bool) -> u64 { if val { return 1u64; } return 0u64; } }
impl From<bool> for u8  { fn from(val: bool) -> u8  { if val { return 1u8;  } return 0u8;  } }
impl From<bool> for i8 { fn from(val: bool) -> i8 { if val { return 1i8; } return 0i8; } }
impl From<bool> for i16 { fn from(val: bool) -> i16 { if val { return 1i16; } return 0i16; } }
impl From<bool> for isize { fn from(val: bool) -> isize { if val { return 1isize; } return 0isize; } }
impl From<bool> for u16 { fn from(val: bool) -> u16 { if val { return 1u16; } return 0u16; } }
impl From<bool> for usize { fn from(val: bool) -> usize { if val { return 1usize; } return 0usize; } }

// u32 → char — succeeds iff val is a valid Unicode scalar value
// (< 0x110000 and not in the surrogate range 0xD800..=0xDFFF).
impl TryFrom<u32> for char {
    type Error = CharTryFromError;
    fn try_from(val: u32) -> Result<char, CharTryFromError> {
        if val >= 0x110000u32 { return Result::Err(CharTryFromError{}); }
        if val >= 0xD800u32 && val <= 0xDFFFu32 { return Result::Err(CharTryFromError{}); }
        return Result::Ok(unsafe { char::from_u32_unchecked(val) });
    }
}
impl TryFrom<char> for u8 {
    type Error = TryFromCharError;
    fn try_from(val: char) -> Result<u8, TryFromCharError> {
        if (val as u32) > 0xFFu32 { return Result::Err(TryFromCharError{}); }
        return Result::Ok(val as u8);
    }
}
impl TryFrom<char> for u16 {
    type Error = TryFromCharError;
    fn try_from(val: char) -> Result<u16, TryFromCharError> {
        if (val as u32) > 0xFFFFu32 { return Result::Err(TryFromCharError{}); }
        return Result::Ok(val as u16);
    }
}


// ─── Borrow / BorrowMut ────────────────────────────────────────────────
//
// Mirrors `core::borrow::{Borrow, BorrowMut}`. Generic over a borrowed
// form `Borrowed`. Used by collection lookup APIs (`HashMap::get<Q>`
// where `K: Borrow<Q>`) so a `HashMap<String, V>` can be queried with
// a `&str` without re-allocating a String.
//
// Divergence from Rust: Rust ships an identity blanket `impl<T:?Sized>
// Borrow<T> for T`. In Logos a `impl<T> Borrow<T> for T` blanket
// causes mlir-gen failures (mono auto-instantiates `T__borrow` for
// every stdlib type and some `(ptr) -> (ptr)` body shapes fail to
// lower — operand-type mismatch in the synthetic body). Filed as a
// follow-up; for now identity impls are per-primitive. Cross-shape
// impls (`impl Borrow<str> for String`, `impl Borrow<[T]> for
// Vec<T>`) ship alongside the consuming collections (mem/string,
// mem/collections).

/// Borrows `self` as a `&Borrowed` view.
///
/// Contract (as in Rust): `Eq`/`Ord`/`Hash` of the borrowed view must agree with
/// the owned value — keyed collection lookups (`HashMap::get`) rely on it.
pub trait Borrow<Borrowed> {
    /// Immutably borrows `self` in the `Borrowed` form.
    fn borrow(&self) -> &Borrowed;
}

/// Borrows `self` as a `&mut Borrowed` view; mutable counterpart of `Borrow`.
pub trait BorrowMut<Borrowed>: Borrow<Borrowed> {
    /// Mutably borrows `self` in the `Borrowed` form.
    fn borrow_mut(&mut self) -> &mut Borrowed;
}

// Identity impls for primitives — `T: Borrow<T>` holds for every
// scalar. Per-type rather than blanket; see header note.
impl Borrow<i8>   for i8   { fn borrow(&self) -> &i8   { return self; } }
impl Borrow<i16>  for i16  { fn borrow(&self) -> &i16  { return self; } }
impl Borrow<i32>  for i32  { fn borrow(&self) -> &i32  { return self; } }
impl Borrow<i64>  for i64  { fn borrow(&self) -> &i64  { return self; } }
impl Borrow<u8>   for u8   { fn borrow(&self) -> &u8   { return self; } }
impl Borrow<u16>  for u16  { fn borrow(&self) -> &u16  { return self; } }
impl Borrow<u32>  for u32  { fn borrow(&self) -> &u32  { return self; } }
impl Borrow<u64>  for u64  { fn borrow(&self) -> &u64  { return self; } }
impl Borrow<bool> for bool { fn borrow(&self) -> &bool { return self; } }

impl BorrowMut<i8>   for i8   { fn borrow_mut(&mut self) -> &mut i8   { return self; } }
impl BorrowMut<i16>  for i16  { fn borrow_mut(&mut self) -> &mut i16  { return self; } }
impl BorrowMut<i32>  for i32  { fn borrow_mut(&mut self) -> &mut i32  { return self; } }
impl BorrowMut<i64>  for i64  { fn borrow_mut(&mut self) -> &mut i64  { return self; } }
impl BorrowMut<u8>   for u8   { fn borrow_mut(&mut self) -> &mut u8   { return self; } }
impl BorrowMut<u16>  for u16  { fn borrow_mut(&mut self) -> &mut u16  { return self; } }
impl BorrowMut<u32>  for u32  { fn borrow_mut(&mut self) -> &mut u32  { return self; } }
impl BorrowMut<u64>  for u64  { fn borrow_mut(&mut self) -> &mut u64  { return self; } }
impl BorrowMut<bool> for bool { fn borrow_mut(&mut self) -> &mut bool { return self; } }

// ── AsRef / AsMut (Rust's cheap reference-to-reference conversions) ─────────
// Impls for the owning types ship with them (Vec / String / Box); the slice
// identity impl is here.

/// Cheap `&Self` → `&T` conversion (Rust's `AsRef`); generic APIs take `impl AsRef<T>`.
pub trait AsRef<T: ?Sized> {
    /// Converts to a shared reference of the target type.
    fn as_ref(&self) -> &T;
}

/// Cheap `&mut Self` → `&mut T` conversion (Rust's `AsMut`).
pub trait AsMut<T: ?Sized> {
    /// Converts to a mutable reference of the target type.
    fn as_mut(&mut self) -> &mut T;
}

impl<E> AsRef<[E]> for [E] {
    fn as_ref(&self) -> &[E] { return self; }
}

impl<E> AsMut<[E]> for [E] {
    fn as_mut(self: &mut [E]) -> &mut [E] { return self; }
}
