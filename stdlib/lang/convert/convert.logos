    type Error = TryFromIntError;
    fn try_from(val: i8) -> Result<u64, TryFromIntError> {
        if val < 0i8 { return Result::Err(TryFromIntError::new(IntErrorKind::NegOverflow)); }
        return Result::Ok(val as u64);
    }
}
impl TryFrom<i8> for usize {
    type Error = TryFromIntError;
    fn try_from(val: i8) -> Result<usize, TryFromIntError> {
        if val < 0i8 { return Result::Err(TryFromIntError::new(IntErrorKind::NegOverflow)); }
        return Result::Ok(val as usize);
    }
}
impl TryFrom<i16> for i8 {
    type Error = TryFromIntError;
    fn try_from(val: i16) -> Result<i8, TryFromIntError> {
        if val < -128i16 { return Result::Err(TryFromIntError::new(IntErrorKind::NegOverflow)); }
        if val > 127i16 { return Result::Err(TryFromIntError::new(IntErrorKind::PosOverflow)); }
        return Result::Ok(val as i8);
    }
}
impl TryFrom<i16> for u8 {
    type Error = TryFromIntError;
    fn try_from(val: i16) -> Result<u8, TryFromIntError> {
        if val < 0i16 { return Result::Err(TryFromIntError::new(IntErrorKind::NegOverflow)); }
