// Logos standard library — std.lang.convert
//
// Mirrors Rust's core::convert: From / Into / TryFrom / TryInto. We
// supply primitive widening conversions (lossless integer/char ↔
// integer) as From; lossy/range-checked conversions as TryFrom with an
// associated `Error` (`TryFromIntError`, `CharTryFromError`, ...). String / &str / Box / Vec conversions live in
// their respective modules (text.logos / vec.logos) where the receiver
// types are defined.

package logos.lang.convert;

use logos.lang.option;
use logos.lang.result;
use logos.lang.num.error;

/// Converts a value of type `T` into `Self`; infallible and value-consuming.
///
/// Implementing `From<T> for U` also enables `t.into()` via the blanket `Into` impl,
/// so implement `From` rather than `Into`.
pub trait From<T> {
    /// Performs the conversion.
    fn from(val: T) -> Self;
}

/// Converts `self` into a value of type `T`; infallible and value-consuming.
///
/// Do not implement directly: blanket-derived from every `From<S> for T` impl.
pub trait Into<T> {
    /// Performs the conversion, consuming `self`.
    fn into(self: Self) -> T;
}

/// Converts a value of type `T` into `Self`, failing with `Self::Error`.
pub trait TryFrom<T>: Sized {
    /// The error returned when the conversion fails.
    type Error;
    /// Performs the conversion, returning `Err(Self::Error)` on failure.
    fn try_from(value: T) -> Result<Self, Self::Error>;
}

/// Converts `self` into a value of type `T`, failing with `Self::Error`.
///
/// Do not implement directly: blanket-derived from every `TryFrom<S> for T` impl.
pub trait TryInto<T> {
    /// The error returned when the conversion fails.
    type Error;
    /// Performs the conversion, consuming `self`; returns `Err(Self::Error)` on failure.
    fn try_into(self: Self) -> Result<T, Self::Error>;
}

/// Reports a failed `u32` → `char` conversion: not a Unicode scalar value.
pub struct CharTryFromError {}

/// Reports a failed `char` → `u8`/`u16` conversion: the code point does not fit.
pub struct TryFromCharError {}

// ─── Into / TryInto derived from From / TryFrom (blanket impls) ─────────
//
// Mirrors Rust's `impl<T, U: From<T>> Into<U> for T` and
// `impl<T, U: TryFrom<T>> TryInto<U> for T`: anything `From`/`TryFrom` can
// build from `S` is reachable via `.into()` / `.try_into()` on an `S` value,
// with the destination inferred from the call's expected type. So every
// `From`/`TryFrom` impl below (and any user impl) automatically yields the
// matching `.into()` / `.try_into()`.
//
// (Source param `S`; destination = the trait's own param so the trait/impl
// param roles don't collide — see the blanket-method-output-param fix,
// [[baghunt-mono-blanket-body-output-param]].)
// Every type converts to itself (Rust's `impl<T> From<T> for T`), so `x.into()` /
// `T::from(x)` at the identity type compile without a user impl.
impl<T> From<T> for T {
    fn from(t: T) -> T { return t; }
}

impl<S, T: From<S>> Into<T> for S {
    fn into(self: S) -> T { return T::from(self); }
}

impl<S, T: TryFrom<S>> TryInto<T> for S {
    type Error = T::Error;
    fn try_into(self: S) -> Result<T, T::Error> { return T::try_from(self); }
}

// ─── Lossless widening ─────────────────────────────────────────────────
// Rust's portable `From` set between integers (core::convert::num, 128-bit
// types omitted): every pair whose source range fits the target on every
// target width. `usize`/`isize` count as at least 16 bits wide here, as in Rust.

impl From<i8> for i16 { fn from(val: i8) -> i16 { return val as i16; } }
impl From<i8> for i32 { fn from(val: i8) -> i32 { return val as i32; } }
impl From<i8> for i64 { fn from(val: i8) -> i64 { return val as i64; } }
impl From<i8> for isize { fn from(val: i8) -> isize { return val as isize; } }
impl From<i16> for i32 { fn from(val: i16) -> i32 { return val as i32; } }
impl From<i16> for i64 { fn from(val: i16) -> i64 { return val as i64; } }
impl From<i16> for isize { fn from(val: i16) -> isize { return val as isize; } }
impl From<i32> for i64 { fn from(val: i32) -> i64 { return val as i64; } }
impl From<u8> for u16 { fn from(val: u8) -> u16 { return val as u16; } }
impl From<u8> for u32 { fn from(val: u8) -> u32 { return val as u32; } }
impl From<u8> for u64 { fn from(val: u8) -> u64 { return val as u64; } }
impl From<u8> for usize { fn from(val: u8) -> usize { return val as usize; } }
impl From<u8> for i16 { fn from(val: u8) -> i16 { return val as i16; } }
impl From<u8> for i32 { fn from(val: u8) -> i32 { return val as i32; } }
impl From<u8> for i64 { fn from(val: u8) -> i64 { return val as i64; } }
impl From<u8> for isize { fn from(val: u8) -> isize { return val as isize; } }
impl From<u16> for u32 { fn from(val: u16) -> u32 { return val as u32; } }
impl From<u16> for u64 { fn from(val: u16) -> u64 { return val as u64; } }
impl From<u16> for usize { fn from(val: u16) -> usize { return val as usize; } }
impl From<u16> for i32 { fn from(val: u16) -> i32 { return val as i32; } }
impl From<u16> for i64 { fn from(val: u16) -> i64 { return val as i64; } }
impl From<u32> for u64 { fn from(val: u32) -> u64 { return val as u64; } }
impl From<u32> for i64 { fn from(val: u32) -> i64 { return val as i64; } }

// ─── TryFrom — range-checked integer conversions ────────────────────────
// Every ordered pair outside the `From` set, failing with `TryFromIntError`.
// The checks assume a 64-bit `usize`/`isize`.

impl TryFrom<i8> for u8 {
    type Error = TryFromIntError;
    fn try_from(val: i8) -> Result<u8, TryFromIntError> {
        if val < 0i8 { return Result::Err(TryFromIntError::new(IntErrorKind::NegOverflow)); }
        return Result::Ok(val as u8);
    }
}
impl TryFrom<i8> for u16 {
    type Error = TryFromIntError;
    fn try_from(val: i8) -> Result<u16, TryFromIntError> {
        if val < 0i8 { return Result::Err(TryFromIntError::new(IntErrorKind::NegOverflow)); }
        return Result::Ok(val as u16);
    }
}
impl TryFrom<i8> for u32 {
    type Error = TryFromIntError;
    fn try_from(val: i8) -> Result<u32, TryFromIntError> {
        if val < 0i8 { return Result::Err(TryFromIntError::new(IntErrorKind::NegOverflow)); }
        return Result::Ok(val as u32);
    }
}
