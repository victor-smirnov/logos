// Logos standard library — std.clone
//
// Clone — explicit deep copy (Rust-style: `fn clone(&self) -> Self`).
// Copy  — marker trait for types that can be bitwise-copied implicitly.
//
// `clone` takes `&self` (not by-value `self: Self`) so the caller's binding
// stays usable after the call — mirrors Rust and lets generic adapters that
// need both the original and a clone (e.g. CycleIter) write the natural
// `let copy = iter.clone(); use(iter, copy)`.

package logos.lang.clone;

/// Types whose values can be explicitly duplicated.
pub trait Clone {
    /// Returns a duplicate of `*self`, independent of the original.
    fn clone(&self) -> Self;
}

/// Marker trait for types that can be duplicated by a plain bitwise copy.
pub trait Copy {}

impl Clone for i8    { fn clone(&self) -> i8    { return *self; } }
impl Clone for i16   { fn clone(&self) -> i16   { return *self; } }
impl Clone for i32   { fn clone(&self) -> i32   { return *self; } }
impl Clone for i64   { fn clone(&self) -> i64   { return *self; } }
impl Clone for u8    { fn clone(&self) -> u8    { return *self; } }
impl Clone for u16   { fn clone(&self) -> u16   { return *self; } }
impl Clone for u32   { fn clone(&self) -> u32   { return *self; } }
impl Clone for u64   { fn clone(&self) -> u64   { return *self; } }
impl Clone for usize { fn clone(&self) -> usize { return *self; } }
impl Clone for isize { fn clone(&self) -> isize { return *self; } }
impl Clone for f32   { fn clone(&self) -> f32   { return *self; } }
impl Clone for f64   { fn clone(&self) -> f64   { return *self; } }
impl Clone for bool  { fn clone(&self) -> bool  { return *self; } }
impl Clone for char  { fn clone(&self) -> char  { return *self; } }

impl Copy for i8    {}
impl Copy for i16   {}
impl Copy for i32   {}
impl Copy for i64   {}
impl Copy for u8    {}
impl Copy for u16   {}
impl Copy for u32   {}
impl Copy for u64   {}
impl Copy for usize {}
impl Copy for isize {}
impl Copy for f32   {}
impl Copy for f64   {}
impl Copy for bool  {}
impl Copy for char  {}

// Tuples of Copy / Clone elements are Copy / Clone (Rust's per-arity impls).
impl<A: Copy, B: Copy> Copy for (A, B) {}
impl<A: Copy, B: Copy, C: Copy> Copy for (A, B, C) {}
impl<A: Copy, B: Copy, C: Copy, D: Copy> Copy for (A, B, C, D) {}
impl<A: Copy, B: Copy, C: Copy, D: Copy, E: Copy> Copy for (A, B, C, D, E) {}
impl<A: Copy, B: Copy, C: Copy, D: Copy, E: Copy, F: Copy> Copy for (A, B, C, D, E, F) {}
impl<A: Copy, B: Copy, C: Copy, D: Copy, E: Copy, F: Copy, G: Copy> Copy for (A, B, C, D, E, F, G) {}
impl<A: Copy, B: Copy, C: Copy, D: Copy, E: Copy, F: Copy, G: Copy, H: Copy> Copy for (A, B, C, D, E, F, G, H) {}
impl<A: Clone, B: Clone> Clone for (A, B) { fn clone(&self) -> (A, B) { return (self.0.clone(), self.1.clone()); } }
impl<A: Clone, B: Clone, C: Clone> Clone for (A, B, C) { fn clone(&self) -> (A, B, C) { return (self.0.clone(), self.1.clone(), self.2.clone()); } }
impl<A: Clone, B: Clone, C: Clone, D: Clone> Clone for (A, B, C, D) { fn clone(&self) -> (A, B, C, D) { return (self.0.clone(), self.1.clone(), self.2.clone(), self.3.clone()); } }
impl<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone> Clone for (A, B, C, D, E) { fn clone(&self) -> (A, B, C, D, E) { return (self.0.clone(), self.1.clone(), self.2.clone(), self.3.clone(), self.4.clone()); } }
impl<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone, F: Clone> Clone for (A, B, C, D, E, F) { fn clone(&self) -> (A, B, C, D, E, F) { return (self.0.clone(), self.1.clone(), self.2.clone(), self.3.clone(), self.4.clone(), self.5.clone()); } }
impl<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone, F: Clone, G: Clone> Clone for (A, B, C, D, E, F, G) { fn clone(&self) -> (A, B, C, D, E, F, G) { return (self.0.clone(), self.1.clone(), self.2.clone(), self.3.clone(), self.4.clone(), self.5.clone(), self.6.clone()); } }
impl<A: Clone, B: Clone, C: Clone, D: Clone, E: Clone, F: Clone, G: Clone, H: Clone> Clone for (A, B, C, D, E, F, G, H) { fn clone(&self) -> (A, B, C, D, E, F, G, H) { return (self.0.clone(), self.1.clone(), self.2.clone(), self.3.clone(), self.4.clone(), self.5.clone(), self.6.clone(), self.7.clone()); } }
