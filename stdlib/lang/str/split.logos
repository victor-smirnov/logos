// Logos standard library — std.lang.text.split
//
// Splitter: iterator over substrings of a `str` separated by a fixed separator.
// Returns sub-`str` views into the input — caller must keep the original
// buffer alive for the duration of iteration.
//
// Semantics match Rust/Python `split`:
//   "a,b,c"      split on ","   ->  ["a", "b", "c"]
//   "a,,b"       split on ","   ->  ["a", "", "b"]
//   ""           split on ","   ->  [""]
//   "abc"        split on ","   ->  ["abc"]
//   ",a,"        split on ","   ->  ["", "a", ""]

package logos.lang.str;

use logos.lang.iter;
use logos.lang.option;
use logos.lang.ops;

/// Yields substrings of the input separated by a fixed multi-byte `str` separator.
///
/// Segments are sub-`str` views into the original buffer, which must outlive iteration.
pub struct Splitter<'a> {
    rest: &'a str,  // remaining input
    sep: &'a str,   // separator
    done: bool,     // true after final segment yielded
}

impl<'a> Iterator<&'a str> for Splitter<'a> {
    fn next(self: &mut Splitter<'a>) -> Option<&'a str> {
        if self.done { return Option::None; }
        let n: i64 = self.rest.len();
        let sn: i64 = self.sep.len();
        if sn == 0 as i64 {
            // Empty separator: yield whole rest once.
            self.done = true;
            return Option::Some(self.rest);
        }
        let idx: i64 = str_index_of(self.rest, self.sep);
        if idx < 0 as i64 {
            self.done = true;
            return Option::Some(self.rest);
        }
        unsafe {
            let head: str = str_from_raw(self.rest.as_ptr(), idx);
            let tail_ptr: *const u8 = (self.rest.as_ptr() as i64 + idx + sn) as *const u8;
            let tail_len: i64 = n - idx - sn;
            self.rest = str_from_raw(tail_ptr, tail_len);
            return Option::Some(head);
        }
    }
}

/// Splits `s` on each occurrence of `sep`, yielding sub-`str` views into `s`.
///
/// Empty `sep` yields the whole `s` once.
pub fn split<'a>(s: &'a str, sep: &'a str) -> Splitter<'a> {
    return Splitter { rest: s, sep: sep, done: false };
}

/// Yields substrings of the input separated by a fixed single-byte separator.
///
/// Common fast path for `','`, `'/'`, etc. Segments are sub-`str` views into the
/// original buffer, which must outlive iteration.
pub struct ByteSplitter<'a> {
    rest: &'a str,
    sep: u8,
    done: bool,
}

impl<'a> Iterator<&'a str> for ByteSplitter<'a> {
    fn next(self: &mut ByteSplitter<'a>) -> Option<&'a str> {
        if self.done { return Option::None; }
        let n: i64 = self.rest.len();
        let sp: *const u8 = self.rest.as_ptr();
        let mut i: i64 = 0 as i64;
        unsafe {
            while i < n {
                if (*((sp as i64 + i) as *const u8)) == self.sep {
                    let head: str = str_from_raw(sp, i);
                    let tail_ptr: *const u8 = (sp as i64 + i + 1 as i64) as *const u8;
                    self.rest = str_from_raw(tail_ptr, n - i - 1 as i64);
                    return Option::Some(head);
                }
                i = i + 1 as i64;
            }
        }
        self.done = true;
        return Option::Some(self.rest);
    }
}

/// Splits `s` on each occurrence of the single byte `sep`, yielding sub-`str` views into `s`.
pub fn split_byte<'a>(s: &'a str, sep: u8) -> ByteSplitter<'a> {
    return ByteSplitter { rest: s, sep: sep, done: false };
}

// ── Pattern-driven Splitter ─────────────────────────────────────────────
//
// Mirrors `str::split(P)` where P: Pattern. Generic over the pattern
// type, so str / u8 / u32-codepoint all work through one type.
//
// Behaviour matches the byte/str splitters above:
//   * empty haystack → one empty-str yield
//   * pattern at start/end → empty segments
//   * non-overlapping matches drive the split

/// Generic pattern-driven splitter over a `str`, parameterized by any `Pattern` type.
///
/// Segments are sub-`str` views into the original buffer, which must outlive iteration.
pub struct SplitPat<'a, P> {
    haystack: &'a str,
    pat:      P,
    pos:      i64,
    done:     bool,
}

/// Splits `s` on each match of pattern `p`, yielding sub-`str` views into `s`.
pub fn str_split_pat<'a, P: Pattern>(s: &'a str, p: P) -> SplitPat<'a, P> {
    return SplitPat::<P> { haystack: s, pat: p, pos: 0i64, done: false };
}

impl<'a, P: Pattern> Iterator<&'a str> for SplitPat<'a, P> {
    fn next(self: &mut SplitPat<'a, P>) -> Option<&'a str> {
        if self.done { return Option::None; }
        // Mirror Matches's "advancing pos over immutable haystack" shape
        // — mutating `rest` between calls hits a generic-struct-field
        // staleness in mono dispatch.
        let idx: i64 = self.pat.find_in(self.haystack, self.pos);
        let total: i64 = self.haystack.len();
        unsafe {
            let base: *const u8 = self.haystack.as_ptr();
            if idx < 0i64 {
                self.done = true;
                let tail_ptr: *const u8 = (base as i64 + self.pos) as *const u8;
                return Option::Some(str_from_raw(tail_ptr, total - self.pos));
            }
            let mlen: i64 = self.pat.match_len();
            let head_ptr: *const u8 = (base as i64 + self.pos) as *const u8;
            let head_len: i64 = idx - self.pos;
            self.pos = idx + mlen;
            return Option::Some(str_from_raw(head_ptr, head_len));
        }
    }
}
