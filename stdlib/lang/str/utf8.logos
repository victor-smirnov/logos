// Logos standard library — std.utf8
//
// UTF-8 encoding / decoding utilities.
//
// Codepoints are represented as u32 (Unicode scalar values 0..=0x10FFFF).
// U+FFFD (0xFFFD) is the replacement character used on invalid input.
//
// All functions taking (*const u8, len) operate on a byte slice — they do NOT
// require a null terminator.

package logos.lang.str;

use logos.lang.iter;
use logos.lang.ops;
use logos.lang.option;
use logos.lang.result;

// ── Encoding / decoding ───────────────────────────────────────────────────

// Number of bytes required to encode `cp` in UTF-8 (1..=4, or 0 for invalid).
pub fn encode_len(cp: u32) -> i64 {
    if cp < 0x80 as u32          { return 1; }
    if cp < 0x800 as u32         { return 2; }
    if cp < 0x10000 as u32       { return 3; }
    if cp <= 0x10FFFF as u32     { return 4; }
    return 0;
}

// Length of the UTF-8 sequence starting with `b` (1..=4, or 1 for invalid).
pub fn seq_len(b: u8) -> i64 {
    let v: i32 = b as i32;
    if v < 0x80  { return 1; }
    if v < 0xC0  { return 1; }  // continuation byte — treat as 1 (skip)
    if v < 0xE0  { return 2; }
    if v < 0xF0  { return 3; }
    return 4;
}

// Decode the codepoint at ptr[0..].  Returns U+FFFD on invalid sequences.
// Does NOT bounds-check beyond byte 0 — caller must ensure ptr is valid.
pub unsafe fn decode(ptr: *const u8) -> u32 {
    let b0: i32 = ptr[0] as i32;
    if b0 < 0x80 { return b0 as u32; }
    if b0 < 0xC2 { return 0xFFFD as u32; }   // overlong or stray continuation
    if b0 < 0xE0 {
        let b1: i32 = ptr[1] as i32;
        if (b1 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        let cp: u32 = (((b0 & 0x1F) << 6) | (b1 & 0x3F)) as u32;
        if cp < 0x80 as u32 { return 0xFFFD as u32; }  // overlong
        return cp;
    }
    if b0 < 0xF0 {
        let b1: i32 = ptr[1] as i32;
        let b2: i32 = ptr[2] as i32;
        if (b1 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        if (b2 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        let cp: u32 = (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)) as u32;
        if cp < 0x800 as u32 { return 0xFFFD as u32; }  // overlong
        if cp >= 0xD800 as u32 && cp <= 0xDFFF as u32 { return 0xFFFD as u32; }  // surrogate
        return cp;
    }
    if b0 < 0xF5 {
        let b1: i32 = ptr[1] as i32;
        let b2: i32 = ptr[2] as i32;
        let b3: i32 = ptr[3] as i32;
        if (b1 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        if (b2 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        if (b3 & 0xC0) != 0x80 { return 0xFFFD as u32; }
        let cp: u32 = (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) |
                       ((b2 & 0x3F) << 6)  |  (b3 & 0x3F)) as u32;
        if cp < 0x10000 as u32  { return 0xFFFD as u32; }  // overlong
        if cp > 0x10FFFF as u32 { return 0xFFFD as u32; }  // out of range
        return cp;
    }
    return 0xFFFD as u32;
}

// Encode codepoint `cp` into buf[0..].  Returns bytes written (1..=4).
// Returns 0 and writes U+FFFD (3 bytes) if cp is invalid.
// Caller must ensure buf has at least 4 bytes of space.
pub unsafe fn encode(cp: u32, buf: *mut u8) -> i64 {
    if cp < 0x80 as u32 {
        buf[0] = cp as u8;
        return 1;
    }
    if cp < 0x800 as u32 {
        buf[0] = (0xC0 | (cp >> 6))  as u8;
        buf[1] = (0x80 | (cp & 0x3F)) as u8;
        return 2;
    }
    if cp < 0x10000 as u32 {
        if cp >= 0xD800 as u32 && cp <= 0xDFFF as u32 {
            // surrogates — emit replacement
            buf[0] = 0xEF as u8;
            buf[1] = 0xBF as u8;
            buf[2] = 0xBD as u8;
            return 3;
        }
        buf[0] = (0xE0 | (cp >> 12))         as u8;
        buf[1] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
        buf[2] = (0x80 | (cp & 0x3F))         as u8;
        return 3;
    }
    if cp <= 0x10FFFF as u32 {
        buf[0] = (0xF0 | (cp >> 18))          as u8;
        buf[1] = (0x80 | ((cp >> 12) & 0x3F)) as u8;
        buf[2] = (0x80 | ((cp >> 6)  & 0x3F)) as u8;
        buf[3] = (0x80 | (cp & 0x3F))          as u8;
        return 4;
    }
    // invalid — emit U+FFFD
    buf[0] = 0xEF as u8;
    buf[1] = 0xBF as u8;
    buf[2] = 0xBD as u8;
    return 3;
}

// ── Slice-level operations ────────────────────────────────────────────────

// Count the number of codepoints in the UTF-8 byte slice ptr[0..len].
// Invalid bytes each count as one replacement character.
pub unsafe fn char_count(ptr: *const u8, len: i64) -> i64 {
    let mut pos: i64 = 0;
    let mut n: i64 = 0;
    while pos < len {
        let step: i64 = seq_len(ptr[pos]);
        let avail: i64 = len - pos;
        if step > avail {
            // truncated sequence — count remaining bytes one-by-one
            n = n + avail;
            pos = len;
        } else {
            n = n + 1;
            pos = pos + step;
        }
    }
    return n;
}

// Validate that ptr[0..len] is well-formed UTF-8. Returns false on any error.
pub unsafe fn is_valid(ptr: *const u8, len: i64) -> bool {
    let mut pos: i64 = 0;
    while pos < len {
        let base: *const u8 = (ptr as i64 + pos) as *const u8;
        let b0: i32 = base[0] as i32;
        if b0 < 0x80 { pos = pos + 1; }
        else if b0 < 0xC2 { return false; }
        else if b0 < 0xE0 {
            if pos + 2 > len { return false; }
            let b1: i32 = base[1] as i32;
            if (b1 & 0xC0) != 0x80 { return false; }
            let cp: u32 = (((b0 & 0x1F) << 6) | (b1 & 0x3F)) as u32;
            if cp < 0x80 as u32 { return false; }
            pos = pos + 2;
        } else if b0 < 0xF0 {
            if pos + 3 > len { return false; }
            let b1: i32 = base[1] as i32;
            let b2: i32 = base[2] as i32;
            if (b1 & 0xC0) != 0x80 { return false; }
            if (b2 & 0xC0) != 0x80 { return false; }
            let cp: u32 = (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)) as u32;
            if cp < 0x800 as u32 { return false; }
            if cp >= 0xD800 as u32 && cp <= 0xDFFF as u32 { return false; }
            pos = pos + 3;
        } else if b0 < 0xF5 {
            if pos + 4 > len { return false; }
            let b1: i32 = base[1] as i32;
            let b2: i32 = base[2] as i32;
            let b3: i32 = base[3] as i32;
            if (b1 & 0xC0) != 0x80 { return false; }
            if (b2 & 0xC0) != 0x80 { return false; }
            if (b3 & 0xC0) != 0x80 { return false; }
            let cp: u32 = (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) |
                           ((b2 & 0x3F) << 6)  |  (b3 & 0x3F)) as u32;
            if cp < 0x10000 as u32  { return false; }
            if cp > 0x10FFFF as u32 { return false; }
            pos = pos + 4;
        } else {
            return false;
        }
    }
    return true;
}

// ── Chars iterator ────────────────────────────────────────────────────────

// Iterator over the Unicode codepoints (u32) of a UTF-8 byte slice.
// Invalid sequences yield U+FFFD (one per invalid byte).
pub struct Chars {
    ptr: *const u8,
    pos: i64,
    len: i64,
}

// Construct a Chars iterator from a raw pointer + byte length.
pub unsafe fn chars_from_raw(ptr: *const u8, len: i64) -> Chars {
    return Chars { ptr: ptr, pos: 0, len: len };
}

// Construct a Chars iterator from a str slice.
pub fn str_chars(s: str) -> Chars {
    return Chars { ptr: s.as_ptr(), pos: 0, len: s.len() };
}

impl Iterator<u32> for Chars {
    fn next(self: &mut Chars) -> Option<u32> {
        if self.pos >= self.len {
            return Option::None;
        }
        unsafe {
            let b0: u8 = self.ptr[self.pos];
            let slen: i64 = seq_len(b0);
            let avail: i64 = self.len - self.pos;
            if slen > avail {
                self.pos = self.pos + 1;
                return Option::Some(0xFFFD as u32);
            }
            let p: *const u8 = (self.ptr as i64 + self.pos) as *const u8;
            let cp: u32 = decode(p);
            self.pos = self.pos + slen;
            return Option::Some(cp);
        }
    }
}

// ── CharIndices iterator ──────────────────────────────────────────────────
//
// Mirrors `core::str::CharIndices`. Yields `(byte_offset, codepoint)`
// pairs as a Logos struct (we don't have anonymous tuples in trait-
// method return positions yet). Byte offset is the position of the
// codepoint's first byte in the source slice.

pub struct CharIndex {
    pub idx: i64,
    pub ch:  u32,
}

pub struct CharIndices {
    ptr: *const u8,
    pos: i64,
    len: i64,
}

pub fn str_char_indices(s: str) -> CharIndices {
    return CharIndices { ptr: s.as_ptr(), pos: 0, len: s.len() };
}

impl Iterator<CharIndex> for CharIndices {
    fn next(self: &mut CharIndices) -> Option<CharIndex> {
        if self.pos >= self.len {
            return Option::None;
        }
        unsafe {
            let start: i64 = self.pos;
            let b0: u8 = self.ptr[self.pos];
            let slen: i64 = seq_len(b0);
            let avail: i64 = self.len - self.pos;
            if slen > avail {
                self.pos = self.pos + 1;
                return Option::Some(CharIndex { idx: start, ch: 0xFFFD as u32 });
            }
            let p: *const u8 = (self.ptr as i64 + self.pos) as *const u8;
            let cp: u32 = decode(p);
            self.pos = self.pos + slen;
            return Option::Some(CharIndex { idx: start, ch: cp });
        }
    }
}

// ── Bytes iterator ────────────────────────────────────────────────────────
//
// Mirrors `core::str::Bytes` — yields the raw bytes of a string
// slice without UTF-8 decoding. Equivalent to `s.as_bytes().iter()`
// in Rust; Logos exposes it as a typed struct so `for b in s.bytes()`
// dispatches uniformly.

pub struct Bytes {
    ptr: *const u8,
    pos: i64,
    len: i64,
}

pub fn str_bytes(s: str) -> Bytes {
    return Bytes { ptr: s.as_ptr(), pos: 0, len: s.len() };
}

impl Iterator<u8> for Bytes {
    fn next(self: &mut Bytes) -> Option<u8> {
        if self.pos >= self.len { return Option::None; }
        unsafe {
            let b: u8 = self.ptr[self.pos];
            self.pos = self.pos + 1;
            return Option::Some(b);
        }
    }
}

// ── Lines iterator ────────────────────────────────────────────────────────
//
// Mirrors `core::str::Lines`. Yields successive lines split on `\n`,
// with an optional preceding `\r` consumed (so CRLF endings work).
// The trailing newline (and CR) are stripped from each yielded
// slice. Final empty line after a trailing newline is NOT yielded
// (Rust semantics — `"a\nb\n".lines()` yields "a", "b").

pub struct Lines {
    ptr: *const u8,
    pos: i64,
    len: i64,
}

pub fn str_lines(s: str) -> Lines {
    return Lines { ptr: s.as_ptr(), pos: 0, len: s.len() };
}

impl Iterator<str> for Lines {
    fn next(self: &mut Lines) -> Option<str> {
        if self.pos >= self.len { return Option::None; }
        unsafe {
            let start: i64 = self.pos;
            // Advance to next '\n' or end.
            while self.pos < self.len {
                let b: u8 = self.ptr[self.pos];
                if b == 10u8 { break; }
                self.pos = self.pos + 1;
            }
            // Slice end = self.pos, possibly stripping preceding \r.
            let mut end: i64 = self.pos;
            if end > start {
                let prev: u8 = self.ptr[end - 1];
                if prev == 13u8 { end = end - 1; }
            }
            // Skip the \n if we landed on one.
            if self.pos < self.len { self.pos = self.pos + 1; }
            let base: *const u8 = (self.ptr as i64 + start) as *const u8;
            let length: i64 = end - start;
            return Option::Some(str_from_raw(base, length));
        }
    }
}

// ── Utf8Error ─────────────────────────────────────────────────────────────
//
// Mirrors `core::str::Utf8Error`. Returned by `utf8_validate` to describe
// where a UTF-8 byte stream went wrong:
//   * `valid_up_to` — number of bytes that were valid before the error.
//   * `error_len`   — length of the invalid sequence, or -1 for a truncated
//                     sequence at the tail (Rust's `None` case).

pub struct Utf8Error {
    pub valid_up_to: i64,
    pub error_len:   i64,
}

pub fn utf8_error_valid_up_to(e: Utf8Error) -> i64 { return e.valid_up_to; }

pub fn utf8_error_len(e: Utf8Error) -> Option<i64> {
    if e.error_len < 0 { return Option::None; }
    return Option::Some(e.error_len);
}

// Validate that ptr[0..len] is well-formed UTF-8. On success returns Ok(()).
// On failure, returns Err(Utf8Error{ valid_up_to, error_len }) where
// error_len is the count of bad bytes (1..=3), or -1 if truncated.
pub unsafe fn utf8_validate(ptr: *const u8, len: i64) -> Result<(), Utf8Error> {
    let mut pos: i64 = 0;
    while pos < len {
        let base: *const u8 = (ptr as i64 + pos) as *const u8;
        let b0: i32 = base[0] as i32;
        if b0 < 0x80 { pos = pos + 1; }
        else if b0 < 0xC2 {
            return Result::Err(Utf8Error { valid_up_to: pos, error_len: 1 });
        }
        else if b0 < 0xE0 {
            if pos + 2 > len {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: -1 });
            }
            let b1: i32 = base[1] as i32;
            if (b1 & 0xC0) != 0x80 {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: 1 });
            }
            let cp: u32 = (((b0 & 0x1F) << 6) | (b1 & 0x3F)) as u32;
            if cp < 0x80 as u32 {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: 2 });
            }
            pos = pos + 2;
        } else if b0 < 0xF0 {
            if pos + 3 > len {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: -1 });
            }
            let b1: i32 = base[1] as i32;
            let b2: i32 = base[2] as i32;
            if (b1 & 0xC0) != 0x80 {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: 1 });
            }
            if (b2 & 0xC0) != 0x80 {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: 2 });
            }
            let cp: u32 = (((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)) as u32;
            if cp < 0x800 as u32 {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: 3 });
            }
            if cp >= 0xD800 as u32 && cp <= 0xDFFF as u32 {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: 3 });
            }
            pos = pos + 3;
        } else if b0 < 0xF5 {
            if pos + 4 > len {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: -1 });
            }
            let b1: i32 = base[1] as i32;
            let b2: i32 = base[2] as i32;
            let b3: i32 = base[3] as i32;
            if (b1 & 0xC0) != 0x80 {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: 1 });
            }
            if (b2 & 0xC0) != 0x80 {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: 2 });
            }
            if (b3 & 0xC0) != 0x80 {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: 3 });
            }
            let cp: u32 = (((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) |
                           ((b2 & 0x3F) << 6)  |  (b3 & 0x3F)) as u32;
            if cp < 0x10000 as u32 {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: 4 });
            }
            if cp > 0x10FFFF as u32 {
                return Result::Err(Utf8Error { valid_up_to: pos, error_len: 4 });
            }
            pos = pos + 4;
        } else {
            return Result::Err(Utf8Error { valid_up_to: pos, error_len: 1 });
        }
    }
    return Result::Ok(());
}

// ── Utf8Chunks iterator ───────────────────────────────────────────────────
//
// Mirrors `core::str::Utf8Chunks`. Each chunk represents a maximal run of
// valid UTF-8 followed by zero or more invalid bytes (the "invalid tail").
// `valid` is the well-formed slice; `invalid_bytes` is the length of the
// trailing invalid run (caller treats those bytes as U+FFFD).

pub struct Utf8Chunk {
    pub valid:         str,
    pub invalid_bytes: i64,
}

pub struct Utf8Chunks {
    ptr: *const u8,
    pos: i64,
    len: i64,
}

pub fn str_utf8_chunks(s: str) -> Utf8Chunks {
    return Utf8Chunks { ptr: s.as_ptr(), pos: 0, len: s.len() };
}

pub unsafe fn utf8_chunks_from_raw(ptr: *const u8, len: i64) -> Utf8Chunks {
    return Utf8Chunks { ptr: ptr, pos: 0, len: len };
}

impl Iterator<Utf8Chunk> for Utf8Chunks {
    fn next(self: &mut Utf8Chunks) -> Option<Utf8Chunk> {
        if self.pos >= self.len { return Option::None; }
        unsafe {
            let valid_start: i64 = self.pos;
            // Walk forward while we have well-formed UTF-8.
            loop {
                if self.pos >= self.len { break; }
                let remain: i64 = self.len - self.pos;
                let probe: *const u8 = (self.ptr as i64 + self.pos) as *const u8;
                let r: Result<(), Utf8Error> = utf8_validate(probe, remain);
                match r {
                    Result::Ok(_)  => { self.pos = self.len; break; }
                    Result::Err(e) => {
                        if e.valid_up_to > 0 {
                            self.pos = self.pos + e.valid_up_to;
                            break;
                        }
                        // valid_up_to == 0: invalid right at the cursor —
                        // produce a chunk with an empty valid prefix.
                        break;
                    }
                }
            }
            let valid_end: i64 = self.pos;
            let valid_len: i64 = valid_end - valid_start;
            let valid_base: *const u8 = (self.ptr as i64 + valid_start) as *const u8;
            let valid: str = str_from_raw(valid_base, valid_len);

            // Count invalid bytes (1..=3, matching Utf8Error::error_len; or
            // remaining bytes for the truncated-tail case).
            let mut invalid: i64 = 0;
            if self.pos < self.len {
                let remain: i64 = self.len - self.pos;
                let probe: *const u8 = (self.ptr as i64 + self.pos) as *const u8;
                let r2: Result<(), Utf8Error> = utf8_validate(probe, remain);
                match r2 {
                    Result::Ok(_) => { /* nothing — exhausted */ }
                    Result::Err(e) => {
                        if e.error_len < 0 {
                            // truncated tail — everything left is "invalid"
                            invalid = remain;
                        } else {
                            invalid = e.error_len;
                        }
                    }
                }
                self.pos = self.pos + invalid;
            }
            return Option::Some(Utf8Chunk { valid: valid, invalid_bytes: invalid });
        }
    }
}

// ── ParseBoolError ────────────────────────────────────────────────────────
//
// Mirrors `core::str::ParseBoolError`. Returned by `bool_from_str` when the
// input is neither "true" nor "false". The struct is opaque (no fields) —
// Rust does the same for forward compatibility.

pub struct ParseBoolError {}

pub fn bool_from_str(s: str) -> Result<bool, ParseBoolError> {
    let n: i64 = s.len();
    let p: *const u8 = s.as_ptr();
    unsafe {
        if n == 4 {
            if p[0] == 116u8 && p[1] == 114u8 && p[2] == 117u8 && p[3] == 101u8 {
                return Result::Ok(true);
            }
        }
        if n == 5 {
            if p[0] == 102u8 && p[1] == 97u8 && p[2] == 108u8 && p[3] == 115u8 && p[4] == 101u8 {
                return Result::Ok(false);
            }
        }
    }
    return Result::Err(ParseBoolError {});
}

// ── Pattern impl for codepoint (u32) ──────────────────────────────────────
//
// Mirrors Rust's `Pattern for char`. Logos represents codepoints as `u32`
// (see file header), so we provide `impl Pattern for u32`. The haystack is
// scanned a codepoint at a time using `seq_len` + `decode`, so the byte
// offset returned by `find_in` is always at a codepoint boundary.

impl Pattern for u32 {
    fn find_in(self: u32, haystack: str, from: i64) -> i64 {
        let m: i64 = haystack.len();
        if from < 0i64 || from > m { return -1i64; }
        let mut i: i64 = from;
        unsafe {
            let base: *const u8 = haystack.as_ptr();
            while i < m {
                let b0: u8 = base[i];
                let slen: i64 = seq_len(b0);
                if i + slen > m {
                    // Truncated tail — bail.
                    return -1i64;
                }
                let p: *const u8 = (base as i64 + i) as *const u8;
                let cp: u32 = decode(p);
                if cp == self { return i; }
                i = i + slen;
            }
        }
        return -1i64;
    }
    fn match_len(self: u32) -> i64 { return encode_len(self); }
}

// ── Matches / MatchIndices iterators ──────────────────────────────────────
//
// Mirror Rust's `str::matches(P)` / `str::match_indices(P)`. The pattern
// is stored by value and probed at each step via `find_in`; `match_len`
// drives the advance so overlapping matches (e.g., "aa" in "aaaa") behave
// like Rust (non-overlapping).
//
// Pattern is `P: Pattern + Copy` because we re-invoke find_in each step;
// every existing Pattern impl is on a value-type (str / u8 / u32) so Copy
// holds trivially.

pub struct Matches<P> {
    haystack: str,
    pat: P,
    pos: i64,
}

pub fn str_matches<P: Pattern>(s: str, p: P) -> Matches<P> {
    return Matches::<P> { haystack: s, pat: p, pos: 0i64 };
}

impl<P: Pattern> Iterator<str> for Matches<P> {
    fn next(self: &mut Matches<P>) -> Option<str> {
        let idx: i64 = self.pat.find_in(self.haystack, self.pos);
        if idx < 0i64 { return Option::None; }
        let mlen: i64 = self.pat.match_len();
        // Advance: at least one byte even on zero-length match to avoid
        // an infinite loop, matching Rust's empty-pattern semantics.
        let step: i64 = if mlen == 0i64 { 1i64 } else { mlen };
        self.pos = idx + step;
        unsafe {
            let base: *const u8 = (self.haystack.as_ptr() as i64 + idx) as *const u8;
            return Option::Some(str_from_raw(base, mlen));
        }
    }
}

pub struct StrMatchIndex {
    pub idx: i64,
    pub m:   str,
}

pub struct MatchIndices<P> {
    haystack: str,
    pat: P,
    pos: i64,
}

pub fn str_match_indices<P: Pattern>(s: str, p: P) -> MatchIndices<P> {
    return MatchIndices::<P> { haystack: s, pat: p, pos: 0i64 };
}

impl<P: Pattern> Iterator<StrMatchIndex> for MatchIndices<P> {
    fn next(self: &mut MatchIndices<P>) -> Option<StrMatchIndex> {
        let idx: i64 = self.pat.find_in(self.haystack, self.pos);
        if idx < 0i64 { return Option::None; }
        let mlen: i64 = self.pat.match_len();
        let step: i64 = if mlen == 0i64 { 1i64 } else { mlen };
        self.pos = idx + step;
        unsafe {
            let base: *const u8 = (self.haystack.as_ptr() as i64 + idx) as *const u8;
            let m: str = str_from_raw(base, mlen);
            return Option::Some(StrMatchIndex { idx: idx, m: m });
        }
    }
}
