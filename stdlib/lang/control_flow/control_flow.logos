// Logos standard library — logos.lang.control_flow
//
// `ControlFlow<B, C>` — Rust's two-state control-flow signal type
// (Break vs Continue). Used as the return type of `Try::branch`:
// the `?` operator desugars to a match on the Continue/Break
// variants — Continue extracts the success value, Break early-
// returns via FromResidual.
//
// §6.5 sub-deliverable 1/2 (paired with the Try / FromResidual
// trait surface in `stdlib/lang/try_trait/`).

package logos.lang.control_flow;

/// Two-state control-flow signal used to short-circuit iteration or `?`-desugaring.
pub enum ControlFlow<B, C> {
    /// Keep going, carrying the intermediate success value `C`.
    Continue(C),
    /// Stop early, carrying the residual/break value `B`.
    Break(B),
}

impl<B, C> ControlFlow<B, C> {
    /// Returns `true` if `self` is `ControlFlow::Continue`.
    pub fn is_continue(&self) -> bool {
        match self {
            ControlFlow::Continue(_) => { return true; }
            ControlFlow::Break(_)    => { return false; }
        }
    }
    /// Returns `true` if `self` is `ControlFlow::Break`.
    pub fn is_break(&self) -> bool {
        match self {
            ControlFlow::Continue(_) => { return false; }
            ControlFlow::Break(_)    => { return true; }
        }
    }
}
