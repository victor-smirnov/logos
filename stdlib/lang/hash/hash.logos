// Logos standard library — std.hash
//
// Hasher/Hash traits + default FxHasher implementation.
// FxHash is a fast non-cryptographic hash (used internally by rustc); it's
// adequate for HashMap collision distribution on non-adversarial inputs.
// SipHash-2-4 can be slotted in later with the same trait surface.

package logos.lang.hash;

use logos.lang.arith;
use logos.lang.ptr;     // byte_add — for fnv1a_bytes

/// Computes 64-bit FNV-1a over the byte range `[ptr, ptr + len)`.
///
/// Byte-slice hash for string / byte-buffer keys — the case `FxHasher`'s typed writers
/// don't cover. Non-cryptographic; adequate for hash-map collision distribution on
/// non-adversarial inputs. Caller must ensure `ptr` is valid for `len` bytes.
pub unsafe fn fnv1a_bytes(ptr: *const u8, len: u64) -> u64 {
    let mut h: u64 = 0xcbf29ce484222325;
    let prime: u64 = 0x100000001b3;
    let mut i: u64 = 0;
    while i < len {
        let b: u64 = (*ptr.byte_add(i as i64)) as u64;
        h = h ^ b;
        h = wrapping_mul(h, prime);   // FNV intentionally wraps
        i = wrapping_add(i, 1u64);
    }
    return h;
}

/// Accumulates a hash over a stream of integer writes; `finish` yields the result.
///
/// No byte-stream writer yet — values are fed as whole integers (see `Hash for str`
/// for the byte-slice workaround).
pub trait Hasher {
    /// Mixes a `u64` into the hasher state.
    fn write_u64(&mut self, val: u64);
    /// Mixes a `u32` into the hasher state.
    fn write_u32(&mut self, val: u32);
    /// Mixes an `i64` into the hasher state.
    fn write_i64(&mut self, val: i64);
    /// Mixes an `i32` into the hasher state.
    fn write_i32(&mut self, val: i32);
    /// Mixes a `bool` into the hasher state.
    fn write_bool(&mut self, val: bool);
    /// Returns the hash of all values written so far; does not reset the state.
    fn finish(&self) -> u64;
}

/// Types hashable through any `Hasher`; mirrors `core::hash::Hash`.
pub trait Hash {
    /// Feeds this value into `state`.
    fn hash<H: Hasher>(&self, state: &mut H);
}

// ── FxHasher ────────────────────────────────────────────────────────────────
// state ← (state.rotate_left(5) ^ x) * SEED

/// Fast non-cryptographic `Hasher` using rustc's FxHash mix; not collision-resistant
/// against adversarial inputs.
pub struct FxHasher { s: u64 }

/// Creates an `FxHasher` with zero initial state.
pub fn fx_hasher_new() -> FxHasher {
    return FxHasher { s: 0 as u64 };
}

impl Hasher for FxHasher {
    fn write_u64(&mut self, val: u64) {
        let rot: u64 = (self.s << 5 as u64) | (self.s >> 59 as u64);
        let seed: u64 = 0x517cc1b727220a95 as u64;
        self.s = wrapping_mul(rot ^ val, seed);  // FxHasher mix intentionally wraps
    }
    fn write_u32(&mut self, val: u32) { self.write_u64(val as u64); }
    fn write_i64(&mut self, val: i64) { self.write_u64(val as u64); }
    fn write_i32(&mut self, val: i32) { self.write_u64(val as i64 as u64); }
    fn write_bool(&mut self, val: bool) {
        if val { self.write_u64(1 as u64); } else { self.write_u64(0 as u64); }
    }
    fn finish(&self) -> u64 { return self.s; }
}

// ── Hash impls for primitives ───────────────────────────────────────────────

impl Hash for i32 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_i32(*self); }
}
impl Hash for i64 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_i64(*self); }
}
impl Hash for u32 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_u32(*self); }
}
impl Hash for u64 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_u64(*self); }
}
impl Hash for u8 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_u64(*self as u64); }
}
impl Hash for i8 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_i64(*self as i64); }
}
impl Hash for bool {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_bool(*self); }
}
impl Hash for usize {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_u64(*self as u64); }
}
impl Hash for i16 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_i64(*self as i64); }
}
impl Hash for u16 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_u64(*self as u64); }
}
impl Hash for isize {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_i64(*self as i64); }
}
// ── THE 128-BIT AND PACKED WIDTHS ───────────────────────────────────────────
// These six were held out by a comment on this line claiming `impl Eq for u128`
// SIGSEGVs on call. RE-MEASURED 2026-08-05 at c6c212c7 and the claim does not
// reproduce, including its own stated probe; the paragraph was a name list
// wearing a reason. `logos.lang.cmp` carries the `Eq` half now, and
// `el::el_index_key_ok` admits all six as index keys.
//
// ⚠ A 128-BIT VALUE MUST FEED BOTH HALVES, AND THAT IS NOT A CORRECTNESS FACT —
// which is exactly why it needs its own assertion. `Hasher` has no `write_u128`,
// so `state.write_u64(*self as u64)` alone would hash only the low 64 bits; two
// values differing above bit 63 would then land in the same bucket and the map
// would still separate them by `Eq`, so every ANSWER stays right and a
// `HashMap<u128, V>` degrades to a linear scan on exactly the keys a 128-bit
// column exists for. No row-level test can see that. `wql_join_wide_key_e2e`
// asserts it directly instead — `hv(&0u128) != hv(&(1u128 << 64))`, a pair that
// differs ONLY above bit 63, and likewise for `i128`.
impl Hash for u128 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_u64(*self as u64);
        state.write_u64((*self >> 64u128) as u64);
    }
}
impl Hash for i128 {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_u64(*self as u64);
        state.write_u64((*self >> 64i128) as u64);
    }
}
// The packed widths are Writ storage encodings, and they are also ordinary
// Logos integer types: `u56`/`u24` zero-extend into u64 and `i56`/`i24`
// sign-extend into i64, both bijectively, so the hash of the widened value is
// the hash of the value.
impl Hash for u56 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_u64(*self as u64); }
}
impl Hash for i56 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_i64(*self as i64); }
}
impl Hash for u24 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_u64(*self as u64); }
}
impl Hash for i24 {
    fn hash<H: Hasher>(&self, state: &mut H) { state.write_i64(*self as i64); }
}
// Tuple Hash — per-arity generic impls (arities 2..8), Rust-parity: hash each
// component in order (no length prefix — the arity is part of the type). The
// per-arity form is the pattern tuple Eq used before its variadic rewrite; a
// variadic `impl<A...: Hash> Hash for (A...)` needs a new mono intrinsic
// (`__tuple_each_hash__`, complicated by the method-level `H: Hasher` type
// param) — tracked for when >8-ary tuple keys matter. 8 covers the WQL rel
// column fan-out (RQRELCOL_MAX) and the common compound-key range.
impl<A: Hash, B: Hash> Hash for (A, B) {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.0.hash(state); self.1.hash(state);
    }
}
impl<A: Hash, B: Hash, C: Hash> Hash for (A, B, C) {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.0.hash(state); self.1.hash(state); self.2.hash(state);
    }
}
impl<A: Hash, B: Hash, C: Hash, D: Hash> Hash for (A, B, C, D) {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.0.hash(state); self.1.hash(state); self.2.hash(state); self.3.hash(state);
    }
}
impl<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash> Hash for (A, B, C, D, E) {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.0.hash(state); self.1.hash(state); self.2.hash(state); self.3.hash(state);
        self.4.hash(state);
    }
}
impl<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash, F: Hash> Hash for (A, B, C, D, E, F) {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.0.hash(state); self.1.hash(state); self.2.hash(state); self.3.hash(state);
        self.4.hash(state); self.5.hash(state);
    }
}
impl<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash, F: Hash, G: Hash> Hash for (A, B, C, D, E, F, G) {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.0.hash(state); self.1.hash(state); self.2.hash(state); self.3.hash(state);
        self.4.hash(state); self.5.hash(state); self.6.hash(state);
    }
}
impl<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash, F: Hash, G: Hash, I: Hash> Hash for (A, B, C, D, E, F, G, I) {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.0.hash(state); self.1.hash(state); self.2.hash(state); self.3.hash(state);
        self.4.hash(state); self.5.hash(state); self.6.hash(state); self.7.hash(state);
    }
}

// `str` hashes by CONTENT (Rust parity: `Hash for str` hashes the bytes + a
// length terminator). The Hasher trait has no byte-stream writer yet, so the
// bytes are pre-mixed with FNV-1a and fed as one u64, followed by the length
// (the terminator role: distinguishes ("ab","c") from ("a","bc") in compound
// keys). Equal strings hash equal regardless of provenance — the HashMap<str,V>
// key contract (Eq for str is byte equality).
impl Hash for str {
    /// Hashes by content: FNV-1a pre-mix of the bytes as one `u64`, then the byte length.
    fn hash<H: Hasher>(&self, state: &mut H) {
        let s: str = *self;
        state.write_u64(unsafe { fnv1a_bytes(s.as_ptr(), s.len() as u64) });
        state.write_u64(s.len() as u64);
    }
}

// ── SipHasher (SipHash-2-4) ──────────────────────────────────────────────
//
// Cryptographically-stronger-than-FxHash hash. Standard SipHash-2-4
// with 128-bit key. The Hasher trait writes one integer per `write_*`
// call; we feed each as a single 64-bit block (eight bytes accounted
// against `length`). (`Hash for str` above pre-mixes the bytes with
// FNV-1a into one u64 — a streaming `write_u8` loop can replace that
// once the Hasher trait grows a byte writer.)

/// SipHash-2-4 `Hasher` with a 128-bit key; each `write_*` feeds one 64-bit block.
///
/// `v0..v3` are the four SipHash internal state words.
pub struct SipHasher {
    pub v0: u64, pub v1: u64, pub v2: u64, pub v3: u64,
    /// Count of bytes compressed so far; each `write_*` accounts eight.
    pub length: u64,
}

fn sip_rotl64(x: u64, n: u32) -> u64 {
    return (x << n as u64) | (x >> (64u32 - n) as u64);
}

fn sip_round(h: &mut SipHasher) {
    h.v0 = wrapping_add(h.v0, h.v1);
    h.v1 = sip_rotl64(h.v1, 13u32);
    h.v1 = h.v1 ^ h.v0;
    h.v0 = sip_rotl64(h.v0, 32u32);
    h.v2 = wrapping_add(h.v2, h.v3);
    h.v3 = sip_rotl64(h.v3, 16u32);
    h.v3 = h.v3 ^ h.v2;
    h.v0 = wrapping_add(h.v0, h.v3);
    h.v3 = sip_rotl64(h.v3, 21u32);
    h.v3 = h.v3 ^ h.v0;
    h.v2 = wrapping_add(h.v2, h.v1);
    h.v1 = sip_rotl64(h.v1, 17u32);
    h.v1 = h.v1 ^ h.v2;
    h.v2 = sip_rotl64(h.v2, 32u32);
}

/// Creates a `SipHasher` keyed with the 128-bit key `(k0, k1)`.
pub fn sip_hasher_with_keys(k0: u64, k1: u64) -> SipHasher {
    return SipHasher {
        v0: k0 ^ 0x736f6d6570736575u64,
        v1: k1 ^ 0x646f72616e646f6du64,
        v2: k0 ^ 0x6c7967656e657261u64,
        v3: k1 ^ 0x7465646279746573u64,
        length: 0u64,
    };
}

/// Creates a `SipHasher` with the all-zero key.
pub fn sip_hasher_new() -> SipHasher {
    return sip_hasher_with_keys(0u64, 0u64);
}

impl Hasher for SipHasher {
    fn write_u64(&mut self, val: u64) {
        // Compression: v3 ^= m; c=2 rounds; v0 ^= m.
        self.v3 = self.v3 ^ val;
        sip_round(self);
        sip_round(self);
        self.v0 = self.v0 ^ val;
        self.length = self.length + 8u64;
    }
    fn write_u32(&mut self, val: u32) { self.write_u64(val as u64); }
    fn write_i64(&mut self, val: i64) { self.write_u64(val as u64); }
    fn write_i32(&mut self, val: i32) { self.write_u64(val as i64 as u64); }
    fn write_bool(&mut self, val: bool) {
        if val { self.write_u64(1u64); } else { self.write_u64(0u64); }
    }
    fn finish(&self) -> u64 {
        // Finalization: inject length byte, v2 ^= 0xff, d=4 rounds.
        let mut h: SipHasher = SipHasher {
            v0: self.v0,
            v1: self.v1,
            v2: self.v2 ^ 0xffu64,
            v3: self.v3 ^ (self.length << 56u64),
            length: self.length,
        };
        sip_round(&mut h);
        sip_round(&mut h);
        sip_round(&mut h);
        sip_round(&mut h);
        return h.v0 ^ h.v1 ^ h.v2 ^ h.v3;
    }
}

// ── BuildHasher / DefaultHasher ─────────────────────────────────────────
//
// Logos doesn't have associated types, so BuildHasher is parameterised
// over H: Hasher instead of carrying it as an assoc type. Used by
// HashMap-style containers to keep the seed alive across construct ions.

/// Factory producing fresh `H` hashers; lets containers keep one seed across many hashes.
///
/// Parameterised over `H: Hasher` in lieu of an associated type (Logos has none yet).
pub trait BuildHasher<H: Hasher> {
    /// Creates a fresh hasher in its initial state.
    fn build_hasher(&self) -> H;
}

/// `BuildHasher` for the default hasher: a zero-keyed `SipHasher`.
///
/// Mirrors `std::collections::hash_map::DefaultHasher` (Rust uses SipHash-1-3;
/// Logos uses SipHash-2-4 — slightly slower, equally collision-resistant).
pub struct DefaultBuildHasher {}

/// Creates a `DefaultBuildHasher`.
pub fn default_build_hasher() -> DefaultBuildHasher {
    return DefaultBuildHasher {};
}

impl BuildHasher<SipHasher> for DefaultBuildHasher {
    fn build_hasher(&self) -> SipHasher {
        return sip_hasher_new();
    }
}
