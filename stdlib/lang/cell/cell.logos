// Logos standard library — std.cell
//
// UnsafeCell<T> — the core interior-mutability primitive. Mirrors
// `core::cell::UnsafeCell` from Rust's stdlib.
//
// Semantics: a transparent wrapper around `T` whose `.get(&self)`
// hands back a `*mut T` pointing at the wrapped value. Holding only
// `&UnsafeCell<T>` does NOT prevent the caller from writing through
// the returned raw pointer; this is the documented escape hatch
// that Cell / RefCell / Mutex / Atomic / OnceCell etc. build on top
// of. Misusing it (overlapping `&mut T` and `&T` borrows derived
// from the same cell, racing writes from multiple threads, etc.) is
// UB, hence the unsafe-block requirement at every dereference site.
//
// Logos already allows the `&self.value as *const T as *mut T` cast in
// `unsafe` blocks, so the struct BODY needs no special powers. The compiler
// does, however, treat `logos.lang.cell.UnsafeCell` as a lang-item —
// recognised by qualified name (sema_auto_trait.cpp / sema.cpp): a type
// reachable through it is auto-`!Sync` (shared `&T` can mutate the interior,
// so racing readers would race-write), its `Send` follows the wrapped `T`,
// and `T` is INVARIANT (an `UnsafeCell<&'a X>` can't be lifetime-subtyped).
// Beyond those auto-trait / variance rules the borrow checker does not yet
// model interior-mutability aliasing; matching Rust's full alias analysis is
// a separate workstream.

package logos.lang.cell;

use logos.lang.option;
use logos.lang.result;
use logos.lang.default;
use logos.lang.clone;
use logos.lang.panic;
use logos.lang.drop;

// `#[repr(transparent)]` — same layout / ABI as `T`. Required for
// `UnsafeCell::from_mut` to be a sound `&mut T → &mut UnsafeCell<T>`
// reinterpret, and for the documented zero-cost guarantee.
/// Wraps a `T` mutable through `&self` — the primitive underlying all interior-mutability types.
/// Auto-`!Sync` and invariant in `T`; aliasing discipline is the caller's `unsafe` obligation.
#[repr(transparent)]
pub struct UnsafeCell<T> {
    value: T,
}

impl<T> UnsafeCell<T> {
    /// Creates a new `UnsafeCell` wrapping `value`.
    pub fn new(value: T) -> UnsafeCell<T> {
        return UnsafeCell { value: value };
    }

    /// Consumes the cell, returning the wrapped value — the only way to recover `T`
    /// without raw pointers.
    pub fn into_inner(self: UnsafeCell<T>) -> T {
        return self.value;
    }

    /// Returns a raw `*mut T` to the wrapped value — writable despite taking `&self`.
    ///
    /// Writing while any `&T`/`&mut T` derived from this cell is live, or racing
    /// unsynchronised writes across threads, is UB.
    pub fn get(&self) -> *mut T {
        unsafe {
            return (&self.value) as *const T as *mut T;
        }
    }

    /// Returns `&mut T` to the wrapped value; `&mut self` already guarantees exclusivity.
    pub fn get_mut(&mut self) -> &mut T {
        return &mut self.value;
    }

    /// Returns `*mut T` like `get`, but from a raw `*const Self` — no reference is
    /// materialised, so it is usable while the interior is uninitialised.
    pub fn raw_get(this: *const UnsafeCell<T>) -> *mut T {
        unsafe {
            return this as *const T as *mut T;
        }
    }
}

// ─────────────────────────────────────────────────────────────────────
// Cell<T> — safe interior mutability for Copy types
//
// Mirrors `core::cell::Cell`. Built on top of UnsafeCell with a
// `T: Copy` bound, exposing a typed `get`/`set` instead of raw
// pointers. The Copy bound means every read returns a fresh value, so
// there's never an aliasing-derived `&T` outstanding to worry about
// when writing through `&self`.
//
// `take()` (requires `T: Default`) is exposed as a free fn
// `cell_take(&cell)` instead of an inherent method — Logos doesn't yet
// resolve `T::default()` from a where-clause-bound T inside an inherent
// impl (same workaround as `option_unwrap_or_default`).

/// Provides safe interior mutability for `Copy` types via by-value `get`/`set`.
#[repr(transparent)]
pub struct Cell<T> {
    inner: UnsafeCell<T>,
}

impl<T> Cell<T> {
    /// Creates a new `Cell` containing `value`.
    pub fn new(value: T) -> Cell<T> {
        return Cell { inner: UnsafeCell::new(value) };
    }

    /// Consumes the cell, returning the wrapped value.
    pub fn into_inner(self: Cell<T>) -> T {
        return self.inner.into_inner();
    }

    /// Returns a raw `*mut T` to the underlying value.
    pub fn as_ptr(&self) -> *mut T {
        return self.inner.get();
    }

    /// Returns a mutable reference to the underlying value.
    pub fn get_mut(&mut self) -> &mut T {
        return self.inner.get_mut();
    }
}

impl<T: Copy> Cell<T> {
    /// Returns a copy of the contained value.
    pub fn get(&self) -> T {
        unsafe {
            return *self.inner.get();
        }
    }

    /// Sets the contained value.
    pub fn set(&self, val: T) {
        unsafe {
            *self.inner.get() = val;
        }
    }

    /// Replaces the contained value with `val`, returning the old value.
    pub fn replace(&self, val: T) -> T {
        unsafe {
            let p: *mut T = self.inner.get();
            let old: T = *p;
            *p = val;
            return old;
        }
    }

    /// Swaps the values of two cells.
    pub fn swap(&self, other: &Cell<T>) {
        unsafe {
            let a: *mut T = self.inner.get();
            let b: *mut T = other.inner.get();
            let tmp: T = *a;
            *a = *b;
            *b = tmp;
        }
    }

    /// Replaces the contained value with `f` applied to the current value.
    pub fn update(&self, f: fn(T) -> T) {
        unsafe {
            let p: *mut T = self.inner.get();
            *p = f(*p);
        }
    }
}

// Free-fn form of `Cell::take` — see module comment for why this can't
// live inside `impl<T: Copy + Default> Cell<T>` today.
/// Takes the cell's value, leaving `T::default()` in its place.
pub fn cell_take<T: Copy + Default>(c: &Cell<T>) -> T {
    unsafe {
        let p: *mut T = c.as_ptr();
        let old: T = *p;
        *p = T::default();
        return old;
    }
}

// ─────────────────────────────────────────────────────────────────────
// RefCell<T> — runtime-checked dynamic borrowing
//
// Mirrors `core::cell::RefCell`. Holds a borrow counter in addition to
// the value; `.borrow()` / `.borrow_mut()` hand out guards (Ref / RefMut)
// that increment the counter on creation and decrement it on Drop.
//
// State semantics (i32):
//   0      → unborrowed
//   n > 0  → n active shared borrows
//   n < 0  → exclusively borrowed (-1; future-proofed against reentrant
//            mut counters, currently always -1)
//
// `borrow()` and `borrow_mut()` panic on conflict; the `try_borrow*`
// variants return `Result<…, BorrowError|BorrowMutError>`. Both
// pattern-extraction and let-binding forms drop the guard correctly
// at scope/arm end (the previous match-arm Drop gap is fixed at
// sema_stmt.cpp::lower_match[_expr]).
//
// Divergence: Rust's `Ref<'b, T>` carries a lifetime tying the guard
// to the cell. Logos guards hold raw pointers — the caller must not
// outlive the cell. Memory safety relies on the existing borrow
// checker treating the guard's deref as a normal `&T`/`&mut T`.

/// Returned by `RefCell::try_borrow` when the value is already mutably borrowed.
pub struct BorrowError {}
/// Returned by `RefCell::try_borrow_mut` when the value is already borrowed.
pub struct BorrowMutError {}

/// Wraps a value with runtime-checked dynamic borrowing via `Ref`/`RefMut` guards.
/// Guards hold raw pointers, not lifetimes — a guard must not outlive its cell.
pub struct RefCell<T> {
    state: UnsafeCell<i32>,
    value: UnsafeCell<T>,
}

/// Guards a shared borrow of a `RefCell` value; access via `get`, released on drop.
pub struct Ref<T> {
    value: *const T,
    state: *mut i32,
}

/// Guards an exclusive borrow of a `RefCell` value; access via `get`/`get_mut`, released on drop.
pub struct RefMut<T> {
    value: *mut T,
    state: *mut i32,
}

impl<T> RefCell<T> {
    /// Creates a new `RefCell` containing `value`.
    pub fn new(value: T) -> RefCell<T> {
        return RefCell {
            state: UnsafeCell::new(0i32),
            value: UnsafeCell::new(value),
        };
    }

    /// Consumes the cell, returning the wrapped value.
    pub fn into_inner(self: RefCell<T>) -> T {
        return self.value.into_inner();
    }

    /// Returns a raw `*mut T` to the underlying value, bypassing borrow tracking.
    pub fn as_ptr(&self) -> *mut T {
        return self.value.get();
    }

    /// Returns `&mut T` directly; `&mut self` proves exclusivity, so no runtime check.
    pub fn get_mut(&mut self) -> &mut T {
        return self.value.get_mut();
    }

    /// Attempts a shared borrow, returning a `Ref` guard; errors if mutably borrowed.
    pub fn try_borrow(&self) -> Result<Ref<T>, BorrowError> {
        unsafe {
            let sp: *mut i32 = self.state.get();
            if *sp < 0i32 {
                return Result::Err(BorrowError {});
            }
            *sp = *sp + 1i32;
            return Result::Ok(Ref {
                value: self.value.get() as *const T,
                state: sp,
            });
        }
    }

    /// Borrows the value shared, returning a `Ref` guard.
    /// Panics if the value is currently mutably borrowed.
    pub fn borrow(&self) -> Ref<T> {
        match self.try_borrow() {
            Result::Ok(r)  => { return r; }
            Result::Err(_) => { panic("RefCell: already mutably borrowed"); }
        }
        unsafe {
            return Ref {
                value: self.value.get() as *const T,
                state: self.state.get(),
            };
        }
    }

    /// Attempts an exclusive borrow, returning a `RefMut` guard; errors if any borrow is active.
    pub fn try_borrow_mut(&self) -> Result<RefMut<T>, BorrowMutError> {
        unsafe {
            let sp: *mut i32 = self.state.get();
            if *sp != 0i32 {
                return Result::Err(BorrowMutError {});
            }
            *sp = -1i32;
            return Result::Ok(RefMut {
                value: self.value.get(),
                state: sp,
            });
        }
    }

    /// Borrows the value exclusively, returning a `RefMut` guard.
    /// Panics if the value is currently borrowed.
    pub fn borrow_mut(&self) -> RefMut<T> {
        match self.try_borrow_mut() {
            Result::Ok(r)  => { return r; }
            Result::Err(_) => { panic("RefCell: already borrowed"); }
        }
        unsafe {
            return RefMut {
                value: self.value.get(),
                state: self.state.get(),
            };
        }
    }

    /// Replaces the wrapped value with `t`, returning the old value.
    /// Panics if the value is currently borrowed.
    pub fn replace(&self, t: T) -> T {
        let mut g: RefMut<T> = self.borrow_mut();
        unsafe {
            let old: T = *g.value;
            *g.value = t;
            return old;
        }
    }

    /// Swaps the wrapped values of two cells.
    /// Panics if either cell is currently borrowed, or if `self` and `other` are the same cell.
    pub fn swap(&self, other: &RefCell<T>) {
        let mut a: RefMut<T> = self.borrow_mut();
        let mut b: RefMut<T> = other.borrow_mut();
        unsafe {
            let tmp: T = *a.value;
            *a.value = *b.value;
            *b.value = tmp;
        }
    }
}

impl<T> Ref<T> {
    // Deref-equivalent (Logos has no Deref trait — methods instead).
    /// Returns a shared reference to the borrowed value.
    pub fn get(&self) -> &T {
        unsafe { return &*self.value; }
    }
}

impl<T> RefMut<T> {
    /// Returns a shared reference to the borrowed value.
    pub fn get(&self) -> &T {
        unsafe { return &*self.value; }
    }
    /// Returns a mutable reference to the borrowed value.
    pub fn get_mut(&mut self) -> &mut T {
        unsafe { return &mut *self.value; }
    }
}

impl<T> Drop for Ref<T> {
    fn drop(self: Ref<T>) {
        unsafe {
            *self.state = *self.state - 1i32;
        }
    }
}

impl<T> Drop for RefMut<T> {
    fn drop(self: RefMut<T>) {
        unsafe {
            *self.state = 0i32;
        }
    }
}

// ── Ref::map / try_map ──────────────────────────────────────────────────
//
// Mirrors `core::cell::Ref::map` / `Ref::filter_map`. Transforms a
// `Ref<T>` into a `Ref<U>` by applying a fn that maps `&T -> &U`. The
// borrow counter is bumped one extra step, so when both the original
// guard and the new guard drop the count stays balanced — no
// ManuallyDrop dance is required.
//
// Divergence: Rust uses `FnOnce(&T) -> &U`. We use fn-ptr today
// (no closure captures) — same behaviour for the typical refcell-map
// use case where the mapping is a struct field projection.

/// Maps a `Ref<T>` into a `Ref<U>` for a component of the borrowed data, keeping the borrow.
pub fn ref_map<T, U>(orig: Ref<T>, f: fn(&T) -> &U) -> Ref<U> {
    unsafe {
        let target: &U = f(&*orig.value);
        // Bump the counter so the new Ref's Drop is balanced once
        // orig drops at the end of this fn.
        *orig.state = *orig.state + 1i32;
        return Ref::<U> {
            value: target as *const U,
            state: orig.state,
        };
    }
}

/// Maps a `Ref<T>` to `Ref<U>` if `f` yields `Some`, else returns the original guard in `Err`.
pub fn ref_filter_map<T, U>(
    orig: Ref<T>,
    f: fn(&T) -> Option<&U>,
) -> Result<Ref<U>, Ref<T>> {
    unsafe {
        let r: Option<&U> = f(&*orig.value);
        match r {
            Option::Some(target) => {
                *orig.state = *orig.state + 1i32;
                return Result::<Ref<U>, Ref<T>>::Ok(Ref::<U> {
                    value: target as *const U,
                    state: orig.state,
                });
            }
            Option::None => {
                return Result::<Ref<U>, Ref<T>>::Err(orig);
            }
        }
    }
}

/// Maps a `RefMut<T>` into a `RefMut<U>` for a component of the borrowed data.
pub fn ref_mut_map<T, U>(orig: RefMut<T>, f: fn(&mut T) -> &mut U) -> RefMut<U> {
    unsafe {
        let target: &mut U = f(&mut *orig.value);
        // RefMut's Drop sets state back to 0; we want the NEW guard to
        // do that, so suppress orig's Drop by reusing its state ptr
        // and trusting that the user passes ownership end-to-end.
        // Bumping a -1 state isn't valid (-1 is mut-borrow marker), so
        // we leave the state alone — orig.Drop and the new guard's
        // Drop both set it to 0, which is idempotent.
        return RefMut::<U> {
            value: target as *mut U,
            state: orig.state,
        };
    }
}

// Free-fn `RefCell::take` — same `T::default()` from where-clause-bound
// T workaround as `cell_take`.
/// Takes the wrapped value, leaving `T::default()` in its place.
/// Panics if the value is currently borrowed.
pub fn refcell_take<T: Default>(c: &RefCell<T>) -> T {
    return c.replace(T::default());
}

// ─────────────────────────────────────────────────────────────────────
// OnceCell<T> — write-once interior mutability
//
// Mirrors `core::cell::OnceCell`. After `.set(value)` succeeds, the
// stored value is immutable for the lifetime of the cell. `.get()`
// returns `None` until set, `Some(&value)` after. Re-`.set()` after
// success returns `Err(value)`.
//
// Layout: storage `T` inline + bool `present` flag, both inside
// UnsafeCell so `.set(&self, ...)` can mutate. Construction uses
// `T::default()` to seed the storage (free-fn `once_cell_new` bears
// the `T: Default` bound) so reads have a defined byte pattern
// regardless of `present`. Caller-facing API gates access on
// `present` so the default value is never observed.
//
// `get_or_init` takes a `fn() -> T` (no Fn-family traits yet); when
// those land we can take any `FnOnce() -> T`.
//
// TODO: switch storage to `MaybeUninit<T>` and relax `T: Default`
// once `mem::uninit::MaybeUninit` lives in a layer below lang.

/// Provides write-once interior mutability: set once via `&self`, then read-only.
/// Construct with `once_cell_new` (bears the `T: Default` bound that seeds storage).
pub struct OnceCell<T> {
    storage: UnsafeCell<T>,
    present: UnsafeCell<bool>,
}

/// Creates an empty `OnceCell`; storage is seeded with `T::default()` but never observed.
pub fn once_cell_new<T: Default>() -> OnceCell<T> {
    return OnceCell {
        storage: UnsafeCell::new(T::default()),
        present: UnsafeCell::new(false),
    };
}

impl<T> OnceCell<T> {
    /// Returns `true` if a value has been set.
    pub fn is_set(&self) -> bool {
        unsafe { return *self.present.get(); }
    }

    /// Returns a raw pointer to the stored value, or null when unset.
    pub fn get_ptr(&self) -> *const T {
        unsafe {
            if !*self.present.get() { return 0 as *const T; }
            return self.storage.get() as *const T;
        }
    }

    /// Returns `Some(&value)` if set, `None` otherwise.
    pub fn get(&self) -> Option<&T> {
        unsafe {
            if !*self.present.get() { return Option::<&T>::None; }
            let r: &T = &*self.storage.get();
            return Option::Some(r);
        }
    }

    /// Sets the value if unset; returns `Err(value)` when already set.
    pub fn set(&self, value: T) -> Result<(), T> {
        unsafe {
            if *self.present.get() {
                return Result::<(), T>::Err(value);
            }
            *self.storage.get() = value;
            *self.present.get() = true;
            return Result::<(), T>::Ok(());
        }
    }

    /// Returns the value, initialising it with `f()` first if unset.
    pub fn get_or_init(&self, f: fn() -> T) -> &T {
        unsafe {
            if !*self.present.get() {
                *self.storage.get() = f();
                *self.present.get() = true;
            }
            return &*self.storage.get();
        }
    }

    /// Consumes the cell, returning `Some(value)` if set, `None` otherwise.
    pub fn into_inner(self: OnceCell<T>) -> Option<T> {
        if self.is_set() {
            unsafe {
                let v: T = *self.storage.get();
                return Option::Some(v);
            }
        }
        return Option::<T>::None;
    }
}

// ─────────────────────────────────────────────────────────────────────
// LazyCell<T> — OnceCell + stored init closure
//
// Mirrors `core::cell::LazyCell`. Holds a `fn() -> T` plus a
// `OnceCell<T>`; first `.force()` calls the fn, caches the result,
// and returns `&T`. Subsequent calls return the cached `&T`.
//
// Divergence: stores `fn() -> T` (function pointer) instead of
// `F: FnOnce() -> T`. Closures with captures wait on Fn-family traits.

/// Defers initialisation: first `force` calls the stored `fn() -> T` and caches the result.
/// Construct with `lazy_cell_new`.
pub struct LazyCell<T> {
    cell: OnceCell<T>,
    init: fn() -> T,
}

/// Creates a `LazyCell` that initialises with `init` on first `force`.
pub fn lazy_cell_new<T: Default>(init: fn() -> T) -> LazyCell<T> {
    return LazyCell { cell: once_cell_new::<T>(), init: init };
}

impl<T> LazyCell<T> {
    /// Returns the cached value, computing it via `init` on first call.
    pub fn force(&self) -> &T {
        return self.cell.get_or_init(self.init);
    }
}
