// Logos stdlib — std/marker: marker traits.
//
// Send — a type is safe to transfer across thread boundaries.
// Sync — a type is safe to share by reference across threads (&T is Send iff T: Sync).
// Sized — the compiler knows the type's size at compile time. Implicitly
//         bounded on every generic type parameter unless opted out with
//         `T: ?Sized`. Unsized types: str, [T], dyn Trait — they appear
//         only behind references / pointers (fat pointers).
//
// Send/Sync are auto traits: the compiler synthesizes implementations from
// field types.  Raw pointers (*mut T / *const T) are hardcoded !Send / !Sync.
// To opt in for a type with raw-pointer fields, write:
//   unsafe impl Send for MyType {}

package logos.lang.marker;

/// Marks a type safe to transfer across thread boundaries.
/// Auto trait: the compiler synthesizes impls from field types. Raw pointers are `!Send`;
/// opt back in with `unsafe impl Send for MyType {}`.
pub auto trait Send {}
/// Marks a type safe to share by reference across threads: `&T` is `Send` iff `T: Sync`.
/// Auto trait: synthesized from field types; raw pointers are `!Sync`.
pub auto trait Sync {}
/// Marks a type whose size is known at compile time.
/// Implicit bound on every generic type parameter unless opted out with `T: ?Sized`.
/// Unsized types (`str`, `[T]`, `dyn Trait`) appear only behind (fat) references/pointers.
pub trait Sized {}

/// Marks a type that can be safely moved even after being pinned.
/// Auto trait: derived structurally — a type is `Unpin` unless it stores a `PhantomPinned`
/// field or is marked `#[pinned]`; refs and raw pointers are always `Unpin`. `Pin<P>`
/// ergonomics ship in `logos.lang.pin`.
pub auto trait Unpin {}

// Fst — a FIXED-SIZE, RELOCATION-SAFE value: statically sized, byte-movable,
// and free of ABSOLUTE REFERENCES (raw pointers, references, fat views, code
// pointers). The marker for values that may live inside relocatable,
// dumpable memory blocks (packed structures, Writ segments): a block whose
// contents are all `Fst` can be memcpy'd, shipped, or reloaded in another
// address space and stays meaningful. Structural derivation: scalars are
// `Fst`; structs/enums/tuples/arrays are `Fst` iff every field/element is;
// pointer/reference kinds and fn-pointers are NOT (a raw pointer may opt in
// with an explicit unsafe impl — the Send-style escape hatch — references
// never can). Note `Fst` neither implies nor requires `Copy`: `Copy` governs
// move semantics, `Fst` governs representation; packed element types
// typically want both (`T: Copy + Fst`).
/// Marks a fixed-size, relocation-safe value: byte-movable and free of absolute
/// references. Auto trait, derived structurally; pointer kinds are excluded.
pub auto trait Fst {}

/// A zero-sized field that opts a struct out of `Unpin`.
/// A struct containing one (or marked `#[pinned]`) is `!Unpin`, so it cannot be moved
/// out of a `Pin<P>`.
pub struct PhantomPinned {}

/// A zero-sized type-anchor for `T`.
/// Unlike Rust, does not drive dropck/variance/auto-traits here — serves only as a
/// type anchor, equivalent to a `_t: T` field without needing an actual `T` value.
/// Construct with the empty struct literal `PhantomData::<T>{}`.
pub struct PhantomData<T> {}

/// An empty (uninhabited) enum: the error type of a `Result` that can never be `Err`.
/// Not the never type — Logos has a real `!` (type of a divergent `fn … -> !`); use `!`
/// for divergence and `Infallible` only as a "this variant is impossible" stand-in.
pub enum Infallible {}

// SelfDescribing — a custom-DST (`struct Foo { hdr…, tail: [T] }`) whose tail
// length is recoverable from its own in-band header. Marking the struct
// `#[self_describing]` makes ALL reference forms (`*Foo`, `&Foo`, `&mut Foo`)
// a THIN raw pointer (the length is NOT carried out-of-band in a fat pointer).
// When the compiler needs the tail length — materializing a fat `&Foo` from a
// thin pointer (`&*p`), building a `foo.tail` → `&[T]`/`&mut [T]` view, or
// bound-checking `foo.tail[i]` — it calls `dst_len`. The receiver is the THIN
// `*const Self` (not `&Self`): the method reads only sized PREFIX fields, so the
// thin pointer suffices and avoids the chicken-and-egg of needing a fat
// reference (which carries the length) in order to recover the length. Returns
// the tail's ELEMENT count (not byte size). Stronger than stable Rust, whose
// only thin custom DST (`extern type`) is opaque-sized; mirrors the
// Writ/zoned self-describing model (ref-repr §6, zoned-types §4).
/// Implemented by custom-DSTs (`#[self_describing]` structs) to recover their tail length.
/// All reference forms (`*Foo`, `&Foo`, `&mut Foo`) become thin pointers; the compiler
/// calls `dst_len` whenever it needs the tail length (materializing a fat `&Foo`,
/// building a `foo.tail` view, bound-checking `foo.tail[i]`).
pub trait SelfDescribing {
    /// Returns the tail's element count (not byte size).
    /// Receiver is the thin `*const Self`: only sized prefix fields are needed to
    /// recover the length, avoiding the chicken-and-egg of needing a fat reference
    /// (which itself carries the length) to compute it.
    fn dst_len(self: *const Self) -> i64;
}
