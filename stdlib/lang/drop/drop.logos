// Logos standard library — std.drop
//
// Drop — called automatically when a value goes out of scope.
// Implement for types that need cleanup (e.g., heap-allocated resources).

package logos.lang.drop;

pub trait Drop {
    fn drop(self: Self);
}

// Take ownership of `value` and drop it immediately (mirrors `core::mem::drop`).
// The by-value parameter is dropped when this function returns, so callers can
// force an early drop of an owned value (`drop(x);`) before its lexical scope
// would otherwise end. Generic over all `T`; for a non-droppable `T` this is a
// no-op move.
pub fn drop<T>(value: T) {
    let _dropped: T = value;
}
