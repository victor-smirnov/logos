// logos.lang.fabric.string_store — SoA string storage for fabric Buffers.
//
// Relocated from lang.writ.string in the writ cut-over: the storage is
// malloc-backed SoA (packed bytes + end offsets) and never depended on the
// legacy zone — only its StringView (now lang.writ.hstatic). The marker
// datatype StrDt plugs Buffer<StrDt> into the Container machinery.

package logos.lang.fabric.string_store;

use logos.lang.fabric;
use logos.lang.writ.hstatic;   // StringView
use logos.lang.mem;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);

pub struct WritStringStorage {
    pub bytes: *mut u8,
    pub b_len: u64,
    pub b_cap: u64,
    pub ends:  *mut u32,
    pub o_len: u64,
    pub o_cap: u64,
}
impl Storage for WritStringStorage {
    type Elem = StringView;
    fn storage_len(s: *const WritStringStorage) -> u64 {
        unsafe { return s.o_len; }
    }
    fn storage_get(s: *const WritStringStorage, idx: u64) -> StringView {
        unsafe {
            let end_p: *mut u32 = s.ends.add(idx as i64);
            let end_off: u64 = *end_p as u64;
            let start_off: u64 = if idx == 0 {
                0
            } else {
                let prev: *mut u32 = s.ends.add(idx as i64 - 1);
                *prev as u64
            };
            return StringView {
                ptr: s.bytes.byte_add(start_off as i64) as *const u8,
                len: end_off - start_off,
            };
        }
    }
}

impl OwningStorage for WritStringStorage {
    fn storage_drop(s: *mut WritStringStorage) {
        unsafe {
            if s.bytes != 0 as *mut u8 {
                dealloc(s.bytes);
                s.bytes = 0 as *mut u8;
            }
            if s.ends != 0 as *mut u32 {
                dealloc(s.ends as *mut u8);
                s.ends = 0 as *mut u32;
            }
            s.b_len = 0; s.b_cap = 0;
            s.o_len = 0; s.o_cap = 0;
        }
    }
}

impl DynamicStorage for WritStringStorage {
    fn storage_new() -> WritStringStorage {
        return WritStringStorage {
            bytes: 0 as *mut u8,
            b_len: 0,
            b_cap: 0,
            ends:  0 as *mut u32,
            o_len: 0,
            o_cap: 0,
        };
    }
    fn storage_clear(s: *mut WritStringStorage) {
        unsafe {
            if s.bytes != 0 as *mut u8 {
                dealloc(s.bytes);
                s.bytes = 0 as *mut u8;
            }
            if s.ends != 0 as *mut u32 {
                dealloc(s.ends as *mut u8);
                s.ends = 0 as *mut u32;
            }
            s.b_len = 0; s.b_cap = 0;
            s.o_len = 0; s.o_cap = 0;
        }
    }
    fn storage_push(s: *mut WritStringStorage, v: StringView) {
        unsafe {
            // Grow bytes buffer to fit the new string.
            let need_b: u64 = s.b_len + v.len;
            if need_b > s.b_cap {
                let mut new_cap: u64 = if s.b_cap == 0 { 16 } else { s.b_cap * 2 };
                while new_cap < need_b { new_cap = new_cap * 2; }
                let new_buf: *mut u8 = if s.bytes == 0 as *mut u8 {
                    alloc(new_cap as i64)
                } else {
                    realloc_buf(s.bytes, new_cap as i64)
                };
                if new_buf == 0 as *mut u8 { return; }
                s.bytes = new_buf;
                s.b_cap = new_cap;
            }
            // Grow offsets buffer to fit the new end offset.
            if s.o_len == s.o_cap {
                let new_cap: u64 = if s.o_cap == 0 { 4 } else { s.o_cap * 2 };
                let new_buf: *mut u8 = if s.ends == 0 as *mut u32 {
                    alloc((new_cap * 4) as i64)
                } else {
                    realloc_buf(s.ends as *mut u8, (new_cap * 4) as i64)
                };
                if new_buf == 0 as *mut u8 { return; }
                s.ends  = new_buf as *mut u32;
                s.o_cap = new_cap;
            }
            // Copy bytes.
            let mut i: u64 = 0;
            while i < v.len {
                let dst: *mut u8 = s.bytes.byte_add(s.b_len as i64 + i as i64);
                let src: *const u8 = v.ptr.byte_add(i as i64);
                *dst = *src;
                i = i + 1;
            }
            s.b_len = s.b_len + v.len;
            // Append end-offset.
            let slot: *mut u32 = s.ends.add(s.o_len as i64);
            *slot = s.b_len as u32;
            s.o_len = s.o_len + 1;
        }
    }

    // Random-access mutation isn't implementable on packed-SoA storage
    // without rewriting the bytes tail.  Persistent collections that need
    // this should pick a different Container; the methods are stubbed
    // here so the trait stays whole.
    fn storage_set(s: *mut WritStringStorage, idx: u64, v: StringView) { }
    fn storage_insert_at(s: *mut WritStringStorage, idx: u64, v: StringView) { }
    fn storage_remove_at(s: *mut WritStringStorage, idx: u64) { }
}

impl Datatype for WritString {
    type View<S: Storage> = StringView;
}

// Marker datatype: Buffer<StrDt> stores StringViews in the SoA store.
pub struct StrDt {}

impl Datatype for StrDt {
    type View<S: Storage> = StringView;
}
impl Container for StrDt {
    type Store       = WritStringStorage;
    type ViewInStore = StringView;
    fn new_store()                                        -> WritStringStorage { return WritStringStorage::storage_new(); }
    fn drop_store(s: *mut WritStringStorage)                                   { unsafe { WritStringStorage::storage_drop(s); } }
    fn store_len(s: *const WritStringStorage)           -> u64                 { unsafe { return WritStringStorage::storage_len(s); } }
    fn store_push(s: *mut WritStringStorage, v: StringView)                    { unsafe { WritStringStorage::storage_push(s, v); } }
    fn store_get(s: *const WritStringStorage, idx: u64) -> StringView          { unsafe { return WritStringStorage::storage_get(s, idx); } }
    fn store_set(s: *mut WritStringStorage, idx: u64, v: StringView)           { unsafe { WritStringStorage::storage_set(s, idx, v); } }
    fn store_insert_at(s: *mut WritStringStorage, idx: u64, v: StringView)     { unsafe { WritStringStorage::storage_insert_at(s, idx, v); } }
    fn store_remove_at(s: *mut WritStringStorage, idx: u64)                    { unsafe { WritStringStorage::storage_remove_at(s, idx); } }
}
