// Logos standard library — std.range
//
// RangeI32 / RangeI64 — explicit range iterator types.
// `for i in 0..10` uses the compiler's built-in FOR node (no struct needed).
// These types are for when you need a *value* range to pass to adapters.
//
// §6.12 (Wave 8): adds the `Step` trait + generic `Range<T>` over
// any T: Step + Copy. Pre-existing concrete `RangeI32` / `RangeI64`
// stay wired (the for-loop desugar still constructs them); user
// code can opt into `Range<T>` directly when it needs a generic.

package logos.lang.range;

use logos.lang.option;
use logos.lang.iter;
use logos.lang.ops;

// §6.12: `Step` trait — Rust's iterator-element shape for ranges.
// Three primitives: forward step, backward step, and ordered-lt
// (so next() stops when current >= end).
pub trait Step {
    fn step_forward(self: Self) -> Self;
    fn step_backward(self: Self) -> Self;
    fn step_lt(self: Self, other: Self) -> bool;
}

impl Step for i32 {
    fn step_forward(self: i32)  -> i32  { return self + 1i32; }
    fn step_backward(self: i32) -> i32  { return self - 1i32; }
    fn step_lt(self: i32, other: i32) -> bool { return self < other; }
}
impl Step for i64 {
    fn step_forward(self: i64)  -> i64  { return self + (1 as i64); }
    fn step_backward(self: i64) -> i64  { return self - (1 as i64); }
    fn step_lt(self: i64, other: i64) -> bool { return self < other; }
}
impl Step for u32 {
    fn step_forward(self: u32)  -> u32  { return self + (1 as u32); }
    fn step_backward(self: u32) -> u32  { return self - (1 as u32); }
    fn step_lt(self: u32, other: u32) -> bool { return self < other; }
}
impl Step for u64 {
    fn step_forward(self: u64)  -> u64  { return self + (1 as u64); }
    fn step_backward(self: u64) -> u64  { return self - (1 as u64); }
    fn step_lt(self: u64, other: u64) -> bool { return self < other; }
}

// §6.12: generic range types — `RangeOf<T>` / `RangeOfIncl<T>` /
// `RangeOfFrom<T>`. Named with the `Of` suffix to AVOID collision
// with user code that defines its own non-generic `struct Range`
// in another package (Logos's monomorphizer keys structs by base
// name across packages; same name confuses the dispatch). User
// code can also use the concrete `RangeI32`/`RangeI64` (below) for
// for-loop interop; the generic shape covers iterators over u32 /
// u64 / char / user types that impl Step.
pub struct RangeOf<T: Step + Copy> {
    pub current: T,
    pub end:     T,
}

pub fn range_of<T: Step + Copy>(start: T, end: T) -> RangeOf<T> {
    return RangeOf { current: start, end: end };
}

impl<T: Step + Copy> Iterator<T> for RangeOf<T> {
    fn next(self: &mut RangeOf<T>) -> Option<T> {
        if self.current.step_lt(self.end) {
            let v: T = self.current;
            self.current = self.current.step_forward();
            return Option::Some(v);
        }
        return Option::None;
    }
}

// §6.12: generic inclusive range `[start, end]` — yields `end`
// as the last value, then stops.
pub struct RangeOfIncl<T: Step + Copy> {
    pub current: T,
    pub end:     T,
    pub done:    bool,
}

pub fn range_incl_of<T: Step + Copy>(start: T, end: T) -> RangeOfIncl<T> {
    return RangeOfIncl { current: start, end: end, done: false };
}

impl<T: Step + Copy> Iterator<T> for RangeOfIncl<T> {
    fn next(self: &mut RangeOfIncl<T>) -> Option<T> {
        if self.done { return Option::None; }
        let v: T = self.current;
        if self.current.step_lt(self.end) {
            self.current = self.current.step_forward();
        } else {
            if self.end.step_lt(self.current) { return Option::None; }
            self.done = true;
        }
        return Option::Some(v);
    }
}

// §6.12: generic `RangeOfFrom<T>` — unbounded `[start, …)`. Never
// returns None — callers must impose their own termination
// (`.take(n)` etc.).
pub struct RangeOfFrom<T: Step + Copy> {
    pub current: T,
}

pub fn range_from_of<T: Step + Copy>(start: T) -> RangeOfFrom<T> {
    return RangeOfFrom { current: start };
}

impl<T: Step + Copy> Iterator<T> for RangeOfFrom<T> {
    fn next(self: &mut RangeOfFrom<T>) -> Option<T> {
        let v: T = self.current;
        self.current = self.current.step_forward();
        return Option::Some(v);
    }
}

// §6.12: generic `RangeOfTo<T>` — half-open `[<unspecified>, end)`.
// Carries no start; iteration semantics are caller-supplied (e.g.
// for slicing `s[..hi]`). The Iterator impl is a marker — calling
// `.next()` on a bare RangeOfTo without an explicit start is a
// caller error (Rust's `RangeTo` doesn't implement Iterator directly
// either; it's mainly used as a slicing-index shape).
pub struct RangeOfTo<T: Step + Copy> {
    pub end: T,
}

pub fn range_to_of<T: Step + Copy>(end: T) -> RangeOfTo<T> {
    return RangeOfTo { end: end };
}

// §6.12: generic `RangeOfToIncl<T>` — half-open `[<unspecified>, end]`.
// Same caller-supplied-start model as RangeOfTo.
pub struct RangeOfToIncl<T: Step + Copy> {
    pub end: T,
}

pub fn range_to_incl_of<T: Step + Copy>(end: T) -> RangeOfToIncl<T> {
    return RangeOfToIncl { end: end };
}

// §6.12: `RangeOfFull` — unbounded `[…, …)`. Stateless; carries
// no values. Used as a slicing-index shape (`s[..]`). The legacy
// `RangeFull` + `range_full()` further down stay for backward
// compat (slicing receivers that already use them).
pub struct RangeOfFull {}

pub fn range_full_of() -> RangeOfFull {
    return RangeOfFull {};
}

// ── RangeI32 — exclusive range [start, end) over i32 ─────────────────────────

pub struct RangeI32 {
    pub current: i32,
    pub end: i32,
}

pub fn range_i32(lo: i32, hi: i32) -> RangeI32 {
    return RangeI32 { current: lo, end: hi };
}

impl Iterator<i32> for RangeI32 {
    fn next(self: &mut RangeI32) -> Option<i32> {
        if self.current >= self.end { return Option::None; }
        let v: i32 = self.current;
        self.current = self.current + 1;
        return Option::Some(v);
    }
}

impl DoubleEndedIterator<i32> for RangeI32 {
    fn next_back(self: &mut RangeI32) -> Option<i32> {
        if self.current >= self.end { return Option::None; }
        self.end = self.end - 1;
        return Option::Some(self.end);
    }
}

impl ExactSizeIterator<i32> for RangeI32 {
    fn len(&self) -> i64 {
        if self.current >= self.end { return 0 as i64; }
        return (self.end - self.current) as i64;
    }
}

// ── RevRangeI32 — same elements as RangeI32, yielded in reverse order ────────

pub struct RevRangeI32 {
    pub current: i32,  // next value to yield is current-1 (decrement-then-yield)
    pub start:   i32,
}

impl Iterator<i32> for RevRangeI32 {
    fn next(self: &mut RevRangeI32) -> Option<i32> {
        if self.current <= self.start { return Option::None; }
        self.current = self.current - 1;
        return Option::Some(self.current);
    }
}

impl RangeI32 {
    // Specialised RevRangeI32 form kept for back-compat; prefer the
    // DoubleEndedIterator `.rev()` trait-default (returns RevIter)
    // for new code.
    pub fn into_rev_range(self: RangeI32) -> RevRangeI32 {
        return RevRangeI32 { current: self.end, start: self.current };
    }

    // Rust's `Range::contains` — half-open interval test. By-value
    // arg rather than `&i32` since Logos's `&T`-on-primitive method
    // dispatch is sparse (CP-cm-01 family).
    pub fn contains(self: RangeI32, item: i32) -> bool {
        return self.current <= item && item < self.end;
    }

    // Rust's `Range::is_empty` — true iff start >= end.
    pub fn is_empty(self: RangeI32) -> bool {
        return self.current >= self.end;
    }

    // Note: `count()` is inherited from the Iterator trait default.
}

// ── RangeI64 — exclusive range [start, end) over i64 ─────────────────────────

pub struct RangeI64 {
    pub current: i64,
    pub end: i64,
}

pub fn range_i64(lo: i64, hi: i64) -> RangeI64 {
    return RangeI64 { current: lo, end: hi };
}

impl Iterator<i64> for RangeI64 {
    fn next(self: &mut RangeI64) -> Option<i64> {
        if self.current >= self.end { return Option::None; }
        let v: i64 = self.current;
        self.current = self.current + 1 as i64;
        return Option::Some(v);
    }
}

impl DoubleEndedIterator<i64> for RangeI64 {
    fn next_back(self: &mut RangeI64) -> Option<i64> {
        if self.current >= self.end { return Option::None; }
        self.end = self.end - 1 as i64;
        return Option::Some(self.end);
    }
}

impl ExactSizeIterator<i64> for RangeI64 {
    fn len(&self) -> i64 {
        if self.current >= self.end { return 0 as i64; }
        return self.end - self.current;
    }
}

// ── RevRangeI64 — reverse iteration over RangeI64 ────────────────────────────

pub struct RevRangeI64 {
    pub current: i64,
    pub start:   i64,
}

impl Iterator<i64> for RevRangeI64 {
    fn next(self: &mut RevRangeI64) -> Option<i64> {
        if self.current <= self.start { return Option::None; }
        self.current = self.current - 1 as i64;
        return Option::Some(self.current);
    }
}

impl RangeI64 {
    pub fn into_rev_range(self: RangeI64) -> RevRangeI64 {
        return RevRangeI64 { current: self.end, start: self.current };
    }

    pub fn contains(self: RangeI64, item: i64) -> bool {
        return self.current <= item && item < self.end;
    }

    pub fn is_empty(self: RangeI64) -> bool {
        return self.current >= self.end;
    }

    // Note: `count()` is inherited from the Iterator trait default.
}

// FusedIterator: ranges yield None forever after exhaustion.
impl FusedIterator<i32> for RangeI32 {}
impl FusedIterator<i32> for RevRangeI32 {}
impl FusedIterator<i64> for RangeI64 {}
impl FusedIterator<i64> for RevRangeI64 {}

// ── Range family — RangeFrom / RangeTo / RangeFull / RangeInclusive ──────────
//
// Mirror Rust's `core::ops::{RangeFrom, RangeTo, RangeFull, RangeInclusive}`.
// Logos doesn't parameterise Range over Idx, so we ship per-{i32,i64}
// variants (same shape pattern as the existing RangeI32 / RangeI64).
//
// `RangeFrom` is infinite — `next()` never returns None. Treat as a
// "use with `.take(n)`" iterator.
// `RangeTo` and `RangeFull` are bound-only carriers (not iterators in
// Rust either) — used as slice-index endpoints. Present here as marker
// structs so port targets parse.
// `RangeInclusive` includes both endpoints; `next()` yields None after
// the end has been emitted (uses an internal `done` flag).

pub struct RangeFromI32 { pub current: i32 }
pub struct RangeFromI64 { pub current: i64 }

pub fn range_from_i32(start: i32) -> RangeFromI32 { return RangeFromI32 { current: start }; }
pub fn range_from_i64(start: i64) -> RangeFromI64 { return RangeFromI64 { current: start }; }

impl Iterator<i32> for RangeFromI32 {
    fn next(self: &mut RangeFromI32) -> Option<i32> {
        let v: i32 = self.current;
        self.current = self.current + 1;
        return Option::Some(v);
    }
}

impl Iterator<i64> for RangeFromI64 {
    fn next(self: &mut RangeFromI64) -> Option<i64> {
        let v: i64 = self.current;
        self.current = self.current + 1i64;
        return Option::Some(v);
    }
}

impl RangeFromI32 {
    pub fn contains(self: RangeFromI32, item: i32) -> bool {
        return self.current <= item;
    }
}

impl RangeFromI64 {
    pub fn contains(self: RangeFromI64, item: i64) -> bool {
        return self.current <= item;
    }
}

// RangeTo<Idx> — exclusive upper-bound carrier. Used as slice index;
// not iterable in Rust either.
pub struct RangeToI32 { pub end: i32 }
pub struct RangeToI64 { pub end: i64 }

pub fn range_to_i32(end: i32) -> RangeToI32 { return RangeToI32 { end: end }; }
pub fn range_to_i64(end: i64) -> RangeToI64 { return RangeToI64 { end: end }; }

impl RangeToI32 {
    pub fn contains(self: RangeToI32, item: i32) -> bool {
        return item < self.end;
    }
}

impl RangeToI64 {
    pub fn contains(self: RangeToI64, item: i64) -> bool {
        return item < self.end;
    }
}

// RangeFull — bound-less marker. Single value carries no state.
pub struct RangeFull {}

pub fn range_full() -> RangeFull { return RangeFull {}; }

// RangeInclusive — [start..=end].
pub struct RangeInclI32 {
    pub current: i32,
    pub end:     i32,
    pub done:    bool,
}

pub struct RangeInclI64 {
    pub current: i64,
    pub end:     i64,
    pub done:    bool,
}

pub fn range_incl_i32(lo: i32, hi: i32) -> RangeInclI32 {
    return RangeInclI32 { current: lo, end: hi, done: lo > hi };
}

pub fn range_incl_i64(lo: i64, hi: i64) -> RangeInclI64 {
    return RangeInclI64 { current: lo, end: hi, done: lo > hi };
}

impl Iterator<i32> for RangeInclI32 {
    fn next(self: &mut RangeInclI32) -> Option<i32> {
        if self.done { return Option::None; }
        let v: i32 = self.current;
        if self.current == self.end {
            self.done = true;
        } else {
            self.current = self.current + 1;
        }
        return Option::Some(v);
    }
}

impl Iterator<i64> for RangeInclI64 {
    fn next(self: &mut RangeInclI64) -> Option<i64> {
        if self.done { return Option::None; }
        let v: i64 = self.current;
        if self.current == self.end {
            self.done = true;
        } else {
            self.current = self.current + 1i64;
        }
        return Option::Some(v);
    }
}

impl RangeInclI32 {
    pub fn contains(self: RangeInclI32, item: i32) -> bool {
        return self.current <= item && item <= self.end;
    }
    pub fn is_empty(self: RangeInclI32) -> bool { return self.done; }
}

impl RangeInclI64 {
    pub fn contains(self: RangeInclI64, item: i64) -> bool {
        return self.current <= item && item <= self.end;
    }
    pub fn is_empty(self: RangeInclI64) -> bool { return self.done; }
}

impl FusedIterator<i32> for RangeFromI32 {}
impl FusedIterator<i64> for RangeFromI64 {}
impl FusedIterator<i32> for RangeInclI32 {}
impl FusedIterator<i64> for RangeInclI64 {}
