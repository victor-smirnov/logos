// logos.lang.hermes2.typed_arr — `&[T] as <T>[]` cast builders (hermes2).
//
// The C6 language feature: a Logos slice casts to a typed dense hermes2 array
// (TypedArray<T>: {size_:u64, capacity_:u64, data_:RelativePtr<T>} tagged with
// the wire code 2101..2110, raw position-independent elements). The result is
// an Rc<Hermes2> whose root is the array object.
//
// Port of mem.hermes.ctr's hermes_build_array_* (Hermes1, retired).

package logos.lang.hermes2.typed_arr;

use logos.lang.hermes2.anyval;       // HAny
use logos.lang.hermes2.allocator;    // Allocator
use logos.lang.hermes2.container;    // Hermes2, hermes2_rc, alloc_tagged, hermes2_alloc_bytes
use logos.mem.rc;                    // Rc

// Core: copy `len` elements of `width` bytes, build the tagged header, set root.
unsafe fn h2_build_typed_array_raw(vals: *const u8, len: i64, width: i64,
                                   tc: u64) -> Rc<Hermes2> {
    let mut n: i64 = len;
    if n < 0 { n = 0; }
    let byte_len: i64 = n * width;
    let rc: Rc<Hermes2> = hermes2_rc(byte_len + 4096);
    let h: &Hermes2 = rc.deref();
    let hp: *mut Hermes2 = h as *const Hermes2 as *mut Hermes2;

    // Element buffer first (its address is stable in the never-move arena).
    let mut buf: *mut u8 = 0 as *mut u8;
    if byte_len > 0 {
        buf = hermes2_alloc_bytes(hp, byte_len);
        let mut i: i64 = 0;
        while i + 8 <= byte_len {
            *(((buf as i64) + i) as *mut u64) = *(((vals as i64) + i) as *const u64);
            i = i + 8;
        }
        while i < byte_len {
            *(((buf as i64) + i) as *mut u8) = *(((vals as i64) + i) as *const u8);
            i = i + 1;
        }
    }

    // Tagged 24-byte TypedArray header {size_, capacity_, data_relptr}.
    let hdr: *mut u8 = alloc_tagged(&mut hp.allocator as *mut Allocator, 24, tc);
    *(hdr as *mut u64) = n as u64;
    *(((hdr as i64) + 8) as *mut u64) = n as u64;
    let dfield: i64 = (hdr as i64) + 16;
    if buf == (0 as *mut u8) { *(dfield as *mut i64) = 0i64; }
    else { *(dfield as *mut i64) = (buf as i64) - dfield; }   // self-relative

    h.set_root(HAny::ref_to(hdr as *const u8));
    return rc;
}

// Per-element-type entry points (sema's `as <T>[]` lowering calls by name).
pub unsafe fn hermes2_build_array_i8(vals: *const i8, len: i64) -> Rc<Hermes2> {
    return h2_build_typed_array_raw(vals as *const u8, len, 1, 2105u64);
}
pub unsafe fn hermes2_build_array_u8(vals: *const u8, len: i64) -> Rc<Hermes2> {
    return h2_build_typed_array_raw(vals, len, 1, 2101u64);
}
pub unsafe fn hermes2_build_array_i16(vals: *const i16, len: i64) -> Rc<Hermes2> {
    return h2_build_typed_array_raw(vals as *const u8, len, 2, 2106u64);
}
pub unsafe fn hermes2_build_array_u16(vals: *const u16, len: i64) -> Rc<Hermes2> {
    return h2_build_typed_array_raw(vals as *const u8, len, 2, 2102u64);
}
pub unsafe fn hermes2_build_array_i32(vals: *const i32, len: i64) -> Rc<Hermes2> {
    return h2_build_typed_array_raw(vals as *const u8, len, 4, 2107u64);
}
pub unsafe fn hermes2_build_array_u32(vals: *const u32, len: i64) -> Rc<Hermes2> {
    return h2_build_typed_array_raw(vals as *const u8, len, 4, 2103u64);
}
pub unsafe fn hermes2_build_array_i64(vals: *const i64, len: i64) -> Rc<Hermes2> {
    return h2_build_typed_array_raw(vals as *const u8, len, 8, 2108u64);
}
pub unsafe fn hermes2_build_array_u64(vals: *const u64, len: i64) -> Rc<Hermes2> {
    return h2_build_typed_array_raw(vals as *const u8, len, 8, 2104u64);
}
pub unsafe fn hermes2_build_array_f32(vals: *const f32, len: i64) -> Rc<Hermes2> {
    return h2_build_typed_array_raw(vals as *const u8, len, 4, 2109u64);
}
pub unsafe fn hermes2_build_array_f64(vals: *const f64, len: i64) -> Rc<Hermes2> {
    return h2_build_typed_array_raw(vals as *const u8, len, 8, 2110u64);
}
