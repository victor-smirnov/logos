// Logos Hermes2 stdlib — hermes2.equal
//
// Structural (deep) equality of two Hermes2 values — the port of hermes.equal.
// Same type_code-dispatched recursive walk as stringify/compactify, but folding
// two trees into a bool. Equality is by VALUE, not identity: two docs in
// different arenas (e.g. an original and its compactified / round-tripped copy)
// compare equal iff they have the same shape and contents.
//
//   • null   == null
//   • bool   == bool   (same value)
//   • int    == int    (same i64; an inline i56 Pod equals a boxed i64 of the
//                       same value — the boxing is an encoding detail)
//   • float  == float  (same f64 bits; int and float are NOT cross-equal)
//   • string == string (same bytes)
//   • array  == array  (same length, elementwise equal, in order)
//   • map    == map    (same size; every key present on both with equal values —
//                       order-independent)

package logos.lang.hermes2.equal;

use logos.lang.hermes2.anyval;
use logos.lang.hermes2.array;
use logos.lang.hermes2.hmap;
use logos.lang.hermes2.hstring;
use logos.lang.str;
use logos.lang.ptr;

pub fn equal(a: HAny, b: HAny) -> bool {
    if a.is_null()  { return b.is_null(); }
    if a.is_bool()  { return b.is_bool()  && a.as_bool() == b.as_bool(); }
    if a.is_float() { return b.is_float() && a.as_f64()  == b.as_f64(); }
    if a.is_int()   { return b.is_int()   && a.as_i64()  == b.as_i64(); }
    if a.is_string() {
        if !b.is_string() { return false; }
        let sa: &HString = unsafe { &*(a.resolve() as *const HString) };
        let sb: &HString = unsafe { &*(b.resolve() as *const HString) };
        return str_eq(sa.as_str(), sb.as_str());
    }
    if a.is_array() {
        if !b.is_array() { return false; }
        let aa: &HArray<HVal> = unsafe { &*(a.resolve() as *const HArray<HVal>) };
        let ab: &HArray<HVal> = unsafe { &*(b.resolve() as *const HArray<HVal>) };
        if aa.len() != ab.len() { return false; }
        let mut i: i64 = 0i64;
        while i < aa.len() {
            if !equal(aa.get(i), ab.get(i)) { return false; }
            i = i + 1i64;
        }
        return true;
    }
    if a.is_map() {
        if !b.is_map() { return false; }
        let ma: &HMap<HString, HVal> = unsafe { &*(a.resolve() as *const HMap<HString, HVal>) };
        let mb: &HMap<HString, HVal> = unsafe { &*(b.resolve() as *const HMap<HString, HVal>) };
        if ma.len() != mb.len() { return false; }
        let mut i: i64 = 0i64;
        while i < ma.slots() {
            let k: HAny = ma.key_at(i);
            if !k.is_null() {
                let ks: str = unsafe { (&*(k.resolve() as *const HString)).as_str() };
                if !mb.contains(ks) { return false; }
                if !equal(ma.val_at(i), mb.get(ks)) { return false; }
            }
            i = i + 1i64;
        }
        return true;   // sizes equal + every ma key matched in mb ⇒ equal
    }
    return false;
}
