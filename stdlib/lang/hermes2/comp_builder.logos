// logos.lang.hermes2.comp_builder — hermes2 runtime builders for @{}/@[]
// comprehensions and capture-@{}.
//
// STEP 5 (cut-over): the compiler lowers Hermes COMPREHENSIONS (`@[e for x in it]`,
// `@{k:v for ...}`) and capture-`@{}` to a RUNTIME Hermes container built via these
// helpers. The legacy path used logos.mem.hermes.ctr (Hermes1 4-byte) so the blob
// the compiler then reads (lower_hermes_blob, hermes2) mismatched -> SIGSEGV. These
// build a hermes2 `Hermes2` container instead, matching the compiler's read.
//
// Mirror of mem.hermes.ctr::hermes_{list,map}_comp_{new,push,put} + hermes_coerce_*,
// AnyVal -> HAny.
//
// ⚠️ BLOCKER (step 5, not yet usable): `Hermes2` owns its `Allocator` BY VALUE and
// is a NON-MOVABLE "stable root" (container.logos:22-25). A comprehension builder
// RETURNS the container, and the move relocates the Allocator — but the never-move
// segments' zone_of() back-link points at the old Allocator address, so the first
// map/array grow (allocator_alloc via zone_of) SIGSEGVs. These fns compile + are the
// right SHAPE, but to be usable the container must be heap-pinned so it survives the
// return move: make `Hermes2.allocator` a `Box<Allocator>` (heap-stable, zone_of
// resolves through it) OR have the comprehension yield `Rc<Hermes2>`/`Box<Hermes2>`
// (the hermes2 ownership design — never-move + Rc holder). That + the compiler
// repoint (lower_hermes_list_comp/map_comp + coerce_to_hermes_anyval -> Hermes2/HAny/
// these fns) is the embedded-Hermes BUILDER port. Verified the move-crash with a
// direct round-trip test.

package logos.lang.hermes2.comp_builder;

use logos.lang.hermes2.anyval;       // HAny
use logos.lang.hermes2.container;    // Hermes2, hermes2_new
use logos.lang.hermes2.array;        // HArray<HVal>, Hermes2.array, HArray.push
use logos.lang.hermes2.hmap;         // HMap<HString,HVal>, Hermes2.map, HMap.set
use logos.lang.hermes2.hstring;      // HString (key type in the map annotation)
use logos.lang.str;

// ── List comprehension: @[expr for x in iter (if guard)?] ──────────────────────
pub fn hermes2_list_comp_new(cap: i64) -> Hermes2 {
    let mut c: Hermes2 = hermes2_new(cap);
    let arr: &HArray<HVal> = c.array(8);       // build array root (&mut -> & at bind)
    let root: HAny = HAny::from(arr);
    c.set_root(root);
    return c;
}

pub fn hermes2_list_comp_push(c: &mut Hermes2, v: HAny) {
    let root: HAny = c.root();
    unsafe {
        let arr: &mut HArray<HVal> = &mut *(root.resolve() as *mut HArray<HVal>);
        arr.push(v);
    }
}

// ── Map comprehension: @{kexpr: vexpr for x in iter (if guard)?} ───────────────
pub fn hermes2_map_comp_new(cap: i64, slot_hint: i64) -> Hermes2 {
    let mut c: Hermes2 = hermes2_new(cap);
    // Round slot_hint up to next power of two (min 8) — open-addressing masking.
    let mut slots: i64 = 8;
    let mut want:  i64 = slot_hint * 2;
    if want < 8 { want = 8; }
    while slots < want { slots = slots * 2; }
    let m: &HMap<HString, HVal> = c.map(slots);
    let root: HAny = HAny::from(m);
    c.set_root(root);
    return c;
}

pub fn hermes2_map_comp_put(c: &mut Hermes2, k: str, v: HAny) {
    let root: HAny = c.root();
    unsafe {
        let m: &mut HMap<HString, HVal> = &mut *(root.resolve() as *mut HMap<HString, HVal>);
        m.set(k, v);
    }
}

// ── Scalar → HAny coercion (compiler auto-wraps the element expr by Logos type) ─
pub fn hermes2_coerce_bool(v: bool) -> HAny { return HAny::from(v); }
pub fn hermes2_coerce_i8(v: i8)   -> HAny { return HAny::from(v); }
pub fn hermes2_coerce_i16(v: i16) -> HAny { return HAny::from(v); }
pub fn hermes2_coerce_i32(v: i32) -> HAny { return HAny::from(v as i56); }
pub fn hermes2_coerce_u8(v: u8)   -> HAny { return HAny::from(v); }
pub fn hermes2_coerce_u16(v: u16) -> HAny { return HAny::from(v); }
pub fn hermes2_coerce_u32(v: u32) -> HAny { return HAny::from(v as i56); }
