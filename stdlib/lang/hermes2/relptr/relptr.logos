// Logos Hermes2 stdlib — hermes2.relptr
//
// RelPtr<T>: thin, SELF-RELATIVE intra-zone reference (Hermes2 model).
//
// Unlike the current Hermes (where a stored reference is a u32 offset from the
// *zone base*, requiring the base to be threaded to every dereference), a
// Hermes2 RelPtr stores the signed byte distance from ITS OWN address to the
// target:
//
//     target = (&relptr) + relptr.delta
//
// The anchor (&relptr) is always at hand at the point of access — you are
// reading the field out of its own storage — so NO base is threaded anywhere.
// Because Hermes2 objects never move in place (growth appends new segments;
// compaction copies to a fresh container, leaving the old one untouched), a
// resolved absolute pointer stays valid for the lifetime of the target's
// container.
//
// `delta == 0` is the null sentinel: a RelPtr pointing at its own address is
// meaningless (the field holds the i64, not a T), so 0 is reserved for null.
//
// `delta` is a 64-bit SIGNED offset: the segment allocator places all segments
// of one container within signed reach (±2^63), which holds with vast margin
// on any real 64-bit address space (user VA ≤ 2^47 / ~2^56). See
// docs/internals/hermes2-design.md §2-3.
//
// T must itself be a Datatype (zoned-storable). Resolution is INTRINSICALLY
// in-place: a RelPtr is only meaningful at its storage location, so resolve
// takes the storage pointer (`self`) and yields an absolute pointer.

package logos.lang.hermes2.relptr;

// Thin self-relative reference — 8 bytes stored in zone.
#[zoned] pub struct RelPtr<T> {
    pub delta: i64,
}

impl<T> RelPtr<T> {
    // Resolve to a const pointer. Anchor = the RelPtr's own address.
    // A null RelPtr (delta == 0) resolves to the null pointer.
    pub unsafe fn resolve(self: *const RelPtr<T>) -> *const T {
        if self.delta == 0 { return 0 as *const T; }
        let anchor: i64 = self as i64;
        return (anchor + self.delta) as *const T;
    }

    // Resolve to a mutable pointer (same anchor arithmetic).
    pub unsafe fn resolve_mut(self: *const RelPtr<T>) -> *mut T {
        if self.delta == 0 { return 0 as *mut T; }
        let anchor: i64 = self as i64;
        return (anchor + self.delta) as *mut T;
    }

    // Store a target into this RelPtr, encoding delta = target - &self.
    // Computed in place: the caller must have `self` at its final storage
    // address (the object is never moved afterwards, so the delta stays valid).
    pub unsafe fn set(self: *mut RelPtr<T>, target: *const T) {
        let anchor: i64 = self as i64;
        let tgt: i64 = target as i64;
        self.delta = tgt - anchor;
    }

    // Reset to null.
    pub unsafe fn clear(self: *mut RelPtr<T>) {
        self.delta = 0;
    }

    // True if this is the null sentinel (delta == 0).
    pub unsafe fn is_null(self: *const RelPtr<T>) -> bool {
        return self.delta == 0;
    }
}

// Null relative-pointer sentinel.
pub unsafe fn relptr_null<T>() -> RelPtr<T> {
    return RelPtr { delta: 0 };
}
