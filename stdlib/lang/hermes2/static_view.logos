// logos.lang.hermes2.static_view — hermes2 read view over a @{}/HermesStatic
// rodata blob.
//
// STEP 5 (cut-over): the compiler now emits @{} / HermesStatic rodata blobs in
// HERMES2 format (8-byte SELF-RELATIVE HAny slots, HMap<HString,HVal> object
// maps, HArray<HVal> arrays, HString strings) — the same layout the parser
// builds. The legacy `logos.lang.hermes.view::HermesView`/`HermesStatic` read
// path decodes the OLD Hermes1 4-byte base-relative format, so it reads garbage
// (SIGILL). This module is the matching hermes2 READER, mirroring the metaprog
// `OView` reader but for runtime blobs with STRING-keyed object maps.
//
// A node handle is a value-form HAny whose resolve() is the node's absolute
// address. The blob root is the DocumentHeader's self-relative AnyVal word at
// base+0; every other step follows Refs via resolve() (position-independent).

package logos.lang.hermes2.static_view;

use logos.lang.hermes2.anyval;     // HAny
use logos.lang.hermes2.hmap;       // HMap<HString, HVal>
use logos.lang.hermes2.array;      // HArray<HVal>
use logos.lang.hermes2.hstring;    // HString
use logos.lang.str;

// Borrowed UTF-8 bytes of a blob string.
pub struct SView2 {
    pub ptr: *const u8,
    pub len: u64,
}

impl Copy for SView2 {}

// Read view over a hermes2 rodata blob. `base` is the first blob byte (the
// DocumentHeader, which holds the root AnyVal at offset 0). For a HermesStatic
// the blob ptr already points past the 8-byte size prefix, so `base = hs.ptr`.
pub struct HView2 {
    pub base: *const u8,
}

impl Copy for HView2 {}

// Build a reader from a rodata blob pointer (HermesStatic.ptr).
pub fn hview2_from_ptr(ptr: *const u8) -> HView2 {
    return HView2 { base: ptr };
}

impl HView2 {
    // The document root HAny. DocumentHeader = { HAny root } at base+0; the
    // at-rest root word is self-relative to base — materialize it.
    pub fn root(self: &HView2) -> HAny {
        let w: i64 = unsafe { *(self.base as *const i64) };
        if w == 0i64 { return HAny::Ref(0i64 as *const u8); }
        if (w & 1i64) == 1i64 { return HAny::Pod(w as u64); }
        return HAny::Ref((self.base as i64 + w) as *const u8);
    }

    // String-keyed ObjectMap field read: `node` (Ref to HMap<HString,HVal>) →
    // key → HAny. Null/non-ref node, or absent key, yields a null HAny.
    pub fn map_get(self: &HView2, node: HAny, key: str) -> HAny {
        if !node.is_ref() { return HAny::Ref(0i64 as *const u8); }
        let p: *const u8 = node.resolve();
        if p == (0 as *const u8) { return HAny::Ref(0i64 as *const u8); }
        return unsafe { (&*(p as *const HMap<HString, HVal>)).get(key) };
    }

    // Inline scalar reads (Pod HAny). Non-pod → 0 / false.
    pub fn get_int(self: &HView2, v: HAny) -> i64 {
        if v.is_pod() { return v.as_i56(); }
        return 0i64;
    }
    pub fn get_i64(self: &HView2, v: HAny) -> i64 { return self.get_int(v); }
    pub fn get_u64(self: &HView2, v: HAny) -> u64 { return self.get_int(v) as u64; }
    pub fn get_bool(self: &HView2, v: HAny) -> bool {
        if v.is_pod() { return v.as_bool(); }
        return false;
    }

    // Borrowed UTF-8 bytes of a string node (Ref to HString). Empty if non-ref.
    pub fn get_str_view(self: &HView2, v: HAny) -> SView2 {
        if !v.is_ref() { return SView2 { ptr: 0 as *const u8, len: 0 as u64 }; }
        let p: *const u8 = v.resolve();
        if p == (0 as *const u8) { return SView2 { ptr: 0 as *const u8, len: 0 as u64 }; }
        let s: str = unsafe { (&*(p as *const HString)).as_str() };
        return SView2 { ptr: s.as_ptr(), len: s.len() as u64 };
    }

    // Array length / element. `v` is a Ref to HArray<HVal>; null/non-ref → 0 / null.
    pub fn array_len(self: &HView2, v: HAny) -> u64 {
        if !v.is_ref() { return 0 as u64; }
        let p: *const u8 = v.resolve();
        if p == (0 as *const u8) { return 0 as u64; }
        return unsafe { (&*(p as *const HArray<HVal>)).len() as u64 };
    }

    pub fn array_get(self: &HView2, v: HAny, idx: u64) -> HAny {
        if !v.is_ref() { return HAny::Ref(0i64 as *const u8); }
        let p: *const u8 = v.resolve();
        if p == (0 as *const u8) { return HAny::Ref(0i64 as *const u8); }
        return unsafe { (&*(p as *const HArray<HVal>)).get(idx as i64) };
    }
}
