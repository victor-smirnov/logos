// Logos Hermes2 stdlib — hermes2.array
//
// HArray<HVal> — a heterogeneous zoned array of HAny. Elements live AT-REST as
// `HAnyRel` slots in a never-move arena buffer; the header is `#[pinned]`
// (in-arena, accessed via `*mut`, never moved). `data` is a self-relative delta
// from the header to the element buffer — header and buffer may sit in DIFFERENT
// never-move segments, and the delta stays valid (nothing moves).
//
// Growth APPENDS a fresh 2× buffer and re-points `data`; the old buffer is left
// untouched (dead until the container drops — design §3, no per-object reclaim).
// The grow-copy is NOT a memcpy: the at-rest slots are self-relative (anchored to
// their slot address), so each is COPIED through the absolute intermediate —
// `ha_materialize` (old slot → absolute value) then `ha_lower` (→ new slot,
// re-anchored). This is the canonical "copy a self-relative ref via absolute".
//
// (Functional core — raw `unsafe` mechanics; the type-safe surface wraps it.)

package logos.lang.hermes2.array;

use logos.lang.hermes2.container;
use logos.lang.hermes2.anyval;
use logos.lang.hermes2.allocator;
use logos.lang.hermes2.hstring;     // HString, hstring_in_alloc — for push(str)
use logos.lang.ptr;

// `#[zone_mut]`: a `&mut HArray<HVal>` is a FAT ref {data, zone} carrying its Hermes
// zone (the allocator) — so grow methods reach the allocator from `&mut self` with
// NO stored field. The zone is no longer in the object; it rides the mutable
// reference (hermes2-design §9.4 / zone-as-parameter). Read `&Array` stays thin.
// `#[zoned2]`: the `data` pointer is stored SELF-RELATIVE (RelOffset i64, anchored
// to its own slot) and materialises to an absolute pointer on read — the untagged
// zoned-reference (ref-repr-design §6). No manual `(a)+delta` arithmetic.
#[zone_mut]
#[pinned]
#[zoned2]
pub struct HArray<T> {
    pub len:   i64,
    pub cap:   i64,
    pub data:  *mut HAnyRel,    // element buffer (auto-relative via #[zoned2])
}

// Ergonomic alias for the heterogeneous array (the only instantiation today):
// write `HValArray` for `HArray<HVal>`.
pub type HValArray = HArray<HVal>;

// Absolute element buffer (header + delta), const-faithful (`as_ptr`/`as_mut_ptr`
// split — a `*const` header yields a `*const` buffer, never laundering const→mut).
unsafe fn array_buf(a: *const HArray<HVal>) -> *const HAnyRel {
    return a.data as *const HAnyRel;   // #[zoned2]: materialises to absolute on read
}
unsafe fn array_buf_mut(a: *mut HArray<HVal>) -> *mut HAnyRel {
    return a.data;
}

// Raw core (internal). Create an empty array header + buffer in `h`'s zone and
// return the raw `*mut`. The zone is NOT stored in the object — the public
// `array()` wraps this in a fat `&mut` that carries it (zone_mut_ref).
unsafe fn array_new(h: *mut Hermes2, cap: i64) -> *mut HArray<HVal> {
    // The header is HAny-Ref'd (nesting / array_of) → tag it for dispatch.
    let hdr: *mut HArray<HVal>    =
        alloc_tagged(&mut h.allocator as *mut Allocator, sizeof::<HArray<HVal>>() as i64, H2_ARRAY) as *mut HArray<HVal>;
    let buf: *mut HAnyRel  = hermes2_alloc_n::<HAnyRel>(h, cap);
    hdr.len   = 0i64;
    hdr.cap   = cap;
    hdr.data  = buf;            // #[zoned2]: lowers to a self-relative offset
    return hdr;
}

unsafe fn array_len(a: *const HArray<HVal>) -> i64 { return a.len; }

// Append `v`. On overflow, allocate a fresh 2× buffer THROUGH THE STORED ALLOCATOR
// and re-point `data`, copying each existing slot through the absolute intermediate
// (re-anchoring).
unsafe fn array_push(a: *mut HArray<HVal>, alloc: *mut Allocator, v: HAny) {
    if a.len >= a.cap {
        let newcap: i64 = if a.cap == 0i64 { 4i64 } else { a.cap * 2i64 };
        let nbuf: *mut HAnyRel =
            allocator_alloc(alloc, newcap * (sizeof::<HAnyRel>() as i64), align_of::<HAnyRel>() as i64) as *mut HAnyRel;
        let obuf: *mut HAnyRel = array_buf_mut(a);
        let mut i: i64 = 0i64;
        while i < a.len {
            // re-anchor: materialise from the OLD slot, lower into the NEW slot.
            let val: HAny = ha_materialize(obuf.add(i) as *const HAnyRel);
            ha_lower(val, nbuf.add(i));
            i = i + 1i64;
        }
        a.data = nbuf;          // #[zoned2]: lowers to a self-relative offset
        a.cap  = newcap;
    }
    let buf: *mut HAnyRel = array_buf_mut(a);
    ha_lower(v, buf.add(a.len));
    a.len = a.len + 1i64;
}

unsafe fn array_get(a: *const HArray<HVal>, i: i64) -> HAny {
    let buf: *const HAnyRel = array_buf(a);
    return ha_materialize(buf.add(i));
}

// ── Direct-reference surface (NO handle/view wrapper) ──────────────────────────
//
// Client code holds a DIRECT reference to an array — `&HArray<HVal>` / `&mut
// HArray<HVal>`. Arrays live in the never-move arena, so the reference is stable for
// the container's lifetime. Allocation is interior-mutability (`array(&self)`,
// bumpalo-style): the `&self` lets MANY references into the container coexist with
// FURTHER allocation — sound precisely because never-move (nothing a reference
// points at ever moves). Used like a `Vec`: `a.push(v)`, `a.get(i)`, `a.len()`.
// Nesting: `parent.push(HAny::from(child))`; read back `c.array_of(ref)`.
// (The residency `holder` for ESCAPING references, and the enforced borrow-tie
// ref ≤ holder + mutation-exclusivity, are the next steps of this model.)
impl Hermes2 {
    // Create an empty array; returns a fresh `&mut` to it. `&self` allocation
    // (interior-mut): the returned `&mut` is to brand-new never-move storage, so
    // multiple `array(&self)` calls coexist (each &mut is a distinct object).
    pub fn array<'a>(self: &'a Hermes2, cap: i64) -> &'a mut HArray<HVal> {
        unsafe {
            let h: *mut Hermes2 = self as *const Hermes2 as *mut Hermes2;
            // Fat `&mut` carrying this container's zone (the allocator) — push/grow
            // recover it via zone_of(self); the object stores no allocator.
            return zone_mut_ref::<HArray<HVal>>(array_new(h, cap), &mut h.allocator as *mut u8);
        }
    }
    // Resolve a Ref element back to the array it points at, tied to THIS container
    // (the returned `&HArray<HVal>` may not outlive the container).
    pub fn array_of<'a>(self: &'a Hermes2, e: HAny) -> &'a HArray<HVal> {
        return unsafe { &*(e.resolve() as *const HArray<HVal>) };
    }
}

impl HArray<HVal> {
    // The zone (allocator) for growth comes from the fat `&mut self` via
    // `zone_of(self)` — not a stored field. `self as *mut HArray<HVal>` is the data
    // half (the object pointer).
    // NOTE on ordering: `zone_of(self)` reborrows self (no move), but
    // `self as *mut HArray<HVal>` (the cast) CONSUMES the fat &mut — so bind the
    // zone FIRST, and let the cast be self's LAST use inside `array_push(...)`.
    pub fn push(self: &mut HArray<HVal>, v: HAny) {
        unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; array_push(self as *mut HArray<HVal>, z, v); }
    }

    // Overloaded push for the common element types — each wraps the value into an
    // HAny so callers write `a.push(x)` instead of `a.push(HAny::from(x))`.
    //   • i64  → inline Pod when it fits i56, else boxed (H2_I64) into the arena
    //   • f64  → boxed (H2_F64) into the arena (never fits the inline Pod)
    //   • bool → an inline Pod
    //   • &HString / &HArray<HVal> → a Ref to an already-interned arena object
    pub fn push(self: &mut HArray<HVal>, v: i64)  { unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; array_push(self as *mut HArray<HVal>, z, make_int(z, v)); } }
    pub fn push(self: &mut HArray<HVal>, v: f64)  { unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; array_push(self as *mut HArray<HVal>, z, box_f64(z, v)); } }
    pub fn push(self: &mut HArray<HVal>, v: bool) { unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; array_push(self as *mut HArray<HVal>, z, HAny::from(v)); } }
    pub fn push(self: &mut HArray<HVal>, v: &HString)      { unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; array_push(self as *mut HArray<HVal>, z, HAny::from(v)); } }
    pub fn push(self: &mut HArray<HVal>, v: &HArray<HVal>)  { unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; array_push(self as *mut HArray<HVal>, z, HAny::from(v)); } }

    // `str` → intern the bytes into THIS array's zone (via zone_of(self)) as an
    // HString, then push a Ref to it. (A `String` caller passes `s.as_str()` —
    // String lives in the `mem` tier, above `lang`.) Lives as long as the container.
    pub fn push(self: &mut HArray<HVal>, v: str) {
        unsafe {
            let z: *mut Allocator = zone_of(self) as *mut Allocator;
            let hs: *mut HString = hstring_in_alloc(z, v);
            array_push(self as *mut HArray<HVal>, z, HAny::ref_to(hs as *const u8));
        }
    }

    pub fn get(self: &HArray<HVal>, i: i64) -> HAny { return unsafe { array_get(self as *const HArray<HVal>, i) }; }
    pub fn len(self: &HArray<HVal>) -> i64 { return unsafe { array_len(self as *const HArray<HVal>) }; }

    // Mutable cursor onto element `i` (a Ref element — a nested container/string):
    // carries THIS array's zone (zone_of(self)) so the child can grow in the same
    // arena. Bind the zone FIRST (no move); `self as *const` (the cast) is the last
    // use. For a Pod element the cursor's obj is meaningless — guard with
    // is_array/is_map/is_string before resolving.
    pub fn get_mut(self: &mut HArray<HVal>, i: i64) -> HAnyMut {
        unsafe {
            let z: *mut u8 = zone_of(self);
            let v: HAny = array_get(self as *const HArray<HVal>, i);
            return HAnyMut { obj: v.resolve() as *mut u8, zone: z };
        }
    }
}

impl HAnyMut {
    // Resolve a mutable cursor to a fat `&mut HArray<HVal>` carrying its zone — ready
    // to push/grow in the same arena. (Check is_array() first.)
    pub fn as_array_mut(self: HAnyMut) -> &mut HArray<HVal> {
        return unsafe { zone_mut_ref::<HArray<HVal>>(self.obj as *mut HArray<HVal>, self.zone) };
    }
}

impl HAny {
    // A nested array as a heterogeneous value (Ref to the child's header).
    pub fn from(a: &HArray<HVal>) -> HAny { return HAny::ref_to(a as *const HArray<HVal> as *const u8); }
}
