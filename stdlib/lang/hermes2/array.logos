// Logos Hermes2 stdlib — hermes2.array
//
// ZArrayAny — a heterogeneous zoned array of ZonedAny. Elements live AT-REST as
// `ZonedAnyRel` slots in a never-move arena buffer; the header is `#[pinned]`
// (in-arena, accessed via `*mut`, never moved). `data` is a self-relative delta
// from the header to the element buffer — header and buffer may sit in DIFFERENT
// never-move segments, and the delta stays valid (nothing moves).
//
// Growth APPENDS a fresh 2× buffer and re-points `data`; the old buffer is left
// untouched (dead until the container drops — design §3, no per-object reclaim).
// The grow-copy is NOT a memcpy: the at-rest slots are self-relative (anchored to
// their slot address), so each is COPIED through the absolute intermediate —
// `za_materialize` (old slot → absolute value) then `za_lower` (→ new slot,
// re-anchored). This is the canonical "copy a self-relative ref via absolute".
//
// (Functional core — raw `unsafe` mechanics; the type-safe surface wraps it.)

package logos.lang.hermes2.array;

use logos.lang.hermes2.container;
use logos.lang.hermes2.anyval;
use logos.lang.hermes2.allocator;
use logos.lang.ptr;

#[pinned]
pub struct ZArrayAny {
    pub len:   i64,
    pub cap:   i64,
    pub data:  i64,             // self-relative: element buffer = (header addr) + data
    pub alloc: *mut Allocator,  // back-ptr to the owning container's allocator (for growth)
}

// Absolute element buffer (header + delta), const-faithful (`as_ptr`/`as_mut_ptr`
// split — a `*const` header yields a `*const` buffer, never laundering const→mut).
unsafe fn za_buf(a: *const ZArrayAny) -> *const ZonedAnyRel {
    return ((a as i64) + a.data) as *const ZonedAnyRel;
}
unsafe fn za_buf_mut(a: *mut ZArrayAny) -> *mut ZonedAnyRel {
    return ((a as i64) + a.data) as *mut ZonedAnyRel;
}

// Raw core (internal). Create an empty array in `h`; the header stores a back-
// pointer to the container's allocator so growth is self-contained (no container
// threaded through every push).
unsafe fn zarray_new(h: *mut Hermes2, cap: i64) -> *mut ZArrayAny {
    let hdr: *mut ZArrayAny    = hermes2_alloc::<ZArrayAny>(h);
    let buf: *mut ZonedAnyRel  = hermes2_alloc_n::<ZonedAnyRel>(h, cap);
    hdr.len   = 0i64;
    hdr.cap   = cap;
    hdr.data  = (buf as i64) - (hdr as i64);
    hdr.alloc = &mut h.allocator as *mut Allocator;
    return hdr;
}

unsafe fn zarray_len(a: *const ZArrayAny) -> i64 { return a.len; }

// Append `v`. On overflow, allocate a fresh 2× buffer THROUGH THE STORED ALLOCATOR
// and re-point `data`, copying each existing slot through the absolute intermediate
// (re-anchoring).
unsafe fn zarray_push(a: *mut ZArrayAny, v: ZonedAny) {
    if a.len >= a.cap {
        let newcap: i64 = if a.cap == 0i64 { 4i64 } else { a.cap * 2i64 };
        let nbuf: *mut ZonedAnyRel =
            allocator_alloc(a.alloc, newcap * (sizeof::<ZonedAnyRel>() as i64)) as *mut ZonedAnyRel;
        let obuf: *mut ZonedAnyRel = za_buf_mut(a);
        let mut i: i64 = 0i64;
        while i < a.len {
            // re-anchor: materialise from the OLD slot, lower into the NEW slot.
            let val: ZonedAny = za_materialize(obuf.add(i) as *const ZonedAnyRel);
            za_lower(val, nbuf.add(i));
            i = i + 1i64;
        }
        a.data = (nbuf as i64) - (a as i64);
        a.cap  = newcap;
    }
    let buf: *mut ZonedAnyRel = za_buf_mut(a);
    za_lower(v, buf.add(a.len));
    a.len = a.len + 1i64;
}

unsafe fn zarray_get(a: *const ZArrayAny, i: i64) -> ZonedAny {
    let buf: *const ZonedAnyRel = za_buf(a);
    return za_materialize(buf.add(i));
}

// ── Object-oriented type-safe surface (no `unsafe`/raw pointer in user code) ────
//
// `ZArray` is a lightweight (Copy) handle to an array living in the container. It
// is created from the container, then used like a `Vec`: `a.push(v)`, `a.get(i)`,
// `a.len()` — the container is NOT threaded through each call (the array grows via
// its own stored allocator back-pointer). Nesting: `parent.push(ZonedAny::from(child))`
// and read back with `ZArray::from(parent.get(i))`.
pub struct ZArray { hdr: *mut ZArrayAny }

impl Hermes2 {
    // Create an empty array (capacity `cap`) in this container.
    pub fn array(self: &mut Hermes2, cap: i64) -> ZArray {
        return ZArray { hdr: unsafe { zarray_new(self as *mut Hermes2, cap) } };
    }
}

impl ZArray {
    pub fn push(self: &mut ZArray, v: ZonedAny) { unsafe { zarray_push(self.hdr, v); } }
    pub fn get(self: &ZArray, i: i64) -> ZonedAny { return unsafe { zarray_get(self.hdr as *const ZArrayAny, i) }; }
    pub fn len(self: &ZArray) -> i64 { return unsafe { zarray_len(self.hdr as *const ZArrayAny) }; }
    // Reconstruct a handle from a Ref element (a nested array read back).
    pub fn from(e: ZonedAny) -> ZArray { return ZArray { hdr: e.resolve() as *mut ZArrayAny }; }
}

impl ZonedAny {
    // A nested array as a heterogeneous value (Ref to the child's header).
    pub fn from(a: ZArray) -> ZonedAny { return ZonedAny::ref_to(a.hdr as *const u8); }
}
