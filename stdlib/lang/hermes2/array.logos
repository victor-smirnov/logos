// Logos Hermes2 stdlib — hermes2.array
//
// Array<HAny> — a heterogeneous zoned array of HAny. Elements live AT-REST as
// `HAnyRel` slots in a never-move arena buffer; the header is `#[pinned]`
// (in-arena, accessed via `*mut`, never moved). `data` is a self-relative delta
// from the header to the element buffer — header and buffer may sit in DIFFERENT
// never-move segments, and the delta stays valid (nothing moves).
//
// Growth APPENDS a fresh 2× buffer and re-points `data`; the old buffer is left
// untouched (dead until the container drops — design §3, no per-object reclaim).
// The grow-copy is NOT a memcpy: the at-rest slots are self-relative (anchored to
// their slot address), so each is COPIED through the absolute intermediate —
// `ha_materialize` (old slot → absolute value) then `ha_lower` (→ new slot,
// re-anchored). This is the canonical "copy a self-relative ref via absolute".
//
// (Functional core — raw `unsafe` mechanics; the type-safe surface wraps it.)

package logos.lang.hermes2.array;

use logos.lang.hermes2.container;
use logos.lang.hermes2.anyval;
use logos.lang.hermes2.allocator;
use logos.lang.hermes2.hstring;     // HString, hstring_in_alloc — for push(str)
use logos.lang.ptr;

#[pinned]
pub struct Array<T> {
    pub len:   i64,
    pub cap:   i64,
    pub data:  i64,             // self-relative: element buffer = (header addr) + data
    pub alloc: *mut Allocator,  // back-ptr to the owning container's allocator (for growth)
}

// Absolute element buffer (header + delta), const-faithful (`as_ptr`/`as_mut_ptr`
// split — a `*const` header yields a `*const` buffer, never laundering const→mut).
unsafe fn array_buf(a: *const Array<HAny>) -> *const HAnyRel {
    return ((a as i64) + a.data) as *const HAnyRel;
}
unsafe fn array_buf_mut(a: *mut Array<HAny>) -> *mut HAnyRel {
    return ((a as i64) + a.data) as *mut HAnyRel;
}

// Raw core (internal). Create an empty array in `h`; the header stores a back-
// pointer to the container's allocator so growth is self-contained (no container
// threaded through every push).
unsafe fn array_new(h: *mut Hermes2, cap: i64) -> *mut Array<HAny> {
    let hdr: *mut Array<HAny>    = hermes2_alloc::<Array<HAny>>(h);
    let buf: *mut HAnyRel  = hermes2_alloc_n::<HAnyRel>(h, cap);
    hdr.len   = 0i64;
    hdr.cap   = cap;
    hdr.data  = (buf as i64) - (hdr as i64);
    hdr.alloc = &mut h.allocator as *mut Allocator;
    return hdr;
}

unsafe fn array_len(a: *const Array<HAny>) -> i64 { return a.len; }

// Append `v`. On overflow, allocate a fresh 2× buffer THROUGH THE STORED ALLOCATOR
// and re-point `data`, copying each existing slot through the absolute intermediate
// (re-anchoring).
unsafe fn array_push(a: *mut Array<HAny>, v: HAny) {
    if a.len >= a.cap {
        let newcap: i64 = if a.cap == 0i64 { 4i64 } else { a.cap * 2i64 };
        let nbuf: *mut HAnyRel =
            allocator_alloc(a.alloc, newcap * (sizeof::<HAnyRel>() as i64)) as *mut HAnyRel;
        let obuf: *mut HAnyRel = array_buf_mut(a);
        let mut i: i64 = 0i64;
        while i < a.len {
            // re-anchor: materialise from the OLD slot, lower into the NEW slot.
            let val: HAny = ha_materialize(obuf.add(i) as *const HAnyRel);
            ha_lower(val, nbuf.add(i));
            i = i + 1i64;
        }
        a.data = (nbuf as i64) - (a as i64);
        a.cap  = newcap;
    }
    let buf: *mut HAnyRel = array_buf_mut(a);
    ha_lower(v, buf.add(a.len));
    a.len = a.len + 1i64;
}

unsafe fn array_get(a: *const Array<HAny>, i: i64) -> HAny {
    let buf: *const HAnyRel = array_buf(a);
    return ha_materialize(buf.add(i));
}

// ── Direct-reference surface (NO handle/view wrapper) ──────────────────────────
//
// Client code holds a DIRECT reference to an array — `&Array<HAny>` / `&mut
// Array<HAny>`. Arrays live in the never-move arena, so the reference is stable for
// the container's lifetime. Allocation is interior-mutability (`array(&self)`,
// bumpalo-style): the `&self` lets MANY references into the container coexist with
// FURTHER allocation — sound precisely because never-move (nothing a reference
// points at ever moves). Used like a `Vec`: `a.push(v)`, `a.get(i)`, `a.len()`.
// Nesting: `parent.push(HAny::from(child))`; read back `c.array_of(ref)`.
// (The residency `holder` for ESCAPING references, and the enforced borrow-tie
// ref ≤ holder + mutation-exclusivity, are the next steps of this model.)
impl Hermes2 {
    // Create an empty array; returns a fresh `&mut` to it. `&self` allocation
    // (interior-mut): the returned `&mut` is to brand-new never-move storage, so
    // multiple `array(&self)` calls coexist (each &mut is a distinct object).
    pub fn array<'a>(self: &'a Hermes2, cap: i64) -> &'a mut Array<HAny> {
        unsafe {
            let h: *mut Hermes2 = self as *const Hermes2 as *mut Hermes2;
            return &mut *array_new(h, cap);
        }
    }
    // Resolve a Ref element back to the array it points at, tied to THIS container
    // (the returned `&Array<HAny>` may not outlive the container).
    pub fn array_of<'a>(self: &'a Hermes2, e: HAny) -> &'a Array<HAny> {
        return unsafe { &*(e.resolve() as *const Array<HAny>) };
    }
}

impl Array<HAny> {
    pub fn push(self: &mut Array<HAny>, v: HAny) { unsafe { array_push(self as *mut Array<HAny>, v); } }

    // Overloaded push for the common element types — each wraps the value into an
    // HAny so callers write `a.push(x)` instead of `a.push(HAny::from(x))`.
    //   • i64  → an inline Pod (i56 range; the heterogeneous slot is 56-bit)
    //   • bool → an inline Pod
    //   • &HString / &Array<HAny> → a Ref to an already-interned arena object
    pub fn push(self: &mut Array<HAny>, v: i64)  { unsafe { array_push(self as *mut Array<HAny>, HAny::pod(v, HA_I56)); } }
    pub fn push(self: &mut Array<HAny>, v: bool) { unsafe { array_push(self as *mut Array<HAny>, HAny::from(v)); } }
    pub fn push(self: &mut Array<HAny>, v: &HString)      { unsafe { array_push(self as *mut Array<HAny>, HAny::from(v)); } }
    pub fn push(self: &mut Array<HAny>, v: &Array<HAny>)  { unsafe { array_push(self as *mut Array<HAny>, HAny::from(v)); } }

    // `str` → intern the bytes into THIS array's arena (via the stored allocator)
    // as an HString, then push a Ref to it. (A `String` caller passes `s.as_str()`
    // — String lives in the `mem` tier, above `lang`, so it can't be an overload
    // here.) The interned string lives as long as the container.
    pub fn push(self: &mut Array<HAny>, v: str) {
        unsafe {
            let a: *mut Array<HAny> = self as *mut Array<HAny>;
            let hs: *mut HString = hstring_in_alloc(a.alloc, v);
            array_push(a, HAny::ref_to(hs as *const u8));
        }
    }

    pub fn get(self: &Array<HAny>, i: i64) -> HAny { return unsafe { array_get(self as *const Array<HAny>, i) }; }
    pub fn len(self: &Array<HAny>) -> i64 { return unsafe { array_len(self as *const Array<HAny>) }; }
}

impl HAny {
    // A nested array as a heterogeneous value (Ref to the child's header).
    pub fn from(a: &Array<HAny>) -> HAny { return HAny::ref_to(a as *const Array<HAny> as *const u8); }
}
