// Logos Hermes2 stdlib — hermes2.tarray
//
// HArr<T> — a typed, HOMOGENEOUS packed array of a primitive `T` (the Hermes2 port
// of Hermes1's typed `Array<T>`, wire codes ArrayU8=2101 .. ArrayF64=2110). Unlike
// hermes2.array's HArray<HVal> (heterogeneous HAny elements), the elements here are
// plain primitive values: no Refs, no per-element zoning, and growth is a plain
// element copy (not the self-relative re-anchor HArray<HVal> needs). `data` is the
// element buffer — #[zoned2] self-relative as a POINTER, plain `T` as elements, so
// `*(buf.add(i))` is an ordinary load/store.

package logos.lang.hermes2.tarray;

use logos.lang.hermes2.container;   // Hermes2, hermes2_alloc_n, alloc_tagged
use logos.lang.hermes2.allocator;   // Allocator, allocator_alloc
use logos.lang.ptr;

// The per-element Hermes wire tag (HermesTag ArrayU8=2101 .. ArrayF64=2110) so a
// typed array carries the precise element-type code (type_code() emits it; hbs-ready).
pub trait HArrTag { fn arr_code() -> u64; }
impl HArrTag for u8  { fn arr_code() -> u64 { return 2101u64; } }
impl HArrTag for u16 { fn arr_code() -> u64 { return 2102u64; } }
impl HArrTag for u32 { fn arr_code() -> u64 { return 2103u64; } }
impl HArrTag for u64 { fn arr_code() -> u64 { return 2104u64; } }
impl HArrTag for i8  { fn arr_code() -> u64 { return 2105u64; } }
impl HArrTag for i16 { fn arr_code() -> u64 { return 2106u64; } }
impl HArrTag for i32 { fn arr_code() -> u64 { return 2107u64; } }
impl HArrTag for i64 { fn arr_code() -> u64 { return 2108u64; } }
impl HArrTag for f32 { fn arr_code() -> u64 { return 2109u64; } }
impl HArrTag for f64 { fn arr_code() -> u64 { return 2110u64; } }

// `#[zone_mut]`: a `&mut HArr<T>` is a FAT ref {data, zone} carrying its allocator,
// so push/grow reach it via zone_of(self). `#[pinned]`: in-arena header. `#[zoned2]`:
// the `data` pointer is stored self-relative (the elements are plain T).
#[zone_mut]
#[pinned]
#[zoned2]
pub struct HArr<T> {
    pub len:  i64,
    pub cap:  i64,
    pub data: *mut T,   // packed T[] (auto-relative ptr; plain elements)
}

unsafe fn harr_new<T: HArrTag>(h: *mut Hermes2, cap: i64) -> *mut HArr<T> {
    let hdr: *mut HArr<T> =
        alloc_tagged(&mut h.allocator as *mut Allocator, sizeof::<HArr<T>>() as i64, T::arr_code()) as *mut HArr<T>;
    let buf: *mut T = hermes2_alloc_n::<T>(h, cap);
    hdr.len  = 0i64;
    hdr.cap  = cap;
    hdr.data = buf;            // #[zoned2]: lowers to a self-relative offset
    return hdr;
}

// Append `v`; on overflow allocate a fresh 2× buffer and PLAIN-copy the elements
// (primitives are position-independent — no re-anchor, unlike HArray<HVal>).
unsafe fn harr_push<T: HArrTag>(a: *mut HArr<T>, alloc: *mut Allocator, v: T) {
    if a.len >= a.cap {
        let newcap: i64 = if a.cap == 0i64 { 8i64 } else { a.cap * 2i64 };
        let nbuf: *mut T = allocator_alloc(alloc, newcap * (sizeof::<T>() as i64), align_of::<T>() as i64) as *mut T;
        let obuf: *mut T = a.data;
        let mut i: i64 = 0i64;
        while i < a.len { *(nbuf.add(i)) = *(obuf.add(i)); i = i + 1i64; }
        a.data = nbuf;
        a.cap  = newcap;
    }
    let buf: *mut T = a.data;
    *(buf.add(a.len)) = v;
    a.len = a.len + 1i64;
}

impl<T: HArrTag> HArr<T> {
    pub fn len(self: &HArr<T>) -> i64 { return self.len; }
    pub fn get(self: &HArr<T>, i: i64) -> T { return unsafe { *(self.data.add(i)) }; }
    // Bind the zone FIRST (zone_of reborrows); `self as *mut HArr<T>` (the cast)
    // consumes the fat &mut, so it must be self's LAST use.
    pub fn push(self: &mut HArr<T>, v: T) {
        unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; harr_push::<T>(self as *mut HArr<T>, z, v); }
    }
}

impl Hermes2 {
    // Create an empty typed array; returns a fresh fat `&mut` carrying this
    // container's zone (interior-mut `&self` allocation, like `array`).
    pub fn tarray<'a, T: HArrTag>(self: &'a Hermes2, cap: i64) -> &'a mut HArr<T> {
        unsafe {
            let h: *mut Hermes2 = self as *const Hermes2 as *mut Hermes2;
            return zone_mut_ref::<HArr<T>>(harr_new::<T>(h, cap), &mut h.allocator as *mut u8);
        }
    }
}
