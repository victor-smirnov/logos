// Logos Hermes2 stdlib — hermes2.tintmap
//
// HIntMap<K> — a dense, FIXED-capacity map of a scalar integer key K (i32/u32/i64/
// u64) to HAny values (the Hermes2 port of Hermes1's `Map<K, AnyVal>`, wire codes
// MapI32AnyVal=3101 .. MapU64AnyVal=3104). Two parallel buffers — a plain `K[]` of
// keys and a `*zoned HAny[]` of values — with linear lookup/update (O(n); the map
// is small). Capacity is fixed (set drops on full), so set never allocates.

package logos.lang.hermes2.tintmap;

use logos.lang.hermes2.container;   // Hermes2, hermes2_alloc_n, alloc_tagged
use logos.lang.hermes2.anyval;      // HAny, HVal
use logos.lang.hermes2.allocator;   // Allocator
use logos.lang.ptr;

// Per-key Hermes wire tag (MapI32AnyVal=3101 .. MapU64AnyVal=3104).
pub trait HIntKeyTag { fn map_code() -> u64; }
impl HIntKeyTag for i32 { fn map_code() -> u64 { return 3101u64; } }
impl HIntKeyTag for u32 { fn map_code() -> u64 { return 3102u64; } }
impl HIntKeyTag for i64 { fn map_code() -> u64 { return 3103u64; } }
impl HIntKeyTag for u64 { fn map_code() -> u64 { return 3104u64; } }

// `#[pinned]`: in-arena header. `#[zoned2]`: both buffer pointers are self-relative.
// Keys are PLAIN K (no zoning); values are AT-REST HAny reached via `*zoned`
// (`*(vals.add(i))` materialises / `= v` lowers). Fixed capacity → thin `&mut`, no
// `#[zone_mut]` (set never grows).
#[pinned]
#[zoned2]
pub struct HIntMap<K> {
    pub size: i64,
    pub cap:  i64,
    pub keys: *mut K,            // K[] (plain elements; auto-relative ptr)
    pub vals: *zoned mut HAny,   // HAny[] (at-rest; auto-relative ptr)
}

unsafe fn him_new<K: HIntKeyTag>(h: *mut Hermes2, cap: i64) -> *mut HIntMap<K> {
    let hdr: *mut HIntMap<K> =
        alloc_tagged(&mut h.allocator as *mut Allocator, sizeof::<HIntMap<K>>() as i64, K::map_code()) as *mut HIntMap<K>;
    let kbuf: *mut K          = hermes2_alloc_n::<K>(h, cap);
    let vbuf: *zoned mut HAny = hermes2_alloc_n::<HAny>(h, cap) as *zoned mut HAny;
    hdr.size = 0i64;
    hdr.cap  = cap;
    hdr.keys = kbuf;            // #[zoned2]: lower to self-relative offsets
    hdr.vals = vbuf;
    return hdr;
}

impl<K: HIntKeyTag> HIntMap<K> {
    pub fn size(self: &HIntMap<K>) -> i64 { return self.size; }
    pub fn cap(self: &HIntMap<K>)  -> i64 { return self.cap; }

    pub fn contains(self: &HIntMap<K>, key: K) -> bool {
        unsafe {
            let mut i: i64 = 0i64;
            while i < self.size {
                if *(self.keys.add(i)) == key { return true; }
                i = i + 1i64;
            }
            return false;
        }
    }

    // Value at `key`, or null HAny if absent.
    pub fn get(self: &HIntMap<K>, key: K) -> HAny {
        unsafe {
            let mut i: i64 = 0i64;
            while i < self.size {
                if *(self.keys.add(i)) == key { return *(self.vals.add(i)); }
                i = i + 1i64;
            }
            return HAny::ref_to(0i64 as *const u8);
        }
    }

    // Insert or update `key → val`. A full map (new key) is a no-op.
    pub fn set(self: &mut HIntMap<K>, key: K, val: HAny) {
        unsafe {
            let mut i: i64 = 0i64;
            while i < self.size {
                if *(self.keys.add(i)) == key { *(self.vals.add(i)) = val; return; }
                i = i + 1i64;
            }
            if self.size >= self.cap { return; }   // full — no growth
            let n: i64 = self.size;
            *(self.keys.add(n)) = key;
            *(self.vals.add(n)) = val;
            self.size = n + 1i64;
        }
    }
}

impl Hermes2 {
    // Create an empty int-keyed map; returns a fresh thin `&mut` (fixed capacity, so
    // set never allocates → no carried zone).
    pub fn intmap<'a, K: HIntKeyTag>(self: &'a Hermes2, cap: i64) -> &'a mut HIntMap<K> {
        unsafe {
            let h: *mut Hermes2 = self as *const Hermes2 as *mut Hermes2;
            return &mut *him_new::<K>(h, cap);
        }
    }
}
