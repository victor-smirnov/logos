// logos.lang.hermes2.pat — hermes2 runtime helpers for @{...} / @[...] match
// patterns. The hermes2 port of mem.hermes.pat.
//
// To keep build_hermes_pat_guard's call shape IDENTICAL (it passes `&node` + a
// `base` ptr), every helper takes `(node: *const HAny, ...)`
// and IGNORES base — hermes2 HAny is self-relative (value-form), so the node
// word alone resolves (no base needed). Only the helper NAMES (hermes_pat_* ->
// hermes2_pat_*) + the node type (AnyVal -> HAny) + the root entry change in the
// compiler. Slot lookups return the child HAny (null on miss / wrong type).

package logos.lang.hermes2.pat;

use logos.lang.hermes2.anyval;       // HAny, h2_type_code
use logos.lang.hermes2.array;        // HArray<HVal>
use logos.lang.hermes2.hmap;         // HMap<HString, HVal>
use logos.lang.hermes2.hstring;      // HString
use logos.lang.hermes2.static_view;  // HView2 / hview2_from_ptr
use logos.lang.hermes2.container;    // Hermes2 (runtime scrutinee)
use logos.lang.hermes2.hstatic;     // HermesStatic (the scrutinee handle)
use logos.mem.rc;                    // Rc — runtime container scrutinee
use logos.lang.str;                  // str, str_eq

fn null_hany() -> HAny { return HAny::Ref(0i64 as *const u8); }

// Root HAny of a HermesStatic @-literal scrutinee (the matcher's entry point).
// Inlined root read (the DocumentHeader's self-relative word at ptr+0) so the
// returned HAny borrows the &param's blob, not a local HView2 (borrow-checker).
pub fn hermes2_pat_root(view: &HermesStatic) -> HAny {
    let base: *const u8 = view.ptr;
    let w: i64 = unsafe { *(base as *const i64) };
    if w == 0i64 { return HAny::Ref(0i64 as *const u8); }
    if (w & 1i64) == 1i64 { return HAny::Pod(w as u64); }
    return HAny::Ref((base as i64 + w) as *const u8);
}

// Root HAny of a RUNTIME Rc<Hermes2> scrutinee (capture/comprehension results).
pub fn hermes2_pat_root_rc(c: &Rc<Hermes2>) -> HAny {
    let h: &Hermes2 = c.deref();
    return h.root();
}

// ── Scalar leaves ─────────────────────
pub unsafe fn hermes2_pat_is_null(node: *const HAny) -> bool {
    return (*node).is_null();
}
pub unsafe fn hermes2_pat_eq_bool(node: *const HAny, b: bool) -> bool {
    let n: HAny = *node;
    return n.is_bool() && n.as_bool() == b;
}
pub unsafe fn hermes2_pat_eq_i24(node: *const HAny, v: i32) -> bool {
    let n: HAny = *node;
    return n.is_int() && n.as_i64() == (v as i64);
}
pub unsafe fn hermes2_pat_eq_str(node: *const HAny, s: str) -> bool {
    let n: HAny = *node;
    if !n.is_string() { return false; }
    let hs: &HString = &*(n.resolve() as *const HString);
    return str_eq(hs.as_str(), s);
}

// Present = the looked-up slot is a real value (not the null/absent sentinel).
pub unsafe fn hermes2_pat_is_present(node: *const HAny) -> bool {
    return !(*node).is_null();
}

// ── Containers ──────────────────────────────────────────────
pub unsafe fn hermes2_pat_is_map(node: *const HAny) -> bool {
    return (*node).is_map();
}
pub unsafe fn hermes2_pat_map_slot(node: *const HAny, key: str) -> HAny {
    let n: HAny = *node;
    if !n.is_map() { return null_hany(); }
    return (&*(n.resolve() as *const HMap<HString, HVal>)).get(key);
}
pub unsafe fn hermes2_pat_array_slot(node: *const HAny, idx: u64) -> HAny {
    let n: HAny = *node;
    if !n.is_array() { return null_hany(); }
    return (&*(n.resolve() as *const HArray<HVal>)).get(idx as i64);
}
pub unsafe fn hermes2_pat_array_len_eq(node: *const HAny, n: u64) -> bool {
    let v: HAny = *node;
    if !v.is_array() { return false; }
    return ((&*(v.resolve() as *const HArray<HVal>)).len() as u64) == n;
}
pub unsafe fn hermes2_pat_array_len_ge(node: *const HAny, n: u64) -> bool {
    let v: HAny = *node;
    if !v.is_array() { return false; }
    return ((&*(v.resolve() as *const HArray<HVal>)).len() as u64) >= n;
}
pub unsafe fn hermes2_pat_has_type_code(node: *const HAny, tc: u64) -> bool {
    let n: HAny = *node;
    if !n.is_ref() { return false; }
    return (h2_type_code(n.resolve())) == tc;
}
