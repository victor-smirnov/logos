// Logos Hermes2 stdlib — hermes2.anyval
//
// ZonedAny — the Hermes2 heterogeneous slot (the AnyVal analog). An 8-byte tagged
// word that is either an inline primitive (Pod) or a reference to a type-tagged
// zone object (Ref). It comes in TWO forms with bit-identical layout, differing
// only in how the Ref half is encoded — the storage/compute split (see
// docs/internals/hermes2-minimal-container-plan.md D1):
//
//   ZonedAny    — the VALUE form. Ref = an ABSOLUTE pointer to the tagged object.
//                 A plain movable struct (moves by memcpy, like String's ptr);
//                 lives on the stack / in registers / by-value. Dispatch resolves
//                 it through Hermes2TagSystem.
//   ZonedAnyRel — the AT-REST form stored in an arena slot. Ref = a SELF-RELATIVE
//                 delta `target − &slot` (anchor = the slot's own address).
//                 `#[pinned]` → NON-MOVABLE: it is location-anchored, accessed in
//                 place via `*mut`, and materialised explicitly to a ZonedAny.
//
// Encoding (both forms, little-endian i64 `raw`):
//   raw == 0           → null reference
//   raw & 1 == 1       → Pod: bits[7:1] = 7-bit type code, bits[63:8] = 56-bit value
//   raw & 1 == 0 (≠0)  → Ref: ZonedAny = absolute ptr; ZonedAnyRel = self-relative
//                        delta. Zone objects are ≥2-aligned, so a Ref's low bit is
//                        always 0 — it never collides with the Pod tag.
//
// Bridge: za_materialize (slot → value, Ref: &slot+delta) / za_lower (value → slot,
// Ref: target−&slot); identity for Pod and null. `Array<ZonedAny>` get/put use
// these. (Later: make these niche-packed `enum { Ref | Pod }` — more canonical.)

package logos.lang.hermes2.anyval;

use logos.lang.ptr;

pub struct ZonedAny { pub raw: i64 }                 // VALUE form — movable

#[pinned]
pub struct ZonedAnyRel { pub raw: i64 }              // AT-REST form — non-movable

impl ZonedAny {
    // ── constructors (value form) ─────────────────────────────────────────────
    pub fn null() -> ZonedAny { return ZonedAny { raw: 0i64 }; }

    // Inline primitive: `code` is the 7-bit Hermes2 type code (1..127); `v` must
    // fit in 56 signed bits (wider primitives box into a Ref — later).
    pub fn pod(v: i64, code: u8) -> ZonedAny {
        return ZonedAny { raw: (v << 8) | (((code as i64) & 0x7Fi64) << 1) | 1i64 };
    }
    pub fn pod_bool(b: bool, code: u8) -> ZonedAny {
        return ZonedAny::pod(if b { 1i64 } else { 0i64 }, code);
    }
    // Reference to a tagged zone object — stored ABSOLUTE in the value form.
    pub fn ref_to(obj: *const u8) -> ZonedAny { return ZonedAny { raw: obj as i64 }; }

    // ── accessors ─────────────────────────────────────────────────────────────
    pub unsafe fn is_null(self: *const ZonedAny) -> bool { return self.raw == 0i64; }
    pub unsafe fn is_pod(self: *const ZonedAny)  -> bool { return (self.raw & 1i64) == 1i64; }
    pub unsafe fn is_ref(self: *const ZonedAny)  -> bool {
        return (self.raw & 1i64) == 0i64 && self.raw != 0i64;
    }
    pub unsafe fn pod_code(self: *const ZonedAny) -> u8 { return ((self.raw >> 1) & 0x7Fi64) as u8; }
    pub unsafe fn as_i56(self: *const ZonedAny)  -> i64 { return self.raw >> 8; }   // sign-extends
    pub unsafe fn as_bool(self: *const ZonedAny) -> bool { return (self.raw >> 8) != 0i64; }
    // Resolve a Ref to the absolute tagged-object pointer (value form holds it raw).
    pub unsafe fn resolve(self: *const ZonedAny) -> *const u8 { return self.raw as *const u8; }
}

// Hermes2 ZonedAny Pod primitive type codes (7-bit; identify the inline value).
pub const ZA_I64:  u8 = 1u8;
pub const ZA_BOOL: u8 = 2u8;

// Typed, code-managed constructors + accessors (no manual type code at call sites;
// overloaded `from` per primitive — `ZonedAny::from(v)`).
impl ZonedAny {
    pub fn from(v: i64)  -> ZonedAny { return ZonedAny::pod(v, ZA_I64); }
    pub fn from(b: bool) -> ZonedAny { return ZonedAny::pod_bool(b, ZA_BOOL); }

    pub unsafe fn is_i64(self: *const ZonedAny)  -> bool { return self.is_pod() && self.pod_code() == ZA_I64; }
    pub unsafe fn is_bool(self: *const ZonedAny) -> bool { return self.is_pod() && self.pod_code() == ZA_BOOL; }
    pub unsafe fn as_i64(self: *const ZonedAny)  -> i64  { return self.as_i56(); }
}

// ── bridge: at-rest (slot) ↔ value ─────────────────────────────────────────────
// Materialise a slot's at-rest form into a movable value. Ref: abs = &slot + delta.
pub unsafe fn za_materialize(slot: *const ZonedAnyRel) -> ZonedAny {
    let r: i64 = slot.raw;
    if r == 0i64 { return ZonedAny { raw: 0i64 }; }        // null
    if (r & 1i64) == 1i64 { return ZonedAny { raw: r }; }  // Pod — position-independent
    return ZonedAny { raw: (slot as i64) + r };            // Ref — &slot + delta
}

// Lower a movable value into a slot's at-rest form. Ref: delta = target − &slot.
pub unsafe fn za_lower(v: ZonedAny, dst: *mut ZonedAnyRel) {
    let r: i64 = v.raw;
    if r == 0i64 { dst.raw = 0i64; return; }               // null
    if (r & 1i64) == 1i64 { dst.raw = r; return; }         // Pod
    dst.raw = r - (dst as i64);                            // Ref — target − &slot
}
