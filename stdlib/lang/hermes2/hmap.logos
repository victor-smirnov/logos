// Logos Hermes2 stdlib — hermes2.objectmap
//
// HMap<HString, HVal> — a string-keyed hash map (the JSON "object") over the never-move
// arena, the Hermes2 port of hermes.objectmap. Open-addressing with linear
// probing + FNV-1a (logos.lang.hash); keys are interned HStrings, values HAny.
//
// Unlike Hermes1's fixed-capacity zone map (which dropped inserts when full),
// this GROWS like a Rust HashMap: at load factor > 0.75 it appends a fresh 2×
// entry buffer through the stored allocator and REHASHES every live entry into
// it (re-anchoring each self-relative slot through its absolute value, exactly
// like HArray<HVal>'s grow). The old buffer is left dead until the container
// drops (design §3 — no per-object reclaim).
//
// Layout mirrors HArray<HVal>: a `#[pinned]` header in the arena + a self-relative
// `data` delta to the HMapEntry buffer (header and buffer may live in different
// never-move segments; the delta stays valid). Empty slot = key.raw == 0 (the
// buffer is zero-initialised; a real Ref's at-rest delta is never 0).

package logos.lang.hermes2.hmap;

use logos.lang.hermes2.container;   // Hermes2, hermes2_alloc / _n
use logos.lang.hermes2.allocator;   // Allocator, allocator_alloc
use logos.lang.hermes2.anyval;      // HAny (niche enum), HAnyMut, HA_I56 — at-rest via *zoned
use logos.lang.hermes2.hstring;     // HString, hstring_in_alloc
use logos.lang.hermes2.array;       // HArray<HVal> + HAny::from(&Array) — for nested values
use logos.lang.hash;                // fnv1a_bytes
use logos.lang.str;                 // str, str_eq
use logos.lang.ptr;                 // byte_add

#[pinned]
pub struct HMapEntry {
    // Two AT-REST HAny words (key @0, val @8). Held as raw `i64` and accessed
    // through `*zoned mut HAny` slot pointers (ent_key/ent_val), so each read
    // materialises and each write lowers — no HAnyRel, no ha_*. key==0 = empty.
    pub key: i64,   // Ref to the interned HString key; ==0 = empty slot
    pub val: i64,   // the stored HAny value
}

// HMap<K, V> — empty base; per-key-shape partial SPECIALISATIONS attach layout +
// impl (mirrors Hermes1 Map<K,V>). Never instantiated directly.
#[zoned2]
pub struct HMap<K, V> {}

// ── Open-addressing spec: string keys (HMap<HString, V>) ──────────────────────
// `#[zone_mut]`: a `&mut` is a FAT ref {data, zone} carrying its Hermes zone (the
// allocator) — grow/intern reach it via zone_of(self); read `&` stays thin.
// `#[zoned2]`: `data` is stored SELF-RELATIVE and materialises to the absolute
// entry buffer on read (ref-repr-design §6). No manual delta.
#[zone_mut]
#[pinned]
#[zoned2]
pub struct HMap<HString, V> {
    pub count: i64,             // occupied slots
    pub cap:   i64,             // number of slots (power of 2)
    pub data:  *mut HMapEntry,  // entry buffer (auto-relative via #[zoned2])
}

// Ergonomic alias for the heterogeneous string-keyed map (the only instantiation
// today): write `HValMap` for `HMap<HString, HVal>`.
pub type HValMap = HMap<HString, HVal>;

// Absolute entry buffer (header + delta).
// #[zoned2]: `m.data` materialises to the absolute entry buffer on read.
unsafe fn om_buf(m: *const HMap<HString, HVal>) -> *const HMapEntry { return m.data as *const HMapEntry; }
unsafe fn om_buf_mut(m: *mut HMap<HString, HVal>) -> *mut HMapEntry { return m.data; }

// Field-slot pointers within an entry (key @0, val @8) as `*zoned mut HAny` — each
// read materialises the at-rest word, each write lowers it (no distinct HAnyRel).
unsafe fn ent_key(ep: *mut HMapEntry) -> *zoned mut HAny { return ep as *zoned mut HAny; }
unsafe fn ent_val(ep: *mut HMapEntry) -> *zoned mut HAny { return (ep as *mut u8).byte_add(8i64) as *zoned mut HAny; }
unsafe fn ent_key_raw(ep: *const HMapEntry) -> i64 { return *(ep as *const i64); }   // key.raw, no copy

unsafe fn om_zero(buf: *mut HMapEntry, cap: i64) {
    let total: i64 = cap * (sizeof::<HMapEntry>() as i64);
    let mut i: i64 = 0i64;
    while i < total { let p: *mut u8 = (buf as *mut u8).byte_add(i); *p = 0u8; i = i + 1i64; }
}

// Round up to a power of two (min 8) — open addressing needs a pow2 capacity for
// the `hash & (cap-1)` slot index.
fn round_pow2(n: i64) -> i64 {
    let mut c: i64 = 8i64;
    while c < n { c = c * 2i64; }
    return c;
}

unsafe fn om_new(h: *mut Hermes2, cap: i64) -> *mut HMap<HString, HVal> {
    // The header is HAny-Ref'd (HAny::from(&HMap<HString, HVal>)) → tag it for dispatch.
    let hdr: *mut HMap<HString, HVal> =
        alloc_tagged(&mut h.allocator as *mut Allocator, sizeof::<HMap<HString, HVal>>() as i64, H2_MAP) as *mut HMap<HString, HVal>;
    let buf: *mut HMapEntry  = hermes2_alloc_n::<HMapEntry>(h, cap);
    hdr.count = 0i64;
    hdr.cap   = cap;
    hdr.data  = buf;            // #[zoned2]: lowers to self-relative offset
    om_zero(buf, cap);
    return hdr;
}

// The byte view of an interned HString key (for hashing / comparison).
unsafe fn key_str(stored: HAny) -> str { return (&*(stored.resolve() as *const HString)).as_str(); }

// Grow to 2× capacity, rehashing every live entry into the fresh buffer (no key
// compare — all existing keys are distinct).
unsafe fn om_grow(m: *mut HMap<HString, HVal>, alloc: *mut Allocator) {
    let oldcap: i64 = m.cap;
    let newcap: i64 = if oldcap == 0i64 { 8i64 } else { oldcap * 2i64 };
    let nbuf: *mut HMapEntry =
        allocator_alloc(alloc, newcap * (sizeof::<HMapEntry>() as i64), align_of::<HMapEntry>() as i64) as *mut HMapEntry;
    om_zero(nbuf, newcap);
    let obuf: *mut HMapEntry = om_buf_mut(m);
    let ncap_u: u64 = newcap as u64;
    let mut i: i64 = 0i64;
    while i < oldcap {
        let oep: *mut HMapEntry = obuf.add(i);
        if ent_key_raw(oep as *const HMapEntry) != 0i64 {
            let key: HAny = *(ent_key(oep));
            let val: HAny = *(ent_val(oep));
            let s: str = key_str(key);
            let hh: u64 = fnv1a_bytes(s.as_ptr(), s.len() as u64);
            let mut slot: u64 = hh & (ncap_u - 1u64);
            loop {
                let nep: *mut HMapEntry = nbuf.add(slot as i64);
                if ent_key_raw(nep as *const HMapEntry) == 0i64 {
                    *(ent_key(nep)) = key;
                    *(ent_val(nep)) = val;
                    break;
                }
                slot = (slot + 1u64) & (ncap_u - 1u64);
            }
        }
        i = i + 1i64;
    }
    m.data = nbuf;          // #[zoned2]: lowers to self-relative offset
    m.cap  = newcap;
}

// Insert or update. On a NEW key the str is interned into THIS map's arena.
unsafe fn om_set(m: *mut HMap<HString, HVal>, alloc: *mut Allocator, key: str, val: HAny) {
    if (m.count + 1i64) * 4i64 > m.cap * 3i64 { om_grow(m, alloc); }   // load > 0.75
    let cap_u: u64 = m.cap as u64;
    let hh: u64 = fnv1a_bytes(key.as_ptr(), key.len() as u64);
    let buf: *mut HMapEntry = om_buf_mut(m);
    let mut slot: u64 = hh & (cap_u - 1u64);
    loop {
        let ep: *mut HMapEntry = buf.add(slot as i64);
        if ent_key_raw(ep as *const HMapEntry) == 0i64 {
            let ks: *mut HString = hstring_in_alloc(alloc, key);
            *(ent_key(ep)) = HAny::ref_to(ks as *const u8);
            *(ent_val(ep)) = val;
            m.count = m.count + 1i64;
            return;
        }
        let stored: HAny = *(ent_key(ep));
        if str_eq(key_str(stored), key) {
            *(ent_val(ep)) = val;   // update existing
            return;
        }
        slot = (slot + 1u64) & (cap_u - 1u64);
    }
}

unsafe fn om_get(m: *const HMap<HString, HVal>, key: str) -> HAny {
    let cap_u: u64 = m.cap as u64;
    let hh: u64 = fnv1a_bytes(key.as_ptr(), key.len() as u64);
    let buf: *const HMapEntry = om_buf(m);
    let mut slot: u64 = hh & (cap_u - 1u64);
    let mut probed: u64 = 0u64;
    while probed < cap_u {
        let ep: *const HMapEntry = buf.add(slot as i64);
        if ent_key_raw(ep) == 0i64 { return HAny::ref_to(0i64 as *const u8); }
        let stored: HAny = *(ent_key(ep as *mut HMapEntry));
        if str_eq(key_str(stored), key) {
            return *(ent_val(ep as *mut HMapEntry));
        }
        slot = (slot + 1u64) & (cap_u - 1u64);
        probed = probed + 1u64;
    }
    return HAny::ref_to(0i64 as *const u8);
}

// Find the value SLOT for `key` (for `get_mut`) — the `*zoned mut HAny` to read /
// replace / descend in place. Returns a null pointer if the key is absent (the
// cursor is then invalid; callers ensure the key exists, mirroring `get_mut`).
unsafe fn om_get_slot(m: *mut HMap<HString, HVal>, key: str) -> *zoned mut HAny {
    let cap_u: u64 = m.cap as u64;
    let hh: u64 = fnv1a_bytes(key.as_ptr(), key.len() as u64);
    let buf: *mut HMapEntry = om_buf_mut(m);
    let mut slot: u64 = hh & (cap_u - 1u64);
    let mut probed: u64 = 0u64;
    while probed < cap_u {
        let ep: *mut HMapEntry = buf.add(slot as i64);
        if ent_key_raw(ep as *const HMapEntry) == 0i64 { return 0i64 as *zoned mut HAny; }
        let stored: HAny = *(ent_key(ep));
        if str_eq(key_str(stored), key) {
            return ent_val(ep);
        }
        slot = (slot + 1u64) & (cap_u - 1u64);
        probed = probed + 1u64;
    }
    return 0i64 as *zoned mut HAny;
}

// ── Direct-reference surface (like HArray<HVal>) ────────────────────────────────
impl Hermes2 {
    // Create an empty string-keyed map with at least `cap` slots (rounded to a
    // power of two, min 8). `&self` interior-mut allocation into never-move storage.
    pub fn map<'a>(self: &'a Hermes2, cap: i64) -> &'a mut HMap<HString, HVal> {
        unsafe {
            let h: *mut Hermes2 = self as *const Hermes2 as *mut Hermes2;
            // Fat `&mut` carrying this container's zone (the allocator); set/grow/
            // intern recover it via zone_of(self).
            return zone_mut_ref::<HMap<HString, HVal>>(om_new(h, round_pow2(cap)), &mut h.allocator as *mut u8);
        }
    }
}

impl HMap<HString, HVal> {
    // The zone (allocator) for grow/intern comes from the fat `&mut self` via
    // zone_of(self) — bind it FIRST (no move), then `self as *mut HMap<HString, HVal>` (the cast
    // consumes the fat ref) is self's last use in the om_set call.
    pub fn set(self: &mut HMap<HString, HVal>, key: str, val: HAny) {
        unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; om_set(self as *mut HMap<HString, HVal>, z, key, val); }
    }
    pub fn get(self: &HMap<HString, HVal>, key: str) -> HAny { return unsafe { om_get(self as *const HMap<HString, HVal>, key) }; }
    pub fn contains(self: &HMap<HString, HVal>, key: str) -> bool { return !self.get(key).is_null(); }
    pub fn len(self: &HMap<HString, HVal>) -> i64 { return self.count; }

    // Mutable cursor onto the value at `key` (a Ref value — nested container/string):
    // carries THIS map's zone (zone_of(self)) so the child can grow in the same arena.
    // Bind the zone FIRST (no move); `self as *const` is self's last use.
    pub fn get_mut(self: &mut HMap<HString, HVal>, key: str) -> HAnyMut {
        unsafe {
            let z: *mut u8 = zone_of(self);
            let slot: *zoned mut HAny = om_get_slot(self as *mut HMap<HString, HVal>, key);
            return HAnyMut { slot: slot, zone: z };
        }
    }

    // Slot iteration (for generic walkers — stringify/binary). Walk 0..slots();
    // a slot is occupied iff its key is non-null. The key is a Ref to the interned
    // HString; the value is the stored HAny.
    pub fn slots(self: &HMap<HString, HVal>) -> i64 { return self.cap; }
    pub fn key_at(self: &HMap<HString, HVal>, i: i64) -> HAny {
        unsafe {
            let ep: *const HMapEntry = om_buf(self as *const HMap<HString, HVal>).add(i);
            if ent_key_raw(ep) == 0i64 { return HAny::ref_to(0i64 as *const u8); }
            return *(ent_key(ep as *mut HMapEntry));
        }
    }
    pub fn val_at(self: &HMap<HString, HVal>, i: i64) -> HAny {
        unsafe {
            let ep: *const HMapEntry = om_buf(self as *const HMap<HString, HVal>).add(i);
            if ent_key_raw(ep) == 0i64 { return HAny::ref_to(0i64 as *const u8); }
            return *(ent_val(ep as *mut HMapEntry));
        }
    }

    // Overloaded set for the common value types (no manual HAny::from), mirroring
    // HArray<HVal>::push. A `str` VALUE is interned into the same arena as a Ref.
    pub fn set(self: &mut HMap<HString, HVal>, key: str, v: i64)  { unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; self.set(key, make_int(z, v)); } }
    pub fn set(self: &mut HMap<HString, HVal>, key: str, v: f64)  { unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; self.set(key, box_f64(z, v)); } }
    pub fn set(self: &mut HMap<HString, HVal>, key: str, v: bool) { self.set(key, HAny::from(v)); }
    pub fn set(self: &mut HMap<HString, HVal>, key: str, v: &HString) { self.set(key, HAny::from(v)); }
    pub fn set(self: &mut HMap<HString, HVal>, key: str, v: &HArray<HVal>) { self.set(key, HAny::from(v)); }
    pub fn set(self: &mut HMap<HString, HVal>, key: str, v: &HMap<HString, HVal>) { self.set(key, HAny::from(v)); }
    pub fn set(self: &mut HMap<HString, HVal>, key: str, v: str) {
        unsafe {
            let z: *mut Allocator = zone_of(self) as *mut Allocator;
            let hs: *mut HString = hstring_in_alloc(z, v);
            self.set(key, HAny::ref_to(hs as *const u8));
        }
    }
}

impl HAnyMut {
    // Resolve a mutable cursor to a fat `&mut HMap<HString, HVal>` carrying its zone — ready to
    // set/grow in the same arena. (Check is_map() first.)
    pub fn as_map_mut(self: HAnyMut) -> &mut HMap<HString, HVal> {
        return unsafe { zone_mut_ref::<HMap<HString, HVal>>(self.get().resolve() as *mut HMap<HString, HVal>, self.zone) };
    }
}

impl HAny {
    // A map as a heterogeneous value — a Ref to its header.
    pub fn from(m: &HMap<HString, HVal>) -> HAny { return HAny::ref_to(m as *const HMap<HString, HVal> as *const u8); }
}

// ── Bitmap-indexed spec: 6-bit keys (HMap<Hu6, V>) — Hermes1 TinyObjectMap ─────
//
// A compact, FIXED-capacity map of up to 52 small u8 keys (0..51) → HAny. O(1)
// lookup: a key's value-array position is popcount(bitmap & keys-below); the value
// array is kept in key order (insert shifts right). `set` never allocates (fixed
// cap), so it's a thin `&mut`. `data` is the value buffer (`*zoned mut HAny`: each
// `*(buf.add(i))` is a self-relative element access — at-rest ↔ value, like HArray).

// Hu6 — a pure type-level label for the 6-bit key (keys 0..51): the bitmap-indexed
// map is `HMap<Hu6, HVal>`, aliased HTinyValMap.
#[zoned2] pub struct Hu6 {}

#[pinned]
#[zoned2]
pub struct HMap<Hu6, V> {
    pub header: u64,               // bitmap[0:51] | cap[52:57] | size[58:63]
    pub data:   *zoned mut HAny,   // value array (cap slots; auto-relative)
}

// The bitmap-indexed tiny map (Hermes1 TinyObjectMap); was the standalone HTinyValMap.
pub type HTinyValMap = HMap<Hu6, HVal>;

const HTV_BITMAP_MASK: u64 = 0x000FFFFFFFFFFFFFu64;   // bits[0:51] presence bitmap

unsafe fn htv_new(h: *mut Hermes2, cap: i64) -> *mut HMap<Hu6, HVal> {
    let c: i64 = if cap > 52i64 { 52i64 } else { if cap < 0i64 { 0i64 } else { cap } };
    let hdr: *mut HMap<Hu6, HVal> =
        alloc_tagged(&mut h.allocator as *mut Allocator, sizeof::<HMap<Hu6, HVal>>() as i64, H2_TINYMAP) as *mut HMap<Hu6, HVal>;
    let buf: *zoned mut HAny = hermes2_alloc_n::<HAny>(h, c) as *zoned mut HAny;
    hdr.header = (c as u64) << 52u64;   // cap bits; bitmap = 0, size = 0
    hdr.data   = buf;                   // #[zoned2]: lowers to a self-relative offset
    let mut i: i64 = 0i64;
    while i < c { *(buf.add(i)) = HAny::ref_to(0i64 as *const u8); i = i + 1i64; }
    return hdr;
}

impl HMap<Hu6, HVal> {
    pub fn size(self: &HMap<Hu6, HVal>) -> i64 { return ((self.header >> 58u64) & 0x3Fu64) as i64; }
    pub fn cap(self: &HMap<Hu6, HVal>)  -> i64 { return ((self.header >> 52u64) & 0x3Fu64) as i64; }

    // Is `key` present?
    pub fn contains(self: &HMap<Hu6, HVal>, key: u8) -> bool {
        return (self.header & HTV_BITMAP_MASK & (1u64 << (key as u64))) != 0u64;
    }

    // Value at `key`, or null HAny if absent / key out of range.
    pub fn get(self: &HMap<Hu6, HVal>, key: u8) -> HAny {
        if key >= 52u8 { return HAny::ref_to(0i64 as *const u8); }
        let bitmap: u64 = self.header & HTV_BITMAP_MASK;
        let kb: u64 = 1u64 << (key as u64);
        if (bitmap & kb) == 0u64 { return HAny::ref_to(0i64 as *const u8); }
        let pos: i64 = popcount_u64(bitmap & (kb - 1u64)) as i64;
        return unsafe { *(self.data.add(pos)) };
    }

    // Insert or update `key → val`. `key >= 52` or a full map (new key) is a no-op.
    pub fn set(self: &mut HMap<Hu6, HVal>, key: u8, val: HAny) {
        if key >= 52u8 { return; }
        unsafe {
            let bitmap: u64 = self.header & HTV_BITMAP_MASK;
            let kb: u64  = 1u64 << (key as u64);
            let pos: i64 = popcount_u64(bitmap & (kb - 1u64)) as i64;
            let size: i64 = ((self.header >> 58u64) & 0x3Fu64) as i64;
            let cap: i64  = ((self.header >> 52u64) & 0x3Fu64) as i64;
            let buf: *zoned mut HAny = self.data;
            if (bitmap & kb) == 0u64 {
                if size >= cap { return; }
                let mut i: i64 = size;
                while i > pos { *(buf.add(i)) = *(buf.add(i - 1i64)); i = i - 1i64; }
                let cap_bits:  u64 = (cap as u64) << 52u64;
                let size_bits: u64 = ((size + 1i64) as u64) << 58u64;
                self.header = (bitmap | kb) | cap_bits | size_bits;
            }
            *(buf.add(pos)) = val;
        }
    }
}

impl Hermes2 {
    // Create an empty bitmap-indexed tiny map; thin `&mut` (fixed capacity → no zone).
    pub fn tinymap<'a>(self: &'a Hermes2, cap: i64) -> &'a mut HMap<Hu6, HVal> {
        unsafe {
            let h: *mut Hermes2 = self as *const Hermes2 as *mut Hermes2;
            return &mut *htv_new(h, cap);
        }
    }
}

impl HAny {
    pub fn from(m: &HMap<Hu6, HVal>) -> HAny { return HAny::ref_to(m as *const HMap<Hu6, HVal> as *const u8); }
}

// ── Dense spec: scalar integer keys (HMap<K, HVal>) — Hermes1 Map<K, AnyVal> ───
//
// A dense, FIXED-capacity map of a scalar int key K (i32/u32/i64/u64) → HAny (wire
// codes MapI32AnyVal=3101 .. MapU64AnyVal=3104). Two parallel buffers — plain `K[]`
// keys + `*zoned HAny[]` values — with O(n) linear lookup (the map is small). Fixed
// capacity → `set` never allocates → thin `&mut` (no #[zone_mut]).
//
// This spec's first arg is a TYPE-VAR (K), so it overlaps the first-arg specs
// (HMap<HString,V>, HMap<Hu6,V>) on e.g. HMap<HString,HVal>; struct-layout
// selection picks the more-specific first-arg spec by specificity. The METHODS sit
// behind the `K: HIntKeyTag` bound, which HString/Hu6 don't satisfy — so they never
// collide with the string/bitmap inherent methods.

// Per-key Hermes wire tag (MapI32AnyVal=3101 .. MapU64AnyVal=3104).
pub trait HIntKeyTag { fn map_code() -> u64; }
impl HIntKeyTag for i32 { fn map_code() -> u64 { return 3101u64; } }
impl HIntKeyTag for u32 { fn map_code() -> u64 { return 3102u64; } }
impl HIntKeyTag for i64 { fn map_code() -> u64 { return 3103u64; } }
impl HIntKeyTag for u64 { fn map_code() -> u64 { return 3104u64; } }

#[pinned]
#[zoned2]
pub struct HMap<K, HVal> {
    pub size: i64,
    pub cap:  i64,
    pub keys: *mut K,            // K[] (plain elements; auto-relative ptr)
    pub vals: *zoned mut HAny,   // HAny[] (at-rest; auto-relative ptr)
}

// The dense int-keyed map (Hermes1 Map<K,AnyVal>); was the standalone HIntMap<K>.
pub type HIntMap<K> = HMap<K, HVal>;

unsafe fn him_new<K: HIntKeyTag>(h: *mut Hermes2, cap: i64) -> *mut HMap<K, HVal> {
    let hdr: *mut HMap<K, HVal> =
        alloc_tagged(&mut h.allocator as *mut Allocator, sizeof::<HMap<K, HVal>>() as i64, K::map_code()) as *mut HMap<K, HVal>;
    let kbuf: *mut K          = hermes2_alloc_n::<K>(h, cap);
    let vbuf: *zoned mut HAny = hermes2_alloc_n::<HAny>(h, cap) as *zoned mut HAny;
    hdr.size = 0i64;
    hdr.cap  = cap;
    hdr.keys = kbuf;            // #[zoned2]: lower to self-relative offsets
    hdr.vals = vbuf;
    return hdr;
}

impl<K: HIntKeyTag> HMap<K, HVal> {
    pub fn size(self: &HMap<K, HVal>) -> i64 { return self.size; }
    pub fn cap(self: &HMap<K, HVal>)  -> i64 { return self.cap; }

    pub fn contains(self: &HMap<K, HVal>, key: K) -> bool {
        unsafe {
            let mut i: i64 = 0i64;
            while i < self.size {
                if *(self.keys.add(i)) == key { return true; }
                i = i + 1i64;
            }
            return false;
        }
    }

    // Value at `key`, or null HAny if absent.
    pub fn get(self: &HMap<K, HVal>, key: K) -> HAny {
        unsafe {
            let mut i: i64 = 0i64;
            while i < self.size {
                if *(self.keys.add(i)) == key { return *(self.vals.add(i)); }
                i = i + 1i64;
            }
            return HAny::ref_to(0i64 as *const u8);
        }
    }

    // Insert or update `key → val`. A full map (new key) is a no-op.
    pub fn set(self: &mut HMap<K, HVal>, key: K, val: HAny) {
        unsafe {
            let mut i: i64 = 0i64;
            while i < self.size {
                if *(self.keys.add(i)) == key { *(self.vals.add(i)) = val; return; }
                i = i + 1i64;
            }
            if self.size >= self.cap { return; }   // full — no growth
            let n: i64 = self.size;
            *(self.keys.add(n)) = key;
            *(self.vals.add(n)) = val;
            self.size = n + 1i64;
        }
    }
}

impl Hermes2 {
    // Create an empty int-keyed map; thin `&mut` (fixed capacity → no carried zone).
    pub fn intmap<'a, K: HIntKeyTag>(self: &'a Hermes2, cap: i64) -> &'a mut HMap<K, HVal> {
        unsafe {
            let h: *mut Hermes2 = self as *const Hermes2 as *mut Hermes2;
            return &mut *him_new::<K>(h, cap);
        }
    }
}
