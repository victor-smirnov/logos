// Logos Hermes stdlib — hermes2.decimal
//
// HDecimal — a fixed-precision signed decimal (the Hermes port of Hermes1's
// Decimal, wire code 102). The value is `(neg ? -1 : 1) * coeff / 10^scale`, with a
// u64 coefficient magnitude. `spec` packs the Hermes1 layout: scale in bits[0:11]
// (0..4095), sign in bit[31]. Fixed size (no inline tail), so it's a plain tagged
// arena object — no zoning.
//
// [Arbitrary-precision (multi-limb u32 coefficient) Decimals are a custom-DST
//  follow-up — they need the inline variable-length tail that custom-DST provides;
//  deferred. The u64-coefficient form here covers the common case.]

package logos.lang.hermes.decimal;

use logos.lang.hermes.container;   // Hermes, alloc_tagged, H2_DECIMAL
use logos.lang.hermes.anyval;      // HAny, h2_type_code
use logos.lang.hermes.allocator;   // Allocator

#[pinned]
pub struct HDecimal {
    pub spec:  u32,   // scale (bits[0:11]) | sign (bit[31])
    pub coeff: u64,   // coefficient magnitude (value_abs)
}

const DEC_SCALE_MASK: u32 = 0xFFFu32;        // bits[0:11] — scale 0..4095
const DEC_SIGN_BIT:   u32 = 0x80000000u32;   // bit[31] — 1 = negative

unsafe fn decimal_new(h: *mut Hermes, coeff: u64, scale: u32, neg: bool) -> *mut HDecimal {
    let obj: *mut HDecimal =
        alloc_tagged(&mut h.allocator as *mut Allocator, sizeof::<HDecimal>() as i64, H2_DECIMAL) as *mut HDecimal;
    let mut spec: u32 = scale & DEC_SCALE_MASK;
    if neg { spec = spec | DEC_SIGN_BIT; }
    obj.spec  = spec;
    obj.coeff = coeff;
    return obj;
}

impl HDecimal {
    pub fn scale(self: &HDecimal)  -> u32  { return self.spec & DEC_SCALE_MASK; }
    pub fn is_neg(self: &HDecimal) -> bool { return (self.spec & DEC_SIGN_BIT) != 0u32; }
    pub fn coeff(self: &HDecimal)  -> u64  { return self.coeff; }
    // Approximate value as f64 (coeff / 10^scale, signed). Exact decimal arithmetic
    // stays on the integer coeff+scale; this is the convenience float view.
    pub fn to_f64(self: &HDecimal) -> f64 {
        let mut d: f64 = self.coeff as f64;
        let mut s: u32 = self.scale();
        while s > 0u32 { d = d / 10.0f64; s = s - 1u32; }
        if self.is_neg() { return 0.0f64 - d; }
        return d;
    }
}

impl Hermes {
    // Build a decimal in THIS arena; returns a Ref HAny to it.
    pub fn decimal(self: &Hermes, coeff: u64, scale: u32, neg: bool) -> HAny {
        if scale > 4095u32 { return HAny::ref_to(0i64 as *const u8); }   // spec field ceiling
        unsafe {
            let h: *mut Hermes = self as *const Hermes as *mut Hermes;
            return HAny::ref_to(decimal_new(h, coeff, scale, neg) as *const u8);
        }
    }
}

impl HAny {
    pub fn is_decimal(self: &HAny) -> bool {
        return self.is_ref() && unsafe { h2_type_code(self.resolve()) } == H2_DECIMAL;
    }
    // Borrow the pointed-at decimal (check is_decimal first).
    pub fn as_decimal(self: &HAny) -> &HDecimal { return unsafe { &*(self.resolve() as *const HDecimal) }; }
    // A decimal as a heterogeneous value (Ref to it).
    pub fn from(d: &HDecimal) -> HAny { return HAny::ref_to(d as *const HDecimal as *const u8); }
}

// ── parse / arithmetic / compare (the dec_* surface) ──────────────────────────

// Parse "[-]digits[.digits]" into a zone decimal. Null HAny on: empty digits,
// >19 significant digits (u64 overflow guard), a second point, junk bytes,
// scale > 4095.
pub unsafe fn hdec_from_str(h: &Hermes, s: str) -> HAny {
    let n: i64 = s.len();
    let p: *const u8 = s.as_ptr();
    let mut i: i64 = 0;
    let mut neg: bool = false;
    if i < n && *((p as i64 + i) as *const u8) == 45u8 { neg = true; i = i + 1; }
    let mut coeff: u64 = 0u64;
    let mut digits: i64 = 0;
    let mut scale: i64 = 0 - 1;          // -1 = no point seen yet
    while i < n {
        let c: u8 = *((p as i64 + i) as *const u8);
        if c == 46u8 {
            if scale >= 0i64 { return HAny::ref_to(0i64 as *const u8); }
            scale = 0;
            i = i + 1;
            continue;
        }
        if c < 48u8 || c > 57u8 { return HAny::ref_to(0i64 as *const u8); }
        if digits >= 19 { return HAny::ref_to(0i64 as *const u8); }
        coeff = coeff * 10u64 + ((c - 48u8) as u64);
        digits = digits + 1;
        if scale >= 0i64 { scale = scale + 1; }
        i = i + 1;
    }
    if digits == 0 { return HAny::ref_to(0i64 as *const u8); }
    if scale < 0i64 { scale = 0; }
    if scale > 4095 { return HAny::ref_to(0i64 as *const u8); }
    return h.decimal(coeff, scale as u32, neg);
}

// Value compare ignoring representation (1.50 == 1.5): -1 / 0 / 1.
pub unsafe fn hdec_cmp(x: HAny, y: HAny) -> i32 {
    let a: &HDecimal = x.as_decimal();
    let b: &HDecimal = y.as_decimal();
    let az: bool = a.coeff() == 0u64;
    let bz: bool = b.coeff() == 0u64;
    if az && bz { return 0; }
    if (a.is_neg() && !az) != (b.is_neg() && !bz) {
        return if a.is_neg() && !az { -1 } else { 1 };
    }
    let mut ca: u64 = a.coeff(); let mut cb: u64 = b.coeff();
    let mut sa: u32 = a.scale(); let mut sb: u32 = b.scale();
    while sa < sb { ca = ca * 10u64; sa = sa + 1u32; }
    while sb < sa { cb = cb * 10u64; sb = sb + 1u32; }
    let mut r: i32 = 0;
    if ca < cb { r = -1; } else if ca > cb { r = 1; }
    if a.is_neg() && !az { r = 0 - r; }
    return r;
}

// add with scale alignment + sign handling; null HAny on u64 overflow.
pub unsafe fn hdec_add(h: &Hermes, x: HAny, y: HAny) -> HAny {
    let dx: &HDecimal = x.as_decimal();
    let dy: &HDecimal = y.as_decimal();
    let mut cx: u64 = dx.coeff(); let mut cy: u64 = dy.coeff();
    let mut sx: u32 = dx.scale(); let mut sy: u32 = dy.scale();
    while sx < sy {
        if cx > 1844674407370955161u64 { return HAny::ref_to(0i64 as *const u8); }
        cx = cx * 10u64; sx = sx + 1u32;
    }
    while sy < sx {
        if cy > 1844674407370955161u64 { return HAny::ref_to(0i64 as *const u8); }
        cy = cy * 10u64; sy = sy + 1u32;
    }
    let nx: bool = dx.is_neg() && cx != 0u64;
    let ny: bool = dy.is_neg() && cy != 0u64;
    if nx == ny {
        if cx > 18446744073709551615u64 - cy { return HAny::ref_to(0i64 as *const u8); }
        return h.decimal(cx + cy, sx, nx);
    }
    if cx >= cy { return h.decimal(cx - cy, sx, nx); }
    return h.decimal(cy - cx, sx, ny);
}
