// logos.lang.hermes.dview — DView: a non-owning, type-erased Hermes value view.
//
// DView is the Rust-`&dyn` of Hermes: it borrows a concrete value's bytes and
// carries its Hermes type tag, so the value can take part in tag-dispatch
// (compare / equality / stringify / hash …) WITHOUT owning or allocating. It
// does NOT extend lifetimes — when you need to own a runtime-typed value, use
// the Hermes container (`HAny` + arena). "Ord" is just one of DView's
// capabilities, hence the neutral name.
//
// Unification with HAny: the per-type BEHAVIOUR (the machinery) lives in a
// single tag-keyed capability layer (`htag_*` below) — the same type_code-
// dispatch idiom as `equal()`. DView and HAny are two ADAPTERS over that layer:
// each maps its own memory layout to `(tag, object-bytes)` and calls in. DView's
// layout (tag/obj in fields) makes its adapters trivial; HAny's adapter (future)
// normalises niche/Ref/addr-1 — its only friction is a Pod value's inline bits
// having no address (spill to a scratch before calling the layer).

package logos.lang.hermes.dview;

use logos.lang.cmp;                 // Ordering
use logos.lang.option;
use logos.lang.hermes.anyval;      // H2_U64 / H2_I64 / HA_BOOL type codes

// ── HermesTag — concrete type → its Hermes tag (the type-erasure source) ─────
// `h_tag` uses the phantom-`self` form (a `*const Self` never read) — the
// established side-step for the assoc-fn-on-type-param mono gap (cf. fabric
// ContainerOrd::cmp_views). `h_meta` reports packed per-value metadata.
pub trait HermesTag {
    fn h_tag(self: *const Self) -> u64;
    fn h_meta(&self) -> u64 { return 0u64; }
}
impl HermesTag for i64  { fn h_tag(self: *const i64)  -> u64 { return H2_I64; } }
impl HermesTag for u64  { fn h_tag(self: *const u64)  -> u64 { return H2_U64; } }
impl HermesTag for bool { fn h_tag(self: *const bool) -> u64 { return HA_BOOL as u64; } }

// ── DView — the borrowed, type-erased view ──────────────────────────────────
// `tag` and `len` are u64 — the native Hermes widths (type codes are u64).
pub struct DView {
    obj:  *const u8,     // → object bytes (borrowed; not owned)
    len:  u64,           // object byte length
    tag:  u64,           // Hermes type tag
    meta: u64,           // packed per-value metadata (e.g. Decimal {P,S}); 0 if none
}

impl DView {
    // Type-erase a concrete value into a non-owning view (borrows `v`). T is
    // inferred from the argument (`DView::from(&v)`).
    pub static fn from<T: HermesTag>(v: &T) -> DView {
        let phantom: *const T = 0 as *const T;
        return DView {
            obj:  v as *const T as *const u8,
            len:  sizeof::<T>() as u64,
            tag:  unsafe { phantom.h_tag() },
            meta: v.h_meta(),
        };
    }

    // Explicit-zones constructor (for in-container views: a stored object + tag).
    pub static fn from_parts(obj: *const u8, len: u64, tag: u64, meta: u64) -> DView {
        return DView { obj: obj, len: len, tag: tag, meta: meta };
    }

    pub fn type_code(&self) -> u64 { return self.tag; }
    pub fn obj_ptr(&self) -> *const u8 { return self.obj; }
    pub fn obj_len(&self) -> u64 { return self.len; }
    pub fn meta_word(&self) -> u64 { return self.meta; }

    // ── capabilities ────────────────────────────────────────────────────────
    // generic / concrete-typed (`is`/`as` are reserved keywords → is_a/try_to):
    pub fn is_a<T: HermesTag>(&self) -> bool {
        let phantom: *const T = 0 as *const T;
        return self.tag == unsafe { phantom.h_tag() };
    }
    pub fn try_to<T: HermesTag>(&self) -> Option<T> { // checked copy-out
        let phantom: *const T = 0 as *const T;
        if self.tag != unsafe { phantom.h_tag() } { return Option::None; }
        return Option::Some(unsafe { *(self.obj as *const T) });
    }
    pub fn to<T: HermesTag>(&self) -> T {              // asserted copy-out
        return unsafe { *(self.obj as *const T) };
    }
    // runtime-dispatched (over self.tag, via the shared layer):
    pub fn compare(&self, other: &DView) -> Ordering {
        return unsafe { htag_cmp(self.tag, self.meta, self.obj, self.len, other.obj, other.len) };
    }
}

// ── shared tag-keyed capability layer (HAny will route here too) ─────────────
// Each capability is one tag-dispatch. New comparable datatype = one arm here
// (+ a HermesTag impl). Reads object bytes via LE assembly — works at any
// (possibly unaligned) borrowed offset.

unsafe fn load_le(p: *const u8, n: u64) -> u64 {
    let mut v: u64 = 0u64;
    let mut i: u64 = 0u64;
    while i < n {
        v = v | ((*(((p as i64) + (i as i64)) as *const u8) as u64) << (i * 8u64));
        i = i + 1u64;
    }
    return v;
}

// Total order over two same-tagged object-byte runs.
pub unsafe fn htag_cmp(tag: u64, meta: u64, a: *const u8, alen: u64, b: *const u8, blen: u64) -> Ordering {
    if tag == H2_I64 {
        let x: i64 = load_le(a, alen) as i64;
        let y: i64 = load_le(b, blen) as i64;
        if x < y { return Ordering::Less; }
        if x > y { return Ordering::Greater; }
        return Ordering::Equal;
    }
    // default (u64 / bool / any unsigned-comparable tag): unsigned bytes.
    let x: u64 = load_le(a, alen);
    let y: u64 = load_le(b, blen);
    if x < y { return Ordering::Less; }
    if x > y { return Ordering::Greater; }
    return Ordering::Equal;
}

// Object byte stride for a tag (for the at-rest / store path). 0 = unknown.
pub fn htag_size(tag: u64, meta: u64) -> u64 {
    if tag == H2_I64       { return 8u64; }
    if tag == H2_U64       { return 8u64; }
    if tag == HA_BOOL as u64 { return 1u64; }
    return 0u64;
}
