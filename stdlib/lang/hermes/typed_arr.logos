// logos.lang.hermes.typed_arr — `&[T] as <T>[]` cast builders (hermes2).
//
// The C6 language feature: a Logos slice casts to a typed dense hermes2 array
// (TypedArray<T>: {size_:u64, capacity_:u64, data_:RelativePtr<T>} tagged with
// the wire code 2101..2110, raw position-independent elements). The result is
// an Rc<Hermes> whose root is the array object.
//
// Port of mem.hermes.ctr's hermes_build_array_* (Hermes1, retired).

package logos.lang.hermes.typed_arr;

use logos.lang.hermes.anyval;       // HAny
use logos.lang.hermes.allocator;    // Allocator
use logos.lang.hermes.container;    // Hermes, hermes_rc, alloc_tagged, hermes_alloc_bytes
use logos.lang.hermes.compactify;  // clone (Ref values re-anchor)
use logos.mem.rc;                    // Rc

// Core: copy `len` elements of `width` bytes, build the tagged header, set root.
unsafe fn h2_build_typed_array_raw(vals: *const u8, len: i64, width: i64,
                                   tc: u64) -> Rc<Hermes> {
    let mut n: i64 = len;
    if n < 0 { n = 0; }
    let byte_len: i64 = n * width;
    let rc: Rc<Hermes> = hermes_rc(byte_len + 4096);
    let h: &Hermes = rc.deref();
    let hp: *mut Hermes = h as *const Hermes as *mut Hermes;

    // Element buffer first (its address is stable in the never-move arena).
    let mut buf: *mut u8 = 0 as *mut u8;
    if byte_len > 0 {
        buf = hermes_alloc_bytes(hp, byte_len);
        let mut i: i64 = 0;
        while i + 8 <= byte_len {
            *(((buf as i64) + i) as *mut u64) = *(((vals as i64) + i) as *const u64);
            i = i + 8;
        }
        while i < byte_len {
            *(((buf as i64) + i) as *mut u8) = *(((vals as i64) + i) as *const u8);
            i = i + 1;
        }
    }

    // Tagged 24-byte TypedArray header {size_, capacity_, data_relptr}.
    let hdr: *mut u8 = alloc_tagged(&mut hp.allocator as *mut Allocator, 24, tc);
    *(hdr as *mut u64) = n as u64;
    *(((hdr as i64) + 8) as *mut u64) = n as u64;
    let dfield: i64 = (hdr as i64) + 16;
    if buf == (0 as *mut u8) { *(dfield as *mut i64) = 0i64; }
    else { *(dfield as *mut i64) = (buf as i64) - dfield; }   // self-relative

    h.set_root(HAny::ref_to(hdr as *const u8));
    return rc;
}

// Per-element-type entry points (sema's `as <T>[]` lowering calls by name).
pub unsafe fn hermes_build_array_i8(vals: *const i8, len: i64) -> Rc<Hermes> {
    return h2_build_typed_array_raw(vals as *const u8, len, 1, 2105u64);
}
pub unsafe fn hermes_build_array_u8(vals: *const u8, len: i64) -> Rc<Hermes> {
    return h2_build_typed_array_raw(vals, len, 1, 2101u64);
}
pub unsafe fn hermes_build_array_i16(vals: *const i16, len: i64) -> Rc<Hermes> {
    return h2_build_typed_array_raw(vals as *const u8, len, 2, 2106u64);
}
pub unsafe fn hermes_build_array_u16(vals: *const u16, len: i64) -> Rc<Hermes> {
    return h2_build_typed_array_raw(vals as *const u8, len, 2, 2102u64);
}
pub unsafe fn hermes_build_array_i32(vals: *const i32, len: i64) -> Rc<Hermes> {
    return h2_build_typed_array_raw(vals as *const u8, len, 4, 2107u64);
}
pub unsafe fn hermes_build_array_u32(vals: *const u32, len: i64) -> Rc<Hermes> {
    return h2_build_typed_array_raw(vals as *const u8, len, 4, 2103u64);
}
pub unsafe fn hermes_build_array_i64(vals: *const i64, len: i64) -> Rc<Hermes> {
    return h2_build_typed_array_raw(vals as *const u8, len, 8, 2108u64);
}
pub unsafe fn hermes_build_array_u64(vals: *const u64, len: i64) -> Rc<Hermes> {
    return h2_build_typed_array_raw(vals as *const u8, len, 8, 2104u64);
}
pub unsafe fn hermes_build_array_f32(vals: *const f32, len: i64) -> Rc<Hermes> {
    return h2_build_typed_array_raw(vals as *const u8, len, 4, 2109u64);
}
pub unsafe fn hermes_build_array_f64(vals: *const f64, len: i64) -> Rc<Hermes> {
    return h2_build_typed_array_raw(vals as *const u8, len, 8, 2110u64);
}

// ── `(keys, vals) as <K, AnyVal>{}` map-cast sources + builders ───────────────
//
// MapSlice*: parallel key/value slices. Values are VALUE-FORM HAny (the
// hermes2 re-design of the Hermes1 4-byte &[AnyVal]): Pods copy verbatim,
// Refs deep-copy into the result zone (lang.hermes2.compactify).

pub struct MapSliceI32 { pub keys: &[i32], pub vals: &[HAny] }
pub struct MapSliceU32 { pub keys: &[u32], pub vals: &[HAny] }
pub struct MapSliceI64 { pub keys: &[i64], pub vals: &[HAny] }
pub struct MapSliceU64 { pub keys: &[u64], pub vals: &[HAny] }

unsafe fn h2_build_typed_map_raw(keys: *const u8, vals: *const i64, len: i64,
                                 kw: i64, mtc: u64) -> Rc<Hermes> {
    let mut n: i64 = len;
    if n < 0 { n = 0; }
    let rc: Rc<Hermes> = hermes_rc(n * 64 + 4096);
    let h: &Hermes = rc.deref();
    let hp: *mut Hermes = h as *const Hermes as *mut Hermes;

    let mut kbuf: i64 = 0;
    let mut vbuf: i64 = 0;
    if n > 0 {
        kbuf = hermes_alloc_bytes(hp, n * kw) as i64;
        vbuf = hermes_alloc_bytes(hp, n * 8) as i64;
        let mut i: i64 = 0;
        while i < n * kw {
            *((kbuf + i) as *mut u8) = *((keys as i64 + i) as *const u8);
            i = i + 1;
        }
        i = 0;
        while i < n {
            let w: i64 = *((vals as i64 + i * 8) as *const i64);
            let src: HAny = if w == 0i64 { HAny::ref_to(0i64 as *const u8) }
                            else if (w & 1i64) == 1i64 { HAny::Pod(w as u64) }
                            else { HAny::Ref(w as *const u8) };
            let c: HAny = clone(h, src);          // Refs re-anchor in this zone
            let slot: i64 = vbuf + i * 8;
            let cw: i64 = c.raw();
            if cw == 0i64 || (cw & 1i64) == 1i64 { *(slot as *mut i64) = cw; }
            else { *(slot as *mut i64) = cw - slot; }
            i = i + 1;
        }
    }
    let hdr: *mut u8 = alloc_tagged(&mut hp.allocator as *mut Allocator, 32, mtc);
    *(hdr as *mut i64) = n;
    *(((hdr as i64) + 8) as *mut i64) = n;
    let kf: i64 = (hdr as i64) + 16;
    let vf: i64 = (hdr as i64) + 24;
    if kbuf == 0 { *(kf as *mut i64) = 0i64; *(vf as *mut i64) = 0i64; }
    else { *(kf as *mut i64) = kbuf - kf; *(vf as *mut i64) = vbuf - vf; }
    h.set_root(HAny::ref_to(hdr as *const u8));
    return rc;
}

pub unsafe fn hermes_build_map_i32_anyval(keys: *const i32, vals: *const i64, len: i64) -> Rc<Hermes> {
    return h2_build_typed_map_raw(keys as *const u8, vals, len, 4, 3101u64);
}
pub unsafe fn hermes_build_map_u32_anyval(keys: *const u32, vals: *const i64, len: i64) -> Rc<Hermes> {
    return h2_build_typed_map_raw(keys as *const u8, vals, len, 4, 3102u64);
}
pub unsafe fn hermes_build_map_i64_anyval(keys: *const i64, vals: *const i64, len: i64) -> Rc<Hermes> {
    return h2_build_typed_map_raw(keys as *const u8, vals, len, 8, 3103u64);
}
pub unsafe fn hermes_build_map_u64_anyval(keys: *const u64, vals: *const i64, len: i64) -> Rc<Hermes> {
    return h2_build_typed_map_raw(keys as *const u8, vals, len, 8, 3104u64);
}
