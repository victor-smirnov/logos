// Logos lang-tier standard library — logos.lang.hermes.view
//
// Lifecycle-only Hermes views: the non-owning fat-pointer (HermesView)
// and the rodata blob view (HermesStatic). Both are pure value types
// — they wrap pointers and let consumers carry a Hermes zone around
// without owning it. No allocation, no reading of zone-resident
// container types (HermesString / ObjectMap / ObjectArray / Decimal).
//
// This module is the TIER-1 Hermes read substrate: the non-owning view
// structs PLUS the `HermesRead` trait, whose default methods are exactly
// the reads that lang can support today (the document root + inline
// scalar/bool payloads, decoded straight from AnyVal). It pulls only
// other lang-tier Hermes leaves (anyval, document), so a `--no-std/--no-mem`
// program can read a static Hermes blob's structure without the mem fabric.
//
// The TIER-2 extension `HermesReadExt` (mem-tier
// [logos.mem.hermes.view](../../../mem/hermes/view/view.logos)) adds the
// reads that dereference mem-tier container types (HermesString, ObjectMap,
// ObjectArray, Decimal, ...) and the String-producing formatting
// (stringify / to_string / Debug / Display). As container modules migrate
// down to lang, their reads promote from HermesReadExt up into HermesRead.

package logos.lang.hermes.view;

use logos.lang.hermes.anyval;
use logos.lang.hermes.document;
use logos.lang.hermes.string;
use logos.lang.hermes.scalar;
use logos.lang.hermes.array;
use logos.lang.hermes.datatag;

// Length of a null-terminated C string starting at `s`. Re-exposed
// here (rather than depending on logos.lang.str) so lang.hermes.view
// has zero external lang deps beyond the Hermes leaves.
pub unsafe fn view_cstr_len(s: *const u8) -> i64 {
    let mut n: i64 = 0;
    while *((s as i64 + n) as *const u8) != 0 { n = n + 1; }
    return n;
}

// ── HermesView<'a> ────────────────────────────────────────────────────────
//
// Non-owning fat view: pointer to zone data + byte size.
// Borrows from any Hermes, HermesStatic, or raw zone for lifetime 'a.

pub struct HermesView<'a> {
    pub base: *const u8,
    pub size: u64,
}

// ── HermesStatic ─────────────────────────────────────────────────────────────
//
// Non-owning 'static view of a rodata blob created by @-literal codegen.
// Layout in rodata: [u64 size][blob bytes...].
// The ptr field points to the first blob byte (after the u64 prefix).
// Use hermes_static_size(ptr) to read the size without owning a HermesStatic.

pub struct HermesStatic {
    pub ptr: *const u8,
}

// Read the blob size stored 8 bytes before the blob pointer.
pub unsafe fn hermes_static_size(ptr: *const u8) -> u64 {
    return *((ptr as i64 - 8) as *const u64);
}

// ── StringView ───────────────────────────────────────────────────────────────
//
// Non-owning byte-slice view: pointer + length. Returned by reads of
// zone-resident strings (HermesString) and used as the call-site type
// for str arguments at the C boundary. Pure value — no allocation.

pub struct StringView {
    pub ptr: *const u8,
    pub len: u64,
}

impl Copy for StringView {}

// ── HermesRead trait (tier 1) ─────────────────────────────────────────────────
//
// Read-only view over any Hermes zone. Implementations provide the two
// primitives base() and size(); the default methods here are every read
// whose deps now live at the lang tier — the document root, inline AnyVal
// payloads, zone strings/scalars, and ObjectArray. Reads that still need a
// mem-tier type (decimals) OR that require importing both lang.hermes.map +
// lang.hermes.objectmap (map_get/tiny_map_get — see the note at the end of
// this trait) live on the tier-2 supertrait `HermesReadExt` (mem.hermes.view),
// alongside the String-producing formatting helpers.

pub trait HermesRead {
    // Pointer to the first byte of the DocumentHeader in zone memory.
    fn base(self: &Self) -> *const u8;

    // Byte size of the zone content (used bytes, not capacity).
    fn size(self: &Self) -> u64;

    // Root AnyVal of the document.
    fn root(self: &Self) -> AnyVal {
        unsafe {
            let doc: *const DocumentHeader = self.base() as *const DocumentHeader;
            return document_get_root(doc);
        }
    }

    // Integer payload (inline i24, cast to i64). Returns 0 if val is not int.
    fn get_int(self: &Self, val: AnyVal) -> i64 {
        unsafe { return val.as_i64(); }
    }

    // Boolean payload. Returns false if val is not bool.
    fn get_bool(self: &Self, val: AnyVal) -> bool {
        unsafe {
            if !val.is_bool() { return false; }
            return val.as_bool();
        }
    }

    // StringView over a zone HermesString. Returns {null,0} if not a string.
    fn get_str_view(self: &Self, val: AnyVal) -> StringView {
        unsafe {
            let base: *const u8 = self.base();
            if !val.is_string(base) {
                return StringView { ptr: 0 as *const u8, len: 0 };
            }
            let hs: *const HermesString =
                (base as i64 + val.as_offset() as i64) as *const HermesString;
            return StringView { ptr: hs.bytes(), len: hs.len() };
        }
    }

    // Extract i64 from inline Integer (i24) or zone I64 (type_code=26).
    fn get_i64(self: &Self, val: AnyVal) -> i64 {
        unsafe {
            if !val.is_ptr() {
                if val.is_int() { return val.as_i24() as i64; }
                return 0;
            }
            if val.is_null() { return 0; }
            let base: *const u8 = self.base();
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag: u64 = read_type_code(obj);
            if tag != 26 { return 0; }
            let p: *const I64 = obj as *const I64;
            return p.value();
        }
    }

    // Extract u64 from inline UInteger (u24) or zone U64 (type_code=27).
    fn get_u64(self: &Self, val: AnyVal) -> u64 {
        unsafe {
            if !val.is_ptr() {
                if val.is_uint() { return val.as_u24() as u64; }
                return 0;
            }
            if val.is_null() { return 0; }
            let base: *const u8 = self.base();
            let obj: *const u8 = (base as i64 + val.as_offset() as i64) as *const u8;
            let tag: u64 = read_type_code(obj);
            if tag != 27 { return 0; }
            let p: *const U64 = obj as *const U64;
            return p.value();
        }
    }

    // Number of elements in an ObjectArray. Returns 0 if not an array.
    fn array_len(self: &Self, val: AnyVal) -> u64 {
        unsafe {
            let base: *const u8 = self.base();
            if !val.is_array(base) { return 0; }
            let arr: *const ObjectArray =
                (base as i64 + val.as_offset() as i64) as *const ObjectArray;
            return arr.len();
        }
    }

    // Get element at idx from an ObjectArray. Returns null_ptr if out of bounds.
    fn array_get(self: &Self, val: AnyVal, idx: u64) -> AnyVal {
        unsafe {
            let base: *const u8 = self.base();
            if !val.is_array(base) { return AnyVal::null_ptr(); }
            let arr: *const ObjectArray =
                (base as i64 + val.as_offset() as i64) as *const ObjectArray;
            return arr.get(base, idx);
        }
    }

    // NOTE: map reads (map_get / map_get_cstr / tiny_map_get) stay on the
    // tier-2 `HermesReadExt` (mem.hermes.view), not because they need mem, but
    // because they require importing BOTH lang.hermes.map and
    // lang.hermes.objectmap, whose overlapping `Map<...>` specializations trip
    // a cross-module duplicate-datatype limitation when pulled into one
    // lang-layer module (B-mv-02 family). Promote them once that's fixed.
}

impl<'a> HermesRead for HermesView<'a> {
    fn base(self: &HermesView<'a>) -> *const u8 { return self.base; }
    fn size(self: &HermesView<'a>) -> u64 { return self.size; }
}

impl HermesRead for HermesStatic {
    fn base(self: &HermesStatic) -> *const u8 { return self.ptr; }
    fn size(self: &HermesStatic) -> u64 {
        unsafe { return hermes_static_size(self.ptr); }
    }
}

impl HermesStatic {
    pub fn as_view<'a>(self: &'a HermesStatic) -> HermesView<'a> {
        unsafe {
            return HermesView {
                base: self.ptr,
                size: hermes_static_size(self.ptr),
            };
        }
    }
}
