// Logos standard library — std.lang.array
//
// Mirrors `core::array`:
//   `IntoIter<T, N>` — owned-array iterator.
//   `from_ref<T>(t: &T) -> &[T; 1]` — view a single ref as a 1-array.
//   `from_mut<T>(t: &mut T) -> &mut [T; 1]` — mutable counterpart.
//
// The owned IntoIter uses the const-N field codegen fixed in B104. The
// `from_ref`/`from_mut` helpers are zero-cost pointer reinterprets.

package logos.lang.array;

use logos.lang.option;
use logos.lang.iter;
use logos.lang.ops;

// ── ArrayIntoIter<T, const N> — owned-array iterator ─────────────────────

/// Owned-array iterator; yields the elements of `[T; N]` by value.
pub struct ArrayIntoIter<T, const N: i64> {
    /// The array being consumed.
    pub buf: [T; N],
    /// Index of the next element to yield.
    pub idx: i64,
}

/// Converts an owned `[T; N]` array into an iterator that yields its elements by value.
pub fn array_into_iter<T, const N: i64>(buf: [T; N]) -> ArrayIntoIter<T, N> {
    return ArrayIntoIter::<T, N> { buf: buf, idx: 0i64 };
}

impl<T, const N: i64> Iterator<T> for ArrayIntoIter<T, N> {
    fn next(self: &mut ArrayIntoIter<T, N>) -> Option<T> {
        if self.idx >= N { return Option::<T>::None; }
        // Move the element out via a raw-pointer read (Rust's array IntoIter
        // uses ptr::read). A safe `self.buf[self.idx]` would be a move out of
        // an array index behind `&mut self` (E0507); the raw-ptr read is the
        // unsafe primitive that owns that responsibility (idx advances so each
        // element is yielded once).
        unsafe {
            let base: *const T = (&self.buf) as *const T;
            let v: T = base[self.idx];
            self.idx = self.idx + 1i64;
            return Option::<T>::Some(v);
        }
    }
}

impl<T, const N: i64> ExactSizeIterator<T> for ArrayIntoIter<T, N> {
    fn len(&self) -> i64 {
        if self.idx >= N { return 0i64; }
        return N - self.idx;
    }
}

impl<T, const N: i64> FusedIterator<T> for ArrayIntoIter<T, N> {}

// ── from_ref / from_mut ─────────────────────────────────────────────────
//
// Reinterpret a single reference as a 1-element array reference. The
// underlying memory layout is identical for `T` and `[T; 1]`, so this
// is a no-op cast.

/// Views a single reference as a 1-element array reference (zero-cost pointer reinterpret).
pub fn array_from_ref<T>(t: &T) -> &[T; 1] {
    unsafe {
        let p: *const T = t as *const T;
        return &*(p as *const [T; 1]);
    }
}

/// Views a single mutable reference as a 1-element mutable array reference.
pub fn array_from_mut<T>(t: &mut T) -> &mut [T; 1] {
    unsafe {
        let p: *mut T = t as *mut T;
        return &mut *(p as *mut [T; 1]);
    }
}
