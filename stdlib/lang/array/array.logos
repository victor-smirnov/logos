// Logos standard library — std.lang.array
//
// Mirrors `core::array`:
//   `IntoIter<T, N>` — owned-array iterator.
//   `from_ref<T>(t: &T) -> &[T; 1]` — view a single ref as a 1-array.
//   `from_mut<T>(t: &mut T) -> &mut [T; 1]` — mutable counterpart.
//
// The owned IntoIter uses the const-N field codegen fixed in B104. The
// `from_ref`/`from_mut` helpers are zero-cost pointer reinterprets.

package logos.lang.array;

use logos.lang.option;
use logos.lang.iter;
use logos.lang.ops;

// ── ArrayIntoIter<T, const N> — owned-array iterator ─────────────────────

// #116 — THE OWNERSHIP OBLIGATION, NOT THE SPELLING.
// `next` reads an element out of `buf` through a raw pointer (a correct
// `ptr::read`) and hands it to the consumer. The array slot still holds a
// bit-identical copy, so the compiler's automatic element drop glue destroys
// every yielded element a SECOND time. MEASURED at 93e123df with a
// heap-owning payload: 2 items in -> 4 destructor calls; 4 items -> 8; rc 0
// in both (only the COUNT sees it — no abort, no leak, a silent double free).
// The missing half was never the read: it was a `Drop` that reconciles the
// cursor, exactly the one `VecIntoIter` has (vec.logos, `impl<T> Drop for
// VecIntoIter<T>`). A `Drop` impl alone is not enough here, because
// `VecIntoIter`'s storage is a raw pointer (no glue) while this one is an
// INLINE array (glue for all N regardless of `idx`); the storage must first
// be taken out of the compiler's hands.
//
/// Storage cell for the array an `ArrayIntoIter` is consuming.
/// `#[no_auto_drop]` suppresses the compiler's per-element drop glue at every
/// nesting depth, making `ArrayIntoIter`'s hand-written `Drop` the SINGLE
/// owner of the elements' destruction obligation.
// ⚠ THE TYPE IS NAMEABLE, THE CONSTRUCTOR IS NOT. This type is
// `#[no_auto_drop]`, which is exactly what makes
// `ArrayIntoIter`'s hand-written `Drop` the single owner of the elements'
// destruction obligation — and it is therefore a LEAK BY CONSTRUCTION if
// anyone builds one directly: MEASURED 2 values in, 0 destructor calls out,
// rc 0. It was `pub` when this fix first landed; the round's own verify built
// one and watched both values vanish.
//
// The type itself must stay `pub`: it is the type of a field of the public
// `ArrayIntoIter`, and making it private makes every cross-package USE of a
// legitimately-obtained iterator refuse (measured: `'ArrayIntoIterBuf' is
// private to package 'logos.lang.array'` at the `let` AND at the `.count()`).
// So the CONSTRUCTOR is what closes, not the name: field `a` is private, and
// `ArrayIntoIterBuf { a: … }` from another package is refused with
// `field 'a' is private`. Nameable, not buildable — which is the whole
// property, because the leak needs a construction, not a mention.
#[no_auto_drop]
pub struct ArrayIntoIterBuf<T, const N: i64> {
    /// The array being consumed. Elements `[0, idx)` have been yielded and are
    /// owned by the consumer; `[idx, N)` are still owned by the iterator.
    a: [T; N],
}

/// Owned-array iterator; yields the elements of `[T; N]` by value.
/// On drop, the un-yielded tail `[idx, N)` is dropped and nothing else is.
pub struct ArrayIntoIter<T, const N: i64> {
    /// The array being consumed (drop-glue-suppressed; see `Drop` below).
    pub buf: ArrayIntoIterBuf<T, N>,
    /// Index of the next element to yield.
    pub idx: i64,
}

/// Converts an owned `[T; N]` array into an iterator that yields its elements by value.
pub fn array_into_iter<T, const N: i64>(buf: [T; N]) -> ArrayIntoIter<T, N> {
    return ArrayIntoIter::<T, N> {
        buf: ArrayIntoIterBuf::<T, N> { a: buf },
        idx: 0i64,
    };
}

impl<T, const N: i64> Drop for ArrayIntoIter<T, N> {
    fn drop(self: &mut ArrayIntoIter<T, N>) {
        // BOTH DIRECTIONS. Exactly the un-yielded tail: `[0, idx)` already
        // belongs to the consumer (dropping it here would be the double free
        // this fixes), `[idx, N)` belongs to nobody else (not dropping it
        // would be the leak the fix must not trade for). `idx = N` makes the
        // walk idempotent if the destructor is ever reached twice.
        unsafe {
            let base: *const T = (&self.buf.a) as *const T;
            let mut i: i64 = self.idx;
            while i < N {
                let _tail: T = base[i];   // move-and-drop on scope exit
                i = i + 1i64;
            }
            self.idx = N;
        }
    }
}

impl<T, const N: i64> Iterator<T> for ArrayIntoIter<T, N> {
    fn next(self: &mut ArrayIntoIter<T, N>) -> Option<T> {
        if self.idx >= N { return Option::<T>::None; }
        // Move the element out via a raw-pointer read (Rust's array IntoIter
        // uses ptr::read). A safe `self.buf[self.idx]` would be a move out of
        // an array index behind `&mut self` (E0507); the raw-ptr read is the
        // unsafe primitive that owns that responsibility (idx advances so each
        // element is yielded once).
        unsafe {
            let base: *const T = (&self.buf.a) as *const T;
            let v: T = base[self.idx];
            self.idx = self.idx + 1i64;
            return Option::<T>::Some(v);
        }
    }
}

impl<T, const N: i64> ExactSizeIterator<T> for ArrayIntoIter<T, N> {
    fn len(&self) -> i64 {
        if self.idx >= N { return 0i64; }
        return N - self.idx;
    }
}

impl<T, const N: i64> FusedIterator<T> for ArrayIntoIter<T, N> {}

// ── from_ref / from_mut ─────────────────────────────────────────────────
//
// Reinterpret a single reference as a 1-element array reference. The
// underlying memory layout is identical for `T` and `[T; 1]`, so this
// is a no-op cast.

/// Views a single reference as a 1-element array reference (zero-cost pointer reinterpret).
pub fn array_from_ref<T>(t: &T) -> &[T; 1] {
    unsafe {
        let p: *const T = t as *const T;
        return &*(p as *const [T; 1]);
    }
}

/// Views a single mutable reference as a 1-element mutable array reference.
pub fn array_from_mut<T>(t: &mut T) -> &mut [T; 1] {
    unsafe {
        let p: *mut T = t as *mut T;
        return &mut *(p as *mut [T; 1]);
    }
}
