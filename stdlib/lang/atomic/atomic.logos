        unsafe { return logos_atomic_fetch_add64_ord(self.val.get(), 0 as i64 - delta, ord); }
    }
    /// Performs `compare_exchange` with explicit success/failure orderings.
    pub fn compare_exchange_ordered(self: *mut AtomicI64, expected: i64, desired: i64,
                                    success: Ordering, failure: Ordering) -> bool {
        unsafe { return logos_atomic_cas64_ord(self.val.get(), expected, desired, success, failure); }
    }
}

