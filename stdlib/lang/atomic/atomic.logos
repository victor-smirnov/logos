// Logos standard library — std.atomic
//
// Atomic types backed by x86-64 assembly primitives in stdlib/rt/fiber_ctx.S.
// Memory ordering: x86 TSO (Total Store Order) guarantees that plain
// loads/stores are already acquire-loads / release-stores.  LOCK-prefixed
// read-modify-write operations are sequentially consistent.
//
// API mirrors Rust's std::sync::atomic but uses free functions (no RAII).
//
// Types:
//   AtomicI32, AtomicU32, AtomicI64, AtomicU64, AtomicBool, AtomicPtr<T>
//
// Memory ordering:
//   Logos atomics ship with `Ordering` variants matching
//   `core::sync::atomic::Ordering` for source-level Rust parity. On
//   the x86-64 backend every ordering currently lowers to the same
//   seq-cst primitive (TSO + LOCK-prefixed RMW already provides
//   acquire / release semantics for plain loads / stores; LOCK-RMW
//   provides full SeqCst). On weaker-memory targets (AArch64,
//   RISC-V) the ordering would route to dmb / lr-sc variants —
//   that's a backend codegen change, not an API change.

package logos.lang.atomic;

use logos.lang.option;

// ── Memory ordering ──────────────────────────────────────────────────────────
//
// Mirrors `core::sync::atomic::Ordering`. Variants in load-vs-store
// applicability order:
//   Relaxed — no synchronisation, only atomicity
//   Acquire — for loads (and the load half of RMW)
//   Release — for stores (and the store half of RMW)
//   AcqRel  — for RMW (acquire-load + release-store)
//   SeqCst  — total order across all SeqCst ops
//
// All variants degrade to seq-cst on x86 today (see module header).

pub enum Ordering {
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst,
}

// ── Assembly primitives ────────────────────────────────────────────────────────
// The bare seq-cst variants are the default — mlir_gen lowers them
// to LLVM atomic ops with `seq_cst` ordering.
extern fn logos_atomic_load32(ptr: *const i32) -> i32;
extern fn logos_atomic_store32(ptr: *mut i32, val: i32);
extern fn logos_atomic_fetch_add32(ptr: *mut i32, val: i32) -> i32;
extern fn logos_atomic_cas32(ptr: *mut i32, expected: i32, desired: i32) -> bool;

extern fn logos_atomic_load64(ptr: *const i64) -> i64;
extern fn logos_atomic_store64(ptr: *mut i64, val: i64);
extern fn logos_atomic_fetch_add64(ptr: *mut i64, val: i64) -> i64;
extern fn logos_atomic_cas64(ptr: *mut i64, expected: i64, desired: i64) -> bool;

// §6.14: ordering-aware twins. The last arg is the `Ordering` enum
// value at the call site. mlir_gen const-evals it (when the arg is
// a literal `Ordering::Release` / `Ordering::Acquire` / …) and
// threads the resolved value through to the LLVM atomic op's
// `ordering` attribute (Relaxed → monotonic, Acquire → acquire,
// Release → release, AcqRel → acq_rel, SeqCst → seq_cst). Falls
// back to seq_cst when the arg isn't an EnumLit literal.
extern fn logos_atomic_load32_ord(ptr: *const i32, ord: Ordering) -> i32;
extern fn logos_atomic_store32_ord(ptr: *mut i32, val: i32, ord: Ordering);
extern fn logos_atomic_fetch_add32_ord(ptr: *mut i32, val: i32, ord: Ordering) -> i32;
extern fn logos_atomic_cas32_ord(ptr: *mut i32, expected: i32, desired: i32,
                                 success: Ordering, failure: Ordering) -> bool;

extern fn logos_atomic_load64_ord(ptr: *const i64, ord: Ordering) -> i64;
extern fn logos_atomic_store64_ord(ptr: *mut i64, val: i64, ord: Ordering);
extern fn logos_atomic_fetch_add64_ord(ptr: *mut i64, val: i64, ord: Ordering) -> i64;
extern fn logos_atomic_cas64_ord(ptr: *mut i64, expected: i64, desired: i64,
                                 success: Ordering, failure: Ordering) -> bool;

// §5 Wave 9 — full RMW family (Rust `std::sync::atomic` parity):
//   swap → xchg (returns old, writes new)
//   fetch_or / fetch_and / fetch_xor → bitwise RMW
//   fetch_sub → as fetch_add of negated delta (already used by the
//     wrapper methods, but adding a direct primitive for clarity)
//   cas_weak → may spuriously fail; used in retry loops where the
//     surrounding loop re-checks. Same LLVM op as strong CAS today;
//     the weak-vs-strong codegen choice can be threaded later.
extern fn logos_atomic_swap32(ptr: *mut i32, val: i32) -> i32;
extern fn logos_atomic_swap64(ptr: *mut i64, val: i64) -> i64;
extern fn logos_atomic_fetch_or32(ptr: *mut i32, val: i32) -> i32;
extern fn logos_atomic_fetch_or64(ptr: *mut i64, val: i64) -> i64;
extern fn logos_atomic_fetch_and32(ptr: *mut i32, val: i32) -> i32;
extern fn logos_atomic_fetch_and64(ptr: *mut i64, val: i64) -> i64;
extern fn logos_atomic_fetch_xor32(ptr: *mut i32, val: i32) -> i32;
extern fn logos_atomic_fetch_xor64(ptr: *mut i64, val: i64) -> i64;
extern fn logos_atomic_cas_weak32(ptr: *mut i32, expected: i32, desired: i32) -> bool;
extern fn logos_atomic_cas_weak64(ptr: *mut i64, expected: i64, desired: i64) -> bool;

extern fn logos_atomic_swap32_ord(ptr: *mut i32, val: i32, ord: Ordering) -> i32;
extern fn logos_atomic_swap64_ord(ptr: *mut i64, val: i64, ord: Ordering) -> i64;
extern fn logos_atomic_fetch_or32_ord(ptr: *mut i32, val: i32, ord: Ordering) -> i32;
extern fn logos_atomic_fetch_or64_ord(ptr: *mut i64, val: i64, ord: Ordering) -> i64;
extern fn logos_atomic_fetch_and32_ord(ptr: *mut i32, val: i32, ord: Ordering) -> i32;
extern fn logos_atomic_fetch_and64_ord(ptr: *mut i64, val: i64, ord: Ordering) -> i64;
extern fn logos_atomic_fetch_xor32_ord(ptr: *mut i32, val: i32, ord: Ordering) -> i32;
extern fn logos_atomic_fetch_xor64_ord(ptr: *mut i64, val: i64, ord: Ordering) -> i64;
extern fn logos_atomic_cas_weak32_ord(ptr: *mut i32, expected: i32, desired: i32,
                                      success: Ordering, failure: Ordering) -> bool;
extern fn logos_atomic_cas_weak64_ord(ptr: *mut i64, expected: i64, desired: i64,
                                      success: Ordering, failure: Ordering) -> bool;

// AtomicI8 / AtomicI16 / AtomicU8 / AtomicU16 reuse the 32-bit primitives
// today: x86 LOCK-prefixed RMW supports narrow widths natively, but
// we don't yet have 8/16-bit variants of the assembly stubs surfaced
// up. Until they are, the narrow atomics widen to 32 bits at the
// boundary — correct, slightly larger storage footprint (4 bytes per
// atomic), full Rust-side API parity.

// ── AtomicI32 ─────────────────────────────────────────────────────────────────

pub struct AtomicI32 { pub val: i32 }

pub fn atomic_i32_new(v: i32) -> AtomicI32 { return AtomicI32 { val: v }; }

impl AtomicI32 {
    pub fn load(&self) -> i32 {
        unsafe { return logos_atomic_load32(&self.val as *const i32); }
    }
    pub fn store(self: *mut AtomicI32, v: i32) {
        unsafe { logos_atomic_store32(&mut self.val as *mut i32, v); }
    }
    // Returns old value.
    pub fn fetch_add(self: *mut AtomicI32, delta: i32) -> i32 {
        unsafe { return logos_atomic_fetch_add32(&mut self.val as *mut i32, delta); }
    }
    pub fn fetch_sub(self: *mut AtomicI32, delta: i32) -> i32 {
        unsafe { return logos_atomic_fetch_add32(&mut self.val as *mut i32, 0 - delta); }
    }
    // Returns true if exchange happened.
    pub fn compare_exchange(self: *mut AtomicI32, expected: i32, desired: i32) -> bool {
        unsafe { return logos_atomic_cas32(&mut self.val as *mut i32, expected, desired); }
    }

    // §6.14 ordering-aware variants. Route through the `_ord`
    // intrinsics so mlir_gen can const-eval the Ordering arg
    // (when it's a literal `Ordering::Release` / `Acquire` / …) and
    // emit the matching LLVM atomic-op ordering. Non-literal args
    // fall back to seq_cst (conservative, always sound).
    pub fn load_ordered(&self, ord: Ordering) -> i32 {
        unsafe { return logos_atomic_load32_ord(&self.val as *const i32, ord); }
    }
    pub fn store_ordered(self: *mut AtomicI32, v: i32, ord: Ordering) {
        unsafe { logos_atomic_store32_ord(&mut self.val as *mut i32, v, ord); }
    }
    pub fn fetch_add_ordered(self: *mut AtomicI32, delta: i32, ord: Ordering) -> i32 {
        unsafe { return logos_atomic_fetch_add32_ord(&mut self.val as *mut i32, delta, ord); }
    }
    pub fn fetch_sub_ordered(self: *mut AtomicI32, delta: i32, ord: Ordering) -> i32 {
        unsafe { return logos_atomic_fetch_add32_ord(&mut self.val as *mut i32, 0 - delta, ord); }
    }
    pub fn compare_exchange_ordered(self: *mut AtomicI32, expected: i32, desired: i32,
                                    success: Ordering, failure: Ordering) -> bool {
        unsafe { return logos_atomic_cas32_ord(&mut self.val as *mut i32, expected, desired, success, failure); }
    }
    // §5 Wave 9 — full RMW family.
    pub fn swap(self: *mut AtomicI32, v: i32) -> i32 {
        unsafe { return logos_atomic_swap32(&mut self.val as *mut i32, v); }
    }
    pub fn fetch_or(self: *mut AtomicI32, v: i32) -> i32 {
        unsafe { return logos_atomic_fetch_or32(&mut self.val as *mut i32, v); }
    }
    pub fn fetch_and(self: *mut AtomicI32, v: i32) -> i32 {
        unsafe { return logos_atomic_fetch_and32(&mut self.val as *mut i32, v); }
    }
    pub fn fetch_xor(self: *mut AtomicI32, v: i32) -> i32 {
        unsafe { return logos_atomic_fetch_xor32(&mut self.val as *mut i32, v); }
    }
    pub fn compare_exchange_weak(self: *mut AtomicI32, expected: i32, desired: i32) -> bool {
        unsafe { return logos_atomic_cas_weak32(&mut self.val as *mut i32, expected, desired); }
    }
    pub fn swap_ordered(self: *mut AtomicI32, v: i32, ord: Ordering) -> i32 {
        unsafe { return logos_atomic_swap32_ord(&mut self.val as *mut i32, v, ord); }
    }
    pub fn fetch_or_ordered(self: *mut AtomicI32, v: i32, ord: Ordering) -> i32 {
        unsafe { return logos_atomic_fetch_or32_ord(&mut self.val as *mut i32, v, ord); }
    }
    pub fn fetch_and_ordered(self: *mut AtomicI32, v: i32, ord: Ordering) -> i32 {
        unsafe { return logos_atomic_fetch_and32_ord(&mut self.val as *mut i32, v, ord); }
    }
    pub fn fetch_xor_ordered(self: *mut AtomicI32, v: i32, ord: Ordering) -> i32 {
        unsafe { return logos_atomic_fetch_xor32_ord(&mut self.val as *mut i32, v, ord); }
    }
    pub fn compare_exchange_weak_ordered(self: *mut AtomicI32, expected: i32, desired: i32,
                                         success: Ordering, failure: Ordering) -> bool {
        unsafe { return logos_atomic_cas_weak32_ord(&mut self.val as *mut i32, expected, desired, success, failure); }
    }
}

// ── AtomicU32 — same layout, different sign convention ──────────────────────

pub struct AtomicU32 { pub val: i32 }  // stored as i32 bits

pub fn atomic_u32_new(v: u32) -> AtomicU32 { return AtomicU32 { val: v as i32 }; }

impl AtomicU32 {
    pub fn load(&self) -> u32 {
        unsafe { return logos_atomic_load32(&self.val as *const i32) as u32; }
    }
    pub fn store(self: *mut AtomicU32, v: u32) {
        unsafe { logos_atomic_store32(&mut self.val as *mut i32, v as i32); }
    }
    pub fn fetch_add(self: *mut AtomicU32, delta: u32) -> u32 {
        unsafe { return logos_atomic_fetch_add32(&mut self.val as *mut i32, delta as i32) as u32; }
    }
    pub fn fetch_sub(self: *mut AtomicU32, delta: u32) -> u32 {
        unsafe { return logos_atomic_fetch_add32(&mut self.val as *mut i32, (0 as u32 - delta) as i32) as u32; }
    }
    pub fn compare_exchange(self: *mut AtomicU32, expected: u32, desired: u32) -> bool {
        unsafe { return logos_atomic_cas32(&mut self.val as *mut i32, expected as i32, desired as i32); }
    }

    // §6.14 ordering-aware variants — see AtomicI32 for the dispatch
    // rationale.
    pub fn load_ordered(&self, ord: Ordering) -> u32 {
        unsafe { return logos_atomic_load32_ord(&self.val as *const i32, ord) as u32; }
    }
    pub fn store_ordered(self: *mut AtomicU32, v: u32, ord: Ordering) {
        unsafe { logos_atomic_store32_ord(&mut self.val as *mut i32, v as i32, ord); }
    }
    pub fn fetch_add_ordered(self: *mut AtomicU32, delta: u32, ord: Ordering) -> u32 {
        unsafe { return logos_atomic_fetch_add32_ord(&mut self.val as *mut i32, delta as i32, ord) as u32; }
    }
    pub fn fetch_sub_ordered(self: *mut AtomicU32, delta: u32, ord: Ordering) -> u32 {
        unsafe { return logos_atomic_fetch_add32_ord(&mut self.val as *mut i32, (0 as u32 - delta) as i32, ord) as u32; }
    }
    pub fn compare_exchange_ordered(self: *mut AtomicU32, expected: u32, desired: u32,
                                    success: Ordering, failure: Ordering) -> bool {
        unsafe { return logos_atomic_cas32_ord(&mut self.val as *mut i32, expected as i32, desired as i32, success, failure); }
    }
}

// ── AtomicI64 ─────────────────────────────────────────────────────────────────

pub struct AtomicI64 { pub val: i64 }

pub fn atomic_i64_new(v: i64) -> AtomicI64 { return AtomicI64 { val: v }; }

