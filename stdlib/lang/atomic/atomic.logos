// ── AtomicUsize — pointer-width unsigned (64-bit here), i64-backed ───────────
// T2-24: `core::sync::atomic::AtomicUsize` parity. Same layout/intrinsics as
// AtomicU64 (usize is 64-bit on this target); the API is usize-typed.

/// Wraps a `usize` (64-bit on this target) for lock-free atomic access; `i64`-backed.
pub struct AtomicUsize { val: UnsafeCell<i64> }  // stored as i64 bits

/// Creates an `AtomicUsize` initialized to `v`.
pub fn atomic_usize_new(v: usize) -> AtomicUsize { return AtomicUsize { val: UnsafeCell::new(v as i64) }; }

impl AtomicUsize {
    /// Loads the current value (seq-cst).
    pub fn load(&self) -> usize {
        unsafe { return logos_atomic_load64(self.val.get() as *const i64) as usize; }
    }
    /// Stores `v` atomically (seq-cst).
    pub fn store(self: *mut AtomicUsize, v: usize) {
        unsafe { logos_atomic_store64(self.val.get(), v as i64); }
    }
    /// Atomically adds `delta`, returning the previous value; wraps on overflow.
    pub fn fetch_add(self: *mut AtomicUsize, delta: usize) -> usize {
        unsafe { return logos_atomic_fetch_add64(self.val.get(), delta as i64) as usize; }
    }
    /// Atomically subtracts `delta`, returning the previous value; wraps on overflow.
    pub fn fetch_sub(self: *mut AtomicUsize, delta: usize) -> usize {
        unsafe { return logos_atomic_fetch_add64(self.val.get(), (0 as usize - delta) as i64) as usize; }
    }
    /// Atomically replaces the value with `desired` if it equals `expected`; returns `true` on success.
    pub fn compare_exchange(self: *mut AtomicUsize, expected: usize, desired: usize) -> bool {
        unsafe { return logos_atomic_cas64(self.val.get(), expected as i64, desired as i64); }
    }

    /// Loads the value using ordering `ord`; a non-literal `ord` degrades to seq-cst.
    pub fn load_ordered(&self, ord: Ordering) -> usize {
        unsafe { return logos_atomic_load64_ord(self.val.get() as *const i64, ord) as usize; }
    }
    /// Stores `v` using ordering `ord`; a non-literal `ord` degrades to seq-cst.
    pub fn store_ordered(self: *mut AtomicUsize, v: usize, ord: Ordering) {
        unsafe { logos_atomic_store64_ord(self.val.get(), v as i64, ord); }
    }
    /// Atomically adds `delta` using ordering `ord`, returning the previous value.
    pub fn fetch_add_ordered(self: *mut AtomicUsize, delta: usize, ord: Ordering) -> usize {
        unsafe { return logos_atomic_fetch_add64_ord(self.val.get(), delta as i64, ord) as usize; }
    }
    /// Atomically subtracts `delta` using ordering `ord`, returning the previous value.
    pub fn fetch_sub_ordered(self: *mut AtomicUsize, delta: usize, ord: Ordering) -> usize {
        unsafe { return logos_atomic_fetch_add64_ord(self.val.get(), (0 as usize - delta) as i64, ord) as usize; }
    }
    /// Performs `compare_exchange` with explicit success/failure orderings.
    pub fn compare_exchange_ordered(self: *mut AtomicUsize, expected: usize, desired: usize,
                                    success: Ordering, failure: Ordering) -> bool {
        unsafe { return logos_atomic_cas64_ord(self.val.get(), expected as i64, desired as i64, success, failure); }
    }
}

// ── AtomicIsize — pointer-width signed (64-bit here), i64-backed ─────────────

/// Wraps an `isize` (64-bit on this target) for lock-free atomic access; `i64`-backed.
pub struct AtomicIsize { val: UnsafeCell<i64> }

/// Creates an `AtomicIsize` initialized to `v`.
pub fn atomic_isize_new(v: isize) -> AtomicIsize { return AtomicIsize { val: UnsafeCell::new(v as i64) }; }

impl AtomicIsize {
    /// Loads the current value (seq-cst).
    pub fn load(&self) -> isize {
        unsafe { return logos_atomic_load64(self.val.get() as *const i64) as isize; }
    }
    /// Stores `v` atomically (seq-cst).
    pub fn store(self: *mut AtomicIsize, v: isize) {
        unsafe { logos_atomic_store64(self.val.get(), v as i64); }
    }
    /// Atomically adds `delta`, returning the previous value; wraps on overflow.
    pub fn fetch_add(self: *mut AtomicIsize, delta: isize) -> isize {
        unsafe { return logos_atomic_fetch_add64(self.val.get(), delta as i64) as isize; }
    }
    /// Atomically subtracts `delta`, returning the previous value; wraps on overflow.
    pub fn fetch_sub(self: *mut AtomicIsize, delta: isize) -> isize {
        unsafe { return logos_atomic_fetch_add64(self.val.get(), (0 as isize - delta) as i64) as isize; }
    }
    /// Atomically replaces the value with `desired` if it equals `expected`; returns `true` on success.
    pub fn compare_exchange(self: *mut AtomicIsize, expected: isize, desired: isize) -> bool {
        unsafe { return logos_atomic_cas64(self.val.get(), expected as i64, desired as i64); }
    }

    /// Loads the value using ordering `ord`; a non-literal `ord` degrades to seq-cst.
    pub fn load_ordered(&self, ord: Ordering) -> isize {
        unsafe { return logos_atomic_load64_ord(self.val.get() as *const i64, ord) as isize; }
    }
    /// Stores `v` using ordering `ord`; a non-literal `ord` degrades to seq-cst.
    pub fn store_ordered(self: *mut AtomicIsize, v: isize, ord: Ordering) {
        unsafe { logos_atomic_store64_ord(self.val.get(), v as i64, ord); }
    }
    /// Atomically adds `delta` using ordering `ord`, returning the previous value.
    pub fn fetch_add_ordered(self: *mut AtomicIsize, delta: isize, ord: Ordering) -> isize {
        unsafe { return logos_atomic_fetch_add64_ord(self.val.get(), delta as i64, ord) as isize; }
    }
    /// Atomically subtracts `delta` using ordering `ord`, returning the previous value.
    pub fn fetch_sub_ordered(self: *mut AtomicIsize, delta: isize, ord: Ordering) -> isize {
        unsafe { return logos_atomic_fetch_add64_ord(self.val.get(), (0 as isize - delta) as i64, ord) as isize; }
    }
    /// Performs `compare_exchange` with explicit success/failure orderings.
    pub fn compare_exchange_ordered(self: *mut AtomicIsize, expected: isize, desired: isize,
                                    success: Ordering, failure: Ordering) -> bool {
        unsafe { return logos_atomic_cas64_ord(self.val.get(), expected as i64, desired as i64, success, failure); }
    }
}

// ── AtomicBool — backed by i32 (0 = false, 1 = true) ─────────────────────────

/// Wraps a `bool` for lock-free atomic access; backed by an `i32` (0 = false, 1 = true).
pub struct AtomicBool { val: UnsafeCell<i32> }

/// Creates an `AtomicBool` initialized to `v`.
pub fn atomic_bool_new(v: bool) -> AtomicBool {
    if v { return AtomicBool { val: UnsafeCell::new(1) }; }
    return AtomicBool { val: UnsafeCell::new(0) };
}

impl AtomicBool {
    /// Loads the current value (seq-cst).
    pub fn load(&self) -> bool {
        unsafe { return logos_atomic_load32(self.val.get() as *const i32) != 0; }
    }
    /// Stores `v` atomically (seq-cst).
    pub fn store(self: *mut AtomicBool, v: bool) {
        let raw: i32 = if v { 1 } else { 0 };
        unsafe { logos_atomic_store32(self.val.get(), raw); }
    }
    /// Stores `true` and returns the previous value.
    pub fn swap_true(self: *mut AtomicBool) -> bool {
        unsafe { return logos_atomic_swap32(self.val.get(), 1) != 0; }
    }
    /// Atomically replaces the value with `desired` if it equals `expected`; returns `true` on success.
    pub fn compare_exchange(self: *mut AtomicBool, expected: bool, desired: bool) -> bool {
        let e: i32 = if expected { 1 } else { 0 };
        let d: i32 = if desired  { 1 } else { 0 };
        unsafe { return logos_atomic_cas32(self.val.get(), e, d); }
    }

    /// Loads the current value; the ordering argument is currently ignored (seq-cst).
    pub fn load_ordered(&self, _ord: Ordering) -> bool {
        unsafe { return logos_atomic_load32(self.val.get() as *const i32) != 0; }
    }
    /// Stores `v`; the ordering argument is currently ignored (seq-cst).
    pub fn store_ordered(self: *mut AtomicBool, v: bool, _ord: Ordering) {
        let raw: i32 = if v { 1 } else { 0 };
        unsafe { logos_atomic_store32(self.val.get(), raw); }
    }
    /// Performs `compare_exchange`; the ordering arguments are currently ignored (seq-cst).
    pub fn compare_exchange_ordered(self: *mut AtomicBool, expected: bool, desired: bool,
                                    _success: Ordering, _failure: Ordering) -> bool {
        let e: i32 = if expected { 1 } else { 0 };
        let d: i32 = if desired  { 1 } else { 0 };
        unsafe { return logos_atomic_cas32(self.val.get(), e, d); }
    }
}

// ── AtomicPtr<T> — pointer stored as i64 bits ─────────────────────────────────

/// Wraps a raw `*mut T` pointer for lock-free atomic access; stored as `i64` bits.
pub struct AtomicPtr<T> { val: UnsafeCell<i64> }

/// Creates an `AtomicPtr<T>` initialized to `p`.
pub fn atomic_ptr_new<T>(p: *mut T) -> AtomicPtr<T> {
    return AtomicPtr { val: UnsafeCell::new(p as i64) };
}

/// Creates an `AtomicPtr<T>` initialized to the null pointer.
pub fn atomic_ptr_null<T>() -> AtomicPtr<T> {
    return AtomicPtr { val: UnsafeCell::new(0 as i64) };
}

impl<T> AtomicPtr<T> {
    /// Loads the current pointer (seq-cst).
    pub fn load(&self) -> *mut T {
        unsafe { return logos_atomic_load64(self.val.get() as *const i64) as *mut T; }
    }
    /// Stores `p` atomically (seq-cst).
    pub fn store(self: *mut AtomicPtr<T>, p: *mut T) {
        unsafe { logos_atomic_store64(self.val.get(), p as i64); }
    }
    /// Atomically replaces the pointer with `desired` if it equals `expected`; `true` on success.
    pub fn compare_exchange(self: *mut AtomicPtr<T>, expected: *mut T, desired: *mut T) -> bool {
        unsafe { return logos_atomic_cas64(self.val.get(), expected as i64, desired as i64); }
    }

    /// Loads the current pointer; the ordering argument is currently ignored (seq-cst).
    pub fn load_ordered(&self, _ord: Ordering) -> *mut T {
        unsafe { return logos_atomic_load64(self.val.get() as *const i64) as *mut T; }
    }
    /// Stores `p`; the ordering argument is currently ignored (seq-cst).
    pub fn store_ordered(self: *mut AtomicPtr<T>, p: *mut T, _ord: Ordering) {
        unsafe { logos_atomic_store64(self.val.get(), p as i64); }
    }
    /// Performs `compare_exchange`; the ordering arguments are currently ignored (seq-cst).
    pub fn compare_exchange_ordered(self: *mut AtomicPtr<T>, expected: *mut T, desired: *mut T,
                                    _success: Ordering, _failure: Ordering) -> bool {
        unsafe { return logos_atomic_cas64(self.val.get(), expected as i64, desired as i64); }
    }
}

// ── Narrow atomics — AtomicI8 / AtomicI16 / AtomicU8 / AtomicU16 ────────────
//
// Storage widened to 32 bits (the underlying asm stubs are 32-bit). API
// surface matches Rust; values are truncated/sign-extended at the
// boundary so observable behaviour is bit-for-bit equivalent on a
// strongly-ordered target.

/// Wraps an `i8` for lock-free atomic access; storage widened to 32 bits (4-byte footprint).
pub struct AtomicI8 { val: UnsafeCell<i32> }

/// Creates an `AtomicI8` initialized to `v`.
pub fn atomic_i8_new(v: i8) -> AtomicI8 { return AtomicI8 { val: UnsafeCell::new(v as i32) }; }

impl AtomicI8 {
    /// Loads the current value (seq-cst).
    pub fn load(&self) -> i8 {
        unsafe { return logos_atomic_load32(self.val.get() as *const i32) as i8; }
    }
    /// Stores `v` atomically (seq-cst).
    pub fn store(self: *mut AtomicI8, v: i8) {
        unsafe { logos_atomic_store32(self.val.get(), v as i32); }
    }
    /// Atomically adds `delta`, returning the previous value; wraps on overflow.
    pub fn fetch_add(self: *mut AtomicI8, delta: i8) -> i8 {
        unsafe { return logos_atomic_fetch_add32(self.val.get(), delta as i32) as i8; }
    }
    /// Atomically subtracts `delta`, returning the previous value; wraps on overflow.
    pub fn fetch_sub(self: *mut AtomicI8, delta: i8) -> i8 {
        unsafe { return logos_atomic_fetch_add32(self.val.get(), 0 - (delta as i32)) as i8; }
    }
    /// Atomically replaces the value with `desired` if it equals `expected`; returns `true` on success.
    pub fn compare_exchange(self: *mut AtomicI8, expected: i8, desired: i8) -> bool {
        unsafe { return logos_atomic_cas32(self.val.get(), expected as i32, desired as i32); }
    }

    /// Loads the current value; the ordering argument is currently ignored (seq-cst).
    pub fn load_ordered(&self, _ord: Ordering) -> i8 {
        unsafe { return logos_atomic_load32(self.val.get() as *const i32) as i8; }
    }
    /// Stores `v`; the ordering argument is currently ignored (seq-cst).
    pub fn store_ordered(self: *mut AtomicI8, v: i8, _ord: Ordering) {
        unsafe { logos_atomic_store32(self.val.get(), v as i32); }
    }
    /// Atomically adds `delta`, returning the previous value; ordering currently ignored (seq-cst).
    pub fn fetch_add_ordered(self: *mut AtomicI8, delta: i8, _ord: Ordering) -> i8 {
        unsafe { return logos_atomic_fetch_add32(self.val.get(), delta as i32) as i8; }
    }
    /// Performs `compare_exchange`; the ordering arguments are currently ignored (seq-cst).
    pub fn compare_exchange_ordered(self: *mut AtomicI8, expected: i8, desired: i8,
                                    _success: Ordering, _failure: Ordering) -> bool {
        unsafe { return logos_atomic_cas32(self.val.get(), expected as i32, desired as i32); }
    }
}

