    }
    pub fn fetch_sub(self: *mut AtomicI16, delta: i16) -> i16 {
        unsafe { return logos_atomic_fetch_add32(&mut self.val as *mut i32, 0 - (delta as i32)) as i16; }
    }
    pub fn compare_exchange(self: *mut AtomicI16, expected: i16, desired: i16) -> bool {
        unsafe { return logos_atomic_cas32(&mut self.val as *mut i32, expected as i32, desired as i32); }
    }

    pub fn load_ordered(&self, _ord: Ordering) -> i16 {
        unsafe { return logos_atomic_load32(&self.val as *const i32) as i16; }
    }
    pub fn store_ordered(self: *mut AtomicI16, v: i16, _ord: Ordering) {
