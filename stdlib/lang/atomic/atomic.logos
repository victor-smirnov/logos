        unsafe { return logos_atomic_fetch_add64(&mut self.val as *mut i64, delta); }
    }
    pub fn fetch_sub(self: *mut AtomicI64, delta: i64) -> i64 {
        unsafe { return logos_atomic_fetch_add64(&mut self.val as *mut i64, 0 as i64 - delta); }
    }
    pub fn compare_exchange(self: *mut AtomicI64, expected: i64, desired: i64) -> bool {
        unsafe { return logos_atomic_cas64(&mut self.val as *mut i64, expected, desired); }
    }

    pub fn load_ordered(&self, ord: Ordering) -> i64 {
        unsafe { return logos_atomic_load64_ord(&self.val as *const i64, ord); }
    }
    pub fn store_ordered(self: *mut AtomicI64, v: i64, ord: Ordering) {
        unsafe { logos_atomic_store64_ord(&mut self.val as *mut i64, v, ord); }
    }
    pub fn fetch_add_ordered(self: *mut AtomicI64, delta: i64, ord: Ordering) -> i64 {
        unsafe { return logos_atomic_fetch_add64_ord(&mut self.val as *mut i64, delta, ord); }
    }
    pub fn fetch_sub_ordered(self: *mut AtomicI64, delta: i64, ord: Ordering) -> i64 {
        unsafe { return logos_atomic_fetch_add64_ord(&mut self.val as *mut i64, 0 as i64 - delta, ord); }
    }
    pub fn compare_exchange_ordered(self: *mut AtomicI64, expected: i64, desired: i64,
                                    success: Ordering, failure: Ordering) -> bool {
        unsafe { return logos_atomic_cas64_ord(&mut self.val as *mut i64, expected, desired, success, failure); }
    }
}

// ── AtomicU64 ─────────────────────────────────────────────────────────────────

pub struct AtomicU64 { pub val: i64 }  // stored as i64 bits

pub fn atomic_u64_new(v: u64) -> AtomicU64 { return AtomicU64 { val: v as i64 }; }

impl AtomicU64 {
    pub fn load(&self) -> u64 {
        unsafe { return logos_atomic_load64(&self.val as *const i64) as u64; }
    }
    pub fn store(self: *mut AtomicU64, v: u64) {
        unsafe { logos_atomic_store64(&mut self.val as *mut i64, v as i64); }
    }
    pub fn fetch_add(self: *mut AtomicU64, delta: u64) -> u64 {
        unsafe { return logos_atomic_fetch_add64(&mut self.val as *mut i64, delta as i64) as u64; }
    }
    pub fn fetch_sub(self: *mut AtomicU64, delta: u64) -> u64 {
        unsafe { return logos_atomic_fetch_add64(&mut self.val as *mut i64, (0 as u64 - delta) as i64) as u64; }
    }
    pub fn compare_exchange(self: *mut AtomicU64, expected: u64, desired: u64) -> bool {
        unsafe { return logos_atomic_cas64(&mut self.val as *mut i64, expected as i64, desired as i64); }
    }

    pub fn load_ordered(&self, ord: Ordering) -> u64 {
        unsafe { return logos_atomic_load64_ord(&self.val as *const i64, ord) as u64; }
    }
    pub fn store_ordered(self: *mut AtomicU64, v: u64, ord: Ordering) {
        unsafe { logos_atomic_store64_ord(&mut self.val as *mut i64, v as i64, ord); }
    }
    pub fn fetch_add_ordered(self: *mut AtomicU64, delta: u64, ord: Ordering) -> u64 {
        unsafe { return logos_atomic_fetch_add64_ord(&mut self.val as *mut i64, delta as i64, ord) as u64; }
    }
