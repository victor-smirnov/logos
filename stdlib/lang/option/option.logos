// Logos standard library — std.option
//
// Option<T> — optional value type (Some(T) or None).
//
// Phase 4a SL-sl-03: faithful Rust method surface. Subset that
// matches common port-time use:
//   .is_some()  .is_none()
//   .unwrap()  .unwrap_or(def)  .unwrap_or_default()
//   .expect(msg)
//   .map(f)  .and_then(f)
//   .or(other)  .or_else(f)
//   .take()  (requires &mut self; uses raw pointer write)
//
// Methods that need `&self` / `&mut self` shape are skipped here
// because Logos's primitive/enum method dispatch through reference
// receivers is sparse; the by-value forms cover the common pattern
// (Option<T> is small + Copy-like for primitive T).

package logos.lang.option;

use logos.lang.panic;
use logos.lang.default;
use logos.lang.result;
use logos.lang.mem;

pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    // CP-cm-17 leg (b): `&self` rather than by-value so chained-temporary
    // callers (`a.and(n).is_some()`) and non-Copy payloads don't get
    // consumed by the predicate.
    pub fn is_some(&self) -> bool {
        match self {
            Option::Some(_) => { return true; }
            Option::None    => { return false; }
        }
    }

    pub fn is_none(&self) -> bool {
        match self {
            Option::Some(_) => { return false; }
            Option::None    => { return true; }
        }
    }

    // Unwrapping: panics on None.
    pub fn unwrap(self: Option<T>) -> T {
        match self {
            Option::Some(v) => { return v; }
            Option::None    => { panic("called `Option::unwrap()` on a `None` value"); }
        }
    }

    // Same as unwrap but with caller-supplied panic message.
    pub fn expect(self: Option<T>, msg: str) -> T {
        match self {
            Option::Some(v) => { return v; }
            Option::None    => { panic(msg); }
        }
    }

    // Returns the contained Some value or a provided default.
    pub fn unwrap_or(self: Option<T>, default: T) -> T {
        match self {
            Option::Some(v) => { return v; }
            Option::None    => { return default; }
        }
    }


    // Returns the contained Some value or computes one from a closure.
    // `f` is a fn-pointer; non-capturing closures coerce automatically.
    pub fn unwrap_or_else(self: Option<T>, f: fn() -> T) -> T {
        match self {
            Option::Some(v) => { return v; }
            Option::None    => { return f(); }
        }
    }

    // Maps an Option<T> to Option<U> by applying a function to a contained value.
    pub fn map<U>(self: Option<T>, f: fn(T) -> U) -> Option<U> {
        match self {
            Option::Some(v) => { return Option::Some(f(v)); }
            Option::None    => { return Option::None; }
        }
    }

    // Returns `default` (if None) or applies `f` to the contained Some value.
    pub fn map_or<U>(self: Option<T>, default: U, f: fn(T) -> U) -> U {
        match self {
            Option::Some(v) => { return f(v); }
            Option::None    => { return default; }
        }
    }

    // Computes a default from `dfl` if None, else applies `f`.
    pub fn map_or_else<U>(self: Option<T>, dfl: fn() -> U, f: fn(T) -> U) -> U {
        match self {
            Option::Some(v) => { return f(v); }
            Option::None    => { return dfl(); }
        }
    }

    // Transforms Option<T> into Result<T, E>, mapping Some(v) → Ok(v) and
    // None → Err(err).
    pub fn ok_or<E>(self: Option<T>, err: E) -> Result<T, E> {
        match self {
            Option::Some(v) => { return Result::Ok(v); }
            Option::None    => { return Result::Err(err); }
        }
    }

    // Same as ok_or but the err value is computed lazily.
    pub fn ok_or_else<E>(self: Option<T>, err: fn() -> E) -> Result<T, E> {
        match self {
            Option::Some(v) => { return Result::Ok(v); }
            Option::None    => { return Result::Err(err()); }
        }
    }

    // Returns None if self is None, otherwise returns `optb`.
    pub fn and<U>(self: Option<T>, optb: Option<U>) -> Option<U> {
        match self {
            Option::Some(_) => { return optb; }
            Option::None    => { return Option::None; }
        }
    }

    // Returns None if the option is None, otherwise calls f with the wrapped
    // value and returns the result.
    pub fn and_then<U>(self: Option<T>, f: fn(T) -> Option<U>) -> Option<U> {
        match self {
            Option::Some(v) => { return f(v); }
            Option::None    => { return Option::None; }
        }
    }

    // True iff Some and the predicate accepts the wrapped value.
    pub fn is_some_and(self: Option<T>, pred: fn(T) -> bool) -> bool {
        match self {
            Option::Some(v) => { return pred(v); }
            Option::None    => { return false; }
        }
    }

    // Returns self if it contains a value, otherwise returns `other`.
    pub fn or(self: Option<T>, other: Option<T>) -> Option<T> {
        match self {
            Option::Some(v) => { return Option::Some(v); }
            Option::None    => { return other; }
        }
    }

    // Returns self if it contains a value, otherwise calls f and returns the result.
    pub fn or_else(self: Option<T>, f: fn() -> Option<T>) -> Option<T> {
        match self {
            Option::Some(v) => { return Option::Some(v); }
            Option::None    => { return f(); }
        }
    }

    // Takes the value out of the option, leaving a `None` in its place.
    // SL-sl-03 (mutating &mut self surface).
    pub fn take(self: &mut Option<T>) -> Option<T> {
        // Exactly Rust's `mem::replace(self, None)`. We can't `match self {
        // Some(v) => Some(v) }`: under RFC 2005 ergonomics `v` binds `&mut T`,
        // building `Option<&mut T>`. `replace_ref` (= `core::mem::replace`,
        // `_ref` suffix disambiguates from `ptr::replace` until T2-28-qualified
        // calls; the cross-generic-mono gap that once blocked this is fixed).
        return replace_ref(self, Option::None);
    }

    // Replaces the actual value in the option with the value given in
    // parameter, returning the old value if present.
    pub fn replace(self: &mut Option<T>, value: T) -> Option<T> {
        // Exactly Rust's `mem::replace(self, Some(value))`.
        return replace_ref(self, Option::Some(value));
    }

    // Converts `&Option<T>` → `Option<&T>`. Unsafe because the body uses
    // raw-pointer arithmetic to lift a `&T` out of the Some payload —
    // Logos's `ref v` binding inside `Option::Some(ref v)` doesn't yet
    // produce a payload-typed reference through variant-data patterns.
    pub fn as_ref(self: &Option<T>) -> Option<&T> {
        match self {
            Option::Some(ref v) => { return Option::Some(v); }
            Option::None        => { return Option::None; }
        }
    }

    // Converts `&mut Option<T>` → `Option<&mut T>`. Symmetric to as_ref.
    pub fn as_mut(self: &mut Option<T>) -> Option<&mut T> {
        match self {
            Option::Some(ref mut v) => { return Option::Some(v); }
            Option::None            => { return Option::None; }
        }
    }

    // Returns Some iff exactly one of `self` and `other` is Some.
    pub fn xor(self: Option<T>, other: Option<T>) -> Option<T> {
        match self {
            Option::Some(a) => {
                match other {
                    Option::Some(_) => { return Option::None; }
                    Option::None    => { return Option::Some(a); }
                }
            }
            Option::None => {
                match other {
                    Option::Some(b) => { return Option::Some(b); }
                    Option::None    => { return Option::None; }
                }
            }
        }
    }

    // Returns Some(v) if self is Some(v) and `pred(v)` is true,
    // else None. Mirrors Rust's `Option::filter`.
    pub fn filter(self: Option<T>, pred: fn(T) -> bool) -> Option<T> {
        match self {
            Option::None    => { return Option::None; }
            Option::Some(v) => {
                unsafe {
                    let v_copy: T = *((&v) as *const T);
                    if pred(v_copy) { return Option::Some(v); }
                    return Option::None;
                }
            }
        }
    }
}

// Option::unzip — inverse of zip. Free fn rather than method because
// Logos doesn't yet support partial-spec INHERENT impl blocks on
// nested generic shapes like `impl<A, B> Option<(A, B)>`. The cascade
// that previously broke this signature is now closed by sema's
// turbofish-on-enum-lit fix (sema_expr.cpp:8660+ — explicit
// `Option::<A>::None` now picks up A from the turbofish instead of
// falling through to `error_t()` at the type-args build site) plus
// mono's Phase 1 `contains_typevar` gate.
pub fn option_unzip<A, B>(opt: Option<(A, B)>) -> (Option<A>, Option<B>) {
    match opt {
        Option::None => {
            return (Option::<A>::None, Option::<B>::None);
        }
        Option::Some(t) => {
            return (Option::<A>::Some(t.0), Option::<B>::Some(t.1));
        }
    }
}

// Option::zip — combines two Options into Option<(T, U)>.
// Returns Some((t, u)) iff both are Some; else None. Free fn
// rather than method because the U tparam isn't on the impl side.
pub fn option_zip<T, U>(a: Option<T>, b: Option<U>) -> Option<(T, U)> {
    match a {
        Option::None    => { return Option::None; }
        Option::Some(t) => {
            match b {
                Option::None    => { return Option::None; }
                Option::Some(u) => { return Option::Some((t, u)); }
            }
        }
    }
}

// `opt.unwrap_or(T::default())` analogue. Free fn form sidesteps the
// `impl<T> Option<T> { fn unwrap_or_default() where T: Default }` shape
// where `T::default()` doesn't resolve from the impl-T context in Logos
// (the `where T: Default` clause on an inherent impl method doesn't yet
// bind T to the trait for trait-static dispatch on T).
pub fn option_unwrap_or_default<T: Default>(opt: Option<T>) -> T {
    match opt {
        Option::Some(v) => { return v; }
        Option::None    => { return T::default(); }
    }
}

// Default for Option<T> is None — independent of T. Mirrors Rust's
// `impl<T> Default for Option<T>`.
impl<T> Default for Option<T> {
    fn default() -> Option<T> { return Option::<T>::None; }
}

// Flatten a doubly-wrapped Option<Option<T>> into Option<T>.
pub fn option_flatten<T>(opt: Option<Option<T>>) -> Option<T> {
    match opt {
        Option::Some(inner) => { return inner; }
        Option::None        => { return Option::None; }
    }
}

// ── Inherent partial-spec impls — Rust-shape method syntax ──────────────
//
// Mirror Rust's `Option::<Option<T>>::flatten` etc. Sema partial-spec
// inherent impl on nested generic shapes now works after the
// turbofish-on-enum-lit fix + mono Phase 1 contains_typevar gate.

impl<T> Option<Option<T>> {
    pub fn flatten(self: Option<Option<T>>) -> Option<T> {
        match self {
            Option::Some(inner) => { return inner; }
            Option::None        => { return Option::None; }
        }
    }
}

impl<A, B> Option<(A, B)> {
    pub fn unzip(self: Option<(A, B)>) -> (Option<A>, Option<B>) {
        match self {
            Option::None => {
                return (Option::<A>::None, Option::<B>::None);
            }
            Option::Some(t) => {
                return (Option::<A>::Some(t.0), Option::<B>::Some(t.1));
            }
        }
    }
}

// `Option::<Result<T, E>>::transpose() -> Result<Option<T>, E>`
impl<T, E> Option<Result<T, E>> {
    pub fn transpose(self: Option<Result<T, E>>) -> Result<Option<T>, E> {
        match self {
            Option::None    => { return Result::<Option<T>, E>::Ok(Option::<T>::None); }
            Option::Some(r) => {
                match r {
                    Result::Ok(v)  => { return Result::<Option<T>, E>::Ok(Option::<T>::Some(v)); }
                    Result::Err(e) => { return Result::<Option<T>, E>::Err(e); }
                }
            }
        }
    }
}

// Free-function shims for compat with pre-existing call-sites in stdlib
// and earlier Logos tests. New code should prefer the method form.
pub fn unwrap_or_i32(opt: Option<i32>, def: i32) -> i32 {
    return opt.unwrap_or(def);
}

pub fn is_some_i32(opt: Option<i32>) -> bool {
    return opt.is_some();
}
