// Logos standard library — std.mem
//
// Memory allocation and low-level memory utilities.

package logos.lang.mem;

use logos.lang.default;

extern fn malloc(size: i64) -> *mut u8;
extern fn free(ptr: *mut u8);
extern fn realloc(ptr: *mut u8, size: i64) -> *mut u8;
extern fn memcpy(dst: *mut u8, src: *const u8, n: i64) -> *mut u8;
extern fn memmove(dst: *mut u8, src: *const u8, n: i64) -> *mut u8;
extern fn memset(ptr: *mut u8, val: i32, n: i64) -> *mut u8;
extern fn memcmp(a: *const u8, b: *const u8, n: i64) -> i32;

/// Allocates `size` bytes of uninitialized memory. Returns null on allocation failure.
pub fn alloc(size: i64) -> *mut u8 {
    unsafe { return malloc(size); }
}

/// Frees memory previously returned by `alloc` or `realloc_buf`. Null is a no-op.
pub fn dealloc(ptr: *mut u8) {
    unsafe { free(ptr); }
}

/// Resizes the allocation at `ptr` to `size` bytes, moving it if necessary.
/// Returns the new pointer; on failure returns null and leaves the original allocation intact.
pub fn realloc_buf(ptr: *mut u8, size: i64) -> *mut u8 {
    unsafe { return realloc(ptr, size); }
}

/// Copies `n` bytes from `src` to `dst`; regions must not overlap (use `move_bytes` if they may).
pub unsafe fn copy_bytes(dst: *mut u8, src: *const u8, n: i64) {
    memcpy(dst, src, n);
}

/// Copies `n` bytes from `src` to `dst`; safe for overlapping regions.
pub unsafe fn move_bytes(dst: *mut u8, src: *const u8, n: i64) {
    memmove(dst, src, n);
}

/// Fills `n` bytes starting at `ptr` with `val` (low 8 bits used).
pub unsafe fn fill_bytes(ptr: *mut u8, val: i32, n: i64) {
    memset(ptr, val, n);
}

/// Zeroes `n` bytes starting at `ptr`.
pub unsafe fn zero_bytes(ptr: *mut u8, n: i64) {
    memset(ptr, 0, n);
}

/// Compares `n` bytes at `a` and `b`; returns negative, zero, or positive (as `memcmp`).
pub unsafe fn compare_bytes(a: *const u8, b: *const u8, n: i64) -> i32 {
    return memcmp(a, b, n);
}

/// Swaps the values at two non-overlapping pointers of the same type.
pub unsafe fn swap<T>(a: *mut T, b: *mut T) {
    let tmp: T = a[0];
    a[0] = b[0];
    b[0] = tmp;
}

/// Replaces the value at `ptr` with `new_val`, returning the old value.
pub unsafe fn replace<T>(ptr: *mut T, new_val: T) -> T {
    let old: T = ptr[0];
    ptr[0] = new_val;
    return old;
}

/// Replaces the value at `ptr` with `T::default()`, returning the old value.
/// Useful for moving ownership out of a container field without a partial-move borrowck error.
pub unsafe fn take<T: Default>(ptr: *mut T) -> T {
    let old: T = ptr[0];
    ptr[0] = T::default();
    return old;
}

// ── Safe ref-based variants (mirror `core::mem::{swap, replace, take}`) ──
//
// These match Rust's API shape: callers pass exclusive references rather
// than raw pointers, so the borrow checker enforces the non-aliasing
// invariant that the raw-pointer forms above leave to the caller. The
// body still goes through raw pointers because Logos's move/copy rules
// don't yet allow the natural `std::mem::swap` body `let tmp = *a; *a =
// *b; *b = tmp;` without flagging it as a move-of-borrowed; the unsafe
// block is an implementation detail that doesn't leak to callers.

/// Swaps the values behind two exclusive references.
pub fn swap_ref<T>(a: &mut T, b: &mut T) {
    unsafe {
        let pa = a as *mut T;
        let pb = b as *mut T;
        let tmp: T = pa[0];
        pa[0] = pb[0];
        pb[0] = tmp;
    }
}

/// Moves `src` into `dst`, returning the previous value at `dst`.
pub fn replace_ref<T>(dst: &mut T, src: T) -> T {
    unsafe {
        let p = dst as *mut T;
        let old: T = p[0];
        p[0] = src;
        return old;
    }
}

/// Moves the value out of `dst`, replacing it with `T::default()`.
pub fn take_ref<T: Default>(dst: &mut T) -> T {
    unsafe {
        let p = dst as *mut T;
        let old: T = p[0];
        p[0] = T::default();
        return old;
    }
}
