// Logos Writ stdlib — writ.typed_value
//
// WTypedValue — a Writ SDN datatype instantiation, wire code 4115 (the Writ
// port of the legacy TypedValue). Canonical textual form:
//
//     @Type(params?) = <initializer>
//
// Three AT-REST WAny words: the type-name (a Ref to an interned WString), the
// params (an Array<WAny> or null), and the initializer value. Like WMapEntry the
// words are held as raw `i64` and accessed through `*zoned mut WAny` slot pointers,
// so each read materialises the at-rest Ref-delta → absolute and each write lowers
// it — no distinct WAnyRel, no ha_* helpers.

package logos.lang.writ.typed_value;

use logos.lang.writ.container;   // Writ, alloc_tagged, W_TYPEDVALUE
use logos.lang.writ.anyval;      // WAny, w_type_code
use logos.lang.writ.allocator;   // Allocator
use logos.lang.cell;
use logos.lang.writ.wstring;     // WString, wstring_in_alloc
use logos.lang.ptr;                 // byte_add
use logos.lang.panic;               // panic — a wrong-type resolve is a type violation

/// A Writ SDN datatype instantiation `@Type(params?) = <initializer>`, wire code 4115.
/// Holds three at-rest `WAny` words as raw `i64`; read/write goes through `*zoned` slot
/// pointers, so reads materialise the Ref-delta and writes lower it.
#[pinned]
pub struct WTypedValue {
    /// At-rest `WAny` word: `Ref` to the interned type-name `WString`.
    pub type_name: i64,   // at-rest WAny: Ref to the type-name WString
    /// At-rest `WAny` word: the params (`Array<WAny>` or null).
    pub params:    i64,   // at-rest WAny: params (Array<WAny> or null)
    /// At-rest `WAny` word: the initializer value.
    pub init:      i64,   // at-rest WAny: the initializer value
}

// Field slot (type_name @0, params @8, init @16) as `*zoned mut WAny` — each read
// materialises the at-rest word, each write lowers it (mirrors WMap's ent_key/_val).
unsafe fn tv_slot(p: *mut WTypedValue, off: i64) -> *zoned mut WAny {
    return (p as *mut u8).byte_add(off) as *zoned mut WAny;
}
unsafe fn tv_slot_c(p: *const WTypedValue, off: i64) -> *zoned WAny {
    return (p as *const u8).byte_add(off) as *zoned WAny;
}

unsafe fn tv_new(h: *mut Writ, type_name: WAny, params: WAny, init: WAny) -> *mut WTypedValue {
    let obj: *mut WTypedValue =
        alloc_tagged(h.allocator.get(), sizeof::<WTypedValue>() as i64, W_TYPEDVALUE) as *mut WTypedValue;
    *(tv_slot(obj, 0i64))  = type_name;   // *zoned write: lowers to a self-relative delta
    *(tv_slot(obj, 8i64))  = params;
    *(tv_slot(obj, 16i64)) = init;
    return obj;
}

impl WTypedValue {
    /// Returns the type-name value (a `Ref` to a `WString`).
    pub fn type_name(self: &WTypedValue) -> WAny { return unsafe { *(tv_slot_c(self as *const WTypedValue, 0i64)) }; }
    /// Returns the params value (`Array<WAny>` or null).
    pub fn params(self: &WTypedValue)    -> WAny { return unsafe { *(tv_slot_c(self as *const WTypedValue, 8i64)) }; }
    /// Returns the initializer value.
    pub fn init(self: &WTypedValue)      -> WAny { return unsafe { *(tv_slot_c(self as *const WTypedValue, 16i64)) }; }

    /// Returns the type name as a string view (resolves the `Ref` to the interned `WString`).
    pub fn type_name_str(self: &WTypedValue) -> str {
        return unsafe { (&*(self.type_name().resolve() as *const WString)).as_str() };
    }
    /// Returns `true` if params are present (non-null).
    pub fn has_params(self: &WTypedValue) -> bool { return !self.params().is_null(); }
}

impl Writ {
    /// Builds a typed value `@type_name(params?) = init` in this arena, returning a `Ref` to it.
    /// The type name is interned as a `WString`; pass a null `WAny` for `params` when none.
    pub fn typed_value(self: &Writ, type_name: str, params: WAny, init: WAny) -> WAny {
        unsafe {
            let h: *mut Writ = self as *const Writ as *mut Writ;
            let hs: *mut WString = wstring_in_alloc(h.allocator.get(), type_name);
            let tn: WAny = WAny::ref_to(hs as *const u8);
            return WAny::ref_to(tv_new(h, tn, params, init) as *const u8);
        }
    }
}

impl WAny {
    /// Returns `true` if this value is a `Ref` to a `WTypedValue`.
    pub fn is_typed_value(self: &WAny) -> bool {
        return self.is_ref() && unsafe { w_type_code(self.resolve()) } == W_TYPEDVALUE;
    }
    /// Borrows the pointed-at typed value; call `is_typed_value` first.
    /// PANICS if this is not a Ref to a `W_TYPEDVALUE` object (resolver-guard class — see
    /// the note at the top of `writ/array.logos`).
    pub fn as_typed_value(self: &WAny) -> &WTypedValue {
        if !self.is_typed_value() { panic("WAny::as_typed_value: the WAny is not a Ref to a W_TYPEDVALUE object — check is_typed_value() first"); }
        return unsafe { &*(self.resolve() as *const WTypedValue) };
    }
    /// Creates a heterogeneous value holding a `Ref` to `tv`.
    pub fn from(tv: &WTypedValue) -> WAny { return WAny::ref_to(tv as *const WTypedValue as *const u8); }
}
