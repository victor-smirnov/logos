// Logos Writ stdlib — writ.wstring
//
// WString — a UTF-8 string living in the never-move arena as a REAL custom-DST
// with NO separate length field: the layout is exactly WritString's wire shape,
//
//     [ vlen(payload_len) ][ UTF-8 payload ... ]
//
// i.e. a `#[self_describing]` DST whose ONLY member is the `[u8]` tail; the length
// is encoded IN-BAND as a variable-length integer at the front of the bytes (1 byte
// for strings < 249). `dst_len` (the tail's total byte count = whole object, since
// there is no sized prefix) is `vlen_prefix_size + vlen_read`; the logical string
// length is `vlen_read` (the payload only).
//
// Access is SAFE through `&WString` (the DST is self-describing → a borrowed
// reference is complete): `len()` / `as_str()` need no `unsafe` at call sites.
// `as_str` skips the vlen prefix and borrows the inline payload back as a `str`
// (a slice into the arena, valid while the container lives).

package logos.lang.writ.wstring;

use logos.lang.writ.container;   // Writ, writ_alloc_bytes
use logos.lang.writ.allocator;   // Allocator, allocator_alloc
use logos.lang.cell;
use logos.lang.writ.anyval;      // WAny (heterogeneous element)
use logos.lang.str;                 // str_from_raw
use logos.lang.mem;                 // copy_bytes
use logos.lang.ptr;                 // byte_add
use logos.lang.vlen;                // vlen_encode_size / write / read / prefix_size
use logos.lang.panic;               // panic — a wrong-type resolve is a type violation

/// UTF-8 string interned in the never-move arena as a self-describing custom DST.
/// Layout is exactly the wire shape `[vlen(payload_len)][UTF-8 payload]` — the length is
/// encoded in-band, no sized prefix. Borrow as `&WString`; read back with `as_str`.
#[self_describing]
pub struct WString {
    /// The whole tail: vlen length prefix followed by the UTF-8 payload.
    pub bytes: [u8],        // [vlen(payload_len)][utf8 payload] — no sized prefix
}

// Tail byte count (for slice materialization) = the WHOLE object: the vlen prefix
// plus the payload it encodes. (No sized header — `self` points at the bytes.)
impl SelfDescribing for WString {
    fn dst_len(self: *const WString) -> i64 {
        let p: *const u8 = self as *const u8;
        return unsafe { (vlen_prefix_size(p) as i64) + (vlen_read(p) as i64) };
    }
}

/// Interns `s` through a raw `Allocator`: allocates `vlen_encode_size(n) + n` bytes in
/// one arena chunk, writes the vlen length prefix, then copies the payload after it.
/// Taking `*mut Allocator` (not the whole `Writ`) lets a container that holds only its
/// allocator back-pointer — e.g. `WArray<WAny>` — intern strings without the full handle.
pub unsafe fn wstring_in_alloc(alloc: *mut Allocator, s: str) -> *mut WString {
    let n: u64 = s.len() as u64;
    let total: i64 = (vlen_encode_size(n) as i64) + (n as i64);
    let raw: *mut u8 = alloc_tagged(alloc, total, W_STRING);   // in-band Ref tag
    let pfx: u32 = vlen_write(raw, n);
    copy_bytes(raw.byte_add(pfx as i64), s.as_ptr(), n as i64);
    return raw as *mut WString;
}

unsafe fn wstring_new(h: *mut Writ, s: str) -> *mut WString {
    return wstring_in_alloc(h.allocator.get(), s);
}

impl Writ {
    /// Interns `s` into the arena; returns a borrowed `&WString` into never-move storage,
    /// valid for the container's lifetime. Read it back with `as_str`.
    pub fn wstring<'a>(self: &'a Writ, s: str) -> &'a WString {
        unsafe {
            let h: *mut Writ = self as *const Writ as *mut Writ;
            return &*wstring_new(h, s);
        }
    }
    /// Resolves a Ref `WAny` back to the `WString` it points at.
    /// PANICS if `e` is not a Ref to a `W_STRING` object — the reference is a DST whose
    /// length is decoded out of the pointee, so a wrong type invents the length too.
    /// (Resolver-guard class: see the note at the top of `writ/array.logos`.)
    pub fn wstring_of<'a>(self: &'a Writ, e: WAny) -> &'a WString {
        if !e.is_string() { panic("Writ::wstring_of: the WAny is not a Ref to a W_STRING object — check is_string() first"); }
        return unsafe { &*(e.resolve() as *const WString) };
    }
}

impl WString {
    /// Returns the logical string length in bytes — the vlen-decoded payload count.
    /// NOT `dst_len`, which is the whole tail including the vlen prefix (`self.bytes`
    /// materializes the tail; its data pointer is the vlen prefix).
    pub fn len(self: &WString) -> i64 {
        return unsafe { vlen_read(self.bytes.as_ptr()) as i64 };
    }

    /// Returns the inline UTF-8 payload — the tail past its vlen prefix.
    /// The `str` borrows arena storage and stays valid while the container lives.
    pub fn as_str(self: &WString) -> str {
        unsafe {
            let p: *const u8 = self.bytes.as_ptr();
            let payload: u64 = vlen_read(p);
            let body: *const u8 = p.byte_add(vlen_prefix_size(p) as i64);
            return str_from_raw(body, payload as i64);
        }
    }
}

impl WAny {
    /// Wraps an interned string as a heterogeneous `WAny` — a Ref to its header.
    pub fn from(s: &WString) -> WAny { return WAny::ref_to(s as *const WString as *const u8); }

    /// Resolves a Ref `WAny` to a borrowed `&WString` (read-only); check `is_string()` first.
    /// Encapsulates the `resolve()`+cast so callers stay `unsafe`-free.
    /// PANICS if this is not a Ref to a `W_STRING` object. (`as_wstr` below is the
    /// null-safe VALUE form and keeps its ADR-0011 empty-str default instead.)
    pub fn as_string(self: &WAny) -> &WString {
        if !self.is_string() { panic("WAny::as_string: the WAny is not a Ref to a W_STRING object — check is_string() first"); }
        return unsafe { &*(self.resolve() as *const WString) };
    }

    /// Returns a null-safe `str` view of a `WAny` holding an interned `WString`.
    /// Null, inline Pod, and non-string Ref values (guard: `!is_string()`) all yield
    /// the empty `str` — the same default as an absent schema key.
    // ADR 0011 — null-safe str view of a WAny holding an interned WString. A
    // null/absent WAny (e.g. a schema field whose key isn't present) → empty str.
    // Used by the schema field-read sugar for `str`-typed fields. The guard is
    // `!is_string()` (NOT merely `!is_null()`): a present-but-wrong-type WAny — an
    // inline Pod (e.g. an i56) or a Ref to a non-string object — must NOT have its
    // word reinterpreted as a `*WString` (that dereferences a wild pointer → SIGSEGV
    // for a Pod). Same absent-key default (empty str) covers null, Pod, and wrong-Ref.
    pub fn as_wstr(self: &WAny) -> str {
        if !self.is_string() { return str_from_raw(0i64 as *const u8, 0i64); }
        return unsafe { (&*(self.resolve() as *const WString)).as_str() };
    }
}
