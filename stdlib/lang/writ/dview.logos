// logos.lang.writ.dview — DView: a non-owning, type-erased Writ value view.
//
// DView is the Rust-`&dyn` of Writ: it borrows a concrete value's bytes and
// carries its Writ type tag, so the value can take part in tag-dispatch
// (compare / equality / stringify / hash …) WITHOUT owning or allocating. It
// does NOT extend lifetimes — when you need to own a runtime-typed value, use
// the Writ container (`HAny` + arena). "Ord" is just one of DView's
// capabilities, hence the neutral name.
//
// Unification with HAny: the per-type BEHAVIOUR (the machinery) lives in a
// single tag-keyed capability layer (`htag_*` below) — the same type_code-
// dispatch idiom as `equal()`. DView and HAny are two ADAPTERS over that layer:
// each maps its own memory layout to `(tag, object-bytes)` and calls in. DView's
// layout (tag/obj in fields) makes its adapters trivial; HAny's adapter (future)
// normalises niche/Ref/addr-1 — its only friction is a Pod value's inline bits
// having no address (spill to a scratch before calling the layer).

package logos.lang.writ.dview;

use logos.lang.cmp;                 // Ordering
use logos.lang.clone;              // Copy
use logos.lang.option;
use logos.lang.str;                // str_from_raw (String materialization)
use logos.lang.fabric;             // Datatype / Container / ContainerOrd / PrimVec / Storage
use logos.lang.writ.anyval;      // H2_U64 / H2_I64 / HA_BOOL / H2_STRING type codes

// ── tag layout: (space, code) ────────────────────────────────────────────────
// DView.tag is u64 but a Writ in-band datatag only carries ≤56 bits (the
// 8-byte pre-object slot = 1 header byte + ≤7 code bytes). The spare HIGH 8 bits
// are a CODE-SPACE selector: the low 56 bits are a code WITHIN that space.
//   space 0 (Writ) — code = the Writ datatag (storage format). High bits 0
//     means a raw Writ tag IS already a valid DView.tag (a compactified
//     single-segment Writ copies in with its tag untouched).
//   space 1 (Logos)  — code = the captured Logos type (a processing format,
//     e.g. heap String / str), a DIFFERENT code space; the dispatcher for that
//     space knows how to compare and how to convert to the storage format on
//     store_push.
pub const DV_CODE_MASK:    u64 = 0x00FFFFFFFFFFFFFFu64;   // low 56 bits
pub const DV_SPACE_HERMES: u8  = 0u8;
pub const DV_SPACE_LOGOS:  u8  = 1u8;

pub fn dv_space(tag: u64) -> u8  { return (tag >> 56u64) as u8; }
pub fn dv_code(tag: u64)  -> u64 { return tag & DV_CODE_MASK; }
pub fn dv_make_tag(space: u8, code: u64) -> u64 {
    return ((space as u64) << 56u64) | (code & DV_CODE_MASK);
}

// ── Datum — a type that can present itself as a DView (the capture seam) ──────
// "Where the type is declared, its Datum impl lives": the capture→storage
// conversion lives in the type's OWN tier (mem's String, std's types), since
// every tier depends DOWN on lang and so sees Datum/DView — while lang can't
// reach UP. So the "conversion matrix" is the set of impls, distributed by tier,
// not a central switch.
//   datum_tag — the type-level tag (phantom-`self`, the assoc-fn-on-type-param
//     mono-gap workaround); used by is_a/try_to/to + the default as_datum.
//   as_datum  — turn an instance into its STORAGE-form DView. The DEFAULT
//     captures a sized POD BY VALUE (its bytes + tag) — correct when the storage
//     form IS the in-memory bytes. Types whose storage form differs (str/String
//     → the content bytes, not the {ptr,len}/struct) OVERRIDE it.
pub trait Datum {
    fn datum_tag(self: *const Self) -> u64;
    fn datum_meta(&self) -> u64 { return 0u64; }
    fn as_datum(&self) -> DView {
        let phantom: *const Self = 0 as *const Self;
        return DView::from_parts(
            self as *const Self as *const u8,
            sizeof::<Self>() as u64,
            unsafe { phantom.datum_tag() },
            self.datum_meta());
    }
    // READ (inverse of as_datum): materialize Self from a storage DView. The
    // DEFAULT reads a sized POD by value (the storage bytes ARE Self); types
    // whose storage form ≠ Self (String → an OWNED heap copy of the content
    // bytes) override it. Phantom `self` (never read) sidesteps the
    // assoc-fn-on-type-param mono gap, like datum_tag.
    fn from_datum(self: *const Self, d: DView) -> Self {
        return unsafe { *(d.obj_ptr() as *const Self) };
    }
}
impl Datum for i64  { fn datum_tag(self: *const i64)  -> u64 { return H2_I64; } }
impl Datum for u64  { fn datum_tag(self: *const u64)  -> u64 { return H2_U64; } }
impl Datum for bool { fn datum_tag(self: *const bool) -> u64 { return HA_BOOL as u64; } }

// ── DView — the borrowed, type-erased view ──────────────────────────────────
// `tag` and `len` are u64 — the native Writ widths (type codes are u64).
pub struct DView {
    obj:  *const u8,     // → object bytes (borrowed; not owned)
    len:  u64,           // object byte length
    tag:  u64,           // Writ type tag
    meta: u64,           // packed per-value metadata (e.g. Decimal {P,S}); 0 if none
}

// A view is a small Copy handle (pointer + 3 words) — passed by value as a key
// query and threaded through the tree.
impl Copy for DView {}

impl DView {
    // Type-erase a concrete value into a non-owning view (borrows `v`) by asking
    // the type to present its storage form. T inferred (`DView::from(&v)`).
    pub static fn from<T: Datum>(v: &T) -> DView {
        return v.as_datum();
    }

    // Explicit-zones constructor (for in-container views: a stored object + tag).
    pub static fn from_parts(obj: *const u8, len: u64, tag: u64, meta: u64) -> DView {
        return DView { obj: obj, len: len, tag: tag, meta: meta };
    }

    // Type-erase a string (datatype String, code H2_STRING). str is unsized (a
    // {ptr,len} fat value), so it can't ride the generic `from<T>` (which assumes
    // a sized T + thin ptr); dedicated. The block IS the UTF-8 bytes — directly
    // the Writ String content, so it stays the Writ space.
    pub static fn from_str(s: str) -> DView {
        return DView { obj: s.as_ptr(), len: s.len() as u64, tag: H2_STRING, meta: 0u64 };
    }

    // Materialize a string from the view's bytes (str over obj/len). Borrows the
    // same bytes the view does (valid for the view's lifetime).
    pub fn as_str(&self) -> str {
        return unsafe { str_from_raw(self.obj, self.len as i64) };
    }

    pub fn type_code(&self) -> u64 { return self.tag; }
    pub fn obj_ptr(&self) -> *const u8 { return self.obj; }
    pub fn obj_len(&self) -> u64 { return self.len; }
    pub fn meta_word(&self) -> u64 { return self.meta; }

    // ── capabilities ────────────────────────────────────────────────────────
    // generic / concrete-typed (`is`/`as` are reserved keywords → is_a/try_to):
    pub fn is_a<T: Datum>(&self) -> bool {
        let phantom: *const T = 0 as *const T;
        return self.tag == unsafe { phantom.datum_tag() };
    }
    pub fn try_to<T: Datum>(&self) -> Option<T> { // checked materialize
        let phantom: *const T = 0 as *const T;
        if self.tag != unsafe { phantom.datum_tag() } { return Option::None; }
        return Option::Some(unsafe { phantom.from_datum(*self) });
    }
    pub fn to<T: Datum>(&self) -> T {              // asserted materialize
        let phantom: *const T = 0 as *const T;
        return unsafe { phantom.from_datum(*self) };
    }
    // runtime-dispatched (over self.tag, via the shared layer):
    pub fn compare(&self, other: &DView) -> Ordering {
        return unsafe { htag_cmp(self.tag, self.meta, self.obj, self.len, other.obj, other.len) };
    }
}

// ── shared tag-keyed capability layer (HAny will route here too) ─────────────
// Each capability is one tag-dispatch. New comparable datatype = one arm here
// (+ a Datum impl). Reads object bytes via LE assembly — works at any
// (possibly unaligned) borrowed offset.

unsafe fn load_le(p: *const u8, n: u64) -> u64 {
    let mut v: u64 = 0u64;
    let mut i: u64 = 0u64;
    while i < n {
        v = v | ((*(((p as i64) + (i as i64)) as *const u8) as u64) << (i * 8u64));
        i = i + 1u64;
    }
    return v;
}

// Total order over two same-tagged object-byte runs. Dispatched on (space,
// code): only the Writ space (0) is wired today; other spaces route here once
// their comparators land.
pub unsafe fn htag_cmp(tag: u64, meta: u64, a: *const u8, alen: u64, b: *const u8, blen: u64) -> Ordering {
    let code: u64 = dv_code(tag);
    if dv_space(tag) == DV_SPACE_HERMES && code == H2_I64 {
        let x: i64 = load_le(a, alen) as i64;
        let y: i64 = load_le(b, blen) as i64;
        if x < y { return Ordering::Less; }
        if x > y { return Ordering::Greater; }
        return Ordering::Equal;
    }
    if dv_space(tag) == DV_SPACE_HERMES && code == H2_STRING {
        // lexicographic byte compare; shorter is less on a common prefix.
        let n: u64 = if alen < blen { alen } else { blen };
        let mut i: u64 = 0u64;
        while i < n {
            let x: u8 = *(((a as i64) + (i as i64)) as *const u8);
            let y: u8 = *(((b as i64) + (i as i64)) as *const u8);
            if x < y { return Ordering::Less; }
            if x > y { return Ordering::Greater; }
            i = i + 1u64;
        }
        if alen < blen { return Ordering::Less; }
        if alen > blen { return Ordering::Greater; }
        return Ordering::Equal;
    }
    // default (u64 / bool / any unsigned-comparable tag): unsigned bytes.
    let x: u64 = load_le(a, alen);
    let y: u64 = load_le(b, blen);
    if x < y { return Ordering::Less; }
    if x > y { return Ordering::Greater; }
    return Ordering::Equal;
}

// Object byte stride for a tag (for the at-rest / store path). 0 = unknown.
pub fn htag_size(tag: u64, meta: u64) -> u64 {
    if dv_space(tag) == DV_SPACE_HERMES {
        let code: u64 = dv_code(tag);
        if code == H2_I64       { return 8u64; }
        if code == H2_U64       { return 8u64; }
        if code == HA_BOOL as u64 { return 1u64; }
    }
    return 0u64;
}

// Required alignment of a tag's object bytes (a power of two). The Buffer aligns
// every element's entry to this so in-place reads (`to::<T>` pointer-casts, a
// byte-copied compactified Writ object) are valid.
pub fn htag_align(tag: u64, meta: u64) -> u64 {
    if dv_space(tag) == DV_SPACE_HERMES {
        let code: u64 = dv_code(tag);
        if code == H2_I64       { return 8u64; }
        if code == H2_U64       { return 8u64; }
        if code == HA_BOOL as u64 { return 1u64; }
        if code == H2_STRING    { return 1u64; }   // UTF-8 bytes
    }
    return 8u64;   // conservative default (covers ≤8-byte scalars)
}

fn align_up(x: u64, a: u64) -> u64 { return ((x + a - 1u64) / a) * a; }

// ── DViewStore — the variable-width, aligned at-rest store for DView ─────────
// A DView is non-owning; to STORE it (as a B+tree key/value) the buffer owns the
// bytes. Homogeneous: ONE `tag` + `meta` describe the element type (learned from
// the first element). Two arrays: `data` ([u8] arena, base + every entry start
// aligned to align(tag)) and `offsets` ([u64], N+1: offsets[0]=0, offsets[N]=
// first free byte; element i = data[offsets[i] .. offsets[i+1]]). store_get
// returns a DView pointing INTO the arena (no copy → valid until the arena
// reallocs — the in-container borrow contract). Object zone is the variable
// block; `meta` is the separate u64 zone (carried on the store, per the
// homogeneous-container model).
pub struct DViewStore {
    tag:     u64,
    meta:    u64,
    data:    PrimVec<u8>,
    offsets: PrimVec<u64>,
}

// The first element DECLARES the container's runtime type (tag+meta) — a
// homogeneous container. `storage_push`/`insert_at` are the TRUSTED path: they
// declare-on-first and store, no per-element check (callers on a hot path who
// know the type is consistent pay nothing).
unsafe fn dvs_declare(s: *mut DViewStore, v: DView) {
    if (*s).offsets.len == 1u64 {
        (*s).tag = v.tag;
        (*s).meta = v.meta;
    }
}

// Would `v` be consistent with this buffer's declared type? Empty ⇒ yes (it
// would declare it). The CHECKED path (ContainerRef::try_insert) consults this
// to reject a heterogeneous element with a recoverable error instead of
// silently mis-storing — compare/materialize key off the buffer's single tag,
// so a mismatched element would corrupt them.
unsafe fn dvs_accepts(s: *const DViewStore, v: DView) -> bool {
    return (*s).offsets.len == 1u64 || (v.tag == (*s).tag && v.meta == (*s).meta);
}

impl Storage for DViewStore {
    type Elem = DView;
    fn storage_len(s: *const DViewStore) -> u64 { unsafe { return (*s).offsets.len - 1u64; } }
    fn storage_get(s: *const DViewStore, idx: u64) -> DView {
        unsafe {
            let o0: u64 = (*s).offsets.get(idx);
            let o1: u64 = (*s).offsets.get(idx + 1u64);
            let p: *const u8 = (((*s).data.data as i64) + (o0 as i64)) as *const u8;
            return DView::from_parts(p, o1 - o0, (*s).tag, (*s).meta);
        }
    }
}

impl OwningStorage for DViewStore {
    fn storage_drop(s: *mut DViewStore) { unsafe { (*s).data.clear(); (*s).offsets.clear(); } }
}

impl DynamicStorage for DViewStore {
    fn storage_new() -> DViewStore {
        let mut st: DViewStore = DViewStore {
            tag: 0u64, meta: 0u64,
            data: PrimVec::<u8>::empty(), offsets: PrimVec::<u64>::empty(),
        };
        st.offsets.push(0u64);   // offsets[0] = 0 (empty)
        return st;
    }

    fn storage_push(s: *mut DViewStore, v: DView) {
        unsafe {
            dvs_declare(s, v);
            let stored: u64 = align_up(v.len, htag_align((*s).tag, (*s).meta));
            let mut i: u64 = 0u64;
            while i < v.len  { (*s).data.push(*(((v.obj as i64) + (i as i64)) as *const u8)); i = i + 1u64; }
            while i < stored { (*s).data.push(0u8); i = i + 1u64; }   // zero pad to alignment
            (*s).offsets.push((*s).data.len);
        }
    }

    fn storage_clear(s: *mut DViewStore) {
        unsafe {
            (*s).data.clear(); (*s).offsets.clear(); (*s).offsets.push(0u64);
            (*s).tag = 0u64; (*s).meta = 0u64;
        }
    }

    fn storage_set(s: *mut DViewStore, idx: u64, v: DView) {
        DViewStore::storage_remove_at(s, idx);
        DViewStore::storage_insert_at(s, idx, v);
    }

    fn storage_insert_at(s: *mut DViewStore, idx: u64, v: DView) {
        unsafe {
            dvs_declare(s, v);
            let stored: u64 = align_up(v.len, htag_align((*s).tag, (*s).meta));
            let start: u64 = (*s).offsets.get(idx);
            let mut k: u64 = 0u64;
            while k < stored { (*s).data.insert_at(start, 0u8); k = k + 1u64; }   // open a gap
            k = 0u64;
            while k < v.len { (*s).data.set(start + k, *(((v.obj as i64) + (k as i64)) as *const u8)); k = k + 1u64; }
            let mut j: u64 = idx + 1u64;
            while j < (*s).offsets.len { (*s).offsets.set(j, (*s).offsets.get(j) + stored); j = j + 1u64; }
            (*s).offsets.insert_at(idx + 1u64, start + stored);
        }
    }

    fn storage_remove_at(s: *mut DViewStore, idx: u64) {
        unsafe {
            let start: u64 = (*s).offsets.get(idx);
            let sz: u64 = (*s).offsets.get(idx + 1u64) - start;
            let mut k: u64 = 0u64;
            while k < sz { (*s).data.remove_at(start); k = k + 1u64; }
            (*s).offsets.remove_at(idx + 1u64);
            let mut j: u64 = idx + 1u64;
            while j < (*s).offsets.len { (*s).offsets.set(j, (*s).offsets.get(j) - sz); j = j + 1u64; }
        }
    }
}

// ── Buffer<DView> — DView as a Container element ─────────────────────────────
impl Datatype for DView {
    type View<S: Storage> = DView;
}

impl Container for DView {
    type Store       = DViewStore;
    type ViewInStore = DView;
    fn new_store() -> DViewStore { return DViewStore::storage_new(); }
    fn drop_store(s: *mut DViewStore) { DViewStore::storage_drop(s); }
    fn store_len(s: *const DViewStore) -> u64 { return DViewStore::storage_len(s); }
    fn store_push(s: *mut DViewStore, v: DView) { DViewStore::storage_push(s, v); }
    fn store_get(s: *const DViewStore, idx: u64) -> DView { return DViewStore::storage_get(s, idx); }
    fn store_set(s: *mut DViewStore, idx: u64, v: DView) { DViewStore::storage_set(s, idx, v); }
    fn store_insert_at(s: *mut DViewStore, idx: u64, v: DView) { DViewStore::storage_insert_at(s, idx, v); }
    fn store_remove_at(s: *mut DViewStore, idx: u64) { DViewStore::storage_remove_at(s, idx); }
    fn store_accepts(s: *const DViewStore, v: DView) -> bool { return unsafe { dvs_accepts(s, v) }; }
}

// Ordered: two stored/queried views compared via the shared tag-keyed layer.
impl ContainerOrd for DView {
    unsafe fn cmp_views(self: *const DView, a: DView, b: DView) -> Ordering {
        return htag_cmp(a.tag, a.meta, a.obj, a.len, b.obj, b.len);
    }
}
