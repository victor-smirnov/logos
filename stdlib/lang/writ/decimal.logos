// Logos Writ stdlib — writ.decimal
//
// WDecimal — a fixed-precision signed decimal (the Writ port of legacy's
// Decimal, wire code 102). The value is `(neg ? -1 : 1) * coeff / 10^scale`, with a
// u64 coefficient magnitude. `spec` packs the legacy layout: scale in bits[0:11]
// (0..4095), sign in bit[31]. Fixed size (no inline tail), so it's a plain tagged
// arena object — no zoning.
//
// [Arbitrary-precision (multi-limb u32 coefficient) Decimals are a custom-DST
//  follow-up — they need the inline variable-length tail that custom-DST provides;
//  deferred. The u64-coefficient form here covers the common case.]

package logos.lang.writ.decimal;

use logos.lang.writ.container;   // Writ, alloc_tagged, W_DECIMAL
use logos.lang.writ.anyval;      // WAny, w_type_code
use logos.lang.writ.allocator;   // Allocator
use logos.lang.cell;
use logos.lang.panic;            // panic — a wrong-type resolve is a type violation

/// Represents a fixed-precision signed decimal `(neg ? -1 : 1) * coeff / 10^scale` (wire code 102).
/// Fixed-size tagged arena object; `scale` is limited to 0..4095 and the coefficient to `u64`.
#[pinned]
pub struct WDecimal {
    /// Packs the scale in bits `[0:11]` (0..4095) and the sign in bit 31 (1 = negative).
    pub spec:  u32,   // scale (bits[0:11]) | sign (bit[31])
    /// Holds the coefficient magnitude, i.e. `|value| * 10^scale`.
    pub coeff: u64,   // coefficient magnitude (value_abs)
}

const DEC_SCALE_MASK: u32 = 0xFFFu32;        // bits[0:11] — scale 0..4095
const DEC_SIGN_BIT:   u32 = 0x80000000u32;   // bit[31] — 1 = negative

unsafe fn decimal_new(h: *mut Writ, coeff: u64, scale: u32, neg: bool) -> *mut WDecimal {
    let obj: *mut WDecimal =
        alloc_tagged(h.allocator.get(), sizeof::<WDecimal>() as i64, W_DECIMAL) as *mut WDecimal;
    let mut spec: u32 = scale & DEC_SCALE_MASK;
    if neg { spec = spec | DEC_SIGN_BIT; }
    obj.spec  = spec;
    obj.coeff = coeff;
    return obj;
}

impl WDecimal {
    /// Returns the decimal scale (number of fractional digits, 0..4095).
    pub fn scale(self: &WDecimal)  -> u32  { return self.spec & DEC_SCALE_MASK; }
    /// Returns `true` if the sign bit is set; may hold for a zero coefficient (`-0`),
    /// which `hdec_cmp`/`hdec_add` treat as non-negative.
    pub fn is_neg(self: &WDecimal) -> bool { return (self.spec & DEC_SIGN_BIT) != 0u32; }
    /// Returns the coefficient magnitude (`|value| * 10^scale`).
    pub fn coeff(self: &WDecimal)  -> u64  { return self.coeff; }
    /// Returns the approximate value as `f64` (`coeff / 10^scale`, signed).
    /// Convenience float view; exact arithmetic stays on the integer `coeff`+`scale`.
    pub fn to_f64(self: &WDecimal) -> f64 {
        let mut d: f64 = self.coeff as f64;
        let mut s: u32 = self.scale();
        while s > 0u32 { d = d / 10.0f64; s = s - 1u32; }
        if self.is_neg() { return 0.0f64 - d; }
        return d;
    }
}

impl Writ {
    /// Builds a `WDecimal` in this arena and returns a Ref `WAny` to it.
    /// Returns a null `WAny` if `scale > 4095` (the `spec` field ceiling).
    pub fn decimal(self: &Writ, coeff: u64, scale: u32, neg: bool) -> WAny {
        if scale > 4095u32 { return WAny::ref_to(0i64 as *const u8); }   // spec field ceiling
        unsafe {
            let h: *mut Writ = self as *const Writ as *mut Writ;
            return WAny::ref_to(decimal_new(h, coeff, scale, neg) as *const u8);
        }
    }
}

impl WAny {
    /// Returns `true` if this is a Ref to a `WDecimal` (tag `W_DECIMAL`).
    pub fn is_decimal(self: &WAny) -> bool {
        return self.is_ref() && unsafe { w_type_code(self.resolve()) } == W_DECIMAL;
    }
    /// Borrows the pointed-at `WDecimal`; the caller must check `is_decimal()` first.
    /// PANICS if this is not a Ref to a `W_DECIMAL` object (resolver-guard class — see
    /// the note at the top of `writ/array.logos`).
    pub fn as_decimal(self: &WAny) -> &WDecimal {
        if !self.is_decimal() { panic("WAny::as_decimal: the WAny is not a Ref to a W_DECIMAL object — check is_decimal() first"); }
        return unsafe { &*(self.resolve() as *const WDecimal) };
    }
    /// Wraps a `WDecimal` as a heterogeneous value (Ref `WAny` to it).
    pub fn from(d: &WDecimal) -> WAny { return WAny::ref_to(d as *const WDecimal as *const u8); }
}

// ── parse / arithmetic / compare (the dec_* surface) ──────────────────────────

/// Parses `"[-]digits[.digits]"` into a decimal in the arena of `h`.
/// Returns a null `WAny` on: empty digits, more than 19 significant digits (u64 overflow
/// guard), a second decimal point, junk bytes, or `scale > 4095`.
pub unsafe fn hdec_from_str(h: &Writ, s: str) -> WAny {
    let n: i64 = s.len();
    let p: *const u8 = s.as_ptr();
    let mut i: i64 = 0;
    let mut neg: bool = false;
    if i < n && *((p as i64 + i) as *const u8) == 45u8 { neg = true; i = i + 1; }
    let mut coeff: u64 = 0u64;
    let mut digits: i64 = 0;
    let mut scale: i64 = 0 - 1;          // -1 = no point seen yet
    while i < n {
        let c: u8 = *((p as i64 + i) as *const u8);
        if c == 46u8 {
            if scale >= 0i64 { return WAny::ref_to(0i64 as *const u8); }
            scale = 0;
            i = i + 1;
            continue;
        }
        if c < 48u8 || c > 57u8 { return WAny::ref_to(0i64 as *const u8); }
        if digits >= 19 { return WAny::ref_to(0i64 as *const u8); }
        coeff = coeff * 10u64 + ((c - 48u8) as u64);
        digits = digits + 1;
        if scale >= 0i64 { scale = scale + 1; }
        i = i + 1;
    }
    if digits == 0 { return WAny::ref_to(0i64 as *const u8); }
    if scale < 0i64 { scale = 0; }
    if scale > 4095 { return WAny::ref_to(0i64 as *const u8); }
    return h.decimal(coeff, scale as u32, neg);
}

/// Compares two decimals by value, ignoring representation (`1.50 == 1.5`): -1 / 0 / 1.
/// Both arguments must satisfy `is_decimal()`; `-0` compares equal to `0`.
pub unsafe fn hdec_cmp(x: WAny, y: WAny) -> i32 {
    let a: &WDecimal = x.as_decimal();
    let b: &WDecimal = y.as_decimal();
    let az: bool = a.coeff() == 0u64;
    let bz: bool = b.coeff() == 0u64;
    if az && bz { return 0; }
    if (a.is_neg() && !az) != (b.is_neg() && !bz) {
        return if a.is_neg() && !az { -1 } else { 1 };
    }
    let mut ca: u64 = a.coeff(); let mut cb: u64 = b.coeff();
    let mut sa: u32 = a.scale(); let mut sb: u32 = b.scale();
    while sa < sb { ca = ca * 10u64; sa = sa + 1u32; }
    while sb < sa { cb = cb * 10u64; sb = sb + 1u32; }
    let mut r: i32 = 0;
    if ca < cb { r = -1; } else if ca > cb { r = 1; }
    if a.is_neg() && !az { r = 0 - r; }
    return r;
}

/// Adds two decimals with scale alignment and sign handling; result carries the larger scale.
/// Both arguments must satisfy `is_decimal()`. Returns a null `WAny` if scale alignment or the
/// sum overflows `u64`.
pub unsafe fn hdec_add(h: &Writ, x: WAny, y: WAny) -> WAny {
    let dx: &WDecimal = x.as_decimal();
    let dy: &WDecimal = y.as_decimal();
    let mut cx: u64 = dx.coeff(); let mut cy: u64 = dy.coeff();
    let mut sx: u32 = dx.scale(); let mut sy: u32 = dy.scale();
    while sx < sy {
        if cx > 1844674407370955161u64 { return WAny::ref_to(0i64 as *const u8); }
        cx = cx * 10u64; sx = sx + 1u32;
    }
    while sy < sx {
        if cy > 1844674407370955161u64 { return WAny::ref_to(0i64 as *const u8); }
        cy = cy * 10u64; sy = sy + 1u32;
    }
    let nx: bool = dx.is_neg() && cx != 0u64;
    let ny: bool = dy.is_neg() && cy != 0u64;
    if nx == ny {
        if cx > 18446744073709551615u64 - cy { return WAny::ref_to(0i64 as *const u8); }
        return h.decimal(cx + cy, sx, nx);
    }
    if cx >= cy { return h.decimal(cx - cy, sx, nx); }
    return h.decimal(cy - cx, sx, ny);
}
