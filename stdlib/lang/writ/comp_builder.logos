// logos.lang.writ.comp_builder — writ2 runtime builders for @{}/@[]
// comprehensions and capture-@{}.
//
// STEP 5 (cut-over): the compiler lowers Writ COMPREHENSIONS (`@[e for x in it]`,
// `@{k:v for ...}`) and capture-`@{}` to a RUNTIME Writ container built via these
// helpers. The legacy path used logos.mem.writ.ctr (Writ1 4-byte) so the blob
// the compiler then reads (lower_writ_blob, writ2) mismatched -> SIGSEGV. These
// build a writ2 `Writ` container instead, matching the compiler's read.
//
// Mirror of mem.writ.ctr::writ_{list,map}_comp_{new,push,put} + writ_coerce_*,
// AnyVal -> WAny.
//
// OWNERSHIP (the never-move + Rc-holder design): the comprehension yields an
// `Rc<Writ>`. `Writ` owns its `Allocator` by value and is a non-movable
// "stable root" — so the container is heap-pinned inside the Rc, and we build the
// array/map root ONLY AFTER it is in the Rc (the move into Rc is the last move;
// allocations then capture the STABLE Rc-heap allocator address that zone_of
// recovers). Returning the Rc moves only the Rc handle, never the Writ.

package logos.lang.writ.comp_builder;

use logos.lang.writ.anyval;       // WAny
use logos.lang.writ.container;    // Writ, writ_new
use logos.lang.writ.array;        // WArray<WAny>, Writ.array, WArray.push
use logos.lang.writ.hmap;         // WMap<WString,WAny>, Writ.map, WMap.set
use logos.lang.writ.hstring;      // WString (key type in the map annotation)
use logos.lang.rc;                    // Rc — heap-pin the non-movable Writ
use logos.lang.str;

// КОСТЫЛЬ / TODO(deref): we use explicit `&*rc` because `*rc` / auto-deref of
// a user `Deref` impl (Rc) does NOT kick in for method calls or the `*` operator yet
// (`rc.array()`/`*rc` fail; `&*rc` works). Once Logos auto-invokes user Deref
// (Rust-conformant), drop the explicit `.deref()` here and call methods on the Rc
// directly. Tracked as a compiler deref-coercion gap.

// ── List comprehension: @[expr for x in iter (if guard)?] ──────────────────────
pub fn writ_list_comp_new(cap: i64) -> Rc<Writ> {
    let rc: Rc<Writ> = rc_new(writ_new(cap));    // Writ pinned in Rc heap
    let h: &Writ = &*rc;
    let arr: &mut WArray<WAny> = h.array(8);           // allocate AFTER the pin (stable zone)
    // КОСТЫЛЬ / TODO(fat-thin): `let a: &WArray = h.array(8); WAny::from(a)` stores the
    // WRONG word — the &mut(fat,zone-carrying) -> &(thin) coercion picks the zone word,
    // not the data ptr. So extract the DATA ptr explicitly from the fat &mut and rebuild
    // a clean thin & from it. Fix the fat->thin & coercion in the compiler, then drop this.
    let aptr: *const WArray<WAny> = arr as *const WArray<WAny>;
    h.set_root(WAny::from(unsafe { &*aptr }));
    return rc;
}

pub fn writ_list_comp_push(c: &Rc<Writ>, v: WAny) {
    let h: &Writ = &**c;
    let root: WAny = h.root();
    unsafe {
        let hp: *mut Writ = h as *const Writ as *mut Writ;
        // Rebuild a FAT &mut carrying the container's zone (allocator), so push/grow
        // recover it via zone_of(self) — a thin &mut from the raw ptr loses the zone.
        let arr: &mut WArray<WAny> = zone_mut_ref::<WArray<WAny>>(
            root.resolve() as *mut WArray<WAny>, &mut hp.allocator as *mut u8);
        arr.push(v);
    }
}

// ── Map comprehension: @{kexpr: vexpr for x in iter (if guard)?} ───────────────
pub fn writ_map_comp_new(cap: i64, slot_hint: i64) -> Rc<Writ> {
    let rc: Rc<Writ> = rc_new(writ_new(cap));    // Writ pinned in Rc heap
    let h: &Writ = &*rc;
    // Round slot_hint up to next power of two (min 8) — open-addressing masking.
    let mut slots: i64 = 8;
    let mut want:  i64 = slot_hint * 2;
    if want < 8 { want = 8; }
    while slots < want { slots = slots * 2; }
    let m: &mut WMap<WString, WAny> = h.map(slots);    // allocate AFTER the pin (stable zone)
    let mptr: *const WMap<WString, WAny> = m as *const WMap<WString, WAny>;
    h.set_root(WAny::from(unsafe { &*mptr }));
    return rc;
}

pub fn writ_map_comp_put(c: &Rc<Writ>, k: str, v: WAny) {
    let h: &Writ = &**c;
    let root: WAny = h.root();
    unsafe {
        let hp: *mut Writ = h as *const Writ as *mut Writ;
        let m: &mut WMap<WString, WAny> = zone_mut_ref::<WMap<WString, WAny>>(
            root.resolve() as *mut WMap<WString, WAny>, &mut hp.allocator as *mut u8);
        m.set(k, v);
    }
}

// String coercion allocates an WString in the CONTAINER's zone (needs_ctr form:
// the compiler passes &Rc<Writ> first).
pub fn writ_coerce_str(c: &Rc<Writ>, s: str) -> WAny {
    let h: &Writ = &**c;
    let hs: &WString = h.hstring(s);
    return WAny::from(hs);
}

// ── Scalar → WAny coercion (compiler auto-wraps the element expr by Logos type) ─
pub fn writ_coerce_bool(v: bool) -> WAny { return WAny::from(v); }
pub fn writ_coerce_i8(v: i8)   -> WAny { return WAny::from(v); }
pub fn writ_coerce_i16(v: i16) -> WAny { return WAny::from(v); }
pub fn writ_coerce_i32(v: i32) -> WAny { return WAny::from(v as i56); }
pub fn writ_coerce_u8(v: u8)   -> WAny { return WAny::from(v); }
pub fn writ_coerce_u16(v: u16) -> WAny { return WAny::from(v); }
pub fn writ_coerce_u32(v: u32) -> WAny { return WAny::from(v as i56); }
