// Logos Writ stdlib — writ2.compactify
//
// Copy-compaction (the copying-GC half of design §6). A live Writ document may
// be spread across MANY never-move segments (growth appends; nothing is reclaimed
// in place). `compactify` walks the doc from its root and rebuilds it wholesale in
// a FRESH arena `dst` — every string/array/map re-allocated, every Pod copied by
// value, every self-relative reference re-anchored to its new slot by the normal
// build path (ha_lower). If `dst` is sized to hold the whole doc, the result is a
// single contiguous rigid block: relocatable + serializable as one unit. The old
// container is then dead and freed en masse (its holder dropped) — no per-object
// reclaim, no in-place moves.
//
// It is the inverse-free twin of stringify/wbs_write: same type_code-dispatched
// walk, but the sink is a live arena rather than text/bytes. (Old → new is a pure
// copy; the old bytes are never mutated — design §4 "compaction = copy, not move".)

package logos.lang.writ.compactify;

use logos.lang.writ.container;   // Writ
use logos.lang.writ.anyval;      // WAny
use logos.lang.writ.array;       // WArray<WAny>
use logos.lang.writ.hmap;        // WMap<WString, WAny>
use logos.lang.writ.hstring;     // WString
use logos.lang.str;                 // str
use logos.lang.ptr;

// Deep-copy `v` (and everything it transitively references) into `dst`; return the
// new root WAny. Pods/null are position-independent (copied by value); Refs are
// rebuilt and re-anchored.
pub fn compactify(dst: &Writ, v: WAny) -> WAny {
    if v.is_null() { return WAny::ref_to(0i64 as *const u8); }
    if v.is_pod()  { return v; }                       // i56 / bool — position-independent
    if v.is_float() { return dst.float(v.as_f64()); }  // boxed wide scalars → re-box in dst
    if v.is_int()   { return dst.int(v.as_i64()); }    // (boxed i64; Pod i56 already handled above)
    if v.is_string() {
        let hs: &WString = unsafe { &*(v.resolve() as *const WString) };
        return WAny::from(dst.hstring(hs.as_str()));
    }
    if v.is_array() {
        let a: &WArray<WAny> = unsafe { &*(v.resolve() as *const WArray<WAny>) };
        let n: i64 = a.len();
        let na: &mut WArray<WAny> = dst.array(if n < 1i64 { 1i64 } else { n });
        let mut i: i64 = 0i64;
        while i < n { na.push(compactify(dst, a.get(i))); i = i + 1i64; }
        return WAny::from(&*na);
    }
    if v.is_map() {
        let m: &WMap<WString, WAny> = unsafe { &*(v.resolve() as *const WMap<WString, WAny>) };
        let n: i64 = m.len();
        let nm: &mut WMap<WString, WAny> = dst.map(if n < 1i64 { 1i64 } else { n });
        let mut i: i64 = 0i64;
        while i < m.slots() {
            let k: WAny = m.key_at(i);
            if !k.is_null() {
                let ks: &WString = unsafe { &*(k.resolve() as *const WString) };
                nm.set(ks.as_str(), compactify(dst, m.val_at(i)));
            }
            i = i + 1i64;
        }
        return WAny::from(&*nm);
    }
    return v;
}

// Deep-copy `v` into arena `dst`, returning the new independent root. This IS
// compaction (a full structural copy, re-anchoring every reference) — `clone` is
// the same operation named for the by-value-copy intent (Writ1's clone). Copy
// into the SAME arena to duplicate a subtree; into a FRESH arena to compact.
pub fn clone(dst: &Writ, v: WAny) -> WAny { return compactify(dst, v); }
