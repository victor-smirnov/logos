// Logos Writ stdlib — writ.objectmap
//
// WMap<WString, WAny> — a string-keyed hash map (the JSON "object") over the never-move
// arena, the Writ port of writ.objectmap. Open-addressing with linear
// probing + FNV-1a (logos.lang.hash); keys are interned WStrings, values WAny.
//
// Unlike the legacy fixed-capacity zone map (which dropped inserts when full),
// this GROWS like a Rust HashMap: at load factor > 0.75 it appends a fresh 2×
// entry buffer through the stored allocator and REHASHES every live entry into
// it (re-anchoring each self-relative slot through its absolute value, exactly
// like WArray<WAny>'s grow). The old buffer is left dead until the container
// drops (design §3 — no per-object reclaim).
//
// Layout mirrors WArray<WAny>: a `#[pinned]` header in the arena + a self-relative
// `data` delta to the WMapEntry buffer (header and buffer may live in different
// never-move segments; the delta stays valid). Empty slot = key.raw == 0 (the
// buffer is zero-initialised; a real Ref's at-rest delta is never 0).

package logos.lang.writ.wmap;

use logos.lang.writ.container;   // Writ, writ_alloc / _n
use logos.lang.writ.allocator;   // Allocator, allocator_alloc
use logos.lang.writ.anyval;      // WAny (niche enum), WAnyMut, WA_I56 — at-rest via *zoned
use logos.lang.writ.wstring;     // WString, wstring_in_alloc
use logos.lang.writ.array;       // WArray<WAny> + WAny::from(&Array) — for nested values
use logos.lang.hash;                // fnv1a_bytes
use logos.lang.str;                 // str, str_eq
use logos.lang.cell;
use logos.lang.ptr;                 // byte_add

#[pinned]
pub struct WMapEntry {
    // Two AT-REST WAny words (key @0, val @8). Held as raw `i64` and accessed
    // through `*zoned mut WAny` slot pointers (ent_key/ent_val), so each read
    // materialises and each write lowers — no WAnyRel, no ha_*. key==0 = empty.
    pub key: i64,   // Ref to the interned WString key; ==0 = empty slot
    pub val: i64,   // the stored WAny value
}

// WMap<K, V> — empty base; per-key-shape partial SPECIALISATIONS attach layout +
// impl (mirrors legacy Map<K,V>). Never instantiated directly.
#[zoned]
pub struct WMap<K, V> {}

// ── Open-addressing spec: string keys (WMap<WString, V>) ──────────────────────
// `#[zone_mut]`: a `&mut` is a FAT ref {data, zone} carrying its Writ zone (the
// allocator) — grow/intern reach it via zone_of(self); read `&` stays thin.
// `#[zoned]`: `data` is stored SELF-RELATIVE and materialises to the absolute
// entry buffer on read (ref-repr-design §6). No manual delta.
#[zone_mut]
#[pinned]
#[zoned]
pub struct WMap<WString, V> {
    pub count: i64,             // occupied slots
    pub cap:   i64,             // number of slots (power of 2)
    pub data:  *mut WMapEntry,  // entry buffer (auto-relative via #[zoned])
}

// Ergonomic alias for the heterogeneous string-keyed map (the only instantiation
// today): write `WValMap` for `WMap<WString, WAny>`.
pub type WValMap = WMap<WString, WAny>;

// Absolute entry buffer (header + delta).
// #[zoned]: `m.data` materialises to the absolute entry buffer on read.
unsafe fn om_buf(m: *const WMap<WString, WAny>) -> *const WMapEntry { return m.data as *const WMapEntry; }
unsafe fn om_buf_mut(m: *mut WMap<WString, WAny>) -> *mut WMapEntry { return m.data; }

// Field-slot pointers within an entry (key @0, val @8) as `*zoned mut WAny` — each
// read materialises the at-rest word, each write lowers it (no distinct WAnyRel).
unsafe fn ent_key(ep: *mut WMapEntry) -> *zoned mut WAny { return ep as *zoned mut WAny; }
unsafe fn ent_val(ep: *mut WMapEntry) -> *zoned mut WAny { return (ep as *mut u8).byte_add(8i64) as *zoned mut WAny; }
unsafe fn ent_key_raw(ep: *const WMapEntry) -> i64 { return *(ep as *const i64); }   // key.raw, no copy

unsafe fn om_zero(buf: *mut WMapEntry, cap: i64) {
    let total: i64 = cap * (sizeof::<WMapEntry>() as i64);
    let mut i: i64 = 0i64;
    while i < total { let p: *mut u8 = (buf as *mut u8).byte_add(i); *p = 0u8; i = i + 1i64; }
}

// Round up to a power of two (min 8) — open addressing needs a pow2 capacity for
// the `hash & (cap-1)` slot index.
fn round_pow2(n: i64) -> i64 {
    let mut c: i64 = 8i64;
    while c < n { c = c * 2i64; }
    return c;
}

unsafe fn om_new(h: *mut Writ, cap: i64) -> *mut WMap<WString, WAny> {
    // The header is WAny-Ref'd (WAny::from(&WMap<WString, WAny>)) → tag it for dispatch.
    let hdr: *mut WMap<WString, WAny> =
        alloc_tagged(h.allocator.get(), sizeof::<WMap<WString, WAny>>() as i64, W_MAP) as *mut WMap<WString, WAny>;
    let buf: *mut WMapEntry  = writ_alloc_n::<WMapEntry>(h, cap);
    hdr.count = 0i64;
    hdr.cap   = cap;
    hdr.data  = buf;            // #[zoned]: lowers to self-relative offset
    om_zero(buf, cap);
    return hdr;
}

// The byte view of an interned WString key (for hashing / comparison).
unsafe fn key_str(stored: WAny) -> str { return (&*(stored.resolve() as *const WString)).as_str(); }

// Grow to 2× capacity, rehashing every live entry into the fresh buffer (no key
// compare — all existing keys are distinct).
unsafe fn om_grow(m: *mut WMap<WString, WAny>, alloc: *mut Allocator) {
    let oldcap: i64 = m.cap;
    let newcap: i64 = if oldcap == 0i64 { 8i64 } else { oldcap * 2i64 };
    let nbuf: *mut WMapEntry =
        allocator_alloc(alloc, newcap * (sizeof::<WMapEntry>() as i64), align_of::<WMapEntry>() as i64) as *mut WMapEntry;
    om_zero(nbuf, newcap);
    let obuf: *mut WMapEntry = om_buf_mut(m);
    let ncap_u: u64 = newcap as u64;
    let mut i: i64 = 0i64;
    while i < oldcap {
        let oep: *mut WMapEntry = obuf.add(i);
        if ent_key_raw(oep as *const WMapEntry) != 0i64 {
            let key: WAny = *(ent_key(oep));
            let val: WAny = *(ent_val(oep));
            let s: str = key_str(key);
            let hh: u64 = fnv1a_bytes(s.as_ptr(), s.len() as u64);
            let mut slot: u64 = hh & (ncap_u - 1u64);
            loop {
                let nep: *mut WMapEntry = nbuf.add(slot as i64);
                if ent_key_raw(nep as *const WMapEntry) == 0i64 {
                    *(ent_key(nep)) = key;
                    *(ent_val(nep)) = val;
                    break;
                }
                slot = (slot + 1u64) & (ncap_u - 1u64);
            }
        }
        i = i + 1i64;
    }
    m.data = nbuf;          // #[zoned]: lowers to self-relative offset
    m.cap  = newcap;
}

// Insert or update. On a NEW key the str is interned into THIS map's arena.
unsafe fn om_set(m: *mut WMap<WString, WAny>, alloc: *mut Allocator, key: str, val: WAny) {
    if (m.count + 1i64) * 4i64 > m.cap * 3i64 { om_grow(m, alloc); }   // load > 0.75
    let cap_u: u64 = m.cap as u64;
    let hh: u64 = fnv1a_bytes(key.as_ptr(), key.len() as u64);
    let buf: *mut WMapEntry = om_buf_mut(m);
    let mut slot: u64 = hh & (cap_u - 1u64);
    loop {
        let ep: *mut WMapEntry = buf.add(slot as i64);
        if ent_key_raw(ep as *const WMapEntry) == 0i64 {
            let ks: *mut WString = wstring_in_alloc(alloc, key);
            *(ent_key(ep)) = WAny::ref_to(ks as *const u8);
            *(ent_val(ep)) = val;
            m.count = m.count + 1i64;
            return;
        }
        let stored: WAny = *(ent_key(ep));
        if str_eq(key_str(stored), key) {
            *(ent_val(ep)) = val;   // update existing
            return;
        }
        slot = (slot + 1u64) & (cap_u - 1u64);
    }
}

unsafe fn om_get(m: *const WMap<WString, WAny>, key: str) -> WAny {
    let cap_u: u64 = m.cap as u64;
    let hh: u64 = fnv1a_bytes(key.as_ptr(), key.len() as u64);
    let buf: *const WMapEntry = om_buf(m);
    let mut slot: u64 = hh & (cap_u - 1u64);
    let mut probed: u64 = 0u64;
    while probed < cap_u {
        let ep: *const WMapEntry = buf.add(slot as i64);
        if ent_key_raw(ep) == 0i64 { return WAny::ref_to(0i64 as *const u8); }
        let stored: WAny = *(ent_key(ep as *mut WMapEntry));
        if str_eq(key_str(stored), key) {
            return *(ent_val(ep as *mut WMapEntry));
        }
        slot = (slot + 1u64) & (cap_u - 1u64);
        probed = probed + 1u64;
    }
    return WAny::ref_to(0i64 as *const u8);
}

// Find the value SLOT for `key` (for `get_mut`) — the `*zoned mut WAny` to read /
// replace / descend in place. Returns a null pointer if the key is absent (the
// cursor is then invalid; callers ensure the key exists, mirroring `get_mut`).
unsafe fn om_get_slot(m: *mut WMap<WString, WAny>, key: str) -> *zoned mut WAny {
    let cap_u: u64 = m.cap as u64;
    let hh: u64 = fnv1a_bytes(key.as_ptr(), key.len() as u64);
    let buf: *mut WMapEntry = om_buf_mut(m);
    let mut slot: u64 = hh & (cap_u - 1u64);
    let mut probed: u64 = 0u64;
    while probed < cap_u {
        let ep: *mut WMapEntry = buf.add(slot as i64);
        if ent_key_raw(ep as *const WMapEntry) == 0i64 { return 0i64 as *zoned mut WAny; }
        let stored: WAny = *(ent_key(ep));
        if str_eq(key_str(stored), key) {
            return ent_val(ep);
        }
        slot = (slot + 1u64) & (cap_u - 1u64);
        probed = probed + 1u64;
    }
    return 0i64 as *zoned mut WAny;
}

// ── Direct-reference surface (like WArray<WAny>) ────────────────────────────────
impl Writ {
    // Create an empty string-keyed map with at least `cap` slots (rounded to a
    // power of two, min 8). `&self` interior-mut allocation into never-move storage.
    pub fn map<'a>(self: &'a Writ, cap: i64) -> &'a mut WMap<WString, WAny> {
        unsafe {
            // Fat `&mut` carrying this container's zone (the allocator); set/grow/
            // intern recover it via zone_of(self).
            return zone_mut_ref::<WMap<WString, WAny>>(om_new(self as *const Writ as *mut Writ, round_pow2(cap)), self.allocator.get() as *mut u8);
        }
    }
}

impl WMap<WString, WAny> {
    // The zone (allocator) for grow/intern comes from the fat `&mut self` via
    // zone_of(self) — bind it FIRST (no move), then `self as *mut WMap<WString, WAny>` (the cast
    // consumes the fat ref) is self's last use in the om_set call.
    pub fn set(self: &mut WMap<WString, WAny>, key: str, val: WAny) {
        unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; om_set(self as *mut WMap<WString, WAny>, z, key, val); }
    }
    pub fn get(self: &WMap<WString, WAny>, key: str) -> WAny { return unsafe { om_get(self as *const WMap<WString, WAny>, key) }; }
    pub fn contains(self: &WMap<WString, WAny>, key: str) -> bool { return !self.get(key).is_null(); }
    pub fn len(self: &WMap<WString, WAny>) -> i64 { return self.count; }

    // Mutable cursor onto the value at `key` (a Ref value — nested container/string):
    // carries THIS map's zone (zone_of(self)) so the child can grow in the same arena.
    // Bind the zone FIRST (no move); `self as *const` is self's last use.
    pub fn get_mut(self: &mut WMap<WString, WAny>, key: str) -> WAnyMut {
        unsafe {
            let z: *mut u8 = zone_of(self);
            let slot: *zoned mut WAny = om_get_slot(self as *mut WMap<WString, WAny>, key);
            return WAnyMut { slot: slot, zone: z };
        }
    }

    // Slot iteration (for generic walkers — stringify/binary). Walk 0..slots();
    // a slot is occupied iff its key is non-null. The key is a Ref to the interned
    // WString; the value is the stored WAny.
    pub fn slots(self: &WMap<WString, WAny>) -> i64 { return self.cap; }
    pub fn key_at(self: &WMap<WString, WAny>, i: i64) -> WAny {
        unsafe {
            let ep: *const WMapEntry = om_buf(self as *const WMap<WString, WAny>).add(i);
            if ent_key_raw(ep) == 0i64 { return WAny::ref_to(0i64 as *const u8); }
            return *(ent_key(ep as *mut WMapEntry));
        }
    }
    pub fn val_at(self: &WMap<WString, WAny>, i: i64) -> WAny {
        unsafe {
            let ep: *const WMapEntry = om_buf(self as *const WMap<WString, WAny>).add(i);
            if ent_key_raw(ep) == 0i64 { return WAny::ref_to(0i64 as *const u8); }
            return *(ent_val(ep as *mut WMapEntry));
        }
    }

    // Overloaded set for the common value types (no manual WAny::from), mirroring
    // WArray<WAny>::push. A `str` VALUE is interned into the same arena as a Ref.
    pub fn set(self: &mut WMap<WString, WAny>, key: str, v: i64)  { unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; self.set(key, make_int(z, v)); } }
    pub fn set(self: &mut WMap<WString, WAny>, key: str, v: f64)  { unsafe { let z: *mut Allocator = zone_of(self) as *mut Allocator; self.set(key, box_f64(z, v)); } }
    pub fn set(self: &mut WMap<WString, WAny>, key: str, v: bool) { self.set(key, WAny::from(v)); }
    pub fn set(self: &mut WMap<WString, WAny>, key: str, v: &WString) { self.set(key, WAny::from(v)); }
    pub fn set(self: &mut WMap<WString, WAny>, key: str, v: &WArray<WAny>) { self.set(key, WAny::from(v)); }
    pub fn set(self: &mut WMap<WString, WAny>, key: str, v: &WMap<WString, WAny>) { self.set(key, WAny::from(v)); }
    pub fn set(self: &mut WMap<WString, WAny>, key: str, v: str) {
        unsafe {
            let z: *mut Allocator = zone_of(self) as *mut Allocator;
            let hs: *mut WString = wstring_in_alloc(z, v);
            self.set(key, WAny::ref_to(hs as *const u8));
        }
    }
}

impl WAnyMut {
    // Resolve a mutable cursor to a fat `&mut WMap<WString, WAny>` carrying its zone — ready to
    // set/grow in the same arena. (Check is_map() first.)
    pub fn as_map_mut(self: WAnyMut) -> &mut WMap<WString, WAny> {
        return unsafe { zone_mut_ref::<WMap<WString, WAny>>(self.get().resolve() as *mut WMap<WString, WAny>, self.zone) };
    }
}

impl WAny {
    // A map as a heterogeneous value — a Ref to its header.
    pub fn from(m: &WMap<WString, WAny>) -> WAny { return WAny::ref_to(m as *const WMap<WString, WAny> as *const u8); }

    // Resolve a Ref cursor to a borrowed `&WMap<WString, WAny>` (read-only). Check
    // is_map() first. Encapsulates the resolve()+cast so callers stay unsafe-free.
    pub fn as_map(self: &WAny) -> &WMap<WString, WAny> {
        return unsafe { &*(self.resolve() as *const WMap<WString, WAny>) };
    }
}

// ── Bitmap-indexed spec: 6-bit keys (WMap<Wu6, V>) — legacy TinyObjectMap ─────
//
// A compact, FIXED-capacity map of up to 52 small u8 keys (0..51) → WAny. O(1)
// lookup: a key's value-array position is popcount(bitmap & keys-below); the value
// array is kept in key order (insert shifts right). `set` never allocates (fixed
// cap), so it's a thin `&mut`. `data` is the value buffer (`*zoned mut WAny`: each
// `*(buf.add(i))` is a self-relative element access — at-rest ↔ value, like WArray).

// Wu6 — a pure type-level label for the 6-bit key (keys 0..51): the bitmap-indexed
// map is `WMap<Wu6, WAny>`, aliased WTinyValMap.
#[zoned] pub struct Wu6 {}

#[pinned]
#[zoned]
pub struct WMap<Wu6, V> {
    pub header: u64,               // bitmap[0:51] | cap[52:57] | size[58:63]
    pub schema_code: u64,          // node-class discriminator (0 = none); byte-shared with C++ TOM (was `schema`; renamed — `schema` is now a keyword, ADR 0011)
    pub data:   *zoned mut WAny,   // value array (cap slots; auto-relative) — zoned ptr stays LAST
}

// The bitmap-indexed tiny map (legacy TinyObjectMap); was the standalone WTinyValMap.
pub type WTinyValMap = WMap<Wu6, WAny>;

const WTV_BITMAP_MASK: u64 = 0x000FFFFFFFFFFFFFu64;   // bits[0:51] presence bitmap

unsafe fn wtv_new(h: *mut Writ, cap: i64) -> *mut WMap<Wu6, WAny> {
    let c: i64 = if cap > 52i64 { 52i64 } else { if cap < 0i64 { 0i64 } else { cap } };
    let hdr: *mut WMap<Wu6, WAny> =
        alloc_tagged(h.allocator.get(), sizeof::<WMap<Wu6, WAny>>() as i64, W_TINYMAP) as *mut WMap<Wu6, WAny>;
    let buf: *zoned mut WAny = writ_alloc_n::<WAny>(h, c) as *zoned mut WAny;
    hdr.header = (c as u64) << 52u64;   // cap bits; bitmap = 0, size = 0
    hdr.schema_code = 0u64;             // no schema by default
    hdr.data   = buf;                   // #[zoned]: lowers to a self-relative offset
    // No zero-init of the value buffer: the array is compacted (only the `size`
    // present entries, in key order) and bitmap-gated — get() reads data[pos]
    // only when the key's bit is set (pos < size), and set() only touches
    // positions < size, all written by prior inserts. Slots in [size, cap) are
    // never read, so zeroing them was pure overhead (was ~22% of Writ build time).
    return hdr;
}

impl WMap<Wu6, WAny> {
    pub fn size(self: &WMap<Wu6, WAny>) -> i64 { return ((self.header >> 58u64) & 0x3Fu64) as i64; }
    pub fn cap(self: &WMap<Wu6, WAny>)  -> i64 { return ((self.header >> 52u64) & 0x3Fu64) as i64; }

    // Node-class discriminator (0 = none); byte-shared with the C++ TinyObjectMap.
    pub fn schema_type_code(self: &WMap<Wu6, WAny>) -> u64 { return self.schema_code; }
    pub fn set_schema_type_code(self: &mut WMap<Wu6, WAny>, code: u64) { self.schema_code = code; }

    // Is `key` present?
    pub fn contains(self: &WMap<Wu6, WAny>, key: u8) -> bool {
        return (self.header & WTV_BITMAP_MASK & (1u64 << (key as u64))) != 0u64;
    }

    // Value at `key`, or null WAny if absent / key out of range.
    pub fn get(self: &WMap<Wu6, WAny>, key: u8) -> WAny {
        if key >= 52u8 { return WAny::ref_to(0i64 as *const u8); }
        let bitmap: u64 = self.header & WTV_BITMAP_MASK;
        let kb: u64 = 1u64 << (key as u64);
        if (bitmap & kb) == 0u64 { return WAny::ref_to(0i64 as *const u8); }
        let pos: i64 = popcount_u64(bitmap & (kb - 1u64)) as i64;
        return unsafe { *(self.data.add(pos)) };
    }

    // Insert or update `key → val`. `key >= 52` or a full map (new key) is a no-op.
    pub fn set(self: &mut WMap<Wu6, WAny>, key: u8, val: WAny) {
        if key >= 52u8 { return; }
        unsafe {
            let bitmap: u64 = self.header & WTV_BITMAP_MASK;
            let kb: u64  = 1u64 << (key as u64);
            let pos: i64 = popcount_u64(bitmap & (kb - 1u64)) as i64;
            let size: i64 = ((self.header >> 58u64) & 0x3Fu64) as i64;
            let cap: i64  = ((self.header >> 52u64) & 0x3Fu64) as i64;
            let buf: *zoned mut WAny = self.data;
            if (bitmap & kb) == 0u64 {
                if size >= cap { return; }
                let mut i: i64 = size;
                while i > pos { *(buf.add(i)) = *(buf.add(i - 1i64)); i = i - 1i64; }
                let cap_bits:  u64 = (cap as u64) << 52u64;
                let size_bits: u64 = ((size + 1i64) as u64) << 58u64;
                self.header = (bitmap | kb) | cap_bits | size_bits;
            }
            *(buf.add(pos)) = val;
        }
    }
}

impl Writ {
    // Create an empty bitmap-indexed tiny map; thin `&mut` (fixed capacity → no zone).
    pub fn tinymap<'a>(self: &'a Writ, cap: i64) -> &'a mut WMap<Wu6, WAny> {
        unsafe {
            let h: *mut Writ = self as *const Writ as *mut Writ;
            return &mut *wtv_new(h, cap);
        }
    }

    // ADR 0011 — allocate a TOM and stamp a schema type-code, returning the raw
    // view pointer. The compiler's `schema`/`make::<S>()` desugaring wraps this
    // in the typed view `S { m }` (S is a compiler-side view type over this TOM).
    pub fn make_schema(self: &Writ, cap: i64, code: u64) -> *const WMap<Wu6, WAny> {
        let m: &mut WMap<Wu6, WAny> = self.tinymap(cap);
        m.set_schema_type_code(code);
        return m as *const WMap<Wu6, WAny>;
    }

    // ADR 0011 (Increment 6) — allocate + stamp a TOM AND carry the arena
    // allocator, so the schema view can box wide values (i64/u64/f64/strings) on
    // write. Layout {m, z} is IDENTICAL to the compiler-synthesized schema view,
    // which `make::<S>()` reinterprets (retype) to the typed view `S`.
    pub fn make_schema_h(self: &Writ, cap: i64, code: u64) -> WSchemaH {
        let m: &mut WMap<Wu6, WAny> = self.tinymap(cap);
        m.set_schema_type_code(code);
        return WSchemaH { m: m as *const WMap<Wu6, WAny>, z: self.allocator.get() as *mut u8 };
    }
}

// ADR 0011 — the runtime shape of a schema view: a TOM pointer + the arena
// allocator (for boxing wide values on write). The compiler's schema view type
// `S` has this exact layout; `make::<S>()` reinterprets a WSchemaH as S.
pub struct WSchemaH {
    pub m: *const WMap<Wu6, WAny>,
    pub z: *mut u8,
}

impl WAny {
    pub fn from(m: &WMap<Wu6, WAny>) -> WAny { return WAny::ref_to(m as *const WMap<Wu6, WAny> as *const u8); }
}

// ── Dense spec: scalar integer keys (WMap<K, WAny>) — legacy Map<K, AnyVal> ───
//
// A dense, FIXED-capacity map of a scalar int key K (i32/u32/i64/u64) → WAny (wire
// codes MapI32AnyVal=3101 .. MapU64AnyVal=3104). Two parallel buffers — plain `K[]`
// keys + `*zoned WAny[]` values — with O(n) linear lookup (the map is small). Fixed
// capacity → `set` never allocates → thin `&mut` (no #[zone_mut]).
//
// This spec's first arg is a TYPE-VAR (K), so it overlaps the first-arg specs
// (WMap<WString,V>, WMap<Wu6,V>) on e.g. WMap<WString,WAny>; struct-layout
// selection picks the more-specific first-arg spec by specificity. The METHODS sit
// behind the `K: WIntKeyTag` bound, which WString/Wu6 don't satisfy — so they never
// collide with the string/bitmap inherent methods.

// Per-key Writ wire tag (MapI32AnyVal=3101 .. MapU64AnyVal=3104).
pub trait WIntKeyTag { fn map_code() -> u64; }
impl WIntKeyTag for i32 { fn map_code() -> u64 { return 3101u64; } }
impl WIntKeyTag for u32 { fn map_code() -> u64 { return 3102u64; } }
impl WIntKeyTag for i64 { fn map_code() -> u64 { return 3103u64; } }
impl WIntKeyTag for u64 { fn map_code() -> u64 { return 3104u64; } }

#[pinned]
#[zoned]
pub struct WMap<K, WAny> {
    pub size: i64,
    pub cap:  i64,
    pub keys: *mut K,            // K[] (plain elements; auto-relative ptr)
    pub vals: *zoned mut WAny,   // WAny[] (at-rest; auto-relative ptr)
}

// The dense int-keyed map (legacy Map<K,AnyVal>); was the standalone WIntMap<K>.
pub type WIntMap<K> = WMap<K, WAny>;

unsafe fn wim_new<K: WIntKeyTag>(h: *mut Writ, cap: i64) -> *mut WMap<K, WAny> {
    let hdr: *mut WMap<K, WAny> =
        alloc_tagged(h.allocator.get(), sizeof::<WMap<K, WAny>>() as i64, K::map_code()) as *mut WMap<K, WAny>;
    let kbuf: *mut K          = writ_alloc_n::<K>(h, cap);
    let vbuf: *zoned mut WAny = writ_alloc_n::<WAny>(h, cap) as *zoned mut WAny;
    hdr.size = 0i64;
    hdr.cap  = cap;
    hdr.keys = kbuf;            // #[zoned]: lower to self-relative offsets
    hdr.vals = vbuf;
    return hdr;
}

impl<K: WIntKeyTag> WMap<K, WAny> {
    pub fn size(self: &WMap<K, WAny>) -> i64 { return self.size; }
    pub fn cap(self: &WMap<K, WAny>)  -> i64 { return self.cap; }

    pub fn contains(self: &WMap<K, WAny>, key: K) -> bool {
        unsafe {
            let mut i: i64 = 0i64;
            while i < self.size {
                if *(self.keys.add(i)) == key { return true; }
                i = i + 1i64;
            }
            return false;
        }
    }

    // Value at `key`, or null WAny if absent.
    pub fn get(self: &WMap<K, WAny>, key: K) -> WAny {
        unsafe {
            let mut i: i64 = 0i64;
            while i < self.size {
                if *(self.keys.add(i)) == key { return *(self.vals.add(i)); }
                i = i + 1i64;
            }
            return WAny::ref_to(0i64 as *const u8);
        }
    }

    // Insert or update `key → val`. A full map (new key) is a no-op.
    pub fn set(self: &mut WMap<K, WAny>, key: K, val: WAny) {
        unsafe {
            let mut i: i64 = 0i64;
            while i < self.size {
                if *(self.keys.add(i)) == key { *(self.vals.add(i)) = val; return; }
                i = i + 1i64;
            }
            if self.size >= self.cap { return; }   // full — no growth
            let n: i64 = self.size;
            *(self.keys.add(n)) = key;
            *(self.vals.add(n)) = val;
            self.size = n + 1i64;
        }
    }
}

impl Writ {
    // Create an empty int-keyed map; thin `&mut` (fixed capacity → no carried zone).
    pub fn intmap<'a, K: WIntKeyTag>(self: &'a Writ, cap: i64) -> &'a mut WMap<K, WAny> {
        unsafe {
            let h: *mut Writ = self as *const Writ as *mut Writ;
            return &mut *wim_new::<K>(h, cap);
        }
    }
}
