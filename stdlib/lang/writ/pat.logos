// logos.lang.writ.pat — writ runtime helpers for @{...} / @[...] match
// patterns. The writ port of mem.writ.pat.
//
// To keep build_writ_pat_guard's call shape IDENTICAL (it passes `&node` + a
// `base` ptr), every helper takes `(node: *const WAny, ...)`
// and IGNORES base — writ WAny is self-relative (value-form), so the node
// word alone resolves (no base needed). Only the helper NAMES (writ_pat_* ->
// writ_pat_*) + the node type (AnyVal -> WAny) + the root entry change in the
// compiler. Slot lookups return the child WAny (null on miss / wrong type).

package logos.lang.writ.pat;

use logos.lang.writ.anyval;       // WAny, h2_type_code
use logos.lang.writ.array;        // WArray<WAny>
use logos.lang.writ.hmap;         // WMap<WString, WAny>
use logos.lang.writ.hstring;      // WString
use logos.lang.writ.static_view;  // WView2 / hview2_from_ptr
use logos.lang.writ.container;    // Writ (runtime scrutinee)
use logos.lang.writ.hstatic;     // WritStatic (the scrutinee handle)
use logos.lang.rc;                    // Rc — runtime container scrutinee
use logos.lang.str;                  // str, str_eq

fn null_hany() -> WAny { return WAny::Ref(0i64 as *const u8); }

// Root WAny of a WritStatic @-literal scrutinee (the matcher's entry point).
// Inlined root read (the DocumentHeader's self-relative word at ptr+0) so the
// returned WAny borrows the &param's blob, not a local WView2 (borrow-checker).
pub fn writ_pat_root(view: &WritStatic) -> WAny {
    let base: *const u8 = view.ptr;
    let w: i64 = unsafe { *(base as *const i64) };
    if w == 0i64 { return WAny::Ref(0i64 as *const u8); }
    if (w & 1i64) == 1i64 { return WAny::Pod(w as u64); }
    return WAny::Ref((base as i64 + w) as *const u8);
}

// Root WAny of a RUNTIME Rc<Writ> scrutinee (capture/comprehension results).
pub fn writ_pat_root_rc(c: &Rc<Writ>) -> WAny {
    let h: &Writ = &**c;
    return h.root();
}

// ── Scalar leaves ─────────────────────
pub unsafe fn writ_pat_is_null(node: *const WAny) -> bool {
    return (*node).is_null();
}
pub unsafe fn writ_pat_eq_bool(node: *const WAny, b: bool) -> bool {
    let n: WAny = *node;
    return n.is_bool() && n.as_bool() == b;
}
pub unsafe fn writ_pat_eq_i24(node: *const WAny, v: i32) -> bool {
    let n: WAny = *node;
    return n.is_int() && n.as_i64() == (v as i64);
}
pub unsafe fn writ_pat_eq_str(node: *const WAny, s: str) -> bool {
    let n: WAny = *node;
    if !n.is_string() { return false; }
    let hs: &WString = &*(n.resolve() as *const WString);
    return str_eq(hs.as_str(), s);
}

// Present = the looked-up slot is a real value (not the null/absent sentinel).
pub unsafe fn writ_pat_is_present(node: *const WAny) -> bool {
    return !(*node).is_null();
}

// ── Containers ──────────────────────────────────────────────
pub unsafe fn writ_pat_is_map(node: *const WAny) -> bool {
    return (*node).is_map();
}
pub unsafe fn writ_pat_map_slot(node: *const WAny, key: str) -> WAny {
    let n: WAny = *node;
    if !n.is_map() { return null_hany(); }
    return (&*(n.resolve() as *const WMap<WString, WAny>)).get(key);
}
pub unsafe fn writ_pat_array_slot(node: *const WAny, idx: u64) -> WAny {
    let n: WAny = *node;
    if !n.is_array() { return null_hany(); }
    return (&*(n.resolve() as *const WArray<WAny>)).get(idx as i64);
}
pub unsafe fn writ_pat_array_len_eq(node: *const WAny, n: u64) -> bool {
    let v: WAny = *node;
    if !v.is_array() { return false; }
    return ((&*(v.resolve() as *const WArray<WAny>)).len() as u64) == n;
}
pub unsafe fn writ_pat_array_len_ge(node: *const WAny, n: u64) -> bool {
    let v: WAny = *node;
    if !v.is_array() { return false; }
    return ((&*(v.resolve() as *const WArray<WAny>)).len() as u64) >= n;
}
pub unsafe fn writ_pat_has_type_code(node: *const WAny, tc: u64) -> bool {
    let n: WAny = *node;
    if !n.is_ref() { return false; }
    return (h2_type_code(n.resolve())) == tc;
}
