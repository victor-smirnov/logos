// logos.lang.writ.hstatic — the compile-time @-literal blob handle.
//
// `@{...}` / `@[...]` / `@<T>[...]` literals (and metacall splice results) are
// writ2 blobs in rodata laid out as [u64 size][bytes]; `WritStatic.ptr`
// points at the first blob byte (past the size prefix). Read the document via
// `hview2_from_ptr(hs.ptr)` (lang.writ2.static_view).
//
// Relocated from lang.writ.view (Writ1, retired in the writ2 cut-over);
// the struct NAME is load-bearing — sema types static @-literals by it.

package logos.lang.writ.hstatic;

pub struct WritStatic {
    pub ptr: *const u8,
}

// Read the blob size stored 8 bytes before the blob pointer.
pub unsafe fn writ_static_size(ptr: *const u8) -> u64 {
    return *((ptr as i64 - 8) as *const u64);
}

impl WritStatic {
    pub fn size(self: &WritStatic) -> u64 {
        unsafe { return writ_static_size(self.ptr); }
    }
}

// ── StringView ───────────────────────────────────────────────────────────────
//
// Non-owning byte-slice view: pointer + length. Returned by string reads of
// blob-resident strings; pure value — no allocation.

pub struct StringView {
    pub ptr: *const u8,
    pub len: u64,
}

impl Copy for StringView {}
