// logos.lang.writ.static_view — writ read view over a @{}/WritStatic
// rodata blob.
//
// STEP 5 (cut-over): the compiler now emits @{} / WritStatic rodata blobs in
// Writ format (8-byte SELF-RELATIVE WAny slots, WMap<WString,WAny> object
// maps, WArray<WAny> arrays, WString strings) — the same layout the parser
// builds. The legacy `logos.lang.writ.view::WritView`/`WritStatic` read
// path decodes the OLD legacy 4-byte base-relative format, so it reads garbage
// (SIGILL). This module is the matching writ READER, mirroring the metaprog
// `OView` reader but for runtime blobs with STRING-keyed object maps.
//
// A node handle is a value-form WAny whose resolve() is the node's absolute
// address. The blob root is the DocumentHeader's self-relative AnyVal word at
// base+0; every other step follows Refs via resolve() (position-independent).

package logos.lang.writ.static_view;

use logos.lang.writ.anyval;     // WAny
use logos.lang.writ.wmap;       // WMap<WString, WAny>
use logos.lang.writ.array;      // WArray<WAny>
use logos.lang.writ.wstring;    // WString
use logos.lang.str;

// Borrowed UTF-8 bytes of a blob string.
pub struct SView2 {
    pub ptr: *const u8,
    pub len: u64,
}

impl Copy for SView2 {}

// Read view over a writ rodata blob. `base` is the first blob byte (the
// DocumentHeader, which holds the root AnyVal at offset 0). For a WritStatic
// the blob ptr already points past the 8-byte size prefix, so `base = hs.ptr`.
pub struct WView2 {
    pub base: *const u8,
}

impl Copy for WView2 {}

// Build a reader from a rodata blob pointer (WritStatic.ptr).
pub fn wview2_from_ptr(ptr: *const u8) -> WView2 {
    return WView2 { base: ptr };
}

// Reconstruct a value-form WAny from its raw word (WAny::raw()). Lets callers
// stash a node handle as a plain i64 in a struct field (sidestepping the
// borrow-checker's conservative treatment of the Ref raw-ptr) and rebuild it on
// use. A value-form Ref's word IS its absolute ptr (low bit 0); Pod has low
// bit 1; word 0 = null.
pub fn wany_from_word(w: i64) -> WAny {
    if (w & 1i64) == 1i64 { return WAny::Pod(w as u64); }
    return WAny::Ref(w as *const u8);
}

impl WView2 {
    // The document root WAny. DocumentHeader = { WAny root } at base+0; the
    // at-rest root word is self-relative to base — materialize it.
    pub fn root(self: WView2) -> WAny {
        let w: i64 = unsafe { *(self.base as *const i64) };
        if w == 0i64 { return WAny::Ref(0i64 as *const u8); }
        if (w & 1i64) == 1i64 { return WAny::Pod(w as u64); }
        return WAny::Ref((self.base as i64 + w) as *const u8);
    }

    // String-keyed ObjectMap field read: `node` (Ref to WMap<WString,WAny>) →
    // key → WAny. Null/non-ref node, or absent key, yields a null WAny.
    pub fn map_get(self: WView2, node: WAny, key: str) -> WAny {
        if !node.is_ref() { return WAny::Ref(0i64 as *const u8); }
        let p: *const u8 = node.resolve();
        if p == (0 as *const u8) { return WAny::Ref(0i64 as *const u8); }
        return unsafe { (&*(p as *const WMap<WString, WAny>)).get(key) };
    }

    // u8-keyed TinyObjectMap field read (the AST/schema flavour: WMap<Wu6,WAny>).
    pub fn tiny_map_get(self: WView2, node: WAny, key: u8) -> WAny {
        if !node.is_ref() { return WAny::Ref(0i64 as *const u8); }
        let p: *const u8 = node.resolve();
        if p == (0 as *const u8) { return WAny::Ref(0i64 as *const u8); }
        return unsafe { (&*(p as *const WMap<Wu6, WAny>)).get(key) };
    }

    // Scalar reads — an integer is an inline Pod OR a boxed zone W_I64/W_U64;
    // as_i64/as_u64 read whichever form holds it. Non-int → 0 / false.
    pub fn get_int(self: WView2, v: WAny) -> i64 {
        if v.is_int() { return v.as_i64(); }
        return 0i64;
    }
    pub fn get_i64(self: WView2, v: WAny) -> i64 { return self.get_int(v); }
    pub fn get_u64(self: WView2, v: WAny) -> u64 {
        if v.is_int() { return v.as_u64(); }
        return 0u64;
    }
    pub fn get_bool(self: WView2, v: WAny) -> bool {
        if v.is_pod() { return v.as_bool(); }
        return false;
    }

    // Borrowed UTF-8 bytes of a string node (Ref to WString). Empty if non-ref.
    pub fn get_str_view(self: WView2, v: WAny) -> SView2 {
        if !v.is_ref() { return SView2 { ptr: 0 as *const u8, len: 0 as u64 }; }
        let p: *const u8 = v.resolve();
        if p == (0 as *const u8) { return SView2 { ptr: 0 as *const u8, len: 0 as u64 }; }
        let s: str = unsafe { (&*(p as *const WString)).as_str() };
        return SView2 { ptr: s.as_ptr(), len: s.len() as u64 };
    }

    // Array length / element. `v` is a Ref to WArray<WAny>; null/non-ref → 0 / null.
    pub fn array_len(self: WView2, v: WAny) -> u64 {
        if !v.is_ref() { return 0 as u64; }
        let p: *const u8 = v.resolve();
        if p == (0 as *const u8) { return 0 as u64; }
        return unsafe { (&*(p as *const WArray<WAny>)).len() as u64 };
    }

    pub fn array_get(self: WView2, v: WAny, idx: u64) -> WAny {
        if !v.is_ref() { return WAny::Ref(0i64 as *const u8); }
        let p: *const u8 = v.resolve();
        if p == (0 as *const u8) { return WAny::Ref(0i64 as *const u8); }
        return unsafe { (&*(p as *const WArray<WAny>)).get(idx as i64) };
    }
}
