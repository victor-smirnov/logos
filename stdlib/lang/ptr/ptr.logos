// Logos standard library — std.lang.ptr
//
// Raw pointer helpers — mirror `core::ptr` standalone fns and the
// `NonNull<T>` newtype.
//
// All free fns are `unsafe` because they bypass borrow-check and the
// runtime owns no provenance/aliasing tracking. Use behind explicit
// abstractions (Vec / Box / Cell / etc.) rather than ad-hoc in driver
// code.
//
// Surface ported:
//   Free fns: null / null_mut / read / write / copy / copy_nonoverlapping
//   / swap / replace / drop_in_place / eq / addr_eq
//   NonNull<T>: new (checked) / new_unchecked / dangling / from_ref /
//   from_mut / as_ptr / as_ref / as_mut / cast / add / sub / offset
//
// Divergence from Rust:
//   - `core::ptr::drop_in_place` calls T's `Drop::drop`. Logos's
//     equivalent does the same when T has a user `impl Drop`, but
//     does NOT recursively drop fields (matches Logos's "explicit
//     Drop only" convention).
//   - `core::ptr::read` returns `T` by-value bit-copy. In Logos this
//     uses `*((p) as *const T)` which is the same operation; for
//     non-Copy T the caller is responsible for honouring "this is
//     now a fresh owner, original location must not be read again".
//   - `dangling()` returns a non-null but unsafe-to-deref ptr formed
//     from `align_of::<T>()` (Rust uses the same trick).
//   - `NonNull::cast<U>` is a bare ptr reinterpret; no provenance
//     bookkeeping (Logos has no Stacked-Borrows-style model).

package logos.lang.ptr;

use logos.lang.option;

// ───────────────────────────────────────────────────────────────────
// Free fns
// ───────────────────────────────────────────────────────────────────

/// Returns the null `*const T`.
///
/// Safe to call; reading or writing through the returned pointer is UB.
pub fn null<T>() -> *const T {
    return 0i64 as *const T;
}

/// Returns the null `*mut T`.
///
/// Safe to call; reading or writing through the returned pointer is UB.
pub fn null_mut<T>() -> *mut T {
    return 0i64 as *mut T;
}

/// Reads and returns the `T` at `src`, taking ownership (bit-for-bit copy).
///
/// `src` must point at an initialized `T`; for non-`Copy` `T` the source
/// location must not be read again afterwards (by-value move semantics).
// Read a `T` bit-for-bit from `src`. Logos has no per-byte memcpy
// builtin at this layer, so we lean on the generic pointer deref
// `*((p) as *const T)` which the codegen lowers to a struct load.
// Caller MUST ensure `src` points at a properly initialized `T` and
// that the original location isn't read again (Rust's by-value-move
// semantics).
pub unsafe fn read<T>(src: *const T) -> T {
    unsafe { return src[0]; }
}

/// Writes `src` to `dst` without reading or dropping the previous pointee.
///
/// Safe to use on uninitialized destinations (`MaybeUninit` / collection internals).
pub unsafe fn write<T>(dst: *mut T, src: T) {
    unsafe { dst[0] = src; }
}

/// Copies `count` elements from `src` to `dst`; the regions may overlap.
///
/// `memmove` semantics — the copy direction is chosen to handle overlap correctly.
// Memmove-style copy (overlapping allowed). Currently routed through
// the per-element `src[i] = …` loop; future revision will lean on the
// `memmove` runtime intrinsic via `mem/mem::move_bytes` once Logos
// supports a `count: usize` parameter on the slice copy primitives
// without per-arch lowering.
pub unsafe fn copy<T: Copy>(src: *const T, dst: *mut T, count: i64) {
    unsafe {
        // If source < destination, copy backwards to handle overlap.
        let dp: i64 = dst as i64;
        let sp: i64 = src as i64;
        if dp > sp && dp < sp + count * (sizeof::<T>() as i64) {
            let mut i: i64 = count;
            while i > 0i64 {
                i = i - 1i64;
                dst[i] = src[i];
            }
        } else {
            let mut i: i64 = 0i64;
            while i < count {
                dst[i] = src[i];
                i = i + 1i64;
            }
        }
    }
}

/// Copies `count` elements from `src` to `dst`; the regions must not overlap.
///
/// Cheaper than `copy` — no overlap direction check. Overlapping regions are UB.
pub unsafe fn copy_nonoverlapping<T: Copy>(src: *const T, dst: *mut T, count: i64) {
    unsafe {
        let mut i: i64 = 0i64;
        while i < count {
            dst[i] = src[i];
            i = i + 1i64;
        }
    }
}

/// Swaps the values at `x` and `y`.
pub unsafe fn swap<T>(x: *mut T, y: *mut T) {
    unsafe {
        let tmp: T = x[0];
        x[0] = y[0];
        y[0] = tmp;
    }
}

/// Replaces the value at `dst` with `src` and returns the old value.
pub unsafe fn replace<T>(dst: *mut T, src: T) -> T {
    unsafe {
        let old: T = dst[0];
        dst[0] = src;
        return old;
    }
}

/// Destroys the value at `p` in place, leaving the storage bytes untouched.
///
/// ── WHAT IT PROMISES ─────────────────────────────────────────────────────
/// Runs `T`'s FULL destructor, exactly as scope exit would: a user
/// `impl Drop for T` if there is one, AND the recursive field/element glue.
/// MEASURED (#119, both directions): `T = Inner` with its own printing `Drop`
/// → one destructor line; `T = Outer { tag: i64, s: Inner }` with NO `Drop` of
/// its own but a droppable field → `Inner`'s destructor still runs, one line,
/// identical to `Outer`'s ordinary scope-exit glue.
///
/// ⚠ THE PARAGRAPH THAT USED TO BE HERE SAID THE OPPOSITE — "runs only a user
/// `impl Drop`; fields are NOT recursively dropped" — and a two-line probe
/// falsified it. #112 found three comments in this tree claiming "only for
/// Copy" and a probe falsified every one; this was the fourth. An unenforced
/// promise in an `unsafe` block is the defect one rename away, so the sentence
/// above is the one a fixture holds: tests/logos/pass/ptr_drop_in_place_recurses.
///
/// ── WHAT IT DOES NOT PROMISE, AND WHAT THE CALLER OWES ───────────────────
/// NOTHING stops this from destroying a value somebody else still owns. There
/// is no bound to hang the obligation on (`T` is unconstrained — deliberately:
/// requiring `T: Default` would only buy the ability to leave a replacement
/// behind, which `mem::replace` already offers and which a caller with no
/// `Default` bound, e.g. `OnceCell<T>`, cannot supply). It is `unsafe` for
/// exactly this reason and for no other. The caller must be the value's owner
/// at the call, and afterwards the storage holds a DESTROYED value: it must be
/// neither read nor dropped again, only overwritten or forgotten. The two
/// stdlib callers show the two legitimate shapes — `manually_drop_drop`, where
/// the wrapper's whole job is to have suppressed the automatic owner, and
/// `OnceCell::{set, get_or_init}`, where the destroyed slot is overwritten by
/// the very next statement.
// Lowers to a regular `let _v: T = p[0];` so the borrow checker triggers the
// drop at the end of the statement — equivalent observable effect, which is
// also why the recursion is total: it is the ordinary local-drop path.
pub unsafe fn drop_in_place<T>(p: *mut T) {
    unsafe {
        let _v: T = p[0];
        // _v falls out of scope → Drop fires.
    }
}

/// Returns `true` if `a` and `b` have the same address (pointee values ignored).
pub fn eq<T>(a: *const T, b: *const T) -> bool {
    return (a as i64) == (b as i64);
}

/// Returns `true` if `a` and `b` have the same address, across pointee types.
pub fn addr_eq<T, U>(a: *const T, b: *const U) -> bool {
    return (a as i64) == (b as i64);
}

// ── Volatile / unaligned access ─────────────────────────────────────────
//
// Mirrors `core::ptr::{read_volatile, write_volatile, read_unaligned,
// write_unaligned}`.
//
// Today Logos's backend doesn't have a separate volatile load/store
// MLIR op exposed at this layer — every load/store is performed
// directly, and the optimiser doesn't yet reorder around side-effecting
// loads aggressively, so plain ptr deref already has the observable
// effect Rust's volatile guarantees. When LLVM volatile is plumbed
// through, these wrappers become the natural opt-in surface and the
// callers don't change.
//
// For unaligned access: x86-64 hardware tolerates unaligned 1/2/4/8-byte
// loads and stores natively (no #AC trap in normal mode), so the plain
// pointer deref is correct. Other targets would route these to a
// byte-wise memcpy fallback.

/// Reads the `T` at `src` with volatile semantics.
///
/// Currently a plain load — the backend has no volatile op yet (see section note).
pub unsafe fn read_volatile<T>(src: *const T) -> T {
    unsafe { return src[0]; }
}

/// Writes `src` to `dst` with volatile semantics.
///
/// Currently a plain store — the backend has no volatile op yet (see section note).
pub unsafe fn write_volatile<T>(dst: *mut T, src: T) {
    unsafe { dst[0] = src; }
}

/// Reads the `T` at `src` without an alignment requirement.
///
/// Plain load today; x86-64 tolerates unaligned scalar access (see section note).
pub unsafe fn read_unaligned<T>(src: *const T) -> T {
    unsafe { return src[0]; }
}

/// Writes `src` to `dst` without an alignment requirement.
///
/// Plain store today; x86-64 tolerates unaligned scalar access (see section note).
pub unsafe fn write_unaligned<T>(dst: *mut T, src: T) {
    unsafe { dst[0] = src; }
}

// ───────────────────────────────────────────────────────────────────
// NonNull<T>
// ───────────────────────────────────────────────────────────────────

/// A `*mut T` that is guaranteed non-null.
///
/// Type-level "never null" invariant used inside smart pointers (`Box`, `Rc`,
/// `Arc`, `Vec`). Construct via `new` (checked) or `new_unchecked` (unsafe).
pub struct NonNull<T> {
    ptr: *mut T,
}

impl<T> NonNull<T> {
    /// Creates a `NonNull` from `ptr`; returns `None` if `ptr` is null.
    pub fn new(ptr: *mut T) -> Option<NonNull<T>> {
        if (ptr as i64) == 0i64 {
            return Option::None;
        }
        return Option::Some(NonNull { ptr: ptr });
    }

    /// Creates a `NonNull` without checking; the caller guarantees `ptr` is non-null.
    pub unsafe fn new_unchecked(ptr: *mut T) -> NonNull<T> {
        return NonNull { ptr: ptr };
    }

    /// Returns a non-null, well-aligned sentinel pointer that owns no storage.
    ///
    /// The address equals `align_of::<T>()`; used for empty / zero-capacity
    /// collections. Never dereference it.
    pub fn dangling() -> NonNull<T> {
        return NonNull { ptr: align_of::<T>() as *mut T };
    }

    /// Creates a `NonNull` from a shared reference (always non-null).
    pub fn from_ref(r: &T) -> NonNull<T> {
        unsafe { return NonNull { ptr: (r as *const T) as *mut T }; }
    }

    /// Creates a `NonNull` from a mutable reference (always non-null).
    pub fn from_mut(r: &mut T) -> NonNull<T> {
        unsafe { return NonNull { ptr: r as *mut T }; }
    }

    /// Returns the raw `*mut T`; non-null, but dereferencing it still requires `unsafe`.
    pub fn as_ptr(self: NonNull<T>) -> *mut T {
        return self.ptr;
    }

    /// Reborrows the pointee as `&T`.
    ///
    /// The caller guarantees the pointee is initialized, aliasing rules hold,
    /// and the borrow does not outlive the storage.
    pub unsafe fn as_ref(&self) -> &T {
        unsafe { return &(self.ptr)[0]; }
    }

    /// Reborrows the pointee as `&mut T`.
    ///
    /// Same contract as `as_ref`, plus the usual `&mut` exclusivity.
    pub unsafe fn as_mut(self: &mut NonNull<T>) -> &mut T {
        unsafe { return &mut (self.ptr)[0]; }
    }

    /// Reinterprets the pointer as `NonNull<U>`, preserving the address.
    ///
    /// No alignment or validity check; bare reinterpret without provenance tracking.
    pub fn cast<U>(self: NonNull<T>) -> NonNull<U> {
        return NonNull { ptr: self.ptr as *mut U };
    }

    /// Returns the pointer advanced by `count` elements (`count * sizeof::<T>()` bytes).
    ///
    /// `count` may be negative; `add`/`sub`/`offset` mirror Rust's pointer arithmetic.
    pub unsafe fn add(self: NonNull<T>, count: i64) -> NonNull<T> {
        unsafe {
            let new_ptr: *mut T = ((self.ptr as i64) + count * (sizeof::<T>() as i64)) as *mut T;
            return NonNull { ptr: new_ptr };
        }
    }

    /// Returns the pointer moved back by `count` elements (`count * sizeof::<T>()` bytes).
    pub unsafe fn sub(self: NonNull<T>, count: i64) -> NonNull<T> {
        unsafe {
            let new_ptr: *mut T = ((self.ptr as i64) - count * (sizeof::<T>() as i64)) as *mut T;
            return NonNull { ptr: new_ptr };
        }
    }

    /// Returns the pointer offset by `count` elements; alias of `add`.
    pub unsafe fn offset(self: NonNull<T>, count: i64) -> NonNull<T> {
        unsafe { return self.add(count); }
    }
}
