// Logos standard library — std.result
//
// Result<T, E> — value-or-error type (Ok(T) or Err(E)).
// Use ? operator to propagate Err early from functions returning Result<_, E>.
//
// Phase 4a SL-sl-04: faithful Rust method surface mirroring SL-sl-03 (Option).

package logos.lang.result;

use logos.lang.option;
use logos.lang.panic;

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    // CP-cm-17 (closed 2026-05-17): take &self rather than self by
    // value. Self-by-value consumed non-Copy payloads (Vec/String/...)
    // so the caller's follow-up `.unwrap()` read a moved-from Vec and
    // double-freed. Rust's signatures are `&self` for the same reason.
    // The match-arm `_` payload-drop fix (sema_stmt.cpp's VariantData
    // bind_pattern_ref now filters `_`) lets the match body type-check
    // through `&Result<T,E>` without re-introducing the consumption.
    pub fn is_ok(self: &Result<T, E>) -> bool {
        match self {
            Result::Ok(_)  => { return true; }
            Result::Err(_) => { return false; }
        }
    }

    pub fn is_err(self: &Result<T, E>) -> bool {
        match self {
            Result::Ok(_)  => { return false; }
            Result::Err(_) => { return true; }
        }
    }

    pub fn is_ok_and(self: Result<T, E>, pred: fn(T) -> bool) -> bool {
        match self {
            Result::Ok(v)  => { return pred(v); }
            Result::Err(_) => { return false; }
        }
    }

    pub fn is_err_and(self: Result<T, E>, pred: fn(E) -> bool) -> bool {
        match self {
            Result::Ok(_)  => { return false; }
            Result::Err(e) => { return pred(e); }
        }
    }

    pub fn unwrap(self: Result<T, E>) -> T {
        match self {
            Result::Ok(v)  => { return v; }
            Result::Err(_) => { panic("called `Result::unwrap()` on an `Err` value"); }
        }
    }

    pub fn unwrap_err(self: Result<T, E>) -> E {
        match self {
            Result::Ok(_)  => { panic("called `Result::unwrap_err()` on an `Ok` value"); }
            Result::Err(e) => { return e; }
        }
    }

    pub fn expect(self: Result<T, E>, msg: str) -> T {
        match self {
            Result::Ok(v)  => { return v; }
            Result::Err(_) => { panic(msg); }
        }
    }

    pub fn expect_err(self: Result<T, E>, msg: str) -> E {
        match self {
            Result::Ok(_)  => { panic(msg); }
            Result::Err(e) => { return e; }
        }
    }

    pub fn unwrap_or(self: Result<T, E>, default: T) -> T {
        match self {
            Result::Ok(v)  => { return v; }
            Result::Err(_) => { return default; }
        }
    }

    pub fn unwrap_or_else(self: Result<T, E>, f: fn(E) -> T) -> T {
        match self {
            Result::Ok(v)  => { return v; }
            Result::Err(e) => { return f(e); }
        }
    }

    pub fn ok(self: Result<T, E>) -> Option<T> {
        match self {
            Result::Ok(v)  => { return Option::Some(v); }
            Result::Err(_) => { return Option::None; }
        }
    }

    pub fn err(self: Result<T, E>) -> Option<E> {
        match self {
            Result::Ok(_)  => { return Option::None; }
            Result::Err(e) => { return Option::Some(e); }
        }
    }

    pub fn map<U>(self: Result<T, E>, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Result::Ok(v)  => { return Result::Ok(f(v)); }
            Result::Err(e) => { return Result::Err(e); }
        }
    }

    pub fn map_err<F>(self: Result<T, E>, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Result::Ok(v)  => { return Result::Ok(v); }
            Result::Err(e) => { return Result::Err(f(e)); }
        }
    }

    // Returns `default` (if Err) or applies `f` to the contained Ok value.
    pub fn map_or<U>(self: Result<T, E>, default: U, f: fn(T) -> U) -> U {
        match self {
            Result::Ok(v)  => { return f(v); }
            Result::Err(_) => { return default; }
        }
    }

    // Maps a Result<T,E> to U by applying `f` to Ok, or `dfl` to Err.
    pub fn map_or_else<U>(self: Result<T, E>, dfl: fn(E) -> U, f: fn(T) -> U) -> U {
        match self {
            Result::Ok(v)  => { return f(v); }
            Result::Err(e) => { return dfl(e); }
        }
    }

    pub fn and<U>(self: Result<T, E>, res: Result<U, E>) -> Result<U, E> {
        match self {
            Result::Ok(_)  => { return res; }
            Result::Err(e) => { return Result::Err(e); }
        }
    }

    pub fn or<F>(self: Result<T, E>, res: Result<T, F>) -> Result<T, F> {
        match self {
            Result::Ok(v)  => { return Result::Ok(v); }
            Result::Err(_) => { return res; }
        }
    }

    pub fn and_then<U>(self: Result<T, E>, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Result::Ok(v)  => { return f(v); }
            Result::Err(e) => { return Result::Err(e); }
        }
    }

    pub fn or_else<F>(self: Result<T, E>, f: fn(E) -> Result<T, F>) -> Result<T, F> {
        match self {
            Result::Ok(v)  => { return Result::Ok(v); }
            Result::Err(e) => { return f(e); }
        }
    }
}

// Free-function shims for compat with pre-existing call-sites.
pub fn unwrap_or_i32(r: Result<i32, i32>, def: i32) -> i32 {
    return r.unwrap_or(def);
}
pub fn is_ok_i32(r: Result<i32, i32>) -> bool {
    return r.is_ok();
}
pub fn is_err_i32(r: Result<i32, i32>) -> bool {
    return r.is_err();
}
