// Logos standard library — std.result
//
// Result<T, E> — value-or-error type (Ok(T) or Err(E)).
// Use ? operator to propagate Err early from functions returning Result<_, E>.
//
// Phase 4a SL-sl-04: faithful Rust method surface mirroring SL-sl-03 (Option).

package logos.lang.result;

use logos.lang.option;
use logos.lang.panic;

/// Represents either success (`Ok(T)`) or failure (`Err(E)`).
///
/// The `?` operator propagates `Err` early from functions returning `Result<_, E>`.
pub enum Result<T, E> {
    /// Contains the success value.
    Ok(T),
    /// Contains the error value.
    Err(E),
}

impl<T, E> Result<T, E> {
    // CP-cm-17 leg (b): `&self` rather than by-value so chained-temporary
    // callers (`a.and(n).is_ok()`) and non-Copy payloads don't get
    // consumed by the predicate.
    /// Returns `true` if the result is `Ok`.
    pub fn is_ok(&self) -> bool {
        match self {
            Result::Ok(_)  => { return true; }
            Result::Err(_) => { return false; }
        }
    }

    /// Returns `true` if the result is `Err`.
    pub fn is_err(&self) -> bool {
        match self {
            Result::Ok(_)  => { return false; }
            Result::Err(_) => { return true; }
        }
    }

    /// Returns `true` if the result is `Ok` and `pred` returns `true` for the contained value.
    ///
    /// Consumes `self` (the value is passed to `pred` by value).
    pub fn is_ok_and(self: Result<T, E>, pred: fn(T) -> bool) -> bool {
        match self {
            Result::Ok(v)  => { return pred(v); }
            Result::Err(_) => { return false; }
        }
    }

    /// Returns `true` if the result is `Err` and `pred` returns `true` for the contained error.
    ///
    /// Consumes `self` (the error is passed to `pred` by value).
    pub fn is_err_and(self: Result<T, E>, pred: fn(E) -> bool) -> bool {
        match self {
            Result::Ok(_)  => { return false; }
            Result::Err(e) => { return pred(e); }
        }
    }

    /// Returns the contained `Ok` value; panics if the result is `Err`.
    ///
    /// The panic message is fixed — the error value is not formatted into it.
    pub fn unwrap(self: Result<T, E>) -> T {
        match self {
            Result::Ok(v)  => { return v; }
            Result::Err(_) => { panic("called `Result::unwrap()` on an `Err` value"); }
        }
    }

    /// Returns the contained `Err` value; panics if the result is `Ok`.
    pub fn unwrap_err(self: Result<T, E>) -> E {
        match self {
            Result::Ok(_)  => { panic("called `Result::unwrap_err()` on an `Ok` value"); }
            Result::Err(e) => { return e; }
        }
    }

    /// Returns the contained `Ok` value; panics with `msg` if the result is `Err`.
    pub fn expect(self: Result<T, E>, msg: str) -> T {
        match self {
            Result::Ok(v)  => { return v; }
            Result::Err(_) => { panic(msg); }
        }
    }

    /// Returns the contained `Err` value; panics with `msg` if the result is `Ok`.
    pub fn expect_err(self: Result<T, E>, msg: str) -> E {
        match self {
            Result::Ok(_)  => { panic(msg); }
            Result::Err(e) => { return e; }
        }
    }

    /// Returns the contained `Ok` value or `default`.
    ///
    /// `default` is eagerly evaluated; use `unwrap_or_else` for a lazily computed fallback.
    pub fn unwrap_or(self: Result<T, E>, default: T) -> T {
        match self {
            Result::Ok(v)  => { return v; }
            Result::Err(_) => { return default; }
        }
    }

    /// Returns the contained `Ok` value or computes a fallback from the error with `f`.
    pub fn unwrap_or_else(self: Result<T, E>, f: fn(E) -> T) -> T {
        match self {
            Result::Ok(v)  => { return v; }
            Result::Err(e) => { return f(e); }
        }
    }

    /// Converts to `Option<T>`: `Ok(v)` becomes `Some(v)`, discarding the error.
    pub fn ok(self: Result<T, E>) -> Option<T> {
        match self {
            Result::Ok(v)  => { return Option::Some(v); }
            Result::Err(_) => { return Option::None; }
        }
    }

    /// Converts to `Option<E>`: `Err(e)` becomes `Some(e)`, discarding the success value.
    pub fn err(self: Result<T, E>) -> Option<E> {
        match self {
            Result::Ok(_)  => { return Option::None; }
            Result::Err(e) => { return Option::Some(e); }
        }
    }

    /// Applies `f` to a contained `Ok` value, leaving an `Err` value untouched.
    pub fn map<U>(self: Result<T, E>, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Result::Ok(v)  => { return Result::Ok(f(v)); }
            Result::Err(e) => { return Result::Err(e); }
        }
    }

    /// Applies `f` to a contained `Err` value, leaving an `Ok` value untouched.
    pub fn map_err<F>(self: Result<T, E>, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Result::Ok(v)  => { return Result::Ok(v); }
            Result::Err(e) => { return Result::Err(f(e)); }
        }
    }

    /// Returns `default` if `Err`, or applies `f` to the contained `Ok` value.
    pub fn map_or<U>(self: Result<T, E>, default: U, f: fn(T) -> U) -> U {
        match self {
            Result::Ok(v)  => { return f(v); }
            Result::Err(_) => { return default; }
        }
    }

    /// Maps to `U` by applying `f` to a contained `Ok` value, or `dfl` to a contained `Err`.
    pub fn map_or_else<U>(self: Result<T, E>, dfl: fn(E) -> U, f: fn(T) -> U) -> U {
        match self {
            Result::Ok(v)  => { return f(v); }
            Result::Err(e) => { return dfl(e); }
        }
    }

    /// Returns `res` if the result is `Ok`, otherwise the `Err` value of `self`.
    ///
    /// `res` is eagerly evaluated; use `and_then` for a lazily computed continuation.
    pub fn and<U>(self: Result<T, E>, res: Result<U, E>) -> Result<U, E> {
        match self {
            Result::Ok(_)  => { return res; }
            Result::Err(e) => { return Result::Err(e); }
        }
    }

    /// Returns `res` if the result is `Err`, otherwise the `Ok` value of `self`.
    ///
    /// `res` is eagerly evaluated; use `or_else` for a lazily computed fallback.
    pub fn or<F>(self: Result<T, E>, res: Result<T, F>) -> Result<T, F> {
        match self {
            Result::Ok(v)  => { return Result::Ok(v); }
            Result::Err(_) => { return res; }
        }
    }

    /// Calls `f` with the contained `Ok` value, otherwise propagates the `Err`.
    pub fn and_then<U>(self: Result<T, E>, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Result::Ok(v)  => { return f(v); }
            Result::Err(e) => { return Result::Err(e); }
        }
    }

    /// Calls `f` with the contained `Err` value, otherwise propagates the `Ok`.
    pub fn or_else<F>(self: Result<T, E>, f: fn(E) -> Result<T, F>) -> Result<T, F> {
        match self {
            Result::Ok(v)  => { return Result::Ok(v); }
            Result::Err(e) => { return f(e); }
        }
    }

    // Borrowing introspectors — Rust shape.
    /// Converts from `&Result<T, E>` to `Result<&T, &E>`, borrowing the contained value.
    pub fn as_ref(self: &Result<T, E>) -> Result<&T, &E> {
        match self {
            Result::Ok(ref v)  => { return Result::<&T, &E>::Ok(v); }
            Result::Err(ref e) => { return Result::<&T, &E>::Err(e); }
        }
    }

    /// Converts from `&mut Result<T, E>` to `Result<&mut T, &mut E>`.
    pub fn as_mut(self: &mut Result<T, E>) -> Result<&mut T, &mut E> {
        match self {
            Result::Ok(ref mut v)  => { return Result::<&mut T, &mut E>::Ok(v); }
            Result::Err(ref mut e) => { return Result::<&mut T, &mut E>::Err(e); }
        }
    }
}

// `unwrap_or_default` lives as a free fn (an `impl<T: Default, E>
// Result<T, E>` block triggers a mono cascade — see
// [[baghunt-partial-spec-inherent-impl]] for the broader pattern).
/// Returns the contained `Ok` value, or `T::default()` if `Err`.
///
/// Free-fn form of Rust's `Result::unwrap_or_default`.
pub fn result_unwrap_or_default<T: Default, E>(r: Result<T, E>) -> T {
    match r {
        Result::Ok(v)  => { return v; }
        Result::Err(_) => { return T::default(); }
    }
}

// `flatten` (Result<Result<T,E>,E> -> Result<T,E>) and `transpose`
// (Result<Option<T>,E> -> Option<Result<T,E>>) live as free-fn forms
// because Logos doesn't yet support partial-spec INHERENT impl blocks
// on nested generic shapes. The cascade that previously broke these
// signatures is now closed (sema turbofish-on-enum-lit fix + mono
// Phase 1 `contains_typevar` gate).
/// Removes one level of `Result` nesting; free-fn form of `flatten`.
pub fn result_flatten<T, E>(r: Result<Result<T, E>, E>) -> Result<T, E> {
    match r {
        Result::Ok(inner) => { return inner; }
        Result::Err(e)    => { return Result::<T, E>::Err(e); }
    }
}

/// Transposes a `Result` of an `Option` into an `Option` of a `Result`; free-fn form of
/// `transpose`.
///
/// `Ok(None)` → `None`; `Ok(Some(v))` → `Some(Ok(v))`; `Err(e)` → `Some(Err(e))`.
pub fn result_transpose<T, E>(r: Result<Option<T>, E>) -> Option<Result<T, E>> {
    match r {
        Result::Ok(inner) => {
            match inner {
                Option::Some(v) => { return Option::<Result<T, E>>::Some(Result::<T, E>::Ok(v)); }
                Option::None    => { return Option::<Result<T, E>>::None; }
            }
        }
        Result::Err(e) => { return Option::<Result<T, E>>::Some(Result::<T, E>::Err(e)); }
    }
}

// ── Inherent partial-spec impls — Rust-shape method syntax ──────────────
//
// Mirror Rust's `Result::<Result<T,E>,E>::flatten` /
// `Result::<Option<T>,E>::transpose`. Sema partial-spec inherent impl
// on nested generic shapes works after the turbofish-on-enum-lit fix +
// mono Phase 1 contains_typevar gate.

impl<T, E> Result<Result<T, E>, E> {
    /// Removes one level of nesting: `Ok(inner)` yields `inner`, `Err(e)` stays `Err(e)`.
    pub fn flatten(self: Result<Result<T, E>, E>) -> Result<T, E> {
        match self {
            Result::Ok(inner) => { return inner; }
            Result::Err(e)    => { return Result::<T, E>::Err(e); }
        }
    }
}

impl<T, E> Result<Option<T>, E> {
    /// Transposes a `Result` of an `Option` into an `Option` of a `Result`.
    ///
    /// `Ok(None)` → `None`; `Ok(Some(v))` → `Some(Ok(v))`; `Err(e)` → `Some(Err(e))`.
    pub fn transpose(self: Result<Option<T>, E>) -> Option<Result<T, E>> {
        match self {
            Result::Ok(inner) => {
                match inner {
                    Option::Some(v) => { return Option::<Result<T, E>>::Some(Result::<T, E>::Ok(v)); }
                    Option::None    => { return Option::<Result<T, E>>::None; }
                }
            }
            Result::Err(e) => { return Option::<Result<T, E>>::Some(Result::<T, E>::Err(e)); }
        }
    }
}

// Free-function shims for compat with pre-existing call-sites.
/// Returns the contained `Ok` value or `def`; `i32`-monomorphic shim for `unwrap_or`.
pub fn unwrap_or_i32(r: Result<i32, i32>, def: i32) -> i32 {
    return r.unwrap_or(def);
}
/// Returns `true` if `r` is `Ok`; `i32`-monomorphic shim for `is_ok`.
pub fn is_ok_i32(r: Result<i32, i32>) -> bool {
    return r.is_ok();
}
/// Returns `true` if `r` is `Err`; `i32`-monomorphic shim for `is_err`.
pub fn is_err_i32(r: Result<i32, i32>) -> bool {
    return r.is_err();
}
