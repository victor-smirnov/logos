// Logos stdlib — std.lang.ops
//
// Rust-compatible operator-overload trait family. Mirrors core::ops in
// shape. Each trait is single-type (Self = RHS = Output) for now;
// Rust's flexible `BitAnd<Rhs = Self>` default-generic-param form will
// land when a port needs heterogeneous types.
//
// Primitive operator semantics (`+`, `-`, `&`, etc.) are handled by
// codegen directly on integer / bool types — these traits provide the
// METHOD-CALL surface (`a.bitand(b)`) used by ported Rust code.

package logos.lang.ops;

// ── Arithmetic ────────────────────────────────────────────────────
//
// SL-sl-01: trait declarations. Primitive `+` etc. are handled by
// codegen directly via the `Type__add` mangled-name lookup. These
// traits provide the METHOD-CALL surface (`a.add(b)`) and let ported
// Rust code write `impl Add for MyType`. No primitive impls yet —
// add on demand.

pub trait Add {
    fn add(self: Self, rhs: Self) -> Self;
}
pub trait Sub {
    fn sub(self: Self, rhs: Self) -> Self;
}
pub trait Mul {
    fn mul(self: Self, rhs: Self) -> Self;
}
pub trait Div {
    fn div(self: Self, rhs: Self) -> Self;
}
pub trait Rem {
    fn rem(self: Self, rhs: Self) -> Self;
}
pub trait Neg {
    fn neg(self: Self) -> Self;
}
pub trait Shl {
    fn shl(self: Self, rhs: Self) -> Self;
}
pub trait Shr {
    fn shr(self: Self, rhs: Self) -> Self;
}

// ── Bitwise ───────────────────────────────────────────────────────

pub trait BitAnd {
    fn bitand(self: Self, rhs: Self) -> Self;
}
pub trait BitOr {
    fn bitor(self: Self, rhs: Self) -> Self;
}
pub trait BitXor {
    fn bitxor(self: Self, rhs: Self) -> Self;
}
pub trait Not {
    fn not(self: Self) -> Self;
}

// ── Primitive impls for bool ─────────────────────────────────────

impl BitAnd for bool {
    fn bitand(self: Self, rhs: Self) -> Self { return self & rhs; }
}
impl BitOr for bool {
    fn bitor(self: Self, rhs: Self) -> Self { return self | rhs; }
}
impl BitXor for bool {
    fn bitxor(self: Self, rhs: Self) -> Self { return self ^ rhs; }
}
impl Not for bool {
    fn not(self: Self) -> Self { return !self; }
}

// ── Fn / FnMut / FnOnce — callable traits ─────────────────────────
//
// Mirrors `core::ops::{Fn, FnMut, FnOnce}`. Uses Logos's value-level
// variadic pack (`A...`) for the argument list and an associated
// `Output` type for the return — matches Rust's `FnOnce<Args>`
// shape with associated `type Output;` and `fn call_once(self,
// args: Args) -> Self::Output`.
//
// Semantic ladder:
//   FnOnce  — consumes self (one-shot, e.g. closures owning move-only
//             captures). Receiver: `self: Self`.
//   FnMut   — mutable reuse (closure mutates its captures). Receiver:
//             `&mut self`.
//   Fn      — shared reuse (closure only reads its captures). Receiver:
//             `&self`.
//
// In Rust these form a supertrait chain `Fn: FnMut: FnOnce`. Logos
// trait supertraits exist, but enforcing the chain here forces every
// implementor (closures, fn ptrs) to provide all three method bodies,
// which the compiler can't auto-derive yet. They're declared as
// independent traits now; Step B will add the supertrait relations
// once closure / fn-ptr blanket impls are wired and the auto-derive
// of weaker-from-stronger methods (`call_mut` from `call`, etc.) is
// in place.

pub trait FnOnce<A...> {
    type Output;
    fn call_once(self: Self, args: A...) -> Self::Output;
}

pub trait FnMut<A...> {
    type Output;
    fn call_mut(&mut self, args: A...) -> Self::Output;
}

pub trait Fn<A...> {
    type Output;
    fn call(&self, args: A...) -> Self::Output;
}
