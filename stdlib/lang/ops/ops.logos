// ── Fn / FnMut / FnOnce — callable traits ─────────────────────────
//
// Mirrors `core::ops::{Fn, FnMut, FnOnce}`. Uses Logos's value-level
// variadic pack (`A...`) for the argument list and an associated
// `Output` type for the return — matches Rust's `FnOnce<Args>`
// shape with associated `type Output;` and `fn call_once(self,
// args: Args) -> Self::Output`.
//
// Semantic ladder:
//   FnOnce  — consumes self (one-shot, e.g. closures owning move-only
//             captures). Receiver: `self: Self`.
//   FnMut   — mutable reuse (closure mutates its captures). Receiver:
//             `&mut self`.
//   Fn      — shared reuse (closure only reads its captures). Receiver:
//             `&self`.
//
// In Rust these form a supertrait chain `Fn: FnMut: FnOnce`. Logos
// trait supertraits exist, but enforcing the chain here forces every
// implementor (closures, fn ptrs) to provide all three method bodies,
// which the compiler can't auto-derive yet. They're declared as
// independent traits now; Step B will add the supertrait relations
// once closure / fn-ptr blanket impls are wired and the auto-derive
// of weaker-from-stronger methods (`call_mut` from `call`, etc.) is
// in place.

/// Overloads call syntax for callables consumed by the call (by-value receiver).
pub trait FnOnce<A...> {
    type Output;
    /// Performs the call, consuming `self`.
    fn call_once(self: Self, args: A...) -> Self::Output;
}

/// Overloads call syntax for callables that may mutate captured state.
pub trait FnMut<A...> {
    type Output;
    /// Performs the call, mutably borrowing `self`.
    fn call_mut(&mut self, args: A...) -> Self::Output;
}

/// Overloads call syntax for callables that only read captured state.
pub trait Fn<A...> {
    type Output;
    /// Performs the call, immutably borrowing `self`.
    fn call(&self, args: A...) -> Self::Output;
}

// ── Deref / DerefMut — pointer-like indirection traits ────────────────
//
// Mirrors `core::ops::{Deref, DerefMut}`. Rust uses an associated type
// `type Target;`; Logos models `Target` as a trait type-parameter to
// share the trait machinery used by `Iterator<Item>` (associated types
// outside the Fn-family aren't wired yet).
//
// Semantic surface today:
//   `*x` for `x: T` where `T: Deref<U>` → `*(&*x)` → U.
//   `*x = v` requires `DerefMut` (not yet auto-dispatched; write today
//   via explicit `*x.deref_mut() = v`).
//   Method-autoderef-through-Deref (Rust's `box.method()` calling a
//   method on the pointee) is deferred — call explicitly via `(*box).m()`
//   or `&*box.m()`.
//
// Box<T> auto-deref for `*box` is special-cased in sema; it predates
// these traits. New types should `impl Deref` to opt into the same
// surface.

/// Overloads immutable dereference: `*x` on a `Deref` type yields the pointee.
pub trait Deref<Target> {
    /// Dereferences the value, yielding a shared reference to the pointee.
    fn deref(&self) -> &Target;
}

/// Overloads mutable dereference; `*x = v` is not yet auto-dispatched (call `deref_mut`).
pub trait DerefMut<Target>: Deref<Target> {
    /// Mutably dereferences the value, yielding an exclusive reference to the pointee.
    fn deref_mut(&mut self) -> &mut Target;
}

// ── Index / IndexMut — `[]` operator traits ──────────────────────────
//
// Mirrors `core::ops::{Index, IndexMut}`. Like Deref above, `Output` is
// a trait type-parameter rather than an associated type.
//
// Semantic surface today:
//   `a[i]` for `a: T` where `T: Index<I, U>` → `*(a.index(i))` → U.
//   `a[i] = v` requires `IndexMut` (not yet auto-dispatched; write via
//   explicit `*a.index_mut(i) = v`).
//
// Primitive `[i]` on arrays/slices/refs is handled directly by codegen
// (no trait dispatch); this trait covers user types like maps.

/// Overloads immutable indexing: `a[i]` on user types (e.g. maps).
pub trait Index<Idx, Output> {
    /// Returns a shared reference to the element at `idx`; may panic if out of bounds.
    fn index(&self, idx: Idx) -> &Output;
}

/// Overloads mutable indexing; `a[i] = v` is not yet auto-dispatched (call `index_mut`).
pub trait IndexMut<Idx, Output>: Index<Idx, Output> {
    /// Returns a mutable reference to the element at `idx`; may panic if out of bounds.
    fn index_mut(&mut self, idx: Idx) -> &mut Output;
}

// ── ControlFlow — `Iterator::try_*` / short-circuit driver ────────────
//
// Mirrors `core::ops::ControlFlow<B, C>`. Drives the short-circuit
// iterator terminals (`try_fold`, `try_for_each`, etc.): `Continue(c)`
// keeps iterating with new accumulator `c`, `Break(b)` halts and
// surfaces `b` as the terminal result.
//
// Divergence from Rust:
//   - Rust default-parameterises `C = ()`; Logos doesn't carry default
//     generic args yet, so the continue payload is always spelled
//     explicitly. Use `ControlFlow<E, ()>` for "Break-only" flows.
//   - Rust gives `ControlFlow` an unstable `Try`/`FromResidual` impl
//     used to let `?` route ControlFlow values. Logos's `?` operator
//     lowering is compiler-builtin (B100 TRY_EXPR desugar) and doesn't
//     consult traits; routing `?` through ControlFlow is a follow-up
//     once the broader `core::ops::try_trait` surface lands.

/// Directs short-circuiting operations: keep going with a `C`, or halt early with a `B`.
pub enum ControlFlow<B, C> {
    /// Keeps the operation going, carrying the updated accumulator/state.
    Continue(C),
    /// Halts the operation early, carrying the terminal result.
    Break(B),
}

impl<B, C> ControlFlow<B, C> {
    /// Returns `true` if this is `Continue`.
    pub fn is_continue(&self) -> bool {
        match self {
            ControlFlow::Continue(_) => { return true; }
            ControlFlow::Break(_)    => { return false; }
        }
    }
    /// Returns `true` if this is `Break`.
    pub fn is_break(&self) -> bool {
        match self {
            ControlFlow::Continue(_) => { return false; }
            ControlFlow::Break(_)    => { return true; }
        }
    }

    // Convert to Option<C> / Option<B>. Mirror of Rust's
    // `continue_value`/`break_value`.
    /// Returns the `Continue` payload as `Some`, or `None` if `Break`; consumes `self`.
    pub fn continue_value(self: Self) -> Option<C> {
        match self {
            ControlFlow::Continue(c) => { return Option::<C>::Some(c); }
            ControlFlow::Break(_)    => { return Option::<C>::None; }
        }
    }
    /// Returns the `Break` payload as `Some`, or `None` if `Continue`; consumes `self`.
    pub fn break_value(self: Self) -> Option<B> {
        match self {
            ControlFlow::Continue(_) => { return Option::<B>::None; }
            ControlFlow::Break(b)    => { return Option::<B>::Some(b); }
        }
    }

    // Map either side, leaving the other intact. Rust signature uses
    // FnOnce; FnMut is the wider bound that Logos's iter terminals
    // already exercise — matches the rest of this module's surface.
    /// Maps the `Continue` payload with `f`, passing `Break` through unchanged.
    pub fn map_continue<C2, MapCFn: FnMut(C) -> C2>(self: Self, f: MapCFn) -> ControlFlow<B, C2> {
        let mut g: MapCFn = f;
        match self {
            ControlFlow::Continue(c) => {
                return ControlFlow::<B, C2>::Continue(g(c));
            }
            ControlFlow::Break(b)    => {
                return ControlFlow::<B, C2>::Break(b);
            }
        }
    }
    /// Maps the `Break` payload with `f`, passing `Continue` through unchanged.
    pub fn map_break<B2, MapBFn: FnMut(B) -> B2>(self: Self, f: MapBFn) -> ControlFlow<B2, C> {
        let mut g: MapBFn = f;
        match self {
            ControlFlow::Continue(c) => {
                return ControlFlow::<B2, C>::Continue(c);
            }
            ControlFlow::Break(b)    => {
                return ControlFlow::<B2, C>::Break(g(b));
            }
        }
    }
}
