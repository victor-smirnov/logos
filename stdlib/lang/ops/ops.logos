// Logos stdlib — std.lang.ops
//
// Rust-compatible operator-overload trait family. Mirrors core::ops in
// shape. Each trait is single-type (Self = RHS = Output) for now;
// Rust's flexible `BitAnd<Rhs = Self>` default-generic-param form will
// land when a port needs heterogeneous types.
//
// Primitive operator semantics (`+`, `-`, `&`, etc.) are handled by
// codegen directly on integer / bool types — these traits provide the
// METHOD-CALL surface (`a.bitand(b)`) used by ported Rust code.

package logos.lang.ops;

use logos.lang.option;

// ── Arithmetic ────────────────────────────────────────────────────
//
// SL-sl-01: trait declarations. Primitive `+` etc. are handled by
// codegen directly via the `Type__add` mangled-name lookup. These
// traits provide the METHOD-CALL surface (`a.add(b)`) and let ported
// Rust code write `impl Add for MyType`. No primitive impls yet —
// add on demand.

/// Overloads the binary `+` operator.
pub trait Add<Rhs = Self> {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Performs the `+` operation.
    fn add(self: Self, rhs: Rhs) -> Self::Output;
}
/// Overloads the binary `-` operator.
pub trait Sub<Rhs = Self> {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Performs the `-` operation.
    fn sub(self: Self, rhs: Rhs) -> Self::Output;
}
/// Overloads the binary `*` operator.
pub trait Mul<Rhs = Self> {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Performs the `*` operation.
    fn mul(self: Self, rhs: Rhs) -> Self::Output;
}
/// Overloads the binary `/` operator.
pub trait Div<Rhs = Self> {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Performs the `/` operation.
    fn div(self: Self, rhs: Rhs) -> Self::Output;
}
/// Overloads the binary `%` (remainder) operator.
pub trait Rem<Rhs = Self> {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Performs the `%` operation.
    fn rem(self: Self, rhs: Rhs) -> Self::Output;
}
/// Overloads the unary `-` (negation) operator.
pub trait Neg {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Returns the negation of `self`.
    fn neg(self: Self) -> Self::Output;
}
/// Overloads the binary `<<` (left-shift) operator.
pub trait Shl<Rhs = Self> {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Performs the `<<` operation.
    fn shl(self: Self, rhs: Rhs) -> Self::Output;
}
/// Overloads the binary `>>` (right-shift) operator.
pub trait Shr<Rhs = Self> {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Performs the `>>` operation.
    fn shr(self: Self, rhs: Rhs) -> Self::Output;
}

// ── Bitwise ───────────────────────────────────────────────────────

/// Overloads the binary `&` (bitwise AND) operator.
pub trait BitAnd<Rhs = Self> {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Performs the `&` operation.
    fn bitand(self: Self, rhs: Rhs) -> Self::Output;
}
/// Overloads the binary `|` (bitwise OR) operator.
pub trait BitOr<Rhs = Self> {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Performs the `|` operation.
    fn bitor(self: Self, rhs: Rhs) -> Self::Output;
}
/// Overloads the binary `^` (bitwise XOR) operator.
pub trait BitXor<Rhs = Self> {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Performs the `^` operation.
    fn bitxor(self: Self, rhs: Rhs) -> Self::Output;
}
/// Overloads the unary `!` (logical/bitwise NOT) operator.
pub trait Not {
    /// The result type of the operation (Rust's `Output`).
    type Output;
    /// Returns the logical/bitwise negation of `self`.
    fn not(self: Self) -> Self::Output;
}

// ── *Assign — in-place compound operators ─────────────────────────
//
// Mirrors `core::ops::{AddAssign, SubAssign, MulAssign, DivAssign,
// RemAssign, BitAndAssign, BitOrAssign, BitXorAssign, ShlAssign,
// ShrAssign}`. Each takes `&mut self` and a Self-typed rhs, mutates
// in place, returns nothing. Rust shape: `fn add_assign(&mut self,
// rhs: Self)` with default param `Rhs = Self`; Logos uses Self=Rhs
// (default-generic-param not wired).
//
// Operator surface: `x += y` for a user-typed struct x that impls
// AddAssign dispatches to `x.add_assign(y)` (sema-level rewrite).
// Without the impl, falls through to the existing `x = x + y` desugar
// which dispatches via Add (creates a new Self). Primitive `+=`/`-=`/
// etc. are codegen-builtin and don't consult these traits.

/// Overloads the `+=` operator, adding `rhs` in place.
pub trait AddAssign<Rhs = Self>    { fn add_assign(&mut self,    rhs: Rhs); }
/// Overloads the `-=` operator, subtracting `rhs` in place.
pub trait SubAssign<Rhs = Self>    { fn sub_assign(&mut self,    rhs: Rhs); }
/// Overloads the `*=` operator, multiplying by `rhs` in place.
pub trait MulAssign<Rhs = Self>    { fn mul_assign(&mut self,    rhs: Rhs); }
/// Overloads the `/=` operator, dividing by `rhs` in place.
pub trait DivAssign<Rhs = Self>    { fn div_assign(&mut self,    rhs: Rhs); }
/// Overloads the `%=` operator, taking the remainder by `rhs` in place.
pub trait RemAssign<Rhs = Self>    { fn rem_assign(&mut self,    rhs: Rhs); }
/// Overloads the `&=` operator, bitwise-ANDing with `rhs` in place.
pub trait BitAndAssign<Rhs = Self> { fn bitand_assign(&mut self, rhs: Rhs); }
/// Overloads the `|=` operator, bitwise-ORing with `rhs` in place.
pub trait BitOrAssign<Rhs = Self>  { fn bitor_assign(&mut self,  rhs: Rhs); }
/// Overloads the `^=` operator, bitwise-XORing with `rhs` in place.
pub trait BitXorAssign<Rhs = Self> { fn bitxor_assign(&mut self, rhs: Rhs); }
/// Overloads the `<<=` operator, left-shifting by `rhs` in place.
pub trait ShlAssign<Rhs = Self>    { fn shl_assign(&mut self,    rhs: Rhs); }
/// Overloads the `>>=` operator, right-shifting by `rhs` in place.
pub trait ShrAssign<Rhs = Self>    { fn shr_assign(&mut self,    rhs: Rhs); }

// ── Primitive impls for bool ─────────────────────────────────────

impl BitAnd for bool {
    type Output = Self;
    fn bitand(self: Self, rhs: Self) -> Self { return self & rhs; }
}
impl BitOr for bool {
    type Output = Self;
    fn bitor(self: Self, rhs: Self) -> Self { return self | rhs; }
}
impl BitXor for bool {
    type Output = Self;
    fn bitxor(self: Self, rhs: Self) -> Self { return self ^ rhs; }
}
impl Not for bool {
    type Output = Self;
    fn not(self: Self) -> Self { return !self; }
}

// ── Primitive operator impls (Rust: `impl Add for i64 { type Output = i64; … }`) ──
// What lets `T: Add<Output = T>` (and the rest) be instantiated at a primitive.
// The bodies use the builtin operator; a concrete primitive `a + b` never
// dispatches through these.
impl Add for i8 { type Output = i8; fn add(self: i8, rhs: i8) -> i8 { return self + rhs; } }
impl AddAssign for i8 { fn add_assign(&mut self, rhs: i8) { *self = *self + rhs; } }
impl Sub for i8 { type Output = i8; fn sub(self: i8, rhs: i8) -> i8 { return self - rhs; } }
impl SubAssign for i8 { fn sub_assign(&mut self, rhs: i8) { *self = *self - rhs; } }
impl Mul for i8 { type Output = i8; fn mul(self: i8, rhs: i8) -> i8 { return self * rhs; } }
impl MulAssign for i8 { fn mul_assign(&mut self, rhs: i8) { *self = *self * rhs; } }
impl Div for i8 { type Output = i8; fn div(self: i8, rhs: i8) -> i8 { return self / rhs; } }
impl DivAssign for i8 { fn div_assign(&mut self, rhs: i8) { *self = *self / rhs; } }
impl Rem for i8 { type Output = i8; fn rem(self: i8, rhs: i8) -> i8 { return self % rhs; } }
impl RemAssign for i8 { fn rem_assign(&mut self, rhs: i8) { *self = *self % rhs; } }
impl BitAnd for i8 { type Output = i8; fn bitand(self: i8, rhs: i8) -> i8 { return self & rhs; } }
impl BitAndAssign for i8 { fn bitand_assign(&mut self, rhs: i8) { *self = *self & rhs; } }
impl BitOr for i8 { type Output = i8; fn bitor(self: i8, rhs: i8) -> i8 { return self | rhs; } }
impl BitOrAssign for i8 { fn bitor_assign(&mut self, rhs: i8) { *self = *self | rhs; } }
impl BitXor for i8 { type Output = i8; fn bitxor(self: i8, rhs: i8) -> i8 { return self ^ rhs; } }
impl BitXorAssign for i8 { fn bitxor_assign(&mut self, rhs: i8) { *self = *self ^ rhs; } }
impl Shl for i8 { type Output = i8; fn shl(self: i8, rhs: i8) -> i8 { return self << rhs; } }
impl ShlAssign for i8 { fn shl_assign(&mut self, rhs: i8) { *self = *self << rhs; } }
impl Shr for i8 { type Output = i8; fn shr(self: i8, rhs: i8) -> i8 { return self >> rhs; } }
impl ShrAssign for i8 { fn shr_assign(&mut self, rhs: i8) { *self = *self >> rhs; } }
impl Neg for i8 { type Output = i8; fn neg(self: i8) -> i8 { return -self; } }
impl Not for i8 { type Output = i8; fn not(self: i8) -> i8 { return !self; } }
