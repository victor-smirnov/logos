// logos.lang.pin — Pin<P>: a pointer whose pointee will never move again.
//
// Mirrors core::pin::Pin. The guarantee is the Rust one: for `T: !Unpin`,
// once a value is reachable only through a Pin, safe code can never obtain
// a `&mut T` / by-value T to move it; `unsafe` entry points carry the
// pin-contract obligation.
//
// In Logos the need is narrower than in Rust (see docs/DIVERGENCES.md §A8):
// fibres are stackful (no self-referential state machines) and `#[pinned]`
// arena residents have no value form at all. Pin exists for Rust-source
// ports and for APIs with a genuine movable-then-anchored phase.
//
// Unpin is a REAL auto trait here: everything is Unpin unless it stores a
// `PhantomPinned`, is `#[pinned]`, or has an explicit `impl !Unpin`.

package logos.lang.pin;

use logos.lang.marker;     // Unpin, PhantomPinned
use logos.lang.ops;        // Deref / DerefMut

/// Wraps a pointer `P`, guaranteeing the pointee never moves again.
/// For `T: !Unpin`, safe code cannot obtain `&mut T` or a by-value `T` through the pin.
pub struct Pin<P> {
    pointer: P,
}

// Rust-conformant: Pin<P> is Copy only when P is (refs yes, Box NO). The
// earlier blanket `impl<P> Copy` made Pin<Box<T>> Copy — a "move" of it
// bitwise-copied and BOTH bindings dropped: double free (adversarial t03).
impl<P: Copy> Copy for Pin<P> {}

// ── Generic core (Rust's core::pin::Pin primitives) ──────────────────────────
// The single unsafe constructor plus controlled accessors over the private
// `pointer` field. Every Pin<P> is built and unwrapped through here. The
// alloc-tier impls — Pin<Box<T>>, which name Box and so live in the mem tier
// (logos.mem.boxed, Rust's alloc Box::pin) — reach the wrapped pointer through
// these accessors, so the field stays private AND lang never depends on mem.
impl<P> Pin<P> {
    /// Creates a pin around `pointer` (Rust's `Pin::new_unchecked`).
    /// Unsafe: the caller promises `pointer`'s pointee never moves again.
    pub unsafe fn new_unchecked(pointer: P) -> Pin<P> {
        return Pin { pointer: pointer };
    }
    /// Borrows the wrapped pointer itself.
    /// Unsafe: the caller must not use it to move or replace the pointee.
    pub unsafe fn pointer_ref(self: &Pin<P>) -> &P {
        return &self.pointer;
    }
    /// Mutably borrows the wrapped pointer itself.
    /// Unsafe: the caller must not move the pointee or swap in a pointer to unpinned state.
    pub unsafe fn pointer_mut(self: &mut Pin<P>) -> &mut P {
        return &mut self.pointer;
    }
    /// Unwraps the pin into its pointer (Rust's `Pin::into_inner_unchecked`).
    /// Unsafe: the caller must keep honoring the pin contract for the pointee.
    pub unsafe fn into_pointer_unchecked(self: Pin<P>) -> P {
        return self.pointer;
    }
}

// ── Construction ─────────────────────────────────────────────────────────────

impl<T: Unpin> Pin<&T> {
    /// Pins a shared reference; safe because `T: Unpin` makes the pin guarantee vacuous.
    pub fn new(r: &T) -> Pin<&T> {
        return Pin { pointer: r };
    }
    /// Unwraps the pin, returning the shared reference; safe because `T: Unpin`.
    pub fn into_inner(self: Pin<&T>) -> &T {
        return self.pointer;
    }
}

impl<T: Unpin> Pin<&mut T> {
    /// Pins a mutable reference; safe because `T: Unpin` makes the pin guarantee vacuous.
    pub fn new(r: &mut T) -> Pin<&mut T> {
        return Pin { pointer: r };
    }
    /// Unwraps the pin, returning the mutable reference; safe because `T: Unpin`.
    pub fn into_inner(self: Pin<&mut T>) -> &mut T {
        return self.pointer;
    }
}

impl<T> Pin<&T> {
    /// Returns a shared reference to the pinned value.
    /// Safe for any `T`: shared access can never move the pointee.
    pub fn get_ref(self: Pin<&T>) -> &T {
        return self.pointer;
    }
}

impl<T> Pin<&mut T> {
    /// Reborrows the pin as a shared `Pin<&T>`.
    pub fn as_ref(self: &Pin<&mut T>) -> Pin<&T> {
        return Pin { pointer: &*self.pointer };
    }
    /// Returns a mutable reference to the pinned value even for `!Unpin` targets.
    /// Unsafe: the caller promises never to move the value out of it.
    pub unsafe fn get_unchecked_mut(self: Pin<&mut T>) -> &mut T {
        return self.pointer;
    }
}

impl<T: Unpin> Pin<&mut T> {
    /// Returns a mutable reference to the pinned value; safe because `T: Unpin`.
    pub fn get_mut(self: Pin<&mut T>) -> &mut T {
        return self.pointer;
    }
}

// ── Deref: a pinned pointer reads like its target ────────────────────────────

impl<T> Deref<T> for Pin<&T> {
    fn deref(self: &Pin<&T>) -> &T { return &*self.pointer; }
}

impl<T> Deref<T> for Pin<&mut T> {
    fn deref(self: &Pin<&mut T>) -> &T { return &*self.pointer; }
}

// DerefMut only when the target is Unpin (Rust's conditional impl) — for
// !Unpin targets the only mutable access is unsafe get_unchecked_mut.
impl<T: Unpin> DerefMut<T> for Pin<&mut T> {
    fn deref_mut(self: &mut Pin<&mut T>) -> &mut T { return &mut *self.pointer; }
}

// Pin<Box<T>> (heap-pinning, Rust's alloc Box::pin) lives in the mem tier
// next to Box — see logos.mem.boxed (stdlib/mem/boxed/pin_box.logos). It
// reaches Pin's private pointer through the generic accessors above, so the
// lang tier does not depend on mem.
