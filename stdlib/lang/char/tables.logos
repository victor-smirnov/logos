    0x9u32, 0xDu32, 0x20u32, 0x20u32, 0x85u32, 0x85u32, 0xA0u32, 0xA0u32,
    0x1680u32, 0x1680u32, 0x2000u32, 0x200Au32, 0x2028u32, 0x2029u32, 0x202Fu32, 0x202Fu32,
    0x205Fu32, 0x205Fu32, 0x3000u32, 0x3000u32,
];

static CONTROL: [u32; 4] = [
    0x0u32, 0x1Fu32, 0x7Fu32, 0x9Fu32,
];

// `c` lies in one of `t`'s ranges: binary search over the range starts.
fn in_ranges(t: &[u32], c: u32) -> bool {
    let mut lo: i64 = 0;
    let mut hi: i64 = t.len() / 2;
    while lo < hi {
        let mid: i64 = (lo + hi) / 2;
        if c < t[2 * mid] { hi = mid; }
        else if c > t[2 * mid + 1] { lo = mid + 1; }
        else { return true; }
    }
    return false;
}
