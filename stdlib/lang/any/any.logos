// Logos standard library — logos.lang.any
//
// `core::any` mirror: runtime type identity (`TypeId`), the `Any` trait with
// a blanket `impl<T> Any for T`, and `&dyn Any` downcasting.
//
// TypeId is the nominal type UID the compiler already computes for every type
// via `type_of::<T>().uid` — a 64-bit hash of the canonical (named) type
// string, so distinct nominal types differ even at identical layout (unlike
// the structural `type_hash`). This matches Rust's `TypeId` semantics.
//
// Divergence from Rust / current limits:
//   - No `'static` bound on `Any` (Logos has no lifetime-bound trait gating
//     yet).
//   - `&dyn Any` works for STRUCT / enum types (the blanket `type_id` is
//     instantiated for every concrete struct/enum and wired into the dyn
//     vtable). A PRIMITIVE behind `&dyn Any` (`&5 as &dyn Any`) only works if
//     that primitive's `type_id` was also instantiated by a direct
//     `x.type_id()` use — the eager blanket-instantiation pass doesn't cover
//     primitives reached solely through dyn-coercion. Follow-up:
//     [[baghunt-any-primitive-dyn-and-downcast]].
//   - `downcast_ref` / `downcast_mut` are NOT yet provided: recovering `&T`
//     from `&dyn Any` needs the fat-pointer data word, and the `&dyn → ptr`
//     cast mis-extracts inside a *generic* body (works non-generically).
//     Same follow-up. `is` + `type_id` (this module) are the sound surface.

package logos.lang.any;

use logos.lang.option;
use logos.lang.cmp;

// Opaque, comparable type identity — the compiler's 128-bit nominal type UID,
// carried as two u64 halves (`lo` = bits 0..63, `hi` = bits 64..127). 128 bits
// drops the cross-type collision probability from 2^-64 to 2^-128 (matching
// Rust's TypeId), which matters because a collision = an unsound `downcast`.
pub struct TypeId {
    pub lo: u64,
    pub hi: u64,
}

impl Copy for TypeId {}

impl Eq for TypeId {
    fn eq(self: &Self, other: &Self) -> bool {
        return self.lo == other.lo && self.hi == other.hi;
    }
}

// `TypeId::of::<T>()` analogue. `type_uid` / `type_uid_hi` are the low/high 64
// bits of the compiler's nominal type UID (hash of the canonical named type
// string); both folded at mono.
pub fn type_id_of<T>() -> TypeId {
    return TypeId { lo: type_uid::<T>(), hi: type_uid_hi::<T>() };
}

// The `Any` trait. The blanket impl makes every type `Any` (Rust shape).
pub trait Any {
    fn type_id(&self) -> TypeId;
}

impl<T> Any for T {
    fn type_id(&self) -> TypeId { return type_id_of::<T>(); }
}

// `(dyn Any).is::<T>()` analogue — does the erased value hold a `T`?
// Sound for struct / enum erased values (see the primitive caveat in the
// module header).
pub fn any_is<T>(a: &dyn Any) -> bool {
    let lhs: TypeId = a.type_id();
    let rhs: TypeId = type_id_of::<T>();
    return lhs.lo == rhs.lo && lhs.hi == rhs.hi;
}

// NOTE: downcast_ref / downcast_mut intentionally omitted until the
// generic-body `&dyn → ptr` data-word extraction is fixed — see the module
// header + [[baghunt-any-primitive-dyn-and-downcast]]. `is` + `type_id` are
// the sound surface today.
