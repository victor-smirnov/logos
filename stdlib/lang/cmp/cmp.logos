// Logos standard library — std.cmp
//
// Eq trait — total equality. Float types are intentionally not impl'd
// because NaN != NaN breaks total equality; use a separate PartialEq
// later if needed. For HashMap<K, V> K must be Eq + Hash.

package logos.lang.cmp;

use logos.lang.str;
use logos.lang.option;
use logos.lang.result;

/// Total equality: `PartialEq` whose `eq` is reflexive (Rust's `core::cmp::Eq`).
/// A marker — `eq` / `ne` are `PartialEq`'s. Not implemented for floats (NaN != NaN).
#[lang = "eq"]
pub trait Eq: PartialEq {}

/// Defines partial equality via `eq`, with `ne` derived by default.
/// Unlike `Eq`, does not require totality — implemented for floats where NaN != NaN.
#[lang = "partial_eq"]
pub trait PartialEq {
    /// Returns `true` if `self` and `other` are equal.
    fn eq(&self, other: &Self) -> bool;
    /// Returns `true` if `self` and `other` are not equal; the default derives it from `eq`.
    fn ne(&self, other: &Self) -> bool { return !self.eq(other); }
}
/// Partial ordering (Rust's `core::cmp::PartialOrd`): `partial_cmp` answers `None` for an
/// incomparable pair (a NaN), and every ordered comparison of such a pair is `false`.
#[lang = "partial_ord"]
pub trait PartialOrd: PartialEq {
    /// The ordering of `self` relative to `other`, or `None` when they are incomparable.
    fn partial_cmp(&self, other: &Self) -> Option<Ordering>;
    /// `self < other`.
    fn lt(&self, other: &Self) -> bool { return cmp_opt_is_lt(self.partial_cmp(other)); }
    /// `self <= other`.
    fn le(&self, other: &Self) -> bool { return cmp_opt_is_le(self.partial_cmp(other)); }
    /// `self > other`.
    fn gt(&self, other: &Self) -> bool { return cmp_opt_is_gt(self.partial_cmp(other)); }
    /// `self >= other`.
    fn ge(&self, other: &Self) -> bool { return cmp_opt_is_ge(self.partial_cmp(other)); }
}

// f32 / f64 PartialEq impls — IEEE equality semantics (NaN != NaN).
// Logos's primitive `==` on floats already does the IEEE compare, so
// `*self == *other` returns false when either side is NaN. These
// can't impl Eq (no total order on NaN) but PartialEq is enough for
// the common `assert_eq!(a, b)` driver pattern.
impl PartialEq for f32 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl PartialEq for f64 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
// IEEE order: a NaN on either side is incomparable.
impl PartialOrd for f32 {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        if *self < *other { return Option::Some(Ordering::Less); }
        if *self > *other { return Option::Some(Ordering::Greater); }
        if *self == *other { return Option::Some(Ordering::Equal); }
        return Option::None;
    }
}
impl PartialOrd for f64 {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        if *self < *other { return Option::Some(Ordering::Less); }
        if *self > *other { return Option::Some(Ordering::Greater); }
        if *self == *other { return Option::Some(Ordering::Equal); }
        return Option::None;
    }
}

impl PartialEq for i32 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i32 {}
impl PartialEq for i64 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i64 {}
impl PartialEq for u32 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u32 {}
impl PartialEq for u64 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u64 {}
impl PartialEq for u8 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u8 {}
impl PartialEq for i8 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i8 {}
impl PartialEq for u16 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u16 {}
impl PartialEq for i16 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i16 {}
impl PartialEq for bool { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for bool {}
impl PartialEq for usize { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for usize {}
impl PartialEq for isize { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for isize {}
// THE 128-BIT AND PACKED WIDTHS. These were held out by a comment claiming that
// `impl Eq for u128 { *self == *other }` SEGFAULTS AT THE CALL. It does not, and
// it is not clear it ever did on this tree: re-measured 2026-08-05 at c6c212c7,
// user-placed AND stdlib-placed, the claim's own probe (a `Vec<u128>` sorted
// through the language's `<`, then `w.eq(&w)` on the sorted maximum) returns
// true and exits 0. The exercise is `wql_el_cmp_measured` — it calls `eqv::<K>`,
// a generic that can only reach the value through the trait method, on every
// lattice type including these six, and it is where a real one would surface.
impl PartialEq for u128 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u128 {}
impl PartialEq for i128 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i128 {}
impl PartialEq for u56 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u56 {}
impl PartialEq for i56 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i56 {}
impl PartialEq for u24 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u24 {}
impl PartialEq for i24 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i24 {}
impl PartialEq for char { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for char {}
impl PartialEq for str {
    fn eq(&self, other: &Self) -> bool {
        // self / other are `&str` which canonicalises to `Slice<u8>` (str
        // is the value form of UnsizedSlice<u8>). Pass through directly.
        return str_eq(self, other);
    }
}
impl Eq for str {}

// By-reference Eq, Rust's `impl<A: ?Sized + PartialEq<B>, B: ?Sized> PartialEq<&B> for &A`:
// a reference compares as its referent does (`&str`, the elements of a by-ref
// iterator), as `Ord for &T` and `Debug for &T` already do.
impl<T: PartialEq> PartialEq for &T {
    fn eq(&self, other: &&T) -> bool { return (**self).eq(*other); }
}
impl<T: Eq> Eq for &T {}
impl<T: PartialEq> PartialEq for &mut T {
    fn eq(&self, other: &&mut T) -> bool { return (**self).eq(&**other); }
}
impl<T: Eq> Eq for &mut T {}

// Raw pointers compare by ADDRESS (Rust: `impl<T: ?Sized> PartialEq for *const T`
// / `*mut T`) — the pointee is never read.
impl<T> PartialEq for *const T {
    fn eq(&self, other: &Self) -> bool { return (*self as usize) == (*other as usize); }
}
impl<T> Eq for *const T {}
impl<T> PartialEq for *mut T {
    fn eq(&self, other: &Self) -> bool { return (*self as usize) == (*other as usize); }
}
impl<T> Eq for *mut T {}

// Tuple Eq — single variadic-arity impl covering any tuple shape.
// Replaces the per-arity hand-rolled impls (2/3/4) that lived here
// previously. `tuple_all_eq::<Self>(self, other)` defers to mono-time
// expansion (B110) when `Self = (A...)` is still pack-bound. Sema's
// variadic-tuple dispatch site (lower_binop `==`/`!=`, B111)
// pack-binds A to the concrete tuple's element list, so
// `Self → (T1, T2, ...)` substitutes correctly through
// `subst_type_sema`'s Tuple-pack-expansion fast-path.
impl<A...: PartialEq> PartialEq for (A...) {
    fn eq(self: &Self, other: &Self) -> bool {
        return tuple_all_eq::<Self>(self, other);
    }
    fn ne(self: &Self, other: &Self) -> bool {
        return !tuple_all_eq::<Self>(self, other);
    }
}
impl<A...: Eq> Eq for (A...) {}

// Arrays compare element-wise (Rust's `impl<T: PartialEq, const N: usize> PartialEq
// for [T; N]`), so `[T; N]` meets a `K: PartialEq` bound in generic code.
impl<T: PartialEq, const N: usize> PartialEq for [T; N] {
    fn eq(&self, other: &Self) -> bool {
        let mut i: usize = 0usize;
        while i < N {
            if !(self[i] == other[i]) { return false; }
            i = i + 1usize;
        }
        return true;
    }
}
impl<T: Eq, const N: usize> Eq for [T; N] {}

/// Element-wise equality of two slices (Rust's `impl PartialEq for [T]`): equal
/// lengths and `a[i] == b[i]` for every `i`. The lowering of `==` / `!=` over
/// slices whose elements are not primitives.
pub fn slice_eq<T: PartialEq>(a: &[T], b: &[T]) -> bool {
    let n: i64 = a.len() as i64;
    if n != b.len() as i64 { return false; }
    unsafe { return slice_eq_raw::<T>(a.as_ptr() as *const T, b.as_ptr() as *const T, n); }
}

/// `n` elements at `pa` equal `n` elements at `pb`, compared through
/// references (no element is copied or moved). The lowering of `==` / `!=`
/// over arrays — nested ones included, whose elements are contiguous — of
/// non-primitive elements.
/// SAFETY: `pa` and `pb` each point at `n` initialized `T`s.
pub unsafe fn slice_eq_raw<T: PartialEq>(pa: *const T, pb: *const T, n: i64) -> bool {
    let esz: i64 = sizeof::<T>() as i64;
    let mut i: i64 = 0i64;
    while i < n {
        let x: &T = &*((pa as i64 + i * esz) as *const T);
        let y: &T = &*((pb as i64 + i * esz) as *const T);
        if !(x == y) { return false; }
        i = i + 1i64;
    }
    return true;
}

// NOTE on `ref` and on the `*`: `self`/`other` are `&Self`, so the payload
// bindings must be borrows — a plain `Some(a)` bound BY VALUE would move the
// payload out of the borrow and drop it at arm exit (a double free for an owned
// payload like String). Two spellings give a borrow and they are not
// interchangeable. Matching the reference itself (`match self`) sets the
// default binding mode to `ref` (`pat.binding.default-by-ref-mode`), under
// which `pat.binding.modifier-requires-move-mode` — the Rust 2024 rule —
// forbids writing a modifier at all. So the scrutinee is dereferenced: `match
// *self` leaves the default mode `move`, and the written `ref a` is then the
// thing that makes the binding a borrow.
impl<T: PartialEq> PartialEq for Option<T> {
    fn eq(self: &Self, other: &Self) -> bool {
        match *self {
            Option::Some(ref a) => { match *other { Option::Some(ref b) => { return *a == *b; } Option::None => { return false; } } }
            Option::None => { match *other { Option::Some(ref b) => { return false; } Option::None => { return true; } } }
        }
    }
}
impl<T: Eq> Eq for Option<T> {}

impl<T: PartialEq, E: PartialEq> PartialEq for Result<T, E> {
    fn eq(self: &Self, other: &Self) -> bool {
        match *self {
            Result::Ok(ref a) => { match *other { Result::Ok(ref b) => { return *a == *b; } Result::Err(ref b) => { return false; } } }
            Result::Err(ref a) => { match *other { Result::Ok(ref b) => { return false; } Result::Err(ref b) => { return *a == *b; } } }
        }
    }
}
impl<T: Eq, E: Eq> Eq for Result<T, E> {}
