// Logos standard library — std.cmp
//
// Eq trait — total equality. Float types are intentionally not impl'd
// because NaN != NaN breaks total equality; use a separate PartialEq
// later if needed. For HashMap<K, V> K must be Eq + Hash.

package logos.lang.cmp;

use logos.lang.str;
use logos.lang.option;
use logos.lang.result;

/// Defines total equality via `eq`, with `ne` derived by default.
/// Not implemented for floats — NaN != NaN breaks totality; see `PartialEq` instead.
pub trait Eq {
    /// Returns `true` if `self` and `other` are equal.
    fn eq(&self, other: &Self) -> bool;
    /// Returns `true` if `self` and `other` are not equal; the default derives it from `eq`.
    // Mirrors Rust's `PartialEq::ne(&self, &Self) -> bool { !self.eq(other) }`.
    fn ne(&self, other: &Self) -> bool { return !self.eq(other); }
}

// SL-sl-02: Rust's hierarchy is `Eq: PartialEq` (every Eq is PartialEq).
// Logos pre-2026-05-15 declared `PartialEq` as an empty marker for
// forward-compat. Now `PartialEq` actually carries `eq`/`ne` so floats
// (which can't impl total `Eq` because NaN != NaN) can still satisfy
// equality bounds, and so user code with `T: PartialEq` can call
// `t1.eq(&t2)`. Existing `impl Eq for X` blocks continue to provide
// `eq` via the bound-check fallback in sema_collect.cpp that treats
// `Eq` as a PartialEq satisfier — no per-impl migration needed for
// the integer types.
/// Defines partial equality via `eq`, with `ne` derived by default.
/// Unlike `Eq`, does not require totality — implemented for floats where NaN != NaN.
pub trait PartialEq {
    /// Returns `true` if `self` and `other` are equal.
    fn eq(&self, other: &Self) -> bool;
    /// Returns `true` if `self` and `other` are not equal; the default derives it from `eq`.
    fn ne(&self, other: &Self) -> bool { return !self.eq(other); }
}
// PartialOrd kept as an empty marker — full method shape
// (`partial_cmp(&self, other: &Self) -> Option<Ordering>`) needs
// `Option<Ordering>` to flow through bound-check, and the existing
// `impl Ord for X` provides `cmp` returning bare `Ordering` rather
// than `Option<Ordering>`. The marker plus the sema bound-check
// fallback (Ord ⇒ PartialOrd) covers the integer types. Floats need
// a separate `partial_cmp` shape — deferred until a driver appears.
/// Marker trait for partial ordering — currently empty pending a `partial_cmp` method shape.
pub trait PartialOrd {}

// f32 / f64 PartialEq impls — IEEE equality semantics (NaN != NaN).
// Logos's primitive `==` on floats already does the IEEE compare, so
// `*self == *other` returns false when either side is NaN. These
// can't impl Eq (no total order on NaN) but PartialEq is enough for
// the common `assert_eq!(a, b)` driver pattern.
impl PartialEq for f32 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl PartialEq for f64 { fn eq(&self, other: &Self) -> bool { return *self == *other; } }

impl Eq for i32  { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i64  { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u32  { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u64  { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u8   { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i8   { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for u16  { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for i16  { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for bool { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for usize { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for isize { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for char  { fn eq(&self, other: &Self) -> bool { return *self == *other; } }
impl Eq for str   {
    fn eq(&self, other: &Self) -> bool {
        // self / other are `&str` which canonicalises to `Slice<u8>` (str
        // is the value form of UnsizedSlice<u8>). Pass through directly.
        return str_eq(*self, *other);
    }
}

// Tuple Eq — single variadic-arity impl covering any tuple shape.
// Replaces the per-arity hand-rolled impls (2/3/4) that lived here
// previously. `tuple_all_eq::<Self>(self, other)` defers to mono-time
// expansion (B110) when `Self = (A...)` is still pack-bound. Sema's
// variadic-tuple dispatch site (lower_binop `==`/`!=`, B111)
// pack-binds A to the concrete tuple's element list, so
// `Self → (T1, T2, ...)` substitutes correctly through
// `subst_type_sema`'s Tuple-pack-expansion fast-path.
impl<A...: Eq> Eq for (A...) {
    fn eq(self: &Self, other: &Self) -> bool {
        return tuple_all_eq::<Self>(self, other);
    }
    fn ne(self: &Self, other: &Self) -> bool {
        return !tuple_all_eq::<Self>(self, other);
    }
}

// NOTE on `ref`: `self`/`other` are `&Self`, so the payload bindings use the
// explicit `ref a` form — they bind `a: &T` (a borrow), NOT by value. A plain
// `Some(a)` against a `&Option<T>` would move the payload out of the borrow and
// drop it at arm exit (double-free for an owned payload like String). Logos has
// not yet implemented Rust's default binding modes (RFC 2005 match ergonomics),
// under which `ref` would be implicit here; `ref` is the working idiom until
// then. See baghunt-match-ref-enum-default-binding-modes.
impl<T: Eq> Eq for Option<T> {
    fn eq(self: &Self, other: &Self) -> bool {
        match self {
            Option::Some(ref a) => { match other { Option::Some(ref b) => { return *a == *b; } Option::None => { return false; } } }
            Option::None => { match other { Option::Some(ref b) => { return false; } Option::None => { return true; } } }
        }
    }
}

impl<T: Eq, E: Eq> Eq for Result<T, E> {
    fn eq(self: &Self, other: &Self) -> bool {
        match self {
            Result::Ok(ref a) => { match other { Result::Ok(ref b) => { return *a == *b; } Result::Err(ref b) => { return false; } } }
            Result::Err(ref a) => { match other { Result::Ok(ref b) => { return false; } Result::Err(ref b) => { return *a == *b; } } }
        }
    }
}
