// Logos standard library — std.iter
//
// Iterator trait + adapters + terminal operations.
// Adapters take fn-pointer transformers; non-capturing closures coerce automatically.

package logos.lang.iter;

use logos.lang.option;
use logos.lang.cmp;
use logos.lang.ops;

// ── FromIterator trait ───────────────────────────────────────────────────────
//
// Rust's `core::iter::FromIterator<A>` — `B: FromIterator<A>` says
// "values of type A can be collected into B". `Iterator::collect<B>`
// dispatches via this. Logos's Vec impl in std.collections.vec.

pub trait FromIterator<A> {
    fn from_iter<I: Iterator<A>>(iter: I) -> Self;
}

// ── Sum / Product traits ─────────────────────────────────────────────────────
//
// Rust's `core::iter::{Sum, Product}`. `.sum<S>()` / `.product<S>()`
// on Iterator dispatch via these. CP-cm-14's extension to primitive
// receivers (mono_clone's prefix-rewrite handles non-Struct types
// too) makes the trait-static call S::sum(self) / S::product(self)
// resolve correctly when S = i32 / i64.

pub trait Sum<A> {
    fn sum<I: Iterator<A>>(iter: I) -> Self;
}

impl Sum<i32> for i32 {
    fn sum<I: Iterator<i32>>(iter: I) -> i32 {
        let mut it: I = iter;
        let mut acc: i32 = 0i32;
        loop {
            match it.next() {
                Option::None    => { return acc; }
                Option::Some(v) => { acc = acc + v; }
            }
        }
    }
}

impl Sum<i64> for i64 {
    fn sum<I: Iterator<i64>>(iter: I) -> i64 {
        let mut it: I = iter;
        let mut acc: i64 = 0 as i64;
        loop {
            match it.next() {
                Option::None    => { return acc; }
                Option::Some(v) => { acc = acc + v; }
            }
        }
    }
}

pub trait Product<A> {
    fn product<I: Iterator<A>>(iter: I) -> Self;
}

impl Product<i32> for i32 {
    fn product<I: Iterator<i32>>(iter: I) -> i32 {
        let mut it: I = iter;
        let mut acc: i32 = 1i32;
        loop {
            match it.next() {
                Option::None    => { return acc; }
                Option::Some(v) => { acc = acc * v; }
            }
        }
    }
}

impl Product<i64> for i64 {
    fn product<I: Iterator<i64>>(iter: I) -> i64 {
        let mut it: I = iter;
        let mut acc: i64 = 1 as i64;
        loop {
            match it.next() {
                Option::None    => { return acc; }
                Option::Some(v) => { acc = acc * v; }
            }
        }
    }
}


// ── Core trait ───────────────────────────────────────────────────────────────

pub trait Iterator<Item> {
    fn next(self: &mut Self) -> Option<Item>;

    // SL-sl-05: ergonomic method shortcuts that wrap the free-function
    // constructors below. Default body constructs the corresponding
    // adapter struct directly. Only `.filter()` lands here today —
    // `.map<R>` and other method-generic-with-fresh-tparam adapters
    // hit a method-generic-mono path that doesn't fully specialise
    // the adapter struct (see baghunt_iter_method_generic_mono.md).
    // Free-function `iter_map(it, f)` is the workaround until that
    // mono path closes.

    fn filter(self: Self, pred: fn(Item) -> bool) -> FilterIter<Self, Item> {
        return FilterIter { inner: self, pred: pred };
    }

    fn map<MapOut, MapFn: FnMut(Item) -> MapOut>(self: Self, f: MapFn) -> MapIter<Self, Item, MapOut, MapFn> {
        return MapIter { inner: self, f: f };
    }

    // SL-sl-05: `.collect<B>` — terminal that pours the iterator into
    // any `B: FromIterator<Item>`. Standard impls: Vec<T>, plus user-
    // defined collections.
    fn collect<C: FromIterator<Item>>(self: Self) -> C {
        return C::from_iter(self);
    }

    // SL-sl-05: `.sum<S>` / `.product<S>` — terminals that fold the
    // iterator into any `S: Sum<Item>` / `S: Product<Item>`.
    // CP-cm-14's primitive-receiver extension makes the trait-static
    // dispatch work for `S = i32 / i64` etc.
    fn sum<S: Sum<Item>>(self: Self) -> S {
        return S::sum(self);
    }
    fn product<S: Product<Item>>(self: Self) -> S {
        return S::product(self);
    }

    // SL-sl-05: min/max terminals — caller supplies an i32 comparator
    // (negative = a < b, zero = equal, positive = a > b) so the trait
    // body doesn't need the Ordering enum (which would force every
    // implementor's pkg to import std.lang.ord transitively).
    unsafe fn min_by(self: Self, cmp: fn(Item, Item) -> i32) -> Option<Item> {
        let mut it: Self = self;
        let mut best: Option<Item> = Option::None;
        loop {
            match it.next() {
                Option::None    => { return best; }
                Option::Some(v) => {
                    let v_copy_a: Item = *((&v) as *const Item);
                    let v_copy_b: Item = *((&v) as *const Item);
                    match best {
                        Option::None    => { best = Option::Some(v); }
                        Option::Some(b) => {
                            let b_copy_a: Item = *((&b) as *const Item);
                            let b_copy_b: Item = *((&b) as *const Item);
                            if cmp(v_copy_a, b_copy_a) < 0i32 {
                                best = Option::Some(v_copy_b);
                            } else {
                                best = Option::Some(b_copy_b);
                            }
                        }
                    }
                }
            }
        }
    }

    unsafe fn max_by(self: Self, cmp: fn(Item, Item) -> i32) -> Option<Item> {
        let mut it: Self = self;
        let mut best: Option<Item> = Option::None;
        loop {
            match it.next() {
                Option::None    => { return best; }
                Option::Some(v) => {
                    let v_copy_a: Item = *((&v) as *const Item);
                    let v_copy_b: Item = *((&v) as *const Item);
                    match best {
                        Option::None    => { best = Option::Some(v); }
                        Option::Some(b) => {
                            let b_copy_a: Item = *((&b) as *const Item);
                            let b_copy_b: Item = *((&b) as *const Item);
                            if cmp(v_copy_a, b_copy_a) > 0i32 {
                                best = Option::Some(v_copy_b);
                            } else {
                                best = Option::Some(b_copy_b);
                            }
                        }
                    }
                }
            }
        }
    }

    // SL-sl-05 method shortcuts for the adapter free fns below. No
    // fresh method-level tparams (Item is impl-bound), so the method-
    // generic-mono machinery isn't needed here. The `unsafe` qualifier
    // matches their free-fn counterparts which require a `zero`
    // sentinel for raw-pointer copies in adapter bodies. The unusual
    // 2nd-arg `zero: Item` placeholder is a workaround for Logos's
    // lack of `mem::zeroed` / `Default` — give the adapter a typed
    // initial value for its `_t` phantom field.
    unsafe fn take_while(self: Self, pred: fn(Item) -> bool, zero: Item)
        -> TakeWhileIter<Self, Item>
    {
        return TakeWhileIter { inner: self, pred: pred, done: false, _t: zero };
    }

    unsafe fn skip_while(self: Self, pred: fn(Item) -> bool, zero: Item)
        -> SkipWhileIter<Self, Item>
    {
        return SkipWhileIter { inner: self, pred: pred, primed: false, _t: zero };
    }

    unsafe fn step_by(self: Self, step: i64, zero: Item)
        -> StepByIter<Self, Item>
    {
        return StepByIter { inner: self, step: step, first: true, _t: zero };
    }

    unsafe fn inspect(self: Self, visit: fn(Item) -> (), zero: Item)
        -> InspectIter<Self, Item>
    {
        return InspectIter { inner: self, visit: visit, _t: zero };
    }

    // Terminal: fold items into an accumulator.
    //
    // Method tparam `FoldFn` is named to avoid clashing with a struct-
    // level `F` on Iterator implementors (e.g. MapIter<I, T, R, F>);
    // sema treats same-name method/impl tparams as specialisation and
    // silently loses the method-level generic.
    fn fold<Acc, FoldFn: FnMut(Acc, Item) -> Acc>(self: Self, init: Acc, f: FoldFn) -> Acc {
        let mut it: Self = self;
        let mut acc: Acc = init;
        let mut g: FoldFn = f;
        loop {
            match it.next() {
                Option::None    => { return acc; }
                Option::Some(v) => { acc = g(acc, v); }
            }
        }
    }

    // Terminal: short-circuiting fold. The reducer returns
    // ControlFlow<BV, Acc> per step — `Continue(new_acc)` keeps going,
    // `Break(bv)` halts and surfaces `bv` immediately. Mirrors Rust's
    // `Iterator::try_fold` minus the Try-trait indirection — Rust
    // signatures it as `try_fold<B, R: Try<...>, F: FnMut(B, Item)->R>`
    // and routes `?`-style values through R; Logos doesn't yet have a
    // Try-trait surface (?'s lowering is compiler-builtin), so we take
    // ControlFlow directly. Same shape Rust uses internally before
    // generalising to Try.
    //
    // Type-param naming follows `fold` — `Acc`/`BV`/`TryFoldFn` to
    // avoid impl-tparam shadowing on iterator adapters.
    fn try_fold<Acc, BV, TryFoldFn: FnMut(Acc, Item) -> ControlFlow<BV, Acc>>(
        self: Self, init: Acc, f: TryFoldFn) -> ControlFlow<BV, Acc>
    {
        let mut it: Self = self;
        let mut acc: Acc = init;
        let mut g: TryFoldFn = f;
        loop {
            match it.next() {
                Option::None    => { return ControlFlow::<BV, Acc>::Continue(acc); }
                Option::Some(v) => {
                    let r: ControlFlow<BV, Acc> = g(acc, v);
                    match r {
                        ControlFlow::Continue(new_acc) => { acc = new_acc; }
                        ControlFlow::Break(bv)         => {
                            return ControlFlow::<BV, Acc>::Break(bv);
                        }
                    }
                }
            }
        }
    }

    // Terminal: applies f to each item, returns the first Some.
    // Equivalent to `.filter_map(f).next()` once filter_map exists.
    // Mirrors Rust's `Iterator::find_map`.
    //
    // Method-level type-param is named `Out` to avoid shadowing
    // impl-block type-params on iterator adapters (ScanIter,
    // FilterMapIter, ChainIter, ZipIter, MapIter all use single-letter
    // tparams like B/R that collide with conventional Rust-style names).
    // Sema treats same-name method/impl tparams as specialisation,
    // silently losing the method-level generic.
    fn find_map<Out, FindMapFn: FnMut(Item) -> Option<Out>>(self: Self, f: FindMapFn) -> Option<Out> {
        let mut it: Self = self;
        let mut g: FindMapFn = f;
        loop {
            match it.next() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    let r: Option<Out> = g(v);
                    match r {
                        Option::Some(_) => { return r; }
                        Option::None    => { }
                    }
                }
            }
        }
    }

    // Terminal: like fold but seeds the accumulator from the first
    // item. Returns None on an empty iterator. Mirrors Rust's
    // `Iterator::reduce`.
    //
    // Inlined fold (rather than `it.fold(init, f)`) because chaining
    // an FnMut-bounded method into another FnMut-bounded method drops
    // the inner call at sema-time in some cases — the type-arg
    // propagation from outer F-tparam into inner F-tparam isn't
    // wired through trait-default-method-default-method dispatch.
    // Tracked as a follow-up to [[baghunt-mapiter-fn-param-mono-loop]].
    fn reduce<ReduceFn: FnMut(Item, Item) -> Item>(self: Self, f: ReduceFn) -> Option<Item> {
        let mut it: Self = self;
        let mut g: ReduceFn = f;
        let first: Option<Item> = it.next();
        match first {
            Option::None    => { return Option::None; }
            Option::Some(v) => {
                unsafe {
                    let mut acc: Item = *((&v) as *const Item);
                    loop {
                        match it.next() {
                            Option::None    => { return Option::Some(acc); }
                            Option::Some(x) => { acc = g(acc, x); }
                        }
                    }
                }
            }
        }
    }

    // Terminal: count items.
    fn count(self: Self) -> i64 {
        let mut it: Self = self;
        let mut n: i64 = 0 as i64;
        loop {
            match it.next() {
                Option::None    => { return n; }
                Option::Some(_) => { n = n + 1 as i64; }
            }
        }
        return n;
    }

    // Terminal: visit each item. Tparam `EachFn` avoids clashing with
    // a struct-level `F` on Iterator implementors.
    fn for_each<EachFn: FnMut(Item) -> ()>(self: Self, f: EachFn) {
        let mut it: Self = self;
        let mut g: EachFn = f;
        loop {
            match it.next() {
                Option::None    => { return; }
                Option::Some(v) => { g(v); }
            }
        }
    }

    // Terminal: short-circuiting for_each. Visitor returns
    // ControlFlow<BV, ()> — `Continue(())` keeps iterating, `Break(bv)`
    // halts and returns the BV. Mirrors Rust's `try_for_each` minus
    // the Try-trait indirection (see try_fold rationale above).
    fn try_for_each<BV, TryEachFn: FnMut(Item) -> ControlFlow<BV, ()>>(
        self: Self, f: TryEachFn) -> ControlFlow<BV, ()>
    {
        let mut it: Self = self;
        let mut g: TryEachFn = f;
        loop {
            match it.next() {
                Option::None    => { return ControlFlow::<BV, ()>::Continue(()); }
                Option::Some(v) => {
                    let r: ControlFlow<BV, ()> = g(v);
                    match r {
                        ControlFlow::Continue(_) => { }
                        ControlFlow::Break(bv)   => {
                            return ControlFlow::<BV, ()>::Break(bv);
                        }
                    }
                }
            }
        }
    }

    // Terminal: any item satisfies the predicate?
    fn any<AnyFn: FnMut(Item) -> bool>(self: Self, pred: AnyFn) -> bool {
        let mut it: Self = self;
        let mut p: AnyFn = pred;
        loop {
            match it.next() {
                Option::None    => { return false; }
                Option::Some(v) => { if p(v) { return true; } }
            }
        }
    }

    // Terminal: every item satisfies the predicate?
    fn all<AllFn: FnMut(Item) -> bool>(self: Self, pred: AllFn) -> bool {
        let mut it: Self = self;
        let mut p: AllFn = pred;
        loop {
            match it.next() {
                Option::None    => { return true; }
                Option::Some(v) => { if !p(v) { return false; } }
            }
        }
    }

    // Terminal: skip first `n` items, then return next.
    // Rust signature: `fn nth(&mut self, n: usize) -> Option<Item>` — takes
    // `&mut self` so the underlying iterator advances past the consumed
    // prefix. Logos mirrors this for nth/find/position; count/last/fold
    // keep by-value self (consuming terminals).
    fn nth(self: &mut Self, n: i64) -> Option<Item> {
        let mut k: i64 = n;
        loop {
            match self.next() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    if k == 0 as i64 { return Option::Some(v); }
                    k = k - 1 as i64;
                }
            }
        }
    }

    // Terminal: first item satisfying the predicate. Rust shape: `&mut self`.
    unsafe fn find<FindFn: FnMut(Item) -> bool>(self: &mut Self, pred: FindFn) -> Option<Item> {
        let mut p: FindFn = pred;
        loop {
            match self.next() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    let v_copy: Item = *((&v) as *const Item);
                    if p(v_copy) { return Option::Some(v); }
                }
            }
        }
    }

    // Terminal: index of first item satisfying the predicate. `&mut self`.
    unsafe fn position<PosFn: FnMut(Item) -> bool>(self: &mut Self, pred: PosFn) -> Option<i64> {
        let mut p: PosFn = pred;
        let mut idx: i64 = 0i64;
        loop {
            match self.next() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    if p(v) { return Option::Some(idx); }
                    idx = idx + 1i64;
                }
            }
        }
    }

    // Terminal: last item, consuming the iterator.
    fn last(self: Self) -> Option<Item> {
        let mut it: Self = self;
        let mut acc: Option<Item> = Option::None;
        loop {
            match it.next() {
                Option::None    => { return acc; }
                Option::Some(v) => { acc = Option::Some(v); }
            }
        }
    }

}

// ── IntoIterator ─────────────────────────────────────────────────────────────
//
// Conversion into an Iterator. Implemented for:
//   - owning types like Vec<T> (consuming)
//   - &Vec<T> (borrowing — yields T by copy)
//   - &mut Vec<T> (mut-borrowing — yields &mut T)
//
// `for x in expr` desugars to `let mut __it = expr.into_iter(); loop { ... }`
// when `expr` has no direct `next()` method.

pub trait IntoIterator<Item> {
    type Iter: Iterator<Item>;
    fn into_iter(self: Self) -> Self::Iter;
}

// ── DoubleEndedIterator ──────────────────────────────────────────────────────
//
// SL-sl-05: an Iterator that can also yield items from the back.
// Matches Rust's `core::iter::DoubleEndedIterator`. Concrete impls:
// SliceIter<T> (here) and VecIter<T> (std.collections.vec). Generic
// adapters that preserve the back-end (e.g. Rev itself, Map of a
// DEI) get their own impl when needed; we don't blanket-derive
// because not every adapter has a sensible back-end.

pub trait DoubleEndedIterator<Item>: Iterator<Item> {
    fn next_back(self: &mut Self) -> Option<Item>;

    // `.rev()` — flip front and back into a RevIter. Trait-default
    // body so every DEI implementor gets it for free.
    fn rev(self: Self) -> RevIter<Self, Item> {
        return RevIter { inner: self, _t_marker: 0i32 };
    }

    // `.nth_back(n)` — skip n items from the back, return the next
    // one. Mirrors Iterator::nth but from the back. Returns None if
    // the iterator exhausts before consuming n+1 items.
    fn nth_back(self: &mut Self, n: i64) -> Option<Item> {
        let mut k: i64 = 0 as i64;
        while k < n {
            let drained: Option<Item> = self.next_back();
            match drained {
                Option::None    => { return Option::None; }
                Option::Some(_) => { k = k + 1 as i64; }
            }
        }
        return self.next_back();
    }
}

// `iter_eq_by` — pairwise equality of two iterators under a custom
// equivalence relation. Returns true iff both iters yield the same
// number of items and `eq(x, y)` holds for each pair.
pub fn iter_eq_by<I: Iterator<T>, J: Iterator<U>, T, U>(
    a: I, b: J, eq: fn(T, U) -> bool,
) -> bool {
    let mut ai: I = a;
    let mut bi: J = b;
    loop {
        let av: Option<T> = ai.next();
        let bv: Option<U> = bi.next();
        match av {
            Option::None    => {
                match bv {
                    Option::None    => { return true; }
                    Option::Some(_) => { return false; }
                }
            }
            Option::Some(x) => {
                match bv {
                    Option::None    => { return false; }
                    Option::Some(y) => {
                        if !eq(x, y) { return false; }
                    }
                }
            }
        }
    }
}

// `iter_cmp` / `iter_lt` / `iter_le` / `iter_gt` / `iter_ge` —
// lexicographic comparison of two iterators where T: Ord. Mirrors
// Rust's `Iterator::{cmp, lt, le, gt, ge}`.
pub fn iter_cmp<I: Iterator<T>, J: Iterator<T>, T: Ord>(a: I, b: J) -> Ordering {
    let mut ai: I = a;
    let mut bi: J = b;
    loop {
        let av: Option<T> = ai.next();
        let bv: Option<T> = bi.next();
        match av {
            Option::None    => {
                match bv {
                    Option::None    => { return Ordering::Equal; }
                    Option::Some(_) => { return Ordering::Less; }
                }
            }
            Option::Some(x) => {
                match bv {
                    Option::None    => { return Ordering::Greater; }
                    Option::Some(y) => {
                        unsafe {
                            let xr: *const T = (&x) as *const T;
                            let yr: *const T = (&y) as *const T;
                            match (&*xr).cmp(&*yr) {
                                Ordering::Equal => { }
                                ord             => { return ord; }
                            }
                        }
                    }
                }
            }
        }
    }
}

pub fn iter_lt<I: Iterator<T>, J: Iterator<T>, T: Ord>(a: I, b: J) -> bool {
    match iter_cmp::<I, J, T>(a, b) {
        Ordering::Less => { return true; }
        _              => { return false; }
    }
}
pub fn iter_le<I: Iterator<T>, J: Iterator<T>, T: Ord>(a: I, b: J) -> bool {
    match iter_cmp::<I, J, T>(a, b) {
        Ordering::Greater => { return false; }
        _                 => { return true; }
    }
}
pub fn iter_gt<I: Iterator<T>, J: Iterator<T>, T: Ord>(a: I, b: J) -> bool {
    match iter_cmp::<I, J, T>(a, b) {
        Ordering::Greater => { return true; }
        _                 => { return false; }
    }
}
pub fn iter_ge<I: Iterator<T>, J: Iterator<T>, T: Ord>(a: I, b: J) -> bool {
    match iter_cmp::<I, J, T>(a, b) {
        Ordering::Less => { return false; }
        _              => { return true; }
    }
}
pub fn iter_ne<I: Iterator<T>, J: Iterator<T>, T: Eq>(a: I, b: J) -> bool {
    return !iter_eq::<I, J, T>(a, b);
}

// `iter_eq` — pairwise equality of two iterators where T: Eq.
pub fn iter_eq<I: Iterator<T>, J: Iterator<T>, T: Eq>(a: I, b: J) -> bool {
    let mut ai: I = a;
    let mut bi: J = b;
    loop {
        let av: Option<T> = ai.next();
        let bv: Option<T> = bi.next();
        match av {
            Option::None    => {
                match bv {
                    Option::None    => { return true; }
                    Option::Some(_) => { return false; }
                }
            }
            Option::Some(x) => {
                match bv {
                    Option::None    => { return false; }
                    Option::Some(y) => {
                        unsafe {
                            let xr: *const T = (&x) as *const T;
                            let yr: *const T = (&y) as *const T;
                            if !(&*xr).eq(&*yr) { return false; }
                        }
                    }
                }
            }
        }
    }
}

// `iter_max_by_key` / `iter_min_by_key` — find item that maximises
// / minimises a key projection. Empty → None.
pub fn iter_max_by_key<I: Iterator<T>, T: Copy, K: Ord>(
    iter: I, key: fn(T) -> K,
) -> Option<T> {
    let mut it: I = iter;
    let mut best: Option<T> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None    => { best = Option::Some(v); }
                    Option::Some(b) => {
                        let kv: K = key(v);
                        let kb: K = key(b);
                        unsafe {
                            let kvr: *const K = (&kv) as *const K;
                            let kbr: *const K = (&kb) as *const K;
                            match (&*kvr).cmp(&*kbr) {
                                Ordering::Greater => { best = Option::Some(v); }
                                _                 => { best = Option::Some(b); }
                            }
                        }
                    }
                }
            }
        }
    }
}

pub fn iter_min_by_key<I: Iterator<T>, T: Copy, K: Ord>(
    iter: I, key: fn(T) -> K,
) -> Option<T> {
    let mut it: I = iter;
    let mut best: Option<T> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None    => { best = Option::Some(v); }
                    Option::Some(b) => {
                        let kv: K = key(v);
                        let kb: K = key(b);
                        unsafe {
                            let kvr: *const K = (&kv) as *const K;
                            let kbr: *const K = (&kb) as *const K;
                            match (&*kvr).cmp(&*kbr) {
                                Ordering::Less => { best = Option::Some(v); }
                                _              => { best = Option::Some(b); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// `iter_rposition` — like `.position` but walking from the back.
// Returns the index (counted from the start of the original
// iterator) of the first item for which `pred` returns true when
// iterating from the back, else None. Requires the iter be both
// DEI and ExactSize so we can convert the "back-th item from the
// end" into a forward index. Free fn because trait-default with
// a method-level supertrait on `Self` isn't reliably dispatching.
pub fn iter_rposition<I: DoubleEndedIterator<T> + ExactSizeIterator<T>, T>(
    iter: I, pred: fn(T) -> bool,
) -> Option<i64> {
    let mut it: I = iter;
    let n: i64 = it.len();
    if n == 0 as i64 { return Option::None; }
    let mut i: i64 = n - 1 as i64;
    loop {
        match it.next_back() {
            Option::None    => { return Option::None; }
            Option::Some(v) => {
                if pred(v) { return Option::Some(i); }
                if i == 0 as i64 { return Option::None; }
                i = i - 1 as i64;
            }
        }
    }
}

// ── ExactSizeIterator ────────────────────────────────────────────────────────
//
// SL-sl-05: an iterator that knows its remaining length exactly.
// Matches Rust's `core::iter::ExactSizeIterator`. Used by adapters
// like TakeIter / EnumIter that need to align front/back from a
// known back-position.

pub trait ExactSizeIterator<Item>: Iterator<Item> {
    fn len(&self) -> i64;

    // Trait-default: an iterator is empty iff its length is 0.
    // Mirrors Rust's `ExactSizeIterator::is_empty` (still unstable
    // on stable Rust as of 2026, but semantics are stable).
    fn is_empty(&self) -> bool {
        return self.len() == 0 as i64;
    }
}

// ── FusedIterator marker ────────────────────────────────────────────
//
// Mirrors `core::iter::FusedIterator`. Marker: an iterator that
// keeps yielding None after the first None. Adapters like Fuse,
// Map, Take, etc. preserve this property; the marker lets generic
// code skip defensive bookkeeping when iterating past the end is
// not a hazard (Rust's stdlib uses it to specialise wrappers like
// `Peekable::peek` and the `try_fold` short-circuit path).
//
// No methods; pure marker trait. Implementors opt in by declaring
// `impl FusedIterator<Item> for MyIter<...>` (no body needed).
// The Iterator supertrait bound is what every Rust-shape consumer
// of `FusedIterator` actually wants.

pub trait FusedIterator<Item>: Iterator<Item> {}

// ── RevIter<I, T> — swap-ends adapter on a DoubleEndedIterator ───────────────
//
// `next()` pulls from the source's back; `next_back()` pulls from
// its front. _t_marker is a zero-sized phantom so the codegen
// instantiates T (no Default trait yet to bottom T out cleanly).

pub struct RevIter<I, T> {
    pub inner: I,
    pub _t_marker: i32,
}

impl<I: DoubleEndedIterator<T>, T> Iterator<T> for RevIter<I, T> {
    fn next(self: &mut RevIter<I, T>) -> Option<T> {
        return self.inner.next_back();
    }
}

impl<I: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for RevIter<I, T> {
    fn next_back(self: &mut RevIter<I, T>) -> Option<T> {
        return self.inner.next();
    }
}

// Free fn — pair with the method form on DoubleEndedIterator.
pub fn iter_rev<I: DoubleEndedIterator<T>, T>(iter: I) -> RevIter<I, T> {
    return RevIter { inner: iter, _t_marker: 0i32 };
}

// ── MapIter<I, T, R, F> — lazy map ──────────────────────────────────────────
//
// Carries the mapper type F as an explicit parameter so capturing
// closures (which have anonymous closure types) work as the mapper.
// fn-pointer call sites pass `F = fn(T) -> R` unchanged.

pub struct MapIter<I, T, R, F> {
    pub inner: I,
    pub f: F,
}

impl<I: Iterator<T>, T, R, F: FnMut(T) -> R> Iterator<R> for MapIter<I, T, R, F> {
    fn next(self: &mut MapIter<I, T, R, F>) -> Option<R> {
        match self.inner.next() {
            Option::Some(v) => { return Option::Some((self.f)(v)); }
            Option::None    => { return Option::None; }
        }
    }
}

pub fn iter_map<I: Iterator<T>, T, R, F: FnMut(T) -> R>(iter: I, f: F) -> MapIter<I, T, R, F> {
    return MapIter { inner: iter, f: f };
}

impl<I: DoubleEndedIterator<T>, T, R, F: FnMut(T) -> R> DoubleEndedIterator<R> for MapIter<I, T, R, F> {
    fn next_back(self: &mut MapIter<I, T, R, F>) -> Option<R> {
        match self.inner.next_back() {
            Option::Some(v) => { return Option::Some((self.f)(v)); }
            Option::None    => { return Option::None; }
        }
    }
}

// ── FilterIter<I, T> — lazy filter ───────────────────────────────────────────

pub struct FilterIter<I, T> {
    pub inner: I,
    pub pred: fn(T) -> bool,
}

impl<I: Iterator<T>, T> Iterator<T> for FilterIter<I, T> {
    fn next(self: &mut FilterIter<I, T>) -> Option<T> {
        unsafe {
            loop {
                match self.inner.next() {
                    Option::Some(v) => {
                        let v_copy: T = *((&v) as *const T);
                        let pred = self.pred;
                        if pred(v_copy) { return Option::Some(v); }
                    }
                    Option::None => { return Option::None; }
                }
            }
        }
    }
}

pub fn iter_filter<I: Iterator<T>, T>(iter: I, pred: fn(T) -> bool) -> FilterIter<I, T> {
    return FilterIter { inner: iter, pred: pred };
}

// ── ScanIter<I, T, St, B> — stateful filter+map ──────────────────────────────
//
// Mirrors Rust's `core::iter::Scan`. Carries a mutable state across
// items; the closure mutates state and yields Option<B>. Yields
// while the closure returns Some; first None ends iteration.

pub struct ScanIter<I, T, St, B> {
    pub inner: I,
    pub state: St,
    pub f:     fn(&mut St, T) -> Option<B>,
}

impl<I: Iterator<T>, T, St, B> Iterator<B> for ScanIter<I, T, St, B> {
    fn next(self: &mut ScanIter<I, T, St, B>) -> Option<B> {
        match self.inner.next() {
            Option::None    => { return Option::None; }
            Option::Some(v) => {
                let f = self.f;
                return f(&mut self.state, v);
            }
        }
    }
}

pub fn iter_scan<I: Iterator<T>, T, St, B>(
    iter: I, state: St, f: fn(&mut St, T) -> Option<B>,
) -> ScanIter<I, T, St, B> {
    return ScanIter { inner: iter, state: state, f: f };
}

// ── FuseIter<I, T> — pin the iterator to None once it's exhausted ────────────
//
// Mirrors Rust's `core::iter::Fuse`. Some iterators may yield Some
// items again after returning None once; Fuse "fuses" the iter so
// subsequent .next() always returns None.

pub struct FuseIter<I, T> {
    pub inner: I,
    pub done:  bool,
    pub _t:    T,
}

impl<I: Iterator<T>, T> Iterator<T> for FuseIter<I, T> {
    fn next(self: &mut FuseIter<I, T>) -> Option<T> {
        if self.done { return Option::None; }
        match self.inner.next() {
            Option::None    => {
                self.done = true;
                return Option::None;
            }
            Option::Some(v) => { return Option::Some(v); }
        }
    }
}

// FuseIter is fused by construction.
impl<I: Iterator<T>, T> FusedIterator<T> for FuseIter<I, T> {}

impl<I: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for FuseIter<I, T> {
    fn next_back(self: &mut FuseIter<I, T>) -> Option<T> {
        if self.done { return Option::None; }
        match self.inner.next_back() {
            Option::None    => {
                self.done = true;
                return Option::None;
            }
            Option::Some(v) => { return Option::Some(v); }
        }
    }
}

pub unsafe fn iter_fuse<I: Iterator<T>, T>(iter: I, zero: T) -> FuseIter<I, T> {
    return FuseIter { inner: iter, done: false, _t: zero };
}

// ── FilterMapIter<I, T, B> — lazy filter+map combo ──────────────────────────
//
// Mirrors Rust's `core::iter::FilterMap`. `f` returns `Option<B>`;
// items where f returns None are skipped, items where f returns
// `Some(b)` yield b.

pub struct FilterMapIter<I, T, B> {
    pub inner: I,
    pub f:     fn(T) -> Option<B>,
}

impl<I: Iterator<T>, T, B> Iterator<B> for FilterMapIter<I, T, B> {
    fn next(self: &mut FilterMapIter<I, T, B>) -> Option<B> {
        loop {
            match self.inner.next() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    let f = self.f;
                    let r: Option<B> = f(v);
                    match r {
                        Option::Some(_) => { return r; }
                        Option::None    => { }
                    }
                }
            }
        }
    }
}

impl<I: DoubleEndedIterator<T>, T, B> DoubleEndedIterator<B> for FilterMapIter<I, T, B> {
    fn next_back(self: &mut FilterMapIter<I, T, B>) -> Option<B> {
        loop {
            match self.inner.next_back() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    let f = self.f;
                    let r: Option<B> = f(v);
                    match r {
                        Option::Some(_) => { return r; }
                        Option::None    => { }
                    }
                }
            }
        }
    }
}

pub fn iter_filter_map<I: Iterator<T>, T, B>(
    iter: I, f: fn(T) -> Option<B>,
) -> FilterMapIter<I, T, B> {
    return FilterMapIter { inner: iter, f: f };
}

// DEI: walk back through the source, returning the first item from
// the back that satisfies the predicate. Front and back can advance
// independently — the underlying DEI keeps front/back cursors
// distinct, so a filter-walking-back never collides with one
// walking-forward unless they meet.
impl<I: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for FilterIter<I, T> {
    fn next_back(self: &mut FilterIter<I, T>) -> Option<T> {
        unsafe {
            loop {
                match self.inner.next_back() {
                    Option::Some(v) => {
                        let v_copy: T = *((&v) as *const T);
                        let pred = self.pred;
                        if pred(v_copy) { return Option::Some(v); }
                    }
                    Option::None => { return Option::None; }
                }
            }
        }
    }
}

// ── TakeIter<I, T> — limit to first n items ──────────────────────────────────

pub struct TakeIter<I, T> {
    inner: I,
    remaining: i64,
    _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for TakeIter<I, T> {
    fn next(self: &mut TakeIter<I, T>) -> Option<T> {
        if self.remaining <= 0 as i64 { return Option::None; }
        self.remaining = self.remaining - 1 as i64;
        return self.inner.next();
    }
}

pub unsafe fn iter_take<I: Iterator<T>, T>(iter: I, n: i64, zero: T) -> TakeIter<I, T> {
    return TakeIter { inner: iter, remaining: n, _t: zero };
}

// DEI: requires inner: ExactSizeIterator so we know how much to
// drop from the back to align with the take-cap. If inner.len() <=
// remaining, the back yields directly from inner. Otherwise we
// drop `inner.len() - remaining` items off the back first, then
// pull next_back. Tracks remaining the same way forward does.
impl<I: DoubleEndedIterator<T> + ExactSizeIterator<T>, T> DoubleEndedIterator<T> for TakeIter<I, T> {
    fn next_back(self: &mut TakeIter<I, T>) -> Option<T> {
        if self.remaining <= 0 as i64 { return Option::None; }
        let inner_len: i64 = self.inner.len();
        if inner_len > self.remaining {
            let drop_n: i64 = inner_len - self.remaining;
            let mut k: i64 = 0 as i64;
            while k < drop_n {
                let _drained: Option<T> = self.inner.next_back();
                k = k + 1 as i64;
            }
        }
        self.remaining = self.remaining - 1 as i64;
        return self.inner.next_back();
    }
}

impl<I: ExactSizeIterator<T>, T> ExactSizeIterator<T> for TakeIter<I, T> {
    fn len(&self) -> i64 {
        let il: i64 = self.inner.len();
        if il < self.remaining { return il; }
        return self.remaining;
    }
}

// ── SkipIter<I, T> — skip first n items ──────────────────────────────────────

pub struct SkipIter<I, T> {
    inner: I,
    remaining: i64,
    _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for SkipIter<I, T> {
    fn next(self: &mut SkipIter<I, T>) -> Option<T> {
        while self.remaining > 0 as i64 {
            self.remaining = self.remaining - 1 as i64;
            match self.inner.next() {
                Option::None => { return Option::None; }
                Option::Some(v) => { }
            }
        }
        return self.inner.next();
    }
}

pub unsafe fn iter_skip<I: Iterator<T>, T>(iter: I, n: i64, zero: T) -> SkipIter<I, T> {
    return SkipIter { inner: iter, remaining: n, _t: zero };
}

// DEI: drain skip-prefix from the front first so back doesn't
// touch items the forward direction would skip, then pull from
// inner.next_back. The drain stores into a typed local before
// matching — without the temp, mono of the matched-on Option<T>
// hits a disc-load codegen bug (the whole struct lands as the
// cmpi operand instead of just its tag field).
impl<I: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for SkipIter<I, T> {
    fn next_back(self: &mut SkipIter<I, T>) -> Option<T> {
        loop {
            if self.remaining <= 0 as i64 { return self.inner.next_back(); }
            self.remaining = self.remaining - 1 as i64;
            let drained: Option<T> = self.inner.next();
            match drained {
                Option::None    => { return Option::None; }
                Option::Some(v) => { }
            }
        }
    }
}

impl<I: ExactSizeIterator<T>, T> ExactSizeIterator<T> for SkipIter<I, T> {
    fn len(&self) -> i64 {
        let il: i64 = self.inner.len();
        if il < self.remaining { return 0 as i64; }
        return il - self.remaining;
    }
}

// ── TakeWhileIter<I, T> — yield until pred returns false ─────────────────────

pub struct TakeWhileIter<I, T> {
    pub inner: I,
    pub pred: fn(T) -> bool,
    pub done: bool,
    pub _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for TakeWhileIter<I, T> {
    fn next(self: &mut TakeWhileIter<I, T>) -> Option<T> {
        if self.done { return Option::None; }
        unsafe {
            match self.inner.next() {
                Option::None    => { self.done = true; return Option::None; }
                Option::Some(v) => {
                    let v_copy: T = *((&v) as *const T);
                    let pred = self.pred;
                    if pred(v_copy) { return Option::Some(v); }
                    self.done = true;
                    return Option::None;
                }
            }
        }
    }
}

pub unsafe fn iter_take_while<I: Iterator<T>, T>(iter: I, pred: fn(T) -> bool, zero: T) -> TakeWhileIter<I, T> {
    return TakeWhileIter { inner: iter, pred: pred, done: false, _t: zero };
}

// ── SkipWhileIter<I, T> — skip until pred returns false, then yield rest ─────

pub struct SkipWhileIter<I, T> {
    pub inner: I,
    pub pred: fn(T) -> bool,
    pub primed: bool,
    pub _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for SkipWhileIter<I, T> {
    fn next(self: &mut SkipWhileIter<I, T>) -> Option<T> {
        unsafe {
            if !self.primed {
                loop {
                    match self.inner.next() {
                        Option::None    => { self.primed = true; return Option::None; }
                        Option::Some(v) => {
                            let v_copy: T = *((&v) as *const T);
                            let pred = self.pred;
                            if !pred(v_copy) {
                                self.primed = true;
                                return Option::Some(v);
                            }
                        }
                    }
                }
            }
            return self.inner.next();
        }
    }
}

pub unsafe fn iter_skip_while<I: Iterator<T>, T>(iter: I, pred: fn(T) -> bool, zero: T) -> SkipWhileIter<I, T> {
    return SkipWhileIter { inner: iter, pred: pred, primed: false, _t: zero };
}

// ── StepByIter<I, T> — yield every Nth item starting from the first ──────────

pub struct StepByIter<I, T> {
    pub inner: I,
    pub step: i64,
    pub first: bool,
    pub _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for StepByIter<I, T> {
    fn next(self: &mut StepByIter<I, T>) -> Option<T> {
        if self.first {
            self.first = false;
            return self.inner.next();
        }
        // Skip step-1 items.
        let mut k: i64 = self.step - 1i64;
        while k > 0i64 {
            match self.inner.next() {
                Option::None    => { return Option::None; }
                Option::Some(_) => { k = k - 1i64; }
            }
        }
        return self.inner.next();
    }
}

pub unsafe fn iter_step_by<I: Iterator<T>, T>(iter: I, step: i64, zero: T) -> StepByIter<I, T> {
    return StepByIter { inner: iter, step: step, first: true, _t: zero };
}

// ── InspectIter<I, T> — observe each item without consuming it ───────────────

pub struct InspectIter<I, T> {
    pub inner: I,
    pub visit: fn(T) -> (),
    pub _t: T,
}

impl<I: Iterator<T>, T> Iterator<T> for InspectIter<I, T> {
    fn next(self: &mut InspectIter<I, T>) -> Option<T> {
        unsafe {
            match self.inner.next() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    let v_copy: T = *((&v) as *const T);
                    let visit = self.visit;
                    visit(v_copy);
                    return Option::Some(v);
                }
            }
        }
    }
}

pub unsafe fn iter_inspect<I: Iterator<T>, T>(iter: I, visit: fn(T) -> (), zero: T) -> InspectIter<I, T> {
    return InspectIter { inner: iter, visit: visit, _t: zero };
}

// DEI: same shape as forward, fires the visit fn for each element
// pulled from the back.
impl<I: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for InspectIter<I, T> {
    fn next_back(self: &mut InspectIter<I, T>) -> Option<T> {
        unsafe {
            match self.inner.next_back() {
                Option::None    => { return Option::None; }
                Option::Some(v) => {
                    let v_copy: T = *((&v) as *const T);
                    let visit = self.visit;
                    visit(v_copy);
                    return Option::Some(v);
                }
            }
        }
    }
}

// ── PeekableIter<I, T> — one-element lookahead wrapper ───────────────────────
//
// `peek()` fetches & caches the next item without consuming it.
// Subsequent `next()` returns the cached item, then resumes normal
// iteration. Uses a `has_peeked: bool` + bare `peeked_val: T` instead
// of `peeked: Option<T>` because Logos's struct-lit `Option::None`
// initialisation stores an i32 disc into the ptr-typed field slot
// (mlir-gen layout mismatch), making is_none() crash on first peek.

pub struct PeekableIter<I, T> {
    pub inner: I,
    pub has_peeked: bool,
    pub peeked_val: T,
}

impl<I: Iterator<T>, T> Iterator<T> for PeekableIter<I, T> {
    fn next(self: &mut PeekableIter<I, T>) -> Option<T> {
        unsafe {
            if self.has_peeked {
                self.has_peeked = false;
                let v_copy: T = *((&self.peeked_val) as *const T);
                return Option::Some(v_copy);
            }
        }
        return self.inner.next();
    }
}

impl<I: Iterator<T>, T> PeekableIter<I, T> {
    pub unsafe fn peek(self: &mut PeekableIter<I, T>) -> Option<&T> {
        if !self.has_peeked {
            match self.inner.next() {
                Option::Some(v) => {
                    self.peeked_val = v;
                    self.has_peeked = true;
                }
                Option::None => { return Option::None; }
            }
        }
        // Address-of the field slot — points into the struct's storage,
        // not a temp copy. Caller's `*r` dereferences back to the
        // cached value. Lifetime tied to the PeekableIter's storage.
        let r: *const T = &self.peeked_val as *const T;
        return Option::Some(&*r);
    }
}

pub unsafe fn iter_peekable<I: Iterator<T>, T>(iter: I, zero: T) -> PeekableIter<I, T> {
    return PeekableIter { inner: iter, has_peeked: false, peeked_val: zero };
}

// DEI: pull from inner.next_back; if inner is exhausted but a front
// peek is cached, return that cached value (so the cached peek
// always observes as the last element from either direction).
// Matches Rust's std::iter::Peekable<I: DoubleEndedIterator> shape.
// Intermediate `back` local is required to dodge the disc-load
// codegen bug on rvalue-call-match-result (same workaround as
// SkipIter DEI).
impl<I: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for PeekableIter<I, T> {
    fn next_back(self: &mut PeekableIter<I, T>) -> Option<T> {
        unsafe {
            let back: Option<T> = self.inner.next_back();
            match back {
                Option::Some(v) => { return Option::Some(v); }
                Option::None => {
                    if self.has_peeked {
                        self.has_peeked = false;
                        let v_copy: T = *((&self.peeked_val) as *const T);
                        return Option::Some(v_copy);
                    }
                    return Option::None;
                }
            }
        }
    }
}

// ── Source iterators: once / empty / repeat ──────────────────────────────────
//
// Matches Rust's `core::iter::{once, empty, repeat}` shape: free fn
// returning a typed iterator struct. Trivially DEI (a single-element
// or symmetric source has the same yield from either end).

pub struct OnceIter<T> {
    pub consumed: bool,
    pub val: T,
}

impl<T> Iterator<T> for OnceIter<T> {
    fn next(self: &mut OnceIter<T>) -> Option<T> {
        unsafe {
            if self.consumed { return Option::None; }
            self.consumed = true;
            let v_copy: T = *((&self.val) as *const T);
            return Option::Some(v_copy);
        }
    }
}

impl<T> FusedIterator<T> for OnceIter<T> {}

impl<T> DoubleEndedIterator<T> for OnceIter<T> {
    fn next_back(self: &mut OnceIter<T>) -> Option<T> {
        unsafe {
            if self.consumed { return Option::None; }
            self.consumed = true;
            let v_copy: T = *((&self.val) as *const T);
            return Option::Some(v_copy);
        }
    }
}

pub fn iter_once<T>(val: T) -> OnceIter<T> {
    return OnceIter { consumed: false, val: val };
}

// ── OptionIter<T> — 0-or-1-element iterator over an Option<T> ────────────────
//
// Backing iterator for `impl<T> IntoIterator<T> for Option<T>` —
// matches Rust's `impl<T> IntoIterator for Option<T>` shape.
// `.next()` takes the cached Option, leaving None behind.

pub struct OptionIter<T> {
    pub state: Option<T>,
}

impl<T> Iterator<T> for OptionIter<T> {
    fn next(self: &mut OptionIter<T>) -> Option<T> {
        return self.state.take();
    }
}

impl<T> DoubleEndedIterator<T> for OptionIter<T> {
    fn next_back(self: &mut OptionIter<T>) -> Option<T> {
        return self.state.take();
    }
}

impl<T> IntoIterator<T> for Option<T> {
    type Iter = OptionIter<T>;
    fn into_iter(self: Option<T>) -> OptionIter<T> {
        return OptionIter { state: self };
    }
}


pub struct EmptyIter<T> { pub _t: T }

impl<T> Iterator<T> for EmptyIter<T> {
    fn next(self: &mut EmptyIter<T>) -> Option<T> { return Option::None; }
}

impl<T> DoubleEndedIterator<T> for EmptyIter<T> {
    fn next_back(self: &mut EmptyIter<T>) -> Option<T> { return Option::None; }
}

impl<T> FusedIterator<T> for EmptyIter<T> {}

pub fn iter_empty<T>(zero: T) -> EmptyIter<T> {
    return EmptyIter { _t: zero };
}

pub struct RepeatIter<T> { pub val: T }

impl<T> Iterator<T> for RepeatIter<T> {
    fn next(self: &mut RepeatIter<T>) -> Option<T> {
        unsafe {
            let v_copy: T = *((&self.val) as *const T);
            return Option::Some(v_copy);
        }
    }
}

pub fn iter_repeat<T>(val: T) -> RepeatIter<T> {
    return RepeatIter { val: val };
}

// ── CycleIter<I, T> — repeat the source iterator forever ─────────────────────
//
// Stores the original (Clone'd on construction) plus the active copy.
// When the active copy yields None, refresh it by cloning the original
// and try again. `I: Clone` bound — Logos's stdlib clone trait already
// auto-impl'd for primitives + via #[derive_clone] for structs.

pub struct CycleIter<I, T> {
    pub orig: I,
    pub active: I,
    pub _t: T,
}

impl<I: Iterator<T> + Clone, T> Iterator<T> for CycleIter<I, T> {
    fn next(self: &mut CycleIter<I, T>) -> Option<T> {
        match self.active.next() {
            Option::Some(v) => { return Option::Some(v); }
            Option::None    => {
                self.active = self.orig.clone();
                return self.active.next();
            }
        }
    }
}

pub unsafe fn iter_cycle<I: Iterator<T> + Clone, T>(iter: I, zero: T) -> CycleIter<I, T> {
    let copy: I = iter.clone();
    return CycleIter { orig: iter, active: copy, _t: zero };
}

// ── EnumIter<I, T> — pair each item with its index ───────────────────────────

pub struct EnumPair<T> {
    pub idx: i64,
    pub val: T,
}

pub struct EnumIter<I, T> {
    inner: I,
    idx: i64,
    _t: T,
}

impl<I: Iterator<T>, T> Iterator<EnumPair<T>> for EnumIter<I, T> {
    fn next(self: &mut EnumIter<I, T>) -> Option<EnumPair<T>> {
        match self.inner.next() {
            Option::None => { return Option::None; }
            Option::Some(v) => {
                let i = self.idx;
                self.idx = self.idx + 1 as i64;
                return Option::Some(EnumPair { idx: i, val: v });
            }
        }
    }
}

pub unsafe fn iter_enumerate<I: Iterator<T>, T>(iter: I, zero: T) -> EnumIter<I, T> {
    return EnumIter { inner: iter, idx: 0 as i64, _t: zero };
}

// DEI: yields (position, value) from the back. The position is
// computed as `self.idx + inner.len()` after the back-pull —
// since inner's remaining items are at original positions
// [idx .. idx + inner.len()) and the pulled item was at the
// upper end of that range.
impl<I: DoubleEndedIterator<T> + ExactSizeIterator<T>, T> DoubleEndedIterator<EnumPair<T>> for EnumIter<I, T> {
    fn next_back(self: &mut EnumIter<I, T>) -> Option<EnumPair<T>> {
        let pulled: Option<T> = self.inner.next_back();
        match pulled {
            Option::None    => { return Option::None; }
            Option::Some(v) => {
                let pos: i64 = self.idx + self.inner.len();
                return Option::Some(EnumPair { idx: pos, val: v });
            }
        }
    }
}

impl<I: ExactSizeIterator<T>, T> ExactSizeIterator<EnumPair<T>> for EnumIter<I, T> {
    fn len(&self) -> i64 { return self.inner.len(); }
}

// ── ChainIter<A, B, T> — concatenate two iterators of the same Item ──────────

pub struct ChainIter<A, B, T> {
    first: A,
    second: B,
    first_done: bool,
    _t: T,
}

impl<A: Iterator<T>, B: Iterator<T>, T> Iterator<T> for ChainIter<A, B, T> {
    fn next(self: &mut ChainIter<A, B, T>) -> Option<T> {
        if !self.first_done {
            match self.first.next() {
                Option::Some(v) => { return Option::Some(v); }
                Option::None    => { self.first_done = true; }
            }
        }
        return self.second.next();
    }
}

pub unsafe fn iter_chain<A: Iterator<T>, B: Iterator<T>, T>(a: A, b: B, zero: T) -> ChainIter<A, B, T> {
    return ChainIter { first: a, second: b, first_done: false, _t: zero };
}

// DEI: pull from the back of `second` first; once `second` is
// exhausted, pull from the back of `first`. Symmetric to forward
// chain (front of `first` then front of `second`). `second_done`
// tracked locally — when next_back finds `second.next_back()` =
// None, we record that and switch to `first.next_back()`. We
// reuse `first_done` for forward exhaustion and add a new
// `second_done` field for back-end exhaustion.
impl<A: DoubleEndedIterator<T>, B: DoubleEndedIterator<T>, T> DoubleEndedIterator<T> for ChainIter<A, B, T> {
    fn next_back(self: &mut ChainIter<A, B, T>) -> Option<T> {
        match self.second.next_back() {
            Option::Some(v) => { return Option::Some(v); }
            Option::None    => { return self.first.next_back(); }
        }
    }
}

// ── ZipPair<A, B> ─────────────────────────────────────────────────────────────

pub struct ZipPair<A, B> {
    pub first: A,
    pub second: B,
}

pub struct ZipIter<A, B, T, U> {
    left: A,
    right: B,
    _t: T,
    _u: U,
}

impl<A: Iterator<T>, B: Iterator<U>, T, U> Iterator<ZipPair<T, U>> for ZipIter<A, B, T, U> {
    fn next(self: &mut ZipIter<A, B, T, U>) -> Option<ZipPair<T, U>> {
        match self.left.next() {
            Option::None => { return Option::None; }
            Option::Some(a) => {
                match self.right.next() {
                    Option::None => { return Option::None; }
                    Option::Some(b) => {
                        return Option::Some(ZipPair { first: a, second: b });
                    }
                }
            }
        }
    }
}

pub unsafe fn iter_zip<A: Iterator<T>, B: Iterator<U>, T, U>(a: A, b: B, zt: T, zu: U) -> ZipIter<A, B, T, U> {
    return ZipIter { left: a, right: b, _t: zt, _u: zu };
}

// DEI: both halves must be DEI + ESI so we can align their lengths
// from the back. Drops `max(alen,blen) - min(alen,blen)` items
// from the longer side's back first, then pulls next_back from
// both. Matches Rust's Zip<A: DEI+ESI, B: DEI+ESI> shape.
impl<A: DoubleEndedIterator<T> + ExactSizeIterator<T>,
     B: DoubleEndedIterator<U> + ExactSizeIterator<U>,
     T, U> DoubleEndedIterator<ZipPair<T, U>> for ZipIter<A, B, T, U> {
    fn next_back(self: &mut ZipIter<A, B, T, U>) -> Option<ZipPair<T, U>> {
        let alen: i64 = self.left.len();
        let blen: i64 = self.right.len();
        if alen > blen {
            let drop_n: i64 = alen - blen;
            let mut k: i64 = 0 as i64;
            while k < drop_n {
                let _drained: Option<T> = self.left.next_back();
                k = k + 1 as i64;
            }
        }
        if blen > alen {
            let drop_n: i64 = blen - alen;
            let mut k: i64 = 0 as i64;
            while k < drop_n {
                let _drained: Option<U> = self.right.next_back();
                k = k + 1 as i64;
            }
        }
        let a: Option<T> = self.left.next_back();
        let b: Option<U> = self.right.next_back();
        match a {
            Option::None     => { return Option::None; }
            Option::Some(av) => {
                match b {
                    Option::None     => { return Option::None; }
                    Option::Some(bv) => {
                        return Option::Some(ZipPair { first: av, second: bv });
                    }
                }
            }
        }
    }
}

impl<A: ExactSizeIterator<T>, B: ExactSizeIterator<U>, T, U>
    ExactSizeIterator<ZipPair<T, U>> for ZipIter<A, B, T, U> {
    fn len(&self) -> i64 {
        let alen: i64 = self.left.len();
        let blen: i64 = self.right.len();
        if alen < blen { return alen; }
        return blen;
    }
}

// ── SliceIter<T> — iterator over a slice &[T] ────────────────────────────────

pub struct SliceIter<T> {
    data: *const T,
    len: i64,
    idx: i64,
    back_idx: i64,
}

impl<T> Iterator<T> for SliceIter<T> {
    fn next(self: &mut SliceIter<T>) -> Option<T> {
        unsafe {
            if self.idx >= self.back_idx { return Option::None; }
            let val: T = self.data[self.idx];
            self.idx = self.idx + 1 as i64;
            return Option::Some(val);
        }
    }
}

impl<T> DoubleEndedIterator<T> for SliceIter<T> {
    fn next_back(self: &mut SliceIter<T>) -> Option<T> {
        unsafe {
            if self.idx >= self.back_idx { return Option::None; }
            self.back_idx = self.back_idx - 1 as i64;
            let val: T = self.data[self.back_idx];
            return Option::Some(val);
        }
    }
}

pub unsafe fn iter_over_slice<T>(s: &[T]) -> SliceIter<T> {
    let p: *const T = s.as_ptr() as *const T;
    let n: i64 = s.len() as i64;
    return SliceIter { data: p, len: n, idx: 0 as i64, back_idx: n };
}

impl<T> ExactSizeIterator<T> for SliceIter<T> {
    fn len(&self) -> i64 { return self.back_idx - self.idx; }
}

// ── Terminal operations ───────────────────────────────────────────────────────

pub fn iter_count<I: Iterator<T>, T>(iter: I) -> i64 {
    let mut it: I = iter;
    let mut n: i64 = 0 as i64;
    loop {
        match it.next() {
            Option::None    => { return n; }
            Option::Some(v) => { n = n + 1 as i64; }
        }
    }
    return n;
}

// Free-fn forms — same `F: FnMut(...)` bound as the trait-default
// terminals. Type-arg inference deduces B and T from f's signature
// via the Fn-family bound-propagation pass in infer_type_args.
pub fn iter_fold<I: Iterator<T>, T, B, F: FnMut(B, T) -> B>(iter: I, init: B, f: F) -> B {
    let mut it: I = iter;
    let mut acc: B = init;
    let mut g: F = f;
    loop {
        match it.next() {
            Option::None    => { return acc; }
            Option::Some(v) => { acc = g(acc, v); }
        }
    }
    return acc;
}

pub fn iter_for_each<I: Iterator<T>, T, F: FnMut(T) -> ()>(iter: I, f: F) {
    let mut it: I = iter;
    let mut g: F = f;
    loop {
        match it.next() {
            Option::None    => { return; }
            Option::Some(v) => { g(v); }
        }
    }
}

// SL-sl-05: product terminals — multiplicative analogues of iter_sum_*.
// Identity is 1; type-monomorphised because trait-default with primitive
// Self causes the trait-default-method-mono baghunt.
pub unsafe fn iter_product_i32<I: Iterator<i32>>(iter: I) -> i32 {
    let mut it: I = iter;
    let mut p: i32 = 1i32;
    loop {
        match it.next() {
            Option::None    => { return p; }
            Option::Some(v) => { p = p * v; }
        }
    }
    return p;
}

pub unsafe fn iter_product_i64<I: Iterator<i64>>(iter: I) -> i64 {
    let mut it: I = iter;
    let mut p: i64 = 1i64;
    loop {
        match it.next() {
            Option::None    => { return p; }
            Option::Some(v) => { p = p * v; }
        }
    }
    return p;
}

// SL-sl-05: min_by / max_by — caller supplies a `cmp` closure so we don't
// need Ord bound. Returns Option<T>; empty iterator → None.
pub fn iter_max_by<I: Iterator<T>, T>(iter: I, cmp: fn(T, T) -> i32) -> Option<T> {
    let mut it: I = iter;
    let mut best: Option<T> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None        => { best = Option::Some(v); }
                    Option::Some(cur)   => {
                        if cmp(v, cur) > 0i32 { best = Option::Some(v); }
                        else                  { best = Option::Some(cur); }
                    }
                }
            }
        }
    }
}

pub fn iter_min_by<I: Iterator<T>, T>(iter: I, cmp: fn(T, T) -> i32) -> Option<T> {
    let mut it: I = iter;
    let mut best: Option<T> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None        => { best = Option::Some(v); }
                    Option::Some(cur)   => {
                        if cmp(v, cur) < 0i32 { best = Option::Some(v); }
                        else                  { best = Option::Some(cur); }
                    }
                }
            }
        }
    }
}

// Ord-bounded `iter_max` / `iter_min` free fns. Mirrors Rust's
// `Iterator::max` / `min` which require `Item: Ord`. The CP-cm-14
// primitive-receiver extension makes `cmp` dispatch resolve when
// Item is a primitive (i32 / i64 / etc.).
pub fn iter_max<I: Iterator<T>, T: Ord>(iter: I) -> Option<T> {
    let mut it: I = iter;
    let mut best: Option<T> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None    => { best = Option::Some(v); }
                    Option::Some(b) => {
                        unsafe {
                            let v_copy: T = *((&v) as *const T);
                            let b_copy: T = *((&b) as *const T);
                            match v_copy.cmp(&b_copy) {
                                Ordering::Greater => { best = Option::Some(v); }
                                _                 => { best = Option::Some(b); }
                            }
                        }
                    }
                }
            }
        }
    }
}

pub fn iter_min<I: Iterator<T>, T: Ord>(iter: I) -> Option<T> {
    let mut it: I = iter;
    let mut best: Option<T> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None    => { best = Option::Some(v); }
                    Option::Some(b) => {
                        unsafe {
                            let v_copy: T = *((&v) as *const T);
                            let b_copy: T = *((&b) as *const T);
                            match v_copy.cmp(&b_copy) {
                                Ordering::Less => { best = Option::Some(v); }
                                _              => { best = Option::Some(b); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// SL-sl-05: typed min/max for primitive integer iterators. Don't need
// Ord bound (the trait-default-with-Self segfault would otherwise
// block this); use the integer operator < / > directly. Empty
// iterator → None.
pub fn iter_max_i32<I: Iterator<i32>>(iter: I) -> Option<i32> {
    let mut it: I = iter;
    let mut best: Option<i32> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None      => { best = Option::Some(v); }
                    Option::Some(cur) => { if v > cur { best = Option::Some(v); }
                                           else        { best = Option::Some(cur); } }
                }
            }
        }
    }
}

pub fn iter_min_i32<I: Iterator<i32>>(iter: I) -> Option<i32> {
    let mut it: I = iter;
    let mut best: Option<i32> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None      => { best = Option::Some(v); }
                    Option::Some(cur) => { if v < cur { best = Option::Some(v); }
                                           else        { best = Option::Some(cur); } }
                }
            }
        }
    }
}

pub fn iter_max_i64<I: Iterator<i64>>(iter: I) -> Option<i64> {
    let mut it: I = iter;
    let mut best: Option<i64> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None      => { best = Option::Some(v); }
                    Option::Some(cur) => { if v > cur { best = Option::Some(v); }
                                           else        { best = Option::Some(cur); } }
                }
            }
        }
    }
}

pub fn iter_min_i64<I: Iterator<i64>>(iter: I) -> Option<i64> {
    let mut it: I = iter;
    let mut best: Option<i64> = Option::None;
    loop {
        match it.next() {
            Option::None    => { return best; }
            Option::Some(v) => {
                match best {
                    Option::None      => { best = Option::Some(v); }
                    Option::Some(cur) => { if v < cur { best = Option::Some(v); }
                                           else        { best = Option::Some(cur); } }
                }
            }
        }
    }
}

pub unsafe fn iter_sum_i32<I: Iterator<i32>>(iter: I) -> i32 {
    let mut it: I = iter;
    let mut s: i32 = 0;
    loop {
        match it.next() {
            Option::None    => { return s; }
            Option::Some(v) => { s = s + v; }
        }
    }
    return s;
}

pub unsafe fn iter_sum_i64<I: Iterator<i64>>(iter: I) -> i64 {
    let mut it: I = iter;
    let mut s: i64 = 0 as i64;
    loop {
        match it.next() {
            Option::None    => { return s; }
            Option::Some(v) => { s = s + v; }
        }
    }
    return s;
}

// ────────────────────────────────────────────────────────────────────
// Adapters: cloned / copied / from_fn / successors / repeat_n
// ────────────────────────────────────────────────────────────────────
//
// All follow the existing pattern: per-adapter struct + impl Iterator +
// free-fn constructor. Closure-taking adapters (from_fn, successors)
// accept `fn(...) -> ...` ptr; capturing closures are not yet usable
// until Fn-family traits land at the API surface (priority #1).

// NOTE — `cloned`/`copied` adapters are intentionally omitted.
// Rust's Cloned/Copied bridge `Iterator<Item=&T>` → `Iterator<Item=T>`
// because Rust's slice-style iterators yield references by default.
// In Logos, SliceIter<T> already yields T by value (Iterator yields
// owned values throughout the stdlib), so these adapters would be
// degenerate identity wrappers. Skipped.

// ── FromFn<T> — iterator from a closure ─────────────────────────────
//
// Mirrors `core::iter::from_fn`. The closure is called for each `.next()`;
// it returns Option<T> (None ends the iteration).

pub struct FromFnIter<T> {
    pub f: fn() -> Option<T>,
}

impl<T> Iterator<T> for FromFnIter<T> {
    fn next(self: &mut FromFnIter<T>) -> Option<T> {
        let f = self.f;
        return f();
    }
}

pub fn iter_from_fn<T>(f: fn() -> Option<T>) -> FromFnIter<T> {
    return FromFnIter { f: f };
}

// ── Successors<T, F> — start at first, repeatedly apply succ ──────
//
// Mirrors `core::iter::successors`. State machine: each `next()`
// yields the current value (if Some), then advances by calling
// `succ(current)` to produce the next value (None ends iteration).
// `F: FnMut(T) -> Option<T>` so capturing closures (e.g. with state
// captured from the surrounding scope) work alongside fn-pointers.

pub struct SuccessorsIter<T, F> {
    pub next_val: Option<T>,
    pub succ: F,
}

impl<T: Copy, F: FnMut(T) -> Option<T>> Iterator<T> for SuccessorsIter<T, F> {
    fn next(self: &mut SuccessorsIter<T, F>) -> Option<T> {
        match self.next_val {
            Option::None    => { return Option::None; }
            Option::Some(v) => {
                self.next_val = (self.succ)(v);
                return Option::Some(v);
            }
        }
    }
}

pub fn iter_successors<T: Copy, F: FnMut(T) -> Option<T>>(
    first: Option<T>, succ: F
) -> SuccessorsIter<T, F> {
    return SuccessorsIter { next_val: first, succ: succ };
}

// ── RepeatN<T> — yield same value n times ──────────────────────────
//
// Mirrors `core::iter::repeat_n`. Bound is `T: Copy` (vs Rust's
// `T: Clone`): trait-method dispatch on `T: Clone` from inside a
// generic Iterator impl hits a mono crash today
// ([[baghunt-iter-method-generic-mono]]). When that lands we can
// relax to Clone and call .clone() per yield.

pub struct RepeatNIter<T> {
    pub count: i64,
    pub value: T,
}

impl<T: Copy> Iterator<T> for RepeatNIter<T> {
    fn next(self: &mut RepeatNIter<T>) -> Option<T> {
        if self.count <= 0i64 { return Option::None; }
        self.count = self.count - 1i64;
        unsafe {
            let v_copy: T = *((&self.value) as *const T);
            return Option::Some(v_copy);
        }
    }
}

pub fn iter_repeat_n<T: Copy>(value: T, count: i64) -> RepeatNIter<T> {
    return RepeatNIter { value: value, count: count };
}

// ── OnceWithIter<T, F> — single-shot iterator from a generator ──────
//
// Mirrors `core::iter::once_with`. The generator fires exactly once on
// the first `.next()`, then returns None. Logos uses `F: FnMut()->T`
// (Rust uses `FnOnce`) — FnOnce/FnMut distinction at trait-method
// dispatch isn't currently load-bearing here; once_with's discipline
// of firing only once is enforced by the `fired` flag.
//
// `_t: T` anchor field follows the CycleIter / SuccessorsIter
// pattern — Logos has no PhantomData; the field carries the
// instantiation `T` so mono can substitute it into the Iterator impl
// without depending on `F`'s return-type inference machinery.

pub struct OnceWithIter<T, F> {
    pub f:     F,
    pub fired: bool,
    pub _t:    T,
}

impl<T, F: FnMut() -> T> Iterator<T> for OnceWithIter<T, F> {
    fn next(self: &mut OnceWithIter<T, F>) -> Option<T> {
        if self.fired { return Option::None; }
        self.fired = true;
        return Option::Some((self.f)());
    }
}

pub fn iter_once_with<T, F: FnMut() -> T>(f: F, zero: T) -> OnceWithIter<T, F> {
    return OnceWithIter { f: f, fired: false, _t: zero };
}

// ── RepeatWithIter<T, F> — infinite-fire-on-demand iterator ─────────
//
// Mirrors `core::iter::repeat_with`. Fires the generator on every
// `.next()` and never terminates.

pub struct RepeatWithIter<T, F> {
    pub f:  F,
    pub _t: T,
}

impl<T, F: FnMut() -> T> Iterator<T> for RepeatWithIter<T, F> {
    fn next(self: &mut RepeatWithIter<T, F>) -> Option<T> {
        return Option::Some((self.f)());
    }
}

pub fn iter_repeat_with<T, F: FnMut() -> T>(f: F, zero: T) -> RepeatWithIter<T, F> {
    return RepeatWithIter { f: f, _t: zero };
}
