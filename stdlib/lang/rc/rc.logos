// Logos standard library — std.rc
//
// Rc<T> — single-thread reference-counted smart pointer.
// NOT Send: Rc contains raw *mut pointers and uses a non-atomic counter.
//
// Single allocation: the strong counter and the T value live in one
// heap block (`RcInner<T>` — like std::make_shared's control block).
// Layout:
//   strong: i32
//   val:    T
//
// `Rc<T>` is a single fat pointer over `RcInner<T>`. Cloning and
// dropping mutate the inner.strong counter; the last drop releases
// the whole block in one dealloc.

package logos.lang.rc;

use logos.lang.mem;
use logos.lang.drop;
use logos.lang.clone;
use logos.lang.ops;
use logos.lang.option;
use logos.lang.result;

// Control block (Rust parity — `RcBox`): strong + weak counters precede the
// value in one heap block. `weak` counts the live Weak handles PLUS one
// implicit weak owned collectively by all strong handles; T is dropped when
// strong → 0, and the block is freed only when weak → 0. A Weak edge thus keeps
// the block alive (so `upgrade` can test liveness) WITHOUT keeping T alive —
// this is how reference cycles are broken. The header layout MUST match
// ArcInner's so the compiler's Rc/Arc<dyn> unsize + drop recover `val` at one
// uniform offset (round_up(8, align(T)) — two i32 counters).
/// Heap control block for `Rc`/`Weak`: counters followed by the value, in one allocation.
/// `val` is dropped when `strong` reaches 0; the block is freed when `weak` reaches 0.
pub struct RcInner<T: ?Sized> {
    /// Count of live `Rc` handles; `val` is dropped when it reaches 0.
    pub strong: i32,
    /// Count of live `Weak` handles plus one implicit weak held collectively by strong handles.
    pub weak:   i32,
    /// The stored value.
    pub val:    T,
}

/// Single-threaded reference-counted pointer: shared ownership of a heap-allocated `T`.
/// Cloning bumps the strong count; the last strong drop runs `T`'s destructor. NOT `Send`.
#[non_null]
pub struct Rc<T: ?Sized> {
    inner: *mut RcInner<T>,
}

/// Non-owning handle to an `Rc` allocation; does not keep `T` alive.
/// `upgrade()` returns `Some(Rc)` only while a strong reference still exists, else `None`.
/// Use to break `Rc` cycles (e.g. a child's back-pointer to its parent).
pub struct Weak<T: ?Sized> {
    inner: *mut RcInner<T>,
}

/// Creates a new `Rc<T>` owning `val` in a fresh single-block heap allocation (strong = 1).
pub fn rc_new<T>(val: T) -> Rc<T> {
    let p: *mut RcInner<T> = alloc(sizeof::<RcInner<T>>()) as *mut RcInner<T>;
    unsafe {
        p.strong = 1;
        p.weak   = 1;   // the implicit weak held collectively by the strong refs
        p.val    = val;
    }
    return Rc { inner: p };
}

impl<T: ?Sized> Rc<T> {
    /// Returns a raw pointer to the stored value; valid while any handle lives.
    pub unsafe fn get(self: *mut Rc<T>) -> *const T {
        return &self.inner.val as *const T;
    }

    /// Returns a raw mutable pointer to the stored value.
    /// No uniqueness check (the checked form is `Rc::get_mut`); caller must ensure exclusive access.
    pub unsafe fn get_mut_raw(self: *mut Rc<T>) -> *mut T {
        return &mut self.inner.val as *mut T;
    }

    // Reference-returning accessors. The inner block is heap-stable
    // for the lifetime of any Rc handle, so a `&T` / `&mut T` borrowed
    // from the inner is well-defined as long as the Rc itself lives.
    // Prefer these over `get`/`get_mut` — they hand the value back as
    // a normal Logos reference instead of a raw pointer that callers
    // have to launder through `unsafe { … }` blocks.
    /// The number of live strong (`Rc`) handles to the allocation (Rust's `Rc::strong_count`).
    pub fn strong_count(this: &Rc<T>) -> i64 {
        unsafe { return this.inner.strong as i64; }
    }

    /// `true` if both handles point at the same allocation (Rust's `Rc::ptr_eq`).
    pub fn ptr_eq(this: &Rc<T>, other: &Rc<T>) -> bool {
        return (this.inner as *mut u8) == (other.inner as *mut u8);
    }

    /// `Some(&mut value)` when this is the only handle (no other `Rc`, no `Weak`),
    /// else `None` (Rust's `Rc::get_mut`).
    pub fn get_mut(this: &mut Rc<T>) -> Option<&mut T> {
        unsafe {
            if this.inner.strong != 1 || this.inner.weak != 1 { return Option::None; }
            return Option::Some(&mut this.inner.val);
        }
    }

    /// Returns `true` if this handle's inner pointer is null (e.g. after `drop_rc`).
    pub unsafe fn is_null(self: *mut Rc<T>) -> bool {
        return self.inner == 0 as *mut RcInner<T>;
    }

    /// Increments the strong count and returns a second handle to the same allocation.
    pub unsafe fn clone_rc(self: *mut Rc<T>) -> Rc<T> {
        self.inner.strong = self.inner.strong + 1;
        return Rc { inner: self.inner };
    }

    /// Clones this handle from a SHARED borrow (bumps the strong count in
    /// the heap-stable inner — the interior-mutation point lives here, not at
    /// call sites). Rc is thread-local by contract; no race is possible.
    pub fn clone_ref(&self) -> Rc<T> {
        unsafe {
            let p: *mut Rc<T> = (self as *const Rc<T>) as *mut Rc<T>;
            return p.clone_rc();
        }
    }

    /// The number of live `Weak` handles, excluding the implicit weak (Rust's `Rc::weak_count`).
    pub fn weak_count(this: &Rc<T>) -> i64 {
        unsafe { return (this.inner.weak - 1) as i64; }
    }

    /// Decrements the strong count; at the last strong reference runs `T`'s destructor,
    /// then releases the implicit weak, freeing the block only once no `Weak` remains.
    /// Nulls this handle afterwards; a no-op on an already-null handle.
    pub unsafe fn drop_rc(self: *mut Rc<T>) {
        if self.inner == 0 as *mut RcInner<T> { return; }
        self.inner.strong = self.inner.strong - 1;
        if self.inner.strong == 0 {
            logos.lang.ptr::drop_in_place((&mut self.inner.val) as *mut T);   // fires T's Drop; T may be unsized (#463)
            // Release the collective implicit weak; free if it was the last.
            self.inner.weak = self.inner.weak - 1;
            if self.inner.weak == 0 {
                dealloc(self.inner as *mut u8);
            }
        }
        self.inner = 0 as *mut RcInner<T>;
    }

    /// Creates a non-owning `Weak` handle (bumps the weak count); Rust `Rc::downgrade`.
    pub unsafe fn downgrade_rc(self: *mut Rc<T>) -> Weak<T> {
        self.inner.weak = self.inner.weak + 1;
        return Weak { inner: self.inner };
    }
    /// Creates a non-owning `Weak` handle; safe wrapper over `downgrade_rc`.
    pub fn downgrade(&self) -> Weak<T> {
        unsafe {
            let p: *mut Rc<T> = self as *const Rc<T> as *mut Rc<T>;
            return p.downgrade_rc();
        }
    }
}

impl<T> Rc<T> {
    /// Creates a new `Rc` owning `val` (Rust's `Rc::new`).
    pub fn new(val: T) -> Rc<T> { return rc_new::<T>(val); }

    /// The value, if this is the only strong handle; else the handle back (Rust's
    /// `Rc::try_unwrap`). Outstanding `Weak`s then fail to upgrade.
    pub fn try_unwrap(this: Rc<T>) -> Result<T, Rc<T>> {
        unsafe {
            if this.inner.strong != 1 { return Result::Err(this); }
            let p: *mut RcInner<T> = this.inner;
            let v: T = logos.lang.ptr::read(&p.val as *const T);
            p.strong = 0;
            p.weak = p.weak - 1;   // the implicit weak of the strong handles
            if p.weak == 0 { dealloc(p as *mut u8); }
            logos.lang.mem::forget::<Rc<T>>(this);
            return Result::Ok(v);
        }
    }

    /// The value, if this is the only strong handle, else `None` (Rust's `Rc::into_inner`).
    pub fn into_inner(this: Rc<T>) -> Option<T> {
        let r: Result<T, Rc<T>> = Rc::try_unwrap(this);
        match r {
            Result::Ok(v)  => { return Option::Some(v); }
            Result::Err(h) => { let _last: Rc<T> = h; return Option::None; }
        }
    }
}

impl<T> Weak<T> {
    /// A `Weak` pointing at nothing: `upgrade` always returns `None` (Rust's `Weak::new`).
    pub fn new() -> Weak<T> { return Weak { inner: 0 as *mut RcInner<T> }; }
}

impl<T: ?Sized> Weak<T> {
    /// The number of strong handles to the allocation (0 for `Weak::new`).
    pub fn strong_count(&self) -> i64 {
        unsafe {
            if (self.inner as *mut u8) == (0 as *mut u8) { return 0; }
            return self.inner.strong as i64;
        }
    }

    /// Attempts to obtain a strong `Rc`; returns `None` if the value has been dropped
    /// (no strong references remain). On success bumps the strong count.
    pub fn upgrade(&self) -> Option<Rc<T>> {
        unsafe {
            let p: *mut Weak<T> = self as *const Weak<T> as *mut Weak<T>;
            if p.inner == 0 as *mut RcInner<T> { return Option::<Rc<T>>::None; }
            if p.inner.strong == 0 { return Option::<Rc<T>>::None; }
            p.inner.strong = p.inner.strong + 1;
            return Option::<Rc<T>>::Some(Rc { inner: p.inner });
        }
    }

    /// Decrements the weak count; frees the block once both strong and weak are exhausted
    /// (the value was already dropped when `strong` hit zero). Nulls this handle.
    pub unsafe fn drop_weak(self: *mut Weak<T>) {
        if self.inner == 0 as *mut RcInner<T> { return; }
        self.inner.weak = self.inner.weak - 1;
        if self.inner.weak == 0 {
            dealloc(self.inner as *mut u8);
        }
        self.inner = 0 as *mut RcInner<T>;
    }
}

// Weak auto-Drop: releases this weak handle's count (and frees the block if it
// was the very last reference of either kind).
impl<T: ?Sized> Drop for Weak<T> {
    fn drop(self: &mut Weak<T>) {
        unsafe {
            let p: *mut Weak<T> = self as *const Weak<T> as *mut Weak<T>;
            p.drop_weak();
        }
    }
}

// Weak Clone: a second non-owning handle (bumps the weak count).
impl<T: ?Sized> Clone for Weak<T> {
    fn clone(&self) -> Weak<T> {
        unsafe {
            let p: *mut Weak<T> = self as *const Weak<T> as *mut Weak<T>;
            if p.inner != 0 as *mut RcInner<T> {
                p.inner.weak = p.inner.weak + 1;
            }
            return Weak { inner: p.inner };
        }
    }
}

// Auto-Drop. Compiler emits a call to `Rc__drop` whenever a Rc<T>
// goes out of scope unmoved. At the last strong reference, T's destructor
// runs (the inner `val` is moved out and dropped) before the block is freed.
impl<T: ?Sized> Drop for Rc<T> {
    fn drop(self: &mut Rc<T>) {
        unsafe {
            let p: *mut Rc<T> = self as *const Rc<T> as *mut Rc<T>;
            p.drop_rc();
        }
    }
}

// Clone (Rust parity): `rc.clone()` bumps the strong count and hands back a
// second handle to the same allocation — NOT a deep copy. Mirrors clone_ref,
// but as the standard `Clone` trait so generic `T: Clone` code and `.clone()`
// dispatch uniformly (same surface as a future Box/Arc Clone).
impl<T: ?Sized> Clone for Rc<T> {
    fn clone(&self) -> Rc<T> {
        unsafe {
            let p: *mut Rc<T> = self as *const Rc<T> as *mut Rc<T>;
            return p.clone_rc();
        }
    }
}

// Deref / DerefMut (Rust parity): `*rc`, and auto-deref `rc.field` /
// `rc.method()` route through these. The inner block is heap-stable for the
// lifetime of any Rc handle, so the borrowed `&T` / `&mut T` is well-defined.
// Standard trait surface — same as Box/Arc, dispatched uniformly.
impl<T: ?Sized> Deref<T> for Rc<T> {
    fn deref(&self) -> &T {
        unsafe { return &self.inner.val; }
    }
}

impl<T: ?Sized> DerefMut<T> for Rc<T> {
    fn deref_mut(&mut self) -> &mut T {
        unsafe { return &mut self.inner.val; }
    }
}
