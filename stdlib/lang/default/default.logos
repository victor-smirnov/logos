// Logos standard library — std.default
//
// Default — construct a zero/false/empty value for a type.

package logos.lang.default;

pub trait Default {
    fn default() -> Self;
}

impl Default for i8    { fn default() -> i8    { return 0 as i8;    } }
impl Default for i16   { fn default() -> i16   { return 0 as i16;   } }
impl Default for i32   { fn default() -> i32   { return 0;          } }
impl Default for i64   { fn default() -> i64   { return 0 as i64;   } }
impl Default for u8    { fn default() -> u8    { return 0 as u8;    } }
impl Default for u16   { fn default() -> u16   { return 0 as u16;   } }
impl Default for u32   { fn default() -> u32   { return 0 as u32;   } }
impl Default for u64   { fn default() -> u64   { return 0 as u64;   } }
impl Default for usize { fn default() -> usize { return 0 as usize; } }
impl Default for f32   { fn default() -> f32   { return 0.0 as f32; } }
impl Default for f64   { fn default() -> f64   { return 0.0;        } }
impl Default for bool  { fn default() -> bool  { return false;      } }
