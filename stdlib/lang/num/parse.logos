// Logos standard library — std.lang.num.parse
//
// String → number parsing. Mirrors `core::str::FromStr` (the
// `s.parse::<T>()` idiom) and `i32::from_str_radix` / etc.
//
// The Rust shape carries an associated `Err` type; Logos's trait
// uses a type-param E for the same purpose. Per-primitive
// `from_str_radix` free fns hold the actual digit-walk; the trait
// impls just delegate to them.

package logos.lang.num.parse;

use logos.lang.option;
use logos.lang.result;
use logos.lang.num.error;
use logos.lang.str;

/// Parses a value of `Self` from a `str`; Rust's `core::str::FromStr` with the
/// error type as trait type-param `E` (Logos traits carry no associated types
/// outside the Fn-family). Backs the `s.parse::<T>()` idiom.
pub trait FromStr<E> {
    /// Parses the whole of `s` into `Self`, or returns `E` on failure.
    fn from_str(s: str) -> Result<Self, E>;
}

// ── Per-primitive digit-walk parsers ──────────────────────────────
//
// Common scaffolding extracted into a helper:
//   - leading `+` / `-` (signed only)
//   - digit accept set per radix (0-9, a-z, A-Z up to radix-1)
//   - empty / sign-only / invalid-digit / overflow detection
//
// Each per-type fn enforces its own bound (i32 / i64 / u32 / u64).

// Returns the digit value of byte `b` interpreted in `radix`, or -1
// when `b` is not a valid digit in that radix.
fn parse_digit(b: u8, radix: i64) -> i64 {
    let mut d: i64 = -1i64;
    if b >= 48u8 && b <= 57u8           { d = (b as i64) - 48i64; }
    else if b >= 97u8 && b <= 122u8     { d = (b as i64) - 97i64 + 10i64; }
    else if b >= 65u8 && b <= 90u8      { d = (b as i64) - 65i64 + 10i64; }
    if d < 0i64 { return -1i64; }
    if d >= radix { return -1i64; }
    return d;
}

/// Parses `s` as an `i32` in the given `radix`, mirroring `i32::from_str_radix`.
/// Accepts a leading `+`/`-`; errors: `Empty`, `InvalidDigit`, `PosOverflow`/`NegOverflow`.
/// `radix` is unvalidated (no panic outside `2..=36`, unlike Rust); digit set `0-9`, `a-z`/`A-Z`.
pub fn i32_from_str_radix(s: str, radix: u32) -> Result<i32, ParseIntError> {
    if s.len() == 0i64 {
        return Result::<i32, ParseIntError>::Err(
            ParseIntError::new(IntErrorKind::Empty));
    }
    let mut i: i64 = 0i64;
    let mut neg:  bool = false;
    let first: u8 = s[0i64];
    if first == 45u8 { neg = true; i = 1i64; }
    else if first == 43u8 { i = 1i64; }
    if i >= s.len() {
        return Result::<i32, ParseIntError>::Err(
            ParseIntError::new(IntErrorKind::Empty));
    }
    let r: i64 = radix as i64;
    let mut acc: i64 = 0i64;
    while i < s.len() {
        let d: i64 = parse_digit(s[i], r);
        if d < 0i64 {
            return Result::<i32, ParseIntError>::Err(
                ParseIntError::new(IntErrorKind::InvalidDigit));
        }
        acc = acc * r + d;
        if neg {
            if 0i64 - acc < 0i64 - 2147483648i64 {
                return Result::<i32, ParseIntError>::Err(
                    ParseIntError::new(IntErrorKind::NegOverflow));
            }
        } else {
            if acc > 2147483647i64 {
                return Result::<i32, ParseIntError>::Err(
                    ParseIntError::new(IntErrorKind::PosOverflow));
            }
        }
        i = i + 1i64;
    }
    let final_v: i64 = if neg { 0i64 - acc } else { acc };
    return Result::<i32, ParseIntError>::Ok(final_v as i32);
}

/// Parses `s` as an `i64` in the given `radix`, mirroring `i64::from_str_radix`.
/// Accepts a leading `+`/`-`; errors: `Empty`, `InvalidDigit`, `PosOverflow`/`NegOverflow`.
/// `radix` is not validated (no panic outside `2..=36`, unlike Rust).
/// Trap: `i64::MIN` itself is rejected as `NegOverflow` (magnitude is capped at `i64::MAX`).
pub fn i64_from_str_radix(s: str, radix: u32) -> Result<i64, ParseIntError> {
    if s.len() == 0i64 {
        return Result::<i64, ParseIntError>::Err(
            ParseIntError::new(IntErrorKind::Empty));
    }
    let mut i: i64 = 0i64;
    let mut neg:  bool = false;
    let first: u8 = s[0i64];
    if first == 45u8 { neg = true; i = 1i64; }
    else if first == 43u8 { i = 1i64; }
    if i >= s.len() {
        return Result::<i64, ParseIntError>::Err(
            ParseIntError::new(IntErrorKind::Empty));
    }
    let r: i64 = radix as i64;
    let mut acc: i64 = 0i64;
    // i64 max = 9223372036854775807; min = -9223372036854775808.
    // Overflow-check by comparing acc against (MAX - d) / r per step.
    let i64_max: i64 = 9223372036854775807i64;
    while i < s.len() {
        let d: i64 = parse_digit(s[i], r);
        if d < 0i64 {
            return Result::<i64, ParseIntError>::Err(
                ParseIntError::new(IntErrorKind::InvalidDigit));
        }
        if acc > (i64_max - d) / r {
            let kind: IntErrorKind = if neg { IntErrorKind::NegOverflow }
                                    else { IntErrorKind::PosOverflow };
            return Result::<i64, ParseIntError>::Err(
                ParseIntError::new(kind));
        }
        acc = acc * r + d;
        i = i + 1i64;
    }
    return Result::<i64, ParseIntError>::Ok(if neg { 0i64 - acc } else { acc });
}

/// Parses `s` as a `u32` in the given `radix`, mirroring `u32::from_str_radix`.
/// Accepts a leading `+`; a leading `-` is `InvalidDigit`. Errors: `Empty`,
/// `InvalidDigit`, `PosOverflow`. `radix` is not validated (no panic outside `2..=36`).
pub fn u32_from_str_radix(s: str, radix: u32) -> Result<u32, ParseIntError> {
    if s.len() == 0i64 {
        return Result::<u32, ParseIntError>::Err(
            ParseIntError::new(IntErrorKind::Empty));
    }
    let mut i: i64 = 0i64;
    // Allow a leading '+', reject '-' (unsigned).
    let first: u8 = s[0i64];
    if first == 43u8 { i = 1i64; }
    else if first == 45u8 {
        return Result::<u32, ParseIntError>::Err(
            ParseIntError::new(IntErrorKind::InvalidDigit));
    }
    if i >= s.len() {
        return Result::<u32, ParseIntError>::Err(
            ParseIntError::new(IntErrorKind::Empty));
    }
    let r: i64 = radix as i64;
    let mut acc: i64 = 0i64;
    while i < s.len() {
        let d: i64 = parse_digit(s[i], r);
        if d < 0i64 {
            return Result::<u32, ParseIntError>::Err(
                ParseIntError::new(IntErrorKind::InvalidDigit));
        }
        acc = acc * r + d;
        if acc > 4294967295i64 {
            return Result::<u32, ParseIntError>::Err(
                ParseIntError::new(IntErrorKind::PosOverflow));
        }
        i = i + 1i64;
    }
    return Result::<u32, ParseIntError>::Ok(acc as u32);
}

/// Parses `s` as a `u64` in the given `radix`, mirroring `u64::from_str_radix`.
/// Accepts a leading `+`; a leading `-` is `InvalidDigit`. Errors: `Empty`,
/// `InvalidDigit`, `PosOverflow`. `radix` is not validated (no panic outside `2..=36`).
pub fn u64_from_str_radix(s: str, radix: u32) -> Result<u64, ParseIntError> {
    if s.len() == 0i64 {
        return Result::<u64, ParseIntError>::Err(
            ParseIntError::new(IntErrorKind::Empty));
    }
    let mut i: i64 = 0i64;
    let first: u8 = s[0i64];
    if first == 43u8 { i = 1i64; }
    else if first == 45u8 {
        return Result::<u64, ParseIntError>::Err(
            ParseIntError::new(IntErrorKind::InvalidDigit));
    }
    if i >= s.len() {
        return Result::<u64, ParseIntError>::Err(
            ParseIntError::new(IntErrorKind::Empty));
    }
    let r: u64 = radix as u64;
    let mut acc: u64 = 0u64;
    // u64 max = 18446744073709551615. Overflow-check via cap divide.
    let u64_max: u64 = 18446744073709551615u64;
    while i < s.len() {
        let d: i64 = parse_digit(s[i], radix as i64);
        if d < 0i64 {
            return Result::<u64, ParseIntError>::Err(
                ParseIntError::new(IntErrorKind::InvalidDigit));
        }
        let du: u64 = d as u64;
        if acc > (u64_max - du) / r {
            return Result::<u64, ParseIntError>::Err(
                ParseIntError::new(IntErrorKind::PosOverflow));
        }
        acc = acc * r + du;
        i = i + 1i64;
    }
    return Result::<u64, ParseIntError>::Ok(acc);
}

// Decimal convenience helpers — `s.parse::<T>()` lowers here.
/// Parses `s` as a base-10 `i32`; `s.parse::<i32>()` lowers here.
pub fn i32_from_str(s: str) -> Result<i32, ParseIntError> {
    return i32_from_str_radix(s, 10u32);
}
/// Parses `s` as a base-10 `i64`; `s.parse::<i64>()` lowers here.
pub fn i64_from_str(s: str) -> Result<i64, ParseIntError> {
    return i64_from_str_radix(s, 10u32);
}
/// Parses `s` as a base-10 `u32`; `s.parse::<u32>()` lowers here.
pub fn u32_from_str(s: str) -> Result<u32, ParseIntError> {
    return u32_from_str_radix(s, 10u32);
}
/// Parses `s` as a base-10 `u64`; `s.parse::<u64>()` lowers here.
pub fn u64_from_str(s: str) -> Result<u64, ParseIntError> {
    return u64_from_str_radix(s, 10u32);
}

// ── FromStr trait impls ─────────────────────────────────────────────
//
// Each impl delegates to the matching free fn so the parse logic
// stays in one place.
impl FromStr<ParseIntError> for i32 {
    fn from_str(s: str) -> Result<i32, ParseIntError> { return i32_from_str(s); }
}
impl FromStr<ParseIntError> for i64 {
    fn from_str(s: str) -> Result<i64, ParseIntError> { return i64_from_str(s); }
}
impl FromStr<ParseIntError> for u32 {
    fn from_str(s: str) -> Result<u32, ParseIntError> { return u32_from_str(s); }
}
impl FromStr<ParseIntError> for u64 {
    fn from_str(s: str) -> Result<u64, ParseIntError> { return u64_from_str(s); }
}

// ── Float parsing ────────────────────────────────────────────────────────
//
// Mirrors `f64::from_str` / `f32::from_str`. Strict — the whole input
// must be a well-formed float; trailing junk is an error.
//
// Accepts:
//   * Optional leading `+` / `-`
//   * Decimal mantissa with optional fractional part
//   * Optional `e`/`E` exponent with optional sign
//   * "inf", "infinity", "nan" (case-insensitive)
//
// Subnormals and rounding round-trip via straightforward IEEE 754
// arithmetic — this is not bit-exact with the Rust `dec2flt` algorithm,
// but is accurate to a few ulp for normal inputs.

fn ascii_lower(b: u8) -> u8 {
    if b >= 65u8 && b <= 90u8 { return (b - 65u8) + 97u8; }
    return b;
}

fn str_eq_ci(s: str, lit: str) -> bool {
    if s.len() != lit.len() { return false; }
    let mut i: i64 = 0i64;
    while i < s.len() {
        if ascii_lower(s[i]) != ascii_lower(lit[i]) { return false; }
        i = i + 1i64;
    }
    return true;
}

/// Parses `s` as an `f64`, mirroring `f64::from_str`; the whole input must match.
/// Accepts optional `+`/`-`, decimal mantissa with optional fraction, optional
/// `e`/`E` exponent, and case-insensitive `inf`/`infinity`/`nan`.
/// Not correctly rounded: accurate to a few ulp (unlike Rust's exact `dec2flt`).
pub fn f64_from_str(s: str) -> Result<f64, ParseFloatError> {
    if s.len() == 0i64 {
        return Result::<f64, ParseFloatError>::Err(
            ParseFloatError::new(FloatErrorKind::Empty));
    }
    let mut i: i64 = 0i64;
    let mut sign: f64 = 1.0;
    let first: u8 = s[0i64];
    if first == 45u8 { sign = 0.0 - 1.0; i = 1i64; }
    else if first == 43u8 { i = 1i64; }

    if i >= s.len() {
        return Result::<f64, ParseFloatError>::Err(
            ParseFloatError::new(FloatErrorKind::Invalid));
    }

    // Special names — match against the sign-stripped tail.
    let mut tail_buf: [u8; 16] = [0u8; 16];
    let tail_len: i64 = s.len() - i;
    if tail_len <= 16i64 {
        let mut k: i64 = 0i64;
        while k < tail_len {
            tail_buf[k] = s[i + k];
            k = k + 1i64;
        }
        let tail: str = unsafe { str_from_raw(&tail_buf[0i64] as *const u8, tail_len) };
        if str_eq_ci(tail, "nan") {
            return Result::<f64, ParseFloatError>::Ok(0.0 / 0.0);
        }
        if str_eq_ci(tail, "inf") || str_eq_ci(tail, "infinity") {
            let big: f64 = 1.0e308 * 10.0;
            return Result::<f64, ParseFloatError>::Ok(sign * big);
        }
    }

    let mut whole: f64 = 0.0;
    let mut seen_digit: bool = false;
    while i < s.len() {
        let c: i32 = s[i] as i32;
        if c < 48 || c > 57 { break; }
        whole = whole * 10.0 + ((c - 48) as f64);
        seen_digit = true;
        i = i + 1i64;
    }

    let mut frac: f64 = 0.0;
    let mut frac_div: f64 = 1.0;
    if i < s.len() && (s[i] as i32) == 46 {
        i = i + 1i64;
        while i < s.len() {
            let c: i32 = s[i] as i32;
            if c < 48 || c > 57 { break; }
            frac = frac * 10.0 + ((c - 48) as f64);
            frac_div = frac_div * 10.0;
            seen_digit = true;
            i = i + 1i64;
        }
    }

    if !seen_digit {
        return Result::<f64, ParseFloatError>::Err(
            ParseFloatError::new(FloatErrorKind::Invalid));
    }

    let mut value: f64 = sign * (whole + frac / frac_div);

    if i < s.len() {
        let e: i32 = s[i] as i32;
        if e == 101 || e == 69 {
            i = i + 1i64;
            let mut esign: i32 = 1i32;
            if i < s.len() && (s[i] as i32) == 45 { esign = -1i32; i = i + 1i64; }
            else if i < s.len() && (s[i] as i32) == 43 { i = i + 1i64; }
            if i >= s.len() {
                return Result::<f64, ParseFloatError>::Err(
                    ParseFloatError::new(FloatErrorKind::Invalid));
            }
            let mut exp: i32 = 0i32;
            let mut seen_exp_digit: bool = false;
            while i < s.len() {
                let c: i32 = s[i] as i32;
                if c < 48 || c > 57 { break; }
                exp = exp * 10 + (c - 48);
                seen_exp_digit = true;
                i = i + 1i64;
            }
            if !seen_exp_digit {
                return Result::<f64, ParseFloatError>::Err(
                    ParseFloatError::new(FloatErrorKind::Invalid));
            }
            let mut mult: f64 = 1.0;
            let mut k: i32 = 0i32;
            while k < exp { mult = mult * 10.0; k = k + 1i32; }
            if esign < 0i32 { value = value / mult; }
            else            { value = value * mult; }
        }
    }

    // Any leftover characters → invalid.
    if i != s.len() {
        return Result::<f64, ParseFloatError>::Err(
            ParseFloatError::new(FloatErrorKind::Invalid));
    }

    return Result::<f64, ParseFloatError>::Ok(value);
}

/// Parses `s` as an `f32` by parsing as `f64` and narrowing (see `f64_from_str`).
/// Double rounding may differ from a direct `f32` parse by an ulp.
pub fn f32_from_str(s: str) -> Result<f32, ParseFloatError> {
    let r: Result<f64, ParseFloatError> = f64_from_str(s);
    match r {
        Result::Ok(v)  => { return Result::<f32, ParseFloatError>::Ok(v as f32); }
        Result::Err(e) => { return Result::<f32, ParseFloatError>::Err(e); }
    }
}

impl FromStr<ParseFloatError> for f32 {
    fn from_str(s: str) -> Result<f32, ParseFloatError> { return f32_from_str(s); }
}
impl FromStr<ParseFloatError> for f64 {
    fn from_str(s: str) -> Result<f64, ParseFloatError> { return f64_from_str(s); }
}
