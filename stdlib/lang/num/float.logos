// Logos standard library — std.lang.num.float
//
// Floating-point classification, bit-pattern access, and FpCategory.
// Mirrors `core::num::FpCategory` + `f32::classify` / `f64::classify`
// + `f32::to_bits` / `f64::to_bits` / `from_bits`.

package logos.lang.num.float;

/// Classification of an IEEE 754 floating-point number; mirrors `core::num::FpCategory`.
/// Variants in IEEE-754-classification order: Nan / Infinite / Zero / Subnormal / Normal.
pub enum FpCategory {
    /// Not a number (quiet or signaling NaN).
    Nan,
    /// Positive or negative infinity.
    Infinite,
    /// Positive or negative zero.
    Zero,
    /// Subnormal (denormalized): nonzero value with the minimum biased exponent.
    Subnormal,
    /// Normal: neither zero, infinite, subnormal, nor NaN.
    Normal,
}

// ── Bit-pattern access ───────────────────────────────────────────────────
//
// IEEE 754 bit-pattern reinterpret. Logos doesn't expose a transmute
// intrinsic, so we route through pointer casts — the underlying values
// are stack-resident scalars, so this is well-defined.

/// Returns the raw IEEE 754 bit pattern of `x` as a `u32` (same as `f32::to_bits`).
pub fn f32_to_bits(x: f32) -> u32 {
    unsafe {
        let p: *const u32 = &x as *const f32 as *const u32;
        return *p;
    }
}

/// Reinterprets the IEEE 754 bit pattern `b` as an `f32` (same as `f32::from_bits`).
/// Any bit pattern is accepted, including ones that decode to NaN or infinity.
pub fn f32_from_bits(b: u32) -> f32 {
    unsafe {
        let p: *const f32 = &b as *const u32 as *const f32;
        return *p;
    }
}

/// Returns the raw IEEE 754 bit pattern of `x` as a `u64` (same as `f64::to_bits`).
pub fn f64_to_bits(x: f64) -> u64 {
    unsafe {
        let p: *const u64 = &x as *const f64 as *const u64;
        return *p;
    }
}

/// Reinterprets the IEEE 754 bit pattern `b` as an `f64` (same as `f64::from_bits`).
/// Any bit pattern is accepted, including ones that decode to NaN or infinity.
pub fn f64_from_bits(b: u64) -> f64 {
    unsafe {
        let p: *const f64 = &b as *const u64 as *const f64;
        return *p;
    }
}

// ── Total order (IEEE 754 totalOrder) ────────────────────────────────────
//
// `<` on floats is a PARTIAL order: a NaN is neither less than, greater than
// nor equal to anything, including itself. Any algorithm that needs a total
// order — a sort, a binary search, a keyed index — is ill-defined on it, and
// the failure is silent: an insertion sort's inner loop simply stops shifting
// at the NaN and leaves everything before it in collection order.
//
// `f64_total_key` maps a float to the i64 whose ORDINARY `<` reproduces IEEE
// 754's totalOrder: flip the sign bit for positives, invert the rest for
// negatives. It agrees with `<` on every pair of non-NaN values, orders
// −0.0 before +0.0, and puts −NaN first / +NaN last. Same construction as
// Rust's `f64::total_cmp`.

/// The `i64` sort key of `x` under IEEE 754 totalOrder (see `f64::total_cmp`).
/// `f64_total_key(a) < f64_total_key(b)` is a TOTAL order that agrees with
/// `a < b` wherever neither operand is NaN.
pub fn f64_total_key(x: f64) -> i64 {
    let b: i64 = f64_to_bits(x) as i64;
    // Arithmetic-shift the sign bit across, then drop its top copy: 0 for a
    // positive (flip only the sign bit), 0x7FFF… for a negative (flip
    // everything below the sign bit as well).
    let m: i64 = (((b >> 63i64) as u64) >> 1u64) as i64;
    return b ^ m;
}

/// The `i64` sort key of `x` under IEEE 754 totalOrder, for `f32`.
pub fn f32_total_key(x: f32) -> i64 {
    let b: i32 = f32_to_bits(x) as i32;
    let m: i32 = (((b >> 31i32) as u32) >> 1u32) as i32;
    return (b ^ m) as i64;
}

// ── Classification ───────────────────────────────────────────────────────
//
// IEEE 754 bit layout:
//   f32: 1 sign + 8 exp + 23 mantissa  (exp mask 0x7F800000, mant 0x007FFFFF)
//   f64: 1 sign + 11 exp + 52 mantissa (exp mask 0x7FF00000_00000000)

/// Returns the `FpCategory` of `x` by IEEE 754 exponent/mantissa inspection (`f32::classify`).
pub fn f32_classify(x: f32) -> FpCategory {
    let bits: u32 = f32_to_bits(x);
    let exp:  u32 = bits & 0x7F800000u32;
    let mant: u32 = bits & 0x007FFFFFu32;
    if exp == 0x7F800000u32 {
        if mant != 0u32 { return FpCategory::Nan; }
        return FpCategory::Infinite;
    }
    if exp == 0u32 {
        if mant == 0u32 { return FpCategory::Zero; }
        return FpCategory::Subnormal;
    }
    return FpCategory::Normal;
}

/// Returns the `FpCategory` of `x` by IEEE 754 exponent/mantissa inspection (`f64::classify`).
pub fn f64_classify(x: f64) -> FpCategory {
    let bits: u64 = f64_to_bits(x);
    let exp:  u64 = bits & 0x7FF0000000000000u64;
    let mant: u64 = bits & 0x000FFFFFFFFFFFFFu64;
    if exp == 0x7FF0000000000000u64 {
        if mant != 0u64 { return FpCategory::Nan; }
        return FpCategory::Infinite;
    }
    if exp == 0u64 {
        if mant == 0u64 { return FpCategory::Zero; }
        return FpCategory::Subnormal;
    }
    return FpCategory::Normal;
}

// ── Predicate sugar — match the Rust-side method names ──────────────────

/// Returns `true` if `x` is NaN.
pub fn f32_is_nan(x: f32) -> bool {
    match f32_classify(x) {
        FpCategory::Nan => { return true; }
        _               => { return false; }
    }
}

/// Returns `true` if `x` is positive or negative infinity (`false` for NaN).
pub fn f32_is_infinite(x: f32) -> bool {
    match f32_classify(x) {
        FpCategory::Infinite => { return true; }
        _                    => { return false; }
    }
}

/// Returns `true` if `x` is neither infinite nor NaN.
pub fn f32_is_finite(x: f32) -> bool {
    match f32_classify(x) {
        FpCategory::Nan      => { return false; }
        FpCategory::Infinite => { return false; }
        _                    => { return true; }
    }
}

/// Returns `true` if `x` is normal: not zero, subnormal, infinite, or NaN.
pub fn f32_is_normal(x: f32) -> bool {
    match f32_classify(x) {
        FpCategory::Normal => { return true; }
        _                  => { return false; }
    }
}

/// Returns `true` if `x` is NaN.
pub fn f64_is_nan(x: f64) -> bool {
    match f64_classify(x) {
        FpCategory::Nan => { return true; }
        _               => { return false; }
    }
}

/// Returns `true` if `x` is positive or negative infinity (`false` for NaN).
pub fn f64_is_infinite(x: f64) -> bool {
    match f64_classify(x) {
        FpCategory::Infinite => { return true; }
        _                    => { return false; }
    }
}

/// Returns `true` if `x` is neither infinite nor NaN.
pub fn f64_is_finite(x: f64) -> bool {
    match f64_classify(x) {
        FpCategory::Nan      => { return false; }
        FpCategory::Infinite => { return false; }
        _                    => { return true; }
    }
}

/// Returns `true` if `x` is normal: not zero, subnormal, infinite, or NaN.
pub fn f64_is_normal(x: f64) -> bool {
    match f64_classify(x) {
        FpCategory::Normal => { return true; }
        _                  => { return false; }
    }
}

// Inherent method surface on the float primitives (Rust parity:
// `x.is_nan()` etc.), delegating to the free-function classifiers above.
impl f64 {
    /// Returns `true` if `self` is NaN.
    pub fn is_nan(self: f64) -> bool      { return f64_is_nan(self); }
    /// Returns `true` if `self` is positive or negative infinity (`false` for NaN).
    pub fn is_infinite(self: f64) -> bool { return f64_is_infinite(self); }
    /// Returns `true` if `self` is neither infinite nor NaN.
    pub fn is_finite(self: f64) -> bool   { return f64_is_finite(self); }
    /// Returns `true` if `self` is normal: not zero, subnormal, infinite, or NaN.
    pub fn is_normal(self: f64) -> bool   { return f64_is_normal(self); }
}

impl f32 {
    /// Returns `true` if `self` is NaN.
    pub fn is_nan(self: f32) -> bool      { return f32_is_nan(self); }
    /// Returns `true` if `self` is positive or negative infinity (`false` for NaN).
    pub fn is_infinite(self: f32) -> bool { return f32_is_infinite(self); }
    /// Returns `true` if `self` is neither infinite nor NaN.
    pub fn is_finite(self: f32) -> bool   { return f32_is_finite(self); }
    /// Returns `true` if `self` is normal: not zero, subnormal, infinite, or NaN.
    pub fn is_normal(self: f32) -> bool   { return f32_is_normal(self); }
}
