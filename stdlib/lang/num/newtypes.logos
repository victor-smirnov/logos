// Logos standard library — std.lang.num.newtypes
//
// Wrapping<T> and Saturating<T> — newtype wrappers around integer
// types that choose a specific overflow strategy for the regular
// `+` / `-` / `*` operators. Mirrors `core::num::{Wrapping,
// Saturating}`.
//
// `Wrapping(x)` arithmetic: silent two's-complement wrap. Backed
// by `logos.lang.arith::wrapping_add` / `_sub` / `_mul` compiler
// intrinsics, so the operation lowers to MLIR's `arith.{add,sub,
// mul}i` directly.
//
// `Saturating(x)` arithmetic: clamps to T::MIN / T::MAX. Backed by
// each primitive's `saturating_*` inherent methods (lang/cmp/ord
// + lang/arith bridges).

package logos.lang.num.newtypes;

use logos.lang.arith;
use logos.lang.ops;
use logos.lang.cmp;

/// Newtype wrapper whose `+` / `-` / `*` silently wrap on overflow (two's complement).
pub struct Wrapping<T>   {
    /// The wrapped value.
    pub v: T
}
/// Newtype wrapper whose `+` / `-` clamp to `T::MIN` / `T::MAX` instead of overflowing.
pub struct Saturating<T> {
    /// The wrapped value.
    pub v: T
}

// ── Wrapping impls — Add / Sub / Mul per integer primitive ─────────
//
// Each impl block routes through the matching `wrapping_*` intrinsic
// at concrete instantiation time. Logos's monomorphization
// substitutes `Wrapping<i32>::add`'s body to call
// `wrapping_add::<i32>` which mlir-gen intercepts and lowers.

impl Add for Wrapping<i8> {
    fn add(self: Wrapping<i8>, rhs: Wrapping<i8>) -> Wrapping<i8> {
        return Wrapping::<i8> { v: wrapping_add::<i8>(self.v, rhs.v) };
    }
}
impl Sub for Wrapping<i8> {
    fn sub(self: Wrapping<i8>, rhs: Wrapping<i8>) -> Wrapping<i8> {
        return Wrapping::<i8> { v: wrapping_sub::<i8>(self.v, rhs.v) };
    }
}
impl Mul for Wrapping<i8> {
    fn mul(self: Wrapping<i8>, rhs: Wrapping<i8>) -> Wrapping<i8> {
        return Wrapping::<i8> { v: wrapping_mul::<i8>(self.v, rhs.v) };
    }
}

