// ── Saturating impls — Add / Sub per primitive ────────────────────
//
// Routes through the primitive's `saturating_*` inherent methods
// from `lang/cmp/ord.logos`. Only i32/i64/u32/u64 have those today
// (the narrow-int methods on i8/i16/u8/u16 are deferred to a future
// pass; users can promote to i32 first).

impl Add for Saturating<i32> {
    fn add(self: Saturating<i32>, rhs: Saturating<i32>) -> Saturating<i32> {
        return Saturating::<i32> { v: self.v.saturating_add(rhs.v) };
    }
}
impl Sub for Saturating<i32> {
    fn sub(self: Saturating<i32>, rhs: Saturating<i32>) -> Saturating<i32> {
        return Saturating::<i32> { v: self.v.saturating_sub(rhs.v) };
    }
}

