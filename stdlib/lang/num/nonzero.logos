// Logos standard library — std.lang.num.nonzero
//
// NonZero<T> — wrapper guaranteeing the inner value is non-zero.
// Mirrors `core::num::NonZero<T>` (Rust 1.79+) and provides type
// aliases matching the older `NonZeroI32` / `NonZeroU32` / etc. names.
//
// Use case: store an integer-typed handle / capacity / discriminant
// where zero is an invalid sentinel. In Rust this also unlocks
// niche-optimization for Option<NonZeroI32> (single-word layout, no
// tag); Logos doesn't yet niche-optimize Option, so the wrapper is
// purely a type-level documentation/check today.
//
// Surface ported: `new` (checked → Option), `new_unchecked`, `get`.
//
// Per-type aliases (NonZeroI8 .. NonZeroI64, NonZeroU8 .. NonZeroU64,
// NonZeroIsize, NonZeroUsize) are at the bottom of the file.
//
// Divergence from Rust:
//   - No niche optimization yet (Option<NonZero<i32>> is 8 bytes here,
//     not 4). Layout-equivalent to wrapping a plain T.
//   - Constrained to `T: Default + Eq + Copy` — Rust uses a sealed
//     `ZeroablePrimitive` trait; here the bound is checked at sema
//     time and only the integer types provide all three. `T::default()`
//     gives the zero sentinel.

package logos.lang.num.nonzero;

use logos.lang.option;
use logos.lang.default;
use logos.lang.cmp;
use logos.lang.clone;

/// Wraps a value of type `T` with the invariant that it never equals zero (`T::default()`).
/// Unlike Rust, `Option<NonZero<T>>` gets no niche optimization yet — layout equals plain `T`.
pub struct NonZero<T> {
    /// The wrapped value; non-zero whenever constructed via `new` / `new_unchecked`.
    // `pub` so the Debug/Display impls (which must live in mem.fmt, a layer
    // above lang.num) can read the wrapped value. The non-zero invariant is
    // still enforced by the `new` / `new_unchecked` constructors.
    pub val: T,
}

// NonZero<T> is Copy when T is (Rust derives this), so by-value `.get()` /
// pattern moves don't consume the wrapper.
impl<T: Copy> Copy for NonZero<T> {}

// Two NonZero<T> are equal iff their wrapped values are. (Rust derives this.)
impl<T: Eq> Eq for NonZero<T> {
    fn eq(self: &Self, other: &Self) -> bool { return self.val.eq(&other.val); }
}

impl<T: Default + Eq + Copy> NonZero<T> {
    /// Creates a `NonZero` if `n` is non-zero.
    /// Returns `None` when `n` equals `T::default()` (the zero sentinel for integer types).
    pub fn new(n: T) -> Option<NonZero<T>> {
        if n == T::default() {
            return Option::None;
        }
        return Option::Some(NonZero { val: n });
    }

    /// Creates a `NonZero` without checking that `n` is non-zero.
    /// UB if `n == T::default()`; the caller must guarantee `n` is non-zero.
    pub unsafe fn new_unchecked(n: T) -> NonZero<T> {
        return NonZero { val: n };
    }

    /// Returns the wrapped value (always non-zero by invariant).
    pub fn get(self: NonZero<T>) -> T {
        return self.val;
    }
}

// ── Per-type aliases ───────────────────────────────────────────────
// Match Rust's `NonZeroI32` etc. naming so ports read as expected.
/// An `i8` that is known not to equal zero.
pub type NonZeroI8    = NonZero<i8>;
/// An `i16` that is known not to equal zero.
pub type NonZeroI16   = NonZero<i16>;
/// An `i32` that is known not to equal zero.
pub type NonZeroI32   = NonZero<i32>;
/// An `i64` that is known not to equal zero.
pub type NonZeroI64   = NonZero<i64>;
/// An `isize` that is known not to equal zero.
pub type NonZeroIsize = NonZero<isize>;
/// A `u8` that is known not to equal zero.
pub type NonZeroU8    = NonZero<u8>;
/// A `u16` that is known not to equal zero.
pub type NonZeroU16   = NonZero<u16>;
/// A `u32` that is known not to equal zero.
pub type NonZeroU32   = NonZero<u32>;
/// A `u64` that is known not to equal zero.
pub type NonZeroU64   = NonZero<u64>;
/// A `usize` that is known not to equal zero.
pub type NonZeroUsize = NonZero<usize>;
