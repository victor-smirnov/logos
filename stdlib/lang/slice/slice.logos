// Logos standard library — std.slice
//
// Slice ops paralleling `core::slice`. Existing iterator construction
// (`iter_over_slice`) lives in `lang/iter`; this module covers the
// non-iter method surface: split_at, chunks, windows, binary_search,
// sort.

package logos.lang.slice;

use logos.lang.iter;
use logos.lang.ops;
use logos.lang.option;
use logos.lang.result;
use logos.lang.panic;
use logos.lang.cmp;
use logos.lang.marker;
use logos.lang.clone;

// ── split_at ──────────────────────────────────────────────────────────────
//
// Mirrors `slice::split_at(mid) -> (&[T], &[T])`. Returns a struct
// carrying raw `(ptr, len)` for each half. Reconstructing typed
// `&[T]` slices inline as struct fields tripped a fat-pointer
// materialisation hazard, so we return raw pairs; callers can call
// `slice_from_raw::<T>(left_ptr, left_len)` if they want a typed
// `&[T]` (or just use the raw form for iteration).

/// Raw `(ptr, len)` halves of a slice split, as produced by `slice_split_at`.
pub struct SplitPair<T> {
    /// Pointer to the first element of the left half.
    pub left_ptr:  *const T,
    /// Element count of the left half.
    pub left_len:  i64,
    /// Pointer to the first element of the right half.
    pub right_ptr: *const T,
    /// Element count of the right half.
    pub right_len: i64,
}

/// Splits `s` at `mid`, returning raw `(ptr, len)` pairs for both halves.
/// `mid` is clamped to `s.len()` (no panic, unlike Rust). Rebuild typed `&[T]` halves
/// with `slice_from_raw`.
pub fn slice_split_at<T>(s: &[T], mid: i64) -> SplitPair<T> {
    let n: i64 = s.len() as i64;
    let m: i64 = if mid > n { n } else { mid };
    unsafe {
        let base: *const T = s.as_ptr() as *const T;
        let right_p: *const T = (base as i64 + m * (sizeof::<T>() as i64)) as *const T;
        return SplitPair {
            left_ptr:  base,
            left_len:  m,
            right_ptr: right_p,
            right_len: n - m,
        };
    }
}

/// Returns the sub-slice `s[lo..hi]` (backs the range-indexing desugar).
/// Bounds are clamped to `[0, len]`: open range forms pass `lo=0` / `hi=i64::MAX` and the
/// clamp resolves them against the true length. Inclusive `..=hi` passes `hi+1`.
/// Empty when `hi <= lo` after clamping.
pub fn slice_get_range<T>(s: &[T], lo: i64, hi: i64) -> &[T] {
    let n: i64 = s.len() as i64;
    let l0: i64 = if lo < 0i64 { 0i64 } else { if lo > n { n } else { lo } };
    let h0: i64 = if hi < 0i64 { 0i64 } else { if hi > n { n } else { hi } };
    let cnt: i64 = if h0 > l0 { h0 - l0 } else { 0i64 };
    unsafe {
        let base: *const T = s.as_ptr() as *const T;
        let start_p: *const T = (base as i64 + l0 * (sizeof::<T>() as i64)) as *const T;
        return slice_from_raw::<T>(start_p, cnt);
    }
}

/// Returns the mutable sub-slice `s[lo..hi]` (the `&mut s[lo..hi]` form).
/// Same clamping rules as `slice_get_range`; empty when `hi <= lo` after
/// clamping. The result borrows `s` exclusively for its lifetime.
pub fn slice_get_range_mut<T>(s: &mut [T], lo: i64, hi: i64) -> &mut [T] {
    let n: i64 = s.len() as i64;
    let l0: i64 = if lo < 0i64 { 0i64 } else { if lo > n { n } else { lo } };
    let h0: i64 = if hi < 0i64 { 0i64 } else { if hi > n { n } else { hi } };
    let cnt: i64 = if h0 > l0 { h0 - l0 } else { 0i64 };
    unsafe {
        let base: *const T = s.as_ptr() as *const T;
        let start_p: *const T = (base as i64 + l0 * (sizeof::<T>() as i64)) as *const T;
        return slice_from_raw_mut::<T>(start_p as *mut T, cnt);
    }
}

/// Copies all of `src` into `dst` (`slice::copy_from_slice`). Panics when the
/// lengths differ. The borrow checker guarantees `dst` and `src` are disjoint
/// (`&mut` vs `&`), so a plain forward copy is always correct.
pub fn slice_copy_from<T: Copy>(dst: &mut [T], src: &[T]) {
    let n: i64 = dst.len() as i64;
    assert(n == src.len() as i64,
           "slice_copy_from: source and destination lengths differ");
    unsafe {
        let d: *mut T = dst.as_ptr() as *mut T;
        let s: *const T = src.as_ptr() as *const T;
        let mut i: i64 = 0i64;
        while i < n { *d.add(i) = *s.add(i); i = i + 1i64; }
    }
}

/// Copies `s[src_lo..src_hi]` to positions starting at `dst` within the same
/// slice (`slice::copy_within`) — overlap-safe (copy direction picked by
/// order). Panics when either range falls outside the slice.
pub fn slice_copy_within<T: Copy>(s: &mut [T], src_lo: i64, src_hi: i64, dst: i64) {
    let n: i64 = s.len() as i64;
    assert(0i64 <= src_lo && src_lo <= src_hi && src_hi <= n,
           "slice_copy_within: source range out of bounds");
    let cnt: i64 = src_hi - src_lo;
    assert(0i64 <= dst && dst + cnt <= n,
           "slice_copy_within: destination range out of bounds");
    if cnt == 0i64 || dst == src_lo { return; }
    unsafe {
        let base: *mut T = s.as_ptr() as *mut T;
        if dst < src_lo {
            let mut i: i64 = 0i64;
            while i < cnt { *base.add(dst + i) = *base.add(src_lo + i); i = i + 1i64; }
        } else {
            let mut i: i64 = cnt - 1i64;
            while i >= 0i64 { *base.add(dst + i) = *base.add(src_lo + i); i = i - 1i64; }
        }
    }
}

/// Constructs an `&[T]` fat pointer from a raw pointer and element count.
/// Compiler intrinsic (sema intercepts the call); mirrors `str_from_raw` in `lang/str`.
/// `ptr` must be valid for reads of `len` elements for as long as the result is used.
pub unsafe fn slice_from_raw<T>(ptr: *const T, len: i64) -> &[T] {
    // Body unreachable — sema intercepts the call. If a call path ever
    // slips past the intercept, FAIL LOUDLY instead of returning an empty
    // slice (the old placeholder was a silent miscompile).
    panic("slice_from_raw: intrinsic call was not intercepted (compiler bug)");
}

/// Constructs an `&mut [T]` fat pointer from a raw pointer and element count.
/// Compiler intrinsic (sema intercepts the call), the `&mut` twin of `slice_from_raw`.
/// `ptr` must be valid for reads and writes of `len` elements, unaliased, for as long
/// as the result is used.
pub unsafe fn slice_from_raw_mut<T>(ptr: *mut T, len: i64) -> &mut [T] {
    panic("slice_from_raw_mut: intrinsic call was not intercepted (compiler bug)");
}

// ── Chunks<T> — non-overlapping consecutive chunks of size `n` ───────────
//
// Mirrors `slice::chunks(size)`. Last chunk may be shorter than `size`
// if `len % size != 0`. Empty input yields no chunks.

/// Iterator over non-overlapping chunks of a slice, created by `slice_chunks`.
// `'a` is the slice's lifetime: chunks borrow the slice, not the iterator.
pub struct Chunks<'a, T> {
    /// Base pointer of the underlying slice.
    pub data: *const T,
    /// Total element count of the underlying slice.
    pub len:  i64,
    /// Current element offset; advances by the yielded chunk's length.
    pub pos:  i64,
    /// Chunk size in elements.
    pub step: i64,
}

/// Returns an iterator over non-overlapping `size`-element chunks of `s`.
/// The last chunk is shorter when `s.len() % size != 0`; empty input yields no chunks.
/// `size` must be positive: non-positive `size` is unchecked, and `size == 0` makes `next`
/// yield empty chunks forever on a non-empty slice.
pub fn slice_chunks<'a, T: 'a>(s: &'a [T], size: i64) -> Chunks<'a, T> {
    return Chunks {
        data: s.as_ptr() as *const T,
        len:  s.len() as i64,
        pos:  0i64,
        step: size,
    };
}

impl<'a, T: 'a> Iterator for Chunks<'a, T> {
    type Item = &'a [T];
    fn next(self: &mut Chunks<'a, T>) -> Option<&'a [T]> {
        if self.pos >= self.len { return Option::None; }
        let take: i64 = if self.pos + self.step > self.len
                        { self.len - self.pos }
                        else { self.step };
        unsafe {
            let p: *const T = (self.data as i64 + self.pos * (sizeof::<T>() as i64)) as *const T;
            self.pos = self.pos + take;
            return Option::Some(slice_from_raw::<T>(p, take));
        }
    }
}

// ── Windows<T> — overlapping size-`n` slices ─────────────────────────────
//
// Mirrors `slice::windows(size)`. Each yielded slice is exactly `size`
// elements; advances by 1 each step. Yields nothing if `size > len` or
// `size == 0`.

/// Iterator over overlapping `size`-element windows of a slice, created by `slice_windows`.
// `'a` is the slice's lifetime: windows borrow the slice, not the iterator.
pub struct Windows<'a, T> {
    /// Base pointer of the underlying slice.
    pub data: *const T,
    /// Total element count of the underlying slice.
    pub len:  i64,
    /// Current window start offset; advances by 1 per step.
    pub pos:  i64,
    /// Window size in elements.
    pub size: i64,
}

/// Returns an iterator over overlapping `size`-element windows of `s`, advancing by 1.
/// Yields nothing if `size <= 0` or `size > s.len()` (unlike Rust, `size == 0` does not panic).
pub fn slice_windows<'a, T: 'a>(s: &'a [T], size: i64) -> Windows<'a, T> {
    return Windows {
        data: s.as_ptr() as *const T,
        len:  s.len() as i64,
        pos:  0i64,
        size: size,
    };
}

impl<'a, T: 'a> Iterator for Windows<'a, T> {
    type Item = &'a [T];
    fn next(self: &mut Windows<'a, T>) -> Option<&'a [T]> {
        if self.size <= 0i64 { return Option::None; }
        if self.pos + self.size > self.len { return Option::None; }
        unsafe {
            let p: *const T = (self.data as i64 + self.pos * (sizeof::<T>() as i64)) as *const T;
            self.pos = self.pos + 1i64;
            return Option::Some(slice_from_raw::<T>(p, self.size));
        }
    }
}

// ── binary_search ─────────────────────────────────────────────────────────
//
// Mirrors `slice::binary_search(&target) -> Result<usize, usize>`. Ok
// = index where target is found; Err = index where target could be
// inserted to keep the slice sorted.
//
// Requires `T: Ord + Copy` (Copy because we read elements by value
// via raw-ptr arithmetic — Logos doesn't have a `[T]::get(i) -> &T`
// surface tied to slice index syntax yet).

/// Binary-searches sorted `s` for `target`.
/// Returns `Ok(index)` on a match (any one, if `target` is duplicated) or `Err(i)` where `i`
/// is the insertion index that keeps `s` sorted. Unspecified result if `s` is not sorted.
pub fn slice_binary_search<T: Ord + Copy>(s: &[T], target: T) -> Result<i64, i64> {
    let n: i64 = s.len() as i64;
    let mut lo: i64 = 0i64;
    let mut hi: i64 = n;
    unsafe {
        let base: *const T = s.as_ptr() as *const T;
        let esz:  i64 = sizeof::<T>() as i64;
        while lo < hi {
            let mid: i64 = lo + (hi - lo) / 2i64;
            let elem: T = logos.lang.ptr::read((base as i64 + mid * esz) as *const T);   // #463
            match elem.cmp(&target) {
                Ordering::Less    => { lo = mid + 1i64; }
                Ordering::Greater => { hi = mid; }
                Ordering::Equal   => { return Result::Ok(mid); }
            }
        }
    }
    return Result::Err(lo);
}

// ── sort_in_place (insertion sort) ────────────────────────────────────────
//
// Mirrors `slice::sort()` for the small-N case. Insertion sort is
// O(N²) but trivial to implement without recursion/quicksort
// partition logic — and `Vec::sort` callers are usually < a few
// hundred elements where it's competitive. For larger inputs a
// later pass should switch to merge-sort or pdqsort.
//
// Takes a raw `*mut T, len` pair instead of `&mut [T]` because the
// implicit `&mut arr` → `&mut [T]` coercion at fn-arg only fires
// for array LITERALS today, not for var-bound arrays. Callers pass
// `&mut arr as *mut T` once arr is a binding.

/// Sorts the `n` elements at `base` in place, ascending (stable insertion sort, O(n^2)).
/// `base` must be valid for reads and writes of `n` elements. Intended for small `n`.
pub unsafe fn slice_sort<T: Ord + Copy>(base: *mut T, n: i64) {
    let esz: i64 = sizeof::<T>() as i64;
    let mut i: i64 = 1i64;
    while i < n {
        let cur: T = logos.lang.ptr::read((base as i64 + i * esz) as *const T);   // #463
        let mut j: i64 = i;
        while j > 0i64 {
            let prev_p: *mut T = (base as i64 + (j - 1i64) * esz) as *mut T;
            let prev: T = logos.lang.ptr::read(prev_p as *const T);   // #463
            match prev.cmp(&cur) {
                Ordering::Greater => {
                    let cur_p: *mut T = (base as i64 + j * esz) as *mut T;
                    *cur_p = prev;
                    j = j - 1i64;
                }
                Ordering::Less    => { break; }
                Ordering::Equal   => { break; }
            }
        }
        let slot: *mut T = (base as i64 + j * esz) as *mut T;
        *slot = cur;
        i = i + 1i64;
    }
}

// ── swap (Rust's `<[T]>::swap`) ────────────────────────────────────────────
// A slice method, reached through the `$slice$` impl key like any `impl … for [T]`;
// the trait exists only to carry it (Rust's is inherent on `[T]`).
/// In-place element exchange on a slice.
pub trait SliceSwap {
    /// Swaps the elements at `a` and `b`; panics when either index is out of bounds.
    fn swap(&mut self, a: i64, b: i64);
}
impl<T> SliceSwap for [T] {
    fn swap(&mut self, a: i64, b: i64) {
        let n: i64 = self.len() as i64;
        if a < 0i64 || a >= n || b < 0i64 || b >= n { panic("slice::swap: index out of bounds"); }
        if a == b { return; }
        unsafe {
            let p: *mut T = self.as_ptr() as *mut T;
            let tmp: T = p[a];
            p[a] = p[b];
            p[b] = tmp;
        }
    }
}

// ── The Rust `[T]` method surface ──────────────────────────────────────────
// Slice methods reach a slice receiver (and a Vec, an array) through the `$slice$`
// impl key; the traits exist only to carry them (Rust's are inherent on `[T]`).

/// Mutable borrowing iterator over a slice, yielding `&mut T` (Rust's `slice::IterMut`).
pub struct SliceIterMut<'a, T> {
    data: *mut T,
    idx: i64,
    back_idx: i64,
    // INVARIANT in `T`, as Rust's `IterMut<'a, T>`.
    _inv: PhantomData<&'a mut T>,
}

impl<'a, T> Iterator for SliceIterMut<'a, T> {
    type Item = &'a mut T;
    fn next(self: &mut SliceIterMut<'a, T>) -> Option<&'a mut T> {
        if self.idx >= self.back_idx { return Option::None; }
        unsafe {
            let q: *mut T = &mut self.data[self.idx] as *mut T;
            let r: &'a mut T = &mut *q;
            self.idx = self.idx + 1i64;
            return Option::Some(r);
        }
    }
}

impl<'a, T> DoubleEndedIterator for SliceIterMut<'a, T> {
    fn next_back(self: &mut SliceIterMut<'a, T>) -> Option<&'a mut T> {
        if self.idx >= self.back_idx { return Option::None; }
        unsafe {
            self.back_idx = self.back_idx - 1i64;
            let q: *mut T = &mut self.data[self.back_idx] as *mut T;
            let r: &'a mut T = &mut *q;
            return Option::Some(r);
        }
    }
}

impl<'a, T> ExactSizeIterator for SliceIterMut<'a, T> {
    fn len(&self) -> i64 { return self.back_idx - self.idx; }
}

/// The element-type-agnostic `[T]` methods.
pub trait SliceMethods<T> {
    /// `true` if the slice has no elements.
    fn is_empty(&self) -> bool;
    /// Borrowing iterator yielding `&T`.
    fn iter(&self) -> SliceIter<T>;
    /// Mutable iterator yielding `&mut T`.
    fn iter_mut(&mut self) -> SliceIterMut<T>;
    /// `Some(&self[i])` for an in-bounds `i`, else `None`.
    fn get(&self, i: i64) -> Option<&T>;
    /// `Some(&mut self[i])` for an in-bounds `i`, else `None`.
    fn get_mut(&mut self, i: i64) -> Option<&mut T>;
    /// The first element, or `None` if empty.
    fn first(&self) -> Option<&T>;
    /// The last element, or `None` if empty.
    fn last(&self) -> Option<&T>;
    /// The first element mutably, or `None` if empty.
    fn first_mut(&mut self) -> Option<&mut T>;
    /// The last element mutably, or `None` if empty.
    fn last_mut(&mut self) -> Option<&mut T>;
    /// `(&self[..mid], &self[mid..])`; panics if `mid > len`.
    fn split_at(&self, mid: i64) -> (&[T], &[T]);
    /// `(&mut self[..mid], &mut self[mid..])` — two disjoint mutable halves; panics if `mid > len`.
    fn split_at_mut(&mut self, mid: i64) -> (&mut [T], &mut [T]);
    /// Overlapping windows of `size` elements; panics if `size == 0`.
    fn windows(&self, size: i64) -> Windows<T>;
    /// Non-overlapping chunks of `size` elements (the last may be shorter); panics if `size == 0`.
    fn chunks(&self, size: i64) -> Chunks<T>;
    /// Reverses the elements in place.
    fn reverse(&mut self);
    /// Rotates left by `k`: `self[k]` becomes the first element. Panics if `k > len`.
    fn rotate_left(&mut self, k: i64);
    /// Rotates right by `k`: `self[len - k]` becomes the first element. Panics if `k > len`.
    fn rotate_right(&mut self, k: i64);
}

impl<T> SliceMethods<T> for [T] {
    fn is_empty(&self) -> bool { return self.len() == 0i64; }
    fn iter(&self) -> SliceIter<T> {
        unsafe { return iter_over_slice::<T>(self); }
    }
    fn iter_mut(&mut self) -> SliceIterMut<T> {
        let n: i64 = self.len() as i64;
        return SliceIterMut { data: self.as_ptr() as *mut T, idx: 0i64, back_idx: n,
                              _inv: PhantomData::<&mut T> {} };
    }
    fn get(&self, i: i64) -> Option<&T> {
        if i < 0i64 || i >= self.len() as i64 { return Option::None; }
        unsafe {
            let p: *const T = self.as_ptr() as *const T;
            return Option::Some(&*p.add(i));
        }
    }
    fn get_mut(&mut self, i: i64) -> Option<&mut T> {
        if i < 0i64 || i >= self.len() as i64 { return Option::None; }
        unsafe {
            let p: *mut T = self.as_ptr() as *mut T;
            return Option::Some(&mut *p.add(i));
        }
    }
    fn first(&self) -> Option<&T> { return self.get(0i64); }
    fn last(&self) -> Option<&T> { return self.get(self.len() as i64 - 1i64); }
    fn first_mut(&mut self) -> Option<&mut T> { return self.get_mut(0i64); }
    fn last_mut(&mut self) -> Option<&mut T> {
        let n: i64 = self.len() as i64;
        return self.get_mut(n - 1i64);
    }
    fn split_at(&self, mid: i64) -> (&[T], &[T]) {
        let n: i64 = self.len() as i64;
        if mid < 0i64 || mid > n { panic("slice::split_at: mid > len"); }
        unsafe {
            let p: *const T = self.as_ptr() as *const T;
            return (slice_from_raw::<T>(p, mid), slice_from_raw::<T>(p.add(mid), n - mid));
        }
    }
    fn split_at_mut(&mut self, mid: i64) -> (&mut [T], &mut [T]) {
        let n: i64 = self.len() as i64;
        if mid < 0i64 || mid > n { panic("slice::split_at_mut: mid > len"); }
        unsafe {
            let p: *const T = self.as_ptr() as *const T;
            return (slice_from_raw_mut::<T>(p as *mut T, mid),
                    slice_from_raw_mut::<T>(p.add(mid) as *mut T, n - mid));
        }
    }
    fn windows(&self, size: i64) -> Windows<T> {
        if size <= 0i64 { panic("slice::windows: window size must be non-zero"); }
        return Windows { data: self.as_ptr() as *const T, len: self.len() as i64, pos: 0i64, size: size };
    }
    fn chunks(&self, size: i64) -> Chunks<T> {
        if size <= 0i64 { panic("slice::chunks: chunk size must be non-zero"); }
        return Chunks { data: self.as_ptr() as *const T, len: self.len() as i64, pos: 0i64, step: size };
    }
    fn reverse(&mut self) {
        let n: i64 = self.len() as i64;
        if n < 2i64 { return; }
        unsafe {
            let p: *mut T = self.as_ptr() as *mut T;
            let mut i: i64 = 0i64;
            let mut j: i64 = n - 1i64;
            while i < j {
                let tmp: T = p[i];
                p[i] = p[j];
                p[j] = tmp;
                i = i + 1i64;
                j = j - 1i64;
            }
        }
    }
    fn rotate_left(&mut self, k: i64) {
        let n: i64 = self.len() as i64;
        if k < 0i64 || k > n { panic("slice::rotate_left: mid > len"); }
        if k == 0i64 || k == n { return; }
        // Three reversals: rev(a) rev(b) rev(ab) == ba.
        let (a, b) = self.split_at_mut(k);
        a.reverse();
        b.reverse();
        self.reverse();
    }
    fn rotate_right(&mut self, k: i64) {
        let n: i64 = self.len() as i64;
        if k < 0i64 || k > n { panic("slice::rotate_right: k > len"); }
        self.rotate_left(n - k);
    }
}

/// `[T]` methods that compare elements (`T: Eq`).
pub trait SliceEqMethods<T> {
    /// `true` if some element equals `x`.
    fn contains(&self, x: &T) -> bool;
    /// `true` if `needle` is a prefix of the slice.
    fn starts_with(&self, needle: &[T]) -> bool;
    /// `true` if `needle` is a suffix of the slice.
    fn ends_with(&self, needle: &[T]) -> bool;
}

impl<T: Eq> SliceEqMethods<T> for [T] {
    fn contains(&self, x: &T) -> bool {
        let n: i64 = self.len() as i64;
        unsafe {
            let p: *const T = self.as_ptr() as *const T;
            let mut i: i64 = 0i64;
            while i < n {
                if (&*p.add(i)).eq(x) { return true; }
                i = i + 1i64;
            }
        }
        return false;
    }
    fn starts_with(&self, needle: &[T]) -> bool {
        let m: i64 = needle.len() as i64;
        if m > self.len() as i64 { return false; }
        unsafe {
            let p: *const T = self.as_ptr() as *const T;
            let q: *const T = needle.as_ptr() as *const T;
            let mut i: i64 = 0i64;
            while i < m {
                if !(&*p.add(i)).eq(&*q.add(i)) { return false; }
                i = i + 1i64;
            }
        }
        return true;
    }
    fn ends_with(&self, needle: &[T]) -> bool {
        let n: i64 = self.len() as i64;
        let m: i64 = needle.len() as i64;
        if m > n { return false; }
        unsafe {
            let p: *const T = self.as_ptr() as *const T;
            let q: *const T = needle.as_ptr() as *const T;
            let mut i: i64 = 0i64;
            while i < m {
                if !(&*p.add(n - m + i)).eq(&*q.add(i)) { return false; }
                i = i + 1i64;
            }
        }
        return true;
    }
}

/// `[T]` methods over an ordered element type (`T: Ord`).
pub trait SliceOrdMethods<T> {
    /// Binary search of a sorted slice: `Ok(index)` of a match, else `Err(insertion point)`.
    fn binary_search(&self, x: &T) -> Result<i64, i64>;
}

impl<T: Ord> SliceOrdMethods<T> for [T] {
    fn binary_search(&self, x: &T) -> Result<i64, i64> {
        let mut lo: i64 = 0i64;
        let mut hi: i64 = self.len() as i64;
        unsafe {
            let p: *const T = self.as_ptr() as *const T;
            while lo < hi {
                let mid: i64 = lo + (hi - lo) / 2i64;
                match (&*p.add(mid)).cmp(x) {
                    Ordering::Less    => { lo = mid + 1i64; }
                    Ordering::Greater => { hi = mid; }
                    Ordering::Equal   => { return Result::Ok(mid); }
                }
            }
        }
        return Result::Err(lo);
    }
}

/// `[T]` methods that clone elements (`T: Clone`).
pub trait SliceCloneMethods<T> {
    /// Sets every element to a clone of `value` (the old elements are dropped).
    fn fill(&mut self, value: T);
    /// Clones `src` element-wise into `self` (the old elements are dropped); panics on a length mismatch.
    fn clone_from_slice(&mut self, src: &[T]);
}

impl<T: Clone> SliceCloneMethods<T> for [T] {
    fn fill(&mut self, value: T) {
        let n: i64 = self.len() as i64;
        unsafe {
            let p: *mut T = self.as_ptr() as *mut T;
            let mut i: i64 = 0i64;
            while i < n {
                let _old: T = p[i];
                p[i] = value.clone();
                i = i + 1i64;
            }
        }
    }
    fn clone_from_slice(&mut self, src: &[T]) {
        let n: i64 = self.len() as i64;
        if n != src.len() as i64 { panic("slice::clone_from_slice: source and destination lengths differ"); }
        unsafe {
            let p: *mut T = self.as_ptr() as *mut T;
            let q: *const T = src.as_ptr() as *const T;
            let mut i: i64 = 0i64;
            while i < n {
                let _old: T = p[i];
                p[i] = (&*q.add(i)).clone();
                i = i + 1i64;
            }
        }
    }
}

/// `[T]` methods that copy elements bitwise (`T: Copy`).
pub trait SliceCopyMethods<T> {
    /// Copies `src` into `self`; panics on a length mismatch.
    fn copy_from_slice(&mut self, src: &[T]);
}

impl<T: Copy> SliceCopyMethods<T> for [T] {
    fn copy_from_slice(&mut self, src: &[T]) { slice_copy_from::<T>(self, src); }
}
