#!/usr/bin/env python3
"""lt — the Logos test runner (replaces ctest as the runner).

CMake still DESCRIBES the tests (command, environment, timeout, fixtures); `lt`
imports those descriptions once (`ctest --show-only=json-v1`) and does
everything else itself: selection, levels, parallel execution, and a run
database that keeps every result with its duration and output.

Levels are computed for a TASK:
  L0  the task's own tests: its direct coverage (named tests, patterns).
  L1  every test of every persistent GROUP an L0 test belongs to, minus L0.
  L2  every other test.
The three are disjoint and together are the whole suite. Groups are defined by
tests/groups.rules (committed) and may overlap; levels never do.

  lt sync                              import test descriptions from CMake
  lt task new NAME [SEL...]            create a task; SEL = test name or /regex/
  lt task add NAME SEL...              add tests to a task's L0
  lt task use NAME                     make NAME the current task
  lt task show [NAME] | lt task list
  lt levels [--task NAME]              sizes of L0 / L1 / L2
  lt run --level 0|1|2 [--upto]        run a level (--upto: L0..level, stop at a red level)
  lt run --plus PCT                    run L0, then PCT% of EVERYTHING ELSE (L1 + L2):
                                       stratified by category, least recently run first,
                                       so successive runs rotate through the suite. Only
                                       a NEW L0 red (not red at an earlier head) stops
                                       the sample; pre-existing reds are listed and the
                                       exit code stays red (--keep-going: never stop)
  lt run --group G... [--except G...]  run groups (or --all [--except G...])
  lt run --failed                      rerun what failed in the last run
  lt run --same-as RUN                 rerun exactly the tests of run RUN (before/after)
  lt run NAME... | -k REGEX            run named tests / a name regex
  lt show TEST [--output] [-n N]       history of one test (status, seconds, output)
  lt last [--failed]                   the last run's summary
  lt groups [G]                        groups and their sizes (or members of G)

A SERIES is a run of like tasks on one branch (e.g. ten BC defects). While it
is open, each task runs its L0 plus a sample of the rest (`lt run --plus`); the
whole suite runs only when the series closes, and the series merges into main
only from a green whole-suite run of the very commit being merged:
  lt series new NAME [--pct P]         branch series/NAME off HEAD; the series is
                                       the one whose branch is checked out
  lt task new ...                      on a series branch: the task joins the series
  lt run --plus [PCT]                  L0 + PCT% (default: the series' --pct, 10)
  lt series close                      build, rerun the last close's reds, then
                                       the whole suite; reds become task NAME-fixN
                                       (fix it with --plus, commit, close again)
  lt series waive TEST... --why TEXT   a red the series did not cause (named in
                                       the merge commit)
  lt series merge                      merge into main: needs a green close of
                                       this clean HEAD, main an ancestor of it
  lt series show [NAME] | lt series list
On a series branch `run --all` and `run --level 2` refuse: that is `series close`.

Options for run: -j N (default $CTEST_PARALLEL_LEVEL, else 12), --build DIR,
--env K=V (extra environment for every test, repeatable).
"""
import argparse, datetime, json, os, re, signal, sqlite3, subprocess, sys, threading, time, zlib
from concurrent.futures import ThreadPoolExecutor

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# Process groups of running tests: an interrupted `lt` kills them, so a stopped
# run leaves nothing behind (each test runs in its own session).
ACTIVE = set()
ACTIVE_LOCK = threading.Lock()
STOPPING = threading.Event()

def _on_signal(signum, frame):
    STOPPING.set()
    with ACTIVE_LOCK:
        for pgid in list(ACTIVE):
            try:
                os.killpg(pgid, signal.SIGKILL)
            except ProcessLookupError:
                pass
    print(f"\nlt: interrupted (signal {signum}); running tests killed", file=sys.stderr)
    os._exit(130)
RULES = os.path.join(ROOT, "tests", "groups.rules")
DEFAULT_TIMEOUT = 1500.0

# ── database ─────────────────────────────────────────────────────────────────

SCHEMA = """
CREATE TABLE IF NOT EXISTS tests(
  name TEXT PRIMARY KEY, command TEXT, env TEXT, workdir TEXT, timeout REAL,
  labels TEXT, source TEXT, disabled INTEGER, processors INTEGER, skip_rc INTEGER,
  fixtures_setup TEXT, fixtures_required TEXT, depends TEXT, present INTEGER);
CREATE TABLE IF NOT EXISTS groups(grp TEXT, test TEXT, PRIMARY KEY(grp, test));
CREATE TABLE IF NOT EXISTS tasks(name TEXT PRIMARY KEY, created TEXT);
CREATE TABLE IF NOT EXISTS task_tests(task TEXT, test TEXT, why TEXT, PRIMARY KEY(task, test));
CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT);
CREATE TABLE IF NOT EXISTS runs(id INTEGER PRIMARY KEY, started TEXT, finished TEXT,
  build_key TEXT, head TEXT, args TEXT, task TEXT, total INTEGER, failed INTEGER, seconds REAL);
CREATE TABLE IF NOT EXISTS results(run INTEGER, test TEXT, status TEXT, rc INTEGER,
  seconds REAL, output BLOB, PRIMARY KEY(run, test));
CREATE INDEX IF NOT EXISTS results_test ON results(test, run);
CREATE TABLE IF NOT EXISTS series(name TEXT PRIMARY KEY, branch TEXT, base TEXT, pct REAL,
  state TEXT, created TEXT, green_run INTEGER, green_head TEXT);
CREATE TABLE IF NOT EXISTS series_tasks(series TEXT, task TEXT, PRIMARY KEY(series, task));
CREATE TABLE IF NOT EXISTS series_closes(series TEXT, run INTEGER, head TEXT, reds INTEGER);
CREATE TABLE IF NOT EXISTS series_waivers(series TEXT, test TEXT, why TEXT, PRIMARY KEY(series, test));
"""

def db_open(build):
    con = sqlite3.connect(os.path.join(build, "testdb.sqlite"), check_same_thread=False)
    con.executescript(SCHEMA)
    return con

def meta_get(con, k, default=None):
    r = con.execute("SELECT v FROM meta WHERE k=?", (k,)).fetchone()
    return r[0] if r else default

def meta_set(con, k, v):
    con.execute("INSERT OR REPLACE INTO meta(k,v) VALUES(?,?)", (k, v))

# ── sync: CMake descriptions -> tests, rules -> groups ──────────────────────

def test_source(cmd):
    for a in cmd:
        if a.endswith(".logos"):
            return os.path.relpath(a, ROOT) if a.startswith(ROOT) else a
    for a in cmd[1:] if len(cmd) > 1 else cmd:
        if a.startswith(ROOT) and (a.endswith(".sh") or a.endswith(".py")):
            return os.path.relpath(a, ROOT)
    return ""

def load_rules():
    rules = []
    if not os.path.exists(RULES):
        return rules
    for ln, line in enumerate(open(RULES), 1):
        line = line.rstrip("\n")
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = line.split("\t")
        if len(parts) != 2:
            sys.exit(f"lt: {RULES}:{ln}: expected `group<TAB>pattern`")
        grp, pat = parts[0].strip(), parts[1].strip()
        if pat.startswith("="):
            rules.append((grp, "exact", pat[1:]))
        elif pat.startswith("label:"):
            rules.append((grp, "label", pat[6:]))
        else:
            rules.append((grp, "re", re.compile(pat)))
    return rules

def sync(build, con, quiet=False):
    out = subprocess.run(["ctest", "--show-only=json-v1"], cwd=build,
                         capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit("lt: `ctest --show-only=json-v1` failed; is the build configured?\n" + out.stderr)
    data = json.loads(out.stdout)
    seen = set()
    con.execute("UPDATE tests SET present=0")
    for t in data["tests"]:
        props = {p["name"]: p["value"] for p in t.get("properties", [])}
        cmd = t.get("command") or []
        name = t["name"]
        seen.add(name)
        con.execute("""INSERT OR REPLACE INTO tests VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,1)""", (
            name, json.dumps(cmd), json.dumps(props.get("ENVIRONMENT", [])),
            props.get("WORKING_DIRECTORY", build), float(props.get("TIMEOUT", DEFAULT_TIMEOUT)),
            json.dumps(props.get("LABELS", [])), test_source(cmd),
            1 if props.get("DISABLED") else 0, int(props.get("PROCESSORS", 1)),
            props.get("SKIP_RETURN_CODE"), json.dumps(props.get("FIXTURES_SETUP", [])),
            json.dumps(props.get("FIXTURES_REQUIRED", [])), json.dumps(props.get("DEPENDS", []))))
    gone = [r[0] for r in con.execute("SELECT name FROM tests WHERE present=0")]
    # groups are recomputed from the rules every sync
    rules = load_rules()
    con.execute("DELETE FROM groups")
    rows = con.execute("SELECT name, source, labels FROM tests WHERE present=1").fetchall()
    for name, source, labels in rows:
        labs = set(json.loads(labels))
        for grp, kind, pat in rules:
            hit = (kind == "exact" and name == pat) or \
                  (kind == "label" and pat in labs) or \
                  (kind == "re" and (pat.search(name) or pat.search(source)))
            if hit:
                con.execute("INSERT OR IGNORE INTO groups VALUES(?,?)", (grp, name))
    meta_set(con, "synced", datetime.datetime.now().isoformat(timespec="seconds"))
    con.commit()
    if not quiet:
        print(f"lt: {len(seen)} tests, {len(gone)} no longer registered"
              + (": " + ", ".join(gone[:10]) + (" …" if len(gone) > 10 else "") if gone else ""))

def ensure_synced(build, con):
    # Re-import whenever CMake's registration (any CTestTestfile.cmake) is newer
    # than the last import.
    newest = 0.0
    for dp, dns, fs in os.walk(build):
        if dp.count(os.sep) - build.count(os.sep) >= 3:
            dns[:] = []
        if "CTestTestfile.cmake" in fs:
            newest = max(newest, os.path.getmtime(os.path.join(dp, "CTestTestfile.cmake")))
    if meta_get(con, "synced_mtime") != repr(newest):
        sync(build, con, quiet=True)
        meta_set(con, "synced_mtime", repr(newest))
        con.commit()

# ── selection ────────────────────────────────────────────────────────────────

def all_tests(con):
    return [r[0] for r in con.execute("SELECT name FROM tests WHERE present=1")]

def resolve_sel(con, sels):
    names = set(all_tests(con))
    out = []
    for s in sels:
        if s.startswith("/") and s.endswith("/") and len(s) > 2:
            rx = re.compile(s[1:-1])
            out += sorted(n for n in names if rx.search(n))
        elif s in names:
            out.append(s)
        else:
            sys.exit(f"lt: no such test: {s}  (use /regex/ for a pattern)")
    return out

def current_task(con, name=None):
    t = name or meta_get(con, "task")
    if not t:
        sys.exit("lt: no task; `lt task new NAME SEL...` or pass --task NAME")
    if not con.execute("SELECT 1 FROM tasks WHERE name=?", (t,)).fetchone():
        sys.exit(f"lt: no such task: {t}")
    return t

def levels(con, task):
    everything = set(all_tests(con))
    l0 = {r[0] for r in con.execute("SELECT test FROM task_tests WHERE task=?", (task,))} & everything
    grps = {r[0] for r in con.execute(
        "SELECT DISTINCT grp FROM groups WHERE test IN (SELECT test FROM task_tests WHERE task=?)", (task,))}
    l1 = set()
    for g in grps:
        l1 |= {r[0] for r in con.execute("SELECT test FROM groups WHERE grp=?", (g,))}
    l1 = (l1 & everything) - l0
    l2 = everything - l0 - l1
    return l0, l1, l2, sorted(grps)

# ── execution ────────────────────────────────────────────────────────────────

def build_key(build):
    try:
        out = subprocess.run([sys.executable, os.path.join(ROOT, "scripts", "hash-build.py"), build],
                             capture_output=True, text=True, timeout=120)
        return out.stdout.split()[0] if out.returncode == 0 and out.stdout.strip() else "unknown"
    except Exception:
        return "unknown"

def git_head():
    r = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], capture_output=True, text=True)
    dirty = subprocess.run(["git", "-C", ROOT, "status", "--porcelain", "--untracked-files=no"],
                           capture_output=True, text=True).stdout.strip()
    return r.stdout.strip() + ("-dirty" if dirty else "")

def add_fixture_setups(con, names):
    """ctest's rule: a test that REQUIRES a fixture pulls in that fixture's
    setup tests, and runs after them; if one of them fails it does not run."""
    sel = set(names)
    req = {}
    for n in list(sel):
        r = con.execute("SELECT fixtures_required, depends FROM tests WHERE name=?", (n,)).fetchone()
        fx, dep = json.loads(r[0]), json.loads(r[1])
        req[n] = (fx, dep)
    need = {f for fx, _ in req.values() for f in fx}
    setups = {}
    if need:
        for name, fs in con.execute("SELECT name, fixtures_setup FROM tests WHERE present=1"):
            for f in json.loads(fs):
                if f in need:
                    setups.setdefault(f, []).append(name)
    pulled = set()
    for f in need:
        for s in setups.get(f, []):
            if s not in sel:
                pulled.add(s)
    return sel | pulled, setups, req, pulled

class Runner:
    def __init__(self, con, build, jobs, run_id, verbose):
        self.con, self.build, self.jobs, self.run_id, self.verbose = con, build, jobs, run_id, verbose
        self.lock = threading.Lock()
        self.slots = threading.Semaphore(jobs)
        self.done = 0
        self.failed = []
        self.status = {}
        self.stop = False
        self.extra_env = []

    def one(self, name, total):
        t = self.con_local().execute(
            "SELECT command, env, workdir, timeout, disabled, processors, skip_rc FROM tests WHERE name=?",
            (name,)).fetchone()
        cmd, env, wd, tmo, disabled, procs, skip_rc = t
        procs = max(1, min(int(procs or 1), self.jobs))
        if disabled:
            return self.record(name, "disabled", None, 0.0, b"", total)
        for _ in range(procs):
            self.slots.acquire()
        try:
            if self.stop:
                return self.record(name, "notrun", None, 0.0, b"", total)
            e = dict(os.environ)
            for kv in json.loads(env) + list(self.extra_env):
                k, _, v = kv.partition("=")
                e[k] = v
            t0 = time.monotonic()
            try:
                if STOPPING.is_set():
                    return self.record(name, "notrun", None, 0.0, b"", total)
                p = subprocess.Popen(json.loads(cmd), cwd=wd, env=e, stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, start_new_session=True)
                with ACTIVE_LOCK:
                    ACTIVE.add(p.pid)
                try:
                    out, _ = p.communicate(timeout=tmo)
                    rc = p.returncode
                    st = "passed" if rc == 0 else ("skipped" if skip_rc is not None and rc == int(skip_rc) else "failed")
                except subprocess.TimeoutExpired:
                    os.killpg(p.pid, signal.SIGKILL)
                    out, _ = p.communicate()
                    rc, st = None, "timeout"
                finally:
                    with ACTIVE_LOCK:
                        ACTIVE.discard(p.pid)
            except OSError as ex:
                out, rc, st = str(ex).encode(), None, "failed"
            return self.record(name, st, rc, time.monotonic() - t0, out, total)
        finally:
            for _ in range(procs):
                self.slots.release()

    _tls = threading.local()
    def con_local(self):
        c = getattr(self._tls, "con", None)
        if c is None:
            c = sqlite3.connect(os.path.join(self.build, "testdb.sqlite"), check_same_thread=False)
            self._tls.con = c
        return c

    def record(self, name, st, rc, secs, out, total):
        with self.lock:
            self.con.execute("INSERT OR REPLACE INTO results VALUES(?,?,?,?,?,?)",
                             (self.run_id, name, st, rc, secs, zlib.compress(out or b"")))
            self.done += 1
            self.status[name] = st
            if st in ("failed", "timeout"):
                self.failed.append(name)
                tail = (out or b"").decode("utf-8", "replace").strip().splitlines()[-6:]
                print(f"  FAIL {name} ({st}, {secs:.1f}s)")
                for l in tail:
                    print(f"       {l[:200]}")
            elif self.verbose:
                print(f"  {st:8s} {name} {secs:.1f}s")
            if self.done % 200 == 0 or self.done == total:
                print(f"  … {self.done}/{total} done, {len(self.failed)} failed", flush=True)
                self.con.commit()

def run_set(con, build, names, args, task, label):
    names = sorted(set(names))
    if not names:
        print(f"lt: {label}: nothing to run")
        return 0
    sel, setups, req, pulled = add_fixture_setups(con, names)
    if pulled:
        print(f"lt: {len(pulled)} fixture setup tests pulled in (required by {sum(1 for n in req if req[n][0])} tests)")
    jobs = args.jobs or int(os.environ.get("CTEST_PARALLEL_LEVEL", "12"))
    started = datetime.datetime.now().isoformat(timespec="seconds")
    cur = con.execute("INSERT INTO runs(started, build_key, head, args, task, total) VALUES(?,?,?,?,?,?)",
                      (started, build_key(build), git_head(), " ".join(sys.argv[1:]), task, len(sel)))
    run_id = cur.lastrowid
    con.commit()
    print(f"lt: run {run_id} — {label}: {len(sel)} tests, -j{jobs}")
    r = Runner(con, build, jobs, run_id, args.verbose)
    r.extra_env = list(args.env or [])
    # history-informed order: longest first, so the tail does not wait on one slow test
    dur = dict(con.execute("SELECT test, AVG(seconds) FROM results WHERE status IN ('passed','failed') GROUP BY test"))
    ready = [n for n in sel if not req.get(n, ([], []))[0] and not req.get(n, ([], []))[1]]
    later = [n for n in sel if n not in ready]
    ready.sort(key=lambda n: -(dur.get(n) or 1.0))
    t0 = time.monotonic()
    with ThreadPoolExecutor(max_workers=jobs) as ex:
        list(ex.map(lambda n: r.one(n, len(sel)), ready))
    for n in later:   # fixture / DEPENDS consumers: after everything they could need
        fx, dep = req[n]
        blocked = [s for f in fx for s in setups.get(f, []) if r.status.get(s) not in ("passed", "skipped", "disabled")]
        blocked += [d for d in dep if d in r.status and r.status[d] not in ("passed", "skipped", "disabled")]
        if blocked:
            r.record(n, "notrun", None, 0.0, ("required setup failed: " + ", ".join(blocked[:5])).encode(), len(sel))
        else:
            r.one(n, len(sel))
    secs = time.monotonic() - t0
    con.execute("UPDATE runs SET finished=?, failed=?, seconds=? WHERE id=?",
                (datetime.datetime.now().isoformat(timespec="seconds"), len(r.failed), secs, run_id))
    con.commit()
    counts = {}
    for st in r.status.values():
        counts[st] = counts.get(st, 0) + 1
    print(f"lt: run {run_id} — {label}: " + ", ".join(f"{k} {v}" for k, v in sorted(counts.items()))
          + f" in {secs:.0f}s")
    return 1 if r.failed or counts.get("notrun") else 0

# ── commands ─────────────────────────────────────────────────────────────────

def stratum(source, name):
    """The category a test is sampled within: its source directory
    (tests/imported/pass/borrowck, tests/logos/fail, …), else its name prefix."""
    if source:
        d = os.path.dirname(source)
        return d or source
    return "_".join(name.split("_")[:2])

WIDE_FIXTURE = 50

def wide_consumers(con):
    """Tests requiring a fixture with more than WIDE_FIXTURE setup tests."""
    count = {}
    for (fs,) in con.execute("SELECT fixtures_setup FROM tests WHERE present=1"):
        for f in json.loads(fs or "[]"):
            count[f] = count.get(f, 0) + 1
    wide = {f for f, c in count.items() if c > WIDE_FIXTURE}
    if not wide:
        return set()
    return {n for n, fr in con.execute("SELECT name, fixtures_required FROM tests WHERE present=1")
            if wide & set(json.loads(fr or "[]"))}

def sample_rest(con, pool, pct):
    """`pct` percent of `pool` (a task's L1 + L2), stratified by category
    (largest-remainder allocation, so each category keeps its share), and
    within a category the tests run LEAST recently first (never-run first), so
    successive samples rotate through the whole suite. Ties break by a
    deterministic hash of the name."""
    import hashlib, math
    rest = [r for r in con.execute("SELECT name, source FROM tests WHERE present=1") if r[0] in pool]
    # A test whose fixture needs a large share of the suite as setup (a census
    # over every compile's facts) is a whole-suite consumer: sampling it pulls
    # the suite in. It runs with the whole suite (`--all`, `series close`).
    wide = wide_consumers(con)
    if wide:
        n = sum(1 for r in rest if r[0] in wide)
        if n:
            print(f"lt: {n} whole-suite consumer(s) left out of the sample (fixture needs > {WIDE_FIXTURE} setups)")
        rest = [r for r in rest if r[0] not in wide]
    want = math.ceil(len(rest) * pct / 100.0) if pct > 0 else 0
    if want <= 0 or not rest:
        return set()
    last = dict(con.execute("SELECT test, MAX(run) FROM results GROUP BY test"))
    strata = {}
    for name, source in rest:
        strata.setdefault(stratum(source, name), []).append(name)
    quota = {k: len(v) * want / len(rest) for k, v in strata.items()}
    alloc = {k: int(math.floor(q)) for k, q in quota.items()}
    left = want - sum(alloc.values())
    for k in sorted(quota, key=lambda k: -(quota[k] - alloc[k]))[:left]:
        alloc[k] += 1
    out = set()
    for k, names in strata.items():
        names.sort(key=lambda n: (last.get(n, 0), hashlib.sha1(n.encode()).hexdigest()))
        out |= set(names[:alloc[k]])
    return out

# ── series ───────────────────────────────────────────────────────────────────

def git(*a, check=True):
    r = subprocess.run(["git", "-C", ROOT, *a], capture_output=True, text=True)
    if check and r.returncode:
        sys.exit(f"lt: git {' '.join(a)}: {r.stderr.strip()}")
    return r.stdout.strip()

def git_branch():
    return git("rev-parse", "--abbrev-ref", "HEAD")

def git_clean():
    return not git("status", "--porcelain", "--untracked-files=no")

def main_is_ancestor():
    """bors' rule: what merges is what was tested, so main must already be in HEAD."""
    return subprocess.run(["git", "-C", ROOT, "merge-base", "--is-ancestor", "main", "HEAD"]).returncode == 0

def current_series(con):
    r = con.execute("SELECT name, branch, base, pct, state, green_run, green_head FROM series "
                    "WHERE branch=? AND state != 'merged'", (git_branch(),)).fetchone()
    return r

def red_names(con, run_id):
    return sorted(r[0] for r in con.execute(
        "SELECT test FROM results WHERE run=? AND status IN ('failed','timeout','notrun')", (run_id,)))

def cmd_series(con, build, args):
    if args.op == "list":
        for n, b, base, pct, st, c in con.execute(
                "SELECT name, branch, base, pct, state, created FROM series ORDER BY created"):
            k = con.execute("SELECT COUNT(*) FROM series_tasks WHERE series=?", (n,)).fetchone()[0]
            print(f"  {n:24s} {st:8s} tasks {k:3d}  +{pct:g}%  base {base}  {b}  {c}")
        return 0
    if args.op == "new":
        if not args.name:
            sys.exit("lt series new: NAME required")
        if not git_clean():
            sys.exit("lt series new: commit first (the base must be a commit)")
        branch = f"series/{args.name}"
        base = git("rev-parse", "--short", "HEAD")
        git("switch", "-c", branch)
        con.execute("INSERT INTO series VALUES(?,?,?,?,?,?,NULL,NULL)",
                    (args.name, branch, base, args.pct, "open", datetime.datetime.now().isoformat(timespec="seconds")))
        con.commit()
        print(f"lt: series {args.name} on {branch} from {base}; each task: `lt task new`, `lt run --plus`")
        return 0
    if args.op == "show":
        r = (con.execute("SELECT name, branch, base, pct, state, green_run, green_head FROM series WHERE name=?",
                         (args.name,)).fetchone() if args.name else current_series(con))
        if not r:
            sys.exit("lt: no such series (or not on a series branch)")
        name, branch, base, pct, st, grun, ghead = r
        print(f"series {name}: {st}  {branch} from {base}  +{pct:g}%"
              + (f"  green close: run {grun} at {ghead}" if grun else ""))
        for (t,) in con.execute("SELECT task FROM series_tasks WHERE series=? ORDER BY rowid", (name,)):
            last = con.execute("SELECT id, head, failed FROM runs WHERE task=? AND args LIKE '%--plus%' "
                               "ORDER BY id DESC LIMIT 1", (t,)).fetchone()
            print(f"  {t:30s} " + (f"last --plus run {last[0]} at {last[1]}: {'green' if not last[2] else 'RED'}"
                                   if last else "not run"))
        for run, head, reds in con.execute("SELECT run, head, reds FROM series_closes WHERE series=?", (name,)):
            print(f"  close: run {run} at {head}: {reds} red")
        for t, why in con.execute("SELECT test, why FROM series_waivers WHERE series=?", (name,)):
            print(f"  waived {t}: {why}")
        return 0
    s = current_series(con)
    if not s:
        sys.exit(f"lt series {args.op}: not on a series branch (`lt series list`)")
    name, branch, base, pct, st, grun, ghead = s
    if args.op == "waive":
        if not args.why or not args.name:
            sys.exit("lt series waive TEST... --why TEXT")
        for t in [args.name] + args.tests:
            con.execute("INSERT OR REPLACE INTO series_waivers VALUES(?,?,?)", (name, t, args.why))
        con.commit()
        return 0
    if args.op == "close":
        if not git_clean():
            sys.exit("lt series close: commit first; a close verifies a commit")
        if not main_is_ancestor():
            sys.exit("lt series close: main has moved; `git merge main` into the series first, "
                     "so the whole-suite run covers what will be merged")
        jobs = args.jobs or int(os.environ.get("CTEST_PARALLEL_LEVEL", "12"))
        print(f"lt: building ({build}, -j{jobs})")
        if subprocess.run(["cmake", "--build", build, f"-j{jobs}"]).returncode:
            sys.exit("lt series close: the build failed")
        sync(build, con, quiet=True)
        head = git("rev-parse", "--short", "HEAD")
        waived = {r[0] for r in con.execute("SELECT test FROM series_waivers WHERE series=?", (name,))}
        prev = con.execute("SELECT run FROM series_closes WHERE series=? AND reds > 0 ORDER BY rowid DESC LIMIT 1",
                           (name,)).fetchone()
        if prev:
            again = set(red_names(con, prev[0])) - waived
            if again:
                run_set(con, build, again, args, None, f"series {name}: reds of close run {prev[0]}")
                still = set(red_names(con, con.execute("SELECT MAX(id) FROM runs").fetchone()[0])) - waived
                if still:
                    print(f"lt: {len(still)} of the last close's reds are still red; not running the suite")
                    return 1
        run_set(con, build, set(all_tests(con)), args, None, f"series {name}: close")
        rid = con.execute("SELECT MAX(id) FROM runs").fetchone()[0]
        reds = [t for t in red_names(con, rid) if t not in waived]
        con.execute("INSERT INTO series_closes VALUES(?,?,?,?)", (name, rid, head, len(reds)))
        if not reds:
            con.execute("UPDATE series SET state='green', green_run=?, green_head=? WHERE name=?", (rid, head, name))
            con.commit()
            print(f"lt: series {name} is green at {head} (run {rid}); `lt series merge`")
            return 0
        k = con.execute("SELECT COUNT(*) FROM series_closes WHERE series=?", (name,)).fetchone()[0]
        fix = f"{name}-fix{k}"
        con.execute("INSERT OR IGNORE INTO tasks VALUES(?,?)", (fix, datetime.datetime.now().isoformat(timespec="seconds")))
        for t in reds:
            con.execute("INSERT OR IGNORE INTO task_tests VALUES(?,?,?)", (fix, t, f"red in close run {rid}"))
        con.execute("INSERT OR IGNORE INTO series_tasks VALUES(?,?)", (name, fix))
        con.execute("UPDATE series SET state='fixing' WHERE name=?", (name,))
        meta_set(con, "task", fix)
        con.commit()
        print(f"lt: {len(reds)} red; task {fix} holds them (current). Fix with `lt run --plus`, "
              f"commit, `lt series close` again. A red the series did not cause: `lt series waive`.")
        for t in reds[:40]:
            print("  " + t)
        return 1
    if args.op == "merge":
        head = git("rev-parse", "--short", "HEAD")
        if st != "green" or ghead != head or not git_clean():
            sys.exit(f"lt series merge: no green close of this clean HEAD ({head}); `lt series close`")
        if not main_is_ancestor():
            sys.exit("lt series merge: main has moved since the close; `git merge main`, `lt series close`")
        waivers = con.execute("SELECT test, why FROM series_waivers WHERE series=?", (name,)).fetchall()
        tasks = [r[0] for r in con.execute("SELECT task FROM series_tasks WHERE series=? ORDER BY rowid", (name,))]
        msg = (f"Merge series {name}\n\nTasks: {', '.join(tasks) or '-'}.\n"
               f"Whole suite green at {head} (lt run {grun}).\n")
        if waivers:
            msg += "Red and waived:\n" + "".join(f"  {t}: {w}\n" for t, w in waivers)
        git("switch", "main")
        git("merge", "--no-ff", "-m", msg, branch)
        con.execute("UPDATE series SET state='merged' WHERE name=?", (name,))
        con.commit()
        print(f"lt: series {name} merged into main; branch {branch} kept")
        return 0
    sys.exit(f"lt series: unknown op {args.op}")

def cmd_run(con, build, args):
    ensure_synced(build, con)
    everything = set(all_tests(con))
    task = None
    ser = current_series(con)
    if ser and (args.all or args.level == 2) and not args.force:
        sys.exit(f"lt run: on series {ser[0]} the whole suite runs at `lt series close` "
                 "(--force to run it anyway)")
    if args.plus is not None and args.plus < 0:
        if not ser:
            sys.exit("lt run --plus: give PCT (not on a series branch)")
        args.plus = ser[3]
    if args.plus is not None:
        task = current_task(con, args.task)
        l0, l1, l2, _ = levels(con, task)
        rc = run_set(con, build, l0, args, task, f"task {task} L0")
        if rc and not args.keep_going:
            # Only a NEW red stops the sample. A test that was already red in its
            # previous recorded result is a known failure of the tree, not of this
            # change — blocking on it made `--plus` unusable while the tree carried
            # any pre-existing red at all.
            l0_run, l0_head = con.execute(
                "SELECT id, head FROM runs WHERE id=(SELECT MAX(id) FROM runs)").fetchone()
            reds = [t for (t,) in con.execute(
                "SELECT test FROM results WHERE run=? AND status IN ('failed','notrun')", (l0_run,))]
            new_reds = []
            for t in reds:
                # The PREVIOUS STATE, not the previous run: a run of the SAME head
                # (an earlier or interrupted run of this very working tree) cannot
                # vouch that the red predates the change. Measured: an interrupted
                # L0 recorded a new key-identity red, and the next --plus of the same
                # tree then called it pre-existing.
                prev = con.execute(
                    "SELECT r.status FROM results r JOIN runs u ON u.id = r.run "
                    "WHERE r.test=? AND r.run<? AND u.head IS NOT ? "
                    "ORDER BY r.run DESC LIMIT 1", (t, l0_run, l0_head)).fetchone()
                if not prev or prev[0] not in ("failed", "notrun"):
                    new_reds.append(t)
            if new_reds:
                print(f"lt: L0 is red — {len(new_reds)} NEW red (not red before this working state); "
                      "not running the sample:")
                for t in sorted(new_reds)[:20]:
                    print(f"  {t}")
                return rc
            print(f"lt: L0 red only with {len(reds)} PRE-EXISTING red (red at an earlier working state too); "
                  "running the sample")
        # The sample is drawn from EVERYTHING the task's own tests are not:
        # L1 (the groups they belong to) and L2 (the rest), which are disjoint
        # from L0 by construction. Drawing from L2 alone meant that the better
        # L0 got, the more groups L1 swallowed and the further the sample drifted
        # from the work — `generics` and `patterns` sat entirely in L1 and never
        # ran under `--plus`.
        smp = sample_rest(con, l1 | l2, args.plus)
        return run_set(con, build, smp, args, task, f"task {task} +{args.plus:g}% of L1+L2") or rc
    if args.level is not None:
        task = current_task(con, args.task)
        l = levels(con, task)
        todo = [0, 1, 2][:args.level + 1] if args.upto else [args.level]
        rc = 0
        for lv in todo:
            rc = run_set(con, build, l[lv], args, task, f"task {task} L{lv}")
            if rc and args.upto and lv != todo[-1]:
                print(f"lt: L{lv} is red; not running further levels")
                return rc
        return rc
    if args.same_as is not None:
        names = [r[0] for r in con.execute("SELECT test FROM results WHERE run=?", (args.same_as,))]
        if not names:
            sys.exit(f"lt: run {args.same_as} has no results")
        return run_set(con, build, names, args, None, f"same tests as run {args.same_as}")
    if args.failed:
        last = con.execute("SELECT MAX(id) FROM runs").fetchone()[0]
        names = [r[0] for r in con.execute(
            "SELECT test FROM results WHERE run=? AND status IN ('failed','timeout','notrun')", (last,))]
        return run_set(con, build, names, args, None, f"failed in run {last}")
    names = set()
    if args.all:
        names = set(everything)
    for g in args.group or []:
        mem = {r[0] for r in con.execute("SELECT test FROM groups WHERE grp=?", (g,))}
        if not mem:
            sys.exit(f"lt: no such group (or empty): {g}")
        names |= mem
    if args.k:
        rx = re.compile(args.k)
        names |= {n for n in everything if rx.search(n)}
    if args.names:
        names |= set(resolve_sel(con, args.names))
    if args.ungrouped:
        grouped = {r[0] for r in con.execute("SELECT DISTINCT test FROM groups")}
        names |= everything - grouped
    for g in args.except_ or []:
        names -= {r[0] for r in con.execute("SELECT test FROM groups WHERE grp=?", (g,))}
    if not names:
        sys.exit("lt run: nothing selected (see `lt --help`)")
    return run_set(con, build, names & everything, args, None, "selection")

def cmd_task(con, build, args):
    ensure_synced(build, con)
    if args.op == "list":
        for n, c in con.execute("SELECT name, created FROM tasks ORDER BY created"):
            k = con.execute("SELECT COUNT(*) FROM task_tests WHERE task=?", (n,)).fetchone()[0]
            mark = "*" if n == meta_get(con, "task") else " "
            print(f"{mark} {n:30s} L0={k:5d}  {c}")
        return 0
    if args.op in ("new", "add", "use"):
        if not args.name:
            sys.exit(f"lt task {args.op}: NAME required")
    if args.op == "new":
        con.execute("INSERT OR IGNORE INTO tasks VALUES(?,?)",
                    (args.name, datetime.datetime.now().isoformat(timespec="seconds")))
        meta_set(con, "task", args.name)
        ser = current_series(con)
        if ser:
            con.execute("INSERT OR IGNORE INTO series_tasks VALUES(?,?)", (ser[0], args.name))
            print(f"lt: task {args.name} joins series {ser[0]}")
    if args.op in ("new", "add"):
        if not con.execute("SELECT 1 FROM tasks WHERE name=?", (args.name,)).fetchone():
            sys.exit(f"lt: no such task: {args.name}")
        for t in resolve_sel(con, args.sel):
            con.execute("INSERT OR IGNORE INTO task_tests VALUES(?,?,?)", (args.name, t, "manual"))
    if args.op == "use":
        current_task(con, args.name)
        meta_set(con, "task", args.name)
    con.commit()
    if args.op == "rm":
        con.execute("DELETE FROM task_tests WHERE task=?", (args.name,))
        con.execute("DELETE FROM tasks WHERE name=?", (args.name,))
        con.commit()
        return 0
    task = current_task(con, args.name if args.op != "list" else None)
    l0, l1, l2, grps = levels(con, task)
    print(f"task {task}: L0 {len(l0)}  L1 {len(l1)}  L2 {len(l2)}   groups: {', '.join(grps) or '—'}")
    if args.op == "show":
        for n in sorted(l0):
            print("  " + n)
    return 0

def cmd_levels(con, build, args):
    ensure_synced(build, con)
    task = current_task(con, args.task)
    l0, l1, l2, grps = levels(con, task)
    dur = dict(con.execute("SELECT test, AVG(seconds) FROM results WHERE status IN ('passed','failed') GROUP BY test"))
    for i, s in enumerate((l0, l1, l2)):
        cpu = sum(dur.get(n, 1.0) for n in s)
        print(f"L{i}: {len(s):6d} tests  ~{cpu/60:6.1f} CPU-min")
    if args.plus is not None:
        smp = sample_rest(con, l1 | l2, args.plus)
        cpu = sum(dur.get(n, 1.0) for n in smp)
        print(f"+{args.plus:g}% of L1+L2: {len(smp):6d} tests  ~{cpu/60:6.1f} CPU-min")
    print("groups of L0: " + (", ".join(grps) or "—"))
    return 0

def cmd_show(con, build, args):
    rows = con.execute("""SELECT r.id, r.started, r.head, res.status, res.seconds, res.rc, res.output
                          FROM results res JOIN runs r ON r.id = res.run WHERE res.test=?
                          ORDER BY r.id DESC LIMIT ?""", (args.test, args.n)).fetchall()
    if not rows:
        sys.exit(f"lt: no results for {args.test}")
    t = con.execute("SELECT source, labels, timeout FROM tests WHERE name=?", (args.test,)).fetchone()
    grps = [r[0] for r in con.execute("SELECT grp FROM groups WHERE test=? ORDER BY grp", (args.test,))]
    if t:
        print(f"{args.test}\n  source {t[0] or '—'}  groups {', '.join(grps) or '—'}  timeout {t[2]:.0f}s")
    for rid, started, head, st, secs, rc, out in rows:
        print(f"  run {rid:5d} {started} {head:14s} {st:8s} {secs:7.2f}s rc={rc}")
        if args.output:
            text = zlib.decompress(out).decode("utf-8", "replace") if out else ""
            for l in text.splitlines():
                print("    | " + l)
    return 0

def cmd_last(con, build, args):
    r = con.execute("SELECT id, started, finished, head, args, task, total, failed, seconds FROM runs ORDER BY id DESC LIMIT 1").fetchone()
    if not r:
        sys.exit("lt: no runs yet")
    rid = r[0]
    print(f"run {rid}: {r[1]} → {r[2] or 'INTERRUPTED'}  head {r[3]}  task {r[5] or '—'}  `lt {r[4]}`")
    for st, c in con.execute("SELECT status, COUNT(*) FROM results WHERE run=? GROUP BY status", (rid,)):
        print(f"  {st:8s} {c}")
    if args.failed:
        for (n,) in con.execute("SELECT test FROM results WHERE run=? AND status IN ('failed','timeout','notrun') ORDER BY test", (rid,)):
            print("  " + n)
    return 0

def cmd_groups(con, build, args):
    ensure_synced(build, con)
    if args.group:
        for (n,) in con.execute("SELECT test FROM groups WHERE grp=? ORDER BY test", (args.group,)):
            print(n)
        return 0
    total = len(all_tests(con))
    grouped = con.execute("SELECT COUNT(DISTINCT test) FROM groups").fetchone()[0]
    for g, c in con.execute("SELECT grp, COUNT(*) FROM groups GROUP BY grp ORDER BY grp"):
        print(f"  {g:24s} {c:6d}")
    print(f"  {'(in no group)':24s} {total - grouped:6d}   of {total}")
    return 0

def main():
    ap = argparse.ArgumentParser(prog="lt", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--build", default=os.path.join(ROOT, "build"))
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("sync")
    t = sub.add_parser("task"); t.add_argument("op", choices=["new", "add", "use", "show", "list", "rm"])
    t.add_argument("name", nargs="?"); t.add_argument("sel", nargs="*")
    lv = sub.add_parser("levels"); lv.add_argument("--task"); lv.add_argument("--plus", type=float)
    r = sub.add_parser("run")
    r.add_argument("names", nargs="*"); r.add_argument("--level", type=int, choices=[0, 1, 2])
    r.add_argument("--upto", action="store_true"); r.add_argument("--task")
    r.add_argument("--plus", type=float, metavar="PCT", nargs="?", const=-1.0,
                   help="run L0, then PCT%% of L1+L2 (stratified, least recently run first); "
                        "no PCT: the series' percentage")
    r.add_argument("--force", action="store_true", help="on a series branch: allow --all / --level 2")
    r.add_argument("--keep-going", action="store_true", help="with --plus: run the sample even if L0 is red")
    r.add_argument("--env", action="append", metavar="K=V",
                   help="extra environment for every test (e.g. LOGOS_DL_SHADOW=bc); repeatable")
    r.add_argument("--group", nargs="+"); r.add_argument("--except", dest="except_", nargs="+")
    r.add_argument("--all", action="store_true"); r.add_argument("--failed", action="store_true")
    r.add_argument("--ungrouped", action="store_true")
    r.add_argument("--same-as", type=int, metavar="RUN", help="rerun exactly the tests of run RUN")
    r.add_argument("-k"); r.add_argument("-j", "--jobs", type=int); r.add_argument("-v", "--verbose", action="store_true")
    s = sub.add_parser("show"); s.add_argument("test"); s.add_argument("--output", action="store_true")
    s.add_argument("-n", type=int, default=10)
    la = sub.add_parser("last"); la.add_argument("--failed", action="store_true")
    g = sub.add_parser("groups"); g.add_argument("group", nargs="?")
    se = sub.add_parser("series")
    se.add_argument("op", choices=["new", "show", "list", "close", "waive", "merge"])
    se.add_argument("name", nargs="?"); se.add_argument("tests", nargs="*")
    se.add_argument("--pct", type=float, default=10.0); se.add_argument("--why")
    se.add_argument("-j", "--jobs", type=int); se.add_argument("-v", "--verbose", action="store_true")
    se.add_argument("--env", action="append", metavar="K=V")
    args = ap.parse_args()
    signal.signal(signal.SIGINT, _on_signal)
    signal.signal(signal.SIGTERM, _on_signal)
    build = os.path.abspath(args.build)
    con = db_open(build)
    if args.cmd == "sync":
        sync(build, con); return 0
    return {"run": cmd_run, "task": cmd_task, "levels": cmd_levels, "show": cmd_show,
            "last": cmd_last, "groups": cmd_groups,
            "series": cmd_series}[args.cmd](con, build, args)

if __name__ == "__main__":
    sys.exit(main())
