{
    name:    "memoria",
    version: "0.1.0",
    requires_logos: "0.1",
    targets: [
        { kind: "lib", name: "memoria-ssrle", src: "src/ssrle" },
        { kind: "lib", name: "memoria-btfl",  src: "src/btfl",
          deps: ["memoria-ssrle"] },
        { kind: "lib", name: "memoria-ctr",   src: "src/ctr" },
        { kind: "lib", name: "memoria-store", src: "src/store",
          deps: ["memoria-ctr"] }
    ]
}
