{
    name:    "memoria",
    version: "0.1.0",
    requires_logos: "0.1",
    targets: [
        { kind: "lib", name: "memoria-bt",    src: "src/bt" },
        { kind: "lib", name: "memoria-ctr",   src: "src/ctr",
          deps: ["memoria-bt"] },
        { kind: "lib", name: "memoria-store", src: "src/store",
          deps: ["memoria-ctr", "memoria-bt"] }
    ]
}
