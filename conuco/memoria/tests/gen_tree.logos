// gen_tree — the b+tree assembly under bulk load, end to end (ADR 0020 Track
// B ② I2 + ADR 0021 Phase 4b demand path): one `kind ordered_map` declaration
// lowers to a CFG doc + CtrClass alias; `create_ctr::<typeof(GenBt)>` fires the
// mono demand and the metaclass FACTORY generates the family (@hs-keyed
// leaf/branch + CoW handle over the shared MemoryStore). main() mirrors the
// hand-written logos.mem.bt.tree validation (BTreeU64): ascending fill
// forcing repeated rightmost splits and root growth, scattered inserts,
// size==entry count, replace-on-hit. (The standalone `GenBtTree` surface —
// new/height/free — died with the bind asymmetry; multi-level structure is
// still forced by the 60k ascending fill, asserted through size/lookup.)
package test;

use logos.lcm.canon.container_item;   // the `container` lowering handler + the factory
use logos.lcm.canon.metaclass;        // create_ctr/open_ctr (ADR 0021 Phase 4b surface)
use logos.mem.pkd;                    // the generated leaf/branch target
use logos.mem.bt.map;                 // Ctr trait (the generated `impl Ctr` names it)
use logos.mem.bt.memstore;
use logos.mem.sync;                   // Arc — the store/snapshot plane            // MemoryStore/MemorySnapshot — the shared store
use logos.mem.string;
use logos.std.io;

// key:u64 + val:u64 → all fixed-size → Canon leaf policy `fast`; the family's
// leaf + branch + CoW handle are all factory-emitted from this one declaration.
container GenBt for u8 {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure max(key);
}

fn run_all() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();
    let mut s0: Arc<MemorySnapshot> = store_fork_arc(&mut store);
    let t = create_ctr::<typeof(GenBt)>(&s0, 1u64);
    if t.size() != 0u64 { return 2i32; }

    // ── grow: ascending insert forces repeated rightmost splits + root growth
    let n: u64 = 60000u64;
    let mut k: u64 = 0u64;
    while k < n {
        t.insert(k, k + 7u64);
        k = k + 1u64;
    }
    if t.size() != n { return 3i32; }             // SUM measure == entry count

    // ── every key present with the right value ──────────────────────────
    k = 0u64;
    while k < n {
        if t.get_or(k, 0xFFFFFFFFu64) != k + 7u64 { return 5i32; }
        k = k + 1u64;
    }
    // absent keys miss
    if t.get_or(n, 0xDEADu64) != 0xDEADu64 { return 6i32; }
    if t.get_or(n + 1000u64, 0xDEADu64) != 0xDEADu64 { return 7i32; }

    // ── replace-on-hit (Map MAX): overwrite a spread of keys, size unchanged ─
    let before: u64 = t.size();
    k = 0u64;
    while k < n {
        t.insert(k, k + 1000000u64);              // new value for the same key
        k = k + 777u64;                           // a scattered subset
    }
    if t.size() != before { return 8i32; }        // no growth on replace
    if t.get_or(0u64, 0u64) != 1000000u64 { return 9i32; }
    if t.get_or(777u64, 0u64) != 777u64 + 1000000u64 { return 10i32; }
    if t.get_or(778u64, 0u64) != 778u64 + 7u64 { return 11i32; }   // untouched neighbour

    // ── a second container with interleaved (non-ascending) key order ────
    let t2 = create_ctr::<typeof(GenBt)>(&s0, 2u64);
    let m: u64 = 20000u64;
    let mut i: u64 = 0u64;
    let mut key: u64 = 0u64;
    while i < m {
        t2.insert(key, key + 3u64);
        key = (key + 7919u64) % m;                // pseudo-scatter over [0, m)
        i = i + 1u64;
    }
    if t2.size() != m { return 12i32; }
    let mut j: u64 = 0u64;
    while j < m {
        if t2.get_or(j, 0xFFFFFFFFu64) != j + 3u64 { return 13i32; }
        j = j + 1u64;
    }

    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap (256 & 0xFF == 0) and report
// SUCCESS. The status is a fixed non-zero byte; the code carries the detail.
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL gen_tree: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
