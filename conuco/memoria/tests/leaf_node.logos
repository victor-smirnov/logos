// leaf_node — the LeafU64 Node contract (ADR 0020 Track B): fit-checked
// try_insert filling to capacity, split into balanced halves, can_merge_with +
// merge_with round-trip, replace-on-hit (Map MAX) semantics, lower_bound.
package test;

use logos.mem.bt.leaf;
use logos.lang.result;

fn main() -> i32 {
    // ── fill to capacity via fit-checked try_insert ──────────────────────
    let mut lf: LeafU64 = LeafU64::new();
    let mut i: u64 = 0u64;
    let mut inserted: u32 = 0u32;
    // Insert sorted keys 0,10,20,… until the node reports full.
    while i < 100000u64 {
        if !lf.try_insert(i, i + 1u64) { break; }
        inserted = inserted + 1u32;
        i = i + 10u64;
    }
    // The node filled up before 100000 entries and holds a healthy count
    // (16-byte entries in a 4K block → hundreds).
    if lf.count() != inserted { return 1i32; }
    if inserted < 8u32 { return 2i32; }       // ≥ 4 guaranteed by the 1/4 guard
    if inserted > 100000u32 { return 3i32; }  // it DID stop (fit-check works)

    // sorted order + lower_bound
    let mut k: u32 = 1u32;
    while k < lf.count() {
        if lf.key_at(k) <= lf.key_at(k - 1u32) { return 4i32; }
        k = k + 1u32;
    }
    // lower_bound(15) → first key >= 15 = key 20 at index 2
    if lf.lower_bound(15u64) != 2u32 { return 5i32; }
    if lf.lower_bound(0u64) != 0u32 { return 6i32; }
    if lf.lower_bound(1000000u64) != lf.count() { return 7i32; }

    // replace-on-hit: overwrite key 20's value, count unchanged
    let before: u32 = lf.count();
    if !lf.try_insert(20u64, 999u64) { return 8i32; }
    if lf.count() != before { return 9i32; }
    if lf.val_at(2u32) != 999u64 { return 10i32; }

    // ── split into balanced halves ───────────────────────────────────────
    let total: u32 = lf.count();
    let mut rt: LeafU64 = LeafU64::new();
    lf.split_into(&mut rt);
    if lf.count() + rt.count() != total { return 11i32; }
    // roughly balanced
    let lc: u32 = lf.count();
    let rc: u32 = rt.count();
    let diff: u32 = if lc > rc { lc - rc } else { rc - lc };
    if diff > 1u32 { return 12i32; }
    // left max < right min (ordering preserved across the split)
    if lf.max_key() >= rt.key_at(0u32) { return 13i32; }
    // both halves internally sorted + values follow keys (key i → val i+1,
    // except the overwritten key 20 → 999)
    let mut j: u32 = 0u32;
    while j < rt.count() {
        if j > 0u32 && rt.key_at(j) <= rt.key_at(j - 1u32) { return 14i32; }
        j = j + 1u32;
    }

    // ── merge the halves back ────────────────────────────────────────────
    if !lf.can_merge_with(&rt) { return 15i32; }
    lf.merge_with(&rt);
    if lf.count() != total { return 16i32; }
    // fully sorted again, first/last keys intact
    let mut m: u32 = 1u32;
    while m < lf.count() {
        if lf.key_at(m) <= lf.key_at(m - 1u32) { return 17i32; }
        m = m + 1u32;
    }
    if lf.key_at(0u32) != 0u64 { return 18i32; }
    if lf.max_key() != ((total as u64) - 1u64) * 10u64 { return 19i32; }

    lf.free();
    rt.free();
    return 0i32;
}
