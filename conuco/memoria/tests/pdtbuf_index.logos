// pdtbuf_index — rung `index` of the PdtBuf law suite.
//
// The suite's body lives in memoria.testkit.pdtbuf (one 6.6k-line library
// compiled once); this binary runs ONE rung, so the rungs run in parallel and
// a failure names the rung it came from. The diagnostic code is PRINTED, never
// returned: a process exit status is an 8-bit channel, so any code >= 256 would
// wrap and report SUCCESS.
package test;

use memoria.testkit.pdtbuf;
use logos.mem.string;
use logos.std.io;

fn main() -> i32 {
    let code: i32 = rung_index();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL pdtbuf_index: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
