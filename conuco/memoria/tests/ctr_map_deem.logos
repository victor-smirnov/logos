// ctr_map_deem — querying a STORE-BACKED container, by name.
//
// The obstacle this closes: a store-backed container's family is generated by
// the metaclass factory and named by a CONTENT HASH (`Hs<hex>`), so its handle
// type has no name a human can write. A `deem` item's parameter is a TYPE
// position, so the query could not be pointed at it at all — the query stopped
// at standalone containers (ctr_vec_generic_deem).
//
// Two mechanisms make it writable here:
//
//   §A the parameter is spelled as the PROJECTION `&<typeof(C) as
//      CtrFamily>::Handle` — the one form that names the family without
//      knowing its hash — and the compiler re-spells it by the resolved
//      struct name for the query pipeline;
//
//   §B the projection only collapses once the factory has emitted
//      `impl CtrFamily for CtrClass<CFG>`. The item DEFERS until then, and
//      the deferral records WHAT it waits for, so the driver drains the
//      factory inside the same fixpoint instead of after mono.
//
// §C a family's identity is the CONTENT HASH of its config, so two
//    declarations of the same kind land in the same family or in different
//    ones by what that config actually records — the column TYPES enter it,
//    the column NAMES do not (measured: `{slot: u64, hits: u64}` hashes
//    identically to `{key: u64, val: u64}`). Two families here, a query each.
package test;

use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;
use logos.mem.bt.map;                 // trait OrderedMapSource, trait Snapshot
use logos.mem.bt.memstore;
use logos.mem.sync;
use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.result;
use logos.mem.string;
use logos.std.io;

container Ledger {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure max(key);
}

// Same kind, but an i64 value column ⇒ a different config ⇒ its own family.
container Tally {
    kind ordered_map;
    entry { slot: u64, hits: i64 }
    measure max(slot);
}

// §A — the query, pointed at a family nobody can name.
pub deem big_entries(w: &<typeof(Ledger) as CtrFamily>::Handle) {
    from w e where e.key > 100 select (e.key, e.val)
}

// §C — a second family, its own query, written the same way.
pub deem hot_slots(w: &<typeof(Tally) as CtrFamily>::Handle) {
    from w e where e.val > 40 select (e.key, e.val)
}

fn run_all() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();
    let snap: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    let led = create_ctr::<typeof(Ledger)>(&snap, 1u64);
    let tal = create_ctr::<typeof(Tally)>(&snap, 2u64);

    // Past a leaf split, so the query reads a real tree and not one node.
    let mut k: u64 = 0u64;
    while k < 200u64 { led.insert(k, k * 3u64); k = k + 1u64; }
    let mut s: u64 = 0u64;
    while s < 50u64 { tal.insert(s, s as i64); s = s + 1u64; }

    // keys 101..199 → 99 rows, each val == key * 3.
    let rows: Vec<(u64, u64)> = match big_entries(&led)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    if rows.len() != 99i64 { return 2i32; }
    let mut i: i64 = 0i64;
    while i < rows.len() {
        let r: (u64, u64) = rows.get(i);
        if r.0 <= 100u64      { return 3i32; }
        if r.1 != r.0 * 3u64  { return 4i32; }
        i = i + 1i64;
    }

    // slots 41..49 → 9 rows (hits == slot).
    let hot: Vec<(u64, i64)> = match hot_slots(&tal)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 5i32; } };
    if hot.len() != 9i64 { return 6i32; }
    let mut j: i64 = 0i64;
    while j < hot.len() {
        let h: (u64, i64) = hot.get(j);
        if h.0 != (h.1 as u64) { return 7i32; }
        if h.0 <= 40u64 { return 8i32; }
        j = j + 1i64;
    }
    return 0i32;
}

fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 { return 0i32; }
    let mut msg: String = String::new();
    msg.push_str("FAIL ctr_map_deem: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
