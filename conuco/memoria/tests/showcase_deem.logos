// showcase_deem — the Memoria×Deem seam in one page, and it RUNS.
//
// Three claims, each shown rather than described:
//
//   §1  a container DECLARATION is the schema — Canon derives the relation
//       from it, so nothing here writes a scan, an index or a bridge;
//   §2  ONE query serves every element type — it is written against the
//       RELATION (`pos`/`elem`), so the type parameter never appears in it;
//   §3  a STORE describes itself — ids from the directory, kinds from each
//       container's own root block, with no compile-time type in sight;
//   §4  the query reaches a STORE-BACKED container too, whose handle type is
//       named by a content hash that nobody can type out;
//   §5  …and then stops naming types at all: a query binds the container
//       CLASS, and Deem compiles it against whatever family that class becomes.
package test;

use memoria.ctr.vec;                  // container Vector<V> — the declaration
use memoria.ctr.multimap;             // container Multimap<K, V>
use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;
use logos.std.wql.wql;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.sync;
use logos.lang.writ.static_view;
use logos.lang.writ.anyval;
use logos.mem.collections.vec;
use logos.lang.result;
use logos.lang.str;
use logos.mem.string;
use logos.lang.option;
use logos.std.io;

// ── §1 the declaration IS the schema ────────────────────────────────────────
//
// This one lives in the memoria-ctr lib, quoted for the reader:
//
//     pub container Vector<V> for u8 {
//         kind vector;
//         entry { elem: V }
//     }
//
// It names no storage type. The factory generates the family per element type
// — b+tree-backed, store-resident — together with its relation, so ONE
// declaration yields a container AND its queryable projection.

// A store-backed map, for §3. Same shape of declaration, different kind.
container Ledger for u8 {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure max(key);
}

// ── §2 ONE query, any element type ──────────────────────────────────────────
//
// Written against the RELATION. No `u64`, no `i64`, no container type.
// Written against the CLASS and the hub relation — one item, every element
// type, and no family or storage type named anywhere.
pub deem above<V>(v: Vector<V>) {
    from v r where r.val > 100 select (r.pos, r.val)
}

// ── §4 the same query, over a STORE-BACKED container ────────────────────────
//
// `Ledger`'s family is GENERATED: its handle type is named by the content hash
// of its schema (`Hs<hex>`), so there is no name for it in this file — and a
// `deem` parameter is a type position. The projection `<typeof(Ledger) as
// CtrFamily>::Handle` is the one spelling that names the family without
// knowing the hash; the compiler resolves it to the real struct name for the
// query pipeline, and the item waits (recording WHAT it waits for) until the
// factory has produced the family.
pub deem big_vals(w: &<typeof(Ledger) as CtrFamily>::Handle) {
    from w e where e.val > 1400 select (e.key, e.val)
}

// ── §5 the same query, naming nothing generated ─────────────────────────────
//
// `Ledger` is an instance of the container metaclass — a CLASS, not a type.
// Binding it is the spelling that survives the fact that a family's handle is
// generated: there is no `typeof`, no `::Handle`, no hash. The item is a PLAN,
// and it is compiled where the class meets its type arguments — at the call
// below, whose argument type says which family to compile against.
pub deem big_vals_by_class(led: Ledger) {
    from led e where e.val > 1400 select (e.key, e.val)
}

fn ms_of(s: &Arc<dyn Snapshot>) -> &MemorySnapshot {
    return unsafe { &*(dyn_data(&**s) as *const MemorySnapshot) };
}

// §3's whole point: ask a container what it is, holding only the store and an
// id. No type is named — the answer comes out of the container's root block.
fn kind_of(ms: &MemorySnapshot, ctr_id: u64) -> String {
    let mut out: String = String::new();
    if !ms.has_ctr_meta(ctr_id) { return out; }
    let vw: WView2 = ms.ctr_meta(ctr_id);
    let k: WAny = vw.map_get(vw.root(), "kind");
    if k.is_null() { return out; }
    let sv: SView2 = vw.get_str_view(k);
    out.push_str(unsafe { str_from_raw(sv.ptr, sv.len as i64) });
    return out;
}

fn report(label: str, rows: &Vec<(i64, i64)>) {
    let mut line: String = String::new();
    line.push_str("  ");
    line.push_str(label);
    line.push_str(" -> ");
    line.push_i64(rows.len());
    line.push_str(" row(s):");
    let mut i: i64 = 0i64;
    while i < rows.len() {
        let r: (i64, i64) = rows.get(i);
        line.push_str(" (");
        line.push_i64(r.0);
        line.push_str(",");
        line.push_i64(r.1);
        line.push_str(")");
        i = i + 1i64;
    }
    println_string(&line);
}

fn run_all() -> i32 {
    // ── §2 in action: two containers, two element types, ONE query ──────────
    let mut store: Arc<MemoryStore> = store_new();
    let snap: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    let a = create_ctr::<typeof(Vector::<u64>)>(&snap, 10u64);
    let b = create_ctr::<typeof(Vector::<i64>)>(&snap, 11u64);
    let mut i: i64 = 0i64;
    while i < 16i64 {
        a.append(((i + 1i64) * 10i64) as u64);   // 10, 20, … 160
        b.append((i + 1i64) * 10i64);
        i = i + 1i64;
    }

    { let mut h: String = String::new(); h.push_str("one query, two element types:"); println_string(&h); }
    let r64: Vec<(i64, i64)> = match above(&a)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    let ri64: Vec<(i64, i64)> = match above(&b)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 2i32; } };
    report("Vector<u64>", &r64);
    report("Vector<i64>", &ri64);
    if r64.len() != 6i64 || ri64.len() != 6i64 { return 3i32; }

    // ── §3 a store that describes itself ────────────────────────────────────
    let ms: &MemorySnapshot = ms_of(&snap);
    let led = create_ctr::<typeof(Ledger)>(&snap, 1u64);
    let mm  = create_ctr::<typeof(Multimap::<u64, u64>)>(&snap, 2u64);
    {
        let mut k: u64 = 0u64;
        while k < 500u64 { led.insert(k, k * 3u64); k = k + 1u64; }   // past a split
    }
    let _ = mm;

    { let mut h: String = String::new(); h.push_str("what is in this store (nothing here names a type):"); println_string(&h); }
    let ids: Vec<u64> = ms.container_ids();
    let mut j: i64 = 0i64;
    while j < ids.len() {
        let id: u64 = ids.get(j);
        let kind: String = kind_of(ms, id);
        if kind.len() == 0i64 { return 4i32; }
        let mut line: String = String::new();
        line.push_str("  container ");
        line.push_i64(id as i64);
        line.push_str(" : ");
        line.push_str(kind.as_str());
        println_string(&line);
        j = j + 1i64;
    }
    if ids.len() != 4i64 { return 5i32; }
    if !str_eq(kind_of(ms, 1u64).as_str(), "ordered_map") { return 6i32; }
    if !str_eq(kind_of(ms, 2u64).as_str(), "multimap") { return 7i32; }

    // ── §4 the query, over that same store-backed map ───────────────────────
    { let mut h: String = String::new(); h.push_str("the query, over a container in the store:"); println_string(&h); }
    let big: Vec<(i64, i64)> = match big_vals(&led)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 8i32; } };
    report("Ledger (val > 1400)", &big);
    // keys 0..499 with val = key*3 ⇒ val > 1400 ⟺ key ≥ 467: 33 rows.
    if big.len() != 33i64 { return 9i32; }
    let b0: (i64, i64) = big.get(0i64);
    if b0.0 != 467i64 || b0.1 != 467i64 * 3i64 { return 10i32; }

    // ── §5 the same answer, from a query that names nothing generated ───────
    { let mut h: String = String::new(); h.push_str("the same query, written against the CLASS:"); println_string(&h); }
    let byc: Vec<(i64, i64)> = match big_vals_by_class(&led)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 11i32; } };
    report("Ledger (by class)", &byc);
    if byc.len() != big.len() { return 12i32; }
    let mut z: i64 = 0i64;
    while z < byc.len() {
        if byc.get(z) != big.get(z) { return 13i32; }
        z = z + 1i64;
    }
    return 0i32;
}

fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 { return 0i32; }
    let mut msg: String = String::new();
    msg.push_str("FAIL showcase_deem: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
