// showcase_deem — the Memoria×Deem seam in one page, and it RUNS.
//
// Three claims, each shown rather than described:
//
//   §1  a container DECLARATION is the schema — Canon derives the relation
//       from it, so nothing here writes a scan, an index or a bridge;
//   §2  ONE query serves every element type — it is written against the
//       RELATION (`pos`/`elem`), so the type parameter never appears in it;
//   §3  a STORE describes itself — ids from the directory, kinds from each
//       container's own root block, with no compile-time type in sight.
//
// Honest boundary, stated because a showcase should not blur it: §1–§2 query a
// standalone container, §3 inspects a store-backed one. The relation for
// store-backed families is emitted too (trait OrderedMapSource in
// logos.mem.bt.map), but querying it needs a name for a hash-keyed handle —
// see feat_deem_generic_and_fn_level.
package test;

use memoria.ctr.vec;                  // container Vector<T> — the declaration
use memoria.ctr.multimap;             // container Multimap<K, V>
use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;
use logos.std.wql.wql;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.sync;
use logos.lang.writ.static_view;
use logos.lang.writ.anyval;
use logos.mem.collections.vec;
use logos.lang.result;
use logos.lang.str;
use logos.mem.string;
use logos.lang.option;
use logos.std.io;

// ── §1 the declaration IS the schema ────────────────────────────────────────
//
// This one lives in the memoria-ctr lib, quoted for the reader:
//
//     pub container Vector<T: Copy + Fst + StableLayout> for VecCtr<T> {
//         kind vector;
//         entry { elem: T }
//         measure count;
//     }
//
// From it, Canon derives `rel row(pos, elem)` and the factory emits the
// materializer + `impl<T: … + CanonCol> __CtrSrc_Vector for VecCtr<T>` — ONE
// relation for every element type.

// A store-backed map, for §3. Same shape of declaration, different kind.
container Ledger for u8 {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure max(key);
}

// ── §2 ONE query, any element type ──────────────────────────────────────────
//
// Written against the RELATION. No `u64`, no `i64`, no container type.
pub mapping Above<S: __CtrSrc_Vector>(v: &S) {
    pub rel above(p: i64, e: i64) { from v r where r.elem > 100 select (r.pos, r.elem); }
}

// Pointing it at containers — these lines choose the element type; the QUERY
// above never mentions one.
pub deem above_u64(w: Above<VecCtr<u64>>) { from above a select (a.p, a.e) }
pub deem above_i64(w: Above<VecCtr<i64>>) { from above a select (a.p, a.e) }

// ── §4, NOT YET: the same query over a STORE-BACKED container ───────────────
// The relation exists for store-backed families too (`trait OrderedMapSource`
// in logos.mem.bt.map, implemented by every generated map family). What is
// missing is a NAME: the family handle is hash-keyed, and a `deem` item's
// parameter is checked BEFORE the metaprog round that defines the container —
// so neither `typeof(Ledger)::Handle` nor an alias for it resolves in that
// position (measured, 2026-07-25). That is the item-level deferral in
// design_pending_fixpoint_not_pipeline; a fn-level `deem` sidesteps it by
// INFERRING the type instead of spelling it.

fn ms_of(s: &Arc<dyn Snapshot>) -> &MemorySnapshot {
    return unsafe { &*(dyn_data(&**s) as *const MemorySnapshot) };
}

// §3's whole point: ask a container what it is, holding only the store and an
// id. No type is named — the answer comes out of the container's root block.
fn kind_of(ms: &MemorySnapshot, ctr_id: u64) -> String {
    let mut out: String = String::new();
    if !ms.has_ctr_meta(ctr_id) { return out; }
    let vw: WView2 = ms.ctr_meta(ctr_id);
    let k: WAny = vw.map_get(vw.root(), "kind");
    if k.is_null() { return out; }
    let sv: SView2 = vw.get_str_view(k);
    out.push_str(unsafe { str_from_raw(sv.ptr, sv.len as i64) });
    return out;
}

fn report(label: str, rows: &Vec<(i64, i64)>) {
    let mut line: String = String::new();
    line.push_str("  ");
    line.push_str(label);
    line.push_str(" -> ");
    line.push_i64(rows.len());
    line.push_str(" row(s):");
    let mut i: i64 = 0i64;
    while i < rows.len() {
        let r: (i64, i64) = rows.get(i);
        line.push_str(" (");
        line.push_i64(r.0);
        line.push_str(",");
        line.push_i64(r.1);
        line.push_str(")");
        i = i + 1i64;
    }
    println_string(&line);
}

fn run_all() -> i32 {
    // ── §2 in action: two containers, two element types, ONE query ──────────
    let mut a: VecCtr<u64> = VecCtr::new(240u32);
    let mut b: VecCtr<i64> = VecCtr::new(240u32);
    let mut i: i64 = 0i64;
    while i < 16i64 {
        a.push(((i + 1i64) * 10i64) as u64);   // 10, 20, … 160
        b.push((i + 1i64) * 10i64);
        i = i + 1i64;
    }

    { let mut h: String = String::new(); h.push_str("one query, two element types:"); println_string(&h); }
    let r64: Vec<(i64, i64)> = match above_u64(&a)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    let ri64: Vec<(i64, i64)> = match above_i64(&b)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 2i32; } };
    report("VecCtr<u64>", &r64);
    report("VecCtr<i64>", &ri64);
    if r64.len() != 6i64 || ri64.len() != 6i64 { return 3i32; }

    // ── §3 a store that describes itself ────────────────────────────────────
    let mut store: Arc<MemoryStore> = store_new();
    let snap: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    let ms: &MemorySnapshot = ms_of(&snap);
    let led = create_ctr::<typeof(Ledger)>(&snap, 1u64);
    let mm  = create_ctr::<typeof(Multimap::<u64, u64>)>(&snap, 2u64);
    {
        let mut k: u64 = 0u64;
        while k < 500u64 { led.insert(k, k * 3u64); k = k + 1u64; }   // past a split
    }
    let _ = mm;

    { let mut h: String = String::new(); h.push_str("what is in this store (nothing here names a type):"); println_string(&h); }
    let ids: Vec<u64> = ms.container_ids();
    let mut j: i64 = 0i64;
    while j < ids.len() {
        let id: u64 = ids.get(j);
        let kind: String = kind_of(ms, id);
        if kind.len() == 0i64 { return 4i32; }
        let mut line: String = String::new();
        line.push_str("  container ");
        line.push_i64(id as i64);
        line.push_str(" : ");
        line.push_str(kind.as_str());
        println_string(&line);
        j = j + 1i64;
    }
    if ids.len() != 2i64 { return 5i32; }
    if !str_eq(kind_of(ms, 1u64).as_str(), "ordered_map") { return 6i32; }
    if !str_eq(kind_of(ms, 2u64).as_str(), "multimap") { return 7i32; }
    return 0i32;
}

fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 { return 0i32; }
    let mut msg: String = String::new();
    msg.push_str("FAIL showcase_deem: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
