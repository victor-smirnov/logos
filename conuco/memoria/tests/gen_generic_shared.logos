// Generic container (ADR 0020 wave-0, S2): the SAME instantiation `Map<u64,str>`
// at two use-sites — a fn SIGNATURE (`fn fill(m: &mut Map<u64,str>)`) and two
// locals — shares ONE generated stack (deduped by mangled name).
package test;

use logos.lcm.canon.container_item;
use logos.mem.pkd;
use logos.mem.bt.map;
use logos.mem.bt.memstore;  // MemorySnapshot — the generated handle struct names it (collect-time import gotcha)
use logos.lang.str;

container Map<K, V> for u8 { kind ordered_map; entry { key: K, val: V } measure max(key); }

fn beq(b: &[u8], want: str) -> bool {
    if b.len() != want.len() { return false; }
    let mut i: i64 = 0i64;
    while i < b.len() { if b[i] != str_byte_at(want, i) { return false; } i = i + 1i64; }
    return true;
}

fn fill(m: &mut Map<u64, str>) {          // Map<u64,str> in a fn SIGNATURE
    m.insert(1u64, "alpha");
    m.insert(2u64, "bravo");
}

fn main() -> i32 {
    let mut a: Map<u64, str> = Map::new();   // use-site 1
    fill(&mut a);
    if a.size() != 2u64 { return 1i32; }
    if !beq(a.get_or(1u64), "alpha") { return 2i32; }
    a.free();

    let mut b: Map<u64, str> = Map::new();   // use-site 2 (SAME instantiation → shared stack)
    b.insert(5u64, "echo");
    if !beq(b.get_or(5u64), "echo") { return 3i32; }
    b.free();
    return 0i32;
}
