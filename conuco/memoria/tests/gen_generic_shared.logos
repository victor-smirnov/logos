// Generic container (ADR 0021 Phase 4b demand path): the SAME config demanded
// through TWO spellings shares ONE family. `Map<u64,u64>` (generic
// instantiation) and the concrete twin `Fixed` (identical columns) produce
// byte-identical CFG docs → the same @hs → the factory runs ONCE and both
// resolve to the same generated family (`family_id()` equality — the twin-
// dedup/ODR gate; no name enters the identity).
package test;

use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;        // create_ctr + CtrFamily (family_id probe)
use logos.mem.pkd;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.sync;                   // Arc — the store/snapshot plane
use logos.mem.string;
use logos.std.io;

container Map<K, V> for u8 {
    kind ordered_map;
    entry { key: K, val: V }
    measure max(key);
}
container Fixed  for u8 {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure max(key);
}

fn fid<C: CtrFamily<MemorySnapshot>>() -> u64 { return C::family_id(); }

fn run_all() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();
    let mut s0: MemorySnapshot = store_fork(&mut store);

    let a = create_ctr::<typeof(Map::<u64, u64>)>(&mut s0, 1u64);   // use-site 1 (generic spelling)
    a.insert(1u64, 100u64);
    a.insert(2u64, 200u64);
    if a.size() != 2u64 { return 1i32; }
    if a.get_or(1u64, 0u64) != 100u64 { return 2i32; }

    let b = create_ctr::<typeof(Fixed)>(&mut s0, 2u64);           // use-site 2 (concrete twin)
    b.insert(5u64, 500u64);
    if b.get_or(5u64, 0u64) != 500u64 { return 3i32; }

    // same config → ONE family, both spellings resolve to the same identity
    if fid::<typeof(Map::<u64, u64>)>() != fid::<typeof(Fixed)>() { return 4i32; }

    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap (256 & 0xFF == 0) and report
// SUCCESS. The status is a fixed non-zero byte; the code carries the detail.
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL gen_generic_shared: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
