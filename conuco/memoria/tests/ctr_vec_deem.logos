// ctr_vec_deem — e2e over the library's `container Vector` declaration, which
// now names no storage type at all: the family (b+tree-backed, store-resident)
// and its `rel row(pos, elem)` projection are generated per element type, and a
// query binds the CLASS. The chain under test is unchanged — facts → Canon
// verdicts → generated projection → static deem query returning correct rows —
// only its two ends are: no hand-written backing, no named family.
package test;

use memoria.ctr.vec;
use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.sync;
use logos.std.wql.wql;
use logos.mem.collections.vec;
use logos.lang.result;        // module-mode: Result is NOT in the prelude here
use logos.mem.string;
use logos.std.io;

// The `container Vector` declaration lives in the memoria-ctr LIB
// (src/ctr/vec.logos); this consumer only `use`s it and queries. The query
// binds the CLASS — the family it compiles against is chosen by the argument.
// NB the query speaks the HUB's vocabulary (`rel row(pos, val)` in
// logos.mem.bt.map), not the declaration's column names — one relation serves
// every family, so the names cannot come from any one declaration.
pub deem big<V>(v: Vector<V>) {
    from v e where e.val > 100 select (e.pos, e.val)
}

fn run_all() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();
    let snap: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    let mut c = create_ctr::<typeof(Vector::<u64>)>(&snap, 1u64);
    let mut i: i64 = 0i64;
    while i < 16i64 {
        // values 10,20,…,160 — rows above 100: (10,110)…(15,160)
        c.append(((i + 1i64) * 10i64) as u64);
        i = i + 1i64;
    }
    if c.size() != 16u64 { return 1i32; }
    if c.get(0u64) != 10u64 { return 2i32; }
    if c.get(15u64) != 160u64 { return 3i32; }

    let rows: Vec<(i64, u64)> = match big(&c) { 
        Result::Ok(v) => { v } 
        Result::Err(_e) => { return 4i32; } 
    };
    
    if rows.len() != 6i64 { return 5i32; }
    // Expected set: pos p in 10..=15 with elem (p+1)*10. Set semantics —
    // assert membership + count, not order.
    let mut mask: i64 = 0i64;
    i = 0i64;
    while i < rows.len() {
        let r: (i64, u64) = rows.get(i);
        if r.0 < 10i64 || r.0 > 15i64 { return 6i32; }
        if r.1 != ((r.0 + 1i64) * 10i64) as u64 { return 7i32; }
        mask = mask | (1i64 << (r.0 - 10i64));
        i = i + 1i64;
    }
    if mask != 63i64 { return 8i32; }
    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap (256 & 0xFF == 0) and report
// SUCCESS. The status is a fixed non-zero byte; the code carries the detail.
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL ctr_vec_deem: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
