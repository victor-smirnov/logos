// map_consumer — CONSUMER of the library-declared generic `Map<K, V>`
// (memoria.ctr.map, the memoria-ctr archive). Pins the cross-module generic
// container seam: the consumer names two concrete instantiations; their
// whole b+tree stacks (Leaf/Branch/Tree + handle) must be generated HERE,
// in this unit — the library only shipped the declaration (stop-at-verdicts)
// as a CONTAINER_DEF_DONE marker.
package test;

use memoria.ctr.map;                  // the generic declaration (binary module)
use logos.lcm.canon.container_item;   // container lowering handler
use logos.mem.pkd;                    // generated node substrate
use logos.mem.bt.map;                 // Ctr trait for the generated impl
use logos.mem.bt.memstore;            // MemorySnapshot — the generated handle names it
use logos.lang.str;

fn beq(b: &[u8], want: str) -> bool {
    if b.len() != want.len() { return false; }
    let mut i: i64 = 0i64;
    while i < b.len() { if b[i] != str_byte_at(want, i) { return false; } i = i + 1i64; }
    return true;
}

fn main() -> i32 {
    // Instantiation 1: fast leaf (u64/u64), enough inserts to force splits.
    let mut m: Map<u64, u64> = Map::new();
    let n: u64 = 4000u64;
    let mut i: u64 = 0u64;
    while i < n { m.insert(i, i * 3u64); i = i + 1u64; }
    if m.size() != n { return 1i32; }
    if m.get_or(1234u64, 0u64) != 3702u64 { return 2i32; }
    m.insert(1234u64, 7u64);              // replace-on-hit
    if m.get_or(1234u64, 0u64) != 7u64 { return 3i32; }
    if m.size() != n { return 4i32; }
    m.free();

    // Instantiation 2: volume leaf (u64/str — VLE column).
    let mut s: Map<u64, str> = Map::new();
    s.insert(1u64, "alpha");
    s.insert(2u64, "bravo");
    if s.size() != 2u64 { return 5i32; }
    if !beq(s.get_or(1u64), "alpha") { return 6i32; }
    s.free();
    return 0i32;
}
