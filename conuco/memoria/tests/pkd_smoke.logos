// pkd_smoke — PackedAllocator v1 (slot-order contiguous): format, resize with
// sibling shifting (data integrity across shifts), shrink, exhaustion,
// nesting, and the relocatability contract (a byte-copied block stays fully
// readable at a new address).
package test;

use memoria.pkd;
use memoria.bt;
use memoria.ctr;
use memoria.store;
use logos.lang.mem;

fn main() -> i32 {
    // linkage smoke for the sibling skeleton modules
    if bt_stage() != 0i64 { return 90i32; }
    if ctr_stage() != 0i64 { return 91i32; }
    if store_stage() != 0i64 { return 92i32; }

    unsafe {
        let base: *mut u8 = alloc(4096i64);
        if !pkd_init(base, 4096u32, 4u32) { return 1i32; }
        if pkd_block_size(base as *const u8) != 4096u32 { return 2i32; }
        if pkd_slot_count(base as *const u8) != 4u32 { return 3i32; }
        // tables: 8 + 5*4 = 28 → data starts at 32; all slots empty there
        if pkd_offset(base as *const u8, 0u32) != 32u32 { return 4i32; }
        if pkd_offset(base as *const u8, 4u32) != 32u32 { return 5i32; }
        if pkd_free(base as *const u8) != 4096u32 - 32u32 { return 6i32; }

        // grow slot 1 to 10 (aligns to 16); slots 2..4 shift accordingly
        if !pkd_resize(base, 1u32, 10u32) { return 7i32; }
        if pkd_len(base as *const u8, 1u32) != 16u32 { return 8i32; }
        if pkd_offset(base as *const u8, 1u32) != 32u32 { return 9i32; }
        if pkd_offset(base as *const u8, 2u32) != 48u32 { return 10i32; }
        if pkd_offset(base as *const u8, 4u32) != 48u32 { return 11i32; }

        // pattern slot 1, then grow slot 0 — slot 1's bytes must SHIFT intact
        let p1: *mut u8 = pkd_at(base, 1u32);
        let mut i: i64 = 0i64;
        while i < 16i64 { *(((p1 as i64) + i) as *mut u8) = (0x40i64 + i) as u8; i = i + 1i64; }
        if !pkd_resize(base, 0u32, 24u32) { return 12i32; }
        if pkd_offset(base as *const u8, 1u32) != 56u32 { return 13i32; }
        let p1b: *mut u8 = pkd_at(base, 1u32);
        i = 0i64;
        while i < 16i64 {
            if *(((p1b as i64) + i) as *const u8) != (0x40i64 + i) as u8 { return 14i32; }
            i = i + 1i64;
        }

        // shrink slot 0 back — slot 1 shifts down, data still intact
        if !pkd_resize(base, 0u32, 8u32) { return 15i32; }
        if pkd_offset(base as *const u8, 1u32) != 40u32 { return 16i32; }
        let p1c: *mut u8 = pkd_at(base, 1u32);
        if *(p1c as *const u8) != 0x40u8 { return 17i32; }
        if *(((p1c as i64) + 15i64) as *const u8) != 0x4Fu8 { return 18i32; }

        // exhaustion: growing beyond the tail fails, state unchanged
        let free0: u32 = pkd_free(base as *const u8);
        if pkd_resize(base, 2u32, free0 + 8u32) { return 19i32; }
        if pkd_free(base as *const u8) != free0 { return 20i32; }

        // nesting: slot 3 becomes a 512-byte inner allocator with 2 slots
        if !pkd_resize(base, 3u32, 512u32) { return 21i32; }
        if !pkd_init_nested(base, 3u32, 2u32) { return 22i32; }
        let inner: *mut u8 = pkd_at(base, 3u32);
        if pkd_block_size(inner as *const u8) != 512u32 { return 23i32; }
        if !pkd_resize(inner, 0u32, 100u32) { return 24i32; }
        let ip: *mut u8 = pkd_at(inner, 0u32);
        *ip = 0xEEu8;
        // grow the nested allocator through the parent
        if !pkd_grow_nested(base, 3u32, 1024u32) { return 25i32; }
        let inner2: *mut u8 = pkd_at(base, 3u32);
        if pkd_block_size(inner2 as *const u8) != 1024u32 { return 26i32; }
        if *(pkd_at(inner2, 0u32) as *const u8) != 0xEEu8 { return 27i32; }

        // relocatability: byte-copy the whole block, read via the copy only
        let copy: *mut u8 = alloc(4096i64);
        i = 0i64;
        while i < 4096i64 {
            *(((copy as i64) + i) as *mut u8) = *(((base as i64) + i) as *const u8);
            i = i + 1i64;
        }
        if pkd_offset(copy as *const u8, 1u32) != 40u32 { return 30i32; }
        let c1: *mut u8 = pkd_at(copy, 1u32);
        if *(c1 as *const u8) != 0x40u8 { return 31i32; }
        let cinner: *mut u8 = pkd_at(copy, 3u32);
        if *(pkd_at(cinner, 0u32) as *const u8) != 0xEEu8 { return 32i32; }
        dealloc(copy);
        dealloc(base);
    }
    return 0i32;
}
