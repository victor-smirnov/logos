// btfl_multimap — BTFL increment 8a gate: the hardcoded 2-stream
// Multimap<u64, u64> against a MATERIALIZED REFERENCE MODEL (sorted keys +
// flat value pool + per-key offsets) plus the navigation laws, driven by
// randomized (LCG) insert/find scenarios across leaf- and branch-split
// boundaries.
//
// Model identities used as laws (alphabet 2; n keys, moff[i] = values before
// key i, T0 = n, T1 = moff[n]):
//   sym position of key i:            P(i) = i + moff[i]
//   sym position of value v (owner j) : (j + 1) + v   with moff[j] ≤ v < moff[j+1]
//   total symbols                     = T0 + T1
// Checked after EVERY mutation (configs A/B) or every stride (config C):
//   * btfl_check (branch sum/measure columns ≡ child reality, leaf
//     column↔structure agreement, global key order, leaf-start invariant)
//   * per-symbol totals ≡ model
//   * EVERY key: find → exact value list; seek → (found, rank = index);
//     select(0, i) → P(i); the seek↔select law (same leaf, and the leaf's
//     select_fw_eq(kidx, 0) = the select's local index)
//   * sampled value ranks: select(1, v) position law + access inverses
//   * negatives: odd keys miss (keys are even by construction);
//     select(sym, total) = not-found at pos = total symbols
//
// Sections (error-code decades):
//   10..19  empty tree
//   20..39  config A: small nodes (512/320) — many leaf+branch splits,
//           full model equivalence after every mutation; final level ≥ 2
//   40..59  config B: default nodes (4096) with occasional LONG value runs
//           (up to 40) — full equivalence after every mutation
//   60..79  config C: volume run (N = 5000, small nodes) — equivalence
//           every 250 mutations + at the end; final level ≥ 3
package test;

use logos.mem.bt.btfl;
use logos.mem.bt.node;   // CowProfile — the node profile
use logos.mem.pkd;
use logos.mem.bt.memstore;
use logos.lang.arith;
use logos.lang.result;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.std.io;

// deterministic LCG (Knuth MMIX) — wrapping BY DESIGN
struct Lcg {
    s: u64,
}

impl Lcg {
    fn next(self: &mut Lcg) -> u64 {
        self.s = wrapping_add::<u64>(
            wrapping_mul::<u64>(self.s, 6364136223846793005u64),
            1442695040888963407u64);
        return self.s >> 33u64;
    }
}

// ── the reference model ─────────────────────────────────────────────────────

struct Model {
    mk: Vec<u64>,     // sorted keys
    mv: Vec<u64>,     // flat values, key order
    moff: Vec<u64>,   // moff[i] = values before key i; len = keys + 1
}

fn model_new() -> Model {
    let mut off: Vec<u64> = vec_new::<u64>();
    off.push(0u64);
    return Model {
        mk: vec_new::<u64>(),
        mv: vec_new::<u64>(),
        moff: off,
    };
}

fn model_find(md: &Model, k: u64) -> i64 {
    let n: i64 = md.mk.len();
    let mut i: i64 = 0i64;
    while i < n {
        if md.mk.get(i) == k {
            return i;
        }
        i = i + 1i64;
    }
    return -1i64;
}

fn model_insert(md: &mut Model, k: u64, vals: &Vec<u64>) {
    let n: i64 = md.mk.len();
    let m: i64 = vals.len();
    let mut pos: i64 = 0i64;
    while pos < n && md.mk.get(pos) < k {
        pos = pos + 1i64;
    }
    let cut: u64 = md.moff.get(pos);
    let mut nk: Vec<u64> = vec_new::<u64>();
    let mut i: i64 = 0i64;
    while i < pos {
        nk.push(md.mk.get(i));
        i = i + 1i64;
    }
    nk.push(k);
    while i < n {
        nk.push(md.mk.get(i));
        i = i + 1i64;
    }
    let mut nv: Vec<u64> = vec_new::<u64>();
    let mut j: i64 = 0i64;
    while j < cut as i64 {
        nv.push(md.mv.get(j));
        j = j + 1i64;
    }
    let mut q: i64 = 0i64;
    while q < m {
        nv.push(vals.get(q));
        q = q + 1i64;
    }
    while j < md.mv.len() {
        nv.push(md.mv.get(j));
        j = j + 1i64;
    }
    // new offsets: [moff[0..=pos], moff[pos]+m, moff[pos+1]+m, .., moff[n]+m]
    let mut no: Vec<u64> = vec_new::<u64>();
    let mut w: i64 = 0i64;
    while w <= pos {
        no.push(md.moff.get(w));
        w = w + 1i64;
    }
    no.push(md.moff.get(pos) + (m as u64));
    while w <= n {
        no.push(md.moff.get(w) + (m as u64));
        w = w + 1i64;
    }
    md.mk = nk;
    md.mv = nv;
    md.moff = no;
}

// ── the equivalence + laws check ────────────────────────────────────────────

fn check_full(t: &Btfl<2, CowProfile>, md: &Model) -> i32 {
    let n: i64 = md.mk.len();
    let t0: u64 = btfl_count::<2, CowProfile>(t, 0u64);
    let t1: u64 = btfl_count::<2, CowProfile>(t, 1u64);
    if t0 != n as u64 {
        return 1i32;
    }
    if t1 != md.moff.get(n) {
        return 2i32;
    }
    if !btfl_check::<2, CowProfile>(t) {
        return 3i32;
    }
    let mut i: i64 = 0i64;
    while i < n {
        let k: u64 = md.mk.get(i);
        // find → exact value list
        let mut got: Vec<u64> = vec_new::<u64>();
        if !btfl_key_stream::<2, CowProfile>(t, k, 1u32, &mut got) {
            return 4i32;
        }
        let lo: u64 = md.moff.get(i);
        let hi: u64 = md.moff.get(i + 1i64);
        if got.len() as u64 != hi - lo {
            return 5i32;
        }
        let mut j: u64 = 0u64;
        while j < hi - lo {
            if got.get(j as i64) != md.mv.get((lo + j) as i64) {
                return 6i32;
            }
            j = j + 1u64;
        }
        // seek → (found, global key rank)
        let sk: BtflSeek = btfl_seek::<2, CowProfile>(t, k);
        if !sk.found {
            return 7i32;
        }
        if sk.rank != i as u64 {
            return 8i32;
        }
        // select(0, i) → the model symbol position P(i)
        let sel: BtflLoc = btfl_select::<2, CowProfile>(t, 0u64, i as u64);
        if !sel.found {
            return 9i32;
        }
        if sel.pos != (i as u64) + lo {
            return 10i32;
        }
        // the seek ↔ select law: same leaf, matching local position
        if sk.leaf != sel.leaf {
            return 11i32;
        }
        if btfl_leaf_key_at::<CowProfile>(sk.leaf, sk.kidx) != k {
            return 12i32;
        }
        if btfl_leaf_key_sympos::<2, CowProfile>(sk.leaf, sk.kidx) != sel.idx {
            return 13i32;
        }
        i = i + 1i64;
    }
    // sampled value-stream laws
    if t1 > 0u64 {
        let mut s: i64 = 0i64;
        while s < 3i64 {
            let mut v: u64 = 0u64;
            if s == 1i64 {
                v = t1 / 2u64;
            }
            if s == 2i64 {
                v = t1 - 1u64;
            }
            // owner key j: moff[j] ≤ v < moff[j+1]
            let mut j2: i64 = 0i64;
            while md.moff.get(j2 + 1i64) <= v {
                j2 = j2 + 1i64;
            }
            let sel1: BtflLoc = btfl_select::<2, CowProfile>(t, 1u64, v);
            if !sel1.found {
                return 14i32;
            }
            if sel1.pos != (j2 as u64) + 1u64 + v {
                return 15i32;
            }
            if btfl_access::<2, CowProfile>(t, sel1.pos) != 1u64 {
                return 16i32;
            }
            s = s + 1i64;
        }
        // key symbol access inverse at a sampled key
        let mid: i64 = n / 2i64;
        if btfl_access::<2, CowProfile>(t, (mid as u64) + md.moff.get(mid)) != 0u64 {
            return 17i32;
        }
    }
    // negatives: not-found selects land at pos = total symbols
    let selx: BtflLoc = btfl_select::<2, CowProfile>(t, 0u64, t0);
    if selx.found {
        return 18i32;
    }
    if selx.pos != t0 + t1 {
        return 19i32;
    }
    let sely: BtflLoc = btfl_select::<2, CowProfile>(t, 1u64, t1);
    if sely.found {
        return 20i32;
    }
    return 0i32;
}

// ── the scenario driver ─────────────────────────────────────────────────────

// Runs `rounds` randomized inserts (even keys from [0, 2·keyspace); duplicate
// attempts must be REJECTED with the tree untouched) against `t`, checking
// model equivalence every `stride` mutations and at the end. Returns 0 or a
// check code (1..29); 30+x = driver-level failure x.
fn drive(snap: &mut MemorySnapshot, t: &mut Btfl<2, CowProfile>, md: &mut Model, lcg: &mut Lcg,
         rounds: i64, keyspace: u64, maxm: u64, stride: i64) -> i32 {
    let mut r: i64 = 0i64;
    while r < rounds {
        let k: u64 = (lcg.next() % keyspace) * 2u64;
        let m: u64 = lcg.next() % (maxm + 1u64);
        let mut vals: Vec<u64> = vec_new::<u64>();
        let mut j: u64 = 0u64;
        while j < m {
            vals.push(k * 1000u64 + j);
            j = j + 1u64;
        }
        let existing: i64 = model_find(md, k);
        let ok: bool = mm_insert(snap, t, k, &vals);
        if existing >= 0i64 {
            if ok {
                return 31i32;   // duplicate must be rejected
            }
        } else {
            if !ok {
                return 32i32;   // fresh key must insert
            }
            model_insert(md, k, &vals);
        }
        // absent keys (odd) always miss
        let miss: BtflSeek = btfl_seek::<2, CowProfile>(t, k + 1u64);
        if miss.found {
            return 33i32;
        }
        let mut none: Vec<u64> = vec_new::<u64>();
        if btfl_key_stream::<2, CowProfile>(t, k + 1u64, 1u32, &mut none) {
            return 34i32;
        }
        if (r + 1i64) % stride == 0i64 {
            let c: i32 = check_full(t, md);
            if c != 0i32 {
                return c;
            }
        }
        r = r + 1i64;
    }
    return check_full(t, md);
}

// ── P6b: bulk build ─────────────────────────────────────────────────────────
//
// The law that matters is EQUIVALENCE OF PATHS: a batch built in bulk and the
// same batch inserted one entry at a time must produce trees that answer
// every query identically and both pass btfl_check. They are not required to
// be byte-identical — bulk fills leaves to capacity by design, where the
// single-insert path leaves them half full after each split — so the gate
// compares BEHAVIOUR (the full model equivalence, already written) and
// structure VALIDITY, not layout.
//
// The bulk-specific properties on top of that:
//   * the cut projection sums: keys + vals == n at every cut (the identity
//     the whole batch path rests on);
//   * cuts are key-aligned, so every leaf starts with a key — btfl_check
//     enforces it, and a mis-aligned cut cannot survive;
//   * leaves are actually FULL: with entries much smaller than a leaf, a bulk
//     build must produce FEWER leaves than the same data inserted one by one.
//     This is the property that makes the whole rung worth having, so it is
//     asserted rather than assumed.
//
// Codes 900..949.

fn p6b_stage_from_model(md: &Model) -> BtflStage {
    let mut st: BtflStage = btfl_stage_new();
    let n: i64 = md.mk.len();
    let mut i: i64 = 0i64;
    while i < n {
        let a: u64 = md.moff.get(i);
        let b: u64 = md.moff.get(i + 1i64);
        let mut vals: Vec<u64> = vec_new::<u64>();
        let mut j: u64 = a;
        while j < b {
            vals.push(md.mv.get(j as i64));
            j = j + 1u64;
        }
        st.push_entry(md.mk.get(i), &vals);
        i = i + 1i64;
    }
    return st;
}

// Count the leaves of a tree by walking the leftmost spine down and then the
// level: used to compare bulk packing against the single-insert path.
fn p6b_leaf_count(t: &Btfl<2, CowProfile>) -> u64 {
    // Distinct leaves visited while selecting every key in order: keys are
    // globally ordered and leaves are contiguous in that order, so a change of
    // leaf address marks a boundary.
    let keys: u64 = btfl_count::<2, CowProfile>(t, 0u64);
    let mut leaves: u64 = 0u64;
    let mut last: u64 = 0u64;
    let mut seen: bool = false;
    let mut i: u64 = 0u64;
    while i < keys {
        let loc: BtflLoc = btfl_select::<2, CowProfile>(t, 0u64, i);
        let addr: u64 = loc.leaf as u64;
        if !seen || addr != last {
            leaves = leaves + 1u64;
            last = addr;
            seen = true;
        }
        i = i + 1u64;
    }
    return leaves;
}

fn check_bulk_build(rng: &mut Lcg, entries: u64, maxvals: u64,
                    leaf_bytes: u32, branch_bytes: u32) -> i32 {
    let mut snap: MemorySnapshot = MemorySnapshot::with_id(77u64);
    let mut md: Model = model_new();

    // a deterministic batch in key order
    let mut key: u64 = 5u64;
    let mut e: u64 = 0u64;
    while e < entries {
        let m: u64 = rng.next() % (maxvals + 1u64);
        let mut vals: Vec<u64> = vec_new::<u64>();
        let mut j: u64 = 0u64;
        while j < m {
            vals.push(key * 1000u64 + j);
            j = j + 1u64;
        }
        model_insert(&mut md, key, &vals);
        key = key + 1u64 + (rng.next() % 7u64);
        e = e + 1u64;
    }

    // ── the cut projection identity, at every cut length ──────────────────
    let st: BtflStage = p6b_stage_from_model(&md);
    if st.entries() != (md.mk.len() as u64) {
        return 900i32;
    }
    let total: u64 = st.size();
    let mut n: u64 = 0u64;
    while n <= total {
        let c: BtflCut = btfl_cut(&st, 0u64, n);
        if c.keys + c.vals != n {
            return 901i32;
        }
        n = n + 1u64;
    }
    // ...and from a non-zero origin, where the rebase is what could go wrong
    let mid: u64 = total / 2u64;
    let mut n2: u64 = 0u64;
    while n2 <= total - mid {
        let c2: BtflCut = btfl_cut(&st, mid, n2);
        if c2.keys + c2.vals != n2 {
            return 902i32;
        }
        n2 = n2 + 1u64;
    }

    // ── bulk build vs the single-insert path ──────────────────────────────
    let tb: Btfl<2, CowProfile> = btfl_bulk_build::<CowProfile>(&mut snap, &st, leaf_bytes, branch_bytes);
    if !btfl_check::<2, CowProfile>(&tb) {
        return 903i32;
    }
    let rcb: i32 = check_full(&tb, &md);
    if rcb != 0i32 {
        btfl_drop::<2, CowProfile>(&tb);
        return 900i32 + rcb;
    }

    let mut ts: Btfl<2, CowProfile> = btfl_create::<2, CowProfile>(&mut snap, leaf_bytes, branch_bytes);
    let ni: i64 = md.mk.len();
    let mut q: i64 = 0i64;
    while q < ni {
        let a: u64 = md.moff.get(q);
        let b: u64 = md.moff.get(q + 1i64);
        let mut vals: Vec<u64> = vec_new::<u64>();
        let mut w: u64 = a;
        while w < b {
            vals.push(md.mv.get(w as i64));
            w = w + 1u64;
        }
        if !mm_insert(&mut snap, &mut ts, md.mk.get(q), &vals) {
            btfl_drop::<2, CowProfile>(&tb);
            btfl_drop::<2, CowProfile>(&ts);
            return 904i32;
        }
        q = q + 1i64;
    }
    if !btfl_check::<2, CowProfile>(&ts) {
        btfl_drop::<2, CowProfile>(&tb);
        btfl_drop::<2, CowProfile>(&ts);
        return 905i32;
    }

    // both paths answer identically (the model check already ran on each)
    let rcs: i32 = check_full(&ts, &md);
    if rcs != 0i32 {
        btfl_drop::<2, CowProfile>(&tb);
        btfl_drop::<2, CowProfile>(&ts);
        return 940i32 + rcs;
    }

    // ── packing: bulk must not use MORE leaves than one-by-one ────────────
    let lb: u64 = p6b_leaf_count(&tb);
    let ls: u64 = p6b_leaf_count(&ts);
    if lb > ls {
        btfl_drop::<2, CowProfile>(&tb);
        btfl_drop::<2, CowProfile>(&ts);
        return 906i32;
    }
    // with many entries per leaf, bulk packing must be STRICTLY better —
    // otherwise the fill is not filling and the rung buys nothing.
    if ls > 2u64 && lb >= ls {
        btfl_drop::<2, CowProfile>(&tb);
        btfl_drop::<2, CowProfile>(&ts);
        return 907i32;
    }

    btfl_drop::<2, CowProfile>(&tb);
    btfl_drop::<2, CowProfile>(&ts);
    return 0i32;
}

fn run_all() -> i32 {
    let mut snap: MemorySnapshot = MemorySnapshot::with_id(1u64);

    // ── 10..19: empty tree ──
    {
        let mut t0: Btfl<2, CowProfile> = btfl_create::<2, CowProfile>(&mut snap, 4096u32, 4096u32);
        if btfl_count::<2, CowProfile>(&t0, 0u64) != 0u64 {
            return 10i32;
        }
        if btfl_count::<2, CowProfile>(&t0, 1u64) != 0u64 {
            return 11i32;
        }
        if !btfl_check::<2, CowProfile>(&t0) {
            return 12i32;
        }
        let sk: BtflSeek = btfl_seek::<2, CowProfile>(&t0, 7u64);
        if sk.found {
            return 13i32;
        }
        if sk.rank != 0u64 {
            return 14i32;
        }
        let sel: BtflLoc = btfl_select::<2, CowProfile>(&t0, 0u64, 0u64);
        if sel.found {
            return 15i32;
        }
        let mut none: Vec<u64> = vec_new::<u64>();
        if btfl_key_stream::<2, CowProfile>(&t0, 7u64, 1u32, &mut none) {
            return 16i32;
        }
        btfl_drop::<2, CowProfile>(&t0);
    }

    // ── 20..39: config A — small nodes, per-mutation equivalence ──
    {
        let mut t: Btfl<2, CowProfile> = btfl_create::<2, CowProfile>(&mut snap, 768u32, 320u32);
        let mut md: Model = model_new();
        let mut lcg: Lcg = Lcg { s: 0xB7F1u64 };
        let c: i32 = drive(&mut snap, &mut t, &mut md, &mut lcg,
                           800i64, 1200u64, 4u64, 1i64);
        if c != 0i32 {
            return 20i32 + (c % 10i32);
        }
        if t.level < 2u32 {
            return 38i32;   // the scenario must cross branch-split depth
        }
        btfl_drop::<2, CowProfile>(&t);
    }

    // ── 40..59: config B — default nodes, long value runs ──
    {
        let mut t: Btfl<2, CowProfile> = btfl_create::<2, CowProfile>(&mut snap, 4096u32, 4096u32);
        let mut md: Model = model_new();
        let mut lcg: Lcg = Lcg { s: 0xC0FFEEu64 };
        // maxm 40 → value runs up to 40 (long symbol-1 runs inside leaves)
        let c: i32 = drive(&mut snap, &mut t, &mut md, &mut lcg,
                           500i64, 900u64, 40u64, 1i64);
        if c != 0i32 {
            return 40i32 + (c % 10i32);
        }
        if t.level < 1u32 {
            return 58i32;   // must have split at least once
        }
        btfl_drop::<2, CowProfile>(&t);
    }

    // ── 60..79: config C — volume run across ≥ 3 levels ──
    {
        let mut t: Btfl<2, CowProfile> = btfl_create::<2, CowProfile>(&mut snap, 768u32, 320u32);
        let mut md: Model = model_new();
        let mut lcg: Lcg = Lcg { s: 42u64 };
        let c: i32 = drive(&mut snap, &mut t, &mut md, &mut lcg,
                           5000i64, 8000u64, 3u64, 250i64);
        if c != 0i32 {
            return 60i32 + (c % 10i32);
        }
        if t.level < 3u32 {
            return 78i32;
        }
        btfl_drop::<2, CowProfile>(&t);
    }

    // ── 80..99: config D (P7.3) — WIDE branch: fanout past the SUM-index
    // threshold (spans of 32), so the branch pdt's INDEX is load-bearing.
    // At small fanouts sum() scans raw cells and a stale index is invisible;
    // this scenario is what makes "update path must reindex" a tested law
    // rather than a comment (probe P73-4 bites HERE).
    {
        let mut t: Btfl<2, CowProfile> = btfl_create::<2, CowProfile>(&mut snap, 512u32, 16384u32);
        let mut md: Model = model_new();
        let mut lcg: Lcg = Lcg { s: 0x9E3779B9u64 };
        let c: i32 = drive(&mut snap, &mut t, &mut md, &mut lcg,
                           700i64, 2000u64, 2u64, 100i64);
        if c != 0i32 {
            return 80i32 + (c % 10i32);
        }
        unsafe {
            if t.level < 1u32 {
                return 98i32;
            }
            // the root must actually be WIDE, or the scenario tests nothing
            if br_pdt_size_for_test::<CowProfile>(t.root) <= 32u64 {
                return 99i32;
            }
        }
        btfl_drop::<2, CowProfile>(&t);
    }

    // ── 900..949: P6b bulk build ──
    {
        let mut brng: Lcg = Lcg { s: 0x94D049BB133111EBu64 };
        // the corner first: one entry, no values
        let r0: i32 = check_bulk_build(&mut brng, 1u64, 0u64, 4096u32, 4096u32);
        if r0 != 0i32 {
            return r0;
        }
        let r1: i32 = check_bulk_build(&mut brng, 40u64, 3u64, 768u32, 512u32);
        if r1 != 0i32 {
            return r1;
        }
        let r2: i32 = check_bulk_build(&mut brng, 120u64, 6u64, 768u32, 320u32);
        if r2 != 0i32 {
            return r2;
        }
        let r3: i32 = check_bulk_build(&mut brng, 300u64, 2u64, 896u32, 512u32);
        if r3 != 0i32 {
            return r3;
        }
        // a tail entry longer than half the leaf's remaining room — the shape
        // that a bisection over raw positions (rather than entry count) gets
        // wrong, because the fit predicate is not monotone there.
        let r4: i32 = check_bulk_build(&mut brng, 6u64, 20u64, 768u32, 512u32);
        if r4 != 0i32 {
            return r4;
        }
    }

    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap (256 & 0xFF == 0) and report
// SUCCESS. The status is a fixed non-zero byte; the code carries the detail.
// The multimap container's insert, expressed over the btfl prototype (one key
// entry + `vals` as stream 1) — the container layer btfl itself no longer carries.
fn mm_insert(snap: &mut MemorySnapshot, t: &mut Btfl<2, CowProfile>, key: u64, vals: &Vec<u64>) -> bool {
    let mut lens: Vec<u64> = vec_new::<u64>();
    lens.push(vals.length() as u64);
    return btfl_insert_n::<2, CowProfile>(snap, t, key, vals, &lens);
}

fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL btfl_multimap: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
