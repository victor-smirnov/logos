// Generic container (ADR 0020 wave-0, S2): two DISTINCT instantiations of one
// `container Map<K,V>` generate two DISTINCT concrete stacks — a volume
// (str value) and a fast (bool value) b+tree — each mangled independently.
package test;

use logos.lcm.canon.container_item;
use logos.mem.pkd;
use logos.mem.bt.map;
use logos.mem.bt.memstore;  // MemorySnapshot — the generated handle struct names it (collect-time import gotcha)
use logos.lang.str;

container Map<K, V> for u8 { kind ordered_map; entry { key: K, val: V } measure max(key); }

fn beq(b: &[u8], want: str) -> bool {
    if b.len() != want.len() { return false; }
    let mut i: i64 = 0i64;
    while i < b.len() { if b[i] != str_byte_at(want, i) { return false; } i = i + 1i64; }
    return true;
}

fn main() -> i32 {
    let mut a: Map<u64, str> = Map::new();          // volume stack
    a.insert(1u64, "alpha");
    a.insert(2u64, "bravo");
    if a.size() != 2u64 { return 1i32; }
    if !beq(a.get_or(2u64), "bravo") { return 2i32; }
    a.free();

    let mut b: Map<i32, bool> = Map::new();         // DISTINCT fast stack
    b.insert(7i32, true);
    b.insert(9i32, false);
    if b.size() != 2u64 { return 3i32; }
    if b.get_or(7i32, false) != true { return 4i32; }
    if b.get_or(9i32, true) != false { return 5i32; }
    if b.get_or(100i32, true) != true { return 6i32; }   // absent → sentinel
    b.free();
    return 0i32;
}
