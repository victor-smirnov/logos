// Generic container (ADR 0021 Phase 4b demand path): two DISTINCT
// instantiations of one `container Map<K,V>` demand two DISTINCT configs →
// the factory generates two DISTINCT families (@hs-keyed — different CFG
// docs, different hashes). Asserted at the behavior level (both handles
// work) AND at the identity level (`CtrFamily::family_id()` differs).
// FSE-only value types (u64 / bool) — str-generic is the documented gap.
package test;

use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;        // create_ctr + CtrFamily (family_id probe)
use logos.mem.pkd;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.string;
use logos.std.io;

container Map<K, V> for u8 {
    kind ordered_map;
    entry { key: K, val: V }
    measure max(key);
}

fn fid<C: CtrFamily<MemorySnapshot>>() -> u64 { return C::family_id(); }

fn run_all() -> i32 {
    let mut store: MemoryStore = MemoryStore::new();
    let mut s0: MemorySnapshot = store.fork();

    let a = create_ctr::<typeof(Map::<u64, u64>)>(&mut s0, 1u64);          // fast u64/u64
    a.insert(1u64, 10u64);
    a.insert(2u64, 20u64);
    if a.size() != 2u64 { return 1i32; }
    if a.get_or(2u64, 0u64) != 20u64 { return 2i32; }

    let b = create_ctr::<typeof(Map::<i32, bool>)>(&mut s0, 2u64);         // DISTINCT fast family
    b.insert(7i32, true);
    b.insert(9i32, false);
    if b.size() != 2u64 { return 3i32; }
    if b.get_or(7i32, false) != true { return 4i32; }
    if b.get_or(9i32, true) != false { return 5i32; }
    if b.get_or(100i32, true) != true { return 6i32; }           // absent → sentinel

    // distinct configs → distinct family identities
    if fid::<typeof(Map::<u64, u64>)>() == fid::<typeof(Map::<i32, bool>)>() { return 7i32; }

    s0.release();
    store.release();
    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap (256 & 0xFF == 0) and report
// SUCCESS. The status is a fixed non-zero byte; the code carries the detail.
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL gen_generic_distinct: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
