// store_branches — the git-like STORE surface natched from Memoria/C++
// IMemoryStore: named branches, snapshot lineage (the DAG), and the queries
// over them. One Ledger container (u64/u64) rides the versions so branch
// isolation is checked on real CoW trees, not just id bookkeeping.
//
// The shape under test:
//   master ── s1 ── s2                     (master tip = 2)
//                    └── s3 ── s4          (branch "feature", tip = 4)
//   s1 ──────────────── s5                 (branch "hotfix",  tip = 5)
// So s2 is an INTERIOR node master still points at (a dangling branch tip),
// while heads() = the DAG leaves {4, 5}. fork_from(1) proves a child sees its
// PARENT's state (s1's 50→50), not master's later 50→999.
package test;

use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;
use logos.mem.pkd;
use logos.mem.bt.map;                 // Ctr / Snapshot traits
use logos.mem.bt.memstore;            // the store surface under test
use logos.mem.sync;                   // Arc
use logos.lang.str;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.lang.option;
use logos.std.io;

container Ledger for u8 {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure max(key);
}

const LEDGER: u64 = 1u64;

// unwrap-or-diagnose: an absent Option is a test failure with a code.
fn need(o: Option<Arc<dyn Snapshot>>, code: i32) -> Arc<dyn Snapshot> {
    match o {
        Option::Some(s) => { return s; }
        Option::None => {
            let mut m: String = String::new();
            m.push_str("FAIL store_branches: unexpected None, code ");
            m.push_i64(code as i64);
            eprintln_string(&m);
            // a null-ish sentinel is never reached in a passing run; abort loudly
            panic("store_branches: required snapshot was None");
        }
    }
}

fn contains(v: &Vec<u64>, x: u64) -> bool {
    let n: i64 = v.len();
    let mut i: i64 = 0i64;
    while i < n { if v.get(i) == x { return true; } i = i + 1i64; }
    return false;
}

fn has_name(v: &Vec<String>, x: str) -> bool {
    let n: i64 = v.len();
    let mut i: i64 = 0i64;
    while i < n { if v.borrow(i).eq_str(x) { return true; } i = i + 1i64; }
    return false;
}

fn run_all() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();

    // ── empty store: master exists but is empty ──────────────────────────
    if store_branch_head(&store, "master") != 0u64 { return 1i32; }
    match store_master(&mut store) { Option::Some(_s) => { return 2i32; } Option::None => {} }
    if store_active_snapshots(&store) != 0i64 { return 3i32; }
    if store_root_id(&store) != 0u64 { return 4i32; }

    // ── s1 (id 1): root on master ────────────────────────────────────────
    let s1: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    if s1.snapshot_id() != 1u64 { return 5i32; }
    if s1.has_parent() { return 6i32; }                     // root: parent 0
    if store_active_snapshots(&store) != 1i64 { return 7i32; }
    {
        let led = create_ctr::<typeof(Ledger)>(&s1, LEDGER);
        let mut k: u64 = 1u64;
        while k < 100u64 { led.insert(k, k); k = k + 1u64; }  // key k → k
    }
    s1.commit();
    if store_branch_head(&store, "master") != 1u64 { return 8i32; }
    if store_root_id(&store) != 1u64 { return 9i32; }
    if store_active_snapshots(&store) != 0i64 { return 10i32; }

    // ── s2 (id 2): child of master, overwrite 50 → 999 ───────────────────
    let s2: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    if s2.snapshot_id() != 2u64 { return 11i32; }
    if store_snapshot_parent(&store, 2u64) != 1u64 { return 12i32; }
    { let l = open_ctr::<typeof(Ledger)>(&s2, LEDGER); l.insert(50u64, 999u64); }
    s2.commit();
    if store_branch_head(&store, "master") != 2u64 { return 13i32; }

    // ── s3 (id 3): fork master, rebrand to "feature", 50 → 777 ───────────
    let s3: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    s3.set_as_branch("feature");
    if store_snapshot_parent(&store, 3u64) != 2u64 { return 14i32; }
    { let l = open_ctr::<typeof(Ledger)>(&s3, LEDGER); l.insert(50u64, 777u64); }
    s3.commit();
    // feature now tips at 3; master is unchanged at 2
    if store_branch_head(&store, "feature") != 3u64 { return 15i32; }
    if store_branch_head(&store, "master") != 2u64 { return 16i32; }

    // ── s4 (id 4): fork the "feature" branch tip, add 60 → 888 ───────────
    let s4: Arc<dyn Snapshot> = need(store_fork_branch(&mut store, "feature"), 17i32);
    if s4.snapshot_id() != 4u64 { return 18i32; }
    if store_snapshot_parent(&store, 4u64) != 3u64 { return 19i32; }
    { let l = open_ctr::<typeof(Ledger)>(&s4, LEDGER); l.insert(60000u64, 888u64); }  // NEW key (out of 1..99 fill)
    s4.commit();
    if store_branch_head(&store, "feature") != 4u64 { return 20i32; }

    // ── s5 (id 5): fork the ROOT snapshot (id 1), branch "hotfix" ────────
    // Parent is 1, so it sees s1's state (50 → 50), NOT master's 50 → 999.
    let s5: Arc<dyn Snapshot> = need(store_fork_from(&mut store, 1u64), 21i32);
    s5.set_as_branch("hotfix");
    if store_snapshot_parent(&store, 5u64) != 1u64 { return 22i32; }
    { let l = open_ctr::<typeof(Ledger)>(&s5, LEDGER); l.insert(10u64, 111u64); }
    s5.commit();
    if store_branch_head(&store, "hotfix") != 5u64 { return 23i32; }

    // ── branch table ─────────────────────────────────────────────────────
    let names: Vec<String> = store_branches(&store);
    if !has_name(&names, "master") { return 24i32; }
    if !has_name(&names, "feature") { return 25i32; }
    if !has_name(&names, "hotfix") { return 26i32; }
    if names.len() != 3i64 { return 27i32; }

    // ── lineage queries ──────────────────────────────────────────────────
    let ch1: Vec<u64> = store_children_of(&store, 1u64);
    if !contains(&ch1, 2u64) || !contains(&ch1, 5u64) { return 28i32; }
    if ch1.len() != 2i64 { return 29i32; }
    let ch2: Vec<u64> = store_children_of(&store, 2u64);
    if !contains(&ch2, 3u64) || ch2.len() != 1i64 { return 30i32; }

    // heads() = DAG leaves {4,5}; branch_heads() = tips {2,4,5}
    let hd: Vec<u64> = store_heads(&store);
    if !contains(&hd, 4u64) || !contains(&hd, 5u64) { return 31i32; }
    if contains(&hd, 2u64) { return 32i32; }               // 2 has child 3 → interior
    let bh: Vec<u64> = store_branch_heads(&store);
    if !contains(&bh, 2u64) || !contains(&bh, 4u64) || !contains(&bh, 5u64) { return 33i32; }

    // linear_history: master root → feature tip walks 1,2,3,4
    let lh: Vec<u64> = store_linear_history(&store, 1u64, 4u64);
    if lh.len() != 4i64 { return 34i32; }
    if lh.get(0i64) != 1u64 || lh.get(1i64) != 2u64 || lh.get(2i64) != 3u64 || lh.get(3i64) != 4u64 { return 35i32; }
    // hotfix tip's ancestry back to root is just 1,5
    let lh2: Vec<u64> = store_linear_history(&store, 1u64, 5u64);
    if lh2.len() != 2i64 || lh2.get(0i64) != 1u64 || lh2.get(1i64) != 5u64 { return 36i32; }
    // start not on stop's ancestry → empty
    let lh3: Vec<u64> = store_linear_history(&store, 3u64, 5u64);
    if lh3.len() != 0i64 { return 37i32; }

    // ── branch ISOLATION on real trees ───────────────────────────────────
    // master tip (2): 50→999, 10→10, no 60
    let m: Arc<dyn Snapshot> = need(store_master(&mut store), 38i32);
    if m.snapshot_id() != 2u64 { return 39i32; }
    {
        let lm = open_ctr::<typeof(Ledger)>(&m, LEDGER);
        if lm.get_or(50u64, 0u64) != 999u64 { return 40i32; }
        if lm.get_or(10u64, 0u64) != 10u64 { return 41i32; }
        if lm.get_or(60000u64, 0xDEADu64) != 0xDEADu64 { return 42i32; }   // s4's new key unseen
    }
    // feature tip (4): 50→777, 60000→888, 10→10
    let f: Arc<dyn Snapshot> = need(store_find_branch(&mut store, "feature"), 43i32);
    {
        let lf = open_ctr::<typeof(Ledger)>(&f, LEDGER);
        if lf.get_or(50u64, 0u64) != 777u64 { return 44i32; }
        if lf.get_or(60000u64, 0u64) != 888u64 { return 45i32; }
        if lf.get_or(10u64, 0u64) != 10u64 { return 46i32; }
    }
    // hotfix tip (5): forked from s1 → 50 stays 50 (never saw master's 999), 10→111
    let hx: Arc<dyn Snapshot> = need(store_find_branch(&mut store, "hotfix"), 47i32);
    {
        let lh5 = open_ctr::<typeof(Ledger)>(&hx, LEDGER);
        if lh5.get_or(50u64, 0u64) != 50u64 { return 48i32; }
        if lh5.get_or(10u64, 0u64) != 111u64 { return 49i32; }
        if lh5.get_or(60000u64, 0xDEADu64) != 0xDEADu64 { return 50i32; }
    }

    // ── set_branch / set_master ──────────────────────────────────────────
    store_set_branch(&mut store, "release", 4u64);          // release := feature tip
    if store_branch_head(&store, "release") != 4u64 { return 51i32; }
    store_set_master(&mut store, 5u64);                     // move master onto hotfix
    if store_branch_head(&store, "master") != 5u64 { return 52i32; }
    store_set_master(&mut store, 2u64);                     // restore

    // ── remove_branch: ref gone, snapshots stay findable by id ───────────
    store_remove_branch(&mut store, "release");
    match store_find_branch(&mut store, "release") { Option::Some(_s) => { return 53i32; } Option::None => {} }
    match store_find(&mut store, 4u64) { Option::Some(_s) => {} Option::None => { return 54i32; } }  // still there
    if store_snapshot_status(&store, 4u64) != SNAP_COMMITTED { return 55i32; }

    // ── pack: reclaim a store-DROPPED leaf with no branch ref ────────────
    // Build a throwaway commit on branch "tmp" (its wrapper is dropped at block
    // end — committed, so it survives). Drop the branch ref, then store_drop it
    // BY ID (no wrapper → deferred reclaim, unlike the RAII wrapper form). It
    // has no committed child and no ref → pack reclaims exactly it.
    {
        let t: Arc<dyn Snapshot> = need(store_fork_from(&mut store, 5u64), 56i32);
        t.set_as_branch("tmp");
        t.commit();                                         // id 6, tmp tip 6
    }
    if store_branch_head(&store, "tmp") != 6u64 { return 57i32; }
    store_remove_branch(&mut store, "tmp");
    store_drop(&mut store, 6u64);                           // mark DROPPED by id
    match store_find(&mut store, 6u64) { Option::Some(_s) => { return 58i32; } Option::None => {} }  // dropped → unfindable
    if store_pack(&mut store) != 1i64 { return 59i32; }     // reclaimed exactly 6
    if store_snapshot_status(&store, 6u64) != SNAP_DROPPED { return 60i32; }  // gone → absent-as-DROPPED
    if store_pack(&mut store) != 0i64 { return 61i32; }     // nothing left to reclaim

    return 0i32;
}

fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 { return 0i32; }
    let mut msg: String = String::new();
    msg.push_str("FAIL store_branches: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
