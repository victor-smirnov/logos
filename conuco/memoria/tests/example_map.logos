package test;
// ═══════════════════════════════════════════════════════════════════════════
// example_map — THE worked example of the Memoria/Logos container stack over
// the single-stream ordered MAP (the btss family). A living document: it runs
// in the conuco gate, so every layer it demonstrates stays green as the stack
// evolves. Iterate HERE.
//
// The stack, top to bottom (what each § below exercises):
//
//   Deem/app code            §4 dyn plane (&dyn Ctr), §2 Rc handles,
//                            §8 #[batch_entry] adapters (app struct → batch)
//   ── boundary ─────────    map.logos: Ctr (+family traits), Uid256;
//                            §6 with_entry — the WITH_ENTRY quad;
//                            §7 seek(n) — the entry-number cursor;
//                            §8 make_buffer/insert_batch — the two-stage
//                            batch (staging → weight-calculus packing);
//                            §9 remove — delete + weight-admitted merge
//   metaclass factory        §1 create_ctr_rc — decl → CFG doc → mono demand
//                            → generated family (package logos.gen)
//   BT protocol              ops.logos: bt_cow_insert / bt_cow_with_entry
//                            walk skeletons (privatize / graft / repoint)
//   node ALGEBRA (ADR 0023)  alg.logos (description) + interp.logos
//                            (reference semantics); the factory emits
//                            per-schema FUSED KERNELS (alg_kernel) — the
//                            leaf's mutations, btss upserts died here
//   BTSS substrate           btss.logos: column mechanics (fmt/split/
//                            lower_bound/split_index) — ONE body each
//   node / store             node.logos MemNode (CoW header) + memstore
//   configuration            storecfg.logos: WritStatic docs — the store's
//                            node form + geometry BAKED at generation
//
// THREADING RULE (the a3bbba05 design): Store/Snapshot are CROSS-THREAD and
// ride Arc; a Ctr handle is STRICTLY THREAD-LOCAL and rides Rc. v1 allocates
// plainly; the destination is pools of ready instances (snapshots in the
// store, handles in the snapshot) with Drop returning to the pool.
//
// OPEN SLOTS this example will grow into (iterate here):
//   * `trait OrderedMap: Ctr` — the map family's dyn surface (get/insert
//     through `&dyn`, like Multimap for btfl) + the generated impl;
//   * open_dyn(family_id, snap, ctr) -> Box<dyn Ctr> — the opener REGISTRY
//     (Memoria store->find analog; registration mechanics = open PAIR fork);
//   * a second StoreCfg (non-4K geometry / a second store) driven through
//     THE SAME compiled example code — the S4 payoff.
// ═══════════════════════════════════════════════════════════════════════════

use memoria.ctr.map;                  // §0 the LIBRARY declaration (below)
use logos.lang.option;
use logos.lcm.canon.container_item;   // the factory (an emitted `use` cannot LOAD a module)
use logos.lcm.canon.metaclass;        // create_ctr_rc / open_ctr — the demand surface
use logos.lcm.canon.adapter;          // §8 #[batch_entry] — the adapter metafunction
use logos.mem.bt.map;                 // Ctr / Uid256 — the boundary plane
use logos.mem.bt.memstore;            // MemoryStore / MemorySnapshot
use logos.mem.sync;                   // Arc — the cross-thread snapshot plane
use logos.lang.rc;                    // Rc — the thread-local handle plane
use logos.mem.collections.vec;
use logos.mem.string;
use logos.std.io;
use logos.lang.panic;
use logos.std.compiler.metaprog;      // §8 the handler kit (annotation dispatch)

// ── §8 prelude: an APPLICATION struct as a batch entry ──────────────────────
// #[batch_entry] reads the fields, validates them against the encodable set
// (a bad field fails the COMPILE naming the struct and field) and emits the
// BatchMapEntry impl with the casts — u32 here, the column is u64. The
// buffer's push_from/extend_from accept it through the trait seam, so the
// factory-hashed buffer type is never named in this file.
#[batch_entry]
struct Deposit {
    account: u32,
    cents: u64,
}

// ── §0 THE DECLARATION (lives in memoria.ctr.map, quoted for the reader) ────
//
//     pub container Map<K, V> for u8 {
//         kind ordered_map;
//         entry { key: K, val: V }
//         measure max(key);
//     }
//
// No code exists on the library side. Naming `Map::<u64, u64>` here makes
// mono DEMAND the concrete configuration hash; the metaclass factory answers
// by generating the whole family (leaf/branch/tree/CoW-map + the handle) in
// THIS compile — with the store's node form (#nd = CowProfile) and geometry
// (4096/4096) baked from the composed StoreCfg. Identical configs unify
// across consumers by the content hash.

// ── §4 the dyn plane: a consumer that knows ONLY the boundary ───────────────
// One compiled body for EVERY container implementation — the reason the
// hybrid static/dynamic design exists. (The map's typed ops go through the
// generated handle below; a family dyn trait is an open slot, see header.)
fn report(c: &dyn Ctr) -> u64 {
    return c.size();
}

// The PINNED entry shape (see project_storecfg_plane): a dyn coercion cannot
// happen on the pre-drain factory projection (`CtrClass<...>::Handle`), so
// the rim is a thin GENERIC whose factory-backed bound defers until the
// drain; the generic→dyn coercion happens INSIDE, over the bound param.
// "Generic at the rim, dyn inside."
fn report_via<C: Ctr>(c: &C) -> u64 {
    return report(c);
}

fn run_all() -> i32 {
    // ── §1 store → snapshot (Arc plane) → container (Rc plane) ──────────────
    // The TWO-TIER interface (Memoria public/internal split): store_fork_arc
    // hands out `Arc<dyn Snapshot>` — the PUBLIC tier. Its vtable is the whole
    // surface user code sees: the id plane (§5) + lifecycle (commit/remove/
    // status, §3). The PRIVILEGED capability (node_alloc / root_of / set_root)
    // is inherent on the concrete MemorySnapshot and NOT in this vtable — so
    // `snap.node_alloc(...)` does not even resolve here. The generated container
    // recovers the concrete internally (an explicit dyn_data downcast, the moral
    // equivalent of Memoria's cast to the internal interface) to reach it.
    let mut store: Arc<MemoryStore> = store_new();
    let mut snap: Arc<dyn Snapshot> = store_fork_arc(&mut store);

    let mut m = create_ctr_rc::<typeof(Map::<u64, u64>)>(&snap, 1u64);

    // ── §2 the typed surface (through the Rc, auto-deref) ───────────────────
    // upsert semantics: insert-new + replace-on-hit; ordered by key (the
    // MAX-measure verdict from the declaration drives branch separators).
    let n: u64 = 4000u64;                 // enough to force leaf+branch splits
    let mut i: u64 = 0u64;
    while i < n {
        m.insert(i, i * 3u64);
        i = i + 1u64;
    }
    if m.size() != n { return 1i32; }
    if m.get_or(1234u64, 0u64) != 3702u64 { return 2i32; }
    m.insert(1234u64, 7u64);              // replace-on-hit
    if m.get_or(1234u64, 0u64) != 7u64 { return 3i32; }
    if m.size() != n { return 4i32; }
    if m.get_or(999_999u64, 11u64) != 11u64 { return 5i32; }   // miss → sentinel

    // an Rc CLONE is the same thread-local view — writes through the clone
    // are visible through the original (shared-view semantics).
    let mut m_clone = m.clone_ref();
    m_clone.insert(500_000u64, 42u64);
    if m.get_or(500_000u64, 0u64) != 42u64 { return 6i32; }
    if m.size() != n + 1u64 { return 7i32; }

    // ── §3 snapshot lifecycle: commit publishes, open sees the same trees ───
    snap.commit();
    let m2 = open_ctr::<typeof(Map::<u64, u64>)>(&snap, 1u64);
    if m2.size() != n + 1u64 { return 8i32; }
    if m2.get_or(4u64, 0u64) != 12u64 { return 9i32; }

    // ── §4 the dyn plane in action ──────────────────────────────────────────
    if report_via(&*m) != n + 1u64 { return 10i32; }

    // ── §5 the boundary id plane: Uid256 straight off the public tier ───────
    // snap IS `Arc<dyn Snapshot>` now — snapshot_uid / snapshot_id are public
    // vtable methods, so the boundary id plane is a direct call (no coercion).
    let uid: Uid256 = snap.snapshot_uid();
    if !uid256_eq(&uid, &uid256_from_u64(snap.snapshot_id())) { return 11i32; }

    // ── §6 WITH_ENTRY — the quad boundary (ADR 0023): ONE function drives
    // insert/update/remove/no-op; the transition itself runs on the
    // generated algebra kernels through the same CoW walk as insert ────────
    m.with_entry(777_777u64, half_or_seed);        // miss → seed 100
    if m.get_or(777_777u64, 0u64) != 100u64 { return 12i32; }
    m.with_entry(777_777u64, half_or_seed);        // hit, even → half
    if m.get_or(777_777u64, 0u64) != 50u64 { return 13i32; }
    m.with_entry(777_777u64, half_or_seed);        // 50 → 25 (odd next time)
    m.with_entry(777_777u64, half_or_seed);        // odd → REMOVE
    if m.get_or(777_777u64, 0u64) != 0u64 { return 14i32; }
    if m.size() != n + 1u64 { return 15i32; }

    // ── §7 SEEK BY ENTRY NUMBER (the stream-size feature): every container
    // doubles as an ARRAY of its entries — Memoria's classic BTSS semantics.
    // The branch rows carry per-child subtree counts (maintained by every
    // insert), so seek(n) is one descent that subtracts child counts until
    // the remainder falls inside a subtree. The cursor is the v0 pair (leaf
    // + local index) with typed key/value reads; movement lands with the
    // cursors arc. Keys here are 0..n plus 500_000 → entry i has key i for
    // i < n, and the LAST entry is the 500_000 straggler.
    let c = m.seek(2500u64);
    if !c.valid() { return 16i32; }
    if c.key() != 2500u64 { return 17i32; }
    if c.value() != 7500u64 { return 18i32; }
    let last = m.seek(n);                          // entry #4000 = key 500_000
    if !last.valid() || last.key() != 500_000u64 { return 19i32; }
    if m.seek(n + 1u64).valid() { return 20i32; }  // past the end: invalid, no trap

    // ── §8 BATCH INSERT (the two-stage design): the container hands out a
    // STAGING BUFFER already in the leaf's physical column format
    // (make_buffer — the old-Memoria shape); insert_batch cuts it into leaf
    // fragments by PRE-ESTIMATION at the 90% fill target — no trial
    // insertion, no block restores (the pack_weight gate pins the byte
    // exactness this stands on) — and splices them under the same CoW
    // privatize/repoint walk as a single insert. The contract: keys
    // strictly ascending, landing WHOLE between two adjacent existing keys
    // (a violating batch is REJECTED with the tree untouched).
    let mut buf = m.make_buffer();
    buf.push(600_000u64, 1u64);                    // the typed direct push …
    let mut deps: Vec<Deposit> = vec_new::<Deposit>();
    let mut d: u64 = 1u64;
    while d < 100u64 {
        deps.push(Deposit { account: (600_000u64 + d) as u32, cents: d * 25u64 });
        d = d + 1u64;
    }
    buf.extend_from(&deps);                        // … and the §8-prelude adapters
    if buf.len() != 100u64 { return 21i32; }
    if !m.insert_batch(&buf) { return 22i32; }
    if m.size() != n + 101u64 { return 23i32; }
    if m.get_or(600_042u64, 0u64) != 42u64 * 25u64 { return 24i32; }
    // the sorted-run contract: an unsorted batch is rejected, tree untouched
    let mut bad = m.make_buffer();
    bad.push(9u64, 9u64);
    bad.push(3u64, 3u64);
    if m.insert_batch(&bad) { return 25i32; }
    if m.size() != n + 101u64 { return 26i32; }

    // ── §9 REMOVAL: delete + the neighbor MERGE (the C++ remove-then-merge
    // discipline, decided by the weight calculus — `w(left)+w(right) ≤
    // budget` is exact, so a merge fits by proof or is not attempted). The
    // walk is the same CoW privatize/repoint as insert; the root collapses
    // while it is a one-child branch. An absent key returns false with
    // NOTHING mutated.
    if !m.remove(600_042u64) { return 27i32; }        // a batch row from §8
    if m.remove(600_042u64) { return 28i32; }         // second time: absent
    if m.get_or(600_042u64, 0xDEADu64) != 0xDEADu64 { return 29i32; }
    if m.size() != n + 100u64 { return 30i32; }
    // remove a spread of §2 keys — merges fire as leaves drain
    i = 0u64;
    while i < n {
        if !m.remove(i) { return 31i32; }
        i = i + 5u64;
    }
    if m.size() != n + 100u64 - 800u64 { return 32i32; }
    if m.get_or(6u64, 0u64) != 18u64 { return 33i32; }   // neighbors intact

    return 0i32;
}

// The quad in one function: None→Some(100) seeds, even halves, odd removes.
fn half_or_seed(cur: Option<u64>) -> Option<u64> {
    match cur {
        Option::Some(v) => {
            if v % 2u64 == 1u64 {
                return Option::None;
            }
            return Option::Some(v / 2u64);
        }
        Option::None => {
            return Option::Some(100u64);
        }
    }
}

// Exit status is an 8-bit channel: print the diagnostic code, return a fixed
// non-zero byte (a code >= 256 would wrap to 0 and lie SUCCESS).
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL example_map: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
