// dirmap_rc — the store directory as a CoW container (logos.mem.bt.dirmap),
// driven at the raw-node level (no MemoryStore) to pin the REFCOUNT discipline
// that makes "the directory IS a container" correct:
//   - fork = share the root (inc_rc), then a mutation CoW-clones the touched
//     leaf and inc_rc's every container root it still references;
//   - a container repoint (overwrite) releases the displaced root;
//   - one snapshot's edits are invisible to the other (CoW isolation);
//   - ONE tree_release(dir_root) cascades to every container root (valgrind
//     proves no leak / no double-free).
//
// "Container roots" here are fake leaf blocks (level 0) the directory points at
// — real containers arrive when the store wires dirmap in. node_rc reads let us
// assert the sharing arithmetic exactly.
package test;

use logos.mem.bt.dirmap;
use logos.mem.bt.node;        // node_alloc / node_rc / node_level / tree_release
use logos.mem.pkd;            // (node substrate)
use logos.mem.collections.vec;
use logos.mem.string;
use logos.std.io;

// A fake container root: a bare level-0 leaf block, rc 1, that the directory
// references and tree_release will free. node_level = 0 (default).
unsafe fn fake(snp: u64) -> *mut u8 { return node_alloc(4096u32, 2u32, snp); }

fn run_all() -> i32 {
    unsafe {
        // ── basic insert + get + count (one leaf) ────────────────────────
        let d0: DirRoot = dir_new(1u64);
        let mut root: *mut u8 = d0.root;
        let mut level: u32 = d0.level;

        let r1: *mut u8 = fake(1u64);
        let r2: *mut u8 = fake(1u64);
        let s1: DirRoot = dir_set(root, level, 100u64, r1 as u64, 1u64); root = s1.root; level = s1.level;
        let s2: DirRoot = dir_set(root, level, 200u64, r2 as u64, 1u64); root = s2.root; level = s2.level;

        if dir_get(root, level, 100u64) != (r1 as u64) { return 1i32; }
        if dir_get(root, level, 200u64) != (r2 as u64) { return 2i32; }
        if dir_get(root, level, 300u64) != 0u64 { return 3i32; }
        if dir_count(root, level) != 2u64 { return 4i32; }
        if node_rc(r1) != 1u32 { return 5i32; }        // one directory slot owns r1
        if node_rc(r2) != 1u32 { return 6i32; }

        // ── fork: share the directory root, then CoW-mutate under snap 2 ──
        node_inc_rc(root);                              // snap A + snap B share `root`
        let rootA: *mut u8 = root;  let levelA: u32 = level;

        let r3: *mut u8 = fake(2u64);
        let sb: DirRoot = dir_set(rootA, levelA, 300u64, r3 as u64, 2u64);  // snap B adds C300
        let rootB: *mut u8 = sb.root;  let levelB: u32 = sb.level;

        // The shared leaf was cloned → r1, r2 now referenced by BOTH versions.
        if node_rc(r1) != 2u32 { return 7i32; }
        if node_rc(r2) != 2u32 { return 8i32; }
        if node_rc(r3) != 1u32 { return 9i32; }
        // Isolation: B sees C300, A does not; both share C100/C200.
        if dir_get(rootB, levelB, 300u64) != (r3 as u64) { return 10i32; }
        if dir_get(rootA, levelA, 300u64) != 0u64 { return 11i32; }
        if dir_get(rootA, levelA, 100u64) != (r1 as u64) { return 12i32; }
        if dir_get(rootB, levelB, 100u64) != (r1 as u64) { return 13i32; }

        // ── repoint C100 in snap B (overwrite releases the displaced root) ─
        let r1b: *mut u8 = fake(2u64);
        let sr: DirRoot = dir_set(rootB, levelB, 100u64, r1b as u64, 2u64);
        let rootB2: *mut u8 = sr.root;  let levelB2: u32 = sr.level;
        if dir_get(rootB2, levelB2, 100u64) != (r1b as u64) { return 14i32; }
        if dir_get(rootA, levelA, 100u64) != (r1 as u64) { return 15i32; }   // A untouched
        if node_rc(r1) != 1u32 { return 16i32; }        // B's slot relinquished r1
        if node_rc(r1b) != 1u32 { return 17i32; }

        // ── release both versions — one call each, cascades to all roots ──
        tree_release(rootB2, levelB2);                  // frees B: r1b, r3 (r2 → A)
        tree_release(rootA, levelA);                    // frees A: r1, r2
        // (valgrind is the oracle for the frees; nothing left to read.)

        // ── split stress: many containers force leaf splits (level > 0) ──
        let big: DirRoot = dir_new(1u64);
        let mut br: *mut u8 = big.root;  let mut bl: u32 = big.level;
        let n: u64 = 600u64;
        let mut roots: Vec<u64> = vec_new::<u64>();
        let mut i: u64 = 0u64;
        while i < n {
            let f: *mut u8 = fake(1u64);
            roots.push(f as u64);
            let sx: DirRoot = dir_set(br, bl, i * 7u64 + 1u64, f as u64, 1u64);
            br = sx.root; bl = sx.level;
            i = i + 1u64;
        }
        if dir_count(br, bl) != n { return 18i32; }
        if bl == 0u32 { return 19i32; }                 // splits produced a real tree
        // every key resolves to its own root
        let mut k: u64 = 0u64;
        while k < n {
            if dir_get(br, bl, k * 7u64 + 1u64) != roots.get(k as i64) { return 20i32; }
            k = k + 1u64;
        }
        // fork the big tree, mutate one key under snap 3, verify isolation
        node_inc_rc(br);
        let bA: *mut u8 = br;  let blA: u32 = bl;
        let g: *mut u8 = fake(3u64);
        let sg: DirRoot = dir_set(bA, blA, 1u64, g as u64, 3u64);   // repoint key 1 in snap 3
        if dir_get(sg.root, sg.level, 1u64) != (g as u64) { return 21i32; }
        if dir_get(bA, blA, 1u64) != roots.get(0i64) { return 22i32; }   // snap-1 view intact

        tree_release(sg.root, sg.level);                // snap 3 version
        tree_release(bA, blA);                          // snap 1 version — cascades all 600
        return 0i32;
    }
}

fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 { return 0i32; }
    let mut msg: String = String::new();
    msg.push_str("FAIL dirmap_rc: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
