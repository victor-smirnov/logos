// gen_cow — Canon container_shape versioning, end to end (ADR 0020 Track B ②
// I3 + ADR 0021 Phase 4b demand path): one `kind ordered_map` declaration
// lowers to its CFG doc + CtrClass alias; `create_ctr::<typeof(GenCow)>` fires
// the mono demand and the metaclass FACTORY generates the CoW family
// (@hs-keyed leaf/branch + handle, package logos.gen). The STORE/SNAPSHOT
// half is the HAND-WRITTEN, shared MemoryStore / MemorySnapshot
// (logos.mem.bt.memstore) — a container is a typed view of `ctr_id` in a
// snapshot; one snapshot spans many containers and commits them atomically.
// main() drives snapshot ISOLATION across commits, size through the handle, and
// rc reclamation that frees shared structure exactly once (valgrind gate).
package test;

use logos.lcm.canon.container_item;   // the `container` lowering handler + the factory
use logos.lcm.canon.metaclass;        // create_ctr/open_ctr (ADR 0021 Phase 4b surface)
use logos.mem.pkd;                    // the generated leaf/branch target
use logos.mem.bt.map;                 // Ctr trait (the generated `impl Ctr` names it)
use logos.mem.bt.memstore;
use logos.mem.sync;                   // Arc — the store/snapshot plane            // MemoryStore, MemorySnapshot — the shared store
use logos.mem.string;
use logos.std.io;

// key:u64 + val:u64 → fast leaf → Canon versioning=cow → the CoW-Map typed half
// (cow nodes + cow_insert + the GenCow handle) is emitted from this one decl.
container GenCow {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure max(key);
}

const CTR: u64 = 1u64;   // this store holds a single container in slot 1

fn run_all() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();

    // ── version A: create container CTR, fill [0, N) through the Ctr handle ─
    let n: u64 = 8000u64;
    let mut s0: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    if s0.snapshot_id() != 1u64 { return 1i32; }
    let m0 = create_ctr::<typeof(GenCow)>(&s0, CTR);
    let mut k: u64 = 0u64;
    while k < n { m0.insert(k, k + 7u64); k = k + 1u64; }
    if m0.size() != n { return 2i32; }   // handle sees its snapshot's size
    s0.commit();

    // ── version B: branch from A, append [N, 2N) — CoW copies the path ───
    let mut s1: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    if s1.snapshot_id() != 2u64 { return 3i32; }
    let m1 = open_ctr::<typeof(GenCow)>(&s1, CTR);
    if m1.get_or(0u64, 0xFFFFu64) != 7u64 { return 4i32; }
    if m1.get_or(n - 1u64, 0xFFFFu64) != (n - 1u64) + 7u64 { return 5i32; }
    k = n;
    while k < 2u64 * n { m1.insert(k, k + 7u64); k = k + 1u64; }
    s1.commit();

    // ── ISOLATION: s0 (frozen) still sees ONLY [0, N); s1 sees [0, 2N) ───
    let m0b = open_ctr::<typeof(GenCow)>(&s0, CTR);
    if m0b.size() != n { return 6i32; }
    if m1.size() != 2u64 * n { return 7i32; }
    k = 0u64;
    while k < n {
        if m0b.get_or(k, 0xFFFFu64) != k + 7u64 { return 8i32; }
        k = k + 1u64;
    }
    if m0b.get_or(n, 0xDEADu64) != 0xDEADu64 { return 9i32; }         // s1's key, absent in s0
    if m0b.get_or(2u64 * n - 1u64, 0xDEADu64) != 0xDEADu64 { return 10i32; }
    k = 0u64;
    while k < 2u64 * n {
        if m1.get_or(k, 0xFFFFu64) != k + 7u64 { return 11i32; }
        k = k + 1u64;
    }

    // ── a third version overwrites a spread of keys in s1's lineage ──────
    let mut s2: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    let m2 = open_ctr::<typeof(GenCow)>(&s2, CTR);
    k = 0u64;
    while k < 2u64 * n { m2.insert(k, k + 1000000u64); k = k + 500u64; }
    s2.commit();
    let m2b = open_ctr::<typeof(GenCow)>(&s2, CTR);
    let m1b = open_ctr::<typeof(GenCow)>(&s1, CTR);
    if m2b.get_or(0u64, 0u64) != 1000000u64 { return 12i32; }
    if m1b.get_or(0u64, 0u64) != 7u64 { return 13i32; }              // s1 untouched
    if m2b.get_or(500u64, 0u64) != 500u64 + 1000000u64 { return 14i32; }
    if m1b.get_or(500u64, 0u64) != 500u64 + 7u64 { return 15i32; }
    if m2b.size() != 2u64 * n { return 16i32; }                       // overwrite, no growth

    // ── reclamation: drop every version + the store; rc frees shared nodes
    // exactly once (the real check is valgrind over this teardown).
    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap (256 & 0xFF == 0) and report
// SUCCESS. The status is a fixed non-zero byte; the code carries the detail.
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL gen_cow: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
