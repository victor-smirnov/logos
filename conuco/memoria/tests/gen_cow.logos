// gen_cow — Canon container_shape versioning, end to end (ADR 0020 Track B, ② I3):
// one `kind ordered_map` declaration → Canon derives the container_shape PLAN
// (leaf(fast) + branch + tree + cow + subtree_size) → the handler realizes the
// `aspect=versioning value=cow` row by GENERATING the whole CoW snapshot-versioned
// map stack: GenCowStore (Store), GenCowSnapshot (Snapshot), GenCow (Ctr), over
// the CoW-flavored generated GenCowLeaf / GenCowBranch (node header + cow_clone).
// One declaration is the whole source. main() mirrors the hand-written
// logos.mem.bt.map validation (cow_snapshot): snapshot ISOLATION across commits,
// the Ctr sees its snapshot's size, and rc reclamation frees shared structure
// exactly once (valgrind gate). This CLOSES ②: one decl → the whole CoW-Map stack.
package test;

use logos.lcm.canon.container_item;   // the `container` lowering handler
use logos.mem.pkd;                    // the generated leaf/branch target (PkdArray::format)
use logos.mem.bt.map;                 // the generated CoW-map impls Store/Snapshot/Ctr

// key:u64 + val:u64 → fast leaf → Canon versioning=cow → the whole CoW-Map stack
// (store/snapshot/ctr + CoW-flavored nodes) is emitted from this one declaration.
container GenCow for u8 { kind ordered_map; entry { key: u64, val: u64 } measure max(key); }

fn main() -> i32 {
    let mut store: GenCowStore = GenCowStore::new();

    // ── version A: fill [0, N) through the Ctr handle ────────────────────
    let n: u64 = 8000u64;
    let mut s0: GenCowSnapshot = store.snapshot();
    if s0.snapshot_id() != 1u64 { return 1i32; }
    let m0: GenCow = s0.map();           // open the container (Ctr) from the snapshot
    let mut k: u64 = 0u64;
    while k < n { m0.insert(k, k + 7u64); k = k + 1u64; }
    if m0.size() != n { return 2i32; }   // Ctr sees its snapshot's size
    store.commit(&s0);

    // ── version B: branch from A, append [N, 2N) — CoW copies the path ───
    let mut s1: GenCowSnapshot = store.snapshot();
    if s1.snapshot_id() != 2u64 { return 3i32; }
    if s1.get_or(0u64, 0xFFFFu64) != 7u64 { return 4i32; }
    if s1.get_or(n - 1u64, 0xFFFFu64) != (n - 1u64) + 7u64 { return 5i32; }
    let m1: GenCow = s1.map();
    k = n;
    while k < 2u64 * n { m1.insert(k, k + 7u64); k = k + 1u64; }
    store.commit(&s1);

    // ── ISOLATION: s0 (frozen) still sees ONLY [0, N); s1 sees [0, 2N) ───
    if s0.size() != n { return 6i32; }
    if s1.size() != 2u64 * n { return 7i32; }
    k = 0u64;
    while k < n {
        if s0.get_or(k, 0xFFFFu64) != k + 7u64 { return 8i32; }
        k = k + 1u64;
    }
    if s0.get_or(n, 0xDEADu64) != 0xDEADu64 { return 9i32; }         // s1's key, absent in s0
    if s0.get_or(2u64 * n - 1u64, 0xDEADu64) != 0xDEADu64 { return 10i32; }
    k = 0u64;
    while k < 2u64 * n {
        if s1.get_or(k, 0xFFFFu64) != k + 7u64 { return 11i32; }
        k = k + 1u64;
    }

    // ── a third version overwrites a spread of keys in s1's lineage ──────
    let mut s2: GenCowSnapshot = store.snapshot();
    let m2: GenCow = s2.map();
    k = 0u64;
    while k < 2u64 * n { m2.insert(k, k + 1000000u64); k = k + 500u64; }
    store.commit(&s2);
    if s2.get_or(0u64, 0u64) != 1000000u64 { return 12i32; }
    if s1.get_or(0u64, 0u64) != 7u64 { return 13i32; }              // s1 untouched
    if s2.get_or(500u64, 0u64) != 500u64 + 1000000u64 { return 14i32; }
    if s1.get_or(500u64, 0u64) != 500u64 + 7u64 { return 15i32; }
    if s2.size() != 2u64 * n { return 16i32; }                       // overwrite, no growth

    // ── reclamation: drop every version + the store; rc frees shared nodes
    // exactly once (the real check is valgrind over this teardown).
    s0.free();
    s1.free();
    s2.free();
    store.free();
    return 0i32;
}
