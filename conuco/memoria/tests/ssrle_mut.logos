// ssrle_mut — SSRLE increment-6 gate: two-phase mutations under
// estimate/update_fits + split_to/merge_from, with the index kept correct
// after EVERY mutation.
//
// C++ oracle map: prepare/commit_insert :713/:751, prepare/commit_remove
// :818/:848, split_to :896, prepare/commit_merge_with :946/:962 in
// packed_ssrle_seq_so.hpp; scenario shapes from the Misc suite
// (tests/reactor/tests/packed/sequence/ssrle/ssrleseq_misc_test.hpp:
// testInsert = sequential random inserts, testRemove = sequential random
// removes, testSplit = split at size/2 over doubling sizes, testMerge =
// concatenation — each followed by queries, exactly as here).
//
// Oracle discipline: a MATERIALIZED symbol-stream oracle is maintained
// through every mutation (syms_splice/syms_cut — fully independent of the
// run algebra); the packed stream must materialize to it after each op.
// Queries are then checked against the vector algebra over the freshly
// decoded runs (adopted as the next-step oracle only AFTER the stream
// equality passed). Index laws re-verified after every mutation.
//
// FIX-POLICY coverage (increment 6): the split {plen=1, rl>1} rl=0 guard
// and the insert fast-path budget check live in the run algebra
// (src/ssrle/ssrle.logos, gate: ssrle_algebra); here the packed layer is
// held to the stored-law: decoded streams never contain invalid or
// non-encodable runs, at any mutation step (150..).
//
// Sections (base + verify_state code, all < 256 for exit-code fidelity):
//   10..   sequential insert/insert_symbols driver (threshold-crossing)
//   30..   sequential remove driver (incl. remove-all)
//   50..   split_to/merge_from round trips: merge(split(x)) ≡ x
//   70..   Misc testInsert shape (doubling sizes, sequential inserts)
//   90..   Misc testRemove shape
//   110..  Misc testMerge shape (independent corpora concatenation)
//   130..  estimate/update_fits/OOM discipline (Err leaves state UNCHANGED)
//   150..  targeted fix-policy cases at the packed level (boundary split;
//          same-pattern max-rl insert verified by run arithmetic — sizes
//          too large to materialize)
package test;

use logos.mem.pkd.ssrle;
use logos.mem.pkd.sseq;
use logos.mem.pkd;
use logos.lang.arith;
use logos.lang.mem;
use logos.lang.result;
use logos.mem.collections.vec;

// ── deterministic corpus (LCG via wrapping arithmetic) ──────────────────────

fn rnd(st: &mut u64) -> u64 {
    let next: u64 = wrapping_add(wrapping_mul(*st, 6364136223846793005u64), 1442695040888963407u64);
    *st = next;
    return next >> 33u64;
}

fn rnd_pattern(st: &mut u64) -> u64 {
    return (rnd(st) << 31u64) | rnd(st);
}

fn rand_run(bps: u32, st: &mut u64, rl_cap: u64) -> SsrleRun {
    let cap: u64 = ssrle_encodable_pattern_length(bps) as u64;
    let plen: u64 = 1u64 + rnd(st) % cap;
    let mut mrl: u64 = ssrle_max_run_length(bps, plen as u32);
    if mrl > rl_cap {
        mrl = rl_cap;
    }
    let rl: u64 = 1u64 + rnd(st) % mrl;
    return ssrle_run_new(bps, plen as u32, rnd_pattern(st), rl);
}

fn rand_runs(bps: u32, st: &mut u64, n: i64, rl_cap: u64) -> Vec<SsrleRun> {
    let mut v: Vec<SsrleRun> = vec_new::<SsrleRun>();
    let mut i: i64 = 0i64;
    while i < n {
        v.push(rand_run(bps, st, rl_cap));
        i = i + 1i64;
    }
    return v;
}

fn runs_until_units(bps: u32, st: &mut u64, min_units: u64, rl_cap: u64) -> Vec<SsrleRun> {
    let mut v: Vec<SsrleRun> = vec_new::<SsrleRun>();
    let mut going: bool = true;
    while going {
        v.push(rand_run(bps, st, rl_cap));
        if ssrle_compute_size(bps, &v, 0u64) > min_units {
            going = false;
        }
    }
    return v;
}

// ── symbol-stream helpers (the independent oracle) ──────────────────────────

fn syms_eq(a: &Vec<u64>, b: &Vec<u64>) -> bool {
    if a.length() != b.length() {
        return false;
    }
    let n: i64 = a.length();
    let mut i: i64 = 0i64;
    while i < n {
        if a.get(i) != b.get(i) {
            return false;
        }
        i = i + 1i64;
    }
    return true;
}

fn syms_splice(base: &Vec<u64>, at: u64, ins: &Vec<u64>) -> Vec<u64> {
    let mut v: Vec<u64> = vec_new::<u64>();
    let mut i: i64 = 0i64;
    while i < at as i64 {
        v.push(base.get(i));
        i = i + 1i64;
    }
    let mut j: i64 = 0i64;
    while j < ins.length() {
        v.push(ins.get(j));
        j = j + 1i64;
    }
    i = at as i64;
    while i < base.length() {
        v.push(base.get(i));
        i = i + 1i64;
    }
    return v;
}

fn syms_cut(base: &Vec<u64>, from: u64, to: u64) -> Vec<u64> {
    let mut v: Vec<u64> = vec_new::<u64>();
    let mut i: i64 = 0i64;
    while i < base.length() {
        if i < from as i64 || i >= to as i64 {
            v.push(base.get(i));
        }
        i = i + 1i64;
    }
    return v;
}

fn syms_slice_of(base: &Vec<u64>, from: u64, to: u64) -> Vec<u64> {
    let mut v: Vec<u64> = vec_new::<u64>();
    let mut i: i64 = from as i64;
    while i < to as i64 {
        v.push(base.get(i));
        i = i + 1i64;
    }
    return v;
}

fn oracle_access(bps: u32, runs: &Vec<SsrleRun>, pos: u64) -> u64 {
    let res: SsrleFindRun = ssrle_find_run(runs, pos);
    let run: &SsrleRun = runs.borrow(res.run_idx);
    return run.symbol(bps, res.local_offset);
}

fn test_symbols(bps: u32, st: &mut u64) -> Vec<u64> {
    let alpha: u64 = 1u64 << (bps as u64);
    let mut syms: Vec<u64> = vec_new::<u64>();
    if bps <= 2u32 {
        let mut s: u64 = 0u64;
        while s < alpha {
            syms.push(s);
            s = s + 1u64;
        }
    } else {
        syms.push(0u64);
        syms.push(alpha - 1u64);
        syms.push(rnd(st) % alpha);
    }
    return syms;
}

// ── the post-mutation state check (no materialization inside) ───────────────
//
// `expect` must be the freshly decoded run vector (or provably equivalent):
// metadata, index laws, stored-run laws, and sampled query parity vs the
// vector algebra. Returns 0 or a code 1..11 (caller adds the section base).

fn verify_state(seq: &PkdSsrle, expect: &Vec<SsrleRun>, st: &mut u64, extra: i64) -> i32 {
    let bps: u32 = seq.bps();
    let size: u64 = ssrle_count_symbols(expect);
    if seq.size() != size {
        return 1i32;
    }
    let nunits: u64 = ssrle_compute_size(bps, expect, 0u64);
    if seq.code_units() != nunits {
        return 2i32;
    }
    // index laws
    if seq.has_index() != seq.needs_index() {
        return 3i32;
    }
    if seq.index_blocks() != pkd_ssrle_index_blocks(bps, nunits) {
        return 4i32;
    }
    let blocks: u64 = seq.index_blocks();
    let mut b: u64 = 0u64;
    let mut size_total: u64 = 0u64;
    while b < blocks {
        size_total = size_total + seq.index_size_at(b);
        b = b + 1u64;
    }
    if seq.has_index() && size_total != size {
        return 5i32;
    }
    // stored-run law (fix policy): every decoded run valid + encodable.
    // (binding named rv, NOT r: a later sibling scope binds `r: u64`, and
    // same-named locals of DIFFERENT types in one function miscompile —
    // mlir-gen resolves the later use to the wrong slot; compiler-gap
    // probe in the increment-6 report)
    let mut k: i64 = 0i64;
    while k < expect.length() {
        let rv: &SsrleRun = expect.borrow(k);
        if !rv.is_valid() {
            return 6i32;
        }
        if !ssrle_is_fit(bps, rv.pattern_length as u64, rv.run_length) {
            return 7i32;
        }
        if rv.pattern_length > ssrle_encodable_pattern_length(bps) {
            return 7i32;
        }
        k = k + 1i64;
    }
    // sampled positions: access + rank parity
    let mut positions: Vec<u64> = vec_new::<u64>();
    positions.push(0u64);
    positions.push(size);
    if size > 0u64 {
        positions.push(1u64);
        positions.push(size / 2u64);
        positions.push(size - 1u64);
    }
    let mut i: i64 = 0i64;
    while i < extra {
        positions.push(rnd(st) % (size + 1u64));
        i = i + 1i64;
    }
    let syms: Vec<u64> = test_symbols(bps, st);
    let mut pi: i64 = 0i64;
    while pi < positions.length() {
        let p: u64 = positions.get(pi);
        if p < size {
            if seq.access(p) != oracle_access(bps, expect, p) {
                return 8i32;
            }
        }
        let mut si: i64 = 0i64;
        while si < syms.length() {
            let sym: u64 = syms.get(si);
            if seq.rank_eq(p, sym) != ssrle_rank_eq(bps, expect, p, sym) {
                return 9i32;
            }
            si = si + 1i64;
        }
        pi = pi + 1i64;
    }
    // sampled selects + not-found law
    let mut si: i64 = 0i64;
    while si < syms.length() {
        let sym: u64 = syms.get(si);
        let total: u64 = ssrle_rank_eq(bps, expect, size, sym);
        let mut ranks: Vec<u64> = vec_new::<u64>();
        ranks.push(0u64);
        if total > 0u64 {
            ranks.push(total / 2u64);
            ranks.push(total - 1u64);
        }
        i = 0i64;
        while i < extra {
            ranks.push(rnd(st) % (total + 2u64));
            i = i + 1i64;
        }
        let mut ri: i64 = 0i64;
        while ri < ranks.length() {
            let r: u64 = ranks.get(ri);
            let got: SsrleSelect = seq.select_fw_eq(r, sym);
            if got.idx != ssrle_select_fw_eq(bps, expect, r, sym) {
                return 10i32;
            }
            ri = ri + 1i64;
        }
        let nf: SsrleSelect = seq.select_fw_eq(total + 1u64, sym);
        if nf.idx != size || nf.rank != total {
            return 11i32;
        }
        si = si + 1i64;
    }
    return 0i32;
}

// Packed stream materializes to the oracle stream, then full state check.
fn verify_against_stream(seq: &PkdSsrle, oracle: &Vec<u64>, st: &mut u64, extra: i64) -> i32 {
    let decoded: Vec<SsrleRun> = seq.as_runs();
    let got: Vec<u64> = ssrle_materialize(seq.bps(), &decoded);
    if !syms_eq(&got, oracle) {
        return 12i32;
    }
    return verify_state(seq, &decoded, st, extra);
}

// ── 10.. / 30..: sequential insert + remove drivers ─────────────────────────

fn driver_insert_remove(bps: u32, st: &mut u64) -> i32 {
    let alphabet: u32 = 1u32 << bps;
    let apb: u64 = ssrle_atoms_per_block(bps);
    // threshold-crossing corpus with a modest symbol count (short runs)
    let initial: Vec<SsrleRun> = runs_until_units(bps, st, apb, 2u64);
    let nunits: u64 = ssrle_compute_size(bps, &initial, 0u64);
    // generous block: initial + inserts, all growth priced in
    let block_size: u32 = pkd_ssrle_block_size(alphabet, nunits * 4u64 + 512u64);
    unsafe {
        let mem: *mut u8 = alloc(block_size as i64);
        let mut seq: PkdSsrle = match pkd_ssrle_create(mem, block_size, alphabet, &initial) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 13i32;
            }
        };
        let mut oracle: Vec<u64> = ssrle_materialize(bps, &initial);
        let mut rc: i32 = 0i32;
        // inserts at 0, mid, end, then random positions
        let mut step: i64 = 0i64;
        while rc == 0i32 && step < 6i64 {
            let size: u64 = oracle.length() as u64;
            let mut pos: u64 = rnd(st) % (size + 1u64);
            if step == 0i64 {
                pos = 0u64;
            }
            if step == 1i64 {
                pos = size / 2u64;
            }
            if step == 2i64 {
                pos = size;
            }
            let src: Vec<SsrleRun> = rand_runs(bps, st, 4i64, 3u64);
            let src_syms: Vec<u64> = ssrle_materialize(bps, &src);
            match seq.insert_runs(pos, &src) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    rc = 14i32;
                }
            }
            if rc == 0i32 {
                let next: Vec<u64> = syms_splice(&oracle, pos, &src_syms);
                oracle = next;
                rc = verify_against_stream(&seq, &oracle, st, 6i64);
            }
            step = step + 1i64;
        }
        // insert_symbols: a literal same-symbol burst + a mixed burst
        if rc == 0i32 {
            let size: u64 = oracle.length() as u64;
            let pos: u64 = size / 3u64;
            let mut burst: Vec<u64> = vec_new::<u64>();
            let symv: u64 = rnd(st) % (1u64 << (bps as u64));
            let mut i: i64 = 0i64;
            while i < 40i64 {
                burst.push(symv);
                i = i + 1i64;
            }
            burst.push((symv + 1u64) % (1u64 << (bps as u64)));
            match seq.insert_symbols(pos, &burst) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    rc = 15i32;
                }
            }
            if rc == 0i32 {
                let next: Vec<u64> = syms_splice(&oracle, pos, &burst);
                oracle = next;
                rc = verify_against_stream(&seq, &oracle, st, 6i64);
            }
        }
        if rc != 0i32 {
            dealloc(mem);
            return rc;
        }
        // 30.. removes: edges then random ranges, then remove-all
        let mut rstep: i64 = 0i64;
        while rc == 0i32 && rstep < 5i64 {
            let size: u64 = oracle.length() as u64;
            let mut start: u64 = rnd(st) % (size + 1u64);
            let mut end: u64 = start + rnd(st) % (size - start + 1u64);
            if rstep == 0i64 {
                start = 0u64;
                end = size / 8u64;
            }
            if rstep == 1i64 {
                start = size - size / 8u64;
                end = size;
            }
            match seq.remove(start, end) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    rc = 30i32;
                }
            }
            if rc == 0i32 {
                let next: Vec<u64> = syms_cut(&oracle, start, end);
                oracle = next;
                rc = verify_against_stream(&seq, &oracle, st, 6i64);
                if rc != 0i32 {
                    rc = rc + 30i32;
                }
            }
            rstep = rstep + 1i64;
        }
        // remove-all → canonical empty, index gone
        if rc == 0i32 {
            let size: u64 = oracle.length() as u64;
            match seq.remove(0u64, size) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    rc = 44i32;
                }
            }
            if rc == 0i32 && (seq.size() != 0u64 || seq.code_units() != 0u64 || seq.has_index()) {
                rc = 45i32;
            }
        }
        dealloc(mem);
        return rc;
    }
}

// ── 50..: split_to / merge_from round trips ─────────────────────────────────

fn driver_split_merge(bps: u32, st: &mut u64, big: bool) -> i32 {
    let alphabet: u32 = 1u32 << bps;
    let apb: u64 = ssrle_atoms_per_block(bps);
    let mut target_units: u64 = apb / 2u64;
    if big {
        target_units = apb * 3u64;
    }
    let runs: Vec<SsrleRun> = runs_until_units(bps, st, target_units, 3u64);
    let stream: Vec<u64> = ssrle_materialize(bps, &runs);
    let size: u64 = stream.length() as u64;
    let nunits: u64 = ssrle_compute_size(bps, &runs, 0u64);
    let block_size: u32 = pkd_ssrle_block_size(alphabet, nunits * 2u64 + 64u64);
    let mut cuts: Vec<u64> = vec_new::<u64>();
    cuts.push(0u64);
    cuts.push(1u64);
    cuts.push(size / 3u64);
    cuts.push(size / 2u64);
    cuts.push(size - 1u64);
    cuts.push(size);
    let mut ci: i64 = 0i64;
    while ci < cuts.length() {
        let cut: u64 = cuts.get(ci);
        unsafe {
            let mem_l: *mut u8 = alloc(block_size as i64);
            let mem_r: *mut u8 = alloc(block_size as i64);
            let mut left: PkdSsrle = match pkd_ssrle_create(mem_l, block_size, alphabet, &runs) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem_l);
                    dealloc(mem_r);
                    return 50i32;
                }
            };
            let mut right: PkdSsrle = match pkd_ssrle_format(mem_r, block_size, alphabet) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem_l);
                    dealloc(mem_r);
                    return 51i32;
                }
            };
            let mut rc: i32 = 0i32;
            match left.split_to(&mut right, cut) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    rc = 52i32;
                }
            }
            if rc == 0i32 {
                let expect_l: Vec<u64> = syms_slice_of(&stream, 0u64, cut);
                let expect_r: Vec<u64> = syms_slice_of(&stream, cut, size);
                rc = verify_against_stream(&left, &expect_l, st, 4i64);
                if rc == 0i32 && cut < size {
                    let rr: i32 = verify_against_stream(&right, &expect_r, st, 4i64);
                    if rr != 0i32 {
                        rc = rr + 12i32;
                    }
                }
                // merge back: merge(split(x)) ≡ x — the full original stream
                // (cut == size: split_to no-opped and right stayed empty, the
                // identity still holds)
                if rc == 0i32 {
                    match left.merge_from(&right) {
                        Result::Ok(_) => {}
                        Result::Err(_) => {
                            rc = 53i32;
                        }
                    }
                }
                if rc == 0i32 {
                    let rr2: i32 = verify_against_stream(&left, &stream, st, 4i64);
                    if rr2 != 0i32 {
                        rc = rr2 + 24i32;
                    }
                }
            }
            dealloc(mem_l);
            dealloc(mem_r);
            if rc != 0i32 {
                return rc + 50i32;
            }
        }
        ci = ci + 1i64;
    }
    return 0i32;
}

// ── 70.. / 90..: the C++ Misc suite shapes ──────────────────────────────────

fn misc_insert_shape(bps: u32, st: &mut u64, data_size: i64) -> i32 {
    let alphabet: u32 = 1u32 << bps;
    let syms_runs: Vec<SsrleRun> = rand_runs(bps, st, data_size, 10u64);
    let nunits: u64 = ssrle_compute_size(bps, &syms_runs, 0u64);
    let times: i64 = 4i64;
    // per-insert source bound: data_size/8+1 runs, ≤4 units each + segment
    // padding fringe — priced generously (an Err here would be a test bug)
    let src_units_bound: u64 = ((data_size as u64) / 8u64 + 1u64) * 6u64 + 32u64;
    let block_size: u32 = pkd_ssrle_block_size(
        alphabet, nunits + (times as u64) * src_units_bound + 128u64);
    unsafe {
        let mem: *mut u8 = alloc(block_size as i64);
        let mut seq: PkdSsrle = match pkd_ssrle_create(mem, block_size, alphabet, &syms_runs) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 70i32;
            }
        };
        let mut oracle: Vec<u64> = ssrle_materialize(bps, &syms_runs);
        let mut rc: i32 = 0i32;
        let mut cc: i64 = 0i64;
        while rc == 0i32 && cc < times {
            let src: Vec<SsrleRun> = rand_runs(bps, st, data_size / 8i64 + 1i64, 10u64);
            let src_syms: Vec<u64> = ssrle_materialize(bps, &src);
            let pos: u64 = rnd(st) % ((oracle.length() as u64) + 1u64);
            match seq.insert_runs(pos, &src) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    rc = 71i32;
                }
            }
            if rc == 0i32 {
                oracle = syms_splice(&oracle, pos, &src_syms);
                let rr: i32 = verify_against_stream(&seq, &oracle, st, 8i64);
                if rr != 0i32 {
                    rc = rr + 72i32;
                }
            }
            cc = cc + 1i64;
        }
        dealloc(mem);
        return rc;
    }
}

fn misc_remove_shape(bps: u32, st: &mut u64, data_size: i64) -> i32 {
    let alphabet: u32 = 1u32 << bps;
    let syms_runs: Vec<SsrleRun> = rand_runs(bps, st, data_size, 10u64);
    let nunits: u64 = ssrle_compute_size(bps, &syms_runs, 0u64);
    // removes can transiently GROW the stream by the cut fringe
    let block_size: u32 = pkd_ssrle_block_size(alphabet, nunits + 128u64);
    unsafe {
        let mem: *mut u8 = alloc(block_size as i64);
        let mut seq: PkdSsrle = match pkd_ssrle_create(mem, block_size, alphabet, &syms_runs) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 90i32;
            }
        };
        let mut oracle: Vec<u64> = ssrle_materialize(bps, &syms_runs);
        let mut rc: i32 = 0i32;
        let mut cc: i64 = 0i64;
        while rc == 0i32 && cc < 6i64 {
            let size: u64 = oracle.length() as u64;
            let start: u64 = rnd(st) % (size + 1u64);
            let end: u64 = start + rnd(st) % (size - start + 1u64);
            match seq.remove(start, end) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    rc = 91i32;
                }
            }
            if rc == 0i32 {
                oracle = syms_cut(&oracle, start, end);
                let rr: i32 = verify_against_stream(&seq, &oracle, st, 8i64);
                if rr != 0i32 {
                    rc = rr + 92i32;
                }
            }
            cc = cc + 1i64;
        }
        dealloc(mem);
        return rc;
    }
}

// 110..: testMerge shape — two independent corpora, concatenation into self.
fn misc_merge_shape(bps: u32, st: &mut u64, data_size: i64) -> i32 {
    let alphabet: u32 = 1u32 << bps;
    let runs1: Vec<SsrleRun> = rand_runs(bps, st, data_size, 10u64);
    let runs2: Vec<SsrleRun> = rand_runs(bps, st, data_size, 10u64);
    let units1: u64 = ssrle_compute_size(bps, &runs1, 0u64);
    let units2: u64 = ssrle_compute_size(bps, &runs2, 0u64);
    let bs1: u32 = pkd_ssrle_block_size(alphabet, units1 + units2 + 64u64);
    let bs2: u32 = pkd_ssrle_block_size(alphabet, units2 + 8u64);
    unsafe {
        let mem1: *mut u8 = alloc(bs1 as i64);
        let mem2: *mut u8 = alloc(bs2 as i64);
        let mut a: PkdSsrle = match pkd_ssrle_create(mem1, bs1, alphabet, &runs1) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem1);
                dealloc(mem2);
                return 110i32;
            }
        };
        let b: PkdSsrle = match pkd_ssrle_create(mem2, bs2, alphabet, &runs2) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem1);
                dealloc(mem2);
                return 111i32;
            }
        };
        let mut rc: i32 = 0i32;
        // the estimate composes with the fit probe
        let est: u32 = a.estimate_merge(&b);
        let us: SsrleUpdate = a.plan_merge(&b);
        if est != us.block_size {
            rc = 112i32;
        }
        if rc == 0i32 && !a.update_fits(&us) {
            rc = 113i32;
        }
        if rc == 0i32 {
            match a.merge_from(&b) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    rc = 114i32;
                }
            }
        }
        if rc == 0i32 {
            let s1: Vec<u64> = ssrle_materialize(bps, &runs1);
            let s2: Vec<u64> = ssrle_materialize(bps, &runs2);
            let mut whole: Vec<u64> = vec_new::<u64>();
            let mut j: i64 = 0i64;
            while j < s1.length() {
                whole.push(s1.get(j));
                j = j + 1i64;
            }
            j = 0i64;
            while j < s2.length() {
                whole.push(s2.get(j));
                j = j + 1i64;
            }
            let rr: i32 = verify_against_stream(&a, &whole, st, 8i64);
            if rr != 0i32 {
                rc = rr + 115i32;
            }
            // b unchanged by merge_from
            if rc == 0i32 && b.size() != s2.length() as u64 {
                rc = 128i32;
            }
        }
        dealloc(mem1);
        dealloc(mem2);
        return rc;
    }
}

// ── 130..: estimate / update_fits / OOM discipline ──────────────────────────

fn check_oom_discipline(st: &mut u64) -> i32 {
    let bps: u32 = 3u32;
    let alphabet: u32 = 8u32;
    let initial: Vec<SsrleRun> = rand_runs(bps, st, 24i64, 4u64);
    let nunits: u64 = ssrle_compute_size(bps, &initial, 0u64);
    // exact fit: no headroom beyond the current stream
    let block_size: u32 = pkd_ssrle_block_size(alphabet, nunits);
    unsafe {
        let mem: *mut u8 = alloc(block_size as i64);
        let mut seq: PkdSsrle = match pkd_ssrle_create(mem, block_size, alphabet, &initial) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 130i32;
            }
        };
        let before: Vec<u64> = ssrle_materialize(bps, &initial);
        let mut rc: i32 = 0i32;
        // a large insert cannot fit — Err, and the sequence is UNCHANGED
        let mid: u64 = (before.length() as u64) / 2u64;
        let src: Vec<SsrleRun> = rand_runs(bps, st, 64i64, 6u64);
        let us: SsrleUpdate = seq.plan_insert(mid, &src);
        if us.block_size <= block_size {
            rc = 131i32;   // corpus too small to overflow — test bug
        }
        if rc == 0i32 && seq.update_fits(&us) {
            rc = 132i32;
        }
        if rc == 0i32 {
            match seq.insert_runs(mid, &src) {
                Result::Ok(_) => {
                    rc = 133i32;
                }
                Result::Err(_) => {}
            }
        }
        if rc == 0i32 {
            let rr: i32 = verify_against_stream(&seq, &before, st, 4i64);
            if rr != 0i32 {
                rc = rr + 134i32;
            }
        }
        // estimate_insert agrees with the plan pricing
        if rc == 0i32 {
            let est: u32 = seq.estimate_insert(mid, &src);
            if est != us.block_size {
                rc = 146i32;
            }
        }
        // a no-op remove succeeds even on the exact-fit block
        if rc == 0i32 {
            match seq.remove(3u64, 3u64) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    rc = 147i32;
                }
            }
        }
        dealloc(mem);
        return rc;
    }
}

// ── 150..: targeted fix-policy cases at the packed level ────────────────────

fn check_targeted_fixes(st: &mut u64) -> i32 {
    // (a) boundary split of a {plen=1, rl>1} run: at=0 leaves a valid EMPTY
    // left and the whole run right — no invalid run anywhere (the C++ bug
    // emitted {plen=1, rl=0} into the splice vectors).
    let bps: u32 = 2u32;
    let alphabet: u32 = 4u32;
    let pat: u64 = 3u64;
    let mut runs: Vec<SsrleRun> = vec_new::<SsrleRun>();
    runs.push(ssrle_run_new(bps, 1u32, pat, 200u64));
    let nunits: u64 = ssrle_compute_size(bps, &runs, 0u64);
    let block_size: u32 = pkd_ssrle_block_size(alphabet, nunits + 64u64);
    unsafe {
        let mem_l: *mut u8 = alloc(block_size as i64);
        let mem_r: *mut u8 = alloc(block_size as i64);
        let mut rc: i32 = 0i32;
        let mut left: PkdSsrle = match pkd_ssrle_create(mem_l, block_size, alphabet, &runs) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem_l);
                dealloc(mem_r);
                return 150i32;
            }
        };
        let mut right: PkdSsrle = match pkd_ssrle_format(mem_r, block_size, alphabet) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem_l);
                dealloc(mem_r);
                return 151i32;
            }
        };
        match left.split_to(&mut right, 0u64) {
            Result::Ok(_) => {}
            Result::Err(_) => {
                rc = 152i32;
            }
        }
        if rc == 0i32 {
            if left.size() != 0u64 || left.code_units() != 0u64 {
                rc = 153i32;
            }
            if rc == 0i32 && (right.size() != 200u64 || right.rank_eq_all(pat) != 200u64) {
                rc = 154i32;
            }
            if rc == 0i32 {
                let lr: Vec<SsrleRun> = left.as_runs();
                if lr.length() != 0i64 {
                    rc = 155i32;
                }
            }
            if rc == 0i32 {
                match left.merge_from(&right) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        rc = 156i32;
                    }
                }
            }
            if rc == 0i32 && (left.size() != 200u64 || left.rank_eq_all(pat) != 200u64) {
                rc = 157i32;
            }
        }
        dealloc(mem_l);
        dealloc(mem_r);
        if rc != 0i32 {
            return rc;
        }
    }
    // (b) same-pattern insert at the rl budget edge, verified by RUN
    // ARITHMETIC (2·max_run_length symbols — far beyond materialization):
    // after the budget-check fix, the stored runs are all encodable and the
    // totals come out exact.
    let bps2: u32 = 1u32;
    let alphabet2: u32 = 2u32;
    let mrl: u64 = ssrle_max_run_length(bps2, 1u32);
    let mut runs2: Vec<SsrleRun> = vec_new::<SsrleRun>();
    runs2.push(ssrle_run_new(bps2, 1u32, 1u64, mrl));
    let nunits2: u64 = ssrle_compute_size(bps2, &runs2, 0u64);
    let block_size2: u32 = pkd_ssrle_block_size(alphabet2, nunits2 + 64u64);
    unsafe {
        let mem: *mut u8 = alloc(block_size2 as i64);
        let mut rc: i32 = 0i32;
        let mut seq: PkdSsrle = match pkd_ssrle_create(mem, block_size2, alphabet2, &runs2) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 158i32;
            }
        };
        match seq.insert_runs(mrl / 2u64, &runs2) {
            Result::Ok(_) => {}
            Result::Err(_) => {
                rc = 159i32;
            }
        }
        if rc == 0i32 {
            if seq.size() != 2u64 * mrl {
                rc = 160i32;
            }
            if rc == 0i32 && seq.rank_eq_all(1u64) != 2u64 * mrl {
                rc = 161i32;
            }
            if rc == 0i32 && seq.rank_eq_all(0u64) != 0u64 {
                rc = 162i32;
            }
            if rc == 0i32 {
                let sel: SsrleSelect = seq.select_fw_eq(2u64 * mrl - 1u64, 1u64);
                if sel.idx != 2u64 * mrl - 1u64 {
                    rc = 163i32;
                }
            }
            if rc == 0i32 {
                // stored-run law: every decoded run encodable (the C++ fast
                // path would have stored one over-budget run here)
                let dr: Vec<SsrleRun> = seq.as_runs();
                let mut k: i64 = 0i64;
                while rc == 0i32 && k < dr.length() {
                    let r: &SsrleRun = dr.borrow(k);
                    if !r.is_valid()
                        || !ssrle_is_fit(bps2, r.pattern_length as u64, r.run_length) {
                        rc = 164i32;
                    }
                    k = k + 1i64;
                }
            }
        }
        dealloc(mem);
        return rc;
    }
}

// ── main ────────────────────────────────────────────────────────────────────

fn main() -> i32 {
    let mut st: u64 = 0x6a11ed5eed6a11edu64;
    let mut bps: u32 = 1u32;
    while bps <= 8u32 {
        let rc1: i32 = driver_insert_remove(bps, &mut st);
        if rc1 != 0i32 {
            return rc1;
        }
        let rc2: i32 = driver_split_merge(bps, &mut st, false);
        if rc2 != 0i32 {
            return rc2;
        }
        bps = bps + 1u32;
    }
    // threshold-deep split/merge for two representative Bps
    let rc3: i32 = driver_split_merge(2u32, &mut st, true);
    if rc3 != 0i32 {
        return rc3;
    }
    let rc4: i32 = driver_split_merge(8u32, &mut st, true);
    if rc4 != 0i32 {
        return rc4;
    }
    // the C++ Misc-suite shapes over doubling sizes
    let mut data_size: i64 = 8i64;
    while data_size <= 2048i64 {
        let rc5: i32 = misc_insert_shape(2u32, &mut st, data_size);
        if rc5 != 0i32 {
            return rc5;
        }
        let rc6: i32 = misc_remove_shape(2u32, &mut st, data_size);
        if rc6 != 0i32 {
            return rc6;
        }
        let rc7: i32 = misc_merge_shape(2u32, &mut st, data_size);
        if rc7 != 0i32 {
            return rc7;
        }
        data_size = data_size * 4i64;
    }
    let rc8: i32 = misc_insert_shape(8u32, &mut st, 512i64);
    if rc8 != 0i32 {
        return rc8;
    }
    let rc9: i32 = misc_remove_shape(8u32, &mut st, 512i64);
    if rc9 != 0i32 {
        return rc9;
    }
    let rc10: i32 = check_oom_discipline(&mut st);
    if rc10 != 0i32 {
        return rc10;
    }
    let rc11: i32 = check_targeted_fixes(&mut st);
    if rc11 != 0i32 {
        return rc11;
    }
    return 0i32;
}
