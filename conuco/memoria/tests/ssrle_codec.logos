// ssrle_codec — SSRLE increment-1 oracle gate: the memoria.ssrle run codec +
// segment writer against the C++ Memoria encoder, BYTE-IDENTICALLY.
//
// tests/ssrle_fixtures.hex is generated by oracle/ssrle_dump.cpp from the
// REAL C++ headers (~/cxx/memoria): a deterministic corpus over Bps 1..8 of
// run triples {plen, pattern, rl} plus the exact u16 unit streams C++
// write_segments_to produced. For every case this test asserts:
//
//   1. ssrle_compute_size == the C++ unit count (the size-oracle pair);
//   2. ssrle_write_segments emits the IDENTICAL unit values (byte identity —
//      stream-equivalence would mask codec bit-budget bugs: two different
//      encodings can express one symbol stream);
//   3. decode(encode(runs)) == runs, run for run (as_vector semantics:
//      padding skipped, null terminates);
//   4. the writer's return value == compute_size for the same input.
//
// Plus oracle-free edge checks: run_length_bitsize/make_mask edges and the
// is_fit/max_run_length budget laws per bps. Runs with cwd = the package
// root (lforge test), so the fixture path is relative.
package test;

use memoria.ssrle;
use logos.lang.result;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.std.io.fs;

// ── fixture tokenizer: whitespace-separated lowercase hex, 0-sentinel ───────

fn is_ws(b: u8) -> bool {
    return b == 32u8 || b == 10u8 || b == 13u8 || b == 9u8;
}

fn hex_val(b: u8) -> u64 {
    if b >= 48u8 && b <= 57u8 {
        return (b - 48u8) as u64;
    }
    return ((b - 97u8) as u64) + 10u64;
}

fn next_tok(s: str, pos: &mut i64) -> u64 {
    let n: i64 = s.len();
    let mut i: i64 = *pos;
    while i < n && is_ws(s[i]) {
        i = i + 1i64;
    }
    let mut v: u64 = 0u64;
    while i < n && !is_ws(s[i]) {
        v = v * 16u64 + hex_val(s[i]);
        i = i + 1i64;
    }
    *pos = i;
    return v;
}

// ── oracle-free edge checks ─────────────────────────────────────────────────

fn edge_checks() -> i32 {
    // run_length_bitsize: 0 bits for rl <= 1, Log2U above
    if ssrle_run_length_bitsize(0u64) != 0u64 {
        return 60i32;
    }
    if ssrle_run_length_bitsize(1u64) != 0u64 {
        return 61i32;
    }
    if ssrle_run_length_bitsize(2u64) != 2u64 {
        return 62i32;
    }
    if ssrle_run_length_bitsize(3u64) != 2u64 {
        return 63i32;
    }
    if ssrle_run_length_bitsize(4u64) != 3u64 {
        return 64i32;
    }
    // make_mask: the >=64 guard and the zero edge
    if ssrle_make_mask(64u64) != 0xFFFFFFFFFFFFFFFFu64 {
        return 65i32;
    }
    if ssrle_make_mask(70u64) != 0xFFFFFFFFFFFFFFFFu64 {
        return 66i32;
    }
    if ssrle_make_mask(0u64) != 0u64 {
        return 67i32;
    }
    // per-bps budget laws
    let mut bps: u32 = 1u32;
    while bps <= 8u32 {
        let mpl: u32 = ssrle_max_pattern_length(bps);
        if !ssrle_is_fit(bps, mpl as u64, 1u64) {
            return 68i32;
        }
        if ssrle_is_fit(bps, (mpl as u64) + 1u64, 1u64) {
            return 69i32;
        }
        // max_run_length is exactly the budget edge for plen in {1, mpl}
        let mrl1: u64 = ssrle_max_run_length(bps, 1u32);
        if !ssrle_is_fit(bps, 1u64, mrl1) {
            return 70i32;
        }
        if ssrle_is_fit(bps, 1u64, mrl1 + 1u64) {
            return 71i32;
        }
        let mrlp: u64 = ssrle_max_run_length(bps, mpl);
        if !ssrle_is_fit(bps, mpl as u64, mrlp) {
            return 72i32;
        }
        if ssrle_is_fit(bps, mpl as u64, mrlp + 1u64) {
            return 73i32;
        }
        // rl=1 costs zero bits: a 1-symbol run is always one unit
        let one: SsrleRun = ssrle_run_new(bps, 1u32, 1u64, 1u64);
        if ssrle_estimate_size(bps, &one) != 1u64 {
            return 74i32;
        }
        bps = bps + 1u32;
    }
    return 0i32;
}

// ── one oracle case ─────────────────────────────────────────────────────────

fn check_case(bps: u32, runs: &Vec<SsrleRun>, nunits: u64, s: str, pos: &mut i64) -> i32 {
    // 1. the size oracle
    let computed: u64 = ssrle_compute_size(bps, runs, 0u64);
    if computed != nunits {
        return 10i32;
    }
    // 2. write + byte identity vs the C++ unit stream
    let mut target: Vec<u16> = vec_new::<u16>();
    let mut j: u64 = 0u64;
    while j < nunits {
        target.push(0u16);
        j = j + 1u64;
    }
    let written: u64 = ssrle_write_segments(bps, runs, &mut target, 0u64);
    if written != nunits {
        return 11i32;
    }
    let mut u: u64 = 0u64;
    while u < nunits {
        let expected: u64 = next_tok(s, pos);
        if (target.get(u as i64) as u64) != expected {
            return 12i32;
        }
        u = u + 1u64;
    }
    // 3. decode roundtrip (padding skipped, null terminates)
    let decoded: Vec<SsrleRun> = ssrle_decode_runs(bps, &target, written);
    if decoded.length() != runs.length() {
        return 13i32;
    }
    let mut k: i64 = 0i64;
    while k < runs.length() {
        let d: &SsrleRun = decoded.borrow(k);
        if !d.eq(runs.borrow(k)) {
            return 14i32;
        }
        k = k + 1i64;
    }
    // 4. every corpus run respects the codec budget
    k = 0i64;
    while k < runs.length() {
        let r: &SsrleRun = runs.borrow(k);
        if !ssrle_is_fit(bps, r.pattern_length as u64, r.run_length) {
            return 15i32;
        }
        k = k + 1i64;
    }
    return 0i32;
}

fn main() -> i32 {
    let rc0: i32 = edge_checks();
    if rc0 != 0i32 {
        return rc0;
    }

    let content: String = match read_to_string("tests/ssrle_fixtures.hex") {
        Result::Ok(c) => { c }
        Result::Err(_) => { return 100i32; }
    };
    let s: str = content.as_str();
    let mut pos: i64 = 0i64;
    let mut cases: i64 = 0i64;
    let mut going: bool = true;
    while going {
        let bps64: u64 = next_tok(s, &mut pos);
        if bps64 == 0u64 {
            going = false;
        } else {
            let bps: u32 = bps64 as u32;
            let nruns: i64 = next_tok(s, &mut pos) as i64;
            let nunits: u64 = next_tok(s, &mut pos);
            let mut runs: Vec<SsrleRun> = vec_new::<SsrleRun>();
            let mut i: i64 = 0i64;
            while i < nruns {
                let plen: u64 = next_tok(s, &mut pos);
                let pattern: u64 = next_tok(s, &mut pos);
                let rl: u64 = next_tok(s, &mut pos);
                runs.push(ssrle_run_new(bps, plen as u32, pattern, rl));
                i = i + 1i64;
            }
            let rc: i32 = check_case(bps, &runs, nunits, s, &mut pos);
            if rc != 0i32 {
                return rc;
            }
            cases = cases + 1i64;
        }
    }
    // all 8 bps arrived (8 x ~58 cases); a truncated fixture must not pass
    if cases < 400i64 {
        return 20i32;
    }
    return 0i32;
}
