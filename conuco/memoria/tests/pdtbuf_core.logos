// pdtbuf_core — PdtBuf ladder rung P0 gate: the runtime core of the Logos
// equivalent of C++ PackedDataTypeBuffer (logos.mem.pkd.pdtbuf).
//
// ── ORACLE STRATEGY ─────────────────────────────────────────────────────────
// PRIMARY oracle = an INDEPENDENT materialized model (`Model`: a plain
// column-major Vec of u64) whose operations are written from the DEFINITION
// of each query, obviously correct by inspection, plus algebraic laws that
// pin the conventions the model alone cannot (not-found, monotonicity,
// range additivity, lower/upper-bound bracketing, exact-prepare pricing).
// The C++ HEAD fixtures (tests/pdtbuf_fixtures.hex, generated by
// oracle/pdtbuf_dump.cpp) are a SECONDARY cross-check whose job is to make
// divergence visible — the C++ family is bug-dense (26 catalogued through
// rung P1, a 27th found at P2; the FQTree half died upstream untested), so
// agreement with it is evidence, never the definition of correct.
//
// Divergences are asserted as divergences rather than conformed to: for
// MAX-ordered buffers the C++ sum(column,row) routes to sum_gen
// (packed_datatype_buffer_so.hpp:1577) and returns a SUFFIX sum, which makes
// its own sum(column,start,end) identity (:889) the negation of the true
// range sum. Section 90 pins our prefix semantics against that behaviour
// exactly: cpp_gen(c,k) == sum_all(c) - sum_prefix(c,k). Section 164 does the
// same for bug #27: the marker-3 fixtures split HEAD's direction answers into
// the ones that agree with the definition (which we must match) and the ones
// that do not (which we must NOT match, and whose predicted shape — the
// non-strict op at val == 0 — is itself asserted at 165).
//
// ── SHAPE COVERAGE ──────────────────────────────────────────────────────────
// Every sweep runs columns in {1,2,3,4}. Section 60 is the explicit
// >=3-column CANARY: it checks the slot formula's column stride directly, so
// the N-axis is red-testable from this rung's first green (an unrolled
// two-column implementation cannot pass it). Both orderings, empty /
// 1-element / IndexSpan-boundary sizes.
//
// Error-code decades:
//   10..19  format, descriptor round-trip, sizing arithmetic
//   20..29  SUM ordering vs the model: access / sum / find
//   30..39  MAX ordering vs the model: access / find (lower+upper bound)
//   40..49  from-index search laws (SUM)
//   50..59  edges: empty, single row, IndexSpan boundary
//   60..69  the >=3-column slot-formula canary + block_of distinctness
//   70..79  structural check() + the exact-prepare pricing law
//   80..89  C++ HEAD fixture cross-check
//   90..99  the C++ sum_gen divergence, asserted as a divergence
//  100..109 harness failures (fixture unreadable, corpus too small)
//  110..119 P1: index geometry, reserve/reindex lockstep, empty-index safety
//  120..129 P1: three-way indexed <-> unindexed scan <-> model, incl. depth
//  130..139 P1: C++ HEAD recursive index-cell parity (marker-2 fixtures)
//  140..149 P2: index-accelerated from-index forms + hazard (a), the
//               under-covering index (bug #26's second site)
//  150..159 P2: the backward family — three-way, duality/mirror laws,
//               multiplicity, not-found, boundaries
//  160..169 P2: C++ HEAD backward/from-index behaviour parity (marker-3),
//               including the recorded #27 divergences
//  170..194 P3: the op-by-op mutation law sweep — insert 170, update 175,
//               remove 180, merge 185, split 190; within each base,
//               +0 prepared != consumed, +1 check(), +2 model, +3 index
//               parity against a full rebuild
//  195..199 P3: the MAX-ordering mutation sweep (ordering axis carried
//               through the mutations; index-free by law)
//  200..204 P3: a FAILED prepare leaves the block BYTE-IDENTICAL
//  205..209 P3: remove(insert(x)) == x, byte for byte
//  210..214 P3: merge(split(x, k)) == x for every cut k, byte for byte
//  215..218 P3: the capacity-policy budget classification (GAP (b): rows
//               growing inside a paid-for capacity must cost ZERO)
//  219..224 P3: incremental-vs-full reindex parity (GAP (a)), depths 1..3
//  225..239 P3: randomized mutation sequences across the threshold band
//  1000..1160 P3: the mutation law sweep, bases spaced by TEN
//  1200..1219 P4: VLE geometry — the DERIVED payload capacity, the pricing
//               fixed point, the slot formula at width 2, descriptor
//               round-trip including dimension kinds
//  1220..1279 P4: the mutation law sweep over variable-length rows —
//               insert 1220, update GROWING 1230, update SHRINKING 1240,
//               remove 1250, merge 1260, split 1270. Within each base:
//               +0 prepared != consumed, +1 check(), +2 model equivalence,
//               +3 the offsets contract re-derived from the model,
//               +4 index-free (SUM => FIXED, observed)
//  1280..1289 P4: round-trip byte identity over the ADDRESSABLE content —
//               remove(insert(x)) == x, merge(split(x, k)) == x for every k
//  1290..1299 P4: the capacity policy extended to the PAYLOAD (KEEP is free
//               in both directions, EXACT hands bytes back)
//  1300..1309 P4: SUM => FIXED and the ordered-key law, as runtime laws
//  1310..1319 P4: corners — empty spans, size 0, capacity 0, mixed
//  1320..1329 P4: randomized mixed sequences, both policies
//  1330..1339 P4: the C++ HEAD variable-length cross-check (marker 5)
//  1340..1349 P4: upstream defect #28 pinned as a DIVERGENCE
package test;

use logos.mem.pkd.pdtbuf;
use logos.mem.pkd;
use logos.lang.arith;
use logos.lang.mem;
use logos.lang.result;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.std.io.fs;
use logos.std.io;

// ── fixture tokenizer (the ssrle_codec.logos discipline) ────────────────────

fn is_ws(b: u8) -> bool {
    return b == 32u8 || b == 10u8 || b == 13u8 || b == 9u8;
}

fn hex_val(b: u8) -> u64 {
    if b >= 48u8 && b <= 57u8 {
        return (b - 48u8) as u64;
    }
    return ((b - 97u8) as u64) + 10u64;
}

fn next_tok(s: str, pos: &mut i64) -> u64 {
    let n: i64 = s.len();
    let mut i: i64 = *pos;
    while i < n && is_ws(s[i]) {
        i = i + 1i64;
    }
    let mut v: u64 = 0u64;
    while i < n && !is_ws(s[i]) {
        v = v * 16u64 + hex_val(s[i]);
        i = i + 1i64;
    }
    *pos = i;
    return v;
}

// ── the independent model ───────────────────────────────────────────────────
//
// A plain column-major table. Nothing here knows about slots, allocators or
// the C++; every operation is the textbook definition of the query.

struct Model {
    cols: u32,
    rows: u64,
    data: Vec<u64>,   // data[c * rows + r]
}

fn model_new(cols: u32, rows: u64) -> Model {
    let mut d: Vec<u64> = vec_new::<u64>();
    let total: i64 = (cols as i64) * (rows as i64);
    let mut i: i64 = 0i64;
    while i < total {
        d.push(0u64);
        i = i + 1i64;
    }
    return Model { cols: cols, rows: rows, data: d };
}

fn model_idx(m: &Model, c: u32, r: u64) -> i64 {
    return (c as i64) * (m.rows as i64) + (r as i64);
}

fn model_get(m: &Model, c: u32, r: u64) -> u64 {
    return m.data.get(model_idx(m, c, r));
}

fn model_set(m: &mut Model, c: u32, r: u64, v: u64) {
    let i: i64 = model_idx(m, c, r);
    m.data.set(i, v);
}

/// Exclusive prefix sum over [0, k) — the definition, nothing else.
fn model_prefix(m: &Model, c: u32, k: u64) -> u64 {
    let mut acc: u64 = 0u64;
    let mut i: u64 = 0u64;
    while i < k {
        acc = acc + model_get(m, c, i);
        i = i + 1u64;
    }
    return acc;
}

fn model_range(m: &Model, c: u32, s: u64, e: u64) -> u64 {
    let mut acc: u64 = 0u64;
    let mut i: u64 = s;
    while i < e {
        acc = acc + model_get(m, c, i);
        i = i + 1u64;
    }
    return acc;
}

/// SUM descent: the first row whose INCLUSIVE prefix reaches `val`
/// (`strict` = must exceed). Not found -> (rows, total).
fn model_find_sum(m: &Model, c: u32, val: u64, strict: bool, start: u64) -> PdtFind {
    let mut prefix: u64 = 0u64;
    let mut i: u64 = start;
    while i < m.rows {
        let incl: u64 = prefix + model_get(m, c, i);
        let hit: bool = if strict { incl > val } else { incl >= val };
        if hit {
            return PdtFind { idx: i, prefix: prefix };
        }
        prefix = incl;
        i = i + 1u64;
    }
    return PdtFind { idx: m.rows, prefix: prefix };
}

/// Backward SUM descent over rows [0, end): walk DOWN from end-1,
/// accumulating, and stop at the first row whose running total meets `val`.
/// Not found -> (end, the total over [0, end)).
///
/// This is the WALK ITSELF, written from the definition of "search backward".
/// The port answers the same question by a complement identity over its
/// forward descent, so the two sides share no algorithm and a common
/// off-by-one cannot cancel out — the same discipline model_find_max applies
/// to the MAX bisection.
fn model_find_bw(m: &Model, c: u32, end: u64, val: u64, strict: bool) -> PdtFind {
    let mut acc: u64 = 0u64;
    let mut i: u64 = end;
    while i > 0u64 {
        i = i - 1u64;
        let incl: u64 = acc + model_get(m, c, i);
        let hit: bool = if strict { incl > val } else { incl >= val };
        if hit {
            return PdtFind { idx: i, prefix: acc };
        }
        acc = incl;
    }
    return PdtFind { idx: end, prefix: acc };
}

/// The row-reversal of a model's first `end` rows — the substrate of the
/// backward<->forward DUALITY law (a backward search over [0,end) is a
/// forward search over the reversed range, with the answer index mirrored).
fn model_reversed(m: &Model, end: u64) -> Model {
    let mut r: Model = model_new(m.cols, end);
    let mut c: u32 = 0u32;
    while c < m.cols {
        let mut i: u64 = 0u64;
        while i < end {
            model_set(&mut r, c, i, model_get(m, c, end - 1u64 - i));
            i = i + 1u64;
        }
        c = c + 1u32;
    }
    return r;
}

/// MAX descent over a sorted column: linear lower/upper bound. Deliberately
/// NOT a bisection — the model must not share an algorithm with the code it
/// judges (a shared off-by-one would cancel out).
fn model_find_max(m: &Model, c: u32, val: u64, strict: bool) -> u64 {
    let mut i: u64 = 0u64;
    while i < m.rows {
        let v: u64 = model_get(m, c, i);
        let hit: bool = if strict { v > val } else { v >= val };
        if hit {
            return i;
        }
        i = i + 1u64;
    }
    return m.rows;
}

// ── the model's MUTATIONS (P3) ──────────────────────────────────────────────
//
// Written from the definition of each operation over a plain table, sharing
// no code with the packed implementation: the port shifts bytes inside slots
// and repairs a 32-ary index, the model rebuilds a Vec. A common off-by-one
// cannot cancel out between them.

/// Rows [at, at+count) of a row-major value block become new rows at `at`.
fn model_insert(m: &Model, at: u64, count: u64, vals: &Vec<u64>) -> Model {
    let mut r: Model = model_new(m.cols, m.rows + count);
    let mut c: u32 = 0u32;
    while c < m.cols {
        let mut i: u64 = 0u64;
        while i < at {
            model_set(&mut r, c, i, model_get(m, c, i));
            i = i + 1u64;
        }
        let mut k: u64 = 0u64;
        while k < count {
            model_set(&mut r, c, at + k,
                      vals.get((k as i64) * (m.cols as i64) + (c as i64)));
            k = k + 1u64;
        }
        let mut j: u64 = at;
        while j < m.rows {
            model_set(&mut r, c, j + count, model_get(m, c, j));
            j = j + 1u64;
        }
        c = c + 1u32;
    }
    return r;
}

fn model_update(m: &Model, at: u64, count: u64, vals: &Vec<u64>) -> Model {
    let mut r: Model = model_new(m.cols, m.rows);
    let mut c: u32 = 0u32;
    while c < m.cols {
        let mut i: u64 = 0u64;
        while i < m.rows {
            model_set(&mut r, c, i, model_get(m, c, i));
            i = i + 1u64;
        }
        c = c + 1u32;
    }
    let mut k: u64 = 0u64;
    while k < count {
        let mut c2: u32 = 0u32;
        while c2 < m.cols {
            model_set(&mut r, c2, at + k,
                      vals.get((k as i64) * (m.cols as i64) + (c2 as i64)));
            c2 = c2 + 1u32;
        }
        k = k + 1u64;
    }
    return r;
}

fn model_remove(m: &Model, start: u64, end: u64) -> Model {
    let mut r: Model = model_new(m.cols, m.rows - (end - start));
    let mut c: u32 = 0u32;
    while c < m.cols {
        let mut w: u64 = 0u64;
        let mut i: u64 = 0u64;
        while i < m.rows {
            if i < start || i >= end {
                model_set(&mut r, c, w, model_get(m, c, i));
                w = w + 1u64;
            }
            i = i + 1u64;
        }
        c = c + 1u32;
    }
    return r;
}

/// a ++ b — the merge_from direction (self absorbs other after its own rows).
fn model_concat(a: &Model, b: &Model) -> Model {
    let mut r: Model = model_new(a.cols, a.rows + b.rows);
    let mut c: u32 = 0u32;
    while c < a.cols {
        let mut i: u64 = 0u64;
        while i < a.rows {
            model_set(&mut r, c, i, model_get(a, c, i));
            i = i + 1u64;
        }
        let mut j: u64 = 0u64;
        while j < b.rows {
            model_set(&mut r, c, a.rows + j, model_get(b, c, j));
            j = j + 1u64;
        }
        c = c + 1u32;
    }
    return r;
}

/// Rows [0, at) of `m` — the left side of a split.
fn model_prefix_rows(m: &Model, at: u64) -> Model {
    return model_remove(m, at, m.rows);
}

/// Rows [at, rows) of `m` — the suffix a split moves out.
fn model_suffix_rows(m: &Model, at: u64) -> Model {
    return model_remove(m, 0u64, at);
}

// ── comparing a buffer to the model, and to its own full rebuild ────────────

fn buf_matches_model(b: &PdtBuf, m: &Model) -> bool {
    if b.size() != m.rows {
        return false;
    }
    if b.columns() != m.cols {
        return false;
    }
    let mut c: u32 = 0u32;
    while c < m.cols {
        let mut i: u64 = 0u64;
        while i < m.rows {
            if b.get(c, i) != model_get(m, c, i) {
                return false;
            }
            i = i + 1u64;
        }
        c = c + 1u32;
    }
    return true;
}

/// Index cell identity, LEVEL BY LEVEL and all the way up — the substrate of
/// the incremental-vs-full-reindex parity law. Anything less (comparing only
/// query answers) could be satisfied by a stale index whose error happens to
/// cancel inside the residual scan.
fn index_cells_identical(a: &PdtBuf, b: &PdtBuf) -> bool {
    if a.has_index() != b.has_index() {
        return false;
    }
    if !a.has_index() {
        return true;
    }
    let ia: PdtBuf = a.index();
    let ib: PdtBuf = b.index();
    if ia.size() != ib.size() {
        return false;
    }
    let cols: u32 = a.columns();
    let mut c: u32 = 0u32;
    while c < cols {
        let mut k: u64 = 0u64;
        while k < ia.size() {
            if ia.get(c, k) != ib.get(c, k) {
                return false;
            }
            k = k + 1u64;
        }
        c = c + 1u32;
    }
    return index_cells_identical(&ia, &ib);
}

/// A flat byte copy of the whole block — a valid, independent buffer, because
/// every back-reference in the packed family is self-relative. This IS the
/// CoW clone of design_zero_copy_mutation_cow, and the gate uses it two ways:
/// as the full-rebuild twin for reindex parity, and as the "before" snapshot
/// of the failed-prepare byte-identity law.
unsafe fn clone_block(src: &PdtBuf) -> *mut u8 {
    let n: u32 = src.block_bytes();
    let dst: *mut u8 = alloc(n as i64);
    let s: *mut u8 = src.block_ptr();
    let mut i: i64 = 0i64;
    while i < (n as i64) {
        *dst.byte_add(i) = *s.byte_add(i);
        i = i + 1i64;
    }
    return dst;
}

unsafe fn blocks_identical(a: &PdtBuf, b: *mut u8, n: u32) -> bool {
    let p: *mut u8 = a.block_ptr();
    let mut i: i64 = 0i64;
    while i < (n as i64) {
        if *p.byte_add(i) != *b.byte_add(i) {
            return false;
        }
        i = i + 1i64;
    }
    return true;
}

/// Byte identity over the LIVE region — [0, consumed_bytes()), which is
/// exactly header + layout + bitmap + every allocated slot payload, in order.
///
/// WHY NOT THE WHOLE BLOCK, for the round-trip laws. A shrink
/// (PkdAlloc::resize_block_at -> move_elements_down) compacts the payloads
/// and lowers the layout offsets, but does NOT zero the bytes the tail
/// vacated — a memset on every shrink would be pure cost for memory that is,
/// by definition, not part of any structure's state. So after
/// insert-then-remove the free tail legitimately holds residue of the larger
/// intermediate, and requiring the whole malloc'd region to match would be
/// asserting something false about the design rather than something true
/// about the mutation. The live region is the entire state: it is what
/// consumed_bytes() prices, what check() validates, and what a CoW clone
/// would carry. (The FAILED-PREPARE law at 200..204 keeps the whole-block
/// form, and it holds there — a prepare that fails writes nothing at all,
/// so not even the tail may move.)
unsafe fn live_bytes_identical(a: &PdtBuf, b: *mut u8, n: u32) -> bool {
    if a.consumed_bytes() != n {
        return false;
    }
    return blocks_identical(a, b, n);
}

/// THE law of this rung, in one place, applied after EVERY mutation:
///   * prepared_bytes == consumed_bytes, EXACTLY (over- and under-pricing
///     probes both trip this);
///   * check() passes — so the index is coherent, the slot geometry matches
///     the descriptor, and consumed == priced independently;
///   * the buffer equals the independent model, cell for cell;
///   * the index is cell-identical to a FULL REBUILD of the same content, so
///     an incremental path that drifts by a single cell is caught here even
///     when every query still happens to answer correctly.
/// Returns 0 or the caller's error code, offset by which conjunct failed.
fn assert_mutation(b: &PdtBuf, m: &Model, prepared: u32, base: i32) -> i32 {
    if b.consumed_bytes() != prepared {
        return base;
    }
    if b.check() != 0i32 {
        return base + 1i32;
    }
    if !buf_matches_model(b, m) {
        return base + 2i32;
    }
    unsafe {
        let twin_mem: *mut u8 = clone_block(b);
        let mut twin: PdtBuf = pdtbuf_adopt(twin_mem);
        twin.reindex();
        let same: bool = index_cells_identical(b, &twin);
        dealloc(twin_mem);
        if !same {
            return base + 3i32;
        }
    }
    return 0i32;
}

// ── corpus generation ───────────────────────────────────────────────────────

fn lcg_next(s: &mut u64) -> u64 {
    *s = wrapping_add(wrapping_mul(*s, 6364136223846793005u64), 1442695040888963407u64);
    return *s >> 33u64;
}

fn model_sort_column(m: &mut Model, c: u32) {
    // Insertion sort — small corpora, and simple enough to be obviously right.
    let mut i: u64 = 1u64;
    while i < m.rows {
        let v: u64 = model_get(m, c, i);
        let mut j: u64 = i;
        while j > 0u64 && model_get(m, c, j - 1u64) > v {
            let prev: u64 = model_get(m, c, j - 1u64);
            model_set(m, c, j, prev);
            j = j - 1u64;
        }
        model_set(m, c, j, v);
        i = i + 1u64;
    }
}

fn model_random(cols: u32, rows: u64, sorted: bool, seed: &mut u64) -> Model {
    let mut m: Model = model_new(cols, rows);
    let mut c: u32 = 0u32;
    while c < cols {
        let mut r: u64 = 0u64;
        while r < rows {
            model_set(&mut m, c, r, lcg_next(seed) % 23u64);
            r = r + 1u64;
        }
        if sorted {
            model_sort_column(&mut m, c);
        }
        c = c + 1u32;
    }
    return m;
}

// ── buffer construction ─────────────────────────────────────────────────────

fn descr_for(cols: u32, ordering: u32) -> PdtDescr {
    return pdt_descr_fse(cols, 8u32, ordering, false);
}

fn fill_from_model(b: &mut PdtBuf, m: &Model) {
    let mut r: u64 = 0u64;
    while r < m.rows {
        let mut c: u32 = 0u32;
        while c < m.cols {
            b.set(c, r, model_get(m, c, r));
            c = c + 1u32;
        }
        r = r + 1u64;
    }
}

// ── 10.. format / descriptor round-trip / sizing arithmetic ────────────────

fn check_sizing() -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 6u32 {
        let d: PdtDescr = descr_for(cols, PDT_ORD_SUM);
        // Slot geometry follows the descriptor, not a hardcoded count.
        if d.dim_blocks_total() != 1u32 {
            return 10000i32;
        }
        if d.slots() != 2u32 + cols {
            return 11i32;
        }
        if d.dim_block_offset(0u32) != 0u32 {
            return 12000i32;
        }
        // Sizing is monotone in capacity and exact on the 8-byte granule.
        let e0: u32 = pdtbuf_compute_block_size_fse(&d, 0u64);
        if e0 != pdtbuf_empty_size(&d) {
            return 13i32;
        }
        let mut cap: u64 = 1u64;
        while cap <= 64u64 {
            let s1: u32 = pdtbuf_compute_block_size_fse(&d, cap);
            let s0: u32 = pdtbuf_compute_block_size_fse(&d, cap - 1u64);
            if s1 < s0 {
                return 14i32;
            }
            if s1 != pdtbuf_empty_size(&d) + (cap as u32) * 8u32 * cols {
                return 15i32;
            }
            cap = cap + 1u64;
        }
        // P0 narrows the index away, but the hook must be inert, not absent:
        // an indexed SUM descriptor prices strictly more above the span.
        let di: PdtDescr = pdt_descr_fse(cols, 8u32, PDT_ORD_SUM, true);
        if !di.has_index() {
            return 16i32;
        }
        if pdtbuf_index_block_size(&di, 32u64) != 0u32 {
            return 17i32;
        }
        if pdtbuf_index_block_size(&di, 33u64) == 0u32 {
            return 18i32;
        }
        // ... and the recursion is the SAME pricing function one level down
        // (2 spans of 32 rows) — the shape P1 inherits unchanged.
        if pdtbuf_index_block_size(&di, 33u64) != pdtbuf_compute_block_size_fse(&di, 2u64) {
            return 19i32;
        }
        // A MAX descriptor never carries an index, whatever the flag says
        // (C++ HasIndex :57 — ordering is a law, not a configuration).
        let dm: PdtDescr = pdt_descr_fse(cols, 8u32, PDT_ORD_MAX, true);
        if dm.has_index() {
            return 10001i32;
        }
        if pdtbuf_index_block_size(&dm, 1000u64) != 0u32 {
            return 10002i32;
        }
        // VLE dimensions are P4, but the WIDTH axis must already be carried.
        let mut dv: PdtDescr = pdt_descr_new(cols, PDT_ORD_SUM, false);
        dv.dims.push(pdt_dim_fse(8u32));
        dv.dims.push(pdt_dim_vle(1u32));
        if dv.dim_blocks_total() != 3u32 {
            return 12001i32;
        }
        if dv.slots() != 2u32 + 3u32 * cols {
            return 12002i32;
        }
        if dv.dim_block_offset(1u32) != 1u32 {
            return 12003i32;
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 60.. the >=3-column canary + block_of distinctness ─────────────────────

fn check_column_canary() -> i32 {
    // Runs for every column count in the sweep, but exists for cols >= 3:
    // a two-column-shaped implementation (or a per-column special case)
    // cannot satisfy the stride identity below.
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let d: PdtDescr = descr_for(cols, PDT_ORD_SUM);
        let bs: u32 = pdtbuf_compute_block_size_fse(&d, 8u64);
        unsafe {
            let mem: *mut u8 = alloc(bs as i64);
            let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, 8u64) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    return 60i32;
                }
            };
            let mut c: u32 = 0u32;
            while c < cols {
                // THE slot formula, checked directly:
                //   block(c) = LAST_HEADER_BLOCK + dim_blocks_total*c + 0
                if b.block_of(c, 0u32, 0u32) != 2u32 + c {
                    dealloc(mem);
                    return 61i32;
                }
                c = c + 1u32;
            }
            // Distinctness: every (column, dim, sub) triple owns its own slot.
            let mut i: u32 = 0u32;
            while i < cols {
                let mut j: u32 = 0u32;
                while j < cols {
                    let same: bool = b.block_of(i, 0u32, 0u32) == b.block_of(j, 0u32, 0u32);
                    if same != (i == j) {
                        dealloc(mem);
                        return 62i32;
                    }
                    j = j + 1u32;
                }
                i = i + 1u32;
            }
            // Columns are INDEPENDENT storage: writing column k must not be
            // observable in any other column. This is the assertion that a
            // broken column stride cannot survive.
            let mut k: u32 = 0u32;
            while k < cols {
                let mut r: u64 = 0u64;
                while r < 8u64 {
                    b.set(k, r, 1000u64 + (k as u64) * 100u64 + r);
                    r = r + 1u64;
                }
                k = k + 1u32;
            }
            let mut k2: u32 = 0u32;
            while k2 < cols {
                let mut r2: u64 = 0u64;
                while r2 < 8u64 {
                    if b.get(k2, r2) != 1000u64 + (k2 as u64) * 100u64 + r2 {
                        dealloc(mem);
                        return 63i32;
                    }
                    r2 = r2 + 1u64;
                }
                k2 = k2 + 1u32;
            }
            if b.check() != 0i32 {
                dealloc(mem);
                return 64i32;
            }
            dealloc(mem);
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 20../30../40../70.. model equivalence for one (cols, rows, ordering) ────

fn check_case(cols: u32, rows: u64, ordering: u32, seed: &mut u64) -> i32 {
    let sorted: bool = ordering == PDT_ORD_MAX;
    let m: Model = model_random(cols, rows, sorted, seed);
    let d: PdtDescr = descr_for(cols, ordering);
    let bs: u32 = pdtbuf_compute_block_size_fse(&d, rows);
    unsafe {
        let mem: *mut u8 = alloc(bs as i64);
        let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, rows) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 20i32;
            }
        };
        fill_from_model(&mut b, &m);
        let rc: i32 = check_case_body(&b, &m, ordering);
        dealloc(mem);
        return rc;
    }
}

fn check_case_body(b: &PdtBuf, m: &Model, ordering: u32) -> i32 {
    let cols: u32 = m.cols;
    let rows: u64 = m.rows;

    // 70.. structural + the exact-prepare pricing law.
    if b.check() != 0i32 {
        return 70i32;
    }
    let d: PdtDescr = b.descr();
    if b.consumed_bytes() != pdtbuf_compute_block_size_fse(&d, rows) {
        return 71i32;
    }
    if b.size() != rows {
        return 72i32;
    }
    if b.columns() != cols {
        return 73i32;
    }
    if b.ordering() != ordering {
        return 74i32;
    }
    if b.dim_count() != 1u32 || b.dim_blocks_total() != 1u32 {
        return 75i32;
    }
    if b.has_index() {
        return 76i32;   // P0 configures no index; the flag must stay false
    }

    // 21.. access: every cell, every column.
    let mut c: u32 = 0u32;
    while c < cols {
        let mut r: u64 = 0u64;
        while r < rows {
            if b.get(c, r) != model_get(m, c, r) {
                return 21i32;
            }
            r = r + 1u64;
        }
        // span() must be the same view as get().
        let vals: &[u64] = b.values(c);
        let mut r2: u64 = 0u64;
        while r2 < rows {
            if vals[r2 as i64] != model_get(m, c, r2) {
                return 22i32;
            }
            r2 = r2 + 1u64;
        }
        c = c + 1u32;
    }

    // 23.. sums (prefix semantics for BOTH orderings — see the module's
    // sum_gen divergence note). Exhaustive over every (start,end) pair.
    let mut c3: u32 = 0u32;
    while c3 < cols {
        let mut s: u64 = 0u64;
        while s <= rows {
            if b.sum_prefix(c3, s) != model_prefix(m, c3, s) {
                return 23i32;
            }
            let mut e: u64 = s;
            while e <= rows {
                if b.sum(c3, s, e) != model_range(m, c3, s, e) {
                    return 24i32;
                }
                e = e + 1u64;
            }
            s = s + 1u64;
        }
        if b.sum_all(c3) != model_prefix(m, c3, rows) {
            return 25i32;
        }
        // Range additivity: sum[s,e) + sum[e,f) == sum[s,f).
        let mut a1: u64 = 0u64;
        while a1 <= rows {
            let mut a2: u64 = a1;
            while a2 <= rows {
                let mut a3: u64 = a2;
                while a3 <= rows {
                    if b.sum(c3, a1, a2) + b.sum(c3, a2, a3) != b.sum(c3, a1, a3) {
                        return 26i32;
                    }
                    a3 = a3 + 1u64;
                }
                a2 = a2 + 1u64;
            }
            a1 = a1 + 1u64;
        }
        c3 = c3 + 1u32;
    }

    // 27../31.. the search family vs the model, over a probe set that covers
    // every attainable answer plus both edges.
    let mut c4: u32 = 0u32;
    while c4 < cols {
        let total: u64 = b.sum_all(c4);
        let mut probes: Vec<u64> = vec_new::<u64>();
        probes.push(0u64);
        probes.push(1u64);
        if ordering == PDT_ORD_SUM {
            let mut k: u64 = 0u64;
            while k <= rows {
                let p: u64 = model_prefix(m, c4, k);
                probes.push(p);
                if p > 0u64 {
                    probes.push(p - 1u64);
                }
                probes.push(p + 1u64);
                k = k + 1u64;
            }
        } else {
            let mut k2: u64 = 0u64;
            while k2 < rows {
                let v: u64 = model_get(m, c4, k2);
                probes.push(v);
                if v > 0u64 {
                    probes.push(v - 1u64);
                }
                probes.push(v + 1u64);
                k2 = k2 + 1u64;
            }
            probes.push(100u64);
        }
        let np: i64 = probes.length();
        let mut pi: i64 = 0i64;
        while pi < np {
            let v: u64 = probes.get(pi);
            let ge: PdtFind = b.find_ge(c4, v);
            let gt: PdtFind = b.find_gt(c4, v);
            if ordering == PDT_ORD_SUM {
                let mge: PdtFind = model_find_sum(m, c4, v, false, 0u64);
                let mgt: PdtFind = model_find_sum(m, c4, v, true, 0u64);
                if ge.idx != mge.idx || ge.prefix != mge.prefix {
                    return 27i32;
                }
                if gt.idx != mgt.idx || gt.prefix != mgt.prefix {
                    return 28i32;
                }
                // LAW: the reported prefix IS the prefix sum at the hit row.
                if ge.prefix != b.sum_prefix(c4, ge.idx) {
                    return 29000i32;
                }
                if gt.prefix != b.sum_prefix(c4, gt.idx) {
                    return 29001i32;
                }
                // LAW: bracketing. For a hit, the cumulative sum crosses `v`
                // exactly at the returned row.
                if ge.idx < rows {
                    if !(ge.prefix < v || v == 0u64) {
                        return 40i32;
                    }
                    if v > ge.prefix + b.get(c4, ge.idx) {
                        return 41i32;
                    }
                }
                if gt.idx < rows {
                    if v >= gt.prefix + b.get(c4, gt.idx) {
                        return 42i32;
                    }
                }
                // LAW: gt never precedes ge, and ge never precedes it by more
                // than the zero-valued rows between them.
                if gt.idx < ge.idx {
                    return 43i32;
                }
                // LAW: from-index search over the whole range is the plain one.
                let f0: PdtFind = b.find_ge_from(c4, 0u64, v);
                if f0.idx != ge.idx || f0.prefix != ge.prefix {
                    return 44i32;
                }
                let g0: PdtFind = b.find_gt_from(c4, 0u64, v);
                if g0.idx != gt.idx || g0.prefix != gt.prefix {
                    return 45i32;
                }
                // ... and from an arbitrary start it equals the model's
                // residual scan, with the answer never preceding the start.
                let mut st: u64 = 0u64;
                while st <= rows {
                    let fr: PdtFind = b.find_ge_from(c4, st, v);
                    let mr: PdtFind = model_find_sum(m, c4, v, false, st);
                    if fr.idx != mr.idx || fr.prefix != mr.prefix {
                        return 46i32;
                    }
                    if fr.idx < st {
                        return 47i32;
                    }
                    st = st + 1u64;
                }
            } else {
                let mge2: u64 = model_find_max(m, c4, v, false);
                let mgt2: u64 = model_find_max(m, c4, v, true);
                if ge.idx != mge2 {
                    return 31i32;
                }
                if gt.idx != mgt2 {
                    return 32i32;
                }
                if ge.prefix != 0u64 || gt.prefix != 0u64 {
                    return 33i32;
                }
                // LAW (lower_bound): everything before the hit is strictly
                // below `v`, the hit itself is not.
                let mut q: u64 = 0u64;
                while q < ge.idx {
                    if b.get(c4, q) >= v {
                        return 34i32;
                    }
                    q = q + 1u64;
                }
                if ge.idx < rows && b.get(c4, ge.idx) < v {
                    return 35i32;
                }
                // LAW (upper_bound) + the multiplicity identity:
                // gt.idx - ge.idx == the number of cells equal to `v`.
                if gt.idx < ge.idx {
                    return 36i32;
                }
                let mut eq: u64 = 0u64;
                let mut q2: u64 = 0u64;
                while q2 < rows {
                    if b.get(c4, q2) == v {
                        eq = eq + 1u64;
                    }
                    q2 = q2 + 1u64;
                }
                if gt.idx - ge.idx != eq {
                    return 37i32;
                }
            }
            pi = pi + 1i64;
        }
        // 38.. the not-found convention, pinned independently of the C++.
        let nf: PdtFind = b.find_gt(c4, total + 1u64);
        if nf.idx != rows {
            return 38i32;
        }
        if ordering == PDT_ORD_SUM && nf.prefix != total {
            return 39i32;
        }
        // Monotonicity of the answer in the query value.
        let mut mv: u64 = 0u64;
        let mut prev_ge: u64 = 0u64;
        while mv <= total + 2u64 {
            let r: PdtFind = b.find_ge(c4, mv);
            if r.idx < prev_ge {
                return 48i32;
            }
            prev_ge = r.idx;
            mv = mv + 1u64;
        }
        c4 = c4 + 1u32;
    }
    return 0i32;
}

// ── 50.. edges ─────────────────────────────────────────────────────────────

fn check_edges() -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let d: PdtDescr = descr_for(cols, PDT_ORD_SUM);
        // Empty buffer: no unsigned underflow anywhere (the C++ family's
        // signature failure mode — max_element_idx = size()-1 on empty, and
        // the walk_fw `start >= size-64` guard class).
        let bs0: u32 = pdtbuf_compute_block_size_fse(&d, 0u64);
        unsafe {
            let mem: *mut u8 = alloc(bs0 as i64);
            let b: PdtBuf = match pdtbuf_create(mem, bs0, &d, 0u64) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    return 50i32;
                }
            };
            if b.size() != 0u64 {
                dealloc(mem);
                return 51i32;
            }
            let mut c: u32 = 0u32;
            while c < cols {
                if b.sum_all(c) != 0u64 {
                    dealloc(mem);
                    return 52000i32;
                }
                if b.sum_prefix(c, 0u64) != 0u64 {
                    dealloc(mem);
                    return 52001i32;
                }
                if b.sum(c, 0u64, 0u64) != 0u64 {
                    dealloc(mem);
                    return 52002i32;
                }
                let ge: PdtFind = b.find_ge(c, 0u64);
                if ge.idx != 0u64 || ge.prefix != 0u64 {
                    dealloc(mem);
                    return 53i32;
                }
                let gt: PdtFind = b.find_gt(c, 7u64);
                if gt.idx != 0u64 || gt.prefix != 0u64 {
                    dealloc(mem);
                    return 54i32;
                }
                let fr: PdtFind = b.find_ge_from(c, 0u64, 5u64);
                if fr.idx != 0u64 {
                    dealloc(mem);
                    return 55i32;
                }
                c = c + 1u32;
            }
            if b.check() != 0i32 {
                dealloc(mem);
                return 56i32;
            }
            dealloc(mem);
        }
        // reserve() grows and shrinks exactly, and the pricing law holds at
        // every capacity on the way — the P3 exact-prepare basis.
        let caps: [u64; 7] = [0u64, 1u64, 31u64, 32u64, 33u64, 8u64, 0u64];
        let bsmax: u32 = pdtbuf_compute_block_size_fse(&d, 33u64);
        unsafe {
            let mem2: *mut u8 = alloc(bsmax as i64);
            let mut b2: PdtBuf = match pdtbuf_format(mem2, bsmax, &d) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem2);
                    return 57i32;
                }
            };
            let mut i: i64 = 0i64;
            while i < 7i64 {
                let cap: u64 = caps[i];
                match b2.reserve(cap) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        dealloc(mem2);
                        return 58000i32;
                    }
                }
                if b2.capacity() != cap {
                    dealloc(mem2);
                    return 58001i32;
                }
                if b2.consumed_bytes() != pdtbuf_compute_block_size_fse(&d, cap) {
                    dealloc(mem2);
                    return 59000i32;
                }
                if b2.check() != 0i32 {
                    dealloc(mem2);
                    return 59001i32;
                }
                i = i + 1i64;
            }
            dealloc(mem2);
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ═══ P1: the recursive SUM span index ═══════════════════════════════════════
//
// ORACLE STRATEGY, unchanged in kind: correctness is decided by the model and
// by a THIRD leg the index cannot influence — a twin buffer built with
// indexed=false over identical data, whose every query is a plain scan. Any
// index bug shows up as indexed != scan even before the model is consulted,
// and the model catches a bug that somehow corrupted both.
//
// The index's DEFINING property is checked directly rather than inferred:
// cell (c,k) must be the PARTIAL sum of span k, and section 111 asserts that
// a PREFIX-sum index would be a different (wrong) structure by exhibiting the
// difference at k >= 1.

/// The indexed twin of descr_for: the same shape with the index switched on.
fn descr_indexed(cols: u32) -> PdtDescr {
    return pdt_descr_fse(cols, 8u32, PDT_ORD_SUM, true);
}

/// Index levels the geometry MUST produce for `rows`: one per division by the
/// span until a level fits in a single span. Written from the definition, not
/// from the implementation's recursion.
fn model_index_levels(rows: u64) -> u32 {
    let mut n: u64 = rows;
    let mut levels: u32 = 0u32;
    while n > 32u64 {
        n = (n + 31u64) / 32u64;
        levels = levels + 1u32;
    }
    return levels;
}

/// Per-span partial sum of the MODEL over span `k` — the definition of an
/// index cell, computed with no reference to the buffer.
fn model_span_sum(m: &Model, c: u32, k: u64) -> u64 {
    let base: u64 = k * 32u64;
    let mut limit: u64 = base + 32u64;
    if limit > m.rows {
        limit = m.rows;
    }
    return model_range(m, c, base, limit);
}

// ── 110.. geometry, lockstep, and empty-index safety ───────────────────────

fn check_index_geometry() -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let d: PdtDescr = descr_indexed(cols);
        // Capacities straddling the threshold and both deeper boundaries.
        let caps: [u64; 10] = [0u64, 1u64, 31u64, 32u64, 33u64, 64u64, 1024u64,
                               1025u64, 100u64, 0u64];
        let bsmax: u32 = pdtbuf_compute_block_size_fse(&d, 1025u64);
        unsafe {
            let mem: *mut u8 = alloc(bsmax as i64);
            let mut b: PdtBuf = match pdtbuf_format(mem, bsmax, &d) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    return 110i32;
                }
            };
            // A freshly formatted buffer is below the threshold: no index.
            if b.has_index() {
                dealloc(mem);
                return 111i32;
            }
            let mut i: i64 = 0i64;
            while i < 10i64 {
                let cap: u64 = caps[i];
                match b.reserve(cap) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        dealloc(mem);
                        return 112i32;
                    }
                }
                // LOCKSTEP: presence is decided by CAPACITY, and the slot
                // holds exactly what the capacity prices. A slot sized from
                // `size` while priced from `capacity` fails right here.
                if b.has_index() != (cap > 32u64) {
                    dealloc(mem);
                    return 113i32;
                }
                if b.index_levels() != model_index_levels(cap) {
                    dealloc(mem);
                    return 114i32;
                }
                if b.consumed_bytes() != pdtbuf_compute_block_size_fse(&d, cap) {
                    dealloc(mem);
                    return 115i32;
                }
                if b.check() != 0i32 {
                    dealloc(mem);
                    return 116i32;
                }
                if b.has_index() {
                    // reserve() leaves the index EMPTY, never stale.
                    if b.index().size() != 0u64 {
                        dealloc(mem);
                        return 117i32;
                    }
                    // ... and the index's own capacity is the span count of
                    // OUR capacity, one level down, recursively.
                    if b.index().capacity() != (cap + 31u64) / 32u64 {
                        dealloc(mem);
                        return 118i32;
                    }
                }
                i = i + 1i64;
            }
            dealloc(mem);
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

/// The DERIVED-robustness assertion (the C++ divergence at
/// packed_datatype_buffer_so.hpp:1501-1514, upstream bug candidate #26): a
/// buffer whose index is materialized but NOT yet filled must answer every
/// query CORRECTLY — by falling back to the scan it would have done anyway —
/// not report "not found" over rows it never examined. The C++ short-circuits
/// on an index miss and would answer (size, 0) here for every query.
fn check_empty_index_safety(seed: &mut u64) -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let rows: u64 = 100u64;
        let m: Model = model_random(cols, rows, false, seed);
        let d: PdtDescr = descr_indexed(cols);
        let bs: u32 = pdtbuf_compute_block_size_fse(&d, rows);
        unsafe {
            let mem: *mut u8 = alloc(bs as i64);
            let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, rows) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    return 119000i32;
                }
            };
            fill_from_model(&mut b, &m);
            // NO reindex() — the index slot exists, its size is 0.
            if !b.has_index() {
                dealloc(mem);
                return 119001i32;
            }
            if b.index().size() != 0u64 {
                dealloc(mem);
                return 119002i32;
            }
            let mut c: u32 = 0u32;
            while c < cols {
                let total: u64 = model_prefix(&m, c, rows);
                let mut k: u64 = 0u64;
                while k <= rows {
                    if b.sum_prefix(c, k) != model_prefix(&m, c, k) {
                        dealloc(mem);
                        return 119003i32;
                    }
                    k = k + 1u64;
                }
                let mut v: u64 = 0u64;
                while v <= total + 2u64 {
                    let ge: PdtFind = b.find_ge(c, v);
                    let mge: PdtFind = model_find_sum(&m, c, v, false, 0u64);
                    if ge.idx != mge.idx || ge.prefix != mge.prefix {
                        dealloc(mem);
                        return 119004i32;
                    }
                    // P2: the start-relative and backward forms ride the same
                    // clamp. A size-0 index is the state where `start / 32`
                    // exceeds index.size() for every start past the first
                    // span, so this is the shortest path to hazard (a).
                    let mut st: u64 = 0u64;
                    while st <= rows {
                        let f1: PdtFind = b.find_ge_from(c, st, v);
                        let m1: PdtFind = model_find_sum(&m, c, v, false, st);
                        if f1.idx != m1.idx || f1.prefix != m1.prefix {
                            dealloc(mem);
                            return 119005i32;
                        }
                        let f2: PdtFind = b.find_gt_from(c, st, v);
                        let m2: PdtFind = model_find_sum(&m, c, v, true, st);
                        if f2.idx != m2.idx || f2.prefix != m2.prefix {
                            dealloc(mem);
                            return 119006i32;
                        }
                        if st < rows {
                            let f3: PdtFind = b.find_bw_ge_from(c, st, v);
                            let m3: PdtFind = model_find_bw(&m, c, st + 1u64, v, false);
                            if f3.idx != m3.idx || f3.prefix != m3.prefix {
                                dealloc(mem);
                                return 119007i32;
                            }
                            let f4: PdtFind = b.find_bw_gt_from(c, st, v);
                            let m4: PdtFind = model_find_bw(&m, c, st + 1u64, v, true);
                            if f4.idx != m4.idx || f4.prefix != m4.prefix {
                                dealloc(mem);
                                return 119008i32;
                            }
                        }
                        st = st + 13u64;
                    }
                    let f5: PdtFind = b.find_bw_ge(c, v);
                    let m5: PdtFind = model_find_bw(&m, c, rows, v, false);
                    if f5.idx != m5.idx || f5.prefix != m5.prefix {
                        dealloc(mem);
                        return 119009i32;
                    }
                    let f6: PdtFind = b.find_bw_gt(c, v);
                    let m6: PdtFind = model_find_bw(&m, c, rows, v, true);
                    if f6.idx != m6.idx || f6.prefix != m6.prefix {
                        dealloc(mem);
                        return 119010i32;
                    }
                    v = v + 37u64;
                }
                c = c + 1u32;
            }
            dealloc(mem);
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 120.. three-way: indexed <-> unindexed scan <-> model ──────────────────

/// Builds the indexed buffer AND its unindexed twin over the same model, then
/// compares every query three ways. `dense` runs the exhaustive sweeps (small
/// sizes); otherwise the probes are sampled so deep corpora stay linear.
fn check_three_way(cols: u32, rows: u64, dense: bool, seed: &mut u64) -> i32 {
    let m: Model = model_random(cols, rows, false, seed);
    return check_three_way_with(&m, dense);
}

fn check_three_way_with(m: &Model, dense: bool) -> i32 {
    let cols: u32 = m.cols;
    let rows: u64 = m.rows;

    let di: PdtDescr = descr_indexed(cols);
    let ds: PdtDescr = descr_for(cols, PDT_ORD_SUM);
    let bsi: u32 = pdtbuf_compute_block_size_fse(&di, rows);
    let bss: u32 = pdtbuf_compute_block_size_fse(&ds, rows);

    unsafe {
        let memi: *mut u8 = alloc(bsi as i64);
        let mems: *mut u8 = alloc(bss as i64);
        let mut bi: PdtBuf = match pdtbuf_create(memi, bsi, &di, rows) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(memi);
                dealloc(mems);
                return 120000i32;
            }
        };
        let mut bs2: PdtBuf = match pdtbuf_create(mems, bss, &ds, rows) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(memi);
                dealloc(mems);
                return 120001i32;
            }
        };
        fill_from_model(&mut bi, m);
        fill_from_model(&mut bs2, m);
        bi.reindex();
        let rc: i32 = check_three_way_body(&bi, &bs2, m, dense);
        dealloc(memi);
        dealloc(mems);
        return rc;
    }
}

fn check_three_way_body(bi: &PdtBuf, bs2: &PdtBuf, m: &Model, dense: bool) -> i32 {
    let cols: u32 = m.cols;
    let rows: u64 = m.rows;

    // The unindexed twin must genuinely have no index — otherwise the third
    // leg is not independent and the whole comparison is vacuous.
    if bs2.has_index() {
        return 121000i32;
    }
    if bi.has_index() != (rows > 32u64) {
        return 121001i32;
    }
    // DEPTH: the tree really is multi-level at deep sizes.
    if bi.index_levels() != model_index_levels(rows) {
        return 122i32;
    }
    // check() verifies index geometry AND recomputes every cell at every
    // level from the index-free scan.
    if bi.check() != 0i32 {
        return 123i32;
    }

    // THE DEFINING PROPERTY, asserted directly against the model: level-1
    // cell (c,k) is the PARTIAL sum of span k. A prefix-sum index would agree
    // at k = 0 and disagree at every k >= 1 with a non-empty preceding span.
    if bi.has_index() {
        let ix: PdtBuf = bi.index();
        let spans: u64 = (rows + 31u64) / 32u64;
        if ix.size() != spans {
            return 124i32;
        }
        let mut c: u32 = 0u32;
        while c < cols {
            let mut k: u64 = 0u64;
            while k < spans {
                if ix.get(c, k) != model_span_sum(m, c, k) {
                    return 125i32;
                }
                k = k + 1u64;
            }
            c = c + 1u32;
        }
    }

    // Prefix sums, three ways.
    let mut c2: u32 = 0u32;
    while c2 < cols {
        let step: u64 = if dense { 1u64 } else { rows / 61u64 + 1u64 };
        let mut k: u64 = 0u64;
        while k <= rows {
            let vi: u64 = bi.sum_prefix(c2, k);
            if vi != bs2.sum_prefix(c2, k) {
                return 126000i32;
            }
            if vi != model_prefix(m, c2, k) {
                return 126001i32;
            }
            k = k + step;
        }
        // The boundary rows the stride may have stepped over: every span
        // edge and its neighbours, where the descent hands off to the scan.
        let mut e: u64 = 0u64;
        while e <= rows {
            let mut o: u64 = 0u64;
            while o < 3u64 {
                let p: u64 = if e + o > 0u64 { e + o - 1u64 } else { 0u64 };
                if p <= rows {
                    let vb: u64 = bi.sum_prefix(c2, p);
                    if vb != bs2.sum_prefix(c2, p) || vb != model_prefix(m, c2, p) {
                        return 127i32;
                    }
                }
                o = o + 1u64;
            }
            e = e + 32u64;
        }
        c2 = c2 + 1u32;
    }

    // Searches, three ways, over the probe set that covers every attainable
    // answer (dense) or a stride through the value range (deep).
    let mut c3: u32 = 0u32;
    while c3 < cols {
        let total: u64 = model_prefix(m, c3, rows);
        let mut probes: Vec<u64> = vec_new::<u64>();
        probes.push(0u64);
        probes.push(1u64);
        probes.push(total);
        probes.push(total + 1u64);
        if dense {
            let mut k2: u64 = 0u64;
            while k2 <= rows {
                let p: u64 = model_prefix(m, c3, k2);
                probes.push(p);
                if p > 0u64 {
                    probes.push(p - 1u64);
                }
                probes.push(p + 1u64);
                k2 = k2 + 1u64;
            }
        } else {
            // Every span boundary's prefix, plus its neighbours: exactly the
            // values at which the index descent picks a different span.
            let mut e2: u64 = 0u64;
            while e2 <= rows {
                let p: u64 = model_prefix(m, c3, e2);
                probes.push(p);
                if p > 0u64 {
                    probes.push(p - 1u64);
                }
                probes.push(p + 1u64);
                e2 = e2 + 32u64;
            }
        }
        let np: i64 = probes.length();
        let mut pi: i64 = 0i64;
        while pi < np {
            let v: u64 = probes.get(pi);
            let ge: PdtFind = bi.find_ge(c3, v);
            let gt: PdtFind = bi.find_gt(c3, v);
            let sge: PdtFind = bs2.find_ge(c3, v);
            let sgt: PdtFind = bs2.find_gt(c3, v);
            if ge.idx != sge.idx || ge.prefix != sge.prefix {
                return 128000i32;
            }
            if gt.idx != sgt.idx || gt.prefix != sgt.prefix {
                return 128001i32;
            }
            let mge: PdtFind = model_find_sum(m, c3, v, false, 0u64);
            let mgt: PdtFind = model_find_sum(m, c3, v, true, 0u64);
            if ge.idx != mge.idx || ge.prefix != mge.prefix {
                return 129000i32;
            }
            if gt.idx != mgt.idx || gt.prefix != mgt.prefix {
                return 129001i32;
            }
            // LAW carried over from P0: the reported prefix IS the prefix sum
            // at the hit row — now computed through the index on both sides.
            if ge.prefix != bi.sum_prefix(c3, ge.idx) {
                return 129002i32;
            }
            pi = pi + 1i64;
        }
        c3 = c3 + 1u32;
    }

    // ── P2 rides the SAME three legs, at the same sizes and column counts ──
    let rf: i32 = check_from_forms(bi, bs2, m, dense);
    if rf != 0i32 {
        return rf;
    }
    return check_backward(bi, bs2, m, dense);
}

// ═══ P2: the start-relative and backward search families ════════════════════
//
// ORACLE STRATEGY, unchanged: the port answers both families by DERIVATION
// over its single forward descent (rebase for from-index, complement for
// backward), so the judge must not share that algorithm. It does not:
// model_find_sum is a forward walk and model_find_bw is a backward walk, both
// written from the definition, and the unindexed twin supplies the third leg
// so an index bug shows up before the model is even consulted.
//
// The LAWS this rung leans on, each asserted below:
//   from-index consistency  find_*_from(0, v)          == find_*(v)
//   residual identity       find_ge_from(s, v).prefix  == sum(s, idx)
//                           and the answer never precedes s
//   suffix equivalence      find_*_from(s, v) over the buffer == a fresh
//                           find over a buffer holding only rows [s, size)
//   backward/forward duality
//                           find_bw_*(e, v).idx == e-1 - find_*(rev, v).idx
//   ge/gt separation        the rows strictly between the two answers carry
//                           no weight (the multiplicity identity's SUM
//                           reading: ge and gt part ways exactly across a
//                           run of zero-valued rows), in both directions
//   not-found               forward (size, total); backward (e, total[0,e))

fn push_if(out: &mut Vec<u64>, v: u64, top: u64) {
    if v < top {
        out.push(v);
    }
}

/// A start set that is EXHAUSTIVE when it can be (dense: every legal start)
/// and boundary-focused when it cannot. The sampled set is not a stride: it
/// is the set of places where the descent changes character — 0, the first
/// span edges and their neighbours, the midpoint, the last span edge, the
/// last row, the end — because a start-relative bug that survives those
/// survives a stride too. `inclusive_end` picks the backward form's legal
/// range [0, rows) over the forward form's [0, rows].
fn starts_for(rows: u64, dense: bool, inclusive_end: bool) -> Vec<u64> {
    let top: u64 = if inclusive_end { rows } else { rows + 1u64 };
    let mut out: Vec<u64> = vec_new::<u64>();
    if top == 0u64 {
        return out;
    }
    if dense {
        let mut i: u64 = 0u64;
        while i < top {
            out.push(i);
            i = i + 1u64;
        }
        return out;
    }
    push_if(&mut out, 0u64, top);
    push_if(&mut out, 1u64, top);
    push_if(&mut out, 31u64, top);
    push_if(&mut out, 32u64, top);
    push_if(&mut out, 33u64, top);
    push_if(&mut out, 1024u64, top);
    push_if(&mut out, 1025u64, top);
    let mid: u64 = rows / 2u64;
    push_if(&mut out, mid, top);
    push_if(&mut out, mid + 1u64, top);
    if rows >= 33u64 {
        // The last whole span edge, where the descent's residual scan is
        // shortest and the clamp arithmetic is tightest.
        push_if(&mut out, (rows / 32u64) * 32u64, top);
    }
    if rows > 0u64 {
        push_if(&mut out, rows - 1u64, top);
    }
    out.push(top - 1u64);
    return out;
}

/// The value probes: 0 and 1 always (0 is the plateau value that carries both
/// faces of bug #27), the total and its neighbours, and the prefixes at the
/// cut points — every row when `dense`, else the span boundaries nearest the
/// ends and the middle. Reused by both P2 families.
fn probes_for(m: &Model, c: u32, dense: bool) -> Vec<u64> {
    let rows: u64 = m.rows;
    let total: u64 = model_prefix(m, c, rows);
    let mut probes: Vec<u64> = vec_new::<u64>();
    probes.push(0u64);
    probes.push(1u64);
    probes.push(total);
    probes.push(total + 1u64);
    if total > 0u64 {
        probes.push(total - 1u64);
    }
    let mut cuts: Vec<u64> = vec_new::<u64>();
    if dense {
        let mut k: u64 = 0u64;
        while k <= rows {
            cuts.push(k);
            k = k + 1u64;
        }
    } else {
        cuts = starts_for(rows, false, false);
    }
    let nc: i64 = cuts.length();
    let mut i: i64 = 0i64;
    while i < nc {
        let p: u64 = model_prefix(m, c, cuts.get(i));
        probes.push(p);
        if p > 0u64 {
            probes.push(p - 1u64);
        }
        probes.push(p + 1u64);
        i = i + 1i64;
    }
    return probes;
}

// ── 140.. the index-accelerated from-index forms ───────────────────────────

fn check_from_forms(bi: &PdtBuf, bs2: &PdtBuf, m: &Model, dense: bool) -> i32 {
    let cols: u32 = m.cols;
    let rows: u64 = m.rows;
    let mut c: u32 = 0u32;
    while c < cols {
        let probes: Vec<u64> = probes_for(m, c, dense);
        let starts: Vec<u64> = starts_for(rows, dense, false);
        let np: i64 = probes.length();
        let ns: i64 = starts.length();
        let mut si: i64 = 0i64;
        while si < ns {
            let st: u64 = starts.get(si);
            // Hoisted: O(rows) in the model, and constant across the probes.
            let residual: u64 = model_range(m, c, st, rows);
            let mut pi: i64 = 0i64;
            while pi < np {
                let v: u64 = probes.get(pi);
                let ge: PdtFind = bi.find_ge_from(c, st, v);
                let gt: PdtFind = bi.find_gt_from(c, st, v);
                // Leg 2: the unindexed twin. The indexed form takes a
                // completely different route to the same answer, so this is
                // where an index-descent bug surfaces first.
                let sge: PdtFind = bs2.find_ge_from(c, st, v);
                let sgt: PdtFind = bs2.find_gt_from(c, st, v);
                if ge.idx != sge.idx || ge.prefix != sge.prefix {
                    return 140000i32;
                }
                if gt.idx != sgt.idx || gt.prefix != sgt.prefix {
                    return 140001i32;
                }
                // Leg 3: the independent walk.
                let mge: PdtFind = model_find_sum(m, c, v, false, st);
                let mgt: PdtFind = model_find_sum(m, c, v, true, st);
                if ge.idx != mge.idx || ge.prefix != mge.prefix {
                    return 141000i32;
                }
                if gt.idx != mgt.idx || gt.prefix != mgt.prefix {
                    return 141001i32;
                }
                // LAW (no answer precedes its start). This is C++ bug #27's
                // first face: its rebase delegates to the global search and
                // never clamps, so at v == 0 with leading zero rows it
                // answers with an index BELOW `start`.
                if ge.idx < st || gt.idx < st {
                    return 142i32;
                }
                // LAW (residual identity): the reported prefix is the range
                // sum from the start to the hit, and the hit's inclusive sum
                // crosses `v` exactly there.
                if ge.prefix != bi.sum(c, st, ge.idx) {
                    return 143000i32;
                }
                if gt.prefix != bi.sum(c, st, gt.idx) {
                    return 143001i32;
                }
                if ge.idx < rows {
                    if v > ge.prefix + bi.get(c, ge.idx) {
                        return 144000i32;
                    }
                }
                if gt.idx < rows {
                    if v >= gt.prefix + bi.get(c, gt.idx) {
                        return 144001i32;
                    }
                }
                // LAW (not-found): idx == size iff no row of the residual can
                // meet the demand, and then the prefix is the whole residual.
                // The two strictnesses part ways on the EMPTY residual: a
                // zero demand is met by the first row examined, so it is
                // not-found only when there is no row to examine at all,
                // while a strict demand of 0 needs weight and an empty
                // residual has none. (This is the same asymmetry that puts
                // the val == 0 clamp in the port; here it is stated from the
                // model's side, so agreement is not a shared assumption.)
                if (ge.idx == rows) != (st >= rows || v > residual) {
                    return 145000i32;
                }
                if (gt.idx == rows) != (v >= residual) {
                    return 145001i32;
                }
                if ge.idx == rows && ge.prefix != residual {
                    return 145002i32;
                }
                if gt.idx == rows && gt.prefix != residual {
                    return 145003i32;
                }
                // LAW (gt never precedes ge).
                if gt.idx < ge.idx {
                    return 146i32;
                }
                pi = pi + 1i64;
            }
            si = si + 1i64;
        }
        // LAW (from-index consistency): start 0 IS the plain form.
        let mut pj: i64 = 0i64;
        while pj < np {
            let v2: u64 = probes.get(pj);
            let a: PdtFind = bi.find_ge_from(c, 0u64, v2);
            let b: PdtFind = bi.find_ge(c, v2);
            if a.idx != b.idx || a.prefix != b.prefix {
                return 147000i32;
            }
            let a2: PdtFind = bi.find_gt_from(c, 0u64, v2);
            let b2: PdtFind = bi.find_gt(c, v2);
            if a2.idx != b2.idx || a2.prefix != b2.prefix {
                return 147001i32;
            }
            pj = pj + 1i64;
        }
        c = c + 1u32;
    }
    return 0i32;
}

// ── 150.. the backward family ──────────────────────────────────────────────

fn check_backward(bi: &PdtBuf, bs2: &PdtBuf, m: &Model, dense: bool) -> i32 {
    let cols: u32 = m.cols;
    let rows: u64 = m.rows;
    let mut c: u32 = 0u32;
    while c < cols {
        let probes: Vec<u64> = probes_for(m, c, dense);
        let np: i64 = probes.length();
        let total: u64 = model_prefix(m, c, rows);

        // The full-buffer form, three ways.
        let mut pi: i64 = 0i64;
        while pi < np {
            let v: u64 = probes.get(pi);
            let ge: PdtFind = bi.find_bw_ge(c, v);
            let gt: PdtFind = bi.find_bw_gt(c, v);
            let sge: PdtFind = bs2.find_bw_ge(c, v);
            let sgt: PdtFind = bs2.find_bw_gt(c, v);
            if ge.idx != sge.idx || ge.prefix != sge.prefix {
                return 150000i32;
            }
            if gt.idx != sgt.idx || gt.prefix != sgt.prefix {
                return 150001i32;
            }
            let mge: PdtFind = model_find_bw(m, c, rows, v, false);
            let mgt: PdtFind = model_find_bw(m, c, rows, v, true);
            if ge.idx != mge.idx || ge.prefix != mge.prefix {
                return 151000i32;
            }
            if gt.idx != mgt.idx || gt.prefix != mgt.prefix {
                return 151001i32;
            }
            // LAW (not-found, DERIVED): the backward walk fails exactly when
            // the whole column cannot meet the demand, and then reports the
            // exclusive end (= size for the full form) with everything it
            // accumulated. The forward convention (size, total) is the same
            // statement — which is why the two coincide here.
            if (ge.idx == rows) != (rows == 0u64 || v > total) {
                return 152000i32;
            }
            if (gt.idx == rows) != (v >= total) {
                return 152001i32;
            }
            if ge.idx == rows && ge.prefix != total {
                return 152002i32;
            }
            if gt.idx == rows && gt.prefix != total {
                return 152003i32;
            }
            // LAW (bracketing, mirrored): for a hit, the accumulation before
            // the hit row falls short and including it crosses `v`.
            if ge.idx < rows {
                if ge.prefix + model_get(m, c, ge.idx) < v {
                    return 153000i32;
                }
                if ge.prefix >= v && v > 0u64 {
                    return 153001i32;
                }
                // ... and the reported prefix IS the suffix sum above the hit.
                if ge.prefix != model_range(m, c, ge.idx + 1u64, rows) {
                    return 153002i32;
                }
            }
            if gt.idx < rows {
                if gt.prefix + model_get(m, c, gt.idx) <= v {
                    return 154000i32;
                }
                if gt.prefix != model_range(m, c, gt.idx + 1u64, rows) {
                    return 154001i32;
                }
            }
            // LAW (ge/gt separation, backward reading). ge never precedes gt
            // going backward — the mirror of "gt never precedes ge" forward —
            // and the rows STRICTLY between the two answers carry no weight:
            // the accumulation is pinned at exactly `v` across that stretch,
            // so every row in it must be zero. This is the SUM reading of the
            // multiplicity identity, and it is the law that bites if a
            // plateau is resolved at the wrong end.
            if ge.idx < rows && gt.idx < rows {
                if ge.idx < gt.idx {
                    return 155000i32;
                }
                let mut z: u64 = gt.idx + 1u64;
                while z + 1u64 <= ge.idx {
                    if model_get(m, c, z) != 0u64 {
                        return 155001i32;
                    }
                    z = z + 1u64;
                }
            }
            pi = pi + 1i64;
        }

        // LAW (backward/forward DUALITY). A backward search over [0, rows) is
        // the forward search over the ROW-REVERSED corpus, with the answer
        // index mirrored: bw.idx == rows-1 - fw_rev.idx, and the prefixes are
        // literally the same number (both are "what was accumulated before
        // the hit row"). Not-found maps to not-found. This is the strongest
        // statement of what "backward" means and it is checked against a
        // physically reversed model, not against the complement identity the
        // port uses.
        if rows > 0u64 {
            let rev: Model = model_reversed(m, rows);
            let mut pk: i64 = 0i64;
            while pk < np {
                let v3: u64 = probes.get(pk);
                let bge: PdtFind = bi.find_bw_ge(c, v3);
                let fge: PdtFind = model_find_sum(&rev, c, v3, false, 0u64);
                if bge.idx == rows {
                    if fge.idx != rows {
                        return 156000i32;
                    }
                } else {
                    if bge.idx != rows - 1u64 - fge.idx {
                        return 156001i32;
                    }
                }
                if bge.prefix != fge.prefix {
                    return 156002i32;
                }
                let bgt: PdtFind = bi.find_bw_gt(c, v3);
                let fgt: PdtFind = model_find_sum(&rev, c, v3, true, 0u64);
                if bgt.idx == rows {
                    if fgt.idx != rows {
                        return 157000i32;
                    }
                } else {
                    if bgt.idx != rows - 1u64 - fgt.idx {
                        return 157001i32;
                    }
                }
                if bgt.prefix != fgt.prefix {
                    return 157002i32;
                }
                pk = pk + 1i64;
            }
        }

        // The from-index backward form (`start` INCLUSIVE), three ways, over
        // the same start set the forward from-form uses.
        let starts: Vec<u64> = starts_for(rows, dense, true);
        let ns: i64 = starts.length();
        let mut sj: i64 = 0i64;
        while sj < ns {
            let st: u64 = starts.get(sj);
            let end: u64 = st + 1u64;
            let sub: u64 = model_prefix(m, c, end);
            let mut pm: i64 = 0i64;
            while pm < np {
                let v4: u64 = probes.get(pm);
                let ge2: PdtFind = bi.find_bw_ge_from(c, st, v4);
                let gt2: PdtFind = bi.find_bw_gt_from(c, st, v4);
                let sge2: PdtFind = bs2.find_bw_ge_from(c, st, v4);
                let sgt2: PdtFind = bs2.find_bw_gt_from(c, st, v4);
                if ge2.idx != sge2.idx || ge2.prefix != sge2.prefix {
                    return 158000i32;
                }
                if gt2.idx != sgt2.idx || gt2.prefix != sgt2.prefix {
                    return 158001i32;
                }
                let mge2: PdtFind = model_find_bw(m, c, end, v4, false);
                let mgt2: PdtFind = model_find_bw(m, c, end, v4, true);
                if ge2.idx != mge2.idx || ge2.prefix != mge2.prefix {
                    return 159000i32;
                }
                if gt2.idx != mgt2.idx || gt2.prefix != mgt2.prefix {
                    return 159001i32;
                }
                // LAW (the answer stays inside the walk's range, and the
                // not-found sentinel is exactly one past its origin). C++ bug
                // #27's second face is an answer ABOVE `start` at v == 0.
                if ge2.idx > end || gt2.idx > end {
                    return 159002i32;
                }
                if (ge2.idx == end) != (v4 > sub) {
                    return 159003i32;
                }
                if (gt2.idx == end) != (v4 >= sub) {
                    return 159004i32;
                }
                pm = pm + 1i64;
            }
            sj = sj + 1i64;
        }

        // LAW (from-index consistency, backward reading): the last row IS the
        // full-buffer form.
        if rows > 0u64 {
            let mut pn: i64 = 0i64;
            while pn < np {
                let v5: u64 = probes.get(pn);
                let a: PdtFind = bi.find_bw_ge_from(c, rows - 1u64, v5);
                let b: PdtFind = bi.find_bw_ge(c, v5);
                if a.idx != b.idx || a.prefix != b.prefix {
                    return 155002i32;
                }
                let a2: PdtFind = bi.find_bw_gt_from(c, rows - 1u64, v5);
                let b2: PdtFind = bi.find_bw_gt(c, v5);
                if a2.idx != b2.idx || a2.prefix != b2.prefix {
                    return 155003i32;
                }
                pn = pn + 1i64;
            }
        }
        c = c + 1u32;
    }
    return 0i32;
}

// ── 148.. the ZERO-PLATEAU corpora (C++ bug #27's home ground) ─────────────
//
// Both faces of #27 need a prefix PLATEAU — a run of zero-valued rows — to
// show themselves, because that is the only situation in which a prefix
// target is attained by more than one row index and the delegated forward
// search can resolve it at the wrong end. The random corpus (values mod 23)
// carries about 4% zeros, which reaches the case but does not aim at it.
// These corpora aim at it: leading zeros, trailing zeros, interior runs
// crossing a span boundary, an all-zero column, and a single carrier row.
// Every one runs the FULL P2 body (three-way + every law), at column counts
// 1..4 and at sizes on both sides of the span threshold and of the second
// level, so the plateaus land inside spans, across span edges, and across
// whole empty spans.
fn model_plateau(cols: u32, rows: u64, kind: u32) -> Model {
    let mut m: Model = model_new(cols, rows);
    let mut c: u32 = 0u32;
    while c < cols {
        let mut r: u64 = 0u64;
        while r < rows {
            let mut v: u64 = 0u64;
            if kind == 0u32 {
                // Leading zeros: nothing until a third of the way in.
                if r >= rows / 3u64 {
                    v = 1u64 + ((r + (c as u64)) % 5u64);
                }
            } else if kind == 1u32 {
                // Trailing zeros: everything, then nothing.
                if r < rows / 3u64 {
                    v = 1u64 + ((r + (c as u64)) % 5u64);
                }
            } else if kind == 2u32 {
                // Interior runs of 31 zeros: every plateau straddles a span
                // boundary at some column offset.
                if (r % 32u64) == ((c as u64) % 32u64) {
                    v = 3u64;
                }
            } else if kind == 3u32 {
                // A single carrier row, everything else empty. The extreme
                // plateau: one step, arbitrarily far from both ends.
                if rows > 0u64 && r == rows / 2u64 {
                    v = 7u64;
                }
            } else {
                // All zero: total 0, every query degenerate.
                v = 0u64;
            }
            model_set(&mut m, c, r, v);
            r = r + 1u64;
        }
        c = c + 1u32;
    }
    return m;
}

/// The DEEPEST-LEVEL assertion for P2, stated as a literal rather than
/// inferred from the sweep: 32769 rows carry three index levels
/// (32769 -> 1025 -> 33 -> 2), check_three_way_with asserts the buffer really
/// has that many, and it then runs the full P2 body — so "the backward and
/// from-index forms descend through three levels" is a MEASURED property of
/// this gate. Run at 3 columns, i.e. on the >=3-column canary shape, at full
/// depth. If the deep sweep above were ever trimmed, this stays.
fn check_p2_depth(seed: &mut u64) -> i32 {
    let rows: u64 = 32769u64;
    if model_index_levels(rows) != 3u32 {
        return 148i32;
    }
    let m: Model = model_random(3u32, rows, false, seed);
    return check_three_way_with(&m, false);
}

fn check_zero_plateaus() -> i32 {
    let sizes: [u64; 8] = [1u64, 31u64, 32u64, 33u64, 64u64, 65u64, 100u64, 1025u64];
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let mut si: i64 = 0i64;
        while si < 8i64 {
            let rows: u64 = sizes[si];
            let dense: bool = rows <= 65u64;
            let mut kind: u32 = 0u32;
            while kind <= 4u32 {
                let m: Model = model_plateau(cols, rows, kind);
                let rc: i32 = check_three_way_with(&m, dense);
                if rc != 0i32 {
                    return rc;
                }
                kind = kind + 1u32;
            }
            si = si + 1i64;
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 149.. HAZARD (a): the UNDER-COVERING index ─────────────────────────────
//
// The from-index and backward forms reach the span index only through
// sum_prefix and find_fw_sum, and neither does span arithmetic on `start` of
// its own: `start / 32` is clamped against index.size() in ONE place. Section
// 119 (P1) pinned the extreme case of that clamp — an index of size 0 — for
// the forward forms; this section pins the general one for every P2 form.
//
// THE STATE. The invariant the queries actually depend on is WEAKER than the
// one check() enforces. check() demands index.size() == div_up(size, 32) (or
// 0); the queries only need "the index's live cells are complete span sums of
// a PREFIX of the rows", because both the clamp and find_fw_sum's derived
// residual resume the scan at index.size() * 32. So the state built here is
// an index over the first `cov` rows — cov a MULTIPLE of the span, so every
// live cell is a complete span — while `size` is much larger. That is the
// under-covering index C++ bug #26 answers wrongly: it reports "not found
// over the whole buffer" having read none of the rows past cov.
//
// The state deliberately fails check() (code 8), which is the point: the
// QUERIES must still be right, by degrading to a longer scan. Removing the
// clamp in sum_prefix turns this section into an out-of-range index read;
// transcribing HEAD's index-miss short-circuit makes it answer not-found.
fn check_under_covering_index(seed: &mut u64) -> i32 {
    let covered: [u64; 4] = [0u64, 32u64, 64u64, 128u64];
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let rows: u64 = 200u64;
        let m: Model = model_random(cols, rows, false, seed);
        let d: PdtDescr = descr_indexed(cols);
        let bs: u32 = pdtbuf_compute_block_size_fse(&d, rows);
        let mut ci: i64 = 0i64;
        while ci < 4i64 {
            let cov: u64 = covered[ci];
            unsafe {
                let mem: *mut u8 = alloc(bs as i64);
                let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, rows) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem);
                        return 149000i32;
                    }
                };
                fill_from_model(&mut b, &m);
                // Build the index over only `cov` rows, then publish all of
                // them. The index now describes a PREFIX of the buffer.
                b.set_size(cov);
                b.reindex();
                b.set_size(rows);
                if !b.has_index() {
                    dealloc(mem);
                    return 149001i32;
                }
                if b.index().size() != (cov + 31u64) / 32u64 {
                    dealloc(mem);
                    return 149002i32;
                }
                let mut c: u32 = 0u32;
                while c < cols {
                    let total: u64 = model_prefix(&m, c, rows);
                    // Prefix sums stay exact past the index's coverage.
                    let mut k: u64 = 0u64;
                    while k <= rows {
                        if b.sum_prefix(c, k) != model_prefix(&m, c, k) {
                            dealloc(mem);
                            return 149003i32;
                        }
                        k = k + 1u64;
                    }
                    let mut v: u64 = 0u64;
                    while v <= total + 2u64 {
                        // Forward, from-index (both strictnesses), and both
                        // backward forms — every P2 entry point.
                        let mut st: u64 = 0u64;
                        while st <= rows {
                            let f1: PdtFind = b.find_ge_from(c, st, v);
                            let m1: PdtFind = model_find_sum(&m, c, v, false, st);
                            if f1.idx != m1.idx || f1.prefix != m1.prefix {
                                dealloc(mem);
                                return 149004i32;
                            }
                            let f2: PdtFind = b.find_gt_from(c, st, v);
                            let m2: PdtFind = model_find_sum(&m, c, v, true, st);
                            if f2.idx != m2.idx || f2.prefix != m2.prefix {
                                dealloc(mem);
                                return 149005i32;
                            }
                            if st < rows {
                                let f3: PdtFind = b.find_bw_ge_from(c, st, v);
                                let m3: PdtFind = model_find_bw(&m, c, st + 1u64, v, false);
                                if f3.idx != m3.idx || f3.prefix != m3.prefix {
                                    dealloc(mem);
                                    return 149006i32;
                                }
                                let f4: PdtFind = b.find_bw_gt_from(c, st, v);
                                let m4: PdtFind = model_find_bw(&m, c, st + 1u64, v, true);
                                if f4.idx != m4.idx || f4.prefix != m4.prefix {
                                    dealloc(mem);
                                    return 149007i32;
                                }
                            }
                            st = st + 37u64;
                        }
                        let f5: PdtFind = b.find_bw_ge(c, v);
                        let m5: PdtFind = model_find_bw(&m, c, rows, v, false);
                        if f5.idx != m5.idx || f5.prefix != m5.prefix {
                            dealloc(mem);
                            return 149008i32;
                        }
                        let f6: PdtFind = b.find_bw_gt(c, v);
                        let m6: PdtFind = model_find_bw(&m, c, rows, v, true);
                        if f6.idx != m6.idx || f6.prefix != m6.prefix {
                            dealloc(mem);
                            return 149009i32;
                        }
                        v = v + 53u64;
                    }
                    c = c + 1u32;
                }
                dealloc(mem);
            }
            ci = ci + 1i64;
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 80.. / 90.. / 130.. the C++ HEAD cross-check ───────────────────────────

fn check_fixture_case(s: str, pos: &mut i64) -> i32 {
    let ord_tok: u64 = next_tok(s, pos);
    let cols: u32 = next_tok(s, pos) as u32;
    let rows: u64 = next_tok(s, pos);
    let ordering: u32 = if ord_tok == 0u64 { PDT_ORD_SUM } else { PDT_ORD_MAX };

    let mut m: Model = model_new(cols, rows);
    let mut r: u64 = 0u64;
    while r < rows {
        let mut c: u32 = 0u32;
        while c < cols {
            model_set(&mut m, c, r, next_tok(s, pos));
            c = c + 1u32;
        }
        r = r + 1u64;
    }

    let d: PdtDescr = descr_for(cols, ordering);
    let bs: u32 = pdtbuf_compute_block_size_fse(&d, rows);
    unsafe {
        let mem: *mut u8 = alloc(bs as i64);
        let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, rows) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 80i32;
            }
        };
        fill_from_model(&mut b, &m);
        let rc: i32 = check_fixture_body(&b, &m, ordering, s, pos);
        dealloc(mem);
        return rc;
    }
}

fn check_fixture_body(b: &PdtBuf, m: &Model, ordering: u32, s: str, pos: &mut i64) -> i32 {
    // The buffer must first agree with our OWN model — the C++ tokens are
    // only consulted afterwards, so a fixture can never be what defines
    // correctness here.
    let mut c: u32 = 0u32;
    while c < m.cols {
        let mut r: u64 = 0u64;
        while r < m.rows {
            if b.get(c, r) != model_get(m, c, r) {
                return 81i32;
            }
            r = r + 1u64;
        }
        c = c + 1u32;
    }

    let n_sum: u64 = next_tok(s, pos);
    let mut i: u64 = 0u64;
    while i < n_sum {
        let col: u32 = next_tok(s, pos) as u32;
        let start: u64 = next_tok(s, pos);
        let end: u64 = next_tok(s, pos);
        let want: u64 = next_tok(s, pos);
        if b.sum(col, start, end) != want {
            return 82i32;
        }
        i = i + 1u64;
    }

    let n_find: u64 = next_tok(s, pos);
    let mut j: u64 = 0u64;
    while j < n_find {
        let op: u64 = next_tok(s, pos);
        let col2: u32 = next_tok(s, pos) as u32;
        let val: u64 = next_tok(s, pos);
        let widx: u64 = next_tok(s, pos);
        let wpfx: u64 = next_tok(s, pos);
        let got: PdtFind = if op == 0u64 { b.find_ge(col2, val) } else { b.find_gt(col2, val) };
        if got.idx != widx {
            return 83i32;
        }
        if got.prefix != wpfx {
            return 84i32;
        }
        j = j + 1u64;
    }

    // 90.. the sum_gen DIVERGENCE, asserted as such: on MAX buffers the C++
    // sum(column,row) returns the SUFFIX [row, size). We return the prefix
    // [0, row) for every ordering — the only reading under which the C++'s
    // own sum(c,start,end) = sum(end) - sum(start) identity is the range sum.
    // If upstream ever fixes sum_gen, this assertion flips and tells us.
    let n_gen: u64 = next_tok(s, pos);
    let mut k: u64 = 0u64;
    while k < n_gen {
        let col3: u32 = next_tok(s, pos) as u32;
        let row: u64 = next_tok(s, pos);
        let cpp: u64 = next_tok(s, pos);
        if ordering != PDT_ORD_MAX {
            return 90i32;
        }
        if cpp != b.sum_all(col3) - b.sum_prefix(col3, row) {
            return 91i32;
        }
        k = k + 1u64;
    }
    return 0i32;
}

// ── 130.. the STRICT index gate: HEAD's recursive index cells, level by level
//
// A marker-2 case carries only (columns, rows, seed) plus HEAD's index cells:
// the corpus is regenerated here from the SAME LCG in the same column-major
// order, so the two sides are comparing structures built over byte-identical
// data. Wave-1 recon established that HEAD's recursive nested-buffer index is
// cell-for-cell the same 32-ary tree the deleted flat-layout FQTree carried,
// which is what makes this a meaningful equivalence rather than a tautology.
//
// This is EQUALITY, not evidence: an index cell has one right value (the
// partial sum of its span), section 12x already pinned that value against the
// independent model, and HEAD agrees. Where HEAD and the model disagree the
// model wins — no such disagreement was observed at this rung.
fn check_index_fixture_case(s: str, pos: &mut i64) -> i32 {
    let cols: u32 = next_tok(s, pos) as u32;
    let rows: u64 = next_tok(s, pos);
    let mut sd: u64 = next_tok(s, pos);
    let m: Model = model_random(cols, rows, false, &mut sd);

    let d: PdtDescr = descr_indexed(cols);
    let bs: u32 = pdtbuf_compute_block_size_fse(&d, rows);
    unsafe {
        let mem: *mut u8 = alloc(bs as i64);
        let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, rows) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 130i32;
            }
        };
        fill_from_model(&mut b, &m);
        b.reindex();
        let rc: i32 = check_index_fixture_body(&b, cols, s, pos);
        dealloc(mem);
        return rc;
    }
}

fn check_index_fixture_body(b: &PdtBuf, cols: u32, s: str, pos: &mut i64) -> i32 {
    // Our own structure first: the fixture is consulted only afterwards, so
    // it can never be what defines correctness here.
    if b.check() != 0i32 {
        return 131i32;
    }
    let n_levels: u64 = next_tok(s, pos);
    if (b.index_levels() as u64) != n_levels {
        return 132i32;
    }
    let mut cur: PdtBuf = *b;
    let mut l: u64 = 0u64;
    while l < n_levels {
        if !cur.has_index() {
            return 133i32;
        }
        let ix: PdtBuf = cur.index();
        let level_rows: u64 = next_tok(s, pos);
        if ix.size() != level_rows {
            return 134i32;
        }
        let mut r: u64 = 0u64;
        while r < level_rows {
            let mut c: u32 = 0u32;
            while c < cols {
                if ix.get(c, r) != next_tok(s, pos) {
                    return 135i32;
                }
                c = c + 1u32;
            }
            r = r + 1u64;
        }
        cur = ix;
        l = l + 1u64;
    }
    // Level count agrees EXACTLY: the recursion stops where HEAD's stops.
    if cur.has_index() {
        return 136i32;
    }
    return 0i32;
}

// ── 160.. the C++ HEAD DIRECTION cross-check (marker 3) ────────────────────
//
// The start-relative and backward families against HEAD, at row counts on
// both sides of the span threshold so HEAD is exercised on its scan path AND
// its index path. As with marker 2 the corpus is regenerated from (mode,
// seed, columns, rows) rather than dumped.
//
// The case carries TWO blocks, and the difference between them is the whole
// oracle discipline of this port:
//   <n_q>   queries where HEAD agrees with an implementation derived from the
//           definition. Cross-check fixtures: we must match them.
//   <n_div> queries where it does not. We must NOT match them — the gate
//           asserts the DISAGREEMENT — and we must match the model instead.
//
// Every <n_div> entry is a face of upstream bug candidate #27, and the shape
// of the set is itself the evidence: every single one is the NON-STRICT
// operation at val == 0, which is precisely the prefix-plateau case the
// derivation predicted before the harness was run.
//   status 0, dir 0: HEAD answers with a row BELOW `start`, and its
//                    FindResult::sub_prefix underflows (an observed prefix of
//                    2^64 - 2 for a true prefix of 0).
//   status 0, dir 1: HEAD answers with a row ABOVE `start` — outside the
//                    range the caller asked it to walk — prefix likewise
//                    underflowed.
//   status 1, dir 1/2: HEAD calls sum_sum(column, size + 1), tripping its own
//                    MEMORIA_ASSERT, which catches its throw and calls
//                    std::terminate(). The harness cannot even record an
//                    answer; it identifies these queries independently and
//                    reports them unexecuted. Our derivation answers them.
fn check_dir_fixture_case(s: str, pos: &mut i64) -> i32 {
    let cols: u32 = next_tok(s, pos) as u32;
    let rows: u64 = next_tok(s, pos);
    let mut sd: u64 = next_tok(s, pos);
    let mode: u64 = next_tok(s, pos);
    let m: Model = if mode == 0u64 {
        model_random(cols, rows, false, &mut sd)
    } else {
        model_plateau(cols, rows, 0u32)
    };

    let d: PdtDescr = descr_indexed(cols);
    let bs: u32 = pdtbuf_compute_block_size_fse(&d, rows);
    unsafe {
        let mem: *mut u8 = alloc(bs as i64);
        let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, rows) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 160i32;
            }
        };
        fill_from_model(&mut b, &m);
        b.reindex();
        let rc: i32 = check_dir_fixture_body(&b, &m, s, pos);
        dealloc(mem);
        return rc;
    }
}

/// Our answer for one (dir, op, start, val) triple.
fn dir_query(b: &PdtBuf, dir: u64, op: u64, c: u32, start: u64, v: u64) -> PdtFind {
    let strict: bool = op == 1u64;
    if dir == 0u64 {
        if strict {
            return b.find_gt_from(c, start, v);
        }
        return b.find_ge_from(c, start, v);
    }
    if dir == 1u64 {
        if strict {
            return b.find_bw_gt_from(c, start, v);
        }
        return b.find_bw_ge_from(c, start, v);
    }
    if strict {
        return b.find_bw_gt(c, v);
    }
    return b.find_bw_ge(c, v);
}

/// The same triple answered by the independent model.
fn dir_model(m: &Model, dir: u64, op: u64, c: u32, start: u64, v: u64) -> PdtFind {
    let strict: bool = op == 1u64;
    if dir == 0u64 {
        return model_find_sum(m, c, v, strict, start);
    }
    if dir == 1u64 {
        return model_find_bw(m, c, start + 1u64, v, strict);
    }
    return model_find_bw(m, c, m.rows, v, strict);
}

fn check_dir_fixture_body(b: &PdtBuf, m: &Model, s: str, pos: &mut i64) -> i32 {
    let n_q: u64 = next_tok(s, pos);
    let mut i: u64 = 0u64;
    while i < n_q {
        let dir: u64 = next_tok(s, pos);
        let op: u64 = next_tok(s, pos);
        let c: u32 = next_tok(s, pos) as u32;
        let start: u64 = next_tok(s, pos);
        let v: u64 = next_tok(s, pos);
        let widx: u64 = next_tok(s, pos);
        let wpfx: u64 = next_tok(s, pos);
        // The MODEL first — the fixture is consulted only after our own
        // independent judge has passed, so it can never be what defines
        // correctness here.
        let mm: PdtFind = dir_model(m, dir, op, c, start, v);
        let got: PdtFind = dir_query(b, dir, op, c, start, v);
        if got.idx != mm.idx || got.prefix != mm.prefix {
            return 161i32;
        }
        if got.idx != widx || got.prefix != wpfx {
            return 162i32;
        }
        i = i + 1u64;
    }

    let n_div: u64 = next_tok(s, pos);
    let mut j: u64 = 0u64;
    while j < n_div {
        let dir2: u64 = next_tok(s, pos);
        let op2: u64 = next_tok(s, pos);
        let c2: u32 = next_tok(s, pos) as u32;
        let start2: u64 = next_tok(s, pos);
        let v2: u64 = next_tok(s, pos);
        let status: u64 = next_tok(s, pos);
        let cidx: u64 = next_tok(s, pos);
        let cpfx: u64 = next_tok(s, pos);
        let mm2: PdtFind = dir_model(m, dir2, op2, c2, start2, v2);
        let got2: PdtFind = dir_query(b, dir2, op2, c2, start2, v2);
        // We answer, and we answer what the definition says — including the
        // queries HEAD cannot survive.
        if got2.idx != mm2.idx || got2.prefix != mm2.prefix {
            return 163i32;
        }
        // The DIVERGENCE is asserted, not conformed to. If upstream ever
        // fixes #27 this flips and reports it.
        if status == 0u64 {
            if got2.idx == cidx && got2.prefix == cpfx {
                return 164i32;
            }
        }
        // The predicted shape of the whole divergence set: non-strict, at the
        // plateau value 0. A #27 entry outside that class would mean the
        // derivation misses something and must be re-examined.
        if op2 != 0u64 || v2 != 0u64 {
            return 165i32;
        }
        j = j + 1u64;
    }
    return 0i32;
}

// ── 245..255 the C++ HEAD MUTATION TRACES (marker 4, rung P3) ──────────────
//
// The port REPLAYS HEAD's scripted op sequence — the same corpus, the same
// ops with the same parameters, the same inserted values, all read from the
// fixture — and compares the post-state after EVERY step: the probed rows and
// the index cells, level by level.
//
// The harness self-checks HEAD before emitting, two ways: post-state rows
// against a naive std::vector model of the op, and index cells against span
// sums RECOMPUTED FROM HEAD'S OWN ROWS (which is what catches a mutation that
// forgets to reindex — values right, every cached sum stale). Both verdicts
// travel with each step. The gate requires row parity unconditionally, and
// index parity wherever HEAD reports itself coherent; where it does not, the
// port must still satisfy its OWN check(), so an upstream incoherence is
// recorded rather than inherited.
//
// RESULT AT THIS RUNG, stated because a null result is a result: across all
// four column counts, all five row counts and all eight steps, HEAD's FSE/SUM
// mutation paths agree with the definition on both counts — 0 divergences.
// The catalogued defects in this neighbourhood (`do_prepare_remove`'s
// `column < 1` loop, the ~10 dead dispatcher targets) are unreachable dead
// code rather than wrong answers, and `split_to`'s missing budget is a
// structural gap that a single-threaded harness with a huge block cannot
// provoke. NO new upstream bug is claimed at P3 — a suspicion that does not
// survive checking is not a bug, and one of mine did not
// (do_commit_update_fxd_sum reindexes after all).
fn check_mut_fixture_case(s: str, pos: &mut i64) -> i32 {
    let cols: u32 = next_tok(s, pos) as u32;
    let rows: u64 = next_tok(s, pos);
    let seed0: u64 = next_tok(s, pos);

    // The corpus is a pure function of (seed, columns, rows) through the same
    // LCG in the same fill order on both sides — regenerated, not dumped.
    let mut seed: u64 = seed0;
    let mut m: Model = model_new(cols, rows);
    let mut c0: u32 = 0u32;
    while c0 < cols {
        let mut i: u64 = 0u64;
        while i < rows {
            model_set(&mut m, c0, i, lcg_next(&mut seed) % 23u64);
            i = i + 1u64;
        }
        c0 = c0 + 1u32;
    }

    let d: PdtDescr = descr_indexed(cols);
    let block: u32 = pdtbuf_compute_block_size_fse(&d, rows + 256u64);
    let nsteps: i64 = next_tok(s, pos) as i64;

    unsafe {
        let mem: *mut u8 = alloc(block as i64);
        let omem: *mut u8 = alloc(block as i64);
        let mut b: PdtBuf = match build_filled(mem, block, &d, rows, &m) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                dealloc(omem);
                return 246i32;
            }
        };
        let mut st: i64 = 0i64;
        while st < nsteps {
            let op: u64 = next_tok(s, pos);
            let a: u64 = next_tok(s, pos);
            let bb: u64 = next_tok(s, pos);
            let nin: i64 = next_tok(s, pos) as i64;
            let mut inputs: Vec<u64> = vec_new::<u64>();
            let mut k: i64 = 0i64;
            while k < nin {
                inputs.push(next_tok(s, pos));
                k = k + 1i64;
            }

            if op == 0u64 {
                match b.insert_rows(a, bb, &inputs) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 247i32;
                    }
                }
                m = model_insert(&m, a, bb, &inputs);
            } else if op == 1u64 {
                match b.update_rows(a, bb, &inputs) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 248i32;
                    }
                }
                m = model_update(&m, a, bb, &inputs);
            } else if op == 2u64 {
                match b.remove_rows(a, a + bb) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 249i32;
                    }
                }
                m = model_remove(&m, a, a + bb);
            } else {
                // SPLIT: HEAD keeps the prefix in the subject buffer, which
                // is the state the trace follows from here.
                let empty: Model = model_new(cols, 0u64);
                let mut ob: PdtBuf = match build_filled(omem, block, &d, 0u64, &empty) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 250000i32;
                    }
                };
                match b.split_to(&mut ob, a) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 250001i32;
                    }
                }
                m = model_prefix_rows(&m, a);
            }

            let post: u64 = next_tok(s, pos);
            let values_ok: u64 = next_tok(s, pos);
            let index_ok: u64 = next_tok(s, pos);
            if post != m.rows || b.size() != post {
                dealloc(mem);
                dealloc(omem);
                return 251i32;
            }
            // HEAD is expected to agree with the definition on the rows: if
            // it did not, the divergence would have to be argued, not passed
            // over. It does, everywhere, so the gate demands it.
            if values_ok != 1u64 {
                dealloc(mem);
                dealloc(omem);
                return 252i32;
            }
            let nprobe: i64 = next_tok(s, pos) as i64;
            let mut p: i64 = 0i64;
            while p < nprobe {
                let r: u64 = next_tok(s, pos);
                let cc: u32 = next_tok(s, pos) as u32;
                let v: u64 = next_tok(s, pos);
                if b.get(cc, r) != v || model_get(&m, cc, r) != v {
                    dealloc(mem);
                    dealloc(omem);
                    return 253i32;
                }
                p = p + 1i64;
            }

            // ── the index, level by level ─────────────────────────────────
            let nlev: i64 = next_tok(s, pos) as i64;
            let mut ours: PdtBuf = b;
            let mut lv: i64 = 0i64;
            while lv < nlev {
                let lrows: u64 = next_tok(s, pos);
                let mut cell: i64 = 0i64;
                let ncell: i64 = (lrows as i64) * (cols as i64);
                // Our own tree must be at least as deep as HEAD's here.
                if !ours.has_index() {
                    // Consume the level and record the structural
                    // divergence: below the span threshold we key index
                    // presence on CAPACITY where HEAD keys it on size (the
                    // P1 divergence), so the trees can legitimately differ
                    // in existence while agreeing on every answer.
                    while cell < ncell {
                        let _ = next_tok(s, pos);
                        cell = cell + 1i64;
                    }
                    lv = lv + 1i64;
                    continue;
                }
                let ix: PdtBuf = ours.index();
                while cell < ncell {
                    let want: u64 = next_tok(s, pos);
                    let r: u64 = (cell / (cols as i64)) as u64;
                    let cc: u32 = (cell % (cols as i64)) as u32;
                    if index_ok == 1u64 && r < ix.size() {
                        if ix.get(cc, r) != want {
                            dealloc(mem);
                            dealloc(omem);
                            return 254i32;
                        }
                    }
                    cell = cell + 1i64;
                }
                ours = ix;
                lv = lv + 1i64;
            }

            // Whatever HEAD did, OUR post-state must satisfy our own law. The
            // conjunct's own code propagates verbatim — the diagnostic is
            // PRINTED, not returned as an exit status, so there is no ceiling
            // to collapse it against.
            let am: i32 = assert_mutation(&b, &m, b.consumed_bytes(), 1160i32);
            if am != 0i32 {
                dealloc(mem);
                dealloc(omem);
                return am;
            }
            st = st + 1i64;
        }
        dealloc(mem);
        dealloc(omem);
    }
    return 0i32;
}

fn check_fixtures() -> i32 {
    let content: String = match read_to_string("tests/pdtbuf_fixtures.hex") {
        Result::Ok(c) => { c }
        Result::Err(_) => { return 100i32; }
    };
    let s: str = content.as_str();
    let mut pos: i64 = 0i64;
    let mut cases: i64 = 0i64;
    let mut index_cases: i64 = 0i64;
    let mut dir_cases: i64 = 0i64;
    let mut mut_cases: i64 = 0i64;
    let mut vle_cases: i64 = 0i64;
    let mut going: bool = true;
    while going {
        let marker: u64 = next_tok(s, &mut pos);
        if marker == 0u64 {
            going = false;
        } else if marker == 1u64 {
            let rc: i32 = check_fixture_case(s, &mut pos);
            if rc != 0i32 {
                return rc;
            }
            cases = cases + 1i64;
        } else if marker == 2u64 {
            let rc2: i32 = check_index_fixture_case(s, &mut pos);
            if rc2 != 0i32 {
                return rc2;
            }
            index_cases = index_cases + 1i64;
        } else if marker == 3u64 {
            let rc3: i32 = check_dir_fixture_case(s, &mut pos);
            if rc3 != 0i32 {
                return rc3;
            }
            dir_cases = dir_cases + 1i64;
        } else if marker == 4u64 {
            let rc4: i32 = check_mut_fixture_case(s, &mut pos);
            if rc4 != 0i32 {
                return rc4;
            }
            mut_cases = mut_cases + 1i64;
        } else if marker == 5u64 {
            let rc5: i32 = check_vle_fixture_case(s, &mut pos);
            if rc5 != 0i32 {
                return rc5;
            }
            vle_cases = vle_cases + 1i64;
        } else {
            return 102i32;   // desynchronized stream
        }
    }
    // Floor: a truncated or regenerated-to-nothing fixture file must not
    // pass as green (the ssrle_codec discipline).
    if cases < 80i64 {
        return 101i32;
    }
    if index_cases < 40i64 {
        return 103i32;
    }
    if dir_cases < 70i64 {
        return 104i32;
    }
    if mut_cases < 20i64 {
        return 105i32;
    }
    // P4: VLE_ROW_SET {0,1,2,5,9,17} x two maxlens x columns 1..4 = 48.
    if vle_cases < 40i64 {
        return 106i32;
    }
    return 0i32;
}

// ── 170.. P3: the two-phase mutation surface ───────────────────────────────
//
// THE LAW of this rung, asserted at EVERY mutation, at every (columns,
// capacity, size, policy) combination reached below:
//
//     us.prepared_bytes == b.consumed_bytes()      exactly, never approximately
//
// plus check() (which re-derives consumed == priced independently AND walks
// the whole index), model equivalence cell by cell, and index parity against
// a full rebuild. All four live in assert_mutation, so no section can forget
// one.
//
// THE PROBES, and what each one actually trips (measured, not assumed):
//   over-price the plan by 8 bytes                       -> 134
//   under-price the plan by 8 bytes                      -> 134
//   drop the incremental index recursion                 -> 176
//   perturb one incremental cell by 1                    -> 176
//   commit an update WITHOUT correcting the index        -> 176
//   price remove over column 0 only — the shape of C++
//     do_prepare_remove's `for (column = 0; column < 1)`  -> 134
// 134 is SIGABRT: the in-module assert_consumed refuses to produce the state
// at all, which is a stronger outcome than a test verdict and the reason the
// law lives in the library and not only here. 176 is 175+1, the check()
// conjunct — check() re-derives every span sum recursively, so it catches an
// index error before the explicit full-rebuild parity conjunct (178) does.
// Parity is kept anyway and is NOT redundant: check() and reindex() could in
// principle share a wrong assumption about what a cell means, and only a
// comparison against an actual rebuild would separate them.

fn rand_vals(cols: u32, count: u64, seed: &mut u64) -> Vec<u64> {
    let mut v: Vec<u64> = vec_new::<u64>();
    let n: i64 = (count as i64) * (cols as i64);
    let mut i: i64 = 0i64;
    while i < n {
        v.push(lcg_next(seed) % 23u64);
        i = i + 1i64;
    }
    return v;
}

/// Format `mem` as a buffer of `cap` capacity holding `m`'s rows, reindexed.
/// `cap` is passed apart from `m.rows` on purpose: a buffer with SLACK
/// (capacity > size) is the only state in which "rows grow inside the
/// geometry" — GAP (b)'s first case — can be reached at all.
unsafe fn build_filled(mem: *mut u8, block: u32, d: &PdtDescr, cap: u64, m: &Model)
    -> Result<PdtBuf, PkdError> {
    let mut b: PdtBuf = match pdtbuf_format(mem, block, d) {
        Result::Ok(q) => { q }
        Result::Err(e) => {
            return Result::Err(e);
        }
    };
    match b.reserve(cap) {
        Result::Ok(_) => {}
        Result::Err(e) => {
            return Result::Err(e);
        }
    }
    b.set_size(m.rows);
    fill_from_model(&mut b, m);
    b.reindex();
    return Result::Ok(b);
}

fn descr_indexed_or(cols: u32, ordering: u32) -> PdtDescr {
    if ordering == PDT_ORD_SUM {
        return descr_indexed(cols);
    }
    return descr_for(cols, ordering);
}

/// The op-by-op law sweep for one (columns, rows, policy, slack).
///
/// `slack` is what makes the two halves of GAP (b) BOTH reachable: at slack 0
/// every growth repricess the capacity, while at slack > 0 under PDT_CAP_KEEP
/// a small insert must be recognised as costing NOTHING, and the section
/// asserts that classification explicitly (215..219) rather than only
/// asserting that the arithmetic happened to come out right.
fn check_mut_ops(cols: u32, rows: u64, policy: u32, slack: u64, seed: &mut u64) -> i32 {
    let m0: Model = model_random(cols, rows, false, seed);
    let d: PdtDescr = descr_indexed(cols);
    let cap0: u64 = rows + slack;
    // Headroom for the largest growth any sub-case below asks for.
    let block: u32 = pdtbuf_compute_block_size_fse(&d, cap0 + 64u64);

    let ats: [u64; 3] = [0u64, rows / 2u64, rows];
    let counts: [u64; 3] = [1u64, 5u64, 17u64];

    unsafe {
        let mem: *mut u8 = alloc(block as i64);
        let omem: *mut u8 = alloc(block as i64);

        // ── 170..174 INSERT ───────────────────────────────────────────────
        let mut ai: i64 = 0i64;
        while ai < 3i64 {
            let mut ci: i64 = 0i64;
            while ci < 3i64 {
                let at: u64 = ats[ai];
                let count: u64 = counts[ci];
                let mut b: PdtBuf = match build_filled(mem, block, &d, cap0, &m0) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 170000i32;
                    }
                };
                let vals: Vec<u64> = rand_vals(cols, count, seed);
                let us: PdtUpdate = match b.prepare_insert(at, count, policy) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 170001i32;
                    }
                };
                // GAP (b), asserted as a CLASSIFICATION and not just as a
                // number: under KEEP, rows landing inside the reserved
                // capacity must cost zero bytes; under EXACT, or past the
                // capacity, the geometry must be repriced.
                let inside: bool = policy == PDT_CAP_KEEP && rows + count <= cap0;
                if inside != us.is_free() {
                    dealloc(mem);
                    dealloc(omem);
                    return 215i32;
                }
                if inside && us.grow_bytes() != 0u32 {
                    dealloc(mem);
                    dealloc(omem);
                    return 216i32;
                }
                if inside && us.prepared_bytes != us.before_bytes {
                    dealloc(mem);
                    dealloc(omem);
                    return 217i32;
                }
                b.commit_insert(&us, &vals);
                let mm: Model = model_insert(&m0, at, count, &vals);
                let rc: i32 = assert_mutation(&b, &mm, us.prepared_bytes, 1000i32);
                if rc != 0i32 {
                    dealloc(mem);
                    dealloc(omem);
                    return rc;
                }
                ci = ci + 1i64;
            }
            ai = ai + 1i64;
        }

        // ── 175..179 UPDATE (the targeted-reindex path) ───────────────────
        if rows > 0u64 {
            let mut ui: i64 = 0i64;
            while ui < 2i64 {
                let at: u64 = ats[ui];
                let mut count: u64 = 7u64;
                if at + count > rows {
                    count = rows - at;
                }
                let mut b2: PdtBuf = match build_filled(mem, block, &d, cap0, &m0) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 175000i32;
                    }
                };
                let vals2: Vec<u64> = rand_vals(cols, count, seed);
                let us2: PdtUpdate = match b2.prepare_update(at, count) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 175001i32;
                    }
                };
                // An FSE replacement moves no byte boundary — DERIVED, and
                // the same verdict the C++ dispatcher base reaches by not
                // looking (:185). Asserted here so that a future dimension
                // whose update DOES cost bytes cannot slip through silently.
                if !us2.is_free() || us2.grow_bytes() != 0u32
                    || us2.prepared_bytes != us2.before_bytes {
                    dealloc(mem);
                    dealloc(omem);
                    return 218i32;
                }
                b2.commit_update(&us2, &vals2);
                let mm2: Model = model_update(&m0, at, count, &vals2);
                let rc2: i32 = assert_mutation(&b2, &mm2, us2.prepared_bytes, 1010i32);
                if rc2 != 0i32 {
                    dealloc(mem);
                    dealloc(omem);
                    return rc2;
                }
                ui = ui + 1i64;
            }
        }

        // ── 180..184 REMOVE ───────────────────────────────────────────────
        if rows > 0u64 {
            let starts: [u64; 4] = [0u64, rows / 2u64, 0u64, rows / 2u64];
            let ends: [u64; 4] = [1u64, rows / 2u64 + 1u64, rows, rows];
            let mut ri: i64 = 0i64;
            while ri < 4i64 {
                let s: u64 = starts[ri];
                let e: u64 = ends[ri];
                let mut b3: PdtBuf = match build_filled(mem, block, &d, cap0, &m0) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 180000i32;
                    }
                };
                let us3: PdtUpdate = match b3.prepare_remove(s, e, policy) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 180001i32;
                    }
                };
                b3.commit_remove(&us3);
                let mm3: Model = model_remove(&m0, s, e);
                let rc3: i32 = assert_mutation(&b3, &mm3, us3.prepared_bytes, 1020i32);
                if rc3 != 0i32 {
                    dealloc(mem);
                    dealloc(omem);
                    return rc3;
                }
                ri = ri + 1i64;
            }
        }

        // ── 185..189 MERGE ────────────────────────────────────────────────
        let mut mi: i64 = 0i64;
        while mi < 2i64 {
            let orows: u64 = if mi == 0i64 { 1u64 } else { 33u64 };
            let om: Model = model_random(cols, orows, false, seed);
            let mut b4: PdtBuf = match build_filled(mem, block, &d, cap0, &m0) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 185000i32;
                }
            };
            let ob: PdtBuf = match build_filled(omem, block, &d, orows, &om) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 185001i32;
                }
            };
            let us4: PdtUpdate = match b4.prepare_merge_with(&ob, policy) {
                Result::Ok(u) => { u }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 185002i32;
                }
            };
            b4.commit_merge_with(&us4, &ob);
            let mm4: Model = model_concat(&m0, &om);
            let rc4: i32 = assert_mutation(&b4, &mm4, us4.prepared_bytes, 1030i32);
            if rc4 != 0i32 {
                dealloc(mem);
                dealloc(omem);
                return rc4;
            }
            // `other` is NOT modified by a merge — the node disposes of it.
            if !buf_matches_model(&ob, &om) {
                dealloc(mem);
                dealloc(omem);
                return 189i32;
            }
            mi = mi + 1i64;
        }

        // ── 190..194 SPLIT ────────────────────────────────────────────────
        let mut si: i64 = 0i64;
        while si < 3i64 {
            let at: u64 = ats[si];
            let mut b5: PdtBuf = match build_filled(mem, block, &d, cap0, &m0) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 190000i32;
                }
            };
            let empty: Model = model_new(cols, 0u64);
            let mut ob2: PdtBuf = match build_filled(omem, block, &d, 0u64, &empty) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 190001i32;
                }
            };
            let sp: PdtSplit = match b5.prepare_split_to(&ob2, at, policy) {
                Result::Ok(s) => { s }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 190002i32;
                }
            };
            b5.commit_split_to(&mut ob2, &sp);
            let ml: Model = model_prefix_rows(&m0, at);
            let mr: Model = model_suffix_rows(&m0, at);
            let rl: i32 = assert_mutation(&b5, &ml, sp.left.prepared_bytes, 1040i32);
            if rl != 0i32 {
                dealloc(mem);
                dealloc(omem);
                return rl;
            }
            let rr: i32 = assert_mutation(&ob2, &mr, sp.right.prepared_bytes, 1050i32);
            if rr != 0i32 {
                dealloc(mem);
                dealloc(omem);
                return rr;
            }
            si = si + 1i64;
        }

        dealloc(mem);
        dealloc(omem);
    }
    return 0i32;
}

// ── 195..199 the MAX-ordering mutation sweep ───────────────────────────────
//
// The ordering axis is CARRIED through the mutations, not narrowed to SUM:
// the row machinery (slot geometry, tail shifting, pricing) is ordering-blind
// by construction, and this section is what makes that red-testable. A MAX
// buffer is index-free by law, so the sweep also pins that prepare prices an
// index-free buffer exactly (index_block_size 0 at every capacity).
//
// The corpora are built so every operation PRESERVES the sortedness a MAX
// column means: removals and splits preserve it for free; an insert
// duplicates the row at the insertion point in every column at once (the only
// value that is simultaneously in range for all columns of a multi-column MAX
// buffer, which is itself the reason MAX branch columns are maintained by the
// tree rather than by the buffer).
fn check_mut_ops_max(cols: u32, rows: u64, seed: &mut u64) -> i32 {
    let m0: Model = model_random(cols, rows, true, seed);
    let d: PdtDescr = descr_for(cols, PDT_ORD_MAX);
    let block: u32 = pdtbuf_compute_block_size_fse(&d, rows + 64u64);
    unsafe {
        let mem: *mut u8 = alloc(block as i64);
        let omem: *mut u8 = alloc(block as i64);

        // INSERT: duplicate the row at `at` (or the last row when at == rows).
        let ats: [u64; 3] = [0u64, rows / 2u64, rows];
        let mut ai: i64 = 0i64;
        while ai < 3i64 {
            let at: u64 = ats[ai];
            if rows > 0u64 {
                let src: u64 = if at < rows { at } else { rows - 1u64 };
                let mut vals: Vec<u64> = vec_new::<u64>();
                let mut c: u32 = 0u32;
                while c < cols {
                    vals.push(model_get(&m0, c, src));
                    c = c + 1u32;
                }
                let mut b: PdtBuf = match build_filled(mem, block, &d, rows, &m0) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 195000i32;
                    }
                };
                let us: PdtUpdate = match b.prepare_insert(at, 1u64, PDT_CAP_EXACT) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 195001i32;
                    }
                };
                b.commit_insert(&us, &vals);
                let mm: Model = model_insert(&m0, at, 1u64, &vals);
                let rc: i32 = assert_mutation(&b, &mm, us.prepared_bytes, 1060i32);
                if rc != 0i32 {
                    dealloc(mem);
                    dealloc(omem);
                    return rc;
                }
                // A MAX buffer carries no index at ANY capacity — the law,
                // and the thing that makes its pricing trivially exact.
                if b.has_index() {
                    dealloc(mem);
                    dealloc(omem);
                    return 199i32;
                }
                // ... and its bisection still agrees with the model's linear
                // bound after the mutation, so the column really is sorted.
                let mut c2: u32 = 0u32;
                while c2 < cols {
                    let mut v: u64 = 0u64;
                    while v <= 25u64 {
                        if b.find_ge(c2, v).idx != model_find_max(&mm, c2, v, false) {
                            dealloc(mem);
                            dealloc(omem);
                            return 198000i32;
                        }
                        if b.find_gt(c2, v).idx != model_find_max(&mm, c2, v, true) {
                            dealloc(mem);
                            dealloc(omem);
                            return 198001i32;
                        }
                        v = v + 1u64;
                    }
                    c2 = c2 + 1u32;
                }
            }
            ai = ai + 1i64;
        }

        // REMOVE + SPLIT + MERGE, which preserve sortedness by construction.
        if rows > 1u64 {
            let mut b3: PdtBuf = match build_filled(mem, block, &d, rows, &m0) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 196000i32;
                }
            };
            let s: u64 = rows / 3u64;
            let e: u64 = rows - rows / 3u64;
            let us3: PdtUpdate = match b3.prepare_remove(s, e, PDT_CAP_EXACT) {
                Result::Ok(u) => { u }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 196001i32;
                }
            };
            b3.commit_remove(&us3);
            let mm3: Model = model_remove(&m0, s, e);
            let rc3: i32 = assert_mutation(&b3, &mm3, us3.prepared_bytes, 1070i32);
            if rc3 != 0i32 {
                dealloc(mem);
                dealloc(omem);
                return rc3;
            }

            // split then merge back: the MAX reading of the roundtrip law.
            let mut b5: PdtBuf = match build_filled(mem, block, &d, rows, &m0) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 197000i32;
                }
            };
            let empty: Model = model_new(cols, 0u64);
            let mut ob: PdtBuf = match build_filled(omem, block, &d, 0u64, &empty) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 197001i32;
                }
            };
            let cut: u64 = rows / 2u64;
            match b5.split_to(&mut ob, cut) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 197002i32;
                }
            }
            match b5.merge_from(&ob) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(omem);
                    return 197003i32;
                }
            }
            if !buf_matches_model(&b5, &m0) {
                dealloc(mem);
                dealloc(omem);
                return 197004i32;
            }
            if b5.check() != 0i32 {
                dealloc(mem);
                dealloc(omem);
                return 197005i32;
            }
        }

        dealloc(mem);
        dealloc(omem);
    }
    return 0i32;
}

// ── 200..204 FAILED PREPARE leaves the block BYTE-IDENTICAL ────────────────
//
// The strongest form of the OOM-untouched discipline: not "the buffer still
// answers correctly", but "not one byte moved". It holds by CONSTRUCTION here
// — prepare is const and returns before anything is written — and the section
// exists to keep it that way, because the C++ shape it replaces (mutate, then
// restore from a scratch copy of the whole node on packed_oom) is exactly
// what an inexact prepare would drag back in.
//
// The failure is forced the only honest way: a block sized to EXACTLY
// pdtbuf_compute_block_size_fse(descr, rows), which is the tightest a correct
// buffer can be, so a single extra row genuinely cannot be paid for.
fn check_failed_prepare_identity(seed: &mut u64) -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let sizes: [u64; 4] = [1u64, 31u64, 33u64, 100u64];
        let mut si: i64 = 0i64;
        while si < 4i64 {
            let rows: u64 = sizes[si];
            let m: Model = model_random(cols, rows, false, seed);
            let d: PdtDescr = descr_indexed(cols);
            let tight: u32 = pdtbuf_compute_block_size_fse(&d, rows);
            unsafe {
                let mem: *mut u8 = alloc(tight as i64);
                let mut b: PdtBuf = match build_filled(mem, tight, &d, rows, &m) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem);
                        return 200i32;
                    }
                };
                // Tight really is tight: nothing is left over.
                if b.consumed_bytes() != b.block_bytes() {
                    dealloc(mem);
                    return 201i32;
                }
                let snap: *mut u8 = clone_block(&b);
                let n: u32 = b.block_bytes();

                // Every growing form must refuse, and refuse without writing.
                let mut failures: i32 = 0i32;
                match b.prepare_insert(0u64, 1u64, PDT_CAP_EXACT) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        failures = failures + 1i32;
                    }
                }
                match b.prepare_insert(rows, 64u64, PDT_CAP_EXACT) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        failures = failures + 1i32;
                    }
                }
                match b.prepare_merge_with(&b, PDT_CAP_EXACT) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        failures = failures + 1i32;
                    }
                }
                if failures != 3i32 {
                    dealloc(snap);
                    dealloc(mem);
                    return 202i32;
                }
                // BYTE IDENTITY — the whole block, not just the live rows.
                if !blocks_identical(&b, snap, n) {
                    dealloc(snap);
                    dealloc(mem);
                    return 203000i32;
                }
                // ... and the buffer is not merely intact, it is USABLE: a
                // failed prepare is not a state, it is a non-event.
                if b.check() != 0i32 || !buf_matches_model(&b, &m) {
                    dealloc(snap);
                    dealloc(mem);
                    return 204000i32;
                }
                // A prepare that FITS still writes nothing until commit.
                match b.prepare_remove(0u64, 1u64, PDT_CAP_EXACT) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        dealloc(snap);
                        dealloc(mem);
                        return 204001i32;
                    }
                }
                if !blocks_identical(&b, snap, n) {
                    dealloc(snap);
                    dealloc(mem);
                    return 203001i32;
                }
                dealloc(snap);
                dealloc(mem);
            }
            si = si + 1i64;
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 205..209 remove(insert(x)) == x, and byte-identically so ───────────────
//
// The inversion law. Under PDT_CAP_EXACT the capacity returns to where it
// started, so the round trip is required to restore the block BYTE FOR BYTE —
// a far sharper statement than model equality, and one that only holds if the
// row shifting, the capacity repricing and the index rebuild are each exactly
// inverse. Every insertion point and several widths, straddling the span
// boundary in both directions.
fn check_insert_remove_inverse(seed: &mut u64) -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let sizes: [u64; 5] = [0u64, 1u64, 31u64, 32u64, 33u64];
        let mut si: i64 = 0i64;
        while si < 5i64 {
            let rows: u64 = sizes[si];
            let m: Model = model_random(cols, rows, false, seed);
            let d: PdtDescr = descr_indexed(cols);
            let block: u32 = pdtbuf_compute_block_size_fse(&d, rows + 40u64);
            unsafe {
                let mem: *mut u8 = alloc(block as i64);
                let counts: [u64; 3] = [1u64, 2u64, 33u64];
                let mut at: u64 = 0u64;
                while at <= rows {
                    let mut ci: i64 = 0i64;
                    while ci < 3i64 {
                        let count: u64 = counts[ci];
                        let mut b: PdtBuf = match build_filled(mem, block, &d, rows, &m) {
                            Result::Ok(q) => { q }
                            Result::Err(_) => {
                                dealloc(mem);
                                return 205i32;
                            }
                        };
                        let snap: *mut u8 = clone_block(&b);
                        let n: u32 = b.consumed_bytes();
                        let vals: Vec<u64> = rand_vals(cols, count, seed);
                        match b.insert_rows(at, count, &vals) {
                            Result::Ok(_) => {}
                            Result::Err(_) => {
                                dealloc(snap);
                                dealloc(mem);
                                return 206i32;
                            }
                        }
                        let mm: Model = model_insert(&m, at, count, &vals);
                        if !buf_matches_model(&b, &mm) {
                            dealloc(snap);
                            dealloc(mem);
                            return 207i32;
                        }
                        if b.check() != 0i32 {
                            dealloc(snap);
                            dealloc(mem);
                            return 208i32;
                        }
                        match b.remove_rows(at, at + count) {
                            Result::Ok(_) => {}
                            Result::Err(_) => {
                                dealloc(snap);
                                dealloc(mem);
                                return 209i32;
                            }
                        }
                        if !buf_matches_model(&b, &m) {
                            dealloc(snap);
                            dealloc(mem);
                            return 244i32;
                        }
                        if b.check() != 0i32 {
                            dealloc(snap);
                            dealloc(mem);
                            return 245i32;
                        }
                        if b.consumed_bytes() != pdtbuf_compute_block_size_fse(&d, rows) {
                            dealloc(snap);
                            dealloc(mem);
                            return 242i32;
                        }
                        if !live_bytes_identical(&b, snap, n) {
                            dealloc(snap);
                            dealloc(mem);
                            return 243i32;
                        }
                        dealloc(snap);
                        ci = ci + 1i64;
                    }
                    at = at + 1u64;
                }
                dealloc(mem);
            }
            si = si + 1i64;
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 210..214 merge(split(x, k)) == x for EVERY cut k ───────────────────────
//
// The other inversion law, and the one the btree actually leans on. Every cut
// point from 0 to size inclusive — including both degenerate ends — and the
// result must be byte-identical to the original, not merely equal row by row.
fn check_merge_split_roundtrip(seed: &mut u64) -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let sizes: [u64; 5] = [0u64, 1u64, 32u64, 33u64, 65u64];
        let mut si: i64 = 0i64;
        while si < 5i64 {
            let rows: u64 = sizes[si];
            let m: Model = model_random(cols, rows, false, seed);
            let d: PdtDescr = descr_indexed(cols);
            let block: u32 = pdtbuf_compute_block_size_fse(&d, rows + 8u64);
            unsafe {
                let mem: *mut u8 = alloc(block as i64);
                let omem: *mut u8 = alloc(block as i64);
                let mut k: u64 = 0u64;
                while k <= rows {
                    let mut b: PdtBuf = match build_filled(mem, block, &d, rows, &m) {
                        Result::Ok(q) => { q }
                        Result::Err(_) => {
                            dealloc(mem);
                            dealloc(omem);
                            return 210000i32;
                        }
                    };
                    let snap: *mut u8 = clone_block(&b);
                    let n: u32 = b.consumed_bytes();
                    let empty: Model = model_new(cols, 0u64);
                    let mut ob: PdtBuf = match build_filled(omem, block, &d, 0u64, &empty) {
                        Result::Ok(q) => { q }
                        Result::Err(_) => {
                            dealloc(snap);
                            dealloc(mem);
                            dealloc(omem);
                            return 210001i32;
                        }
                    };
                    match b.split_to(&mut ob, k) {
                        Result::Ok(_) => {}
                        Result::Err(_) => {
                            dealloc(snap);
                            dealloc(mem);
                            dealloc(omem);
                            return 211i32;
                        }
                    }
                    let ml: Model = model_prefix_rows(&m, k);
                    let mr: Model = model_suffix_rows(&m, k);
                    if !buf_matches_model(&b, &ml) || b.check() != 0i32 {
                        dealloc(snap);
                        dealloc(mem);
                        dealloc(omem);
                        return 212i32;
                    }
                    if !buf_matches_model(&ob, &mr) || ob.check() != 0i32 {
                        dealloc(snap);
                        dealloc(mem);
                        dealloc(omem);
                        return 213i32;
                    }
                    match b.merge_from(&ob) {
                        Result::Ok(_) => {}
                        Result::Err(_) => {
                            dealloc(snap);
                            dealloc(mem);
                            dealloc(omem);
                            return 214000i32;
                        }
                    }
                    if !buf_matches_model(&b, &m) || b.check() != 0i32 {
                        dealloc(snap);
                        dealloc(mem);
                        dealloc(omem);
                        return 214001i32;
                    }
                    if !live_bytes_identical(&b, snap, n) {
                        dealloc(snap);
                        dealloc(mem);
                        dealloc(omem);
                        return 214002i32;
                    }
                    dealloc(snap);
                    k = k + 1u64;
                }
                dealloc(mem);
                dealloc(omem);
            }
            si = si + 1i64;
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 219..224 INCREMENTAL vs FULL reindex parity (GAP (a)) ──────────────────
//
// The targeted index correction must agree with a full rebuild EXACTLY, cell
// for cell, at every level — after a SEQUENCE of updates, not just one, so a
// per-update error cannot be masked by the next rebuild. The twin is a flat
// byte clone of the block that is then fully reindexed, which means the two
// sides differ ONLY in how the index got its values.
//
// Sizes are chosen to reach every depth the recursion has: 33 (one level),
// 1025 (two), 32769 (three). Depth is asserted, so "the incremental path was
// exercised against a multi-level tree" is measured rather than assumed.
fn check_incremental_reindex(seed: &mut u64) -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let sizes: [u64; 5] = [33u64, 64u64, 1025u64, 2000u64, 32769u64];
        let levels: [u32; 5] = [1u32, 1u32, 2u32, 2u32, 3u32];
        let mut si: i64 = 0i64;
        while si < 5i64 {
            let rows: u64 = sizes[si];
            let m0: Model = model_random(cols, rows, false, seed);
            let d: PdtDescr = descr_indexed(cols);
            let block: u32 = pdtbuf_compute_block_size_fse(&d, rows);
            unsafe {
                let mem: *mut u8 = alloc(block as i64);
                let mut b: PdtBuf = match build_filled(mem, block, &d, rows, &m0) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem);
                        return 219i32;
                    }
                };
                if b.index_levels() != levels[si] {
                    dealloc(mem);
                    return 220i32;
                }
                let mut m: Model = m0;
                // A run of point updates scattered across the whole row
                // range, so every span — and every level's cell — is hit,
                // and the deltas go BOTH ways (values rise and fall), which
                // is what exercises the wrapping-delta derivation instead of
                // only its easy half.
                let mut step: i64 = 0i64;
                while step < 40i64 {
                    let at: u64 = lcg_next(seed) % rows;
                    let mut count: u64 = 1u64 + lcg_next(seed) % 5u64;
                    if at + count > rows {
                        count = rows - at;
                    }
                    let vals: Vec<u64> = rand_vals(cols, count, seed);
                    let us: PdtUpdate = match b.prepare_update(at, count) {
                        Result::Ok(u) => { u }
                        Result::Err(_) => {
                            dealloc(mem);
                            return 221i32;
                        }
                    };
                    b.commit_update(&us, &vals);
                    m = model_update(&m, at, count, &vals);
                    // Parity is checked after EVERY step — the incremental
                    // path is never allowed to be "eventually" right.
                    let rc: i32 = assert_mutation(&b, &m, us.prepared_bytes, 1080i32);
                    if rc != 0i32 {
                        dealloc(mem);
                        return rc;
                    }
                    step = step + 1i64;
                }
                // ... and the accelerated queries agree with the model after
                // the whole run, which is what the cells are FOR.
                let mut c: u32 = 0u32;
                while c < cols {
                    let total: u64 = model_prefix(&m, c, rows);
                    let mut v: u64 = 0u64;
                    while v <= total {
                        let g: PdtFind = b.find_ge(c, v);
                        let mg: PdtFind = model_find_sum(&m, c, v, false, 0u64);
                        if g.idx != mg.idx || g.prefix != mg.prefix {
                            dealloc(mem);
                            return 224000i32;
                        }
                        v = v + 1u64 + total / 17u64;
                    }
                    if b.sum_all(c) != total {
                        dealloc(mem);
                        return 224001i32;
                    }
                    c = c + 1u32;
                }
                dealloc(mem);
            }
            si = si + 1i64;
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 225..239 randomized mutation SEQUENCES ─────────────────────────────────
//
// Everything above fixes one operation against one starting state. This
// drives a buffer through LONG sequences of mixed operations, so the states
// that only arise from history — capacity slack left by a shrink, an index
// that has been rebuilt and corrected and rebuilt again, a size that crossed
// 32 downward and then upward again — are reached and asserted at every step.
// The LCG walks sizes deliberately through the 31/32/33 threshold and up past
// 1024 into the second index level.
fn check_mutation_sequences(cols: u32, policy: u32, steps: i64, seed: &mut u64) -> i32 {
    let d: PdtDescr = descr_indexed(cols);
    let maxrows: u64 = 1100u64;
    let block: u32 = pdtbuf_compute_block_size_fse(&d, maxrows);
    unsafe {
        let mem: *mut u8 = alloc(block as i64);
        let omem: *mut u8 = alloc(block as i64);
        let mut m: Model = model_new(cols, 0u64);
        let mut b: PdtBuf = match build_filled(mem, block, &d, 0u64, &m) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                dealloc(omem);
                return 225i32;
            }
        };
        let mut step: i64 = 0i64;
        while step < steps {
            let rows: u64 = m.rows;
            // Bias toward growth while small and toward shrinking while
            // large, so the walk keeps crossing the threshold band instead
            // of settling on one side of it.
            let mut op: u64 = lcg_next(seed) % 5u64;
            if rows == 0u64 {
                op = 0u64;
            }
            if rows > 900u64 && op == 0u64 {
                op = 2u64;
            }
            if op == 0u64 {
                // INSERT — widths chosen to land on and around the boundary.
                let at: u64 = lcg_next(seed) % (rows + 1u64);
                let count: u64 = 1u64 + lcg_next(seed) % 40u64;
                if rows + count > maxrows {
                    step = step + 1i64;
                    continue;
                }
                let vals: Vec<u64> = rand_vals(cols, count, seed);
                let us: PdtUpdate = match b.prepare_insert(at, count, policy) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 226i32;
                    }
                };
                b.commit_insert(&us, &vals);
                m = model_insert(&m, at, count, &vals);
                let rc: i32 = assert_mutation(&b, &m, us.prepared_bytes, 1090i32);
                if rc != 0i32 {
                    dealloc(mem);
                    dealloc(omem);
                    return rc;
                }
            } else if op == 1u64 {
                // UPDATE — the targeted-index path, inside the sequence.
                let at: u64 = lcg_next(seed) % rows;
                let mut count: u64 = 1u64 + lcg_next(seed) % 9u64;
                if at + count > rows {
                    count = rows - at;
                }
                let vals: Vec<u64> = rand_vals(cols, count, seed);
                let us: PdtUpdate = match b.prepare_update(at, count) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 227i32;
                    }
                };
                b.commit_update(&us, &vals);
                m = model_update(&m, at, count, &vals);
                let rc: i32 = assert_mutation(&b, &m, us.prepared_bytes, 1100i32);
                if rc != 0i32 {
                    dealloc(mem);
                    dealloc(omem);
                    return rc;
                }
            } else if op == 2u64 {
                // REMOVE
                let s: u64 = lcg_next(seed) % rows;
                let mut e: u64 = s + 1u64 + lcg_next(seed) % 40u64;
                if e > rows {
                    e = rows;
                }
                let us: PdtUpdate = match b.prepare_remove(s, e, policy) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 228i32;
                    }
                };
                b.commit_remove(&us);
                m = model_remove(&m, s, e);
                let rc: i32 = assert_mutation(&b, &m, us.prepared_bytes, 1110i32);
                if rc != 0i32 {
                    dealloc(mem);
                    dealloc(omem);
                    return rc;
                }
            } else if op == 3u64 {
                // SPLIT off a suffix, then MERGE it straight back: the
                // roundtrip law evaluated on a HISTORY-shaped state rather
                // than on a freshly built one.
                let k: u64 = lcg_next(seed) % (rows + 1u64);
                let empty: Model = model_new(cols, 0u64);
                let mut ob: PdtBuf = match build_filled(omem, block, &d, 0u64, &empty) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 229000i32;
                    }
                };
                let sp: PdtSplit = match b.prepare_split_to(&ob, k, policy) {
                    Result::Ok(s2) => { s2 }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 229001i32;
                    }
                };
                b.commit_split_to(&mut ob, &sp);
                let ml: Model = model_prefix_rows(&m, k);
                let mr: Model = model_suffix_rows(&m, k);
                let rl: i32 = assert_mutation(&b, &ml, sp.left.prepared_bytes, 1120i32);
                if rl != 0i32 {
                    dealloc(mem);
                    dealloc(omem);
                    return rl;
                }
                let rr: i32 = assert_mutation(&ob, &mr, sp.right.prepared_bytes, 1130i32);
                if rr != 0i32 {
                    dealloc(mem);
                    dealloc(omem);
                    return rr;
                }
                let us2: PdtUpdate = match b.prepare_merge_with(&ob, policy) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 229002i32;
                    }
                };
                b.commit_merge_with(&us2, &ob);
                let rc2: i32 = assert_mutation(&b, &m, us2.prepared_bytes, 1140i32);
                if rc2 != 0i32 {
                    dealloc(mem);
                    dealloc(omem);
                    return rc2;
                }
            } else {
                // MERGE a fresh tail on.
                let orows: u64 = lcg_next(seed) % 40u64;
                if m.rows + orows > maxrows {
                    step = step + 1i64;
                    continue;
                }
                let om: Model = model_random(cols, orows, false, seed);
                let ob: PdtBuf = match build_filled(omem, block, &d, orows, &om) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 229003i32;
                    }
                };
                let us: PdtUpdate = match b.prepare_merge_with(&ob, policy) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        dealloc(omem);
                        return 229004i32;
                    }
                };
                b.commit_merge_with(&us, &ob);
                m = model_concat(&m, &om);
                let rc: i32 = assert_mutation(&b, &m, us.prepared_bytes, 1150i32);
                if rc != 0i32 {
                    dealloc(mem);
                    dealloc(omem);
                    return rc;
                }
            }
            step = step + 1i64;
        }
        dealloc(mem);
        dealloc(omem);
    }
    return 0i32;
}

// ── driver ─────────────────────────────────────────────────────────────────

// ════ P4: THE VARIABLE-LENGTH DIMENSION ═════════════════════════════════════
//
// What changes at this rung is that a row no longer has a fixed footprint, so
// the two quantities P0..P3 could keep apart — how many rows a block holds and
// how many bytes they occupy — stop moving together. The exact-prepare law
// still has to hold byte for byte, and it is the whole point of the rung that
// it does so WITHOUT storing the payload geometry anywhere:
//
//   payload CAPACITY = element_size(the payload block)     — the allocator's
//   payload USED     = offsets[size]                       — the block's own
//
// Both are already in the block, so `check()` and `consumed_bytes()` read the
// ACTUAL geometry back, while `pdtbuf_compute_block_size(descr, capacity,
// payload[])` prices a HYPOTHETICAL one (a prepare must price a state that
// does not exist yet). Storing a payload capacity would duplicate a fact the
// allocator already owns and open a drift surface between the two copies; the
// asymmetry with the FSE row `capacity`, which IS stored, is principled —
// recovering it as block_bytes/elem_size loses information whenever elem_size
// does not divide the 8-byte granule (that is upstream defect #25), whereas
// bytes-to-bytes is the identity.
//
// ── WHAT THIS SECTION ASSERTS ──────────────────────────────────────────────
// The five conjuncts of `assert_vle_mutation`, after EVERY mutation:
//   +0  prepared == consumed, exactly. The +-8 mis-pricing probes trip this.
//   +1  check() == 0 — slot geometry, the offsets contract, consumed == priced.
//   +2  the buffer equals the INDEPENDENT model, cell for cell and byte for
//       byte, over every column and every VLE dimension.
//   +3  the offsets invariants re-derived FROM THE MODEL rather than from the
//       block: offs[0] == 0, monotone, offs[size] == payload_used, and every
//       row length equal to the model's. check() proves the block is
//       self-consistent; this proves it agrees with an outside account. The
//       two could otherwise share a wrong assumption — the same reason P3
//       keeps index parity alongside check().
//   +4  the buffer is index-FREE. Not a coincidence to be observed but the
//       SUM => FIXED law showing its face at every mutation: a variable-length
//       dimension has no accumulation, so no VLE buffer can be SUM-ordered,
//       so none can carry a span index (C++ static_assert so.hpp:349, which we
//       make a runtime law with a diagnostic at pdt_assert_descr).
//
// Bases are spaced by TEN, five more than the conjunct count. The original
// "244 pricing bug" of the lost session was an artifact of bases spaced ONE
// apart: three distinct failures all printed as 244 and a whole session went
// into a pricing path that was exact the entire time.
//
// ── SHAPE ──────────────────────────────────────────────────────────────────
// Three descriptor shapes run through every sweep, and the MIXED one is the
// normal case, not a variant:
//   * VLE-only          [VLE(1)]                    UNORDERED
//   * mixed FSE + VLE   [FSE(8), VLE(1)]            MAX
//   * two VLE dims      [FSE(8), VLE(1), VLE(2)]    MAX
// The third carries elem_size 2 on its second payload, which is what exercises
// the "row length is a whole number of payload elements" law (check() code 22)
// and keeps `vle_dim_count() > 1` off the degenerate path — the payload
// geometry is a VECTOR indexed by (column, VLE ordinal), and a gate that only
// ever ran one VLE dimension could not tell that vector from a scalar.
// Columns run 1..4 throughout, with the >=3-column canary carried from P0.

// ── the independent variable-length model ──────────────────────────────────
//
// OWNERSHIP, and it is by construction rather than by repair. Three FLAT Vecs,
// nothing nested, exactly the shape of the `Model` above — which the P3 gate
// runs at 124388 allocations with valgrind clean, so the shape is not merely
// argued but evidenced. The lost gate's model held per-row containers and
// pushed a fresh one per operation; that run recorded 6356 errors and
// 1,587,944 bytes definitely lost in 4800 blocks, ALL of it test-side, none of
// it in the module. A Vec of Vecs is the trap: the outer drop does not run the
// inner ones. So there is no such type here, and no helper allocates anything
// that outlives the statement it appears in.
//
//   cells[r * cols + c]                 the FSE dimension-0 value
//   lens [(r * cols + c) * vle + o]     the length of VLE dimension o
//   bytes                               every payload, concatenated in
//                                       (row, column, ordinal) order
//
// The byte order is (row, column) — ROW-major — while the block stores each
// column's payload contiguously, COLUMN-major. The model is therefore not a
// re-spelling of the layout it checks: recovering a row means prefix-summing
// the lengths, which is the definition of an offsets table rather than a copy
// of one.
struct VModel {
    cols: u32,
    vle: u32,
    fse: bool,
    rows: u64,
    cells: Vec<u64>,
    lens: Vec<u64>,
    bytes: Vec<u8>,
}

fn vm_new(cols: u32, vle: u32, fse: bool) -> VModel {
    return VModel {
        cols: cols,
        vle: vle,
        fse: fse,
        rows: 0u64,
        cells: vec_new::<u64>(),
        lens: vec_new::<u64>(),
        bytes: vec_new::<u8>(),
    };
}

/// Slot of (row, column, ordinal) in `lens` — the same indexing
/// `pdt_vals_span_slot` uses, so the model and the carrier agree by
/// construction rather than by a conversion that could be got wrong.
fn vm_slot(m: &VModel, r: u64, c: u32, o: u32) -> i64 {
    return (((r as i64) * (m.cols as i64)) + (c as i64)) * (m.vle as i64) + (o as i64);
}

fn vm_len(m: &VModel, r: u64, c: u32, o: u32) -> u64 {
    return m.lens.get(vm_slot(m, r, c, o));
}

/// Byte offset of span `k` in `bytes` — the prefix of the lengths. O(k), which
/// is why the sweeps below stay at corpus sizes where that is free; the deep
/// sizes are covered by the FSE rungs, and nothing about the VLE laws is
/// size-dependent past the second index level.
fn vm_off(m: &VModel, k: i64) -> i64 {
    let mut off: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < k {
        off = off + (m.lens.get(i) as i64);
        i = i + 1i64;
    }
    return off;
}

fn vm_cell(m: &VModel, r: u64, c: u32) -> u64 {
    return m.cells.get((r as i64) * (m.cols as i64) + (c as i64));
}

/// Append one row, drawing its content from `seed`. Pushes straight into the
/// model's own Vecs — there is no temporary row object, which is exactly the
/// allocation the lost gate leaked once per operation.
fn vm_gen_row(m: &mut VModel, maxlen: u64, seed: &mut u64) {
    let mut c: u32 = 0u32;
    while c < m.cols {
        if m.fse {
            m.cells.push(lcg_next(seed) % 23u64);
        }
        let mut o: u32 = 0u32;
        while o < m.vle {
            // elem_size of VLE ordinal o is 1 for the first, 2 for the second
            // (see descr_vle_shape) — the length must be a whole number of
            // elements, and the model is where that is decided.
            let unit: u64 = vm_unit(o);
            let n: u64 = (lcg_next(seed) % (maxlen + 1u64)) * unit;
            m.lens.push(n);
            let mut i: u64 = 0u64;
            while i < n {
                m.bytes.push((97u64 + (lcg_next(seed) % 26u64)) as u8);
                i = i + 1u64;
            }
            o = o + 1u32;
        }
        c = c + 1u32;
    }
    m.rows = m.rows + 1u64;
}

/// The payload element size of VLE ordinal `o`. One place, so the model and
/// the descriptor cannot disagree about it.
fn vm_unit(o: u32) -> u32 {
    if o == 1u32 {
        return 2u32;
    }
    return 1u32;
}

fn vm_random(cols: u32, vle: u32, fse: bool, rows: u64, maxlen: u64, seed: &mut u64)
    -> VModel {
    let mut m: VModel = vm_new(cols, vle, fse);
    let mut r: u64 = 0u64;
    while r < rows {
        vm_gen_row(&mut m, maxlen, seed);
        r = r + 1u64;
    }
    return m;
}

/// Copy row `r` of `src` onto the end of `dst`. The single primitive every
/// model operation below is built from — insert, update, remove, concat and
/// the split halves are all "copy these rows, in this order", which is what
/// makes them obviously right by inspection.
fn vm_copy_row(dst: &mut VModel, src: &VModel, r: u64) {
    let mut c: u32 = 0u32;
    while c < src.cols {
        if src.fse {
            dst.cells.push(vm_cell(src, r, c));
        }
        let mut o: u32 = 0u32;
        while o < src.vle {
            let k: i64 = vm_slot(src, r, c, o);
            let n: u64 = src.lens.get(k);
            dst.lens.push(n);
            let off: i64 = vm_off(src, k);
            let mut i: i64 = 0i64;
            while i < (n as i64) {
                dst.bytes.push(src.bytes.get(off + i));
                i = i + 1i64;
            }
            o = o + 1u32;
        }
        c = c + 1u32;
    }
    dst.rows = dst.rows + 1u64;
}

fn vm_rows_range(dst: &mut VModel, src: &VModel, a: u64, b: u64) {
    let mut r: u64 = a;
    while r < b {
        vm_copy_row(dst, src, r);
        r = r + 1u64;
    }
}

fn vm_insert(m: &VModel, at: u64, ins: &VModel) -> VModel {
    let mut out: VModel = vm_new(m.cols, m.vle, m.fse);
    vm_rows_range(&mut out, m, 0u64, at);
    vm_rows_range(&mut out, ins, 0u64, ins.rows);
    vm_rows_range(&mut out, m, at, m.rows);
    return out;
}

fn vm_update(m: &VModel, at: u64, repl: &VModel) -> VModel {
    let mut out: VModel = vm_new(m.cols, m.vle, m.fse);
    vm_rows_range(&mut out, m, 0u64, at);
    vm_rows_range(&mut out, repl, 0u64, repl.rows);
    vm_rows_range(&mut out, m, at + repl.rows, m.rows);
    return out;
}

fn vm_remove(m: &VModel, start: u64, end: u64) -> VModel {
    let mut out: VModel = vm_new(m.cols, m.vle, m.fse);
    vm_rows_range(&mut out, m, 0u64, start);
    vm_rows_range(&mut out, m, end, m.rows);
    return out;
}

fn vm_concat(a: &VModel, b: &VModel) -> VModel {
    let mut out: VModel = vm_new(a.cols, a.vle, a.fse);
    vm_rows_range(&mut out, a, 0u64, a.rows);
    vm_rows_range(&mut out, b, 0u64, b.rows);
    return out;
}

fn vm_slice(m: &VModel, a: u64, b: u64) -> VModel {
    let mut out: VModel = vm_new(m.cols, m.vle, m.fse);
    vm_rows_range(&mut out, m, a, b);
    return out;
}

/// Total payload bytes of (column, ordinal) — the model's account of what
/// `payload_used` must read back out of the block.
fn vm_payload_used(m: &VModel, c: u32, o: u32) -> u64 {
    let mut t: u64 = 0u64;
    let mut r: u64 = 0u64;
    while r < m.rows {
        t = t + vm_len(m, r, c, o);
        r = r + 1u64;
    }
    return t;
}

// ── the model -> carrier bridge ────────────────────────────────────────────

/// Build the `PdtVals` carrier for every row of `m`. The push order is
/// (row, column, ordinal), which is the order `pdt_vals_span_slot` names, so
/// this is a transcription and not a translation.
fn vm_to_vals(m: &VModel) -> PdtVals {
    let mut v: PdtVals = pdt_vals_new();
    let mut r: u64 = 0u64;
    while r < m.rows {
        let mut c: u32 = 0u32;
        while c < m.cols {
            if m.fse {
                v.cells.push(vm_cell(m, r, c));
            }
            let mut o: u32 = 0u32;
            while o < m.vle {
                let k: i64 = vm_slot(m, r, c, o);
                let n: i64 = m.lens.get(k) as i64;
                let off: i64 = vm_off(m, k);
                unsafe {
                    let s: &[u8] = slice_from_raw::<u8>(m.bytes.as_ptr().byte_add(off), n);
                    v.push_span(s);
                }
                o = o + 1u32;
            }
            c = c + 1u32;
        }
        r = r + 1u64;
    }
    return v;
}

// ── descriptors ────────────────────────────────────────────────────────────

/// shape 0: VLE only, UNORDERED — the C++ marker-5 fixture shape
///          (PackedDataTypeBufferT<Varchar, false, C, DTOrdering::UNORDERED>).
/// shape 1: mixed FSE + VLE, MAX — the NORMAL case.
/// shape 2: FSE + two VLE dimensions of different element sizes, MAX.
fn descr_vle_shape(cols: u32, shape: u32) -> PdtDescr {
    if shape == 0u32 {
        let mut d: PdtDescr = pdt_descr_new(cols, PDT_ORD_UNORDERED, false);
        d.dims.push(pdt_dim_vle(1u32));
        return d;
    }
    if shape == 1u32 {
        let mut d1: PdtDescr = pdt_descr_new(cols, PDT_ORD_MAX, false);
        d1.dims.push(pdt_dim_fse(8u32));
        d1.dims.push(pdt_dim_vle(1u32));
        return d1;
    }
    let mut d2: PdtDescr = pdt_descr_new(cols, PDT_ORD_MAX, false);
    d2.dims.push(pdt_dim_fse(8u32));
    d2.dims.push(pdt_dim_vle(1u32));
    d2.dims.push(pdt_dim_vle(2u32));
    return d2;
}

fn shape_vle_dims(shape: u32) -> u32 {
    if shape == 2u32 {
        return 2u32;
    }
    return 1u32;
}

fn shape_has_fse(shape: u32) -> bool {
    return shape != 0u32;
}

fn vm_for_shape(cols: u32, shape: u32, rows: u64, maxlen: u64, seed: &mut u64) -> VModel {
    return vm_random(cols, shape_vle_dims(shape), shape_has_fse(shape), rows, maxlen, seed);
}

/// The physical dimension index of VLE ordinal `o` under `shape`: shape 0 puts
/// its only VLE dimension at 0, the others follow the FSE key at 0.
fn shape_dim_of(shape: u32, o: u32) -> u32 {
    if shape == 0u32 {
        return 0u32;
    }
    return 1u32 + o;
}

// ── model equivalence ──────────────────────────────────────────────────────

fn vbuf_matches_vmodel(b: &PdtBuf, m: &VModel, shape: u32) -> bool {
    if b.size() != m.rows {
        return false;
    }
    if b.columns() != m.cols {
        return false;
    }
    let mut c: u32 = 0u32;
    while c < m.cols {
        let mut r: u64 = 0u64;
        while r < m.rows {
            if m.fse {
                if b.get(c, r) != vm_cell(m, r, c) {
                    return false;
                }
            }
            let mut o: u32 = 0u32;
            while o < m.vle {
                let dim: u32 = shape_dim_of(shape, o);
                let k: i64 = vm_slot(m, r, c, o);
                let n: u64 = m.lens.get(k);
                let sp: &[u8] = b.row_span(c, dim, r);
                if (sp.len() as u64) != n {
                    return false;
                }
                let off: i64 = vm_off(m, k);
                let mut i: i64 = 0i64;
                while i < (n as i64) {
                    if sp[i] != m.bytes.get(off + i) {
                        return false;
                    }
                    i = i + 1i64;
                }
                o = o + 1u32;
            }
            r = r + 1u64;
        }
        c = c + 1u32;
    }
    return true;
}

/// The offsets contract, re-derived from the MODEL. `check()` proves the block
/// agrees with itself; this proves it agrees with an outside account of what
/// the rows are. Both are kept, for the reason P3 keeps index parity next to
/// check(): a single self-consistent structure can be self-consistently wrong.
fn vle_offsets_agree(b: &PdtBuf, m: &VModel, shape: u32) -> bool {
    let mut c: u32 = 0u32;
    while c < m.cols {
        let mut o: u32 = 0u32;
        while o < m.vle {
            let dim: u32 = shape_dim_of(shape, o);
            if b.row_offset(c, dim, 0u64) != 0u64 {
                return false;
            }
            let mut acc: u64 = 0u64;
            let mut r: u64 = 0u64;
            while r < m.rows {
                let lo: u64 = b.row_offset(c, dim, r);
                let hi: u64 = b.row_offset(c, dim, r + 1u64);
                if lo != acc {
                    return false;
                }
                if hi < lo {
                    return false;
                }
                if (hi - lo) != vm_len(m, r, c, o) {
                    return false;
                }
                acc = hi;
                r = r + 1u64;
            }
            // offs[size] == payload_used == the model's total, and the block
            // never claims to use more than it owns.
            if b.row_offset(c, dim, m.rows) != acc {
                return false;
            }
            if b.payload_used(c, dim) != acc {
                return false;
            }
            if vm_payload_used(m, c, o) != acc {
                return false;
            }
            if b.payload_used(c, dim) > b.payload_capacity(c, dim) {
                return false;
            }
            o = o + 1u32;
        }
        c = c + 1u32;
    }
    return true;
}

/// THE law of this rung, after EVERY mutation. Five conjuncts; bases spaced by
/// ten.
fn assert_vle_mutation(b: &PdtBuf, m: &VModel, shape: u32, prepared: u32, base: i32) -> i32 {
    if b.consumed_bytes() != prepared {
        return base;
    }
    if b.check() != 0i32 {
        return base + 1i32;
    }
    if !vbuf_matches_vmodel(b, m, shape) {
        return base + 2i32;
    }
    if !vle_offsets_agree(b, m, shape) {
        return base + 3i32;
    }
    // SUM => FIXED, observed rather than assumed: a VLE buffer is index-free
    // because it cannot be SUM-ordered at all.
    if b.has_index() {
        return base + 4i32;
    }
    return 0i32;
}

// ── construction ───────────────────────────────────────────────────────────

/// Bytes enough for `m`'s rows plus `slack` rows of headroom, priced through
/// the module's own function so the gate never invents a size of its own.
fn vle_block_for(d: &PdtDescr, m: &VModel, slack: u64, extra: u64) -> u32 {
    let mut pay: Vec<u64> = vec_new::<u64>();
    let n: i64 = d.payload_len();
    let mut i: i64 = 0i64;
    while i < n {
        pay.push(0u64);
        i = i + 1i64;
    }
    let mut c: u32 = 0u32;
    while c < m.cols {
        let mut o: u32 = 0u32;
        while o < m.vle {
            let k: i64 = (c as i64) * (m.vle as i64) + (o as i64);
            pay.set(k, vm_payload_used(m, c, o) + extra);
            o = o + 1u32;
        }
        c = c + 1u32;
    }
    return pdtbuf_compute_block_size(d, m.rows + slack, &pay);
}

/// Format `mem` and fill it with `m`'s rows through the PUBLIC two-phase
/// insert, so construction is itself gated rather than being a back door that
/// writes the block by hand.
unsafe fn build_vle(mem: *mut u8, block: u32, d: &PdtDescr, m: &VModel)
    -> Result<PdtBuf, PkdError> {
    let mut b: PdtBuf = match pdtbuf_format(mem, block, d) {
        Result::Ok(q) => { q }
        Result::Err(e) => {
            return Result::Err(e);
        }
    };
    if m.rows > 0u64 {
        let vals: PdtVals = vm_to_vals(m);
        match b.insert_rows_vals(0u64, m.rows, &vals) {
            Result::Ok(_) => {}
            Result::Err(e2) => {
                return Result::Err(e2);
            }
        }
    }
    return Result::Ok(b);
}

// ── 1200: geometry, the descriptor round-trip, and the derived payload ─────
//
// The pricing function is PURE — it takes a hypothetical geometry — while
// `payload_capacity` reads the actual one back. This section pins that they
// meet: a block priced at some payload capacity reports exactly that capacity,
// and re-pricing at the reported value is a FIXED POINT (it must be, because
// the reported value is already a multiple of 8 while the requested one need
// not be; a function that did not settle here would make `prepared ==
// consumed` unprovable after the first round trip).
fn check_vle_geometry() -> i32 {
    let mut c: u32 = 1u32;
    while c <= 4u32 {
        let mut shape: u32 = 0u32;
        while shape <= 2u32 {
            let d: PdtDescr = descr_vle_shape(c, shape);
            let vle: u32 = shape_vle_dims(shape);
            if d.vle_dim_count() != vle {
                return 1200i32;
            }
            if d.payload_len() != (c as i64) * (vle as i64) {
                return 1201i32;
            }
            // Slot formula: width 2 per VLE dimension, 1 per FSE.
            let mut want_dbt: u32 = 0u32;
            if shape_has_fse(shape) {
                want_dbt = 1u32;
            }
            want_dbt = want_dbt + 2u32 * vle;
            if d.dim_blocks_total() != want_dbt {
                return 1202i32;
            }
            // payload_slot is COLUMN-major and a bijection onto [0, payload_len).
            let mut seen: Vec<u64> = vec_new::<u64>();
            let mut z: i64 = 0i64;
            while z < d.payload_len() {
                seen.push(0u64);
                z = z + 1i64;
            }
            let mut cc: u32 = 0u32;
            while cc < c {
                let mut o: u32 = 0u32;
                while o < vle {
                    let k: i64 = d.payload_slot(cc, shape_dim_of(shape, o));
                    if k < 0i64 || k >= d.payload_len() {
                        return 1203i32;
                    }
                    seen.set(k, seen.get(k) + 1u64);
                    o = o + 1u32;
                }
                cc = cc + 1u32;
            }
            let mut z2: i64 = 0i64;
            while z2 < d.payload_len() {
                if seen.get(z2) != 1u64 {
                    return 1204i32;
                }
                z2 = z2 + 1i64;
            }

            // A real block: price it, format it, read the geometry back.
            let mut seed: u64 = 0x51ED270Bu64 + (c as u64) * 7u64 + (shape as u64);
            let m: VModel = vm_for_shape(c, shape, 9u64, 6u64, &mut seed);
            let blk: u32 = vle_block_for(&d, &m, 0u64, 0u64);
            unsafe {
                let mem: *mut u8 = alloc(blk as i64);
                let b: PdtBuf = match build_vle(mem, blk, &d, &m) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem);
                        return 1205i32;
                    }
                };
                if b.check() != 0i32 {
                    dealloc(mem);
                    return 1206i32;
                }
                // The descriptor survives the block round trip, VLE kinds and
                // element sizes included.
                let back: PdtDescr = b.descr();
                if back.dim_count() != d.dim_count() || back.columns != d.columns {
                    dealloc(mem);
                    return 1207i32;
                }
                let mut di: u32 = 0u32;
                while di < d.dim_count() {
                    let a1: PdtDim = b.dim_at(di);
                    let e1: &PdtDim = d.dims.borrow(di as i64);
                    if a1.kind != e1.kind || a1.elem_size != e1.elem_size {
                        dealloc(mem);
                        return 1208i32;
                    }
                    di = di + 1u32;
                }
                // payload_used == the model's total; payload_capacity is the
                // allocator's own element size, and re-pricing at it is a
                // fixed point.
                let mut c3: u32 = 0u32;
                while c3 < c {
                    let mut o3: u32 = 0u32;
                    while o3 < vle {
                        let dim: u32 = shape_dim_of(shape, o3);
                        let used: u64 = b.payload_used(c3, dim);
                        if used != vm_payload_used(&m, c3, o3) {
                            dealloc(mem);
                            return 1209i32;
                        }
                        let cap: u64 = b.payload_capacity(c3, dim);
                        if cap < used {
                            dealloc(mem);
                            return 1210i32;
                        }
                        if cap % 8u64 != 0u64 {
                            dealloc(mem);
                            return 1211i32;
                        }
                        let dd: PdtDim = b.dim_at(dim);
                        if pdt_dim_block_size(&dd, 0u32, b.capacity(), cap) != (cap as u32) {
                            dealloc(mem);
                            return 1212i32;
                        }
                        // The offsets table is sized from CAPACITY, in lockstep
                        // with every other geometry block.
                        let want_off: u32 =
                            pdt_dim_block_size(&dd, 1u32, b.capacity(), 0u64);
                        if want_off < (((b.capacity() + 1u64) * PDT_OFFSET_BYTES) as u32) {
                            dealloc(mem);
                            return 1213i32;
                        }
                        o3 = o3 + 1u32;
                    }
                    c3 = c3 + 1u32;
                }
                dealloc(mem);
            }
            shape = shape + 1u32;
        }
        c = c + 1u32;
    }
    return 0i32;
}

// ── 1220..1279: the mutation law sweep ─────────────────────────────────────
//
// One base per operation, ten apart:
//   1220 insert   1230 update GROWING   1240 update SHRINKING
//   1250 remove   1260 merge            1270 split
//
// The two update bases are separate on purpose. An update is the only
// operation whose row count does not move, so it is the only one whose prepare
// can fail for a purely CONTENT reason, and it is the only one that can hand
// bytes BACK. Both directions run through the one expression in `price_geom`
// and neither is padded — a margin would be the copy-restore need returning in
// disguise, which is the whole thing the exact-prepare design removes.
fn check_vle_mut_ops(cols: u32, shape: u32, rows: u64, policy: u32, seed: &mut u64) -> i32 {
    let d: PdtDescr = descr_vle_shape(cols, shape);
    let m0: VModel = vm_for_shape(cols, shape, rows, 7u64, seed);
    // Room for the largest intermediate any step below reaches.
    let blk: u32 = vle_block_for(&d, &m0, rows + 8u64, 512u64);

    unsafe {
        // ── insert ────────────────────────────────────────────────────────
        let mut ai: u64 = 0u64;
        while ai <= rows {
            let mem: *mut u8 = alloc(blk as i64);
            let mut b: PdtBuf = match build_vle(mem, blk, &d, &m0) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    return 1225i32;
                }
            };
            let ins: VModel = vm_for_shape(cols, shape, 3u64, 9u64, seed);
            let vals: PdtVals = vm_to_vals(&ins);
            let us: PdtUpdate = match b.prepare_insert_vals(ai, ins.rows, policy, &vals) {
                Result::Ok(u) => { u }
                Result::Err(_) => {
                    dealloc(mem);
                    return 1226i32;
                }
            };
            b.commit_insert_vals(&us, &vals);
            let mm: VModel = vm_insert(&m0, ai, &ins);
            let rc: i32 = assert_vle_mutation(&b, &mm, shape, us.prepared_bytes, 1220i32);
            if rc != 0i32 {
                dealloc(mem);
                return rc;
            }
            dealloc(mem);
            ai = ai + 1u64;
            if rows > 4u64 && ai > 2u64 && ai < rows {
                ai = rows;   // ends and one interior position
            }
        }

        // ── update, GROWING and SHRINKING ─────────────────────────────────
        // `grow` picks replacement lengths above the current ones, `shrink`
        // below, so both signs of the payload delta are reached deliberately
        // rather than by luck of the seed.
        let mut gi: u32 = 0u32;
        while gi < 2u32 {
            let base: i32 = 1230i32 + 10i32 * (gi as i32);
            let mut au: u64 = 0u64;
            while au < rows {
                let cnt: u64 = if au + 2u64 <= rows { 2u64 } else { 1u64 };
                let mem2: *mut u8 = alloc(blk as i64);
                let mut b2: PdtBuf = match build_vle(mem2, blk, &d, &m0) {
                    Result::Ok(q) => { q }
                    Result::Err(_) => {
                        dealloc(mem2);
                        return base + 5i32;
                    }
                };
                let maxl: u64 = if gi == 0u32 { 14u64 } else { 1u64 };
                let repl: VModel = vm_for_shape(cols, shape, cnt, maxl, seed);
                let vals2: PdtVals = vm_to_vals(&repl);
                let us2: PdtUpdate =
                    match b2.prepare_update_vals(au, cnt, policy, &vals2) {
                        Result::Ok(u) => { u }
                        Result::Err(_) => {
                            dealloc(mem2);
                            return base + 6i32;
                        }
                    };
                b2.commit_update_vals(&us2, &vals2);
                let mm2: VModel = vm_update(&m0, au, &repl);
                let rc2: i32 =
                    assert_vle_mutation(&b2, &mm2, shape, us2.prepared_bytes, base);
                if rc2 != 0i32 {
                    dealloc(mem2);
                    return rc2;
                }
                dealloc(mem2);
                au = au + 1u64;
                if rows > 4u64 && au > 2u64 && au + 1u64 < rows {
                    au = rows - 1u64;
                }
            }
            gi = gi + 1u32;
        }

        // ── remove ────────────────────────────────────────────────────────
        let mut sr: u64 = 0u64;
        while sr < rows {
            let er: u64 = if sr + 2u64 <= rows { sr + 2u64 } else { rows };
            let mem3: *mut u8 = alloc(blk as i64);
            let mut b3: PdtBuf = match build_vle(mem3, blk, &d, &m0) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem3);
                    return 1255i32;
                }
            };
            let us3: PdtUpdate = match b3.prepare_remove(sr, er, policy) {
                Result::Ok(u) => { u }
                Result::Err(_) => {
                    dealloc(mem3);
                    return 1256i32;
                }
            };
            b3.commit_remove(&us3);
            let mm3: VModel = vm_remove(&m0, sr, er);
            let rc3: i32 = assert_vle_mutation(&b3, &mm3, shape, us3.prepared_bytes, 1250i32);
            if rc3 != 0i32 {
                dealloc(mem3);
                return rc3;
            }
            dealloc(mem3);
            sr = sr + 1u64;
            if rows > 4u64 && sr > 2u64 && sr + 1u64 < rows {
                sr = rows - 1u64;
            }
        }

        // ── merge ─────────────────────────────────────────────────────────
        let other: VModel = vm_for_shape(cols, shape, 4u64, 8u64, seed);
        let blk2: u32 = vle_block_for(&d, &other, 8u64, 512u64);
        let mem4: *mut u8 = alloc(blk as i64);
        let omem: *mut u8 = alloc(blk2 as i64);
        let mut b4: PdtBuf = match build_vle(mem4, blk, &d, &m0) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem4);
                dealloc(omem);
                return 1265i32;
            }
        };
        let ob: PdtBuf = match build_vle(omem, blk2, &d, &other) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem4);
                dealloc(omem);
                return 1266i32;
            }
        };
        let us4: PdtUpdate = match b4.prepare_merge_with(&ob, policy) {
            Result::Ok(u) => { u }
            Result::Err(_) => {
                dealloc(mem4);
                dealloc(omem);
                return 1267i32;
            }
        };
        b4.commit_merge_with(&us4, &ob);
        let mm4: VModel = vm_concat(&m0, &other);
        let rc4: i32 = assert_vle_mutation(&b4, &mm4, shape, us4.prepared_bytes, 1260i32);
        dealloc(mem4);
        dealloc(omem);
        if rc4 != 0i32 {
            return rc4;
        }

        // ── split ─────────────────────────────────────────────────────────
        // TWO budgets, one verdict: only the receiving side can fail, so both
        // halves are asserted against their own model after the one commit.
        let mut sp: u64 = 0u64;
        while sp <= rows {
            let mem5: *mut u8 = alloc(blk as i64);
            let omem5: *mut u8 = alloc(blk as i64);
            let mut b5: PdtBuf = match build_vle(mem5, blk, &d, &m0) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem5);
                    dealloc(omem5);
                    return 1275i32;
                }
            };
            let empty: VModel = vm_new(cols, shape_vle_dims(shape), shape_has_fse(shape));
            let mut o5: PdtBuf = match build_vle(omem5, blk, &d, &empty) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem5);
                    dealloc(omem5);
                    return 1276i32;
                }
            };
            let spl: PdtSplit = match b5.prepare_split_to(&o5, sp, policy) {
                Result::Ok(s) => { s }
                Result::Err(_) => {
                    dealloc(mem5);
                    dealloc(omem5);
                    return 1277i32;
                }
            };
            b5.commit_split_to(&mut o5, &spl);
            let ml: VModel = vm_slice(&m0, 0u64, sp);
            let mr: VModel = vm_slice(&m0, sp, rows);
            let rl: i32 = assert_vle_mutation(&b5, &ml, shape, spl.left.prepared_bytes, 1270i32);
            if rl != 0i32 {
                dealloc(mem5);
                dealloc(omem5);
                return rl;
            }
            let rr: i32 = assert_vle_mutation(&o5, &mr, shape, spl.right.prepared_bytes, 1270i32);
            if rr != 0i32 {
                dealloc(mem5);
                dealloc(omem5);
                return rr;
            }
            dealloc(mem5);
            dealloc(omem5);
            sp = sp + 1u64;
            if rows > 4u64 && sp > 2u64 && sp < rows {
                sp = rows;
            }
        }
    }
    return 0i32;
}

// ── 1280: byte identity over the ADDRESSABLE content ───────────────────────
//
// The round-trip laws — remove(insert(x)) == x and merge(split(x, k)) == x —
// are asserted BYTE for byte, but over the bytes a row can actually address,
// which is strictly less than the block:
//
//   FSE cells    rows [0, size)              size * elem_size bytes
//   VLE payload  [0, offsets[size])          payload_used bytes
//   VLE offsets  entries [0, size]           (size + 1) * PDT_OFFSET_BYTES
//
// EVERY block is priced through `round_up_bytes`, so each one ends in up to 7
// bytes that no row, no offset and no cell can name. Those bytes are not
// state: nothing writes them deliberately and nothing reads them, so requiring
// them to match would assert something false about the design rather than
// something true about the mutation. The same goes for the cells and offset
// entries past `size` — a shrink lowers `size` without scrubbing what was
// above it, exactly as PkdAlloc's shrink compacts payloads without zeroing the
// tail it vacates (the honest weakening already recorded at P3).
//
// Under PDT_CAP_EXACT — the policy every round-trip law below runs at —
// capacity equals size afterwards, so these extents coincide with the
// capacity-based ones the payload pricing itself uses: FSE capacity*elem_size
// and VLE (capacity+1)*PDT_OFFSET_BYTES. Capacity equality is asserted
// separately, so the coincidence is checked rather than assumed.
//
// This is what catches a rebase error that model equivalence alone would miss:
// an offsets table rebased to a different base, or a payload compacted to a
// different origin, still answers every row query correctly while being a
// different block.
unsafe fn vle_content_identical(a: &PdtBuf, b: &PdtBuf) -> bool {
    if a.size() != b.size() || a.capacity() != b.capacity() {
        return false;
    }
    if a.columns() != b.columns() || a.dim_count() != b.dim_count() {
        return false;
    }
    if a.consumed_bytes() != b.consumed_bytes() {
        return false;
    }
    let n: u64 = a.size();
    let cols: u32 = a.columns();
    let dims: u32 = a.dim_count();
    let mut c: u32 = 0u32;
    while c < cols {
        let mut j: u32 = 0u32;
        while j < dims {
            let d: PdtDim = a.dim_at(j);
            let e: PdtDim = b.dim_at(j);
            if d.kind != e.kind || d.elem_size != e.elem_size {
                return false;
            }
            if d.kind == PDT_DIM_VLE {
                // the offsets table, entry by entry over the live rows
                let oa: *mut u32 = a.offsets(c, j);
                let ob: *mut u32 = b.offsets(c, j);
                let mut k: u64 = 0u64;
                while k <= n {
                    if *oa.add(k as u32) != *ob.add(k as u32) {
                        return false;
                    }
                    k = k + 1u64;
                }
                // the payload, byte by byte over [0, offsets[size])
                let used: u64 = a.payload_used(c, j);
                if used != b.payload_used(c, j) {
                    return false;
                }
                let pa: *mut u8 = a.payload(c, j);
                let pb: *mut u8 = b.payload(c, j);
                let mut i: i64 = 0i64;
                while i < (used as i64) {
                    if *pa.byte_add(i) != *pb.byte_add(i) {
                        return false;
                    }
                    i = i + 1i64;
                }
            } else {
                let sz: i64 = (n as i64) * (d.elem_size as i64);
                if sz > 0i64 {
                    let ca: *mut u8 = a.cell_ptr(c, j, 0u64);
                    let cb: *mut u8 = b.cell_ptr(c, j, 0u64);
                    let mut i2: i64 = 0i64;
                    while i2 < sz {
                        if *ca.byte_add(i2) != *cb.byte_add(i2) {
                            return false;
                        }
                        i2 = i2 + 1i64;
                    }
                }
            }
            j = j + 1u32;
        }
        c = c + 1u32;
    }
    return true;
}

/// remove(insert(x)) == x and merge(split(x, k)) == x, byte for byte over the
/// addressable content, for EVERY cut k.
fn check_vle_roundtrip(cols: u32, shape: u32, rows: u64, seed: &mut u64) -> i32 {
    let d: PdtDescr = descr_vle_shape(cols, shape);
    let m0: VModel = vm_for_shape(cols, shape, rows, 7u64, seed);
    let blk: u32 = vle_block_for(&d, &m0, rows + 8u64, 768u64);

    unsafe {
        // ── insert then remove the very rows inserted ─────────────────────
        let mut at: u64 = 0u64;
        while at <= rows {
            let mem: *mut u8 = alloc(blk as i64);
            let refmem: *mut u8 = alloc(blk as i64);
            let mut b: PdtBuf = match build_vle(mem, blk, &d, &m0) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(refmem);
                    return 1285i32;
                }
            };
            let rb: PdtBuf = match build_vle(refmem, blk, &d, &m0) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(refmem);
                    return 1286i32;
                }
            };
            let ins: VModel = vm_for_shape(cols, shape, 3u64, 9u64, seed);
            let vals: PdtVals = vm_to_vals(&ins);
            match b.insert_rows_vals(at, ins.rows, &vals) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(refmem);
                    return 1287i32;
                }
            }
            match b.remove_rows(at, at + ins.rows) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    dealloc(mem);
                    dealloc(refmem);
                    return 1288i32;
                }
            }
            let same: bool = vle_content_identical(&b, &rb);
            let rc: i32 = assert_vle_mutation(&b, &m0, shape, b.consumed_bytes(), 1280i32);
            dealloc(mem);
            dealloc(refmem);
            if rc != 0i32 {
                return rc;
            }
            if !same {
                return 1289i32;
            }
            at = at + 1u64;
            if rows > 3u64 && at > 1u64 && at < rows {
                at = rows;
            }
        }

        // ── split at every cut, then merge back ───────────────────────────
        let mut k: u64 = 0u64;
        while k <= rows {
            let mem2: *mut u8 = alloc(blk as i64);
            let omem2: *mut u8 = alloc(blk as i64);
            let refm2: *mut u8 = alloc(blk as i64);
            let mut b2: PdtBuf = match build_vle(mem2, blk, &d, &m0) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem2);
                    dealloc(omem2);
                    dealloc(refm2);
                    return 1285i32;
                }
            };
            let empty: VModel = vm_new(cols, shape_vle_dims(shape), shape_has_fse(shape));
            let mut o2: PdtBuf = match build_vle(omem2, blk, &d, &empty) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem2);
                    dealloc(omem2);
                    dealloc(refm2);
                    return 1286i32;
                }
            };
            let rb2: PdtBuf = match build_vle(refm2, blk, &d, &m0) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem2);
                    dealloc(omem2);
                    dealloc(refm2);
                    return 1287i32;
                }
            };
            match b2.split_to(&mut o2, k) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    dealloc(mem2);
                    dealloc(omem2);
                    dealloc(refm2);
                    return 1288i32;
                }
            }
            match b2.merge_from(&o2) {
                Result::Ok(_) => {}
                Result::Err(_) => {
                    dealloc(mem2);
                    dealloc(omem2);
                    dealloc(refm2);
                    return 1288i32;
                }
            }
            let same2: bool = vle_content_identical(&b2, &rb2);
            let rc2: i32 = assert_vle_mutation(&b2, &m0, shape, b2.consumed_bytes(), 1280i32);
            dealloc(mem2);
            dealloc(omem2);
            dealloc(refm2);
            if rc2 != 0i32 {
                return rc2;
            }
            if !same2 {
                return 1289i32;
            }
            k = k + 1u64;
            if rows > 3u64 && k > 1u64 && k < rows {
                k = rows;
            }
        }
    }
    return 0i32;
}

// ── 1290: the capacity policy, extended to the PAYLOAD coherently ──────────
//
// P3 made the row capacity an explicit axis (PDT_CAP_EXACT trims, PDT_CAP_KEEP
// honours a reservation). P4 has to answer the same question for the payload,
// and the answer has to be the SAME reading or the axis has two meanings:
//
//   KEEP   a replacement that fits inside the payload the block already holds
//          costs NOTHING — grow_bytes == 0 and the priced total is unchanged.
//          This is what makes a fill loop that reserved once pay per-row zero.
//   EXACT  the payload follows the rows in BOTH directions: a shrinking
//          update hands bytes back to the node, it does not keep them.
//
// The classification is asserted, not just the arithmetic — "the numbers add
// up" is satisfied by a policy axis that does nothing at all.
fn check_vle_policy(cols: u32, shape: u32, seed: &mut u64) -> i32 {
    let d: PdtDescr = descr_vle_shape(cols, shape);
    // Long rows, so that a replacement by SHORT ones is a real shrink.
    let m0: VModel = vm_random(cols, shape_vle_dims(shape), shape_has_fse(shape),
                               6u64, 12u64, seed);
    let blk: u32 = vle_block_for(&d, &m0, 16u64, 1024u64);

    unsafe {
        // KEEP: shrink the content, and the priced total must NOT move — the
        // block keeps the payload capacity it already had.
        let mem: *mut u8 = alloc(blk as i64);
        let mut b: PdtBuf = match build_vle(mem, blk, &d, &m0) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 1295i32;
            }
        };
        let before: u32 = b.consumed_bytes();
        let small: VModel = vm_random(cols, shape_vle_dims(shape), shape_has_fse(shape),
                                      2u64, 1u64, seed);
        let vals: PdtVals = vm_to_vals(&small);
        let usk: PdtUpdate = match b.prepare_update_vals(0u64, 2u64, PDT_CAP_KEEP, &vals) {
            Result::Ok(u) => { u }
            Result::Err(_) => {
                dealloc(mem);
                return 1296i32;
            }
        };
        if usk.prepared_bytes != before {
            dealloc(mem);
            return 1290i32;
        }
        if usk.grow_bytes() != 0u32 {
            dealloc(mem);
            return 1291i32;
        }
        if !usk.is_free() {
            dealloc(mem);
            return 1292i32;
        }
        b.commit_update_vals(&usk, &vals);
        let mk: VModel = vm_update(&m0, 0u64, &small);
        let rck: i32 = assert_vle_mutation(&b, &mk, shape, usk.prepared_bytes, 1290i32);
        dealloc(mem);
        if rck != 0i32 {
            return rck;
        }

        // EXACT: the same shrink must hand bytes BACK.
        let mem2: *mut u8 = alloc(blk as i64);
        let mut b2: PdtBuf = match build_vle(mem2, blk, &d, &m0) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem2);
                return 1295i32;
            }
        };
        let vals2: PdtVals = vm_to_vals(&small);
        let use2: PdtUpdate = match b2.prepare_update_vals(0u64, 2u64, PDT_CAP_EXACT, &vals2) {
            Result::Ok(u) => { u }
            Result::Err(_) => {
                dealloc(mem2);
                return 1296i32;
            }
        };
        if use2.shrink_bytes() == 0u32 {
            dealloc(mem2);
            return 1293i32;
        }
        if use2.prepared_bytes >= use2.before_bytes {
            dealloc(mem2);
            return 1294i32;
        }
        b2.commit_update_vals(&use2, &vals2);
        let mk2: VModel = vm_update(&m0, 0u64, &small);
        let rce: i32 = assert_vle_mutation(&b2, &mk2, shape, use2.prepared_bytes, 1290i32);
        dealloc(mem2);
        if rce != 0i32 {
            return rce;
        }

        // KEEP again, GROWING inside the reserved payload: still free. This is
        // the case GAP (b) named for rows, now answered for bytes.
        let mem3: *mut u8 = alloc(blk as i64);
        let mut b3: PdtBuf = match build_vle(mem3, blk, &d, &m0) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem3);
                return 1295i32;
            }
        };
        // Reserve generous payload headroom explicitly, then grow into it.
        let mut want: Vec<u64> = vec_new::<u64>();
        let mut z: i64 = 0i64;
        while z < d.payload_len() {
            want.push(0u64);
            z = z + 1i64;
        }
        let mut cc: u32 = 0u32;
        while cc < cols {
            let mut oo: u32 = 0u32;
            while oo < shape_vle_dims(shape) {
                let kk: i64 = (cc as i64) * (shape_vle_dims(shape) as i64) + (oo as i64);
                want.set(kk, vm_payload_used(&m0, cc, oo) + 256u64);
                oo = oo + 1u32;
            }
            cc = cc + 1u32;
        }
        match b3.reserve_geom(m0.rows + 8u64, &want) {
            Result::Ok(_) => {}
            Result::Err(_) => {
                dealloc(mem3);
                return 1297i32;
            }
        }
        let reserved: u32 = b3.consumed_bytes();
        let big: VModel = vm_random(cols, shape_vle_dims(shape), shape_has_fse(shape),
                                    2u64, 20u64, seed);
        let vals3: PdtVals = vm_to_vals(&big);
        let usg: PdtUpdate = match b3.prepare_update_vals(0u64, 2u64, PDT_CAP_KEEP, &vals3) {
            Result::Ok(u) => { u }
            Result::Err(_) => {
                dealloc(mem3);
                return 1296i32;
            }
        };
        if usg.prepared_bytes != reserved {
            dealloc(mem3);
            return 1298i32;
        }
        if usg.grow_bytes() != 0u32 {
            dealloc(mem3);
            return 1299i32;
        }
        b3.commit_update_vals(&usg, &vals3);
        let mg: VModel = vm_update(&m0, 0u64, &big);
        let rcg: i32 = assert_vle_mutation(&b3, &mg, shape, usg.prepared_bytes, 1290i32);
        dealloc(mem3);
        if rcg != 0i32 {
            return rcg;
        }
    }
    return 0i32;
}

// ── 1300: SUM => FIXED, as a runtime law with a clean diagnostic ───────────
//
// The C++ spells this as a static_assert (so.hpp:349) — a variable-length
// dimension has no accumulation, so a SUM-ordered VLE buffer is not a thing
// that can be asked for. Carried as a RUNTIME descriptor, the constraint has
// to become a runtime law, and a law needs a diagnostic rather than a
// mis-sized block: `pdt_descr_check` names it, `pdt_assert_descr` refuses at
// the FIRST use of the descriptor rather than at whichever query later trips
// over it. The sibling law is the same shape: an ORDERED buffer searches on
// dimension 0, so dimension 0 must be FSE.
//
// Asserted through the checking face, not the asserting one — the assert is a
// process abort by design, which a gate cannot catch and should not want to.
fn check_vle_descr_laws() -> i32 {
    let mut c: u32 = 1u32;
    while c <= 4u32 {
        // SUM + VLE anywhere in the dimension list is rejected.
        let mut d1: PdtDescr = pdt_descr_new(c, PDT_ORD_SUM, false);
        d1.dims.push(pdt_dim_fse(8u32));
        d1.dims.push(pdt_dim_vle(1u32));
        if pdt_descr_check(&d1) != 3i32 {
            return 1300i32;
        }
        // ... including when the VLE dimension is the only one.
        let mut d2: PdtDescr = pdt_descr_new(c, PDT_ORD_SUM, false);
        d2.dims.push(pdt_dim_vle(1u32));
        if pdt_descr_check(&d2) != 3i32 {
            return 1301i32;
        }
        // MAX with a VLE dimension 0 is rejected for the OTHER reason: the
        // search key is dimension 0.
        let mut d3: PdtDescr = pdt_descr_new(c, PDT_ORD_MAX, false);
        d3.dims.push(pdt_dim_vle(1u32));
        if pdt_descr_check(&d3) != 4i32 {
            return 1302i32;
        }
        // The shapes this rung actually runs are all accepted.
        let mut s: u32 = 0u32;
        while s <= 2u32 {
            let ds: PdtDescr = descr_vle_shape(c, s);
            if pdt_descr_check(&ds) != 0i32 {
                return 1303i32;
            }
            // and none of them can carry an index, whatever `indexed` says.
            if ds.has_index() {
                return 1304i32;
            }
            s = s + 1u32;
        }
        // Even asking for it explicitly: `indexed` is the arithmetic half, the
        // ordering half is a law. A VLE descriptor flagged indexed still
        // reports no index, and is still rejected under SUM.
        let mut d4: PdtDescr = pdt_descr_new(c, PDT_ORD_MAX, true);
        d4.dims.push(pdt_dim_fse(8u32));
        d4.dims.push(pdt_dim_vle(1u32));
        if pdt_descr_check(&d4) != 0i32 {
            return 1305i32;
        }
        if d4.has_index() {
            return 1306i32;
        }
        c = c + 1u32;
    }
    return 0i32;
}

// ── 1310: the corners ──────────────────────────────────────────────────────
//
// Empty spans (length 0), size 0, capacity 0, and a corpus deliberately mixing
// empty and non-empty rows. A zero-length row is not a degenerate case to be
// tolerated: it is the case where offs[r] == offs[r+1], which is exactly the
// state a monotonicity check written with `<` instead of `<=` would reject and
// a rebase written with an off-by-one would corrupt.
fn check_vle_corners(cols: u32, shape: u32, seed: &mut u64) -> i32 {
    let d: PdtDescr = descr_vle_shape(cols, shape);
    let vle: u32 = shape_vle_dims(shape);
    let fse: bool = shape_has_fse(shape);

    unsafe {
        // ── size 0 / capacity 0: a formatted block with no rows at all ────
        let empty: VModel = vm_new(cols, vle, fse);
        let blk0: u32 = vle_block_for(&d, &empty, 0u64, 0u64);
        let mem0: *mut u8 = alloc(blk0 as i64);
        let b0: PdtBuf = match build_vle(mem0, blk0, &d, &empty) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem0);
                return 1315i32;
            }
        };
        if b0.size() != 0u64 || b0.capacity() != 0u64 {
            dealloc(mem0);
            return 1310i32;
        }
        let mut c0: u32 = 0u32;
        while c0 < cols {
            let mut o0: u32 = 0u32;
            while o0 < vle {
                let dim: u32 = shape_dim_of(shape, o0);
                // offsets[0] exists and is 0 even with no rows — the
                // terminator is always addressable.
                if b0.row_offset(c0, dim, 0u64) != 0u64 {
                    dealloc(mem0);
                    return 1311i32;
                }
                if b0.payload_used(c0, dim) != 0u64 {
                    dealloc(mem0);
                    return 1312i32;
                }
                o0 = o0 + 1u32;
            }
            c0 = c0 + 1u32;
        }
        let rc0: i32 = assert_vle_mutation(&b0, &empty, shape, b0.consumed_bytes(), 1310i32);
        dealloc(mem0);
        if rc0 != 0i32 {
            return rc0;
        }

        // ── all rows EMPTY: every span length 0 ───────────────────────────
        let zero: VModel = vm_random(cols, vle, fse, 5u64, 0u64, seed);
        let blkz: u32 = vle_block_for(&d, &zero, 4u64, 64u64);
        let memz: *mut u8 = alloc(blkz as i64);
        let mut bz: PdtBuf = match build_vle(memz, blkz, &d, &zero) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(memz);
                return 1315i32;
            }
        };
        let rcz: i32 = assert_vle_mutation(&bz, &zero, shape, bz.consumed_bytes(), 1310i32);
        if rcz != 0i32 {
            dealloc(memz);
            return rcz;
        }
        // every span reads back empty, and every offset is 0
        let mut cz: u32 = 0u32;
        while cz < cols {
            let mut oz: u32 = 0u32;
            while oz < vle {
                let dimz: u32 = shape_dim_of(shape, oz);
                let mut rz: u64 = 0u64;
                while rz < zero.rows {
                    if bz.row_span(cz, dimz, rz).len() != 0i64 {
                        dealloc(memz);
                        return 1313i32;
                    }
                    if bz.row_offset(cz, dimz, rz) != 0u64 {
                        dealloc(memz);
                        return 1314i32;
                    }
                    rz = rz + 1u64;
                }
                oz = oz + 1u32;
            }
            cz = cz + 1u32;
        }
        // growing an all-empty buffer, then emptying it again
        let grow: VModel = vm_random(cols, vle, fse, 2u64, 6u64, seed);
        let gv: PdtVals = vm_to_vals(&grow);
        match bz.insert_rows_vals(2u64, grow.rows, &gv) {
            Result::Ok(_) => {}
            Result::Err(_) => {
                dealloc(memz);
                return 1316i32;
            }
        }
        let mz2: VModel = vm_insert(&zero, 2u64, &grow);
        let rcz2: i32 = assert_vle_mutation(&bz, &mz2, shape, bz.consumed_bytes(), 1310i32);
        if rcz2 != 0i32 {
            dealloc(memz);
            return rcz2;
        }
        // replace them with empty spans again: a shrink to exactly zero
        let back: VModel = vm_random(cols, vle, fse, 2u64, 0u64, seed);
        let bv: PdtVals = vm_to_vals(&back);
        match bz.update_rows_vals(2u64, back.rows, &bv) {
            Result::Ok(_) => {}
            Result::Err(_) => {
                dealloc(memz);
                return 1317i32;
            }
        }
        let mz3: VModel = vm_update(&mz2, 2u64, &back);
        let rcz3: i32 = assert_vle_mutation(&bz, &mz3, shape, bz.consumed_bytes(), 1310i32);
        dealloc(memz);
        if rcz3 != 0i32 {
            return rcz3;
        }

        // ── MIXED empty and non-empty, with the empties at the ends ───────
        // Built by hand rather than by seed so the shape is guaranteed: the
        // first and last rows are empty, the middle ones are not.
        let mut mix: VModel = vm_new(cols, vle, fse);
        vm_gen_row(&mut mix, 0u64, seed);
        vm_gen_row(&mut mix, 9u64, seed);
        vm_gen_row(&mut mix, 0u64, seed);
        vm_gen_row(&mut mix, 9u64, seed);
        vm_gen_row(&mut mix, 0u64, seed);
        let blkm: u32 = vle_block_for(&d, &mix, 6u64, 256u64);
        let memm: *mut u8 = alloc(blkm as i64);
        let mut bm: PdtBuf = match build_vle(memm, blkm, &d, &mix) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(memm);
                return 1315i32;
            }
        };
        let rcm: i32 = assert_vle_mutation(&bm, &mix, shape, bm.consumed_bytes(), 1310i32);
        if rcm != 0i32 {
            dealloc(memm);
            return rcm;
        }
        // removing an EMPTY row must move no payload byte and cost no payload
        let usm: PdtUpdate = match bm.prepare_remove(0u64, 1u64, PDT_CAP_KEEP) {
            Result::Ok(u) => { u }
            Result::Err(_) => {
                dealloc(memm);
                return 1318i32;
            }
        };
        bm.commit_remove(&usm);
        let mm: VModel = vm_remove(&mix, 0u64, 1u64);
        let rcm2: i32 = assert_vle_mutation(&bm, &mm, shape, usm.prepared_bytes, 1310i32);
        dealloc(memm);
        if rcm2 != 0i32 {
            return rcm2;
        }
    }
    return 0i32;
}

// ── 1320: randomized mixed sequences ───────────────────────────────────────
//
// Scripted sweeps reach the states someone thought of. This reaches the ones
// nobody did: a long run of insert / update / remove at random positions with
// random lengths, with the FULL law re-asserted after every single step, so a
// defect that only appears in a particular ORDER of operations — a stale
// offset that the next operation happens to overwrite, a payload compaction
// that is only wrong when it follows a shrink — has somewhere to show up.
fn check_vle_sequences(cols: u32, shape: u32, policy: u32, steps: i64, seed: &mut u64) -> i32 {
    let d: PdtDescr = descr_vle_shape(cols, shape);
    let vle: u32 = shape_vle_dims(shape);
    let fse: bool = shape_has_fse(shape);
    let mut m: VModel = vm_random(cols, vle, fse, 4u64, 6u64, seed);
    // Headroom for the largest state the walk can reach.
    let cap_rows: u64 = 40u64;
    let blk: u32 = pdtbuf_compute_block_size(&d, cap_rows, &vle_pay_flat(&d, 4096u64));

    unsafe {
        let mem: *mut u8 = alloc(blk as i64);
        let mut b: PdtBuf = match build_vle(mem, blk, &d, &m) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 1325i32;
            }
        };
        let mut st: i64 = 0i64;
        while st < steps {
            let op: u64 = lcg_next(seed) % 3u64;
            if op == 0u64 && m.rows < 24u64 {
                let at: u64 = lcg_next(seed) % (m.rows + 1u64);
                let n: u64 = 1u64 + lcg_next(seed) % 3u64;
                let ins: VModel = vm_random(cols, vle, fse, n, 10u64, seed);
                let vals: PdtVals = vm_to_vals(&ins);
                let us: PdtUpdate = match b.prepare_insert_vals(at, n, policy, &vals) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        return 1326i32;
                    }
                };
                b.commit_insert_vals(&us, &vals);
                let nm: VModel = vm_insert(&m, at, &ins);
                m = nm;
                let rc: i32 = assert_vle_mutation(&b, &m, shape, us.prepared_bytes, 1320i32);
                if rc != 0i32 {
                    dealloc(mem);
                    return rc;
                }
            } else if op == 1u64 && m.rows > 0u64 {
                let at2: u64 = lcg_next(seed) % m.rows;
                let n2: u64 = 1u64 + lcg_next(seed) % 2u64;
                let cnt: u64 = if at2 + n2 <= m.rows { n2 } else { m.rows - at2 };
                // maxlen swings wide so both grow and shrink are reached
                let ml: u64 = lcg_next(seed) % 15u64;
                let repl: VModel = vm_random(cols, vle, fse, cnt, ml, seed);
                let vals2: PdtVals = vm_to_vals(&repl);
                let us2: PdtUpdate = match b.prepare_update_vals(at2, cnt, policy, &vals2) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        return 1327i32;
                    }
                };
                b.commit_update_vals(&us2, &vals2);
                let nm2: VModel = vm_update(&m, at2, &repl);
                m = nm2;
                let rc2: i32 = assert_vle_mutation(&b, &m, shape, us2.prepared_bytes, 1320i32);
                if rc2 != 0i32 {
                    dealloc(mem);
                    return rc2;
                }
            } else if m.rows > 0u64 {
                let s3: u64 = lcg_next(seed) % m.rows;
                let e3: u64 = s3 + 1u64 + lcg_next(seed) % 2u64;
                let end: u64 = if e3 <= m.rows { e3 } else { m.rows };
                let us3: PdtUpdate = match b.prepare_remove(s3, end, policy) {
                    Result::Ok(u) => { u }
                    Result::Err(_) => {
                        dealloc(mem);
                        return 1328i32;
                    }
                };
                b.commit_remove(&us3);
                let nm3: VModel = vm_remove(&m, s3, end);
                m = nm3;
                let rc3: i32 = assert_vle_mutation(&b, &m, shape, us3.prepared_bytes, 1320i32);
                if rc3 != 0i32 {
                    dealloc(mem);
                    return rc3;
                }
            }
            st = st + 1i64;
        }
        dealloc(mem);
    }
    return 0i32;
}

/// A flat payload-geometry vector with the same byte budget in every entry.
fn vle_pay_flat(d: &PdtDescr, bytes: u64) -> Vec<u64> {
    let mut v: Vec<u64> = vec_new::<u64>();
    let n: i64 = d.payload_len();
    let mut i: i64 = 0i64;
    while i < n {
        v.push(bytes);
        i = i + 1i64;
    }
    return v;
}

// ── 1330: the C++ HEAD variable-length cross-check (marker 5) ──────────────
//
// SECONDARY, as always at this ladder. The marker-5 corpus is the final state
// of a scripted insert / single-row-update / remove sequence that HEAD ran
// against its OWN naive model and only emitted when the two agreed, so these
// fixtures pin the variable-length paths where HEAD is right — which is
// exactly the value of them: agreement there is evidence our structure holds
// the same content, and the paths where HEAD is NOT right are pinned
// separately at 1340 because a fixture of them cannot safely be produced.
//
// The corpus shape is HEAD's: PackedDataTypeBufferT<Varchar, false, C,
// DTOrdering::UNORDERED>, i.e. our shape 0, one VLE dimension, no FSE key.
// maxlen 0 cases make an ENTIRE corpus of empty spans.
fn check_vle_fixture_case(s: str, pos: &mut i64) -> i32 {
    let cols: u32 = next_tok(s, pos) as u32;
    let rows: u64 = next_tok(s, pos);
    if cols < 1u32 || cols > 4u32 {
        return 1335i32;
    }
    let d: PdtDescr = descr_vle_shape(cols, 0u32);
    let mut m: VModel = vm_new(cols, 1u32, false);
    // ROW-MAJOR, the order the oracle emits: r outer, c inner. That is the
    // order `lens` is indexed in, so the parse is a straight append.
    let mut r: u64 = 0u64;
    while r < rows {
        let mut c: u32 = 0u32;
        while c < cols {
            let n: u64 = next_tok(s, pos);
            m.lens.push(n);
            let mut i: u64 = 0u64;
            while i < n {
                m.bytes.push(next_tok(s, pos) as u8);
                i = i + 1u64;
            }
            c = c + 1u32;
        }
        m.rows = m.rows + 1u64;
        r = r + 1u64;
    }
    if m.rows != rows {
        return 1336i32;
    }

    unsafe {
        let blk: u32 = vle_block_for(&d, &m, 4u64, 128u64);
        let mem: *mut u8 = alloc(blk as i64);
        let b: PdtBuf = match build_vle(mem, blk, &d, &m) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 1337i32;
            }
        };
        // The full law, against HEAD's content rather than a generated one.
        let rc: i32 = assert_vle_mutation(&b, &m, 0u32, b.consumed_bytes(), 1330i32);
        dealloc(mem);
        if rc != 0i32 {
            return rc;
        }
    }
    return 0i32;
}

// ── 1340: upstream defect #28, pinned as a DIVERGENCE ──────────────────────
//
// HEAD's MULTI-ROW update over a variable-length dimension corrupts the block.
// `do_commit_update_var_max` (so.hpp:1050-1084) corrects only the AGGREGATE
// length of [at, at+count) — through `resize_block(at, count, Σ new lengths)`
// — and then writes each row through `replace_row` (vle_tools.hpp:320-325),
// which memcpy's `value.length()` bytes at `offsets[idx]` and NEVER assigns
// `offsets[idx + 1]`. Every INTERIOR boundary of the updated range keeps its
// OLD position. So each updated row but the first reads back truncated or
// padded, and each write runs for its NEW length from a STALE start,
// overrunning its neighbour — silent corruption that compounds into a SIGSEGV
// in a longer run. Single-row updates ARE correct (`resize_block` does fix
// `offsets[at+1]`), which is exactly what isolates the defect to this path.
//
// It is REACHABLE: `commit_update` on the only dispatcher arm a VARIABLE
// datatype has (so.hpp:249; the SUM/VARIABLE arm is excluded by the
// static_assert at :349, which is the same SUM => FIXED law we enforce at
// 1300). This is upstream's most serious defect in the neighbourhood — the
// other 29 catalogued ones are wrong answers or dead code; this one writes
// past the end of a live buffer.
//
// WHY PROSE AND A LITERAL RATHER THAN A FIXTURE. Emitting HEAD's answer would
// mean reading back a block HEAD has already corrupted, so the oracle
// deliberately does not (see "WHY THERE IS NO MARKER 6" in
// oracle/pdtbuf_dump.cpp). The divergence is pinned here instead, two ways:
//
//   (a) THE LAW, generally: after a multi-row update our block satisfies
//       offs[at+i+1] - offs[at+i] == |v_i| for EVERY i in [0, count) — every
//       boundary laid down sequentially from offs[at]. This is precisely the
//       property HEAD violates, so it is the property worth stating, and it is
//       asserted over a sweep rather than at one point.
//   (b) THE RECORDED CASE, literally: the minimal corpus from the C++ note,
//       with HEAD's verified wrong answer written out. We must produce the
//       right one and must NOT produce HEAD's. Transcribing HEAD's shape into
//       our commit — correct the aggregate, leave the interior alone — makes
//       this section fail, which is what makes it a real probe rather than a
//       restatement.
fn vm_push_lit(m: &mut VModel, s: str) {
    let n: i64 = s.len();
    m.lens.push(n as u64);
    let mut i: i64 = 0i64;
    while i < n {
        m.bytes.push(str_byte_at(s, i));
        i = i + 1i64;
    }
    m.rows = m.rows + 1u64;
}

fn vle_row_is(b: &PdtBuf, dim: u32, r: u64, want: str) -> bool {
    let sp: &[u8] = b.row_span(0u32, dim, r);
    if sp.len() != want.len() {
        return false;
    }
    let mut i: i64 = 0i64;
    while i < sp.len() {
        if sp[i] != str_byte_at(want, i) {
            return false;
        }
        i = i + 1i64;
    }
    return true;
}

fn check_vle_defect28() -> i32 {
    let d: PdtDescr = descr_vle_shape(1u32, 0u32);

    // (b) the recorded minimal case
    let mut m: VModel = vm_new(1u32, 1u32, false);
    vm_push_lit(&mut m, "aaa");
    vm_push_lit(&mut m, "bbbb");
    vm_push_lit(&mut m, "ccccc");
    vm_push_lit(&mut m, "dd");
    vm_push_lit(&mut m, "e");

    let mut repl: VModel = vm_new(1u32, 1u32, false);
    vm_push_lit(&mut repl, "bbbb");
    vm_push_lit(&mut repl, "aaa");

    unsafe {
        let blk: u32 = vle_block_for(&d, &m, 8u64, 256u64);
        let mem: *mut u8 = alloc(blk as i64);
        let mut b: PdtBuf = match build_vle(mem, blk, &d, &m) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 1345i32;
            }
        };
        let vals: PdtVals = vm_to_vals(&repl);
        match b.update_rows_vals(0u64, 2u64, &vals) {
            Result::Ok(_) => {}
            Result::Err(_) => {
                dealloc(mem);
                return 1346i32;
            }
        }
        // the CORRECT answer, row by row
        if !vle_row_is(&b, 0u32, 0u64, "bbbb") {
            dealloc(mem);
            return 1340i32;
        }
        if !vle_row_is(&b, 0u32, 1u64, "aaa") {
            dealloc(mem);
            return 1341i32;
        }
        if !vle_row_is(&b, 0u32, 2u64, "ccccc") {
            dealloc(mem);
            return 1342i32;
        }
        // and NOT HEAD's, which leaves the interior boundary at 3
        if vle_row_is(&b, 0u32, 0u64, "bbb") || vle_row_is(&b, 0u32, 1u64, "aaab") {
            dealloc(mem);
            return 1343i32;
        }
        let mm: VModel = vm_update(&m, 0u64, &repl);
        let rc: i32 = assert_vle_mutation(&b, &mm, 0u32, b.consumed_bytes(), 1340i32);
        dealloc(mem);
        if rc != 0i32 {
            return rc;
        }
    }

    // (a) the law, swept: every boundary of a multi-row update is laid down
    // sequentially, over columns 1..4 and all three descriptor shapes, for
    // counts >= 2 and for replacements that grow, shrink and stay level.
    let mut seed: u64 = 0xD1B54A32D192ED03u64;
    let mut c: u32 = 1u32;
    while c <= 4u32 {
        let mut shape: u32 = 0u32;
        while shape <= 2u32 {
            let ds: PdtDescr = descr_vle_shape(c, shape);
            let vle: u32 = shape_vle_dims(shape);
            let fse: bool = shape_has_fse(shape);
            let base: VModel = vm_random(c, vle, fse, 7u64, 6u64, &mut seed);
            let blk2: u32 = vle_block_for(&ds, &base, 8u64, 512u64);
            let mut ml: u64 = 0u64;
            while ml <= 12u64 {
                let cnt: u64 = 2u64 + (ml % 3u64);
                unsafe {
                    let mem2: *mut u8 = alloc(blk2 as i64);
                    let mut b2: PdtBuf = match build_vle(mem2, blk2, &ds, &base) {
                        Result::Ok(q) => { q }
                        Result::Err(_) => {
                            dealloc(mem2);
                            return 1345i32;
                        }
                    };
                    let rp: VModel = vm_random(c, vle, fse, cnt, ml, &mut seed);
                    let v2: PdtVals = vm_to_vals(&rp);
                    match b2.update_rows_vals(1u64, cnt, &v2) {
                        Result::Ok(_) => {}
                        Result::Err(_) => {
                            dealloc(mem2);
                            return 1346i32;
                        }
                    }
                    // EVERY boundary of the range, not just the aggregate.
                    let mut cc: u32 = 0u32;
                    while cc < c {
                        let mut oo: u32 = 0u32;
                        while oo < vle {
                            let dim: u32 = shape_dim_of(shape, oo);
                            let mut i: u64 = 0u64;
                            while i < cnt {
                                let got: u64 = b2.row_offset(cc, dim, 1u64 + i + 1u64)
                                             - b2.row_offset(cc, dim, 1u64 + i);
                                if got != vm_len(&rp, i, cc, oo) {
                                    dealloc(mem2);
                                    return 1344i32;
                                }
                                i = i + 1u64;
                            }
                            oo = oo + 1u32;
                        }
                        cc = cc + 1u32;
                    }
                    let mm2: VModel = vm_update(&base, 1u64, &rp);
                    let rc2: i32 =
                        assert_vle_mutation(&b2, &mm2, shape, b2.consumed_bytes(), 1340i32);
                    dealloc(mem2);
                    if rc2 != 0i32 {
                        return rc2;
                    }
                }
                ml = ml + 4u64;
            }
            shape = shape + 1u32;
        }
        c = c + 1u32;
    }
    return 0i32;
}

fn run_all() -> i32 {
    let rc1: i32 = check_sizing();
    if rc1 != 0i32 {
        return rc1;
    }
    let rc2: i32 = check_column_canary();
    if rc2 != 0i32 {
        return rc2;
    }
    let rc3: i32 = check_edges();
    if rc3 != 0i32 {
        return rc3;
    }

    // The model sweep: columns 1..4 (the >=3-column path is exercised on
    // every op, not just the canary), both orderings, sizes straddling the
    // IndexSpan boundary.
    let sizes: [u64; 9] = [0u64, 1u64, 2u64, 3u64, 7u64, 16u64, 31u64, 32u64, 33u64];
    let mut seed: u64 = 0x9E3779B97F4A7C15u64;
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let mut si: i64 = 0i64;
        while si < 9i64 {
            let rows: u64 = sizes[si];
            let ra: i32 = check_case(cols, rows, PDT_ORD_SUM, &mut seed);
            if ra != 0i32 {
                return ra;
            }
            let rb: i32 = check_case(cols, rows, PDT_ORD_MAX, &mut seed);
            if rb != 0i32 {
                return rb;
            }
            si = si + 1i64;
        }
        cols = cols + 1u32;
    }

    // ── P1: the recursive span index ──────────────────────────────────────
    let rc5: i32 = check_index_geometry();
    if rc5 != 0i32 {
        return rc5;
    }
    let rc6: i32 = check_empty_index_safety(&mut seed);
    if rc6 != 0i32 {
        return rc6;
    }

    // Three-way at the THRESHOLD, exhaustively: 31 (no index), 32 (the exact
    // boundary), 33 (the first indexed size), and the second-level boundaries.
    let dense_sizes: [u64; 8] = [0u64, 1u64, 31u64, 32u64, 33u64, 34u64,
                                 64u64, 65u64];
    let mut dc: u32 = 1u32;
    while dc <= 4u32 {
        let mut di: i64 = 0i64;
        while di < 8i64 {
            let r: i32 = check_three_way(dc, dense_sizes[di], true, &mut seed);
            if r != 0i32 {
                return r;
            }
            di = di + 1i64;
        }
        dc = dc + 1u32;
    }

    // ... and DEEP, where the tree is genuinely multi-level: 1024 is the last
    // 1-level size (its index is exactly 32 cells), 1025 is the first 2-level
    // size, 32768 the last 2-level one and 32769 the first 3-level one. The
    // level count is asserted at every size (120..122), so "recursive" is a
    // measured property.
    let deep_sizes: [u64; 6] = [1023u64, 1024u64, 1025u64, 2000u64,
                                32768u64, 32769u64];
    let mut kc: u32 = 1u32;
    while kc <= 4u32 {
        let mut ki: i64 = 0i64;
        while ki < 6i64 {
            let r2: i32 = check_three_way(kc, deep_sizes[ki], false, &mut seed);
            if r2 != 0i32 {
                return r2;
            }
            ki = ki + 1i64;
        }
        kc = kc + 1u32;
    }

    // ── P2: the plateau corpora and the under-covering index ──────────────
    // The sweeps above already run every P2 form (check_three_way_body ends
    // in check_from_forms + check_backward), at both threshold and deep
    // sizes, columns 1..4. These two sections add the corpora those sweeps
    // cannot reach by construction: prefix plateaus (where bug #27 lives) and
    // an index that covers only part of the live rows (hazard (a), the second
    // site of bug #26).
    let rc9: i32 = check_p2_depth(&mut seed);
    if rc9 != 0i32 {
        return rc9;
    }
    let rc7: i32 = check_zero_plateaus();
    if rc7 != 0i32 {
        return rc7;
    }
    let rc8: i32 = check_under_covering_index(&mut seed);
    if rc8 != 0i32 {
        return rc8;
    }

    // ── P3: the two-phase mutation surface ────────────────────────────────
    // The op-by-op law sweep: columns 1..4, sizes straddling the span
    // boundary and one deep (multi-level) size, BOTH capacity policies, and
    // — under KEEP — a slack capacity, which is the only state in which rows
    // can grow inside geometry that is already paid for (GAP (b)).
    let mut_sizes: [u64; 7] = [0u64, 1u64, 31u64, 32u64, 33u64, 65u64, 1025u64];
    let mut mc: u32 = 1u32;
    while mc <= 4u32 {
        let mut mi: i64 = 0i64;
        while mi < 7i64 {
            let rows: u64 = mut_sizes[mi];
            let e1: i32 = check_mut_ops(mc, rows, PDT_CAP_EXACT, 0u64, &mut seed);
            if e1 != 0i32 {
                return e1;
            }
            let e2: i32 = check_mut_ops(mc, rows, PDT_CAP_KEEP, 0u64, &mut seed);
            if e2 != 0i32 {
                return e2;
            }
            let e3: i32 = check_mut_ops(mc, rows, PDT_CAP_KEEP, 20u64, &mut seed);
            if e3 != 0i32 {
                return e3;
            }
            let e4: i32 = check_mut_ops(mc, rows, PDT_CAP_EXACT, 20u64, &mut seed);
            if e4 != 0i32 {
                return e4;
            }
            let e5: i32 = check_mut_ops_max(mc, rows, &mut seed);
            if e5 != 0i32 {
                return e5;
            }
            mi = mi + 1i64;
        }
        mc = mc + 1u32;
    }

    let e6: i32 = check_failed_prepare_identity(&mut seed);
    if e6 != 0i32 {
        return e6;
    }
    let e7: i32 = check_insert_remove_inverse(&mut seed);
    if e7 != 0i32 {
        return e7;
    }
    let e8: i32 = check_merge_split_roundtrip(&mut seed);
    if e8 != 0i32 {
        return e8;
    }
    let e9: i32 = check_incremental_reindex(&mut seed);
    if e9 != 0i32 {
        return e9;
    }
    let mut sc: u32 = 1u32;
    while sc <= 4u32 {
        let ea: i32 = check_mutation_sequences(sc, PDT_CAP_EXACT, 120i64, &mut seed);
        if ea != 0i32 {
            return ea;
        }
        let eb: i32 = check_mutation_sequences(sc, PDT_CAP_KEEP, 120i64, &mut seed);
        if eb != 0i32 {
            return eb;
        }
        sc = sc + 1u32;
    }

    // ── P4: the variable-length dimension ─────────────────────────────────
    let p4a: i32 = check_vle_geometry();
    if p4a != 0i32 {
        return p4a;
    }
    let mut vc: u32 = 1u32;
    while vc <= 4u32 {
        let mut vs: u32 = 0u32;
        while vs <= 2u32 {
            let vsizes: [u64; 4] = [1u64, 2u64, 5u64, 9u64];
            let mut vi: i64 = 0i64;
            while vi < 4i64 {
                let p4b: i32 =
                    check_vle_mut_ops(vc, vs, vsizes[vi], PDT_CAP_EXACT, &mut seed);
                if p4b != 0i32 {
                    return p4b;
                }
                let p4c: i32 =
                    check_vle_mut_ops(vc, vs, vsizes[vi], PDT_CAP_KEEP, &mut seed);
                if p4c != 0i32 {
                    return p4c;
                }
                vi = vi + 1i64;
            }
            let p4d: i32 = check_vle_roundtrip(vc, vs, 5u64, &mut seed);
            if p4d != 0i32 {
                return p4d;
            }
            let p4e: i32 = check_vle_policy(vc, vs, &mut seed);
            if p4e != 0i32 {
                return p4e;
            }
            let p4f: i32 = check_vle_corners(vc, vs, &mut seed);
            if p4f != 0i32 {
                return p4f;
            }
            let p4g: i32 = check_vle_sequences(vc, vs, PDT_CAP_EXACT, 60i64, &mut seed);
            if p4g != 0i32 {
                return p4g;
            }
            let p4h: i32 = check_vle_sequences(vc, vs, PDT_CAP_KEEP, 60i64, &mut seed);
            if p4h != 0i32 {
                return p4h;
            }
            vs = vs + 1u32;
        }
        vc = vc + 1u32;
    }
    let p4i: i32 = check_vle_descr_laws();
    if p4i != 0i32 {
        return p4i;
    }
    let p4j: i32 = check_vle_defect28();
    if p4j != 0i32 {
        return p4j;
    }

    let rc4: i32 = check_fixtures();
    if rc4 != 0i32 {
        return rc4;
    }
    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap (256 & 0xFF == 0) and report
// SUCCESS. The status is a fixed non-zero byte; the code carries the detail.
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL pdtbuf_core: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
