// pdtbuf_core — PdtBuf ladder rung P0 gate: the runtime core of the Logos
// equivalent of C++ PackedDataTypeBuffer (logos.mem.pkd.pdtbuf).
//
// ── ORACLE STRATEGY ─────────────────────────────────────────────────────────
// PRIMARY oracle = an INDEPENDENT materialized model (`Model`: a plain
// column-major Vec of u64) whose operations are written from the DEFINITION
// of each query, obviously correct by inspection, plus algebraic laws that
// pin the conventions the model alone cannot (not-found, monotonicity,
// range additivity, lower/upper-bound bracketing, exact-prepare pricing).
// The C++ HEAD fixtures (tests/pdtbuf_fixtures.hex, generated by
// oracle/pdtbuf_dump.cpp) are a SECONDARY cross-check whose job is to make
// divergence visible — the C++ family is bug-dense (23 catalogued; the
// FQTree half died upstream untested), so agreement with it is evidence,
// never the definition of correct.
//
// One divergence is asserted as a divergence rather than conformed to: for
// MAX-ordered buffers the C++ sum(column,row) routes to sum_gen
// (packed_datatype_buffer_so.hpp:1577) and returns a SUFFIX sum, which makes
// its own sum(column,start,end) identity (:889) the negation of the true
// range sum. Section 90 pins our prefix semantics against that behaviour
// exactly: cpp_gen(c,k) == sum_all(c) - sum_prefix(c,k).
//
// ── SHAPE COVERAGE ──────────────────────────────────────────────────────────
// Every sweep runs columns in {1,2,3,4}. Section 60 is the explicit
// >=3-column CANARY: it checks the slot formula's column stride directly, so
// the N-axis is red-testable from this rung's first green (an unrolled
// two-column implementation cannot pass it). Both orderings, empty /
// 1-element / IndexSpan-boundary sizes.
//
// Error-code decades:
//   10..19  format, descriptor round-trip, sizing arithmetic
//   20..29  SUM ordering vs the model: access / sum / find
//   30..39  MAX ordering vs the model: access / find (lower+upper bound)
//   40..49  from-index search laws (SUM)
//   50..59  edges: empty, single row, IndexSpan boundary
//   60..69  the >=3-column slot-formula canary + block_of distinctness
//   70..79  structural check() + the exact-prepare pricing law
//   80..89  C++ HEAD fixture cross-check
//   90..99  the C++ sum_gen divergence, asserted as a divergence
//  100..109 harness failures (fixture unreadable, corpus too small)
//  110..119 P1: index geometry, reserve/reindex lockstep, empty-index safety
//  120..129 P1: three-way indexed <-> unindexed scan <-> model, incl. depth
//  130..139 P1: C++ HEAD recursive index-cell parity (marker-2 fixtures)
package test;

use logos.mem.pkd.pdtbuf;
use logos.mem.pkd;
use logos.lang.arith;
use logos.lang.mem;
use logos.lang.result;
use logos.lang.str;
use logos.mem.collections.vec;
use logos.mem.string;
use logos.std.io.fs;

// ── fixture tokenizer (the ssrle_codec.logos discipline) ────────────────────

fn is_ws(b: u8) -> bool {
    return b == 32u8 || b == 10u8 || b == 13u8 || b == 9u8;
}

fn hex_val(b: u8) -> u64 {
    if b >= 48u8 && b <= 57u8 {
        return (b - 48u8) as u64;
    }
    return ((b - 97u8) as u64) + 10u64;
}

fn next_tok(s: str, pos: &mut i64) -> u64 {
    let n: i64 = s.len();
    let mut i: i64 = *pos;
    while i < n && is_ws(s[i]) {
        i = i + 1i64;
    }
    let mut v: u64 = 0u64;
    while i < n && !is_ws(s[i]) {
        v = v * 16u64 + hex_val(s[i]);
        i = i + 1i64;
    }
    *pos = i;
    return v;
}

// ── the independent model ───────────────────────────────────────────────────
//
// A plain column-major table. Nothing here knows about slots, allocators or
// the C++; every operation is the textbook definition of the query.

struct Model {
    cols: u32,
    rows: u64,
    data: Vec<u64>,   // data[c * rows + r]
}

fn model_new(cols: u32, rows: u64) -> Model {
    let mut d: Vec<u64> = vec_new::<u64>();
    let total: i64 = (cols as i64) * (rows as i64);
    let mut i: i64 = 0i64;
    while i < total {
        d.push(0u64);
        i = i + 1i64;
    }
    return Model { cols: cols, rows: rows, data: d };
}

fn model_idx(m: &Model, c: u32, r: u64) -> i64 {
    return (c as i64) * (m.rows as i64) + (r as i64);
}

fn model_get(m: &Model, c: u32, r: u64) -> u64 {
    return m.data.get(model_idx(m, c, r));
}

fn model_set(m: &mut Model, c: u32, r: u64, v: u64) {
    let i: i64 = model_idx(m, c, r);
    m.data.set(i, v);
}

/// Exclusive prefix sum over [0, k) — the definition, nothing else.
fn model_prefix(m: &Model, c: u32, k: u64) -> u64 {
    let mut acc: u64 = 0u64;
    let mut i: u64 = 0u64;
    while i < k {
        acc = acc + model_get(m, c, i);
        i = i + 1u64;
    }
    return acc;
}

fn model_range(m: &Model, c: u32, s: u64, e: u64) -> u64 {
    let mut acc: u64 = 0u64;
    let mut i: u64 = s;
    while i < e {
        acc = acc + model_get(m, c, i);
        i = i + 1u64;
    }
    return acc;
}

/// SUM descent: the first row whose INCLUSIVE prefix reaches `val`
/// (`strict` = must exceed). Not found -> (rows, total).
fn model_find_sum(m: &Model, c: u32, val: u64, strict: bool, start: u64) -> PdtFind {
    let mut prefix: u64 = 0u64;
    let mut i: u64 = start;
    while i < m.rows {
        let incl: u64 = prefix + model_get(m, c, i);
        let hit: bool = if strict { incl > val } else { incl >= val };
        if hit {
            return PdtFind { idx: i, prefix: prefix };
        }
        prefix = incl;
        i = i + 1u64;
    }
    return PdtFind { idx: m.rows, prefix: prefix };
}

/// MAX descent over a sorted column: linear lower/upper bound. Deliberately
/// NOT a bisection — the model must not share an algorithm with the code it
/// judges (a shared off-by-one would cancel out).
fn model_find_max(m: &Model, c: u32, val: u64, strict: bool) -> u64 {
    let mut i: u64 = 0u64;
    while i < m.rows {
        let v: u64 = model_get(m, c, i);
        let hit: bool = if strict { v > val } else { v >= val };
        if hit {
            return i;
        }
        i = i + 1u64;
    }
    return m.rows;
}

// ── corpus generation ───────────────────────────────────────────────────────

fn lcg_next(s: &mut u64) -> u64 {
    *s = wrapping_add(wrapping_mul(*s, 6364136223846793005u64), 1442695040888963407u64);
    return *s >> 33u64;
}

fn model_sort_column(m: &mut Model, c: u32) {
    // Insertion sort — small corpora, and simple enough to be obviously right.
    let mut i: u64 = 1u64;
    while i < m.rows {
        let v: u64 = model_get(m, c, i);
        let mut j: u64 = i;
        while j > 0u64 && model_get(m, c, j - 1u64) > v {
            let prev: u64 = model_get(m, c, j - 1u64);
            model_set(m, c, j, prev);
            j = j - 1u64;
        }
        model_set(m, c, j, v);
        i = i + 1u64;
    }
}

fn model_random(cols: u32, rows: u64, sorted: bool, seed: &mut u64) -> Model {
    let mut m: Model = model_new(cols, rows);
    let mut c: u32 = 0u32;
    while c < cols {
        let mut r: u64 = 0u64;
        while r < rows {
            model_set(&mut m, c, r, lcg_next(seed) % 23u64);
            r = r + 1u64;
        }
        if sorted {
            model_sort_column(&mut m, c);
        }
        c = c + 1u32;
    }
    return m;
}

// ── buffer construction ─────────────────────────────────────────────────────

fn descr_for(cols: u32, ordering: u32) -> PdtDescr {
    return pdt_descr_fse(cols, 8u32, ordering, false);
}

fn fill_from_model(b: &mut PdtBuf, m: &Model) {
    let mut r: u64 = 0u64;
    while r < m.rows {
        let mut c: u32 = 0u32;
        while c < m.cols {
            b.set(c, r, model_get(m, c, r));
            c = c + 1u32;
        }
        r = r + 1u64;
    }
}

// ── 10.. format / descriptor round-trip / sizing arithmetic ────────────────

fn check_sizing() -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 6u32 {
        let d: PdtDescr = descr_for(cols, PDT_ORD_SUM);
        // Slot geometry follows the descriptor, not a hardcoded count.
        if d.dim_blocks_total() != 1u32 {
            return 10i32;
        }
        if d.slots() != 2u32 + cols {
            return 11i32;
        }
        if d.dim_block_offset(0u32) != 0u32 {
            return 12i32;
        }
        // Sizing is monotone in capacity and exact on the 8-byte granule.
        let e0: u32 = pdtbuf_compute_block_size(&d, 0u64);
        if e0 != pdtbuf_empty_size(&d) {
            return 13i32;
        }
        let mut cap: u64 = 1u64;
        while cap <= 64u64 {
            let s1: u32 = pdtbuf_compute_block_size(&d, cap);
            let s0: u32 = pdtbuf_compute_block_size(&d, cap - 1u64);
            if s1 < s0 {
                return 14i32;
            }
            if s1 != pdtbuf_empty_size(&d) + (cap as u32) * 8u32 * cols {
                return 15i32;
            }
            cap = cap + 1u64;
        }
        // P0 narrows the index away, but the hook must be inert, not absent:
        // an indexed SUM descriptor prices strictly more above the span.
        let di: PdtDescr = pdt_descr_fse(cols, 8u32, PDT_ORD_SUM, true);
        if !di.has_index() {
            return 16i32;
        }
        if pdtbuf_index_block_size(&di, 32u64) != 0u32 {
            return 17i32;
        }
        if pdtbuf_index_block_size(&di, 33u64) == 0u32 {
            return 18i32;
        }
        // ... and the recursion is the SAME pricing function one level down
        // (2 spans of 32 rows) — the shape P1 inherits unchanged.
        if pdtbuf_index_block_size(&di, 33u64) != pdtbuf_compute_block_size(&di, 2u64) {
            return 19i32;
        }
        // A MAX descriptor never carries an index, whatever the flag says
        // (C++ HasIndex :57 — ordering is a law, not a configuration).
        let dm: PdtDescr = pdt_descr_fse(cols, 8u32, PDT_ORD_MAX, true);
        if dm.has_index() {
            return 10i32;
        }
        if pdtbuf_index_block_size(&dm, 1000u64) != 0u32 {
            return 10i32;
        }
        // VLE dimensions are P4, but the WIDTH axis must already be carried.
        let mut dv: PdtDescr = pdt_descr_new(cols, PDT_ORD_SUM, false);
        dv.dims.push(pdt_dim_fse(8u32));
        dv.dims.push(pdt_dim_vle(1u32));
        if dv.dim_blocks_total() != 3u32 {
            return 12i32;
        }
        if dv.slots() != 2u32 + 3u32 * cols {
            return 12i32;
        }
        if dv.dim_block_offset(1u32) != 1u32 {
            return 12i32;
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 60.. the >=3-column canary + block_of distinctness ─────────────────────

fn check_column_canary() -> i32 {
    // Runs for every column count in the sweep, but exists for cols >= 3:
    // a two-column-shaped implementation (or a per-column special case)
    // cannot satisfy the stride identity below.
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let d: PdtDescr = descr_for(cols, PDT_ORD_SUM);
        let bs: u32 = pdtbuf_compute_block_size(&d, 8u64);
        unsafe {
            let mem: *mut u8 = alloc(bs as i64);
            let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, 8u64) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    return 60i32;
                }
            };
            let mut c: u32 = 0u32;
            while c < cols {
                // THE slot formula, checked directly:
                //   block(c) = LAST_HEADER_BLOCK + dim_blocks_total*c + 0
                if b.block_of(c, 0u32, 0u32) != 2u32 + c {
                    dealloc(mem);
                    return 61i32;
                }
                c = c + 1u32;
            }
            // Distinctness: every (column, dim, sub) triple owns its own slot.
            let mut i: u32 = 0u32;
            while i < cols {
                let mut j: u32 = 0u32;
                while j < cols {
                    let same: bool = b.block_of(i, 0u32, 0u32) == b.block_of(j, 0u32, 0u32);
                    if same != (i == j) {
                        dealloc(mem);
                        return 62i32;
                    }
                    j = j + 1u32;
                }
                i = i + 1u32;
            }
            // Columns are INDEPENDENT storage: writing column k must not be
            // observable in any other column. This is the assertion that a
            // broken column stride cannot survive.
            let mut k: u32 = 0u32;
            while k < cols {
                let mut r: u64 = 0u64;
                while r < 8u64 {
                    b.set(k, r, 1000u64 + (k as u64) * 100u64 + r);
                    r = r + 1u64;
                }
                k = k + 1u32;
            }
            let mut k2: u32 = 0u32;
            while k2 < cols {
                let mut r2: u64 = 0u64;
                while r2 < 8u64 {
                    if b.get(k2, r2) != 1000u64 + (k2 as u64) * 100u64 + r2 {
                        dealloc(mem);
                        return 63i32;
                    }
                    r2 = r2 + 1u64;
                }
                k2 = k2 + 1u32;
            }
            if b.check() != 0i32 {
                dealloc(mem);
                return 64i32;
            }
            dealloc(mem);
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 20../30../40../70.. model equivalence for one (cols, rows, ordering) ────

fn check_case(cols: u32, rows: u64, ordering: u32, seed: &mut u64) -> i32 {
    let sorted: bool = ordering == PDT_ORD_MAX;
    let m: Model = model_random(cols, rows, sorted, seed);
    let d: PdtDescr = descr_for(cols, ordering);
    let bs: u32 = pdtbuf_compute_block_size(&d, rows);
    unsafe {
        let mem: *mut u8 = alloc(bs as i64);
        let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, rows) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 20i32;
            }
        };
        fill_from_model(&mut b, &m);
        let rc: i32 = check_case_body(&b, &m, ordering);
        dealloc(mem);
        return rc;
    }
}

fn check_case_body(b: &PdtBuf, m: &Model, ordering: u32) -> i32 {
    let cols: u32 = m.cols;
    let rows: u64 = m.rows;

    // 70.. structural + the exact-prepare pricing law.
    if b.check() != 0i32 {
        return 70i32;
    }
    let d: PdtDescr = b.descr();
    if b.consumed_bytes() != pdtbuf_compute_block_size(&d, rows) {
        return 71i32;
    }
    if b.size() != rows {
        return 72i32;
    }
    if b.columns() != cols {
        return 73i32;
    }
    if b.ordering() != ordering {
        return 74i32;
    }
    if b.dim_count() != 1u32 || b.dim_blocks_total() != 1u32 {
        return 75i32;
    }
    if b.has_index() {
        return 76i32;   // P0 configures no index; the flag must stay false
    }

    // 21.. access: every cell, every column.
    let mut c: u32 = 0u32;
    while c < cols {
        let mut r: u64 = 0u64;
        while r < rows {
            if b.get(c, r) != model_get(m, c, r) {
                return 21i32;
            }
            r = r + 1u64;
        }
        // span() must be the same view as get().
        let vals: &[u64] = b.values(c);
        let mut r2: u64 = 0u64;
        while r2 < rows {
            if vals[r2 as i64] != model_get(m, c, r2) {
                return 22i32;
            }
            r2 = r2 + 1u64;
        }
        c = c + 1u32;
    }

    // 23.. sums (prefix semantics for BOTH orderings — see the module's
    // sum_gen divergence note). Exhaustive over every (start,end) pair.
    let mut c3: u32 = 0u32;
    while c3 < cols {
        let mut s: u64 = 0u64;
        while s <= rows {
            if b.sum_prefix(c3, s) != model_prefix(m, c3, s) {
                return 23i32;
            }
            let mut e: u64 = s;
            while e <= rows {
                if b.sum(c3, s, e) != model_range(m, c3, s, e) {
                    return 24i32;
                }
                e = e + 1u64;
            }
            s = s + 1u64;
        }
        if b.sum_all(c3) != model_prefix(m, c3, rows) {
            return 25i32;
        }
        // Range additivity: sum[s,e) + sum[e,f) == sum[s,f).
        let mut a1: u64 = 0u64;
        while a1 <= rows {
            let mut a2: u64 = a1;
            while a2 <= rows {
                let mut a3: u64 = a2;
                while a3 <= rows {
                    if b.sum(c3, a1, a2) + b.sum(c3, a2, a3) != b.sum(c3, a1, a3) {
                        return 26i32;
                    }
                    a3 = a3 + 1u64;
                }
                a2 = a2 + 1u64;
            }
            a1 = a1 + 1u64;
        }
        c3 = c3 + 1u32;
    }

    // 27../31.. the search family vs the model, over a probe set that covers
    // every attainable answer plus both edges.
    let mut c4: u32 = 0u32;
    while c4 < cols {
        let total: u64 = b.sum_all(c4);
        let mut probes: Vec<u64> = vec_new::<u64>();
        probes.push(0u64);
        probes.push(1u64);
        if ordering == PDT_ORD_SUM {
            let mut k: u64 = 0u64;
            while k <= rows {
                let p: u64 = model_prefix(m, c4, k);
                probes.push(p);
                if p > 0u64 {
                    probes.push(p - 1u64);
                }
                probes.push(p + 1u64);
                k = k + 1u64;
            }
        } else {
            let mut k2: u64 = 0u64;
            while k2 < rows {
                let v: u64 = model_get(m, c4, k2);
                probes.push(v);
                if v > 0u64 {
                    probes.push(v - 1u64);
                }
                probes.push(v + 1u64);
                k2 = k2 + 1u64;
            }
            probes.push(100u64);
        }
        let np: i64 = probes.length();
        let mut pi: i64 = 0i64;
        while pi < np {
            let v: u64 = probes.get(pi);
            let ge: PdtFind = b.find_ge(c4, v);
            let gt: PdtFind = b.find_gt(c4, v);
            if ordering == PDT_ORD_SUM {
                let mge: PdtFind = model_find_sum(m, c4, v, false, 0u64);
                let mgt: PdtFind = model_find_sum(m, c4, v, true, 0u64);
                if ge.idx != mge.idx || ge.prefix != mge.prefix {
                    return 27i32;
                }
                if gt.idx != mgt.idx || gt.prefix != mgt.prefix {
                    return 28i32;
                }
                // LAW: the reported prefix IS the prefix sum at the hit row.
                if ge.prefix != b.sum_prefix(c4, ge.idx) {
                    return 29i32;
                }
                if gt.prefix != b.sum_prefix(c4, gt.idx) {
                    return 29i32;
                }
                // LAW: bracketing. For a hit, the cumulative sum crosses `v`
                // exactly at the returned row.
                if ge.idx < rows {
                    if !(ge.prefix < v || v == 0u64) {
                        return 40i32;
                    }
                    if v > ge.prefix + b.get(c4, ge.idx) {
                        return 41i32;
                    }
                }
                if gt.idx < rows {
                    if v >= gt.prefix + b.get(c4, gt.idx) {
                        return 42i32;
                    }
                }
                // LAW: gt never precedes ge, and ge never precedes it by more
                // than the zero-valued rows between them.
                if gt.idx < ge.idx {
                    return 43i32;
                }
                // LAW: from-index search over the whole range is the plain one.
                let f0: PdtFind = b.find_ge_from(c4, 0u64, v);
                if f0.idx != ge.idx || f0.prefix != ge.prefix {
                    return 44i32;
                }
                let g0: PdtFind = b.find_gt_from(c4, 0u64, v);
                if g0.idx != gt.idx || g0.prefix != gt.prefix {
                    return 45i32;
                }
                // ... and from an arbitrary start it equals the model's
                // residual scan, with the answer never preceding the start.
                let mut st: u64 = 0u64;
                while st <= rows {
                    let fr: PdtFind = b.find_ge_from(c4, st, v);
                    let mr: PdtFind = model_find_sum(m, c4, v, false, st);
                    if fr.idx != mr.idx || fr.prefix != mr.prefix {
                        return 46i32;
                    }
                    if fr.idx < st {
                        return 47i32;
                    }
                    st = st + 1u64;
                }
            } else {
                let mge2: u64 = model_find_max(m, c4, v, false);
                let mgt2: u64 = model_find_max(m, c4, v, true);
                if ge.idx != mge2 {
                    return 31i32;
                }
                if gt.idx != mgt2 {
                    return 32i32;
                }
                if ge.prefix != 0u64 || gt.prefix != 0u64 {
                    return 33i32;
                }
                // LAW (lower_bound): everything before the hit is strictly
                // below `v`, the hit itself is not.
                let mut q: u64 = 0u64;
                while q < ge.idx {
                    if b.get(c4, q) >= v {
                        return 34i32;
                    }
                    q = q + 1u64;
                }
                if ge.idx < rows && b.get(c4, ge.idx) < v {
                    return 35i32;
                }
                // LAW (upper_bound) + the multiplicity identity:
                // gt.idx - ge.idx == the number of cells equal to `v`.
                if gt.idx < ge.idx {
                    return 36i32;
                }
                let mut eq: u64 = 0u64;
                let mut q2: u64 = 0u64;
                while q2 < rows {
                    if b.get(c4, q2) == v {
                        eq = eq + 1u64;
                    }
                    q2 = q2 + 1u64;
                }
                if gt.idx - ge.idx != eq {
                    return 37i32;
                }
            }
            pi = pi + 1i64;
        }
        // 38.. the not-found convention, pinned independently of the C++.
        let nf: PdtFind = b.find_gt(c4, total + 1u64);
        if nf.idx != rows {
            return 38i32;
        }
        if ordering == PDT_ORD_SUM && nf.prefix != total {
            return 39i32;
        }
        // Monotonicity of the answer in the query value.
        let mut mv: u64 = 0u64;
        let mut prev_ge: u64 = 0u64;
        while mv <= total + 2u64 {
            let r: PdtFind = b.find_ge(c4, mv);
            if r.idx < prev_ge {
                return 48i32;
            }
            prev_ge = r.idx;
            mv = mv + 1u64;
        }
        c4 = c4 + 1u32;
    }
    return 0i32;
}

// ── 50.. edges ─────────────────────────────────────────────────────────────

fn check_edges() -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let d: PdtDescr = descr_for(cols, PDT_ORD_SUM);
        // Empty buffer: no unsigned underflow anywhere (the C++ family's
        // signature failure mode — max_element_idx = size()-1 on empty, and
        // the walk_fw `start >= size-64` guard class).
        let bs0: u32 = pdtbuf_compute_block_size(&d, 0u64);
        unsafe {
            let mem: *mut u8 = alloc(bs0 as i64);
            let b: PdtBuf = match pdtbuf_create(mem, bs0, &d, 0u64) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    return 50i32;
                }
            };
            if b.size() != 0u64 {
                dealloc(mem);
                return 51i32;
            }
            let mut c: u32 = 0u32;
            while c < cols {
                if b.sum_all(c) != 0u64 {
                    dealloc(mem);
                    return 52i32;
                }
                if b.sum_prefix(c, 0u64) != 0u64 {
                    dealloc(mem);
                    return 52i32;
                }
                if b.sum(c, 0u64, 0u64) != 0u64 {
                    dealloc(mem);
                    return 52i32;
                }
                let ge: PdtFind = b.find_ge(c, 0u64);
                if ge.idx != 0u64 || ge.prefix != 0u64 {
                    dealloc(mem);
                    return 53i32;
                }
                let gt: PdtFind = b.find_gt(c, 7u64);
                if gt.idx != 0u64 || gt.prefix != 0u64 {
                    dealloc(mem);
                    return 54i32;
                }
                let fr: PdtFind = b.find_ge_from(c, 0u64, 5u64);
                if fr.idx != 0u64 {
                    dealloc(mem);
                    return 55i32;
                }
                c = c + 1u32;
            }
            if b.check() != 0i32 {
                dealloc(mem);
                return 56i32;
            }
            dealloc(mem);
        }
        // reserve() grows and shrinks exactly, and the pricing law holds at
        // every capacity on the way — the P3 exact-prepare basis.
        let caps: [u64; 7] = [0u64, 1u64, 31u64, 32u64, 33u64, 8u64, 0u64];
        let bsmax: u32 = pdtbuf_compute_block_size(&d, 33u64);
        unsafe {
            let mem2: *mut u8 = alloc(bsmax as i64);
            let mut b2: PdtBuf = match pdtbuf_format(mem2, bsmax, &d) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem2);
                    return 57i32;
                }
            };
            let mut i: i64 = 0i64;
            while i < 7i64 {
                let cap: u64 = caps[i];
                match b2.reserve(cap) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        dealloc(mem2);
                        return 58i32;
                    }
                }
                if b2.capacity() != cap {
                    dealloc(mem2);
                    return 58i32;
                }
                if b2.consumed_bytes() != pdtbuf_compute_block_size(&d, cap) {
                    dealloc(mem2);
                    return 59i32;
                }
                if b2.check() != 0i32 {
                    dealloc(mem2);
                    return 59i32;
                }
                i = i + 1i64;
            }
            dealloc(mem2);
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ═══ P1: the recursive SUM span index ═══════════════════════════════════════
//
// ORACLE STRATEGY, unchanged in kind: correctness is decided by the model and
// by a THIRD leg the index cannot influence — a twin buffer built with
// indexed=false over identical data, whose every query is a plain scan. Any
// index bug shows up as indexed != scan even before the model is consulted,
// and the model catches a bug that somehow corrupted both.
//
// The index's DEFINING property is checked directly rather than inferred:
// cell (c,k) must be the PARTIAL sum of span k, and section 111 asserts that
// a PREFIX-sum index would be a different (wrong) structure by exhibiting the
// difference at k >= 1.

/// The indexed twin of descr_for: the same shape with the index switched on.
fn descr_indexed(cols: u32) -> PdtDescr {
    return pdt_descr_fse(cols, 8u32, PDT_ORD_SUM, true);
}

/// Index levels the geometry MUST produce for `rows`: one per division by the
/// span until a level fits in a single span. Written from the definition, not
/// from the implementation's recursion.
fn model_index_levels(rows: u64) -> u32 {
    let mut n: u64 = rows;
    let mut levels: u32 = 0u32;
    while n > 32u64 {
        n = (n + 31u64) / 32u64;
        levels = levels + 1u32;
    }
    return levels;
}

/// Per-span partial sum of the MODEL over span `k` — the definition of an
/// index cell, computed with no reference to the buffer.
fn model_span_sum(m: &Model, c: u32, k: u64) -> u64 {
    let base: u64 = k * 32u64;
    let mut limit: u64 = base + 32u64;
    if limit > m.rows {
        limit = m.rows;
    }
    return model_range(m, c, base, limit);
}

// ── 110.. geometry, lockstep, and empty-index safety ───────────────────────

fn check_index_geometry() -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let d: PdtDescr = descr_indexed(cols);
        // Capacities straddling the threshold and both deeper boundaries.
        let caps: [u64; 10] = [0u64, 1u64, 31u64, 32u64, 33u64, 64u64, 1024u64,
                               1025u64, 100u64, 0u64];
        let bsmax: u32 = pdtbuf_compute_block_size(&d, 1025u64);
        unsafe {
            let mem: *mut u8 = alloc(bsmax as i64);
            let mut b: PdtBuf = match pdtbuf_format(mem, bsmax, &d) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    return 110i32;
                }
            };
            // A freshly formatted buffer is below the threshold: no index.
            if b.has_index() {
                dealloc(mem);
                return 111i32;
            }
            let mut i: i64 = 0i64;
            while i < 10i64 {
                let cap: u64 = caps[i];
                match b.reserve(cap) {
                    Result::Ok(_) => {}
                    Result::Err(_) => {
                        dealloc(mem);
                        return 112i32;
                    }
                }
                // LOCKSTEP: presence is decided by CAPACITY, and the slot
                // holds exactly what the capacity prices. A slot sized from
                // `size` while priced from `capacity` fails right here.
                if b.has_index() != (cap > 32u64) {
                    dealloc(mem);
                    return 113i32;
                }
                if b.index_levels() != model_index_levels(cap) {
                    dealloc(mem);
                    return 114i32;
                }
                if b.consumed_bytes() != pdtbuf_compute_block_size(&d, cap) {
                    dealloc(mem);
                    return 115i32;
                }
                if b.check() != 0i32 {
                    dealloc(mem);
                    return 116i32;
                }
                if b.has_index() {
                    // reserve() leaves the index EMPTY, never stale.
                    if b.index().size() != 0u64 {
                        dealloc(mem);
                        return 117i32;
                    }
                    // ... and the index's own capacity is the span count of
                    // OUR capacity, one level down, recursively.
                    if b.index().capacity() != (cap + 31u64) / 32u64 {
                        dealloc(mem);
                        return 118i32;
                    }
                }
                i = i + 1i64;
            }
            dealloc(mem);
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

/// The DERIVED-robustness assertion (the C++ divergence at
/// packed_datatype_buffer_so.hpp:1501-1514, upstream bug candidate #26): a
/// buffer whose index is materialized but NOT yet filled must answer every
/// query CORRECTLY — by falling back to the scan it would have done anyway —
/// not report "not found" over rows it never examined. The C++ short-circuits
/// on an index miss and would answer (size, 0) here for every query.
fn check_empty_index_safety(seed: &mut u64) -> i32 {
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let rows: u64 = 100u64;
        let m: Model = model_random(cols, rows, false, seed);
        let d: PdtDescr = descr_indexed(cols);
        let bs: u32 = pdtbuf_compute_block_size(&d, rows);
        unsafe {
            let mem: *mut u8 = alloc(bs as i64);
            let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, rows) {
                Result::Ok(q) => { q }
                Result::Err(_) => {
                    dealloc(mem);
                    return 119i32;
                }
            };
            fill_from_model(&mut b, &m);
            // NO reindex() — the index slot exists, its size is 0.
            if !b.has_index() {
                dealloc(mem);
                return 119i32;
            }
            if b.index().size() != 0u64 {
                dealloc(mem);
                return 119i32;
            }
            let mut c: u32 = 0u32;
            while c < cols {
                let total: u64 = model_prefix(&m, c, rows);
                let mut k: u64 = 0u64;
                while k <= rows {
                    if b.sum_prefix(c, k) != model_prefix(&m, c, k) {
                        dealloc(mem);
                        return 119i32;
                    }
                    k = k + 1u64;
                }
                let mut v: u64 = 0u64;
                while v <= total + 2u64 {
                    let ge: PdtFind = b.find_ge(c, v);
                    let mge: PdtFind = model_find_sum(&m, c, v, false, 0u64);
                    if ge.idx != mge.idx || ge.prefix != mge.prefix {
                        dealloc(mem);
                        return 119i32;
                    }
                    v = v + 37u64;
                }
                c = c + 1u32;
            }
            dealloc(mem);
        }
        cols = cols + 1u32;
    }
    return 0i32;
}

// ── 120.. three-way: indexed <-> unindexed scan <-> model ──────────────────

/// Builds the indexed buffer AND its unindexed twin over the same model, then
/// compares every query three ways. `dense` runs the exhaustive sweeps (small
/// sizes); otherwise the probes are sampled so deep corpora stay linear.
fn check_three_way(cols: u32, rows: u64, dense: bool, seed: &mut u64) -> i32 {
    let m: Model = model_random(cols, rows, false, seed);

    let di: PdtDescr = descr_indexed(cols);
    let ds: PdtDescr = descr_for(cols, PDT_ORD_SUM);
    let bsi: u32 = pdtbuf_compute_block_size(&di, rows);
    let bss: u32 = pdtbuf_compute_block_size(&ds, rows);

    unsafe {
        let memi: *mut u8 = alloc(bsi as i64);
        let mems: *mut u8 = alloc(bss as i64);
        let mut bi: PdtBuf = match pdtbuf_create(memi, bsi, &di, rows) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(memi);
                dealloc(mems);
                return 120i32;
            }
        };
        let mut bs2: PdtBuf = match pdtbuf_create(mems, bss, &ds, rows) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(memi);
                dealloc(mems);
                return 120i32;
            }
        };
        fill_from_model(&mut bi, &m);
        fill_from_model(&mut bs2, &m);
        bi.reindex();
        let rc: i32 = check_three_way_body(&bi, &bs2, &m, dense);
        dealloc(memi);
        dealloc(mems);
        return rc;
    }
}

fn check_three_way_body(bi: &PdtBuf, bs2: &PdtBuf, m: &Model, dense: bool) -> i32 {
    let cols: u32 = m.cols;
    let rows: u64 = m.rows;

    // The unindexed twin must genuinely have no index — otherwise the third
    // leg is not independent and the whole comparison is vacuous.
    if bs2.has_index() {
        return 121i32;
    }
    if bi.has_index() != (rows > 32u64) {
        return 121i32;
    }
    // DEPTH: the tree really is multi-level at deep sizes.
    if bi.index_levels() != model_index_levels(rows) {
        return 122i32;
    }
    // check() verifies index geometry AND recomputes every cell at every
    // level from the index-free scan.
    if bi.check() != 0i32 {
        return 123i32;
    }

    // THE DEFINING PROPERTY, asserted directly against the model: level-1
    // cell (c,k) is the PARTIAL sum of span k. A prefix-sum index would agree
    // at k = 0 and disagree at every k >= 1 with a non-empty preceding span.
    if bi.has_index() {
        let ix: PdtBuf = bi.index();
        let spans: u64 = (rows + 31u64) / 32u64;
        if ix.size() != spans {
            return 124i32;
        }
        let mut c: u32 = 0u32;
        while c < cols {
            let mut k: u64 = 0u64;
            while k < spans {
                if ix.get(c, k) != model_span_sum(m, c, k) {
                    return 125i32;
                }
                k = k + 1u64;
            }
            c = c + 1u32;
        }
    }

    // Prefix sums, three ways.
    let mut c2: u32 = 0u32;
    while c2 < cols {
        let step: u64 = if dense { 1u64 } else { rows / 61u64 + 1u64 };
        let mut k: u64 = 0u64;
        while k <= rows {
            let vi: u64 = bi.sum_prefix(c2, k);
            if vi != bs2.sum_prefix(c2, k) {
                return 126i32;
            }
            if vi != model_prefix(m, c2, k) {
                return 126i32;
            }
            k = k + step;
        }
        // The boundary rows the stride may have stepped over: every span
        // edge and its neighbours, where the descent hands off to the scan.
        let mut e: u64 = 0u64;
        while e <= rows {
            let mut o: u64 = 0u64;
            while o < 3u64 {
                let p: u64 = if e + o > 0u64 { e + o - 1u64 } else { 0u64 };
                if p <= rows {
                    let vb: u64 = bi.sum_prefix(c2, p);
                    if vb != bs2.sum_prefix(c2, p) || vb != model_prefix(m, c2, p) {
                        return 127i32;
                    }
                }
                o = o + 1u64;
            }
            e = e + 32u64;
        }
        c2 = c2 + 1u32;
    }

    // Searches, three ways, over the probe set that covers every attainable
    // answer (dense) or a stride through the value range (deep).
    let mut c3: u32 = 0u32;
    while c3 < cols {
        let total: u64 = model_prefix(m, c3, rows);
        let mut probes: Vec<u64> = vec_new::<u64>();
        probes.push(0u64);
        probes.push(1u64);
        probes.push(total);
        probes.push(total + 1u64);
        if dense {
            let mut k2: u64 = 0u64;
            while k2 <= rows {
                let p: u64 = model_prefix(m, c3, k2);
                probes.push(p);
                if p > 0u64 {
                    probes.push(p - 1u64);
                }
                probes.push(p + 1u64);
                k2 = k2 + 1u64;
            }
        } else {
            // Every span boundary's prefix, plus its neighbours: exactly the
            // values at which the index descent picks a different span.
            let mut e2: u64 = 0u64;
            while e2 <= rows {
                let p: u64 = model_prefix(m, c3, e2);
                probes.push(p);
                if p > 0u64 {
                    probes.push(p - 1u64);
                }
                probes.push(p + 1u64);
                e2 = e2 + 32u64;
            }
        }
        let np: i64 = probes.length();
        let mut pi: i64 = 0i64;
        while pi < np {
            let v: u64 = probes.get(pi);
            let ge: PdtFind = bi.find_ge(c3, v);
            let gt: PdtFind = bi.find_gt(c3, v);
            let sge: PdtFind = bs2.find_ge(c3, v);
            let sgt: PdtFind = bs2.find_gt(c3, v);
            if ge.idx != sge.idx || ge.prefix != sge.prefix {
                return 128i32;
            }
            if gt.idx != sgt.idx || gt.prefix != sgt.prefix {
                return 128i32;
            }
            let mge: PdtFind = model_find_sum(m, c3, v, false, 0u64);
            let mgt: PdtFind = model_find_sum(m, c3, v, true, 0u64);
            if ge.idx != mge.idx || ge.prefix != mge.prefix {
                return 129i32;
            }
            if gt.idx != mgt.idx || gt.prefix != mgt.prefix {
                return 129i32;
            }
            // LAW carried over from P0: the reported prefix IS the prefix sum
            // at the hit row — now computed through the index on both sides.
            if ge.prefix != bi.sum_prefix(c3, ge.idx) {
                return 129i32;
            }
            pi = pi + 1i64;
        }
        c3 = c3 + 1u32;
    }
    return 0i32;
}

// ── 80.. / 90.. / 130.. the C++ HEAD cross-check ───────────────────────────

fn check_fixture_case(s: str, pos: &mut i64) -> i32 {
    let ord_tok: u64 = next_tok(s, pos);
    let cols: u32 = next_tok(s, pos) as u32;
    let rows: u64 = next_tok(s, pos);
    let ordering: u32 = if ord_tok == 0u64 { PDT_ORD_SUM } else { PDT_ORD_MAX };

    let mut m: Model = model_new(cols, rows);
    let mut r: u64 = 0u64;
    while r < rows {
        let mut c: u32 = 0u32;
        while c < cols {
            model_set(&mut m, c, r, next_tok(s, pos));
            c = c + 1u32;
        }
        r = r + 1u64;
    }

    let d: PdtDescr = descr_for(cols, ordering);
    let bs: u32 = pdtbuf_compute_block_size(&d, rows);
    unsafe {
        let mem: *mut u8 = alloc(bs as i64);
        let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, rows) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 80i32;
            }
        };
        fill_from_model(&mut b, &m);
        let rc: i32 = check_fixture_body(&b, &m, ordering, s, pos);
        dealloc(mem);
        return rc;
    }
}

fn check_fixture_body(b: &PdtBuf, m: &Model, ordering: u32, s: str, pos: &mut i64) -> i32 {
    // The buffer must first agree with our OWN model — the C++ tokens are
    // only consulted afterwards, so a fixture can never be what defines
    // correctness here.
    let mut c: u32 = 0u32;
    while c < m.cols {
        let mut r: u64 = 0u64;
        while r < m.rows {
            if b.get(c, r) != model_get(m, c, r) {
                return 81i32;
            }
            r = r + 1u64;
        }
        c = c + 1u32;
    }

    let n_sum: u64 = next_tok(s, pos);
    let mut i: u64 = 0u64;
    while i < n_sum {
        let col: u32 = next_tok(s, pos) as u32;
        let start: u64 = next_tok(s, pos);
        let end: u64 = next_tok(s, pos);
        let want: u64 = next_tok(s, pos);
        if b.sum(col, start, end) != want {
            return 82i32;
        }
        i = i + 1u64;
    }

    let n_find: u64 = next_tok(s, pos);
    let mut j: u64 = 0u64;
    while j < n_find {
        let op: u64 = next_tok(s, pos);
        let col2: u32 = next_tok(s, pos) as u32;
        let val: u64 = next_tok(s, pos);
        let widx: u64 = next_tok(s, pos);
        let wpfx: u64 = next_tok(s, pos);
        let got: PdtFind = if op == 0u64 { b.find_ge(col2, val) } else { b.find_gt(col2, val) };
        if got.idx != widx {
            return 83i32;
        }
        if got.prefix != wpfx {
            return 84i32;
        }
        j = j + 1u64;
    }

    // 90.. the sum_gen DIVERGENCE, asserted as such: on MAX buffers the C++
    // sum(column,row) returns the SUFFIX [row, size). We return the prefix
    // [0, row) for every ordering — the only reading under which the C++'s
    // own sum(c,start,end) = sum(end) - sum(start) identity is the range sum.
    // If upstream ever fixes sum_gen, this assertion flips and tells us.
    let n_gen: u64 = next_tok(s, pos);
    let mut k: u64 = 0u64;
    while k < n_gen {
        let col3: u32 = next_tok(s, pos) as u32;
        let row: u64 = next_tok(s, pos);
        let cpp: u64 = next_tok(s, pos);
        if ordering != PDT_ORD_MAX {
            return 90i32;
        }
        if cpp != b.sum_all(col3) - b.sum_prefix(col3, row) {
            return 91i32;
        }
        k = k + 1u64;
    }
    return 0i32;
}

// ── 130.. the STRICT index gate: HEAD's recursive index cells, level by level
//
// A marker-2 case carries only (columns, rows, seed) plus HEAD's index cells:
// the corpus is regenerated here from the SAME LCG in the same column-major
// order, so the two sides are comparing structures built over byte-identical
// data. Wave-1 recon established that HEAD's recursive nested-buffer index is
// cell-for-cell the same 32-ary tree the deleted flat-layout FQTree carried,
// which is what makes this a meaningful equivalence rather than a tautology.
//
// This is EQUALITY, not evidence: an index cell has one right value (the
// partial sum of its span), section 12x already pinned that value against the
// independent model, and HEAD agrees. Where HEAD and the model disagree the
// model wins — no such disagreement was observed at this rung.
fn check_index_fixture_case(s: str, pos: &mut i64) -> i32 {
    let cols: u32 = next_tok(s, pos) as u32;
    let rows: u64 = next_tok(s, pos);
    let mut sd: u64 = next_tok(s, pos);
    let m: Model = model_random(cols, rows, false, &mut sd);

    let d: PdtDescr = descr_indexed(cols);
    let bs: u32 = pdtbuf_compute_block_size(&d, rows);
    unsafe {
        let mem: *mut u8 = alloc(bs as i64);
        let mut b: PdtBuf = match pdtbuf_create(mem, bs, &d, rows) {
            Result::Ok(q) => { q }
            Result::Err(_) => {
                dealloc(mem);
                return 130i32;
            }
        };
        fill_from_model(&mut b, &m);
        b.reindex();
        let rc: i32 = check_index_fixture_body(&b, cols, s, pos);
        dealloc(mem);
        return rc;
    }
}

fn check_index_fixture_body(b: &PdtBuf, cols: u32, s: str, pos: &mut i64) -> i32 {
    // Our own structure first: the fixture is consulted only afterwards, so
    // it can never be what defines correctness here.
    if b.check() != 0i32 {
        return 131i32;
    }
    let n_levels: u64 = next_tok(s, pos);
    if (b.index_levels() as u64) != n_levels {
        return 132i32;
    }
    let mut cur: PdtBuf = *b;
    let mut l: u64 = 0u64;
    while l < n_levels {
        if !cur.has_index() {
            return 133i32;
        }
        let ix: PdtBuf = cur.index();
        let level_rows: u64 = next_tok(s, pos);
        if ix.size() != level_rows {
            return 134i32;
        }
        let mut r: u64 = 0u64;
        while r < level_rows {
            let mut c: u32 = 0u32;
            while c < cols {
                if ix.get(c, r) != next_tok(s, pos) {
                    return 135i32;
                }
                c = c + 1u32;
            }
            r = r + 1u64;
        }
        cur = ix;
        l = l + 1u64;
    }
    // Level count agrees EXACTLY: the recursion stops where HEAD's stops.
    if cur.has_index() {
        return 136i32;
    }
    return 0i32;
}

fn check_fixtures() -> i32 {
    let content: String = match read_to_string("tests/pdtbuf_fixtures.hex") {
        Result::Ok(c) => { c }
        Result::Err(_) => { return 100i32; }
    };
    let s: str = content.as_str();
    let mut pos: i64 = 0i64;
    let mut cases: i64 = 0i64;
    let mut index_cases: i64 = 0i64;
    let mut going: bool = true;
    while going {
        let marker: u64 = next_tok(s, &mut pos);
        if marker == 0u64 {
            going = false;
        } else if marker == 1u64 {
            let rc: i32 = check_fixture_case(s, &mut pos);
            if rc != 0i32 {
                return rc;
            }
            cases = cases + 1i64;
        } else if marker == 2u64 {
            let rc2: i32 = check_index_fixture_case(s, &mut pos);
            if rc2 != 0i32 {
                return rc2;
            }
            index_cases = index_cases + 1i64;
        } else {
            return 102i32;   // desynchronized stream
        }
    }
    // Floor: a truncated or regenerated-to-nothing fixture file must not
    // pass as green (the ssrle_codec discipline).
    if cases < 80i64 {
        return 101i32;
    }
    if index_cases < 40i64 {
        return 103i32;
    }
    return 0i32;
}

// ── driver ─────────────────────────────────────────────────────────────────

fn main() -> i32 {
    let rc1: i32 = check_sizing();
    if rc1 != 0i32 {
        return rc1;
    }
    let rc2: i32 = check_column_canary();
    if rc2 != 0i32 {
        return rc2;
    }
    let rc3: i32 = check_edges();
    if rc3 != 0i32 {
        return rc3;
    }

    // The model sweep: columns 1..4 (the >=3-column path is exercised on
    // every op, not just the canary), both orderings, sizes straddling the
    // IndexSpan boundary.
    let sizes: [u64; 9] = [0u64, 1u64, 2u64, 3u64, 7u64, 16u64, 31u64, 32u64, 33u64];
    let mut seed: u64 = 0x9E3779B97F4A7C15u64;
    let mut cols: u32 = 1u32;
    while cols <= 4u32 {
        let mut si: i64 = 0i64;
        while si < 9i64 {
            let rows: u64 = sizes[si];
            let ra: i32 = check_case(cols, rows, PDT_ORD_SUM, &mut seed);
            if ra != 0i32 {
                return ra;
            }
            let rb: i32 = check_case(cols, rows, PDT_ORD_MAX, &mut seed);
            if rb != 0i32 {
                return rb;
            }
            si = si + 1i64;
        }
        cols = cols + 1u32;
    }

    // ── P1: the recursive span index ──────────────────────────────────────
    let rc5: i32 = check_index_geometry();
    if rc5 != 0i32 {
        return rc5;
    }
    let rc6: i32 = check_empty_index_safety(&mut seed);
    if rc6 != 0i32 {
        return rc6;
    }

    // Three-way at the THRESHOLD, exhaustively: 31 (no index), 32 (the exact
    // boundary), 33 (the first indexed size), and the second-level boundaries.
    let dense_sizes: [u64; 8] = [0u64, 1u64, 31u64, 32u64, 33u64, 34u64,
                                 64u64, 65u64];
    let mut dc: u32 = 1u32;
    while dc <= 4u32 {
        let mut di: i64 = 0i64;
        while di < 8i64 {
            let r: i32 = check_three_way(dc, dense_sizes[di], true, &mut seed);
            if r != 0i32 {
                return r;
            }
            di = di + 1i64;
        }
        dc = dc + 1u32;
    }

    // ... and DEEP, where the tree is genuinely multi-level: 1024 is the last
    // 1-level size (its index is exactly 32 cells), 1025 is the first 2-level
    // size, 32768 the last 2-level one and 32769 the first 3-level one. The
    // level count is asserted at every size (120..122), so "recursive" is a
    // measured property.
    let deep_sizes: [u64; 6] = [1023u64, 1024u64, 1025u64, 2000u64,
                                32768u64, 32769u64];
    let mut kc: u32 = 1u32;
    while kc <= 4u32 {
        let mut ki: i64 = 0i64;
        while ki < 6i64 {
            let r2: i32 = check_three_way(kc, deep_sizes[ki], false, &mut seed);
            if r2 != 0i32 {
                return r2;
            }
            ki = ki + 1i64;
        }
        kc = kc + 1u32;
    }

    let rc4: i32 = check_fixtures();
    if rc4 != 0i32 {
        return rc4;
    }
    return 0i32;
}
