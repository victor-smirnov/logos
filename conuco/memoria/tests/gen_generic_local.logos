// Generic container (ADR 0021 Phase 4b demand path): `container Map<K,V>`
// lowers to a generic CFG const (`MapCfg<K,V>`) + generic alias
// (`Map<K,V> = ContainerType<MapCfg<K,V>>`); naming a concrete instantiation
// in `create_ctr::<Map<u64,u64>>` re-resolves the alias RHS under the
// bindings, mono demands the concrete @hs, and the factory generates the
// family. u64/u64 columns — a GENERIC value param instantiated at `str` is
// the documented str-generic gap (the substituted doc renders `<type:str>`,
// rejected: str is unsized; concrete str decls ride the "str" VLE tag).
package test;

use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;        // create_ctr (ADR 0021 Phase 4b surface)
use logos.mem.pkd;
use logos.mem.bt.map;
use logos.mem.bt.memstore;

container Map<K, V> for u8 { kind ordered_map; entry { key: K, val: V } measure max(key); }

fn main() -> i32 {
    let mut store: MemoryStore = MemoryStore::new();
    let mut s0: MemorySnapshot = store.fork();
    let m = create_ctr::<Map<u64, u64>>(&mut s0, 1u64);
    m.insert(1u64, 11u64);
    m.insert(2u64, 22u64);
    m.insert(3u64, 33u64);
    if m.size() != 3u64 { return 1i32; }
    if m.get_or(2u64, 0u64) != 22u64 { return 2i32; }
    if m.get_or(1u64, 0u64) != 11u64 { return 3i32; }
    if m.get_or(9u64, 0xDEADu64) != 0xDEADu64 { return 4i32; }   // absent → sentinel
    s0.release();
    store.release();
    return 0i32;
}
