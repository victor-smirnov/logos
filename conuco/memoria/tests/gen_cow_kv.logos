// gen_cow_kv — the VOLUME (VLE value) stack, end to end (ADR 0020 Track B ②
// P2 + ADR 0021 Phase 4b demand path): a `kind ordered_map` whose value is
// `str` lowers to a CFG doc carrying the "str" VLE tag + the CtrClass
// alias; `create_ctr::<typeof(GenVol)>` fires the mono demand and the metaclass
// FACTORY generates the volume-flavor family — a volume-split leaf (val_at →
// &[u8]), the routing branch, and the CoW handle (@hs-keyed, package
// logos.gen). The STORE/SNAPSHOT half is the hand-written, shared
// MemoryStore / MemorySnapshot (logos.mem.bt.memstore). The value is
// returned BY VIEW (`get_or(key) -> &[u8]`, borrowing the handle; a MISS is
// an empty slice). Part (1) drives multi-leaf fill / ordered lookup /
// replace-on-hit on str values whose byte-lengths vary (the volume-balanced
// split; formerly the standalone `GenVolTree` half — that surface died with
// the bind asymmetry, so it runs store-backed with size-based assertions
// instead of height-based); part (2) drives CoW snapshot isolation.
package test;

use logos.lcm.canon.container_item;   // the `container` lowering handler + the factory
use logos.lcm.canon.metaclass;        // create_ctr/open_ctr (ADR 0021 Phase 4b surface)
use logos.mem.pkd;                    // the generated leaf/branch target
use logos.mem.bt.map;                 // Ctr trait (the generated `impl Ctr` names it)
use logos.mem.bt.memstore;
use logos.mem.sync;                   // Arc — the store/snapshot plane            // MemoryStore, MemorySnapshot — the shared store
use logos.lang.str;                   // str_byte_at (byte comparison)
use logos.mem.string;
use logos.std.io;

// key:u64 + val:str → a variable-length value column → Canon verdict `volume` →
// the whole VOLUME stack (leaf/branch + cow handle) from this one decl.
container GenVol for u8 {
    kind ordered_map;
    entry { key: u64, val: str }
    measure max(key);
}

const CTR: u64 = 1u64;

// str value for key k — lengths cycle [5, 13, 1, 18] so the volume-balanced split
// is byte-driven, not count-driven.
fn vstr(k: u64) -> str {
    let m: u64 = k % 4u64;
    if m == 0u64 { return "alpha"; }                 // 5
    if m == 1u64 { return "bravo-charlie"; }         // 13
    if m == 2u64 { return "d"; }                     // 1
    return "echo-foxtrot-golf!"; }                    // 18

fn beq(b: &[u8], want: str) -> bool {
    if b.len() != want.len() { return false; }
    let mut i: i64 = 0i64;
    while i < b.len() { if b[i] != str_byte_at(want, i) { return false; } i = i + 1i64; }
    return true;
}

fn run_all() -> i32 {
    // ── (1) multi-leaf volume map: fill / lookup / replace-on-hit ───────────
    let mut tstore: Arc<MemoryStore> = store_new();
    let mut ts: Arc<MemorySnapshot> = store_fork_arc(&mut tstore);
    let t = create_ctr::<typeof(GenVol)>(&mut ts, CTR);
    let n: u64 = 4000u64;
    let mut k: u64 = 0u64;
    while k < n { t.insert(k, vstr(k)); k = k + 1u64; }
    if t.size() != n { return 1i32; }
    // every key present, value bytes correct (get_or returns a borrowed &[u8])
    k = 0u64;
    while k < n {
        if !beq(t.get_or(k), vstr(k)) { return 3i32; }
        k = k + 1u64;
    }
    if t.get_or(n).len() != 0i64 { return 4i32; }    // absent → empty view (miss)
    // replace-on-hit (Map MAX): overwrite a key with a longer value, size fixed
    let bsz: u64 = t.size();
    t.insert(2000u64, "REPLACEMENT-VALUE-LONGISH");
    if t.size() != bsz { return 5i32; }
    if !beq(t.get_or(2000u64), "REPLACEMENT-VALUE-LONGISH") { return 6i32; }
    if !beq(t.get_or(2001u64), vstr(2001u64)) { return 7i32; }   // neighbour intact

    // ── (2) CoW snapshot-versioned map over a VLE value column ───────────────
    let mut store: Arc<MemoryStore> = store_new();
    let m: u64 = 1500u64;
    let mut s0: Arc<MemorySnapshot> = store_fork_arc(&mut store);
    if s0.snapshot_id() != 1u64 { return 8i32; }
    let c0 = create_ctr::<typeof(GenVol)>(&mut s0, CTR);
    k = 0u64;
    while k < m { c0.insert(k, vstr(k)); k = k + 1u64; }
    if c0.size() != m { return 9i32; }
    (&mut *store).commit(&*s0);

    let mut s1: Arc<MemorySnapshot> = store_fork_arc(&mut store);
    let c1 = open_ctr::<typeof(GenVol)>(&mut s1, CTR);
    k = m;
    while k < 2u64 * m { c1.insert(k, vstr(k)); k = k + 1u64; }
    (&mut *store).commit(&*s1);

    // ISOLATION: s0 (frozen) sees only [0, m); s1 sees [0, 2m).
    let c0b = open_ctr::<typeof(GenVol)>(&mut s0, CTR);
    if c0b.size() != m { return 10i32; }
    if c1.size() != 2u64 * m { return 11i32; }
    if c0b.get_or(m).len() != 0i64 { return 12i32; }            // s1's key absent in s0
    if !beq(c1.get_or(m), vstr(m)) { return 13i32; }
    k = 0u64;
    while k < m {
        if !beq(c0b.get_or(k), vstr(k)) { return 14i32; }
        k = k + 1u64;
    }

    // a third version overwrites a spread of keys; s1 untouched.
    let mut s2: Arc<MemorySnapshot> = store_fork_arc(&mut store);
    let c2 = open_ctr::<typeof(GenVol)>(&mut s2, CTR);
    k = 0u64;
    while k < 2u64 * m { c2.insert(k, "OVERWRITTEN"); k = k + 300u64; }
    (&mut *store).commit(&*s2);
    let c2b = open_ctr::<typeof(GenVol)>(&mut s2, CTR);
    let c1b = open_ctr::<typeof(GenVol)>(&mut s1, CTR);
    if !beq(c2b.get_or(0u64), "OVERWRITTEN") { return 15i32; }
    if !beq(c1b.get_or(0u64), vstr(0u64)) { return 16i32; }     // s1 lineage intact
    if !beq(c2b.get_or(300u64), "OVERWRITTEN") { return 17i32; }
    if !beq(c1b.get_or(300u64), vstr(300u64)) { return 18i32; }
    if c2b.size() != 2u64 * m { return 19i32; }                  // overwrite, no growth

    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap (256 & 0xFF == 0) and report
// SUCCESS. The status is a fixed non-zero byte; the code carries the detail.
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL gen_cow_kv: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
