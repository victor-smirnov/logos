// mixed_concrete_generic — a CONCRETE and a GENERIC container in ONE unit
// (ADR 0021 Phase 4b REWRITE). The old premise — the wave-0 bind asymmetry
// (concrete decl → CoW store handle, generic instantiation → standalone
// tree) — DISSOLVED with the uniform create_ctr surface: both declarations
// now lower to CFG+alias and both instantiate through the same demand path.
// The new premise: when the concrete decl's config COINCIDES with a generic
// instantiation's config, the two UNIFY — one CFG doc, one @hs, ONE
// generated family (`family_id()` equality), while a non-coinciding
// instantiation still gets its own family. Also keeps the historical
// regression duty: two decls + demand-path emission in one unit compiles
// through the meta-slice recompile cleanly.
package test;
use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;        // create_ctr + CtrFamily (family_id probe)
use logos.mem.pkd;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.sync;                   // Arc — the store/snapshot plane
use logos.mem.string;
use logos.std.io;

container Conc for u8 {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure max(key);
}
container Gen<V> for u8 {
    kind ordered_map;
    entry { key: u64, val: V }
    measure max(key);
}

fn fid<C: CtrFamily<MemorySnapshot>>() -> u64 { return C::family_id(); }

fn run_all() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();
    let mut s: Arc<MemorySnapshot> = store_fork_arc(&mut store);
    let c = create_ctr::<typeof(Conc)>(&mut s, 1u64);
    c.insert(1u64, 7u64);
    if c.get_or(1u64, 0u64) != 7u64 { return 1i32; }
    (&mut *store).commit(&*s);

    let g = create_ctr::<typeof(Gen::<u64>)>(&mut s, 2u64);
    g.insert(1u64, 5u64);
    if g.get_or(1u64, 0u64) != 5u64 { return 2i32; }

    // coinciding configs UNIFY: Conc and Gen<u64> are ONE family
    if fid::<typeof(Conc)>() != fid::<typeof(Gen::<u64>)>() { return 3i32; }
    // a non-coinciding instantiation gets its OWN family
    let d = create_ctr::<typeof(Gen::<u32>)>(&mut s, 3u64);
    d.insert(1u64, 9u32);
    if d.get_or(1u64, 0u32) != 9u32 { return 4i32; }
    if fid::<typeof(Gen::<u32>)>() == fid::<typeof(Conc)>() { return 5i32; }

    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap (256 & 0xFF == 0) and report
// SUCCESS. The status is a fixed non-zero byte; the code carries the detail.
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL mixed_concrete_generic: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
