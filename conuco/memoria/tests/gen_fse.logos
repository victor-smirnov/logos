// gen_fse — Canon container codegen is GENERIC over any concrete FSE key/val
// type (ADR 0020 Track B ② P1 + ADR 0021 Phase 4b demand path): the same
// one-declaration → whole-family path proven on NON-u64 columns. Three
// ordered_maps with distinct FSE key/val types each drive the FULL generated
// family through `create_ctr` (@hs-keyed factory emission): fill, ordered
// lookup, replace-on-hit, split, snapshot isolation. The u64/u64 case
// (gen_tree/gen_cow) was never special — the factory threads kty/vty; only
// subtree-size/ptr/snapshot columns are legitimately u64. This test is the
// proof. (The standalone `{N}Tree` surface died with the bind asymmetry —
// every half runs store-backed; multi-level growth is still forced by the
// insert volumes, asserted through size, not height.)
package test;

use logos.lcm.canon.container_item;   // the `container` lowering handler + the factory
use logos.lcm.canon.metaclass;        // create_ctr/open_ctr (ADR 0021 Phase 4b surface)
use logos.mem.pkd;                    // the generated leaf/branch target
use logos.mem.bt.map;                 // Ctr trait (the generated `impl Ctr` names it)
use logos.mem.bt.memstore;
use logos.mem.sync;                   // Arc — the store/snapshot plane            // MemoryStore/MemorySnapshot — the shared store
use logos.mem.string;
use logos.std.io;

// (A) u32 key, i64 value — fill/lookup + CoW isolation.
container FseA for u8 {
    kind ordered_map;
    entry { key: u32, val: i64 }
    measure max(key);
}
// (B) i32 key (SIGNED — proves signed key comparison in lower_bound/find_child),
//     u32 value — negative→positive keys.
container FseB for u8 {
    kind ordered_map;
    entry { key: i32, val: u32 }
    measure max(key);
}
// (C) u16 key, u32 value — narrow key.
container FseC for u8 {
    kind ordered_map;
    entry { key: u16, val: u32 }
    measure max(key);
}

fn run_all() -> i32 {
    // ── (A) u32 → i64 : bulk fill forcing multi-level growth ────────────────
    let mut astore: Arc<MemoryStore> = store_new();
    let mut as0: MemorySnapshot = store_fork(&mut astore);
    let ta = create_ctr::<typeof(FseA)>(&mut as0, 1u64);
    let na: u32 = 100000u32;
    let mut a: u32 = 0u32;
    while a < na { ta.insert(a, (a as i64) * 2i64 - 100i64); a = a + 1u32; }
    if ta.size() != na as u64 { return 1i32; }
    a = 0u32;
    while a < na {
        if ta.get_or(a, -999i64) != (a as i64) * 2i64 - 100i64 { return 3i32; }
        a = a + 1u32;
    }
    if ta.get_or(na, -999i64) != -999i64 { return 4i32; }        // absent
    // replace-on-hit, size unchanged
    let bsz: u64 = ta.size();
    ta.insert(4000u32, 777777i64);
    if ta.size() != bsz { return 5i32; }
    if ta.get_or(4000u32, -1i64) != 777777i64 { return 6i32; }

    // ── (A) u32 → i64 : CoW-map snapshot isolation ───────────────────────────
    let mut store: Arc<MemoryStore> = store_new();
    let m: u32 = 3000u32;
    let mut s0: MemorySnapshot = store_fork(&mut store);
    let c0 = create_ctr::<typeof(FseA)>(&mut s0, 1u64);
    let mut k: u32 = 0u32;
    while k < m { c0.insert(k, k as i64 + 5i64); k = k + 1u32; }
    if c0.size() != m as u64 { return 7i32; }
    store.commit(&s0);
    let mut s1: MemorySnapshot = store_fork(&mut store);
    let c1 = open_ctr::<typeof(FseA)>(&mut s1, 1u64);
    k = m;
    while k < 2u32 * m { c1.insert(k, k as i64 + 5i64); k = k + 1u32; }
    store.commit(&s1);
    let c0b = open_ctr::<typeof(FseA)>(&mut s0, 1u64);
    if c0b.size() != m as u64 { return 8i32; }                    // frozen A
    if c1.size() != 2u64 * m as u64 { return 9i32; }
    if c0b.get_or(m, -42i64) != -42i64 { return 10i32; }         // s1's key absent in s0
    if c1.get_or(m, -42i64) != m as i64 + 5i64 { return 11i32; }

    // ── (B) i32 → u32 : SIGNED keys spanning negative → positive ────────────
    let mut bstore: Arc<MemoryStore> = store_new();
    let mut bs0: MemorySnapshot = store_fork(&mut bstore);
    let tb = create_ctr::<typeof(FseB)>(&mut bs0, 1u64);
    let lo: i32 = -4000i32;
    let hi: i32 = 4000i32;
    let mut ib: i32 = lo;
    while ib < hi { tb.insert(ib, (ib + 100000i32) as u32); ib = ib + 1i32; }
    if tb.size() != (hi - lo) as u64 { return 12i32; }
    ib = lo;
    while ib < hi {
        if tb.get_or(ib, 0u32) != (ib + 100000i32) as u32 { return 13i32; }
        ib = ib + 1i32;
    }
    if tb.get_or(-9999i32, 7u32) != 7u32 { return 14i32; }       // below range
    if tb.get_or(9999i32, 7u32) != 7u32 { return 15i32; }        // above range

    // ── (C) u16 → u32 : narrow key, fill + CoW roundtrip ────────────────────
    let mut cstore: Arc<MemoryStore> = store_new();
    let mut cs0: MemorySnapshot = store_fork(&mut cstore);
    let tc = create_ctr::<typeof(FseC)>(&mut cs0, 1u64);
    let nc: u16 = 6000u16;
    let mut c: u16 = 0u16;
    while c < nc { tc.insert(c, c as u32 * 3u32); c = c + 1u16; }
    if tc.size() != nc as u64 { return 16i32; }
    c = 0u16;
    while c < nc {
        if tc.get_or(c, 0xFFFFu32) != c as u32 * 3u32 { return 17i32; }
        c = c + 1u16;
    }
    cstore.commit(&cs0);
    let cc0b = open_ctr::<typeof(FseC)>(&mut cs0, 1u64);
    if cc0b.get_or(1500u16, 0xFFFFu32) != 1500u32 * 3u32 { return 19i32; }

    return 0i32;
}

// The diagnostic code is PRINTED, never returned: a process exit status is an
// 8-bit channel, so any code >= 256 would wrap (256 & 0xFF == 0) and report
// SUCCESS. The status is a fixed non-zero byte; the code carries the detail.
fn main() -> i32 {
    let code: i32 = run_all();
    if code == 0i32 {
        return 0i32;
    }
    let mut msg: String = String::new();
    msg.push_str("FAIL gen_fse: diagnostic code ");
    msg.push_i64(code as i64);
    eprintln_string(&msg);
    return 1i32;
}
