// bt_map — the M2 B+tree end-to-end over the flat arena: point inserts with
// splits across multiple levels, overwrite, lookup hit/miss, removal incl.
// rightmost (max-chain fixups), forward/backward cursor walks, seek
// (lower-bound), chunk hops — and the STREAMING path: bulk_build from a
// sorted stream, cross-checked entry-by-entry against the point-built tree.
package test;

use memoria.pkd;
use memoria.bt;
use logos.lang.mem;
use logos.lang.option;
use logos.mem.collections.vec;

// deterministic LCG (Knuth MMIX)
struct Lcg { s: u64 }
impl Lcg {
    fn next(self: &mut Lcg) -> u64 {
        self.s = self.s * 6364136223846793005u64 + 1442695040888963407u64;
        return self.s >> 33u64;
    }
}

fn main() -> i32 {
    let mut arena: BtArena = arena_new();
    let mut t: BtTree = bt_new(&mut arena);

    // ── point inserts: 5000 keys in shuffled order (forces multi-level splits;
    // 4096-byte nodes hold ~500 u64 pairs → 3 levels) ──
    let n: i64 = 5000i64;
    let mut lcg: Lcg = Lcg { s: 0xC0FFEEu64 };
    let mut inserted: Vec<u64> = vec_new::<u64>();
    let mut i: i64 = 0i64;
    while i < n {
        let k: u64 = (lcg.next() % 100000u64) * 2u64;   // even keys only
        if bt_insert(&mut arena, &mut t, k, k * 10u64) {
            inserted.push(k);
        } else { return 1i32; }
        i = i + 1i64;
    }

    // every inserted key resolves to its value; odd keys miss
    i = 0i64;
    while i < inserted.len() {
        let k: u64 = inserted.get(i);
        match bt_find(&arena, &t, k) {
            Option::Some(v) => { if v != k * 10u64 { return 2i32; } }
            Option::None    => { return 3i32; }
        }
        match bt_find(&arena, &t, k + 1u64) {
            Option::Some(_v) => { return 4i32; }
            Option::None     => { }
        }
        i = i + 1i64;
    }

    // overwrite: same key, new value
    let k0: u64 = inserted.get(0i64);
    if !bt_insert(&mut arena, &mut t, k0, 777u64) { return 5i32; }
    match bt_find(&arena, &t, k0) {
        Option::Some(v) => { if v != 777u64 { return 6i32; } }
        Option::None    => { return 7i32; }
    }
    let _ = bt_insert(&mut arena, &mut t, k0, k0 * 10u64);   // restore

    // ── cursor: full forward walk is sorted and matches count ──
    let total: u64 = bt_count(&arena, &t);
    let mut c: BtCursor = bt_first(&arena, &t);
    let mut walked: u64 = 0u64;
    let mut prev: u64 = 0u64;
    let mut first: bool = true;
    while c.valid() {
        let k: u64 = c.key(&arena);
        if !first && k <= prev { return 8i32; }
        first = false;
        prev = k;
        if c.val(&arena) != k * 10u64 { return 9i32; }
        walked = walked + 1u64;
        c.next(&arena);
    }
    if walked != total { return 10i32; }
    if walked == 0u64 { return 11i32; }

    // seek: lower bound of an absent odd key lands on the next even key
    let mut sc: BtCursor = bt_seek(&arena, &t, prev);   // max key: exact hit
    if !sc.valid() { return 12i32; }
    if sc.key(&arena) != prev { return 13i32; }
    sc.next(&arena);
    if sc.valid() { return 14i32; }                     // walked off the end

    // backward: prev() from a mid cursor retraces sorted order
    let mut bc: BtCursor = bt_seek(&arena, &t, prev);
    let mut back: u64 = 1u64;
    let mut last: u64 = prev;
    bc.prev(&arena);
    while bc.valid() {
        if bc.key(&arena) >= last { return 15i32; }
        last = bc.key(&arena);
        back = back + 1u64;
        bc.prev(&arena);
    }
    if back != total { return 16i32; }

    // ── removal: every third walked key; count + misses check out ──
    let mut victims: Vec<u64> = vec_new::<u64>();
    {
        let mut vc: BtCursor = bt_first(&arena, &t);
        let mut j: i64 = 0i64;
        while vc.valid() {
            if j % 3i64 == 0i64 { victims.push(vc.key(&arena)); }
            j = j + 1i64;
            vc.next(&arena);
        }
    }
    i = 0i64;
    while i < victims.len() {
        if !bt_remove(&mut arena, &mut t, victims.get(i)) { return 17i32; }
        i = i + 1i64;
    }
    if bt_remove(&mut arena, &mut t, victims.get(0i64)) { return 18i32; }  // gone
    if bt_count(&arena, &t) != total - (victims.len() as u64) { return 19i32; }
    match bt_find(&arena, &t, victims.get(1i64)) {
        Option::Some(_v) => { return 20i32; }
        Option::None     => { }
    }

    // ── streaming creation: bulk_build ≡ point-built (same content) ──
    let m: i64 = 3000i64;
    let keys: *mut u64 = alloc(m * 8i64) as *mut u64;
    let vals: *mut u64 = alloc(m * 8i64) as *mut u64;
    unsafe {
        let mut j: i64 = 0i64;
        while j < m {
            *(((keys as i64) + j * 8i64) as *mut u64) = (j as u64) * 3u64;
            *(((vals as i64) + j * 8i64) as *mut u64) = (j as u64) * 3u64 + 1u64;
            j = j + 1i64;
        }
    }
    let mut arena2: BtArena = arena_new();
    let bt2: BtTree = bt_bulk_build(&mut arena2, keys as *const u64, vals as *const u64, m, 100u32);
    if bt_count(&arena2, &bt2) != m as u64 { return 30i32; }
    // walk: sorted, exact pairs
    let mut c2: BtCursor = bt_first(&arena2, &bt2);
    let mut j2: i64 = 0i64;
    while c2.valid() {
        if c2.key(&arena2) != (j2 as u64) * 3u64 { return 31i32; }
        if c2.val(&arena2) != (j2 as u64) * 3u64 + 1u64 { return 32i32; }
        j2 = j2 + 1i64;
        c2.next(&arena2);
    }
    if j2 != m { return 33i32; }
    // random lookups against the streamed tree
    let mut lcg2: Lcg = Lcg { s: 42u64 };
    let mut q: i64 = 0i64;
    while q < 500i64 {
        let pick: u64 = lcg2.next() % (m as u64);
        match bt_find(&arena2, &bt2, pick * 3u64) {
            Option::Some(v) => { if v != pick * 3u64 + 1u64 { return 34i32; } }
            Option::None    => { return 35i32; }
        }
        q = q + 1i64;
    }
    // chunk-granularity walk agrees with entry count
    let mut cc: BtCursor = bt_first(&arena2, &bt2);
    let mut chunked: u64 = 0u64;
    while cc.valid() {
        chunked = chunked + (cc.chunk_remaining(&arena2) as u64);
        cc.next_chunk(&arena2);
    }
    if chunked != m as u64 { return 36i32; }

    unsafe { dealloc(keys as *mut u8); dealloc(vals as *mut u8); }
    return 0i32;
}
