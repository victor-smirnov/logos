// memoria.pkd — PkdArr<T>: the packed fixed-size-element array as a GENERIC
// CUSTOM DST — a self-describing struct whose unsized `[T]` tail lives
// directly in the block. Typed at the STRUCT level: element access is
// language-level indexing (`self.data[i]`, bounds-checked against the
// in-band count via SelfDescribing::dst_len), not per-call turbofish over
// raw byte arithmetic. This is the road to the no-unsafe packed layer: the
// compiler's DST machinery already understands these views.
//
// An ALLOCATABLE packed structure: aggregates PkdAllocatable first, GROWS
// ITSELF through its own allocator — recursive to any nesting depth.
// Slot-order growth moves only later siblings, so `self` never moves during
// its own resize.
//
// Capacity policy: exact fit — data.len() == count, always. Fullness is the
// caller's policy signal (a B+tree node that can't grow splits).
package memoria.pkd;

use logos.lang.marker;    // SelfDescribing

/// Header (8 bytes) + `count` elements of `T` inline in the block.
///
/// `T` is an FST — a FIXED-SIZE TYPE: statically sized (the implicit Sized
/// bound; sizeof::<T>() is the element stride), Copy/no-Drop (elements are
/// byte-moved on shifts and splits; Copy excludes Drop — E0184), and free of
/// absolute references (the block is relocatable and dumpable). The first
/// two are enforced AT THE STRUCT DECLARATION (`PkdArr<String>` is not a
/// nameable type), and the no-references leg by the `Fst` auto trait
/// (structural derivation; pointer/reference kinds excluded) — the whole
/// contract is a type error at the point where the element type is written.
#[self_describing]
pub struct PkdArr<T: Copy + Fst> {
    pub able: PkdAllocatable,
    count:    u32,
    /// The elements — an inline flexible-array tail, length == count.
    pub data: [T],
}

/// The `[T]` tail length is the in-band `count`: raw `*PkdArr<T>` stays THIN;
/// fat `&PkdArr<T>` / `self.data` views materialize through this.
impl<T: Copy + Fst> SelfDescribing for PkdArr<T> {
    fn dst_len(self: *const PkdArr<T>) -> i64 { return unsafe { (*self).count as i64 }; }
}

/// Formats slot `idx` of `alc` as an empty PkdArr<T> (ALLOCATABLE); null on OOM.
pub unsafe fn arr_format<T: Copy + Fst>(alc: *mut PkdAlloc, idx: u32) -> *mut PkdArr<T> {
    let p: *mut u8 = alc.allocate(idx, sizeof::<PkdArr<T>>() as u32, PKD_ALLOCATABLE);
    if (p as i64) == 0i64 { return 0i64 as *mut PkdArr<T>; }
    return p as *mut PkdArr<T>;    // count zero-filled by allocate
}

impl<T: Copy + Fst> PkdArr<T> {
    pub fn count(self: &PkdArr<T>) -> u32 { return self.count; }

    /// Element `i` by value. (Index-read of a GENERIC tail currently trips
    /// E0507 even under `T: Copy` — raw typed read until the checker learns
    /// Copy-indexing on generic DST tails; the u64 impl below stays typed.)
    pub fn get(self: &PkdArr<T>, i: u32) -> T {
        let sp: *const PkdArr<T> = self as *const PkdArr<T>;
        let ep: i64 = (sp as i64) + (sizeof::<PkdArr<T>>() as i64)
                    + (i as i64) * sizeof::<T>();
        return unsafe { *(ep as *const T) };
    }

    /// Overwrites element `i` — typed, bounds-checked.
    pub fn set(self: &mut PkdArr<T>, i: u32, v: T) {
        let sp: *mut PkdArr<T> = self as *mut PkdArr<T>;
        unsafe {
            let r: &mut PkdArr<T> = &mut *sp;
            r.data[i as i64] = v;
        }
    }

    // Raw address of element `i` — ONLY for the shift/split moves below.
    unsafe fn elem_raw(self: &PkdArr<T>, i: u32) -> *mut u8 {
        let sp: *const PkdArr<T> = self as *const PkdArr<T>;
        return ((sp as i64) + (sizeof::<PkdArr<T>>() as i64)
                + (i as i64) * sizeof::<T>()) as *mut u8;
    }

    // Grow/shrink my own block through MY allocator; false = OOM upstream.
    unsafe fn resize_self(self: &mut PkdArr<T>, new_size: u32) -> bool {
        let alc: *mut PkdAlloc = self.able.allocator();
        let sp: *mut PkdArr<T> = self as *mut PkdArr<T>;
        return alc.resize_block(sp as *const u8, new_size) != 0xFFFF_FFFFu32;
    }

    /// Inserts `v` at position `i` (0 ≤ i ≤ count), shifting the suffix.
    /// Grows exactly; false = no room anywhere up the allocator chain.
    pub unsafe fn insert(self: &mut PkdArr<T>, i: u32, v: T) -> bool {
        let sp: *mut PkdArr<T> = self as *mut PkdArr<T>;
        let esz: i64 = sizeof::<T>();
        let cnt: u32 = sp.count();
        let need: u32 = (sizeof::<PkdArr<T>>() as u32) + (((cnt as i64) + 1i64) * esz) as u32;
        if !sp.resize_self(need) { return false; }
        let src: *mut u8 = sp.elem_raw(i);
        move_bytes(((src as i64) + esz) as *mut u8, src as *const u8,
                   ((cnt - i) as i64) * esz);
        sp.count = cnt + 1u32;                 // count first: the write below
        let r: &mut PkdArr<T> = &mut *sp;      // is bounds-checked against it
        r.data[i as i64] = v;
        return true;
    }

    /// Appends `v`.
    pub unsafe fn push(self: &mut PkdArr<T>, v: T) -> bool {
        let sp: *mut PkdArr<T> = self as *mut PkdArr<T>;
        let at: u32 = sp.count();
        return sp.insert(at, v);
    }

    /// Removes position `i`, shrinking to exact fit.
    pub unsafe fn remove(self: &mut PkdArr<T>, i: u32) {
        let sp: *mut PkdArr<T> = self as *mut PkdArr<T>;
        let esz: i64 = sizeof::<T>();
        let cnt: u32 = sp.count();
        let dst: *mut u8 = sp.elem_raw(i);
        move_bytes(dst, ((dst as i64) + esz) as *const u8,
                   ((cnt - i - 1u32) as i64) * esz);
        sp.count = cnt - 1u32;
        let keep: u32 = (sizeof::<PkdArr<T>>() as u32) + (((cnt - 1u32) as i64) * esz) as u32;
        let _ = sp.resize_self(keep);
    }

    /// Moves elements [mid..count) into `dst` (an EMPTY formatted PkdArr<T>,
    /// typically in another node block); truncates self to [0..mid). The
    /// B+tree split primitive. false = OOM growing dst.
    pub unsafe fn split_into(self: &mut PkdArr<T>, dst: *mut PkdArr<T>, mid: u32) -> bool {
        let sp: *mut PkdArr<T> = self as *mut PkdArr<T>;
        let esz: i64 = sizeof::<T>();
        let moved: u32 = sp.count() - mid;
        let need: u32 = (sizeof::<PkdArr<T>>() as u32) + ((moved as i64) * esz) as u32;
        if !dst.resize_self(need) { return false; }
        move_bytes(dst.elem_raw(0u32), sp.elem_raw(mid) as *const u8,
                   (moved as i64) * esz);
        dst.count = moved;
        sp.count = mid;
        let keep: u32 = (sizeof::<PkdArr<T>>() as u32) + ((mid as i64) * esz) as u32;
        let _ = sp.resize_self(keep);
        return true;
    }
}

/// First position with element ≥ `key` in a SORTED PkdArr<u64>. (A free fn:
/// concrete-instantiation impl methods on a generic DST don't resolve across
/// module boundaries yet; the generic comparator-driven form arrives with
/// the ctr-layer key abstraction.)
pub unsafe fn arr_lower_bound_u64(a: *mut PkdArr<u64>, key: u64) -> u32 {
    let mut lo: u32 = 0u32;
    let mut hi: u32 = a.count();
    while lo < hi {
        let mid: u32 = lo + (hi - lo) / 2u32;
        if a.get(mid) < key { lo = mid + 1u32; }
        else { hi = mid; }
    }
    return lo;
}
