// memoria.pkd — PkdArray<T>: THE packed array, unified over the Sized
// partition (ADR 0018 §2.3 «идеальный PkdArray»). One container type; the
// element FAMILY is selected by T through the PkdElem trait:
//
//   impl<T: …> PkdElem for T     — fixed-size elements (FSE): sized values,
//                                  stride = sizeof(T), direct indexing;
//   impl<E: …> PkdElem for [E]   — variable-length elements (VLE): unsized
//                                  byte-measured entries, an offs table in
//                                  the tail ([str] entries ride as [u8] —
//                                  str is Slice<u8> by language design).
//
// The impls carry the SAFETY bounds (Copy + Fst + StableLayout — Fst now
// includes no-Drop; StableLayout freezes the element layout), so consumers
// write only `T: ?Sized + PkdElem`. The container header itself is a SIZED
// struct; the tail is family-shaped:
//
//   FSE: PkdArray { able, count } + elements (count × stride)
//   VLE: PkdArray { able, count } + offs[(count+1) × u32] + entry bytes
//        (offs relative to the STRUCTURE start; entry i = [offs[i], offs[i+1]))
//
// An ALLOCATABLE packed structure: aggregates PkdAllocatable, GROWS ITSELF
// through its own allocator (recursive to any depth), exact-fit policy —
// fullness is the caller's split signal.
package memoria.pkd;

use logos.lang.marker;    // Fst, StableLayout
use logos.lang.mem;       // transient offs-table scratch (VLE mutations)

// ── the element-family trait (Sized partition — no specialization) ──────────

/// Element vocabulary of `PkdArray`. The two impls PARTITION the type space
/// by the implicit `Sized` bound; `stride` is the family selector.
pub trait PkdElem {
    /// Fixed byte stride for sized elements; −1 for variable-length families.
    fn stride(self: *const Self) -> i64;
}

impl<T: Copy + Fst + StableLayout> PkdElem for T {
    fn stride(self: *const T) -> i64 { return sizeof::<T>(); }
}

impl<E: Copy + Fst + StableLayout> PkdElem for [E] {
    fn stride(self: *const [E]) -> i64 { return 0i64 - 1i64; }
}

// The per-instantiation family constant (a phantom ride: fat-pointer values
// are pair ADDRESSES, so the null phantom is a zeroed stack pair).
pub fn elem_stride<T: PkdElem + ?Sized>() -> i64 {
    let z: (i64, i64) = (0i64, 0i64);
    let p: *const T = ((&z as *const (i64, i64)) as i64) as *const T;
    return unsafe { p.stride() };
}

// ── the container ────────────────────────────────────────────────────────────

/// Header (8 bytes) + a family-shaped tail (see the package doc).
pub struct PkdArray<T: PkdElem + ?Sized> {
    pub able: PkdAllocatable,
    count:    u32,
}

const HDR: u32 = 8u32;

unsafe fn tbl_at(t: *const u32, k: u32) -> u32 {
    return *(((t as i64) + (k as i64) * 4i64) as *const u32);
}

/// Formats slot `idx` of `alc` as an empty PkdArray<T>; null on OOM.
pub unsafe fn array_format<T: PkdElem + ?Sized>(alc: *mut PkdAlloc, idx: u32)
    -> *mut PkdArray<T> {
    let vle: bool = elem_stride::<T>() < 0i64;
    let init: u32 = if vle { HDR + 4u32 } else { HDR };
    let p: *mut u8 = alc.allocate(idx, init, PKD_ALLOCATABLE);
    if (p as i64) == 0i64 { return 0i64 as *mut PkdArray<T>; }
    let a: *mut PkdArray<T> = p as *mut PkdArray<T>;
    if vle { a.off_wr(0u32, HDR + 4u32); }   // offs[0] = data start
    return a;
}

impl<T: PkdElem + ?Sized> PkdArray<T> {
    pub fn count(self: &PkdArray<T>) -> u32 { return self.count; }

    // ── raw geometry ─────────────────────────────────────────────────────
    unsafe fn me(self: &PkdArray<T>) -> i64 {
        let sp: *const PkdArray<T> = self as *const PkdArray<T>;
        return sp as i64;
    }
    unsafe fn off_cell(self: &PkdArray<T>, i: u32) -> *mut u32 {
        return (self.me() + (HDR as i64) + (i as i64) * 4i64) as *mut u32;
    }
    unsafe fn off(self: &PkdArray<T>, i: u32) -> u32 { return *self.off_cell(i); }
    unsafe fn off_wr(self: &PkdArray<T>, i: u32, v: u32) { *self.off_cell(i) = v; }

    /// Entry `i` as raw bytes: (pointer into the block, byte length). Valid
    /// only until the next mutation of the containing block.
    pub unsafe fn entry(self: &PkdArray<T>, i: u32) -> (*const u8, i64) {
        let st: i64 = elem_stride::<T>();
        if st >= 0i64 {
            return ((self.me() + (HDR as i64) + (i as i64) * st) as *const u8, st);
        }
        let o: u32 = self.off(i);
        let e: u32 = self.off(i + 1u32);
        return ((self.me() + (o as i64)) as *const u8, (e - o) as i64);
    }

    unsafe fn resize_self(self: &mut PkdArray<T>, new_size: u32) -> bool {
        let alc: *mut PkdAlloc = self.able.allocator();
        let sp: *mut PkdArray<T> = self as *mut PkdArray<T>;
        return alc.resize_block(sp as *const u8, new_size) != 0xFFFF_FFFFu32;
    }

    // Snapshot the VLE offs table into transient scratch (caller frees) —
    // mutations move the data region once and rebuild the table from entry
    // lengths, no in-place aliasing.
    unsafe fn tbl_snapshot(self: &PkdArray<T>) -> *mut u32 {
        let t: *mut u32 = alloc(((self.count as i64) + 1i64) * 4i64) as *mut u32;
        let mut k: u32 = 0u32;
        while k <= self.count {
            *(((t as i64) + (k as i64) * 4i64) as *mut u32) = self.off(k);
            k = k + 1u32;
        }
        return t;
    }

    /// Inserts `src[0..len)` as entry `i` (0 ≤ i ≤ count). For the FSE family
    /// `len` must equal the stride. Grows exactly; false = no room anywhere
    /// up the allocator chain.
    pub unsafe fn insert_bytes(self: &mut PkdArray<T>, i: u32,
                               src: *const u8, len: i64) -> bool {
        let sp: *mut PkdArray<T> = self as *mut PkdArray<T>;
        let st: i64 = elem_stride::<T>();
        let cnt: u32 = sp.count();
        if st >= 0i64 {
            if len != st { return false; }
            let need: u32 = HDR + (((cnt as i64) + 1i64) * st) as u32;
            if !sp.resize_self(need) { return false; }
            let at: i64 = sp.me() + (HDR as i64) + (i as i64) * st;
            move_bytes((at + st) as *mut u8, at as *const u8,
                       ((cnt - i) as i64) * st);
            move_bytes(at as *mut u8, src, st);
            sp.count = cnt + 1u32;
            return true;
        }
        // VLE: one extra offs cell + the entry bytes
        let need: u32 = sp.off(cnt) + 4u32 + (len as u32);
        if !sp.resize_self(need) { return false; }
        let old: *mut u32 = sp.tbl_snapshot();
        let d0: u32 = tbl_at(old as *const u32, 0u32);
        let dn: u32 = tbl_at(old as *const u32, cnt);
        let at: u32 = tbl_at(old as *const u32, i);
        let me: i64 = sp.me();
        move_bytes((me + (d0 as i64) + 4i64) as *mut u8,
                   (me + (d0 as i64)) as *const u8, (dn - d0) as i64);
        move_bytes((me + (at as i64) + 4i64 + len) as *mut u8,
                   (me + (at as i64) + 4i64) as *const u8, (dn - at) as i64);
        move_bytes((me + (at as i64) + 4i64) as *mut u8, src, len);
        let mut new_off: u32 = d0 + 4u32;
        sp.off_wr(0u32, new_off);
        let mut k: u32 = 0u32;
        let mut o: u32 = 0u32;
        while k <= cnt {
            let elen: u32 = if k == i { len as u32 }
                            else {
                                let l: u32 = tbl_at(old as *const u32, o + 1u32)
                                           - tbl_at(old as *const u32, o);
                                o = o + 1u32;
                                l
                            };
            new_off = new_off + elen;
            sp.off_wr(k + 1u32, new_off);
            k = k + 1u32;
        }
        sp.count = cnt + 1u32;
        dealloc(old as *mut u8);
        return true;
    }

    /// Appends an entry.
    pub unsafe fn push_bytes(self: &mut PkdArray<T>, src: *const u8, len: i64) -> bool {
        let sp: *mut PkdArray<T> = self as *mut PkdArray<T>;
        let at: u32 = sp.count();
        return sp.insert_bytes(at, src, len);
    }

    /// Removes entry `i`, shrinking to exact fit.
    pub unsafe fn remove(self: &mut PkdArray<T>, i: u32) {
        let sp: *mut PkdArray<T> = self as *mut PkdArray<T>;
        let st: i64 = elem_stride::<T>();
        let cnt: u32 = sp.count();
        if st >= 0i64 {
            let at: i64 = sp.me() + (HDR as i64) + (i as i64) * st;
            move_bytes(at as *mut u8, (at + st) as *const u8,
                       ((cnt - i - 1u32) as i64) * st);
            sp.count = cnt - 1u32;
            let keep: u32 = HDR + (((cnt - 1u32) as i64) * st) as u32;
            let _ = sp.resize_self(keep);
            return;
        }
        let old: *mut u32 = sp.tbl_snapshot();
        let d0: u32 = tbl_at(old as *const u32, 0u32);
        let dn: u32 = tbl_at(old as *const u32, cnt);
        let o: u32 = tbl_at(old as *const u32, i);
        let e: u32 = tbl_at(old as *const u32, i + 1u32);
        let len: u32 = e - o;
        let me: i64 = sp.me();
        move_bytes((me + (o as i64)) as *mut u8,
                   (me + (e as i64)) as *const u8, (dn - e) as i64);
        move_bytes((me + (d0 as i64) - 4i64) as *mut u8,
                   (me + (d0 as i64)) as *const u8, (dn - len - d0) as i64);
        let mut new_off: u32 = d0 - 4u32;
        sp.off_wr(0u32, new_off);
        let mut k: u32 = 0u32;
        let mut oi: u32 = 0u32;
        while k < cnt - 1u32 {
            if oi == i { oi = oi + 1u32; }
            let elen: u32 = tbl_at(old as *const u32, oi + 1u32)
                          - tbl_at(old as *const u32, oi);
            new_off = new_off + elen;
            sp.off_wr(k + 1u32, new_off);
            oi = oi + 1u32;
            k = k + 1u32;
        }
        sp.count = cnt - 1u32;
        dealloc(old as *mut u8);
        let keep: u32 = if sp.count() == 0u32 { HDR + 4u32 } else { new_off };
        let _ = sp.resize_self(keep);
    }
}

// ── typed FSE conveniences (sized T only — the implicit Sized bound keeps
// these off the VLE family; the container stays unified) ───────────────────

pub unsafe fn arr_get<T: Copy + Fst + StableLayout>(a: *mut PkdArray<T>, i: u32) -> T {
    let (p, _n) = a.entry(i);
    return *(p as *const T);
}

pub unsafe fn arr_set<T: Copy + Fst + StableLayout>(a: *mut PkdArray<T>, i: u32, v: T) {
    let (p, _n) = a.entry(i);
    *(p as *mut T) = v;
}

pub unsafe fn arr_insert<T: Copy + Fst + StableLayout>(a: *mut PkdArray<T>, i: u32, v: T) -> bool {
    let vp: *const T = &v;
    return a.insert_bytes(i, vp as *const u8, sizeof::<T>());
}

pub unsafe fn arr_push<T: Copy + Fst + StableLayout>(a: *mut PkdArray<T>, v: T) -> bool {
    let at: u32 = a.count();
    return arr_insert::<T>(a, at, v);
}

/// Moves entries [mid..count) into `dst` (an EMPTY formatted PkdArray<T> in
/// another block); truncates self to [0..mid). The B+tree split primitive
/// (FSE family; the VLE split lands with its first consumer).
pub unsafe fn arr_split<T: Copy + Fst + StableLayout>(a: *mut PkdArray<T>,
                                                      dst: *mut PkdArray<T>,
                                                      mid: u32) -> bool {
    let esz: i64 = sizeof::<T>();
    let cnt: u32 = a.count();
    let moved: u32 = cnt - mid;
    let need: u32 = HDR + ((moved as i64) * esz) as u32;
    if !dst.resize_self(need) { return false; }
    let (src, _sl) = a.entry(mid);
    let (dp, _dl) = dst.entry(0u32);
    move_bytes(dp as *mut u8, src, (moved as i64) * esz);
    dst.count = moved;
    a.count = mid;
    let keep: u32 = HDR + ((mid as i64) * esz) as u32;
    let _ = a.resize_self(keep);
    return true;
}

/// First position with element ≥ `key` in a SORTED PkdArray<u64>.
pub unsafe fn arr_lower_bound_u64(a: *mut PkdArray<u64>, key: u64) -> u32 {
    let mut lo: u32 = 0u32;
    let mut hi: u32 = a.count();
    while lo < hi {
        let mid: u32 = lo + (hi - lo) / 2u32;
        if arr_get::<u64>(a, mid) < key { lo = mid + 1u32; }
        else { hi = mid; }
    }
    return lo;
}
