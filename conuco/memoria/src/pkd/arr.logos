// memoria.pkd — PkdArray<T>: ONE name, selection by the PROPERTIES of T
// (the C++ `template<typename T, bool FSE = is_fse<T>>` model; is_fse<T> is
// spelled as the bound set `Copy + Fst + StableLayout`):
//
//   PkdArray<T: Copy + Fst + StableLayout>   the FSE spec. Inherits-by-first-
//       field from PkdAllocatable: layout INLINE (header + count × T), no
//       slot machinery at all. #[self_describing] DST with a TYPED [T] tail
//       (dst_len = count); grows itself through its own back-ref (recursive
//       enlarge — the resize protocol of alloc.logos).
//
//   PkdArray<T: ?Sized>   the primary — every OTHER T (unsized, non-Copy,
//       droppable, layout-unstable) is a VARIABLE-LENGTH-entry array.
//       Inherits from PkdAlloc (single unsized base field): internal
//       structure lives in the SLOTS of the embedded allocator (the C++
//       PackedDataTypeBuffer : public PackedAllocator pattern):
//
//         slot 0 (CNT)   entry count, u32
//         slot 1 (OFFS)  u32[count+1], offsets RELATIVE to the data slot
//                        (entry i = data[offs[i] .. offs[i+1]))
//         slot 2 (DATA)  entry bytes, contiguous
//
//       Entries are raw byte runs (PkdArray<str> is the canonical string
//       array — str ≡ [u8] by language design).
//
// `let a: PkdArray<u64>` → FSE; `let a: PkdArray<str>` → VLE. The bound set
// IS the family selector — no shape spelling at use sites.
package memoria.pkd;

use logos.lang.marker;
use logos.lang.result;   // Result/PkdError plumbing
use logos.lang.slice;    // slice_from_raw (EntryBytes for [E])
use logos.lang.panic;    // assert (index contract)    // Fst, StableLayout, SelfDescribing
use logos.lang.mem;

// ── the VLE entry contract ──────────────────────────────────────────────────

/// Byte view of a variable-length entry: any `T` whose `&T` exposes its
/// bytes AS A SAFE SLICE — the length travels inside `&[u8]`, so a lying
/// implementation can at worst mis-slice its OWN bytes, never induce an
/// out-of-bounds copy in the array (that is what lets `insert`/`push` be
/// SAFE fns). `str` and `[E]` are the built-in entry shapes; custom
/// var-len element types opt in by implementing it.
pub trait EntryBytes {
    fn entry_bytes(self: &Self) -> &[u8];
}

// NOTE: no separate `impl EntryBytes for str` — str ≡ [u8] by language
// design, so the [E] impl below IS the str impl (a second one would be a
// coherence overlap and confuses slice-receiver dispatch).
impl<E: Copy + Fst + StableLayout> EntryBytes for [E] {
    fn entry_bytes(self: &[E]) -> &[u8] {
        // Pure-bytes elements (Copy + Fst + StableLayout): the reinterpret
        // is the impl's contract, contained here.
        return unsafe {
            slice_from_raw::<u8>(self.as_ptr(), self.len() * sizeof::<E>())
        };
    }
}

// ── VLE: the primary (any T that is NOT FSE-able) ───────────────────────────

/// A PkdAlloc with the 3-slot VLE convention. Single unsized "base" field —
/// the primary adds no data of its own (everything lives in slots), it adds
/// the vocabulary.
#[self_describing]
pub struct PkdArray<T: ?Sized> {
    alc: PkdAlloc,
}

impl<T: ?Sized> SelfDescribing for PkdArray<T> {
    fn dst_len(self: *const PkdArray<T>) -> i64 {
        return unsafe { (*self).alc.dst_len() };
    }
}

impl<T: ?Sized> PkdArray<T> {
    // The 3-slot VLE convention (private vocabulary of this impl).
    const SLOT_CNT:  u32 = 0u32;
    const SLOT_OFFS: u32 = 1u32;
    const SLOT_DATA: u32 = 2u32;
    const SLOTS:     u32 = 3u32;

    /// Formats slot `idx` of `alc` as an empty VLE array.
    pub unsafe fn format(alc: *mut PkdAlloc, idx: u32)
        -> Result<*mut PkdArray<T>, PkdError> {
        let inner = alc.allocate_nested(idx, PkdArray::SLOTS, 16)?;
        inner.allocate_cell::<u32>(PkdArray::SLOT_CNT, 0)?;
        inner.allocate_cell::<u32>(PkdArray::SLOT_OFFS, 0)?;   // offs[0] = 0
        return Result::Ok(inner as *mut PkdArray<T>);
    }

    /// The embedded allocator (same address — the base view).
    unsafe fn a(self: &PkdArray<T>) -> *mut PkdAlloc {
        let sp: *const PkdArray<T> = self as *const PkdArray<T>;
        return sp as *mut PkdAlloc;
    }

    /// SAFE: a well-formed `&PkdArray<T>` implies a formatted block.
    pub fn count(self: &PkdArray<T>) -> u32 {
        return self.alc.cells::<u32>(PkdArray::SLOT_CNT)[0];
    }
    fn set_count(self: &mut PkdArray<T>, n: u32) {
        let c: &mut [u32] = self.alc.cells_mut::<u32>(PkdArray::SLOT_CNT);
        c[0] = n;
    }
    /// The offsets table view (count+1 valid cells; borrow-tied to self).
    fn offs(self: &PkdArray<T>) -> &[u32] {
        return self.alc.cells::<u32>(PkdArray::SLOT_OFFS);
    }
    unsafe fn off(self: &PkdArray<T>, k: u32) -> u32 {
        let t: *mut u32 = self.a().get::<u32>(PkdArray::SLOT_OFFS);
        return *t.add(k);
    }

    /// Entry `i` as raw bytes: (pointer into the block, byte length). Valid
    /// only until the next mutation of the containing block.
    pub unsafe fn entry(self: &PkdArray<T>, i: u32) -> (*const u8, i64) {
        let o: u32 = self.off(i);
        let e: u32 = self.off(i + 1);
        let d: *mut u8 = self.a().get::<u8>(PkdArray::SLOT_DATA);
        return (d.byte_add(o) as *const u8, (e - o) as i64);
    }

    /// Inserts `*src` as entry `i` (0 ≤ i ≤ count; out of range panics —
    /// a programming error, not an environment one). Slot-wise exact growth
    /// through the allocator chain; Err(OutOfMem) when the chain can't.
    ///
    /// NO unsafe — the phase discipline the borrow checker enforces:
    /// resizes first (no views live), views after (each view borrows the
    /// allocator, so a resize while one is live does not compile). The
    /// entry's length rides the safe `&[u8]`; `src` aliasing `*self` is
    /// rejected by borrowck (`&mut self` vs `&T`); a well-formed
    /// `&mut PkdArray<T>` implies a formatted block (the unsafe was spent
    /// materializing it); growth never moves SELF, only later siblings.
    pub fn insert(self: &mut PkdArray<T>, i: u32, src: &T)
        -> Result<(), PkdError> where T: EntryBytes {
        let bytes: &[u8] = src.entry_bytes();
        let len: u32 = bytes.len() as u32;
        let cnt = self.count();
        assert(i <= cnt, "PkdArray::insert: index out of range");
        let dn = self.offs()[cnt];                     // used data bytes
        // phase 1 — resizes: grow OFFS to (count+2) cells, DATA by len
        self.alc.resize_block_at(PkdArray::SLOT_OFFS, (cnt + 2) * 4)?;
        self.alc.resize_block_at(PkdArray::SLOT_DATA, dn + len)?;
        // phase 2 — data view: shift the tail [at, dn) up by len, place the
        // entry (offset VALUES survive the resizes; only payloads shifted)
        let at = self.offs()[i];
        let d: &mut [u8] = self.alc.data_mut(PkdArray::SLOT_DATA);
        slice_copy_within(d, at, dn, at + len);
        slice_copy_from(slice_get_range_mut(d, at, at + len), bytes);
        // phase 3 — offs view: new offs[k] = old offs[k−1] + len for
        // k ∈ [i+2..cnt+1] (descending — reads stay ahead of writes),
        // then offs[i+1] = entry end
        let o: &mut [u32] = self.alc.cells_mut::<u32>(PkdArray::SLOT_OFFS);
        let mut k: u32 = cnt;
        while k > i {
            o[k + 1u32] = o[k] + len;
            k = k - 1u32;
        }
        o[i + 1u32] = at + len;
        self.set_count(cnt + 1);
        return Result::Ok(());
    }

    /// Appends `*src`. SAFE — see insert.
    pub fn push(self: &mut PkdArray<T>, src: &T)
        -> Result<(), PkdError> where T: EntryBytes {
        let at = self.count();
        return self.insert(at, src);
    }

    /// Entry `i` as a byte view — borrow-tied to self: alive views block
    /// every mutation of the array (the graceful form of `entry`).
    pub fn get_bytes(self: &PkdArray<T>, i: u32) -> &[u8] {
        assert(i < self.count(), "PkdArray::get_bytes: index out of range");
        let o = self.offs()[i];
        let e = self.offs()[i + 1u32];
        return slice_get_range(self.alc.data(PkdArray::SLOT_DATA), o, e);
    }

    /// Removes entry `i`, shrinking both slots to exact fit. NO unsafe —
    /// same phase discipline as insert (here views first, resizes last).
    pub fn remove(self: &mut PkdArray<T>, i: u32) {
        let cnt = self.count();
        assert(i < cnt, "PkdArray::remove: index out of range");
        let o0 = self.offs()[i];
        let e = self.offs()[i + 1u32];
        let len = e - o0;
        let dn = self.offs()[cnt];
        // close the data gap
        let d: &mut [u8] = self.alc.data_mut(PkdArray::SLOT_DATA);
        slice_copy_within(d, e, dn, o0);
        // close the offs gap: new offs[k] = old offs[k+1] − len for k ∈ [i..cnt−1]
        // (ascending — cell k is written after cell k+1 was read)
        let o: &mut [u32] = self.alc.cells_mut::<u32>(PkdArray::SLOT_OFFS);
        let mut k: u32 = i;
        while k < cnt {
            o[k] = o[k + 1u32] - len;
            k = k + 1u32;
        }
        self.set_count(cnt - 1);
        // exact-fit shrink (best-effort; shrink auto-packs the container)
        let _ = self.alc.resize_block_at(PkdArray::SLOT_DATA, dn - len);
        let _ = self.alc.resize_block_at(PkdArray::SLOT_OFFS, cnt * 4);
    }
}

// ── FSE: the bound-discriminated spec (T: Copy + Fst + StableLayout) ────────

/// Header (8 bytes) + `count × T` inline. The B+tree node vocabulary.
#[self_describing]
pub struct PkdArray<T: Copy + Fst + StableLayout> {
    able:     PkdAllocatable,
    count:    u32,
    data:     [T],
}

impl<T: Copy + Fst + StableLayout> SelfDescribing for PkdArray<T> {
    fn dst_len(self: *const PkdArray<T>) -> i64 {
        return unsafe { (*self).count as i64 };
    }
}

/// sizeof the fixed header (the tail is not counted for a self-describing DST).
fn fse_hdr<T: Copy + Fst + StableLayout>() -> u32 {
    return sizeof::<PkdArray<T>>() as u32;
}

impl<T: Copy + Fst + StableLayout> PkdArray<T> {
    /// Formats slot `idx` of `alc` as an empty FSE array.
    pub unsafe fn format(alc: *mut PkdAlloc, idx: u32)
        -> Result<*mut PkdArray<T>, PkdError> {
        let p = alc.allocate(idx, fse_hdr::<T>(), SlotKind::Allocatable)?;
        return Result::Ok(p as *mut PkdArray<T>);
    }

    pub fn count(self: &PkdArray<T>) -> u32 { return self.count; }

    /// The allocator owning this array's block (back-ref chain root for
    /// self-growth; healed by the allocator on shifts).
    pub unsafe fn allocator(self: &PkdArray<T>) -> *mut PkdAlloc {
        return self.able.allocator();
    }

    /// Address of element `i` (raw view; valid until the next mutation of
    /// the containing block).
    unsafe fn at(self: &PkdArray<T>, i: u32) -> *mut T {
        let sp: *const PkdArray<T> = self as *const PkdArray<T>;
        let data: *mut T = (sp as *mut u8).byte_add(fse_hdr::<T>()) as *mut T;
        return data.add(i);
    }

    unsafe fn resize_self(self: &mut PkdArray<T>, new_size: u32)
        -> Result<(), PkdError> {
        let alc: *mut PkdAlloc = self.able.allocator();
        let sp: *mut PkdArray<T> = self as *mut PkdArray<T>;
        alc.resize_block(sp as *const u8, new_size)?;
        return Result::Ok(());
    }

    pub unsafe fn get(self: &PkdArray<T>, i: u32) -> T {
        return *self.at(i);
    }

    pub unsafe fn set(self: &PkdArray<T>, i: u32, v: T) {
        *self.at(i) = v;
    }

    /// Inserts `*src` at position `i` (0 ≤ i ≤ count). Exact-fit growth
    /// through the allocator chain.
    pub unsafe fn insert(self: &mut PkdArray<T>, i: u32, src: &T)
        -> Result<(), PkdError> {
        let esz: i64 = sizeof::<T>();
        let cnt = self.count();
        let need = fse_hdr::<T>() + ((cnt + 1) * esz) as u32;
        self.resize_self(need)?;
        let at: *mut T = self.at(i);
        move_bytes((at as *mut u8).byte_add(esz), at as *const u8,
                   (cnt - i) * esz);
        *at = *src;
        self.count = cnt + 1;
        return Result::Ok(());
    }

    /// Appends `*src`.
    pub unsafe fn push(self: &mut PkdArray<T>, src: &T) -> Result<(), PkdError> {
        let at = self.count();
        return self.insert(at, src);
    }

    /// Removes element `i`, shrinking to exact fit (shrink auto-packs the
    /// containing allocator).
    pub unsafe fn remove(self: &mut PkdArray<T>, i: u32) {
        let esz: i64 = sizeof::<T>();
        let cnt = self.count();
        let at: *mut T = self.at(i);
        move_bytes(at as *mut u8, (at as *const u8).byte_add(esz),
                   (cnt - i - 1) * esz);
        self.count = cnt - 1;
        let keep = fse_hdr::<T>() + ((cnt - 1) * esz) as u32;
        let _ = self.resize_self(keep);      // shrink is best-effort
    }

    /// Moves elements [mid..count) into `dst` (an EMPTY formatted FSE
    /// PkdArray<T> in another block); truncates self to [0..mid). The
    /// B+tree split primitive.
    pub unsafe fn split_into(self: &mut PkdArray<T>,
                             dst: *mut PkdArray<T>, mid: u32) -> Result<(), PkdError> {
        let esz: i64 = sizeof::<T>();
        let cnt = self.count();
        let moved = cnt - mid;
        let need = fse_hdr::<T>() + (moved * esz) as u32;
        dst.resize_self(need)?;
        move_bytes(dst.at(0) as *mut u8, self.at(mid) as *const u8,
                   moved * esz);
        dst.count = moved;
        self.count = mid;
        let keep = fse_hdr::<T>() + (mid * esz) as u32;
        let _ = self.resize_self(keep);      // shrink is best-effort
        return Result::Ok(());
    }
}

/// Tail-slice length through the LANGUAGE-level [T] tail: materializing the
/// fat `&PkdArray<u64>` from the thin pointer calls SelfDescribing::dst_len —
/// this observably pins the FAMILY-correct dst_len (FSE = count, not the VLE
/// twin's) to FSE instances (the ADR 0019 twin-routing regression).
/// (Concrete element type: the generic-tail-in-generic-body form is a known
/// open item on the no-unsafe worklist.)
pub unsafe fn fse_data_len_u64(a: *mut PkdArray<u64>) -> i64 {
    let p: *const PkdArray<u64> = a as *const PkdArray<u64>;
    return p.dst_len();
}

/// First position with element ≥ `key` in a SORTED PkdArray<u64>.
pub unsafe fn fse_lower_bound_u64(a: *mut PkdArray<u64>, key: u64) -> u32 {
    let mut lo: u32 = 0u32;
    let mut hi: u32 = a.count();
    while lo < hi {
        let mid: u32 = lo + (hi - lo) / 2u32;
        if a.get(mid) < key { lo = mid + 1u32; }
        else { hi = mid; }
    }
    return lo;
}
