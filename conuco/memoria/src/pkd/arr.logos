// memoria.pkd — PkdArr<T>: packed fixed-size-element array (the fse face of
// C++'s PackedDataTypeBuffer), an ALLOCATABLE packed structure: it AGGREGATES
// PkdAllocatable first and GROWS ITSELF through its own allocator
// (self.able.allocator().resize_block(self, …)) — no external orchestration,
// any nesting depth. Slot-order growth moves only LATER siblings, so `self`
// never moves during its own resize.
//
// Payload: PkdArr { able, count } + elements (count × sizeof(T)), 8-aligned
// header (8 bytes) so 8-byte T start aligned.
//
// Capacity policy: exact fit. Fullness is the CALLER's policy signal (a
// B+tree node that can't grow splits) — deliberate, keeps node-fill
// accounting deterministic.
package memoria.pkd;

pub struct PkdArr {
    pub able: PkdAllocatable,
    count:    u32,
}

const ARR_HDR: u32 = 8u32;

/// Formats slot `idx` of `alc` as an empty PkdArr (ALLOCATABLE); returns the
/// typed view, or null on OOM.
pub unsafe fn arr_format(alc: *mut PkdAlloc, idx: u32) -> *mut PkdArr {
    let p: *mut u8 = alc.allocate(idx, ARR_HDR, PKD_ALLOCATABLE);
    if (p as i64) == 0i64 { return 0i64 as *mut PkdArr; }
    return p as *mut PkdArr;    // count zero-filled by allocate
}

impl PkdArr {
    pub fn count(self: &PkdArr) -> u32 { return self.count; }

    unsafe fn elem_ptr<T>(self: &PkdArr, i: u32) -> *mut T {
        let sp: *const PkdArr = self;
        return ((sp as i64) + (ARR_HDR as i64)
                + (i as i64) * sizeof::<T>()) as *mut T;
    }

    /// Element `i` by value (no bounds check — callers hold the count).
    pub unsafe fn get<T>(self: &PkdArr, i: u32) -> T {
        return *self.elem_ptr::<T>(i);
    }

    /// Overwrites element `i`.
    pub unsafe fn set<T>(self: &mut PkdArr, i: u32, v: T) {
        *self.elem_ptr::<T>(i) = v;
    }

    // Grow/shrink my own block through MY allocator; false = OOM upstream.
    unsafe fn resize_self(self: &mut PkdArr, new_size: u32) -> bool {
        let alc: *mut PkdAlloc = self.able.allocator();
        let sp: *mut PkdArr = self;
        return alc.resize_block(sp as *const u8, new_size)
               != 0xFFFF_FFFFu32;
    }

    /// Inserts `v` at position `i` (0 ≤ i ≤ count), shifting the suffix.
    /// Grows exactly; false = no room anywhere up the allocator chain.
    pub unsafe fn insert<T>(self: &mut PkdArr, i: u32, v: T) -> bool {
        let sp: *mut PkdArr = self;
        let esz: i64 = sizeof::<T>();
        let cnt: u32 = sp.count();
        let need: u32 = ARR_HDR + (((cnt as i64) + 1i64) * esz) as u32;
        if !sp.resize_self(need) { return false; }
        let src: *mut T = sp.elem_ptr::<T>(i);
        move_bytes((((src as i64) + esz) as *mut u8), src as *const u8,
                   ((cnt - i) as i64) * esz);
        *src = v;
        sp.count = cnt + 1u32;
        return true;
    }

    /// Appends `v`.
    pub unsafe fn push<T>(self: &mut PkdArr, v: T) -> bool {
        let sp: *mut PkdArr = self;
        let at: u32 = sp.count();
        return sp.insert::<T>(at, v);
    }

    /// Removes position `i`, shrinking to exact fit.
    pub unsafe fn remove<T>(self: &mut PkdArr, i: u32) {
        let sp: *mut PkdArr = self;
        let esz: i64 = sizeof::<T>();
        let cnt: u32 = sp.count();
        let dst: *mut T = sp.elem_ptr::<T>(i);
        move_bytes(dst as *mut u8, (((dst as i64) + esz) as *const u8),
                   ((cnt - i - 1u32) as i64) * esz);
        sp.count = cnt - 1u32;
        let keep: u32 = ARR_HDR + (((cnt - 1u32) as i64) * esz) as u32;
        let _ = sp.resize_self(keep);
    }

    /// Moves elements [mid..count) into `dst` (an EMPTY formatted PkdArr,
    /// typically in another node block); truncates self to [0..mid). The
    /// B+tree split primitive. false = OOM growing dst.
    pub unsafe fn split_into<T>(self: &mut PkdArr, dst: *mut PkdArr, mid: u32) -> bool {
        let sp: *mut PkdArr = self;
        let esz: i64 = sizeof::<T>();
        let moved: u32 = sp.count() - mid;
        let need: u32 = ARR_HDR + ((moved as i64) * esz) as u32;
        if !dst.resize_self(need) { return false; }
        move_bytes((((dst as i64) + (ARR_HDR as i64)) as *mut u8),
                   sp.elem_ptr::<T>(mid) as *const u8,
                   (moved as i64) * esz);
        dst.count = moved;
        sp.count = mid;
        let keep: u32 = ARR_HDR + ((mid as i64) * esz) as u32;
        let _ = sp.resize_self(keep);
        return true;
    }

    /// First position with element ≥ `key` in a SORTED u64 array.
    pub unsafe fn lower_bound_u64(self: &PkdArr, key: u64) -> u32 {
        let mut lo: u32 = 0u32;
        let mut hi: u32 = self.count;
        while lo < hi {
            let mid: u32 = lo + (hi - lo) / 2u32;
            if self.get::<u64>(mid) < key { lo = mid + 1u32; }
            else { hi = mid; }
        }
        return lo;
    }
}
