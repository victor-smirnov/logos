// memoria.pkd — PkdFseArray<T>: the FIXED-SIZE-element packed array.
//
// Inheritance-by-first-field: FSE "inherits" from PkdAllocatable — its
// layout lives INLINE in the structure itself (header + elements right
// after), with no slot machinery at all. That is the FSE economy: one
// implicit "slot" of data, so no layout table, no bitmap, no per-slot
// alignment — just {able, count} + count × T. Contrast PkdVleArray
// (vle.logos), which inherits from PkdAlloc and lays itself out through
// the embedded allocator's slots.
//
// A real #[self_describing] DST: the typed [T] tail is a language-level
// field (dst_len = count), every reference form stays THIN, and the
// structure GROWS ITSELF through its own allocator back-ref (recursive
// enlarge, any nesting depth) — the resize protocol of alloc.logos.
//
// Element contract: Copy + Fst (no absolute refs, no Drop) + StableLayout
// (frozen repr) — pure relocatable bytes, enforced at the type level.
package memoria.pkd;

use logos.lang.marker;    // Fst, StableLayout, SelfDescribing
use logos.lang.mem;

/// Header (8 bytes) + `count × T` inline. The B+tree node vocabulary.
#[self_describing]
pub struct PkdFseArray<T: Copy + Fst + StableLayout> {
    pub able: PkdAllocatable,
    count:    u32,
    data:     [T],
}

impl<T: Copy + Fst + StableLayout> SelfDescribing for PkdFseArray<T> {
    fn dst_len(self: *const PkdFseArray<T>) -> i64 {
        return unsafe { (*self).count as i64 };
    }
}

/// sizeof the fixed header (the tail is not counted for a self-describing DST).
fn fse_hdr<T: Copy + Fst + StableLayout>() -> u32 {
    return sizeof::<PkdFseArray<T>>() as u32;
}

/// Formats slot `idx` of `alc` as an empty PkdFseArray<T>; null on OOM.
pub unsafe fn fse_format<T: Copy + Fst + StableLayout>(alc: *mut PkdAlloc, idx: u32)
    -> *mut PkdFseArray<T> {
    let p: *mut u8 = alc.allocate(idx, fse_hdr::<T>(), PKD_ALLOCATABLE);
    if (p as i64) == 0i64 { return 0i64 as *mut PkdFseArray<T>; }
    return p as *mut PkdFseArray<T>;
}

impl<T: Copy + Fst + StableLayout> PkdFseArray<T> {
    pub fn count(self: &PkdFseArray<T>) -> u32 { return self.count; }

    unsafe fn me(self: &PkdFseArray<T>) -> i64 {
        let sp: *const PkdFseArray<T> = self as *const PkdFseArray<T>;
        return sp as i64;
    }
    /// Address of element `i` (raw view; valid until the next mutation of
    /// the containing block).
    unsafe fn at(self: &PkdFseArray<T>, i: u32) -> *mut T {
        return (self.me() + (fse_hdr::<T>() as i64)
                          + (i as i64) * sizeof::<T>()) as *mut T;
    }

    unsafe fn resize_self(self: &mut PkdFseArray<T>, new_size: u32) -> bool {
        let alc: *mut PkdAlloc = self.able.allocator();
        let sp: *mut PkdFseArray<T> = self as *mut PkdFseArray<T>;
        return alc.resize_block(sp as *const u8, new_size) != 0xFFFF_FFFFu32;
    }

    pub unsafe fn get(self: &PkdFseArray<T>, i: u32) -> T {
        return *self.at(i);
    }
    pub unsafe fn set(self: &PkdFseArray<T>, i: u32, v: T) {
        *self.at(i) = v;
    }

    /// Inserts `v` at position `i` (0 ≤ i ≤ count). Exact-fit growth through
    /// the allocator chain; false = no room anywhere up the chain.
    pub unsafe fn insert(self: &mut PkdFseArray<T>, i: u32, v: T) -> bool {
        let sp: *mut PkdFseArray<T> = self as *mut PkdFseArray<T>;
        let esz: i64 = sizeof::<T>();
        let cnt: u32 = sp.count();
        let need: u32 = fse_hdr::<T>() + (((cnt as i64) + 1i64) * esz) as u32;
        if !sp.resize_self(need) { return false; }
        let at: i64 = sp.at(i) as i64;
        move_bytes((at + esz) as *mut u8, at as *const u8,
                   ((cnt - i) as i64) * esz);
        *(at as *mut T) = v;
        sp.count = cnt + 1u32;
        return true;
    }

    pub unsafe fn push(self: &mut PkdFseArray<T>, v: T) -> bool {
        let sp: *mut PkdFseArray<T> = self as *mut PkdFseArray<T>;
        let at: u32 = sp.count();
        return sp.insert(at, v);
    }

    /// Removes element `i`, shrinking to exact fit (shrink auto-packs the
    /// containing allocator).
    pub unsafe fn remove(self: &mut PkdFseArray<T>, i: u32) {
        let sp: *mut PkdFseArray<T> = self as *mut PkdFseArray<T>;
        let esz: i64 = sizeof::<T>();
        let cnt: u32 = sp.count();
        let at: i64 = sp.at(i) as i64;
        move_bytes(at as *mut u8, (at + esz) as *const u8,
                   ((cnt - i - 1u32) as i64) * esz);
        sp.count = cnt - 1u32;
        let keep: u32 = fse_hdr::<T>() + (((cnt - 1u32) as i64) * esz) as u32;
        let _ = sp.resize_self(keep);
    }

    /// Moves elements [mid..count) into `dst` (an EMPTY formatted
    /// PkdFseArray<T> in another block); truncates self to [0..mid).
    /// The B+tree split primitive.
    pub unsafe fn split_into(self: &mut PkdFseArray<T>,
                             dst: *mut PkdFseArray<T>, mid: u32) -> bool {
        let sp: *mut PkdFseArray<T> = self as *mut PkdFseArray<T>;
        let esz: i64 = sizeof::<T>();
        let cnt: u32 = sp.count();
        let moved: u32 = cnt - mid;
        let need: u32 = fse_hdr::<T>() + ((moved as i64) * esz) as u32;
        if !dst.resize_self(need) { return false; }
        move_bytes(dst.at(0u32) as *mut u8, sp.at(mid) as *const u8,
                   (moved as i64) * esz);
        dst.count = moved;
        sp.count = mid;
        let keep: u32 = fse_hdr::<T>() + ((mid as i64) * esz) as u32;
        let _ = sp.resize_self(keep);
        return true;
    }
}

/// First position with element ≥ `key` in a SORTED PkdFseArray<u64>.
pub unsafe fn fse_lower_bound_u64(a: *mut PkdFseArray<u64>, key: u64) -> u32 {
    let mut lo: u32 = 0u32;
    let mut hi: u32 = a.count();
    while lo < hi {
        let mid: u32 = lo + (hi - lo) / 2u32;
        if a.get(mid) < key { lo = mid + 1u32; }
        else { hi = mid; }
    }
    return lo;
}
