// memoria.ssrle — PkdSsrle: the packed SSRLE sequence over a PkdAlloc block
// (BTFL arc, increments 3-6: create/queries, the flat size/sum index, and
// two-phase mutations with split_to/merge_from).
//
// C++ oracle: containers/include/memoria/core/packed/sseq/packed_ssrle_seq.hpp
// (layout/init/sizing, compute_block_size :256, number_of_indexes :149) +
// packed_ssrle_seq_so.hpp (the op surface; access :139/do_access :1529,
// rank_fn :1194, select_fw_fn :1383 — each with an index fast path and a scan
// fallback; prepare/commit_insert :713/:751, prepare/commit_remove :818/:848,
// split_to :896, prepare/commit_merge_with :946/:962) +
// ssrleseq/ssrleseq_reindex_fn.hpp (the reindex walk).
//
// MUTATION DISCIPLINE (the C++ UpdateState two-phase, recon risk 3): plan_*
// builds the FULL post-op run vector out of block (decode → splice →
// compactify, exactly the C++ prepare_* shape) and prices it with
// pkd_ssrle_block_size; update_fits answers whether commit can succeed
// (in-block or through the parent chain); commit is INFALLIBLE by contract —
// its resizes are covered by the pricing (a failure there is a caller bug and
// asserts, the C++ MMA_PKD_OOM_SAFE assumption made loud).
//
// Block layout = the C++ 4-slot PackedAllocator convention (enum :105):
//
//   slot 0  METADATA    SsrleMeta cell (RAW)
//   slot 1  SIZE_INDEX  RAW u64[blocks]: per-index-block SYMBOL COUNTS
//   slot 2  SUM_INDEX   RAW u64[blocks × alphabet], block-major rows:
//                       cell[b·alphabet + s] = occurrences of symbol s among
//                       the runs of index block b
//   slot 3  SYMBOLS     RAW u16 code units (the increment-1 segment stream)
//
// An INDEX BLOCK covers AtomsPerBlock code units (= 256·Bps bytes). Runs never
// straddle a 64-byte segment, AtomsPerBlock is a multiple of the segment size,
// so every run belongs to exactly one index block and the stream cursor lands
// on every block boundary exactly (the reindex walk relies on this). Indexes
// are materialized only when code_units > AtomsPerBlock — below the threshold
// the slots have zero size and every query takes the scan path (the index is
// an accelerator, not a semantic layer).
//
// PORT DECISIONS (recon §7.2 + increments 1/5):
//   * AlphabetSize and Bps are RUNTIME metadata fields (C++ template
//     parameters); alphabet is primary, bps = BitsPerSymbol(alphabet)
//     (bitmap.hpp:1025). Use64BitSize=true ⇒ SeqSizeT = u64.
//   * SsrleMeta = C++ Metadata {size_, code_units_} + the two runtime
//     fields; the C++ `flags_` slot (write-only in the oracle) is dropped.
//   * The indexes are FLAT PREFIX-SEARCHABLE ARRAYS, not a port of the C++
//     PackedDataTypeBuffer sum-trees: per-block values, linear block locate
//     (blocks = code_units/AtomsPerBlock stays small at leaf scale). Because
//     the cells are raw u64 with NO PkdAllocatable header, the index slots
//     are stamped RAW — the C++ ALLOCATABLE stamp would make element moves
//     "heal" a back-reference that does not exist (layout divergence).
//   * Mutation scratch is OUT-OF-BLOCK (Vec) — the C++ UpdateState decodes
//     into std::vector too. set_runs runs in three phases: (1) encode the
//     stream and build the index buffers out of block; (2) the FALLIBLE
//     resize phase over all three slots, shrinks first (a shrink releases
//     the space the grows need; with the final total priced by
//     pkd_ssrle_block_size, every grow is then guaranteed); (3) infallible
//     fill + metadata. On resize failure the sequence is RESET TO EMPTY
//     (a shrink may already have truncated the old stream — the reset keeps
//     the block valid instead of torn; C++ just throws mid-way under its
//     MMA_PKD_OOM_SAFE assumption).
package memoria.ssrle;

use logos.mem.pkd;             // PkdAlloc, pkd_format, SlotKind, PkdError
use logos.lang.marker;         // StableLayout (Fst is auto)
use logos.lang.result;
use logos.lang.panic;
use logos.lang.clone;
use logos.mem.collections.vec;

// ── metadata ────────────────────────────────────────────────────────────────

/// The METADATA cell (C++ PkdSSRLESeq::Metadata :120, Use64BitSize=true).
/// 24 bytes, no padding, 8-aligned.
pub struct SsrleMeta {
    pub size: u64,          // logical symbol count (SeqSizeT)
    pub code_units: u64,    // used u16 units in SYMBOLS
    pub bps: u32,           // runtime BitsPerSymbol (C++ template param)
    pub alphabet_size: u32, // runtime AlphabetSize (C++ template param)
}

impl Copy for SsrleMeta {}

impl Clone for SsrleMeta {
    fn clone(&self) -> SsrleMeta {
        return *self;
    }
}

impl StableLayout for SsrleMeta {}

/// C++ BitsPerSymbol (bitmap.hpp:1025): alphabet ≤ 2 → 1, else Log2U(a−1).
pub fn ssrle_bps_for_alphabet(alphabet_size: u32) -> u32 {
    assert(alphabet_size >= 2u32 && alphabet_size <= 256u32, "pkd_ssrle: alphabet out of [2,256]");
    if alphabet_size <= 2u32 {
        return 1u32;
    }
    return (64u64 - (((alphabet_size - 1u32) as u64).leading_zeros() as u64)) as u32;
}

/// AtomsPerBlock for a runtime Bps (C++ :98-:100: BytesPerBlockBase=256,
/// BytesPerBlock = 256·Bps, atoms = bytes / sizeof(u16)) — the index
/// threshold: C++ builds indexes only when code_units exceeds this.
pub fn ssrle_atoms_per_block(bps: u32) -> u64 {
    return 256u64 * (bps as u64) / 2u64;
}

// ── block sizing (compute_size-driven; C++ compute_block_size :256) ─────────

/// Block bytes for an EMPTY sequence: allocator header/layout/bitmap for the
/// 4 slots + the metadata cell (C++ empty_size :339).
pub fn pkd_ssrle_empty_size() -> u32 {
    return PkdAlloc::empty_size_for(PkdSsrle::SLOTS)
        + round_up_bytes(sizeof::<SsrleMeta>() as u32);
}

/// Index blocks a stream of `code_units` units occupies (C++
/// number_of_indexes :149 in unit terms): 0 at or below the threshold, else
/// div_up. The reindex walk provably pushes exactly this many blocks.
pub fn pkd_ssrle_index_blocks(bps: u32, code_units: u64) -> u64 {
    let apb: u64 = ssrle_atoms_per_block(bps);
    if code_units <= apb {
        return 0u64;
    }
    return (code_units + apb - 1u64) / apb;
}

/// Block bytes for a sequence holding `code_units` u16 units, INCLUDING the
/// index slots the stream requires at that size (C++ compute_block_size :256:
/// metadata + size index + sum index + symbols). This is THE pricing function
/// commit-time resizes are guaranteed against.
pub fn pkd_ssrle_block_size(alphabet_size: u32, code_units: u64) -> u32 {
    let bps: u32 = ssrle_bps_for_alphabet(alphabet_size);
    let blocks: u64 = pkd_ssrle_index_blocks(bps, code_units);
    return pkd_ssrle_empty_size()
        + round_up_bytes((code_units * 2u64) as u32)
        + ((blocks * 8u64) as u32)
        + ((blocks * (alphabet_size as u64) * 8u64) as u32);
}

// ── the packed handle ───────────────────────────────────────────────────────

/// Select result: logical index + the rank PREFIX accumulated before the hit
/// run (C++ SelectResult :68 — on "not found" idx = size, rank = total).
pub struct SsrleSelect {
    pub idx: u64,
    pub rank: u64,
}

impl Copy for SsrleSelect {}

impl Clone for SsrleSelect {
    fn clone(&self) -> SsrleSelect {
        return *self;
    }
}

/// The out-of-block update state (C++ InsertStepUS :707 / RemoveStepUS :810 /
/// MergeWithUS :938 unified — every C++ step carries the same three fields):
/// the FULL post-op run vector plus its pricing. Produced by plan_*, consumed
/// by commit.
pub struct SsrleUpdate {
    pub runs: Vec<SsrleRun>,
    pub code_units: u64,
    pub block_size: u32,
}

/// Non-owning handle over a formatted PkdSsrle block (the VecCtr idiom:
/// views re-resolved through the allocator on every call; the block itself
/// never moves under the resize protocol).
pub struct PkdSsrle {
    mem: *mut u8,
}

impl Copy for PkdSsrle {}

impl Clone for PkdSsrle {
    fn clone(&self) -> PkdSsrle {
        return *self;
    }
}

/// Formats `mem[0..block_size)` as an EMPTY sequence (C++ init_bs :294):
/// 4 slots, metadata allocated, index + SYMBOLS slots stamped RAW at zero
/// size. DIVERGENCE from C++ (which stamps the index slots ALLOCATABLE for
/// its PackedDataTypeBuffer structures): the flat index arrays are plain u64
/// cells with no PkdAllocatable header, so the RAW stamp is the correct one —
/// an ALLOCATABLE stamp would corrupt cell 0 on every element shift.
pub unsafe fn pkd_ssrle_format(mem: *mut u8, block_size: u32, alphabet_size: u32)
    -> Result<PkdSsrle, PkdError> {
    let bps: u32 = ssrle_bps_for_alphabet(alphabet_size);
    let a: *mut PkdAlloc = pkd_format(mem, block_size, PkdSsrle::SLOTS);
    let meta: SsrleMeta = SsrleMeta {
        size: 0u64,
        code_units: 0u64,
        bps: bps,
        alphabet_size: alphabet_size,
    };
    a.allocate_cell::<SsrleMeta>(PkdSsrle::SLOT_METADATA, meta)?;
    a.set_block_type(PkdSsrle::SLOT_SIZE_INDEX, SlotKind::Raw);
    a.set_block_type(PkdSsrle::SLOT_SUM_INDEX, SlotKind::Raw);
    a.set_block_type(PkdSsrle::SLOT_SYMBOLS, SlotKind::Raw);
    return Result::Ok(PkdSsrle { mem: mem });
}

// ── the reindex walk (C++ ssrleseq_reindex_fn.hpp :53) ──────────────────────

// Close the current index block: push the accumulated size + rank row,
// reset the accumulators, advance the boundary.
fn index_push_block(
    sizes: &mut Vec<u64>,
    sums: &mut Vec<u64>,
    acc: &mut Vec<u64>,
    total: &mut u64,
    block_cnt: &mut u64,
    next_block: &mut u64,
    apb: u64,
) {
    sizes.push(*total);
    let alphabet: i64 = acc.length();
    let mut c: i64 = 0i64;
    while c < alphabet {
        sums.push(acc.get(c));
        acc.set(c, 0u64);
        c = c + 1i64;
    }
    *total = 0u64;
    *block_cnt = 0u64;
    *next_block = *next_block + apb;
}

/// Build the flat index buffers from an encoded unit stream — the ReindexFn
/// walk, step for step: data runs accumulate full_run_length into the size
/// row and run_length per pattern symbol into the rank row (:127-:135);
/// padding advances by its run_length; a block closes when the cursor lands
/// on a block boundary (:148) and the tail closes after the walk (:153).
/// `sizes` gains one u64 per block; `sums` gains `alphabet` u64 per block
/// (block-major rows).
fn ssrle_index_build(
    bps: u32,
    units: &[u16],
    limit: u64,
    alphabet: u64,
    apb: u64,
    sizes: &mut Vec<u64>,
    sums: &mut Vec<u64>,
) {
    let mut acc: Vec<u64> = vec_new::<u64>();
    let mut a: u64 = 0u64;
    while a < alphabet {
        acc.push(0u64);
        a = a + 1u64;
    }
    let mut total: u64 = 0u64;
    let mut block_cnt: u64 = 0u64;
    let mut next_block: u64 = apb;
    let mut idx: u64 = 0u64;
    let mut run: SsrleRun = ssrle_make_null();
    let mut going: bool = true;
    while going && idx < limit {
        let consumed: u64 = ssrle_decode_run_units(bps, units, idx, &mut run);
        if run.is_valid() {
            total = total + run.full_run_length();
            let plen: u64 = run.pattern_length as u64;
            let mut s: u64 = 0u64;
            while s < plen {
                let sym: i64 = run.pattern_symbol(bps, s) as i64;
                acc.set(sym, acc.get(sym) + run.run_length);
                s = s + 1u64;
            }
            block_cnt = block_cnt + 1u64;
            idx = idx + consumed;
        } else {
            if run.is_padding() {
                idx = idx + run.run_length;
            } else {
                // A null run inside [0, limit) — C++ pushes the open block
                // unconditionally and stops (:143). Well-formed streams end
                // exactly at limit and never take this branch.
                index_push_block(sizes, sums, &mut acc, &mut total,
                                 &mut block_cnt, &mut next_block, apb);
                going = false;
            }
        }
        if going && idx == next_block {
            index_push_block(sizes, sums, &mut acc, &mut total,
                             &mut block_cnt, &mut next_block, apb);
        }
    }
    if block_cnt > 0u64 {
        index_push_block(sizes, sums, &mut acc, &mut total,
                         &mut block_cnt, &mut next_block, apb);
    }
}

/// Re-adopt an ALREADY FORMATTED sequence block as a handle (the VecCtr
/// re-resolution idiom): packed payloads shift when sibling slots of the
/// containing allocator resize, so a consumer embedding a PkdSsrle inside a
/// larger PkdAlloc (the BTFL leaf) must re-resolve the handle from the slot
/// address on every call instead of caching it. `mem` must point at the
/// block a pkd_ssrle_format once initialized.
pub unsafe fn pkd_ssrle_adopt(mem: *mut u8) -> PkdSsrle {
    return PkdSsrle { mem: mem };
}

/// Format + set_runs in one step — create-from-runs over caller memory.
pub unsafe fn pkd_ssrle_create(
    mem: *mut u8,
    block_size: u32,
    alphabet_size: u32,
    runs: &Vec<SsrleRun>,
) -> Result<PkdSsrle, PkdError> {
    let mut seq: PkdSsrle = pkd_ssrle_format(mem, block_size, alphabet_size)?;
    seq.set_runs(runs)?;
    return Result::Ok(seq);
}

impl PkdSsrle {
    // The 4-slot convention (C++ enum METADATA..SYMBOLS :105).
    const SLOT_METADATA:   u32 = 0u32;
    const SLOT_SIZE_INDEX: u32 = 1u32;
    const SLOT_SUM_INDEX:  u32 = 2u32;
    const SLOT_SYMBOLS:    u32 = 3u32;
    const SLOTS:           u32 = 4u32;

    // ── views (re-resolved per call; never cached) ───────────────────────

    fn alc(self: &PkdSsrle) -> *mut PkdAlloc {
        return self.mem as *mut PkdAlloc;
    }

    unsafe fn meta(self: &PkdSsrle) -> *mut SsrleMeta {
        return self.alc().get::<SsrleMeta>(PkdSsrle::SLOT_METADATA);
    }

    // ── metadata accessors ───────────────────────────────────────────────

    /// Logical symbol count (C++ SO size :135).
    pub fn size(self: &PkdSsrle) -> u64 {
        unsafe {
            return (*self.meta()).size;
        }
    }

    /// Used u16 units in the SYMBOLS slot.
    pub fn code_units(self: &PkdSsrle) -> u64 {
        unsafe {
            return (*self.meta()).code_units;
        }
    }

    pub fn bps(self: &PkdSsrle) -> u32 {
        unsafe {
            return (*self.meta()).bps;
        }
    }

    pub fn alphabet_size(self: &PkdSsrle) -> u32 {
        unsafe {
            return (*self.meta()).alphabet_size;
        }
    }

    /// SYMBOLS slot capacity in u16 units (C++ symbols_block_size counts
    /// units too — element_size / sizeof(CodeUnitT)).
    pub fn symbols_block_units(self: &PkdSsrle) -> u64 {
        unsafe {
            return (self.alc().element_size(PkdSsrle::SLOT_SYMBOLS) as u64) / 2u64;
        }
    }

    /// Spare units in the SYMBOLS slot (C++ symbols_block_capacity :211).
    pub fn symbols_block_capacity(self: &PkdSsrle) -> u64 {
        return self.symbols_block_units() - self.code_units();
    }

    /// Code unit `i` — the raw stream cell (byte-identity gates read this).
    pub fn unit_at(self: &PkdSsrle, i: u64) -> u16 {
        assert(i < self.code_units(), "pkd_ssrle: unit index out of range");
        unsafe {
            let units: &[u16] = self.alc().cells::<u16>(PkdSsrle::SLOT_SYMBOLS);
            return units[i as i64];
        }
    }

    /// C++ has_size_index/has_sum_index/has_index (:175-:221): element size
    /// probes — true once reindex has materialized the flat arrays.
    pub fn has_size_index(self: &PkdSsrle) -> bool {
        unsafe {
            return self.alc().element_size(PkdSsrle::SLOT_SIZE_INDEX) > 0u32;
        }
    }

    pub fn has_sum_index(self: &PkdSsrle) -> bool {
        unsafe {
            return self.alc().element_size(PkdSsrle::SLOT_SUM_INDEX) > 0u32;
        }
    }

    pub fn has_index(self: &PkdSsrle) -> bool {
        return self.has_size_index() && self.has_sum_index();
    }

    /// The C++ index-materialization threshold (reindex_fn): true when the
    /// stream is long enough that reindex builds indexes.
    pub fn needs_index(self: &PkdSsrle) -> bool {
        return self.code_units() > ssrle_atoms_per_block(self.bps());
    }

    /// Materialized index blocks (0 when unindexed) — element-size derived,
    /// the flat-array analog of C++ size_index()->size().
    pub fn index_blocks(self: &PkdSsrle) -> u64 {
        unsafe {
            return (self.alc().element_size(PkdSsrle::SLOT_SIZE_INDEX) as u64) / 8u64;
        }
    }

    /// Symbol count of index block `b` (the SIZE_INDEX cell).
    pub fn index_size_at(self: &PkdSsrle, b: u64) -> u64 {
        assert(b < self.index_blocks(), "pkd_ssrle: index block out of range");
        unsafe {
            let cells: &[u64] = self.alc().cells::<u64>(PkdSsrle::SLOT_SIZE_INDEX);
            return cells[b as i64];
        }
    }

    /// Occurrences of `sym` within index block `b` (the SUM_INDEX cell).
    pub fn index_sum_at(self: &PkdSsrle, b: u64, sym: u64) -> u64 {
        assert(b < self.index_blocks(), "pkd_ssrle: index block out of range");
        assert(sym < self.alphabet_size() as u64, "pkd_ssrle: index symbol out of alphabet");
        unsafe {
            let cells: &[u64] = self.alc().cells::<u64>(PkdSsrle::SLOT_SUM_INDEX);
            return cells[(b * (self.alphabet_size() as u64) + sym) as i64];
        }
    }

    // ── create / rewrite ─────────────────────────────────────────────────

    // The fallible resize phase of set_runs: sizes all three data slots,
    // SHRINKS FIRST (releases the space the grows draw on — with the final
    // total priced by pkd_ssrle_block_size, the grows then cannot fail on an
    // adequately provisioned chain). No droppable locals live here, so `?`
    // is safe in this helper.
    fn resize_slots(self: &mut PkdSsrle, sym_bytes: u32, size_bytes: u32, sum_bytes: u32)
        -> Result<(), PkdError> {
        unsafe {
            let a: *mut PkdAlloc = self.alc();
            // shrink pass
            if size_bytes < a.element_size(PkdSsrle::SLOT_SIZE_INDEX) {
                a.resize_block_at(PkdSsrle::SLOT_SIZE_INDEX, size_bytes)?;
            }
            if sum_bytes < a.element_size(PkdSsrle::SLOT_SUM_INDEX) {
                a.resize_block_at(PkdSsrle::SLOT_SUM_INDEX, sum_bytes)?;
            }
            if sym_bytes < a.element_size(PkdSsrle::SLOT_SYMBOLS) {
                a.resize_block_at(PkdSsrle::SLOT_SYMBOLS, sym_bytes)?;
            }
            // grow pass
            if sym_bytes > a.element_size(PkdSsrle::SLOT_SYMBOLS) {
                a.resize_block_at(PkdSsrle::SLOT_SYMBOLS, sym_bytes)?;
            }
            if size_bytes > a.element_size(PkdSsrle::SLOT_SIZE_INDEX) {
                a.resize_block_at(PkdSsrle::SLOT_SIZE_INDEX, size_bytes)?;
            }
            if sum_bytes > a.element_size(PkdSsrle::SLOT_SUM_INDEX) {
                a.resize_block_at(PkdSsrle::SLOT_SUM_INDEX, sum_bytes)?;
            }
        }
        return Result::Ok(());
    }

    // The on-OOM total-failure reset: a failed grow after a completed shrink
    // would leave metadata pointing past the slot — reset to the canonical
    // EMPTY sequence instead (all resizes here are shrinks: infallible).
    fn reset_empty(self: &mut PkdSsrle) {
        unsafe {
            let m: *mut SsrleMeta = self.meta();
            (*m).size = 0u64;
            (*m).code_units = 0u64;
            let a: *mut PkdAlloc = self.alc();
            let _ = a.resize_block_at(PkdSsrle::SLOT_SYMBOLS, 0u32);
            let _ = a.resize_block_at(PkdSsrle::SLOT_SIZE_INDEX, 0u32);
            let _ = a.resize_block_at(PkdSsrle::SLOT_SUM_INDEX, 0u32);
        }
    }

    /// Rewrites the whole sequence from `runs` — the commit_insert shape
    /// (SO :751) followed by the reindex walk. Three phases (module header):
    /// out-of-block encode + index buffers; the fallible resize phase (on
    /// Err(OutOfMem) the sequence is reset to empty, never torn); infallible
    /// fill + metadata. Invalid (null/padding) source runs are skipped by
    /// writer and size oracle alike.
    pub fn set_runs(self: &mut PkdSsrle, runs: &Vec<SsrleRun>) -> Result<(), PkdError> {
        let bps: u32 = self.bps();
        let alphabet: u64 = self.alphabet_size() as u64;
        let apb: u64 = ssrle_atoms_per_block(bps);
        let code_units: u64 = ssrle_compute_size(bps, runs, 0u64);
        // Phase 1 — out of block: encode the stream, then walk it for the
        // index buffers (the reindex walk needs UNIT positions, which only
        // the encoded stream carries — the run vector has no padding info).
        let mut scratch: Vec<u16> = vec_new::<u16>();
        let mut i: u64 = 0u64;
        while i < code_units {
            scratch.push(0u16);
            i = i + 1u64;
        }
        let written: u64 = ssrle_write_segments(bps, runs, &mut scratch, 0u64);
        assert(written == code_units, "pkd_ssrle: writer diverged from compute_size");
        let mut sizes: Vec<u64> = vec_new::<u64>();
        let mut sums: Vec<u64> = vec_new::<u64>();
        if code_units > apb {
            ssrle_index_build(bps, scratch.as_slice(), code_units, alphabet, apb,
                              &mut sizes, &mut sums);
            assert((sizes.length() as u64) == pkd_ssrle_index_blocks(bps, code_units),
                   "pkd_ssrle: reindex walk diverged from index pricing");
        }
        let blocks: i64 = sizes.length();
        // Phase 2 — the fallible resizes. Explicit match, not `?`: an early
        // `?` return skips the drops of the live scratch/index vectors (the
        // drop-gap probe from the increment-3 report).
        let rr: Result<(), PkdError> = self.resize_slots(
            (code_units * 2u64) as u32,
            (blocks as u64 * 8u64) as u32,
            (blocks as u64 * alphabet * 8u64) as u32,
        );
        match rr {
            Result::Ok(_) => {}
            Result::Err(e) => {
                self.reset_empty();
                return Result::Err(e);
            }
        }
        // Phase 3 — infallible fill.
        unsafe {
            let a: *mut PkdAlloc = self.alc();
            // Fill the WHOLE symbols slot: stream first, zero the 8-align pad
            // tail (zero units decode as null runs = EOS; also keeps the slot
            // fully initialized).
            let cells: &mut [u16] = a.cells_mut::<u16>(PkdSsrle::SLOT_SYMBOLS);
            let ncells: i64 = cells.len();
            let mut c: i64 = 0i64;
            while c < ncells {
                if c < code_units as i64 {
                    cells[c] = scratch.get(c);
                } else {
                    cells[c] = 0u16;
                }
                c = c + 1i64;
            }
            if blocks > 0i64 {
                let size_cells: &mut [u64] = a.cells_mut::<u64>(PkdSsrle::SLOT_SIZE_INDEX);
                let mut b: i64 = 0i64;
                while b < blocks {
                    size_cells[b] = sizes.get(b);
                    b = b + 1i64;
                }
                let sum_cells: &mut [u64] = a.cells_mut::<u64>(PkdSsrle::SLOT_SUM_INDEX);
                let nsum: i64 = sums.length();
                let mut k: i64 = 0i64;
                while k < nsum {
                    sum_cells[k] = sums.get(k);
                    k = k + 1i64;
                }
            }
            let m: *mut SsrleMeta = self.meta();
            (*m).size = ssrle_count_symbols(runs);
            (*m).code_units = code_units;
        }
        return Result::Ok(());
    }

    /// The public reindex (C++ SO reindex :176, compactify=true): decode the
    /// slot stream, compactify, rewrite + rebuild the indexes. set_runs IS
    /// the rewrite machinery (the C++ skip-when-code_units-match shortcut is
    /// dropped: re-encoding an unchanged run vector is byte-identical by
    /// writer determinism).
    pub fn reindex(self: &mut PkdSsrle) -> Result<(), PkdError> {
        let bps: u32 = self.bps();
        let mut runs: Vec<SsrleRun> = self.as_runs();
        ssrle_compactify(bps, &mut runs);
        return self.set_runs(&runs);
    }

    // ── reading ──────────────────────────────────────────────────────────

    /// Decode the stream back to its run vector (C++ iterator().as_vector()).
    pub fn as_runs(self: &PkdSsrle) -> Vec<SsrleRun> {
        unsafe {
            let units: &[u16] = self.alc().cells::<u16>(PkdSsrle::SLOT_SYMBOLS);
            return ssrle_decode_runs_units(self.bps(), units, self.code_units());
        }
    }

    // ── index locate helpers (the flat-array walkers) ────────────────────

    // First index block b with pos < prefix(b) + sizes[b]; writes the size
    // prefix of the blocks before b (C++ SizeIndex find_fw_gt semantics as
    // used by do_access :1539 / rank_fn :1215 / find_run :1600). Requires
    // pos < size — the block always exists.
    unsafe fn idx_locate_pos(self: &PkdSsrle, pos: u64, prefix_out: &mut u64) -> u64 {
        let sizes: &[u64] = self.alc().cells::<u64>(PkdSsrle::SLOT_SIZE_INDEX);
        let n: i64 = sizes.len();
        let mut sum: u64 = 0u64;
        let mut b: i64 = 0i64;
        let mut going: bool = true;
        while going && b < n {
            let v: u64 = sizes[b];
            if pos < sum + v {
                going = false;
            } else {
                sum = sum + v;
                b = b + 1i64;
            }
        }
        assert(b < n, "pkd_ssrle: position beyond the size index");
        *prefix_out = sum;
        return b as u64;
    }

    // Σ of the `sym` rank column over index blocks [0, upto) (C++ RankEqFn
    // sum_fn :1058; upto = index_blocks() gives the whole-column total =
    // sum_all_fn :1062).
    unsafe fn idx_rank_prefix(self: &PkdSsrle, upto: u64, sym: u64) -> u64 {
        let alphabet: u64 = self.alphabet_size() as u64;
        let sums: &[u64] = self.alc().cells::<u64>(PkdSsrle::SLOT_SUM_INDEX);
        let mut acc: u64 = 0u64;
        let mut b: u64 = 0u64;
        while b < upto {
            acc = acc + sums[(b * alphabet + sym) as i64];
            b = b + 1u64;
        }
        return acc;
    }

    // ── queries (index fast path + scan fallback) ────────────────────────

    /// Symbol at logical position `pos` (C++ SO access :139 + do_access
    /// :1529: the size index narrows the scan to one index block; without an
    /// index the scan starts at unit 0).
    pub fn access(self: &PkdSsrle, pos: u64) -> u64 {
        assert(pos < self.size(), "pkd_ssrle: access out of range");
        let bps: u32 = self.bps();
        let limit: u64 = self.code_units();
        unsafe {
            let mut idx: u64 = 0u64;
            let mut sum: u64 = 0u64;
            if self.has_index() {
                let b: u64 = self.idx_locate_pos(pos, &mut sum);
                idx = b * ssrle_atoms_per_block(bps);
            }
            let units: &[u16] = self.alc().cells::<u16>(PkdSsrle::SLOT_SYMBOLS);
            let mut run: SsrleRun = ssrle_make_null();
            while ssrle_next_run(bps, units, limit, &mut idx, &mut run) {
                let len: u64 = run.full_run_length();
                if pos < sum + len {
                    return run.symbol(bps, pos - sum);
                }
                sum = sum + len;
            }
        }
        assert(false, "pkd_ssrle: invalid sequence (size beyond stream)");
        return 0u64;
    }

    /// Occurrences of `sym` in positions [0, pos) (C++ rank_fn :1194 with
    /// RankEqFn). pos = 0 short-circuits to 0; pos may equal size (indexed:
    /// answered entirely from the sum index, :1222). The index fast path
    /// locates the block holding `pos` and seeds the scan with the block
    /// prefixes (:1210); full runs accumulate full_rank_eq, the run holding
    /// `pos` contributes a partial rank_eq.
    pub fn rank_eq(self: &PkdSsrle, pos: u64, sym: u64) -> u64 {
        if pos == 0u64 {
            return 0u64;
        }
        assert(pos <= self.size(), "pkd_ssrle: rank position out of range");
        assert(sym < self.alphabet_size() as u64, "pkd_ssrle: rank symbol out of alphabet");
        let bps: u32 = self.bps();
        let limit: u64 = self.code_units();
        unsafe {
            let mut idx: u64 = 0u64;
            let mut size_sum: u64 = 0u64;
            let mut rank_sum: u64 = 0u64;
            if self.has_index() {
                if pos < self.size() {
                    let b: u64 = self.idx_locate_pos(pos, &mut size_sum);
                    idx = b * ssrle_atoms_per_block(bps);
                    rank_sum = self.idx_rank_prefix(b, sym);
                } else {
                    return self.idx_rank_prefix(self.index_blocks(), sym);
                }
            }
            let units: &[u16] = self.alc().cells::<u16>(PkdSsrle::SLOT_SYMBOLS);
            let mut run: SsrleRun = ssrle_make_null();
            let mut going: bool = true;
            while going && ssrle_next_run(bps, units, limit, &mut idx, &mut run) {
                let len: u64 = run.full_run_length();
                if pos < size_sum + len {
                    rank_sum = rank_sum + run.rank_eq(bps, pos - size_sum, sym);
                    going = false;
                } else {
                    size_sum = size_sum + len;
                    rank_sum = rank_sum + run.full_rank_eq(bps, sym);
                }
            }
            return rank_sum;
        }
    }

    /// Occurrences of `sym` in the whole sequence (C++ rank_eq(symbol) :292).
    pub fn rank_eq_all(self: &PkdSsrle, sym: u64) -> u64 {
        return self.rank_eq(self.size(), sym);
    }

    /// Position of the (rank+1)-th `sym` occurrence (C++ select_fw_fn :1383
    /// with SelectFwEqFn). The index fast path walks the `sym` rank column
    /// for the block where the cumulative rank passes `rank`, then seeds the
    /// scan with that block's prefixes (:1391); rank beyond the column total
    /// short-circuits to not-found (:1404). Found: idx = the position, rank
    /// = the rank PREFIX before the hit run. Not found: idx = size, rank =
    /// the total `sym` count.
    pub fn select_fw_eq(self: &PkdSsrle, rank: u64, sym: u64) -> SsrleSelect {
        assert(sym < self.alphabet_size() as u64, "pkd_ssrle: select symbol out of alphabet");
        let bps: u32 = self.bps();
        let limit: u64 = self.code_units();
        unsafe {
            let mut idx: u64 = 0u64;
            let mut size_sum: u64 = 0u64;
            let mut rank_sum: u64 = 0u64;
            if self.has_index() {
                let alphabet: u64 = self.alphabet_size() as u64;
                let blocks: u64 = self.index_blocks();
                {
                    let sums: &[u64] = self.alc().cells::<u64>(PkdSsrle::SLOT_SUM_INDEX);
                    let mut b: u64 = 0u64;
                    let mut going: bool = true;
                    while going && b < blocks {
                        let v: u64 = sums[(b * alphabet + sym) as i64];
                        if rank < rank_sum + v {
                            going = false;
                        } else {
                            rank_sum = rank_sum + v;
                            b = b + 1u64;
                        }
                    }
                    if b == blocks {
                        return SsrleSelect {
                            idx: self.size(),
                            rank: rank_sum,
                        };
                    }
                    let size_cells: &[u64] = self.alc().cells::<u64>(PkdSsrle::SLOT_SIZE_INDEX);
                    let mut i: u64 = 0u64;
                    while i < b {
                        size_sum = size_sum + size_cells[i as i64];
                        i = i + 1u64;
                    }
                    idx = b * ssrle_atoms_per_block(bps);
                }
            }
            let units: &[u16] = self.alc().cells::<u16>(PkdSsrle::SLOT_SYMBOLS);
            let mut run: SsrleRun = ssrle_make_null();
            while ssrle_next_run(bps, units, limit, &mut idx, &mut run) {
                let run_rank: u64 = run.full_rank_eq(bps, sym);
                if rank < rank_sum + run_rank {
                    let local: u64 = run.select_fw_eq(bps, rank - rank_sum, sym);
                    return SsrleSelect {
                        idx: local + size_sum,
                        rank: rank_sum,
                    };
                }
                rank_sum = rank_sum + run_rank;
                size_sum = size_sum + run.full_run_length();
            }
            return SsrleSelect {
                idx: self.size(),
                rank: rank_sum,
            };
        }
    }

    // ── the op-family queries (increment 7; C++ SO :185-:670) ────────────
    //
    // How every op derives from the per-symbol SUM rows (mirroring the C++
    // Rank*Fn::sum_fn / SelectFw*Fn::sum column loops :1077-:1380):
    //   EQ = column [sym]            NEQ = all columns − column [sym]
    //   LT = columns [0, sym)        LE = columns [0, sym]
    //   GT = columns (sym, alpha)    GE = columns [sym, alpha)
    // (C++ NEQ loops all columns skipping `sym` — the same sum as the
    // subtraction here.)

    // Σ over index blocks [b_lo, b_hi) of SUM columns [c_lo, c_hi) — the
    // flat-array form of the C++ column loops.
    unsafe fn idx_cols_sum(self: &PkdSsrle, b_lo: u64, b_hi: u64, c_lo: u64, c_hi: u64) -> u64 {
        let alphabet: u64 = self.alphabet_size() as u64;
        let sums: &[u64] = self.alc().cells::<u64>(PkdSsrle::SLOT_SUM_INDEX);
        let mut acc: u64 = 0u64;
        let mut b: u64 = b_lo;
        while b < b_hi {
            let mut c: u64 = c_lo;
            while c < c_hi {
                acc = acc + sums[(b * alphabet + c) as i64];
                c = c + 1u64;
            }
            b = b + 1u64;
        }
        return acc;
    }

    // The op-composed sum over index blocks [b_lo, b_hi) (the derivation
    // table above).
    unsafe fn idx_op_sum(self: &PkdSsrle, b_lo: u64, b_hi: u64, sym: u64, op: u32) -> u64 {
        let alphabet: u64 = self.alphabet_size() as u64;
        if op == SSRLE_OP_EQ {
            return self.idx_cols_sum(b_lo, b_hi, sym, sym + 1u64);
        }
        if op == SSRLE_OP_NEQ {
            return self.idx_cols_sum(b_lo, b_hi, 0u64, alphabet)
                - self.idx_cols_sum(b_lo, b_hi, sym, sym + 1u64);
        }
        if op == SSRLE_OP_LT {
            return self.idx_cols_sum(b_lo, b_hi, 0u64, sym);
        }
        if op == SSRLE_OP_LE {
            return self.idx_cols_sum(b_lo, b_hi, 0u64, sym + 1u64);
        }
        if op == SSRLE_OP_GT {
            return self.idx_cols_sum(b_lo, b_hi, sym + 1u64, alphabet);
        }
        assert(op == SSRLE_OP_GE, "pkd_ssrle: unknown op code");
        return self.idx_cols_sum(b_lo, b_hi, sym, alphabet);
    }

    /// Matches of (sym, op) in positions [0, pos) — C++ SO rank :185 /
    /// rank_fn :1194: index fast path + scan fallback. rank_eq above stays
    /// the EQ specialization (as in C++); the op path must answer
    /// identically at op=EQ — gate-checked.
    pub fn rank_op(self: &PkdSsrle, pos: u64, sym: u64, op: u32) -> u64 {
        if pos == 0u64 {
            return 0u64;
        }
        assert(pos <= self.size(), "pkd_ssrle: rank position out of range");
        assert(sym < self.alphabet_size() as u64, "pkd_ssrle: rank symbol out of alphabet");
        let bps: u32 = self.bps();
        let limit: u64 = self.code_units();
        unsafe {
            let mut idx: u64 = 0u64;
            let mut size_sum: u64 = 0u64;
            let mut rank_sum: u64 = 0u64;
            if self.has_index() {
                if pos < self.size() {
                    let b: u64 = self.idx_locate_pos(pos, &mut size_sum);
                    idx = b * ssrle_atoms_per_block(bps);
                    rank_sum = self.idx_op_sum(0u64, b, sym, op);
                } else {
                    return self.idx_op_sum(0u64, self.index_blocks(), sym, op);
                }
            }
            let units: &[u16] = self.alc().cells::<u16>(PkdSsrle::SLOT_SYMBOLS);
            let mut run: SsrleRun = ssrle_make_null();
            let mut going: bool = true;
            while going && ssrle_next_run(bps, units, limit, &mut idx, &mut run) {
                let len: u64 = run.full_run_length();
                if pos < size_sum + len {
                    rank_sum = rank_sum + run.rank_op(bps, pos - size_sum, sym, op);
                    going = false;
                } else {
                    size_sum = size_sum + len;
                    rank_sum = rank_sum + run.full_rank_op(bps, sym, op);
                }
            }
            return rank_sum;
        }
    }

    /// Matches in [start, end) (C++ SO rank :198 — the difference form).
    pub fn rank_op_range(self: &PkdSsrle, start: u64, end: u64, sym: u64, op: u32) -> u64 {
        assert(start <= end, "pkd_ssrle: rank range invalid");
        return self.rank_op(end, sym, op) - self.rank_op(start, sym, op);
    }

    /// Matches in the whole sequence (C++ SO rank :211).
    pub fn rank_op_all(self: &PkdSsrle, sym: u64, op: u32) -> u64 {
        return self.rank_op(self.size(), sym, op);
    }

    /// Per-symbol counts over positions [0, pos): a fresh alphabet-sized
    /// vector (C++ SO ranks :322 — the index seeds every column's block
    /// prefix, then the scan adds per-run full/partial counts).
    pub fn ranks(self: &PkdSsrle, pos: u64) -> Vec<u64> {
        assert(pos <= self.size(), "pkd_ssrle: ranks position out of range");
        let bps: u32 = self.bps();
        let alphabet: u64 = self.alphabet_size() as u64;
        let limit: u64 = self.code_units();
        let mut out: Vec<u64> = vec_new::<u64>();
        let mut a: u64 = 0u64;
        while a < alphabet {
            out.push(0u64);
            a = a + 1u64;
        }
        unsafe {
            let mut idx: u64 = 0u64;
            let mut size_sum: u64 = 0u64;
            if self.has_index() {
                if pos == self.size() {
                    // whole-stream answer straight off the SUM columns (the
                    // C++ find_fw_gt end-block path degenerates to this)
                    let blocks: u64 = self.index_blocks();
                    let mut s: u64 = 0u64;
                    while s < alphabet {
                        out.set(s as i64, self.idx_cols_sum(0u64, blocks, s, s + 1u64));
                        s = s + 1u64;
                    }
                    return out;
                }
                let b: u64 = self.idx_locate_pos(pos, &mut size_sum);
                idx = b * ssrle_atoms_per_block(bps);
                let mut s: u64 = 0u64;
                while s < alphabet {
                    out.set(s as i64, self.idx_cols_sum(0u64, b, s, s + 1u64));
                    s = s + 1u64;
                }
            }
            let units: &[u16] = self.alc().cells::<u16>(PkdSsrle::SLOT_SYMBOLS);
            let mut run: SsrleRun = ssrle_make_null();
            let mut going: bool = true;
            while going && ssrle_next_run(bps, units, limit, &mut idx, &mut run) {
                let len: u64 = run.full_run_length();
                if pos < size_sum + len {
                    run.ranks_up_to(bps, pos - size_sum, &mut out);
                    going = false;
                } else {
                    size_sum = size_sum + len;
                    run.full_ranks(bps, &mut out);
                }
            }
            return out;
        }
    }

    /// Position of the (rank+1)-th match (C++ SO select_fw :368 /
    /// select_fw_fn :1383). The index fast path is the SelectFwFnBase walk
    /// (:1270): first block whose cumulative op-sum passes `rank` (the EQ
    /// find_fw_ge is the same walk on one column — increment-5 note). Found:
    /// idx = the position, rank = the rank prefix before the hit run; not
    /// found: idx = size, rank = the op total.
    pub fn select_fw_op(self: &PkdSsrle, rank: u64, sym: u64, op: u32) -> SsrleSelect {
        assert(sym < self.alphabet_size() as u64, "pkd_ssrle: select symbol out of alphabet");
        let bps: u32 = self.bps();
        let limit: u64 = self.code_units();
        unsafe {
            let mut idx: u64 = 0u64;
            let mut size_sum: u64 = 0u64;
            let mut rank_sum: u64 = 0u64;
            if self.has_index() {
                let blocks: u64 = self.index_blocks();
                let mut b: u64 = 0u64;
                let mut walking: bool = true;
                while walking && b < blocks {
                    let v: u64 = self.idx_op_sum(b, b + 1u64, sym, op);
                    if rank < rank_sum + v {
                        walking = false;
                    } else {
                        rank_sum = rank_sum + v;
                        b = b + 1u64;
                    }
                }
                if b == blocks {
                    return SsrleSelect {
                        idx: self.size(),
                        rank: rank_sum,
                    };
                }
                let size_cells: &[u64] = self.alc().cells::<u64>(PkdSsrle::SLOT_SIZE_INDEX);
                let mut i: u64 = 0u64;
                while i < b {
                    size_sum = size_sum + size_cells[i as i64];
                    i = i + 1u64;
                }
                idx = b * ssrle_atoms_per_block(bps);
            }
            let units: &[u16] = self.alc().cells::<u16>(PkdSsrle::SLOT_SYMBOLS);
            let mut run: SsrleRun = ssrle_make_null();
            while ssrle_next_run(bps, units, limit, &mut idx, &mut run) {
                let run_rank: u64 = run.full_rank_op(bps, sym, op);
                if rank < rank_sum + run_rank {
                    let local: u64 = run.select_fw_op(bps, rank - rank_sum, sym, op);
                    return SsrleSelect {
                        idx: local + size_sum,
                        rank: rank_sum,
                    };
                }
                rank_sum = rank_sum + run_rank;
                size_sum = size_sum + run.full_run_length();
            }
            return SsrleSelect {
                idx: self.size(),
                rank: rank_sum,
            };
        }
    }

    /// select_fw_op over matches at positions ≥ `idx` only (C++ SO :449-:477
    /// — rank-rebase + dec_rank). FIXED C++ BUG: dec_rank subtracts the
    /// rebase from the result rank UNGUARDED (:72); when the found match sits
    /// in the same run as `idx`, the prefix rank is smaller than the rebase
    /// and the unsigned subtraction wraps (garbage; the BTFL shuttle only
    /// consumes the rank of NOT-FOUND results, which never wrap). Port
    /// clamps to 0 — "no whole matching runs skipped past idx". Not-found
    /// results are exact: rank = matches in [idx, size).
    pub fn select_fw_op_from(self: &PkdSsrle, idx: u64, rank: u64, sym: u64, op: u32) -> SsrleSelect {
        let rank_base: u64 = self.rank_op(idx, sym, op);
        let res: SsrleSelect = self.select_fw_op(rank + rank_base, sym, op);
        let mut adj: u64 = 0u64;
        if res.rank > rank_base {
            adj = res.rank - rank_base;
        }
        return SsrleSelect {
            idx: res.idx,
            rank: adj,
        };
    }

    /// The BTFL shuttle op (C++ SO select_fw_eq_nlt :494; SeqOpType::EQ_NLT,
    /// core/types.hpp:289): the (rank+1)-th `sym`, but with a HARD STOP at
    /// the first symbol of smaller value — whichever comes first wins. For
    /// sym == 0 there is nothing smaller: plain select_fw_eq.
    pub fn select_fw_eq_nlt(self: &PkdSsrle, rank: u64, sym: u64) -> SsrleSelect {
        let res_eq: SsrleSelect = self.select_fw_op(rank, sym, SSRLE_OP_EQ);
        if sym > 0u64 {
            let res_lt: SsrleSelect = self.select_fw_op(rank, sym, SSRLE_OP_LT);
            if res_lt.idx < res_eq.idx {
                return res_lt;
            }
        }
        return res_eq;
    }

    /// The from-idx EQ_NLT (C++ SO :480 — the shuttle's leaf call comes
    /// through select_fw(idx, rank, sym, op), bt_select_shuttle.hpp:114).
    pub fn select_fw_eq_nlt_from(self: &PkdSsrle, idx: u64, rank: u64, sym: u64) -> SsrleSelect {
        let res_eq: SsrleSelect = self.select_fw_op_from(idx, rank, sym, SSRLE_OP_EQ);
        if sym > 0u64 {
            let res_lt: SsrleSelect = self.select_fw_op_from(idx, rank, sym, SSRLE_OP_LT);
            if res_lt.idx < res_eq.idx {
                return res_lt;
            }
        }
        return res_eq;
    }

    /// Position of the (rank+1)-th match counting FROM THE END (C++ SO
    /// select_bw_* :509-:579: select_fw over the mirrored rank). Found: idx =
    /// the position, rank = the select_fw prefix; not found: idx = size,
    /// rank = the op total. FIXED C++ BUG: select_bw_gt/select_bw_ge (:557/
    /// :569) compute the total with rank_NEQ — a copy-paste from
    /// select_bw_neq; the eq/neq/lt/le forms and ALL from-idx forms
    /// (:604-:646) use the op's own rank. With symbols < sym present, the
    /// C++ gt-total overshoots and the mirrored select lands on a wrong
    /// position (or misreports the not-found total). Port uses the op's own
    /// total for every op — gate-checked by the reversed-stream symmetry law.
    pub fn select_bw_op(self: &PkdSsrle, rank: u64, sym: u64, op: u32) -> SsrleSelect {
        let size: u64 = self.size();
        let full_rank: u64 = self.rank_op(size, sym, op);
        if rank < full_rank {
            return self.select_fw_op(full_rank - rank - 1u64, sym, op);
        }
        return SsrleSelect {
            idx: size,
            rank: full_rank,
        };
    }

    /// select_bw over positions ≤ `idx` only (C++ SO :582-:646). Not found:
    /// idx = idx+1, rank = matches in [0, idx].
    pub fn select_bw_op_from(self: &PkdSsrle, idx: u64, rank: u64, sym: u64, op: u32) -> SsrleSelect {
        assert(idx < self.size(), "pkd_ssrle: select_bw position out of range");
        let full_rank: u64 = self.rank_op(idx + 1u64, sym, op);
        if rank < full_rank {
            return self.select_fw_op(full_rank - rank - 1u64, sym, op);
        }
        return SsrleSelect {
            idx: idx + 1u64,
            rank: full_rank,
        };
    }

    /// Consecutive `sym` occurrences starting at `idx` (C++ SO count_fw :653
    /// — rank_neq/select_fw_neq composition): 0 when seq[idx] ≠ sym; idx may
    /// equal size (empty tail → 0).
    pub fn count_fw(self: &PkdSsrle, idx: u64, sym: u64) -> u64 {
        let nr: u64 = self.rank_op(idx, sym, SSRLE_OP_NEQ);
        let next: SsrleSelect = self.select_fw_op(nr, sym, SSRLE_OP_NEQ);
        return next.idx - idx;
    }

    /// Consecutive `sym` occurrences ENDING at `idx` (inclusive; 0 when
    /// seq[idx] ≠ sym). FIXED C++ BUG (SO count_bw :660): C++ takes
    /// rank_neq over [0, idx) — never examining seq[idx] — and returns
    /// idx+1−next_idx, counting the blocking non-sym itself; its two
    /// branches disagree by one under any uniform reading (the reference
    /// model in ssrleseq_test_base.hpp:741 repeats the same composition, so
    /// the C++ suite cannot see it). Port: rank_neq over [0, idx], then the
    /// distance to the last non-sym — symmetric to count_fw under stream
    /// reversal, gate-checked by that law.
    pub fn count_bw(self: &PkdSsrle, idx: u64, sym: u64) -> u64 {
        assert(idx < self.size(), "pkd_ssrle: count_bw position out of range");
        let nr: u64 = self.rank_op(idx + 1u64, sym, SSRLE_OP_NEQ);
        if nr == 0u64 {
            return idx + 1u64;
        }
        let last: SsrleSelect = self.select_fw_op(nr - 1u64, sym, SSRLE_OP_NEQ);
        return idx - last.idx;
    }

    // ── two-phase mutations (C++ prepare/commit, SO :713-:979) ───────────

    // Price a finished post-op run vector into an update state.
    fn plan_runs(self: &PkdSsrle, runs: Vec<SsrleRun>) -> SsrleUpdate {
        let code_units: u64 = ssrle_compute_size(self.bps(), &runs, 0u64);
        let block_size: u32 = pkd_ssrle_block_size(self.alphabet_size(), code_units);
        return SsrleUpdate {
            runs: runs,
            code_units: code_units,
            block_size: block_size,
        };
    }

    /// PLAN inserting `src` at logical position `pos` (C++ prepare_insert
    /// :713: split_buffer + splice + compactify + compute_size; the range
    /// check :741 is an assert here).
    pub fn plan_insert(self: &PkdSsrle, pos: u64, src: &Vec<SsrleRun>) -> SsrleUpdate {
        assert(pos <= self.size(), "pkd_ssrle: insert position out of range");
        let cur: Vec<SsrleRun> = self.as_runs();
        let spliced: Vec<SsrleRun> = ssrle_seq_insert(self.bps(), &cur, pos, src);
        return self.plan_runs(spliced);
    }

    /// PLAN removing logical range [start, end) (C++ prepare_remove :818:
    /// remove_block + compactify + compute_size).
    pub fn plan_remove(self: &PkdSsrle, start: u64, end: u64) -> SsrleUpdate {
        assert(start <= end && end <= self.size(), "pkd_ssrle: remove range invalid");
        let cur: Vec<SsrleRun> = self.as_runs();
        let cut: Vec<SsrleRun> = ssrle_seq_remove(self.bps(), &cur, start, end);
        return self.plan_runs(cut);
    }

    /// PLAN absorbing `other` after self (C++ prepare_merge_with :946 —
    /// concatenate + compactify. DIRECTION NOTE: C++ merges self INTO other,
    /// the btree merge direction; the pkd-family convention here is
    /// merge_from — self ← self ++ other. Same concatenation either way).
    pub fn plan_merge(self: &PkdSsrle, other: &PkdSsrle) -> SsrleUpdate {
        assert(self.alphabet_size() == other.alphabet_size(),
               "pkd_ssrle: merge alphabet mismatch");
        let mut all: Vec<SsrleRun> = self.as_runs();
        let tail: Vec<SsrleRun> = other.as_runs();
        ssrle_runs_append(&mut all, &tail);
        ssrle_compactify(self.bps(), &mut all);
        return self.plan_runs(all);
    }

    /// Can `commit(us)` succeed? True when the priced block size fits the
    /// current block, or the parent chain can grow it (the C++
    /// inc_allocated budget answer, asked of the allocator directly).
    pub fn update_fits(self: &PkdSsrle, us: &SsrleUpdate) -> bool {
        unsafe {
            let a: *mut PkdAlloc = self.alc();
            let bs: u32 = a.block_size();
            if us.block_size <= bs {
                return true;
            }
            if a.has_allocator() {
                // headroom of the PARENT chain only (own free space is
                // already inside bs)
                let chain: u32 = a.total_free_space() - a.free_space();
                return chain >= us.block_size - bs;
            }
            return false;
        }
    }

    /// COMMIT a planned update (C++ commit_insert :751 / commit_remove :848
    /// / commit_merge_with :962 — rewrite + metadata + reindex, all of which
    /// set_runs is). Infallible by contract: the caller consulted
    /// update_fits; a resize failure here is a caller bug.
    pub fn commit(self: &mut PkdSsrle, us: &SsrleUpdate) {
        let r: Result<(), PkdError> = self.set_runs(&us.runs);
        match r {
            Result::Ok(_) => {}
            Result::Err(_) => {
                assert(false, "pkd_ssrle: commit failed — update_fits was not consulted");
            }
        }
    }

    // ── one-call conveniences (plan + fit check + commit) ────────────────

    /// Insert `src` at `pos`; Err(OutOfMem) leaves the sequence UNCHANGED.
    pub fn insert_runs(self: &mut PkdSsrle, pos: u64, src: &Vec<SsrleRun>) -> Result<(), PkdError> {
        let us: SsrleUpdate = self.plan_insert(pos, src);
        if !self.update_fits(&us) {
            return Result::Err(PkdError::OutOfMem);
        }
        self.commit(&us);
        return Result::Ok(());
    }

    /// Insert a flat symbol vector at `pos` (greedy-RLE packed, then the
    /// run-insert path).
    pub fn insert_symbols(self: &mut PkdSsrle, pos: u64, syms: &Vec<u64>) -> Result<(), PkdError> {
        if syms.length() == 0i64 {
            return Result::Ok(());
        }
        let runs: Vec<SsrleRun> = ssrle_runs_from_symbols(self.bps(), syms);
        return self.insert_runs(pos, &runs);
    }

    /// Remove logical range [start, end); Err(OutOfMem) leaves the sequence
    /// UNCHANGED. (A remove can still GROW the stream: cutting mid-run can
    /// split one run into pieces costing more units — C++ prepare_remove
    /// prices it for the same reason.)
    pub fn remove(self: &mut PkdSsrle, start: u64, end: u64) -> Result<(), PkdError> {
        if start == end {
            return Result::Ok(());   // C++ prepare_remove :844 no-step
        }
        let us: SsrleUpdate = self.plan_remove(start, end);
        if !self.update_fits(&us) {
            return Result::Err(PkdError::OutOfMem);
        }
        self.commit(&us);
        return Result::Ok(());
    }

    /// self ← self ++ other (see the plan_merge direction note);
    /// Err(OutOfMem) leaves both sequences unchanged. `other` is not
    /// modified — clearing/freeing it is the caller's (node's) move.
    pub fn merge_from(self: &mut PkdSsrle, other: &PkdSsrle) -> Result<(), PkdError> {
        let us: SsrleUpdate = self.plan_merge(other);
        if !self.update_fits(&us) {
            return Result::Err(PkdError::OutOfMem);
        }
        self.commit(&us);
        return Result::Ok(());
    }

    /// Move logical range [at, size) into `other` (C++ split_to :896: the
    /// found run RunTraits::split at the cut; left stays, right + tail go to
    /// `other`; BOTH sides reindexed with compactify — reindex() :929-:931).
    /// at == size is a no-op (C++ :900/:933); `other`'s prior content is
    /// replaced (C++ writes its stream and sets size absolutely). Err leaves
    /// a partial state only between the two writes — same exposure as the
    /// C++ mid-way throw; prepare-style pricing by the caller avoids it.
    pub fn split_to(self: &mut PkdSsrle, other: &mut PkdSsrle, at: u64) -> Result<(), PkdError> {
        assert(self.alphabet_size() == other.alphabet_size(),
               "pkd_ssrle: split alphabet mismatch");
        let size: u64 = self.size();
        assert(at <= size, "pkd_ssrle: split position out of range");
        if at == size {
            return Result::Ok(());
        }
        let bps: u32 = self.bps();
        let cur: Vec<SsrleRun> = self.as_runs();
        let mut left: Vec<SsrleRun> = vec_new::<SsrleRun>();
        let mut right: Vec<SsrleRun> = vec_new::<SsrleRun>();
        ssrle_seq_split(bps, &cur, at, &mut left, &mut right);
        ssrle_compactify(bps, &mut left);
        ssrle_compactify(bps, &mut right);
        // other first: if the right side cannot land, self is untouched
        let ro: Result<(), PkdError> = other.set_runs(&right);
        match ro {
            Result::Ok(_) => {}
            Result::Err(e) => {
                return Result::Err(e);
            }
        }
        // the left rewrite can exceed the old footprint by the split fringe
        // (one run may become two + padding) — priced Err, not assert
        let rs: Result<(), PkdError> = self.set_runs(&left);
        match rs {
            Result::Ok(_) => {}
            Result::Err(e) => {
                return Result::Err(e);
            }
        }
        return Result::Ok(());
    }

    // ── pricing for the BTFL leaf (the PkdArray estimate convention) ─────

    /// Block bytes this sequence needs AFTER inserting `src` at `pos` — the
    /// leaf sums (estimate − current block_size) across columns against its
    /// free space, like PkdArray::estimate_insert.
    pub fn estimate_insert(self: &PkdSsrle, pos: u64, src: &Vec<SsrleRun>) -> u32 {
        let us: SsrleUpdate = self.plan_insert(pos, src);
        return us.block_size;
    }

    /// Block bytes needed after absorbing `other` (PkdArray::estimate_merge
    /// twin).
    pub fn estimate_merge(self: &PkdSsrle, other: &PkdSsrle) -> u32 {
        let us: SsrleUpdate = self.plan_merge(other);
        return us.block_size;
    }
}
