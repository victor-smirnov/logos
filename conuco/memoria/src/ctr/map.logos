// memoria.ctr.map — the GENERIC ordered map as a LIBRARY declaration.
//
// Cross-module generic seam probe (the extern-template vs implicit-
// instantiation boundary): the declaration lives in THIS archive and, being
// generic, stops at Canon verdicts here — no code is generated on the
// library side. A consumer compiling against the binary module re-registers
// the declaration (CONTAINER_DEF_DONE pre-scan) and every CONCRETE
// instantiation it names (Map<u64,u64>, Map<u64,str>, …) is harvested and
// generated IN THE CONSUMER'S unit, in the consumer's package, with
// mangled type names (Map$G2$…Leaf/Branch/Tree + the Ctr handle).
package memoria.ctr.map;

use logos.lcm.canon.container_item;   // the `container` lowering handler
use logos.mem.pkd;                    // generated leaf/branch substrate
use logos.mem.bt.map;                 // Ctr trait (generated `impl Ctr` names it)

pub container Map<K, V> for u8 { kind ordered_map; entry { key: K, val: V } measure max(key); }
