// memoria.ctr.map — the GENERIC ordered map as a LIBRARY declaration.
//
// Cross-module generic seam (ADR 0021 Phase 4b): the declaration lives in
// THIS archive and lowers to its demand-path surface — the generic CFG const
// `MapCfg<K,V>` plus the transparent alias `Map<K,V> =
// ContainerType<MapCfg<K,V>>`. No code is generated on the library side. A
// consumer naming a concrete instantiation (`create_ctr::<Map<u64,u64>>`)
// re-resolves the alias RHS under its bindings; mono demands the concrete
// @hs and the metaclass factory generates the family in the CONSUMER's
// compile (package logos.gen, hash-keyed — instantiations of identical
// config unify across consumers by construction).
package memoria.ctr.map;

use logos.lcm.canon.container_item;   // the `container` lowering handler
use logos.mem.pkd;                    // generated leaf/branch substrate
use logos.mem.bt.map;                 // Ctr trait (generated `impl Ctr` names it)

pub container Map<K, V> for u8 { kind ordered_map; entry { key: K, val: V } measure max(key); }
