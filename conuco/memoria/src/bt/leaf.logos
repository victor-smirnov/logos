// memoria.bt.leaf — LeafU64: a CONCRETE columnar b+tree leaf (u64 key, u64
// value) validating the Node contract before it is lifted to metaprog
// generation (ADR 0020 Track B). Concrete on purpose — the generic PkdLeaf<K,V>
// hand-written path hit a generic-DST method-dispatch miscompile; the real
// Node is generated concrete per instantiation, so this is both the validation
// vehicle and the generator's template.
//
// Layout: one owned block (≤ MAX_BLOCK bytes), two sibling PkdArray columns —
// slot 0 keys, slot 1 vals. Node operations are memory-based, not fanout-based:
//   - admission guard: an entry larger than MAX_BLOCK/4 is rejected (bounds
//     entry size so a node always holds ≥ 4 entries — the tree stays balanced
//     and the insert-split recursion cannot degenerate).
//   - try_insert: sum the columns' estimate_insert deltas, compare to the
//     allocator's real free space; fits → insert (replace-on-hit, Map MAX),
//     else the caller splits and retries.
//   - split_into / merge_with: coordinate the split index / merge across BOTH
//     columns (FSE fast path = count/2; VLE would volume-balance — a later
//     variant).
package memoria.bt.leaf;

use logos.mem.pkd;          // PkdAlloc, PkdArray, PkdError
use memoria.bt.node;      // node_alloc / node_pkd / node_free (16-byte header)
use logos.lang.result;

/// Node block size (a container constant later; a fixed 4K for now).
pub const MAX_BLOCK: u32 = 4096u32;
/// Admission ceiling: no entry may exceed a quarter of the block.
pub const MAX_ENTRY: u32 = 1024u32;   // MAX_BLOCK / 4

pub struct LeafU64 {
    mem: *mut u8,
    cap: u32,
}


impl LeafU64 {
    const SLOT_KEYS: u32 = 0u32;
    const SLOT_VALS: u32 = 1u32;

    /// A fresh empty leaf over one owned block (header + two empty columns),
    /// stamped with the creating snapshot id (0 = the pre-snapshot default).
    pub static fn new() -> LeafU64 { return LeafU64::new_in(0u64); }
    /// As `new`, stamping the block with snapshot id `snp` (the CoW skip key).
    pub static fn new_in(snp: u64) -> LeafU64 {
        unsafe {
            let base: *mut u8 = node_alloc(MAX_BLOCK, 2u32, snp);
            let a: *mut PkdAlloc = node_pkd(base);
            match PkdArray::<u64>::format(a, 0u32) {
                Result::Ok(_p) => {} Result::Err(_e) => { assert(false, "LeafU64::new keys"); }
            }
            match PkdArray::<u64>::format(a, 1u32) {
                Result::Ok(_p) => {} Result::Err(_e) => { assert(false, "LeafU64::new vals"); }
            }
            return LeafU64 { mem: base, cap: MAX_BLOCK };
        }
    }

    /// A NON-owning handle over an existing leaf block. Nodes are tree-managed:
    /// a parent BranchNode stores child block addresses and hands them out as
    /// adopted handles for operations; freeing is the owner's job (see `free`).
    /// This is the block-id/arena lifecycle, not RAII-per-node (ADR 0020).
    pub static fn adopt(mem: *mut u8) -> LeafU64 {
        return LeafU64 { mem: mem, cap: unsafe { (*node_pkd(mem)).block_size() } };
    }
    /// The raw block address — what a parent stores to reach this child.
    pub fn block(self: &LeafU64) -> *mut u8 { return self.mem; }
    /// Releases the owned block. Call exactly once, by the owner.
    pub fn free(self: LeafU64) { unsafe { node_free(self.mem); } }

    /// A private copy of this leaf on a fresh block stamped snapshot id `snp`
    /// (CoW duplication). Same entries; a leaf has no children, so nothing to
    /// share. The caller owns the copy (rc = 1).
    pub fn cow_clone(self: &LeafU64, snp: u64) -> LeafU64 {
        let mut c: LeafU64 = LeafU64::new_in(snp);
        let n: u32 = self.count();
        let mut i: u32 = 0u32;
        while i < n {
            let _ = c.try_insert(self.key_at(i), self.val_at(i));
            i = i + 1u32;
        }
        return c;
    }

    unsafe fn a(self: &LeafU64) -> *mut PkdAlloc { return node_pkd(self.mem); }
    unsafe fn keys(self: &LeafU64) -> *mut PkdArray<u64> {
        return self.a().get::<PkdArray<u64>>(LeafU64::SLOT_KEYS);
    }
    unsafe fn vals(self: &LeafU64) -> *mut PkdArray<u64> {
        return self.a().get::<PkdArray<u64>>(LeafU64::SLOT_VALS);
    }

    pub fn count(self: &LeafU64) -> u32 { return unsafe { (*self.keys()).count() }; }
    pub fn key_at(self: &LeafU64, i: u32) -> u64 { return unsafe { (*self.keys()).get(i) }; }
    pub fn val_at(self: &LeafU64, i: u32) -> u64 { return unsafe { (*self.vals()).get(i) }; }
    /// The node's separator key (max of child) — the last, sorted, key.
    pub fn max_key(self: &LeafU64) -> u64 {
        let n: u32 = self.count();
        assert(n > 0u32, "LeafU64::max_key: empty node");
        return self.key_at(n - 1u32);
    }

    /// First index with keys[i] >= key (linear scan; binary search later).
    pub fn lower_bound(self: &LeafU64, key: u64) -> u32 {
        let n: u32 = self.count();
        let mut i: u32 = 0u32;
        while i < n {
            if self.key_at(i) >= key { return i; }
            i = i + 1u32;
        }
        return n;
    }

    /// Admission + fit-checked insert (Map MAX semantics: an existing key is
    /// overwritten in place, never grows the node). Returns false when the
    /// entry doesn't fit — the caller then splits and retries. u64/u64 entries
    /// are 16 bytes, always under MAX_ENTRY, but the guard is enforced for
    /// contract fidelity.
    pub fn try_insert(self: &mut LeafU64, key: u64, val: u64) -> bool {
        // Admission guard: a fixed u64 key + u64 val = 16 bytes.
        let entry: u32 = 8u32 + 8u32;
        if entry > MAX_ENTRY { return false; }   // rejected (too large)
        unsafe {
            let pos: u32 = self.lower_bound(key);
            // Replace-on-hit: overwrite, no growth, always "fits".
            if pos < self.count() && self.key_at(pos) == key {
                (*self.vals()).set(pos, val);
                return true;
            }
            // Fit-check: the two columns' growth vs the block's free space.
            let dk: u32 = (*self.keys()).estimate_insert(8u32)
                        - self.a().element_size(LeafU64::SLOT_KEYS);
            let dv: u32 = (*self.vals()).estimate_insert(8u32)
                        - self.a().element_size(LeafU64::SLOT_VALS);
            if dk + dv > self.a().free_space() { return false; }   // full → split
            match (*self.keys()).insert(pos, &key) {
                Result::Ok(_u) => {} Result::Err(_e) => { return false; }
            }
            match (*self.vals()).insert(pos, &val) {
                Result::Ok(_u) => {} Result::Err(_e) => { return false; }
            }
            return true;
        }
    }

    /// Would merging `other` into self fit within this block?
    pub fn can_merge_with(self: &LeafU64, other: &LeafU64) -> bool {
        unsafe {
            let dk: u32 = (*self.keys()).estimate_merge(&*other.keys())
                        - self.a().element_size(LeafU64::SLOT_KEYS);
            let dv: u32 = (*self.vals()).estimate_merge(&*other.vals())
                        - self.a().element_size(LeafU64::SLOT_VALS);
            return dk + dv <= self.a().free_space();
        }
    }

    /// Appends all of `other`'s entries (self += other). Caller checks fit via
    /// can_merge_with first. `other`'s keys must all sort after self's.
    pub fn merge_with(self: &mut LeafU64, other: &LeafU64) {
        unsafe {
            let _ = (*self.keys()).merge_from(&*other.keys());
            let _ = (*self.vals()).merge_from(&*other.vals());
        }
    }

    /// Splits the tail [at..count) into `dst` (a fresh empty leaf), truncating
    /// self to [0..at). Both columns split at the SAME index — the parallel
    /// invariant. FSE-only → `at = count/2` (count-balanced ≡ volume-balanced
    /// for fixed size); a VLE column would search a volume-balanced index.
    pub fn split_into(self: &mut LeafU64, dst: &mut LeafU64) {
        let at: u32 = self.count() / 2u32;
        unsafe {
            let _ = (*self.keys()).split_into(&mut *dst.keys(), at);
            let _ = (*self.vals()).split_into(&mut *dst.vals(), at);
        }
    }
}

