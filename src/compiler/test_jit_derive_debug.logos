// Phase 7 slice 16: emit a real `impl Trait for Type { ... }` block
// from a metaprog hook. Handler fires per #[derive_debug] item; reads
// NAME via tiny_map_get; emits the impl into the *same* package as
// the type (orphan rule + name-resolution constraint). Test asserts
// the mangled `<Name>__dbg` symbol appears in the linked object.
//
// Direct call from user code in the same compilation unit is *not*
// possible yet — sema iter 0 must succeed before hooks fire, so a
// `widget.dbg(buf)` reference would error before the impl appears.
// That's a Phase 7 follow-up (pre-sema-style timing or two-phase sema).
package main;

use std.hermes.view;
use std.hermes.anyval;
use std.hermes.string;
use std.compiler.metaprog;
use std.fmt;
use std.lang.text;
use std.io;

#[metaprog_handler("derive_debug")]
fn derive_debug_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: AnyVal = AnyVal::from_offset(target_offset);
    let name_val: AnyVal = view.tiny_map_get(item, 1 as u8);
    let name: StringView = view.get_str_view(name_val);
    if name.len == (0 as u64) { return; }

    let mut em: Emitter = Emitter::new();
    em.emit_raw("package main;");
    em.emit_raw("use std.fmt;");
    em.emit_raw("use std.lang.text;");

    em.buf.push_str("impl Debug for ");
    unsafe { em.buf.push_bytes(name.ptr, name.len as i64); }
    em.buf.push_str(" {");
    em.buf.push_u8(10 as u8);

    em.buf.push_str("    fn dbg(self: ");
    unsafe { em.buf.push_bytes(name.ptr, name.len as i64); }
    em.buf.push_str(", buf: &mut String) {");
    em.buf.push_u8(10 as u8);

    em.buf.push_str("        buf.push_str(\"");
    unsafe { em.buf.push_bytes(name.ptr, name.len as i64); }
    em.buf.push_str("\");");
    em.buf.push_u8(10 as u8);

    em.buf.push_str("    }");
    em.buf.push_u8(10 as u8);
    em.buf.push_str("}");
    em.commit();
    return;
}

#[derive_debug]
struct Widget { x: i32 }

fn main() -> i32 { return 0; }
