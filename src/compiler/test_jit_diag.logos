// Phase 7 diagnostics: hook reports a structured error via
// metaprog::error(). Compilation must fail and the message must
// surface attributed to the hook name.
package main;
use std.compiler.metaprog;

#[metaprogram_post_sema]
pub fn complain() {
    error("schema not supported");
}

pub fn main() -> i32 { return 0 as i32; }
