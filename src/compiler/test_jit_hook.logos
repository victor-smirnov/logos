package test;

// Phase 7 slice 3a: hook calls `logos_get_module_ast` to obtain a fat
// borrow (base+size) of the user's root document, then conditionally
// emits a marker fn iff the host returned a non-null base. Passing
// `nm output.o | grep root_seen` proves the host-call seam fired and
// the hook acted on its result.
extern fn logos_emit_source(src: *const u8) -> i32;
extern fn logos_get_module_ast(out_base: *mut *const u8, out_size: *mut u64) -> ();

#[metaprogram_post_sema]
fn my_hook() -> () {
    let mut base: *const u8 = 0 as *const u8;
    let mut size: u64 = 0;
    unsafe {
        logos_get_module_ast(&mut base as *mut *const u8,
                             &mut size as *mut u64);
    }
    if base != 0 as *const u8 {
        let src: str = "package test; pub fn root_seen() -> i32 { return 1; }";
        unsafe { logos_emit_source(src.as_ptr() as *const u8); }
    }
    return;
}

fn main() -> i32 {
    return 0;
}
