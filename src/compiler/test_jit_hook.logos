package test;

// Phase 7 slice 2: hook emits a real Logos source fragment that
// becomes a new top-level fn at iter 1. Host parses it, appends a
// fresh AST to `asts`, and dedups by source text — naive hook
// converges in 2 iters.
extern fn logos_emit_source(src: *const u8) -> i32;

#[metaprogram_post_sema]
fn my_hook() -> () {
    let src: str = "package test; pub fn metaprog_secret() -> i32 { return 99; }";
    unsafe { logos_emit_source(src.as_ptr() as *const u8); }
    return;
}

fn main() -> i32 {
    return 0;
}
