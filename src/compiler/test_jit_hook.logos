package test;

// Phase 7 slice 3b: hook actually walks the user's AST.
//   1. Get base+size via logos_get_module_ast (slice 3a).
//   2. Wrap in HermesView<'a> (sound for the hook frame —
//      asts[0] outlives every hook invocation).
//   3. Resolve root → TinyObjectMap (the MODULE node).
//   4. Read ITEMS (key=2) → ObjectArray; iterate.
//   5. Match each child by schema_type_code = schema::ast(FN)
//      (CAT_AST = 1<<48, FN = 10 — see ast.hpp + schema_codes.hpp).
//   6. If at least one FN was seen, emit a marker fn so the test
//      harness can prove the walk fired (`nm | grep ast_walk_ok`).

use std.hermes.view;
use std.hermes.anyval;
use std.hermes.map;

extern fn logos_emit_source(src: *const u8) -> i32;
extern fn logos_get_module_ast(out_base: *mut *const u8,
                               out_size: *mut u64) -> ();

#[metaprogram_post_sema]
fn my_hook() -> () {
    let mut base: *const u8 = 0 as *const u8;
    let mut size: u64 = 0;
    unsafe {
        logos_get_module_ast(&mut base as *mut *const u8,
                             &mut size as *mut u64);
    }
    if base == 0 as *const u8 { return; }

    let view: HermesView = HermesView { base: base, size: size };
    let root: AnyVal = view.root();
    unsafe {
        if !root.is_ptr() { return; }
        if root.is_null()  { return; }
    }

    let root_off: u32 = unsafe { root.as_offset() };
    let root_obj: *const Map<Bitmap, AnyVal> =
        ((base as i64) + (root_off as i64)) as *const Map<Bitmap, AnyVal>;

    let items: AnyVal = unsafe { root_obj.get(base, 2 as u8) };
    let n: u64 = view.array_len(items);

    let cat_ast_fn: u64 = ((1 as u64) << 48) | (10 as u64);

    let mut count: i64 = 0;
    let mut i: u64 = 0;
    while i < n {
        let it: AnyVal = view.array_get(items, i);
        unsafe {
            if it.is_ptr() && !it.is_null() {
                let it_off: u32 = it.as_offset();
                let it_obj: *const Map<Bitmap, AnyVal> =
                    ((base as i64) + (it_off as i64)) as *const Map<Bitmap, AnyVal>;
                let stc: u64 = it_obj.schema_type_code;
                if stc == cat_ast_fn { count = count + 1; }
            }
        }
        i = i + 1;
    }

    if count > 0 {
        // Build "package test; pub fn ast_walk_ok() -> i32 { return 1; }
        //       pub fn fn_count() -> i64 { return <N>; }" into a stack
        //  buffer with a hand-rolled itoa for <N>. We can't use std.fmt
        //  here because alloc/dealloc resolve to libc malloc/free, and
        //  the metaprog JIT does not yet bind process symbols.
        let mut buf: [u8; 256] = [0 as u8; 256];
        let prefix: str = "package test; pub fn ast_walk_ok() -> i32 { return 1; } pub fn fn_count() -> i64 { return ";
        let suffix: str = "; }";
        let mut p: i64 = 0;
        let mut k: i64 = 0;
        while k < prefix.len() {
            unsafe { buf[p] = prefix[k]; }
            p = p + 1;
            k = k + 1;
        }

        let mut digits: [u8; 22] = [0 as u8; 22];
        let mut dp: i64 = 0;
        let mut m: i64 = count;
        while m > 0 {
            digits[dp] = (m - (m / 10) * 10) as u8 + (48 as u8);
            m = m / 10;
            dp = dp + 1;
        }
        while dp > 0 {
            dp = dp - 1;
            unsafe { buf[p] = digits[dp]; }
            p = p + 1;
        }

        k = 0;
        while k < suffix.len() {
            unsafe { buf[p] = suffix[k]; }
            p = p + 1;
            k = k + 1;
        }
        unsafe { buf[p] = 0 as u8; }

        unsafe { logos_emit_source(&buf[0] as *const u8); }
    }
    return;
}

fn main() -> i32 {
    return 0;
}
