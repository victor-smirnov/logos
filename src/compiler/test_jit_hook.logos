package test;

// Phase 7 slice 3b: hook actually walks the user's AST.
//   1. Get base+size via logos_get_module_ast (slice 3a).
//   2. Wrap in HermesView<'a> (sound for the hook frame —
//      asts[0] outlives every hook invocation).
//   3. Resolve root → TinyObjectMap (the MODULE node).
//   4. Read ITEMS (key=2) → ObjectArray; iterate.
//   5. Match each child by schema_type_code = schema::ast(FN)
//      (CAT_AST = 1<<48, FN = 10 — see ast.hpp + schema_codes.hpp).
//   6. If at least one FN was seen, emit a marker fn so the test
//      harness can prove the walk fired (`nm | grep ast_walk_ok`).

use std.hermes.view;
use std.hermes.anyval;
use std.hermes.map;
use std.lang.text;
use std.fmt;
use std.compiler.metaprog;

extern fn logos_emit_source(src: *const u8) -> i32;

#[metaprogram_post_sema]
fn my_hook() -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let base: *const u8 = view.base;
    let root: AnyVal = view.root();
    unsafe {
        if !root.is_ptr() { return; }
        if root.is_null()  { return; }
    }

    let items: AnyVal = view.tiny_map_get(root, 2 as u8);
    let n: u64 = view.array_len(items);

    let cat_ast_fn: u64 = ((1 as u64) << 48) | (10 as u64);

    let mut count: i64 = 0;
    let mut i: u64 = 0;
    while i < n {
        let it: AnyVal = view.array_get(items, i);
        unsafe {
            if it.is_ptr() && !it.is_null() {
                let it_off: u32 = it.as_offset();
                let it_obj: *const Map<Bitmap, AnyVal> =
                    ((base as i64) + (it_off as i64)) as *const Map<Bitmap, AnyVal>;
                let stc: u64 = it_obj.schema_type_code;
                if stc == cat_ast_fn { count = count + 1; }
            }
        }
        i = i + 1;
    }

    if count > 0 {
        // Build the emitted source via std.fmt::format. This works because
        // the metaprog JIT enables process-symbol resolution (slice 5),
        // so libc malloc/free behind String/alloc resolve automatically.
        let mut src: String = unsafe {
            format::<i64>("package test; pub fn ast_walk_ok() -> i32 { return 1; } pub fn fn_count() -> i64 { return {}; }", count)
        };
        // logos_emit_source uses std::string(src) on the host side, so it
        // needs a NUL-terminator. String stores raw bytes without one.
        src.push_u8(0 as u8);
        unsafe { logos_emit_source(src.as_ptr() as *const u8); }
    }
    return;
}

fn main() -> i32 {
    return 0;
}
