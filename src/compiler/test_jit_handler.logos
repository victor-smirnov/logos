// Phase 7 slice 12: target-driven hook via #[metaprog_handler("trig")].
// Compiler walks user items, finds two #[derive_marker] structs, and
// invokes derive_marker_hook(target_offset) once per matching item.
// Each call reads the target's NAME field and emits
//   pub fn marker_<NAME>() -> i64 { return 1; }
// Test: nm out.o must show marker_Alpha and marker_Bravo.
package test;

use std.hermes.view;
use std.hermes.anyval;
use std.hermes.string;
use std.compiler.metaprog;

#[metaprog_handler("derive_marker")]
fn derive_marker_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }

    let item: AnyVal = AnyVal::from_offset(target_offset);
    let name_val: AnyVal = view.tiny_map_get(item, 1 as u8);
    let name: StringView = view.get_str_view(name_val);
    if name.len == (0 as u64) { return; }

    let mut em: Emitter = Emitter::new();
    em.emit_fn_i64_named("gen", "marker_", name, "", 1 as u64);
    return;
}

#[derive_marker]
struct Alpha { x: i32 }

#[derive_marker]
struct Bravo { y: i32 }

fn main() -> i32 { return 0; }
