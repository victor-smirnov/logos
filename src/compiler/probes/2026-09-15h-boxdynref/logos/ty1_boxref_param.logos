package p;
use logos.mem.boxed;
trait Sp { fn v(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }

fn takes_boxref(b: &Box<dyn Sp>) -> i64 { return b.v(); }
fn main() -> i32 {
    let b: Box<dyn Sp> = box_new(A { x: 42i64 });
    if takes_boxref(&b) != 42i64 { return 3i32; }
    return 0i32;
}
