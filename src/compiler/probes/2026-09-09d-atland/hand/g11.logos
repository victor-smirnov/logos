// A NESTED tuple as the sub-pattern of a tuple-element at-binding.
package g11;
fn main() -> i32 {
    let t: ((i64, i64), i64) = ((1i64, 2i64), 3i64);
    let mut out: i64 = 0i64;
    match t {
        (p @ (a, b), c) => { out = a + b + c + p.0; }
        (_, _) => { out = -1i64; }
    }
    if out != 7i64 { return 1i32; }
    return 0i32;
}
