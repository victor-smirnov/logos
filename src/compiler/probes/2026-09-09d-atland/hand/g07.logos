// At under a REFERENCE scrutinee (default binding mode by-ref): `n` is `&i64`.
package g07;
fn main() -> i32 {
    let v: i64 = 4i64;
    let mut out: i64 = 0i64;
    match &v {
        n @ 1i64..=5i64 => { out = *n; }
        _ => { out = -1i64; }
    }
    if out != 4i64 { return 1i32; }
    return 0i32;
}
