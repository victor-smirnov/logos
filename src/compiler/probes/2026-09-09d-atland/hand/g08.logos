// `mut` at-binding in STRUCT FIELD position, then assigned through.
package g08;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let p: P = P { x: 1i64, y: 2i64 };
    let mut out: i64 = 0i64;
    match p {
        P { x: mut a @ _, y } => { a = a + 10i64; out = a + y; }
    }
    if out != 13i64 { return 1i32; }
    return 0i32;
}
