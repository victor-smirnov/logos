// DESTRUCTOR COUNT for the `let n @ …` delegation: a Drop value bound by an
// at-pattern at `let` must be dropped EXACTLY ONCE. Exit code alone cannot see
// a leak or a double free.
package g27;
static mut DROPS: i64 = 0i64;
struct P { n: i64 }
impl Drop for P { fn drop(self: &mut P) { unsafe { DROPS = DROPS + 1i64; } } }
fn main() -> i32 {
    let mut out: i64 = 0i64;
    {
        let p: P = P { n: 3i64 };
        let w @ _ = p;
        out = w.n;
    }
    let d: i64 = unsafe { DROPS };
    if out != 3i64 { return 1i32; }
    if d != 1i64 { return (10i64 + d) as i32; }
    return 0i32;
}
