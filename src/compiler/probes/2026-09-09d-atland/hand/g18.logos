// CONTROL: an enum-typed TUPLE ELEMENT bound by a plain name (no `@`).
package g18;
fn main() -> i32 {
    let t: (Option<i64>, i64) = (Option::Some(4i64), 2i64);
    let mut out: i64 = 0i64;
    match t {
        (a, y) => { out = y; if let Option::Some(v) = a { out = out + v; } }
    }
    if out != 6i64 { return 1i32; }
    return 0i32;
}
