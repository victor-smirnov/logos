// NARROWING g18: a tuple with an enum element, read by INDEX, no pattern at all.
package g19;
fn main() -> i32 {
    let t: (Option<i64>, i64) = (Option::Some(4i64), 2i64);
    let mut out: i64 = t.1;
    if let Option::Some(v) = t.0 { out = out + v; }
    if out != 6i64 { return 1i32; }
    return 0i32;
}
