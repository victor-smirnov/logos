package h07_iflet_mut;
struct S { v: i64 }
impl S { fn get(&mut self) -> &mut i64 { return &mut self.v; } }
fn main() -> i32 {
    let o: Option<S> = Option::Some(S { v: 1i64 });
    if let Option::Some(mut s) = o {
        let r: &mut i64 = s.get();
        *r = 8i64;
        if s.v != 8i64 { return 1i32; }
    }
    return 0i32;
}
