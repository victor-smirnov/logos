package h34_match_nested_tuple_mut_recv;
struct S { v: i64 }
impl S { fn get(&mut self) -> &mut i64 { return &mut self.v; } }
fn main() -> i32 {
    let o: Option<(S, i64)> = Option::Some((S { v: 1i64 }, 2i64));
    match o {
        Option::Some((mut s, k)) => { let r: &mut i64 = s.get(); *r = 8i64; if s.v + k != 10i64 { return 1i32; } },
        Option::None => {}
    }
    return 0i32;
}
