package h01_match_mut;
struct S { v: i64 }
impl S { fn get(&mut self) -> &mut i64 { return &mut self.v; } }
enum E { A(S), B }
fn main() -> i32 {
    let e: E = E::A(S { v: 1i64 });
    match e {
        E::A(mut s) => { let r: &mut i64 = s.get(); *r = 8i64; if s.v != 8i64 { return 1i32; } },
        E::B => {}
    }
    return 0i32;
}
