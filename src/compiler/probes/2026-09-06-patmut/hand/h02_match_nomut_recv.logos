package h02_match_nomut_recv;
struct S { v: i64 }
impl S { fn get(&mut self) -> &mut i64 { return &mut self.v; } }
enum E { A(S), B }
fn main() -> i32 {
    let e: E = E::A(S { v: 1i64 });
    match e {
        E::A(s) => { let r: &mut i64 = s.get(); *r = 8i64; },
        E::B => {}
    }
    return 0i32;
}
