package h08_whilelet_mut;
use logos.mem.collections.vec;
struct S { v: i64 }
impl S { fn get(&mut self) -> &mut i64 { return &mut self.v; } }
fn main() -> i32 {
    let mut vs: Vec<S> = Vec::new();
    vs.push(S { v: 1i64 });
    let mut acc: i64 = 0i64;
    while let Option::Some(mut s) = vs.pop() {
        let r: &mut i64 = s.get();
        *r = 8i64;
        acc = acc + s.v;
    }
    if acc != 8i64 { return 1i32; }
    return 0i32;
}
