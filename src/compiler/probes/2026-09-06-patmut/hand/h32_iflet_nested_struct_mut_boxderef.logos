package h32_iflet_nested_struct_mut_boxderef;
struct W { b: Box<i64> }
fn main() -> i32 {
    let o: Option<W> = Option::Some(W { b: Box::new(1i64) });
    if let Option::Some(W { b: mut bb }) = o {
        let r: &mut i64 = &mut *bb;
        *r = 5i64;
        if *bb != 5i64 { return 1i32; }
    }
    return 0i32;
}
