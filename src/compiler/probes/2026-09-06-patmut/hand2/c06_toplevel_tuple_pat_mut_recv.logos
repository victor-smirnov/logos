package c06_toplevel_tuple_pat_mut_recv;
struct S { v: i64 }
impl S { fn get(&mut self) -> &mut i64 { return &mut self.v; } }
fn main() -> i32 {
    let t: (S, i64) = (S { v: 1i64 }, 2i64);
    let mut out: i64 = 0i64;
    match t {
        (mut s, k) => { let r: &mut i64 = s.get(); *r = 8i64; out = s.v + k; }
    }
    if out != 10i64 { return 1i32; }
    return 0i32;
}
