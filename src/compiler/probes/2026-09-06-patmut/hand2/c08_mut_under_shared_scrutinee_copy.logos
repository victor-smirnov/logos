package c08_mut_under_shared_scrutinee_copy;
fn main() -> i32 {
    let o: Option<i64> = Option::Some(1i64);
    let mut out: i64 = 0i64;
    match &o {
        Option::Some(mut n) => { n = n + 1i64; out = n; },
        Option::None => {}
    }
    if out != 2i64 { return 1i32; }
    return 0i32;
}
