package c13_match_mut_drop_count;
use logos.std.fmt;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("DROP v={}", self.v); } }
impl S { fn get(&mut self) -> &mut i64 { return &mut self.v; } }
enum E { A(S), B }
fn main() -> i32 {
    let e: E = E::A(S { v: 1i64 });
    match e {
        E::A(mut s) => { let r: &mut i64 = s.get(); *r = 8i64; },
        E::B => {}
    }
    println!("-- end");
    return 0i32;
}
