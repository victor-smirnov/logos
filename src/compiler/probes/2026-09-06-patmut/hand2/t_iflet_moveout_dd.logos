package t_iflet_moveout_dd;
use logos.std.fmt;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("DROP v={}", self.v); } }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let o: Option<S> = Option::Some(S { v: 1i64 });
    if let Option::Some(s) = o {
        let k: i64 = eat(s);
        println!("ate {}", k);
    }
    println!("-- end");
    return 0i32;
}
