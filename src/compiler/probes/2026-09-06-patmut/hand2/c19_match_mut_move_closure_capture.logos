package c19_match_mut_move_closure_capture;
struct S { v: i64 }
enum E { A(S), B }
fn main() -> i32 {
    let e: E = E::A(S { v: 1i64 });
    let mut out: i64 = 0i64;
    match e {
        E::A(mut s) => {
            let mut f = move || -> i64 { s.v = s.v + 7i64; return s.v; };
            out = f();
        },
        E::B => {}
    }
    if out != 8i64 { return 1i32; }
    return 0i32;
}
