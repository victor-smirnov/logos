package t_whilelet_moveout_dd;
use logos.std.fmt;
use logos.mem.collections.vec;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("DROP v={}", self.v); } }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let mut vs: Vec<S> = Vec::new();
    vs.push(S { v: 1i64 });
    while let Option::Some(s) = vs.pop() {
        let k: i64 = eat(s);
        println!("ate {}", k);
    }
    println!("-- end");
    return 0i32;
}
