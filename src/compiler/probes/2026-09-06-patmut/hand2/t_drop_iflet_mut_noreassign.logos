package t_drop_iflet_mut_noreassign;
use logos.std.fmt;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("DROP v={}", self.v); } }
fn main() -> i32 {
    let o: Option<S> = Option::Some(S { v: 1i64 });
    if let Option::Some(mut s) = o {
        s.v = s.v + 5i64;
    }
    println!("-- end");
    return 0i32;
}
