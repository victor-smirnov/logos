package t_drop_whilelet_mut_reassign;
use logos.std.fmt;
use logos.mem.collections.vec;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("DROP v={}", self.v); } }
fn main() -> i32 {
    let mut vs: Vec<S> = Vec::new();
    vs.push(S { v: 1i64 });
    while let Option::Some(mut s) = vs.pop() {
        s = S { v: 2i64 };
        s.v = s.v + 5i64;
    }
    println!("-- end");
    return 0i32;
}
