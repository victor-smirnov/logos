package t_iflet_userenum_dd;
use logos.std.fmt;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("DROP v={}", self.v); } }
enum T { T0(S), T1 }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let o: T = T::T0(S { v: 1i64 });
    if let T::T0(s) = o {
        let k: i64 = eat(s);
        println!("ate {}", k);
    }
    println!("-- end");
    return 0i32;
}
