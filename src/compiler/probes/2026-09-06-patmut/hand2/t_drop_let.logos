package t_drop_let;
use logos.std.fmt;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("DROP v={}", self.v); } }
fn main() -> i32 {
    {
        let mut s: S = S { v: 1i64 };
        s = S { v: 2i64 };
        s.v = s.v + 5i64;
    }
    println!("-- end");
    return 0i32;
}
