package t_match_option_dd;
use logos.std.fmt;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("DROP v={}", self.v); } }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let o: Option<S> = Option::Some(S { v: 1i64 });
    match o {
        Option::Some(s) => { let k: i64 = eat(s); println!("ate {}", k); },
        Option::None => {}
    }
    println!("-- end");
    return 0i32;
}
