package c16_for_mut_vec_drop_count;
use logos.std.fmt;
use logos.mem.collections.vec;
use logos.mem.collections.vec;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("DROP v={}", self.v); } }
fn main() -> i32 {
    let mut vs: Vec<S> = Vec::new();
    vs.push(S { v: 1i64 });
    vs.push(S { v: 2i64 });
    for mut s in vs {
        s.v = s.v + 10i64;
    }
    println!("-- end");
    return 0i32;
}
