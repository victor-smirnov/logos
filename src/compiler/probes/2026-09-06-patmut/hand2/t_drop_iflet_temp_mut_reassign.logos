package t_drop_iflet_temp_mut_reassign;
use logos.std.fmt;
struct S { v: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("DROP v={}", self.v); } }
fn mk() -> Option<S> { return Option::Some(S { v: 1i64 }); }
fn main() -> i32 {
    if let Option::Some(mut s) = mk() {
        s = S { v: 2i64 };
        s.v = s.v + 5i64;
    }
    println!("-- end");
    return 0i32;
}
