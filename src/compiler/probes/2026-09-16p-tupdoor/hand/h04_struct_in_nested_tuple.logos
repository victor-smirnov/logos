// legality: rustc 1.98.1 --edition 2024, twin rust/h04_struct_in_nested_tuple.rs
package h04_struct_in_nested_tuple;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let sv: ((P, i64), i64) = ((P { x: 1i64, y: 2i64 }, 3i64), 4i64);
    match sv {
        ((P { x, y }, q), z) => { if x + y + q + z != 10i64 { return 1i32; } }
    }
    return 0i32;
}
