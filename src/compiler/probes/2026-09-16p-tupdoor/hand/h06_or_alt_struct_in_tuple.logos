// hand battery: round 2026-09-16p-tupdoor, program h06 — the SAME door under an OR-pattern join.
// collect_pat_bindings (mlir_gen_stmt.cpp) has no Struct arm, so the two alts may get no SHARED
// alloca for x/y; a wrong answer here is a miscompile, not a refusal. Measured, not assumed.
// legality: rustc 1.98.1 --edition 2024, twin rust/h06_or_alt_struct_in_tuple.rs
package h06_or_alt_struct_in_tuple;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let sv: (P, i64) = (P { x: 1i64, y: 2i64 }, 9i64);
    let mut t: i64 = 0i64;
    match sv {
        (P { x, y }, 9i64) | (P { x, y }, 8i64) => { t = x + y; }
        _ => { t = 100i64; }
    }
    if t != 3i64 { return 1i32; }
    return 0i32;
}
