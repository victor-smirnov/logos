// hand battery: round 2026-09-16p-tupdoor, program h05 — MOVE-TYPED binder through the tuple door.
// Oracle is a DESTRUCTOR COUNT, not an exit code: n must be 7 (exactly one drop), never 14 (double
// free) and never 0 (leak). A16 auto-Copy makes an all-scalar struct Copy, so `impl Drop` is what
// makes this a move type at all.
// legality: rustc 1.98.1 --edition 2024, twin rust/h05_movetype_struct_in_tuple.rs
package h05_movetype_struct_in_tuple;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct H { d: D }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut got: i64 = 0i64;
    {
        let h: H = H { d: D { v: 7i64, c: p } };
        let sv: (H, i64) = (h, 1i64);
        match sv {
            (H { d }, k) => { got = d.v + k; }
        }
    }
    let n2: i64 = unsafe { n };
    unsafe { printf("got=%ld n=%ld\n".as_ptr(), got, n2); }
    if got != 8i64 { return 1i32; }
    if n2 != 7i64 { return 2i32; }
    return 0i32;
}
