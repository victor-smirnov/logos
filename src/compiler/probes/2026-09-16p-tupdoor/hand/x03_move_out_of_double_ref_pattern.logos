// hand battery: round 2026-09-16p-tupdoor, program x03 — ABUSE twin for the EXACT shape of queue row
// ref_pattern_nested_in_tuple_binding_undefined_refused, with a MOVE-typed field instead of a Copy one.
// `(&&P { d }, j)` binds d by value out of a `&&P`: E0507 in Rust. The row's own program is legal only
// because i32 is Copy; one field-type token separates them.
// legality: rustc 1.98.1 --edition 2024 REFUSES (E0507), twin rust/x03_move_out_of_double_ref_pattern.rs
package x03_move_out_of_double_ref_pattern;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct P { d: D }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut t: i64 = 0i64;
    let pv: P = P { d: D { v: 5i64, c: p } };
    let r: &P = &pv;
    let pp: &&P = &r;
    let k: i64 = 1i64;
    match (pp, k) {
        (&&P { d }, j) => { t = d.v + j; }
    }
    if t != 6i64 { return 1i32; }
    return 0i32;
}
