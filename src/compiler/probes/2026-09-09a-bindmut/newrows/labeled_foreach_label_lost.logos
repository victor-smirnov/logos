// SOUNDNESS QUEUE row labeled_foreach_label_lost (tier 3). A LABELED for-each
// (`'l: for x in v { … break 'l; }`) is legal Rust and TODAY is refused
// "'break 'l': label not in scope" — the label reaches the RANGE for (`'l: for i
// in 0..n`, fine) but not the for-each lowering (IDENT and PATTERN forms alike:
// `'l: for (a, b) in v { continue 'l; }` says the same). Found 2026-09-09a (hand
// f17/f18, control f16). Rust: exit 0.
package labeled_foreach_label_lost;
fn main() -> i32 {
    let v: [i64; 3] = [1i64, 2i64, 3i64];
    let mut acc: i64 = 0i64;
    'l: for x in v {
        acc = acc + x;
        if x == 2i64 { break 'l; }
    }
    if acc != 3i64 { return 1i32; }
    return 0i32;
}
