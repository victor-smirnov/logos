package a13_payload_ref_at;
enum E { N(i64), Z }
fn main() -> i32 {
    let e: E = E::N(3i64);
    let mut out: i64 = 0i64;
    match e {
        E::N(ref n @ 1i64..=5i64) => { out = *n; },
        E::N(_) => { out = -1i64; },
        E::Z => {}
    }
    if out != 3i64 { return 1i32; }
    return 0i32;
}
