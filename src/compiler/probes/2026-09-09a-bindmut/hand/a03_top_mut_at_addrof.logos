package a03_top_mut_at_addrof;
fn bump(r: &mut i64) { *r = *r + 100i64; }
fn main() -> i32 {
    let v: i64 = 4i64;
    let mut out: i64 = 0i64;
    match v {
        mut n @ 1i64..=5i64 => { bump(&mut n); out = n; },
        _ => { out = -1i64; }
    }
    if out != 104i64 { return 1i32; }
    return 0i32;
}
