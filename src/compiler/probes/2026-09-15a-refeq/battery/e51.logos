package e51;
use logos.lang.cmp;
use logos.mem.collections.vec;
struct D { v: i64 }
impl Eq for D {
    fn eq(&self, other: &D) -> bool {
        return self.v == other.v;
    }
}
fn main() -> i32 {
    let mut v: Vec<D> = vec_new::<D>();
    v.push(D { v: 4i64 });
    v.push(D { v: 4i64 });
    let r0: &D = &v[0];
    let r1: &D = &v[1];
    if r0 == r1 {
        return 0i32;
    }
    return 1i32;
}
