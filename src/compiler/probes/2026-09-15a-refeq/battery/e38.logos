package e38;
use logos.lang.cmp;
use logos.lang.option;
struct S { v: i64, c: *mut i64 }
impl Drop for S {
    fn drop(self: &mut S) {
        unsafe { *self.c = *self.c + 1i64; }
    }
}
impl Eq for S {
    fn eq(&self, other: &S) -> bool {
        return self.v == other.v;
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut hit: i64 = 0i64;
    {
        let a: Option<S> = Option::Some(S { v: 3i64, c: p });
        let b: Option<S> = Option::Some(S { v: 3i64, c: p });
        let ra: &Option<S> = &a;
        let rb: &Option<S> = &b;
        if ra == rb { hit = 1i64; }
        if ra != rb { hit = 5i64; }
    }
    let got: i64 = unsafe { n };
    if got != 2i64 { return 10i32 + got as i32; }
    if hit != 1i64 { return 1i32; }
    return 0i32;
}
