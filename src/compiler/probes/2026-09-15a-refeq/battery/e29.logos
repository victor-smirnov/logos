package e29;
use logos.lang.cmp;
struct D { v: i64 }
impl Eq for D {
    fn eq(&self, other: &D) -> bool {
        return self.v == other.v;
    }
}
impl D {
    fn same(&self, o: &D) -> bool {
        return self == o;
    }
}
fn main() -> i32 {
    let a: D = D { v: 4i64 };
    let b: D = D { v: 4i64 };
    if a.same(&b) {
        return 0i32;
    }
    return 1i32;
}
