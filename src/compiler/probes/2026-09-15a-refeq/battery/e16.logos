package e16;
use logos.lang.cmp;
use logos.mem.string;
struct H { s: String, k: i64 }
impl Eq for H {
    fn eq(&self, other: &H) -> bool {
        return self.s == other.s && self.k == other.k;
    }
}
fn main() -> i32 {
    let a: H = H { s: String::from("heap-one"), k: 1i64 };
    let b: H = H { s: String::from("heap-one"), k: 1i64 };
    let ra: &H = &a;
    let rb: &H = &b;
    if ra == rb {
        return 0i32;
    }
    return 1i32;
}
