package e18;
use logos.lang.cmp;
struct D { v: i64 }
impl Eq for D {
    fn eq(&self, other: &D) -> bool {
        return self.v == other.v;
    }
}
struct P { x: D, n: i64 }
fn main() -> i32 {
    let p: P = P { x: D { v: 8i64 }, n: 1i64 };
    let q: P = P { x: D { v: 8i64 }, n: 2i64 };
    if &p.x == &q.x {
        return 0i32;
    }
    return 1i32;
}
