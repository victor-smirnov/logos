package e53;
use logos.lang.cmp;
struct D { v: i64 }
impl Eq for D {
    fn eq(&self, other: &D) -> bool {
        return self.v == other.v;
    }
}
fn main() -> i32 {
    let a: D = D { v: 5i64 };
    let b: D = D { v: 5i64 };
    let ra: &D = &a;
    if ra == &b {
        return 0i32;
    }
    return 1i32;
}
