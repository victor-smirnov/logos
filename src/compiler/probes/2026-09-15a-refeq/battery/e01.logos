package e01;
use logos.lang.cmp;
struct D { v: i64 }
impl Eq for D {
    fn eq(&self, other: &D) -> bool {
        return self.v == other.v;
    }
}
fn main() -> i32 {
    let a: i64 = 4i64;
    let b: i64 = 4i64;
    let mut ra: &i64 = &a;
    let mut rb: &i64 = &b;
    let x: &mut &i64 = &mut ra;
    let y: &mut &i64 = &mut rb;
    if x == y {
        return 0i32;
    }
    return 1i32;
}
