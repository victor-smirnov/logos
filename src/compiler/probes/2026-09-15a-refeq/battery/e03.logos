package e03;
use logos.lang.cmp;
struct D { v: i64 }
impl Eq for D {
    fn eq(&self, other: &D) -> bool {
        return self.v == other.v;
    }
}
fn main() -> i32 {
    let a: char = 'q';
    let b: char = 'q';
    let ra: &char = &a;
    let rb: &char = &b;
    if ra == rb {
        return 0i32;
    }
    return 1i32;
}
