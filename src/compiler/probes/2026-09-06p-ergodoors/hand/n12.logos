package n12;
use logos.std.fmt;
struct S { pub n: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("D{}", self.n); } }
enum Outer { W(Option<S>), Z }
fn main() -> i32 {
    let e: Outer = Outer::W(Option::Some(S { n: 5i64 }));
    let mut out: i64 = 0i64;
    match &e {
        Outer::W(Option::Some(a)) => { out = a.n; },
        Outer::W(Option::None) => {},
        Outer::Z => {}
    }
    if out != 5i64 { return 1i32; }
    return 0i32;
}
