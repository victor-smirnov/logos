package c12;
use logos.lang.ops;
struct W { inner: i64 }
impl Deref<i64> for W { fn deref(&self) -> &i64 { return &self.inner; } }
struct H { w: W }
impl H { fn set(&mut self, v: i64) { *self.w = v; } }
fn main() -> i32 {
    let mut h: H = H { w: W { inner: 1i64 } };
    h.set(5i64);
    return 0i32;
}
