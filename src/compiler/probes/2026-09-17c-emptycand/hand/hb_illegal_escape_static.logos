// hand battery: round 2026-09-17c-emptycand, program hb02 — ILLEGAL twin (rustc E0515)
package hb_illegal_escape_static;
static V: i64 = 5i64;
fn pick<'a>(x: &'a i64, y: &'a i64) -> &'a i64 { if *x > *y { return x; } return y; }
fn escape() -> &'static i64 {
    let n: i64 = 9i64;
    return pick(&V, &n);
}
fn main() -> i32 { return (*escape()) as i32; }
