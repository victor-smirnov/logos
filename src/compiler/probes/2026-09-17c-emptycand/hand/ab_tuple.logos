// hand battery: round 2026-09-17c-emptycand, abuse ab_tuple — rustc E0515, must STAY refused
package ab_tuple;
static V: i64 = 5i64;
fn pick<'a>(x: (&'a i64, i64), y: (&'a i64, i64)) -> &'a i64 { if x.1 > y.1 { return x.0; } return y.0; }
fn escape() -> &'static i64 { let n: i64 = 9i64; return pick((&V, 1i64), (&n, 2i64)); }
fn main() -> i32 { return (*escape()) as i32; }
