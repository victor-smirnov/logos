// hand battery: round 2026-09-17c-emptycand, program hb03 — ILLEGAL twin (rustc E0597)
package hb_illegal_outlive_block;
fn keep<'a>(x: &'a i64, y: &'a i64) -> &'a i64 { if *x > *y { return x; } return y; }
fn main() -> i32 {
    let a: i64 = 1i64;
    let mut r: &i64 = &a;
    {
        let b: i64 = 2i64;
        r = keep(&a, &b);
    }
    return (*r) as i32;
}
