// ILLEGAL under Rust 2024: written `ref` at the TUPLE-ELEMENT door under a
// by-ref default binding mode.
package cx08;
fn main() -> i32 {
    let t: (i64, i64) = (1i64, 2i64);
    let mut out: i64 = 0i64;
    match &t {
        (ref a, b) => { out = *a + *b; }
    }
    if out != 3i64 { return 1i32; }
    return 0i32;
}
