// LEGAL IN RUST 2024: the TOP-LEVEL pattern's default binding mode is `move`
// — a reference-typed scrutinee only shifts the mode once a non-reference
// pattern is matched THROUGH it. `ref w` here binds `&&Option<i64>`.
package cx15;
fn main() -> i32 {
    let o: Option<i64> = Option::Some(3i64);
    let mut out: i64 = 0i64;
    match &o {
        ref w => { match **w { Option::Some(ref v) => { out = *v; } Option::None => {} } }
    }
    if out != 3i64 { return 1i32; }
    return 0i32;
}
