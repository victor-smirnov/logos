// LEGAL: no modifier written; the tuple door's own default-mode synthesis.
package cx14;
fn main() -> i32 {
    let p: (Option<i64>, i64) = (Option::Some(7i64), 2i64);
    let mut out: i64 = 0i64;
    match &p {
        (Option::Some(a), b) => { out = *a + *b; }
        (Option::None, b) => { out = *b; }
    }
    if out != 9i64 { return 1i32; }
    return 0i32;
}
