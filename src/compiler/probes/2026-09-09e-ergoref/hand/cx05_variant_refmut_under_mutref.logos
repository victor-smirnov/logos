// ILLEGAL under Rust 2024: written `ref mut` at the variant-payload door under
// a `&mut` scrutinee.
package cx05;
fn main() -> i32 {
    let mut o: Option<i64> = Option::Some(3i64);
    match &mut o {
        Option::Some(ref mut v) => { *v = *v + 1i64; }
        Option::None => {}
    }
    return 0i32;
}
