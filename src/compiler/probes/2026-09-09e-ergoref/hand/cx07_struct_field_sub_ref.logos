// ILLEGAL under Rust 2024: written `ref` as a struct-field SUB-PATTERN (the
// LEAF binder door), under a by-ref default binding mode.
package cx07;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let p: P = P { x: 1i64, y: 2i64 };
    let mut out: i64 = 0i64;
    match &p {
        P { x: ref v, y: _ } => { out = *v; }
    }
    if out != 1i64 { return 1i32; }
    return 0i32;
}
