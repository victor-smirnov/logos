package n09;
fn t<'a, 'b>(x: &'a i64, y: Option<&'b i64>) -> i64 where 'a: 'b {
    match y { Option::Some(r) => { return *x + *r; } Option::None => { return *x; } }
}
fn f<'p, 'q>(x: &'p i64, y: Option<&'q i64>) -> i64 { return t(x, y); }
fn main() -> i32 {
    let n = 1i64;
    let m = 3i64;
    return f(&n, Option::Some(&m)) as i32;
}
