// LEGAL. `ref mut` in a tuple, passed to a fn taking &mut i64.
package h05;
fn bump(r: &mut i64) { *r = *r + 100i64; }
fn main() -> i32 {
    let mut t: (i64, i64) = (3i64, 4i64);
    match t {
        (ref mut a, b) => { bump(a); if *a + b != 107i64 { return 1i32; } }
    }
    if t.0 != 103i64 { return 2i32; }
    return 0i32;
}
