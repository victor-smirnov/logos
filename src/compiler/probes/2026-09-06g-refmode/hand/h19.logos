// LEGAL. `ref mut` element used TWICE (two writes through the same binding).
package h19;
fn main() -> i32 {
    let mut t: (i64, i64) = (3i64, 4i64);
    match t {
        (ref mut a, b) => { *a = *a + 1i64; *a = *a * 2i64; if *a + b != 12i64 { return 1i32; } }
    }
    if t.0 != 8i64 { return 2i32; }
    return 0i32;
}
