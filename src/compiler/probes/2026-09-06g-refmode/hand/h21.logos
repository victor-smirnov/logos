// LEGAL. `ref mut` on a tuple element whose type is a STRUCT (aggregate, not scalar).
package h21;
struct S { v: i64 }
fn main() -> i32 {
    let mut t: (S, i64) = (S { v: 3i64 }, 4i64);
    match t {
        (ref mut s, b) => { s.v = s.v + 1i64; if s.v + b != 8i64 { return 1i32; } }
    }
    if t.0.v != 4i64 { return 2i32; }
    return 0i32;
}
