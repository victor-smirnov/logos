// LEGAL. `while let` over a tuple with a `ref mut` element, one iteration.
package h23;
fn main() -> i32 {
    let mut t: (i64, i64) = (3i64, 4i64);
    let mut once: bool = true;
    while let (ref mut a, b) = t {
        if !once { return 0i32; }
        *a = *a + 1i64;
        if *a + b != 8i64 { return 1i32; }
        once = false;
        return 0i32;
    }
    return 2i32;
}
