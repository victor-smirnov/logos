package a06_at_ref;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let s: S = S { v: 1i64, i: p };
        let mut out: i64 = 0i64;
        match s {
            ref n @ S { v: _, i: _ } => { out = n.v; }
        }
        if out != 1i64 { return 9i32; }
        if s.v != 1i64 { return 8i32; }
    }
    return c as i32;
}
