package a14_ifletchain_ref;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let o: Option<S> = Option::Some(S { v: 1i64, i: p });
        let mut out: i64 = 0i64;
        if let Option::Some(ref s) = o && s.v > 0i64 {
            out = s.v;
        }
        if out != 1i64 { return 9i32; }
        if let Option::Some(ref s2) = o { out = s2.v + 1i64; }
        if out != 2i64 { return 8i32; }
    }
    return c as i32;
}
