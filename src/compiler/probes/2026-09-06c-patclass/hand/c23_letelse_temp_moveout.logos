package c23_letelse_temp_moveout;
fn mk(p: *mut i64) -> Option<S> { return Option::Some(S { v: 1i64, i: p }); }
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn body(p: *mut i64) -> i64 {
    let Option::Some(r) = mk(p) else { return 9i64; };
    return eat(r);
}
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    if body(p) != 1i64 { return 99i32; }
    return c as i32;
}
