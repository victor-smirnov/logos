package d07_iflet_return_binding;

struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn take(p: *mut i64) -> S {
    let o: Option<S> = Option::Some(S { v: 1i64, i: p });
    if let Option::Some(r) = o { return r; }
    return S { v: 100i64, i: p };
}
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    { let s: S = take(p); if s.v != 1i64 { return 99i32; } }
    return c as i32;
}
