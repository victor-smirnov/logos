package d06_iflet_mutref_scrut;

struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let mut o: Option<S> = Option::Some(S { v: 1i64, i: p });
        if let Option::Some(r) = &mut o { r.v = r.v + 4i64; }
    }
    return c as i32;
}
