package d10_iflet_copy_payload_ctl;

struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let o: Option<i64> = Option::Some(4i64);
    let mut k: i64 = 0i64;
    if let Option::Some(x) = o { k = x; }
    if let Option::Some(y) = o { k = k + y; }
    if k != 8i64 { return 1i32; }
    return 0i32;
}
