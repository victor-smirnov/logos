package a11_nested_tuple_ref;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let o: Option<(S, i64)> = Option::Some((S { v: 1i64, i: p }, 2i64));
        let mut out: i64 = 0i64;
        match o {
            Option::Some((ref a, b)) => { out = a.v + b; },
            Option::None => {}
        }
        if out != 3i64 { return 9i32; }
        match o {
            Option::Some((ref a2, _)) => { out = a2.v; },
            Option::None => {}
        }
        if out != 1i64 { return 8i32; }
    }
    return c as i32;
}
