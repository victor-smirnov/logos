package a02_tuple_ref;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let t: (S, i64) = (S { v: 1i64, i: p }, 2i64);
        let mut out: i64 = 0i64;
        match t {
            (ref a, b) => { out = a.v + b; }
        }
        if out != 3i64 { return 9i32; }
        if t.0.v != 1i64 { return 8i32; }
    }
    return c as i32;
}
