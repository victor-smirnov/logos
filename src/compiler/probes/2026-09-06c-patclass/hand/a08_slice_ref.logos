package a08_slice_ref;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let arr: [S; 2] = [S { v: 1i64, i: p }, S { v: 2i64, i: p }];
        let mut out: i64 = 0i64;
        match arr {
            [ref a, ref b] => { out = a.v + b.v; }
        }
        if out != 3i64 { return 9i32; }
    }
    return c as i32;
}
