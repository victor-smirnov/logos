package c08_iflet_nested_tuple_moveout;

struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let o: Option<(S, i64)> = Option::Some((S { v: 1i64, i: p }, 7i64));
        if let Option::Some((a, b)) = o { let _k: i64 = eat(a) + b; }
    }
    return c as i32;
}
