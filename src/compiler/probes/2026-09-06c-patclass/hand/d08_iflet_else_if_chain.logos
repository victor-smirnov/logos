package d08_iflet_else_if_chain;

struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let o: Option<S> = Option::Some(S { v: 1i64, i: p });
        let o2: Option<S> = Option::Some(S { v: 2i64, i: p });
        if let Option::None = o { c = c + 100i64; }
        else if let Option::Some(r) = o2 { let _k: i64 = eat(r); }
    }
    return c as i32;
}
