package d04_iflet_in_loop_break;
use logos.mem.collections.vec;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let mut vs: Vec<Option<S>> = Vec::new();
        vs.push(Option::Some(S { v: 1i64, i: p }));
        vs.push(Option::Some(S { v: 2i64, i: p }));
        let mut n: i64 = 0i64;
        loop {
            let o: Option<S> = match vs.pop() { Option::Some(x) => x, Option::None => Option::None };
            if let Option::Some(r) = o { n = n + r.v; if n > 1i64 { break; } }
            else { break; }
        }
    }
    return c as i32;
}
