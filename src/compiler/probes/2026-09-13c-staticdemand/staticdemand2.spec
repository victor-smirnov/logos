            if (deep_ && k0_ == LogosType::Kind::Tuple) {
                std::vector<TypeRef> es_;
                for (auto e_ : TypeRef(t0_).tuple_elems()) es_.push_back(stfill_(e_));
                return make_tuple_type(std::move(es_));
            }
