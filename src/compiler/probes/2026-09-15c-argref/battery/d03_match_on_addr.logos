package d03_match_on_addr;
struct D { v: i64 }
fn inner(a: &&D) -> *const D {
    let x: &D = *a;
    return x as *const D;
}
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    let rd: &D = &d;
    match &rd {
        r => { if inner(r) != rd as *const D { return 3i32; } }
    }
    return 0i32;
}
