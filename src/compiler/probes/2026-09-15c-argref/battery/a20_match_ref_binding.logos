package a20_match_ref_binding;
struct D { v: i64 }
fn inner(a: &&D) -> i64 {
    let x: &D = *a;
    return x.v;
}
fn main() -> i32 {
    let o: Option<D> = Option::Some(D { v: 6i64 });
    match &o {
        Option::Some(rd) => {
            if inner(&rd) != 6i64 { return 20i32; }
        }
        Option::None => { return 21i32; }
    }
    return 0i32;
}
