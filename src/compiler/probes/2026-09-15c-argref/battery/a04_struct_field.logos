package a04_struct_field;
struct D { v: i64 }
struct W<'a> { r: &'a &'a D }
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    let rd: &D = &d;
    let want: *const D = rd as *const D;
    let w: W = W { r: &rd };
    let x: &D = *w.r;
    if x as *const D != want { return 4i32; }
    return 0i32;
}
