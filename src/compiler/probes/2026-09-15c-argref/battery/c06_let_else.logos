package c06_let_else;
struct D { v: i64 }
fn inner(a: &&D) -> *const D {
    let x: &D = *a;
    return x as *const D;
}
fn main() -> i32 {
    let o: Option<D> = Option::Some(D { v: 6i64 });
    let Option::Some(rd) = &o else { return 60i32; };
    if inner(&rd) != rd as *const D { return 6i32; }
    return 0i32;
}
