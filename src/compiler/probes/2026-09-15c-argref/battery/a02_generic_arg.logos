package a02_generic_arg;
struct D { v: i64 }
fn inner<T>(a: &&T) -> *const T {
    let x: &T = *a;
    return x as *const T;
}
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    let rd: &D = &d;
    let want: *const D = rd as *const D;
    if inner::<D>(&rd) != want { return 2i32; }
    return 0i32;
}
