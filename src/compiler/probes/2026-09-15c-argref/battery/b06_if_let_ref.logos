package b06_if_let_ref;
struct D { v: i64 }
fn inner(a: &&D) -> i64 {
    let x: &D = *a;
    return x.v;
}
fn main() -> i32 {
    let o: Option<D> = Option::Some(D { v: 6i64 });
    if let Option::Some(rd) = &o {
        if inner(&rd) != 6i64 { return 6i32; }
        return 0i32;
    }
    return 60i32;
}
