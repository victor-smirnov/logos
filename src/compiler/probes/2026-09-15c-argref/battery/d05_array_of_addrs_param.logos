package d05_array_of_addrs_param;
struct D { v: i64 }
fn inner(a: &&D) -> *const D {
    let x: &D = *a;
    return x as *const D;
}
fn both(a: [&&D; 2]) -> *const D {
    let x: &D = *a[1];
    return x as *const D;
}
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    let rd: &D = &d;
    if both([&rd, &rd]) != rd as *const D { return 5i32; }
    return 0i32;
}
