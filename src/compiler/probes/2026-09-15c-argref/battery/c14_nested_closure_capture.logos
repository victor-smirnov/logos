package c14_nested_closure_capture;
struct D { v: i64 }
fn inner(a: &&D) -> *const D {
    let x: &D = *a;
    return x as *const D;
}
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    let rd: &D = &d;
    let want: *const D = rd as *const D;
    let outer = || -> bool {
        let f = || -> bool { return inner(&rd) == want; };
        return f();
    };
    if !outer() { return 14i32; }
    return 0i32;
}
