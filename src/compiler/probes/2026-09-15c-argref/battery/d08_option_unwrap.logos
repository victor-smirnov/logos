package d08_option_unwrap;
struct D { v: i64 }
fn inner(a: &&D) -> *const D {
    let x: &D = *a;
    return x as *const D;
}
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    let rd: &D = &d;
    let o: Option<&&D> = Option::Some(&rd);
    if inner(o.unwrap()) != rd as *const D { return 8i32; }
    return 0i32;
}
