package b07_ref_keyword_binder;
struct D { v: i64 }
fn inner(a: &&D) -> i64 {
    let x: &D = *a;
    return x.v;
}
fn main() -> i32 {
    let o: Option<D> = Option::Some(D { v: 6i64 });
    match o {
        Option::Some(ref rd) => {
            if inner(&rd) != 6i64 { return 7i32; }
        }
        Option::None => { return 70i32; }
    }
    return 0i32;
}
