package c10_fn_pointer_call;
struct D { v: i64 }
fn inner(a: &&D) -> *const D {
    let x: &D = *a;
    return x as *const D;
}
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    let rd: &D = &d;
    let fp: fn(&&D) -> *const D = inner;
    if fp(&rd) != rd as *const D { return 10i32; }
    return 0i32;
}
