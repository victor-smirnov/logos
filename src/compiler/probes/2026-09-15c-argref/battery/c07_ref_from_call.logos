package c07_ref_from_call;
struct D { v: i64 }
fn inner(a: &&D) -> *const D {
    let x: &D = *a;
    return x as *const D;
}
fn get<'a>(x: &'a D) -> &'a D { return x; }
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    let rd: &D = get(&d);
    if inner(&rd) != &d as *const D { return 7i32; }
    return 0i32;
}
