package c12_generic_closure_param;
struct D { v: i64 }
fn inner(a: &&D) -> *const D {
    let x: &D = *a;
    return x as *const D;
}
fn apply<F: Fn(&D) -> bool>(f: F, d: &D) -> bool { return f(d); }
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    let want: *const D = &d as *const D;
    if !apply(|rd: &D| -> bool { return inner(&rd) == want; }, &d) { return 12i32; }
    return 0i32;
}
