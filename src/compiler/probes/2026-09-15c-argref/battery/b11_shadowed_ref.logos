package b11_shadowed_ref;
struct D { v: i64 }
fn inner(a: &&D) -> i64 {
    let x: &D = *a;
    return x.v;
}
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    let e: D = D { v: 9i64 };
    let rd: &D = &d;
    let s1: i64 = inner(&rd);
    let rd: &D = &e;
    let s2: i64 = inner(&rd);
    if s1 != 6i64 || s2 != 9i64 { return 11i32; }
    return 0i32;
}
