package b04_drop_count;
struct D { v: i64, n: *mut i64 }
impl Drop for D {
    fn drop(self: &mut Self) { unsafe { *self.n = *self.n + 1i64; } }
}
fn inner(a: &&D) -> i64 {
    let x: &D = *a;
    return x.v;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let pn: *mut i64 = &mut n as *mut i64;
    {
        let d: D = D { v: 6i64, n: pn };
        let rd: &D = &d;
        let mut i: i64 = 0i64;
        let mut s: i64 = 0i64;
        while i < 3i64 {
            s = s + inner(&rd);
            i = i + 1i64;
        }
        if s != 18i64 { return 4i32; }
    }
    return (n as i32) - 1i32;
}
