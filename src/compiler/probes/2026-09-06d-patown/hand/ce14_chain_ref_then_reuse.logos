package ce14_chain_ref_then_reuse;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn mk(p: *mut i64, v: i64) -> Option<S> { return Option::Some(S { v: v, i: p }); }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    let mut out: i64 = 0i64;
    {
        let o: Option<S> = mk(p, 1i64);
        if let Option::Some(ref s) = o && s.v > 0i64 {
            out = s.v;
        }
        if out != 1i64 { return 90i32; }
        if let Option::Some(ref s2) = o { out = s2.v + 1i64; }
    }
    return (c * 10i64 + out) as i32;
}
