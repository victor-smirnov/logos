package ce11_closure_body_iflet;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn mk(p: *mut i64, v: i64) -> Option<S> { return Option::Some(S { v: v, i: p }); }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    let f = |o: Option<S>| -> i64 { if let Option::Some(s) = o { eat(s) } else { 0i64 } };
    let r: i64 = f(mk(p, 1i64));
    if r != 1i64 { return 90i32; }
    return c as i32;
}
