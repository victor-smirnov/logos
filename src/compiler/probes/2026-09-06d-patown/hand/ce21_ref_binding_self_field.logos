package ce21_ref_binding_self_field;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn mk(p: *mut i64, v: i64) -> Option<S> { return Option::Some(S { v: v, i: p }); }
struct H { o: Option<S> }
impl H { fn m(&self) -> i64 { if let Option::Some(ref r) = self.o { return r.v; } return 0i64; } }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    let mut n: i64 = 0i64;
    {
        let h: H = H { o: mk(p, 4i64) };
        n = h.m();
    }
    return (c * 10i64 + n) as i32;
}
