package ce06_then_returns_scrut_reused;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn mk(p: *mut i64, v: i64) -> Option<S> { return Option::Some(S { v: v, i: p }); }
fn g(o: Option<S>) -> i64 {
    if let Option::Some(r) = o {
        let k: i64 = eat(r);
        return k;
    }
    let z: i64 = match o { Option::Some(_) => 7i64, Option::None => 9i64 };
    return z;
}
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    let a: i64 = g(mk(p, 1i64));
    let b: i64 = g(Option::None);
    if a != 1i64 { return 91i32; }
    if b != 9i64 { return 92i32; }
    return c as i32;
}
