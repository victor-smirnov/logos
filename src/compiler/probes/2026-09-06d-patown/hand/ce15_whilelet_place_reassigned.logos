package ce15_whilelet_place_reassigned;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn eat(s: S) -> i64 { return s.v; }
fn mk(p: *mut i64, v: i64) -> Option<S> { return Option::Some(S { v: v, i: p }); }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    let mut sum: i64 = 0i64;
    {
        let mut cur: Option<S> = mk(p, 1i64);
        while let Option::Some(n) = cur {
            sum = sum + n.v;
            cur = if n.v < 3i64 { mk(p, n.v + 1i64) } else { Option::None };
        }
    }
    return (c * 10i64 + sum) as i32;
}
