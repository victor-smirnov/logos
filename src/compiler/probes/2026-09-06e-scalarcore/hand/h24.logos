// CONTROL: an AGGREGATE core under a reference scrutinee (2026-09-05b's landing)
package h24;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let p: P = P { x: 3i64, y: 4i64 };
    let mut out: i64 = 0i64;
    match &p { P { x, y } => { out = x + y; } }
    if out != 7i64 { return 1i32; }
    return 0i32;
}
