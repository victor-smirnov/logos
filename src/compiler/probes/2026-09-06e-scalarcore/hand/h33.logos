// ⚠ THE COUNTER-EXAMPLE THE EXEMPTION IS ABOUT: a LITERAL arm and a NAMED
// whole-scrutinee binder in the SAME match. Legal Rust (x: &i64).
package h33;
fn main() -> i32 {
    let v: i64 = 4i64;
    let mut out: i64 = 0i64;
    match &v { 4i64 => { out = 1i64; } x => { out = *x; } }
    if out != 1i64 { return 1i32; }
    return 0i32;
}
