package q12;
use logos.std.fmt;
struct S { pub n: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("D{}", self.n); } }
enum E { V { f: S }, Z }
fn run() -> i64 {
    let p: E = E::V { f: S { n: 2i64 } };
    match &p {
        E::V { f } => { return f.n; },
        E::Z => {}
    }
    return 0i64;
}
fn main() -> i32 {
    if run() != 2i64 { return 1i32; }
    return 0i32;
}
