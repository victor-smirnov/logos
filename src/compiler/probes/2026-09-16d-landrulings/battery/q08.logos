package q08;
use logos.std.fmt;
struct S { pub n: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("D{}", self.n); } }
enum E { V { f: S }, Z }
fn run() -> i64 {
    let p: E = E::V { f: S { n: 3i64 } };
    let mut out: i64 = 0i64;
    match &p {
        E::V { f } => { let g: &S = f; out = g.n; },
        E::Z => {}
    }
    return out;
}
fn main() -> i32 {
    if run() != 3i64 { return 1i32; }
    return 0i32;
}
