package a09_ret_arrlit_other_local;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct W { x: D, y: D }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn mk(p: *mut i64) -> [D; 2] { let c: D = D { v: 100i64, c: p }; let a: D = D { v: 1i64, c: p }; let b: D = D { v: 10i64, c: p }; return [a, b]; }
fn g(p: *mut i64) -> i64 { { let arr: [D; 2] = mk(p); if arr[1].v != 10i64 { return 7i64; } } return 0i64; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("r=%ld n=%ld\n".as_ptr(), r, got); }
    if got != 111i64 { return 1i32; }
    return 0i32;
}
