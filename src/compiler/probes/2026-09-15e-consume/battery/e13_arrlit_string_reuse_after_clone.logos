package e13_arrlit_string_reuse_after_clone;
use logos.mem.string;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct W { x: D, y: D }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
impl Neg for D { fn neg(self: D) -> D { return D { v: 100i64, c: self.c }; } }
impl AddAssign for D { fn add_assign(self: &mut D, o: D) { self.v = self.v + 0i64 * o.v; } }
trait Tr { fn get(self: &Self) -> i64; }
impl Tr for D { fn get(self: &D) -> i64 { return self.v; } }

fn g(p: *mut i64) -> i64 { let s: String = String::from("ab"); let arr: [String; 2] = [s.clone(), s]; return arr[0].len() + arr[1].len(); }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("r=%ld n=%ld\n".as_ptr(), r, got); }
    if got != 0i64 { return 1i32; }
    return 0i32;
}
