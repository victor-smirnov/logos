package f04_tv_i64_inst;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
#[derive_copy]
#[derive_clone]
struct P { v: i64 }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn two<T>(x: T, y: T) -> [T; 2] { return [x, y]; }
fn g(p: *mut i64) -> i64 { let a: [i64; 2] = two(3i64, 4i64); return a[0] + a[1]; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("r=%ld n=%ld\n".as_ptr(), r, got); }
    if got != 0i64 { return 1i32; }
    return 0i32;
}
