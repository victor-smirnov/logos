package x04_arrlit_twice;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct W { x: D, y: D }
#[derive_copy]
#[derive_clone]
struct P { v: i64 }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
impl Add for D { fn add(self: D, o: D) -> D { return D { v: self.v * 0i64 + 100i64, c: self.c }; } }
impl Neg for D { fn neg(self: D) -> i64 { return 0i64 - self.v; } }
impl Add for P { fn add(self: P, o: P) -> P { return P { v: self.v + o.v }; } }
fn g(p: *mut i64) -> i64 { let a: D = D { v: 1i64, c: p }; let arr: [D; 2] = [a, a]; return arr[0].v; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("r=%ld n=%ld\n".as_ptr(), r, got); }
    if got != 1i64 { return 1i32; }
    return 0i32;
}
