package a08_arg_arrlit;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct W { x: D, y: D }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn eat(x: [D; 2]) -> i64 { return x[0].v; }
fn g(p: *mut i64) -> i64 { let a: D = D { v: 1i64, c: p }; let b: D = D { v: 10i64, c: p }; return eat([a, b]); }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("r=%ld n=%ld\n".as_ptr(), r, got); }
    if got != 11i64 { return 1i32; }
    return 0i32;
}
