package f06_tv_param_reuse_no_bound;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
#[derive_copy]
#[derive_clone]
struct P { v: i64 }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn pick<T>(x: T, k: bool) -> [T; 1] { if k { return [x]; } return [x]; }
fn g(p: *mut i64) -> i64 { { let a: [D; 1] = pick(D { v: 1i64, c: p }, true); if a[0].v != 1i64 { return 7i64; } } return 0i64; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("r=%ld n=%ld\n".as_ptr(), r, got); }
    if got != 1i64 { return 1i32; }
    return 0i32;
}
