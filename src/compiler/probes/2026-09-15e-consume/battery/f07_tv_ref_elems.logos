package f07_tv_ref_elems;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
#[derive_copy]
#[derive_clone]
struct P { v: i64 }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn refs<T>(x: &T, y: &T) -> [&T; 2] { return [x, y]; }
fn g(p: *mut i64) -> i64 { let a: D = D { v: 1i64, c: p }; let b: D = D { v: 10i64, c: p }; let s: i64 = { let arr: [&D; 2] = refs(&a, &b); arr[0].v + arr[1].v }; return s * 0i64; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("r=%ld n=%ld\n".as_ptr(), r, got); }
    if got != 11i64 { return 1i32; }
    return 0i32;
}
