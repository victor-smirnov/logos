package d10_trait_method_arg;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn eat(d: D) -> i64 { return d.v * 0i64; }
impl Add for D { fn add(self: D, o: D) -> D { return D { v: 100i64, c: self.c }; } }
trait Tk { fn take(self: &Self, d: D) -> i64; }
struct K { k: i64 }
impl Tk for K { fn take(self: &K, d: D) -> i64 { return d.v * 0i64 + self.k; } }
impl K { fn mk(d: D) -> K { return K { k: d.v * 0i64 }; } }
fn g(p: *mut i64) -> i64 { let k: K = K { k: 0i64 }; let a: D = D { v: 1i64, c: p }; let r: i64 = k.take(a); return r; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("r=%ld n=%ld\n".as_ptr(), r, got); }
    if got != 1i64 { return 1i32; }
    return 0i32;
}
