package f03_tv_two_generic_struct;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
#[derive_copy]
#[derive_clone]
struct P { v: i64 }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
struct G<T> { a: T, b: T }
impl<T> G<T> { fn arr(self: G<T>) -> [T; 2] { return [self.a, self.b]; } }
fn g(p: *mut i64) -> i64 { let x: G<D> = G { a: D { v: 1i64, c: p }, b: D { v: 10i64, c: p } }; { let arr: [D; 2] = x.arr(); if arr[1].v != 10i64 { return 7i64; } } return 0i64; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("r=%ld n=%ld\n".as_ptr(), r, got); }
    if got != 11i64 { return 1i32; }
    return 0i32;
}
