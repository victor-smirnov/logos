// h13: by-value Drop receiver reached through a BOUND (generic fn), not a local.
package h13;
struct S { v: i64, c: *mut i64 }
impl Drop for S { fn drop(self: S) { unsafe { *self.c = *self.c + 1i64; } } }
fn consume<T>(x: T) { let _y: T = x; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    consume(S { v: 1i64, c: p });
    let got: i64 = unsafe { n };
    return got as i32;
}
