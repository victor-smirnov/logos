// h1: by-value Drop receiver against the STDLIB Drop trait (&mut Self).
package h1;
extern fn printf(fmt: *const u8, ...) -> i32;
struct S { v: i64, c: *mut i64 }
impl Drop for S {
    fn drop(self: S) { unsafe { *self.c = *self.c + 1i64; } }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    { let s: S = S { v: 7i64, c: p }; }
    let got: i64 = unsafe { n };
    return got as i32;
}
