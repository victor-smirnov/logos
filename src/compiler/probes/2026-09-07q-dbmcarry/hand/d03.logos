package d03;
use logos.std.fmt;
struct S { pub n: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("D{}", self.n); } }
fn main() -> i32 {
    let arr: [i64; 2] = [3i64, 4i64];
    let mut out: i64 = 0i64;
    match &arr { [ref a, ref b] => { out = *a + *b; } }
    if out != 7i64 { return 1i32; }
    return 0i32;
}
