package c02;
use logos.std.fmt;
struct S { pub n: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("D{}", self.n); } }
struct W { pub s: S, pub k: i64 }
fn main() -> i32 {
    let p: (W, i64) = (W { s: S { n: 5i64 }, k: 1i64 }, 9i64);
    let mut out: i64 = 0i64;
    match &p {
        (W { s, k }, b) => { out = s.n + *k + *b; }
    }
    if out != 15i64 { return 1i32; }
    return 0i32;
}
