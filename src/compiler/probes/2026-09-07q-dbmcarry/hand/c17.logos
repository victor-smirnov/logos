package c17;
use logos.std.fmt;
struct S { pub n: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("D{}", self.n); } }
fn main() -> i32 {
    let arr: [(S, i64); 1] = [(S { n: 5i64 }, 9i64)];
    let mut out: i64 = 0i64;
    for (s, b) in &arr { out = out + s.n + *b; }
    if out != 14i64 { return 1i32; }
    return 0i32;
}
