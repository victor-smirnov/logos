package c11;
use logos.std.fmt;
struct S { pub n: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("D{}", self.n); } }
struct W { pub s: S }
enum Outer { V(W), Z }
fn main() -> i32 {
    let e: Outer = Outer::V(W { s: S { n: 5i64 } });
    let mut out: i64 = 0i64;
    match &e {
        Outer::V(W { s }) => { out = s.n; },
        Outer::Z => {}
    }
    if out != 5i64 { return 1i32; }
    return 0i32;
}
