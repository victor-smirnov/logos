package c15;
use logos.std.fmt;
struct S { pub n: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("D{}", self.n); } }
fn main() -> i32 {
    let p: (Option<S>, i64) = (Option::Some(S { n: 5i64 }), 9i64);
    let mut out: i64 = 0i64;
    let mut once: bool = true;
    while let (Option::Some(a), b) = &p {
        out = a.n + *b;
        if once { once = false; } else { break; }
        break;
    }
    if out != 14i64 { return 1i32; }
    return 0i32;
}
