package c08;
use logos.std.fmt;
struct S { pub n: i64 }
impl Drop for S { fn drop(self: &mut S) { println!("D{}", self.n); } }
struct W { pub s: S }
fn main() -> i32 {
    let arr: [W; 1] = [W { s: S { n: 5i64 } }];
    let mut out: i64 = 0i64;
    match &arr {
        [W { s }] => { out = s.n; }
    }
    if out != 5i64 { return 1i32; }
    return 0i32;
}
