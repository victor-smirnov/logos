// round 2026-09-17f, abuse xD — carrier: `@` binding UNDER the &-pattern, in a tuple pattern.
// rustc 1.98.1: E0507 cannot move out of a shared reference. MUST STAY REFUSED.
package xD_at_under_refpat;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
struct H { d: D }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let h: H = H { d: D { v: 5i64, c: p } };
    let r: &H = &h;
    let k: i32 = 1i32;
    match (r, k) {
        (&whole, j) => { unsafe { printf("got=%ld %d\n".as_ptr(), whole.d.v, j); } }
    }
    return 0i32;
}
