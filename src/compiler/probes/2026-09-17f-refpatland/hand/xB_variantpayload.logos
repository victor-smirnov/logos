// round 2026-09-17f, abuse xB — carrier: ENUM VARIANT PAYLOAD with Drop, under &&, in a tuple pattern.
// rustc 1.98.1: E0507 cannot move out of a shared reference. MUST STAY REFUSED.
package xB_variantpayload;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let o: Option<D> = Option::Some(D { v: 3i64, c: p });
    let r: &Option<D> = &o;
    let k: i32 = 1i32;
    match (r, k) {
        (&Option::Some(d), j) => { unsafe { printf("got=%ld %d\n".as_ptr(), d.v, j); } }
        (&Option::None, j) => { unsafe { printf("none %d\n".as_ptr(), j); } }
    }
    return 0i32;
}
