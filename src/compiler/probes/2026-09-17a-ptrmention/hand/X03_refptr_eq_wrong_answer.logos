// SECOND DEFECT, found by the ptrmention arm: a `&*mut T` PARAMETER compares the
// OUTER reference, not the raw pointer. Legal Rust (explicit 'a), rustc runs 0;
// armed logosc compiles and runs 1. On base the row is refused, so the wrong
// answer is invisible until the region door opens — doors in series.
package X03_refptr_eq_wrong_answer;
fn same<'a>(x: &*mut &'a i64, y: &*mut &'a i64) -> bool { return x == y; }
fn main() -> i32 {
    let mut a: i64 = 1i64;
    let mut ra: &i64 = &a;
    let p: *mut &i64 = &mut ra;
    let q: *mut &i64 = p;
    if same(&p, &q) { return 0i32; }
    return 1i32;
}
