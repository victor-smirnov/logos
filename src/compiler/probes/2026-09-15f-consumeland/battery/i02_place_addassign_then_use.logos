package i02_place_addassign_then_use;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct W { x: D, y: D, z: i64 }
impl Add for D {
    fn add(self: D, o: D) -> D {
        return D { v: 100i64, c: self.c };
    }
}
impl Neg for D {
    fn neg(self: D) -> D {
        return D { v: 1000i64, c: self.c };
    }
}
impl AddAssign for D {
    fn add_assign(self: &mut D, o: D) {
        self.v = self.v + 0i64;
    }
}
fn eat(d: D) -> i64 { return d.v; }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn g(p: *mut i64) -> i64 {
    let mut w: W = W { x: D { v: 1i64, c: p }, y: D { v: 10i64, c: p }, z: 5i64 };
    let d: D = D { v: 50i64, c: p };
    w.x += d;
    return eat(d);
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p);
    let got: i64 = rd(p);
    unsafe { printf("r=%ld n=%ld\n".as_ptr(), r, got); }
    if got != 0i64 { return 1i32; }
    return 0i32;
}
