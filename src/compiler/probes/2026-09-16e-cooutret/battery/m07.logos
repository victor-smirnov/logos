package m07;
fn a3<'a, 'b, 'c>(x: &mut &'a i64, y: &mut &'b i64, z: &mut &'c i64) -> i32 where 'b: 'a + 'c { *x = *y; *z = *y; return 0i32; }
fn c3<'a, 'b, 'c>(x: &mut &'a i64, y: &mut &'b i64, z: &mut &'c i64) -> i32 { return a3(x, y, z); }
fn main() -> i32 {
    let n: i64 = 1i64;
    let m: i64 = 2i64;
    let o: i64 = 3i64;
    let mut p: &i64 = &n;
    let mut q: &i64 = &m;
    let mut r: &i64 = &o;
    return c3(&mut p, &mut q, &mut r);
}
