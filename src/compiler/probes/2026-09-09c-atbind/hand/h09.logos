// h09 LEGAL: at-binding over a whole STRUCT value, field read through it. Rust: 0
package h09;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let p: P = P { x: 4i64, y: 2i64 };
    let mut out: i64 = 0i64;
    match p {
        a @ P { .. } => { out = a.x + a.y; }
    }
    if out != 6i64 { return 1i32; }
    return 0i32;
}
