// h13 LEGAL: at-binding with a match GUARD reading the binding. Rust: 0
package h13;
fn main() -> i32 {
    let v: i64 = 4i64;
    let mut out: i64 = 0i64;
    match v {
        n @ 1i64..=5i64 if n > 3i64 => { out = n; },
        _ => { out = -1i64; }
    }
    if out != 4i64 { return 1i32; }
    return 0i32;
}
