// h06 LEGAL: at-binding as SECOND tuple element. Rust: 0
package h06;
fn main() -> i32 {
    let t: (i64, i64) = (1i64, 2i64);
    let mut out: i64 = 0i64;
    match t {
        (a, b @ 1i64..=5i64) => { out = a + b; }
        (_, _) => { out = -1i64; }
    }
    if out != 3i64 { return 1i32; }
    return 0i32;
}
