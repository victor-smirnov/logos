// h18 LEGAL: at-binding as a tuple element whose sub is a NESTED TUPLE. Rust: 0
package h18;
fn main() -> i32 {
    let t: ((i64, i64), i64) = ((1i64, 2i64), 3i64);
    let mut out: i64 = 0i64;
    match t {
        (a @ (_, _), c) => { out = a.0 + a.1 + c; }
    }
    if out != 6i64 { return 1i32; }
    return 0i32;
}
