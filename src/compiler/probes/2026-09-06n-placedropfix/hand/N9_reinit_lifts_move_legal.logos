// N9 — LEGALITY, the (b) leg. Moving a tuple element out and then RE-INITIALISING
// it makes the element usable again; Rust accepts this. Must COMPILE, and the
// re-initialised value must be dropped: expected 1 (x) + 1000 (the new t.0) = 1001.
package N9_reinit_lifts_move_legal;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    {
        let mut t: (D, i64) = (D { v: 1i64, c: p }, 0i64);
        let x: D = t.0;
        t.0 = D { v: 1000i64, c: p };
        let y: i64 = t.0.v;
        if y != 1000i64 { return 4i32; }
        if x.v != 1i64 { return 5i32; }
    }
    let got: i64 = unsafe { n };
    unsafe { printf("COUNT=%ld\n".as_ptr(), got); }
    return 0i32;
}
