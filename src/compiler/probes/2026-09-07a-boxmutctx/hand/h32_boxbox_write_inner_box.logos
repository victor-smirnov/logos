package h32;
struct S { v: i64, i: *mut i64 }
impl Drop for S { fn drop(self: &mut S) { unsafe { *self.i = *self.i + self.v; } } }
fn main() -> i32 {
    let mut c: i64 = 0i64;
    let p: *mut i64 = &mut c;
    {
        let mut bb: Box<Box<S>> = Box::new(Box::new(S { v: 1i64, i: p }));
        *bb = Box::new(S { v: 10i64, i: p });
        if (**bb).v != 10i64 { return 2i32; }
    }
    if c != 11i64 { return 1i32; }
    return 0i32;
}
