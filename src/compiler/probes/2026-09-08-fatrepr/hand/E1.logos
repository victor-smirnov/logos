// E1 (enumunsize) — the ROW's shape: `&[i64;3]` into an `&[i64]` tuple-variant
// payload, then read back through the payload binder.
package e1;
enum E { N, S(&[i64]) }
fn main() -> i32 {
    let a: [i64; 3] = [1i64, 2i64, 3i64];
    let e: E = E::S(&a);
    match e {
        E::N => { return 1i32; }
        E::S(s) => { if s[2] != 3i64 { return 10i32; } }
    }
    return 0i32;
}
