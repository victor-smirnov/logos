// E3 (enumunsize) — a NON-ZERO argument index, and a second payload word after
// it, so a mis-stamped coercion would be visible as a shifted read.
package e3;
enum E { N, S(i64, &[i64]) }
fn main() -> i32 {
    let a: [i64; 2] = [4i64, 5i64];
    let e: E = E::S(1i64, &a);
    match e {
        E::N => { return 1i32; }
        E::S(k, s) => {
            if k != 1i64 { return 10i32; }
            if s[1] != 5i64 { return 11i32; }
        }
    }
    return 0i32;
}
