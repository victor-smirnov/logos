// E2 (enumunsize) — the STRUCT-VARIANT spelling of the same coercion.
package e2;
enum E { N, S { s: &[i64] } }
fn main() -> i32 {
    let a: [i64; 3] = [1i64, 2i64, 3i64];
    let e: E = E::S { s: &a };
    match e {
        E::N => { return 1i32; }
        E::S { s } => { if s[2] != 3i64 { return 10i32; } }
    }
    return 0i32;
}
