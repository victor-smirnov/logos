// M6 (dispunsize) — the ALREADY-TYPED twin: the argument is `Rc<dyn Sp>`
// before the call, so the method IS found today. It pins that the row is a
// COERCION-AT-SELECTION defect, not a hidden method.
package m6;
use logos.lang.rc;
trait Sp { fn v(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }
struct Holder { n: i64 }
impl Holder { pub fn eat(&self, r: Rc<dyn Sp>) -> i64 { return r.v() + self.n; } }
fn main() -> i64 {
    let h: Holder = Holder { n: 1i64 };
    let rc: Rc<A> = rc_new(A { x: 17i64 });
    let rd: Rc<dyn Sp> = rc;
    if h.eat(rd) != 18i64 { return 1i64; }
    return 0i64;
}
