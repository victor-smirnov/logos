// EXPECT 1011 -- the INDEX half of the same intersection. NOTE: this shape also
// touches the DECLINED block (gen_lvalue_addr through a reference-typed local); the
// explicit `(*q)` spelling is the one that block measured as CORRECT, so a wrong
// answer here is this block's, not that one's.
package X2_deref_array_elem;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    {
        let mut a: [D; 2] = [D { v: 1i64, c: p }, D { v: 10i64, c: p }];
        let q: &mut [D; 2] = &mut a;
        (*q)[0] = D { v: 1000i64, c: p };
    }
    unsafe { printf("COUNT=%ld\n".as_ptr(), n); }
    return 0i32;
}
