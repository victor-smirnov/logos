// EXPECT 1011 -- KIND and ROOT at once: a TUPLE_INDEX place over a DEREF root.
// No single-axis arm can close this; only the pair can. This is the additivity
// question (Rule 13) made into a program.
package X1_deref_tuple_elem;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    {
        let mut t: (D, D) = (D { v: 1i64, c: p }, D { v: 10i64, c: p });
        let q: &mut (D, D) = &mut t;
        (*q).0 = D { v: 1000i64, c: p };
    }
    unsafe { printf("COUNT=%ld\n".as_ptr(), n); }
    return 0i32;
}
