// EXPECT 1011 -- a RUNTIME subscript. There is no static path at all here, so
// this is the shape that says whether the coarsening to the container root is what
// carries the arm, or whether a constant subscript was doing the work.
package I2_array_elem_runtime_index;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut i: i64 = 0i64;
    {
        let mut a: [D; 2] = [D { v: 1i64, c: p }, D { v: 10i64, c: p }];
        i = i + 1i64;
        a[i] = D { v: 1000i64, c: p };
    }
    unsafe { printf("COUNT=%ld\n".as_ptr(), n); }
    return 0i32;
}
