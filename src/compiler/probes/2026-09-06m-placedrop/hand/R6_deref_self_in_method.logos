// EXPECT 1001 -- `(*self).f = new` inside a method. The comment at the defect
// site names this very spelling as the motivating case ("Writing `(*self).f = new`
// through a unique borrow overwrites a LIVE field"), so the rule was WRITTEN for a
// shape the code then failed to reach.
package R6_deref_self_in_method;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct W { d: D, k: i64 }
impl W {
    fn put(self: &mut W, nd: D) { (*self).d = nd; }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    {
        let mut w: W = W { d: D { v: 1i64, c: p }, k: 5i64 };
        w.put(D { v: 1000i64, c: p });
    }
    unsafe { printf("COUNT=%ld\n".as_ptr(), n); }
    return 0i32;
}
