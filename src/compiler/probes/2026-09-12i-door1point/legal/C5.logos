// C5 — SHADOWING ACROSS TWO SEPARATE LOOPS, same holder NAME. The second
// loop's `r` is a different binding; a name-keyed predicate would let the
// first loop's last-use line decide the second loop's loan.
package c5;
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let mut m: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < 2i64 {
        let r: &mut i64 = &mut n;
        *r = *r + 1i64;
        i = i + 1i64;
    }
    let mut k: i64 = 0i64;
    while k < 2i64 {
        let r: &mut i64 = &mut m;
        *r = *r + 2i64;
        k = k + 1i64;
    }
    return (n + m - 6i64) as i32;
}
