// SOUNDNESS QUEUE row extended_field_base_temp_dropped_at_let_end_run (tier 1, run 1). AN EXTENDED BORROW OF A FIELD OF A TEMPORARY DROPS THE TEMPORARY AT THE END OF THE `let`.
// `let k: &D = &W { x: .., y: .., z: 3 }.y;` extends the temporary W to the end of the block (Rust
// r[destructors.scope.lifetime-extension.exprs]: the operand of an extending borrow, through a field projection). TODAY
// SemaChecker::lower_field_read hoists the base into the STATEMENT temp scope (hoist_stmt_temp) whatever the borrow is, so both
// destructors have run when the next statement reads the counter: seen=11 (rustc 0), exit 1. `k` then reads a dropped value
// (a stack slot here, so valgrind is silent: 0 errors).
// NEIGHBOUR of aggregate_literal_temp_place_base_never_dropped_run, found by round 2026-09-15g-aggtemp (hand c01 / c11). Its
// priced arm `ptext` (the extending borrow's place chain carries `pt_ext_place_ctx_`; the base gets a BLOCK owner) closes it:
// seen 11 -> 0 under ptext / ptown / ptownx / ptownxf (build 70a78549838d6b7f).
package extended_field_base_temp_dropped_at_let_end_run;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
struct W { x: D, y: D, z: i64 }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut seen: i64 = -1i64;
    {
        let k: &D = &W { x: D { v: 1i64, c: p }, y: D { v: 10i64, c: p }, z: 3i64 }.y;
        seen = unsafe { *p };
        if k.v != 10i64 { return 3i32; }
    }
    let got: i64 = unsafe { n };
    unsafe { printf("seen=%ld n=%ld\n".as_ptr(), seen, got); }
    if got != 11i64 { return 2i32; }
    if seen != 0i64 { return 1i32; }
    return 0i32;
}
