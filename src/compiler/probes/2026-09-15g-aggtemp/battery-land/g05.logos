package g05;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn mktup(a: D, b: D) -> (D, D) { return (a, b); }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let mut k: i64 = 0i64;
    {
        k = mktup(D { v: 1i64, c: p }, D { v: 10i64, c: p }).1.v;
    }
    let got: i64 = unsafe { n };
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); }
    if k != 10i64 { return 3i32; }
    if got != 11i64 { return 1i32; }
    return 0i32;
}
