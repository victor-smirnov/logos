package g08;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c + self.v; } } }
fn g(p: *mut i64) -> i64 {
    if [D { v: 1i64, c: p }, D { v: 10i64, c: p }][1].v == 10i64 {
        return 5i64;
    }
    return 0i64;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = g(p);
    let got: i64 = unsafe { n };
    unsafe { printf("r=%ld n=%ld\n".as_ptr(), r, got); }
    if r != 5i64 { return 3i32; }
    if got != 11i64 { return 1i32; }
    return 0i32;
}
