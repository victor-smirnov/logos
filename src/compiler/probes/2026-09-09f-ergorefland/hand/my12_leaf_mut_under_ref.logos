// CLASS PROBE for the LANDED `mut` half: a written `mut` at a struct-field
// SUB-PATTERN (a LEAF binder) under a `&` scrutinee. Same rule, same door the
// `ref` half's whole cost sits at.
package my12;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let p: P = P { x: 3i64, y: 4i64 };
    let mut out: i64 = 0i64;
    match &p {
        P { x: mut v, .. } => { v = v + 1i64; out = v; }
    }
    if out != 4i64 { return 1i32; }
    return 0i32;
}
