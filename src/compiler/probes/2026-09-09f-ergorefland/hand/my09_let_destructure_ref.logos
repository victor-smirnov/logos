// CLASS PROBE: the `let` statement is a pattern door too. A written `ref`
// under a by-reference scrutinee is the SAME rule; is `let` a member?
package my09;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let p: P = P { x: 3i64, y: 4i64 };
    let P { x: ref v, .. } = &p;
    if *v != 3i64 { return 1i32; }
    return 0i32;
}
