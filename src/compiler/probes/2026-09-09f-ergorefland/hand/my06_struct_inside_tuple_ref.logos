// ILLEGAL 2024: a STRUCT pattern with a written `ref` sitting inside a TUPLE
// pattern under `&` — the two container doors in series.
package my06;
struct P { x: i64, y: i64 }
fn main() -> i32 {
    let t: (P, i64) = (P { x: 3i64, y: 4i64 }, 5i64);
    let mut out: i64 = 0i64;
    match &t {
        (P { ref x, y }, z) => { out = *x + *y + *z; }
    }
    if out != 12i64 { return 1i32; }
    return 0i32;
}
