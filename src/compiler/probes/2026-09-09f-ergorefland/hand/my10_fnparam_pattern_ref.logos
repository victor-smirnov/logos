// CLASS PROBE: a FUNCTION PARAMETER pattern with a written `ref` and a
// by-reference parameter type.
package my10;
struct P { x: i64, y: i64 }
fn f(P { x: ref v, .. }: &P) -> i64 { return *v; }
fn main() -> i32 {
    let p: P = P { x: 3i64, y: 4i64 };
    if f(&p) != 3i64 { return 1i32; }
    return 0i32;
}
