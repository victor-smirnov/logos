// CLASS PROBE for the LANDED `mut` half: a written `mut` at a TUPLE element
// under a `&` scrutinee.
package my14;
fn main() -> i32 {
    let t: (i64, i64) = (7i64, 8i64);
    let mut out: i64 = 0i64;
    match &t {
        (mut a, b) => { a = a + 1i64; out = a + b; }
    }
    if out != 16i64 { return 1i32; }
    return 0i32;
}
