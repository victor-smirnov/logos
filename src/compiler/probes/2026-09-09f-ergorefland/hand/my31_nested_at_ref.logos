// Residual-door check: a written `ref` on an `@` binding NESTED inside a container,
// under a `&` scrutinee. PAT_AT is not a leaf, so `dbm_sub_ty` does not answer it.
package my31;
fn main() -> i32 {
    let o: Option<i64> = Option::Some(3i64);
    let mut out: i64 = 0i64;
    match &o {
        Option::Some(ref w @ 1i64..=9i64) => { out = *w; }
        _ => {}
    }
    if out != 3i64 { return 1i32; }
    return 0i32;
}
