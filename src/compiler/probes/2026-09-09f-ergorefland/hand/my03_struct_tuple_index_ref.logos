// ILLEGAL 2024: written `ref` behind a struct-pattern TUPLE INDEX (`TS { 0: ref a }`).
package my03;
struct TS(i64, i64);
fn main() -> i32 {
    let t: TS = TS(5i64, 6i64);
    let mut out: i64 = 0i64;
    match &t {
        TS { 0: ref a, 1: b } => { out = *a + *b; }
    }
    if out != 11i64 { return 1i32; }
    return 0i32;
}
