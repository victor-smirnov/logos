package g3_read_after_addr;
struct D { v: i64 }
fn h(a: &&D) -> i64 {
    return a.v;
}
fn g(x: &D) -> i64 {
    let s: i64 = h(&x);
    let w: *const D = x as *const D;
    let d2: &D = unsafe { &*w };
    return s + x.v + d2.v;
}
fn main() -> i32 {
    let d: D = D { v: 6i64 };
    if g(&d) != 18i64 { return 3i32; }
    return 0i32;
}
