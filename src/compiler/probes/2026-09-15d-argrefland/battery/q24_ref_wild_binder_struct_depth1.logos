package q24_ref_wild_binder_struct_depth1;
struct P { x: i32, y: i32 }
fn main() -> i32 {
    let p = P { x: 5i32, y: 6i32 };
    let r: &P = &p;
    match r { q => { if q.y != 6i32 { return 24i32; } } }
    let a: i32 = match r { q => q.y };
    if a != 6i32 { return 25i32; }
    let rr: &&P = &r;
    match rr { q => { if q.y != 6i32 { return 26i32; } } }
    return 0i32;
}
