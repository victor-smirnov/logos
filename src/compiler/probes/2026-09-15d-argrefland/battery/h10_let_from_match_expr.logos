package h10_let_from_match_expr;
struct D { v: i64 }
fn inner(a: &&D) -> i64 {
    let x: &D = *a;
    return x.v;
}
fn pick(k: i64) -> i64 {
    let d1: D = D { v: 6i64 };
    let d2: D = D { v: 8i64 };
    let rd: &D = match k { 0i64 => &d1, _ => &d2 };
    return inner(&rd);
}
fn main() -> i32 {
    if pick(0i64) != 6i64 { return 10i32; }
    if pick(1i64) != 8i64 { return 11i32; }
    return 0i32;
}
