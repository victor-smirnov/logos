package h07_foreach_tuple_elem;
fn inner(a: &&(i64, i64)) -> i64 {
    let x: &(i64, i64) = *a;
    return x.1;
}
fn main() -> i32 {
    let arr: [(i64, i64); 2] = [(1i64, 2i64), (3i64, 4i64)];
    let s: &[(i64, i64)] = &arr;
    let mut sum: i64 = 0i64;
    for x in s {
        sum = sum + inner(&x);
    }
    if sum != 6i64 { return 7i32; }
    return 0i32;
}
