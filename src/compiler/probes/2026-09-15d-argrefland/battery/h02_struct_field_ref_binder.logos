package h02_struct_field_ref_binder;
struct D { v: i64 }
struct W { k: i64, inner: D }
fn inner(a: &&D) -> i64 {
    let x: &D = *a;
    return x.v;
}
fn main() -> i32 {
    let w: W = W { k: 1i64, inner: D { v: 6i64 } };
    match w {
        W { k: _, inner: ref q } => {
            if inner(&q) != 6i64 { return 2i32; }
        }
    }
    return 0i32;
}
