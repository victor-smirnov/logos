package q19_refref_wild_full_peel_stmt;
struct P { x: i32, y: i32 }
impl Copy for P {}
impl Clone for P { fn clone(self: &Self) -> P { return P { x: self.x, y: self.y }; } }
fn main() -> i32 {
    let p = P { x: 5i32, y: 6i32 };
    let r: &P = &p;
    let pp: &&P = &r;
    match pp { &&q => { if q.y != 6i32 { return 19i32; } } }
    match pp { &q => { if q.y != 6i32 { return 20i32; } } }
    return 0i32;
}
