package q16_refref_drop_count;
struct P { x: i32, n: *mut i64 }
impl Drop for P {
    fn drop(self: &mut Self) { unsafe { *self.n = *self.n + 1i64; } }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let pn: *mut i64 = &mut n as *mut i64;
    {
        let p = P { x: 5i32, n: pn };
        let r: &P = &p;
        let pp: &&P = &r;
        let mut s: i32 = 0i32;
        match pp { &&P { x, n: _ } => { s = s + x; } }
        let t: i32 = match pp { &&P { x, n: _ } => x };
        if s + t != 10i32 { return 16i32; }
    }
    return (n as i32) - 1i32;
}
