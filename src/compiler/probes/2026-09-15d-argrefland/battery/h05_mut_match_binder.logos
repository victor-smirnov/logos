package h05_mut_match_binder;
struct D { v: i64 }
fn bump(a: &&mut D) -> i64 {
    return a.v + 1i64;
}
fn main() -> i32 {
    let mut o: Option<D> = Option::Some(D { v: 6i64 });
    match &mut o {
        Option::Some(rd) => {
            if bump(&rd) != 7i64 { return 5i32; }
            rd.v = 9i64;
        }
        Option::None => { return 90i32; }
    }
    match o {
        Option::Some(d) => { if d.v != 9i64 { return 50i32; } }
        Option::None => { return 91i32; }
    }
    return 0i32;
}
