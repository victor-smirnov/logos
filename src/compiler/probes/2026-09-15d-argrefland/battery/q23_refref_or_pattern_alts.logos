package q23_refref_or_pattern_alts;
struct P { x: i32, y: i32 }
fn pick(pp: &&P) -> i32 {
    match pp {
        &&P { x: 1i32, y } | &&P { x: 2i32, y } => y,
        _ => 99i32,
    }
}
fn main() -> i32 {
    let p = P { x: 2i32, y: 6i32 };
    let r: &P = &p;
    if pick(&r) != 6i32 { return 23i32; }
    let q = P { x: 3i32, y: 6i32 };
    let rq: &P = &q;
    if pick(&rq) != 99i32 { return 24i32; }
    return 0i32;
}
