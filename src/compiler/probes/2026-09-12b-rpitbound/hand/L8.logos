package L8;
trait Speak { fn speak(&self) -> i64; }
struct W<T> { v: T }
impl<T> Speak for W<T> {
    fn speak(&self) -> i64 { return 11i64; }
}
// LEGAL: satisfied through a GENERIC impl, not a concrete one.
fn mk() -> impl Speak {
    return W::<i64> { v: 1i64 };
}
fn main() -> i32 {
    let s = mk();
    return s.speak() as i32;
}
