package a06_boolreford;
extern fn printf(fmt: *const u8, ...) -> i32;
fn main() -> i32 {
    let f: bool = false;
    let t: bool = true;
    let rf: &bool = &f;
    let rt: &bool = &t;
    let lt: bool = rf < rt;
    unsafe { printf("lt=%d\n".as_ptr(), lt as i32); }
    if !lt { return 1i32; }
    return 0i32;
}
