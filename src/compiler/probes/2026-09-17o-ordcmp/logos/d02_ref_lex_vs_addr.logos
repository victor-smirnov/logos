package d02_ref_lex_vs_addr;
extern fn printf(fmt: *const u8, ...) -> i32;
fn cmp2<T: Ord>(a: &T, b: &T) -> bool {
    return a < b;
}
fn main() -> i32 {
    let big: i64 = 100i64;
    let small: i64 = 1i64;
    let lt: bool = cmp2::<i64>(&big, &small);
    unsafe { printf("lt=%d\n".as_ptr(), lt as i32); }
    if lt { return 1i32; }
    return 0i32;
}
