package c01_mutptr_gt;
extern fn printf(fmt: *const u8, ...) -> i32;
fn main() -> i32 {
    let mut a: [i64; 4] = [1i64, 2i64, 3i64, 4i64];
    let p: *mut i64 = &mut a[0u64] as *mut i64;
    let q: *mut i64 = &mut a[3u64] as *mut i64;
    let g: bool = q > p;
    let le: bool = p <= q;
    let ge: bool = p >= q;
    unsafe { printf("g=%d le=%d ge=%d\n".as_ptr(), g as i32, le as i32, ge as i32); }
    if !g { return 1i32; }
    if !le { return 2i32; }
    if ge { return 3i32; }
    return 0i32;
}
