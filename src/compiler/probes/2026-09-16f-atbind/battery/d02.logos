// hand battery: round 2026-09-16f-atbind, program d02 — STATEMENT door twin of d01 — which door decides
// found by asking tools/dlog which binder contexts write scope_ without recording a shape
package d02;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
struct W { a: D, b: i64 }
fn g(p: *mut i64) -> i64 {
    let w: W = W { a: D { v: 2i64, c: p }, b: 3i64 };
    match w { W { a: q, b: _ } => { return q.v; } }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, rd(p)); }
    if k != 2i64 { return 2i32; }
    if rd(p) != 2i64 { return 1i32; }
    return 0i32;
}
