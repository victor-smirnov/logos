// hand battery: round 2026-09-16f-atbind, program b05 — while-let with an @ binder over a struct
// legality: rustc 1.98.1 twin measured (see rust/b05.rs)
package b05;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
struct W { a: D, b: i64 }
fn g(p: *mut i64) -> i64 {
    let mut o: Option<W> = Option::Some(W { a: D { v: 2i64, c: p }, b: 3i64 });
    let mut k: i64 = 0i64;
    while let Option::Some(y @ W { .. }) = o {
        k = y.b;
        o = Option::None;
    }
    return k;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, rd(p)); }
    if k != 3i64 { return 2i32; }
    if rd(p) != 2i64 { return 1i32; }
    return 0i32;
}
