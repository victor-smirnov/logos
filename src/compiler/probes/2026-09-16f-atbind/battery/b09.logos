// hand battery: round 2026-09-16f-atbind, program b09 — @ binder over a GENERIC struct instance
package b09;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
struct P<T> { x: T, d: D }
fn g(p: *mut i64) -> i64 {
    let s: P<i64> = P::<i64> { x: 4i64, d: D { v: 2i64, c: p } };
    match s {
        y @ P { .. } => { return y.x; }
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, rd(p)); }
    if k != 4i64 { return 2i32; }
    if rd(p) != 2i64 { return 1i32; }
    return 0i32;
}
