// hand battery: round 2026-09-16f-atbind, program b06 — @ binder read twice, with a live sibling Drop local
// legality: rustc 1.98.1 twin measured (see rust/b06.rs)
package b06;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
struct W { a: D, b: i64 }
fn g(p: *mut i64) -> i64 {
    let x: D = D { v: 1i64, c: p };
    let w: W = W { a: D { v: 2i64, c: p }, b: 3i64 };
    let mut k: i64 = 0i64;
    match w {
        y @ W { .. } => { k = y.b + y.b; }
    }
    return k + x.v;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, rd(p)); }
    if k != 7i64 { return 2i32; }
    if rd(p) != 21i64 { return 1i32; }
    return 0i32;
}
