// hand battery: round 2026-09-16f-atbind, program b08 — @ binder over an ARRAY of Drop elements
package b08;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn g(p: *mut i64) -> i64 {
    let arr: [D; 2] = [D { v: 2i64, c: p }, D { v: 3i64, c: p }];
    match arr {
        y @ [_, _] => { return 9i64; }
    }
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, rd(p)); }
    if k != 9i64 { return 2i32; }
    if rd(p) != 23i64 { return 1i32; }
    return 0i32;
}
