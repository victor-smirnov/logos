// hand battery: round 2026-09-16f-atbind, program b07 — @ binder whose sub-pattern is an OR of two variants
package b07;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
enum E { A(i64), B(i64) }
fn g() -> i64 {
    let e: E = E::B(7i64);
    match e {
        y @ (E::A(_) | E::B(_)) => { return 5i64; }
    }
}
fn main() -> i32 {
    let k: i64 = g();
