// hand battery: round 2026-09-16f-atbind, program b12 — CONTROL: @ binder over a NON-Drop struct (aggregate without drop glue)
package b12;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
struct Q { u: i64, w: i64 }
fn g() -> i64 {
    let q: Q = Q { u: 6i64, w: 8i64 };
    match q {
        y @ Q { .. } => { return y.u * 10i64 + y.w; }
    }
}
fn main() -> i32 {
    let k: i64 = g();
    unsafe { printf("k=%ld\n".as_ptr(), k); }
    if k != 68i64 { return 1i32; }
    return 0i32;
}
