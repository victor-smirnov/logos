// hand battery: round 2026-09-16f-atbind, program c03 — EXPRESSION-position @ binder, METHOD call on the binder
package c03;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
struct W { a: D, b: i64 }
impl W { fn get(self: &W) -> i64 { return self.b; } }
fn g(p: *mut i64) -> i64 {
    let w: W = W { a: D { v: 2i64, c: p }, b: 3i64 };
    let k: i64 = match w { y @ W { .. } => y.get() };
    return k;
}
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let k: i64 = g(p);
    unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, rd(p)); }
    if k != 3i64 { return 2i32; }
    if rd(p) != 2i64 { return 1i32; }
    return 0i32;
}
