package b_fnp_arr_drop;
struct O { v: i64, c: *mut i64 }
impl Drop for O { fn drop(self: &mut O) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn probe([a, b]: [O; 2]) -> i64 { return a.v + b.v; }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    let r: i64 = probe([O { v: 1i64, c: p }, O { v: 2i64, c: p }]);
    if r != 3i64 { return 2i32; }
    let got: i64 = unsafe { n };
    if got != 12i64 { return 1i32; }
    return 0i32;
}
