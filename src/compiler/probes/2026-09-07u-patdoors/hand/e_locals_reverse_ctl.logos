package e_locals_reverse_ctl;
struct O { v: i64, c: *mut i64 }
impl Drop for O { fn drop(self: &mut O) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn main() -> i32 {
    let mut n: i64 = 0i64;
    let p: *mut i64 = &mut n;
    { let x: O = O { v: 1i64, c: p }; let y: O = O { v: 2i64, c: p }; let z: O = O { v: 3i64, c: p }; let r: i64 = x.v + y.v + z.v; if r != 6i64 { return 2i32; } }
    let got: i64 = unsafe { n };
    if got != 321i64 { return 1i32; }
    return 0i32;
}
