package b04;
extern fn printf(fmt: *const u8, ...) -> i32;
struct D { v: i64, c: *mut i64 }
impl Drop for D { fn drop(self: &mut D) { unsafe { *self.c = *self.c * 10i64 + self.v; } } }
fn rd(p: *mut i64) -> i64 { return unsafe { *p }; }
fn g(p: *mut i64) -> i64 { let arr: [D; 2] = [D { v: 2i64, c: p }, D { v: 3i64, c: p }];
  let k: i64 = match arr { [z, b] => z.v + b.v }; return k; }
fn main() -> i32 { let mut n: i64 = 0i64; let p: *mut i64 = &mut n;
  let k: i64 = g(p); let got: i64 = rd(p);
  unsafe { printf("k=%ld n=%ld\n".as_ptr(), k, got); } return 0i32; }
