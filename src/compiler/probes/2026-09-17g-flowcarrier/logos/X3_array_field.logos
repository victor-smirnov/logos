package X3_array_field;
struct AH<'a> { a: [*const &'a i64; 2] }
fn first<'a>(h: AH<'a>) -> &'a i64 {
    return unsafe { *h.a[0] };
}
fn escape() -> &'static i64 {
    let v: i64 = 6i64;
    let r: &i64 = &v;
    let h: AH = AH { a: [&r, &r] };
    return first(h);
}
fn main() -> i32 {
    let out: &i64 = escape();
    return *out as i32;
}
