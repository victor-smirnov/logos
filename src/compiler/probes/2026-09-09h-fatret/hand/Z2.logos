// Z2: CLASS MEMBER PROBE — FatZoneMut RETURNED from a function. The fat
// {data,zone} pair is 16B storage; llvm_fn_ret_type has no branch for
// FatZoneMut, so the fn returns a pointer to a frame-local pair. The zone
// half is the observable: it must survive the return.
package Z2;
extern fn malloc(n: i64) -> *mut u8;
#[zone_mut] struct Cell { v: i64 }
unsafe fn reborrow(r: &mut Cell) -> &mut Cell {
    return r;
}
unsafe fn churn(n: i64) -> i64 {
    let a: i64 = n * 3i64;
    let b: i64 = a + 7i64;
    return b * 2i64;
}
unsafe fn main() -> i32 {
    let p: *mut Cell = malloc(8i64) as *mut Cell;
    (*p).v = 42i64;
    let r: &mut Cell = zone_mut_ref::<Cell>(p, 12345i64 as *mut u8);
    let q: &mut Cell = reborrow(r);
    let junk: i64 = churn(5i64);
    if junk == 0i64 { return 4i32; }
    if q.v != 42i64 { return 1i32; }
    if (zone_of(q) as i64) != 12345i64 { return 2i32; }
    return 0i32;
}
