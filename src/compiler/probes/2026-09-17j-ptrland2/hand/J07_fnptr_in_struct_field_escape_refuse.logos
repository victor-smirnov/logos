package J07_fnptr_in_struct_field_escape_refuse;
struct H<'r> { f: fn(&'r i64) -> &'r i64 }
fn run<'r>(h: H<'r>, x: &'r i64) -> &'r i64 {
    let g: fn(&'r i64) -> &'r i64 = h.f;
    return g(x);
}
fn id(x: &i64) -> &i64 { return x; }
fn main() -> i32 {
    let out: &i64;
    {
        let v: i64 = 3i64;
        out = run(H { f: id }, &v);
    }
    return *out as i32;
}
