package g17;
fn pick(p: &i64) -> i64 {
    match p {
        3i64 => { return 30i64; }
        4i64 => { return 40i64; }
        _ => { return 0i64; }
    }
}
fn main() -> i32 {
    let v: i64 = 4i64;
    if pick(&v) != 40i64 { return 1i32; }
    let w: i64 = 3i64;
    if pick(&w) != 30i64 { return 2i32; }
    let z: i64 = 9i64;
    if pick(&z) != 0i64 { return 3i32; }
    return 0i32;
}
