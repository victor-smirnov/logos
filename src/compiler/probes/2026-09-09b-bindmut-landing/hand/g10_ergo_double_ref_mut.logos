package g10_ergo_double_ref_mut;
fn main() -> i32 {
    let o: Option<i64> = Option::Some(3i64);
    let r: &Option<i64> = &o;
    let mut out: i64 = 0i64;
    match &r {
        Option::Some(mut n) => { n = n + 1i64; out = n; }
        Option::None => {}
    }
    if out != 4i64 { return 1i32; }
    return 0i32;
}
