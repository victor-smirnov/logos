package l13_illegal_unsized_behind_dynptee;
trait Tr { fn m(self: &Self) -> i64; }
struct S { v: i64 }
impl Tr for S { fn m(self: &Self) -> i64 { return self.v; } }
fn take(a: &&dyn Tr) -> i64 {
    let y: dyn Tr = **a;
    return y.m();
}
fn main() -> i32 {
    let s: S = S { v: 1i64 };
    let rd: &dyn Tr = &s;
    return (take(&rd) - 1i64) as i32;
}
