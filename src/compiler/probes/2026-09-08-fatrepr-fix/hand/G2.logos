// G2 LEGAL — the MUTABLE unsize `&mut [i64;3]` -> `&mut [i64]` in a payload,
// written THROUGH the binder and read back from the array afterwards.
package g2;
enum E { N, S(&mut [i64]) }
fn main() -> i32 {
    let mut a: [i64; 3] = [1i64, 2i64, 3i64];
    let e: E = E::S(&mut a);
    match e {
        E::N => { return 1i32; }
        E::S(s) => { s[1] = 42i64; }
    }
    if a[1] != 42i64 { return 10i32; }
    return 0i32;
}
