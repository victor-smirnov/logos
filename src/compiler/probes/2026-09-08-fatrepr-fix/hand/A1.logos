// A1 — CLASS PROBE, not a target: the ARRAY-literal element position carries
// ARRAY_TO_SLICE|WIDEN_INT and NOT CLOSURE_TO_FNPTR. Legal Rust; measured to
// say whether the aggregate-element class has a member beyond the enum ctor.
package a1;
fn main() -> i32 {
    let fs: [fn(i64) -> i64; 2] = [|x: i64| -> i64 { return x + 1i64; },
                                   |x: i64| -> i64 { return x + 2i64; }];
    if fs[0](41i64) != 42i64 { return 10i32; }
    return 0i32;
}
