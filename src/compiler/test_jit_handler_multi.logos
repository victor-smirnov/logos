// Phase 7 slice 14: multiple handlers per trigger. Two
// #[metaprog_handler("derive_pair")] fns both fire on each
// #[derive_pair]-annotated item, in source-declaration order.
// One emits `pair_a_<NAME>`, the other `pair_b_<NAME>`. Test
// asserts both symbols appear for the single struct Solo.
package test;

use std.hermes.view;
use std.hermes.anyval;
use std.hermes.string;
use std.compiler.metaprog;

#[metaprog_handler("derive_pair")]
fn pair_a_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }
    let item: AnyVal = AnyVal::from_offset(target_offset);
    let name_val: AnyVal = view.tiny_map_get(item, 1 as u8);
    let name: StringView = view.get_str_view(name_val);
    if name.len == (0 as u64) { return; }
    let mut em: Emitter = Emitter::new();
    em.emit_fn_i64_named("gen", "pair_a_", name, "", 1 as u64);
    return;
}

#[metaprog_handler("derive_pair")]
fn pair_b_hook(target_offset: u32) -> () {
    let view: OView = oview_module_ast();
    if view.holder == (0 as *mut u8) { return; }
    let item: AnyVal = AnyVal::from_offset(target_offset);
    let name_val: AnyVal = view.tiny_map_get(item, 1 as u8);
    let name: StringView = view.get_str_view(name_val);
    if name.len == (0 as u64) { return; }
    let mut em: Emitter = Emitter::new();
    em.emit_fn_i64_named("gen", "pair_b_", name, "", 2 as u64);
    return;
}

#[derive_pair]
struct Solo { x: i32 }

fn main() -> i32 { return 0; }
