// COUNTER-EXAMPLE root 2 — NESTED struct pattern over an OWNED source.
// Rust: `s` owns the inner Owner; exactly ONE destructor run.
package c2_nested;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
static mut N: i64 = 0i64;
struct Owner { k: i64 }
impl Drop for Owner { fn drop(self: Owner) { unsafe { N = N + 1i64; } } }
struct B { o: Owner }
struct A { b: B, t: i64 }
fn main() -> i32 {
    {
        let a: A = A { b: B { o: Owner { k: 7i64 } }, t: 2i64 };
        let A { b: B { o: v }, t: w } = a;
        if v.k + w != 9i64 { return 3i32; }
    }
    unsafe {
        printi("N=%d\n", N as i32);
        if N != 1i64 { return 1i32; }
    }
    return 0i32;
}
