// COUNTER-EXAMPLE root 3 — a type with BOTH an inherent `drop` AND a real
// `impl Drop`. Rust runs the trait one at scope exit and NEVER the inherent one;
// the inherent one stays callable by hand. Two counters separate them.
package c3_both;
extern fn printf(fmt: *const u8, ...) -> i32;
fn printi(fmt: str, v: i32) { unsafe { printf(fmt.as_ptr(), v); } }
static mut TN: i64 = 0i64;
static mut IN_: i64 = 0i64;
struct S { k: i64 }
impl S { fn drop(self: &mut Self) { unsafe { IN_ = IN_ + 1i64; } } }
impl Drop for S { fn drop(self: S) { unsafe { TN = TN + 1i64; } } }
fn main() -> i32 {
    {
        let s: S = S { k: 4i64 };
        if s.k != 4i64 { return 3i32; }
    }
    unsafe {
        printi("TN=%d\n", TN as i32);
        printi("IN=%d\n", IN_ as i32);
        if TN != 1i64 { return 1i32; }
        if IN_ != 0i64 { return 2i32; }
    }
    return 0i32;
}
