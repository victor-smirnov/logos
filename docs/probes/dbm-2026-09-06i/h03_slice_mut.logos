// h03: SLICE door, Copy element under &mut — census twin, NO ROW today.
package h03;
fn main() -> i32 {
    let mut arr: [i64; 2] = [3i64, 4i64];
    match &mut arr {
        [a, b] => { *a = *a + 1i64; if *b != 4i64 { return 2i32; } }
    }
    if arr[0] != 4i64 { return 1i32; }
    return 0i32;
}
