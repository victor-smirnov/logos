// h15: CONTROL — the VARIANT-payload door, which already dropped the carve-out
// (logos-core 4.3). A Copy payload under &mut must already work; unchanged.
package h15;
enum E { N(i64), Z }
fn main() -> i32 {
    let mut e: E = E::N(3i64);
    match &mut e {
        E::N(n) => { *n = *n + 1i64; }
        E::Z => { return 2i32; }
    }
    match e {
        E::N(v) => { if v != 4i64 { return 1i32; } }
        E::Z => { return 3i32; }
    }
    return 0i32;
}
