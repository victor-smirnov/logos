// h10: CONTROL — a MOVE element under &mut. is_move_type is TRUE, so the wrap
// already happens today. This arm must be UNCHANGED by any fix.
package h10;
struct B { v: Vec<i64> }
fn main() -> i32 {
    let mut t: (B, i64) = (B { v: Vec::new() }, 4i64);
    match &mut t {
        (a, b) => { a.v.push(1i64); if *b != 4i64 { return 2i32; } }
    }
    if t.0.v.len() != 1u64 { return 1i32; }
    return 0i32;
}
