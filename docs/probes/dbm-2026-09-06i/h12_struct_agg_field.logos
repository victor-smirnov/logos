// h12: CONTROL — a STRUCT-TYPED field under &mut. Codegen's aggregate branch
// binds the GEP address already, so this arm must be correct TODAY and
// UNCHANGED by any probe.
package h12;
struct In { v: i64 }
struct Out { i: In, y: i64 }
fn main() -> i32 {
    let mut o: Out = Out { i: In { v: 3i64 }, y: 4i64 };
    match &mut o {
        Out { i, y } => { i.v = i.v + 1i64; if *y != 4i64 { return 2i32; } }
    }
    if o.i.v != 4i64 { return 1i32; }
    return 0i32;
}
