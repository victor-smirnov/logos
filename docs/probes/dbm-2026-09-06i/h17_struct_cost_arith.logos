// h17: COST SHAPE at the STRUCT door — Copy field under shared `&`, arithmetic.
package h17;
struct S { x: i64, y: i64 }
fn main() -> i32 {
    let s: S = S { x: 3i64, y: 4i64 };
    let mut acc: i64 = 0i64;
    match &s {
        S { x, y } => { acc = x + y; }
    }
    if acc != 7i64 { return 1i32; }
    return 0i32;
}
