// h02: STRUCT door, Copy shorthand field under &mut — census twin, NO ROW today.
package h02;
struct S { x: i64, y: i64 }
fn main() -> i32 {
    let mut s: S = S { x: 3i64, y: 4i64 };
    match &mut s {
        S { x, y } => { *x = *x + 1i64; if *y != 4i64 { return 2i32; } }
    }
    if s.x != 4i64 { return 1i32; }
    return 0i32;
}
