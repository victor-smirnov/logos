// h11: SHAPE VARIATION — tuple inside tuple under &mut. Reaches the PAT_TUPLE
// door twice in one compile (the additivity probe).
package h11;
fn main() -> i32 {
    let mut t: ((i64, i64), i64) = ((3i64, 4i64), 5i64);
    match &mut t {
        ((a, b), c) => { *a = *a + 1i64; if *b + *c != 9i64 { return 2i32; } }
    }
    if t.0.0 != 4i64 { return 1i32; }
    return 0i32;
}
