package ce7827b;

trait Give {
    fn get(&self) -> i64;
    fn twin(&self) -> Box<dyn Give>;
}

struct Sq {
    s: i64,
}

impl Give for Sq {
    fn get(&self) -> i64 {
        return self.s;
    }
    fn twin(&self) -> Box<dyn Give> {
        return Box::new(Sq { s: self.s });
    }
}


fn relay(b: Box<dyn Give>) -> i64 {
    let h = b.twin();
    return h.get();
}

fn main() -> i32 {
    let b: Box<dyn Give> = Box::new(Sq { s: 6i64 });
    let v: i64 = relay(b);
    return v as i32;
}
