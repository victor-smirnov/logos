package ce3675b;

trait Give {
    fn get(&self) -> i64;
}

struct Sq {
    s: i64,
}

impl Give for Sq {
    fn get(&self) -> i64 {
        return self.s;
    }
}


fn main() -> i32 {
    let a = [Box::new(Sq { s: 6i64 }) as Box<dyn Give>];
    let sl = &a[0..1];
    let r = &sl[0];
    let v: i64 = r.get();
    return v as i32;
}
