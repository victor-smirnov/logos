package ce9626;

trait Give {
    fn get(&self) -> i64;
}

struct Sq {
    s: i64,
}

impl Give for Sq {
    fn get(&self) -> i64 {
        return self.s;
    }
}


fn main() -> i32 {
    let n: i64 = 6i64;
    let ob: Option<Box<dyn Give>> = Some(Box::new(Sq { s: 6i64 }));
    let r: &i64 = match ob {
        Some(bb) => &n,
        None => &n,
    };
    let v: i64 = *r;
    return v as i32;
}
