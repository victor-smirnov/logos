package ce7096;

trait Give {
    fn get(&self) -> i64;
}

struct Sq {
    s: i64,
}

impl Give for Sq {
    fn get(&self) -> i64 {
        return self.s;
    }
}


fn main() -> i32 {
    let f = |x: Box<dyn Give>| -> Box<dyn Give> {
        return x;
    };
    let b: Box<dyn Give> = Box::new(Sq { s: 6i64 });
    let h = f(b);
    let v: i64 = h.get();
    return v as i32;
}
