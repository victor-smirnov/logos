package ce7072;

trait Give {
    fn get(&self) -> i64;
}

struct Sq {
    s: i64,
}

impl Give for Sq {
    fn get(&self) -> i64 {
        return self.s;
    }
}


struct Wrap {
    k: i64,
}

impl Wrap {
    fn keep(&self, b: Box<dyn Give>) -> Box<dyn Give> {
        return b;
    }
}

fn main() -> i32 {
    let w = Wrap { k: 1i64 };
    let b: Box<dyn Give> = Box::new(Sq { s: 6i64 });
    let h = w.keep(b);
    let v: i64 = h.get();
    return v as i32;
}
