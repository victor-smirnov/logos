package adv12874;

trait Give {
    fn get(&self) -> i64;
}

struct Sq {
    s: i64,
}

impl Give for Sq {
    fn get(&self) -> i64 {
        return self.s;
    }
}


fn pull(ob: Option<Box<dyn Give>>) -> Box<dyn Give> {
    match ob {
        Some(bb) => {
            return bb;
        }
        None => {
            return Box::new(Sq { s: 0i64 });
        }
    }
}

fn main() -> i32 {
    let ob: Option<Box<dyn Give>> = Some(Box::new(Sq { s: 6i64 }));
    let h = pull(ob);
    let v: i64 = h.get();
    return v as i32;
}
