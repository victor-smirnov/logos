package ce12566;

trait Give {
    fn get(&self) -> i64;
}

struct Sq {
    s: i64,
}

impl Give for Sq {
    fn get(&self) -> i64 {
        return self.s;
    }
}


struct Slot {
    b: Box<dyn Give>,
}

impl Slot {
    fn cell(&mut self) -> &mut Box<dyn Give> {
        return &mut self.b;
    }
}

fn main() -> i32 {
    let bx: Box<dyn Give> = Box::new(Sq { s: 6i64 });
    let mut s = Slot { b: Box::new(Sq { s: 1i64 }) };
    *s.cell() = bx;
    let v: i64 = s.b.get();
    return v as i32;
}
