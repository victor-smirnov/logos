package P;
use logos.lang.rc;

trait Sp { fn v(&self) -> i64; }
trait Sq { fn w(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }
impl Sq for A { fn w(&self) -> i64 { return self.x + 1i64; } }

struct H { r: Rc<A> }
fn sinkrc(r: Rc<dyn Sp>) -> i64 { return r.v(); }
fn main() -> i64 {
    let h: H = H { r: rc_new(A { x: 7i64 }) };
    let a: i64 = sinkrc(h.r);
    if a != 7i64 { return 1i64; }
    if h.r.v() != 7i64 { return 2i64; }
    return 0i64;
}
