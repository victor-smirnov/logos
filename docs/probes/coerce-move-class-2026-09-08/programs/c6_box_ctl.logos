package P;
use logos.lang.rc;

trait Sp { fn v(&self) -> i64; }
trait Sq { fn w(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }
impl Sq for A { fn w(&self) -> i64 { return self.x + 1i64; } }

fn takeb(b: Box<dyn Sp>) -> i64 { return b.v(); }
fn main() -> i64 {
    let b: Box<A> = box_new(A { x: 8i64 });
    let a: i64 = takeb(b as Box<dyn Sp>);
    if a != 8i64 { return 1i64; }
    if b.v() != 8i64 { return 2i64; }
    return 0i64;
}
