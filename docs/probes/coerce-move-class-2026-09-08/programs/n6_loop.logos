package P;
use logos.lang.rc;

trait Sp { fn v(&self) -> i64; }
trait Sq { fn w(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }
impl Sq for A { fn w(&self) -> i64 { return self.x + 1i64; } }

fn sinkrc(r: Rc<dyn Sp>) -> i64 { return r.v(); }
fn main() -> i64 {
    let mut s: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < 3i64 {
        let rc: Rc<A> = rc_new(A { x: i });
        s = s + sinkrc(rc);
        i = i + 1i64;
    }
    if s != 3i64 { return 1i64; }
    return 0i64;
}
