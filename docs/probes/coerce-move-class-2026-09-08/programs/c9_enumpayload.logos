package P;
use logos.lang.rc;

trait Sp { fn v(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }

enum E { N, S(Rc<dyn Sp>) }
fn main() -> i64 {
    let rc: Rc<A> = rc_new(A { x: 16i64 });
    let e: E = E::S(rc);
    match e {
        E::S(d) => { if d.v() != 16i64 { return 1i64; } }
        E::N => { return 3i64; }
    }
    if rc.v() != 16i64 { return 2i64; }
    return 0i64;
}
