package P;
use logos.lang.rc;

trait Sp { fn v(&self) -> i64; }
trait Sq { fn w(&self) -> i64; }
struct A { x: i64 }
impl Sp for A { fn v(&self) -> i64 { return self.x; } }
impl Sq for A { fn w(&self) -> i64 { return self.x + 1i64; } }

fn main() -> i64 {
    let rc: Rc<A> = rc_new(A { x: 11i64 });
    if rc.v() != 11i64 { return 1i64; }
    let d: Rc<dyn Sp> = rc as Rc<dyn Sp>;
    if d.v() != 11i64 { return 2i64; }
    return 0i64;
}
