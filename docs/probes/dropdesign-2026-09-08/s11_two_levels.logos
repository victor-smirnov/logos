package s11_two_levels;
extern fn malloc(n: i64) -> *mut u8;
trait Drop { fn drop(self: Self); }
struct N { w: i64, c: *mut i64 }
impl Drop for N { fn drop(self: N) { unsafe { self.c[0] = self.c[0] + self.w; } } }
struct P { n: i64, inner: N }
impl Drop for P { fn drop(self: P) { } }
struct Q { n: i64, inner: P }
impl Drop for Q { fn drop(self: Q) { } }
unsafe fn main() -> i32 {
    let c: *mut i64 = malloc(8) as *mut i64;
    c[0] = 0i64;
    { let q: Q = Q { n: 1i64, inner: P { n: 1i64, inner: N { w: 1i64, c: c } } }; }
    return c[0] as i32;
}
