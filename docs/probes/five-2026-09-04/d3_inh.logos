// DEFECT 3a — a USER trait with a method named `drop`, and NO `impl Drop`.
// In Rust `Tidy::drop` is an ordinary method; scope exit calls nothing and
// main returns 0.
package d3_inh;
static mut RAN: i64 = 0i64;
struct S { n: i64 }
impl S {
    fn drop(&mut self) {
        unsafe { RAN = RAN + 1i64; }
    }
}
fn main() -> i32 {
    {
        let mut s: S = S { n: 5i64 };
        if s.n != 5i64 { return 3i32; }
    }
    unsafe { return RAN as i32; }
}
