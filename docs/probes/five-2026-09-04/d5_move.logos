// DEFECT 5 variant — the same wrapper over a `move` closure.
package d5_move;
fn wrap<F: Fn() -> i64>(f: F) -> Box<F> {
    return Box::new(f);
}
fn main() -> i32 {
    let n: i64 = 3i64;
    let b = wrap(move || { return n; });
    let got: i64 = (*b)();
    if got != 3i64 {
        return 1i32;
    }
    return 0i32;
}
