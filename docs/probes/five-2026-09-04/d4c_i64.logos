// DEFECT 4 CONTROL 2 — an ESCAPING closure whose capture is a plain i64.
package d4c_i64;
trait Tr { fn m(self: &Self) -> i64; }
struct S { v: i64 }
impl Tr for S {
    fn m(self: &Self) -> i64 { return self.v; }
}
fn f(b: Box<dyn Tr>) -> Box<dyn Fn() -> i64> {
    let k: i64 = b.m();
    return Box::new(move || { return k; });
}
fn main() -> i32 {
    let g: Box<dyn Fn() -> i64> = f(Box::new(S { v: 59i64 }));
    let got: i64 = g();
    if got != 59i64 {
        return 1i32;
    }
    return 0i32;
}
