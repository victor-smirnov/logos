package n02_nested_enum;
extern fn malloc(n: i64) -> *mut u8;
trait Drop { fn drop(self: Self); }
struct N { w: i64, c: *mut i64 }
impl Drop for N { fn drop(self: N) { unsafe { self.c[0] = self.c[0] + self.w; } } }
enum Inner { V(N), Nil }
impl Drop for Inner { fn drop(self: Inner) { } }
enum Outer { W(Inner), Nil }
impl Drop for Outer { fn drop(self: Outer) { } }
unsafe fn main() -> i32 {
    let c: *mut i64 = malloc(8) as *mut i64;
    c[0] = 0i64;
    { let o: Outer = Outer::W(Inner::V(N { w: 1i64, c: c })); }
    return c[0] as i32;
}
