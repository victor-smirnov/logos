{
    // Logos debugging in VSCode via the C/C++ extension (ms-vscode.cpptools),
    // gdb backend (cppdbg). The Logos binary carries standard DWARF (logosc -g),
    // and setupCommands load the Logos pretty-printers so the Variables pane
    // shows Vec(len=3)={…}, "string", Some(42), Rect(5,6), etc.
    //
    // Operates on the CURRENTLY OPEN .logos file: build-logos compiles it, then
    // its sibling executable (same name, no extension) is launched.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current Logos file (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${fileDirname}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build-logos",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing (required for the Logos printers)",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": false
                },
                {
                    // Load this compiler version's printers. Dev build tree path;
                    // for an INSTALLED logosc use instead:
                    //   "source <output of `logosc --print-prefix`>/share/gdb/logos_gdb.py"
                    "description": "Load Logos gdb pretty-printers",
                    "text": "source /home/victor/devel/logos/build/share/gdb/logos_gdb.py",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
