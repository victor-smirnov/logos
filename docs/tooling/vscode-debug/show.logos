package show;
extern fn printf(fmt: *const u8, ...) -> i32;

struct Point { x: i64, y: i64 }
enum Shape { Circle(i64), Rect(i64, i64), Empty }

fn scale(p: Point, k: i64) -> Point {
    let q: Point = Point { x: p.x * k, y: p.y * k };
    return q;
}

fn main() -> i32 {
    let p: Point = Point { x: 3i64, y: 4i64 };
    let big: Point = scale(p, 10i64);

    let mut xs: Vec<i64> = Vec::new();
    xs.push(7i64);
    xs.push(8i64);
    xs.push(9i64);

    let label: String = String::from("logos");
    let sh: Shape = Shape::Rect(5i64, 6i64);
    let some: Option<i64> = Option::Some(42i64);
    let nope: Option<i64> = Option::None;

    let sum: i64 = big.x + big.y;
    unsafe { printf("sum=%ld\n".as_ptr(), sum); }
    return 0i32;
}
