// writ_showcase — a tour of the writ2 document features:
//   1. Static @-literals  — blob in rodata, zero runtime cost (WritStatic)
//   2. Scalar capture     — $ident and ${expr} → Rc<Writ>
//   3. String capture     — str captured as a zone WString
//   4. Mixed capture      — scalars + strings + expressions
//   5. Typed array cast   — &[i32] as <I32>[]
//   6. Typed map cast     — MapSliceI32 as <I32,AnyVal>{}
//   7. Live-container reads — non-owning WAny views of a runtime document
//   8. List/map comprehensions — @[expr for x in iter] / @{k: v for ...}
//   9. Pattern matching   — scalar @-patterns, structural, rest
package writ_showcase;

use logos.lang.writ.hstatic;
use logos.lang.writ.container;
use logos.lang.writ.anyval;
use logos.lang.writ.typed_arr;
use logos.lang.writ.tmpl;
use logos.lang.writ.comp_builder;
use logos.lang.writ.pat;
use logos.lang.writ.static_view;
use logos.mem.writ.stringify;
use logos.lang.rc;
use logos.mem.string;
use logos.lang.str;
use logos.std.io;

unsafe fn show(label: str, root: WAny) {
    let s: String = stringify(root);
    let mut line: String = String::new();
    line.push_str(label);
    line.push_str(": ");
    line.push_str(s.as_str());
    println(line.as_str());
}

unsafe fn root_of(hs: &WritStatic) -> WAny {
    let base: *const u8 = hs.ptr;
    let w: i64 = *(base as *const i64);
    if w == 0i64 { return WAny::Ref(0i64 as *const u8); }
    if (w & 1i64) == 1i64 { return WAny::Pod(w as u64); }
    return WAny::Ref((base as i64 + w) as *const u8);
}

unsafe fn classify(d: &WritStatic) -> str {
    match d {
        @[a, b, ..] => "array(2+)",
        @[..]       => "array",
        @{}         => "map",
        @42         => "the answer",
        _           => "other",
    }
}

unsafe fn main() -> i32 {
    // ── 1. Static @-literals ───────────────────────────────────────────────
    let cfg: WritStatic = @{"name": "widget", "tags": ["fast", "safe"], "n": 7};
    show("static", root_of(&cfg));

    // ── 2-4. Captures: scalars, strings, expressions ──────────────────────
    let id: i32 = 42;
    let label: str = "item";
    let doc: Rc<Writ> = @{"id": $id, "label": $label, "sum": ${id + 1}};
    let h: &Writ = doc.deref();
    show("captures", h.root());

    // ── 5. Typed array cast ───────────────────────────────────────────────
    let nums: [i32; 4] = [10, 20, 30, 40];
    let ns: &[i32] = &nums;
    let tarr: Rc<Writ> = ns as <I32>[];
    let th: &Writ = tarr.deref();
    show("typed-array", th.root());

    // ── 6. Typed map cast ─────────────────────────────────────────────────
    let keys: [i32; 2] = [1, 2];
    let vals: [WAny; 2] = [WAny::from(100 as i56), WAny::from(200 as i56)];
    let ks: &[i32] = &keys;
    let vs: &[WAny] = &vals;
    let ms: MapSliceI32 = MapSliceI32 { keys: ks, vals: vs };
    let tmap: Rc<Writ> = ms as <I32, AnyVal>{};
    let mh: &Writ = tmap.deref();
    show("typed-map", mh.root());

    // ── 7. Live-container reads ───────────────────────────────────────────
    let v0: WView2 = WView2 { base: 0 as *const u8 };
    let got: WAny = v0.map_get(h.root(), "label");
    if !got.is_string() { return 7; }

    // ── 8. Comprehensions ─────────────────────────────────────────────────
    let arr: [i32; 5] = [1, 2, 3, 4, 5];
    let squares: Rc<Writ> = @[x * x for x in arr if (x % 2) == 1];
    let sh: &Writ = squares.deref();
    show("comprehension", sh.root());

    // ── 9. Pattern matching ───────────────────────────────────────────────
    let a: WritStatic = @[1, 2, 3];
    let m: WritStatic = @{"k": 1};
    let s42: WritStatic = @42;
    println(classify(&a));
    println(classify(&m));
    println(classify(&s42));

    return 0;
}
