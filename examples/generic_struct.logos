// Generic struct monomorphization: Pair<T>
package generic_struct;

struct Pair<T> {
    first: T;
    second: T;
}

fn make_pair<T>(a: T, b: T) -> Pair<T> {
    return Pair { first: a, second: b };
}

fn sum_pair(p: Pair<i32>) -> i32 {
    return p.first + p.second;
}

unsafe fn main() -> i32 {
    return sum_pair(make_pair::<i32>(10, 32));
}
