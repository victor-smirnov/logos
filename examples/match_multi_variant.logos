package match_multi_variant;

enum Shape {
    Circle(i32),
    Rect(i32),
    Triangle(i32),
}

fn area(s: Shape) -> i32 {
    match s {
        Shape::Circle(r)   => { return r * r; }
        Shape::Rect(side)  => { return side * side; }
        Shape::Triangle(b) => { return b * b / 2; }
    }
}

fn main() -> i32 {
    // Circle r=3 => 9, Rect side=5 => 25, Triangle b=2 => 2
    // 9 + 25 + 2 = 36  hmm, let me pick better numbers
    // Circle r=5 => 25, Rect side=3 => 9, Triangle b=4 => 8 => total = 42
    let a: i32 = area(Shape::Circle(5));    // 25
    let b: i32 = area(Shape::Rect(3));      // 9
    let c: i32 = area(Shape::Triangle(4));  // 8
    return a + b + c;
}
