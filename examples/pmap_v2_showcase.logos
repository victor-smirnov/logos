//
// pmap_v2 showcase — container-directory architecture.
//
//   Store<STORE_CFG>     — Arc<LockingStore>; per-store release registry.
//   Snap<STORE_CFG>      — directory MutSnapshot. Hosts containers,
//                          dispatches commit/fork.
//   ContainerRef<CFG>    — handle to one container in a Snap.
//   Iter<CFG> / LeafView<CFG> — leaf walker over a container.
//
// Drop fires automatically on scope exit (no explicit close/writeback).
// commit transfers the dir tree to the DAG; fork inherits and rc-bumps
// container roots so per-fork mutations CoW-clone cleanly.

package pmap_v2_showcase;

use std.data.persistent.pmap_v2.handle;
use std.lang.cmp;
use std.lang.ord;
use std.lang.datatypes;
use std.lang.text;
use std.fmt;
use std.io;
use std.hermes.view;
use std.hermes.anyval;

pub type StoreCfg = @{
    "name":   "showcase",
    "ctr_id": <type:u64>,
    "snp_id": <type:u64>,
};

pub type ShowCfg = @{
    "key":           <type:u64>,
    "value":         <type:u64>,
    "fanout":        8,
    "fanout_branch": 4,
    "fanout_leaf":   16,
};

fn section(title: str) {
    println("");
    println("──");
    println(title);
}

fn pmap_insert(p: &mut ContainerRef<ShowCfg>, key: u64, val: u64) -> bool {
    let k: u64 = key;
    return p.insert(key, val, &k as *const u64);
}

fn iterate_and_sum(p: &ContainerRef<ShowCfg>, expected: u64) -> i32 {
    let mut sum_k:  u64 = 0u64;
    let mut sum_v:  u64 = 0u64;
    let mut count:  u64 = 0u64;
    let mut leaves: u64 = 0u64;
    let mut prev:   u64 = 0u64;
    let mut it: Iter<ShowCfg> = p.iter();
    while it.valid() {
        leaves = leaves + 1u64;
        let leaf: LeafView<ShowCfg> = it.leaf();
        let n: u64 = leaf.len();
        let mut j: u64 = 0u64;
        while j < n {
            let kv: u64 = leaf.key_at(j);
            let vv: u64 = leaf.val_at(j);
            if kv <= prev {
                println("   ORDER VIOLATION");
                return 99;
            }
            prev = kv;
            sum_k = sum_k + kv;
            sum_v = sum_v + vv;
            count = count + 1u64;
            j = j + 1u64;
        }
        it.next();
    }
    let line_l: String = format::<u64, u64>("   leaves visited = {} / count = {}", leaves, count);
    let line_s: String = format::<u64, u64>("   sum keys = {} / sum vals = {}", sum_k, sum_v);
    println_string(&line_l);
    println_string(&line_s);
    if count != expected {
        let line_e: String = format::<u64, u64>("   COUNT MISMATCH: got {}, expected {}", count, expected);
        println_string(&line_e);
        return 1;
    }
    let exp_sum_k: u64 = (expected * (expected + 1u64)) / 2u64;
    let exp_sum_v: u64 = exp_sum_k * 7u64;
    if sum_k != exp_sum_k || sum_v != exp_sum_v {
        println("   TOTALS MISMATCH");
        return 2;
    }
    return 0;
}

fn main() -> i32 {
    if validate_cfg(@{
        "key": <type:u64>, "value": <type:u64>,
        "fanout": 8, "fanout_branch": 4, "fanout_leaf": 16,
    }) != 0 {
        println("cfg validation failed");
        return 1;
    }

    section("1. open Store<StoreCfg>");
    let mut store: Store<StoreCfg> = store_open::<StoreCfg>();
    println("   store opened");

    // ── s1: begin → create container 1 → fill 1000 → commit ────
    section("2. begin Snap, create_pmap(1), fill 1..=1000, commit");
    let mut s1: Snap<StoreCfg> = snap_begin(&mut store);
    {
        let mut c1: ContainerRef<ShowCfg> = create_pmap::<ShowCfg>(&mut s1, 1u64);
        let mut i: u64 = 1u64;
        while i <= 1000u64 {
            let _ = pmap_insert(&mut c1, i, i * 7u64);
            i = i + 1u64;
        }
        let line: String = format::<u64>("   size after inserts = {}", c1.len());
        println_string(&line);
    }
    let c0: i64 = s1.commit();
    let line_c0: String = format::<i64>("   commit id = {}", c0);
    println_string(&line_c0);

    // ── s2: fork c0, fill 1001..=2000 in container 1, commit ──
    section("3. fork from c0, fill 1001..=2000 in container 1, commit");
    let mut s2: Snap<StoreCfg> = snap_fork(&mut store, c0);
    {
        let mut c1: ContainerRef<ShowCfg> = open_pmap::<ShowCfg>(&mut s2, 1u64);
        let line_inh: String = format::<u64>("   inherited size = {}", c1.len());
        println_string(&line_inh);
        let mut i: u64 = 1001u64;
        while i <= 2000u64 {
            let _ = pmap_insert(&mut c1, i, i * 7u64);
            i = i + 1u64;
        }
        let line: String = format::<u64>("   size after second batch = {}", c1.len());
        println_string(&line);
    }
    let c1_id: i64 = s2.commit();
    let line_c1: String = format::<i64>("   commit id = {}", c1_id);
    println_string(&line_c1);

    // ── checkout c0: container 1 has 1000 entries (parent preserved) ──
    section("4. fork(c0) → iterate container 1 (expect 1000)");
    let mut sr0: Snap<StoreCfg> = snap_fork(&mut store, c0);
    {
        let mut c1: ContainerRef<ShowCfg> = open_pmap::<ShowCfg>(&mut sr0, 1u64);
        let line_size: String = format::<u64>("   size = {}", c1.len());
        println_string(&line_size);
        let rc: i32 = iterate_and_sum(&c1, 1000u64);
        if rc != 0 { return 30 + rc; }
        println("   ✓ c0 totals match (Σ(1..1000) = 500500; ×7 = 3503500)");
    }

    // ── checkout c1: container 1 has 2000 entries ──
    section("5. fork(c1) → iterate container 1 (expect 2000)");
    let mut sr1: Snap<StoreCfg> = snap_fork(&mut store, c1_id);
    {
        let mut c1: ContainerRef<ShowCfg> = open_pmap::<ShowCfg>(&mut sr1, 1u64);
        let rc: i32 = iterate_and_sum(&c1, 2000u64);
        if rc != 0 { return 40 + rc; }
        println("   ✓ c1 totals match (Σ(1..2000) = 2001000; ×7 = 14007000)");
    }

    println("");
    println("done.");
    return 0;
}
