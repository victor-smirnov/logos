//
// Deem showcase — the MINIMAL STATIC example. The seed of a complexity
// ladder: this file grows step by step toward real ontology workloads.
//
// Static mode: the query lives IN the program. `deem!` is a compile-time
// macro — it parses the query at BUILD time and emits an ordinary Logos
// function (here: `adults(&[Person]) -> Result<Vec<str>, …>`). No engine at
// runtime, no query text, no schema catalog — just the generated loop over
// your data.
//
// Build: cmake --build build --target example_deem_showcase
// Run:   ./build/examples/deem_showcase
//

package deem_showcase;

use logos.std.wql.wql;            // the deem! macro
use logos.mem.collections.vec;
use logos.lang.str;

extern fn printf(fmt: *const u8, ...) -> i32;

// plain data — no schemas, no arenas, just a struct
struct Person {
    pub name: str,
    pub age:  i64,
}

// the query, compiled with the program:
//   "the names of everyone 18 or older"
resource adults = deem!(people: &[Person]) {
    from people p where p.age >= 18 select p.name : str
};

fn main() -> i32 {
    let people: [Person; 4] = [
        Person { name: "ann",  age: 34i64 },
        Person { name: "bob",  age: 15i64 },
        Person { name: "cid",  age: 62i64 },
        Person { name: "dana", age: 9i64  },
    ];

    let names: Vec<str> = adults(&people[..]).unwrap();

    let mut i: i64 = 0i64;
    while i < names.len() {
        let n: str = names.get(i);
        unsafe { printf("%.*s\n" as *const u8, n.len() as i32, n.as_ptr()); }
        i = i + 1i64;
    }
    return 0i32;
}
