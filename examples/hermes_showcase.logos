// hermes_showcase — a tour of the hermes2 document features:
//   1. Static @-literals  — blob in rodata, zero runtime cost (HermesStatic)
//   2. Scalar capture     — $ident and ${expr} → Rc<Hermes>
//   3. String capture     — str captured as a zone HString
//   4. Mixed capture      — scalars + strings + expressions
//   5. Typed array cast   — &[i32] as <I32>[]
//   6. Typed map cast     — MapSliceI32 as <I32,AnyVal>{}
//   7. Live-container reads — non-owning HAny views of a runtime document
//   8. List/map comprehensions — @[expr for x in iter] / @{k: v for ...}
//   9. Pattern matching   — scalar @-patterns, structural, rest
package hermes_showcase;

use logos.lang.hermes.hstatic;
use logos.lang.hermes.container;
use logos.lang.hermes.anyval;
use logos.lang.hermes.typed_arr;
use logos.lang.hermes.tmpl;
use logos.lang.hermes.comp_builder;
use logos.lang.hermes.pat;
use logos.lang.hermes.static_view;
use logos.mem.hermes.stringify;
use logos.mem.rc;
use logos.mem.string;
use logos.lang.str;
use logos.std.io;

unsafe fn show(label: str, root: HAny) {
    let s: String = stringify(root);
    let mut line: String = String::new();
    line.push_str(label);
    line.push_str(": ");
    line.push_str(s.as_str());
    println(line.as_str());
}

unsafe fn root_of(hs: &HermesStatic) -> HAny {
    let base: *const u8 = hs.ptr;
    let w: i64 = *(base as *const i64);
    if w == 0i64 { return HAny::Ref(0i64 as *const u8); }
    if (w & 1i64) == 1i64 { return HAny::Pod(w as u64); }
    return HAny::Ref((base as i64 + w) as *const u8);
}

unsafe fn classify(d: &HermesStatic) -> str {
    match d {
        @[a, b, ..] => "array(2+)",
        @[..]       => "array",
        @{}         => "map",
        @42         => "the answer",
        _           => "other",
    }
}

unsafe fn main() -> i32 {
    // ── 1. Static @-literals ───────────────────────────────────────────────
    let cfg: HermesStatic = @{"name": "widget", "tags": ["fast", "safe"], "n": 7};
    show("static", root_of(&cfg));

    // ── 2-4. Captures: scalars, strings, expressions ──────────────────────
    let id: i32 = 42;
    let label: str = "item";
    let doc: Rc<Hermes> = @{"id": $id, "label": $label, "sum": ${id + 1}};
    let h: &Hermes = doc.deref();
    show("captures", h.root());

    // ── 5. Typed array cast ───────────────────────────────────────────────
    let nums: [i32; 4] = [10, 20, 30, 40];
    let ns: &[i32] = &nums;
    let tarr: Rc<Hermes> = ns as <I32>[];
    let th: &Hermes = tarr.deref();
    show("typed-array", th.root());

    // ── 6. Typed map cast ─────────────────────────────────────────────────
    let keys: [i32; 2] = [1, 2];
    let vals: [HAny; 2] = [HAny::from(100 as i56), HAny::from(200 as i56)];
    let ks: &[i32] = &keys;
    let vs: &[HAny] = &vals;
    let ms: MapSliceI32 = MapSliceI32 { keys: ks, vals: vs };
    let tmap: Rc<Hermes> = ms as <I32, AnyVal>{};
    let mh: &Hermes = tmap.deref();
    show("typed-map", mh.root());

    // ── 7. Live-container reads ───────────────────────────────────────────
    let v0: HView2 = HView2 { base: 0 as *const u8 };
    let got: HAny = v0.map_get(h.root(), "label");
    if !got.is_string() { return 7; }

    // ── 8. Comprehensions ─────────────────────────────────────────────────
    let arr: [i32; 5] = [1, 2, 3, 4, 5];
    let squares: Rc<Hermes> = @[x * x for x in arr if (x % 2) == 1];
    let sh: &Hermes = squares.deref();
    show("comprehension", sh.root());

    // ── 9. Pattern matching ───────────────────────────────────────────────
    let a: HermesStatic = @[1, 2, 3];
    let m: HermesStatic = @{"k": 1};
    let s42: HermesStatic = @42;
    println(classify(&a));
    println(classify(&m));
    println(classify(&s42));

    return 0;
}
