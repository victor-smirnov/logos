//
// Hermes2 showcase — the never-move arena container, end to end.
//
// Demonstrates, all at once:
//   1. HAny — the 8-byte heterogeneous slot: inline Pod (i56 / bool) vs Ref.
//   2. Array<HAny> — a Vec-like heterogeneous array: push / get / len, and
//      GROWTH that appends a fresh buffer (never frees the old one).
//   3. Never-move — a reference into the arena stays valid ACROSS a grow
//      (more permissive than Vec: push need not invalidate &elem).
//   4. Nested documents — an array holds Refs to child arrays; deep traversal.
//   5. Tagged dispatch — a `#[type_code]` object in the arena, dispatched
//      through Hermes2TagSystem (`&tagged<…> Trait`).
//   6. Residency & escape — a Ref HAny escapes its build scope inside a
//      `HeldAny`, which carries an Rc<Hermes2> holder keeping the arena alive.
//   7. HString — a UTF-8 string interned in the arena; `as_str` borrows it back.
//
// Borrow-checked (compile-time, not shown at runtime): a bare `return` of a Ref
// HAny — or a `&Array<HAny>` — that outlives its container is REJECTED; the only
// way out is the `HeldAny` holder above. RAII frees every arena on scope exit.
//
package hermes2_showcase;

use logos.lang.hermes2.container;   // Hermes2, hermes2_new / hermes2_rc, HeldAny, hold_any
use logos.lang.hermes2.anyval;      // HAny (value) / HAnyRel (at-rest): Pod + Ref
use logos.lang.hermes2.array;       // Array<HAny>: push / get / len, grow, nest
use logos.lang.hermes2.hstring;     // HString: a UTF-8 string in the arena, as_str
use logos.lang.hermes2.allocator;   // hermes2_alloc_bytes (raw tagged object)
use logos.lang.hermes.datatag;      // write_tag, type_code_of
use logos.mem.hermes.tag_system;    // Hermes2TagSystem
use logos.lang.ptr;                 // byte_add
use logos.mem.rc;                   // Rc
use logos.mem.string;               // i64::to_string
use logos.lang.str;                 // str_eq
use logos.std.io;                   // print / println / println_string

fn section(t: str) { println(""); print("== "); println(t); }
fn say(label: str, n: i64) {
    print("   "); print(label); print(" = ");
    let s: String = n.to_string();    // bind so the temporary String drops (frees its buffer)
    println_string(&s);
}
fn yn(label: str, b: bool) {
    print("   "); print(label); print(" -> "); println(if b { "yes" } else { "no" });
}

// ── a tagged, dispatchable object that lives IN the arena ─────────────────────
#[tag_dispatch(Hermes2TagSystem)] trait Area { unsafe fn area(self: *const Self) -> i64; }
#[type_code=170] #[zoned] struct Rect { w: i64, h: i64 }
impl Area for Rect { pub unsafe fn area(self: *const Rect) -> i64 { return self.w * self.h; } }

// Resolve a Ref HAny to a tagged object and dispatch through Hermes2TagSystem.
unsafe fn dispatch_area(e: HAny) -> i64 {
    let r: &tagged<Hermes2TagSystem> Area = e.resolve();
    return r.area();
}

// Deep-sum a document whose elements are inline i56 Pods OR Refs to child arrays.
// `&self` allocation means the container is borrowed shared; recursion reads only.
fn deep_sum(h: &Hermes2, a: &Array<HAny>) -> i64 {
    let mut total: i64 = 0i64;
    let mut i: i64 = 0i64;
    while i < a.len() {
        let e: HAny = a.get(i);
        if e.is_i56() {
            total = total + e.as_i56();
        } else if e.is_ref() {
            let child: &Array<HAny> = h.array_of(e);   // tied to this container
            total = total + deep_sum(h, child);
        }
        i = i + 1i64;
    }
    return total;
}

// Build a small document inside an Rc-held container and let one element ESCAPE
// the build scope — bound to the HERMES2 holder, not the (gone) build frame.
fn make_held_doc() -> HeldAny {
    let mut h: Rc<Hermes2> = hermes2_rc(64i64);
    let doc: &mut Array<HAny> = h.array(2i64);
    doc.push(HAny::from(101i64));
    doc.push(HAny::from(202i64));
    doc.push(HAny::from(303i64));                 // grows past cap 2
    let e: HAny = HAny::from(&*doc);              // a Ref to the doc array
    return hold_any(&mut h, e);                   // escape via the Hermes2 holder
    // the local `h` (Rc) drops here; the HeldAny's holder keeps the arena alive
}

fn main() -> i32 {
    // 1 ── HAny: inline Pod values (no allocation; the value lives in the word).
    section("1. HAny — inline Pod (i56 / bool)");
    let p_int:  HAny = HAny::from(-7i64);
    let p_bool: HAny = HAny::from(true);
    yn("int  is_i56", p_int.is_i56());
    say("int  as_i56", p_int.as_i56());
    yn("bool is_bool", p_bool.is_bool());
    yn("bool as_bool", p_bool.as_bool());

    // 2 ── Array<HAny> + growth across tiny segments (never-move arena).
    section("2. Array<HAny> — push / get / len + growth");
    let h: Hermes2 = hermes2_new(48i64);          // small segment → growth is real
    let arr: &mut Array<HAny> = h.array(2i64);    // direct &mut, interior-mut arena
    let mut k: i64 = 0i64;
    while k < 6i64 { arr.push(HAny::from((k * 10i64) as i56)); k = k + 1i64; }   // cap 2 → grows
    say("len after 6 pushes", arr.len());
    say("arr[0]", arr.get(0i64).as_i56());
    say("arr[5]", arr.get(5i64).as_i56());

    // 3 ── Never-move: a value READ before the grow is still correct after it
    //      (the old buffer is never freed; the Ref re-anchors on grow).
    section("3. Never-move — read survives growth");
    let before: i64 = arr.get(1i64).as_i56();     // arr[1] == 10
    arr.push(HAny::from(999i64));                  // may grow again
    let after: i64 = arr.get(1i64).as_i56();
    yn("arr[1] stable across grow", before == after);
    say("arr[1]", after);

    // 4 ── Nested document: root array holds Refs to child arrays; deep traversal.
    section("4. Nested document — deep_sum");
    let root: &mut Array<HAny> = h.array(2i64);
    let a: &mut Array<HAny> = h.array(2i64);
    a.push(HAny::from(1i64)); a.push(HAny::from(2i64)); a.push(HAny::from(3i64));
    let b: &mut Array<HAny> = h.array(2i64);
    b.push(HAny::from(10i64)); b.push(HAny::from(20i64));
    root.push(HAny::from(&*a));                    // Ref to child a   (sum 6)
    root.push(HAny::from(100i64));                 // inline Pod       (100)
    root.push(HAny::from(&*b));                    // Ref to child b   (sum 30)
    say("deep_sum(root)", deep_sum(&h, &*root));   // 6 + 100 + 30 = 136

    // 5 ── Tagged dispatch: a Rect object in the arena, dispatched by its type code.
    section("5. Tagged dispatch — Hermes2TagSystem");
    let shapes: &mut Array<HAny> = h.array(2i64);
    unsafe {
        let hraw: *mut Hermes2 = &h as *const Hermes2 as *mut Hermes2;
        let obj: *mut u8 = hermes2_alloc_bytes(hraw, 8i64 + 16i64);
        let at: *mut u8 = obj.byte_add(8i64);
        write_tag(at, type_code_of::<Rect>());
        let rp: *mut Rect = at as *mut Rect;  rp.w = 6i64;  rp.h = 7i64;
        shapes.push(HAny::ref_to(at as *const u8));
        let e: HAny = shapes.get(0i64);
        yn("shapes[0] is_ref", e.is_ref());
        say("dispatch area(6x7)", dispatch_area(e));   // 42
    }

    // 6 ── Residency & escape: an element outlives its build scope via HeldAny.
    section("6. Residency — HeldAny escapes its build scope");
    let held: HeldAny = make_held_doc();           // the arena outlived make_held_doc
    let doc: &Array<HAny> = unsafe { &*(held.val().resolve() as *const Array<HAny>) };
    say("held doc len", doc.len());
    say("held doc [2]", doc.get(2i64).as_i56());    // 303
    // `held` drops at scope end → Rc holder → arena freed (RAII).

    // 7 ── HString: a UTF-8 string interned in the arena; as_str borrows it back.
    section("7. HString — intern + as_str");
    let hs: &HString = h.hstring("hello, hermes2");
    print("   text = "); println(hs.as_str());
    say("byte len", hs.len());
    yn("round-trips", str_eq(hs.as_str(), "hello, hermes2"));

    // 7b ── HString as a HETEROGENEOUS element: a record [name: HString, age: i56]
    //       in one Array<HAny> — the string is a Ref, the age an inline Pod.
    let name: &mut HString = h.hstring("Ada");
    let rec: &mut Array<HAny> = h.array(2i64);
    rec.push(HAny::from(&*name));            // slot 0: a string Ref
    rec.push(HAny::from(36i64));             // slot 1: an inline i56
    print("   record.name = "); println(h.hstring_of(rec.get(0i64)).as_str());
    say("record.age", rec.get(1i64).as_i56());

    println("");
    println("== all sections ok");
    return 0;
}
