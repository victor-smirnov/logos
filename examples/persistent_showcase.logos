//
// Persistent showcase — CoW snapshots over Memoria containers.
//
// Two u64→u64 ordered maps in one store; commit, read a fork of the commit,
// mutate another fork (inserts, a replace, removals), then re-fork the first
// commit to show it is untouched, and print the snapshot DAG.
//

package persistent_showcase;

use logos.lcm.canon.container_item;
use logos.lcm.canon.metaclass;
use logos.mem.bt.map;
use logos.mem.bt.memstore;
use logos.mem.sync;
use logos.mem.collections.vec;
use logos.lang.option;

extern fn printf(fmt: *const u8, ...) -> i32;

container Scores {
    kind ordered_map;
    entry { key: u64, val: u64 }
    measure max(key);
}

fn section(label: &str) {
    unsafe { printf("\n=== %.*s ===\n" as *const u8, label.len() as i32, label.as_ptr()); }
}

fn show(key: u64, v: Option<u64>) {
    match v {
        Option::Some(out) => { unsafe { printf("  scores[%lu] = %lu\n" as *const u8, key, out); } }
        Option::None      => { unsafe { printf("  scores[%lu] = (none)\n" as *const u8, key); } }
    }
}

fn main() -> i32 {
    let mut store: Arc<MemoryStore> = store_new();

    section("commit C0: two containers");
    let s0: Arc<dyn Snapshot> = store_fork_arc(&mut store);
    {
        let mut scores = create_ctr::<typeof(Scores)>(&s0, 1u64);
        let mut i: u64 = 0u64;
        while i < 30u64 { scores.insert(i, i * 2u64); i = i + 1u64; }
        unsafe { printf("  scores.len = %lu\n" as *const u8, scores.size()); }
    }
    {
        let mut tags = create_ctr::<typeof(Scores)>(&s0, 2u64);
        let mut k: u64 = 0u64;
        while k < 10u64 { tags.insert(k, k + 100u64); k = k + 1u64; }
        unsafe { printf("  tags.len   = %lu\n" as *const u8, tags.size()); }
    }
    s0.commit();
    let c0: u64 = s0.snapshot_id();
    unsafe { printf("  -> commit id = %lu\n" as *const u8, c0); }

    section("read fork of C0");
    match store_fork_from(&mut store, c0) {
        Option::Some(sf) => {
            let scores = open_ctr::<typeof(Scores)>(&sf, 1u64);
            show(0u64, scores.find(0u64));
            show(15u64, scores.find(15u64));
            show(29u64, scores.find(29u64));
            let absent: bool = try_open_ctr::<typeof(Scores)>(&sf, 99u64).is_none();
            unsafe { printf("  open(99) absent = %d\n" as *const u8, absent as i32); }
        }
        Option::None => { return 1; }
    }

    section("mutating fork from C0");
    let s1: Arc<dyn Snapshot> = match store_fork_from(&mut store, c0) { Option::Some(s) => { s } Option::None => { return 2; } };
    {
        let mut scores = open_ctr::<typeof(Scores)>(&s1, 1u64);
        let mut i: u64 = 30u64;
        while i < 60u64 { scores.insert(i, i * 5u64); i = i + 1u64; }
        scores.insert(7u64, 9999u64);
        show(7u64, scores.find(7u64));
        let mut rk: u64 = 10u64;
        while rk < 15u64 { let _ = scores.remove(rk); rk = rk + 1u64; }
        unsafe { printf("  fork scores.len = %lu\n" as *const u8, scores.size()); }
    }
    s1.commit();
    let c1: u64 = s1.snapshot_id();

    section("re-fork C0 -- isolation check");
    match store_fork_from(&mut store, c0) {
        Option::Some(sf) => {
            let scores = open_ctr::<typeof(Scores)>(&sf, 1u64);
            unsafe { printf("  C0 scores.len = %lu (expect 30)\n" as *const u8, scores.size()); }
            show(7u64, scores.find(7u64));
            show(12u64, scores.find(12u64));
            unsafe { printf("  C0 contains(35) = %d (expect 0)\n" as *const u8, scores.contains_key(35u64) as i32); }
        }
        Option::None => { return 3; }
    }

    section("DAG topology");
    let rs: Vec<u64> = store_roots(&store);
    unsafe { printf("  roots.len = %ld" as *const u8, rs.len()); }
    if rs.len() > 0i64 { unsafe { printf(" (first = %lu)" as *const u8, rs.get(0i64)); } }
    unsafe { printf("\n" as *const u8); }
    let pc1: Vec<u64> = store_parents(&store, c1);
    unsafe { printf("  parents_of(C1).len = %ld" as *const u8, pc1.len()); }
    if pc1.len() > 0i64 { unsafe { printf(" (first = %lu)" as *const u8, pc1.get(0i64)); } }
    unsafe { printf("\n" as *const u8); }
    let cc0: Vec<u64> = store_children_of(&store, c0);
    unsafe { printf("  children_of(C0).len = %ld\n" as *const u8, cc0.len()); }
    return 0;
}
