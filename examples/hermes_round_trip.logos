//
// Example: parse a Hermes document, stringify it, print to stdout.

package hermes_example;

use hermes.ctr;
use std.string;
use std.io;

fn main() -> i32 {
    let mut doc: HermesCtr = HermesCtr::new(8192);

    let text: str = r#"
        {
            name:"widget",
            version:42,
            active:true,
            count:7_s8,
            tags:["fast","safe"],
            i32_array: <I32> [1,2,3,4]
        }
    "#;

    match doc.parse(text) {
        Result::Ok(())  => {}
        Result::Err(_)  => { return 1; }
    }

    let s: String = doc.to_string();
    println_string(&s);

    return 0;
}
