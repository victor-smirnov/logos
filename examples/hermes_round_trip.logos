//
// Example: parse a Hermes document, stringify it, print to stdout.

package hermes_example;

use hermes.ctr;

extern fn strlen(s: *const u8) -> i64;

fn main() -> i32 {
    let mut doc: HermesCtr = HermesCtr::create(8192);

    let text: *const u8 = r#"
        {
            name:"widget",
            version:42,
            active:true,
            count:7_s8,
            tags:["fast","safe"]
        }
    "#;

    if !doc.parse(text, unsafe { strlen(text) }) {
        return 1;
    }

    doc.stringify();
    doc.print();

    return 0;
}
