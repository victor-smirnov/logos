//
// Deem × Writ showcase — the STATIC twin: compile-time queries over a
// runtime-parsed document.
//
// The document arrives as TEXT and parses at runtime (parse_writ — one call,
// owned Writ). The queries are `deem!` resources — compiled with the program
// into plain functions; no engine, no query text, no catalog at runtime.
//
// The bridge between the two: the GRAPH-EDGE VOCABULARY — the same 8 columns
// the virtual runtime source (bind_source_tree) exposes:
//
//   parent, child : i64 ids (container = Writ handle; leaf = synthetic
//                   FNV(parent, ordinal) — a leaf's value word is no identity)
//   key, idx      : map key / array position (TOM field key code in idx)
//   kind, tag     : friendly tag ("obj" = open world) / raw type_code
//   vi, vs        : the child's scalar (i64; bool as 0/1) / string value
//
// One generic walk materializes the edge rows for the static engine — the
// ACUTE-NECESSITY bridge: the static macro only scans `&[RowTy]` slices
// today (a tree-source parameter kind for deem! is the noted follow-up; the
// runtime path already needs no materialization at all). Same vocabulary ⇒
// every query below ports verbatim to the virtual source and back.
//
// Graph discipline in the walk (matching the engine's virtual scan): every
// edge emits; a container EXPANDS exactly once (visited set) — DAGs don't
// duplicate, cycles terminate.
//
// Build: cmake --build build --target example_deem_writ_showcase
// Run:   ./build/examples/deem_writ_showcase
//

package deem_writ_showcase;

use logos.lang.writ.container;    // Writ
use logos.lang.writ.anyval;       // WAny — tag dispatch
use logos.lang.writ.array;        // WArray
use logos.lang.writ.wmap;         // WMap<WString, WAny>
use logos.lang.writ.wstring;      // WString
use logos.mem.writ.parser;        // parse_writ — text → owned document
use logos.lang.str;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.std.fmt;                // println! — the format macros
use logos.std.wql.wql;            // deem! — the static macro

fn hdr(label: str) {
    println!("\n=== {} ===", label);
}

// ── the edge fact: ONE generic relation, the shared vocabulary ──────────────
struct EdgeF {
    pub parent: i64,
    pub key:    str,
    pub idx:    i64,
    pub child:  i64,
    pub kind:   str,
    pub tag:    i64,
    pub vi:     i64,   // i64 leaf value; bool as 0/1; 0 otherwise
    pub vs:     str,   // string leaf value; "" otherwise
}

// ── the generic walk (the virtual scan's static twin) ───────────────────────
// Fully SAFE: string reads go through the null-safe WAny::as_wstr, and the
// visited set is a plain Vec<u64> (linear probe — example-scale documents;
// the engine's internal scan uses a HashMap for the same discipline).
fn fnv2(a: i64, b: i64) -> i64 {
    let mut hh: u64 = 14695981039346656037u64;
    hh = wrapping_mul(hh ^ (a as u64), 1099511628211u64);
    hh = wrapping_mul(hh ^ (b as u64), 1099511628211u64);
    return hh as i64;
}

fn w_kind(v: WAny) -> str {
    if v.is_map()     { return "map"; }
    if v.is_array()   { return "arr"; }
    if v.is_tinymap() { return "tom"; }
    if v.is_string()  { return "str"; }
    if v.is_null()    { return "null"; }
    if v.is_bool()    { return "bool"; }
    if v.is_float()   { return "f64"; }
    if v.is_int()     { return "i64"; }
    return "obj";
}

fn is_container(v: WAny) -> bool {
    return v.is_map() || v.is_array() || v.is_tinymap();
}

fn seen_has(seen: &Vec<u64>, h: u64) -> bool {
    let mut i: i64 = 0i64;
    while i < seen.len() {
        if seen.get(i) == h { return true; }
        i = i + 1i64;
    }
    return false;
}

fn emit_edge(out: &mut Vec<EdgeF>, parent: WAny, key: str, idx: i64,
             child: WAny, ord: i64) {
    let cid: i64 = if is_container(child) { child.raw() as i64 }
                   else { fnv2(parent.raw() as i64, ord) };
    let mut vi: i64 = 0i64;
    if child.is_int()       { vi = child.as_i64(); }
    else if child.is_bool() { vi = if child.as_bool() { 1i64 } else { 0i64 }; }
    out.push(EdgeF { parent: parent.raw() as i64, key: key, idx: idx,
                     child: cid, kind: w_kind(child),
                     tag: child.type_code() as i64, vi: vi,
                     vs: child.as_wstr() });   // null-safe: "" for non-strings
}

fn walk(v: WAny, out: &mut Vec<EdgeF>, seen: &mut Vec<u64>) {
    if v.is_map() {
        let m: &WMap<WString, WAny> = v.as_map();
        let mut ord: i64 = 0i64;
        let mut s: i64 = 0i64;
        while s < m.slots() {
            let kv: WAny = m.key_at(s);
            if !kv.is_null() {
                let cv: WAny = m.val_at(s);
                emit_edge(out, v, kv.as_wstr(), 0i64 - 1i64, cv, ord);
                descend(cv, out, seen);
                ord = ord + 1i64;
            }
            s = s + 1i64;
        }
        return;
    }
    if v.is_array() {
        let a: &WArray<WAny> = v.as_array();
        let mut i: i64 = 0i64;
        while i < a.len() {
            let cv: WAny = a.get(i);
            emit_edge(out, v, "", i, cv, i);
            descend(cv, out, seen);
            i = i + 1i64;
        }
    }
}

fn descend(child: WAny, out: &mut Vec<EdgeF>, seen: &mut Vec<u64>) {
    if !is_container(child) { return; }
    let hw: u64 = child.raw() as u64;
    if seen_has(seen, hw) { return; }   // expanded already (DAG/cycle)
    seen.push(hw);
    walk(child, out, seen);
}

// ── the queries: compiled with the program, zero runtime machinery ──────────
// every `engine` setting, wherever it sits
resource engines = deem!(g: &[EdgeF]) {
    from g e where e.key == "engine" select e.vs : str
};
// numeric leaves over a threshold (ports)
resource big_nums = deem!(g: &[EdgeF], min: i64) {
    from g e where e.kind == "i64" && e.vi >= min select (e.idx, e.vi)
};
// top-level map sections
resource sections = deem!(g: &[EdgeF], root: i64) {
    from g e where e.parent == root && e.kind == "map" select e.key : str
};
// i64 leaves inside the `db` subtree — Datalog on the edge relation
resource db_ints = deem!(g: &[EdgeF]) {
    rel dsc(a: i64, b: i64) {
        from g s where s.key == "db" select (s.parent, s.child);
        from dsc d join g e on e.parent == d.b select (d.a, e.child);
    }
    from dsc d join g e on e.child == d.b
    where e.kind == "i64" select (e.key, e.vi)
};
// per-section node counts (reachability + group by)
resource section_sizes = deem!(g: &[EdgeF], root: i64) {
    rel dsc(a: i64, b: i64) {
        from g s where s.parent == root select (s.child, s.child);
        from dsc d join g e on e.parent == d.b select (d.a, e.child);
    }
    from dsc d join g t on t.child == d.a
    group by t.key aggregate n = count() select (key, n) order by key
};

fn main() -> i32 {
    // ── the document: text → owned Writ, one call ───────────────────────────
    let doc: Writ = parse_writ(
        r#"{
            service: "api",
            replicas: 3,
            ports: [8080, 8443],
            db:    { engine: "pg",    host: "db1", pool: { min: 2, max: 16 } },
            cache: { engine: "redis", host: "c1" },
            debug: false
        }"#);
    let root: WAny = doc.root();
    if root.is_null() { return 90i32; }

    // ── the bridge walk: graph → one edge relation ───────────────────────────
    let mut g: Vec<EdgeF> = vec_new::<EdgeF>();
    let mut seen: Vec<u64> = vec_new::<u64>();
    seen.push(root.raw() as u64);
    walk(root, &mut g, &mut seen);
    println!("edges: {}", g.len());

    hdr("every `engine` setting, wherever it sits");
    let eng: Vec<str> = engines(g.as_slice()).unwrap();
    let mut i: i64 = 0i64;
    while i < eng.len() {
        println!("  {}", eng.get(i));
        i = i + 1i64;
    }

    hdr("numeric leaves >= 1000");
    let nums: Vec<(i64, i64)> = big_nums(g.as_slice(), 1000i64).unwrap();
    let mut j: i64 = 0i64;
    while j < nums.len() {
        let row: (i64, i64) = nums.get(j);
        println!("  idx {} -> {}", row.0, row.1);
        j = j + 1i64;
    }

    hdr("top-level sections");
    let secs: Vec<str> = sections(g.as_slice(), root.raw() as i64).unwrap();
    let mut k: i64 = 0i64;
    while k < secs.len() {
        println!("  {}", secs.get(k));
        k = k + 1i64;
    }

    hdr("i64 leaves under `db` (recursive rel)");
    let dbv: Vec<(str, i64)> = db_ints(g.as_slice()).unwrap();
    let mut k2: i64 = 0i64;
    while k2 < dbv.len() {
        let row2: (str, i64) = dbv.get(k2);
        println!("  {} = {}", row2.0, row2.1);
        k2 = k2 + 1i64;
    }

    hdr("how many nodes in each top-level section");
    let sz: Vec<(str, i64)> = section_sizes(g.as_slice(), root.raw() as i64).unwrap();
    let mut k3: i64 = 0i64;
    while k3 < sz.len() {
        let row3: (str, i64) = sz.get(k3);
        println!("  {:<10} {}", row3.0, row3.1);
        k3 = k3 + 1i64;
    }

    println!("\ndone.");
    return 0i32;
}
