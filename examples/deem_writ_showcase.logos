//
// Deem × Writ showcase — querying a DYNAMIC document with NO materialization.
//
// A JSON-like document arrives at RUNTIME (types known only via tag dispatch).
// The document IS the fact base: `bind_source_tree` exposes it as a VIRTUAL
// relation — the scan is a preorder walk, one row per edge, nothing copied
// anywhere (the no-gratuitous-materialization rule). Node ids are the Writ
// handles themselves — no numbering pass.
//
//   tree edge row:  parent  child   : i64 node handles (stable ids)
//                   key             : map key ("" under an array)
//                   idx             : array position (−1 under a map)
//                   kind            : child's tag — map/arr/str/i64/f64/bool/null
//                   vi, vs          : child's scalar/string value, else Null
//
// Acts:
//   A — flat questions asked DIRECTLY of the document (filter, Null-lenient
//       scalars, a self-join on node handles);
//   B — Datalog on the document: subtree membership as a two-line recursive
//       rel, subtree leaf harvest — all still zero-copy;
//   C — the other no-flatten tier: table-shaped ragged JSON via the LENIENT
//       erased source (missing field → Null, CEL-style).
//
// Virtual = re-scan semantics: no deltas (incremental engines reject a tree
// source by name; live facts go through FactStore — a later, systemic step).
//
// Build: cmake --build build --target example_deem_writ_showcase
// Run:   ./build/examples/deem_writ_showcase
//

package deem_writ_showcase;

use logos.lang.writ.container;    // Writ
use logos.lang.writ.anyval;       // WAny — tag dispatch (only for .raw() here!)
use logos.mem.writ.parser;        // parse — SDN text → Writ values
use logos.lang.rc;
use logos.lang.result;
use logos.lang.str;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.std.wql.ir;
use logos.std.deem;               // Query/QEnv — the runtime engine

extern fn printf(fmt: *const u8, ...) -> i32;

fn hdr(label: str) {
    unsafe { printf("\n=== %.*s ===\n" as *const u8, label.len() as i32, label.as_ptr()); }
}

// print a QRows table: str/dyn and i64 columns, one row per line
fn dump(rows: &QRows) {
    let mut r: i64 = 0i64;
    while r < rows.row_count() {
        unsafe { printf("  " as *const u8); }
        let mut c: i64 = 0i64;
        while c < rows.col_count() {
            if rows.is_null(r, c) {
                unsafe { printf("%-10s " as *const u8, "null" as *const u8); }
            } else if str_eq(rows.col_ty(c), "str") {
                let s: str = rows.get_str(r, c);
                unsafe { printf("%-10.*s " as *const u8, s.len() as i32, s.as_ptr()); }
            } else {
                // i64 col, or a dyn cell: print the string view when it has
                // one, the integer reading otherwise (example-grade printer)
                let s: str = rows.get_str(r, c);
                if s.len() > 0i64 {
                    unsafe { printf("%-10.*s " as *const u8, s.len() as i32, s.as_ptr()); }
                } else {
                    unsafe { printf("%-10ld " as *const u8, rows.get_i64(r, c)); }
                }
            }
            c = c + 1i64;
        }
        unsafe { printf("\n" as *const u8); }
        r = r + 1i64;
    }
}

fn run_dump(q: &Query, env: &QEnv) -> bool {
    match q.run(env) {
        Result::Ok(rows) => { dump(&rows); return true; }
        Result::Err(er)  => {
            let m: str = er.message();
            unsafe { printf("deem error: %.*s\n" as *const u8, m.len() as i32, m.as_ptr()); }
            return false;
        }
    }
}

fn compile_or_die(text: str, c: &SchemaCatalog) -> Result<Query, QError> {
    return Query::compile(text, c);
}

fn main() -> i32 {
    // ── the document: arrives as TEXT, parsed at runtime ────────────────────
    let rc: Rc<Writ> = unsafe { writ_rc(65536i64) };
    let h: &Writ = rc.deref();
    let doc: WAny = unsafe { parse(h,
        r#"{
            service: "api",
            replicas: 3,
            ports: [8080, 8443],
            db:    { engine: "pg",    host: "db1", pool: { min: 2, max: 16 } },
            cache: { engine: "redis", host: "c1" },
            debug: false
        }"#) };

    // the WHOLE setup: one binding. No walk, no fact tables, no schemas.
    let c: SchemaCatalog = SchemaCatalog::new();
    let mut env: QEnv = QEnv::new();
    env.bind_source_tree("tree", doc);
    env.bind_i64("root", doc.raw() as i64);   // the root's handle IS its id

    // ── Act A: ask the document directly ────────────────────────────────────
    hdr("Act A: every `engine` setting, wherever it sits");
    let q1: Query = match compile_or_die(
        r#"from tree e where e.key == "engine" select (e.key, e.vs)"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e) => { return 1i32; } };
    if !run_dump(&q1, &env) { return 1i32; }

    hdr("Act A: numeric leaves >= 1000 (vi is Null-lenient)");
    let q2: Query = match compile_or_die(
        "from tree e where e.vi >= 1000 select (e.idx, e.vi)", &c)
    { Result::Ok(v) => { v } Result::Err(_e2) => { return 2i32; } };
    if !run_dump(&q2, &env) { return 2i32; }

    hdr("Act A: top-level sections (self-join on node handles)");
    let q3: Query = match compile_or_die(
        r#"from tree e where e.parent == root && e.kind == "map" select e.key"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e3) => { return 3i32; } };
    if !run_dump(&q3, &env) { return 3i32; }

    // ── Act B: Datalog straight on the document ─────────────────────────────
    // subtree membership = two lines; the entry then harvests i64 leaves
    // under the `db` section — zero copies, the rel derives over the walk.
    hdr("Act B: i64 leaves under `db` (recursive rel over the tree)");
    let q4: Query = match compile_or_die(
        r#"rel dsc(a: i64, b: i64) {
             from tree s where s.key == "db" select (s.parent, s.child);
             from dsc d join tree e on e.parent == d.b select (d.a, e.child);
           }
           from dsc d join tree e on e.child == d.b
           where e.kind == "i64" select (e.key, e.vi)"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e4) => { return 4i32; } };
    if !run_dump(&q4, &env) { return 4i32; }

    hdr("Act B: how many nodes in each top-level section");
    let q5: Query = match compile_or_die(
        r#"rel dsc(a: i64, b: i64) {
             from tree s where s.parent == root select (s.child, s.child);
             from dsc d join tree e on e.parent == d.b select (d.a, e.child);
           }
           from dsc d join tree t on t.child == d.a
           group by t.key aggregate n = count() select (key, n) order by key"#, &c)
    { Result::Ok(v) => { v } Result::Err(_e5) => { return 5i32; } };
    if !run_dump(&q5, &env) { return 5i32; }

    // ── Act C: table-shaped ragged JSON — the LENIENT tier, also no flatten ──
    hdr("Act C: lenient rows (missing field -> Null, row dropped)");
    let hosts: WAny = unsafe { parse(h,
        r#"[ { name: "web1", cpu: 8 },
             { name: "web2", cpu: 32 },
             { name: "spare" } ]"#) };
    let mut env2: QEnv = QEnv::new();
    env2.bind_source_erased("hosts", hosts);
    let q6: Query = match compile_or_die(
        "from hosts hh where hh.cpu >= 16 select hh.name", &c)
    { Result::Ok(v) => { v } Result::Err(_e6) => { return 6i32; } };
    if !run_dump(&q6, &env2) { return 6i32; }

    unsafe { printf("\ndone.\n" as *const u8); }
    return 0i32;
}
