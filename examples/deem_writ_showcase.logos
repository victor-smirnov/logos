//
// Deem × Writ showcase — STATIC queries over a runtime-parsed document,
// with NO hand-written bridge (ADR 0016 M1a).
//
// The document arrives as TEXT and parses at runtime (parse_writ — one call,
// owned Writ). The queries are `deem!` resources compiled with the program.
// A parameter typed `&Writ` IS a graph source: it registers as the generic
// edge relation — (parent, key, idx, child, kind, tag, vi, vs) — materialized
// per call by the stdlib walk (logos.std.wql.writ_graph), with the same graph
// discipline as the runtime engine's virtual scan (bind_source_tree):
// every edge emits, containers expand once (DAG/cycle safe), container ids
// are Writ handles, leaf ids are synthetic FNV(parent, ordinal).
//
// The same queries port verbatim to the runtime path (bind_source_tree) —
// one vocabulary, two binding times.
//
// Build: cmake --build build --target example_deem_writ_showcase
// Run:   ./build/examples/deem_writ_showcase
//

package deem_writ_showcase;

use logos.lang.writ.container;    // Writ
use logos.mem.writ.parser;        // parse_writ — text → owned document
use logos.lang.str;
use logos.mem.string;
use logos.mem.collections.vec;
use logos.std.fmt;                // println! — the format macros
use logos.std.wql.wql;            // deem! — the static macro

fn hdr(label: str) {
    println!("\n=== {} ===", label);
}

// ── the queries: graph-path sugar (ADR 0016 M2a) — each one reads like the
// question it asks. No structs, no walk, no root-handle plumbing.
// every `engine` setting, wherever it sits (`**` = descend any depth)
resource engines = deem!(g: &Writ) {
    from g ** .engine e select e.vs : str
};
// numeric leaves over a threshold, anywhere in the document
resource big_nums = deem!(g: &Writ, min: i64) {
    from g ** v {i64} where v.vi >= min select (v.idx, v.vi)
};
// top-level map sections (`*` = one step from the root; {map} filters kind)
resource sections = deem!(g: &Writ) {
    from g * s {map} select s.key : str
};
// i64 leaves inside the `db` subtree — the old 5-line rel is now the path
resource db_ints = deem!(g: &Writ) {
    from g .db ** v {i64} select (v.key, v.vi)
};
// per-section edge counts (descend under each top-level map section)
resource section_sizes = deem!(g: &Writ) {
    from g * s {map} ** v
    group by s.key aggregate n = count() select (key, n) order by key
};

fn main() -> i32 {
    // ── the document: text → owned Writ, one call ───────────────────────────
    let doc: Writ = parse_writ(
        r#"{
            service: "api",
            replicas: 3,
            ports: [8080, 8443],
            db:    { engine: "pg",    host: "db1", pool: { min: 2, max: 16 } },
            cache: { engine: "redis", host: "c1" },
            debug: false
        }"#);
    if doc.root().is_null() { return 90i32; }

    hdr("every `engine` setting, wherever it sits");
    let eng: Vec<str> = engines(&doc).unwrap();
    let mut i: i64 = 0i64;
    while i < eng.len() {
        println!("  {}", eng.get(i));
        i = i + 1i64;
    }

    hdr("numeric leaves >= 1000");
    let nums: Vec<(i64, i64)> = big_nums(&doc, 1000i64).unwrap();
    let mut j: i64 = 0i64;
    while j < nums.len() {
        let row: (i64, i64) = nums.get(j);
        println!("  idx {} -> {}", row.0, row.1);
        j = j + 1i64;
    }

    hdr("top-level sections");
    let secs: Vec<str> = sections(&doc).unwrap();
    let mut k: i64 = 0i64;
    while k < secs.len() {
        println!("  {}", secs.get(k));
        k = k + 1i64;
    }

    hdr("i64 leaves under `db` (recursive rel)");
    let dbv: Vec<(str, i64)> = db_ints(&doc).unwrap();
    let mut k2: i64 = 0i64;
    while k2 < dbv.len() {
        let row2: (str, i64) = dbv.get(k2);
        println!("  {} = {}", row2.0, row2.1);
        k2 = k2 + 1i64;
    }

    hdr("how many edges under each top-level map section");
    let sz: Vec<(str, i64)> = section_sizes(&doc).unwrap();
    let mut k3: i64 = 0i64;
    while k3 < sz.len() {
        let row3: (str, i64) = sz.get(k3);
        println!("  {:<10} {}", row3.0, row3.1);
        k3 = k3 + 1i64;
    }

    println!("\ndone.");
    return 0i32;
}
