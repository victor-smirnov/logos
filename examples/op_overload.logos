package op_overload;

trait Add { fn add(self: Self, rhs: Self) -> Self; }
trait Eq { fn eq(self: Self, rhs: Self) -> bool; }

struct Vec2 { x: i32; y: i32; }

impl Add for Vec2 {
    fn add(self: Vec2, rhs: Vec2) -> Vec2 {
        return Vec2 { x: self.x + rhs.x, y: self.y + rhs.y };
    }
}

impl Eq for Vec2 {
    fn eq(self: Vec2, rhs: Vec2) -> bool {
        return self.x == rhs.x;
    }
}

fn main() -> i32 {
    let a: Vec2 = Vec2 { x: 10, y: 20 };
    let b: Vec2 = Vec2 { x: 5, y: 7 };
    let c: Vec2 = a + b;
    if c == Vec2 { x: 15, y: 27 } {
        return c.x + c.y;
    }
    return 0;
}
