package b_fannkuch;
extern fn logos_argc() -> i32;
extern fn logos_argv() -> *const *const u8;
fn reps() -> i64 {
    unsafe {
        if logos_argc() < 2i32 { return 1i64; }
        let p: *const *const u8 = (logos_argv() as i64 + 8i64) as *const *const u8;
        let s: *const u8 = p[0];
        let mut n: i64 = 0; let mut i: i64 = 0;
        while s[i] != 0u8 { n = n * 10i64 + (s[i] as i64 - 48i64); i = i + 1; }
        return n;
    }
}
// fannkuch-redux on N elements; initial identity rotated by `rot` so each call
// is a distinct (non-hoistable) computation. Returns the flip checksum.
fn do_fannkuch(rot: i64) -> i64 {
    let n: i64 = 8i64;
    let mut perm: [i32; 8] = [0i32; 8];
    let mut tperm: [i32; 8] = [0i32; 8];
    let mut count: [i32; 8] = [0i32; 8];
    let mut i: i64 = 0;
    while i < n { perm[i] = ((i + rot) % n) as i32; i = i + 1; }
    let mut checksum: i64 = 0;
    let mut maxflips: i64 = 0;
    let mut perm_count: i64 = 0;
    let mut r: i64 = n;
    loop {
        while r != 1i64 { count[r - 1i64] = r as i32; r = r - 1i64; }
        // count flips on a copy
        i = 0; while i < n { tperm[i] = perm[i]; i = i + 1; }
        let mut flips: i64 = 0;
        let mut k: i64 = tperm[0] as i64;
        while k != 0i64 {
            // reverse tperm[0..=k]
            let mut lo: i64 = 0; let mut hi: i64 = k;
            while lo < hi {
                let t: i32 = tperm[lo]; tperm[lo] = tperm[hi]; tperm[hi] = t;
                lo = lo + 1i64; hi = hi - 1i64;
            }
            flips = flips + 1i64;
            k = tperm[0] as i64;
        }
        if flips > maxflips { maxflips = flips; }
        if (perm_count & 1i64) == 0i64 { checksum = checksum + flips; }
        else { checksum = checksum - flips; }
        // next permutation
        loop {
            if r == n { return checksum + maxflips; }
            let p0: i32 = perm[0];
            i = 0; while i < r { perm[i] = perm[i + 1i64]; i = i + 1i64; }
            perm[r] = p0;
            count[r] = count[r] - 1i32;
            if count[r] > 0i32 { break; }
            r = r + 1i64;
        }
        perm_count = perm_count + 1i64;
    }
}
fn kernel(reps: i64) -> i64 {
    let mut acc: i64 = 0; let mut k: i64 = 0;
    while k < reps { acc = acc ^ do_fannkuch(k & 7i64); k = k + 1i64; }
    return acc;
}
fn main() -> i32 { return (kernel(reps()) & 1i64) as i32; }
