package b_revcomp;
extern fn logos_argc() -> i32;
extern fn logos_argv() -> *const *const u8;
fn reps() -> i64 {
    unsafe {
        if logos_argc() < 2i32 { return 1i64; }
        let p: *const *const u8 = (logos_argv() as i64 + 8i64) as *const *const u8;
        let s: *const u8 = p[0];
        let mut n: i64 = 0; let mut i: i64 = 0;
        while s[i] != 0u8 { n = n * 10i64 + (s[i] as i64 - 48i64); i = i + 1; }
        return n;
    }
}
// reverse-complement a DNA buffer in place: two pointers from the ends, swap with
// the complemented base (A<->T, C<->G) via a 256-entry table.
fn kernel(r: i64) -> i64 {
    let n: i64 = 16384i64;
    let mut comp: [u8; 256] = [0u8; 256];
    let mut i: i64 = 0;
    while i < 256i64 { comp[i] = i as u8; i = i + 1; }
    comp[65i64] = 84u8; comp[84i64] = 65u8;   // A<->T
    comp[67i64] = 71u8; comp[71i64] = 67u8;   // C<->G
    let mut buf: [u8; 16384] = [0u8; 16384];
    let bases: [u8; 4] = [65u8, 67u8, 71u8, 84u8];
    i = 0; while i < n { buf[i] = bases[i & 3i64]; i = i + 1; }
    let mut acc: i64 = 0; let mut k: i64 = 0;
    while k < r {
        let mut lo: i64 = 0; let mut hi: i64 = n - 1i64;
        while lo < hi {
            let a: u8 = comp[buf[lo] as i64];
            let b: u8 = comp[buf[hi] as i64];
            buf[lo] = b; buf[hi] = a;
            lo = lo + 1i64; hi = hi - 1i64;
        }
        acc = acc + (buf[0] as i64) + (buf[n - 1i64] as i64);
        k = k + 1i64;
    }
    return acc;
}
fn main() -> i32 { return (kernel(reps()) & 1i64) as i32; }
