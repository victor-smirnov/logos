package b_btree;
extern fn logos_argc() -> i32;
extern fn logos_argv() -> *const *const u8;
fn reps() -> i64 {
    unsafe {
        if logos_argc() < 2i32 { return 1i64; }
        let p: *const *const u8 = (logos_argv() as i64 + 8i64) as *const *const u8;
        let s: *const u8 = p[0];
        let mut n: i64 = 0; let mut i: i64 = 0;
        while s[i] != 0u8 { n = n * 10i64 + (s[i] as i64 - 48i64); i = i + 1; }
        return n;
    }
}
enum Tree { Leaf, Node(Box<Tree>, Box<Tree>) }
fn build(depth: i64) -> Tree {
    if depth <= 0i64 { return Tree::Leaf; }
    return Tree::Node(Box::new(build(depth - 1i64)), Box::new(build(depth - 1i64)));
}
fn check(t: &Tree) -> i64 {
    match t {
        Tree::Leaf => { return 1i64; }
        Tree::Node(l, r) => { return 1i64 + check(&**l) + check(&**r); }
    }
}
fn kernel(reps: i64) -> i64 {
    let depth: i64 = 12i64;
    let mut acc: i64 = 0; let mut k: i64 = 0;
    while k < reps {
        let t: Tree = build(depth);     // allocate
        acc = acc ^ check(&t);          // traverse
        k = k + 1i64;                   // t drops here → frees the tree
    }
    return acc;
}
fn main() -> i32 { return (kernel(reps()) & 1i64) as i32; }
