package b_structsum;
extern fn logos_argc() -> i32;
extern fn logos_argv() -> *const *const u8;
fn reps() -> i64 {
    unsafe {
        if logos_argc() < 2i32 { return 1i64; }
        let p: *const *const u8 = (logos_argv() as i64 + 8i64) as *const *const u8;
        let s: *const u8 = p[0];
        let mut n: i64 = 0; let mut i: i64 = 0;
        while s[i] != 0u8 { n = n * 10i64 + (s[i] as i64 - 48i64); i = i + 1; }
        return n;
    }
}
struct P { x: i64, y: i64 }
fn kernel(r: i64) -> i64 {
    let mut a: [P; 2048] = [P{x:0i64,y:0i64}; 2048];
    let mut i: i64 = 0; while i < 2048i64 { a[i] = P{x:i, y:0i64 - i}; i = i + 1; }
    let mut acc: i64 = 0; let mut k: i64 = 0;
    while k < r {
        i = 0; while i < 2048i64 { a[i].x = a[i].x + 1i64; i = i + 1; }
        let mut s: i64 = 0; i = 0;
        while i < 2048i64 { s = s + a[i].x - a[i].y; i = i + 1; }
        acc = acc ^ s; k = k + 1;
    }
    return acc;
}
fn main() -> i32 { return (kernel(reps()) & 1i64) as i32; }
