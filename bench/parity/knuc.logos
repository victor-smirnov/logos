package b_knuc;
use logos.mem.collections.hashmap;
extern fn logos_argc() -> i32;
extern fn logos_argv() -> *const *const u8;
fn reps() -> i64 {
    unsafe {
        if logos_argc() < 2i32 { return 1i64; }
        let p: *const *const u8 = (logos_argv() as i64 + 8i64) as *const *const u8;
        let s: *const u8 = p[0];
        let mut n: i64 = 0; let mut i: i64 = 0;
        while s[i] != 0u8 { n = n * 10i64 + (s[i] as i64 - 48i64); i = i + 1; }
        return n;
    }
}
// count all k-mers (k=6) of a base-4 sequence via a HashMap<i64,i64>, return a
// checksum (count of k-mer 0). Fresh map each rep (non-hoistable, stresses
// hash+probe on insert/get); the map frees at scope end.
fn kernel(r: i64) -> i64 {
    let n: i64 = 8192i64; let k: i64 = 6i64;
    let mask: i64 = (1i64 << (2i64 * k)) - 1i64;
    let mut seq: [i64; 8192] = [0i64; 8192];
    let mut acc: i64 = 0; let mut rep: i64 = 0;
    while rep < r {
        let mut i: i64 = 0;
        while i < n { seq[i] = (i * 1103515245i64 + 12345i64 + rep) & 3i64; i = i + 1; }
        let mut m: HashMap<i64, i64> = hashmap_new::<i64, i64>();
        let mp: *mut HashMap<i64, i64> = &mut m;
        let mut code: i64 = 0; i = 0; let mut best: i64 = 0;
        while i < n {
            code = ((code << 2i64) | seq[i]) & mask;
            if i >= k - 1i64 {
                unsafe {
                    let p: *const i64 = mp.get(&code);
                    let cur: i64 = if p != (0i64 as *const i64) { *p } else { 0i64 };
                    let c1: i64 = cur + 1i64;
                    mp.insert(code, c1);
                    if c1 > best { best = c1; }
                }
            }
            i = i + 1i64;
        }
        acc = acc + best;
        rep = rep + 1i64;
    }
    return acc;
}
fn main() -> i32 { return (kernel(reps()) & 1i64) as i32; }
